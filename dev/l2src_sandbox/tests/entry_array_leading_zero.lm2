# `08` is not an integer literal: a leading zero starts a C99 octal literal and 8
# is not an octal digit. The index is refused at the literal; it is not read as
# decimal 8.
[]: char values 10
values[08]: 1
if: values[8] != 1
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
