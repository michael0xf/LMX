# An untyped graph -- the letter as receiveMessage gives it -- passed to a MainLetter formal, and then bound to a
# MainLetter reference: both are admitted at run time by the same walk.  (A MainLetter value is callable, so the
# rebinding is `@: MainLetter m` / `m: @raw`, OPUS-CALLABLE-STRUCT-BINDING-20260929-16.)
MainLetter:
    char: []: []: mainArgs
end: MainLetter

fn: present (MainLetter: letter) int
return: 1

receiveMessage: raw
if: raw = 0
    sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
    return
if: present(raw) != 1
    sendMessage: exit(exit_code: 2; stdout: ""; stderr: "")
    return
@: MainLetter m
m: @raw
if: m = 0
    sendMessage: exit(exit_code: 3; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 4; stdout: ""; stderr: "")
return
