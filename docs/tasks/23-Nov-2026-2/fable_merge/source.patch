+      "foreign": "package PerlComparison::Groups;\nuse strict;\nuse warnings;\nsub group_by {\n    my ($items, $key_of, $same_key) = @_;\n    ref($items) eq 'ARRAY' or die \"SequenceType\\n\";\n    ref($key_of) eq 'CODE' && ref($same_key) eq 'CODE' or die \"CallableType\\n\";\n    my @groups;\n    for my $item (@$items) {\n        my $key = $key_of->($item);\n        my $selected;\n        for my $group (@groups) {\n            my $same = $same_key->($group->{key}, $key);\n            defined($same) && !ref($same) && $same =~ /\\A-?[0-9]+\\z/\n                or die \"PredicateType\\n\";\n            if ($same != 0) { $selected = $group; last }\n        }\n        if (!defined $selected) {\n            $selected = {key => $key, items => []};\n            push @groups, $selected;\n        }\n        push @{$selected->{items}}, $item;\n    }\n    return \\@groups;\n}\n1;\n",
+      "contract": "Ключи и элементы произвольны, включая структуры/ссылки. keyOf вызывается один раз на элемент. sameKey сравнивает с ключами уже созданных групп по порядку. Сохраняются порядок первых ключей, порядок элементов и полные значения/ссылки. Пустой вход возвращает пустой массив.",
+      "boundary": "Обе реализации используют список групп и явное равенство; они не принуждают пользовательский ключ к строке. Для клиентских целых ключей Perl вправе использовать свою настоящую хеш-таблицу и автоматическое создание массива.",
