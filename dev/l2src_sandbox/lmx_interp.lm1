predef: "lmx_interp.h.lm1"
predef: "lmx_call.lm1"
predef: "lmx_arena_refs.lm1"

# First slice: classify a callable the same way native call does.
# Full statement walk and return-trailer slot land after the helper layout.

fn: lmx_interp_callable (@: LmxArena arena; @: Lmx node) int
return: lmx_call_ready(arena, node)

fn: lmx_interp_method (@: LmxArena arena; @: Lmx node) @: LmxMethod
return: lmx_call_method(arena, node)

fn: lmx_interp_run (@: LmxArena arena; @: Lmx node) int
    @: LmxCallable info
    if: lmx_interp_callable(arena, node) != c.LMX_CALL_OK
        return: LMX_INTERP_INVALID
    info: lmx_call_callable(arena, node)
    if: info = 0
        return: LMX_INTERP_INVALID
    if: info\body = 0 && info\return_arg = 0
        return: LMX_INTERP_NO_GRAPH
    # No operator graph in the kernel yet (fable F: l2trans stores data only).
    # Walk will use lmx_own_load(local, node, index) from the reserved node.
return: LMX_INTERP_NO_GRAPH
