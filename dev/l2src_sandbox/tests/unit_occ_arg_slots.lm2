# GROK-COLON-OCCURRENCE-20260922-02. Two assignment occurrences of arg are two
# physical own slots. Explicit \[0]/\[1] are not the unresolved first-vs-last
# unqualified path.

fn: test (int: arg) int
    arg: 1
    arg: 2
    if: \[0]arg != 1
        return: 1
    if: \[1]arg != 2
        return: 2
    return: 0
end: test

return: test(0)
