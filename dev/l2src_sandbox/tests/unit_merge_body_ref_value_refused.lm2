# R6-2 (1): a reference field with a value in a merge result body -- `@: Model p Model` -- is read by the common body
# construction; its value is formed where the merge stands only in R6-2 task (4): refused where the item stands.
Model:
    size_t: x 1U
end: Model

R: merge: Model
    @: Model p Model
end: merge
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
