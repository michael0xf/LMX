    if: source_plan_ready_cell[0] != 0
        if: c.lm_compiler_mu_collect(n) != 0
            return: (cast: (int) (1))
        nrec: mur_n_cell[0]
        nt: 3 * mur_n_cell[0] + mur_slots_cell[0]
    ---
    if: c.lm_compiler_rw_frame(parent, "LMX_WALK_OP_PRIM_PUB", n + 9 + 3 * np + ebr_n_cell[0] + nt + 3 * selected + qx, @ prim) != 0
        return: (cast: (int) (1))
    if: rw_emit_cell[0] != 0 && c.fprintf(out_cell[0], "        @: LmxPrimitive l2_rwp%d (cast: (@: LmxPrimitive) lmx_arena_take_profiled(l2_program_arena, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE, lmx_range_profile(l2_program_arena, (cast: (@: void) l2_rw%d))))\n        if: l2_rwp%d = 0\n            return: 1\n        l2_rwp%d\\fn: %s\n        l2_rwp%d\\signature: 0\n        l2_rwp%d\\owner: (cast: (@: Lmx) l2_program_arena)\n        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_rwp%d)) != 0\n            return: 1\n", prim, prim, prim, prim, rec, prim, prim, prim, prim) < 0
        return: (cast: (int) (1))
    if: rw_emit_cell[0] != 0 && c.fprintf(out_cell[0], "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 3U, %dU) != c.LMX_WALK_OK || lmx_walk_store_size(l2_program_arena, l2_rw%d, 4U, %dU) != c.LMX_WALK_OK || lmx_walk_store_size(l2_program_arena, l2_rw%d, 5U, %dU) != c.LMX_WALK_OK\n            return: 1\n", prim, np, prim, ebr_n_cell[0], prim, nt) < 0
        return: (cast: (int) (1))
    if: rw_emit_cell[0] != 0 && c.fprintf(out_cell[0], "        if: lmx_walk_store_charptr(l2_program_arena, l2_rw%d, 6U, l2_layout_tokens + %d) != c.LMX_WALK_OK\n            return: 1\n", prim, c.lm_compiler_schema_token_slot(c.lm_compiler_schema_merge(res))) < 0
        return: (cast: (int) (1))
    if: rw_emit_cell[0] != 0 && source\layout != -1 && c.fprintf(out_cell[0], "        if: lmx_walk_store_charptr(l2_program_arena, l2_rw%d, 7U, l2_layout_tokens + %d) != c.LMX_WALK_OK\n            return: 1\n", prim, c.lm_compiler_schema_token_slot((cast: (int) (source\layout)))) < 0
        return: (cast: (int) (1))
    if: rw_emit_cell[0] != 0 && source\layout = -1 && c.fprintf(out_cell[0], "        if: lmx_walk_store_charptr(l2_program_arena, l2_rw%d, 7U, 0) != c.LMX_WALK_OK\n            return: 1\n", prim) < 0
        return: (cast: (int) (1))
    # The use cells: [anchor, k, len, len slots] per record -- the unit an explicit anchor, named by the activation's
