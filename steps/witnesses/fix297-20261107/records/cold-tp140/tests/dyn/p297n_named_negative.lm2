# Slice 297 probe (CALLABLE-PLACE-NAMED-RECEPTION, a negated literal): the place's formals are int x, char y; the fn written
# into it has int y, char x.  `Places\f(x: -1; y: 7)`: -1 is a char of the selected x -- -10 + 7 = -3; `x: -200` is no char,
# the implicit `convert` (25).  Exit: 7, else 100 + the first value seen, 41 for the second.  (Try c297a compared
# `v != 0 - 3` and left 40 in both executors; the comparison is now written `v + 3 != 0`, the value seen is the exit.)
fn: g (int: y; char: x) int
    return: (cast: (int) x) * 10 + y
end: g
Places:
    fn: f (int: x; char: y) int
        return: x * 10 + (cast: (int) y)
    end: f
end: Places
int: Hw 0
fn: write_place () int
    ---
        @: Places\f Hw
        return: 1
        catch: implements ()
            return: 24
    ---
end: write_place
fn: call_neg () int
    ---
        int: got Places\f(x: -1; y: 7)
        return: got
        catch: convert ()
            return: 25
    ---
end: call_neg
fn: call_low () int
    ---
        int: got Places\f(x: -200; y: 7)
        return: got
        catch: convert ()
            return: 25
    ---
end: call_low
fn: run () int
    int: v 0
    @: Hw g g
    if: write_place() != 1
        return: 34
    ---
    v: call_neg()
    if: v + 3 != 0
        return: 100 + v
    ---
    v: call_low()
    if: v != 25
        return: 41
    ---
    return: 7
end: run
int: code run()
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
