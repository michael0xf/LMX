# ======================================================================
# Коллекции: общий протокол ссылочных значений.
# items — обычная Structure / Array<@>; каждый элемент уже является
# ссылкой на живое значение в графе. Callback получает эту ссылку как @.
# Callback с результатом @ возвращает ссылку; он не обязан возвращать int.
# Число само по себе и ссылка на ячейку числа здесь не отождествляются.
# Все операции ниже последовательны, в одном Message. Callback не меняет
# длину/состав перебираемого входа и не объявляет recoverable throws.
# Пустой результат создаётся как (copy(())); sys\resize выделяет storage.
# Элементы сохраняются по ссылке. Глубокое копирование не подразумевается.
# Служебные формалы и локалы private: они не подставляются как динамические
# входы callbacks. Явно переданные аргументы сохраняют обычный контракт.
# Размеры в этих реализациях должны помещаться в int.
# ======================================================================

# Публичные имена callback-параметров принадлежат fn-сигнатурам.
# Именованные actuals устраняют W/E-неоднозначность singleton Structure.
RxCollectionUnary :: (@: value; return: @)

RxCollectionPredicate :: (@: value; return: int)

RxCollectionBinary :: (@: left; @: right; return: @)

RxCollectionSameKey :: (@: left; @: right; return: int)

RxCollectionFixStep :: (@: self RxCollectionUnary; @: value; return: @)

# map(items; transform): transform(@ item) -> @.
# Новый контейнер, исходный порядок, ровно один вызов на элемент.
# Пример: @: ys RxMap\map(xs; RxCollectionDouble\twice)
RxMap:
    private: []: @ items
    private: @: transform RxCollectionUnary
    return: @
    map:
        private: int: count length(items)
        private: @: result (copy(()))
        sys\resize(result; count)
        private: int: i 0
        while: i < count
            result[i] := transform(value := items[i])
            i += 1
        return: result

# filter(items; accepts): accepts(@ item) -> int; 0 означает false.
# Результат содержит те же ссылки, для которых предикат был истинным.
# Пример: @: even RxFilter\filter(xs; RxCollectionEven\isEven)
RxFilter:
    private: []: @ items
    private: @: accepts RxCollectionPredicate
    return: @
    filter:
        private: int: count length(items)
        private: @: result (copy(()))
        sys\resize(result; count)
        private: int: used 0
        private: int: i 0
        while: i < count
            if: accepts(value := items[i]) != 0
                result[used] := items[i]
                used += 1
            i += 1
        sys\resize(result; used)
        return: result

# fold(items; seed; step): step(@ accumulator; @ item) -> @.
# Левосторонняя свёртка; для пустого items возвращается именно seed.
# Пример: @: total RxFold\fold(xs; zeroBox; RxCollectionAdd\add)
RxFold:
    private: []: @ items
    private: @: seed
    private: @: step RxCollectionBinary
    return: @
    fold:
        private: @: accumulator seed
        private: int: count length(items)
        private: int: i 0
        while: i < count
            accumulator := step(left := accumulator; right := items[i])
            i += 1
        return: accumulator

# Один элемент результата zip: пара ссылок, не копии исходных объектов.
RxPairValue:
    @: first 0
    @: second 0

# zip(first; second) обрывается по длине более короткого входа.
# Пример: @: pairs RxZip\zip(xs; ys)
RxZip:
    private: []: @ first
    private: []: @ second
    return: @
    zip:
        private: int: count length(first)
        if: length(second) < count
            count := length(second)
        private: @: result (copy(()))
        sys\resize(result; count)
        private: int: i 0
        while: i < count
            private: @: pair (copy(RxPairValue))
            pair\first := first[i]
            pair\second := second[i]
            result[i] := pair
            i += 1
        return: result

# zipWith(first; second; combine): combine(@ a; @ b) -> @.
# Длина и порядок те же, что у zip; промежуточные пары не создаются.
# Пример: @: sums RxZipWith\zipWith(xs; ys; RxCollectionAdd\add)
RxZipWith:
    private: []: @ first
    private: []: @ second
    private: @: combine RxCollectionBinary
    return: @
    zipWith:
        private: int: count length(first)
        if: length(second) < count
            count := length(second)
        private: @: result (copy(()))
        sys\resize(result; count)
        private: int: i 0
        while: i < count
            result[i] := combine(left := first[i]; right := second[i])
            i += 1
        return: result

# scan(items; seed; step): выбран seeded-вариант, длина результата n+1.
# result[0] = seed; result[i+1] = step(result[i]; items[i]).
# Ссылки сохраняются как есть: мутирующий один accumulator callback даст
# повторные ссылки на него. Для истории значений step создаёт новое значение.
# Пример: @: prefixes RxScan\scan(xs; zeroBox; RxCollectionAdd\add)
RxScan:
    private: []: @ items
    private: @: seed
    private: @: step RxCollectionBinary
    return: @
    scan:
        private: int: count length(items)
        private: @: result (copy(()))
        sys\resize(result; count + 1)
        private: @: accumulator seed
        result[0] := accumulator
        private: int: i 0
        while: i < count
            accumulator := step(left := accumulator; right := items[i])
            result[i + 1] := accumulator
            i += 1
        return: result

# Конкретный контейнер Maybe<@>. present=0 — отсутствие; present=1 —
# присутствующее значение. value=0 может быть присутствующим значением.
# Он нужен для bind/traverse: универсальные Monad-законы не реализуются
# одним названием bind без конкретных операций выбранного контейнера.
RxMaybeValue:
    int: present 0
    @: value 0

RxSome:
    private: @: value
    return: @
    some:
        private: @: result (copy(RxMaybeValue))
        result\present := 1
        result\value := value
        return: result

RxNone:
    return: @
    none:
        return: (copy(RxMaybeValue))

# bind(input; next): input — RxMaybeValue; next(@ value) -> Maybe<@>.
# При отсутствии next не вызывается. Возвращается его настоящий контейнер.
# Пример: @: next RxBind\bind(possibleBox; RxCollectionHalf\checkedHalf)
RxBind:
    private: @: input RxMaybeValue
    private: @: next RxCollectionUnary
    return: @
    bind:
        if: input\present = 0
            return: input
        private: @: result RxMaybeValue next(value := input\value)
        return: result

# traverse(items; transform): transform(@ item) -> Maybe<@>.
# Слева направо до первого отсутствия; после него callbacks не вызываются.
# Пустой вход даёт Some(пустая Structure), а не None.
# Пример: @: all RxTraverse\traverse(xs; RxCollectionHalf\checkedHalf)
RxTraverse:
    private: []: @ items
    private: @: transform RxCollectionUnary
    return: @
    traverse:
        private: int: count length(items)
        private: @: result (copy(()))
        sys\resize(result; count)
        private: int: i 0
        while: i < count
            private: @: item RxMaybeValue transform(value := items[i])
            if: item\present = 0
                return: RxNone\none()
            result[i] := item\value
            i += 1
        return: RxSome\some(value := result)

# memo(F; sameKey) строит унарный @ -> @ callable.
# sameKey(@ a; @ b) -> int задаёт равенство ключей и не имеет эффектов.
# Ключи должны сохранять смысл, F — давать тот же результат для того же
# ключа и окружения. Изменяемые внешние зависимости в ключ входят явно.
# Кеш хранит ссылки; автоматически копировать/хешировать граф он не пытается.
# Поиск линейный O(n); перестройка двух массивов при добавлении тоже O(n).
# Публикация новой пары массивов происходит после успешного вычисления F
# и их заполнения. Неудачный F не добавляет запись.
# Пример: @: cached RxMemo\memo(RxCollectionDouble\twice; RxCollectionEqual\same)
RxMemoPrototype:
    private:
        @: rx_function RxCollectionUnary 0
        @: rx_sameKey RxCollectionSameKey 0
        @: rx_keys 0
        @: rx_values 0
    inputs:
        private: @: value
        return: @
        apply:
            private: @: key value
            private: @: keys node\private\rx_keys
            private: @: values node\private\rx_values
            private: int: i 0
            while: i < length(keys)
                if: node\private\rx_sameKey(left := keys[i]; right := key) != 0
                    return: values[i]
                i += 1
            private: @: computed node\private\rx_function(value := key)
            keys := node\private\rx_keys
            values := node\private\rx_values
            i := 0
            while: i < length(keys)
                if: node\private\rx_sameKey(left := keys[i]; right := key) != 0
                    return: values[i]
                i += 1
            private: int: count length(keys)
            private: @: newKeys (copy(()))
            private: @: newValues (copy(()))
            sys\resize(newKeys; count + 1)
            sys\resize(newValues; count + 1)
            i := 0
            while: i < count
                newKeys[i] := keys[i]
                newValues[i] := values[i]
                i += 1
            newKeys[count] := key
            newValues[count] := computed
            node\private\rx_keys := newKeys
            node\private\rx_values := newValues
            return: computed

RxMemo:
    private: @: function RxCollectionUnary
    private: @: sameKey RxCollectionSameKey
    return: @
    memo:
        private: @: instance (copy(RxMemoPrototype))
        private: @: owner parent(instance\inputs)
        private: @: keys (copy(()))
        private: @: values (copy(()))
        owner\private\rx_function := function
        owner\private\rx_sameKey := sameKey
        owner\private\rx_keys := keys
        owner\private\rx_values := values
        return: instance\inputs\apply

# fix(F): F(@ self; @ argument) -> @. Возвращаемый callable принимает
# один @; рекурсия вызывается как self(nextArgument). Это явный комбинатор
# рекурсивного вызова, без автоматической ленивости или устранения стека.
# Пример: @: recursive RxFix\fix(RxCollectionFactorial\calculate)
RxFixPrototype:
    private:
        @: rx_function RxCollectionFixStep 0
    inputs:
        private: @: value
        return: @
        apply:
            return: node\private\rx_function(self := node\inputs\apply; value := value)

RxFix:
    private: @: function RxCollectionFixStep
    return: @
    fix:
        private: @: instance (copy(RxFixPrototype))
        private: @: owner parent(instance\inputs)
        owner\private\rx_function := function
        return: instance\inputs\apply

# transpose(rows): массив ссылок на строки, каждая строка — Array<@>.
# Это массив отдельных массивов, не плоский прямоугольный numeric Array.
# Все строки имеют одинаковую длину. Пустой вход даёт пустой выход;
# N строк нулевой длины тоже дают нулевое число столбцов.
# Пример: @: columns RxTranspose\transpose(rows := rows)
RxTranspose:
    private: []: @ rows
    return: @
    transpose:
        throws: RxCollectionShape
        private: int: height length(rows)
        private: @: result (copy(()))
        if: height = 0
            return: result
        private: @: first rows[0]
        private: int: width length(first)
        private: int: i 0
        while: i < height
            private: @: row rows[i]
            if: length(row) != width
                throw: RxCollectionShape()
            i += 1
        sys\resize(result; width)
        private: int: j 0
        while: j < width
            private: @: column (copy(()))
            sys\resize(column; height)
            i := 0
            while: i < height
                private: @: row rows[i]
                column[i] := row[j]
                i += 1
            result[j] := column
            j += 1
        return: result

RxGroupValue:
    @: key 0
    @: items 0

# groupBy(items; keyOf; sameKey): keyOf(@ item)->@, sameKey(@ a; @ b)->int.
# Результат — Array<@> из RxGroupValue; группы идут по первому появлению
# ключа, элементы каждой группы — в исходном порядке. Ключи сравниваются
# переданным предикатом, не адресом и не недокументированной deep-equality.
# Пример: @: groups RxGroupBy\groupBy(xs; RxCollectionParity\parity; RxCollectionEqual\same)
RxGroupBy:
    private: []: @ items
    private: @: keyOf RxCollectionUnary
    private: @: sameKey RxCollectionSameKey
    return: @
    groupBy:
        private: @: result (copy(()))
        private: int: count length(items)
        private: int: i 0
        while: i < count
            private: @: key keyOf(value := items[i])
            private: @: group 0
            private: int: j 0
            while: j < length(result)
                private: @: candidate result[j]
                if: sameKey(left := candidate\key; right := key) != 0
                    group := candidate
                    break
                j += 1
            if: group = 0
                group := (copy(RxGroupValue))
                private: @: members (copy(()))
                group\key := key
                group\items := members
                private: int: groups length(result)
                sys\resize(result; groups + 1)
                result[groups] := group
            private: @: members group\items
            private: int: used length(members)
            sys\resize(members; used + 1)
            members[used] := items[i]
            i += 1
        return: result

# ======================================================================
# Самодостаточные примеры значений и callbacks для коллекций.
# int помещается в обычную Structure, живущую в графе, а не передаётся
# как адрес временной локальной ячейки. Это явная упаковка, не builtin.
# ======================================================================

RxCollectionIntValue:
    int: value 0

RxCollectionInt:
    private: int: number
    return: @
    box:
        private: @: result (copy(RxCollectionIntValue))
        result\value := number
        return: result

RxCollectionDouble:
    private: @: value
    return: @
    twice:
        private: @: item RxCollectionIntValue value
        return: RxCollectionInt\box(number := item\value * 2)

RxCollectionEven:
    private: @: value
    return: int
    isEven:
        private: @: item RxCollectionIntValue value
        return: item\value % 2 = 0

RxCollectionAdd:
    private: @: left
    private: @: right
    return: @
    add:
        private: @: a RxCollectionIntValue left
        private: @: b RxCollectionIntValue right
        return: RxCollectionInt\box(number := a\value + b\value)

RxCollectionHalf:
    private: @: value
    return: @
    checkedHalf:
        private: @: item RxCollectionIntValue value
        if: item\value % 2 != 0
            return: RxNone\none()
        private: @: half RxCollectionInt\box(number := item\value / 2)
        return: RxSome\some(value := half)

RxCollectionParity:
    private: @: value
    return: @
    parity:
        private: @: item RxCollectionIntValue value
        return: RxCollectionInt\box(number := item\value % 2)

RxCollectionEqual:
    private: @: left
    private: @: right
    return: int
    same:
        private: @: a RxCollectionIntValue left
        private: @: b RxCollectionIntValue right
        return: a\value = b\value

RxCollectionFactorial:
    private: @: self RxCollectionUnary
    private: @: value
    return: @
    calculate:
        private: @: item RxCollectionIntValue value
        if: item\value <= 1
            return: RxCollectionInt\box(number := 1)
        private: @: less RxCollectionInt\box(number := item\value - 1)
        private: @: previous RxCollectionIntValue self(value := less)
        return: RxCollectionInt\box(number := item\value * previous\value)

# Счётчик специально находится во владельце копируемого callable.
# Чтение через node фиксирует лексический владелец, независимо от имён caller.
RxCollectionCountedPrototype:
    int: calls 0
    inputs:
        private: @: value
        return: @
        twice:
            node\calls += 1
            return: RxCollectionDouble\twice(value := value)

# Не запускается при чтении файла. Это явный пример/acceptance probe.
# Ожидает все утверждения true и возвращает 1. Здесь он не исполнялся.
RxCollectionExamples:
    return: int
    run:
        throws: RxCollectionShape
        private: @: xs (copy(()))
        sys\resize(xs; 3)
        xs[0] := RxCollectionInt\box(number := 1)
        xs[1] := RxCollectionInt\box(number := 2)
        xs[2] := RxCollectionInt\box(number := 3)
        private: @: zeroBox RxCollectionInt\box(number := 0)
        private: @: doubled RxMap\map(xs; RxCollectionDouble\twice)
        sys\assert(length(doubled) = 3)
        sys\assert(doubled[2]\value = 6)
        private: @: evens RxFilter\filter(xs; RxCollectionEven\isEven)
        sys\assert(length(evens) = 1)
        sys\assert(evens[0]\value = 2)
        private: @: total RxFold\fold(xs; zeroBox; RxCollectionAdd\add)
        sys\assert(total\value = 6)
        private: @: pairs RxZip\zip(xs; evens)
        sys\assert(length(pairs) = 1)
        sys\assert(pairs[0]\first\value = 1)
        sys\assert(pairs[0]\second\value = 2)
        private: @: sums RxZipWith\zipWith(xs; xs; RxCollectionAdd\add)
        sys\assert(sums[2]\value = 6)
        private: @: prefixes RxScan\scan(xs; zeroBox; RxCollectionAdd\add)
        sys\assert(length(prefixes) = 4)
        sys\assert(prefixes[0]\value = 0)
        sys\assert(prefixes[3]\value = 6)
        private: @: possible RxSome\some(value := doubled[1])
        private: @: half RxBind\bind(possible; RxCollectionHalf\checkedHalf)
        sys\assert(half\present = 1)
        sys\assert(half\value\value = 2)
        private: @: allHalves RxTraverse\traverse(doubled; RxCollectionHalf\checkedHalf)
        sys\assert(allHalves\present = 1)
        sys\assert(length(allHalves\value) = 3)
        private: @: rejected RxTraverse\traverse(xs; RxCollectionHalf\checkedHalf)
        sys\assert(rejected\present = 0)
        private: @: counted (copy(RxCollectionCountedPrototype))
        private: @: countedOwner parent(counted\inputs)
        private: @: cached RxMemo\memo(counted\inputs\twice; RxCollectionEqual\same)
        private: @: a cached(value := RxCollectionInt\box(number := 4))
        private: @: b cached(value := RxCollectionInt\box(number := 4))
        sys\assert(a\value = 8 && b\value = 8)
        sys\assert(countedOwner\calls = 1)
        private: @: factorial RxFix\fix(function := RxCollectionFactorial\calculate)
        private: @: fact factorial(value := RxCollectionInt\box(number := 5))
        sys\assert(fact\value = 120)
        private: @: rows (copy(()))
        sys\resize(rows; 2)
        rows[0] := xs
        rows[1] := doubled
        private: @: columns RxTranspose\transpose(rows := rows)
        sys\assert(length(columns) = 3)
        sys\assert(length(columns[0]) = 2)
        sys\assert(columns[0]\[1]\value = 2)
        private: @: groups RxGroupBy\groupBy(xs; RxCollectionParity\parity; RxCollectionEqual\same)
        sys\assert(length(groups) = 2)
        sys\assert(groups[0]\key\value = 1)
        sys\assert(length(groups[0]\items) = 2)
        private: @: empty (copy(()))
        private: @: mappedEmpty RxMap\map(empty; RxCollectionDouble\twice)
        sys\assert(length(mappedEmpty) = 0)
        private: @: foldedEmpty RxFold\fold(empty; zeroBox; RxCollectionAdd\add)
        sys\assert(foldedEmpty\value = 0)
        private: @: scannedEmpty RxScan\scan(empty; zeroBox; RxCollectionAdd\add)
        sys\assert(length(scannedEmpty) = 1)
        private: @: traversedEmpty RxTraverse\traverse(empty; RxCollectionHalf\checkedHalf)
        sys\assert(traversedEmpty\present = 1)
        sys\assert(length(traversedEmpty\value) = 0)
        private: @: transposedEmpty RxTranspose\transpose(rows := empty)
        sys\assert(length(transposedEmpty) = 0)
        return: 1
