# The same in a nested body (OPUS-Q54-CONTINUE-20260929-14): f, declared by `f()` inside an `if:` body of the method,
# is typed by that declaration, and the `f()` after it there is admitted to it -- no `implements`, r 7 (an admission
# to S's type would give 64).
S:
    size_t: v 4U
fn: m () int
    int: r 7
    if: r = 7
        f()
        f()
        catch: implements ()
            r: 64
        r: r + 0
    int: out r
    return: out
end: m
int: r 0
r: m()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
