# Legacy implicit Model:b compatibility witness, pending known-head call cleanup.
# Its old construction route is not the current declaration/reference contract,
# and this row is not evidence of a fresh graph per activation.
Box:
    int: v 0
end: Box

fn: nest (int: n) int
    int: r 0
    Box: b
    b\v: n
    if: n > 0
        r: nest(n - 1)
    return: b\v + 10 * r
end: nest

fn: probe () int
    return: nest(3) - 123
end: probe

sendMessage: exit(exit_code: probe(); stdout: ""; stderr: "")
