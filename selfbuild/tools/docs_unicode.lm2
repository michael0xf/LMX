# Greedy nonempty Unicode-Nd run. Return1 found,0 none,-1 invalid UTF8/input.
# Keep consuming after size_t overflow, so the caller still sees the exact span.
# A range consumer must reject overflow; a spelling consumer compares that span.
fn: dt_decimal_run (@: data char; size_t: count; size_t: begin; @: value size_t; @: after size_t; @: overflow int) int
    size_t: at begin
    size_t: width 0U
    size_t: number 0U
    size_t: digit 0U
    size_t: limit (cast: (size_t) -1)
    unsigned: point 0U
    int: decimal 0
    int: exceeded 0
    if: data = 0 || value = 0 || after = 0 || overflow = 0 || begin > count
        return: -1
    while: at < count
        width: dt_point(data, count, at, @ point)
        if: width = 0U
            return: -1
        decimal: dt_decimal(point)
        if: decimal < 0
            break
        digit: (cast: (size_t) decimal)
        if: exceeded = 0
            if: number > (limit - digit) / 10U
                exceeded: 1
            else:
                number: number * 10U + digit
            ---
        ---
        at: at + width
    ---
    value[0]: number
    after[0]: at
    overflow[0]: exceeded
    if: at = begin
        return: 0
    return: 1
end: dt_decimal_run
