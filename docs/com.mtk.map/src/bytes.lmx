MapBytesDecodeUtf8:
    @: bytes
    required: bytes
    return: @
    decodeUtf8:
        throws: copy(MapThrows)
        @: result MapVector\create()
        int: at 0
        while: at < bytes\count
            int: first MapBytes\get(bytes; at)
            int: width 1
            int: code first
            int: minimum 0
            if: first >= 128
                if: first >= 194 && first <= 223
                    width := 2
                    code := first - 192
                    minimum := 128
                else:
                    if: first >= 224 && first <= 239
                        width := 3
                        code := first - 224
                        minimum := 2048
                    else:
                        if: first >= 240 && first <= 244
                            width := 4
                            code := first - 240
                            minimum := 65536
                        else:
                            throw: MapFailure("invalid UTF-8 lead")
            if: width > bytes\count - at
                throw: MapFailure("truncated UTF-8")
            int: tail 1
            while: tail < width
                int: digit MapBytes\get(bytes; at + tail)
                if: digit < 128 || digit > 191
                    throw: MapFailure("invalid UTF-8 continuation")
                code := code * 64 + digit - 128
                tail += 1
            if: code < minimum || code > 1114111 || (code >= 55296 && code <= 57343)
                throw: MapFailure("non-scalar or overlong UTF-8")
            MapVector\push(result; (code record))
            at += width
        return: result

