# K03 S7, REQUIRED POSITIVE: an anonymous Structure whose field is declared, `(int: v 9)`, is one merge operand -- a
# group holding a declaration holds no one value, so it is the Structure itself (docs/LMX_semantics.en.md#composition:
# `merge((n: 5); addN)`), and its v, matching Model's v by name and type, is written into Model's slot (#composition,
# "Model slots"); first, it is the model.  Not lowered yet: refused at the group.  Exit 7; 81 if A's v is not 9, 82 if
# B's fields are not 9 and Other's 2.
Model:
    int: v 1
end: Model
Other:
    int: w 2
end: Other
fn: m () int
    A: merge(Model; (int: v 9))
    if: A\v != 9
        return: 81
    B: merge((int: v 9); Other)
    if: B\v * 10 + B\w != 92
        return: 82
    return: 7
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
