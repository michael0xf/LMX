# Each reached merge copies Box. Recursion retains each activation's working
# value, yielding 123, and none of those writes changes Box itself.
Box:
    int: v 0
end: Box

fn: nest (int: n) int
    int: r 0
    b: merge Box
    b\v: n
    if: n > 0
        r: nest(n - 1)
    return: b\v + 10 * r
end: nest

fn: probe () int
    int: result 0
    result: nest(3)
    if: result != 123
        return: 81
    if: Box\v != 0
        return: 82
    return: 7
end: probe

sendMessage: exit(exit_code: probe(); stdout: ""; stderr: "")
return
