# The forms of the core `for` (book, branches and loops: the initialization once, then condition, body and step;
# `continue` performs the step, `break` exits): odd -- a `continue` runs the step, 1 + 3 + 5 + 7 + 9 = 25; down -- `--`
# from 3, 321; brk -- `break` at 4, 0 + 1 + 2 + 3 = 6; both -- `&&` in the condition and a `continue`, 0 + 5 + 10 =
# 15; nest -- a for in a for, each counter its own, 18.  The guards g stop a loop whose step does not run (a mutant).
# Success 7; odd 65, down 66, brk 67, both 68, nest 69.
# Native; its walked twin is unit_walk_for_forms (OPUS-WALKLOOP-20260929-11).
fn: odd () int
    int: s 0
    int: g 0
    for: int(i, 0) (i < 10) i++
        g: g + 1
        if: g > 50
            break
        if: i % 2 = 0
            continue
        s: s + i
    end: for
    return: s
end: odd
fn: down () int
    int: s 0
    int: g 0
    for: int(i, 3) (i > 0) i--
        g: g + 1
        if: g > 50
            break
        s: s * 10 + i
    end: for
    return: s
end: down
fn: brk () int
    int: s 0
    int: g 0
    for: int(i, 0) (i < 100) i++
        g: g + 1
        if: g > 50
            break
        if: i = 4
            break
        s: s + i
    end: for
    return: s
end: brk
fn: both () int
    int: s 0
    int: n 0
    int: g 0
    for: int(i, 0) (i < 20 && n < 3) i++
        g: g + 1
        if: g > 50
            break
        if: i % 5 != 0
            continue
        n: n + 1
        s: s + i
    end: for
    return: s
end: both
fn: nest () int
    int: s 0
    int: g 0
    for: int(i, 1) (i <= 2) i++
        g: g + 1
        if: g > 50
            break
        for: int(j, 1) (j <= 3) j++
            g: g + 1
            if: g > 50
                break
            s: s + i * j
        end: for
    end: for
    return: s
end: nest
int: r 7
if: odd() != 25
    r: 65
if: down() != 321
    r: 66
if: brk() != 6
    r: 67
if: both() != 15
    r: 68
if: nest() != 18
    r: 69
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
