                if: ast = 1
                    return: (cast: (int) (1))
                if: ast = 0
                    if: c.lm_compiler_reference_source_value(value, mi, @ source) != 0
                        return: (cast: (int) (1))
                    if: source\method < 0 && m_node_cell[0][idx] != 0 && m_node_cell[0][idx]\as != 0
                        if: c.lm_compiler_admit_consumer_ix(cand_ns, nst, idx, actual_i, path, source_node, "function argument") != 0
