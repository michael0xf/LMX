# The Windows command line of an argument vector (the rules CommandLineToArgvW and the C runtime parse
# back): an argument without space, tab, newline, vertical tab or double quote, and not empty, stands as it
# is; any other is quoted, a run of n backslashes before a quote or the closing quote doubled (2n, and one
# more before a written quote). Plain text work, valid on every platform; the win branch of the process
# adapter uses it. A program part: methods only (the program includes <stdlib.h> and <string.h>).

fn: win_arg_plain (@: arg char) int
    size_t: n c.strlen(arg)
    size_t: i 0U
    if: n = 0U
        return: 0
    while: i < n
        if: arg[i] = (cast: (char) 32) || arg[i] = (cast: (char) 9) || arg[i] = (cast: (char) 10) || arg[i] = (cast: (char) 11) || arg[i] = (cast: (char) 34)
            return: 0
        i: i + 1U
    return: 1
end: win_arg_plain

# k backslashes at out[o ..]; the offset after them.
fn: win_backslashes (@: out char; size_t: o; size_t: k) size_t
    size_t: i 0U
    while: i < k
        out[o + i]: (cast: (char) 92)
        i: i + 1U
    return: o + k
end: win_backslashes

# arg quoted at out[o ..]; the offset after it.
fn: win_quote_into (@: out char; size_t: o; @: arg char) size_t
    size_t: n c.strlen(arg)
    size_t: i 0U
    size_t: bs 0U
    if: win_arg_plain(arg) != 0
        while: i < n
            out[o + i]: arg[i]
            i: i + 1U
        return: o + n
    out[o]: (cast: (char) 34)
    o: o + 1U
    while: i < n
        bs: 0U
        while: i < n && arg[i] = (cast: (char) 92)
            bs: bs + 1U
            i: i + 1U
        if: i = n
            o: win_backslashes(out, o, 2U * bs)
        if: i < n && arg[i] = (cast: (char) 34)
            o: win_backslashes(out, o, 2U * bs + 1U)
        if: i < n && arg[i] != (cast: (char) 34)
            o: win_backslashes(out, o, bs)
        if: i < n
            out[o]: arg[i]
            o: o + 1U
            i: i + 1U
    ---
    out[o]: (cast: (char) 34)
    return: o + 1U
end: win_quote_into

# argv[0 .. argc - 1] as one Windows command line on the heap, or 0.
fn: win_cmdline (@@: argv char; int: argc) @: char
    size_t: need 1U
    size_t: o 0U
    int: i 0
    @: out char 0
    while: i < argc
        need: need + 2U * (cast: (size_t) c.strlen(argv[i])) + 3U
        i: i + 1
    out: (cast: (@: char) c.malloc(need))
    if: out = 0
        return: 0
    i: 0
    while: i < argc
        if: i > 0
            out[o]: (cast: (char) 32)
            o: o + 1U
        o: win_quote_into(out, o, argv[i])
        i: i + 1
    out[o]: (cast: (char) 0)
    return: out
end: win_cmdline
