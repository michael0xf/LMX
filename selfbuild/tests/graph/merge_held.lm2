# M11 5v: construct the held merge in own data. The final reference only
# exposes its complete value; invocation reads the actual own place by path.
fn: mytest (int: c 3; int: a) int
    return: c * 10 + a
sub: main () (
    @: pack merge(mytest\args; (int: a 5))
) ()
main()
int: r mytest(main\data\pack)
int: x 4
int: y x + 1
@: observed_pack main\data\pack
