# Probe 348/4c (lowering): the positional written group take((y: int: 6)) -- measured on boot349 (a boundary of 348:
# record what the translation does, refusal or value).
Point:
    int: x 1
    int: y 2
end: Point
fn: take (Point: p; int: q 2) int
    return: p\y * 10 + q
end: take
int: code 7
if: take((y: int: 6)) != 62
    code: 81
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
