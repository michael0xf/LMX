# Working value and published field remain distinct without a named
# occurrence selector.  Every declared name is unique in its Structure.
#
# bt and al are declared here.  In between, bt's `2` is published by the
# nop() after it: bt and its place of declaration, between\bt, are both 2.
# In after_last, al's 2 is published before poke9's call; poke9 writes 9 through
# @: al -- the place of declaration (the author, 2026-09-28: @x of a declared field is its typed data in the
# arena) -- and al, clean since, is not written back over it (book §12): the bare al keeps its working value
# 2 -- `LAST 2`, not reloaded after the call -- while the place of declaration, after_last\al, holds 9.
fn: poke7 (@: int: p) int
    \p: 7
    return: 0
end: poke7
fn: poke9 (@: int: p) int
    \p: 9
    return: 0
end: poke9
fn: nop () int
    return: 0
end: nop

fn: between () int
    int: bt 0
    bt: 1
    nop()
    poke7(@: bt)
    nop()
    bt: 2
    nop()
    if: bt != 2
        return: 1
    c.printf: "BETWEEN %d\n" bt
    return: 0
end: between

fn: after_last () int
    int: al 0
    al: 1
    al: 2
    poke9(@: al)
    nop()
    c.printf: "LAST %d\n" al
    return: 0
end: after_last

between()
after_last()
int: seen 0
seen: between\bt
if: seen != 2
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
seen: after_last\al
if: seen != 9
    sendMessage: exit(exit_code: 82; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
