Model:
    size_t: value 1U
    []: int buf 3
end: Model

# buf is a real Array field of Model. A store through an indexed field path of
# an explicit copy changes that copy's element; the model's Array and an
# unrelated own Array of the method keep their contents. Entry 7.
fn: work () int
    []: int own 3
    fresh: merge: Model
    fresh\buf[2]: 9
    if: fresh\buf[2] != 9 || Model\buf[2] != 0 || own[2] != 0
        return: 81
    return: 7
end: work

sendMessage: exit(exit_code: work(); stdout: ""; stderr: "")
return
