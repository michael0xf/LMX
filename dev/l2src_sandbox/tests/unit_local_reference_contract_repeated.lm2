fn: read () int
    Outer:
        Inner:
            int: x 11
        end: Inner
        @: Inner ref Inner
    end: Outer
    Candidate:
        int: pad 19
        int: x 23
    end: Candidate
    Outer
    if: Outer\ref != Outer\Inner || Outer\ref\x != 11
        return: 81
    Outer\ref: Candidate
    if: Outer\ref != Candidate || Outer\ref\x != 23
        return: 81
    Outer
    if: Outer\ref != Outer\Inner || Outer\ref\x != 11 || Candidate\x != 23
        return: 81
    return: 11
end: read
int: ok 7
if: read() != 11
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
