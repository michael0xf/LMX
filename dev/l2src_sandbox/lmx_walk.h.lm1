predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_call.h.lm1"

# lmx_walk.h - the walk of a callable's body tree: one activation of the graph interpreter.
#
# PROTOTYPE, int slice, dev/l2src_sandbox only.  lmx_interp_run stays the entry that
# recognises a callable; this unit is what gives a body VALUES: own state, declared
# inputs, results, checkpoints.  It is written to be called from lmx_interp, not to
# replace it.
#
# What is fixed by the author and by the native path, and only carried out here:
#   * the body is M itself after child[0], in order; every `return:` is a node of that
#     tree and there may be many (lmx.h.lm1, LmxCallable; dev/graph_interp/README.md);
#   * the graph is binary and carries no names; the address->name table is never read
#     (LMX_blog/2026-09-20.md, "Бинарный граф без имён");
#   * an activation lives on the ordinary C stack (same file, "Тело метода общее,
#     активация на стеке"): a recursive call is a recursive C call of lmx_walk_run on
#     the same published M, and nothing per-activation is ever put into the graph;
#   * state is addressed BY POSITION from the reserved node, as native code does
#     (l2trans.lm1 l2_own_mslot / l2_own_ctr): a body node holds indexes, so a copied M
#     runs unchanged on its own state;
#   * own fields the body uses are loaded at entry into activation-local working values,
#     dirty is set only by an executed assignment, dirty values are published before
#     every outbound call and every exit, clean ones are never republished, nothing is
#     reloaded after a call (Lingvamyxa_spec.txt 21.5, 21.6; lmx_own.lm1);
#   * one exit order for every `return:`: evaluate the argument -> dirty-only checkpoint
#     in load order -> return (l2trans.lm1 l2_emit_ret_tr, `return` in l2_emit_body).
#
# The shape of a body node is Grok's (lmx.h.lm1, LmxOp; lmx_interp.lm1): a FRAME node is
# an ordinary Structure whose child[0] is an LmxOp record -- the arena's index says it is
# an op, its `code` says which -- and whose remaining children are its operands, in
# order.  A bare LmxOp child with code RETURN is a void return, as lmx_interp_exec reads
# it.  What is PROPOSED here and needs the author's word (dev/graph_interp/BODY_NODES.md)
# is the set of codes beyond RETURN and CALL and the operands of each.  A BODY (of `if`,
# of `while`) is a plain Structure whose children are, in order, own cells and frame
# nodes -- the same shape as M after child[0].  Numbers inside a node (a literal, a step
# of a path) are primitive cells.
#
#   ret   [ret, value?]               a return; no value for a void callable
#   call  [call, path, arg ...]       the path selects the callee M; a callee M stored
#                                     directly in child 1 (lmx_interp_exec's form) is
#                                     accepted too
#   lit   [lit, cell]                 int cell
#   own   [own, i0 .. ik]             size_t cells: steps from the reserved node down
#                                     through bodies; the last one is the field's slot
#   arg   [arg, k]                    k-th declared input of this activation (size_t cell)
#   path  plain [up, i0 .. ik]        size_t cells: `up` lexical parents of the reserved
#                                     node, then down by index
#   at    [at, path]                  explicit graph path read: every execution, never
#                                     cached (21.5)
#   put   [put, path, value]          explicit graph path write, never cached
#   set   [set, own-node, value]      executed assignment of an own field: sets dirty
#   add sub lt eq  [op, a, b]
#   if    [if, cond, then, else?]     then / else are bodies
#   while [while, cond, body]
#
# Limits of this slice, stated rather than hidden: values are C int only; declared
# inputs are int; a return carries 0 or 1 value; no throw, no poll
# (lmx_msg_poll_escape), no arrays, no char/size_t/pointer own fields, no dynamic
# inputs of 21.3, and `header` of LmxCallable is not read.
#
# What is outside the slice is REPORTED, never skipped and never handed to native code
# (docs/LMX_semantics.ru.md, #l3-receiver: a restricted profile reports an unsupported
# construct explicitly; an implementation address does not make an operation
# admissible).  A frame node whose LmxOp code this unit does not read makes the whole
# activation LMX_WALK_UNSUPPORTED at ENTRY, before any step runs and wherever in M the
# node sits, a branch never taken included.  There is no fallback to METHOD.addr: a
# callable with no body node is LMX_WALK_NO_GRAPH and that is all.

define: LMX_WALK_OK 0
# Malformed body tree, not a callable, a path that selects nothing, a missing input.
define: LMX_WALK_INVALID 1
# A callable with no body node: nothing to walk (the caller may have a native entry).
define: LMX_WALK_NO_GRAPH 2
define: LMX_WALK_NOMEM 3
# A dirty own value could not be published (21.6: checkpoint failure, never silent).
define: LMX_WALK_CHECKPOINT 4
# A body node this slice does not read.  Nothing of the activation has run.
define: LMX_WALK_UNSUPPORTED 5

# The values of LmxOp.code this unit reads.  RET and CALL ARE lmx_interp.h.lm1's
# LMX_OP_RETURN 1 and LMX_OP_CALL 2 (the selftest checks the equality); the rest continue
# that numbering and belong in that header once agreed.
# What lmx_walk_op answers for a frame node whose code is not one of those below.
define: LMX_WALK_OP_UNKNOWN -1
define: LMX_WALK_OP_NONE 0
define: LMX_WALK_OP_RET 1
define: LMX_WALK_OP_CALL 2
define: LMX_WALK_OP_LIT 3
define: LMX_WALK_OP_OWN 4
define: LMX_WALK_OP_ARG 5
define: LMX_WALK_OP_AT 6
define: LMX_WALK_OP_PUT 7
define: LMX_WALK_OP_SET 8
define: LMX_WALK_OP_ADD 9
define: LMX_WALK_OP_SUB 10
define: LMX_WALK_OP_LT 11
define: LMX_WALK_OP_EQ 12
define: LMX_WALK_OP_IF 13
define: LMX_WALK_OP_WHILE 14
define: LMX_WALK_OP_COUNT 15

# One own field of the running M as this activation sees it: the slot it was loaded from
# (the publication target), the `own` node whose steps are the field's LEXICAL POSITION,
# the working value, and the dirty state of 21.6.  The records of an activation are kept
# in the lexical order of the fields (LMX_blog/2026-09-20.md, "Поля Lmx лексические"),
# which is therefore the order of every checkpoint -- not the order in which the body
# happens to mention them.
struct: LmxWalkOwn
    @@: void from
    @: Lmx position
    int: value
    int: dirty
end: LmxWalkOwn

# One activation.  An automatic object of lmx_walk_run; nothing of it is in the graph.
struct: LmxWalkFrame
    @: LmxArena arena
    @: Lmx node
    @: int args
    size_t: nargs
    @: LmxWalkOwn owns
    size_t: nowns
    size_t: cap
    int: counting
    int: returned
    int: valued
    int: result
end: LmxWalkFrame

prototype:
    # One activation of the callable occurrence `node` with `nargs` int inputs.  The value
    # of an executed `ret` is written through `result` (left alone by a void return).
    fn: lmx_walk_run (@: LmxArena arena; @: Lmx node; @: int args; size_t: nargs; @: int result) int
    # The two ends of an activation, separate so that a test can look at what entry
    # loaded.  enter: recognise M, refuse what is unsupported, load the own fields the
    # body uses (21.5).  leave: release the activation; it publishes nothing.
    fn: lmx_walk_enter (@: LmxWalkFrame f; @: LmxArena arena; @: Lmx node; @: int args; size_t: nargs) int
    sub: lmx_walk_leave (@: LmxWalkFrame f)

    # Construction of body nodes, for a translator and for tests.  A node is a fresh
    # Structure of `arena` with `children` slots; a frame node gets a fresh LmxOp of
    # `code` in child[0].  The caller stores it into its parent's slot.
    fn: lmx_walk_frame (@: LmxArena arena; @: Lmx parent; int: code; size_t: children) @: Lmx
    fn: lmx_walk_plain (@: LmxArena arena; @: Lmx parent; size_t: children) @: Lmx
    fn: lmx_walk_store_size (@: LmxArena arena; @: Lmx code; size_t: slot; size_t: value) int
    fn: lmx_walk_store_int (@: LmxArena arena; @: Lmx code; size_t: slot; int: value) int

    # Internal steps, named here because they are mutually recursive.
    fn: lmx_walk_op (@: LmxWalkFrame f; @: void code) int
    fn: lmx_walk_scan (@: LmxWalkFrame f; @: Lmx code; size_t: first) int
    fn: lmx_walk_eval (@: LmxWalkFrame f; @: void code; @: int out) int
    fn: lmx_walk_body (@: LmxWalkFrame f; @: Lmx body; size_t: first) int
    fn: lmx_walk_checkpoint (@: LmxWalkFrame f) int
end: prototype
