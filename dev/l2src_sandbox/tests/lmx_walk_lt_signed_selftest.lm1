predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# C99 numeric promotion and D-51 working width size_t (not ulong).
# Mutants: unsigned int compare -> negative int LT RED; width back to ulong -> size_t 2^32 EQ RED.
# Char numeric values follow the target C char; intern-table indices are unsigned bytes.

@: LmxArena ga 0
@: Lmx groles 0
@: LmxWalkContext gctx 0
@: LmxWalkValue gv 0
int: broken 0
int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(ga, groles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(ga, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

# k.4: a walked callable occurrence is just the ordinary body Structure -- no descriptor;
# `native` stays 0 by construction. `children` now counts body steps only, so every call
# site below shrinks by one and its first body-step frame moves from slot 1 to slot 0.
fn: mk_m (@: Lmx unit; size_t: slot; size_t: children) @: Lmx
return: pl(unit, slot, children)

fn: go (@: Lmx m) int
    if: m = 0 || gctx = 0 || gv = 0
        return: c.LMX_WALK_INVALID
return: lmx_walk_run(gctx, m, 0, 0U, gv)

sub: char_op (@: Lmx unit; int: op; int: a; int: b; int: char_rhs; int: expected; const: @(char label))
    @: Lmx m mk_m(unit, 0U, 1U)
    @: Lmx ret fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    @: Lmx expr fr(ret, 1U, op, 3U)
    @: Lmx lhs fr(expr, 1U, c.LMX_WALK_OP_LIT, 2U)
    @: Lmx rhs fr(expr, 2U, c.LMX_WALK_OP_LIT, 2U)
    int: st
    if: lmx_walk_store_char(ga, lhs, 1U, a & 255) != c.LMX_WALK_OK
        broken: broken + 1
    if: char_rhs != 0
        st: lmx_walk_store_char(ga, rhs, 1U, b & 255)
    else:
        st: lmx_walk_store_int(ga, rhs, 1U, b)
    ---
    if: st != c.LMX_WALK_OK
        broken: broken + 1
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\number = expected)), label)
end: char_op

fn: main () int
    LmxArena: arena
    LmxArena: context_arena
    LmxPool: context_cells
    LmxScratch: store
    LmxWalkContext: context
    @: Lmx unit 0
    @: Lmx m 0
    @: Lmx n 0
    @: Lmx lt 0
    @: Lmx eqn 0
    @: Lmx litn 0
    ulong: uzero 0U
    size_t: szero 0U
    int: st 0
    int: byte 0
    char: actual 0
    @: Lmx chars_source 0
    @: Lmx chars_copy 0
    @: char copy_table 0
    @: void char_cell 0

    c.printf("D-51 measure: sizeof(ulong)=%u sizeof(size_t)=%u\n", (cast: (unsigned) c.sizeof(uzero)), (cast: (unsigned) c.sizeof(szero)))

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        return: 2
    ga: @ arena
    if: lmx_chars_init(ga) != 0
        return: 2
    groles: lmx_walk_roles_open(ga)
    memset((cast: (@: void) (@ context_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxScratch))
    if: lmx_arena_open(@ context_arena) != 0 || lmx_scratch_open(@ store, @ context_arena, @ context_cells, 16U) != c.LMX_SCRATCH_OK
        return: 2
    context.arena: ga
    context.scratch: @ store
    context.roles: groles
    context.immutable_profile: 0
    context.classified: 0U
    gctx: @ context
    gv: (cast: (@: LmxWalkValue) calloc(1U, c.sizeof(c.LmxWalkValue)))
    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 4U) != 0
        return: 2
    ---

    # ret (lt (lit -1) (lit 0)) -> 1
    m: mk_m(unit, 0U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    lt: fr(n, 1U, c.LMX_WALK_OP_LT, 3U)
    litn: fr(lt, 1U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 0 - 1) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    litn: fr(lt, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 0) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\number = 1)), "int -1 < 0")

    # Numeric ordering must match C char on the actual target.
    m: mk_m(unit, 0U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    lt: fr(n, 1U, c.LMX_WALK_OP_LT, 3U)
    litn: fr(lt, 1U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_char(ga, litn, 1U, 100) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    litn: fr(lt, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_char(ga, litn, 1U, 200) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\number = ((cast: (char) 100) < (cast: (char) 200)))), "char ordering follows C99")

    char_op(unit, c.LMX_WALK_OP_ADD, 100, 100, 1, 200, "char addition produces promoted int")
    char_op(unit, c.LMX_WALK_OP_EQ, 200, 200, 0, (cast: (int) ((cast: (char) 200) = 200)), "char versus int keeps integer literal")
    char_op(unit, c.LMX_WALK_OP_DIV, 249, 2, 0, (cast: (char) 249) / 2, "char division follows C99")
    char_op(unit, c.LMX_WALK_OP_MOD, 249, 2, 0, (cast: (char) 249) % 2, "char remainder follows C99")

    # All interned byte encodings read as C char, through both getter APIs.
    while: byte < 256
        actual: (cast: (char) byte)
        char_cell: lmx_char_cell(ga, byte)
        check((cast: (int) (lmx_char_value(char_cell) = (cast: (int) actual) && lmx_char_value_known(char_cell) = (cast: (int) actual))), "interned char equals C99 value")
        byte: byte + 1
    ---
    chars_source: lmx_node_new_owned(ga)
    copy_table: lmx_chars_new_owned(@ context_arena)
    if: chars_source = 0 || copy_table = 0 || lmx_arena_refs_open_owned(ga, chars_source, 3U) != 0
        return: 2
    ---
    lmx_arena_ref_store(chars_source, 0U, lmx_char_cell(ga, 128))
    lmx_arena_ref_store(chars_source, 1U, lmx_char_cell(ga, 200))
    lmx_arena_ref_store(chars_source, 2U, lmx_char_cell(ga, 255))
    st: lmx_graph_copy_owned(chars_source, ga, @ context_arena, @ chars_copy)
    check((cast: (int) (st = 0 && chars_copy != 0)), "char graph copy")
    if: chars_copy != 0
        check((cast: (int) (lmx_char_value_known(lmx_arena_ref_value(chars_copy, 0U)) = (cast: (int) (cast: (char) 128)))), "copied char 128")
        check((cast: (int) (lmx_char_value_known(lmx_arena_ref_value(chars_copy, 1U)) = (cast: (int) (cast: (char) 200)))), "copied char 200")
        check((cast: (int) (lmx_char_value_known(lmx_arena_ref_value(chars_copy, 2U)) = (cast: (int) (cast: (char) 255)) && lmx_arena_ref_value(chars_copy, 2U) != lmx_char_cell_known(copy_table, 255))), "copied char 255 is an independent typed cell")
    ---


    # D-51: size_t 2^32 equals itself (full width); not equal to 0
    m: mk_m(unit, 0U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    eqn: fr(n, 1U, c.LMX_WALK_OP_EQ, 3U)
    litn: fr(eqn, 1U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_size(ga, litn, 1U, (cast: (size_t) 1U) << 32) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    litn: fr(eqn, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_size(ga, litn, 1U, (cast: (size_t) 1U) << 32) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\number = 1)), "size_t 2^32 == 2^32")

    m: mk_m(unit, 0U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    eqn: fr(n, 1U, c.LMX_WALK_OP_EQ, 3U)
    litn: fr(eqn, 1U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_size(ga, litn, 1U, (cast: (size_t) 1U) << 32) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    litn: fr(eqn, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_size(ga, litn, 1U, 0U) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\number = 0)), "size_t 2^32 != 0")
    c.printf("lmx_walk_lt_signed_selftest checks=%d failures=%d broken=%d\n", checks, failures, broken)
    if: failures != 0 || broken != 0
        return: 1
return: 0
