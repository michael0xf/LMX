---
    Observed:
        int: early 1001028
        int: late 1001028
        int: seen 7
    end: Observed
---
sub: build () (
    int: early (typeof (D [] 0))
    D:
        @: p int
    end: D
    C:
        @: p int
    end: C
    int: i 7
    int: late 0
    int: seen 0
)
    :=: (D \ p) (@ (data \ i))
    call: D C
    :=: (data \ late) (typeof (D [] 0))
    :=: (data \ seen) (\ (D \ p))
end: build
build:
int: early ((build \ data) \ early)
int: late ((build \ data) \ late)
int: seen ((build \ data) \ seen)
sub: main ()
    @: sink (node [] 0)
    :=: ((sink \ Observed) \ early) (node \ early)
    :=: ((sink \ Observed) \ late) (node \ late)
    :=: ((sink \ Observed) \ seen) (node \ seen)
end: main
main:
