# Original: l2src/l2trans.lm1:10603
fn: lm_compiler_scan_index_head (const: (@: source_node c.LmP0Node); int: mi; @: seen int) int
    int: status
    @: expression c.L2HeadExpression c.lm_compiler_head_expression(source_node, @ status)
    @: first c.LmP0Field
    int: count
    int: taken 1
    if: status = 2
        return: (cast: (int) (2))
    if: expression = 0
