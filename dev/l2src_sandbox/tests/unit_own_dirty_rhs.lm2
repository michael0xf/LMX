# FABLE-SONNET-OCC-ROOT-20260924-146 commit 2 / D-25: orphan, measured and
# completed -- the original never called m(), and even called, its return
# value did not depend on what observe() actually saw, so a broken
# dynamic-input read would have passed silently either way. `quote` (m's
# own char field) is read bare inside observe, an unrelated method with no
# local `quote` of its own -- a dynamic input threaded in from the
# caller's own (dirty, not yet checkpointed) working value. observe's
# result now reports which branch it actually took, so the witness fails
# if the dynamic read does not see m's dirty 65.
fn: observe (int: z) int
    if: quote = 65
        quote: 88
        return: 1
    else:
        quote: 11
        return: 0
    return: 0
end: observe
fn: m (int: z) int
    char: quote
    quote: 65
    return: observe(0)
end: m

int: got
got: m(0)
if: got != 1
    return: 81
return: 0
