# Historical filename retained: the former subset refusal is now a positive
# ARG/EXEC test with a descriptor-only signature anchor. inc and apply must
# be walked; the unimplemented intToInt descriptor is never executed.
fn: intToInt (int: x) int
end: intToInt
fn: inc (int: x) int
    return: x + 1
end: inc
fn: apply (intToInt: op; int: value) int
    return: op(value)
end: apply
sendMessage: exit(exit_code: apply(inc, 6); stdout: ""; stderr: "")
return
