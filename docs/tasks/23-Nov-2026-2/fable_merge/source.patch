+FxFailureFilter:
+    private:
+        @: names
+        char[]: excluded
+    return: @
+    without:
+        private: @: out (copy(()))
+        sys\resize(out; length(names))
+        private: int: used 0
+        private: int: i 0
+        while: i < length(names)
+            private: char[]: name \names[i]
+            if: FxSameText\same(name; excluded) = 0
+                out[used] := names[i]
