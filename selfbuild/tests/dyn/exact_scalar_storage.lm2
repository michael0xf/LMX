fn: es_storage_check () int
    c.LmxArena: arena
    @: g c.LmxGraph 0
    int: status 0
    c.memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: c.lmx_arena_open(@ arena) != 0
        return: 80
    g := c.lmx_graph_open(@ arena)
    if: g = 0
        return: 81
    status := es_rows(@ arena, g)
    if: status = 0
        status := es_values(@ arena, g)
    if: status = 0
        status := es_copy(@ arena, g, 0)
    if: status = 0
        status := es_source_factory(@ arena, g)
    if: status = 0
        status := es_qualify(@ arena)
    if: status = 0
        status := es_unfilled()
    if: status = 0
        status := es_physical_binding("flong", "c.long double")
    if: status = 0
        status := es_physical_binding("llong", "c.long long")
    if: status = 0
        status := es_physical_binding("ullong", "c.unsigned long long")
    if: status = 0
        status := es_physical_binding("schar", "c.signed char")
    if: status = 0
        status := es_physical_binding("ushort", "c.unsigned short")
    if: status = 0
        status := es_physical_binding("ulong", "c.unsigned long")
    if: status = 0
        status := es_receiving(@ arena, g)
    if: status = 0
        status := es_argument_scalar()
    if: status = 0
        status := es_escaped_scalar()
    c.lmx_graph_close(g)
    c.lmx_arena_release(@ arena)
    if: status != 0
        return: status
    return: 7
