Addition:
    int: x
    int: y
    return: int
    add:
        return: x + y

DefaultProbe:
    return: int
    run:
        int: y 100
        @: fiveContext (merge(Addition; (int: y 5)))
        @: add5 fiveContext\add
        int: first add5(1)
        int: second add5(1; y := 25)
        int: third add5(1; y := 0)
        int: fourth add5(1)
        return: first * 1000000 + second * 10000 + third * 100 + fourth
