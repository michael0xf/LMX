---
    Observed:
        int: hits 9
        int: after_bare 4
        int: after_put 9
    end: Observed
---
@: shared (data [] 0)
int: hits 9
sub: bare (int: v)
    :=: hits v
end: bare
sub: put (int: v)
    :=: (node \ hits) v
end: put
bare: 5
int: after_bare hits
put: 9
int: after_put (data \ hits)
sub: main ()
    :=: ((shared \ Observed) \ hits) (node \ hits)
    :=: ((shared \ Observed) \ after_bare) after_bare
    :=: ((shared \ Observed) \ after_put) after_put
end: main
main:
