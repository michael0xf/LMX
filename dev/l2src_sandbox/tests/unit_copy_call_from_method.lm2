# A valid program: a method names the root's copy by a free name and calls
# it; the root supplies its own binding of that name. The copy's body runs.
# OPEN positive: the value of a Structure-typed hidden input has no proved
# origin at the call yet, and the call is refused as unsupported. Entry 7.
A:
    int: last 0
    last: 17
ra: merge A
fn: f () int
    ra
    return: 0
int: k f()
int: result 81
if: ra\last = 17 && A\last = 0
    result: 7
sendMessage: exit(exit_code: result; stdout: ""; stderr: "")
return
