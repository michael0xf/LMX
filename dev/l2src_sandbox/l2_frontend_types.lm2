            return: (cast: (int) (1))
        \out_ty: -12
        if: dest != 0 && (c.lm_compiler_tx_wrapn(dest, 0, f\value\as\atom\data, f\value\as\atom\length, " ") != 0 || c.lm_compiler_tx_catn(dest, g\value\as\atom\data, g\value\as\atom\length) != 0)
            return: (cast: (int) (1))
        return: (cast: (int) (0))
    word: c.lm_compiler_contract_leaf(contract, @ depth, @ qualified)
    if: word = 0
        return: (cast: (int) (1))
