# An input no caller binds reaches the method that reads it, and that method
# reads its own lexical source, not the source of a method that only handed
# the name on. Two parts (harness Parts) each declare k at its root: 5 and
# 8. peekA, of the first, reads k. hopB, of the second, calls peekA and only
# hands k on. The source declares no k: from its call of hopB the name
# arrives absent and peekA reads its own root's 5, not hopB's 8. over has
# its own k, 3: the caller's binding comes first. Entry 7.
size_t: a 0U
size_t: b 0U

fn: over () size_t
    size_t: k 3U
    return: hopB()
end: over

a: hopB()
b: over()
if: a = 8U
    sendMessage: exit(exit_code: 82; stdout: ""; stderr: "")
    return
if: a != 5U || b != 3U
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
