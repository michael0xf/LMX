# K03 NS-ROLES-VIS (the author, 2026-10-07; semantics #declaration-visibility): a method body names a qualified
# branch declared BELOW the method -- the branch's root, an ordinary named Structure, is visible from its place on,
# so cfg is read_branch's dynamic input, unbound where it is called (the S2 reading again).
fn: read_branch () size_t
return: cfg\e
independent:
    const:
        immutable:
            (): cfg
                size_t: e 7U
            end: cfg
        end: immutable
    end: const
end: independent
fn: m () int
    if: read_branch() != 7U
        return: 81
    return: 7
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
