# Stable libssh2 1.11.1; reuse exactly the root Mbed TLS and zlib instances.
# This module may be included before curl, then again by the systems group.
include_guard(GLOBAL)
get_filename_component(_lmx_systems_ssh_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
get_filename_component(_lmx_systems_bundle "${_lmx_systems_ssh_root}/../.." ABSOLUTE)
if(NOT TARGET LMX::mbedcrypto OR NOT TARGET LMX::zlib)
    message(FATAL_ERROR "LibSSH2.cmake requires the root LMX::mbedcrypto and LMX::zlib targets first.")
endif()
function(_lmx_add_libssh2)
    set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
    set(BUILD_STATIC_LIBS ON)
    set(BUILD_SHARED_LIBS OFF)
    set(BUILD_EXAMPLES OFF)
    set(BUILD_TESTING OFF)
    set(LINT OFF)
    set(CRYPTO_BACKEND "mbedTLS" CACHE STRING "LMX shared crypto backend" FORCE)
    set(MBEDTLS_INCLUDE_DIR "${LMX_VENDOR_DIR}/mbedtls/include")
    set(MBEDCRYPTO_LIBRARY LMX::mbedcrypto)
    set(MBEDTLS_FOUND FALSE)
    set(ENABLE_ZLIB_COMPRESSION ON)
    set(ZLIB_INCLUDE_DIR "${LMX_VENDOR_DIR}/zlib")
    set(ZLIB_LIBRARY LMX::zlib)
    set(ZLIB_LIBRARY_RELEASE LMX::zlib)
    set(ZLIB_LIBRARY_DEBUG LMX::zlib)
    # Match the actual compilation policy in configure probes as well.
    if(LMX_STRICT_C99 AND CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
        string(APPEND CMAKE_C_FLAGS " -pedantic-errors")
    endif()
    # Upstream unconditionally exports a standalone installed package. That
    # export cannot contain this collection's private Mbed TLS/zlib targets.
    # Preserve all original inputs; adjust only the generated build view's
    # package-export statements, leaving C sources and configure probes intact.
    set(_view "${CMAKE_CURRENT_BINARY_DIR}/lmx-libssh2-source")
    file(MAKE_DIRECTORY "${_view}")
    file(COPY "${LMX_VENDOR_DIR}/libssh2/" DESTINATION "${_view}")
    file(READ "${_view}/src/CMakeLists.txt" _cmake)
    set(_export_install [=[install(EXPORT "${PROJECT_NAME}-targets"
  NAMESPACE "${PROJECT_NAME}::"
  DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/${PROJECT_NAME}")]=])
    set(_export_build [=[export(TARGETS ${_libssh2_export} NAMESPACE "${PROJECT_NAME}::" FILE "${PROJECT_NAME}-targets.cmake")]=])
    set(_export_register [=[export(PACKAGE ${PROJECT_NAME})  # register it]=])
    foreach(_needle IN ITEMS _export_install _export_build _export_register)
        string(FIND "${_cmake}" "${${_needle}}" _found)
        if(_found EQUAL -1)
            message(FATAL_ERROR "Unexpected libssh2 1.11.1 CMake input: ${_needle}")
        endif()
        string(REPLACE "${${_needle}}" "# LMX: standalone package export disabled in this build view." _cmake "${_cmake}")
    endforeach()
    file(WRITE "${_view}/src/CMakeLists.txt" "${_cmake}")
    include("${_lmx_systems_ssh_root}/cmake/LibSSH2Security.cmake")
    lmx_libssh2_apply_security_view("${_view}")
    set_property(GLOBAL PROPERTY LMX_LIBSSH2_VIEW "${_view}")
    set_property(GLOBAL PROPERTY LMX_LIBSSH2_BINARY "${CMAKE_CURRENT_BINARY_DIR}/lmx-libssh2")
    add_subdirectory("${_view}" "${CMAKE_CURRENT_BINARY_DIR}/lmx-libssh2")
endfunction()
_lmx_add_libssh2()
lmx_c99_target(libssh2_static)
target_compile_definitions(libssh2_static PUBLIC LIBSSH2_STATIC
    PRIVATE _POSIX_C_SOURCE=200809L _DEFAULT_SOURCE=1)
add_library(LMX::libssh2 ALIAS libssh2_static)
message(STATUS "LMX libssh2 1.11.1: shared bundled Mbed TLS 3.6.7 + zlib 1.4")
