# The letter is an ordinary typed value: a MainLetter formal receives the same
# reference the entry holds, and a typed formal reads its fields -- the formal's
# own argument, not the declaration.
MainLetter:
    char: []: []: mainArgs
end: MainLetter

MainLetter: m
nextMessage: m

fn: same (MainLetter: letter) int
    if: letter = m
        return: 1
return: 0

fn: first (MainLetter: letter) int
return: letter\mainArgs[0][0]

if: m = 0
    return: 81
if: same(m) != 1
    return: 82
if: first(m) = 0
    return: 83
return: 0
