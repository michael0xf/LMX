predef: "l2src/lmx_merge_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_primitive.h.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_thread.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# RR2a (critical_qualifier_receivers_bug; steps/qualifier-receivers-20261010.md): a copy and a fresh merge can be made
# UNDER a profile -- the root, every cell, every children range, an array's descriptor and backing are cells of the
# profile's own pools (lmx_graph_copy_qualified_owned, lmx_merge_qualified_owned) -- so a value qualified at run time
# carries the same physical mark the prologue gives a static branch: the range index classifies it by its profile.
# lmx_arena_seal_profile then ends allocation in those pools (lmx_pool_take_n refuses a sealed pool) and leaves every
# other pool as it was.  Mutants: a profile of 0 at any one allocation site of the copier -> that cell answers 0;
# lmx_arena_seal_profile sealing nothing -> the sealed checks fail; sealing the unprofiled pools too -> the P check fails.

sub: check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

fn: main () int
    LmxArena: a
    LmxArena: d
    LmxArena: imported_a
    LmxArena: imported_d
    LmxArena: scoped_src
    LmxArena: scoped_dst
    LmxArena: scoped_view
    @: Lmx root 0
    @: Lmx inner 0
    @: Lmx copy 0
    @: Lmx copy0 0
    @: Lmx copy2 0
    @: Lmx parented_copy 0
    @: Lmx mres 0
    @: Lmx mres2 0
    @: Lmx other 0
    @: Lmx profile 0
    @: Lmx profile_q 0
    @: Lmx profile_r 0
    @: Lmx profile_s 0
    @: Lmx profile_t 0
    @: Lmx profile_u 0
    @: Lmx mres3 0
    @: Lmx mres4 0
    @: Lmx plain 0
    @: Lmx plain2 0
    @: Lmx qcopy 0
    @: Lmx profile_v 0
    @: Lmx holder 0
    @: Lmx leaf 0
    @: Lmx leafcopy 0
    @: Lmx profile_w 0
    @: Lmx imported_parent 0
    @: Lmx imported_child 0
    @: Lmx imported_profile 0
    @: Lmx scoped_parent 0
    @: Lmx scoped_profile 0
    @: Lmx scoped_branch 0
    @: Lmx scoped_target 0
    @@: Lmx scoped_sources 0
    @@: Lmx scoped_results 0
    LmxCopyMap: scoped_profiles
    LmxCopyMap: scoped_pending
    LmxCopyMap: scoped_map
    @: Lmx forest_a 0
    @: Lmx forest_b 0
    @: Lmx forest_profile 0
    @: Lmx remap_source_a 0
    @: Lmx remap_source_b 0
    @: Lmx remap_source_c 0
    @: Lmx remap_target_a 0
    @: Lmx remap_target_b 0
    @: Lmx remap_target_c 0
    @: Lmx remap_a 0
    @: Lmx remap_b 0
    @: Lmx remap_c 0
    @: void remap_int_a 0
    @: void remap_int_b 0
    LmxCopyMap: profile_map
    @@: Lmx forest_out 0
    LmxCopyMap: forest_pending
    LmxCopyMap: forest_map
    @@: Lmx leaves 0
    @: void seven 0
    @: void eight 0
    @: void letter 0
    @: VoidArray numbers 0
    @: int ints 0
    @: void c0 0
    @: Lmx c1 0
    @: void c1c 0
    @: VoidArray c2 0
    @: int c2i 0
    @@: Lmx operands 0
    @: int counts 0
    int: status 0

    counts: (cast: (@: int) calloc(2U, c.sizeof(int)))
    operands: (cast: (@@: Lmx) calloc(2U, c.sizeof(@: Lmx)))
    if: counts = 0 || operands = 0
        return: 2
    memset((cast: (@: void) (@ a)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ d)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ a) != 0 || lmx_arena_open(@ d) != 0
        return: 2

    # The source: root [int 7, inner [char 'x'], int Array (1 2 3)] in arena a, unprofiled.
    root: lmx_node_new_owned(@ a)
    inner: lmx_node_new_owned(@ a)
    check(counts, root != 0 && inner != 0 && lmx_arena_refs_open_owned(@ a, root, 3U) = 0 && lmx_arena_refs_open_owned(@ a, inner, 1U) = 0, "source Structures")
    inner\parent: root
    seven: lmx_int_new_owned(@ a)
    letter: lmx_char_new_owned(@ a)
    numbers: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_INT, 3U, @ a)
    check(counts, seven != 0 && letter != 0 && numbers != 0 && numbers\data != 0, "source cells")
    lmx_int_store_known(seven, 7)
    lmx_char_store_known(letter, 120)
    ints: (cast: (@: int) numbers\data)
    ints[0]: 1
    ints[1]: 2
    ints[2]: 3
    lmx_arena_ref_store(root, 0U, seven)
    lmx_arena_ref_store(root, 1U, (cast: (@: void) inner))
    lmx_arena_ref_store(root, 2U, (cast: (@: void) numbers))
    lmx_arena_ref_store(inner, 0U, letter)

    # The profiles: Structures of the destination arena, in its unprofiled STRUCT pool.
    profile: lmx_node_new_owned(@ d)
    profile_q: lmx_node_new_owned(@ d)
    profile_r: lmx_node_new_owned(@ d)
    check(counts, profile != 0 && profile_q != 0 && profile_r != 0 && lmx_range_profile(@ d, (cast: (@: void) profile)) = 0, "profile Structures of d, unprofiled themselves")

    # Case A: a copy under profile P -- every cell of the result is classified by P.
    status: lmx_graph_copy_qualified_owned(root, @ a, @ d, 0, 0U, profile, @ copy)
    check(counts, status = LMX_GRAPH_COPY_OK && copy != 0 && copy != root, "copy under P made")
    if: copy != 0
        check(counts, lmx_range_profile(@ d, (cast: (@: void) copy)) = profile, "root of the copy answers P")
        check(counts, (copy\array.data) != 0 && lmx_range_profile(@ d, (cast: (@: void) (copy\array.data))) = profile, "children range of the copy answers P")
        c0: lmx_arena_ref_value(copy, 0U)
        check(counts, c0 != 0 && c0 != seven && lmx_range_profile(@ d, c0) = profile && lmx_int_value_known(c0) = 7, "int cell copied under P, value 7")
        c1: (cast: (@: Lmx) lmx_arena_ref_value(copy, 1U))
        check(counts, c1 != 0 && c1 != inner && lmx_range_profile(@ d, (cast: (@: void) c1)) = profile && c1\parent = copy, "nested Structure copied under P, parent the copy")
        if: c1 != 0
            c1c: lmx_arena_ref_value(c1, 0U)
            check(counts, c1c != 0 && lmx_range_profile(@ d, c1c) = profile && lmx_char_value_known(c1c) = 120, "char cell copied under P, value x")
        ---
        c2: (cast: (@: VoidArray) lmx_arena_ref_value(copy, 2U))
        check(counts, c2 != 0 && c2 != numbers && lmx_range_profile(@ d, (cast: (@: void) c2)) = profile, "array descriptor copied under P")
        if: c2 != 0 && c2\data != 0
            check(counts, lmx_range_profile(@ d, c2\data) = profile, "array backing copied under P")
            c2i: (cast: (@: int) c2\data)
            check(counts, c2\size = 3U && c2i[0] = 1 && c2i[2] = 3, "array elements copied")
        ---
    ---
    check(counts, lmx_range_profile(@ a, (cast: (@: void) root)) = 0 && lmx_int_value_known(seven) = 7, "source unprofiled and untouched")

    # A subtree-only cross-arena copy cannot leave the copied child's parent
    # pointing into the source arena. The ordinary whole copy may copy that
    # lexical path instead.
    status: lmx_graph_copy_qualified_owned(inner, @ a, @ d, 0, 0U, profile_r, @ copy2)
    check(counts, status = LMX_GRAPH_COPY_INVALID && copy2 = 0, "cross-arena subtree refuses a mutable outside parent")
    status: lmx_graph_copy_owned(inner, @ a, @ d, @ copy2)
    check(counts, status = LMX_GRAPH_COPY_OK && copy2 != 0 && copy2\parent != root, "whole copy carries the lexical parent into destination")
    parented_copy: copy2

    # Case B: the ordinary copy keeps profile 0 and lives in other pools than P's.
    status: lmx_graph_copy_owned(root, @ a, @ d, @ copy0)
    check(counts, status = LMX_GRAPH_COPY_OK && copy0 != 0 && lmx_range_profile(@ d, (cast: (@: void) copy0)) = 0, "ordinary copy answers 0")
    check(counts, copy != 0 && copy0 != 0 && lmx_range_pool(@ d, (cast: (@: void) copy0)) != lmx_range_pool(@ d, (cast: (@: void) copy)), "P's pool is not the unprofiled one")

    # Case C: a fresh merge under profile Q -- the result root and its copied cells answer Q.
    operands[0]: root
    status: lmx_merge_qualified_owned(operands, 1U, 0, @ a, @ d, 0, 0U, 0, 0U, profile_q, @ mres)
    check(counts, status = LMX_MERGE_OK && mres != 0 && mres != root, "merge under Q made")
    if: mres != 0
        check(counts, lmx_range_profile(@ d, (cast: (@: void) mres)) = profile_q, "merge result root answers Q")
        check(counts, (mres\array.data) != 0 && lmx_range_profile(@ d, (cast: (@: void) (mres\array.data))) = profile_q, "merge result children range answers Q")
        c0: lmx_arena_ref_value(mres, 0U)
        check(counts, c0 != 0 && lmx_range_profile(@ d, c0) = profile_q && lmx_int_value_known(c0) = 7, "merge result int cell answers Q")
    ---

    # Case C2 (RR2c-2a): a composition of two operands under profile S.  The copied operand roots are discarded
    # intermediates (the result takes their children; every link to one names the result) and are allocated outside
    # S, so the full preflight's coverage proof holds: every issued cell of S is in the published tree.  Mutant: the
    # roots under S -> the coverage proof fails (LMX_QUALIFY_INVALID).
    other: lmx_node_new_owned(@ a)
    eight: lmx_int_new_owned(@ a)
    check(counts, other != 0 && eight != 0 && lmx_arena_refs_open_owned(@ a, other, 1U) = 0, "second source Structure")
    lmx_int_store_known(eight, 8)
    lmx_arena_ref_store(other, 0U, eight)
    profile_s: lmx_node_new_owned(@ d)
    operands[0]: root
    operands[1]: other
    status: lmx_merge_qualified_owned(operands, 2U, 0, @ a, @ d, 0, 0U, 0, 0U, profile_s, @ mres2)
    check(counts, status = LMX_MERGE_OK && mres2 != 0, "composition under S made")
    if: mres2 != 0
        mres2\parent: 0
        check(counts, (mres2\array.size) = 4U && lmx_range_profile(@ d, (cast: (@: void) mres2)) = profile_s, "composition root answers S, four slots")
        c0: lmx_arena_ref_value(mres2, 3U)
        check(counts, c0 != 0 && lmx_range_profile(@ d, c0) = profile_s && lmx_int_value_known(c0) = 8, "second operand's int cell copied under S, value 8")
        check(counts, lmx_qualify_tree_preflight_full(@ d, mres2, 0, 0, 0U, 0, 0U, 0, 0U) = LMX_QUALIFY_OK, "the composition covers S: no discarded intermediate root in the profile")
    ---

    # Case E (RR2c-2b; LMX_blog/q/immutable-root-parent.md): a merge under profile T whose root keeps an ORDINARY
    # lexical parent -- a Structure of no profile, as the copy of a lexical chain is -- passes the full preflight: the
    # root's parent is a structural link outside the selected tree, not a stored data reference (book #qualification).
    # Retention (lmx_merge_retain_profile) is the parentless tree's: under a lexical parent the value is not retained;
    # free of one, the root and a Structure inside it answer the profile.  Mutant: the root rule requiring a prior
    # profile again -> INVALID.
    plain: lmx_node_new_owned(@ d)
    profile_t: lmx_node_new_owned(@ d)
    operands[0]: root
    status: lmx_merge_qualified_owned(operands, 1U, 0, @ a, @ d, 0, 0U, 0, 0U, profile_t, @ mres3)
    check(counts, status = LMX_MERGE_OK && mres3 != 0 && plain != 0, "merge under T made")
    if: mres3 != 0
        mres3\parent: plain
        check(counts, lmx_qualify_tree_preflight_full(@ d, mres3, 0, 0, 0U, 0, 0U, 0, 0U) = LMX_QUALIFY_OK, "a root under an ordinary parent passes the preflight")
        check(counts, lmx_merge_retain_profile(@ d, mres3) = 0, "a qualified root under a lexical parent is not retained")
        mres3\parent: 0
        check(counts, lmx_merge_retain_profile(@ d, mres3) = profile_t, "a parentless qualified root is retained by its profile")
        c1: (cast: (@: Lmx) lmx_arena_ref_value(mres3, 1U))
        check(counts, c1 != 0 && lmx_merge_retain_profile(@ d, c1) = profile_t, "a Structure inside a parentless qualified tree is retained by the tree's profile")
    ---
    check(counts, lmx_merge_retain_profile(@ d, plain) = 0, "an unprofiled Structure is not retained")

    # Case E2 (RR2c-2b): the qualified COPY of a Structure that hangs under an ordinary parent -- what the translator
    # makes of a completed merge result qualified `immutable` alone -- keeps that parent as the source's own outside
    # structural link (the copier's parent fixup) and passes the full preflight.  Mutant: the fixup refusing an
    # uncopied parent again -> no copy.
    if: mres3 != 0
        mres3\parent: plain
        profile_v: lmx_node_new_owned(@ d)
        status: lmx_graph_copy_qualified_owned(mres3, @ d, @ d, 0, 0U, profile_v, @ qcopy)
        check(counts, status = LMX_GRAPH_COPY_OK && qcopy != 0 && qcopy != mres3, "the qualified copy of a parented root is made")
        if: qcopy != 0
            check(counts, qcopy\parent = plain, "the copy keeps the source's outside parent")
            check(counts, lmx_range_profile(@ d, (cast: (@: void) qcopy)) = profile_v, "the copy's root answers V")
            check(counts, lmx_qualify_tree_preflight_full(@ d, qcopy, 0, 0, 0U, 0, 0U, 0, 0U) = LMX_QUALIFY_OK, "the parented copy passes the full preflight")
            check(counts, lmx_merge_retain_profile(@ d, qcopy) = 0, "the parented copy is not retained by a merge")
        ---
        mres3\parent: 0
    ---

    # Case H: lexical leaf identity is not permission to retain a writable
    # Structure. The copy owns a new leaf; qualification then rejects its
    # unresolved mutable lexical parent rather than publishing a false proof.
    holder: lmx_node_new_owned(@ d)
    leaf: lmx_node_new_owned(@ d)
    profile_w: lmx_node_new_owned(@ d)
    leaves: (cast: (@@: Lmx) calloc(1U, c.sizeof(@: Lmx)))
    check(counts, holder != 0 && leaf != 0 && leaves != 0 && lmx_arena_refs_open_owned(@ d, holder, 2U) = 0 && lmx_arena_refs_open_owned(@ d, leaf, 1U) = 0, "a holder with a leaf")
    if: holder != 0 && leaf != 0 && leaves != 0
        leaf\parent: plain
        lmx_arena_ref_store(holder, 0U, (cast: (@: void) leaf))
        lmx_arena_ref_store(holder, 1U, (cast: (@: void) lmx_int_new_owned(@ d)))
        leaves[0]: leaf
        status: lmx_graph_copy_qualified_leaves_owned(holder, @ d, @ d, 0, 0U, profile_w, leaves, 1U, @ leafcopy)
        check(counts, status = LMX_GRAPH_COPY_OK && leafcopy != 0 && leafcopy != holder, "the qualified copy with a leaf is made")
        if: leafcopy != 0
            check(counts, lmx_arena_ref_value(leafcopy, 0U) != (cast: (@: void) leaf), "ordinary method leaf is copied, not retained")
            check(counts, lmx_range_profile(@ d, lmx_arena_ref_value(leafcopy, 0U)) = profile_w && lmx_range_profile(@ d, (cast: (@: void) leaf)) = 0, "copied method leaf has the destination profile")
            check(counts, lmx_qualify_tree_preflight_full(@ d, leafcopy, 0, 0, 0U, leaves, 1U, 0, 0U) = LMX_QUALIFY_INVALID, "mutable lexical link fails the full proof even with a named leaf")
            check(counts, lmx_qualify_tree_preflight(@ d, leafcopy, 0, 0, 0U, 0, 0U, 0, 0U) = LMX_QUALIFY_INVALID, "unnamed mutable lexical link is also refused")
        ---
    ---
    free((cast: (@: void) leaves))

    # Case F: an outside data reference stored INSIDE the tree -- a slot holding a Structure of no profile whose parent
    # is not the node -- is refused by the preflight's data rule (book #qualification: permitted only to an already
    # immutable object); the root rule above does not weaken it.  Mutant: lmx_qualify_edge accepting any Structure -> OK.
    plain2: lmx_node_new_owned(@ d)
    profile_u: lmx_node_new_owned(@ d)
    status: lmx_merge_qualified_owned(operands, 1U, 0, @ a, @ d, 0, 0U, 0, 0U, profile_u, @ mres4)
    check(counts, status = LMX_MERGE_OK && mres4 != 0 && plain2 != 0, "merge under U made")
    if: mres4 != 0
        mres4\parent: 0
        check(counts, lmx_qualify_tree_preflight(@ d, mres4, 0, 0, 0U, 0, 0U, 0, 0U) = LMX_QUALIFY_OK, "the fresh result passes the preflight before the outside reference is stored")
        lmx_arena_ref_store(mres4, 0U, (cast: (@: void) plain2))
        check(counts, lmx_qualify_tree_preflight(@ d, mres4, 0, 0, 0U, 0, 0U, 0, 0U) = LMX_QUALIFY_INVALID, "an outside data reference stored in the tree is refused")
    ---

    # Case D: sealing P's pools: P's cells sealed, the unprofiled pool and Q's pools not; no new cell under P.
    check(counts, lmx_arena_seal_profile(@ d, 0) = 1, "sealing profile 0 is refused")
    check(counts, lmx_arena_seal_profile(@ d, profile_r) = 1, "sealing a profile no array carries is refused")
    check(counts, lmx_arena_seal_profile(@ d, profile) = 0, "sealing P's pools")
    if: copy != 0
        check(counts, lmx_pool_is_sealed(lmx_range_pool(@ d, (cast: (@: void) copy))) = 1, "P's Structure pool sealed")
        check(counts, c0 != 0 && lmx_pool_is_sealed(lmx_range_pool(@ d, lmx_arena_ref_value(copy, 0U))) = 1, "P's int pool sealed")
    ---
    check(counts, lmx_pool_is_sealed(lmx_range_pool(@ d, (cast: (@: void) profile))) = 0, "the unprofiled Structure pool is not sealed")
    check(counts, mres != 0 && lmx_pool_is_sealed(lmx_range_pool(@ d, (cast: (@: void) mres))) = 0, "Q's Structure pool is not sealed")
    status: lmx_graph_copy_qualified_owned(root, @ a, @ d, 0, 0U, profile, @ copy2)
    check(counts, status != LMX_GRAPH_COPY_OK && copy2 = 0, "a sealed profile takes no new cell (lmx_pool_take_n)")
    status: lmx_graph_copy_owned(root, @ a, @ d, @ copy2)
    check(counts, status = LMX_GRAPH_COPY_OK && copy2 != 0, "the unprofiled pools still allocate after sealing P")

    # Two independent roots share one operation map. Their cross-root edges
    # must point to the two new addresses, and the map remains available to a
    # later incoming-edge rewrite before its transient buffers are disposed.
    forest_a: lmx_node_new_owned(@ a)
    forest_b: lmx_node_new_owned(@ a)
    forest_profile: lmx_node_new_owned(@ d)
    forest_out: (cast: (@@: Lmx) calloc(2U, c.sizeof(@: Lmx)))
    check(counts, forest_a != 0 && forest_b != 0 && forest_profile != 0 && forest_out != 0 && lmx_arena_refs_open_owned(@ a, forest_a, 1U) = 0 && lmx_arena_refs_open_owned(@ a, forest_b, 1U) = 0 && lmx_arena_ref_store(forest_a, 0U, (cast: (@: void) forest_b)) = 0 && lmx_arena_ref_store(forest_b, 0U, (cast: (@: void) forest_a)) = 0, "forest cross-root source")
    operands[0]: forest_a
    operands[1]: forest_b
    memset((cast: (@: void) (@ forest_pending)), 0, c.sizeof(c.LmxCopyMap))
    memset((cast: (@: void) (@ forest_map)), 0, c.sizeof(c.LmxCopyMap))
    status: lmx_graph_copy_forest_profiled_staged(operands, 2U, @ a, @ d, 0, 0U, forest_profile, forest_out, @ forest_pending, @ forest_map)
    check(counts, status = LMX_GRAPH_COPY_OK && forest_out[0] != 0 && forest_out[1] != 0 && forest_out[0] != forest_a && forest_out[1] != forest_b && lmx_range_profile(@ d, (cast: (@: void) forest_out[0])) = forest_profile && lmx_range_profile(@ d, (cast: (@: void) forest_out[1])) = forest_profile, "profiled forest copy allocates both roots")
    if: status = LMX_GRAPH_COPY_OK
        check(counts, lmx_arena_ref_value(forest_out[0], 0U) = (cast: (@: void) forest_out[1]) && lmx_arena_ref_value(forest_out[1], 0U) = (cast: (@: void) forest_out[0]), "forest cross-root edges follow one map")
        check(counts, lmx_copy_map_get(@ forest_map, (cast: (@: void) forest_a)) = (cast: (@: void) forest_out[0]) && lmx_copy_map_get(@ forest_map, (cast: (@: void) forest_b)) = (cast: (@: void) forest_out[1]), "forest returns address relocation map")
    ---
    lmx_copy_names_finish(@ forest_pending, (cast: (int) (status = LMX_GRAPH_COPY_OK)))
    lmx_graph_copy_map_dispose(@ forest_map)
    free((cast: (@: void) forest_out))

    # Low-level relocation witness, not a qualification witness: these sealed
    # source pools form a cross-profile cycle whose separate full proofs are
    # outside this test. The copier must still preserve the cycle and place
    # each root in the selected destination profile.
    remap_source_a: lmx_node_new_owned(@ a)
    remap_source_b: lmx_node_new_owned(@ a)
    remap_source_c: lmx_node_new_owned(@ a)
    remap_target_a: lmx_node_new_owned(@ d)
    remap_target_b: lmx_node_new_owned(@ d)
    remap_target_c: lmx_node_new_owned(@ d)
    remap_a: lmx_node_new_profiled(@ a, remap_source_a)
    remap_b: lmx_node_new_profiled(@ a, remap_source_b)
    remap_c: lmx_node_new_profiled(@ a, remap_source_c)
    remap_int_a: lmx_int_new_profiled(@ a, remap_source_a)
    remap_int_b: lmx_int_new_profiled(@ a, remap_source_b)
    check(counts, remap_source_a != 0 && remap_source_b != 0 && remap_source_c != 0 && remap_target_a != 0 && remap_target_b != 0 && remap_target_c != 0 && remap_a != 0 && remap_b != 0 && remap_c != 0 && remap_int_a != 0 && remap_int_b != 0 && lmx_int_store_known(remap_int_a, 17) = 0 && lmx_int_store_known(remap_int_b, 29) = 0 && lmx_arena_refs_open_profiled(@ a, remap_a, 3U, remap_source_a) = 0 && lmx_arena_refs_open_profiled(@ a, remap_b, 2U, remap_source_b) = 0 && lmx_arena_ref_store(remap_a, 0U, (cast: (@: void) remap_b)) = 0 && lmx_arena_ref_store(remap_b, 0U, (cast: (@: void) remap_a)) = 0 && lmx_arena_ref_store(remap_a, 1U, remap_int_a) = 0 && lmx_arena_ref_store(remap_b, 1U, remap_int_b) = 0 && lmx_arena_ref_store(remap_a, 2U, (cast: (@: void) remap_c)) = 0 && lmx_arena_seal_profile(@ a, remap_source_a) = 0 && lmx_arena_seal_profile(@ a, remap_source_b) = 0 && lmx_arena_seal_profile(@ a, remap_source_c) = 0, "three source profiles include a reached non-root branch")
    check(counts, lmx_copy_map_init(@ profile_map) = 0 && lmx_copy_map_put(@ profile_map, (cast: (@: void) remap_source_a), (cast: (@: void) remap_target_a)) = 0, "first source profile has a destination")
    operands[0]: remap_a
    operands[1]: remap_b
    forest_out: (cast: (@@: Lmx) calloc(2U, c.sizeof(@: Lmx)))
    status: lmx_graph_copy_forest_remapped_staged(operands, 2U, @ a, @ d, 0, 0U, @ profile_map, forest_out, @ forest_pending, @ forest_map)
    check(counts, status = LMX_GRAPH_COPY_INVALID && forest_out[0] = 0 && forest_out[1] = 0, "missing profile mapping refuses before allocation")
    check(counts, lmx_copy_map_put(@ profile_map, (cast: (@: void) remap_source_b), (cast: (@: void) remap_target_b)) = 0, "second root profile has a distinct destination")
    status: lmx_graph_copy_forest_remapped_staged(operands, 2U, @ a, @ d, 0, 0U, @ profile_map, forest_out, @ forest_pending, @ forest_map)
    check(counts, status = LMX_GRAPH_COPY_INVALID && forest_out[0] = 0 && forest_out[1] = 0, "unmapped sealed dependency reached from a root refuses rather than inheriting its profile")
    check(counts, lmx_copy_map_put(@ profile_map, (cast: (@: void) remap_source_c), (cast: (@: void) remap_target_c)) = 0, "reached third source profile has its own destination")
    status: lmx_graph_copy_forest_remapped_staged(operands, 2U, @ a, @ d, 0, 0U, @ profile_map, forest_out, @ forest_pending, @ forest_map)
    check(counts, status = LMX_GRAPH_COPY_OK && forest_out[0] != 0 && forest_out[1] != 0 && lmx_range_profile(@ d, (cast: (@: void) forest_out[0])) = remap_target_a && lmx_range_profile(@ d, (cast: (@: void) forest_out[1])) = remap_target_b, "qualified roots copy into their distinct target profiles")
    if: status = LMX_GRAPH_COPY_OK
        check(counts, lmx_arena_ref_value(forest_out[0], 0U) = (cast: (@: void) forest_out[1]) && lmx_arena_ref_value(forest_out[1], 0U) = (cast: (@: void) forest_out[0]), "cross-profile edges follow the common relocation map")
        check(counts, lmx_range_profile(@ d, lmx_arena_ref_value(forest_out[0], 1U)) = remap_target_a && lmx_range_profile(@ d, lmx_arena_ref_value(forest_out[1], 1U)) = remap_target_b && lmx_int_value_known(lmx_arena_ref_value(forest_out[0], 1U)) = 17 && lmx_int_value_known(lmx_arena_ref_value(forest_out[1], 1U)) = 29, "nested scalar cells keep separate destination profiles and values")
        check(counts, lmx_arena_ref_value(forest_out[0], 2U) = lmx_copy_map_get(@ forest_map, (cast: (@: void) remap_c)) && lmx_range_profile(@ d, lmx_arena_ref_value(forest_out[0], 2U)) = remap_target_c, "reached third branch has its own mapped profile")
    ---
    lmx_copy_names_finish(@ forest_pending, (cast: (int) (status = LMX_GRAPH_COPY_OK)))
    lmx_graph_copy_map_dispose(@ forest_map)
    lmx_copy_map_dispose(@ profile_map)
    free((cast: (@: void) forest_out))

    lmx_arena_release(@ a)
    check(counts, parented_copy != 0 && parented_copy\parent != 0 && lmx_range_classify(@ d, (cast: (@: void) parented_copy\parent)) = c.LMX_KIND_STRUCT && lmx_char_value_known(lmx_arena_ref_value(parented_copy, 0U)) = 120, "copied lexical path survives release of source arena")

    # Arena views can coincide even when the physical parent belongs to a
    # different imported arena. The parent guard must check physical home.
    memset((cast: (@: void) (@ imported_a)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ imported_d)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ imported_a) != 0 || lmx_arena_open(@ imported_d) != 0
        return: 2
    imported_parent: lmx_node_new_owned(@ imported_a)
    imported_child: lmx_node_new_owned(@ imported_a)
    imported_profile: lmx_node_new_owned(@ imported_d)
    if: imported_parent = 0 || imported_child = 0 || imported_profile = 0
        return: 2
    imported_child\parent: imported_parent
    check(counts, lmx_pool_seal(lmx_range_pool(@ imported_a, (cast: (@: void) imported_parent))) = 0 && lmx_range_import(@ imported_d, @ imported_a) = 0, "destination view imports the foreign parent")
    status: lmx_graph_copy_qualified_owned(imported_child, @ imported_d, @ imported_d, 0, 0U, imported_profile, @ copy2)
    check(counts, status = LMX_GRAPH_COPY_INVALID && copy2 = 0, "same arena view cannot retain a foreign physical parent")
    lmx_arena_release(@ imported_d)
    lmx_arena_release(@ imported_a)

    # A non-independent immutable branch has a mutable lexical parent. A
    # remapped forest copies that parent into an ordinary pool, never into the
    # branch's destination profile. The disposable source view can classify
    # both origins without publishing a mutable foreign import.
    memset((cast: (@: void) (@ scoped_src)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ scoped_dst)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ scoped_view)), 0, c.sizeof(c.LmxArena))
    check(counts, lmx_arena_open(@ scoped_src) = 0 && lmx_arena_open(@ scoped_dst) = 0 && lmx_arena_open_source_view(@ scoped_view) = 0, "scoped profile arenas open")
    scoped_parent: lmx_node_new_owned(@ scoped_src)
    scoped_profile: lmx_node_new_owned(@ scoped_src)
    scoped_branch: lmx_node_new_profiled(@ scoped_src, scoped_profile)
    scoped_target: lmx_node_new_owned(@ scoped_dst)
    if: scoped_branch != 0
        scoped_branch\parent: scoped_parent
    ---
    check(counts, scoped_parent != 0 && scoped_profile != 0 && scoped_branch != 0 && scoped_target != 0 && lmx_qualify_tree_preflight_full(@ scoped_src, scoped_branch, 0, 0, 0U, 0, 0U, 0, 0U) = LMX_QUALIFY_OK && lmx_arena_seal_profile(@ scoped_src, scoped_profile) = 0, "immutable branch with ordinary lexical parent qualifies")
    check(counts, lmx_range_import_source_view(@ scoped_view, @ scoped_src) = 0 && lmx_range_classify(@ scoped_view, (cast: (@: void) scoped_parent)) = c.LMX_KIND_STRUCT && lmx_range_home(@ scoped_view, (cast: (@: void) scoped_parent)) = (@ scoped_src), "source view sees ordinary lexical parent with true owner")
    scoped_sources: (cast: (@@: Lmx) calloc(1U, c.sizeof(@: Lmx)))
    scoped_results: (cast: (@@: Lmx) calloc(1U, c.sizeof(@: Lmx)))
    memset((cast: (@: void) (@ scoped_profiles)), 0, c.sizeof(c.LmxCopyMap))
    memset((cast: (@: void) (@ scoped_pending)), 0, c.sizeof(c.LmxCopyMap))
    memset((cast: (@: void) (@ scoped_map)), 0, c.sizeof(c.LmxCopyMap))
    check(counts, scoped_sources != 0 && scoped_results != 0 && lmx_copy_map_init(@ scoped_profiles) = 0 && lmx_copy_map_put(@ scoped_profiles, (cast: (@: void) scoped_profile), (cast: (@: void) scoped_target)) = 0, "scoped profile remap prepared")
    scoped_sources[0]: scoped_branch
    status: lmx_graph_copy_forest_remapped_staged(scoped_sources, 1U, @ scoped_view, @ scoped_dst, 0, 0U, @ scoped_profiles, scoped_results, @ scoped_pending, @ scoped_map)
    check(counts, status = LMX_GRAPH_COPY_OK && scoped_results[0] != 0 && scoped_results[0]\parent != scoped_parent && scoped_results[0]\parent != 0 && lmx_range_profile(@ scoped_dst, (cast: (@: void) scoped_results[0])) = scoped_target && lmx_range_profile(@ scoped_dst, (cast: (@: void) scoped_results[0]\parent)) = 0, "remapped branch copies mutable lexical parent outside immutable profile")
    if: status = LMX_GRAPH_COPY_OK
        check(counts, lmx_qualify_tree_preflight_full(@ scoped_dst, scoped_results[0], 0, 0, 0U, 0, 0U, 0, 0U) = LMX_QUALIFY_OK && lmx_arena_seal_profile(@ scoped_dst, scoped_target) = 0 && lmx_pool_is_sealed(lmx_range_pool(@ scoped_dst, (cast: (@: void) scoped_results[0]\parent))) = 0, "copied immutable branch seals without sealing its lexical parent")
    ---
    lmx_copy_names_finish(@ scoped_pending, (cast: (int) (status = LMX_GRAPH_COPY_OK)))
    lmx_graph_copy_map_dispose(@ scoped_map)
    lmx_copy_map_dispose(@ scoped_profiles)
    free((cast: (@: void) scoped_sources))
    free((cast: (@: void) scoped_results))
    check(counts, lmx_arena_release(@ scoped_view) = 0 && lmx_arena_release(@ scoped_src) = 0 && lmx_arena_release(@ scoped_dst) = 0, "scoped source and copied graph release independently")

    c.printf("lmx_copy_profile_selftest checks=%d failures=%d\n", counts[0], counts[1])
    free((cast: (@: void) operands))
    if: counts[1] != 0
        free(counts)
        return: 1
    ---
    free(counts)
return: 0
