# Closed references by name are no error (the author 2026-11-11; plan M11 5a): A holds the atom B, B holds the atom A,
# and a path through them goes round -- A\B is B, A\B\A is A, A\B\A\B is B; nothing is expanded, so nothing loops and
# the dump prints both blocks as written.
A:
    int: v 1
    B
end: A
B:
    int: v 2
    A
end: B
int: seen A\B\A\B\v
