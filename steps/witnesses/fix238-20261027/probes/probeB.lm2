# Probe B: two consecutive deref-prefixed actuals of a C call (shape of emit:7035 / 7570, refused by the seed).
include: "<stdio.h>"
fn: show (@: out int) int
    int: uslot 5
    if: c.printf("%d %d %d\n", \out, \out, uslot) < 0
        return: 1
    return: 0
end: show
fn: run () int
    int: v 7
    if: show(@ v) != 0
        return: 80
    return: 7
end: run
sendMessage: exit(exit_code: run(); stdout: ""; stderr: "")
return
