---
    Observed:
        int: r 10010
    end: Observed
---
int: x 99
fn: id (int: v) int
    return: v
end: id
sub: poke ()
    :=: (node \ x) 99
end: poke
fn: probe () int
    int: first (id x)
    poke:
    int: second (id x)
    return: ((first * 1000) + second)
end: probe
int: r (probe)
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ r) r
end: main
main:
