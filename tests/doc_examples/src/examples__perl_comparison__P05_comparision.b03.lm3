Example:
    []int: items
    return: @
    run:
        int: negative 0
        int: below 1
        int: i 0
        while: i < length(items)
            if: items[i] < 0
                negative := 1
                break
            i += 1
        i := 0
        while: i < length(items)
            if: items[i] >= 10
                below := 0
                break
            i += 1
        return: (negative; below)
