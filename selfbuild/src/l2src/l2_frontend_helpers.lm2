            if: p >= 6 && lm_compiler_rw_prec_machine(p) = 0
                return: (cast: (int) (1))
            if: source_node\kind = c.LM_P0_NODE_STRUCTURE && source_node\as\structure != 0 && lm_compiler_fields_may_live_int_bin((cast: (@: c.LmP0Field) source_node\as\structure\first_field)) != 0
                return: (cast: (int) (1))
            if: source_node\kind = c.LM_P0_NODE_FRAME && source_node\as\frame != 0
                if: source_node\as\frame\body != 0 && lm_compiler_fields_may_live_int_bin((cast: (@: c.LmP0Field) source_node\as\frame\body\first_field)) != 0
                    return: (cast: (int) (1))
                if: source_node\as\frame\trailer != 0 && source_node\as\frame\trailer\body != 0 && lm_compiler_fields_may_live_int_bin((cast: (@: c.LmP0Field) source_node\as\frame\trailer\body\first_field)) != 0
                    return: (cast: (int) (1))
            ---
        ---
        field: lm_compiler_next_active((cast: (@: c.LmP0Field) field\next))
    ---
    return: (cast: (int) (0))
end: lm_compiler_fields_may_live_int_bin_range

# Existing first-only callers retain their ordinary nested DATA scan.
fn: lm_compiler_fields_may_live_int_bin (@: first c.LmP0Field) int
    return: lm_compiler_fields_may_live_int_bin_range(first, 0)
end: lm_compiler_fields_may_live_int_bin

fn: lm_compiler_body_may_live_int_bin (const: (@: body c.LmP0Structure); @: first c.LmP0Field) int
    @: field c.LmP0Field
    @: stop c.LmP0Field
    @: resume c.LmP0Field 0
    int: count
    if: body = 0
        return: 0
    if: lm_compiler_part_source_body(body) = 0
        return: lm_compiler_fields_may_live_int_bin(first)
    field: lm_compiler_next_active((cast: (@: c.LmP0Field) body\first_field))
    while: field != 0 || resume != 0
        field: lm_compiler_unit_cursor_field(field, @ resume)
        if: field = 0
            break
        count: lm_compiler_unit_span_count(field)
        stop: lm_compiler_skip_span(field, count)
        if: lm_compiler_fields_may_live_int_bin_range(field, stop) != 0
            return: 1
        field: stop
    ---
    return: 0
end: lm_compiler_body_may_live_int_bin

fn: lm_compiler_merge_body_typed_null (const: (@: decl c.L2Declaration)) int
    if: decl = 0 || decl\candidate_count != 1
        return: (cast: (int) (0))
    return: (cast: (int) (lm_compiler_reference_null_literal((cast: (@: c.LmP0Field) decl\candidate), (cast: (int) (decl\candidate_count)))))
end: lm_compiler_merge_body_typed_null

fn: lm_compiler_emit_os_target_guard (@: out c.FILE) int
    if: lm_compiler_os_target() = 1
        if: c.fputs("os:\n    default:\n        int: l2_os_target_guard c.l2_os_translated_for_win\nend: os\n\n", out) < 0
            return: (cast: (int) (1))
        return: (cast: (int) (0))
    ---
    if: c.fputs("os:\n    win:\n        int: l2_os_target_guard c.l2_os_translated_for_the_default_platform\nend: os\n\n", out) < 0
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: lm_compiler_emit_os_target_guard

fn: lm_compiler_construct_name_ok (const: (@: s char)) int
    size_t: i 0U
    int: ch
    if: s = 0 || s[0] = 0 || c.strncmp(s, "l2_", 3U) = 0 || c.strncmp(s, "lmx_", 4U) = 0
        return: (cast: (int) (0))
    while: s[i] != 0
        ch: (cast: (int) (cast: (c.uchar) s[i]))
        if: (ch < 97 || ch > 122) && (ch < 65 || ch > 90) && ch != 95 && (i = 0U || ch < 48 || ch > 57)
            return: (cast: (int) (0))
        i: i + 1U
    ---
    return: (cast: (int) (1))
end: lm_compiler_construct_name_ok

os:
    win:
        fn: lm_compiler_os_target () int
            return: (cast: (int) (1))
        end: lm_compiler_os_target
    default:
        fn: lm_compiler_os_target () int
            return: (cast: (int) (2))
        end: lm_compiler_os_target
end: os
