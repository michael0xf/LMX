Example:
    int[]: xs
    int: lo
    int: hi
    return: int
    run:
        int: n length(xs)
        if: n = 0
            return: 0
        int: accepted 0
        int: i 0
        while: i < n
            if: xs[i] >= lo && xs[i] <= hi
                accepted += 1
            i += 1
        int: scaled 1000 * accepted
        return: (scaled - scaled % n) / n
