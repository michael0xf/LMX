fn: f (int: a; int: b) int (int: calls 0; int: last 0)
    calls: calls + 1
    last: a * 10 + b
    return: last
end: f
g: merge(f)
g(1; 2)
fn: pair (int: x) int
    g(3; 4)
    return: x + 1
end: pair
int: r pair(5)
g(b := 7; a := 6)
int: f_calls f\var\calls
int: f_last f\var\last
int: g_calls g\var\calls
int: g_last g\var\last
