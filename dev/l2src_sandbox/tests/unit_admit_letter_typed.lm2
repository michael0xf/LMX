# MainLetter is an ordinary declared Structure (author, Q15): its one field is
# an Array of references to char Arrays.  `nextMessage:` into a MainLetter own
# field admits the argv letter at run time; the typed value then passes to a
# MainLetter formal statically.
MainLetter:
    char: []: []: mainArgs
end: MainLetter

fn: present (MainLetter: letter) int
return: 1

MainLetter: m
nextMessage: m
if: m = 0
    return: 1
nextMessage: raw
if: raw != 0
    return: 2
if: present(m) != 1
    return: 3
return: 0
