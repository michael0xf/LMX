Router:
    int: value
    @: first negative
    @: second even
    int: trace 0
    return: int
    negative:
        node\trace := node\trace * 10 + 1
        if: value < 0
            return: 1
        return: 0
    even:
        node\trace := node\trace * 10 + 2
        if: value % 2 = 0
            return: 2
        return: 0
    dispatch:
        int: result first()
        if: result
            return: result
        return: second()
    demo:
        node\trace := 0
        int: a dispatch(-6)
        int: b dispatch(-6; even; negative)
        int: c dispatch(7)
        return: a * 100 + b * 10 + c
