# P0 tail-cutter probe t4b: t4 with one --- at the inner if head level (8 spaces).
include: "<string.h>"
fn: probe (@: path char) int
    int: failed 0
    size_t: n c.strlen(path)
    if: failed = 0
        n: n + 1U
        if: n = 0U
            failed: 1
        ---
    if: failed = 0
        failed: 2
    return: failed
end: probe
int: r probe("ab")
if: r != 2
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
