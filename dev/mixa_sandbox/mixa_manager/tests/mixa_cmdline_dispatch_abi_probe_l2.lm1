# ABI parity guard — L1 port of mixa_cmdline_dispatch_abi_probe_l2.c (ticket 20260918-082421).
# offsetof is a C macro with no L1 spelling (c. pastes a call, not a preprocessor
# name). Field offsets are computed at run time via pointer arithmetic on a local
# store (same pattern as l2src/lmx_message_selftest.lm1). Output format strings
# are kept byte-identical to the C probe so L2-vs-real parity still diffs stdout.
predef: "mixa_manager/mixa_cmdline_dispatch_l2.h.lm1"
include: "<stdio.h>"

fn: main () int
    MixaCmdDispatch: store0
    @: MixaCmdDispatch p0
    p0: @ store0

    c.printf("MixaCmdDispatch sizeof=%zu\n", c.sizeof(c.MixaCmdDispatch))
    c.printf("MixaCmdDispatch proc=%zu\n", (cast: (size_t) @ p0\proc) - (cast: (size_t) p0))
    c.printf("MixaCmdDispatch scanner=%zu\n", (cast: (size_t) @ p0\scanner) - (cast: (size_t) p0))
    c.printf("MixaCmdDispatch console_file=%zu\n", (cast: (size_t) @ p0\console_file) - (cast: (size_t) p0))
    c.printf("MixaCmdDispatch wrapper_path=%zu\n", (cast: (size_t) @ p0\wrapper_path) - (cast: (size_t) p0))
    c.printf("MixaCmdDispatch done=%zu\n", (cast: (size_t) @ p0\done) - (cast: (size_t) p0))
    c.printf("MixaCmdDispatch exit_code=%zu\n", (cast: (size_t) @ p0\exit_code) - (cast: (size_t) p0))
    c.printf("MixaCmdDispatch new_cwd=%zu\n", (cast: (size_t) @ p0\new_cwd) - (cast: (size_t) p0))
    return: 0

