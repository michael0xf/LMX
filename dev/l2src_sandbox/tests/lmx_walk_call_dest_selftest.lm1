predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/tests/walk_contract_fixture.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# Native callbacks receive a declared-width result destination. CHAR and SIZE_T
# snapshots survive nested calls without arena allocation or result aliasing.

@: LmxArena ga 0
@: Lmx groles 0
@: LmxWalkContext gctx 0
@: LmxWalkValue gv 0
int: broken 0
int: checks 0
int: failures 0
@: Lmx flip_target 0
int: flip_old_calls 0
int: flip_new_calls 0
int: flip_actual_calls 0
int: flip_to_walk 0
@: Lmx future_add 0
@: Lmx future_right 0
int: future_rewrites 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(ga, groles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(ga, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

sub: ref (@: Lmx code; size_t: slot; @: Lmx target)
    if: code = 0 || target = 0 || lmx_arena_ref_store(code, slot, (cast: (@: void) target)) != 0
        broken: broken + 1
    ---
end: ref

sub: sz (@: Lmx code; size_t: slot; size_t: value)
    if: code = 0 || lmx_walk_store_size(ga, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: sz

# k.4: a walked/native callable occurrence is just the ordinary body Structure -- no
# descriptor; `native` stays 0 by construction unless set directly.
fn: mk_m (@: Lmx unit; size_t: slot; size_t: children) @: Lmx
return: pl(unit, slot, children)

fn: go (@: Lmx m) int
    if: m = 0 || gctx = 0 || gv = 0
        return: c.LMX_WALK_INVALID
return: lmx_walk_run(gctx, m, 0, 0U, gv)


# Wide size_t that does not fit in 32-bit int (and is not 0 when truncated badly).
fn: g1_wide (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code) int
    size_t: w 1U
    if: dest = 0 || out = 0
        return: 1
    ---
    w: w << 32
    w: w + 7U
    if: lmx_size_store_known(dest, w) != 0
        return: 1
    ---
    \out: dest
return: 0

fn: g1_char (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code) int
    lmx_char_store_known(dest, 200)
    \out: dest
return: 0

fn: flip_old (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code) int
    flip_old_calls: flip_old_calls + 1
    lmx_int_store_known(dest, 11)
    \out: dest
return: 0

fn: flip_new (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code) int
    flip_new_calls: flip_new_calls + 1
    lmx_int_store_known(dest, 22)
    \out: dest
return: 0

fn: flip_actual (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code) int
    flip_actual_calls: flip_actual_calls + 1
    if: flip_to_walk != 0
        flip_target\native: 0
    else:
        flip_target\native: (cast: (LmxEntry) flip_new)
    ---
    lmx_int_store_known(dest, 7)
    \out: dest
return: 0

# A native callee may change a not-yet-read physical edge of its caller.
# The walker must continue from that point and read the current child, without
# restarting the already-effectful CALL.
fn: rewrite_future_edge (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code) int
    future_rewrites: future_rewrites + 1
    if: dest = 0 || out = 0 || future_add = 0 || future_right = 0 || lmx_arena_ref_store(future_add, 2U, (cast: (@: void) future_right)) != 0
        return: 1
    ---
    lmx_int_store_known(dest, 0)
    \out: dest
return: 0

sub: check_live_future_edge ()
    @: Lmx unit lmx_node_new_owned(ga)
    @: Lmx mutator 0
    @: Lmx caller 0
    @: Lmx ret 0
    @: Lmx add 0
    @: Lmx call 0
    @: Lmx old_right 0
    @: Lmx new_right 0
    int: st 0
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 2U) != 0
        broken: broken + 1
        return
    ---
    mutator: mk_m(unit, 0U, 0U)
    caller: mk_m(unit, 1U, 1U)
    if: mutator = 0 || caller = 0
        broken: broken + 1
        return
    ---
    mutator\native: (cast: (LmxEntry) rewrite_future_edge)
    ret: fr(caller, 0U, c.LMX_WALK_OP_RET, 2U)
    add: fr(ret, 1U, c.LMX_WALK_OP_ADD, 3U)
    call: fr(add, 1U, c.LMX_WALK_OP_CALL, 5U)
    ref(call, 1U, mutator)
    ref(call, 2U, mutator)
    ref(call, 3U, wt_contract_same(ga, 0U, 0, c.LMX_TYPE_INT))
    old_right: fr(add, 2U, c.LMX_WALK_OP_LIT, 2U)
    new_right: lmx_walk_frame(ga, groles, add, c.LMX_WALK_OP_LIT, 2U)
    if: old_right = 0 || new_right = 0 || lmx_walk_store_int(ga, old_right, 1U, 1) != c.LMX_WALK_OK || lmx_walk_store_int(ga, new_right, 1U, 2) != c.LMX_WALK_OK
        broken: broken + 1
        return
    ---
    future_add: add
    future_right: new_right
    future_rewrites: 0
    st: go(caller)
    check(st = c.LMX_WALK_OK && gv\present != 0 && gv\type = c.LMX_TYPE_INT && gv\number = 2U && future_rewrites = 1 && lmx_arena_ref_struct(add, 2U) = new_right, "walker sees a future code edge rewritten by an earlier native CALL")
    future_add: 0
    future_right: 0
end: check_live_future_edge

# An actual's own call changes the selected callee's native word. Dispatch of
# the outer call must read that word only after the actual has finished.
sub: check_late_native_selection (@: Lmx unit)
    @: Lmx target mk_m(unit, 5U, 2U)
    @: Lmx mutator mk_m(unit, 6U, 0U)
    @: Lmx caller mk_m(unit, 7U, 1U)
    @: Lmx ret 0
    @: Lmx literal 0
    @: Lmx outer 0
    @: Lmx inner 0
    int: st 0
    if: target = 0 || mutator = 0 || caller = 0
        broken: broken + 1
        return
    ---
    flip_target: target
    target\native: (cast: (LmxEntry) flip_old)
    mutator\native: (cast: (LmxEntry) flip_actual)
    if: lmx_arena_ref_store(target, 0U, (cast: (@: void) lmx_walk_plain(ga, target, 1U))) != 0
        broken: broken + 1
    ---
    ret: fr(target, 1U, c.LMX_WALK_OP_RET, 2U)
    literal: fr(ret, 1U, c.LMX_WALK_OP_LIT, 2U)
    if: lmx_walk_store_int(ga, literal, 1U, 23) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    outer: fr(caller, 0U, c.LMX_WALK_OP_CALL, 6U)
    ref(outer, 1U, target)
    ref(outer, 2U, target)
    ref(outer, 3U, wt_contract_same(ga, 1U, c.LMX_TYPE_INT, c.LMX_TYPE_INT))
    inner: fr(outer, 5U, c.LMX_WALK_OP_CALL, 5U)
    ref(inner, 1U, mutator)
    ref(inner, 2U, mutator)
    ref(inner, 3U, wt_contract_same(ga, 0U, c.LMX_TYPE_INT, c.LMX_TYPE_INT))
    st: go(caller)
    check(st = c.LMX_WALK_OK && gv\present != 0 && gv\type = c.LMX_TYPE_INT && gv\number = 22 && flip_actual_calls = 1 && flip_old_calls = 0 && flip_new_calls = 1, "CALL reads selected native after effectful actual")
    flip_to_walk: 1
    target\native: (cast: (LmxEntry) flip_old)
    st: go(caller)
    check(st = c.LMX_WALK_OK && gv\present != 0 && gv\type = c.LMX_TYPE_INT && gv\number = 23 && flip_actual_calls = 2 && flip_old_calls = 0 && flip_new_calls = 1, "CALL observes native removal by actual and walks selected body")
end: check_late_native_selection

sub: char_cells (@: Lmx unit)
    LmxWalkFrame: frame
    LmxWalkPlace: place
    LmxWalkValue: supplied
    LmxWalkValue: received
    LmxWalkValue: first_value
    @: void a lmx_char_new_owned(ga)
    @: void b lmx_char_new_owned(ga)
    @: void result 0
    @: void saved 0
    @: void actual 0
    @: void dest 0
    @: void repeated 0
    @: Lmx callee 0
    @: Lmx caller 0
    @: Lmx ret 0
    @: Lmx own 0
    @: Lmx call 0
    @: Lmx copied 0
    size_t: field 0U
    int: spare 0
    int: st 0
    memset(@ frame, 0, c.sizeof(c.LmxWalkFrame))
    frame.arena: ga
    frame.context: gctx
    actual: lmx_char_cell(ga, 65)
    frame.args: @ actual
    frame.nargs: 1U
    if: lmx_walk_args_open(@ frame) != c.LMX_WALK_OK
        c.abort()
    if: a = 0 || b = 0 || actual = 0
        c.abort()
    lmx_char_store_known(a, 65)
    saved: a
    check(lmx_walk_store_slot(ga, @ a, 66U) = c.LMX_WALK_OK && a = saved && lmx_char_value_known(a) = 66, "published char mutates existing slot cell")
    check(lmx_walk_store_numeric_into(ga, actual, 66U) = c.LMX_WALK_INVALID && lmx_char_value_known(actual) = 65, "an arbitrary char operand is not a mutable destination")
    lmx_walk_value_num(@ supplied, c.LMX_TYPE_CHAR, 66U)
    st: lmx_walk_arg_write(@ frame, 0U, c.LMX_TYPE_CHAR, @ supplied, @ received)
    lmx_walk_arg_place(@ frame, 0U, c.LMX_TYPE_CHAR, @ place)
    saved: (place.address)
    check(st = c.LMX_WALK_OK && saved != actual && saved != lmx_char_cell(ga, 66) && lmx_char_value_known(actual) = 65 && (received.byte) = 66, "formal char assignment owns its cell without mutating actual")
    lmx_walk_value_num(@ supplied, c.LMX_TYPE_CHAR, 67U)
    st: lmx_walk_arg_write(@ frame, 0U, c.LMX_TYPE_CHAR, @ supplied, @ received)
    lmx_walk_arg_place(@ frame, 0U, c.LMX_TYPE_CHAR, @ place)
    check(st = c.LMX_WALK_OK && (place.address) = saved && lmx_char_value_known(saved) = 67 && lmx_char_value_known(lmx_char_cell(ga, 66)) = 66, "repeated char formal assignment preserves local cell")
    st: lmx_walk_value_num(@ supplied, c.LMX_TYPE_CHAR, 68U)
    check(st = c.LMX_WALK_OK && (supplied.present) != 0 && (supplied.type) = c.LMX_TYPE_CHAR && (supplied.byte) = 68 && lmx_char_value_known(a) = 66 && lmx_char_value_known(lmx_char_cell(ga, 68)) = 68, "char expression temporary has its own typed value and preserves literal intern")
    callee: mk_m(unit, 2U, 2U)
    lmx_arena_ref_store(callee, 0U, a)
    ret: fr(callee, 1U, c.LMX_WALK_OP_RET, 2U)
    own: fr(ret, 1U, c.LMX_WALK_OP_OWN, 3U)
    ref(own, 1U, callee)
    sz(own, 2U, 0U)
    caller: mk_m(unit, 3U, 1U)
    call: fr(caller, 0U, c.LMX_WALK_OP_CALL, 5U)
    ref(call, 1U, callee)
    ref(call, 2U, callee)
    ref(call, 3U, wt_contract_same(ga, 0U, 0, c.LMX_TYPE_CHAR))
    st: go(caller)
    memcpy(@ first_value, gv, c.sizeof(c.LmxWalkValue))
    check(st = c.LMX_WALK_OK && (first_value.present) != 0 && (first_value.type) = c.LMX_TYPE_CHAR && (first_value.byte) = 66, "walked own char return is an independent typed value")
    lmx_char_store_known(a, 67)
    st: go(caller)
    check(st = c.LMX_WALK_OK && gv\type = c.LMX_TYPE_CHAR && gv\byte = 67 && (first_value.byte) = 66, "two walked char results retain independent values")
    callee\native: (cast: (LmxEntry) g1_char)
    st: go(caller)
    check(st = c.LMX_WALK_OK && gv\type = c.LMX_TYPE_CHAR && gv\byte = (cast: (char) 200) && lmx_char_value_known(lmx_char_cell(ga, 0)) = 0, "native char trampoline receives mutable typed destination")
    copied: lmx_walk_capture(ga, unit, callee, callee, @ field, 1U, 0)
    result: lmx_arena_ref_value(copied, 0U)
    check(copied != 0 && result != a && lmx_char_value_known(result) = 67, "char capture owns independent cell")
    lmx_char_store_known(a, 68)
    check(lmx_char_value_known(result) = 67, "source char mutation leaves capture unchanged")
end: char_cells

fn: main () int
    LmxArena: arena
    LmxArena: context_arena
    LmxPool: context_cells
    LmxScratch: store
    LmxWalkContext: context
    @: Lmx unit 0
    @: Lmx m 0
    @: Lmx n 0
    @: Lmx native 0
    @: Lmx caller 0
    @: void return_contract 0
    size_t: got 0U
    size_t: want 1U
    int: st 0

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        return: 2
    ga: @ arena
    groles: lmx_walk_roles_open(ga)
    memset((cast: (@: void) (@ context_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxScratch))
    if: lmx_arena_open(@ context_arena) != 0 || lmx_scratch_open(@ store, @ context_arena, @ context_cells, 16U) != c.LMX_SCRATCH_OK
        return: 2
    context.arena: ga
    context.scratch: @ store
    context.roles: groles
    context.immutable_profile: 0
    context.classified: 0U
    gctx: @ context
    gv: (cast: (@: LmxWalkValue) calloc(1U, c.sizeof(c.LmxWalkValue)))

    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 8U) != 0
        return: 2
    ---
    # The actual native word is dispatched with a SIZE_T return contract.
    native: mk_m(unit, 1U, 0U)
    caller: mk_m(unit, 0U, 1U)
    return_contract: (cast: (@: void) wt_contract_same(ga, 0U, c.LMX_TYPE_INT, c.LMX_TYPE_SIZE_T))
    if: native = 0 || caller = 0 || return_contract = 0
        return: 2
    ---
    native\native: (cast: (LmxEntry) g1_wide)

    n: fr(caller, 0U, c.LMX_WALK_OP_CALL, 5U)
    ref(n, 1U, native)
    ref(n, 2U, native)
    ref(n, 3U, (cast: (@: Lmx) return_contract))
    st: go(caller)
    want: 1U
    want: want << 32
    want: want + 7U
    if: st = c.LMX_WALK_OK && gv\present != 0 && gv\type = c.LMX_TYPE_SIZE_T
        got: gv\wide
    ---
    check((cast: (int) (st = c.LMX_WALK_OK && lmx_walk_value_storage(gv) = (cast: (@: void) (@ gv\wide)) && lmx_walk_value_storage(gv) != (cast: (@: void) (@ gv\number)))), "CALL dest is not the int temp")
    check((cast: (int) (st = c.LMX_WALK_OK && got = want)), "size_t trampoline dest holds full 2^32+7")
    check((cast: (int) (gv\present != 0 && gv\type = c.LMX_TYPE_SIZE_T)), "dest cell type is SIZE_T")

    # A declared void call discards its walked body's last numeric CALL value.
    m: mk_m(unit, 4U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_CALL, 5U)
    ref(n, 1U, caller)
    ref(n, 2U, caller)
    ref(n, 3U, wt_contract_same(ga, 0U, 0, 0))
    st: go(m)
    check(st = c.LMX_WALK_OK && gv\present = 0, "void CALL discards walked body-last numeric value")

    char_cells(unit)
    check_late_native_selection(unit)
    check_live_future_edge()
    c.printf("lmx_walk_call_dest_selftest checks=%d failures=%d broken=%d\n", checks, failures, broken)
    if: failures != 0 || broken != 0
        return: 1
return: 0
