Meter:
    int: calls 0
    return: int
    next:
        node\calls += 1
        return: node\calls

Evaluation:
    return: int
    prepared:
        throws:
            FxArity
            FxIndex
            FxTypeToken
            FxKernelFailure
            SequenceSize
            ReceiverIndex
            FxLazyCycle
        @: delayed lazy(Meter\next)
        return: delayed() + delayed()
    raw:
        return: Meter\next() + Meter\next()
