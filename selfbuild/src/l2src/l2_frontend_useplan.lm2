fn: lm_compiler_d105_catalog_close (@: catalog c.L2D105Catalog) int
    @: alloc_err_cell int (cast: (@: int) (@ c.l2_alloc_err))
    @: d105t_n_cell int (cast: (@: int) (@ c.l2_d105t_n))
    @@: d105t_cand_cell int (cast: (@@: int) (@ c.l2_d105t_cand))
    @@: d105t_req_cell int (cast: (@@: int) (@ c.l2_d105t_req))
    @: row c.L2D105CatalogRow
    @: plan c.L2D105Plan
    @: step c.L2D105Step
    size_t: extent 1U
    int: j
    int: child
    int: cand
    int: req
    if: catalog = 0 || catalog\ready != 0
        return: (cast: (int) (1))
    if: lm_compiler_d105_plan_prepare() != 0
        return: (cast: (int) (1))
    row: catalog\first
    while: row != 0
        plan: row\plan
        if: plan = 0 || plan\ready = 0 || plan\width < 0 || plan\width > c.INT_MAX / 2 || plan\physical_width < 0 || plan\physical_width > c.INT_MAX / 2
            return: (cast: (int) (1))
        const: (@: port_steps c.L2D105StepDynamicArray (cast: (const: @: c.L2D105StepDynamicArray) (@ plan\steps)))
        if: port_steps\size != (cast: (size_t) (plan\width * 2))
            return: (cast: (int) (1))
        if: extent > (cast: (size_t) c.INT_MAX) - 3U || (cast: (size_t) plan\physical_width) > ((cast: (size_t) c.INT_MAX) - extent - 3U) / 2U
            alloc_err_cell[0]: 2
            return: (cast: (int) (1))
        extent: extent + 3U + (cast: (size_t) (plan\physical_width * 2))
        j: 0
        while: j < plan\width * 2
            step: port_steps\data + j
            child: step\child_pair
            if: child >= 0
                if: child >= d105t_n_cell[0]
                    return: (cast: (int) (1))
                cand: d105t_cand_cell[0][child]
                req: d105t_req_cell[0][child]
                if: lm_compiler_d105_catalog_add(catalog, cand, req) != 0
                    return: (cast: (int) (1))
            ---
            j: j + 1
        ---
        row: row\next
    ---
    # Required type closure is separate from possible physical candidates.
    # Identity plans retain the SAME selected declaration fields. Following
    # their owned/ref type edges needs neither another parser nor a guessed
    # current exemplar, and terminates on recursive model identities.
    row: catalog\required_first
    while: row != 0
        plan: row\plan
        if: lm_compiler_d105_plan_build(plan) != 0
            return: (cast: (int) (1))
        const: (@: port_required_steps c.L2D105StepDynamicArray (cast: (const: @: c.L2D105StepDynamicArray) (@ plan\steps)))
        j: 0
        while: j < plan\width
            step: port_required_steps\data + j
            req: -1
            const: (@: port_requirement c.L2SchemaField (cast: (const: @: c.L2SchemaField) (@ step\requirement)))
            if: port_requirement\kind = 2 || port_requirement\kind = 3
                req: port_requirement\model
            if: port_requirement\kind = 10 && port_requirement\pointee >= 0
                req: port_requirement\pointee
                if: catalog\reference_count >= ((cast: (size_t) c.INT_MAX) - 1U) / 3U
                    return: (cast: (int) (1))
                catalog\reference_count: catalog\reference_count + 1U
            ---
            if: req != -1 && lm_compiler_d105_catalog_require(catalog, req) != 0
                return: (cast: (int) (1))
            j: j + 1
        ---
        row: row\next
    ---
