# Source order across differently named Structure, char and int fields.
hStruct:
    int: p 3
end: hStruct
char: hChar 'C'
int: hInt 77
Model:
    int: first 0
    char: middle '?'
    int: last 0
    first: node\hStruct\p
    middle: node\hChar
    last: node\hInt
end: Model
hInt
hInt: hInt + 1
Model
char: selected hChar
int: selectedLast hInt
int: ok 7
if: Model\first != 3 || Model\middle != 'C' || Model\last != 78
    ok: 81
if: selected != 'C' || selectedLast != 78
    ok: 82
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
