# FACTORY (the author, 2026-10-05): `@: h f(a)` receives a factory's result; this row wrote `h: f a` until then.
# A held definition that writes through a reference among its free names
# writes the Structure it was given. g0 adds k to m\v and gives the sum.
# near calls the held u0 and has no m. From the root the unit's m, with v
# 4, is written: 9. has has its own m, with v 40, and calls near: its own m
# is written, 45, and it reads 45 back after the call. The unit's m is as
# the root's call left it, 9. Entry 7.
Model:
    int: v 4
end: Model

m: merge Model

fn: makeUse (int: k) fn: () int
    fn: g0 () int
        m\v: m\v + k
        return: m\v
    return: g0

@: u0 makeUse(5)

fn: near () int
    return: u0()
end: near

fn: has () int
    m: merge Model
    m\v: 40
    int: got near()
    return: got * 100 + m\v
end: has

int: a near()
int: b has()
int: c m\v
int: ok 7
if: a != 9
    ok: 81
if: b != 4545
    ok: 82
if: c != 9
    ok: 83
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
