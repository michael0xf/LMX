# take(h\p): the actual is a field path. Its Structure, Holder's own p, has toString only (K03 NS-ROLES-2: it was
# `Plain: p`, now Plain's call). take reads equals. p has no equals.

Equatable:
    size_t: equals 0U
end: Equatable

Holder:
    p:
        size_t: toString 0U
end: Holder

fn: take (Equatable: slot) int
    slot\equals: 1U
return: 4

fn: go (Holder: h) int
return: take(h\p)
