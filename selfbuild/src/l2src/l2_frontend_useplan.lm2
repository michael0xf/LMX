    size_t: at 1U
    int: source_token
    int: required_token
    int: j
    int: cell
    if: catalog = 0 || catalog\ready = 0 || catalog\extent < 1U || catalog\extent > (cast: (size_t) c.INT_MAX)
        return: (cast: (int) (1))
    if: c.fprintf(out_cell[0], "%sif: lmx_walk_store_size(l2_program_arena, %s, 0U, %zuU) != c.LMX_WALK_OK\n%s    %s\n", ind, frame, catalog\count, ind, failure) < 0
        return: (cast: (int) (1))
    row: catalog\first
    while: row != 0
        plan: row\plan
        if: count >= catalog\count || plan = 0 || plan\ready = 0 || plan\physical_width < 0 || plan\physical_width > c.INT_MAX / 2 || at > catalog\extent || catalog\extent - at < 3U || (cast: (size_t) plan\physical_width) > (catalog\extent - at - 3U) / 2U
            return: (cast: (int) (1))
