        if: l2_c = 0 || lmx_graph_put(l2_s2, 1U, l2_c) != 0
            return: 1
        if: lmx_graph_put(l2_s1, 1U, (cast: (@: void) l2_s2)) != 0
            return: 1
        if: lmx_graph_put(l2_s0, 2U, (cast: (@: void) l2_s1)) != 0
            return: 1
        if: lmx_graph_put(l2_program_unit, 15U, (cast: (@: void) l2_s0)) != 0
            return: 1
        l2_s0: lmx_graph_lmx(l2_g, l2_program_unit, 3U)
        if: l2_s0 = 0
            return: 1
        l2_c: lmx_graph_word(l2_g, "int", 3U)
        if: l2_c = 0 || lmx_graph_put(l2_s0, 0U, l2_c) != 0
            return: 1
        l2_c: lmx_graph_word(l2_g, "call_colon", 10U)
        if: l2_c = 0 || lmx_graph_put(l2_s0, 1U, l2_c) != 0
            return: 1
        l2_s1: lmx_graph_lmx(l2_g, l2_s0, 2U)
        if: l2_s1 = 0
            return: 1
        l2_c: lmx_graph_word(l2_g, "mytest", 6U)
        if: l2_c = 0 || lmx_graph_put(l2_s1, 0U, l2_c) != 0
            return: 1
        l2_s2: lmx_graph_lmx(l2_g, l2_s1, 2U)
        if: l2_s2 = 0
            return: 1
        l2_c: lmx_graph_word(l2_g, "a", 1U)
        if: l2_c = 0 || lmx_graph_put(l2_s2, 0U, l2_c) != 0
            return: 1
        l2_c: lmx_graph_int(l2_g, 5)
        if: l2_c = 0 || lmx_graph_put(l2_s2, 1U, l2_c) != 0
            return: 1
        if: lmx_graph_put(l2_s1, 1U, (cast: (@: void) l2_s2)) != 0
            return: 1
        if: lmx_graph_put(l2_s0, 2U, (cast: (@: void) l2_s1)) != 0
            return: 1
        if: lmx_graph_put(l2_program_unit, 16U, (cast: (@: void) l2_s0)) != 0
            return: 1
        lmx_call_code: l2_program_unit
        l2_method: (cast: (@: Lmx) lmx_graph_get(lmx_call_code, 3U))
        l2_method\native: (cast: (LmxEntry) lm_graph_method0)
        l2_method: (cast: (@: Lmx) lmx_graph_get(lmx_call_code, 4U))
        l2_method\native: (cast: (LmxEntry) lm_graph_method1)
        l2_method: (cast: (@: Lmx) lmx_graph_get(lmx_call_code, 5U))
        l2_method\native: (cast: (LmxEntry) lm_graph_method2)
        l2_method: (cast: (@: Lmx) lmx_graph_get(lmx_call_code, 6U))
        l2_method\native: (cast: (LmxEntry) lm_graph_method3)
        l2_method: (cast: (@: Lmx) lmx_graph_get(lmx_call_code, 7U))
        l2_method\native: (cast: (LmxEntry) lm_graph_method4)
        l2_method: (cast: (@: Lmx) lmx_graph_get(lmx_call_code, 8U))
        l2_method\native: (cast: (LmxEntry) lm_graph_method5)
        l2_program_unit\native: (cast: (LmxEntry) lm_graph_body)
        graph\native: (cast: (LmxEntry) lm_graph_check_root)
        return: 0
    end: l2_program_build
end: external

external:
    fn: main (int: argc; @@: char argv) int
        LmxRoot: l2_program_root
        return: lmx_root_launch(@ l2_program_root, argc, argv, l2_program_build, 1U, lmx_root_settings, 5000U, (cast: (@: void) c.stdout), (cast: (@: void) c.stderr))
    end: main
end: external
