predef: "l2src/lmx_root.lm1"
predef: "l2src/lmx_list_owned.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

sub: or_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: or_check

fn: or_thread (@: LmxArena arena; int: with_children; @@: LmxMsg out_message) @: LmxThread
    @: Lmx graph
    @: VoidArray children
    @: LmxMsg message
    @: LmxPost mail
    @: LmxThread thread
    @: LmxSchedule slot
    \out_message: 0
    graph: lmx_node_new_owned(arena)
    if: graph = 0
        return: 0
    ---
    if: with_children != 0
        children: lmx_list_new_owned(c.LMX_TYPE_ARRAY_OF_POINTER_BASE + c.LMX_DOMAIN_THREAD, arena)
        if: children = 0 || lmx_arena_refs_open_owned(arena, graph, 1U) != 0 || lmx_arena_ref_store(graph, 0U, (cast: (@: void) children)) != 0
            return: 0
        ---
    ---
    mail: (cast: (@: LmxPost) lmx_arena_take(arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    thread: (cast: (@: LmxThread) lmx_arena_take(arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD))
    message: (cast: (@: LmxMsg) thread)
    slot: (cast: (@: LmxSchedule) lmx_arena_take(arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: message = 0 || mail = 0 || thread = 0 || slot = 0
        return: 0
    ---
    if: lmx_post_init(arena, mail) != c.LMX_POST_OK || lmx_thread_init(arena, thread, graph, mail, slot) != c.LMX_THREAD_OK || lmx_schedule_init(slot, arena, (cast: (@: void) thread), 1000U) != c.LMX_SCHEDULE_OK
        return: 0
    ---
    if: with_children != 0 && lmx_thread_children_bind(thread, children, arena) != c.LMX_THREAD_OK
        return: 0
    ---
    \out_message: message
return: thread

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxRoot: root
    LmxArena: donor_arena
    LmxArena: success_arena
    LmxArena: failed_arena
    LmxArena: blocked_arena
    LmxArena: copy_arena
    LmxArena: nested_arena
    LmxArena: nested_child_arena
    LmxArena: transfer_arena
    LmxArena: source_view
    LmxArena: scoped_view
    @: LmxThread donor
    @: LmxThread child
    @: LmxThread grandchild
    @: LmxMsg child_message
    @: LmxMsg grandchild_message
    @: LmxThread r0
    @: LmxOrphanLedger ledger
    @: Lmx retained_profile
    @: Lmx retained_branch
    @: Lmx retained_profile_two
    @: Lmx retained_branch_two
    @: Lmx retained_profile_three
    @: Lmx retained_branch_three
    @: Lmx retained_profile_four
    @: Lmx retained_branch_four
    @: Lmx retained_profile_five
    @: Lmx retained_branch_five
    @: Lmx scoped_parent
    @: Lmx scoped_profile
    @: Lmx scoped_branch
    @: Lmx target_profile_one
    @: Lmx target_profile_two
    @: Lmx target_profile_three
    @: Lmx target_profile_carrier
    @@: Lmx selected_sources
    @@: Lmx copied_roots
    @@: Lmx retained_sources
    @@: Lmx carrier_priors
    @: Lmx carrier_profile
    @: Lmx carrier_branch
    @: LmxPrimitive carrier_record
    @: Lmx copy_graph 0
    @: Lmx copy_local_profile 0
    @: Lmx copy_local_profile_branch 0
    LmxCopyMap: lost
    LmxCopyMap: selected_roots
    LmxCopyMap: retained_for_copy
    LmxCopyMap: reached_selected
    LmxCopyMap: reached_retained
    LmxCopyMap: target_profiles
    LmxCopyMap: relocation
    LmxCopyMap: pending_names
    LmxReparentEdges: edges
    LmxReparentEdges: scoped_edges
    @: LmxReparentEdges scoped_edges_at @ scoped_edges
    LmxCopyMap: scoped_selected
    LmxCopyMap: scoped_retained
    @: LmxReparentEdges edge_ptr @ edges
    @: LmxReparentEdge edge
    size_t: edge_i
    int: saw_edge
    int: failures
    if: counts = 0
        return: 2
    ---
    memset((cast: (@: void) (@ root)), 0, c.sizeof(c.LmxRoot))
    memset((cast: (@: void) (@ donor_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ success_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ failed_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ blocked_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ copy_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ nested_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ nested_child_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ transfer_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ source_view)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ scoped_view)), 0, c.sizeof(c.LmxArena))
    or_check(counts, lmx_root_open(@ root, 0, 5000U) = c.LMX_ROOT_OK, "root open")
    or_check(counts, lmx_root_retention_set(@ root, 500U) = c.LMX_ROOT_OK, "retention set")
    or_check(counts, lmx_arena_open(@ donor_arena) = 0 && lmx_arena_open(@ success_arena) = 0 && lmx_arena_open(@ failed_arena) = 0 && lmx_arena_open(@ blocked_arena) = 0 && lmx_arena_open(@ copy_arena) = 0 && lmx_arena_open(@ nested_arena) = 0 && lmx_arena_open(@ nested_child_arena) = 0 && lmx_arena_open(@ transfer_arena) = 0, "arenas open")
    donor: or_thread(@ donor_arena, 1, @ child_message)
    r0: lmx_root_thread(@ root)
    ledger: lmx_root_orphans(@ root)
    child: or_thread(@ success_arena, 0, @ child_message)
    or_check(counts, donor != 0 && child != 0 && lmx_thread_child_add(donor, child, @ donor_arena) = c.LMX_THREAD_OK, "donor child")
    or_check(counts, lmx_root_orphan_adopt(@ root, child_message, @ success_arena, child, 1000U) = c.LMX_ORPHAN_OK, "adopt success child")
    or_check(counts, lmx_thread_child_count(donor) = 0U && lmx_thread_child_count(r0) = 1U && lmx_thread_parent(child) = r0, "sole membership moved")
    or_check(counts, lmx_orphan_count(ledger) = 1U && lmx_manager_count(lmx_root_manager(@ root)) = 1U, "derived orphan count")
    child_message\success: 1
    child_message\running: 0
    child_message\handoff_ready: 1
    or_check(counts, lmx_root_orphan_maintain(@ root, 1001U) = c.LMX_ORPHAN_OK, "success maintain")
    or_check(counts, lmx_thread_child_count(r0) = 0U && lmx_orphan_count(ledger) = 0U && lmx_orphan_reclaimed(ledger) = 1U, "success reclaimed after removal")
    or_check(counts, lmx_thread_child_count(lmx_root_thread(@ root)) = 0U, "success child removed before release")

    child: or_thread(@ failed_arena, 0, @ child_message)
    or_check(counts, child != 0 && lmx_thread_child_add(donor, child, @ donor_arena) = c.LMX_THREAD_OK, "failed donor child")
    or_check(counts, lmx_root_orphan_adopt(@ root, child_message, @ failed_arena, child, 2000U) = c.LMX_ORPHAN_OK, "adopt failed child")
    child_message\running: 0
    child_message\handoff_ready: 1
    or_check(counts, lmx_root_orphan_maintain(@ root, 2200U) = c.LMX_ORPHAN_OK && lmx_orphan_count(ledger) = 1U, "failed retained inside window")
    or_check(counts, lmx_root_orphan_maintain(@ root, 2500U) = c.LMX_ORPHAN_OK && lmx_orphan_count(ledger) = 0U, "failed reclaimed at window")
    or_check(counts, lmx_thread_child_count(lmx_root_thread(@ root)) = 0U && lmx_orphan_reclaimed(ledger) = 2U, "failed child removed before release")
    # The donor owns a sealed independent branch which this child actually uses.
    # Moving the child to R0 would remove the donor from its Message ancestors.
    retained_profile: lmx_node_new_owned(@ donor_arena)
    retained_branch: lmx_node_new_profiled(@ donor_arena, retained_profile)
    or_check(counts, retained_profile != 0 && retained_branch != 0 && lmx_arena_seal_profile(@ donor_arena, retained_profile) = 0 && lmx_range_import_profile(@ blocked_arena, @ donor_arena, retained_profile) = 0, "retained profile available")
    or_check(counts, lmx_reparent_profile_root(@ donor_arena, retained_profile) = retained_branch, "qualified root recovered from local ranges")
    or_check(counts, lmx_reparent_profile_root(@ blocked_arena, retained_profile) = retained_branch, "qualified root recovered from imported ranges")
    child: or_thread(@ blocked_arena, 0, @ child_message)
    or_check(counts, child != 0 && lmx_reparent_preflight(child, r0) = c.LMX_REPARENT_OK, "unused imported profile does not forbid reparent")
    or_check(counts, child != 0 && lmx_arena_refs_open_owned(@ blocked_arena, child_message\graph, 1U) = 0 && lmx_arena_ref_store(child_message\graph, 0U, (cast: (@: void) retained_branch)) = 0, "child uses donor-owned branch")
    or_check(counts, lmx_range_import_profile(@ copy_arena, @ donor_arena, retained_profile) = 0 && lmx_graph_copy_profiled_owned(child_message\graph, @ blocked_arena, @ copy_arena, retained_profile, @ copy_graph) = c.LMX_GRAPH_COPY_OK && copy_graph != 0 && lmx_arena_ref_value(copy_graph, 0U) = (cast: (@: void) retained_branch), "ordinary copy retains imported branch without importing its unsealed profile marker")
    copy_local_profile: lmx_node_new_owned(@ copy_arena)
    copy_local_profile_branch: lmx_node_new_profiled(@ copy_arena, copy_local_profile)
    or_check(counts, copy_local_profile != 0 && copy_local_profile_branch != 0, "independent local profile branch allocated")
    or_check(counts, lmx_range_unimport_profile(@ copy_arena, retained_profile) = 0, "borrowed profile removed")
    or_check(counts, lmx_range_classify(@ copy_arena, (cast: (@: void) retained_branch)) = c.LMX_KIND_NONE, "borrowed branch no longer classified")
    or_check(counts, lmx_range_classify(@ donor_arena, (cast: (@: void) retained_branch)) = c.LMX_KIND_STRUCT, "unimport preserves owner")
    or_check(counts, lmx_range_classify(@ copy_arena, (cast: (@: void) copy_local_profile_branch)) = c.LMX_KIND_STRUCT && lmx_range_profile(@ copy_arena, (cast: (@: void) copy_local_profile_branch)) = copy_local_profile, "unimport preserves independent local branch")
    or_check(counts, lmx_arena_release(@ copy_arena) = 0, "temporary copy arena released")
    or_check(counts, lmx_thread_child_add(donor, child, @ donor_arena) = c.LMX_THREAD_OK, "donor retains child with its branch")
    or_check(counts, lmx_reparent_scan(child, r0, @ lost, @ edges) = c.LMX_REPARENT_OWNER && lmx_copy_map_get(@ lost, (cast: (@: void) retained_profile)) = (cast: (@: void) (@ donor_arena)), "selection identifies the used lost profile by address")
    saw_edge: 0
    edge_i: 0U
    while: edge_i < edge_ptr\n
        edge: edge_ptr\data + edge_i
        if: edge\slot = lmx_arena_ref_cell(child_message\graph, 0U) && edge\value = (cast: (@: void) retained_branch) && edge\source_profile = 0 && edge\view = (@ blocked_arena)
            saw_edge: 1
        ---
        edge_i: edge_i + 1U
    ---
    or_check(counts, saw_edge != 0, "same scan retains the mutable incoming slot for later redirection")
    lmx_reparent_edges_dispose(@ edges)
    lmx_copy_map_dispose(@ lost)
    or_check(counts, lmx_thread_adopt(child, r0) = c.LMX_THREAD_OWNER_REFUSED, "direct adoption refuses lost owner")
    or_check(counts, lmx_thread_parent(child) = donor && lmx_thread_child_count(donor) = 1U && lmx_thread_child_count(r0) = 0U, "direct refusal preserves old membership")
    or_check(counts, lmx_root_orphan_adopt(@ root, child_message, @ blocked_arena, child, 3000U) = c.LMX_ORPHAN_OWNER_REFUSED, "orphan adoption refuses lost owner before mutation")
    or_check(counts, lmx_thread_parent(child) = donor && lmx_thread_child_count(donor) = 1U && lmx_thread_child_count(r0) = 0U, "refused adoption preserves old membership")
    or_check(counts, lmx_thread_child_remove(donor, child) = c.LMX_THREAD_OK && lmx_arena_release(@ blocked_arena) = 0, "blocked child cleanup")

    # The moved Message itself uses no foreign profile; its descendant uses two.
    # The selection must inspect the descendant and retain both exact addresses.
    retained_profile_two: lmx_node_new_owned(@ donor_arena)
    retained_branch_two: lmx_node_new_profiled(@ donor_arena, retained_profile_two)
    or_check(counts, retained_profile_two != 0 && retained_branch_two != 0 && lmx_arena_seal_profile(@ donor_arena, retained_profile_two) = 0, "second retained profile available")
    child: or_thread(@ nested_arena, 1, @ child_message)
    grandchild: or_thread(@ nested_child_arena, 0, @ grandchild_message)
    or_check(counts, child != 0 && grandchild != 0 && lmx_range_import_profile(@ nested_child_arena, @ donor_arena, retained_profile) = 0 && lmx_range_import_profile(@ nested_child_arena, @ donor_arena, retained_profile_two) = 0, "descendant imports two donor profiles")
    retained_profile_four: lmx_node_new_owned(@ nested_arena)
    retained_branch_four: lmx_node_new_profiled(@ nested_arena, retained_profile_four)
    or_check(counts, retained_profile_four != 0 && retained_branch_four != 0 && lmx_arena_seal_profile(@ nested_arena, retained_profile_four) = 0 && lmx_range_import_profile(@ nested_child_arena, @ nested_arena, retained_profile_four) = 0, "moved Message owns retained profile used by descendant")
    carrier_profile: lmx_node_new_owned(@ nested_child_arena)
    carrier_branch: lmx_node_new_profiled(@ nested_child_arena, carrier_profile)
    retained_profile_three: lmx_node_new_owned(@ nested_child_arena)
    retained_branch_three: lmx_node_new_profiled(@ nested_child_arena, retained_profile_three)
    retained_profile_five: lmx_node_new_owned(@ nested_child_arena)
    retained_branch_five: lmx_node_new_profiled(@ nested_child_arena, retained_profile_five)
    or_check(counts, retained_profile_three != 0 && retained_branch_three != 0 && retained_profile_five != 0 && retained_branch_five != 0 && lmx_arena_seal_profile(@ nested_child_arena, retained_profile_three) = 0 && lmx_arena_seal_profile(@ nested_child_arena, retained_profile_five) = 0, "descendant has a carrier dependency and a separate visible branch")
    carrier_record: (cast: (@: LmxPrimitive) lmx_arena_take_profiled(@ nested_child_arena, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE, carrier_profile))
    carrier_record\fn: 0
    carrier_record\signature: retained_branch
    carrier_record\owner: (cast: (@: Lmx) (@ nested_child_arena))
    or_check(counts, carrier_profile != 0 && carrier_branch != 0 && carrier_record != 0 && carrier_branch\parent = 0 && lmx_arena_refs_open_profiled(@ nested_child_arena, carrier_branch, 3U, carrier_profile) = 0 && lmx_arena_ref_store(carrier_branch, 0U, (cast: (@: void) carrier_record)) = 0 && lmx_arena_ref_store(carrier_branch, 1U, (cast: (@: void) retained_branch_four)) = 0 && lmx_arena_ref_store(carrier_branch, 2U, (cast: (@: void) retained_branch_three)) = 0 && lmx_arena_seal_profile(@ nested_child_arena, carrier_profile) = 0, "independent carrier refers through a primitive signature to a lost donor profile")
    or_check(counts, lmx_arena_refs_open_owned(@ nested_child_arena, grandchild_message\graph, 5U) = 0 && lmx_arena_ref_store(grandchild_message\graph, 0U, (cast: (@: void) retained_branch)) = 0 && lmx_arena_ref_store(grandchild_message\graph, 1U, (cast: (@: void) retained_branch_two)) = 0 && lmx_arena_ref_store(grandchild_message\graph, 2U, (cast: (@: void) carrier_branch)) = 0 && lmx_arena_ref_store(grandchild_message\graph, 3U, (cast: (@: void) retained_branch_three)) = 0 && lmx_arena_ref_store(grandchild_message\graph, 4U, (cast: (@: void) retained_branch_five)) = 0, "descendant graph uses donor branches, carrier dependency, and unrelated visible branch")
    or_check(counts, lmx_reparent_profile_root(@ nested_child_arena, retained_profile_two) = retained_branch_two, "second qualified root recovered by physical profile")
    or_check(counts, lmx_thread_child_add(donor, child, @ donor_arena) = c.LMX_THREAD_OK && lmx_thread_child_add(child, grandchild, @ nested_arena) = c.LMX_THREAD_OK, "descendant remains under donor supervision")
    or_check(counts, lmx_reparent_scan(child, r0, @ lost, @ edges) = c.LMX_REPARENT_OWNER && lmx_copy_map_get(@ lost, (cast: (@: void) retained_profile)) = (cast: (@: void) (@ donor_arena)) && lmx_copy_map_get(@ lost, (cast: (@: void) retained_profile_two)) = (cast: (@: void) (@ donor_arena)) && lmx_copy_map_get(@ lost, (cast: (@: void) carrier_profile)) = 0, "lost selection includes donor profiles, not local immutable carrier")
    or_check(counts, lmx_reparent_expand_carriers(@ lost, @ edges) = c.LMX_REPARENT_OK && lmx_copy_map_get(@ lost, (cast: (@: void) carrier_profile)) = (cast: (@: void) (@ nested_child_arena)), "copy selection also includes immutable carrier whose reference cannot be changed")
    or_check(counts, lmx_reparent_expand_copy_set(child, r0, @ lost, @ edges) = c.LMX_REPARENT_OK && lmx_copy_map_get(@ lost, (cast: (@: void) retained_profile_three)) = (cast: (@: void) (@ nested_child_arena)) && lmx_copy_map_get(@ lost, (cast: (@: void) retained_profile_four)) = 0 && lmx_copy_map_get(@ lost, (cast: (@: void) retained_profile_five)) = 0, "copy selection adds stranded dependency but neither accessible nor unrelated branches")
    or_check(counts, lmx_reparent_selected_roots(@ lost, @ selected_roots) = c.LMX_REPARENT_OK && lmx_copy_map_get(@ selected_roots, (cast: (@: void) retained_profile)) = (cast: (@: void) retained_branch) && lmx_copy_map_get(@ selected_roots, (cast: (@: void) retained_profile_two)) = (cast: (@: void) retained_branch_two) && lmx_copy_map_get(@ selected_roots, (cast: (@: void) carrier_profile)) = (cast: (@: void) carrier_branch) && lmx_copy_map_get(@ selected_roots, (cast: (@: void) retained_profile_three)) = (cast: (@: void) retained_branch_three), "selected roots recovered from owner ranges without stored names")
    or_check(counts, lmx_reparent_source_view(@ lost, @ edges, @ source_view, @ retained_for_copy) = c.LMX_REPARENT_OK && lmx_copy_map_get(@ retained_for_copy, (cast: (@: void) retained_profile_four)) = (cast: (@: void) (@ nested_arena)) && lmx_copy_map_get(@ retained_for_copy, (cast: (@: void) retained_profile_five)) = 0 && lmx_copy_map_get(@ lost, (cast: (@: void) retained_profile_five)) = 0 && lmx_range_classify(@ source_view, (cast: (@: void) carrier_branch)) = c.LMX_KIND_STRUCT && lmx_range_classify(@ source_view, (cast: (@: void) retained_branch_two)) = c.LMX_KIND_STRUCT && lmx_range_classify(@ source_view, (cast: (@: void) retained_branch_three)) = c.LMX_KIND_STRUCT && lmx_range_classify(@ source_view, (cast: (@: void) retained_branch_four)) = c.LMX_KIND_STRUCT && lmx_range_classify(@ source_view, (cast: (@: void) retained_branch_five)) = c.LMX_KIND_STRUCT, "scratch source view classifies owner context while unrelated branch is neither selected nor retained")
    or_check(counts, lmx_copy_map_init(@ reached_selected) = 0 && lmx_copy_map_init(@ reached_retained) = 0, "scratch routing maps open")
    or_check(counts, lmx_reparent_route_missing_profile(child, r0, @ source_view, retained_profile_four, @ reached_selected, @ reached_retained) = c.LMX_REPARENT_OK && lmx_copy_map_get(@ reached_retained, (cast: (@: void) retained_profile_four)) = (cast: (@: void) (@ nested_arena)) && lmx_copy_map_get(@ reached_selected, (cast: (@: void) retained_profile_four)) = 0, "reached independent branch with visible owner keeps its address")
    or_check(counts, lmx_reparent_route_missing_profile(child, r0, @ source_view, retained_profile_five, @ reached_selected, @ reached_retained) = c.LMX_REPARENT_OK && lmx_copy_map_get(@ reached_selected, (cast: (@: void) retained_profile_five)) = (cast: (@: void) (@ nested_child_arena)) && lmx_copy_map_get(@ reached_retained, (cast: (@: void) retained_profile_five)) = 0, "reached branch with owner outside new ancestry is selected for copying")
    or_check(counts, lmx_reparent_route_missing_profile(child, r0, @ source_view, retained_profile_five, @ reached_selected, @ reached_retained) = c.LMX_REPARENT_INVALID, "same reached profile cannot loop without progress")
    lmx_copy_map_dispose(@ reached_selected)
    lmx_copy_map_dispose(@ reached_retained)
    selected_sources: (cast: (@@: Lmx) calloc(4U, c.sizeof(@: Lmx)))
    copied_roots: (cast: (@@: Lmx) calloc(4U, c.sizeof(@: Lmx)))
    retained_sources: (cast: (@@: Lmx) calloc(1U, c.sizeof(@: Lmx)))
    carrier_priors: (cast: (@@: Lmx) calloc(3U, c.sizeof(@: Lmx)))
    target_profile_one: lmx_node_new_owned(@ nested_arena)
    target_profile_two: lmx_node_new_owned(@ nested_arena)
    target_profile_three: lmx_node_new_owned(@ nested_arena)
    target_profile_carrier: lmx_node_new_owned(@ nested_arena)
    or_check(counts, selected_sources != 0 && copied_roots != 0 && retained_sources != 0 && carrier_priors != 0 && target_profile_one != 0 && target_profile_two != 0 && target_profile_three != 0 && target_profile_carrier != 0 && lmx_copy_map_init(@ target_profiles) = 0, "copy forest scratch and four destination profile identities allocated")
    selected_sources[0]: retained_branch
    selected_sources[1]: retained_branch_two
    selected_sources[2]: retained_branch_three
    selected_sources[3]: carrier_branch
    retained_sources[0]: retained_profile_four
    memset((cast: (@: void) (@ pending_names)), 0, c.sizeof(c.LmxCopyMap))
    or_check(counts, lmx_copy_map_put(@ target_profiles, (cast: (@: void) retained_profile), (cast: (@: void) target_profile_one)) = 0 && lmx_copy_map_put(@ target_profiles, (cast: (@: void) retained_profile_two), (cast: (@: void) target_profile_two)) = 0 && lmx_copy_map_put(@ target_profiles, (cast: (@: void) retained_profile_three), (cast: (@: void) target_profile_three)) = 0 && lmx_copy_map_put(@ target_profiles, (cast: (@: void) carrier_profile), (cast: (@: void) target_profile_carrier)) = 0, "four selected source profiles map to distinct destination profiles")
    or_check(counts, lmx_graph_copy_forest_remapped_staged(selected_sources, 4U, @ source_view, @ nested_arena, retained_sources, 1U, @ target_profiles, copied_roots, @ pending_names, @ relocation) = c.LMX_GRAPH_COPY_OK && copied_roots[0] != 0 && copied_roots[1] != 0 && copied_roots[2] != 0 && copied_roots[3] != 0, "selected forest copied in one address map")
    or_check(counts, lmx_range_profile(@ nested_arena, (cast: (@: void) copied_roots[0])) = target_profile_one && lmx_range_profile(@ nested_arena, (cast: (@: void) copied_roots[1])) = target_profile_two && lmx_range_profile(@ nested_arena, (cast: (@: void) copied_roots[2])) = target_profile_three && lmx_range_profile(@ nested_arena, (cast: (@: void) copied_roots[3])) = target_profile_carrier, "each copied branch has its own typed profile")
    or_check(counts, copied_roots[3] != 0 && copied_roots[3]\parent = 0 && lmx_range_classify(@ nested_arena, lmx_arena_ref_value(copied_roots[3], 0U)) = c.LMX_DOMAIN_KIND_PRIMITIVE && (cast: (@: LmxPrimitive) lmx_arena_ref_value(copied_roots[3], 0U))\signature = copied_roots[0] && (cast: (@: LmxPrimitive) lmx_arena_ref_value(copied_roots[3], 0U))\owner = (cast: (@: Lmx) (@ nested_arena)) && lmx_arena_ref_value(copied_roots[3], 1U) = (cast: (@: void) retained_branch_four) && lmx_arena_ref_value(copied_roots[3], 2U) = (cast: (@: void) copied_roots[2]), "copied independent carrier rewires primitive signature and retains visible dependency")
    or_check(counts, lmx_qualify_tree_preflight_full(@ nested_arena, copied_roots[0], 0, 0, 0U, 0, 0U, 0, 0U) = c.LMX_QUALIFY_OK && lmx_arena_seal_profile(@ nested_arena, target_profile_one) = 0 && lmx_qualify_tree_preflight_full(@ nested_arena, copied_roots[1], 0, 0, 0U, 0, 0U, 0, 0U) = c.LMX_QUALIFY_OK && lmx_arena_seal_profile(@ nested_arena, target_profile_two) = 0 && lmx_qualify_tree_preflight_full(@ nested_arena, copied_roots[2], 0, 0, 0U, 0, 0U, 0, 0U) = c.LMX_QUALIFY_OK && lmx_arena_seal_profile(@ nested_arena, target_profile_three) = 0, "independent selected copies qualify and seal separately")
    carrier_priors[0]: target_profile_one
    carrier_priors[1]: target_profile_three
    carrier_priors[2]: retained_profile_four
    or_check(counts, lmx_qualify_tree_preflight_full(@ nested_arena, copied_roots[3], 0, carrier_priors, 3U, 0, 0U, 0, 0U) = c.LMX_QUALIFY_OK && lmx_arena_seal_profile(@ nested_arena, target_profile_carrier) = 0, "carrier copy qualifies only after its selected and retained dependencies")
    lmx_copy_names_finish(@ pending_names, 0)
    lmx_graph_copy_map_dispose(@ relocation)
    lmx_copy_map_dispose(@ target_profiles)
    free((cast: (@: void) selected_sources))
    free((cast: (@: void) copied_roots))
    free((cast: (@: void) retained_sources))
    free((cast: (@: void) carrier_priors))
    or_check(counts, lmx_arena_release(@ source_view) = 0, "disposable source view released without touching its owners")

    # A selected independent carrier must COPY, not retain, an immutable
    # dependency with an ordinary lexical parent, even when that dependency's
    # owner remains in the Message ancestry after the move.
    scoped_parent: lmx_node_new_owned(@ nested_child_arena)
    scoped_profile: lmx_node_new_owned(@ nested_child_arena)
    scoped_branch: lmx_node_new_profiled(@ nested_child_arena, scoped_profile)
    if: scoped_branch != 0
        scoped_branch\parent: scoped_parent
    ---
    or_check(counts, scoped_parent != 0 && scoped_profile != 0 && scoped_branch != 0 && lmx_qualify_tree_preflight_full(@ nested_child_arena, scoped_branch, 0, 0, 0U, 0, 0U, 0, 0U) = c.LMX_QUALIFY_OK && lmx_arena_seal_profile(@ nested_child_arena, scoped_profile) = 0, "non-independent immutable dependency qualifies under a mutable parent")
    memset((cast: (@: void) (@ scoped_edges)), 0, c.sizeof(c.LmxReparentEdges))
    memset((cast: (@: void) (@ scoped_selected)), 0, c.sizeof(c.LmxCopyMap))
    memset((cast: (@: void) (@ scoped_retained)), 0, c.sizeof(c.LmxCopyMap))
    scoped_edges_at\data: (cast: (@: LmxReparentEdge) calloc(1U, c.sizeof(c.LmxReparentEdge)))
    scoped_edges_at\n: 1U
    scoped_edges_at\room: 1U
    if: scoped_edges_at\data != 0
        scoped_edges_at\data\value: (cast: (@: void) scoped_branch)
        scoped_edges_at\data\source_profile: carrier_profile
        scoped_edges_at\data\view: @ nested_child_arena
    ---
    or_check(counts, scoped_edges_at\data != 0 && lmx_copy_map_init(@ scoped_selected) = 0 && lmx_copy_map_put(@ scoped_selected, (cast: (@: void) carrier_profile), (cast: (@: void) (@ nested_child_arena))) = 0, "selected carrier and immutable dependency edge staged")
    or_check(counts, lmx_reparent_expand_copy_set(child, r0, @ scoped_selected, @ scoped_edges) = c.LMX_REPARENT_OK && lmx_copy_map_get(@ scoped_selected, (cast: (@: void) scoped_profile)) = (cast: (@: void) (@ nested_child_arena)), "non-independent immutable dependency is selected for copy despite visible owner")
    or_check(counts, lmx_reparent_source_view(@ scoped_selected, @ scoped_edges, @ scoped_view, @ scoped_retained) = c.LMX_REPARENT_OK && lmx_copy_map_get(@ scoped_retained, (cast: (@: void) scoped_profile)) = 0 && lmx_range_classify(@ scoped_view, (cast: (@: void) scoped_parent)) = c.LMX_KIND_STRUCT && lmx_range_home(@ scoped_view, (cast: (@: void) scoped_parent)) = (@ nested_child_arena), "source view includes mutable lexical parent but never retains non-independent dependency")
    or_check(counts, lmx_arena_release(@ scoped_view) = 0, "scoped read-only copy view released")
    lmx_copy_map_dispose(@ scoped_retained)
    lmx_copy_map_dispose(@ scoped_selected)
    lmx_reparent_edges_dispose(@ scoped_edges)
    lmx_copy_map_dispose(@ retained_for_copy)
    lmx_copy_map_dispose(@ selected_roots)
    lmx_reparent_edges_dispose(@ edges)
    lmx_copy_map_dispose(@ lost)
    or_check(counts, lmx_thread_adopt(child, r0) = c.LMX_THREAD_OWNER_REFUSED && lmx_thread_parent(grandchild) = child && lmx_thread_parent(child) = donor && lmx_thread_child_count(donor) = 1U, "descendant dependency refuses transfer without mutation")
    or_check(counts, lmx_thread_child_remove(child, grandchild) = c.LMX_THREAD_OK && lmx_arena_release(@ nested_child_arena) = 0 && lmx_thread_child_remove(donor, child) = c.LMX_THREAD_OK && lmx_arena_release(@ nested_arena) = 0, "nested child cleanup")

    child: or_thread(@ transfer_arena, 0, @ child_message)
    or_check(counts, child != 0 && lmx_thread_child_add(donor, child, @ donor_arena) = c.LMX_THREAD_OK, "transfer child under donor")
    or_check(counts, lmx_thread_adopt(child, r0) = c.LMX_THREAD_OK, "direct adoption transfers independent child")
    or_check(counts, lmx_thread_parent(child) = r0 && lmx_thread_child_count(donor) = 0U && lmx_thread_child_count(r0) = 1U && lmx_thread_child_at(r0, 0U) = child, "direct adoption publishes one membership")
    or_check(counts, lmx_thread_child_remove(r0, child) = c.LMX_THREAD_OK && lmx_arena_release(@ transfer_arena) = 0, "transferred child cleanup")
    or_check(counts, lmx_arena_release(@ donor_arena) = 0, "donor release")
    or_check(counts, lmx_root_close(@ root) = c.LMX_ROOT_OK, "root close")
    failures: counts[1]
    c.printf("lmx_orphan: %d checks, %d failures\n", counts[0], failures)
    free(counts)
return: failures
