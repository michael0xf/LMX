# Ordinary generated L2 machine helper, after the existing compiler ABI
# declarations it calls. The remaining compiler/interner is still port debt.
predef: "l2src/l2_machine_types.lm1"

# A numeric field of a named Structure -- size_t, int, unsigned or ulong (l2_nsf_kind 0/7/8/9) --
# gets its own cell holding its literal, the same way for every width: an owned cell, or on an
# eternal branch a cell from the branch profile.  D-15 registered kinds 7/8/9 but built no cell, so
# the field's slot stayed empty and its literal was lost.  Any other kind emits nothing here.
fn: l2_emit_ns_num_cell (int: k; int: oi; int: fx) int
    const: @(char newf) 0
    const: @(char store) 0
    []: char lit 48
    lit[0]: '\0'
    if: l2_nsf_kind[fx] = 0
        newf: "lmx_size_new_profiled"
        store: "lmx_size_store_known"
        if: c.sprintf(lit, "%zuU", l2_nsf_val[fx]) < 0
            return: 1
        ---
    if: l2_nsf_kind[fx] = 7
        newf: "lmx_int_new_profiled"
        store: "lmx_int_store_known"
        if: c.sprintf(lit, "%d", (cast: (int) l2_nsf_val[fx])) < 0
            return: 1
        ---
    if: l2_nsf_kind[fx] = 8
        newf: "lmx_unsigned_new_profiled"
        store: "lmx_unsigned_store_known"
        if: c.sprintf(lit, "%uU", (cast: (unsigned) l2_nsf_val[fx])) < 0
            return: 1
        ---
    if: l2_nsf_kind[fx] = 9
        newf: "lmx_ulong_new_profiled"
        store: "lmx_ulong_store_known"
        # c.sizeof passes its operand to C as written: C has no `ulong`, and the two words
        # of `unsigned long` are two operands once P0 parses `c.sizeof(...)` as a Frame.
        # A ulong local (declared with the profile locals) names the size in one word.
        if: c.sprintf(lit, "%zuU", l2_nsf_val[fx]) < 0
            return: 1
        ---
    if: newf = 0
        return: 0
    # R6-2 (3): a field declared without a value gets its cell and no store (l2_nsf_bare).
    if: l2_nsf_bare[fx] != 0
        return: (cast: (int) (c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: %s(l2_program_arena, lmx_range_profile(l2_program_arena, (cast: (@: void) l2_entry_slot)))\n        if: l2_entry_slot[0] = 0\n            return: 1\n", k, (cast: (unsigned) oi), newf) < 0))
    if: c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: %s(l2_program_arena, lmx_range_profile(l2_program_arena, (cast: (@: void) l2_entry_slot)))\n        if: l2_entry_slot[0] = 0\n            return: 1\n        if: %s(l2_entry_slot[0], %s) != 0\n            return: 1\n", k, (cast: (unsigned) oi), newf, store, lit) < 0
        return: 1
return: 0

# Rank of a unit-level declaration among unit-level declarations: nested
# entries interleave in the table but are not unit children.
fn: l2_ns_rank (int: ni) int
    int: i 0
    int: r 0
    while: i < ni
        if: l2_ns_parent[i] < 0 && l2_ns_eternal[i] < 0 && l2_ns_local[i] < 0 && l2_ns_merge_body(i) < 0
            r: r + 1
        i: i + 1
    ---
return: r

fn: l2_ns_top_count () int
    int: i 0
    int: r 0
    while: i < l2_ns_n
        if: l2_ns_parent[i] < 0 && l2_ns_eternal[i] < 0 && l2_ns_local[i] < 0 && l2_ns_merge_body(i) < 0
            r: r + 1
        i: i + 1
    ---
return: r

# Field index of a nested entry inside its parent, found by the field that
# refers to it; -1 for a unit-level entry.
fn: l2_ns_field_in_parent (int: ni) int
    int: par
    int: k 0
    int: slotix 0
    par: l2_ns_parent[ni]
    if: par < 0
        return: 0 - 1
    # Fields of one Structure are not contiguous: a nested body pushes its own
    # fields in between. Walk the whole table and count only this owner.
    slotix: 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = par
            if: l2_nsf_kind[k] = 2 && l2_nsf_ref[k] = ni
                return: l2_nsf_slot(k)
            ---
            slotix: slotix + 1
        ---
        k: k + 1
    ---
return: 0 - 1




# A diagnostic kept for later (the quiet record, l2_m_why): a copy of its whole length -- plain malloc,
# outside l2_xmalloc's counted allocations (a kept reason is not the translation's storage); 0 when there
# is no room, and the reason is then not said.



# Whether node x is n or stands in n's tree: a frame's body and trailer, a Structure's fields and trailer.


# Cached head topology belongs to its source statement, including heads parsed
# from another cached body. This compiler provenance does not alter the AST.
fn: l2_head_source_node (const: @(LmP0Node node)) const: @: LmP0Node
    @: L2HeadExpression expression
    int: found 1
    while: node != 0 && found != 0
        found: 0
        expression: l2_head_expressions
        while: expression != 0 && found = 0
            if: lm_compiler_node_in(lm_p0_document_root(expression\document), node) != 0
                node: expression\source
                found: 1
            expression: expression\allocated_next
        ---
    ---
return: node

# The file a node is said in: a node read from a program part is said in that part (section 10), whichever pass says
# it; else the path handed in (the source's).  Shared by l2_error and the generated builder's construction diagnostic
# (l2_emit_unit, the static branches' preflight).
fn: l2_node_file (const: @(char path); const: @(LmP0Node node)) const: @: char
    int: k 0
    const: @(LmP0Node owner) l2_head_source_node(node)
    while: owner != 0 && l2_part_doc != 0 && k < l2_part_n
        if: l2_part_doc[k] != 0 && lm_compiler_node_in(lm_p0_document_root(l2_part_doc[k]), owner) != 0
            path: l2_part_path[k]
        k: k + 1
    ---
    if: path = 0
        path: ""
return: path

fn: l2_error (const: @(char path); const: @(LmP0Node node); const: @(char msg)) int
    size_t: line 1U
    size_t: column 1U
    # Failure to construct a query/result is not evidence that its field or
    # type is missing. The first allocation failure owns the diagnostic,
    # including in a speculative walker query; do not allocate a quiet copy
    # or let later semantic fallbacks rename the fatal error.
    if: l2_alloc_err != 0
        if: l2_diag_n != 0
            return: 1
        msg: "out of memory"
        if: l2_alloc_err = 2
            msg: "size overflow"
        ---
    # A method's body tried for the walk (l2_rw_quiet, -193 T4a) is refused silently: it only gets
    # no frames.  The first such refusal is kept for a note (l2_rw_methods_count).
    if: l2_rw_quiet != 0 && l2_alloc_err = 0 && l2_rw_quiet_msg = 0
        l2_rw_quiet_msg: lm_compiler_msg_copy(msg)
        if: node != 0 && node\span != 0
            l2_rw_quiet_line: node\span\line
            l2_rw_quiet_col: node\span\column
        ---
    ---
    if: l2_rw_quiet != 0 && l2_alloc_err = 0
        return: 1
    # A node read from a program part is said in that part (§10): the file of a diagnostic is the file its node
    # was read from, whichever pass says it -- one handed the source's path included (l2_node_file).
    path: l2_node_file(path, node)
    if: node != 0 && node\span != 0
        line: node\span\line
        column: node\span\column
    c.fprintf(l1_stderr(), "l2trans error: %s:%zu:%zu: %s\n", path, line, column, msg)
    l2_diag_n: l2_diag_n + 1
    if: node != 0 && node\kind = c.LM_P0_NODE_ATOM && node\as != 0 && node\as\atom != 0
        c.fprintf(l1_stderr(), "l2trans detail: atom=%.*s\n", (cast: (int) node\as\atom\length), node\as\atom\data)
    if: node != 0 && node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\head != 0
        c.fprintf(l1_stderr(), "l2trans detail: frame=%.*s\n", (cast: (int) node\as\frame\head\length), node\as\frame\head\data)
return: 1

# An unavailable compiler result/inventory is not an optional backend's
# unsupported expression. Keep the existing diagnostic accumulator, but do
# not let a speculative quiet walk suppress this explicitly fatal class.
# No message spelling, shape heuristic or new global failure flag is used.
fn: l2_error_fatal (const: @(char path); const: @(LmP0Node node); const: @(char msg)) int
    int: previous l2_rw_quiet
    int: answer
    l2_rw_quiet: 0
    answer: l2_error(path, node, msg)
    l2_rw_quiet: previous
return: answer

fn: l2_alloc_or (const: @(char path); const: @(LmP0Node at); const: @(char fallback)) int
    if: l2_alloc_err = 2
        return: l2_error(path, at, "size overflow")
    if: l2_alloc_err != 0
        return: l2_error(path, at, "out of memory")
return: l2_error(path, at, fallback)

# A failed allocation poisons this translation, not merely the optional
# query that encountered it. Check at phase boundaries and before publishing
# the output transaction. Never turn an unavailable record into permission.
fn: l2_translation_failed (const: @(char path); const: @(LmP0Node at)) int
    if: l2_alloc_err != 0 && l2_diag_n = 0
        return: l2_alloc_or(path, at, "translation failed")
    if: l2_alloc_err != 0 || l2_diag_n != 0
        return: 1
return: 0

# A use of a conversion table, or of a converter source, that cannot be read: the file's own diagnostic,
# when its reading gave one (l2_cv_said), is the one line; else it is said here, where it was needed.
fn: l2_cv_refused (const: @(char path); const: @(LmP0Node at); const: @(char msg)) int
    if: l2_cv_said != 0
        return: 1
return: l2_error(path, at, msg)


# A refusal after a pass that may already have said why: nothing more when a diagnostic came since d0
# (l2_diag_n), else l2_alloc_or's words.
fn: l2_said_or (const: @(char path); const: @(LmP0Node at); int: d0; const: @(char fallback)) int
    if: l2_diag_n != d0
        return: 1
return: l2_alloc_or(path, at, fallback)




