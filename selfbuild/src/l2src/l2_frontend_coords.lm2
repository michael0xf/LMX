fn: lm_compiler_ns_field_needs (const: (@: path char); const: (@: source_node c.LmP0Node); const: (@: h c.LmP0Text)) int
    if: c.lm_compiler_text_eq(h, "fn")
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "a callable field needs a method name")))
    if: c.lm_compiler_text_eq(h, "[]")
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "an array field needs a type, a name and a count")))
    if: c.lm_compiler_text_eq(h, "()")
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "a nested Structure needs a name and a body")))
    return: (cast: (int) (c.lm_compiler_error(path, source_node, "a named Structure field needs a name")))
end: lm_compiler_ns_field_needs

fn: lm_compiler_method_source_unit (int: mi) const: @: c.LmP0Structure
    const: (@@: cur_unit_cell c.LmP0Structure (cast: (const: @@: c.LmP0Structure) (@ c.l2_cur_unit)))
    @: part_loaded_cell int (cast: (@: int) (@ c.l2_part_loaded))
    @@@: part_doc_cell c.LmP0Document (cast: (@@@: c.LmP0Document) (@ c.l2_part_doc))
    const: (@: root c.LmP0Node)
    int: part c.lm_compiler_m_part(mi)
    if: part >= 0 && part < part_loaded_cell[0]
        root: c.lm_p0_document_root((cast: (const: @: c.LmP0Document) part_doc_cell[0][part]))
        if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0
            return: (cast: (const: @: c.LmP0Structure) root\as\structure)
        return: 0
    return: cur_unit_cell[0]
end: lm_compiler_method_source_unit

fn: lm_compiler_method_in_os (int: mi) int
    @: m_n_cell int (cast: (@: int) (@ c.l2_m_n))
    @@@: m_node_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_m_node))
    const: (@: unit c.LmP0Structure)
    const: (@: branch c.LmP0Node)
    @: field c.LmP0Field
    @: method c.LmP0Field
    if: mi < 0 || mi >= m_n_cell[0]
        return: (cast: (int) (0))
    unit: lm_compiler_method_source_unit(mi)
    if: unit = 0
        return: (cast: (int) (0))
    field: c.lm_compiler_next_active((cast: (@: c.LmP0Field) unit\first_field))
    while: field != 0
        if: c.lm_compiler_frame_head((cast: (const: @: c.LmP0Node) field\value), "os") != 0
            branch: c.lm_compiler_os_selected_branch((cast: (const: @: c.LmP0Node) field\value))
            if: branch != 0
                method: c.lm_compiler_next_active((cast: (@: c.LmP0Field) branch\as\frame\body\first_field))
                while: method != 0
                    if: method\value = m_node_cell[0][mi]
                        return: (cast: (int) (1))
                    method: c.lm_compiler_next_active(method\next)
                ---
            ---
        ---
        field: c.lm_compiler_next_active((cast: (@: c.LmP0Field) field\next))
    ---
    return: (cast: (int) (0))
end: lm_compiler_method_in_os

fn: lm_compiler_own_copy_layout (int: own) int
    @@: mres_source_cell c.L2ReferenceSource (cast: (@@: c.L2ReferenceSource) (@ c.l2_mres_source))
    @: ns_n_cell int (cast: (@: int) (@ c.l2_ns_n))
    @@: ns_eternal_cell int (cast: (@@: int) (@ c.l2_ns_eternal))
    int: result c.lm_compiler_mres_of_own(own)
    @: source c.L2ReferenceSource
    if: result < 0 || mres_source_cell[0] = 0
        return: (cast: (int) (-1))
    source: @ mres_source_cell[0][result]
    if: source\layout < 0 || source\layout >= ns_n_cell[0] || ns_eternal_cell[0][source\layout] >= 0
        return: (cast: (int) (-1))
    return: (cast: (int) (source\layout))
end: lm_compiler_own_copy_layout

fn: lm_compiler_own_capture_ns (int: own) int
    int: ns
    if: own < 0
        return: (cast: (int) (-1))
    ns: c.lm_compiler_own_nsty_get(own)
    if: ns < 0
        ns: lm_compiler_own_copy_layout(own)
    return: (cast: (int) (ns))
end: lm_compiler_own_capture_ns

fn: lm_compiler_own_capture_schema (int: own) int
    int: ns lm_compiler_own_capture_ns(own)
    if: ns >= 0
        return: (cast: (int) (ns))
    if: own >= 0 && lm_compiler_own_res(own) >= 0
        return: (cast: (int) (lm_compiler_own_schema(own)))
    return: (cast: (int) (-1))
end: lm_compiler_own_capture_schema

fn: lm_compiler_own_copy_chain (int: own) int
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    @: mres_n_cell int (cast: (@: int) (@ c.l2_mres_n))
    @@: mres_from_cell int (cast: (@@: int) (@ c.l2_mres_from))
    int: hops 0
    int: result
    int: layout
    int: mi
    if: own < 0 || own >= own_n_cell[0]
        return: (cast: (int) (-1))
    mi: own_mi_cell[0][own]
    while: own >= 0 && own < own_n_cell[0] && hops <= mres_n_cell[0]
        if: own_mi_cell[0][own] != mi
            return: (cast: (int) (-1))
        result: c.lm_compiler_mres_of_own(own)
        if: result < 0
            return: (cast: (int) (c.lm_compiler_own_layout(own)))
        layout: lm_compiler_own_copy_layout(own)
        if: layout >= 0
            return: (cast: (int) (layout))
        if: mres_from_cell[0] = 0
            return: (cast: (int) (-1))
        own: mres_from_cell[0][result]
        hops: hops + 1
    ---
    return: (cast: (int) (-1))
end: lm_compiler_own_copy_chain

fn: lm_compiler_own_source_layout (int: own) int
    int: model c.lm_compiler_own_layout(own)
    int: result c.lm_compiler_mres_of_own(own)
    if: result >= 0
        return: (cast: (int) (c.lm_compiler_schema_merge(result)))
    return: (cast: (int) (model))
end: lm_compiler_own_source_layout

fn: lm_compiler_reference_input_source (int: mi; int: input; @: out c.L2ReferenceSource) int
    @: m_n_cell int (cast: (@: int) (@ c.l2_m_n))
    @@: m_arity_cell int (cast: (@@: int) (@ c.l2_m_arity))
    @@: m_dyn_cell int (cast: (@@: int) (@ c.l2_m_dyn))
    if: mi < 0 || mi >= m_n_cell[0] || input < 0 || input >= m_arity_cell[0][mi] + m_dyn_cell[0][mi] || out = 0
        return: (cast: (int) (1))
    out\schema: lm_compiler_input_schema(mi, input)
    out\path: 0
    out\layout: -1
    out\method: mi
    out\place: input
    out\origin: 0
    out\origin_count: 0
    out\origin_method: -1
    return: (cast: (int) (0))
end: lm_compiler_reference_input_source

fn: lm_compiler_ns_num_fields (int: ni) int
    @: ns_n_cell int (cast: (@: int) (@ c.l2_ns_n))
    @: nsf_n_cell int (cast: (@: int) (@ c.l2_nsf_n))
    @@: nsf_owner_cell int (cast: (@@: int) (@ c.l2_nsf_owner))
    @@: nsf_kind_cell int (cast: (@@: int) (@ c.l2_nsf_kind))
    @@: nsf_ref_cell int (cast: (@@: int) (@ c.l2_nsf_ref))
    int: fx 0
    int: n 0
    if: ni < 0 || ni >= ns_n_cell[0]
        return: (cast: (int) (0))
    while: fx < nsf_n_cell[0]
        if: nsf_owner_cell[0][fx] = ni && nsf_kind_cell[0][fx] = 2 && lm_compiler_ns_num_fields(nsf_ref_cell[0][fx]) = 0
            return: (cast: (int) (0))
        if: nsf_owner_cell[0][fx] = ni && nsf_kind_cell[0][fx] != 0 && nsf_kind_cell[0][fx] != 1 && nsf_kind_cell[0][fx] != 2 && nsf_kind_cell[0][fx] != 3 && nsf_kind_cell[0][fx] != 4 && nsf_kind_cell[0][fx] != 5 && nsf_kind_cell[0][fx] != 6 && nsf_kind_cell[0][fx] != 7 && nsf_kind_cell[0][fx] != 8 && nsf_kind_cell[0][fx] != 9 && nsf_kind_cell[0][fx] != 10 && nsf_kind_cell[0][fx] != 11
            return: (cast: (int) (0))
        if: nsf_owner_cell[0][fx] = ni
            n: n + 1
        fx: fx + 1
    ---
    if: n < 1
        return: (cast: (int) (0))
    return: (cast: (int) (1))
end: lm_compiler_ns_num_fields

fn: lm_compiler_own_slot_at (int: k; @: dest char) int
    @: cur_mi_cell int (cast: (@: int) (@ c.l2_cur_mi))
    const: (@@: src_cell char (cast: (const: @@: char) (@ c.l2_src)))
    @@@: own_decl_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_own_decl))
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    @: field c.L2GraphField lm_compiler_graph_field(k)
    # A slot selected as a place of explicit data is addressed by its admitted
    # place row, just like a number or pointer cell. It must not reuse the
    # source code's positional child index.
    if: lm_compiler_split_data_row(k) != 0
        if: lm_compiler_m_is_place(cur_mi_cell[0]) = 0 || c.sprintf(dest, "self, l2_cpl[%dU]", lm_compiler_split_name_ix(k)) < 0
            return: (cast: (int) (c.lm_compiler_error(src_cell[0], own_decl_cell[0][k], "internal: a place of the data has no place row")))
        return: (cast: (int) (0))
    if: field = 0 || dest = 0
        return: (cast: (int) (1))
    if: field\holder = 0 && own_mi_cell[0][k] = cur_mi_cell[0] && c.lm_compiler_m_is_split(cur_mi_cell[0]) != 0
        return: (cast: (int) ((cast: (int) (c.sprintf(dest, "l2_call_code, lmx_implements_exec_index(l2_call_arena, l2_call_code, %zuU)", field\child) < 0))))
    if: field\holder != 0
        return: (cast: (int) ((cast: (int) (c.sprintf(dest, "l2_gp%zu, %zuU", field\holder\id, field\child) < 0))))
    if: own_mi_cell[0][k] = cur_mi_cell[0]
        return: (cast: (int) ((cast: (int) (c.sprintf(dest, "self, lmx_implements_code_index(l2_call_arena, self, l2_call_code, %zuU)", field\child) < 0))))
    ---
    return: (cast: (int) ((cast: (int) (c.sprintf(dest, "%s, %zuU", lm_compiler_own_ctr(k), field\child) < 0))))
end: lm_compiler_own_slot_at

fn: lm_compiler_own_after_factory_return (int: mi; int: k) int
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@@: m_body_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_m_body))
    @@@: own_decl_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_own_decl))
    @: body c.LmP0Structure
    @: field c.LmP0Field
    int: past 0
    if: mi < 0 || k < 0 || k >= own_n_cell[0] || c.lm_compiler_mad_on(mi) = 0 || m_body_cell[0][mi] = 0 || m_body_cell[0][mi]\as = 0
        return: (cast: (int) (0))
    body: m_body_cell[0][mi]\as\structure
    if: body = 0
        return: (cast: (int) (0))
    field: c.lm_compiler_next_active(body\first_field)
    while: field != 0
        if: past != 0 && field\value = own_decl_cell[0][k]
            return: (cast: (int) (1))
        if: lm_compiler_mad_return_point(body, mi, field) != 0
            past: 1
        field: c.lm_compiler_next_active(field\next)
    ---
    return: (cast: (int) (0))
end: lm_compiler_own_after_factory_return

fn: lm_compiler_own_used (int: mi; int: k) int
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@: m_uses_cell int (cast: (@@: int) (@ c.l2_m_uses))
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    int: j 0
    int: r
    if: mi < 0 || k < 0 || k >= own_n_cell[0] || m_uses_cell[0] = 0
        return: (cast: (int) (0))
    # The factory return boundary also ends the physical source producer.
    # Do not preload a cell for an own declaration that source construction
    # deliberately omitted from its dead tail.
    if: lm_compiler_own_after_factory_return(mi, k) != 0
        return: (cast: (int) (0))
    if: own_mi_cell[0][k] != mi || lm_compiler_split_data_row(k) = 0
        return: (cast: (int) (m_uses_cell[0][lm_compiler_own_off(mi, k)]))
    r: lm_compiler_split_rep(k)
    if: r != k
        return: (cast: (int) (0))
    while: j < own_n_cell[0]
        if: own_mi_cell[0][j] = mi && lm_compiler_split_data_row(j) != 0 && lm_compiler_split_rep(j) = r && m_uses_cell[0][lm_compiler_own_off(mi, j)] != 0
            return: (cast: (int) (1))
        j: j + 1
    ---
    return: (cast: (int) (0))
end: lm_compiler_own_used

fn: lm_compiler_own_cached (int: mi; int: k) int
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    @@: m_uses_cell int (cast: (@@: int) (@ c.l2_m_uses))
    @@: own_ty_cell int (cast: (@@: int) (@ c.l2_own_ty))
    @@@: own_host_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_own_host))
    if: mi < 0 || k < 0 || k >= own_n_cell[0] || own_mi_cell[0][k] != mi || m_uses_cell[0] = 0
        return: (cast: (int) (0))
    # A machine function's field is its activation's machine local (l2_emit_machine_method), whatever reads it.
    if: lm_compiler_m_machine(mi) != 0
        return: (cast: (int) ((cast: (int) (c.lm_compiler_own_direct(mi, k) != 0 && c.lm_compiler_own_is_array(own_ty_cell[0][k]) = 0))))
    # A unit constructor or full method already owns its original child;
    # registering its source binding does not add a working receiving cell.
    # Other fields retain the existing same-activation OWN/cache route.
    # Original identity alone does not change their physical operand form.
    if: c.lm_compiler_source_definition_unit_ns(k) >= 0 || c.lm_compiler_source_definition_method(k) >= 0
        return: (cast: (int) (0))
    if: lm_compiler_own_used(mi, k) = 0 || c.lm_compiler_own_is_array(own_ty_cell[0][k]) != 0 || c.lm_compiler_own_direct(mi, k) = 0
        return: (cast: (int) (0))
    # A catch parameter is written by the delivery into its cell -- the walker's pad binding, the native handler -- so
