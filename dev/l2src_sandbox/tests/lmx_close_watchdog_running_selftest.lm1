predef: "l2src/lmx_root.lm1"
predef: "l2src/lmx_settle.lm1"
predef: "l2src/lmx_service.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_manager.lm1"
predef: "l2src/lmx_manager_running.h.lm1"
predef: "l2src/lmx_manager_running.lm1"
predef: "l2src/lmx_process_deadline.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_gc.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_call.lm1"
predef: "l2src/lmx_clock.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# WATCHDOG PROOF, RUNNING MANAGER: A CHILD BODY THAT NEVER RETURNS ON ITS OWN LANE
# (DEEPSEEK-MAIL-CASCADE-FIX-20260921-82; author's ruling via Codex, 2026-09-21).
#
# WHY THIS PROCESS EXISTS, and it is expected to ABORT: the same three-level shape as the stepped
# probe, with ONE difference that makes it the other binding's path -- A'S OWN MANAGER IS REBOUND TO
# THE RUNNING IMPLEMENTATION, so B gets a REAL LANE (lmx_manager_running_lane_start) and B's body
# loops forever ON THAT LANE.  The closer's stack is therefore free and its passes DO run; what
# never arrives is a boundary for B, because a record whose body never returns never publishes one.
# Both bounds are live here and either may fire: the cooperative check inside the passes, and the
# watchdog from lmx_process_deadline.  The process must die at the ONE deadline, not later.
#
# WHAT THE HARNESS MUST SEE (the assertions live in the runner, not in this file):
#   * a close-deadline diagnostic on stderr -- EITHER the cooperative one ("...with children still
#     live at one level...") or the watchdog's ("...with the close still running..."): this file
#     asserts the family, and the stepped probe asserts the exact member;
#   * exit by ABORT (3 on this platform), well inside the harness's timeout;
#   * and NOT the line this file prints if the close ever returns.
#
# THE BOUND IS READ, NOT COMPILED IN: `lmx_root_close_limit_set` arms 400 ms here through the same
# path a production close takes with its 60 s default.  There is no test-only branch.

@: LmxRoot t6_root 0
@: LmxArena t6_arena_a 0
@: LmxArena t6_arena_b 0
@: LmxArena t6_harness 0
@: LmxPost t6_mail_a 0
@: LmxPost t6_mail_b 0
@: LmxThread t6_t_a 0
@: LmxSchedule t6_sched_b 0
@: Lmx t6_source_a 0
size_t: t6_phase 0U
size_t: t6_a_turns 0U
size_t: t6_diag 0U
int: t6_run 1
size_t: t6_b_spins 0U

# B: A BODY THAT NEVER RETURNS.  It yields the CPU (Sleep) so the rest of the process keeps running
# -- the point is not a busy machine, it is a stack that cannot come back.
fn: t6_body_b (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    t6_b_spins: t6_b_spins + 1U
    while: t6_run = 1
        c.Sleep(1U)
    ---
return: 0

# A: build B under itself, give B's slot to A's OWN queue, and stay live.  A's body returns, which is
# what makes the difference visible: it is B's BODY, not A's, that never comes back.
fn: t6_body_a (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    @: LmxThread t
    @: LmxMsg message
    @: Lmx graph_a
    @: Lmx source_b
    @: LmxMsg child_b
    @: LmxThread t_b
    @: LmxPost mail_b
    @: LmxSchedule sched_b
    @: LmxMethod method
    @: LmxCallable info_b
    @: LmxPool methods
    t: lmx_thread_current()
    message: lmx_thread_message(t)
    if: message = 0 || message\graph = 0
        t6_diag: 1U
        return: 0
    ---
    if: t6_phase != 1U
        return: 0
    ---
    # B IS BUILT ON A'S SECOND TURN ON PURPOSE: the probe rebinds A's manager to the RUNNING
    # implementation between the two cycles.  The manager has no membership queue of its own and
    # must discover B through A's sole graph Array after the rebinding.  This catches a running
    # manager that snapshots or maintains a parallel registry instead of traversing the live Array.
    t6_a_turns: t6_a_turns + 1U
    if: t6_a_turns < 2U
        return: 0
    ---
    if: t6_arena_a = 0 || t6_arena_b = 0 || t6_mail_b = 0
        t6_diag: 2U
        return: 0
    ---
    graph_a: message\graph
    source_b: lmx_node_new_owned(t6_arena_a)
    if: source_b = 0 || lmx_arena_refs_open_owned(t6_arena_a, source_b, 3U) != 0 || lmx_thread_children_field_new(t6_arena_a, source_b, 2U) = 0
        t6_diag: 3U
        return: 0
    ---
    child_b: lmx_child_reserve(t, t6_arena_a, t6_arena_b, lmx_arena_ref_cell(graph_a, 1U), source_b)
    if: child_b = 0
        t6_diag: 4U
        return: 0
    ---
    methods: lmx_pool_make(t6_arena_b, 2U * c.sizeof(c.LmxMethod), c.sizeof(c.LmxMethod),
                           c.LMX_KIND_METHOD, c.LMX_TYPE_METHOD)
    if: methods = 0
        t6_diag: 5U
        return: 0
    ---
    method: lmx_method_intern(t6_arena_b, methods, (cast: (LmxEntry) t6_body_b), 1U)
    if: method = 0 || child_b\graph = 0
        t6_diag: 6U
        return: 0
    ---
    info_b: lmx_callable_new_owned(t6_arena_b)
    if: info_b = 0
        return: 0
    ---
    info_b\method: method
    lmx_arena_ref_store(child_b\graph, 0U, (cast: (@: void) info_b))
    mail_b: t6_mail_b
    t_b: (cast: (@: LmxThread) child_b)
    sched_b: (cast: (@: LmxSchedule) lmx_arena_take(t6_arena_b, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: t_b = 0 || sched_b = 0
        t6_diag: 7U
        return: 0
    ---
    if: lmx_post_init(t6_arena_b, mail_b) != c.LMX_POST_OK
        t6_diag: 8U
        return: 0
    ---
    if: lmx_schedule_init(sched_b, t6_arena_b, (cast: (@: void) t_b), 100000U) != c.LMX_SCHEDULE_OK
        t6_diag: 9U
        return: 0
    ---
    if: lmx_thread_init(t6_arena_b, t_b, child_b\graph, mail_b, sched_b) != c.LMX_THREAD_OK
        t6_diag: 10U
        return: 0
    ---
    if: lmx_child_thread(t, child_b, t_b) != c.LMX_CHILD_OK
        t6_diag: 11U
        return: 0
    ---
    # A's manager traverses A's sole graph children Array after end-turn publication.
    t6_sched_b: sched_b
    t6_phase: 2U
return: 0

fn: t6_root_entry (@: Lmx node) int
    @: LmxMsg child
    @: LmxThread child_t
    @: LmxPost child_mail
    @: LmxSchedule child_sched
    @: LmxMethod method
    @: LmxCallable info_a
    @: LmxPool methods
    @: Lmx graph
    if: t6_phase != 0U
        return: 0
    ---
    if: t6_root = 0 || t6_arena_a = 0 || t6_source_a = 0 || t6_mail_a = 0
        t6_diag: 13U
        return: 0
    ---
    child: lmx_root_create(t6_root, t6_arena_a, t6_source_a)
    if: child = 0
        t6_diag: 14U
        return: 0
    ---
    graph: child\graph
    methods: lmx_pool_make(t6_arena_a, 2U * c.sizeof(c.LmxMethod), c.sizeof(c.LmxMethod),
                           c.LMX_KIND_METHOD, c.LMX_TYPE_METHOD)
    if: graph = 0 || methods = 0
        t6_diag: 15U
        return: 0
    ---
    method: lmx_method_intern(t6_arena_a, methods, (cast: (LmxEntry) t6_body_a), 1U)
    if: method = 0
        t6_diag: 16U
        return: 0
    ---
    info_a: lmx_callable_new_owned(t6_arena_a)
    if: info_a = 0
        return: 0
    ---
    info_a\method: method
    lmx_arena_ref_store(graph, 0U, (cast: (@: void) info_a))
    child_mail: t6_mail_a
    child_t: (cast: (@: LmxThread) child)
    child_sched: (cast: (@: LmxSchedule) lmx_arena_take(t6_arena_a, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: child_t = 0 || child_sched = 0
        t6_diag: 17U
        return: 0
    ---
    if: lmx_post_init(t6_arena_a, child_mail) != c.LMX_POST_OK
        t6_diag: 18U
        return: 0
    ---
    if: lmx_schedule_init(child_sched, t6_arena_a, (cast: (@: void) child_t), 100000U) != c.LMX_SCHEDULE_OK
        t6_diag: 19U
        return: 0
    ---
    if: lmx_thread_init(t6_arena_a, child_t, child\graph, child_mail, child_sched) != c.LMX_THREAD_OK
        t6_diag: 20U
        return: 0
    ---
    if: lmx_thread_scheduler_open(child_t, t6_harness) != c.LMX_THREAD_OK
        t6_diag: 21U
        return: 0
    ---
    if: lmx_child_thread(lmx_root_thread(t6_root), child, child_t) != c.LMX_CHILD_OK
        t6_diag: 22U
        return: 0
    ---
    # R0's manager traverses R0's sole graph children Array after end-turn publication.
    t6_t_a: child_t
    t6_phase: 1U
return: 0

fn: main () int
    @: int counts (cast: (@: int) calloc(5U, c.sizeof(int)))
    LmxRoot: root
    LmxArena: arena_a
    LmxArena: arena_b
    LmxArena: harness
    @: LmxPost mail_a 0
    @: LmxPost mail_b 0
    @: LmxArena root_arena 0
    @: Lmx live_graph 0
    @: Lmx source 0
    @: LmxMsg message 0
    int: code 0
    if: counts = 0
        return: 2
    ---
    memset((cast: (@: void) (@ root)), 0, c.sizeof(c.LmxRoot))
    memset((cast: (@: void) (@ arena_a)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ arena_b)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ harness)), 0, c.sizeof(c.LmxArena))
    t6_root: @ root
    t6_arena_a: @ arena_a
    t6_arena_b: @ arena_b
    t6_harness: @ harness
    if: lmx_arena_open(@ arena_a) != 0 || lmx_arena_open(@ arena_b) != 0 || lmx_arena_open(@ harness) != 0
        c.printf("PROBE-RUNNING an arena did not open\n")
        c.fflush(0)
        return: 2
    ---
    mail_a: (cast: (@: LmxPost) lmx_arena_take(@ arena_a, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    mail_b: (cast: (@: LmxPost) lmx_arena_take(@ arena_b, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    if: mail_a = 0 || mail_b = 0
        c.printf("PROBE-RUNNING a mailbox did not allocate in its Thread arena\n")
        c.fflush(0)
        return: 2
    ---
    t6_mail_a: mail_a
    t6_mail_b: mail_b
    t6_phase: 0U
    t6_diag: 0U
    t6_run: 1
    if: lmx_root_open(@ root, t6_root_entry, 120000U) != c.LMX_ROOT_OK
        c.printf("PROBE-RUNNING the root did not open\n")
        c.fflush(0)
        return: 2
    ---
    root_arena: lmx_root_arena(@ root)
    message: lmx_root_message(@ root)
    if: root_arena = 0 || message = 0
        c.printf("PROBE-RUNNING the root is missing pieces\n")
        c.fflush(0)
        return: 2
    ---
    live_graph: message\graph
    source: lmx_node_new_owned(root_arena)
    if: source = 0 || lmx_arena_refs_open_owned(root_arena, source, 5U) != 0 || lmx_thread_children_field_new(root_arena, source, 4U) = 0
        c.printf("PROBE-RUNNING the template was not built\n")
        c.fflush(0)
        return: 2
    ---
    lmx_arena_ref_store(live_graph, 3U, (cast: (@: void) source))
    t6_source_a: source
    if: lmx_root_cycle(@ root, 1U) != c.LMX_ROOT_OK || t6_phase = 0U
        c.printf("PROBE-RUNNING A was not wired, diag=%u\n", (cast: (unsigned) t6_diag))
        c.fflush(0)
        return: 2
    ---
    # A'S OWN MANAGER IS REBOUND TO THE RUNNING BINDING HERE, before B exists. Membership remains
    # only in A's graph Array; changing the manager implementation must therefore restore the same
    # owner explicitly rather than populate a second queue.
    if: lmx_manager_running_init((cast: (@: LmxManager) lmx_thread_manager(t6_t_a))) != c.LMX_MANAGER_OK
        c.printf("PROBE-RUNNING A's manager was not rebound to the running binding\n")
        c.fflush(0)
        return: 2
    ---
    if: lmx_manager_bind((cast: (@: LmxManager) lmx_thread_manager(t6_t_a)), t6_t_a) != c.LMX_MANAGER_OK
        c.printf("PROBE-RUNNING A's running manager did not retain A as its graph owner\n")
        c.fflush(0)
        return: 2
    ---
    if: t6_phase != 2U
        if: lmx_root_cycle(@ root, 1U) != c.LMX_ROOT_OK || t6_phase != 2U
            c.printf("PROBE-RUNNING B was not wired by A's turn, diag=%u\n", (cast: (unsigned) t6_diag))
            c.fflush(0)
            return: 2
        ---
    ---
    if: lmx_root_close_limit_set(@ root, 400U) != c.LMX_ROOT_OK
        c.printf("PROBE-RUNNING the close limit was not set\n")
        c.fflush(0)
        return: 2
    ---
    # A's lane ownership: with the running binding the first manager step STARTS the lane, and from
    # then on B's body is looping on ITS OWN thread while the closer keeps passing.
    # A LANE ONLY RUNS A RECORD WHOSE SCHEDULE IS WAITING (lmx_manager_running_body): declare the wait
    # BEFORE the close starts the lane, or the lane runs no turn at all -- measured as b_spins = 0 and
    # a close that completes inside its bound, which is not the case this probe exists for.
    if: lmx_schedule_wait(t6_sched_b, lmx_root_clock(@ root)) != c.LMX_SCHEDULE_OK
        c.printf("PROBE-RUNNING the child's schedule did not accept a wait\n")
        c.fflush(0)
        return: 2
    ---
    # THE LANE MUST ALREADY BE TURNING WHEN THE CLOSE BEGINS.  Under the corrected contract a child
    # with no ACTIVE lane is QUIESCENT and the closer claims it before any lane can start, so the
    # "a lane that never ends" case has to be created BEFORE the close: start the lane here, let it
    # enter B's never-returning body, and only then close.  Measured both ways: without this the lane
    # is never started (b_spins = 0) and the close returns; with it the lane is inside the body and
    # nothing but the watchdog can end the process.
    if: lmx_manager_running_round(lmx_root_manager(@ root), 4U, lmx_root_clock(@ root)) != c.LMX_MANAGER_OK
        c.printf("PROBE-RUNNING A's lane was not started before the close\n")
        c.fflush(0)
        return: 2
    ---
    # ... AND A'S OWN QUEUE, because that is where B's slot lives: starting A's lane does not start
    # B's, and B's lane is the one this probe needs inside the never-returning body.
    if: lmx_manager_running_round((cast: (@: LmxManager) lmx_thread_manager(t6_t_a)), 4U, lmx_root_clock(@ root)) != c.LMX_MANAGER_OK
        c.printf("PROBE-RUNNING B's lane was not started before the close\n")
        c.fflush(0)
        return: 2
    ---
    c.Sleep(50U)
    if: t6_b_spins = 0U
        c.printf("PROBE-RUNNING the child's body never ran: the lane did not enter it\n")
        c.fflush(0)
        return: 2
    ---
    c.printf("PROBE-RUNNING armed: R0 -> A -> B, B's body never returns, close limit 400 ms\n")
    c.printf("PROBE-RUNNING pre-close: A queue=%u b_spins=%u\n", (cast: (unsigned) lmx_manager_count((cast: (@: LmxManager) lmx_thread_manager(t6_t_a)))), (cast: (unsigned) t6_b_spins))
    c.fflush(0)
    code: lmx_root_close(@ root)
    c.printf("PROBE-RUNNING post-close: A queue=%u b_spins=%u\n", (cast: (unsigned) lmx_manager_count((cast: (@: LmxManager) lmx_thread_manager(t6_t_a)))), (cast: (unsigned) t6_b_spins))
    c.printf("PROBE-RUNNING the close RETURNED code=%d with B's body still looping\n", code)
    c.fflush(0)
return: 0
