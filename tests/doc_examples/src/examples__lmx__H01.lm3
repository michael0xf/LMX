Arithmetic:
    int: value
    return: int
    twice:
        return: value * 2
    plusOne:
        return: value + 1

ApplyProbe:
    return: int
    run:
        @: chosen Arithmetic\twice
        int: first chosen(7)
        chosen := Arithmetic\plusOne
        return: first * 100 + chosen(7)

