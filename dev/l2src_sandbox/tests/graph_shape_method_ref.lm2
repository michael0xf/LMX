# A method-local Holder keeps an int, then a nested Structure written in place.
# Point stays an independent unit-level definition before the method.
Point:
    int: x 1
end: Point
sub: task ()
    Holder:
        int: c 3
        box:
            int: x 1
    end: Holder
    return
task
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
