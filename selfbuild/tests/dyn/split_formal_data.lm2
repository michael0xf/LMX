# The same code operand runs over the Structure passed in a formal.
S:
    int: x
    x: x + 1
end: S
D:
    int: x 1
end: D
fn: bump (D: d) int
    call: S d
    return: 0
end: bump
int: dropped bump(D)
int: result 81
if: D\x = 2
    result: 7
sendMessage: exit(exit_code: result; stdout: ""; stderr: "")
return
