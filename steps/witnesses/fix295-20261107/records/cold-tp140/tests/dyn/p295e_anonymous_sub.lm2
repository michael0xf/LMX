# Slice 295 probe (the book :133, :424, :441): a declaration in an anonymous body of a fn and one in an `if` of a sub name the
# activation's one place in var: `m\var\q`, `s\var\w`.  The unit field the sub writes is read through `node\` (the root's
# bare working copy is not reloaded).  Entry 7; a wrong value leaves as the exit code (v, 100 + v, 150 + v).
int: seen 0
fn: read_seen () int
    return: node\seen
end: read_seen
fn: m () int
    int: r 0
    ---
        int: q 4
        r: q
    ---
    return: r
end: m
sub: s (int: c)
    if: c > 0
        int: w c + 1
        node\seen: w
    ---
end: s
int: code 7
int: v m()
if: v != 4
    code: v
---
if: code = 7 && m\var\q != 4
    code: 100 + m\var\q
---
if: code = 7
    s(5)
    if: read_seen() != 6 || s\var\w != 6
        code: 150 + read_seen()
    ---
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
