predef: "l2src/lmx_graph_copy_owned.h.lm1"

# sizeof(@: void) is the size of a pointer: the sizeof: receiver's type frame
# (FABLE-OPUS-GATE-TRANSLATOR-20260924-151; it was c.sizeof(@: void) through a
# c.sizeof special). The header predef'd here includes l2src/lmx.h, whose text
# holds `sizeof(`; that text must not make sizeof a declared C function. The
# `void` inside the type frame is a primitive type word, not a free name. The
# lowering is the L1 spelling c.sizeof(@: void), which L1 turns into
# sizeof(void *).
fn: sizeof_in_assign (size_t: cap) int
    size_t: b
    b: cap * sizeof(@: void)
    if: b = 0U
        return: 1
    return: 0
end: sizeof_in_assign

fn: sizeof_in_call (size_t: cap) int
    @@: void keys
    keys: (cast: (@@: void) c.malloc(cap * sizeof(@: void)))
    if: keys = 0
        return: 1
    c.free(keys)
    return: 0
end: sizeof_in_call
