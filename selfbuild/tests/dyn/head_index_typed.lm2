# Step 23.6c, the same program as head_index_old.lm2 with the types inside the index of the three heads written in the TYPED notation: `(cast: (char@) q)`, `sizeof(char@)` and the bare `(cast: (@) q)`.
# The text of a head is read again as a document of its own (lm_compiler_head_expression) and the pass of the typed notation (lm_p0_lower_types) lowers it to the tree P0 builds for the old notation,
# so the program does what its twin does. Native only: the walker reads the program through the builder of the graph, which has no pass (step 23.4, T4). Entry 7; 81.. name the failing check.
include: "<stdlib.h>"
fn: slot_one (@: s char) int
    return: 1
fn: slot_three (@: s void) int
    return: 3
fn: write_cast (@: p int; @: q void) int
    p[(cast: (size_t) slot_one((cast: (char@) q)))] := 5
    return: 0
fn: write_size (@: p int) int
    p[(cast: (size_t) sizeof(char@)) / 4U] := 5
    return: 0
fn: write_bare (@: p int; @: q void) int
    p[(cast: (size_t) slot_three((cast: (@) q)))] := 5
    return: 0
fn: m () int
    @: cells int c.calloc(4U, c.sizeof(c.int))
    @: raw void c.calloc(4U, 1U)
    int: done 0
    done := write_cast(cells, raw)
    done := write_size(cells)
    done := write_bare(cells, raw)
    if: cells[1] != 5
        return: 81
    if: cells[2] != 5
        return: 82
    if: cells[3] != 5
        return: 83
    if: cells[0] != 0
        return: 84
    return: 7
end: m
send: exit(exit_code: m(); stdout: ""; stderr: "")
return
