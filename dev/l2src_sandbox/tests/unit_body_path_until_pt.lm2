# Point inside an until block. return at the fn column is the trailer. pt\x is 4.
Point:
    int: x 0
    int: y 0
end: Point
fn: nop () int
    return: 0
fn: test () int
    int: answer 64
    int: once 0
    ---
        pt: merge Point
        pt\x: 4
        nop()
        if: pt\x = 4
            answer: 7
        once: once + 1
    until: once >= 1
return: answer
int: r 0
r: test()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
