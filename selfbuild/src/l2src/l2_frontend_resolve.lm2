        grown: c.lm_compiler_vec_grow((cast: (@: void) urm_at_cell[0]), urm_n_cell[0], want, (cast: (size_t) (sizeof(@: c.LmP0Node))))
        if: grown = 0
            return: (cast: (int) (-1))
        urm_at_cell[0]: (cast: (@@: c.LmP0Node) grown)
        grown: c.lm_compiler_vec_grow((cast: (@: void) urm_val_cell[0]), urm_n_cell[0], want, (cast: (size_t) (c.sizeof(c.int))))
        if: grown = 0
            return: (cast: (int) (-1))
