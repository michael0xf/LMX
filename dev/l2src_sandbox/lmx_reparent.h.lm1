predef: "l2src/lmx_thread.h.lm1"
predef: "l2src/lmx_graph_copy_owned.h.lm1"

# Read-only preflight for linking an existing Thread under new_parent.  It walks the
# actual Message graph of the moved Thread and its descendants.  A foreign sealed
# branch is admissible only while its owner arena remains on the resulting Message
# ancestor chain.  No name, numeric branch key, or permanent dependency record is
# needed; all identities are stable physical addresses.
define: LMX_REPARENT_OK 0
define: LMX_REPARENT_INVALID 1
define: LMX_REPARENT_OWNER 2
define: LMX_REPARENT_NOMEM 3

struct: LmxReparentEdge
    @@: void slot
    @: void value
    @: Lmx source_profile
    @: LmxArena view
end: LmxReparentEdge

struct: LmxReparentEdges
    @: LmxReparentEdge data
    size_t: n
    size_t: room
end: LmxReparentEdges

# Operation-local copy transaction, never part of the LMX graph. A successful
# stage owns its arena and physical source->copy map until the caller either
# proves and publishes the result or discards the entire stage.
struct: LmxReparentCopyStage
    LmxArena: arena
    LmxCopyMap: targets
    LmxCopyMap: pending
    LmxCopyMap: relocated
    @@: Lmx sources
    @@: Lmx results
    @@: Lmx keep
    size_t: n
    size_t: kept
end: LmxReparentCopyStage

prototype:
    # Recover the one qualified Structure root of an imported or local profile
    # from its physical typed ranges. Zero for an absent/ambiguous profile.
    # This read-only scan uses no name or redundant root registry.
    fn: lmx_reparent_profile_root (@: LmxArena view; @: Lmx profile) @: Lmx
    # On OWNER, `lost` maps each reached sealed profile address to its owner
    # arena address. On OK it is empty. The caller disposes this operation-local
    # map in either case; other errors leave it empty. No graph metadata is added.
    fn: lmx_reparent_lost_profiles (@: LmxThread moved; @: LmxThread new_parent; @: LmxCopyMap lost) int
    # Same read-only scan can retain the physical input edges needed for a
    # later all-or-nothing redirect. A source_profile identifies an immutable
    # carrier which cannot be edited in place. Both outputs are scratch only.
    fn: lmx_reparent_scan (@: LmxThread moved; @: LmxThread new_parent; @: LmxCopyMap lost; @: LmxReparentEdges edges) int
    fn: lmx_reparent_edges_dispose (@: LmxReparentEdges edges) void
    # Expand a lost-profile set through sealed carriers that themselves point
    # into it. These cannot be rewritten in place, even if their own owner
    # remains visible. The map stays operation-local and uses physical addresses.
    fn: lmx_reparent_expand_carriers (@: LmxCopyMap selected; @: LmxReparentEdges edges) int
    # Fixed point in both directions: immutable carriers of selected values
    # must be copied; a selected carrier's sealed dependency must also be
    # copied only if its owner is not visible from the moved Message's new
    # ancestry, where the copy will live. This remains scratch selection.
    fn: lmx_reparent_expand_copy_set (@: LmxThread moved; @: LmxThread new_parent; @: LmxCopyMap selected; @: LmxReparentEdges edges) int
    # Derive the exact root of every selected physical profile from its owner
    # arena's typed ranges. The output is an operation-local profile -> root
    # address map, not a persistent root registry or a name lookup.
    fn: lmx_reparent_selected_roots (@: LmxCopyMap selected; @: LmxCopyMap roots) int
    # Construct a disposable read-only source view of selected owners' visible
    # typed indices. Classification here is not a copy or retention decision:
    # `retained` maps only the exact qualified dependencies already established
    # by reached edges. Both outputs start empty and are released by the caller;
    # view must be zero-initialized. No imported interval owns source storage.
    fn: lmx_reparent_source_view (@: LmxCopyMap selected; @: LmxReparentEdges edges; @: LmxArena view; @: LmxCopyMap retained) int
    # After the common copier reports a *reached* missing sealed profile,
    # route its physical address to copying or retained-by-address according
    # to the same ownership/independence rule as merge. This function does not
    # discover reachability, publish copies, or mutate a Message graph.
    fn: lmx_reparent_route_missing_profile (@: LmxThread moved; @: LmxThread new_parent; @: LmxArena view; @: Lmx profile; @: LmxCopyMap selected; @: LmxCopyMap retained) int
    # One common remapped forest copy. On success, stage owns the uncommitted
    # arena, exact address map and pending names. On a reached missing profile,
    # `missing` names it but no staged storage survives. No live graph changes.
    fn: lmx_reparent_stage_copy_set (@: LmxArena view; @: LmxCopyMap selected; @: LmxCopyMap retained; @: LmxReparentCopyStage stage; @@: Lmx missing) int
    fn: lmx_reparent_copy_stage_dispose (@: LmxReparentCopyStage stage) void
    # Probe the shared copier in a disposable arena until every sealed profile
    # on its reached used paths is either selected or retained. Only the two
    # scratch maps and the source view change; no Message graph is published.
    fn: lmx_reparent_close_copy_set (@: LmxThread moved; @: LmxThread new_parent; @: LmxArena view; @: LmxCopyMap selected; @: LmxCopyMap retained) int
    fn: lmx_reparent_preflight (@: LmxThread moved; @: LmxThread new_parent) int
end: prototype
