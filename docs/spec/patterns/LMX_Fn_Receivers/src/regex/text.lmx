# UTF-8 is decoded here in LMX, not by a hidden regex/native text engine.
# profile 0 = Unicode scalar values; profile 1 = individual octets.
# byteOffsets contains units.length + 1 entries, including the final byte end.
# TextView retains the source descriptor; no native backing pointer.
# Public TextView stores profile + source descriptor only. Every public search
# builds one RxPreparedText from CURRENT bytes, retained for the operation or
# iterator. The same TextView may be reused after inter-operation mutation.
# Match/Span.source is the original view; private prepared data retain offsets.
# Source must remain unchanged during search/suspension/result access under the source lifetime contract.

RxOctet:
    private:
        []char: source
        int: index
    return: int
    read:
        private: int: value source[index]
        if: value < 0
            value += 256
        return: value

RxTextBuild:
    private:
        []char: source
        int: profile
    return: @
    make:
        throws: copy(FxThrows\pattern)
        private: @: info FxSeqInfo\get(source := source)
        if: info\elementBits != 8
            throw: PatternEncoding()
        if: profile != 0 && profile != 1
            throw: PatternArgument()
        private: []int: units []
        private: []int: offsets []
        # Exact upper bounds: an octet cannot create more than one scalar.
        private: @: unitInfo FxSeqInfo\get(source := units)
        private: int: unitCapacity FxSeqSize\sum(0; length(source); unitInfo\maxLength)
        private: int: offsetCapacity FxSeqSize\sum(length(source); 1; unitInfo\maxLength)
        sys\resize(units; unitCapacity)
        sys\resize(offsets; offsetCapacity)
        private: int: byteAt 0
        private: int: used 0
        while: byteAt < length(source)
            offsets[used] := byteAt
            private: int: first RxOctet\read(source; byteAt)
            private: int: code first
            private: int: width 1
            private: int: lower 0
            if: profile = 0
                if: first < 128
                    width := 1
                else:
                    if: first >= 194 && first <= 223
                        width := 2
                        code := first - 192
                        lower := 128
                    else:
                        if: first >= 224 && first <= 239
                            width := 3
                            code := first - 224
                            lower := 2048
                        else:
                            if: first >= 240 && first <= 244
                                width := 4
                                code := first - 240
                                lower := 65536
                            else:
                                throw: PatternEncoding()
                ---
                if: width > length(source) - byteAt
                    throw: PatternEncoding()
                private: int: tail 1
                while: tail < width
                    private: int: nextByte RxOctet\read(source; byteAt + tail)
                    if: nextByte < 128 || nextByte > 191
                        throw: PatternEncoding()
                    code := code * 64 + nextByte - 128
                    tail += 1
                if: code < lower || code > 1114111
                    throw: PatternEncoding()
                if: code >= 55296 && code <= 57343
                    throw: PatternEncoding()
            ---
            units[used] := code
            used += 1
            byteAt += width
        offsets[used] := byteAt
        sys\resize(units; used)
        sys\resize(offsets; used + 1)
        private: @: out (copy(RxPreparedText))
        out\profile := profile
        out\source := source
        out\units := units
        out\byteOffsets := offsets
        return: out

# The public profile constructor validates now, but stores no stale index.
# Repeated searches prepare their own current index. No change watcher is used.
RxTextViewMake:
    private:
        []char: source
        int: profile
    return: @
    make:
        private: @: validated RxTextBuild\make(source := source; profile := profile)
        private: @: out (copy(TextView))
        out\source := source
        out\profile := profile
        return: out

RxPrepare:
    private: @TextView: source
    required: source
    return: @
    make:
        private: @: prepared RxTextBuild\make(source := source\source; profile := source\profile)
        prepared\view := source
        return: prepared

RxUtf8Text:
    private: []char: source
    required: source
    return: @
    utf8Text:
        return: RxTextViewMake\make(source := source; profile := 0)

RxByteText:
    private: []char: source
    required: source
    return: @
    byteText:
        return: RxTextViewMake\make(source := source; profile := 1)

RxTextSlice:
    private:
        @RxPreparedText: source
        int: begin
        int: end
    return: []char
    copyText:
        throws: copy(FxThrows\pattern)
        if: begin < 0 || end < begin || end > length(source\units)
            throw: PatternPosition()
        return: \FxSeqSlice\slice(source\source; source\byteOffsets[begin]; source\byteOffsets[end])
