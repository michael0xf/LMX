predef: "l2src/lmx_service.h.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdlib.h>" "<string.h>" "<stdint.h>"

# lmx_service.lm1 - the sorted registry by PHYSICAL address.  MEMBERSHIP is a bisection
# (bounded comparisons); the key is the executable Message-prefix address. Because Message is the
# first by-value Thread member, this is also the LmxThread pointer value. No lmx_address.



fn: lmx_service_entries_data (@: LmxService service) @: LmxServiceEntry
    @: LmxServiceEntryDynamicArray da
    @: LmxServiceEntryArray base
    if: service = 0
        return: 0
    da: @ service\entries
    base: (cast: (@: LmxServiceEntryArray) da)
return: base\data

fn: lmx_service_entries_len (@: LmxService service) size_t
    @: LmxServiceEntryDynamicArray da
    @: LmxServiceEntryArray base
    if: service = 0
        return: 0U
    da: @ service\entries
    base: (cast: (@: LmxServiceEntryArray) da)
return: base\len

fn: lmx_service_entries_cap (@: LmxService service) size_t
    @: LmxServiceEntryDynamicArray da
    if: service = 0
        return: 0U
    da: @ service\entries
return: da\capacity

fn: lmx_service_entries_set_data (@: LmxService service; @: LmxServiceEntry data) void
    @: LmxServiceEntryDynamicArray da
    @: LmxServiceEntryArray base
    if: service = 0
        return
    da: @ service\entries
    base: (cast: (@: LmxServiceEntryArray) da)
    base\data: data
return

fn: lmx_service_entries_set_len (@: LmxService service; size_t: len) void
    @: LmxServiceEntryDynamicArray da
    @: LmxServiceEntryArray base
    if: service = 0
        return
    da: @ service\entries
    base: (cast: (@: LmxServiceEntryArray) da)
    base\len: len
return

fn: lmx_service_entries_set_cap (@: LmxService service; size_t: capacity) void
    @: LmxServiceEntryDynamicArray da
    if: service = 0
        return
    da: @ service\entries
    da\capacity: capacity
return


fn: lmx_service_compare (@: void a; @: void b) int
    uintptr_t: aa
    uintptr_t: bb
    if: a = b
        return: 0
    ---
    aa: (cast: (uintptr_t) a)
    bb: (cast: (uintptr_t) b)
    if: aa < bb
        return: -1
    ---
return: 1

fn: lmx_service_reserve (@: LmxService service; size_t: need) int
    size_t: capacity
    @: LmxServiceEntry moved
    if: service = 0
        return: c.LMX_SERVICE_INVALID
    if: need <= lmx_service_entries_cap(service)
        return: c.LMX_SERVICE_OK
    ---
    capacity: lmx_service_entries_cap(service)
    if: capacity = 0U
        capacity: 4U
    ---
    while: capacity < need
        capacity: capacity * 2U
    ---
    # The ENTRIES move, the records never do: that is the whole reason a service may grow at all.
    moved: (cast: (@: LmxServiceEntry) realloc((cast: (@: void) lmx_service_entries_data(service)), capacity * c.sizeof(c.LmxServiceEntry)))
    if: moved = 0
        return: c.LMX_SERVICE_FULL
    ---
    lmx_service_entries_set_data(service, moved)
    lmx_service_entries_set_cap(service, capacity)
return: c.LMX_SERVICE_OK

fn: lmx_service_open (@: LmxService service) int
    if: service = 0
        return: c.LMX_SERVICE_INVALID
    if: lmx_service_entries_data(service) != 0 || lmx_service_entries_len(service) != 0U || lmx_service_entries_cap(service) != 0U
        return: c.LMX_SERVICE_INVALID
    ---
return: c.LMX_SERVICE_OK

fn: lmx_service_count (@: LmxService service) size_t
    if: service = 0
        return: 0U
return: lmx_service_entries_len(service)

fn: lmx_service_at (@: LmxService service; size_t: index) @: void
    @: LmxServiceEntry entry
    if: service = 0 || index >= lmx_service_entries_len(service)
        return: 0
    ---
    entry: lmx_service_entries_data(service) + index
return: entry\target

# Where this physical address belongs in the order: the first entry that does not sort before it.
fn: lmx_service_point (@: LmxService service; @: void address) size_t
    @: LmxServiceEntry entry
    size_t: low
    size_t: high
    size_t: middle
    int: order
    low: 0U
    high: lmx_service_entries_len(service)
    while: low < high
        middle: (low + high) / 2U
        entry: lmx_service_entries_data(service) + middle
        order: lmx_service_compare(entry\address, address)
        if: order < 0
            low: middle + 1U
        else:
            high: middle
        ---
    ---
return: low

fn: lmx_service_open_room (@: LmxService service; size_t: at) int
    @: LmxServiceEntry entry
    if: at > lmx_service_entries_len(service)
        return: c.LMX_SERVICE_INVALID
    if: lmx_service_entries_len(service) = at
        return: c.LMX_SERVICE_OK
    ---
    entry: lmx_service_entries_data(service) + at
    memmove((cast: (@: void) (entry + 1U)), (cast: (@: void) entry), (lmx_service_entries_len(service) - at) * c.sizeof(c.LmxServiceEntry))
return: c.LMX_SERVICE_OK

fn: lmx_service_close_gap (@: LmxService service; size_t: at) int
    @: LmxServiceEntry entry
    if: at >= lmx_service_entries_len(service)
        return: c.LMX_SERVICE_INVALID
    entry: lmx_service_entries_data(service) + at
    if: at + 1U < lmx_service_entries_len(service)
        memmove((cast: (@: void) entry), (cast: (@: void) (entry + 1U)), (lmx_service_entries_len(service) - at - 1U) * c.sizeof(c.LmxServiceEntry))
    ---
    lmx_service_entries_set_len(service, lmx_service_entries_len(service) - 1U)
return: c.LMX_SERVICE_OK

fn: lmx_service_register (@: LmxService service; @: LmxThread target; @: LmxArena target_arena) int
    @: LmxServiceEntry entry
    @: void key
    size_t: point
    if: service = 0 || target = 0 || target_arena = 0
        return: c.LMX_SERVICE_INVALID
    ---
    # Refuse before dereferencing Thread-only fields. A Thread has the common Message kind at its
    # prefix address and the exact Thread range type; a standalone Message has the same kind but a
    # different exact type and cannot be registered as an executor.
    if: lmx_range_classify(target_arena, (cast: (@: void) target)) != c.LMX_DOMAIN_KIND_MSG_RECORD || lmx_range_type_of(target_arena, (cast: (@: void) target)) != c.LMX_DOMAIN_THREAD || lmx_range_stride(target_arena, (cast: (@: void) target)) != c.sizeof(c.LmxThread) || lmx_range_home(target_arena, (cast: (@: void) target)) != target_arena
        return: c.LMX_SERVICE_INVALID
    ---
    # A live Thread belongs to exactly one service. Refuse a second service before reserving or
    # mutating either registry; a repeated registration in the same service preserves the existing
    # DUPLICATE result and cannot overwrite the stable route.
    if: target\service != 0
        if: target\service = (cast: (@: void) service)
            return: c.LMX_SERVICE_DUPLICATE
        ---
        return: c.LMX_SERVICE_INVALID
    ---
    if: lmx_service_reserve(service, lmx_service_entries_len(service) + 1U) != c.LMX_SERVICE_OK
        return: c.LMX_SERVICE_FULL
    ---
    # The key is the physical Message address; the first-member invariant makes it the Thread
    # address too, without substituting one record type for the other.
    key: (cast: (@: void) target)
    point: lmx_service_point(service, key)
    if: point < lmx_service_entries_len(service)
        entry: lmx_service_entries_data(service) + point
        if: lmx_service_compare(entry\address, key) = 0
            return: c.LMX_SERVICE_DUPLICATE
        ---
    ---
    if: lmx_service_open_room(service, point) != c.LMX_SERVICE_OK
        return: c.LMX_SERVICE_INVALID
    ---
    entry: lmx_service_entries_data(service) + point
    entry\address: key
    entry\target: key
    entry\arena: target_arena
    entry\service: service
    lmx_service_entries_set_len(service, lmx_service_entries_len(service) + 1U)
    # The record knows its own entry from here on.
    target\service: (cast: (@: void) service)
return: c.LMX_SERVICE_OK

fn: lmx_service_find (@: LmxService service; @: void address) @: void
    @: LmxServiceEntry entry
    size_t: point
    if: service = 0 || address = 0
        return: 0
    point: lmx_service_point(service, address)
    if: point >= lmx_service_entries_len(service)
        return: 0
    ---
    entry: lmx_service_entries_data(service) + point
    if: lmx_service_compare(entry\address, address) != 0
        return: 0
    ---
return: entry\target

# DELIVERY.  The record is found by its physical address and the letter joins ITS inbox.
# An unknown address answers MISSING and is never dereferenced.  letter_arena is the
# letter Message's OWN arena (19.29.2): on MISSING the service releases it -- undelivered
# letter means release that arena, not an LmxPostLink (no queue node was made).
fn: lmx_service_post (@: LmxService service; @: void address; @: LmxMsg letter; @: LmxArena letter_arena) int
    @: LmxServiceEntry entry
    @: LmxServiceEntry sender_entry
    @: LmxThread target_thread
    @: void sender_addr
    @: LmxArena sender_home
    @: LmxRange sender_range
    size_t: point
    size_t: sender_point
    size_t: sender_scan
    if: service = 0 || address = 0 || letter = 0
        return: c.LMX_SERVICE_INVALID
    point: lmx_service_point(service, address)
    if: point >= lmx_service_entries_len(service)
        if: letter_arena != 0
            lmx_arena_release(letter_arena)
        ---
        return: c.LMX_SERVICE_MISSING
    ---
    entry: lmx_service_entries_data(service) + point
    if: lmx_service_compare(entry\address, address) != 0
        if: letter_arena != 0
            lmx_arena_release(letter_arena)
        ---
        return: c.LMX_SERVICE_MISSING
    if: entry\target = 0 || entry\arena = 0
        if: letter_arena != 0
            lmx_arena_release(letter_arena)
        ---
        return: c.LMX_SERVICE_MISSING
    ---
    target_thread: (cast: (@: LmxThread) entry\target)
    if: target_thread\mail = 0
        if: letter_arena != 0
            lmx_arena_release(letter_arena)
        ---
        return: c.LMX_SERVICE_MISSING
    ---
    # -185 / D-60 / FABLE-GROKBOT-SENDER-RANGE-20260925-185:
    # Delivery publishes ONE view of the sender Message's sealed MSG_RECORD interval into
    # letter_arena (not a whole-arena import — that pulled host eternal/profile seals into the
    # letter and broke host close). Place: lmx_service_post, before accept_transfer. Sender home
    # = this service registry. DECISION: do not seal here; producer seals when publishable.
    # Residual BLOCKER for walked root: host THREAD pool stays open, so add_view refuses until
    # a separate seal-or-view act. Mutant skip-view: classify(receiver, sender) stays KIND_NONE.
    if: letter_arena != 0 && letter\graph != 0
        sender_addr: lmx_arena_ref_value(letter\graph, 0U)
        if: sender_addr != 0
            sender_point: lmx_service_point(service, sender_addr)
            sender_home: 0
            if: sender_point < lmx_service_entries_len(service)
                sender_entry: lmx_service_entries_data(service) + sender_point
                if: lmx_service_compare(sender_entry\address, sender_addr) = 0
                    sender_home: sender_entry\arena
                ---
            ---
            if: sender_home != 0 && sender_home != letter_arena
                if: lmx_range_classify(letter_arena, sender_addr) = c.LMX_KIND_NONE
                    sender_scan: 0U
                    while: sender_scan < lmx_arena_index_len(sender_home)
                        sender_range: lmx_arena_index_data(sender_home) + sender_scan
                        if: sender_addr >= sender_range\lo && sender_addr < sender_range\hi
                            if: sender_range\array != 0 && sender_range\array\kind = c.LMX_DOMAIN_KIND_MSG_RECORD && sender_range\array\sealed != 0U
                                if: lmx_range_add_view(letter_arena, (cast: (@: LmxArena) sender_range\owner), sender_range\array, sender_range\lo, sender_range\hi) != 0
                                    return: c.LMX_SERVICE_INVALID
                                ---
                            ---
                            break
                        ---
                        sender_scan: sender_scan + 1U
                    ---
                ---
            ---
        ---
    ---
    # The mailbox owns the transaction and the only synchronization. The producer publishes the
    # physical letter together with its still-owning arena; the receiver owner claims that arena
    # on take. Thus delivery never mutates an arena concurrently with its receiver's GC.
    if: lmx_post_accept_transfer(entry\arena, target_thread\mail, (cast: (@: void) letter), letter_arena) != c.LMX_POST_OK
        return: c.LMX_SERVICE_INVALID
    ---
return: c.LMX_SERVICE_OK

fn: lmx_service_unregister (@: LmxService service; @: LmxThread target) int
    @: LmxServiceEntry entry
    @: void key
    size_t: point
    if: service = 0 || target = 0
        return: c.LMX_SERVICE_INVALID
    key: (cast: (@: void) target)
    point: lmx_service_point(service, key)
    if: point >= lmx_service_entries_len(service)
        return: c.LMX_SERVICE_MISSING
    ---
    entry: lmx_service_entries_data(service) + point
    if: lmx_service_compare(entry\address, key) != 0
        return: c.LMX_SERVICE_MISSING
    ---
    if: entry\target != key || entry\service != service
        return: c.LMX_SERVICE_INVALID
    ---
    if: entry\arena = 0 || lmx_range_classify(entry\arena, entry\target) != c.LMX_DOMAIN_KIND_MSG_RECORD || lmx_range_type_of(entry\arena, entry\target) != c.LMX_DOMAIN_THREAD || lmx_range_stride(entry\arena, entry\target) != c.sizeof(c.LmxThread) || lmx_range_home(entry\arena, entry\target) != entry\arena
        return: c.LMX_SERVICE_INVALID
    ---
    if: target\service != (cast: (@: void) service)
        return: c.LMX_SERVICE_INVALID
    ---
    target\service: 0
return: lmx_service_close_gap(service, point)

fn: lmx_service_release (@: LmxService service) int
    if: service = 0
        return: c.LMX_SERVICE_INVALID
    # The registry does not own the target arenas and therefore must never walk/dereference them
    # during destruction.  Every live target must be explicitly unregistered while its arena is
    # known alive; release refuses to hide a stale route or turn that contract into a UAF.
    if: lmx_service_entries_len(service) != 0U
        return: c.LMX_SERVICE_INVALID
    ---
    if: lmx_service_entries_data(service) != 0
        free((cast: (@: void) lmx_service_entries_data(service)))
    ---
    lmx_service_entries_set_data(service, 0)
    lmx_service_entries_set_len(service, 0U)
    lmx_service_entries_set_cap(service, 0U)
return: c.LMX_SERVICE_OK
