fn: lm_compiler_mad_store_stmt (const: (@: stmt c.LmP0Node)) int
    const: (@: call_node c.LmP0Node c.lm_compiler_receiver_call(stmt, 0))
    if: call_node = 0
        return: (cast: (int) (0))
    return: (cast: (int) (lm_compiler_mad_on(c.lm_compiler_find_method(call_node\as\frame\head))))
end: lm_compiler_mad_store_stmt

fn: lm_compiler_mad_declaring (const: (@: stmt c.LmP0Node); int: mi) int
    if: lm_compiler_mad_store_stmt(stmt) = 0
        return: (cast: (int) (0))
    return: (cast: (int) ((cast: (int) (lm_compiler_own_by_decl(mi, stmt) >= 0))))
end: lm_compiler_mad_declaring

fn: lm_compiler_source_part_row (int: mi; int: part) @: c.L2SourceContainer
    @@: source_containers_cell c.L2SourceContainer (cast: (@@: c.L2SourceContainer) (@ c.l2_source_containers))
    @: root c.L2SourceContainer lm_compiler_source_root(mi)
    @: row c.L2SourceContainer source_containers_cell[0]
    if: root = 0 && (part < 3 || part > 4)
        return: (cast: (@: c.L2SourceContainer) (0))
    while: row != 0
        if: row\source_mi = mi && row\part = part && ((root != 0 && row\view_kind = root\view_kind && row\view_index = root\view_index) || (root = 0 && row\view_kind = 0 && row\view_index = mi))
            return: (cast: (@: c.L2SourceContainer) (row))
        row: row\allocated_next
    ---
    return: (cast: (@: c.L2SourceContainer) (0))
end: lm_compiler_source_part_row

fn: lm_compiler_mad_node_arity (int: mi) int
    @@: m_ret_cell int (cast: (@@: int) (@ c.l2_m_ret))
    @@: m_arity_cell int (cast: (@@: int) (@ c.l2_m_arity))
    @@: mad_model_cell int (cast: (@@: int) (@ c.l2_mad_model))
    int: arity
    arity: c.lm_compiler_mad_hdr_arity(mi)
    if: arity < 1 && m_ret_cell[0][mi] != 16
        arity: m_arity_cell[0][mad_model_cell[0][mi]]
    return: (cast: (int) (arity))
end: lm_compiler_mad_node_arity

fn: lm_compiler_mad_max_inputs () int
    @: m_n_cell int (cast: (@: int) (@ c.l2_m_n))
    @@: mad_model_cell int (cast: (@@: int) (@ c.l2_mad_model))
    @@: m_dyn_cell int (cast: (@@: int) (@ c.l2_m_dyn))
    int: i 0
    int: w 1
    while: i < m_n_cell[0]
        if: lm_compiler_mad_on(i) != 0 && mad_model_cell[0][i] >= 0 && lm_compiler_mad_node_arity(i) + m_dyn_cell[0][mad_model_cell[0][i]] > w
            w: lm_compiler_mad_node_arity(i) + m_dyn_cell[0][mad_model_cell[0][i]]
        i: i + 1
    ---
    return: (cast: (int) (w))
end: lm_compiler_mad_max_inputs

fn: lm_compiler_mad_held_model (int: oi) int
    @@@: own_decl_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_own_decl))
    @@: mad_model_cell int (cast: (@@: int) (@ c.l2_mad_model))
    int: host
    if: oi < 0 || lm_compiler_mad_store_stmt(own_decl_cell[0][oi]) = 0
        return: (cast: (int) (0 - 1))
    host: c.lm_compiler_store_host(own_decl_cell[0][oi])
    if: host < 0 || lm_compiler_mad_on(host) = 0
        return: (cast: (int) (0 - 1))
    return: (cast: (int) (mad_model_cell[0][host]))
end: lm_compiler_mad_held_model

fn: lm_compiler_schema_token_slot (int: schema) int
    @: mres_n_cell int (cast: (@: int) (@ c.l2_mres_n))
    @@: mres_source_cell c.L2ReferenceSource (cast: (@@: c.L2ReferenceSource) (@ c.l2_mres_source))
    @: ns_n_cell int (cast: (@: int) (@ c.l2_ns_n))
    int: result
    int: physical
    int: followed 0
    # A schema describes logical fields,not necessarily new physical storage.
    # All catalog/reference/backend token consumers use the SAME current
    # constructor-origin projection. Only retained physical evidence follows
    # a copy;its receiving Model/schema is never a physical substitute.
    while: c.lm_compiler_schema_kind(schema) = 2
        result: c.lm_compiler_schema_index(schema)
        if: result < 0 || result >= mres_n_cell[0] || followed >= mres_n_cell[0]
            return: (cast: (int) (-1))
        if: mres_source_cell[0] = 0
            break
        @: selected_source c.L2ReferenceSource (mres_source_cell[0] + result)
        physical: selected_source\layout
        if: physical = -1
            break
        schema: physical
        followed: followed + 1
    ---
    # A method occurrence has no layout-token cell. Callers fail closed.
    if: c.lm_compiler_schema_kind(schema) = 3
        return: (cast: (int) (0 - 1))
    if: c.lm_compiler_schema_kind(schema) = 2
        return: (cast: (int) (ns_n_cell[0] + c.lm_compiler_schema_index(schema)))
    return: (cast: (int) (schema))
end: lm_compiler_schema_token_slot

fn: lm_compiler_schema_method (int: mi) int
    int: ns
    if: mi < 0
        return: (cast: (int) (0 - 1))
    ns: lm_compiler_m_nsof(mi)
    if: ns >= 0
        return: (cast: (int) (ns))
    return: (cast: (int) ((0 - 1500000000) - mi))
end: lm_compiler_schema_method

fn: lm_compiler_mres_of_own (int: own) int
    @: mres_n_cell int (cast: (@: int) (@ c.l2_mres_n))
    @@: mres_own_cell int (cast: (@@: int) (@ c.l2_mres_own))
    int: i 0
    if: own < 0
        return: (cast: (int) (-1))
    while: i < mres_n_cell[0]
        if: mres_own_cell[0][i] = own
            return: (cast: (int) (i))
        i: i + 1
    ---
    return: (cast: (int) (-1))
end: lm_compiler_mres_of_own

fn: lm_compiler_mres_decl (int: mi; const: (@: stmt c.LmP0Node)) int
    if: stmt = 0 || stmt\as = 0 || stmt\as\frame = 0
        return: (cast: (int) (-1))
    return: (cast: (int) (lm_compiler_mres_of_own(lm_compiler_own_find_decl(mi, (cast: (const: @: c.LmP0Text) (stmt\as\frame\head)), stmt))))
end: lm_compiler_mres_decl
