# The receive inside the inline while writes the same m place as the earlier
# receive. Its empty-inbox result stops the loop after one iteration.
receiveMessage: m
int: n 0
while: m != 0 && n < 5
    n: n + 1
    receiveMessage: m
if: n != 1 || m != 0
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
