Example:
    []int: left
    []int: right
    int: budget
    return: @
    run:
        throws: copy(FxSeqPush\append\throws) copy(record\throws)
        []@: out []
        int: i 0
        while: i < length(left)
            int: j 0
            while: j < length(right)
                if: left[i] + right[j] <= budget
                    FxSeqPush\append(out; ((left[i]; right[j]) record))
                j += 1
            i += 1
        return: out
