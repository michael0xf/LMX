---
    Observed:
        int: copied 0
        int: own 1
    end: Observed
---
@: shared (data [] 0)
sub: main () (
    From:
        int: x 7
    end: From
    To:
        int: x 0
    end: To
    Self:
        int: x 1
        :=: x (x + 1)
    end: Self
    Copy: (data To)
    Apply: (data)
    int: copied 0
    int: own 0
)
    call: From Copy
    call: Self Apply
    :=: (data \ copied) (To \ x)
    :=: (data \ own) (Self \ x)
end: main
main:
int: copied ((main \ data) \ copied)
int: own ((main \ data) \ own)
sub: observe ()
    :=: ((shared \ Observed) \ copied) copied
    :=: ((shared \ Observed) \ own) own
end: observe
observe:
