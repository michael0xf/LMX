# An argument compared through the c.* door: its bytes and length come from the
# letter exactly as C passed them ("ok" and its NUL: three elements).
MainLetter:
    char: []: []: mainArgs
end: MainLetter

MainLetter: m
receiveMessage: m
if: length(m\mainArgs) != 2
    sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
    return
if: length(m\mainArgs[1]) != 3
    sendMessage: exit(exit_code: 2; stdout: ""; stderr: "")
    return
if: m\mainArgs[1][0] != 111 || m\mainArgs[1][2] != 0
    sendMessage: exit(exit_code: 3; stdout: ""; stderr: "")
    return
if: c.strcmp(@ m\mainArgs[1][0], "ok") != 0
    sendMessage: exit(exit_code: 4; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
