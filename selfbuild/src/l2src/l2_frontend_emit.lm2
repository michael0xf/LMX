        return: 0
    if: c.lm_compiler_schema_kind(c.lm_compiler_cap_arg_ns(idx, m_arity_cell[0][idx] + k)) != 0 && c.lm_compiler_mad_host_of(idx) = rw_mi_cell[0]
        kind[0]: 2
        chosen[0]: rw_mi_cell[0]
        return: 0
    gr: (cast: (int) (c.lm_compiler_dt(idx, k) = c.lm_compiler_graph_dt()))
    if: c.lm_compiler_rw_num_ty(oty) = 0 && c.lm_compiler_own_is_pointer(oty) = 0 && gr = 0
        return: (cast: (int) (c.lm_compiler_rw_refuse(source_node, "a call with an input that is not a number")))
    pi: c.lm_compiler_param_find(rw_mi_cell[0], nm)
