        # Consumer does not admit it refuses it when selected: this method's implicit `implements`.
        if: check_unevaluated_cell[0] = 0 && fi >= 0 && req_mi < 0 && c.lm_compiler_nsty_get(idx, actual_i) >= 0 && c.lm_compiler_admit_site(mi) != 0
            return: (cast: (int) (c.lm_compiler_error(path, source_node, "internal: admission outside a method")))
        if: req_mi >= 0
            if: actual_span = 1 && a0\value != 0 && c.lm_compiler_frame_head((cast: (const: @: c.LmP0Node) (a0\value)), "merge") != 0
                if: lm_compiler_t7_from_actual(mi, idx, actual_i, (cast: (const: @: c.LmP0Node) (a0\value)), path) != 0
                    return: (cast: (int) (1))
                # K04 S3: the node the merge builds is formed as its model is (kind 5).
                if: check_unevaluated_cell[0] = 0 && c.lm_compiler_cfl_note(idx, mi, fi, actual_i, 5, (cast: (int) (c.lm_compiler_t7_actual_model(mi, (cast: (const: @: c.LmP0Node) (a0\value))))), 0 - 1, source_node) != 0
                    return: (cast: (int) (1))
                ---
            else:
                cf_kind: 0
                cf_fi: 0 - 1
                cand_mi: c.lm_compiler_cf_value_rec(mi, value, @ cf_kind, @ cf_fi, 0)
                # K04 S3: a held name -- a node of its model (kind 4), admitted by the model's signature.
                if: cand_mi < 0 && c.lm_compiler_cf_held_value(mi, value) >= 0
                    cf_fi: c.lm_compiler_cf_held_value(mi, value)
