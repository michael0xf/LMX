# the receiver `table` (book §10): unit_s7_prim_cross over its own convert.lm2 whose table writes `colums:`
# for `columns:` (tests/unit_s7_tbl_unknown_arg_table.lm2): "colums is not an argument of table".

fn: go () int
    int: a 1
    size_t: b 2U
    a: b
    return: a

int: k
k: go()
if: k = 2
    sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
return
