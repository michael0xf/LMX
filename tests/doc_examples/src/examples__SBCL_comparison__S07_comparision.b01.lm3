Example:
    @: items
    return: @
    run:
        @[]: result []
        sys\resize(result; length(items))
        int: i 0
        while: i < length(items)
            @: current items[i]
            int: j i
            while: j > 0
                @: previous result[j - 1]
                if: \previous[0] <= \current[0]
                    break
                result[j] := previous
                j -= 1
            result[j] := current
            i += 1
        return: result
