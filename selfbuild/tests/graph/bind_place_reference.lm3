# A reference variable through the transparent place is retargeted in the caller (§3, #binding-caller-place); an own
# autofilled input changes only its own copy: 4, then 9.
(
    Observed:
        int: seen 0
    First:
        int: marker 4
    Second:
        int: marker 9
)
fn: replace () int
    @: shared node[0]
    selected := shared\Second
    return: 0
fn: keep (@: selected) int
    @: shared node[0]
    selected := shared\Second
    return: 0
fn: caller () int
    @: shared node[0]
    @: selected shared\First
    int: k keep()
    int: first selected\marker
    int: r replace()
    return: first * 10 + selected\marker
sub: main ()
    @: shared node[0]
    shared\Observed\seen := caller()
main()
