include: "<stddef.h>"
predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_arena.h.lm1"

# lmx_call.h.lm1 - calling a callable occurrence (spec 7.1, 21.2, 21.8 and 21.13.4; the gaps
# note's item 8).
#
# The graph callable itself is an ordinary Structure, with the shared function record in
# physical child[0] (7.1/21.8).  A callable is not a new kind of Structure: its physical
# child[0] holds an LmxCallable descriptor that refers to the METHOD record, its later slots hold
# that occurrence's own fields, and `M.parent` is its immediate structural parent
# (lmx.h.lm1 spells all of this out for the merge traversal).
#
# Nothing is stored to say "this is a callable": the check is the same domain question everything
# else in this kernel asks -- the VALUE in slot 0 falls into the LmxCallable address range, and a
# child carries no type tag. A bare METHOD in child[0] is not a callable occurrence.
#
# The descriptor-backed typed entry receives the RESERVED NODE FIRST, selected SELF second, then
# the arguments its signature lists; its status is the result carrier of 21.13.4.  This header
# names the ZERO-SOURCE-ARGUMENT shape, which is the one this kernel calls today.
#
# WHAT IS ACTUALLY MISSING, corrected 2026-09-18 (the earlier note here blamed an encoding that
# is not the blocker, and cited `OPEN_POINTS.txt`, which is NOT in this tree -- that file lives
# only in the frozen project's worktrees):
#
#   * the ORDER of the arguments is settled, not open: spec 518 -- the signature "begins with
#     reserved `Lmx *node` and lists declared/dynamic values in DETERMINISTIC ORDER";
#   * `sig` is a DISPATCH contract, not a call contract: "Exact callable sig is a separate method
#     contract (SPEC 21.8); this table neither encodes it nor blocks method dispatch"
#     (OPEN_POINTS.txt, frozen tree).  So the call mechanics do not wait for the `sig` encoding --
#     the CALLER (the translator) knows its own argument order, because it wrote the signature.
#
# ADMISSION IS DECIDED, and decided AGAINST for this stage -- Mikhail, 2026-09-18, verbatim:
# "сверок на данном этапе надо не больше чем в Си. Так как полная типизация будет делаться
# отдельно".  So there is NO signature check here: like C, the call goes through the loaded
# child[0] descriptor's METHOD target and its typed `addr`, and matching the signature to the call
# site is the TRANSLATOR's business, because the translator is what wrote both.  Full typing is a
# separate, later effort; `sig` stays what it is (the dispatch contract of 21.8) and nothing here
# decodes it.
# Host/root entries that are not graph callables may still use the one-node shape below.
fnptr: LmxCallEntry (@: Lmx node) int
# Descriptor-backed native entry. Source `node` stays first and is the lexical space above the
# method; `self` is the selected physical occurrence and is the home for own-field
# load/dirty publication.  Declared, dynamic and explicit arguments follow these two references.
fnptr: LmxCallEntrySelf (@: Lmx node; @: Lmx self) int

define: LMX_CALL_OK 0
define: LMX_CALL_INVALID 1
# Not callable: not a Structure, no physical child[0], or a child[0] value outside the
# LmxCallable address range (including a bare METHOD).
define: LMX_CALL_NOT_CALLABLE 2

prototype:
    # Is this value a callable occurrence?  The answer is the structure's own shape, asked of the
    # arena's index.
    fn: lmx_call_ready (@: LmxArena arena; @: Lmx callable) int
    # The shared method record of a callable: what holds {addr, sig}.  Null when the value is not
    # a callable occurrence.
    fn: lmx_call_method (@: LmxArena arena; @: Lmx callable) @: LmxMethod
    # The reserved source `node` of a call on this callable: the lexical space above the method.
    # For the selected method occurrence M this is M.parent; nested bodies inside M have their
    # own structural parent chain and do not change the activation's reserved `node`.
    fn: lmx_call_node (@: Lmx callable) @: Lmx
    # The call, for the zero-source-argument shape.  child[0] must be an LmxCallable descriptor;
    # the call uses the `(node,self)` ABI.
    fn: lmx_call0 (@: LmxArena arena; @: Lmx callable) int
    # The LmxCallable in child[0], or null when the node is not a callable occurrence.
    fn: lmx_call_callable (@: LmxArena arena; @: Lmx node) @: LmxCallable
end: prototype
