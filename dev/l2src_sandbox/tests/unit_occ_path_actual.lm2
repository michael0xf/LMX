# Bare and transparently grouped paths select other's occurrence, not task's.
# Two transports leave the calls to the formal: hits20. An explicit path call then takes hits to30.
# The argument contract never turns that explicit call back into a reference.
int: hits 0

sub: task ()
    node\hits: node\hits + 1
end: task

sub: other ()
    node\hits: node\hits + 10
end: other

Holder:
    fn: other
end: Holder

fn: recv (task: f) int
    f()
    return: 0
end: recv

fn: check () int
    recv(Holder\other)
    if: node\hits != 10
        return: 1
    recv((Holder\other))
    if: node\hits != 20
        return: 2
    Holder\other()
    if: node\hits != 30
        return: 3
    return: 7
end: check

sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
