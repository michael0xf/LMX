fn: l1_fn_add_throw (int: fn_i; int: code) int
    @@: fn_th_cell int (cast: (@@: int) (@ c.l1_fn_th))
    @@: fn_thn_cell int (cast: (@@: int) (@ c.l1_fn_thn))
    @: fnn_cell int (cast: (@: int) (@ c.l1_fnn))
    int: n
    int: j 0
    if: fn_i < 0 || fn_i >= fnn_cell[0] || code = 0
        return: (cast: (int) (1))
    n: fn_thn_cell[0][fn_i]
    while: j < n
        if: fn_th_cell[0][fn_i * 8 + j] = code
            return: (cast: (int) (0))
        j: j + 1
    if: n >= 8
        return: (cast: (int) (1))
    fn_th_cell[0][fn_i * 8 + n]: code
    fn_thn_cell[0][fn_i]: n + 1
    return: (cast: (int) (0))
end: l1_fn_add_throw

