# K03 NS-ROLES-2 (Codex K03-NS-ROLES-2-20261007-20; docs/LMX_semantics.en.md#resolved-head-consumption,
# #declaration-visibility): a named Structure's body takes the common roles of the root and a method.
# For absent box, `box: Model` in Host's body binds box to Model -- a reference cell of Host's, no copy, no reparent:
# a write through Host\box is a write of Model, at the root and in a method.  Exit 7; 81/82 if a write did not reach
# Model (box a copy), 83 if box's cell were Model's own.
Model:
    int: v 1
end: Model
Host:
    int: n 0
    box: Model
end: Host
Host\box\v: 5
fn: m () int
    if: Model\v != 5
        return: 81
    Host\box\v: 6
    if: Model\v != 6
        return: 82
    if: @Host\box = @Model
        return: 83
    return: 7
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
