predef: "l3_interp/l3_thread.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_call.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_manager.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_gc.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_clock.lm1"
predef: "l2src/lmx_scratch.lm1"
predef: "l2src/lmx_walk.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# Mail primitives through l3_thread_dispatch. t2 lives in its own arena and may import
# the first Thread's sealed exact-profile ranges as non-owning views.
# Slot 2 is success: IF mail_count(INBOX)>0 then take (observed by address) then success.
#
# WHAT TAKE HANDS BACK IS LOOKED AT (FABLE-L3-MAIL-PROOF-20260921-63).  A take at statement level
# throws its result away, and a take that handed out nothing, or a fresh record instead of the
# letter, used to pass every check here.  The walk of this slice has no reference assignment (own
# and put are int), so the result is given to a test-local primitive, `sink_letter`, as the
# operand of a second PRIM node: it receives the very reference take produced and remembers the
# ADDRESS.  The test compares that address with the letter it delivered -- never a value read
# through it, which a faithful copy would reproduce, and never a ring slot, whose address does
# not survive the growth of the ring.
#
# The second test-local record carries the REAL mail-count fn with a FOREIGN owner (t2): it is
# what reaches the owner guard of l3_prim_lane, which no record made by l3_thread_bind can.

@: LmxArena gb 0
@: Lmx groles 0
int: broken 0
int: native_hits 0
@: Lmx sink_rec 0
@: Lmx foreign_rec 0
@: void sunk_last 0
int: sunk_n 0

sub: fail (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: fail

fn: native_noop (@: Lmx node) int
    native_hits: native_hits + 1
return: 0

fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(gb, groles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(gb, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

sub: ref (@: Lmx code; size_t: slot; @: Lmx target)
    if: code = 0 || target = 0 || lmx_arena_ref_store(code, slot, (cast: (@: void) target)) != 0
        broken: broken + 1
    ---
end: ref

fn: lit (@: Lmx parent; size_t: slot; int: value) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_LIT, 2U)
    if: n != 0 && lmx_walk_store_int(gb, n, 1U, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
return: n

fn: own (@: Lmx parent; size_t: slot; @: Lmx holder; size_t: index) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_OWN, 3U)
    ref(n, 1U, holder)
    if: n = 0 || lmx_walk_store_size(gb, n, 2U, index) != c.LMX_WALK_OK
        broken: broken + 1
    ---
return: n

sub: icell (@: Lmx holder; size_t: slot; int: value)
    if: holder = 0 || lmx_walk_store_int(gb, holder, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: icell

fn: field (@: Lmx m; size_t: slot) int
    @: void cell lmx_arena_ref_value(m, slot)
    if: cell = 0
        return: -999
return: lmx_int_value_known(cell)

fn: mk_int (@: LmxArena a; int: v) @: void
    @: Lmx n lmx_node_new_owned(a)
    if: n = 0 || lmx_arena_refs_open_owned(a, n, 1U) != 0
        return: 0
    if: lmx_walk_store_int(a, n, 0U, v) != c.LMX_WALK_OK
        return: 0
return: lmx_arena_ref_value(n, 0U)

# k.4 (c.3): a plain occurrence, slot 0 reserved/unused.
fn: mk_m (size_t: children) @: Lmx
    @: Lmx unit lmx_node_new_owned(gb)
    @: Lmx m 0
    if: unit = 0 || lmx_arena_refs_open_owned(gb, unit, 1U) != 0
        broken: broken + 1
        return: 0
    ---
    m: lmx_walk_plain(gb, unit, children)
    if: m = 0 || lmx_arena_ref_store(unit, 0U, (cast: (@: void) m)) != 0
        broken: broken + 1
        return: 0
    ---
return: m

fn: mk_dummy (@: LmxArena a) @: Lmx
    @: Lmx m lmx_node_new_owned(a)
    if: m = 0 || lmx_arena_refs_open_owned(a, m, 1U) != 0
        return: 0
return: m

fn: mk_thread (@: LmxArena arena; @: Lmx graph; @@: LmxThread out_t) int
    @: LmxThread t
    @: LmxPost mail
    @: LmxSchedule sched
    \out_t: 0
    t: (cast: (@: LmxThread) lmx_arena_take(arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD))
    mail: (cast: (@: LmxPost) lmx_arena_take(arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    sched: (cast: (@: LmxSchedule) lmx_arena_take(arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: t = 0 || mail = 0 || sched = 0
        return: 0
    if: lmx_post_init(arena, mail) != c.LMX_POST_OK || lmx_schedule_init(sched, arena, (cast: (@: void) t), 1000U) != c.LMX_SCHEDULE_OK
        return: 0
    if: lmx_thread_init(arena, t, graph, mail, sched) != c.LMX_THREAD_OK
        return: 0
    \out_t: t
return: 1

fn: mk_count () @: Lmx
    @: Lmx m mk_m(3U)
    @: Lmx n 0
    @: Lmx p 0
    @: Lmx rec l3_thread_mail_count_prim(l3_bound_t)
    icell(m, 1U, -1)
    n: fr(m, 2U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, m, 1U)
    p: fr(n, 2U, c.LMX_WALK_OP_PRIM, 3U)
    ref(p, 1U, rec)
    lit(p, 2U, c.LMX_POST_INBOX)
return: m

fn: mk_take () @: Lmx
    @: Lmx m mk_m(2U)
    @: Lmx p 0
    @: Lmx rec l3_thread_mail_take_prim(l3_bound_t)
    p: fr(m, 1U, c.LMX_WALK_OP_PRIM, 3U)
    ref(p, 1U, rec)
    lit(p, 2U, c.LMX_POST_INBOX)
return: m

fn: mk_bad_arity () @: Lmx
    @: Lmx m mk_m(2U)
    @: Lmx p 0
    @: Lmx rec l3_thread_mail_count_prim(l3_bound_t)
    p: fr(m, 1U, c.LMX_WALK_OP_PRIM, 2U)
    ref(p, 1U, rec)
return: m

fn: mk_impostor () @: Lmx
    @: Lmx m mk_m(2U)
    @: Lmx p 0
    @: Lmx fake lmx_node_new_owned(gb)
    p: fr(m, 1U, c.LMX_WALK_OP_PRIM, 3U)
    ref(p, 1U, fake)
    lit(p, 2U, c.LMX_POST_INBOX)
return: m

fn: mk_impostor_success () @: Lmx
    @: Lmx m mk_m(2U)
    @: Lmx p 0
    @: Lmx fake lmx_node_new_owned(gb)
    p: fr(m, 1U, c.LMX_WALK_OP_PRIM, 2U)
    ref(p, 1U, fake)
return: m

# IF 0 < mail_count(INBOX) then { sink(take); success }. Empty inbox leaves success=0.
fn: mk_worker () @: Lmx
    @: Lmx m mk_m(2U)
    @: Lmx n 0
    @: Lmx e 0
    @: Lmx p 0
    @: Lmx q 0
    @: Lmx body 0
    @: Lmx count_rec l3_thread_mail_count_prim(l3_bound_t)
    @: Lmx take_rec l3_thread_mail_take_prim(l3_bound_t)
    @: Lmx success_rec l3_thread_success_prim(l3_bound_t)
    n: fr(m, 1U, c.LMX_WALK_OP_IF, 3U)
    e: fr(n, 1U, c.LMX_WALK_OP_LT, 3U)
    lit(e, 1U, 0)
    p: fr(e, 2U, c.LMX_WALK_OP_PRIM, 3U)
    ref(p, 1U, count_rec)
    lit(p, 2U, c.LMX_POST_INBOX)
    body: pl(n, 2U, 2U)
    p: fr(body, 0U, c.LMX_WALK_OP_PRIM, 3U)
    ref(p, 1U, sink_rec)
    q: fr(p, 2U, c.LMX_WALK_OP_PRIM, 3U)
    ref(q, 1U, take_rec)
    lit(q, 2U, c.LMX_POST_INBOX)
    p: fr(body, 1U, c.LMX_WALK_OP_PRIM, 2U)
    ref(p, 1U, success_rec)
return: m

fn: mk_non_int_lane () @: Lmx
    @: Lmx m mk_m(2U)
    @: Lmx p 0
    @: Lmx n 0
    @: Lmx rec l3_thread_mail_count_prim(l3_bound_t)
    @: void sz lmx_size_new_owned(gb)
    p: fr(m, 1U, c.LMX_WALK_OP_PRIM, 3U)
    ref(p, 1U, rec)
    n: fr(p, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: n = 0 || sz = 0 || lmx_size_store_known(sz, 0U) != 0 || lmx_arena_ref_store(n, 1U, sz) != 0
        broken: broken + 1
        return: 0
    ---
return: m

# A physical LmxPrimitiveEntry of the TEST: one operand, the reference a nested node produced.
# It keeps the address and hands the same reference on.  An absent reference is 0 and is not a
# failure: an empty inbox is business, not an error.
fn: sink_letter (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    \out: 0
    if: owner = 0 || nargs != 1U || refs = 0 || dest = 0
        return: c.LMX_PRIMITIVE_FAIL
    sunk_last: refs[0]
    sunk_n: sunk_n + 1
    \out: refs[0]
return: c.LMX_PRIMITIVE_OK

# [prim, sink, [prim, take, lane]]: the take is an OPERAND, so its result is consumed.
fn: mk_take_show () @: Lmx
    @: Lmx m mk_m(2U)
    @: Lmx p 0
    @: Lmx q 0
    @: Lmx rec l3_thread_mail_take_prim(l3_bound_t)
    p: fr(m, 1U, c.LMX_WALK_OP_PRIM, 3U)
    ref(p, 1U, sink_rec)
    q: fr(p, 2U, c.LMX_WALK_OP_PRIM, 3U)
    ref(q, 1U, rec)
    lit(q, 2U, c.LMX_POST_INBOX)
return: m

# mk_count over a GIVEN record: own n <- prim(rec, INBOX), own starts at -1.  The lane cell is
# taken from `lane_arena`, and for the foreign-owner negative that has to be the FOREIGN Thread's
# arena.  Measured: with the lane cell in the caller's arena the turn is refused even with the
# owner guard REMOVED, because l3_prim_lane next classifies the operand through the OWNER's arena
# and finds nothing there -- so that arrangement never reaches the guard.  With the cell in the
# owner's arena the classification succeeds, and the guard alone stands between t's turn and a
# read of t2's mailbox (guard removed: the turn is OK and publishes 1).
fn: mk_count_of (@: Lmx rec; @: LmxArena lane_arena) @: Lmx
    @: Lmx m mk_m(3U)
    @: Lmx n 0
    @: Lmx p 0
    @: Lmx q 0
    icell(m, 1U, -1)
    n: fr(m, 2U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, m, 1U)
    p: fr(n, 2U, c.LMX_WALK_OP_PRIM, 3U)
    ref(p, 1U, rec)
    q: fr(p, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: q = 0 || lmx_walk_store_int(lane_arena, q, 1U, c.LMX_POST_INBOX) != c.LMX_WALK_OK
        broken: broken + 1
    ---
return: m

fn: run_graph (@: LmxThread t; @: Lmx m) int
    @: LmxMsg msg lmx_thread_message(t)
    int: st
    if: t = 0 || m = 0 || msg = 0
        return: -1
    msg\graph: m
    st: lmx_thread_turn(t, 0, 1U)
    groles: l3_thread_roles(t)
    if: groles = 0
        return: -1
    ---
return: st

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: arena
    LmxArena: t2_arena
    @: LmxArena a 0
    @: LmxArena a2 0
    @: Lmx dummy 0
    @: Lmx dummy2 0
    @: LmxThread t 0
    @: LmxThread t2 0
    @: LmxMsg message 0
    @: Lmx m 0
    @: Lmx count_rec 0
    @: Lmx take_rec 0
    @: Lmx success_rec 0
    @: Lmx count_again 0
    @: Lmx take_again 0
    @: Lmx success_again 0
    @: Lmx letter 0
    @: Lmx letter2 0
    @: Lmx letter3 0
    @: Lmx letter4 0
    @: Lmx foreign_letter 0
    @: Lmx test_reg 0
    @: Lmx profile 0
    @: Lmx test_profile 0
    @: void probe 0
    int: probe_before 0
    int: st 0
    if: counts = 0
        return: 2
    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ t2_arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0 || lmx_arena_open(@ t2_arena) != 0
        fputs("l3_mail_prim: arena\n", l1_stdout())
        free(counts)
        return: 2
    ---
    a: @ arena
    a2: @ t2_arena
    gb: a
    dummy: mk_dummy(a)
    dummy2: mk_dummy(a2)
    if: dummy = 0 || dummy2 = 0 || mk_thread(a, dummy, @ t) = 0 || mk_thread(a2, dummy2, @ t2) = 0
        fputs("l3_mail_prim: thread\n", l1_stdout())
        free(counts)
        return: 2
    ---
    message: lmx_thread_message(t)
    if: message = 0
        free(counts)
        return: 2
    ---
    fail(counts, lmx_thread_turn(t, native_noop, 1U) = c.LMX_THREAD_OK, "commit mode on native turn")
    fail(counts, native_hits = 1, "native ran once")
    fail(counts, l3_thread_bind(a, t) = c.LMX_THREAD_OK, "bind with mail primitives")
    groles: l3_thread_roles(t)
    count_rec: l3_thread_mail_count_prim(t)
    take_rec: l3_thread_mail_take_prim(t)
    success_rec: l3_thread_success_prim(t)
    profile: lmx_range_profile(a, (cast: (@: void) groles))
    fail(counts, groles != 0 && count_rec != 0 && take_rec != 0 && success_rec != 0 && count_rec != take_rec && count_rec != success_rec && take_rec != success_rec, "three distinct physical primitive records")
    fail(counts, profile != 0 && lmx_range_home(a, (cast: (@: void) groles)) = a && lmx_pool_is_sealed(lmx_range_pool(a, (cast: (@: void) groles))) != 0, "roles live in a sealed owner-arena profile")
    fail(counts, lmx_range_home(a, (cast: (@: void) count_rec)) = a && lmx_range_profile(a, (cast: (@: void) count_rec)) = profile && lmx_pool_is_sealed(lmx_range_pool(a, (cast: (@: void) count_rec))) != 0, "count record has the exact sealed profile")
    fail(counts, lmx_range_home(a, (cast: (@: void) take_rec)) = a && lmx_range_profile(a, (cast: (@: void) take_rec)) = profile, "take record has the same owner and profile")
    fail(counts, lmx_range_home(a, (cast: (@: void) success_rec)) = a && lmx_range_profile(a, (cast: (@: void) success_rec)) = profile, "success record has the same owner and profile")
    fail(counts, lmx_range_import_profile(a2, a, profile) = 0 && lmx_range_home(a2, (cast: (@: void) count_rec)) = a && lmx_range_pool(a2, (cast: (@: void) count_rec)) = 0, "second Thread arena imports an owner-preserving exact-profile view")
    fail(counts, l3_thread_bind(a, t) = c.LMX_THREAD_OK, "repeated bind of the same Thread")
    count_again: l3_thread_mail_count_prim(t)
    take_again: l3_thread_mail_take_prim(t)
    success_again: l3_thread_success_prim(t)
    fail(counts, count_again = count_rec && take_again = take_rec && success_again = success_rec, "repeated bind reuses record identities")
    fail(counts, l3_thread_bind(a2, t2) = c.LMX_THREAD_INVALID, "second Thread is refused without changing the owner binding")
    fail(counts, l3_thread_mail_count_prim(t2) = 0 && l3_thread_mail_count_prim(t) = count_rec && l3_thread_success_prim(t2) = 0 && l3_thread_success_prim(t) = success_rec, "the refusal assigned nothing")

    m: mk_count()
    fail(counts, broken = 0 && m != 0, "count graph")
    fail(counts, run_graph(t, m) = c.LMX_THREAD_OK, "empty inbox count turn")
    fail(counts, field(m, 1U) = 0, "empty inbox count is business zero")
    fail(counts, native_hits = 1, "count did not call native")

    # THREE distinct arena-backed letters.  The ring opens at LMX_POST_INBOX_MIN_CAPACITY, so the
    # third admission makes it grow; what must survive the growth is the LETTER's address, and
    # that is all this test ever holds -- no ring slot is read or remembered here.
    letter: (cast: (@: Lmx) lmx_arena_take(a, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
    letter2: (cast: (@: Lmx) lmx_arena_take(a, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
    letter3: (cast: (@: Lmx) lmx_arena_take(a, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
    if: letter = 0 || letter2 = 0 || letter3 = 0
        fputs("l3_mail_prim: letter\n", l1_stdout())
        free(counts)
        return: 2
    ---
    fail(counts, letter != letter2 && letter2 != letter3 && letter != letter3, "three distinct letters")
    fail(counts, 3U > c.LMX_POST_INBOX_MIN_CAPACITY, "three letters exceed the capacity the ring opens with, so it must grow")
    fail(counts, lmx_thread_mail_accept(a, t, (cast: (@: void) letter), c.LMX_POST_INBOX) = c.LMX_POST_OK, "deliver the first letter")
    fail(counts, lmx_thread_mail_accept(a, t, (cast: (@: void) letter2), c.LMX_POST_INBOX) = c.LMX_POST_OK, "deliver the second letter")
    fail(counts, lmx_thread_mail_accept(a, t, (cast: (@: void) letter3), c.LMX_POST_INBOX) = c.LMX_POST_OK, "deliver the third letter: the ring grows")
    fail(counts, lmx_thread_mail_count(t, c.LMX_POST_INBOX) = 3U, "three letters wait in the inbox")
    m: mk_count()
    fail(counts, run_graph(t, m) = c.LMX_THREAD_OK, "count after delivery")
    fail(counts, field(m, 1U) = 3, "count is 3 after delivery")

    # The instrument first: the request IS pending, or "cancelled" below would say nothing.
    m: mk_bad_arity()
    probe: mk_int(a, 1)
    probe_before: lmx_range_classify(a, probe)
    fail(counts, run_graph(t, m) = c.LMX_THREAD_INVALID, "wrong arity is a failed turn")
    fail(counts, probe != 0 && probe_before = c.LMX_KIND_PRIMITIVE && lmx_range_classify(a, probe) = c.LMX_KIND_NONE, "wrong arity: the boundary still ran")
    # Two facts, two checks.  The CURRENT mode does not move while a request is merely pending, so
    # it cannot show a cancellation; the REQUESTED mode can, and it is what a later good boundary
    # would otherwise commit.
    fail(counts, native_hits = 1, "wrong arity did not call native")
    m: mk_count()
    fail(counts, run_graph(t, m) = c.LMX_THREAD_OK, "later interpreted turn still runs")
    fail(counts, field(m, 1U) = 3, "count still 3 after the failed turn")

    m: mk_non_int_lane()
    probe: mk_int(a, 1)
    probe_before: lmx_range_classify(a, probe)
    fail(counts, run_graph(t, m) = c.LMX_THREAD_INVALID, "non-int lane is a failed turn")
    fail(counts, probe != 0 && probe_before = c.LMX_KIND_PRIMITIVE && lmx_range_classify(a, probe) = c.LMX_KIND_NONE, "non-int lane: the boundary still ran")
    fail(counts, native_hits = 1, "non-int lane did not call native")

    m: mk_impostor()
    probe: mk_int(a, 1)
    probe_before: lmx_range_classify(a, probe)
    st: run_graph(t, m)
    fail(counts, broken = 0 && st = c.LMX_THREAD_INVALID, "impostor record is a failed turn")
    fail(counts, probe != 0 && probe_before = c.LMX_KIND_PRIMITIVE && lmx_range_classify(a, probe) = c.LMX_KIND_NONE, "impostor: the boundary still ran")
    fail(counts, native_hits = 1, "impostor did not call native")

    # The test's own primitive family uses another ordinary physical profile in the same
    # owner arena.  It too is complete and sealed before its records enter a graph.
    test_profile: l3_profile_open(a)
    test_reg: l3_primitive_registry_open_profiled(a, 2U, test_profile)
    sink_rec: l3_primitive_register_profiled(a, test_reg, 0U, sink_letter, (cast: (@: Lmx) t), test_profile)
    foreign_rec: l3_primitive_register_profiled(a, test_reg, 1U, l3_prim_mail_count, (cast: (@: Lmx) t2), test_profile)
    fail(counts, test_profile != 0 && test_reg != 0 && sink_rec != 0 && foreign_rec != 0 && l3_profile_seal(a, test_profile) = 0, "test primitive profile completed and sealed")
    fail(counts, lmx_range_profile(a, (cast: (@: void) sink_rec)) = test_profile && lmx_pool_is_sealed(lmx_range_pool(a, (cast: (@: void) sink_rec))) != 0, "sink record is physically profiled")
    fail(counts, lmx_range_profile(a, (cast: (@: void) foreign_rec)) = test_profile, "foreign-owner record shares that exact profile")

    # THE OWNER GUARD (l3_prim_lane).  t2 holds one letter, t holds three.  A record whose owner
    # is not the bound Thread must not be served at all: without the guard this turn succeeds
    # and publishes 1 -- a FOREIGN Thread's mailbox read from t's turn.
    foreign_letter: (cast: (@: Lmx) lmx_arena_take(a2, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
    fail(counts, foreign_letter != 0 && lmx_thread_mail_accept(a2, t2, (cast: (@: void) foreign_letter), c.LMX_POST_INBOX) = c.LMX_POST_OK, "one letter in the foreign Thread's inbox")
    m: mk_count_of(foreign_rec, a2)
    probe: mk_int(a, 1)
    probe_before: lmx_range_classify(a, probe)
    fail(counts, broken = 0 && m != 0 && run_graph(t, m) = c.LMX_THREAD_INVALID, "foreign-owner record is a failed turn")
    fail(counts, probe != 0 && probe_before = c.LMX_KIND_PRIMITIVE && lmx_range_classify(a, probe) = c.LMX_KIND_NONE, "foreign owner: the boundary still ran")
    fail(counts, field(m, 1U) = -1, "foreign owner: nothing was published, the own cell is still -1")
    fail(counts, lmx_thread_mail_count(t2, c.LMX_POST_INBOX) = 1U && lmx_thread_mail_count(t, c.LMX_POST_INBOX) = 3U, "foreign owner: neither mailbox was touched")
    fail(counts, native_hits = 1, "foreign owner did not call native")

    # TAKE, OBSERVED.  Three turns, FIFO, and each time the address the sink received IS the
    # letter that was delivered -- not zero, not a copy, not a fresh record.
    m: mk_take_show()
    fail(counts, broken = 0 && m != 0 && sunk_n = 0 && sunk_last = 0, "take graph; the sink has seen nothing yet")
    fail(counts, run_graph(t, m) = c.LMX_THREAD_OK, "first take turn")
    fail(counts, sunk_n = 1 && sunk_last = (cast: (@: void) letter), "first take handed out THE first letter, by address")
    fail(counts, lmx_thread_mail_count(t, c.LMX_POST_INBOX) = 2U, "two letters left")
    m: mk_take_show()
    fail(counts, run_graph(t, m) = c.LMX_THREAD_OK, "second take turn")
    fail(counts, sunk_n = 2 && sunk_last = (cast: (@: void) letter2), "second take handed out THE second letter: FIFO across the growth")
    m: mk_take_show()
    fail(counts, run_graph(t, m) = c.LMX_THREAD_OK, "third take turn")
    fail(counts, sunk_n = 3 && sunk_last = (cast: (@: void) letter3), "third take handed out THE third letter")
    fail(counts, lmx_thread_mail_count(t, c.LMX_POST_INBOX) = 0U, "inbox empty after three takes")
    fail(counts, native_hits = 1, "take did not call native")
    # An empty inbox is business, not failure: the turn is OK and the reference is absent.
    m: mk_take_show()
    fail(counts, run_graph(t, m) = c.LMX_THREAD_OK, "take on an empty inbox is a good turn")
    fail(counts, sunk_n = 4 && sunk_last = 0, "take on an empty inbox hands out no letter")
    # The statement-level take keeps working: its result is dropped, which is legal.
    m: mk_take()
    fail(counts, broken = 0 && m != 0 && run_graph(t, m) = c.LMX_THREAD_OK, "statement-level take turn")
    fail(counts, lmx_thread_mail_count(t2, c.LMX_POST_INBOX) = 1U, "the foreign inbox was never taken from")

    m: mk_impostor_success()
    probe: mk_int(a, 1)
    probe_before: lmx_range_classify(a, probe)
    st: run_graph(t, m)
    fail(counts, broken = 0 && st = c.LMX_THREAD_INVALID, "impostor success record is a failed turn")
    fail(counts, probe != 0 && probe_before = c.LMX_KIND_PRIMITIVE && lmx_range_classify(a, probe) = c.LMX_KIND_NONE, "impostor success: the boundary still ran")
    fail(counts, native_hits = 1, "impostor success did not call native")
    fail(counts, message\success = 0, "impostor success left the flag at 0")

    # Mode gone: clearing the walk hook is the old null walk hook (old interpreter slot).
    # With no walker and no host entry, call0 is a quiet empty body (NOT_CALLABLE) --
    # not a native fallback. Re-bind restores the status walker.
    lmx_call_install_walk(0)
    m: mk_count()
    fail(counts, broken = 0 && m != 0 && run_graph(t, m) = c.LMX_THREAD_OK, "cleared walker: quiet empty body, not a native fallback")
    fail(counts, native_hits = 1, "cleared walker did not call native")
    fail(counts, message\success = 0, "cleared walker left success at 0")
    fail(counts, l3_thread_bind(a, t) = c.LMX_THREAD_OK && lmx_call_walk_ready() != 0, "bind restores walk")
    groles: l3_thread_roles(t)

    m: mk_worker()
    fail(counts, broken = 0 && m != 0 && sink_rec != 0 && success_rec != 0, "worker graph")
    fail(counts, run_graph(t, m) = c.LMX_THREAD_OK, "empty-inbox worker turn")
    fail(counts, message\success = 0, "empty inbox stays success=0")
    fail(counts, sunk_n = 4 && sunk_last = 0, "empty worker did not take")
    fail(counts, native_hits = 1, "empty worker did not call native")

    # D-65 (measured, -194 к.3b): letter/letter2/letter3 were taken and shown (above) --
    # from that point their only holders are this test's own C locals and sink_letter's
    # untracked `sunk_last` global, neither a graph root lmx_gc_mark's walk ever reaches.
    # A turn boundary's own lmx_gc_collect (lmx_turn.lm1:173) runs after every run_graph
    # call above (several, between the third take and here), so by construction those
    # three letters are garbage-collected before letter4 is ever taken -- reusing one of
    # their freed, same-size (kind, type) blocks for letter4 is then the allocator doing
    # exactly what a GC'd arena is for, not a dangling reference or a double-free. The
    # address CAN legitimately coincide with a stale one (empirically, ~1/5 of runs);
    # equality here is not a defect to catch, only a fact about the pool's free-list this
    # test never controlled. What the row can still promise is that the allocation itself
    # succeeded.
    letter4: (cast: (@: Lmx) lmx_arena_take(a, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
    fail(counts, letter4 != 0, "a fourth letter")
    fail(counts, lmx_thread_mail_accept(a, t, (cast: (@: void) letter4), c.LMX_POST_INBOX) = c.LMX_POST_OK, "deliver the worker letter")
    m: mk_worker()
    fail(counts, broken = 0 && m != 0 && run_graph(t, m) = c.LMX_THREAD_OK, "worker turn with mail")
    fail(counts, sunk_n = 5 && sunk_last = (cast: (@: void) letter4), "worker take handed out THE letter, by address")
    fail(counts, message\success = 1, "worker set success")
    fail(counts, lmx_thread_mail_count(t, c.LMX_POST_INBOX) = 0U, "worker emptied the inbox")
    fail(counts, native_hits = 1, "worker did not call native")
    fail(counts, lmx_thread_mail_count(t2, c.LMX_POST_INBOX) = 1U, "the foreign inbox stayed untouched")

    if: counts[1] != 0
        c.printf("%d failed of %d\n", counts[1], counts[0])
        free(counts)
        return: 1
    ---
    c.printf("l3_mail_prim: %d checks\n", counts[0])
    free(counts)
return: 0
