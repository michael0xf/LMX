# Ordinary L2 expression, declaration and header-field emitters for L1-to-C.
# The local address views use inherited compiler cells, not copied state.
predef: "l1src/p0.h.lm1"
predef: "l1src/l1_backend_scratch.h.lm1"
predef: "l2src/l1_backend_text.h.lm1"
predef: "l2src/l1_backend_state_helpers.h.lm1"
include: "<stddef.h>" "<stdio.h>" "<stdlib.h>" "<string.h>"

# Original: l1src/l1trans.lm1:1278
fn: l1_emit_call_frame (@: out c.FILE; const: (@: frame c.LmP0Frame); const: (@: path char); const: (@: source_node c.LmP0Node)) int
    @: throw_ok_cell int (cast: (@: int) (@ c.l1_throw_ok))
    size_t: deref
    size_t: slash
    int: deref_call_wrap 0
    const: (@: head c.LmP0Text)
    if: frame = 0
        return: (cast: (int) (1))
    head: frame\head
    if: c.l1_fn_is_throwing(head) != 0
        if: throw_ok_cell[0] = 0
            return: (cast: (int) (c.l1_error(path, source_node, "throwing call must be a statement or the entire assignment")))
        throw_ok_cell[0]: 0
    ---
    deref: c.l1_slash_prefix_len(head)
    if: deref = 0U
        if: c.l1_c_ident(out, head, path, source_node) != 0
            return: (cast: (int) (1))
        ---
    else:
        slash: deref
        while: slash < head\length && head\data[slash] != 92
            slash: slash + 1U
        if: slash < head\length
            if: c.l1_emit_prefixed_path(out, head, deref, path, source_node) != 0
                return: (cast: (int) (1))
            ---
        else:
            if: deref = head\length
                return: (cast: (int) (c.l1_error(path, source_node, "prefix dereference expects an operand")))
            if: c.l1_emit_stars(out, deref) != 0 || c.l1_write_cstr(out, "(") != 0
                return: (cast: (int) (1))
            if: c.l1_c_ident_from(out, head, deref, path, source_node) != 0
                return: (cast: (int) (1))
            deref_call_wrap: 1
        ---
    ---
    if: c.l1_write_cstr(out, "(") != 0
        return: (cast: (int) (1))
    if: l1_emit_arg_list(out, (cast: (const: @: c.LmP0Structure) (frame\body)), path) != 0
        return: (cast: (int) (1))
    if: c.l1_write_cstr(out, ")") != 0
        return: (cast: (int) (1))
    if: deref_call_wrap != 0
        return: (cast: (int) (c.l1_write_cstr(out, ")")))
    return: (cast: (int) (0))
end: l1_emit_call_frame

# Original: l1src/l1trans.lm1:1369
fn: l1_emit_assign_index (@: out c.FILE; const: (@: data char); size_t: n; const: (@: path char); const: (@: source_node c.LmP0Node)) int
    @: document c.LmP0Document 0
    const: (@: root c.LmP0Node)
    int: status
    if: data = 0 || n = 0U
        return: (cast: (int) (c.l1_error(path, source_node, "assignment target index must not be empty")))
    status: c.lm_p0_parse_bytes((cast: (const: @: char) (data)), (cast: (size_t) (n)), (cast: (@@: c.LmP0Document) (@ document)))
    if: status != 0 || document = 0
        if: document != 0
            c.lm_p0_document_destroy((cast: (@: c.LmP0Document) (document)))
        return: (cast: (int) (c.l1_error(path, source_node, "assignment target index parse failed")))
    root: c.lm_p0_document_root((cast: (const: @: c.LmP0Document) (document)))
    if: root = 0 || root\kind != c.LM_P0_NODE_STRUCTURE || root\as = 0 || root\as\structure = 0 || root\as\structure\first_field = 0
        c.lm_p0_document_destroy((cast: (@: c.LmP0Document) (document)))
        return: (cast: (int) (c.l1_error(path, source_node, "assignment target index must not be empty")))
    status: l1_emit_expr(out, (cast: (const: @: c.LmP0Structure) (root\as\structure)), path, 0)
    c.lm_p0_document_destroy((cast: (@: c.LmP0Document) (document)))
    return: (cast: (int) (status))
end: l1_emit_assign_index

# Original: l1src/l1trans.lm1:1388
fn: l1_emit_assign_head (@: out c.FILE; const: (@: head c.LmP0Text); const: (@: path char); const: (@: source_node c.LmP0Node)) int
    size_t: start 0U
    size_t: deref 0U
    size_t: root_start
    size_t: root_end
    size_t: i
    size_t: close_index
    size_t: field_end
    size_t: c_prefix 0U
    size_t: name_start
    size_t: name_end
    if: out = 0 || head = 0 || head\data = 0
        return: (cast: (int) (1))
    while: c_prefix < head\length && head\data[c_prefix] = 92
        c_prefix: c_prefix + 1U
    if: c_prefix + 2U <= head\length && head\data[c_prefix] = 99 && head\data[c_prefix + 1U] = 46
        start: c_prefix + 2U
    if: start != 0U
        if: c_prefix != 0U && (c.l1_write_cstr(out, "(") != 0 || c.l1_emit_stars(out, c_prefix) != 0)
            return: (cast: (int) (1))
        i: start
        while: i < head\length
            if: head\data[i] = 91
                if: c.l1_assign_index_close(head, i, @ close_index) = 0
                    return: (cast: (int) (c.l1_error(path, source_node, "unclosed index in assignment target")))
                if: c.l1_write_cstr(out, "[") != 0 || l1_emit_assign_index(out, (cast: (const: @: char) (head\data + i + 1U)), close_index - i - 1U, path, source_node) != 0 || c.l1_write_cstr(out, "]") != 0
                    return: (cast: (int) (1))
                i: close_index + 1U
                continue
            if: head\data[i] = 92
                if: c.l1_write_cstr(out, "->") != 0
                    return: (cast: (int) (1))
                ---
            else:
                if: c.l1_write_span(out, (cast: (const: @: char) (head\data + i)), 1U) != 0
                    return: (cast: (int) (1))
                ---
            i: i + 1U
        if: c_prefix != 0U && c.l1_write_cstr(out, ")") != 0
            return: (cast: (int) (1))
        return: (cast: (int) (0))
    ---
    while: start + deref < head\length && head\data[start + deref] = 92
        deref: deref + 1U
    root_start: start + deref
    root_end: root_start
    while: root_end < head\length && head\data[root_end] != 92 && head\data[root_end] != 91
        root_end: root_end + 1U
    if: root_end = root_start
        return: (cast: (int) (c.l1_error(path, source_node, "dereferenced assignment target expects a name")))
    # A quoted root name is quoted exactly so that it may BE a reserved word,
    # and the quotes are not part of the C identifier. The whole-text rule in
    # l1_c_ident_from does not reach here: this root is a span inside a head
    # that may continue with a field follow or an index, so the continuation
    # position stays root_end while only the written span loses its quotes.
    name_start: root_start
    name_end: root_end
    if: root_end - root_start >= 2U && head\data[root_start] = 96 && head\data[root_end - 1U] = 96
        name_start: root_start + 1U
        name_end: root_end - 1U
    else:
        if: c.l1_span_is_reserved((cast: (const: @: char) (head\data)), root_start, root_end - root_start) != 0
            return: (cast: (int) (c.l1_error(path, source_node, "reserved L1 name")))
        ---
    ---
    if: deref != 0U
        if: c.l1_write_cstr(out, "(") != 0 || c.l1_emit_stars(out, deref) != 0
            return: (cast: (int) (1))
        ---
    ---
    if: c.l1_write_span(out, (cast: (const: @: char) (head\data + name_start)), name_end - name_start) != 0
        return: (cast: (int) (1))
    if: deref != 0U && c.l1_write_cstr(out, ")") != 0
        return: (cast: (int) (1))
    i: root_end
    while: i < head\length
        if: head\data[i] = 91
            if: c.l1_assign_index_close(head, i, @ close_index) = 0
                return: (cast: (int) (c.l1_error(path, source_node, "unclosed index in assignment target")))
            if: c.l1_write_cstr(out, "[") != 0
                return: (cast: (int) (1))
            if: l1_emit_assign_index(out, (cast: (const: @: char) (head\data + i + 1U)), close_index - i - 1U, path, source_node) != 0
                return: (cast: (int) (1))
            if: c.l1_write_cstr(out, "]") != 0
                return: (cast: (int) (1))
            ---
            i: close_index + 1U
            continue
        ---
        if: head\data[i] != 92
            return: (cast: (int) (c.l1_error(path, source_node, "malformed assignment target")))
        if: c.l1_write_cstr(out, "->") != 0
            return: (cast: (int) (1))
        i: i + 1U
        field_end: i
        while: field_end < head\length && head\data[field_end] != 92 && head\data[field_end] != 91
            field_end: field_end + 1U
        if: field_end = i
            return: (cast: (int) (c.l1_error(path, source_node, "field-follow missing name")))
        if: c.l1_span_is_reserved((cast: (const: @: char) (head\data)), i, field_end - i) != 0
            return: (cast: (int) (c.l1_error(path, source_node, "reserved L1 name")))
        if: c.l1_write_span(out, (cast: (const: @: char) (head\data + i)), field_end - i) != 0
            return: (cast: (int) (1))
        i: field_end
    return: (cast: (int) (0))
end: l1_emit_assign_head

# Original: l1src/l1trans.lm1:1507
fn: l1_emit_expr (@: out c.FILE; const: (@: body c.LmP0Structure); const: (@: path char); int: as_cond) int
    @: field c.LmP0Field
    const: (@: source_node c.LmP0Node)
    const: (@: next_node c.LmP0Node)
    const: (@: prev_node c.LmP0Node 0)
    int: first 1
    int: after_operand 0
    int: deref_wrap 0
    int: skip_space 0
    if: out = 0
        return: (cast: (int) (1))
    if: body = 0
        return: (cast: (int) (0))
    field: body\first_field
    while: field != 0
        source_node: field\value
        if: c.l1_node_ignored(source_node) = 0
            if: after_operand != 0
                while: deref_wrap != 0
                    if: c.l1_write_cstr(out, ")") != 0
                        return: (cast: (int) (1))
                    deref_wrap: deref_wrap - 1
                ---
            ---
            if: first = 0
                if: prev_node != 0 && source_node != 0 && prev_node\kind = c.LM_P0_NODE_ATOM && source_node\kind = c.LM_P0_NODE_ATOM && c.l1_nodes_adjacent(prev_node, source_node) && c.l1_glue_pair((cast: (const: @: c.LmP0Text) (prev_node\as\atom)), (cast: (const: @: c.LmP0Text) (source_node\as\atom)))
                    if: c.l1_write_text(out, (cast: (const: @: c.LmP0Text) (source_node\as\atom))) != 0
                        return: (cast: (int) (1))
                    ---
                    prev_node: source_node
                    first: 0
                    field: field\next
                    continue
                ---
                skip_space: 0
                if: source_node != 0 && source_node\kind = c.LM_P0_NODE_ATOM
                    if: c.l1_text_eq((cast: (const: @: c.LmP0Text) (source_node\as\atom)), "[") || c.l1_text_eq((cast: (const: @: c.LmP0Text) (source_node\as\atom)), "]")
                        skip_space: 1
                    ---
                    if: c.l1_is_incdec_atom((cast: (const: @: c.LmP0Text) (source_node\as\atom))) && after_operand != 0
                        skip_space: 1
                    ---
                ---
                if: prev_node != 0 && prev_node\kind = c.LM_P0_NODE_ATOM
                    if: c.l1_text_eq((cast: (const: @: c.LmP0Text) (prev_node\as\atom)), "[")
                        skip_space: 1
                    ---
                    if: c.l1_is_incdec_atom((cast: (const: @: c.LmP0Text) (prev_node\as\atom))) && source_node != 0 && source_node\kind = c.LM_P0_NODE_ATOM
                        if: c.l1_is_infix_atom((cast: (const: @: c.LmP0Text) (source_node\as\atom))) = 0 && c.l1_is_unary_prefix_atom((cast: (const: @: c.LmP0Text) (source_node\as\atom))) = 0 && c.l1_is_incdec_atom((cast: (const: @: c.LmP0Text) (source_node\as\atom))) = 0 && c.l1_text_eq((cast: (const: @: c.LmP0Text) (source_node\as\atom)), "\\") = 0 && c.l1_text_eq((cast: (const: @: c.LmP0Text) (source_node\as\atom)), "[") = 0 && c.l1_text_eq((cast: (const: @: c.LmP0Text) (source_node\as\atom)), "]") = 0
                            skip_space: 1
                        ---
                    ---
                ---
                if: skip_space = 0
                    if: c.l1_write_cstr(out, " ") != 0
                        return: (cast: (int) (1))
                    ---
                ---
            ---
            first: 0
            if: source_node = 0
                return: (cast: (int) (c.l1_error(path, 0, "empty expression field")))
            if: source_node\kind = c.LM_P0_NODE_ATOM
                next_node: 0
                if: field\next != 0
                    next_node: field\next\value
                ---
                if: c.l1_atom_is_raw_string(source_node)
                    if: c.l1_emit_atom_node(out, source_node, path) != 0
                        return: (cast: (int) (1))
                    after_operand: 1
                    prev_node: source_node
                    field: field\next
                    continue
                ---
                if: c.l1_text_eq((cast: (const: @: c.LmP0Text) (source_node\as\atom)), "\\")
                    if: after_operand != 0 && prev_node != 0 && c.l1_nodes_adjacent(prev_node, source_node) != 0
                        if: c.l1_write_cstr(out, "->") != 0
                            return: (cast: (int) (1))
                        ---
                    else:
                        if: c.l1_write_cstr(out, "(*") != 0
                            return: (cast: (int) (1))
                        deref_wrap: deref_wrap + 1
                        after_operand: 0
                        ---
                    ---
                else:
                    if: c.l1_text_eq((cast: (const: @: c.LmP0Text) (source_node\as\atom)), "[")
                        if: c.l1_write_cstr(out, "[") != 0
                            return: (cast: (int) (1))
                        after_operand: 0
                    else:
                        if: c.l1_text_eq((cast: (const: @: c.LmP0Text) (source_node\as\atom)), "]")
                            if: c.l1_write_cstr(out, "]") != 0
                                return: (cast: (int) (1))
                            after_operand: 1
                        else:
                            if: c.l1_is_incdec_atom((cast: (const: @: c.LmP0Text) (source_node\as\atom)))
                                if: c.l1_write_text(out, (cast: (const: @: c.LmP0Text) (source_node\as\atom))) != 0
                                    return: (cast: (int) (1))
                                ---
                            else:
                                if: c.l1_text_eq((cast: (const: @: c.LmP0Text) (source_node\as\atom)), "=") && (next_node = 0 || next_node\kind != c.LM_P0_NODE_ATOM || c.l1_nodes_adjacent(source_node, next_node) = 0 || c.l1_text_eq((cast: (const: @: c.LmP0Text) (next_node\as\atom)), "=") = 0)
                                    if: c.l1_write_cstr(out, "==") != 0
                                        return: (cast: (int) (1))
                                    after_operand: 0
                                else:
                                    if: c.l1_emit_atom_node(out, source_node, path) != 0
                                        return: (cast: (int) (1))
                                    if: c.l1_is_infix_atom((cast: (const: @: c.LmP0Text) (source_node\as\atom))) || c.l1_is_unary_prefix_atom((cast: (const: @: c.LmP0Text) (source_node\as\atom)))
                                        after_operand: 0
                                    else:
                                        after_operand: 1
                                    ---
                                ---
                            ---
                        ---
                    ---
                ---
                prev_node: source_node
            else:
                if: source_node\kind = c.LM_P0_NODE_FRAME
                    prev_node: source_node
                    after_operand: 1
                    if: c.l1_text_eq((cast: (const: @: c.LmP0Text) (source_node\as\frame\head)), "cast")
                        if: l1_emit_cast(out, (cast: (const: @: c.LmP0Structure) (source_node\as\frame\body)), path) != 0
                            return: (cast: (int) (1))
                        ---
                    else:
                        if: l1_emit_call_frame(out, (cast: (const: @: c.LmP0Frame) (source_node\as\frame)), path, source_node) != 0
                            return: (cast: (int) (1))
                    ---
                else:
                    if: source_node\kind = c.LM_P0_NODE_STRUCTURE
                        prev_node: source_node
                        after_operand: 1
                        if: c.l1_write_cstr(out, "(") != 0
                            return: (cast: (int) (1))
                        if: l1_emit_expr(out, (cast: (const: @: c.LmP0Structure) (source_node\as\structure)), path, as_cond) != 0
                            return: (cast: (int) (1))
                        if: c.l1_write_cstr(out, ")") != 0
                            return: (cast: (int) (1))
                        ---
                    else:
                        return: (cast: (int) (c.l1_error(path, source_node, "unsupported expression node")))
        ---
        field: field\next
    while: deref_wrap != 0
        if: c.l1_write_cstr(out, ")") != 0
            return: (cast: (int) (1))
        deref_wrap: deref_wrap - 1
    return: (cast: (int) (0))
end: l1_emit_expr

