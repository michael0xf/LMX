                return: (cast: (int) (1))
            if: (qual & 4) != 0 && lm_compiler_emit_qualify_copy(msf, merge_own, ind) != 0
                return: (cast: (int) (1))
            if: c.fprintf(out_cell[0], "%sif: lmx_merge_result_layout(l2_program_arena, l2_mresult, l2_mops, %dU, (cast: (@: void) (l2_layout_tokens + %d)), %s) != c.LMX_IMPLEMENTS_YES\n", ind, n, c.lm_compiler_schema_token_slot(c.lm_compiler_schema_merge(msf)), merge_source_token) < 0
