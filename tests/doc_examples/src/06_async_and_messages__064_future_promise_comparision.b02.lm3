FutureMessage:
    int: requestId
    int: next
    int: ready 0
    int: value 0
    @: waiters
    @: replies
    reply:
        replies\send(requestId; node\value)
    get:
        if: node\ready = 1
            reply()
            return
        waiters\push(requestId)
    resolve:
        if: node\ready = 1
            return
        node\value := next
        node\ready := 1
        while: waiters\size() > 0
            reply(waiters\pop())
