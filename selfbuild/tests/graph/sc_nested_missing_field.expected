@: result 0
D:
    int: seen 1
    Box:
        int: first 7
        int: second 9
    end: Box
    Other:
        int: first 1
        int: third 3
    end: Other
    return: (int first) (int second)
    C:
        :=: (node \ seen) 1
        return: (node \ Other)
    end: C
end: D
Main: (:= (node \ result) D\C())
