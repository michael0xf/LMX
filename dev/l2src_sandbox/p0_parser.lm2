                c.lm_own_delete(c.lm_own_ptr_stack_pop(stack), 0)
                continue
            p0_node: frame\field\value
            frame\field: frame\field\next
            status: (lm_p0_postprocess_push_node(stack, p0_node) = 0)
            continue
        if: (frame\phase = c.LM_P0_POSTPROCESS_TRAILER)
            if: (frame\trailer = 0)
                c.lm_own_delete(c.lm_own_ptr_stack_pop(stack), 0)
                continue
            structure: frame\trailer\body
            c.lm_own_delete(c.lm_own_ptr_stack_pop(stack), 0)
            status: (lm_p0_postprocess_push_structure(stack, structure) = 0)
            continue
        if: (frame\phase = c.LM_P0_POSTPROCESS_FRAME_WRAP)
            p0_node: frame\node
            c.lm_own_delete(c.lm_own_ptr_stack_pop(stack), 0)
            if: (((p0_node != 0) && ((p0_node\as\frame\flags & c.LM_P0_FRAME_INLINE_BODY) != 0U)) && (lm_p0_wrap_fields_from_line(document, (cast: (@: c.LmP0Structure) p0_node\as\frame\body), (cast: (size_t) p0_node\span\line), ((cast: (size_t) p0_node\span\offset) + (cast: (size_t) p0_node\span\length))) = 0))
                status: 0
            ---
            continue
        status: 0
    ---
    return: status
end: lm_p0_postprocess_run

# Original: parser.lm1:4103 lm_p0_postprocess_node
fn: lm_p0_postprocess_node (@: document c.LmP0Document; @: p0_node c.LmP0Node) int
    @: stack c.LmOwnPtrStack
    int: status
    if: (p0_node = 0)
        return: 1
    stack: lm_p0_postprocess_stack_new()
    if: (stack = 0)
        return: 0
    status: ((lm_p0_postprocess_push_node(stack, p0_node) = 0) && lm_p0_postprocess_run(document, stack))
    lm_p0_postprocess_stack_delete(@ stack)
    return: status
end: lm_p0_postprocess_node

# Original: parser.lm1:4116 lm_p0_wrap_fields_from_line
fn: lm_p0_wrap_fields_from_line (@: document c.LmP0Document; @: structure c.LmP0Structure; size_t: head_line; size_t: inline_event_end_offset) int
    @: field c.LmP0Field
    @: previous c.LmP0Field
    @: group_first c.LmP0Field
    @: group_node c.LmP0Node
    @: move c.LmP0Field
    previous: 0
    field: structure\first_field
    while: (field != 0)
        if: (((field\value != 0) && (field\value\span\line != head_line)) && (field\value\span\offset >= inline_event_end_offset))
            break
        previous: field
        field: field\next
    ---
    if: (field = 0)
        return: 1
    group_first: field
    group_node: lm_p0_new_node(document, c.LM_P0_NODE_STRUCTURE)
    if: (group_node = 0)
        return: 0
    group_node\span[0]: group_first\value\span[0]
    move: group_first
    while: (move != 0)
        @: next_move c.LmP0Field
        @: value c.LmP0Node
        next_move: move\next
        value: move\value
        move\value: 0
        if: (lm_p0_append_field(document, (cast: (@: c.LmP0Structure) group_node\as\structure), value) = 0)
            lm_p0_free_node(group_node)
            return: 0
        move: next_move
    ---
    group_first\value: group_node
    group_first\next: 0
    if: (previous = 0)
        structure\first_field: group_first
    else:
        previous\next: group_first
    ---
    lm_p0_structure_recount(structure)
    return: 1
end: lm_p0_wrap_fields_from_line

# Original: parser.lm1:4157 lm_p0_normalize_sole_anonymous_container
fn: lm_p0_normalize_sole_anonymous_container (@: body c.LmP0Structure) int
    @: only c.LmP0Field
    @: container c.LmP0Node
    @: inner c.LmP0Structure
    if: body = 0
        return: 1
    if: body\field_count != 1U
        return: 1
    only: body\first_field
    if: only = 0 || only\value = 0
        return: 1
    container: only\value
    if: container\kind != c.LM_P0_NODE_STRUCTURE
        return: 1
    # Flagged/marked Structures (MIX / INACTIVE / POSITIONAL_SKIP) are not plain anonymous containers.
    if: (container\flags & (c.LM_P0_NODE_INACTIVE | c.LM_P0_NODE_MIX | c.LM_P0_NODE_POSITIONAL_SKIP)) != 0U
        return: 1
    if: container\as = 0 || container\as\structure = 0
        return: 1
    inner: container\as\structure
    # Opaque / trailer-bearing Structure stays a value field (one-level sole bag).
    if: inner\trailer != 0
        return: 1
    body\first_field: inner\first_field
    body\last_field: inner\last_field
    body\field_count: inner\field_count
    inner\first_field: 0
    inner\last_field: 0
    inner\field_count: 0U
    only\value: 0
    only\next: 0
    return: 1
end: lm_p0_normalize_sole_anonymous_container

# Original: parser.lm1:4191 lm_p0_normalize_sole_anonymous_in_trailer
fn: lm_p0_normalize_sole_anonymous_in_trailer (@: trailer c.LmP0Trailer) int
    if: trailer = 0
        return: 1
    if: lm_p0_normalize_sole_anonymous_in_structure((cast: (@: c.LmP0Structure) trailer\body)) = 0
        return: 0
    return: lm_p0_normalize_sole_anonymous_container((cast: (@: c.LmP0Structure) trailer\body))
end: lm_p0_normalize_sole_anonymous_in_trailer

# Original: parser.lm1:4199 lm_p0_normalize_sole_anonymous_in_node
fn: lm_p0_normalize_sole_anonymous_in_node (@: p0_node c.LmP0Node) int
    if: p0_node = 0
        return: 1
    if: p0_node\kind = c.LM_P0_NODE_FRAME && p0_node\as != 0 && p0_node\as\frame != 0
        if: lm_p0_normalize_sole_anonymous_in_structure((cast: (@: c.LmP0Structure) p0_node\as\frame\body)) = 0
            return: 0
        if: lm_p0_normalize_sole_anonymous_container((cast: (@: c.LmP0Structure) p0_node\as\frame\body)) = 0
            return: 0
        return: lm_p0_normalize_sole_anonymous_in_trailer((cast: (@: c.LmP0Trailer) p0_node\as\frame\trailer))
    if: p0_node\kind = c.LM_P0_NODE_STRUCTURE && p0_node\as != 0
        if: lm_p0_normalize_sole_anonymous_in_structure((cast: (@: c.LmP0Structure) p0_node\as\structure)) = 0
            return: 0
        return: lm_p0_normalize_sole_anonymous_in_trailer((cast: (@: c.LmP0Trailer) p0_node\as\structure\trailer))
    return: 1
end: lm_p0_normalize_sole_anonymous_in_node

# Original: parser.lm1:4215 lm_p0_normalize_sole_anonymous_in_structure
fn: lm_p0_normalize_sole_anonymous_in_structure (@: structure c.LmP0Structure) int
    const: (@: field c.LmP0Field)
    if: structure = 0
        return: 1
    field: structure\first_field
    while: (field != 0)
        if: (lm_p0_normalize_sole_anonymous_in_node((cast: (@: c.LmP0Node) field\value)) = 0)
            return: 0
        field: field\next
    ---
    return: 1
end: lm_p0_normalize_sole_anonymous_in_structure

# Original: parser.lm1:4227 lm_p0_colon_frame_empty
fn: lm_p0_colon_frame_empty (const: (@: frame c.LmP0Frame)) int
    if: frame = 0
        return: 0
    if: (frame\flags & c.LM_P0_FRAME_COLON) = 0U
        return: 0
    if: frame\body = 0
        return: 1
    if: frame\body\field_count != 0U
        return: 0
    return: 1
end: lm_p0_colon_frame_empty

# Original: parser.lm1:4238 lm_p0_colon_trailer_empty
fn: lm_p0_colon_trailer_empty (const: (@: trailer c.LmP0Trailer)) int
    if: trailer = 0
        return: 0
    if: (trailer\flags & c.LM_P0_TRAILER_COLON) = 0U
        return: 0
    if: trailer\body = 0
        return: 1
    if: trailer\body\field_count != 0U
        return: 0
    return: 1

# Is node the atom whose bytes are name's?
end: lm_p0_colon_trailer_empty

# Original: parser.lm1:4250 lm_p0_atom_names
fn: lm_p0_atom_names (const: (@: p0_node c.LmP0Node); const: (@: name c.LmP0Text)) int
    size_t: i 0U
    if: p0_node = 0 || p0_node\kind != c.LM_P0_NODE_ATOM || p0_node\as = 0 || p0_node\as\atom = 0 || name = 0
        return: 0
    if: p0_node\as\atom\length != name\length
        return: 0
    while: i < name\length
        if: p0_node\as\atom\data[i] != name\data[i]
            return: 0
        i: i + 1U
    ---
    return: 1

# Does frame's trailer close it as its empty vertical body's explicit end -- an empty colon Frame whose tail cutter is
# `end:` with one atom naming the Frame (grammar §18: `f:` with an explicitly closed empty vertical body; `end: f`
# closes it as `---` does)?  A bare `end`, another target, or more than the name is no such closure.
end: lm_p0_atom_names

# Original: parser.lm1:4266 lm_p0_end_closes_empty_colon
fn: lm_p0_end_closes_empty_colon (const: (@: frame c.LmP0Frame)) int
    const: (@: trailer c.LmP0Trailer)
    const: (@: only c.LmP0Field)
    if: frame = 0 || lm_p0_colon_frame_empty(frame) = 0
        return: 0
    trailer: frame\trailer
    if: trailer = 0 || trailer\spelling = 0 || (trailer\flags & c.LM_P0_TRAILER_TAIL_CUTTER) = 0U || (trailer\flags & c.LM_P0_TRAILER_COLON) = 0U
        return: 0
    # The trailer keeps its word without the colon (its COLON flag holds that): `end` alone, as the role's own matcher
    # reads a bare word (lm_p0_legacy_trailer_role took `end:` from the whole line).
    if: lm_p0_text_has_prefix_name((cast: (const: @: char) trailer\spelling\data), (cast: (size_t) trailer\spelling\length), "end", 1) = 0
        return: 0
    if: trailer\body = 0 || trailer\body\field_count != 1U
        return: 0
    only: trailer\body\first_field
    if: only = 0 || only\value = 0
        return: 0
    return: lm_p0_atom_names((cast: (const: @: c.LmP0Node) only\value), (cast: (const: @: c.LmP0Text) frame\head))

# The explicit `end:` closure of empty colon Frames, through the tree: such a Frame is marked closed as the delimiter
# marks it (LM_P0_FRAME_DELIMITER_CLOSED) and keeps no trailer -- the closure is syntax, not a trailer of the value.
end: lm_p0_end_closes_empty_colon

# Original: parser.lm1:4287 lm_p0_close_empty_by_end_in_node
sub: lm_p0_close_empty_by_end_in_node (@: p0_node c.LmP0Node)
    if: p0_node = 0 || p0_node\as = 0
        return
    if: p0_node\kind = c.LM_P0_NODE_FRAME && p0_node\as\frame != 0
        if: lm_p0_end_closes_empty_colon((cast: (const: @: c.LmP0Frame) p0_node\as\frame)) != 0
            p0_node\as\frame\trailer: 0
            p0_node\as\frame\flags: p0_node\as\frame\flags | c.LM_P0_FRAME_DELIMITER_CLOSED
        ---
        lm_p0_close_empty_by_end_in_structure((cast: (@: c.LmP0Structure) p0_node\as\frame\body))
        if: p0_node\as\frame\trailer != 0
            lm_p0_close_empty_by_end_in_structure((cast: (@: c.LmP0Structure) p0_node\as\frame\trailer\body))
        ---
        return
    if: p0_node\kind = c.LM_P0_NODE_STRUCTURE && p0_node\as\structure != 0
        lm_p0_close_empty_by_end_in_structure((cast: (@: c.LmP0Structure) p0_node\as\structure))
        if: p0_node\as\structure\trailer != 0
            lm_p0_close_empty_by_end_in_structure((cast: (@: c.LmP0Structure) p0_node\as\structure\trailer\body))
        ---
    ---
end: lm_p0_close_empty_by_end_in_node

# Original: parser.lm1:4308 lm_p0_close_empty_by_end_in_structure
sub: lm_p0_close_empty_by_end_in_structure (@: structure c.LmP0Structure)
    @: field c.LmP0Field
    if: structure = 0
        return
    field: structure\first_field
    while: field != 0
        lm_p0_close_empty_by_end_in_node((cast: (@: c.LmP0Node) field\value))
        field: field\next
    ---
end: lm_p0_close_empty_by_end_in_structure

# Original: parser.lm1:4319 lm_p0_validate_nonempty_colon_frames_in_trailer
fn: lm_p0_validate_nonempty_colon_frames_in_trailer (@: document c.LmP0Document; const: (@: trailer c.LmP0Trailer)) int
    if: (trailer = 0)
        return: 1
    if: lm_p0_colon_trailer_empty(trailer) != 0 && ((trailer\flags & c.LM_P0_TRAILER_DELIMITER_CLOSED) = 0U)
        lm_p0_set_diagnostic(document, 32, 1U, 1U, "empty colon Frame is not allowed")
        return: 0
    return: lm_p0_validate_nonempty_colon_frames_in_structure(document, (cast: (const: @: c.LmP0Structure) trailer\body))
end: lm_p0_validate_nonempty_colon_frames_in_trailer

# Original: parser.lm1:4328 lm_p0_validate_nonempty_colon_frames_in_node
fn: lm_p0_validate_nonempty_colon_frames_in_node (@: document c.LmP0Document; const: (@: p0_node c.LmP0Node)) int
    size_t: line 1U
    size_t: column 1U
    if: (p0_node = 0)
        return: 1
    if: p0_node\span != 0
        line: p0_node\span\line
        column: p0_node\span\column
    ---
    if: p0_node\kind = c.LM_P0_NODE_FRAME && p0_node\as != 0 && lm_p0_colon_frame_empty((cast: (const: @: c.LmP0Frame) p0_node\as\frame)) != 0 && ((p0_node\as\frame\flags & c.LM_P0_FRAME_DELIMITER_CLOSED) = 0U)
        lm_p0_set_diagnostic(document, 32, line, column, "empty colon Frame is not allowed")
        return: 0
    if: p0_node\kind = c.LM_P0_NODE_FRAME && p0_node\as != 0 && lm_p0_colon_trailer_empty((cast: (const: @: c.LmP0Trailer) p0_node\as\frame\trailer)) != 0 && ((p0_node\as\frame\trailer\flags & c.LM_P0_TRAILER_DELIMITER_CLOSED) = 0U)
        lm_p0_set_diagnostic(document, 32, line, column, "empty colon Frame is not allowed")
        return: 0
    if: p0_node\kind = c.LM_P0_NODE_STRUCTURE && p0_node\as != 0 && lm_p0_colon_trailer_empty((cast: (const: @: c.LmP0Trailer) p0_node\as\structure\trailer)) != 0 && ((p0_node\as\structure\trailer\flags & c.LM_P0_TRAILER_DELIMITER_CLOSED) = 0U)
        lm_p0_set_diagnostic(document, 32, line, column, "empty colon Frame is not allowed")
        return: 0
    if: (p0_node\kind = c.LM_P0_NODE_FRAME)
        if: (lm_p0_validate_nonempty_colon_frames_in_structure(document, (cast: (const: @: c.LmP0Structure) p0_node\as\frame\body)) = 0)
            return: 0
        return: lm_p0_validate_nonempty_colon_frames_in_trailer(document, (cast: (const: @: c.LmP0Trailer) p0_node\as\frame\trailer))
    if: (p0_node\kind = c.LM_P0_NODE_STRUCTURE)
        if: (lm_p0_validate_nonempty_colon_frames_in_structure(document, (cast: (const: @: c.LmP0Structure) p0_node\as\structure)) = 0)
            return: 0
        return: lm_p0_validate_nonempty_colon_frames_in_trailer(document, (cast: (const: @: c.LmP0Trailer) p0_node\as\structure\trailer))
    return: 1
end: lm_p0_validate_nonempty_colon_frames_in_node

# Original: parser.lm1:4356 lm_p0_validate_nonempty_colon_frames_in_structure
fn: lm_p0_validate_nonempty_colon_frames_in_structure (@: document c.LmP0Document; const: (@: structure c.LmP0Structure)) int
    const: (@: field c.LmP0Field)
    field: structure\first_field
    while: (field != 0)
        if: (lm_p0_validate_nonempty_colon_frames_in_node(document, (cast: (const: @: c.LmP0Node) field\value)) = 0)
            return: 0
        field: field\next
    ---
    return: 1
end: lm_p0_validate_nonempty_colon_frames_in_structure

# Original: parser.lm1:4367 lm_p0_parse_bytes
fn: lm_p0_parse_bytes (const: (@: source char); size_t: source_length; @@: out_document c.LmP0Document) int
    @: document c.LmP0Document
    if: (out_document = 0)
        return: 1
    out_document[0]: 0
    document: (cast: (@: c.LmP0Document) c.lm_own_new_zero(c.sizeof(document[0])))
    if: (document = 0)
        return: 1
    if: (lm_p0_document_init_owners(document) != 0)
        c.lm_own_delete(document, 0)
        return: 1
    if: (source = 0)
        source: ""
        source_length: 0U
    ---
    document\source_length: source_length
    document\source: c.lm_own_arena_copy_bytes(document\source_owner, source, document\source_length)
    if: (document\source = 0)
        lm_p0_document_destroy_owners(document)
        c.lm_own_delete(document, 0)
        return: 1
    if: lm_p0_parse_stream(document)
        if: lm_p0_postprocess_node(document, (cast: (@: c.LmP0Node) document\root))
            lm_p0_close_empty_by_end_in_node((cast: (@: c.LmP0Node) document\root))
            if: lm_p0_validate_nonempty_colon_frames_in_node(document, (cast: (const: @: c.LmP0Node) document\root))
                lm_p0_normalize_sole_anonymous_in_node((cast: (@: c.LmP0Node) document\root))
            ---
        ---
    if: (document\diagnostic\code = 0)
        if: (c.lm_own_tree_cut(document\tree_arena) != 0)
            lm_p0_set_diagnostic(document, 1, 0U, 0U, "out of memory while promoting parser lazy text edges")
        else:
            lm_p0_document_freeze_tree(document)
        ---
    out_document[0]: document
    if: (document\diagnostic\code = 0)
        return: 0
    return: (cast: (int) document\diagnostic\code)
end: lm_p0_parse_bytes

# Original: parser.lm1:4408 lm_p0_parse_string
fn: lm_p0_parse_string (const: (@: source char); @@: out_document c.LmP0Document) int
    if: (source = 0)
        source: ""
    ---
    return: lm_p0_parse_bytes(source, c.strlen(source), out_document)
end: lm_p0_parse_string

# Original: parser.lm1:4416 lm_p0_parse_file
fn: lm_p0_parse_file (const: (@: path char); @@: out_document c.LmP0Document) int
    @: file c.FILE
    c.LmP0FileScratch: file_scratch
    @: buffer char
    size_t: read_size
    int: status
    if: (out_document = 0)
        return: 1
    out_document[0]: 0
    file: c.fopen(path, "rb")
    if: (file = 0)
        return: 1
    if: (c.fseek(file, 0, c.SEEK_END) != 0)
        c.fclose(file)
        return: 1
    file_scratch\file_size: c.ftell(file)
    if: (file_scratch\file_size < 0)
        c.fclose(file)
        return: 1
    if: (c.fseek(file, 0, c.SEEK_SET) != 0)
        c.fclose(file)
        return: 1
    buffer: (cast: (@: char) c.lm_own_new_zero(((cast: (size_t) file_scratch\file_size) + 1U)))
    if: (buffer = 0)
        c.fclose(file)
        return: 1
    read_size: c.fread(buffer, 1U, (cast: (size_t) file_scratch\file_size), file)
    c.fclose(file)
    if: (read_size != (cast: (size_t) file_scratch\file_size))
        c.lm_own_delete(buffer, 0)
        return: 1
    buffer[read_size]: '\0'
    status: lm_p0_parse_bytes(buffer, read_size, out_document)
    c.lm_own_delete(buffer, 0)
    return: status
end: lm_p0_parse_file

# Original: parser.lm1:4454 lm_p0_path_has_extension
fn: lm_p0_path_has_extension (const: (@: path char); const: (@: extension char)) int
    size_t: path_length
    size_t: extension_length
    size_t: i
    char: left
    char: right
    if: ((path = 0) || (extension = 0))
        return: 0
    path_length: c.strlen(path)
    extension_length: c.strlen(extension)
    if: (path_length < extension_length)
        return: 0
    i: 0U
    while: (i < extension_length)
        left: path[((path_length - extension_length) + i)]
        right: extension[i]
        if: ((left >= 'A') && (left <= 'Z'))
            left: (cast: (char) ((left - 'A') + 'a'))
        ---
        if: ((right >= 'A') && (right <= 'Z'))
            right: (cast: (char) ((right - 'A') + 'a'))
        ---
        if: (left != right)
            return: 0
        i: i + 1U
    ---
    return: 1
end: lm_p0_path_has_extension

# Original: parser.lm1:4481 lm_p0_document_destroy
sub: lm_p0_document_destroy (@: document c.LmP0Document)
    if: (document = 0)
        return
    if: lm_p0_document_owners_belong_to_actor(document) = 0
        return
    lm_p0_document_destroy_owners(document)
    c.lm_own_delete(document, 0)
end: lm_p0_document_destroy

# Original: parser.lm1:4492 lm_p0_document_root
fn: lm_p0_document_root (const: (@: document c.LmP0Document)) const: @: c.LmP0Node
    if: (document != 0)
