# Indices of an indexed field path are decimal literals for now: L2 checks no
# bounds at run time, and a variable index is a separate generalisation.
MainLetter:
    char: []: []: mainArgs
end: MainLetter

@: MainLetter m
int: k 1
receiveMessage: m
if: m\mainArgs[k][0] != 0
    sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
