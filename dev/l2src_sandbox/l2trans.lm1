# Does a predef'd header declare this name with fnptr:? The answer is the C
# ABI's, not ours: a function-pointer local can only be typed by a disposer the
# header already names.
fn: l2_predef_has_fnptr (const: @(LmP0Text name)) int
    int: r
    l2_want_fnptr: 1
    r: l2_predef_has_type(name)
    l2_want_fnptr: 0
    if: r = 0
        return: 0
    # struct: and fnptr: share the walk, so a name that is a STRUCT is not a
    # function pointer and must not be mistaken for one.
    if: l2_predef_has_type(name) != 0
        return: 0
return: 1

fn: l2_predef_file_has_type (const: @(LmP0Text name); const: @(LmP0Text quoted)) int
    size_t: n
    @: char path 0
    @: LmP0Document document 0
    const: @: LmP0Node root
    @: LmP0Field f
    @: LmP0Field first
    @: LmP0Node item
    @: LmP0Field inc
    @: LmP0Text q
    @: LmP0Text mapped 0
    @: char mapped_data 0
    int: found 0
    if: name = 0 || quoted = 0 || quoted\data = 0 || quoted\length < 2U || quoted\data[0] != 34 || quoted\data[quoted\length - 1U] != 34
        return: 0
    n: quoted\length - 2U
    path: (cast: (@: char) l2_xmalloc(n + 1U))
    if: path = 0
        return: 0
    memcpy(path, quoted\data + 1U, n)
    path[n]: 0
    if: lm_p0_parse_file(path, @ document) = 0 && document != 0
        root: lm_p0_document_root(document)
        if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0
            f: l2_next_active(root\as\structure\first_field)
            while: f != 0 && found = 0
                item: f\value
                if: (l2_frame_head(item, "struct") || (l2_want_fnptr != 0 && l2_frame_head(item, "fnptr"))) && item\as\frame\body != 0
                    first: l2_next_active(item\as\frame\body\first_field)
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && (l2_text_same(first\value\as\atom, name) || (name\length > 2U && name\data[0] = 99 && name\data[1] = 46 && first\value\as\atom\length = name\length - 2U && memcmp(first\value\as\atom\data, name\data + 2U, name\length - 2U) = 0))
                        found: 1
                    ---
                ---
                # A predef header may reuse another header's ABI declaration.
                # Follow that declared closure instead of forcing every L2 unit
                # to repeat aggregate layouts. Header cycles are invalid input,
                # just as they are for the downstream L1 predef walk.
                if: found = 0 && l2_frame_head(item, "predef") && item\as\frame\body != 0 && l2_count_active(item\as\frame\body) = 1
                    first: l2_next_active(item\as\frame\body\first_field)
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM
                        found: l2_predef_file_has_type(name, first\value\as\atom)
                    ---
                ---
                # Generated L1 headers use foo.lm1.h while their source header
                # unit is foo.h.lm1. Follow that source edge too; pointer ABI
                # lookup needs no C layout parser and the downstream L1/C
                # compiler remains the final spelling check.
                if: found = 0 && l2_frame_head(item, "include") && item\as\frame\body != 0
                    inc: l2_next_active(item\as\frame\body\first_field)
                    while: inc != 0 && found = 0
                        if: inc\value != 0 && inc\value\kind = c.LM_P0_NODE_ATOM
                            q: inc\value\as\atom
                            if: q != 0 && q\data != 0 && q\length > 8U && q\data[0] = 34 && memcmp(q\data + q\length - 7U, ".lm1.h\"", 7U) = 0
                                mapped_data: (cast: (@: char) l2_xmalloc(q\length + 1U))
                                mapped: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
                                if: mapped_data != 0 && mapped != 0
                                    memcpy(mapped_data, q\data, q\length)
                                    memcpy(mapped_data + q\length - 7U, ".h.lm1\"", 7U)
                                    mapped_data[q\length]: 0
                                    mapped\data: mapped_data
                                    mapped\length: q\length
                                    found: l2_predef_file_has_type(name, mapped)
                                    l2_xfree((cast: (@: void) mapped_data))
                                    l2_xfree((cast: (@: void) mapped))
                                    mapped_data: 0
                                    mapped: 0
                                ---
                                if: mapped_data != 0
                                    l2_xfree((cast: (@: void) mapped_data))
                                if: mapped != 0
                                    l2_xfree((cast: (@: void) mapped))
                                ---
                            ---
                        ---
                        inc: l2_next_active(inc\next)
                    ---
                ---
                f: l2_next_active(f\next)
            ---
        ---
        lm_p0_document_destroy(document)
    ---
    l2_xfree((cast: (@: void) path))
return: found

fn: l2_predef_has_type (const: @(LmP0Text name)) int
    int: i 0
    if: name = 0
        return: 0
    while: i < l2_pd_n
        if: l2_predef_file_has_type(name, l2_pd[i]) != 0
            return: 1
        i: i + 1
    ---
return: 0

# WHAT STOOD HERE AND IS GONE (FABLE-OPUS-GATE-CLEANUP-20260926-197 (a)): the C-header scans --
# l2_list_has_simple_typedef / l2_include_has_simple_typedef read the unit's quoted C includes for a
# `typedef`, l2_c_header_walk / l2_c_header_chain_has(_typedef) followed a predef header's plain C
# includes transitively.  That is a dictionary of C entities, which the raw-C door forbids (§7a,
# AUTHOR-C-RAW-DOOR-20260922-14): a type only C knows is spelled `c.Type`.  Measured before removal:
# no tracked .lm2 (1017, and the mixa corpus from its own directory) changes outcome without them.
# The LMX predef readers (l2_predef_has_function / _type / _fnptr, l2_predef_file_define) stay: they
# read DECLARATIONS of .h.lm1 headers, which is how a predef declares.

fn: l2_cnt_keep (const: @(LmP0Text src)) @: LmP0Text
    int: i 0
    int: cap
    size_t: psz
    size_t: nb
    size_t: len
    @@: LmP0Text nn 0
    @: LmP0Text kept 0
    @: char bytes 0
    if: src = 0 || src\data = 0 || src\length = 0U
        return: 0
    while: i < l2_cnt_n
        if: l2_text_same(l2_cnt[i], src)
            return: l2_cnt[i]
        i: i + 1
    ---
    cap: l2_cnt_cap
    if: l2_cnt_n >= cap
        if: cap < 1
            cap: 4
        ---
        if: cap > (c.INT_MAX / 2)
            return: 0
        cap: cap * 2
        psz: c.sizeof(@: char)
        if: l2_mul_ok((cast: (size_t) cap), psz) = 0
            return: 0
        nb: (cast: (size_t) cap) * psz
        nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
        if: nn = 0
            return: 0
        memset((cast: (@: void) nn), 0, nb)
        if: l2_cnt != 0 && l2_cnt_n > 0
            memcpy((cast: (@: void) nn), (cast: (@: void) l2_cnt), (cast: (size_t) l2_cnt_n) * psz)
        ---
        if: l2_cnt != 0
            l2_xfree((cast: (@: void) l2_cnt))
        ---
        l2_cnt: nn
        l2_cnt_cap: cap
    ---
    len: src\length
    bytes: (cast: (@: char) l2_xmalloc(len + 1U))
    kept: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    if: bytes = 0 || kept = 0
        if: bytes != 0
            l2_xfree((cast: (@: void) bytes))
        ---
        if: kept != 0
            l2_xfree((cast: (@: void) kept))
        ---
        return: 0
    ---
    memcpy(bytes, src\data, len)
    bytes[len]: 0
    kept\data: bytes
    kept\length: len
    l2_cnt[l2_cnt_n]: kept
    l2_cnt_n: l2_cnt_n + 1
return: kept

fn: l2_cnt_free () int
    int: i 0
    while: i < l2_cnt_n
        if: l2_cnt[i] != 0
            if: l2_cnt[i]\data != 0
                l2_xfree((cast: (@: void) l2_cnt[i]\data))
            ---
            l2_xfree((cast: (@: void) l2_cnt[i]))
        ---
        i: i + 1
    ---
    if: l2_cnt != 0
        l2_xfree((cast: (@: void) l2_cnt))
    ---
    l2_cnt: 0
    l2_cnt_n: 0
    l2_cnt_cap: 0
return: 0

# A top-level `define: NAME <literal>` in a predef'd .h.lm1, or in a .h.lm1 that
# one predefs (the same single-file predef closure l2_predef_file_has_type
# follows). The literal is kept, because this document is destroyed here.  With
# `any` the define may give any value (l2_define_name): its first value token is
# kept; without it only an own-array count literal answers (l2_define_count).
fn: l2_predef_file_define (const: @(LmP0Text name); const: @(LmP0Text quoted); int: any) @: LmP0Text
    size_t: n
    @: char path 0
    @: LmP0Document document 0
    const: @: LmP0Node root
    @: LmP0Field f
    @: LmP0Field first
    @: LmP0Field second
    @: LmP0Node item
    @: LmP0Text found 0
    if: name = 0 || quoted = 0 || quoted\data = 0 || quoted\length < 2U || quoted\data[0] != 34 || quoted\data[quoted\length - 1U] != 34
        return: 0
    n: quoted\length - 2U
    path: (cast: (@: char) l2_xmalloc(n + 1U))
    if: path = 0
        return: 0
    memcpy(path, quoted\data + 1U, n)
    path[n]: 0
    if: lm_p0_parse_file(path, @ document) = 0 && document != 0
        root: lm_p0_document_root(document)
        if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0
            f: l2_next_active(root\as\structure\first_field)
            while: f != 0 && found = 0
                item: f\value
                if: l2_frame_head(item, "define") && item\as\frame\body != 0 && (l2_count_active(item\as\frame\body) = 2 || (any != 0 && l2_count_active(item\as\frame\body) > 2))
                    first: l2_next_active(item\as\frame\body\first_field)
                    second: 0
                    if: first != 0
                        second: l2_next_active(first\next)
                    ---
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && l2_text_same(first\value\as\atom, name) && second != 0 && second\value != 0 && second\value\kind = c.LM_P0_NODE_ATOM && (any != 0 || l2_array_count_is(second\value\as\atom) != 0)
                        found: l2_cnt_keep(second\value\as\atom)
                    ---
                ---
                if: found = 0 && l2_frame_head(item, "predef") && item\as\frame\body != 0 && l2_count_active(item\as\frame\body) = 1
                    first: l2_next_active(item\as\frame\body\first_field)
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM
                        found: l2_predef_file_define(name, first\value\as\atom, any)
                    ---
                ---
                f: l2_next_active(f\next)
            ---
        ---
        lm_p0_document_destroy(document)
    ---
    l2_xfree((cast: (@: void) path))
return: found

# An own-array count written as a name resolves to the literal its define: gives:
# the unit's own defines first -- those nodes live as long as the unit document
# the [] statement itself belongs to -- then the unit's predef chain. Only a
# literal value resolves; a define of another name stays refused.
fn: l2_define_count (const: @(LmP0Text name)) @: LmP0Text
    int: i 0
    @: LmP0Field first
    @: LmP0Field second
    @: LmP0Text r 0
    if: name = 0 || l2_ident(name) = 0
        return: 0
    while: i < l2_def_n
        if: l2_def[i] != 0 && l2_def[i]\as != 0 && l2_def[i]\as\frame != 0 && l2_def[i]\as\frame\body != 0 && l2_count_active(l2_def[i]\as\frame\body) = 2
            first: l2_next_active(l2_def[i]\as\frame\body\first_field)
            second: 0
            if: first != 0
                second: l2_next_active(first\next)
            ---
            if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && l2_text_same(first\value\as\atom, name) && second != 0 && second\value != 0 && second\value\kind = c.LM_P0_NODE_ATOM && l2_array_count_is(second\value\as\atom) != 0
                return: second\value\as\atom
            ---
        ---
        i: i + 1
    ---
    i: 0
    while: i < l2_pd_n && r = 0
        r: l2_predef_file_define(name, l2_pd[i], 0)
        i: i + 1
    ---
return: r

# A `define:` of the unit or of its predef chain DECLARES its name (FABLE-OPUS-MERGE-PARTS-20260926-193
# T1b, Q6 = a): `define:` is L1 the translator passes through, and it reads these declarations
# already for own-array counts (l2_define_count).  An atom naming one is a declared constant, asked
# after every L2 name, whatever its spelling.  Any other name is unresolved (a located refusal); a
# name only C knows comes through the raw door, `c.NAME`.
fn: l2_define_name (const: @(LmP0Text name)) int
    int: i 0
    @: LmP0Field first
    if: name = 0 || l2_ident(name) = 0
        return: 0
    while: i < l2_def_n
        if: l2_def[i] != 0 && l2_def[i]\as != 0 && l2_def[i]\as\frame != 0 && l2_def[i]\as\frame\body != 0 && l2_count_active(l2_def[i]\as\frame\body) >= 2
            first: l2_next_active(l2_def[i]\as\frame\body\first_field)
            if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && l2_text_same(first\value\as\atom, name)
                return: 1
            ---
        ---
        i: i + 1
    ---
    i: 0
    while: i < l2_pd_n
        if: l2_predef_file_define(name, l2_pd[i], 1) != 0
            return: 1
        i: i + 1
    ---
return: 0
fn: l2_predef_file_has_function (const: @(LmP0Text name); const: @(LmP0Text quoted)) int
    size_t: n
    @: char path 0
    @: LmP0Document document 0
    const: @: LmP0Node root
    @: LmP0Field f
    @: LmP0Field pf
    @: LmP0Field nf
    @: LmP0Field first
    @: LmP0Node item
    @: LmP0Node decl
    int: found 0
    if: name = 0 || quoted = 0 || quoted\data = 0 || quoted\length < 2U || quoted\data[0] != 34 || quoted\data[quoted\length - 1U] != 34
        return: 0
    n: quoted\length - 2U
    path: (cast: (@: char) l2_xmalloc(n + 1U))
    if: path = 0
        return: 0
    memcpy(path, quoted\data + 1U, n)
    path[n]: 0
    if: lm_p0_parse_file(path, @ document) = 0 && document != 0
        root: lm_p0_document_root(document)
        if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0
            f: l2_next_active(root\as\structure\first_field)
            while: f != 0 && found = 0
                item: f\value
                if: l2_frame_head(item, "prototype") && item\as\frame\body != 0
                    pf: l2_next_active(item\as\frame\body\first_field)
                    while: pf != 0 && found = 0
                        decl: pf\value
                        if: (l2_frame_head(decl, "fn") || l2_frame_head(decl, "sub")) && decl\as\frame\body != 0
                            nf: l2_next_active(decl\as\frame\body\first_field)
                            if: nf != 0 && nf\value != 0 && nf\value\kind = c.LM_P0_NODE_ATOM && l2_text_same(nf\value\as\atom, name)
                                found: 1
                            ---
                        ---
                        pf: l2_next_active(pf\next)
                    ---
                ---
                if: found = 0 && l2_frame_head(item, "predef") && item\as\frame\body != 0 && l2_count_active(item\as\frame\body) = 1
                    first: l2_next_active(item\as\frame\body\first_field)
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM
                        found: l2_predef_file_has_function(name, first\value\as\atom)
                    ---
                ---
                f: l2_next_active(f\next)
            ---
        ---
        lm_p0_document_destroy(document)
    ---
    l2_xfree((cast: (@: void) path))
return: found

# Functions declared by a predef header are external ABI leaves. They are not
# callable Structures owned by this unit, so calls go through the ordinary C
# seam while the generated predef header supplies the checked prototype.
fn: l2_predef_has_function (const: @(LmP0Text name)) int
    int: i 0
    if: name = 0
        return: 0
    while: i < l2_pd_n
        if: l2_predef_file_has_function(name, l2_pd[i]) != 0
            return: 1
        i: i + 1
    ---
return: 0

# FABLE-SONNET-TYPE-WORD-FOLD-20260924-162 commit 2 (steps/type-word-fold-
# inventory.md): the return-code word(+depth+const) -> code table, shared
# by l2_collect_method's real-method return type (its own structural
# validation -- body counts, "incompatible entry signature" vs "unknown
# type" -- stays there; only the word lookup moves here) and
# l2_ret_type_node below (for a predef'd prototype: declaration, which
# has no structural context of its own to preserve). depth=0 is a
# bare-value return (is_const never applies there); is_const only
# matters at depth=1 (l2_collect_method's own const: (@: T) case; no
# const @@: or deeper return exists in the corpus, measured). Returns
# 0 = found (out_ty set), 1 = word not recognized (not one of the known
# words at this depth/const combination, not a Structure name at
# depth=0, and l2_foreign_byvalue/l2_resolve_type_atom also refused).
fn: l2_ret_type_word (const: @(LmP0Text word); int: depth; int: is_const; @: int out_ty) int
    if: out_ty = 0 || word = 0
        return: 1
    \out_ty: 0
    if: depth = 0 && l2_text_eq(word, "int")
        \out_ty: 0
        return: 0
    if: depth = 0 && l2_text_eq(word, "size_t")
        \out_ty: 2
        return: 0
    if: depth = 0 && l2_text_eq(word, "unsigned")
        \out_ty: 33
        return: 0
    if: depth = 0 && l2_text_eq(word, "ulong")
        \out_ty: 36
        return: 0
    if: depth = 0 && l2_text_eq(word, "void")
        \out_ty: 8
        return: 0
    if: depth = 0 && l2_text_eq(word, "LmxMsgAddr")
        \out_ty: 33
        return: 0
    if: depth = 0 && l2_ns_find(word) >= 0
        \out_ty: l2_colon_graph_ty()
        if: \out_ty >= 100
            return: 0
        return: 1
    if: depth = 0
        \out_ty: l2_foreign_byvalue(word)
        if: \out_ty >= 100
            return: 0
        return: 1
    if: depth = 1 && is_const = 0 && l2_text_eq(word, "char")
        \out_ty: 3
        return: 0
    if: depth = 1 && is_const != 0 && l2_text_eq(word, "char")
        \out_ty: 35
        return: 0
    if: depth = 1 && is_const = 0 && l2_text_eq(word, "void")
        \out_ty: 16
        return: 0
    if: depth = 2 && is_const = 0 && l2_text_eq(word, "char")
        \out_ty: 32
        return: 0
    if: l2_resolve_type_atom(word, depth, is_const, out_ty) != 0
        return: 1
return: 0

# The full return-type NODE, structural parsing included (const: (@: T),
# depth>2, @:, @@:, bare atom) -- used where the caller has no structural
# validation of its own to reuse (l2_predef_file_result_ty, a predef'd
# prototype: declaration). l2_collect_method keeps its own structural
# parsing (for its per-case "incompatible entry signature" errors) and
# calls l2_ret_type_word directly once it already has word+depth+const.
fn: l2_ret_type_node (const: @(LmP0Node rt); @: int out_ty) int
    @: LmP0Field inner_f
    @: LmP0Field cf
    @: LmP0Node inner
    @: LmP0Node cinner
    int: depth
    if: out_ty = 0
        return: 1
    \out_ty: 8
    if: rt = 0
        return: 0
    if: rt\kind = c.LM_P0_NODE_ATOM
        if: rt\as = 0 || rt\as\atom = 0
            return: 1
        return: l2_ret_type_word(rt\as\atom, 0, 0, out_ty)
    if: rt\kind != c.LM_P0_NODE_FRAME || rt\as = 0 || rt\as\frame = 0
        return: 1
    if: l2_frame_head(rt, "const") != 0
        if: rt\as\frame\body = 0 || l2_count_active(rt\as\frame\body) != 1
            return: 1
        cf: l2_next_active(rt\as\frame\body\first_field)
        if: cf = 0 || cf\value = 0
            return: 1
        cinner: cf\value
        if: cinner\kind != c.LM_P0_NODE_FRAME || cinner\as = 0 || cinner\as\frame = 0 || l2_frame_head(cinner, "@") = 0
            return: 1
        if: cinner\as\frame\body = 0 || l2_count_active(cinner\as\frame\body) != 1
            return: 1
        inner_f: l2_next_active(cinner\as\frame\body\first_field)
        if: inner_f = 0 || inner_f\value = 0 || inner_f\value\kind != c.LM_P0_NODE_ATOM || inner_f\value\as = 0 || inner_f\value\as\atom = 0
            return: 1
        return: l2_ret_type_word(inner_f\value\as\atom, 1, 1, out_ty)
    depth: l2_address_depth(rt\as\frame\head)
    if: depth < 1 || depth > 2
        return: 1
    if: rt\as\frame\body = 0 || l2_count_active(rt\as\frame\body) != 1
        return: 1
    inner_f: l2_next_active(rt\as\frame\body\first_field)
    if: inner_f = 0
        return: 1
    inner: inner_f\value
    if: inner = 0 || inner\kind != c.LM_P0_NODE_ATOM || inner\as = 0 || inner\as\atom = 0
        return: 1
return: l2_ret_type_word(inner\as\atom, depth, 0, out_ty)

fn: l2_predef_file_result_ty (const: @(LmP0Text name); const: @(LmP0Text quoted); @: int out_ty) int
    size_t: n
    @: char path 0
    @: LmP0Document document 0
    const: @: LmP0Node root
    @: LmP0Field f
    @: LmP0Field pf
    @: LmP0Field nf
    @: LmP0Field pp
    @: LmP0Field rtf
    @: LmP0Node rtnode
    @: LmP0Field first
    @: LmP0Node item
    @: LmP0Node decl
    int: found 0
    if: out_ty = 0
        return: 0
    if: name = 0 || quoted = 0 || quoted\data = 0 || quoted\length < 2U || quoted\data[0] != 34 || quoted\data[quoted\length - 1U] != 34
        return: 0
    n: quoted\length - 2U
    path: (cast: (@: char) l2_xmalloc(n + 1U))
    if: path = 0
        return: 0
    memcpy(path, quoted\data + 1U, n)
    path[n]: 0
    if: lm_p0_parse_file(path, @ document) = 0 && document != 0
        root: lm_p0_document_root(document)
        if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0
            f: l2_next_active(root\as\structure\first_field)
            while: f != 0 && found = 0
                item: f\value
                if: l2_frame_head(item, "prototype") && item\as\frame\body != 0
                    pf: l2_next_active(item\as\frame\body\first_field)
                    while: pf != 0 && found = 0
                        decl: pf\value
                        if: (l2_frame_head(decl, "fn") || l2_frame_head(decl, "sub")) && decl\as\frame\body != 0
                            nf: l2_next_active(decl\as\frame\body\first_field)
                            if: nf != 0 && nf\value != 0 && nf\value\kind = c.LM_P0_NODE_ATOM && l2_text_same(nf\value\as\atom, name)
                                pp: l2_next_active(nf\next)
                                rtf: 0
                                if: pp != 0
                                    rtf: l2_next_active(pp\next)
                                rtnode: 0
                                if: rtf != 0
                                    rtnode: rtf\value
                                if: l2_ret_type_node(rtnode, out_ty) != 0
                                    \out_ty: -10
                                found: 1
                            ---
                        ---
                        pf: l2_next_active(pf\next)
                    ---
                ---
                if: found = 0 && l2_frame_head(item, "predef") && item\as\frame\body != 0 && l2_count_active(item\as\frame\body) = 1
                    first: l2_next_active(item\as\frame\body\first_field)
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM
                        found: l2_predef_file_result_ty(name, first\value\as\atom, out_ty)
                    ---
                ---
                f: l2_next_active(f\next)
            ---
        ---
        lm_p0_document_destroy(document)
    ---
    l2_xfree((cast: (@: void) path))
return: found

fn: l2_predef_result_ty (const: @(LmP0Text name); @: int out_ty) int
    int: i 0
    if: name = 0 || out_ty = 0
        return: 0
    while: i < l2_pd_n
        if: l2_predef_file_result_ty(name, l2_pd[i], out_ty) != 0
            return: 1
        i: i + 1
    ---
return: 0

fn: l2_address_depth (const: @(LmP0Text head)) int
    size_t: i 0U
    if: head = 0 || head\data = 0 || head\length = 0U || head\length > (cast: (size_t) c.INT_MAX)
        return: 0
    while: i < head\length
        if: head\data[i] != 64
            return: 0
        i: i + 1U
return: (cast: (int) head\length)

fn: l2_emit_address_marks (@: FILE out; int: depth) int
    int: i 0
    if: out = 0 || depth < 1
        return: 1
    while: i < depth
        if: c.fputc(64, out) = c.EOF
            return: 1
        i: i + 1
return: 0

fn: l2_foreign_intern (const: @(LmP0Text name); int: depth; int: is_const) int
    int: i 0
    int: cap
    size_t: nb
    @@: LmP0Text nn 0
    @: int nd 0
    @: int nc 0
    if: name = 0 || l2_ident(name) = 0 || depth < 0
        return: 0 - 1
    # A foreign type is spelled as written (Stage B, Mikhail 2026-09-14): no
    # header is read to admit it, and the C compiler checks the spelling.
    while: i < l2_foreign_n
        if: l2_foreign_depth[i] = depth && l2_foreign_const[i] = is_const && l2_text_same(l2_foreign_name[i], name)
            return: 100 + i
        i: i + 1
    if: l2_foreign_n = c.INT_MAX - 100
        l2_alloc_err: 2
        return: 0 - 1
    if: l2_foreign_n >= l2_foreign_cap
        cap: l2_foreign_cap
        if: cap < 1
            cap: 4
        while: cap <= l2_foreign_n
            if: cap > c.INT_MAX / 2
                cap: l2_foreign_n + 1
            else:
                cap: cap * 2
            ---
        ---
        if: l2_mul_ok((cast: (size_t) cap), c.sizeof(@: char)) = 0 || l2_mul_ok((cast: (size_t) cap), c.sizeof(c.int)) = 0
            l2_alloc_err: 2
            return: 0 - 1
        nb: (cast: (size_t) cap) * c.sizeof(@: char)
        nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
        nd: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        nc: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        if: nn = 0 || nd = 0 || nc = 0
            if: nn != 0
                l2_xfree((cast: (@: void) nn))
            if: nd != 0
                l2_xfree((cast: (@: void) nd))
            if: nc != 0
                l2_xfree((cast: (@: void) nc))
            return: 0 - 1
        if: l2_foreign_n > 0
            memcpy((cast: (@: void) nn), (cast: (@: void) l2_foreign_name), (cast: (size_t) l2_foreign_n) * c.sizeof(@: char))
            memcpy((cast: (@: void) nd), (cast: (@: void) l2_foreign_depth), (cast: (size_t) l2_foreign_n) * c.sizeof(c.int))
            memcpy((cast: (@: void) nc), (cast: (@: void) l2_foreign_const), (cast: (size_t) l2_foreign_n) * c.sizeof(c.int))
        ---
        if: l2_foreign_name != 0
            l2_xfree((cast: (@: void) l2_foreign_name))
        if: l2_foreign_depth != 0
            l2_xfree((cast: (@: void) l2_foreign_depth))
        if: l2_foreign_const != 0
            l2_xfree((cast: (@: void) l2_foreign_const))
        l2_foreign_name: nn
        l2_foreign_depth: nd
        l2_foreign_const: nc
        l2_foreign_cap: cap
    ---
    l2_foreign_name[l2_foreign_n]: (cast: (@: LmP0Text) name)
    l2_foreign_depth[l2_foreign_n]: depth
    l2_foreign_const[l2_foreign_n]: is_const
    i: l2_foreign_n
    l2_foreign_n: l2_foreign_n + 1
    # Source-driven predef/include: the unit declares what runtime headers it needs.
    # Name/prefix triggers (LmP0*, c.lm_p0_set_diagnostic, per-name stdlib/string) are gone.
return: 100 + i

# A by-value foreign type `T` or `c.T` (Stage B), interned with depth 0. It is
# spelled as written without the c. prefix, and the C compiler checks it.
# Returns a foreign code >= 100, or less when the text is not a type name.
fn: l2_foreign_byvalue (const: @(LmP0Text t)) int
    @: LmP0Text view 0
    if: t = 0 || t\data = 0
        return: 0 - 1
    if: t\length > 2U && t\data[0] = 99 && t\data[1] = 46
        view: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
        if: view = 0
            return: 0 - 1
        view\data: t\data + 2U
        view\length: t\length - 2U
        return: l2_foreign_intern(view, 0, 0)
    ---
    # Bare foreign by-value names are refused (type-position rule, ticket 106 PART2).
return: 0 - 1

# Resolve a type-position atom at address depth for formals/returns/own fields.
# Order matches l2_ptr_local_ty: Structure/model -> Lmx projection; c.* raw door;
# else unknown (caller emits "unknown type"). Returns 0 and sets out_ty, or 2.
fn: l2_resolve_type_atom (const: @(LmP0Text atom); int: depth; int: is_const; @: int out_ty) int
    if: out_ty = 0 || atom = 0
        return: 2
    \out_ty: 0
    if: depth < 1
        return: 2
    # Lmx is the Structure/model projection type (CORE.md 3.1); it is not a foreign C name.
    if: l2_text_eq(atom, "Lmx")
        \out_ty: l2_foreign_intern(l2_lmx_text(), depth, is_const)
        if: \out_ty >= 100
            return: 0
        return: 2
    # A reference `@: T` to a named Structure is one level, `@: Lmx` (D-76): its value is the Structure
    # itself, the pointee its pointer cell holds -- the same value `@mo` gives and `T: mo`'s slot holds.
    if: l2_ns_find(atom) >= 0
        \out_ty: l2_foreign_intern(l2_lmx_text(), depth, is_const)
        if: \out_ty >= 100
            return: 0
        return: 2
    if: l2_c_door(atom) != 0
        \out_ty: l2_foreign_intern(l2_text_skip(atom, 2U), depth, is_const)
        if: \out_ty >= 100
            return: 0
        return: 2
return: 2

fn: l2_emit_foreign_named (@: FILE out; int: ty; const: @(char prefix); const: @(LmP0Text name)) int
    int: i ty - 100
    if: out = 0 || i < 0 || i >= l2_foreign_n
        return: 1
    if: prefix != 0 && fputs(prefix, out) < 0
        return: 1
    if: l2_foreign_depth[i] = 0
        if: l2_write_text(out, l2_foreign_name[i]) != 0 || fputs(": ", out) < 0 || l2_write_text(out, name) != 0
            return: 1
        return: 0
    if: l2_foreign_const[i] != 0 && fputs("const: ", out) < 0
        return: 1
    if: l2_emit_address_marks(out, l2_foreign_depth[i]) != 0
        return: 1
    if: l2_foreign_const[i] != 0
        if: fputs("(", out) < 0
            return: 1
        ---
    else:
        if: fputs(": ", out) < 0
            return: 1
    ---
    if: l2_write_text(out, l2_foreign_name[i]) != 0
        return: 1
    if: fputs(" ", out) < 0 || l2_write_text(out, name) != 0
        return: 1
    if: l2_foreign_const[i] != 0 && fputs(")", out) < 0
        return: 1
return: 0

fn: l2_emit_foreign_temp (@: FILE out; int: ty; const: @(char ind); int: temp) int
    int: i ty - 100
    if: out = 0 || i < 0 || i >= l2_foreign_n
        return: 1
    if: fputs(ind, out) < 0
        return: 1
    # A const foreign pointer keeps its qualifier: `const: @(T l2_tN)`.
    if: l2_foreign_const[i] != 0
        if: l2_foreign_depth[i] < 1 || fputs("const: ", out) < 0 || l2_emit_address_marks(out, l2_foreign_depth[i]) != 0 || fputs("(", out) < 0 || l2_write_text(out, l2_foreign_name[i]) != 0 || c.fprintf(out, " l2_t%d)\n", temp) < 0
            return: 1
        return: 0
    if: l2_foreign_depth[i] = 0
        if: l2_write_text(out, l2_foreign_name[i]) != 0 || c.fprintf(out, ": l2_t%d\n", temp) < 0
            return: 1
        return: 0
    if: l2_emit_address_marks(out, l2_foreign_depth[i]) != 0 || fputs(": ", out) < 0
        return: 1
    if: l2_write_text(out, l2_foreign_name[i]) != 0
        return: 1
    if: c.fprintf(out, " l2_t%d\n", temp) < 0
        return: 1
return: 0

fn: l2_emit_foreign_return (@: FILE out; int: ty) int
    int: i ty - 100
    if: out = 0 || i < 0 || i >= l2_foreign_n
        return: 1
    # A const foreign pointer return: `) const: @(T)`.
    if: l2_foreign_const[i] != 0
        if: l2_foreign_depth[i] < 1 || fputs(") const: ", out) < 0 || l2_emit_address_marks(out, l2_foreign_depth[i]) != 0 || fputs("(", out) < 0 || l2_write_text(out, l2_foreign_name[i]) != 0 || fputs(")", out) < 0
            return: 1
        return: 0
    if: l2_foreign_depth[i] = 0
        if: fputs(") ", out) < 0
            return: 1
        return: l2_write_text(out, l2_foreign_name[i])
    if: fputs(") ", out) < 0 || l2_emit_address_marks(out, l2_foreign_depth[i]) != 0 || fputs(": ", out) < 0
        return: 1
return: l2_write_text(out, l2_foreign_name[i])

fn: l2_emit_foreign_formal (@: FILE out; int: ty; int: mi; int: fi; int: arg) int
    int: i ty - 100
    if: out = 0 || i < 0 || i >= l2_foreign_n
        return: 1
    # The trampoline input (l2_emit_formal): a foreign value is read from the typed storage its
    # reference addresses, through the typed pointer declared for it (arg 2); a foreign pointer
    # is the reference itself.
    if: arg = 2 && l2_foreign_depth[i] = 0
        if: fputs("    @: ", out) < 0 || l2_write_text(out, l2_foreign_name[i]) != 0 || c.fprintf(out, " l2_b%d (cast: (@: ", fi) < 0 || l2_write_text(out, l2_foreign_name[i]) != 0 || c.fprintf(out, ") refs[%d])\n", fi) < 0
            return: 1
        ---
    if: arg = 2
        return: 0
    if: arg = 1 && l2_foreign_depth[i] = 0
        return: (cast: (int) (c.fprintf(out, ", \\l2_b%d", fi) < 0))
    if: arg = 1
        return: (cast: (int) (c.fprintf(out, ", refs[%d]", fi) < 0))
    if: fputs("; ", out) < 0
        return: 1
    if: l2_foreign_depth[i] = 0
        if: l2_write_text(out, l2_foreign_name[i]) != 0 || c.fprintf(out, ": l2_p%d_%d", mi, fi) < 0
            return: 1
        return: 0
    if: l2_foreign_const[i] != 0 && fputs("const: ", out) < 0
        return: 1
    if: l2_emit_address_marks(out, l2_foreign_depth[i]) != 0
        return: 1
    if: l2_foreign_const[i] != 0
        if: fputs("(", out) < 0
            return: 1
        ---
    else:
        if: fputs(": ", out) < 0
            return: 1
    ---
    if: l2_write_text(out, l2_foreign_name[i]) != 0 || c.fprintf(out, " l2_p%d_%d", mi, fi) < 0
        return: 1
    if: l2_foreign_const[i] != 0 && fputs(")", out) < 0
        return: 1
return: 0

# A function-pointer local: TYPE: name, where TYPE is a fnptr: the predef'd
# header declares. It is an activation local, never an own field -- a function
# pointer is not a graph cell and has no business in one.
fn: l2_fnptr_local (const: @(LmP0Node stmt); @@: LmP0Text out_name) int
    @: LmP0Field f
    if: out_name = 0
        return: 1
    \out_name: 0
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || stmt\as\frame\body = 0
        return: 1
    # A bare declaration, or a declaration with an initialiser. The
    # initialiser form is the only one this language can express, because a
    # later "d: value" statement is the same tree as the call "d(value)".
    if: l2_count_active(stmt\as\frame\body) < 1
        return: 1
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f\value\as\atom) = 0
        return: 1
    if: l2_predef_has_fnptr(stmt\as\frame\head) = 0
        return: 1
    \out_name: f\value\as\atom
return: 0

# A by-value local of a C struct the predef'd header declares: TYPE: name. It is
# ordinary C storage in the activation (spec 20.2.2), never an own field, and its
# address is taken with @ name. Only the bare declaration: a struct has no
# scalar initialiser here. Classification uses structural shape and resolved type/name, not form.
fn: l2_struct_local (const: @(LmP0Node stmt); @@: LmP0Text out_name) int
    @: LmP0Field f
    if: out_name = 0
        return: 1
    \out_name: 0
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || stmt\as\frame\body = 0
        return: 1
    if: l2_count_active(stmt\as\frame\body) != 1
        return: 1
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f\value\as\atom) = 0
        return: 1
    if: l2_predef_has_type(stmt\as\frame\head) = 0 || l2_predef_has_fnptr(stmt\as\frame\head) != 0
        return: 1
    \out_name: f\value\as\atom
return: 0

@: LmP0Text l2_lmx_name_cache 0

# The one physical projection every nonprimitive Structure/model already
# uses (CORE.md 3.1, L2 spec 18.1): Lmx at one more address depth than the
# binding itself. Cached so repeated address-slot declarations over
# different Structure names still share one interned (name,depth) entry.
fn: l2_lmx_text () @: LmP0Text
    if: l2_lmx_name_cache != 0
        return: l2_lmx_name_cache
    l2_lmx_name_cache: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    if: l2_lmx_name_cache = 0
        return: 0
    l2_lmx_name_cache\data: "Lmx"
    l2_lmx_name_cache\length: 3U
return: l2_lmx_name_cache

# The raw c.* door strips its own "c." marker before the spelling reaches
# the foreign-pointer interner: "c." is L2's own namespace prefix, never
# part of the C identifier the compiler must find.
fn: l2_text_skip (const: @(LmP0Text t); size_t: n) @: LmP0Text
    @: LmP0Text r
    if: t = 0 || t\length < n
        return: 0
    r: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    if: r = 0
        return: 0
    r\data: t\data + n
    r\length: t\length - n
return: r

# FABLE-SONNET-TYPE-WORD-FOLD-20260924-162 commit 2 (steps/type-word-fold-
# inventory.md): the pointer-local word+depth -> code table, shared
# byte-identically (measured, commit 1) by l2_ptr_local_ty, l2_own_array_
# pointer_ty and l2_typed_formal's @:/@@: blocks -- one function instead
# of three copies. Callers already validated the SHAPE (a `@: T name` /
# `@@: T name`-like frame at a nonzero depth) before reaching here, so
# this only ever answers for the WORD: 0 = found (out_ty set); 2 = word
# not one of the six core words at this depth, not a known Structure
# name, not a c.* door name, OR recognized as an attempted Structure/
# foreign name but l2_foreign_intern itself failed (l2_ptr_local_ty's
# own exact convention -- verified against its original inline chain,
# which returns 2 here, never 1; 1 is reserved by its callers for the
# shape check, never produced by the word lookup itself).
fn: l2_ptr_type_word (const: @(LmP0Text word); int: depth; @: int out_ty) int
    if: out_ty = 0 || word = 0
        return: 2
    \out_ty: 0
    if: depth = 1 && l2_text_eq(word, "char")
        \out_ty: 12
        return: 0
    if: depth = 1 && l2_text_eq(word, "size_t")
        \out_ty: 9
        return: 0
    if: depth = 1 && l2_text_eq(word, "int")
        \out_ty: 11
        return: 0
    if: depth = 1 && l2_text_eq(word, "void")
        \out_ty: 16
        return: 0
    if: depth = 1 && l2_text_eq(word, "unsigned")
        \out_ty: 25
        return: 0
    if: depth = 1 && l2_text_eq(word, "ulong")
        \out_ty: 38
        return: 0
    if: depth = 2 && l2_text_eq(word, "char")
        \out_ty: 17
        return: 0
    if: depth = 2 && l2_text_eq(word, "size_t")
        \out_ty: 20
        return: 0
    if: depth = 2 && l2_text_eq(word, "int")
        \out_ty: 19
        return: 0
    if: depth = 2 && l2_text_eq(word, "void")
        \out_ty: 18
        return: 0
    if: depth = 2 && l2_text_eq(word, "unsigned")
        \out_ty: 24
        return: 0
    if: depth = 2 && l2_text_eq(word, "ulong")
        \out_ty: 39
        return: 0
    # `@: T` of a named Structure is one level, `@: Lmx` (D-76; l2_resolve_type_atom).
    if: l2_ns_find(word) >= 0
        \out_ty: l2_foreign_intern(l2_lmx_text(), depth, 0)
        if: \out_ty >= 100
            return: 0
        return: 2
    if: l2_c_door(word) != 0
        \out_ty: l2_foreign_intern(l2_text_skip(word, 2U), depth, 0)
        if: \out_ty >= 100
            return: 0
        return: 2
return: 2

# The kernel pointee words: char, LmxMsgRuntime/LmxRoot, LmxMsg, LmxMsgCopy,
# L2ImmutQuery -- depth 1 only (none of these has a depth-2 spelling in any of
# the three sites that recognize them).  Folded out of l2_const_local_ty's own
# inline check (FABLE-SONNET-SEND-REF-20260925-172 commit 1, per -162's
# fold discipline): one table, codes unchanged (char=3, LmxMsgRuntime/
# LmxRoot=28, LmxMsg=29, LmxMsgCopy=30, L2ImmutQuery=6), l2_const_local_ty
# and l2_typed_formal's const branch both call it instead of repeating it;
# a THIRD caller, the general reference field in l2_take_ns_body, needs the
# same words for a field like `@: LmxMsg sender`.  0 = recognized (out_ty
# set); 1 = not one of these five words.
fn: l2_kernel_ptr_word (const: @(LmP0Text word); @: int out_ty) int
    if: out_ty = 0 || word = 0
        return: 1
    \out_ty: 0
    if: l2_text_eq(word, "char")
        \out_ty: 3
        return: 0
    if: l2_text_eq(word, "LmxMsgRuntime")
        \out_ty: 28
        return: 0
    if: l2_text_eq(word, "LmxRoot")
        \out_ty: 28
        return: 0
    if: l2_text_eq(word, "LmxMsg")
        \out_ty: 29
        return: 0
    if: l2_text_eq(word, "LmxMsgCopy")
        \out_ty: 30
        return: 0
    if: l2_text_eq(word, "L2ImmutQuery")
        \out_ty: 6
        l2_need_query: 1
        return: 0
return: 1

fn: l2_ptr_local_ty (const: @(LmP0Node stmt); @@: LmP0Text out_name; @: int out_ty) int
    @: LmP0Field f
    @: LmP0Field g
    int: n
    int: depth
    if: out_name = 0 || out_ty = 0
        return: 1
    \out_name: 0
    \out_ty: 0
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0
        return: 1
    depth: l2_address_depth(stmt\as\frame\head)
    if: depth = 0
        return: 1
    if: stmt\as\frame\body = 0
        return: 1
    n: l2_count_active(stmt\as\frame\body)
    if: n != 2 && n != 3
        return: 1
    f: l2_next_active(stmt\as\frame\body\first_field)
    g: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
        return: 1
    \out_name: g\value\as\atom
return: l2_ptr_type_word(f\value\as\atom, depth, out_ty)

fn: l2_const_local_ty (const: @(LmP0Node stmt); @@: LmP0Text out_name; @: int out_ty) int
    @: LmP0Field f
    const: @: LmP0Node inner
    @: LmP0Field g
    @: LmP0Field h
    int: depth
    int: n
    if: out_name = 0 || out_ty = 0
        return: 1
    \out_name: 0
    \out_ty: 0
    if: l2_frame_head(stmt, "const") = 0
        return: 1
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 1
    if: l2_count_active(stmt\as\frame\body) != 1
        return: 1
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0
        return: 1
    inner: f\value
    if: inner\kind != c.LM_P0_NODE_FRAME || inner\as = 0 || inner\as\frame = 0
        return: 1
    depth: l2_address_depth(inner\as\frame\head)
    if: depth = 0
        return: 1
    if: inner\as\frame\body = 0
        return: 1
    n: l2_count_active(inner\as\frame\body)
    # A unit pointer field may spell its required null initializer inside the
    # const declarator: const: @(T name 0).  Local declarations still use the
    # two-field form; the caller validates the optional initializer.
    if: n != 2 && n != 3
        return: 1
    g: l2_next_active(inner\as\frame\body\first_field)
    h: l2_next_active(g\next)
    if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    if: h = 0 || h\value = 0 || h\value\kind != c.LM_P0_NODE_ATOM || l2_ident(h\value\as\atom) = 0
        return: 1
    \out_name: h\value\as\atom
    if: depth = 1 && l2_kernel_ptr_word(g\value\as\atom, out_ty) = 0
        return: 0
    if: l2_c_door(g\value\as\atom) != 0
        \out_ty: l2_foreign_intern(l2_text_skip(g\value\as\atom, 2U), depth, 1)
        if: \out_ty >= 100
            return: 0
        return: 1
return: 1


# Return types whose zero is unsigned: size_t, unsigned, ulong (old LmxMsgAddr folded into unsigned). They part company
# only where the type is printed, never where a zero is produced.
fn: l2_ret_uns (int: mi) int
    if: mi < 0 || l2_m_ret = 0
        return: 0
    if: l2_m_ret[mi] = 2 || l2_m_ret[mi] = 30 || l2_m_ret[mi] = 33 || l2_m_ret[mi] = 36
        return: 1
return: 0

# WHAT STOOD HERE AND IS GONE (FABLE-SONNET-NAME-SPECIALS-20260924-155 commit 4):
# l2_array_local, the L2 c.array: [char name size] local-declarator special (plan
# §7a "L2 c.array (declarator, not a call)"). Measured (commit 1, steps/name-
# specials-inventory.md): zero current .lm2 fixtures use the L2-level form (all
# migrated to ordinary own-array locals, 17d54bc); its 5 call sites (l2_ml_collect,
# l2_check_fields, and l2_emit_loc_stmt's guard + its own emission arm) are deleted
# alongside it. c.array: in an L2 source is now just an ordinary c.* raw-door frame
# -- door text the C compiler checks, no L2-side recognition, no replacement syntax,
# no helper. l2trans.lm1's OWN ~70 L1-level c.array: declarations (a different axis
# entirely -- l1trans's syntax, used to write ITS OWN buffers, never read by this
# function) are untouched; so is the separate, HOLD, unproven L1 c.array: EMISSION
# gap (next_core_tasks.md "L1 c.array (separate, unproven -- do not merge)").

fn: l2_check_os_fn (const: @(LmP0Node fn); const: @(char path)) int
    @: LmP0Field f
    @: LmP0Field p
    @: LmP0Field ty
    @: LmP0Field inner
    @: LmP0Structure tr
    @: LmP0Field r
    if: fn = 0 || l2_frame_head(fn, "fn") = 0 || fn\as = 0 || fn\as\frame = 0 || fn\as\frame\body = 0
        return: l2_error(path, fn, "unsupported body")
    if: l2_count_active(fn\as\frame\body) != 3
        return: l2_error(path, fn, "unsupported body")
    f: l2_next_active(fn\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f\value\as\atom) = 0
        return: l2_error(path, fn, "incompatible entry signature")
    p: l2_next_active(f\next)
    if: p = 0 || l2_empty_struct(p\value) = 0
        return: l2_error(path, fn, "incompatible entry signature")
    ty: l2_next_active(p\next)
    if: ty = 0 || ty\value = 0 || l2_frame_head(ty\value, "@") = 0 || ty\value\as = 0 || ty\value\as\frame = 0 || ty\value\as\frame\body = 0
        return: l2_error(path, fn, "incompatible entry signature")
    if: l2_count_active(ty\value\as\frame\body) != 1
        return: l2_error(path, fn, "incompatible entry signature")
    inner: l2_next_active(ty\value\as\frame\body\first_field)
    if: inner = 0 || inner\value = 0 || inner\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(inner\value\as\atom, "char") = 0
        return: l2_error(path, fn, "incompatible entry signature")
    tr: l2_ret_tr(fn\as\frame)
    if: tr = 0
        return: l2_error(path, fn, "unsupported body")
    if: l2_count_active(tr) != 1
        return: l2_error(path, fn, "unsupported argument")
    r: l2_next_active(tr\first_field)
    if: r = 0 || r\value = 0 || r\value\kind != c.LM_P0_NODE_ATOM || l2_quoted(r\value\as\atom) = 0
        return: l2_error(path, fn, "unsupported argument")
return: 0

fn: l2_os_fn_name (const: @(LmP0Node fn)) @: LmP0Text
    @: LmP0Field f
    if: fn = 0 || fn\as = 0 || fn\as\frame = 0 || fn\as\frame\body = 0
        return: 0
    f: l2_next_active(fn\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: f\value\as\atom

fn: l2_os_branches_match (const: @(LmP0Structure first); const: @(LmP0Structure other); const: @(char path)) int
    @: LmP0Field a
    @: LmP0Field b
    @: LmP0Text an
    @: LmP0Text bn
    if: first = 0 || other = 0
        return: l2_error(path, 0, "unsupported body")
    a: l2_next_active(first\first_field)
    b: l2_next_active(other\first_field)
    while: a != 0 && b != 0
        an: l2_os_fn_name(a\value)
        bn: l2_os_fn_name(b\value)
        if: an = 0 || bn = 0 || l2_text_same(an, bn) = 0
            return: l2_error(path, b\value, "incompatible os branches")
        a: l2_next_active(a\next)
        b: l2_next_active(b\next)
    if: a != 0 || b != 0
        return: l2_error(path, 0, "incompatible os branches")
return: 0

fn: l2_check_os (const: @(LmP0Node item); const: @(char path)) int
    @: LmP0Field b
    @: LmP0Field f
    const: @: LmP0Structure first 0
    if: item = 0 || l2_frame_head(item, "os") = 0 || item\as = 0 || item\as\frame = 0 || item\as\frame\body = 0
        return: l2_error(path, item, "unsupported body")
    b: l2_next_active(item\as\frame\body\first_field)
    if: b = 0
        return: l2_error(path, item, "unsupported body")
    while: b != 0
        if: l2_frame_head(b\value, "win") = 0 && l2_frame_head(b\value, "default") = 0
            return: l2_error(path, b\value, "unsupported body")
        if: b\value\as = 0 || b\value\as\frame = 0 || b\value\as\frame\body = 0
            return: l2_error(path, b\value, "unsupported body")
        f: l2_next_active(b\value\as\frame\body\first_field)
        if: f = 0
            return: l2_error(path, b\value, "unsupported body")
        while: f != 0
            if: l2_check_os_fn(f\value, path) != 0
                return: 1
            f: l2_next_active(f\next)
        if: first = 0
            first: b\value\as\frame\body
        else:
            if: l2_os_branches_match(first, b\value\as\frame\body, path) != 0
                return: 1
            ---
        b: l2_next_active(b\next)
return: 0

fn: l2_collect_os_methods (const: @(LmP0Node item); const: @(char path)) int
    @: LmP0Field branch
    @: LmP0Field method
    if: item = 0 || item\as = 0 || item\as\frame = 0 || item\as\frame\body = 0
        return: l2_error(path, item, "unsupported body")
    branch: l2_next_active(item\as\frame\body\first_field)
    if: branch = 0 || branch\value = 0 || branch\value\as = 0 || branch\value\as\frame = 0 || branch\value\as\frame\body = 0
        return: l2_error(path, item, "unsupported body")
    method: l2_next_active(branch\value\as\frame\body\first_field)
    while: method != 0
        if: l2_collect_method(method\value, path) != 0
            return: 1
        method: l2_next_active(method\next)
return: 0

fn: l2_method_is_os (int: mi) int
    @: LmP0Field branch
    @: LmP0Field method
    if: mi < 0 || mi >= l2_m_n || l2_os_node = 0 || l2_os_node\as = 0 || l2_os_node\as\frame = 0 || l2_os_node\as\frame\body = 0
        return: 0
    branch: l2_next_active(l2_os_node\as\frame\body\first_field)
    if: branch = 0 || branch\value = 0 || branch\value\as = 0 || branch\value\as\frame = 0 || branch\value\as\frame\body = 0
        return: 0
    method: l2_next_active(branch\value\as\frame\body\first_field)
    while: method != 0
        if: method\value = l2_m_node[mi]
            return: 1
        method: l2_next_active(method\next)
return: 0

fn: l2_emit_os_fn (@: FILE out; const: @(LmP0Node fn); const: @(char ind)) int
    @: LmP0Field f
    @: LmP0Structure tr
    @: LmP0Field r
    @: LmP0Text name
    int: mi
    if: out = 0 || fn = 0 || fn\as = 0 || fn\as\frame = 0 || fn\as\frame\body = 0
        return: 1
    f: l2_next_active(fn\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    name: f\value\as\atom
    mi: l2_find_method(name)
    if: mi < 0 || l2_method_is_os(mi) = 0
        return: 1
    if: fputs(ind, out) < 0
        return: 1
    if: fputs("fn: ", out) < 0
        return: 1
    if: l2_write_sym(out, mi) != 0
        return: 1
    if: l2_emit_sig(mi) != 0 || fputs("\n", out) < 0
        return: 1
    if: c.fprintf(out, "%s    if: self = 0\n%s        c.fprintf(c.stderr, \"lmx: invariant: a method was entered without its occurrence\\n\")\n%s        c.abort()\n", ind, ind, ind) < 0
        return: 1
    if: l2_emit_poll(mi, "            ") != 0
        return: 1
    tr: l2_ret_tr(fn\as\frame)
    if: tr = 0
        return: 1
    r: l2_next_active(tr\first_field)
    if: r = 0 || r\value = 0 || r\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    if: c.fprintf(out, "%s    ", ind) < 0
        return: 1
    if: fputs("return: ", out) < 0
        return: 1
    if: l2_write_text(out, r\value\as\atom) != 0
        return: 1
    if: fputs("\n", out) < 0
        return: 1
    if: fputs(ind, out) < 0 || fputs("end: ", out) < 0 || l2_write_sym(out, mi) != 0 || fputs("\n", out) < 0
        return: 1
return: 0

fn: l2_emit_os (@: FILE out) int
    @: LmP0Field b
    @: LmP0Field f
    if: out = 0 || l2_os_node = 0 || l2_os_node\as = 0 || l2_os_node\as\frame = 0 || l2_os_node\as\frame\body = 0
        return: 0
    if: fputs("os:\n", out) < 0
        return: 1
    b: l2_next_active(l2_os_node\as\frame\body\first_field)
    while: b != 0
        if: l2_frame_head(b\value, "win") = 0 && l2_frame_head(b\value, "default") = 0
            return: 1
        if: fputs("    ", out) < 0
            return: 1
        if: l2_write_text(out, b\value\as\frame\head) != 0
            return: 1
        if: fputs(":\n", out) < 0
            return: 1
        if: b\value\as = 0 || b\value\as\frame = 0 || b\value\as\frame\body = 0
            return: 1
        f: l2_next_active(b\value\as\frame\body\first_field)
        while: f != 0
            if: l2_emit_os_fn(out, f\value, "        ") != 0
                return: 1
            f: l2_next_active(f\next)
        b: l2_next_active(b\next)
    if: fputs("end: os\n", out) < 0
        return: 1
return: 0

fn: l2_formal_find (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_m_arity[mi]
        if: l2_text_same(l2_fn(mi, i), t)
            return: i
        i: i + 1
return: -1

fn: l2_dyn_find (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_m_dyn[mi]
        if: l2_text_same(l2_dn(mi, i), t)
            return: i
        i: i + 1
return: -1

fn: l2_param_find (int: mi; const: @(LmP0Text t)) int
    int: fi
    int: di
    fi: l2_formal_find(mi, t)
    if: fi >= 0
        return: fi
    di: l2_dyn_find(mi, t)
    if: di >= 0
        return: l2_m_arity[mi] + di
return: -1

fn: l2_param_is (int: mi; const: @(LmP0Text t)) int
    if: mi < 0 || t = 0
        return: 0
    if: l2_formal_find(mi, t) >= 0
        return: 1
    if: l2_dyn_find(mi, t) >= 0
        return: 1
return: 0

fn: l2_param_ty (int: mi; const: @(LmP0Text t)) int
    int: fi
    int: di
    if: mi < 0 || t = 0
        return: 0
    fi: l2_formal_find(mi, t)
    if: fi >= 0
        return: l2_ft(mi, fi)
    di: l2_dyn_find(mi, t)
    if: di >= 0 && l2_dt(mi, di) != 0
        return: l2_ft_of_own(l2_own_of_dt(l2_dt(mi, di)))
return: 0

fn: l2_is_asgn (const: @(LmP0Node stmt)) int
    const: @: LmP0Text h
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0
        return: 0
    h: stmt\as\frame\head
    if: h = 0 || l2_ident(h) = 0
        return: 0
    if: l2_frame_head(stmt, "if") || l2_frame_head(stmt, "else") || l2_frame_head(stmt, "while") || l2_frame_head(stmt, "for") || l2_frame_head(stmt, "return") || l2_frame_head(stmt, "fn") || l2_frame_head(stmt, "sub") || l2_frame_head(stmt, "end") || l2_frame_head(stmt, "char") || l2_frame_head(stmt, "int") || l2_frame_head(stmt, "size_t") || l2_frame_head(stmt, "unsigned") || l2_frame_head(stmt, "ulong") || l2_frame_head(stmt, "@") || l2_frame_head(stmt, "implements")
        return: 0
    if: l2_find_method(h) >= 0 || l2_is_known(h)
        return: 0
    if: h\length >= 2U && h\data[0] = 99 && h\data[1] = 46
        return: 0
    if: l2_text_eq(h, "receiveMessage")
        return: 0
    if: stmt\as\frame\body = 0
        return: 0
return: 1

# A bare colon frame has two roles.  If its right-hand atom already denotes a
# value, the frame keeps the ordinary assignment spelling `target: value`.
# Otherwise a graph-valued receiver in the head declares that atom by making a
# full merge copy of the receiver.  Normalize the second role to the one
# existing merge form before free-name, throws, checking and emission run, so
# there is one branch-creation path and no emitter-only constructor shortcut.
fn: l2_colon_model (const: @(LmP0Text name)) int
    int: ni
    if: name = 0
        return: 0
    ni: l2_ns_find(name)
    if: ni >= 0 && l2_ns_parent[ni] < 0
        return: 1
    if: l2_ebr_find(name) >= 0 || l2_mres_find(name) >= 0
        return: 1
return: 0

# The dynamic input used by a constructor is an ordinary graph reference.
# Intern the real source type rather than assigning a private/magic ABI code.
fn: l2_colon_graph_ty () int
    int: ft
    if: l2_colon_lmx_name = 0
        l2_colon_lmx_name: (cast: (@: LmP0Text) calloc(1U, c.sizeof(c.LmP0Text)))
        if: l2_colon_lmx_name = 0
            return: 0
        l2_colon_lmx_name\data: "Lmx"
        l2_colon_lmx_name\length: 3U
    ft: l2_foreign_intern(l2_colon_lmx_name, 1, 0)
    if: ft < 100
        return: 0
return: l2_dt_of_own(l2_own_ty_of_param(ft))

fn: l2_colon_is_graph_ty (int: ty) int
    int: fi
    int: oty
    # Declared graph formals store dt_of_own(1000+foreign); recover foreign @: Lmx.
    if: ty > 1
        oty: l2_own_of_dt(ty)
        if: oty >= 1000 && oty < 2000
            ty: l2_ft_of_own(oty)
        ---
    ---
    if: ty < 100
        return: 0
    fi: ty - 100
    if: fi < 0 || fi >= l2_foreign_n
        return: 0
    if: l2_foreign_depth[fi] != 1 || l2_foreign_const[fi] != 0
        return: 0
return: l2_text_eq(l2_foreign_name[fi], "Lmx")

# Layout collection sees every own slot before execution.  That is deliberately
# not the same thing as a binding existing at this colon.  Only formals and
# declarations already passed in this body make the tail an update value.
fn: l2_colon_bound_before (const: @(LmP0Structure body); const: @(LmP0Node stop); int: mi; const: @(LmP0Text name)) int
    @: LmP0Field f
    @: LmP0Text dn
    if: name = 0
        return: 0
    if: l2_param_find(mi, name) >= 0
        return: 1
    if: body != 0
        f: l2_next_active(body\first_field)
        while: f != 0 && f\value != stop
            if: l2_own_decl_ty(f\value) != 0
                dn: l2_own_decl_name(f\value)
                if: l2_text_same(dn, name)
                    return: 1
                ---
            f: l2_next_active(f\next)
        ---
    if: l2_ns_find(name) >= 0 || l2_ebr_find(name) >= 0 || l2_mres_find(name) >= 0 || l2_find_method(name) >= 0 || l2_is_known(name)
        return: 1
return: 0

# Type codes here are the translator's existing formal/local codes.  Two
# negative codes are intrinsic literal classes: a numeric literal has no
# declared width yet, and a quoted literal is a character pointer value.
fn: l2_colon_bound_ty (int: mi; const: @(LmP0Text name); @: int out_ty) int
    int: i
    if: name = 0 || out_ty = 0
        return: 1
    i: l2_formal_find(mi, name)
    if: i >= 0
        \out_ty: l2_ft(mi, i)
        return: 0
    i: l2_dyn_find(mi, name)
    if: i >= 0 && l2_dt(mi, i) != 0
        \out_ty: l2_ft_of_own(l2_own_of_dt(l2_dt(mi, i)))
        return: 0
    if: i >= 0
        return: 1
    i: l2_own_find_last(mi, name)
    if: i >= 0
        \out_ty: l2_ft_of_own(l2_own_ty[i])
        return: 0
    i: l2_slot_find(mi, name)
    if: i >= 0
        \out_ty: l2_st[l2_slot_off(mi, i)]
        return: 0
    i: l2_ml_find(name)
    if: i >= 0
        \out_ty: l2_ml_ty[i]
        return: 0
    ---
return: 1

fn: l2_colon_simple_ty (const: @(LmP0Node value); int: mi; @: int out_ty) int
    int: m
    int: sty
    const: @: LmP0Text atom
    if: value = 0 || out_ty = 0 || value\as = 0
        return: 1
    if: value\kind = c.LM_P0_NODE_ATOM
        atom: value\as\atom
        if: l2_num(atom) || l2_signed_num(atom) || (atom != 0 && atom\length >= 3U && atom\data[0] = 39 && atom\data[atom\length - 1U] = 39)
            \out_ty: -10
            return: 0
        if: l2_quoted(atom)
            \out_ty: -11
            return: 0
        return: l2_colon_bound_ty(mi, atom, out_ty)
    if: value\kind != c.LM_P0_NODE_FRAME || value\as\frame = 0 || value\as\frame\head = 0
        return: 1
    # sizeof: / length are operators whose result is size_t (storage bytes / element count).
    if: l2_text_eq(value\as\frame\head, "sizeof") || l2_text_eq(value\as\frame\head, "length")
        \out_ty: 2
        return: 0
    ---
    # A call by name or through a callable field path (`Holder\viaPath(4U)`).
    m: l2_head_method(value\as\frame\head)
    # A predef'd C function (l2_is_known: the c.* door, or a name the unit's
    # own predef: files declare) is an external ABI leaf, not an L2 method
    # l2_head_method can find. Assigning its result already works in every
    # non-assignment expression context (`if: lm_p0_parse_file(...) != 0`,
    # entry_parse_min.lm2), which needs no type at all; only this narrower
    # `target: call()` compatibility pre-check did not (Opus's finding 2,
    # FABLE-SONNET-DECL-PREPASS-20260923-137 part 3: "assignment value has
    # unknown type"). FABLE-SONNET-PREDEF-RESULT-TYPE-20260924-160 commit 2
    # (steps/predef-result-type-inventory.md): l2_predef_result_ty reads the
    # function's own prototype: declaration for its real return type (the
    # same file l2_is_known already re-parses for the yes/no check) -- a
    # predef'd function's result now carries its declared type, the same as
    # a real L2 method's would. -10 (the numeric-literal code, safe into a
    # numeric target, fail-closed into anything else) remains only for a
    # genuine `c.*` door call, which has no prototype anywhere to read
    # (measured, commit 1: no corpus fixture assigns one into a non-numeric
    # target; the norm gives raw door text to gcc, not to L2 type inference).
    if: m < 0 && l2_is_known(value\as\frame\head) != 0
        if: l2_predef_result_ty(value\as\frame\head, out_ty) = 0
            \out_ty: -10
        return: 0
    if: m < 0
        return: 1
    \out_ty: l2_m_ret[m]
    # A named-Structure return is stored dt_of_own(1000+foreign)
    # (l2_colon_graph_ty), the same recovery l2_colon_bound_ty's own-field
    # branch already applies (l2_ft_of_own(l2_own_ty[i])) -- a call result's
    # type must match it, or `target: b\value` from `Model: fresh` two
    # lines above stays the only working consumer of a Structure result
    # (FABLE-SONNET-DECL-PREPASS-20260923-137 part 2).
    if: \out_ty > 1
        sty: l2_own_of_dt(\out_ty)
        if: sty >= 1000 && sty < 2000
            \out_ty: l2_ft_of_own(sty)
        ---
    # Return codes and formal codes only differ for these ABI spellings.
    if: \out_ty = 33
        \out_ty: 34
    if: \out_ty = 3
        \out_ty: 12
    if: \out_ty = 35
        \out_ty: 3
    if: \out_ty = 32
        \out_ty: 17
return: 0

fn: l2_colon_types_compatible (int: target_ty; int: value_ty) int
    int: target_numeric 0
    int: value_numeric 0
    if: target_ty = 0 || target_ty = 1 || target_ty = 2 || target_ty = 10 || target_ty = 34 || target_ty = 36
        target_numeric: 1
    if: value_ty = -10 || value_ty = 0 || value_ty = 1 || value_ty = 2 || value_ty = 10 || value_ty = 34 || value_ty = 36
        value_numeric: 1
    if: target_numeric != 0 && value_numeric != 0
        return: 1
    if: value_ty = -11 && (target_ty = 3 || target_ty = 12)
        return: 1
    if: target_ty = value_ty
        return: 1
return: 0

# The general expression checker still owns compound expressions.  For the
# single-value form that decides the contextual colon role, both sides already
# have translation-time types, so refuse an incompatible pair here rather than
# emitting invalid C and pretending that the assignment was typed.
fn: l2_colon_check_assignment (const: @(LmP0Node stmt); int: mi; const: @(char path)) int
    c.array: [1024]: char lpd
    size_t: lpn 0U
    int: lkind 0
    int: lelem 0
    int: ldepth 0
    size_t: li0 0U
    @: LmP0Field only
    int: target_ty
    int: value_ty
    if: l2_is_asgn(stmt) = 0 || stmt = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || stmt\as\frame\body = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 1
        return: 0
    if: l2_colon_bound_ty(mi, stmt\as\frame\head, @ target_ty) != 0
        return: 0
    if: target_ty >= 100 && l2_foreign_const[target_ty - 100] != 0
        return: l2_error(path, stmt, "const write")
    only: l2_next_active(stmt\as\frame\body\first_field)
    if: only = 0 || l2_colon_simple_ty(only\value, mi, @ value_ty) != 0
        return: l2_error(path, stmt, "assignment value has unknown type")
    if: only\value != 0 && only\value\kind = c.LM_P0_NODE_FRAME && only\value\as != 0 && only\value\as\frame != 0 && l2_text_eq(only\value\as\frame\head, "sizeof")
        if: l2_check_sizeof(only\value, mi, path) != 0
            return: 1
    ---
    if: only\value != 0 && only\value\kind = c.LM_P0_NODE_FRAME && only\value\as != 0 && only\value\as\frame != 0 && l2_text_eq(only\value\as\frame\head, "length")
        if: l2_array_length_own(only\value, mi) < 0 && l2_arr_len_shape(only\value, lpd, @ lpn, @ lkind, @ lelem, @ ldepth, @ li0) != 0
            return: l2_error(path, only\value, "length requires one known primitive own array")
    ---
    # FABLE-SONNET-DIAG-AND-INDEX-20260924-163 commit 1 (D-40): a call whose
    # callee has no result (value_ty = 8, l2_colon_simple_ty's own void code,
    # the same one a real sub or a void-returning predef gives) refuses with
    # the ONE existing "no result" text everywhere this shape is caught, not
    # the generic incompatible-type message -- matching l2_check_value_call
    # (the bare-atom case) and l2_check_call's own argument-position check.
    if: value_ty = 8
        return: l2_error(path, stmt, "a callable without a result has no value")
    if: l2_colon_types_compatible(target_ty, value_ty) = 0
        return: l2_error(path, stmt, "assignment value has incompatible type")
    if: only\value != 0 && only\value\kind = c.LM_P0_NODE_ATOM && l2_check_literal_kind(only\value\as\atom, l2_lit_kind_from_ft(target_ty), path, stmt) != 0
        return: 1
    # Reference rebinding requires execution of the receiving expression's
    # language-level unit tests.  The legacy positional RuntimeImplements walk
    # is not that operation, and no graph-interpreter admission entry exists in
    # the current kernel ABI, so this case stays explicit fail-closed.
    if: l2_colon_is_graph_ty(target_ty) != 0 && l2_colon_is_graph_ty(value_ty) != 0
        # An untyped graph into a Structure-typed own field: admitted at run time.
        if: l2_formal_find(mi, stmt\as\frame\head) < 0 && l2_graph_nsty(mi, stmt\as\frame\head) >= 0 && l2_untyped_graph(mi, only\value) != 0
            return: l2_admit_site(mi)
        if: only\value\kind = c.LM_P0_NODE_ATOM && l2_nsty_of_name(mi, stmt\as\frame\head) >= 0 && l2_nsty_of_name(mi, only\value\as\atom) >= 0
            return: l2_admit_consumer_uses(only\value\as\atom, l2_nsty_of_name(mi, stmt\as\frame\head), stmt\as\frame\head, l2_fn_frame(mi), path, stmt, "assignment")
        return: l2_error(path, stmt, "graph assignment admission requires receiving-expression tests")
return: 0

# Recognizes the `Model: fresh` declaration shape in place -- absent head,
# a single-atom body, head resolves as a model/type per l2_colon_model --
# without rewriting the AST. FABLE-SONNET-DECL-BINDING-20260922-105: this
# replaces l2_colon_rewrite_decl; the declaration is registered as an own
# field and its construction emitted inline at this exact statement instead
# of being hoisted into a merge-shaped node built once at unit-entry time.
fn: l2_colon_decl_shape (const: @(LmP0Node stmt); @@: LmP0Text out_model; @@: LmP0Text out_name) int
    @: LmP0Frame fr
    @: LmP0Field only
    if: out_model = 0 || out_name = 0
        return: 1
    \out_model: 0
    \out_name: 0
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0
        return: 1
    fr: stmt\as\frame
    if: fr\head = 0 || fr\body = 0 || fr\trailer != 0 || fr\body\trailer != 0 || l2_count_active(fr\body) != 1
        return: 1
    only: l2_next_active(fr\body\first_field)
    if: only = 0 || only\value = 0 || only\value\kind != c.LM_P0_NODE_ATOM || only\value\as = 0 || only\value\as\atom = 0 || l2_ident(only\value\as\atom) = 0
        return: 1
    if: l2_colon_model(fr\head) = 0
        return: 1
    \out_model: fr\head
    \out_name: only\value\as\atom
return: 0

# `f()`, `f: ()` and the closed empty vertical, name absent (FABLE-SONNET-
# EMPTY-STRUCT-20260923-132, book SS10/SS12, after -127's P0 parity all
# three spellings are the identical Frame -- head plus a body with 0
# active fields). When that head resolves to nothing at all -- not a
# formal, own field, slot, merge result or model/type name -- the empty
# Structure-body itself supplies the structural type: this is a
# declaration, not a failed call, the same as l2_colon_decl_shape's
# `Model: fresh` minus a named model to merge from. Kept separate from
# l2_colon_decl_shape (whose other callers run before or without full name
# resolution, e.g. the dynamic-input pre-pass, and read a shape match as
# "a named model, merge-shaped, throws") rather than widening what a
# 0-argument body means to them too; this needs mi to resolve the head,
# which that shape check deliberately does not take.
#
# "Resolves to nothing" has to mean the same thing on BOTH calls this gets
# (l2_check_body's admission, then l2_emit_body's construction): once the
# first call has run l2_own_add for this exact statement, l2_own_find(mi,
# fr\head) finds THAT row on the second call, and a plain oi>=0 exclusion
# would make the shape stop matching its own declaration the moment
# emission looks for it -- measured: l2_emit_body never reached its
# construction branch, and l2_translate's own no-located-diagnostic
# safety net (the (c) fix, a few lines up) fired instead, since nothing
# had called l2_error. An existing row is only a genuine conflict when
# some OTHER statement declared it.
# `f()` -- one P0 tree with `f: ()` and the closed empty vertical: a Frame with an empty
# Structure-body -- when f already binds an ordinary Structure (the book §12; FABLE-OPUS-RECEIVER-
# CONTRACT-20260924-139): 1 an own field of graph type, of a declared Structure type or of none;
# 2 a declared named Structure, a unit child.  0 otherwise: absent (the -132 declaration below),
# a callable head (a call, -130; l2_is_asgn), or a binding that holds no Structure.
fn: l2_empty_struct_assign_shape (const: @(LmP0Node stmt); int: mi) int
    @: LmP0Frame fr
    int: oi
    int: ni
    if: l2_is_asgn(stmt) = 0
        return: 0
    fr: stmt\as\frame
    if: fr\body = 0 || fr\trailer != 0 || fr\body\trailer != 0 || l2_count_active(fr\body) != 0
        return: 0
    if: l2_param_find(mi, fr\head) >= 0 || l2_slot_find(mi, fr\head) >= 0 || l2_ml_find(fr\head) >= 0
        return: 0
    oi: l2_own_find(mi, fr\head)
    if: oi >= 0 && l2_own_decl[oi] != stmt
        return: l2_colon_is_graph_ty(l2_ft_of_own(l2_own_ty[oi]))
    if: oi >= 0
        return: 0
    ni: l2_ns_find(fr\head)
    if: ni >= 0 && l2_ns_parent[ni] < 0 && l2_ns_eternal[ni] < 0
        return: 2
return: 0

fn: l2_empty_struct_decl_shape (const: @(LmP0Node stmt); int: mi) int
    @: LmP0Frame fr
    int: existing
    if: l2_is_asgn(stmt) = 0
        return: 0
    fr: stmt\as\frame
    if: fr\body = 0 || fr\trailer != 0 || fr\body\trailer != 0 || l2_count_active(fr\body) != 0
        return: 0
    existing: l2_own_find(mi, fr\head)
    if: existing >= 0 && l2_own_decl[existing] != stmt
        return: 0
    if: l2_param_find(mi, fr\head) >= 0 || l2_slot_find(mi, fr\head) >= 0 || l2_ml_find(fr\head) >= 0 || l2_colon_model(fr\head) != 0
        return: 0
return: 1

# receiveMessage: m / receiveMessage: m Model (author, Q10, 2026-09-23; the
# two-name form, FABLE-SONNET-SEND-REF-20260925-172 commit 2) -- the general
# mail receiver: m is bound to the graph of the next admitted letter of the
# CURRENT Thread, and to 0 when its inbox is empty. It is a receiver of the
# profile, not syntax: a declared method named receiveMessage takes
# precedence, as every callable head does. m is an own field typed to the
# synthesized letter model (l2_letter_ns_for), declared by the first
# receiveMessage that names it and rebound by every later one. With a second
# name, that name is the user's model for the letter's payload (field 1);
# without one, the payload is untyped -- either way m\sender and, when typed,
# m\payload\<field> resolve as ordinary field paths. 0 = the shape (out_model
# 0 for the one-name form), 2 = the receiver with anything but one or two
# names, 1 = not it.
fn: l2_receive_msg_shape (const: @(LmP0Node stmt); @@: LmP0Text out_name; @@: LmP0Text out_model) int
    @: LmP0Frame fr
    @: LmP0Field only
    @: LmP0Field second
    if: out_name = 0
        return: 1
    \out_name: 0
    if: out_model != 0
        \out_model: 0
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0
        return: 1
    fr: stmt\as\frame
    if: fr\head = 0 || l2_text_eq(fr\head, "receiveMessage") = 0 || l2_find_method(fr\head) >= 0
        return: 1
    if: fr\body = 0 || fr\trailer != 0 || fr\body\trailer != 0 || (l2_count_active(fr\body) != 1 && l2_count_active(fr\body) != 2)
        return: 2
    only: l2_next_active(fr\body\first_field)
    if: only = 0 || only\value = 0 || only\value\kind != c.LM_P0_NODE_ATOM || only\value\as = 0 || only\value\as\atom = 0 || l2_ident(only\value\as\atom) = 0
        return: 2
    if: l2_count_active(fr\body) = 2
        second: l2_next_active(only\next)
        if: second = 0 || second\value = 0 || second\value\kind != c.LM_P0_NODE_ATOM || second\value\as = 0 || second\value\as\atom = 0 || l2_ident(second\value\as\atom) = 0
            return: 2
        \out_name: only\value\as\atom
        if: out_model != 0
            \out_model: second\value\as\atom
        return: 0
    \out_name: only\value\as\atom
return: 0

# The fixed field names of a synthesized letter model, cached like l2_lmx_text.
@: LmP0Text l2_sender_name_cache 0
fn: l2_sender_text () @: LmP0Text
    if: l2_sender_name_cache != 0
        return: l2_sender_name_cache
    l2_sender_name_cache: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    if: l2_sender_name_cache = 0
        return: 0
    l2_sender_name_cache\data: "sender"
    l2_sender_name_cache\length: 6U
return: l2_sender_name_cache

@: LmP0Text l2_payload_name_cache 0
fn: l2_payload_text () @: LmP0Text
    if: l2_payload_name_cache != 0
        return: l2_payload_name_cache
    l2_payload_name_cache: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    if: l2_payload_name_cache = 0
        return: 0
    l2_payload_name_cache\data: "payload"
    l2_payload_name_cache\length: 7U
return: l2_payload_name_cache

# A deterministic, never-source-spellable name for a synthesized letter
# model, so it is traceable (and distinct per payload model) without ever
# being findable by l2_ns_find over real source text: a leading space is not
# a character any L2 identifier can start with. 0 model = the untyped letter.
fn: l2_letter_synth_name (const: @(LmP0Text model)) @: LmP0Text
    @: LmP0Text r
    @: char buf
    r: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    if: r = 0
        return: 0
    if: model = 0
        r\data: " receiveMessage"
        r\length: 16U
        return: r
    buf: (cast: (@: char) l2_xmalloc((cast: (size_t) model\length) + 1U))
    if: buf = 0
        return: 0
    buf[0]: 32
    memcpy((cast: (@: void) (buf + 1)), (cast: (@: void) model\data), model\length)
    r\data: buf
    r\length: model\length + 1U
return: r

# The synthesized letter model for a receiveMessage payload (0 model =
# untyped): a Structure {sender: @: LmxMsg; payload: Model}, memoized by
# model so every receive site naming the same model -- or none -- shares one
# entry (a letter's shape is a type, not a per-site construction). The
# untyped payload uses the SAME general reference kind (10) the sender field
# does, pointee Lmx (the generic model projection, l2_lmx_text) -- not kind 3
# with no target: kind 3's own resolution is deferred to a later pass over
# the whole unit and its construction-phase arm (l2trans.lm1's own eternal/
# instance builders) indexes l2_nsp by l2_nsf_ref unconditionally, which a
# permanently-unresolved -1 would read out of bounds. Kind 10 has no such
# forward-reference step; its pointee is resolved immediately, exactly like
# a formal's or local's `@: Lmx` would be.
fn: l2_letter_ns_for (const: @(LmP0Text model); const: @(LmP0Node at); const: @(char path); @: int out_ni) int
    int: k 0
    int: mni 0 - 1
    int: ni
    int: lmx_ty
    @@: LmP0Text gn
    @: int gi
    size_t: want
    if: out_ni = 0
        return: 1
    \out_ni: -1
    while: k < l2_letter_model_n
        if: model = 0 && l2_letter_model_name[k] = 0
            \out_ni: l2_letter_model_ns[k]
            return: 0
        if: model != 0 && l2_letter_model_name[k] != 0 && l2_text_same(l2_letter_model_name[k], model) != 0
            \out_ni: l2_letter_model_ns[k]
            return: 0
        k: k + 1
    ---
    if: model != 0
        mni: l2_ns_find(model)
        if: mni < 0
            return: l2_error(path, at, "receiveMessage: unknown payload model")
        ---
    ---
    ni: l2_ns_push(l2_letter_synth_name(model), 0 - 1, at)
    if: ni < 0
        return: l2_error(path, at, "out of memory")
    l2_ns_first[ni]: l2_nsf_n
    if: l2_nsf_push(10, 0U, 29, ni) < 0
        return: l2_error(path, at, "out of memory")
    l2_nsf_fname[l2_nsf_n - 1]: l2_sender_text()
    if: model != 0
        if: l2_nsf_push(3, 0U, mni, ni) < 0
            return: l2_error(path, at, "out of memory")
        l2_nsf_fname[l2_nsf_n - 1]: l2_payload_text()
    else:
        lmx_ty: l2_foreign_intern(l2_lmx_text(), 1, 0)
        if: lmx_ty < 100
            return: l2_error(path, at, "out of memory")
        if: l2_nsf_push(10, 0U, lmx_ty, ni) < 0
            return: l2_error(path, at, "out of memory")
        l2_nsf_fname[l2_nsf_n - 1]: l2_payload_text()
    ---
    l2_ns_count[ni]: 2
    want: (cast: (size_t) (l2_letter_model_n + 1))
    gn: (cast: (@@: LmP0Text) realloc((cast: (@: void) l2_letter_model_name), want * c.sizeof(@: void)))
    if: gn = 0
        return: l2_error(path, at, "out of memory")
    l2_letter_model_name: gn
    gi: (cast: (@: int) realloc((cast: (@: void) l2_letter_model_ns), want * c.sizeof(c.int)))
    if: gi = 0
        return: l2_error(path, at, "out of memory")
    l2_letter_model_ns: gi
    l2_letter_model_name[l2_letter_model_n]: (cast: (@: LmP0Text) model)
    l2_letter_model_ns[l2_letter_model_n]: ni
    l2_letter_model_n: l2_letter_model_n + 1
    \out_ni: ni
return: 0

# Does a body take a letter anywhere? Such a method declares the two locals
# of the take (the letter record and its graph).
fn: l2_body_receives (const: @(LmP0Structure body)) int
    @: LmP0Field field
    @: LmP0Field inner
    @: LmP0Node stmt
    @: LmP0Text nm
    if: body = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0 && l2_body_receives(stmt\as\structure) != 0
            return: 1
        if: l2_receive_msg_shape(stmt, @ nm, 0) = 0
            return: 1
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0
            inner: l2_next_active(stmt\as\frame\body\first_field)
            while: inner != 0
                if: inner\value != 0 && inner\value\kind = c.LM_P0_NODE_STRUCTURE && inner\value\as != 0 && l2_body_receives(inner\value\as\structure) != 0
                    return: 1
                inner: l2_next_active(inner\next)
            ---
        ---
        field: l2_next_active(field\next)
    ---
return: 0

# THE OWN STORAGE CODE OF A FORMAL'S TYPE (FABLE-L2-ARG-ADDRESS-DIRTY-20260921-67).  Argument-as-own
# binding is one mechanism for every argument type that can be assigned; the TYPE decides only
# which graph cell holds the published value.  Formal codes and own storage codes are different
# number spaces (unsigned is 34 as a formal and 3 as an own field; a pointer formal r is the own
# field 1000 + r, the same code a declared pointer own has), so every comparison between the two
# goes through this one function instead of comparing the raw numbers.  -1 is "the graph has no
# cell for this type today", never "this type is not eligible": pointers of every depth and
# pointee go to the one generic pointer cell.
fn: l2_own_ty_of_param (int: ft) int
    if: ft = 34
        return: 3
    if: l2_pointer_depth(ft) > 0
        return: 1000 + ft
    if: ft = 0 || ft = 1 || ft = 2 || ft = 36
        return: ft
return: -1

# The inverse: the FORMAL code of an own storage code.
fn: l2_ft_of_own (int: oty) int
    if: oty = 3
        return: 34
    if: oty >= 1000 && oty < 2000
        return: oty - 1000
return: oty

# THE TYPE CODE OF A HIDDEN/DYNAMIC INPUT (FABLE-L2-ARG-ADDRESS-PROOF-20260921-84).  It used to be the
# own storage code itself with 0 for "not typed yet" -- and int's storage code IS 0.  So an int
# could not be a dynamic input at all: a callee reading the caller's int never got it, and the
# typing fixed point never ended (it stored 0 over 0 and reported a change on every pass).
# Around that hole five separate lists named the types that did work, char and size_t, and one
# of them compared a FORMAL code with this code raw -- the two-number-spaces mistake once more.
# Now the code is the own storage code PLUS ONE and 0 alone is "not typed yet".  These two
# functions are the only place that knows it; nothing else adds or subtracts one.  Eligibility
# is the question the publication descriptor already answers: is there a value cell.
fn: l2_dt_of_own (int: oty) int
    if: oty < 0 || l2_own_store_helper(oty) = 0
        return: 0
return: oty + 1

fn: l2_own_of_dt (int: dt) int
    if: dt <= 0
        return: -1
return: dt - 1

# THE ONE BOUNDARY where a type that cannot travel as a dynamic input is refused.  A SOURCE was
# found -- the caller's own field or formal, or the body's own same-name field -- and its type
# has no value cell.  That is said here, by name; it must not surface later as a free name
# nobody could resolve, and never as a formal the signature quietly lacks.
fn: l2_dt_of_source (int: oty; const: @(char path); const: @(LmP0Node at); @: int dt) int
    if: dt = 0
        return: 1
    \dt: l2_dt_of_own(oty)
    if: \dt = 0
        return: l2_error(path, at, "dynamic input type has no value cell")
return: 0

# The one formula for "the C expression that reaches own field oi's cell":
# fid>=0 is a hosted field (reached through another namespace slot's own
# child), else the field's own occurrence via l2_own_ctr. Every emitter
# that needs this address -- the dirty-load cache (l2_emit_own_from
# below), an array leaf, a single-hop path read -- writes it into dest
# rather than each hand-inlining the same two branches
# (FABLE-SONNET-OWN-LOOKUP-AUDIT-20260923-131 (a): they had drifted --
# one copy missing l2_emit_own_from's own cache guard).
fn: l2_own_from_expr (int: oi; @: char dest) int
    if: oi < 0 || dest = 0
        return: 1
    if: l2_own_fid[oi] >= 0 && c.sprintf(dest, "lmx_arena_ref_cell(l2_h%d, %uU)", l2_own_fid[oi], (cast: (unsigned) l2_own_fchild[oi])) < 0
        return: 1
    if: l2_own_fid[oi] < 0 && c.sprintf(dest, "lmx_arena_ref_cell(%s, %uU)", l2_own_ctr(oi), (cast: (unsigned) l2_own_uchild[oi])) < 0
        return: 1
return: 0

# A DIRECT own field (-189 c3b-1, c3b-2, c3b-3): a number -- int, char, size_t, unsigned, ulong -- or
# a pointer is its cell, and an own Structure field its slot (l2_own_is_slot).  It has no working
# copy: a read is a typed load (l2_own_load) and a write a typed store (l2_own_store), so there is
# nothing to publish at a call or an exit.  A field bound to a formal or a dynamic input is one too, from
# its binding line on (l2_formal_row); before that line the name is the machine argument.
fn: l2_own_direct (int: mi; int: k) int
    int: ty
    if: mi < 0 || k < 0 || k >= l2_own_n
        return: 0
    ty: l2_own_ty[k]
return: ty = 0 || ty = 1 || ty = 2 || ty = 3 || ty = 36 || l2_own_is_pointer(ty) != 0

# AN OWN STRUCTURE FIELD IS A DIRECT SLOT (-189 c3b-3; q26: an own binding is the slot itself, a
# reference `@: T x` a pointer cell): a field of the graph type whose declaration is not a pointer
# declaration -- `Model: m`, `T: m`, `receiveMessage: m`, `f()`, a Structure catch parameter.  Its
# slot holds the Structure, empty (0) until the field is bound; the builder makes no cell for it.
fn: l2_own_is_slot (int: k) int
    if: k < 0 || k >= l2_own_n || l2_own_is_pointer(l2_own_ty[k]) = 0 || l2_colon_is_graph_ty(l2_dt_of_own(l2_own_ty[k])) = 0
        return: 0
return: l2_frame_head(l2_own_decl[k], "@") = 0

# The container and index of own field k's slot, "ctr, NU" -- the two halves of l2_own_from_expr.
fn: l2_own_slot_at (int: k; @: char dest) int
    if: k < 0 || dest = 0
        return: 1
    if: l2_own_fid[k] >= 0
        return: (cast: (int) (c.sprintf(dest, "l2_h%d, %uU", l2_own_fid[k], (cast: (unsigned) l2_own_fchild[k])) < 0))
return: (cast: (int) (c.sprintf(dest, "%s, %uU", l2_own_ctr(k), (cast: (unsigned) l2_own_uchild[k])) < 0))

# Load own field k from the slot address l2_xp into temporary t: a slot holds the Structure itself,
# any other field a typed cell (l2_emit_cell_load).
fn: l2_emit_own_cell_load (int: k; const: @(char ind); int: t; const: @(LmP0Node at)) int
    c.array: [1024]: char txt
    c.array: [1024]: char dcl
    c.array: [32]: char nm
    if: l2_own_is_slot(k) = 0
        return: l2_emit_cell_load(l2_own_ty[k], ind, t, at)
    if: c.sprintf(nm, "l2_t%d", t) < 0 || l2_pointer_decl_text(l2_own_ty[k] - 1000, 0, nm, dcl) != 0 || l2_pointer_decl_text(l2_own_ty[k] - 1000, 0, 0, txt) != 0
        return: 1
return: (cast: (int) (c.fprintf(l2_out, "%s%s\n%sl2_t%d: (cast: (%s) l2_xp[0])\n", ind, dcl, ind, t, txt) < 0))

# The parameter of mi (a formal, or a dynamic input) that own field k's name names, or -1: a field
# of that name binds it -- at method level, or in a body, whose hosted field it then is (fable).
fn: l2_own_formal (int: mi; int: k) int
    if: mi < 0 || k < 0 || k >= l2_own_n
        return: 0 - 1
return: l2_param_find(mi, l2_own_name[k])

# THE BOUND ROW (-189 c3b-2; R2 with carry, static by position -- L3 §12).  Parameter pk of mi
# (a formal, or a dynamic input) names the machine argument until an own field bound to it has had
# its binding line -- its declaration, or its first bare assignment -- and that field from then on.
# A formal's binding is not scoped to a nested body (D-79): only a field declared in that body
# ends when the body ends (l2_emit_body).  The latest mark wins; -1 is the machine argument.
fn: l2_formal_row (int: mi; int: pk) int
    int: k 0
    int: best 0 - 1
    while: k < l2_own_n
        if: l2_own_mi[k] = mi && l2_own_bseq[k] > 0 && l2_own_formal(mi, k) = pk && (best < 0 || l2_own_bseq[k] > l2_own_bseq[best])
            best: k
        k: k + 1
    ---
return: best

# The direct own field a bare name means at this point of the emission, or -1: a formal's bound
# row (l2_formal_row), else the method's own field of that name.
fn: l2_name_cell (int: mi; const: @(LmP0Text t)) int
    int: pi l2_param_find(mi, t)
    int: k
    if: pi >= 0
        return: l2_formal_row(mi, pi)
    k: l2_own_find_last(mi, t)
    if: k >= 0 && l2_own_direct(mi, k) != 0
        return: k
return: 0 - 1

# The typed load of direct own field k's cell, spelled into dest.
fn: l2_own_load (int: k; @: char dest) int
    int: ty l2_own_ty[k]
    c.array: [1024]: char txt
    if: ty = 0
        return: (cast: (int) (c.sprintf(dest, "lmx_int_value_known(l2_q%d_from[0])", k) < 0))
    if: ty = 1
        return: (cast: (int) (c.sprintf(dest, "(cast: (char) lmx_char_value_known(l2_q%d_from[0]))", k) < 0))
    if: ty = 2
        return: (cast: (int) (c.sprintf(dest, "lmx_size_value_known(l2_q%d_from[0])", k) < 0))
    if: ty = 3
        return: (cast: (int) (c.sprintf(dest, "lmx_unsigned_value_known(l2_q%d_from[0])", k) < 0))
    if: ty = 36
        return: (cast: (int) (c.sprintf(dest, "lmx_ulong_value_known(l2_q%d_from[0])", k) < 0))
    if: l2_own_is_pointer(ty) != 0 && l2_pointer_decl_text(ty - 1000, 0, 0, txt) != 0
        return: 1
    if: l2_own_is_slot(k) != 0
        return: (cast: (int) (c.sprintf(dest, "(cast: (%s) l2_q%d_from[0])", txt, k) < 0))
    if: l2_own_is_pointer(ty) != 0
        return: (cast: (int) (c.sprintf(dest, "(cast: (%s) lmx_pointer_value_known(l2_q%d_from[0]))", txt, k) < 0))
return: 1

# The address of direct own field k's cell, typed by the field (L2 §10: `@x` of a data field is its
# cell's address in the instance, stable for the instance's life) -- the same spelling l2_prep_addr
# gives an own field.
fn: l2_own_addr (int: k; @: char dest) int
    int: ty l2_own_ty[k]
    c.array: [1024]: char txt
    if: ty = 0
        return: (cast: (int) (c.sprintf(dest, "(cast: (@: int) l2_q%d_from[0])", k) < 0))
    if: ty = 1
        return: (cast: (int) (c.sprintf(dest, "(cast: (@: char) l2_q%d_from[0])", k) < 0))
    if: ty = 2
        return: (cast: (int) (c.sprintf(dest, "(cast: (@: size_t) l2_q%d_from[0])", k) < 0))
    if: ty = 3
        return: (cast: (int) (c.sprintf(dest, "(cast: (@: unsigned) l2_q%d_from[0])", k) < 0))
    if: ty = 36
        return: (cast: (int) (c.sprintf(dest, "(cast: (@: ulong) l2_q%d_from[0])", k) < 0))
    # A pointer field's cell is the address of its pointer.
    if: l2_own_is_pointer(ty) != 0 && l2_own_is_slot(k) = 0 && l2_pointer_decl_text(ty - 1000, 1, 0, txt) = 0
        return: (cast: (int) (c.sprintf(dest, "(cast: (%s) l2_q%d_from[0])", txt, k) < 0))
    # An own Structure field is a slot that holds the Structure itself (-189 c3b-3): `@mo` is that
    # reference, the slot's value -- what l2_own_load gives the slot (D-53).
    if: l2_own_is_pointer(ty) != 0 && l2_own_is_slot(k) != 0 && l2_pointer_decl_text(ty - 1000, 0, 0, txt) = 0
        return: (cast: (int) (c.sprintf(dest, "(cast: (%s) l2_q%d_from[0])", txt, k) < 0))
return: 1

# Store `val` into direct own field k's cell: the typed store, X1 when it fails; a char rebinds its
# interned cell.  The slot is bound first (the prelude has bound it already).  A field bound to a
# parameter is bound from its first store on (l2_formal_row): its binding line, whose value `val`
# was spelled before, while the name was still the argument.
fn: l2_own_store (int: mi; int: k; const: @(char ind); const: @(char val)) int
    const: @(char helper) 0
    c.array: [256]: char at
    if: k < 0 || ind = 0 || val = 0
        return: 1
    if: l2_own_bseq[k] = 0 && l2_own_formal(mi, k) >= 0
        l2_bseq_n: l2_bseq_n + 1
        l2_own_bseq[k]: l2_bseq_n
    ---
    helper: l2_own_store_helper(l2_own_ty[k])
    if: helper = 0 || l2_emit_own_from(mi, k, ind) != 0
        return: 1
    # An own Structure field binds its slot (-189 c3b-3); a pointer stores into its cell.
    if: l2_own_is_slot(k) != 0
        if: l2_own_slot_at(k, at) != 0
            return: 1
        return: (cast: (int) (c.fprintf(l2_out, "%sif: lmx_arena_ref_store(%s, (cast: (@: void) (%s))) != 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: own field %d store failed\\n\")\n%s    c.abort()\n%s---\n", ind, at, val, ind, k, ind, ind) < 0))
    ---
    if: l2_own_is_pointer(l2_own_ty[k]) != 0
        return: (cast: (int) (c.fprintf(l2_out, "%sif: lmx_pointer_store_known(l2_q%d_from[0], (cast: (@: void) (%s))) != 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: own field %d store failed\\n\")\n%s    c.abort()\n%s---\n", ind, k, val, ind, k, ind, ind) < 0))
    ---
    if: l2_own_store_rebinds(l2_own_ty[k]) != 0
        return: (cast: (int) (c.fprintf(l2_out, "%sl2_q%d_from[0]: %s(l2_q%d_from[0], ((cast: (int) (%s)) & 255))\n%sif: l2_q%d_from[0] = 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: own field %d store failed\\n\")\n%s    c.abort()\n%s---\n", ind, k, helper, k, val, ind, k, ind, k, ind, ind) < 0))
return: (cast: (int) (c.fprintf(l2_out, "%sif: %s(l2_q%d_from[0], (%s)) != 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: own field %d store failed\\n\")\n%s    c.abort()\n%s---\n", ind, helper, k, val, ind, k, ind, ind) < 0))

fn: l2_emit_own_from (int: mi; int: oi; const: @(char ind)) int
    c.array: [128]: char l2_eof_expr
    if: mi < 0 || oi < 0 || ind = 0
        return: 0
    if: l2_own_from_expr(oi, l2_eof_expr) != 0
        return: 1
    if: c.fprintf(l2_out, "%sif: l2_q%d_from = 0\n%s    l2_q%d_from: %s\n%sif: l2_q%d_from = 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: own field %d has no cell\\n\")\n%s    c.abort()\n", ind, oi, ind, oi, l2_eof_expr, ind, oi, ind, oi, ind) < 0
        return: 1
return: 0

fn: l2_collect_asgn_body (const: @(LmP0Structure body); int: mi; const: @(char path)) int
    int: pis 0
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Field last
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Text fa
    @: LmP0Text cmodel
    int: n
    int: k
    int: j
    int: ty
    int: oty
    int: used
    int: cj
    int: letni
    if: body = 0 || mi < 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        l2_vis_stmt(mi, stmt)
        if: l2_frame_head(stmt, "catch")
            if: l2_catch_body(stmt) != 0
                if: l2_scope_push(stmt) != 0
                    return: l2_alloc_or(path, stmt, "out of memory")
                if: l2_collect_asgn_body(l2_catch_body(stmt), mi, path) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            ---
            field: l2_next_active(field\next)
            continue
        # An anonymous `---` block is a nested executable body, like an if body (§14, Q14 K).
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0
            if: l2_scope_push(stmt) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_collect_asgn_body(stmt\as\structure, mi, path) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        # Ordinary merge operands are graph names resolved by the merge
        # pre-pass.  A colon declaration is different: its source receiver is
        # dynamically visible, with the same-name lexical Structure only the
        # fallback/type anchor, so it needs an ordinary @: Lmx hidden input.
        if: l2_merge_frame(stmt) != 0
            field: l2_next_active(field\next)
            continue
        # Model: fresh -- the declared name is bound here, not referenced;
        # same exclusion as l2_merge_frame above. The bare l2_own_add makes
        # the row exist so a later statement reading the name through \\field
        # resolves as an own field, not an undeclared dynamic input; counting
        # and binding stay l2_check_body's job -- its later call on the same
        # statement node finds this row and is a no-op past that point.
        # nsty (FABLE-SONNET-DECL-PREPASS-20260923-137): a field-path SEGMENT
        # walk through this name (l2_field_path_check/l2_path_kind) also needs
        # its Structure type, l2_own_nsty_get(oi) -- previously only recorded
        # when l2_check_body's OWN pass reached this exact declaration, and
        # l2_parse_unit always checks E last (S2), so a method checked before
        # E saw ni<0 and refused "unresolved name" on a compound-expression
        # read of a unit-level Structure field, though the identical path
        # already resolved fine as a bare write or a bare-RHS read (both need
        # only l2_path_root, l2_own_lookup_audit-131 part 3). This scan
        # already runs before any statement is checked (l2_collect_asgn_binds,
        # called early below, mirrors l2_merge_scan's existing precedent for
        # merge result names) -- recording the type here closes the gap with
        # no second mechanism.
        if: l2_colon_decl_shape(stmt, @ cmodel, @ fa) = 0
            cj: l2_own_add(mi, fa, l2_own_of_dt(l2_colon_graph_ty()), path, stmt)
            if: cj < 0
                return: 1
            if: l2_own_nsty_set(cj, l2_ns_find(cmodel)) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # receiveMessage: m declares m the same way (an own field of graph
        # type). receiveMessage: m Model (FABLE-SONNET-SEND-REF-20260925-172
        # commit 2) additionally types it to the synthesized letter model,
        # exactly as the colon-decl branch above types its own field --
        # cmodel is reused, the two branches never both match the same
        # statement. The bare (no-model) form stays untyped, unchanged: it is
        # admitted at run time into WHATEVER typed field it is later bound
        # to or assigned into (unit_admit_letter_formal.lm2 and its siblings
        # depend on this -- retyping it broke them, measured directly).
        if: l2_receive_msg_shape(stmt, @ fa, @ cmodel) = 0
            cj: l2_own_add(mi, fa, l2_own_of_dt(l2_colon_graph_ty()), path, stmt)
            if: cj < 0
                return: 1
            if: cmodel != 0
                if: l2_letter_ns_for(cmodel, stmt, path, @ letni) != 0
                    return: 1
                if: l2_own_nsty_set(cj, letni) != 0
                    return: 1
                ---
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE
                if: l2_scope_push(last\value) != 0
                    return: l2_alloc_or(path, stmt, "out of memory")
                if: l2_collect_asgn_body(last\value\as\structure, mi, path) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && nxt\value\as != 0 && nxt\value\as\frame != 0
                if: l2_scope_push(nxt\value) != 0
                    return: l2_alloc_or(path, nxt\value, "out of memory")
                if: l2_collect_asgn_body(nxt\value\as\frame\body, mi, path) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            ---
        if: l2_frame_head(stmt, "while")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: n >= 2 && last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE
                if: l2_scope_push(last\value) != 0
                    return: l2_alloc_or(path, stmt, "out of memory")
                if: l2_collect_asgn_body(last\value\as\structure, mi, path) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "for")
            if: l2_for_cstyle(stmt) = 0
                field: l2_next_active(field\next)
                continue
            if: l2_scope_push(stmt) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            last: l2_next_active(stmt\as\frame\body\first_field)
            k: 1
            while: k < 5
                last: l2_next_active(last\next)
                k: k + 1
            if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE && l2_collect_asgn_body(last\value\as\structure, mi, path) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt)
            fa: stmt\as\frame\head
            ty: l2_param_ty(mi, fa)
            pis: l2_param_is(mi, fa)
            j: -1
            used: 0
            # A data field is created only by a declaration (D-79, author). A bare assignment
            # never creates a field of the nested body it sits in. The first write binds the
            # formal as the method's one cell (L3 §12, host 0); a later write, from a nested
            # body too, uses that cell. A declaration already in this host (`int: n` in the
            # if) is that body's field and is the row the write uses.
            # oty < 0 is the one exception and it is a fact about the graph, not about this rule:
            # there is no cell that could hold the value, so the parameter stays a plain local.
            oty: -1
            if: pis != 0
                oty: l2_own_ty_of_param(ty)
            if: oty >= 0
                j: l2_own_find_host(mi, fa, l2_scope_host())
            if: oty >= 0 && j < 0
                j: l2_own_find_host(mi, fa, 0)
            if: oty >= 0 && j < 0 && l2_scope_n > 0
                cj: l2_scope_n
                l2_scope_n: 0
                j: l2_own_add(mi, fa, oty, path, stmt)
                l2_scope_n: cj
            if: oty >= 0 && j < 0
                j: l2_own_add(mi, fa, oty, path, stmt)
            if: oty >= 0 && j < 0
                return: 1
            if: oty >= 0 && l2_own_off(mi, j) = (cast: (size_t) -1)
                return: l2_error(path, stmt, "size overflow")
            if: oty >= 0
                used: l2_m_uses[l2_own_off(mi, j)]
            if: oty >= 0
                l2_m_uses[l2_own_off(mi, j)]: 1
            if: oty >= 0 && used = 0
                l2_m_own[mi]: l2_m_own[mi] + 1
            if: oty >= 0 && l2_bind_own(mi, j, path, stmt) != 0
                return: 1
            if: oty >= 0 && l2_own_nsty_set(j, l2_nsty_get(mi, l2_formal_find(mi, fa))) != 0
                return: 1
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt) = 0
            field: l2_next_active(field\next)
return: 0

fn: l2_collect_asgn_binds (const: @(char path)) int
    int: i 0
    while: i < l2_m_n
        l2_vis_method(i)
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_collect_asgn_body(l2_m_body[i]\as\structure, i, path) != 0
            return: 1
        i: i + 1
    l2_vis_on: 0
return: 0

fn: l2_bind_own (int: mi; int: oi; const: @(char path); const: @(LmP0Node at)) int
    int: fi 0
    int: sdt 0
    if: mi < 0 || oi < 0
        return: 0
    while: fi < l2_m_arity[mi]
        if: l2_text_same(l2_fn(mi, fi), l2_own_name[oi])
            # Formal codes and own storage codes are different number spaces: compare the CELL
            # the formal's type publishes to, never the raw numbers (unsigned is 34 and 3).
            if: l2_own_ty_of_param(l2_ft(mi, fi)) != l2_own_ty[oi]
                return: l2_error(path, at, "incompatible entry signature")
            if: l2_own_find_occ(mi, l2_own_name[oi], 0) = oi
                l2_m_alias[l2_own_off(mi, oi)]: fi
            ---
        fi: fi + 1
    fi: 0
    while: fi < l2_m_dyn[mi]
        if: l2_text_same(l2_dn(mi, fi), l2_own_name[oi])
            if: l2_dt_of_source(l2_own_ty[oi], path, at, @ sdt) != 0
                return: 1
            if: l2_dt(mi, fi) != 0 && l2_dt(mi, fi) != sdt
                return: l2_error(path, at, "incompatible entry signature")
            if: l2_dt_set(mi, fi, sdt) != 0
                return: 1
            l2_m_alias[l2_own_off(mi, oi)]: l2_m_arity[mi] + fi
        fi: fi + 1
return: 0

fn: l2_collect_decls (const: @(LmP0Structure body); int: mi; const: @(char path); int: depth; @: int sn) int
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Field last
    @: LmP0Node stmt
    @: LmP0Text fa
    int: j
    int: n
    int: ty
    int: slot_no
    if: body = 0 || sn = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        l2_vis_stmt(mi, stmt)
        # S1.3: a catch hosts its parameters; its handler is a nested body under it.
        if: l2_frame_head(stmt, "catch")
            if: l2_collect_catch(stmt, mi, path, depth, sn) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # An anonymous `---` block is a nested executable body, like an if body (§14, Q14 K) --
        # unless it opens an expression run (l2_discard_run): an operand, not a block.
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0 && l2_discard_run(field) > 0
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0
            if: l2_for_add(stmt, mi, l2_for_find(l2_scope_host())) < 0 || l2_scope_push(stmt) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_collect_decls(stmt\as\structure, mi, path, depth + 1, sn) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if")
            if: stmt\as\frame\body = 0
                return: l2_error(path, stmt, "unsupported body")
            n: l2_count_active(stmt\as\frame\body)
            last: l2_next_active(stmt\as\frame\body\first_field)
            j: 1
            while: j < n
                last: l2_next_active(last\next)
                j: j + 1
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                return: l2_error(path, stmt, "unsupported body")
            if: l2_for_add(last\value, mi, l2_for_find(l2_scope_host())) < 0 || l2_scope_push(last\value) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_collect_decls(last\value\as\structure, mi, path, depth + 1, sn) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                if: nxt\value\as\frame\body = 0
                    return: l2_error(path, nxt\value, "unsupported body")
                if: l2_for_add(nxt\value, mi, l2_for_find(l2_scope_host())) < 0 || l2_scope_push(nxt\value) != 0
                    return: l2_alloc_or(path, nxt\value, "out of memory")
                if: l2_collect_decls(nxt\value\as\frame\body, mi, path, depth + 1, sn) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            continue
        if: l2_frame_head(stmt, "while")
            if: stmt\as\frame\body = 0
                return: l2_error(path, stmt, "unsupported body")
            n: l2_count_active(stmt\as\frame\body)
            last: l2_next_active(stmt\as\frame\body\first_field)
            j: 1
            while: j < n
                last: l2_next_active(last\next)
                j: j + 1
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                return: l2_error(path, stmt, "unsupported body")
            if: l2_for_add(last\value, mi, l2_for_find(l2_scope_host())) < 0 || l2_scope_push(last\value) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_collect_decls(last\value\as\structure, mi, path, depth + 1, sn) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "for")
            if: l2_for_cstyle(stmt) = 0
                field: l2_next_active(field\next)
                continue
            if: l2_for_add(stmt, mi, l2_for_find(l2_scope_host())) < 0
                return: l2_error(path, stmt, "out of memory")
            if: l2_scope_push(stmt) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            nxt: l2_next_active(stmt\as\frame\body\first_field)
            if: nxt != 0 && l2_own_decl_ty(nxt\value) != 0
                ty: l2_own_decl_ty(nxt\value)
                if: l2_own_is_array(ty) != 0
                    l2_scope_pop()
                    return: l2_error(path, nxt\value, "unsupported own array declaration")
                fa: l2_next_active(nxt\value\as\frame\body\first_field)\value\as\atom
                j: l2_own_add(mi, fa, l2_own_store_ty(ty), path, nxt\value)
                if: j < 0
                    l2_scope_pop()
                    return: 1
                if: l2_own_off(mi, j) = (cast: (size_t) -1)
                    l2_scope_pop()
                    return: l2_error(path, nxt\value, "size overflow")
                l2_m_uses[l2_own_off(mi, j)]: 1
                l2_m_own[mi]: l2_m_own[mi] + 1
                if: l2_bind_own(mi, j, path, nxt\value) != 0
                    l2_scope_pop()
                    return: 1
                ---
            nxt: l2_next_active(nxt\next)
            nxt: l2_next_active(nxt\next)
            nxt: l2_next_active(nxt\next)
            nxt: l2_next_active(nxt\next)
            if: nxt != 0 && nxt\value != 0 && nxt\value\kind = c.LM_P0_NODE_STRUCTURE && nxt\value\as != 0 && l2_collect_decls(nxt\value\as\structure, mi, path, depth + 1, sn) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "[]") && (l2_own_array_count(stmt) = 0 || depth != l2_scope_n)
            return: l2_error(path, stmt, "unsupported own array declaration")
        if: l2_frame_head(stmt, "if") = 0 && l2_unimpl_numeric(stmt) != 0
            return: l2_error(path, stmt, l2_unimpl_numeric(stmt))
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && depth > 0 && l2_scope_n = 0
            return: l2_error(path, stmt, "unsupported own declaration")
        if: l2_frame_head(stmt, "if") = 0 && l2_slot_decl_ty(stmt) != 0 && depth > 0
            return: l2_error(path, stmt, "unsupported body")
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && (depth = 0 || l2_scope_n != 0)
            ty: l2_own_decl_ty(stmt)
            fa: l2_own_decl_name(stmt)
            j: l2_own_add(mi, fa, l2_own_store_ty(ty), path, stmt)
            if: j < 0
                return: 1
            if: l2_own_is_array(ty) != 0
                if: l2_own_count[j] != 0
                    return: l2_error(path, stmt, "duplicate own array declaration")
                l2_own_count[j]: l2_own_array_count(stmt)
            ---
            if: l2_own_off(mi, j) = (cast: (size_t) -1)
                return: l2_error(path, stmt, "size overflow")
            l2_m_uses[l2_own_off(mi, j)]: 1
            l2_m_own[mi]: l2_m_own[mi] + 1
            if: l2_bind_own(mi, j, path, stmt) != 0
                return: 1
            if: l2_count_active(stmt\as\frame\body) = 2
                last: l2_next_active(stmt\as\frame\body\first_field)
                last: l2_next_active(last\next)
                if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_ATOM && l2_check_literal_kind(last\value\as\atom, l2_lit_kind_from_own(ty), path, stmt) != 0
                    return: 1
                ---
            ---
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) = 0 && l2_slot_decl_ty(stmt) != 0 && depth = 0
            ty: l2_slot_decl_ty(stmt)
            fa: l2_next_active(l2_next_active(stmt\as\frame\body\first_field)\next)\value\as\atom
            slot_no: \sn
            l2_m_sn[mi]: slot_no
            if: slot_no = c.INT_MAX || l2_slot_reserve(slot_no + 1) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            l2_sn[l2_slot_off(mi, slot_no)]: fa
            l2_st[l2_slot_off(mi, slot_no)]: ty
            slot_no: slot_no + 1
            \sn: slot_no
            l2_m_sn[mi]: slot_no
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) = 0 && l2_slot_decl_ty(stmt) = 0
            field: l2_next_active(field\next)
return: 0

fn: l2_name_before (const: @(LmP0Text a); const: @(LmP0Text b)) int
    size_t: n
    if: a = 0 || b = 0 || a\data = 0 || b\data = 0
        return: 0
    n: a\length
    if: b\length < n
        n: b\length
    if: memcmp(a\data, b\data, n) < 0
        return: 1
    if: memcmp(a\data, b\data, n) > 0
        return: 0
    if: a\length < b\length
        return: 1
return: 0

fn: l2_dyn_add (int: mi; const: @(LmP0Text t); int: ty) int
    int: k
    int: i
    if: mi < 0 || t = 0
        return: 0
    if: l2_formal_find(mi, t) >= 0
        return: 0
    k: l2_dyn_find(mi, t)
    if: k >= 0
        if: ty != 0 && l2_dt(mi, k) != 0 && l2_dt(mi, k) != ty
            return: 1
        if: ty != 0 && l2_dt_set(mi, k, ty) != 0
            return: 1
        return: 0
    if: l2_m_dyn[mi] >= c.INT_MAX
        l2_alloc_err: 2
        return: 1
    if: l2_hidden_reserve(mi, l2_m_dyn[mi] + 1) != 0
        return: 1
    i: l2_m_dyn[mi]
    while: i > 0 && l2_name_before(t, l2_dn(mi, i - 1))
        if: l2_dn_set(mi, i, l2_dn(mi, i - 1)) != 0
            return: 1
        if: l2_dt_set(mi, i, l2_dt(mi, i - 1)) != 0
            return: 1
        i: i - 1
    if: l2_dn_set(mi, i, (cast: (@: LmP0Text) t)) != 0
        return: 1
    if: l2_dt_set(mi, i, ty) != 0
        return: 1
    l2_m_dyn[mi]: l2_m_dyn[mi] + 1
return: 0

fn: l2_scan_ident (int: mi; const: @(LmP0Text t); @: int seen) int
    int: oi
    int: ty
    if: mi < 0 || t = 0 || l2_ident(t) = 0
        return: 0
    if: l2_formal_find(mi, t) >= 0
        return: 0
    if: l2_slot_find(mi, t) >= 0
        return: 0
    if: l2_find_method(t) >= 0
        return: 0
    if: l2_ml_find(t) >= 0
        return: 0
    # A unit-level declaration or a bound merge result is a name IN SCOPE,
    # reached through the program unit. It is not a free name, so it must
    # not become an untyped dynamic input.
    if: l2_ns_find(t) >= 0 && l2_ns_parent[l2_ns_find(t)] < 0
        return: 0
    if: l2_mres_find(t) >= 0
        return: 0
    if: l2_is_known(t)
        return: 0
    if: l2_text_eq(t, "return") || l2_text_eq(t, "if") || l2_text_eq(t, "else") || l2_text_eq(t, "while") || l2_text_eq(t, "for") || l2_text_eq(t, "continue") || l2_text_eq(t, "break") || l2_text_eq(t, "fn") || l2_text_eq(t, "sub") || l2_text_eq(t, "end") || l2_text_eq(t, "node") || l2_prim_type_word(t) || l2_text_eq(t, "data") || l2_text_eq(t, "length") || l2_text_eq(t, "sizeof") || l2_text_eq(t, "cast") || l2_text_eq(t, "columns") || l2_text_eq(t, "count") || l2_text_eq(t, "capacity") || l2_text_eq(t, "slots") || l2_text_eq(t, "alloc_next") || l2_text_eq(t, "addr") || l2_text_eq(t, "next")
        return: 0
    if: t\length >= 2U && t\data[0] = 99 && t\data[1] = 46
        return: 0
    oi: l2_own_find_last(mi, t)
    if: oi >= 0 && l2_own_unit_seen(oi, mi) != 0
        if: l2_own_off(mi, oi) = (cast: (size_t) -1)
            return: 1
        if: l2_m_uses[l2_own_off(mi, oi)] = 0
            l2_m_own[mi]: l2_m_own[mi] + 1
        l2_m_uses[l2_own_off(mi, oi)]: 1
        return: 0
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0 && l2_dt_of_own(l2_own_ty[oi]) != 0 && (seen = 0 || seen[oi] = 0)
        l2_m_pre[l2_own_off(mi, oi)]: 1
        ty: l2_dt_of_own(l2_own_ty[oi])
        return: l2_dyn_add(mi, t, ty)
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0
        return: 0
    if: l2_own_any(mi, t) >= 0
        return: 0
    if: l2_define_name(t) != 0
        return: 0
    if: l2_dyn_add(mi, t, 0) != 0
        return: 1
return: 0

fn: l2_scan_node (const: @(LmP0Node node); int: mi; @: int seen) int
    @: LmP0Field f
    int: n
    int: oi
    if: node = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_ATOM
        return: l2_scan_ident(mi, node\as\atom, seen)
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0 && node\as\structure != 0
        f: node\as\structure\first_field
        n: l2_count_active(node\as\structure)
        return: l2_scan_fields(f, n, mi, seen)
    # In @: name the head is syntax and the single atom is a value. Resolve an
    # own field here before the generic structural-word filter, so a legitimate
    # field called count/data/next remains addressable.
    if: node\kind = c.LM_P0_NODE_FRAME && l2_frame_head(node, "@") && node\as\frame\body != 0 && l2_count_active(node\as\frame\body) = 1
        f: l2_next_active(node\as\frame\body\first_field)
        if: f != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM
            oi: l2_own_find_last(mi, f\value\as\atom)
            if: oi >= 0 && l2_own_unit_seen(oi, mi) != 0
                if: l2_m_uses[l2_own_off(mi, oi)] = 0
                    l2_m_own[mi]: l2_m_own[mi] + 1
                l2_m_uses[l2_own_off(mi, oi)]: 1
                return: 0
            ---
        ---
    # implements(candidate, required, consumer) is decided at translation from
    # declarations; its head and operands are not lexical references either.
    if: node\kind = c.LM_P0_NODE_FRAME && l2_frame_head(node, "implements")
        return: 0
    # A cast contributes only its operand to lexical free-name analysis. The
    # head and its first field name a language operation and a C type.
    if: node\kind = c.LM_P0_NODE_FRAME && l2_frame_head(node, "cast") && node\as\frame\body != 0 && l2_count_active(node\as\frame\body) >= 2
        f: l2_next_active(node\as\frame\body\first_field)
        f: l2_next_active(f\next)
        # A field/index expression may occupy several flat fields; the target
        # type is still not a lexical reference.
        if: l2_count_active(node\as\frame\body) > 2
            return: l2_scan_fields(f, l2_count_active(node\as\frame\body) - 1, mi, seen)
        return: l2_scan_node(f\value, mi, seen)
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\body != 0
        if: l2_scan_ident(mi, node\as\frame\head, seen) != 0
            return: 1
        f: node\as\frame\body\first_field
        n: l2_count_active(node\as\frame\body)
        return: l2_scan_fields(f, n, mi, seen)
return: 0

fn: l2_scan_fields (@: LmP0Field field; int: n; int: mi; @: int seen) int
    @: LmP0Field f
    @: LmP0Field nxt
    int: i
    int: after 0
    f: l2_next_active(field)
    i: 0
    while: i < n && f != 0
        nxt: l2_next_active(f\next)
        if: after != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM
            after: after - 1
            f: nxt
            i: i + 1
            continue
        if: f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(f\value\as\atom)
            after: 1
            # A root-qualified occurrence index, `root\[N]name` (FABLE-SONNET-
            # OCC-ROOT-20260924-146): the 4 tokens after the slash ([, N, ],
            # name) are all part of one resolved path, none a bare name
            # reference a dynamic-input scan should register -- mirrors the
            # l2_check_fields/l2_emit_fields recognizer for the same shape.
            if: nxt != 0 && nxt\value != 0 && nxt\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(nxt\value\as\atom, "[") != 0
                after: 4
                ---
            ---
        if: l2_scan_node(f\value, mi, seen) != 0
            return: 1
        f: nxt
        i: i + 1
return: 0

fn: l2_scan_body (const: @(LmP0Structure body); int: mi; @: int seen) int
    @: LmP0Text slnm 0
    int: slty 0
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Field last
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Text fa
    int: n
    int: k
    int: oi
    int: ty
    if: body = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        l2_vis_stmt(mi, stmt)
        # An anonymous `---` block is a nested executable body, like an if body (§14, Q14 K).
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0
            if: l2_scope_push(stmt) != 0
                return: 1
            if: l2_scan_body(stmt\as\structure, mi, seen) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        # A bare atom statement, or a statement line P0 gives as several fields (`y + 1`): one
        # expression (l2_expr_span), whose names are read as the same expression's are anywhere.
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM
            k: l2_expr_span(field)
            if: k < 1
                k: 1
            if: l2_scan_fields(field, k, mi, seen) != 0
                return: 1
            field: l2_skip_span(field, k)
            continue
        # sendMessage: X, or sendMessage: Ref X (FABLE-SONNET-SEND-REF-20260925-172 commit 3) --
        # the message is always the LAST active field; anything before it is the Ref expression,
        # scanned like any other (l2_scan_fields already skips a path run's own `\name` segments,
        # the same shape a Ref like m\sender has).  The message's name and its field names label
        # positions; only each field's value is an expression.
        if: stmt != 0 && l2_frame_head(stmt, "sendMessage") != 0 && stmt\as\frame\body != 0
            nxt: l2_next_active(stmt\as\frame\body\first_field)
            n: l2_count_active(stmt\as\frame\body)
            if: n > 1 && l2_scan_fields(stmt\as\frame\body\first_field, n - 1, mi, seen) != 0
                return: 1
            if: n > 1
                nxt: l2_skip_span(nxt, n - 1)
            ---
            if: nxt != 0 && nxt\value != 0 && nxt\value\kind = c.LM_P0_NODE_FRAME && nxt\value\as\frame\body != 0
                last: l2_next_active(nxt\value\as\frame\body\first_field)
                while: last != 0
                    if: last\value != 0 && last\value\kind = c.LM_P0_NODE_FRAME && last\value\as\frame\body != 0
                        if: l2_scan_fields(last\value\as\frame\body\first_field, l2_count_active(last\value\as\frame\body), mi, seen) != 0
                            return: 1
                        ---
                    ---
                    last: l2_next_active(last\next)
                ---
            ---
            field: l2_next_active(field\next)
            continue
        # See the assignment collector: a normalized colon constructor is the
        # one merge form whose operand remains a dynamic free graph name.
        if: l2_merge_frame(stmt) != 0
            field: l2_next_active(field\next)
            continue
        # S1.2: a `throws:` list names exits, not values; a `throw:` references its payload.
        if: l2_frame_head(stmt, "throws")
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "throw")
            if: l2_scan_throw_args(stmt, mi, seen) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # S1.3: a catch's name is an exit and its parameters are declared and bound by the delivery
        # before its handler runs; the handler is scanned under the catch's scope.
        if: l2_frame_head(stmt, "catch")
            if: l2_catch_body(stmt) != 0
                if: l2_scope_push(stmt) != 0
                    return: 1
                if: l2_scan_catch_bound(stmt, mi, seen) != 0
                    l2_scope_pop()
                    return: 1
                if: l2_scan_body(l2_catch_body(stmt), mi, seen) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            ---
            field: l2_next_active(field\next)
            continue
        # Model: fresh -- the declared name is bound here, not referenced;
        # the same exclusion l2_merge_frame gets above, for the same reason.
        # A bare l2_own_add makes the row exist (l2_check_body's later call
        # with the same statement node finds it and is a no-op past this),
        # so a later statement in this body reading the name through \\field
        # resolves it as an own field instead of an undeclared dynamic input.
        if: l2_colon_decl_shape(stmt, @ slnm, @ fa) = 0
            if: l2_own_add(mi, fa, l2_own_of_dt(l2_colon_graph_ty()), l2_src, stmt) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_receive_msg_shape(stmt, @ fa, 0) = 0
            if: l2_own_add(mi, fa, l2_own_of_dt(l2_colon_graph_ty()), l2_src, stmt) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # A pointer-local declaration is a TYPE and a name, neither of them a
        # reference. Without this the type atom itself is inferred as an
        # untyped dynamic input and the whole method is refused as an
        # "unresolved name" that names nothing the source wrote.
        if: l2_ptr_local_ty(stmt, @ slnm, @ slty) = 0
            if: l2_count_active(stmt\as\frame\body) = 3
                last: l2_next_active(stmt\as\frame\body\first_field)
                last: l2_next_active(last\next)
                last: l2_next_active(last\next)
                if: last = 0 || l2_scan_node(last\value, mi, seen) != 0
                    return: 1
                ---
            ---
            field: l2_next_active(field\next)
            continue
        # The same for a const local: const: @(LmxMsg m) declares a cursor,
        # it does not reference LmxMsg.
        if: l2_const_local_ty(stmt, @ slnm, @ slty) = 0
            field: l2_next_active(field\next)
            continue
        # And for a function-pointer local: TYPE: d names a disposer type the
        # header declares. Fourth form of the same rule.
        if: l2_fnptr_local(stmt, @ slnm) = 0
            field: l2_next_active(field\next)
            continue
        if: l2_struct_local(stmt, @ slnm) = 0
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: l2_scan_fields(fr\body\first_field, n - 1, mi, seen) != 0
                return: 1
            if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE
                if: l2_scope_push(last\value) != 0
                    return: 1
                if: l2_scan_body(last\value\as\structure, mi, seen) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && nxt\value\as != 0 && nxt\value\as\frame != 0
                if: l2_scope_push(nxt\value) != 0
                    return: 1
                if: l2_scan_body(nxt\value\as\frame\body, mi, seen) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            ---
        if: l2_frame_head(stmt, "while")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: n >= 2 && l2_scan_fields(fr\body\first_field, n - 1, mi, seen) != 0
                return: 1
            if: n >= 2 && last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE
                if: l2_scope_push(last\value) != 0
                    return: 1
                if: l2_scan_body(last\value\as\structure, mi, seen) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "for")
            if: l2_for_cstyle(stmt) = 0
                field: l2_next_active(field\next)
                continue
            if: l2_scope_push(stmt) != 0
                return: 1
            last: l2_next_active(stmt\as\frame\body\first_field)
            # The init of a C-style for DECLARES its counter and runs before everything else in the
            # loop: from here on the counter is bound, not a name read before its binding line.
            if: last != 0 && last\value != 0 && l2_own_decl_name(last\value) != 0
                oi: l2_own_find(mi, l2_own_decl_name(last\value))
                if: oi >= 0 && seen != 0
                    seen[oi]: 1
            ---
            if: last != 0 && last\value != 0 && last\value\as != 0 && last\value\as\frame != 0 && last\value\as\frame\body != 0 && l2_scan_fields(last\value\as\frame\body\first_field, l2_count_active(last\value\as\frame\body), mi, seen) != 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(last\next)
            if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE && l2_scan_fields(last\value\as\structure\first_field, l2_count_active(last\value\as\structure), mi, seen) != 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(last\next)
            if: last != 0 && l2_scan_node(last\value, mi, seen) != 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(last\next)
            last: l2_next_active(last\next)
            if: last != 0 && last\value != 0 && last\value\kind = c.LM_P0_NODE_STRUCTURE && l2_scan_body(last\value\as\structure, mi, seen) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt)
            if: stmt\as\frame\body != 0 && l2_scan_fields(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), mi, seen) != 0
                return: 1
            oi: l2_own_find_decl(mi, stmt\as\frame\head, stmt)
            if: oi < 0
                oi: l2_own_find_last(mi, stmt\as\frame\head)
            ---
            if: oi >= 0 && l2_own_unit_seen(oi, mi) != 0
                if: l2_own_off(mi, oi) = (cast: (size_t) -1)
                    return: 1
                if: l2_m_uses[l2_own_off(mi, oi)] = 0
                    l2_m_own[mi]: l2_m_own[mi] + 1
                l2_m_uses[l2_own_off(mi, oi)]: 1
            ---
            if: oi >= 0 && seen != 0
                seen[oi]: 1
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt) = 0 && l2_own_decl_ty(stmt) != 0
            # FABLE-SONNET-RECEIVE-RENAME-20260924-166 commit 3 (D-48): the check-time twin of
            # l2_emit_body's own-decl-line branch -- same Q24 fix, this statement's own row.
            fa: l2_own_decl_name(stmt)
            oi: l2_own_find_decl(mi, fa, stmt)
            if: oi >= 0 && seen != 0
                seen[oi]: 1
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt) = 0 && l2_own_decl_ty(stmt) = 0 && l2_is_char_decl(stmt)
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_frame_head(stmt, "while") = 0 && l2_frame_head(stmt, "for") = 0 && l2_is_asgn(stmt) = 0 && l2_is_char_decl(stmt) = 0
            if: stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && l2_scan_ident(mi, stmt\as\frame\head, seen) != 0
                return: 1
            if: stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0 && l2_scan_fields(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), mi, seen) != 0
                return: 1
            field: l2_next_active(field\next)
return: 0

# How many own rows a scan of this node may add: one per `Model: fresh` in it.
fn: l2_colon_decl_room (const: @(LmP0Node node)) int
    @: LmP0Field f 0
    @: LmP0Text cm 0
    @: LmP0Text cn 0
    int: n 0
    if: node = 0 || node\as = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_FRAME && l2_colon_decl_shape(node, @ cm, @ cn) = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_FRAME && l2_receive_msg_shape(node, @ cn, 0) = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as\structure != 0
        f: node\as\structure\first_field
    if: node\kind = c.LM_P0_NODE_FRAME && node\as\frame != 0 && node\as\frame\body != 0
        f: node\as\frame\body\first_field
    while: f != 0
        n: n + l2_colon_decl_room(f\value)
        f: f\next
    ---
return: n

fn: l2_dyn_local (const: @(char path)) int
    int: i 0
    int: k
    int: oi
    int: dummy 0
    int: heap 0
    int: room
    @: int seen
    size_t: nb
    seen: @ dummy
    # The scan below registers every `Model: fresh` it meets as an own row, so
    # `seen` must have room for those rows too, not only for the rows that
    # exist now (a row index past l2_own_n here overran the table).
    room: l2_own_n
    while: i < l2_m_n
        if: l2_m_body[i] != 0
            room: room + l2_colon_decl_room(l2_m_body[i])
        i: i + 1
    ---
    i: 0
    if: room > 0
        if: l2_mul_ok((cast: (size_t) room), c.sizeof(c.int)) = 0
            l2_alloc_err: 2
            return: l2_alloc_or(path, 0, "unsupported body")
        nb: (cast: (size_t) room) * c.sizeof(c.int)
        l2_alloc_kind: 5
        seen: (cast: (@: int) l2_xmalloc(nb))
        if: seen = 0
            return: l2_alloc_or(path, 0, "unsupported body")
        heap: 1
        ---
    while: i < l2_m_n
        l2_vis_method(i)
        if: heap != 0
            memset((cast: (@: void) seen), 0, nb)
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_ml_rebuild(l2_m_body[i]\as\structure, path) != 0
            if: heap != 0
                l2_xfree((cast: (@: void) seen))
            return: 1
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_scan_body(l2_m_body[i]\as\structure, i, seen) != 0
            if: heap != 0
                l2_xfree((cast: (@: void) seen))
            return: l2_alloc_or(path, l2_m_node[i], "unsupported body")
        if: l2_m_node[i] != 0 && l2_m_node[i]\as != 0 && l2_ret_tr(l2_m_node[i]\as\frame) != 0 && l2_scan_fields(l2_ret_tr(l2_m_node[i]\as\frame)\first_field, l2_count_active(l2_ret_tr(l2_m_node[i]\as\frame)), i, seen) != 0
            if: heap != 0
                l2_xfree((cast: (@: void) seen))
            return: l2_alloc_or(path, l2_m_node[i], "unsupported body")
        oi: 0
        while: oi < l2_own_n
            if: l2_m_uses[l2_own_off(i, oi)] != 0 && l2_m_pre[l2_own_off(i, oi)] != 0 && l2_dyn_add(i, l2_own_name[oi], l2_dt_of_own(l2_own_ty[oi])) != 0
                if: heap != 0
                    l2_xfree((cast: (@: void) seen))
                return: l2_alloc_or(path, l2_m_node[i], "unsupported body")
            if: l2_m_uses[l2_own_off(i, oi)] != 0 && l2_bind_own(i, oi, path, l2_m_node[i]) != 0
                if: heap != 0
                    l2_xfree((cast: (@: void) seen))
                return: 1
            oi: oi + 1
        i: i + 1
    l2_vis_on: 0
    if: heap != 0
        l2_xfree((cast: (@: void) seen))
return: 0

fn: l2_dyn_step (const: @(char path); @: int changed) int
    int: m 0
    int: cidx
    int: k
    int: src
    int: ty
    int: before
    int: sdt
    @: LmP0Text nm
    while: m < l2_m_n
        # A caller supplies a callee's dynamic input from what it can see.
        l2_vis_method(m)
        cidx: 0
        while: cidx < l2_m_n
            k: 0
            while: l2_m_edge[l2_edge_off(m, cidx)] != 0 && k < l2_m_dyn[cidx]
                nm: l2_dn(cidx, k)
                ty: l2_dt(cidx, k)
                src: l2_param_find(m, nm)
                if: src < 0
                    src: l2_own_find_last(m, nm)
                sdt: 0
                if: src >= 0 && l2_param_find(m, nm) < 0 && l2_m_uses[l2_own_off(m, src)] != 0 && l2_dt_of_source(l2_own_ty[src], path, l2_m_node[m], @ sdt) != 0
                    return: 1
                if: src >= 0 && l2_param_find(m, nm) < 0 && l2_m_uses[l2_own_off(m, src)] != 0 && ty != 0 && sdt != ty
                    return: l2_error(path, l2_m_node[m], "incompatible entry signature")
                if: src >= 0 && l2_param_find(m, nm) < 0 && l2_m_uses[l2_own_off(m, src)] != 0 && ty = 0 && l2_dt_set(cidx, k, sdt) != 0
                    return: 1
                if: src >= 0 && l2_param_find(m, nm) < 0 && l2_m_uses[l2_own_off(m, src)] != 0 && ty = 0
                    \changed: 1
                before: l2_m_dyn[m]
                # A graph receiver with a lexical declaration in the callee
                # does not force the caller to invent another hidden input.
                # Call emission still prefers a real caller binding; only when
                # none exists does it pass callee.self\parent\Name.
                # The entry E has no caller: a callee's dynamic input it does not
                # bind itself stops there and is resolved at the call (the
                # lexical fallback of l2_hidden_from), as it did in `main`.
                if: m != l2_e && l2_param_find(m, nm) < 0 && (src < 0 || l2_m_uses[l2_own_off(m, src)] = 0) && (ty != l2_colon_graph_ty() || l2_colon_model(nm) = 0) && l2_dyn_add(m, nm, ty) != 0
                    return: l2_alloc_or(path, l2_m_node[m], "unsupported body")
                if: l2_m_dyn[m] != before
                    \changed: 1
                src: l2_param_find(m, nm)
                # A formal code is never compared with a dynamic code raw: both go through the cell.
                if: src >= 0 && src < l2_m_arity[m] && l2_dt_of_source(l2_own_ty_of_param(l2_ft(m, src)), path, l2_m_node[m], @ sdt) != 0
                    return: 1
                if: src >= 0 && src < l2_m_arity[m] && ty != 0 && sdt != ty
                    return: l2_error(path, l2_m_node[m], "incompatible entry signature")
                if: src >= 0 && src < l2_m_arity[m] && ty = 0 && l2_dt_set(cidx, k, sdt) != 0
                    return: 1
                if: src >= 0 && src < l2_m_arity[m] && ty = 0
                    \changed: 1
                if: src >= l2_m_arity[m] && ty != 0 && l2_dt(m, src - l2_m_arity[m]) != 0 && l2_dt(m, src - l2_m_arity[m]) != ty
                    return: l2_error(path, l2_m_node[m], "incompatible entry signature")
                if: src >= l2_m_arity[m] && ty != 0 && l2_dt(m, src - l2_m_arity[m]) = 0 && l2_dt_set(m, src - l2_m_arity[m], ty) != 0
                    return: 1
                if: src >= l2_m_arity[m] && ty != 0 && l2_dt(m, src - l2_m_arity[m]) = 0
                    \changed: 1
                if: src >= l2_m_arity[m] && ty = 0 && l2_dt(m, src - l2_m_arity[m]) != 0 && l2_dt_set(cidx, k, l2_dt(m, src - l2_m_arity[m])) != 0
                    return: 1
                if: src >= l2_m_arity[m] && ty = 0 && l2_dt(m, src - l2_m_arity[m]) != 0
                    \changed: 1
                k: k + 1
            cidx: cidx + 1
        m: m + 1
    l2_vis_on: 0
return: 0

fn: l2_dyn_typed (const: @(char path)) int
    int: m 0
    int: k
    while: m < l2_m_n
        k: 0
        while: k < l2_m_dyn[m]
            if: l2_dt(m, k) = 0
                if: l2_dn(m, k) != 0
                    c.fprintf(l1_stderr(), "l2trans detail: unresolved dynamic=%.*s\n", (cast: (int) l2_dn(m, k)\length), l2_dn(m, k)\data)
                return: l2_error(path, l2_m_node[m], "unresolved name")
            k: k + 1
        m: m + 1
return: 0

fn: l2_dyn_close (const: @(char path)) int
    int: changed 1
    # Each successful step can only add one of the finite method/name/type
    # facts collected from this unit. Iterate to the actual fixed point; an
    # arbitrary pass count rejects valid long call chains.
    while: changed != 0
        changed: 0
        if: l2_dyn_step(path, @ changed) != 0
            return: 1
return: l2_dyn_typed(path)


# FABLE-GROKBOT-C-MEMBER-ACCESS-20260923-120 part1 / FABLE-GROKBOT-RAW-MEMBER-ROOT-AND-7A-CLOSE-20260923-126 part1:
# Raw C member paths fire ONLY when the root's resolved type is spelled c.*
# (foreign intern whose name is not the Lmx Structure projection). Runtime
# struct codes 28/29/30 stay raw. A Structure / own / formal / occurrence root
# that also interns as foreign Lmx (ty >= 100) must NOT take this door -- the
# L2 path dispatcher (l2_path_root / l2_emit_path) decides first.
# Mutant: restore "if: ty >= 100 / return: 1" alone -- Model compound fixture
# emits wrong literal C member access (RED).
# Mutant: make this always return 0 -- c.LmP0Text fixtures refuse unsupported body.
fn: l2_ty_raw_c_members (int: ty) int
    int: i
    if: ty = 28 || ty = 29 || ty = 30
        return: 1
    if: ty < 100
        return: 0
    i: ty - 100
    if: i < 0 || i >= l2_foreign_n
        return: 0
    if: l2_foreign_name[i] = 0
        return: 0
    if: l2_text_eq(l2_foreign_name[i], "Lmx")
        return: 0
return: 1

fn: l2_raw_path (const: @(char pd); size_t: pn; int: mi; @: int out_j; @: int out_fld) int
    size_t: i 0U
    size_t: sl 0U
    int: j
    if: pd = 0 || mi < 0 || out_j = 0 || out_fld = 0
        return: 1
    sl: pn
    while: i < pn
        if: pd[i] = 92 && sl = pn
            sl: i
        i: i + 1U
    if: sl = 0U || sl = pn || sl + 1U >= pn
        return: 1
    j: 0
    while: j < l2_m_arity[mi]
        if: l2_fn(mi, j) != 0 && l2_fn(mi, j)\length = sl && memcmp(l2_fn(mi, j)\data, pd, sl) = 0
            \out_j: j
            # A runtime struct or foreign type field is spelled as written.
            if: l2_ty_raw_c_members(l2_ft(mi, j)) != 0
                \out_fld: 5
                return: 0
            if: pn - sl - 1U = 4U && memcmp(pd + sl + 1U, "data", 4U) = 0
                \out_fld: 0
                return: 0
            if: pn - sl - 1U = 6U && memcmp(pd + sl + 1U, "length", 6U) = 0
                \out_fld: 1
                return: 0
            if: pn - sl - 1U = 7U && memcmp(pd + sl + 1U, "columns", 7U) = 0
                \out_fld: 2
                return: 0
            if: pn - sl - 1U = 5U && memcmp(pd + sl + 1U, "count", 5U) = 0
                \out_fld: 3
                return: 0
            if: pn - sl - 1U = 8U && memcmp(pd + sl + 1U, "capacity", 8U) = 0
                \out_fld: 4
                return: 0
            # Root matched a formal but is not c.*-raw: L2 dispatcher decides.
            return: 1
        j: j + 1
    j: 0
    while: j < l2_m_sn[mi]
        if: l2_sn[l2_slot_off(mi, j)] != 0 && l2_sn[l2_slot_off(mi, j)]\length = sl && memcmp(l2_sn[l2_slot_off(mi, j)]\data, pd, sl) = 0
            # Raw formal and local-slot targets share this result channel.
            # Place slots after the method's actual formal count so every
            # arity remains disjoint without a reserved numeric band.
            \out_j: l2_m_arity[mi] + j
            # A runtime struct or foreign type field is spelled as written.
            if: l2_ty_raw_c_members(l2_st[l2_slot_off(mi, j)]) != 0
                \out_fld: 5
                return: 0
            if: pn - sl - 1U = 4U && memcmp(pd + sl + 1U, "data", 4U) = 0
                \out_fld: 0
                return: 0
            if: pn - sl - 1U = 6U && memcmp(pd + sl + 1U, "length", 6U) = 0
                \out_fld: 1
                return: 0
            if: pn - sl - 1U = 7U && memcmp(pd + sl + 1U, "columns", 7U) = 0
                \out_fld: 2
                return: 0
            if: pn - sl - 1U = 5U && memcmp(pd + sl + 1U, "count", 5U) = 0
                \out_fld: 3
                return: 0
            if: pn - sl - 1U = 8U && memcmp(pd + sl + 1U, "capacity", 8U) = 0
                \out_fld: 4
                return: 0
            # Root matched a slot but is not c.*-raw: L2 dispatcher decides.
            return: 1
        j: j + 1
    j: 0
    while: j < l2_ml_n
        # A runtime struct or foreign type field is spelled as written.
        if: l2_ty_raw_c_members(l2_ml_ty[j]) != 0 && l2_ml_nm[j] != 0 && l2_ml_nm[j]\length = sl && memcmp(l2_ml_nm[j]\data, pd, sl) = 0
            \out_j: l2_m_arity[mi] + l2_m_sn[mi] + j
            \out_fld: 5
            return: 0
        j: j + 1
return: 1


fn: l2_raw_head (const: @(LmP0Text t); int: mi; @: int out_j; @: int out_fld) int
    if: t = 0
        return: 1
return: l2_raw_path(t\data, t\length, mi, out_j, out_fld)
fn: l2_pointer_depth (int: ty) int
    int: fi
    if: ty >= 1000 && ty < 2000
        ty: ty - 1000
    if: ty = 3 || ty = 9 || ty = 11 || ty = 12 || ty = 16 || ty = 25 || ty = 26 || ty = 27 || ty = 29 || ty = 31 || ty = 38
        return: 1
    if: ty = 17 || ty = 18 || ty = 19 || ty = 20 || ty = 24 || ty = 39
        return: 2
    if: ty >= 100
        fi: ty - 100
        if: fi >= 0 && fi < l2_foreign_n
            return: l2_foreign_depth[fi]
        ---
    ---
return: 0

# Prefix `\` is raw dereference. Only the leading run is dereference; any
# later `\field` stays postfix field-follow. Rename the selected L2 binding,
# preserve both positional operators, and leave `[]` to the index path.
# The pointer own field k, loaded into a new temporary for a dereference (-189 c3b-3): its name,
# appended to dest.  With ind 0 (a check, which emits nothing) the load expression is spelled.
fn: l2_deref_load (int: k; const: @(char ind); @: char dest) int
    c.array: [1024]: char load
    c.array: [1024]: char dcl
    c.array: [32]: char nm
    int: t
    if: l2_own_load(k, load) != 0
        return: 1
    if: ind = 0
        return: (cast: (int) (c.sprintf(dest, "%s", load) < 0))
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.sprintf(nm, "l2_t%d", t) < 0 || l2_pointer_decl_text(l2_own_ty[k] - 1000, 0, nm, dcl) != 0
        return: 1
    if: c.fprintf(l2_out, "%s%s\n%s%s: %s\n", ind, dcl, ind, nm, load) < 0
        return: 1
return: (cast: (int) (c.sprintf(dest, "%s", nm) < 0))

fn: l2_prefix_deref (const: @(LmP0Text t); int: mi; const: @(char ind); @: char dest) int
    size_t: lead 0U
    size_t: base_end
    size_t: i
    size_t: at 0U
    int: j
    int: ty 0
    int: found 0
    if: t = 0 || t\data = 0 || dest = 0 || t\length >= 256U
        return: 1
    while: lead < t\length && t\data[lead] = 92
        lead: lead + 1U
    if: lead = 0U
        return: 1
    base_end: lead
    while: base_end < t\length && t\data[base_end] != 92
        base_end: base_end + 1U
    if: base_end = lead
        return: 2
    j: 0
    while: j < l2_m_arity[mi] && found = 0
        if: l2_fn(mi, j) != 0 && l2_fn(mi, j)\length = base_end - lead && memcmp(l2_fn(mi, j)\data, t\data + lead, base_end - lead) = 0
            ty: l2_ft(mi, j)
            i: 0U
            while: i < lead
                dest[at]: 92
                at: at + 1U
                i: i + 1U
            if: l2_formal_row(mi, j) >= 0 && l2_deref_load(l2_formal_row(mi, j), ind, dest + at) != 0
                return: 2
            if: l2_formal_row(mi, j) < 0 && c.sprintf(dest + at, "l2_p%d_%d", mi, j) < 0
                return: 2
            at: strlen(dest)
            found: 1
        ---
        j: j + 1
    ---
    j: 0
    while: j < l2_own_n && found = 0
        if: l2_own_mi[j] = mi && l2_own_name[j] != 0 && l2_own_name[j]\length = base_end - lead && memcmp(l2_own_name[j]\data, t\data + lead, base_end - lead) = 0 && l2_m_uses[l2_own_off(mi, j)] != 0
            ty: l2_own_ty[j]
            i: 0U
            while: i < lead
                dest[at]: 92
                at: at + 1U
                i: i + 1U
            if: l2_m_alias[l2_own_off(mi, j)] >= 0 && c.sprintf(dest + at, "l2_p%d_%d", mi, l2_m_alias[l2_own_off(mi, j)]) < 0
                return: 2
            if: l2_m_alias[l2_own_off(mi, j)] < 0 && l2_own_direct(mi, j) != 0 && l2_deref_load(j, ind, dest + at) != 0
                return: 2
            if: l2_m_alias[l2_own_off(mi, j)] < 0 && l2_own_direct(mi, j) = 0 && c.sprintf(dest + at, "l2_q%d", j) < 0
                return: 2
            at: strlen(dest)
            found: 1
        ---
        j: j + 1
    ---
    j: 0
    while: j < l2_m_sn[mi] && found = 0
        if: l2_sn[l2_slot_off(mi, j)] != 0 && l2_sn[l2_slot_off(mi, j)]\length = base_end - lead && memcmp(l2_sn[l2_slot_off(mi, j)]\data, t\data + lead, base_end - lead) = 0
            ty: l2_st[l2_slot_off(mi, j)]
            i: 0U
            while: i < lead
                dest[at]: 92
                at: at + 1U
                i: i + 1U
            if: c.sprintf(dest + at, "l2_s%d_%d", mi, j) < 0
                return: 2
            at: strlen(dest)
            found: 1
        ---
        j: j + 1
    ---
    j: 0
    while: j < l2_ml_n && found = 0
        if: l2_ml_nm[j] != 0 && l2_ml_nm[j]\length = base_end - lead && memcmp(l2_ml_nm[j]\data, t\data + lead, base_end - lead) = 0
            ty: l2_ml_ty[j]
            i: 0U
            while: i < lead
                dest[at]: 92
                at: at + 1U
                i: i + 1U
            memcpy(dest + at, t\data + lead, base_end - lead)
            at: at + base_end - lead
            dest[at]: 0
            found: 1
        ---
        j: j + 1
    ---
    if: found = 0 || l2_pointer_depth(ty) < (cast: (int) lead)
        return: 2
    if: at + t\length - base_end >= 256U
        return: 2
    memcpy(dest + at, t\data + base_end, t\length - base_end)
    at: at + t\length - base_end
    dest[at]: 0
return: 0

fn: l2_index_head (const: @(LmP0Text t); int: mi; @: int out_j) int
    size_t: i
    size_t: lb
    size_t: n
    int: j
    int: k
    int: ok 0
    int: dep 0
    if: t = 0 || t\data = 0 || out_j = 0
        return: 1
    n: t\length
    if: n < 4U
        return: 1
    if: t\data[n - 1U] != 93
        return: 1
    # The index opens at the bracket that matches the final one, so an
    # index expression may contain brackets: `buf[off[0]]`.
    i: n - 1U
    lb: n
    while: lb = n && i > 0U
        if: t\data[i] = 93
            dep: dep + 1
        if: t\data[i] = 91
            dep: dep - 1
            if: dep = 0
                lb: i
            ---
        i: i - 1U
    if: lb = n || lb = 0U
        return: 1
    if: lb + 1U >= n - 1U
        return: 2
    k: 0
    while: k < l2_own_n
        if: l2_own_mi[k] = mi && (l2_own_host[k] = 0 || l2_scope_has(l2_own_host[k])) && l2_own_name[k] != 0 && l2_own_name[k]\length = n - lb - 2U && memcmp(l2_own_name[k]\data, t\data + lb + 1U, n - lb - 2U) = 0 && (l2_own_ty[k] = 0 || l2_own_ty[k] = 1 || l2_own_ty[k] = 2 || l2_own_ty[k] = 3 || l2_own_ty[k] = 36)
            ok: 1
        k: k + 1
    ---
    k: 0
    while: k < l2_ml_n
        if: l2_ml_nm[k] != 0 && l2_ml_nm[k]\length = n - lb - 2U && memcmp(l2_ml_nm[k]\data, t\data + lb + 1U, n - lb - 2U) = 0 && (l2_ml_ty[k] = 0 || l2_ml_ty[k] = 1 || l2_ml_ty[k] = 2 || l2_ml_ty[k] = 3 || l2_ml_ty[k] = 10 || l2_ml_ty[k] = 34)
            ok: 1
        k: k + 1
    ---
    k: 0
    while: k < l2_m_arity[mi]
        if: l2_fn(mi, k) != 0 && l2_fn(mi, k)\length = n - lb - 2U && memcmp(l2_fn(mi, k)\data, t\data + lb + 1U, n - lb - 2U) = 0 && (l2_ft(mi, k) = 0 || l2_ft(mi, k) = 1 || l2_ft(mi, k) = 2 || l2_ft(mi, k) = 3 || l2_ft(mi, k) = 10 || l2_ft(mi, k) = 34 || l2_ft(mi, k) = 36)
            ok: 1
        if: l2_fn(mi, k) != 0 && l2_ft(mi, k) >= 100 && n - lb - 2U > l2_fn(mi, k)\length + 1U && memcmp(l2_fn(mi, k)\data, t\data + lb + 1U, l2_fn(mi, k)\length) = 0 && t\data[lb + 1U + l2_fn(mi, k)\length] = 92
            ok: 1
        k: k + 1
    ---
    i: lb + 1U
    while: i < n - 1U && t\data[i] >= 48 && t\data[i] <= 57
        i: i + 1U
    if: i = n - 1U
        if: n - lb - 2U > 1U && t\data[lb + 1U] = 48
            return: 2
        ok: 1
    # A compact assignment head keeps the index expression as source text.
    # Its base is still checked below; the L1 compiler validates the expression
    # after l2_index_token has renamed any formal identifiers it contains.
    if: ok = 0
        ok: 1
    j: 0
    while: j < l2_m_arity[mi]
        if: l2_fn(mi, j) != 0 && (l2_fn(mi, j)\length = lb || (l2_ft(mi, j) >= 100 && lb > l2_fn(mi, j)\length + 1U && t\data[l2_fn(mi, j)\length] = 92)) && memcmp(l2_fn(mi, j)\data, t\data, l2_fn(mi, j)\length) = 0
            if: l2_ft(mi, j) = 9 && (n - lb - 2U != 1U || t\data[lb + 1U] != 48)
                return: 2
            if: l2_ft(mi, j) != 9 && l2_ft(mi, j) != 11 && l2_ft(mi, j) != 12 && l2_ft(mi, j) != 17 && l2_ft(mi, j) != 18 && l2_ft(mi, j) != 19 && l2_ft(mi, j) != 20 && l2_ft(mi, j) != 24 && l2_ft(mi, j) != 25 && l2_ft(mi, j) != 38 && l2_ft(mi, j) != 39 && l2_ft(mi, j) != 26 && l2_ft(mi, j) != 27 && l2_ft(mi, j) != 31 && l2_ft(mi, j) < 100
                return: 3
            \out_j: j
            return: 0
        j: j + 1
    j: 0
    while: j < l2_m_sn[mi]
        if: l2_sn[l2_slot_off(mi, j)] != 0 && l2_sn[l2_slot_off(mi, j)]\length = lb && memcmp(l2_sn[l2_slot_off(mi, j)]\data, t\data, lb) = 0
            if: l2_st[l2_slot_off(mi, j)] != 3 && l2_st[l2_slot_off(mi, j)] != 9 && l2_st[l2_slot_off(mi, j)] != 11 && l2_st[l2_slot_off(mi, j)] != 12 && l2_st[l2_slot_off(mi, j)] != 17 && l2_st[l2_slot_off(mi, j)] != 18 && l2_st[l2_slot_off(mi, j)] != 19 && l2_st[l2_slot_off(mi, j)] != 20 && l2_st[l2_slot_off(mi, j)] != 22 && l2_st[l2_slot_off(mi, j)] != 24 && l2_st[l2_slot_off(mi, j)] != 25 && l2_st[l2_slot_off(mi, j)] != 26 && l2_st[l2_slot_off(mi, j)] != 27 && l2_st[l2_slot_off(mi, j)] != 31 && l2_st[l2_slot_off(mi, j)] < 100
                return: 3
            \out_j: l2_m_arity[mi] + j
            return: 0
        j: j + 1
    ---
    j: 0
    while: j < l2_ml_n
        if: l2_ml_nm[j] != 0 && (l2_ml_nm[j]\length = lb || (l2_ml_ty[j] >= 100 && lb > l2_ml_nm[j]\length + 1U && t\data[l2_ml_nm[j]\length] = 92)) && memcmp(l2_ml_nm[j]\data, t\data, l2_ml_nm[j]\length) = 0
            if: l2_ml_ty[j] != 9 && l2_ml_ty[j] != 11 && l2_ml_ty[j] != 12 && l2_ml_ty[j] != 17 && l2_ml_ty[j] != 18 && l2_ml_ty[j] != 19 && l2_ml_ty[j] != 20 && l2_ml_ty[j] != 22 && l2_ml_ty[j] != 24 && l2_ml_ty[j] != 25 && l2_ml_ty[j] != 26 && l2_ml_ty[j] != 27 && l2_ml_ty[j] != 31 && l2_ml_ty[j] < 100
                return: 3
            \out_j: l2_m_arity[mi] + l2_m_sn[mi] + j
            return: 0
        j: j + 1
    return: 3
end: l2_index_head

# Spell the index of a native pointer assignment. Literal indexes remain
# literal; a formal is renamed to its generated parameter name; ordinary
# entry/method locals retain their source name. Validation is performed by
# l2_index_head before this helper is called.
fn: l2_index_token (const: @(LmP0Text t); int: mi; const: @(char ind); @: char dest) int
    size_t: i 0U
    size_t: lb
    size_t: n
    size_t: ilen
    int: j
    int: k
    size_t: at
    size_t: first
    size_t: stop
    size_t: out_n 0U
    int: matched
    int: dep 0
    size_t: rb
    size_t: lit
    c.array: [1024]: char load
    if: t = 0 || t\data = 0 || dest = 0
        return: 1
    n: t\length
    if: n < 3U || t\data[n - 1U] != 93
        return: 1
    # The bracket that matches the final one (l2_index_head).
    i: n - 1U
    lb: n
    while: lb = n && i > 0U
        if: t\data[i] = 93
            dep: dep + 1
        if: t\data[i] = 91
            dep: dep - 1
            if: dep = 0
                lb: i
            ---
        i: i - 1U
    if: lb = n || lb + 1U >= n - 1U
        return: 1
    ilen: n - lb - 2U
    k: 0
    while: k < l2_own_n
        if: l2_own_mi[k] = mi && (l2_own_host[k] = 0 || l2_scope_has(l2_own_host[k])) && l2_own_name[k] != 0 && l2_own_name[k]\length = ilen && memcmp(l2_own_name[k]\data, t\data + lb + 1U, ilen) = 0
            # An own field bound to a formal is spelled as that formal is read here (l2_tok_formal).
            if: l2_own_formal(mi, k) >= 0 && l2_own_direct(mi, k) != 0 && l2_tok_formal(mi, l2_own_formal(mi, k), dest) != 0
                return: 1
            if: l2_m_alias[l2_own_off(mi, k)] >= 0 && l2_own_direct(mi, k) = 0 && c.sprintf(dest, "l2_p%d_%d", mi, l2_m_alias[l2_own_off(mi, k)]) < 0
                return: 1
            if: l2_m_alias[l2_own_off(mi, k)] < 0 && (l2_own_formal(mi, k) < 0 || l2_own_direct(mi, k) = 0) && l2_own_load(k, dest) != 0
                return: 1
            return: 0
        k: k + 1
    ---
    j: 0
    while: j < l2_m_arity[mi]
        if: l2_fn(mi, j) != 0 && l2_fn(mi, j)\length = ilen && memcmp(l2_fn(mi, j)\data, t\data + lb + 1U, ilen) = 0
            if: c.sprintf(dest, "l2_p%d_%d", mi, j) < 0
                return: 1
            return: 0
        if: l2_fn(mi, j) != 0 && l2_ft(mi, j) >= 100 && ilen > l2_fn(mi, j)\length + 1U && memcmp(l2_fn(mi, j)\data, t\data + lb + 1U, l2_fn(mi, j)\length) = 0 && t\data[lb + 1U + l2_fn(mi, j)\length] = 92
            if: c.sprintf(dest, "l2_p%d_%d\\%.*s", mi, j, (cast: (int) (ilen - l2_fn(mi, j)\length - 1U)), t\data + lb + 2U + l2_fn(mi, j)\length) < 0
                return: 1
            return: 0
        j: j + 1
    ---
    # Preserve the complete C-like index expression while renaming every L2
    # formal token to its generated L1 parameter.  Operators, whitespace,
    # literals, and method locals are copied byte-for-byte.
    at: lb + 1U
    stop: n - 1U
    while: at < stop
        if: (t\data[at] >= 65 && t\data[at] <= 90) || (t\data[at] >= 97 && t\data[at] <= 122) || t\data[at] = 95
            first: at
            at: at + 1U
            while: at < stop && ((t\data[at] >= 65 && t\data[at] <= 90) || (t\data[at] >= 97 && t\data[at] <= 122) || (t\data[at] >= 48 && t\data[at] <= 57) || t\data[at] = 95)
                at: at + 1U
            ---
            matched: 0
            j: 0
            while: j < l2_own_n
                if: l2_own_mi[j] = mi && (l2_own_host[j] = 0 || l2_scope_has(l2_own_host[j])) && l2_own_name[j] != 0 && l2_own_name[j]\length = at - first && memcmp(l2_own_name[j]\data, t\data + first, at - first) = 0 && l2_m_uses[l2_own_off(mi, j)] != 0
                    if: l2_own_is_array(l2_own_ty[j]) != 0
                        rb: at
                        while: rb < stop && t\data[rb] != 93
                            rb: rb + 1U
                        ---
                        if: t\data[at] != 91 || rb >= stop || l2_array_literal(j, t, at + 1U, rb, @ lit) != 0 || l2_emit_array_load(j, lit, ind, load) != 0
                            return: 1
                        k: c.sprintf(dest + out_n, "%s", load)
                        at: rb + 1U
                    else:
                        if: l2_own_formal(mi, j) >= 0 && l2_own_direct(mi, j) != 0
                            if: l2_tok_formal(mi, l2_own_formal(mi, j), load) != 0
                                return: 1
                            k: c.sprintf(dest + out_n, "%s", load)
                        ---
                        if: l2_m_alias[l2_own_off(mi, j)] >= 0 && l2_own_direct(mi, j) = 0
                            k: c.sprintf(dest + out_n, "l2_p%d_%d", mi, l2_m_alias[l2_own_off(mi, j)])
                        ---
                        if: l2_m_alias[l2_own_off(mi, j)] < 0 && (l2_own_formal(mi, j) < 0 || l2_own_direct(mi, j) = 0)
                            if: l2_own_load(j, load) != 0
                                return: 1
                            k: c.sprintf(dest + out_n, "%s", load)
                        ---
                    ---
                    if: k < 0 || out_n + (cast: (size_t) k) >= 1023U
                        return: 1
                    out_n: out_n + (cast: (size_t) k)
                    matched: 1
                j: j + 1
            ---
            j: 0
            while: matched = 0 && j < l2_m_arity[mi]
                if: l2_fn(mi, j) != 0 && l2_fn(mi, j)\length = at - first && memcmp(l2_fn(mi, j)\data, t\data + first, at - first) = 0
                    k: c.sprintf(dest + out_n, "l2_p%d_%d", mi, j)
                    if: k < 0 || out_n + (cast: (size_t) k) >= 1023U
                        return: 1
                    out_n: out_n + (cast: (size_t) k)
                    matched: 1
                j: j + 1
            ---
            j: 0
            while: matched = 0 && j < l2_m_sn[mi]
                if: l2_sn[l2_slot_off(mi, j)] != 0 && l2_sn[l2_slot_off(mi, j)]\length = at - first && memcmp(l2_sn[l2_slot_off(mi, j)]\data, t\data + first, at - first) = 0
                    k: c.sprintf(dest + out_n, "l2_s%d_%d", mi, j)
                    if: k < 0 || out_n + (cast: (size_t) k) >= 1023U
                        return: 1
                    out_n: out_n + (cast: (size_t) k)
                    matched: 1
                j: j + 1
            ---
            if: matched = 0
                if: out_n + at - first >= 1023U
                    return: 1
                memcpy(dest + out_n, t\data + first, at - first)
                out_n: out_n + at - first
            ---
        else:
            if: out_n + 1U >= 1023U
                return: 1
            dest[out_n]: t\data[at]
            out_n: out_n + 1U
            at: at + 1U
        ---
    dest[out_n]: 0
return: 0

fn: l2_expr_span (@: LmP0Field field) int
    @: LmP0Field f
    @: LmP0Field index
    @: LmP0Field after
    @: LmP0Field slash
    @: LmP0Field member
    int: span 1
    int: operand 1
    int: n
    if: field = 0 || field\value = 0
        return: 0
    # An address prefix belongs to the expression it addresses: "@ tail" and
    # "@ item\\next" are ONE actual, not two or four. Counting them
    # separately makes a well-formed call look like the wrong arity.
    if: field\value\kind = c.LM_P0_NODE_ATOM && field\value\as != 0 && l2_text_eq(field\value\as\atom, "@")
        n: l2_expr_span(l2_next_active(field\next))
        if: n < 1
            return: 0
        return: n + 1
    # A prefix raw load belongs to the expression it loads, exactly as the
    # address prefix above does: one actual, not two. Counting the prefix
    # separately made a well-formed call look like the wrong arity.
    if: field\value\kind = c.LM_P0_NODE_ATOM && field\value\as != 0 && l2_is_slash(field\value\as\atom)
        n: l2_expr_span(l2_next_active(field\next))
        if: n < 1
            return: 0
        return: n + 1
    if: l2_index_tail(field, @ index, @ after) = 0
        span: 4
        f: after
        span: span + l2_index_chain(f, @ f)
    else:
        f: l2_next_active(field\next)
        slash: f
        if: slash != 0 && slash\value != 0 && slash\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(slash\value\as\atom)
            member: l2_next_active(slash\next)
            if: member = 0 || member\value = 0 || member\value\kind != c.LM_P0_NODE_ATOM
                return: 0
            span: 3
            f: l2_next_active(member\next)
            if: l2_index_tail(member, @ index, @ after) = 0
                span: 6
                f: after
                span: span + l2_index_chain(f, @ f)
            ---
        ---
    # Postfix field-follow may continue for any number of segments. Each
    # `\name` remains part of the same operand and therefore of one actual.
    while: f != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(f\value\as\atom)
        member: l2_next_active(f\next)
        if: member = 0 || member\value = 0 || member\value\kind != c.LM_P0_NODE_ATOM
            return: 0
        span: span + 2
        f: l2_next_active(member\next)
    ---
    # ... and after the last segment of a path, its index groups (root\a\b[i][j]).
    span: span + l2_index_chain(f, @ f)
    while: f != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_binop(f\value\as\atom)
        f: l2_next_active(f\next)
        if: f = 0 || f\value = 0
            return: 0
        span: span + 1
        operand: 1
        if: l2_index_tail(f, @ index, @ after) = 0
            operand: 4
            f: after
            operand: operand + l2_index_chain(f, @ f)
        else:
            f: l2_next_active(f\next)
            slash: f
            if: slash != 0 && slash\value != 0 && slash\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(slash\value\as\atom)
                member: l2_next_active(slash\next)
                if: member = 0 || member\value = 0 || member\value\kind != c.LM_P0_NODE_ATOM
                    return: 0
                operand: 3
                f: l2_next_active(member\next)
                if: l2_index_tail(member, @ index, @ after) = 0
                    operand: 6
                    f: after
                    operand: operand + l2_index_chain(f, @ f)
                ---
            ---
        span: span + operand
    ---
    n: span
return: n

fn: l2_actual_count (@: LmP0Field field) int
    @: LmP0Field f
    int: count 0
    int: span
    int: i
    f: l2_next_active(field)
    while: f != 0
        span: l2_expr_span(f)
        if: span < 1
            return: 0 - 1
        count: count + 1
        i: 0
        while: i < span && f != 0
            f: l2_next_active(f\next)
            i: i + 1
        ---
return: count

# node's/for's own single-hop own-table lookups (l2_slash_own,
# l2_slash_for/l2_slash_for_prefix, l2_slash_node_prefix) are removed --
# FABLE-SONNET-NODE-ROOT-20260923-121, author Q9: node/for are ordinary
# roots of the -113 path dispatcher now (l2_path_root, l2_e_own_seg,
# l2_for_own_seg), not reserved spelling prefixes onto the current
# method's own table, and no longer excluded from this function either --
# FABLE-SONNET-ARRAY-WRITE-DISPATCH-20260923-119 already made it (the
# text-span sibling of l2_own_array_root, for l2_own_index_head
# specifically -- statement-head array read/write) refuse unconditionally
# for every root: a root's suffix must denote an Array-typed field of the
# root's TYPE, never a same-named sibling in mi's own table, and that
# capability (walking the root's type through the namespace slots to an
# indexed store) is not built. Refusing is the honest state; the caller's
# fallback (the ordinary field-path machinery) gives "unsupported index"
# for this shape.
fn: l2_own_array_root_span (int: mi; const: @(LmP0Text t); size_t: stop) int
return: 0 - 1

# Static proof for fixed-extent own INT/CHAR arrays. General indexing requires
# throw: Bounds; an unsupported form gets no runtime sentinel substitute.
fn: l2_array_literal (int: oi; const: @(LmP0Text t); size_t: begin; size_t: stop; @: size_t out_index) int
    size_t: value 0U
    size_t: digit
    size_t: i
    if: oi < 0 || t = 0 || t\data = 0 || out_index = 0 || begin >= stop || stop > t\length
        return: 1
    if: l2_own_is_array(l2_own_ty[oi]) = 0 || l2_own_count[oi] = 0
        return: 1
    i: begin
    while: i < stop
        if: t\data[i] < 48 || t\data[i] > 57
            return: 1
        digit: (cast: (size_t) (t\data[i] - 48))
        if: value > (((cast: (size_t) -1) - digit) / 10U)
            return: 1
        value: value * 10U + digit
        i: i + 1U
    ---
    if: value >= l2_positive_decimal(l2_own_count[oi])
        return: 1
    \out_index: value
return: 0

# name[ident] on an own array of mi. 0 = not this shape. 1 = ident is a size_t field
# (out_arr, out_field). 2 = ident is some other number: no silent cast.
fn: l2_dyn_own_index (int: mi; const: @(LmP0Text t); @: int out_arr; @: int out_field) int
    size_t: n
    size_t: i
    size_t: lb
    size_t: ilen
    int: dep 0
    int: k
    int: arr
    int: oi
    int: digits 1
    @: LmP0Text slice
    if: mi < 0 || t = 0 || t\data = 0 || out_arr = 0 || out_field = 0
        return: 0
    n: t\length
    if: n < 4U || t\data[n - 1U] != 93
        return: 0
    i: n - 1U
    lb: n
    while: lb = n && i > 0U
        if: t\data[i] = 93
            dep: dep + 1
        if: t\data[i] = 91
            dep: dep - 1
            if: dep = 0
                lb: i
            ---
        i: i - 1U
    ---
    if: lb = n || lb = 0U || lb + 1U >= n - 1U
        return: 0
    arr: 0 - 1
    k: 0
    while: k < l2_own_n && arr < 0
        if: ((l2_own_mi[k] = mi && (l2_own_host[k] = 0 || l2_scope_has(l2_own_host[k]))) || l2_own_unit_seen(k, mi) != 0) && l2_own_is_array(l2_own_ty[k]) != 0 && l2_own_name[k] != 0 && l2_own_name[k]\length = lb && memcmp(l2_own_name[k]\data, t\data, lb) = 0
            arr: k
        k: k + 1
    ---
    if: arr < 0
        return: 0
    ilen: n - lb - 2U
    i: lb + 1U
    while: i < n - 1U
        if: t\data[i] < 48 || t\data[i] > 57
            digits: 0
        i: i + 1U
    ---
    if: digits != 0
        return: 0
    if: (t\data[lb + 1U] < 65 || t\data[lb + 1U] > 90) && (t\data[lb + 1U] < 97 || t\data[lb + 1U] > 122) && t\data[lb + 1U] != 95
        return: 0
    i: lb + 1U
    while: i < n - 1U
        if: (t\data[i] < 48 || t\data[i] > 57) && (t\data[i] < 65 || t\data[i] > 90) && (t\data[i] < 97 || t\data[i] > 122) && t\data[i] != 95
            return: 0
        i: i + 1U
    ---
    slice: (cast: (@: LmP0Text) calloc(1U, c.sizeof(c.LmP0Text)))
    if: slice = 0
        return: 0
    slice\data: t\data + lb + 1U
    slice\length: ilen
    oi: l2_own_find_last(mi, slice)
    free((cast: (@: void) slice))
    if: oi < 0
        return: 0
    if: l2_own_ty[oi] != 2
        if: l2_rw_num_ty(l2_own_ty[oi]) != 0
            return: 2
        return: 0
    ---
    \out_arr: arr
    \out_field: oi
return: 1

# A formal, slot, or method local whose type is a raw C struct (c.*). An index on
# one of its fields is C's index, not an own-array literal proof.
fn: l2_raw_c_root (int: mi; const: @(LmP0Text t)) int
    int: j
    if: mi < 0 || t = 0
        return: 0
    j: l2_formal_find(mi, t)
    if: j >= 0 && l2_ty_raw_c_members(l2_ft(mi, j)) != 0
        return: 1
    j: l2_slot_find(mi, t)
    if: j >= 0 && l2_ty_raw_c_members(l2_st[l2_slot_off(mi, j)]) != 0
        return: 1
    j: l2_ml_find(t)
    if: j >= 0 && l2_ty_raw_c_members(l2_ml_ty[j]) != 0
        return: 1
return: 0

# 0 when `t` is `root\field[index]` and root is a raw C formal, slot, or local.
# The C index emitter writes it. An L2 Structure path is not this.
fn: l2_raw_index_head (const: @(LmP0Text t); int: mi) int
    int: j
    if: l2_index_head(t, mi, @ j) != 0
        return: 1
    if: j >= 0 && j < l2_m_arity[mi] && l2_ty_raw_c_members(l2_ft(mi, j)) != 0
        return: 0
    if: j >= l2_m_arity[mi] && j < l2_m_arity[mi] + l2_m_sn[mi] && l2_ty_raw_c_members(l2_st[l2_slot_off(mi, j - l2_m_arity[mi])]) != 0
        return: 0
    if: j >= l2_m_arity[mi] + l2_m_sn[mi] && l2_ty_raw_c_members(l2_ml_ty[j - l2_m_arity[mi] - l2_m_sn[mi]]) != 0
        return: 0
return: 1

# 1: another head; 2: unsupported own-array index; 0: proven valid.
fn: l2_own_index_head (const: @(LmP0Text t); int: mi; @: int out_own; @: size_t out_index) int
    int: oi 0
    size_t: lb 0U
    if: mi < 0 || t = 0 || t\data = 0 || out_own = 0 || out_index = 0
        return: 1
    while: lb < t\length && t\data[lb] != 91
        lb: lb + 1U
    if: lb = t\length || lb = 0U
        return: 1
    # node/for (FABLE-SONNET-NODE-ROOT-20260923-121): no more literal-
    # spelling shortcut here -- l2_own_array_root_span refuses every rooted
    # array head uniformly now, node/for included, exactly like any other
    # general root (indexing into an Array-typed field of the resolved
    # root's type is a capability -119 already parked, not this ticket's
    # either). The bare (unrooted) own-array case just below is unaffected.
    oi: l2_own_array_root_span(mi, t, lb)
    if: oi >= 0
        if: t\data[t\length - 1U] != 93
            return: 2
        if: l2_array_literal(oi, t, lb + 1U, t\length - 1U, out_index) != 0
            return: 2
        \out_own: oi
        return: 0
    oi: 0
    while: oi < l2_own_n
        if: ((l2_own_mi[oi] = mi && (l2_own_host[oi] = 0 || l2_scope_has(l2_own_host[oi]))) || l2_own_unit_seen(oi, mi) != 0) && l2_own_is_array(l2_own_ty[oi]) != 0 && l2_own_name[oi]\length = lb && memcmp(l2_own_name[oi]\data, t\data, lb) = 0
            if: t\data[t\length - 1U] != 93 || l2_array_literal(oi, t, lb + 1U, t\length - 1U, out_index) != 0
                return: 2
            \out_own: oi
            return: 0
        oi: oi + 1
return: 1

fn: l2_own_index_tail (@: LmP0Field f; int: mi; @: int out_own; @: size_t out_index; @@: LmP0Field out_after; @: int out_count) int
    int: oi
    @: LmP0Field index_field
    @: LmP0Field slash
    @: LmP0Field name
    @: LmP0Field bracket
    @: LmP0Field after
    if: mi < 0 || f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || out_own = 0 || out_index = 0 || out_after = 0 || out_count = 0
        return: 1
    \out_count: 4
    oi: l2_own_find_last(mi, f\value\as\atom)
    if: l2_text_eq(f\value\as\atom, "for") || l2_text_eq(f\value\as\atom, "node") || l2_own_find(mi, f\value\as\atom) >= 0 || l2_formal_find(mi, f\value\as\atom) >= 0
        slash: l2_next_active(f\next)
        if: slash != 0 && slash\value != 0 && slash\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(slash\value\as\atom)
            name: l2_next_active(slash\next)
            if: name = 0 || name\value = 0 || name\value\kind != c.LM_P0_NODE_ATOM
                return: 2
            oi: l2_own_array_root(mi, f\value\as\atom, name\value\as\atom)
            bracket: l2_next_active(name\next)
            if: bracket != 0 && bracket\value != 0 && bracket\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(bracket\value\as\atom, "[")
                if: oi < 0 || l2_own_is_array(l2_own_ty[oi]) = 0
                    if: l2_raw_c_root(mi, f\value\as\atom) != 0
                        return: 1
                    return: 2
            ---
            if: oi < 0 || l2_own_is_array(l2_own_ty[oi]) = 0
                return: 1
            f: name
            \out_count: 6
    ---
    if: oi < 0 || l2_own_is_array(l2_own_ty[oi]) = 0
        return: 1
    bracket: l2_next_active(f\next)
    if: bracket = 0 || bracket\value = 0 || bracket\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(bracket\value\as\atom, "[") = 0
        return: 1
    if: l2_index_tail(f, @ index_field, out_after) != 0
        return: 2
    after: \out_after
    if: after != 0 && after\value != 0 && after\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(after\value\as\atom, "[")
        return: 2
    if: index_field\value\kind != c.LM_P0_NODE_ATOM
        return: 2
    if: l2_array_literal(oi, index_field\value\as\atom, 0U, index_field\value\as\atom\length, out_index) != 0
        return: 2
    \out_own: oi
return: 0

# length() consumes a known own-array reference without exposing that reference.
# A declared method called length takes precedence at the normal resolver.
fn: l2_array_length_own (const: @(LmP0Node node); int: mi) int
    @: LmP0Field arg
    @: LmP0Field slash
    @: LmP0Field name
    int: count
    int: oi
    if: mi < 0 || l2_frame_head(node, "length") = 0
        return: -1
    if: node\as\frame\trailer != 0 || node\as\frame\body = 0
        return: -1
    if: node\as\frame\body\trailer != 0
        return: -1
    arg: l2_next_active(node\as\frame\body\first_field)
    if: arg = 0 || arg\value = 0 || arg\value\kind != c.LM_P0_NODE_ATOM
        return: -1
    count: l2_count_active(node\as\frame\body)
    oi: -1
    if: count = 1
        oi: l2_own_find_last(mi, arg\value\as\atom)
    if: count = 3 && (l2_text_eq(arg\value\as\atom, "for") || l2_text_eq(arg\value\as\atom, "node") || l2_own_find(mi, arg\value\as\atom) >= 0 || l2_formal_find(mi, arg\value\as\atom) >= 0)
        slash: l2_next_active(arg\next)
        name: l2_next_active(slash\next)
        if: slash\value = 0 || slash\value\kind != c.LM_P0_NODE_ATOM || l2_is_slash(slash\value\as\atom) = 0
            return: -1
        if: name = 0 || name\value = 0 || name\value\kind != c.LM_P0_NODE_ATOM
            return: -1
        oi: l2_own_array_root(mi, arg\value\as\atom, name\value\as\atom)
        ---
    ---
    if: oi < 0
        return: -1
    if: l2_own_is_array(l2_own_ty[oi]) = 0 || l2_own_count[oi] = 0
        return: -1
return: oi

# This bootstrap admits only positive decimal extents, never the empty ABI.
fn: l2_positive_decimal (const: @(LmP0Text t)) size_t
    size_t: n 0U
    size_t: i 0U
    size_t: digit
    if: t = 0 || t\data = 0 || t\length = 0U
        return: 0U
    while: i < t\length
        if: t\data[i] < 48 || t\data[i] > 57
            return: 0U
        digit: (cast: (size_t) (t\data[i] - 48))
        if: n > (((cast: (size_t) -1) - digit) / 10U)
            return: 0U
        n: n * 10U + digit
        i: i + 1U
    ---
    return: n

# Value of a size_t literal as written, INCLUDING the U suffix that l2_num
# accepts. l2_positive_decimal refuses any non-digit and therefore returns 0
# for "3U", which silently stored zero in every qualified branch and every
# merge body field until a content check caught it.
fn: l2_literal_value (const: @(LmP0Text t)) size_t
    size_t: n 0U
    size_t: i 0U
    size_t: stop
    size_t: digit
    if: t = 0 || t\data = 0 || t\length = 0U
        return: 0U
    stop: t\length
    if: t\data[stop - 1U] = 85 || t\data[stop - 1U] = 117
        stop: stop - 1U
    if: stop = 0U
        return: 0U
    while: i < stop
        if: t\data[i] < 48 || t\data[i] > 57
            return: 0U
        digit: (cast: (size_t) (t\data[i] - 48))
        if: n > (((cast: (size_t) -1) - digit) / 10U)
            return: 0U
        n: n * 10U + digit
        i: i + 1U
    ---
return: n

fn: l2_array_count_is (const: @(LmP0Text t)) int
    if: l2_num(t) = 0
        return: 0
    # l2_literal_value returns zero for both the valid empty extent and an
    # overflow. l2_num rejects leading zeroes, so only 0/0U/0u may use zero.
    if: l2_literal_value(t) != 0U
        return: 1
    if: t != 0 && t\data != 0 && t\data[0] = 48
        return: 1
return: 0

fn: l2_own_array_count (const: @(LmP0Node stmt)) @: LmP0Text
    @: LmP0Field f
    if: l2_frame_head(stmt, "[]") = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 3 || stmt\as\frame\trailer != 0 || stmt\as\frame\body\trailer != 0
        return: 0
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0
        return: 0
    if: f\value\kind = c.LM_P0_NODE_ATOM
        if: l2_text_eq(f\value\as\atom, "int") = 0 && l2_text_eq(f\value\as\atom, "char") = 0 && l2_text_eq(f\value\as\atom, "size_t") = 0 && l2_text_eq(f\value\as\atom, "ulong") = 0
            return: 0
        ---
    else:
        if: l2_own_array_pointer_ty(stmt) = 0
            return: 0
        ---
    f: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f\value\as\atom) = 0
        return: 0
    f: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: l2_array_count_is(f\value\as\atom) != 0
        return: f\value\as\atom
return: l2_define_count(f\value\as\atom)

fn: l2_own_array_pointer_ty (const: @(LmP0Node stmt)) int
    @: LmP0Field f
    @: LmP0Field inner
    const: @: LmP0Node wrapper
    const: @: LmP0Node ptr
    int: depth
    int: result 0
    if: l2_frame_head(stmt, "[]") = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_STRUCTURE || f\value\as = 0 || l2_count_active(f\value\as\structure) != 1
        return: 0
    inner: l2_next_active(f\value\as\structure\first_field)
    if: inner = 0 || inner\value = 0
        return: 0
    wrapper: inner\value
    ptr: wrapper
    if: wrapper\kind != c.LM_P0_NODE_FRAME || wrapper\as = 0 || wrapper\as\frame = 0
        return: 0
    depth: l2_address_depth(wrapper\as\frame\head)
    if: depth = 0
        return: 0
    if: ptr\as = 0 || ptr\as\frame = 0 || ptr\as\frame\body = 0 || l2_count_active(ptr\as\frame\body) != 1
        return: 0
    f: l2_next_active(ptr\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    # FABLE-SONNET-TYPE-WORD-FOLD-20260924-162 commit 2: l2_ptr_type_word's out-param
    # already carries exactly what this function used to return in every case (a core
    # code, l2_foreign_intern's raw result whether >=100 or not -- this function never
    # checked that threshold itself -- or 0 when nothing matched at all); its 0-vs-2
    # status is not needed here.
    l2_ptr_type_word(f\value\as\atom, depth, @ result)
return: result

fn: l2_own_decl_name (const: @(LmP0Node stmt)) @: LmP0Text
    @: LmP0Field f l2_next_active(stmt\as\frame\body\first_field)
    if: l2_frame_head(stmt, "[]")
        f: l2_next_active(f\next)
    return: f\value\as\atom

# A by-value local of a language numeric type (spec 6.6) is a Message-owned cell;
# a type whose owned domain is not implemented yet is refused by name, never
# emitted as activation C storage (e2 ruling 2026-09-14, model §21).
fn: l2_unimpl_numeric (const: @(LmP0Node stmt)) const: @: char
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 1 && l2_count_active(stmt\as\frame\body) != 2
        return: 0
    if: l2_frame_head(stmt, "float")
        return: "by-value float local not yet implemented"
    if: l2_frame_head(stmt, "double")
        return: "by-value double local not yet implemented"
    if: l2_frame_head(stmt, "long")
        return: "by-value long local not yet implemented"
    if: l2_frame_head(stmt, "llong")
        return: "by-value llong local not yet implemented"
    if: l2_frame_head(stmt, "ullong")
        return: "by-value ullong local not yet implemented"
    if: l2_frame_head(stmt, "uint")
        return: "by-value uint local not yet implemented"
    if: l2_frame_head(stmt, "u8") || l2_frame_head(stmt, "u16") || l2_frame_head(stmt, "u32") || l2_frame_head(stmt, "u64")
        return: "by-value unsigned fixed-width local not yet implemented"
    if: l2_frame_head(stmt, "i8") || l2_frame_head(stmt, "i16") || l2_frame_head(stmt, "i32") || l2_frame_head(stmt, "i64")
        return: "by-value signed fixed-width local not yet implemented"
    if: l2_frame_head(stmt, "wchar_t")
        return: "by-value wchar_t local not yet implemented"
return: 0

fn: l2_own_decl_ty (const: @(LmP0Node stmt)) int
    @: LmP0Field f
    int: ty 0
    int: n
    if: l2_own_array_count(stmt) != 0
        ty: l2_own_array_pointer_ty(stmt)
        if: ty > 0
            return: 2000 + ty
        f: l2_next_active(stmt\as\frame\body\first_field)
        if: l2_text_eq(f\value\as\atom, "int")
            return: 4
        if: l2_text_eq(f\value\as\atom, "char")
            return: 5
        if: l2_text_eq(f\value\as\atom, "size_t")
            return: 7
        if: l2_text_eq(f\value\as\atom, "ulong")
            return: 37
        return: 8
    if: l2_frame_head(stmt, "char")
        ty: 1
    if: l2_frame_head(stmt, "size_t")
        ty: 2
    if: l2_frame_head(stmt, "int")
        ty: 3
    if: l2_frame_head(stmt, "unsigned")
        ty: 6
    if: l2_frame_head(stmt, "ulong")
        ty: 36
    if: ty = 0
        return: 0
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    n: l2_count_active(stmt\as\frame\body)
    if: n != 1 && n != 2
        return: 0
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: l2_ident(f\value\as\atom) = 0
        return: 0
return: ty

fn: l2_own_is_array (int: ty) int
    if: ty = 4 || ty = 5 || ty = 7 || ty = 8 || ty = 37 || ty >= 2000
        return: 1
return: 0

fn: l2_own_is_pointer (int: ty) int
    if: ty >= 1000 && ty < 2000
        return: 1
return: 0

# The L1 spelling of raw pointer type `raw` with extra_depth more address levels, into dest: the
# type alone (name 0), or a declarator of `name` -- a const type keeps the name inside
# `const: @(... name)`, where appending it after the closing parenthesis would be invalid L1.
fn: l2_pointer_decl_text (int: raw; int: extra_depth; const: @(char name); @: char dest) int
    int: fi raw - 100
    int: depth 0
    int: is_const 0
    int: i 0
    const: @(char base) 0
    c.array: [256]: char nm
    if: dest = 0 || extra_depth < 0
        return: 1
    if: raw = 3
        base: "char"
        depth: 1
        is_const: 1
    if: raw = 29
        base: "LmxMsg"
        depth: 1
        is_const: 1
    if: raw = 9
        base: "size_t"
        depth: 1
    if: raw = 11
        base: "int"
        depth: 1
    if: raw = 12
        base: "char"
        depth: 1
    if: raw = 16
        base: "void"
        depth: 1
    if: raw = 25
        base: "unsigned"
        depth: 1
    if: raw = 38
        base: "ulong"
        depth: 1
    if: raw = 17
        base: "char"
        depth: 2
    if: raw = 18
        base: "void"
        depth: 2
    if: raw = 19
        base: "int"
        depth: 2
    if: raw = 20
        base: "size_t"
        depth: 2
    if: raw = 24
        base: "unsigned"
        depth: 2
    if: raw = 39
        base: "ulong"
        depth: 2
    if: raw >= 100
        if: fi < 0 || fi >= l2_foreign_n
            return: 1
        depth: l2_foreign_depth[fi]
        is_const: l2_foreign_const[fi]
    ---
    if: depth < 1
        return: 1
    depth: depth + extra_depth
    dest[0]: 0
    if: is_const != 0 && l2_cat(dest, "const: ") != 0
        return: 1
    while: i < depth
        if: l2_cat(dest, "@") != 0
            return: 1
        i: i + 1
    ---
    if: is_const != 0 && l2_cat(dest, "(") != 0
        return: 1
    if: is_const = 0 && l2_cat(dest, ": ") != 0
        return: 1
    if: raw >= 100 && c.snprintf(nm, 256U, "%.*s", (cast: (int) l2_foreign_name[fi]\length), l2_foreign_name[fi]\data) < 0
        return: 1
    if: raw < 100 && c.snprintf(nm, 256U, "%s", base) < 0
        return: 1
    if: l2_cat(dest, nm) != 0
        return: 1
    if: name != 0 && (l2_cat(dest, " ") != 0 || l2_cat(dest, name) != 0)
        return: 1
    if: is_const != 0 && l2_cat(dest, ")") != 0
        return: 1
return: 0

fn: l2_emit_raw_pointer_type (@: FILE out; int: raw; int: extra_depth) int
    c.array: [1024]: char txt
    if: out = 0 || l2_pointer_decl_text(raw, extra_depth, 0, txt) != 0
        return: 1
return: (cast: (int) (fputs(txt, out) < 0))
fn: l2_emit_own_pointer_type (@: FILE out; int: ty) int
    if: ty < 1000 || ty >= 2000
        return: 1
return: l2_emit_raw_pointer_type(out, ty - 1000, 0)

# Type of Array<@^n T>.data is @^(n+1) T. The extra level is the address of
# the contiguous element backing, not a replacement void** representation.
fn: l2_emit_own_pointer_array_data_type (@: FILE out; int: ty) int
    if: ty < 2000
        return: 1
return: l2_emit_raw_pointer_type(out, ty - 2000, 1)

fn: l2_own_store_ty (int: dty) int
    if: dty = 3
        return: 0
    if: dty = 6
        return: 3
return: dty

fn: l2_scope_free () int
    if: l2_scope_at != 0
        l2_xfree((cast: (@: void) l2_scope_at))
    l2_scope_at: 0
    l2_scope_n: 0
    l2_scope_cap: 0
return: 0

# Emitted indentation strings are translation-owned scratch values. Keep every
# returned pointer stable until the unit is finished; the table and strings grow
# from the actual nesting encountered rather than imposing a language depth.
fn: l2_indent_free () int
    int: i 0
    while: i < l2_indent_n
        if: l2_indent_at[i] != 0
            l2_xfree((cast: (@: void) l2_indent_at[i]))
        i: i + 1
    if: l2_indent_at != 0
        l2_xfree((cast: (@: void) l2_indent_at))
    l2_indent_at: 0
    l2_indent_n: 0
    l2_indent_cap: 0
return: 0

fn: l2_indent_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: psz
    size_t: nb
    @@: char nn 0
    int: i 0
    if: need < 0
        l2_alloc_err: 2
        return: 1
    if: need <= l2_indent_cap
        return: 0
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_indent_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) c.INT_MAX) / 2U)
            cap: need_u
        else:
            cap: cap * 2U
        ---
    if: cap > (cast: (size_t) c.INT_MAX)
        l2_alloc_err: 2
        return: 1
    psz: c.sizeof(@: char)
    if: l2_mul_ok(cap, psz) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    l2_alloc_kind: 8
    nn: (cast: (@@: char) l2_xmalloc(nb))
    if: nn = 0
        return: 1
    memset((cast: (@: void) nn), 0, nb)
    while: i < l2_indent_n
        nn[i]: l2_indent_at[i]
        i: i + 1
    if: l2_indent_at != 0
        l2_xfree((cast: (@: void) l2_indent_at))
    l2_indent_at: nn
    l2_indent_cap: (cast: (int) cap)
return: 0

fn: l2_pub_free () int
    if: l2_pub_tmp != 0
        l2_xfree((cast: (@: void) l2_pub_tmp))
    if: l2_pub_bak != 0
        l2_xfree((cast: (@: void) l2_pub_bak))
    l2_pub_tmp: 0
    l2_pub_bak: 0
    l2_pub_bak_cap: 0U
return: 0

# Publication filenames grow from the actual destination path. The decimal
# suffix bound is derived from size_t width (three decimal digits per byte is
# safely above log10(256)); it is not a count of allowed backup candidates.
fn: l2_pub_prepare (const: @(char out_path)) int
    size_t: pn
    size_t: tmp_n
    size_t: bak_extra
    size_t: bak_n
    @: char nt 0
    @: char nb 0
    if: out_path = 0
        return: 1
    pn: strlen(out_path)
    if: pn > ((cast: (size_t) -1) - 5U)
        l2_alloc_err: 2
        return: 1
    tmp_n: pn + 5U
    if: c.sizeof(c.size_t) > (((cast: (size_t) -1) - 6U) / 3U)
        l2_alloc_err: 2
        return: 1
    bak_extra: 6U + c.sizeof(c.size_t) * 3U
    if: pn > ((cast: (size_t) -1) - bak_extra)
        l2_alloc_err: 2
        return: 1
    bak_n: pn + bak_extra
    l2_alloc_kind: 9
    nt: (cast: (@: char) l2_xmalloc(tmp_n))
    nb: (cast: (@: char) l2_xmalloc(bak_n))
    if: nt = 0 || nb = 0
        if: nt != 0
            l2_xfree((cast: (@: void) nt))
        if: nb != 0
            l2_xfree((cast: (@: void) nb))
        return: 1
    memcpy(nt, out_path, pn)
    nt[pn]: 46
    nt[pn + 1U]: 116
    nt[pn + 2U]: 109
    nt[pn + 3U]: 112
    nt[pn + 4U]: 0
    memcpy(nb, out_path, pn)
    nb[pn]: 46
    nb[pn + 1U]: 98
    nb[pn + 2U]: 97
    nb[pn + 3U]: 107
    nb[pn + 4U]: 0
    l2_pub_tmp: nt
    l2_pub_bak: nb
    l2_pub_bak_cap: bak_n
return: 0

fn: l2_scope_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: psz
    size_t: nb
    @@: LmP0Node nn 0
    int: i
    if: need < 0
        return: 1
    if: need <= l2_scope_cap
        return: 0
    if: need > c.INT_MAX
        l2_alloc_err: 2
        return: 1
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_scope_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    psz: c.sizeof(@: char)
    if: l2_mul_ok(cap, psz) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    l2_alloc_kind: 5
    nn: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    if: nn = 0
        return: 1
    memset((cast: (@: void) nn), 0, nb)
    i: 0
    while: i < l2_scope_n
        nn[i]: l2_scope_at[i]
        i: i + 1
    if: l2_scope_at != 0
        l2_xfree((cast: (@: void) l2_scope_at))
    l2_scope_at: nn
    l2_scope_cap: (cast: (int) cap)
return: 0

fn: l2_scope_push (const: @(LmP0Node node)) int
    if: node = 0
        return: 1
    if: l2_scope_reserve(l2_scope_n + 1) != 0
        return: 1
    l2_scope_at[l2_scope_n]: (cast: (@: LmP0Node) node)
    l2_scope_n: l2_scope_n + 1
return: 0

fn: l2_scope_pop () int
    if: l2_scope_n <= 0
        return: 1
    l2_scope_n: l2_scope_n - 1
    l2_scope_at[l2_scope_n]: 0
return: 0

fn: l2_scope_has (const: @(LmP0Node node)) int
    int: i 0
    if: node = 0
        return: 0
    while: i < l2_scope_n
        if: l2_scope_at[i] = node
            return: 1
        i: i + 1
return: 0

fn: l2_scope_host () @: LmP0Node
    if: l2_scope_n <= 0
        return: 0
return: l2_scope_at[l2_scope_n - 1]

fn: l2_for_free () int
    if: l2_for_node != 0
        l2_xfree((cast: (@: void) l2_for_node))
    if: l2_for_uchild != 0
        l2_xfree((cast: (@: void) l2_for_uchild))
    if: l2_for_nkid != 0
        l2_xfree((cast: (@: void) l2_for_nkid))
    if: l2_for_mi != 0
        l2_xfree((cast: (@: void) l2_for_mi))
    if: l2_for_parent != 0
        l2_xfree((cast: (@: void) l2_for_parent))
    l2_for_node: 0
    l2_for_uchild: 0
    l2_for_nkid: 0
    l2_for_mi: 0
    l2_for_parent: 0
    l2_for_n: 0
    l2_for_cap: 0
return: 0

fn: l2_for_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: psz
    size_t: nb
    size_t: ni
    @@: LmP0Node nn 0
    @: int nu 0
    @: int nk 0
    @: int nm 0
    @: int np 0
    int: i
    if: need < 0
        return: 1
    if: need <= l2_for_cap
        return: 0
    if: need > c.INT_MAX
        l2_alloc_err: 2
        return: 1
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_for_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    psz: c.sizeof(@: char)
    if: l2_mul_ok(cap, psz) = 0
        l2_alloc_err: 2
        return: 1
    if: l2_mul_ok(cap, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    ni: cap * c.sizeof(c.int)
    l2_alloc_kind: 5
    nn: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    nu: (cast: (@: int) l2_xmalloc(ni))
    nk: (cast: (@: int) l2_xmalloc(ni))
    nm: (cast: (@: int) l2_xmalloc(ni))
    np: (cast: (@: int) l2_xmalloc(ni))
    if: nn = 0 || nu = 0 || nk = 0 || nm = 0 || np = 0
        if: nn != 0
            l2_xfree((cast: (@: void) nn))
        if: nu != 0
            l2_xfree((cast: (@: void) nu))
        if: nk != 0
            l2_xfree((cast: (@: void) nk))
        if: nm != 0
            l2_xfree((cast: (@: void) nm))
        if: np != 0
            l2_xfree((cast: (@: void) np))
        return: 1
    memset((cast: (@: void) nn), 0, nb)
    i: 0
    while: i < (cast: (int) cap)
        nu[i]: -1
        nk[i]: 0
        nm[i]: -1
        np[i]: -1
        i: i + 1
    i: 0
    while: i < l2_for_n
        nn[i]: l2_for_node[i]
        nu[i]: l2_for_uchild[i]
        nk[i]: l2_for_nkid[i]
        nm[i]: l2_for_mi[i]
        np[i]: l2_for_parent[i]
        i: i + 1
    if: l2_for_node != 0
        l2_xfree((cast: (@: void) l2_for_node))
        l2_xfree((cast: (@: void) l2_for_uchild))
        l2_xfree((cast: (@: void) l2_for_nkid))
        l2_xfree((cast: (@: void) l2_for_mi))
        l2_xfree((cast: (@: void) l2_for_parent))
    l2_for_node: nn
    l2_for_uchild: nu
    l2_for_nkid: nk
    l2_for_mi: nm
    l2_for_parent: np
    l2_for_cap: (cast: (int) cap)
return: 0

fn: l2_for_find (const: @(LmP0Node node)) int
    int: i 0
    if: node = 0
        return: -1
    while: i < l2_for_n
        if: l2_for_node[i] = node
            return: i
        i: i + 1
return: -1

fn: l2_for_add (const: @(LmP0Node node); int: mi; int: parent) int
    int: i
    if: node = 0
        return: -1
    i: l2_for_find(node)
    if: i >= 0 && l2_for_mi[i] = mi && l2_for_parent[i] = parent
        return: i
    if: i >= 0
        return: -1
    if: l2_for_reserve(l2_for_n + 1) != 0
        return: -1
    l2_for_node[l2_for_n]: (cast: (@: LmP0Node) node)
    l2_for_uchild[l2_for_n]: -1
    l2_for_nkid[l2_for_n]: 0
    l2_for_mi[l2_for_n]: mi
    l2_for_parent[l2_for_n]: parent
    l2_for_n: l2_for_n + 1
return: l2_for_n - 1

# THE HEADER PARTS (-189 c4; form A, fable): a method's header is its `args` part at slot 0 and its
# `return` part at slot 1 of its occurrence M; a part exists iff it is declared, so a method has
# the two and the entry E (the file's body) none -- its fields start at 0, as a named Structure's
# do.  The number of children in front of a Structure's own fields.
fn: l2_m_head (int: mi) int
    if: mi = l2_e
        return: 0
return: 2

# Child index of own field oi inside its own method's Structure M: after the header parts
# (l2_m_head), the earlier unhosted own fields of the same method; no extra per-method table.
fn: l2_own_mslot (int: oi) int
    int: k 0
    int: n l2_m_head(l2_own_mi[oi])
    while: k < oi
        if: l2_own_host[k] = 0 && l2_own_mi[k] = l2_own_mi[oi]
            n: n + 1
        k: k + 1
    ---
return: n

# Which Structure holds own field oi in the code being emitted right now. A
# method's own field is a child of that method's own Structure, reached through
# `self`; a shared own field stays a child of the program unit.
fn: l2_own_ctr (int: oi) const: @: char
    if: oi < 0 || oi >= l2_own_n
        return: l2_unit_ref
    if: l2_own_mi[oi] = l2_cur_mi
        return: "self"
    # E's occurrence is the unit.
    if: l2_own_mi[oi] = l2_e
        return: l2_unit_ref
    if: c.sprintf(l2_ctr_buf, "lmx_arena_ref_struct(%s, %uU)", l2_unit_ref, (cast: (unsigned) (l2_unit_base + l2_own_mi[oi]))) < 0
        return: l2_unit_ref
return: l2_ctr_buf

# Which method owns an executable control body (the entry E is one).
fn: l2_for_owner (int: k) int
    if: k >= 0 && k < l2_for_n
        return: l2_for_mi[k]
return: 0 - 1

# Unhosted own fields of a method: the children of M that follow its header parts.
fn: l2_m_own_count (int: mi) int
    int: i 0
    int: n 0
    while: i < l2_own_n
        if: l2_own_host[i] = 0 && l2_own_mi[i] = mi
            n: n + 1
        i: i + 1
    ---
return: n

# Executable control bodies owned by a method, and the rank of one among them.
fn: l2_m_for_count (int: mi) int
    int: k 0
    int: n 0
    while: k < l2_for_n
        if: l2_for_owner(k) = mi && l2_for_parent[k] < 0
            n: n + 1
        k: k + 1
    ---
return: n

fn: l2_for_rank (int: k) int
    int: i 0
    int: n 0
    while: i < k
        if: l2_for_owner(i) = l2_for_owner(k) && l2_for_parent[i] < 0
            n: n + 1
        i: i + 1
    ---
return: n

# Number of children M needs for method mi: its header parts, its unhosted own fields, its
# control bodies.
fn: l2_m_kids (int: mi) int
return: l2_m_head(mi) + l2_m_own_count(mi) + l2_m_for_count(mi)

fn: l2_layout_owns () int
    int: oi 0
    int: fid
    while: oi < l2_for_n
        l2_for_nkid[oi]: 0
        oi: oi + 1
    oi: 0
    while: oi < l2_own_n
        if: l2_own_host[oi] = 0
            l2_own_fid[oi]: -1
            l2_own_fchild[oi]: -1
            l2_own_uchild[oi]: l2_own_mslot(oi)
        if: l2_own_host[oi] != 0
            fid: l2_for_find(l2_own_host[oi])
            if: fid < 0
                return: 1
            l2_own_fid[oi]: fid
            l2_own_fchild[oi]: l2_for_nkid[fid]
            l2_for_nkid[fid]: l2_for_nkid[fid] + 1
            l2_own_uchild[oi]: -1
        oi: oi + 1
    # A top-level control body becomes a child of its method Structure (for the
    # entry E, of the unit). A nested body becomes a child of its containing
    # body, after that body's direct own fields. Discovery is preorder, so a
    # parent is always laid out before its descendants.
    oi: 0
    while: oi < l2_for_n
        if: l2_for_parent[oi] >= 0
            l2_for_uchild[oi]: l2_for_nkid[l2_for_parent[oi]]
            l2_for_nkid[l2_for_parent[oi]]: l2_for_nkid[l2_for_parent[oi]] + 1
        if: l2_for_parent[oi] < 0
            l2_for_uchild[oi]: l2_m_head(l2_for_owner(oi)) + l2_m_own_count(l2_for_owner(oi)) + l2_for_rank(oi)
        ---
        oi: oi + 1
    ---
    # The unit is E's occurrence: E's own fields and control bodies from 0 (E has no header
    # parts); the other methods' occurrences follow.
    l2_unit_base: 0
    if: l2_e >= 0
        l2_unit_base: l2_m_kids(l2_e)
    ---
return: 0

fn: l2_for_cstyle (const: @(LmP0Node stmt)) int
    @: LmP0Field f0
    @: LmP0Field f1
    @: LmP0Field f2
    @: LmP0Field f3
    @: LmP0Field f4
    if: l2_frame_head(stmt, "for") = 0
        return: 0
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 5
        return: 0
    f0: l2_next_active(stmt\as\frame\body\first_field)
    if: f0 = 0
        return: 0
    f1: l2_next_active(f0\next)
    if: f1 = 0
        return: 0
    f2: l2_next_active(f1\next)
    if: f2 = 0
        return: 0
    f3: l2_next_active(f2\next)
    if: f3 = 0
        return: 0
    f4: l2_next_active(f3\next)
    if: f4 = 0
        return: 0
    if: l2_own_decl_ty(f0\value) != 3
        return: 0
    if: f1\value = 0 || f1\value\kind != c.LM_P0_NODE_STRUCTURE || f1\value\as = 0
        return: 0
    if: f2\value = 0 || f2\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f2\value\as\atom) = 0
        return: 0
    if: f3\value = 0 || f3\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: l2_text_eq(f3\value\as\atom, "++") = 0 && l2_text_eq(f3\value\as\atom, "--") = 0
        return: 0
    if: f4\value = 0 || f4\value\kind != c.LM_P0_NODE_STRUCTURE || f4\value\as = 0
        return: 0
return: 1

# l2_path_own (node/for's own single-hop own-table lookup) is removed --
# FABLE-SONNET-NODE-ROOT-20260923-121, author Q9: node/for are ordinary
# roots of the -113 path dispatcher now.
fn: l2_slot_decl_ty (const: @(LmP0Node stmt)) int
    @: LmP0Field f
    @: LmP0Field g
    if: l2_frame_head(stmt, "@") = 0
        return: 0
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 2
        return: 0
    f: l2_next_active(stmt\as\frame\body\first_field)
    g: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: l2_ident(g\value\as\atom) = 0
        return: 0
    if: l2_text_eq(f\value\as\atom, "char")
        return: 3
    if: l2_text_eq(f\value\as\atom, "size_t")
        return: 9
return: 0

fn: l2_slot_find (int: mi; const: @(LmP0Text t)) int
    int: i 0
    if: mi < 0 || t = 0
        return: -1
    while: i < l2_m_sn[mi]
        if: l2_text_same(l2_sn[l2_slot_off(mi, i)], t)
            return: i
        i: i + 1
return: -1

fn: l2_is_char_decl (const: @(LmP0Node stmt)) int
    if: l2_own_decl_ty(stmt) != 0
        return: 1
    if: l2_slot_decl_ty(stmt) != 0
        return: 1
return: 0

fn: l2_is_plus (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "+") || l2_text_eq(t, "/") || l2_text_eq(t, "-") || l2_text_eq(t, "*") || l2_text_eq(t, "%")
        return: 1
    if: l2_text_eq(t, "&") || l2_text_eq(t, "|") || l2_text_eq(t, "<<") || l2_text_eq(t, ">>")
        return: 1
return: 0

fn: l2_is_cmp (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "<") || l2_text_eq(t, ">") || l2_text_eq(t, "=") || l2_text_eq(t, "!=") || l2_text_eq(t, "<=") || l2_text_eq(t, ">=")
        return: 1
return: 0

fn: l2_is_andor (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "&&") || l2_text_eq(t, "||")
        return: 1
return: 0

fn: l2_is_brack (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "[") || l2_text_eq(t, "]")
        return: 1
return: 0

fn: l2_is_slash (const: @(LmP0Text t)) int
    if: t = 0 || t\length != 1U
        return: 0
    if: t\data[0] != 92
        return: 0
return: 1

# c.name is the explicit foreign door (spec 6.6.6): admitted as written, and the
# C compiler checks the declaration and the ABI. A bare name is an L2 call and
# resolves only against unit methods and parsed prototype: declarations. The
# includes a foreign name implies are emission needs, not admission.
fn: l2_is_known (const: @(LmP0Text t)) int
    if: t = 0 || t\data = 0
        return: 0
    # Includes for runtime headers come from the source unit's own predef:/include:
    # (plus the profile prelude). Name-driven need_stdlib/need_string/need_p0/need_own
    # (FABLE-SONNET-NAME-SPECIALS-20260924-155 commit 3, :18296) are gone. Emitter-set
    # need_query remains where the translator emits its own helper.
    # c.* is the raw door; a leading c.array: local declarator is gone too
    # (FABLE-SONNET-NAME-SPECIALS-20260924-155 commit 4, :5029) -- it is
    # just an ordinary c.* frame now, matched here like any other.
    if: t\length > 2U && t\data[0] = 99 && t\data[1] = 46
        return: 1
    # FABLE-SONNET-NAME-SPECIALS-20260924-155 commit 2 (steps/name-specials-
    # inventory.md): the translator's own adapter families are LMX functions
    # implemented in L1 (l1src/parser.lm1, l1src/own.lm1, l2src/*.h.lm1) --
    # visible ONLY through the source unit's own predef: declarations, like
    # any other adapter, never through a name whitelist (plan §7a norm).
    # This dropped a hard-coded 11-name list that used to answer for a
    # handful of names before ever asking l2_predef_has_function; measured
    # which fixtures actually relied on it (none of them redundant with the
    # general mechanism) and gave each the predef:/prototype line it lacked
    # instead of keeping the special case.
    if: l2_predef_has_function(t) != 0
        return: 1
return: 0

# A c.name the generic C call lowers inside an expression. The forms excluded
# here have their own lowering: a type operand, an owned-text helper with a
# fixed emitted name, or a byte/Message operation with materialised operands.
fn: l2_c_door (const: @(LmP0Text t)) int
    if: l2_c_stmt_door(t) = 0
        return: 0
return: 1

# A c.name statement the generic C call lowers. c.* is a uniform raw door.
fn: l2_c_stmt_door (const: @(LmP0Text t)) int
    if: t = 0 || t\data = 0 || t\length <= 2U || t\data[0] != 99 || t\data[1] != 46
        return: 0
return: 1

# The primitive type words: a type operand of sizeof:, never a lexical
# reference. FABLE-SONNET-TYPE-WORD-FOLD-20260924-162 commit 2: thin
# wrapper over the shared pointer-local word-matcher (l2_ptr_type_word's
# depth=1 table already has exactly these six words; depth=2 would add
# nothing not already covered).
fn: l2_prim_type_word (const: @(LmP0Text t)) int
    int: dummy_ty 0
return: l2_ptr_type_word(t, 1, @ dummy_ty) = 0

fn: l2_is_binop (const: @(LmP0Text t)) int
    if: l2_is_plus(t) || l2_is_cmp(t) || l2_is_andor(t)
        return: 1
return: 0

fn: l2_node_has_call (const: @(LmP0Node node)) int
    @: LmP0Field f
    int: fi 0
    if: node = 0
        return: 0
    # A callable named as a value is called (l2_prep): a unit method, or a callable formal of the
    # method being lowered -- so `&&`/`||` guard it like any call.
    if: node\kind = c.LM_P0_NODE_ATOM && node\as != 0 && node\as\atom != 0 && l2_atom_callee(node\as\atom, l2_cur_mi, @ fi) >= 0
        return: 1
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && (l2_find_method(node\as\frame\head) >= 0 || l2_is_known(node\as\frame\head))
        return: 1
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\body != 0
        return: l2_fields_has_call(node\as\frame\body\first_field, l2_count_active(node\as\frame\body))
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0 && node\as\structure != 0
        return: l2_fields_has_call(node\as\structure\first_field, l2_count_active(node\as\structure))
return: 0

fn: l2_fields_has_call (@: LmP0Field field; int: n) int
    @: LmP0Field f
    int: i
    f: l2_next_active(field)
    i: 0
    while: i < n && f != 0
        if: l2_node_has_call(f\value)
            return: 1
        f: l2_next_active(f\next)
        i: i + 1
return: 0

fn: l2_is_or_atom (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_eq(node\as\atom, "||")

fn: l2_is_and_atom (const: @(LmP0Node node)) int
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_eq(node\as\atom, "&&")

fn: l2_advance (@: LmP0Field f; int: k) @: LmP0Field
    int: i 0
    while: i < k && f != 0
        f: l2_next_active(f\next)
        i: i + 1
return: f

fn: l2_span_or (@: LmP0Field field; int: n) int
    @: LmP0Field f
    int: i 0
    f: l2_next_active(field)
    while: i < n && f != 0
        if: i > 0 && l2_is_or_atom(f\value)
            return: i
        f: l2_next_active(f\next)
        i: i + 1
return: i

fn: l2_span_and (@: LmP0Field field; int: n) int
    @: LmP0Field f
    int: i 0
    f: l2_next_active(field)
    while: i < n && f != 0
        if: i > 0 && l2_is_and_atom(f\value)
            return: i
        f: l2_next_active(f\next)
        i: i + 1
return: i

fn: l2_bump_ind (const: @(char ind); @@: char dest) int
    size_t: ln
    size_t: need
    @: char made 0
    if: dest = 0 || ind = 0
        return: 1
    \dest: 0
    ln: strlen(ind)
    if: ln > ((cast: (size_t) -1) - 5U)
        l2_alloc_err: 2
        return: 1
    if: l2_indent_n = c.INT_MAX || l2_indent_reserve(l2_indent_n + 1) != 0
        return: 1
    need: ln + 5U
    l2_alloc_kind: 8
    made: (cast: (@: char) l2_xmalloc(need))
    if: made = 0
        return: 1
    memcpy(made, ind, ln)
    made[ln]: 32
    made[ln + 1U]: 32
    made[ln + 2U]: 32
    made[ln + 3U]: 32
    made[ln + 4U]: 0
    l2_indent_at[l2_indent_n]: made
    l2_indent_n: l2_indent_n + 1
    \dest: made
return: 0

fn: l2_new_temp (const: @(char ind); @: char dest) int
    int: t
    if: dest = 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.fprintf(l2_out, "%sint: l2_t%d\n", ind, t) < 0
        return: 1
return: l2_tok_temp(t, dest)

fn: l2_bool_set (const: @(char ind); const: @(char dest); const: @(char rhs)) int
    if: dest = 0 || rhs = 0 || ind = 0
        return: 1
    if: c.fprintf(l2_out, "%s%s: (%s) != 0\n", ind, dest, rhs) < 0
        return: 1
return: 0

fn: l2_eval_cond (@: LmP0Field field; int: n; int: mi; const: @(char ind); const: @(char dest)) int
    c.array: [1024]: char scratch
    if: dest = 0
        return: 1
    scratch[0]: 0
    if: l2_eval_fields(field, n, mi, ind, scratch) != 0
        return: 1
return: l2_bool_set(ind, dest, scratch)

fn: l2_intern_prove (const: @(char path); const: @(LmP0Node node)) int
    unsigned: id
    int: two
    if: l2_mul3_ok(2U, 3U, 4U) = 0
        return: l2_error(path, node, "intern broken")
    if: l2_mul3_ok((cast: (size_t) -1), 2U, 1U) != 0
        return: l2_error(path, node, "intern broken")
    if: l2_m_n = 0
        return: 0
    id: l2_m_sig[0]
    l2_intern_again: l2_intern_mi(0)
    if: l2_intern_again = 0U && l2_alloc_err = 2
        return: l2_error(path, node, "size overflow")
    if: l2_intern_again = 0U && l2_alloc_err != 0
        return: l2_error(path, node, "out of memory")
    if: id = 0U || l2_intern_again != id
        return: l2_error(path, node, "intern broken")
    l2_intern_swap: 0U
    two: 0
    if: l2_m_arity[0] = 2 && l2_m_f0[0] != 0 && l2_m_f1[0] != 0
        two: 1
    if: two != 0 && l2_text_same(l2_m_f0[0], l2_m_f1[0]) = 0
        l2_intern_swap: l2_intern_pair(l2_m_f1[0]\data, l2_m_f1[0]\length, l2_m_f0[0]\data, l2_m_f0[0]\length)
    if: two != 0 && l2_intern_swap = 0U && l2_alloc_err = 2
        return: l2_error(path, node, "size overflow")
    if: two != 0 && l2_intern_swap = 0U && l2_alloc_err != 0
        return: l2_error(path, node, "out of memory")
    if: two != 0 && l2_text_same(l2_m_f0[0], l2_m_f1[0]) = 0 && (l2_intern_swap = 0U || l2_intern_swap = id)
        return: l2_error(path, node, "intern failed to distinguish swapped formals")
    l2_intern_probe: l2_intern_pair("a", 1U, "b", 1U)
    if: l2_intern_probe = 0U && l2_alloc_err = 2
        return: l2_error(path, node, "size overflow")
    if: l2_intern_probe = 0U && l2_alloc_err != 0
        return: l2_error(path, node, "out of memory")
    if: l2_intern_probe = 0U
        return: l2_error(path, node, "intern broken")
    if: two != 0 && l2_text_eq(l2_m_f0[0], "a") && l2_text_eq(l2_m_f1[0], "b") && l2_ft(0, 0) = 0 && l2_intern_probe != id
        return: l2_error(path, node, "intern failed memcmp of equal names")
    if: two != 0 && (l2_text_eq(l2_m_f0[0], "a") = 0 || l2_text_eq(l2_m_f1[0], "b") = 0 || l2_ft(0, 0) != 0) && l2_intern_probe = id
        return: l2_error(path, node, "intern false-equal distinct contracts")
    l2_sigv: id
return: 0

fn: l2_ebr_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: psz
    size_t: nb
    size_t: nz
    @@: LmP0Text nn 0
    @@: LmP0Text nl 0
    @: size_t nv 0
    @@: LmP0Node na 0
    int: i
    if: need < 0
        return: 1
    if: need <= l2_ebr_cap
        return: 0
    if: need > c.INT_MAX
        l2_alloc_err: 2
        return: 1
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_ebr_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    psz: c.sizeof(@: char)
    if: l2_mul_ok(cap, psz) = 0 || l2_mul_ok(cap, c.sizeof(c.size_t)) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    nz: cap * c.sizeof(c.size_t)
    l2_alloc_kind: 5
    nn: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nl: (cast: (@@: LmP0Text) l2_xmalloc(nb))
    nv: (cast: (@: size_t) l2_xmalloc(nz))
    na: (cast: (@@: LmP0Node) l2_xmalloc(nb))
    if: nn = 0 || nl = 0 || nv = 0 || na = 0
        if: nn != 0
            l2_xfree((cast: (@: void) nn))
        if: nl != 0
            l2_xfree((cast: (@: void) nl))
        if: nv != 0
            l2_xfree((cast: (@: void) nv))
        if: na != 0
            l2_xfree((cast: (@: void) na))
        return: 1
    memset((cast: (@: void) nn), 0, nb)
    memset((cast: (@: void) nl), 0, nb)
    memset((cast: (@: void) nv), 0, nz)
    memset((cast: (@: void) na), 0, nb)
    i: 0
    while: i < l2_ebr_n
        nn[i]: l2_ebr_name[i]
        nl[i]: l2_ebr_leaf[i]
        nv[i]: l2_ebr_val[i]
        na[i]: l2_ebr_at[i]
        i: i + 1
    if: l2_ebr_name != 0
        l2_xfree((cast: (@: void) l2_ebr_name))
        l2_xfree((cast: (@: void) l2_ebr_leaf))
        l2_xfree((cast: (@: void) l2_ebr_val))
        l2_xfree((cast: (@: void) l2_ebr_at))
    l2_ebr_name: nn
    l2_ebr_leaf: nl
    l2_ebr_val: nv
    l2_ebr_at: na
    l2_ebr_cap: (cast: (int) cap)
return: 0

# Index of the qualified branch named by an atom, or -1. Qualified branches
# are the only NAMED Structures this subset has, so they are the only things
# a merge operand can currently spell.
fn: l2_ebr_find (const: @(LmP0Text t)) int
    int: i 0
    while: i < l2_ebr_n
        if: l2_text_same(l2_ebr_name[i], t) && l2_vis_ok(l2_ebr_at[i])
            return: i
        i: i + 1
    ---
return: 0 - 1

# independent: const: immutable: (): E   with one size_t child, SPEC 9.1.1/9.1.3.
#
# The three receivers are right-nested ordinary receivers and all are required:
# independent alone builds a zero-rooted Structure with no retention, and const:
# immutable alone freezes a value without making it eternal, so neither grants
# the eternal sharing contract (SPEC 7237). independent qualifies STRUCTURE
# CONSTRUCTION, never a bare primitive, which is why the leaf must be "()".
#
# E gets two references, per SPEC 9.1.4: an ordinary declaration-site child of
# the unit graph, and an entry in the root retention array. Neither reparents
# it; E\parent stays 0.
fn: l2_ns_find (const: @(LmP0Text t)) int
    int: i 0
    while: i < l2_ns_n
        if: l2_text_same(l2_ns_name[i], t) && l2_vis_ok(l2_ns_at[i])
            return: i
        i: i + 1
    ---
return: 0 - 1

fn: l2_payload_eq (const: @(LmP0Text atom); const: @(char s)) int
    const: @(char data)
    size_t: n
    size_t: sl
    if: atom = 0 || atom\data = 0 || s = 0
        return: 0
    data: atom\data
    n: atom\length
    if: n >= 2U && data[0] = 96 && data[n - 1U] = 96
        data: data + 1U
        n: n - 2U
    sl: strlen(s)
    if: n != sl
        return: 0
return: memcmp(data, s, n) = 0

fn: l2_ns_find_payload (const: @(LmP0Text t)) int
    const: @(char data)
    size_t: n
    int: i 0
    if: t = 0 || t\data = 0
        return: 0 - 1
    data: t\data
    n: t\length
    if: n >= 2U && data[0] = 96 && data[n - 1U] = 96
        data: data + 1U
        n: n - 2U
    while: i < l2_ns_n
        if: l2_ns_name[i] != 0 && l2_ns_name[i]\data != 0 && l2_ns_name[i]\length = n && memcmp(l2_ns_name[i]\data, data, n) = 0 && l2_vis_ok(l2_ns_at[i])
            return: i
        i: i + 1
    ---
return: 0 - 1

fn: l2_ns_has_field (int: ni; const: @(char name)) int
    int: k 0
    size_t: n
    if: ni < 0 || name = 0
        return: 0
    n: strlen(name)
    if: n = 0U
        return: 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni && l2_nsf_fname[k] != 0 && l2_nsf_fname[k]\data != 0 && l2_nsf_fname[k]\length = n && memcmp(l2_nsf_fname[k]\data, name, n) = 0
            return: 1
        k: k + 1
    ---
return: 0

# First-level field names, prior lm_trans_descriptor_implements: every consumer
# field that is also on required must be present on candidate. Empty required
# or empty consumer is true.
fn: l2_descriptor_implements (int: cand; int: req; int: cons; @: int out_result) int
    int: k 0
    int: req_n 0
    int: cons_n 0
    @: char fname
    c.array: [128]: char buf
    if: out_result != 0
        \out_result: 0
    if: cand < 0 || req < 0 || cons < 0 || out_result = 0
        return: 1
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = req
            req_n: req_n + 1
        if: l2_nsf_owner[k] = cons
            cons_n: cons_n + 1
        k: k + 1
    if: req_n = 0 || cons_n = 0
        \out_result: 1
        return: 0
    k: 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = cons && l2_nsf_fname[k] != 0 && l2_nsf_fname[k]\data != 0 && l2_nsf_fname[k]\length > 0U && l2_nsf_fname[k]\length < 128U
            memcpy(buf, l2_nsf_fname[k]\data, l2_nsf_fname[k]\length)
            buf[l2_nsf_fname[k]\length]: 0
            fname: buf
            if: l2_ns_has_field(req, fname) != 0
                if: l2_ns_has_field(cand, fname) = 0
                    \out_result: 0
                    return: 0
                ---
            ---
        ---
        k: k + 1
    ---
    \out_result: 1
return: 0

# Hosted primitive.description rows from lingvamyxa_prev/lm2/primitive.lm2.
# cell=0 and convert=forbidden are void/None; every other listed name has a cell
# and a non-forbidden convert (keyed).
fn: l2_prim_kind (const: @(LmP0Text name); @: int out_cell; @: int out_forbid) int
    if: out_cell != 0
        \out_cell: 0
    if: out_forbid != 0
        \out_forbid: 0
    if: name = 0
        return: 0
    if: l2_payload_eq(name, "void") != 0 || l2_payload_eq(name, "None") != 0
        \out_cell: 0
        \out_forbid: 1
        return: 1
    if: l2_payload_eq(name, "int") != 0 || l2_payload_eq(name, "u32") != 0 || l2_payload_eq(name, "long") != 0 || l2_payload_eq(name, "double") != 0 || l2_payload_eq(name, "Boolean") != 0 || l2_payload_eq(name, "FILE") != 0 || l2_payload_eq(name, "char") != 0 || l2_payload_eq(name, "short") != 0 || l2_payload_eq(name, "float") != 0 || l2_payload_eq(name, "unsigned") != 0 || l2_payload_eq(name, "size_t") != 0 || l2_payload_eq(name, "u8") != 0 || l2_payload_eq(name, "u16") != 0 || l2_payload_eq(name, "u64") != 0 || l2_payload_eq(name, "i8") != 0 || l2_payload_eq(name, "i16") != 0 || l2_payload_eq(name, "i32") != 0 || l2_payload_eq(name, "i64") != 0 || l2_payload_eq(name, "bool") != 0 || l2_payload_eq(name, "uint") != 0 || l2_payload_eq(name, "ulong") != 0
        \out_cell: 1
        \out_forbid: 0
        return: 1
return: 0

# Prior lm_trans_primitive_leaf_implements: 0 = decided, 1 = malformed, 2 = not
# a primitive pair (fall through to structural descriptors).
fn: l2_primitive_leaf_implements (const: @(LmP0Text cand); const: @(LmP0Text req); @: int out_result) int
    int: c_cell 0
    int: r_cell 0
    int: c_forb 0
    int: r_forb 0
    int: c_ok
    int: r_ok
    const: @(char cd)
    const: @(char rd)
    size_t: cn
    size_t: rn
    if: out_result != 0
        \out_result: 0
    if: cand = 0 || req = 0 || cand\data = 0 || req\data = 0 || out_result = 0
        return: 1
    cd: cand\data
    cn: cand\length
    rd: req\data
    rn: req\length
    if: cn >= 2U && cd[0] = 96 && cd[cn - 1U] = 96
        cd: cd + 1U
        cn: cn - 2U
    if: rn >= 2U && rd[0] = 96 && rd[rn - 1U] = 96
        rd: rd + 1U
        rn: rn - 2U
    if: l2_payload_eq(cand, "void") != 0 || l2_payload_eq(req, "void") != 0 || l2_payload_eq(cand, "None") != 0 || l2_payload_eq(req, "None") != 0
        \out_result: 0
        return: 0
    c_ok: l2_prim_kind(cand, @ c_cell, @ c_forb)
    r_ok: l2_prim_kind(req, @ r_cell, @ r_forb)
    if: c_ok != 0 && cn = rn && memcmp(cd, rd, cn) = 0
        \out_result: 1
        return: 0
    if: c_ok = 0 || r_ok = 0
        return: 2
    if: c_cell = 0 || r_cell = 0
        \out_result: 0
        return: 0
    if: c_forb != 0 || r_forb != 0
        \out_result: 0
        return: 0
    \out_result: 1
return: 0

fn: l2_implements (const: @(LmP0Text cand); const: @(LmP0Text req); const: @(LmP0Text cons); @: int out_result) int
    int: cni
    int: rni
    int: sni
    int: status
    int: dummy_cell 0
    int: dummy_forb 0
    int: k 0
    int: req_n 0
    if: out_result != 0
        \out_result: 0
    if: cand = 0 || req = 0 || cons = 0 || out_result = 0
        return: 1
    sni: l2_ns_find_payload(cons)
    if: sni < 0
        return: 2
    status: l2_primitive_leaf_implements(cand, req, out_result)
    if: status = 1
        return: 1
    if: status = 0
        return: 0
    cni: l2_ns_find_payload(cand)
    rni: l2_ns_find_payload(req)
    if: cni < 0 && l2_prim_kind(cand, @ dummy_cell, @ dummy_forb) != 0 && rni >= 0
        while: k < l2_nsf_n
            if: l2_nsf_owner[k] = rni
                req_n: req_n + 1
            k: k + 1
        if: req_n = 0
            \out_result: 1
            return: 0
        \out_result: 0
        return: 0
    if: rni < 0 && l2_prim_kind(req, @ dummy_cell, @ dummy_forb) != 0 && cni >= 0
        \out_result: 0
        return: 0
    if: cni < 0
        return: 3
    if: rni < 0
        return: 4
return: l2_descriptor_implements(cni, rni, sni, out_result)

fn: l2_implements_arg_atom (const: @(LmP0Node node); @: LmP0Text out) int
    if: node = 0 || out = 0 || node\kind != c.LM_P0_NODE_ATOM || node\as = 0 || node\as\atom = 0
        return: 0
    out\data: node\as\atom\data
    out\length: node\as\atom\length
return: 1

fn: l2_check_implements (const: @(LmP0Node node); const: @(char path)) int
    const: @: LmP0Frame call
    @: LmP0Field a0
    @: LmP0Field a1
    @: LmP0Field a2
    @: LmP0Field a3
    @: LmP0Text cand 0
    @: LmP0Text req 0
    @: LmP0Text cons 0
    int: result 0
    int: status
    if: node = 0 || node\as = 0 || node\as\frame = 0
        return: l2_error(path, node, "implements expects candidate, required, consumer")
    call: node\as\frame
    if: call\body = 0 || call\trailer != 0 || call\body\trailer != 0 || l2_count_active(call\body) != 3
        return: l2_error(path, node, "implements expects candidate, required, consumer")
    a0: l2_next_active(call\body\first_field)
    a1: l2_next_active(a0\next)
    a2: l2_next_active(a1\next)
    a3: l2_next_active(a2\next)
    cand: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    req: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    cons: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    if: cand = 0 || req = 0 || cons = 0
        if: cand != 0
            l2_xfree((cast: (@: void) cand))
        if: req != 0
            l2_xfree((cast: (@: void) req))
        if: cons != 0
            l2_xfree((cast: (@: void) cons))
        return: l2_error(path, node, "out of memory")
    status: 1
    if: a3 != 0 || l2_implements_arg_atom(a0\value, cand) = 0 || l2_implements_arg_atom(a1\value, req) = 0 || l2_implements_arg_atom(a2\value, cons) = 0
        l2_xfree((cast: (@: void) cand))
        l2_xfree((cast: (@: void) req))
        l2_xfree((cast: (@: void) cons))
        return: l2_error(path, node, "implements expects descriptor names")
    status: l2_implements(cand, req, cons, @ result)
    l2_xfree((cast: (@: void) cand))
    l2_xfree((cast: (@: void) req))
    l2_xfree((cast: (@: void) cons))
    if: status = 2
        return: l2_error(path, a2\value, "unknown consumer descriptor")
    if: status = 3
        return: l2_error(path, a0\value, "unknown candidate descriptor")
    if: status = 4
        return: l2_error(path, a1\value, "unknown required descriptor")
    if: status != 0
        return: l2_error(path, node, "malformed implements descriptor")
return: 0

fn: l2_prep_implements (const: @(LmP0Node node); @: char dest) int
    const: @: LmP0Frame call
    @: LmP0Field a0
    @: LmP0Field a1
    @: LmP0Field a2
    @: LmP0Text cand 0
    @: LmP0Text req 0
    @: LmP0Text cons 0
    int: result 0
    int: status
    if: dest = 0 || node = 0 || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0
        return: 1
    call: node\as\frame
    a0: l2_next_active(call\body\first_field)
    a1: l2_next_active(a0\next)
    a2: l2_next_active(a1\next)
    cand: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    req: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    cons: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    if: cand = 0 || req = 0 || cons = 0
        if: cand != 0
            l2_xfree((cast: (@: void) cand))
        if: req != 0
            l2_xfree((cast: (@: void) req))
        if: cons != 0
            l2_xfree((cast: (@: void) cons))
        return: 1
    if: l2_implements_arg_atom(a0\value, cand) = 0 || l2_implements_arg_atom(a1\value, req) = 0 || l2_implements_arg_atom(a2\value, cons) = 0
        l2_xfree((cast: (@: void) cand))
        l2_xfree((cast: (@: void) req))
        l2_xfree((cast: (@: void) cons))
        return: 1
    status: l2_implements(cand, req, cons, @ result)
    l2_xfree((cast: (@: void) cand))
    l2_xfree((cast: (@: void) req))
    l2_xfree((cast: (@: void) cons))
    if: status != 0
        return: 1
    if: result != 0
        dest[0]: 49
        dest[1]: 0
    else:
        dest[0]: 48
        dest[1]: 0
    ---
return: 0

fn: l2_nsty_set (int: mi; int: k; int: ni) int
    int: cap
    @: int nmi 0
    @: int nk 0
    @: int nni 0
    if: ni < 0
        return: 0
    if: l2_nsty_n >= l2_nsty_cap
        cap: l2_nsty_cap
        if: cap < 1
            cap: 8
        while: cap <= l2_nsty_n
            if: cap > c.INT_MAX / 2
                cap: l2_nsty_n + 1
            else:
                cap: cap * 2
            ---
        nmi: (cast: (@: int) malloc((cast: (size_t) cap) * c.sizeof(c.int)))
        nk: (cast: (@: int) malloc((cast: (size_t) cap) * c.sizeof(c.int)))
        nni: (cast: (@: int) malloc((cast: (size_t) cap) * c.sizeof(c.int)))
        if: nmi = 0 || nk = 0 || nni = 0
            if: nmi != 0
                free((cast: (@: void) nmi))
            if: nk != 0
                free((cast: (@: void) nk))
            if: nni != 0
                free((cast: (@: void) nni))
            return: 1
        if: l2_nsty_n > 0
            memcpy((cast: (@: void) nmi), (cast: (@: void) l2_nsty_mi), (cast: (size_t) l2_nsty_n) * c.sizeof(c.int))
            memcpy((cast: (@: void) nk), (cast: (@: void) l2_nsty_k), (cast: (size_t) l2_nsty_n) * c.sizeof(c.int))
            memcpy((cast: (@: void) nni), (cast: (@: void) l2_nsty_ni), (cast: (size_t) l2_nsty_n) * c.sizeof(c.int))
        if: l2_nsty_mi != 0
            free((cast: (@: void) l2_nsty_mi))
        if: l2_nsty_k != 0
            free((cast: (@: void) l2_nsty_k))
        if: l2_nsty_ni != 0
            free((cast: (@: void) l2_nsty_ni))
        l2_nsty_mi: nmi
        l2_nsty_k: nk
        l2_nsty_ni: nni
        l2_nsty_cap: cap
    l2_nsty_mi[l2_nsty_n]: mi
    l2_nsty_k[l2_nsty_n]: k
    l2_nsty_ni[l2_nsty_n]: ni
    l2_nsty_n: l2_nsty_n + 1
return: 0

fn: l2_nsty_get (int: mi; int: k) int
    int: i 0
    while: i < l2_nsty_n
        if: l2_nsty_mi[i] = mi && l2_nsty_k[i] = k
            return: l2_nsty_ni[i]
        i: i + 1
    ---
return: 0 - 1

fn: l2_nsty_of_name (int: mi; const: @(LmP0Text name)) int
    int: fi
    int: ni
    if: name = 0
        return: 0 - 1
    fi: l2_formal_find(mi, name)
    if: fi >= 0
        ni: l2_nsty_get(mi, fi)
        if: ni >= 0
            return: ni
        ---
    ---
return: l2_ns_find_payload(name)

# An own field's namespace/type index, keyed into the same (mi, k) table
# l2_nsty_set/get already hold formal/return namespace types in -- FABLE-
# SONNET-FIELD-PATHS-20260923-113. Formal slot keys are >= 0 and -1 is the
# return value, so k = -2 - oi can never collide with either: one table, no
# second index or parallel array (next_core_tasks.md 4).
fn: l2_own_nsty_set (int: oi; int: ni) int
    if: oi < 0 || ni < 0
        return: 0
return: l2_nsty_set(l2_own_mi[oi], 0 - 2 - oi, ni)

fn: l2_own_nsty_get (int: oi) int
    if: oi < 0
        return: 0 - 1
return: l2_nsty_get(l2_own_mi[oi], 0 - 2 - oi)

fn: l2_fn_frame (int: mi) @: LmP0Frame
    if: l2_m_node != 0 && l2_m_node[mi] != 0 && l2_m_node[mi]\as != 0
        return: l2_m_node[mi]\as\frame
return: 0

fn: l2_uses_is_slash (const: @(LmP0Text text)) int
return: text != 0 && text\length = 1U && text\data != 0 && text\data[0] = 92

fn: l2_uses_slash_off (const: @(char data); size_t: length) size_t
    size_t: i 0U
    while: i < length
        if: data[i] = 92
            return: i
        i: i + 1U
return: length

sub: l2_uses_path_add (@: char paths; @: size_t count; const: @(char path); size_t: length)
    @: char slot
    size_t: i 0U
    size_t: n
    if: paths = 0 || count = 0 || path = 0 || length = 0U || length >= 128U
        return
    while: i < \count
        slot: paths + (i * 128U)
        n: strlen(slot)
        if: n = length && memcmp(slot, path, n) = 0
            return
        i: i + 1U
    if: \count >= 64U
        return
    slot: paths + (\count * 128U)
    memcpy(slot, path, length)
    slot[length]: 0
    \count: \count + 1U
end: l2_uses_path_add

fn: l2_uses_name_eq (const: @(LmP0Text name); const: @(LmP0Text varb)) int
    const: @(char ad)
    const: @(char bd)
    size_t: an
    size_t: bn
    if: name = 0 || varb = 0 || name\data = 0 || varb\data = 0
        return: 0
    ad: name\data
    an: name\length
    bd: varb\data
    bn: varb\length
    if: an >= 2U && ad[0] = 96 && ad[an - 1U] = 96
        ad: ad + 1U
        an: an - 2U
    if: bn >= 2U && bd[0] = 96 && bd[bn - 1U] = 96
        bd: bd + 1U
        bn: bn - 2U
    if: an != bn
        return: 0
return: memcmp(ad, bd, an) = 0

fn: l2_uses_scan_follow (const: @(LmP0Text varb); @: char paths; @: size_t count; @: LmP0Field start) @: LmP0Field
    @: LmP0Field field
    @: LmP0Text name
    c.array: [128]: char path
    size_t: used 0U
    int: tracked
    if: start = 0 || start\value = 0 || start\value\kind != c.LM_P0_NODE_ATOM
        return: start
    name: start\value\as\atom
    tracked: l2_uses_name_eq(name, varb)
    field: start\next
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || l2_uses_is_slash(field\value\as\atom) = 0
        return: start
    while: field != 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && l2_uses_is_slash(field\value\as\atom) != 0
        field: field\next
        if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || field\value\as\atom = 0
            return: start
        name: field\value\as\atom
        if: tracked != 0 && name\length > 0U
            if: used != 0U && used + 1U < 128U
                path[used]: 92
                used: used + 1U
            if: used + name\length < 128U
                memcpy(path + used, name\data, name\length)
                used: used + name\length
            ---
        ---
        field: field\next
    if: tracked != 0 && used > 0U
        l2_uses_path_add(paths, count, path, used)
return: field

fn: l2_uses_walk_frame (const: @(LmP0Text varb); @: char paths; @: size_t count; const: @(LmP0Frame frame)) int
    @: LmP0Text head 0
    size_t: slash
    size_t: rest
    if: varb = 0 || frame = 0
        return: 0
    if: frame\head != 0 && frame\head\data != 0 && frame\head\length > 0U
        slash: l2_uses_slash_off(frame\head\data, frame\head\length)
        if: slash < frame\head\length
            if: slash > 0U
                head: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
                if: head != 0
                    head\data: frame\head\data
                    head\length: slash
                    if: l2_uses_name_eq(head, varb) != 0 && slash + 1U < frame\head\length
                        rest: frame\head\length - slash - 1U
                        l2_uses_path_add(paths, count, frame\head\data + slash + 1U, rest)
                    ---
                    l2_xfree((cast: (@: void) head))
                ---
            ---
            return: l2_uses_walk_structure(varb, paths, count, frame\body)
        ---
    ---
return: l2_uses_walk_structure(varb, paths, count, frame\body)

fn: l2_uses_walk_structure (const: @(LmP0Text varb); @: char paths; @: size_t count; const: @(LmP0Structure body)) int
    @: LmP0Field field
    @: LmP0Field next
    if: varb = 0 || body = 0
        return: 0
    field: body\first_field
    while: field != 0
        next: l2_uses_scan_follow(varb, paths, count, field)
        if: next != field
            field: next
        else:
            if: l2_uses_walk_node(varb, paths, count, field\value) != 0
                return: 1
            field: field\next
        ---
return: 0

fn: l2_uses_walk_node (const: @(LmP0Text varb); @: char paths; @: size_t count; const: @(LmP0Node node)) int
    if: varb = 0 || node = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0
        return: l2_uses_walk_structure(varb, paths, count, node\as\structure)
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0
        return: l2_uses_walk_frame(varb, paths, count, node\as\frame)
return: 0

fn: l2_admit_implements (int: cand; int: req; const: @(LmP0Text cand_name); const: @(char path); const: @(LmP0Node at); const: @(char context)) int
    int: compatible 0
    if: cand < 0 || req < 0
        return: 0
    if: cand = req
        return: 0
    if: l2_descriptor_implements(cand, req, req, @ compatible) != 0
        return: l2_error(path, at, "malformed implements descriptor")
    if: compatible = 0
        if: context != 0 && strcmp(context, "function argument") = 0
            return: l2_error(path, at, "implements is false in function argument")
        if: context != 0 && strcmp(context, "assignment") = 0
            return: l2_error(path, at, "implements is false in assignment")
        if: context != 0 && strcmp(context, "return value") = 0
            return: l2_error(path, at, "implements is false in return value")
        return: l2_error(path, at, "implements is false")
return: 0

fn: l2_admit_consumer_uses (const: @(LmP0Text cand_name); int: req; const: @(LmP0Text varb); const: @(LmP0Frame consumer); const: @(char path); const: @(LmP0Node at); const: @(char context)) int
    int: cand
    @: char paths
    size_t: path_count 0U
    if: cand_name = 0 || req < 0
        return: 0
    cand: l2_ns_find_payload(cand_name)
    if: cand < 0
        return: 0
    if: consumer = 0
        return: l2_admit_implements(cand, req, cand_name, path, at, context)
    paths: (cast: (@: char) l2_xmalloc(64U * 128U))
    if: paths = 0
        return: l2_error(path, at, "out of memory")
    memset((cast: (@: void) paths), 0, 64U * 128U)
    if: l2_uses_walk_frame(varb, paths, @ path_count, consumer) != 0
        l2_xfree((cast: (@: void) paths))
        return: 1
    l2_xfree((cast: (@: void) paths))
    if: path_count = 0U
        return: 0
return: l2_admit_implements(cand, req, cand_name, path, at, context)

# An otherwise unrecognized unit-level frame with a matching end is an ordinary
# named Structure. Reserved heads are matched before this is ever reached, so a
# malformed reserved construct stays an error rather than becoming a
# declaration. Fields are size_t literals in this slice.
# Grow every per-Structure table by one and return the new index, or -1.
fn: l2_ns_push (const: @(LmP0Text name); int: parent; const: @(LmP0Node at)) int
    @@: LmP0Text gn
    @@: LmP0Node ga
    @: int gi
    size_t: want (cast: (size_t) (l2_ns_n + 1))
    gn: (cast: (@@: LmP0Text) realloc((cast: (@: void) l2_ns_name), want * c.sizeof(@: void)))
    if: gn = 0
        return: 0 - 1
    l2_ns_name: gn
    gi: (cast: (@: int) realloc((cast: (@: void) l2_ns_first), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_ns_first: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_ns_count), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_ns_count: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_ns_parent), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_ns_parent: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_ns_eternal), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_ns_eternal: gi
    ga: (cast: (@@: LmP0Node) realloc((cast: (@: void) l2_ns_at), want * c.sizeof(@: void)))
    if: ga = 0
        return: 0 - 1
    l2_ns_at: ga
    l2_ns_at[l2_ns_n]: (cast: (@: LmP0Node) at)
    l2_ns_name[l2_ns_n]: (cast: (@: LmP0Text) name)
    l2_ns_first[l2_ns_n]: 0
    l2_ns_count[l2_ns_n]: 0
    l2_ns_parent[l2_ns_n]: parent
    l2_ns_eternal[l2_ns_n]: 0 - 1
    l2_ns_n: l2_ns_n + 1
return: l2_ns_n - 1

# Grow every per-field table by one and return the new index, or -1.
fn: l2_nsf_push (int: kind; size_t: value; int: ref; int: owner) int
    @@: LmP0Text gt
    @: size_t gv
    @: int gi
    size_t: want (cast: (size_t) (l2_nsf_n + 1))
    gv: (cast: (@: size_t) realloc((cast: (@: void) l2_nsf_val), want * c.sizeof(c.size_t)))
    if: gv = 0
        return: 0 - 1
    l2_nsf_val: gv
    gi: (cast: (@: int) realloc((cast: (@: void) l2_nsf_kind), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_nsf_kind: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_nsf_ref), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_nsf_ref: gi
    gt: (cast: (@@: LmP0Text) realloc((cast: (@: void) l2_nsf_name), want * c.sizeof(@: void)))
    if: gt = 0
        return: 0 - 1
    l2_nsf_name: gt
    gt: (cast: (@@: LmP0Text) realloc((cast: (@: void) l2_nsf_fname), want * c.sizeof(@: void)))
    if: gt = 0
        return: 0 - 1
    l2_nsf_fname: gt
    l2_nsf_val[l2_nsf_n]: value
    l2_nsf_kind[l2_nsf_n]: kind
    gi: (cast: (@: int) realloc((cast: (@: void) l2_nsf_owner), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_nsf_owner: gi
    l2_nsf_ref[l2_nsf_n]: ref
    l2_nsf_name[l2_nsf_n]: 0
    l2_nsf_fname[l2_nsf_n]: 0
    l2_nsf_owner[l2_nsf_n]: owner
    l2_nsf_n: l2_nsf_n + 1
return: l2_nsf_n - 1

# The value of a char literal written as an apostrophe-quoted single byte.
fn: l2_char_literal (const: @(LmP0Text t)) int
    if: t = 0 || t\data = 0 || t\length != 3U
        return: 0 - 1
    if: t\data[0] != 39 || t\data[2] != 39
        return: 0 - 1
return: (cast: (int) (cast: (unsigned char) t\data[1]))

# ADMISSION OF AN UNTYPED GRAPH (fable's B2 for S3, the author's Q12): a graph
# with no declared Structure type -- the letter receiveMessage takes, an `@: Lmx`
# value -- bound to a declared Structure type, by `receiveMessage:` into a typed
# own field, by rebinding a typed own field, or as the argument of a typed
# formal, is admitted at that binding by the kernel's runtime implements walk.
# The translator's part is the static one: the target's type is a declared
# Structure.  The coarse walk is the interim admission until the
# receiving-expression port (next_core_tasks.md 7).

# The declared Structure type of a graph-valued name -- a formal's, else an own
# field's -- or -1 when it has none.
fn: l2_graph_nsty (int: mi; const: @(LmP0Text name)) int
    int: i
    if: mi < 0 || name = 0
        return: 0 - 1
    i: l2_formal_find(mi, name)
    if: i >= 0
        return: l2_nsty_get(mi, i)
    i: l2_own_find_last(mi, name)
    if: i >= 0
        return: l2_own_nsty_get(i)
return: 0 - 1

# Is this value one name of an untyped graph: graph-valued, no declared type?
fn: l2_untyped_graph (int: mi; const: @(LmP0Node value)) int
    int: ty 0
    if: value = 0 || value\kind != c.LM_P0_NODE_ATOM || value\as = 0 || value\as\atom = 0 || l2_ident(value\as\atom) = 0
        return: 0
    if: l2_colon_bound_ty(mi, value\as\atom, @ ty) != 0 || l2_colon_is_graph_ty(ty) = 0
        return: 0
    if: l2_graph_nsty(mi, value\as\atom) >= 0
        return: 0
return: 1

# The runtime shape of a declared Structure type: the declaration's own
# materialised unit child, the operand `Type: x` merges too.
fn: l2_type_inst (int: ni; @: char dest) int
    if: ni < 0 || ni >= l2_ns_n || dest = 0 || l2_ns_parent[ni] >= 0
        return: 1
    if: l2_ns_eternal[ni] < 0 && c.sprintf(dest, "lmx_arena_ref_struct(%s, %uU)", l2_unit_ref, (cast: (unsigned) (l2_ns_base + l2_ns_rank(ni)))) < 0
        return: 1
    if: l2_ns_eternal[ni] >= 0 && c.sprintf(dest, "lmx_arena_ref_struct(%s, %uU)", l2_unit_ref, (cast: (unsigned) (l2_unit_base + l2_occ_n() + l2_ns_eternal[ni]))) < 0
        return: 1
return: 0

# A site that can refuse admission makes its method fail the way a failing
# merge does, so the method takes the status ABI (closed over callers later).
fn: l2_admit_site (int: mi) int
    if: mi < 0 || l2_m_throws = 0
        return: 1
    l2_m_throws[mi]: 1
    l2_need_admit: 1
return: 0

# THE IMPLICIT THROW NAMES (S1.1).  An operator that fails throws its own name; nobody has to
# catch it, and uncaught it reaches the root of the executing Message, which stops (author Q11).
# The team names them (Q17 = A), and this table is the one place that spells them.  Its ORDER is
# the global g, the same in every method: a method's status for implicit name g is d + g, where d
# is the number of names the method declares (0 is the normal return, 1..d its declared names), so
# a caller that knows a callee's d -- from the callee, or from a callable formal's signature --
# knows every implicit status the callee can return.  No other status is on the channel: the
# translator's and the kernel's own broken promises take the diagnostic route (X1,
# l2_emit_invariant), never a status.
fn: l2_implicit_name (int: g) const: @: char
    if: g = 1
        return: "merge"
    if: g = 2
        return: "implements"
return: 0

# THE DECLARED THROW NAMES (S1.2).  `throws:` is the first item of a method head (author Q13):
# the names that may leave the method, in order.  A name's position is its status -- name k
# leaves method mi as k, 1..d -- and the implicit names follow at d + g.  E has no list: its row
# has no method frame.  The list is read from the source tree, like the formals.
fn: l2_throws_frame (int: mi) @: LmP0Node
    @: LmP0Field f
    if: mi < 0 || mi >= l2_m_n || l2_m_node[mi] = 0 || l2_m_body[mi] = 0 || l2_m_body[mi]\kind != c.LM_P0_NODE_STRUCTURE || l2_m_body[mi]\as = 0 || l2_m_body[mi]\as\structure = 0
        return: 0
    f: l2_next_active(l2_m_body[mi]\as\structure\first_field)
    if: f = 0 || l2_frame_head(f\value, "throws") = 0
        return: 0
return: f\value

# d: how many throw names method mi declares.
fn: l2_throws_declared (int: mi) int
    @: LmP0Node t
    t: l2_throws_frame(mi)
    if: t = 0 || t\as = 0 || t\as\frame = 0 || t\as\frame\body = 0
        return: 0
return: l2_count_active(t\as\frame\body)

# Name k (1..d) of method mi's `throws:`; 0 past its end.
fn: l2_throws_name (int: mi; int: k) @: LmP0Text
    @: LmP0Node t
    @: LmP0Field f
    int: i 1
    t: l2_throws_frame(mi)
    if: t = 0 || t\as = 0 || t\as\frame = 0 || t\as\frame\body = 0 || k < 1
        return: 0
    f: l2_next_active(t\as\frame\body\first_field)
    while: f != 0 && i < k
        f: l2_next_active(f\next)
        i: i + 1
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
        return: 0
return: f\value\as\atom

# The position of `name` in method mi's `throws:`, 1..d; 0: not declared there.
fn: l2_throws_pos (int: mi; const: @(LmP0Text name)) int
    int: k 1
    int: d
    if: name = 0
        return: 0
    d: l2_throws_declared(mi)
    while: k <= d
        if: l2_text_same(l2_throws_name(mi, k), name) != 0
            return: k
        k: k + 1
return: 0

# Two methods declare the same names in the same order: one signature for the intern, and a
# callable formal's contract (S1.4).  A row < 0 declares none.
fn: l2_throws_same (int: a; int: b) int
    int: k 1
    int: d
    d: l2_throws_declared(a)
    if: d != l2_throws_declared(b)
        return: 0
    while: k <= d
        if: l2_text_same(l2_throws_name(a, k), l2_throws_name(b, k)) = 0
            return: 0
        k: k + 1
return: 1

# `throws:` leading a method head names at least one exit: each an identifier, none twice, and
# none an implicit name -- those are thrown by their operators and are not declared (fable,
# -135: a rule may one day promote them; the translator does not).
fn: l2_check_throws_list (const: @(LmP0Node body); const: @(char path)) int
    @: LmP0Field f
    @: LmP0Field g
    @: LmP0Node t
    int: gi
    if: body = 0 || body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0 || body\as\structure = 0
        return: 0
    f: l2_next_active(body\as\structure\first_field)
    if: f = 0 || l2_frame_head(f\value, "throws") = 0
        return: 0
    t: f\value
    if: t\as\frame\trailer != 0 || t\as\frame\body = 0 || t\as\frame\body\trailer != 0 || l2_count_active(t\as\frame\body) = 0
        return: l2_error(path, t, "throws: lists the names that may leave the method")
    f: l2_next_active(t\as\frame\body\first_field)
    while: f != 0
        if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || l2_ident(f\value\as\atom) = 0 || f\value\as\atom\length >= 63U
            return: l2_error(path, t, "a throws: item is a name")
        gi: 1
        while: l2_implicit_name(gi) != 0
            if: l2_text_eq(f\value\as\atom, l2_implicit_name(gi)) != 0
                return: l2_error(path, f\value, "an implicit throw name is not declared")
            gi: gi + 1
        g: l2_next_active(t\as\frame\body\first_field)
        while: g != f
            if: l2_text_same(g\value\as\atom, f\value\as\atom) != 0
                return: l2_error(path, f\value, "duplicate name in throws:")
            g: l2_next_active(g\next)
        f: l2_next_active(f\next)
return: 0

# THE CATCH BLOCKS (S1.3, §14).  `catch: Name (params)` with its handler body is a landing pad in
# the caller's block.  A handler covers every call of its block and of the statement blocks
# nested in it (Q14 K); the innermost block that catches the name takes it, and a sibling block
# is not searched.  A name thrown inside its own handler is not caught by that handler: the
# search goes on in the enclosing blocks (§14 :495).
#
# The statements of the block a scope entry stands for: an if/while body or an anonymous `---`
# (the Structure itself), an else, a for's body, a catch's handler body.
fn: l2_scope_block (const: @(LmP0Node node)) @: LmP0Structure
    @: LmP0Field f
    int: k 1
    if: node = 0 || node\as = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        return: node\as\structure
    if: node\kind != c.LM_P0_NODE_FRAME || node\as\frame = 0 || node\as\frame\body = 0
        return: 0
    if: l2_frame_head(node, "else")
        return: node\as\frame\body
    f: l2_next_active(node\as\frame\body\first_field)
    if: l2_frame_head(node, "catch")
        k: 3
    if: l2_frame_head(node, "for")
        k: 5
    if: k = 1
        return: 0
    while: f != 0 && k > 1
        f: l2_next_active(f\next)
        k: k - 1
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_STRUCTURE || f\value\as = 0
        return: 0
return: f\value\as\structure

# The name a catch frame handles.
fn: l2_catch_name (const: @(LmP0Node cf)) @: LmP0Text
    @: LmP0Field f
    if: l2_frame_head(cf, "catch") = 0 || cf\as\frame\body = 0
        return: 0
    f: l2_next_active(cf\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
        return: 0
return: f\value\as\atom

# A catch frame's parameters, and its handler body (0: none).
fn: l2_catch_params (const: @(LmP0Node cf)) @: LmP0Structure
    @: LmP0Field f
    if: l2_frame_head(cf, "catch") = 0 || cf\as\frame\body = 0
        return: 0
    f: l2_next_active(cf\as\frame\body\first_field)
    if: f != 0
        f: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_STRUCTURE || f\value\as = 0
        return: 0
return: f\value\as\structure

fn: l2_catch_body (const: @(LmP0Node cf)) @: LmP0Structure
return: l2_scope_block(cf)

# The catch of `name` among the direct statements of block blk, and its place among the block's
# catches, 1..m (0: none).  A declared name comes as text, an implicit one as its table spelling.
fn: l2_block_catch (const: @(LmP0Structure blk); const: @(LmP0Text tname); const: @(char cname); @: int out_idx) @: LmP0Node
    @: LmP0Field f
    @: LmP0Text nm
    int: i 0
    if: out_idx != 0
        \out_idx: 0
    if: blk = 0
        return: 0
    f: l2_next_active(blk\first_field)
    while: f != 0
        if: l2_frame_head(f\value, "catch")
            i: i + 1
            nm: l2_catch_name(f\value)
            if: nm != 0 && ((tname != 0 && l2_text_same(nm, tname) != 0) || (cname != 0 && l2_text_eq(nm, cname) != 0))
                if: out_idx != 0
                    \out_idx: i
                return: f\value
            ---
        f: l2_next_active(f\next)
return: 0

# Does block blk hold a catch at all?
fn: l2_block_has_catch (const: @(LmP0Structure blk)) int
    @: LmP0Field f
    if: blk = 0
        return: 0
    f: l2_next_active(blk\first_field)
    while: f != 0
        if: l2_frame_head(f\value, "catch")
            return: 1
        f: l2_next_active(f\next)
return: 0

# A root if or while body, while its steps are being built. 0: the stack is deeper than 64.
fn: l2_rw_cblk_push (const: @(LmP0Structure blk)) int
    if: blk = 0
        return: 0
    if: l2_rw_cblk_n >= 64
        return: l2_error(l2_src, 0, "loops and catch blocks nested too deeply")
    l2_rw_cblk[l2_rw_cblk_n]: (cast: (@: LmP0Structure) blk)
    l2_rw_cblk_n: l2_rw_cblk_n + 1
return: 0

fn: l2_rw_cblk_pop () int
    if: l2_rw_cblk_n > 0
        l2_rw_cblk_n: l2_rw_cblk_n - 1
        l2_rw_cblk[l2_rw_cblk_n]: 0
return: 0

# THE HANDLER OF A NAME thrown at the point being checked or emitted: the enclosing blocks from
# the innermost out -- a root if or while body being built, then the scope stack, then the method
# body -- and in each the catch of that name, unless it is the very handler the point is in (the
# same name inside its own handler goes to the enclosing context).  0: no handler in this method.
fn: l2_catch_find (int: mi; const: @(LmP0Text tname); const: @(char cname); @@: LmP0Structure out_blk; @: int out_idx) @: LmP0Node
    int: lv
    int: i
    int: idx 0
    @: LmP0Node prev 0
    @: LmP0Node cf 0
    @: LmP0Structure blk 0
    if: l2_scope_n > 0 && l2_frame_head(l2_scope_at[l2_scope_n - 1], "catch")
        prev: l2_scope_at[l2_scope_n - 1]
    i: l2_rw_cblk_n - 1
    while: i >= 0
        blk: l2_rw_cblk[i]
        cf: l2_block_catch(blk, tname, cname, @ idx)
        if: cf != 0 && cf != prev
            if: out_blk != 0
                \out_blk: blk
            if: out_idx != 0
                \out_idx: idx
            return: cf
        i: i - 1
    prev: 0
    lv: l2_scope_n - 1
    while: lv >= -1
        blk: 0
        if: lv >= 0
            blk: l2_scope_block(l2_scope_at[lv])
        if: lv < 0 && mi >= 0 && mi < l2_m_n && l2_m_body[mi] != 0 && l2_m_body[mi]\kind = c.LM_P0_NODE_STRUCTURE && l2_m_body[mi]\as != 0
            blk: l2_m_body[mi]\as\structure
        cf: l2_block_catch(blk, tname, cname, @ idx)
        if: cf != 0 && cf != prev
            if: out_blk != 0
                \out_blk: blk
            if: out_idx != 0
                \out_idx: idx
            return: cf
        prev: 0
        if: lv >= 0 && l2_frame_head(l2_scope_at[lv], "catch")
            prev: l2_scope_at[lv]
        lv: lv - 1
return: 0

# THE PADS.  A block that holds catches is emitted as one loop, its pad:
#     int: l2_atP 0            -- 0 on the straight pass, i after a delivery to catch i
#     while: 1
#         if: l2_atP <= 0      -- segment 0, before the first catch
#         if: l2_atP = 1       -- catch 1: bind its parameters, run its handler
#         if: l2_atP <= 1      -- segment 1
#         ...
#         break
# A delivery to catch i stores the payload, sets l2_atP to i and restarts the pad: the segments
# before catch i are skipped, its handler runs, and the statements after it run -- so a catch
# before the call re-enters the region, and one after it continues past (§14).  From inside
# nested loops the delivery leaves each of them first: l2_goP and a break, and after each loop
# `if: l2_goP != 0` breaks again or, at the pad, restarts it.  A user break or continue written
# directly in a pad leaves the pad the same way (l2_ubP / l2_ucP) and is done at its own loop.
fn: l2_lp_push (int: kind; int: pad) int
    if: l2_lp_n >= 64
        return: l2_error(l2_src, 0, "loops and catch blocks nested too deeply")
    l2_lpk[l2_lp_n]: kind
    l2_lpp[l2_lp_n]: pad
    l2_lp_n: l2_lp_n + 1
return: 0

fn: l2_lp_pop () int
    if: l2_lp_n > 0
        l2_lp_n: l2_lp_n - 1
return: 0

fn: l2_pad_of (const: @(LmP0Structure blk)) int
    int: i
    i: l2_pad_n - 1
    while: i >= 0
        if: l2_padb[i] = blk
            return: l2_padi[i]
        i: i - 1
return: -1

# A throw of `name` arrives here with `payload`: if a handler in this method takes it, deliver
# (1); if none does, write nothing (0) and the caller propagates it.  -1: an error.
fn: l2_emit_deliver (int: mi; const: @(LmP0Text tname); const: @(char cname); const: @(char payload); const: @(char ind)) int
    @: LmP0Structure blk 0
    int: idx 0
    int: p
    if: l2_catch_find(mi, tname, cname, @ blk, @ idx) = 0
        return: 0
    p: l2_pad_of(blk)
    if: p < 0 || idx < 1
        l2_error(l2_src, 0, "internal: a catch without its pad")
        return: -1
    if: c.fprintf(l2_out, "%sl2_pl%d: %s\n%sl2_at%d: %d\n", ind, p, payload, ind, p, idx) < 0
        return: -1
    if: l2_lp_n > 0 && l2_lpk[l2_lp_n - 1] = 1 && l2_lpp[l2_lp_n - 1] = p
        if: c.fprintf(l2_out, "%scontinue\n", ind) < 0
            return: -1
        return: 1
    if: c.fprintf(l2_out, "%sl2_go%d: 1\n%sbreak\n", ind, p, ind) < 0
        return: -1
return: 1

# After a loop's end (it is off the stack already): a delivery that left it restarts its pad if
# the pad is the loop around, or leaves the next loop too; a user break or continue that left the
# pad `closed` (>= 0) is done by the loop around it, or leaves the next pad too.
fn: l2_emit_loop_exit (int: closed; const: @(char ind)) int
    int: i 0
    int: topk -1
    int: top -1
    if: l2_lp_n > 0
        topk: l2_lpk[l2_lp_n - 1]
        top: l2_lpp[l2_lp_n - 1]
    ---
    while: i < l2_lp_n
        if: l2_lpk[i] = 1 && topk = 1 && l2_lpp[i] = top && c.fprintf(l2_out, "%sif: l2_go%d != 0\n%s    l2_go%d: 0\n%s    continue\n", ind, top, ind, top, ind) < 0
            return: 1
        if: l2_lpk[i] = 1 && (topk != 1 || l2_lpp[i] != top) && c.fprintf(l2_out, "%sif: l2_go%d != 0\n%s    break\n", ind, l2_lpp[i], ind) < 0
            return: 1
        i: i + 1
    if: closed >= 0 && topk = 0 && c.fprintf(l2_out, "%sif: l2_ub%d != 0\n%s    l2_ub%d: 0\n%s    break\n%sif: l2_uc%d != 0\n%s    l2_uc%d: 0\n%s    continue\n", ind, closed, ind, closed, ind, ind, closed, ind, closed, ind) < 0
        return: 1
    if: closed >= 0 && topk = 1 && c.fprintf(l2_out, "%sif: l2_ub%d != 0\n%s    l2_ub%d: 0\n%s    l2_ub%d: 1\n%s    break\n%sif: l2_uc%d != 0\n%s    l2_uc%d: 0\n%s    l2_uc%d: 1\n%s    break\n", ind, closed, ind, closed, ind, top, ind, ind, closed, ind, closed, ind, top, ind) < 0
        return: 1
return: 0

# The parameters of a catch are written by its delivery before the handler reads them: to the
# use scan they are bound, never an input the activation reads from outside.
fn: l2_scan_catch_bound (const: @(LmP0Node cf); int: mi; @: int seen) int
    @: LmP0Field p
    @: LmP0Structure ps
    @: LmP0Text fa 0
    int: ty 0
    int: oi
    ps: l2_catch_params(cf)
    if: ps = 0 || seen = 0
        return: 0
    p: l2_next_active(ps\first_field)
    while: p != 0
        fa: 0
        if: l2_typed_formal(p\value, l2_src, @ fa, @ ty) != 0
            return: 1
        oi: l2_own_find_decl(mi, fa, p\value)
        if: oi >= 0
            seen[oi]: 1
        p: l2_next_active(p\next)
return: 0

# A catch parameter binds argument k of the payload by ordinary assignment (Q12, §7): a
# primitive after its domain check, a Structure after the runtime implements of its declared
# type.  The own storage type of a parameter type (-1: not a parameter type).
fn: l2_catch_param_own (int: ty) int
    if: ty = 0 || ty = 2 || ty = 34 || ty = 36
        return: l2_own_ty_of_param(ty)
    if: ty = l2_colon_graph_ty()
        return: l2_own_of_dt(ty)
return: -1

# `catch: Name (params)` and its handler: the name, no second catch of it in this block, the
# parameters (an implicit name has none, X2), and the handler body under the catch's scope.
fn: l2_check_catch (const: @(LmP0Node cf); const: @(LmP0Structure blk); const: @(char path); int: mi; int: depth) int
    @: LmP0Field f
    @: LmP0Field p
    @: LmP0Text nm
    @: LmP0Text fa 0
    @: LmP0Structure ps
    @: LmP0Structure hb
    int: n
    int: ty 0
    int: gi
    c.array: [160]: char msg
    n: 0
    if: cf\as\frame\body != 0
        n: l2_count_active(cf\as\frame\body)
    nm: l2_catch_name(cf)
    ps: l2_catch_params(cf)
    hb: l2_catch_body(cf)
    if: cf\as\frame\trailer != 0 || n < 2 || n > 3 || nm = 0 || l2_ident(nm) = 0 || ps = 0 || (n = 3 && hb = 0)
        return: l2_error(path, cf, "catch: takes a name, its parameters and a handler body")
    f: l2_next_active(blk\first_field)
    while: f != 0 && f\value != cf
        if: l2_frame_head(f\value, "catch") && l2_text_same(l2_catch_name(f\value), nm) != 0
            if: c.sprintf(msg, "duplicate catch: %.*s", (cast: (int) nm\length), nm\data) < 0
                return: 1
            return: l2_error(path, cf, msg)
        f: l2_next_active(f\next)
    gi: 1
    while: l2_implicit_name(gi) != 0
        if: l2_text_eq(nm, l2_implicit_name(gi)) != 0 && l2_count_active(ps) != 0
            return: l2_error(path, cf, "an implicit throw carries no payload")
        gi: gi + 1
    p: l2_next_active(ps\first_field)
    while: p != 0
        fa: 0
        if: l2_typed_formal(p\value, path, @ fa, @ ty) != 0
            return: 1
        if: l2_catch_param_own(ty) < 0
            return: l2_error(path, p\value, "unsupported catch parameter type")
        if: ty = l2_colon_graph_ty() && (p\value\kind != c.LM_P0_NODE_FRAME || l2_ns_find(p\value\as\frame\head) < 0)
            return: l2_error(path, p\value, "unsupported catch parameter type")
        # The handler reads its parameter by name; a visible formal, method, own or unit field of
        # the same name would be found first.
        if: l2_formal_find(mi, fa) >= 0 || l2_find_method(fa) >= 0 || l2_own_find(mi, fa) >= 0
            return: l2_error(path, p\value, "a catch parameter hides a visible name")
        l2_need_admit: 1
        if: ty = l2_colon_graph_ty() && l2_admit_site(mi) != 0
            return: l2_error(path, p\value, "internal: admission outside a method")
        p: l2_next_active(p\next)
    if: hb = 0
        return: 0
    if: l2_scope_push(cf) != 0
        return: l2_alloc_or(path, cf, "out of memory")
    if: l2_check_body(hb, mi, path, depth + 1) != 0
        l2_scope_pop()
        return: 1
    l2_scope_pop()
return: 0

# The parameters of a catch are own fields hosted by the catch (declared under its scope, like a
# for's variable): bound on delivery, read in the handler, published like any own field.
fn: l2_collect_catch (const: @(LmP0Node cf); int: mi; const: @(char path); int: depth; @: int sn) int
    @: LmP0Field p
    @: LmP0Text fa 0
    @: LmP0Structure ps
    @: LmP0Structure hb
    int: ty 0
    int: own
    int: j
    ps: l2_catch_params(cf)
    hb: l2_catch_body(cf)
    if: l2_for_add(cf, mi, l2_for_find(l2_scope_host())) < 0 || l2_scope_push(cf) != 0
        return: l2_alloc_or(path, cf, "out of memory")
    p: 0
    if: ps != 0
        p: l2_next_active(ps\first_field)
    while: p != 0
        fa: 0
        if: l2_typed_formal(p\value, path, @ fa, @ ty) != 0
            l2_scope_pop()
            return: 1
        own: l2_catch_param_own(ty)
        if: own < 0
            l2_scope_pop()
            return: l2_error(path, p\value, "unsupported catch parameter type")
        j: l2_own_add(mi, fa, own, path, p\value)
        if: j < 0
            l2_scope_pop()
            return: 1
        if: l2_own_off(mi, j) = (cast: (size_t) -1)
            l2_scope_pop()
            return: l2_error(path, p\value, "size overflow")
        if: l2_m_uses[l2_own_off(mi, j)] = 0
            l2_m_own[mi]: l2_m_own[mi] + 1
        l2_m_uses[l2_own_off(mi, j)]: 1
        if: ty = l2_colon_graph_ty() && l2_own_nsty_set(j, l2_ns_find(p\value\as\frame\head)) != 0
            l2_scope_pop()
            return: 1
        p: l2_next_active(p\next)
    if: hb != 0 && l2_collect_decls(hb, mi, path, depth + 1, sn) != 0
        l2_scope_pop()
        return: 1
    l2_scope_pop()
return: 0

# Catch i of pad p: `if: l2_atP = i`, then the parameters bound from the payload and the handler
# body, under the catch's scope.  A payload shorter than the parameters, or a field that is not
# of the parameter's type, is a refused admission: the implicit throw `implements`, raised here.
fn: l2_emit_handler (const: @(LmP0Node cf); int: p; int: i; int: mi; const: @(char d1); const: @(char d2)) int
    @: LmP0Field f
    @: LmP0Text fa 0
    @: LmP0Structure ps
    @: LmP0Structure hb
    int: np 0
    int: k 0
    int: ty 0
    int: oi
    const: @(char vfn) 0
    const: @(char tcode) 0
    c.array: [96]: char val
    ps: l2_catch_params(cf)
    hb: l2_catch_body(cf)
    if: ps != 0
        np: l2_count_active(ps)
    if: np = 0 && hb = 0
        return: 0
    if: c.fprintf(l2_out, "%sif: l2_at%d = %d\n", d1, p, i) < 0
        return: 1
    if: l2_scope_push(cf) != 0
        return: 1
    if: np > 0 && c.fprintf(l2_out, "%sif: l2_pl%d = 0 || l2_pl%d\\len < %d\n", d2, p, p, np) < 0
        return: 1
    if: np > 0 && l2_emit_implicit_throw(mi, "implements", d2) != 0
        return: 1
    f: 0
    if: ps != 0
        f: l2_next_active(ps\first_field)
    while: f != 0
        fa: 0
        if: l2_typed_formal(f\value, l2_src, @ fa, @ ty) != 0
            return: 1
        oi: l2_own_find_decl(mi, fa, f\value)
        if: oi < 0
            return: l2_error(l2_src, f\value, "internal: a catch parameter has no own field")
        if: c.fprintf(l2_out, "%sl2_pv%d: lmx_arena_ref_value(l2_pl%d, %dU)\n", d2, p, p, k) < 0
            return: 1
        vfn: 0
        if: ty = 0
            vfn: "lmx_int_value_known"
            tcode: "c.LMX_TYPE_INT"
        if: ty = 2
            vfn: "lmx_size_value_known"
            tcode: "c.LMX_TYPE_SIZE_T"
        if: ty = 34
            vfn: "lmx_unsigned_value_known"
            tcode: "c.LMX_TYPE_UNSIGNED"
        if: ty = 36
            vfn: "lmx_ulong_value_known"
            tcode: "c.LMX_TYPE_ULONG"
        if: vfn != 0
            if: c.fprintf(l2_out, "%sif: l2_pv%d = 0 || lmx_domain_type(l2_program_arena, l2_pv%d) != %s\n", d2, p, p, tcode) < 0
                return: 1
            if: l2_emit_implicit_throw(mi, "implements", d2) != 0
                return: 1
            if: c.sprintf(val, "%s(l2_pv%d)", vfn, p) < 0 || l2_own_store(mi, oi, d2, val) != 0
                return: 1
            ---
        if: vfn = 0
            if: c.sprintf(val, "(cast: (@: Lmx) l2_pv%d)", p) < 0
                return: 1
            if: l2_emit_admit(mi, l2_own_nsty_get(oi), val, d2) != 0 || l2_own_store(mi, oi, d2, val) != 0
                return: 1
            ---
        f: l2_next_active(f\next)
        k: k + 1
    if: hb != 0 && l2_emit_body(hb, mi, d2) != 0
        l2_scope_pop()
        return: 1
    l2_scope_pop()
    if: c.fprintf(l2_out, "%s---\n", d2) < 0
        return: 1
return: 0

# A block that holds catches, lowered to its pad (see THE PADS).
fn: l2_emit_pad (const: @(LmP0Structure body); int: mi; const: @(char ind)) int
    @: LmP0Field f
    @: LmP0Field seg
    @: char d1 0
    @: char d2 0
    int: p
    int: j 0
    int: parent 0
    int: q 0
    # A user break or continue can be written directly in this pad only if a user loop encloses
    # it; only then does the pad carry the flags that take one out.
    while: q < l2_lp_n
        if: l2_lpk[q] = 0
            parent: 1
        q: q + 1
    if: l2_bump_ind(ind, @ d1) != 0 || l2_bump_ind(d1, @ d2) != 0
        return: 1
    if: l2_pad_n >= 64
        return: l2_error(l2_src, 0, "catch blocks nested too deeply")
    p: l2_pad_seq
    l2_pad_seq: l2_pad_seq + 1
    if: c.fprintf(l2_out, "%sint: l2_at%d 0\n%sint: l2_go%d 0\n%s@: Lmx l2_pl%d 0\n%s@: void l2_pv%d 0\n", ind, p, ind, p, ind, p, ind, p) < 0
        return: 1
    if: parent > 0 && c.fprintf(l2_out, "%sint: l2_ub%d 0\n%sint: l2_uc%d 0\n", ind, p, ind, p) < 0
        return: 1
    if: c.fprintf(l2_out, "%swhile: 1\n", ind) < 0
        return: 1
    l2_padb[l2_pad_n]: (cast: (@: LmP0Structure) body)
    l2_padi[l2_pad_n]: p
    l2_pad_n: l2_pad_n + 1
    if: l2_lp_push(1, p) != 0
        return: 1
    if: l2_emit_poll(mi, d1) != 0
        return: 1
    seg: l2_next_active(body\first_field)
    f: seg
    while: f != 0
        if: l2_frame_head(f\value, "catch")
            if: seg != f && c.fprintf(l2_out, "%sif: l2_at%d <= %d\n", d1, p, j) < 0
                return: 1
            if: seg != f && l2_emit_stmts(body, seg, f, mi, d2) != 0
                return: 1
            if: seg != f && c.fprintf(l2_out, "%s---\n", d2) < 0
                return: 1
            j: j + 1
            if: l2_emit_handler(f\value, p, j, mi, d1, d2) != 0
                return: 1
            seg: l2_next_active(f\next)
            f: seg
            continue
        f: l2_next_active(f\next)
    if: seg != 0 && c.fprintf(l2_out, "%sif: l2_at%d <= %d\n", d1, p, j) < 0
        return: 1
    if: seg != 0 && l2_emit_stmts(body, seg, 0, mi, d2) != 0
        return: 1
    if: seg != 0 && c.fprintf(l2_out, "%s---\n", d2) < 0
        return: 1
    if: c.fprintf(l2_out, "%sbreak\n%send: while\n", d1, ind) < 0
        return: 1
    l2_lp_pop()
    l2_pad_n: l2_pad_n - 1
    if: parent > 0
        return: l2_emit_loop_exit(p, ind)
return: l2_emit_loop_exit(0 - 1, ind)

# Leaving a body drops marks of fields declared in that body only (D-79). A formal's
# binding is one cell of the method: a bare write inside the body does not end at the
# body's edge. A declaration in the body (`int: n` in the if) does.
fn: l2_emit_body (const: @(LmP0Structure body); int: mi; const: @(char ind)) int
    int: s0 l2_bseq_n
    int: k 0
    if: l2_emit_body_in(body, mi, ind) != 0
        return: 1
    while: k < l2_own_n
        if: l2_own_bseq[k] > s0 && l2_host_is_body(l2_own_host[k], body) != 0
            l2_own_bseq[k]: 0
        k: k + 1
    ---
return: 0

# host is the node pushed for this body: a structure node, or an else frame.
fn: l2_host_is_body (const: @(LmP0Node host); const: @(LmP0Structure body)) int
    if: host = 0 || body = 0 || host\as = 0
        return: 0
    if: host\kind = c.LM_P0_NODE_STRUCTURE && host\as\structure = body
        return: 1
    if: host\kind = c.LM_P0_NODE_FRAME && host\as\frame != 0 && host\as\frame\body = body
        return: 1
return: 0

# A block with catches is its pad; any other block is its statements.
fn: l2_emit_body_in (const: @(LmP0Structure body); int: mi; const: @(char ind)) int
    if: body = 0
        return: 0
    if: l2_block_has_catch(body) != 0
        return: l2_emit_pad(body, mi, ind)
return: l2_emit_stmts(body, l2_next_active(body\first_field), 0, mi, ind)

# THE STATIC RULE (§14, author Q13): every name a callee declares is caught in the caller's
# enclosing blocks (S1.3) or listed in the caller's own `throws:`, else the call is refused.  E
# lists none, so a declared name that would reach E is refused there.
fn: l2_check_throws_handled (int: mi; int: callee; const: @(char path); const: @(LmP0Node at)) int
    int: k 1
    int: d
    @: LmP0Text nm
    c.array: [160]: char msg
    d: l2_throws_declared(callee)
    while: k <= d
        nm: l2_throws_name(callee, k)
        if: nm != 0 && l2_throws_pos(mi, nm) = 0 && l2_catch_find(mi, nm, 0, 0, 0) = 0
            if: mi = l2_e && c.sprintf(msg, "unhandled throw in entry: %.*s", (cast: (int) nm\length), nm\data) < 0
                return: 1
            if: mi != l2_e && c.sprintf(msg, "unhandled throw: %.*s", (cast: (int) nm\length), nm\data) < 0
                return: 1
            return: l2_error(path, at, msg)
        k: k + 1
return: 0

# The payload cell of one throw argument: an own storage type -- 0 int, 2 size_t, 3 unsigned,
# 36 ulong -- whose fresh cell holds the value as an own field of that type holds it, or the
# `@: Lmx` pointer type (>= 1000) of a Structure, whose reference is the child itself.  -1:
# nothing a payload carries yet -- a char (a method has no char table to intern it in), a text,
# a value of several fields.
fn: l2_throw_arg_ty (@: LmP0Field a0; int: span; int: mi) int
    int: ty 0
    int: own
    const: @: LmP0Text at
    if: a0 = 0 || span != 1 || a0\value = 0
        return: -1
    if: l2_colon_simple_ty(a0\value, mi, @ ty) != 0
        return: -1
    if: ty = -10
        if: a0\value\kind != c.LM_P0_NODE_ATOM || a0\value\as = 0 || a0\value\as\atom = 0
            return: -1
        at: a0\value\as\atom
        if: at\length = 0U || at\data[0] = 39
            return: -1
        if: at\length >= 2U && (at\data[at\length - 1U] = 76 || at\data[at\length - 1U] = 108) && (at\data[at\length - 2U] = 85 || at\data[at\length - 2U] = 117)
            return: 36
        if: at\data[at\length - 1U] = 85 || at\data[at\length - 1U] = 117
            return: 2
        return: 0
    if: ty < 0
        return: -1
    # A declared graph formal carries the graph type itself (l2_colon_is_graph_ty).
    if: ty = l2_colon_graph_ty()
        return: l2_own_of_dt(ty)
    own: l2_own_ty_of_param(ty)
    if: own = 0 || own = 2 || own = 3 || own = 36
        return: own
    if: own >= 1000 && l2_dt_of_own(own) = l2_colon_graph_ty()
        return: own
return: -1

# `throw: Name(args)` / `throw: Name`: Name is declared in this method's `throws:` (§14), and
# each argument is one value a payload can carry (l2_throw_arg_ty), checked like a call's.
fn: l2_check_throw (const: @(LmP0Node stmt); int: mi; const: @(char path)) int
    @: LmP0Node what
    @: LmP0Field a0
    @: LmP0Text name 0
    int: span
    int: pmi
    const: @: LmP0Frame fr
    fr: stmt\as\frame
    if: fr\trailer != 0 || fr\body = 0 || fr\body\trailer != 0 || l2_count_active(fr\body) != 1
        return: l2_error(path, stmt, "throw: takes one name and its payload")
    what: l2_next_active(fr\body\first_field)\value
    if: what != 0 && what\kind = c.LM_P0_NODE_ATOM && what\as != 0
        name: what\as\atom
    if: what != 0 && what\kind = c.LM_P0_NODE_FRAME && what\as != 0 && what\as\frame != 0
        name: what\as\frame\head
    if: name = 0 || l2_ident(name) = 0
        return: l2_error(path, stmt, "throw: takes one name and its payload")
    if: l2_throws_pos(mi, name) = 0
        return: l2_error(path, stmt, "throw of an undeclared name")
    if: what\kind != c.LM_P0_NODE_FRAME
        return: 0
    if: what\as\frame\trailer != 0 || what\as\frame\body = 0 || what\as\frame\body\trailer != 0
        return: l2_error(path, stmt, "unsupported trailer")
    a0: l2_next_active(what\as\frame\body\first_field)
    while: a0 != 0
        span: l2_expr_span(a0)
        if: span < 1 || l2_check_fields(a0, span, mi, path, stmt) != 0
            return: 1
        if: l2_throw_arg_ty(a0, span, mi) < 0
            return: l2_error(path, stmt, "unsupported throw payload value")
        pmi: 0
        while: pmi < span && a0 != 0
            a0: l2_next_active(a0\next)
            pmi: pmi + 1
        ---
    ---
return: 0

# A `throw:` references its payload arguments; its name is an exit, not a value.
fn: l2_scan_throw_args (const: @(LmP0Node stmt); int: mi; @: int seen) int
    @: LmP0Field w
    if: stmt = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    w: l2_next_active(stmt\as\frame\body\first_field)
    if: w = 0 || w\value = 0 || w\value\kind != c.LM_P0_NODE_FRAME || w\value\as = 0 || w\value\as\frame = 0 || w\value\as\frame\body = 0
        return: 0
return: l2_scan_fields(w\value\as\frame\body\first_field, l2_count_active(w\value\as\frame\body), mi, seen)

# THE THROW (S1.2).  The arguments are evaluated in order into a fresh payload Structure in
# l2_program_arena: child k is argument k -- a fresh cell of its type holding the value, or the
# Structure reference itself (no copy, no reparenting).  A payload that cannot be allocated
# leaves as no payload, 0; a catch parameter's binding refuses it (S1.3).  Then what the
# activation wrote is published (§13) and the throw leaves: `l2_out_throw[0]: payload; return:
# pos(Name)`.
fn: l2_emit_throw (const: @(LmP0Node stmt); int: mi; const: @(char ind)) int
    @: LmP0Node what
    @: LmP0Field a0 0
    @: LmP0Text name
    int: n 0
    int: k 0
    int: span
    int: pmi
    int: ty
    int: t
    int: pos
    const: @(char newf) 0
    what: l2_next_active(stmt\as\frame\body\first_field)\value
    if: what\kind = c.LM_P0_NODE_ATOM
        name: what\as\atom
    else:
        name: what\as\frame\head
        if: what\as\frame\body != 0
            a0: l2_next_active(what\as\frame\body\first_field)
        ---
    ---
    if: a0 != 0
        n: l2_actual_count(a0)
    pos: l2_throws_pos(mi, name)
    if: pos <= 0
        return: l2_error(l2_src, stmt, "internal: a throw was not checked")
    t: l2_tn
    l2_tn: l2_tn + 1
    if: n > 0 && c.fprintf(l2_out, "%s@: Lmx l2_tp%d 0\n%s@: void l2_tc%d 0\n%sl2_tp%d: lmx_node_new_owned(l2_program_arena)\n%sif: l2_tp%d != 0 && lmx_arena_refs_open_owned(l2_program_arena, l2_tp%d, %dU) != 0\n%s    l2_tp%d: 0\n", ind, t, ind, t, ind, t, ind, t, t, n, ind, t) < 0
        return: 1
    while: a0 != 0 && k < n
        span: l2_expr_span(a0)
        ty: l2_throw_arg_ty(a0, span, mi)
        if: ty < 0
            return: l2_error(l2_src, stmt, "internal: a throw payload value was not checked")
        if: l2_eval_fields(a0, span, mi, ind, l2_tok) != 0
            return: 1
        newf: 0
        if: ty = 0
            newf: "lmx_int_new_owned"
        if: ty = 2
            newf: "lmx_size_new_owned"
        if: ty = 3
            newf: "lmx_unsigned_new_owned"
        if: ty = 36
            newf: "lmx_ulong_new_owned"
        if: newf != 0 && c.fprintf(l2_out, "%sif: l2_tp%d != 0\n%s    l2_tc%d: %s(l2_program_arena)\n%sif: l2_tp%d != 0 && l2_tc%d = 0\n%s    l2_tp%d: 0\n%sif: l2_tp%d != 0 && (%s(l2_tc%d, %s) != 0 || lmx_arena_ref_store(l2_tp%d, %dU, l2_tc%d) != 0)\n", ind, t, ind, t, newf, ind, t, t, ind, t, ind, t, l2_own_store_helper(ty), t, l2_tok, t, k, t) < 0
            return: 1
        if: newf = 0 && c.fprintf(l2_out, "%sif: l2_tp%d != 0 && lmx_arena_ref_store(l2_tp%d, %dU, (cast: (@: void) %s)) != 0\n", ind, t, t, k, l2_tok) < 0
            return: 1
        if: l2_emit_invariant(ind, "a throw payload refused its field") != 0
            return: 1
        pmi: 0
        while: pmi < span && a0 != 0
            a0: l2_next_active(a0\next)
            pmi: pmi + 1
        k: k + 1
    ---
    if: n > 0 && c.fprintf(l2_out, "%sl2_out_throw[0]: l2_tp%d\n%sreturn: %d\n", ind, t, ind, pos) < 0
        return: 1
    if: n = 0 && c.fprintf(l2_out, "%sl2_out_throw[0]: 0\n%sreturn: %d\n", ind, ind, pos) < 0
        return: 1
return: 0

# The status method mi returns for the implicit name `name`: d + g.  0: not an implicit name.
fn: l2_implicit_status (int: mi; const: @(char name)) int
    int: g 1
    if: name = 0
        return: 0
    while: l2_implicit_name(g) != 0
        if: c.strcmp(l2_implicit_name(g), name) = 0
            return: l2_throws_declared(mi) + g
        g: g + 1
return: 0

# AN IMPLICIT THROW LEAVES THE METHOD.  The caller has written the `if:` line at `ind`; this is
# its body.  What the activation wrote is already in its cells (-189 c3b), and the throw leaves
# with its status and no payload: merge has none (X2), and
# neither has implements while no catch parameter asks for one.
fn: l2_emit_implicit_throw (int: mi; const: @(char name); const: @(char ind)) int
    @: char deep 0
    int: st
    int: dv
    st: l2_implicit_status(mi, name)
    if: st <= 0
        return: l2_error(l2_src, 0, "internal: not an implicit throw name")
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    # A handler in this method takes it (S1.3: a catch of the operator's name); else it leaves.
    dv: l2_emit_deliver(mi, 0, name, "0", deep)
    if: dv < 0
        return: 1
    if: dv > 0
        return: 0
    if: c.fprintf(l2_out, "%sl2_out_throw[0]: 0\n%sreturn: %d\n", deep, deep, st) < 0
        return: 1
return: 0

# A THROW THAT PASSES THROUGH A CALL.  The callee's status k is in the callee's numbering and the
# caller re-encodes it into its own.  1..d_callee are declared names: k becomes the caller's
# position of the same NAME, which the static rule (l2_check_throws_handled) proved exists.  Above
# d_callee, k is implicit name g = k - d_callee, which the caller returns as d_caller + g.
fn: l2_emit_propagate (int: mi; int: callee; int: t; const: @(char ind)) int
    int: shift
    int: k 1
    int: g 1
    int: pos
    int: dv
    @: char d2 0
    @: char d3 0
    c.array: [32]: char pl
    if: mi < 0 || callee < 0 || ind = 0
        return: 1
    if: l2_bump_ind(ind, @ d2) != 0 || l2_bump_ind(d2, @ d3) != 0 || c.sprintf(pl, "l2_te%d", t) < 0
        return: 1
    shift: l2_throws_declared(mi) - l2_throws_declared(callee)
    if: c.fprintf(l2_out, "%sif: l2_ts%d != 0\n%s    l2_out_throw[0]: l2_te%d\n", ind, t, ind, t) < 0
        return: 1
    # A handler in this method takes a name first (S1.3); else a declared name leaves by its
    # position in this method's list.
    while: k <= l2_throws_declared(callee)
        if: c.fprintf(l2_out, "%sif: l2_ts%d = %d\n", d2, t, k) < 0
            return: 1
        dv: l2_emit_deliver(mi, l2_throws_name(callee, k), 0, pl, d3)
        if: dv < 0
            return: 1
        pos: l2_throws_pos(mi, l2_throws_name(callee, k))
        if: dv = 0 && pos <= 0
            return: l2_error(l2_src, 0, "internal: a callee's declared throw is not handled by its caller")
        if: dv = 0 && c.fprintf(l2_out, "%sreturn: %d\n", d3, pos) < 0
            return: 1
        k: k + 1
    while: l2_implicit_name(g) != 0
        if: l2_catch_find(mi, 0, l2_implicit_name(g), 0, 0) != 0
            if: c.fprintf(l2_out, "%sif: l2_ts%d = %d\n", d2, t, l2_throws_declared(callee) + g) < 0
                return: 1
            if: l2_emit_deliver(mi, 0, l2_implicit_name(g), pl, d3) < 0
                return: 1
            ---
        g: g + 1
    if: shift = 0 && c.fprintf(l2_out, "%s    return: l2_ts%d\n", ind, t) < 0
        return: 1
    if: shift > 0 && c.fprintf(l2_out, "%s    return: l2_ts%d + %d\n", ind, t, shift) < 0
        return: 1
    if: shift < 0 && c.fprintf(l2_out, "%s    return: l2_ts%d - %d\n", ind, t, 0 - shift) < 0
        return: 1
return: 0

# THE DIAGNOSTIC ROUTE (X1).  A check the generated program makes of the translator's or the
# kernel's own promise -- the shape merge produced, a cell the unit was built with -- is an
# invariant, not a throw: it is on no status, so no catch can take it and no caller reads it as a
# name.  It says what broke on stderr and aborts: the kernel has no delivery to a diagnostic root
# that could stop just this Message (lmx_msg_poll_abort reports only a letter that already
# succeeded), and going on would bind the wrong shape or read through the missing cell.  The
# `if:` line is the caller's, at `ind`; `what` is the diagnostic's text.
fn: l2_emit_invariant (const: @(char ind); const: @(char what)) int
    if: ind = 0 || what = 0
        return: 1
    if: c.fprintf(l2_out, "%s    c.fprintf(c.stderr, \"lmx: invariant: %s\\n\")\n%s    c.abort()\n", ind, what, ind) < 0
        return: 1
return: 0

# D-57 (-178 commit 3): a letter is admitted by its PAYLOAD.  Since -173 a letter is (sender;
# payload), and the user's model describes the payload (the mail design), so admitting the whole
# letter refused every host letter.  Is `node` the name of a letter -- an own field of method mi
# declared by `receiveMessage: name`?
fn: l2_is_letter_name (int: mi; const: @(LmP0Node node)) int
    @: LmP0Text name 0
    int: oi
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM || node\as = 0 || node\as\atom = 0
        return: 0
    oi: l2_own_find_last(mi, node\as\atom)
    if: oi < 0 || l2_own_decl[oi] = 0
        return: 0
return: (cast: (int) (l2_receive_msg_shape(l2_own_decl[oi], @ name, 0) = 0))

# The value expression `val` (a 256-byte buffer) rewritten into its letter's payload, slot 1 --
# lmx_arena_ref_value answers 0 for a null letter, so a null stays null and passes unadmitted.
fn: l2_payload_expr (@: char val) int
    c.array: [320]: char tmp
    if: c.snprintf(tmp, 320U, "(cast: (@: Lmx) lmx_arena_ref_value((cast: (@: Lmx) %s), 1U))", val) >= 256
        return: l2_error(l2_src, 0, "a letter's value expression too long")
    strcpy(val, tmp)
return: 0

# varA = the candidate, varB = the declared type's shape, consumer = that same
# shape: every declared field counts as used -- stricter than a uses tree, never
# looser.  0 is no graph and is not admitted.  NO or UNKNOWN throws the implicit
# name `implements` (Q17 = A): no silent binding.
fn: l2_emit_admit (int: mi; int: ni; const: @(char value); const: @(char ind)) int
    c.array: [128]: char inst
    if: mi < 0 || l2_m_throws = 0 || l2_m_throws[mi] = 0
        return: l2_error(l2_src, 0, "internal: an admission site was not checked")
    if: l2_type_inst(ni, inst) != 0
        return: l2_error(l2_src, 0, "internal: admission to a type with no shape")
    if: c.fprintf(l2_out, "%sif: %s != 0 && lmx_runtime_implements(l2_program_arena, (cast: (@: Lmx) %s), %s, %s) != c.LMX_IMPLEMENTS_YES\n", ind, value, value, inst, inst) < 0
        return: 1
return: l2_emit_implicit_throw(mi, "implements", ind)

# `T: []: []: x` (author, Q15, 2026-09-23): `[]:` applied twice makes two levels
# of independent one-dimensional Arrays -- the outer one holds references to
# the descriptors of the inner T Arrays, each with its own length.  It is not
# `T: [][]: x`, the one rectangular Array.  T is int or char, as for `[]:`.
# 0 = the shape (T in out_ty: 0 int, 1 char), 1 = not it.
fn: l2_ns_arrarr_field (const: @(LmP0Node fld); @: int out_ty; @@: LmP0Text out_name) int
    @: LmP0Field g
    @: LmP0Node outer
    @: LmP0Node inner
    if: fld = 0 || fld\kind != c.LM_P0_NODE_FRAME || fld\as = 0 || fld\as\frame = 0 || fld\as\frame\body = 0 || out_ty = 0 || out_name = 0
        return: 1
    if: l2_frame_head(fld, "int")
        \out_ty: 0
    else:
        if: l2_frame_head(fld, "char") = 0
            return: 1
        \out_ty: 1
    ---
    if: fld\as\frame\trailer != 0 || l2_count_active(fld\as\frame\body) != 1
        return: 1
    outer: l2_next_active(fld\as\frame\body\first_field)\value
    if: outer = 0 || outer\kind != c.LM_P0_NODE_FRAME || l2_frame_head(outer, "[]") = 0 || outer\as\frame\trailer != 0 || outer\as\frame\body = 0 || l2_count_active(outer\as\frame\body) != 1
        return: 1
    inner: l2_next_active(outer\as\frame\body\first_field)\value
    if: inner = 0 || inner\kind != c.LM_P0_NODE_FRAME || l2_frame_head(inner, "[]") = 0 || inner\as\frame\trailer != 0 || inner\as\frame\body = 0 || l2_count_active(inner\as\frame\body) != 1
        return: 1
    g: l2_next_active(inner\as\frame\body\first_field)
    if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
        return: 1
    \out_name: (cast: (@: LmP0Text) g\value\as\atom)
return: 0

# One Structure body: registers the entry FIRST so its index precedes every
# nested entry, then reads the fields in source order. Fields are size_t and
# char literals, inline nested Structures built in place with this entry as
# their node, and references to an EARLIER named Structure shared by pointer.
fn: l2_take_ns_body (const: @(LmP0Text name); int: parent; const: @(LmP0Structure body); const: @(LmP0Node at); const: @(char path)) int
    @: LmP0Field f
    int: aty 0
    size_t: acount 0U
    @: LmP0Text fname 0
    @: LmP0Field g
    @: LmP0Field h
    @: LmP0Node fld
    int: me
    int: sub_ix
    int: ref_ix
    int: count 0
    int: cval
    int: rdepth
    int: rty
    if: body = 0
        return: l2_error(path, at, "a named Structure needs at least one field")
    me: l2_ns_push(name, parent, at)
    if: me < 0
        return: l2_error(path, at, "out of memory")
    l2_ns_first[me]: l2_nsf_n
    f: l2_next_active(body\first_field)
    if: f = 0
        return: l2_error(path, at, "a named Structure needs at least one field")
    while: f != 0
        fld: f\value
        if: fld = 0 || fld\kind != c.LM_P0_NODE_FRAME || fld\as = 0 || fld\as\frame = 0 || fld\as\frame\body = 0
            return: l2_error(path, at, "unsupported named Structure field")
        g: l2_next_active(fld\as\frame\body\first_field)
        # Kind 6: an Array of references to T Arrays.  The spelling has no count,
        # so construction makes the outer Array empty; its slot holds the outer
        # descriptor's reference, as a kind-5 slot does.
        if: l2_ns_arrarr_field(fld, @ aty, @ fname) = 0
            if: l2_nsf_push(6, 0U, aty, me) < 0
                return: l2_error(path, at, "out of memory")
            l2_nsf_fname[l2_nsf_n - 1]: fname
            count: count + 1
            f: l2_next_active(f\next)
            continue
        if: l2_frame_head(fld, "[]")
            # []: <int|char> <name> <count>, the same spelling an own array
            # uses. The record and its backing are two owned ranges; both
            # belong to the Structure that declares them.
            if: l2_count_active(fld\as\frame\body) != 3
                return: l2_error(path, at, "an array field needs a type, a name and a count")
            aty: 0 - 1
            if: l2_text_eq(g\value\as\atom, "int")
                aty: 0
            if: l2_text_eq(g\value\as\atom, "char")
                aty: 1
            if: aty < 0
                return: l2_error(path, at, "an array field element is int or char")
            g: l2_next_active(g\next)
            if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
                return: l2_error(path, at, "an array field needs a name")
            fname: (cast: (@: LmP0Text) g\value\as\atom)
            g: l2_next_active(g\next)
            if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_array_count_is(g\value\as\atom) = 0
                return: l2_error(path, at, "an array field needs a count")
            acount: l2_literal_value(g\value\as\atom)
            if: l2_nsf_push(5, acount, aty, me) < 0
                return: l2_error(path, at, "out of memory")
            l2_nsf_fname[l2_nsf_n - 1]: fname
            l2_ns_has_array: 1
        else:
            if: l2_frame_head(fld, "size_t")
                if: l2_count_active(fld\as\frame\body) != 2 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
                    return: l2_error(path, at, "a named Structure field needs a name")
                fname: (cast: (@: LmP0Text) g\value\as\atom)
                g: l2_next_active(g\next)
                if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_num(g\value\as\atom) = 0
                    return: l2_error(path, at, "a named Structure field needs a literal")
                if: l2_nsf_push(0, l2_literal_value(g\value\as\atom), 0 - 1, me) < 0
                    return: l2_error(path, at, "out of memory")
                l2_nsf_fname[l2_nsf_n - 1]: fname
                ---
            else:
                # int/unsigned/ulong (D-15, steps/defects.md): the same
                # shape size_t just used, kinds 7/8/9 -- the own-field path
                # already accepts these numbers for a field-path leaf
                # (l2_field_path_check, l2_own_seg_scan), only the named-
                # Structure declaration side never registered them, so
                # `int: greeting 0` fell through every named shape here and
                # read as the catch-all `Name: field` Structure reference,
                # which then refused it for not having exactly one item.
                if: l2_frame_head(fld, "int")
                    if: l2_count_active(fld\as\frame\body) != 2 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
                        return: l2_error(path, at, "a named Structure field needs a name")
                    fname: (cast: (@: LmP0Text) g\value\as\atom)
                    g: l2_next_active(g\next)
                    if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_num(g\value\as\atom) = 0
                        return: l2_error(path, at, "a named Structure field needs a literal")
                    if: l2_nsf_push(7, l2_literal_value(g\value\as\atom), 0 - 1, me) < 0
                        return: l2_error(path, at, "out of memory")
                    l2_nsf_fname[l2_nsf_n - 1]: fname
                    ---
                else:
                    if: l2_frame_head(fld, "unsigned")
                        if: l2_count_active(fld\as\frame\body) != 2 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
                            return: l2_error(path, at, "a named Structure field needs a name")
                        fname: (cast: (@: LmP0Text) g\value\as\atom)
                        g: l2_next_active(g\next)
                        if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_num(g\value\as\atom) = 0
                            return: l2_error(path, at, "a named Structure field needs a literal")
                        if: l2_nsf_push(8, l2_literal_value(g\value\as\atom), 0 - 1, me) < 0
                            return: l2_error(path, at, "out of memory")
                        l2_nsf_fname[l2_nsf_n - 1]: fname
                        ---
                    else:
                        if: l2_frame_head(fld, "ulong")
                            if: l2_count_active(fld\as\frame\body) != 2 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
                                return: l2_error(path, at, "a named Structure field needs a name")
                            fname: (cast: (@: LmP0Text) g\value\as\atom)
                            g: l2_next_active(g\next)
                            if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_num(g\value\as\atom) = 0
                                return: l2_error(path, at, "a named Structure field needs a literal")
                            if: l2_nsf_push(9, l2_literal_value(g\value\as\atom), 0 - 1, me) < 0
                                return: l2_error(path, at, "out of memory")
                            l2_nsf_fname[l2_nsf_n - 1]: fname
                            ---
                        else:
                            if: l2_frame_head(fld, "char")
                                if: l2_count_active(fld\as\frame\body) != 2 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
                                    return: l2_error(path, at, "a named Structure field needs a name")
                                fname: (cast: (@: LmP0Text) g\value\as\atom)
                                g: l2_next_active(g\next)
                                cval: 0 - 1
                                if: g\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM
                                    cval: l2_char_literal(g\value\as\atom)
                                if: cval < 0
                                    return: l2_error(path, at, "a char field needs a quoted single character")
                                if: l2_nsf_push(1, (cast: (size_t) cval), 0 - 1, me) < 0
                                    return: l2_error(path, at, "out of memory")
                                l2_nsf_fname[l2_nsf_n - 1]: fname
                                l2_ns_has_char: 1
                            else:
                                if: l2_frame_head(fld, "fn")
                                    # A CALLABLE field: the field NAME is the method name and its
                                    # value is that method own Structure, whose slot 0 holds the
                                    # shared METHOD descriptor. Resolved with the reference fields
                                    # after the whole unit is read, since M may come later.
                                    if: l2_count_active(fld\as\frame\body) != 1 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
                                        return: l2_error(path, at, "a callable field needs a method name")
                                    if: l2_nsf_push(4, 0U, 0 - 1, me) < 0
                                        return: l2_error(path, at, "out of memory")
                                    l2_nsf_fname[l2_nsf_n - 1]: (cast: (@: LmP0Text) g\value\as\atom)
                                    l2_nsf_name[l2_nsf_n - 1]: (cast: (@: LmP0Text) g\value\as\atom)
                                else:
                                    if: l2_frame_head(fld, "()")
                                        # An inline nested Structure: (): name followed by its body block.
                                        if: l2_count_active(fld\as\frame\body) != 2 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
                                            return: l2_error(path, at, "a nested Structure needs a name and a body")
                                        if: l2_fn_close(fld\as\frame, g\value\as\atom, 0) != 0
                                            return: l2_error(path, at, "end target does not match close target")
                                        if: l2_nsf_push(2, 0U, 0, me) < 0
                                            return: l2_error(path, at, "out of memory")
                                        l2_nsf_fname[l2_nsf_n - 1]: (cast: (@: LmP0Text) g\value\as\atom)
                                        sub_ix: l2_nsf_n - 1
                                        # The field slot is reserved before recursing, so field order is
                                        # source order; the nested entry index is patched in after.
                                        ref_ix: l2_ns_n
                                        if: l2_take_ns_body((cast: (@: LmP0Text) g\value\as\atom), me, l2_next_active(g\next)\value\as\structure, fld, path) != 0
                                            return: 1
                                        l2_nsf_ref[sub_ix]: ref_ix
                                    else:
                                        rdepth: l2_address_depth(fld\as\frame\head)
                                        if: rdepth != 0
                                            # @: T name / @@: T name (author's rule: `@` of any
                                            # depth is a declaration receiver in L3, so a named
                                            # Structure -- itself L3 -- admits a reference field
                                            # the same way a formal or local does). The pointee
                                            # vocabulary is exactly a formal's/local's: the six
                                            # core words at this depth, the kernel types at depth
                                            # 1 (LmxMsg code 29, the mail sender reference; D-52 --
                                            # steps/defects.md -- covers the prototype-construction
                                            # gap this kind needed, FABLE-SONNET-SEND-REF-20260925-172
                                            # commit 1), or
                                            # another named Structure. Not a Message-only kind.
                                            if: l2_count_active(fld\as\frame\body) != 2 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM
                                                return: l2_error(path, at, "a reference field needs a type and a name")
                                            h: l2_next_active(g\next)
                                            if: h\value = 0 || h\value\kind != c.LM_P0_NODE_ATOM || l2_ident(h\value\as\atom) = 0
                                                return: l2_error(path, at, "a reference field needs a name")
                                            rty: 0 - 1
                                            if: l2_ptr_type_word(g\value\as\atom, rdepth, @ rty) != 0
                                                if: rdepth != 1 || l2_kernel_ptr_word(g\value\as\atom, @ rty) != 0
                                                    if: l2_resolve_type_atom(g\value\as\atom, rdepth, 0, @ rty) != 0
                                                        return: l2_error(path, g\value, "unknown type")
                                                    ---
                                                ---
                                            if: l2_nsf_push(9 + rdepth, 0U, rty, me) < 0
                                                return: l2_error(path, at, "out of memory")
                                            l2_nsf_fname[l2_nsf_n - 1]: (cast: (@: LmP0Text) h\value\as\atom)
                                            # `@: T q` with T a named Structure (D-76): the pointee's name, so a
                                            # path goes on through q (l2_ns_ref_pointee).
                                            if: rdepth = 1 && l2_ns_find(g\value\as\atom) >= 0
                                                l2_nsf_name[l2_nsf_n - 1]: (cast: (@: LmP0Text) g\value\as\atom)
                                            ---
                                        else:
                                            # Name: field, a reference to another named Structure. The
                                            # TARGET is not resolved here: it may not have been read yet,
                                            # it may be this very declaration, or one enclosing it.
                                            if: l2_count_active(fld\as\frame\body) != 1 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
                                                return: l2_error(path, at, "a Structure reference field needs a name")
                                            if: l2_nsf_push(3, 0U, 0 - 1, me) < 0
                                                return: l2_error(path, at, "out of memory")
                                            l2_nsf_fname[l2_nsf_n - 1]: (cast: (@: LmP0Text) g\value\as\atom)
                                            l2_nsf_name[l2_nsf_n - 1]: (cast: (@: LmP0Text) fld\as\frame\head)
                                            ---
                                        ---
                                    ---
                                ---
            ---
        count: count + 1
        f: l2_next_active(f\next)
    ---
    l2_ns_count[me]: count
return: 0

# An otherwise unrecognized unit-level frame with a matching end is an ordinary
# named Structure. Reserved heads are matched before this is ever reached, so a
# malformed reserved construct stays an error rather than becoming a
# declaration.
# The METHOD index a callable field at one slot names, or -1. Kept separate
# from l2_ns_field_ref, which reports a declaration index: the two index
# different tables and must never be confused.
# The declaration entry that is the ROOT of one qualified branch, or -1.
fn: l2_ebr_root (int: k) int
    int: i 0
    while: i < l2_ns_n
        if: l2_ns_eternal[i] = k && l2_ns_parent[i] < 0
            return: i
        i: i + 1
    ---
return: 0 - 1

# The ELEMENT TYPE of an array field at one slot: 0 int, 1 char, -1 not an
# array. Separate accessor on purpose -- the ref column means a declaration
# index for a reference and a method index for a callable, and reading one as
# another is how child 4294967295 got emitted once.
# The declared element COUNT of an array field at one slot, or 0.
fn: l2_ns_field_len (int: ni; int: j) size_t
    int: k 0
    int: slotix 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni && slotix = j && l2_nsf_kind[k] = 5
            return: l2_nsf_val[k]
        if: l2_nsf_owner[k] = ni && slotix = j
            return: 0U
        if: l2_nsf_owner[k] = ni
            slotix: slotix + 1
        k: k + 1
    ---
return: 0U

fn: l2_ns_field_mi (int: ni; int: j) int
    int: k 0
    int: slotix 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni && slotix = j && l2_nsf_kind[k] = 4
            return: l2_nsf_ref[k]
        if: l2_nsf_owner[k] = ni && slotix = j
            return: 0 - 1
        if: l2_nsf_owner[k] = ni
            slotix: slotix + 1
        k: k + 1
    ---
return: 0 - 1

# Field KIND at one slot of a declaration, or -1.
fn: l2_ns_field_kind (int: ni; int: j) int
    int: k 0
    int: slotix 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni && slotix = j
            return: l2_nsf_kind[k]
        if: l2_nsf_owner[k] = ni
            slotix: slotix + 1
        k: k + 1
    ---
return: 0 - 1

# Slot index -> reference target for one declaration, or -1 when that slot is
# not a reference. Fields are selected by owner because the table is flat.
# Append one result-slot row. Kind -1 marks a slot with no source name.
fn: l2_mrs_push (int: res; const: @(LmP0Text name); int: kind; int: ent; int: vk; size_t: val) int
    @@: LmP0Text gt
    @: int gi
    @: size_t gv
    size_t: want (cast: (size_t) (l2_mrs_n + 1))
    gi: (cast: (@: int) realloc((cast: (@: void) l2_mrs_res), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_mrs_res: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_mrs_kind), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_mrs_kind: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_mrs_ent), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_mrs_ent: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_mrs_vk), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_mrs_vk: gi
    gv: (cast: (@: size_t) realloc((cast: (@: void) l2_mrs_val), want * c.sizeof(c.size_t)))
    if: gv = 0
        return: 0 - 1
    l2_mrs_val: gv
    gt: (cast: (@@: LmP0Text) realloc((cast: (@: void) l2_mrs_name), want * c.sizeof(@: void)))
    if: gt = 0
        return: 0 - 1
    l2_mrs_name: gt
    l2_mrs_res[l2_mrs_n]: res
    l2_mrs_name[l2_mrs_n]: (cast: (@: LmP0Text) name)
    l2_mrs_kind[l2_mrs_n]: kind
    l2_mrs_ent[l2_mrs_n]: ent
    l2_mrs_vk[l2_mrs_n]: vk
    l2_mrs_val[l2_mrs_n]: val
    l2_mrs_n: l2_mrs_n + 1
return: 0

# The number of slots merge result res has so far.
fn: l2_mrs_width (int: res) int
    int: r 0
    int: w 0
    while: r < l2_mrs_n
        if: l2_mrs_res[r] = res
            w: w + 1
        r: r + 1
    ---
return: w

# The row of slot `slot` of merge result res, or -1.
fn: l2_mrs_row (int: res; int: slot) int
    int: r 0
    int: slotix 0
    while: r < l2_mrs_n
        if: l2_mrs_res[r] = res && slotix = slot
            return: r
        if: l2_mrs_res[r] = res
            slotix: slotix + 1
        r: r + 1
    ---
return: 0 - 1

# Record where field j of operand k of merge result res lands (l2_msrc_*).
fn: l2_msrc_push (int: res; int: k; int: j; int: slot; int: pair) int
    @: int gi
    size_t: want (cast: (size_t) (l2_msrc_n + 1))
    gi: (cast: (@: int) realloc((cast: (@: void) l2_msrc_res), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_msrc_res: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_msrc_op), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_msrc_op: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_msrc_fld), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_msrc_fld: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_msrc_slot), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_msrc_slot: gi
    gi: (cast: (@: int) realloc((cast: (@: void) l2_msrc_pair), want * c.sizeof(c.int)))
    if: gi = 0
        return: 0 - 1
    l2_msrc_pair: gi
    l2_msrc_res[l2_msrc_n]: res
    l2_msrc_op[l2_msrc_n]: k
    l2_msrc_fld[l2_msrc_n]: j
    l2_msrc_slot[l2_msrc_n]: slot
    l2_msrc_pair[l2_msrc_n]: pair
    l2_msrc_n: l2_msrc_n + 1
return: 0

# The slot field j of operand k of merge result res still holds when the merge is done, or
# -1: none, or a later operand wrote that slot again.  A check of the operand's own value
# belongs only where it survived.
fn: l2_msrc_at (int: res; int: k; int: j) int
    int: q 0
    int: slot 0 - 1
    while: q < l2_msrc_n
        if: slot >= 0 && l2_msrc_res[q] = res && l2_msrc_slot[q] = slot
            return: 0 - 1
        if: l2_msrc_res[q] = res && l2_msrc_op[q] = k && l2_msrc_fld[q] = j
            slot: l2_msrc_slot[q]
        q: q + 1
    ---
return: slot

# Field j of operand k joins merge result res by the author's rule (plan §4).  The model's
# fields (k = 0) are the first rows, its own repeats included.  A later field whose name a
# placed row carries -- the model's (the last such row, the one `merged\x` names) or one an
# earlier operand added -- goes INTO that row when its type is the row's; any other later
# field is a row of its own.  So merge makes no repeated names.  The body joins last, as
# operand n (the kernel's `operand = count`, -194 K1); pairs apply in this order, so a later
# operand's value wins.
fn: l2_mrs_join (int: res; int: k; int: j; const: @(LmP0Text name); int: kind; int: ent; int: vk; size_t: val; const: @(LmP0Node at)) int
    int: r 0
    int: slotix 0
    int: hit 0 - 1
    int: hr 0 - 1
    while: k > 0 && r < l2_mrs_n
        if: l2_mrs_res[r] = res && l2_text_same(l2_mrs_name[r], name)
            hit: slotix
            hr: r
        if: l2_mrs_res[r] = res
            slotix: slotix + 1
        r: r + 1
    ---
    if: hit >= 0 && l2_mrs_kind[hr] != kind
        return: l2_error(l2_src, at, "a merge operand field has another type than the model field of its name")
    if: hit >= 0 && kind >= 2 && kind <= 6 && l2_mrs_ent[hr] != ent
        return: l2_error(l2_src, at, "a merge operand field has another type than the model field of its name")
    if: hit >= 0
        l2_mrs_vk[hr]: vk
        l2_mrs_val[hr]: val
        return: l2_msrc_push(res, k, j, hit, 1)
    if: l2_msrc_push(res, k, j, l2_mrs_width(res), 0) != 0
        return: 0 - 1
return: l2_mrs_push(res, name, kind, ent, vk, val)

# Every field of one declaration joins merge result res as operand k, in declared order.
fn: l2_mrs_take_entry (int: res; int: k; int: ni; const: @(LmP0Node at)) int
    int: q 0
    int: j 0
    int: vk 0
    while: q < l2_nsf_n
        if: l2_nsf_owner[q] = ni
            vk: 0
            if: l2_nsf_kind[q] = 0
                vk: 1
            if: l2_nsf_kind[q] = 1
                vk: 2
            if: l2_mrs_join(res, k, j, l2_nsf_fname[q], l2_nsf_kind[q], l2_nsf_ref[q], vk, l2_nsf_val[q], at) != 0
                return: 1
            j: j + 1
        ---
        q: q + 1
    ---
return: 0

# The rows an already bound result contributes when it is itself operand k.
fn: l2_mrs_take_result (int: res; int: k; int: src; const: @(LmP0Node at)) int
    int: r 0
    int: j 0
    int: n
    n: l2_mrs_n
    while: r < n
        if: l2_mrs_res[r] = src
            if: l2_mrs_join(res, k, j, l2_mrs_name[r], l2_mrs_kind[r], l2_mrs_ent[r], l2_mrs_vk[r], l2_mrs_val[r], at) != 0
                return: 1
            j: j + 1
        ---
        r: r + 1
    ---
return: 0

# Join a value-position path, which arrives as atoms around separator atoms,
# into one byte span. Returns the length, or 0 when the field list is not a
# path. The buffer is caller supplied; a path longer than it is not a path.
fn: l2_join_path (@: LmP0Field field; int: cnt; @: char buf; size_t: cap) size_t
    @: LmP0Field f
    const: @: LmP0Text t
    size_t: n 0U
    int: want_name 1
    if: field = 0 || buf = 0 || cnt < 3
        return: 0U
    f: l2_next_active(field)
    while: f != 0
        if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
            return: 0U
        t: f\value\as\atom
        if: t = 0 || t\data = 0 || t\length = 0U
            return: 0U
        if: want_name != 0 && t\length = 1U && t\data[0] = 92
            return: 0U
        if: want_name = 0 && (t\length != 1U || t\data[0] != 92)
            return: 0U
        if: n + t\length > cap
            return: 0U
        memcpy(buf + n, t\data, t\length)
        n: n + t\length
        want_name: 1 - want_name
        f: l2_next_active(f\next)
    ---
    if: want_name != 0
        return: 0U
return: n

# The value a field-path statement stores: a literal, or a char literal. Only
# what the declared field kinds already admit.
fn: l2_path_rhs (const: @(LmP0Structure body); int: kind; @: size_t out_v) int
    @: LmP0Field f
    const: @: LmP0Text t
    int: cv
    if: body = 0 || l2_count_active(body) != 1
        return: 1
    f: l2_next_active(body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    t: f\value\as\atom
    if: (kind = 0 || kind = 7 || kind = 8 || kind = 9) && l2_num(t) = 0
        return: 1
    if: kind = 0 || kind = 7 || kind = 8 || kind = 9
        \out_v: l2_literal_value(t)
        return: 0
    cv: l2_char_literal(t)
    if: cv < 0
        return: 1
    \out_v: (cast: (size_t) cv)
return: 0

# The body of "if: <slot> = 0" for a field path: a slot the translator resolved
# must exist, so this is a lost-graph stop, not a language outcome. It leaves a
# method exactly the way l2_emit_path_load leaves one -- the method's own
# return shape -- and the entry with a distinguished code.
# Which method does this statement or call head name? A plain name, or a field
# path whose leaf is a callable. -1 when the head names no method.
# The unit-child index of the first used own field of a method, or -1. Its cell
# is what distinguishes two occurrences of the same callable: the descriptor is
# shared, the own storage is not.
fn: l2_first_own_child (int: mi) int
    int: oi 0
    while: oi < l2_own_n
        if: l2_own_mi[oi] = mi && l2_m_uses[l2_own_off(mi, oi)] != 0 && l2_own_host[oi] = 0 && l2_own_uchild[oi] >= 0
            return: l2_own_uchild[oi]
        oi: oi + 1
    ---
return: 0 - 1

# Is this statement a CALL rather than an update? Block, short/colon and
# parenthesized forms must select the same operation. COMPACT/COLON flags
# do not choose here. An existing METHOD is a call in every form; a path
# that ends at a callable field is a call; an empty argument list cannot
# be an update. Everything else with a path head is an update, and a
# wrong one is reported against the field it names.
fn: l2_head_is_call (const: @(LmP0Text t); const: @(LmP0Structure body); unsigned: flags; int: mi) int
    int: k 0
    int: fi
    int: req
    if: t = 0
        return: 0
    fi: l2_formal_find(mi, t)
    if: fi >= 0
        req: l2_cf_get(mi, fi)
        if: req >= 0
            return: 1
        ---
    ---
    if: l2_find_method(t) >= 0
        return: 1
    # c.name(...) is the raw C door (spec 6.6.6): a call in every form, an empty argument list
    # included (`c.abort()`), never an update of a field of that name.
    if: l2_c_stmt_door(t) != 0
        return: 1
    if: t\data = 0 || t\length >= 256U
        return: 0
    if: l2_seg_count(t\data, t\length) < 2
        return: 0
    if: l2_path_kind(t\data, t\length, @ k) = 4
        return: 1
    if: body = 0 || l2_count_active(body) = 0
        return: 1
return: 0

fn: l2_head_method (const: @(LmP0Text t)) int
    int: k 0
    int: r
    if: t = 0
        return: 0 - 1
    r: l2_find_method(t)
    if: r >= 0
        return: r
    if: t\data = 0 || t\length >= 256U
        return: 0 - 1
    if: l2_seg_count(t\data, t\length) < 2
        return: 0 - 1
    if: l2_path_kind(t\data, t\length, @ k) != 4
        return: 0 - 1
return: k

# A field path that meets no Structure where it needs one (D-05) takes the X1 route: a message and
# an abort (l2_emit_invariant).  It used to return 0 from the whole method, a silent success.
fn: l2_emit_path_bail (int: mi; const: @(char ind)) int
    if: mi < 0
        return: 1
return: l2_emit_invariant(ind, "a field path met no Structure")

# ---------------------------------------------------------------------------
# SOURCE FIELD PATHS (SPEC 8252, 8366). A path is a name, then field-follow
# separators and field names: the root is an ordinary named Structure or a
# bound merge result, both of which live in reserved unit children. Every step
# resolves at TRANSLATION to a child index. The graph carries no name table at
# run time and none is introduced here.
#
# A path arrives in two spellings. In update position the parser hands over the
# whole path as ONE frame head text; in value position it arrives as a sequence
# of atoms separated by the separator atom. These functions therefore take a
# plain byte span, which both spellings can produce, rather than an LmP0Text.
# ---------------------------------------------------------------------------

# Segment i of a separator-joined span, as an offset and a length.
# Is this statement head a field path this emitter lowers? Used by the
# unsupported-body guard, which runs before the statement is dispatched.
fn: l2_is_path_head (const: @(LmP0Text t)) int
    int: ni 0
    int: res 0
    int: oi 0
    int: root 0
    int: fi 0
    if: t = 0 || t\data = 0 || t\length >= 256U
        return: 0
    if: l2_seg_count(t\data, t\length) < 2
        return: 0
    if: l2_path_root(t\data, t\length, @ ni, @ res, @ oi, @ root, @ fi) != 0
        return: 0
return: 1

fn: l2_seg_at (const: @(char pd); size_t: pn; int: i; @: size_t off; @: size_t len) int
    size_t: j 0U
    size_t: start 0U
    int: seen 0
    if: pd = 0
        return: 1
    while: j < pn
        if: pd[j] = 92 && seen = i
            \off: start
            \len: j - start
            return: 0
        if: pd[j] = 92
            seen: seen + 1
            start: j + 1U
        j: j + 1U
    ---
    if: seen != i
        return: 1
    \off: start
    \len: pn - start
return: 0

fn: l2_seg_count (const: @(char pd); size_t: pn) int
    size_t: j 0U
    int: n 1
    if: pd = 0
        return: 0
    while: j < pn
        if: pd[j] = 92
            n: n + 1
        j: j + 1U
    ---
return: n

# Does this name equal the given span of the path?
fn: l2_name_is_seg (const: @(LmP0Text name); const: @(char pd); size_t: off; size_t: len) int
    if: name = 0 || name\data = 0 || pd = 0 || len = 0U
        return: 0
    if: name\length != len
        return: 0
return: memcmp(name\data, pd + off, len) = 0

# A field of one declaration, by name: returns its SLOT index and reports the
# field kind and the entry a nested or reference field names. -1 when unknown,
# -2 when more than one field of that declaration carries the name.
fn: l2_ns_slot_named (int: ni; const: @(char pd); size_t: off; size_t: len; @: int out_kind; @: int out_ent) int
    int: k 0
    int: slotix 0
    int: hit 0 - 1
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni && l2_name_is_seg(l2_nsf_fname[k], pd, off, len) != 0 && hit >= 0
            return: 0 - 2
        if: l2_nsf_owner[k] = ni && l2_name_is_seg(l2_nsf_fname[k], pd, off, len) != 0
            hit: slotix
            \out_kind: l2_nsf_kind[k]
            \out_ent: l2_nsf_ref[k]
        if: l2_nsf_owner[k] = ni
            slotix: slotix + 1
        k: k + 1
    ---
return: hit

# The named Structure the reference field `@: T seg` of Structure ni points at, or -1 (D-76).
fn: l2_ns_ref_pointee (int: ni; const: @(char pd); size_t: off; size_t: len) int
    int: k 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni && l2_nsf_kind[k] = 10 && l2_nsf_name[k] != 0 && l2_name_is_seg(l2_nsf_fname[k], pd, off, len) != 0
            return: l2_ns_find(l2_nsf_name[k])
        k: k + 1
    ---
return: 0 - 1

# The same for a bound merge result, whose slots carry the names of the fields
# that CONTRIBUTED them.  merge makes no repeated names (the author's merge rule, plan §4):
# a later operand's field of a model name went INTO the model's slot, so a name has one
# slot -- or the model's own repeats, of which `merged\x` is the last; an explicit
# `merged\[N]x` is l2_mrs_slot_nth.
fn: l2_mrs_slot_named (int: res; const: @(char pd); size_t: off; size_t: len; @: int out_kind; @: int out_ent) int
    int: k 0
    int: slotix 0
    int: hit 0 - 1
    while: k < l2_mrs_n
        if: l2_mrs_res[k] = res && l2_name_is_seg(l2_mrs_name[k], pd, off, len) != 0
            hit: slotix
            \out_kind: l2_mrs_kind[k]
            \out_ent: l2_mrs_ent[k]
        if: l2_mrs_res[k] = res
            slotix: slotix + 1
        k: k + 1
    ---
return: hit

# Occurrence occ (0 = the first) of field `name` of bound merge result res: its slot, with the
# field kind and entry; -1 when there is no such occurrence.  Only the model's own repeats
# are occurrences past the first.
fn: l2_mrs_slot_nth (int: res; const: @(LmP0Text name); int: occ; @: int out_kind; @: int out_ent) int
    int: k 0
    int: slotix 0
    int: seen 0
    if: name = 0 || out_kind = 0 || out_ent = 0 || occ < 0
        return: 0 - 1
    while: k < l2_mrs_n
        if: l2_mrs_res[k] = res && l2_name_is_seg(l2_mrs_name[k], name\data, 0U, name\length) != 0 && seen = occ
            \out_kind: l2_mrs_kind[k]
            \out_ent: l2_mrs_ent[k]
            return: slotix
        if: l2_mrs_res[k] = res && l2_name_is_seg(l2_mrs_name[k], name\data, 0U, name\length) != 0
            seen: seen + 1
        if: l2_mrs_res[k] = res
            slotix: slotix + 1
        k: k + 1
    ---
return: 0 - 1

# Is this span a field path whose root names a declaration, a bound result,
# or a Structure reference this occurrence already holds (an own field --
# FABLE-SONNET-FIELD-PATHS-20260923-113)? Own-field roots are tried first,
# the same priority order declaration/assignment/call resolution already
# uses (CORE.md 4): an own field can never share a name with a unit-level
# declaration or a bound result, so trying it first changes nothing for any
# root that was already recognized. \out_oi does not require the root's
# namespace type to be known -- an own field with no known Structure type
# is still a root (l2_is_path_head still routes it to the path machinery),
# it simply cannot be walked past segment 1; l2_path_kind/l2_emit_path
# refuse that explicitly instead of guessing, at the segment that needs it.
# out_root: -1 ordinary (out_ni/out_res/out_oi as before); -2 the literal
# root "node" (FABLE-SONNET-NODE-ROOT-20260923-121: M.parent, the callable
# occurrence's lexical parent -- the unit, for any method other than E
# itself; E has no parent, so "node" inside E resolves nothing here and the
# path fails downstream as an ordinary unresolved name); >=0 the literal
# root "for", value = the innermost enclosing for-frame's l2_for_* index
# (the for-frame's own Structure, read as CORE.md's "for\x" rule). node/for
# are ordinary roots of this dispatcher now, not reserved spelling prefixes
# -- an own field or formal literally named "node"/"for" (checked first,
# unchanged) still wins, matching this dispatcher's existing precedence.
# out_fi (Opus's D1, folded into -121): -1 unless out_ni came from a
# TYPED FORMAL's own nsty (the formal-fallback branch below) -- l2_emit_path
# must then seed l2_pst from the formal's ACTUAL ARGUMENT value, never
# from ni treated as an ordinary unit-level declaration (that read the
# static declaration child, not the passed value: a formal root is a
# value like an own field's load, not a name in the unit's own scope).
fn: l2_path_root (const: @(char pd); size_t: pn; @: int out_ni; @: int out_res; @: int out_oi; @: int out_root; @: int out_fi) int
    size_t: off 0U
    size_t: len 0U
    int: i 0
    int: fid
    \out_ni: 0 - 1
    \out_res: 0 - 1
    \out_oi: 0 - 1
    \out_root: 0 - 1
    \out_fi: 0 - 1
    if: l2_seg_count(pd, pn) < 2
        return: 1
    if: l2_seg_at(pd, pn, 0, @ off, @ len) != 0 || len = 0U
        return: 1
    if: l2_cur_mi >= 0
        while: i < l2_own_n
            if: l2_own_mi[i] = l2_cur_mi && l2_name_is_seg(l2_own_name[i], pd, off, len) != 0 && (l2_own_host[i] = 0 || l2_scope_has(l2_own_host[i]))
                \out_oi: i
            i: i + 1
        ---
    # A unit field is an own field of the entry E, whose occurrence is the
    # unit: visible through the callable's node chain from below its
    # declaration (author's backward-visibility norm) -- the same fallback
    # l2_own_find already has (FABLE-SONNET-OWN-LOOKUP-AUDIT-20260923-131
    # Part 3: this own-field-name-as-root scan was hand-rolled against raw
    # pd/off/len instead of calling l2_own_find, and had drifted without
    # it, exactly the D1/D2/-129/l2_own_first pattern -- a Structure-typed
    # unit field used as a path root from inside another method hit
    # "unknown field path root" with no fallback at all).
    if: l2_cur_mi >= 0 && \out_oi < 0
        i: 0
        while: i < l2_own_n
            if: l2_own_unit_seen(i, l2_cur_mi) != 0 && l2_name_is_seg(l2_own_name[i], pd, off, len) != 0
                \out_oi: i
            i: i + 1
        ---
    if: \out_oi >= 0
        return: 0
    # A resolved method name as a path root denotes its occurrence
    # Structure (FABLE-SONNET-NODE-ROOT-20260923-121, author on the -67/-84
    # blocker: "test\field == test\[0]field" -- a method's own cell is
    # observed from outside its activation through the occurrence root,
    # unit child at l2_unit_base + method index, exactly l2_own_ctr's
    # existing formula for any own field of another method). out_root
    # <= -1000 encodes this (mi = -1000 - out_root), leaving -2 (node) and
    # >= 0 (for) unambiguous. Bracket indexing (M\[N]x for a second
    # activation) is not built -- the occurrence machinery does not yet
    # distinguish repeated activations at all, so only the bare (implicit
    # [0]) spelling is wired here.
    i: 0
    while: i < l2_m_n
        if: l2_name_is_seg(l2_m_name[i], pd, off, len) != 0
            \out_root: 0 - 1000 - i
        i: i + 1
    if: \out_root <= 0 - 1000
        l2_uses_node_for_root: 1
        return: 0
    if: len = 4U && memcmp(pd + off, "node", 4U) = 0 && l2_cur_mi >= 0 && l2_cur_mi != l2_e
        \out_root: 0 - 2
        l2_uses_node_for_root: 1
        return: 0
    if: len = 3U && memcmp(pd + off, "for", 3U) = 0
        i: 0
        fid: 0 - 1
        while: i < l2_scope_n
            if: l2_frame_head(l2_scope_at[i], "for") != 0
                fid: l2_for_find(l2_scope_at[i])
            i: i + 1
        if: fid >= 0
            \out_root: fid
            l2_uses_node_for_root: 1
            return: 0
        ---
    # D-28 (steps/defects.md, author's reading A): a formal parameter is
    # the nearest lexical binding for its own name and must shadow a
    # unit-level named Structure sharing that spelling -- tried and
    # returned on FIRST, ahead of the named-Structure/method-result loops
    # below, not as a fallback tried only once those already missed (the
    # order this sat in before, which let a typed formal's own name never
    # be seen at all whenever a unit-level Structure of the same spelling
    # also existed). \out_ni comes only from the formal's own DECLARED
    # type (l2_nsty_get, set at method registration when the formal's
    # declaration frame head is itself a known Structure name) -- never
    # inferred from the formal's NAME (norm §3: a type comes only from
    # the declaration, no name specials). A generically-typed formal
    # (e.g. the L1-style `@(Lmx x)` spelling, whose declared type is the
    # opaque Lmx, not a Structure) keeps \out_ni < 0 here: the root
    # itself is still recognized (\out_fi is set, so l2_emit_path_to's
    # existing oi<0&&fi>=0 branch correctly seeds from it), but a field
    # path continuing off it is a located refusal -- correct for a
    # genuinely opaque formal, not a gap this ticket papers over.
    if: l2_cur_mi >= 0
        i: 0
        while: i < l2_m_arity[l2_cur_mi]
            if: l2_fn(l2_cur_mi, i) != 0 && l2_name_is_seg(l2_fn(l2_cur_mi, i), pd, off, len) != 0
                \out_fi: i
                \out_ni: l2_nsty_get(l2_cur_mi, i)
            i: i + 1
        ---
    if: \out_fi >= 0
        return: 0
    # A local reference `@: T name` to a named Structure (D-76): its value is the Structure, the
    # root; out_root -3 - i names local i (-2 is node, <= -1000 a method, >= 0 a for).
    if: l2_cur_mi >= 0
        i: 0
        while: i < l2_ml_n && i < 990
            if: l2_ml_ns[i] >= 0 && l2_name_is_seg(l2_ml_nm[i], pd, off, len) != 0
                \out_root: 0 - 3 - i
                \out_ni: l2_ml_ns[i]
            i: i + 1
        ---
    if: \out_root <= 0 - 3 && \out_root > 0 - 1000
        return: 0
    i: 0
    while: i < l2_ns_n
        if: l2_ns_parent[i] < 0 && l2_name_is_seg(l2_ns_name[i], pd, off, len) != 0
            \out_ni: i
        i: i + 1
    ---
    i: 0
    while: i < l2_mres_n
        if: l2_name_is_seg(l2_mres_name[i], pd, off, len) != 0
            \out_res: i
        i: i + 1
    ---
    if: \out_ni < 0 && \out_res < 0
        return: 1
return: 0

# The l2_ns_slot_named/l2_mrs_slot_named contract (kind 0 size_t, 1 char, 2
# nested, 3 reference, 4 callable, 5 array; 6 is reserved for a namespace
# field kind Opus's S3 part 2 is adding to l2_nsf_kind's own table, a
# different space this shares the same "kind" variable with mid-walk, so
# this ticket's own new kind is 7, not 6, to keep the two unambiguous: a
# plain own-declared int (own_ty 0 -- a leaf l2_ns_slot_named/l2_nsf_kind
# never needed, since a named-Structure field can only be declared
# size_t:/char:, but an ordinary own declaration commonly is int:, and
# refusing every int:-typed E/for-frame field would have refused far more
# of the existing corpus than a narrow gap);
# out_ent the target ni for kind 2/3), but the search is l2_own_* by (mi,
# host) instead of l2_nsf_* by ni: node/for's segment 1 (FABLE-SONNET-
# NODE-ROOT-20260923-121) is a field of an own-declared scope (E's
# top-level own fields, or a for-frame's hosted own fields), not of a
# named Structure type. Returns the found own-index (never the arena
# offset -- l2_own_uchild/l2_own_fchild depend on l2_layout_owns, an
# emit-setup pass; l2_path_kind, a check-time caller, never reads the
# numeric value, only the found/not-found sign, so this stays timing-safe
# for both callers and lets l2_emit_path translate own-index to the real
# offset itself, only once it is safe to). A field whose own-declared
# type is none of these (pointer, callable, Structure-typed without a
# recorded nsty) is not mapped to a kind here and reads as not found --
# refusing is the honest state until that wider capability is built, not
# a wrong kind. Kinds 8 (unsigned) and 9 (ulong) reuse plain numeral
# parsing exactly like 0 (size_t) and 7 (int) -- see l2_path_rhs -- and
# store through lmx_unsigned_store_known/lmx_ulong_store_known, the same
# helpers l2_own_store_helper already names for an own field.
fn: l2_own_seg_scan (int: mi; const: @(LmP0Node host); const: @(char pd); size_t: off; size_t: len; @: int out_kind; @: int out_ent) int
    int: i 0
    int: hit 0 - 1
    \out_kind: 0 - 1
    \out_ent: 0 - 1
    while: i < l2_own_n
        if: l2_own_mi[i] = mi && l2_own_host[i] = (cast: (@: LmP0Node) host) && l2_name_is_seg(l2_own_name[i], pd, off, len) != 0
            hit: i
        i: i + 1
    if: hit < 0
        return: 0 - 1
    if: l2_own_ty[hit] = 2
        \out_kind: 0
        return: hit
    if: l2_own_ty[hit] = 1
        \out_kind: 1
        return: hit
    if: l2_own_ty[hit] = 0
        \out_kind: 7
        return: hit
    if: l2_own_ty[hit] = 3
        \out_kind: 8
        return: hit
    if: l2_own_ty[hit] = 36
        \out_kind: 9
        return: hit
    if: l2_own_nsty_get(hit) >= 0
        \out_kind: 3
        \out_ent: l2_own_nsty_get(hit)
        return: hit
return: 0 - 1

fn: l2_e_own_seg (const: @(char pd); size_t: off; size_t: len; @: int out_kind; @: int out_ent) int
    if: l2_e < 0
        \out_kind: 0 - 1
        \out_ent: 0 - 1
        return: 0 - 1
return: l2_own_seg_scan(l2_e, 0, pd, off, len, out_kind, out_ent)

fn: l2_for_own_seg (int: fid; const: @(char pd); size_t: off; size_t: len; @: int out_kind; @: int out_ent) int
    if: fid < 0 || fid >= l2_for_n
        \out_kind: 0 - 1
        \out_ent: 0 - 1
        return: 0 - 1
return: l2_own_seg_scan(l2_for_mi[fid], l2_for_node[fid], pd, off, len, out_kind, out_ent)

# Walk a path without emitting: reports the leaf kind (0 size_t, 1 char,
# 2 nested, 3 reference, 4 callable) and, for a callable leaf, the method index
# in out_mi. Returns -1 when the path does not resolve.
# Does this path pass through, or end inside, a qualified branch? Used to
# refuse an update: const: immutable is enforced where the update is written,
# not left to the runtime.
fn: l2_path_in_eternal (const: @(char pd); size_t: pn) int
    size_t: off 0U
    size_t: len 0U
    int: ni 0 - 1
    int: res 0 - 1
    int: oi 0 - 1
    int: root 0 - 1
    int: fi 0 - 1
    int: segs
    int: i 1
    int: slot
    int: kind 0 - 1
    int: ent 0 - 1
    if: l2_path_root(pd, pn, @ ni, @ res, @ oi, @ root, @ fi) != 0
        return: 0
    if: ni >= 0 && l2_ns_eternal[ni] >= 0
        return: 1
    segs: l2_seg_count(pd, pn)
    while: i < segs
        if: l2_seg_at(pd, pn, i, @ off, @ len) != 0 || len = 0U
            return: 0
        slot: 0 - 1
        if: i = 1 && res >= 0
            slot: l2_mrs_slot_named(res, pd, off, len, @ kind, @ ent)
        if: (i > 1 || res < 0) && ni >= 0
            slot: l2_ns_slot_named(ni, pd, off, len, @ kind, @ ent)
        if: slot < 0
            return: 0
        if: (kind = 2 || kind = 3) && ent >= 0 && l2_ns_eternal[ent] >= 0
            return: 1
        if: kind = 2 || kind = 3
            ni: ent
            res: 0 - 1
        ---
        i: i + 1
    ---
return: 0

fn: l2_path_kind (const: @(char pd); size_t: pn; @: int out_mi) int
    size_t: off 0U
    size_t: len 0U
    int: ni 0 - 1
    int: res 0 - 1
    int: oi 0 - 1
    int: segs
    int: i 1
    int: slot
    int: kind 0 - 1
    int: ent 0 - 1
    int: root 0 - 1
    int: fi 0 - 1
    \out_mi: 0 - 1
    if: l2_path_root(pd, pn, @ ni, @ res, @ oi, @ root, @ fi) != 0
        return: 0 - 1
    # An own-rooted path (FABLE-SONNET-FIELD-PATHS-20260923-113): walk it
    # like a namespace root once seeded with the own field's Structure type,
    # if known. Unknown (ni stays -1) refuses at segment 1 below, the same
    # "no Structure here" outcome an ordinary namespace path gives for a
    # non-Structure slot -- no separate error path needed.
    if: oi >= 0
        ni: l2_own_nsty_get(oi)
    segs: l2_seg_count(pd, pn)
    while: i < segs
        if: l2_seg_at(pd, pn, i, @ off, @ len) != 0 || len = 0U
            return: 0 - 1
        slot: 0 - 1
        if: i = 1 && res >= 0
            slot: l2_mrs_slot_named(res, pd, off, len, @ kind, @ ent)
        # node/for (FABLE-SONNET-NODE-ROOT-20260923-121): segment 1 of a
        # node-/for-rooted path is a field of an own-declared scope, found
        # through l2_own_seg_scan, not l2_ns_slot_named -- root is only
        # meaningful at i=1, ni takes over for any further segment exactly
        # as an ordinary own/ns root already does.
        if: i = 1 && root = 0 - 2
            slot: l2_e_own_seg(pd, off, len, @ kind, @ ent)
        if: i = 1 && root >= 0
            slot: l2_for_own_seg(root, pd, off, len, @ kind, @ ent)
        if: i = 1 && root <= 0 - 1000
            slot: l2_own_seg_scan(0 - 1000 - root, 0, pd, off, len, @ kind, @ ent)
        if: (i > 1 || (res < 0 && (root = 0 - 1 || (root <= 0 - 3 && root > 0 - 1000)))) && ni < 0
            return: 0 - 1
        if: (i > 1 || (res < 0 && (root = 0 - 1 || (root <= 0 - 3 && root > 0 - 1000)))) && ni >= 0
            slot: l2_ns_slot_named(ni, pd, off, len, @ kind, @ ent)
        if: slot < 0
            return: 0 - 1
        # Through a reference field `@: T q` (D-76): on into its pointee T.
        if: i + 1 < segs && kind = 10 && res < 0
            ent: l2_ns_ref_pointee(ni, pd, off, len)
        if: i + 1 < segs && kind != 2 && kind != 3 && (kind != 10 || res >= 0 || ent < 0)
            return: 0 - 1
        if: i + 1 < segs
            ni: ent
            res: 0 - 1
        ---
        i: i + 1
    ---
    if: kind = 4
        \out_mi: ent
    if: kind = 10 || kind = 11
        # The reference field's pointee type code (FABLE-SONNET-SEND-REF-
        # 20260925-172 commit 1), the same raw code l2_ptr_type_word/
        # l2_kernel_ptr_word/l2_resolve_type_atom give a formal or local --
        # out_mi doubles as this carrier (unused by any other caller for
        # these two kinds), so l2_field_path_read can convert it to an own-
        # storage pointer code (l2_own_ty_of_param) without a new out param.
        \out_mi: ent
return: kind

# Emit the walk that leaves l2_pxp addressing the LEAF SLOT of the path, and
# report the leaf kind: 0 size_t, 1 char.
fn: l2_emit_path (const: @(char pd); size_t: pn; int: mi; const: @(char ind); const: @(LmP0Node at); @: int out_kind) int
return: l2_emit_path_to(pd, pn, mi, ind, at, out_kind, 0)

# The same walk; arr_ok admits a leaf that is an Array field (kind 5 or 6), whose cell
# holds the Array descriptor reference -- only the indexed route (l2_emit_arr_operand)
# asks for it, and it indexes that descriptor itself.  Every other caller keeps the
# primitive-leaf rule, so a write or a plain read never lands on a descriptor cell.
fn: l2_emit_path_to (const: @(char pd); size_t: pn; int: mi; const: @(char ind); const: @(LmP0Node at); @: int out_kind; int: arr_ok) int
    size_t: off 0U
    size_t: len 0U
    int: ni 0 - 1
    int: res 0 - 1
    int: oi 0 - 1
    int: segs
    int: i 1
    int: slot
    int: kind 0 - 1
    int: ent 0 - 1
    int: root 0 - 1
    int: fi 0 - 1
    c.array: [64]: char l2_proot
    if: l2_path_root(pd, pn, @ ni, @ res, @ oi, @ root, @ fi) != 0
        return: l2_error(l2_src, at, "unknown field path root")
    segs: l2_seg_count(pd, pn)
    # An own-rooted path (FABLE-SONNET-FIELD-PATHS-20260923-113): seed l2_pst
    # from a genuine load of the own field -- l2_emit_path_load already does
    # the null-check/typed-load an own cell needs, and l2_pst is
    # then just that loaded reference, handed to the same per-segment walk
    # below a namespace or bound-result root already uses unchanged.
    if: oi >= 0 && l2_emit_path_load(mi, oi, ind, l2_proot) != 0
        return: 1
    if: oi >= 0 && c.fprintf(l2_out, "%sl2_pst: %s\n", ind, l2_proot) < 0
        return: 1
    if: oi >= 0
        ni: l2_own_nsty_get(oi)
    # A typed-formal root (Opus's D1, folded into -121): the formal's own
    # value IS l2_pst directly, a pointer argument already, not a name in
    # the unit's own scope -- ni here is only the formal's declared TYPE,
    # for the segment walk below, never a unit-level declaration to seed
    # from (that would read the static declaration child, not the passed
    # argument). Mirrors the own-field seed above; guards every ni>=0
    # branch after it so this and the ordinary named-declaration seed
    # never both fire for the same root.
    if: oi < 0 && fi >= 0 && l2_tok_formal(mi, fi, l2_proot) != 0
        return: 1
    if: oi < 0 && fi >= 0 && c.fprintf(l2_out, "%sl2_pst: %s\n%sif: l2_pst = 0\n", ind, l2_proot, ind) < 0
        return: 1
    # A local reference root (D-76): the local's own value is the Structure.
    if: oi < 0 && root <= 0 - 3 && root > 0 - 1000 && (l2_tok_text(l2_ml_nm[0 - 3 - root], l2_proot, 64U) != 0 || c.fprintf(l2_out, "%sl2_pst: (cast: (@: Lmx) %s)\n%sif: l2_pst = 0\n", ind, l2_proot, ind) < 0 || l2_emit_path_bail(mi, ind) != 0)
        return: 1
    if: oi < 0 && fi < 0 && (root > 0 - 3 || root <= 0 - 1000) && ni >= 0 && l2_ns_eternal[ni] < 0 && c.fprintf(l2_out, "%sl2_pst: lmx_arena_ref_struct(%s, %uU)\n%sif: l2_pst = 0\n", ind, l2_unit_ref, (cast: (unsigned) (l2_ns_base + l2_ns_rank(ni))), ind) < 0
        return: 1
    if: oi < 0 && fi < 0 && (root > 0 - 3 || root <= 0 - 1000) && ni >= 0 && l2_ns_eternal[ni] >= 0 && c.fprintf(l2_out, "%sl2_pst: lmx_arena_ref_struct(%s, %uU)\n%sif: l2_pst = 0\n", ind, l2_unit_ref, (cast: (unsigned) (l2_unit_base + l2_occ_n() + l2_ns_eternal[ni])), ind) < 0
        return: 1
    if: oi < 0 && fi >= 0 && l2_emit_path_bail(mi, ind) != 0
        return: 1
    if: oi < 0 && fi < 0 && (root > 0 - 3 || root <= 0 - 1000) && ni >= 0 && l2_emit_path_bail(mi, ind) != 0
        return: 1
    # node/for (FABLE-SONNET-NODE-ROOT-20260923-121): node's value is the
    # unit itself (l2_own_ctr's rule for any own field E owns), needing no
    # arena hop to reach; for's value is the innermost enclosing for-frame's
    # own Structure, one hop from self at its already-laid-out child slot
    # (l2_for_uchild, safe here: l2_emit_path only ever runs after the
    # layout pass that fills it, never at check time).
    if: oi < 0 && root = 0 - 2 && c.fprintf(l2_out, "%sl2_pst: %s\n", ind, l2_unit_ref) < 0
        return: 1
    if: oi < 0 && root >= 0 && c.fprintf(l2_out, "%sl2_pst: lmx_arena_ref_struct(self, %uU)\n%sif: l2_pst = 0\n", ind, (cast: (unsigned) l2_for_uchild[root]), ind) < 0
        return: 1
    if: oi < 0 && root >= 0 && l2_emit_path_bail(mi, ind) != 0
        return: 1
    # A resolved method name as a root (FABLE-SONNET-NODE-ROOT-20260923-121,
    # author on the -67/-84 blocker): its occurrence, unit child at
    # l2_unit_base + that method's index -- l2_own_ctr's own formula for
    # any own field of another method, safe here for the same reason the
    # for-frame seed above is (post-layout only).
    if: oi < 0 && root <= 0 - 1000 && c.fprintf(l2_out, "%sl2_pst: lmx_arena_ref_struct(%s, %uU)\n%sif: l2_pst = 0\n", ind, l2_unit_ref, (cast: (unsigned) (l2_unit_base + (0 - 1000 - root))), ind) < 0
        return: 1
    if: oi < 0 && root <= 0 - 1000 && l2_emit_path_bail(mi, ind) != 0
        return: 1
    if: oi < 0 && root = 0 - 1 && ni < 0 && c.fprintf(l2_out, "%sl2_pst: lmx_arena_ref_struct(%s, %uU)\n%sif: l2_pst = 0\n", ind, l2_unit_ref, (cast: (unsigned) (l2_mres_base + res)), ind) < 0
        return: 1
    if: oi < 0 && root = 0 - 1 && ni < 0 && l2_emit_path_bail(mi, ind) != 0
        return: 1
    # c.* / foreign member paths on formals and activation locals are emitted by
    # l2_raw_path via l2_ty_raw_c_members (FABLE-GROKBOT-C-MEMBER-ACCESS part1).
    # Structure-typed roots keep this L2 slot walk; do not divert Lmx projection owns.
    while: i < segs
        if: l2_seg_at(pd, pn, i, @ off, @ len) != 0 || len = 0U
            return: l2_error(l2_src, at, "malformed field path")
        slot: 0 - 1
        if: i = 1 && res >= 0
            slot: l2_mrs_slot_named(res, pd, off, len, @ kind, @ ent)
        if: i = 1 && root = 0 - 2
            slot: l2_e_own_seg(pd, off, len, @ kind, @ ent)
            if: slot >= 0
                slot: l2_own_uchild[slot]
            ---
        if: i = 1 && root >= 0
            slot: l2_for_own_seg(root, pd, off, len, @ kind, @ ent)
            if: slot >= 0
                slot: l2_own_fchild[slot]
            ---
        if: i = 1 && root <= 0 - 1000
            slot: l2_own_seg_scan(0 - 1000 - root, 0, pd, off, len, @ kind, @ ent)
            if: slot >= 0
                slot: l2_own_uchild[slot]
            ---
        if: (i > 1 || (res < 0 && (root = 0 - 1 || (root <= 0 - 3 && root > 0 - 1000)))) && ni < 0
            return: l2_error(l2_src, at, "field path goes through a slot with no Structure")
        if: (i > 1 || (res < 0 && (root = 0 - 1 || (root <= 0 - 3 && root > 0 - 1000)))) && ni >= 0
            slot: l2_ns_slot_named(ni, pd, off, len, @ kind, @ ent)
        if: slot = 0 - 2
            return: l2_error(l2_src, at, "ambiguous field path segment")
        if: slot < 0
            return: l2_error(l2_src, at, "unknown field path segment")
        if: i + 1 < segs && kind = 10 && res < 0
            ent: l2_ns_ref_pointee(ni, pd, off, len)
        if: i + 1 < segs && kind != 2 && kind != 3 && (kind != 10 || res >= 0 || ent < 0)
            return: l2_error(l2_src, at, "field path goes through a slot with no Structure")
        # Through a reference field (D-76): its pointer cell holds the pointee Structure.
        if: i + 1 < segs && kind = 10 && c.fprintf(l2_out, "%sl2_pxp: lmx_arena_ref_cell(l2_pst, %uU)\n%sif: l2_pxp = 0\n", ind, (cast: (unsigned) slot), ind) < 0
            return: 1
        if: i + 1 < segs && kind = 10 && l2_emit_path_bail(mi, ind) != 0
            return: 1
        if: i + 1 < segs && kind = 10 && c.fprintf(l2_out, "%sl2_pst: (cast: (@: Lmx) lmx_pointer_value_known(l2_pxp[0]))\n%sif: l2_pst = 0\n", ind, ind) < 0
            return: 1
        if: i + 1 < segs && kind != 10 && c.fprintf(l2_out, "%sl2_pst: lmx_arena_ref_struct(l2_pst, %uU)\n%sif: l2_pst = 0\n", ind, (cast: (unsigned) slot), ind) < 0
            return: 1
        if: i + 1 < segs && l2_emit_path_bail(mi, ind) != 0
            return: 1
        if: i + 1 < segs
            ni: ent
            res: 0 - 1
        ---
        if: i + 1 = segs && kind != 0 && kind != 1 && kind != 4 && kind != 7 && kind != 8 && kind != 9 && kind != 10 && kind != 11 && (arr_ok = 0 || (kind != 5 && kind != 6))
            return: l2_error(l2_src, at, "a field path must end at a primitive field")
        if: i + 1 = segs && kind = 4 && c.fprintf(l2_out, "%sl2_pst: lmx_arena_ref_struct(l2_pst, %uU)\n%sif: l2_pst = 0\n", ind, (cast: (unsigned) slot), ind) < 0
            return: 1
        if: i + 1 = segs && kind = 4 && l2_emit_path_bail(mi, ind) != 0
            return: 1
        if: i + 1 = segs && kind != 4 && c.fprintf(l2_out, "%sl2_pxp: lmx_arena_ref_cell(l2_pst, %uU)\n%sif: l2_pxp = 0\n", ind, (cast: (unsigned) slot), ind) < 0
            return: 1
        if: i + 1 = segs && kind != 4 && l2_emit_path_bail(mi, ind) != 0
            return: 1
        if: i + 1 = segs
            \out_kind: kind
        ---
        i: i + 1
    ---
return: 0

# Read-position field path, root \ field only (single hop): fresh\value, an
# ordinary formal's m\value, node\value, for\value, or a resolved method
# name's own\value (FABLE-SONNET-NODE-ROOT-20260923-121: node/for/an
# occurrence root are ordinary roots of this same dispatcher now, ni/root
# seeded by l2_path_kind's own l2_path_root call, nothing special needed
# here beyond widening this gate to admit them). FABLE-SONNET-FIELD-
# PATHS-20260923-113. A bound merge result is a root of the same kind (D-61,
# FABLE-OPUS-MERGE-PARTS-20260926-193): l2_path_root already resolves it and
# l2_path_kind/l2_emit_path walk its slot map, so `R\x` in an expression is
# the value `v: R\x` reads -- it used to be an unresolved name, or, for an
# all-caps R, a raw C name gcc refused. Returns -1 when left does not name an
# own field, a namespace-typed name, a merge result, node/for in a method
# other than E, or a method --
# not this mechanism's path. Once left DOES resolve this way, any later
# failure is a real error (1), never a silent fall-through: an unknown
# right or a non-primitive leaf ends in the same diagnostics l2_path_kind/
# l2_emit_path already give a write. Chained reads (a\b\c as a value, not
# an assignment target) are not wired here; only the write side
# (l2_emit_path's own per-segment loop) chains. No emission: shared by the
# check-time and emit-time callers.
fn: l2_field_path_check (int: mi; const: @(LmP0Text left); const: @(LmP0Text right); @: int out_kind) int
    c.array: [1024]: char buf
    size_t: n
    int: leaf_mi
    \out_kind: 0 - 1
    # A segment is a name: `merged\[N]x` is the occurrence branch's, not this one's.
    if: mi < 0 || left = 0 || right = 0 || left\data = 0 || right\data = 0 || l2_ident(right) = 0
        return: 0 - 1
    if: l2_own_find(mi, left) < 0 && l2_nsty_of_name(mi, left) < 0 && l2_mres_find(left) < 0 && l2_text_eq(left, "node") = 0 && l2_text_eq(left, "for") = 0
        return: 0 - 1
    if: left\length + right\length + 2U > 256U
        return: 1
    memcpy((cast: (@: void) buf), (cast: (@: void) left\data), left\length)
    buf[left\length]: 92
    memcpy((cast: (@: void) (buf + left\length + 1U)), (cast: (@: void) right\data), right\length)
    n: left\length + right\length + 1U
    \out_kind: l2_path_kind(buf, n, @ leaf_mi)
    if: \out_kind != 0 && \out_kind != 1 && \out_kind != 7 && \out_kind != 8 && \out_kind != 9 && \out_kind != 10 && \out_kind != 11
        return: 1
return: 0

fn: l2_field_path_read (int: mi; const: @(LmP0Text left); const: @(LmP0Text right); const: @(char ind); const: @(LmP0Node at); @: char dest) int
    c.array: [1024]: char buf
    size_t: n
    int: kind
    int: fpc
    int: t
    int: oty
    int: ent
    if: dest = 0
        return: 1
    fpc: l2_field_path_check(mi, left, right, @ kind)
    if: fpc != 0
        return: fpc
    if: left\length + right\length + 2U > 256U
        return: l2_error(l2_src, at, "expression too long")
    memcpy((cast: (@: void) buf), (cast: (@: void) left\data), left\length)
    buf[left\length]: 92
    memcpy((cast: (@: void) (buf + left\length + 1U)), (cast: (@: void) right\data), right\length)
    n: left\length + right\length + 1U
    if: l2_emit_path(buf, n, mi, ind, at, @ kind) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_xp: l2_pxp\n", ind) < 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    oty: l2_kind_cell_ty(kind)
    if: kind = 10 || kind = 11
        # A reference field leaf (FABLE-SONNET-SEND-REF-20260925-172 commit
        # 1, RESTORED in commit 4 after the author's ruling on Q26.2: a
        # slot holding a Structure's address directly makes that Structure
        # a CHILD of the holder; a reference (`@: T name`) is a reference
        # TO a reference, so the slot must hold a pointer CELL's address,
        # and reading it is l2_emit_cell_load's ordinary own-storage-cell
        # convention, one level removed from a bare primitive -- NOT a
        # direct deref of the slot itself (D-56's now-reverted shortcut,
        # which assumed the slot held the pointee directly; the letter's
        # OWN sender slot was the actual bug, not this kind's shape -- see
        # steps/send-ref-172.md commit 4). Its pointee code is not fixed
        # per kind the way a primitive's is, so re-derive it (l2_path_kind's
        # out_mi carries it for these two kinds) and convert formal/local
        # raw code -> own-storage code the same way any other declared
        # pointer own field does (l2_own_ty_of_param).
        ent: 0 - 1
        l2_path_kind(buf, n, @ ent)
        oty: l2_own_ty_of_param(ent)
    if: l2_emit_cell_load(oty, ind, t, at) != 0
        return: 1
    if: c.sprintf(dest, "l2_t%d", t) < 0
        return: 1
return: 0

# The value type a primitive field kind loads as (l2_emit_cell_load): size_t, char, int,
# unsigned, ulong; -1 for any other kind.
fn: l2_kind_cell_ty (int: kind) int
    if: kind = 0
        return: 2
    if: kind = 1
        return: 1
    if: kind = 7
        return: 0
    if: kind = 8
        return: 3
    if: kind = 9
        return: 36
return: 0 - 1

# `merged\[N]x`: occurrence N of field x of bound merge result res, read into a temp named in
# dest -- the slot through the unit (l2_emit_path_to's merge-result root), then the cell.
fn: l2_mrs_occ_read (int: res; const: @(LmP0Text name); int: occ; int: mi; const: @(char ind); @: char dest; const: @(LmP0Node at)) int
    int: kind 0 - 1
    int: ent 0 - 1
    int: slot
    int: t
    slot: l2_mrs_slot_nth(res, name, occ, @ kind, @ ent)
    if: slot < 0
        return: l2_error(l2_src, at, "merge occurrence index out of range")
    if: l2_kind_cell_ty(kind) < 0
        return: l2_error(l2_src, at, "a field path must end at a primitive field")
    if: c.fprintf(l2_out, "%sl2_pst: lmx_arena_ref_struct(%s, %uU)\n%sif: l2_pst = 0\n", ind, l2_unit_ref, (cast: (unsigned) (l2_mres_base + res)), ind) < 0
        return: 1
    if: l2_emit_path_bail(mi, ind) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_pxp: lmx_arena_ref_cell(l2_pst, %uU)\n%sif: l2_pxp = 0\n", ind, (cast: (unsigned) slot), ind) < 0
        return: 1
    if: l2_emit_path_bail(mi, ind) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_xp: l2_pxp\n", ind) < 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_emit_cell_load(l2_kind_cell_ty(kind), ind, t, at) != 0
        return: 1
    if: c.sprintf(dest, "l2_t%d", t) < 0
        return: 1
return: 0

# INDEXED FIELD PATHS (S3, FABLE-OPUS-S3-MAIL-ARGS-20260923-122 part 2b; author Q10/Q15):
# `root\seg...[k]` and `root\seg...[k][j]`, where the path ends at an Array field of a
# declared Structure type -- kind 5, a fixed Array of int/char (`[]: T x N`), one index
# within its declared count; kind 6, `T: []: []: x`, an Array of references to T Arrays,
# one index (an inner Array: only inside length()) or two (an element).  The root is a
# typed one -- an own field or formal of a declared Structure type, or a unit-level
# declaration -- the ones whose segments are that type's fields; node/for/method roots
# and raw C paths stay with their own machinery.  Indices are decimal literals: L2 checks
# no bounds at run time (L2 spec 18.3), so a program guards with length().

# A decimal literal index (digits only).  0 = one, its value in out_v.
fn: l2_dec_literal (const: @(LmP0Text t); @: size_t out_v) int
    size_t: v 0U
    size_t: i 0U
    size_t: digit
    if: t = 0 || t\data = 0 || t\length = 0U || out_v = 0
        return: 1
    while: i < t\length
        if: t\data[i] < 48 || t\data[i] > 57
            return: 1
        digit: (cast: (size_t) (t\data[i] - 48))
        if: v > (((cast: (size_t) -1) - digit) / 10U)
            return: 1
        v: v * 10U + digit
        i: i + 1U
    ---
    \out_v: v
return: 0

# The leaf of a typed field path that is an Array field: its kind (5/6), element (0 int,
# 1 char) and, for kind 5, the declared count.  1 = the root is not a typed one, or the
# path does not end at an Array field.
fn: l2_path_arr_leaf (const: @(char pd); size_t: pn; @: int out_kind; @: int out_elem; @: size_t out_count) int
    size_t: off 0U
    size_t: len 0U
    int: ni 0 - 1
    int: res 0 - 1
    int: oi 0 - 1
    int: root 0 - 1
    int: fi 0 - 1
    int: segs
    int: i 1
    int: slot
    int: kind 0 - 1
    int: ent 0 - 1
    \out_kind: 0 - 1
    \out_elem: 0 - 1
    \out_count: 0U
    if: l2_path_root(pd, pn, @ ni, @ res, @ oi, @ root, @ fi) != 0
        return: 1
    if: oi >= 0
        ni: l2_own_nsty_get(oi)
    if: ni < 0 || res >= 0 || root != 0 - 1
        return: 1
    segs: l2_seg_count(pd, pn)
    while: i < segs
        if: l2_seg_at(pd, pn, i, @ off, @ len) != 0 || len = 0U
            return: 1
        slot: l2_ns_slot_named(ni, pd, off, len, @ kind, @ ent)
        if: slot < 0
            return: 1
        if: i + 1 < segs && kind != 2 && kind != 3
            return: 1
        if: i + 1 = segs && kind != 5 && kind != 6
            return: 1
        if: i + 1 = segs
            \out_kind: kind
            \out_elem: ent
            \out_count: l2_ns_field_len(ni, slot)
        if: i + 1 < segs
            ni: ent
        i: i + 1
    ---
return: 0

# One indexed field-path operand starting at f.  0 = one: the path text (pd, out_pn), its
# token count and the field after it, the leaf's kind and element, the number of indices
# (allow0 admits none, for length()) and the literal indices.  1 = the tokens are not
# this route's (not a typed root, or no index).  2 = they are, but unsupported: the path
# does not end at an Array field, an index is not a decimal literal, a kind-5 index is
# outside its declared count, or there are more indices than the field has levels.
# 3 = the root is a graph with no declared Structure type.
fn: l2_arr_operand (@: LmP0Field f; int: allow0; @: char pd; @: size_t out_pn; @: int out_count; @@: LmP0Field out_after; @: int out_kind; @: int out_elem; @: int out_depth; @: size_t out_i0; @: size_t out_i1) int
    @: LmP0Field g
    @: LmP0Field nm
    @: LmP0Field idx
    @: LmP0Field cb
    size_t: pn 0U
    size_t: iv 0U
    size_t: i0 0U
    size_t: i1 0U
    size_t: count 0U
    int: n 1
    int: depth 0
    int: kind 0 - 1
    int: elem 0 - 1
    int: ni 0 - 1
    int: res 0 - 1
    int: oi 0 - 1
    int: root 0 - 1
    int: fi 0 - 1
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || f\value\as\atom = 0 || l2_ident(f\value\as\atom) = 0 || pd = 0
        return: 1
    if: f\value\as\atom\length > 200U
        return: 1
    memcpy((cast: (@: void) pd), (cast: (@: void) f\value\as\atom\data), f\value\as\atom\length)
    pn: f\value\as\atom\length
    g: l2_next_active(f\next)
    while: g != 0 && g\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM && g\value\as != 0 && l2_is_slash(g\value\as\atom)
        nm: l2_next_active(g\next)
        if: nm = 0 || nm\value = 0 || nm\value\kind != c.LM_P0_NODE_ATOM || nm\value\as = 0 || l2_ident(nm\value\as\atom) = 0
            return: 1
        if: pn + 1U + nm\value\as\atom\length > 250U
            return: 1
        pd[pn]: 92
        memcpy((cast: (@: void) (pd + pn + 1U)), (cast: (@: void) nm\value\as\atom\data), nm\value\as\atom\length)
        pn: pn + 1U + nm\value\as\atom\length
        n: n + 2
        g: l2_next_active(nm\next)
    ---
    if: n < 3
        return: 1
    if: allow0 = 0 && (g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || g\value\as = 0 || l2_text_eq(g\value\as\atom, "[") = 0)
        return: 1
    if: l2_path_root(pd, pn, @ ni, @ res, @ oi, @ root, @ fi) != 0
        return: 1
    if: oi >= 0
        ni: l2_own_nsty_get(oi)
    # An own field holding a graph with no declared type (the letter receiveMessage gives an
    # untyped m): the path has no fields to walk.  A c.* raw root is not a graph and is left
    # to the raw-path machinery.
    if: oi >= 0 && ni < 0 && l2_colon_is_graph_ty(l2_dt_of_own(l2_own_ty[oi])) != 0
        return: 3
    if: ni < 0 || res >= 0 || root != 0 - 1
        return: 1
    # A typed root: from here the tokens are this route's, and a failure is its to report.
    if: l2_path_arr_leaf(pd, pn, @ kind, @ elem, @ count) != 0
        return: 2
    while: g != 0 && g\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM && g\value\as != 0 && l2_text_eq(g\value\as\atom, "[")
        idx: l2_next_active(g\next)
        if: idx = 0 || idx\value = 0 || idx\value\kind != c.LM_P0_NODE_ATOM || idx\value\as = 0 || l2_dec_literal(idx\value\as\atom, @ iv) != 0
            return: 2
        cb: l2_next_active(idx\next)
        if: cb = 0 || cb\value = 0 || cb\value\kind != c.LM_P0_NODE_ATOM || cb\value\as = 0 || l2_text_eq(cb\value\as\atom, "]") = 0
            return: 2
        depth: depth + 1
        if: depth = 1
            i0: iv
        if: depth = 2
            i1: iv
        n: n + 3
        g: l2_next_active(cb\next)
    ---
    if: (kind = 5 && depth > 1) || (kind = 6 && depth > 2)
        return: 2
    if: kind = 5 && depth = 1 && i0 >= count
        return: 2
    \out_pn: pn
    \out_count: n
    \out_after: g
    \out_kind: kind
    \out_elem: elem
    \out_depth: depth
    \out_i0: i0
    \out_i1: i1
return: 0

# Emit an indexed operand: walk to the Array field's cell, take its descriptor and index
# it.  An element leaves dest an lvalue in the Array's own backing -- `l2_cpN[k]` -- so
# `@` before it addresses the element in graph storage (L2 spec 18.2), never a copy.  With
# want_len, dest is a size_t temporary holding the addressed Array's length.  A null
# descriptor takes the path's ordinary bail.
fn: l2_emit_arr_operand (int: mi; const: @(char pd); size_t: pn; int: kind; int: elem; int: depth; size_t: i0; size_t: i1; int: want_len; const: @(char ind); const: @(LmP0Node at); @: char dest) int
    int: t
    int: k 0
    const: @(char ety) "int"
    if: dest = 0
        return: 1
    if: elem = 1
        ety: "char"
    if: l2_emit_path_to(pd, pn, mi, ind, at, @ k, 1) != 0
        return: 1
    if: k != kind
        return: l2_error(l2_src, at, "internal: the indexed path changed its leaf")
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.fprintf(l2_out, "%s@: LmxArrayDesc l2_ao%d (cast: (@: LmxArrayDesc) l2_pxp[0])\n%sif: l2_ao%d = 0\n", ind, t, ind, t) < 0
        return: 1
    if: l2_emit_path_bail(mi, ind) != 0
        return: 1
    if: want_len != 0 && depth = 0
        if: c.fprintf(l2_out, "%ssize_t: l2_t%d\n%sl2_t%d: l2_ao%d\\len\n", ind, t, ind, t, t) < 0
            return: 1
        return: l2_tok_temp(t, dest)
    ---
    if: kind = 5
        if: c.fprintf(l2_out, "%s@: %s l2_cp%d (cast: (@: %s) l2_ao%d\\data)\n", ind, ety, t, ety, t) < 0
            return: 1
        if: c.sprintf(dest, "l2_cp%d[%zuU]", t, i0) < 0
            return: 1
        return: 0
    ---
    if: c.fprintf(l2_out, "%s@@: void l2_as%d (cast: (@@: void) l2_ao%d\\data)\n%s@: LmxArrayDesc l2_ai%d (cast: (@: LmxArrayDesc) l2_as%d[%zuU])\n%sif: l2_ai%d = 0\n", ind, t, t, ind, t, t, i0, ind, t) < 0
        return: 1
    if: l2_emit_path_bail(mi, ind) != 0
        return: 1
    if: want_len != 0
        if: c.fprintf(l2_out, "%ssize_t: l2_t%d\n%sl2_t%d: l2_ai%d\\len\n", ind, t, ind, t, t) < 0
            return: 1
        return: l2_tok_temp(t, dest)
    ---
    if: c.fprintf(l2_out, "%s@: %s l2_cp%d (cast: (@: %s) l2_ai%d\\data)\n", ind, ety, t, ety, t) < 0
        return: 1
    if: c.sprintf(dest, "l2_cp%d[%zuU]", t, i1) < 0
        return: 1
return: 0

# length() of an indexed-route Array: `length(P)` (kind 5 or 6) or `length(P[k])` (the
# inner Array of kind 6).  0 = this route's and well formed; 1 = not this route's; 2 = its,
# but not an Array (an element, or a wrong shape).
fn: l2_arr_len_shape (const: @(LmP0Node node); @: char pd; @: size_t out_pn; @: int out_kind; @: int out_elem; @: int out_depth; @: size_t out_i0) int
    @: LmP0Field first
    @: LmP0Field after
    int: n
    int: cnt 0
    int: kind 0 - 1
    int: elem 0 - 1
    int: depth 0
    size_t: pn 0U
    size_t: i0 0U
    size_t: i1 0U
    int: st
    if: node = 0 || l2_frame_head(node, "length") = 0 || node\as\frame\trailer != 0 || node\as\frame\body = 0 || node\as\frame\body\trailer != 0
        return: 1
    first: l2_next_active(node\as\frame\body\first_field)
    n: l2_count_active(node\as\frame\body)
    st: l2_arr_operand(first, 1, pd, @ pn, @ cnt, @ after, @ kind, @ elem, @ depth, @ i0, @ i1)
    if: st != 0
        return: st
    if: cnt != n || after != 0
        return: 2
    if: depth != 0 && (kind != 6 || depth != 1)
        return: 2
    \out_pn: pn
    \out_kind: kind
    \out_elem: elem
    \out_depth: depth
    \out_i0: i0
return: 0

# The number of tokens of consecutive `[ x ]` groups starting at f (0 if none), and the
# field after them: `a[i][j]` is one operand, not an operand and a stray `[j]`.
fn: l2_index_chain (@: LmP0Field f; @@: LmP0Field out_after) int
    @: LmP0Field idx
    @: LmP0Field cb
    int: n 0
    \out_after: f
    while: f != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && f\value\as != 0 && l2_text_eq(f\value\as\atom, "[")
        idx: l2_next_active(f\next)
        if: idx = 0
            return: n
        cb: l2_next_active(idx\next)
        if: cb = 0 || cb\value = 0 || cb\value\kind != c.LM_P0_NODE_ATOM || cb\value\as = 0 || l2_text_eq(cb\value\as\atom, "]") = 0
            return: n
        n: n + 3
        f: l2_next_active(cb\next)
        \out_after: f
    ---
return: n

# The former l2_slash_own/l2_slash_for shape (root \ name[...]) refuses
# unconditionally now, node/for included (FABLE-SONNET-NODE-ROOT-20260923-
# 121, author Q9): a root's suffix must denote an Array-typed field of the
# root's TYPE (FABLE-SONNET-ARRAY-WRITE-DISPATCH-20260923-119's rule),
# never a same-named sibling in mi's own table, whether the root is
# literally node/for or any other own-field/formal name -- neither is a
# spelling gate onto mi's own table anymore. Resolving right as a genuine
# Array-typed field of left's type through the namespace slots is a new
# capability (the field lives through l2_own_nsty_get/l2_ns_slot_named on
# left's type, not in mi's own table at all) no ticket has built yet.
# Refusing is the honest state; the caller's fallback (the ordinary
# field-path machinery) gives "unsupported index" for this shape.
fn: l2_own_array_root (int: mi; const: @(LmP0Text left); const: @(LmP0Text right)) int
return: 0 - 1

fn: l2_ns_field_ref (int: ni; int: j) int
    int: k 0
    int: slotix 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni
            if: slotix = j
                if: l2_nsf_kind[k] = 3
                    return: l2_nsf_ref[k]
                return: 0 - 1
            slotix: slotix + 1
        k: k + 1
    ---
return: 0 - 1

# The slot of the first reference field of ni that names t, or -1.
fn: l2_ns_slot_of_ref (int: ni; int: t) int
    int: k 0
    int: slotix 0
    while: k < l2_nsf_n
        if: l2_nsf_owner[k] = ni
            if: l2_nsf_kind[k] = 3 && l2_nsf_ref[k] = t
                return: slotix
            slotix: slotix + 1
        k: k + 1
    ---
return: 0 - 1

# How many declarations, at any level, carry this name.
fn: l2_ns_count_named (const: @(LmP0Text t)) int
    int: i 0
    int: r 0
    while: i < l2_ns_n
        if: l2_text_same(l2_ns_name[i], t)
            r: r + 1
        i: i + 1
    ---
return: r

# Second phase of construction: every reference field is resolved once the whole
# unit has been read. A target may appear later in the source, may be the
# referring declaration itself, may enclose it, or may be a nested declaration:
# the graph admits aliases and cycles, and the copier carries them through one
# operation-local map. Only an unknown name, or one carried by more than one
# declaration, is an error.
fn: l2_ns_resolve_refs (const: @(char path); const: @(LmP0Node at)) int
    int: k 0
    int: n
    while: k < l2_nsf_n
        if: l2_nsf_kind[k] = 3
            n: l2_ns_count_named(l2_nsf_name[k])
            if: n = 0
                return: l2_error(path, at, "unknown nested Structure reference")
            if: n > 1
                return: l2_error(path, at, "ambiguous nested Structure reference")
            l2_nsf_ref[k]: l2_ns_find(l2_nsf_name[k])
            # Qualification admits an ADDRESS RANGE, not a promise. A reference
            # out of a qualified branch into ordinary mutable storage would make
            # a reclaimable target reachable as a terminal, so it is refused
            # here rather than admitted and regretted.
            if: l2_ns_eternal[l2_nsf_owner[k]] >= 0 && l2_ns_eternal[l2_nsf_ref[k]] < 0
                return: l2_error(path, at, "an eternal branch cannot reference mutable storage")
            ---
        if: l2_nsf_kind[k] = 4
            n: l2_find_method(l2_nsf_name[k])
            if: n < 0
                return: l2_error(path, at, "unknown callable field")
            if: l2_ns_eternal[l2_nsf_owner[k]] >= 0
                return: l2_error(path, at, "an eternal branch cannot hold a callable field")
            l2_nsf_ref[k]: n
        k: k + 1
    ---
return: 0

fn: l2_take_named (const: @(LmP0Node item); const: @(char path)) int
    if: item = 0 || item\as = 0 || item\as\frame = 0 || item\as\frame\body = 0
        return: l2_error(path, item, "unsupported body")
    if: l2_ident(item\as\frame\head) = 0
        return: l2_error(path, item, "unsupported body")
    if: l2_fn_close(item\as\frame, item\as\frame\head, 0) != 0
        return: l2_error(path, item, "end target does not match close target")
    if: l2_ns_find(item\as\frame\head) >= 0 && l2_ns_eternal[l2_ns_find(item\as\frame\head)] >= 0
        return: l2_error(path, item, "named Structure collides with a qualified branch")
    if: l2_ns_find(item\as\frame\head) >= 0
        return: l2_error(path, item, "duplicate named Structure")
    if: l2_ebr_find(item\as\frame\head) >= 0
        return: l2_error(path, item, "named Structure collides with a qualified branch")
    if: l2_find_method(item\as\frame\head) >= 0
        return: l2_error(path, item, "named Structure collides with a method")
return: l2_take_ns_body(item\as\frame\head, 0 - 1, item\as\frame\body, item, path)

fn: l2_take_eternal (const: @(LmP0Node item); const: @(char path)) int
    @: LmP0Node cur
    @: LmP0Node body
    @: LmP0Field f
    int: root
    cur: (cast: (@: LmP0Node) item)
    if: l2_frame_head(cur, "independent") = 0 || cur\as = 0 || cur\as\frame = 0 || cur\as\frame\body = 0
        return: l2_error(path, item, "unsupported body")
    if: l2_count_active(cur\as\frame\body) != 1
        return: l2_error(path, item, "independent takes one qualified construction")
    cur: l2_next_active(cur\as\frame\body\first_field)\value
    if: l2_frame_head(cur, "const") = 0 || cur\as = 0 || cur\as\frame = 0 || cur\as\frame\body = 0 || l2_count_active(cur\as\frame\body) != 1
        return: l2_error(path, item, "independent branch requires const")
    cur: l2_next_active(cur\as\frame\body\first_field)\value
    if: l2_frame_head(cur, "immutable") = 0 || cur\as = 0 || cur\as\frame = 0 || cur\as\frame\body = 0 || l2_count_active(cur\as\frame\body) != 1
        return: l2_error(path, item, "independent branch requires immutable")
    cur: l2_next_active(cur\as\frame\body\first_field)\value
    if: l2_frame_head(cur, "()") = 0 || cur\as = 0 || cur\as\frame = 0 || cur\as\frame\body = 0
        return: l2_error(path, item, "independent qualifies Structure construction")
    if: l2_count_active(cur\as\frame\body) != 2
        return: l2_error(path, item, "eternal branch takes a name and a body")
    f: l2_next_active(cur\as\frame\body\first_field)
    if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f\value\as\atom) = 0
        return: l2_error(path, item, "eternal branch needs a name")
    body: l2_next_active(f\next)\value
    # The construction body arrives as a structure block, exactly like a fn
    # body. Its FIELDS are the ordinary named-Structure field model: size_t and
    # char leaves, inline nested Structures, and translation-known references.
    # Qualification decides storage admission and immutability, not shape.
    if: body = 0 || body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0 || body\as\structure = 0
        return: l2_error(path, item, "eternal branch takes a body block")
    if: l2_ns_find(f\value\as\atom) >= 0
        return: l2_error(path, item, "duplicate named Structure")
    if: l2_find_method(f\value\as\atom) >= 0
        return: l2_error(path, item, "named Structure collides with a method")
    if: l2_ebr_reserve(l2_ebr_n + 1) != 0
        return: l2_error(path, item, "out of memory")
    root: l2_ns_n
    if: l2_take_ns_body((cast: (@: LmP0Text) f\value\as\atom), 0 - 1, body\as\structure, item, path) != 0
        return: 1
    # Every entry the body created -- the root and each nested Structure --
    # belongs to this branch.
    while: root < l2_ns_n
        l2_ns_eternal[root]: l2_ebr_n
        root: root + 1
    ---
    l2_ebr_name[l2_ebr_n]: (cast: (@: LmP0Text) f\value\as\atom)
    l2_ebr_at[l2_ebr_n]: (cast: (@: LmP0Node) item)
    l2_ebr_leaf[l2_ebr_n]: 0
    l2_ebr_val[l2_ebr_n]: 0U
    l2_ebr_n: l2_ebr_n + 1
return: 0

fn: l2_end_text (const: @(LmP0Frame frame); const: @(LmP0Text name)) int
    @: LmP0Field field
    if: frame = 0 || frame\trailer = 0 || name = 0
        return: 0
    if: l2_text_eq(frame\trailer\spelling, "end") = 0
        return: 0
    if: frame\trailer\body = 0
        return: 0
    field: l2_next_active(frame\trailer\body\first_field)
    if: field = 0 || l2_next_active(field\next) != 0
        return: 0
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
return: l2_text_same(field\value\as\atom, name)

fn: l2_int_formal (const: @(LmP0Node node); const: @(char path); @@: LmP0Text out_name) int
    @: LmP0Field f
    if: out_name = 0
        return: l2_error(path, node, "incompatible entry signature")
    \out_name: 0
    if: node = 0 || node\as = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_frame_head(node, "int") = 0 && l2_frame_head(node, "char") = 0 && l2_frame_head(node, "size_t") = 0 && l2_frame_head(node, "unsigned") = 0 && l2_frame_head(node, "ulong") = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: node\as\frame\body = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\body\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: l2_count_active(node\as\frame\body) != 1
        return: l2_error(path, node, "incompatible entry signature")
    f: l2_next_active(node\as\frame\body\first_field)
    if: f\value = 0 || f\value\as = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_ident(f\value\as\atom) = 0
        return: l2_error(path, node, "incompatible entry signature")
    \out_name: f\value\as\atom
return: 0

fn: l2_typed_formal (const: @(LmP0Node node); const: @(char path); @@: LmP0Text out_name; @: int out_ty) int
    @: LmP0Field f
    @: LmP0Field g
    const: @: LmP0Node inner
    int: depth
    int: req_mi
    l2_last_cf_req: 0 - 1
    if: out_ty = 0 || out_name = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node != 0 && node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\head != 0 && l2_ns_find(node\as\frame\head) >= 0
        if: node\as\frame\trailer != 0 || node\as\frame\body = 0 || node\as\frame\body\trailer != 0 || l2_count_active(node\as\frame\body) != 1
            return: l2_error(path, node, "incompatible entry signature")
        f: l2_next_active(node\as\frame\body\first_field)
        if: f = 0 || f\value = 0 || f\value\as = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f\value\as\atom) = 0
            return: l2_error(path, node, "incompatible entry signature")
        \out_name: f\value\as\atom
        \out_ty: l2_colon_graph_ty()
        if: \out_ty < 100
            return: l2_error(path, node, "out of memory")
        return: 0
    if: l2_frame_head(node, "int")
        \out_ty: 0
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "char")
        \out_ty: 1
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "size_t")
        \out_ty: 2
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "unsigned")
        \out_ty: 34
        return: l2_int_formal(node, path, out_name)
    if: l2_frame_head(node, "ulong")
        \out_ty: 36
        return: l2_int_formal(node, path, out_name)
    depth: 0
    if: node != 0 && node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0
        depth: l2_address_depth(node\as\frame\head)
    if: depth > 2
        if: node\as\frame\body = 0 || l2_count_active(node\as\frame\body) != 2
            return: l2_error(path, node, "incompatible entry signature")
        f: l2_next_active(node\as\frame\body\first_field)
        g: l2_next_active(f\next)
        if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
            return: l2_error(path, node, "incompatible entry signature")
        if: l2_resolve_type_atom(f\value\as\atom, depth, 0, out_ty) != 0
            return: l2_error(path, f\value, "unknown type")
        \out_name: g\value\as\atom
        return: 0
    if: l2_frame_head(node, "@@")
        if: node\as\frame\body = 0 || l2_count_active(node\as\frame\body) != 2
            return: l2_error(path, node, "incompatible entry signature")
        f: l2_next_active(node\as\frame\body\first_field)
        g: l2_next_active(f\next)
        if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, node, "incompatible entry signature")
        if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
            return: l2_error(path, node, "incompatible entry signature")
        # FABLE-SONNET-TYPE-WORD-FOLD-20260924-162 commit 2: the six core words
        # (char/void/int/unsigned/ulong/size_t) via the shared pointer-local table;
        # this formal's own extra named kernel types stay here, not in the shared
        # function (l2_ptr_local_ty/l2_own_array_pointer_ty never recognized them).
        if: l2_ptr_type_word(f\value\as\atom, 2, out_ty) = 0
            \out_name: g\value\as\atom
            return: 0
        # D-42 FIXED (steps/defects.md): the LmxMsgBlock branch below was missing
        # its own return: 0 (fell through into the LmxArenaBlock check instead of
        # returning with ty=26 immediately), and LmxArenaBlock's branch carried a
        # stray doubled return: 0 right after it -- one line landed one if: block
        # too high. Fixed in place, not folded into the shared function (only this
        # site names these two kernel block types).
        if: l2_text_eq(f\value\as\atom, "LmxMsgBlock")
            \out_ty: 26
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "LmxArenaBlock")
            \out_ty: 26
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "LmxOwnedRange")
            \out_ty: 27
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "LmxMsgCopy")
            \out_ty: 31
            \out_name: g\value\as\atom
            return: 0
        if: l2_resolve_type_atom(f\value\as\atom, 2, 0, out_ty) != 0
            return: l2_error(path, f\value, "unknown type")
        \out_name: g\value\as\atom
        return: 0
    if: l2_frame_head(node, "@")
        if: node\as\frame\body = 0 || l2_count_active(node\as\frame\body) != 2
            return: l2_error(path, node, "incompatible entry signature")
        f: l2_next_active(node\as\frame\body\first_field)
        g: l2_next_active(f\next)
        if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, node, "incompatible entry signature")
        if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
            return: l2_error(path, node, "incompatible entry signature")
        # FABLE-SONNET-TYPE-WORD-FOLD-20260924-162 commit 2: the six core words
        # via the shared pointer-local table (below, L2ImmutQuery is this
        # formal's own extra case, unchanged).
        if: l2_ptr_type_word(f\value\as\atom, 1, out_ty) = 0
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "L2ImmutQuery") = 0
            if: l2_resolve_type_atom(f\value\as\atom, 1, 0, out_ty) != 0
                return: l2_error(path, f\value, "unknown type")
            \out_name: g\value\as\atom
            return: 0
        if: l2_text_eq(f\value\as\atom, "L2ImmutQuery")
            l2_need_query: 1
            \out_ty: 7
        \out_name: g\value\as\atom
        return: 0
    # Callable formal `Method: name`: resolve method head before foreign-by-value.
    # Graph type is @: Lmx; required method identity is retained in l2_last_cf_req.
    if: l2_frame_head(node, "const") = 0 && depth = 0 && node != 0 && node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\head != 0 && node\as\frame\trailer = 0 && node\as\frame\body != 0 && node\as\frame\body\trailer = 0 && l2_count_active(node\as\frame\body) = 1
        f: l2_next_active(node\as\frame\body\first_field)
        if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f\value\as\atom) = 0
            return: l2_error(path, node, "incompatible entry signature")
        req_mi: l2_find_method(node\as\frame\head)
        if: req_mi >= 0
            \out_ty: l2_colon_graph_ty()
            if: \out_ty < 100
                return: l2_error(path, node, "out of memory")
            \out_name: f\value\as\atom
            l2_last_cf_req: req_mi
            return: 0
        ---
        # A by-value formal of a foreign type, `c.T: name` (Stage B). Bare T is unknown type.
        \out_ty: l2_foreign_byvalue(node\as\frame\head)
        if: \out_ty < 100
            return: l2_error(path, node, "unknown type")
        \out_name: f\value\as\atom
        return: 0
    if: l2_frame_head(node, "const") = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: node\as\frame\body = 0 || l2_count_active(node\as\frame\body) != 1
        return: l2_error(path, node, "incompatible entry signature")
    inner: l2_next_active(node\as\frame\body\first_field)\value
    if: inner = 0 || inner\kind != c.LM_P0_NODE_FRAME || inner\as = 0 || inner\as\frame = 0
        return: l2_error(path, node, "incompatible entry signature")
    depth: l2_address_depth(inner\as\frame\head)
    if: depth = 0 || inner\as\frame\body = 0
        return: l2_error(path, node, "incompatible entry signature")
    if: l2_count_active(inner\as\frame\body) != 2 && l2_count_active(inner\as\frame\body) != 3
        return: l2_error(path, node, "incompatible entry signature")
    f: l2_next_active(inner\as\frame\body\first_field)
    g: l2_next_active(f\next)
    if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, node, "incompatible entry signature")
    if: depth != 1
        if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
            return: l2_error(path, node, "incompatible entry signature")
        if: l2_resolve_type_atom(f\value\as\atom, depth, 1, out_ty) != 0
            return: l2_error(path, f\value, "unknown type")
        \out_name: g\value\as\atom
        return: 0
    if: l2_kernel_ptr_word(f\value\as\atom, out_ty) != 0
        if: l2_resolve_type_atom(f\value\as\atom, 1, 1, out_ty) != 0
            return: l2_error(path, f\value, "unknown type")
        \out_name: g\value\as\atom
        return: 0
    if: g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_ident(g\value\as\atom) = 0
        return: l2_error(path, node, "incompatible entry signature")
    \out_name: g\value\as\atom
return: 0

# Type nodes of a complete declaration, compared on the translator Structure
# (kind, frame head, active fields). Not a source-line heuristic.
fn: l2_type_nodes_same (const: @(LmP0Node a); const: @(LmP0Node b)) int
    @: LmP0Field fa
    @: LmP0Field fb
    if: a = 0 && b = 0
        return: 1
    if: a = 0 || b = 0
        return: 0
    if: a\kind != b\kind
        return: 0
    if: a\kind = c.LM_P0_NODE_ATOM
        if: a\as = 0 || b\as = 0
            return: 0
        return: l2_text_same(a\as\atom, b\as\atom)
    if: a\kind = c.LM_P0_NODE_FRAME
        if: a\as = 0 || b\as = 0 || a\as\frame = 0 || b\as\frame = 0
            return: 0
        if: l2_text_same(a\as\frame\head, b\as\frame\head) = 0
            return: 0
        if: a\as\frame\body = 0 && b\as\frame\body = 0
            return: 1
        if: a\as\frame\body = 0 || b\as\frame\body = 0
            return: 0
        if: l2_count_active(a\as\frame\body) != l2_count_active(b\as\frame\body)
            return: 0
        fa: l2_next_active(a\as\frame\body\first_field)
        fb: l2_next_active(b\as\frame\body\first_field)
        while: fa != 0 && fb != 0
            if: l2_type_nodes_same(fa\value, fb\value) = 0
                return: 0
            fa: l2_next_active(fa\next)
            fb: l2_next_active(fb\next)
        ---
        return: 1
    if: a\kind = c.LM_P0_NODE_STRUCTURE
        if: a\as = 0 || b\as = 0 || a\as\structure = 0 || b\as\structure = 0
            return: 0
        if: l2_count_active(a\as\structure) != l2_count_active(b\as\structure)
            return: 0
        fa: l2_next_active(a\as\structure\first_field)
        fb: l2_next_active(b\as\structure\first_field)
        while: fa != 0 && fb != 0
            if: l2_type_nodes_same(fa\value, fb\value) = 0
                return: 0
            fa: l2_next_active(fa\next)
            fb: l2_next_active(fb\next)
        ---
        return: 1
return: 0

# A definition has a return trailer (one-line column-0 return) or a Structure
# body field. A complete declaration with neither is a forward or an import.
fn: l2_fn_defined (const: @(LmP0Node fn_node)) int
    @: LmP0Field field
    int: is_sub 0
    if: fn_node = 0 || fn_node\as = 0 || fn_node\as\frame = 0
        return: 0
    if: l2_frame_head(fn_node, "sub")
        is_sub: 1
    if: l2_frame_head(fn_node, "fn") = 0 && is_sub = 0
        return: 0
    if: l2_ret_tr(fn_node\as\frame) != 0
        return: 1
    if: fn_node\as\frame\body = 0
        return: 0
    field: l2_next_active(fn_node\as\frame\body\first_field)
    if: field = 0
        return: 0
    field: l2_next_active(field\next)
    if: field = 0
        return: 0
    if: is_sub = 0
        field: l2_next_active(field\next)
        if: field = 0
            return: 0
        ---
    field: l2_next_active(field\next)
    if: field = 0 || field\value = 0
        return: 0
    if: field\value\kind != c.LM_P0_NODE_STRUCTURE || field\value\as = 0
        return: 0
return: 1

fn: l2_params_types_same (const: @(LmP0Node a); const: @(LmP0Node b); const: @(char path); @: int out_same) int
    @: LmP0Field fa
    @: LmP0Field fb
    @: LmP0Text na 0
    @: LmP0Text nb 0
    int: ta 0
    int: tb 0
    if: out_same = 0
        return: 1
    \out_same: 0
    if: a = 0 || b = 0 || a\kind != c.LM_P0_NODE_STRUCTURE || b\kind != c.LM_P0_NODE_STRUCTURE || a\as = 0 || b\as = 0
        return: 0
    if: l2_count_active(a\as\structure) != l2_count_active(b\as\structure)
        return: 0
    fa: l2_next_active(a\as\structure\first_field)
    fb: l2_next_active(b\as\structure\first_field)
    while: fa != 0 && fb != 0
        na: 0
        nb: 0
        ta: 0
        tb: 0
        if: l2_typed_formal(fa\value, path, @ na, @ ta) != 0
            return: 1
        if: l2_typed_formal(fb\value, path, @ nb, @ tb) != 0
            return: 1
        if: ta != tb
            return: 0
        fa: l2_next_active(fa\next)
        fb: l2_next_active(fb\next)
    ---
    \out_same: 1
return: 0

fn: l2_unit_defined_fn (const: @(LmP0Node self); const: @(LmP0Text name)) @: LmP0Node
    @: LmP0Field field
    @: LmP0Node item
    @: LmP0Text nm
    if: l2_cur_unit = 0 || name = 0
        return: 0
    field: l2_next_active(l2_cur_unit\first_field)
    while: field != 0
        item: field\value
        if: item != self && (l2_frame_head(item, "fn") != 0 || l2_frame_head(item, "sub") != 0)
            nm: l2_os_fn_name(item)
            if: nm != 0 && l2_text_same(nm, name) != 0 && l2_fn_defined(item) != 0
                return: item
            ---
        ---
        field: l2_next_active(field\next)
    ---
return: 0

fn: l2_bind_same_unit_forward (const: @(LmP0Node fn_node); const: @(LmP0Text name); int: is_sub; const: @(LmP0Node params); const: @(LmP0Node ret_node); const: @(char path); @: int out_bound) int
    @: LmP0Node other
    @: LmP0Field field
    @: LmP0Node oparams 0
    @: LmP0Node oret 0
    int: osub 0
    int: same 0
    if: out_bound = 0
        return: 1
    \out_bound: 0
    other: l2_unit_defined_fn(fn_node, name)
    if: other = 0
        return: 0
    if: l2_frame_head(other, "sub")
        osub: 1
    if: osub != is_sub
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: other\as = 0 || other\as\frame = 0 || other\as\frame\body = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(other\as\frame\body\first_field)
    if: field = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    field: l2_next_active(field\next)
    if: field = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    oparams: field\value
    if: is_sub = 0
        field: l2_next_active(field\next)
        if: field = 0
            return: l2_error(path, fn_node, "incompatible entry signature")
        oret: field\value
        ---
    if: l2_params_types_same(params, oparams, path, @ same) != 0
        return: 1
    if: same = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: is_sub = 0 && l2_type_nodes_same(ret_node, oret) = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    \out_bound: 1
return: 0

# The named Structure a reference declaration `@: T name` points at, or -1 (D-76).
fn: l2_ref_formal_ns (const: @(LmP0Node decl)) int
    @: LmP0Field f
    if: l2_frame_head(decl, "@") = 0 || decl\as\frame\body = 0 || l2_count_active(decl\as\frame\body) != 2
        return: 0 - 1
    f: l2_next_active(decl\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 0 - 1
return: l2_ns_find(f\value\as\atom)

fn: l2_collect_method (const: @(LmP0Node fn_node); const: @(char path)) int
    @: LmP0Field field
    const: @: LmP0Frame fr
    const: @: LmP0Node params
    const: @: LmP0Node body
    @: LmP0Field p
    @: LmP0Text fa 0
    @: LmP0Text nm 0
    unsigned: id
    int: ar
    int: j
    int: ty
    int: k
    int: is_sub 0
    int: sn 0
    int: return_depth 0
    int: bound 0
    const: @: LmP0Node rty
    const: @: LmP0Node rbase
    const: @: LmP0Node ret_node
    if: fn_node = 0 || fn_node\as = 0 || fn_node\as\frame = 0
        return: l2_error(path, fn_node, "unsupported body")
    if: l2_m_n >= c.INT_MAX
        l2_alloc_err: 2
        return: l2_error(path, fn_node, "size overflow")
    if: l2_meth_reserve(l2_m_n + 1) != 0
        if: l2_alloc_err = 2
            return: l2_error(path, fn_node, "size overflow")
        return: l2_error(path, fn_node, "out of memory")
    fr: fn_node\as\frame
    if: l2_frame_head(fn_node, "sub")
        is_sub: 1
    k: 0
    if: fr\body != 0
        k: l2_count_active(fr\body)
    if: is_sub = 0 && k != 4 && k != 3
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: is_sub != 0 && k != 3 && k != 2
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: fr\body\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    field: l2_next_active(fr\body\first_field)
    if: field\value = 0 || field\value\as = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: l2_ident(field\value\as\atom) = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    nm: field\value\as\atom
    if: fr\trailer != 0 && l2_text_eq(fr\trailer\spelling, "end") = 0 && l2_text_eq(fr\trailer\spelling, "return") = 0
        return: l2_error(path, fn_node, "unsupported trailer")
    if: is_sub = 0 && l2_fn_close(fr, nm, "fn") != 0
        return: l2_error(path, fn_node, "end target does not match close target")
    if: is_sub != 0 && l2_fn_close(fr, nm, "sub") != 0
        return: l2_error(path, fn_node, "end target does not match close target")
    if: l2_find_method(nm) >= 0
        return: l2_error(path, fn_node, "duplicate definition")
    if: nm\length >= 63U
        return: l2_error(path, fn_node, "name too long")
    field: l2_next_active(field\next)
    params: field\value
    if: params = 0 || params\kind != c.LM_P0_NODE_STRUCTURE || params\as = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: params\as\structure\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    ar: l2_count_active(params\as\structure)
    if: ar < 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    if: l2_formals_alloc(l2_m_n, ar) != 0
        if: l2_alloc_err = 2
            return: l2_error(path, fn_node, "size overflow")
        return: l2_error(path, fn_node, "out of memory")
    p: l2_next_active(params\as\structure\first_field)
    j: 0
    while: j < ar
        ty: 0
        fa: 0
        if: p = 0 || l2_typed_formal(p\value, path, @ fa, @ ty) != 0
            l2_free_method(l2_m_n)
            return: 1
        if: fa = 0 || fa\length >= 63U
            l2_free_method(l2_m_n)
            return: l2_error(path, fn_node, "name too long")
        k: 0
        while: k < j
            if: l2_text_same(fa, l2_fn(l2_m_n, k))
                l2_free_method(l2_m_n)
                return: l2_error(path, p\value, "duplicate formal")
            k: k + 1
        if: l2_fn_set(l2_m_n, j, fa) != 0 || l2_ft_set(l2_m_n, j, ty) != 0
            l2_free_method(l2_m_n)
            return: l2_error(path, fn_node, "out of memory")
        if: l2_last_cf_req >= 0
            if: l2_cf_set(l2_m_n, j, l2_last_cf_req) != 0
                l2_free_method(l2_m_n)
                return: l2_error(path, fn_node, "out of memory")
            ---
            l2_last_cf_req: 0 - 1
        ---
        if: p\value != 0 && p\value\kind = c.LM_P0_NODE_FRAME && p\value\as != 0 && p\value\as\frame != 0 && l2_ns_find(p\value\as\frame\head) >= 0
            if: l2_nsty_set(l2_m_n, j, l2_ns_find(p\value\as\frame\head)) != 0
                l2_free_method(l2_m_n)
                return: l2_error(path, fn_node, "out of memory")
            ---
        ---
        # A reference formal `@: T name` to a named Structure T (D-76): its value is the Structure
        # (`@: Lmx`, one level), so its type is T for a path through it, as `T: name`'s is.
        if: l2_ref_formal_ns(p\value) >= 0
            if: l2_nsty_set(l2_m_n, j, l2_ref_formal_ns(p\value)) != 0
                l2_free_method(l2_m_n)
                return: l2_error(path, fn_node, "out of memory")
            ---
        ---
        p: l2_next_active(p\next)
        j: j + 1
    l2_m_arity[l2_m_n]: ar
    l2_m_dyn[l2_m_n]: 0
    l2_m_f0[l2_m_n]: 0
    l2_m_f1[l2_m_n]: 0
    if: ar >= 1
        l2_m_f0[l2_m_n]: l2_fn(l2_m_n, 0)
    if: ar >= 2
        l2_m_f1[l2_m_n]: l2_fn(l2_m_n, 1)
    field: l2_next_active(field\next)
    if: is_sub != 0
        l2_m_ret[l2_m_n]: 8
    if: is_sub = 0 && field\value = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    # FABLE-SONNET-TYPE-WORD-FOLD-20260924-162 commit 2 (steps/type-word-fold-
    # inventory.md): the bare-atom return word (int/size_t/unsigned/ulong/
    # void/LmxMsgAddr), the named-Structure return, and the by-value-foreign
    # fallback are one call to the shared l2_ret_type_word (depth=0) now,
    # instead of three separate chains; l2_nsty_set's own side effect (which
    # Structure specifically) stays here, unique to a registered method.
    if: is_sub = 0 && field\value\kind = c.LM_P0_NODE_ATOM
        int: ret_code_a 0
        if: l2_ret_type_word(field\value\as\atom, 0, 0, @ ret_code_a) != 0
            return: l2_error(path, field\value, "unknown type")
        ---
        l2_m_ret[l2_m_n]: ret_code_a
        if: l2_ns_find(field\value\as\atom) >= 0 && l2_nsty_set(l2_m_n, 0 - 1, l2_ns_find(field\value\as\atom)) != 0
            return: l2_error(path, fn_node, "out of memory")
        ---
    if: is_sub = 0 && field\value\kind = c.LM_P0_NODE_FRAME && field\value\as != 0 && field\value\as\frame != 0
        return_depth: l2_address_depth(field\value\as\frame\head)
    # A const-qualified pointer return is the same pointer value at runtime,
    # but its L1 declaration and every receiving temporary must retain the
    # pointee qualifier.  It is a nested `const: (@: T)` type, unlike a
    # const-qualified formal whose innermost frame also carries the name.
    if: is_sub = 0 && l2_frame_head(field\value, "const")
        if: field\value\as\frame\body = 0 || l2_count_active(field\value\as\frame\body) != 1
            return: l2_error(path, fn_node, "incompatible entry signature")
        rty: l2_next_active(field\value\as\frame\body\first_field)\value
        if: rty = 0 || rty\kind != c.LM_P0_NODE_FRAME || rty\as = 0 || rty\as\frame = 0
            return: l2_error(path, fn_node, "incompatible entry signature")
        return_depth: l2_address_depth(rty\as\frame\head)
        if: return_depth != 1 || rty\as\frame\body = 0 || l2_count_active(rty\as\frame\body) != 1
            return: l2_error(path, fn_node, "incompatible entry signature")
        rbase: l2_next_active(rty\as\frame\body\first_field)\value
        if: rbase = 0 || rbase\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, fn_node, "incompatible entry signature")
        int: rty_code_c 0
        if: l2_ret_type_word(rbase\as\atom, 1, 1, @ rty_code_c) != 0
            return: l2_error(path, rbase, "unknown type")
        l2_m_ret[l2_m_n]: rty_code_c
        return_depth: 0 - 1
        ---
    if: is_sub = 0 && return_depth > 2
        if: field\value\as\frame\body = 0 || l2_count_active(field\value\as\frame\body) != 1
            return: l2_error(path, fn_node, "incompatible entry signature")
        rty: l2_next_active(field\value\as\frame\body\first_field)\value
        if: rty = 0 || rty\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, fn_node, "incompatible entry signature")
        int: rty_code_d 0
        if: l2_ret_type_word(rty\as\atom, return_depth, 0, @ rty_code_d) != 0
            return: l2_error(path, rty, "unknown type")
        l2_m_ret[l2_m_n]: rty_code_d
        ---
    if: is_sub = 0 && l2_frame_head(field\value, "@")
        if: field\value\as\frame\body = 0 || l2_count_active(field\value\as\frame\body) != 1
            return: l2_error(path, fn_node, "incompatible entry signature")
        rty: l2_next_active(field\value\as\frame\body\first_field)\value
        if: rty = 0 || rty\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, fn_node, "incompatible entry signature")
        int: rty_code 0
        if: l2_ret_type_word(rty\as\atom, 1, 0, @ rty_code) != 0
            return: l2_error(path, rty, "unknown type")
        l2_m_ret[l2_m_n]: rty_code
        ---
    if: is_sub = 0 && l2_frame_head(field\value, "@@")
        if: field\value\as\frame\body = 0 || l2_count_active(field\value\as\frame\body) != 1
            return: l2_error(path, fn_node, "incompatible entry signature")
        rty: l2_next_active(field\value\as\frame\body\first_field)\value
        if: rty = 0 || rty\kind != c.LM_P0_NODE_ATOM
            return: l2_error(path, fn_node, "incompatible entry signature")
        int: rty_code2 0
        if: l2_ret_type_word(rty\as\atom, 2, 0, @ rty_code2) != 0
            return: l2_error(path, rty, "unknown type")
        l2_m_ret[l2_m_n]: rty_code2
        ---
    ---
    if: is_sub = 0 && field\value\kind != c.LM_P0_NODE_ATOM && return_depth = 0
        return: l2_error(path, fn_node, "incompatible entry signature")
    ret_node: 0
    if: is_sub = 0
        ret_node: field\value
        field: l2_next_active(field\next)
    body: 0
    if: field != 0
        body: field\value
    if: body = 0 && l2_ret_tr(fr) = 0
        bound: 0
        if: l2_bind_same_unit_forward(fn_node, nm, is_sub, params, ret_node, path, @ bound) != 0
            l2_free_method(l2_m_n)
            return: 1
        if: bound != 0
            l2_free_method(l2_m_n)
            return: 0
        # Descriptor-only contract: keep the METHOD row with null body (addr=0).
    ---
    if: body != 0 && (body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0)
        return: l2_error(path, fn_node, "unsupported body")
    if: body != 0 && body\as\structure\trailer != 0
        return: l2_error(path, fn_node, "unsupported trailer")
    if: l2_check_throws_list(body, path) != 0
        return: 1
    l2_m_name[l2_m_n]: nm
    l2_m_node[l2_m_n]: (cast: (@: LmP0Node) fn_node)
    l2_m_body[l2_m_n]: (cast: (@: LmP0Node) body)
    l2_m_sig[l2_m_n]: 0U
    l2_m_own[l2_m_n]: 0
    l2_m_sn[l2_m_n]: 0
    if: body != 0 && l2_collect_decls(body\as\structure, l2_m_n, path, 0, @ sn) != 0
        return: 1
    l2_m_sn[l2_m_n]: sn
    l2_m_n: l2_m_n + 1
return: 0

fn: l2_check_primary (const: @(LmP0Node node); int: mi; const: @(char path)) int
    c.array: [1024]: char lpd
    size_t: lpn 0U
    int: lkind 0
    int: lelem 0
    int: ldepth 0
    size_t: li0 0U
    const: @: LmP0Frame call
    int: pni 0
    int: pres 0
    int: poi 0
    int: proot 0
    int: pfi 0
    int: pmi 0
    @: LmP0Field a0
    @: LmP0Field a1
    int: idx
    int: fi
    int: array_status
    int: raw
    int: raw_j
    int: raw_fld
    size_t: array_index
    int: occ 0
    int: k 0
    @: LmP0Text onm 0
    c.array: [1024]: char cast_ty
    if: node = 0
        return: l2_error(path, node, "unsupported body")
    if: node\kind = c.LM_P0_NODE_ATOM
        k: l2_occ_head(node\as\atom, @ occ, @ onm)
        if: k = 2
            return: l2_error(path, node, "unsupported index")
        if: k = 0
            idx: l2_own_find_occ(mi, onm, occ)
            if: onm != 0
                l2_xfree((cast: (@: void) onm))
            if: idx < 0
                return: l2_error(path, node, "unresolved name")
            if: l2_m_uses[l2_own_off(mi, idx)] = 0
                return: l2_error(path, node, "unresolved name")
            return: 0
        ---
        raw: l2_prefix_deref(node\as\atom, mi, 0, cast_ty)
        if: raw = 0
            return: 0
        if: raw = 2
            return: l2_error(path, node, "invalid raw dereference")
        array_status: l2_own_index_head(node\as\atom, mi, @ idx, @ array_index)
        if: array_status = 0
            return: 0
        if: array_status = 2
            array_status: l2_dyn_own_index(mi, node\as\atom, @ idx, @ raw)
            if: array_status = 2
                return: l2_error(path, node, "mixed numeric types (a conversion)")
            if: array_status = 1 && mi = l2_e
                return: 0
            return: l2_error(path, node, "own array index requires an in-bounds primitive literal")
        raw: l2_raw_head(node\as\atom, mi, @ raw_j, @ raw_fld)
        if: raw = 0
            return: 0
        if: raw = 2
            return: l2_error(path, node, "unknown foreign field")
        if: l2_num(node\as\atom)
            return: 0
        if: l2_int_fits(node\as\atom)
            return: 0
        if: l2_signed_num(node\as\atom)
            return: 0
        if: l2_quoted(node\as\atom)
            return: 0
        if: node\as\atom\length >= 3U && node\as\atom\data[0] = 39 && node\as\atom\data[node\as\atom\length - 1U] = 39
            return: 0
        if: node\as\atom\length >= 2U && node\as\atom\data[0] = 99 && node\as\atom\data[1] = 46
            return: 0
        if: l2_ident(node\as\atom) = 0
            return: l2_error(path, node, "unsupported body")
        # A callable named where a value is consumed gives its result (plan §3 native gate (в);
        # FABLE-OPUS-RECEIVER-CONTRACT-20260924-139): it runs with no arguments, the check of
        # `m()` (l2_check_value_call).  So for a callable formal of this method and for a unit
        # method.  A callable formal of the CALLEE takes the occurrence itself instead; that
        # actual never reaches here (l2_check_call).
        idx: l2_param_find(mi, node\as\atom)
        if: idx >= 0 && idx < l2_m_arity[mi] && l2_cf_get(mi, idx) >= 0
            return: l2_check_value_call(node, l2_cf_get(mi, idx), idx, mi, path)
        if: idx >= 0
            return: 0
        if: l2_find_method(node\as\atom) >= 0
            return: l2_check_value_call(node, l2_find_method(node\as\atom), 0 - 1, mi, path)
        # and a local this method body declares, which lives in its own
        # activation.
        if: l2_ml_find(node\as\atom) >= 0
            return: 0
        if: node\as\atom\length >= 2U && node\as\atom\data[0] = 99 && node\as\atom\data[1] = 46
            return: 0
        idx: l2_own_find_last(mi, node\as\atom)
        # In expression position a primitive array is its backing pointer,
        # matching ordinary C array decay. Indexed graph access remains a
        # separate checked operation above.
        if: idx >= 0 && l2_own_is_array(l2_own_ty[idx]) != 0
            return: 0
        if: idx >= 0 && l2_own_is_array(l2_own_ty[idx]) != 0
            return: l2_error(path, node, "own array use not yet supported")
        if: idx >= 0 && l2_m_uses[l2_own_off(mi, idx)] != 0
            return: 0
        ---
        if: l2_slot_find(mi, node\as\atom) >= 0
            return: 0
        if: l2_ns_find(node\as\atom) >= 0
            return: 0
        if: l2_define_name(node\as\atom) != 0
            return: 0
        return: l2_error(path, node, "unresolved name")
    if: node\kind = c.LM_P0_NODE_FRAME && l2_frame_head(node, "@")
        return: l2_check_addr(node, mi, path)
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0
        return: l2_check_fields(node\as\structure\first_field, l2_count_active(node\as\structure), mi, path, node)
    if: node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: l2_error(path, node, "unsupported body")
    if: l2_frame_head(node, "while") || l2_frame_head(node, "for") || l2_frame_head(node, "continue") || l2_frame_head(node, "break")
        return: l2_error(path, node, "unsupported loop")
    if: l2_frame_head(node, "if") || l2_frame_head(node, "else") || l2_frame_head(node, "return") || l2_frame_head(node, "fn")
        return: l2_error(path, node, "unsupported body")
    call: node\as\frame
    if: call\head = 0
        return: l2_error(path, node, "unknown method")
    if: l2_text_eq(call\head, "cast")
        if: call\body = 0 || call\trailer != 0 || call\body\trailer != 0 || l2_count_active(call\body) < 2
            return: l2_error(path, node, "unsupported cast")
        a0: l2_next_active(call\body\first_field)
        a1: l2_next_active(a0\next)
        if: l2_cast_type(a0\value, cast_ty) != 0
            return: l2_error(path, node, "unsupported cast type")
        if: l2_count_active(call\body) > 2
            return: l2_check_fields(a1, l2_count_active(call\body) - 1, mi, path, node)
        return: l2_check_primary(a1\value, mi, path)
    ---
    if: l2_text_eq(call\head, "sizeof")
        return: l2_check_sizeof(node, mi, path)
    ---
    if: l2_text_eq(call\head, "implements")
        return: l2_check_implements(node, path)
    idx: l2_head_method(call\head)
    fi: 0 - 1
    if: idx < 0
        fi: l2_formal_find(mi, call\head)
        if: fi >= 0
            idx: l2_cf_get(mi, fi)
        ---
    ---
    if: idx < 0 && l2_text_eq(call\head, "length")
        if: l2_array_length_own(node, mi) < 0 && l2_arr_len_shape(node, lpd, @ lpn, @ lkind, @ lelem, @ ldepth, @ li0) != 0
            return: l2_error(path, node, "length requires one known primitive own array")
        return: 0
    if: idx < 0 && l2_is_known(call\head)
        # A foreign C call may take no arguments: c.rand(), c.abort(). The
        # parser gives it an empty body, and l2_check_fields refuses 0 fields.
        if: l2_c_stmt_door(call\head) != 0 && (call\body = 0 || l2_count_active(call\body) = 0)
            return: 0
        if: call\body = 0
            return: l2_error(path, node, "incompatible entry signature")
        return: l2_check_fields(call\body\first_field, l2_count_active(call\body), mi, path, node)
    if: idx < 0 && (l2_predef_has_function(call\head) != 0 || (l2_ml_find(call\head) >= 0 && l2_ml_ty[l2_ml_find(call\head)] = 40))
        if: call\trailer != 0 || call\body = 0 || call\body\trailer != 0
            return: l2_error(path, node, "unsupported trailer")
        if: l2_next_active(call\body\first_field) = 0
            return: 0
        return: l2_check_fields(call\body\first_field, l2_actual_count(call\body\first_field), mi, path, node)
    raw: l2_raw_head(call\head, mi, @ raw_j, @ raw_fld)
    if: idx < 0 && raw = 0 && raw_fld = 5
        if: call\body = 0
            return: l2_error(path, node, "incompatible entry signature")
        return: l2_check_fields(call\body\first_field, l2_count_active(call\body), mi, path, node)
    if: idx < 0 && call\head != 0 && call\head\data != 0 && call\head\length < 256U && l2_seg_count(call\head\data, call\head\length) > 1
        # The head is spelled as a path. Say which part of it failed rather
        # than calling the whole statement unsupported.
        if: l2_path_root(call\head\data, call\head\length, @ pni, @ pres, @ poi, @ proot, @ pfi) != 0
            return: l2_error(path, node, "unknown field path root")
        if: l2_path_kind(call\head\data, call\head\length, @ pmi) < 0
            return: l2_error(path, node, "unknown field path segment")
        return: l2_error(path, node, "a call path must end at a callable field")
    if: idx < 0
        return: l2_error(path, node, "unknown method")
    if: call\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
    if: call\body = 0 || call\body\trailer != 0
        return: l2_error(path, node, "unsupported trailer")
return: l2_check_call(node, idx, fi, call\body, mi, path)

# A CALL OF THE RESOLVED CALLEE idx (FABLE-OPUS-RECEIVER-CONTRACT-20260924-139): one check for
# every spelling of a call -- `m(args)`, `m: args`, the vertical form, and a bare atom `m`, which
# has no argument Structure (body 0) and so no actuals.  fi is the callable formal the call goes
# through, idx then being its required contract, or -1 for a unit method or a method path.
fn: l2_check_call (const: @(LmP0Node node); int: idx; int: fi; const: @(LmP0Structure body); int: mi; const: @(char path)) int
    @: LmP0Field a0 0
    int: nact 0
    int: actual_span
    int: actual_i
    int: req_mi
    int: cand_mi
    int: k
    if: body != 0
        a0: l2_next_active(body\first_field)
        nact: l2_actual_count(body\first_field)
    ---
    if: nact != l2_m_arity[idx]
        return: l2_error(path, node, "incompatible entry signature")
    # Descriptor-only required method is legal as a formal contract; refuse bodiless only on direct calls.
    if: l2_m_body[idx] = 0 && fi < 0 && (l2_m_node[idx] = 0 || l2_m_node[idx]\as = 0 || l2_ret_tr(l2_m_node[idx]\as\frame) = 0)
        return: l2_error(path, node, "not callable")
    # Bit 1: a call of idx itself (by name or path).  Bit 2: a call through the callable formal fi,
    # whose contract is idx -- the callee is whichever method the actual names (l2_reach_close).
    if: fi < 0
        l2_m_edge[l2_edge_off(mi, idx)]: l2_m_edge[l2_edge_off(mi, idx)] | 1
    else:
        l2_m_edge[l2_edge_off(mi, idx)]: l2_m_edge[l2_edge_off(mi, idx)] | 2
    ---
    if: l2_check_throws_handled(mi, idx, path, node) != 0
        return: 1
    actual_i: 0
    while: a0 != 0
        actual_span: l2_expr_span(a0)
        # A callable formal takes the occurrence of the callable its actual names -- a reference,
        # checked against the formal's contract -- not a call (plan §3 native gate (г)).
        req_mi: l2_cf_get(idx, actual_i)
        if: req_mi >= 0
            if: actual_span != 1 || a0\value = 0 || a0\value\kind != c.LM_P0_NODE_ATOM
                return: l2_error(path, node, "incompatible entry signature")
            cand_mi: l2_find_method(a0\value\as\atom)
            if: cand_mi < 0 || l2_method_sig_compatible(cand_mi, req_mi) = 0
                return: l2_error(path, node, "incompatible entry signature")
            l2_m_value_used[cand_mi]: 1
        ---
        if: req_mi < 0 && (actual_span < 1 || l2_check_fields(a0, actual_span, mi, path, node) != 0)
            return: 1
        if: actual_span = 1 && a0\value != 0 && a0\value\kind = c.LM_P0_NODE_ATOM && l2_nsty_get(idx, actual_i) >= 0 && l2_m_node[idx] != 0 && l2_m_node[idx]\as != 0
            if: l2_admit_consumer_uses(a0\value\as\atom, l2_nsty_get(idx, actual_i), l2_fn(idx, actual_i), l2_m_node[idx]\as\frame, path, node, "function argument") != 0
                return: 1
            ---
            if: l2_untyped_graph(mi, a0\value) != 0 && l2_admit_site(mi) != 0
                return: l2_error(path, node, "internal: admission outside a method")
            ---
        ---
        if: actual_span = 1 && a0\value != 0 && a0\value\kind = c.LM_P0_NODE_ATOM
            if: l2_check_literal_kind(a0\value\as\atom, l2_lit_kind_from_ft(l2_ft(idx, actual_i)), path, node) != 0
                return: 1
            ---
        ---
        k: 0
        while: k < actual_span && a0 != 0
            a0: l2_next_active(a0\next)
            k: k + 1
        actual_i: actual_i + 1
    ---
return: 0

# A CALLABLE IN VALUE POSITION (l2_check_primary): its result is the value, so it is called with
# no arguments (l2_check_call), and a callable without a result -- a sub, or a callable formal
# whose contract is one -- has no value to give (plan §3 native gate (б)).
fn: l2_check_value_call (const: @(LmP0Node node); int: idx; int: fi; int: mi; const: @(char path)) int
    if: l2_m_ret[idx] = 8
        return: l2_error(path, node, "a callable without a result has no value")
return: l2_check_call(node, idx, fi, 0, mi, path)

# A call Frame whose callee has no result: a sub, or a callable formal whose contract is one.  As a
# value it has none to give (l2_check_fields); as a statement it is simply called.
fn: l2_frame_void_call (const: @(LmP0Node node); int: mi) int
    int: idx
    int: fi
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: 0
    idx: l2_head_method(node\as\frame\head)
    if: idx < 0
        fi: l2_formal_find(mi, node\as\frame\head)
        if: fi >= 0
            idx: l2_cf_get(mi, fi)
        ---
    ---
    if: idx < 0
        return: 0
return: l2_m_ret[idx] = 8

fn: l2_check_expr (const: @(LmP0Node node); int: mi; const: @(char path)) int
return: l2_check_primary(node, mi, path)

fn: l2_check_fields (@: LmP0Field field; int: n; int: mi; const: @(char path); const: @(LmP0Node at)) int
    @: LmP0Field f
    size_t: cpn 0U
    int: cpni 0
    int: cpres 0
    int: cpoi 0
    int: cproot 0
    int: cpfi 0
    int: fpk 0
    c.array: [1024]: char cpbuf
    int: cpraw
    int: cpraw_j 0
    int: cpraw_fld 0
    @: LmP0Field p1
    @: LmP0Field p2
    @: LmP0Field p3
    @: LmP0Field p4
    @: LmP0Field p5
    int: i
    int: skip
    int: after 0
    int: have_value 0
    int: po
    int: fpc
    int: array_status
    size_t: array_index
    int: array_count
    c.array: [1024]: char apd
    size_t: apn 0U
    int: acnt 0
    int: akind 0
    int: aelem 0
    int: adepth 0
    int: ast 1
    size_t: ai0 0U
    size_t: ai1 0U
    @: LmP0Field aafter 0
    @: LmP0Field aidx_f
    if: n <= 0
        return: l2_error(path, at, "unsupported body")
    cpn: l2_join_path(field, n, cpbuf, 255U)
    if: cpn != 0U
        cpraw: l2_raw_path(cpbuf, cpn, mi, @ cpraw_j, @ cpraw_fld)
        if: cpraw = 0
            return: 0
        if: cpraw = 2
            return: l2_error(path, at, "unknown foreign field")
        ---
    ---
    if: cpn != 0U && l2_path_root(cpbuf, cpn, @ cpni, @ cpres, @ cpoi, @ cproot, @ cpfi) = 0
        return: 0
    f: l2_next_active(field)
    i: 0
    while: i < n
        if: f = 0 || f\value = 0
            return: l2_error(path, at, "unsupported body")
        # An indexed field path (S3 part 2b): an element of a declared Array field.
        ast: l2_arr_operand(f, 0, apd, @ apn, @ acnt, @ aafter, @ akind, @ aelem, @ adepth, @ ai0, @ ai1)
        if: ast = 2
            return: l2_error(path, f\value, "an indexed field path needs decimal literal indices, within a fixed Array's count, into a declared Array field")
        if: ast = 3
            return: l2_error(path, f\value, "an indexed field path needs a root of a declared Structure type")
        if: ast = 0 && ((akind = 5 && adepth != 1) || (akind = 6 && adepth != 2))
            return: l2_error(path, f\value, "an inner Array is a value only inside length()")
        if: ast = 0
            have_value: 1
            i: i + acnt
            f: aafter
            continue
        array_status: l2_own_index_tail(f, mi, @ po, @ array_index, @ p2, @ array_count)
        if: array_status = 2
            if: mi = l2_e && l2_index_tail(f, @ aidx_f, @ p2) = 0 && aidx_f != 0 && aidx_f\value != 0 && aidx_f\value\kind = c.LM_P0_NODE_ATOM && aidx_f\value\as != 0
                po: l2_own_find_last(mi, aidx_f\value\as\atom)
                if: po >= 0 && l2_own_ty[po] = 2
                    have_value: 1
                    i: i + 4
                    f: p2
                    continue
                if: po >= 0 && l2_rw_num_ty(l2_own_ty[po]) != 0
                    return: l2_error(path, aidx_f\value, "mixed numeric types (a conversion)")
            ---
            return: l2_error(path, f\value, "own array index requires an in-bounds primitive literal")
        if: array_status = 0
            have_value: 1
            i: i + array_count
            f: p2
            continue
        skip: 0
        p1: 0
        p2: 0
        if: f\value\kind = c.LM_P0_NODE_ATOM
            p1: l2_next_active(f\next)
        if: p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom)
            p2: l2_next_active(p1\next)
        # A field path off an own field, a namespace-typed name, or node/for
        # (FABLE-SONNET-NODE-ROOT-20260923-121: node/for are ordinary roots
        # of the same dispatcher now, not a separate own-table check tried
        # first -- FABLE-SONNET-FIELD-PATHS-20260923-113 for the general
        # mechanism itself, which l2_field_path_check's own gate now also
        # admits them into).
        fpc: 0 - 1
        if: p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM
            fpc: l2_field_path_check(mi, f\value\as\atom, p2\value\as\atom, @ fpk)
        if: fpc = 1
            return: l2_error(path, p2\value, "unresolved name")
        if: fpc = 0
            have_value: 1
            i: i + 3
            f: l2_next_active(p2\next)
            continue
        # A bound merge result as a path root with an occurrence index, `merged\[N]x`
        # (FABLE-OPUS-MERGE-ADDRESSING-20260924-154): occurrence N of field x in operand
        # order.  The unqualified `merged\x` (the last occurrence) is an ordinary path.
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(f\value\as\atom) != 0 && l2_mres_find(f\value\as\atom) >= 0 && l2_own_find(mi, f\value\as\atom) < 0 && l2_formal_find(mi, f\value\as\atom) < 0 && p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom) && p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(p2\value\as\atom, "[") != 0
            p3: l2_next_active(p2\next)
            p4: 0
            p5: 0
            if: p3 != 0
                p4: l2_next_active(p3\next)
            if: p4 != 0
                p5: l2_next_active(p4\next)
            if: p3 = 0 || p3\value = 0 || p3\value\kind != c.LM_P0_NODE_ATOM || l2_num(p3\value\as\atom) = 0 || p4 = 0 || p4\value = 0 || p4\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(p4\value\as\atom, "]") = 0 || p5 = 0 || p5\value = 0 || p5\value\kind != c.LM_P0_NODE_ATOM || l2_ident(p5\value\as\atom) = 0
                return: l2_error(path, p2\value, "unsupported index")
            if: l2_mrs_slot_nth(l2_mres_find(f\value\as\atom), p5\value\as\atom, (cast: (int) l2_literal_value(p3\value\as\atom)), @ fpk, @ po) < 0
                return: l2_error(path, p5\value, "merge occurrence index out of range")
            if: l2_kind_cell_ty(fpk) < 0
                return: l2_error(path, p5\value, "a field path must end at a primitive field")
            have_value: 1
            i: i + 6
            f: l2_next_active(p5\next)
            continue
        # A method name as a path root denotes its occurrence (l2_path_root's
        # own method-occurrence branch, FABLE-SONNET-NODE-ROOT-20260923-121)
        # -- but l2_join_path's strict name\name\... alternation cannot carry
        # a bracket segment, so a root-qualified occurrence index is
        # recognized here at the flat-token level instead of inside
        # l2_path_root, reusing the two primitives every other occurrence
        # form already uses: l2_find_method (the root) and l2_own_find_occ
        # (the same lookup l2_occ_head's rootless `\[N]name` already calls).
        # `test\[N]name` picks occurrence N; unqualified `test\arg` is the
        # LAST occurrence (FABLE-SONNET-LAST-OCCURRENCE-20260924-164, author's
        # rule Q22.2 -- this replaces the -146 "occurrence 0" reading).
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(f\value\as\atom) != 0 && l2_find_method(f\value\as\atom) >= 0 && p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom) && p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(p2\value\as\atom, "[") != 0
            p3: l2_next_active(p2\next)
            p4: 0
            p5: 0
            if: p3 != 0
                p4: l2_next_active(p3\next)
            if: p4 != 0
                p5: l2_next_active(p4\next)
            if: p3 = 0 || p3\value = 0 || p3\value\kind != c.LM_P0_NODE_ATOM || l2_num(p3\value\as\atom) = 0 || p4 = 0 || p4\value = 0 || p4\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(p4\value\as\atom, "]") = 0 || p5 = 0 || p5\value = 0 || p5\value\kind != c.LM_P0_NODE_ATOM || l2_ident(p5\value\as\atom) = 0
                return: l2_error(path, p2\value, "unsupported index")
            po: l2_own_find_occ(l2_find_method(f\value\as\atom), p5\value\as\atom, (cast: (int) l2_literal_value(p3\value\as\atom)))
            if: po < 0 || l2_m_uses[l2_own_off(l2_find_method(f\value\as\atom), po)] = 0
                return: l2_error(path, p5\value, "own occurrence index out of range")
            have_value: 1
            i: i + 6
            f: l2_next_active(p5\next)
            continue
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(f\value\as\atom) != 0 && l2_find_method(f\value\as\atom) >= 0 && p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom) && p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && l2_ident(p2\value\as\atom) != 0
            po: l2_own_find_last(l2_find_method(f\value\as\atom), p2\value\as\atom)
            if: po < 0 || l2_m_uses[l2_own_off(l2_find_method(f\value\as\atom), po)] = 0
                return: l2_error(path, p2\value, "unresolved name")
            have_value: 1
            i: i + 3
            f: l2_next_active(p2\next)
            continue
        if: p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && f\value\as\atom\length + p2\value\as\atom\length + 1U <= 255U
            memcpy(cpbuf, f\value\as\atom\data, f\value\as\atom\length)
            cpbuf[f\value\as\atom\length]: 92
            memcpy(cpbuf + f\value\as\atom\length + 1U, p2\value\as\atom\data, p2\value\as\atom\length)
            cpn: f\value\as\atom\length + p2\value\as\atom\length + 1U
            cpraw: l2_raw_path(cpbuf, cpn, mi, @ cpraw_j, @ cpraw_fld)
            if: cpraw = 2
                return: l2_error(path, f\value, "unknown foreign field")
            if: cpraw = 0
                have_value: 1
                i: i + 3
                f: l2_next_active(p2\next)
                continue
            ---
        ---
        if: l2_addr_tail(f, @ p1, @ p2) = 0
            i: i + 2
            f: p2
            continue
        if: f\value\kind = c.LM_P0_NODE_ATOM && (l2_is_binop(f\value\as\atom) || l2_is_brack(f\value\as\atom) || l2_is_slash(f\value\as\atom) || l2_num(f\value\as\atom))
            skip: 1
        # An address prefix in flat-field position. What it addresses is checked
        # by the fields that follow it, like any other name or field read.
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(f\value\as\atom, "@") && l2_addr_flat_eternal(f) != 0
            return: l2_error(path, f\value, "the address of an eternal branch field cannot be taken")
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(f\value\as\atom, "@")
            # D-22 (steps/defects.md): L2 spec 18.2 gives `@array[i]` address
            # arithmetic a meaning ("subsequent loads, stores and address
            # arithmetic follow the C machine contract"), but l2trans has no
            # expression-type inference to carry a pointer result through
            # the rest of a compound expression and refuse it landing in a
            # numeric target -- return-statement and assignment checking
            # both stop at a single value (l2_colon_simple_ty's own comment:
            # "the general expression checker still owns compound
            # expressions", and that checker has no out_ty at all). Until
            # that type tracking exists, refuse the compound shape outright
            # at the point it becomes ambiguous, rather than let a pointer
            # reach a numeric target unnoticed the way D-21's own fixture
            # family did. `@ buf[i]` alone, with nothing after the addressed
            # element, is the D-21 shape and is unaffected.
            aidx_f: l2_next_active(f\next)
            if: aidx_f != 0 && l2_own_index_tail(aidx_f, mi, @ po, @ array_index, @ p2, @ array_count) = 0 && p2 != 0
                return: l2_error(path, f\value, "address arithmetic past an own-array element is not yet supported")
            skip: 1
            have_value: 0
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_is_binop(f\value\as\atom)
            have_value: 0
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(f\value\as\atom)
            if: have_value != 0
                after: 1
            else:
                after: 0
            ---
        if: after != 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(f\value\as\atom) = 0 && l2_ident(f\value\as\atom)
            skip: 1
            after: 0
            have_value: 1
        if: skip = 0 && l2_check_primary(f\value, mi, path) != 0
            return: 1
        if: skip = 0 && l2_frame_void_call(f\value, mi) != 0
            return: l2_error(path, f\value, "a callable without a result has no value")
        if: skip = 0
            have_value: 1
        i: i + 1
        f: l2_next_active(f\next)
return: 0

# THE CALLABLE A BARE ATOM NAMES (FABLE-OPUS-RECEIVER-CONTRACT-20260924-139), resolved as the head
# of a call is (l2_check_primary, l2_prep): a unit method, else a callable formal -- the result is
# then the formal's required contract and \fi the formal.  -1: the atom is not callable here.
fn: l2_atom_callee (const: @(LmP0Text t); int: mi; @: int fi) int
    int: k
    int: idx
    \fi: 0 - 1
    idx: l2_find_method(t)
    if: idx >= 0
        return: idx
    k: l2_formal_find(mi, t)
    if: k < 0
        return: 0 - 1
    idx: l2_cf_get(mi, k)
    if: idx >= 0
        \fi: k
return: idx

# Does a bare atom denote a Structure: a formal, dynamic input, own field, slot or local whose type
# is a graph, or else a declared named Structure?
fn: l2_bare_structure (const: @(LmP0Text t); int: mi) int
    int: ty 0
    if: l2_colon_bound_ty(mi, t, @ ty) = 0
        return: l2_colon_is_graph_ty(ty)
return: l2_ns_find(t) >= 0

# THE EXPRESSION STATEMENT (plan §3 "Expression statement и discard"; FABLE-OPUS-DISCARD-
# 20260924-147).  Any expression in statement position is evaluated and its value discarded: a
# bare atom, and a run of fields l2_expr_span groups into one expression -- P0 gives a statement
# line of several atoms (`2 + 2`, `g(m()) + 1`) as that many fields.  A bare atom resolves like
# any value, and the kind of its binding decides (FABLE-OPUS-RECEIVER-CONTRACT-20260924-139): a
# callable is called with no arguments -- the check of `m()`, l2_check_call -- a Structure is
# refused until executing one is settled (q20), any other value is evaluated and discarded,
# never called.  A run is an ordinary value expression (l2_check_fields).
fn: l2_check_discard (@: LmP0Field field; int: span; int: mi; const: @(char path)) int
    @: LmP0Node stmt
    int: idx
    int: fi 0
    stmt: field\value
    if: span != 1 || stmt\kind != c.LM_P0_NODE_ATOM
        return: l2_check_fields(field, span, mi, path, stmt)
    idx: l2_atom_callee(stmt\as\atom, mi, @ fi)
    if: idx >= 0
        return: l2_check_call(stmt, idx, fi, 0, mi, path)
    if: l2_check_primary(stmt, mi, path) != 0
        return: 1
    if: l2_bare_structure(stmt\as\atom, mi) != 0
        return: l2_error(path, stmt, "executing a named Structure is not supported yet")
return: 0

# How many fields a statement that is an expression run takes: 0 when the field starts no run
# (a single Frame is a statement of its own kind; a single Structure is a nested body), else the
# l2_expr_span of the run -- one bare atom, or several fields read as one expression.
fn: l2_discard_run (@: LmP0Field field) int
    @: LmP0Node e
    int: n
    if: field = 0 || field\value = 0
        return: 0
    e: field\value
    n: l2_expr_span(field)
    if: e\kind = c.LM_P0_NODE_ATOM
        if: l2_text_eq(e\as\atom, "break") || l2_text_eq(e\as\atom, "continue") || l2_text_eq(e\as\atom, "return")
            return: 0
        return: n
    if: n > 1
        return: n
return: 0

fn: l2_check_body (const: @(LmP0Structure body); int: mi; const: @(char path); int: depth) int
    int: nmk
    int: msk
    int: msni
    int: array_target
    int: array_status
    size_t: array_index
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Field last
    int: n
    int: k
    int: rj 0
    int: rf 0
    int: raw 1
    int: ix 1
    int: pd 1
    c.array: [1024]: char pdest
    int: lty 0
    @: LmP0Text lnm 0
    int: cj
    int: letni
    @: LmP0Text cmodel
    @: LmP0Text cname
    if: body = 0
        return: l2_error(path, 0, "unsupported body")
    field: l2_next_active(body\first_field)
    if: field = 0
        return: l2_error(path, 0, "unsupported body")
    while: field != 0
        stmt: field\value
        l2_vis_stmt(mi, stmt)
        # An expression statement (l2_check_discard); the walker moves past its whole run.
        n: l2_discard_run(field)
        if: n > 0
            if: l2_check_discard(field, n, mi, path) != 0
                return: 1
            field: l2_skip_span(field, n)
            continue
        # An anonymous `---` block is a nested executable body, like an if body (§14, Q14 K);
        # `()` is an empty one, with nothing to run.
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0 && l2_count_active(stmt\as\structure) = 0
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0
            if: l2_scope_push(stmt) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_check_body(stmt\as\structure, mi, path, depth + 1) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        # A trailer word closes the frame it follows. After a frame that is
        # already closed P0 leaves it an ordinary item; it is still not a
        # statement, in the entry or in any body.
        if: l2_frame_head(stmt, "end") != 0 || l2_frame_head(stmt, "until") != 0
            return: l2_error(path, stmt, "stray trailer: the frame above is already closed")
        # S1.2 (author Q13): `throws:` is the first item of a method head -- l2_collect_method
        # took the list from there -- and nowhere else.
        if: l2_frame_head(stmt, "throws")
            if: l2_throws_frame(mi) != stmt
                return: l2_error(path, stmt, "throws: must be the first item of a method head")
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "throw")
            if: l2_check_throw(stmt, mi, path) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # S1.3: a catch and its handler (l2_check_catch).
        if: l2_frame_head(stmt, "catch")
            if: l2_check_catch(stmt, body, path, mi, depth) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # 19.17 merge is an ordinary statement frame here. Its operands are
        # checked at emission, where the qualified branch table is complete.
        if: l2_merge_frame(stmt) != 0
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "[]") && (l2_own_array_count(stmt) = 0 || depth != l2_scope_n)
            return: l2_error(path, stmt, "unsupported own array declaration")
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "break") && l2_loop_depth = 0
            return: l2_error(path, stmt, "unsupported loop")
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "break")
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "continue") && l2_loop_depth = 0
            return: l2_error(path, stmt, "unsupported loop")
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "continue")
            field: l2_next_active(field\next)
            continue
        # A bare `return` ends the walked root (mi = E): its value is its last evaluated expression
        # (plan §3).  A method with a result returns a value.
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "return") && l2_m_ret[mi] != 8 && mi != l2_e
            return: l2_error(path, stmt, "unsupported body")
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "return")
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0
            array_status: l2_own_index_head(stmt\as\frame\head, mi, @ array_target, @ array_index)
            if: array_status = 2
                array_status: l2_dyn_own_index(mi, stmt\as\frame\head, @ array_target, @ rj)
                if: array_status = 2
                    return: l2_error(path, stmt, "mixed numeric types (a conversion)")
                if: array_status = 1 && mi = l2_e
                    fr: stmt\as\frame
                    if: fr\body = 0 || fr\trailer != 0 || fr\body\trailer != 0
                        return: l2_error(path, stmt, "unsupported trailer")
                    if: l2_check_fields(fr\body\first_field, l2_count_active(fr\body), mi, path, stmt) != 0
                        return: 1
                    field: l2_next_active(field\next)
                    continue
                return: l2_error(path, stmt, "own array index requires an in-bounds primitive literal")
            if: array_status = 0
                fr: stmt\as\frame
                if: fr\body = 0 || fr\trailer != 0 || fr\body\trailer != 0
                    return: l2_error(path, stmt, "unsupported trailer")
                if: l2_check_fields(fr\body\first_field, l2_count_active(fr\body), mi, path, stmt) != 0
                    return: 1
                field: l2_next_active(field\next)
                continue
            array_target: l2_own_find_last(mi, stmt\as\frame\head)
            if: array_target >= 0 && l2_own_is_array(l2_own_ty[array_target]) != 0
                return: l2_error(path, stmt, "own array use not yet supported")
        ---
        if: l2_frame_head(stmt, "break") || l2_frame_head(stmt, "continue")
            return: l2_error(path, stmt, "unsupported loop")
        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            if: fr\body = 0
                return: l2_error(path, stmt, "unsupported body")
            if: fr\trailer != 0 && l2_end_named(fr, "if") = 0
                return: l2_error(path, stmt, "unsupported trailer")
            n: l2_count_active(fr\body)
            if: n < 2
                return: l2_error(path, stmt, "unsupported body")
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                return: l2_error(path, stmt, "unsupported body")
            if: l2_check_fields(fr\body\first_field, n - 1, mi, path, stmt) != 0
                return: 1
            if: l2_scope_push(last\value) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_check_body(last\value\as\structure, mi, path, depth + 1) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && nxt\value\as\frame\body = 0
                return: l2_error(path, nxt\value, "unsupported body")
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && nxt\value\as\frame\trailer != 0 && l2_end_named(nxt\value\as\frame, "else") = 0
                return: l2_error(path, nxt\value, "unsupported trailer")
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                if: l2_scope_push(nxt\value) != 0
                    return: l2_alloc_or(path, nxt\value, "out of memory")
                if: l2_check_body(nxt\value\as\frame\body, mi, path, depth + 1) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            ---
        if: l2_frame_head(stmt, "while")
            fr: stmt\as\frame
            if: fr\body = 0
                return: l2_error(path, stmt, "unsupported body")
            if: fr\trailer != 0 && l2_end_named(fr, "while") = 0
                return: l2_error(path, stmt, "unsupported trailer")
            n: l2_count_active(fr\body)
            if: n < 2
                return: l2_error(path, stmt, "unsupported body")
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                return: l2_error(path, stmt, "unsupported body")
            if: l2_check_fields(fr\body\first_field, n - 1, mi, path, stmt) != 0
                return: 1
            l2_loop_depth: l2_loop_depth + 1
            if: l2_scope_push(last\value) != 0
                l2_loop_depth: l2_loop_depth - 1
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_check_body(last\value\as\structure, mi, path, depth + 1) != 0
                l2_scope_pop()
                l2_loop_depth: l2_loop_depth - 1
                return: 1
            l2_scope_pop()
            l2_loop_depth: l2_loop_depth - 1
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "for")
            fr: stmt\as\frame
            if: l2_for_cstyle(stmt) = 0
                return: l2_error(path, stmt, "unsupported loop")
            if: fr\trailer != 0 && l2_end_named(fr, "for") = 0
                return: l2_error(path, stmt, "unsupported trailer")
            last: l2_next_active(fr\body\first_field)
            if: l2_scope_push(stmt) != 0
                return: l2_alloc_or(path, stmt, "out of memory")
            if: l2_own_decl_ty(last\value) != 0 && l2_count_active(last\value\as\frame\body) = 2 && l2_check_expr(l2_next_active(l2_next_active(last\value\as\frame\body\first_field)\next)\value, mi, path) != 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(last\next)
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                l2_scope_pop()
                return: l2_error(path, stmt, "unsupported body")
            if: l2_check_fields(last\value\as\structure\first_field, l2_count_active(last\value\as\structure), mi, path, stmt) != 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(last\next)
            if: last = 0 || last\value = 0 || l2_check_primary(last\value, mi, path) != 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(last\next)
            last: l2_next_active(last\next)
            if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                l2_scope_pop()
                return: l2_error(path, stmt, "unsupported body")
            l2_loop_depth: l2_loop_depth + 1
            if: l2_check_body(last\value\as\structure, mi, path, depth + 1) != 0
                l2_loop_depth: l2_loop_depth - 1
                l2_scope_pop()
                return: 1
            l2_loop_depth: l2_loop_depth - 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0 && l2_ml_array_head(stmt\as\frame\head) >= 0
            if: l2_index_head(stmt\as\frame\head, mi, @ rj) != 0
                return: l2_error(path, stmt, "unsupported index")
            if: stmt\as\frame\body = 0 || l2_check_fields(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), mi, path, stmt) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        ---
        if: l2_frame_head(stmt, "if") = 0 && l2_const_local_ty(stmt, @ lnm, @ lty) = 0 && l2_ml_find(lnm) >= 0
            field: l2_next_active(field\next)
            continue
        # A resolved fnptr local (type 40) is a call in any surface form:
        # parenthesized, colon, or vertical. Type-headed decl+init is l2_fnptr_local; later "f: value" is a call.
        if: l2_frame_head(stmt, "if") = 0 && stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0 && l2_ml_find(stmt\as\frame\head) >= 0 && l2_ml_ty[l2_ml_find(stmt\as\frame\head)] = 40
            if: stmt\as\frame\body != 0 && l2_next_active(stmt\as\frame\body\first_field) != 0 && l2_check_fields(stmt\as\frame\body\first_field, l2_actual_count(stmt\as\frame\body\first_field), mi, path, stmt) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && l2_fnptr_local(stmt, @ lnm) = 0 && l2_ml_find(lnm) >= 0
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && l2_struct_local(stmt, @ lnm) = 0 && l2_ml_find(lnm) >= 0
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && l2_ptr_local_ty(stmt, @ lnm, @ lty) = 2
            return: l2_error(path, l2_next_active(stmt\as\frame\body\first_field)\value, "unknown type")
        if: l2_frame_head(stmt, "if") = 0 && l2_ptr_local_ty(stmt, @ lnm, @ lty) = 0 && l2_ml_find(lnm) >= 0
            field: l2_next_active(field\next)
            continue
        # sendMessage: X (author 2026-09-24): a send, not an assignment.  The root's is built as a
        # walker step (l2_rw_send); a method's (FABLE-SONNET-SEND-IN-METHODS-20260925-168 commit
        # 2) is a direct native call of the same generated l2_msend<k> (l2_msend_register here
        # validates and records the shape; l2_emit_body re-derives the same k to call it).
        if: l2_frame_head(stmt, "sendMessage") != 0 && mi = l2_e
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "sendMessage") != 0
            if: l2_msend_register(stmt, path, @ msk, @ msni) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # receiveMessage: m / receiveMessage: m Model (Q10; the two-name form,
        # FABLE-SONNET-SEND-REF-20260925-172 commit 2). The first
        # receiveMessage that names m declares it (an own field typed to the
        # synthesized letter model, bound here); a later one rebinds it.  A
        # letter's graph has no static Structure type of its own: into the
        # letter model own field it is admitted at run time (l2_emit_admit);
        # a formal is not its target.  Set here too, not only in the
        # collection pre-pass (l2_collect_asgn_body): idempotent on a repeat,
        # and the only way this site's own l2_own_nsty_get check below sees
        # the type on a first declaration if that pre-pass has not run yet.
        if: l2_receive_msg_shape(stmt, @ cname, 0) = 2
            return: l2_error(path, stmt, "receiveMessage binds one or two names")
        if: l2_receive_msg_shape(stmt, @ cname, @ cmodel) = 0
            nmk: l2_param_find(mi, cname)
            if: nmk >= 0 && l2_colon_is_graph_ty(l2_ft(mi, nmk)) != 0
                return: l2_error(path, stmt, "graph assignment admission requires receiving-expression tests")
            if: nmk >= 0
                return: l2_error(path, stmt, "assignment value has incompatible type")
            cj: l2_own_add(mi, cname, l2_own_of_dt(l2_colon_graph_ty()), path, stmt)
            if: cj < 0
                return: 1
            if: cmodel != 0
                if: l2_letter_ns_for(cmodel, stmt, path, @ letni) != 0
                    return: 1
                if: l2_own_nsty_set(cj, letni) != 0
                    return: 1
                ---
            if: l2_own_nsty_get(cj) >= 0 && l2_admit_site(mi) != 0
                return: l2_error(path, stmt, "internal: admission outside a method")
            if: l2_own_off(mi, cj) = (cast: (size_t) -1)
                return: l2_error(path, stmt, "size overflow")
            if: l2_own_decl[cj] = stmt
                l2_m_uses[l2_own_off(mi, cj)]: 1
                l2_m_own[mi]: l2_m_own[mi] + 1
                if: l2_bind_own(mi, cj, path, stmt) != 0
                    return: 1
            ---
            field: l2_next_active(field\next)
            continue
        # Model: fresh (FABLE-SONNET-DECL-BINDING-20260922-105). An own field
        # of the enclosing method occurrence, constructed by merge(Model,
        # empty), registered at this exact lexical point like any other own
        # declaration -- CORE.md 3.1/4, L2 spec 10. At unit level it is an own
        # field of the entry E, registered the same way (S2).
        if: l2_frame_head(stmt, "if") = 0 && l2_colon_decl_shape(stmt, @ cmodel, @ cname) = 0 && l2_colon_bound_before(body, stmt, mi, cname) = 0
            cj: l2_own_add(mi, cname, l2_own_of_dt(l2_colon_graph_ty()), path, stmt)
            if: cj < 0
                return: 1
            if: l2_own_off(mi, cj) = (cast: (size_t) -1)
                return: l2_error(path, stmt, "size overflow")
            l2_m_uses[l2_own_off(mi, cj)]: 1
            l2_m_own[mi]: l2_m_own[mi] + 1
            if: l2_bind_own(mi, cj, path, stmt) != 0
                return: 1
            if: l2_own_nsty_set(cj, l2_ns_find(cmodel)) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0 && l2_ml_find(stmt\as\frame\head) >= 0
            if: stmt\as\frame\body = 0 || l2_check_fields(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), mi, path, stmt) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "if") = 0 && l2_unimpl_numeric(stmt) != 0
            return: l2_error(path, stmt, l2_unimpl_numeric(stmt))
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && depth > 0 && l2_scope_n = 0
            return: l2_error(path, stmt, "unsupported own declaration")
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && l2_count_active(stmt\as\frame\body) = 2
            last: l2_next_active(l2_next_active(stmt\as\frame\body\first_field)\next)
            if: last = 0 || last\value = 0 || l2_check_expr(last\value, mi, path) != 0
                return: 1
            if: last\value\kind = c.LM_P0_NODE_ATOM && l2_check_literal_kind(last\value\as\atom, l2_lit_kind_from_own(l2_own_decl_ty(stmt)), path, stmt) != 0
                return: 1
            ---
        ---
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt)
            field: l2_next_active(field\next)
        raw: 1
        ix: 1
        pd: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0
            ix: l2_index_head(stmt\as\frame\head, mi, @ rj)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && (ix = 2 || ix = 3)
            return: l2_error(path, stmt, "unsupported index")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && stmt\as != 0 && stmt\as\frame != 0
            raw: l2_raw_head(stmt\as\frame\head, mi, @ rj, @ rf)
            pd: l2_prefix_deref(stmt\as\frame\head, mi, 0, pdest)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && pd = 2
            return: l2_error(path, stmt, "invalid raw dereference")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && raw = 2
            return: l2_error(path, stmt, "unknown foreign field")
        # `f()`/`f: ()`/closed empty vertical, name absent (FABLE-SONNET-
        # EMPTY-STRUCT-20260923-132): the empty Structure-body supplies its
        # own structural type -- declare f as a new, empty structural own
        # field through the ordinary declaration path, exactly like
        # `Model: fresh` two cases above minus a named model to record (no
        # l2_own_nsty_set: there is no name to look up, and an opaque,
        # no-namespace own field is exactly what a 0-field type has to be).
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_empty_struct_decl_shape(stmt, mi) != 0
            cj: l2_own_add(mi, stmt\as\frame\head, l2_own_of_dt(l2_colon_graph_ty()), path, stmt)
            if: cj < 0
                return: 1
            if: l2_own_off(mi, cj) = (cast: (size_t) -1)
                return: l2_error(path, stmt, "size overflow")
            l2_m_uses[l2_own_off(mi, cj)]: 1
            l2_m_own[mi]: l2_m_own[mi] + 1
            if: l2_bind_own(mi, cj, path, stmt) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # The same Frame when f already binds an ordinary Structure (l2_empty_struct_assign_shape;
        # the book §12): ordinary assignment of the empty Structure, with admission to f's declared
        # Structure type when it has one -- the S3 path, whose refusal is the implicit throw
        # implements.
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_empty_struct_assign_shape(stmt, mi) != 0
            if: (l2_empty_struct_assign_shape(stmt, mi) = 2 || l2_graph_nsty(mi, stmt\as\frame\head) >= 0) && l2_admit_site(mi) != 0
                return: l2_error(path, stmt, "internal: admission outside a method")
            field: l2_next_active(field\next)
            continue
        # A bare colon frame whose head is not a call is an update only when
        # that head already has a typed mutable binding.  In particular,
        # `arg: 7` must not silently invent arg; the graph-construction role was
        # normalized to an explicit merge before reaching this check.
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_is_asgn(stmt) != 0 && stmt\as\frame\head != 0 && l2_ident(stmt\as\frame\head) != 0 && l2_param_find(mi, stmt\as\frame\head) < 0 && l2_own_find(mi, stmt\as\frame\head) < 0 && l2_slot_find(mi, stmt\as\frame\head) < 0 && l2_ml_find(stmt\as\frame\head) < 0
            return: l2_error(path, stmt, "assignment target must be a declared typed mutable value")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_colon_check_assignment(stmt, mi, path) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && raw = 0 && rj < l2_m_arity[mi] && (l2_ft(mi, rj) = 6 || (l2_ft(mi, rj) >= 100 && l2_ft(mi, rj) - 100 < l2_foreign_n && l2_foreign_const[l2_ft(mi, rj) - 100] != 0))
            return: l2_error(path, stmt, "const write")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && raw = 0 && rj < l2_m_arity[mi] && l2_ty_raw_c_members(l2_ft(mi, rj)) = 0 && l2_ft(mi, rj) != 7
            return: l2_error(path, stmt, "unsupported body")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && raw = 0 && rj >= l2_m_arity[mi] && rj < l2_m_arity[mi] + l2_m_sn[mi] && l2_ty_raw_c_members(l2_st[l2_slot_off(mi, rj - l2_m_arity[mi])]) = 0
            return: l2_error(path, stmt, "unknown foreign field")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && ix != 0 && pd != 0 && (stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || (l2_own_find(mi, stmt\as\frame\head) < 0 && l2_slot_find(mi, stmt\as\frame\head) < 0 && l2_find_method(stmt\as\frame\head) < 0 && l2_param_find(mi, stmt\as\frame\head) < 0 && raw != 0 && l2_is_known(stmt\as\frame\head) = 0 && l2_is_path_head(stmt\as\frame\head) = 0))
            if: stmt\as\frame\head != 0 && stmt\as\frame\head\data != 0 && stmt\as\frame\head\length < 256U && l2_seg_count(stmt\as\frame\head\data, stmt\as\frame\head\length) > 1
                return: l2_error(path, stmt, "unknown field path root")
            return: l2_error(path, stmt, "unsupported body")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0
            fr: stmt\as\frame
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && fr\trailer != 0
            return: l2_error(path, stmt, "unsupported trailer")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && (fr\body = 0 || fr\body\trailer != 0)
            return: l2_error(path, stmt, "unsupported trailer")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && fr\body != 0 && fr\body\trailer != 0
            return: l2_error(path, stmt, "unsupported trailer")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && l2_m_ret[mi] = 8 && l2_count_active(fr\body) != 0
            return: l2_error(path, stmt, "unsupported body")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && l2_m_ret[mi] != 8 && l2_count_active(fr\body) = 0 && mi != l2_e
            return: l2_error(path, stmt, "unsupported body")
        # FABLE-SONNET-DIAG-AND-INDEX-20260924-163 commit 1 (D-40): the same
        # "no result" refusal l2_check_value_call gives for a bare callable
        # atom, not the generic entry-signature text this branch used to
        # give for a call-shaped return whose callee is a sub.
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && l2_count_active(fr\body) = 1 && l2_next_active(fr\body\first_field)\value != 0 && l2_next_active(fr\body\first_field)\value\kind = c.LM_P0_NODE_FRAME && l2_find_method(l2_next_active(fr\body\first_field)\value\as\frame\head) >= 0 && l2_m_ret[l2_find_method(l2_next_active(fr\body\first_field)\value\as\frame\head)] = 8
            return: l2_error(path, stmt, "a callable without a result has no value")
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) != 0 && l2_check_primary(stmt, mi, path) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) = 0 && l2_check_fields(fr\body\first_field, l2_count_active(fr\body), mi, path, stmt) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && l2_count_active(fr\body) = 1 && l2_next_active(fr\body\first_field) != 0 && l2_next_active(fr\body\first_field)\value != 0 && l2_next_active(fr\body\first_field)\value\kind = c.LM_P0_NODE_ATOM && l2_nsty_get(mi, 0 - 1) >= 0
            if: l2_admit_consumer_uses(l2_next_active(fr\body\first_field)\value\as\atom, l2_nsty_get(mi, 0 - 1), l2_next_active(fr\body\first_field)\value\as\atom, l2_fn_frame(mi), path, stmt, "return value") != 0
                return: 1
            ---
        ---
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && l2_check_return_literal(mi, fr\body, path, stmt) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") && l2_count_active(fr\body) != 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) = 0 && l2_check_fields(fr\body\first_field, l2_count_active(fr\body), mi, path, stmt) != 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0
            field: l2_next_active(field\next)
return: 0

fn: l2_parse_unit (const: @(char path)) int
    int: i 0
    # Merge result names are reserved here, before any statement is checked: a
    # field path rooted at a bound result is otherwise an unknown head at the
    # moment the unsupported-body guard runs. The scan is idempotent, and the
    # emitter runs it again when it needs the widest operand array.
    while: i < l2_m_n
        l2_vis_method(i)
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_merge_scan(l2_m_body[i]\as\structure) != 0
            return: 1
        i: i + 1
    l2_vis_on: 0
    # `Model: fresh` own-field rows and their nsty are also reserved here, same
    # reason and same precedent as the merge scan above (FABLE-SONNET-DECL-
    # PREPASS-20260923-137): l2_check_body always checks E last (S2), so a
    # unit-level Structure field's type must already be recorded before any
    # OTHER method's field-path segment walk can see it. l2_collect_asgn_binds
    # already does this scan (idempotent, l2_own_add's own rule); this call is
    # new, its later one (after checking, for the formal-assignment case it
    # also handles) is unchanged.
    if: l2_collect_asgn_binds(path) != 0
        return: 1
    i: 0
    if: l2_dyn_local(path) != 0
        return: 1
    l2_m_throws: (cast: (@: int) calloc((cast: (size_t) (l2_m_n + 1)), c.sizeof(c.int)))
    if: l2_m_throws = 0
        return: l2_error(path, 0, "out of memory")
    i: 0
    while: i < l2_m_n
        l2_vis_method(i)
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0
            l2_m_throws[i]: l2_body_throws(l2_m_body[i]\as\structure, i)
        i: i + 1
    ---
    i: 0
    l2_msend_i: 0
    while: i < l2_m_n
        l2_vis_method(i)
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_ml_rebuild(l2_m_body[i]\as\structure, path) != 0
            return: 1
        l2_cur_mi: i
        # An entry with no statement is an empty program; nothing to check.
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && (i != l2_e || l2_e_n != 0) && l2_check_body(l2_m_body[i]\as\structure, i, path, 0) != 0
            return: 1
        if: l2_m_node[i] != 0 && l2_m_node[i]\as != 0 && l2_check_ret_tr(i, path, l2_ret_tr(l2_m_node[i]\as\frame), l2_m_node[i]) != 0
            return: 1
        i: i + 1
    l2_cur_mi: 0 - 1
    l2_vis_on: 0
    if: l2_throws_close() != 0
        return: 1
    if: l2_reach_close(path) != 0
        return: 1
    if: l2_dyn_close(path) != 0
        return: 1
    if: l2_collect_asgn_binds(path) != 0
        return: 1
    # The entry has no caller, so nothing can hand it a dynamic input: a name it
    # reads before anything above declares it is unresolved.
    if: l2_e >= 0 && l2_m_dyn[l2_e] != 0
        if: l2_dn(l2_e, 0) != 0
            c.fprintf(l1_stderr(), "l2trans detail: unresolved entry name=%.*s\n", (cast: (int) l2_dn(l2_e, 0)\length), l2_dn(l2_e, 0)\data)
        return: l2_error(path, 0, "unresolved name")
    i: 0
    while: i < l2_m_n
        l2_m_sig[i]: l2_intern_mi(i)
        if: l2_m_sig[i] = 0U && l2_alloc_err = 2
            return: l2_error(path, l2_m_node[i], "size overflow")
        if: l2_m_sig[i] = 0U
            return: l2_error(path, l2_m_node[i], "out of memory")
        i: i + 1
    if: l2_m_n != 0 && l2_intern_prove(path, l2_m_node[0]) != 0
        return: 1
return: 0

fn: l2_tok_text (const: @(LmP0Text t); @: char dest; size_t: cap) int
    @: char buf 0
    size_t: n 0U
    int: rc
    if: t = 0 || t\data = 0 || dest = 0 || cap = 0U
        return: 1
    if: l2_triple_q(t) != 0
        if: l2_decode_triple_body(t, @ buf, @ n) != 0
            return: 1
        if: buf = 0
            return: l2_fmt_l1_string(dest, cap, "", 0U)
        rc: l2_fmt_l1_string(dest, cap, buf, n)
        l2_xfree((cast: (@: void) buf))
        return: rc
    if: t\length + 1U > cap
        return: 1
    memcpy(dest, t\data, t\length)
    dest[t\length]: 0
return: 0

fn: l2_tok_temp (int: k; @: char dest) int
    if: dest = 0
        return: 1
    if: c.sprintf(dest, "l2_t%d", k) < 0
        return: 1
return: 0

fn: l2_cat (@: char dest; const: @(char src)) int
    size_t: nd
    size_t: ns
    if: dest = 0 || src = 0
        return: 1
    nd: strlen(dest)
    ns: strlen(src)
    if: nd + ns >= 1023U
        return: 1
    memcpy(dest + nd, src, ns + 1U)
return: 0

# Declare temp t with the type of own storage code oty and load the value cell l2_xp[0] into it.
# One emission for every reader of a value cell; a type without one is refused here, by name.
fn: l2_emit_cell_load (int: oty; const: @(char ind); int: t; const: @(LmP0Node at)) int
    if: ind = 0
        return: 1
    if: l2_own_store_helper(oty) = 0
        return: l2_error(l2_src, at, "type has no value cell to load from")
    if: oty = 0 && c.fprintf(l2_out, "%sint: l2_t%d\n%sl2_t%d: lmx_int_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
        return: 1
    if: oty = 1 && c.fprintf(l2_out, "%schar: l2_t%d\n%sl2_t%d: (cast: (char) lmx_char_value_known(l2_xp[0]))\n", ind, t, ind, t) < 0
        return: 1
    if: oty = 2 && c.fprintf(l2_out, "%ssize_t: l2_t%d\n%sl2_t%d: lmx_size_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
        return: 1
    if: oty = 3 && c.fprintf(l2_out, "%sunsigned: l2_t%d\n%sl2_t%d: lmx_unsigned_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
        return: 1
    if: oty = 36 && c.fprintf(l2_out, "%sulong: l2_t%d\n%sl2_t%d: lmx_ulong_value_known(l2_xp[0])\n", ind, t, ind, t) < 0
        return: 1
    if: l2_own_is_pointer(oty) != 0
        if: fputs(ind, l2_out) < 0 || l2_emit_own_pointer_type(l2_out, oty) != 0 || c.fprintf(l2_out, " l2_t%d\n%sl2_t%d: (cast: (", t, ind, t) < 0 || l2_emit_own_pointer_type(l2_out, oty) != 0 || fputs(") lmx_pointer_value_known(l2_xp[0]))\n", l2_out) < 0
            return: 1
    ---
return: 0

fn: l2_hidden_from (int: mi; int: callee; int: k; int: callee_self; const: @(char ind); @: char dest; const: @(LmP0Node at)) int
    @: LmP0Text nm
    int: ty
    int: pi
    int: oi
    int: fi
    int: t
    int: child
    int: ni
    @: char deep 0
    c.array: [1024]: char l2_hf_msg
    if: dest = 0 || callee < 0 || k < 0 || k >= l2_m_dyn[callee]
        return: 1
    nm: l2_dn(callee, k)
    ty: l2_dt(callee, k)
    dest[0]: 0
    pi: -1
    pi: l2_param_find(mi, nm)
    if: pi >= 0
        return: l2_tok_formal(mi, pi, dest)
    oi: -1
    oi: l2_own_find_last(mi, nm)
    fi: -1
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0
        fi: l2_m_alias[l2_own_off(mi, oi)]
    if: fi >= 0
        return: l2_tok_formal(mi, fi, dest)
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0 && l2_own_load(oi, dest) != 0
        return: 1
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0
        return: 0
    # No caller binding: use the declaration in the selected callee's lexical
    # node.  This is deliberately after declared and inherited caller inputs,
    # and uses the captured occurrence rather than the translator-global unit.
    # Names resolve lexically and backward, never cross-method (author norm,
    # FABLE-SONNET-OWN-LOOKUP-AUDIT-20260923-131 ruling): the lookup is
    # l2_own_find scoped to callee specifically, the same one callee's own
    # body would use for this name -- not a name-only scan over every
    # method's own table (l2_own_first, deleted, was exactly that: the
    # first same-named field in source order, any method, callee or not).
    ni: l2_ns_find(nm)
    if: ty = l2_colon_graph_ty() && ni >= 0 && l2_ns_parent[ni] < 0 && callee_self >= 0
        if: c.sprintf(dest, "lmx_arena_ref_struct(l2_c%d\\parent, %uU)", callee_self, (cast: (unsigned) (l2_ns_base + l2_ns_rank(ni)))) < 0
            return: 1
        return: 0
    child: l2_own_find_last(callee, nm)
    if: child < 0
        if: c.snprintf(l2_hf_msg, 256U, "unbound dynamic input %.*s", (cast: (int) nm\length), nm\data) < 0
            return: 1
        return: l2_error(l2_src, at, l2_hf_msg)
    if: l2_own_uchild[child] < 0 || l2_call_node = 0
        return: 1
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_xp: lmx_arena_ref_cell(%s, %uU)\n%sif: l2_xp = 0\n", ind, l2_own_ctr(child), (cast: (unsigned) l2_own_uchild[child]), ind) < 0
        return: 1
    if: l2_m_ret[mi] = 8 && (l2_m_throws = 0 || l2_m_throws[mi] = 0) && c.fprintf(l2_out, "%sreturn\n", deep) < 0
        return: 1
    if: l2_m_ret[mi] = 8 && l2_m_throws != 0 && l2_m_throws[mi] != 0 && c.fprintf(l2_out, "%sreturn: 0\n", deep) < 0
        return: 1
    if: l2_ret_uns(mi) != 0 && (l2_m_throws = 0 || l2_m_throws[mi] = 0) && c.fprintf(l2_out, "%sreturn: 0U\n", deep) < 0
        return: 1
    if: l2_ret_uns(mi) != 0 && l2_m_throws != 0 && l2_m_throws[mi] != 0 && c.fprintf(l2_out, "%sl2_out_result[0]: 0U\n%sreturn: 0\n", deep, deep) < 0
        return: 1
    if: l2_ret_uns(mi) = 0 && l2_m_ret[mi] != 8 && (l2_m_throws = 0 || l2_m_throws[mi] = 0) && c.fprintf(l2_out, "%sreturn: 0\n", deep) < 0
        return: 1
    if: l2_ret_uns(mi) = 0 && l2_m_ret[mi] != 8 && l2_m_throws != 0 && l2_m_throws[mi] != 0 && c.fprintf(l2_out, "%sl2_out_result[0]: 0\n%sreturn: 0\n", deep, deep) < 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_own_is_slot(child) != 0 && l2_emit_own_cell_load(child, ind, t, 0) != 0
        return: 1
    if: l2_own_is_slot(child) = 0 && l2_emit_cell_load(l2_own_of_dt(ty), ind, t, 0) != 0
        return: 1
    if: c.sprintf(dest, "l2_t%d", t) < 0
        return: 1
return: 0

# Formal (or dynamic input) fi of mi as its code reads it here: its bound field's cell once bound
# (l2_formal_row, -189 c3b-2), the machine argument before.
fn: l2_tok_formal (int: mi; int: fi; @: char dest) int
    int: k l2_formal_row(mi, fi)
    if: dest = 0
        return: 1
    if: k >= 0
        return: l2_own_load(k, dest)
    if: c.sprintf(dest, "l2_p%d_%d", mi, fi) < 0
        return: 1
return: 0

fn: l2_tok_slot (int: mi; int: si; @: char dest) int
    if: dest = 0
        return: 1
    if: c.sprintf(dest, "l2_s%d_%d", mi, si) < 0
        return: 1
return: 0

fn: l2_check_addr (const: @(LmP0Node node); int: mi; const: @(char path)) int
    @: LmP0Field f
    @: LmP0Field g
    @: LmP0Field h
    const: @: LmP0Text t
    int: idx
    int: oi
    if: node = 0 || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0
        return: l2_error(path, node, "incompatible entry signature")
    # @ name \field: the address OF a field. An intrusive list walks with a
    # cursor that points at the next link itself, not at the node holding it.
    if: l2_count_active(node\as\frame\body) = 3
        f: l2_next_active(node\as\frame\body\first_field)
        g: l2_next_active(f\next)
        h: l2_next_active(g\next)
        if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || l2_is_slash(g\value\as\atom) = 0 || h = 0 || h\value = 0 || h\value\kind != c.LM_P0_NODE_ATOM || l2_ident(h\value\as\atom) = 0
            return: l2_error(path, node, "incompatible entry signature")
        if: l2_addr_names_eternal(f, h) != 0
            return: l2_error(path, node, "the address of an eternal branch field cannot be taken")
        return: l2_check_primary(f\value, mi, path)
    if: l2_count_active(node\as\frame\body) != 1
        return: l2_error(path, node, "incompatible entry signature")
    f: l2_next_active(node\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_ident(f\value\as\atom) = 0
        return: l2_error(path, node, "incompatible entry signature")
    t: f\value\as\atom
    idx: -1
    if: l2_ml_find(t) >= 0 && l2_ml_ty[l2_ml_find(t)] = 41
        return: 0
    idx: l2_param_find(mi, t)
    if: idx >= 0
        return: 0
    oi: -1
    oi: l2_own_find_last(mi, t)
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0 && l2_own_is_array(l2_own_ty[oi]) = 0
        return: 0
return: l2_error(path, node, "unresolved name")

fn: l2_prep_addr (const: @(LmP0Node node); int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field f
    const: @: LmP0Text t
    int: idx
    int: oi
    int: fi
    int: temp
    size_t: pn
    int: pni
    int: pres
    int: poi
    int: proot
    int: pfi
    int: pkind
    c.array: [1024]: char nm
    if: node = 0 || dest = 0 || ind = 0 || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0
        return: 1
    # @: Named\field on a mutable named Structure: the existing field-path
    # walk leaves l2_pxp on the leaf cell; the address is a typed pointer to
    # that cell. Eternal named fields are refused in l2_check_addr (M0).
    if: l2_count_active(node\as\frame\body) = 3
        f: node\as\frame\body\first_field
        nm[0]: 0
        pn: l2_join_path(f, 3, nm, 255U)
        pni: 0 - 1
        pres: 0 - 1
        if: pn != 0U && l2_path_root(nm, pn, @ pni, @ pres, @ poi, @ proot, @ pfi) = 0 && pni >= 0
            pkind: 0
            if: l2_emit_path(nm, pn, mi, ind, node, @ pkind) != 0
                return: 1
            if: pkind = 0 && c.sprintf(dest, "(cast: (@: size_t) l2_pxp[0])") < 0
                return: 1
            if: pkind = 1 && c.sprintf(dest, "(cast: (@: char) l2_pxp[0])") < 0
                return: 1
            if: pkind != 0 && pkind != 1
                return: 1
            return: 0
        ---
        nm[0]: 0
        if: l2_emit_fields(l2_next_active(node\as\frame\body\first_field), 3, mi, "", nm) != 0
            return: 1
        if: c.sprintf(dest, "@ %s", nm) < 0
            return: 1
        return: 0
    if: l2_count_active(node\as\frame\body) != 1
        return: 1
    f: l2_next_active(node\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
        return: 1
    t: f\value\as\atom
    idx: -1
    if: l2_ml_find(t) >= 0 && l2_ml_ty[l2_ml_find(t)] = 41
        if: l2_tok_text(t, nm, 256U) != 0
            return: 1
        if: c.sprintf(dest, "@ %s", nm) < 0
            return: 1
        return: 0
    idx: l2_param_find(mi, t)
    # -189 c3b-2: after its binding line a formal is its field, and `@x` that field's cell (L2 §10).
    if: idx >= 0 && l2_formal_row(mi, idx) >= 0
        return: l2_own_addr(l2_formal_row(mi, idx), dest)
    if: idx >= 0
        if: c.sprintf(dest, "@ l2_p%d_%d", mi, idx) < 0
            return: 1
        return: 0
    oi: -1
    oi: l2_own_find_last(mi, t)
    if: oi < 0 || l2_m_uses[l2_own_off(mi, oi)] = 0
        return: 1
    if: l2_own_is_array(l2_own_ty[oi]) != 0
        return: 1
    # For an argument-as-own bind the argument branch above has already
    # returned its ordinary C address. A graph-backed own has a different
    # address: the typed payload cell selected by its child slot. Taking that
    # address neither writes nor dirties the activation cache.
    fi: l2_m_alias[l2_own_off(mi, oi)]
    if: fi >= 0 && c.sprintf(dest, "@ l2_p%d_%d", mi, fi) < 0
        return: 1
    if: fi >= 0
        return: 0
    if: l2_own_ty[oi] = 0 && c.sprintf(dest, "(cast: (@: int) l2_q%d_from[0])", oi) < 0
        return: 1
    if: l2_own_ty[oi] = 1 && c.sprintf(dest, "(cast: (@: char) l2_q%d_from[0])", oi) < 0
        return: 1
    if: l2_own_ty[oi] = 2 && c.sprintf(dest, "(cast: (@: size_t) l2_q%d_from[0])", oi) < 0
        return: 1
    if: l2_own_ty[oi] = 3 && c.sprintf(dest, "(cast: (@: unsigned) l2_q%d_from[0])", oi) < 0
        return: 1
    if: l2_own_ty[oi] = 36 && c.sprintf(dest, "(cast: (@: ulong) l2_q%d_from[0])", oi) < 0
        return: 1
    if: l2_own_is_slot(oi) != 0
        return: l2_error(l2_src, node, "an own Structure field has no cell address")
    if: l2_own_is_pointer(l2_own_ty[oi]) != 0
        temp: l2_tn
        l2_tn: l2_tn + 1
        if: fputs(ind, l2_out) < 0 || l2_emit_raw_pointer_type(l2_out, l2_own_ty[oi] - 1000, 1) != 0 || c.fprintf(l2_out, " l2_t%d\n%sl2_t%d: (cast: (", temp, ind, temp) < 0 || l2_emit_raw_pointer_type(l2_out, l2_own_ty[oi] - 1000, 1) != 0 || c.fprintf(l2_out, ") l2_q%d_from[0])\n", oi) < 0
            return: 1
        if: c.sprintf(dest, "l2_t%d", temp) < 0
            return: 1
        return: 0
    ---
    if: l2_own_ty[oi] != 0 && l2_own_ty[oi] != 1 && l2_own_ty[oi] != 2 && l2_own_ty[oi] != 3 && l2_own_ty[oi] != 36
        return: 1
return: 0

# A word of a multi-word C type name in a cast: `unsigned long`, `long long`.
fn: l2_ctype_word (const: @(LmP0Text t)) int
return: l2_text_eq(t, "unsigned") || l2_text_eq(t, "signed") || l2_text_eq(t, "long") || l2_text_eq(t, "short") || l2_text_eq(t, "int") || l2_text_eq(t, "char") || l2_text_eq(t, "double")

fn: l2_cast_type (const: @(LmP0Node node); @: char dest) int
    @: LmP0Field f
    @: LmP0Field g
    const: @: LmP0Node item
    @: LmP0Field inner
    const: @: LmP0Node nested
    int: depth
    int: i
    size_t: out_end
    size_t: skip 0U
    if: node = 0 || dest = 0 || node\kind != c.LM_P0_NODE_STRUCTURE || node\as = 0 || node\as\structure = 0
        return: 1
    f: l2_next_active(node\as\structure\first_field)
    if: l2_count_active(node\as\structure) = 2
        g: l2_next_active(f\next)
        # A two-word C type is spelled as written (5e, process_marker 212:71).
        if: f != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && g != 0 && g\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM && l2_ctype_word(f\value\as\atom) && l2_ctype_word(g\value\as\atom)
            if: f\value\as\atom\length + g\value\as\atom\length + 2U >= 256U
                return: 1
            if: c.sprintf(dest, "%.*s %.*s", (cast: (int) f\value\as\atom\length), f\value\as\atom\data, (cast: (int) g\value\as\atom\length), g\value\as\atom\data) < 0
                return: 1
            return: 0
        ---
        return: 1
    if: l2_count_active(node\as\structure) != 1
        return: 1
    item: f\value
    if: item != 0 && item\kind = c.LM_P0_NODE_ATOM && (l2_ident(item\as\atom) || l2_text_eq(item\as\atom, "int") || l2_text_eq(item\as\atom, "char") || l2_text_eq(item\as\atom, "size_t") || l2_text_eq(item\as\atom, "unsigned") || l2_text_eq(item\as\atom, "void"))
        return: l2_tok_text(item\as\atom, dest, 256U)
    if: item = 0 || item\kind != c.LM_P0_NODE_FRAME || item\as = 0 || item\as\frame = 0
        return: 1
    if: l2_frame_head(item, "const")
        if: item\as\frame\body = 0 || l2_count_active(item\as\frame\body) != 1
            return: 1
        inner: l2_next_active(item\as\frame\body\first_field)
        if: inner = 0 || inner\value = 0 || inner\value\kind != c.LM_P0_NODE_FRAME || inner\value\as = 0 || inner\value\as\frame = 0
            return: 1
        nested: inner\value
        depth: l2_address_depth(nested\as\frame\head)
        if: depth = 0 || nested\as\frame\body = 0 || l2_count_active(nested\as\frame\body) != 1
            return: 1
        inner: l2_next_active(nested\as\frame\body\first_field)
        if: inner = 0 || inner\value = 0 || inner\value\kind != c.LM_P0_NODE_ATOM || (l2_ident(inner\value\as\atom) = 0 && l2_text_eq(inner\value\as\atom, "int") = 0)
            return: 1
        if: (cast: (size_t) depth) + inner\value\as\atom\length + 10U >= 256U
            return: 1
        memcpy(dest, "const: ", 7U)
        i: 0
        while: i < depth
            dest[7 + i]: 64
            i: i + 1
        dest[7 + depth]: 40
        memcpy(dest + 8 + depth, inner\value\as\atom\data, inner\value\as\atom\length)
        out_end: (cast: (size_t) depth) + 8U + inner\value\as\atom\length
        dest[out_end]: 41
        dest[out_end + 1U]: 0
        return: 0
    ---
    depth: l2_address_depth(item\as\frame\head)
    if: depth = 0 || item\as\frame\body = 0 || l2_count_active(item\as\frame\body) != 1
        return: 1
    inner: l2_next_active(item\as\frame\body\first_field)
    if: inner = 0 || inner\value = 0 || inner\value\kind != c.LM_P0_NODE_ATOM || (l2_ident(inner\value\as\atom) = 0 && l2_text_eq(inner\value\as\atom, "int") = 0 && l2_is_known(inner\value\as\atom) = 0)
        return: 1
    if: (cast: (size_t) depth) + inner\value\as\atom\length + 3U >= 256U
        return: 1
    i: 0
    while: i < depth
        dest[i]: 64
        i: i + 1
    dest[depth]: 58
    dest[depth + 1]: 32
    # c.NAME is the L2 door; the C type is NAME.
    skip: 0U
    if: l2_is_known(inner\value\as\atom) != 0 && inner\value\as\atom\length > 2U && inner\value\as\atom\data[0] = 99 && inner\value\as\atom\data[1] = 46
        skip: 2U
    memcpy(dest + depth + 2, inner\value\as\atom\data + skip, inner\value\as\atom\length - skip)
    out_end: (cast: (size_t) depth) + 2U + inner\value\as\atom\length - skip
    dest[out_end]: 0
return: 0

# True when a names exactly the n bytes at d.
fn: l2_text_is_bytes (const: @(LmP0Text a); const: @(char d); size_t: n) int
    if: a = 0 || a\data = 0 || d = 0 || a\length != n
        return: 0
return: memcmp(a\data, d, n) = 0

# sizeof: operand name bytes. Formals and scalar/array/pointer owns.
# Returns 2 when the name is not lowered here; caller may accept a type or refuse.
fn: l2_sizeof_name_bytes (const: @(LmP0Node node); const: @(char d); size_t: b; size_t: e; int: mi; const: @(char ind); @: char dest) int
    c.array: [1024]: char l2_szt
    size_t: n 0U
    size_t: i 0U
    int: k 0
    int: oi -1
    int: t 0
    if: d = 0 || dest = 0 || e <= b
        return: 2
    n: e - b
    if: n > 200U
        return: 2
    if: d[b] != 95 && (d[b] < 65 || d[b] > 90) && (d[b] < 97 || d[b] > 122)
        return: 2
    i: b
    while: i < e
        if: d[i] != 95 && (d[i] < 65 || d[i] > 90) && (d[i] < 97 || d[i] > 122) && (d[i] < 48 || d[i] > 57)
            return: 2
        i: i + 1U
    k: 0
    while: k < l2_m_arity[mi]
        if: l2_text_is_bytes(l2_fn(mi, k), d + b, n)
            if: c.sprintf(dest, "c.sizeof(l2_p%d_%d)", mi, k) < 0
                return: 1
            return: 0
        k: k + 1
    ---
    k: 0
    while: k < l2_own_n && oi < 0
        if: l2_own_mi[k] = mi && l2_text_is_bytes(l2_own_name[k], d + b, n) && (l2_own_host[k] = 0 || l2_scope_has(l2_own_host[k]))
            oi: k
        k: k + 1
    ---
    k: 0
    while: k < l2_own_n && oi < 0
        if: l2_own_unit_seen(k, mi) != 0 && l2_text_is_bytes(l2_own_name[k], d + b, n)
            oi: k
        k: k + 1
    if: oi < 0
        return: 2
    if: l2_own_is_array(l2_own_ty[oi]) != 0
        if: l2_own_count[oi] = 0
            return: l2_error(l2_src, node, "sizeof: requires a known own array length")
        if: l2_own_ty[oi] = 4
            if: c.sprintf(dest, "(%.*s * c.sizeof(c.int))", (cast: (int) l2_own_count[oi]\length), l2_own_count[oi]\data) < 0
                return: 1
            return: 0
        ---
        if: l2_own_ty[oi] = 5
            if: c.sprintf(dest, "(%.*s * c.sizeof(c.char))", (cast: (int) l2_own_count[oi]\length), l2_own_count[oi]\data) < 0
                return: 1
            return: 0
        ---
        if: l2_own_ty[oi] = 7
            if: c.sprintf(dest, "(%.*s * c.sizeof(c.size_t))", (cast: (int) l2_own_count[oi]\length), l2_own_count[oi]\data) < 0
                return: 1
            return: 0
        ---
        if: l2_own_ty[oi] = 8
            if: c.sprintf(dest, "(%.*s * c.sizeof(c.unsigned))", (cast: (int) l2_own_count[oi]\length), l2_own_count[oi]\data) < 0
                return: 1
            return: 0
        ---
        if: l2_own_ty[oi] = 37
            if: c.sprintf(dest, "(%.*s * c.sizeof(c.ulong))", (cast: (int) l2_own_count[oi]\length), l2_own_count[oi]\data) < 0
                return: 1
            return: 0
        ---
        return: l2_error(l2_src, node, "sizeof: of this own array type not yet implemented")
    ---
    if: l2_own_is_pointer(l2_own_ty[oi]) != 0
        if: l2_m_uses[l2_own_off(mi, oi)] != 0
            if: l2_pointer_decl_text(l2_own_ty[oi] - 1000, 0, 0, l2_szt) != 0 || c.sprintf(dest, "c.sizeof(%s)", l2_szt) < 0
                return: 1
            return: 0
        ---
        # Unused pointer own has no generated C local; emit pointer-cell storage size.
        if: c.sprintf(dest, "c.sizeof(@: void)") < 0
            return: 1
        return: 0
    ---
    if: l2_own_ty[oi] != 0 && l2_own_ty[oi] != 1 && l2_own_ty[oi] != 2 && l2_own_ty[oi] != 3 && l2_own_ty[oi] != 36
        return: l2_error(l2_src, node, "sizeof: of this own field type not yet implemented")
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_own_ty[oi] = 0 && c.fprintf(l2_out, "%sint: l2_t%d 0\n", ind, t) < 0
        return: 1
    if: l2_own_ty[oi] = 1 && c.fprintf(l2_out, "%schar: l2_t%d 0\n", ind, t) < 0
        return: 1
    if: l2_own_ty[oi] = 2 && c.fprintf(l2_out, "%ssize_t: l2_t%d 0U\n", ind, t) < 0
        return: 1
    if: l2_own_ty[oi] = 3 && c.fprintf(l2_out, "%sunsigned: l2_t%d 0U\n", ind, t) < 0
        return: 1
    if: l2_own_ty[oi] = 36 && c.fprintf(l2_out, "%sulong: l2_t%d 0U\n", ind, t) < 0
        return: 1
    if: c.sprintf(dest, "c.sizeof(l2_t%d)", t) < 0
        return: 1
return: 0

# sizeof: receiver-operator (class length/cast): storage size in bytes.
# Not a callable. c.sizeof(...) stays raw C through the c.* door.
fn: l2_emit_sizeof (const: @(LmP0Node node); int: mi; const: @(char ind); @: char dest) int
    @: LmP0Frame call
    const: @: LmP0Text tn
    @: LmP0Field a0
    int: k
    int: ml
    int: si
    c.array: [1024]: char s0
    if: node = 0 || dest = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: 1
    call: node\as\frame
    if: l2_text_eq(call\head, "sizeof") = 0
        return: 1
    if: call\body = 0 || call\trailer != 0 || call\body\trailer != 0 || l2_count_active(call\body) != 1
        return: l2_error(l2_src, node, "sizeof: requires one operand")
    a0: l2_next_active(call\body\first_field)
    if: a0 = 0 || a0\value = 0
        return: 1
    if: a0\value\kind = c.LM_P0_NODE_FRAME && a0\value\as != 0 && a0\value\as\frame != 0 && l2_address_depth(a0\value\as\frame\head) != 0
        tn: l2_sizeof_type_frame(a0\value)
        if: tn = 0
            return: l2_error(l2_src, node, "sizeof: a type frame names a primitive type")
        if: a0\value\as\frame\head\length + tn\length + 14U >= 256U
            return: l2_error(l2_src, node, "expression too long")
        if: c.sprintf(dest, "c.sizeof(%.*s: %.*s)", (cast: (int) a0\value\as\frame\head\length), a0\value\as\frame\head\data, (cast: (int) tn\length), tn\data) < 0
            return: 1
        return: 0
    ---
    if: a0\value\kind != c.LM_P0_NODE_ATOM || a0\value\as = 0 || a0\value\as\atom = 0
        return: l2_error(l2_src, node, "sizeof: unsupported operand")
    if: l2_prim_type_word(a0\value\as\atom)
        if: c.sprintf(dest, "c.sizeof(%.*s)", (cast: (int) a0\value\as\atom\length), a0\value\as\atom\data) < 0
            return: 1
        return: 0
    ---
    if: a0\value\as\atom\length > 2U && a0\value\as\atom\data[0] = 99 && a0\value\as\atom\data[1] = 46
        if: c.sprintf(dest, "c.sizeof(%.*s)", (cast: (int) a0\value\as\atom\length), a0\value\as\atom\data) < 0
            return: 1
        return: 0
    ---
    k: l2_sizeof_name_bytes(node, a0\value\as\atom\data, 0U, a0\value\as\atom\length, mi, ind, dest)
    if: k != 2
        return: k
    ml: l2_ml_find(a0\value\as\atom)
    if: ml >= 0
        if: c.sprintf(dest, "c.sizeof(%.*s)", (cast: (int) a0\value\as\atom\length), a0\value\as\atom\data) < 0
            return: 1
        return: 0
    ---
    si: l2_slot_find(mi, a0\value\as\atom)
    if: si >= 0
        if: c.sprintf(dest, "c.sizeof(l2_s%d_%d)", mi, si) < 0
            return: 1
        return: 0
    ---
    if: l2_ns_find(a0\value\as\atom) >= 0 || l2_find_method(a0\value\as\atom) >= 0
        if: c.sprintf(dest, "c.sizeof(@: void)") < 0
            return: 1
        return: 0
    ---
return: l2_error(l2_src, node, "unresolved name")

# The type a sizeof: type frame names (`@: T`, `@@: T`): its one atom when that is a primitive type
# word, 0 otherwise.  L1 lowers `c.sizeof(@: T)` to C `sizeof(T *)` for exactly these; any other
# name it reads as an address (`sizeof(&T)`).  Every data pointer has one size: `sizeof(@: void)`.
fn: l2_sizeof_type_frame (const: @(LmP0Node frame)) const: @: LmP0Text
    @: LmP0Field f
    const: @: LmP0Text t
    if: frame = 0 || frame\kind != c.LM_P0_NODE_FRAME || frame\as = 0 || frame\as\frame = 0 || frame\as\frame\body = 0
        return: 0
    if: l2_count_active(frame\as\frame\body) != 1
        return: 0
    f: l2_next_active(frame\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
        return: 0
    t: f\value\as\atom
    if: l2_prim_type_word(t) != 0
        return: t
return: 0

fn: l2_check_sizeof (const: @(LmP0Node node); int: mi; const: @(char path)) int
    @: LmP0Frame call
    @: LmP0Field a0
    int: oi
    int: ml
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: 1
    call: node\as\frame
    if: l2_text_eq(call\head, "sizeof") = 0
        return: 1
    if: call\body = 0 || call\trailer != 0 || call\body\trailer != 0 || l2_count_active(call\body) != 1
        return: l2_error(path, node, "sizeof: requires one operand")
    a0: l2_next_active(call\body\first_field)
    if: a0 = 0 || a0\value = 0
        return: l2_error(path, node, "sizeof: requires one operand")
    if: a0\value\kind = c.LM_P0_NODE_FRAME && a0\value\as != 0 && a0\value\as\frame != 0 && l2_address_depth(a0\value\as\frame\head) != 0
        if: l2_sizeof_type_frame(a0\value) = 0
            return: l2_error(path, node, "sizeof: a type frame names a primitive type")
        return: 0
    if: a0\value\kind != c.LM_P0_NODE_ATOM || a0\value\as = 0 || a0\value\as\atom = 0
        return: l2_error(path, node, "sizeof: unsupported operand")
    if: l2_prim_type_word(a0\value\as\atom)
        return: 0
    if: a0\value\as\atom\length > 2U && a0\value\as\atom\data[0] = 99 && a0\value\as\atom\data[1] = 46
        return: 0
    # D-10 (steps/defects.md): l2_own_find and l2_own_find_last differ only
    # in WHICH own-scope match they return when several exist (first vs
    # last); both share the exact same unit-fallback phase, so one finds
    # nothing only where the other does too. This site only asks whether
    # the name resolves at all -- a single try is enough.
    oi: l2_own_find(mi, a0\value\as\atom)
    if: oi >= 0
        return: 0
    if: l2_formal_find(mi, a0\value\as\atom) >= 0
        return: 0
    ml: l2_ml_find(a0\value\as\atom)
    if: ml >= 0
        return: 0
    if: l2_ns_find(a0\value\as\atom) >= 0 || l2_find_method(a0\value\as\atom) >= 0
        return: 0
    if: l2_slot_find(mi, a0\value\as\atom) >= 0
        return: 0
return: l2_error(path, node, "unresolved name")

# Nullary invoke of METHOD idx (unit occurrence or formal occurrence self).
# call_sel 0 = unit method; 2 = callable formal at call_fi. Writes result token to dest.
# Structural METHOD signature equality for callable-formal admission.
fn: l2_cf_set (int: omi; int: fk; int: req) int
    int: i 0
    int: cap
    @: int nomi 0
    @: int nfk 0
    @: int nreq 0
    if: omi < 0 || fk < 0
        return: 1
    while: i < l2_cf_n
        if: l2_cf_omi[i] = omi && l2_cf_fk[i] = fk
            l2_cf_req[i]: req
            return: 0
        i: i + 1
    ---
    if: l2_cf_n >= l2_cf_cap
        cap: l2_cf_cap
        if: cap < 1
            cap: 8
        ---
        while: cap <= l2_cf_n
            if: cap > ((cast: (size_t) -1) / 2U)
                return: 1
            cap: cap * 2
        ---
        nomi: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        nfk: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        nreq: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        if: nomi = 0 || nfk = 0 || nreq = 0
            if: nomi != 0
                free((cast: (@: void) nomi))
            ---
            if: nfk != 0
                free((cast: (@: void) nfk))
            ---
            if: nreq != 0
                free((cast: (@: void) nreq))
            ---
            return: 1
        ---
        if: l2_cf_n > 0
            memcpy((cast: (@: void) nomi), (cast: (@: void) l2_cf_omi), (cast: (size_t) l2_cf_n) * c.sizeof(c.int))
            memcpy((cast: (@: void) nfk), (cast: (@: void) l2_cf_fk), (cast: (size_t) l2_cf_n) * c.sizeof(c.int))
            memcpy((cast: (@: void) nreq), (cast: (@: void) l2_cf_req), (cast: (size_t) l2_cf_n) * c.sizeof(c.int))
        ---
        if: l2_cf_omi != 0
            free((cast: (@: void) l2_cf_omi))
        ---
        if: l2_cf_fk != 0
            free((cast: (@: void) l2_cf_fk))
        ---
        if: l2_cf_req != 0
            free((cast: (@: void) l2_cf_req))
        ---
        l2_cf_omi: nomi
        l2_cf_fk: nfk
        l2_cf_req: nreq
        l2_cf_cap: cap
    ---
    l2_cf_omi[l2_cf_n]: omi
    l2_cf_fk[l2_cf_n]: fk
    l2_cf_req[l2_cf_n]: req
    l2_cf_n: l2_cf_n + 1
return: 0

fn: l2_cf_get (int: omi; int: fk) int
    int: i 0
    if: omi < 0 || fk < 0
        return: 0 - 1
    while: i < l2_cf_n
        if: l2_cf_omi[i] = omi && l2_cf_fk[i] = fk
            return: l2_cf_req[i]
        i: i + 1
    ---
return: 0 - 1

fn: l2_method_sig_compatible (int: cand; int: req) int
    int: j 0
    if: cand < 0 || req < 0
        return: 0
    if: cand = req
        return: 1
    if: l2_m_arity[cand] != l2_m_arity[req]
        return: 0
    if: l2_m_ret[cand] != l2_m_ret[req]
        return: 0
    if: l2_throws_same(cand, req) = 0
        return: 0
    while: j < l2_m_arity[cand]
        if: l2_ft(cand, j) != l2_ft(req, j)
            return: 0
        j: j + 1
return: 1

fn: l2_prep (const: @(LmP0Node node); int: mi; const: @(char ind); @: char dest) int
    c.array: [1024]: char lpd
    size_t: lpn 0U
    int: lkind 0
    int: lelem 0
    int: ldepth 0
    size_t: li0 0U
    const: @: LmP0Frame call
    @: LmP0Field a0
    @: LmP0Field a1
    int: t
    int: idx
    int: n
    int: k
    int: occ 0
    @: LmP0Text onm 0
    int: actual_span
    int: raw_j
    int: raw_fld
    c.array: [1024]: char s0
    c.array: [1024]: char s1
    c.array: [1024]: char s2
    c.array: [1024]: char s3
    c.array: [1024]: char s4
    size_t: array_index
    if: node = 0 || dest = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_ATOM
        k: l2_occ_head(node\as\atom, @ occ, @ onm)
        if: k = 2
            return: 1
        if: k = 0
            idx: l2_own_find_occ(mi, onm, occ)
            if: onm != 0
                l2_xfree((cast: (@: void) onm))
            if: idx < 0
                return: l2_error(l2_src, node, "own occurrence index out of range")
            if: l2_m_uses[l2_own_off(mi, idx)] != 0
                if: l2_own_load(idx, dest) != 0
                    return: 1
                return: 0
            ---
            return: 1
        ---
        k: l2_prefix_deref(node\as\atom, mi, ind, dest)
        if: k = 0
            return: 0
        if: k = 2
            return: 1
        if: l2_own_index_head(node\as\atom, mi, @ idx, @ array_index) = 0
            return: l2_emit_array_load(idx, array_index, ind, dest)
        # A callable formal of this method named as a value is its callable's result
        # (l2_check_primary): called with no arguments through lmx_call0.
        idx: l2_param_find(mi, node\as\atom)
        if: idx >= 0 && idx < l2_m_arity[mi] && l2_cf_get(mi, idx) >= 0
            return: l2_emit_call(node, l2_cf_get(mi, idx), 2, idx, 0, mi, ind, dest)
        if: idx >= 0
            return: l2_tok_formal(mi, idx, dest)
        ---
        # D-10 (steps/defects.md): the l2_own_find fallback here was dead --
        # see l2_check_sizeof's copy of this reasoning above.
        idx: l2_own_find_last(mi, node\as\atom)
        if: idx >= 0 && l2_own_is_array(l2_own_ty[idx]) != 0
            return: l2_emit_array_ptr(idx, ind, dest)
        if: idx >= 0 && l2_m_uses[l2_own_off(mi, idx)] != 0
            if: l2_own_load(idx, dest) != 0
                return: 1
            return: 0
        ---
        idx: l2_slot_find(mi, node\as\atom)
        if: idx >= 0
            return: l2_tok_slot(mi, idx, dest)
        ---
        idx: l2_ns_find(node\as\atom)
        if: idx >= 0
            if: l2_unit_ref = 0
                return: 1
            if: c.sprintf(dest, "lmx_arena_ref_struct(%s, %uU)", l2_unit_ref, (cast: (unsigned) (l2_ns_base + l2_ns_rank(idx)))) < 0
                return: 1
            return: 0
        ---
        # A method named as a value is its result: it runs with no arguments on the call path of
        # `m()` (l2_check_primary refused one without a result).
        idx: l2_find_method(node\as\atom)
        if: idx >= 0
            return: l2_emit_call(node, idx, 0, 0 - 1, 0, mi, ind, dest)
        ---
        return: l2_tok_text(node\as\atom, dest, 256U)
    if: node\kind = c.LM_P0_NODE_FRAME && l2_frame_head(node, "@")
        return: l2_prep_addr(node, mi, ind, dest)
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0
        if: l2_fields_has_call(node\as\structure\first_field, l2_count_active(node\as\structure))
            return: l2_eval_fields(node\as\structure\first_field, l2_count_active(node\as\structure), mi, ind, dest)
        s2[0]: 0
        s3[0]: 0
        if: l2_emit_fields(node\as\structure\first_field, l2_count_active(node\as\structure), mi, ind, s2) != 0
            return: 1
        if: l2_cat(s3, "(") != 0
            return: l2_error(l2_src, node, "expression too long")
        if: l2_cat(s3, s2) != 0
            return: l2_error(l2_src, node, "expression too long")
        if: l2_cat(s3, ")") != 0
            return: l2_error(l2_src, node, "expression too long")
        memcpy(dest, s3, strlen(s3) + 1U)
        return: 0
    if: node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: 1
    call: node\as\frame
    if: l2_text_eq(call\head, "cast")
        if: call\body = 0 || call\trailer != 0 || call\body\trailer != 0 || l2_count_active(call\body) < 2
            return: 1
        a0: l2_next_active(call\body\first_field)
        a1: l2_next_active(a0\next)
        s0[0]: 0
        if: l2_cast_type(a0\value, s1) != 0
            return: 1
        # A field/index expression reaches here as flat fields, and
        # l2_emit_fields already renders that complete shape.
        if: l2_count_active(call\body) > 2 && l2_emit_fields(a1, l2_count_active(call\body) - 1, mi, ind, s0) != 0
            return: 1
        if: l2_count_active(call\body) = 2 && l2_prep(a1\value, mi, ind, s0) != 0
            return: 1
        if: c.sprintf(dest, "(cast: (%s) %s)", s1, s0) < 0
            return: 1
        return: 0
    ---
    if: l2_text_eq(call\head, "sizeof")
        return: l2_emit_sizeof(node, mi, ind, dest)
    ---
    if: l2_text_eq(call\head, "implements")
        return: l2_prep_implements(node, dest)
    idx: l2_find_method(call\head)
    l2_call_sel: 0
    if: idx < 0 && call\head != 0 && call\head\data != 0 && call\head\length < 256U && l2_seg_count(call\head\data, call\head\length) > 1 && l2_path_kind(call\head\data, call\head\length, @ l2_call_mi) = 4
        # The path selects THIS occurrence of the callable. Its slot 0 holds a
        # typed LmxCallable referring to the shared METHOD; this occurrence is
        # the hidden self; its node is the source-visible lexical space above
        # the method and stays fixed for the entire activation.
        if: l2_emit_path(call\head\data, call\head\length, mi, ind, node, @ l2_call_k) != 0
            return: 1
        idx: l2_call_mi
        l2_call_sel: 1
    if: idx < 0
        l2_call_fi: l2_formal_find(mi, call\head)
        if: l2_call_fi >= 0
            idx: l2_cf_get(mi, l2_call_fi)
            if: idx >= 0
                l2_call_sel: 2
            ---
            if: idx < 0
                idx: 0 - 1
            ---
        ---
    ---
    if: idx < 0 && l2_text_eq(call\head, "length") && l2_array_length_own(node, mi) < 0 && l2_arr_len_shape(node, lpd, @ lpn, @ lkind, @ lelem, @ ldepth, @ li0) = 0
        return: l2_emit_arr_operand(mi, lpd, lpn, lkind, lelem, ldepth, li0, 0U, 1, ind, node, dest)
    if: idx < 0 && l2_text_eq(call\head, "length")
        return: l2_emit_array_length(l2_array_length_own(node, mi), ind, dest)
    raw_j: -1
    raw_fld: -1
    if: idx < 0
        k: l2_raw_head(call\head, mi, @ raw_j, @ raw_fld)
    # Typed fnptr (ty40) expression emission: same call-args sequence as statement
    # emit_fnptr_call. Do not route through l2_emit_ccall (c.* door stays untouched).
    if: idx < 0 && l2_ml_find(call\head) >= 0 && l2_ml_ty[l2_ml_find(call\head)] = 40
        s0[0]: 0
        if: call\body != 0
            a0: l2_next_active(call\body\first_field)
            t: 1
            while: a0 != 0
                actual_span: l2_expr_span(a0)
                if: actual_span < 1
                    return: 1
                s1[0]: 0
                if: l2_emit_fields(a0, actual_span, mi, ind, s1) != 0
                    return: 1
                if: t = 0 && l2_cat(s0, ", ") != 0
                    return: 1
                if: l2_cat(s0, s1) != 0
                    return: 1
                t: 0
                a0: l2_skip_span(a0, actual_span)
            ---
        ---
        if: l2_tok_text(call\head, s1, 256U) != 0
            return: 1
        if: strlen(s1) + strlen(s0) + 3U >= 256U
            return: l2_error(l2_src, node, "expression too long")
        if: c.sprintf(dest, "%s(%s)", s1, s0) < 0
            return: 1
        return: 0
    ---
    if: idx < 0 && (l2_c_door(call\head) != 0 || l2_predef_has_function(call\head) != 0 || (k = 0 && raw_fld = 5))
        l2_ccall_into: dest
        if: l2_emit_ccall(node, mi, ind) != 0
            l2_ccall_into: 0
            return: 1
        return: 0
    ---
    # WHAT STOOD HERE AND IS GONE (FABLE-SONNET-NAME-SPECIALS-20260924-155
    # commit 3): four name-keyed branches hand-emitting lm_own_new_zero/
    # _copy_bytes/_delete/_resize, dead since commit 2 -- l2_predef_has_
    # function(call\head) is now required just to reach this emitter for
    # one of these names (l2_check_fields :13061 admits on l2_is_known,
    # which for a non-c.* name IS that check), so the l2_predef_has_
    # function(...) arm just above (:14862) always fires first and returns
    # before any of these four could run. The lm_own_new_zero arm was also
    # the strstr(s0,"IndentStack"|"size_t") substring dispatch named in
    # plan §7a; its replacement is simply that it is gone -- the call now
    # emits through the general l2_emit_ccall path, verbatim, and the
    # caller's own cast (if any) supplies the type, exactly like every
    # other predef'd C call. See :18296 for the matching auto-injected-
    # header deletion (same commit, same reasoning).
    if: idx < 0 && l2_text_eq(call\head, "l2_immut_query_fill")
        if: call\body = 0
            return: 1
        a0: l2_next_active(call\body\first_field)
        s0[0]: 0
        s1[0]: 0
        t: 0
        while: a0 != 0 && t < 2
            n: 1
            a1: 0
            if: a0\value != 0 && a0\value\kind = c.LM_P0_NODE_ATOM && l2_ident(a0\value\as\atom)
                a1: l2_next_active(a0\next)
            if: a1 != 0 && a1\value != 0 && a1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(a1\value\as\atom)
                n: 3
            if: t = 0 && l2_emit_fields(a0, n, mi, ind, s0) != 0
                return: 1
            if: t = 1 && l2_emit_fields(a0, n, mi, ind, s1) != 0
                return: 1
            k: 0
            while: k < n
                a0: l2_next_active(a0\next)
                k: k + 1
            t: t + 1
        t: l2_tn
        l2_tn: l2_tn + 1
        if: c.fprintf(l2_out, "%sint: l2_t%d\n%sl2_t%d: l2_immut_query_fill(%s, %s)\n", ind, t, ind, t, s0, s1) < 0
            return: 1
        return: l2_tok_temp(t, dest)
    if: idx < 0 && l2_text_eq(call\head, "l2_hash_compare_q")
        if: call\body = 0
            return: 1
        a0: l2_next_active(call\body\first_field)
        s0[0]: 0
        s1[0]: 0
        t: 0
        while: a0 != 0 && t < 2
            n: 1
            a1: 0
            if: a0\value != 0 && a0\value\kind = c.LM_P0_NODE_ATOM && l2_ident(a0\value\as\atom)
                a1: l2_next_active(a0\next)
            if: a1 != 0 && a1\value != 0 && a1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(a1\value\as\atom)
                n: 3
            if: t = 0 && l2_emit_fields(a0, n, mi, ind, s0) != 0
                return: 1
            if: t = 1 && l2_emit_fields(a0, n, mi, ind, s1) != 0
                return: 1
            k: 0
            while: k < n
                a0: l2_next_active(a0\next)
                k: k + 1
            t: t + 1
        t: l2_tn
        l2_tn: l2_tn + 1
        if: c.fprintf(l2_out, "%sint: l2_t%d\n%sl2_t%d: l2_hash_compare_q(%s, %s)\n", ind, t, ind, t, s0, s1) < 0
            return: 1
        return: l2_tok_temp(t, dest)
    if: idx < 0
        return: 1
return: l2_emit_call(node, idx, l2_call_sel, l2_call_fi, call\body, mi, ind, dest)

# THE CALL (FABLE-OPUS-RECEIVER-CONTRACT-20260924-139).  One emission for every spelling of a call
# of the resolved callee idx: l2_prep's call Frame, and a bare atom statement, which has no
# argument Structure (body 0).  sel is how the called occurrence is selected: 0 the unit's own
# occurrence of the method, 1 the occurrence a method path has just selected (l2_pst), 2 the one
# the callable formal fi holds.  sel and fi arrive as values: a call among the actuals goes
# through l2_prep again and must not re-select this one.
fn: l2_emit_call (const: @(LmP0Node node); int: idx; int: sel; int: fi; const: @(LmP0Structure body); int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field a0 0
    int: t
    int: self_t
    int: actual_span
    int: actual_i
    @: char acts 0
    @: char hides 0
    int: nact 0
    int: nhid 0
    int: ai
    int: prty
    int: prsty
    # Capture the selected physical occurrence before evaluating actuals: a
    # nested call may reuse l2_pst, but `self` for this call must remain the
    # originally selected callable. Source `node` is self\parent; own storage
    # is based on self itself.
    self_t: l2_tn
    l2_tn: l2_tn + 1
    # The caller passes the data (-189 c3a; Q28, fable's decision (i)).  A call by name or path runs
    # the callee over its own graph, (M, M), so `M\x` shows that activation.  A re-entry
    # (l2_reenters) runs over a fresh instance of M (lmx_fresh), frame-only, its parent M's: M may
    # be active.  A method with no data fields has nothing to lay out and keeps its occurrence.
    if: sel = 0 && c.fprintf(l2_out, "%s@: Lmx l2_c%d lmx_arena_ref_struct(%s, %uU)\n", ind, self_t, l2_unit_ref, (cast: (unsigned) (l2_unit_base + idx))) < 0
        return: 1
    if: sel = 1 && c.fprintf(l2_out, "%s@: Lmx l2_c%d l2_pst\n", ind, self_t) < 0
        return: 1
    if: sel != 2 && l2_m_native(idx) != 0 && idx != l2_e && l2_m_kids(idx) > l2_m_head(idx) && l2_reenters(mi, idx) != 0
        if: c.fprintf(l2_out, "%sl2_c%d: lmx_fresh(l2_program_arena, l2_c%d)\n%sif: l2_c%d = 0\n", ind, self_t, self_t, ind, self_t) < 0 || l2_emit_invariant(ind, "a fresh instance could not be made") != 0
            return: 1
        ---
    ---
    if: sel = 2 && c.fprintf(l2_out, "%s@: Lmx l2_c%d l2_p%d_%d\n", ind, self_t, mi, fi) < 0
        return: 1
    if: body != 0
        a0: l2_next_active(body\first_field)
    t: 0
    nact: l2_m_arity[idx]
    nhid: l2_m_dyn[idx]
    acts: 0
    hides: 0
    l2_alloc_kind: 4
    if: nact > 0
        if: l2_mul_ok((cast: (size_t) nact), 1024U) = 0
            l2_alloc_err: 2
            return: l2_error(l2_src, node, "size overflow")
        acts: (cast: (@: char) l2_xmalloc((cast: (size_t) nact) * 1024U))
        if: acts = 0
            return: l2_error(l2_src, node, "out of memory")
        memset((cast: (@: void) acts), 0, (cast: (size_t) nact) * 1024U)
        ---
    while: a0 != 0
        if: t >= nact
            return: l2_prep_drop(acts, hides)
        actual_span: l2_expr_span(a0)
        # A callable formal takes the occurrence its actual names (l2_check_call), not a call.
        if: l2_cf_get(idx, t) >= 0 && (actual_span != 1 || a0\value = 0 || a0\value\kind != c.LM_P0_NODE_ATOM || l2_tok_method_occ(l2_find_method(a0\value\as\atom), l2_act_at(acts, t)) != 0)
            return: l2_prep_drop(acts, hides)
        if: l2_cf_get(idx, t) < 0 && (actual_span < 1 || l2_emit_fields(a0, actual_span, mi, ind, l2_act_at(acts, t)) != 0)
            return: l2_prep_drop(acts, hides)
        # A letter goes to a typed formal as its payload, admitted (D-57).
        if: actual_span = 1 && l2_nsty_get(idx, t) >= 0 && l2_untyped_graph(mi, a0\value) != 0 && l2_is_letter_name(mi, a0\value) != 0 && l2_payload_expr(l2_act_at(acts, t)) != 0
            return: l2_prep_drop(acts, hides)
        if: actual_span = 1 && l2_nsty_get(idx, t) >= 0 && l2_untyped_graph(mi, a0\value) != 0 && l2_emit_admit(mi, l2_nsty_get(idx, t), l2_act_at(acts, t), ind) != 0
            return: l2_prep_drop(acts, hides)
        t: t + 1
        actual_i: 0
        while: actual_i < actual_span && a0 != 0
            a0: l2_next_active(a0\next)
            actual_i: actual_i + 1
        ---
    if: t != nact
        return: l2_prep_drop(acts, hides)
    if: nhid > 0
        if: l2_mul_ok((cast: (size_t) nhid), 1024U) = 0
            l2_alloc_err: 2
            l2_prep_drop(acts, hides)
            return: l2_error(l2_src, node, "size overflow")
        hides: (cast: (@: char) l2_xmalloc((cast: (size_t) nhid) * 1024U))
        if: hides = 0
            l2_prep_drop(acts, hides)
            return: l2_error(l2_src, node, "out of memory")
        memset((cast: (@: void) hides), 0, (cast: (size_t) nhid) * 1024U)
        ai: 0
        while: ai < nhid
            if: l2_hidden_from(mi, idx, ai, self_t, ind, l2_act_at(hides, ai), node) != 0
                return: l2_prep_drop(acts, hides)
            ai: ai + 1
        ---
    t: l2_tn
    l2_tn: l2_tn + 1
    # A named-Structure return is stored dt_of_own(1000+foreign)
    # (l2_colon_graph_ty); recover the raw foreign code the same way
    # l2_emit_formal/l2_emit_sig already do, or a discarded or captured
    # call to a Structure-returning method silently fails here
    # (FABLE-SONNET-DECL-PREPASS-20260923-137 part 2): l2_emit_foreign_temp
    # would see the unconverted dt-space number as an out-of-range foreign
    # index and return 1 with no l2_error call.
    prty: l2_m_ret[idx]
    if: prty > 1
        prsty: l2_own_of_dt(prty)
        if: prsty >= 1000 && prsty < 2000
            prty: l2_ft_of_own(prsty)
        ---
    if: prty = 2 && c.fprintf(l2_out, "%ssize_t: l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: prty = 30 && c.fprintf(l2_out, "%sunsigned: l2_t%d\n", ind, t) < 0
        return: 1
    if: prty = 33 && c.fprintf(l2_out, "%sunsigned: l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: prty = 36 && c.fprintf(l2_out, "%sulong: l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: prty = 3 && c.fprintf(l2_out, "%s@: char l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: prty = 16 && c.fprintf(l2_out, "%s@: void l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: prty = 35 && c.fprintf(l2_out, "%sconst: @(char l2_t%d)\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: prty = 32 && c.fprintf(l2_out, "%s@@: char l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: prty >= 100 && l2_emit_foreign_temp(l2_out, prty, ind, t) != 0
        return: l2_prep_drop(acts, hides)
        return: l2_prep_drop(acts, hides)
        return: l2_prep_drop(acts, hides)
        return: l2_prep_drop(acts, hides)
    if: l2_ret_uns(idx) = 0 && prty != 3 && prty != 5 && prty != 8 && prty != 10 && prty != 13 && prty != 16 && prty != 32 && prty != 35 && prty < 100 && c.fprintf(l2_out, "%sint: l2_t%d\n", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_throws[idx] != 0 && c.fprintf(l2_out, "%sint: l2_ts%d 0\n%s@: Lmx l2_te%d 0\n", ind, t, ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: sel != 2 && prty = 8 && l2_m_throws[idx] = 0 && c.fprintf(l2_out, "%s", ind) < 0
        return: l2_prep_drop(acts, hides)
    if: sel != 2 && prty != 8 && l2_m_throws[idx] = 0 && c.fprintf(l2_out, "%sl2_t%d: ", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: sel != 2 && l2_m_throws[idx] != 0 && c.fprintf(l2_out, "%sl2_ts%d: ", ind, t) < 0
        return: l2_prep_drop(acts, hides)
    if: sel = 2
        if: nact != 0 || nhid != 0
            l2_prep_drop(acts, hides)
            return: l2_error(l2_src, node, "incompatible entry signature")
        # A callable formal is called through the one dynamic call ABI, lmx_call_prim
        # (lmx_call.h.lm1; its native callee is the method's trampoline, l2_emit_trampoline): the
        # status apart from the value.  A throwing callable's status is its throw status, carried
        # on by l2_emit_propagate exactly as a direct call's, with the thrown record from `out`;
        # a callable that cannot throw and reports a status is a broken promise (X1).
        if: l2_emit_dyn_call(idx, t, self_t, ind) != 0
            return: l2_prep_drop(acts, hides)
        l2_prep_drop(acts, hides)
        if: l2_m_throws[idx] != 0 && l2_emit_propagate(mi, idx, t, ind) != 0
            return: 1
        if: l2_m_ret[idx] = 8
            dest[0]: 0
            return: 0
        return: l2_tok_temp(t, dest)
    ---
    if: l2_m_body[idx] = 0 && (l2_m_node[idx] = 0 || l2_m_node[idx]\as = 0 || l2_ret_tr(l2_m_node[idx]\as\frame) = 0)
        l2_prep_drop(acts, hides)
        return: l2_error(l2_src, node, "not callable")
    ---
    if: l2_write_sym(l2_out, idx) != 0
        return: l2_prep_drop(acts, hides)
    # The native ABI keeps the two physical roles distinct: the fixed lexical
    # space above the method first, selected occurrence/home second.
    if: c.fprintf(l2_out, "(l2_c%d\\parent, l2_c%d", self_t, self_t) < 0
        return: l2_prep_drop(acts, hides)
    ai: 0
    while: ai < nact
        if: c.fprintf(l2_out, ", %s", l2_act_at(acts, ai)) < 0
            return: l2_prep_drop(acts, hides)
        ai: ai + 1
    ai: 0
    while: ai < nhid
        if: c.fprintf(l2_out, ", %s", l2_act_at(hides, ai)) < 0
            return: l2_prep_drop(acts, hides)
        ai: ai + 1
    # A method caller forwards its own l2_msg -- the closure makes every caller of
    # a throwing callable throwing, so the formal is in scope. The entry has no
    # such formal: its single `node` is the graph it was dispatched with.
    if: l2_m_throws[idx] != 0 && fputs(", l2_msg", l2_out) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_throws[idx] != 0 && l2_m_ret[idx] != 8 && c.fprintf(l2_out, ", @ l2_t%d", t) < 0
        return: l2_prep_drop(acts, hides)
    if: l2_m_throws[idx] != 0 && c.fprintf(l2_out, ", @ l2_te%d", t) < 0
        return: l2_prep_drop(acts, hides)
    l2_prep_drop(acts, hides)
    if: fputs(")\n", l2_out) < 0
        return: 1
    # Publish writes already known to this activation after the call and before
    # a following explicit node\field read. Merely taking an address does not
    # mark a graph-backed own cache dirty.
    if: l2_m_throws[idx] != 0 && l2_emit_propagate(mi, idx, t, ind) != 0
        return: 1
    # A callable without a result names no value: its temporary is never declared.
    if: l2_m_ret[idx] = 8
        dest[0]: 0
        return: 0
return: l2_tok_temp(t, dest)

# The unit's own occurrence of method idx (@: Lmx): what a callable formal receives.
fn: l2_tok_method_occ (int: idx; @: char dest) int
    if: idx < 0 || l2_unit_ref = 0
        return: 1
    if: c.sprintf(dest, "lmx_arena_ref_struct(%s, %uU)", l2_unit_ref, (cast: (unsigned) (l2_unit_base + idx))) < 0
        return: 1
return: 0

# Follow the admitted unit-child/descriptor/backing contract, without allocation,
# scalar dirty caches, intern lookup, or descriptor rebinding.
fn: l2_emit_array_ptr (int: oi; const: @(char ind); @: char dest) int
    int: t
    const: @(char element) "int"
    @: LmP0Field type_field
    c.array: [128]: char l2_eap_expr
    if: oi < 0 || l2_own_is_array(l2_own_ty[oi]) = 0 || (l2_own_fid[oi] < 0 && l2_own_uchild[oi] < 0) || dest = 0
        c.fprintf(l1_stderr(), "l2trans detail: array pointer unavailable oi=%d\n", oi)
        return: 1
    if: l2_own_ty[oi] = 5
        element: "char"
    if: l2_own_ty[oi] = 7
        element: "size_t"
    if: l2_own_ty[oi] = 37
        element: "ulong"
    if: l2_own_ty[oi] = 8
        type_field: l2_next_active(l2_own_decl[oi]\as\frame\body\first_field)
        if: type_field = 0 || type_field\value = 0 || type_field\value\kind != c.LM_P0_NODE_ATOM
            c.fprintf(l1_stderr(), "l2trans detail: imported array type spelling unavailable oi=%d\n", oi)
            return: 1
        ---
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.fprintf(l2_out, "%s@@: void l2_a%d_leaf\n%s@: LmxArrayDesc l2_a%d_desc\n", ind, t, ind, t) < 0
        return: 1
    if: l2_own_ty[oi] != 8 && l2_own_ty[oi] < 2000 && c.fprintf(l2_out, "%s@: %s l2_a%d_data\n", ind, element, t) < 0
        return: 1
    if: l2_own_ty[oi] = 8
        if: c.fprintf(l2_out, "%s@: ", ind) < 0 || l2_write_text(l2_out, type_field\value\as\atom) != 0 || c.fprintf(l2_out, " l2_a%d_data\n", t) < 0
            return: 1
        ---
    if: l2_own_ty[oi] >= 2000
        if: fputs(ind, l2_out) < 0 || l2_emit_own_pointer_array_data_type(l2_out, l2_own_ty[oi]) != 0 || c.fprintf(l2_out, " l2_a%d_data\n", t) < 0
            return: 1
    ---
    if: l2_own_from_expr(oi, l2_eap_expr) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_a%d_leaf: %s\n", ind, t, l2_eap_expr) < 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_a%d_desc: (cast: (@: LmxArrayDesc) l2_a%d_leaf[0])\n", ind, t, t) < 0
        return: 1
    if: l2_own_ty[oi] != 8 && l2_own_ty[oi] < 2000 && c.fprintf(l2_out, "%sl2_a%d_data: (cast: (@: %s) l2_a%d_desc\\data)\n", ind, t, element, t) < 0
        return: 1
    if: l2_own_ty[oi] = 8
        if: c.fprintf(l2_out, "%sl2_a%d_data: (cast: (@: ", ind, t) < 0 || l2_write_text(l2_out, type_field\value\as\atom) != 0 || c.fprintf(l2_out, ") l2_a%d_desc\\data)\n", t) < 0
            return: 1
        ---
    if: l2_own_ty[oi] >= 2000
        if: c.fprintf(l2_out, "%sl2_a%d_data: (cast: (", ind, t) < 0 || l2_emit_own_pointer_array_data_type(l2_out, l2_own_ty[oi]) != 0 || c.fprintf(l2_out, ") l2_a%d_desc\\data)\n", t) < 0
            return: 1
        ---
    if: c.sprintf(dest, "l2_a%d_data", t) < 0
        return: 1
return: 0

fn: l2_emit_array_length (int: oi; const: @(char ind); @: char dest) int
    int: t
    c.array: [128]: char l2_eal_expr
    if: oi < 0 || l2_own_is_array(l2_own_ty[oi]) = 0 || (l2_own_fid[oi] < 0 && l2_own_uchild[oi] < 0) || dest = 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.fprintf(l2_out, "%s@@: void l2_a%d_leaf\n%s@: LmxArrayDesc l2_a%d_desc\n%ssize_t: l2_t%d\n", ind, t, ind, t, ind, t) < 0
        return: 1
    if: l2_own_from_expr(oi, l2_eal_expr) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_a%d_leaf: %s\n", ind, t, l2_eal_expr) < 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_a%d_desc: (cast: (@: LmxArrayDesc) l2_a%d_leaf[0])\n%sl2_t%d: l2_a%d_desc\\len\n", ind, t, t, ind, t, t) < 0
        return: 1
return: l2_tok_temp(t, dest)

fn: l2_emit_array_load (int: oi; size_t: index; const: @(char ind); @: char dest) int
    int: t
    const: @(char element) "int"
    c.array: [1024]: char ptr
    if: l2_emit_array_ptr(oi, ind, ptr) != 0
        return: 1
    if: l2_own_ty[oi] = 5
        element: "char"
    if: l2_own_ty[oi] = 7
        element: "size_t"
    if: l2_own_ty[oi] = 37
        element: "ulong"
    if: l2_own_ty[oi] = 8
        # The admitted imported type is an unsigned-char alias. Keep its exact
        # spelling for ABI pointers, but widen a loaded value to L2's ordinary
        # unsigned scalar because L1 has no scalar unsigned-char declaration.
        element: "unsigned"
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_own_ty[oi] < 2000 && c.fprintf(l2_out, "%s%s: l2_t%d\n", ind, element, t) < 0
        return: 1
    if: l2_own_ty[oi] >= 2000
        if: fputs(ind, l2_out) < 0 || l2_emit_own_pointer_type(l2_out, l2_own_ty[oi] - 1000) != 0 || c.fprintf(l2_out, " l2_t%d\n", t) < 0
            return: 1
    ---
    if: c.fprintf(l2_out, "%sl2_t%d: %s[%zuU]\n", ind, t, ptr, index) < 0
        return: 1
return: l2_tok_temp(t, dest)

fn: l2_emit_fields (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field f
    @: LmP0Field p1
    @: LmP0Field p2
    @: LmP0Field p3
    @: LmP0Field p4
    @: LmP0Field p5
    @: LmP0Node at 0
    int: i
    int: ao
    int: after 0
    int: fld
    int: po
    int: fpr
    int: have_value 0
    size_t: array_index
    int: array_count
    c.array: [1024]: char apd
    size_t: apn 0U
    int: acnt 0
    int: akind 0
    int: aelem 0
    int: adepth 0
    int: ast 1
    size_t: ai0 0U
    size_t: ai1 0U
    @: LmP0Field aafter 0
    c.array: [1024]: char buf
    c.array: [1024]: char piece
    @: LmP0Field aidx_f
    c.array: [1024]: char aptr
    c.array: [128]: char occx
    int: occt
    if: dest = 0
        return: 1
    buf[0]: 0
    if: n = 1
        return: l2_prep(l2_next_active(field)\value, mi, ind, dest)
    f: l2_next_active(field)
    i: 0
    ao: 0
    while: i < n && f != 0 && f\value != 0
        at: f\value
        ast: l2_arr_operand(f, 0, apd, @ apn, @ acnt, @ aafter, @ akind, @ aelem, @ adepth, @ ai0, @ ai1)
        if: ast = 0
            if: l2_emit_arr_operand(mi, apd, apn, akind, aelem, adepth, ai0, ai1, 0, ind, at, piece) != 0 || l2_cat(buf, piece) != 0
                return: 1
            ao: 0
            after: 0
            have_value: 1
            i: i + acnt
            f: aafter
            continue
        if: l2_own_index_tail(f, mi, @ po, @ array_index, @ p2, @ array_count) = 0
            if: l2_emit_array_load(po, array_index, ind, piece) != 0 || l2_cat(buf, piece) != 0
                return: 1
            ao: 0
            after: 0
            have_value: 1
            i: i + array_count
            f: p2
            continue
        fld: 0
        piece[0]: 0
        p1: 0
        p2: 0
        po: -1
        if: f\value\kind = c.LM_P0_NODE_ATOM
            p1: l2_next_active(f\next)
        if: p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom)
            p2: l2_next_active(p1\next)
        # A field path off an own field, a namespace-typed name, or node/for
        # -- FABLE-SONNET-NODE-ROOT-20260923-121, FABLE-SONNET-FIELD-PATHS-
        # 20260923-113.
        fpr: 0 - 1
        if: p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM
            fpr: l2_field_path_read(mi, f\value\as\atom, p2\value\as\atom, ind, at, piece)
        if: fpr = 1
            return: 1
        if: fpr = 0
            if: l2_cat(buf, piece) != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            after: 0
            have_value: 1
            i: i + 3
            f: l2_next_active(p2\next)
            continue
        # `merged\[N]x` -- see l2_check_fields.
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(f\value\as\atom) != 0 && l2_mres_find(f\value\as\atom) >= 0 && l2_own_find(mi, f\value\as\atom) < 0 && l2_formal_find(mi, f\value\as\atom) < 0 && p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom) && p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(p2\value\as\atom, "[") != 0
            p3: l2_next_active(p2\next)
            p4: 0
            p5: 0
            if: p3 != 0
                p4: l2_next_active(p3\next)
            if: p4 != 0
                p5: l2_next_active(p4\next)
            if: p3 = 0 || p3\value = 0 || p3\value\kind != c.LM_P0_NODE_ATOM || l2_num(p3\value\as\atom) = 0 || p4 = 0 || p4\value = 0 || p4\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(p4\value\as\atom, "]") = 0 || p5 = 0 || p5\value = 0 || p5\value\kind != c.LM_P0_NODE_ATOM || l2_ident(p5\value\as\atom) = 0
                return: 1
            piece[0]: 0
            if: l2_mrs_occ_read(l2_mres_find(f\value\as\atom), p5\value\as\atom, (cast: (int) l2_literal_value(p3\value\as\atom)), mi, ind, piece, f\value) != 0
                return: 1
            if: l2_cat(buf, piece) != 0
                return: l2_error(l2_src, f\value, "expression too long")
            ao: 0
            after: 0
            have_value: 1
            i: i + 6
            f: l2_next_active(p5\next)
            continue
        # A method name as a path root denotes its occurrence -- see
        # l2_check_fields's copy of this comment (FABLE-SONNET-OCC-ROOT-
        # 20260924-146): recognized at the flat-token level, not inside
        # l2_path_root, reusing l2_find_method and l2_own_find_occ (the same
        # pair the rootless `\[N]name` form just below already uses).
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(f\value\as\atom) != 0 && l2_find_method(f\value\as\atom) >= 0 && p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom) && p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(p2\value\as\atom, "[") != 0
            p3: l2_next_active(p2\next)
            p4: 0
            p5: 0
            if: p3 != 0
                p4: l2_next_active(p3\next)
            if: p4 != 0
                p5: l2_next_active(p4\next)
            if: p3 = 0 || p3\value = 0 || p3\value\kind != c.LM_P0_NODE_ATOM || l2_num(p3\value\as\atom) = 0 || p4 = 0 || p4\value = 0 || p4\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(p4\value\as\atom, "]") = 0 || p5 = 0 || p5\value = 0 || p5\value\kind != c.LM_P0_NODE_ATOM || l2_ident(p5\value\as\atom) = 0
                return: 1
            po: l2_own_find_occ(l2_find_method(f\value\as\atom), p5\value\as\atom, (cast: (int) l2_literal_value(p3\value\as\atom)))
            if: po < 0 || l2_m_uses[l2_own_off(l2_find_method(f\value\as\atom), po)] = 0
                return: l2_error(l2_src, p5\value, "own occurrence index out of range")
            # This own row belongs to ANOTHER method's activation, not the
            # one this C function is being emitted for: l2_q%d is that
            # OTHER method's own local, out of scope here (a same-method
            # rootless \[N]name never has this problem). Read it through
            # the graph instead, l2_own_from_expr, the same accessor
            # l2_emit_array_ptr and l2_emit_own_from already use for a
            # cross-activation own cell.
            if: l2_own_from_expr(po, occx) != 0
                return: 1
            if: c.fprintf(l2_out, "%sl2_xp: %s\n", ind, occx) < 0
                return: 1
            occt: l2_tn
            l2_tn: l2_tn + 1
            if: l2_emit_own_cell_load(po, ind, occt, at) != 0
                return: 1
            if: c.sprintf(piece, "l2_t%d", occt) < 0
                return: 1
            if: l2_cat(buf, piece) != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            after: 0
            have_value: 1
            i: i + 6
            f: l2_next_active(p5\next)
            continue
        # `test\arg` (no [N]): unqualified is the LAST occurrence
        # (FABLE-SONNET-LAST-OCCURRENCE-20260924-164) -- see l2_check_fields's
        # copy of this comment.
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(f\value\as\atom) != 0 && l2_find_method(f\value\as\atom) >= 0 && p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom) && p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && l2_ident(p2\value\as\atom) != 0
            po: l2_own_find_last(l2_find_method(f\value\as\atom), p2\value\as\atom)
            if: po < 0 || l2_m_uses[l2_own_off(l2_find_method(f\value\as\atom), po)] = 0
                return: l2_error(l2_src, p5\value, "own occurrence index out of range")
            if: l2_own_from_expr(po, occx) != 0
                return: 1
            if: c.fprintf(l2_out, "%sl2_xp: %s\n", ind, occx) < 0
                return: 1
            occt: l2_tn
            l2_tn: l2_tn + 1
            if: l2_emit_own_cell_load(po, ind, occt, at) != 0
                return: 1
            if: c.sprintf(piece, "l2_t%d", occt) < 0
                return: 1
            if: l2_cat(buf, piece) != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            after: 0
            have_value: 1
            i: i + 3
            f: l2_next_active(p2\next)
            continue
        if: after != 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(f\value\as\atom)
            fld: 1
        if: fld = 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(f\value\as\atom, "@")
            # D-21 (steps/defects.md): `@` immediately in front of a bare
            # own-array element must address the real backing the same way
            # l2_emit_array_ptr already does for the Structure-field route,
            # not splice "@ " onto whatever the ordinary (value-reading)
            # dispatch below produces for the element -- that read the
            # value into a temp, so the address taken was the temp's, and a
            # write through it never reached the array. l2_own_index_tail is
            # the exact recognizer the plain read a few checks above uses.
            aidx_f: l2_next_active(f\next)
            if: aidx_f != 0 && l2_own_index_tail(aidx_f, mi, @ po, @ array_index, @ p2, @ array_count) = 0
                if: l2_emit_array_ptr(po, ind, aptr) != 0
                    return: 1
                if: c.sprintf(piece, "@ %s[%zuU]", aptr, array_index) < 0 || l2_cat(buf, piece) != 0
                    return: l2_error(l2_src, at, "expression too long")
                ao: 0
                after: 0
                have_value: 1
                i: i + 1 + array_count
                f: p2
                continue
            ---
            # -189 c3b-1/c3b-2: `@` of a bare name that is a direct field is its cell's address, not `@ `
            # onto its load.
            aidx_f: l2_next_active(f\next)
            if: aidx_f != 0 && aidx_f\value != 0 && aidx_f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(aidx_f\value\as\atom) != 0
                po: l2_name_cell(mi, aidx_f\value\as\atom)
                p2: l2_next_active(aidx_f\next)
                if: po >= 0 && (p2 = 0 || p2\value = 0 || p2\value\kind != c.LM_P0_NODE_ATOM || l2_is_slash(p2\value\as\atom) = 0)
                    if: l2_own_addr(po, piece) != 0
                        return: l2_error(l2_src, aidx_f\value, "this field has no address to take")
                    if: l2_cat(buf, piece) != 0
                        return: l2_error(l2_src, at, "expression too long")
                    ao: 0
                    after: 0
                    have_value: 1
                    i: i + 2
                    f: p2
                    continue
                ---
            ---
            if: l2_cat(buf, "@ ") != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            after: 0
            have_value: 0
            i: i + 1
            f: l2_next_active(f\next)
            continue
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(f\value\as\atom)
            p1: l2_next_active(f\next)
            p2: 0
            p3: 0
            p4: 0
            if: p1 != 0
                p2: l2_next_active(p1\next)
            if: p2 != 0
                p3: l2_next_active(p2\next)
            if: p3 != 0
                p4: l2_next_active(p3\next)
            if: have_value = 0 && p1 != 0 && p2 != 0 && p3 != 0 && p4 != 0 && p1\value != 0 && p2\value != 0 && p3\value != 0 && p4\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && p2\value\kind = c.LM_P0_NODE_ATOM && p3\value\kind = c.LM_P0_NODE_ATOM && p4\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(p1\value\as\atom, "[") != 0 && l2_num(p2\value\as\atom) != 0 && l2_text_eq(p3\value\as\atom, "]") != 0 && l2_ident(p4\value\as\atom) != 0
                po: l2_own_find_occ(mi, p4\value\as\atom, (cast: (int) l2_literal_value(p2\value\as\atom)))
                if: po < 0 || l2_m_uses[l2_own_off(mi, po)] = 0
                    return: l2_error(l2_src, p4\value, "own occurrence index out of range")
                if: l2_own_load(po, piece) != 0
                    return: 1
                if: l2_cat(buf, piece) != 0
                    return: l2_error(l2_src, at, "expression too long")
                ao: 0
                after: 0
                have_value: 1
                i: i + 5
                f: l2_next_active(p4\next)
                continue
            ---
            if: l2_cat(buf, "\\") != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            if: have_value != 0
                after: 1
            else:
                after: 0
            ---
            fld: 2
        if: fld = 1
            if: l2_tok_text(f\value\as\atom, piece, 256U) != 0 || l2_cat(buf, piece) != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            after: 0
            have_value: 1
        if: fld = 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_brack(f\value\as\atom)
            if: l2_tok_text(f\value\as\atom, piece, 256U) != 0 || l2_cat(buf, piece) != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: 0
            fld: 2
        if: fld = 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_binop(f\value\as\atom)
            if: l2_cat(buf, " ") != 0
                return: l2_error(l2_src, at, "expression too long")
            if: l2_tok_text(f\value\as\atom, piece, 256U) != 0 || l2_cat(buf, piece) != 0
                return: l2_error(l2_src, at, "expression too long")
            if: l2_cat(buf, " ") != 0
                return: l2_error(l2_src, at, "expression too long")
            ao: l2_is_andor(f\value\as\atom)
            have_value: 0
            fld: 2
        if: fld = 0 && ao != 0 && f\value\kind = c.LM_P0_NODE_FRAME && l2_find_method(f\value\as\frame\head) >= 0
            return: 1
        if: fld = 0 && (ao = 0 || f\value\kind != c.LM_P0_NODE_FRAME || l2_find_method(f\value\as\frame\head) < 0) && l2_prep(f\value, mi, ind, piece) != 0
            return: 1
        if: fld = 0 && (ao = 0 || f\value\kind != c.LM_P0_NODE_FRAME || l2_find_method(f\value\as\frame\head) < 0) && l2_cat(buf, piece) != 0
            return: l2_error(l2_src, at, "expression too long")
        if: fld = 0
            ao: 0
            after: 0
            have_value: 1
        f: l2_next_active(f\next)
        i: i + 1
    memcpy(dest, buf, strlen(buf) + 1U)
return: 0

fn: l2_eval_and (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field f
    @: LmP0Field nxt
    int: span
    int: rest
    @: char deep 0
    c.array: [1024]: char rhs
    if: dest = 0 || n <= 0
        return: 1
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    span: l2_span_and(field, n)
    if: span = n
        return: l2_emit_fields(field, n, mi, ind, dest)
    if: l2_new_temp(ind, dest) != 0
        return: 1
    f: l2_next_active(field)
    if: l2_emit_fields(f, span, mi, ind, rhs) != 0
        return: 1
    if: l2_bool_set(ind, dest, rhs) != 0
        return: 1
    rest: n - span
    nxt: l2_advance(f, span)
    if: rest > 0 && nxt != 0 && l2_is_and_atom(nxt\value)
        rest: rest - 1
        nxt: l2_next_active(nxt\next)
    while: rest > 0 && nxt != 0
        span: l2_span_and(nxt, rest)
        if: c.fprintf(l2_out, "%sif: %s\n", ind, dest) < 0
            return: 1
        if: l2_emit_fields(nxt, span, mi, deep, rhs) != 0
            return: 1
        if: l2_bool_set(deep, dest, rhs) != 0
            return: 1
        rest: rest - span
        nxt: l2_advance(nxt, span)
        if: rest > 0 && nxt != 0 && l2_is_and_atom(nxt\value)
            rest: rest - 1
            nxt: l2_next_active(nxt\next)
        ---
return: 0

fn: l2_eval_fields (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: char dest) int
    @: LmP0Field f
    @: LmP0Field nxt
    int: span
    int: rest
    @: char deep 0
    c.array: [1024]: char rhs
    if: dest = 0 || n <= 0
        return: 1
    if: l2_fields_has_call(field, n) = 0
        return: l2_emit_fields(field, n, mi, ind, dest)
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    span: l2_span_or(field, n)
    if: span = n
        return: l2_eval_and(field, n, mi, ind, dest)
    if: l2_new_temp(ind, dest) != 0
        return: 1
    f: l2_next_active(field)
    if: l2_eval_and(f, span, mi, ind, rhs) != 0
        return: 1
    if: l2_bool_set(ind, dest, rhs) != 0
        return: 1
    rest: n - span
    nxt: l2_advance(f, span)
    if: rest > 0 && nxt != 0 && l2_is_or_atom(nxt\value)
        rest: rest - 1
        nxt: l2_next_active(nxt\next)
    while: rest > 0 && nxt != 0
        span: l2_span_or(nxt, rest)
        if: c.fprintf(l2_out, "%sif: %s = 0\n", ind, dest) < 0
            return: 1
        if: l2_eval_and(nxt, span, mi, deep, rhs) != 0
            return: 1
        if: l2_bool_set(deep, dest, rhs) != 0
            return: 1
        rest: rest - span
        nxt: l2_advance(nxt, span)
        if: rest > 0 && nxt != 0 && l2_is_or_atom(nxt\value)
            rest: rest - 1
            nxt: l2_next_active(nxt\next)
        ---
return: 0

# One formal of a generated signature: its FORMAL type code, the method, and its position among
# the method's parameters (declared formals first, hidden/dynamic inputs after them).
# With `arg` 1, the same formal is written as its TRAMPOLINE input (l2_emit_trampoline): the
# argument read from refs[idx].  A scalar is read from the typed storage its reference addresses
# (a cell is that storage, lmx_value_owned.lm1); a pointer is the reference itself.  With `arg` 2
# only a by-value foreign input writes something: the trampoline's typed pointer to that storage.
# One table spells all three, so a trampoline passes exactly the arguments the signature declares.
fn: l2_emit_formal (int: ft; int: mi; int: idx; int: arg) int
    int: oty
    const: @(char sig) 0
    const: @(char read) 0
    if: ft = 0
        sig: "; int: l2_p%d_%d"
        read: ", lmx_int_value_known(refs[%d])"
    if: ft = 1
        sig: "; char: l2_p%d_%d"
        read: ", (cast: (char) lmx_char_value_known(refs[%d]))"
    if: ft = 2
        sig: "; size_t: l2_p%d_%d"
        read: ", lmx_size_value_known(refs[%d])"
    if: ft = 34
        sig: "; unsigned: l2_p%d_%d"
        read: ", lmx_unsigned_value_known(refs[%d])"
    if: ft = 36
        sig: "; ulong: l2_p%d_%d"
        read: ", lmx_ulong_value_known(refs[%d])"
    if: ft = 3
        sig: "; const: @(char l2_p%d_%d)"
    if: ft = 6
        sig: "; const: @(L2ImmutQuery l2_p%d_%d)"
    if: ft = 7
        sig: "; @: L2ImmutQuery l2_p%d_%d"
    if: ft = 9
        sig: "; @: size_t l2_p%d_%d"
    if: ft = 11
        sig: "; @: int l2_p%d_%d"
    if: ft = 12
        sig: "; @: char l2_p%d_%d"
    if: ft = 16
        sig: "; @: void l2_p%d_%d"
    if: ft = 17
        sig: "; @@: char l2_p%d_%d"
    if: ft = 18
        sig: "; @@: void l2_p%d_%d"
    if: ft = 19
        sig: "; @@: int l2_p%d_%d"
    if: ft = 24
        sig: "; @@: unsigned l2_p%d_%d"
    if: ft = 39
        sig: "; @@: ulong l2_p%d_%d"
    if: ft = 26
        sig: "; @@: LmxArenaBlock l2_p%d_%d"
    if: ft = 28
        sig: "; @: LmxRoot l2_p%d_%d"
    if: ft = 29
        sig: "; const: @(LmxMsg l2_p%d_%d)"
    if: ft = 30
        sig: "; const: @(unsigned l2_p%d_%d)"
    if: ft = 31
        sig: "; @@: unsigned l2_p%d_%d"
    if: ft = 27
        sig: "; @@: LmxOwnedRange l2_p%d_%d"
    if: ft = 25
        sig: "; @: unsigned l2_p%d_%d"
    if: ft = 38
        sig: "; @: ulong l2_p%d_%d"
    if: ft = 20
        sig: "; @@: size_t l2_p%d_%d"
    if: sig != 0 && arg = 0 && c.fprintf(l2_out, sig, mi, idx) < 0
        return: 1
    if: sig != 0 && arg = 1 && read != 0 && c.fprintf(l2_out, read, idx) < 0
        return: 1
    if: sig != 0 && arg = 1 && read = 0 && c.fprintf(l2_out, ", refs[%d]", idx) < 0
        return: 1
    # Graph / foreign pointer formals may be stored as dt_of_own(1000+foreign).
    if: ft > 1
        oty: l2_own_of_dt(ft)
        if: oty >= 1000 && oty < 2000
            ft: l2_ft_of_own(oty)
        ---
    ---
    if: ft >= 100 && l2_emit_foreign_formal(l2_out, ft, mi, idx, arg) != 0
        return: 1
return: 0

# The return type of method mi as its signature spells it.  A named-Structure return type is
# stored dt_of_own(1000+foreign) like any other declared graph type (l2_colon_graph_ty), not the
# raw >=100 foreign code l2_emit_foreign_return expects -- l2_emit_formal already runs a formal's
# own type through this exact recovery (own_of_dt then ft_of_own, matching l2_colon_is_graph_ty's
# own comment: "Declared graph formals store dt_of_own(1000+foreign); recover foreign @: Lmx"),
# but the return-type dispatch of l2_emit_sig read l2_m_ret[mi] raw. Measured
# (FABLE-SONNET-DECL-PREPASS-20260923-137 part 2, Opus's finding): `fn: same (Model: x) Model /
# return: x` silently failed translation -- l2_emit_foreign_return(l2_out, 1101) computed foreign
# index 1001 against a 1-entry table and returned 1 with no l2_error call. A no-op for every
# primitive return code (only a declared graph type round-trips through the 1000..1999 own-type
# space).  The signature and the method's trampoline both read it here.
fn: l2_sig_ret (int: mi) int
    int: ret_ty l2_m_ret[mi]
    int: roty
    if: ret_ty > 1
        roty: l2_own_of_dt(ret_ty)
        if: roty >= 1000 && roty < 2000
            ret_ty: l2_ft_of_own(roty)
        ---
    ---
return: ret_ty

fn: l2_emit_sig (int: mi) int
    int: j 0
    long: mark
    int: ret_ty
    ret_ty: l2_sig_ret(mi)
    if: fputs(" (@: Lmx node; @: Lmx self", l2_out) < 0
        return: 1
    while: j < l2_m_arity[mi]
        if: l2_emit_formal(l2_ft(mi, j), mi, j, 0) != 0
            return: 1
        j: j + 1
    j: 0
    while: j < l2_m_dyn[mi]
        # A hidden formal that spells nothing is a signature that quietly lacks a parameter.
        mark: c.ftell(l2_out)
        if: l2_emit_formal(l2_ft_of_own(l2_own_of_dt(l2_dt(mi, j))), mi, l2_m_arity[mi] + j, 0) != 0
            return: 1
        if: c.ftell(l2_out) = mark
            return: l2_error(l2_src, l2_m_node[mi], "dynamic input type has no formal spelling")
        j: j + 1
    # `merge:` contributes the executing Message to the existing dynamic-input
    # group. Call-graph closure marks every method that must forward it. Its
    # formal is l2_msg: `node` is already the reserved first formal, and a second
    # formal of that spelling is a C redefinition the C compiler alone reports.
    if: l2_m_throws != 0 && l2_m_throws[mi] != 0 && fputs("; @: Lmx l2_msg", l2_out) < 0
        return: 1
    # Declared-throw ABI: the outputs follow every input, the normal result
    # first and the throw payload last, and the control status is the return.
    # A callable that cannot throw keeps its direct return unchanged.
    if: l2_m_throws != 0 && l2_m_throws[mi] != 0
        if: ret_ty = 2 && fputs("; @: size_t l2_out_result", l2_out) < 0
            return: 1
        if: ret_ty = 30 && fputs("; @: unsigned l2_out_result", l2_out) < 0
            return: 1
        if: ret_ty = 33 && fputs("; @: unsigned l2_out_result", l2_out) < 0
            return: 1
        if: ret_ty = 36 && fputs("; @: ulong l2_out_result", l2_out) < 0
            return: 1
        if: ret_ty = 3 && fputs("; @@: char l2_out_result", l2_out) < 0
            return: 1
        if: ret_ty = 16 && fputs("; @@: void l2_out_result", l2_out) < 0
            return: 1
        if: ret_ty = 35 && fputs("; const: @@(char l2_out_result)", l2_out) < 0
            return: 1
        if: ret_ty = 32 && fputs("; @@@: char l2_out_result", l2_out) < 0
            return: 1
        if: ret_ty >= 100 && fputs("; @@: Lmx l2_out_result", l2_out) < 0
            return: 1
        if: l2_ret_uns(mi) = 0 && ret_ty != 3 && ret_ty != 8 && ret_ty != 16 && ret_ty != 32 && ret_ty != 35 && ret_ty < 100 && fputs("; @: int l2_out_result", l2_out) < 0
            return: 1
        if: fputs("; @@: Lmx l2_out_throw) int", l2_out) < 0
            return: 1
        return: 0
    ---
    if: ret_ty = 2 && fputs(") size_t", l2_out) < 0
        return: 1
    if: ret_ty = 30 && fputs(") unsigned", l2_out) < 0
        return: 1
    if: ret_ty = 33 && fputs(") unsigned", l2_out) < 0
        return: 1
    if: ret_ty = 36 && fputs(") ulong", l2_out) < 0
        return: 1
    if: ret_ty = 3 && fputs(") @: char", l2_out) < 0
        return: 1
    if: ret_ty = 16 && fputs(") @: void", l2_out) < 0
        return: 1
    if: ret_ty = 35 && fputs(") const: @(char)", l2_out) < 0
        return: 1
    if: ret_ty = 32 && fputs(") @@: char", l2_out) < 0
        return: 1
    if: ret_ty >= 100 && l2_emit_foreign_return(l2_out, ret_ty) != 0
        return: 1
    if: ret_ty = 8 && fputs(")", l2_out) < 0
        return: 1
    if: l2_ret_uns(mi) = 0 && ret_ty != 3 && ret_ty != 5 && ret_ty != 8 && ret_ty != 10 && ret_ty != 13 && ret_ty != 16 && ret_ty != 32 && ret_ty != 35 && ret_ty < 100 && fputs(") int", l2_out) < 0
        return: 1
return: 0

# The formal type code of input k of method mi, in signature order: declared formals first,
# hidden/dynamic inputs after them.
fn: l2_input_ft (int: mi; int: k) int
    if: k < l2_m_arity[mi]
        return: l2_ft(mi, k)
return: l2_ft_of_own(l2_own_of_dt(l2_dt(mi, k - l2_m_arity[mi])))

# THE TRAMPOLINE (FABLE-OPUS-ROOT-WALK-TRANSLATOR-20260924-159; plan §3 «Пользовательский код
# интерпретируется по умолчанию»; steps/root-walk-trampolines.md).  Every method with a native
# body has one more entry, with the uniform prim ABI LmxPrimitiveEntry (owner, refs, nargs,
# dest, out) -> status (lmx_primitive.h.lm1), and its METHOD.addr is that entry: a walked body's
# call op, lmx_call0 and lmx_call_prim reach a native method the same way.  A direct native call
# keeps calling the method by its own symbol.
#   * owner is the method's occurrence: node = owner\parent (lmx_call_node), self = owner;
#   * refs are the inputs in signature order, read by l2_emit_formal's own table;
#   * nargs that differs from the signature is the caller's broken promise -- the translator
#     wrote both -- so it is X1, never a status;
#   * the status is the method's own throw status (S1.1: declared names 1..d in `throws:`
#     order, implicit d+g), 0 for a method that cannot throw; on a throw `out` carries the
#     thrown record (the method's l2_out_throw);
#   * the result reaches the caller the way the walker takes values: a scalar is written into
#     the typed storage `dest` addresses and `out` is dest; a pointer is the reference itself
#     in `out`; no result leaves `out` 0.  l2_msg is 0, as the entry adapter passes it: it is
#     only ever passed down.
# A method with a native body: a body, or a return trailer that is its body.
fn: l2_m_native (int: i) int
    if: i < 0
        return: 0
return: (cast: (int) (l2_m_body[i] != 0 || (l2_m_node[i] != 0 && l2_m_node[i]\as != 0 && l2_ret_tr(l2_m_node[i]\as\frame) != 0)))

# How a trampoline delivers the result of method mi -- the cases l2_emit_sig spells: 0 none,
# 1 int, 2 size_t, 3 unsigned, 4 ulong, 5 a pointer (the reference itself), 6 a foreign value
# (the typed storage `dest` addresses).
fn: l2_tramp_class (int: mi) int
    int: rt l2_sig_ret(mi)
    int: fi
    int: thr 0
    if: l2_m_throws != 0 && l2_m_throws[mi] != 0
        thr: 1
    ---
    if: rt = 8
        return: 0
    if: rt = 2
        return: 2
    if: rt = 30 || rt = 33
        return: 3
    if: rt = 36
        return: 4
    if: rt = 3 || rt = 16 || rt = 35 || rt = 32
        return: 5
    # The declared-throw ABI returns every foreign result as @: Lmx (l2_emit_sig).
    fi: rt - 100
    if: rt >= 100 && thr = 0 && fi < l2_foreign_n && l2_foreign_depth[fi] = 0
        return: 6
    if: rt >= 100
        return: 5
    if: l2_ret_uns(mi) = 0 && rt != 3 && rt != 8 && rt != 16 && rt != 32 && rt != 35 && (thr != 0 || (rt != 5 && rt != 10 && rt != 13))
        return: 1
return: 0

# The typed store of a scalar result class (l2_tramp_class 1-4).
fn: l2_tramp_store (int: cls) const: @: char
    if: cls = 2
        return: "lmx_size_store_known"
    if: cls = 3
        return: "lmx_unsigned_store_known"
    if: cls = 4
        return: "lmx_ulong_store_known"
return: "lmx_int_store_known"

# The dynamic call of the callable formal occurrence l2_c<self_t> that carries the signature of
# method idx (l2_emit_call, sel 2): nullary, through lmx_call_prim.  The value lands the way the
# method's trampoline delivers it (l2_tramp_class): a scalar or a foreign value in l2_t<t> through
# dest; a pointer through out, then into l2_t<t>.  On a throw `out` is the thrown record.
fn: l2_emit_dyn_call (int: idx; int: t; int: self_t; const: @(char ind)) int
    int: cls l2_tramp_class(idx)
    if: c.fprintf(l2_out, "%s@: void l2_o%d 0\n", ind, t) < 0
        return: 1
    # -189 c3a (Q28): a call by reference runs over a fresh instance of the callee, made from its
    # code by the kernel (lmx_fresh): the caller does not know the callee's prototype.  The data
    # is lmx_call_prim's operand; the trampoline makes nothing.
    if: c.fprintf(l2_out, "%s@: Lmx l2_d%d lmx_fresh(l2_program_arena, l2_c%d)\n%sif: l2_d%d = 0\n", ind, t, self_t, ind, t) < 0 || l2_emit_invariant(ind, "a fresh instance could not be made") != 0
        return: 1
    if: l2_m_throws[idx] != 0 && c.fprintf(l2_out, "%sl2_ts%d: lmx_call_prim(l2_program_arena, l2_c%d, l2_d%d, 0, 0U, ", ind, t, self_t, t) < 0
        return: 1
    if: l2_m_throws[idx] = 0 && c.fprintf(l2_out, "%sif: lmx_call_prim(l2_program_arena, l2_c%d, l2_d%d, 0, 0U, ", ind, self_t, t) < 0
        return: 1
    if: (cls = 0 || cls = 5) && fputs("0", l2_out) < 0
        return: 1
    if: cls != 0 && cls != 5 && c.fprintf(l2_out, "(cast: (@: void) (@ l2_t%d))", t) < 0
        return: 1
    if: c.fprintf(l2_out, ", @ l2_o%d)", t) < 0
        return: 1
    if: l2_m_throws[idx] = 0 && c.fprintf(l2_out, " != 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: a callable that cannot throw reported a status\\n\")\n%s    c.abort()\n", ind, ind) < 0
        return: 1
    if: l2_m_throws[idx] != 0 && c.fprintf(l2_out, "\n%sif: l2_ts%d != 0\n%s    l2_te%d: (cast: (@: Lmx) l2_o%d)\n", ind, t, ind, t, t) < 0
        return: 1
    if: cls = 5 && l2_m_throws[idx] = 0 && c.fprintf(l2_out, "%sl2_t%d: l2_o%d\n", ind, t, t) < 0
        return: 1
    if: cls = 5 && l2_m_throws[idx] != 0 && c.fprintf(l2_out, "%sif: l2_ts%d = 0\n%s    l2_t%d: l2_o%d\n", ind, t, ind, t, t) < 0
        return: 1
return: 0

# The call of method i from its trampoline: node, self, the inputs, and for the declared-throw
# ABI l2_msg 0, the result local and the thrown-record local.
fn: l2_emit_tramp_call (int: i; int: n; int: thr; int: cls) int
    int: k 0
    if: l2_write_sym(l2_out, i) != 0 || fputs("(l2_self\\parent, l2_self", l2_out) < 0
        return: 1
    while: k < n
        if: l2_emit_formal(l2_input_ft(i, k), i, k, 1) != 0
            return: 1
        k: k + 1
    if: thr != 0 && fputs(", 0", l2_out) < 0
        return: 1
    if: thr != 0 && cls != 0 && fputs(", @ l2_tv", l2_out) < 0
        return: 1
    if: thr != 0 && fputs(", @ l2_tt", l2_out) < 0
        return: 1
return: (cast: (int) (fputs(")", l2_out) < 0))

# The trampoline of method i: its prototype line (proto) or its definition.
fn: l2_emit_trampoline (int: i; int: proto) int
    int: k 0
    int: n l2_m_arity[i] + l2_m_dyn[i]
    int: cls l2_tramp_class(i)
    int: rt l2_sig_ret(i)
    int: thr 0
    if: l2_m_throws != 0 && l2_m_throws[i] != 0
        thr: 1
    ---
    if: proto != 0 && fputs("    fn: ", l2_out) < 0
        return: 1
    if: proto = 0 && fputs("fn: ", l2_out) < 0
        return: 1
    if: l2_write_sym(l2_out, i) != 0 || fputs("_tr (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int\n", l2_out) < 0
        return: 1
    if: proto != 0
        return: 0
    # owner is the data its caller passed (-189 c3a): the occurrence itself, or a fresh instance.
    if: c.fprintf(l2_out, "    @: Lmx l2_self (cast: (@: Lmx) owner)\n") < 0
        return: 1
    if: c.fprintf(l2_out, "    if: nargs != %dU || out = 0", n) < 0
        return: 1
    if: (cls = 1 || cls = 2 || cls = 3 || cls = 4 || cls = 6) && fputs(" || dest = 0", l2_out) < 0
        return: 1
    if: fputs("\n        c.fprintf(c.stderr, \"lmx: invariant: a trampoline was called outside its method's signature\\n\")\n        c.abort()\n", l2_out) < 0
        return: 1
    while: k < n
        if: l2_emit_formal(l2_input_ft(i, k), i, k, 2) != 0
            return: 1
        k: k + 1
    # The method that cannot throw: its value is the call's own result.
    if: thr = 0 && cls = 0 && (fputs("    ", l2_out) < 0 || l2_emit_tramp_call(i, n, thr, cls) != 0 || fputs("\n    \\out: 0\n", l2_out) < 0)
        return: 1
    if: thr = 0 && cls >= 1 && cls <= 4 && (c.fprintf(l2_out, "    %s(dest, ", l2_tramp_store(cls)) < 0 || l2_emit_tramp_call(i, n, thr, cls) != 0 || fputs(")\n    \\out: dest\n", l2_out) < 0)
        return: 1
    if: thr = 0 && cls = 5 && (fputs("    \\out: (cast: (@: void) ", l2_out) < 0 || l2_emit_tramp_call(i, n, thr, cls) != 0 || fputs(")\n", l2_out) < 0)
        return: 1
    if: thr = 0 && cls = 6 && (fputs("    @: ", l2_out) < 0 || l2_write_text(l2_out, l2_foreign_name[rt - 100]) != 0 || fputs(" l2_rv (cast: (@: ", l2_out) < 0 || l2_write_text(l2_out, l2_foreign_name[rt - 100]) != 0 || fputs(") dest)\n    \\l2_rv: ", l2_out) < 0)
        return: 1
    if: thr = 0 && cls = 6 && (l2_emit_tramp_call(i, n, thr, cls) != 0 || fputs("\n    \\out: dest\n", l2_out) < 0)
        return: 1
    # The declared-throw ABI: the result through its local, the status as the throw status.
    if: thr != 0 && cls = 1 && fputs("    int: l2_tv 0\n", l2_out) < 0
        return: 1
    if: thr != 0 && cls = 2 && fputs("    size_t: l2_tv 0U\n", l2_out) < 0
        return: 1
    if: thr != 0 && cls = 3 && fputs("    unsigned: l2_tv 0U\n", l2_out) < 0
        return: 1
    if: thr != 0 && cls = 4 && fputs("    ulong: l2_tv 0U\n", l2_out) < 0
        return: 1
    if: thr != 0 && cls = 5 && rt = 3 && fputs("    @: char l2_tv 0\n", l2_out) < 0
        return: 1
    if: thr != 0 && cls = 5 && rt = 16 && fputs("    @: void l2_tv 0\n", l2_out) < 0
        return: 1
    if: thr != 0 && cls = 5 && rt = 35 && fputs("    const: @(char l2_tv) 0\n", l2_out) < 0
        return: 1
    if: thr != 0 && cls = 5 && rt = 32 && fputs("    @@: char l2_tv 0\n", l2_out) < 0
        return: 1
    if: thr != 0 && cls = 5 && rt >= 100 && fputs("    @: Lmx l2_tv 0\n", l2_out) < 0
        return: 1
    if: thr != 0 && (fputs("    @: Lmx l2_tt 0\n    int: l2_ts 0\n    l2_ts: ", l2_out) < 0 || l2_emit_tramp_call(i, n, thr, cls) != 0)
        return: 1
    if: thr != 0 && fputs("\n    if: l2_ts != 0\n        \\out: (cast: (@: void) l2_tt)\n        return: l2_ts\n", l2_out) < 0
        return: 1
    if: thr != 0 && cls = 0 && fputs("    \\out: 0\n", l2_out) < 0
        return: 1
    if: thr != 0 && cls >= 1 && cls <= 4 && c.fprintf(l2_out, "    %s(dest, l2_tv)\n    \\out: dest\n", l2_tramp_store(cls)) < 0
        return: 1
    if: thr != 0 && cls = 5 && fputs("    \\out: (cast: (@: void) l2_tv)\n", l2_out) < 0
        return: 1
    if: fputs("    return: 0\nend: ", l2_out) < 0 || l2_write_sym(l2_out, i) != 0 || fputs("_tr\n\n", l2_out) < 0
        return: 1
return: 0

# THE WALKED ROOT (FABLE-OPUS-ROOT-WALK-TRANSLATOR-20260924-159 commit 2; plan §3 «Пользовательский
# код интерпретируется по умолчанию»; steps/root-walk-coverage.md).  A file's root body is
# interpreted: its statements are built, with the unit graph, as walker nodes (lmx_walk.h.lm1), the
# steps after every field of the unit, and the unit's child 0 is a descriptor with addr 0 -- the
# turn walks the unit (descriptor dispatch); the last evaluated expression stays the activation's
# own value, and the program's exit is the host's (lmx_root_launch).  The declarations stay fields (the
# root's own cells, the methods, the named Structures), and the walk passes over them.  E stays the
# pseudo-method that holds the root's own fields and is checked as before; after those checks a
# root statement is
#   * an L2 operation (c.*, @, \p, sizeof:, cast:, an L2 block): refused, «L2 operation outside a
#     method body» -- L2 belongs in methods (plan §4 (5));
#   * `return: V`: refused, «return with a value at the root» -- the program's exit is the host's:
#     `sendMessage: exit(exit_code: V; stdout: ""; stderr: "")`, then a bare `return`;
#   * built as walker nodes, when this translator builds that form: a numeric own field -- int,
#     char, size_t, unsigned, ulong (declared with or without an initializer, assigned, read) --,
#     a decimal or char literal typed by its place, + - < = and != > <= >= over one type (-175:
#     two types are a conversion, refused), a call of a method with numeric inputs and an int
#     result (one that can throw included: a throw at the root is uncaught and stops R0),
#     `implements(candidate, required, consumer)` (its translation-time answer, an int literal), an
#     expression statement, if/else, an anonymous block, a bare `return`, and
#     `sendMessage: Name(f: v; ...)` to the parent (l2_rw_send); since -196 also `&&` / `||`,
#     short-circuit, as flag steps (l2_rw_sc), `while:`, a path through a qualified branch (read)
#     or through a method's occurrence (`M\x`, `M\[N]x`, read and written), a call through a path
#     (`Holder\viaPath(4U)`), and a string literal alone as a statement (no step);
#   * otherwise refused, located: «root operation not walkable yet: <op>» -- never dropped and
#     never run natively.
# Two passes over the same statements: the first (l2_rw_emit 0) checks and counts the unit's
# steps before the unit's size is written; the second emits the construction.

# A root statement or operand this translator does not build as walker nodes yet.
fn: l2_rw_refuse (const: @(LmP0Node node); const: @(char what)) int
    c.array: [192]: char msg
    c.snprintf(msg, 192U, "root operation not walkable yet: %s", what)
return: l2_error(l2_src, node, msg)

# An L2 operation in the root: L2 belongs in methods (plan §4 (5)).
fn: l2_rw_l2 (const: @(LmP0Node node)) int
return: l2_error(l2_src, node, "L2 operation outside a method body")

# The name of container t: the unit (t < 0) or the node temp l2_rw<t>.
sub: l2_rw_name (int: t; @: char dest)
    if: t < 0
        c.sprintf(dest, "l2_entry_unit")
    else:
        c.sprintf(dest, "l2_rw%d", t)
    ---
end: l2_rw_name

# A frame node of role `code` with `children` slots (its role slot included) under container
# `parent`; its temp is written to out.
fn: l2_rw_frame (int: parent; const: @(char code); int: children; @: int out) int
    c.array: [32]: char pn
    int: t l2_rw_t
    l2_rw_t: l2_rw_t + 1
    \out: t
    if: l2_rw_emit = 0
        return: 0
    l2_rw_name(parent, pn)
return: (cast: (int) (c.fprintf(l2_out, "        @: Lmx l2_rw%d lmx_walk_frame(l2_program_arena, l2_rw_roles, %s, c.%s, %dU)\n        if: l2_rw%d = 0\n            return: 1\n", t, pn, code, children, t) < 0))

# Node `node`'s slot `slot` takes node `child`.
fn: l2_rw_put (int: node; int: slot; int: child) int
    if: l2_rw_emit = 0
        return: 0
return: (cast: (int) (c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", node, slot, child) < 0))

# An int literal.
fn: l2_rw_lit (int: parent; int: value; @: int out) int
    if: l2_rw_frame(parent, "LMX_WALK_OP_LIT", 2, out) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_int(l2_program_arena, l2_rw%d, 1U, %d) != c.LMX_WALK_OK\n            return: 1\n", \out, value) < 0
        return: 1
return: 0

# THE ROOT'S NUMERIC TYPES (FABLE-OPUS-ROOT-TYPED-20260925-175; -167 Part A: a value's type is its
# cell's).  A root field or value is an int, a char, a size_t, an unsigned or a ulong -- the own
# storage codes 0, 1, 2, 3 and 36 -- and the walker takes the operands of + - < = and of a store as
# one type, refusing a mix at run time.  So the translator gives every root expression its static
# type first (l2_rw_tyof): a field's own type; a literal's is its context's -- -1 marks a literal
# alone, -2 one with a `U`, which only an unsigned type takes; a comparison's is int; -3 marks two
# types met, refused where they meet: a conversion is a later ticket (Q24/D-48).  The emission then
# gives each literal the type its place resolved to (`got != 1U` with a size_t got is LIT size_t 1).
fn: l2_rw_num_ty (int: ty) int
    if: ty = 0 || ty = 1 || ty = 2 || ty = 3 || ty = 36
        return: 1
return: 0

# The refusal for the root's own field oi, which is not a number: what it is.
fn: l2_rw_refuse_ty (const: @(LmP0Node node); int: oi) int
    if: l2_own_is_array(l2_own_ty[oi]) != 0
        return: l2_rw_refuse(node, "an array")
    if: l2_own_is_pointer(l2_own_ty[oi]) != 0 && l2_ft_of_own(l2_own_ty[oi]) >= 100
        return: l2_rw_refuse(node, "a Structure-typed field")
return: l2_rw_refuse(node, "a value that is not a number")

# The own field named t that the body being built sees (-193 T4a), or -1: the last one of that
# name of the method being built (l2_rw_mi; the root's are the unit's), else a unit field the method
# sees -- l2_own_find_last's own fallback. A formal's name is its input (ARG) until that formal's
# numeric field has had its binding line (T4b class 2); from then on it is that field.
fn: l2_rw_find (const: @(LmP0Text t)) int
    int: oi
    if: l2_rw_mi != l2_e && l2_formal_find(l2_rw_mi, t) >= 0
        oi: l2_rw_bound(t)
        if: oi >= 0
            return: oi
        return: 0 - 1
return: l2_own_find_last(l2_rw_mi, t)

# The numeric own field named t that is already bound to a formal, or -1.
# The latest mark wins (l2_formal_row). Leaving a body clears only a field
# declared in that body (D-79); a formal's method cell stays bound.
fn: l2_rw_bound (const: @(LmP0Text t)) int
    int: oi 0
    int: best 0 - 1
    int: bestn 0
    if: l2_rw_bseq = 0 || l2_rw_mi = l2_e
        return: 0 - 1
    while: oi < l2_own_n
        if: oi != l2_own_excl && l2_own_mi[oi] = l2_rw_mi && l2_rw_bseq[oi] > bestn && (l2_own_uchild[oi] >= 0 || l2_own_fchild[oi] >= 0) && l2_rw_num_ty(l2_own_ty[oi]) != 0 && l2_text_same(l2_own_name[oi], t) != 0
            best: oi
            bestn: l2_rw_bseq[oi]
        oi: oi + 1
    ---
return: best

# The visible numeric own field named t that a formal's first store will bind, or -1.
# Not bound yet. A hosted field is visible only while its body is the scope (class 3).
fn: l2_rw_formal_slot (const: @(LmP0Text t)) int
    int: oi 0
    int: best 0 - 1
    if: l2_rw_bseq = 0 || l2_rw_mi = l2_e || l2_formal_find(l2_rw_mi, t) < 0
        return: 0 - 1
    while: oi < l2_own_n
        if: oi != l2_own_excl && l2_own_mi[oi] = l2_rw_mi && l2_rw_bseq[oi] = 0 && (l2_own_host[oi] = 0 || l2_scope_has(l2_own_host[oi]) != 0) && (l2_own_uchild[oi] >= 0 || l2_own_fchild[oi] >= 0) && l2_rw_num_ty(l2_own_ty[oi]) != 0 && l2_text_same(l2_own_name[oi], t) != 0 && l2_frame_head(l2_own_host[oi], "catch") = 0
            best: oi
        oi: oi + 1
    ---
return: best

# Clear the walk's binding marks. The array lives for the whole translation.
fn: l2_rw_bseq_zero () int
    int: i 0
    l2_rw_bseq_n: 0
    if: l2_own_n <= 0
        return: 0
    if: l2_rw_bseq = 0
        l2_rw_bseq: (cast: (@: int) calloc((cast: (size_t) l2_own_n), c.sizeof(c.int)))
        if: l2_rw_bseq = 0
            return: 1
        return: 0
    ---
    while: i < l2_own_n
        l2_rw_bseq[i]: 0
        i: i + 1
    ---
return: 0

# Remember that own row oi's binding line has been reached.
fn: l2_rw_bseq_mark (int: oi) int
    if: l2_rw_bseq = 0 || oi < 0 || oi >= l2_own_n
        return: 1
    l2_rw_bseq_n: l2_rw_bseq_n + 1
    l2_rw_bseq[oi]: l2_rw_bseq_n
return: 0

# Enter host's body. saved is the mark counter; marks above it belong to this body.
fn: l2_rw_enter (const: @(LmP0Node host); @: int saved) int
    \saved: l2_rw_bseq_n
return: l2_scope_push(host)

# Leave the body: drop its scope and the marks of fields declared in it (D-79).
# A formal bound by a bare write keeps that mark past the body.
fn: l2_rw_leave (int: saved) int
    @: LmP0Node host
    int: k 0
    host: l2_scope_host()
    if: l2_scope_pop() != 0
        return: 1
    if: l2_rw_bseq = 0
        return: 0
    while: k < l2_own_n
        if: l2_rw_bseq[k] > saved && l2_own_host[k] = host
            l2_rw_bseq[k]: 0
        k: k + 1
    ---
return: 0

# A numeric own field declared in a nested body, not a catch parameter (T4b class 3).
fn: l2_rw_is_hosted (int: oi) int
    if: oi < 0 || oi >= l2_own_n || l2_own_host[oi] = 0
        return: 0
    if: l2_own_fid[oi] < 0 || l2_own_fchild[oi] < 0 || l2_rw_num_ty(l2_own_ty[oi]) = 0
        return: 0
    if: l2_frame_head(l2_own_host[oi], "catch") != 0
        return: 0
return: 1

# The control body fid, as a reference from this activation's data (holder 0).
# A top-level body is AT(holder 0, its child). A nested body is OF of its parent.
fn: l2_rw_host_at (int: parent; int: fid; @: int out) int
    int: base
    if: fid < 0 || fid >= l2_for_n || l2_for_uchild[fid] < 0
        return: 1
    if: l2_for_parent[fid] < 0
        if: l2_rw_frame(parent, "LMX_WALK_OP_AT", 3, out) != 0
            return: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %uU) != c.LMX_WALK_OK\n            return: 1\n", \out, (cast: (unsigned) l2_for_uchild[fid])) < 0
            return: 1
        return: 0
    ---
    if: l2_rw_frame(parent, "LMX_WALK_OP_OF", 3, out) != 0
        return: 1
    if: l2_rw_host_at(\out, l2_for_parent[fid], @ base) != 0 || l2_rw_put(\out, 1, base) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %uU) != c.LMX_WALK_OK\n            return: 1\n", \out, (cast: (unsigned) l2_for_uchild[fid])) < 0
        return: 1
return: 0

# Read hosted field oi: OF(its control body, its child). The cell, as AT is for a method field.
fn: l2_rw_host_read (int: parent; int: oi; @: int out) int
    int: base
    if: l2_rw_frame(parent, "LMX_WALK_OP_OF", 3, out) != 0
        return: 1
    if: l2_rw_host_at(\out, l2_own_fid[oi], @ base) != 0 || l2_rw_put(\out, 1, base) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %uU) != c.LMX_WALK_OK\n            return: 1\n", \out, (cast: (unsigned) l2_own_fchild[oi])) < 0
        return: 1
return: 0

# Write hosted field oi: PUT_OF(its control body, its child, value).
fn: l2_rw_host_put (int: into; int: oi; @: LmP0Field first; int: n; @: int out) int
    int: value
    int: h
    if: l2_rw_frame(into, "LMX_WALK_OP_PUT_OF", 4, out) != 0
        return: 1
    if: l2_rw_host_at(\out, l2_own_fid[oi], @ h) != 0 || l2_rw_put(\out, 1, h) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %uU) != c.LMX_WALK_OK\n            return: 1\n", \out, (cast: (unsigned) l2_own_fchild[oi])) < 0
        return: 1
    if: l2_rw_texpr(first, n, l2_own_ty[oi], \out, @ value) != 0
        return: 1
return: l2_rw_put(\out, 3, value)

# Carry a formal into a hosted field: PUT_OF of the argument, read before the mark.
fn: l2_rw_host_carry (int: into; int: oi; @: int out) int
    int: arg
    int: h
    int: j
    j: l2_formal_find(l2_rw_mi, l2_own_name[oi])
    if: j < 0
        return: 1
    if: l2_rw_frame(into, "LMX_WALK_OP_PUT_OF", 4, out) != 0
        return: 1
    if: l2_rw_host_at(\out, l2_own_fid[oi], @ h) != 0 || l2_rw_put(\out, 1, h) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %uU) != c.LMX_WALK_OK\n            return: 1\n", \out, (cast: (unsigned) l2_own_fchild[oi])) < 0
        return: 1
    if: l2_rw_arg(\out, j, @ arg) != 0
        return: 1
return: l2_rw_put(\out, 3, arg)

# A declaration of a formal's field with no initializer carries the argument into the cell.
fn: l2_rw_carry (int: into; int: oi; @: int out) int
    int: arg
    int: j
    j: l2_formal_find(l2_rw_mi, l2_own_name[oi])
    if: j < 0
        return: 1
    if: l2_rw_frame(into, "LMX_WALK_OP_PUT", 4, out) != 0 || l2_rw_cell(\out, oi) != 0 || l2_rw_arg(\out, j, @ arg) != 0
        return: 1
return: l2_rw_put(\out, 3, arg)

# Is own row oi one the body being built reaches: its own, or the unit's?
fn: l2_rw_seen (int: oi) int
return: (cast: (int) (oi >= 0 && (l2_own_mi[oi] = l2_rw_mi || l2_own_mi[oi] = l2_e)))

# The type of the root's own numeric field named t, or -9 (not one: the emission says why).
fn: l2_rw_own_ty (const: @(LmP0Text t)) int
    int: oi l2_rw_find(t)
    if: oi < 0 || l2_rw_seen(oi) = 0
        return: 0 - 9
    # A catch parameter is a hosted numeric cell of its catch frame (l2_b of that frame).
    # T4b class 3: any other numeric field declared in a nested body, in a method.
    if: l2_own_host[oi] != 0
        if: l2_rw_is_hosted(oi) != 0 && l2_rw_mi != l2_e
            return: l2_own_ty[oi]
        if: l2_frame_head(l2_own_host[oi], "catch") = 0 || l2_own_fid[oi] < 0 || l2_own_fchild[oi] < 0 || l2_rw_num_ty(l2_own_ty[oi]) = 0
            return: 0 - 9
        return: l2_own_ty[oi]
    if: l2_own_fid[oi] >= 0 || l2_own_uchild[oi] < 0
        return: 0 - 9
    # A reference field (a pointer cell: a letter, a Structure-typed field) has its own type too,
    # 1000 and above: it is compared with 0 or another reference only (-179).
    if: l2_rw_num_ty(l2_own_ty[oi]) = 0 && l2_own_is_pointer(l2_own_ty[oi]) = 0
        return: 0 - 9
return: l2_own_ty[oi]

# A decimal literal: an optional minus, digits, an optional `U`; its sign, magnitude and suffix.
fn: l2_rw_num_lit (const: @(LmP0Text t); @: int neg; @: size_t mag; @: int usuf) int
    size_t: i 0U
    size_t: stop
    size_t: v 0U
    size_t: d
    size_t: top 0U
    top: top - 1U
    \neg: 0
    \mag: 0U
    \usuf: 0
    if: t = 0 || t\data = 0 || t\length = 0U
        return: 0
    stop: t\length
    if: t\data[stop - 1U] = 85 || t\data[stop - 1U] = 117
        \usuf: 1
        stop: stop - 1U
    ---
    if: t\data[0] = 45
        \neg: 1
        i: 1U
    ---
    if: i >= stop || (\neg != 0 && \usuf != 0)
        return: 0
    while: i < stop
        if: t\data[i] < 48 || t\data[i] > 57
            return: 0
        d: (cast: (size_t) (t\data[i] - 48))
        if: v > (top - d) / 10U
            return: 0
        v: v * 10U + d
        i: i + 1U
    ---
    \mag: v
return: 1

# A char literal: one byte between quotes, or \0 \n \t \\ \'; its byte value.
fn: l2_rw_char_lit (const: @(LmP0Text t); @: int value) int
    if: t = 0 || t\data = 0 || t\length < 3U || t\data[0] != 39 || t\data[t\length - 1U] != 39
        return: 0
    if: t\length = 3U && t\data[1] != 92 && t\data[1] != 39
        \value: (cast: (int) t\data[1]) & 255
        return: 1
    if: t\length != 4U || t\data[1] != 92
        return: 0
    if: t\data[2] = 48
        \value: 0
        return: 1
    if: t\data[2] = 110
        \value: 10
        return: 1
    if: t\data[2] = 116
        \value: 9
        return: 1
    if: t\data[2] = 92 || t\data[2] = 39
        \value: (cast: (int) t\data[2])
        return: 1
return: 0

# A char literal node: the byte's cell.
fn: l2_rw_clit (int: parent; int: value; @: int out) int
    if: l2_rw_frame(parent, "LMX_WALK_OP_LIT", 2, out) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_char(l2_program_arena, l2_rw%d, 1U, %d) != c.LMX_WALK_OK\n            return: 1\n", \out, value) < 0
        return: 1
return: 0

# A decimal literal in type ty: in its range, a `U` only in an unsigned type, a char as its byte
# (a negative one as C stores it, -1 is 255).
fn: l2_rw_tlit (const: @(LmP0Node node); int: parent; int: ty; int: neg; size_t: mag; int: usuf; @: int out) int
    int: v 0
    # Beside a reference only 0 stands, "no Structure": the walker's EQ takes LIT int 0 there.
    if: ty >= 1000
        if: neg != 0 || usuf != 0 || mag != 0U
            return: l2_rw_refuse(node, "a reference compared with a number other than 0")
        return: l2_rw_lit(parent, 0, out)
    ---
    if: usuf != 0 && (ty = 0 || ty = 1)
        return: l2_rw_refuse(node, "a U literal in a signed type")
    if: neg != 0 && (ty = 2 || ty = 3 || ty = 36)
        return: l2_rw_refuse(node, "a literal out of its type's range")
    if: ty = 0
        if: (neg = 0 && mag > 2147483647U) || (neg != 0 && mag > 2147483648U)
            return: l2_rw_refuse(node, "a literal out of its type's range")
        if: neg != 0 && mag > 0U
            v: 0 - (cast: (int) (mag - 1U)) - 1
        else:
            v: (cast: (int) mag)
        ---
        return: l2_rw_lit(parent, v, out)
    if: ty = 1
        if: (neg = 0 && mag > 255U) || (neg != 0 && mag > 128U)
            return: l2_rw_refuse(node, "a literal out of its type's range")
        v: (cast: (int) mag)
        if: neg != 0
            v: (256 - v) & 255
        ---
        return: l2_rw_clit(parent, v, out)
    if: (ty = 3 || ty = 36) && mag > 4294967295U
        return: l2_rw_refuse(node, "a literal out of its type's range")
    if: l2_rw_frame(parent, "LMX_WALK_OP_LIT", 2, out) != 0
        return: 1
    if: l2_rw_emit = 0
        return: 0
    if: ty = 2 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 1U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", \out, mag) < 0
        return: 1
    if: ty = 3 && c.fprintf(l2_out, "        if: lmx_walk_store_unsigned(l2_program_arena, l2_rw%d, 1U, %uU) != c.LMX_WALK_OK\n            return: 1\n", \out, (cast: (unsigned) mag)) < 0
        return: 1
    if: ty = 36 && c.fprintf(l2_out, "        if: lmx_walk_store_ulong(l2_program_arena, l2_rw%d, 1U, %uU) != c.LMX_WALK_OK\n            return: 1\n", \out, (cast: (unsigned) mag)) < 0
        return: 1
return: 0

# Tokens lo..hi (operands at lo, lo + 2, ...; operators between): the operator that splits them,
# the rightmost of the lowest precedence, so the operators associate to the left.
fn: l2_rw_split (@@: LmP0Node tok; int: lo; int: hi) int
    int: k lo + 1
    int: best lo + 1
    int: bestp 99
    int: p
    while: k < hi
        p: l2_rw_prec(tok[k]\as\atom)
        if: p <= bestp
            bestp: p
            best: k
        ---
        k: k + 2
    ---
return: best

# The one type of two operands' types, or -3 when they are two.
fn: l2_rw_unify (int: a; int: b) int
    if: a = 0 - 3 || b = 0 - 3
        return: 0 - 3
    if: a = b
        return: a
    if: a < 0 && b < 0
        return: 0 - 2
    if: a < 0
        return: b
    if: b < 0
        return: a
return: 0 - 3

# The static type of tokens lo..hi; where two types first meet is kept in l2_rw_mix_at.
fn: l2_rw_tyof (@@: LmP0Node tok; int: lo; int: hi) int
    int: best
    int: p
    int: u
    if: lo = hi
        return: l2_rw_opty(tok[lo])
    best: l2_rw_split(tok, lo, hi)
    # `a && b`, `a || b` (-196): two conditions, each of its own type; the value is an int.
    p: l2_rw_prec(tok[best]\as\atom)
    if: p = 1 || p = 2
        if: l2_rw_tyof(tok, lo, best - 1) = 0 - 3 || l2_rw_tyof(tok, best + 1, hi) = 0 - 3
            return: 0 - 3
        return: 0
    ---
    u: l2_rw_unify(l2_rw_tyof(tok, lo, best - 1), l2_rw_tyof(tok, best + 1, hi))
    if: u = 0 - 3
        if: l2_rw_mix_at = 0
            l2_rw_mix_at: tok[best]
        ---
        return: 0 - 3
    ---
    p: l2_rw_prec(tok[best]\as\atom)
    if: p = 3 || p = 4
        return: 0
return: u

# The type of a call of method idx's result, by its trampoline's class: an int, a size_t, an
# unsigned, a ulong (l2_rw_call builds the int one; the others are its located refusal).
fn: l2_rw_call_ty (int: idx) int
    int: cls l2_tramp_class(idx)
    if: cls = 2
        return: 2
    if: cls = 3
        return: 3
    if: cls = 4
        return: 36
return: 0

# The static type of one operand.  One this typing does not know takes any type (-1), like a
# literal: its emission names what it is (an L2 operation, a field path, a Structure value ...).
fn: l2_rw_opty (const: @(LmP0Node node)) int
    @: LmP0Text t
    int: neg 0
    size_t: mag 0U
    int: usuf 0
    int: v 0
    int: ty
    int: idx
    int: pmi 0 - 1
    size_t: eix 0U
    c.array: [40]: int path
    if: node = 0
        return: 0 - 1
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0 && node\as\structure != 0
        return: l2_rw_fields_ty(node\as\structure\first_field, l2_count_active(node\as\structure))
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0
        idx: l2_find_method(node\as\frame\head)
        if: idx >= 0 && idx != l2_e
            return: l2_rw_call_ty(idx)
        # A call through a path (`A\M()`, -196) is typed by the method it resolves to, as
        # l2_rw_operand builds it (D-75: untyped, an int result met a size_t place at run time).
        t: node\as\frame\head
        if: l2_rw_has_slash(t) != 0 && l2_path_kind(t\data, t\length, @ pmi) = 4 && pmi >= 0 && pmi != l2_e
            return: l2_rw_call_ty(pmi)
        if: l2_text_eq(node\as\frame\head, "implements")
            return: 0
        if: l2_text_eq(node\as\frame\head, "length")
            return: 2
        return: 0 - 1
    ---
    if: node\kind != c.LM_P0_NODE_ATOM || node\as = 0
        return: 0 - 1
    t: node\as\atom
    if: l2_rw_num_lit(t, @ neg, @ mag, @ usuf) != 0
        if: usuf != 0
            return: 0 - 2
        return: 0 - 1
    ---
    if: l2_rw_char_lit(t, @ v) != 0
        return: 1
    if: l2_rw_has_slash(t) != 0 && t\data[0] != 92
        eix: 0U
        while: eix < t\length && t\data[eix] != 91
            eix: eix + 1U
        ---
        if: eix < t\length
            return: l2_rw_index_ty(node, t)
        if: l2_rw_path(node, t, 0, path) = 0 && path[3] >= 0
            return: path[3]
        return: 0 - 1
    ---
    idx: l2_rw_elem_of(t, @ eix)
    if: idx >= 0
        return: l2_rw_elem_ty(idx)
    pmi: l2_dyn_own_index(l2_rw_mi, t, @ idx, @ v)
    if: pmi = 1
        return: l2_rw_elem_ty(idx)
    if: pmi = 2
        return: 0 - 3
    if: l2_rw_mi != l2_e && l2_formal_find(l2_rw_mi, t) >= 0
        idx: l2_rw_bound(t)
        if: idx >= 0
            return: l2_own_ty[idx]
        return: l2_own_ty_of_param(l2_ft(l2_rw_mi, l2_formal_find(l2_rw_mi, t)))
    ty: l2_rw_own_ty(t)
    if: ty >= 0
        return: ty
    idx: l2_find_method(t)
    if: idx >= 0 && idx != l2_e
        return: l2_rw_call_ty(idx)
return: 0 - 1

# The static type of an expression given as the run of n fields from `first` (any, -1, when it is
# not one: its emission refuses it).
fn: l2_rw_fields_ty (@: LmP0Field first; int: n) int
    c.array: [64]: @: LmP0Node tok
    int: m
    int: k 1
    if: n < 1 || n > 63
        return: 0 - 1
    m: l2_rw_tokens(first, n, tok)
    if: m < 1
        return: 0 - 1
    while: k < m
        if: tok[k] = 0 || tok[k]\kind != c.LM_P0_NODE_ATOM || tok[k]\as = 0 || l2_rw_prec(tok[k]\as\atom) = 0
            return: 0 - 1
        k: k + 2
    ---
return: l2_rw_tyof(tok, 0, m - 1)

# A path operand `a\b...`, which P0 gives inside an expression as the fields `a`, `\`, `b` (and
# more): the count of fields from f the run takes (1 when f does not start one), at most `avail`.
fn: l2_rw_path_run (@: LmP0Field f; int: avail) int
    int: n 1
    @: LmP0Field s
    @: LmP0Field g
    @: LmP0Field p3
    @: LmP0Field p4
    @: LmP0Field p5
    size_t: ix 0U
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || f\value\as\atom = 0
        return: 1
    s: l2_next_active(f\next)
    while: n + 2 <= avail && s != 0 && s\value != 0 && s\value\kind = c.LM_P0_NODE_ATOM && s\value\as != 0 && l2_is_slash(s\value\as\atom)
        g: l2_next_active(s\next)
        if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || g\value\as = 0 || g\value\as\atom = 0
            return: n
        # An occurrence index step `\[N]x` (-196): its five fields \ [ N ] x are one step of the run.
        if: l2_text_eq(g\value\as\atom, "[") != 0
            p3: l2_next_active(g\next)
            p4: 0
            p5: 0
            if: p3 != 0
                p4: l2_next_active(p3\next)
            if: p4 != 0
                p5: l2_next_active(p4\next)
            if: n + 5 > avail || p5 = 0 || p3\value = 0 || p3\value\kind != c.LM_P0_NODE_ATOM || p4\value = 0 || p4\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(p4\value\as\atom, "]") = 0 || p5\value = 0 || p5\value\kind != c.LM_P0_NODE_ATOM
                return: n
            n: n + 5
            s: l2_next_active(p5\next)
            continue
        ---
        n: n + 2
        s: l2_next_active(g\next)
    ---
    # An element `x[N]` of a bare name (-170): its four fields x [ N ] are one operand, spelled as a
    # statement's head spells it (l2_rw_elem_of).
    if: n = 1 && avail >= 4 && s != 0 && s\value != 0 && s\value\kind = c.LM_P0_NODE_ATOM && s\value\as != 0 && l2_text_eq(s\value\as\atom, "[") != 0
        p3: l2_next_active(s\next)
        p4: 0
        if: p3 != 0
            p4: l2_next_active(p3\next)
        if: p4 != 0 && p3\value != 0 && p3\value\kind = c.LM_P0_NODE_ATOM && p4\value != 0 && p4\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(p4\value\as\atom, "]") != 0
            return: 4
    ---
    # `path[i]` and `path[i][j]` (-203): the index groups stay inside the one operand.
    while: n + 3 <= avail && s != 0 && s\value != 0 && s\value\kind = c.LM_P0_NODE_ATOM && s\value\as != 0 && l2_text_eq(s\value\as\atom, "[") != 0
        p3: l2_next_active(s\next)
        p4: 0
        if: p3 != 0
            p4: l2_next_active(p3\next)
        if: p4 = 0 || p3\value = 0 || p3\value\kind != c.LM_P0_NODE_ATOM || p3\value\as = 0 || p4\value = 0 || p4\value\kind != c.LM_P0_NODE_ATOM || p4\value\as = 0 || l2_text_eq(p4\value\as\atom, "]") = 0
            return: n
        if: l2_dec_literal(p3\value\as\atom, @ ix) != 0
            return: n
        n: n + 3
        s: l2_next_active(p4\next)
    ---
return: n

# The path run of `run` fields from f as ONE atom `a\b...`, located where the path begins: the shape
# a path has as a statement's head, so a read and a write resolve it alike (l2_rw_path).
fn: l2_rw_path_atom (@: LmP0Field f; int: run) @: LmP0Node
    @: LmP0Node node
    @: LmP0NodeAs as
    @: LmP0Text text
    @: LmP0Text piece
    @: char buf
    @: LmP0Field g
    size_t: len 0U
    size_t: at 0U
    int: i 0
    g: f
    while: i < run && g != 0
        piece: g\value\as\atom
        len: len + piece\length
        g: l2_next_active(g\next)
        i: i + 1
    ---
    node: (cast: (@: LmP0Node) calloc(1U, c.sizeof(c.LmP0Node)))
    as: (cast: (@: LmP0NodeAs) calloc(1U, c.sizeof(c.LmP0NodeAs)))
    text: (cast: (@: LmP0Text) calloc(1U, c.sizeof(c.LmP0Text)))
    buf: (cast: (@: char) calloc(len + 1U, 1U))
    if: node = 0 || as = 0 || text = 0 || buf = 0
        return: 0
    g: f
    i: 0
    while: i < run && g != 0
        piece: g\value\as\atom
        memcpy((cast: (@: void) (buf + at)), (cast: (@: void) piece\data), piece\length)
        at: at + piece\length
        g: l2_next_active(g\next)
        i: i + 1
    ---
    text\data: buf
    text\length: len
    as\atom: text
    node\kind: c.LM_P0_NODE_ATOM
    node\flags: 0U
    node\span: f\value\span
    node\as: as
return: node

# `name [ index ]` is four fields. Joined, it is the atom `name[index]` the array ops read.
fn: l2_rw_index_run (@: LmP0Field f; int: avail) int
    @: LmP0Field a
    @: LmP0Field b
    @: LmP0Field c
    if: avail < 4 || f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || l2_ident(f\value\as\atom) = 0
        return: 1
    a: l2_next_active(f\next)
    if: a = 0 || a\value = 0 || a\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(a\value\as\atom, "[") = 0
        return: 1
    b: l2_next_active(a\next)
    if: b = 0 || b\value = 0 || b\value\kind != c.LM_P0_NODE_ATOM || b\value\as = 0
        return: 1
    c: l2_next_active(b\next)
    if: c = 0 || c\value = 0 || c\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(c\value\as\atom, "]") = 0
        return: 1
return: 4

# The tokens of an expression given as the run of n fields from `field`: operands at even places,
# operators between, a path operand as one atom (l2_rw_path_atom).  Their count, or -1 when the
# fields are not operand, operator, ..., operand.
fn: l2_rw_tokens (@: LmP0Field field; int: n; @@: LmP0Node tok) int
    @: LmP0Field f
    int: m 0
    int: k 0
    int: run
    f: l2_next_active(field)
    while: f != 0 && k < n
        if: m >= 63
            return: 0 - 1
        run: 1
        if: (m % 2) = 0
            run: l2_rw_path_run(f, n - k)
            if: run = 1
                run: l2_rw_index_run(f, n - k)
            ---
        ---
        if: run > 1
            tok[m]: l2_rw_path_atom(f, run)
            if: tok[m] = 0
                return: 0 - 1
            ---
        else:
            tok[m]: f\value
        ---
        m: m + 1
        k: k + run
        f: l2_skip_span(f, run)
    ---
    if: k != n || (m % 2) = 0
        return: 0 - 1
return: m

# A method's occurrence as a path root at the walked root (-196): `M\x`, or `M\[N]x`, the own field
# (occurrence N) of method M, read or written in M's occurrence -- the unit child l2_unit_base + M --
# at its slot (l2_own_mslot), as natively (l2_check_fields' method-root branches: the last same-name
# own field, or occurrence N, that M uses).  One name after the root, a number.  `i` stands on the
# backslash after M.
fn: l2_rw_path_occ (const: @(LmP0Node node); const: @(LmP0Text t); size_t: i; int: mi; int: say; @: int path) int
    size_t: b
    size_t: occ 0U
    int: po
    int: ixed 0
    b: i + 1U
    if: b < t\length && t\data[b] = 91
        ixed: 1
        b: b + 1U
        while: b < t\length && t\data[b] >= 48 && t\data[b] <= 57
            occ: occ * 10U + (cast: (size_t) (t\data[b] - 48))
            b: b + 1U
        ---
        if: b >= t\length || t\data[b] != 93 || occ > 1000U
            if: say != 0
                l2_rw_refuse(node, "a field path")
            return: 1
        b: b + 1U
    ---
    i: b
    while: i < t\length && t\data[i] != 92
        i: i + 1U
    ---
    if: i = b || i != t\length
        if: say != 0
            l2_rw_refuse(node, "a field path")
        return: 1
    # `M\x` inside M itself: the occurrence is not this activation's data (a re-entry's is fresh),
    # so it is not built (-193 T4a).
    if: mi = l2_rw_mi
        if: say != 0
            l2_rw_refuse(node, "a field path")
        return: 1
    l2_rw_seg\data: t\data + b
    l2_rw_seg\length: i - b
    po: l2_own_find_last(mi, l2_rw_seg)
    if: ixed != 0
        po: l2_own_find_occ(mi, l2_rw_seg, (cast: (int) occ))
    if: po < 0 || l2_m_uses[l2_own_off(mi, po)] = 0
        if: say != 0
            l2_error(l2_src, node, "unresolved name")
        return: 1
    if: l2_own_host[po] != 0 || l2_rw_num_ty(l2_own_ty[po]) = 0
        if: say != 0
            l2_rw_refuse(node, "a field path")
        return: 1
    path[0]: 3
    path[1]: mi
    path[2]: 1
    path[3]: l2_own_ty[po]
    path[4]: 0 - 1
    path[5]: 0
    path[6]: l2_own_mslot(po)
    path[7]: 0
return: 0

# A path at the walked root, `a\b...` (FABLE-OPUS-ROOT-STRUCTS-20260925-178 commit 2), resolved
# through the named Structures' field table (l2_ns_slot_named) into `path`:
#   [0] 1: its root is a root own field of a Structure type -- a reference, whose Structure is
#       DEREF(AT(unit, its cell)); 2: a named Structure of the unit, which the builder makes before
#       the steps; 3: a method, whose occurrence is the root and whose own field (`M\x`, or the
#       occurrence `M\[N]x`) is the one name after it (-196); 4: a qualified (eternal) branch, read
#       only (-196); 5: a merge result (-193 T3), the unit child its merge statement writes, whose
#       fields are the result-slot map's (l2_mrs_slot_named) -- a Structure that exists only in R0's
#       turn, so the way to it is a value, as through a reference ([5] 1); 6: a Structure formal of
#       the method being built (T4b class 1: `T: m` and `@: T m`) -- [1] is the formal index, and
#       the value is the reference the caller passed (ARG), not a cell; [1] that own field, that
#       named Structure or branch, that method, that merge result, or that formal;
#   [2] the count of names after the root; [3] the last field's number type (own storage code), or
#       -1 when it is not a number; [4] the Structure that holds the last field; [5] 1 when the way
#       goes through a reference (the root, or a reference field, kind 3);
#   [6 + 2i], [7 + 2i] the slot and the kind of name i + 1.
# Each name but the last is an inline nested Structure (kind 2) or a reference field (kind 3); the
# last is a number field -- size_t, char, int, unsigned, ulong (kinds 0, 1, 7, 8, 9) -- or not.  0,
# or 1 with the refusal made when `say` (the typing pass asks silently).
fn: l2_rw_path (const: @(LmP0Node node); const: @(LmP0Text t); int: say; @: int path) int
    size_t: i 0U
    size_t: b
    int: oi
    int: ni
    int: n 0
    int: slot
    int: kind 0
    int: ent 0
    int: last
    int: res 0 - 1
    int: fi 0 - 1
    int: rooted 0
    if: t = 0 || t\data = 0 || path = 0
        return: 1
    while: i < t\length && t\data[i] != 92
        i: i + 1U
    ---
    if: l2_rw_seg = 0
        l2_rw_seg: (cast: (@: LmP0Text) calloc(1U, c.sizeof(c.LmP0Text)))
        if: l2_rw_seg = 0
            return: 1
        ---
    ---
    l2_rw_seg\data: t\data
    l2_rw_seg\length: i
    path[5]: 0
    if: l2_rw_mi != l2_e
        fi: l2_formal_find(l2_rw_mi, l2_rw_seg)
    oi: l2_rw_find(l2_rw_seg)
    if: l2_rw_seen(oi) != 0 && l2_own_host[oi] = 0 && l2_own_fid[oi] < 0 && l2_own_uchild[oi] >= 0 && l2_own_nsty_get(oi) >= 0
        path[0]: 1
        path[1]: oi
        ni: l2_own_nsty_get(oi)
        path[5]: 1
        rooted: 1
    # T4b class 1. A Structure formal hides an own field of the same name (l2_rw_find already
    # returned -1) and a unit Structure of the same spelling. The reference is the caller's.
    if: rooted = 0 && fi >= 0 && l2_nsty_get(l2_rw_mi, fi) >= 0
        path[0]: 6
        path[1]: fi
        ni: l2_nsty_get(l2_rw_mi, fi)
        path[4]: 0 - 1
        path[5]: 1
        rooted: 1
    if: rooted = 0
        ni: l2_ns_find(l2_rw_seg)
        if: ni < 0 && l2_find_method(l2_rw_seg) >= 0 && l2_find_method(l2_rw_seg) != l2_e
            return: l2_rw_path_occ(node, t, i, l2_find_method(l2_rw_seg), say, path)
        if: ni < 0
            res: l2_mres_find(l2_rw_seg)
        if: res >= 0
            path[0]: 5
            path[1]: res
            path[4]: 0 - 1
            path[5]: 1
        if: res < 0 && (ni < 0 || l2_ns_parent[ni] >= 0)
            if: say != 0
                l2_rw_refuse(node, "a field path")
            return: 1
        if: res < 0
            path[0]: 2
            if: l2_ns_eternal[ni] >= 0
                path[0]: 4
            path[1]: ni
        ---
    ---
    while: i < t\length
        # i stands on a backslash: the next name runs to the next one.
        i: i + 1U
        b: i
        while: i < t\length && t\data[i] != 92
            i: i + 1U
        ---
        if: n >= 12 || i = b || t\data[b] = 91
            if: say != 0
                l2_rw_refuse(node, "a field path")
            return: 1
        if: n = 0 && res >= 0
            slot: l2_mrs_slot_named(res, t\data, b, i - b, @ kind, @ ent)
        else:
            slot: l2_ns_slot_named(ni, t\data, b, i - b, @ kind, @ ent)
        ---
        last: (cast: (int) (i >= t\length))
        if: slot < 0 || (last = 0 && kind != 2 && kind != 3)
            if: say != 0
                l2_rw_refuse(node, "a field path")
            return: 1
        path[6 + 2 * n]: slot
        path[7 + 2 * n]: kind
        if: n > 0 || res < 0
            path[4]: ni
        n: n + 1
        if: last = 0
            if: kind = 3
                path[5]: 1
            ni: ent
        ---
    ---
    if: n = 0
        if: say != 0
            l2_rw_refuse(node, "a field path")
        return: 1
    path[2]: n
    path[3]: 0 - 1
    if: kind = 0
        path[3]: 2
    if: kind = 1
        path[3]: 1
    if: kind = 7
        path[3]: 0
    if: kind = 8
        path[3]: 3
    if: kind = 9
        path[3]: 36
return: 0

# The value of a resolved path at `level` (0 its root, path[2] its last name), a node under
# container `parent`: the Structure reached so far, or the last field's cell.  A reference is
# opened by DEREF (-174 c1): the root when it is an own field, and a reference field (kind 3) when
# the way goes on through it.  A named Structure root is AT(unit, its unit child).
fn: l2_rw_path_value (@: int path; int: level; int: parent; @: int out) int
    int: node
    int: raw
    int: base
    int: kind
    int: uslot
    # An own Structure root is its slot (-189 c3b-3): AT reads the Structure the slot holds.
    if: level = 0 && path[0] = 1 && l2_own_is_slot(path[1]) != 0
        return: l2_rw_own(parent, path[1], out)
    if: level = 0 && path[0] = 1
        if: l2_rw_frame(parent, "LMX_WALK_OP_DEREF", 2, out) != 0 || l2_rw_own(\out, path[1], @ raw) != 0
            return: 1
        return: l2_rw_put(\out, 1, raw)
    ---
    # A Structure formal is already the Structure the caller passed (ARG), not a cell to open.
    if: level = 0 && path[0] = 6
        return: l2_rw_arg(parent, path[1], out)
    # A named Structure, a method's occurrence (-196) or a qualified branch (-196) is a unit child:
    # AT(unit, its child).
    if: level = 0
        # path[1] is a named Structure's number only for a named Structure: a method's (3) is not
        # one, and ranking it among the named Structures read past them.
        if: path[0] = 3
            uslot: l2_unit_base + path[1]
        else:
            if: path[0] = 4
                uslot: l2_unit_base + l2_occ_n() + l2_ns_eternal[path[1]]
            else:
                if: path[0] = 5
                    uslot: l2_mres_base + path[1]
                else:
                    uslot: l2_ns_base + l2_ns_rank(path[1])
                ---
            ---
        ---
        if: l2_rw_frame(parent, "LMX_WALK_OP_AT", 3, out) != 0
            return: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_entry_unit)) != 0 || lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %dU) != c.LMX_WALK_OK\n            return: 1\n", \out, \out, uslot) < 0
            return: 1
        return: 0
    ---
    kind: path[7 + 2 * (level - 1)]
    node: parent
    if: kind = 3 && level < path[2]
        if: l2_rw_frame(parent, "LMX_WALK_OP_DEREF", 2, out) != 0
            return: 1
        node: \out
    ---
    if: l2_rw_frame(node, "LMX_WALK_OP_OF", 3, @ raw) != 0 || l2_rw_path_value(path, level - 1, raw, @ base) != 0 || l2_rw_put(raw, 1, base) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %dU) != c.LMX_WALK_OK\n            return: 1\n", raw, path[6 + 2 * (level - 1)]) < 0
        return: 1
    if: node != parent
        return: l2_rw_put(node, 1, raw)
    \out: raw
return: 0

# A path read `a\b...` as an operand: the last field's cell (OF over the way to it).
fn: l2_rw_path_read (const: @(LmP0Node node); const: @(LmP0Text t); int: parent; @: int out) int
    c.array: [40]: int path
    if: l2_rw_path(node, t, 1, path) != 0
        return: 1
    if: path[3] < 0
        return: l2_rw_refuse(node, "a Structure value")
return: l2_rw_path_value(path, path[2], parent, out)

# A path write `a\b...: v` into a number field.
# - A way fixed when the graph is built -- a named Structure and its inline nested ones, whose nodes
#   the builder has made (l2_nsp) -- is PUT with that holder.
# - Through a reference the holder exists only in R0's turn, so it is PUT_OF (-177 c4, D-54): its
#   holder is evaluated -- the way to the Structure holding the last field (l2_rw_path_value one
#   level up), DEREF opening each reference (-183).
# A whole Structure assigned through a path stays fail-closed (the ruling pinned by
# unit_*_struct_rebind_refused).
fn: l2_rw_path_write (const: @(LmP0Node stmt); const: @(LmP0Text t); @: LmP0Field value; int: n; int: into; @: int out) int
    c.array: [40]: int path
    int: v
    int: h
    int: kind
    if: l2_rw_path(stmt, t, 1, path) != 0
        return: 1
    if: path[3] < 0
        kind: path[7 + 2 * (path[2] - 1)]
        if: kind = 2 || kind = 3
            return: l2_rw_refuse(stmt, "a Structure assigned through a path")
        return: l2_rw_refuse(stmt, "a field path")
    ---
    if: n < 1
        return: l2_rw_refuse(stmt, "this assignment")
    if: path[0] = 4
        return: l2_error(l2_src, stmt, "a qualified immutable branch is not written")
    if: path[0] = 3
        if: l2_rw_frame(into, "LMX_WALK_OP_PUT", 4, out) != 0
            return: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) lmx_arena_ref_struct(l2_entry_unit, %uU))) != 0 || lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %dU) != c.LMX_WALK_OK\n            return: 1\n", \out, (cast: (unsigned) (l2_unit_base + path[1])), \out, path[6]) < 0
            return: 1
        if: l2_rw_texpr(value, n, path[3], \out, @ v) != 0
            return: 1
        return: l2_rw_put(\out, 3, v)
    ---
    if: path[5] != 0
        if: l2_rw_frame(into, "LMX_WALK_OP_PUT_OF", 4, out) != 0 || l2_rw_path_value(path, path[2] - 1, \out, @ h) != 0 || l2_rw_put(\out, 1, h) != 0
            return: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %dU) != c.LMX_WALK_OK\n            return: 1\n", \out, path[6 + 2 * (path[2] - 1)]) < 0
            return: 1
        if: l2_rw_texpr(value, n, path[3], \out, @ v) != 0
            return: 1
        return: l2_rw_put(\out, 3, v)
    ---
    if: l2_rw_frame(into, "LMX_WALK_OP_PUT", 4, out) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_nsp[%d])) != 0 || lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %dU) != c.LMX_WALK_OK\n            return: 1\n", \out, path[4], \out, path[6 + 2 * (path[2] - 1)]) < 0
        return: 1
    if: l2_rw_texpr(value, n, path[3], \out, @ v) != 0
        return: 1
return: l2_rw_put(\out, 3, v)

# An admission at the walked root (FABLE-OPUS-ROOT-STRUCTS-20260925-178 commit 3; the 2026-09-23
# rule B2: binding an untyped graph to a typed place admits it at the binding point, and a refusal
# is the implicit throw `implements`).  One registered kernel primitive (Grok -180):
#   PRIM [prim, record, value, model]
# - record: fn lmx_walk_admit, or lmx_walk_admit_letter when the value is a letter, whose payload
#   (slot 1) is what the user's model describes (the mail design); owner the program's arena.
# - value: a node the caller builds next, into slot 2: a take, or AT of a reference field.  A null
#   value passes unadmitted, as natively (l2_emit_admit: `value != 0 && ...`).
# - model: the named Structure T itself (l2_nsp).
# Its out is the admitted value (what a letter gives is q25's answer).  A refusal is
# LMX_PRIMITIVE_THROW_IMPLEMENTS, which the walk carries as the caller's implicit throw
# (-177 c5: THROWN + 2 at the root).
fn: l2_rw_admit (int: parent; int: ni; int: letter; @: int out) int
    const: @(char rec) "lmx_walk_admit"
    if: letter != 0
        rec: "lmx_walk_admit_letter"
    ---
    if: l2_rw_frame(parent, "LMX_WALK_OP_PRIM", 5, out) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        @: LmxPrimitive l2_rwp%d (cast: (@: LmxPrimitive) lmx_arena_take(l2_program_arena, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))\n        if: l2_rwp%d = 0\n            return: 1\n        l2_rwp%d\\fn: %s\n        l2_rwp%d\\signature: 0\n        l2_rwp%d\\owner: (cast: (@: Lmx) l2_program_arena)\n        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_rwp%d)) != 0 || lmx_arena_ref_store(l2_rw%d, 4U, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n", \out, \out, \out, rec, \out, \out, \out, \out, \out, ni) < 0
        return: 1
return: l2_rw_catch_fixed(\out, 2, "implements")

# `f()` / `S()` when that name already binds an ordinary Structure (l2_empty_struct_assign_shape;
# the book §12): a fresh empty Structure, admitted to the declared type, stored only when admission
# passes.  A refusal is the implicit throw `implements` (l2_rw_admit), so the previous binding
# stays.  Shape 1 stores the own field.  Shape 2 stores the named Structure's unit child, the
# same slot a path read of `S\v` names.  The fresh node is the walker's FRESH of an empty
# Structure, one per execution, not one node built with the graph.
fn: l2_rw_empty_assign (const: @(LmP0Node stmt); int: into; @: int out) int
    @: LmP0Text h
    int: easn
    int: oi
    int: ni
    int: adm
    int: fr
    int: proto
    easn: l2_empty_struct_assign_shape(stmt, l2_rw_mi)
    h: stmt\as\frame\head
    if: easn = 2
        ni: l2_ns_find(h)
        if: ni < 0 || l2_rw_mi != l2_e
            return: l2_rw_refuse(stmt, "an admission to a Structure type")
        if: l2_rw_frame(into, "LMX_WALK_OP_PUT_REF", 4, out) != 0
            return: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %uU) != c.LMX_WALK_OK\n            return: 1\n", \out, (cast: (unsigned) (l2_ns_base + l2_ns_rank(ni)))) < 0
            return: 1
    ---
    if: easn = 1
        oi: l2_own_find_last(l2_rw_mi, h)
        ni: l2_graph_nsty(l2_rw_mi, h)
        if: l2_rw_seen(oi) = 0 || l2_own_host[oi] != 0 || l2_own_fid[oi] >= 0 || l2_own_uchild[oi] < 0
            return: l2_rw_refuse(stmt, "a reference assignment")
        if: l2_rw_frame(into, l2_rw_bind_op(oi), 4, out) != 0 || l2_rw_cell(\out, oi) != 0
            return: 1
        # No declared type (E(), m()): the value is the fresh empty node. Admission is the
        # typed store below, not this one.
        if: ni < 0
            if: l2_rw_frame(\out, "LMX_WALK_OP_FRESH", 2, @ fr) != 0 || l2_rw_plain(fr, 0, @ proto) != 0 || l2_rw_put(fr, 1, proto) != 0
                return: 1
            return: l2_rw_put(\out, 3, fr)
        ---
    ---
    if: easn != 1 && easn != 2
        return: l2_rw_refuse(stmt, "an admission to a Structure type")
    if: l2_rw_admit(\out, ni, 0, @ adm) != 0
        return: 1
    if: l2_rw_frame(adm, "LMX_WALK_OP_FRESH", 2, @ fr) != 0 || l2_rw_plain(fr, 0, @ proto) != 0 || l2_rw_put(fr, 1, proto) != 0
        return: 1
    if: l2_rw_put(adm, 3, fr) != 0
        return: 1
return: l2_rw_put(\out, 3, adm)

# `m: raw` at the walked root, m of a declared Structure type T and raw an untyped reference field
# (a letter, or another untyped graph): raw is admitted to T at this binding point, a refusal the
# implicit throw `implements` (-178 commit 3): PUT(m, admit(AT(raw), T)), admit_letter for a
# letter.  Another typed field, or anything but a field's name, is not built here.
fn: l2_rw_admit_assign (const: @(LmP0Node stmt); int: oi; int: into; @: int out) int
    @: LmP0Field f
    int: src
    int: adm
    int: raw
    if: stmt\as\frame\body = 0 || l2_count_active(stmt\as\frame\body) != 1
        return: l2_rw_refuse(stmt, "an admission to a Structure type")
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
        return: l2_rw_refuse(stmt, "an admission to a Structure type")
    src: l2_rw_find(f\value\as\atom)
    if: l2_rw_seen(src) = 0 || l2_own_host[src] != 0 || l2_own_fid[src] >= 0 || l2_own_uchild[src] < 0 || l2_own_is_pointer(l2_own_ty[src]) = 0 || l2_own_nsty_get(src) >= 0
        return: l2_rw_refuse(stmt, "an admission to a Structure type")
    if: l2_rw_frame(into, l2_rw_bind_op(oi), 4, out) != 0 || l2_rw_cell(\out, oi) != 0 || l2_rw_admit(\out, l2_own_nsty_get(oi), l2_rw_is_letter(src), @ adm) != 0
        return: 1
    if: l2_rw_own(adm, src, @ raw) != 0 || l2_rw_put(adm, 3, raw) != 0
        return: 1
return: l2_rw_put(\out, 3, adm)

# Is the root own field oi a letter -- declared by `receiveMessage: oi`?
fn: l2_rw_is_letter (int: oi) int
    @: LmP0Text name 0
    if: oi < 0 || l2_own_decl[oi] = 0
        return: 0
return: (cast: (int) (l2_receive_msg_shape(l2_own_decl[oi], @ name, 0) = 0))

# `receiveMessage: m` at the walked root (FABLE-OPUS-ROOT-TAKE-20260925-179; Grok -177 c1): the
# current Thread's next letter, taken by the walker's one kernel take primitive (a PRIM
# [prim, record] whose record's fn is lmx_walk_mail_take: the letter's graph through `out`, or no
# value when the inbox is empty), stored by reference into m's pointer cell -- null for no letter
# (a PUT into a pointer cell admits it).  m of a declared Structure type admits the letter first:
# that is an admission (the caller's implicit `implements`, D-55), not this take.
fn: l2_rw_take (const: @(LmP0Node stmt); int: into; @: int out) int
    @: LmP0Text cname 0
    @: LmP0Text cmodel 0
    int: oi
    int: prim
    int: ni
    int: adm
    int: holder
    int: slotv 3
    if: l2_receive_msg_shape(stmt, @ cname, @ cmodel) != 0 || cname = 0
        return: l2_rw_refuse(stmt, "this receiveMessage")
    # `receiveMessage: m Model` (-172 c2, the two-name form) at the walked root is the receive-if
    # admission (-178 c3), not this take.
    if: cmodel != 0
        return: l2_rw_refuse(stmt, "an admission to a Structure type")
    oi: l2_rw_find(cname)
    if: l2_rw_seen(oi) = 0
        return: l2_rw_refuse(stmt, "this receiveMessage")
    if: l2_own_host[oi] != 0 || l2_own_fid[oi] >= 0 || l2_own_uchild[oi] < 0
        return: l2_rw_refuse(stmt, "a field declared in a nested body")
    if: l2_own_is_pointer(l2_own_ty[oi]) = 0
        return: l2_rw_refuse(stmt, "this receiveMessage")
    if: l2_rw_frame(into, l2_rw_bind_op(oi), 4, out) != 0 || l2_rw_cell(\out, oi) != 0
        return: 1
    holder: \out
    # m of a declared Structure type T takes the NEXT letter and admits it to T -- its payload, the
    # user's model describes the payload -- a refusal being the implicit throw `implements`
    # (-178 commit 3; the pre-typed form, not the selective `receiveMessage: m T`):
    # PUT(m, admit_letter(take, T)).
    ni: l2_own_nsty_get(oi)
    if: ni >= 0
        if: l2_rw_admit(holder, ni, 1, @ adm) != 0 || l2_rw_put(holder, 3, adm) != 0
            return: 1
        holder: adm
        slotv: 3
    ---
    if: l2_rw_frame(holder, "LMX_WALK_OP_PRIM", 3, @ prim) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        @: LmxPrimitive l2_rwp%d (cast: (@: LmxPrimitive) lmx_arena_take(l2_program_arena, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))\n        if: l2_rwp%d = 0\n            return: 1\n        l2_rwp%d\\fn: lmx_walk_mail_take\n        l2_rwp%d\\signature: 0\n        l2_rwp%d\\owner: l2_entry_unit\n        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_rwp%d)) != 0\n            return: 1\n", prim, prim, prim, prim, prim, prim, prim) < 0
        return: 1
return: l2_rw_put(holder, slotv, prim)

# `Model: m` at the walked root: m, a root own field of the named Structure type Model, takes a
# fresh merge of Model (merge(Model, empty), the contextual `left: right` rule), made in R0's turn
# by the walker's one kernel merge primitive (-174 c3: a PRIM whose record's fn is
# lmx_walk_merge_model, its owner the program's arena, its input the model) and stored by reference
# into m's pointer cell (PUT, -174 c2).
fn: l2_rw_model (const: @(LmP0Node stmt); const: @(LmP0Text h); int: into; @: int out) int
    @: LmP0Field f
    int: ni l2_ns_find(h)
    int: oi 0
    int: prim
    # `S()` / `S: ()` assigns the empty Structure to the named Structure itself, admitted to its
    # own type (the book §12; l2_empty_struct_assign_shape = 2).  A body that is not that shape
    # stays refused.
    if: stmt\as\frame\body = 0 || l2_count_active(stmt\as\frame\body) = 0
        if: l2_empty_struct_assign_shape(stmt, l2_rw_mi) = 2
            return: l2_rw_empty_assign(stmt, into, out)
        return: l2_rw_refuse(stmt, "an admission to a Structure type")
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_next_active(f\next) != 0
        return: l2_rw_refuse(stmt, "this declaration")
    while: oi < l2_own_n && (l2_own_decl[oi] != stmt || l2_own_mi[oi] != l2_rw_mi)
        oi: oi + 1
    ---
    if: oi >= l2_own_n
        return: l2_rw_refuse(stmt, "this declaration")
    if: l2_own_host[oi] != 0 || l2_own_fid[oi] >= 0 || l2_own_uchild[oi] < 0
        return: l2_rw_refuse(stmt, "a field declared in a nested body")
    if: ni < 0 || l2_own_nsty_get(oi) != ni || l2_ns_parent[ni] >= 0 || l2_ns_eternal[ni] >= 0
        return: l2_rw_refuse(stmt, "a Structure-typed field")
    if: l2_rw_frame(into, l2_rw_bind_op(oi), 4, out) != 0 || l2_rw_cell(\out, oi) != 0 || l2_rw_frame(\out, "LMX_WALK_OP_PRIM", 4, @ prim) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        @: LmxPrimitive l2_rwp%d (cast: (@: LmxPrimitive) lmx_arena_take(l2_program_arena, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))\n        if: l2_rwp%d = 0\n            return: 1\n        l2_rwp%d\\fn: lmx_walk_merge_model\n        l2_rwp%d\\signature: 0\n        l2_rwp%d\\owner: (cast: (@: Lmx) l2_program_arena)\n        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_rwp%d)) != 0 || lmx_arena_ref_store(l2_rw%d, 3U, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n", prim, prim, prim, prim, prim, prim, prim, prim, ni) < 0
        return: 1
return: l2_rw_put(\out, 3, prim)

# `R: merge: A B ... [body]` at the walked root (-193 T3, over Sonnet's K2): the result slot of the
# unit, l2_mres_base + res, takes the result of the walker's merge primitive by reference,
# PUT_REF(0, slot, PRIM) -- holder 0, the root's own data, (R0, R0).  The PRIM is
# [prim, record(lmx_walk_merge_map), op0 .. opN-1, body | 0, pairs | 0]:
# - an operand is the Structure itself where the graph build made it (a named Structure, a qualified
#   branch -- retained by its profile, -202), and the result slot of an earlier merge otherwise, read
#   when the step runs (AT);
# - the body is a plain Structure of the declared fields' cells, made once with the graph, which the
#   merge copies as it copies an operand;
# - the pairs are l2_mrs_build's own map, one plain Structure of 3·P size cells (model_slot,
#   operand, field), made once with the graph; operand n is the body (T2).
# The widths and values the native emission checks (71-91) are the map's; a merge the kernel
# refuses is the implicit throw `merge` (THROWN + 1 at the walked root).
fn: l2_rw_merge (const: @(LmP0Node stmt); int: res; int: into; @: int out) int
    @: LmP0Node mf l2_merge_frame(stmt)
    @: LmP0Structure bd l2_merge_body(stmt)
    @: LmP0Field last
    @: LmP0Field bf
    @: LmP0Field lit
    int: n l2_merge_arity(mf)
    int: bn 0
    int: np 0
    int: prim
    int: node
    int: k 0
    int: oi
    int: ni
    int: sl
    int: q 0
    if: n < 1
        return: l2_error(l2_src, stmt, "merge needs at least one operand")
    if: bd != 0
        bn: l2_count_active(bd)
    if: bd != 0 && bn = 0
        return: l2_error(l2_src, stmt, "an empty merge result body is not a field list")
    while: q < l2_msrc_n
        if: l2_msrc_res[q] = res && l2_msrc_pair[q] != 0
            np: np + 1
        q: q + 1
    ---
    if: l2_rw_frame(into, "LMX_WALK_OP_PUT_REF", 4, out) != 0 || l2_rw_frame(\out, "LMX_WALK_OP_PRIM", n + 5, @ prim) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %uU) != c.LMX_WALK_OK\n            return: 1\n        @: LmxPrimitive l2_rwp%d (cast: (@: LmxPrimitive) lmx_arena_take(l2_program_arena, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))\n        if: l2_rwp%d = 0\n            return: 1\n        l2_rwp%d\\fn: lmx_walk_merge_map\n        l2_rwp%d\\signature: 0\n        l2_rwp%d\\owner: (cast: (@: Lmx) l2_program_arena)\n        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_rwp%d)) != 0\n            return: 1\n", \out, (cast: (unsigned) (l2_mres_base + res)), prim, prim, prim, prim, prim, prim, prim) < 0
        return: 1
    if: l2_rw_catch_fixed(prim, 1, "merge") != 0
        return: 1
    last: l2_next_active(mf\as\frame\body\first_field)
    while: k < n
        oi: l2_ebr_find(last\value\as\atom)
        ni: l2_ns_find(last\value\as\atom)
        if: ni >= 0 && (l2_ns_parent[ni] >= 0 || l2_ns_eternal[ni] >= 0)
            ni: 0 - 1
        sl: l2_mres_find(last\value\as\atom)
        if: oi < 0 && sl < 0 && ni < 0
            return: l2_error(l2_src, stmt, "unknown merge operand")
        # A qualified branch is the Structure itself; the primitive retains it by its exact physical
        # profile (-202 K2b: lmx_range_profile of each operand, as the native merge passes them).
        if: oi >= 0 && l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, %dU, (cast: (@: void) lmx_arena_ref_struct(l2_entry_unit, %uU))) != 0\n            return: 1\n", prim, k + 3, (cast: (unsigned) (l2_unit_base + l2_occ_n() + oi))) < 0
            return: 1
        if: oi < 0 && sl >= 0
            if: l2_rw_frame(prim, "LMX_WALK_OP_AT", 3, @ node) != 0 || l2_rw_put(prim, k + 3, node) != 0
                return: 1
            if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %uU) != c.LMX_WALK_OK\n            return: 1\n", node, (cast: (unsigned) (l2_mres_base + sl))) < 0
                return: 1
        ---
        if: oi < 0 && sl < 0 && l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, %dU, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n", prim, k + 3, ni) < 0
            return: 1
        last: l2_next_active(last\next)
        k: k + 1
    ---
    if: bd != 0
        if: l2_rw_plain(prim, bn, @ node) != 0 || l2_rw_put(prim, n + 3, node) != 0
            return: 1
        bf: l2_next_active(bd\first_field)
        k: 0
        while: bf != 0
            if: l2_frame_head(bf\value, "size_t") = 0 || l2_count_active(bf\value\as\frame\body) != 2
                return: l2_error(l2_src, stmt, "unsupported merge result body field")
            lit: l2_next_active(l2_next_active(bf\value\as\frame\body\first_field)\next)
            if: lit\value = 0 || lit\value\kind != c.LM_P0_NODE_ATOM || l2_num(lit\value\as\atom) = 0
                return: l2_error(l2_src, stmt, "a merge result body field needs a literal")
            if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %zuU) != c.LMX_WALK_OK\n            return: 1\n", node, k, l2_literal_value(lit\value\as\atom)) < 0
                return: 1
            bf: l2_next_active(bf\next)
            k: k + 1
        ---
    ---
    if: np > 0
        if: l2_rw_plain(prim, 3 * np, @ node) != 0 || l2_rw_put(prim, n + 4, node) != 0
            return: 1
        q: 0
        k: 0
        while: q < l2_msrc_n
            if: l2_msrc_res[q] = res && l2_msrc_pair[q] != 0 && l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %dU) != c.LMX_WALK_OK || lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %dU) != c.LMX_WALK_OK || lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %dU) != c.LMX_WALK_OK\n            return: 1\n", node, 3 * k, l2_msrc_slot[q], node, 3 * k + 1, l2_msrc_op[q], node, 3 * k + 2, l2_msrc_fld[q]) < 0
                return: 1
            if: l2_msrc_res[q] = res && l2_msrc_pair[q] != 0
                k: k + 1
            q: q + 1
        ---
    ---
return: l2_rw_put(\out, 3, prim)

# The root's own int field oi is a field of the unit, and a unit field's cell is shared with every
# method that can see it: a callee's write is what the activation sees.  So the walked root holds
# no working copy of it: it is read (`at`) and assigned (`put`) in the unit, at the unit's child
# l2_own_uchild[oi].  Node `node`'s slots 1 and 2 name that cell.
# The body being built names its OWN fields by no holder (-193 T4a; Sonnet's K-OT2): holder 0 is
# «this activation's data» -- the root's is the unit, (R0, R0); a method's is its occurrence on an
# ordinary call, a fresh instance on a re-entry, a merge result's own slots when its frames are a
# model's -- and the slot is the field's own child (l2_own_mslot).  A unit field a method sees is
# named by its holder, the unit.
fn: l2_rw_cell (int: node; int: oi) int
    if: l2_rw_emit = 0
        return: 0
    # A catch parameter lives in its catch frame's Structure, which entry built as l2_b.
    if: l2_own_fid[oi] >= 0 && l2_own_host[oi] != 0 && l2_frame_head(l2_own_host[oi], "catch") != 0
        return: (cast: (int) (c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_b%d)) != 0 || lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %uU) != c.LMX_WALK_OK\n            return: 1\n", node, l2_own_fid[oi], node, (cast: (unsigned) l2_own_fchild[oi])) < 0))
    if: l2_own_mi[oi] = l2_rw_mi
        return: (cast: (int) (c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %uU) != c.LMX_WALK_OK\n            return: 1\n", node, (cast: (unsigned) l2_own_uchild[oi])) < 0))
return: (cast: (int) (c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_entry_unit)) != 0 || lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %uU) != c.LMX_WALK_OK\n            return: 1\n", node, node, (cast: (unsigned) l2_own_uchild[oi])) < 0))

# The walker op that binds the root's own field oi (-189 c3b-3; grok_bot -186): an own Structure
# field's slot takes the Structure itself, [put_ref, holder, slot, value]; any other field is a cell,
# [put, holder, slot, value].
fn: l2_rw_bind_op (int: oi) const: @: char
    if: l2_own_is_slot(oi) != 0
        return: "LMX_WALK_OP_PUT_REF"
return: "LMX_WALK_OP_PUT"

# A read of the root's own int field oi.
# ARRAYS IN THE BODY BEING BUILT (-170, over grok_bot's ELEM / ELEMPUT roles): an element `x[i]` of
# an own Array x of the body -- the Array's descriptor in the own field's slot, [op, holder, slot]
# as AT has it (l2_rw_cell), the literal index next -- for the element types the roles take: int,
# char, size_t, ulong (own storage 4, 5, 7, 37).  x's row, or -1 when t is not such an element; the
# index goes to `index`.
fn: l2_rw_elem_of (const: @(LmP0Text t); @: size_t index) int
    int: oi 0 - 1
    if: t = 0 || l2_own_index_head(t, l2_rw_mi, @ oi, index) != 0 || oi < 0
        return: 0 - 1
    if: l2_rw_seen(oi) = 0 || l2_own_host[oi] != 0 || l2_own_fid[oi] >= 0 || l2_own_uchild[oi] < 0 || l2_rw_elem_ty(oi) < 0
        return: 0 - 1
return: oi

# The element's number type (own storage code) of own Array oi, or -1.
fn: l2_rw_elem_ty (int: oi) int
    if: l2_own_ty[oi] = 4
        return: 0
    if: l2_own_ty[oi] = 5
        return: 1
    if: l2_own_ty[oi] = 7
        return: 2
    if: l2_own_ty[oi] = 37
        return: 36
return: 0 - 1

# Element type of `path[i]` (kind 5) or `path[i][j]` (kind 6): the field's element
# code, 0 int or 1 char. An array value itself (one index of kind 6) is not a number.
fn: l2_rw_index_ty (const: @(LmP0Node node); const: @(LmP0Text t)) int
    size_t: cut 0U
    size_t: b
    size_t: nidx 0U
    int: kind 0
    int: ent 0
    int: slot
    int: ni
    c.array: [40]: int path
    @: LmP0Text prefix
    if: t = 0
        return: 0 - 1
    while: cut < t\length && t\data[cut] != 91
        cut: cut + 1U
    ---
    if: cut = 0U || cut >= t\length
        return: 0 - 1
    prefix: (cast: (@: LmP0Text) calloc(1U, c.sizeof(c.LmP0Text)))
    if: prefix = 0
        return: 0 - 1
    prefix\data: t\data
    prefix\length: cut
    if: l2_rw_path(node, prefix, 0, path) != 0 || path[2] < 1
        free((cast: (@: void) prefix))
        return: 0 - 1
    free((cast: (@: void) prefix))
    b: cut
    while: b < t\length
        if: t\data[b] = 91
            nidx: nidx + 1U
        b: b + 1U
    ---
    b: cut
    while: b > 0U && t\data[b - 1U] != 92
        b: b - 1U
    ---
    ni: path[4]
    if: ni < 0
        return: 0 - 1
    slot: l2_ns_slot_named(ni, t\data, b, cut - b, @ kind, @ ent)
    if: slot < 0
        return: 0 - 1
    if: kind = 5 && nidx = 1U
        return: ent
    if: kind = 6 && nidx = 2U
        return: ent
return: 0 - 1

# One `[digits]` at `at`. 0 = taken, `at` stands after the `]`.
fn: l2_rw_take_index (const: @(LmP0Text t); @: size_t at; @: size_t out_v) int
    size_t: i
    size_t: v 0U
    size_t: digit
    i: \at
    if: t = 0 || i >= t\length || t\data[i] != 91
        return: 1
    i: i + 1U
    if: i >= t\length || t\data[i] < 48 || t\data[i] > 57
        return: 1
    while: i < t\length && t\data[i] >= 48 && t\data[i] <= 57
        digit: (cast: (size_t) (t\data[i] - 48))
        if: v > (((cast: (size_t) -1) - digit) / 10U)
            return: 1
        v: v * 10U + digit
        i: i + 1U
    ---
    if: i >= t\length || t\data[i] != 93
        return: 1
    \out_v: v
    \at: i + 1U
return: 0

# `path[i]` or `path[i][j]`: ELEM over the path's array field. Two indices nest.
fn: l2_rw_indexed_path (const: @(LmP0Node node); const: @(LmP0Text t); int: parent; @: int out) int
    size_t: cut 0U
    size_t: at
    size_t: i0 0U
    size_t: i1 0U
    int: nidx 0
    int: base
    int: inner
    c.array: [40]: int path
    @: LmP0Text prefix
    while: cut < t\length && t\data[cut] != 91
        cut: cut + 1U
    ---
    if: cut = 0U || cut >= t\length
        return: l2_rw_refuse(node, "an array")
    prefix: (cast: (@: LmP0Text) calloc(1U, c.sizeof(c.LmP0Text)))
    if: prefix = 0
        return: l2_rw_refuse(node, "an array")
    prefix\data: t\data
    prefix\length: cut
    if: l2_rw_path(node, prefix, 1, path) != 0
        free((cast: (@: void) prefix))
        return: 1
    free((cast: (@: void) prefix))
    at: cut
    if: l2_rw_take_index(t, @ at, @ i0) != 0
        return: l2_rw_refuse(node, "an array")
    nidx: 1
    if: at < t\length
        if: l2_rw_take_index(t, @ at, @ i1) != 0 || at != t\length
            return: l2_rw_refuse(node, "an array")
        nidx: 2
    ---
    if: nidx = 1
        if: l2_rw_frame(parent, "LMX_WALK_OP_ELEM", 3, out) != 0
            return: 1
        if: l2_rw_path_value(path, path[2], \out, @ base) != 0 || l2_rw_put(\out, 1, base) != 0
            return: 1
        if: l2_rw_size_index(\out, i0) != 0
            return: 1
        return: 0
    ---
    if: l2_rw_frame(parent, "LMX_WALK_OP_ELEM", 3, out) != 0
        return: 1
    if: l2_rw_frame(\out, "LMX_WALK_OP_ELEM", 3, @ inner) != 0 || l2_rw_put(\out, 1, inner) != 0
        return: 1
    if: l2_rw_path_value(path, path[2], inner, @ base) != 0 || l2_rw_put(inner, 1, base) != 0
        return: 1
    if: l2_rw_size_index(inner, i0) != 0 || l2_rw_size_index(\out, i1) != 0
        return: 1
return: 0

# length(array). Own name, length(path), or length(path[i]) of an array-of-arrays.
fn: l2_rw_length_of (const: @(LmP0Node node); int: parent; @: int out) int
    @: LmP0Field first
    @: LmP0Field g
    @: LmP0Field nm
    int: n
    int: nseen
    int: oi
    int: k
    int: arr
    int: elem
    c.array: [256]: char pd
    size_t: pn 0U
    size_t: iv 0U
    int: kind
    int: depth
    size_t: i0 0U
    c.array: [40]: int path
    @: LmP0Text prefix
    if: node = 0 || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0
        return: l2_rw_refuse(node, "an array")
    first: l2_next_active(node\as\frame\body\first_field)
    n: l2_count_active(node\as\frame\body)
    if: n = 1 && first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && first\value\as != 0 && first\value\as\atom != 0
        k: 0
        while: k < (cast: (int) first\value\as\atom\length) && first\value\as\atom\data[k] != 91
            k: k + 1
        ---
        if: k = (cast: (int) first\value\as\atom\length)
            oi: l2_rw_find(first\value\as\atom)
            if: oi >= 0 && l2_own_is_array(l2_own_ty[oi]) != 0
                if: l2_rw_frame(parent, "LMX_WALK_OP_LENGTH", 2, out) != 0 || l2_rw_own(\out, oi, @ arr) != 0 || l2_rw_put(\out, 1, arr) != 0
                    return: 1
                return: 0
            ---
        ---
    ---
    # The root's own table is l2_rw_find, not l2_path_root. Join the body into a path
    # and ask that table. Kind 5/6 is an array field; one index is its inner array.
    if: first = 0 || first\value = 0 || first\value\kind != c.LM_P0_NODE_ATOM || first\value\as = 0 || l2_ident(first\value\as\atom) = 0
        return: l2_rw_refuse(node, "an array")
    if: first\value\as\atom\length > 200U
        return: l2_rw_refuse(node, "an array")
    memcpy((cast: (@: void) pd), (cast: (@: void) first\value\as\atom\data), first\value\as\atom\length)
    pn: first\value\as\atom\length
    nseen: 1
    g: l2_next_active(first\next)
    while: g != 0 && g\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM && g\value\as != 0 && l2_is_slash(g\value\as\atom)
        nm: l2_next_active(g\next)
        if: nm = 0 || nm\value = 0 || l2_ident(nm\value\as\atom) = 0
            return: l2_rw_refuse(node, "an array")
        if: pn + 1U + nm\value\as\atom\length > 250U
            return: l2_rw_refuse(node, "an array")
        pd[pn]: 92
        memcpy((cast: (@: void) (pd + pn + 1U)), (cast: (@: void) nm\value\as\atom\data), nm\value\as\atom\length)
        pn: pn + 1U + nm\value\as\atom\length
        nseen: nseen + 2
        g: l2_next_active(nm\next)
    ---
    depth: 0
    while: g != 0 && g\value != 0 && l2_text_eq(g\value\as\atom, "[")
        nm: l2_next_active(g\next)
        if: nm = 0 || l2_dec_literal(nm\value\as\atom, @ iv) != 0
            return: l2_rw_refuse(node, "an array")
        g: l2_next_active(nm\next)
        if: g = 0 || l2_text_eq(g\value\as\atom, "]") = 0
            return: l2_rw_refuse(node, "an array")
        depth: depth + 1
        if: depth = 1
            i0: iv
        nseen: nseen + 3
        g: l2_next_active(g\next)
    ---
    if: nseen != n || g != 0
        return: l2_rw_refuse(node, "an array")
    prefix: (cast: (@: LmP0Text) calloc(1U, c.sizeof(c.LmP0Text)))
    if: prefix = 0
        return: l2_rw_refuse(node, "an array")
    prefix\data: pd
    prefix\length: pn
    if: l2_rw_path(node, prefix, 0, path) != 0 || path[2] < 1
        free((cast: (@: void) prefix))
        return: l2_rw_refuse(node, "an array")
    free((cast: (@: void) prefix))
    kind: path[7 + 2 * (path[2] - 1)]
    if: kind != 5 && kind != 6
        return: l2_rw_refuse(node, "an array")
    if: l2_rw_frame(parent, "LMX_WALK_OP_LENGTH", 2, out) != 0
        return: 1
    if: depth = 0
        if: l2_rw_path_value(path, path[2], \out, @ arr) != 0 || l2_rw_put(\out, 1, arr) != 0
            return: 1
        return: 0
    ---
    if: depth != 1
        return: l2_rw_refuse(node, "an array")
    if: l2_rw_frame(\out, "LMX_WALK_OP_ELEM", 3, @ elem) != 0 || l2_rw_put(\out, 1, elem) != 0
        return: 1
    if: l2_rw_path_value(path, path[2], elem, @ arr) != 0 || l2_rw_put(elem, 1, arr) != 0
        return: 1
    if: l2_rw_size_index(elem, i0) != 0
        return: 1
return: 0

# Child 2 of an array op is a LIT size. The walker evaluates it (D-39).
fn: l2_rw_size_index (int: elem; size_t: index) int
    int: lit
    if: l2_rw_frame(elem, "LMX_WALK_OP_LIT", 2, @ lit) != 0 || l2_rw_put(elem, 2, lit) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 1U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", lit, index) < 0
        return: 1
return: 0

# ELEM [elem, array, index]. field >= 0: the index is that size_t own field (AT).
# field < 0: index is the decimal literal.
fn: l2_rw_elem (int: parent; int: oi; int: field; size_t: index; @: int out) int
    int: at
    int: ix
    if: l2_rw_frame(parent, "LMX_WALK_OP_ELEM", 3, out) != 0
        return: 1
    if: l2_rw_frame(\out, "LMX_WALK_OP_AT", 3, @ at) != 0 || l2_rw_put(\out, 1, at) != 0 || l2_rw_cell(at, oi) != 0
        return: 1
    if: field >= 0
        if: l2_rw_own(\out, field, @ ix) != 0 || l2_rw_put(\out, 2, ix) != 0
            return: 1
        return: 0
    return: l2_rw_size_index(\out, index)

# ELEMPUT [elemput, array, index, value]: `x[i]: v`, v at the element's type.
fn: l2_rw_elemput (int: into; int: oi; int: field; size_t: index; @: LmP0Field first; int: n; @: int out) int
    int: value
    int: at
    int: ix
    if: l2_rw_frame(into, "LMX_WALK_OP_ELEMPUT", 4, out) != 0
        return: 1
    if: l2_rw_frame(\out, "LMX_WALK_OP_AT", 3, @ at) != 0 || l2_rw_put(\out, 1, at) != 0 || l2_rw_cell(at, oi) != 0
        return: 1
    if: field >= 0
        if: l2_rw_own(\out, field, @ ix) != 0 || l2_rw_put(\out, 2, ix) != 0
            return: 1
    ---
    if: field < 0 && l2_rw_size_index(\out, index) != 0
        return: 1
    if: l2_rw_texpr(first, n, l2_rw_elem_ty(oi), \out, @ value) != 0
        return: 1
return: l2_rw_put(\out, 3, value)

fn: l2_rw_own (int: parent; int: oi; @: int out) int
    if: l2_rw_is_hosted(oi) != 0 && l2_rw_mi != l2_e
        return: l2_rw_host_read(parent, oi, out)
    if: l2_rw_frame(parent, "LMX_WALK_OP_AT", 3, out) != 0
        return: 1
return: l2_rw_cell(\out, oi)

# An assignment of the root's own int field oi from the n fields at `first`, a node of `into`.
fn: l2_rw_assign (int: into; int: oi; @: LmP0Field first; int: n; @: int out) int
    int: value
    if: l2_rw_is_hosted(oi) != 0 && l2_rw_mi != l2_e
        return: l2_rw_host_put(into, oi, first, n, out)
    if: l2_rw_frame(into, "LMX_WALK_OP_PUT", 4, out) != 0 || l2_rw_cell(\out, oi) != 0 || l2_rw_texpr(first, n, l2_own_ty[oi], \out, @ value) != 0
        return: 1
return: l2_rw_put(\out, 3, value)

# Does a head spell a field path (a\b)?
fn: l2_rw_has_slash (const: @(LmP0Text t)) int
    size_t: i 0U
    if: t = 0 || t\data = 0
        return: 0
    while: i < t\length
        if: t\data[i] = 92
            return: 1
        i: i + 1U
    ---
return: 0

# The root's own numeric field named t, or -1 with the refusal made.
fn: l2_rw_own_row (const: @(LmP0Node node); const: @(LmP0Text t)) int
    int: oi l2_rw_find(t)
    if: l2_rw_seen(oi) = 0
        return: 0 - 2
    if: l2_own_host[oi] != 0
        if: l2_rw_is_hosted(oi) != 0 && l2_rw_mi != l2_e
            return: oi
        if: l2_frame_head(l2_own_host[oi], "catch") = 0 || l2_own_fid[oi] < 0 || l2_own_fchild[oi] < 0 || l2_rw_num_ty(l2_own_ty[oi]) = 0
            l2_rw_refuse(node, "a field declared in a nested body")
            return: 0 - 1
        return: oi
    if: l2_own_fid[oi] >= 0
        l2_rw_refuse(node, "a field declared in a nested body")
        return: 0 - 1
    if: l2_rw_num_ty(l2_own_ty[oi]) = 0 || l2_own_uchild[oi] < 0
        l2_rw_refuse_ty(node, oi)
        return: 0 - 1
return: oi

# The walker node already made for this catch, or -1.
fn: l2_rw_pad_slot (const: @(LmP0Node cf)) int
    int: i 0
    while: i < l2_rw_pn
        if: l2_rw_pcf[i] = cf
            return: l2_rw_pid[i]
        i: i + 1
    ---
return: 0 - 1

fn: l2_rw_param_own (const: @(LmP0Node decl)) int
    int: oi 0
    while: oi < l2_own_n
        if: l2_own_decl[oi] = decl && l2_own_mi[oi] = l2_rw_mi
            return: oi
        oi: oi + 1
    ---
return: 0 - 1

# [pad, param cell..., handler]. The handler is filled when the catch statement is reached.
# A parameter that is not a number is refused: this slice emits only numeric cells.
fn: l2_rw_pad_new (int: into; const: @(LmP0Node cf)) int
    @: LmP0Structure ps
    @: LmP0Field f
    int: np 0
    int: id
    int: oi
    int: k 0
    c.array: [160]: char at
    if: l2_rw_emit = 0
        return: 0
    id: l2_rw_pad_slot(cf)
    if: id >= 0
        return: id
    if: l2_rw_pn >= 64
        return: 0 - 1
    ps: l2_catch_params(cf)
    if: ps != 0
        np: l2_count_active(ps)
    f: 0
    if: ps != 0
        f: l2_next_active(ps\first_field)
    while: f != 0
        oi: l2_rw_param_own(f\value)
        if: oi < 0 || l2_rw_num_ty(l2_own_ty[oi]) = 0
            return: 0 - 1
        if: l2_own_fid[oi] >= 0
            if: l2_own_fchild[oi] < 0 || l2_frame_head(l2_own_host[oi], "catch") = 0
                return: 0 - 1
            ---
        else:
            if: l2_own_uchild[oi] < 0
                return: 0 - 1
            ---
        ---
        f: l2_next_active(f\next)
    ---
    if: l2_rw_frame(into, "LMX_WALK_OP_PAD", 2 + np, @ id) != 0
        return: 0 - 1
    f: 0
    if: ps != 0
        f: l2_next_active(ps\first_field)
    while: f != 0
        oi: l2_rw_param_own(f\value)
        if: l2_own_fid[oi] >= 0
            if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, %dU, lmx_arena_ref_value(l2_b%d, %uU)) != 0\n            return: 1\n", id, 1 + k, l2_own_fid[oi], (cast: (unsigned) l2_own_fchild[oi])) < 0
                return: 0 - 1
            ---
        else:
            if: l2_own_slot_at(oi, at) != 0
                return: 0 - 1
            if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, %dU, lmx_arena_ref_value(%s)) != 0\n            return: 1\n", id, 1 + k, at) < 0
                return: 0 - 1
            ---
        ---
        k: k + 1
        f: l2_next_active(f\next)
    ---
    l2_rw_pcf[l2_rw_pn]: (cast: (@: LmP0Node) cf)
    l2_rw_pid[l2_rw_pn]: id
    l2_rw_pn: l2_rw_pn + 1
return: id

# One row (k_in, pad, 0). k_out stays 0: the row catches.
fn: l2_rw_catch_row (int: table; int: at; int: k_in; int: pad) int
    if: l2_rw_emit = 0
        return: 0
    if: c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %dU) != c.LMX_WALK_OK || lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, 0U) != c.LMX_WALK_OK || lmx_arena_ref_store(l2_rw%d, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", table, at, k_in, table, at + 2, table, at + 1, pad) < 0
        return: 1
return: 0

# The call's catch slot: one row per name this callee can throw that a pad here covers.
# k_in is the callee's own status number.
fn: l2_rw_catch_call (int: node; int: callee) int
    @: LmP0Text nm
    @: LmP0Node cf
    int: n 0
    int: k 1
    int: d
    int: g
    int: at 0
    int: table
    int: pad
    if: l2_rw_emit = 0 || callee < 0
        return: 0
    d: l2_throws_declared(callee)
    while: k <= d
        nm: l2_throws_name(callee, k)
        cf: l2_catch_find(l2_rw_mi, nm, 0, 0, 0)
        if: cf != 0 && l2_rw_pad_slot(cf) >= 0
            n: n + 1
        k: k + 1
    ---
    g: 1
    while: l2_implicit_name(g) != 0
        cf: l2_catch_find(l2_rw_mi, 0, l2_implicit_name(g), 0, 0)
        if: cf != 0 && l2_rw_pad_slot(cf) >= 0 && l2_implicit_status(callee, l2_implicit_name(g)) > 0
            n: n + 1
        g: g + 1
    ---
    if: n = 0
        return: 0
    if: l2_rw_plain(node, 3 * n, @ table) != 0 || l2_rw_put(node, 4, table) != 0
        return: 1
    k: 1
    while: k <= d
        nm: l2_throws_name(callee, k)
        cf: l2_catch_find(l2_rw_mi, nm, 0, 0, 0)
        pad: l2_rw_pad_slot(cf)
        if: cf != 0 && pad >= 0
            if: l2_rw_catch_row(table, at, k, pad) != 0
                return: 1
            at: at + 3
        ---
        k: k + 1
    ---
    g: 1
    while: l2_implicit_name(g) != 0
        cf: l2_catch_find(l2_rw_mi, 0, l2_implicit_name(g), 0, 0)
        pad: l2_rw_pad_slot(cf)
        if: cf != 0 && pad >= 0 && l2_implicit_status(callee, l2_implicit_name(g)) > 0
            if: l2_rw_catch_row(table, at, l2_implicit_status(callee, l2_implicit_name(g)), pad) != 0
                return: 1
            at: at + 3
        ---
        g: g + 1
    ---
return: 0

# A primitive's own fixed throw code (merge 1, implements 2), caught here.
fn: l2_rw_catch_fixed (int: node; int: k_in; const: @(char cname)) int
    @: LmP0Node cf
    int: pad
    int: table
    if: l2_rw_emit = 0
        return: 0
    cf: l2_catch_find(l2_rw_mi, 0, cname, 0, 0)
    if: cf = 0
        return: 0
    pad: l2_rw_pad_slot(cf)
    if: pad < 0
        return: 0
    if: l2_rw_plain(node, 3, @ table) != 0 || l2_rw_put(node, 2, table) != 0
        return: 1
return: l2_rw_catch_row(table, 0, k_in, pad)

fn: l2_rw_pads (@: LmP0Field first; int: into) int
    @: LmP0Field f
    int: id
    if: l2_rw_emit = 0
        return: 0
    f: l2_next_active(first)
    while: f != 0
        if: l2_frame_head(f\value, "catch")
            id: l2_rw_pad_new(into, f\value)
            if: id < 0
                return: l2_rw_refuse(f\value, "a catch parameter that is not a number")
            ---
        f: l2_next_active(f\next)
    ---
return: 0

fn: l2_rw_catch_stmt (const: @(LmP0Node stmt); int: into; int: slot; @: int made) int
    @: LmP0Structure body
    @: LmP0Structure ps
    int: id
    int: np 0
    int: empty
    c.array: [32]: char pn
    \made: 1
    if: l2_rw_emit = 0
        return: 0
    id: l2_rw_pad_new(into, stmt)
    if: id < 0
        return: l2_rw_refuse(stmt, "a catch parameter that is not a number")
    ps: l2_catch_params(stmt)
    if: ps != 0
        np: l2_count_active(ps)
    if: l2_scope_push(stmt) != 0
        return: 1
    body: l2_catch_body(stmt)
    if: body != 0 && body\first_field != 0
        if: l2_rw_body(body\first_field, id, 1 + np) != 0
            l2_scope_pop()
            return: 1
        ---
    else:
        if: l2_rw_plain(id, 0, @ empty) != 0 || l2_rw_put(id, 1 + np, empty) != 0
            l2_scope_pop()
            return: 1
        ---
    ---
    if: l2_scope_pop() != 0
        return: 1
    l2_rw_name(into, pn)
    if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, id) < 0
        return: 1
return: 0

# A call of method idx under container parent: the occurrence by reference, then each input from
# `args` (a field run, split by l2_expr_span like any actual list).
fn: l2_rw_call (const: @(LmP0Node node); int: idx; @: LmP0Field args; int: parent; @: int out) int
    @: LmP0Field a
    int: n 0
    int: k 0
    int: span
    int: arg
    int: j
    int: fr
    int: d 0
    # A callee that can throw is called like any other (commit 3; -161 c3 D-37): its trampoline
    # returns the throw's number k, the walk carries it as LMX_WALK_THROWN + k and stops, and the
    # turn's channel holds k.  The root has no catch yet (no walker role), so a throw there is
    # uncaught: R0 stops and the host maps its success 0 to exit 1.
    # A method body tried quietly stays native when it calls a dynamic-input
    # callee: the count pass refuses, so the walked set does not change. The
    # root is not quiet. It passes each dynamic input as one more argument,
    # after the declared ones, in the same activation frame. No third graph.
    if: l2_m_dyn[idx] != 0 && l2_rw_quiet != 0
        return: l2_rw_refuse(node, "a call of a method with dynamic inputs")
    # A result is an int, a size_t, an unsigned or a ulong (-178): the walk hands a trampoline of a
    # wider type a destination of that type, by the class of the callee's return cell (rtype).
    if: l2_tramp_class(idx) > 4
        return: l2_rw_refuse(node, "a call whose result is not a number")
    # An input is a number (its formal's type: the trampoline reads that cell type), a Structure
    # of the formal's own named type (by reference, -179), or a callable formal, which takes a
    # method's occurrence by reference.
    j: 0
    while: j < l2_m_arity[idx]
        if: l2_cf_get(idx, j) < 0 && l2_rw_num_ty(l2_own_ty_of_param(l2_input_ft(idx, j))) = 0 && l2_nsty_get(idx, j) < 0
            return: l2_rw_refuse(node, "a call with an input that is not a number")
        j: j + 1
    ---
    a: l2_next_active(args)
    while: a != 0
        span: l2_expr_span(a)
        if: span < 1
            return: l2_rw_refuse(node, "this call's inputs")
        n: n + 1
        a: l2_skip_span(a, span)
    ---
    if: n != l2_m_arity[idx]
        return: l2_rw_refuse(node, "this call's inputs")
    # [call, code, data, rtype, args...] (-188 k.3c; -189 c3a, c4): the code is the occurrence, and
    # so is the data, (M, M).  The root has no name a call or an actual could use, so it is in no
    # cycle of calls and no call from it is a re-entry (l2_reenters).  A method's call that can
    # re-enter it -- the callee can lead back to the caller -- passes fresh data, [fresh, code], as
    # the native call does (-193 T4a; the native call site's rule: a callee with own fields).
    # rtype is the callee's result cell in its `return` part (l2_emit_parts), by reference: the walk
    # types the call's destination by that cell's range; a `sub` has none (0).
    if: l2_rw_frame(parent, "LMX_WALK_OP_CALL", 5 + n + l2_m_dyn[idx], out) != 0
        return: 1
    if: l2_rw_catch_call(\out, idx) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) lmx_arena_ref_struct(l2_entry_unit, %uU))) != 0\n            return: 1\n", \out, (cast: (unsigned) (l2_unit_base + idx))) < 0
        return: 1
    if: l2_rw_mi != l2_e && l2_reenters(l2_rw_mi, idx) != 0 && l2_m_kids(idx) > l2_m_head(idx)
        if: l2_rw_frame(\out, "LMX_WALK_OP_FRESH", 2, @ fr) != 0
            return: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) lmx_arena_ref_struct(l2_entry_unit, %uU))) != 0\n            return: 1\n", fr, (cast: (unsigned) (l2_unit_base + idx))) < 0
            return: 1
        if: l2_rw_put(\out, 2, fr) != 0
            return: 1
        ---
    else:
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 2U, (cast: (@: void) lmx_arena_ref_struct(l2_entry_unit, %uU))) != 0\n            return: 1\n", \out, (cast: (unsigned) (l2_unit_base + idx))) < 0
            return: 1
        ---
    ---
    if: l2_rw_emit != 0 && l2_m_ret[idx] != 8 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 3U, lmx_arena_ref_value(lmx_arena_ref_struct(lmx_arena_ref_struct(l2_entry_unit, %uU), 1U), 0U)) != 0\n            return: 1\n", \out, (cast: (unsigned) (l2_unit_base + idx))) < 0
        return: 1
    a: l2_next_active(args)
    while: a != 0
        span: l2_expr_span(a)
        if: l2_cf_get(idx, k) >= 0
            # The method named as the actual, by reference: the walk passes a Structure argument as
            # it is, and the trampoline hands it on as the callable formal.
            if: span != 1 || a\value = 0 || a\value\kind != c.LM_P0_NODE_ATOM || a\value\as = 0
                return: l2_rw_refuse(node, "a callable input that is not a method's name")
            j: l2_find_method(a\value\as\atom)
            if: j < 0 || j = l2_e
                return: l2_rw_refuse(node, "a callable input that is not a method's name")
            if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, %dU, (cast: (@: void) lmx_arena_ref_struct(l2_entry_unit, %uU))) != 0\n            return: 1\n", \out, 5 + k, (cast: (unsigned) (l2_unit_base + j))) < 0
                return: 1
            ---
        else:
            if: l2_nsty_get(idx, k) >= 0
                if: l2_rw_struct_arg(node, a, span, l2_nsty_get(idx, k), \out, @ arg) != 0 || l2_rw_put(\out, 5 + k, arg) != 0
                    return: 1
                ---
            else:
                if: l2_rw_texpr(a, span, l2_own_ty_of_param(l2_input_ft(idx, k)), \out, @ arg) != 0 || l2_rw_put(\out, 5 + k, arg) != 0
                    return: 1
                ---
            ---
        ---
        k: k + 1
        a: l2_skip_span(a, span)
    ---
    d: 0
    while: d < l2_m_dyn[idx]
        if: l2_rw_dyn_arg(node, idx, d, \out, @ arg) != 0 || l2_rw_put(\out, 5 + n + d, arg) != 0
            return: 1
        d: d + 1
    ---
return: 0

# One dynamic input of callee idx, as one more argument of the call (after the declared
# formals). Same order as l2_hidden_from: the caller's formal, then the caller's own
# field, then the callee's lexical field. None of those is a third graph. A miss is the
# same located refusal the native call emits.
fn: l2_rw_dyn_arg (const: @(LmP0Node node); int: idx; int: k; int: parent; @: int out) int
    @: LmP0Text nm
    int: oty
    int: oi
    int: pi
    c.array: [256]: char msg
    if: idx < 0 || k < 0 || k >= l2_m_dyn[idx]
        return: 1
    nm: l2_dn(idx, k)
    oty: l2_own_of_dt(l2_dt(idx, k))
    if: l2_rw_num_ty(oty) = 0
        return: l2_rw_refuse(node, "a call with an input that is not a number")
    pi: l2_param_find(l2_rw_mi, nm)
    if: pi >= 0 && l2_rw_mi != l2_e
        oi: l2_rw_bound(nm)
        if: oi >= 0
            return: l2_rw_own(parent, oi, out)
        return: l2_rw_arg(parent, pi, out)
    # The root has no ARG slot for an entry formal. Do not pass the callee's cell instead.
    if: pi >= 0 && l2_rw_mi = l2_e
        return: l2_rw_refuse(node, "a call of a method with dynamic inputs")
    oi: l2_own_find_last(l2_rw_mi, nm)
    if: oi >= 0 && l2_m_uses[l2_own_off(l2_rw_mi, oi)] != 0 && l2_rw_num_ty(l2_own_ty[oi]) != 0 && l2_own_uchild[oi] >= 0
        return: l2_rw_own(parent, oi, out)
    oi: l2_own_find_last(idx, nm)
    if: oi < 0
        if: nm = 0
            return: l2_error(l2_src, node, "unbound dynamic input")
        if: c.snprintf(msg, 256U, "unbound dynamic input %.*s", (cast: (int) nm\length), nm\data) < 0
            return: 1
        return: l2_error(l2_src, node, msg)
    if: l2_own_mi[oi] = idx && l2_own_uchild[oi] >= 0 && l2_rw_num_ty(l2_own_ty[oi]) != 0
        return: l2_rw_callee_at(parent, idx, oi, out)
    if: l2_rw_num_ty(l2_own_ty[oi]) != 0 && l2_own_uchild[oi] >= 0
        return: l2_rw_own(parent, oi, out)
return: l2_rw_refuse(node, "a call with an input that is not a number")

# AT of method idx's own field oi: the occurrence itself, not the unit.
fn: l2_rw_callee_at (int: parent; int: idx; int: oi; @: int out) int
    if: l2_rw_frame(parent, "LMX_WALK_OP_AT", 3, out) != 0
        return: 1
    if: l2_rw_emit = 0
        return: 0
    if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) lmx_arena_ref_struct(l2_entry_unit, %uU))) != 0\n            return: 1\n", \out, (cast: (unsigned) (l2_unit_base + idx))) < 0
        return: 1
    if: c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %uU) != c.LMX_WALK_OK\n            return: 1\n", \out, (cast: (unsigned) l2_own_uchild[oi])) < 0
        return: 1
return: 0

# A Structure argument by reference (FABLE-OPUS-ROOT-TAKE-20260925-179 commit 2): the actual is a
# root own field of the formal's own named Structure type `ni`, and the callee receives the
# Structure that field holds -- DEREF(AT(unit, its cell)), the same node, not a copy -- so a write
# through the formal is the caller's.  An actual of another type, or an untyped graph (a letter),
# is admitted first: the caller's implicit `implements` (D-55), not built here.
fn: l2_rw_struct_arg (const: @(LmP0Node node); @: LmP0Field a; int: span; int: ni; int: parent; @: int out) int
    int: oi
    int: raw
    if: span != 1 || a\value = 0 || a\value\kind != c.LM_P0_NODE_ATOM || a\value\as = 0
        return: l2_rw_refuse(node, "a Structure argument that is not a field's name")
    oi: l2_rw_find(a\value\as\atom)
    if: l2_rw_seen(oi) = 0 || l2_own_host[oi] != 0 || l2_own_fid[oi] >= 0 || l2_own_uchild[oi] < 0 || l2_own_is_pointer(l2_own_ty[oi]) = 0
        return: l2_rw_refuse(node, "a Structure argument that is not a field's name")
    # An untyped graph -- a letter -- is admitted to the formal's type at the call site, the
    # caller's implicit `implements` (-178 commit 3): the input is admit(AT(the field), T), the
    # primitive reading the reference the cell holds.
    if: l2_own_nsty_get(oi) < 0
        if: l2_rw_admit(parent, ni, l2_rw_is_letter(oi), out) != 0 || l2_rw_own(\out, oi, @ raw) != 0
            return: 1
        return: l2_rw_put(\out, 3, raw)
    ---
    if: l2_own_nsty_get(oi) != ni
        return: l2_rw_refuse(node, "an admission to a Structure type")
    if: l2_own_is_slot(oi) != 0
        return: l2_rw_own(parent, oi, out)
    if: l2_rw_frame(parent, "LMX_WALK_OP_DEREF", 2, out) != 0 || l2_rw_own(\out, oi, @ raw) != 0
        return: 1
return: l2_rw_put(\out, 1, raw)

# Input j of the method being built (-193 T4a): [arg, j], the reference its caller passed (the
# walker's ARG reads f\args[j]).
fn: l2_rw_arg (int: parent; int: j; @: int out) int
    if: l2_rw_frame(parent, "LMX_WALK_OP_ARG", 2, out) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 1U, %dU) != c.LMX_WALK_OK\n            return: 1\n", \out, j) < 0
        return: 1
return: 0

# One operand of type ty (resolved by l2_rw_texpr): an atom, a call frame, or a parenthesized
# expression.
fn: l2_rw_operand (const: @(LmP0Node node); int: ty; int: parent; @: int out) int
    int: v 0
    size_t: eix 0U
    int: oi
    int: idx
    int: pmi 0 - 1
    int: neg 0
    size_t: mag 0U
    int: usuf 0
    @: LmP0Text t
    c.array: [8]: char ib
    if: node = 0
        return: l2_rw_refuse(node, "an empty operand")
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0 && node\as\structure != 0
        if: l2_count_active(node\as\structure) = 0
            return: l2_rw_refuse(node, "an empty operand")
        return: l2_rw_texpr(node\as\structure\first_field, l2_count_active(node\as\structure), ty, parent, out)
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0
        t: node\as\frame\head
        if: t != 0 && t\length > 2U && t\data[0] = 99 && t\data[1] = 46
            return: l2_rw_l2(node)
        if: l2_text_eq(t, "sizeof") || l2_text_eq(t, "cast") || (t != 0 && t\length > 0U && (t\data[0] = 64 || t\data[0] = 92))
            return: l2_rw_l2(node)
        idx: l2_find_method(t)
        if: idx >= 0 && idx != l2_e
            if: node\as\frame\body = 0
                return: l2_rw_call(node, idx, 0, parent, out)
            return: l2_rw_call(node, idx, node\as\frame\body\first_field, parent, out)
        if: l2_text_eq(t, "merge")
            return: l2_rw_refuse(node, "merge")
        # A call through a path, `Holder\viaPath(4U)` (-196): the general path resolver gives the
        # callable field's method (kind 4, its occurrence -- a shared terminal, Q22 = II), called as
        # that method is.
        if: l2_rw_has_slash(t) != 0 && l2_path_kind(t\data, t\length, @ pmi) = 4 && pmi >= 0 && pmi != l2_e
            if: node\as\frame\body = 0
                return: l2_rw_call(node, pmi, 0, parent, out)
            return: l2_rw_call(node, pmi, node\as\frame\body\first_field, parent, out)
        ---
        if: l2_rw_has_slash(t) != 0
            return: l2_rw_refuse(node, "a field path")
        if: l2_text_eq(t, "length")
            return: l2_rw_length_of(node, parent, out)
        # `implements(candidate, required, consumer)` over descriptor names is decided when the
        # program is translated: l2_prep_implements' own answer, 1 or 0, as the native emission
        # writes it, is an int literal here (-176).
        if: l2_text_eq(t, "implements")
            if: l2_prep_implements(node, ib) != 0
                return: 1
            return: l2_rw_lit(parent, (cast: (int) (ib[0] = 49)), out)
        return: l2_rw_refuse(node, "this operand")
    if: node\kind != c.LM_P0_NODE_ATOM || node\as = 0
        return: l2_rw_refuse(node, "this operand")
    t: node\as\atom
    if: l2_rw_num_lit(t, @ neg, @ mag, @ usuf) != 0
        return: l2_rw_tlit(node, parent, ty, neg, mag, usuf, out)
    if: t != 0 && t\length > 0U && t\data[0] >= 48 && t\data[0] <= 57
        return: l2_rw_refuse(node, "a literal that is not a decimal number")
    if: l2_rw_char_lit(t, @ v) != 0
        if: ty != 1
            return: l2_rw_refuse(node, "mixed numeric types (a conversion)")
        return: l2_rw_clit(parent, v, out)
    if: t != 0 && t\length > 0U && (t\data[0] = 34 || t\data[0] = 39)
        return: l2_rw_refuse(node, "a string or char literal")
    if: t != 0 && t\length > 0U && (t\data[0] = 64 || t\data[0] = 92)
        return: l2_rw_l2(node)
    if: t != 0 && t\length > 2U && t\data[0] = 99 && t\data[1] = 46
        return: l2_rw_l2(node)
    if: l2_rw_has_slash(t) != 0
        # An element index is `[` after a name. `\[N]` is an occurrence, not an index.
        oi: 0
        idx: 0
        while: oi < (cast: (int) t\length)
            if: t\data[oi] = 91 && (oi = 0 || t\data[oi - 1] != 92)
                idx: 1
            oi: oi + 1
        ---
        if: idx != 0
            return: l2_rw_indexed_path(node, t, parent, out)
        return: l2_rw_path_read(node, t, parent, out)
    oi: l2_rw_elem_of(t, @ eix)
    if: oi >= 0
        return: l2_rw_elem(parent, oi, 0 - 1, eix, out)
    idx: l2_dyn_own_index(l2_rw_mi, t, @ oi, @ pmi)
    if: idx = 2
        return: l2_rw_refuse(node, "mixed numeric types (a conversion)")
    if: idx = 1
        return: l2_rw_elem(parent, oi, pmi, 0U, out)
    # A reference where a reference is asked (`m = 0`, -179): the field's pointer cell, as AT
    # gives it; the walker's EQ compares the address it holds.
    if: ty >= 1000
        oi: l2_rw_find(t)
        if: l2_rw_seen(oi) != 0 && l2_own_host[oi] = 0 && l2_own_fid[oi] < 0 && l2_own_uchild[oi] >= 0 && l2_own_is_pointer(l2_own_ty[oi]) != 0
            return: l2_rw_own(parent, oi, out)
        ---
    ---
    # A formal of the method being built is its input j (-193 T4a): [arg, j], until its numeric
    # field's binding line (T4b class 2); from then on the name is that field.
    if: l2_rw_mi != l2_e && l2_formal_find(l2_rw_mi, t) >= 0
        oi: l2_rw_bound(t)
        if: oi >= 0
            return: l2_rw_own(parent, oi, out)
        return: l2_rw_arg(parent, l2_formal_find(l2_rw_mi, t), out)
    oi: l2_rw_own_row(node, t)
    if: oi = 0 - 1
        return: 1
    if: oi >= 0
        return: l2_rw_own(parent, oi, out)
    idx: l2_find_method(t)
    if: idx >= 0 && idx != l2_e
        return: l2_rw_call(node, idx, 0, parent, out)
    if: l2_text_eq(t, "mainArgs")
        return: l2_rw_refuse(node, "mainArgs")
    if: l2_ns_find(t) >= 0
        return: l2_rw_refuse(node, "a Structure value")
return: l2_rw_refuse(node, "this operand")

# The precedence of a binary operator: 1 || , 2 && , 3 = != , 4 < > <= >= , 5 + - , 6 * / % .
fn: l2_rw_prec (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "||")
        return: 1
    if: l2_text_eq(t, "&&")
        return: 2
    if: l2_text_eq(t, "=") || l2_text_eq(t, "!=")
        return: 3
    if: l2_text_eq(t, "<") || l2_text_eq(t, ">") || l2_text_eq(t, "<=") || l2_text_eq(t, ">=")
        return: 4
    if: l2_text_eq(t, "+") || l2_text_eq(t, "-")
        return: 5
    if: l2_text_eq(t, "*") || l2_text_eq(t, "/") || l2_text_eq(t, "%")
        return: 6
return: 0

# A flag step made while building an expression; its statement runs it first (l2_rw_stmts).
fn: l2_rw_pre_push (int: node) int
    @: int grown
    if: l2_rw_pre_n >= l2_rw_pre_cap
        grown: (cast: (@: int) realloc((cast: (@: void) l2_rw_pre), (cast: (size_t) (l2_rw_pre_cap + 16)) * c.sizeof(c.int)))
        if: grown = 0
            return: 1
        l2_rw_pre: grown
        l2_rw_pre_cap: l2_rw_pre_cap + 16
    ---
    l2_rw_pre[l2_rw_pre_n]: node
    l2_rw_pre_n: l2_rw_pre_n + 1
return: 0

# A plain Structure of n slots under container `parent` -- a body, or the holder of a value.
fn: l2_rw_plain (int: parent; int: n; @: int out) int
    c.array: [32]: char pn
    \out: l2_rw_t
    l2_rw_t: l2_rw_t + 1
    if: l2_rw_emit = 0
        return: 0
    l2_rw_name(parent, pn)
return: (cast: (int) (c.fprintf(l2_out, "        @: Lmx l2_rw%d lmx_walk_plain(l2_program_arena, %s, %dU)\n        if: l2_rw%d = 0\n            return: 1\n", \out, pn, n, \out) < 0))

# Slot `slot` of IF node `node` takes the body [PUT(h, 0, LIT v)]: the flag cell set to v.
fn: l2_rw_sc_set (int: node; int: slot; int: h; int: v) int
    int: body
    int: put
    int: lit
    if: l2_rw_plain(node, 1, @ body) != 0 || l2_rw_frame(body, "LMX_WALK_OP_PUT", 4, @ put) != 0 || l2_rw_put(put, 1, h) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, 0U) != c.LMX_WALK_OK\n            return: 1\n", put) < 0
        return: 1
    if: l2_rw_lit(put, v, @ lit) != 0 || l2_rw_put(put, 3, lit) != 0 || l2_rw_put(body, 0, put) != 0
        return: 1
return: l2_rw_put(node, slot, body)

# The static type of one side of `&&` / `||`, normalized as a comparison's operands are (a bare
# literal is an int, one with `U` an unsigned); -9 for a reference, which is not a condition here.
fn: l2_rw_sc_ty (@@: LmP0Node tok; int: lo; int: hi) int
    int: ty
    ty: l2_rw_tyof(tok, lo, hi)
    if: ty = 0 - 1
        return: 0
    if: ty = 0 - 2
        return: 3
    if: ty >= 1000
        return: 0 - 9
return: ty

# `a && b` / `a || b` at the walked root (-196), short-circuit: b runs only when a does not decide.
# The walker's IF has no value, so the value is a flag cell of a plain holder h, written on both ways
# after a is known -- a flag STEP that the statement runs first (l2_rw_pre_push) -- and read by
# AT(h, 0):
#   a && b:  IF(a, [b's own flag steps, IF(b, [h: 1], [h: 0])], [h: 0])
#   a || b:  IF(a, [h: 1], [b's own flag steps, IF(b, [h: 1], [h: 0])])
# a's own flag steps run before this one (they were pushed first); b's run inside the way that runs
# b, so a nested `&&` stays short-circuit.  andp is the operator's precedence: 2 &&, 1 ||.
fn: l2_rw_sc (@@: LmP0Node tok; int: lo; int: best; int: hi; int: andp; int: parent; @: int out) int
    int: h
    int: pre
    int: a
    int: b
    int: ib
    int: bb
    int: dummy
    int: base
    int: nb
    int: k
    int: save
    int: aty
    int: bty
    aty: l2_rw_sc_ty(tok, lo, best - 1)
    bty: l2_rw_sc_ty(tok, best + 1, hi)
    if: aty = 0 - 3 || bty = 0 - 3
        return: l2_rw_refuse(tok[best], "mixed numeric types (a conversion)")
    if: aty = 0 - 9 || bty = 0 - 9
        return: l2_rw_refuse(tok[best], "a reference as a condition of && or ||")
    if: l2_rw_plain(parent, 1, @ h) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_int(l2_program_arena, l2_rw%d, 0U, 0) != c.LMX_WALK_OK\n            return: 1\n", h) < 0
        return: 1
    if: l2_rw_frame(parent, "LMX_WALK_OP_IF", 4, @ pre) != 0
        return: 1
    if: l2_rw_bin(tok, lo, best - 1, aty, pre, @ a) != 0 || l2_rw_put(pre, 1, a) != 0
        return: 1
    # b's own flag steps are counted first: they fill the body that runs b, before IF(b, ...).
    base: l2_rw_pre_n
    save: l2_rw_emit
    l2_rw_emit: 0
    k: l2_rw_bin(tok, best + 1, hi, bty, parent, @ dummy)
    l2_rw_emit: save
    nb: l2_rw_pre_n - base
    l2_rw_pre_n: base
    if: k != 0
        return: 1
    if: l2_rw_plain(pre, nb + 1, @ bb) != 0 || l2_rw_frame(bb, "LMX_WALK_OP_IF", 4, @ ib) != 0
        return: 1
    if: l2_rw_bin(tok, best + 1, hi, bty, ib, @ b) != 0 || l2_rw_put(ib, 1, b) != 0
        return: 1
    k: 0
    while: k < nb
        if: l2_rw_put(bb, k, l2_rw_pre[base + k]) != 0
            return: 1
        k: k + 1
    ---
    l2_rw_pre_n: base
    if: l2_rw_put(bb, nb, ib) != 0 || l2_rw_sc_set(ib, 2, h, 1) != 0 || l2_rw_sc_set(ib, 3, h, 0) != 0
        return: 1
    if: andp = 2 && (l2_rw_put(pre, 2, bb) != 0 || l2_rw_sc_set(pre, 3, h, 0) != 0)
        return: 1
    if: andp = 1 && (l2_rw_sc_set(pre, 2, h, 1) != 0 || l2_rw_put(pre, 3, bb) != 0)
        return: 1
    if: l2_rw_pre_push(pre) != 0
        return: 1
    if: l2_rw_frame(parent, "LMX_WALK_OP_AT", 3, out) != 0 || l2_rw_put(\out, 1, h) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, 0U) != c.LMX_WALK_OK\n            return: 1\n", \out) < 0
        return: 1
return: 0

# Tokens lo..hi of type ty (operands at lo, lo + 2, ...; operators between), split by l2_rw_split.
# + and - take ty for both operands; a comparison is an int whose operands have their own one
# type, resolved here (a literal alone is an int, with a `U` an unsigned).
fn: l2_rw_bin (@@: LmP0Node tok; int: lo; int: hi; int: ty; int: parent; @: int out) int
    int: best
    int: bestp
    int: ot
    int: node
    int: inner
    int: one
    int: left
    int: right
    @: LmP0Text op
    const: @(char code) 0
    int: swap 0
    int: negate 0
    int: zneg 0
    size_t: zmag 1U
    int: zu 0
    if: lo = hi
        return: l2_rw_operand(tok[lo], ty, parent, out)
    best: l2_rw_split(tok, lo, hi)
    bestp: l2_rw_prec(tok[best]\as\atom)
    ot: ty
    if: bestp = 3 || bestp = 4
        ot: l2_rw_unify(l2_rw_tyof(tok, lo, best - 1), l2_rw_tyof(tok, best + 1, hi))
        if: ot = 0 - 3
            return: l2_rw_refuse(tok[best], "mixed numeric types (a conversion)")
        if: ot = 0 - 1
            ot: 0
        if: ot = 0 - 2
            ot: 3
        # References are equal or not (-179): the walker's EQ over pointer cells has no order.
        if: ot >= 1000 && bestp = 4
            return: l2_rw_refuse(tok[best], "a reference compared by order")
    ---
    if: bestp = 5 && ty >= 1000
        return: l2_rw_refuse(tok[best], "arithmetic on a reference")
    op: tok[best]\as\atom
    if: bestp = 1 || bestp = 2
        return: l2_rw_sc(tok, lo, best, hi, bestp, parent, out)
    # `* / %` (-183 commit 2; Grok -170 c1): MUL, DIV, MOD over one type, as + and - are -- an int
    # divides as C does (-7 / 2 is -3), an unsigned one unsigned.  A divisor that is the literal 0
    # is refused here; a computed 0 is the walker's X1 in R0's turn.
    if: bestp = 6
        if: ty >= 1000
            return: l2_rw_refuse(tok[best], "arithmetic on a reference")
        if: l2_text_eq(op, "*")
            code: "LMX_WALK_OP_MUL"
        if: l2_text_eq(op, "/")
            code: "LMX_WALK_OP_DIV"
        if: l2_text_eq(op, "%")
            code: "LMX_WALK_OP_MOD"
        if: code != 0 && l2_text_eq(op, "*") = 0 && best + 1 = hi && tok[hi] != 0 && tok[hi]\kind = c.LM_P0_NODE_ATOM && tok[hi]\as != 0 && l2_rw_num_lit(tok[hi]\as\atom, @ zneg, @ zmag, @ zu) != 0 && zmag = 0U
            return: l2_rw_refuse(tok[hi], "a division by zero")
    ---
    if: l2_text_eq(op, "+")
        code: "LMX_WALK_OP_ADD"
    if: l2_text_eq(op, "-")
        code: "LMX_WALK_OP_SUB"
    if: l2_text_eq(op, "<")
        code: "LMX_WALK_OP_LT"
    if: l2_text_eq(op, "=")
        code: "LMX_WALK_OP_EQ"
    if: l2_text_eq(op, ">")
        code: "LMX_WALK_OP_LT"
        swap: 1
    ---
    if: l2_text_eq(op, "!=")
        code: "LMX_WALK_OP_EQ"
        negate: 1
    ---
    if: l2_text_eq(op, "<=")
        code: "LMX_WALK_OP_LT"
        swap: 1
        negate: 1
    ---
    if: l2_text_eq(op, ">=")
        code: "LMX_WALK_OP_LT"
        negate: 1
    ---
    if: code = 0
        return: l2_rw_refuse(tok[best], "this operator")
    # a != b is 1 - (a = b); a <= b is 1 - (b < a); a >= b is 1 - (a < b); a > b is b < a.
    if: negate != 0
        if: l2_rw_frame(parent, "LMX_WALK_OP_SUB", 3, out) != 0 || l2_rw_lit(\out, 1, @ one) != 0 || l2_rw_put(\out, 1, one) != 0
            return: 1
        if: l2_rw_frame(\out, code, 3, @ inner) != 0 || l2_rw_put(\out, 2, inner) != 0
            return: 1
        node: inner
    else:
        if: l2_rw_frame(parent, code, 3, out) != 0
            return: 1
        node: \out
    ---
    if: l2_rw_bin(tok, lo, best - 1, ot, node, @ left) != 0 || l2_rw_bin(tok, best + 1, hi, ot, node, @ right) != 0
        return: 1
    if: swap = 0 && (l2_rw_put(node, 1, left) != 0 || l2_rw_put(node, 2, right) != 0)
        return: 1
    if: swap != 0 && (l2_rw_put(node, 1, right) != 0 || l2_rw_put(node, 2, left) != 0)
        return: 1
return: 0

# An expression given as the run of n fields from `field`, in a place that asks no type (a
# condition, an expression statement): its own.
fn: l2_rw_expr (@: LmP0Field field; int: n; int: parent; @: int out) int
return: l2_rw_texpr(field, n, 0 - 1, parent, out)

# An expression given as the run of n fields from `field`, in a place that asks type `want` (a
# field's, a formal's, a message field's), or -1: its static type (l2_rw_tyof) must be that one,
# and a literal alone takes it.
fn: l2_rw_texpr (@: LmP0Field field; int: n; int: want; int: parent; @: int out) int
    c.array: [64]: @: LmP0Node tok
    @: LmP0Field f
    int: m 0
    int: k 1
    int: ty
    if: n < 1 || n > 63
        return: l2_rw_refuse(0, "an expression this long")
    m: l2_rw_tokens(field, n, tok)
    if: m < 1
        f: l2_next_active(field)
        if: f = 0
            return: l2_rw_refuse(0, "this expression")
        return: l2_rw_refuse(f\value, "this expression")
    ---
    while: k < m
        if: tok[k] = 0 || tok[k]\kind != c.LM_P0_NODE_ATOM || tok[k]\as = 0
            return: l2_rw_refuse(tok[k], "this expression")
        if: l2_is_slash(tok[k]\as\atom)
            return: l2_rw_refuse(tok[k], "a field path")
        if: l2_text_eq(tok[k]\as\atom, "[")
            return: l2_rw_refuse(tok[k], "an array")
        if: l2_rw_prec(tok[k]\as\atom) = 0
            return: l2_rw_refuse(tok[k], "this expression")
        k: k + 2
    ---
    n: m
    l2_rw_mix_at: 0
    ty: l2_rw_tyof(tok, 0, n - 1)
    if: ty = 0 - 3
        return: l2_rw_refuse(l2_rw_mix_at, "mixed numeric types (a conversion)")
    # A reference stands only where its own type is asked (-179): compared with 0 inside a
    # condition, or passed to a formal of that type.
    if: ty >= 1000 && ty != want
        return: l2_rw_refuse(tok[0], "a reference where a number is asked")
    if: want >= 0
        if: ty >= 0 && ty != want
            return: l2_rw_refuse(tok[0], "mixed numeric types (a conversion)")
        ty: want
    ---
    if: ty = 0 - 1
        ty: 0
    if: ty = 0 - 2
        ty: 3
return: l2_rw_bin(tok, 0, n - 1, ty, parent, out)

# The steps a statement list builds (the count pass), without emitting anything.
fn: l2_rw_count (@: LmP0Field first) int
    int: save l2_rw_emit
    int: save_i l2_rw_send_i
    int: save_rec l2_rw_send_rec
    int: save_n l2_rw_bseq_n
    int: made 0
    int: bad 0
    int: i 0
    @: int snap 0
    # The count walk is a second pass over the same statements (emit calls it before
    # writing). Binding marks it sets must not stick, or the emit walk would see a
    # field as already bound on its binding line.
    if: l2_rw_bseq != 0 && l2_own_n > 0
        snap: (cast: (@: int) calloc((cast: (size_t) l2_own_n), c.sizeof(c.int)))
        if: snap = 0
            return: 0 - 1
        while: i < l2_own_n
            snap[i]: l2_rw_bseq[i]
            i: i + 1
        ---
    ---
    l2_rw_emit: 0
    l2_rw_send_rec: 0
    if: l2_rw_stmts(first, 0 - 2, 0, @ made) != 0
        bad: 1
    ---
    if: snap != 0
        i: 0
        while: i < l2_own_n
            l2_rw_bseq[i]: snap[i]
            i: i + 1
        ---
        free((cast: (@: void) snap))
    ---
    l2_rw_bseq_n: save_n
    l2_rw_emit: save
    l2_rw_send_i: save_i
    l2_rw_send_rec: save_rec
    if: bad != 0
        return: 0 - 1
return: made

# FABLE-SONNET-SEND-IN-METHODS-20260925-168 commit 2: `sendMessage: X` inside a method body --
# the same field shape l2_rw_send validates for the root (one Structure `Name(f: v; ...)`, fields
# `name: literal-or-int-expr`, at most 16, a text field is a quoted literal with no escape),
# recorded into the method-send arrays instead of a walker-op-tree.
# FABLE-SONNET-SEND-REF-20260925-172 commit 3: `sendMessage: Ref X` -- the message Structure is
# always the LAST active field of the statement's body; every field before it (there may be
# several -- a field path like `m\sender` is itself several sibling P0 fields, merged back into
# one expression only by l2_eval_fields/l2_rw_texpr's own tokenizer) is the Ref expression.  No
# field before the last means no Ref: the ordinary form, unchanged.
fn: l2_msend_register (const: @(LmP0Node stmt); const: @(char path); @: int out_k; @: int out_ni) int
    @: LmP0Field f
    @: LmP0Field mf
    @: LmP0Field g
    @: LmP0Field b
    @: LmP0Node x
    @: LmP0Node v
    @: LmP0Text t
    int: k
    int: nf 0
    int: ni 0
    int: n
    int: total
    int: refn
    int: has_ref 0
    size_t: i
    \out_k: -1
    \out_ni: 0
    if: stmt\as\frame\body = 0 || l2_count_active(stmt\as\frame\body) = 0
        return: l2_error(path, stmt, "this sendMessage")
    ---
    f: l2_next_active(stmt\as\frame\body\first_field)
    total: l2_count_active(stmt\as\frame\body)
    refn: total - 1
    mf: f
    if: refn > 0
        mf: l2_skip_span(f, refn)
        has_ref: 1
    ---
    if: mf = 0
        return: l2_error(path, stmt, "this sendMessage")
    x: mf\value
    if: x = 0 || x\kind != c.LM_P0_NODE_FRAME || x\as = 0 || x\as\frame = 0 || x\as\frame\body = 0 || l2_ident(x\as\frame\head) = 0
        return: l2_error(path, stmt, "a message that is not one Structure")
    ---
    k: l2_msend_i
    l2_msend_i: l2_msend_i + 1
    if: k >= 64
        return: l2_error(path, stmt, "more than 64 sends in method bodies")
    if: l2_msend_count = 0
        l2_msend_count: (cast: (@: int) calloc(64U, c.sizeof(int)))
        l2_msend_kind: (cast: (@: int) calloc(1024U, c.sizeof(int)))
        l2_msend_text: (cast: (@@: LmP0Text) calloc(1024U, c.sizeof(@: void)))
        l2_msend_has_ref: (cast: (@: int) calloc(64U, c.sizeof(int)))
        if: l2_msend_count = 0 || l2_msend_kind = 0 || l2_msend_text = 0 || l2_msend_has_ref = 0
            return: l2_error(path, stmt, "out of memory")
        ---
    ---
    l2_msend_has_ref[k]: has_ref
    g: l2_next_active(x\as\frame\body\first_field)
    while: g != 0
        v: g\value
        if: v = 0 || v\kind != c.LM_P0_NODE_FRAME || v\as = 0 || v\as\frame = 0 || v\as\frame\body = 0 || l2_ident(v\as\frame\head) = 0
            return: l2_error(path, v, "a message field that is not `name: value`")
        ---
        if: nf >= 16
            return: l2_error(path, v, "a message of more than 16 fields")
        n: l2_count_active(v\as\frame\body)
        b: l2_next_active(v\as\frame\body\first_field)
        t: 0
        if: n = 1 && b\value != 0 && b\value\kind = c.LM_P0_NODE_ATOM && b\value\as != 0
            t: b\value\as\atom
        ---
        if: t != 0 && t\length > 0U && t\data[0] = 34
            if: t\length < 2U || t\data[t\length - 1U] != 34
                return: l2_error(path, b\value, "this text")
            i: 1U
            while: i + 1U < t\length
                if: t\data[i] = 92 || t\data[i] = 34
                    return: l2_error(path, b\value, "a text with an escape in a message")
                i: i + 1U
            ---
            l2_msend_kind[k * 16 + nf]: 2
            l2_msend_text[k * 16 + nf]: t
        else:
            l2_msend_kind[k * 16 + nf]: 1
            l2_msend_text[k * 16 + nf]: 0
            ni: ni + 1
        ---
        nf: nf + 1
        g: l2_next_active(g\next)
    ---
    if: nf = 0
        return: l2_error(path, x, "an empty message")
    l2_msend_count[k]: nf
    if: k + 1 > l2_msend_n
        l2_msend_n: k + 1
    ---
    \out_k: k
    \out_ni: ni
return: 0

# `sendMessage: X` in the root (author 2026-09-24, LMX_blog/2026-09-24.md; K3 = a): X, one
# Structure `Name(f: v; ...)`, goes to the parent of the current Message -- for R0 the host -- as
# the letter (sender; X), an anonymous Structure whose field 0 is the sender's reference.  It goes
# through the service (lmx_service_post): the transport of a published outbox is kernel step K4.
# X's fields are positional (their names say what they are, the receiver admits by position): an
# int expression, walked into the primitive's inputs, or a text literal without escapes.  The step
# is a `prim` node whose record's fn is the generated l2_send<k> (l2_emit_send), which builds the
# letter in an arena of its own and posts it.
# `sendMessage: Ref X` (FABLE-SONNET-SEND-REF-20260925-172 commit 3): the message Structure is
# always the LAST active field of the statement's body; every field before it is the Ref
# expression, walked like any other operand (l2_rw_texpr already merges a field-path run such as
# `m\sender` -- itself several sibling P0 fields -- back into one expression; l2_rw_fields_ty gives
# its static type the same way).  Ref must resolve to a reference (>= 1000): the field's own
# pointer/reference value, exactly what AT gives a formal or local of that type.  It becomes the
# primitive's LAST input, after the payload's own int-expression inputs; l2_emit_send reads it as
# refs[nargs - 1] and posts there instead of to lmx_thread_parent(t).
fn: l2_rw_send (@: LmP0Node stmt; int: into; @: int out) int
    @: LmP0Field f
    @: LmP0Field mf
    @: LmP0Field g
    @: LmP0Field b
    @: LmP0Node x
    @: LmP0Node v
    @: LmP0Text t
    int: k
    int: nf 0
    int: ni 0
    int: n
    int: e
    int: total
    int: refn
    int: has_ref 0
    int: refty 0
    size_t: i
    if: stmt\as\frame\body = 0 || l2_count_active(stmt\as\frame\body) = 0
        return: l2_rw_refuse(stmt, "this sendMessage")
    ---
    f: l2_next_active(stmt\as\frame\body\first_field)
    total: l2_count_active(stmt\as\frame\body)
    refn: total - 1
    mf: f
    if: refn > 0
        mf: l2_skip_span(f, refn)
        has_ref: 1
    ---
    if: mf = 0
        return: l2_rw_refuse(stmt, "this sendMessage")
    x: mf\value
    if: x = 0 || x\kind != c.LM_P0_NODE_FRAME || x\as = 0 || x\as\frame = 0 || x\as\frame\body = 0 || l2_ident(x\as\frame\head) = 0
        return: l2_rw_refuse(stmt, "a message that is not one Structure")
    ---
    if: has_ref != 0
        refty: l2_rw_fields_ty(f, refn)
        if: refty < 1000
            return: l2_rw_refuse(f\value, "a Ref that is not a reference")
        ---
    ---
    k: l2_rw_send_i
    l2_rw_send_i: l2_rw_send_i + 1
    if: k >= 64
        return: l2_rw_refuse(stmt, "more than 64 sends in the root")
    if: l2_rw_send_rec != 0 && l2_rw_send_count = 0
        l2_rw_send_count: (cast: (@: int) calloc(64U, c.sizeof(int)))
        l2_rw_sf_kind: (cast: (@: int) calloc(1024U, c.sizeof(int)))
        l2_rw_sf_text: (cast: (@@: LmP0Text) calloc(1024U, c.sizeof(@: void)))
        l2_rw_send_has_ref: (cast: (@: int) calloc(64U, c.sizeof(int)))
        if: l2_rw_send_count = 0 || l2_rw_sf_kind = 0 || l2_rw_sf_text = 0 || l2_rw_send_has_ref = 0
            return: l2_error(l2_src, stmt, "out of memory")
        ---
    ---
    g: l2_next_active(x\as\frame\body\first_field)
    while: g != 0
        v: g\value
        if: v = 0 || v\kind != c.LM_P0_NODE_FRAME || v\as = 0 || v\as\frame = 0 || v\as\frame\body = 0 || l2_ident(v\as\frame\head) = 0
            return: l2_rw_refuse(v, "a message field that is not `name: value`")
        ---
        if: nf >= 16
            return: l2_rw_refuse(v, "a message of more than 16 fields")
        n: l2_count_active(v\as\frame\body)
        b: l2_next_active(v\as\frame\body\first_field)
        t: 0
        if: n = 1 && b\value != 0 && b\value\kind = c.LM_P0_NODE_ATOM && b\value\as != 0
            t: b\value\as\atom
        ---
        if: t != 0 && t\length > 0U && t\data[0] = 34
            if: t\length < 2U || t\data[t\length - 1U] != 34
                return: l2_rw_refuse(b\value, "this text")
            i: 1U
            while: i + 1U < t\length
                if: t\data[i] = 92 || t\data[i] = 34
                    return: l2_rw_refuse(b\value, "a text with an escape in a message")
                i: i + 1U
            ---
            if: l2_rw_send_rec != 0
                l2_rw_sf_kind[k * 16 + nf]: 2
                l2_rw_sf_text[k * 16 + nf]: t
            ---
        else:
            if: l2_rw_send_rec != 0
                l2_rw_sf_kind[k * 16 + nf]: 1
                l2_rw_sf_text[k * 16 + nf]: 0
            ---
            ni: ni + 1
        ---
        nf: nf + 1
        g: l2_next_active(g\next)
    ---
    if: nf = 0
        return: l2_rw_refuse(x, "an empty message")
    if: l2_rw_send_rec != 0
        l2_rw_send_count[k]: nf
        l2_rw_send_has_ref[k]: has_ref
        if: k + 1 > l2_rw_send_n
            l2_rw_send_n: k + 1
        ---
    ---
    if: l2_rw_frame(into, "LMX_WALK_OP_PRIM", 3 + ni + has_ref, out) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        @: LmxPrimitive l2_rwp%d (cast: (@: LmxPrimitive) lmx_arena_take(l2_program_arena, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))\n        if: l2_rwp%d = 0\n            return: 1\n        l2_rwp%d\\fn: l2_send%d\n        l2_rwp%d\\signature: 0\n        l2_rwp%d\\owner: l2_entry_unit\n        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_rwp%d)) != 0\n            return: 1\n", \out, \out, \out, k, \out, \out, \out, \out) < 0
        return: 1
    ni: 0
    g: l2_next_active(x\as\frame\body\first_field)
    while: g != 0
        v: g\value
        n: l2_count_active(v\as\frame\body)
        b: l2_next_active(v\as\frame\body\first_field)
        t: 0
        if: n = 1 && b\value != 0 && b\value\kind = c.LM_P0_NODE_ATOM && b\value\as != 0
            t: b\value\as\atom
        ---
        if: t = 0 || t\length = 0U || t\data[0] != 34
            # l2_send<k> reads its number inputs as ints.
            if: l2_rw_texpr(b, n, 0, \out, @ e) != 0 || l2_rw_put(\out, 3 + ni, e) != 0
                return: 1
            ni: ni + 1
        ---
        g: l2_next_active(g\next)
    ---
    if: has_ref != 0
        if: l2_rw_texpr(f, refn, refty, \out, @ e) != 0 || l2_rw_put(\out, 3 + ni, e) != 0
            return: 1
        ---
    ---
return: 0

# FABLE-SONNET-SEND-IN-METHODS-20260925-168 commit 2: `sendMessage: X` inside a method body --
# a direct native call of l2_msend<k> (l2_emit_send, prefix "l2_msend"), the same generated
# sender the root's own walker step calls through a prim record, no twin. Each int-typed field's
# value is evaluated the ordinary way (l2_eval_fields, exactly as any other native call's actual
# argument) into a local temp; refs[i] is just that temp's address (lmx_int_value_known is
# *(int*)cell, no boxing needed). A nonzero status is the same invariant-failure shape the root's
# own walker step would give a failed send -- there is no separate recoverable-failure route for
# this prim there either.
# FABLE-SONNET-SEND-REF-20260925-172 commit 3: `sendMessage: Ref X` -- the Ref expression (before
# the message, l2_msend_register already validated it), evaluated the same way (l2_eval_fields)
# and stored as the LAST refs[] slot, refs[ni]; l2_emit_send reads it there when its own
# has_ref_arr[k] says this site named one.
fn: l2_emit_msend (const: @(LmP0Node stmt); int: mi; const: @(char ind)) int
    @: LmP0Field f
    @: LmP0Field mf
    @: LmP0Field g
    @: LmP0Node v
    @: LmP0Node x
    int: k
    int: ni
    int: nf
    int: j
    int: ii
    int: total
    int: refn
    int: has_ref
    c.array: [1024]: char tok
    c.array: [1024]: char reftok
    if: l2_msend_register(stmt, l2_src, @ k, @ ni) != 0
        return: 1
    nf: l2_msend_count[k]
    has_ref: l2_msend_has_ref[k]
    if: c.fprintf(l2_out, "%sc.array: [%d]: @: void l2_msr%d\n", ind, (cast: (int) (1 + ni + has_ref)), k) < 0
        return: 1
    f: l2_next_active(stmt\as\frame\body\first_field)
    total: l2_count_active(stmt\as\frame\body)
    refn: total - 1
    mf: f
    if: refn > 0
        mf: l2_skip_span(f, refn)
    ---
    x: mf\value
    g: l2_next_active(x\as\frame\body\first_field)
    j: 0
    ii: 0
    while: g != 0
        v: g\value
        if: l2_msend_kind[k * 16 + j] = 1
            if: l2_eval_fields(l2_next_active(v\as\frame\body\first_field), l2_count_active(v\as\frame\body), mi, ind, tok) != 0
                return: 1
            # A copy into a named local first: l2_eval_fields's own token can be a bare literal
            # (e.g. "7"), and `@` needs an addressable variable, never a literal.
            if: c.fprintf(l2_out, "%sint: l2_msf%d_%d %s\n%sl2_msr%d[%d]: @ l2_msf%d_%d\n", ind, k, ii, tok, ind, k, ii, k, ii) < 0
                return: 1
            ii: ii + 1
        ---
        j: j + 1
        g: l2_next_active(g\next)
    ---
    if: has_ref != 0
        if: l2_eval_fields(f, refn, mi, ind, reftok) != 0
            return: 1
        if: c.fprintf(l2_out, "%sl2_msr%d[%d]: (cast: (@: void) (%s))\n", ind, k, ni, reftok) < 0
            return: 1
        ---
    ---
    if: c.fprintf(l2_out, "%sif: l2_msend%d(0, l2_msr%d, %dU, 0, 0) != 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: sendMessage failed\\n\")\n%s    c.abort()\n%s---\n", ind, k, k, (ni + has_ref), ind, ind, ind) < 0
        return: 1
return: 0

# Whether one of the n sends of a registry has a text field whose literal is not empty: its bytes are
# copied with memcpy (l2_emit_send), a use of <string.h> in the program's own emission (-197 (b)).
fn: l2_send_copies_text (int: n; @: int count_arr; @: int kind_arr; @@: LmP0Text text_arr) int
    int: k 0
    int: j
    while: k < n
        j: 0
        while: j < count_arr[k]
            if: kind_arr[k * 16 + j] = 2 && text_arr[k * 16 + j] != 0 && text_arr[k * 16 + j]\length > 2U
                return: 1
            j: j + 1
        ---
        k: k + 1
    ---
return: 0

# The primitive of send site k: it builds the letter (sender; payload) in an arena of its own and
# posts it through the current Message's service to its parent.  The payload is a Structure of the
# site's fields in order: an int cell from the next input, or a char Array holding the text
# (exact length, no NUL).  The letter's arena is the service's from the post on (attached to the
# receiver at its take); the record that describes it is this primitive's, and stays allocated.
# FABLE-SONNET-SEND-IN-METHODS-20260925-168 commit 2: parameterised (prefix, count/kind/text
# arrays) so a method-body send site and a root send site share this one emission path -- no
# twin -- while keeping their k-spaces (and so their generated function names) apart.
# FABLE-SONNET-SEND-REF-20260925-172 commit 3: has_ref_arr[k], 1 when the site named `sendMessage:
# Ref X` -- a STATIC, per-k fact, so which of the two lmx_service_post lines below this k's body
# gets is chosen here, at generation time, not by any runtime branch on dest (dest/out stay the
# walker's own step-destination pair, untouched, exactly as every other prim already treats them).
# The Ref value, when named, travels as the LAST of the caller's evaluated inputs -- refs[ni],
# after the payload's own ni int-expression inputs -- both call sites (l2_rw_send's PRIM, whose
# refs[] the walker itself evaluates one slot per primitive input; l2_emit_msend's direct call)
# already place it there.
fn: l2_emit_send (int: k; int: proto; @: char prefix; @: int count_arr; @: int kind_arr; @@: LmP0Text text_arr; @: int has_ref_arr) int
    int: j
    int: ni 0
    int: nf
    int: has_ref
    @: LmP0Text t
    nf: count_arr[k]
    has_ref: has_ref_arr[k]
    if: proto != 0
        return: (cast: (int) (c.fprintf(l2_out, "    fn: %s%d (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int\n", prefix, k) < 0))
    if: c.fprintf(l2_out, "fn: %s%d (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int\n", prefix, k) < 0
        return: 1
    if: fputs("    @: LmxThread t lmx_thread_current()\n    @: LmxArena a (cast: (@: LmxArena) calloc(1U, c.sizeof(c.LmxArena)))\n    @: LmxMsg m 0\n    @: Lmx g 0\n    @: Lmx p 0\n    @: void cell 0\n    @: LmxArrayDesc text 0\n    if: t = 0 || a = 0 || lmx_arena_open(a) != 0\n        l2_send_fail()\n", l2_out) < 0
        return: 1
    j: 0
    while: j < nf
        if: kind_arr[k * 16 + j] = 1
            ni: ni + 1
        ---
        j: j + 1
    ---
    if: c.fprintf(l2_out, "    if: nargs != %dU || (nargs != 0U && refs = 0)\n        l2_send_fail()\n    m: (cast: (@: LmxMsg) lmx_arena_take(a, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))\n    g: lmx_node_new_owned(a)\n    p: lmx_node_new_owned(a)\n    if: m = 0 || g = 0 || p = 0 || lmx_arena_refs_open_owned(a, g, 2U) != 0 || lmx_arena_refs_open_owned(a, p, %dU) != 0\n        l2_send_fail()\n", (ni + has_ref), nf) < 0
        return: 1
    ni: 0
    j: 0
    while: j < nf
        t: text_arr[k * 16 + j]
        if: kind_arr[k * 16 + j] = 1 && c.fprintf(l2_out, "    cell: lmx_int_new_owned(a)\n    if: cell = 0 || refs[%d] = 0 || lmx_int_store_known(cell, lmx_int_value_known(refs[%d])) != 0 || lmx_arena_ref_store(p, %dU, cell) != 0\n        l2_send_fail()\n", ni, ni, j) < 0
            return: 1
        if: kind_arr[k * 16 + j] = 1
            ni: ni + 1
        ---
        if: kind_arr[k * 16 + j] = 2 && c.fprintf(l2_out, "    text: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_CHAR, %uU, a)\n    if: text = 0 || lmx_arena_ref_store(p, %dU, (cast: (@: void) text)) != 0\n        l2_send_fail()\n", (cast: (unsigned) (t\length - 2U)), j) < 0
            return: 1
        if: kind_arr[k * 16 + j] = 2 && t\length > 2U && c.fprintf(l2_out, "    memcpy(text\\data, (cast: (@: void) %.*s), %uU)\n", (cast: (int) t\length), t\data, (cast: (unsigned) (t\length - 2U))) < 0
            return: 1
        j: j + 1
    ---
    # The sender slot is a pointer CELL holding the current Message's address, not the address
    # itself (FABLE-SONNET-SEND-REF-20260925-172 commit 4, author's Q26.2 ruling: a reference is a
    # reference TO a reference -- storing the raw address directly would make the sender a CHILD of
    # the letter, and its domain would then disagree with a receiving field's own prototype cell at
    # admission, D-56's real cause). Same shape D-52's kind-10/11 cells use: LMX_TYPE_POINTER_BASE +
    # 29 (LmxMsg, l2_kernel_ptr_word's own code) so a receiver's `m\sender` field agrees.
    if: fputs("    cell: lmx_pointer_new_owned(c.LMX_TYPE_POINTER_BASE + 29, a)\n    if: cell = 0 || lmx_pointer_store_known(cell, (cast: (@: void) lmx_thread_message(t))) != 0 || lmx_arena_ref_store(g, 0U, cell) != 0 || lmx_arena_ref_store(g, 1U, (cast: (@: void) p)) != 0\n        l2_send_fail()\n    m\\running: 1\n    m\\success: 0\n    m\\handoff_ready: 0\n    m\\graph: g\n", l2_out) < 0
        return: 1
    if: has_ref != 0
        if: c.fprintf(l2_out, "    if: lmx_service_post(lmx_child_service(t), refs[%d], m, a) != c.LMX_SERVICE_OK\n        l2_send_fail()\n    return: 0\n", ni) < 0
            return: 1
        ---
    else:
        if: fputs("    if: lmx_service_post(lmx_child_service(t), (cast: (@: void) lmx_thread_parent(t)), m, a) != c.LMX_SERVICE_OK\n        l2_send_fail()\n    return: 0\n", l2_out) < 0
            return: 1
        ---
    ---
return: (cast: (int) (c.fprintf(l2_out, "end: %s%d\n\n", prefix, k) < 0))

# `return: V` in the method being built (-193 T4a): [ret, V], V of the method's result type -- the
# type of its result cell (l2_ret_cell_ty).
fn: l2_rw_ret (@: LmP0Field first; int: n; int: into; @: int out) int
    int: v
    if: l2_rw_frame(into, "LMX_WALK_OP_RET", 2, out) != 0 || l2_rw_texpr(first, n, l2_ret_cell_ty(l2_rw_mi), \out, @ v) != 0
        return: 1
return: l2_rw_put(\out, 1, v)

# A body of the walker (an if's or an else's) under node `parent` at slot `slot`: a plain
# Structure whose children are its steps.
fn: l2_rw_body (@: LmP0Field first; int: parent; int: slot) int
    int: n 0
    int: t
    int: made 0
    c.array: [32]: char pn
    # Its size is needed only when it is written: the count pass counts a body's steps where it builds
    # them (l2_rw_stmts below).  Asking l2_rw_count there too counted each nesting level's body twice,
    # 2^depth in all (-193 T4a: a method's 70 nested ifs, l2src/tests/unit_deepif.lm2).
    if: l2_rw_emit != 0
        n: l2_rw_count(first)
        if: n < 0
            return: 1
    ---
    t: l2_rw_t
    l2_rw_t: l2_rw_t + 1
    if: l2_rw_emit != 0
        l2_rw_name(parent, pn)
        if: c.fprintf(l2_out, "        @: Lmx l2_rw%d lmx_walk_plain(l2_program_arena, %s, %dU)\n        if: l2_rw%d = 0\n            return: 1\n", t, pn, n, t) < 0
            return: 1
        ---
    ---
    if: l2_rw_stmts(first, t, 0, @ made) != 0 || l2_rw_put(parent, slot, t) != 0
        return: 1
return: 0

# A body, as l2_rw_body, that ends with the k flag steps l2_rw_pre[pbase ..] (a while's condition,
# -196): they run again after the body's own steps.
fn: l2_rw_body_pre (@: LmP0Field first; int: parent; int: slot; int: pbase; int: k) int
    int: n 0
    int: t
    int: j
    int: made 0
    if: l2_rw_emit != 0
        n: l2_rw_count(first)
        if: n < 0
            return: 1
    ---
    if: l2_rw_plain(parent, n + k, @ t) != 0
        return: 1
    if: l2_rw_stmts(first, t, 0, @ made) != 0
        return: 1
    j: 0
    while: j < k
        if: l2_rw_put(t, n + j, l2_rw_pre[pbase + j]) != 0
            return: 1
        j: j + 1
    ---
return: l2_rw_put(parent, slot, t)

# Statement `field`: its step (if it makes one) goes to container `into` at slot `slot`, and
# `made` says whether one was made; `next` is the field after the statement.
fn: l2_rw_stmt (@: LmP0Field field; @@: LmP0Field next; int: into; int: slot; @: int made) int
    size_t: eix 0U
    @: LmP0Node stmt
    @: LmP0Text h
    @: LmP0Field f
    @: LmP0Field cond
    @: LmP0Field last
    @: LmP0Field els
    int: n
    int: k
    int: t
    int: node
    int: oi
    int: idx
    int: bsave 0
    c.array: [32]: char pn
    \made: 0
    stmt: field\value
    \next: l2_next_active(field\next)
    l2_rw_name(into, pn)
    # An expression statement: a run of fields read as one expression.  A string literal alone
    # has nothing to evaluate (natively it is dropped, l2_eval_discard): it makes no step
    # (FABLE-OPUS-ROOT-CLASSES-20260926-196).
    n: l2_discard_run(field)
    if: n = 1 && stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && stmt\as != 0 && l2_quoted(stmt\as\atom) != 0
        return: 0
    if: n > 0
        \next: l2_skip_span(field, n)
        if: l2_rw_expr(field, n, into, @ t) != 0
            return: 1
        \made: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, t) < 0
            return: 1
        return: 0
    if: stmt\kind = c.LM_P0_NODE_ATOM && stmt\as != 0
        h: stmt\as\atom
        if: l2_text_eq(h, "return")
            \made: 1
            if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, lmx_arena_ref_value(l2_rw_roles, (cast: (size_t) c.LMX_WALK_OP_RET))) != 0\n            return: 1\n", pn, slot) < 0
                return: 1
            return: 0
        if: l2_text_eq(h, "break") || l2_text_eq(h, "continue")
            if: l2_rw_loops = 0
                return: l2_rw_refuse(stmt, "break and continue")
            if: l2_text_eq(h, "break") && l2_rw_frame(into, "LMX_WALK_OP_BREAK", 1, @ node) != 0
                return: 1
            if: l2_text_eq(h, "continue") && l2_rw_frame(into, "LMX_WALK_OP_CONTINUE", 1, @ node) != 0
                return: 1
            \made: 1
            if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
                return: 1
            return: 0
        return: l2_rw_refuse(stmt, "this statement")
    # An anonymous block (`---`, `( ... )`) is a nested executable body, as natively (§14, Q14 K;
    # l2_emit_stmts): a step IF(LIT 1, body), the if role running a plain body.  One with nothing
    # to run (l2_body_inert) makes no step.
    if: stmt\kind = c.LM_P0_NODE_STRUCTURE
        if: stmt\as = 0 || stmt\as\structure = 0 || l2_body_inert(stmt\as\structure, l2_rw_mi) != 0
            return: 0
        if: l2_rw_frame(into, "LMX_WALK_OP_IF", 3, @ node) != 0 || l2_rw_lit(node, 1, @ t) != 0 || l2_rw_put(node, 1, t) != 0
            return: 1
        if: l2_rw_enter(stmt, @ bsave) != 0
            return: 1
        if: l2_rw_body(stmt\as\structure\first_field, node, 2) != 0
            l2_rw_leave(bsave)
            return: 1
        if: l2_rw_leave(bsave) != 0
            return: 1
        \made: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
            return: 1
        return: 0
    if: stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0
        return: l2_rw_refuse(stmt, "this statement")
    h: stmt\as\frame\head
    if: l2_text_eq(h, "return")
        if: stmt\as\frame\body != 0 && l2_count_active(stmt\as\frame\body) != 0
            if: l2_rw_mi = l2_e
                return: l2_error(l2_src, stmt, "return with a value at the root")
            # A method keeps its value returns (-193 T4a): [ret, V].
            if: l2_rw_ret(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), into, @ node) != 0
                return: 1
            \made: 1
            if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
                return: 1
            return: 0
        \made: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, lmx_arena_ref_value(l2_rw_roles, (cast: (size_t) c.LMX_WALK_OP_RET))) != 0\n            return: 1\n", pn, slot) < 0
            return: 1
        return: 0
    if: h != 0 && h\length > 2U && h\data[0] = 99 && h\data[1] = 46
        return: l2_rw_l2(stmt)
    if: l2_text_eq(h, "sizeof") || l2_text_eq(h, "cast") || l2_text_eq(h, "L2") || (h != 0 && h\length > 0U && (h\data[0] = 64 || h\data[0] = 92))
        return: l2_rw_l2(stmt)
    if: l2_text_eq(h, "if")
        # The condition is every field before the last, which is the body; an `else` follows as
        # the next statement.
        last: 0
        n: 0
        f: l2_next_active(stmt\as\frame\body\first_field)
        cond: f
        while: f != 0
            last: f
            n: n + 1
            f: l2_next_active(f\next)
        ---
        if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || n < 2
            return: l2_rw_refuse(stmt, "this if")
        els: l2_next_active(field\next)
        if: els = 0 || els\value = 0 || l2_frame_head(els\value, "else") = 0
            els: 0
        k: 3
        if: els != 0
            k: 4
        ---
        if: l2_rw_frame(into, "LMX_WALK_OP_IF", k, @ node) != 0
            return: 1
        if: l2_rw_expr(cond, n - 1, node, @ t) != 0 || l2_rw_put(node, 1, t) != 0
            return: 1
        # The root does not push this scope: a second receiveMessage inside a
        # while stays the root field (unit_next_message_loop). A method does.
        # The body's catches stay visible through l2_rw_cblk.
        if: l2_rw_mi != l2_e && l2_rw_enter(last\value, @ bsave) != 0
            return: 1
        if: l2_rw_mi = l2_e && l2_rw_cblk_push(last\value\as\structure) != 0
            return: 1
        if: l2_rw_body(last\value\as\structure\first_field, node, 2) != 0
            if: l2_rw_mi != l2_e
                l2_rw_leave(bsave)
            if: l2_rw_mi = l2_e
                l2_rw_cblk_pop()
            return: 1
        if: l2_rw_mi = l2_e
            l2_rw_cblk_pop()
        if: l2_rw_mi != l2_e && l2_rw_leave(bsave) != 0
            return: 1
        if: els != 0
            if: els\value\as\frame\body = 0
                return: l2_rw_refuse(els\value, "this else")
            if: l2_rw_mi != l2_e && l2_rw_enter(els\value, @ bsave) != 0
                return: 1
            if: l2_rw_mi = l2_e && l2_rw_cblk_push(els\value\as\frame\body) != 0
                return: 1
            if: l2_rw_body(els\value\as\frame\body\first_field, node, 3) != 0
                if: l2_rw_mi != l2_e
                    l2_rw_leave(bsave)
                if: l2_rw_mi = l2_e
                    l2_rw_cblk_pop()
                return: 1
            if: l2_rw_mi = l2_e
                l2_rw_cblk_pop()
            if: l2_rw_mi != l2_e && l2_rw_leave(bsave) != 0
                return: 1
            \next: l2_next_active(els\next)
        ---
        \made: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
            return: 1
        return: 0
    if: l2_text_eq(h, "else")
        return: l2_rw_refuse(stmt, "an else without its if")
    # `while: c` + body (-196): WHILE(c, body), the walker's while role.  The condition's flag steps
    # (l2_rw_sc) run before the loop, as any statement's do, and again at the end of each turn of the
    # body, so the condition is known afresh each time it is asked.
    if: l2_text_eq(h, "while")
        last: 0
        n: 0
        f: l2_next_active(stmt\as\frame\body\first_field)
        cond: f
        while: f != 0
            last: f
            n: n + 1
            f: l2_next_active(f\next)
        ---
        if: last = 0 || last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || n < 2
            return: l2_rw_refuse(stmt, "this while")
        k: l2_rw_pre_n
        if: l2_rw_frame(into, "LMX_WALK_OP_WHILE", 3, @ node) != 0
            return: 1
        if: l2_rw_expr(cond, n - 1, node, @ t) != 0 || l2_rw_put(node, 1, t) != 0
            return: 1
        if: l2_rw_mi != l2_e && l2_rw_enter(last\value, @ bsave) != 0
            return: 1
        if: l2_rw_mi = l2_e && l2_rw_cblk_push(last\value\as\structure) != 0
            return: 1
        l2_rw_loops: l2_rw_loops + 1
        if: l2_rw_body_pre(last\value\as\structure\first_field, node, 2, k, l2_rw_pre_n - k) != 0
            l2_rw_loops: l2_rw_loops - 1
            if: l2_rw_mi != l2_e
                l2_rw_leave(bsave)
            if: l2_rw_mi = l2_e
                l2_rw_cblk_pop()
            return: 1
        l2_rw_loops: l2_rw_loops - 1
        if: l2_rw_mi = l2_e
            l2_rw_cblk_pop()
        if: l2_rw_mi != l2_e && l2_rw_leave(bsave) != 0
            return: 1
        \made: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
            return: 1
        return: 0
    ---
    if: l2_text_eq(h, "for") || l2_text_eq(h, "until")
        return: l2_rw_refuse(stmt, "a loop")
    if: l2_text_eq(h, "catch")
        return: l2_rw_catch_stmt(stmt, into, slot, made)
    if: l2_text_eq(h, "throw") || l2_text_eq(h, "throws")
        return: l2_rw_refuse(stmt, "throw and catch")
    # receiveMessage takes the current Thread's next letter (l2_rw_take, -179).  A method the unit
    # declares under that name takes precedence, as every callable head does
    # (l2_receive_msg_shape): its call is built below (-176).
    # A method's mail and its `Model: m` stay native in this slice (-193 T4a): the take's and the
    # send's records are the root's, and a method has its own send path (l2_msend, -168).
    if: l2_rw_mi != l2_e && ((l2_text_eq(h, "receiveMessage") && l2_find_method(h) < 0) || l2_text_eq(h, "sendMessage"))
        return: l2_rw_refuse(stmt, "mail in a method")
    if: l2_text_eq(h, "receiveMessage") && l2_find_method(h) < 0
        if: l2_rw_take(stmt, into, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
            return: 1
        return: 0
    if: l2_text_eq(h, "sendMessage")
        if: l2_rw_send(stmt, into, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
            return: 1
        return: 0
    if: l2_text_eq(h, "implements")
        return: l2_rw_refuse(stmt, "implements")
    # `[]: T x n`, an own Array of the body (-170): the graph build makes its descriptor in the
    # field's slot, as natively; nothing runs.
    if: l2_text_eq(h, "[]")
        oi: 0
        while: oi < l2_own_n && (l2_own_decl[oi] != stmt || l2_own_mi[oi] != l2_rw_mi)
            oi: oi + 1
        ---
        if: oi < l2_own_n && l2_own_host[oi] = 0 && l2_own_fid[oi] < 0 && l2_own_uchild[oi] >= 0 && l2_rw_elem_ty(oi) >= 0 && stmt\as\frame\body != 0 && l2_count_active(stmt\as\frame\body) = 3
            return: 0
        return: l2_rw_refuse(stmt, "an array")
    # A declaration of the root's own field: a number (int, char, size_t, unsigned, ulong), set by
    # its initializer if it has one.
    if: l2_prim_type_word(h) != 0
        if: l2_text_eq(h, "int") = 0 && l2_text_eq(h, "char") = 0 && l2_text_eq(h, "size_t") = 0 && l2_text_eq(h, "unsigned") = 0 && l2_text_eq(h, "ulong") = 0
            # A type word names a Structure too (`Model: m`, l2_ptr_type_word): m takes a fresh
            # merge of Model (-178).
            if: l2_ns_find(h) >= 0 && l2_rw_mi != l2_e
                return: l2_rw_refuse(stmt, "a Structure-typed field in a method")
            if: l2_ns_find(h) >= 0
                if: l2_rw_model(stmt, h, into, @ node) != 0
                    return: 1
                \made: 1
                if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
                    return: 1
                return: 0
            return: l2_rw_refuse(stmt, "a value that is not a number")
        f: l2_next_active(stmt\as\frame\body\first_field)
        if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
            return: l2_rw_refuse(stmt, "this declaration")
        oi: 0
        while: oi < l2_own_n && (l2_own_decl[oi] != stmt || l2_own_mi[oi] != l2_rw_mi)
            oi: oi + 1
        ---
        if: oi >= l2_own_n
            return: l2_rw_refuse(stmt, "this declaration")
        if: (l2_own_host[oi] != 0 || l2_own_fid[oi] >= 0) && (l2_rw_is_hosted(oi) = 0 || l2_rw_mi = l2_e)
            return: l2_rw_refuse(stmt, "a field declared in a nested body")
        if: l2_rw_is_hosted(oi) = 0 && (l2_rw_num_ty(l2_own_ty[oi]) = 0 || l2_own_uchild[oi] < 0)
            return: l2_rw_refuse_ty(stmt, oi)
        f: l2_next_active(f\next)
        if: f = 0
            # T4b class 2: `int: n` with no initializer, n a formal, carries the argument.
            # Class 3: the same carry into a field declared in the nested body.
            if: l2_rw_formal_slot(l2_own_name[oi]) = oi
                if: l2_rw_is_hosted(oi) != 0 && l2_rw_host_carry(into, oi, @ node) != 0
                    return: 1
                if: l2_rw_is_hosted(oi) = 0 && l2_rw_carry(into, oi, @ node) != 0
                    return: 1
                if: l2_rw_bseq_mark(oi) != 0
                    return: 1
                \made: 1
                if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
                    return: 1
            ---
            return: 0
        n: 0
        cond: f
        while: f != 0
            n: n + 1
            f: l2_next_active(f\next)
        ---
        # The declaration's own row is invisible to its own initializer (Q24, D-48; l2_own_excl, as
        # natively): `int: x (x + 2)` after `int: x 1` reads the first x.
        l2_own_excl: oi
        k: l2_rw_assign(into, oi, cond, n, @ node)
        l2_own_excl: 0 - 1
        if: k != 0
            return: 1
        if: l2_rw_formal_slot(l2_own_name[oi]) = oi && l2_rw_bseq_mark(oi) != 0
            return: 1
        \made: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
            return: 1
        return: 0
    # A call statement.
    idx: l2_find_method(h)
    if: idx >= 0 && idx != l2_e
        if: l2_rw_call(stmt, idx, stmt\as\frame\body\first_field, into, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
            return: 1
        return: 0
    # `x[i]: v` into an own Array's element (-170): ELEMPUT.
    # D-39: i a size_t field is that field's AT, not a literal. An int index is not cast.
    oi: l2_rw_elem_of(h, @ eix)
    k: 0 - 1
    if: oi < 0
        idx: l2_dyn_own_index(l2_rw_mi, h, @ oi, @ k)
        if: idx = 2
            return: l2_rw_refuse(stmt, "mixed numeric types (a conversion)")
        if: idx != 1
            oi: 0 - 1
    ---
    if: oi >= 0
        n: 0
        if: stmt\as\frame\body != 0
            n: l2_count_active(stmt\as\frame\body)
        if: n < 1
            return: l2_rw_refuse(stmt, "this assignment")
        if: l2_rw_elemput(into, oi, k, eix, stmt\as\frame\body\first_field, n, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
            return: 1
        return: 0
    # A write through a path `a\b...: v` (-178).
    if: l2_rw_has_slash(h) != 0
        if: stmt\as\frame\body = 0
            return: l2_rw_refuse(stmt, "this assignment")
        if: l2_rw_path_write(stmt, h, stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), into, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
            return: 1
        return: 0
    # A merge result `R: merge: A B ... [body]` (-193 T3): the root's step; a method's merge stays
    # native (its method throws `merge`, outside the walkable subset).
    if: l2_rw_mi = l2_e && l2_merge_frame(stmt) != 0 && l2_mres_find(h) >= 0
        if: l2_rw_merge(stmt, l2_mres_find(h), into, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
            return: 1
        return: 0
    # A declaration by an empty frame (`f()`, `f: ()`): the root's own field it declares is a
    # field of the unit, and nothing runs.
    oi: 0
    while: oi < l2_own_n && (l2_own_decl[oi] != stmt || l2_own_mi[oi] != l2_rw_mi)
        oi: oi + 1
    ---
    if: oi < l2_own_n && (stmt\as\frame\body = 0 || l2_count_active(stmt\as\frame\body) = 0)
        return: 0
    # A declaration of a root field that is not a number (`Model: m`): what it is.
    if: oi < l2_own_n && l2_rw_num_ty(l2_own_ty[oi]) = 0
        return: l2_rw_refuse_ty(stmt, oi)
    # `f()` when f already binds an ordinary Structure (l2_empty_struct_assign_shape = 1;
    # the book §12). A declared type admits through l2_rw_admit. No declared type stores the
    # fresh empty node itself (PUT / PUT_REF of FRESH).
    if: l2_empty_struct_assign_shape(stmt, l2_rw_mi) = 1
        if: l2_rw_empty_assign(stmt, into, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
            return: 1
        return: 0
    # An assignment into a reference field (-179): of a declared Structure type it admits the value
    # first -- the caller's implicit `implements` (D-55); an untyped one takes the reference.
    oi: l2_rw_find(h)
    if: l2_rw_seen(oi) != 0 && l2_own_host[oi] = 0 && l2_own_fid[oi] < 0 && l2_own_uchild[oi] >= 0 && l2_own_is_pointer(l2_own_ty[oi]) != 0
        if: l2_own_nsty_get(oi) >= 0
            if: l2_rw_admit_assign(stmt, oi, into, @ node) != 0
                return: 1
            \made: 1
            if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
                return: 1
            return: 0
        ---
        return: l2_rw_refuse(stmt, "a reference assignment")
    ---
    # An assignment of the root's own numeric field. A field declared in the
    # nested body is still that body's cell (class 3). A bare write of a formal
    # is the method's cell, including from inside the body (D-79).
    oi: l2_rw_own_row(stmt, h)
    if: oi = 0 - 1
        return: 1
    if: oi >= 0
        n: l2_count_active(stmt\as\frame\body)
        if: n < 1
            return: l2_rw_refuse(stmt, "this assignment")
        if: l2_rw_assign(into, oi, stmt\as\frame\body\first_field, n, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
            return: 1
        return: 0
    # T4b class 2: the first store of a formal's numeric field. The value was read while the
    # name was still the argument; the field is bound from the next line.
    oi: l2_rw_formal_slot(h)
    if: oi >= 0
        n: l2_count_active(stmt\as\frame\body)
        if: n < 1
            return: l2_rw_refuse(stmt, "this assignment")
        if: l2_rw_assign(into, oi, stmt\as\frame\body\first_field, n, @ node) != 0
            return: 1
        if: l2_rw_bseq_mark(oi) != 0
            return: 1
        \made: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
            return: 1
        return: 0
    if: l2_ns_find(h) >= 0 || (stmt\as\frame\body != 0 && stmt\as\frame\body\first_field != 0 && l2_frame_head(stmt\as\frame\body\first_field\value, "merge") != 0)
        return: l2_rw_refuse(stmt, "a Structure value")
return: l2_rw_refuse(stmt, "this statement")

# A statement list from `first`: each step goes to container `into` at base + k; `made` counts
# them.  `into` -2 is the count pass's container, which nothing is stored into.
fn: l2_rw_stmts (@: LmP0Field first; int: into; int: base; @: int made) int
    @: LmP0Field field
    @: LmP0Field next
    int: one
    int: pbase
    if: l2_rw_pads(first, into) != 0
        return: 1
    field: l2_next_active(first)
    while: field != 0
        pbase: l2_rw_pre_n
        if: l2_rw_stmt(field, @ next, into, base + \made, @ one) != 0
            return: 1
        if: l2_rw_pre_n > pbase && l2_rw_pre_place(into, base + \made, one, pbase, l2_rw_pre_n - pbase) != 0
            return: 1
        \made: \made + one + l2_rw_pre_n - pbase
        l2_rw_pre_n: pbase
        field: next
    ---
return: 0

# The k flag steps a statement made (l2_rw_pre from pbase, -196) run before it: its `one` steps at
# slot s of `into` move up by k, and the flag steps take slots s .. s + k - 1.
fn: l2_rw_pre_place (int: into; int: s; int: one; int: pbase; int: k) int
    c.array: [32]: char pn
    int: j
    if: l2_rw_emit = 0
        return: 0
    l2_rw_name(into, pn)
    j: one - 1
    while: j >= 0
        if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, lmx_arena_ref_value(%s, %dU)) != 0\n            return: 1\n", pn, s + k + j, pn, s + j) < 0
            return: 1
        j: j - 1
    ---
    j: 0
    while: j < k
        if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, s + j, l2_rw_pre[pbase + j]) < 0
            return: 1
        j: j + 1
    ---
return: 0

# THE WALKED METHODS (-193 T4a; steps/merge-parts-193.md §6, §9).  The body of a method is built
# as walker frames too, by the same l2_rw_* (l2_rw_mi names the method): M's own children after its
# fields and control bodies, so no field slot moves and the native code is unchanged.
#   * a formal j is its input, [arg, j]; `return: V` is [ret, V], and the return trailer one more
#     step at the end;
#   * a method's own field is a cell of the activation's data, holder 0 (K-OT2); a unit field it
#     sees stays the unit's;
#   * a call that can re-enter the method passes [fresh, code] as its data (l2_reenters).
# Every method whose body is in the walkable subset gets its frames, always (fable's Q4); its
# native word stays, so every call of it stays native, but under the test knob `--walk-methods`
# (native 0).  A method outside the subset gets none, and nothing is said: its body is only tried
# (l2_rw_quiet); the refusal comes where a walk is needed.
# Its shape first (l2_rw_may): a method with a native body, no dynamic inputs and no throw, a result
# that is a number (int, size_t, unsigned, ulong) or none, number formals or a Structure formal
# (`T: m` and `@: T m`, T4b class 1), and own fields that are neither a non-numeric field
# declared in a nested body nor, unless it is a number, named like a formal (T4b class 2).
# A numeric field declared in a nested body is class 3. A callable formal and any other
# non-number formal stay out. A catch parameter stays out.
fn: l2_rw_may (int: mi) int
    int: j 0
    int: oi 0
    int: cls
    if: mi < 0 || mi = l2_e || mi >= l2_m_n || l2_m_native(mi) = 0
        return: 0
    if: l2_m_dyn[mi] != 0 || (l2_m_throws != 0 && l2_m_throws[mi] != 0)
        return: 0
    cls: l2_tramp_class(mi)
    if: l2_m_ret[mi] != 8 && (cls < 1 || cls > 4)
        return: 0
    while: j < l2_m_arity[mi]
        if: l2_cf_get(mi, j) >= 0
            return: 0
        if: l2_nsty_get(mi, j) < 0 && l2_rw_num_ty(l2_own_ty_of_param(l2_ft(mi, j))) = 0
            return: 0
        j: j + 1
    ---
    while: oi < l2_own_n
        # Class 3 admits a numeric field of a nested body. A catch parameter, an array
        # and a Structure field declared there still keep the method out.
        if: l2_own_mi[oi] = mi && l2_own_host[oi] != 0 && l2_rw_is_hosted(oi) = 0
            return: 0
        # A method-level numeric field named like a formal is class 2. A pointer or a
        # Structure field of that name stays out. A hosted numeric field is class 3.
        if: l2_own_mi[oi] = mi && l2_formal_find(mi, l2_own_name[oi]) >= 0 && l2_rw_is_hosted(oi) = 0 && (l2_rw_num_ty(l2_own_ty[oi]) = 0 || l2_own_uchild[oi] < 0)
            return: 0
        oi: oi + 1
    ---
return: 1

# Method mi's return trailer (its column-0 `return: V`), built at slot `slot` of `into`: one step,
# [ret, V] -- a `sub`'s bare `return` is the RET record --, behind the flag steps its value makes;
# `made` counts them all.  None without a trailer.
fn: l2_rw_trailer (int: mi; int: into; int: slot; @: int made) int
    @: LmP0Structure tr 0
    c.array: [32]: char pn
    int: node
    int: pbase l2_rw_pre_n
    \made: 0
    if: l2_m_node[mi] != 0 && l2_m_node[mi]\as != 0
        tr: l2_ret_tr(l2_m_node[mi]\as\frame)
    if: tr = 0
        return: 0
    l2_rw_name(into, pn)
    if: l2_count_active(tr) = 0
        \made: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, lmx_arena_ref_value(l2_rw_roles, (cast: (size_t) c.LMX_WALK_OP_RET))) != 0\n            return: 1\n", pn, slot) < 0
            return: 1
        return: 0
    if: l2_rw_ret(tr\first_field, l2_count_active(tr), into, @ node) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, node) < 0
        return: 1
    if: l2_rw_pre_n > pbase && l2_rw_pre_place(into, slot, 1, pbase, l2_rw_pre_n - pbase) != 0
        return: 1
    \made: 1 + l2_rw_pre_n - pbase
    l2_rw_pre_n: pbase
return: 0

# The count pass of every method (before the occurrences' widths are written): l2_m_steps[i], its
# steps, or -1 -- outside the walkable subset, or the library profile, whose root is not walked.
fn: l2_rw_methods_count () int
    int: i 0
    int: made
    int: one
    int: bad
    l2_m_steps: (cast: (@: int) calloc((cast: (size_t) (l2_m_n + 1)), c.sizeof(c.int)))
    if: l2_m_steps = 0
        return: l2_error(l2_src, 0, "out of memory")
    while: i < l2_m_n
        l2_m_steps[i]: 0 - 1
        if: l2_library_mode = 0 && l2_rw_may(i) != 0
            if: l2_rw_bseq_zero() != 0
                return: l2_error(l2_src, 0, "out of memory")
            l2_vis_method(i)
            l2_rw_mi: i
            l2_rw_quiet: 1
            l2_rw_emit: 0
            l2_rw_send_rec: 0
            made: 0
            one: 0
            bad: 0
            if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_m_body[i]\as\structure != 0 && l2_rw_stmts(l2_m_body[i]\as\structure\first_field, 0 - 2, 0, @ made) != 0
                bad: 1
            if: bad = 0 && l2_rw_trailer(i, 0 - 2, made, @ one) != 0
                bad: 1
            if: bad = 0
                l2_m_steps[i]: made + one
            l2_rw_quiet: 0
            l2_rw_pre_n: 0
            l2_rw_mi: l2_e
            l2_vis_on: 0
        ---
        i: i + 1
    ---
return: 0

# The emission of every method's frames, into its occurrence (a node temp, l2_rw<t>), from slot
# l2_m_kids(i): the same steps the count pass made.
fn: l2_rw_methods_emit () int
    int: i 0
    int: t
    int: made
    int: one
    int: bad
    while: i < l2_m_n
        if: l2_m_steps[i] > 0
            if: l2_rw_bseq_zero() != 0
                return: l2_error(l2_src, 0, "out of memory")
            l2_vis_method(i)
            l2_rw_mi: i
            l2_rw_emit: 1
            t: l2_rw_t
            l2_rw_t: l2_rw_t + 1
            made: 0
            one: 0
            bad: 0
            if: c.fprintf(l2_out, "        @: Lmx l2_rw%d lmx_arena_ref_struct(l2_entry_unit, %uU)\n        if: l2_rw%d = 0\n            return: 1\n", t, (cast: (unsigned) (l2_unit_base + i)), t) < 0
                bad: 1
            if: bad = 0 && l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_m_body[i]\as\structure != 0 && l2_rw_stmts(l2_m_body[i]\as\structure\first_field, t, l2_m_kids(i), @ made) != 0
                bad: 1
            if: bad = 0 && l2_rw_trailer(i, t, l2_m_kids(i) + made, @ one) != 0
                bad: 1
            l2_rw_emit: 0
            l2_rw_pre_n: 0
            l2_rw_mi: l2_e
            l2_vis_on: 0
            if: bad != 0
                return: 1
            if: made + one != l2_m_steps[i]
                return: l2_error(l2_src, l2_m_node[i], "internal: a method's steps changed between the passes")
        ---
        i: i + 1
    ---
return: 0

# The children of method mi's occurrence: its header parts, fields and control bodies (l2_m_kids),
# then its frames (-193 T4a).
fn: l2_m_width (int: mi) int
    if: l2_m_steps != 0 && mi >= 0 && mi < l2_m_n && l2_m_steps[mi] > 0
        return: l2_m_kids(mi) + l2_m_steps[mi]
return: l2_m_kids(mi)

# Public C/L1 adapter signature for a source method. The fixed lexical space
# above the method and selected occurrence remain internal ABI arguments and
# are therefore omitted.
fn: l2_emit_public_sig (int: mi) int
    int: j 0
    int: ty
    const: @(char sep) ""
    if: fputs(" (", l2_out) < 0
        return: 1
    while: j < l2_m_arity[mi]
        ty: l2_ft(mi, j)
        if: j != 0
            sep: "; "
        if: ty = 0 && c.fprintf(l2_out, "%sint: ", sep) < 0
            return: 1
        if: ty = 1 && c.fprintf(l2_out, "%schar: ", sep) < 0
            return: 1
        if: ty = 2 && c.fprintf(l2_out, "%ssize_t: ", sep) < 0
            return: 1
        if: ty = 34 && c.fprintf(l2_out, "%sunsigned: ", sep) < 0
            return: 1
        if: ty = 36 && c.fprintf(l2_out, "%sulong: ", sep) < 0
            return: 1
        if: ty = 3 && c.fprintf(l2_out, "%sconst: @(char ", sep) < 0
            return: 1
        if: ty = 9 && c.fprintf(l2_out, "%s@: size_t ", sep) < 0
            return: 1
        if: ty = 11 && c.fprintf(l2_out, "%s@: int ", sep) < 0
            return: 1
        if: ty = 12 && c.fprintf(l2_out, "%s@: char ", sep) < 0
            return: 1
        if: ty = 16 && c.fprintf(l2_out, "%s@: void ", sep) < 0
            return: 1
        if: ty = 17 && c.fprintf(l2_out, "%s@@: char ", sep) < 0
            return: 1
        if: ty = 18 && c.fprintf(l2_out, "%s@@: void ", sep) < 0
            return: 1
        if: ty = 19 && c.fprintf(l2_out, "%s@@: int ", sep) < 0
            return: 1
        if: ty = 20 && c.fprintf(l2_out, "%s@@: size_t ", sep) < 0
            return: 1
        if: ty = 24 && c.fprintf(l2_out, "%s@@: unsigned ", sep) < 0
            return: 1
        if: ty = 39 && c.fprintf(l2_out, "%s@@: ulong ", sep) < 0
            return: 1
        if: ty = 25 && c.fprintf(l2_out, "%s@: unsigned ", sep) < 0
            return: 1
        if: ty = 38 && c.fprintf(l2_out, "%s@: ulong ", sep) < 0
            return: 1
        if: ty = 26 && c.fprintf(l2_out, "%s@@: LmxArenaBlock ", sep) < 0
            return: 1
        if: ty = 27 && c.fprintf(l2_out, "%s@@: LmxOwnedRange ", sep) < 0
            return: 1
        if: ty = 28 && c.fprintf(l2_out, "%s@: LmxRoot ", sep) < 0
            return: 1
        if: ty = 29 && c.fprintf(l2_out, "%sconst: @(LmxMsg ", sep) < 0
            return: 1
        if: ty = 30 && c.fprintf(l2_out, "%sconst: @(unsigned ", sep) < 0
            return: 1
        if: ty = 31 && c.fprintf(l2_out, "%s@@: unsigned ", sep) < 0
            return: 1
        if: ty = 6 && c.fprintf(l2_out, "%sconst: @(L2ImmutQuery ", sep) < 0
            return: 1
        if: ty = 7 && c.fprintf(l2_out, "%s@: L2ImmutQuery ", sep) < 0
            return: 1
        if: ty >= 100
            if: l2_emit_foreign_named(l2_out, ty, sep, l2_fn(mi, j)) != 0
                return: 1
            ---
        else:
            if: ty != 0 && ty != 1 && ty != 2 && ty != 3 && ty != 4 && ty != 5 && ty != 6 && ty != 7 && ty != 9 && ty != 10 && ty != 11 && ty != 12 && ty != 13 && ty != 14 && ty != 15 && ty != 16 && ty != 17 && ty != 18 && ty != 19 && ty != 20 && ty != 24 && ty != 25 && ty != 26 && ty != 27 && ty != 28 && ty != 29 && ty != 30 && ty != 31 && ty != 34 && ty != 36 && ty != 38 && ty != 39
                c.fprintf(l1_stderr(), "l2trans: a library signature cannot spell formal type %d\n", ty)
                return: 1
            if: l2_write_text(l2_out, l2_fn(mi, j)) != 0
                return: 1
            if: (ty = 3 || ty = 4 || ty = 6 || ty = 15 || ty = 28 || ty = 29 || ty = 30) && fputs(")", l2_out) < 0
                return: 1
        ---
        j: j + 1
    ---
    if: l2_m_ret[mi] = 2 && fputs(") size_t", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 30 && fputs(") unsigned", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 33 && fputs(") unsigned", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 36 && fputs(") ulong", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 3 && fputs(") @: char", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 16 && fputs(") @: void", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 35 && fputs(") const: @(char)", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] = 32 && fputs(") @@: char", l2_out) < 0
        return: 1
    if: l2_m_ret[mi] >= 100 && l2_emit_foreign_return(l2_out, l2_m_ret[mi]) != 0
        return: 1
    if: l2_m_ret[mi] = 8 && fputs(")", l2_out) < 0
        return: 1
    if: l2_ret_uns(mi) = 0 && l2_m_ret[mi] != 3 && l2_m_ret[mi] != 5 && l2_m_ret[mi] != 8 && l2_m_ret[mi] != 10 && l2_m_ret[mi] != 13 && l2_m_ret[mi] != 16 && l2_m_ret[mi] != 32 && l2_m_ret[mi] != 35 && l2_m_ret[mi] < 100 && fputs(") int", l2_out) < 0
        return: 1
return: 0

fn: l2_emit_library_wrappers () int
    int: i 0
    int: j
    if: c.fprintf(l2_out, "\n@: LmxMsg l2_library_message 0\n@: Lmx l2_library_unit 0\nint: l2_library_opened 0\n\nfn: l2_library_open () int\n    LmxRoot: l2_library_root\n    if: l2_library_opened != 0\n        return: 0\n    memset((cast: (@: void) (@ l2_library_root)), 0, c.sizeof(c.LmxRoot))\n    if: lmx_root_open(@ l2_library_root, l2_program_entry, 5000U) != c.LMX_ROOT_OK\n        return: 1\n    l2_program_arena: lmx_root_arena(@ l2_library_root)\n    if: l2_program_arena = 0\n        lmx_root_close(@ l2_library_root)\n        return: 1\n    if: lmx_root_turn(@ l2_library_root, lmx_clock_ticks()) != c.LMX_ROOT_OK\n        lmx_root_close(@ l2_library_root)\n        return: 1\n    l2_library_message: lmx_root_message(@ l2_library_root)\n    if: l2_library_message = 0\n        lmx_root_close(@ l2_library_root)\n        return: 1\n    # TODO(kernel): no act returning the program-unit Lmx from root/message (see lmx_root.h.lm1 / lmx_message.h.lm1).\n    # Need approved act for l2_library_unit; also need persistent LmxRoot storage (by-value aggregate is illegal at module scope — currently local, so open cannot stay open across calls).\n    l2_library_unit: 0\n    if: l2_library_unit = 0\n        lmx_root_close(@ l2_library_root)\n        l2_library_message: 0\n        return: 1\n    l2_library_opened: 1\n    return: 0\n\n") < 0
        return: 1
    while: i < l2_m_n
        if: fputs("external:\n", l2_out) < 0
            return: 1
        if: l2_m_ret[i] = 8 && fputs("    sub: ", l2_out) < 0
            return: 1
        if: l2_m_ret[i] != 8 && fputs("    fn: ", l2_out) < 0
            return: 1
        if: l2_write_text(l2_out, l2_m_name[i]) != 0 || l2_emit_public_sig(i) != 0 || fputs("\n", l2_out) < 0
            return: 1
        if: fputs("        if: l2_library_open() != 0\n", l2_out) < 0
            return: 1
        # A failed open is reported on every call and then follows the abort
        # policy, exactly as a failed own-field store does; it is never
        # a silent zero.
        if: c.fprintf(l2_out, "            c.fprintf(c.stderr, \"lmx: library open failed: l2_u%08X%08X ", l2_module_hash_a, l2_module_hash_b) < 0 || l2_write_text(l2_out, l2_m_name[i]) != 0
            return: 1
        if: fputs("\\n\")\n            if: lmx_msg_poll_abort() != 0\n                c.abort()\n", l2_out) < 0
            return: 1
        if: l2_m_ret[i] = 8 && fputs("            return\n        ", l2_out) < 0
            return: 1
        if: l2_m_ret[i] = 2 && fputs("            return: 0U\n        return: ", l2_out) < 0
            return: 1
        if: l2_m_ret[i] != 2 && l2_m_ret[i] != 8 && fputs("            return: 0\n        return: ", l2_out) < 0
            return: 1
        if: l2_m_ret[i] = 8 && fputs("", l2_out) < 0
            return: 1
        if: l2_write_sym(l2_out, i) != 0 || c.fprintf(l2_out, "(l2_library_unit, lmx_arena_ref_struct(l2_library_unit, %uU)", (cast: (unsigned) (l2_unit_base + i))) < 0
            return: 1
        j: 0
        while: j < l2_m_arity[i]
            if: fputs(", ", l2_out) < 0 || l2_write_text(l2_out, l2_fn(i, j)) != 0
                return: 1
            j: j + 1
        if: fputs(")\n", l2_out) < 0
            return: 1
        if: fputs("end: external\n\n", l2_out) < 0
            return: 1
        i: i + 1
return: 0

fn: l2_has_own_ty (int: ty) int
    int: i 0
    while: i < l2_own_n
        if: l2_own_ty[i] = ty
            return: 1
        i: i + 1
return: 0

fn: l2_has_pointer_array () int
    int: i 0
    while: i < l2_own_n
        if: l2_own_ty[i] >= 2000
            return: 1
        i: i + 1
return: 0

fn: l2_emit_poll (int: mi; const: @(char ind)) int
    if: ind = 0 || l2_profile_runtime != 0
        return: 0
    if: l2_m_ret[mi] = 8 && (l2_m_throws = 0 || l2_m_throws[mi] = 0) && c.fprintf(l2_out, "%sif: lmx_msg_poll_escape() != 0\n%s    return\n", ind, ind) < 0
        return: 1
    if: l2_m_ret[mi] = 8 && l2_m_throws != 0 && l2_m_throws[mi] != 0 && c.fprintf(l2_out, "%sif: lmx_msg_poll_escape() != 0\n%s    return: 0\n", ind, ind) < 0
        return: 1
    if: l2_m_ret[mi] != 8 && c.fprintf(l2_out, "%sif: lmx_msg_poll_escape() != 0\n%s    return: 0\n", ind, ind) < 0
        return: 1
return: 0

# THE TYPE DESCRIPTOR OF AN OWN STORE.  What a store does with an own field depends on its type in
# exactly three ways, and they are answered here and nowhere else: which kernel operation puts a
# value into the field's cell, whether that operation REBINDS the cell (char) or stores into it,
# and how the value is spelled as that operation's argument.  0 from the first
# means the graph has no cell for the type -- an error of the program, not a type to skip.
fn: l2_own_store_helper (int: ty) @: char
    if: ty = 0
        return: "lmx_int_store_known"
    if: ty = 1
        return: "lmx_char_rebind_known"
    if: ty = 2
        return: "lmx_size_store_known"
    if: ty = 3
        return: "lmx_unsigned_store_known"
    if: ty = 36
        return: "lmx_ulong_store_known"
    if: l2_own_is_pointer(ty) != 0
        return: "lmx_pointer_store_known"
return: 0

fn: l2_own_store_rebinds (int: ty) int
    if: ty = 1
        return: 1
return: 0

fn: l2_emit_path_load (int: mi; int: oi; const: @(char ind); @: char dest) int
    int: t
    int: fid
    @: char deep 0
    c.array: [128]: char l2_epl_expr
    if: dest = 0 || oi < 0 || ind = 0
        return: 1
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    fid: l2_own_fid[oi]
    if: fid < 0 && l2_own_uchild[oi] < 0
        return: 1
    if: l2_own_from_expr(oi, l2_epl_expr) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_xp: %s\n", ind, l2_epl_expr) < 0
        return: 1
    if: c.fprintf(l2_out, "%sif: l2_xp = 0\n", ind) < 0
        return: 1
    # A missing cell of a bound own field is a broken promise (D-05): X1, not a return of 0.
    if: l2_emit_invariant(ind, "an own field has no cell to load") != 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_emit_own_cell_load(oi, ind, t, l2_own_decl[oi]) != 0
        return: 1
    if: c.sprintf(dest, "l2_t%d", t) < 0
        return: 1
return: 0

fn: l2_index_tail (@: LmP0Field f; @@: LmP0Field out_idx; @@: LmP0Field out_after) int
    @: LmP0Field p1
    @: LmP0Field p2
    @: LmP0Field p3
    if: out_idx = 0 || out_after = 0
        return: 1
    \out_idx: 0
    \out_after: 0
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
        return: 1
    if: l2_ident(f\value\as\atom) = 0
        return: 1
    p1: l2_next_active(f\next)
    if: p1 = 0 || p1\value = 0 || p1\value\kind != c.LM_P0_NODE_ATOM || p1\value\as = 0
        return: 1
    if: l2_text_eq(p1\value\as\atom, "[") = 0
        return: 1
    p2: l2_next_active(p1\next)
    if: p2 = 0 || p2\value = 0
        return: 1
    p3: l2_next_active(p2\next)
    if: p3 = 0 || p3\value = 0 || p3\value\kind != c.LM_P0_NODE_ATOM || p3\value\as = 0
        return: 1
    if: l2_text_eq(p3\value\as\atom, "]") = 0
        return: 1
    \out_idx: p2
    \out_after: l2_next_active(p3\next)
return: 0

# THE TEMPORARY RULE (FABLE-L2-R0-WRITE-GUARD-DESIGN-20260921-111).  An address taken with `@` is a WRITABLE
# address, and nothing downstream can refuse a write through it: a raw pointer write bypasses every cell
# helper.  So until a read-only address exists as a type, the address of a field of an
# `independent: const: immutable` branch is refused where it is TAKEN, by name, by the same test that
# refuses a path write to it (l2_path_in_eternal) -- no type is asked.  It used to pass the translator and
# die at the C compiler for want of a lowering, and a missing declaration is never protection.
fn: l2_addr_names_eternal (@: LmP0Field name; @: LmP0Field fld) int
    size_t: a
    size_t: b
    if: name = 0 || fld = 0 || name\value = 0 || fld\value = 0 || name\value\kind != c.LM_P0_NODE_ATOM || fld\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: name\value\as = 0 || fld\value\as = 0 || name\value\as\atom = 0 || fld\value\as\atom = 0
        return: 0
    a: name\value\as\atom\length
    b: fld\value\as\atom\length
    if: a = 0U || b = 0U || a + b + 1U >= 250U
        return: 0
    memcpy((cast: (@: void) l2_addr_path), (cast: (@: void) name\value\as\atom\data), a)
    l2_addr_path[a]: 92
    memcpy((cast: (@: void) (l2_addr_path + a + 1U)), (cast: (@: void) fld\value\as\atom\data), b)
return: l2_path_in_eternal(l2_addr_path, a + b + 1U)

# The flat spelling: `@`, a name, `\`, a field, as four fields of an argument list.
fn: l2_addr_flat_eternal (@: LmP0Field at) int
    @: LmP0Field name
    @: LmP0Field sep
    if: at = 0
        return: 0
    name: l2_next_active(at\next)
    if: name = 0
        return: 0
    sep: l2_next_active(name\next)
    if: sep = 0 || sep\value = 0 || sep\value\kind != c.LM_P0_NODE_ATOM || l2_is_slash(sep\value\as\atom) = 0
        return: 0
return: l2_addr_names_eternal(name, l2_next_active(sep\next))

fn: l2_addr_tail (@: LmP0Field f; @@: LmP0Field out_name; @@: LmP0Field out_after) int
    @: LmP0Field p1
    @: LmP0Field p2
    if: out_name = 0 || out_after = 0
        return: 1
    \out_name: 0
    \out_after: 0
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
        return: 1
    if: l2_text_eq(f\value\as\atom, "@") = 0
        return: 1
    p1: l2_next_active(f\next)
    if: p1 = 0 || p1\value = 0 || p1\value\kind != c.LM_P0_NODE_ATOM || p1\value\as = 0
        return: 1
    if: l2_ident(p1\value\as\atom) = 0
        return: 1
    # In `@ value\field`, address-taking covers the complete postfix path.
    # Do not consume only `@ value` and strand the following separator.
    p2: l2_next_active(p1\next)
    if: p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p2\value\as\atom)
        return: 1
    if: l2_ml_find(p1\value\as\atom) < 0
        return: 1
    \out_name: p1
    \out_after: p2
return: 0

fn: l2_ccall_box_int (const: @(LmP0Node node); int: mi) int
    int: ei
    int: fi
    int: oi
    int: si
    int: ty
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM || node\as = 0 || node\as\atom = 0
        return: 0
    if: l2_quoted(node\as\atom) != 0
        return: 0
    if: l2_num(node\as\atom)
        return: 0
    if: node\as\atom\length >= 2U && node\as\atom\data[0] = 99 && node\as\atom\data[1] = 46
        return: 0
    ei: l2_ml_find(node\as\atom)
    if: ei >= 0
        ty: l2_ml_ty[ei]
        if: ty = 0 || ty = 1
            return: 1
        return: 0
    ---
    fi: l2_param_find(mi, node\as\atom)
    if: fi >= 0
        ty: l2_param_ty(mi, node\as\atom)
        if: ty = 0 || ty = 1
            return: 1
        return: 0
    oi: l2_own_find_last(mi, node\as\atom)
    if: oi >= 0
        ty: l2_own_ty[oi]
        if: ty = 0 || ty = 1
            return: 1
        return: 0
    si: l2_slot_find(mi, node\as\atom)
    if: si >= 0
        ty: l2_st[l2_slot_off(mi, si)]
        if: ty = 0 || ty = 1
            return: 1
        return: 0
    ---
    # A `define:` constant (l2_define_name) is passed as itself (D-68): it holds no L2 value to
    # stage, and an `int` temporary cut a char* define to 32 bits -- the b5 mixa crash
    # unit_define_actual was written for, back until this.  Its type is C's, checked against
    # the callee's prototype, as `c.NAME`'s is.
    if: l2_define_name(node\as\atom) != 0
        return: 0
return: 1

fn: l2_emit_ccall (const: @(LmP0Node stmt); int: mi; const: @(char ind)) int
    int: array_own
    size_t: array_index
    int: array_count
    @: LmP0Field f
    @: LmP0Field p1
    @: LmP0Field p2
    int: n
    int: i
    int: span
    int: si
    int: po
    int: hj
    int: hf
    size_t: root_len
    size_t: suffix_len
    int: first 1
    c.array: [1024]: char buf
    c.array: [1024]: char piece
    # The boxed-actual temporary name. l2_tok may be the caller's destination.
    c.array: [1024]: char boxt
    # The value destination of THIS call; a nested C call in an actual
    # takes and clears its own.
    @: char into_buf
    into_buf: l2_ccall_into
    l2_ccall_into: 0
    if: stmt = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0
        return: 1
    buf[0]: 0
    hj: -1
    hf: -1
    if: l2_raw_head(stmt\as\frame\head, mi, @ hj, @ hf) = 0 && hf = 5 && hj < l2_m_arity[mi]
        if: c.sprintf(buf, "l2_p%d_%d", mi, hj) < 0
            return: 1
        root_len: l2_fn(mi, hj)\length
        if: root_len >= stmt\as\frame\head\length
            return: 1
        suffix_len: stmt\as\frame\head\length - root_len
        if: suffix_len >= 256U
            return: 1
        memcpy(piece, stmt\as\frame\head\data + root_len, suffix_len)
        piece[suffix_len]: 0
        if: l2_cat(buf, piece) != 0
            return: 1
        ---
    if: hj >= l2_m_arity[mi] && hf = 5 && hj < l2_m_arity[mi] + l2_m_sn[mi]
        if: c.sprintf(buf, "l2_s%d_%d", mi, hj - l2_m_arity[mi]) < 0
            return: 1
        root_len: l2_sn[l2_slot_off(mi, hj - l2_m_arity[mi])]\length
        if: root_len >= stmt\as\frame\head\length
            return: 1
        suffix_len: stmt\as\frame\head\length - root_len
        if: suffix_len >= 256U
            return: 1
        memcpy(piece, stmt\as\frame\head\data + root_len, suffix_len)
        piece[suffix_len]: 0
        if: l2_cat(buf, piece) != 0
            return: 1
        ---
    if: hj < 0 || hf != 5 || hj >= l2_m_arity[mi] + l2_m_sn[mi]
        if: l2_tok_text(stmt\as\frame\head, buf, 256U) != 0
            return: 1
        ---
    if: l2_cat(buf, "(") != 0
        return: 1
    # A call with no arguments has no body, or an empty one.
    n: 0
    f: 0
    if: stmt\as\frame\body != 0
        n: l2_count_active(stmt\as\frame\body)
        f: l2_next_active(stmt\as\frame\body\first_field)
    i: 0
    while: i < n && f != 0 && f\value != 0
        if: l2_own_index_tail(f, mi, @ array_own, @ array_index, @ p2, @ array_count) = 0
            if: first = 0 && l2_cat(buf, ", ") != 0
                return: 1
            if: l2_emit_array_load(array_own, array_index, ind, piece) != 0 || l2_cat(buf, piece) != 0
                return: 1
            first: 0
            i: i + array_count
            f: p2
            continue
        piece[0]: 0
        p1: 0
        p2: 0
        po: -1
        # node/for no longer have their own single-hop own-table lookup here
        # (FABLE-SONNET-NODE-ROOT-20260923-121): a field path was never
        # otherwise supported as a call argument (FABLE-SONNET-FIELD-PATHS-
        # 20260923-113 never wired l2_field_path_read into this position
        # either), so node/for simply join that same, pre-existing gap now
        # rather than keeping a special case ordinary roots never had.
        if: po < 0 && l2_index_tail(f, @ p1, @ p2) = 0
            if: first = 0 && l2_cat(buf, ", ") != 0
                return: 1
            if: l2_prep(f\value, mi, ind, piece) != 0
                return: 1
            if: l2_cat(buf, piece) != 0
                return: 1
            if: l2_cat(buf, "[") != 0
                return: 1
            piece[0]: 0
            if: l2_prep(p1\value, mi, ind, piece) != 0
                return: 1
            if: l2_cat(buf, piece) != 0
                return: 1
            if: l2_cat(buf, "]") != 0
                return: 1
            first: 0
            i: i + 4
            f: p2
            continue
        ---
        if: po < 0 && l2_addr_tail(f, @ p1, @ p2) = 0
            if: first = 0 && l2_cat(buf, ", ") != 0
                return: 1
            piece[0]: 0
            # -189 c3b-1/c3b-2: `@` of a bare name that is a direct field is its cell's address.
            po: 0 - 1
            if: p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM
                po: l2_name_cell(mi, p1\value\as\atom)
            if: po >= 0 && l2_own_addr(po, piece) != 0
                return: l2_error(l2_src, p1\value, "this field has no address to take")
            if: po < 0 && l2_cat(buf, "@ ") != 0
                return: 1
            if: po < 0 && l2_prep(p1\value, mi, ind, piece) != 0
                return: 1
            po: 0 - 1
            if: l2_cat(buf, piece) != 0
                return: 1
            first: 0
            i: i + 2
            f: p2
            continue
        ---
        span: l2_expr_span(f)
        if: po < 0 && span > 1
            piece[0]: 0
            if: l2_emit_fields(f, span, mi, ind, piece) != 0
                return: 1
            if: first = 0 && l2_cat(buf, ", ") != 0
                return: 1
            if: l2_cat(buf, piece) != 0
                return: 1
            first: 0
            si: 0
            while: si < span && f != 0
                f: l2_next_active(f\next)
                si: si + 1
            ---
            i: i + span
            continue
        ---
        if: po < 0 && l2_prep(f\value, mi, ind, piece) != 0
            return: 1
        if: po < 0 && l2_ccall_box_int(f\value, mi) != 0 && l2_new_temp(ind, boxt) != 0
            return: 1
        if: po < 0 && l2_ccall_box_int(f\value, mi) != 0 && c.fprintf(l2_out, "%s%s: %s\n", ind, boxt, piece) < 0
            return: 1
        if: po < 0 && l2_ccall_box_int(f\value, mi) != 0
            memcpy(piece, boxt, strlen(boxt) + 1U)
        if: first = 0 && l2_cat(buf, ", ") != 0
            return: 1
        if: l2_cat(buf, piece) != 0
            return: 1
        first: 0
        i: i + 1
        f: l2_next_active(f\next)
    if: l2_cat(buf, ")") != 0
        return: 1
    if: into_buf != 0
        memcpy(into_buf, buf, 256U)
        return: 0
    ---
    if: c.fprintf(l2_out, "%s%s\n", ind, buf) < 0
        return: 1
return: 0

# Step one actual forward: span fields from here.
fn: l2_skip_span (@: LmP0Field a; int: span) @: LmP0Field
    int: i 0
    while: i < span && a != 0
        a: l2_next_active(a\next)
        i: i + 1
    ---
return: a

# The call through a function-pointer local: head(actual, actual). Each actual
# may itself be a field read, so the actuals are walked by span rather than by
# field.
fn: l2_emit_fnptr_call (const: @(LmP0Node stmt); int: mi; const: @(char ind)) int
    const: @: LmP0Frame fr
    @: LmP0Field a
    int: span
    int: first 1
    c.array: [1024]: char buf
    c.array: [1024]: char piece
    if: stmt = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0
        return: 1
    fr: stmt\as\frame
    buf[0]: 0
    if: fr\body != 0
        a: l2_next_active(fr\body\first_field)
        while: a != 0
            span: l2_expr_span(a)
            if: span < 1
                return: 1
            piece[0]: 0
            if: l2_emit_fields(a, span, mi, ind, piece) != 0
                return: 1
            if: first = 0 && l2_cat(buf, ", ") != 0
                return: 1
            if: l2_cat(buf, piece) != 0
                return: 1
            first: 0
            a: l2_skip_span(a, span)
        ---
    ---
    if: c.fprintf(l2_out, "%s", ind) < 0
        return: 1
    if: l2_write_text(l2_out, fr\head) != 0
        return: 1
    if: c.fprintf(l2_out, "(%s)\n", buf) < 0
        return: 1
return: 0

fn: l2_emit_loc_stmt (const: @(LmP0Node stmt); int: mi; const: @(char ind)) int
    @: LmP0Text lnm 0
    int: lty 0
    @: LmP0Field initf
    @: LmP0Field last
    const: @: LmP0Frame fr
    if: stmt = 0
        return: 1
    if: (l2_ptr_local_ty(stmt, @ lnm, @ lty) != 0 || l2_ml_find(lnm) < 0) && (l2_const_local_ty(stmt, @ lnm, @ lty) != 0 || l2_ml_find(lnm) < 0) && (l2_fnptr_local(stmt, @ lnm) != 0 || l2_ml_find(lnm) < 0) && (l2_struct_local(stmt, @ lnm) != 0 || l2_ml_find(lnm) < 0) && (stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || l2_ml_find(stmt\as\frame\head) < 0) && (stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || l2_ml_array_head(stmt\as\frame\head) < 0)
        return: 1
    if: stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0
        if: l2_ml_array_head(stmt\as\frame\head) >= 0
            if: c.fprintf(l2_out, "%s", ind) < 0
                return: 2
            if: l2_write_text(l2_out, stmt\as\frame\head) != 0
                return: 2
            if: stmt\as\frame\body = 0 || l2_eval_fields(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), mi, ind, l2_tok) != 0
                return: 2
            if: c.fprintf(l2_out, ": %s\n", l2_tok) < 0
                return: 2
            return: 0
        ---
    ---
    if: l2_frame_head(stmt, "immutable")
        if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
            return: 2
        if: c.fprintf(l2_out, "%simmutable:\n", ind) < 0
            return: 2
        initf: l2_next_active(stmt\as\frame\body\first_field)
        while: initf != 0
            if: l2_ptr_local_ty(initf\value, @ lnm, @ lty) != 0
                return: 2
            if: c.fprintf(l2_out, "%s    @: char ", ind) < 0
                return: 2
            if: l2_write_text(l2_out, lnm) != 0
                return: 2
            last: l2_next_active(initf\value\as\frame\body\first_field)
            last: l2_next_active(last\next)
            last: l2_next_active(last\next)
            if: last = 0 || last\value = 0 || l2_prep(last\value, mi, ind, l2_tok) != 0
                return: 2
            if: c.fprintf(l2_out, " %s\n", l2_tok) < 0
                return: 2
            initf: l2_next_active(initf\next)
        return: 0
    if: l2_const_local_ty(stmt, @ lnm, @ lty) = 0
        if: lty >= 100
            if: l2_emit_foreign_named(l2_out, lty, ind, lnm) != 0 || fputs("\n", l2_out) < 0
                return: 2
            return: 0
        ---
        if: lty = 3 && c.fprintf(l2_out, "%sconst: @(char ", ind) < 0
            return: 2
            return: 2
        if: lty = 29 && c.fprintf(l2_out, "%sconst: @(LmxMsg ", ind) < 0
            return: 2
        if: lty != 3 && lty != 29
            return: 2
        if: l2_write_text(l2_out, lnm) != 0
            return: 2
        if: fputs(")\n", l2_out) < 0
            return: 2
        return: 0
    # A call through a function-pointer local, before the assignment path: the
    # head names what is CALLED, not what is assigned to.
    if: stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0 && l2_ml_find(stmt\as\frame\head) >= 0 && l2_ml_ty[l2_ml_find(stmt\as\frame\head)] = 40
        if: l2_emit_fnptr_call(stmt, mi, ind) != 0
            return: 2
        return: 0
    # A function-pointer local: the header names the type, so the emitted
    # declaration spells it exactly as the header does.
    if: l2_fnptr_local(stmt, @ lnm) = 0
        if: c.fprintf(l2_out, "%s", ind) < 0
            return: 2
        if: l2_write_text(l2_out, stmt\as\frame\head) != 0
            return: 2
        if: fputs(": ", l2_out) < 0
            return: 2
        if: l2_write_text(l2_out, lnm) != 0
            return: 2
        if: l2_count_active(stmt\as\frame\body) > 1 && l2_emit_fields(l2_next_active(stmt\as\frame\body\first_field)\next, l2_count_active(stmt\as\frame\body) - 1, mi, ind, l2_tok) != 0
            return: 2
        if: l2_count_active(stmt\as\frame\body) > 1 && c.fprintf(l2_out, " %s", l2_tok) < 0
            return: 2
        if: fputs("\n", l2_out) < 0
            return: 2
        return: 0
    if: l2_struct_local(stmt, @ lnm) = 0
        if: c.fprintf(l2_out, "%s", ind) < 0
            return: 2
        if: l2_write_text(l2_out, stmt\as\frame\head) != 0
            return: 2
        if: fputs(": ", l2_out) < 0
            return: 2
        if: l2_write_text(l2_out, lnm) != 0
            return: 2
        if: l2_count_active(stmt\as\frame\body) > 1 && l2_emit_fields(l2_next_active(stmt\as\frame\body\first_field)\next, l2_count_active(stmt\as\frame\body) - 1, mi, ind, l2_tok) != 0
            return: 2
        if: l2_count_active(stmt\as\frame\body) > 1 && c.fprintf(l2_out, " %s", l2_tok) < 0
            return: 2
        if: fputs("\n", l2_out) < 0
            return: 2
        return: 0
    if: l2_ptr_local_ty(stmt, @ lnm, @ lty) = 2
        l2_error(0, l2_next_active(stmt\as\frame\body\first_field)\value, "unknown type")
        return: 2
    if: l2_ptr_local_ty(stmt, @ lnm, @ lty) = 0
        if: lty >= 100
            if: l2_emit_foreign_named(l2_out, lty, ind, lnm) != 0
                return: 2
            if: l2_count_active(stmt\as\frame\body) = 3
                initf: l2_next_active(stmt\as\frame\body\first_field)
                initf: l2_next_active(initf\next)
                initf: l2_next_active(initf\next)
                if: initf = 0 || l2_prep(initf\value, mi, ind, l2_tok) != 0 || c.fprintf(l2_out, " %s", l2_tok) < 0
                    return: 2
            ---
            if: fputs("\n", l2_out) < 0
                return: 2
            return: 0
        ---
        if: lty = 12 && c.fprintf(l2_out, "%s@: char ", ind) < 0
            return: 2
        if: lty = 9 && c.fprintf(l2_out, "%s@: size_t ", ind) < 0
            return: 2
        if: lty = 11 && c.fprintf(l2_out, "%s@: int ", ind) < 0
            return: 2
            return: 2
        if: lty = 16 && c.fprintf(l2_out, "%s@: void ", ind) < 0
            return: 2
        if: lty = 25 && c.fprintf(l2_out, "%s@: unsigned ", ind) < 0
            return: 1
        if: lty = 38 && c.fprintf(l2_out, "%s@: ulong ", ind) < 0
            return: 1
        if: lty = 17 && c.fprintf(l2_out, "%s@@: char ", ind) < 0
            return: 2
        if: lty = 18 && c.fprintf(l2_out, "%s@@: void ", ind) < 0
            return: 2
        if: lty = 19 && c.fprintf(l2_out, "%s@@: int ", ind) < 0
            return: 2
        if: lty = 20 && c.fprintf(l2_out, "%s@@: size_t ", ind) < 0
            return: 2
        if: lty = 24 && c.fprintf(l2_out, "%s@@: unsigned ", ind) < 0
            return: 2
        if: lty = 39 && c.fprintf(l2_out, "%s@@: ulong ", ind) < 0
            return: 2
        if: lty != 9 && lty != 11 && lty != 12 && lty != 13 && lty != 16 && lty != 17 && lty != 18 && lty != 19 && lty != 20 && lty != 23 && lty != 24 && lty != 25 && lty != 38 && lty != 39
            return: 2
        if: l2_write_text(l2_out, lnm) != 0
            return: 2
        if: l2_count_active(stmt\as\frame\body) = 3
            initf: l2_next_active(stmt\as\frame\body\first_field)
            initf: l2_next_active(initf\next)
            initf: l2_next_active(initf\next)
            if: initf = 0 || l2_prep(initf\value, mi, ind, l2_tok) != 0
                return: 2
            if: c.fprintf(l2_out, " %s", l2_tok) < 0
                return: 2
        ---
        if: fputs("\n", l2_out) < 0
            return: 2
        return: 0
    if: l2_own_decl_ty(stmt) != 0
        lnm: l2_next_active(stmt\as\frame\body\first_field)\value\as\atom
        lty: l2_own_store_ty(l2_own_decl_ty(stmt))
        if: lty = 0 && c.fprintf(l2_out, "%sint: ", ind) < 0
            return: 2
        if: lty = 1 && c.fprintf(l2_out, "%schar: ", ind) < 0
            return: 2
        if: lty = 2 && c.fprintf(l2_out, "%ssize_t: ", ind) < 0
            return: 2
        if: lty != 0 && lty != 1 && lty != 2
            return: 2
        if: l2_write_text(l2_out, lnm) != 0
            return: 2
        if: l2_count_active(stmt\as\frame\body) = 2
            initf: l2_next_active(stmt\as\frame\body\first_field)
            initf: l2_next_active(initf\next)
            if: initf = 0 || l2_prep(initf\value, mi, ind, l2_tok) != 0
                return: 2
            if: c.fprintf(l2_out, " %s", l2_tok) < 0
                return: 2
        ---
        if: fputs("\n", l2_out) < 0
            return: 2
        return: 0
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0
        return: 1
    fr: stmt\as\frame
    if: l2_ml_find(fr\head) < 0
        return: 1
    if: fr\body = 0
        return: 2
    initf: l2_next_active(fr\body\first_field)
    if: l2_count_active(fr\body) = 1 && initf != 0 && initf\value != 0 && initf\value\kind = c.LM_P0_NODE_FRAME && initf\value\as != 0 && initf\value\as\frame != 0 && l2_is_known(initf\value\as\frame\head)
        l2_ccall_into: l2_tok
        if: l2_emit_ccall(initf\value, mi, ind) != 0
            l2_ccall_into: 0
            return: 2
        ---
    if: l2_count_active(fr\body) != 1 || initf = 0 || initf\value = 0 || initf\value\kind != c.LM_P0_NODE_FRAME || l2_is_known(initf\value\as\frame\head) = 0
        if: l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 2
        ---
    ---
    if: c.fprintf(l2_out, "%s", ind) < 0
        return: 2
    if: l2_write_text(l2_out, fr\head) != 0
        return: 2
    if: c.fprintf(l2_out, ": %s\n", l2_tok) < 0
        return: 2
return: 0

    # Widest merge in a body, found before the entry preamble is written, because
# the operand array is a local of that preamble. Recurses through the frames
# that carry nested bodies.
# The settled form is an outer result-name frame whose single body element is a
# merge frame: R: merge: A B. The statement head is R, not merge. This pass
# finds them before the entry preamble is written, because the operand array and
# the result slots are fixed there.
# Printed tree of R: merge: A with a result body, from printTree:
#
#   frame head="R" body=structure fields=2
#     frame head="merge" body=structure fields=1
#       atom "A"
#     structure fields=1
#       frame head="size_t" ...
#
# The result body is a SIBLING of the merge frame inside R, not a child of it.
# Without a body, R holds the merge frame alone.
fn: l2_merge_frame (const: @(LmP0Node stmt)) @: LmP0Node
    @: LmP0Field f
    int: n
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0
        return: 0
    if: stmt\as\frame\body = 0
        return: 0
    n: l2_count_active(stmt\as\frame\body)
    if: n != 1 && n != 2
        return: 0
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || l2_frame_head(f\value, "merge") = 0
        return: 0
return: f\value

# The result body fields, or 0 when the form has none.
fn: l2_merge_body (const: @(LmP0Node stmt)) @: LmP0Structure
    @: LmP0Field f
    if: l2_merge_frame(stmt) = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 2
        return: 0
    f: l2_next_active(l2_next_active(stmt\as\frame\body\first_field)\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_STRUCTURE || f\value\as = 0
        return: 0
return: f\value\as\structure

# Operand count of a merge frame: the leading atoms only. A trailing STRUCTURE
# holds the result body fields and is never an operand.
fn: l2_merge_arity (const: @(LmP0Node mf)) int
    @: LmP0Field f
    int: n 0
    if: mf = 0 || mf\as = 0 || mf\as\frame = 0 || mf\as\frame\body = 0
        return: 0
    f: l2_next_active(mf\as\frame\body\first_field)
    while: f != 0
        if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
            return: n
        n: n + 1
        f: l2_next_active(f\next)
    ---
return: n

fn: l2_mres_find (const: @(LmP0Text t) ) int
    int: i 0
    while: i < l2_mres_n
        if: l2_text_same(l2_mres_name[i], t)
            return: i
        i: i + 1
    ---
return: 0 - 1

# Nested bodies of an ordinary frame: if, while and for carry their statements
# in a STRUCTURE node among the frame fields.
fn: l2_merge_nested (const: @(LmP0Structure fields)) int
    @: LmP0Field f
    if: fields = 0
        return: 0
    f: l2_next_active(fields\first_field)
    while: f != 0
        if: f\value != 0 && f\value\kind = c.LM_P0_NODE_STRUCTURE && f\value\as != 0
            if: l2_merge_scan(f\value\as\structure) != 0
                return: 1
            ---
        ---
        f: l2_next_active(f\next)
    ---
return: 0

# Does a body contain a merge anywhere? A method that does declares
# throws merge(args) and therefore takes the full declared-throw ABI; every
# other callable keeps its direct return, so nothing else changes shape.
fn: l2_body_throws (const: @(LmP0Structure body); int: mi) int
    @: LmP0Field field
    @: LmP0Field inner
    @: LmP0Node stmt
    @: LmP0Text cmodel
    @: LmP0Text cname
    if: body = 0
        return: 0
    # A method that declares throw names is on the throw channel by its declaration (S1.2).
    if: l2_throws_declared(mi) > 0
        return: 1
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0 && l2_body_throws(stmt\as\structure, mi) != 0
            return: 1
        if: l2_merge_frame(stmt) != 0
            return: 1
        # A colon declaration (Model: fresh) is the same construction as an
        # explicit merge: statement, spelled differently -- it also throws.
        if: l2_colon_decl_shape(stmt, @ cmodel, @ cname) = 0
            return: 1
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0
            inner: l2_next_active(stmt\as\frame\body\first_field)
            while: inner != 0
                if: inner\value != 0 && inner\value\kind = c.LM_P0_NODE_STRUCTURE && inner\value\as != 0
                    if: l2_body_throws(inner\value\as\structure, mi) != 0
                        return: 1
                    ---
                ---
                inner: l2_next_active(inner\next)
            ---
        ---
        field: l2_next_active(field\next)
    ---
return: 0

# A call that can throw makes its caller throwing as well. The same closure is
# the current-Message dynamic dependency closure: entry supplies the Message,
# and every throwing method receives and forwards it.
fn: l2_throws_close () int
    int: changed 1
    int: caller
    int: callee
    while: changed != 0
        changed: 0
        caller: 0
        while: caller < l2_m_n
            callee: 0
            while: callee < l2_m_n
                if: l2_m_edge[l2_edge_off(caller, callee)] != 0 && l2_m_throws[callee] != 0 && l2_m_throws[caller] = 0
                    l2_m_throws[caller]: 1
                    changed: 1
                callee: callee + 1
            caller: caller + 1
        ---
    ---
return: 0

# RE-ENTRY (FABLE-OPUS-CODE-DATA-SPLIT-20260925-189 commit c3a; Q28: a fresh instance only where
# the translator cannot rule out re-entry).  l2_m_reach[l2_edge_off(a, b)] is 1 when an activation
# of a can lead to a call of b: a path of one call or more.  A call of a method by name or path is
# an edge to it (bit 1 of l2_m_edge).  A call through a callable formal (bit 2) calls whichever
# method its actual names, so it is an edge to every method passed by reference
# (l2_m_value_used).  The closure is Warshall's, over the methods.
fn: l2_reach_close (const: @(char path)) int
    size_t: n (cast: (size_t) l2_m_cap) * (cast: (size_t) l2_m_cap)
    int: a 0
    int: b 0
    int: k 0
    int: dyn 0
    l2_m_reach: (cast: (@: int) l2_xmalloc(n * c.sizeof(c.int)))
    if: l2_m_reach = 0
        return: l2_error(path, 0, "out of memory")
    memset((cast: (@: void) l2_m_reach), 0, n * c.sizeof(c.int))
    while: a < l2_m_n
        dyn: 0
        b: 0
        while: b < l2_m_n
            if: (l2_m_edge[l2_edge_off(a, b)] & 1) != 0
                l2_m_reach[l2_edge_off(a, b)]: 1
            if: (l2_m_edge[l2_edge_off(a, b)] & 2) != 0
                dyn: 1
            b: b + 1
        ---
        b: 0
        while: dyn != 0 && b < l2_m_n
            if: l2_m_value_used[b] != 0
                l2_m_reach[l2_edge_off(a, b)]: 1
            b: b + 1
        ---
        a: a + 1
    ---
    while: k < l2_m_n
        a: 0
        while: a < l2_m_n
            if: l2_m_reach[l2_edge_off(a, k)] != 0
                b: 0
                while: b < l2_m_n
                    if: l2_m_reach[l2_edge_off(k, b)] != 0
                        l2_m_reach[l2_edge_off(a, b)]: 1
                    b: b + 1
                ---
            ---
            a: a + 1
        ---
        k: k + 1
    ---
return: 0

# A call in method caller of method callee is a re-entry when callee can lead back to caller:
# callee may then be active when caller calls it.  A call of the method itself is one.
fn: l2_reenters (int: caller; int: callee) int
return: l2_m_reach[l2_edge_off(callee, caller)] != 0

# Build the result-slot map for one merge statement by the author's rule (plan §4): the
# model's fields, then each later operand's and the body's -- INTO the placed slot of the
# same name, or a slot of their own. Runs in the PRE-SCAN, because a method
# lowered before the entry E may already read a field of the result.
fn: l2_mrs_build (int: res; const: @(LmP0Node stmt); const: @(LmP0Node mf)) int
    const: @: LmP0Frame fr
    @: LmP0Field last
    @: LmP0Field bf
    @: LmP0Field bv
    @: LmP0Structure bd
    int: n
    int: k 0
    int: oi
    int: ni
    int: sl
    int: bj 0
    int: pairs 0
    int: q 0
    int: vk
    size_t: val
    if: mf = 0 || mf\as = 0 || mf\as\frame = 0 || mf\as\frame\body = 0
        return: 0
    fr: mf\as\frame
    n: l2_merge_arity(mf)
    last: l2_next_active(fr\body\first_field)
    while: k < n && last != 0
        if: last\value = 0 || last\value\kind != c.LM_P0_NODE_ATOM
            return: 0
        oi: l2_ebr_find(last\value\as\atom)
        ni: l2_ns_find(last\value\as\atom)
        if: ni >= 0 && l2_ns_parent[ni] >= 0
            ni: 0 - 1
        sl: l2_mres_find(last\value\as\atom)
        if: oi >= 0 && l2_mrs_take_entry(res, k, l2_ebr_root(oi), last\value) != 0
            return: 1
        if: oi < 0 && ni >= 0 && l2_mrs_take_entry(res, k, ni, last\value) != 0
            return: 1
        if: oi < 0 && ni < 0 && sl >= 0 && l2_mrs_take_result(res, k, sl, last\value) != 0
            return: 1
        last: l2_next_active(last\next)
        k: k + 1
    ---
    bd: l2_merge_body(stmt)
    bf: 0
    if: bd != 0
        bf: l2_next_active(bd\first_field)
    while: bf != 0
        if: bf\value = 0 || bf\value\kind != c.LM_P0_NODE_FRAME || bf\value\as = 0 || bf\value\as\frame = 0 || bf\value\as\frame\body = 0
            return: 0
        bv: l2_next_active(bf\value\as\frame\body\first_field)
        if: bv = 0 || bv\value = 0 || bv\value\kind != c.LM_P0_NODE_ATOM
            return: 0
        vk: 0
        val: 0U
        if: l2_next_active(bv\next) != 0 && l2_next_active(bv\next)\value != 0 && l2_next_active(bv\next)\value\kind = c.LM_P0_NODE_ATOM && l2_num(l2_next_active(bv\next)\value\as\atom) != 0
            vk: 1
            val: l2_literal_value(l2_next_active(bv\next)\value\as\atom)
        ---
        if: l2_mrs_join(res, n, bj, bv\value\as\atom, 0, 0 - 1, vk, val, bf\value) != 0
            return: 1
        bj: bj + 1
        bf: l2_next_active(bf\next)
    ---
    l2_mres_width[res]: l2_mrs_width(res)
    while: q < l2_msrc_n
        if: l2_msrc_res[q] = res && l2_msrc_pair[q] != 0
            pairs: pairs + 1
        q: q + 1
    ---
    if: pairs > l2_merge_pmax
        l2_merge_pmax: pairs
return: 0

fn: l2_merge_scan (const: @(LmP0Structure body)) int
    @: LmP0Field field
    @: LmP0Node stmt
    @: LmP0Node mf
    @@: LmP0Text grown
    @: int widths 0
    @: LmP0Text cmodel
    @: LmP0Text cname
    int: n
    if: body = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0
            if: l2_merge_scan(stmt\as\structure) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        mf: l2_merge_frame(stmt)
        if: mf != 0
            n: l2_merge_arity(mf)
            if: n > l2_merge_max
                l2_merge_max: n
            if: l2_mres_find(stmt\as\frame\head) < 0
                grown: (cast: (@@: LmP0Text) realloc((cast: (@: void) l2_mres_name), (cast: (size_t) (l2_mres_n + 1)) * c.sizeof(@: void)))
                if: grown = 0
                    return: 1
                l2_mres_name: grown
                widths: (cast: (@: int) realloc((cast: (@: void) l2_mres_width), (cast: (size_t) (l2_mres_n + 1)) * c.sizeof(c.int)))
                if: widths = 0
                    return: 1
                l2_mres_width: widths
                l2_mres_width[l2_mres_n]: 0
                l2_mres_name[l2_mres_n]: (cast: (@: LmP0Text) stmt\as\frame\head)
                l2_mres_n: l2_mres_n + 1
                if: l2_mrs_build(l2_mres_n - 1, stmt, mf) != 0
                    return: 1
            ---
        ---
        # A colon declaration is the same construction operation as an
        # explicit merge: statement, one operand, spelled differently: the
        # scanner recognizes both so both size the same shared scratch.
        if: mf = 0 && l2_colon_decl_shape(stmt, @ cmodel, @ cname) = 0
            if: 1 > l2_merge_max
                l2_merge_max: 1
            field: l2_next_active(field\next)
            continue
        if: mf = 0 && stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0
            if: l2_merge_nested(stmt\as\frame\body) != 0
                return: 1
            ---
        ---
        field: l2_next_active(field\next)
    ---
return: 0

# THE EXPRESSION STATEMENT, emitted (l2_check_discard; plan §3; FABLE-OPUS-DISCARD-20260924-147).
# One consumer for every expression in statement position: a bare atom, a run of fields, and a
# call Frame -- a callable head or a known external.  A callable atom is called with no arguments
# on the call path of `m()` (a void one too); anything else is evaluated on the value path
# (l2_prep, l2_eval_fields) and the value is dropped.  Its destination is the typed l2_tN the
# calls in it already declared; a pure expression declares none and emits nothing.
fn: l2_eval_discard (@: LmP0Field field; int: span; int: mi; const: @(char ind)) int
    @: LmP0Node e
    int: idx
    int: fi 0
    e: field\value
    if: span = 1 && e\kind = c.LM_P0_NODE_ATOM
        idx: l2_atom_callee(e\as\atom, mi, @ fi)
        if: idx >= 0 && fi >= 0
            return: l2_emit_call(e, idx, 2, fi, 0, mi, ind, l2_tok)
        if: idx >= 0
            return: l2_emit_call(e, idx, 0, 0 - 1, 0, mi, ind, l2_tok)
        return: 0
    if: span = 1
        return: l2_prep(e, mi, ind, l2_tok)
return: l2_eval_fields(field, span, mi, ind, l2_tok)

# A body with nothing to run: every statement in it is an expression with no call in it -- no
# callable atom, no call among its fields -- or such a body itself.  Its block emits no code.
fn: l2_body_inert (const: @(LmP0Structure body); int: mi) int
    @: LmP0Field f
    @: LmP0Node e
    int: n
    int: fi 0
    if: body = 0
        return: 1
    f: l2_next_active(body\first_field)
    while: f != 0
        e: f\value
        n: l2_discard_run(f)
        if: n > 0
            if: n = 1 && e\kind = c.LM_P0_NODE_ATOM && l2_atom_callee(e\as\atom, mi, @ fi) >= 0
                return: 0
            if: l2_fields_has_call(f, n) != 0
                return: 0
            f: l2_skip_span(f, n)
            continue
        if: e != 0 && e\kind = c.LM_P0_NODE_STRUCTURE && e\as != 0 && e\as\structure != 0 && l2_body_inert(e\as\structure, mi) != 0
            f: l2_next_active(f\next)
            continue
        return: 0
    ---
return: 1

fn: l2_emit_stmts (const: @(LmP0Structure body); @: LmP0Field from; @: LmP0Field stop; int: mi; const: @(char ind)) int
    int: rbadmit 0
    int: array_own
    size_t: array_index
    c.array: [1024]: char array_ptr
    c.array: [1024]: char index_tok
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Field last
    int: n
    int: k
    int: oi
    int: si
    int: fi
    int: sl
    int: rj 0
    int: rf 0
    int: raw 1
    int: ix 1
    int: pd 1
    int: need_cut 0
    @: LmP0Structure bd 0
    int: bw 0
    int: msf 0
    size_t: l2_pn 0U
    size_t: l2_pv 0U
    int: l2_pkind 0
    int: l2_pni 0
    int: l2_pres 0
    int: l2_poi 0
    int: l2_proot 0
    int: l2_pfi 0
    int: l2_pown 0
    int: l2_prhs_lit 0
    c.array: [1024]: char l2_pbuf
    c.array: [1024]: char l2_pnm
    c.array: [160]: char l2_pval
    c.array: [192]: char l2_pval2
    c.array: [64]: char l2_dind
    c.array: [1024]: char pdest
    int: cni
    @: LmP0Text cmodel
    @: LmP0Text cname
    c.array: [64]: char l2_esd_tok
    int: easn 0
    int: aj 0
    int: aj2 0
    int: am 0
    int: at 0
    int: au 0
    int: mnp 0
    int: mq 0
    int: mrw 0
    int: ni 0
    @: LmP0Field bf 0
    int: bn 0
    int: ep 0
    @: char deep 0
    @: char wdeep 0
    c.array: [64]: char wcond
    c.array: [64]: char wkeep
    c.array: [64]: char wfirst
    if: body = 0
        return: 0
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    field: from
    while: field != 0 && field != stop
        stmt: field\value
        l2_vis_stmt(mi, stmt)
        pd: 1
        if: l2_frame_head(stmt, "return") && need_cut != 0 && c.fprintf(l2_out, "%s---\n", ind) < 0
            return: 1
        if: l2_frame_head(stmt, "return") = 0 && l2_frame_head(stmt, "if") = 0
            need_cut: 0
        # An expression statement (l2_eval_discard); the walker moves past its whole run.
        n: l2_discard_run(field)
        if: n > 0
            if: l2_eval_discard(field, n, mi, ind) != 0
                return: 1
            field: l2_skip_span(field, n)
            continue
        # An anonymous `---` block is a nested executable body, like an if body (§14, Q14 K); one
        # with nothing to run (`()`, `(2 + 2)`: l2_body_inert) emits nothing -- its graph
        # Structure is built like every control body's, and an L1 `if:` needs a body.
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0 && l2_body_inert(stmt\as\structure, mi) != 0
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0
            if: c.fprintf(l2_out, "%sif: 1\n", ind) < 0
                return: 1
            if: l2_scope_push(stmt) != 0
                return: 1
            if: l2_emit_body(stmt\as\structure, mi, deep) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            if: c.fprintf(l2_out, "%s---\n", deep) < 0
                return: 1
            field: l2_next_active(field\next)
            need_cut: 1
            continue
        if: l2_frame_head(stmt, "throws")
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "throw")
            if: l2_emit_throw(stmt, mi, ind) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        oi: -1
        si: -1
        fi: -1
        sl: -1
        # 19.17 merge at its execution site, settled form R: merge: A B. The
        # statement head is the RESULT NAME; the merge frame is its single body
        # element. Leading atoms are operands; a trailing Structure would be the
        # result body fields and is refused below rather than silently dropped.
        #
        # In a source method, process_message is the compiler-selected dynamic
        # input carried by METHOD.sig. Failure throws the implicit name `merge`
        # (l2_emit_implicit_throw): no payload, status d + 1, and
        # the ordinary result is not published.
        if: l2_merge_frame(stmt) != 0
            fr: l2_merge_frame(stmt)\as\frame
            n: l2_merge_arity(l2_merge_frame(stmt))
            if: n < 1
                return: l2_error(l2_src, stmt, "merge needs at least one operand")
            # The result body, when present, is built as a small Structure whose
            # children are the declared fields in source order, and handed to the
            # helper as its body operand. Only a size_t leaf is admitted, the same
            # restriction the qualified branches carry.
            bw: 0
            ep: 0
            bd: l2_merge_body(stmt)
            bn: 0
            if: bd != 0
                bn: l2_count_active(bd)
            if: bd != 0 && bn = 0
                return: l2_error(l2_src, stmt, "an empty merge result body is not a field list")
            if: bd != 0 && c.fprintf(l2_out, "%sl2_mbody: lmx_node_new_owned(l2_program_arena)\n%sif: l2_mbody = 0 || lmx_arena_refs_open_owned(l2_program_arena, l2_mbody, %dU) != 0\n", ind, ind, bn) < 0
                return: 1
            if: bd != 0 && l2_emit_implicit_throw(mi, "merge", ind) != 0
                return: 1
            bf: 0
            if: bd != 0
                bf: l2_next_active(bd\first_field)
            k: 0
            while: bf != 0
                if: l2_frame_head(bf\value, "size_t") = 0 || l2_count_active(bf\value\as\frame\body) != 2
                    return: l2_error(l2_src, stmt, "unsupported merge result body field")
                last: l2_next_active(bf\value\as\frame\body\first_field)
                last: l2_next_active(last\next)
                if: last\value = 0 || last\value\kind != c.LM_P0_NODE_ATOM || l2_num(last\value\as\atom) = 0
                    return: l2_error(l2_src, stmt, "a merge result body field needs a literal")
                if: c.fprintf(l2_out, "%sl2_mxp: lmx_arena_ref_cell(l2_mbody, %dU)\n%sif: l2_mxp = 0\n", ind, k, ind) < 0
                    return: 1
                if: l2_emit_invariant(ind, "merge result body has no cell for its field") != 0
                    return: 1
                if: c.fprintf(l2_out, "%sl2_mxp[0]: lmx_size_new_owned(l2_program_arena)\n%sif: l2_mxp[0] = 0\n", ind, ind) < 0
                    return: 1
                if: l2_emit_implicit_throw(mi, "merge", ind) != 0
                    return: 1
                if: c.fprintf(l2_out, "%sif: lmx_size_store_known(l2_mxp[0], %zuU) != 0\n", ind, l2_literal_value(last\value\as\atom)) < 0
                    return: 1
                if: l2_emit_invariant(ind, "merge result body field refused its value") != 0
                    return: 1
                bf: l2_next_active(bf\next)
                k: k + 1
            ---
            msf: l2_mres_find(stmt\as\frame\head)
            if: msf < 0
                return: l2_error(l2_src, stmt, "merge result name was not reserved")
            last: l2_next_active(fr\body\first_field)
            k: 0
            while: k < n
                oi: l2_ebr_find(last\value\as\atom)
                # The operand must be identified BEFORE its width and literals are
                # read: this lookup used to sit at the bottom of the loop, so every
                # named operand contributed the PREVIOUS operand's fields.
                ni: l2_ns_find(last\value\as\atom)
                if: ni >= 0 && l2_ns_parent[ni] >= 0
                    ni: 0 - 1
                if: ni >= 0 && l2_ns_eternal[ni] >= 0
                    ni: 0 - 1
                sl: l2_mres_find(last\value\as\atom)
                # The result-slot map was built in the pre-scan, because a
                # method lowered before the entry E may already read a field of this
                # result. Nothing to add here.
                if: oi < 0 && sl < 0 && ni < 0
                    return: l2_error(l2_src, stmt, "unknown merge operand")
                if: oi >= 0 && c.fprintf(l2_out, "%sl2_mops[%dU]: lmx_arena_ref_struct(%s, %uU)\n", ind, k, l2_unit_ref, (cast: (unsigned) (l2_unit_base + l2_occ_n() + oi))) < 0
                    return: 1
                if: oi < 0 && sl >= 0 && c.fprintf(l2_out, "%sl2_mops[%dU]: lmx_arena_ref_struct(%s, %uU)\n", ind, k, l2_unit_ref, (cast: (unsigned) (l2_mres_base + sl))) < 0
                    return: 1
                if: oi < 0 && sl < 0 && c.fprintf(l2_out, "%sl2_mops[%dU]: lmx_arena_ref_struct(%s, %uU)\n", ind, k, l2_unit_ref, (cast: (unsigned) (l2_ns_base + l2_ns_rank(ni)))) < 0
                    return: 1
                # Every full qualified operand contributes its exact physical receiver-
                # expression profile to this call-local span. Duplicates are deliberately
                # kept: the kernel treats them idempotently and no global/numeric identity
                # is synthesized by the translator.
                if: oi >= 0 && c.fprintf(l2_out, "%sl2_mprofiles[%dU]: lmx_range_profile(l2_program_arena, (cast: (@: void) l2_mops[%dU]))\n%sif: l2_mprofiles[%dU] = 0\n", ind, ep, k, ind, ep) < 0
                    return: 1
                if: oi >= 0 && l2_emit_invariant(ind, "a qualified merge operand has no profile") != 0
                    return: 1
                if: oi >= 0
                    ep: ep + 1
                ---
                last: l2_next_active(last\next)
                k: k + 1
            ---
            if: bd = 0 && c.fprintf(l2_out, "%sl2_mbody: 0\n", ind) < 0
                return: 1
            sl: msf
            # The width and the pairs are the result-slot map's (l2_mrs_build): the model's
            # slots, the fields the later operands added, the body fields; a pair writes a later
            # operand's field INTO a model slot (the author's merge rule, plan §4).
            bw: l2_mres_width[sl]
            mnp: 0
            mq: 0
            while: mq < l2_msrc_n
                if: l2_msrc_res[mq] = sl && l2_msrc_pair[mq] != 0 && c.fprintf(l2_out, "%sl2_mpp[%dU]: @ l2_mpv[%dU]\n%sl2_mpp[%dU]\\model_slot: %dU\n%sl2_mpp[%dU]\\operand: %dU\n%sl2_mpp[%dU]\\field: %dU\n", ind, mnp, mnp, ind, mnp, l2_msrc_slot[mq], ind, mnp, l2_msrc_op[mq], ind, mnp, l2_msrc_fld[mq]) < 0
                    return: 1
                if: l2_msrc_res[mq] = sl && l2_msrc_pair[mq] != 0
                    mnp: mnp + 1
                mq: mq + 1
            ---
            if: ep = 0 && mnp = 0 && c.fprintf(l2_out, "%sl2_mstatus: lmx_merge_owned(l2_mops, %dU, l2_mbody, %s, 0, l2_program_arena, l2_program_arena, 0, 0U, @ l2_mresult)\n", ind, n, l2_unit_ref) < 0
                return: 1
            if: ep = 0 && mnp > 0 && c.fprintf(l2_out, "%sl2_mstatus: lmx_merge_owned(l2_mops, %dU, l2_mbody, %s, 0, l2_program_arena, l2_program_arena, l2_mpp, %dU, @ l2_mresult)\n", ind, n, l2_unit_ref, mnp) < 0
                return: 1
            if: ep > 0 && mnp = 0 && c.fprintf(l2_out, "%sl2_mstatus: lmx_merge_profiles_owned(l2_mops, %dU, l2_mbody, %s, 0, l2_program_arena, l2_program_arena, l2_mprofiles, %dU, 0, 0U, @ l2_mresult)\n", ind, n, l2_unit_ref, ep) < 0
                return: 1
            if: ep > 0 && mnp > 0 && c.fprintf(l2_out, "%sl2_mstatus: lmx_merge_profiles_owned(l2_mops, %dU, l2_mbody, %s, 0, l2_program_arena, l2_program_arena, l2_mprofiles, %dU, l2_mpp, %dU, @ l2_mresult)\n", ind, n, l2_unit_ref, ep, mnp) < 0
                return: 1
            if: c.fprintf(l2_out, "%sif: l2_mstatus != 0 || l2_mresult = 0\n", ind) < 0
                return: 1
            if: l2_emit_implicit_throw(mi, "merge", ind) != 0
                return: 1
            # The generated program checks the SHAPE it was promised: the result width
            # the map gives, known here. Without this the merge could succeed and produce
            # anything.
            if: c.fprintf(l2_out, "%sif: l2_mresult\\len != %d\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 71\\n\")\n%s    c.abort()\n", ind, bw, ind, ind) < 0
                return: 1
            # Second walk, now that the result exists: each operand field that SURVIVED
            # in the result (l2_msrc_at: no later operand wrote its slot again) is checked
            # at the slot the map gave it. This pins the placement, not only the two ends.
            last: l2_next_active(fr\body\first_field)
            k: 0
            while: k < n
                oi: l2_ebr_find(last\value\as\atom)
                if: oi >= 0 && l2_ns_first_kind(l2_ebr_root(oi)) = 0 && l2_msrc_at(sl, k, 0) >= 0 && c.fprintf(l2_out, "%sl2_mxp: lmx_arena_ref_cell(l2_mresult, %dU)\n%sif: l2_mxp = 0 || lmx_size_value_known(l2_mxp[0]) != %zuU\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 74\\n\")\n%s    c.abort()\n", ind, l2_msrc_at(sl, k, 0), ind, l2_ns_first_value(l2_ebr_root(oi)), ind, ind) < 0
                    return: 1
                if: oi >= 0 && l2_ns_first_kind(l2_ebr_root(oi)) = 1 && l2_msrc_at(sl, k, 0) >= 0 && c.fprintf(l2_out, "%sl2_mxp: lmx_arena_ref_cell(l2_mresult, %dU)\n%sif: l2_mxp = 0 || lmx_char_value_known(l2_mxp[0]) != %d\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 74\\n\")\n%s    c.abort()\n", ind, l2_msrc_at(sl, k, 0), ind, (cast: (int) l2_ns_first_value(l2_ebr_root(oi))), ind, ind) < 0
                    return: 1
                # AN ADMITTED BRANCH IS A TERMINAL. merge copies ordinary
                # mutable state around it but keeps these exact addresses,
                # which is the only thing that makes sharing it safe.
                aj: 0
                while: oi >= 0 && aj < l2_ns_count[l2_ebr_root(oi)]
                    if: l2_msrc_at(sl, k, aj) >= 0 && c.fprintf(l2_out, "%sl2_mxp: lmx_arena_ref_cell(l2_mresult, %dU)\n%sl2_myp: lmx_arena_ref_cell(lmx_arena_ref_struct(%s, %uU), %dU)\n%sif: l2_mxp = 0 || l2_myp = 0 || l2_mxp[0] != l2_myp[0]\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 80\\n\")\n%s    c.abort()\n", ind, l2_msrc_at(sl, k, aj), ind, l2_unit_ref, (cast: (unsigned) (l2_unit_base + l2_occ_n() + oi)), aj, ind, ind, ind) < 0
                        return: 1
                    aj: aj + 1
                ---
                ni: l2_ns_find(last\value\as\atom)
                if: ni >= 0 && l2_ns_parent[ni] >= 0
                    ni: 0 - 1
                if: ni >= 0 && l2_ns_eternal[ni] >= 0
                    ni: 0 - 1
                if: oi < 0 && ni >= 0 && l2_ns_first_kind(ni) = 0 && l2_msrc_at(sl, k, 0) >= 0 && c.fprintf(l2_out, "%sl2_mxp: lmx_arena_ref_cell(l2_mresult, %dU)\n%sif: l2_mxp = 0 || lmx_size_value_known(l2_mxp[0]) != %zuU\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 74\\n\")\n%s    c.abort()\n", ind, l2_msrc_at(sl, k, 0), ind, l2_ns_first_value(ni), ind, ind) < 0
                    return: 1
                if: oi < 0 && ni >= 0 && l2_ns_first_kind(ni) = 1 && l2_msrc_at(sl, k, 0) >= 0 && c.fprintf(l2_out, "%sl2_mxp: lmx_arena_ref_cell(l2_mresult, %dU)\n%sif: l2_mxp = 0 || lmx_char_value_known(l2_mxp[0]) != %d\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 74\\n\")\n%s    c.abort()\n", ind, l2_msrc_at(sl, k, 0), ind, (cast: (int) l2_ns_first_value(ni)), ind, ind) < 0
                    return: 1
                # ALIASES AND CYCLES THROUGH THE COMMON COPY MAP. The slot
                # field j went to holds the copy of the entry that field j of this
                # operand names. If that entry in turn names an entry u which
                # this operand also names at field j2, then ONE map means the two
                # paths must arrive at the SAME copy. A merge that copied the
                # graph twice, or broke a cycle, fails here instead of passing.
                aj: 0
                while: ni >= 0 && aj < l2_ns_count[ni]
                    at: l2_ns_field_ref(ni, aj)
                    am: 0
                    while: at >= 0 && am < l2_ns_count[at]
                        au: l2_ns_field_ref(at, am)
                        aj2: 0 - 1
                        if: au >= 0
                            aj2: l2_ns_slot_of_ref(ni, au)
                        if: aj2 >= 0 && l2_msrc_at(sl, k, aj) >= 0 && l2_msrc_at(sl, k, aj2) >= 0 && c.fprintf(l2_out, "%sl2_malias: lmx_arena_ref_struct(l2_mresult, %dU)\n%sif: l2_malias = 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 75\\n\")\n%s    c.abort()\n%sl2_mxp: lmx_arena_ref_cell(l2_malias, %dU)\n%sl2_myp: lmx_arena_ref_cell(l2_mresult, %dU)\n%sif: l2_mxp = 0 || l2_myp = 0 || l2_mxp[0] != l2_myp[0]\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 75\\n\")\n%s    c.abort()\n", ind, l2_msrc_at(sl, k, aj), ind, ind, ind, ind, am, ind, l2_msrc_at(sl, k, aj2), ind, ind, ind) < 0
                            return: 1
                        am: am + 1
                    ---
                    aj: aj + 1
                ---
                # A CALLABLE field of kind 4 (A: fn: M -- reference to a unit
                # method occurrence). Q22 = II: merge keeps the SAME occurrence
                # address and the SAME mutable storage. Nested callables
                # declared inside the operand (when emitted) still require a
                # distinct copy -- not this kind-4 path. Checks 77/79 uniquely.
                aj: 0
                while: ni >= 0 && aj < l2_ns_count[ni]
                    at: l2_ns_field_kind(ni, aj)
                    au: l2_ns_field_mi(ni, aj)
                    if: at = 4 && l2_msrc_at(sl, k, aj) >= 0 && c.fprintf(l2_out, "%sl2_malias: lmx_arena_ref_struct(l2_mresult, %dU)\n%sif: l2_malias = 0 || l2_malias != lmx_arena_ref_struct(%s, %uU)\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 77\\n\")\n%s    c.abort()\n", ind, l2_msrc_at(sl, k, aj), ind, l2_unit_ref, (cast: (unsigned) (l2_unit_base + au)), ind, ind) < 0
                        return: 1
                    if: at = 4 && l2_first_own_child(au) >= 0 && l2_msrc_at(sl, k, aj) >= 0 && c.fprintf(l2_out, "%sl2_mxp: lmx_arena_ref_cell(l2_malias, %uU)\n%sl2_myp: lmx_arena_ref_cell(lmx_arena_ref_struct(%s, %uU), %uU)\n%sif: l2_mxp = 0 || l2_myp = 0 || l2_mxp[0] != l2_myp[0]\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 79\\n\")\n%s    c.abort()\n", ind, (cast: (unsigned) l2_first_own_child(au)), ind, l2_unit_ref, (cast: (unsigned) (l2_unit_base + au)), (cast: (unsigned) l2_first_own_child(au)), ind, ind, ind) < 0
                        return: 1
                    aj: aj + 1
                ---
                aj: 0
                while: ni >= 0 && aj < l2_ns_count[ni]
                    if: l2_ns_field_kind(ni, aj) = 0 && l2_msrc_at(sl, k, aj) >= 0 && c.fprintf(l2_out, "%sl2_mxp: lmx_arena_ref_cell(l2_mresult, %dU)\n%sl2_myp: lmx_arena_ref_cell(lmx_arena_ref_struct(%s, %uU), %dU)\n%sif: l2_mxp = 0 || l2_myp = 0 || l2_mxp[0] = l2_myp[0]\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 90\\n\")\n%s    c.abort()\n", ind, l2_msrc_at(sl, k, aj), ind, l2_unit_ref, (cast: (unsigned) (l2_ns_base + l2_ns_rank(ni))), aj, ind, ind, ind) < 0
                        return: 1
                    if: l2_ns_field_kind(ni, aj) = 5 && l2_ns_field_len(ni, aj) > 0U && l2_msrc_at(sl, k, aj) >= 0 && c.fprintf(l2_out, "%sl2_mxp: lmx_arena_ref_cell(l2_mresult, %dU)\n%sl2_myp: lmx_arena_ref_cell(lmx_arena_ref_struct(%s, %uU), %dU)\n%sif: l2_mxp = 0 || l2_myp = 0 || l2_mxp[0] = l2_myp[0]\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 91\\n\")\n%s    c.abort()\n%sif: (cast: (@: LmxArrayDesc) l2_mxp[0])\\len != %zuU\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 91\\n\")\n%s    c.abort()\n%sif: (cast: (@: LmxArrayDesc) l2_mxp[0])\\data = (cast: (@: LmxArrayDesc) l2_myp[0])\\data\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 91\\n\")\n%s    c.abort()\n", ind, l2_msrc_at(sl, k, aj), ind, l2_unit_ref, (cast: (unsigned) (l2_ns_base + l2_ns_rank(ni))), aj, ind, ind, ind, ind, l2_ns_field_len(ni, aj), ind, ind, ind, ind, ind) < 0
                        return: 1
                    if: l2_ns_field_kind(ni, aj) = 5 && l2_ns_field_len(ni, aj) = 0U && l2_msrc_at(sl, k, aj) >= 0 && c.fprintf(l2_out, "%sl2_mxp: lmx_arena_ref_cell(l2_mresult, %dU)\n%sl2_myp: lmx_arena_ref_cell(lmx_arena_ref_struct(%s, %uU), %dU)\n%sif: l2_mxp = 0 || l2_myp = 0 || l2_mxp[0] = l2_myp[0]\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 91\\n\")\n%s    c.abort()\n%sif: (cast: (@: LmxArrayDesc) l2_mxp[0])\\len != 0U || (cast: (@: LmxArrayDesc) l2_mxp[0])\\data != 0 || (cast: (@: LmxArrayDesc) l2_myp[0])\\data != 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 91\\n\")\n%s    c.abort()\n", ind, l2_msrc_at(sl, k, aj), ind, l2_unit_ref, (cast: (unsigned) (l2_ns_base + l2_ns_rank(ni))), aj, ind, ind, ind, ind, ind, ind) < 0
                        return: 1
                    if: l2_ns_field_kind(ni, aj) = 6 && l2_msrc_at(sl, k, aj) >= 0 && c.fprintf(l2_out, "%sl2_mxp: lmx_arena_ref_cell(l2_mresult, %dU)\n%sl2_myp: lmx_arena_ref_cell(lmx_arena_ref_struct(%s, %uU), %dU)\n%sif: l2_mxp = 0 || l2_myp = 0 || l2_mxp[0] = l2_myp[0]\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 91\\n\")\n%s    c.abort()\n%sif: (cast: (@: LmxArrayDesc) l2_mxp[0])\\len != 0U || (cast: (@: LmxArrayDesc) l2_mxp[0])\\data != 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 91\\n\")\n%s    c.abort()\n", ind, l2_msrc_at(sl, k, aj), ind, l2_unit_ref, (cast: (unsigned) (l2_ns_base + l2_ns_rank(ni))), aj, ind, ind, ind, ind, ind, ind) < 0
                        return: 1
                    if: l2_ns_field_kind(ni, aj) = 3 && l2_ns_eternal[l2_ns_field_ref(ni, aj)] >= 0 && l2_msrc_at(sl, k, aj) >= 0 && c.fprintf(l2_out, "%sl2_mxp: lmx_arena_ref_cell(l2_mresult, %dU)\n%sif: l2_mxp = 0 || l2_mxp[0] != (cast: (@: void) lmx_arena_ref_struct(%s, %uU))\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 80\\n\")\n%s    c.abort()\n", ind, l2_msrc_at(sl, k, aj), ind, l2_unit_ref, (cast: (unsigned) (l2_unit_base + l2_occ_n() + l2_ns_eternal[l2_ns_field_ref(ni, aj)])), ind, ind) < 0
                        return: 1
                    aj: aj + 1
                ---
                last: l2_next_active(last\next)
                k: k + 1
            ---
            # and the CONTENT it was promised: the first and the last slot carry the values
            # the map says they hold -- the model's first field or the later field written
            # into it, the last field added (the body's last when there is a body). A shape
            # check alone would pass a copy that moved the right number of wrong values.
            mrw: l2_mrs_row(sl, 0)
            if: mrw >= 0 && l2_mrs_vk[mrw] = 1 && c.fprintf(l2_out, "%sl2_mxp: lmx_arena_ref_cell(l2_mresult, 0U)\n%sif: l2_mxp = 0 || lmx_size_value_known(l2_mxp[0]) != %zuU\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 72\\n\")\n%s    c.abort()\n", ind, ind, l2_mrs_val[mrw], ind, ind) < 0
                return: 1
            if: mrw >= 0 && l2_mrs_vk[mrw] = 2 && c.fprintf(l2_out, "%sl2_mxp: lmx_arena_ref_cell(l2_mresult, 0U)\n%sif: l2_mxp = 0 || lmx_char_value_known(l2_mxp[0]) != %d\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 72\\n\")\n%s    c.abort()\n", ind, ind, (cast: (int) l2_mrs_val[mrw]), ind, ind) < 0
                return: 1
            mrw: l2_mrs_row(sl, bw - 1)
            if: mrw >= 0 && l2_mrs_vk[mrw] = 1 && c.fprintf(l2_out, "%sl2_mxp: lmx_arena_ref_cell(l2_mresult, %dU)\n%sif: l2_mxp = 0 || lmx_size_value_known(l2_mxp[0]) != %zuU\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 73\\n\")\n%s    c.abort()\n", ind, bw - 1, ind, l2_mrs_val[mrw], ind, ind) < 0
                return: 1
            if: mrw >= 0 && l2_mrs_vk[mrw] = 2 && c.fprintf(l2_out, "%sl2_mxp: lmx_arena_ref_cell(l2_mresult, %dU)\n%sif: l2_mxp = 0 || lmx_char_value_known(l2_mxp[0]) != %d\n%s    c.fprintf(c.stderr, \"lmx: invariant: merge result check 73\\n\")\n%s    c.abort()\n", ind, bw - 1, ind, (cast: (int) l2_mrs_val[mrw]), ind, ind) < 0
                return: 1
            # The result is bound under its source name: a reserved unit child.
            if: c.fprintf(l2_out, "%sif: lmx_arena_ref_store(%s, %uU, (cast: (@: void) l2_mresult)) != 0\n", ind, l2_unit_ref, (cast: (unsigned) (l2_mres_base + sl))) < 0
                return: 1
            if: l2_emit_invariant(ind, "merge result not bound to its name") != 0
                return: 1
            field: l2_next_active(field\next)
            need_cut: 1
            continue
        ---
        # An indexed final segment (root\name[idx]) is a case of the own
        # array store, tried before FIELD PATHS below exactly as
        # l2_check_body already orders its own copy of this same check
        # ahead of the path guards (FABLE-SONNET-ARRAY-WRITE-DISPATCH-
        # 20260923-119): an Array-typed own field followed by an index is
        # not a competing path that needs the head to have escaped
        # l2_is_path_head, it is resolved first, uniformly, whether or not
        # the root is also a general path root (fresh\buf[0], not just the
        # legacy node\/for\).
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && l2_own_index_head(stmt\as\frame\head, mi, @ array_own, @ array_index) = 0
            fr: stmt\as\frame
            if: l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0 || l2_emit_array_ptr(array_own, ind, array_ptr) != 0
                return: 1
            if: c.fprintf(l2_out, "%s%s[%zuU]: %s\n", ind, array_ptr, array_index, l2_tok) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        ---
        # ---------------------------------------------------------------
        # FIELD PATHS. In UPDATE position the whole path is the statement head
        # and the single body item is the value:  R\x: 5U
        # In VALUE position it is the body of an ordinary assignment, spelled
        # as atoms around separator atoms:        v: R\x
        # Both roots are reserved children of the program UNIT, which inside a
        # method is its fixed above-method lexical space rather than a name in
        # scope.
        # l2_emit_path spells that root through l2_unit_ref, so the same walk
        # serves every method body, the entry E included.
        # ---------------------------------------------------------------
        l2_pn: 0U
        if: stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && l2_is_path_head(stmt\as\frame\head) != 0 && l2_head_is_call(stmt\as\frame\head, stmt\as\frame\body, stmt\as\frame\flags, mi) = 0 && l2_raw_index_head(stmt\as\frame\head, mi) != 0
            if: l2_path_in_eternal(stmt\as\frame\head\data, stmt\as\frame\head\length) != 0
                return: l2_error(l2_src, stmt, "an eternal branch field cannot be updated")
            if: l2_emit_path(stmt\as\frame\head\data, stmt\as\frame\head\length, mi, ind, stmt, @ l2_pkind) != 0
                return: 1
            # A literal RHS parses directly. Any other shape (a name, a call, an
            # expression) evaluates through l2_eval_fields exactly like an
            # ordinary own-field assignment's RHS does -- the generality the old
            # node/for write block had (FABLE-L2-ARG-ADDRESS-DIRTY-20260921-67's
            # `node\x: hi` case), lost when FABLE-SONNET-NODE-ROOT-20260923-121
            # folded node/for writes into this general path-write branch (which
            # only ever parsed a literal), restored here rather than left a
            # silent narrowing of what a path write accepts.
            l2_prhs_lit: l2_path_rhs(stmt\as\frame\body, l2_pkind, @ l2_pv) = 0
            if: l2_prhs_lit = 0 && l2_eval_fields(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), mi, ind, l2_tok) != 0
                return: 1
            # A size_t assignment writes the addressed cell IN PLACE. A char
            # assignment REBINDS the field pointer cell to the cell of the new
            # character; the character bytes of the table are never written.
            if: l2_pkind = 0 && l2_prhs_lit != 0 && c.fprintf(l2_out, "%sif: lmx_size_store_known(l2_pxp[0], %zuU) != 0\n", ind, l2_pv) < 0
                return: 1
            if: l2_pkind = 0 && l2_prhs_lit = 0 && c.fprintf(l2_out, "%sif: lmx_size_store_known(l2_pxp[0], %s) != 0\n", ind, l2_tok) < 0
                return: 1
            if: l2_pkind = 1 && l2_prhs_lit != 0 && c.fprintf(l2_out, "%sl2_pxp[0]: lmx_char_rebind_known(l2_pxp[0], %d)\n%sif: l2_pxp[0] = 0\n", ind, (cast: (int) l2_pv), ind) < 0
                return: 1
            if: l2_pkind = 1 && l2_prhs_lit = 0 && c.fprintf(l2_out, "%sl2_pxp[0]: lmx_char_rebind_known(l2_pxp[0], ((cast: (int) %s) & 255))\n%sif: l2_pxp[0] = 0\n", ind, l2_tok, ind) < 0
                return: 1
            if: l2_pkind = 7 && l2_prhs_lit != 0 && c.fprintf(l2_out, "%sif: lmx_int_store_known(l2_pxp[0], %d) != 0\n", ind, (cast: (int) l2_pv)) < 0
                return: 1
            if: l2_pkind = 7 && l2_prhs_lit = 0 && c.fprintf(l2_out, "%sif: lmx_int_store_known(l2_pxp[0], %s) != 0\n", ind, l2_tok) < 0
                return: 1
            if: l2_pkind = 8 && l2_prhs_lit != 0 && c.fprintf(l2_out, "%sif: lmx_unsigned_store_known(l2_pxp[0], %zuU) != 0\n", ind, l2_pv) < 0
                return: 1
            if: l2_pkind = 8 && l2_prhs_lit = 0 && c.fprintf(l2_out, "%sif: lmx_unsigned_store_known(l2_pxp[0], %s) != 0\n", ind, l2_tok) < 0
                return: 1
            if: l2_pkind = 9 && l2_prhs_lit != 0 && c.fprintf(l2_out, "%sif: lmx_ulong_store_known(l2_pxp[0], %zuU) != 0\n", ind, l2_pv) < 0
                return: 1
            if: l2_pkind = 9 && l2_prhs_lit = 0 && c.fprintf(l2_out, "%sif: lmx_ulong_store_known(l2_pxp[0], %s) != 0\n", ind, l2_tok) < 0
                return: 1
            # A reference field (FABLE-SONNET-SEND-REF-20260925-172 commit 1,
            # RESTORED in commit 4: l2_pxp is the SLOT's own address (a
            # pointer CELL's address per the author's Q26.2 ruling -- a
            # reference is a reference TO a reference, not the pointee
            # stored directly), so the store goes THROUGH the cell like any
            # other own-storage pointer write. Never a literal RHS
            # (l2_path_rhs does not recognize one for this kind), so only
            # the l2_eval_fields token side applies.
            if: (l2_pkind = 10 || l2_pkind = 11) && c.fprintf(l2_out, "%sif: lmx_pointer_store_known(l2_pxp[0], (cast: (@: void) %s)) != 0\n", ind, l2_tok) < 0
                return: 1
            if: l2_emit_path_bail(mi, ind) != 0
                return: 1
            field: l2_next_active(field\next)
            need_cut: 1
            continue
        ---
        if: stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0
            l2_pn: l2_join_path(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), l2_pbuf, 255U)
        # A field path is an ordinary expression: it only claims this statement
        # when the head is a real declared own field (an assignment into that
        # field). Any other head (return, a call argument, ...) falls through
        # to the general expression-value handling below -- a field path used
        # there resolves and reads through l2_eval_fields like any other value.
        if: l2_pn != 0U && l2_path_root(l2_pbuf, l2_pn, @ l2_pni, @ l2_pres, @ l2_poi, @ l2_proot, @ l2_pfi) = 0 && l2_own_find(mi, stmt\as\frame\head) >= 0
            if: l2_emit_path(l2_pbuf, l2_pn, mi, ind, stmt, @ l2_pkind) != 0
                return: 1
            # The destination is an OWN field, stored into its cell like any
            # other own-field assignment. Nothing here is a new category.
            l2_pown: l2_own_find_last(mi, stmt\as\frame\head)
            if: l2_pown < 0
                return: l2_error(l2_src, stmt, "a field path value needs a declared destination")
            if: l2_pown >= 0 && l2_pkind = 0 && l2_own_ty[l2_pown] != 2
                return: l2_error(l2_src, stmt, "a size_t field needs a size_t local")
            if: l2_pown >= 0 && l2_pkind = 1 && l2_own_ty[l2_pown] != 1
                return: l2_error(l2_src, stmt, "a char field needs a char local")
            if: l2_pown >= 0 && l2_pkind = 7 && l2_own_ty[l2_pown] != 0
                return: l2_error(l2_src, stmt, "an int field needs an int local")
            if: l2_pown >= 0 && l2_pkind = 8 && l2_own_ty[l2_pown] != 3
                return: l2_error(l2_src, stmt, "an unsigned field needs an unsigned local")
            if: l2_pown >= 0 && l2_pkind = 9 && l2_own_ty[l2_pown] != 36
                return: l2_error(l2_src, stmt, "a ulong field needs a ulong local")
            if: l2_pkind = 0 && c.sprintf(l2_pval, "lmx_size_value_known(l2_pxp[0])") < 0
                return: 1
            if: l2_pkind = 1 && c.sprintf(l2_pval, "(cast: (char) lmx_char_value_known(l2_pxp[0]))") < 0
                return: 1
            if: l2_pkind = 7 && c.sprintf(l2_pval, "lmx_int_value_known(l2_pxp[0])") < 0
                return: 1
            if: l2_pkind = 8 && c.sprintf(l2_pval, "lmx_unsigned_value_known(l2_pxp[0])") < 0
                return: 1
            if: l2_pkind = 9 && c.sprintf(l2_pval, "lmx_ulong_value_known(l2_pxp[0])") < 0
                return: 1
            # -189 c3b-1: a plain own local takes the value in its cell.
            if: l2_own_direct(mi, l2_pown) != 0 && l2_own_store(mi, l2_pown, ind, l2_pval) != 0
                return: 1
            if: l2_own_direct(mi, l2_pown) = 0 && c.fprintf(l2_out, "%sl2_q%d: %s\n%sl2_q%d_dirty: 1\n", ind, l2_pown, l2_pval, ind, l2_pown) < 0
                return: 1
            field: l2_next_active(field\next)
            need_cut: 1
            continue
        ---

        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: l2_eval_fields(fr\body\first_field, n - 1, mi, ind, l2_tok) != 0
                return: 1
            if: c.fprintf(l2_out, "%sif: %s\n", ind, l2_tok) < 0
                return: 1
            if: l2_scope_push(last\value) != 0
                return: 1
            if: l2_emit_body(last\value\as\structure, mi, deep) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            # The P0 tree has already consumed indentation cutters, so every
            # emitted nested body needs an explicit L1 cutter before its next
            # sibling. Depending on fr.trailer loses source `---` tokens.
            if: c.fprintf(l2_out, "%s---\n", deep) < 0
                return: 1
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && c.fprintf(l2_out, "%selse:\n", ind) < 0
                return: 1
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                if: l2_scope_push(nxt\value) != 0
                    return: 1
                if: l2_emit_body(nxt\value\as\frame\body, mi, deep) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
                if: c.fprintf(l2_out, "%s---\n", deep) < 0
                    return: 1
                ---
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            need_cut: 1
            ---
        if: l2_frame_head(stmt, "while")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            wkeep[0]: 0
            wcond[0]: 0
            if: l2_bump_ind(deep, @ wdeep) != 0
                return: 1
            if: l2_new_temp(ind, wkeep) != 0
                return: 1
            if: c.fprintf(l2_out, "%s%s: 1\n", ind, wkeep) < 0
                return: 1
            if: l2_new_temp(ind, wcond) != 0
                return: 1
            if: c.fprintf(l2_out, "%swhile: %s\n", ind, wkeep) < 0
                return: 1
            if: l2_eval_cond(fr\body\first_field, n - 1, mi, deep, wcond) != 0
                return: 1
            if: c.fprintf(l2_out, "%sif: %s = 0\n", deep, wcond) < 0
                return: 1
            if: c.fprintf(l2_out, "%s    %s: 0\n", deep, wkeep) < 0
                return: 1
            if: c.fprintf(l2_out, "%sif: %s\n", deep, wkeep) < 0
                return: 1
            if: l2_emit_poll(mi, wdeep) != 0
                return: 1
            l2_loop_depth: l2_loop_depth + 1
            if: l2_scope_push(last\value) != 0 || l2_lp_push(0, 0 - 1) != 0
                l2_loop_depth: l2_loop_depth - 1
                return: 1
            if: l2_emit_body(last\value\as\structure, mi, wdeep) != 0
                l2_scope_pop()
                l2_loop_depth: l2_loop_depth - 1
                return: 1
            l2_lp_pop()
            l2_scope_pop()
            l2_loop_depth: l2_loop_depth - 1
            if: c.fprintf(l2_out, "%send: while\n", ind) < 0
                return: 1
            if: l2_emit_loop_exit(0 - 1, ind) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "for")
            fr: stmt\as\frame
            if: l2_for_cstyle(stmt) = 0
                return: 1
            last: l2_next_active(fr\body\first_field)
            if: l2_scope_push(stmt) != 0
                return: 1
            wkeep[0]: 0
            wcond[0]: 0
            wfirst[0]: 0
            if: l2_bump_ind(deep, @ wdeep) != 0
                l2_scope_pop()
                return: 1
            oi: l2_own_find(mi, l2_next_active(last\value\as\frame\body\first_field)\value\as\atom)
            if: oi < 0
                l2_scope_pop()
                return: 1
            if: l2_eval_fields(l2_next_active(l2_next_active(last\value\as\frame\body\first_field)\next), 1, mi, ind, l2_tok) != 0
                l2_scope_pop()
                return: 1
            if: l2_own_direct(mi, oi) != 0 && l2_own_store(mi, oi, ind, l2_tok) != 0
                l2_scope_pop()
                return: 1
            if: l2_own_direct(mi, oi) = 0 && c.fprintf(l2_out, "%sl2_q%d: %s\n%sl2_q%d_dirty: 1\n", ind, oi, l2_tok, ind, oi) < 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(last\next)
            if: l2_new_temp(ind, wkeep) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%s%s: 1\n", ind, wkeep) < 0
                l2_scope_pop()
                return: 1
            if: l2_new_temp(ind, wfirst) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%s%s: 1\n", ind, wfirst) < 0
                l2_scope_pop()
                return: 1
            if: l2_new_temp(ind, wcond) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%swhile: %s\n", ind, wkeep) < 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%sif: %s = 0\n", deep, wfirst) < 0
                l2_scope_pop()
                return: 1
            nxt: l2_next_active(last\next)
            if: nxt = 0 || nxt\value = 0 || nxt\value\kind != c.LM_P0_NODE_ATOM
                l2_scope_pop()
                return: 1
            si: l2_own_find(mi, nxt\value\as\atom)
            if: si < 0
                l2_scope_pop()
                return: 1
            nxt: l2_next_active(nxt\next)
            # -189 c3b-1: a plain counter steps in its cell.
            if: l2_own_direct(mi, si) != 0
                if: c.sprintf(l2_dind, "%s    ", deep) < 0 || l2_own_load(si, l2_pval) != 0
                    l2_scope_pop()
                    return: 1
                if: nxt != 0 && nxt\value != 0 && l2_text_eq(nxt\value\as\atom, "--") && c.sprintf(l2_pval2, "%s - 1", l2_pval) < 0
                    l2_scope_pop()
                    return: 1
                if: (nxt = 0 || nxt\value = 0 || l2_text_eq(nxt\value\as\atom, "--") = 0) && c.sprintf(l2_pval2, "%s + 1", l2_pval) < 0
                    l2_scope_pop()
                    return: 1
                if: l2_own_store(mi, si, l2_dind, l2_pval2) != 0
                    l2_scope_pop()
                    return: 1
            ---
            if: l2_own_direct(mi, si) = 0 && nxt != 0 && nxt\value != 0 && l2_text_eq(nxt\value\as\atom, "--") && c.fprintf(l2_out, "%s    l2_q%d: l2_q%d - 1\n%s    l2_q%d_dirty: 1\n", deep, si, si, deep, si) < 0
                l2_scope_pop()
                return: 1
            if: l2_own_direct(mi, si) = 0 && nxt != 0 && nxt\value != 0 && l2_text_eq(nxt\value\as\atom, "--") = 0 && c.fprintf(l2_out, "%s    l2_q%d: l2_q%d + 1\n%s    l2_q%d_dirty: 1\n", deep, si, si, deep, si) < 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%s%s: 0\n", deep, wfirst) < 0
                l2_scope_pop()
                return: 1
            if: last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                l2_scope_pop()
                return: 1
            if: l2_eval_cond(last\value\as\structure\first_field, l2_count_active(last\value\as\structure), mi, deep, wcond) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%sif: %s = 0\n", deep, wcond) < 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%s    %s: 0\n", deep, wkeep) < 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%sif: %s\n", deep, wkeep) < 0
                l2_scope_pop()
                return: 1
            if: l2_emit_poll(mi, wdeep) != 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < 5
                last: l2_next_active(last\next)
                k: k + 1
            l2_loop_depth: l2_loop_depth + 1
            if: l2_lp_push(0, 0 - 1) != 0 || last = 0 || last\value = 0 || last\value\as = 0 || l2_emit_body(last\value\as\structure, mi, wdeep) != 0
                l2_loop_depth: l2_loop_depth - 1
                l2_scope_pop()
                return: 1
            l2_lp_pop()
            l2_loop_depth: l2_loop_depth - 1
            if: c.fprintf(l2_out, "%send: while\n", ind) < 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            if: l2_emit_loop_exit(0 - 1, ind) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "continue")
            if: l2_lp_n > 0 && l2_lpk[l2_lp_n - 1] = 1 && c.fprintf(l2_out, "%sl2_uc%d: 1\n%sbreak\n", ind, l2_lpp[l2_lp_n - 1], ind) < 0
                return: 1
            if: (l2_lp_n = 0 || l2_lpk[l2_lp_n - 1] = 0) && c.fprintf(l2_out, "%scontinue\n", ind) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "break")
            if: l2_lp_n > 0 && l2_lpk[l2_lp_n - 1] = 1 && c.fprintf(l2_out, "%sl2_ub%d: 1\n%sbreak\n", ind, l2_lpp[l2_lp_n - 1], ind) < 0
                return: 1
            if: (l2_lp_n = 0 || l2_lpk[l2_lp_n - 1] = 0) && c.fprintf(l2_out, "%sbreak\n", ind) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "return") && l2_m_ret[mi] = 8
            if: l2_emit_poll(mi, ind) != 0
                return: 1
            if: c.fprintf(l2_out, "%sreturn\n", ind) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && l2_text_eq(stmt\as\atom, "return")
            return: 1
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0
            pd: l2_prefix_deref(stmt\as\frame\head, mi, ind, pdest)
        if: pd = 0
            fr: stmt\as\frame
            if: fr\body = 0 || fr\trailer != 0 || fr\body\trailer != 0 || l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
                return: 1
            if: c.fprintf(l2_out, "%s%s: %s\n", ind, pdest, l2_tok) < 0
                return: 1
            field: l2_next_active(field\next)
            pd: 1
            continue
        ---
        ix: 1
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0
            ix: l2_index_head(stmt\as\frame\head, mi, @ rj)
        if: ix = 0
            fr: stmt\as\frame
        if: ix = 0 && (fr\body = 0 || fr\trailer != 0)
            return: 1
        if: ix = 0 && l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 1
        if: ix = 0 && l2_index_token(stmt\as\frame\head, mi, ind, index_tok) != 0
            return: 1
        if: ix = 0
            l2_pn: 0U
            while: l2_pn < fr\head\length && fr\head\data[l2_pn] != 91
                l2_pn: l2_pn + 1U
            ---
        if: ix = 0 && rj < l2_m_arity[mi] && fr\head\length > l2_fn(mi, rj)\length + 1U && fr\head\data[l2_fn(mi, rj)\length] = 92 && c.fprintf(l2_out, "%sl2_p%d_%d\\%.*s[%s]: %s\n", ind, mi, rj, (cast: (int) (l2_pn - l2_fn(mi, rj)\length - 1U)), fr\head\data + l2_fn(mi, rj)\length + 1U, index_tok, l2_tok) < 0
            return: 1
        if: ix = 0 && rj < l2_m_arity[mi] && (fr\head\length <= l2_fn(mi, rj)\length || fr\head\data[l2_fn(mi, rj)\length] != 92) && c.fprintf(l2_out, "%sl2_p%d_%d[%s]: %s\n", ind, mi, rj, index_tok, l2_tok) < 0
            return: 1
        if: ix = 0 && rj >= l2_m_arity[mi] && rj < l2_m_arity[mi] + l2_m_sn[mi] && c.fprintf(l2_out, "%sl2_s%d_%d[%s]: %s\n", ind, mi, rj - l2_m_arity[mi], index_tok, l2_tok) < 0
            return: 1
        if: ix = 0 && rj >= l2_m_arity[mi] + l2_m_sn[mi] && c.fprintf(l2_out, "%s%.*s[%s]: %s\n", ind, (cast: (int) l2_pn), fr\head\data, index_tok, l2_tok) < 0
            return: 1
        if: ix = 0
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "continue") || l2_frame_head(stmt, "break")
            return: 1
        n: l2_emit_loc_stmt(stmt, mi, ind)
        if: n = 2
            return: 1
        if: n = 0
            field: l2_next_active(field\next)
            continue
        # sendMessage: X (FABLE-SONNET-SEND-IN-METHODS-20260925-168 commit 2) -- see
        # l2_emit_msend's own comment; l2_check_body already validated and registered the shape.
        if: l2_frame_head(stmt, "sendMessage") != 0
            if: l2_emit_msend(stmt, mi, ind) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # receiveMessage: m -- take the next admitted letter of the current Thread
        # (the owner attaches its arena before exposing it) and assign m its
        # graph, or 0 when the inbox is empty: m's slot takes it (l2_own_store; -189
        # c3b-3, an own Structure field is a direct slot).  A slot that cannot be
        # stored is an invariant failure (X1, -128), never a throw.
        if: l2_receive_msg_shape(stmt, @ cname, 0) = 0
            oi: l2_own_find_last(mi, cname)
            if: oi < 0
                return: l2_error(l2_src, stmt, "unresolved name")
            if: c.fprintf(l2_out, "%sl2_nmsg: (cast: (@: LmxMsg) lmx_thread_mail_take(lmx_thread_current(), c.LMX_POST_INBOX))\n%sl2_ngraph: 0\n%sif: l2_nmsg != 0\n%s    l2_ngraph: l2_nmsg\\graph\n", ind, ind, ind, ind) < 0
                return: 1
            # A field of a declared Structure type, in the one-name form `T: m` / `receiveMessage:
            # m`, takes the letter's payload, admitted to its type (D-57; q25 (ii): the field holds
            # what its declaration says).  The two-name form `receiveMessage: m T` (-172 c2) types m
            # with the synthesized letter model, and m holds the whole letter.
            if: l2_own_nsty_get(oi) >= 0 && l2_count_active(stmt\as\frame\body) = 1 && c.fprintf(l2_out, "%sl2_ngraph: (cast: (@: Lmx) lmx_arena_ref_value(l2_ngraph, 1U))\n", ind) < 0
                return: 1
            if: l2_own_nsty_get(oi) >= 0 && l2_emit_admit(mi, l2_own_nsty_get(oi), "l2_ngraph", ind) != 0
                return: 1
            if: l2_own_store(mi, oi, ind, "l2_ngraph") != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # Model: fresh, emitted inline at its own lexical position every
        # activation -- the own field l2_check_body already registered gets
        # a fresh merge(Model, empty) each time execution reaches this
        # statement, not one shared value hoisted to unit-construction time.
        # Model and the merge's lexical parent are the unit, spelled like
        # every other merge (`node` in a method, `self` in the entry E).
        # The result binds the field's slot at once (l2_own_store; -189 c3b-3):
        # a bare read and a field path read the same slot, so the next
        # operation on the name sees the merge (FABLE-SONNET-NODE-ROOT-
        # 20260923-121 measured a deferred write reading the pre-merge cell).
        if: l2_colon_decl_shape(stmt, @ cmodel, @ cname) = 0
            oi: l2_own_find_last(mi, cname)
            cni: l2_ns_find(cmodel)
            if: oi < 0 || cni < 0
                return: l2_error(l2_src, stmt, "unresolved name")
            if: c.fprintf(l2_out, "%sl2_mops[0U]: lmx_arena_ref_struct(%s, %uU)\n%sl2_mbody: 0\n%sl2_mstatus: lmx_merge_owned(l2_mops, 1U, l2_mbody, %s, 0, l2_program_arena, l2_program_arena, 0, 0U, @ l2_mresult)\n%sif: l2_mstatus != 0 || l2_mresult = 0\n", ind, l2_unit_ref, (cast: (unsigned) (l2_ns_base + l2_ns_rank(cni))), ind, ind, l2_unit_ref, ind) < 0
                return: 1
            if: l2_emit_implicit_throw(mi, "merge", ind) != 0
                return: 1
            if: l2_own_store(mi, oi, ind, "(cast: (@: void) l2_mresult)") != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # `f()`/`f: ()`/closed empty vertical, name absent (FABLE-SONNET-
        # EMPTY-STRUCT-20260923-132): the row l2_check_body already
        # registered gets a fresh, genuinely empty Lmx node every
        # activation -- the same lmx_node_new_owned the unit root and a
        # merge result body use, but with NO lmx_arena_refs_open_owned
        # call: that refuses a 0-children count outright (lmx_arena_refs
        # .lm1), and a 0-field structural type has none to open. No
        # lmx_merge_owned either -- there is no model to merge a
        # declaration from, so nothing here can fail on admission the way
        # `Model: fresh` can; only allocation, the same class the unit
        # root's own construction already leaves as a bare propagated
        # failure, not a caught throw.
        if: l2_empty_struct_decl_shape(stmt, mi) != 0
            oi: l2_own_find(mi, stmt\as\frame\head)
            if: oi < 0
                return: l2_error(l2_src, stmt, "unresolved name")
            if: c.fprintf(l2_out, "%s@: Lmx l2_t%d\n%sl2_t%d: lmx_node_new_owned(l2_program_arena)\n%sif: l2_t%d = 0\n", ind, l2_tn, ind, l2_tn, ind, l2_tn) < 0
                return: 1
            if: l2_emit_invariant(ind, "a fresh empty Structure did not allocate") != 0
                return: 1
            if: c.sprintf(l2_esd_tok, "(cast: (@: void) l2_t%d)", l2_tn) < 0
                return: 1
            l2_tn: l2_tn + 1
            if: l2_own_store(mi, oi, ind, l2_esd_tok) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # `f()` when f already binds an ordinary Structure (l2_empty_struct_assign_shape): a fresh
        # empty Structure, admitted to f's declared Structure type when it has one -- the S3
        # admission, whose refusal is the implicit throw implements -- then bound as any graph
        # assignment is (the S3 rebinding path below): its slot takes it (l2_own_store).  A declared
        # named Structure takes it as its unit child, as a merge result does.
        easn: l2_empty_struct_assign_shape(stmt, mi)
        if: easn != 0
            if: c.fprintf(l2_out, "%s@: Lmx l2_t%d\n%sl2_t%d: lmx_node_new_owned(l2_program_arena)\n%sif: l2_t%d = 0\n", ind, l2_tn, ind, l2_tn, ind, l2_tn) < 0
                return: 1
            if: l2_emit_invariant(ind, "a fresh empty Structure did not allocate") != 0
                return: 1
            if: c.sprintf(l2_esd_tok, "l2_t%d", l2_tn) < 0
                return: 1
            l2_tn: l2_tn + 1
            if: easn = 2
                ni: l2_ns_find(stmt\as\frame\head)
                if: l2_emit_admit(mi, ni, l2_esd_tok, ind) != 0
                    return: 1
                if: c.fprintf(l2_out, "%sif: lmx_arena_ref_store(%s, %uU, (cast: (@: void) %s)) != 0\n", ind, l2_unit_ref, (cast: (unsigned) (l2_ns_base + l2_ns_rank(ni))), l2_esd_tok) < 0
                    return: 1
                if: l2_emit_invariant(ind, "a named Structure did not take its assigned value") != 0
                    return: 1
