predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/tests/walk_contract_fixture.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_primitive.h.lm1"
predef: "l2src/lmx_merge_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# The walked receiving instruction with the coverage of its own place (ADMIT_AS,
# fullReceiver 2; Codex, FABLE-CODEX-20261003-01 and -20261004-01). The coverage
# stands in the instruction's cells after the fixed nine, its first cell its
# count of cells; the maps follow it. What this file pins:
#
#   * a candidate that lacks a field the coverage does not name is received, the
#     exact candidate, evaluated once, and recorded with its places;
#   * the same candidate is refused, `implements` thrown, by a coverage that
#     names the field it lacks, and by full reception; a refusal records nothing
#     and the pad of `implements` in the enclosing body takes it (no row on the
#     instruction: lmx_walk.h, LMX_WALK_NAME_IMPLEMENTS);
#   * a coverage that names no field receives a candidate with none of the
#     model's fields;
#   * a recorded candidate met without a selected map answers by the coverage of
#     the instruction that meets it, never by its record alone;
#   * a malformed coverage is an invalid instruction, not a reception.
#
# The model: [0] a int, [1] b size_t. Width 2: edge 2 is bare `a`, edge 3 bare `b`.

@: LmxArena ga 0
@: Lmx groles 0
@: LmxWalkContext gctx 0
@: LmxWalkValue gv 0
int: broken 0
int: checks 0
int: failures 0
int: producer_calls 0
@: void produced_value 0
[]: char schema_tokens 3

fn: produce (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    producer_calls: producer_calls + 1
    \out: produced_value
return: 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(ga, groles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(ga, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

sub: ref (@: Lmx code; size_t: slot; @: Lmx target)
    if: code = 0 || target = 0 || lmx_arena_ref_store(code, slot, (cast: (@: void) target)) != 0
        broken: broken + 1
    ---
end: ref

sub: token (@: Lmx code; size_t: slot; size_t: index)
    if: lmx_walk_store_charptr(ga, code, slot, schema_tokens + index) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: token

sub: sz (@: Lmx code; size_t: slot; size_t: value)
    if: code = 0 || lmx_walk_store_size(ga, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: sz

fn: go (@: Lmx m) int
    if: m = 0 || gctx = 0 || gv = 0
        return: c.LMX_WALK_INVALID
return: lmx_walk_run(gctx, m, 0, 0U, gv)

# One receiving instruction under `parent` at `slot`: source token 1, the candidate
# from the producer, the model, no alternative, the coverage (one named edge, or
# none when `edges` is 0) and the default map `a` at a0 / `b` at b0 in both halves.
# `mode` is the instruction's fullReceiver; a mode other than 2 carries no coverage.
fn: admit (@: Lmx parent; size_t: slot; @: Lmx model; @: LmxPrimitive producer; size_t: mode; size_t: edges; size_t: edge; size_t: a0; size_t: b0) @: Lmx
    size_t: cover 0U
    size_t: at
    @: Lmx code
    @: Lmx pn
    if: mode = 2U
        cover: 2U + edges * 2U
    code: fr(parent, slot, c.LMX_WALK_OP_ADMIT_AS, 9U + cover + 4U)
    if: code = 0
        return: 0
    token(code, 1U, 1U)
    ref(code, 4U, model)
    sz(code, 5U, 0U)
    sz(code, 6U, 4U)
    sz(code, 8U, mode)
    at: 9U
    if: mode = 2U
        sz(code, 9U, cover)
        sz(code, 10U, edges)
        if: edges != 0U
            sz(code, 11U, edge)
            sz(code, 12U, 0U)
        ---
        at: 9U + cover
    ---
    sz(code, at, a0)
    sz(code, at + 1U, b0)
    sz(code, at + 2U, a0)
    sz(code, at + 3U, b0)
    pn: fr(code, 3U, c.LMX_WALK_OP_PRIM, 3U)
    ref(pn, 1U, (cast: (@: Lmx) producer))
return: code

fn: main () int
    LmxArena: arena
    LmxArena: context_arena
    LmxPool: context_cells
    LmxScratch: store
    LmxWalkContext: context
    @: Lmx unit 0
    @: Lmx m 0
    @: Lmx n 0
    @: Lmx pn 0
    @: Lmx pad 0
    @: Lmx litn 0
    @: Lmx model 0
    @: Lmx thin_shape 0
    @: Lmx thin 0
    @: Lmx thin2 0
    @: Lmx alien_shape 0
    @: Lmx alien 0
    @: LmxPrimitive producer 0
    size_t: hole (cast: (size_t) -1)
    size_t: slot 99U
    size_t: records 0U
    int: st 0

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        return: 2
    ga: @ arena
    if: lmx_chars_init(ga) != 0
        return: 2
    groles: lmx_walk_roles_open(ga)
    if: groles = 0
        return: 2
    memset((cast: (@: void) (@ context_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxScratch))
    if: lmx_arena_open(@ context_arena) != 0 || lmx_scratch_open(@ store, @ context_arena, @ context_cells, 16U) != c.LMX_SCRATCH_OK
        return: 2
    memset((cast: (@: void) (@ context)), 0, c.sizeof(c.LmxWalkContext))
    context.arena: ga
    context.scratch: @ store
    context.roles: groles
    context.immutable_profile: 0
    context.classified: 0U
    gctx: @ context
    gv: (cast: (@: LmxWalkValue) calloc(1U, c.sizeof(c.LmxWalkValue)))
    if: gv = 0
        return: 2

    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 32U) != 0
        return: 2
    ---
    # The model (a int, b size_t); thin carries a alone; alien carries a size the model does not name.
    model: pl(unit, 1U, 2U)
    thin_shape: pl(unit, 2U, 1U)
    thin: pl(unit, 3U, 1U)
    thin2: pl(unit, 4U, 1U)
    alien_shape: pl(unit, 5U, 1U)
    alien: pl(unit, 6U, 1U)
    lmx_walk_store_int(ga, model, 0U, 1)
    lmx_walk_store_size(ga, model, 1U, 2U)
    lmx_walk_store_int(ga, thin_shape, 0U, 0)
    lmx_walk_store_int(ga, thin, 0U, 41)
    lmx_walk_store_int(ga, thin2, 0U, 42)
    lmx_walk_store_size(ga, alien_shape, 0U, 0U)
    lmx_walk_store_size(ga, alien, 0U, 9U)
    # Genuine layout evidence: each candidate's own completed admission to its own shape.
    check((cast: (int) (lmx_implements_register_map(ga, thin, thin_shape, 0, 0U, (cast: (@: void) (schema_tokens + 1))) = c.LMX_IMPLEMENTS_YES)), "thin did not get its layout evidence")
    check((cast: (int) (lmx_implements_register_map(ga, thin2, thin_shape, 0, 0U, (cast: (@: void) (schema_tokens + 1))) = c.LMX_IMPLEMENTS_YES)), "thin2 did not get its layout evidence")
    check((cast: (int) (lmx_implements_register_map(ga, alien, alien_shape, 0, 0U, (cast: (@: void) (schema_tokens + 1))) = c.LMX_IMPLEMENTS_YES)), "alien did not get its layout evidence")
    producer: (cast: (@: LmxPrimitive) lmx_arena_take(ga, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))
    if: producer = 0
        return: 2
    producer\fn: produce
    producer\signature: wt_contract_same(ga, 0U, c.LMX_TYPE_LMX, c.LMX_TYPE_LMX)
    producer\owner: (cast: (@: Lmx) ga)

    # Full reception refuses the thin candidate: unknown coverage is never an empty one.
    m: pl(unit, 7U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: admit(n, 1U, model, producer, 1U, 0U, 0U, 0U, hole)
    produced_value: (cast: (@: void) thin)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_THROWN + 2 && producer_calls = 1 && lmx_implements_find(ga, thin, model) = 0)), "full reception admitted a candidate that lacks a field")

    # A coverage that names the field it lacks refuses it the same way.
    m: pl(unit, 8U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: admit(n, 1U, model, producer, 2U, 1U, 3U, 0U, hole)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_THROWN + 2 && producer_calls = 2 && lmx_implements_find(ga, thin, model) = 0)), "a coverage that names the missing field admitted the candidate")

    # The refusal is the implicit implements throw: the pad of that key in this body takes it.
    m: pl(unit, 9U, 3U)
    pn: admit(m, 0U, model, producer, 2U, 1U, 3U, 0U, hole)
    pad: fr(m, 1U, c.LMX_WALK_OP_PAD, 3U)
    sz(pad, 1U, (cast: (size_t) c.LMX_WALK_NAME_IMPLEMENTS))
    n: pl(pad, 2U, 0U)
    n: fr(m, 2U, c.LMX_WALK_OP_RET, 2U)
    litn: fr(n, 1U, c.LMX_WALK_OP_LIT, 2U)
    lmx_walk_store_int(ga, litn, 1U, 7)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\type = c.LMX_TYPE_INT && gv\number = 7 && producer_calls = 3)), "a refusal by the coverage did not reach its pad")
    check((cast: (int) (lmx_implements_find(ga, thin, model) = 0)), "a refused reception recorded a correspondence")

    # A coverage that names the field it carries receives the exact candidate, once.
    m: pl(unit, 10U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: admit(n, 1U, model, producer, 2U, 1U, 2U, 0U, hole)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\ref = (cast: (@: void) thin) && producer_calls = 4)), "a coverage of a carried field did not receive the exact candidate once")
    check((cast: (int) (lmx_implements_slot(ga, thin, model, 2U, @ slot) = 0 && slot = 0U && lmx_implements_slot(ga, thin, model, 3U, @ slot) != 0)), "the received candidate's places are not its own")
    records: ga\impl_len

    # The record is places, not permission: met again without a selected map
    # (another source token), each instruction answers by its own coverage.
    m: pl(unit, 11U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: admit(n, 1U, model, producer, 2U, 1U, 3U, 0U, hole)
    token(pn, 1U, 2U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_THROWN + 2 && producer_calls = 5)), "a record waived a field a later coverage names")
    m: pl(unit, 12U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: admit(n, 1U, model, producer, 1U, 0U, 0U, 0U, hole)
    token(pn, 1U, 2U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_THROWN + 2 && producer_calls = 6)), "a record waived a later full reception")
    m: pl(unit, 13U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: admit(n, 1U, model, producer, 2U, 1U, 2U, 0U, hole)
    token(pn, 1U, 2U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) thin) && producer_calls = 7 && ga\impl_len = records)), "a recorded candidate was refused a field it carries, or recorded twice")

    # A coverage that names no field: a candidate with none of the model's fields.
    m: pl(unit, 14U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: admit(n, 1U, model, producer, 2U, 0U, 0U, hole, hole)
    produced_value: (cast: (@: void) alien)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\ref = (cast: (@: void) alien) && producer_calls = 8)), "a coverage that names no field refused a candidate")
    check((cast: (int) (lmx_implements_slot(ga, alien, model, 2U, @ slot) != 0 && lmx_implements_slot(ga, alien, model, 3U, @ slot) != 0)), "a candidate with none of the model's fields got a place")
    # The typed null passes before any coverage is read.
    produced_value: 0
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\ref = 0 && producer_calls = 9)), "the typed null did not pass")

    # A malformed coverage is an invalid instruction: too short to hold a root
    # level, longer than the instruction, an unknown mode.
    produced_value: (cast: (@: void) thin2)
    m: pl(unit, 15U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: admit(n, 1U, model, producer, 2U, 1U, 2U, 0U, hole)
    sz(pn, 9U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_INVALID && lmx_implements_find(ga, thin2, model) = 0)), "a coverage of one cell was run")
    sz(pn, 9U, 9U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_INVALID && lmx_implements_find(ga, thin2, model) = 0)), "a coverage longer than its instruction was run")
    sz(pn, 9U, 4U)
    sz(pn, 8U, 3U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_INVALID && lmx_implements_find(ga, thin2, model) = 0)), "an unknown reception mode was run")
    # A level that claims more pairs than the coverage holds certifies nothing.
    sz(pn, 8U, 2U)
    sz(pn, 10U, 2U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_THROWN + 2 && lmx_implements_find(ga, thin2, model) = 0)), "a level longer than its coverage was taken as a reception")
    sz(pn, 10U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) thin2))), "the restored instruction did not receive its candidate")

    c.printf("lmx_walk_admit_use_selftest checks=%d failures=%d broken=%d\n", checks, failures, broken)
    if: failures != 0 || broken != 0
        return: 1
return: 0
