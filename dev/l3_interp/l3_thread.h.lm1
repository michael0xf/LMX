predef: "l2src/lmx_thread.h.lm1"

# NOT predef'd here: l3_interp/l3_recv.h.lm1 (FABLE-L3-TYPE-BUDGET-SHED-20260921-36).  Nothing in
# this header or in l3_thread.lm1 names a symbol of it -- the Thread path is lmx_interp_apply ->
# lmx_walk, not l3_exec -- and it cost four header type names (L3Frame, L3Result, L3Seen, and
# L3Frame types) in a translation unit whose table of 64 was already full.  A
# unit that needs the receiver's types predefs that header itself.  The budget is CHECKED:
# tools/l3_type_budget.py.

prototype:
    fn: l3_thread_dispatch (@: LmxThread t) int
    # The arena proves that `t` is an exact Thread range, not merely a Message
    # prefix cast upward. Bind validates it before reading any Thread tail.
    fn: l3_thread_bind (@: LmxArena arena; @: LmxThread t) int
    fn: l3_thread_roles (@: LmxThread t) @: Lmx
    fn: l3_thread_plan_roles (@: LmxThread t) @: Lmx
    fn: l3_thread_mail_count_prim (@: LmxThread t) @: Lmx
    fn: l3_thread_mail_take_prim (@: LmxThread t) @: Lmx
    fn: l3_thread_success_prim (@: LmxThread t) @: Lmx
    # The host's exit value (E1): 1 and the int when the bound Thread's last interpreted entry
    # returned an int, 0 otherwise.  The turn's status is not this value.
    fn: l3_thread_result (@: LmxThread t; @: int out) int
end: prototype
