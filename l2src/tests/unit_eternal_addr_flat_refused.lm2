# FABLE-L2-R0-WRITE-GUARD-DESIGN-20260921-111, step M0.  The FLAT spelling, `@ E \tag`, on a char: four fields of an
# argument list instead of one `@:` frame.  It is recognised in another place of the translator, and
# a rule that covered only the frame let this one walk straight past -- so it has a fixture of its own.
independent:
    const:
        immutable:
            (): E
                char: tag 'E'
            end: E
        end: immutable
    end: const
end: independent

fn: pokec (@: char p) int
    \p: 7
    return: 0
end: pokec
pokec(@ E \tag)
return: 0
