# Slice 282 probe: `@: place value` through a free holder (a hidden input): the field is found by its name at run time.  Entry 7.
Inner:
    int: q 2
end: Inner
Other:
    int: q 3
end: Other
Box:
    int: n 1
    fn: f () int
        return: 1
    end: f
    @: p Inner Inner
end: Box
fn: two () int
    return: 2
end: two
int: Hb 0
fn: writes () int
    @: Hb\f two
    @: Hb\p Other
    return: 1
end: writes
fn: through () int
    @: Hb Box Box
    int: done writes()
    return: Box\f() * 10 + Box\p\q
end: through
int: code 7
if: through() != 23
    code: 12
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
