---
    Observed:
        int: seen 90409
    end: Observed
    First:
        int: marker 4
    end: First
    Second:
        int: marker 9
    end: Second
---
@: shared (data [] 0)
Mark:
    int: marker 0
end: Mark
fn: look (@: s Mark) int
    return: (s \ marker)
end: look
fn: c () int
    :=: selected (shared \ Second)
    return: (selected \ marker)
end: c
fn: b () int
    int: before (look selected)
    int: r (c)
    return: ((before * 100) + r)
end: b
fn: a () int
    @: selected (shared \ First)
    int: rb (b)
    return: (((selected \ marker) * 10000) + rb)
end: a
sub: main ()
    :=: ((shared \ Observed) \ seen) (a)
end: main
main:
