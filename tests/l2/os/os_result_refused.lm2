# The same name and arity, another result type: the os branches give the method two contracts.
os:
    win:
        fn: os_size (int: n) int
            return: n
        end: os_size
    default:
        fn: os_size (int: n) unsigned
            return: (cast: (unsigned) n)
        end: os_size
end: os
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
