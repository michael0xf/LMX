DijkstraProcedural:
    return: int
    run:
        throws: copy(DijkstraPick\run\throws) copy(DijkstraRelax\run\throws)
        int: step 0
        while: step < n
            best := -1
            int: vertex 0
            while: vertex < n
                best := DijkstraPick\run(best; vertex)
                vertex += 1
            ---
            if: best = -1
                return: 0
            settled[best] := 1
            @: row graph[best]
            int: i 0
            while: i < length(row)
                DijkstraRelax\run(0; row[i])
                i += 1
            step += 1
        ---
        return: 0
