---
    Observed:
        int: result 7
    end: Observed
---
fn: take (int: value; int: other 2) int
    return: (value + other)
end: take
fn: holder () int
    if: 0 ((take))
    return: 7
end: holder
int: result (holder)
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ result) result
end: main
main:
