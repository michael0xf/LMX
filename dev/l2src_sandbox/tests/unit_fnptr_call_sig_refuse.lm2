predef: "l2src/tests/fnptr_local_forms.h.lm1"

# BATCHC-76: empty-arg ty40 call refuses as a CALL (unsupported body), with no
# assignment fallback. Arity/type admission for fnptr is still open; this pins
# callable-first refuse shape.
fn: probe (const: @(L2TestAllocVTable av)) int
    L2TestAllocFn: f av\alloc
    if: f = 0
        return: 1
    f()
    return: 0
end: probe

fn: main () int
    return: 0
end: main