# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: seen 0
        int: kept 0
)
@: shared data[0]
sub: main () (
    int: hits 4
    D(int: hits 100)
    Bump:
        node\hits := hits + 1
)
    call(D; Bump)
main()
int: seen main\data\hits
int: kept main\data\D\hits

sub: observe ()
    shared\Observed\seen := seen
    shared\Observed\kept := kept
observe()
