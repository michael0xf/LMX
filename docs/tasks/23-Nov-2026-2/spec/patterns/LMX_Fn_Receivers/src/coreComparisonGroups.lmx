# DIRECT CORE OPERATIONS EXTRACTED FROM THE IMPLEMENTATION COMPARISONS.
# No example-local import is required. These bodies use the existing typed
# record/call/Array access contracts; a Structure is already an @[] sequence.

FxFindFirst:
    private:
        @: items
        @: accepts
    required: items accepts
    return: @
    findFirst:
        throws: copy(FxThrows\predicate)
        FxSeqInfo\get(items)
        private: int: count length(items)
        private: int: i 0
        while: i < count
            private: @: value FxSeqRead\read(items; i)
            private: @: accepted FxApply\apply(accepts; FxOne\make(value))
            if: FxSeqPredicate\truth(accepted) != 0
                return: FxSome\some(value := value)
            i += 1
        return: FxNone\none()

# Ordered field/sequence equality, with an explicit equality operation.
# Neither names nor pointer identity silently replace the supplied relation.
# Dense arrays and Structures both use real typed element access. No recursion,
# serializer, hidden conversion, or claim of deep graph equality is introduced.
FxEqualFields:
    private:
        @: first
        @: second
        @: same
    required: first second same
    return: int
    equalFields:
        throws: copy(FxThrows\predicate)
        FxSeqInfo\get(first)
        FxSeqInfo\get(second)
        private: int: count length(first)
        if: count != length(second)
            return: 0
        private: int: i 0
        while: i < count
            private: @: a FxSeqRead\read(first; i)
            private: @: b FxSeqRead\read(second; i)
            private: @: accepted FxApply\apply(same; FxTwo\make(a; b))
            if: FxSeqPredicate\truth(accepted) = 0
                return: 0
            i += 1
        return: 1

FxAllOfTypeToken:
    integer:
        int: value

FxAllOfState:
    @: predicates 0

FxAllOfEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws: FxCallFailure FxKernelFailure FxPredicate FxRecordArity FxTypeToken ReceiverIndex
        private: int: i 0
        while: i < length(state\predicates)
            private: @: predicate \state\predicates[i]
            private: @: flag FxApplyPlaces\apply(predicate; frame)
            if: FxSeqPredicate\truth(flag) = 0
                return: (0 FxRecordOperands\record)
            i += 1
        return: (1 FxRecordOperands\record)

# Arbitrary finite count and arity. A written contract is mandatory only for
# the empty predicate sequence, since there is then no callable to infer from.
# Without it, the first predicate supplies the actual external input policy;
# with it, the chosen contract supplies that policy. All predicates must accept
# the same ordered type signature and return int truth. Forwarded places stay
# lazy; a skipped predicate receives no call and demands no default.
FxAllOf:
    private:
        @: predicates
        @: contract 0
    required: predicates
    return: @
    allOf:
        throws: copy(FxThrows\adapter)
        private: @: values FxSeqRecords\make(source := predicates)
        private: @: selected contract
        private: @: integerType FxKernel\normalizeType(FxAllOfTypeToken\integer[0])
        private: @: policy 0
        if: selected = 0
            if: length(values) = 0
                throw: FxArity()
            private: @: first \values[0]
            private: @: info FxKernel\signature(first)
            selected := FxSignatures\make(info\inputTypes; integerType)
            policy := FxFullPolicy\make(first)
        else:
            policy := FxOwnPolicy\make(selected)
        private: @: shape FxKernel\signature(selected)
        if: shape\hasResult = 0
            throw: FxTypeToken()
        if: \shape\resultType != \integerType
            throw: FxTypeToken()
        private: @: failures (copy(()))
        private: int: i 0
        while: i < length(values)
            private: @: operation \values[i]
            private: @: info FxKernel\signature(operation)
            if: info\hasResult = 0 || length(info\inputTypes) != length(shape\inputTypes)
                throw: FxTypeToken()
            if: \info\resultType != \integerType
                throw: FxTypeToken()
            private: int: position 0
            while: position < length(shape\inputTypes)
                if: \info\inputTypes[position] != \shape\inputTypes[position]
                    throw: FxTypeToken()
                position += 1
            failures := FxFailures\union(failures; info\throws)
            i += 1
        private: @: state (copy(FxAllOfState))
        state\predicates := values
        return: FxWrap\make(selected; FxAllOfEngine\run; state; failures; policy)

# retryPost: asynchronous bounded retry over the existing Message post API.
# Each job is persistent DATA in its sender Message arena, not a captured frame.
# The caller retains the handle until its owner Message can release all waits.
# post itself correlates each response; no numeric request-id registry is built.
# Timeout/cancel stop this policy, NOT an operation already running elsewhere.
# Late replies only drain pending; they cannot publish a second result.
# Result.read() exposes the persisted outcome even if notification is undelivered.
# Control.settled() describes attempt/delay completion, not permission to free
# an arena still retained by any ordinary post route. timeoutMs > maxDelay
# leaves an explicit configured window for a delayed acknowledgement.
# complete is a nonthrowing procedure under the selected protocol; notification
# is one send attempt, not a promise of exactly-once external delivery.

# These internal bridge failures have the explicitly empty () payload.
# User failures retain their original name and typed payload in FxOutcome.
FxRetryEmptyFailure:
    private: char[]: name
    return: @
    make:
        private: @: outcome (copy(FxOutcome))
        outcome\failure := name
        outcome\payload := (copy(()))
        return: outcome

FxRetryPostResult:
    char[]: kind ""
    int: attempts 0
    @: outcome 0

FxRetryPostJob:
    private:
        @: request 0
        @: retryOn 0
        @: delay 0
        @: complete 0
        int: limit 0
        int: pause 0
        int: maxPause 0
        int: timeoutMs 0
        int: attempts 0
        int: completed 0
        int: pending 0
        @: finalResult 0
        int: notificationUndelivered 0
    dispatch:
        if: node\private\completed != 0
            return
        node\private\attempts += 1
        node\private\pending += 1
        private: @: request node\private\request
        post:
            ask:
                request()
            answer:
                Replies\accept
            timeout:
                ms:
                    int: time node\private\timeoutMs
            ---
            undelivered:
                Events\undelivered()
            unanswered:
                Events\unanswered()
            catch: FxKernelFailure ()
                Events\failed("FxKernelFailure")
            catch: FxTypeToken ()
                Events\failed("FxTypeToken")
    ---
    Events:
        char[]: failure
        failed:
            private: @: job parent(node)
            job\private\pending -= 1
            job\Completion\finish("requestFailure"; FxRetryEmptyFailure\make(failure))
        undelivered:
            private: @: job parent(node)
            job\private\pending -= 1
            job\Completion\finish("undelivered"; 0)
        unanswered:
            private: @: job parent(node)
            job\Completion\finish("timeout"; 0)
    ---
    Control:
        cancel:
            private: @: job parent(node)
            private: int: accepted job\private\completed = 0
            job\Completion\finish("cancelled"; 0)
            return: accepted
        return: int
        settled:
            private: @: job parent(node)
            return: job\private\pending = 0
    ---
    Result:
        return: @
        read:
            private: @: job parent(node)
            return: job\private\finalResult
        undelivered:
            private: @: job parent(node)
            job\private\notificationUndelivered := 1
            return: job\private\finalResult
    ---
    Completion:
        char[]: kind
        @: outcome
        finish:
            private: @: job parent(node)
            if: job\private\completed != 0
                return
            private: @: result (copy(FxRetryPostResult))
            result\kind := kind
            result\attempts := job\private\attempts
            result\outcome := outcome
            job\private\finalResult := result
            job\private\completed := 1
            private: @: complete job\private\complete
            post:
                ask:
                    complete(result)
                undelivered:
                    Result\undelivered()
    ---
    Replies:
        @: outcome
        accept:
            private: @: job parent(node)
            job\private\pending -= 1
            if: job\private\completed != 0
                return
            if: job\private\attempts >= job\private\limit
                job\Completion\finish("completed"; outcome)
                return
            private: @: accepted FxApply\apply(job\private\retryOn; FxOne\make(FxRecords\reference(outcome)))
            if: FxSeqPredicate\truth(accepted) = 0
                job\Completion\finish("completed"; outcome)
                return
            private: int: duration job\private\pause
            private: int: maximum job\private\maxPause
            if: duration > maximum - duration
                job\private\pause := maximum
            else:
                job\private\pause := duration + duration
            if: duration = 0
                job\dispatch()
                return
            job\private\pending += 1
            private: @: delay job\private\delay
            post:
                ask:
                    delay(duration)
                answer:
                    job\DelayReply\elapsed
                timeout:
                    ms:
                        int: time job\private\timeoutMs
                ---
                unanswered:
                    DelayReply\unanswered()
                undelivered:
                    DelayReply\undelivered()
            ---
            catch: FxCallFailure (@: failure)
                job\Completion\finish("policyFailure"; failure)
            catch: FxKernelFailure ()
                job\Completion\finish("policyFailure"; FxRetryEmptyFailure\make("FxKernelFailure"))
            catch: FxTypeToken ()
                job\Completion\finish("policyFailure"; FxRetryEmptyFailure\make("FxTypeToken"))
            catch: FxPredicate ()
                job\Completion\finish("policyFailure"; FxRetryEmptyFailure\make("FxPredicate"))
            catch: ReceiverIndex ()
                job\Completion\finish("policyFailure"; FxRetryEmptyFailure\make("ReceiverIndex"))
            catch: FxRecordArity ()
                job\Completion\finish("policyFailure"; FxRetryEmptyFailure\make("FxRecordArity"))
    ---
    DelayReply:
        int: acknowledgement
        unanswered:
            private: @: job parent(node)
            job\Completion\finish("delayTimeout"; 0)
        undelivered:
            private: @: job parent(node)
            job\private\pending -= 1
            job\Completion\finish("delayUndelivered"; 0)
        elapsed:
            private: @: job parent(node)
            job\private\pending -= 1
            if: job\private\completed != 0
                return
            if: acknowledgement != 1
                job\Completion\finish("delayFailure"; 0)
                return
            job\dispatch()

# request is an addressed nullary Message method returning an FxOutcome.
# retryOn(outcome)->int decides explicitly which completed results/failures to
# repeat. A timeout or undelivered request is terminal, so the library never
# silently repeats an operation with an unknown completion state.
# delay(ms)->int is the addressed timer worker acknowledgement, not a void call.
# complete(result)->void is an addressed completion consumer; no ACK is invented.
# Clock waiting belongs to the existing host delay port (MESSAGE_HTTP_PROFILE).
# The complete LMX worker below adapts that port into ordinary Message replies.
FxRetryPost:
    private:
        @: request
        @: retryOn
        int: attempts
        @: delay
        int: firstDelay
        int: maxDelay
        int: timeoutMs
        @: complete
    required: request retryOn attempts delay firstDelay maxDelay timeoutMs complete
    return: @
    retryPost:
        throws: FxIndex
        if: attempts < 1 || firstDelay < 0 || maxDelay < firstDelay || timeoutMs <= maxDelay
            throw: FxIndex()
        private: @: job (copy(FxRetryPostJob))
        job\private\request := request
        job\private\retryOn := retryOn
        job\private\limit := attempts
        job\private\delay := delay
        job\private\pause := firstDelay
        job\private\maxPause := maxDelay
        job\private\timeoutMs := timeoutMs
        job\private\complete := complete
        job\dispatch()
        return: job

# These are explicit Message templates. The existing host/lifecycle launches
# them as Threads with their own arenas; copying a Structure alone does not.
# The worker and its operation are owned by the SAME receiving Message. Passing
# a remote raw operation pointer here never makes a legal cross-owner call.
FxRetryOperationMessage:
    @: operation
    @: arguments ()
    return: @
    run:
        throws: copy(FxThrows\kernel)
        return: FxTry\attempt(operation; arguments)

FxRetryDelayMessage:
    @: wait
    int: duration
    return: int
    elapsed:
        wait(duration)
        return: 1

# RESTORED COMPACT PATTERN HELPERS — original finite contracts (22-Nov).
# Named groups are explicitly imported by the compact examples. They do not
# replace the generalized public functions above. Each body is measured in
# its dedicated implementation comparison, not once per client.

PipeLibrary:
    copy: sys\OPERANDS_TEMPLATE
    return: int
    pipe:
        int: value \left
        int: i 0
        while: i < length(right)
            @: stage \right[i]
            value := stage(value)
            i += 1
        return: value

FindLibrary:
    copy: sys\OPERANDS_TEMPLATE
    return: @
    findById:
        throws: OperandArity
        if: length(right) != 1
            throw: OperandArity()
        @: rows \left
        int: id \right[0]
        int: i 0
        while: i < length(rows)
            @: row rows[i]
            if: row\id = id
                return: row
            i += 1
        @: missing 0
        return: missing

SpecificationLibrary:
    independent: AndData:
        @: first 0
        @: second 0
        inputs:
            int: value
            return: int
            accepts:
                return: node\first(value) && node\second(value)
    ---
    Operators:
        copy: sys\OPERANDS_TEMPLATE
        return: @
        both:
            throws: OperandArity
            if: length(right) != 1
                throw: OperandArity()
            @: instance (merge(AndData; (@: first \left; @: second \right[0])))
            return: instance\inputs\accepts

MoneyLibrary:
    immutable: Money:
        int: cents 100
        int: currency 840
    Equality:
        copy: sys\OPERANDS_TEMPLATE
        return: int
        equals:
            throws: OperandArity
            if: length(right) != 1
                throw: OperandArity()
            @: a \left
            @: b \right[0]
            return: a\cents = b\cents && a\currency = b\currency

RetryLibrary:
    copy: sys\OPERANDS_TEMPLATE
    return: int
    retry:
        throws: Attempts
        if: length(right) < 1 || length(right) > 2
            throw: Attempts()
        int: limit \right[0]
        if: limit < 1 || limit > 31
            throw: Attempts()
        @: request \left
        int: attempt 0
        int: pause 1
        while: attempt < limit
            int: status request()
            if: status != 503
                return: status
            attempt += 1
            if: attempt < limit && length(right) = 2
                @: wait \right[1]
                wait(pause)
                pause *= 2
        ---
        return: 503
