Legacy:
    return: int
    dollars:
        return: 12

ACL:
    return: int
    cents:
        return: Legacy\dollars() * 100

Checkout:
    int: quantity
    return: int
    total:
        return: quantity * ACL\cents()
    demo:
        return: total(2)

