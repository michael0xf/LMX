DbDao:
    @: db
    int: id
    return: int
    readBalance:
        return: db\scalar("SELECT cents FROM account WHERE id = ?"; id)

FixedDao:
    int: id
    return: int
    readBalance:
        return: 25

Service:
    @: dao
    int: id
    return: int
    read:
        return: dao\readBalance(id)
