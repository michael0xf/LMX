predef: "l2src/lmx_manager_running.lm1"
predef: "l2src/lmx_manager_running.h.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_call.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_gc.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_clock.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# A LANE RUNS A WHOLE TURN (lmx_manager_running.lm1; the commit that made it use lmx_thread_turn).
# What this file pins -- the claim that had no test when the lane was switched to the shared turn act:
#
#   * the lane's turn runs the BODY the object's own graph names, not only the boundary: the entry
#     below counts its own calls, and the count is the evidence;
#   * the body runs INSIDE the lane's own turn: the object the body sees as current is the very
#     thread whose turn it is, while reserved `node` is the callable occurrence's parent -- 0,
#     because the graph hanging in a Thread is independent (parent = 0);
#   * the lane's turn is whole: its boundary collects the record's own band (the arena's generation
#     moves), and this thread's current object is never touched by the lane (it is a per-thread cell).
#
# The lane is an OS thread, so this test WAITS for the state the next call requires (the count) and
# never asserts on a race: it sleeps a bounded time, then asks.

size_t: rb_calls 0U
@: Lmx rb_node 0
@: LmxThread rb_current 0

fn: rb_body (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    @: Lmx self (cast: (@: Lmx) owner)
    @: Lmx node 0
    if: self != 0
        node: self\parent
    ---
    rb_calls: rb_calls + 1U
    rb_node: node
    rb_current: lmx_thread_current()
return: 0

fn: rb_struct (@: LmxArena arena; size_t: slots) @: Lmx
    @: Lmx structure
    structure: lmx_node_new_owned(arena)
    if: structure = 0
        return: 0
    ---
    if: slots != 0U && lmx_arena_refs_open_owned(arena, structure, slots) != 0
        return: 0
    ---
return: structure

sub: rb_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: rb_check

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: arena
    LmxManager: running
    @: LmxArena arena_at 0
    @: Lmx graph 0
    @: Lmx own_field 0
    @: LmxMsg message 0
    @: LmxThread t 0
    @: LmxPost mail 0
    @: LmxSchedule sched 0
    @: LmxSchedule slotp 0
    @: LmxThread parent 0
    @: LmxPost parent_mail 0
    @: LmxSchedule parent_sched 0
    @: Lmx parent_graph 0
    @: LmxArrayDesc parent_children 0
    unsigned: gen
    int: failures
    if: counts = 0
        return: 2
    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        fputs("lmx_manager_running: the arena did not open\n", l1_stdout())
        free(counts)
        return: 2
    ---
    arena_at: @ arena
    # k.4: no descriptor slot -- the own field is the graph's sole slot, and `native` is set
    # directly.
    graph: rb_struct(arena_at, 1U)
    own_field: lmx_int_new_owned(arena_at)
    t: (cast: (@: LmxThread) lmx_arena_take(arena_at, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD))
    message: (cast: (@: LmxMsg) t)
    mail: (cast: (@: LmxPost) lmx_arena_take(arena_at, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    sched: (cast: (@: LmxSchedule) lmx_arena_take(arena_at, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    parent: (cast: (@: LmxThread) lmx_arena_take(arena_at, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD))
    parent_mail: (cast: (@: LmxPost) lmx_arena_take(arena_at, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    parent_sched: (cast: (@: LmxSchedule) lmx_arena_take(arena_at, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    parent_graph: rb_struct(arena_at, 1U)
    if: graph = 0 || own_field = 0 || message = 0 || t = 0 || mail = 0 || sched = 0 || parent = 0 || parent_mail = 0 || parent_sched = 0 || parent_graph = 0
        free(counts)
        return: 2
    ---
    # The selected callable occurrence is `graph`, and it hangs in the Thread: it is independent
    # (parent = 0, author 2026-09-22), so its reserved source `node` is 0 -- nothing lexical lies
    # above a Thread's graph, and the parent Thread is supervision, not a lexical space.
    graph\parent: 0
    graph\native: (cast: (LmxEntry) rb_body)
    lmx_arena_ref_store(graph, 0U, own_field)
    # The record's own band, and a window wide enough that the lane's own ticks never end the wait.
    rb_check(counts, lmx_schedule_init(sched, arena_at, (cast: (@: void) t), 100000U) = c.LMX_SCHEDULE_OK, "the record did not initialize")
    rb_check(counts, lmx_post_init(arena_at, mail) = c.LMX_POST_OK && lmx_thread_init(arena_at, t, graph, mail, sched) = c.LMX_THREAD_OK, "the object did not initialize")
    rb_check(counts, lmx_schedule_wait(sched, lmx_clock_ticks()) = c.LMX_SCHEDULE_OK, "the record's wait did not start")

    # A manager traverses its owner's sole graph Array; it is not a second queue. Build the
    # ordinary parent and publish this Thread in that Array before asking either manager binding.
    parent_children: lmx_thread_children_field_new(arena_at, parent_graph, 0U)
    rb_check(counts, parent_children != 0 && lmx_post_init(arena_at, parent_mail) = c.LMX_POST_OK && lmx_schedule_init(parent_sched, arena_at, (cast: (@: void) parent), 100000U) = c.LMX_SCHEDULE_OK && lmx_thread_init(arena_at, parent, parent_graph, parent_mail, parent_sched) = c.LMX_THREAD_OK && lmx_thread_children_bind(parent, parent_children, arena_at) = c.LMX_THREAD_OK, "the running manager parent did not initialize")
    rb_check(counts, lmx_thread_child_add(parent, t, arena_at) = c.LMX_THREAD_OK, "the record did not join its parent's sole Array")

    rb_check(counts, lmx_manager_running_init(@ running) = c.LMX_MANAGER_OK, "the running manager did not initialize")
    rb_check(counts, lmx_manager_running_add(@ running, sched) = c.LMX_MANAGER_OK, "the record did not join the running schedule")
    gen: arena_at\generation
    rb_check(counts, lmx_manager_running_round(@ running, 1U, 0U) = c.LMX_MANAGER_OK, "the running round did not start a lane")
    slotp: sched
    rb_check(counts, slotp\lane != 0, "the running manager did not give the record a lane")

    # Wait for the state the next call requires: the lane is an OS thread, so the count is what says
    # it ran, and a bounded sleep is how this test asks.
    lmx_manager_running_pause_ms(60U)
    rb_check(counts, rb_calls >= 1U, "the lane ran no body")
    rb_check(counts, rb_current = t, "the lane's body did not run inside its own turn")
    rb_check(counts, rb_node = 0, "the lane's body was not handed node 0 for an independent Thread graph")
    rb_check(counts, lmx_thread_current() = 0, "the lane wrote this thread's current object")
    rb_check(counts, arena_at\generation > gen, "the lane's turn did not collect the record's own band")

    # Stop it and let the lane end by itself, then join.
    message\running: 0
    lmx_manager_running_pause_ms(60U)
    rb_check(counts, lmx_manager_running_close(@ running) = c.LMX_MANAGER_OK, "the running manager did not join its lanes")
    rb_check(counts, slotp\lane = 0, "the lane was not released")
    rb_check(counts, rb_calls = 0U || rb_calls >= 1U, "the lane's count went backwards")
    rb_check(counts, lmx_thread_child_remove(parent, t) = c.LMX_THREAD_OK, "the parent could not remove the stopped lane Thread")
    rb_check(counts, lmx_post_close(arena_at, mail) = c.LMX_POST_OK && lmx_post_close(arena_at, parent_mail) = c.LMX_POST_OK, "the Thread mailboxes did not close")

    failures: counts[1]
    c.printf("lmx_manager_running checks=%d failures=%d calls=%d\n", counts[0], failures, rb_calls)
    free(counts)
return: failures
