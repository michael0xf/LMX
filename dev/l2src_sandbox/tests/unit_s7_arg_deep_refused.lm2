# take(h\a\p). The leaf, Holder's own a's own p, has toString only (K03 NS-ROLES-2: it was `Mid: a` with
# `Plain: p`, now calls). take reads equals. The leaf has none.

Holder:
    a:
        p:
            size_t: toString 0U
end: Holder

Equatable:
    size_t: equals 0U
end: Equatable

fn: take (Equatable: slot) int
    slot\equals: 1U
return: 4

fn: pass (Holder: h) int
return: take(h\a\p)
