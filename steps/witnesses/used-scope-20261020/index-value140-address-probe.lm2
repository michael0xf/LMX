fn: indexAddress (@@: p void; int: index) @@: void
    return: @ p[index]
end: indexAddress
fn: putThroughAddress (@@: p void; int: index; @: value void) @: void
    @@: q void @ p[index]
    \q: value
    return: p[index]
end: putThroughAddress
fn: constRead (const: @(p int); int: index) int
    return: p[index]
end: constRead
fn: constAddress (const: @(p int); int: index) const: @(int)
    return: @ p[index]
end: constAddress
return
