# Probe 345: the layout call put(): with a named actual p whose tail is a vertical block of two written fields (y: 7,
# unused: 1) for the Structure formal p, then the named q: got = 7 * 10 + 3 = 73 is the norm of the structural tail.
Point:
    int: y 0
    int: unused 0
end: Point
sub: put (Point: p; int: q 2) (int: got 0)
    got: p\y * 10 + q
end: put
put():
    p:
        y: 7
        unused: 1
    end: p
    q: 3
end: put
int: r put\var\got
