# A name of the form the split of slice 278 used is an ordinary name: a place the data has to have, written by the call.
U:
    l2_written_7: (int: x 3)
end: U
UD:
    l2_written_7: (int: x 0)
end: UD
Bare:
    int: z 0
end: Bare
int: code 7
call: U UD
if: UD\l2_written_7\x != 3
    code: 81
---
int: caught 0
---
    call: U Bare
    catch: call ()
        caught: 1
---
if: code = 7 && caught != 1
    code: 82
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
