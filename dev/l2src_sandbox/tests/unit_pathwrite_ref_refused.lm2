# A Structure written through a method's path into its int field, `M\x: b`, is a reference where a number is asked
# (the walk's words); it went out as C storing the Box's pointer into M's x.
Box:
    int: v 0
end: Box
fn: M () int
    int: x 0
    x: 1
    return: 0
end: M
fn: peek () int
    Box: b
    M()
    M\x: b
    return: M\x
end: peek
int: r 0
r: peek()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
