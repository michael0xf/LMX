---
    Observed:
        int: seen 7
    end: Observed
---
sub: main ((M (int x 0)); (S (int x 7)))
    @: shared (node [] 0)
    fn: f (@: v M) int
        return: (v \ x)
    end: f
    fn: f (int: a; (required (int b))) int
        return: ((a * 10) + b)
    end: f
    :=: ((shared \ Observed) \ seen) (f S)
end: main
main:
