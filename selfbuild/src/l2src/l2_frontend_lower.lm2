            continue
        ---
        # The statement's body as one path (U7 slice D2: the run adapter's record, no joined text): one resolution.
        l2_pstatus: 1
        if: stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0
            l2_pstatus: lm_compiler_path_resolve_whole((cast: (@: c.LmP0Field) (stmt\as\frame\body\first_field)), (cast: (int) (c.lm_compiler_count_active((cast: (const: @: c.LmP0Structure) (stmt\as\frame\body))))), l2_ppath)
