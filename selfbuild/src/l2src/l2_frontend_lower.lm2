        if: oi >= 0 && oi != e_cell[0]
            if: lm_compiler_scan_ident(mi, (cast: (const: @: c.LmP0Text) (source_node\as\frame\head)), seen) != 0
                return: (cast: (int) (1))
            return: (cast: (int) (lm_compiler_scan_actuals_value(source_node, value, mi, seen)))
