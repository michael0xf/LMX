fn: lm_compiler_rw_path_value_full (@: path int; const: (@: prepared c.L2Path); int: store; int: level; int: parent; @: out int) int
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    @@: ns_eternal_cell int (cast: (@@: int) (@ c.l2_ns_eternal))
    @: rw_emit_cell int (cast: (@: int) (@ c.l2_rw_emit))
