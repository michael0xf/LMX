# D-23: empty Structure as ONE named argument (book §9, opaque named position).
# `take(x: ())` admits () to E. Not a call of x. Contrast unit_matrix_empty_arglist.
E: ()
end: E

fn: take (E: x) int
return: 7

int: r 0
r: take(x: ())
if: r != 7
    sendMessage: exit(exit_code: 3; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
