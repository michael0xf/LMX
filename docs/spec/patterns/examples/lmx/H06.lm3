Functions:
    int: x
    return: int
    twice:
        return: x * 2
    next:
        return: x + 1

CompositionProbe:
    return: int
    run:
        int: a Functions\next(Functions\twice(4))
        int: b Functions\twice(Functions\next(4))
        return: a * 100 + b

