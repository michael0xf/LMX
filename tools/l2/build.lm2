    # The pool API is the first generated API dependency of the other modules.
    # Full L1 bodies may refer forward; they are read by the L1 backend only
    # after all modules/APIs have been generated, never from an old output seed.
    if: bld_machine_module(rec, fe, src, base, out, res, "lmx_pool", pool_names, 21, 1) != 0
