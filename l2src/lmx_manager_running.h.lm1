predef: "l2src/lmx_manager.h.lm1"

# The running manager's header.  It is separate from lmx_manager.h.lm1 on purpose:
# the manager's INTERFACE is portable and lives there.  The thread entry a platform
# hands to the OS, and that platform's types, live in the body this header's consumers
# predef under the neutral name.

prototype:
    fn: lmx_manager_running_init (@: LmxManager m) int
    # The arena of the Message: admitting a record asks the domain question, and the
    # index that answers it belongs to the arena.  step and round carry the arena
    # because they fill the SAME api slots as the stepped binding's (one interface,
    # one signature); a lane's start and reap ask the table nothing, so the arena is
    # carried through them, not read.  take, count and close are not api slots and
    # ask nothing of the table, so they name no arena.
    #
    # The reading `now` is carried for exactly the same reason -- it is in the slot's
    # signature -- and it is not read here either: a LANE is a cycle, so the lane's own
    # loop reads the clock and ages its record itself (lmx_manager_running_body).  The
    # stopped path of this file therefore never touches the parameter, and neither does
    # the started one: there is nothing for it to age from here.
    fn: lmx_manager_running_add (@: LmxManager m; @: LmxSchedule slot) int
    # The same removal as the stepped binding's: the owner removes the Thread from its sole
    # graph Array; a lane, if this record had one, ends by itself.
    fn: lmx_manager_running_remove (@: LmxManager m; @: LmxSchedule slot) int
    fn: lmx_manager_running_take (@: LmxManager m) @: LmxSchedule
    fn: lmx_manager_running_count (@: LmxManager m) size_t
    fn: lmx_manager_running_step (@: LmxManager m; ulong: now) int
    fn: lmx_manager_running_round (@: LmxManager m; unsigned: ticks; ulong: now) int
    fn: lmx_manager_running_close (@: LmxManager m) int
    # Has this record's lane already ended? No lane means yes: nothing else is
    # still inside its storage. The body looks; a later reap still owns the join.
    fn: lmx_manager_running_lane_ended (@: LmxSchedule slot) int
    # Let other threads run for about this many milliseconds. Zero returns at once.
    fn: lmx_manager_running_pause_ms (unsigned: ms) int
end: prototype
