# K03 NS-ROLES-VIS (the author, 2026-10-07; semantics #declaration-visibility): a root statement above Later's
# definition cannot read Later -- it is visible from its place on: unresolved, refused where it stands.
int: got 0
if: Later\v = 4U
    got: 7
Later:
    size_t: v 4U
end: Later
fn: m () int
    return: got
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
