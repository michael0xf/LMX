# The builder of the clean graph from the P0 tree (docs/kernel-implementation.ru.md, EN beside it; §1a, §3): the one
# construction both readers of a unit's graph start from -- the graph tool tools/graph_trans.lm2 (the kernel's
# interpreter over the graph and the emitter of a program over it, src/l2src/l2_graph_tool.lm2) and the frontend
# hosted by the runtime, whose machine path reads the clean graph of a module (route 331,
# src/l2src/l2_frontend_graph.lm2). Moved out of l2_graph_tool.lm2 unchanged (slice 338): the frontend shares the
# builder, not the graph tool's emitter and command line.
#
# The builder reads the P0 tree once and leaves nothing of it in the graph: every written name is a word primitive with
# the canonical address of its spelling (§3.5: the builder resolves no names), a number literal is an int primitive, a
# Frame or a Structure is an Lmx of its head word and fields in the written order (§3.3). The one exception the
# language itself makes is a declaration: `int: x 5` is an int place holding 5, `int: x` a place without a value (§3.2),
# both named at their cell (§5.1); a declaration with a computed initializer stays a statement until it runs (§3.4). The
# parse tree and its arenas are destroyed with the construction (§1a).
#
# A machine module (L2 section 20) with its own header (l2src/l2_graph_build.h.lm1): built by `lmxtool build-graph`
# (bld_graph) and `lmxtool build-frontend-host` (bld_frontend_host, tools/build.lm2) after the P0 parser's modules
# of the stage; its export is lm_graph_build_file.
predef: "l1src/p0.h.lm1"
predef: "l1src/parser.lm1"
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_graph.h.lm1"
predef: "l2src/lmx_graph_run.h.lm1"
predef: "l2src/lmx_graph_copy_owned.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>"
include: "<stdlib.h>"
include: "<string.h>"

# ---- The P0 tree as the frontend reads it ------------------------------------------------------------------------

# The fields of the P0 records, read through one cast each: the translator types no field of a record declared by
# l1src/p0.h.lm1, so a read that flows into a typed formal, a local or a return goes through these (the frontend's own
# port249 wrappers do the same); a read compared in a condition needs no cast.
fn: lm_graph_p0_value (@: f c.LmP0Field) @: c.LmP0Node
    return: (cast: (@: c.LmP0Node) (f\value))
end: lm_graph_p0_value

fn: lm_graph_p0_next (@: f c.LmP0Field) @: c.LmP0Field
    return: (cast: (@: c.LmP0Field) (f\next))
end: lm_graph_p0_next

fn: lm_graph_p0_first (@: s c.LmP0Structure) @: c.LmP0Field
    return: (cast: (@: c.LmP0Field) (s\first_field))
end: lm_graph_p0_first

fn: lm_graph_p0_atom (@: nd c.LmP0Node) @: c.LmP0Text
    return: (cast: (@: c.LmP0Text) (nd\as\atom))
end: lm_graph_p0_atom

fn: lm_graph_p0_frame (@: nd c.LmP0Node) @: c.LmP0Frame
    return: (cast: (@: c.LmP0Frame) (nd\as\frame))
end: lm_graph_p0_frame

fn: lm_graph_p0_structure (@: nd c.LmP0Node) @: c.LmP0Structure
    return: (cast: (@: c.LmP0Structure) (nd\as\structure))
end: lm_graph_p0_structure

fn: lm_graph_p0_head (@: fr c.LmP0Frame) @: c.LmP0Text
    return: (cast: (@: c.LmP0Text) (fr\head))
end: lm_graph_p0_head

fn: lm_graph_p0_body (@: fr c.LmP0Frame) @: c.LmP0Structure
    return: (cast: (@: c.LmP0Structure) (fr\body))
end: lm_graph_p0_body

fn: lm_graph_p0_data (@: text c.LmP0Text) const: @: char
    return: (cast: (const: @: char) (text\data))
end: lm_graph_p0_data

fn: lm_graph_p0_length (@: text c.LmP0Text) size_t
    return: (cast: (size_t) (text\length))
end: lm_graph_p0_length

# 1 when the nd is a real field of its Structure: not disabled, not inactive, not a mix remnant.
fn: lm_graph_active (@: nd c.LmP0Node) int
    if: nd = 0
        return: 0
    if: nd\kind = c.LM_P0_NODE_DISABLED
        return: 0
    if: (nd\flags & (c.LM_P0_NODE_INACTIVE | c.LM_P0_NODE_MIX)) != 0U
        return: 0
    return: 1
end: lm_graph_active

fn: lm_graph_next_active (@: field c.LmP0Field) @: c.LmP0Field
    while: field != 0 && lm_graph_active(lm_graph_p0_value(field)) = 0
        field := lm_graph_p0_next(field)
    ---
    return: field
end: lm_graph_next_active

fn: lm_graph_count_active (@: s c.LmP0Structure) size_t
    @: f c.LmP0Field 0
    size_t: n 0U
    if: s = 0
        return: 0U
    f := lm_graph_next_active(lm_graph_p0_first(s))
    while: f != 0
        n := n + 1U
        f := lm_graph_next_active(lm_graph_p0_next(f))
    ---
    return: n
end: lm_graph_count_active

# 1 and the value in out when the atom's text is a decimal int literal (an optional leading minus and digits).
fn: lm_graph_int_literal (@: text c.LmP0Text; @: out int) int
    size_t: i 0U
    int: neg 0
    int: v 0
    if: text = 0 || out = 0 || text\length = 0U
        return: 0
    if: text\data[0] = 45
        neg := 1
        i := 1U
    ---
    if: i >= text\length
        return: 0
    while: i < text\length
        if: text\data[i] < 48 || text\data[i] > 57
            return: 0
        v := v * 10 + ((cast: (int) text\data[i]) - 48)
        i := i + 1U
    ---
    if: neg != 0
        v := 0 - v
    out[0] := v
    return: 1
end: lm_graph_int_literal

# ---- The builder: P0 tree -> clean graph (§1a) --------------------------------------------------------------------

# Construction consumes the P0 sequence and its argument separators. The only resulting expression representation
# is the nested Lmx graph. Temporary cursors and the scratch list leave with construction.
# Only construction assigns a parent while putting a written child. Runtime writes go through invalidation.
fn: lm_graph_build_put (@: g c.LmxGraph; @: parent c.Lmx; size_t: index; @: value void) int
    @: child c.Lmx 0
    if: c.lmx_graph_put(parent, index, value) != 0
        return: 1
    if: c.lmx_graph_kind(g, value) = 4
        child := (cast: (@: c.Lmx) value)
        child\parent := parent
    return: 0
end: lm_graph_build_put

# Precedence belongs to the builder. Consumers see a binary Lmx [left, operator-word, right], never a token stream.
fn: lm_graph_build_power (@: word char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    if: word = state\w_deref
        return: 8
    if: word = state\w_star || word = state\w_slash || word = state\w_percent
        return: 6
    if: word = state\w_plus || word = state\w_minus
        return: 5
    if: word = state\w_lt || word = state\w_le || word = state\w_gt || word = state\w_ge
        return: 4
    if: word = state\w_eq || word = state\w_ne
        return: 3
    if: word = state\w_and
        return: 2
    if: word = state\w_or
        return: 1
    return: 0
end: lm_graph_build_power

# Is the atom spelled bytes the single byte b (`[` 91, `]` 93), or, with b = 0, a decimal number? 1 or 0.
fn: lm_graph_build_atom_bytes (const: (@: bytes char); size_t: size; int: b) int
    size_t: i 0U
    if: size = 0U
        return: 0
    if: b != 0
        return: (cast: (int) (size = 1U && bytes[0] = b))
    while: i < size
        if: bytes[i] < 48 || bytes[i] > 57
            return: 0
        ---
        i := i + 1U
    ---
    return: 1
end: lm_graph_build_atom_bytes

# Is field an atom spelled as lm_graph_build_atom_bytes says? 1 or 0.
fn: lm_graph_build_atom_is (@: field c.LmP0Field; int: b) int
    @: nd c.LmP0Node 0
    @: token c.LmP0Text 0
    if: field = 0
        return: 0
    nd := lm_graph_p0_value(field)
    if: nd\kind != c.LM_P0_NODE_ATOM
        return: 0
    token := lm_graph_p0_atom(nd)
    return: lm_graph_build_atom_bytes(lm_graph_p0_data(token), lm_graph_p0_length(token), b)
end: lm_graph_build_atom_is

# The step of an occurrence (the book, fields: `s\[N]field` selects the record N of field at the root level of s; plan
# M11 5a): when the atoms after the operator `\` at item are `[`, a number N, `]` and a name, written without a
# separator, out takes the one word `[N]name` -- the word a head `s\[N]name` gives (lm_graph_build_selector), so that
# both reach the same path step (lmx_graph_step) -- and the cursor moves past the name. Any other atoms leave out 0 and
# the cursor where it was. 0, or 1 without memory.
fn: lm_graph_build_occurrence (@: g c.LmxGraph; @: item c.LmP0Field; @@: cursor c.LmP0Field; @: boundary int; @@: out void) int
    @: open c.LmP0Field 0
    @: number c.LmP0Field 0
    @: close c.LmP0Field 0
    @: name c.LmP0Field 0
    @: nd c.LmP0Node 0
    @: digits c.LmP0Text 0
    @: label c.LmP0Text 0
    @: text char 0
    size_t: nd_size 0U
    size_t: nm_size 0U
    out[0] := 0
    if: item = 0
        return: 0
    nd := lm_graph_p0_value(item)
    if: (nd\flags & c.LM_P0_NODE_SEPARATOR_AFTER) != 0U
        return: 0
    open := lm_graph_next_active(lm_graph_p0_next(item))
    if: lm_graph_build_atom_is(open, 91) = 0
        return: 0
    nd := lm_graph_p0_value(open)
    if: (nd\flags & c.LM_P0_NODE_SEPARATOR_AFTER) != 0U
        return: 0
    number := lm_graph_next_active(lm_graph_p0_next(open))
    if: lm_graph_build_atom_is(number, 0) = 0
        return: 0
    nd := lm_graph_p0_value(number)
    if: (nd\flags & c.LM_P0_NODE_SEPARATOR_AFTER) != 0U
        return: 0
    digits := lm_graph_p0_atom(nd)
    close := lm_graph_next_active(lm_graph_p0_next(number))
    if: lm_graph_build_atom_is(close, 93) = 0
        return: 0
    nd := lm_graph_p0_value(close)
    if: (nd\flags & c.LM_P0_NODE_SEPARATOR_AFTER) != 0U
        return: 0
    name := lm_graph_next_active(lm_graph_p0_next(close))
    if: name = 0
        return: 0
    nd := lm_graph_p0_value(name)
    if: nd\kind != c.LM_P0_NODE_ATOM
        return: 0
    label := lm_graph_p0_atom(nd)
    nd_size := lm_graph_p0_length(digits)
    nm_size := lm_graph_p0_length(label)
    text := (cast: (@: char) c.malloc(nd_size + nm_size + 2U))
    if: text = 0
        return: 1
    text[0] := 91
    c.memcpy((cast: (@: void) (text + 1U)), (cast: (@: void) lm_graph_p0_data(digits)), nd_size)
    text[nd_size + 1U] := 93
    c.memcpy((cast: (@: void) (text + nd_size + 2U)), (cast: (@: void) lm_graph_p0_data(label)), nm_size)
    out[0] := c.lmx_graph_word(g, text, nd_size + nm_size + 2U)
    c.free((cast: (@: void) text))
    if: out[0] = 0
        return: 1
    boundary[0] := (cast: (int) ((nd\flags & c.LM_P0_NODE_SEPARATOR_AFTER) != 0U))
    cursor[0] := lm_graph_next_active(lm_graph_p0_next(name))
    return: 0
end: lm_graph_build_occurrence

fn: lm_graph_build_expression (@: g c.LmxGraph; @@: cursor c.LmP0Field; int: least; @: boundary int; @@: out void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: item c.LmP0Field cursor[0]
    @: nd c.LmP0Node 0
    @: token c.LmP0Text 0
    @: word char 0
    @: left void 0
    @: right void 0
    @: operator void 0
    @: expression c.Lmx 0
    # The atoms P0 makes of the brackets of an attached index `base[index]` (grammar §22).
    @: index_open char c.lmx_graph_intern("[", 1U)
    @: index_close char c.lmx_graph_intern("]", 1U)
    int: power 0
    int: status 0
    if: item = 0 || out = 0
        return: 2
    nd := lm_graph_p0_value(item)
    boundary[0] := (cast: (int) ((nd\flags & c.LM_P0_NODE_SEPARATOR_AFTER) != 0U))
    cursor[0] := lm_graph_next_active(lm_graph_p0_next(item))
    if: nd\kind = c.LM_P0_NODE_ATOM
        token := lm_graph_p0_atom(nd)
        word := c.lmx_graph_intern(lm_graph_p0_data(token), lm_graph_p0_length(token))
    ---
    if: word != 0 && (word = state\w_plus || word = state\w_minus || word = state\w_deref || word = state\w_at || word = state\w_not)
        if: boundary[0] != 0
            return: 2
        status := lm_graph_build_expression(g, cursor, 7, boundary, @ right)
        if: status != 0
            return: status
        expression := c.lmx_graph_lmx(g, 0, 2U)
        operator := c.lmx_graph_word(g, lm_graph_p0_data(token), lm_graph_p0_length(token))
        if: expression = 0 || operator = 0 || lm_graph_build_put(g, expression, 0U, operator) != 0 || lm_graph_build_put(g, expression, 1U, right) != 0
            return: 1
        left := (cast: (@: void) expression)
    else:
        status := lm_graph_build_node(g, 0, nd, @ left)
        if: status != 0
            return: status
        ---
    ---
    while: cursor[0] != 0 && boundary[0] = 0
        item := cursor[0]
        nd := lm_graph_p0_value(item)
        if: nd\kind != c.LM_P0_NODE_ATOM
            break
        token := lm_graph_p0_atom(nd)
        word := c.lmx_graph_intern(lm_graph_p0_data(token), lm_graph_p0_length(token))
        # The index of a Structure, `base[index]` (the book, structure-index): P0 gives the atom `[`, the fields of the
        # index and the atom `]`. It binds as a path step does (grammar §22: the chain of fields and indices binds
        # tighter than a prefix operator); the expression is [base, [], index], its index one whole expression.
        if: word = index_open
            if: 8 < least
                break
            if: (nd\flags & c.LM_P0_NODE_SEPARATOR_AFTER) != 0U
                return: 2
            cursor[0] := lm_graph_next_active(lm_graph_p0_next(item))
            status := lm_graph_build_expression(g, cursor, 1, boundary, @ right)
            if: status != 0
                return: status
            item := cursor[0]
            if: item = 0 || boundary[0] != 0
                return: 2
            nd := lm_graph_p0_value(item)
            if: nd\kind != c.LM_P0_NODE_ATOM
                return: 2
            token := lm_graph_p0_atom(nd)
            if: c.lmx_graph_intern(lm_graph_p0_data(token), lm_graph_p0_length(token)) != index_close
                return: 2
            boundary[0] := (cast: (int) ((nd\flags & c.LM_P0_NODE_SEPARATOR_AFTER) != 0U))
            cursor[0] := lm_graph_next_active(lm_graph_p0_next(item))
            expression := c.lmx_graph_lmx(g, 0, 3U)
            operator := c.lmx_graph_word(g, "[]", 2U)
            if: expression = 0 || operator = 0 || lm_graph_build_put(g, expression, 0U, left) != 0 || lm_graph_build_put(g, expression, 1U, operator) != 0 || lm_graph_build_put(g, expression, 2U, right) != 0
                return: 1
            left := (cast: (@: void) expression)
            continue
        # The step of an occurrence, `s\[N]name` (lm_graph_build_occurrence): one word after the operator `\`.
        if: word = state\w_deref && 8 >= least
            status := lm_graph_build_occurrence(g, item, cursor, boundary, @ right)
            if: status != 0
                return: status
            if: right != 0
                expression := c.lmx_graph_lmx(g, 0, 3U)
                operator := c.lmx_graph_word(g, lm_graph_p0_data(token), lm_graph_p0_length(token))
                if: expression = 0 || operator = 0 || lm_graph_build_put(g, expression, 0U, left) != 0 || lm_graph_build_put(g, expression, 1U, operator) != 0 || lm_graph_build_put(g, expression, 2U, right) != 0
                    return: 1
                left := (cast: (@: void) expression)
                continue
            ---
        ---
        power := lm_graph_build_power(word)
        if: power = 0 || power < least
            break
        if: (nd\flags & c.LM_P0_NODE_SEPARATOR_AFTER) != 0U
            return: 2
        cursor[0] := lm_graph_next_active(lm_graph_p0_next(item))
        status := lm_graph_build_expression(g, cursor, power + 1, boundary, @ right)
        if: status != 0
            return: status
        expression := c.lmx_graph_lmx(g, 0, 3U)
        operator := c.lmx_graph_word(g, lm_graph_p0_data(token), lm_graph_p0_length(token))
        if: expression = 0 || operator = 0 || lm_graph_build_put(g, expression, 0U, left) != 0 || lm_graph_build_put(g, expression, 1U, operator) != 0 || lm_graph_build_put(g, expression, 2U, right) != 0
            return: 1
        left := (cast: (@: void) expression)
    ---
    out[0] := left
    return: 0
end: lm_graph_build_expression

# The parser's closing postcondition is lowered to an ordinary receiver Lmx. No P0 trailer or source-form flag
# survives construction. Consumers identify until by its canonical string address.
fn: lm_graph_until_tail (@: tail c.LmP0Trailer) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    if: tail = 0 || tail\spelling = 0
        return: 0
    return: (cast: (int) (c.lmx_graph_intern((cast: (@: char) tail\spelling\data), (cast: (size_t) tail\spelling\length)) = state\w_until))
end: lm_graph_until_tail

fn: lm_graph_build_post (@: g c.LmxGraph; @: parent c.Lmx; @: body c.Lmx; @: tail c.LmP0Trailer; @@: out void) int
    @: cursor c.LmP0Field lm_graph_next_active(lm_graph_p0_first((cast: (@: c.LmP0Structure) tail\body)))
    @: condition void 0
    @: loop c.Lmx 0
    int: boundary 0
    int: status lm_graph_build_expression(g, @ cursor, 1, @ boundary, @ condition)
    if: status != 0 || cursor != 0
        return: 2
    # The Frame of the receiver until (§3.3): an Lmx named until with its arguments, the condition and the body.
    loop := c.lmx_graph_lmx(g, parent, 2U)
    if: loop = 0 || c.lmx_graph_name(g, (cast: (@: void) loop), "until", 5U) != 0 || lm_graph_build_put(g, loop, 0U, condition) != 0 || lm_graph_build_put(g, loop, 1U, (cast: (@: void) body)) != 0
        return: 1
    out[0] := (cast: (@: void) loop)
    return: 0
end: lm_graph_build_post

# Collect one normalized expression per argument/field. The scratch pointer array is discarded; the resulting Lmx
# has its exact fixed size. P0 separators stop an operand, so a unary operator after a comma starts the next argument.
# A Frame `head: arguments` is the Lmx of its arguments named by its head (the author 2026-11-09: a declaration is the
# named structure of its receiver -- fn is its name -- with its arguments; §3.3); an anonymous Structure (head 0) has
# no name. An operation written as a Frame (`-(2 + 3)`) has no name: lead is its operator word, field 0 as in every
# expression. The role of the head is the consumers' resolution.
fn: lm_graph_build_sequence (@: g c.LmxGraph; @: parent c.Lmx; @: source c.LmP0Structure; @: head char; @: lead void; @: tail c.LmP0Trailer; @@: out void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    size_t: capacity (cast: (size_t) (lm_graph_count_active(source) + 1U))
    @@: items void (cast: (@@: void) c.calloc(capacity, sizeof(@: void)))
    size_t: count 0U
    size_t: i 0U
    @: cursor c.LmP0Field 0
    @: result c.Lmx 0
    int: boundary 0
    int: status 0
    if: items = 0
        return: 1
    if: lead != 0
        items[count] := lead
        count := count + 1U
    if: source != 0
        cursor := lm_graph_next_active(lm_graph_p0_first(source))
    # The written name of a declaration is its first argument, not the left operand of its initializer.
    if: cursor != 0 && (head = state\w_int || head = state\w_at)
        status := lm_graph_build_node(g, 0, lm_graph_p0_value(cursor), @ items[count])
        if: status = 0
            count := count + 1U
            cursor := lm_graph_next_active(lm_graph_p0_next(cursor))
        ---
    ---
    while: cursor != 0 && status = 0
        boundary := 0
        status := lm_graph_build_expression(g, @ cursor, 1, @ boundary, @ items[count])
        if: status = 0
            count := count + 1U
        ---
    ---
    if: status = 0
        result := c.lmx_graph_lmx(g, parent, count)
        if: result = 0
            status := 1
        if: status = 0 && head != 0 && c.lmx_graph_name_address(g, (cast: (@: void) result), head) != 0
            status := 1
        while: i < count && status = 0
            status := lm_graph_build_put(g, result, i, items[i])
            i := i + 1U
        ---
    ---
    c.free((cast: (@: void) items))
    out[0] := (cast: (@: void) result)
    if: status = 0 && lm_graph_until_tail(tail) != 0
        status := lm_graph_build_post(g, parent, result, tail, out)
    return: status
end: lm_graph_build_sequence

# One expression-headed Frame is an application operator with a distinct
# actuals Structure, including when it is empty. A written group keeps its
# outer Structure and cannot be mistaken for this formed call.
fn: lm_graph_build_application (@: g c.LmxGraph; @: parent c.Lmx; @: head void; @: source c.LmP0Structure; @: tail c.LmP0Trailer; @@: out void) int
    @: actuals void 0
    @: op void 0
    @: application c.Lmx 0
    int: status lm_graph_build_sequence(g, 0, source, 0, 0, 0, @ actuals)
    if: status != 0
        return: status
    application := c.lmx_graph_lmx(g, parent, 3U)
    op := c.lmx_graph_word(g, "()", 2U)
    if: application = 0 || op = 0 || lm_graph_build_put(g, application, 0U, head) != 0 || lm_graph_build_put(g, application, 1U, op) != 0 || lm_graph_build_put(g, application, 2U, actuals) != 0
        return: 1
    out[0] := (cast: (@: void) application)
    if: lm_graph_until_tail(tail) != 0
        return: lm_graph_build_post(g, parent, application, tail, out)
    return: 0
end: lm_graph_build_application

# Has the written selector an attached index, `base[index]` (grammar §22) -- a `[` that follows a name or another
# index? The occurrence choice `owner\[N]field`, whose bracket follows the backslash, is none and keeps its own
# reading. 1 or 0.
fn: lm_graph_index_text (const: (@: bytes char); size_t: text_size) int
    size_t: i 1U
    int: found 0
    if: text_size != 0U && bytes[0] = 96
        return: 0
    while: i < text_size
        if: bytes[i] = 91
            if: bytes[i - 1U] = 92
                return: 0
            found := 1
        ---
        i := i + 1U
    ---
    return: found
end: lm_graph_index_text

# The value of a selector with an attached index (the head of `base[index] := value`): P0 parses the selector's own
# text as it parses it in a tail -- the atoms of the base, of the brackets and of the index -- and the one expression
# builder gives the same nested Lmx a tail gives (§3.3: one construction of an expression, whatever its position). The
# parse tree is destroyed with the construction. 0 and the value in out; 1 without memory; 2 for a text that does not
# parse or is no single expression.
fn: lm_graph_build_indexed (@: g c.LmxGraph; const: (@: bytes char); size_t: text_size; @@: out void) int
    @: doc c.LmP0Document 0
    @: nd c.LmP0Node 0
    @: cursor c.LmP0Field 0
    @: value void 0
    int: boundary 0
    int: status 2
    if: c.lm_p0_parse_bytes(bytes, text_size, @ doc) = 0 && doc != 0
        nd := (cast: (@: c.LmP0Node) c.lm_p0_document_root(doc))
        if: nd != 0 && nd\kind = c.LM_P0_NODE_STRUCTURE
            cursor := lm_graph_next_active(lm_graph_p0_first(lm_graph_p0_structure(nd)))
            status := lm_graph_build_expression(g, @ cursor, 1, @ boundary, @ value)
            if: status = 0 && cursor != 0
                status := 2
            ---
        ---
    ---
    if: doc != 0
        c.lm_p0_document_destroy(doc)
    if: status = 0
        out[0] := value
    return: status
end: lm_graph_build_indexed

# A written selector -- `name` or `owner\field...` -- as the graph's value: a word, or the nested path [owner, \, field]
# (the same Lmx every path expression has, §3.3), split here, once, at its backslashes, while the lexical boundaries
# are known; an exact identifier in backquotes stays one name. 0 and the value in out; 1 without memory; 2 for an empty
# part.
fn: lm_graph_build_selector (@: g c.LmxGraph; const: (@: bytes char); size_t: text_size; @@: out void) int
    size_t: start 0U
    size_t: i 0U
    @: part void 0
    @: left void 0
    @: path c.Lmx 0
    out[0] := 0
    if: text_size != 0U && bytes[0] = 96
        left := c.lmx_graph_word(g, bytes, text_size)
        if: left = 0
            return: 1
        out[0] := left
        return: 0
    # A selector with an attached index, `base[index]`, alone or within a path, is the expression its text gives in a
    # tail (lm_graph_build_indexed).
    if: lm_graph_index_text(bytes, text_size) != 0
        return: lm_graph_build_indexed(g, bytes, text_size, out)
    while: i <= text_size
        if: i = text_size || bytes[i] = 92
            if: i = start
                return: 2
            part := c.lmx_graph_word(g, bytes + start, i - start)
            if: part = 0
                return: 1
            if: left = 0
                left := part
            else:
                path := c.lmx_graph_lmx(g, 0, 3U)
                if: path = 0 || lm_graph_build_put(g, path, 0U, left) != 0 || lm_graph_build_put(g, path, 1U, c.lmx_graph_word(g, "\\", 1U)) != 0 || lm_graph_build_put(g, path, 2U, part) != 0
                    return: 1
                left := (cast: (@: void) path)
            ---
            start := i + 1U
        ---
        i := i + 1U
    ---
    out[0] := left
    return: 0
end: lm_graph_build_selector

# Is the head text a written path -- `owner\field...`, no exact identifier in backquotes, no empty part -- so that its
# Frame is a statement on a path head (lm_graph_build_node)? 1 or 0.
fn: lm_graph_path_text (const: (@: bytes char); size_t: text_size) int
    size_t: i 0U
    int: path 0
    if: text_size < 3U || bytes[0] = 96 || bytes[0] = 92 || bytes[text_size - 1U] = 92
        return: 0
    while: i < text_size
        if: bytes[i] = 92
            if: bytes[i + 1U] = 92
                return: 0
            path := 1
        ---
        i := i + 1U
    ---
    return: path
end: lm_graph_path_text

# A parser assignment flag becomes an ordinary Lmx operator and its operands. No parser flag survives.
# The written selector is split here, once; consumers use the same nested field expression as every other path.
# The operand is the body written after `:=`, read by the one model of a Frame (§3.3) as the body of a Frame given by
# its head is: a single field that is a value -- a word, an unnamed int, an unnamed Lmx (an expression) -- is the
# operand itself; any other body -- no field, several, a place, a Frame -- is the Structure of its fields as written
# (an unnamed Lmx), so that `args := (int: a)` gives the same Structure as `args: (int: a)`. An assignment written
# there, `code := (total := total + d)`, is such a Frame -- a statement, no value: the operand is the body of that one
# statement. A consumer that evaluates the operand reads a Structure of one field as that field (lmx_graph_eval_value,
# lm_graph_emit_operand): a Frame applying a callable or merge stays that application.
fn: lm_graph_build_assignment (@: g c.LmxGraph; @: parent c.Lmx; @: frame c.LmP0Frame; @@: out void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: text c.LmP0Text lm_graph_p0_head(frame)
    const: @: bytes char lm_graph_p0_data(text)
    size_t: text_size lm_graph_p0_length(text)
    @: left void 0
    @: rhs void 0
    @: operand void 0
    @: single void 0
    @: result c.Lmx 0
    int: kind 0
    int: status 0
    status := lm_graph_build_selector(g, bytes, text_size, @ left)
    if: status != 0
        return: status
    status := lm_graph_build_sequence(g, 0, lm_graph_p0_body(frame), 0, 0, (cast: (@: c.LmP0Trailer) frame\trailer), @ rhs)
    if: status != 0
        return: status
    operand := rhs
    if: state != 0 && c.lmx_graph_count((cast: (@: c.Lmx) rhs)) = 1U
        single := c.lmx_graph_get((cast: (@: c.Lmx) rhs), 0U)
        kind := c.lmx_graph_kind(g, single)
        if: kind = 2 || kind = 5 || kind = 6 || ((kind = 1 || kind = 4) && c.lmx_graph_name_of(g, single) = 0)
            operand := single
        ---
        if: kind = 4 && c.lmx_graph_name_of(g, single) = 0 && c.lmx_graph_word_text(g, c.lmx_graph_get((cast: (@: c.Lmx) single), 0U)) = state\w_assign
            operand := rhs
        ---
    ---
    result := c.lmx_graph_lmx(g, parent, 3U)
    if: result = 0 || lm_graph_build_put(g, result, 0U, c.lmx_graph_word(g, ":=", 2U)) != 0 || lm_graph_build_put(g, result, 1U, left) != 0 || lm_graph_build_put(g, result, 2U, operand) != 0
        return: 1
    out[0] := (cast: (@: void) result)
    return: 0
end: lm_graph_build_assignment

# A statically described primitive place, named at its cell (§3.2): int with
# no value or a literal, and the required int-reference without a candidate.
# Other models and computed initializers keep their ordinary receiver Frame.
fn: lm_graph_build_place (@: g c.LmxGraph; @: fr c.LmP0Frame) @: void
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: f1 c.LmP0Field 0
    @: f2 c.LmP0Field 0
    @: name c.LmP0Text 0
    @: head char 0
    @: cell void 0
    @: value void 0
    size_t: n 0U
    int: v 0
    if: state = 0 || fr = 0 || fr\body = 0
        return: 0
    head := lm_graph_p0_name_word(lm_graph_p0_head(fr))
    if: head != state\w_int && head != state\w_at
        return: 0
    n := lm_graph_count_active(lm_graph_p0_body(fr))
    f1 := lm_graph_next_active(lm_graph_p0_first(lm_graph_p0_body(fr)))
    if: n < 1U || n > 2U || f1 = 0 || f1\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    name := lm_graph_p0_atom(lm_graph_p0_value(f1))
    if: lm_graph_int_literal(name, @ v) != 0
        return: 0
    if: head = state\w_at
        if: (fr\flags & c.LM_P0_FRAME_COLON) = 0U || n != 2U
            return: 0
        f2 := lm_graph_next_active(lm_graph_p0_next(f1))
        if: f2 = 0 || f2\value\kind != c.LM_P0_NODE_ATOM || lm_graph_p0_name_word(lm_graph_p0_atom(lm_graph_p0_value(f2))) != state\w_int
            return: 0
        cell := c.lmx_graph_uninit_reference(g, 5, 0)
        value := c.lmx_graph_reference_cell(g, cell)
        if: value = 0 || c.lmx_graph_name(g, value, lm_graph_p0_data(name), lm_graph_p0_length(name)) != 0
            return: 0
        return: cell
    if: n = 1U
        cell := c.lmx_graph_uninit_int(g)
        if: cell = 0
            return: 0
        value := c.lmx_arena_pointer_void_read(cell)
        if: c.lmx_graph_name(g, value, lm_graph_p0_data(name), lm_graph_p0_length(name)) != 0
            return: 0
        return: cell
    f2 := lm_graph_next_active(lm_graph_p0_next(f1))
    if: f2 = 0 || f2\value\kind != c.LM_P0_NODE_ATOM || lm_graph_int_literal(lm_graph_p0_atom(lm_graph_p0_value(f2)), @ v) = 0
        return: 0
    cell := c.lmx_graph_int(g, v)
    if: cell = 0 || c.lmx_graph_name(g, cell, lm_graph_p0_data(name), lm_graph_p0_length(name)) != 0
        return: 0
    return: cell
end: lm_graph_build_place

# ---- What construction refuses (answer 2) ---------------------------------------------------------------------------

# The canonical word of a written name: an exact identifier in backquotes is the name it quotes (the grammar: `x` and x
# are one name), so the reserved word and the targets of a closing compare names, not spellings. 0 for no text.
fn: lm_graph_p0_name_word (@: text c.LmP0Text) @: char
    const: @: bytes char 0
    size_t: size 0U
    if: text = 0
        return: 0
    bytes := lm_graph_p0_data(text)
    size := lm_graph_p0_length(text)
    if: bytes = 0
        return: 0
    if: size >= 2U && bytes[0] = 96 && bytes[size - 1U] = 96
        return: c.lmx_graph_intern(bytes + 1U, size - 2U)
    return: c.lmx_graph_intern(bytes, size)
end: lm_graph_p0_name_word

# The first written field of a Frame's body when it is an atom -- the name position of a declaration -- or 0.
fn: lm_graph_first_atom (@: fr c.LmP0Frame) @: c.LmP0Text
    @: field c.LmP0Field 0
    if: fr = 0 || fr\body = 0
        return: 0
    field := lm_graph_next_active(lm_graph_p0_first(lm_graph_p0_body(fr)))
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    return: lm_graph_p0_atom(lm_graph_p0_value(field))
end: lm_graph_first_atom

# Does construction admit the written Frame? The rules of closing are those the working frontend checks
# (l2_frontend_emit.lm2: "stray trailer: the frame above is already closed", "end target does not match close target";
# l2_frontend_helpers.lm2: lm_compiler_fn_close, lm_compiler_end_named), and the reserved word is the book's (the book,
# node); a Frame they refuse is answered 2 before anything is built (plan M11 5b part 2; the author 2026-11-11 through
# fable2):
# - node is bound by no form, in a quoted spelling too: no Frame is headed by it (in data that would be a record of that
#   name, in code an application of it), no declaration by `int` or `@` names it, no fn, sub or fm is named by it, and
#   `node := value` is no assignment. A path through it, `node\x := value`, is a write through the space;
# - a Frame headed by end or until is a trailer P0 did not attach to a Frame: the frame above it is already closed;
# - the target of an `end:` trailer is one atom and a valid target of the Frame it closes (grammar §17): a named fn, sub
#   or fm takes its name or its receiver word (`end: square`, `end: fn`), an anonymous one its receiver word, `(): name`
#   its name, any other Frame its head (`end: Point`, `end: if`). One trailer may close several open levels: P0 gives
#   it to the Frame it closes. An anonymous Structure is not checked, as the working frontend does not check it.
# 1 when the Frame is admitted, 0 when construction refuses it.
fn: lm_graph_frame_admitted (@: fr c.LmP0Frame) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: head_text c.LmP0Text 0
    @: head char 0
    @: spelling char 0
    @: first c.LmP0Text 0
    @: tail c.LmP0Trailer 0
    @: target_field c.LmP0Field 0
    @: target char 0
    @: w_end char c.lmx_graph_intern("end", 3U)
    @: w_launch char c.lmx_graph_intern("()", 2U)
    if: fr = 0 || state = 0
        return: 1
    head_text := lm_graph_p0_head(fr)
    head := lm_graph_p0_name_word(head_text)
    if: head = state\w_node
        return: 0
    if: (fr\flags & c.LM_P0_FRAME_ASSIGN) != 0U
        return: 1
    spelling := c.lmx_graph_intern(lm_graph_p0_data(head_text), lm_graph_p0_length(head_text))
    if: spelling = w_end || spelling = state\w_until
        return: 0
    first := lm_graph_first_atom(fr)
    if: (fr\flags & c.LM_P0_FRAME_COLON) != 0U && first != 0 && lm_graph_p0_name_word(first) = state\w_node
        if: head = state\w_int || head = state\w_at || head = state\w_fn || head = state\w_sub || head = state\w_fm || head = w_launch
            return: 0
        ---
    ---
    tail := (cast: (@: c.LmP0Trailer) fr\trailer)
    if: tail = 0 || tail\spelling = 0 || c.lmx_graph_intern((cast: (@: char) tail\spelling\data), (cast: (size_t) tail\spelling\length)) != w_end
        return: 1
    if: lm_graph_count_active((cast: (@: c.LmP0Structure) tail\body)) != 1U
        return: 0
    target_field := lm_graph_next_active(lm_graph_p0_first((cast: (@: c.LmP0Structure) tail\body)))
    if: target_field = 0 || target_field\value = 0 || target_field\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    target := lm_graph_p0_name_word(lm_graph_p0_atom(lm_graph_p0_value(target_field)))
    if: head = state\w_fn || head = state\w_sub || head = state\w_fm
        return: (cast: (int) (target = head || (first != 0 && target = lm_graph_p0_name_word(first))))
    if: head = w_launch
        return: (cast: (int) (first != 0 && target = lm_graph_p0_name_word(first)))
    return: (cast: (int) (target = head))
end: lm_graph_frame_admitted

fn: lm_graph_build_node (@: g c.LmxGraph; @: parent c.Lmx; @: nd c.LmP0Node; @@: out void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: text c.LmP0Text 0
    @: frame c.LmP0Frame 0
    @: source c.LmP0Structure 0
    @: literal c.LmP0Field 0
    @: value void 0
    @: block c.Lmx 0
    @: head char 0
    int: number 0
    int: status 0
    if: g = 0 || nd = 0 || out = 0
        return: 2
    out[0] := 0
    if: nd\kind = c.LM_P0_NODE_ATOM
        text := lm_graph_p0_atom(nd)
        if: lm_graph_int_literal(text, @ number) != 0
            value := c.lmx_graph_int(g, number)
        else:
            value := c.lmx_graph_word(g, lm_graph_p0_data(text), lm_graph_p0_length(text))
        ---
        if: value = 0
            return: 1
        out[0] := value
        return: 0
    if: nd\kind = c.LM_P0_NODE_FRAME
        frame := lm_graph_p0_frame(nd)
        if: lm_graph_frame_admitted(frame) = 0
            return: 2
        if: (frame\flags & c.LM_P0_FRAME_ASSIGN) != 0U
            return: lm_graph_build_assignment(g, parent, frame, out)
        text := lm_graph_p0_head(frame)
        # Preserve every selector used as the head of a formed Frame. The
        # same selector builder handles paths and attached indices.
        if: lm_graph_path_text(lm_graph_p0_data(text), lm_graph_p0_length(text)) != 0 || lm_graph_index_text(lm_graph_p0_data(text), lm_graph_p0_length(text)) != 0
            status := lm_graph_build_selector(g, lm_graph_p0_data(text), lm_graph_p0_length(text), @ value)
            if: status != 0
                return: status
            return: lm_graph_build_application(g, parent, value, lm_graph_p0_body(frame), (cast: (@: c.LmP0Trailer) frame\trailer), out)
        ---
        head := c.lmx_graph_intern(lm_graph_p0_data(text), lm_graph_p0_length(text))
        if: head = 0
            return: 1
        # A primitive declaration constructs its place before the remaining
        # Frame is classified as a named block or an application. End has
        # already been checked; a real postcondition keeps its loop lowering.
        if: lm_graph_until_tail((cast: (@: c.LmP0Trailer) frame\trailer)) = 0
            value := lm_graph_build_place(g, frame)
            if: value != 0
                out[0] := value
                return: 0
            ---
        ---
        # A named block keeps the same constructor in every position. A block inside a method's data must not
        # become an until receiver wrapped around its own head merely because it is not a root field.
        if: lm_graph_block_item(nd) != 0
            status := lm_graph_build_fields(g, parent, lm_graph_p0_body(frame), 1, (cast: (@: c.LmP0Trailer) frame\trailer), @ block)
            if: status != 0
                return: status
            if: c.lmx_graph_name_address(g, (cast: (@: void) block), head) != 0
                return: 1
            out[0] := (cast: (@: void) block)
            return: 0
        # A literal primitive value has the same physical form everywhere, including a typed RHS.
        if: head = state\w_int && lm_graph_count_active(lm_graph_p0_body(frame)) = 1U
            literal := lm_graph_next_active(lm_graph_p0_first(lm_graph_p0_body(frame)))
            if: literal != 0 && literal\value\kind = c.LM_P0_NODE_ATOM && lm_graph_int_literal(lm_graph_p0_atom(lm_graph_p0_value(literal)), @ number) != 0
                out[0] := c.lmx_graph_int(g, number)
                return: (cast: (int) (out[0] = 0))
            ---
        ---
        # A prefix operator applied in the compact form `-(2 + 3)` is that operation, as everywhere in an expression
        # (§3.3): the operator word and its operand, not a Frame named by a receiver. `@: name T` declares a reference.
        if: (frame\flags & c.LM_P0_FRAME_COLON) = 0U && (head = state\w_plus || head = state\w_minus || head = state\w_deref || head = state\w_at || head = state\w_not)
            value := c.lmx_graph_word(g, lm_graph_p0_data(text), lm_graph_p0_length(text))
            if: value = 0
                return: 1
            return: lm_graph_build_sequence(g, parent, lm_graph_p0_body(frame), 0, value, (cast: (@: c.LmP0Trailer) frame\trailer), out)
        return: lm_graph_build_sequence(g, parent, lm_graph_p0_body(frame), head, 0, (cast: (@: c.LmP0Trailer) frame\trailer), out)
    if: nd\kind = c.LM_P0_NODE_STRUCTURE
        source := lm_graph_p0_structure(nd)
        return: lm_graph_build_sequence(g, parent, source, 0, 0, (cast: (@: c.LmP0Trailer) source\trailer), out)
    return: 2
end: lm_graph_build_node

# Is the written field nd a named block -- a Frame with an end trailer whose head is no word of the language, or data --
# which lm_graph_build_field builds as a named Structure, rather than a statement Frame? 1 or 0.
fn: lm_graph_block_item (@: nd c.LmP0Node) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: fr c.LmP0Frame 0
    @: tail c.LmP0Trailer 0
    @: head char 0
    if: nd = 0 || nd\kind != c.LM_P0_NODE_FRAME
        return: 0
    fr := lm_graph_p0_frame(nd)
    if: (fr\flags & c.LM_P0_FRAME_ASSIGN) != 0U || fr\trailer = 0
        return: 0
    head := c.lmx_graph_intern(lm_graph_p0_data(lm_graph_p0_head(fr)), lm_graph_p0_length(lm_graph_p0_head(fr)))
    if: head = 0 || (lm_graph_data_head(head) = 0 && head != state\w_data)
        return: 0
    tail := (cast: (@: c.LmP0Trailer) fr\trailer)
    if: lm_graph_until_tail(tail) != 0
        return: 1
    return: (cast: (int) (tail\spelling != 0 && c.lmx_graph_intern((cast: (@: char) tail\spelling\data), (cast: (size_t) tail\spelling\length)) = c.lmx_graph_intern("end", 3U)))
end: lm_graph_block_item

# Is field index of result, built from the written field nd, a data field of its Structure -- a named place, the data
# part, a named block -- rather than a statement (a Frame named by its head, §3.3)? 1 or 0.
fn: lm_graph_own_field (@: g c.LmxGraph; @: result c.Lmx; size_t: index; @: nd c.LmP0Node) int
    int: kind c.lmx_graph_kind(g, c.lmx_graph_get(result, index))
    if: kind = 3
        return: 1
    if: kind = 1 || kind = 5 || kind = 6 || kind = 8 || kind = 9
        return: (cast: (int) (c.lmx_graph_slot_name(g, result, index) != 0))
    if: kind = 4
        return: lm_graph_block_item(nd)
    return: 0
end: lm_graph_own_field

# Build data/signature fields through the same constructor. A body retains its written statements and effects.
fn: lm_graph_build_fields (@: g c.LmxGraph; @: parent c.Lmx; @: source c.LmP0Structure; int: declarations; @: tail c.LmP0Trailer; @@: out c.Lmx) int
    @: result c.Lmx 0
    @: outer c.Lmx 0
    @: loop void 0
    size_t: own_count 0U
    size_t: j 0U
    @: item c.LmP0Field 0
    @: value void 0
    size_t: i 0U
    int: status 0
    if: source = 0 || out = 0
        return: 2
    result := c.lmx_graph_lmx(g, parent, lm_graph_count_active(source))
    if: result = 0
        return: 1
    item := lm_graph_next_active(lm_graph_p0_first(source))
    while: item != 0 && status = 0
        if: declarations != 0
            status := lm_graph_build_field(g, result, i, lm_graph_p0_value(item))
        else:
            status := lm_graph_build_node(g, result, lm_graph_p0_value(item), @ value)
            if: status = 0
                status := c.lmx_graph_put(result, i, value)
            ---
        ---
        i := i + 1U
        item := lm_graph_next_active(lm_graph_p0_next(item))
    ---
    if: status = 0 && lm_graph_until_tail(tail) != 0
        # A named Structure retains its ordinary data fields -- places, data, named blocks; a statement is no data field
        # though it is named by its head. Its executable field is the loop; the loop body shares those data fields, so
        # names, references and selected data keep their ordinary meaning.
        i := 0U
        item := lm_graph_next_active(lm_graph_p0_first(source))
        while: i < c.lmx_graph_count(result) && item != 0
            if: lm_graph_own_field(g, result, i, lm_graph_p0_value(item)) != 0
                own_count := own_count + 1U
            i := i + 1U
            item := lm_graph_next_active(lm_graph_p0_next(item))
        ---
        outer := c.lmx_graph_lmx(g, parent, own_count + 1U)
        if: outer = 0
            return: 1
        i := 0U
        item := lm_graph_next_active(lm_graph_p0_first(source))
        while: i < c.lmx_graph_count(result) && item != 0 && status = 0
            if: lm_graph_own_field(g, result, i, lm_graph_p0_value(item)) != 0
                status := lm_graph_build_put(g, outer, j, c.lmx_graph_get(result, i))
                j := j + 1U
            i := i + 1U
            item := lm_graph_next_active(lm_graph_p0_next(item))
        ---
        if: status = 0
            status := lm_graph_build_post(g, outer, result, tail, @ loop)
        if: status = 0
            status := c.lmx_graph_put(outer, own_count, loop)
        result := outer
    ---
    out[0] := result
    return: status
end: lm_graph_build_fields


# Input-boundary classification of a named data block. An unsupported language receiver must remain an executable
# Frame and fail explicitly in its consumer, rather than becoming inert data merely because it has an end trailer.
fn: lm_graph_data_head (@: head char) int
    return: (cast: (int) (c.lmx_graph_language_receiver(head) = 0))
end: lm_graph_data_head

# One written field of the root into slot of root: a declaration `int: name` is a place without a value and `int: name
# literal` an int place, each named at its cell; everything else is the written nd itself (a statement with a word
# head, a bare atom, a block). 0, 1 without memory, 2 for a nd of no known kind.
fn: lm_graph_build_field (@: g c.LmxGraph; @: root c.Lmx; size_t: slot; @: nd c.LmP0Node) int
    @: value void 0
    int: r 0
    if: g = 0 || root = 0 || nd = 0
        return: 2
    r := lm_graph_build_node(g, root, nd, @ value)
    if: r != 0
        return: r
    return: c.lmx_graph_put(root, slot, value)
end: lm_graph_build_field

# The root of a parsed document as a root Lmx of the arena of g: one slot per active field, built in the written order.
# 0 and the root in out; 1 without memory; 2 when the document has no root Structure or a nd of no known kind.
fn: lm_graph_build_root (@: g c.LmxGraph; @: doc c.LmP0Document; @@: out c.Lmx) int
    @: nd c.LmP0Node (cast: (@: c.LmP0Node) c.lm_p0_document_root(doc))
    @: s c.LmP0Structure 0
    @: f c.LmP0Field 0
    @: root c.Lmx 0
    size_t: n 0U
    size_t: i 0U
    int: r 0
    if: g = 0 || out = 0 || nd = 0 || nd\kind != c.LM_P0_NODE_STRUCTURE
        return: 2
    out[0] := 0
    s := lm_graph_p0_structure(nd)
    n := lm_graph_count_active(s)
    root := c.lmx_graph_lmx(g, 0, n)
    if: root = 0
        return: 1
    f := lm_graph_next_active(lm_graph_p0_first(s))
    while: f != 0
        r := lm_graph_build_field(g, root, i, lm_graph_p0_value(f))
        if: r != 0
            return: r
        i := i + 1U
        f := lm_graph_next_active(lm_graph_p0_next(f))
    ---
    out[0] := root
    return: 0
end: lm_graph_build_root

# The clean graph of the source file at path in the arena of g: parsed by P0, built, the parse tree destroyed. 0 and
# the root in out; 1 without memory; 2 when the file does not parse (the diagnostic printed) or has an unknown nd.
fn: lm_graph_build_file (@: g c.LmxGraph; const: (@: path char); @@: out c.Lmx) int
    @: doc c.LmP0Document 0
    @: diag c.LmP0Diagnostic 0
    int: r 0
    if: g = 0 || path = 0 || out = 0
        return: 2
    out[0] := 0
    if: c.lm_p0_parse_file(path, @ doc) != 0
        if: doc != 0
            diag := (cast: (@: c.LmP0Diagnostic) c.lm_p0_document_diagnostic(doc))
            if: diag != 0
                c.fprintf(c.stderr, "graph: %s:%zu:%zu: %s\n", path, (cast: (size_t) (diag\line)), (cast: (size_t) (diag\column)), (cast: (@: char) (diag\message)))
            c.lm_p0_document_destroy(doc)
        else:
            c.fprintf(c.stderr, "graph: %s: cannot read or parse\n", path)
        ---
        return: 2
    r := lm_graph_build_root(g, doc, out)
    c.lm_p0_document_destroy(doc)
    return: r
end: lm_graph_build_file
