        return: (cast: (int) (0))
    f: c.lm_compiler_next_active((cast: (@: c.LmP0Field) (cur_unit_cell[0]\first_field)))
    while: f != 0 && f\value != item
        it: f\value
        if: c.lm_compiler_receiver_frame(it, @ got) != 0 && c.lm_compiler_text_same(got, a) != 0
            return: (cast: (int) (1))
        if: it != 0 && it\kind = c.LM_P0_NODE_FRAME && it\as != 0 && it\as\frame != 0 && it\as\frame\head != 0 && it\as\frame\body != 0
            if: c.lm_compiler_text_same((cast: (const: @: c.LmP0Text) (it\as\frame\head)), a) != 0 && lm_compiler_decl_content((cast: (const: @: c.LmP0Frame) (it\as\frame)), it, 0 - 1, 0 - 1) = 3
                return: (cast: (int) (1))
            if: c.lm_compiler_text_same((cast: (const: @: c.LmP0Text) (it\as\frame\head)), a) != 0 && c.lm_compiler_ref_tail_atom((cast: (const: @: c.LmP0Frame) (it\as\frame))) != 0 && lm_compiler_unit_ref_bind((cast: (const: @: c.LmP0Frame) (it\as\frame)), it) != 0 && lm_compiler_head_absent(a, it) != 0
                return: (cast: (int) (1))
            if: c.lm_compiler_address_depth((cast: (const: @: c.LmP0Text) (it\as\frame\head))) = 1
                g: c.lm_compiler_next_active((cast: (@: c.LmP0Field) (it\as\frame\body\first_field)))
                h: 0
                if: g != 0
                    h: c.lm_compiler_next_active((cast: (@: c.LmP0Field) (g\next)))
                if: g != 0 && h != 0 && g\value != 0 && h\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM && h\value\kind = c.LM_P0_NODE_ATOM && g\value\as != 0 && h\value\as != 0 && c.lm_compiler_text_same((cast: (const: @: c.LmP0Text) (g\value\as\atom)), a) != 0 && lm_compiler_unit_defines_struct((cast: (const: @: c.LmP0Text) (h\value\as\atom)), it) != 0
                    return: (cast: (int) (1))
                ---
            ---
        ---
        f: c.lm_compiler_next_active((cast: (@: c.LmP0Field) (f\next)))
    ---
    return: (cast: (int) (0))
