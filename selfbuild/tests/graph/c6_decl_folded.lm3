# Witness c6_decl_folded -- f(int: a 5) with f(int: a) and f(u8: a): the form is a Structure at position 0
# that neither primitive input admits (the book #declaration-arguments; Р157, Р158): the call is refused,
# answer 4; r 0, seen 0 (tick is not called)
# Norm: fable R102/R103; step C6 (PLAN §17)
(
    Observed:
        int: seen 0
        int: r 0
)
fn: tick () int
    @: shared node[0]
    shared\Observed\seen := shared\Observed\seen + 1
    return: 3
fn: f (int: a) int
    @: shared node[0]
    shared\Observed\r := a
    return: a
fn: f (u8: a) int
    return: 2
sub: main ()
    f(int: a 5)
main()
