end: decl_l2_frontend_state

# A generated aggregate and a thin C main; no compiler or CLI algorithm is printed here.
fn: decl_l2_frontend_root (@: f c.FILE) int
    if: c.fputs("# Generated by maintained L3; compiler algorithms and CLI remain ordinary L2.\npredef: \"l1src/parser.lm1\"\npredef: \"l1src/libc_abi.lm1\"\npredef: \"l2src/l2_application.h.lm1\"\npredef: \"l2src/l2_frontend_helpers.h.lm1\"\npredef: \"l2src/l2_frontend_alloc.h.lm1\"\npredef: \"l2src/l2_frontend_values.h.lm1\"\npredef: \"l2src/l2_frontend_views.h.lm1\"\npredef: \"l2src/l2_frontend_context.h.lm1\"\npredef: \"l2src/l2_frontend_types.h.lm1\"\npredef: \"l2src/l2_frontend_coords.h.lm1\"\npredef: \"l2src/l2_frontend_resolve.h.lm1\"\npredef: \"l2src/l2_frontend_intern.h.lm1\"\npredef: \"l2src/l2_frontend_useplan.h.lm1\"\npredef: \"l2src/l2_frontend_lower.h.lm1\"\npredef: \"l2src/l2_frontend_core.h.lm1\"\npredef: \"l2src/l2_frontend_emit.h.lm1\"\npredef: \"l2src/l2_copy_uses.lm1\"\npredef: \"l2src/l2_receiving_source.lm1\"\npredef: \"l2src/l2_consumer_uses.lm1\"\ninclude: \"<stdio.h>\" \"<string.h>\" \"<limits.h>\" \"<stdlib.h>\"\npredef: \"l2src/l2_machine_types.lm1\"\n\nimport: \"l2src/l2_frontend_state.lm1\"\nimport: \"l2src/l2_frontend_alloc.lm1\"\nimport: \"l2src/l2_frontend_values.lm1\"\nimport: \"l2src/l2_frontend_views.lm1\"\nimport: \"l2src/l2_frontend_context.lm1\"\nimport: \"l2src/l2_frontend_types.lm1\"\nimport: \"l2src/l2_frontend_coords.lm1\"\nimport: \"l2src/l2_frontend_resolve.lm1\"\nimport: \"l2src/l2_frontend_intern.lm1\"\nimport: \"l2src/l2_frontend_useplan.lm1\"\nimport: \"l2src/l2_frontend_lower.lm1\"\nimport: \"l2src/l2_frontend_helpers.lm1\"\nimport: \"l2src/l2_frontend_core.lm1\"\nimport: \"l2src/l2_frontend_emit.lm1\"\n\nexternal:\n    fn: main (int: argc; @@: char argv) int\n    return: lm_compiler_cli_main(argc, argv)\nend: external\n", f) < 0
        return: 1
    return: 0
end: decl_l2_frontend_root

fn: decl_l2_immut_query (@: f c.FILE) int
    if: c.fputs("include: \"<stddef.h>\" \"<stdint.h>\"\n\n# Explicit borrowed immutable-query adapter.  Not LmP0Text and not an Lmx Structure\n# with a C layout.\n#\n# data points at caller-owned bytes that must stay unchanged and alive for the\n# lifetime of this object.  A program-lifetime C string literal satisfies that.  A\n# const char * formal does not prove it for an arbitrary buffer.\n#\n# The adapter does not own or copy the bytes.  hash is FNV-1a 64 of those bytes,\n# computed once by l2_immut_query_fill.  live==0 means invalid: compares must not\n# read data/hash.\nstruct: L2ImmutQuery\n    const: @: char data\n    size_t: length\n    uint64_t: hash\n    int: live\nend: L2ImmutQuery\n", f) < 0
        return: 1
    return: 0
end: decl_l2_immut_query

fn: decl_parser_alloc_port_l2 (@: f c.FILE) int
    if: c.fputs("include: \"l1src/p0.lm1.h\"\n\n# Header unit for the clean L2 port of l1src/parser.lm1's node/\n# structure/frame allocation (parser-in-L2 port ticket, Stage c).\n# lm_own_arena_new_zero is L1-implemented (l1src/own.lm1, compiled\n# into the same oracle object this L2 unit links against) -- Stage A\n# rule: an LMX name needs a prototype: declaration here, never c.\n#\n# lm_p0_set_diagnostic and lm_p0_new_text are the oracle's OWN\n# still-un-ported names (diagnostics and Document text registration\n# are their own later stages -- e2, 2026-09-14). Calling a\n# not-yet-ported oracle function by its lm_p0_* name through a\n# prototype: declaration is the same Stage A shape, correct for an\n# L1-implemented LMX name whether or not it happens to be this port's\n# own future territory. No source change is needed when that stage\n# lands: run_port_parser.ps1 applies the full cumulative -D redirect\n# set to every object it compiles, patched oracle and every generated\n# unit's C alike, so this unit's call text (staying lm_p0_set_\n# diagnostic literally) retargets to p0_set_diagnostic at its next\n# compile once stage (g) adds it to the Funcs list.\n\nprototype:\n    fn: lm_own_arena_new_zero (@: LmOwnArena arena; size_t: size) @: void\n    sub: lm_p0_set_diagnostic (@: LmP0Document document; int: code; size_t: line; size_t: column; const: @(char message))\n    fn: lm_p0_new_text (@: LmP0Document document; const: @(char source); size_t: length; size_t: line; size_t: column) @: LmP0Text\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_parser_alloc_port_l2

fn: decl_parser_scan_port_l2 (@: f c.FILE) int
    if: c.fputs("include: \"l1src/p0.lm1.h\"\n\n# Header unit for the clean L2 port of l1src/parser.lm1's scanning\n# primitives (parser-in-L2 port ticket, Stage b). p0_is_horizontal_space,\n# p0_is_line_break and p0_line_break_width_at are this port's own L2\n# implementations, landed in Stage a (l2src/parser_text_port.lm2) --\n# not the oracle's lm_p0_ names, so this is a plain prototype:\n# declaration of a real L2 symbol, the same shape Stage A uses for an\n# L1-implemented external name.\n\nprototype:\n    fn: p0_is_horizontal_space (char: value) int\n    fn: p0_is_line_break (char: value) int\n    fn: p0_line_break_width_at (const: @(char source); size_t: length; size_t: index) size_t\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_parser_scan_port_l2

fn: decl_parser_text_port_l2 (@: f c.FILE) int
    if: c.fputs("include: \"l1src/p0.lm1.h\"\n\n# Header unit for the clean L2 port of l1src/parser_text.lm1 (parser-\n# in-L2 port ticket, Stage a: parser_text.lm1 primitives). l1src/\n# p0.lm1.h supplies LmP0Text and LmOwnDestroyFields (l1trans generates\n# it from l1src/p0.h.lm1, already predef'd/included by the oracle's\n# own parser.lm1.c). lm_own_new_zero, lm_own_copy_bytes and lm_own_\n# delete are L1-implemented (l1src/own.lm1, compiled into the same\n# oracle object this L2 unit links against) -- Stage A rule: an LMX\n# name needs a prototype: declaration here, never c.\n\nprototype:\n    fn: lm_own_new_zero (size_t: size) @: void\n    fn: lm_own_copy_bytes (const: @(char source); size_t: length) @: char\n    sub: lm_own_delete (@: void object; LmOwnDestroyFields: destroy_fields)\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_parser_text_port_l2

fn: decl_p0_parser_forward (@: f c.FILE) int
    if: c.fputs("# Generated bindings only; P0 algorithms are maintained in L2.\npredef: \"l2src/p0_own.lm1\"\npredef: \"l2src/p0_text.lm1\"\npredef: \"l2src/p0_scan.lm1\"\npredef: \"l1src/libc_abi.lm1\"\npredef: \"l2src/p0_parser.lm1\"\n", f) < 0
        return: 1
    return: 0
end: decl_p0_parser_forward

# These libc declarations are output text, emitted by ordinary L3 code before their consumers.
# No L2 syntax or layout description is needed; the old declaration bytes are preserved.
fn: decl_libc_abi (@: f c.FILE) int
    if: c.fputs("# L1-слой libc: обычные L1-функции, которые зовут libc БЕЗ ресивера c.\n#\n# Распоряжение Михаила (2026-09-18): «ресивер C: не используем — он остаётся в языке\n# как возможность, рабочих употреблений не заводим. Нужен printf и прочая libc —\n# берём из L1-слоя (обычные L1-функции, вызов без ресивера); вариативные\n# (fprintf/sprintf) покрываются L1-обёртками — varargs в языке нет».\n#\n# Как это работает: файл объявляет функции БЕЗ тела — такие объявления\n# отображаются на одноимённые функции C, которые даёт сама libc, и вызываются из\n# L1 как обычные акты. Функции С телом (ниже l1_stdout/l1_stderr) транслируются в\n# C-функции и тоже зовутся без ресивера.\n#\n# ЧЕГО ЗДЕСЬ ПОКА НЕТ (считать долгом, а не сделанным):\n#   * вариативные printf / fprintf / sprintf — нужны обёртки под каждую форму\n#     вызова (varargs в языке нет). Замер употреблений c.* по дереву на 18.09:\n#     c.fprintf 515, c.printf 382, c.fputs 240, c.free 212, c.fclose 205,\n#     c.memset 151, c.memcmp 84, c.stderr 65, c.memcpy 61, c.calloc 61,\n#     c.sprintf 51, c.strlen 35, c.INT_MAX 35;\n#   * INT_MAX — это макрос C, а не функция; как отдавать его из L1-слоя, решается\n#     отдельно (подставлять число — это заявление о переносимости, которого я не\n#     делаю молча).\n\ninclude: \"<stdio.h>\" \"<stdlib.h>\" \"<string.h>\"\n\n# --- память -------------------------------------------------------------------\n", f) < 0
        return: 1
    if: c.fputs("fn: malloc (size_t: bytes) @: void\nfn: calloc (size_t: count; size_t: size) @: void\nfn: realloc (@: void block; size_t: bytes) @: void\nfn: free (@: void block) void\n\n# --- байты и строки (сравнение/копирование уже были ниже) ----------------------\nfn: memset (@: void target; int: value; size_t: length) @: void\nfn: memmove (@: void target; const: @(void source); size_t: length) @: void\nfn: memcmp (const: @(void left); const: @(void right); size_t: length) int\n\n# --- вывод --------------------------------------------------------------------\nfn: fputs (const: @(char text); @: FILE stream) int\nfn: puts (const: @(char text)) int\nfn: putchar (int: value) int\n\n# --- отказ --------------------------------------------------------------------\nfn: abort () void\nfn: exit (int: status) void\n\n# --- потоки: без ресивера c. --------------------------------------------------\n# ОБЪЯВЛЕНИЯ, без тел — и это не мелочь. `predef:` тянет тела в каждый модуль,\n# который подключает файл, поэтому функция С ТЕЛОМ здесь давала бы по определению\n# на каждый модуль и «multiple definition» на линковке (поймано гейтом 18.09:\n# lmx_dec.o и lmx_dec_selftest.o). Тела живут ровно в одном компилируемом юните —\n# l2src\\l2_libc.lm1; здесь только прототипы.\nfn: l1_stdout () @: FILE\nfn: l1_stderr () @: FILE\n\n# --- уже было (парсер и транслятор на них стоят) -------------------------------\n", f) < 0
        return: 1
    if: c.fputs("fn: getenv (const: @(char name)) @: char\nfn: strlen (const: @(char text)) size_t\nfn: strchr (const: @(char text); int: value) @: char\nfn: memcpy (@: void target; const: @(void source); size_t: length) @: void\nfn: strcpy (@: char target; const: @(char source)) @: char\nfn: strcat (@: char target; const: @(char source)) @: char\nfn: system (const: @(char command)) int\nfn: remove (const: @(char path)) int\nfn: fopen (const: @(char path); const: @(char mode)) @: FILE\nfn: fclose (@: FILE file) int\nfn: fread (@: void buffer; size_t: item_size; size_t: item_count; @: FILE file) size_t\nfn: fwrite (const: @(void buffer); size_t: item_size; size_t: item_count; @: FILE file) size_t\nfn: ferror (@: FILE file) int\nfn: strcmp (const: @(char left); const: @(char right)) int\n", f) < 0
        return: 1
    return: 0
end: decl_libc_abi

# P0 support is generated by an explicitly supplied previous frontend.
# This is an ordinary component step of the existing bootstrap, not a fallback.
fn: bld_p0_l2 (@: rec c.FILE; @: repo char; @: stage char; @: base char; @: previous_fe char; @: out char; @: res int) int
    @: src char txt_path(stage, "src")
    @: libc_dir char txt_path(stage, "src/l1src")
    @: libc_abi char txt_path(stage, "src/l1src/libc_abi.lm1")
    @@: own_names char c.calloc(24U, sizeof(@: char))
    @@: text_names char c.calloc(15U, sizeof(@: char))
    @@: scan_names char c.calloc(6U, sizeof(@: char))
    @@: copy_names char c.calloc(3U, sizeof(@: char))
    @@: parser_names char c.calloc(21U, sizeof(@: char))
    @@: type_names char c.calloc(2U, sizeof(@: char))
    @@: receiving_names char c.calloc(1U, sizeof(@: char))
    @@: consumer_names char c.calloc(5U, sizeof(@: char))
    @@: frontend_names char c.calloc(257U, sizeof(@: char))
    @@: frontend_alloc_names char c.calloc(20U, sizeof(@: char))
    @@: frontend_value_names char c.calloc(149U, sizeof(@: char))
    @@: frontend_view_names char c.calloc(101U, sizeof(@: char))
    @@: frontend_context_names char c.calloc(113U, sizeof(@: char))
    @@: frontend_type_names char c.calloc(51U, sizeof(@: char))
    @@: frontend_coord_names char c.calloc(112U, sizeof(@: char))
    @@: frontend_resolve_names char c.calloc(121U, sizeof(@: char))
    @@: frontend_intern_names char c.calloc(19U, sizeof(@: char))
    @@: frontend_useplan_names char c.calloc(148U, sizeof(@: char))
    @@: frontend_lower_names char c.calloc(439U, sizeof(@: char))
    @@: frontend_core_names char c.calloc(492U, sizeof(@: char))
    @@: frontend_emit_names char c.calloc(310U, sizeof(@: char))
    @@: generated char c.calloc(87U, sizeof(@: char))
    int: k 0
    if: src = 0 || libc_dir = 0 || libc_abi = 0 || own_names = 0 || text_names = 0 || scan_names = 0 || copy_names = 0 || parser_names = 0 || type_names = 0 || receiving_names = 0 || consumer_names = 0 || frontend_names = 0 || frontend_alloc_names = 0 || frontend_value_names = 0 || frontend_view_names = 0 || frontend_context_names = 0 || frontend_type_names = 0 || frontend_coord_names = 0 || frontend_resolve_names = 0 || frontend_intern_names = 0 || frontend_useplan_names = 0 || frontend_lower_names = 0 || frontend_core_names = 0 || frontend_emit_names = 0 || generated = 0 || previous_fe = 0 || file_exists(previous_fe) = 0
        return: 1
    # Never select legacy handwritten algorithm/ABI inputs from a stale stage.
    if: file_exists(txt_path(src, "l1src/own.lm1")) != 0 || file_exists(txt_path(src, "l1src/parser_text.lm1")) != 0 || file_exists(txt_path(src, "l1src/p0.h")) != 0 || file_exists(txt_path(src, "l2src/l2trans.lm1")) != 0
        c.printf("P0 legacy maintained input present in %s\n", src)
        return: 1
    own_names[0]: "lm_own_should_fail"
    own_names[1]: "lm_own_new_zero"
    own_names[2]: "lm_own_resize"
    own_names[3]: "lm_own_copy_bytes"
    own_names[4]: "lm_own_delete"
    own_names[5]: "lm_own_delete_plain"
    own_names[6]: "lm_own_pointer_array_delete"
    own_names[7]: "lm_own_ptr_stack_init"
    own_names[8]: "lm_own_ptr_stack_destroy"
