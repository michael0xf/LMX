# -193 T4a: walked recursion (WalkMethods).  Every call runs the callee over its own occurrence, [call, M, M, ...] --
# a re-entry too (the author, 2026-09-28: no per-call instance): each activation keeps its own `keep` as its working
# value (§7b) while the ones it calls run -- the direct recursion of sum and the mutual one of even and odd -- and a
# re-entrant activation publishes nothing (Codex, 2026-09-28).  Were the inner activations' values the outer ones'
# storage, sum(4) would not be 10.
fn: sum (int: n) int
    int: keep
    int: rest
    keep: n
    rest: 0
    if: n > 0
        rest: sum(n - 1)
    return: keep + rest
end: sum

fn: even (int: n) int
    int: keep
    int: got
    keep: n
    if: n = 0
        return: 1
    got: odd(n - 1)
    if: keep != n
        return: 9
    return: got
end: even

fn: odd (int: n) int
    int: keep
    int: got
    keep: n
    if: n = 0
        return: 0
    got: even(n - 1)
    if: keep != n
        return: 9
    return: got
end: odd

int: r
r: sum(4)
if: r != 10
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
r: even(6)
if: r != 1
    sendMessage: exit(exit_code: 82; stdout: ""; stderr: "")
    return
r: odd(6)
if: r != 0
    sendMessage: exit(exit_code: 83; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
