predef: "l2src/lmx_call.h.lm1"
predef: "l2src/lmx_merge_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# LmxCallable.offset (D-29 / FABLE-GROKBOT-MERGE-OFFSET-20260924-153).
# Pins:
#   * constructor offset is 0
#   * missing child 0 / not callable -> (size_t)-1, never 0-as-missing
#   * plain graph copy keeps source offset and SHARES the descriptor
#   * merge COW-clones the descriptor when writing offset (per-occurrence record)
#   * merge: B A with callable in A -> copied offset == width(B)
#   * merge: A alone -> offset 0; original stays 0
#   * two-operand merge, callable in second operand + body -> body offset == width(A)+width(B)
# Mutant: if merge never writes offset, the width(B) check goes RED.

fn: offset_entry (@: Lmx node; @: Lmx self) int
return: 0

sub: offset_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: offset_check

fn: offset_struct (@: LmxArena arena; size_t: slots) @: Lmx
    @: Lmx structure
    structure: lmx_node_new_owned(arena)
    if: structure = 0
        return: 0
    ---
    if: slots != 0U && lmx_arena_refs_open_owned(arena, structure, slots) != 0
        return: 0
    ---
return: structure

fn: offset_callable_occ (@: LmxArena arena; @: LmxMethod method) @: Lmx
    @: Lmx occ
    @: LmxCallable info
    occ: offset_struct(arena, 1U)
    info: lmx_callable_new_owned(arena)
    if: occ = 0 || info = 0 || method = 0
        return: 0
    ---
    info\method: method
    if: lmx_arena_ref_store(occ, 0U, (cast: (@: void) info)) != 0
        return: 0
    ---
return: occ

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: arena
    LmxArena: dst
    @: LmxArena arena_at
    @: LmxArena dst_at
    @: LmxMethod method 0
    @: Lmx a 0
    @: Lmx b 0
    @: Lmx body 0
    @: Lmx occ_a 0
    @: Lmx occ_body 0
    @: Lmx result 0
    @: Lmx copied 0
    @: LmxCallable info_src 0
    @: LmxCallable info_dst 0
    @: void cell 0
    @@: Lmx operands 0
    size_t: missing (cast: (size_t) -1)
    size_t: width_b 0U
    size_t: width_a 0U
    size_t: off 0U
    int: status 0
    int: failures 0

    if: counts = 0
        return: 2
    ---
    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ dst)), 0, c.sizeof(c.LmxArena))
    arena_at: @ arena
    dst_at: @ dst
    if: lmx_arena_open(@ arena) != 0 || lmx_arena_open(@ dst) != 0
        fputs("lmx_callable_offset: arena open failed\n", l1_stdout())
        free(counts)
        return: 2
    ---
    method: lmx_method_new_owned(@ arena)
    if: method = 0
        free(counts)
        return: 2
    ---
    method\addr: (cast: (LmxEntry) offset_entry)
    method\sig: 1U

    operands: (cast: (@@: Lmx) calloc(2U, c.sizeof(@: void)))
    if: operands = 0
        free(counts)
        return: 2
    ---

    # --- accessor: missing must not look like offset 0 ---
    offset_check(counts, lmx_callable_offset(arena_at, 0) = missing, "null occurrence returned 0-as-missing")
    a: offset_struct(@ arena, 0U)
    offset_check(counts, a != 0 && lmx_callable_offset(arena_at, a) = missing, "empty Structure returned 0-as-missing")
    a: offset_struct(@ arena, 1U)
    offset_check(counts, a != 0 && lmx_callable_offset(arena_at, a) = missing, "null child[0] returned 0-as-missing")
    # D-32: child[0] that is not CALLABLE must use the same sentinel (classified
    # in the occurrence-field arena), never look like offset 0.
    a: offset_struct(@ arena, 1U)
    cell: lmx_size_new_owned(@ arena)
    offset_check(counts, a != 0 && cell != 0 && lmx_arena_ref_store(a, 0U, cell) = 0, "non-CALLABLE child[0] fixture")
    offset_check(counts, lmx_callable_offset(arena_at, a) = missing, "non-CALLABLE child[0] returned 0-as-missing")


    # --- constructor offset is 0 ---
    occ_a: offset_callable_occ(@ arena, method)
    info_src: (cast: (@: LmxCallable) lmx_arena_ref_value(occ_a, 0U))
    offset_check(counts, occ_a != 0 && info_src != 0 && info_src\offset = 0U, "constructor offset was not 0")
    offset_check(counts, lmx_callable_offset(arena_at, occ_a) = 0U, "accessor did not see constructor 0")

    # --- plain graph copy: per-copy descriptor, source offset kept ---
    info_src\offset: 5U
    copied: 0
    status: lmx_graph_copy_owned(occ_a, 0, @ arena, @ dst, @ copied)
    offset_check(counts, status = LMX_GRAPH_COPY_OK && copied != 0, "plain graph copy of callable occ failed")
    info_dst: (cast: (@: LmxCallable) lmx_arena_ref_value(copied, 0U))
    offset_check(counts, info_dst != 0 && info_dst = info_src, "plain copy must SHARE LmxCallable by address")
    offset_check(counts, info_dst\method = info_src\method, "plain copy did not share LmxMethod by address")
    offset_check(counts, info_dst\offset = 5U && lmx_callable_offset(dst_at, copied) = 5U, "plain copy did not keep source offset")
    offset_check(counts, info_src\offset = 5U, "plain copy mutated source offset")
    info_src\offset: 0U

    # --- merge: A alone -> offset 0; original stays 0 ---
    a: offset_struct(@ arena, 1U)
    occ_a: offset_callable_occ(@ arena, method)
    info_src: (cast: (@: LmxCallable) lmx_arena_ref_value(occ_a, 0U))
    lmx_arena_ref_store(a, 0U, (cast: (@: void) occ_a))
    occ_a\parent: a
    operands[0]: a
    result: 0
    status: lmx_merge_owned(operands, 1U, 0, 0, 0, @ arena, @ dst, @ result)
    offset_check(counts, status = LMX_MERGE_OK && result != 0 && result\len = 1, "merge: A failed")
    copied: (cast: (@: Lmx) lmx_arena_ref_value(result, 0U))
    offset_check(counts, copied != 0 && copied\parent = result, "merge: A did not rewrite parent to result")
    offset_check(counts, lmx_callable_offset(dst_at, copied) = 0U, "merge: A offset was not 0")
    offset_check(counts, info_src\offset = 0U && lmx_callable_offset(arena_at, occ_a) = 0U, "merge: A mutated original offset")

    # --- merge: B A with callable in A -> offset == width(B) ---
    b: offset_struct(@ arena, 1U)
    cell: lmx_size_new_owned(@ arena)
    lmx_size_store_known(cell, 42U)
    lmx_arena_ref_store(b, 0U, cell)
    a: offset_struct(@ arena, 1U)
    occ_a: offset_callable_occ(@ arena, method)
    info_src: (cast: (@: LmxCallable) lmx_arena_ref_value(occ_a, 0U))
    lmx_arena_ref_store(a, 0U, (cast: (@: void) occ_a))
    occ_a\parent: a
    width_b: lmx_merge_width(b)
    width_a: lmx_merge_width(a)
    offset_check(counts, width_b = 1U && width_a = 1U, "operand widths are not 1")
    operands[0]: b
    operands[1]: a
    result: 0
    status: lmx_merge_owned(operands, 2U, 0, 0, 0, @ arena, @ dst, @ result)
    offset_check(counts, status = LMX_MERGE_OK && result != 0 && result\len = 2, "merge: B A failed")
    copied: (cast: (@: Lmx) lmx_arena_ref_value(result, 1U))
    offset_check(counts, copied != 0 && copied\parent = result, "merge: B A parent not result")
    off: lmx_callable_offset(dst_at, copied)
    offset_check(counts, off = width_b, "merge: B A copied offset != width(B) (mutant: offset never written)")
    info_dst: (cast: (@: LmxCallable) lmx_arena_ref_value(copied, 0U))
    offset_check(counts, info_dst != 0 && info_dst != info_src, "merge: B A did not COW-clone LmxCallable")
    offset_check(counts, info_dst\method = info_src\method, "merge: B A COW lost shared LmxMethod")
    offset_check(counts, info_src\offset = 0U, "merge: B A mutated original offset")

    # --- body callable offset == width(A)+width(B) ---
    a: offset_struct(@ arena, 1U)
    cell: lmx_int_new_owned(@ arena)
    lmx_int_store_known(cell, 1)
    lmx_arena_ref_store(a, 0U, cell)
    b: offset_struct(@ arena, 1U)
    cell: lmx_int_new_owned(@ arena)
    lmx_int_store_known(cell, 2)
    lmx_arena_ref_store(b, 0U, cell)
    body: offset_struct(@ arena, 1U)
    occ_body: offset_callable_occ(@ arena, method)
    lmx_arena_ref_store(body, 0U, (cast: (@: void) occ_body))
    occ_body\parent: body
    width_a: lmx_merge_width(a)
    width_b: lmx_merge_width(b)
    operands[0]: a
    operands[1]: b
    result: 0
    status: lmx_merge_owned(operands, 2U, body, 0, 0, @ arena, @ dst, @ result)
    offset_check(counts, status = LMX_MERGE_OK && result != 0 && result\len = 3, "merge: A B + body failed")
    copied: (cast: (@: Lmx) lmx_arena_ref_value(result, 2U))
    offset_check(counts, copied != 0 && copied\parent = result, "body callable parent not result")
    off: lmx_callable_offset(dst_at, copied)
    offset_check(counts, off = width_a + width_b, "body callable offset != width(A)+width(B)")

    failures: counts[1]
    c.printf("lmx_callable_offset checks=%d failures=%d\n", counts[0], failures)
    free((cast: (@: void) operands))
    free(counts)
    lmx_arena_release(@ arena)
    lmx_arena_release(@ dst)
return: failures
