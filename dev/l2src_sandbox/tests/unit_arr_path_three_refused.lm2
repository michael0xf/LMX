# `char: []: []: mainArgs` has two levels: a third index has nothing to index -- said at the step (R5-3b, R5-G3: an index
# needs an Array value).  Before: "an indexed field path needs decimal literal indices, within a fixed Array's count, into
# a declared Array field" from the two-literal-index route, which is gone.
MainLetter:
    char: []: []: mainArgs
end: MainLetter

@: MainLetter m
receiveMessage: m
if: m\mainArgs[1][0][0] != 0
    sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
