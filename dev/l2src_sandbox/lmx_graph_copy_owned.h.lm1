predef: "l2src/lmx.h.lm1"
include: "<stddef.h>"
predef: "l2src/lmx_arena.h.lm1"

# Used-graph copy: the ONE traversal shared by merge and Message creation
# (SPEC 2.3, ABI 8.2, user decision 2026-09-12).
#
# TWO arenas, because the act has two sides.  `src_arena` is the arena the source
# graph lives in: every classification question -- what is this address, which
# array of the arena contains it, how wide is one cell of it -- is asked of it,
# and nothing else answers.  `dst_arena` is the arena the copies are built in:
# every constructor takes it and it owns everything the operation allocates.
#
# Starting from `source`, walk its structural chain to parent = 0 and copy the whole
# reachable lexical tree: every Structure reached through node or through a
# child slot, all of its slots, mutable primitive cells, char * cells, Array
# records with their backing and reference-valued elements.
# Pointer cells (@: T): the cell is copied; the pointee is SHARED (-186 k3).
# `independent` bounds the walk because its root already has parent = 0.  A method occurrence
# is a Structure like any other and is copied; what stays shared is its implementation: the
# `native` word, the C entry that receives the graph node, is carried verbatim (Q44, the
# author, 2026-09-28: the shared reference is to the native implementation, "К структурам это
# отношения не имеет"). Unqualified char fields are copied through the same
# allocate-and-map protocol as other primitives; copying needs no character table.
#
# Q38/Q42/Q44 (the author, 2026-09-27/28; steps/copier-q42.md): every Structure the walk
# reaches is copied, wherever its parent lies -- a method occurrence included.  The former k.4
# rule ("a Structure whose parent lies outside the copied operand subtree is a shared
# reference") is gone: nothing outside what is copied is visible, and no Structure is shared by
# address.  Shared by address are only code frames (a frame headed by an op or role record --
# code, never written by execution), exact retained profiles (eternal branches, below) and the
# terminals of lmx_copy_is_terminal_profiles.
#
# A branch qualified `independent: const: immutable` is retained only when its
# address resolves to one of the exact physical profiles supplied by the caller.  The
# profile belongs to the typed range's array descriptor; kind/type remain its
# exact representation.  Sealing, foreign ownership and parent=0 are not
# substitutes.  Imported sealed foreign ranges are visible in the same source
# arena index, while local ownership queries remain local.  Before a retained reference
# may enter the destination, its sealed owner range must also have been explicitly imported
# into the destination; copy refuses rather than publishing an unclassifiable pointer.  The
# profile set is a caller-provided span of ordinary physical graph references, bounded only
# by this call. Duplicate references are idempotent; no global, numeric or textual profile
# identity participates.
#
# A value the table does not classify at all (LMX_KIND_NONE) is neither
# language-owned source state nor a terminal: the copy reports UNSUPPORTED
# rather than silently retaining a raw pointer. That answer comes from the same
# table that types every child, not from an inventory the caller supplies.
#
# One operation-local source-address -> destination-address map spans the
# WHOLE operation, across all roots of lmx_graph_copy_many_owned (merge with
# several operands): an object reachable from two roots is copied once and
# both copies refer to it. A copy is registered before an object's edges are
# followed, so shared targets and cycles keep their shape, and every copied
# Structure's parent is rewritten to the copy of its immediate structural parent, to an
# exact retained-profile parent's own address, or to zero.
#
# Atomicity is the arena's own act, exactly as it is for one Array: the
# operation takes `mark: lmx_arena_mark(dst_arena)` before it builds anything
# and reverts to it on any failure, so the whole destination joins dst_arena or
# none of it does, and the source graph is never written. There is no private
# block chain: storage a constructor allocated is already the arena's, and
# reverting retires its index entries together with it.
#
# No owner search, TLS, global registry or name table is involved.
define: LMX_GRAPH_COPY_OK 0
define: LMX_GRAPH_COPY_INVALID 1
define: LMX_GRAPH_COPY_NOMEM 2
define: LMX_GRAPH_COPY_UNSUPPORTED 3

# Operation-local bookkeeping: open-addressing pointer map and a work list.
# Their buffers may move on growth; the addresses stored IN them never move.
# Open-addressing pointer map: two void* DynamicArrays (table size = capacity;
# occupancy tracked in n). Keys/vals always allocated to capacity slots.



struct: LmxCopyMap
    VoidDynamicArray: keys
    VoidDynamicArray: vals
    size_t: n
end: LmxCopyMap

struct: LmxCopyStack
    VoidDynamicArray: items
end: LmxCopyStack

prototype:
    # Several roots, one operation, one map. outs[i] receives the copy of
    # sources[i]; on failure every outs[i] stays null and dst_arena is left as
    # it was at the mark.
    fn: lmx_graph_copy_many_owned (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx outs) int
    fn: lmx_graph_copy_many_profiles_owned (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @@: Lmx outs) int
    # One root: the same operation with count 1.
    fn: lmx_graph_copy_owned (@: Lmx source; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx out) int
    fn: lmx_graph_copy_profiles_owned (@: Lmx source; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @@: Lmx out) int
    fn: lmx_graph_copy_profiled_owned (@: Lmx source; @: LmxArena src_arena; @: LmxArena dst_arena; @: Lmx retain_profile; @@: Lmx out) int
end: prototype
