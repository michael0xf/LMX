# CODEX-AUTHOR-OS-COMMON-PIPELINE-20261023T013324Z: the root checks the selected os branch's os_mix(3) return value (reading its published field is reverted);
# os_mix(3) returns last = 6 (win) or 7 (default).
# Entry r + 1: 7 for win, 8 for default.
os:
    win:
        fn: os_mix (int: a) int
            int: last 0
            last := a * 2
            return: last
        end: os_mix
    default:
        fn: os_mix (int: a) int
            int: last 0
            last := a * 2 + 1
            return: last
        end: os_mix
end: os
int: r os_mix(3)
send: exit(exit_code: r + 1; stdout: ""; stderr: "")
return
