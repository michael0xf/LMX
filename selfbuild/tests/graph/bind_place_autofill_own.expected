---
    Observed:
        int: seen 559
    end: Observed
---
@: shared (data [] 0)
fn: callee (int: x) int
    int: before x
    :=: x 9
    return: ((before * 10) + x)
end: callee
fn: caller () int
    int: x 5
    int: r (callee)
    return: ((x * 100) + r)
end: caller
sub: main ()
    :=: ((shared \ Observed) \ seen) (caller)
end: main
main:
