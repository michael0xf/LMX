TicketCode:
    char[]: candidate
    return: int
    accepts:
        throws:
            PatternArgument
            PatternEncoding
            PatternPosition
            SequenceSize
            ReceiverIndex
            FxKernelFailure
            FxTypeToken
        return: matches(byteText(source := candidate); (then (charRange("A"; "Z") times 2) "-" (asciiDigit times 2)))
