# A declaration reached in code with no value makes an own place filled by autofill (TZ 2026-11-19 R03, §6.1
# item 3, §7.4; Р114): x of work takes the caller's 5.
(
    Observed:
        int: seen 0
)
@: shared data[0]
fn: work () int
    int: x
    return: x
fn: caller () int
    int: x 5
    return: work()
sub: main ()
    shared\Observed\seen := caller()
main()
