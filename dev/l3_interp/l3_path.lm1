predef: "l3_path.h.lm1"
predef: "../l2src_sandbox/lmx_arena_refs.h.lm1"
predef: "../l2src_sandbox/lmx_value_owned.h.lm1"
predef: "../l2src_sandbox/lmx_implements.h.lm1"

fn: l3_follow_path (@: LmxArena arena; @: Lmx start; @: Lmx path) int
    @: void leaf 0
return: l3_path_leaf(arena, start, path, @ leaf)

fn: l3_path_leaf (@: LmxArena arena; @: Lmx start; @: Lmx path; @: void out) int
    @: Lmx cur
    @: void step
    @: void next
    size_t: i
    int: idx
    if: out = 0 || arena = 0 || start = 0 || path = 0
        return: c.L3_INVALID
    if: lmx_domain_kind(arena, (cast: (@: void) path)) != c.LMX_KIND_STRUCT
        return: c.L3_UNSUPPORTED
    cur: start
    next: (cast: (@: void) start)
    i: 0U
    while: i < (cast: (size_t) path\len)
        step: lmx_arena_ref_value(path, i)
        if: step = 0
            return: c.L3_ABSENT
        if: lmx_domain_kind(arena, step) != c.LMX_KIND_PRIMITIVE
            return: c.L3_UNSUPPORTED
        if: lmx_domain_type(arena, step) != c.LMX_TYPE_INT
            return: c.L3_UNSUPPORTED
        idx: lmx_int_value_known(step)
        if: idx < 0
            return: c.L3_ABSENT
        if: lmx_domain_kind(arena, (cast: (@: void) cur)) != c.LMX_KIND_STRUCT
            return: c.L3_ABSENT
        if: idx >= cur\len
            return: c.L3_ABSENT
        next: lmx_arena_ref_value(cur, (cast: (size_t) idx))
        if: next = 0
            return: c.L3_ABSENT
        if: lmx_domain_kind(arena, next) = c.LMX_KIND_STRUCT
            cur: (cast: (@: Lmx) next)
        ---
        if: lmx_domain_kind(arena, next) != c.LMX_KIND_STRUCT
            if: i + 1U < (cast: (size_t) path\len)
                return: c.L3_ABSENT
            ---
        ---
        i: i + 1U
    ---
    \out: next
return: c.L3_OK
