+# Unknown is cached as a completed source query. Only its existing owner
+# keeps mutable readiness;borrowed formal-order spans share that owner.
+# No raw field fallback is available after a held grammar/semantic miss.
+fn: l2_reference_source_value (@: L2ValueSpan value; int: mi; @: L2ReferenceSource out) int
+    @: L2ValueSource source 0
+    @: L2Path selected 0
+    @: L2ApplicationSite application 0
+    int: signature -1
+    int: held -1
+    int: bound 0
+    int: status
+    if: out = 0
