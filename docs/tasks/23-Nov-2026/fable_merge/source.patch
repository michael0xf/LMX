+{
+  "gate": "AR01",
+  "bridge": "FxKernel.acceptsRequirement(candidate; requirement; consumer=0) -> int",
+  "edition": "2026-11-23",
+  "status": "NOT_RUN; kernel provider implementation and integration verification are required",
