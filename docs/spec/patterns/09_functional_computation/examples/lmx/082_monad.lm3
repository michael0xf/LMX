Example:
    int: x
    return: @
    half:
        throws: FxRecordArity
        if: x % 2 = 0
            return: some(value := (x / 2 record))
        return: none()
    run:
        throws:
            FxIndex
            FxArity
            FxRecordArity
            FxTypeToken
            FxKernelFailure
            FxCallFailure
        return: bind(bind(some(value := (x record)); half); half)
