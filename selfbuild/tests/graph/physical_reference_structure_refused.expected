Observed:
    int: before 1
    int: after 0
    int: touches 1
    int: p_checked 1
end: Observed
fn: touch () int
    :=: (Observed \ touches) ((Observed \ touches) + 1)
    return: 0
end: touch
A:
    int: v 7
end: A
