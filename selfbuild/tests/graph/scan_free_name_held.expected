---
    Observed:
        int: r 10010
    end: Observed
---
int: x 99
sub: poke ()
    :=: (node \ x) 99
end: poke
fn: probe () int
    int: first x
    poke:
    int: second x
    return: ((first * 1000) + second)
end: probe
int: r (probe)
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ r) r
end: main
main:
