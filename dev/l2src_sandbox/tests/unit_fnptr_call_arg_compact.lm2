predef: "l2src/tests/fnptr_local_forms.h.lm1"

# BATCHC-76: nested arg-position ty40 call, compact
fn: wrap (@: void p) @: void
    return: p
end: wrap

fn: probe (const: @(L2TestAllocVTable av); size_t: n) @: void
    L2TestAllocFn: f av\alloc
    if: f = 0
        return: 0
    return: wrap(f(n))
end: probe

fn: main () int
    return: 0
end: main