# Select the indexed head once before an actual rebinds that source place.
int: head_reads 0
int: effects 0
@: Holder (
    fn: first (int: value) int
        return: 100 + value
    fn: second (int: value) int
        return: 200 + value
)
call(Holder)
@: Slots (@: selected Holder\first)
call(Slots)
fn: choose () int
    node\head_reads := node\head_reads + 1
    return: 0
fn: change () int
    node\Slots\selected := Holder\second
    node\effects := node\effects + 1
    return: 7
int: first Slots[choose()](change())
int: second Slots[0](3)
int: head_count data\head_reads
int: effect_count data\effects
