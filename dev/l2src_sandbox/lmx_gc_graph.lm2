# Physical graph mark/sweep shared by the Thread collector and graph clients.
# Array and ordinary Structure use one Lmx-header traversal. Thread/mail roots
# are selected by lmx_gc.lm1; they do not change this traversal's representation.
#
# A machine module (L2 section 20): each function has a direct C-compatible entry, and the kernel's code calls it with
# its explicit arguments. It declares its functions itself; the prototypes the kernel calls (lmx_gc_mark_value,
# lmx_gc_cells, lmx_gc_mark_pool, lmx_gc_sweep) are in lmx_gc.h.lm1 with the collector's answers, and lmx_gc_note is
# also read by the Thread collector (lmx_gc.lm1), which predefs this module. The records it reads (LmxArena, LmxPool,
# LmxChunk, Lmx, VoidArray, LmxWalkValue, LmxImplEntry, LmxArenaBlock and its disposer's type, which the block list's
# header declares and this module reads directly) are in the kernel's headers; the arena's acts
# (lmx_range_pool, lmx_range_cell_chunk, lmx_arena_drop, lmx_arena_impl_prune), the pools' (lmx_pool_is_sealed,
# lmx_pool_chunk_head, lmx_chunk_data, lmx_chunk_cells), the values' (lmx_charptr_value_known), the source names'
# (lmx_source_names_mark) and the C library's are the kernel's C functions, called through the C door.
predef: "l2src/lmx_gc.h.lm1"
predef: "l2src/lmx_arena_blocks.h.lm1"
predef: "l2src/lmx_value_owned.h.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_source_names.h.lm1"
predef: "l2src/lmx_implements.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdlib.h>"

# The worse of two statuses: a pass reports the first thing that went wrong, not the last.
fn: lmx_gc_note (int: a; int: b) int
    if: a != c.LMX_GC_OK
        return: a
    return: b
end: lmx_gc_note

# Is this chunk a bag of VALUES rather than of references?  Scalar primitive domains
# are; pointer domains are read through their physical pool contract below.
fn: lmx_gc_scalar (@: pool c.LmxPool) int
    if: pool = 0
        return: 0
    if: pool\kind != c.LMX_KIND_PRIMITIVE
        return: 0
    if: pool\type = c.LMX_TYPE_CHAR || pool\type = c.LMX_TYPE_UNSIGNED_CHAR
        return: 1
    if: pool\type = c.LMX_TYPE_INT || pool\type = c.LMX_TYPE_UNSIGNED
        return: 1
    if: pool\type = c.LMX_TYPE_SIZE_T || pool\type = c.LMX_TYPE_ULONG
        return: 1
    return: 0
end: lmx_gc_scalar

# One word of a cell, followed as a candidate address.  A word that resolves in this arena is
# followed; anything else is a terminal.
fn: lmx_gc_word (@: arena c.LmxArena; @@: slot void; unsigned: gen; int: depth) int
    if: slot = 0
        return: c.LMX_GC_OK
    if: slot[0] = 0
        return: c.LMX_GC_OK
    return: lmx_gc_mark_value(arena, slot[0], gen, depth + 1)
end: lmx_gc_word

# Every cell of one chunk, walked by what the chunk IS (the array's kind and type).
fn: lmx_gc_cells (@: arena c.LmxArena; @: pool c.LmxPool; @: chunk c.LmxChunk; unsigned: gen; int: depth) int
    size_t: index 0U
    size_t: cells 0U
    size_t: stride 0U
    size_t: words 0U
    size_t: word 0U
    @: cell char 0
    @: header c.Lmx 0
    @: backing c.VoidArray 0
    @: contexts c.LmxWalkValue 0
    @: context c.LmxWalkValue 0
    @: held void 0
    int: status 0
    status: c.LMX_GC_OK
    if: pool = 0 || chunk = 0 || lmx_gc_scalar(pool) != 0
        return: c.LMX_GC_OK
    if: (pool\kind = c.LMX_KIND_STRUCT || pool\kind = c.LMX_KIND_ARRAY) && pool\stride != c.sizeof(c.Lmx)
        return: c.LMX_GC_INVALID
    # The external spelling table has weak keys. Neither its key nor its
    # text descriptor is an ordinary graph edge; handle it after graph mark.
    if: pool\kind = c.LMX_KIND_SOURCE_NAME
        return: c.LMX_GC_OK
    stride: (cast: (size_t) pool\stride)
    # Marking allocates nothing, so the chunk's count of cells does not change during the walk.
    cells: (cast: (size_t) c.lmx_chunk_cells(chunk, stride))
    index: 0U
    while: index < cells
        cell: (cast: (@: char) c.lmx_chunk_data(chunk)) + (index * stride)
        if: pool\kind = c.LMX_KIND_STRUCT || pool\kind = c.LMX_KIND_ARRAY
            # Structure and Array have the same graph header. Follow their
            # parent and physical backing; neither size nor native is an edge.
            header: (cast: (@: Lmx) cell)
            status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) header\parent), gen, depth + 1))
            # The header's by-value VoidArray is read through its address.
            backing: @ header\array
            status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) backing\data), gen, depth + 1))
        else:
            if: pool\kind = c.LMX_DOMAIN_KIND_POST
                # Post.nodes.next is the arena inventory, not a graph edge.
                # Its live nodes and inbox are explicit roots in lmx_gc_mark.
                status: status
            else:
                if: pool\kind = c.LMX_KIND_PRIMITIVE && pool\pointer_read != 0
                    # A machine T * cell is not a void * object. The pool's
                    # exact C99 read supplies its one held address.
                    held: (cast: (@: void) pool\pointer_read((cast: (@: void) cell)))
                    status: lmx_gc_note(status, lmx_gc_mark_value(arena, held, gen, depth + 1))
                    # Current stored-value dependencies belong to this live
                    # typed cell,not to an admission-history registry. Their
                    # storage is part of the same chunk record allocation.
                    if: chunk\value_contexts != 0
                        contexts: (cast: (@: LmxWalkValue) chunk\value_contexts)
                        context: contexts + index
                        status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) context\model), gen, depth + 1))
                        status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) context\references), gen, depth + 1))
                        status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) context\referent), gen, depth + 1))
                    ---
                else:
                    if: pool\kind = c.LMX_KIND_PRIMITIVE && pool\type = c.LMX_TYPE_CHAR_PTR
                        held: (cast: (@: void) c.lmx_charptr_value_known((cast: (@: void) cell)))
                        status: lmx_gc_note(status, lmx_gc_mark_value(arena, held, gen, depth + 1))
                    else:
                        # CHILDREN/REF slots are physically void * objects.
                        # Legacy kernel records still use word scanning here.
                        words: stride / sizeof(@: void)
                        word: 0U
                        while: word < words
                            status: lmx_gc_note(status, lmx_gc_word(arena, (cast: (@@: void) (cell + (word * sizeof(@: void)))), gen, depth))
                            word: word + 1U
                        ---
                    ---
                ---
            ---
        ---
        index: index + 1U
    ---
    return: status
end: lmx_gc_cells

# The value at one address: mark its chunk (once per pass) and walk what the chunk holds.
fn: lmx_gc_mark_value (@: arena c.LmxArena; @: p void; unsigned: gen; int: depth) int
    @: pool c.LmxPool 0
    @: chunk c.LmxChunk 0
    if: p = 0
        return: c.LMX_GC_OK
    if: depth > c.LMX_GC_DEPTH
        return: c.LMX_GC_PARTIAL
    pool: (cast: (@: LmxPool) c.lmx_range_pool(arena, p))
    if: pool = 0
        # An address this arena never handed out: not this arena's to keep or to free.
        return: c.LMX_GC_OK
    # A sealed typed range is immutable and GC-exempt in its ordinary owner arena. Imported
    # ranges are non-owning views and lmx_range_pool deliberately does not return them here.
    if: c.lmx_pool_is_sealed(pool) != 0
        return: c.LMX_GC_OK
    # p is a live cell of pool here, so the chunk that holds it is the index's (no walk of the chain).
    chunk: (cast: (@: LmxChunk) c.lmx_range_cell_chunk(arena, p))
    if: chunk = 0
        return: c.LMX_GC_OK
    if: chunk\mark = gen
        # Already reached by this pass: its cells are being walked, or have been.
        return: c.LMX_GC_OK
    chunk\mark: gen
    return: lmx_gc_cells(arena, pool, chunk, gen, depth)
end: lmx_gc_mark_value

# Every chunk of one array: the mailbox's own node pool is storage of THIS arena, so a
# collection that ignored it would free the nodes of a live mailbox.
fn: lmx_gc_mark_pool (@: arena c.LmxArena; @: pool c.LmxPool; unsigned: gen) int
    @: chunk c.LmxChunk 0
    int: status 0
    status: c.LMX_GC_OK
    if: c.lmx_pool_is_sealed(pool) != 0
        return: c.LMX_GC_OK
    chunk: (cast: (@: LmxChunk) c.lmx_pool_chunk_head(pool))
    while: chunk != 0
        if: chunk\mark != gen
            chunk\mark: gen
            status: lmx_gc_note(status, lmx_gc_cells(arena, pool, chunk, gen, 0))
        ---
        chunk: (cast: (@: LmxChunk) chunk\next)
    ---
    return: status
end: lmx_gc_mark_pool

# Is this block one the pass reached?  Three ways to be live: the array's own descriptor block
# (the arena's inventory -- an array lives as long as the arena), the STORAGE of a chunk the
# pass stamped, or the RECORD of such a chunk.
fn: lmx_gc_block_live (@: arena c.LmxArena; @: block c.LmxArenaBlock; unsigned: gen) int
    @: pool c.LmxPool 0
    @: chunk c.LmxChunk 0
    if: block = 0
        return: 0
    if: block\base = 0
        # A block that owns nothing has nothing to free.
        return: 1
    pool: (cast: (@: LmxPool) arena\arrays)
    while: pool != 0
        if: (cast: (@: void) pool) = block\base
            return: 1
        chunk: (cast: (@: LmxChunk) pool\head)
        while: chunk != 0
            if: (cast: (@: void) c.lmx_chunk_data(chunk)) = block\base || (cast: (@: void) chunk) = block\base
                if: c.lmx_pool_is_sealed(pool) != 0 || chunk\mark = gen
                    return: 1
                ---
            ---
            chunk: (cast: (@: LmxChunk) chunk\next)
        ---
        pool: (cast: (@: LmxPool) pool\next)
    ---
    return: 0
end: lmx_gc_block_live

sub: lmx_gc_block_dispose (@: block c.LmxArenaBlock)
    if: block != 0
        # A function-pointer local takes its value where it is declared: a later `disposer: v` would call it.
        c.LmxArenaBlockDisposer: disposer block\dispose
        if: disposer != 0
            disposer(block\base, block\n)
        else:
            c.free(block\base)
        ---
        c.free(block)
    ---
end: lmx_gc_block_dispose

# A recorded admission is an address relation: while its value is live, the
# required Structure is a live dependency of that value. It is not an extra
# graph child, but sweeping it would erase the declared receiving model after
# a field is replaced. An admitting frame is different: its departure retires
# the frame-backed record. Mark to a fixed point because marking one model can
# make another recorded value reachable through its ordinary graph edges.
fn: lmx_gc_impl_live (@: arena c.LmxArena; @: value c.Lmx; unsigned: gen) int
    @: pool c.LmxPool 0
    @: chunk c.LmxChunk 0
    if: arena = 0 || value = 0
        return: 0
    pool: (cast: (@: LmxPool) c.lmx_range_pool(arena, (cast: (@: void) value)))
    if: pool = 0
        return: 0
    if: c.lmx_pool_is_sealed(pool) != 0
        return: 1
    chunk: (cast: (@: LmxChunk) c.lmx_range_cell_chunk(arena, (cast: (@: void) value)))
    return: (cast: (int) (chunk != 0 && chunk\mark = gen))
end: lmx_gc_impl_live

fn: lmx_gc_mark_impl (@: arena c.LmxArena; unsigned: gen) int
    size_t: i 0U
    int: changed 1
    @: entries c.LmxImplEntry 0
    @: entry c.LmxImplEntry 0
    while: changed != 0
        changed: 0
        i: 0U
        while: i < (cast: (size_t) arena\impl_len)
            entries: (cast: (@: LmxImplEntry) arena\impl)
            entry: entries + i
            if: lmx_gc_impl_live(arena, (cast: (@: Lmx) entry\value), gen) != 0 && ((cast: (@: Lmx) entry\frame) = 0 || lmx_gc_impl_live(arena, (cast: (@: Lmx) entry\frame), gen) != 0)
                if: (cast: (@: Lmx) entry\req) != 0 && lmx_gc_impl_live(arena, (cast: (@: Lmx) entry\req), gen) = 0
                    if: lmx_gc_mark_value(arena, (cast: (@: void) entry\req), gen, 0) != c.LMX_GC_OK
                        return: c.LMX_GC_PARTIAL
                    if: lmx_gc_impl_live(arena, (cast: (@: Lmx) entry\req), gen) != 0
                        changed: 1
                    ---
                ---
            ---
            i: i + 1U
        ---
    ---
    return: c.LMX_GC_OK
end: lmx_gc_mark_impl

fn: lmx_gc_sweep (@: arena c.LmxArena; unsigned: gen) int
    @: block c.LmxArenaBlock 0
    @: next c.LmxArenaBlock 0
    if: arena = 0 || gen = 0U
        return: c.LMX_GC_INVALID
    if: lmx_gc_mark_impl(arena, gen) != c.LMX_GC_OK
        return: c.LMX_GC_PARTIAL
    if: c.lmx_source_names_mark(arena, gen) != c.LMX_GC_OK
        return: c.LMX_GC_INVALID
    block: (cast: (@: LmxArenaBlock) arena\blocks)
    while: block != 0
        next: (cast: (@: LmxArenaBlock) block\next)
        if: lmx_gc_block_live(arena, block, gen) = 0
            # The same arena detach used by rollback unlinks chunks and
            # embedded pools (including Post.nodes) before storage leaves.
            # The interval leaves the index, the block leaves the list -- and then its storage
            # goes: lmx_arena_drop detaches, it does not free.
            c.lmx_arena_drop(arena, block)
            lmx_gc_block_dispose(block)
        ---
        block: next
    ---
    # D-105: a correspondence of the `implements` table never outlives its value by one pass --
    # dropped here, after the storage and before anything can be handed out at its address.
    c.lmx_arena_impl_prune(arena)
    return: c.LMX_GC_OK
end: lmx_gc_sweep
