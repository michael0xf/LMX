# Deterministic, offline build view of the pinned original header/tests.
# Only the build directory is written; original upstream files are immutable.
function(lmx_utensil_view source destination)
    file(SHA256 "${source}/utensil.h" _header_hash)
    if(NOT _header_hash STREQUAL "d0bdb947da401033d0861839332c22831ffab142cc5ab5caf0e887b8af9ea742")
        message(FATAL_ERROR "Utensil header differs from the reviewed upstream snapshot")
    endif()
    if(BUILD_TESTING)
    file(SHA256 "${source}/test.c" _test_hash)
    if(NOT _test_hash STREQUAL "184a112286c2948f28bd5ce8403dc0cef4f9a38b65fdf054aa69b85096691905")
        message(FATAL_ERROR "Utensil upstream test differs from the reviewed snapshot")
    endif()
    file(READ "${source}/test.c" _test)
    endif()
    file(READ "${source}/utensil.h" _header)
    string(REGEX MATCHALL "#ifdef __APPLE__" _header_guards "${_header}")
    list(LENGTH _header_guards _header_count)
    if(NOT _header_count EQUAL 5)
        message(FATAL_ERROR "Unexpected Utensil Apple guard count")
    endif()
    string(REPLACE "#include <float.h>" "#include <assert.h>\n#include <float.h>" _header "${_header}")
    string(REPLACE "#ifdef __APPLE__"
        "#if defined(__APPLE__) && !defined(LMX_UTENSIL_CPU_ONLY)" _header "${_header}")
    file(MAKE_DIRECTORY "${destination}")
    file(WRITE "${destination}/utensil.h" "${_header}")
    if(BUILD_TESTING)
    string(REGEX MATCHALL "#ifdef __APPLE__" _test_guards "${_test}")
    list(LENGTH _test_guards _test_count)
    if(NOT _test_count EQUAL 24)
        message(FATAL_ERROR "Unexpected Utensil Apple test guard count")
    endif()
    string(REPLACE "#ifdef __APPLE__"
        "#if defined(__APPLE__) && !defined(LMX_UTENSIL_CPU_ONLY)" _test "${_test}")
    # Tests must retain assertions even under Release -DNDEBUG. Copying the
    # source here also makes its quoted include resolve to the reviewed view.
    set(_test "/* LMX: preserve upstream assertions in Release; CPU profile only. */\n#ifdef NDEBUG\n#undef NDEBUG\n#endif\n${_test}")
    file(WRITE "${destination}/test.c" "${_test}")
    endif()
endfunction()
