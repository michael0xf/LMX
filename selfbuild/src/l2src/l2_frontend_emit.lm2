        # The implicit AT root (the data) only for an occurrence that is its own data (l2_m_code_rooted = 0, as the
        # chain root of l2_rw_graph_path): a code-rooted method's field hangs from its code occurrence, reached below
        # through l2_rw_path_value level 0 (NODE(0), l2_rw_path_code_root) -- V1b, U7 D4.
        if: level = 1 && c.lm_compiler_rw_path_current(path) != 0 && field\holder = stop && c.lm_compiler_m_code_rooted(rw_mi_cell[0]) = 0
            # the body's layout is the data's own: the step's child is a source-code edge of it, projected through the data's
            # execution map (a merge result executing the selected body) -- OF_EDGE over SELF, as native self + lmx_implements_code_index
            place_width: 3 + store + 2 * (cast: (int) (cell_ft >= 0))
            witness_slot: 4 + store
            if: c.lm_compiler_rw_frame(parent, "LMX_WALK_OP_OF_EDGE", place_width, @ raw) != 0 || c.lm_compiler_rw_frame(raw, "LMX_WALK_OP_SELF", 1, @ base) != 0 || c.lm_compiler_rw_put(raw, 1, base) != 0
                return: (cast: (int) (1))
            ---
        else:
            place_width: 3 + store + 2 * (cast: (int) (cell_ft >= 0))
            witness_slot: 4 + store
            # the field hangs from the root itself (no place between) and the root is the running code occurrence: its child is a
            # source-code edge, projected (OF_EDGE); a field inside a place is reached through the chain, whose bottom frame decides
            if: field\holder = stop && c.lm_compiler_rw_path_code_root(path, level - 1) != 0
                if: c.lm_compiler_rw_frame(parent, "LMX_WALK_OP_OF_EDGE", place_width, @ raw) != 0
                    return: (cast: (int) (1))
