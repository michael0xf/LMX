int: before 1
int: calls 1
int: after 2
fn: bump () int
    :=: (node \ calls) ((node \ calls) + 1)
    return: 7
end: bump
Box:
    int: q 5
end: Box
Add:
    int: data 0
    int: other 5
    add: (:= (Box \ q) other)
end: Add
Main: (:= (node \ before) 1) Add\add((:= data (bump))) (:= (node \ after) 2)
