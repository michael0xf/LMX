---
    Observed:
        int: seen 1
        int: r 4
    end: Observed
---
fn: tick () int
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) (((shared \ Observed) \ seen) + 1)
    return: 3
end: tick
fn: f (int: a) int
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ r) a
    return: a
end: f
fn: f (u8: a) int
    return: 2
end: f
sub: main ()
    f: (1 + (tick))
end: main
main:
