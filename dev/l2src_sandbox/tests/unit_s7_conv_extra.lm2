# implements-port slice 11 (B2; REVIEW daee4f7, fable_pc's P40): unit_s7_prim_cross over its own convert.lm2
# with a seventh column of a name the conversion does not read (tests/unit_s7_conv_extra_table.lm2): its
# cells are kept in the rows and not read, so size_t -> int still finds lm_stg_convert_size_t_int: Entry 7.
fn: go () int
    int: a 1
    size_t: b 2U
    a: b
    return: a

int: k
k: go()
if: k = 2
    sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
return
