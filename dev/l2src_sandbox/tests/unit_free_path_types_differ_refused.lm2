# Two declarations that reach the free name give the field the method
# reads different types: Model has v an int, Wide has it a size_t. Neither
# is taken for the other's measure: the path is refused where it stands,
# and not one caller's call by the other's type.
Model:
    int: v 4
end: Model

Wide:
    size_t: v 4U
end: Wide

fn: r () int
    int: got box\v
    return: got + 1
end: r

fn: has () int
    box: merge Model
    box\v: 30
    return: r()
end: has

fn: wide () int
    box: merge Wide
    box\v: 40U
    return: r()
end: wide

int: a has()
int: b wide()
sendMessage: exit(exit_code: a + b; stdout: ""; stderr: "")
return
