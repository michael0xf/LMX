predef: "l2src/lmx_arena.h.lm1"

# Owned scalar Array record. This includes Array<@T>: its descriptor type is
# LMX_TYPE_ARRAY_OF_POINTER_BASE + type-id(T), while each backing pointer cell
# is classified by LMX_TYPE_POINTER_BASE + type-id(T). An empty Array is a real
# typed descriptor with size 0 and data 0; it is distinct from a null reference
# and has no backing interval. Descriptor and backing are TWO arrays of the arena,
# each with its own descriptor and its own entry in the index; the arena allocates
# both and owns both, and no owner-local range list exists. The backing has exactly
# `size` cells. Dynamic membership is an L1 list (KIND_LIST), not Array.
prototype:
    fn: lmx_array_new_owned (int: type; size_t: count; @: LmxArena arena) @: VoidArray
    fn: lmx_array_new_profiled (int: type; size_t: count; @: LmxArena arena; @: Lmx profile) @: VoidArray
    # Array<@T> uses the exact physical T * backing contract supplied by its
    # closed unit. The descriptor is still VoidArray {size,data}; the element
    # cells are selected by address and pool, not by per-cell metadata.
    fn: lmx_array_new_typed_profiled (int: type; size_t: count; @: LmxArena arena; @: Lmx profile; size_t: stride; LmxPointerCellRead: read; LmxPointerCellWrite: write) @: VoidArray
    # A backing element is addressed with its actual arena-pool stride.
    fn: lmx_array_cell_in (@: LmxArena arena; @: VoidArray array; size_t: index) @: void
end: prototype

# Compatibility boundary for callers that specifically require a positive
# count. Generic graph code uses lmx_array_new_owned.
prototype:
    fn: lmx_array_new_positive_owned (int: type; size_t: count; @: LmxArena arena) @: VoidArray
end: prototype
