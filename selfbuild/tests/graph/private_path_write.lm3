(
    # The field marker must survive the ordinary GraphTool image. Its value
    # remains readable lexically and explicitly; only dynamic selection skips it.
    Library:
        private: (int: x 10)
        fn: read () int
            return: x
    end: Library
    Observed:
        int: private_result 0
        int: public_result 0
        int: library_source 0
        int: header_result 0
)
@: shared data[0]
fn: CodePrivate () int
    private: (int: x 20)
    x := 21
    return: x * 100 + shared\Library\read()
fn: CodePublic () int
    int: x 20
    x := 21
    return: x * 100 + shared\Library\read()
fn: DataPrivate (private: (int: x 20)) int
    return: x * 100 + shared\Library\read()
sub: main ()
    shared\Library\x := 33
    shared\Observed\private_result := CodePrivate()
    shared\Observed\public_result := CodePublic()
    shared\Observed\library_source := shared\Library\x
    shared\Observed\header_result := DataPrivate()
main()
