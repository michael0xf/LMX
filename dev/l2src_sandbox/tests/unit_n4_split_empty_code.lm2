# N4 (LMX_semantics.ru.md #method-parts): an empty code requires no place, so any Structure is its data, untouched;
# the empty procedure of A runs over D through the contract of A. Entry 7.
A: ()
D:
    int: x 5
end: D
call: A D
int: r 81
if: D\x = 5
    r: 7
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
