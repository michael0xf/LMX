+            at := end - length(affix)
+        if: FxUnitRange\equal(at) != 0
+            if: suffix != 0
+                end -= length(affix)
+            else:
+                begin := length(affix)
+        ---
+        return: \FxSeqSlice\slice(text; begin; end)
+
