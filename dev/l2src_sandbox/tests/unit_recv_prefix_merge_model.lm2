test: root int
    # K03-UNIFIED-HEAD-S4: receiving-prefix witness for bare merge atom vs. explicit forms
    # Bare receiver atom `merge` with following Model operand is NOT an application.
    # This is distinct from explicit empty applications x: merge: Model or x: merge(Model).
    # The collector-reintroduction mutant must fail this to prove unified head resolution.

    Model: int
    Model: 42

    # Explicit empty application form (this works, merge: Model creates a copy)
    x: merge: Model

    # Explicit empty call form (this works, merge(Model) is the same application)
    y: merge(Model)

    # Both should copy Model and have the same value (42 + 42 = 84)
    return: x + y - 84
---
