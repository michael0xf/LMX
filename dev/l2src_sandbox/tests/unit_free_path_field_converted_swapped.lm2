# OPEN positive. The same program with the two declarations in the other
# order: the same results, 31 and 41.
Wide:
    size_t: v 4U
end: Wide

Model:
    int: v 4
end: Model

fn: r () int
    int: got box\v
    return: got + 1
end: r

fn: has () int
    box: merge Model
    box\v: 30
    return: r()
end: has

fn: wide () int
    box: merge Wide
    box\v: 40U
    return: r()
end: wide

int: a has()
int: b wide()
int: ok 7
if: a != 31
    ok: 81
if: b != 41
    ok: 82
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
