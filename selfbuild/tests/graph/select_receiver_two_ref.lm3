# An actual of unknown description (an application of a receiver) is possible at any formal, a reference formal
# too; its value is checked at its reception (fable 2026-11-21, R103 item 2): f(merge(A; B); 3) runs, seen 23.
(
    Observed:
        int: seen 0
)
@: shared data[0]
@: Model ()
fn: f (@: s Model; int: n) int
    return: length(s) * 10 + n
sub: main () (
    A(int: a 1)
    B(int: b 2)
)
    shared\Observed\seen := f(merge(A; B); 3)
main()
