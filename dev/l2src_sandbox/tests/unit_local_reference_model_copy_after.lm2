fn: read () int
    Outer:
        int: pad 17
        Inner:
            int: x 11
        end: Inner
        @: Inner ref Inner
    end: Outer
    Outer
    before: merge: Outer
    # Copying at a merge is full (the author, 2026-10-10): the pointer cell is copied
    # with its pointee, so the copy's ref names the copy's own Inner, not the source's.
    if: before\ref != before\Inner || before\ref = Outer\Inner || before\ref\x != 11
        return: 81
    before\Inner\x: 23
    if: before\ref\x != 23 || Outer\Inner\x != 11
        return: 81
    before
    if: before\ref != before\Inner || before\ref\x != 23
        return: 81
    second: merge: before
    if: second\ref != second\Inner || second\ref = before\Inner || second\ref\x != 23
        return: 81
    second\Inner\x: 31
    if: second\ref\x != 31 || before\Inner\x != 23
        return: 81
    second
    if: second\ref != second\Inner || @second\ref\x != @second\Inner\x || second\ref\x != 31
        return: 81
    before
    if: before\ref != before\Inner || before\ref\x != 23 || Outer\ref\x != 11
        return: 81
    if: second\pad != 17 || before\pad != 17 || Outer\pad != 17
        return: 81
    return: second\ref\x
end: read
int: ok 7
if: read() != 31
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
