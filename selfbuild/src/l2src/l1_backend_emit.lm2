                        if: c.l1_is_infix_atom((cast: (const: @: c.LmP0Text) (source_node\as\atom))) = 0 && c.l1_is_unary_prefix_atom((cast: (const: @: c.LmP0Text) (source_node\as\atom))) = 0 && c.l1_is_incdec_atom((cast: (const: @: c.LmP0Text) (source_node\as\atom))) = 0 && c.l1_text_eq((cast: (const: @: c.LmP0Text) (source_node\as\atom)), "\\") = 0 && c.l1_text_eq((cast: (const: @: c.LmP0Text) (source_node\as\atom)), "[") = 0 && c.l1_text_eq((cast: (const: @: c.LmP0Text) (source_node\as\atom)), "]") = 0
                            skip_space: 1
