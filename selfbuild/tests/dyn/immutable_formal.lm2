# An immutable value received by a formal of the ordinary type of its model (the book, #qualification): passing and returning it keeps its identity, the qualifier predicts no writes,
# and reading is no use of the qualifier.  The sign of the physical type is not a difference of the field's type at the admission.  A reached write is refused where it is reached:
# not here, the row has no way to say so (receipt in the slice's record).  The codes name the checks.
Holder:
    int: y 3
    Inner:
        int: z 4
    end: Inner
end: Holder
fn: read (@: h Holder) int
    return: h\y
end: read
fn: read_nested (@: h Holder) int
    return: h\Inner\z
end: read_nested
fn: keep (@: h Holder) @: Holder
    return: h
end: keep
fn: m () int
    b: immutable: merge(Holder)
    if: read(b) != 3
        return: 81
    if: read_nested(b) != 4
        return: 82
    @: again Holder keep(b)
    if: again != b
        return: 83
    if: again\y != 3 || again\Inner\z != 4
        return: 84
    return: 7
end: m
send: exit(exit_code: m(); stdout: ""; stderr: "")
return
