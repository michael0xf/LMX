# Ordinary L2 bodies for the two libc stream accessors.
# The L3 ABI writer keeps declarations bodyless; this unit is compiled once.
include: "<stdio.h>"

fn: l1_stdout () @: c.FILE
    return: (cast: (@: c.FILE) c.stdout)
end: l1_stdout

fn: l1_stderr () @: c.FILE
    return: (cast: (@: c.FILE) c.stderr)
end: l1_stderr
