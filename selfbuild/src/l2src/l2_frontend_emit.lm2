        if: span\count = 1 && where\kind = c.LM_P0_NODE_ATOM && where\as != 0 && c.lm_compiler_rw_prec((cast: (const: @: c.LmP0Text) (where\as\atom))) != 0
            return: (cast: (int) (0))
