# Prepare the own reference before attempting the failing launch. A missing
# data selector is read at the reached reference-head, after p has been checked;
# a bare missing input would instead fail entry binding before data runs.
sub: main () (
    Model:
        int: v 1
    @: p Model
    Attempt:
        p(data := data\other)
)
    return:
main()
int: prepared_p main\data\p\v
call(main\data; main\data\Attempt)
int: after main\data\Model\v
