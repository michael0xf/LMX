# DRAFT: bounded byte views, scanning, integer/UTF-8/legacy codecs.
# All ranges are half-open. ASCII-folding is explicit, never locale-dependent.
# charSigned is supplied by the admitted C ABI (CHAR_MIN<0); raw bytes remain
# 0..255. The historical utf16 flag means 0,hi,lo escaped UTF-16 units.
MapTextAbi:
    []char: encoding "UTF-8"
    int: charSigned 1

MapBytesView:
    @: units
    int: begin 0
    int: count -1
    int: utf16 0
    required: units
    return: @
    view:
        throws: copy(MapThrows)
        if: count < 0
            count := length(units) - begin
        if: begin < 0 || count < 0 || begin > length(units) || count > length(units) - begin || (utf16 != 0 && utf16 != 1)
            throw: MapFailure("byte view range")
        int: i begin
        while: i < begin + count
            int: value \units[i]
            if: value < 0 || value > 255
                throw: MapFailure("unsigned byte required")
            i += 1
        @: result (copy(MapBytesModel))
        result\units := units
        result\begin := begin
        result\count := count
        result\utf16 := utf16
        return: result

MapBytesAllocate:
    int: count 0
