# Slice R6: an item of the merge result body that is not a typed field declaration -- a statement -- is not built yet
# and is refused where it stands, by name, not by a field-shape filter.
Model:
    size_t: x 1U
end: Model

R: merge: Model
    int: w 4
    w: 5
end: merge
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
