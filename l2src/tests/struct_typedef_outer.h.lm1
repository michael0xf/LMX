# Declares one handle itself and reaches the other through its own predef -- the way
# mixa_pump.h reaches MixaBackend and mixa_process_win32.h reaches MixaProcess.  It
# used to be mutual with struct_typedef_inner.h under include guards, which L1's
# predef refuses as a cycle; the direction is one way now.
predef: "l2src/tests/struct_typedef_inner.h.lm1"

type: L2TestOuter struct L2TestOuter
