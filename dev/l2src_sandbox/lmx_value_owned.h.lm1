predef: "l2src/lmx_arena.h.lm1"

# Fresh, unexposed entries in one exclusively held Message's storage. Each entry is a cell
# of one of the arena's arrays: the arena allocates it, owns it and classifies it, and
# there is no owner-local range list anywhere.
prototype:
    # A structural root Structure (parent = 0) in the STRUCT domain, array.size 0, no children.
    fn: lmx_node_new_owned (@: LmxArena arena) @: Lmx
    # Same representation in a distinct physical receiver-profile domain.
    fn: lmx_node_new_profiled (@: LmxArena arena; @: Lmx profile) @: Lmx
    fn: lmx_node_new_role_profiled (@: LmxArena arena; @: Lmx profile; unsigned: role) @: Lmx
    # A nested Structure initialized with immediate structural parent `parent`. Graph-copy
    # traversal may rewrite destination parent links. The caller opens its child array and
    # stores its address into the parent's slot; nothing here mutates parent.
    fn: lmx_struct_new_owned (@: Lmx parent; @: LmxArena arena) @: Lmx
    fn: lmx_struct_new_profiled (@: Lmx parent; @: LmxArena arena; @: Lmx profile) @: Lmx
    fn: lmx_struct_new_role_profiled (@: Lmx parent; @: LmxArena arena; @: Lmx profile; unsigned: role) @: Lmx
    # A variable place is an ordinary one-field Lmx of the SAME canonical
    # reference cell, not another value or a wrapper around a primitive.
    # Use an already-written place directly when one exists.
    fn: lmx_field_place_new (@: LmxArena arena; @: Lmx owner; size_t: field) @: Lmx
    fn: lmx_op_new_owned (@: LmxArena arena; int: code) @: LmxOp
    fn: lmx_op_new_profiled (@: LmxArena arena; int: code; @: Lmx profile) @: LmxOp
    fn: lmx_int_new_owned (@: LmxArena arena) @: void
    fn: lmx_int_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    fn: lmx_char_new_owned (@: LmxArena arena) @: void
    fn: lmx_char_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    fn: lmx_size_new_owned (@: LmxArena arena) @: void
    fn: lmx_size_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    fn: lmx_unsigned_new_owned (@: LmxArena arena) @: void
    fn: lmx_unsigned_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    fn: lmx_uchar_new_owned (@: LmxArena arena) @: void
    fn: lmx_uchar_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    fn: lmx_ulong_new_owned (@: LmxArena arena) @: void
    fn: lmx_ulong_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    # `@: ptr char "text"`: a cell in the char * domain whose value points directly
    # at a C string (SPEC 11.2.1). The string itself is not owned or copied here.
    fn: lmx_charptr_new_owned (@: LmxArena arena) @: void
    fn: lmx_charptr_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    fn: lmx_charptr_value_known (@: void cell) @: char
    fn: lmx_charptr_store_known (@: void cell; @: char value) int
    # One mutable pointer value. `type` must identify the exact source pointer
    # domain at or above LMX_TYPE_POINTER_BASE; the cell owns only the pointer
    # value, not an arbitrary foreign referent.
    fn: lmx_pointer_new_owned (int: type; @: LmxArena arena) @: void
    fn: lmx_pointer_new_profiled (int: type; @: LmxArena arena; @: Lmx profile) @: void
    # Exact C99 pointer-object storage. A generated machine pointer type gives
    # its stride and typed read/write operations once per physical arena pool.
    fn: lmx_pointer_new_typed_profiled (int: type; @: LmxArena arena; @: Lmx profile; size_t: stride; LmxPointerCellRead: read; LmxPointerCellWrite: write) @: void
    # Typed pool classification/read is declared with the arena's address
    # index, not with allocation. All consumers use that same operation.
    # One canonical graph-reference ABI, irrespective of the cell's owning pool/profile.
    fn: lmx_pointer_cell_canonical (@: LmxArena arena; @: void cell) int
    # The read of a pointer cell the construction promised at this slot, of storage type `type` (POINTER_BASE + the
    # closed type id, the pool's type): a slot holding no pointer cell of this arena is the invariant "a reference
    # slot holds no pointer cell", a pointer cell of another type "a reference slot holds a pointer cell of another
    # type" or "another ABI" (said, abort) -- never 0, which is a present cell of that type holding its valid nothing.  The one read
    # every native consumer of such a cell spells.
    fn: lmx_pointer_value_promised (@: LmxArena arena; @: void cell; int: type) @: void
    fn: lmx_pointer_store_in (@: LmxArena arena; @: void cell; @: void value) int
    fn: lmx_pointer_value_known (@: void cell) @: void
    fn: lmx_pointer_store_known (@: void cell; @: void value) int
    # Known accessors require a compiler-proven live cell of this exact type.
    # They guard null, not arbitrary untyped/raw addresses or owner membership.
    # Character read: null => -1; a live cell yields its C char value promoted to int.
    # Target char signedness is preserved; an intern-table byte index is a separate use.
    fn: lmx_char_value_known (@: void cell) int
    fn: lmx_char_store_known (@: void cell; int: value) int
    fn: lmx_int_value_known (@: void cell) int
    fn: lmx_int_store_known (@: void cell; int: value) int
    fn: lmx_size_value_known (@: void cell) size_t
    fn: lmx_size_store_known (@: void cell; size_t: value) int
    fn: lmx_unsigned_value_known (@: void cell) unsigned
    fn: lmx_unsigned_store_known (@: void cell; unsigned: value) int
    fn: lmx_uchar_value_known (@: void cell) unsigned
    fn: lmx_uchar_store_known (@: void cell; unsigned: value) int
    fn: lmx_ulong_value_known (@: void cell) ulong
    fn: lmx_ulong_store_known (@: void cell; ulong: value) int
end: prototype
