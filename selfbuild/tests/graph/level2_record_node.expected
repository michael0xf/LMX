---
    Observed:
        int: hits 6
        int: r 6
    end: Observed
---
int: hits 6
fn: f () int
    L2: (:= (node \ hits) 6)
    return: (node \ hits)
end: f
int: r (f)
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ hits) (node \ hits)
    :=: ((shared \ Observed) \ r) r
end: main
main:
