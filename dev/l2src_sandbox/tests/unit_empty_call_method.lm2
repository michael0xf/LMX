# The first f() declares an empty Structure. Later f() and f: () assign new
# empty Structures after admission. Bare f reads and discards the value;
# only call: f explicitly executes its empty body. Entry 7.
fn: m () int
    int: r 7
    f()
    f()
    f: ()
    f
    call: f
    return: r
end: m
int: r 0
r: m()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
