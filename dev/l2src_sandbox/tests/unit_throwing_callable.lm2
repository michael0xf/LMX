P:
    size_t: p 3U
end: P

A:
    fn: M
    size_t: tag 1U
end: A

fn: M () int
    size_t: hits
    Q: merge: P
        size_t: extra 4U
    end: merge
    hits: hits + 1U
    return: hits
end: M
size_t: a1
size_t: r1
size_t: a2
R: merge: A
# Q22 = II: A: fn: M is a shared occurrence; hits accumulate across A and R.
a1: A\M()
r1: R\M()
a2: A\M()
if: a1 != 1U
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
if: r1 != 2U
    sendMessage: exit(exit_code: 82; stdout: ""; stderr: "")
    return
if: a2 != 3U
    sendMessage: exit(exit_code: 83; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
