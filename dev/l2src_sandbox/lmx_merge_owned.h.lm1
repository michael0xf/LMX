predef: "l2src/lmx.h.lm1"
include: "<stddef.h>" "<limits.h>"
predef: "l2src/lmx_arena.h.lm1"
predef: "lmx_graph_copy_owned.h.lm1"

# Runtime merge over the accepted used-graph copier (SPEC 2.3/21, user
# decisions 2026-09-12). Merge takes live operand Structures left to right and
# an optional body Structure whose fields follow the operand children, and
# produces a THIRD INDEPENDENT Structure. The operands are never written: two
# structures in, three out.
#
# The result's direct slots are, in order, the copies of each operand's direct
# children, operand by operand and child by child, then the body's fields. The
# operand ROOTS are not visible result slots; only their children are. This is
# what makes the result one flat tree rather than a container of containers,
# and it is why a method that came in by copying is invoked through the result.
#
# ONE lmx_graph_copy_many_owned operation, hence one operation-local map, spans
# every ordinary operand root and the body root together. An object reachable
# from two operands is therefore copied ONCE and both references point at that
# one copy; cross-operand aliases and cycles keep their shape; every copied
# Structure's parent is rewritten to the copy of its structural parent or to zero.
# METHOD descriptors stay terminals, shared by address, and every operand is an
# ordinary Structure: which value is a METHOD is answered by src_arena's table
# (LMX_KIND_METHOD), never by a list the caller passes in. An operand that does
# not classify as a Structure is refused -- a METHOD record is not one and
# cannot be merged.
#
# Qualification is an address-domain property.  A caller may name any number of ordinary
# graph receiver-expressions whose physical addresses denote full
# independent+const+immutable profiles.  Only exact membership in an array carrying one of
# those physical profiles retains an address; another profile with identical kind/type, an
# unprofiled independent root, foreign ownership, and sealing all take the copy path.
# A retained foreign address must already be visible through an explicit sealed-range import
# in dst_arena. Only sealed ranges may be retained; merge never adopts their storage or
# installs a hidden range view. The caller supplies the profiles as a call-bounded span of
# physical Lmx references. Duplicates are idempotent; no global set, numeric qualifier or
# textual identity participates.
#
# TWO arenas, because the act has two sides: `src_arena` is the arena the
# operands, the body and the container live in and answers every classification
# question; `dst_arena` is the arena the copies and the result are built in.
#
# `container` is the live Structure through which the merge receiver executed.
# It becomes the RESULT's parent and nothing else: it is not assigned as the parent
# of any copied child, whose parent links come from the map. A nonzero container
# must classify as a Structure of src_arena -- the arena's table answers that,
# not an inventory -- and a foreign address is refused rather than stored.
#
# Atomicity is the arena's own act, exactly as it is for one Array: merge takes
# `mark: lmx_arena_mark(dst_arena)` before it builds anything and reverts to it
# on any failure, so the copies, the result root and its slots join dst_arena
# together or none of them does. On any failure out stays null, the destination
# arena is left as it was at the mark, every source graph is unchanged. There is
# no empty-success substitute for a failed merge.
define: LMX_MERGE_OK 0
define: LMX_MERGE_INVALID 1
define: LMX_MERGE_NOMEM 2
define: LMX_MERGE_UNSUPPORTED 3

prototype:
    # Exposed so the overflow boundary can be exercised directly: a width
    # past INT_MAX is not constructible as a live Structure in a test
    # without fabricating a header, and a fabricated header would test the
    # fake rather than the guard.
    fn: lmx_merge_add_width (@: size_t total; @: Lmx x) int
    fn: lmx_merge_owned (@@: Lmx operands; size_t: count; @: Lmx body; @: Lmx container; @: char dst_chars; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx out) int
    fn: lmx_merge_profiles_owned (@@: Lmx operands; size_t: count; @: Lmx body; @: Lmx container; @: char dst_chars; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @@: Lmx out) int
    # `retain_profile` is the exact physical profile representing the full
    # independent+const+immutable receiver chain.  No other profile/lifecycle/owner
    # property retains an address.
    fn: lmx_merge_profiled_owned (@@: Lmx operands; size_t: count; @: Lmx body; @: Lmx container; @: char dst_chars; @: LmxArena src_arena; @: LmxArena dst_arena; @: Lmx retain_profile; @@: Lmx out) int
end: prototype
