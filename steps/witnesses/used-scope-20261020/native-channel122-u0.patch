+# One computed activation value,shared by native calls and interpretation.
+# The historic C type name is retained;no name is stored in a program graph.
+# Storage is the declared-width member below,not the enclosing record.
+define: LMX_WALK_VALUE_NUMBER 1
+define: LMX_WALK_VALUE_REFERENCE 2
+struct: LmxWalkValue
+    int: present
+    int: kind
+    int: type
+    @: void ref
+    int: number
+    size_t: wide
+    unsigned: natural
+    ulong: longnum
+    char: byte
+    # CURRENT declared Model and reference sheet of this computed value.
+    # Never infer them from layout,history,parent or callback identity.
+    @: Lmx model
+    @: Lmx references
+end: LmxWalkValue
