# FABLE-OPUS-MERGE-PARTS-20260926-193 T1b: an all-caps name that no L2 declaration and no `define:`
# gives is a free name of m that no caller binds -- refused at the root's call of m, not a C constant left
# for gcc.  A name only C knows is spelled `c.NAME`.
fn: m () int
    int: k 0
    k: NOPE + 1
    return: k
end: m

sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
