---
    Observed:
        int: default_calls 0
        int: profile_arity 34
        int: qualified_arity 3
        int: chain_arity 1
        int: rectangular_arity 1
        int: deep_arity 1
        int: deferred_arity 1
        int: model_arity 1
        int: deferred_data 1
    end: Observed
---
@: shared (data [] 0)
int: default_calls 0
fn: seed () int
    :=: (node \ default_calls) ((node \ default_calls) + 1)
    return: 9
end: seed
fn: profile (char: a01; schar: a02; short: a03; int: a04; long: a05; llong: a06; float: a07; double: a08; flong: a09; signed: a10; uchar: a11; ushort: a12; unsigned: a13; uint: a14; ulong: a15; ullong: a16; size_t: a17; Boolean: a18; bool: a19; _Bool: a20; u8: a21; uint8: a22; u16: a23; u32: a24; u64: a25; i8: a26; int8: a27; i16: a28; i32: a29; i64: a30; f32: a31; f64: a32; FILE: a33; c.FILE: a34) int
fn: qualified ((const ((@ p int))); (immutable ((int fixed))); (independent ((@ handle c.FILE)))) int
fn: chain ((char ([] ([] grid)))) int
fn: rectangular ([][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][]: rectangle) int
fn: deep (@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@: link) int
fn: deferred (int: value) int
fn: model (@: value ((ordinary nested))) int
int: profile_arity (length (profile \ data))
int: qualified_arity (length (qualified \ data))
int: chain_arity (length (chain \ data))
int: rectangular_arity (length (rectangular \ data))
int: deep_arity (length (deep \ data))
int: deferred_arity (length (deferred \ data))
int: model_arity (length (model \ data))
int: deferred_data (length (deferred \ data))
sub: observe ()
    :=: ((shared \ Observed) \ default_calls) default_calls
    :=: ((shared \ Observed) \ profile_arity) profile_arity
    :=: ((shared \ Observed) \ qualified_arity) qualified_arity
    :=: ((shared \ Observed) \ chain_arity) chain_arity
    :=: ((shared \ Observed) \ rectangular_arity) rectangular_arity
    :=: ((shared \ Observed) \ deep_arity) deep_arity
    :=: ((shared \ Observed) \ deferred_arity) deferred_arity
    :=: ((shared \ Observed) \ model_arity) model_arity
    :=: ((shared \ Observed) \ deferred_data) deferred_data
end: observe
observe:
