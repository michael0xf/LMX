Model: (size_t: xFirst 1U; size_t: xLast 2U)
Later: (size_t: xLast 33U)
Last: (size_t: xLast 9U)
fn: read (Last: value) size_t
return: value\xLast
fn: check () int
    copy: merge: Model Later
    if: copy\xFirst != 1U || copy\xLast != 33U
        return: 81
    if: read(copy) != 33U
        return: 82
    @: alias Last copy
    alias\xLast: 44U
    original: merge: Model
    if: copy\xFirst != 1U || copy\xLast != 44U || original\xFirst != 1U || original\xLast != 2U
        return: 83
return: 7
sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
