+fn: lmx_walk_role_cell (@: arena c.LmxArena; int: code; @: held_profile c.Lmx) @: void
+    if: arena = 0 || code <= c.LMX_WALK_OP_NONE || code >= c.LMX_WALK_OP_COUNT * c.LMX_WALK_SOURCE_COUNT
+        return: 0
+    return: (cast: (@: void) c.lmx_op_new_profiled(arena, code, held_profile))
+end: lmx_walk_role_cell
