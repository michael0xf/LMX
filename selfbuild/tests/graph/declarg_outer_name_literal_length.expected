---
    Observed:
        int: seen 6
        int: calls 0
    end: Observed
---
fn: producer () int
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ calls) (((shared \ Observed) \ calls) + 1)
    return: 7
end: producer
Any:
end: Any
fn: h (@: it Any; int: y 0) int
    return: (y + (length it))
end: h
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) (h (:= it ((int it 5))) (:= y 4))
end: main
main:
