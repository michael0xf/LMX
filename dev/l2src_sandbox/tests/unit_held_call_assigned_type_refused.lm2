# A held callable's call has a type: stored alone to a reference, its int is
# refused as any int is.
fn: make2 (int: n) fn: (int: x; int: y) int
    fn: f2 (int: x; int: y) int
        return: n + x * 10 + y
    return: f2

h2: make2 100
int: v 5
@: int p @ v
p: h2(1 2)
sendMessage: exit(exit_code: v; stdout: ""; stderr: "")
return
