# N4: S's original y is a Structure, while D's y is an int. The names match,
# but the receiving place is unfit: call refuses before running S and the
# uncaught implicit call throw stops the root Message.
S:
    y: 5
end: S
D:
    int: pad 2
    int: y 1
end: D
call: S D
sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
return
