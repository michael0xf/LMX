predef: "lmx_array_grow_owned.h.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_pool.h.lm1"

# Growth is an owner-exclusive arena operation. Direct addresses of backing
# cells remain valid only until a successful reserve/append replaces the
# backing. Remove keeps the backing but invalidates direct cell addresses at and
# after the removed position because it compacts them. Physical referent VALUES
# copied from cells do not change. A failed operation changes nothing.
#
# Old backing is never retired by dropping an arbitrary subrange: service-pool
# chunks may contain more than one logical Array backing, while the arena index
# registers the whole chunk. After publication the old logical cells are zeroed,
# so a still-shared chunk cannot retain stale referents. Ordinary arena GC later
# retires a whole unreachable chunk together with its exact registered range.

fn: lmx_array_grow_ref_layout (@: LmxArrayDesc array; @: LmxArena arena; @: int backing_kind; @: int element_type) int
    int: type
    @: void last
    if: array = 0 || arena = 0 || backing_kind = 0 || element_type = 0
        return: c.LMX_ARRAY_GROW_INVALID
    if: lmx_range_classify(arena, (cast: (@: void) array)) != c.LMX_KIND_ARRAY
        return: c.LMX_ARRAY_GROW_INVALID
    if: lmx_range_home(arena, (cast: (@: void) array)) != arena
        return: c.LMX_ARRAY_GROW_INVALID
    type: lmx_range_type_of(arena, (cast: (@: void) array))
    if: type = c.LMX_TYPE_ARRAY_OF_LMX
        \backing_kind: c.LMX_KIND_REF
        \element_type: c.LMX_TYPE_LMX
    else:
        if: type = c.LMX_TYPE_ARRAY_OF_DESC
            \backing_kind: c.LMX_KIND_REF
            \element_type: c.LMX_TYPE_DESC
        else:
            if: type = c.LMX_TYPE_ARRAY_OF_METHOD
                \backing_kind: c.LMX_KIND_REF
                \element_type: c.LMX_TYPE_METHOD
            else:
                if: type < c.LMX_TYPE_ARRAY_OF_POINTER_BASE
                    return: c.LMX_ARRAY_GROW_INVALID
                \backing_kind: c.LMX_KIND_PRIMITIVE
                \element_type: c.LMX_TYPE_POINTER_BASE + (type - c.LMX_TYPE_ARRAY_OF_POINTER_BASE)
            ---
        ---
    ---
    if: array\len > array\capacity
        return: c.LMX_ARRAY_GROW_INVALID
    if: array\capacity = 0U
        if: array\data != 0
            return: c.LMX_ARRAY_GROW_INVALID
        return: c.LMX_ARRAY_GROW_OK
    ---
    if: array\data = 0
        return: c.LMX_ARRAY_GROW_INVALID
    if: lmx_range_home(arena, array\data) != arena
        return: c.LMX_ARRAY_GROW_INVALID
    if: array\capacity > ((cast: (size_t) -1) / c.sizeof(@: void))
        return: c.LMX_ARRAY_GROW_INVALID
    if: lmx_range_classify(arena, array\data) != \backing_kind || lmx_range_type_of(arena, array\data) != \element_type || lmx_range_stride(arena, array\data) != c.sizeof(@: void)
        return: c.LMX_ARRAY_GROW_INVALID
    ---
    last: (cast: (@: void) ((cast: (@: char) array\data) + ((array\capacity - 1U) * c.sizeof(@: void))))
    if: lmx_range_classify(arena, last) != \backing_kind || lmx_range_type_of(arena, last) != \element_type || lmx_range_stride(arena, last) != c.sizeof(@: void)
        return: c.LMX_ARRAY_GROW_INVALID
    ---
return: c.LMX_ARRAY_GROW_OK

fn: lmx_array_grow_ref_new_owned (int: type; @: LmxArena arena) @: LmxArrayDesc
    @: LmxArrayDesc array
    if: arena = 0
        return: 0
    if: type = c.LMX_TYPE_ARRAY_OF_LMX || type = c.LMX_TYPE_ARRAY_OF_DESC || type = c.LMX_TYPE_ARRAY_OF_METHOD
        array: lmx_array_ref_new_owned(type, c.LMX_ARRAY_GROW_MIN_CAPACITY, arena)
    else:
        if: type < c.LMX_TYPE_ARRAY_OF_POINTER_BASE
            return: 0
        array: lmx_array_new_owned(type, c.LMX_ARRAY_GROW_MIN_CAPACITY, arena)
    ---
    if: array = 0
        return: 0
    array\len: 0U
return: array

fn: lmx_array_grow_ref_reserve_owned (@: LmxArrayDesc array; size_t: need; @: LmxArena arena) int
    int: backing_kind 0
    int: element_type 0
    size_t: capacity
    size_t: delta
    size_t: index
    size_t: old_capacity
    @@: void old_cells
    @@: void new_cells
    if: lmx_array_grow_ref_layout(array, arena, @ backing_kind, @ element_type) != c.LMX_ARRAY_GROW_OK
        return: c.LMX_ARRAY_GROW_INVALID
    if: need <= array\capacity
        return: c.LMX_ARRAY_GROW_OK
    old_capacity: array\capacity
    capacity: old_capacity
    if: capacity < c.LMX_ARRAY_GROW_MIN_CAPACITY
        capacity: c.LMX_ARRAY_GROW_MIN_CAPACITY
    ---
    while: capacity < need
        delta: capacity / 2U
        if: delta = 0U
            delta: 1U
        ---
        if: capacity > ((cast: (size_t) -1) - delta)
            return: c.LMX_ARRAY_GROW_OVERFLOW
        capacity: capacity + delta
    ---
    if: capacity > ((cast: (size_t) -1) / c.sizeof(@: void))
        return: c.LMX_ARRAY_GROW_OVERFLOW
    new_cells: (cast: (@@: void) lmx_arena_take_n(arena, c.sizeof(@: void), backing_kind, element_type, capacity))
    if: new_cells = 0
        return: c.LMX_ARRAY_GROW_NOMEM
    old_cells: (cast: (@@: void) array\data)
    index: 0U
    while: index < array\len
        new_cells[index]: old_cells[index]
        index: index + 1U
    ---
    # This publication is the invalidation point for direct addresses of old cells.
    array\data: (cast: (@: void) new_cells)
    array\capacity: capacity
    index: 0U
    while: index < old_capacity
        old_cells[index]: 0
        index: index + 1U
    ---
return: c.LMX_ARRAY_GROW_OK

fn: lmx_array_grow_ref_append_owned (@: LmxArrayDesc array; @: void value; @: LmxArena arena) int
    @@: void cells
    int: status
    if: array = 0 || array\len = (cast: (size_t) -1)
        return: c.LMX_ARRAY_GROW_OVERFLOW
    status: lmx_array_grow_ref_reserve_owned(array, array\len + 1U, arena)
    if: status != c.LMX_ARRAY_GROW_OK
        return: status
    cells: (cast: (@@: void) array\data)
    cells[array\len]: value
    array\len: array\len + 1U
return: c.LMX_ARRAY_GROW_OK

fn: lmx_array_grow_ref_remove_owned (@: LmxArrayDesc array; size_t: index; @@: void removed; @: LmxArena arena) int
    int: backing_kind 0
    int: element_type 0
    @@: void cells
    size_t: at
    if: lmx_array_grow_ref_layout(array, arena, @ backing_kind, @ element_type) != c.LMX_ARRAY_GROW_OK
        return: c.LMX_ARRAY_GROW_INVALID
    if: index >= array\len
        return: c.LMX_ARRAY_GROW_BOUNDS
    cells: (cast: (@@: void) array\data)
    if: removed != 0
        \removed: cells[index]
    at: index
    while: at + 1U < array\len
        cells[at]: cells[at + 1U]
        at: at + 1U
    ---
    cells[array\len - 1U]: 0
    array\len: array\len - 1U
return: c.LMX_ARRAY_GROW_OK

fn: lmx_array_grow_ref_value (@: LmxArrayDesc array; size_t: index) @: void
    @@: void cells
    if: array = 0 || index >= array\len || array\data = 0
        return: 0
    cells: (cast: (@@: void) array\data)
return: cells[index]
