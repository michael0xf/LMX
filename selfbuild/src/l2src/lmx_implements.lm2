# Physical receiving correspondence and used-interface admission, in L2 (plan S8.3).
# The C ABI records are printed as L1 by the ordinary L3 recipe; all state stays in
# explicit arena/operation arguments. This port does not add an admission rule.
predef: "l2src/lmx_implements.h.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l2src/lmx_pool.h.lm1"
predef: "l2src/lmx_scratch.lm1"
predef: "l2src/lmx_implements_resolve.h.lm1"
predef: "l2src/lmx_source_names.h.lm1"
predef: "l2src/lmx_ids.h.lm1"
predef: "l2src/lmx_walk.h.lm1"
predef: "l2src/lmx_value_owned.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdlib.h>" "<string.h>"


# lmx_implements.lm1 - the domain questions, answered from the address alone.
#
# The whole mechanism is the arena's index (lmx_range_classify, lmx_range_type_of):
# membership in one of the arena's arrays, no tag read.  This unit adds two things
# and nothing else -- a way to register a whole domain (count * stride) in one call,
# and the compatibility primitive itself.  The slot_table is not created here: it is the
# arena's, opened by the caller with lmx_arena_open, which is why every question
# below names the arena it is asked of.

# Register one domain's storage: a domain is one array of the arena like every
# other, so the caller supplies the two records that describe it and the array's
# interval is registered against them. Nothing is owned here: the storage is the
# caller's frame or the arena's block list, never this unit's.
fn: lmx_domain_register (@: arena c.LmxArena; @: pool c.LmxPool; @: chunk c.LmxChunk; @: lo void; size_t: count; size_t: stride; int: kind; int: type) int
    if: arena = 0 || lo = 0 || count = 0U || stride = 0U
        return: c.LMX_DOMAIN_REGISTER_FAIL
    if: count > ((cast: (size_t) -1) / stride)
        return: c.LMX_DOMAIN_REGISTER_FAIL
    if: c.lmx_pool_over(arena, pool, chunk, lo, count * stride, stride, kind, type) != 0
        return: c.LMX_DOMAIN_REGISTER_FAIL
    return: c.LMX_DOMAIN_REGISTER_OK
end: lmx_domain_register

fn: lmx_domain_kind (@: arena c.LmxArena; @: p void) int
    return: c.lmx_range_classify(arena, p)
end: lmx_domain_kind

fn: lmx_domain_type (@: arena c.LmxArena; @: p void) int
    return: c.lmx_range_type_of(arena, p)
end: lmx_domain_type

fn: lmx_domain_known (@: arena c.LmxArena; @: p void) int
    if: p = 0
        return: c.LMX_IMPLEMENTS_NO
    if: c.lmx_range_classify(arena, p) = c.LMX_KIND_NONE
        return: c.LMX_IMPLEMENTS_NO
    return: c.LMX_IMPLEMENTS_YES
end: lmx_domain_known

# This is the shared low-level registered-domain leaf question, not the whole
# language-level first part of admission. Its same-kind/type answer alone
# does not establish the interfaces actually used by a Consumer.
#
# The Consumer-relative worker below checks those used interfaces and written
# CALL contracts for both known and runtime-created candidates. It does not
# analyze provider bodies or prove future result behavior; extra analysis
# belongs only to an explicitly written test block.
#
# The arena is the one whose index answers for both operands: a domain question is
# asked of an address, and the answer comes from the arena the address lives in.
fn: lmx_implements (@: arena c.LmxArena; @: varA void; @: varB void; @: consumer void) int
    int: kindA
    int: kindB
    int: typeA
    int: typeB
    if: varA = 0 || varB = 0
        return: c.LMX_IMPLEMENTS_NO
    kindA: c.lmx_range_classify(arena, varA)
    typeA: c.lmx_range_type_of(arena, varA)
    kindB: c.lmx_range_classify(arena, varB)
    typeB: c.lmx_range_type_of(arena, varB)
    if: kindA = c.LMX_KIND_NONE || typeA = c.LMX_TYPE_NONE || kindB = c.LMX_KIND_NONE || typeB = c.LMX_TYPE_NONE
        return: c.LMX_IMPLEMENTS_UNKNOWN
    if: kindB != kindA
        return: c.LMX_IMPLEMENTS_NO
    if: typeB != typeA
        return: c.LMX_IMPLEMENTS_NO
    return: c.LMX_IMPLEMENTS_YES
end: lmx_implements

# The common Consumer-relative used-interface worker. The historical runtime
# helper name does not designate the language's optional analytical test part.
# Runtime-created structures use this same ordinary admission and address-map
# machinery; uncertainty by itself does not establish an impossible requirement.
#
# The Consumer here is a STRUCTURE, and that is what makes a runtime walk possible at all: "the
# used tree is the contract" (2.5.1) -- the Consumer's own shape gives the paths it uses, because
# names are absent from ordinary LMX execution (spec 1178) and every path is an index path.  A
# child of the Consumer that is UNSET is not a used path ("An empty `uses` is true: there is
# nothing to use"), so a Consumer with no children is satisfied by anything.
#
# Per used path, in the order the spec gives it:
#   * the path must be PRESENT on both operands -- "every path in uses(Consumer varB) is present
#     on varA";
#   * the leaf must be ADMITTED: one domain kind and one type on all three (2.2.3's primitive-leaf
#     admission -- an address is admitted where its domain is);
#   * at a callable the Consumer CALLS, only its written calls are checked (book §7,
#     #three-argument-implements; Q49): CHECK marks that field called in the Consumer's coverage
#     (below SIZE_MAX - 1), and the walk asks whether the candidate's value takes the call its
#     caller forms from the model's description of the field (lmx_implements_call_takes), without
#     entering the field as a Structure.  No equality of signatures is asked.  A callable the
#     Consumer only names, passes or stores is consumed whole, like any other field: no future
#     call of it is asked about.
#
# One operation's DFS frame and visited triple. These records live only in temporary scratch,
# never in the checked graph or the arena's cache of completed admissions. Keeping a frame
# after its DFS return lets shared targets and back-edges reuse the same expansion.
# An address of no known domain is UNKNOWN, never YES. A known mismatch is NO.
# Frames preserve the recursive walk's depth-first sibling order without a depth bound.
fn: lmx_implements_view (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: pending c.LmxImplEntry) @: c.LmxImplEntry
    if: pending != 0 && pending\value = value && pending\req = req
        return: pending
    return: lmx_implements_find(arena, value, req)
end: lmx_implements_view

fn: lmx_implements_pending_check (@: arena c.LmxArena; @: pending c.LmxImplEntry; size_t: count; @: out_answer int) int
    @: part_row_pending_i_req_array c.VoidArray 0
    @: row_pending_i c.LmxImplEntry
    @: row_pending_j c.LmxImplEntry
    size_t: i 0U
    size_t: j
    @: layout void
    int: valid
    int: status
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: count != 0U && (pending = 0 || arena = 0)
        return: c.LMX_WALK_INVALID
    if: count > ((cast: (size_t) -1) / c.sizeof(c.LmxImplEntry))
        return: c.LMX_WALK_NOMEM
    while: i < count
        row_pending_i: pending + i
        if: row_pending_i\value = 0 || row_pending_i\req = 0
            return: c.LMX_WALK_OK
        row_pending_i: pending + i
        if: lmx_domain_kind(arena, (cast: (@: void) (row_pending_i\value))) = c.LMX_KIND_NONE || lmx_domain_kind(arena, (cast: (@: void) (row_pending_i\req))) = c.LMX_KIND_NONE
            return: c.LMX_WALK_OK
        row_pending_i: pending + i
        if: c.lmx_graph_node_in(arena, (cast: (@: void) (row_pending_i\value))) = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) (row_pending_i\req))) = 0
            out_answer[0]: c.LMX_IMPLEMENTS_NO
            return: c.LMX_WALK_OK
        row_pending_i: pending + i
        if: row_pending_i != 0 && row_pending_i\req != 0
            part_row_pending_i_req_array: (cast: (@: c.VoidArray) (@ row_pending_i\req\array))
        ---
        status: lmx_implements_view_valid(arena, pending + i, (cast: (size_t) (part_row_pending_i_req_array\size)), @ valid)
        if: status != c.LMX_WALK_OK || valid != c.LMX_IMPLEMENTS_YES
            out_answer[0]: valid
            return: status
        row_pending_i: pending + i
        layout: lmx_implements_layout(arena, (cast: (@: c.Lmx) row_pending_i\value))
        row_pending_i: pending + i
        if: layout != 0 && row_pending_i\layout != 0 && layout != row_pending_i\layout
            out_answer[0]: c.LMX_IMPLEMENTS_NO
            return: c.LMX_WALK_OK
        j: 0U
        while: j < i
            row_pending_j: pending + j
            row_pending_i: pending + i
            if: row_pending_j\value = row_pending_i\value && row_pending_j\req = row_pending_i\req
                row_pending_i: pending + i
                if: row_pending_i != 0 && row_pending_i\req != 0
                    part_row_pending_i_req_array: (cast: (@: c.VoidArray) (@ row_pending_i\req\array))
                ---
                status: lmx_implements_compatible_map(arena, pending + j, pending + i, (cast: (size_t) (part_row_pending_i_req_array\size)), @ valid)
                if: status != c.LMX_WALK_OK || valid != c.LMX_IMPLEMENTS_YES
                    return: status
                row_pending_j: pending + j
                row_pending_i: pending + i
                if: row_pending_j\layout != 0 && row_pending_i\layout != 0 && row_pending_j\layout != row_pending_i\layout
                    return: c.LMX_WALK_OK
                ---
            ---
            row_pending_j: pending + j
            row_pending_i: pending + i
            if: row_pending_j\value = row_pending_i\value && row_pending_j\req != row_pending_i\req && row_pending_j\layout != 0 && row_pending_i\layout != 0 && row_pending_j\layout != row_pending_i\layout
                out_answer[0]: c.LMX_IMPLEMENTS_NO
                return: c.LMX_WALK_OK
            j: j + 1U
        ---
        i: i + 1U
    ---
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_implements_pending_check

# Cell k of a receiving instruction's coverage: the translator's static cells, or
# the size cells of the walked instruction. Cell 0 is the count of cells and
# bounds every read.
fn: lmx_implements_use_cell (@: arena c.LmxArena; @: uses c.LmxImplUses; size_t: k; @: out size_t) int
    @: part_frame_array c.VoidArray 0
    @: cell void
    @: at size_t
    @: frame c.Lmx
    size_t: extent
    if: uses = 0 || out = 0
        return: 1
    if: uses\map != 0
        if: uses\map[0] < 2U || k >= uses\map[0]
            return: 1
        \out: uses\map[k]
        return: 0
    ---
    if: uses\frame = 0 || uses\at + k < uses\at
        return: 1
    frame: uses\frame
    if: c.lmx_graph_node_in(arena, (cast: (@: void) frame)) = 0
        return: 1
    if: frame != 0
        part_frame_array: (cast: (@: c.VoidArray) (@ frame\array))
    ---
    extent: part_frame_array\size
    if: uses\at >= extent
        return: 1
    cell: c.lmx_graph_value_in(arena, frame, uses\at)
    if: lmx_implements_metadata_cell(arena, cell, c.LMX_TYPE_SIZE_T, c.sizeof(c.size_t)) = 0
        return: 1
    at: (cast: (@: size_t) cell)
    # A declared slice must fit its physical owner even when the current
    # Consumer reads only an early prefix. Extra unused levels cannot
    # certify storage that this frame never contained.
    if: at[0] < 2U || at[0] > extent - uses\at || k >= at[0]
        return: 1
    cell: c.lmx_graph_value_in(arena, uses\frame, uses\at + k)
    if: lmx_implements_metadata_cell(arena, cell, c.LMX_TYPE_SIZE_T, c.sizeof(c.size_t)) = 0
        return: 1
    at: (cast: (@: size_t) cell)
    \out: at[0]
    return: 0
end: lmx_implements_use_cell

# Decode only the ordinary CALL-row carrier. Null anchors are unavailable
# facts; a present non-graph anchor or truncated physical row is malformed.
# No call, selector, receiving operation or provider body runs here.
fn: lmx_implements_calls_shape (@: arena c.LmxArena; @: calls c.Lmx; @: out_count size_t) int
    size_t: count 0U
    size_t: row 0U
    size_t: column
    size_t: offset
    @: cell void
    @: wide size_t
    if: arena = 0 || out_count = 0
        return: c.LMX_WALK_INVALID
    out_count[0]: 0U
    if: calls = 0
        return: c.LMX_WALK_OK
    if: c.lmx_graph_node_in(arena, (cast: (@: void) calls)) = 0
        return: c.LMX_WALK_INVALID
    @: fields c.VoidArray @ calls\array
    if: fields\size < 1U
        return: c.LMX_WALK_INVALID
    cell: c.lmx_graph_value_in(arena, calls, 0U)
    if: lmx_implements_metadata_cell(arena, cell, c.LMX_TYPE_SIZE_T, c.sizeof(c.size_t)) = 0
        return: c.LMX_WALK_INVALID
    wide: (cast: (@: size_t) cell)
    count: wide[0]
    if: count > (fields\size - 1U) / 5U
        return: c.LMX_WALK_INVALID
    while: row < count
        offset: 1U + row * 5U
        cell: c.lmx_graph_value_in(arena, calls, offset)
        if: lmx_implements_metadata_cell(arena, cell, c.LMX_TYPE_SIZE_T, c.sizeof(c.size_t)) = 0
            return: c.LMX_WALK_INVALID
        column: 1U
        while: column < 5U
            cell: c.lmx_graph_value_in(arena, calls, offset + column)
            if: cell != 0 && c.lmx_graph_node_in(arena, cell) = 0
                return: c.LMX_WALK_INVALID
            column: column + 1U
        ---
        row: row + 1U
    ---
    out_count[0]: count
    return: c.LMX_WALK_OK
end: lmx_implements_calls_shape

# One DFS serves an explicit used tree and a declaration's interface. Only the
# interface projection omits executable source frames: their first child belongs
# to the existing OP address domain. Their operands describe an algorithm, not a
# field requirement. Plain nested Structures and real typed cells remain required.
#
# `uses` is the coverage of the receiving instruction being run, or null. With
# it the consumer stays the index space, but a frame walks the fields its level
# names instead of every field: a field the level does not name is not looked
# at, present or missing, and a field it names is required whatever skip_unused
# says. Each edge selects its own half of the correspondence. A frame below a
# field consumed whole walks every field again.
# Add an already resolved pair without retaining a proof. owned=1 transfers
# one temporary computed map to this operation even on refusal; borrowed
# seed/template maps are never freed by this operation. The two-half unknown
# mask annotates unresolved coordinates only and never enters LmxImplEntry.
# Owned masks transfer even on refusal; borrowed masks are copied here.
fn: lmx_implements_prepare_view (@: arena c.LmxArena; @: resolver c.LmxImplResolve; @: view c.LmxImplEntry; int: owned; @: unknown size_t; int: unknown_owned; @@: out c.LmxImplEntry; @: out_answer int) int
    @: part_view_req_array c.VoidArray 0
    @: part_cell_view c.LmxImplEntry 0
    @: cell c.LmxImplPreparedView
    @: room void 0
    @: copied_unknown size_t 0
    size_t: width
    size_t: i
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    int: scratch_status
    if: out != 0
        \out: 0
    if: out_answer != 0
        out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: resolver = 0 || view = 0 || out = 0 || out_answer = 0
        if: owned != 0 && view != 0 && view\owned_map != 0 && view\map != 0
            c.free((cast: (@: void) view\map))
        if: unknown_owned != 0 && unknown != 0
            c.free((cast: (@: void) unknown))
        return: c.LMX_WALK_INVALID
    if: view\req = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) view\req)) = 0
        if: owned != 0 && view\owned_map != 0 && view\map != 0
            c.free((cast: (@: void) view\map))
        if: unknown_owned != 0 && unknown != 0
            c.free((cast: (@: void) unknown))
        return: c.LMX_WALK_INVALID
    \out: 0
    if: view != 0 && view\req != 0
        part_view_req_array: (cast: (@: c.VoidArray) (@ view\req\array))
    ---
    width: part_view_req_array\size
    status: lmx_implements_view_valid(arena, view, width, @ answer)
    if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        if: owned != 0 && view\owned_map != 0 && view\map != 0
            c.free((cast: (@: void) view\map))
        ---
        if: unknown_owned != 0 && unknown != 0
            c.free((cast: (@: void) unknown))
        if: status = c.LMX_WALK_OK
            out_answer[0]: answer
        return: status
    ---
    if: width = 0U
        if: unknown_owned != 0 && unknown != 0
            c.free((cast: (@: void) unknown))
        unknown: 0
        unknown_owned: 0
    if: unknown != 0 && unknown_owned = 0
        copied_unknown: (cast: (@: size_t) c.malloc(width * 2U * c.sizeof(c.size_t)))
        if: copied_unknown = 0
            if: owned != 0 && view\owned_map != 0 && view\map != 0
                c.free((cast: (@: void) view\map))
            return: c.LMX_WALK_NOMEM
        c.memcpy((cast: (@: void) copied_unknown), (cast: (@: void) unknown), width * 2U * c.sizeof(c.size_t))
        unknown: copied_unknown
        unknown_owned: 1
    cell: resolver\views
    while: cell != 0
        if: cell != 0
            part_cell_view: (cast: (@: c.LmxImplEntry) (@ cell\view))
        ---
        if: part_cell_view\value = view\value && part_cell_view\req = view\req
            answer: c.LMX_IMPLEMENTS_UNKNOWN
            if: cell != 0
                part_cell_view: (cast: (@: c.LmxImplEntry) (@ cell\view))
            ---
            if: lmx_implements_same_map(arena, (cast: (@: c.LmxImplEntry) @ cell\view), view, width) != 0 && (part_cell_view\layout = 0 || view\layout = 0 || part_cell_view\layout = view\layout)
                # Compatible visits can add uncertainty, never turn a hole
                # into certified absence. Existing nonnull storage is kept;
                # DFS refreshes prepared_mask when it consumes a hole.
                if: unknown != 0 && cell\unknown = 0
                    cell\unknown: unknown
                    cell\release_unknown: unknown_owned
                    unknown: 0
                    unknown_owned: 0
                else:
                    if: unknown != 0 && unknown != cell\unknown
                        i: 0U
                        while: i < width * 2U
                            if: unknown[i] != 0U
                                cell\unknown[i]: 1U
                            i: i + 1U
                        ---
                    ---
                ---
                \out: @ cell\view
                answer: c.LMX_IMPLEMENTS_YES
            ---
            if: owned != 0 && view\owned_map != 0 && view\map != 0 && view\map != part_cell_view\map
                c.free((cast: (@: void) view\map))
            if: unknown_owned != 0 && unknown != 0 && unknown != cell\unknown
                c.free((cast: (@: void) unknown))
            out_answer[0]: answer
            return: c.LMX_WALK_OK
        ---
        cell: cell\next
    ---
    status: c.LMX_WALK_NOMEM
    scratch_status: c.LMX_SCRATCH_NOMEM
    if: resolver\count != (cast: (size_t) -1)
        scratch_status: c.lmx_scratch_take(resolver\scratch, c.sizeof(c.LmxImplPreparedView), @ room)
        if: scratch_status != c.LMX_SCRATCH_OK && scratch_status != c.LMX_SCRATCH_NOMEM
            status: c.LMX_WALK_INVALID
        ---
    ---
    if: scratch_status = c.LMX_SCRATCH_OK
        cell: (cast: (@: c.LmxImplPreparedView) room)
        c.memcpy((cast: (@: void) (@ cell\view)), (cast: (@: void) view), c.sizeof(c.LmxImplEntry))
        # Coherent current value evidence is shared by every prepared pair.
        # An old complete target map may predate a genuinely known origin;
        # retaining its coordinates must not retain stale unknown provenance.
        if: cell != 0
            part_cell_view: (cast: (@: c.LmxImplEntry) (@ cell\view))
        ---
        if: part_cell_view\layout = 0
            if: cell != 0
                part_cell_view: (cast: (@: c.LmxImplEntry) (@ cell\view))
            ---
            part_cell_view\layout: lmx_implements_layout(arena, (cast: (@: c.Lmx) (part_cell_view\value)))
        # Coordinates are borrowed; permissions/dependencies are produced
        # by this operation, never supplied by a template or pending view.
        if: cell != 0
            part_cell_view: (cast: (@: c.LmxImplEntry) (@ cell\view))
        ---
        part_cell_view\contract: 0
        if: cell != 0
            part_cell_view: (cast: (@: c.LmxImplEntry) (@ cell\view))
        ---
        if: part_cell_view\map = 0 && part_cell_view\frame = 0
            if: cell != 0
                part_cell_view: (cast: (@: c.LmxImplEntry) (@ cell\view))
            ---
            part_cell_view\n: width
        ---
        cell\release_map: owned
        cell\unknown: unknown
        cell\release_unknown: unknown_owned
        cell\next: resolver\views
        resolver\views: cell
        resolver\count: resolver\count + 1U
        \out: @ cell\view
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    ---
    if: owned != 0 && view\owned_map != 0 && view\map != 0
        c.free((cast: (@: void) view\map))
    if: unknown_owned != 0 && unknown != 0
        c.free((cast: (@: void) unknown))
    return: status
end: lmx_implements_prepare_view

# The already resolved pointer selects this operation's temporary annotation.
# No name/provider lookup or persistent permission is involved. Identity/no
# prepared row has no mask; its separate view verdict still belongs to DFS.
fn: lmx_implements_prepared_mask (@: resolver c.LmxImplResolve; @: view c.LmxImplEntry) @: size_t
    @: cell c.LmxImplPreparedView
    @: entry c.LmxImplEntry
    if: resolver = 0 || view = 0
        return: 0
    cell: resolver\views
    while: cell != 0
        entry: (cast: (@: c.LmxImplEntry) (@ cell\view))
        if: entry = view
            return: (cast: (@: size_t) cell\unknown)
        cell: cell\next
    ---
    return: 0
end: lmx_implements_prepared_mask

# Only stable positive places clear a temporary uncertainty annotation.
# A currently empty cell does not erase its already selected numeric place.
fn: lmx_implements_mask_known (@: arena c.LmxArena; @: view c.LmxImplEntry; size_t: width; @: unknown size_t) int
    size_t: i 0U
    size_t: index
    size_t: slot
    int: last
    if: unknown = 0
        return: c.LMX_WALK_OK
    if: view = 0
        return: c.LMX_WALK_INVALID
    if: width > ((cast: (size_t) -1) / c.sizeof(c.size_t)) / 2U
        return: c.LMX_WALK_NOMEM
    while: i < width * 2U
        index: i
        last: 0
        if: i >= width
            index: i - width
            last: 1
        if: lmx_implements_coordinate(arena, view, index, last, @ slot) != 0
            return: c.LMX_WALK_INVALID
        if: slot != (cast: (size_t) -1)
            unknown[i]: 0U
        i: i + 1U
    ---
    return: c.LMX_WALK_OK
end: lmx_implements_mask_known

# Exact physical-template projection to an EXPLICIT logical declaration. This
# does not choose a giving Model or search old admissions. Both unqualified
# resolution and a typed value with no retained map consume this same result.
# Empty coverage need not have materialized that map before its first use.
fn: lmx_implements_direct_view (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: resolver c.LmxImplResolve; @: out c.LmxImplEntry; @: applied int; @: out_answer int) int
    const: (@: part_item_correspondence c.LmxImplEntry)
    @: part_req_array c.VoidArray 0
    const: (@: item c.LmxImplTemplate)
    c.LmxImplEntry: candidate
    @: physical void lmx_implements_layout(arena, value)
    @: required void lmx_implements_layout(arena, req)
    size_t: i 0U
    int: owned 0
    int: answer c.LMX_IMPLEMENTS_YES
    int: status c.LMX_WALK_OK
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: out = 0 || applied = 0 || resolver = 0
        return: c.LMX_WALK_INVALID
    c.memset((cast: (@: void) out), 0, c.sizeof(c.LmxImplEntry))
    \applied: 0
    if: physical = 0 || required = 0
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    while: i < resolver\template_count
        item: resolver\templates + i
        i: i + 1U
        if: item\source_layout != physical || item\required_layout != required
            continue
        c.memset((cast: (@: void) (@ candidate)), 0, c.sizeof(c.LmxImplEntry))
        candidate\value: value
        candidate\req: req
        candidate\layout: physical
        if: item != 0
            part_item_correspondence: (cast: (const: @: c.LmxImplEntry) (@ item\correspondence))
        ---
        candidate\map: part_item_correspondence\map
        if: item != 0
            part_item_correspondence: (cast: (const: @: c.LmxImplEntry) (@ item\correspondence))
        ---
        candidate\frame: part_item_correspondence\frame
        if: item != 0
            part_item_correspondence: (cast: (const: @: c.LmxImplEntry) (@ item\correspondence))
        ---
        candidate\at: part_item_correspondence\at
        if: item != 0
            part_item_correspondence: (cast: (const: @: c.LmxImplEntry) (@ item\correspondence))
        ---
        candidate\n: part_item_correspondence\n
        if: item != 0
            part_item_correspondence: (cast: (const: @: c.LmxImplEntry) (@ item\correspondence))
        ---
        candidate\holes: part_item_correspondence\holes
        if: req != 0
            part_req_array: (cast: (@: c.VoidArray) (@ req\array))
        ---
        if: candidate\n != part_req_array\size
            answer: c.LMX_IMPLEMENTS_UNKNOWN
            break
        if: req != 0
            part_req_array: (cast: (@: c.VoidArray) (@ req\array))
        ---
        status: lmx_implements_accumulate_view(arena, out, @ owned, applied, @ candidate, 0, (cast: (size_t) (part_req_array\size)), @ answer)
        if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
            break
    ---
    if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        if: owned != 0 && out\map != 0
            c.free((cast: (@: void) out\map))
        c.memset((cast: (@: void) out), 0, c.sizeof(c.LmxImplEntry))
        \applied: 0
        # Conflicting coordinates are UNKNOWN,not a proved bad used leaf.
        # The used-interface walk alone reports the latter as NO.
        answer: c.LMX_IMPLEMENTS_UNKNOWN
    ---
    if: status = c.LMX_WALK_OK
        out_answer[0]: answer
    return: status
end: lmx_implements_direct_view

# THE NAME OF A PLACE (Codex, CODEX-OPUS-20261023-S81-ADMIT): field i of s as the arena's external source-name slot_table
# names it (lmx_source_names) -- the slot's own name, or for a primitive field the name of its typed cell, which is
# that place itself. 0 when the place has none. The name of a referent never stands in for its place's.
# Slice 302 (IDENTIFIER-CODES): a name is the code of its spelling.
fn: lmx_implements_place_name (@: arena c.LmxArena; @: s c.Lmx; size_t: i) size_t
    size_t: name c.lmx_source_name_get(arena, (cast: (@: void) c.lmx_arena_ref_cell(s, i)))
    @: cell void 0
    if: name != 0U
        return: name
    cell: c.lmx_graph_value_in(arena, s, i)
    if: cell = 0 || lmx_domain_kind(arena, cell) != c.LMX_KIND_PRIMITIVE
        return: 0U
    return: c.lmx_source_name_get(arena, cell)
end: lmx_implements_place_name

# Whether two places bear one name: one code. Unnamed places are alike: the anonymous name (code 0), selected by its
# ordinal like any.
fn: lmx_implements_same_name (size_t: a; size_t: b) int
    return: (cast: (int) (a = b))
end: lmx_implements_same_name

# THE REGISTRY OF SOURCE OCCURRENCES (N4-U U1; the book, "Карта data"; author 2026-10-15: "головы считаем тупо на корневом уровне").
# Every root head of a Structure's source has one row at this port, keyed by the owning cell of the slot the head stands at: the
# place it declares, or the statement it executes.  A root `if:` is one head named `if`; a head inside an initializer belongs to that
# initializer and has no row here.  This is not the map of addressable fields: a repeated head creates no second field, it takes
# its name out of bare use, and `s\[N]field` selects the head.  0 for a slot with no head (an operation's own second child).
fn: lmx_implements_head_name (@: arena c.LmxArena; @: s c.Lmx; size_t: i) size_t
    return: c.lmx_source_name_get_at(arena, (cast: (@: void) c.lmx_arena_ref_cell(s, i)), (cast: (size_t) -2))
end: lmx_implements_head_name

# The name field i of s answers to in a correspondence: its place's, or the head that stands there.
fn: lmx_implements_view_name (@: arena c.LmxArena; @: s c.Lmx; size_t: i) size_t
    size_t: name lmx_implements_place_name(arena, s, i)
    if: name != 0U
        return: name
    return: lmx_implements_head_name(arena, s, i)
end: lmx_implements_view_name

# Name correspondence for used-interface admission (L3 section 7). When nothing
# else relates value to req -- no template, stored proof, pending row or identity: a candidate whose layout the
# translation of req never saw, such as an instance a library's construction built -- each field of req is found in
# value by the name of its place (lmx_implements_place_name). The ordinal half takes value's same-numbered occurrence of
# that name, the last half its last occurrence (K01); an unnamed place is the same-numbered unnamed place; a name value
# lacks is a hole. These are coordinates only: the interface walk checks the used fields' contracts against them as
# against any view, and the record it publishes is the ordinary one, so no access looks a name up again.
fn: lmx_implements_named_view (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: out c.LmxImplEntry; @: applied int; @: out_answer int) int
    @: part_req_array c.VoidArray 0
    @: part_value_array c.VoidArray 0
    @: have size_t 0
    @: want size_t 0
    @: map size_t 0
    size_t: width 0U
    size_t: count 0U
    size_t: i
    size_t: j 0U
    size_t: k
    size_t: ordinal
    size_t: seen
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: out = 0 || applied = 0
        return: c.LMX_WALK_INVALID
    c.memset((cast: (@: void) out), 0, c.sizeof(c.LmxImplEntry))
    \applied: 0
    if: value = 0 || req = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) value)) = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) req)) = 0
        return: c.LMX_WALK_INVALID
    if: req != 0
        part_req_array: (cast: (@: c.VoidArray) (@ req\array))
    ---
    width: part_req_array\size
    if: value != 0
        part_value_array: (cast: (@: c.VoidArray) (@ value\array))
    ---
    count: part_value_array\size
    if: width = 0U
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    if: width > ((cast: (size_t) -1) / 2U) / c.sizeof(c.size_t) || count > (cast: (size_t) -1) / c.sizeof(c.size_t)
        return: c.LMX_WALK_NOMEM
    if: count != 0U
        have: (cast: (@: size_t) c.calloc(count, c.sizeof(c.size_t)))
    want: (cast: (@: size_t) c.calloc(width, c.sizeof(c.size_t)))
    map: (cast: (@: size_t) c.malloc(2U * width * c.sizeof(c.size_t)))
    if: (count != 0U && have = 0) || want = 0 || map = 0
        c.free((cast: (@: void) have))
        c.free((cast: (@: void) want))
        c.free((cast: (@: void) map))
        return: c.LMX_WALK_NOMEM
    ---
    i: 0U
    while: i < count
        have[i]: lmx_implements_view_name(arena, value, i)
        i: i + 1U
    ---
    while: j < width
        want[j]: lmx_implements_view_name(arena, req, j)
        j: j + 1U
    ---
    j: 0U
    while: j < width
        map[j]: (cast: (size_t) -1)
        map[width + j]: (cast: (size_t) -1)
        ordinal: 0U
        size_t: req_heads 0U
        k: 0U
        while: k < width
            if: lmx_implements_same_name(want[k], want[j]) != 0
                if: k < j
                    ordinal: ordinal + 1U
                ---
                req_heads: req_heads + 1U
            ---
            k: k + 1U
        ---
        seen: 0U
        i: 0U
        while: i < count
            if: lmx_implements_same_name(have[i], want[j]) != 0
                if: seen = ordinal
                    map[j]: i
                map[width + j]: i
                seen: seen + 1U
            ---
            i: i + 1U
        ---
        # Two or more heads in the value: a bare name selects none of them, neither the first nor the last; only an index does (the
        # book, "Карта data").  Two or more in req: no bare use of it exists, every reached use is an index, so both halves are the head's.
        if: want[j] != 0U
            if: req_heads > 1U
                map[width + j]: map[j]
            else:
                if: seen > 1U
                    map[width + j]: (cast: (size_t) -1)
                ---
            ---
        ---
        j: j + 1U
    ---
    c.free((cast: (@: void) have))
    c.free((cast: (@: void) want))
    # Even no matching place is a known physical correspondence: every
    # required edge is a hole. Keep that fact so a demanded missing field
    # becomes NO; do not turn an empty candidate into unavailable evidence.
    out\value: value
    out\req: req
    out\layout: lmx_implements_layout(arena, value)
    out\map: map
    out\n: width
    out\holes: 1
    out\owned_map: 1
    \applied: 1
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_implements_named_view

# The resolver's last resort, where no evidence of any kind relates value to req: name correspondence
# (lmx_implements_named_view), prepared like every other view of this operation.
fn: lmx_implements_named_resolve (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: resolver c.LmxImplResolve; @@: out c.LmxImplEntry; @: out_answer int) int
    c.LmxImplEntry: candidate
    int: applied 0
    int: status
    if: out_answer = 0 || out = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    \out: 0
    status: lmx_implements_named_view(arena, value, req, @ candidate, @ applied, out_answer)
    if: status != c.LMX_WALK_OK || out_answer[0] != c.LMX_IMPLEMENTS_YES
        return: status
    if: applied = 0
        out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
        return: c.LMX_WALK_OK
    return: lmx_implements_prepare_view(arena, resolver, @ candidate, 1, 0, 0, out, out_answer)
end: lmx_implements_named_resolve

# Complete only unset imported coordinates from the ordinary CURRENT
# value/Model correspondence. Existing positive places remain stable.
# Current alternative conflicts are protected: a name match cannot select
# one of two contradictory current coordinate interpretations. This is
# admission-time correspondence, never a later variable/provider lookup.
# Inputs are borrowed. A changed map replaces only caller-owned storage;
# the output mask is a separate allocation owned by the caller.
fn: lmx_implements_fill_holes (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: view c.LmxImplEntry; @: owned int; @: protected_unknown size_t; @@: out_unknown size_t; @: out_answer int) int
    @: part_req_array c.VoidArray 0
    c.LmxImplEntry: fresh
    @: map size_t 0
    @: unknown size_t 0
    size_t: width
    size_t: i 0U
    size_t: index
    size_t: slot
    int: last
    int: found 0
    int: need_fresh 0
    int: fresh_applied 0
    int: fresh_answer c.LMX_IMPLEMENTS_UNKNOWN
    int: changed 0
    int: any_unknown 0
    int: answer
    int: status
    if: out_answer = 0 || out_unknown = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    \out_unknown: 0
    if: view = 0 || owned = 0 || view\value != value || view\req != req || c.lmx_graph_node_in(arena, (cast: (@: void) req)) = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) value)) = 0
        return: c.LMX_WALK_INVALID
    part_req_array: (cast: (@: c.VoidArray) (@ req\array))
    width: part_req_array\size
    status: lmx_implements_view_valid(arena, view, width, @ answer)
    if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        if: status = c.LMX_WALK_OK
            out_answer[0]: answer
        return: status
    while: i < width * 2U
        index: i
        last: 0
        if: i >= width
            index: i - width
            last: 1
        if: lmx_implements_coordinate(arena, view, index, last, @ slot) != 0
            return: c.LMX_WALK_INVALID
        if: slot = (cast: (size_t) -1)
            found: 1
            if: protected_unknown = 0 || protected_unknown[i] = 0U
                need_fresh: 1
        ---
        i: i + 1U
    ---
    if: found = 0
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    c.memset((cast: (@: void) (@ fresh)), 0, c.sizeof(c.LmxImplEntry))
    if: need_fresh != 0
        status: lmx_implements_named_view(arena, value, req, @ fresh, @ fresh_applied, @ fresh_answer)
        if: status != c.LMX_WALK_OK
            return: status
    ---
    map: (cast: (@: size_t) c.malloc(width * 2U * c.sizeof(c.size_t)))
    unknown: (cast: (@: size_t) c.calloc(width * 2U, c.sizeof(c.size_t)))
    if: map = 0 || unknown = 0
        if: fresh\owned_map != 0 && fresh\map != 0
            c.free((cast: (@: void) fresh\map))
        c.free((cast: (@: void) map))
        c.free((cast: (@: void) unknown))
        return: c.LMX_WALK_NOMEM
    ---
    i: 0U
    while: i < width * 2U
        index: i
        last: 0
        if: i >= width
            index: i - width
            last: 1
        if: lmx_implements_coordinate(arena, view, index, last, @ slot) != 0
            status: c.LMX_WALK_INVALID
            break
        if: slot = (cast: (size_t) -1)
            if: protected_unknown != 0 && protected_unknown[i] != 0U
                unknown[i]: 1U
                any_unknown: 1
            else:
                if: fresh_answer = c.LMX_IMPLEMENTS_YES && fresh_applied != 0
                    if: lmx_implements_coordinate(arena, @ fresh, index, last, @ slot) != 0
                        status: c.LMX_WALK_INVALID
                        break
                    if: slot != (cast: (size_t) -1)
                        changed: 1
                    ---
                else:
                    unknown[i]: 1U
                    any_unknown: 1
                ---
            ---
        ---
        map[i]: slot
        i: i + 1U
    ---
    if: status = c.LMX_WALK_OK
        if: changed != 0
            if: \owned != 0 && view\owned_map != 0 && view\map != 0
                c.free((cast: (@: void) view\map))
            view\map: map
            view\frame: 0
            view\at: 0U
            view\n: width
            view\owned_map: 1
            \owned: 1
            map: 0
        ---
        if: any_unknown != 0
            \out_unknown: unknown
            unknown: 0
        ---
        out_answer[0]: c.LMX_IMPLEMENTS_YES
    ---
    if: fresh\owned_map != 0 && fresh\map != 0
        c.free((cast: (@: void) fresh\map))
    c.free((cast: (@: void) map))
    c.free((cast: (@: void) unknown))
    return: status
end: lmx_implements_fill_holes

# The same physical-hole finalization for every current reception, including
# typed SOURCE projections. Established coordinates and protected unknowns stay.
# Both owned inputs transfer even on failure, as for prepare_view itself.
fn: lmx_implements_prepare_current (@: arena c.LmxArena; @: resolver c.LmxImplResolve; @: view c.LmxImplEntry; int: owned; @: unknown size_t; int: unknown_owned; @@: out c.LmxImplEntry; @: out_answer int) int
    @: current_unknown size_t 0
    int: current_owned owned
    int: status
    if: out != 0
        \out: 0
    if: view = 0
        if: unknown_owned != 0 && unknown != 0
            c.free((cast: (@: void) unknown))
        if: out_answer != 0
            out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
        return: c.LMX_WALK_INVALID
    status: lmx_implements_fill_holes(arena, (cast: (@: c.Lmx) view\value), (cast: (@: c.Lmx) view\req), view, @ current_owned, unknown, @ current_unknown, out_answer)
    if: unknown_owned != 0 && unknown != 0
        c.free((cast: (@: void) unknown))
    if: status != c.LMX_WALK_OK || out_answer = 0 || out_answer[0] != c.LMX_IMPLEMENTS_YES
        if: current_owned != 0 && view\owned_map != 0 && view\map != 0
            c.free((cast: (@: void) view\map))
        if: current_unknown != 0
            c.free((cast: (@: void) current_unknown))
        return: status
    return: lmx_implements_prepare_view(arena, resolver, view, current_owned, current_unknown, 1, out, out_answer)
end: lmx_implements_prepare_current

# Resolve addresses only, using existing proofs or prepared correspondences.
# A genuine physical source layout takes precedence over weaker model views.
# With no matching physical template, compose existing bound evidence. Two
# applicable but different projections are UNKNOWN, never "first wins".
fn: lmx_implements_resolved_view (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: source c.Lmx; @: bridge c.LmxImplEntry; @: pending c.LmxImplEntry; size_t: count; @: resolver c.LmxImplResolve; @@: out c.LmxImplEntry; @: out_answer int) int
    @: part_req_array c.VoidArray 0
    @: part_cell_view c.LmxImplEntry 0
    const: (@: part_item_correspondence c.LmxImplEntry)
    @: row_pending_i c.LmxImplEntry
    @: cell c.LmxImplPreparedView
    @: stored c.LmxImplEntry
    const: (@: item c.LmxImplTemplate)
    c.LmxImplEntry: candidate
    c.LmxImplEntry: selected
    c.LmxImplEntry: pair
    c.LmxImplEntry: alternatives
    @: candidate_unknown size_t 0
    @: conflicts size_t 0
    int: alternatives_owned 0
    int: alternatives_found 0
    @: source_layout void
    @: required_layout void
    size_t: i
    size_t: j
    size_t: slot
    size_t: width
    int: have 0
    int: supplied 0
    int: complete 1
    int: owns 0
    int: applied
    int: candidate_answer
    int: failed 0
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status c.LMX_WALK_OK
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: resolver = 0 || out = 0 || (count != 0U && pending = 0)
        return: c.LMX_WALK_INVALID
    \out: 0
    if: c.lmx_graph_node_in(arena, (cast: (@: void) req)) = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) value)) = 0
        return: c.LMX_WALK_INVALID
    part_req_array: (cast: (@: c.VoidArray) (@ req\array))
    width: part_req_array\size
    if: bridge != 0
        c.memset((cast: (@: void) bridge), 0, c.sizeof(c.LmxImplEntry))
    # A typed giving place chooses its own completed correspondence. It
    # neither asserts origin nor authorizes a value with no source evidence.
    if: source != 0
        status: lmx_implements_source_view(arena, value, req, source, resolver, @ candidate, bridge, @ applied, @ candidate_unknown, @ answer)
        if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
            out_answer[0]: answer
            return: status
        if: applied != 0
            status: lmx_implements_accumulate_view(arena, @ selected, @ owns, @ have, @ candidate, (cast: (int) (candidate\owned_map)), width, @ answer)
            i: 0U
            while: status = c.LMX_WALK_OK && answer = c.LMX_IMPLEMENTS_YES && i < count
                row_pending_i: pending + i
                if: row_pending_i\value = value && row_pending_i\req = req
                    status: lmx_implements_accumulate_view(arena, @ selected, @ owns, @ have, pending + i, 0, width, @ answer)
                i: i + 1U
            ---
            stored: lmx_implements_find(arena, value, req)
            if: status = c.LMX_WALK_OK && answer = c.LMX_IMPLEMENTS_YES && stored != 0
                status: lmx_implements_rebase_view(arena, stored, width, @ candidate, @ applied, @ answer)
                if: status = c.LMX_WALK_OK && answer = c.LMX_IMPLEMENTS_YES
                    status: lmx_implements_accumulate_view(arena, @ selected, @ owns, @ have, @ candidate, applied, width, @ answer)
                ---
            ---
            if: status = c.LMX_WALK_OK && answer = c.LMX_IMPLEMENTS_YES
                status: lmx_implements_mask_known(arena, @ selected, width, candidate_unknown)
                if: status = c.LMX_WALK_OK
                    return: lmx_implements_prepare_current(arena, resolver, @ selected, owns, candidate_unknown, 1, out, out_answer)
            ---
            if: owns != 0 && selected\map != 0
                c.free((cast: (@: void) selected\map))
            if: candidate_unknown != 0
                c.free((cast: (@: void) candidate_unknown))
            out_answer[0]: answer
            return: status
        ---
        # A present CURRENT namespace is not an optional hint. If this
        # value has no proved correspondence to it,another old admission
        # cannot silently select a different giving namespace. Exact
        # completed receiving proofs are reused above this resolver.
        return: c.LMX_WALK_OK
    ---
    cell: resolver\views
    while: cell != 0
        if: cell != 0
            part_cell_view: (cast: (@: c.LmxImplEntry) (@ cell\view))
        ---
        if: part_cell_view\value = value && part_cell_view\req = req
            \out: @ cell\view
            out_answer[0]: c.LMX_IMPLEMENTS_YES
            return: c.LMX_WALK_OK
        cell: cell\next
    ---
    # Explicit coordinate promises override an implicit default. Compatible
    # rows of the same pair contribute one union, independently of order.
    i: 0U
    while: i < count
        row_pending_i: pending + i
        if: row_pending_i\value = value && row_pending_i\req = req
            supplied: 1
            status: lmx_implements_accumulate_view(arena, @ selected, @ owns, @ have, pending + i, 0, width, @ answer)
            if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
                failed: 1
                break
            ---
        ---
        i: i + 1U
    ---
    if: failed != 0
        if: owns != 0 && selected\map != 0
            c.free((cast: (@: void) selected\map))
        # Disagreeing valid pending promises do not select a correspondence.
        # Their local NO is not a guaranteed mismatch of this Consumer.
        return: status
    stored: lmx_implements_find(arena, value, req)
    if: stored != 0
        status: lmx_implements_rebase_view(arena, stored, width, @ candidate, @ applied, @ answer)
        if: status = c.LMX_WALK_OK && answer = c.LMX_IMPLEMENTS_YES
            status: lmx_implements_accumulate_view(arena, @ selected, @ owns, @ have, @ candidate, applied, width, @ answer)
        ---
        if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
            if: owns != 0 && selected\map != 0
                c.free((cast: (@: void) selected\map))
            out_answer[0]: answer
            return: status
        ---
        # A completed coordinate set is stable. An incomplete one is a seed,
        # not a veto against newly available, compatible address evidence.
        j: 0U
        while: j < width
            if: lmx_implements_coordinate(arena, @ selected, j, 0, @ slot) != 0
                status: c.LMX_WALK_INVALID
                break
            if: slot = (cast: (size_t) -1)
                complete: 0
                break
            if: lmx_implements_coordinate(arena, @ selected, j, 1, @ slot) != 0
                status: c.LMX_WALK_INVALID
                break
            if: slot = (cast: (size_t) -1)
                complete: 0
                break
            j: j + 1U
        ---
        if: status != c.LMX_WALK_OK
            if: owns != 0 && selected\map != 0
                c.free((cast: (@: void) selected\map))
            return: status
        if: complete != 0
            return: lmx_implements_prepare_current(arena, resolver, @ selected, owns, 0, 0, out, out_answer)
        ---
    ---
    if: supplied != 0
        return: lmx_implements_prepare_current(arena, resolver, @ selected, owns, 0, 0, out, out_answer)
    source_layout: lmx_implements_layout(arena, value)
    required_layout: lmx_implements_layout(arena, req)
    # Explicit physical coordinates take precedence over constructor identity.
    status: lmx_implements_direct_view(arena, value, req, resolver, @ candidate, @ applied, @ answer)
    if: status = c.LMX_WALK_OK && answer = c.LMX_IMPLEMENTS_YES && applied != 0
        status: lmx_implements_accumulate_view(arena, @ selected, @ owns, @ have, @ candidate, (cast: (int) (candidate\owned_map)), width, @ answer)
        if: status = c.LMX_WALK_OK && answer = c.LMX_IMPLEMENTS_YES
            return: lmx_implements_prepare_current(arena, resolver, @ selected, owns, 0, 0, out, out_answer)
    ---
    if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        if: owns != 0 && selected\map != 0
            c.free((cast: (@: void) selected\map))
        out_answer[0]: answer
        return: status
    if: value = req || (source_layout != 0 && source_layout = required_layout) || (have = 0 && resolver\identity_default != 0)
        c.memset((cast: (@: void) (@ candidate)), 0, c.sizeof(c.LmxImplEntry))
        candidate\value: value
        candidate\req: req
        candidate\layout: source_layout
        candidate\n: width
        status: lmx_implements_accumulate_view(arena, @ selected, @ owns, @ have, @ candidate, 0, width, @ answer)
        if: status = c.LMX_WALK_OK && answer = c.LMX_IMPLEMENTS_YES
            return: lmx_implements_prepare_current(arena, resolver, @ selected, owns, 0, 0, out, out_answer)
        if: owns != 0 && selected\map != 0
            c.free((cast: (@: void) selected\map))
        out_answer[0]: answer
        return: status
    ---
    if: required_layout = 0
        if: have != 0
            return: lmx_implements_prepare_current(arena, resolver, @ selected, owns, 0, 0, out, out_answer)
        return: lmx_implements_named_resolve(arena, value, req, resolver, out, out_answer)
    ---
    # No physical template matched. Existing bound alternatives retain their
    # previous ambiguity/compatibility rules;typed source selection never enters here.
    if: failed = 0
        i: 0U
        while: i < resolver\template_count
            item: resolver\templates + i
            i: i + 1U
            if: item\required_layout != required_layout || item\source_layout = 0
                continue
            ---
            if: item != 0
                part_item_correspondence: (cast: (const: @: c.LmxImplEntry) (@ item\correspondence))
            ---
            if: part_item_correspondence\n != width
                answer: c.LMX_IMPLEMENTS_UNKNOWN
                failed: 1
                break
            ---
            c.memset((cast: (@: void) (@ pair)), 0, c.sizeof(c.LmxImplEntry))
            pair\value: value
            pair\req: req
            if: item != 0
                part_item_correspondence: (cast: (const: @: c.LmxImplEntry) (@ item\correspondence))
            ---
            pair\map: part_item_correspondence\map
            if: item != 0
                part_item_correspondence: (cast: (const: @: c.LmxImplEntry) (@ item\correspondence))
            ---
            pair\frame: part_item_correspondence\frame
            if: item != 0
                part_item_correspondence: (cast: (const: @: c.LmxImplEntry) (@ item\correspondence))
            ---
            pair\at: part_item_correspondence\at
            if: item != 0
                part_item_correspondence: (cast: (const: @: c.LmxImplEntry) (@ item\correspondence))
            ---
            pair\n: part_item_correspondence\n
            if: item != 0
                part_item_correspondence: (cast: (const: @: c.LmxImplEntry) (@ item\correspondence))
            ---
            pair\holes: part_item_correspondence\holes
            status: lmx_implements_compose_view(arena, value, (cast: (@: void) item\source_layout), req, @ pair, 0, 1, @ candidate, @ applied, @ candidate_unknown, @ candidate_answer)
            if: status != c.LMX_WALK_OK
                failed: 1
                break
            if: applied = 0
                continue
            if: candidate_answer != c.LMX_IMPLEMENTS_YES
                failed: 1
                break
            ---
            # Existing accepted positive coordinates select the class of
            # bound interpretations. A different class cannot replace them.
            answer: c.LMX_IMPLEMENTS_YES
            if: have != 0
                status: lmx_implements_compatible_map(arena, @ selected, @ candidate, width, @ answer)
            if: status != c.LMX_WALK_OK
                if: candidate\owned_map != 0 && candidate\map != 0
                    c.free((cast: (@: void) candidate\map))
                if: candidate_unknown != 0
                    c.free((cast: (@: void) candidate_unknown))
                    candidate_unknown: 0
                failed: 1
                break
            if: answer = c.LMX_IMPLEMENTS_NO
                if: candidate\owned_map != 0 && candidate\map != 0
                    c.free((cast: (@: void) candidate\map))
                if: candidate_unknown != 0
                    c.free((cast: (@: void) candidate_unknown))
                    candidate_unknown: 0
                continue
            ---
            if: answer = c.LMX_IMPLEMENTS_YES
                status: lmx_implements_alternative_view(arena, @ alternatives, @ alternatives_owned, @ alternatives_found, @ conflicts, @ candidate, (cast: (int) (candidate\owned_map)), candidate_unknown, width, @ answer)
            else:
                if: candidate\owned_map != 0 && candidate\map != 0
                    c.free((cast: (@: void) candidate\map))
                ---
            ---
            if: candidate_unknown != 0
                c.free((cast: (@: void) candidate_unknown))
                candidate_unknown: 0
            if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
                failed: 1
                break
        ---
    ---
    if: alternatives_found != 0
        if: failed = 0
            status: lmx_implements_accumulate_view(arena, @ selected, @ owns, @ have, @ alternatives, alternatives_owned, width, @ answer)
            if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
                failed: 1
            ---
        else:
            if: alternatives_owned != 0 && alternatives\map != 0
                c.free((cast: (@: void) alternatives\map))
            ---
        ---
    ---
    if: have != 0 && failed = 0
        # A previously established positive address resolves that coordinate
        # independently of conditional alternatives. Unresolved alternative
        # holes keep their operation-local annotation through the DFS.
        if: conflicts != 0
            j: 0U
            while: j < width * 2U
                if: j < width
                    status: lmx_implements_coordinate(arena, @ selected, j, 0, @ slot)
                else:
                    status: lmx_implements_coordinate(arena, @ selected, j - width, 1, @ slot)
                if: status != 0
                    status: c.LMX_WALK_INVALID
                    break
                if: slot != (cast: (size_t) -1)
                    conflicts[j]: 0U
                j: j + 1U
            ---
            if: status != c.LMX_WALK_OK
                if: owns != 0 && selected\map != 0
                    c.free((cast: (@: void) selected\map))
                c.free((cast: (@: void) conflicts))
                return: status
            ---
        ---
        return: lmx_implements_prepare_current(arena, resolver, @ selected, owns, conflicts, 1, out, out_answer)
    if: owns != 0 && selected\map != 0
        c.free((cast: (@: void) selected\map))
    if: conflicts != 0
        c.free((cast: (@: void) conflicts))
    ---
    # No evidence of any kind relates value to req: name correspondence. A proof that failed or
    # contradicts another above is never replaced by it.
    if: have = 0 && failed = 0 && alternatives_found = 0
        return: lmx_implements_named_resolve(arena, value, req, resolver, out, out_answer)
    return: status
end: lmx_implements_resolved_view

# Each compared value has its own CURRENT giving namespace. Only address-view
# preparation borrows this pair; the Consumer call queue keeps the operation's
# original callsite context after the pair is restored, including on failure.
fn: lmx_implements_resolved_view_parts (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: source c.Lmx; @: source_references c.Lmx; @: bridge c.LmxImplEntry; @: pending c.LmxImplEntry; size_t: count; @: resolver c.LmxImplResolve; @@: out c.LmxImplEntry; @: out_answer int) int
    @: previous_source c.Lmx
    @: previous_references c.Lmx
    int: status
    if: resolver = 0
        return: c.LMX_WALK_INVALID
    previous_source: resolver\source
    previous_references: resolver\source_references
    resolver\source: source
    resolver\source_references: source_references
    status: lmx_implements_resolved_view(arena, value, req, source, bridge, pending, count, resolver, out, out_answer)
    resolver\source: previous_source
    resolver\source_references: previous_references
    return: status
end: lmx_implements_resolved_view_parts

# Only maps actually prepared by this operation are released here. After a
# successful commit, ownership stays with the exact arena record that kept
# that same allocation; equal-but-already-existing maps do not leak a copy.
fn: lmx_implements_resolve_close (@: arena c.LmxArena; @: resolver c.LmxImplResolve; int: published) int
    @: part_cell_view c.LmxImplEntry 0
    @: cell c.LmxImplPreparedView resolver\views
    @: kept c.LmxImplEntry
    while: cell != 0
        if: cell != 0
            part_cell_view: (cast: (@: c.LmxImplEntry) (@ cell\view))
        ---
        if: cell\release_map != 0 && part_cell_view\owned_map != 0 && part_cell_view\map != 0
            kept: 0
            if: published != 0
                if: cell != 0
                    part_cell_view: (cast: (@: c.LmxImplEntry) (@ cell\view))
                ---
                kept: lmx_implements_find(arena, (cast: (@: c.Lmx) (part_cell_view\value)), (cast: (@: c.Lmx) (part_cell_view\req)))
            if: cell != 0
                part_cell_view: (cast: (@: c.LmxImplEntry) (@ cell\view))
            ---
            if: kept = 0 || kept\map != part_cell_view\map
                if: cell != 0
                    part_cell_view: (cast: (@: c.LmxImplEntry) (@ cell\view))
                ---
                c.free((cast: (@: void) (part_cell_view\map)))
            ---
        ---
        # Unlike a physical map, this mask never belongs to the persistent
        # arena entry. Its lifetime ends here even after a successful commit.
        if: cell\release_unknown != 0 && cell\unknown != 0
            c.free((cast: (@: void) cell\unknown))
        cell: cell\next
    ---
    return: 0
end: lmx_implements_resolve_close



# The required declaration, not its mutable exemplar pointer, supplies the
# pointee contract. Validate the complete ordinary slot_table before selecting a row;
# conflicting declarations are UNKNOWN, not first-wins. A null slot_table carries
# no graph-reference declaration and never authorizes a nested pointer path.
fn: lmx_implements_reference_contract (@: arena c.LmxArena; @: frame c.Lmx; @: req c.Lmx; size_t: field; @@: out c.Lmx; @: out_answer int) int
    @: part_frame_array c.VoidArray 0
    @: layout void lmx_implements_layout(arena, req)
    @: cell void
    @: key void
    @: model c.Lmx
    @@: token char
    @: wide size_t
    size_t: count
    size_t: index
    size_t: at 1U
    @: chosen c.Lmx 0
    int: answer c.LMX_IMPLEMENTS_YES
    if: out = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    \out: 0
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: frame = 0
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    if: frame != 0
        part_frame_array: (cast: (@: c.VoidArray) (@ frame\array))
    ---
    if: c.lmx_graph_node_in(arena, (cast: (@: void) frame)) = 0 || part_frame_array\size < 1U
        return: c.LMX_WALK_INVALID
    cell: c.lmx_graph_value_in(arena, frame, 0U)
    if: lmx_implements_metadata_cell(arena, cell, c.LMX_TYPE_SIZE_T, c.sizeof(c.size_t)) = 0
        return: c.LMX_WALK_INVALID
    wide: (cast: (@: size_t) cell)
    count: \wide
    if: frame != 0
        part_frame_array: (cast: (@: c.VoidArray) (@ frame\array))
    ---
    if: count > (part_frame_array\size - 1U) / 3U || part_frame_array\size != 1U + count * 3U
        return: c.LMX_WALK_INVALID
    while: count != 0U
        cell: c.lmx_graph_value_in(arena, frame, at)
        if: lmx_implements_metadata_cell(arena, cell, c.LMX_TYPE_CHAR_PTR, sizeof(@: char)) = 0
            return: c.LMX_WALK_INVALID
        token: (cast: (@@: char) cell)
        key: (cast: (@: void) \token)
        cell: c.lmx_graph_value_in(arena, frame, at + 1U)
        if: key = 0 || lmx_implements_metadata_cell(arena, cell, c.LMX_TYPE_SIZE_T, c.sizeof(c.size_t)) = 0
            return: c.LMX_WALK_INVALID
        wide: (cast: (@: size_t) cell)
        index: \wide
        model: c.lmx_graph_node_in(arena, c.lmx_graph_value_in(arena, frame, at + 2U))
        if: model = 0
            return: c.LMX_WALK_INVALID
        if: key = layout && index = field
            if: chosen != 0 && chosen != model
                answer: c.LMX_IMPLEMENTS_UNKNOWN
                chosen: 0
            ---
            # Valid conflicting rows do not make the carrier malformed.
            # Validate its remaining rows, but never pick a later winner.
            if: answer = c.LMX_IMPLEMENTS_YES
                chosen: model
            ---
        ---
        at: at + 3U
        count: count - 1U
    ---
    \out: chosen
    out_answer[0]: answer
    return: c.LMX_WALK_OK
end: lmx_implements_reference_contract

# Storage classification only. A boxed reference's payload is not read just
# to select the declaration namespace used by a consumed interface edge.
fn: lmx_implements_low_reference_type (@: arena c.LmxArena; @: cell void) int
    int: type
    int: base
    if: cell = 0 || lmx_domain_kind(arena, cell) != c.LMX_KIND_PRIMITIVE
        return: c.LMX_TYPE_NONE
    type: lmx_domain_type(arena, cell)
    base: c.lmx_type_base(type)
    if: base = c.LMX_TYPE_LMX || base = c.LMX_TYPE_DESC
        return: type
    return: c.LMX_TYPE_NONE
end: lmx_implements_low_reference_type

# The same for a candidate's field under a Structure requirement: a typed reference holding a Structure stands for it, and the narrowing search goes
# on through it to any depth (the book, #three-argument-implements; IMPLEMENTS-REFERENCE-FIELD-NESTED-MODEL).  Holding a null or a pointer to anything else
# proves nothing of the kind.
fn: lmx_implements_low_candidate (@: arena c.LmxArena; @: cell void) int
    int: low lmx_implements_low_reference_type(arena, cell)
    int: base
    @: value void
    if: low != c.LMX_TYPE_NONE || cell = 0 || lmx_domain_kind(arena, cell) != c.LMX_KIND_PRIMITIVE
        return: low
    base: c.lmx_type_base(lmx_domain_type(arena, cell))
    if: base < c.LMX_TYPE_POINTER_BASE || base >= c.LMX_TYPE_ARRAY_OF_POINTER_BASE || c.lmx_pointer_pool_in(arena, cell) = 0
        return: low
    value: c.lmx_pointer_value_in(arena, cell)
    if: value = 0 || lmx_domain_kind(arena, value) != c.LMX_KIND_STRUCT
        return: low
    return: lmx_domain_type(arena, cell)
end: lmx_implements_low_candidate

# A declared Model comes from saved context or the ordinary declaration sheet,
# never from the mutable/default pointer payload. Snapshot metadata through
# the existing context operation, without invoking a pointer read callback.
fn: lmx_implements_low_model (@: arena c.LmxArena; @: owner c.Lmx; size_t: field; @: cell void; @: references c.Lmx; @@: out c.Lmx; @@: out_references c.Lmx; @: out_answer int) int
    c.LmxWalkValue: saved
    int: status
    if: out = 0 || out_references = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    \out: 0
    \out_references: references
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: lmx_implements_low_reference_type(arena, cell) = c.LMX_TYPE_NONE || c.lmx_pointer_pool_in(arena, cell) = 0
        return: c.LMX_WALK_OK
    c.memset((cast: (@: void) (@ saved)), 0, c.sizeof(c.LmxWalkValue))
    c.lmx_value_context_copy(@ saved, c.lmx_pointer_cell_context(arena, cell))
    if: saved\model != 0
        if: c.lmx_graph_node_in(arena, (cast: (@: void) saved\model)) = 0
            return: c.LMX_WALK_OK
        if: saved\references != 0 && c.lmx_graph_node_in(arena, (cast: (@: void) saved\references)) = 0
            return: c.LMX_WALK_OK
        \out: (cast: (@: c.Lmx) saved\model)
        \out_references: (cast: (@: c.Lmx) saved\references)
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    ---
    status: lmx_implements_reference_contract(arena, references, owner, field, out, out_answer)
    if: status = c.LMX_WALK_OK && \out = 0
        out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    return: status
end: lmx_implements_low_model

# One typed field producer, shared by full-contract preparation, dependency
# validation and the used-interface DFS. It reads declarations, never candidate
# pointer values, names, or another interpretation of a source path.
fn: lmx_implements_contract_field (@: arena c.LmxArena; @: owner c.Lmx; size_t: field; int: interface; @: references c.Lmx; @: out c.LmxImplContractFact; @: out_answer int) int
    @: part_owner_array c.VoidArray 0
    @: cell void
    int: kind
    int: type
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: out = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) owner)) = 0
        return: c.LMX_WALK_INVALID
    c.memset((cast: (@: void) out), 0, c.sizeof(c.LmxImplContractFact))
    out\owner: owner
    out\field: field
    if: field = (cast: (size_t) -1)
        out\kind: lmx_domain_kind(arena, (cast: (@: void) owner))
        out\type: lmx_domain_type(arena, (cast: (@: void) owner))
        if: out\kind = c.LMX_KIND_STRUCT
            if: owner != 0
                part_owner_array: (cast: (@: c.VoidArray) (@ owner\array))
            ---
            out\extent: part_owner_array\size
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    ---
    if: owner != 0
        part_owner_array: (cast: (@: c.VoidArray) (@ owner\array))
    ---
    if: field >= part_owner_array\size
        return: c.LMX_WALK_INVALID
    cell: c.lmx_graph_value_in(arena, owner, field)
    out\cell: cell
    if: cell = 0
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    kind: lmx_domain_kind(arena, cell)
    type: lmx_domain_type(arena, cell)
    if: kind = c.LMX_KIND_NONE
        return: c.LMX_WALK_INVALID
    out\kind: kind
    out\type: type
    if: kind = c.LMX_KIND_STRUCT
        if: interface != 0 && lmx_domain_kind(arena, c.lmx_graph_value_in(arena, (cast: (@: c.Lmx) cell), 0U)) = c.LMX_DOMAIN_KIND_OP
            out\executable: 1
        else:
            out\child: (cast: (@: c.Lmx) cell)
        ---
    ---
    if: kind = c.LMX_KIND_PRIMITIVE && type >= c.LMX_TYPE_POINTER_BASE && type < c.LMX_TYPE_ARRAY_OF_POINTER_BASE
        return: lmx_implements_reference_contract(arena, references, owner, field, (cast: (@@: c.Lmx) @ out\reference), out_answer)
    ---
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_implements_contract_field

fn: lmx_implements_contract_append (@: contract c.LmxImplContract; @: fact c.LmxImplContractFact) int
    @: part_contract_facts c.LmxImplContractFactDynamicArray 0
    @: part_part_contract_facts_array c.LmxImplContractFactArray 0
    if: contract != 0
        part_contract_facts: (cast: (@: c.LmxImplContractFactDynamicArray) (@ contract\facts))
    ---
    if: part_contract_facts != 0
        part_part_contract_facts_array: (cast: (@: c.LmxImplContractFactArray) (@ part_contract_facts\array))
    ---
    size_t: count part_part_contract_facts_array\len
    if: contract != 0
        part_contract_facts: (cast: (@: c.LmxImplContractFactDynamicArray) (@ contract\facts))
    ---
    size_t: capacity part_contract_facts\capacity
    if: contract != 0
        part_contract_facts: (cast: (@: c.LmxImplContractFactDynamicArray) (@ contract\facts))
    ---
    if: part_contract_facts != 0
        part_part_contract_facts_array: (cast: (@: c.LmxImplContractFactArray) (@ part_contract_facts\array))
    ---
    @: rows c.LmxImplContractFact part_part_contract_facts_array\data
    @: grown c.LmxImplContractFact
    if: count = (cast: (size_t) -1)
        return: c.LMX_WALK_NOMEM
    if: count >= capacity
        if: capacity = 0U
            capacity: 8U
        else:
            if: capacity > ((cast: (size_t) -1) / 2U)
                return: c.LMX_WALK_NOMEM
            capacity: capacity * 2U
        ---
        if: capacity > ((cast: (size_t) -1) / c.sizeof(c.LmxImplContractFact))
            return: c.LMX_WALK_NOMEM
        grown: (cast: (@: c.LmxImplContractFact) c.realloc((cast: (@: void) rows), capacity * c.sizeof(c.LmxImplContractFact)))
        if: grown = 0
            return: c.LMX_WALK_NOMEM
        rows: grown
        if: contract != 0
            part_contract_facts: (cast: (@: c.LmxImplContractFactDynamicArray) (@ contract\facts))
        ---
        if: part_contract_facts != 0
            part_part_contract_facts_array: (cast: (@: c.LmxImplContractFactArray) (@ part_contract_facts\array))
        ---
        part_part_contract_facts_array\data: rows
        if: contract != 0
            part_contract_facts: (cast: (@: c.LmxImplContractFactDynamicArray) (@ contract\facts))
        ---
        part_contract_facts\capacity: capacity
    ---
    rows[count]: \fact
    if: contract != 0
        part_contract_facts: (cast: (@: c.LmxImplContractFactDynamicArray) (@ contract\facts))
    ---
    if: part_contract_facts != 0
        part_part_contract_facts_array: (cast: (@: c.LmxImplContractFactArray) (@ part_contract_facts\array))
    ---
    part_part_contract_facts_array\len: count + 1U
    return: c.LMX_WALK_OK
end: lmx_implements_contract_append

fn: lmx_implements_contract_owner (@: arena c.LmxArena; @: contract c.LmxImplContract; @: owner c.Lmx) int
    @: part_contract_facts c.LmxImplContractFactDynamicArray 0
    @: part_part_contract_facts_array c.LmxImplContractFactArray 0
    @: row_rows_i c.LmxImplContractFact
    size_t: i 0U
    if: contract != 0
        part_contract_facts: (cast: (@: c.LmxImplContractFactDynamicArray) (@ contract\facts))
    ---
    if: part_contract_facts != 0
        part_part_contract_facts_array: (cast: (@: c.LmxImplContractFactArray) (@ part_contract_facts\array))
    ---
    size_t: count part_part_contract_facts_array\len
    if: contract != 0
        part_contract_facts: (cast: (@: c.LmxImplContractFactDynamicArray) (@ contract\facts))
    ---
    if: part_contract_facts != 0
        part_part_contract_facts_array: (cast: (@: c.LmxImplContractFactArray) (@ part_contract_facts\array))
    ---
    @: rows c.LmxImplContractFact part_part_contract_facts_array\data
    c.LmxImplContractFact: fact
    int: status
    int: answer
    while: i < count
        row_rows_i: rows + i
        if: row_rows_i\owner = owner && row_rows_i\field = (cast: (size_t) -1)
            return: 0
        i: i + 1U
    ---
    # Header facts do not read reference rows or candidate values. A decoded
    # header is fully known; propagate a physical failure before appending it.
    status: lmx_implements_contract_field(arena, owner, (cast: (size_t) -1), 1, 0, @ fact, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    return: lmx_implements_contract_append(contract, @ fact)
end: lmx_implements_contract_owner

# The same fact array is the finite model-closure work list. Header facts
# name model extents; field facts retain their prepared types and edges.
# No depth bound, candidate exemplar, graph clone, or untyped byte hash.
fn: lmx_implements_contract_prepare (@: arena c.LmxArena; @: req c.Lmx; @: references c.Lmx; @@: out c.LmxImplContract; @: out_answer int) int
    @: part_contract_facts c.LmxImplContractFactDynamicArray 0
    @: part_part_contract_facts_array c.LmxImplContractFactArray 0
    @: row_rows_i c.LmxImplContractFact
    @: contract c.LmxImplContract
    @: ignored c.Lmx
    @: owner c.Lmx
    @: child c.Lmx
    @: reference c.Lmx
    @: rows c.LmxImplContractFact
    c.LmxImplContractFact: fact
    size_t: i 0U
    size_t: field
    size_t: width
    int: status c.LMX_WALK_OK
    int: answer c.LMX_IMPLEMENTS_YES
    int: fact_type
    if: out = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    \out: 0
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    status: lmx_implements_reference_contract(arena, references, req, (cast: (size_t) -1), @ ignored, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    if: answer != c.LMX_IMPLEMENTS_YES
        out_answer[0]: answer
        return: c.LMX_WALK_OK
    contract: (cast: (@: c.LmxImplContract) c.calloc(1U, c.sizeof(c.LmxImplContract)))
    if: contract = 0
        return: c.LMX_WALK_NOMEM
    contract\owners: 1U
    contract\interface: 1
    status: lmx_implements_contract_owner(arena, contract, req)
    if: contract != 0
        part_contract_facts: (cast: (@: c.LmxImplContractFactDynamicArray) (@ contract\facts))
    ---
    if: part_contract_facts != 0
        part_part_contract_facts_array: (cast: (@: c.LmxImplContractFactArray) (@ part_contract_facts\array))
    ---
    while: status = c.LMX_WALK_OK && answer = c.LMX_IMPLEMENTS_YES && i < part_part_contract_facts_array\len
        if: contract != 0
            part_contract_facts: (cast: (@: c.LmxImplContractFactDynamicArray) (@ contract\facts))
        ---
        if: part_contract_facts != 0
            part_part_contract_facts_array: (cast: (@: c.LmxImplContractFactArray) (@ part_contract_facts\array))
        ---
        rows: part_part_contract_facts_array\data
        row_rows_i: rows + i
        if: row_rows_i\field != (cast: (size_t) -1) || row_rows_i\kind != c.LMX_KIND_STRUCT
            i: i + 1U
            continue
        ---
        row_rows_i: rows + i
        owner: row_rows_i\owner
        row_rows_i: rows + i
        width: row_rows_i\extent
        field: 0U
        while: field < width
            status: lmx_implements_contract_field(arena, owner, field, 1, references, @ fact, @ answer)
            if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
                break
            # Physical facts do not snapshot a boxed Value's current Model
            # or its reference sheet. This optional cache remains unavailable;
            # the ordinary receiving walk still checks the actual used fields.
            fact_type: fact\type
            if: fact\kind = c.LMX_KIND_PRIMITIVE && (c.lmx_type_base(fact_type) = c.LMX_TYPE_LMX || c.lmx_type_base(fact_type) = c.LMX_TYPE_DESC)
                answer: c.LMX_IMPLEMENTS_UNKNOWN
                break
            ---
            status: lmx_implements_contract_append(contract, @ fact)
            if: status != c.LMX_WALK_OK
                break
            ---
            # Parent dependency precedes child headers even after realloc.
            child: fact\child
            reference: fact\reference
            if: child != 0
                status: lmx_implements_contract_owner(arena, contract, child)
            if: status = c.LMX_WALK_OK && reference != 0
                status: lmx_implements_contract_owner(arena, contract, reference)
            if: status != c.LMX_WALK_OK
                break
            field: field + 1U
        ---
        i: i + 1U
    ---
    if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        c.lmx_arena_impl_contract_release(contract)
        out_answer[0]: answer
        return: status
    \out: contract
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_implements_contract_prepare

# Validate current dependencies at the already prepared addresses. Primitive
# values and pointer defaults do not participate; changed types, extents,
# model edges and declared pointees do. Physical classification by itself
# is not a new required type; declared pointees are selected by the same
# reference-contract producer above. A changed valid
# requirement is NO (prepare a new admission). Decode/resource failures use
# the separate operation status and never masquerade as a cache verdict.
fn: lmx_implements_contract_matches (@: arena c.LmxArena; @: contract c.LmxImplContract; @: req c.Lmx; @: references c.Lmx; @: out_answer int) int
    @: part_contract_facts c.LmxImplContractFactDynamicArray 0
    @: part_part_contract_facts_array c.LmxImplContractFactArray 0
    @: row_rows_0 c.LmxImplContractFact
    @: ignored c.Lmx
    c.LmxImplContractFact: current
    @: old c.LmxImplContractFact
    @: rows c.LmxImplContractFact
    size_t: i 0U
    size_t: count
    @: owner c.Lmx
    size_t: field
    int: status
    int: current_type
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: contract != 0
        part_contract_facts: (cast: (@: c.LmxImplContractFactDynamicArray) (@ contract\facts))
    ---
    if: part_contract_facts != 0
        part_part_contract_facts_array: (cast: (@: c.LmxImplContractFactArray) (@ part_contract_facts\array))
    ---
    if: contract = 0
        out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    if: part_part_contract_facts_array\len > part_contract_facts\capacity || (part_part_contract_facts_array\len != 0U && part_part_contract_facts_array\data = 0)
        return: c.LMX_WALK_INVALID
    if: contract\interface != 1 || part_part_contract_facts_array\len = 0U
        out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    if: contract != 0
        part_contract_facts: (cast: (@: c.LmxImplContractFactDynamicArray) (@ contract\facts))
    ---
    if: part_contract_facts != 0
        part_part_contract_facts_array: (cast: (@: c.LmxImplContractFactArray) (@ part_contract_facts\array))
    ---
    rows: part_part_contract_facts_array\data
    if: contract != 0
        part_contract_facts: (cast: (@: c.LmxImplContractFactDynamicArray) (@ contract\facts))
    ---
    if: part_contract_facts != 0
        part_part_contract_facts_array: (cast: (@: c.LmxImplContractFactArray) (@ part_contract_facts\array))
    ---
    count: part_part_contract_facts_array\len
    row_rows_0: rows
    if: row_rows_0\owner != req || row_rows_0\field != (cast: (size_t) -1)
        out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    status: lmx_implements_reference_contract(arena, references, req, (cast: (size_t) -1), @ ignored, out_answer)
    if: status != c.LMX_WALK_OK || out_answer[0] != c.LMX_IMPLEMENTS_YES
        return: status
    while: i < count
        old: rows + i
        owner: old\owner
        field: old\field
        status: lmx_implements_contract_field(arena, owner, field, 1, references, @ current, out_answer)
        if: status != c.LMX_WALK_OK || out_answer[0] != c.LMX_IMPLEMENTS_YES
            return: status
        current_type: current\type
        if: (old\kind = c.LMX_KIND_PRIMITIVE && (c.lmx_type_base(old\type) = c.LMX_TYPE_LMX || c.lmx_type_base(old\type) = c.LMX_TYPE_DESC)) || (current\kind = c.LMX_KIND_PRIMITIVE && (c.lmx_type_base(current_type) = c.LMX_TYPE_LMX || c.lmx_type_base(current_type) = c.LMX_TYPE_DESC))
            out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
            return: c.LMX_WALK_OK
        if: current\kind != old\kind || current\type != old\type || current\extent != old\extent || current\child != old\child || current\reference != old\reference || current\executable != old\executable
            out_answer[0]: c.LMX_IMPLEMENTS_NO
            return: c.LMX_WALK_OK
        i: i + 1U
    ---
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_implements_contract_matches

fn: lmx_implements_contract_get (@: contract c.LmxImplContract; @: owner c.Lmx; size_t: field; @: out c.LmxImplContractFact; @: out_answer int) int
    @: part_contract_facts c.LmxImplContractFactDynamicArray 0
    @: part_part_contract_facts_array c.LmxImplContractFactArray 0
    @: row_rows_i c.LmxImplContractFact
    size_t: i 0U
    @: rows c.LmxImplContractFact
    if: out != 0
        c.memset((cast: (@: void) out), 0, c.sizeof(c.LmxImplContractFact))
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: contract != 0
        part_contract_facts: (cast: (@: c.LmxImplContractFactDynamicArray) (@ contract\facts))
    ---
    if: part_contract_facts != 0
        part_part_contract_facts_array: (cast: (@: c.LmxImplContractFactArray) (@ part_contract_facts\array))
    ---
    if: contract = 0 || out = 0 || part_part_contract_facts_array\len > part_contract_facts\capacity
        return: c.LMX_WALK_INVALID
    if: contract != 0
        part_contract_facts: (cast: (@: c.LmxImplContractFactDynamicArray) (@ contract\facts))
    ---
    if: part_contract_facts != 0
        part_part_contract_facts_array: (cast: (@: c.LmxImplContractFactArray) (@ part_contract_facts\array))
    ---
    rows: part_part_contract_facts_array\data
    if: part_part_contract_facts_array\len != 0U && rows = 0
        return: c.LMX_WALK_INVALID
    if: contract != 0
        part_contract_facts: (cast: (@: c.LmxImplContractFactDynamicArray) (@ contract\facts))
    ---
    if: part_contract_facts != 0
        part_part_contract_facts_array: (cast: (@: c.LmxImplContractFactArray) (@ part_contract_facts\array))
    ---
    while: i < part_part_contract_facts_array\len
        row_rows_i: rows + i
        if: row_rows_i\owner = owner && row_rows_i\field = field
            \out: rows[i]
            out_answer[0]: c.LMX_IMPLEMENTS_YES
            return: c.LMX_WALK_OK
        i: i + 1U
    ---
    return: c.LMX_WALK_OK
end: lmx_implements_contract_get

# A written call of a field by its Consumer (book §7, #three-argument-implements: "If Consumer explicitly invokes a
# field, only the written calls are checked"; Q49). The coverage marks such a field called (below SIZE_MAX - 1),
# and the candidate's value there must take the call its caller forms. The caller forms that call from the
# requirement's description of the field: its args part is the inputs it supplies by position, its return part the
# result it reads. Each occurrence selects its own args and return source edges
# through its proved execution map. Only the header is read; nothing is executed.
#
# This is Q49's directional check in its current implementation state, not equality of two signatures as a rule:
# - the formed call passes exactly the requirement's inputs (refs[j], nargs) and forms no omitted input of the
#   candidate from a default, so the candidate's args part has the requirement's width (defaults, dynamic inputs and
#   conversions are OPEN);
# - each input and the result keep their transport: one kind and one type;
# - an input position that holds another object than the requirement's (a Structure formal of another model, a
#   callable formal of another description) is not decided here: the selected callee's formal receives the value the
#   call supplies there at its entry, before its body runs, by its own receiving record, native and walked
#   (`received`, the args part). That reception is the formal's, whatever the formal is: a Structure formal's is its
#   model's admission (lmx_walk_value_admit); a callable formal's asks the callable for the calls the callee's body
#   writes, which its translation proved for every callable it follows and refused for one it does not, and a formal
#   the body does not call asks nothing;
# - a result position has no such reception, so another object there is UNKNOWN (`received` 0, the return part);
# - declared exits are not described at run time (OPEN);
# - a call that reads no result takes a candidate that gives one: the callee drops it (dest = 0).
# Decode only an explicitly selected callable args/return part. Ordinary
# Structures of width2 elsewhere are NOT classified as signature entries.
# Empty SOURCE (kernel ABI) and empty witness (native-only by-value storage)
# remain distinct. Actual fn inputs have four fields: SOURCE,witness,current
# default,own receiving record. Legacy/PRIM/prototype entries have two.
# This is physical decoding, never an admission result.
fn: lmx_callable_entry (@: arena c.LmxArena; @: part c.Lmx; size_t: index; @@: source void; @@: witness void) int
    if: source = 0 || witness = 0
        return: 1
    source[0]: 0
    witness[0]: 0
    if: arena = 0 || part = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) part)) != part || lmx_domain_kind(arena, (cast: (@: void) part)) != c.LMX_KIND_STRUCT
        return: 1
    @: fields c.VoidArray @ part\array
    if: index >= fields\size
        return: 1
    @: entry c.Lmx c.lmx_graph_node_in(arena, c.lmx_graph_value_in(arena, part, index))
    if: entry = 0 || lmx_domain_kind(arena, (cast: (@: void) entry)) != c.LMX_KIND_STRUCT
        return: 1
    @: pair c.VoidArray @ entry\array
    # Written formals have four fields. A hidden capture can retain its
    # receiving operation after the ordinary SOURCE and physical witness.
    if: pair\size != 2U && pair\size != 3U && pair\size != 4U
        return: 1
    @: declared void c.lmx_graph_value_in(arena, entry, 0U)
    @: physical void c.lmx_graph_value_in(arena, entry, 1U)
    if: declared != 0 && lmx_domain_kind(arena, declared) = c.LMX_KIND_NONE
        return: 1
    if: physical != 0 && lmx_domain_kind(arena, physical) = c.LMX_KIND_NONE
        return: 1
    source[0]: declared
    witness[0]: physical
    return: 0
end: lmx_callable_entry

# A callable's declaration coordinates use only the ORDINAL half of its
# existing execution projection. A count of zero is valid; failure is not.
# This is decoding, not an interface check or a new correspondence.
fn: lmx_callable_source_count (@: arena c.LmxArena; @: part c.Lmx; @: out size_t) int
    @: self c.LmxImplEntry 0
    if: out = 0
        return: 1
    out[0]: 0U
    if: arena = 0 || part = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) part)) != part
        return: 1
    @: fields c.VoidArray @ part\array
    out[0]: (cast: (size_t) fields\size)
    self: lmx_implements_find(arena, part, part)
    if: self != 0 && self\exec_map != 0
        out[0]: (cast: (size_t) self\exec_n)
    return: 0
end: lmx_callable_source_count

# Only a selected args/return part holds physical [SOURCE,witness] pairs.
# Check its SOURCE bound before exec_slot: edge=count is LAST, not an input.
fn: lmx_callable_source_entry (@: arena c.LmxArena; @: part c.Lmx; size_t: index; @@: source void; @@: witness void) int
    size_t: count 0U
    size_t: physical 0U
    if: source = 0 || witness = 0
        return: 1
    source[0]: 0
    witness[0]: 0
    if: lmx_callable_source_count(arena, part, @ count) != 0 || index >= count
        return: 1
    physical: lmx_implements_exec_index(arena, part, index)
    if: physical = (cast: (size_t) -1)
        return: 1
    return: lmx_callable_entry(arena, part, physical, source, witness)
end: lmx_callable_source_entry

# Physical adapter for an already selected code's complete SOURCE input
# vector. Header projection is read by the same ordinal accessors as calls;
# physical header width is not argument arity. No signature/body permission,
# name search, default inference or value conversion is performed here.
# Output storage is caller-owned and separate from the borrowed input spans.
fn: lmx_callable_input_refs (@: arena c.LmxArena; @: code c.Lmx; @@: args void; size_t: n; @@: supplied void; size_t: supplied_count; @@: all void; size_t: capacity; @: out_count size_t) int
    @: part c.Lmx 0
    size_t: source_count 0U
    size_t: physical 0U
    size_t: width 0U
    size_t: k 0U
    @: pointer_probe void 0
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    if: out_count = 0
        return: c.LMX_WALK_INVALID
    out_count[0]: 0U
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: (n != 0U && args = 0) || (supplied_count != 0U && supplied = 0)
        return: c.LMX_WALK_INVALID
    if: lmx_callable_source_count(arena, code, @ source_count) != 0 || source_count = 0U
        return: c.LMX_WALK_UNSUPPORTED
    status: lmx_implements_exec_slot(arena, code, 0U, @ physical, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    if: answer = c.LMX_IMPLEMENTS_UNKNOWN
        return: c.LMX_WALK_UNSUPPORTED
    if: answer != c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_INVALID
    part: c.lmx_graph_ref_struct_in(arena, code, physical)
    if: part = 0 || lmx_callable_source_count(arena, part, @ width) != 0
        return: c.LMX_WALK_UNSUPPORTED
    if: width < n || width > capacity || supplied_count > width - n
        return: c.LMX_WALK_INVALID
    if: width > (cast: (size_t) -1) / sizeof(pointer_probe)
        return: c.LMX_WALK_NOMEM
    if: width != 0U && all = 0
        return: c.LMX_WALK_INVALID
    while: k < width
        all[k]: 0
        if: k < n
            all[k]: args[k]
        if: k >= n && k - n < supplied_count
            all[k]: supplied[k - n]
        k: k + 1U
    ---
    out_count[0]: width
    return: c.LMX_WALK_OK
end: lmx_callable_input_refs

# The selected formal's own CURRENT receiving record, reached numerically.
# A legacy entry, partial projection or missing link stays unavailable.
# The record is the ordinary instruction's existing object; its coverage
# and requirements are decoded by the same receiving worker when consumed.
fn: lmx_callable_source_receiving (@: arena c.LmxArena; @: selected_args c.Lmx; size_t: index; @@: out c.Lmx; @: out_answer int) int
    @: entry c.Lmx 0
    @: fields c.VoidArray 0
    @: record c.Lmx 0
    size_t: count 0U
    size_t: physical (cast: (size_t) -1)
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    if: out = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    out[0]: 0
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: lmx_callable_source_count(arena, selected_args, @ count) != 0 || index >= count
        return: c.LMX_WALK_OK
    status: lmx_implements_exec_coordinate(arena, selected_args, index, @ physical, @ answer)
    if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        return: status
    entry: c.lmx_graph_node_in(arena, c.lmx_graph_value_in(arena, selected_args, physical))
    if: entry = 0
        return: c.LMX_WALK_OK
    fields: @ entry\array
    if: fields\size != 4U
        return: c.LMX_WALK_OK
    record: c.lmx_graph_ref_struct_in(arena, entry, 3U)
    if: record = 0
        return: c.LMX_WALK_OK
    out[0]: record
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_callable_source_receiving

# Select only an existing receiver-produced fn's args/return headers.
# Pool role is its existing value classification, not a spelling match or
# a new fn marker. Ordinary data with two/four fields is not a signature.
# Unavailable role/header/projection stays U; this reader neither rejects
# ordinary Structure execution nor grants permission to enter a descriptor.
# Only SOURCE edges0/1 are consumed; vars/body are not inspected.
fn: lmx_callable_headers (@: arena c.LmxArena; @: selected c.Lmx; @@: out_args c.Lmx; @@: out_returns c.Lmx; @: out_answer int) int
    @: pool c.LmxPool 0
    @: args c.Lmx 0
    @: returns c.Lmx 0
    size_t: count 0U
    size_t: args_at (cast: (size_t) -1)
    size_t: returns_at (cast: (size_t) -1)
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    if: out_args = 0 || out_returns = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    out_args[0]: 0
    out_returns[0]: 0
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: c.lmx_graph_node_in(arena, (cast: (@: void) selected)) = 0
        return: c.LMX_WALK_OK
    pool: c.lmx_range_cell_pool(arena, (cast: (@: void) selected))
    if: pool = 0 || pool\role != c.LMX_POOL_ROLE_FN
        return: c.LMX_WALK_OK
    # A `fn` has four parts, its return header at edge 1; a `sub` three, and no return header: it returns no value (lmx_callable_part).
    if: lmx_callable_source_count(arena, selected, @ count) != 0 || (count != 4U && count != 3U)
        return: c.LMX_WALK_OK
    status: lmx_implements_exec_coordinate(arena, selected, 0U, @ args_at, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    if: answer = c.LMX_IMPLEMENTS_YES
        args: c.lmx_graph_node_in(arena, c.lmx_graph_value_in(arena, selected, args_at))
    if: count = 4U
        status: lmx_implements_exec_coordinate(arena, selected, 1U, @ returns_at, @ answer)
        if: status != c.LMX_WALK_OK
            return: status
        if: answer = c.LMX_IMPLEMENTS_YES
            returns: c.lmx_graph_node_in(arena, c.lmx_graph_value_in(arena, selected, returns_at))
        ---
    # Independent known edges survive an unrelated unavailable header.
    out_args[0]: args
    out_returns[0]: returns
    if: args != 0 && (returns != 0 || count = 3U)
        out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_callable_headers

fn: lmx_implements_call_positions (@: arena c.LmxArena; @: have c.Lmx; @: want c.Lmx; int: received) int
    size_t: want_count 0U
    size_t: j 0U
    @: a void
    @: b void
    @: source_a void 0
    @: source_b void 0
    int: kind
    int: type
    if: lmx_callable_source_count(arena, want, @ want_count) != 0
        return: c.LMX_IMPLEMENTS_UNKNOWN
    while: j < want_count
        if: lmx_callable_source_entry(arena, have, j, @ source_a, @ a) != 0 || lmx_callable_source_entry(arena, want, j, @ source_b, @ b) != 0
            return: c.LMX_IMPLEMENTS_UNKNOWN
        ---
        if: b = 0
            return: c.LMX_IMPLEMENTS_UNKNOWN
        if: a = 0
            return: c.LMX_IMPLEMENTS_NO
        kind: lmx_domain_kind(arena, b)
        type: lmx_domain_type(arena, b)
        if: kind = c.LMX_KIND_NONE || lmx_domain_kind(arena, a) = c.LMX_KIND_NONE
            return: c.LMX_IMPLEMENTS_UNKNOWN
        if: lmx_domain_kind(arena, a) != kind || lmx_domain_type(arena, a) != type
            return: c.LMX_IMPLEMENTS_NO
        if: kind = c.LMX_KIND_PRIMITIVE && type >= c.LMX_TYPE_POINTER_BASE && type < c.LMX_TYPE_ARRAY_OF_POINTER_BASE
            if: c.lmx_pointer_pool_in(arena, a) = 0 || c.lmx_pointer_pool_in(arena, b) = 0
                return: c.LMX_IMPLEMENTS_UNKNOWN
            if: c.lmx_pointer_value_in(arena, a) != c.lmx_pointer_value_in(arena, b)
                return: c.LMX_IMPLEMENTS_UNKNOWN
        ---
        if: kind != c.LMX_KIND_PRIMITIVE && a != b && received = 0
            return: c.LMX_IMPLEMENTS_UNKNOWN
        j: j + 1U
    ---
    return: c.LMX_IMPLEMENTS_YES
end: lmx_implements_call_positions

# Resolve an explicitly named input during admission only. Missing names or
# SOURCE places are unavailable evidence. A known match remains a known
# coordinate even when other names are unavailable; out_answer is then U.
# Two known same-named formals are a guaranteed ambiguous named invocation.
fn: lmx_callable_named_formal (@: arena c.LmxArena; @: args c.Lmx; size_t: wanted; @: out_source size_t; @: out_physical size_t; @: out_answer int) int
    size_t: name 0U
    size_t: count 0U
    size_t: i 0U
    size_t: physical (cast: (size_t) -1)
    size_t: found (cast: (size_t) -1)
    size_t: found_physical (cast: (size_t) -1)
    int: uncertain 0
    int: answer
    int: status
    if: out_source = 0 || out_physical = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    out_source[0]: (cast: (size_t) -1)
    out_physical[0]: (cast: (size_t) -1)
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: wanted = 0U
        return: c.LMX_WALK_OK
    if: lmx_callable_source_count(arena, args, @ count) != 0
        return: c.LMX_WALK_OK
    while: i < count
        status: lmx_implements_exec_coordinate(arena, args, i, @ physical, @ answer)
        if: status != c.LMX_WALK_OK
            return: status
        if: answer != c.LMX_IMPLEMENTS_YES
            uncertain: 1
        else:
            name: lmx_implements_place_name(arena, args, physical)
            if: name = 0U
                uncertain: 1
            else:
                if: lmx_implements_same_name(name, wanted) != 0
                    if: found != (cast: (size_t) -1)
                        out_answer[0]: c.LMX_IMPLEMENTS_NO
                        return: c.LMX_WALK_OK
                    found: i
                    found_physical: physical
                ---
            ---
        ---
        i: i + 1U
    ---
    if: found = (cast: (size_t) -1)
        if: uncertain = 0
            out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    out_source[0]: found
    out_physical[0]: found_physical
    if: uncertain = 0
        out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_callable_named_formal

# One actual known to belong to the written prefix. The caller establishes
# that prefix before asking this reader; synthesized transport/default rows
# are not written positional actuals. CALL and first are physical places
# from the shared envelope decoder, so this reader never projects CALL again.
# A NAMED operand's own retained spelling selects the callee's formal during
# admission only. Its numeric required coordinate remains transport metadata,
# not a substitute name. Positional actuals select the callee's own SOURCE
# ordinal. The two coordinate spaces are never equated by their extents.
fn: lmx_callable_actual_target (@: arena c.LmxArena; @: selected_args c.Lmx; size_t: written_slot; int: named; size_t: wanted; @: out_source size_t; @: out_physical size_t; @: out_answer int) int
    size_t: selected_count 0U
    size_t: physical (cast: (size_t) -1)
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    if: out_source = 0 || out_physical = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    out_source[0]: (cast: (size_t) -1)
    out_physical[0]: (cast: (size_t) -1)
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: named = -1
        return: c.LMX_WALK_OK
    if: named < 0 || named > 1
        return: c.LMX_WALK_INVALID
    if: named != 0
        # This is the already formed actual's own name, captured before its
        # payload effects. A required coordinate never supplies a substitute.
        return: lmx_callable_named_formal(arena, selected_args, wanted, out_source, out_physical, out_answer)
    if: lmx_callable_source_count(arena, selected_args, @ selected_count) != 0
        return: c.LMX_WALK_OK
    if: written_slot >= selected_count
        out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    status: lmx_implements_exec_coordinate(arena, selected_args, written_slot, @ physical, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    if: answer = c.LMX_IMPLEMENTS_YES
        out_source[0]: written_slot
        out_physical[0]: physical
        out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_callable_actual_target

# Source-row adapter for a Consumer CALL that is being inspected, not run.
# Runtime invocation binding uses the same target matcher with heads captured
# by operand evaluation; it must not reread a CALL child changed by effects.
fn: lmx_callable_actual_place (@: arena c.LmxArena; @: selected_args c.Lmx; @: written_call c.Lmx; size_t: first; size_t: transport_count; size_t: written_slot; @: out_source size_t; @: out_physical size_t; @: out_named int; @@: out_payload void; @: out_answer int) int
    size_t: coordinate 0U
    @: named c.Lmx 0
    @: payload void 0
    size_t: wanted 0U
    int: is_named 0
    int: status
    if: out_source = 0 || out_physical = 0 || out_named = 0 || out_payload = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    out_source[0]: (cast: (size_t) -1)
    out_physical[0]: (cast: (size_t) -1)
    out_named[0]: -1
    out_payload[0]: 0
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: c.lmx_graph_node_in(arena, (cast: (@: void) written_call)) = 0
        return: c.LMX_WALK_OK
    @: fields c.VoidArray @ written_call\array
    if: first > fields\size || transport_count > fields\size - first || written_slot >= transport_count
        return: c.LMX_WALK_INVALID
    payload: c.lmx_graph_value_in(arena, written_call, first + written_slot)
    status: c.lmx_walk_actual_shape(arena, payload, written_slot, transport_count, (cast: (size_t) -1), @ coordinate, @ payload, @ named)
    if: status != c.LMX_WALK_OK
        return: status
    out_payload[0]: payload
    if: named != 0
        is_named: 1
        wanted: c.lmx_source_name_get(arena, (cast: (@: void) named))
    out_named[0]: is_named
    return: lmx_callable_actual_target(arena, selected_args, written_slot, is_named, wanted, out_source, out_physical, out_answer)
end: lmx_callable_actual_place

# Slice 294 (CALLABLE-PLACE-NAMED-ACTUALS; the book :381, :467; Codex 285 item 3, 293 review): the one correspondence of
# a call's written actuals with the formals of the callable the call selected, in written order -- a positional actual
# the selected formal of its ordinal, a NAMED one the selected formal of its own name (lmx_callable_actual_target), never
# the formal a declared signature puts at that slot.  A positional actual after a NAMED one, a name the selected callable
# has no formal of, an ordinal past its formals, two actuals of one formal: NO, the call's refusal.  The walker's EXEC
# binder (lmx_callable_bind_written) and a generated native call (lmx_call_bind_form) both bind here.  source_indices
# get each actual's SOURCE ordinal, map (when given) its physical place; out_uncertain is 1 when a place is unknown.
fn: lmx_callable_bind_prefix (@: arena c.LmxArena; @: selected_args c.Lmx; size_t: written_count; @: actual_named int; @: actual_names size_t; @: source_indices size_t; @: map size_t; @: out_uncertain int; @: out_answer int) int
    size_t: i 0U
    size_t: j
    size_t: source_index (cast: (size_t) -1)
    size_t: physical (cast: (size_t) -1)
    int: named 0
    int: named_seen 0
    int: uncertain 0
    int: row_answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    if: out_uncertain = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    out_uncertain[0]: 0
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0 || (written_count != 0U && (actual_named = 0 || actual_names = 0 || source_indices = 0))
        return: c.LMX_WALK_INVALID
    while: i < written_count
        # These are the heads formed with the once-evaluated operands.
        # Do not reclassify a CALL child after argument effects changed it.
        source_index: (cast: (size_t) -1)
        physical: (cast: (size_t) -1)
        row_answer: c.LMX_IMPLEMENTS_UNKNOWN
        named: actual_named[i]
        status: lmx_callable_actual_target(arena, selected_args, i, named, actual_names[i], @ source_index, @ physical, @ row_answer)
        if: status != c.LMX_WALK_OK
            return: status
        if: row_answer = c.LMX_IMPLEMENTS_NO
            out_answer[0]: c.LMX_IMPLEMENTS_NO
            return: c.LMX_WALK_OK
        if: named = 1
            named_seen: 1
        else:
            if: named = 0 && named_seen != 0
                out_answer[0]: c.LMX_IMPLEMENTS_NO
                return: c.LMX_WALK_OK
            ---
        ---
        if: row_answer != c.LMX_IMPLEMENTS_YES
            uncertain: 1
        source_indices[i]: source_index
        if: physical != (cast: (size_t) -1)
            j: 0U
            while: j < i
                if: source_index != (cast: (size_t) -1) && source_indices[j] = source_index
                    out_answer[0]: c.LMX_IMPLEMENTS_NO
                    return: c.LMX_WALK_OK
                if: map != 0 && map[j] = physical
                    # This is not a duplicate SOURCE formal. Interface/ABI
                    # uncertainty remains separate from both known places.
                    uncertain: 1
                j: j + 1U
            ---
            if: map != 0
                map[i]: physical
            ---
        else:
            uncertain: 1
        ---
        i: i + 1U
    ---
    out_uncertain[0]: uncertain
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_callable_bind_prefix

# Compute the current invocation's borrowed physical correspondence. CALL
# argument bindings are not cached value/Model field layouts: changing a
# NAMED operand must not recover an old numeric formal from the arena index.
# The common admitting worker supplies storage from the caller's activation
# scratch, outside its own temporary resolver lifetime. It publishes genuine
# value/Model maps normally; this row never enters that publication batch.
# Prefix/unused/LAST places are MAX. This is binding evidence only, not type,
# default, result or exit admission. The caller establishes the written prefix;
# an explicit NULL occupies a formal just as a nonnull operand does.
# The normalized suffix after that prefix (the hidden inputs an EXEC carries)
# binds only with the Consumer contract's inputs; without them it stays MAX.
fn: lmx_callable_bind_written (@: arena c.LmxArena; @: selected_args c.Lmx; @: written_call c.Lmx; size_t: first; size_t: transport_count; size_t: written_count; @: contract_inputs c.Lmx; @: actual_named int; @: actual_names size_t; size_t: actual_capacity; @: map size_t; size_t: map_capacity; @: source_indices size_t; size_t: source_capacity; @: out c.LmxImplEntry; @: out_answer int) int
    size_t: wanted 0U
    size_t: width
    size_t: i 0U
    size_t: j
    size_t: source_index (cast: (size_t) -1)
    size_t: physical (cast: (size_t) -1)
    size_t: contract_count 0U
    size_t: contract_physical (cast: (size_t) -1)
    int: uncertain 0
    int: row_answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    if: out = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    c.memset((cast: (@: void) out), 0, c.sizeof(c.LmxImplEntry))
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: c.lmx_graph_node_in(arena, (cast: (@: void) selected_args)) = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) written_call)) = 0
        return: c.LMX_WALK_OK
    @: fields c.VoidArray @ written_call\array
    width: fields\size
    if: first > width || transport_count > width - first || written_count > transport_count
        return: c.LMX_WALK_INVALID
    if: width > ((cast: (size_t) -1) / c.sizeof(c.size_t)) / 2U
        return: c.LMX_WALK_NOMEM
    if: map = 0 || source_indices = 0 || map_capacity < width * 2U || source_capacity < width
        return: c.LMX_WALK_INVALID
    if: written_count != 0U && (actual_named = 0 || actual_names = 0 || actual_capacity < first + written_count)
        return: c.LMX_WALK_INVALID
    # Both arrays belong to the caller's existing activation scratch and stay
    # live until materialization finishes. Neither enters the arena index.
    while: i < width * 2U
        map[i]: (cast: (size_t) -1)
        i: i + 1U
    ---
    i: 0U
    while: i < width
        source_indices[i]: (cast: (size_t) -1)
        i: i + 1U
    ---
    out\value: selected_args
    out\req: written_call
    out\layout: lmx_implements_layout(arena, selected_args)
    out\map: map
    out\n: width
    out\holes: 1
    out\owned_map: 0
    out\reception_proof: 0
    # The map records physical places. Separate temporary SOURCE coordinates
    # preserve known ABI formals even if their physical projections alias.
    # ORDINAL/LAST retain their ordinary meaning; neither half encodes SOURCE.
    # The written prefix binds through the one correspondence of both executors.
    status: lmx_callable_bind_prefix(arena, selected_args, written_count, actual_named + first, actual_names + first, source_indices + first, map + first, @ uncertain, @ row_answer)
    if: status != c.LMX_WALK_OK
        return: status
    if: row_answer = c.LMX_IMPLEMENTS_NO
        out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    i: written_count
    # Each suffix operand keeps the identity its producer retained: the
    # Consumer contract's own input at the same SOURCE ordinal. That input's
    # name selects the selected callable's formal through the common named
    # matcher, never through an equal ordinal of the two signatures. An absent
    # (NULL) suffix operand still occupies the formal it names.
    if: contract_inputs != 0 && written_count < transport_count && lmx_callable_source_count(arena, contract_inputs, @ contract_count) != 0
        contract_count: 0U
    while: contract_inputs != 0 && i < transport_count
        wanted: 0U
        source_index: (cast: (size_t) -1)
        physical: (cast: (size_t) -1)
        row_answer: c.LMX_IMPLEMENTS_UNKNOWN
        if: i < contract_count
            status: lmx_implements_exec_coordinate(arena, contract_inputs, i, @ contract_physical, @ row_answer)
            if: status != c.LMX_WALK_OK
                return: status
            if: row_answer = c.LMX_IMPLEMENTS_YES
                wanted: lmx_implements_place_name(arena, contract_inputs, contract_physical)
            row_answer: c.LMX_IMPLEMENTS_UNKNOWN
        ---
        if: wanted != 0U
            status: lmx_callable_named_formal(arena, selected_args, wanted, @ source_index, @ physical, @ row_answer)
            if: status != c.LMX_WALK_OK
                return: status
        ---
        if: row_answer = c.LMX_IMPLEMENTS_NO
            out_answer[0]: c.LMX_IMPLEMENTS_NO
            return: c.LMX_WALK_OK
        if: row_answer != c.LMX_IMPLEMENTS_YES
            uncertain: 1
        source_indices[first + i]: source_index
        if: physical != (cast: (size_t) -1)
            j: 0U
            while: j < i
                if: source_index != (cast: (size_t) -1) && source_indices[first + j] = source_index
                    out_answer[0]: c.LMX_IMPLEMENTS_NO
                    return: c.LMX_WALK_OK
                if: map[first + j] = physical
                    uncertain: 1
                j: j + 1U
            ---
            map[first + i]: physical
        else:
            uncertain: 1
        ---
        i: i + 1U
    ---
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    if: uncertain != 0
        out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    return: c.LMX_WALK_OK
end: lmx_callable_bind_written

# The existing EXEC producer records the explicit written prefix in slot4.
# Missing/legacy reserved contents are unavailable order metadata, not a
# signature mismatch. This reader never evaluates a slot or a provider.
fn: lmx_callable_written_count (@: arena c.LmxArena; @: written_call c.Lmx; int: op; size_t: first; size_t: transport_count; @: out_count size_t; @: out_answer int) int
    @: fields c.VoidArray
    @: cell void
    @: count size_t
    if: out_count = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    out_count[0]: 0U
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: c.lmx_graph_node_in(arena, (cast: (@: void) written_call)) = 0
        return: c.LMX_WALK_OK
    if: transport_count = 0U
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    # `first` is the physical envelope returned by the shared call_shape.
    # In a short CALL first=2, so slot4 can be an actual, not metadata.
    # Only the current EXEC producer establishes the written-prefix carrier.
    # No equivalent positive-transport CALL producer has been established.
    if: first != 5U || op != c.LMX_WALK_OP_EXEC
        return: c.LMX_WALK_OK
    fields: @ written_call\array
    if: fields\size <= 4U
        return: c.LMX_WALK_OK
    cell: c.lmx_graph_value_in(arena, written_call, 4U)
    if: lmx_implements_metadata_cell(arena, cell, c.LMX_TYPE_SIZE_T, c.sizeof(c.size_t)) = 0
        return: c.LMX_WALK_OK
    count: (cast: (@: size_t) cell)
    if: count[0] > transport_count
        return: c.LMX_WALK_INVALID
    out_count[0]: count[0]
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_callable_written_count

# Adapt an unevaluated Consumer CALL to the same binding matcher used by
# captured runtime heads. No selector, data, payload or SOURCE executes.
# Temporary name headers borrow the current graph during this read-only
# operation; unlike runtime evaluation there are no operand effects between
# capture and binding. The resulting row is not published or cached.
fn: lmx_callable_source_binding (@: arena c.LmxArena; @: selected c.Lmx; @: written_call c.Lmx; @: resolver c.LmxImplResolve; @: out c.LmxImplEntry; @@: out_sources size_t; @: out_first size_t; @: out_written size_t; @: out_answer int) int
    @: args c.Lmx 0
    @: returns c.Lmx 0
    @: fields c.VoidArray 0
    @: named c.Lmx 0
    @: payload void 0
    @: raw_selector void 0
    @: raw_data void 0
    @: raw_contract void 0
    @: room void 0
    @: actual_named int 0
    @: actual_names size_t 0
    @: map size_t 0
    @: sources size_t 0
    size_t: first 0U
    size_t: transport_count 0U
    size_t: written_count 0U
    size_t: width 0U
    size_t: coordinate 0U
    size_t: i 0U
    int: op 0
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    int: scratch_status
    if: out = 0 || out_sources = 0 || out_first = 0 || out_written = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    c.memset((cast: (@: void) out), 0, c.sizeof(c.LmxImplEntry))
    out_sources[0]: 0
    out_first[0]: 0U
    out_written[0]: 0U
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0 || resolver = 0 || resolver\scratch = 0
        return: c.LMX_WALK_INVALID
    status: lmx_callable_headers(arena, selected, @ args, @ returns, @ answer)
    if: status != c.LMX_WALK_OK || args = 0
        return: status
    if: written_call = 0
        return: c.LMX_WALK_OK
    status: c.lmx_walk_call_shape(arena, written_call, @ op, @ first, @ transport_count, @ raw_selector, @ raw_data, @ raw_contract)
    if: status != c.LMX_WALK_OK
        return: status
    status: lmx_callable_written_count(arena, written_call, op, first, transport_count, @ written_count, @ answer)
    if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        return: status
    fields: @ written_call\array
    width: fields\size
    if: width > ((cast: (size_t) -1) / c.sizeof(c.size_t)) / 2U || width > (cast: (size_t) -1) / c.sizeof(c.int)
        return: c.LMX_WALK_NOMEM
    scratch_status: c.lmx_scratch_take(resolver\scratch, width * c.sizeof(c.int), @ room)
    if: scratch_status != c.LMX_SCRATCH_OK
        if: scratch_status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    ---
    actual_named: (cast: (@: int) room)
    c.memset(room, 0, width * c.sizeof(c.int))
    scratch_status: c.lmx_scratch_take(resolver\scratch, width * c.sizeof(c.size_t), @ room)
    if: scratch_status != c.LMX_SCRATCH_OK
        if: scratch_status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    ---
    actual_names: (cast: (@: size_t) room)
    c.memset(room, 0, width * c.sizeof(c.size_t))
    scratch_status: c.lmx_scratch_take(resolver\scratch, width * 2U * c.sizeof(c.size_t), @ room)
    if: scratch_status != c.LMX_SCRATCH_OK
        if: scratch_status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    ---
    map: (cast: (@: size_t) room)
    scratch_status: c.lmx_scratch_take(resolver\scratch, width * c.sizeof(c.size_t), @ room)
    if: scratch_status != c.LMX_SCRATCH_OK
        if: scratch_status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    ---
    sources: (cast: (@: size_t) room)
    while: i < written_count
        payload: c.lmx_graph_value_in(arena, written_call, first + i)
        status: c.lmx_walk_actual_shape(arena, payload, i, transport_count, (cast: (size_t) -1), @ coordinate, @ payload, @ named)
        if: status != c.LMX_WALK_OK
            return: status
        if: named != 0
            actual_named[first + i]: 1
            actual_names[first + i]: c.lmx_source_name_get(arena, (cast: (@: void) named))
        i: i + 1U
    ---
    # Admission inspects the written prefix only; no suffix identity is bound.
    status: lmx_callable_bind_written(arena, args, written_call, first, transport_count, written_count, 0, actual_named, actual_names, width, map, width * 2U, sources, width, out, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    out_sources[0]: sources
    out_first[0]: first
    out_written[0]: written_count
    out_answer[0]: answer
    return: c.LMX_WALK_OK
end: lmx_callable_source_binding

# Positive evidence that this exact CALL's result is consumed by a retained
# real receiving operation. Zero is unavailable evidence, NEVER discard or
# permission to ignore a result. Read interfaces/edges only, not values or
# the future object returned by a provider.
fn: lmx_implements_call_result_used (@: arena c.LmxArena; @: written_call c.Lmx; @: receivers c.Lmx; @: out_used int) int
    @: fields c.VoidArray 0
    @: operation c.Lmx 0
    @: operation_fields c.VoidArray 0
    @: record c.Lmx 0
    @: record_fields c.VoidArray 0
    @: model_operand c.Lmx 0
    @: wide size_t 0
    @: cell void 0
    size_t: count 0U
    size_t: i 0U
    int: op 0
    if: out_used = 0
        return: c.LMX_WALK_INVALID
    out_used[0]: 0
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: written_call = 0 || receivers = 0
        return: c.LMX_WALK_OK
    if: c.lmx_graph_node_in(arena, (cast: (@: void) receivers)) != receivers
        return: c.LMX_WALK_INVALID
    fields: @ receivers\array
    if: fields\size < 1U
        return: c.LMX_WALK_INVALID
    cell: c.lmx_graph_value_in(arena, receivers, 0U)
    if: lmx_implements_metadata_cell(arena, cell, c.LMX_TYPE_SIZE_T, c.sizeof(c.size_t)) = 0
        return: c.LMX_WALK_INVALID
    wide: (cast: (@: size_t) cell)
    count: wide[0]
    if: count > fields\size - 1U
        return: c.LMX_WALK_INVALID
    while: i < count
        cell: c.lmx_graph_value_in(arena, receivers, 1U + i)
        operation: c.lmx_graph_node_in(arena, cell)
        if: cell != 0 && operation = 0
            return: c.LMX_WALK_INVALID
        if: operation != 0
            operation_fields: @ operation\array
            op: c.lmx_walk_code_in(arena, c.lmx_graph_value_in(arena, operation, 0U))
            if: op % c.LMX_WALK_OP_COUNT = c.LMX_WALK_OP_ADMIT_AS && operation_fields\size >= 5U && c.lmx_graph_value_in(arena, operation, 3U) = (cast: (@: void) written_call)
                record: c.lmx_graph_ref_struct_in(arena, operation, 1U)
                model_operand: c.lmx_graph_ref_struct_in(arena, operation, 4U)
                if: record != 0 && model_operand != 0
                    record_fields: @ record\array
                    if: record_fields\size = 6U
                        out_used[0]: 1
                ---
            ---
        ---
        i: i + 1U
    ---
    return: c.LMX_WALK_OK
end: lmx_implements_call_result_used

# One unevaluated Consumer occurrence contributes only its actual written
# interface facts. Successful binding is not completed CALL admission: the
# used input/default/result/exit interfaces still need their actual facts.
# This phase requires no future payload/result proof or provider-body walk.
# Runtime value formation/reception is a separate execution responsibility.
fn: lmx_implements_source_call (@: arena c.LmxArena; @: selected c.Lmx; @: calls c.Lmx; size_t: row_at; @: resolver c.LmxImplResolve; @: out_answer int) int
    c.LmxImplEntry: binding
    @: sources size_t 0
    @: consumer_code c.Lmx 0
    @: written_call c.Lmx 0
    @: fields c.VoidArray 0
    @: returns c.Lmx 0
    @: args c.Lmx 0
    @: receivers c.Lmx 0
    size_t: first 0U
    size_t: written 0U
    size_t: return_count 0U
    int: result_used 0
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0 || resolver = 0 || resolver\scratch = 0
        return: c.LMX_WALK_INVALID
    if: calls = 0 || selected = 0
        return: c.LMX_WALK_OK
    if: c.lmx_graph_node_in(arena, (cast: (@: void) calls)) != calls
        return: c.LMX_WALK_INVALID
    fields: @ calls\array
    if: row_at = 0U || row_at > fields\size || fields\size - row_at < 5U
        return: c.LMX_WALK_INVALID
    consumer_code: c.lmx_graph_ref_struct_in(arena, calls, row_at + 1U)
    written_call: c.lmx_graph_ref_struct_in(arena, calls, row_at + 2U)
    if: consumer_code = 0 || written_call = 0
        return: c.LMX_WALK_OK
    status: lmx_callable_source_binding(arena, selected, written_call, resolver, @ binding, @ sources, @ first, @ written, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    if: answer = c.LMX_IMPLEMENTS_NO
        out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    receivers: c.lmx_graph_ref_struct_in(arena, calls, row_at + 3U)
    status: lmx_implements_call_result_used(arena, written_call, receivers, @ result_used)
    if: status != c.LMX_WALK_OK
        return: status
    if: result_used != 0
        status: lmx_callable_headers(arena, selected, @ args, @ returns, @ answer)
        if: status != c.LMX_WALK_OK
            return: status
        if: returns != 0 && lmx_callable_source_count(arena, returns, @ return_count) = 0 && return_count = 0U
            # A declared no-result callable cannot supply a Value to this
            # actual result receiver. This is interface absence, never a
            # prediction of a returned value's contents or provider body.
            out_answer[0]: c.LMX_IMPLEMENTS_NO
        ---
    ---
    return: c.LMX_WALK_OK
end: lmx_implements_source_call

# Each occurrence is keyed by its original carrier and physical row offset,
# not by a temporary decoded scope, binding map or a guessed header type.
fn: lmx_implements_require_call (@: arena c.LmxArena; @: selected c.Lmx; @: calls c.Lmx; size_t: row_at; @: resolver c.LmxImplResolve) int
    @: item c.LmxImplObligation 0
    @: room void 0
    int: scratch_status
    if: arena = 0 || resolver = 0 || resolver\scratch = 0 || calls = 0
        return: c.LMX_WALK_INVALID
    item: resolver\seen
    while: item != 0
        if: item\kind = 2 && item\value = selected && item\calls = calls && item\call_at = row_at
            return: c.LMX_WALK_OK
        item: item\seen_next
    ---
    scratch_status: c.lmx_scratch_take(resolver\scratch, c.sizeof(c.LmxImplObligation), @ room)
    if: scratch_status != c.LMX_SCRATCH_OK
        if: scratch_status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    ---
    item: (cast: (@: c.LmxImplObligation) room)
    c.memset(room, 0, c.sizeof(c.LmxImplObligation))
    item\kind: 2
    item\value: selected
    item\calls: calls
    item\call_at: row_at
    item\pending_next: resolver\pending
    item\seen_next: resolver\seen
    resolver\pending: item
    resolver\seen: item
    return: c.LMX_WALK_OK
end: lmx_implements_require_call

# Select ALL actual Consumer occurrences for the flat coverage CELL. YES
# here means that rows were queued, never that their calls were admitted.
fn: lmx_implements_require_calls (@: arena c.LmxArena; @: selected c.Lmx; @: uses c.LmxImplUses; size_t: coverage_cell; @: resolver c.LmxImplResolve; @: out_answer int) int
    @: calls c.Lmx 0
    @: wide size_t 0
    size_t: count 0U
    size_t: row 0U
    size_t: at 0U
    int: matched 0
    int: status
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0 || resolver = 0 || resolver\scratch = 0
        return: c.LMX_WALK_INVALID
    if: uses = 0 || uses\calls = 0
        return: c.LMX_WALK_OK
    calls: uses\calls
    status: lmx_implements_calls_shape(arena, calls, @ count)
    if: status != c.LMX_WALK_OK
        return: status
    while: row < count
        at: 1U + row * 5U
        wide: (cast: (@: size_t) c.lmx_graph_value_in(arena, calls, at))
        if: wide[0] = coverage_cell
            matched: 1
            status: lmx_implements_require_call(arena, selected, calls, at, resolver)
            if: status != c.LMX_WALK_OK
                return: status
        ---
        row: row + 1U
    ---
    if: matched != 0
        out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_implements_require_calls

fn: lmx_implements_call_takes (@: arena c.LmxArena; @: value void; @: req void) int
    @: code c.Lmx c.lmx_graph_node_in(arena, value)
    @: contract c.Lmx c.lmx_graph_node_in(arena, req)
    @: have_args c.Lmx 0
    @: have_return c.Lmx 0
    @: want_args c.Lmx 0
    @: want_return c.Lmx 0
    size_t: header_count 0U
    size_t: have_count 0U
    size_t: want_count 0U
    size_t: args_slot 0U
    size_t: return_slot 0U
    int: answer
    int: want_sub 0
    int: have_sub 0
    if: contract = 0
        return: c.LMX_IMPLEMENTS_UNKNOWN
    if: lmx_callable_source_count(arena, contract, @ header_count) != 0 || header_count < 2U
        return: c.LMX_IMPLEMENTS_UNKNOWN
    # Slice 286: a `sub` is a callable of three parts that returns no value (lmx_callable_part): its edge 1 is its var, no
    # return header.  The call its description forms reads no result; as a candidate it gives none.
    want_sub: (cast: (int) (lmx_callable_part(arena, contract, 0U) != (cast: (size_t) -1) && lmx_callable_part(arena, contract, 1U) = (cast: (size_t) -1)))
    args_slot: lmx_implements_exec_index(arena, contract, 0U)
    if: args_slot = (cast: (size_t) -1)
        return: c.LMX_IMPLEMENTS_UNKNOWN
    want_args: c.lmx_graph_node_in(arena, c.lmx_graph_value_in(arena, contract, args_slot))
    if: want_args = 0
        return: c.LMX_IMPLEMENTS_UNKNOWN
    if: want_sub = 0
        return_slot: lmx_implements_exec_index(arena, contract, 1U)
        if: return_slot = (cast: (size_t) -1)
            return: c.LMX_IMPLEMENTS_UNKNOWN
        want_return: c.lmx_graph_node_in(arena, c.lmx_graph_value_in(arena, contract, return_slot))
        if: want_return = 0
            return: c.LMX_IMPLEMENTS_UNKNOWN
    ---
    if: code = 0
        return: c.LMX_IMPLEMENTS_NO
    if: lmx_callable_source_count(arena, code, @ header_count) != 0
        return: c.LMX_IMPLEMENTS_UNKNOWN
    if: header_count < 2U
        return: c.LMX_IMPLEMENTS_NO
    have_sub: (cast: (int) (lmx_callable_part(arena, code, 0U) != (cast: (size_t) -1) && lmx_callable_part(arena, code, 1U) = (cast: (size_t) -1)))
    # A call reads as many results as its description has: a sub gives none, a fn one (the static rule's equal result,
    # lm_compiler_sig_takes).
    if: want_sub != have_sub
        return: c.LMX_IMPLEMENTS_NO
    args_slot: lmx_implements_exec_index(arena, code, 0U)
    if: args_slot = (cast: (size_t) -1)
        return: c.LMX_IMPLEMENTS_UNKNOWN
    have_args: c.lmx_graph_node_in(arena, c.lmx_graph_value_in(arena, code, args_slot))
    if: have_args = 0
        return: c.LMX_IMPLEMENTS_NO
    if: have_sub = 0
        return_slot: lmx_implements_exec_index(arena, code, 1U)
        if: return_slot = (cast: (size_t) -1)
            return: c.LMX_IMPLEMENTS_UNKNOWN
        have_return: c.lmx_graph_node_in(arena, c.lmx_graph_value_in(arena, code, return_slot))
        if: have_return = 0
            return: c.LMX_IMPLEMENTS_NO
    ---
    if: lmx_callable_source_count(arena, have_args, @ have_count) != 0 || lmx_callable_source_count(arena, want_args, @ want_count) != 0
        return: c.LMX_IMPLEMENTS_UNKNOWN
    if: have_count != want_count
        return: c.LMX_IMPLEMENTS_NO
    answer: lmx_implements_call_positions(arena, have_args, want_args, 1)
    want_count: 0U
    if: want_return != 0 && lmx_callable_source_count(arena, want_return, @ want_count) != 0
        return: c.LMX_IMPLEMENTS_UNKNOWN
    if: answer != c.LMX_IMPLEMENTS_YES || want_count = 0U
        return: answer
    if: lmx_callable_source_count(arena, have_return, @ have_count) != 0
        return: c.LMX_IMPLEMENTS_UNKNOWN
    if: have_count != want_count
        return: c.LMX_IMPLEMENTS_NO
    return: lmx_implements_call_positions(arena, have_return, want_return, 0)
end: lmx_implements_call_takes

# Holding a graph reference consumes its physical storage category only. It
# does not invoke a pointer callback or inspect a prospective provider body.
# A low DESC tag alone does not establish an Array's element contract.
fn: lmx_implements_graph_holding (@: arena c.LmxArena; @: cell void; int: wanted_kind; int: wanted_type; int: low_required) int
    int: kind lmx_domain_kind(arena, cell)
    int: low lmx_implements_low_candidate(arena, cell)
    if: kind = c.LMX_KIND_NONE
        return: c.LMX_IMPLEMENTS_UNKNOWN
    if: low != c.LMX_TYPE_NONE
        if: c.lmx_pointer_pool_in(arena, cell) = 0 || wanted_kind = c.LMX_KIND_ARRAY || c.lmx_type_base(low_required) = c.LMX_TYPE_DESC
            return: c.LMX_IMPLEMENTS_UNKNOWN
        return: c.LMX_IMPLEMENTS_YES
    if: kind != c.LMX_KIND_STRUCT && kind != c.LMX_KIND_ARRAY
        return: c.LMX_IMPLEMENTS_NO
    if: wanted_kind = c.LMX_KIND_ARRAY
        if: kind != c.LMX_KIND_ARRAY || lmx_domain_type(arena, cell) != wanted_type
            return: c.LMX_IMPLEMENTS_NO
        return: c.LMX_IMPLEMENTS_YES
    if: c.lmx_type_base(low_required) = c.LMX_TYPE_DESC
        if: kind != c.LMX_KIND_ARRAY
            return: c.LMX_IMPLEMENTS_NO
        return: c.LMX_IMPLEMENTS_UNKNOWN
    return: c.LMX_IMPLEMENTS_YES
end: lmx_implements_graph_holding

fn: lmx_implements_walk_project_resolve (@: arena c.LmxArena; @: varA c.Lmx; @: varB c.Lmx; @: consumer c.Lmx; @: pending c.LmxImplEntry; size_t: pending_n; int: skip_unused; int: interface; @: uses c.LmxImplUses; @: resolver c.LmxImplResolve; @: out_answer int) int
    @: part_consumer_array c.VoidArray 0
    @: part_current_consumer_array c.VoidArray 0
    c.LmxArena: temporary
    c.LmxPool: cells
    c.LmxScratch: scratch
    @: work c.LmxScratch (@ scratch)
    int: owns_scratch 1
    c.LmxImplResolve: local_resolver
    c.LmxImplementsFrame: root
    @: current c.LmxImplementsFrame (@ root)
    @: seen c.LmxImplementsFrame (@ root)
    @: found c.LmxImplementsFrame 0
    @: child c.LmxImplementsFrame 0
    @: room void 0
    size_t: index
    size_t: indexA
    size_t: indexB
    size_t: count 0U
    size_t: edge 0U
    size_t: below 0U
    size_t: level 0U
    size_t: coverage_cell 0U
    size_t: width
    size_t: mask_index
    int: last
    int: enter
    int: named
    int: called
    int: lost
    int: availableA
    int: availableB
    int: uncertain 0
    @: a void
    @: b void
    @: c void
    @: rawA void
    @: rawB void
    int: lowA
    int: lowB
    int: lowC
    int: logical_graph
    int: loadedA
    int: loadedB
    int: borrowedA
    int: borrowedB
    c.LmxWalkValue: valueA
    c.LmxWalkValue: valueB
    @: consumer_model c.Lmx 0
    @: consumer_references c.Lmx 0
    int: consumer_answer c.LMX_IMPLEMENTS_UNKNOWN
    @: reference c.Lmx 0
    @: reference_frame c.Lmx 0
    @: source_childA c.Lmx 0
    @: source_childB c.Lmx 0
    @: source_referencesA c.Lmx 0
    @: source_referencesB c.Lmx 0
    int: source_answerA c.LMX_IMPLEMENTS_UNKNOWN
    int: source_answerB c.LMX_IMPLEMENTS_UNKNOWN
    c.LmxImplContractFact: required
    c.LmxImplEntry: bridgeA
    c.LmxImplEntry: bridgeB
    int: kindA
    int: kindB
    int: kindC
    int: typeC
    @: projection c.LmxImplEntry 0
    int: answer c.LMX_IMPLEMENTS_YES
    int: status c.LMX_WALK_OK
    int: scratch_status
    int: other_answer
    int: field_answer
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: consumer = 0
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    if: varA = 0 || varB = 0
        out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    if: lmx_domain_kind(arena, (cast: (@: void) consumer)) = c.LMX_KIND_NONE
        return: c.LMX_WALK_OK
    if: c.lmx_graph_node_in(arena, (cast: (@: void) consumer)) = 0
        return: c.LMX_WALK_OK
    if: lmx_domain_kind(arena, (cast: (@: void) varA)) = c.LMX_KIND_NONE || lmx_domain_kind(arena, (cast: (@: void) varB)) = c.LMX_KIND_NONE
        return: c.LMX_WALK_OK
    if: c.lmx_graph_node_in(arena, (cast: (@: void) varA)) = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) varB)) = 0
        out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    ---
    # Array<T> as the requested interface keeps its element-type contract,
    # not the exemplar's dynamic length. An ordinary Structure Consumer below
    # still inspects Array fields through the same graph-place correspondence.
    if: uses = 0 && lmx_domain_kind(arena, (cast: (@: void) consumer)) = c.LMX_KIND_ARRAY
        answer: lmx_implements(arena, (cast: (@: void) varA), (cast: (@: void) consumer), 0)
        other_answer: lmx_implements(arena, (cast: (@: void) varB), (cast: (@: void) consumer), 0)
        if: answer = c.LMX_IMPLEMENTS_NO || other_answer = c.LMX_IMPLEMENTS_NO
            out_answer[0]: c.LMX_IMPLEMENTS_NO
        else:
            if: answer = c.LMX_IMPLEMENTS_YES && other_answer = c.LMX_IMPLEMENTS_YES
                out_answer[0]: c.LMX_IMPLEMENTS_YES
            ---
        ---
        return: c.LMX_WALK_OK
    ---
    if: consumer != 0
        part_consumer_array: (cast: (@: c.VoidArray) (@ consumer\array))
    ---
    if: part_consumer_array\size = 0U && uses = 0
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    # Preserve the original predicate/empty-Consumer guards before asking
    # for metadata that this operation may not need at all.
    if: pending_n != 0U && pending = 0
        return: c.LMX_WALK_INVALID
    if: pending_n > ((cast: (size_t) -1) / c.sizeof(c.LmxImplEntry))
        return: c.LMX_WALK_NOMEM
    if: resolver != 0
        work: resolver\scratch
        owns_scratch: 0
        if: work = 0
            return: c.LMX_WALK_INVALID
        ---
    else:
        c.memset((cast: (@: void) (@ temporary)), 0, c.sizeof(c.LmxArena))
        c.memset((cast: (@: void) (@ cells)), 0, c.sizeof(c.LmxPool))
        c.memset((cast: (@: void) (@ scratch)), 0, c.sizeof(c.LmxScratch))
        if: c.lmx_arena_open(@ temporary) != 0
            return: c.LMX_WALK_INVALID
        scratch_status: c.lmx_scratch_open(@ scratch, @ temporary, @ cells, 64U)
        if: scratch_status != c.LMX_SCRATCH_OK
            c.lmx_arena_release(@ temporary)
            if: scratch_status = c.LMX_SCRATCH_NOMEM
                return: c.LMX_WALK_NOMEM
            return: c.LMX_WALK_INVALID
        ---
    ---
    if: owns_scratch != 0
        c.memset((cast: (@: void) (@ local_resolver)), 0, c.sizeof(c.LmxImplResolve))
        local_resolver\scratch: work
        # This low-level predicate supplies explicit coordinate identity;
        # source-catalog receptions never obtain it from missing metadata.
        local_resolver\identity_default: 1
        resolver: @ local_resolver
    ---
    current\varA: varA
    current\varB: varB
    current\consumer: consumer
    current\references: resolver\references
    current\source: resolver\source
    current\sourceB: resolver\source
    current\source_referencesA: resolver\source_references
    current\source_referencesB: resolver\source_references
    c.memset((cast: (@: void) (@ current\source_bridge)), 0, c.sizeof(c.LmxImplEntry))
    c.memset((cast: (@: void) (@ current\source_bridgeB)), 0, c.sizeof(c.LmxImplEntry))
    current\viewA: 0
    current\viewB: 0
    current\viewA_result: c.LMX_IMPLEMENTS_YES
    current\viewB_result: c.LMX_IMPLEMENTS_YES
    current\viewA_unknown: 0
    current\viewB_unknown: 0
    current\view_ready: 0
    current\index: 0U
    current\level: 0U
    if: uses != 0
        current\level: 1U
    current\caller: 0
    current\seen_next: 0
    while: current != 0
        last: 0
        enter: 1
        named: 0
        called: 0
        level: 0U
        coverage_cell: 0U
        if: current\level = 0U
            if: current != 0 && current\consumer != 0
                part_current_consumer_array: (cast: (@: c.VoidArray) (@ current\consumer\array))
            ---
            if: current\index = part_current_consumer_array\size
                current: current\caller
                continue
            ---
            index: current\index
            current\index: index + 1U
        else:
            # A level of the coverage: its pairs, never the consumer's width.
            named: 1
            if: lmx_implements_use_cell(arena, uses, (cast: (size_t) current\level), @ count) != 0
                status: c.LMX_WALK_INVALID
                break
            if: current\index >= count
                current: current\caller
                continue
            ---
            index: current\index
            current\index: index + 1U
            if: index > ((cast: (size_t) -1) - current\level - 2U) / 2U
                status: c.LMX_WALK_INVALID
                break
            index: current\level + 1U + index * 2U
            coverage_cell: index
            if: lmx_implements_use_cell(arena, uses, index, @ edge) != 0 || lmx_implements_use_cell(arena, uses, index + 1U, @ below) != 0
                status: c.LMX_WALK_INVALID
                break
            if: current != 0 && current\consumer != 0
                part_current_consumer_array: (cast: (@: c.VoidArray) (@ current\consumer\array))
            ---
            width: part_current_consumer_array\size
            index: edge
            if: edge >= width
                if: edge - width >= width
                    status: c.LMX_WALK_INVALID
                    break
                index: edge - width
                last: 1
            ---
            if: below = (cast: (size_t) -2)
                called: 1
                enter: 0
            if: below = 0U
                enter: 0
            if: below != 0U && below != (cast: (size_t) -1) && called = 0
                level: below
        ---
        reference_frame: current\references
        if: resolver != 0 && resolver\contract != 0 && reference_frame = resolver\references
            status: lmx_implements_contract_get((cast: (@: c.LmxImplContract) resolver\contract), (cast: (@: c.Lmx) (current\consumer)), index, @ required, @ field_answer)
        else:
            status: lmx_implements_contract_field(arena, (cast: (@: c.Lmx) (current\consumer)), index, interface, reference_frame, @ required, @ field_answer)
        ---
        if: status != c.LMX_WALK_OK
            break
        if: field_answer != c.LMX_IMPLEMENTS_YES && (required\cell = 0 || required\kind = c.LMX_KIND_NONE)
            uncertain: 1
            continue
        c: required\cell
        # A field the coverage names has to be there in the model: an edge that
        # lands on an empty place of it certifies nothing.
        if: c = 0 && named != 0
            uncertain: 1
            continue
        if: c != 0
            kindC: required\kind
            typeC: required\type
            if: required\executable != 0
                continue
            ---
            # A checked field consumes this physical pair. Resolve its views
            # once, here, not for empty coverage or unrelated pending rows.
            if: current\view_ready = 0
                c.memset((cast: (@: void) (@ bridgeA)), 0, c.sizeof(c.LmxImplEntry))
                c.memset((cast: (@: void) (@ bridgeB)), 0, c.sizeof(c.LmxImplEntry))
                # These immutable triads describe each giving namespace,
                # not the transient answer of address-view preparation.
                if: current\viewA_result = c.LMX_IMPLEMENTS_YES
                    status: lmx_implements_resolved_view_parts(arena, (cast: (@: c.Lmx) (current\varA)), (cast: (@: c.Lmx) (current\consumer)), (cast: (@: c.Lmx) (current\source)), (cast: (@: c.Lmx) current\source_referencesA), @ bridgeA, pending, pending_n, resolver, @ projection, @ answer)
                    if: status != c.LMX_WALK_OK
                        break
                    current\viewA: projection
                    if: projection != 0
                        c.memcpy((cast: (@: void) (@ current\source_bridge)), (cast: (@: void) (@ bridgeA)), c.sizeof(c.LmxImplEntry))
                    ---
                ---
                if: current\viewB_result = c.LMX_IMPLEMENTS_YES
                    status: lmx_implements_resolved_view_parts(arena, (cast: (@: c.Lmx) (current\varB)), (cast: (@: c.Lmx) (current\consumer)), (cast: (@: c.Lmx) current\sourceB), (cast: (@: c.Lmx) current\source_referencesB), @ bridgeB, pending, pending_n, resolver, @ projection, @ answer)
                    if: status != c.LMX_WALK_OK
                        break
                    current\viewB: projection
                    if: projection != 0
                        c.memcpy((cast: (@: void) (@ current\source_bridgeB)), (cast: (@: void) (@ bridgeB)), c.sizeof(c.LmxImplEntry))
                    ---
                ---
                current\view_ready: 1
            ---
            # Coordinate-selection answers are not field verdicts. A failed
            # selection leaves that side unavailable below; only a consumed
            # known absence/type/call mismatch can set this walk's NO.
            answer: c.LMX_IMPLEMENTS_YES
            indexA: index
            indexB: index
            availableA: 1
            availableB: 1
            if: current\viewA = 0
                # No selected correspondence is unavailable evidence, never
                # an implicit positional identity or a guaranteed missing field.
                availableA: 0
                indexA: (cast: (size_t) -1)
                uncertain: 1
            if: current\viewB = 0
                availableB: 0
                indexB: (cast: (size_t) -1)
                uncertain: 1
            lost: 0
            if: current\viewA != 0 && last = 0 && lmx_implements_at(arena, (cast: (@: c.LmxImplEntry) current\viewA), index, @ indexA) != 0
                lost: 1
            if: current\viewA != 0 && last != 0 && lmx_implements_at_last(arena, (cast: (@: c.LmxImplEntry) current\viewA), index, @ indexA) != 0
                lost: 1
            if: current\viewB != 0 && last = 0 && lmx_implements_at(arena, (cast: (@: c.LmxImplEntry) current\viewB), index, @ indexB) != 0
                lost: 1
            if: current\viewB != 0 && last != 0 && lmx_implements_at_last(arena, (cast: (@: c.LmxImplEntry) current\viewB), index, @ indexB) != 0
                lost: 1
            if: lost != 0
                status: c.LMX_WALK_INVALID
                break
            if: indexA = (cast: (size_t) -1) || indexB = (cast: (size_t) -1)
                # A field the coverage names is required: only a walk of every
                # field may pass over one that is not carried.
                if: skip_unused != 0 && named = 0
                    continue
                if: current != 0 && current\consumer != 0
                    part_current_consumer_array: (cast: (@: c.VoidArray) (@ current\consumer\array))
                ---
                mask_index: index
                if: last != 0
                    mask_index: part_current_consumer_array\size + index
                # A compatible later visit may have added an annotation to
                # this same prepared row. Refresh at the consumed hole; never
                # cache NULL as proof of absence across those visits.
                current\viewA_unknown: lmx_implements_prepared_mask(resolver, (cast: (@: c.LmxImplEntry) current\viewA))
                current\viewB_unknown: lmx_implements_prepared_mask(resolver, (cast: (@: c.LmxImplEntry) current\viewB))
                if: indexA = (cast: (size_t) -1)
                    if: availableA = 0 || (current\viewA_unknown != 0 && current\viewA_unknown[mask_index] != 0U)
                        uncertain: 1
                        availableA: 0
                    else:
                        answer: c.LMX_IMPLEMENTS_NO
                        break
                    ---
                ---
                if: indexB = (cast: (size_t) -1)
                    if: availableB = 0 || (current\viewB_unknown != 0 && current\viewB_unknown[mask_index] != 0U)
                        uncertain: 1
                        availableB: 0
                    else:
                        answer: c.LMX_IMPLEMENTS_NO
                        break
                    ---
                ---
                if: availableA = 0 && availableB = 0
                    continue
            ---
            a: 0
            b: 0
            if: availableA != 0
                a: c.lmx_graph_value_in(arena, current\varA, indexA)
            if: availableB != 0
                b: c.lmx_graph_value_in(arena, current\varB, indexB)
            if: (availableA != 0 && a = 0) || (availableB != 0 && b = 0)
                answer: c.LMX_IMPLEMENTS_NO
                break
            ---
            # Preserve the selected physical pair. Only an actually entered
            # graph edge or CALL reads a low box; holding does not load it.
            rawA: a
            rawB: b
            lowA: lmx_implements_low_candidate(arena, a)
            lowB: lmx_implements_low_candidate(arena, b)
            lowC: lmx_implements_low_reference_type(arena, c)
            logical_graph: (cast: (int) (kindC = c.LMX_KIND_STRUCT || kindC = c.LMX_KIND_ARRAY || lowC != c.LMX_TYPE_NONE))
            loadedA: 0
            loadedB: 0
            borrowedA: 0
            borrowedB: 0
            if: logical_graph != 0
                consumer_answer: c.LMX_IMPLEMENTS_YES
                if: lowC != c.LMX_TYPE_NONE
                    status: lmx_implements_low_model(arena, (cast: (@: c.Lmx) current\consumer), index, c, reference_frame, @ consumer_model, @ consumer_references, @ consumer_answer)
                    if: status != c.LMX_WALK_OK
                        break
                    if: consumer_answer = c.LMX_IMPLEMENTS_YES
                        c: (cast: (@: void) consumer_model)
                        reference_frame: consumer_references
                        kindC: lmx_domain_kind(arena, c)
                        typeC: lmx_domain_type(arena, c)
                    else:
                        uncertain: 1
                    ---
                ---
                field_answer: c.LMX_IMPLEMENTS_YES
                other_answer: c.LMX_IMPLEMENTS_YES
                if: availableA != 0
                    field_answer: lmx_implements_graph_holding(arena, a, kindC, typeC, lowC)
                if: availableB != 0
                    other_answer: lmx_implements_graph_holding(arena, b, kindC, typeC, lowC)
                if: field_answer = c.LMX_IMPLEMENTS_NO || other_answer = c.LMX_IMPLEMENTS_NO
                    answer: c.LMX_IMPLEMENTS_NO
                    break
                if: enter = 0 && called = 0
                    if: field_answer != c.LMX_IMPLEMENTS_YES || other_answer != c.LMX_IMPLEMENTS_YES
                        uncertain: 1
                    continue
                ---
                if: availableA != 0 && lowA != c.LMX_TYPE_NONE
                    if: c.lmx_pointer_pool_in(arena, rawA) = 0
                        availableA: 0
                        uncertain: 1
                    else:
                        status: c.lmx_walk_value_load(arena, rawA, lowA, @ valueA)
                        if: status != c.LMX_WALK_OK
                            break
                        if: valueA\present != 0 && valueA\kind != c.LMX_WALK_VALUE_REFERENCE
                            answer: c.LMX_IMPLEMENTS_NO
                            break
                        loadedA: 1
                        a: (cast: (@: void) valueA\ref)
                        if: valueA\present = 0
                            a: 0
                        ---
                    ---
                ---
                if: availableB != 0 && lowB != c.LMX_TYPE_NONE
                    if: rawB = rawA && loadedA != 0
                        c.memcpy((cast: (@: void) (@ valueB)), (cast: (@: void) (@ valueA)), c.sizeof(c.LmxWalkValue))
                        loadedB: 1
                    else:
                        if: c.lmx_pointer_pool_in(arena, rawB) = 0
                            availableB: 0
                            uncertain: 1
                        else:
                            status: c.lmx_walk_value_load(arena, rawB, lowB, @ valueB)
                            if: status != c.LMX_WALK_OK
                                break
                            loadedB: 1
                        ---
                    ---
                    if: loadedB != 0
                        if: valueB\present != 0 && valueB\kind != c.LMX_WALK_VALUE_REFERENCE
                            answer: c.LMX_IMPLEMENTS_NO
                            break
                        b: (cast: (@: void) valueB\ref)
                        if: valueB\present = 0
                            b: 0
                        ---
                    ---
                ---
                # An unclassified side is unavailable evidence. A known
                # incompatible payload or a called null is still a real NO.
                if: availableA != 0 && a != 0
                    if: lmx_domain_kind(arena, a) = c.LMX_KIND_NONE
                        availableA: 0
                        uncertain: 1
                    else:
                        if: c.lmx_graph_node_in(arena, a) = 0
                            answer: c.LMX_IMPLEMENTS_NO
                            break
                        ---
                    ---
                ---
                if: availableB != 0 && b != 0
                    if: lmx_domain_kind(arena, b) = c.LMX_KIND_NONE
                        availableB: 0
                        uncertain: 1
                    else:
                        if: c.lmx_graph_node_in(arena, b) = 0
                            answer: c.LMX_IMPLEMENTS_NO
                            break
                        ---
                    ---
                ---
                # A low DESC reference still promises an Array when its
                # declaration Model is unavailable or structurally narrower.
                # Inspect only the already loaded payload, without replay.
                if: c.lmx_type_base(lowC) = c.LMX_TYPE_DESC && ((availableA != 0 && a != 0 && lmx_domain_kind(arena, a) != c.LMX_KIND_ARRAY) || (availableB != 0 && b != 0 && lmx_domain_kind(arena, b) != c.LMX_KIND_ARRAY))
                    answer: c.LMX_IMPLEMENTS_NO
                    break
                if: (availableA != 0 && a = 0) || (availableB != 0 && b = 0)
                    if: called != 0 || level != 0U
                        answer: c.LMX_IMPLEMENTS_NO
                        break
                    if: (availableA = 0 || a = 0) && (availableB = 0 || b = 0)
                        continue
                    if: availableA != 0 && a = 0
                        a: b
                        borrowedA: 1
                    if: availableB != 0 && b = 0
                        b: a
                        borrowedB: 1
                    ---
                ---
                if: availableA = 0 && availableB = 0
                    continue
                if: consumer_answer != c.LMX_IMPLEMENTS_YES
                    # Actual CALL rows retain their original Consumer site
                    # even when this low box supplies no usable Model yet.
                    if: called != 0
                        if: availableA != 0
                            status: lmx_implements_require_calls(arena, (cast: (@: c.Lmx) a), uses, coverage_cell, resolver, @ field_answer)
                            if: status != c.LMX_WALK_OK
                                break
                            ---
                        ---
                        if: availableB != 0 && (availableA = 0 || b != a)
                            status: lmx_implements_require_calls(arena, (cast: (@: c.Lmx) b), uses, coverage_cell, resolver, @ field_answer)
                            if: status != c.LMX_WALK_OK
                                break
                            ---
                        ---
                    ---
                    continue
                ---
            ---
            # The known side is still checked against this interface even
            # when the other's coordinate is unavailable. The sticky UNKNOWN
            # records that this does not establish the unavailable side.
            if: availableA = 0
                a: b
            if: availableB = 0
                b: a
            kindA: lmx_domain_kind(arena, a)
            kindB: lmx_domain_kind(arena, b)
            if: kindC = c.LMX_KIND_NONE
                uncertain: 1
                continue
            if: kindA = c.LMX_KIND_NONE
                uncertain: 1
                if: kindB = c.LMX_KIND_NONE
                    continue
                a: b
                kindA: kindB
            if: kindB = c.LMX_KIND_NONE
                uncertain: 1
                b: a
                kindB: kindA
            ---
            if: kindA != kindC || kindB != kindC
                # Every graph Array is also a Structure, but an explicitly
                # requested Array<T> remains the exact typed Array contract.
                if: kindC != c.LMX_KIND_STRUCT || c.lmx_graph_node_in(arena, a) = 0 || c.lmx_graph_node_in(arena, b) = 0
                    answer: c.LMX_IMPLEMENTS_NO
                    break
                ---
            ---
            # Queue every actual Consumer occurrence in this same operation.
            # The old transport gate remains until selected ABI materialization
            # replaces its Consumer-sized native storage; it is not the new
            # actual-CALL proof. No new binding map is published.
            if: called != 0
                status: lmx_implements_require_calls(arena, (cast: (@: c.Lmx) c.lmx_graph_node_in(arena, a)), uses, coverage_cell, resolver, @ field_answer)
                if: status != c.LMX_WALK_OK
                    break
                if: field_answer != c.LMX_IMPLEMENTS_YES
                    uncertain: 1
                if: b != a
                    status: lmx_implements_require_calls(arena, (cast: (@: c.Lmx) c.lmx_graph_node_in(arena, b)), uses, coverage_cell, resolver, @ field_answer)
                    if: status != c.LMX_WALK_OK
                        break
                    if: field_answer != c.LMX_IMPLEMENTS_YES
                        uncertain: 1
                ---
                answer: lmx_implements_call_takes(arena, a, c)
                other_answer: answer
                if: b != a
                    other_answer: lmx_implements_call_takes(arena, b, c)
                if: answer = c.LMX_IMPLEMENTS_NO || other_answer = c.LMX_IMPLEMENTS_NO
                    answer: c.LMX_IMPLEMENTS_NO
                    break
                if: answer != c.LMX_IMPLEMENTS_YES || other_answer != c.LMX_IMPLEMENTS_YES
                    uncertain: 1
                continue
            ---
            if: kindC = c.LMX_KIND_PRIMITIVE && typeC >= c.LMX_TYPE_POINTER_BASE && typeC < c.LMX_TYPE_ARRAY_OF_POINTER_BASE
                if: c.lmx_type_base(lmx_domain_type(arena, a)) != c.lmx_type_base(typeC) || c.lmx_type_base(lmx_domain_type(arena, b)) != c.lmx_type_base(typeC)
                    answer: c.LMX_IMPLEMENTS_NO
                    break
                ---
                reference: required\reference
                if: field_answer != c.LMX_IMPLEMENTS_YES && enter != 0
                    # Only entering the pointee consumes its unavailable
                    # Model. Merely holding/passing the pointer uses its type.
                    uncertain: 1
                    continue
                if: reference != 0
                    if: enter = 0
                        continue
                    if: c.lmx_pointer_pool_in(arena, a) = 0
                        uncertain: 1
                        if: c.lmx_pointer_pool_in(arena, b) = 0
                            continue
                        a: b
                    if: c.lmx_pointer_pool_in(arena, b) = 0
                        uncertain: 1
                        b: a
                    ---
                    a: c.lmx_pointer_value_in(arena, a)
                    b: c.lmx_pointer_value_in(arena, b)
                    # Null carries its declared type but no object to walk.
                    # A Consumer entering a concrete used path still requires
                    # that path; full type admission checks every present object.
                    if: a = 0 || b = 0
                        if: level != 0U
                            answer: c.LMX_IMPLEMENTS_NO
                            break
                        if: a = 0 && b = 0
                            continue
                        if: a = 0
                            a: b
                        if: b = 0
                            b: a
                    ---
                    if: c.lmx_graph_node_in(arena, a) = 0 || c.lmx_graph_node_in(arena, b) = 0
                        answer: c.LMX_IMPLEMENTS_NO
                        break
                    ---
                    c: (cast: (@: void) reference)
                    kindC: lmx_domain_kind(arena, c)
                    typeC: lmx_domain_type(arena, c)
                else:
                    if: enter != 0 && level != 0U
                        uncertain: 1
                        continue
                    ---
                ---
            ---
            # An explicit used subtree enters ANY graph Structure, including
            # a typed Array. Whole Array transport still promises its element
            # storage type, not the exemplar's dynamic length. No index or
            # reference consumer has a second traversal after this DFS.
            if: kindC = c.LMX_KIND_STRUCT || (kindC = c.LMX_KIND_ARRAY && level != 0U)
                # A reference the coverage holds and does not enter is consumed
                # by its presence in the Structure domain alone.
                if: enter = 0
                    continue
                source_childA: 0
                source_childB: 0
                source_referencesA: current\source_referencesA
                source_referencesB: current\source_referencesB
                source_answerA: c.LMX_IMPLEMENTS_UNKNOWN
                source_answerB: c.LMX_IMPLEMENTS_UNKNOWN
                if: availableA != 0 && borrowedA = 0 && (logical_graph = 0 || loadedA = 0 || valueA\model = 0)
                    status: lmx_implements_source_child_parts(arena, (cast: (@: c.Lmx) current\source), (cast: (@: c.LmxImplEntry) @ current\source_bridge), index, last, (cast: (@: c.Lmx) current\source_referencesA), @ source_childA, @ source_referencesA, @ source_answerA)
                    if: status != c.LMX_WALK_OK
                        break
                    ---
                ---
                if: availableB != 0 && borrowedB = 0 && (logical_graph = 0 || loadedB = 0 || valueB\model = 0)
                    status: lmx_implements_source_child_parts(arena, (cast: (@: c.Lmx) current\sourceB), (cast: (@: c.LmxImplEntry) @ current\source_bridgeB), index, last, (cast: (@: c.Lmx) current\source_referencesB), @ source_childB, @ source_referencesB, @ source_answerB)
                    if: status != c.LMX_WALK_OK
                        break
                    ---
                ---
                # A loaded box's saved giving namespace is independent of
                # its payload and wins over declaration fallback. Its exact
                # sheet (including zero) accompanies that namespace.
                if: logical_graph != 0 && availableA != 0 && loadedA != 0 && valueA\model != 0
                    source_answerA: c.LMX_IMPLEMENTS_UNKNOWN
                    source_childA: 0
                    if: c.lmx_graph_node_in(arena, (cast: (@: void) valueA\model)) != 0 && (valueA\references = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) valueA\references)) != 0)
                        source_childA: (cast: (@: c.Lmx) valueA\model)
                        source_referencesA: (cast: (@: c.Lmx) valueA\references)
                        source_answerA: c.LMX_IMPLEMENTS_YES
                    ---
                ---
                if: logical_graph != 0 && availableB != 0 && loadedB != 0 && valueB\model != 0
                    source_answerB: c.LMX_IMPLEMENTS_UNKNOWN
                    source_childB: 0
                    if: c.lmx_graph_node_in(arena, (cast: (@: void) valueB\model)) != 0 && (valueB\references = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) valueB\references)) != 0)
                        source_childB: (cast: (@: c.Lmx) valueB\model)
                        source_referencesB: (cast: (@: c.Lmx) valueB\references)
                        source_answerB: c.LMX_IMPLEMENTS_YES
                    ---
                ---
                if: borrowedA != 0
                    source_childA: source_childB
                    source_referencesA: source_referencesB
                    source_answerA: source_answerB
                if: borrowedB != 0
                    source_childB: source_childA
                    source_referencesB: source_referencesA
                    source_answerB: source_answerA
                if: source_answerA != c.LMX_IMPLEMENTS_YES || source_answerB != c.LMX_IMPLEMENTS_YES
                    uncertain: 1
                if: source_answerA != c.LMX_IMPLEMENTS_YES && source_answerB != c.LMX_IMPLEMENTS_YES
                    continue
                found: seen
                while: found != 0
                    if: found\varA = (cast: (@: c.Lmx) a) && found\varB = (cast: (@: c.Lmx) b) && found\consumer = (cast: (@: c.Lmx) c) && found\references = reference_frame && found\level = level && found\source = source_childA && found\sourceB = source_childB && found\source_referencesA = source_referencesA && found\source_referencesB = source_referencesB && found\viewA_result = source_answerA && found\viewB_result = source_answerB
                        break
                    found: found\seen_next
                ---
                if: found = 0
                    scratch_status: c.lmx_scratch_take(work, c.sizeof(c.LmxImplementsFrame), @ room)
                    if: scratch_status != c.LMX_SCRATCH_OK
                        status: c.LMX_WALK_INVALID
                        if: scratch_status = c.LMX_SCRATCH_NOMEM
                            status: c.LMX_WALK_NOMEM
                        break
                    ---
                    child: (cast: (@: c.LmxImplementsFrame) room)
                    child\varA: (cast: (@: c.Lmx) a)
                    child\varB: (cast: (@: c.Lmx) b)
                    child\consumer: (cast: (@: c.Lmx) c)
                    child\references: reference_frame
                    child\source: source_childA
                    child\sourceB: source_childB
                    child\source_referencesA: source_referencesA
                    child\source_referencesB: source_referencesB
                    c.memset((cast: (@: void) (@ child\source_bridge)), 0, c.sizeof(c.LmxImplEntry))
                    c.memset((cast: (@: void) (@ child\source_bridgeB)), 0, c.sizeof(c.LmxImplEntry))
                    child\viewA: 0
                    child\viewB: 0
                    child\viewA_result: source_answerA
                    child\viewB_result: source_answerB
                    child\viewA_unknown: 0
                    child\viewB_unknown: 0
                    child\view_ready: 0
                    child\index: 0U
                    child\level: level
                    child\caller: current
                    child\seen_next: seen
                    seen: child
                    current: child
                ---
            else:
                # A field of an immutable value is the same field (the book: "Передача, возврат и сохранение неизменяемого значения сохраняют его идентичность"; the
                # qualifier is the sign of the physical type, and a reached write is refused where it is written).
                if: c.lmx_type_base(lmx_domain_type(arena, a)) != c.lmx_type_base(typeC) || c.lmx_type_base(lmx_domain_type(arena, b)) != c.lmx_type_base(typeC)
                    answer: c.LMX_IMPLEMENTS_NO
                    break
                ---
            ---
        ---
    ---
    if: owns_scratch != 0
        if: status = c.LMX_WALK_OK && answer != c.LMX_IMPLEMENTS_NO
            status: lmx_implements_drain(arena, resolver, @ other_answer)
            if: other_answer = c.LMX_IMPLEMENTS_NO
                answer: c.LMX_IMPLEMENTS_NO
            if: other_answer != c.LMX_IMPLEMENTS_YES
                uncertain: 1
        ---
        lmx_implements_resolve_close(arena, resolver, 0)
        c.lmx_scratch_close(@ scratch)
        c.lmx_arena_release(@ temporary)
    ---
    if: status = c.LMX_WALK_OK && answer != c.LMX_IMPLEMENTS_NO && uncertain != 0
        answer: c.LMX_IMPLEMENTS_UNKNOWN
    if: status = c.LMX_WALK_OK
        out_answer[0]: answer
    return: status
end: lmx_implements_walk_project_resolve

fn: lmx_implements_walk_project_views (@: arena c.LmxArena; @: varA c.Lmx; @: varB c.Lmx; @: consumer c.Lmx; @: pending c.LmxImplEntry; size_t: pending_n; int: skip_unused; int: interface; @: uses c.LmxImplUses) int
    # Public query boundary keeps its existing triad. A mutating admission
    # calls the status-bearing operation directly instead of this adapter.
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    if: lmx_implements_walk_project_resolve(arena, varA, varB, consumer, pending, pending_n, skip_unused, interface, uses, 0, @ answer) != c.LMX_WALK_OK
        return: c.LMX_IMPLEMENTS_UNKNOWN
    return: answer
end: lmx_implements_walk_project_views

fn: lmx_implements_walk_project (@: arena c.LmxArena; @: varA c.Lmx; @: varB c.Lmx; @: consumer c.Lmx; @: pending c.LmxImplEntry; int: skip_unused; int: interface; @: uses c.LmxImplUses) int
    size_t: count 0U
    if: pending != 0
        count: 1U
    return: lmx_implements_walk_project_views(arena, varA, varB, consumer, pending, count, skip_unused, interface, uses)
end: lmx_implements_walk_project

fn: lmx_implements_receiving_views (@: arena c.LmxArena; @: varA c.Lmx; @: varB c.Lmx; @: model c.Lmx; @: pending c.LmxImplEntry; size_t: count; @: uses c.LmxImplUses) int
    return: lmx_implements_walk_project_views(arena, varA, varB, model, pending, count, 0, 1, uses)
end: lmx_implements_receiving_views

fn: lmx_implements_walk_view (@: arena c.LmxArena; @: varA c.Lmx; @: varB c.Lmx; @: consumer c.Lmx; @: pending c.LmxImplEntry; int: skip_unused) int
    return: lmx_implements_walk_project(arena, varA, varB, consumer, pending, skip_unused, 0, 0)
end: lmx_implements_walk_view

# Full reception checks every interface field, including named holes. This is
# independent of whether a correspondence is pending, cached or positional.
fn: lmx_implements_receiver_view (@: arena c.LmxArena; @: varA c.Lmx; @: varB c.Lmx; @: model c.Lmx; @: pending c.LmxImplEntry) int
    return: lmx_implements_walk_project(arena, varA, varB, model, pending, 0, 1, 0)
end: lmx_implements_receiver_view

# Reception by the coverage of the instruction being run. The coverage is this
# call's argument and nothing else's: the record of the pair, pending or kept,
# gives physical places and no permission. Null coverage is the full reception.
fn: lmx_implements_receiving_use (@: arena c.LmxArena; @: varA c.Lmx; @: varB c.Lmx; @: model c.Lmx; @: pending c.LmxImplEntry; @: uses c.LmxImplUses) int
    return: lmx_implements_walk_project(arena, varA, varB, model, pending, 0, 1, uses)
end: lmx_implements_receiving_use

fn: lmx_implements_walk (@: arena c.LmxArena; @: varA c.Lmx; @: varB c.Lmx; @: consumer c.Lmx) int
    return: lmx_implements_walk_view(arena, varA, varB, consumer, 0, 0)
end: lmx_implements_walk

fn: lmx_runtime_implements (@: arena c.LmxArena; @: varA c.Lmx; @: varB c.Lmx; @: consumer c.Lmx) int
    if: arena = 0
        return: c.LMX_IMPLEMENTS_UNKNOWN
    return: lmx_implements_walk(arena, varA, varB, consumer)
end: lmx_runtime_implements

# D-105 (the author's Q39, 2026-09-27, LMX_blog/2026-09-27.md: "если поставляется исходная
# структура то берется прямо по смещению исходной. Если подставляется другая то надо ей прикрепить
# таблицу преобразований индексов. ОЧевидное место длятакой таблице -- сам implements. Все равно
# там тяжелеовесный только первый implements должен быть а в дальнейших проверках он должен брать
# соответствие адресов из своей таблицы").  The slot_table is the arena's (LmxArena.impl): the arena
# is the context of every question in this unit, and its values are what the records name.  A record is a view of
# its correspondence (LmxImplEntry), never a Structure made for it (Codex, 2026-09-28).

# Slot j of view e: the place of req's field j in the value -- the admitting frame's size cell frame[at + j], the
# static map's map[j], or j itself (the value's own layout; with holes, an empty slot is not carried).  0 and *out
# (SIZE_MAX: not carried), or 1 when the view has no slot j.
#
# This is the ORDINAL half: the value's field NAMED as req's field j, at j's own occurrence
# among the required same-named fields.  A bare path names the value's LAST occurrence of the
# name instead, and reads the second half (lmx_implements_at_last, K01); the two halves are
# one entry, two cells per required field, never two correspondences.
# With holes -- a capture's copy of what its model reads (item 738), a partial copy (lmx_copy_carry_records) -- a place
# the value holds no object at was not carried: *out becomes SIZE_MAX, through the admitting frame, the static map or
# the value's own layout alike.  0.
fn: lmx_implements_hole (@: arena c.LmxArena; @: e c.LmxImplEntry; @: out size_t) int
    @: part_e_value_array c.VoidArray 0
    size_t: k \out
    if: e != 0 && e\value != 0
        part_e_value_array: (cast: (@: c.VoidArray) (@ e\value\array))
    ---
    if: e\holes != 0 && k != (cast: (size_t) -1) && (e\value = 0 || k >= part_e_value_array\size || c.lmx_graph_value_in(arena, e\value, k) = 0)
        \out: (cast: (size_t) -1)
    return: 0
end: lmx_implements_hole

# Read-only decoding of physical coordinate metadata. Immutable size/token
# cells have the same representation but remain distinct full storage types.
# This is not candidate/required-type admission or authority to write them.
fn: lmx_implements_metadata_cell (@: arena c.LmxArena; @: cell void; int: expected_type; size_t: width) int
    if: cell = 0 || lmx_domain_kind(arena, cell) != c.LMX_KIND_PRIMITIVE || c.lmx_type_base(lmx_domain_type(arena, cell)) != expected_type || c.lmx_range_stride(arena, cell) != width
        return: 0
    return: 1
end: lmx_implements_metadata_cell

# Decode only the retained numeric place, independently of its current value.
# Operation-local uncertainty describes an unset coordinate, not the current
# emptiness of an already selected physical slot. The public readers below
# keep applying the ordinary carried-value hole rule after this same decoder.
fn: lmx_implements_coordinate (@: arena c.LmxArena; @: e c.LmxImplEntry; size_t: j; int: last; @: out size_t) int
    @: cell void
    @: at size_t
    size_t: offset
    if: e = 0 || out = 0
        return: 1
    if: e\frame != 0
        if: j >= e\n
            return: 1
        offset: e\at
        if: last != 0
            if: e\n > (cast: (size_t) -1) - offset
                return: 1
            offset: offset + e\n
        if: j > (cast: (size_t) -1) - offset
            return: 1
        cell: c.lmx_graph_value_in(arena, e\frame, offset + j)
        if: lmx_implements_metadata_cell(arena, cell, c.LMX_TYPE_SIZE_T, c.sizeof(c.size_t)) = 0
            return: 1
        at: (cast: (@: size_t) cell)
        \out: at[0]
    else:
        if: e\map != 0
            if: j >= e\n
                return: 1
            offset: j
            if: last != 0
                if: e\n > (cast: (size_t) -1) - offset
                    return: 1
                offset: offset + e\n
            \out: e\map[offset]
        else:
            \out: j
        ---
    ---
    return: 0
end: lmx_implements_coordinate

# Import numeric metadata without treating an unset place as proved absence.
# This physical path never inspects names or current cell values.
fn: lmx_implements_unset_mask (@: arena c.LmxArena; @: view c.LmxImplEntry; size_t: width; @@: out size_t) int
    @: mask size_t 0
    size_t: i 0U
    size_t: index
    size_t: slot
    int: last
    if: out = 0
        return: c.LMX_WALK_INVALID
    \out: 0
    if: view = 0
        return: c.LMX_WALK_INVALID
    if: width > ((cast: (size_t) -1) / c.sizeof(c.size_t)) / 2U
        return: c.LMX_WALK_NOMEM
    while: i < width * 2U
        index: i
        last: 0
        if: i >= width
            index: i - width
            last: 1
        if: lmx_implements_coordinate(arena, view, index, last, @ slot) != 0
            c.free((cast: (@: void) mask))
            return: c.LMX_WALK_INVALID
        if: slot = (cast: (size_t) -1)
            if: mask = 0
                mask: (cast: (@: size_t) c.calloc(width * 2U, c.sizeof(c.size_t)))
                if: mask = 0
                    return: c.LMX_WALK_NOMEM
                ---
            ---
            mask[i]: 1U
        ---
        i: i + 1U
    ---
    \out: mask
    return: c.LMX_WALK_OK
end: lmx_implements_unset_mask

fn: lmx_implements_at (@: arena c.LmxArena; @: e c.LmxImplEntry; size_t: j; @: out size_t) int
    if: lmx_implements_coordinate(arena, e, j, 0, out) != 0
        return: 1
    return: lmx_implements_hole(arena, e, out)
end: lmx_implements_at

# The LAST half of a view: the place of req's field j for a BARE path, whose name selects
# the value's last occurrence of it (K01).  The admitting frame's second half of cells, the
# static map's second half, or -- an entry with neither, whose proof is positional equality
# with req -- the same slot as the ordinal half.
fn: lmx_implements_at_last (@: arena c.LmxArena; @: e c.LmxImplEntry; size_t: j; @: out size_t) int
    if: lmx_implements_coordinate(arena, e, j, 1, out) != 0
        return: 1
    return: lmx_implements_hole(arena, e, out)
end: lmx_implements_at_last

# The record of (value, req), or null.
fn: lmx_implements_find (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx) @: c.LmxImplEntry
    size_t: i 0U
    @: e c.LmxImplEntry
    if: arena = 0 || arena\impl = 0 || value = 0 || req = 0
        return: 0
    while: i < arena\impl_len
        e: arena\impl + i
        if: e\value = value && e\req = req
            return: e
        i: i + 1U
    ---
    return: 0
end: lmx_implements_find

# Whether a completed reception proved value identical, by position, with the declaration whose own layout token
# is `layout`: a record of (value, that declaration) with neither frame nor map and no holes.  A value with no
# layout of its own -- a letter -- that the positional check admitted into a place of a declaration has that
# record.  It is evidence of where that declaration's fields are in this value and of nothing else: the value's
# own layout stays unknown.  The declaration is the one whose own record carries the token; that record is its
# self-registration and certifies no other value, and a value's record with itself is never asked.  Read only:
# nothing is recorded or published, and no record is handed out -- the slot_table moves when it grows.  1 or 0.
fn: lmx_implements_identity (@: arena c.LmxArena; @: value c.Lmx; @: layout void) int
    size_t: i 0U
    @: e c.LmxImplEntry
    if: arena = 0 || arena\impl = 0 || value = 0 || layout = 0
        return: 0
    while: i < arena\impl_len
        e: arena\impl + i
        if: e\value = value && e\req != 0 && e\req != value && e\frame = 0 && e\map = 0 && e\holes = 0 && e\reception_proof != 1
            if: lmx_implements_layout(arena, (cast: (@: c.Lmx) e\req)) = layout
                return: 1
            ---
        i: i + 1U
    ---
    return: 0
end: lmx_implements_identity

# Compose TWO coordinate relations, independently of where their evidence
# came from. Both the declared source and unqualified alternatives use it.
# No type permission, names or physical-origin inference happens here.
fn: lmx_implements_project_view (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: source c.LmxImplEntry; @: source_unknown size_t; @: pair c.LmxImplEntry; @: pair_unknown size_t; @: out c.LmxImplEntry; @@: out_unknown size_t; @: out_answer int) int
    @: part_req_array c.VoidArray 0
    @: part_source_req_array c.VoidArray 0
    @: map size_t 0
    @: unknown size_t 0
    size_t: width
    size_t: source_width
    size_t: i 0U
    size_t: index
    size_t: source_index
    size_t: middle
    size_t: slot
    int: last
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: out_unknown = 0
        return: c.LMX_WALK_INVALID
    \out_unknown: 0
    if: out = 0 || source = 0 || pair = 0 || req = 0 || source\req = 0 || out = source || out = pair
        return: c.LMX_WALK_INVALID
    c.memset((cast: (@: void) out), 0, c.sizeof(c.LmxImplEntry))
    if: c.lmx_graph_node_in(arena, (cast: (@: void) req)) = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) source\req)) = 0
        return: c.LMX_WALK_INVALID
    if: req != 0
        part_req_array: (cast: (@: c.VoidArray) (@ req\array))
    ---
    width: part_req_array\size
    part_source_req_array: (cast: (@: c.VoidArray) (@ source\req\array))
    source_width: part_source_req_array\size
    if: pair\n != width
        return: c.LMX_WALK_OK
    if: width > ((cast: (size_t) -1) / c.sizeof(c.size_t)) / 2U || source_width > ((cast: (size_t) -1) / c.sizeof(c.size_t)) / 2U
        return: c.LMX_WALK_NOMEM
    if: width != 0U
        map: (cast: (@: size_t) c.malloc(width * 2U * c.sizeof(c.size_t)))
        if: map = 0
            return: c.LMX_WALK_NOMEM
        ---
        if: source_unknown != 0 || pair_unknown != 0
            unknown: (cast: (@: size_t) c.calloc(width * 2U, c.sizeof(c.size_t)))
            if: unknown = 0
                c.free((cast: (@: void) map))
                return: c.LMX_WALK_NOMEM
            ---
        ---
    ---
    # Each half uses the same half of the intermediate source relation.
    # An unavailable pair coordinate supplies no middle index to dereference.
    while: i < width * 2U
        index: i
        last: 0
        if: i >= width
            index: i - width
            last: 1
        ---
        if: pair_unknown != 0 && pair_unknown[i] != 0U
            map[i]: (cast: (size_t) -1)
            unknown[i]: 1U
            i: i + 1U
            continue
        if: lmx_implements_coordinate(arena, pair, index, last, @ middle) != 0
            break
        slot: middle
        if: middle != (cast: (size_t) -1)
            if: middle >= source_width
                break
            source_index: middle
            if: last != 0
                source_index: source_width + middle
            if: source_unknown != 0 && source_unknown[source_index] != 0U
                slot: (cast: (size_t) -1)
                unknown[i]: 1U
            else:
                if: lmx_implements_coordinate(arena, source, middle, last, @ slot) != 0
                    break
            ---
        ---
        map[i]: slot
        i: i + 1U
    ---
    if: i = width * 2U
        out\value: value
        out\req: req
        out\layout: lmx_implements_layout(arena, value)
        out\map: map
        out\n: width
        if: map != 0
            out\owned_map: 1
        \out_unknown: unknown
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    ---
    if: map != 0
        c.free((cast: (@: void) map))
    if: unknown != 0
        c.free((cast: (@: void) unknown))
    return: c.LMX_WALK_INVALID
end: lmx_implements_project_view

# A declared namespace is an address of an ordinary current Model, not a
# layout or a class number. Only evidence for THIS value/Model pair answers.
# The retained bridge is logical requirement -> logical giving declaration;
# the returned view is already physical and must not be projected again.
fn: lmx_implements_source_view (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: source c.Lmx; @: resolver c.LmxImplResolve; @: out c.LmxImplEntry; @: bridge c.LmxImplEntry; @: applied int; @@: out_unknown size_t; @: out_answer int) int
    @: part_req_array c.VoidArray 0
    @: part_source_array c.VoidArray 0
    const: (@: part_item_correspondence c.LmxImplEntry)
    @: stored c.LmxImplEntry
    c.LmxImplEntry: normalized
    c.LmxImplEntry: pair
    c.LmxImplEntry: candidate
    c.LmxImplEntry: held_bridge
    @: bridge_room void 0
    @: pair_unknown size_t 0
    @: projected_unknown size_t 0
    @: source_unknown size_t 0
    const: (@: item c.LmxImplTemplate)
    @: source_layout void
    @: required_layout void
    size_t: i 0U
    size_t: width
    int: source_owned 0
    int: pair_owned 0
    int: scratch_status
    int: found 0
    int: owns 0
    int: matched_template 0
    int: special_done 0
    int: logical_applied 0
    int: answer c.LMX_IMPLEMENTS_YES
    int: status c.LMX_WALK_OK
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: out_unknown = 0
        return: c.LMX_WALK_INVALID
    \out_unknown: 0
    if: applied = 0 || bridge = 0 || out = 0 || resolver = 0
        return: c.LMX_WALK_INVALID
    \applied: 0
    c.memset((cast: (@: void) out), 0, c.sizeof(c.LmxImplEntry))
    c.memset((cast: (@: void) bridge), 0, c.sizeof(c.LmxImplEntry))
    if: c.lmx_graph_node_in(arena, (cast: (@: void) req)) = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) value)) = 0
        return: c.LMX_WALK_INVALID
    if: c.lmx_graph_node_in(arena, (cast: (@: void) source)) = 0
        return: c.LMX_WALK_OK
    part_req_array: (cast: (@: c.VoidArray) (@ req\array))
    width: part_req_array\size
    source_layout: lmx_implements_layout(arena, source)
    required_layout: lmx_implements_layout(arena, req)
    stored: lmx_implements_find(arena, value, source)
    if: stored != 0
        if: source != 0
            part_source_array: (cast: (@: c.VoidArray) (@ source\array))
        ---
        status: lmx_implements_rebase_view(arena, stored, (cast: (size_t) (part_source_array\size)), @ normalized, @ source_owned, @ answer)
        if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
            out_answer[0]: answer
            return: status
        ---
    else:
        if: value != source && (source_layout = 0 || source_layout != lmx_implements_layout(arena, value))
            # Resolve this exact CURRENT giving Model, never another old
            # admission or receiving namespace in its place.
            status: lmx_implements_direct_view(arena, value, source, resolver, @ normalized, @ found, @ answer)
            if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
                out_answer[0]: answer
                return: status
            # With no physical-template evidence, the ordinary name matcher
            # may construct these coordinates for a runtime-built value.
            # This is not a type proof; the same used-interface walk follows.
            if: found = 0
                status: lmx_implements_named_view(arena, value, source, @ normalized, @ found, @ answer)
                if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
                    out_answer[0]: answer
                    return: status
                ---
                if: found = 0
                    # named_view has no coordinates for an empty Model.
                    # This is a width-zero relation, not value's identity.
                    normalized\value: value
                    normalized\req: source
                    normalized\n: 0U
                ---
            ---
            source_owned: normalized\owned_map
            found: 0
        else:
            c.memset((cast: (@: void) (@ normalized)), 0, c.sizeof(c.LmxImplEntry))
            normalized\value: value
            normalized\req: source
            if: source != 0
                part_source_array: (cast: (@: c.VoidArray) (@ source\array))
            ---
            normalized\n: part_source_array\size
        ---
    ---
    # Refresh THIS current giving namespace before logical projection.
    # Final physical-hole completion preserves every projected coordinate;
    # it does not replace this selected SOURCE or its nested contracts.
    status: lmx_implements_fill_holes(arena, value, source, @ normalized, @ source_owned, 0, @ source_unknown, @ answer)
    if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        if: source_owned != 0 && normalized\map != 0
            c.free((cast: (@: void) normalized\map))
        out_answer[0]: answer
        return: status
    while: 1
        c.memset((cast: (@: void) (@ pair)), 0, c.sizeof(c.LmxImplEntry))
        pair\value: source
        pair\req: req
        pair\n: width
        pair_owned: 0
        if: source != req && i < resolver\template_count
            item: resolver\templates + i
            i: i + 1U
            if: source_layout = 0 || required_layout = 0 || item\source_layout != source_layout || item\required_layout != required_layout
                continue
            matched_template: 1
            if: item != 0
                part_item_correspondence: (cast: (const: @: c.LmxImplEntry) (@ item\correspondence))
            ---
            pair\map: part_item_correspondence\map
            if: item != 0
                part_item_correspondence: (cast: (const: @: c.LmxImplEntry) (@ item\correspondence))
            ---
            pair\frame: part_item_correspondence\frame
            if: item != 0
                part_item_correspondence: (cast: (const: @: c.LmxImplEntry) (@ item\correspondence))
            ---
            pair\at: part_item_correspondence\at
            if: item != 0
                part_item_correspondence: (cast: (const: @: c.LmxImplEntry) (@ item\correspondence))
            ---
            pair\n: part_item_correspondence\n
            if: item != 0
                part_item_correspondence: (cast: (const: @: c.LmxImplEntry) (@ item\correspondence))
            ---
            pair\holes: part_item_correspondence\holes
        else:
            if: special_done != 0 || (source != req && matched_template != 0)
                break
            special_done: 1
            if: source != req
                # A runtime giving Model needs no prewritten compiler pair.
                # Match that exact logical namespace, then use the SAME
                # projection and interface walk as every prepared template.
                status: lmx_implements_named_view(arena, source, req, @ pair, @ logical_applied, @ answer)
                if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
                    break
                if: logical_applied = 0
                    break
                pair_owned: pair\owned_map
            ---
        ---
        \applied: 1
        status: lmx_implements_view_valid(arena, @ pair, width, @ answer)
        if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
            break
        # A template's MAX is unavailable compiler correspondence, not a
        # negative fact about the CURRENT logical giving Model.
        status: lmx_implements_fill_holes(arena, source, req, @ pair, @ pair_owned, 0, @ pair_unknown, @ answer)
        if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
            break
        if: found != 0 && lmx_implements_same_map(arena, bridge, @ pair, width) = 0
            answer: c.LMX_IMPLEMENTS_UNKNOWN
            break
        if: found = 0
            c.memcpy((cast: (@: void) (@ held_bridge)), (cast: (@: void) (@ pair)), c.sizeof(c.LmxImplEntry))
            if: pair_owned != 0 && pair\map != 0
                scratch_status: c.lmx_scratch_take(resolver\scratch, width * 2U * c.sizeof(c.size_t), @ bridge_room)
                if: scratch_status != c.LMX_SCRATCH_OK
                    status: c.LMX_WALK_INVALID
                    if: scratch_status = c.LMX_SCRATCH_NOMEM
                        status: c.LMX_WALK_NOMEM
                    break
                c.memcpy(bridge_room, (cast: (@: void) pair\map), width * 2U * c.sizeof(c.size_t))
                held_bridge\map: (cast: (@: size_t) bridge_room)
                held_bridge\frame: 0
                held_bridge\at: 0U
            ---
            held_bridge\owned_map: 0
            c.memcpy((cast: (@: void) bridge), (cast: (@: void) (@ held_bridge)), c.sizeof(c.LmxImplEntry))
        ---
        status: lmx_implements_project_view(arena, value, req, @ normalized, source_unknown, @ pair, pair_unknown, @ candidate, @ projected_unknown, @ answer)
        if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
            break
        status: lmx_implements_accumulate_view(arena, out, @ owns, @ found, @ candidate, (cast: (int) (candidate\owned_map)), width, @ answer)
        if: status = c.LMX_WALK_OK && answer = c.LMX_IMPLEMENTS_YES && \out_unknown = 0
            \out_unknown: projected_unknown
            projected_unknown: 0
        if: projected_unknown != 0
            c.free((cast: (@: void) projected_unknown))
            projected_unknown: 0
        if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
            break
        ---
        if: pair_owned != 0 && pair\map != 0
            c.free((cast: (@: void) pair\map))
        pair_owned: 0
        if: pair_unknown != 0
            c.free((cast: (@: void) pair_unknown))
            pair_unknown: 0
    ---
    if: pair_owned != 0 && pair\map != 0
        c.free((cast: (@: void) pair\map))
    if: pair_unknown != 0
        c.free((cast: (@: void) pair_unknown))
    if: projected_unknown != 0
        c.free((cast: (@: void) projected_unknown))
    if: source_owned != 0 && normalized\map != 0
        c.free((cast: (@: void) normalized\map))
    if: source_unknown != 0
        c.free((cast: (@: void) source_unknown))
    if: (status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES) && owns != 0 && out\map != 0
        c.free((cast: (@: void) out\map))
        c.memset((cast: (@: void) out), 0, c.sizeof(c.LmxImplEntry))
    ---
    if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        if: \out_unknown != 0
            c.free((cast: (@: void) \out_unknown))
            \out_unknown: 0
    ---
    out_answer[0]: answer
    return: status
end: lmx_implements_source_view

# Every nested edge carries its giving contract through the SAME field
# producer. A pointer's current/default value is never used as its Model.
fn: lmx_implements_source_child_parts (@: arena c.LmxArena; @: source c.Lmx; @: bridge c.LmxImplEntry; size_t: index; int: last; @: references c.Lmx; @@: out c.Lmx; @@: out_references c.Lmx; @: out_answer int) int
    size_t: field
    int: status
    int: base
    c.LmxImplContractFact: fact
    if: out = 0 || out_references = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    \out: 0
    \out_references: references
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: source = 0
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    if: bridge = 0 || bridge\value = 0
        return: c.LMX_WALK_OK
    if: last = 0
        status: lmx_implements_coordinate(arena, bridge, index, 0, @ field)
    else:
        status: lmx_implements_coordinate(arena, bridge, index, 1, @ field)
    if: status != 0
        return: c.LMX_WALK_INVALID
    if: field = (cast: (size_t) -1)
        return: c.LMX_WALK_OK
    status: lmx_implements_contract_field(arena, source, field, 1, references, @ fact, out_answer)
    if: status != c.LMX_WALK_OK || out_answer[0] != c.LMX_IMPLEMENTS_YES
        return: status
    if: fact\kind = c.LMX_KIND_STRUCT || fact\kind = c.LMX_KIND_ARRAY
        \out: (cast: (@: c.Lmx) fact\cell)
    if: fact\kind = c.LMX_KIND_PRIMITIVE && fact\type >= c.LMX_TYPE_POINTER_BASE && fact\type < c.LMX_TYPE_ARRAY_OF_POINTER_BASE
        \out: fact\reference
    if: fact\kind = c.LMX_KIND_PRIMITIVE
        base: fact\type
        base: c.lmx_type_base(base)
        if: base = c.LMX_TYPE_LMX || base = c.LMX_TYPE_DESC
            # Only declaration context is consumed here. Actual candidate
            # payloads are evaluated by their own interface-use operation.
            return: lmx_implements_low_model(arena, source, field, (cast: (@: void) fact\cell), references, out, out_references, out_answer)
        ---
    ---
    # A consumed nested path with a chosen SOURCE cannot silently become
    # unqualified merely because its child Model was not available.
    if: \out = 0
        out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    return: c.LMX_WALK_OK
end: lmx_implements_source_child_parts

# Existing public boundary retains its signature. Internal DFS carries the
# actual returned reference sheet through the parts form above.
fn: lmx_implements_source_child (@: arena c.LmxArena; @: source c.Lmx; @: bridge c.LmxImplEntry; size_t: index; int: last; @: references c.Lmx; @@: out c.Lmx; @: out_answer int) int
    @: selected_references c.Lmx 0
    return: lmx_implements_source_child_parts(arena, source, bridge, index, last, references, out, @ selected_references, out_answer)
end: lmx_implements_source_child

# One admission has proved `value` against a source schema, and this receiver
# has a source-to-target pair map. The source value need not have the schema's
# physical layout: compose the two proved maps instead of guessing its slots
# from the target's positional shape. The input map can be module-static or
# carried by an ADMIT_AS frame. A computed map is copied into the arena only
# after this receiver's Consumer has accepted it.
# Prepare only: no correspondence/proof is published. On YES out owns its
# computed map; the caller either transfers that ownership or frees it.
fn: lmx_implements_compose_view (@: arena c.LmxArena; @: value c.Lmx; @: source_layout void; @: req c.Lmx; @: pair c.LmxImplEntry; @: pair_unknown size_t; int: refresh; @: out c.LmxImplEntry; @: applied int; @@: out_unknown size_t; @: out_answer int) int
    @: part_req_array c.VoidArray 0
    @: part_candidate_req_array c.VoidArray 0
    c.LmxImplEntry: source_storage
    c.LmxImplEntry: normalized_source
    c.LmxImplEntry: row_pair
    c.LmxImplEntry: projected
    @: source c.LmxImplEntry (@ source_storage)
    @: candidate c.LmxImplEntry
    @: projected_unknown size_t 0
    @: normalized_unknown size_t 0
    @: logical_unknown size_t 0
    @: row_pair_unknown size_t 0
    size_t: i 0U
    size_t: width
    size_t: source_width 0U
    int: source_found 0
    int: source_owned 0
    @: conflicts size_t 0
    int: normalized_owned 0
    int: row_pair_owned 0
    int: failed 0
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status c.LMX_WALK_OK
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: out_unknown = 0
        return: c.LMX_WALK_INVALID
    \out_unknown: 0
    if: applied = 0 || out = 0
        return: c.LMX_WALK_INVALID
    if: refresh < 0 || refresh > 1
        return: c.LMX_WALK_INVALID
    \applied: 0
    if: out = pair
        return: c.LMX_WALK_INVALID
    while: arena != 0 && i < arena\impl_len
        if: out = arena\impl + i
            return: c.LMX_WALK_INVALID
        i: i + 1U
    ---
    i: 0U
    c.memset((cast: (@: void) out), 0, c.sizeof(c.LmxImplEntry))
    if: arena = 0 || value = 0 || req = 0 || pair = 0
        return: c.LMX_WALK_INVALID
    if: source_layout = 0
        return: c.LMX_WALK_OK
    if: c.lmx_graph_node_in(arena, (cast: (@: void) value)) = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) req)) = 0
        return: c.LMX_WALK_INVALID
    if: req != 0
        part_req_array: (cast: (@: c.VoidArray) (@ req\array))
    ---
    width: part_req_array\size
    if: pair\n != width
        \applied: 1
        return: c.LMX_WALK_OK
    if: width > ((cast: (size_t) -1) / c.sizeof(c.size_t)) / 2U
        \applied: 1
        return: c.LMX_WALK_NOMEM
    while: i < arena\impl_len
        candidate: arena\impl + i
        if: candidate\value = value && candidate\req != 0 && lmx_implements_layout(arena, (cast: (@: c.Lmx) candidate\req)) = source_layout
            \applied: 1
            if: refresh != 0 || source_found = 0
                if: candidate != 0 && candidate\req != 0
                    part_candidate_req_array: (cast: (@: c.VoidArray) (@ candidate\req\array))
                ---
                source_width: part_candidate_req_array\size
            if: candidate != 0 && candidate\req != 0
                part_candidate_req_array: (cast: (@: c.VoidArray) (@ candidate\req\array))
            ---
            if: refresh = 0 && source_width != part_candidate_req_array\size
                answer: c.LMX_IMPLEMENTS_UNKNOWN
                failed: 1
                break
            ---
            status: lmx_implements_rebase_view(arena, candidate, source_width, @ normalized_source, @ normalized_owned, @ answer)
            if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
                failed: 1
                break
            if: refresh != 0
                status: lmx_implements_fill_holes(arena, value, (cast: (@: c.Lmx) candidate\req), @ normalized_source, @ normalized_owned, 0, @ normalized_unknown, @ answer)
            else:
                # Ordinary accesses compose installed numbers only. They
                # cannot initiate another name/contract admission.
                status: lmx_implements_unset_mask(arena, @ normalized_source, source_width, @ normalized_unknown)
            ---
            if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
                failed: 1
                break
            # The opaque layout token is not a Model. Each bound row owns
            # its CURRENT giving Model; refresh/project in that namespace
            # before combining alternatives in the target's coordinate space.
            c.memcpy((cast: (@: void) (@ row_pair)), (cast: (@: void) pair), c.sizeof(c.LmxImplEntry))
            row_pair\value: (cast: (@: c.Lmx) candidate\req)
            row_pair\req: req
            row_pair\owned_map: 0
            row_pair\contract: 0
            row_pair\reception_proof: 0
            row_pair_owned: 0
            logical_unknown: 0
            row_pair_unknown: pair_unknown
            if: refresh != 0
                status: lmx_implements_fill_holes(arena, (cast: (@: c.Lmx) candidate\req), req, @ row_pair, @ row_pair_owned, pair_unknown, @ logical_unknown, @ answer)
                row_pair_unknown: logical_unknown
            ---
            if: status = c.LMX_WALK_OK && answer = c.LMX_IMPLEMENTS_YES
                status: lmx_implements_project_view(arena, value, req, @ normalized_source, normalized_unknown, @ row_pair, row_pair_unknown, @ projected, @ projected_unknown, @ answer)
            ---
            if: normalized_owned != 0 && normalized_source\map != 0
                c.free((cast: (@: void) normalized_source\map))
            normalized_owned: 0
            if: row_pair_owned != 0 && row_pair\map != 0
                c.free((cast: (@: void) row_pair\map))
            row_pair_owned: 0
            if: normalized_unknown != 0
                c.free((cast: (@: void) normalized_unknown))
                normalized_unknown: 0
            if: logical_unknown != 0
                c.free((cast: (@: void) logical_unknown))
                logical_unknown: 0
            if: status = c.LMX_WALK_OK && answer = c.LMX_IMPLEMENTS_YES
                status: lmx_implements_alternative_view(arena, source, @ source_owned, @ source_found, @ conflicts, @ projected, (cast: (int) projected\owned_map), projected_unknown, width, @ answer)
            ---
            if: projected_unknown != 0
                c.free((cast: (@: void) projected_unknown))
                projected_unknown: 0
            if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
                failed: 1
                break
            ---
        ---
        i: i + 1U
    ---
    if: source_found != 0 && failed = 0
        c.memcpy((cast: (@: void) out), (cast: (@: void) source), c.sizeof(c.LmxImplEntry))
        source_owned: 0
        \out_unknown: conflicts
        conflicts: 0
    ---
    if: normalized_owned != 0 && normalized_source\map != 0
        c.free((cast: (@: void) normalized_source\map))
    if: row_pair_owned != 0 && row_pair\map != 0
        c.free((cast: (@: void) row_pair\map))
    if: normalized_unknown != 0
        c.free((cast: (@: void) normalized_unknown))
    if: logical_unknown != 0
        c.free((cast: (@: void) logical_unknown))
    if: source_owned != 0 && source\map != 0
        c.free((cast: (@: void) source\map))
    if: conflicts != 0
        c.free((cast: (@: void) conflicts))
    if: projected_unknown != 0
        c.free((cast: (@: void) projected_unknown))
    ---
    out_answer[0]: answer
    return: status
end: lmx_implements_compose_view
# Retain the existing public operation, but prepare its coordinates without
# publishing first. Nested transactional resolution uses the same pure helper.
fn: lmx_implements_compose_receiving (@: arena c.LmxArena; @: value c.Lmx; @: source_layout void; @: req c.Lmx; @: pair c.LmxImplEntry; int: full_receiver; @: uses c.LmxImplUses; @: applied int; @: out_answer int) int
    c.LmxImplEntry: composed
    c.LmxImplPreparedView: seed
    @: composed_unknown size_t 0
    @: existing c.LmxImplEntry
    @: receiving_uses c.LmxImplUses uses
    int: answer
    int: status
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    status: lmx_implements_compose_view(arena, value, source_layout, req, pair, 0, (cast: (int) (full_receiver >= 0)), @ composed, applied, @ composed_unknown, @ answer)
    if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        if: status = c.LMX_WALK_OK
            out_answer[0]: answer
        return: status
    if: full_receiver < 0
        composed\reception_proof: 1
        status: lmx_implements_keep_proved(arena, value, req, @ composed, out_answer)
    else:
        if: full_receiver = 0
            receiving_uses: 0
        c.memset((cast: (@: void) (@ seed)), 0, c.sizeof(c.LmxImplPreparedView))
        c.memcpy((cast: (@: void) (@ seed\view)), (cast: (@: void) (@ composed)), c.sizeof(c.LmxImplEntry))
        seed\unknown: composed_unknown
        status: lmx_implements_admit_operation(arena, value, req, @ composed, 1U, 0, 0U, receiving_uses, (cast: (int) (full_receiver > 0)), 0, 1, 0, 0, @ seed, out_answer)
    ---
    # Ownership follows the allocation actually kept by the arena, not
    # whether every interface fact was available to the receiving operation.
    existing: lmx_implements_find(arena, value, req)
    if: existing != 0 && existing\map = composed\map
        composed\owned_map: 0
    if: composed\owned_map != 0 && composed\map != 0
        c.free((cast: (@: void) (composed\map)))
    if: composed_unknown != 0
        c.free((cast: (@: void) composed_unknown))
    return: status
end: lmx_implements_compose_receiving

# Genuine schema evidence is a property of the held value. Looking across its
# completed correspondences supplies only that identity, never another receiver's
# map or Consumer proof. Register keeps all known evidence for one value consistent.
fn: lmx_implements_layout (@: arena c.LmxArena; @: value c.Lmx) @: void
    size_t: i 0U
    @: entry c.LmxImplEntry
    if: arena = 0 || value = 0
        return: 0
    while: i < arena\impl_len
        entry: arena\impl + i
        if: entry\value = value && entry\layout != 0
            return: (cast: (@: void) entry\layout)
        i: i + 1U
    ---
    return: 0
end: lmx_implements_layout

fn: lmx_implements_model_for_layout (@: arena c.LmxArena; @: layout void) @: c.Lmx
    size_t: i 0U
    @: entry c.LmxImplEntry
    if: arena = 0 || layout = 0
        return: 0
    while: i < arena\impl_len
        entry: arena\impl + i
        if: entry\value != 0 && entry\value = entry\req && entry\layout = layout
            return: (cast: (@: c.Lmx) entry\value)
        i: i + 1U
    ---
    return: 0
end: lmx_implements_model_for_layout

# N4 `call: code data` (docs/LMX_semantics.ru.md, method-parts: the code-to-data correspondence is prepared at the
# admission of the selected call, before its body, kept as addresses, with no name search at runtime): the data slots
# of one procedure's names in the selected data, read from the translator's static slot_table of that procedure --
# slot_table[0] = m, its names; slot_table[1] = k, its rows; then k rows of 1 + m cells: the token index of a data layout, then
# the data slot of each name.  The row is the one whose token (tokens + index) is the data's own layout token
# (lmx_implements_layout); no name is read.  A name the layout lacks, holds twice or holds unfit is SIZE_MAX.  YES:
# every name has a slot inside the data, and out, when not 0, gets the m slots.  NO: the row marks a name SIZE_MAX --
# the call's own runtime refusal.  UNKNOWN: no proof -- the data has no token, no row has it, or a slot of the row is
# past the data.  m = 0 is YES for any data.  Nothing is recorded; out is the only write.
# At admission a named place must identify exactly one physical storage slot.  The registry of source occurrences answers for
# the heads (lmx_implements_head_name): a second equal root head makes an unindexed name ambiguous, whichever receiver wrote it.
# A single head with no place of its own is that head's slot: `var\if` addresses the statement standing there.
fn: lmx_implements_call_field (@: arena c.LmxArena; @: data c.Lmx; size_t: wanted; int: type; @: out size_t) int
    if: data = 0 || wanted = 0U
        return: c.LMX_IMPLEMENTS_NO
    @: fields c.VoidArray @ data\array
    size_t: slot (cast: (size_t) -1)
    size_t: head_slot (cast: (size_t) -1)
    size_t: heads 0U
    size_t: j 0U
    while: j < fields\size
        if: lmx_implements_same_name(lmx_implements_head_name(arena, data, j), wanted) != 0
            if: heads = 0U
                head_slot: j
            heads: heads + 1U
        ---
        if: lmx_implements_same_name(lmx_implements_place_name(arena, data, j), wanted) != 0
            if: slot != (cast: (size_t) -1)
                return: c.LMX_IMPLEMENTS_NO
            slot: j
        ---
        j: j + 1U
    ---
    if: heads > 1U
        return: c.LMX_IMPLEMENTS_NO
    if: slot = (cast: (size_t) -1)
        slot: head_slot
    if: slot = (cast: (size_t) -1)
        return: c.LMX_IMPLEMENTS_NO
    @: value void c.lmx_graph_value_in(arena, data, slot)
    if: type = c.LMX_TYPE_NONE
        if: out != 0
            out[0]: slot
        return: c.LMX_IMPLEMENTS_YES
    if: type = c.LMX_TYPE_LMX
        if: c.lmx_graph_node_in(arena, value) = 0 && (lmx_domain_kind(arena, value) != c.LMX_KIND_PRIMITIVE || c.lmx_type_base(lmx_domain_type(arena, value)) != c.LMX_TYPE_LMX)
            return: c.LMX_IMPLEMENTS_NO
        ---
    else:
        if: lmx_domain_kind(arena, value) != c.LMX_KIND_PRIMITIVE || c.lmx_type_base(lmx_domain_type(arena, value)) != c.lmx_type_base(type)
            return: c.LMX_IMPLEMENTS_NO
        ---
    ---
    if: out != 0
        out[0]: slot
    return: c.LMX_IMPLEMENTS_YES
end: lmx_implements_call_field

# A field of a callable by its name, over the callable standing in a place (the book, #method-parts: the parts are fields of one Structure and an own field is a place in them, `func\x`).
# A place has one name however many statements stand at that head, so the registry of heads does not take it out of use here, as it does for an explicit `func\body\x`.  A fn holds its places in
# the parts var and body, and so does a `sub` (slice 285: its var and body stand one slot lower, lmx_callable_part); any other
# Structure holds them in itself, and those of a written var part in that part.  YES, or NO: the callable standing there does not have the field.
fn: lmx_implements_own_part (@: arena c.LmxArena; @: code c.Lmx; size_t: pass) @: c.Lmx
    @: pool c.LmxPool c.lmx_range_cell_pool(arena, (cast: (@: void) code))
    if: pool != 0 && pool\role = c.LMX_POOL_ROLE_FN
        size_t: at lmx_callable_part(arena, code, 2U + pass)
        if: at = (cast: (size_t) -1)
            return: 0
        return: c.lmx_graph_ref_struct_in(arena, code, at)
    ---
    if: pass = 0U
        return: c.lmx_graph_ref_struct_in(arena, code, 1U)
    return: code
end: lmx_implements_own_part

fn: lmx_implements_own_field (@: arena c.LmxArena; @: code c.Lmx; size_t: wanted; @@: out_part c.Lmx; @: out size_t) int
    @: part_fields c.VoidArray 0
    @: holder c.Lmx 0
    size_t: pass 0U
    size_t: j 0U
    if: arena = 0 || code = 0 || wanted = 0U || out_part = 0 || out = 0
        return: c.LMX_IMPLEMENTS_NO
    while: pass < 2U
        holder: lmx_implements_own_part(arena, code, pass)
        if: holder != 0
            part_fields: @ holder\array
            j: 0U
            while: j < part_fields\size
                if: lmx_implements_same_name(lmx_implements_place_name(arena, holder, j), wanted) != 0
                    out_part[0]: holder
                    out[0]: j
                    return: c.LMX_IMPLEMENTS_YES
                ---
                j: j + 1U
            ---
        ---
        pass: pass + 1U
    ---
    return: c.LMX_IMPLEMENTS_NO
end: lmx_implements_own_field

# `f\[N]field` over a callable: source occurrence N of that head among its own fields, counted through its parts in source order.
fn: lmx_implements_own_head_slot (@: arena c.LmxArena; @: code c.Lmx; size_t: wanted; size_t: occurrence; @@: out_part c.Lmx; @: out size_t) int
    @: part_fields c.VoidArray 0
    @: holder c.Lmx 0
    size_t: pass 0U
    size_t: j 0U
    size_t: seen 0U
    if: arena = 0 || code = 0 || wanted = 0U || out_part = 0 || out = 0
        return: c.LMX_IMPLEMENTS_NO
    while: pass < 2U
        holder: lmx_implements_own_part(arena, code, pass)
        if: holder != 0
            part_fields: @ holder\array
            j: 0U
            while: j < part_fields\size
                if: lmx_implements_same_name(lmx_implements_head_name(arena, holder, j), wanted) != 0
                    if: seen = occurrence
                        out_part[0]: holder
                        out[0]: j
                        return: c.LMX_IMPLEMENTS_YES
                    ---
                    seen: seen + 1U
                ---
                j: j + 1U
            ---
        ---
        pass: pass + 1U
    ---
    return: c.LMX_IMPLEMENTS_NO
end: lmx_implements_own_head_slot

# `s\[N]field` over an actual Structure: the slot of its source occurrence N of that head (zero-based).  A Structure with no registry
# rows for the name has at most its one place, occurrence 0.  YES or NO; no first or last is chosen for a bare name here.
fn: lmx_implements_head_slot (@: arena c.LmxArena; @: data c.Lmx; size_t: wanted; size_t: occurrence; @: out size_t) int
    if: data = 0 || wanted = 0U || out = 0
        return: c.LMX_IMPLEMENTS_NO
    @: fields c.VoidArray @ data\array
    size_t: seen 0U
    size_t: place (cast: (size_t) -1)
    size_t: j 0U
    while: j < fields\size
        if: lmx_implements_same_name(lmx_implements_head_name(arena, data, j), wanted) != 0
            if: seen = occurrence
                out[0]: j
                return: c.LMX_IMPLEMENTS_YES
            seen: seen + 1U
        ---
        if: place = (cast: (size_t) -1) && lmx_implements_same_name(lmx_implements_place_name(arena, data, j), wanted) != 0
            place: j
        ---
        j: j + 1U
    ---
    if: seen = 0U && occurrence = 0U && place != (cast: (size_t) -1)
        out[0]: place
        return: c.LMX_IMPLEMENTS_YES
    return: c.LMX_IMPLEMENTS_NO
end: lmx_implements_head_slot

# Slice 302 (IDENTIFIER-CODES): a compiled data interface is its spec alone -- m, SIZE_MAX, then for each place the code
# of its name and the type it requires (a pair) -- the generated word's static table, filled with the codes its unit
# normalized at its input boundary; no names text is read.
fn: lmx_implements_named_places (@: arena c.LmxArena; @: data c.Lmx; @: requirements size_t; @: out size_t) int
    if: requirements = 0
        return: c.LMX_IMPLEMENTS_UNKNOWN
    if: requirements[0] = 0U
        return: c.LMX_IMPLEMENTS_YES
    if: data = 0
        return: c.LMX_IMPLEMENTS_NO
    if: c.lmx_graph_node_in(arena, (cast: (@: void) data)) = 0
        return: c.LMX_IMPLEMENTS_UNKNOWN
    size_t: i 0U
    while: i < requirements[0]
        @: spec size_t (requirements + 2U + 2U * i)
        size_t: slot 0U
        int: answer lmx_implements_call_field(arena, data, spec[0], (cast: (int) spec[1]), @ slot)
        if: answer != c.LMX_IMPLEMENTS_YES
            return: answer
        if: out != 0
            out[i]: slot
        i: i + 1U
    ---
    return: c.LMX_IMPLEMENTS_YES
end: lmx_implements_named_places

fn: lmx_implements_repeated_var (@: arena c.LmxArena; @: code c.Lmx) int
    @: fields c.VoidArray @ code\array
    size_t: heads 0U
    size_t: j 0U
    while: j < fields\size
        if: lmx_implements_same_name(lmx_implements_head_name(arena, code, j), (cast: (size_t) c.LMX_ID_VAR)) != 0
            heads: heads + 1U
        j: j + 1U
    ---
    return: (cast: (int) (heads > 1U))
end: lmx_implements_repeated_var

# The selected call's admission of what stands in a callable's place, a call with no data of its own (the book, #method-parts: the places the code requires of its data, before its body; a missing place is a
# refusal of the call).  Its data is the code's var part.  A fn and a sub have no such interface: they are not compiled over data.
fn: lmx_implements_unary_admission (@: arena c.LmxArena; @: code c.Lmx) int
    if: arena = 0 || code = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) code)) = 0
        return: c.LMX_IMPLEMENTS_NO
    if: c.lmx_code_callable(arena, code) != 0
        return: c.LMX_IMPLEMENTS_YES
    @: row c.LmxSourceName c.lmx_source_places(arena, (cast: (@: void) code))
    if: row = 0 || row\place_spec = 0
        return: c.LMX_IMPLEMENTS_YES
    return: lmx_implements_named_places(arena, c.lmx_call_unary_data(arena, code), (cast: (@: size_t) row\place_spec), 0)
end: lmx_implements_unary_admission

# The caller owns this frame. Its slots belong to this one admission, including
# recursive calls on the same code with different data. Install only after all
# demanded places have been found. Unwinding restores the enclosing call.
fn: lmx_implements_call_places_open (@: arena c.LmxArena; @: code c.Lmx; @: data c.Lmx; @: scope c.LmxCallPlaces; @: out_answer int) int
    if: arena = 0 || scope = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    c.memset((cast: (@: void) scope), 0, c.sizeof(c.LmxCallPlaces))
    out_answer[0]: c.LMX_IMPLEMENTS_NO
    if: c.lmx_graph_node_in(arena, (cast: (@: void) code)) = 0 || (data != 0 && c.lmx_graph_node_in(arena, (cast: (@: void) data)) = 0)
        return: c.LMX_WALK_OK
    # A short call reads the code's var by its name, and at two or more root heads only an index selects one (the plan, U3): no data here is no first head taken.
    if: data = 0 && lmx_implements_repeated_var(arena, code) != 0
        return: c.LMX_WALK_OK
    # Receiver-produced methods describe their data in the actual var part.
    # The outer args/return/var/body slots are code structure, not data fields.
    @: pool c.LmxPool c.lmx_range_cell_pool(arena, (cast: (@: void) code))
    if: pool != 0 && pool\role = c.LMX_POOL_ROLE_FN
        code: c.lmx_call_unary_data(arena, code)
        if: code = 0
            return: c.LMX_WALK_INVALID
        ---
    ---
    @: fields c.VoidArray @ code\array
    @: interface_row c.LmxSourceName c.lmx_source_places(arena, (cast: (@: void) code))
    size_t: root_count fields\size
    size_t: required 0U
    if: interface_row != 0
        scope\requirements: interface_row\place_spec
        if: scope\requirements = 0
            return: c.LMX_WALK_INVALID
        required: scope\requirements[0]
    ---
    if: root_count > (cast: (size_t) -1) / c.sizeof(c.size_t) || required > (cast: (size_t) -1) / c.sizeof(c.size_t) - root_count
        return: c.LMX_WALK_NOMEM
    size_t: count root_count + required
    if: count != 0U
        scope\root_slots: (cast: (@: size_t) c.malloc(count * c.sizeof(c.size_t)))
        if: scope\root_slots = 0
            return: c.LMX_WALK_NOMEM
        c.memset((cast: (@: void) scope\root_slots), 255, count * c.sizeof(c.size_t))
    ---
    int: answer c.LMX_IMPLEMENTS_YES
    # A present interface is authoritative even with zero demanded places.
    # Its source statements do not become additional data requirements.
    if: interface_row != 0
        if: required != 0U
            scope\required_slots: scope\root_slots + root_count
        ---
        answer: lmx_implements_named_places(arena, data, (cast: (@: size_t) scope\requirements), (cast: (@: size_t) scope\required_slots))
    else:
        # Ordinary code already addresses its declared root places via
        # code_slot. Read the name and type of the actual selected place.
        size_t: i 0U
        while: i < root_count && answer = c.LMX_IMPLEMENTS_YES
            size_t: name lmx_implements_place_name(arena, code, i)
            if: name != 0U
                @: cell void c.lmx_graph_value_in(arena, code, i)
                int: type lmx_domain_type(arena, cell)
                if: c.lmx_graph_node_in(arena, cell) != 0
                    type: c.LMX_TYPE_LMX
                answer: lmx_implements_call_field(arena, data, name, type, (cast: (@: size_t) (scope\root_slots + i)))
            ---
            i: i + 1U
        ---
    ---
    out_answer[0]: answer
    if: answer != c.LMX_IMPLEMENTS_YES
        c.free((cast: (@: void) scope\root_slots))
        scope\root_slots: 0
        return: c.LMX_WALK_OK
    scope\code: code
    scope\data: data
    scope\root_count: root_count
    scope\parent: arena\call_places
    arena\call_places: scope
    return: c.LMX_WALK_OK
end: lmx_implements_call_places_open

sub: lmx_implements_call_places_close (@: arena c.LmxArena; @: scope c.LmxCallPlaces)
    if: arena != 0 && scope != 0 && arena\call_places = scope
        arena\call_places: scope\parent
        c.free((cast: (@: void) scope\root_slots))
        scope\root_slots: 0
    ---
end: lmx_implements_call_places_close

# The model a physical slot declares, whichever value stands there now (lmx_source_place_model_set): 0 for a slot that
# declares none.  A declared layout with no model in this arena has no proof to give.
fn: lmx_implements_cell_model (@: arena c.LmxArena; @: cell void; @@: out c.Lmx) int
    if: arena = 0 || out = 0
        return: c.LMX_WALK_INVALID
    out[0]: 0
    if: cell = 0
        return: c.LMX_WALK_OK
    @: row c.LmxSourceName c.lmx_source_places(arena, cell)
    if: row = 0 || row\model_layout = 0
        return: c.LMX_WALK_OK
    out[0]: lmx_implements_model_for_layout(arena, (cast: (@: void) row\model_layout))
    if: out[0] = 0
        return: c.LMX_WALK_UNSUPPORTED
    return: c.LMX_WALK_OK
end: lmx_implements_cell_model

# Receive a reached reference write into a physical field slot. Its
# declaration belongs to the slot and survives earlier assignments there:
# a reference to anything but a Structure does not fit it, the implicit `convert`.
# The Structure is admitted by what the known Consumers of this place use of it (the book, #three-argument-implements; the author 2026-10-26: "мы проверяем не полное соответствие, а
# используемые поля"; CODEX-OPUS-276-REVIEW-CONSUMER-20261104T024655Z-01): a field nothing uses is not looked at, and a place of which nothing is known asks nothing, since unknown is
# no NO.  A read of a field the value lacks is its own Consumer and refuses at its edge (lmx_implements_reach).
fn: lmx_implements_receive_cell (@: arena c.LmxArena; @: cell void; @: value void) int
    @: model c.Lmx 0
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: cell = 0 || value = 0
        return: c.LMX_WALK_OK
    # Slice 286 (CALLABLE-PLACE-FREE-SIGNATURE; Codex, 285 norm answers item 3; the book :370, :373, :387): a callable field's
    # slot keeps the callable its definition put there (lmx_source_place_callable_set).  A fn or sub written there must take
    # the call that declaration forms, or the write is the implicit `implements` and changes nothing; any other value is the
    # selected call's to admit (lmx_implements_unary_admission).  Native and walked stores reach this one admission.
    @: declared_row c.LmxSourceName c.lmx_source_places(arena, cell)
    if: declared_row = 0
        return: c.LMX_WALK_OK
    if: declared_row\place_callable != 0
        return: lmx_implements_place_callable(arena, value, (cast: (@: c.Lmx) declared_row\place_callable))
    int: known lmx_implements_cell_model(arena, cell, @ model)
    if: known != c.LMX_WALK_OK || model = 0
        return: known
    if: c.lmx_domain_kind(arena, value) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    @: row c.LmxSourceName c.lmx_source_places(arena, cell)
    if: row = 0 || row\place_uses = 0
        return: c.LMX_WALK_OK
    c.LmxImplUses: scope
    c.memset((cast: (@: void) (@ scope)), 0, c.sizeof(c.LmxImplUses))
    scope\map: row\place_uses
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status lmx_implements_admit_receiving_templates(arena, (cast: (@: c.Lmx) value), model, 0, 0U, @ scope, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    if: answer = c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_IMPLEMENTS
    return: c.LMX_WALK_OK
end: lmx_implements_receive_cell

# Receive a reached Structure write into the selected data field of an open call scope.
fn: lmx_implements_receive_data_field (@: arena c.LmxArena; @: data c.Lmx; size_t: slot; @: value c.Lmx) int
    if: arena = 0 || data = 0
        return: c.LMX_WALK_INVALID
    @: scope c.LmxCallPlaces arena\call_places
    if: scope = 0 || scope\data != data || value = 0
        return: c.LMX_WALK_OK
    return: lmx_implements_receive_cell(arena, (cast: (@: void) c.lmx_graph_cell_in(arena, data, slot)), (cast: (@: void) value))
end: lmx_implements_receive_data_field

fn: lmx_implements_places (@: arena c.LmxArena; @: data c.Lmx; @: tokens char; @: slot_table size_t; @: out size_t) int
    @: part_data_array c.VoidArray 0
    size_t: m 0U
    size_t: k 0U
    size_t: r 0U
    size_t: j 0U
    @: row size_t 0
    @: layout void 0
    int: missing 0
    if: arena = 0 || data = 0 || slot_table = 0
        return: c.LMX_IMPLEMENTS_UNKNOWN
    m: slot_table[0]
    k: slot_table[1]
    if: k = (cast: (size_t) -1)
        @: scope c.LmxCallPlaces arena\call_places
        if: scope != 0 && scope\data = data && scope\requirements = slot_table
            if: out != 0 && m != 0U
                c.memcpy((cast: (@: void) out), (cast: (@: void) scope\required_slots), m * c.sizeof(c.size_t))
            return: c.LMX_IMPLEMENTS_YES
        return: lmx_implements_named_places(arena, data, slot_table, out)
    if: m = 0U
        return: c.LMX_IMPLEMENTS_YES
    layout: lmx_implements_layout(arena, data)
    if: tokens = 0 || layout = 0
        return: c.LMX_IMPLEMENTS_UNKNOWN
    while: r < k
        row: slot_table + 2U + r * (m + 1U)
        if: (cast: (@: void) (tokens + row[0])) = layout
            j: 0U
            while: j < m
                if: row[1U + j] = (cast: (size_t) -1)
                    missing: 1
                else:
                    if: data != 0
                        part_data_array: (cast: (@: c.VoidArray) (@ data\array))
                    ---
                    if: row[1U + j] >= part_data_array\size
                        return: c.LMX_IMPLEMENTS_UNKNOWN
                    ---
                ---
                j: j + 1U
            ---
            if: missing != 0
                return: c.LMX_IMPLEMENTS_NO
            j: 0U
            while: out != 0 && j < m
                out[j]: row[1U + j]
                j: j + 1U
            ---
            return: c.LMX_IMPLEMENTS_YES
        r: r + 1U
    ---
    return: c.LMX_IMPLEMENTS_UNKNOWN
end: lmx_implements_places

# Two views give req's fields (width of them) the same places -- BOTH halves, so a bare use
# and an explicit occurrence use agree as well as the ordinal ones (K01).
fn: lmx_implements_same_map (@: arena c.LmxArena; @: a c.LmxImplEntry; @: b c.LmxImplEntry; size_t: width) int
    size_t: j 0U
    size_t: sa 0U
    size_t: sb 0U
    while: j < width
        if: lmx_implements_coordinate(arena, a, j, 0, @ sa) != 0 || lmx_implements_coordinate(arena, b, j, 0, @ sb) != 0
            return: 0
        if: sa != sb
            return: 0
        if: lmx_implements_coordinate(arena, a, j, 1, @ sa) != 0 || lmx_implements_coordinate(arena, b, j, 1, @ sb) != 0
            return: 0
        if: sa != sb
            return: 0
        j: j + 1U
    ---
    return: 1
end: lmx_implements_same_map

# Validate the complete typed coordinate row, not only the prefix this
# Consumer happens to visit. Static module arrays declare their extent;
# ordinary frame-backed rows must fit their physical graph owner in full.
fn: lmx_implements_view_valid (@: arena c.LmxArena; @: view c.LmxImplEntry; size_t: width; @: out_answer int) int
    @: part_frame_array c.VoidArray 0
    size_t: j 0U
    size_t: slot
    size_t: extent
    @: frame c.Lmx
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: view = 0
        return: c.LMX_WALK_INVALID
    if: width > ((cast: (size_t) -1) / c.sizeof(c.size_t)) / 2U
        return: c.LMX_WALK_NOMEM
    if: view\map = 0 && view\frame = 0
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    if: view\n != width
        out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    if: view\frame != 0
        frame: view\frame
        if: c.lmx_graph_node_in(arena, (cast: (@: void) frame)) = 0
            return: c.LMX_WALK_INVALID
        if: frame != 0
            part_frame_array: (cast: (@: c.VoidArray) (@ frame\array))
        ---
        extent: part_frame_array\size
        if: view\at > extent || width > (extent - view\at) / 2U
            return: c.LMX_WALK_INVALID
        ---
    ---
    while: j < width
        if: lmx_implements_coordinate(arena, view, j, 0, @ slot) != 0 || lmx_implements_coordinate(arena, view, j, 1, @ slot) != 0
            return: c.LMX_WALK_INVALID
        j: j + 1U
    ---
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_implements_view_valid

# Rebase a STORED coordinate record after a changed requirement extent.
# New positions are unknown, never implicit positional evidence; both old
# halves use their original stride. The caller owns only a changed buffer.
fn: lmx_implements_rebase_view (@: arena c.LmxArena; @: old c.LmxImplEntry; size_t: width; @: out c.LmxImplEntry; @: allocated int; @: out_answer int) int
    @: map size_t 0
    size_t: j 0U
    size_t: sa
    size_t: sb
    int: identity 1
    int: status
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: old = 0 || out = 0 || allocated = 0
        return: c.LMX_WALK_INVALID
    \allocated: 0
    if: width > ((cast: (size_t) -1) / c.sizeof(c.size_t)) / 2U
        return: c.LMX_WALK_NOMEM
    status: lmx_implements_view_valid(arena, old, (cast: (size_t) (old\n)), out_answer)
    if: status != c.LMX_WALK_OK || out_answer[0] != c.LMX_IMPLEMENTS_YES
        return: status
    if: old\n = width
        c.memcpy((cast: (@: void) out), (cast: (@: void) old), c.sizeof(c.LmxImplEntry))
        return: c.LMX_WALK_OK
    ---
    while: j < width
        if: j >= old\n || lmx_implements_coordinate(arena, old, j, 0, @ sa) != 0 || lmx_implements_coordinate(arena, old, j, 1, @ sb) != 0 || sa != j || sb != j
            identity: 0
            break
        j: j + 1U
    ---
    if: identity != 0
        c.memcpy((cast: (@: void) out), (cast: (@: void) old), c.sizeof(c.LmxImplEntry))
        out\map: 0
        out\frame: 0
        out\at: 0U
        out\n: width
        out\owned_map: 0
        out\contract: 0
        out\reception_proof: 0
        return: c.LMX_WALK_OK
    ---
    if: width != 0U
        map: (cast: (@: size_t) c.malloc(width * 2U * c.sizeof(c.size_t)))
        if: map = 0
            return: c.LMX_WALK_NOMEM
        ---
    ---
    j: 0U
    while: j < width
        sa: (cast: (size_t) -1)
        sb: (cast: (size_t) -1)
        if: j < old\n
            if: lmx_implements_coordinate(arena, old, j, 0, @ sa) != 0 || lmx_implements_coordinate(arena, old, j, 1, @ sb) != 0
                c.free((cast: (@: void) map))
                return: c.LMX_WALK_INVALID
            ---
        ---
        map[j]: sa
        map[width + j]: sb
        j: j + 1U
    ---
    c.memcpy((cast: (@: void) out), (cast: (@: void) old), c.sizeof(c.LmxImplEntry))
    out\map: map
    out\frame: 0
    out\at: 0U
    out\n: width
    out\owned_map: (cast: (int) (map != 0))
    out\contract: 0
    out\reception_proof: 0
    \allocated: (cast: (int) (map != 0))
    return: c.LMX_WALK_OK
end: lmx_implements_rebase_view

# UNUSED is no established address. Joining compatible coordinate evidence
# preserves every positive binding, in both ordinal and LAST halves. It is
# not a permission: the same used-interface Consumer walk still checks types.
fn: lmx_implements_compatible_map (@: arena c.LmxArena; @: a c.LmxImplEntry; @: b c.LmxImplEntry; size_t: width; @: out_answer int) int
    size_t: j 0U
    size_t: sa
    size_t: sb
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    while: j < width
        if: lmx_implements_coordinate(arena, a, j, 0, @ sa) != 0 || lmx_implements_coordinate(arena, b, j, 0, @ sb) != 0
            return: c.LMX_WALK_INVALID
        if: sa != sb && sa != (cast: (size_t) -1) && sb != (cast: (size_t) -1)
            out_answer[0]: c.LMX_IMPLEMENTS_NO
            return: c.LMX_WALK_OK
        if: lmx_implements_coordinate(arena, a, j, 1, @ sa) != 0 || lmx_implements_coordinate(arena, b, j, 1, @ sb) != 0
            return: c.LMX_WALK_INVALID
        if: sa != sb && sa != (cast: (size_t) -1) && sb != (cast: (size_t) -1)
            out_answer[0]: c.LMX_IMPLEMENTS_NO
            return: c.LMX_WALK_OK
        j: j + 1U
    ---
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_implements_compatible_map

fn: lmx_implements_extends_map (@: arena c.LmxArena; @: old c.LmxImplEntry; @: current c.LmxImplEntry; size_t: width; @: out_answer int) int
    size_t: j 0U
    size_t: sa
    size_t: sb
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: old = 0 || current = 0
        return: c.LMX_WALK_INVALID
    while: j < width
        sa: (cast: (size_t) -1)
        if: j < old\n && lmx_implements_coordinate(arena, old, j, 0, @ sa) != 0
            return: c.LMX_WALK_INVALID
        if: lmx_implements_coordinate(arena, current, j, 0, @ sb) != 0
            return: c.LMX_WALK_INVALID
        if: sa != (cast: (size_t) -1) && sa != sb
            out_answer[0]: c.LMX_IMPLEMENTS_NO
            return: c.LMX_WALK_OK
        sa: (cast: (size_t) -1)
        if: j < old\n && lmx_implements_coordinate(arena, old, j, 1, @ sa) != 0
            return: c.LMX_WALK_INVALID
        if: lmx_implements_coordinate(arena, current, j, 1, @ sb) != 0
            return: c.LMX_WALK_INVALID
        if: sa != (cast: (size_t) -1) && sa != sb
            out_answer[0]: c.LMX_IMPLEMENTS_NO
            return: c.LMX_WALK_OK
        j: j + 1U
    ---
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_implements_extends_map

# Inputs are borrowed. Only a changed result allocates one flat typed map;
# the caller then owns that new buffer and disposes its previous temporary.
# An identical result keeps a's storage/lifetime. Nothing is published here.
fn: lmx_implements_join_view (@: arena c.LmxArena; @: a c.LmxImplEntry; @: b c.LmxImplEntry; size_t: width; @: out c.LmxImplEntry; @: allocated int; @: out_answer int) int
    @: map size_t 0
    size_t: j 0U
    size_t: sa
    size_t: sb
    int: answer
    int: identity 1
    int: status
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: a = 0 || b = 0 || out = 0 || allocated = 0
        return: c.LMX_WALK_INVALID
    \allocated: 0
    if: width > ((cast: (size_t) -1) / c.sizeof(c.size_t)) / 2U
        return: c.LMX_WALK_NOMEM
    status: lmx_implements_view_valid(arena, a, width, out_answer)
    if: status != c.LMX_WALK_OK || out_answer[0] != c.LMX_IMPLEMENTS_YES
        return: status
    status: lmx_implements_view_valid(arena, b, width, out_answer)
    if: status != c.LMX_WALK_OK || out_answer[0] != c.LMX_IMPLEMENTS_YES
        return: status
    if: a\layout != 0 && b\layout != 0 && a\layout != b\layout
        out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    status: lmx_implements_compatible_map(arena, a, b, width, out_answer)
    if: status != c.LMX_WALK_OK || out_answer[0] != c.LMX_IMPLEMENTS_YES
        return: status
    while: j < width
        if: lmx_implements_coordinate(arena, a, j, 0, @ sa) != 0 || lmx_implements_coordinate(arena, b, j, 0, @ sb) != 0
            return: c.LMX_WALK_INVALID
        if: sa = (cast: (size_t) -1)
            sa: sb
        # Joining numeric places does not consume every required field.
        # Current missing values are checked only if this Consumer uses the
        # corresponding edge, by the ordinary DFS/public value reader.
        if: sa != j
            identity: 0
        if: lmx_implements_coordinate(arena, a, j, 1, @ sa) != 0 || lmx_implements_coordinate(arena, b, j, 1, @ sb) != 0
            return: c.LMX_WALK_INVALID
        if: sa = (cast: (size_t) -1)
            sa: sb
        if: sa != j
            identity: 0
        j: j + 1U
    ---
    if: identity != 0
        if: out != a
            c.memcpy((cast: (@: void) out), (cast: (@: void) a), c.sizeof(c.LmxImplEntry))
        ---
        if: out\layout = 0
            out\layout: b\layout
        if: b\holes != 0
            out\holes: 1
        out\map: 0
        out\frame: 0
        out\at: 0U
        out\n: width
        out\owned_map: 0
        out\contract: 0
        out\reception_proof: 0
        return: c.LMX_WALK_OK
    ---
    status: lmx_implements_extends_map(arena, b, a, width, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    if: answer = c.LMX_IMPLEMENTS_YES
        if: out != a
            c.memcpy((cast: (@: void) out), (cast: (@: void) a), c.sizeof(c.LmxImplEntry))
        ---
        if: out\layout = 0
            out\layout: b\layout
        if: b\holes != 0
            out\holes: 1
        return: c.LMX_WALK_OK
    ---
    if: width != 0U
        map: (cast: (@: size_t) c.malloc(width * 2U * c.sizeof(c.size_t)))
        if: map = 0
            return: c.LMX_WALK_NOMEM
        ---
    ---
    j: 0U
    while: j < width
        if: lmx_implements_coordinate(arena, a, j, 0, @ sa) != 0 || lmx_implements_coordinate(arena, b, j, 0, @ sb) != 0
            break
        if: sa = (cast: (size_t) -1)
            sa: sb
        map[j]: sa
        if: lmx_implements_coordinate(arena, a, j, 1, @ sa) != 0 || lmx_implements_coordinate(arena, b, j, 1, @ sb) != 0
            break
        if: sa = (cast: (size_t) -1)
            sa: sb
        map[width + j]: sa
        j: j + 1U
    ---
    if: j != width
        c.free((cast: (@: void) map))
        return: c.LMX_WALK_INVALID
    if: out != a
        c.memcpy((cast: (@: void) out), (cast: (@: void) a), c.sizeof(c.LmxImplEntry))
    ---
    if: out\layout = 0
        out\layout: b\layout
    if: b\holes != 0
        out\holes: 1
    out\map: map
    out\frame: 0
    out\at: 0U
    out\n: width
    out\owned_map: 1
    out\contract: 0
    out\reception_proof: 0
    \allocated: 1
    return: c.LMX_WALK_OK
end: lmx_implements_join_view

# The one accumulator of coordinate evidence. Its ownership bit refers only
# to an operation temporary, never to a borrowed arena entry's owned_map.
fn: lmx_implements_accumulate_view (@: arena c.LmxArena; @: selected c.LmxImplEntry; @: owns int; @: found int; @: candidate c.LmxImplEntry; int: candidate_owned; size_t: width; @: out_answer int) int
    c.LmxImplEntry: joined
    int: allocated 0
    int: status c.LMX_WALK_INVALID
    if: out_answer != 0
        out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: out_answer != 0 && selected != 0 && owns != 0 && found != 0 && candidate != 0
        if: \found = 0
            c.memcpy((cast: (@: void) selected), (cast: (@: void) candidate), c.sizeof(c.LmxImplEntry))
            \owns: candidate_owned
            \found: 1
            out_answer[0]: c.LMX_IMPLEMENTS_YES
            return: c.LMX_WALK_OK
        ---
        status: lmx_implements_join_view(arena, selected, candidate, width, @ joined, @ allocated, out_answer)
        if: status = c.LMX_WALK_OK && out_answer[0] = c.LMX_IMPLEMENTS_YES
            if: joined\map != selected\map
                if: \owns != 0 && selected\map != 0
                    c.free((cast: (@: void) selected\map))
                ---
                \owns: allocated
            ---
            c.memcpy((cast: (@: void) selected), (cast: (@: void) (@ joined)), c.sizeof(c.LmxImplEntry))
            if: allocated != 0
                \owns: 1
            ---
        ---
    ---
    if: candidate_owned != 0 && candidate != 0 && candidate\map != 0 && (selected = 0 || found = 0 || \found = 0 || candidate\map != selected\map)
        c.free((cast: (@: void) candidate\map))
    ---
    return: status
end: lmx_implements_accumulate_view

# Conditional source interpretations are alternatives, not simultaneous
# explicit coordinate promises. Preserve every unambiguous positive address;
# two different positive addresses leave that coordinate unresolved. The
# operation's separate conflict set prevents a third row from resurrecting a
# discarded choice. It is never published as permission or graph metadata.
# The ordinary interface walk consumes this one result: a used ambiguous
# edge remains UNKNOWN; an unrelated edge cannot veto the Consumer's paths.
fn: lmx_implements_alternative_view (@: arena c.LmxArena; @: selected c.LmxImplEntry; @: owns int; @: found int; @@: conflicts size_t; @: candidate c.LmxImplEntry; int: candidate_owned; @: candidate_unknown size_t; size_t: width; @: out_answer int) int
    @: map size_t 0
    @: mask size_t 0
    size_t: j 0U
    size_t: sa
    size_t: sb
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status c.LMX_WALK_INVALID
    if: out_answer != 0
        out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: out_answer != 0 && selected != 0 && owns != 0 && found != 0 && conflicts != 0 && candidate != 0
        status: c.LMX_WALK_NOMEM
    if: out_answer != 0 && selected != 0 && owns != 0 && found != 0 && conflicts != 0 && candidate != 0 && width <= ((cast: (size_t) -1) / c.sizeof(c.size_t)) / 2U
        status: lmx_implements_view_valid(arena, candidate, width, @ answer)
        if: status = c.LMX_WALK_OK && answer = c.LMX_IMPLEMENTS_YES && \found = 0
            if: width != 0U
                map: (cast: (@: size_t) c.malloc(width * 2U * c.sizeof(c.size_t)))
                if: map = 0
                    status: c.LMX_WALK_NOMEM
                else:
                    mask: (cast: (@: size_t) c.calloc(width * 2U, c.sizeof(c.size_t)))
                    if: mask = 0
                        status: c.LMX_WALK_NOMEM
                    ---
                ---
            ---
            while: status = c.LMX_WALK_OK && answer = c.LMX_IMPLEMENTS_YES && j < width
                if: lmx_implements_coordinate(arena, candidate, j, 0, @ sa) != 0 || lmx_implements_coordinate(arena, candidate, j, 1, @ sb) != 0
                    status: c.LMX_WALK_INVALID
                    break
                map[j]: sa
                map[width + j]: sb
                if: candidate_unknown != 0
                    if: candidate_unknown[j] != 0U
                        map[j]: (cast: (size_t) -1)
                        mask[j]: 1U
                    if: candidate_unknown[width + j] != 0U
                        map[width + j]: (cast: (size_t) -1)
                        mask[width + j]: 1U
                ---
                j: j + 1U
            ---
            if: status = c.LMX_WALK_OK && answer = c.LMX_IMPLEMENTS_YES
                c.memcpy((cast: (@: void) selected), (cast: (@: void) candidate), c.sizeof(c.LmxImplEntry))
                selected\map: map
                selected\frame: 0
                selected\at: 0U
                selected\n: width
                selected\owned_map: 0
                selected\contract: 0
                selected\reception_proof: 0
                if: map != 0
                    selected\owned_map: 1
                \conflicts: mask
                \owns: 1
                \found: 1
                map: 0
                mask: 0
            ---
        else:
            if: status = c.LMX_WALK_OK && answer = c.LMX_IMPLEMENTS_YES
                if: selected\n != width || (width != 0U && (selected\map = 0 || \conflicts = 0)) || (selected\layout != 0 && candidate\layout != 0 && selected\layout != candidate\layout)
                    if: selected\n != width || (width != 0U && (selected\map = 0 || \conflicts = 0))
                        status: c.LMX_WALK_INVALID
                    else:
                        answer: c.LMX_IMPLEMENTS_UNKNOWN
                    ---
                else:
                    map: selected\map
                    mask: \conflicts
                    j: 0U
                    while: status = c.LMX_WALK_OK && answer = c.LMX_IMPLEMENTS_YES && j < width * 2U
                        if: candidate_unknown != 0 && candidate_unknown[j] != 0U
                            map[j]: (cast: (size_t) -1)
                            mask[j]: 1U
                            j: j + 1U
                            continue
                        if: j < width
                            if: lmx_implements_coordinate(arena, candidate, j, 0, @ sb) != 0
                                status: c.LMX_WALK_INVALID
                            ---
                        else:
                            if: lmx_implements_coordinate(arena, candidate, j - width, 1, @ sb) != 0
                                status: c.LMX_WALK_INVALID
                        ---
                        if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
                            break
                        if: mask[j] = 0U && sb != (cast: (size_t) -1)
                            sa: map[j]
                            if: sa = (cast: (size_t) -1)
                                map[j]: sb
                            else:
                                if: sa != sb
                                    map[j]: (cast: (size_t) -1)
                                    mask[j]: 1U
                                ---
                            ---
                        ---
                        j: j + 1U
                    ---
                    if: selected\layout = 0
                        selected\layout: candidate\layout
                    if: candidate\holes != 0
                        selected\holes: 1
                    map: 0
                    mask: 0
                ---
            ---
        ---
    ---
    if: map != 0
        c.free((cast: (@: void) map))
    if: mask != 0
        c.free((cast: (@: void) mask))
    if: candidate_owned != 0 && candidate != 0 && candidate\map != 0 && (selected = 0 || found = 0 || \found = 0 || candidate\map != selected\map)
        c.free((cast: (@: void) candidate\map))
    ---
    if: status = c.LMX_WALK_OK
        out_answer[0]: answer
    return: status
end: lmx_implements_alternative_view

# Native D-105: does record e give req's fields (width of them) the places the static map does (null: the identity)?
fn: lmx_implements_is_map (@: arena c.LmxArena; @: e c.LmxImplEntry; @: map size_t; size_t: width) int
    c.LmxImplEntry: view
    @: v c.LmxImplEntry 0
    if: e = 0
        return: 0
    v: @ view
    c.memset((cast: (@: void) v), 0, c.sizeof(c.LmxImplEntry))
    v\map: map
    v\n: width
    return: lmx_implements_same_map(arena, e, v, width)
end: lmx_implements_is_map

# The heavy check uses the same operation DFS. Its pending view remains available on back-edges,
# and nested pairs use their already admitted correspondence. SIZE_MAX is proved unused here;
# unlike the runtime used-tree predicate, req describes the whole declared layout, not just uses.
fn: lmx_implements_through (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: view c.LmxImplEntry) int
    c.LmxImplEntry: selected
    @: pending c.LmxImplEntry (@ selected)
    if: arena = 0 || value = 0 || req = 0
        return: c.LMX_IMPLEMENTS_UNKNOWN
    if: c.lmx_graph_node_in(arena, (cast: (@: void) value)) = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) req)) = 0
        return: c.LMX_IMPLEMENTS_NO
    if: view = 0
        c.memset((cast: (@: void) pending), 0, c.sizeof(c.LmxImplEntry))
    else:
        c.memcpy((cast: (@: void) pending), (cast: (@: void) view), c.sizeof(c.LmxImplEntry))
    ---
    pending\value: value
    pending\req: req
    return: lmx_implements_walk_project(arena, value, value, req, pending, 1, 1, 0)
end: lmx_implements_through

# Retain a correspondence after its caller has proved the appropriate
# Consumer. A used-path proof gives addresses but not permission for a later
# Consumer. A full receiving receipt retains its contract and coordinates;
# a later reception still checks the current candidate through the common walk.
fn: lmx_implements_can_keep (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: view c.LmxImplEntry; int: require_extension; @: out_answer int) int
    @: part_req_array c.VoidArray 0
    @: e c.LmxImplEntry
    @: layout void
    int: valid
    int: status
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0 || value = 0 || req = 0 || view = 0
        return: c.LMX_WALK_INVALID
    if: view\reception_proof < 0 || view\reception_proof > 2 || (view\reception_proof = 2 && view\contract = 0)
        return: c.LMX_WALK_INVALID
    if: view\contract != 0 && view\contract\owners = (cast: (size_t) -1)
        return: c.LMX_WALK_NOMEM
    if: c.lmx_graph_node_in(arena, (cast: (@: void) req)) = 0
        return: c.LMX_WALK_INVALID
    if: req != 0
        part_req_array: (cast: (@: c.VoidArray) (@ req\array))
    ---
    status: lmx_implements_view_valid(arena, view, (cast: (size_t) (part_req_array\size)), @ valid)
    if: status != c.LMX_WALK_OK || valid != c.LMX_IMPLEMENTS_YES
        out_answer[0]: valid
        return: status
    layout: lmx_implements_layout(arena, value)
    if: layout != 0 && view\layout != 0 && layout != view\layout
        out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    e: lmx_implements_find(arena, value, req)
    if: e != 0
        if: req != 0
            part_req_array: (cast: (@: c.VoidArray) (@ req\array))
        ---
        if: require_extension != 0
            status: lmx_implements_extends_map(arena, e, view, (cast: (size_t) (part_req_array\size)), @ valid)
            if: status != c.LMX_WALK_OK || valid != c.LMX_IMPLEMENTS_YES
                out_answer[0]: valid
                return: status
        ---
        if: req != 0
            part_req_array: (cast: (@: c.VoidArray) (@ req\array))
        ---
        if: require_extension = 0
            status: lmx_implements_compatible_map(arena, e, view, (cast: (size_t) (part_req_array\size)), @ valid)
            if: status != c.LMX_WALK_OK || valid != c.LMX_IMPLEMENTS_YES
                out_answer[0]: valid
                return: status
        ---
        if: e\layout != 0 && view\layout != 0 && e\layout != view\layout
            out_answer[0]: c.LMX_IMPLEMENTS_NO
            return: c.LMX_WALK_OK
    ---
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_implements_can_keep

# Called only after compatibility and room are established. No allocation,
# callback or fallible operation remains once publication starts.
fn: lmx_implements_put_proved (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: view c.LmxImplEntry) int
    @: part_req_array c.VoidArray 0
    @: e c.LmxImplEntry lmx_implements_find(arena, value, req)
    if: e != 0
        # A prepared extension preserves every established positive address.
        # Different coordinates/extent replace one coherent record. Equal
        # coordinates keep their old storage and its established lifetime.
        if: req != 0
            part_req_array: (cast: (@: c.VoidArray) (@ req\array))
        ---
        if: e\n != view\n || lmx_implements_same_map(arena, e, view, (cast: (size_t) (part_req_array\size))) = 0
            if: e\owned_map != 0 && e\map != 0 && e\map != view\map
                c.free((cast: (@: void) e\map))
            ---
            e\map: view\map
            e\frame: view\frame
            e\at: view\at
            e\n: view\n
            e\owned_map: view\owned_map
        ---
        if: view\holes != 0
            e\holes: 1
        # A new physical/used view cannot replace an independent full proof's
        # immutable contract. Only a new complete receiving proof brings one.
        if: view\reception_proof = 2 && view\contract != 0 && e\contract != view\contract
            c.lmx_arena_impl_contract_retain(view\contract)
            c.lmx_arena_impl_contract_release(e\contract)
            e\contract: view\contract
        if: e\layout = 0 && view\layout != 0
            e\layout: view\layout
        if: view\reception_proof = 2
            e\reception_proof: 2
        else:
            if: view\reception_proof = 1 && e\reception_proof = 0 && (e\frame != 0 || e\map != 0 || e\holes != 0)
                e\reception_proof: 1
            ---
        ---
        return: c.LMX_IMPLEMENTS_YES
    ---
    e: arena\impl + arena\impl_len
    e\value: value
    e\req: req
    e\layout: view\layout
    e\frame: view\frame
    e\at: view\at
    e\map: view\map
    e\n: view\n
    e\holes: view\holes
    e\reception_proof: view\reception_proof
    e\contract: 0
    if: view\reception_proof = 2
        e\contract: view\contract
    c.lmx_arena_impl_contract_retain(e\contract)
    e\owned_map: view\owned_map
    e\exec_map: 0
    e\exec_n: 0U
    arena\impl_len: arena\impl_len + 1U
    return: c.LMX_IMPLEMENTS_YES
end: lmx_implements_put_proved

fn: lmx_implements_keep_proved (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: view c.LmxImplEntry; @: out_answer int) int
    @: part_req_array c.VoidArray 0
    c.LmxImplEntry: saved
    c.LmxImplEntry: base
    c.LmxImplEntry: joined
    @: existing c.LmxImplEntry
    @: kept c.LmxImplEntry
    int: base_owned 0
    int: allocated 0
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status c.LMX_WALK_OK
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: value = 0 || req = 0 || view = 0
        return: c.LMX_WALK_OK
    if: c.lmx_graph_node_in(arena, (cast: (@: void) value)) = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) req)) = 0
        return: c.LMX_WALK_OK
    c.memcpy((cast: (@: void) (@ saved)), (cast: (@: void) view), c.sizeof(c.LmxImplEntry))
    saved\value: value
    saved\req: req
    if: saved\map = 0 && saved\frame = 0
        if: req != 0
            part_req_array: (cast: (@: c.VoidArray) (@ req\array))
        ---
        saved\n: part_req_array\size
    ---
    existing: lmx_implements_find(arena, value, req)
    if: existing != 0
        if: req != 0
            part_req_array: (cast: (@: c.VoidArray) (@ req\array))
        ---
        status: lmx_implements_rebase_view(arena, existing, (cast: (size_t) (part_req_array\size)), @ base, @ base_owned, @ answer)
        if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
            if: status = c.LMX_WALK_OK
                out_answer[0]: answer
            return: status
        if: req != 0
            part_req_array: (cast: (@: c.VoidArray) (@ req\array))
        ---
        status: lmx_implements_join_view(arena, @ saved, @ base, (cast: (size_t) (part_req_array\size)), @ joined, @ allocated, @ answer)
        if: base_owned != 0 && base\map != 0
            c.free((cast: (@: void) base\map))
        ---
        if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
            if: status = c.LMX_WALK_OK
                out_answer[0]: answer
            return: status
        # Only this caller's semantic proof accompanies its joined addresses.
        joined\contract: saved\contract
        joined\reception_proof: saved\reception_proof
        c.memcpy((cast: (@: void) (@ saved)), (cast: (@: void) (@ joined)), c.sizeof(c.LmxImplEntry))
    ---
    while: 1
        status: lmx_implements_can_keep(arena, value, req, @ saved, 1, @ answer)
        if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
            break
        if: existing = 0
            if: arena\impl_len = (cast: (size_t) -1) || c.lmx_arena_impl_room(arena, arena\impl_len + 1U) != 0
                status: c.LMX_WALK_NOMEM
                break
            ---
        ---
        answer: lmx_implements_put_proved(arena, value, req, @ saved)
        break
    ---
    if: allocated != 0 && saved\map != 0
        kept: lmx_implements_find(arena, value, req)
        if: kept = 0 || kept\map != saved\map
            c.free((cast: (@: void) saved\map))
        ---
    ---
    if: status = c.LMX_WALK_OK
        out_answer[0]: answer
    return: status
end: lmx_implements_keep_proved
fn: lmx_implements_register (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: view c.LmxImplEntry; @: out_answer int) int
    @: part_req_array c.VoidArray 0
    c.LmxImplEntry: full
    c.LmxImplPreparedView: seed
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: value = 0 || req = 0 || view = 0
        return: c.LMX_WALK_OK
    if: c.lmx_graph_node_in(arena, (cast: (@: void) value)) = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) req)) = 0
        return: c.LMX_WALK_OK
    c.memcpy((cast: (@: void) (@ full)), (cast: (@: void) view), c.sizeof(c.LmxImplEntry))
    full\value: value
    full\req: req
    full\reception_proof: 0
    full\contract: 0
    if: full\map = 0 && full\frame = 0
        part_req_array: (cast: (@: c.VoidArray) (@ req\array))
        full\n: part_req_array\size
    c.memset((cast: (@: void) (@ seed)), 0, c.sizeof(c.LmxImplPreparedView))
    c.memcpy((cast: (@: void) (@ seed\view)), (cast: (@: void) (@ full)), c.sizeof(c.LmxImplEntry))
    return: lmx_implements_admit_operation(arena, value, req, @ full, 1U, 0, 0U, 0, 0, 0, 1, 0, 0, @ seed, out_answer)
end: lmx_implements_register

# Each reception checks this instruction's used paths unless a full receiving
# proof already exists. Keep the correspondence without silently replacing a
# used-path proof by a whole-model check. The proof state is distinct from
# physical holes and prevents partial identity evidence.
fn: lmx_implements_admit_receiving (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: view c.LmxImplEntry; @: uses c.LmxImplUses; @: out_answer int) int
    @: part_req_array c.VoidArray 0
    c.LmxImplEntry: saved
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: value = 0 || req = 0
        return: c.LMX_WALK_OK
    if: view = 0
        return: lmx_implements_admit_operation(arena, value, req, 0, 0U, 0, 0U, uses, 1, 0, 1, 0, 0, 0, out_answer)
    c.memset((cast: (@: void) (@ saved)), 0, c.sizeof(c.LmxImplEntry))
    if: view != 0
        c.memcpy((cast: (@: void) (@ saved)), (cast: (@: void) view), c.sizeof(c.LmxImplEntry))
    ---
    saved\value: value
    saved\req: req
    saved\contract: 0
    saved\reception_proof: 0
    if: saved\map = 0 && saved\frame = 0
        if: req != 0
            part_req_array: (cast: (@: c.VoidArray) (@ req\array))
        ---
        saved\n: part_req_array\size
    ---
    return: lmx_implements_admit_operation(arena, value, req, @ saved, 1U, 0, 0U, uses, 1, 0, 1, 0, 0, 0, out_answer)
end: lmx_implements_admit_receiving

# One receiving proof over all current physical pairs, followed by one
# preallocated, infallible publication phase. The caller retains the ordinary
# frame/module lifetime obligation for borrowed maps; owned_map follows the
# existing keep_proved convention for each first new unique pair.
# Internal commit of an already proved operation. Validate all staged
# metadata and reserve all storage before the infallible publication phase.
fn: lmx_implements_publish_views (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: pending c.LmxImplEntry; size_t: count; int: root_proof; @: out_answer int) int
    @: row_staged_i c.LmxImplEntry
    @: row_staged_j c.LmxImplEntry
    c.LmxArena: temporary
    c.LmxPool: cells
    c.LmxScratch: scratch
    @: room void 0
    @: staged c.LmxImplEntry 0
    @: proposed c.LmxImplEntry
    size_t: i
    size_t: j
    size_t: need
    int: root 0
    int: unique
    int: answer
    int: status c.LMX_WALK_OK
    int: scratch_status
    # This checks and commits physical records independently of the Consumer
    # verdict. OK+YES means the whole batch committed. OK+NO/UNKNOWN means no
    # write; a conflict of valid coordinates is not a malformed-carrier error.
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: root_proof < 0 || root_proof > 2 || arena = 0 || value = 0 || req = 0 || pending = 0 || count = 0U
        return: c.LMX_WALK_INVALID
    if: count > ((cast: (size_t) -1) / c.sizeof(c.LmxImplEntry))
        return: c.LMX_WALK_NOMEM
    # A predicate may legitimately ignore unused metadata for an empty
    # Consumer. A publication may not retain invalid records on that basis.
    status: lmx_implements_pending_check(arena, pending, count, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    if: answer != c.LMX_IMPLEMENTS_YES
        out_answer[0]: answer
        return: c.LMX_WALK_OK
    c.memset((cast: (@: void) (@ temporary)), 0, c.sizeof(c.LmxArena))
    c.memset((cast: (@: void) (@ cells)), 0, c.sizeof(c.LmxPool))
    c.memset((cast: (@: void) (@ scratch)), 0, c.sizeof(c.LmxScratch))
    if: c.lmx_arena_open(@ temporary) != 0
        return: c.LMX_WALK_INVALID
    scratch_status: c.lmx_scratch_open(@ scratch, @ temporary, @ cells, 64U)
    if: scratch_status != c.LMX_SCRATCH_OK
        c.lmx_arena_release(@ temporary)
        if: scratch_status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    ---
    scratch_status: c.lmx_scratch_take(@ scratch, count * c.sizeof(c.LmxImplEntry), @ room)
    if: scratch_status != c.LMX_SCRATCH_OK
        c.lmx_scratch_close(@ scratch)
        c.lmx_arena_release(@ temporary)
        if: scratch_status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    ---
    staged: (cast: (@: c.LmxImplEntry) room)
    # pending may alias arena.impl: preserve every input before its reserve
    # can move the index. The maps themselves keep their existing lifetime.
    c.memcpy(room, (cast: (@: void) pending), count * c.sizeof(c.LmxImplEntry))
    while: 1
        need: arena\impl_len
        i: 0U
        while: i < count
            proposed: staged + i
            proposed\reception_proof: (cast: (int) (root_proof != 0))
            row_staged_i: staged + i
            if: row_staged_i\value = value && row_staged_i\req = req
                root: 1
                proposed\reception_proof: root_proof
            ---
            if: proposed\reception_proof != 2
                proposed\contract: 0
            if: proposed\contract != 0 && proposed\contract\owners = (cast: (size_t) -1)
                status: c.LMX_WALK_NOMEM
                break
            row_staged_i: staged + i
            status: lmx_implements_can_keep(arena, (cast: (@: c.Lmx) (row_staged_i\value)), (cast: (@: c.Lmx) (row_staged_i\req)), staged + i, 1, @ answer)
            if: status != c.LMX_WALK_OK
                break
            if: answer != c.LMX_IMPLEMENTS_YES
                break
            row_staged_i: staged + i
            unique: (cast: (int) (lmx_implements_find(arena, (cast: (@: c.Lmx) (row_staged_i\value)), (cast: (@: c.Lmx) (row_staged_i\req))) = 0))
            j: 0U
            while: j < i
                row_staged_j: staged + j
                row_staged_i: staged + i
                if: row_staged_j\value = row_staged_i\value
                    row_staged_j: staged + j
                    row_staged_i: staged + i
                    if: row_staged_j\req = row_staged_i\req
                        unique: 0
                    ---
                ---
                j: j + 1U
            ---
            if: unique != 0
                if: need = (cast: (size_t) -1)
                    status: c.LMX_WALK_NOMEM
                    break
                need: need + 1U
            ---
            i: i + 1U
        ---
        if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
            break
        if: root = 0 && root_proof = 2
            status: c.LMX_WALK_INVALID
            break
        if: c.lmx_arena_impl_room(arena, need) != 0
            status: c.LMX_WALK_NOMEM
            break
        ---
        # No failing operations, allocation, or user code after this point.
        i: 0U
        while: i < count
            row_staged_i: staged + i
            lmx_implements_put_proved(arena, (cast: (@: c.Lmx) (row_staged_i\value)), (cast: (@: c.Lmx) (row_staged_i\req)), staged + i)
            i: i + 1U
        ---
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        break
    ---
    c.lmx_scratch_close(@ scratch)
    c.lmx_arena_release(@ temporary)
    if: status = c.LMX_WALK_OK && answer != c.LMX_IMPLEMENTS_YES
        out_answer[0]: answer
    return: status
end: lmx_implements_publish_views

# Public receiving operation: one interface walk, then the shared prepared
# publication. No map is retained by a failed predicate.
fn: lmx_implements_admit_receiving_views (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: pending c.LmxImplEntry; size_t: count; @: uses c.LmxImplUses; @: out_answer int) int
    if: count = 0U
        if: out_answer = 0
            return: c.LMX_WALK_INVALID
        out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
        return: c.LMX_WALK_OK
    return: lmx_implements_admit_operation(arena, value, req, pending, count, 0, 0U, uses, 1, 0, 1, 0, 0, 0, out_answer)
end: lmx_implements_admit_receiving_views

# One operation-local prepared set, one interface walk, one atomic commit.
# The same walk selects addresses for ordinary and nested requirements.
# Templates supply coordinates only; neither their stale proof bits nor the
# exemplar's constructor is an admission of the current candidate.
fn: lmx_implements_admit_receiving_templates (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; const: (@: templates c.LmxImplTemplate); size_t: template_count; @: uses c.LmxImplUses; @: out_answer int) int
    return: lmx_implements_admit_templates(arena, value, req, templates, template_count, uses, 1, out_answer)
end: lmx_implements_admit_receiving_templates

fn: lmx_implements_admit_templates (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; const: (@: templates c.LmxImplTemplate); size_t: template_count; @: uses c.LmxImplUses; int: full_receiver; @: out_answer int) int
    return: lmx_implements_admit_templates_contracts(arena, value, req, templates, template_count, uses, full_receiver, 0, out_answer)
end: lmx_implements_admit_templates

fn: lmx_implements_admit_templates_contracts (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; const: (@: templates c.LmxImplTemplate); size_t: template_count; @: uses c.LmxImplUses; int: full_receiver; @: references c.Lmx; @: out_answer int) int
    return: lmx_implements_admit_templates_typed(arena, value, req, templates, template_count, uses, full_receiver, references, 0, 0, out_answer)
end: lmx_implements_admit_templates_contracts

fn: lmx_implements_admit_templates_typed (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; const: (@: templates c.LmxImplTemplate); size_t: template_count; @: uses c.LmxImplUses; int: full_receiver; @: references c.Lmx; @: source c.Lmx; @: source_references c.Lmx; @: out_answer int) int
    return: lmx_implements_admit_operation(arena, value, req, 0, 0U, templates, template_count, uses, full_receiver, references, 0, source, source_references, 0, out_answer)
end: lmx_implements_admit_templates_typed

# The single reached receiving operation. All adapters retain only their
# physical coordinate representation; requirements and proof reuse share
# this typed result. No caller-supplied proof bit grants cached permission.
fn: lmx_implements_admit_operation (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: pending c.LmxImplEntry; size_t: pending_n; const: (@: templates c.LmxImplTemplate); size_t: template_count; @: uses c.LmxImplUses; int: full_receiver; @: references c.Lmx; int: identity_default; @: source c.Lmx; @: source_references c.Lmx; @: root_seed c.LmxImplPreparedView; @: out_answer int) int
    return: lmx_implements_admit_operation_call(arena, value, req, pending, pending_n, templates, template_count, uses, full_receiver, references, identity_default, source, source_references, root_seed, 0, 0, 0U, out_answer)
end: lmx_implements_admit_operation

# The same owner/resolver/publication also accepts an explicit root CALL
# occurrence. Presence is separate from carrier availability. A missing row
# remains U, never a full signature/contract snapshot fallback. Runtime value
# materialization is still being connected; the Source job is binding-only.
fn: lmx_implements_admit_operation_call (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: pending c.LmxImplEntry; size_t: pending_n; const: (@: templates c.LmxImplTemplate); size_t: template_count; @: uses c.LmxImplUses; int: full_receiver; @: references c.Lmx; int: identity_default; @: source c.Lmx; @: source_references c.Lmx; @: root_seed c.LmxImplPreparedView; int: root_call_present; @: root_calls c.Lmx; size_t: root_call_at; @: out_answer int) int
    @: part_cell_view c.LmxImplEntry 0
    @: part_seed_req_array c.VoidArray 0
    @: seed_view c.LmxImplEntry 0
    @: prepared_seed c.LmxImplEntry 0
    c.LmxImplEntry: seed_storage
    c.LmxImplEntry: seed_base
    c.LmxImplEntry: seed_joined
    @: seed_unknown size_t 0
    c.LmxArena: temporary
    c.LmxPool: cells
    c.LmxScratch: scratch
    c.LmxImplResolve: resolver
    @: cell c.LmxImplPreparedView
    @: existing c.LmxImplEntry
    @: contract c.LmxImplContract 0
    @: staged c.LmxImplEntry 0
    @: room void 0
    size_t: i
    size_t: prepared_n
    size_t: seed_width 0U
    size_t: root_call_count 0U
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: consumer_answer c.LMX_IMPLEMENTS_UNKNOWN
    int: proof 1
    int: skip_unused 0
    int: published 0
    int: status c.LMX_WALK_OK
    int: publication_answer c.LMX_IMPLEMENTS_UNKNOWN
    int: scratch_status
    int: seed_owned 0
    int: seed_base_owned 0
    int: seed_joined_owned 0
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: value = 0 || req = 0
        return: c.LMX_WALK_OK
    if: full_receiver < 0 || full_receiver > 1 || (full_receiver = 0 && uses != 0)
        return: c.LMX_WALK_INVALID
    if: identity_default < 0 || identity_default > 1
        return: c.LMX_WALK_INVALID
    if: root_call_present < 0 || root_call_present > 1
        return: c.LMX_WALK_INVALID
    if: root_call_present != 0 && (full_receiver = 0 || uses != 0 || root_seed != 0)
        return: c.LMX_WALK_INVALID
    if: root_call_present != 0 && root_calls != 0
        status: lmx_implements_calls_shape(arena, root_calls, @ root_call_count)
        if: status != c.LMX_WALK_OK
            return: status
        if: root_call_at = 0U || (root_call_at - 1U) % 5U != 0U || (root_call_at - 1U) / 5U >= root_call_count
            return: c.LMX_WALK_INVALID
    ---
    if: (template_count != 0U && templates = 0) || (pending_n != 0U && pending = 0)
        return: c.LMX_WALK_INVALID
    if: template_count > ((cast: (size_t) -1) / c.sizeof(c.LmxImplTemplate)) || pending_n > ((cast: (size_t) -1) / c.sizeof(c.LmxImplEntry))
        return: c.LMX_WALK_NOMEM
    # Only consumed correspondence can constrain this Consumer. Unrelated
    # pending rows are not a pre-walk semantic veto. Publication validates
    # every physical row it actually retains.
    if: root_seed != 0
        seed_view: (cast: (@: c.LmxImplEntry) (@ root_seed\view))
        if: seed_view\value != value || seed_view\req != req
            return: c.LMX_WALK_INVALID
        if: c.lmx_graph_node_in(arena, (cast: (@: void) req)) = 0
            return: c.LMX_WALK_OK
        part_seed_req_array: (cast: (@: c.VoidArray) (@ req\array))
        seed_width: part_seed_req_array\size
    if: full_receiver != 0 && uses = 0 && root_call_present = 0
        # A previous receipt validates its required-contract snapshot, not
        # mutable candidate fields or saved Value contexts. Keep its physical
        # correspondence as coordinate evidence, then check this reception's
        # current candidate through the same existing Consumer walk below.
        status: lmx_implements_contract_prepare(arena, req, references, @ contract, @ answer)
        if: status != c.LMX_WALK_OK
            return: status
        # An incomplete optional snapshot is not a failed interface check.
        # The same walk still checks every available required field; without
        # a complete snapshot it cannot publish a new whole-contract proof2.
    ---
    c.memset((cast: (@: void) (@ temporary)), 0, c.sizeof(c.LmxArena))
    c.memset((cast: (@: void) (@ cells)), 0, c.sizeof(c.LmxPool))
    c.memset((cast: (@: void) (@ scratch)), 0, c.sizeof(c.LmxScratch))
    c.memset((cast: (@: void) (@ resolver)), 0, c.sizeof(c.LmxImplResolve))
    if: c.lmx_arena_open(@ temporary) != 0
        c.lmx_arena_impl_contract_release(contract)
        return: c.LMX_WALK_INVALID
    scratch_status: c.lmx_scratch_open(@ scratch, @ temporary, @ cells, 64U)
    if: scratch_status != c.LMX_SCRATCH_OK
        c.lmx_arena_release(@ temporary)
        c.lmx_arena_impl_contract_release(contract)
        if: scratch_status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    ---
    resolver\scratch: @ scratch
    resolver\templates: templates
    resolver\template_count: template_count
    resolver\references: references
    resolver\source: source
    resolver\source_references: source_references
    resolver\contract: contract
    # The vector-view API explicitly defines identity for non-overridden
    # pairs. Source catalogs only give conditional typed maps, not this fact.
    resolver\identity_default: identity_default
    if: full_receiver = 0
        skip_unused: 1
        proof: 0
    while: 1
        if: root_seed != 0
            # Borrow its map until this operation returns; the caller observes
            # actual retention. Preserve old positive places before seeding;
            # a partial input cannot withdraw an independently retained place.
            c.memcpy((cast: (@: void) (@ seed_storage)), (cast: (@: void) seed_view), c.sizeof(c.LmxImplEntry))
            seed_storage\contract: 0
            seed_storage\reception_proof: 0
            existing: lmx_implements_find(arena, value, req)
            if: existing != 0
                status: lmx_implements_rebase_view(arena, existing, seed_width, @ seed_base, @ seed_base_owned, @ answer)
                if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
                    answer: c.LMX_IMPLEMENTS_UNKNOWN
                    break
                status: lmx_implements_join_view(arena, @ seed_storage, @ seed_base, seed_width, @ seed_joined, @ seed_joined_owned, @ answer)
                if: seed_base_owned != 0 && seed_base\map != 0
                    c.free((cast: (@: void) seed_base\map))
                if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
                    answer: c.LMX_IMPLEMENTS_UNKNOWN
                    break
                c.memcpy((cast: (@: void) (@ seed_storage)), (cast: (@: void) (@ seed_joined)), c.sizeof(c.LmxImplEntry))
                seed_owned: seed_joined_owned
            ---
            if: source = 0
                # Imported unprotected holes need CURRENT admission; actual
                # composed conflicts remain protected by the borrowed mask.
                status: lmx_implements_prepare_current(arena, @ resolver, @ seed_storage, seed_owned, (cast: (@: size_t) root_seed\unknown), 0, @ prepared_seed, @ answer)
            else:
                # A chosen SOURCE cannot be replaced by direct target names.
                status: lmx_implements_unset_mask(arena, @ seed_storage, seed_width, @ seed_unknown)
                if: status != c.LMX_WALK_OK
                    if: seed_owned != 0 && seed_storage\owned_map != 0 && seed_storage\map != 0
                        c.free((cast: (@: void) seed_storage\map))
                    break
                status: lmx_implements_prepare_view(arena, @ resolver, @ seed_storage, seed_owned, seed_unknown, 1, @ prepared_seed, @ answer)
                seed_unknown: 0
            ---
            if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
                answer: c.LMX_IMPLEMENTS_UNKNOWN
                break
            status: lmx_implements_mask_known(arena, prepared_seed, seed_width, lmx_implements_prepared_mask(@ resolver, prepared_seed))
            if: status != c.LMX_WALK_OK
                break
        ---
        # Mutating admission always uses interface facts. A physical-only
        # retention mode is not permission to inspect method bodies.
        if: root_call_present != 0
            if: root_calls = 0
                answer: c.LMX_IMPLEMENTS_UNKNOWN
                break
            status: lmx_implements_require_call(arena, value, root_calls, root_call_at, @ resolver)
        else:
            status: lmx_implements_require_root(arena, value, req, pending, pending_n, skip_unused, 1, uses, @ resolver)
        ---
        if: status != c.LMX_WALK_OK
            break
        status: lmx_implements_drain(arena, @ resolver, @ consumer_answer)
        answer: consumer_answer
        if: status != c.LMX_WALK_OK || answer = c.LMX_IMPLEMENTS_NO
            break
        if: answer = c.LMX_IMPLEMENTS_UNKNOWN
            proof: 1
        if: full_receiver != 0 && uses = 0 && root_call_present = 0 && answer = c.LMX_IMPLEMENTS_YES && contract != 0
            proof: 2
        prepared_n: resolver\count
        # No consumed correspondence means nothing was resolved to retain.
        # In particular an identity-only use must not manufacture a guessed
        # positional map that poisons a later, genuinely informed reception.
        if: prepared_n = 0U
            break
        if: prepared_n > ((cast: (size_t) -1) / c.sizeof(c.LmxImplEntry))
            status: c.LMX_WALK_NOMEM
            break
        scratch_status: c.lmx_scratch_take(@ scratch, prepared_n * c.sizeof(c.LmxImplEntry), @ room)
        if: scratch_status != c.LMX_SCRATCH_OK
            status: c.LMX_WALK_INVALID
            if: scratch_status = c.LMX_SCRATCH_NOMEM
                status: c.LMX_WALK_NOMEM
            break
        ---
        staged: (cast: (@: c.LmxImplEntry) room)
        cell: resolver\views
        i: 0U
        while: cell != 0
            if: cell != 0
                part_cell_view: (cast: (@: c.LmxImplEntry) (@ cell\view))
            ---
            part_cell_view\contract: 0
            if: proof = 2 && part_cell_view\value = value && part_cell_view\req = req
                if: cell != 0
                    part_cell_view: (cast: (@: c.LmxImplEntry) (@ cell\view))
                ---
                part_cell_view\contract: contract
            c.memcpy((cast: (@: void) (staged + i)), (cast: (@: void) (@ cell\view)), c.sizeof(c.LmxImplEntry))
            cell: cell\next
            i: i + 1U
        ---
        status: lmx_implements_publish_views(arena, value, req, staged, prepared_n, proof, @ publication_answer)
        if: status = c.LMX_WALK_OK && publication_answer = c.LMX_IMPLEMENTS_YES
            published: 1
        if: status = c.LMX_WALK_OK && publication_answer != c.LMX_IMPLEMENTS_YES
            # No coherent batch committed. This does not prove a failed
            # Consumer requirement and must not manufacture an identity map.
            answer: c.LMX_IMPLEMENTS_UNKNOWN
        break
    ---
    lmx_implements_resolve_close(arena, @ resolver, published)
    c.lmx_scratch_close(@ scratch)
    c.lmx_arena_release(@ temporary)
    c.lmx_arena_impl_contract_release(contract)
    if: status = c.LMX_WALK_OK
        out_answer[0]: answer
    return: status
end: lmx_implements_admit_operation_call

# Adapt the data representation, not the path semantics. The only field
# selection and proof remain in admit_templates / walk_project_resolve.
# The temporary row records borrow this CURRENT frame; no coordinate copy
# survives it and no template permission/ownership is accepted from data.
fn: lmx_implements_admit_template_frame (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: frame c.Lmx; @: uses c.LmxImplUses; int: full_receiver; @: out_answer int) int
    return: lmx_implements_admit_template_frame_contracts(arena, value, req, frame, uses, full_receiver, 0, out_answer)
end: lmx_implements_admit_template_frame

fn: lmx_implements_admit_template_frame_contracts (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: frame c.Lmx; @: uses c.LmxImplUses; int: full_receiver; @: references c.Lmx; @: out_answer int) int
    return: lmx_implements_admit_template_frame_typed(arena, value, req, frame, uses, full_receiver, references, 0, 0, out_answer)
end: lmx_implements_admit_template_frame_contracts

# The ordinary catalog header, independent of any candidate or resolver.
# A complete zero-row catalog needs no scratch allocation.
fn: lmx_implements_template_header (@: arena c.LmxArena; @: frame c.Lmx; @: out_count size_t; @: out_extent size_t; @: out_answer int) int
    @: fields c.VoidArray
    @: cell void
    @: wide size_t
    size_t: count
    size_t: extent
    if: out_count = 0 || out_extent = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    out_count[0]: 0U
    out_extent[0]: 0U
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: frame = 0
        return: c.LMX_WALK_OK
    if: c.lmx_graph_node_in(arena, (cast: (@: void) frame)) = 0
        return: c.LMX_WALK_INVALID
    fields: @ frame\array
    extent: fields\size
    if: extent = 0U
        return: c.LMX_WALK_INVALID
    cell: c.lmx_graph_value_in(arena, frame, 0U)
    if: lmx_implements_metadata_cell(arena, cell, c.LMX_TYPE_SIZE_T, c.sizeof(c.size_t)) = 0
        return: c.LMX_WALK_INVALID
    wide: (cast: (@: size_t) cell)
    count: \wide
    if: count > (extent - 1U) / 3U
        return: c.LMX_WALK_INVALID
    if: count > ((cast: (size_t) -1) / c.sizeof(c.LmxImplTemplate))
        return: c.LMX_WALK_NOMEM
    if: count = 0U && extent != 1U
        return: c.LMX_WALK_INVALID
    out_count[0]: count
    out_extent[0]: extent
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_implements_template_header

# Decode the same existing catalog into caller scratch. These coordinate-only
# rows borrow the current frame; no resolver/index, proof or publisher runs.
# A nested receiving use can keep the common operation's resolver/views and
# temporarily select its own decoded catalog instead of opening another admit.
fn: lmx_implements_template_rows (@: arena c.LmxArena; @: frame c.Lmx; @: scratch c.LmxScratch; @@: out_rows c.LmxImplTemplate; @: out_count size_t; @: out_answer int) int
    @: room void 0
    @: cell void
    @: rows c.LmxImplTemplate 0
    @: row c.LmxImplTemplate
    @: coordinates c.LmxImplEntry
    @: wide size_t
    @@: token char
    size_t: count 0U
    size_t: extent 0U
    size_t: at 1U
    size_t: width
    size_t: i 0U
    size_t: j
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    int: scratch_status
    if: out_rows = 0 || out_count = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    out_rows[0]: 0
    out_count[0]: 0U
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    status: lmx_implements_template_header(arena, frame, @ count, @ extent, @ answer)
    if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        return: status
    if: count = 0U
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    if: scratch = 0
        return: c.LMX_WALK_INVALID
    scratch_status: c.lmx_scratch_take(scratch, count * c.sizeof(c.LmxImplTemplate), @ room)
    if: scratch_status != c.LMX_SCRATCH_OK
        if: scratch_status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    ---
    rows: (cast: (@: c.LmxImplTemplate) room)
    c.memset(room, 0, count * c.sizeof(c.LmxImplTemplate))
    while: i < count
        if: at > extent || extent - at < 3U
            return: c.LMX_WALK_INVALID
        row: rows + i
        coordinates: @ row\correspondence
        cell: c.lmx_graph_value_in(arena, frame, at)
        if: lmx_implements_metadata_cell(arena, cell, c.LMX_TYPE_CHAR_PTR, sizeof(@: char)) = 0
            return: c.LMX_WALK_INVALID
        token: (cast: (@@: char) cell)
        row\source_layout: (cast: (@: void) \token)
        cell: c.lmx_graph_value_in(arena, frame, at + 1U)
        if: lmx_implements_metadata_cell(arena, cell, c.LMX_TYPE_CHAR_PTR, sizeof(@: char)) = 0
            return: c.LMX_WALK_INVALID
        token: (cast: (@@: char) cell)
        row\required_layout: (cast: (@: void) \token)
        cell: c.lmx_graph_value_in(arena, frame, at + 2U)
        if: lmx_implements_metadata_cell(arena, cell, c.LMX_TYPE_SIZE_T, c.sizeof(c.size_t)) = 0
            return: c.LMX_WALK_INVALID
        wide: (cast: (@: size_t) cell)
        width: \wide
        if: row\source_layout = 0 || row\required_layout = 0 || width > (extent - at - 3U) / 2U
            return: c.LMX_WALK_INVALID
        coordinates\frame: frame
        coordinates\at: at + 3U
        coordinates\n: width
        j: 0U
        while: j < width * 2U
            cell: c.lmx_graph_value_in(arena, frame, at + 3U + j)
            if: lmx_implements_metadata_cell(arena, cell, c.LMX_TYPE_SIZE_T, c.sizeof(c.size_t)) = 0
                return: c.LMX_WALK_INVALID
            j: j + 1U
        ---
        at: at + 3U + width * 2U
        i: i + 1U
    ---
    if: at != extent
        return: c.LMX_WALK_INVALID
    out_rows[0]: rows
    out_count[0]: count
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_implements_template_rows

fn: lmx_implements_admit_template_frame_typed (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: frame c.Lmx; @: uses c.LmxImplUses; int: full_receiver; @: references c.Lmx; @: source c.Lmx; @: source_references c.Lmx; @: out_answer int) int
    c.LmxArena: temporary
    c.LmxPool: cells
    c.LmxScratch: scratch
    @: rows c.LmxImplTemplate 0
    size_t: count 0U
    size_t: extent 0U
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    int: scratch_status
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    status: lmx_implements_template_header(arena, frame, @ count, @ extent, @ answer)
    if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        return: status
    if: count = 0U
        return: lmx_implements_admit_templates_typed(arena, value, req, 0, 0U, uses, full_receiver, references, source, source_references, out_answer)
    c.memset((cast: (@: void) (@ temporary)), 0, c.sizeof(c.LmxArena))
    c.memset((cast: (@: void) (@ cells)), 0, c.sizeof(c.LmxPool))
    c.memset((cast: (@: void) (@ scratch)), 0, c.sizeof(c.LmxScratch))
    if: c.lmx_arena_open(@ temporary) != 0
        return: c.LMX_WALK_INVALID
    scratch_status: c.lmx_scratch_open(@ scratch, @ temporary, @ cells, 64U)
    if: scratch_status != c.LMX_SCRATCH_OK
        c.lmx_arena_release(@ temporary)
        if: scratch_status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    ---
    status: lmx_implements_template_rows(arena, frame, @ scratch, @ rows, @ count, @ answer)
    if: status = c.LMX_WALK_OK && answer = c.LMX_IMPLEMENTS_YES
        status: lmx_implements_admit_templates_typed(arena, value, req, rows, count, uses, full_receiver, references, source, source_references, out_answer)
    c.lmx_scratch_close(@ scratch)
    c.lmx_arena_release(@ temporary)
    return: status
end: lmx_implements_admit_template_frame_typed

# The graph-data adapter decodes only the optional two-field representation.
# A value producer can pass the SAME two components directly below;neither
# path allocates a context graph or mutates the shared receiving record.
fn: lmx_implements_admit_receiving_context (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: frame c.Lmx; @: source_context c.Lmx; @: out_answer int) int
    @: part_context_array c.VoidArray 0
    @: context c.Lmx 0
    @: source c.Lmx 0
    @: source_references c.Lmx 0
    @: source_reference_cell void 0
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: source_context != 0
        context: c.lmx_graph_node_in(arena, (cast: (@: void) source_context))
        if: context != 0
            part_context_array: (cast: (@: c.VoidArray) (@ context\array))
        ---
        if: context = 0 || part_context_array\size != 2U
            return: c.LMX_WALK_INVALID
        source: c.lmx_graph_node_in(arena, c.lmx_graph_value_in(arena, context, 0U))
        source_reference_cell: c.lmx_graph_value_in(arena, context, 1U)
        source_references: c.lmx_graph_node_in(arena, source_reference_cell)
        # A known Model can have no pointee declarations. Preserve its
        # qualified namespace while distinguishing a malformed nonzero sheet.
        if: source = 0 || (source_reference_cell != 0 && source_references = 0)
            return: c.LMX_WALK_OK
        ---
    ---
    return: lmx_implements_admit_receiving_parts(arena, value, req, frame, source, source_references, out_answer)
end: lmx_implements_admit_receiving_context

# This operation's CURRENT typed value components. A schema/model argument
# never supplies missing catalog,coverage,mode or physical evidence. All
# maps,including children,still go through the one templates resolver.
# Decode this CURRENT receiving record for the ordinary worker or a scoped
# nested use of that same worker. Output YES means a complete carrier only;
# it grants no candidate permission and publishes no correspondence.
# scope is caller-owned; no local pointer escapes this decoder.
fn: lmx_implements_receiving_shape (@: arena c.LmxArena; @: frame c.Lmx; @: source c.Lmx; @: source_references c.Lmx; @@: out_catalog c.Lmx; @@: out_references c.Lmx; @: scope c.LmxImplUses; @: out_full int; @: out_answer int) int
    @: fields c.VoidArray 0
    @: catalog c.Lmx 0
    @: references c.Lmx 0
    @: ignored c.Lmx 0
    @: coverage c.Lmx 0
    @: cell void
    @: wide size_t
    size_t: mode
    size_t: call_count 0U
    int: reference_answer
    int: status
    if: out_catalog = 0 || out_references = 0 || scope = 0 || out_full = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    out_catalog[0]: 0
    out_references[0]: 0
    out_full[0]: 0
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    c.memset((cast: (@: void) scope), 0, c.sizeof(c.LmxImplUses))
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: frame = 0
        return: c.LMX_WALK_OK
    if: c.lmx_graph_node_in(arena, (cast: (@: void) frame)) = 0
        return: c.LMX_WALK_INVALID
    fields: @ frame\array
    if: fields\size != 6U
        return: c.LMX_WALK_INVALID
    cell: c.lmx_graph_value_in(arena, frame, 2U)
    if: lmx_implements_metadata_cell(arena, cell, c.LMX_TYPE_SIZE_T, c.sizeof(c.size_t)) = 0
        return: c.LMX_WALK_INVALID
    wide: (cast: (@: size_t) cell)
    mode: \wide
    if: mode > 2U
        return: c.LMX_WALK_INVALID
    catalog: c.lmx_graph_node_in(arena, c.lmx_graph_value_in(arena, frame, 0U))
    if: catalog = 0
        return: c.LMX_WALK_OK
    cell: c.lmx_graph_value_in(arena, frame, 1U)
    if: mode != 2U && cell != 0
        return: c.LMX_WALK_INVALID
    if: mode = 2U
        coverage: c.lmx_graph_node_in(arena, cell)
        if: coverage = 0
            return: c.LMX_WALK_OK
        scope\frame: coverage
        cell: c.lmx_graph_value_in(arena, frame, 5U)
        if: cell != 0
            scope\calls: c.lmx_graph_node_in(arena, cell)
            if: scope\calls = 0
                return: c.LMX_WALK_INVALID
            ---
        ---
        status: lmx_implements_calls_shape(arena, (cast: (@: c.Lmx) scope\calls), @ call_count)
        if: status != c.LMX_WALK_OK
            return: status
    ---
    references: c.lmx_graph_node_in(arena, c.lmx_graph_value_in(arena, frame, 3U))
    if: references = 0
        return: c.LMX_WALK_OK
    # Absence stays explicit. A present but unavailable giving context never
    # becomes the unqualified path, and no shared record is modified.
    if: source != 0 || source_references != 0
        if: source = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) source)) = 0
            return: c.LMX_WALK_OK
        if: source_references != 0 && c.lmx_graph_node_in(arena, (cast: (@: void) source_references)) = 0
            return: c.LMX_WALK_OK
        status: lmx_implements_reference_contract(arena, source_references, source, (cast: (size_t) -1), @ ignored, @ reference_answer)
        if: status != c.LMX_WALK_OK
            return: status
        # Its unavailable pointee facts constrain their consumed edges only.
    ---
    out_catalog[0]: catalog
    out_references[0]: references
    if: mode != 0U
        out_full[0]: 1
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_implements_receiving_shape

# Resolve an already available value against this receiving instruction
# inside the SAME operation. Only current context scalars are borrowed and
# restored: scratch, prepared views, their masks/ownership and count remain
# the caller's. No nested publisher, proof cache or context graph is opened.
# The invoking worklist must keep its ordinary cycle discipline; this helper
# does not turn an unavailable future argument/result into a current value.
fn: lmx_implements_resolve_receiving (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: frame c.Lmx; @: source c.Lmx; @: source_references c.Lmx; @: resolver c.LmxImplResolve; @: out_answer int) int
    @: catalog c.Lmx 0
    @: references c.Lmx 0
    @: rows c.LmxImplTemplate 0
    c.LmxImplUses: scope
    @: uses c.LmxImplUses 0
    const: (@: previous_templates c.LmxImplTemplate)
    size_t: previous_count
    @: previous_references c.Lmx
    @: previous_source c.Lmx
    @: previous_source_references c.Lmx
    @: previous_contract c.LmxImplContract
    int: previous_identity
    size_t: count 0U
    int: full_receiver 0
    int: skip_unused 0
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0 || resolver = 0 || resolver\scratch = 0
        return: c.LMX_WALK_INVALID
    if: value = 0 || req = 0
        return: c.LMX_WALK_OK
    status: lmx_implements_receiving_shape(arena, frame, source, source_references, @ catalog, @ references, @ scope, @ full_receiver, @ answer)
    if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        return: status
    status: lmx_implements_template_rows(arena, catalog, (cast: (@: c.LmxScratch) resolver\scratch), @ rows, @ count, @ answer)
    if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        return: status
    if: scope\frame != 0
        uses: @ scope
    if: full_receiver = 0
        skip_unused: 1
    previous_templates: resolver\templates
    previous_count: resolver\template_count
    previous_references: resolver\references
    previous_source: resolver\source
    previous_source_references: resolver\source_references
    previous_contract: resolver\contract
    previous_identity: resolver\identity_default
    resolver\templates: rows
    resolver\template_count: count
    resolver\references: references
    resolver\source: source
    resolver\source_references: source_references
    resolver\contract: 0
    resolver\identity_default: 0
    status: lmx_implements_walk_project_resolve(arena, value, value, req, 0, 0U, skip_unused, 1, uses, resolver, out_answer)
    resolver\templates: previous_templates
    resolver\template_count: previous_count
    resolver\references: previous_references
    resolver\source: previous_source
    resolver\source_references: previous_source_references
    resolver\contract: previous_contract
    resolver\identity_default: previous_identity
    return: status
end: lmx_implements_resolve_receiving

# Mark an exact receiving obligation seen when it is enqueued. A repeated
# pending/processed requirement is not a new check and grants no permission.
# Stable current graph anchors are the key; fresh decoded row/scope addresses
# must never defeat cycle detection.
fn: lmx_implements_require_receiving (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: receiving c.Lmx; @: source c.Lmx; @: source_references c.Lmx; @: resolver c.LmxImplResolve) int
    @: item c.LmxImplObligation 0
    @: room void 0
    int: scratch_status
    if: arena = 0 || resolver = 0 || resolver\scratch = 0
        return: c.LMX_WALK_INVALID
    item: resolver\seen
    while: item != 0
        if: item\kind = 0 && item\value = value && item\req = req && item\receiving = receiving && item\source = source && item\source_references = source_references
            return: c.LMX_WALK_OK
        item: item\seen_next
    ---
    scratch_status: c.lmx_scratch_take(resolver\scratch, c.sizeof(c.LmxImplObligation), @ room)
    if: scratch_status != c.LMX_SCRATCH_OK
        if: scratch_status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    ---
    item: (cast: (@: c.LmxImplObligation) room)
    c.memset(room, 0, c.sizeof(c.LmxImplObligation))
    item\value: value
    item\req: req
    item\receiving: receiving
    item\source: source
    item\source_references: source_references
    item\pending_next: resolver\pending
    item\seen_next: resolver\seen
    resolver\pending: item
    resolver\seen: item
    return: c.LMX_WALK_OK
end: lmx_implements_require_receiving

# The existing owner starts one ordinary field walk, now as the first job
# of its common operation. Its pending views borrow that owner's call;
# coverage is copied by value, not retained through a stack pointer.
# No invocation permission or extra receiving contract is synthesized.
fn: lmx_implements_require_root (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: pending c.LmxImplEntry; size_t: pending_n; int: skip_unused; int: interface; @: uses c.LmxImplUses; @: resolver c.LmxImplResolve) int
    @: item c.LmxImplObligation 0
    @: room void 0
    int: scratch_status
    if: arena = 0 || resolver = 0 || resolver\scratch = 0
        return: c.LMX_WALK_INVALID
    if: pending_n != 0U && pending = 0
        return: c.LMX_WALK_INVALID
    scratch_status: c.lmx_scratch_take(resolver\scratch, c.sizeof(c.LmxImplObligation), @ room)
    if: scratch_status != c.LMX_SCRATCH_OK
        if: scratch_status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    ---
    item: (cast: (@: c.LmxImplObligation) room)
    c.memset(room, 0, c.sizeof(c.LmxImplObligation))
    item\kind: 1
    item\value: value
    item\req: req
    item\pending_views: pending
    item\pending_count: pending_n
    item\skip_unused: skip_unused
    item\interface: interface
    if: uses != 0
        item\has_uses: 1
        c.memcpy((cast: (@: void) (@ item\scope)), (cast: (@: void) uses), c.sizeof(c.LmxImplUses))
    item\pending_next: resolver\pending
    item\seen_next: resolver\seen
    resolver\pending: item
    resolver\seen: item
    return: c.LMX_WALK_OK
end: lmx_implements_require_root

# Every requirement is conjunctive. U does not stop independent evidence:
# a later guaranteed NO still refuses this operation. An execution/status
# error leaves its answer unavailable and excludes publication by the owner.
# A receiving worker may enqueue more obligations, but never drains them
# recursively. All their rows/maps stay in this operation's scratch lifetime.
fn: lmx_implements_drain (@: arena c.LmxArena; @: resolver c.LmxImplResolve; @: out_answer int) int
    @: item c.LmxImplObligation 0
    @: uses c.LmxImplUses 0
    int: uncertain 0
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0 || resolver = 0 || resolver\scratch = 0
        return: c.LMX_WALK_INVALID
    while: resolver\pending != 0
        item: resolver\pending
        resolver\pending: item\pending_next
        if: item\kind = 0
            status: lmx_implements_resolve_receiving(arena, (cast: (@: c.Lmx) item\value), (cast: (@: c.Lmx) item\req), (cast: (@: c.Lmx) item\receiving), (cast: (@: c.Lmx) item\source), (cast: (@: c.Lmx) item\source_references), resolver, @ answer)
        else:
            if: item\kind = 2
                status: lmx_implements_source_call(arena, (cast: (@: c.Lmx) item\value), (cast: (@: c.Lmx) item\calls), (cast: (size_t) item\call_at), resolver, @ answer)
            else:
                if: item\kind != 1
                    return: c.LMX_WALK_INVALID
                uses: 0
                if: item\has_uses != 0
                    uses: @ item\scope
                status: lmx_implements_walk_project_resolve(arena, (cast: (@: c.Lmx) item\value), (cast: (@: c.Lmx) item\value), (cast: (@: c.Lmx) item\req), (cast: (@: c.LmxImplEntry) item\pending_views), (cast: (size_t) item\pending_count), (cast: (int) item\skip_unused), (cast: (int) item\interface), uses, resolver, @ answer)
            ---
        ---
        if: status != c.LMX_WALK_OK
            return: status
        if: answer = c.LMX_IMPLEMENTS_NO
            out_answer[0]: c.LMX_IMPLEMENTS_NO
            return: c.LMX_WALK_OK
        if: answer != c.LMX_IMPLEMENTS_YES
            uncertain: 1
    ---
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    if: uncertain != 0
        out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    return: c.LMX_WALK_OK
end: lmx_implements_drain

fn: lmx_implements_admit_receiving_parts (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: frame c.Lmx; @: source c.Lmx; @: source_references c.Lmx; @: out_answer int) int
    @: catalog c.Lmx 0
    @: references c.Lmx 0
    c.LmxImplUses: scope
    @: uses c.LmxImplUses 0
    int: full_receiver 0
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    status: lmx_implements_receiving_shape(arena, frame, source, source_references, @ catalog, @ references, @ scope, @ full_receiver, @ answer)
    if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        return: status
    if: scope\frame != 0
        uses: @ scope
    return: lmx_implements_admit_template_frame_typed(arena, value, req, catalog, uses, full_receiver, references, source, source_references, out_answer)
end: lmx_implements_admit_receiving_parts

# The ordinary data-frame adapter retains its exact existing semantics.
# Its fifth field is this caller's context; the common operation above is
# also used when a value producer already owns an operation-local context.
fn: lmx_implements_admit_receiving_frame (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: frame c.Lmx; @: out_answer int) int
    @: part_frame_array c.VoidArray 0
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: frame = 0
        return: c.LMX_WALK_OK
    if: c.lmx_graph_node_in(arena, (cast: (@: void) frame)) = 0
        return: c.LMX_WALK_INVALID
    if: frame != 0
        part_frame_array: (cast: (@: c.VoidArray) (@ frame\array))
    ---
    if: part_frame_array\size != 6U
        return: c.LMX_WALK_INVALID
    return: lmx_implements_admit_receiving_context(arena, value, req, frame, (cast: (@: c.Lmx) c.lmx_graph_value_in(arena, frame, 4U)), out_answer)
end: lmx_implements_admit_receiving_frame

# Native D-105: the value admitted to req through the translator's static map of its pair of types (n slots), or
# as req's own (map null).
fn: lmx_implements_register_map (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: map size_t; size_t: n; @: layout void; @: out_answer int) int
    c.LmxImplEntry: view
    @: v c.LmxImplEntry 0
    v: @ view
    c.memset((cast: (@: void) v), 0, c.sizeof(c.LmxImplEntry))
    v\map: map
    v\layout: layout
    if: map != 0
        v\n: n
    return: lmx_implements_register(arena, value, req, v, out_answer)
end: lmx_implements_register_map

# Runtime-computed correspondence: the caller keeps no obligation to retain
# its temporary buffer. Module maps and frame-backed maps use register_map /
# register instead and do not allocate a second copy.
fn: lmx_implements_map_clone (@: map size_t; size_t: n) @: size_t
    @: copy size_t
    if: map = 0 || n = 0U || n > ((cast: (size_t) -1) / c.sizeof(c.size_t)) / 2U
        return: 0
    ---
    copy: (cast: (@: size_t) c.malloc(n * 2U * c.sizeof(c.size_t)))
    if: copy = 0
        return: 0
    ---
    c.memcpy((cast: (@: void) copy), (cast: (@: void) map), n * 2U * c.sizeof(c.size_t))
    return: copy
end: lmx_implements_map_clone

fn: lmx_implements_register_map_owned (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: map size_t; size_t: n; @: layout void; @: out_answer int) int
    c.LmxImplEntry: view
    @: copy size_t
    @: existing c.LmxImplEntry
    int: status
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: map = 0
        return: lmx_implements_register_map(arena, value, req, 0, n, layout, out_answer)
    ---
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: value = 0 || req = 0 || n = 0U
        return: c.LMX_WALK_OK
    if: n > ((cast: (size_t) -1) / c.sizeof(c.size_t)) / 2U
        return: c.LMX_WALK_NOMEM
    ---
    copy: lmx_implements_map_clone(map, n)
    if: copy = 0
        return: c.LMX_WALK_NOMEM
    ---
    c.memset((cast: (@: void) (@ view)), 0, c.sizeof(c.LmxImplEntry))
    view\map: copy
    view\n: n
    view\layout: layout
    view\owned_map: 1
    status: lmx_implements_register(arena, value, req, @ view, out_answer)
    existing: lmx_implements_find(arena, value, req)
    if: existing = 0 || existing\map != copy
        c.free((cast: (@: void) copy))
    ---
    return: status
end: lmx_implements_register_map_owned

# An already proved code-to-value map belongs to the value's existing self
# record. This storage step is shared by direct admission and by composition
# of two earlier admissions; it never proves a map by itself.
fn: lmx_implements_exec_save (@: arena c.LmxArena; @: value c.Lmx; @: map size_t; size_t: n; @: out_answer int) int
    c.LmxImplEntry: self_view
    @: e c.LmxImplEntry
    @: copy size_t 0
    size_t: i 0U
    int: answer c.LMX_IMPLEMENTS_YES
    int: status
    int: complete 1
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: value = 0 || map = 0 || n = 0U
        return: c.LMX_WALK_OK
    if: n > ((cast: (size_t) -1) / c.sizeof(c.size_t)) / 2U
        return: c.LMX_WALK_NOMEM
    ---
    if: c.lmx_graph_node_in(arena, (cast: (@: void) value)) = 0
        if: lmx_domain_kind(arena, (cast: (@: void) value)) != c.LMX_KIND_NONE
            out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    ---
    e: lmx_implements_find(arena, value, value)
    if: e != 0 && e\exec_map != 0
        if: e\exec_n != n
            out_answer[0]: c.LMX_IMPLEMENTS_NO
            return: c.LMX_WALK_OK
        ---
        while: i < n * 2U
            if: e\exec_map[i] != (cast: (size_t) -1) && map[i] != (cast: (size_t) -1) && e\exec_map[i] != map[i]
                out_answer[0]: c.LMX_IMPLEMENTS_NO
                return: c.LMX_WALK_OK
            ---
            i: i + 1U
        ---
        # Unavailable input never erases a known numeric place. Validate all
        # positive conflicts before refining, so refusal leaves storage intact.
        i: 0U
        while: i < n * 2U
            if: e\exec_map[i] = (cast: (size_t) -1)
                e\exec_map[i]: map[i]
            if: e\exec_map[i] = (cast: (size_t) -1)
                complete: 0
            i: i + 1U
        ---
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        if: complete = 0
            out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
        return: c.LMX_WALK_OK
    ---
    copy: lmx_implements_map_clone(map, n)
    if: copy = 0
        return: c.LMX_WALK_NOMEM
    ---
    i: 0U
    while: i < n * 2U
        if: copy[i] = (cast: (size_t) -1)
            complete: 0
        i: i + 1U
    ---
    if: e = 0
        c.memset((cast: (@: void) (@ self_view)), 0, c.sizeof(c.LmxImplEntry))
        status: lmx_implements_register(arena, value, value, @ self_view, @ answer)
        if: status != c.LMX_WALK_OK || answer = c.LMX_IMPLEMENTS_NO
            c.free((cast: (@: void) copy))
            if: status = c.LMX_WALK_OK
                out_answer[0]: answer
            return: status
        ---
        e: lmx_implements_find(arena, value, value)
    ---
    if: e = 0
        c.free((cast: (@: void) copy))
        return: c.LMX_WALK_OK
    ---
    e\exec_map: copy
    e\exec_n: n
    # The input execution projection was already proved by this caller.
    # Storing it does not upgrade an unknown receiving-interface verdict.
    out_answer[0]: answer
    if: complete = 0
        out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    return: c.LMX_WALK_OK
end: lmx_implements_exec_save

# A merge's selected body executes over the completed value, not over an
# orphan copy of an operand root. Prove its full 2n correspondence while that
# source is available, then keep only the address projection in the value's
# already existing self record. The ordinary (value, value) view remains
# positional: the projection is consulted by executable OWN, not by a path
# that explicitly asks for a physical slot of value.
fn: lmx_implements_exec_register (@: arena c.LmxArena; @: value c.Lmx; @: code c.Lmx; @: map size_t; size_t: n; @: out_answer int) int
    @: part_code_array c.VoidArray 0
    c.LmxImplEntry: view
    int: status
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: value = 0 || code = 0 || map = 0 || n = 0U
        return: c.LMX_WALK_OK
    if: n > ((cast: (size_t) -1) / c.sizeof(c.size_t)) / 2U
        return: c.LMX_WALK_NOMEM
    if: lmx_domain_kind(arena, (cast: (@: void) value)) = c.LMX_KIND_NONE || lmx_domain_kind(arena, (cast: (@: void) code)) = c.LMX_KIND_NONE
        return: c.LMX_WALK_OK
    if: c.lmx_graph_node_in(arena, (cast: (@: void) value)) = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) code)) = 0
        out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    ---
    if: code != 0
        part_code_array: (cast: (@: c.VoidArray) (@ code\array))
    ---
    if: part_code_array\size != n
        out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    ---
    c.memset((cast: (@: void) (@ view)), 0, c.sizeof(c.LmxImplEntry))
    view\map: map
    view\n: n
    view\value: value
    view\req: code
    status: lmx_implements_walk_project_resolve(arena, value, value, code, @ view, 1U, 1, 1, 0, 0, out_answer)
    if: status != c.LMX_WALK_OK || out_answer[0] != c.LMX_IMPLEMENTS_YES
        return: status
    ---
    return: lmx_implements_exec_save(arena, value, map, n, out_answer)
end: lmx_implements_exec_register

# The retained execution-coordinate relation, without a current-value read.
# Copy/composition needs stable places even when a physical cell is empty.
fn: lmx_implements_exec_coordinate (@: arena c.LmxArena; @: value c.Lmx; size_t: edge; @: out size_t; @: out_answer int) int
    @: part_value_array c.VoidArray 0
    @: e c.LmxImplEntry
    size_t: slot
    size_t: width
    int: last 0
    if: out = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    \out: (cast: (size_t) -1)
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: value = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) value)) = 0
        return: c.LMX_WALK_OK
    ---
    e: lmx_implements_find(arena, value, value)
    if: e = 0 || e\exec_map = 0
        if: value != 0
            part_value_array: (cast: (@: c.VoidArray) (@ value\array))
        ---
        width: part_value_array\size
        if: width > ((cast: (size_t) -1) / 2U)
            return: c.LMX_WALK_NOMEM
        if: edge >= width * 2U
            out_answer[0]: c.LMX_IMPLEMENTS_NO
            return: c.LMX_WALK_OK
        ---
        if: edge >= width
            edge: edge - width
            last: 1
        ---
        slot: edge
        if: e != 0
            if: lmx_implements_coordinate(arena, e, edge, last, @ slot) != 0
                return: c.LMX_WALK_INVALID
            ---
        ---
        if: slot = (cast: (size_t) -1)
            return: c.LMX_WALK_OK
        if: slot >= width
            out_answer[0]: c.LMX_IMPLEMENTS_NO
            return: c.LMX_WALK_OK
        \out: slot
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    ---
    if: e\exec_n > ((cast: (size_t) -1) / 2U)
        return: c.LMX_WALK_NOMEM
    if: edge >= e\exec_n * 2U
        out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    ---
    slot: e\exec_map[edge]
    if: slot = (cast: (size_t) -1)
        return: c.LMX_WALK_OK
    if: value != 0
        part_value_array: (cast: (@: c.VoidArray) (@ value\array))
    ---
    if: slot >= part_value_array\size
        out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    ---
    \out: slot
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_implements_exec_coordinate

fn: lmx_implements_exec_slot (@: arena c.LmxArena; @: value c.Lmx; size_t: edge; @: out size_t; @: out_answer int) int
    @: e c.LmxImplEntry
    size_t: slot
    int: status
    if: out = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    \out: (cast: (size_t) -1)
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    status: lmx_implements_exec_coordinate(arena, value, edge, @ slot, out_answer)
    if: status != c.LMX_WALK_OK || out_answer[0] != c.LMX_IMPLEMENTS_YES
        return: status
    e: lmx_implements_find(arena, value, value)
    if: e != 0
        lmx_implements_hole(arena, e, @ slot)
    if: slot = (cast: (size_t) -1)
        out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    \out: slot
    return: c.LMX_WALK_OK
end: lmx_implements_exec_slot

# Native OWN uses the same proved source edge as the walker. An invalid
# projection becomes an out-of-range index; lmx_arena_ref_cell then returns
# null, so no source ordinal can silently address a different value slot.
fn: lmx_implements_exec_index (@: arena c.LmxArena; @: value c.Lmx; size_t: edge) size_t
    size_t: slot
    int: answer
    # Existing scalar query boundary: unavailable address stays the invalid
    # index sentinel. This does not establish or refuse an admission.
    if: lmx_implements_exec_slot(arena, value, edge, @ slot, @ answer) != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        return: (cast: (size_t) -1)
    ---
    return: slot
end: lmx_implements_exec_index

# Current physical CALL operand -> selected physical formal and its known
# SOURCE coordinate. Both buffers belong to this invocation's caller scratch.
# Numeric access reads no names, publishes no proof and interprets no
# SOURCE/witness/default contents; it never recovers an earlier CALL map.
fn: lmx_callable_bound_in (@: arena c.LmxArena; @: selected c.Lmx; @: written_call c.Lmx; @: view c.LmxImplEntry; @: source_indices size_t; size_t: source_capacity; size_t: operand_slot; @: out_source size_t; @: out_physical size_t; @: out_answer int) int
    size_t: selected_count 0U
    size_t: selected_physical (cast: (size_t) -1)
    size_t: current_physical (cast: (size_t) -1)
    size_t: source_index (cast: (size_t) -1)
    int: answer
    int: status
    if: out_source = 0 || out_physical = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    out_source[0]: (cast: (size_t) -1)
    out_physical[0]: (cast: (size_t) -1)
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: view = 0 || source_indices = 0
        return: c.LMX_WALK_OK
    # Only the current borrowed relation is evidence for this invocation.
    # An empty representation never synthesizes identity or consults a cache.
    if: view\map = 0 && view\frame = 0
        return: c.LMX_WALK_OK
    if: view\value != selected || view\req != written_call
        return: c.LMX_WALK_INVALID
    if: source_capacity < view\n || operand_slot >= view\n
        return: c.LMX_WALK_INVALID
    if: c.lmx_graph_node_in(arena, (cast: (@: void) written_call)) = 0 || lmx_callable_source_count(arena, selected, @ selected_count) != 0
        return: c.LMX_WALK_OK
    source_index: source_indices[operand_slot]
    if: source_index = (cast: (size_t) -1) || source_index >= selected_count
        return: c.LMX_WALK_OK
    if: lmx_implements_coordinate(arena, view, operand_slot, 0, @ selected_physical) != 0
        return: c.LMX_WALK_INVALID
    if: selected_physical = (cast: (size_t) -1)
        return: c.LMX_WALK_OK
    @: selected_fields c.VoidArray @ selected\array
    if: selected_physical >= selected_fields\size
        return: c.LMX_WALK_OK
    # The admitting worker already established SOURCE s. A forward numeric
    # check preserves s0/s1 even if both map to q0; no ambiguous inverse or
    # name lookup is needed. A changed/unavailable place is an access U.
    status: lmx_implements_exec_coordinate(arena, selected, source_index, @ current_physical, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    if: answer != c.LMX_IMPLEMENTS_YES || current_physical != selected_physical
        return: c.LMX_WALK_OK
    out_source[0]: source_index
    out_physical[0]: selected_physical
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_callable_bound_in

# Pure execution adapter for the current operation's borrowed physical map.
# It never recovers a CALL binding from an earlier arena admission. The caller
# keeps both buffers live through argument materialization and scratch rewind.
fn: lmx_callable_bound_operand (@: arena c.LmxArena; @: selected c.Lmx; @: written_call c.Lmx; @: current c.LmxImplEntry; @: source_indices size_t; size_t: source_capacity; size_t: operand_slot; @: out_source size_t; @: out_physical size_t; @: out_answer int) int
    return: lmx_callable_bound_in(arena, selected, written_call, current, source_indices, source_capacity, operand_slot, out_source, out_physical, out_answer)
end: lmx_callable_bound_operand

# The callback receives both halves of the ordinary code/data call. Even a
# distinct code occurrence can itself be the result of an earlier merge, with
# source-code coordinates already projected onto that occurrence. Compose
# that proof with the admission of the current data to the code occurrence.
# The ordinal and LAST halves keep their separate meaning at both steps.
fn: lmx_implements_code_slot (@: arena c.LmxArena; @: value c.Lmx; @: code c.Lmx; size_t: edge; @: out size_t; @: out_answer int) int
    @: part_code_array c.VoidArray 0
    @: source_self c.LmxImplEntry
    size_t: source_width
    size_t: middle
    size_t: req_edge
    int: status
    int: answer
    if: out = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    \out: (cast: (size_t) -1)
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: value = 0 || code = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) value)) = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) code)) = 0
        return: c.LMX_WALK_OK
    ---
    if: value = code
        return: lmx_implements_exec_slot(arena, value, edge, out, out_answer)
    ---
    source_self: lmx_implements_find(arena, code, code)
    if: code != 0
        part_code_array: (cast: (@: c.VoidArray) (@ code\array))
    ---
    source_width: part_code_array\size
    if: source_self != 0 && source_self\exec_map != 0
        source_width: source_self\exec_n
    ---
    status: lmx_implements_exec_slot(arena, code, edge, @ middle, @ answer)
    if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        if: status = c.LMX_WALK_OK
            out_answer[0]: answer
        return: status
    ---
    @: scope c.LmxCallPlaces arena\call_places
    if: scope != 0 && scope\code = code && scope\data = value && scope\requirements = 0 && middle < scope\root_count && scope\root_slots[middle] != (cast: (size_t) -1)
        out[0]: scope\root_slots[middle]
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    req_edge: middle
    if: edge >= source_width
        if: code != 0
            part_code_array: (cast: (@: c.VoidArray) (@ code\array))
        ---
        if: part_code_array\size > ((cast: (size_t) -1) - middle)
            return: c.LMX_WALK_NOMEM
        ---
        if: code != 0
            part_code_array: (cast: (@: c.VoidArray) (@ code\array))
        ---
        req_edge: part_code_array\size + middle
    ---
    return: lmx_implements_slot(arena, value, code, req_edge, out, out_answer)
end: lmx_implements_code_slot

fn: lmx_implements_code_index (@: arena c.LmxArena; @: value c.Lmx; @: code c.Lmx; size_t: edge) size_t
    size_t: slot
    int: answer
    if: lmx_implements_code_slot(arena, value, code, edge, @ slot, @ answer) != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        return: (cast: (size_t) -1)
    ---
    return: slot
end: lmx_implements_code_index

# Resolve coordinates against the selected description. A graph copy keeps
# its source layout evidence; a value admitted later to that layout already
# has the required map, but not necessarily a direct record to this copy.
# Compose those existing address maps once. No names, type guess, tests or
# new receiving proof participate.
fn: lmx_implements_resolve_map (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @@: out c.LmxImplEntry; @: out_answer int) int
    @: part_req_array c.VoidArray 0
    @: direct c.LmxImplEntry
    @: own c.LmxImplEntry
    c.LmxImplEntry: pair
    @: layout void
    int: applied 0
    int: status
    if: out = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    \out: 0
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: arena = 0
        return: c.LMX_WALK_INVALID
    if: value = 0 || req = 0
        return: c.LMX_WALK_OK
    direct: lmx_implements_find(arena, value, req)
    if: direct != 0
        \out: direct
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    layout: lmx_implements_layout(arena, req)
    own: lmx_implements_find(arena, req, req)
    if: layout = 0 || own = 0
        return: c.LMX_WALK_OK
    c.memcpy((cast: (@: void) (@ pair)), (cast: (@: void) own), c.sizeof(c.LmxImplEntry))
    if: pair\frame = 0 && pair\map = 0
        if: req != 0
            part_req_array: (cast: (@: c.VoidArray) (@ req\array))
        ---
        pair\n: part_req_array\size
    ---
    status: lmx_implements_compose_receiving(arena, value, layout, req, @ pair, -1, 0, @ applied, out_answer)
    if: status != c.LMX_WALK_OK
        return: status
    \out: lmx_implements_find(arena, value, req)
    if: \out = 0
        out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    return: c.LMX_WALK_OK
end: lmx_implements_resolve_map

# The value's physical slot for EDGE j (K01): an edge below the width is req's field j through the
# ordinal half -- an explicit `[N]name` use -- and an edge from width to 2*width-1 is the LAST half
# of field j - width, which is what a bare `name` use names.  The width is req's own (a view with
# neither frame nor map is positional identity, where both halves are the same slot).
fn: lmx_implements_slot (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; size_t: j; @: out size_t; @: out_answer int) int
    @: part_req_array c.VoidArray 0
    @: part_value_array c.VoidArray 0
    @: e c.LmxImplEntry
    size_t: k 0U
    size_t: w
    int: status
    int: last 0
    if: out = 0 || out_answer = 0
        return: c.LMX_WALK_INVALID
    \out: (cast: (size_t) -1)
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    status: lmx_implements_resolve_map(arena, value, req, @ e, out_answer)
    if: status != c.LMX_WALK_OK || e = 0
        return: status
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: c.lmx_graph_node_in(arena, (cast: (@: void) req)) = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) value)) = 0
        out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
        return: c.LMX_WALK_OK
    if: req != 0
        part_req_array: (cast: (@: c.VoidArray) (@ req\array))
    ---
    w: part_req_array\size
    if: w > ((cast: (size_t) -1) / 2U)
        return: c.LMX_WALK_NOMEM
    if: j >= w
        if: j >= w * 2U
            out_answer[0]: c.LMX_IMPLEMENTS_NO
            return: c.LMX_WALK_OK
        ---
        j: j - w
        last: 1
    ---
    if: lmx_implements_coordinate(arena, e, j, last, @ k) != 0
        return: c.LMX_WALK_INVALID
    # A persistent unset number carries no negative interface proof.
    if: k = (cast: (size_t) -1)
        out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
        return: c.LMX_WALK_OK
    lmx_implements_hole(arena, e, @ k)
    part_value_array: (cast: (@: c.VoidArray) (@ value\array))
    if: k = (cast: (size_t) -1) || k >= part_value_array\size
        out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    \out: k
    out_answer[0]: c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK
end: lmx_implements_slot

# Book, "При последовательных композициях соответствия составляются": req -> I from the record of (I, req) and I -> value from the
# record of (value, I) give (value, req) with no names and no new proof, each half through the same half at both steps.  YES when
# such a chain exists and its composition is now recorded; UNKNOWN when none does.
fn: lmx_implements_chain (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; @: out_answer int) int
    size_t: i 0U
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    while: i < arena\impl_len
        @: first c.LmxImplEntry arena\impl + i
        if: first\value = value && first\req != 0 && first\req != req && first\req != value
            @: middle c.Lmx (cast: (@: c.Lmx) first\req)
            @: pair_found c.LmxImplEntry lmx_implements_find(arena, middle, req)
            @: layout void lmx_implements_layout(arena, middle)
            if: pair_found != 0 && layout != 0
                c.LmxImplEntry: pair
                int: applied 0
                c.memcpy((cast: (@: void) (@ pair)), (cast: (@: void) pair_found), c.sizeof(c.LmxImplEntry))
                @: fields c.VoidArray @ req\array
                @: pair_view c.LmxImplEntry @ pair
                if: pair_view\frame = 0 && pair_view\map = 0
                    pair_view\n: fields\size
                ---
                int: status lmx_implements_compose_receiving(arena, value, layout, req, pair_view, -1, 0, @ applied, out_answer)
                if: status != c.LMX_WALK_OK
                    return: status
                if: out_answer[0] = c.LMX_IMPLEMENTS_YES && lmx_implements_find(arena, value, req) != 0
                    return: c.LMX_WALK_OK
                out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
            ---
        ---
        i: i + 1U
    ---
    return: c.LMX_WALK_OK
end: lmx_implements_chain

# A reached edge of (value, req) with no number.  The operation being run is the Consumer and this edge is what it uses (CODEX-OPUS-276-REVIEW-
# CONSUMER-20261104T024655Z-01; the author 2026-10-26): the ordinary reception by that coverage, one pair with nothing below it, whose NO is the
# ordinary implicit `implements`.  A later edge is a later use: the record keeps the numbers it had and this one, so that edge comes back here and
# gets its own contract checked, and no number stands for a field nothing has looked at.
fn: lmx_implements_admit_edge (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; size_t: edge; @: out size_t; @: out_answer int) int
    @: fields c.VoidArray @ req\array
    size_t: width fields\size
    size_t: i 0U
    int: status
    out_answer[0]: c.LMX_IMPLEMENTS_NO
    if: width > ((cast: (size_t) -1) / 2U) / c.sizeof(c.size_t)
        return: c.LMX_WALK_NOMEM
    if: edge >= width * 2U
        return: c.LMX_WALK_OK
    @: kept size_t (cast: (@: size_t) c.malloc(width * 2U * c.sizeof(c.size_t)))
    @: cells size_t (cast: (@: size_t) c.malloc(4U * c.sizeof(c.size_t)))
    if: kept = 0 || cells = 0
        c.free((cast: (@: void) kept))
        c.free((cast: (@: void) cells))
        return: c.LMX_WALK_NOMEM
    @: before c.LmxImplEntry lmx_implements_find(arena, value, req)
    while: i < width * 2U
        kept[i]: (cast: (size_t) -1)
        if: before != 0
            size_t: index i
            int: last 0
            if: i >= width
                index: i - width
                last: 1
            ---
            if: lmx_implements_coordinate(arena, before, index, last, @ kept[i]) != 0
                kept[i]: (cast: (size_t) -1)
            ---
        ---
        i: i + 1U
    ---
    cells[0]: 4U
    cells[1]: 1U
    cells[2]: edge
    cells[3]: 0U
    c.LmxImplUses: scope
    c.memset((cast: (@: void) (@ scope)), 0, c.sizeof(c.LmxImplUses))
    scope\map: cells
    status: lmx_implements_admit_receiving_templates(arena, value, req, 0, 0U, @ scope, out_answer)
    c.free((cast: (@: void) cells))
    if: status != c.LMX_WALK_OK || out_answer[0] = c.LMX_IMPLEMENTS_NO
        c.free((cast: (@: void) kept))
        return: status
    @: after c.LmxImplEntry lmx_implements_find(arena, value, req)
    if: after != 0 && after\frame = 0 && after\map != 0 && after\owned_map != 0 && after\n = width
        @: numbers size_t after\map
        kept[edge]: numbers[edge]
        c.memcpy((cast: (@: void) numbers), (cast: (@: void) kept), width * 2U * c.sizeof(c.size_t))
    ---
    c.free((cast: (@: void) kept))
    status: lmx_implements_slot(arena, value, req, edge, out, out_answer)
    # A named half the reception left without a number: value holds the name at two or more heads and a bare name selects none of them.
    if: status = c.LMX_WALK_OK && out_answer[0] = c.LMX_IMPLEMENTS_UNKNOWN
        i: edge
        if: i >= width
            i: i - width
        ---
        if: lmx_implements_view_name(arena, req, i) != 0
            out_answer[0]: c.LMX_IMPLEMENTS_NO
        ---
    ---
    return: status
end: lmx_implements_admit_edge

# A reached edge of (value, req): the number the map holds, or else (CODEX-OPUS-275-MAPS-20261103T214114Z-01).  No record of the pair: the composition of the records
# already made comes first.  Whatever number is still missing: this edge is admitted alone.  NO stays the negative answer; UNKNOWN that remains is no proof either way.
fn: lmx_implements_reach (@: arena c.LmxArena; @: value c.Lmx; @: req c.Lmx; size_t: edge; @: out size_t; @: out_answer int) int
    int: status lmx_implements_slot(arena, value, req, edge, out, out_answer)
    if: status != c.LMX_WALK_OK || out_answer[0] != c.LMX_IMPLEMENTS_UNKNOWN
        return: status
    if: value = 0 || req = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) value)) = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) req)) = 0
        return: c.LMX_WALK_OK
    if: lmx_implements_find(arena, value, req) = 0
        status: lmx_implements_chain(arena, value, req, out_answer)
        if: status != c.LMX_WALK_OK
            return: status
        if: out_answer[0] = c.LMX_IMPLEMENTS_YES
            status: lmx_implements_slot(arena, value, req, edge, out, out_answer)
            if: status != c.LMX_WALK_OK || out_answer[0] != c.LMX_IMPLEMENTS_UNKNOWN
                return: status
            ---
        ---
    ---
    return: lmx_implements_admit_edge(arena, value, req, edge, out, out_answer)
end: lmx_implements_reach

# After merge, a source's already proved code-to-source edges can be carried
# to the result through the ordinary admitted (result, copied_source)
# correspondence. The source and its graph copy may inhabit different arenas;
# graph copy preserves physical child indices, but intentionally does not give
# its new root the source's old admission. Both relations are address maps.
# No runtime name lookup or second graph is needed. The source's physical
# field slot is read through the matching ORDINAL or LAST half of the result's
# view of its copy, independently for both halves of the original code map.
fn: lmx_implements_exec_compose_copy (@: source_arena c.LmxArena; @: source c.Lmx; @: result_arena c.LmxArena; @: result c.Lmx; @: copied_source c.Lmx; @: out_answer int) int
    @: part_source_array c.VoidArray 0
    @: part_copied_source_array c.VoidArray 0
    @: part_result_array c.VoidArray 0
    @: source_self c.LmxImplEntry
    @: result_view c.LmxImplEntry
    @: map size_t 0
    size_t: n
    size_t: edge 0U
    size_t: middle
    size_t: final_slot
    int: answer
    int: status
    int: complete 1
    int: last
    if: out_answer = 0
        return: c.LMX_WALK_INVALID
    out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    if: source_arena = 0 || result_arena = 0
        return: c.LMX_WALK_INVALID
    if: result = 0 || source = 0 || copied_source = 0
        return: c.LMX_WALK_OK
    if: c.lmx_graph_node_in(source_arena, (cast: (@: void) source)) = 0 || c.lmx_graph_node_in(result_arena, (cast: (@: void) copied_source)) = 0 || c.lmx_graph_node_in(result_arena, (cast: (@: void) result)) = 0
        return: c.LMX_WALK_INVALID
    ---
    if: source != 0
        part_source_array: (cast: (@: c.VoidArray) (@ source\array))
    ---
    if: copied_source != 0
        part_copied_source_array: (cast: (@: c.VoidArray) (@ copied_source\array))
    ---
    if: part_source_array\size != part_copied_source_array\size
        out_answer[0]: c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_OK
    ---
    if: source_arena = result_arena && result = source && source = copied_source
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    ---
    result_view: lmx_implements_find(result_arena, result, copied_source)
    source_self: lmx_implements_find(source_arena, source, source)
    if: source != 0
        part_source_array: (cast: (@: c.VoidArray) (@ source\array))
    ---
    n: part_source_array\size
    if: source_self != 0 && source_self\exec_map != 0
        n: source_self\exec_n
    ---
    if: n = 0U
        out_answer[0]: c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    ---
    if: copied_source != 0
        part_copied_source_array: (cast: (@: c.VoidArray) (@ copied_source\array))
    ---
    if: n > ((cast: (size_t) -1) / c.sizeof(c.size_t)) / 2U || part_copied_source_array\size > ((cast: (size_t) -1) / 2U)
        return: c.LMX_WALK_NOMEM
    ---
    map: (cast: (@: size_t) c.malloc(n * 2U * c.sizeof(c.size_t)))
    if: map = 0
        return: c.LMX_WALK_NOMEM
    ---
    while: edge < n * 2U
        status: lmx_implements_exec_coordinate(source_arena, source, edge, @ middle, @ answer)
        if: status != c.LMX_WALK_OK
            c.free((cast: (@: void) map))
            return: status
        ---
        if: answer = c.LMX_IMPLEMENTS_NO
            c.free((cast: (@: void) map))
            out_answer[0]: answer
            return: c.LMX_WALK_OK
        ---
        if: answer != c.LMX_IMPLEMENTS_YES || result_view = 0
            map[edge]: (cast: (size_t) -1)
            complete: 0
            edge: edge + 1U
            continue
        ---
        last: 0
        if: edge >= n
            last: 1
        if: lmx_implements_coordinate(result_arena, result_view, middle, last, @ final_slot) != 0
            c.free((cast: (@: void) map))
            return: c.LMX_WALK_INVALID
        if: final_slot = (cast: (size_t) -1)
            complete: 0
        else:
            part_result_array: (cast: (@: c.VoidArray) (@ result\array))
            if: final_slot >= part_result_array\size
                c.free((cast: (@: void) map))
                out_answer[0]: c.LMX_IMPLEMENTS_NO
                return: c.LMX_WALK_OK
            ---
        ---
        map[edge]: final_slot
        edge: edge + 1U
    ---
    status: lmx_implements_exec_save(result_arena, result, map, n, out_answer)
    c.free((cast: (@: void) map))
    # Retain known coordinates even for an incomplete projection. An actual
    # access to its MAX stays unavailable; it cannot fall back to identity.
    # Native eligibility must still use the actual Consumer's needed edges,
    # not treat unknown edges as either proved unused or guaranteed missing.
    if: status = c.LMX_WALK_OK && out_answer[0] != c.LMX_IMPLEMENTS_NO && complete = 0
        out_answer[0]: c.LMX_IMPLEMENTS_UNKNOWN
    return: status
end: lmx_implements_exec_compose_copy

fn: lmx_implements_exec_compose (@: arena c.LmxArena; @: result c.Lmx; @: source c.Lmx; @: out_answer int) int
    return: lmx_implements_exec_compose_copy(arena, source, arena, result, source, out_answer)
end: lmx_implements_exec_compose

# One record appended into room the caller took (lmx_arena_impl_room): a copy's carried correspondence,
# proved by the record it carries -- the copy keeps its source's coordinates (lmx_copy_carry_records).
# An owned computed map is cloned because the copied record can outlive the source record;
# module maps and frame cells keep their existing storage. 0, or 1 when there is no room.
fn: lmx_implements_append (@: arena c.LmxArena; @: v c.LmxImplEntry) int
    @: copy size_t 0
    @: exec_copy size_t 0
    @: appended c.LmxImplEntry
    if: arena = 0 || v = 0 || arena\impl = 0 || arena\impl_len >= arena\impl_cap
        return: 1
    if: v\owned_map != 0
        copy: lmx_implements_map_clone((cast: (@: size_t) v\map), (cast: (size_t) v\n))
        if: copy = 0
            return: 1
        ---
    ---
    if: v\exec_map != 0
        exec_copy: lmx_implements_map_clone((cast: (@: size_t) v\exec_map), (cast: (size_t) v\exec_n))
        if: exec_copy = 0
            if: copy != 0
                c.free((cast: (@: void) copy))
            ---
            return: 1
        ---
    ---
    c.memcpy((cast: (@: void) (arena\impl + arena\impl_len)), (cast: (@: void) v), c.sizeof(c.LmxImplEntry))
    appended: arena\impl + arena\impl_len
    c.lmx_arena_impl_contract_retain(appended\contract)
    if: copy != 0
        appended\map: copy
    ---
    if: exec_copy != 0
        appended\exec_map: exec_copy
    ---
    arena\impl_len: arena\impl_len + 1U
    return: 0
end: lmx_implements_append

# Whether `value` is a partial copy: its record with itself carries holes (lmx_copy_carry_records).  1 or 0.
fn: lmx_implements_holes (@: arena c.LmxArena; @: value c.Lmx) int
    @: e c.LmxImplEntry
    e: lmx_implements_find(arena, value, value)
    if: e != 0 && e\holes != 0
        return: 1
    return: 0
end: lmx_implements_holes

# The slot of part `part` of a receiver-produced callable (the FN pool role; the book, #method-parts: args, the description of the
# return where there is one, var and body are the parts of one Structure).  `part` is the part as the contract numbers it: 0 args,
# 1 return, 2 var, 3 body.  A `fn` holds the four in that order; a `sub` returns no value and holds three, its var and body one
# slot lower (slice 285, SUB-OWN-FIELD-CALL).  The producer's role and its part count say which; ordinary data of the same shape
# has no role.  SIZE_MAX for a part the callable does not have, and for anything that is no such callable.
fn: lmx_callable_part (@: arena c.LmxArena; @: code c.Lmx; size_t: part) size_t
    @: pool c.LmxPool 0
    if: arena = 0 || code = 0 || part > 3U || c.lmx_range_classify(arena, (cast: (@: void) code)) != c.LMX_KIND_STRUCT
        return: (cast: (size_t) -1)
    pool: c.lmx_range_cell_pool(arena, (cast: (@: void) code))
    if: pool = 0 || pool\role != c.LMX_POOL_ROLE_FN
        return: (cast: (size_t) -1)
    @: fields c.VoidArray @ code\array
    if: fields\size = 4U
        return: part
    if: fields\size != 3U || part = 1U
        return: (cast: (size_t) -1)
    if: part = 0U
        return: 0U
    return: part - 1U
end: lmx_callable_part

# Slice 286: the value written into a callable place and the place's declaration declare the same throws in the same order --
# the ordinal space the place's callers handle (lmx_walk_key_from_ordinal), the static rule's same throws
# (lm_compiler_throws_same).  Ordinal k past the declared ones is an implicit key, so the first implicit key both give
# ends the comparison.  YES, NO, or UNKNOWN when a header gives no key.
fn: lmx_implements_same_throws (@: arena c.LmxArena; @: value c.Lmx; @: declared c.Lmx) int
    size_t: k 1U
    size_t: a 0U
    size_t: b 0U
    while: k != 0U
        if: c.lmx_walk_key_from_ordinal(arena, value, k, @ a) != c.LMX_WALK_OK || c.lmx_walk_key_from_ordinal(arena, declared, k, @ b) != c.LMX_WALK_OK
            return: c.LMX_IMPLEMENTS_UNKNOWN
        if: a != b
            return: c.LMX_IMPLEMENTS_NO
        if: a < (cast: (size_t) c.LMX_WALK_NAME_DECLARED)
            return: c.LMX_IMPLEMENTS_YES
        k: k + 1U
    ---
    return: c.LMX_IMPLEMENTS_UNKNOWN
end: lmx_implements_same_throws

# The write of a value into a declared callable place (slice 286, CALLABLE-PLACE-FREE-SIGNATURE; Codex, 285 norm answers item 3;
# the book :370, :373, :387): the place has the signature its definition gave it, `declared` -- the callable the definition
# put there, which the slot keeps (lmx_source_place_callable_set).  A fn or a sub written there must take the call that description forms
# (lmx_implements_call_takes, the directional check of Q49) and declare the same throws (lmx_implements_same_throws), or the
# write is the implicit `implements`, before anything changes.  An unknown answer refuses nothing.  An ordinary Structure
# stands there as before: the selected call's admission asks it at the call (slice 283).  OK or the throw.
fn: lmx_implements_place_callable (@: arena c.LmxArena; @: value void; @: declared c.Lmx) int
    @: pool c.LmxPool 0
    if: arena = 0 || value = 0 || declared = 0 || c.lmx_range_classify(arena, value) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_OK
    pool: c.lmx_range_cell_pool(arena, value)
    if: pool = 0 || pool\role != c.LMX_POOL_ROLE_FN
        return: c.LMX_WALK_OK
    if: lmx_implements_call_takes(arena, value, (cast: (@: void) declared)) = c.LMX_IMPLEMENTS_NO || lmx_implements_same_throws(arena, (cast: (@: c.Lmx) value), declared) = c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_IMPLEMENTS
    return: c.LMX_WALK_OK
end: lmx_implements_place_callable
