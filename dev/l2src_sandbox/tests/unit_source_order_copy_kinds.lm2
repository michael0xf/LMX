# Named fields inside conditions and expressions read the selected copy.
Outer:
    hStruct:
        int: p 3
    end: hStruct
    char: hChar 'C'
    int: hInt 77
    fn: read () int
        if: node\hChar != 'C'
            return: 81
        return: node\hStruct\p + node\hInt
    end: read
end: Outer
copy: merge: Outer
copy\hStruct\p: 11
int: ok 7
if: Outer\read() != 80 || copy\read() != 88
    ok: 82
if: Outer\hStruct\p != 3 || copy\hStruct\p != 11
    ok: 83
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
