        return: (cast: (int) (status))
    if: status = 3 || selected = 0
        return: (cast: (int) (1))
    if: status = 0 && selected\n = 0
        if: selected\root_kind = 6
            return: (cast: (int) (lm_compiler_rw_binding_value(selected, parent, out)))
