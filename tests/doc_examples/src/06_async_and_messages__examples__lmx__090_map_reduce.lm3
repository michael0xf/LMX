MapperMessage:
    int: value
    @: even
    @: odd
    @: barrier
    map:
        @: reducer even
        if: value % 2 = 1
            reducer := odd
        post:
            ask:
                reducer\add()
            answer:
                barrier\accepted

ReducerMessage:
    int: count 0
    return: int
    add:
        node\count += 1
        return: read()
    read:
        return: node\count

