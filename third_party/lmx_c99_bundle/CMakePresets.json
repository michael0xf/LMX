{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "posix-release",
      "displayName": "C99 POSIX static release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/posix-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "LMX_BUILD_EXAMPLES": "ON",
        "LMX_STRICT_C99": "ON"
      }
    },
    {
      "name": "math-only",
      "displayName": "C99 mathematical toolbox only",
      "inherits": "posix-release",
      "binaryDir": "${sourceDir}/build/math-only",
      "cacheVariables": {
        "LMX_WITH_STB": "OFF",
        "LMX_WITH_KLIB": "OFF",
        "LMX_WITH_STC": "OFF",
        "LMX_WITH_CURL_ZLIB": "OFF",
        "LMX_WITH_SODIUM": "OFF",
        "LMX_WITH_SQLITE3": "OFF",
        "LMX_WITH_RUNTIME_EXTRAS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "posix-release",
      "configurePreset": "posix-release"
    },
    {
      "name": "math-only",
      "configurePreset": "math-only"
    }
  ],
  "testPresets": [
    {
      "name": "posix-release",
      "configurePreset": "posix-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "math-only",
      "configurePreset": "math-only",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
