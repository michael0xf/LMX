# Crossing a callable field stays in the qualified graph. The explicit path
# to the saved method's own cell cannot be written.
independent:
    const:
        immutable:
            (): E
                int: frozen 7
                fn: bump () int
                    int: x 0
                    return: x
                end: bump
            end: E
        end: immutable
    end: const
end: independent
E\bump\x: 4
int: ok 7
if: E\bump\x != 4 || E\frozen != 7
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
