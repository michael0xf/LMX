# No autofill where the receiving contract does not take the value (Р110 item 3): x stays without a value and
# the call is not refused.
(
    Observed:
        int: seen 0
)
@: shared data[0]
fn: callee (int: x) int
    return: 1
fn: caller () int
    int: y 7
    @: x int @y
    return: callee()
sub: main ()
    shared\Observed\seen := caller()
main()
