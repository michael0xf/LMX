+fn: sealed_here (@: arena c.LmxArena; @: value void) int
+    @: pool c.LmxPool c.lmx_range_pool(arena, value)
+    if: pool = 0
+        return: 0
+    return: c.lmx_pool_is_sealed(pool)
+end: sealed_here
