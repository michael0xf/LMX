# FABLE-SONNET-NAME-SPECIALS-20260924-155: lm_own_copy_bytes used to
# resolve through l2_is_known's hard-coded adapter list; this predef is
# the general mechanism's own declaration for it (a prototype-only header,
# matching every other predef target in this corpus -- l2_predef_file_has_
# function only recognizes names inside a prototype: block or a chained
# predef:, never a plain top-level fn:/sub: body like l1src/own.lm1 itself).
predef: "l1src/own.h.lm1"
fn: m (int: z) @: char
    return: lm_own_copy_bytes(0, c.sizeof(c.Foo))
end: m
return: 0
