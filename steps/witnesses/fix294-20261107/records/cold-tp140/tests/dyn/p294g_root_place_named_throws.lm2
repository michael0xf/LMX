# Slice 294 probe: p294f with every implicit name caught, to locate what leaves the walked run uncaught.  Codes:
# write_root 24 implements, 23 interpreter, 25 convert, 22 call; call_bare 42/43/44/45 (call, implements, interpreter,
# convert); call_path 52/53/54/55.  Entry 7.
fn: f0 (int: x; int: y) int
    return: x * 10 + y
end: f0
fn: g (int: y; int: x) int
    return: x * 10 + y
end: g
int: Hw 0
fn: write_root () int
    ---
        @: node\f0 Hw
        return: 1
        catch: implements ()
            return: 24
        catch: interpreter ()
            return: 23
        catch: convert ()
            return: 25
        catch: call ()
            return: 22
    ---
end: write_root
fn: call_bare () int
    ---
        int: got f0(x: 1; y: 2)
        return: got
        catch: call ()
            return: 42
        catch: implements ()
            return: 43
        catch: interpreter ()
            return: 44
        catch: convert ()
            return: 45
    ---
end: call_bare
fn: call_path () int
    ---
        int: got node\f0(x: 3; y: 4)
        return: got
        catch: call ()
            return: 52
        catch: implements ()
            return: 53
        catch: interpreter ()
            return: 54
        catch: convert ()
            return: 55
    ---
end: call_path
fn: run () int
    int: v 0
    @: Hw g g
    v: write_root()
    if: v != 1
        return: v
    ---
    v: call_bare()
    if: v != 12
        return: v
    ---
    v: call_path()
    if: v != 34
        return: 100 + v
    ---
    return: 7
end: run
int: code run()
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
