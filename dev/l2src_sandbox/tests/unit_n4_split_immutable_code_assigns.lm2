# N4 (LMX_semantics.ru.md #qualification: protection follows the storage a write reaches; plan D12): the eternal code
# E assigns its x, which under call: E D is the x of the mutable D, never a cell of E, so the call runs: D\x becomes
# 2 and the qualified E is not written. Entry 7.
independent:
    const:
        immutable:
            (): E
                int: x
                x: x + 1
            end: E
        end: immutable
    end: const
end: independent
D:
    int: x 1
end: D
call: E D
int: r 81
if: D\x = 2
    r: 7
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
