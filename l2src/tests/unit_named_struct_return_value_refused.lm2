# Q19.1: "У именнованной структуры может быть только "return" без аргументов" -- a `return` with a
# value in a named Structure's body is refused where it stands, in its own words (REVIEW 0c601ea: it
# was refused by the phrase of another rule).
Counter:
    size_t: n 0U
    return: n
return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
