                    return: (cast: (int) (1))
                if: \out_ty >= 100
                    \out_ty: c.lm_compiler_foreign_intern_parts(@ resolved_word, resolved_depth, 1, foreign_raw_c_cell[0][\out_ty - 100])
                else:
                    \out_ty: c.lm_compiler_foreign_intern(@ resolved_word, resolved_depth, 1)
                ---
                if: \out_ty < 100
                    return: (cast: (int) (1))
                return: (cast: (int) (0))
