fn: read_i (@: p I) int
    return: p\y
end: read_i
fn: set_far_fat () int
    quote_far\b: Fat
    return: 0
end: set_far_fat
fn: set_far_thin () int
    quote_far\b: Thin
    return: 0
end: set_far_thin
fn: set_near_i () int
    quote_near\b: I
    return: 0
end: set_near_i
fn: records () int
    @: quote_far Far Far
    @: quote_near Near Near
    if: read_i(Thin) != 9
        return: 81
    int: a set_near_i()
    int: c set_far_fat()
    return: 0
end: records
fn: thin_in_far () int
    @: quote_far Far Far
    int: c set_far_thin()
    return: 0
end: thin_in_far
fn: composed () int
    int: r 0
    ---
        if: Near\b\y != 9
            r: 82
        ---
        catch: implements ()
            r: 83
    ---
    return: r
end: composed
fn: used_edge_alone () int
    int: r 0
    ---
        if: Near2\b\y != 9
            r: 84
        ---
        catch: implements ()
            r: 85
    ---
    return: r
end: used_edge_alone
fn: edge_of_later_use () int
    int: caught 0
    ---
        int: k Near2\b\extra
        catch: implements ()
            caught: 1
    ---
    if: caught != 1
        return: 86
    return: 0
end: edge_of_later_use
fn: edge_lacking () int
    int: caught 0
    ---
        int: k Near3\b\y
        catch: implements ()
            caught: 1
    ---
    if: caught != 1
        return: 87
    return: 0
end: edge_lacking
fn: edge_of_wrong_kind () int
    int: caught 0
    ---
        int: k Near4\b\y
        catch: implements ()
            caught: 1
    ---
    if: caught != 1
        return: 88
    return: 0
end: edge_of_wrong_kind
fn: later_edge_of_wrong_kind () int
    if: Near5\b\y != 9
        return: 89
    int: caught 0
    ---
        int: k Near5\b\extra
        catch: implements ()
            caught: 1
    ---
    if: caught != 1
        return: 90
    return: 0
end: later_edge_of_wrong_kind
int: code records()
Far2\b: Fat
Far3\b: Fat3
