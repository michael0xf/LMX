predef: "l2src/lmx_root.lm1"
predef: "l2src/lmx_settle.lm1"
predef: "l2src/lmx_service.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_manager.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_gc.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_list_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_call.lm1"
predef: "l2src/lmx_clock.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# lmx_root_host_selftest.lm1 -- THE HOST ROOT (FABLE-OPUS-ROOT-WALK-TRANSLATOR-20260924-159, commit
# 2h; author 2026-09-24, LMX_blog/2026-09-24.md).  The host is the Thread lmx_root_open makes (its
# own arena, mailbox, schedule, manager, service); lmx_root_launch runs in it.  In its first turn it
# reserves R0 as its ordinary child -- R0's own arena, R0's program installed by the program
# builder, the host's eternal settings (the working directory, lmx_root_settings) retained by
# reference -- and publishes it at the turn's end.  The host posts R0 the mainArgs letter, which is
# (sender; payload) like every letter: the host's Message, then a Structure holding mainArgs.  R0
# takes one turn from the host's manager, and the host's second turn takes its own inbox: a letter
# from R0 whose payload is exit(code; stdout; stderr) decides the exit.  Otherwise R0's `success` does:
# 1 -> 0 with empty texts, 0 -> 1 with the reason and, after the close's settle, the host's arena
# printed to stderr -- R0's arena, adopted under the success = 0 rule, marked `joined`.
#
# R0's program (host_program) is one native body, a children list, the settings reference and a
# witness int 52525.  Its body checks witness (5) on every turn: the settings reference it reads is
# the host's own branch (same address), classified in R0's arena as a view owned by the host's
# arena, and its one char Array is the working directory the OS gives.
#
# Launches, one per mode of R0's body:
#   1  success, reads the letter             -> exit 0, nothing on out or err
#   2  sends exit(7; "out-text"; "err-text") -> exit 7, out "out-text", err "err-text", no report
#   3  makes a failed child, no success      -> exit 1, reason, report: the child's 61727 and R0's
#                                               52525 in joined arrays
#   4  nothing                               -> exit 1, reason, report: R0's 52525 joined
#   0  no program name (argc 0)              -> exit 1, refused before the host opens
# Mutants (n159/hb.sh with JSON on lmx_root.lm1): mapping inverted, report skipped, joined nowhere,
# admission always yes, letter graph dropped, a bare mainArgs letter (no sender), settings not
# retained, inbox not taken -> RED.

@: LmxArena host_child_arena 0
@: LmxArena host_exit_arena 0
int: host_mode 0
int: host_turns 0
int: host_letters 0
int: host_args 0
int: host_arg_ok 0
int: host_sender_ok 0
int: host_settings_ok 0
int: host_child_ok 0
int: host_sent 0

# A failed child's body never runs: R0 takes one turn and the child none.
fn: host_child_body (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
return: 0

# A child of R0 in its own arena (the failed one of mode 3), holding the witness int 61727.
fn: host_make_child (@: LmxThread t) int
    @: LmxArena arena
    @: LmxMsg child
    @: LmxThread child_t
    @: LmxPost child_mail
    @: LmxSchedule child_sched
    @: LmxMethod method
    @: LmxCallable info
    @: LmxPool methods
    @: Lmx graph
    @: Lmx source
    @: LmxArrayDesc source_children
    @: void witness
    if: t = 0 || t\slot = 0 || host_child_arena = 0
        return: 0
    ---
    arena: t\slot\arena
    source: lmx_node_new_owned(arena)
    source_children: lmx_list_new_owned(c.LMX_TYPE_ARRAY_OF_POINTER_BASE + c.LMX_DOMAIN_THREAD, arena)
    if: source = 0 || source_children = 0 || lmx_arena_refs_open_owned(arena, source, 3U) != 0
        return: 0
    ---
    if: lmx_arena_ref_store(source, 1U, (cast: (@: void) source_children)) != 0
        return: 0
    ---
    child: lmx_child_reserve(t, arena, host_child_arena, 0, source)
    if: child = 0
        return: 0
    ---
    child_t: (cast: (@: LmxThread) child)
    methods: lmx_pool_make(host_child_arena, 2U * c.sizeof(c.LmxMethod), c.sizeof(c.LmxMethod), c.LMX_KIND_METHOD, c.LMX_TYPE_METHOD)
    if: methods = 0
        return: 0
    ---
    method: lmx_method_intern(host_child_arena, methods, (cast: (LmxEntry) host_child_body), 1U)
    graph: child\graph
    info: lmx_callable_new_owned(host_child_arena)
    if: method = 0 || graph = 0 || info = 0
        return: 0
    ---
    info\method: method
    lmx_arena_ref_store(graph, 0U, (cast: (@: void) info))
    witness: lmx_int_new_owned(host_child_arena)
    if: witness = 0 || lmx_int_store_known(witness, 61727) != 0 || lmx_arena_ref_store(graph, 2U, witness) != 0
        return: 0
    ---
    child_mail: (cast: (@: LmxPost) lmx_arena_take(host_child_arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    child_sched: (cast: (@: LmxSchedule) lmx_arena_take(host_child_arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: child_mail = 0 || child_sched = 0
        return: 0
    ---
    if: lmx_post_init(host_child_arena, child_mail) != c.LMX_POST_OK
        return: 0
    ---
    if: lmx_schedule_init(child_sched, host_child_arena, (cast: (@: void) child_t), 100000U) != c.LMX_SCHEDULE_OK
        return: 0
    ---
    if: lmx_thread_init(host_child_arena, child_t, graph, child_mail, child_sched) != c.LMX_THREAD_OK
        return: 0
    ---
    if: lmx_thread_scheduler_open(child_t, host_child_arena) != c.LMX_THREAD_OK
        return: 0
    ---
    if: lmx_child_thread(t, child, child_t) != c.LMX_CHILD_OK
        return: 0
    ---
return: 1

# R0's exit letter to its parent, the host: an anonymous Structure (sender; payload) whose payload
# is exit(7; "out-text"; "err-text"), posted through R0's service into the host's inbox.
fn: host_send_exit (@: LmxThread t) int
    @: LmxMsg letter
    @: Lmx lgraph
    @: Lmx payload
    @: void code
    @: LmxArrayDesc out
    @: LmxArrayDesc err
    @: void cell
    if: t = 0 || host_exit_arena = 0 || lmx_arena_open(host_exit_arena) != 0
        return: 0
    ---
    letter: (cast: (@: LmxMsg) lmx_arena_take(host_exit_arena, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
    lgraph: lmx_node_new_owned(host_exit_arena)
    payload: lmx_node_new_owned(host_exit_arena)
    code: lmx_int_new_owned(host_exit_arena)
    out: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_CHAR, 8U, host_exit_arena)
    err: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_CHAR, 8U, host_exit_arena)
    if: letter = 0 || lgraph = 0 || payload = 0 || code = 0 || out = 0 || err = 0
        return: 0
    ---
    if: lmx_arena_refs_open_owned(host_exit_arena, lgraph, 2U) != 0 || lmx_arena_refs_open_owned(host_exit_arena, payload, 3U) != 0
        return: 0
    ---
    lmx_int_store_known(code, 7)
    memcpy(out\data, (cast: (@: void) "out-text"), 8U)
    memcpy(err\data, (cast: (@: void) "err-text"), 8U)
    lmx_arena_ref_store(payload, 0U, code)
    lmx_arena_ref_store(payload, 1U, (cast: (@: void) out))
    lmx_arena_ref_store(payload, 2U, (cast: (@: void) err))
    # FABLE-SONNET-SEND-REF-20260925-172 commit 4 (edited under fable's authorization): the sender
    # slot is a pointer cell holding R0's own Message, not the address directly (author's Q26.2
    # ruling) -- the same shape l2trans.lm1's sendMessage letter emission now uses, so
    # lmx_root_exit_admit's own defensive classify-then-deref accepts this exit letter.
    cell: lmx_pointer_new_owned(c.LMX_TYPE_POINTER_BASE + 29, host_exit_arena)
    if: cell = 0 || lmx_pointer_store_known(cell, (cast: (@: void) lmx_thread_message(t))) != 0
        return: 0
    lmx_arena_ref_store(lgraph, 0U, cell)
    lmx_arena_ref_store(lgraph, 1U, (cast: (@: void) payload))
    letter\running: 1
    letter\success: 0
    letter\handoff_ready: 0
    letter\graph: lgraph
return: (cast: (int) (lmx_service_post(lmx_child_service(t), (cast: (@: void) lmx_thread_parent(t)), letter, host_exit_arena) = c.LMX_SERVICE_OK))

# (5): the settings R0 reads are the host's own branch -- the same address -- held in R0's arena as
# a view owned by the host's arena, and their one char Array is the working directory.
fn: host_settings_check (@: LmxThread t; @: Lmx graph) int
    c.array: [4096]: char here
    @: LmxThread host
    @: LmxMsg host_message
    @: Lmx host_graph
    @: void settings
    @: void host_branch
    @: LmxArrayDesc text
    @: LmxArena arena
    if: t = 0 || t\slot = 0 || graph = 0 || graph\len < 3
        return: 0
    ---
    arena: t\slot\arena
    settings: lmx_arena_ref_value(graph, 2U)
    host: lmx_thread_parent(t)
    if: settings = 0 || host = 0 || host\slot = 0
        return: 0
    ---
    host_message: lmx_thread_message(host)
    host_graph: host_message\graph
    if: host_graph = 0 || host_graph\len < 3
        return: 0
    ---
    host_branch: lmx_arena_ref_value(host_graph, 2U)
    if: settings != host_branch
        return: 0
    ---
    if: lmx_range_classify(arena, settings) != c.LMX_KIND_STRUCT || lmx_range_home(arena, settings) != host\slot\arena
        return: 0
    ---
    text: (cast: (@: LmxArrayDesc) lmx_arena_ref_value((cast: (@: Lmx) settings), 0U))
    if: text = 0 || lmx_root_os_cwd(here, 4096U) = 0
        return: 0
    ---
    if: text\len != strlen(here) || text\len = 0U
        return: 0
    ---
return: (cast: (int) (memcmp(text\data, (cast: (@: void) here), text\len) = 0))

# R0's body: user code.
fn: host_r0_body (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    @: LmxThread t
    @: LmxMsg message
    @: LmxMsg letter
    @: LmxThread host 0
    @: Lmx payload 0
    @: LmxArrayDesc args 0
    @: LmxArrayDesc arg
    @@: void slots
    @: void sender_cell 0
    host_turns: host_turns + 1
    t: lmx_thread_current()
    message: lmx_thread_message(t)
    if: t = 0 || message = 0 || message\graph = 0
        return: 0
    ---
    host_settings_ok: host_settings_check(t, message\graph)
    host_letters: (cast: (int) lmx_thread_mail_count(t, c.LMX_POST_INBOX))
    if: host_mode = 1
        # The letter is (sender; payload): field 0 the host's Message, field 1 the payload whose
        # one field is mainArgs.
        letter: (cast: (@: LmxMsg) lmx_thread_mail_take(t, c.LMX_POST_INBOX))
        if: letter != 0 && letter\graph != 0 && letter\graph\len = 2
            host: lmx_thread_parent(t)
            # FABLE-SONNET-SEND-REF-20260925-172 commit 4 (edited under fable's authorization): the
            # sender slot is a pointer cell now (author's Q26.2 ruling) -- classified before it is
            # read through, the same defensive shape lmx_root_exit_admit uses.
            sender_cell: lmx_arena_ref_value(letter\graph, 0U)
            if: host != 0 && sender_cell != 0 && lmx_domain_kind(t\slot\arena, sender_cell) = c.LMX_KIND_PRIMITIVE && lmx_domain_type(t\slot\arena, sender_cell) >= c.LMX_TYPE_POINTER_BASE && lmx_pointer_value_known(sender_cell) = (cast: (@: void) lmx_thread_message(host))
                host_sender_ok: 1
            ---
            payload: (cast: (@: Lmx) lmx_arena_ref_value(letter\graph, 1U))
            if: payload != 0 && payload\len = 1
                args: (cast: (@: LmxArrayDesc) lmx_arena_ref_value(payload, 0U))
            ---
            if: args != 0
                host_args: (cast: (int) args\len)
                slots: (cast: (@@: void) args\data)
                if: args\len > 1U
                    arg: (cast: (@: LmxArrayDesc) slots[1])
                    if: arg != 0 && arg\len = 6U && memcmp(arg\data, (cast: (@: void) "probe"), 6U) = 0
                        host_arg_ok: 1
                    ---
                ---
            ---
        ---
        message\success: 1
    ---
    if: host_mode = 2
        host_sent: host_send_exit(t)
    ---
    if: host_mode = 3
        host_child_ok: host_make_child(t)
    ---
return: 0

# R0's PROGRAM, installed by the host in R0's own graph and arena: its body, its children list, the
# host's settings and the witness 52525.
fn: host_program (@: LmxArena arena; @: Lmx graph; @: Lmx settings) int
    @: LmxPool methods
    @: LmxMethod method
    @: LmxCallable info
    @: LmxArrayDesc children
    @: void witness
    if: arena = 0 || graph = 0 || graph\len < 4
        return: 1
    ---
    methods: lmx_pool_make(arena, 2U * c.sizeof(c.LmxMethod), c.sizeof(c.LmxMethod), c.LMX_KIND_METHOD, c.LMX_TYPE_METHOD)
    info: lmx_callable_new_owned(arena)
    children: lmx_list_new_owned(c.LMX_TYPE_ARRAY_OF_POINTER_BASE + c.LMX_DOMAIN_THREAD, arena)
    witness: lmx_int_new_owned(arena)
    if: methods = 0 || info = 0 || children = 0 || witness = 0
        return: 1
    ---
    method: lmx_method_intern(arena, methods, (cast: (LmxEntry) host_r0_body), 1U)
    if: method = 0 || lmx_int_store_known(witness, 52525) != 0
        return: 1
    ---
    info\method: method
    if: lmx_arena_ref_store(graph, 0U, (cast: (@: void) info)) != 0 || lmx_arena_ref_store(graph, 1U, (cast: (@: void) children)) != 0
        return: 1
    ---
    if: lmx_arena_ref_store(graph, 2U, (cast: (@: void) settings)) != 0 || lmx_arena_ref_store(graph, 3U, witness) != 0
        return: 1
    ---
return: 0

sub: host_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
    c.fflush(0)
end: host_check

# The whole of a stream written by a launch, NUL-terminated, in `text` (at most cap - 1 bytes).
fn: host_read (@: void stream; @: char text; size_t: cap) size_t
    size_t: n 0U
    text[0]: 0
    if: stream = 0
        return: 0U
    c.fflush(stream)
    c.rewind(stream)
    n: c.fread((cast: (@: void) text), 1U, cap - 1U, stream)
    text[n]: 0
return: n

# Whether the report line holding `needle` is a cell of an array marked joined: the nearest array
# line above it reads `a<N> joined`.
fn: host_joined_holds (@: char text; const: @(char needle)) int
    @: char p
    @: char q
    p: strstr(text, needle)
    if: p = 0
        return: 0
    q: p
    while: q > text
        q: q - 1
        if: q[0] = 10 && q[1] = 97
            q: q + 2
            while: q[0] >= 48 && q[0] <= 57
                q: q + 1
            ---
            return: (cast: (int) (strncmp(q, " joined", 7U) = 0))
        ---
    ---
return: 0

# One launch in `mode` with `argc` arguments ("host", "probe"), its streams read back.
fn: host_launch (int: mode; int: argc; @: char out_text; @: char err_text) int
    LmxRoot: root
    LmxArena: child_arena
    LmxArena: exit_arena
    @@: char argv (cast: (@@: char) calloc(3U, c.sizeof(@: char)))
    @: void out
    @: void err
    int: code
    if: argv = 0
        return: 0 - 1
    ---
    memset((cast: (@: void) (@ child_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ exit_arena)), 0, c.sizeof(c.LmxArena))
    lmx_arena_open(@ child_arena)
    argv[0]: (cast: (@: char) "host")
    argv[1]: (cast: (@: char) "probe")
    argv[2]: 0
    host_child_arena: @ child_arena
    host_exit_arena: @ exit_arena
    host_mode: mode
    host_turns: 0
    host_letters: 0
    host_args: 0
    host_arg_ok: 0
    host_sender_ok: 0
    host_settings_ok: 0
    host_child_ok: 0
    host_sent: 0
    out: (cast: (@: void) c.fopen("lmx_root_host_selftest.out", "w+b"))
    err: (cast: (@: void) c.fopen("lmx_root_host_selftest.err", "w+b"))
    if: out = 0 || err = 0
        c.printf("FAIL the streams could not be opened\n")
        return: 0 - 1
    ---
    code: lmx_root_launch(@ root, argc, argv, host_program, 4U, lmx_root_settings, 120000U, out, err)
    host_read(out, out_text, 65536U)
    host_read(err, err_text, 65536U)
    c.fclose(out)
    c.fclose(err)
    # Arenas a launch left with this frame: the child's when no child took it, the exit letter's
    # when it was never taken (a taken letter's arena was attached to the host's and is empty).
    lmx_arena_release(@ child_arena)
    lmx_arena_release(@ exit_arena)
    free((cast: (@: void) argv))
    host_child_arena: 0
    host_exit_arena: 0
return: code

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    @: char out_text (cast: (@: char) calloc(65536U, 1U))
    @: char err_text (cast: (@: char) calloc(65536U, 1U))
    LmxArena: slot_arena
    LmxRootExit: got
    @: Lmx model 0
    @: Lmx letter 0
    @: Lmx payload 0
    @: Lmx short_letter 0
    @: Lmx short_payload 0
    @: Lmx wrong_payload 0
    @: void code 0
    @: void wrong_code 0
    @: LmxArrayDesc out_arr 0
    @: LmxArrayDesc err_arr 0
    @: char got_text 0
    @: void got_sender 0
    @: void cell 0
    size_t: got_out 0U
    size_t: got_err 0U
    int: got_code 0
    int: exit_code
    int: failures
    if: counts = 0 || out_text = 0 || err_text = 0
        return: 2
    ---

    # ---- 1: R0 sets success -> exit 0, nothing written ------------------------------------------
    exit_code: host_launch(1, 2, out_text, err_text)
    host_check(counts, exit_code = 0, "R0 set success and sent no exit: the host's exit is 0 (mutant: mapping inverted)")
    host_check(counts, host_turns = 1, "R0's body ran exactly once: one turn from the host's manager")
    host_check(counts, host_letters = 1, "the mainArgs letter was in R0's inbox at its turn")
    host_check(counts, host_sender_ok = 1, "the letter's field 0 is its sender, the host's Message: R0 can post back to it (mutant: a bare letter)")
    host_check(counts, host_args = 2 && host_arg_ok = 1, "the letter's field 1 is its payload, whose mainArgs carries argc 2 and argv[1] = probe (mutants: letter graph dropped, a bare letter)")
    host_check(counts, host_settings_ok = 1, "(5) R0 read the host's working directory through the retained reference: the host's branch, a view in R0's arena (mutant: settings not retained)")
    host_check(counts, out_text[0] = 0 && err_text[0] = 0, "a successful exit writes nothing to stdout or stderr")

    # ---- 2: R0 sends exit(7; out-text; err-text) -> the letter decides ----------------------------
    exit_code: host_launch(2, 2, out_text, err_text)
    host_check(counts, host_sent = 1, "R0 posted its exit letter to the host")
    host_check(counts, exit_code = 7, "the exit letter's code is the host's exit (mutant: inbox not taken)")
    host_check(counts, strcmp(out_text, "out-text") = 0, "the exit letter's stdout text is written to stdout")
    host_check(counts, strcmp(err_text, "err-text") = 0, "the exit letter's stderr text is written to stderr, and nothing else: no report")
    host_check(counts, host_settings_ok = 1, "(5) holds in the exit launch too")

    # ---- 3: a failed child, no success -> exit 1, reason, R0's arena joined in the report ---------
    exit_code: host_launch(3, 2, out_text, err_text)
    host_check(counts, host_child_ok = 1, "R0 made its child")
    host_check(counts, exit_code = 1, "R0 closed without an exit letter and without success: the host's exit is 1")
    host_check(counts, out_text[0] = 0, "nothing goes to stdout on a failed exit")
    host_check(counts, strstr(err_text, "lmx: R0 closed without an exit Message and with success = 0: its turn ended without setting success") != 0, "stderr gives the exit's reason")
    host_check(counts, strstr(err_text, "lmx: R0 closed with success = 0 -- the host's arena after the close's settle") != 0, "stderr carries the host's report (mutant: report skipped)")
    host_check(counts, host_joined_holds(err_text, " int 61727") = 1, "R0's failed child's witness is in an array marked joined (mutant: nothing joined)")
    host_check(counts, host_joined_holds(err_text, " int 52525") = 1, "R0's own witness is in an array marked joined: R0's arena was adopted by the host")
    if: counts[1] != 0
        c.printf("--- stderr of launch 3 ---\n%s--- end ---\n", err_text)
    ---

    # ---- 4: nothing -> exit 1, reason, R0's arena joined ---------------------------------------
    exit_code: host_launch(4, 2, out_text, err_text)
    host_check(counts, exit_code = 1, "R0 did nothing: the host's exit is 1")
    host_check(counts, strstr(err_text, "its turn ended without setting success") != 0, "stderr gives the exit's reason")
    host_check(counts, host_joined_holds(err_text, " int 52525") = 1, "R0's witness is in an array marked joined")
    host_check(counts, strstr(err_text, " int 61727") = 0, "no child's witness when R0 made none")

    # ---- 0: no program name -> exit 1, the host never opened -----------------------------------
    exit_code: host_launch(0, 0, out_text, err_text)
    host_check(counts, exit_code = 1 && host_turns = 0, "a launch without a program name is refused before the host opens")
    host_check(counts, strstr(err_text, "lmx: the host was given no root storage, no program name or no program") != 0, "the refusal's reason is on stderr")

    # ---- the exit letter's admission: (sender; payload), payload by position against the model --
    memset((cast: (@: void) (@ slot_arena)), 0, c.sizeof(c.LmxArena))
    host_check(counts, lmx_arena_open(@ slot_arena) = 0, "the slot's arena opened")
    model: lmx_root_exit_model(@ slot_arena)
    host_check(counts, model != 0 && model\len = 3, "the host model has three fields")
    letter: lmx_node_new_owned(@ slot_arena)
    payload: lmx_node_new_owned(@ slot_arena)
    code: lmx_int_new_owned(@ slot_arena)
    out_arr: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_CHAR, 2U, @ slot_arena)
    err_arr: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_CHAR, 4U, @ slot_arena)
    host_check(counts, letter != 0 && payload != 0 && code != 0 && out_arr != 0 && err_arr != 0, "an exit letter built")
    host_check(counts, lmx_arena_refs_open_owned(@ slot_arena, letter, 2U) = 0 && lmx_arena_refs_open_owned(@ slot_arena, payload, 3U) = 0, "its fields opened")
    lmx_int_store_known(code, 7)
    memcpy(out_arr\data, (cast: (@: void) "hi"), 2U)
    memcpy(err_arr\data, (cast: (@: void) "oops"), 4U)
    lmx_arena_ref_store(payload, 0U, code)
    lmx_arena_ref_store(payload, 1U, (cast: (@: void) out_arr))
    lmx_arena_ref_store(payload, 2U, (cast: (@: void) err_arr))
    # FABLE-SONNET-SEND-REF-20260925-172 commit 4 (edited under fable's authorization): the sender
    # slot is a pointer cell holding `model`'s address, not `model` directly (author's Q26.2
    # ruling) -- the same shape every other letter builder in this file now uses.
    cell: lmx_pointer_new_owned(c.LMX_TYPE_POINTER_BASE + 29, @ slot_arena)
    host_check(counts, cell != 0 && lmx_pointer_store_known(cell, (cast: (@: void) model)) = 0, "the sender cell built")
    lmx_arena_ref_store(letter, 0U, cell)
    lmx_arena_ref_store(letter, 1U, (cast: (@: void) payload))
    memset((cast: (@: void) (@ got)), 0, c.sizeof(c.LmxRootExit))
    host_check(counts, lmx_root_exit_admit(@ slot_arena, model, letter, @ got) = c.LMX_ROOT_OK, "a letter whose payload has the model's shape is admitted")
    got_code: got.exit_code
    got_out: got.out.len
    got_err: got.err.len
    got_text: got.err.data
    got_sender: got.sender
    host_check(counts, got_code = 7 && got_out = 2U && got_err = 4U && got_text != 0 && memcmp((cast: (@: void) got_text), (cast: (@: void) "oops"), 4U) = 0, "the admitted exit is read by position")
    host_check(counts, got_sender = (cast: (@: void) model), "the letter's field 0 is its sender")
    short_letter: lmx_node_new_owned(@ slot_arena)
    short_payload: lmx_node_new_owned(@ slot_arena)
    host_check(counts, short_letter != 0 && short_payload != 0 && lmx_arena_refs_open_owned(@ slot_arena, short_letter, 2U) = 0 && lmx_arena_refs_open_owned(@ slot_arena, short_payload, 2U) = 0, "a letter with a two-field payload built")
    lmx_arena_ref_store(short_payload, 0U, code)
    lmx_arena_ref_store(short_payload, 1U, (cast: (@: void) out_arr))
    lmx_arena_ref_store(short_letter, 0U, (cast: (@: void) model))
    lmx_arena_ref_store(short_letter, 1U, (cast: (@: void) short_payload))
    host_check(counts, lmx_root_exit_admit(@ slot_arena, model, short_letter, @ got) = c.LMX_ROOT_INVALID, "a payload without the third field is refused (mutant: admission always yes)")
    wrong_payload: lmx_node_new_owned(@ slot_arena)
    wrong_code: lmx_size_new_owned(@ slot_arena)
    host_check(counts, wrong_payload != 0 && wrong_code != 0 && lmx_arena_refs_open_owned(@ slot_arena, wrong_payload, 3U) = 0, "a size_t-coded payload built")
    lmx_arena_ref_store(wrong_payload, 0U, wrong_code)
    lmx_arena_ref_store(wrong_payload, 1U, (cast: (@: void) out_arr))
    lmx_arena_ref_store(wrong_payload, 2U, (cast: (@: void) err_arr))
    lmx_arena_ref_store(short_letter, 1U, (cast: (@: void) wrong_payload))
    host_check(counts, lmx_root_exit_admit(@ slot_arena, model, short_letter, @ got) = c.LMX_ROOT_INVALID, "a payload whose first field is not an int is refused")
    host_check(counts, lmx_root_exit_admit(@ slot_arena, model, payload, @ got) = c.LMX_ROOT_INVALID, "a bare payload -- no sender, field 1 not a Structure -- is refused")
    lmx_arena_release(@ slot_arena)

    failures: counts[1]
    c.printf("lmx_root_host checks=%d failures=%d\n", counts[0], failures)
    c.fflush(0)
    free(counts)
    free(out_text)
    free(err_text)
return: failures
