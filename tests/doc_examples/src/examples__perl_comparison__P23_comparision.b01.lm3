Squares:
    int: limit 0
    Next:
        return: int
        next:
            throws: Stop
            @: owner parent(node)
            int: i 0
            while: i < owner\limit
                yield: i * i
                i += 1
            throw: Stop()



Example:
    int: limit
    return: @
    run:
        throws: copy(Squares\Next\next\throws) copy(FxSeqPush\append\throws) copy(FxRecordOperands\record\throws)
        @: source (merge(Squares; (int: limit limit)))
        @[]: out []
        while: 1
            int: value source\Next\next()
            FxSeqPush\append(out; (value record))
        catch: Stop()
            return: out
