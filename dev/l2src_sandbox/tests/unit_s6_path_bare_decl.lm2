# A path to a callable needs an explicit Frame to request a call. v and w receive
# successive tick results; Holder's field `fn: tick` refers to the unit's tick.
# Selecting tick runs nothing of Holder (`bump()` would count a run). v is 1, w 2, tick runs twice: exit 7;
# 81 if Holder ran, 82 a wrong count, 83 a wrong value.
int: hits 0
int: seen 0
fn: tick () int
    node\hits: node\hits + 1
    return: node\hits
end: tick
fn: bump () int
    node\seen: node\seen + 1
    return: 0
end: bump
fn: count () int
    return: node\hits
end: count
fn: saw () int
    return: node\seen
end: saw
Holder:
    fn: tick
    bump()
end: Holder
fn: run () int
    int: v Holder\tick()
    int: w Holder\tick()
    if: saw() != 0
        return: 81
    if: count() != 2
        return: 82
    if: v != 1 || w != 2
        return: 83
    return: 7
end: run
sendMessage: exit(exit_code: run(); stdout: ""; stderr: "")
return
