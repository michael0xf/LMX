+# A lexical traversal borrows an operand's grammar,not a new reading of its
+# source range. A bare binding is a whole-value use; a path's root is not.
+# Taking an address marks existing storage without reading its stored value.
+fn: l2_scan_value_span (@: L2ValueSpan span; int: mi; @: int seen; int: address) int
+    int: k 0
+    int: child_address address
+    int: oi
+    if: span = 0 || span\node = 0
+        return: 1
+    if: span\grammar = 0
+        if: span\count = 1 && span\node\kind = c.LM_P0_NODE_ATOM && span\node\as != 0 && l2_rw_prec(span\node\as\atom) != 0
+            return: 0
+        return: l2_error_fatal(l2_src, span\node, "internal: a lexical operand has no prepared grammar")
+    if: span\prepared != 0
+        if: span\prepared\n > 0
+            return: l2_scan_path(span\node, span\prepared, mi, seen)
+        if: address != 0 && span\node\kind = c.LM_P0_NODE_ATOM && span\node\as != 0
+            oi: l2_own_visible(mi, span\node\as\atom)
+            if: oi >= 0 && l2_own_unit_seen(oi, mi) != 0
+                if: l2_hr_on != 0
+                    return: 0
+                if: l2_m_uses[l2_own_off(mi, oi)] = 0
+                    l2_m_own[mi]: l2_m_own[mi] + 1
+                l2_m_uses[l2_own_off(mi, oi)]: 1
+                return: 0
+            ---
+        ---
+        return: l2_scan_node(span\node, mi, seen)
+    if: span\operand != 0
