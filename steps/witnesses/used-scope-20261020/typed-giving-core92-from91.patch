+            i: i + 1U
+            if: source_layout = 0 || required_layout = 0 || item\source_layout != source_layout || item\required_layout != required_layout
+                continue
+            pair.map: item\correspondence.map
+            pair.frame: item\correspondence.frame
+            pair.at: item\correspondence.at
+            pair.n: item\correspondence.n
+            pair.holes: item\correspondence.holes
+        else:
+            i: resolver\template_count + 1U
+        ---
+        \applied: 1
+        answer: lmx_implements_view_valid(arena, @ pair, width)
+        if: answer != c.LMX_IMPLEMENTS_YES
+            break
+        if: found != 0 && lmx_implements_same_map(arena, bridge, @ pair, width) = 0
+            answer: c.LMX_IMPLEMENTS_UNKNOWN
+            break
+        memcpy((cast: (@: void) bridge), (cast: (@: void) (@ pair)), c.sizeof(c.LmxImplEntry))
+        answer: lmx_implements_project_view(arena, value, req, @ normalized, @ pair, @ candidate)
+        if: answer != c.LMX_IMPLEMENTS_YES
+            break
