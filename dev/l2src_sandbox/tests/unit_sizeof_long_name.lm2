# FIXED-BLOCKS-AUDIT: sizeof's operand is a declared name of any length -- a scalar, a reference and an
# array local whose names are 300 bytes each.  A name over 200 bytes was "unresolved name": the lowering
# took 200 bytes of a name at most and the caller then refused the operand.  Success is 7; otherwise 64 plus
# a bit per size: 1 the int, 2 the reference, 4 the array.
fn: check () int
    int: bad 0
    int:  5
    @: int  @ 
    []: int  3
    if: sizeof() != sizeof(int)
        bad: bad + 1
    if: sizeof() != sizeof(@: void)
        bad: bad + 2
    if: sizeof() != 3U * sizeof(int)
        bad: bad + 4
    if: bad != 0
        return: 64 + bad
return: 7

sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
