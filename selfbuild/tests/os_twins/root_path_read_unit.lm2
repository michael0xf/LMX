# The unit twin of root_path_read_os.lm2: the root checks the unit method's return value (reading its published field is reverted). Entry 7.
fn: os_mix (int: a) int
    int: last 0
    last := a * 2
    return: last
end: os_mix
int: r os_mix(3)
send: exit(exit_code: r + 1; stdout: ""; stderr: "")
return
