---
    Observed:
        int: after 1
        int: x 4
    end: Observed
---
sub: main () (
    Other:
        Point:
            int: x 4
        end: Point
    end: Other
)
    @: shared (node [] 0)
    int: after 1
    :=: ((shared \ Observed) \ after) after
    :=: ((shared \ Observed) \ x) ((Other \ Point) \ x)
end: main
main:
