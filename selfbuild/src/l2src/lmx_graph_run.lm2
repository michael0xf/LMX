# The interpreter of the clean graph (docs/kernel-implementation.ru.md §6; slice 309, the vertical slice of §11 item 0):
# it walks the statements of a root in field order and recognizes everything by addresses -- a word by the canonical
# address of its spelling (the words of the language are the state's, §6.2), a place by the region of the address a slot
# holds (§2.2), a name by the address -> name table of the arena (§5.1). Written names resolve against this traversal's
# activation and current lexical slots (§3.5, §5.2); no binding survives the traversal. Each expression operation is an
# ordinary Lmx of operand/operator/operand, or prefix/operand, nested by construction (§3.3). This consumer performs no
# precedence parsing and keeps no prepared expression representation. A write of a place is the
# kernel's one write (lmx_graph_assign_int): every assignment writes into the same cell, through the address-typed
# internal indirection when present. That indirection does not make the language place a reference.
#
# Statements of this slice: `name: expression` (a write of the int place named name) and `int: name expression` (a
# declaration with a computed initializer: the published value replaces the statement in its slot, §3.4). A Frame is
# the Lmx of its arguments named by its head (§3.3; the author 2026-11-09): its head is the name of that Lmx, its
# arguments are its fields from the first. A declaration of fn or sub stays in the graph as written; each traversal
# applies the receiver and creates, in its own initially clean namespace, the Structure named by the declaration's name
# argument with the parts args, return, data, code (lmx_graph_space_open, lmx_graph_fn_make).
# An omitted initializer promises no initial value; the kernel does not maintain a changing initialized state.
#
# A machine module (L2 section 20); the build writes its header, lmx_graph_run.h.lm1, from the exports named in
# bld_kernel_l2 (tools/build.lm2).
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_graph.h.lm1"
predef: "l2src/lmx_call.h.lm1"
predef: "l2src/lmx_graph_copy_owned.h.lm1"
predef: "l2src/lmx_pool.h.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l2src/lmx_value_owned.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdlib.h>"
include: "<stdio.h>"
include: "<string.h>"

# The working cache belongs to one active traversal. Its rows refer to real own cells; numbers and dirty marks
# disappear on return. No cache or binding is stored in the Lmx graph.
fn: lmx_graph_work_row (@: frame c.LmxGraphFrame; @: name char) @: c.LmxGraphWork
    size_t: i 0U
    @: rows c.LmxGraphWork 0
    @: row c.LmxGraphWork 0
    if: frame = 0 || name = 0
        return: 0
    rows := frame\rows
    while: i < frame\count
        row := rows + i
        if: row\name = name
            return: row
        i := i + 1U
    ---
    return: 0
end: lmx_graph_work_row

fn: lmx_graph_work_load (@: g c.LmxGraph; @: row c.LmxGraphWork) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    if: row = 0 || state = 0
        return: 3
    if: row\slot = (cast: (size_t) -1)
        return: 0
    if: (row\loaded & 1) = 0
        # A computed declaration of data not executed yet (lmx_graph_data_cell): its place has no value, and the read
        # is refused, as that of a formal without an input (the author 2026-11-11, R12; plan M11 5a, B6) -- 5.
        if: c.lmx_graph_kind(g, row\cell) = 4 && c.lmx_graph_name_of(g, row\cell) = state\w_int
            return: 5
        if: c.lmx_graph_value_int(g, row\cell, @ row\number) != 0
            return: 4
        row\loaded := row\loaded | 1
    return: 0
end: lmx_graph_work_load

# The field of data named name for a call: its record in the registry of data (lmx_graph_data_find), read whole -- a
# place of that name, else its first field of that name (a named Structure); a Frame of a statement named by its head
# -- `x: x + 2` beside `int: x 4` -- is no second field. The count of its slots when none is.
fn: lmx_graph_data_slot (@: g c.LmxGraph; @: data c.Lmx; @: name char) size_t
    size_t: at 0U
    lmx_graph_data_find(g, data, name, 1, 0U, @ at)
    return: at
end: lmx_graph_data_slot

# The cell a launch reads for the place at slot of data (the author 2026-11-11, R12; plan M11 5a): the int cell of the
# place; for a computed declaration of data not executed yet (`int: name expression`, still in its slot -- data given
# to a launch is read as it is, its computed declarations are code) the declaration itself, the place without a value
# that a read refuses (lmx_graph_work_load) and a write gives a value, published into the slot at the end of the launch
# (lmx_graph_work_flush); 0 when the slot holds neither.
fn: lmx_graph_data_cell (@: g c.LmxGraph; @: data c.Lmx; size_t: slot) @: void
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: value void 0
    @: cell void 0
    if: state = 0 || slot >= c.lmx_graph_count(data)
        return: 0
    cell := c.lmx_graph_place_cell(g, data, slot)
    if: cell != 0
        return: cell
    value := c.lmx_graph_get(data, slot)
    if: c.lmx_graph_kind(g, value) = 4 && c.lmx_graph_name_of(g, value) = state\w_int && c.lmx_graph_count((cast: (@: c.Lmx) value)) >= 2U
        return: value
    return: 0
end: lmx_graph_data_cell

# Is a place named name in data after slot (two fields of one name are inadmissible as data)? 1 or 0.
fn: lmx_graph_data_twice (@: g c.LmxGraph; @: data c.Lmx; size_t: slot; @: name char) int
    size_t: i slot + 1U
    int: kind 0
    while: i < c.lmx_graph_count(data)
        kind := c.lmx_graph_kind(g, c.lmx_graph_get(data, i))
        if: (kind = 1 || kind = 3 || kind = 5 || kind = 6) && c.lmx_graph_slot_name(g, data, i) = name
            return: 1
        i := i + 1U
    ---
    return: 0
end: lmx_graph_data_twice

# Capture a directly consumed free input at entry. An int gets its own argument cell; a Structure/reference keeps
# its language reference value. The row lives only in this activation and does not become a field of data.
fn: lmx_graph_work_capture (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: name char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: args c.Lmx 0
    @: value void 0
    @: head char 0
    @: rows c.LmxGraphWork 0
    @: row c.LmxGraphWork 0
    size_t: capacity 0U
    int: kind 0
    int: number 0
    int: status 0
    size_t: slot 0U
    # The formals are those of this launch (frame\args): a callable's own args part, or the Structure a receiver gave.
    args := (cast: (@: c.Lmx) frame\args)
    if: state = 0 || name = 0 || (args != 0 && c.lmx_graph_formal(g, args, name) < c.lmx_graph_count(args))
        return: 0
    row := lmx_graph_work_row(frame, name)
    if: row != 0
        if: row\cell = 0 && frame\own = 0
            return: 3
        return: 0
    # A launch over data it was given admits only directly used data fields, independent of their physical order: a name
    # the data has is its place, whatever formals the launch was given -- for an ordinary Structure and for a callable
    # launched over data it was given alike (plan M11 5a, the executor's reading B4: the code uses the names of data
    # before a free input). A callable over its own data keeps the places of that data. A Structure of the data -- a
    # named Lmx that declares no place -- gets no row: the code finds it by reference in the registry of the launch's
    # data (lmx_graph_resolve; plan M11 5b), for a callable over its own data too.
    slot := lmx_graph_data_slot(g, (cast: (@: c.Lmx) frame\data), name)
    if: slot < c.lmx_graph_count(frame\data)
        value := c.lmx_graph_get(frame\data, slot)
        head := c.lmx_graph_name_of(g, value)
        if: c.lmx_graph_kind(g, value) = 4 && head != 0 && head != state\w_int && head != state\w_at
            return: 0
        if: frame\own = 0
            return: lmx_graph_work_require(g, frame, name)
    ---
    value := lmx_graph_resolve(g, (cast: (@: c.Lmx) frame\code), name)
    if: value = 0
        return: 3
    kind := c.lmx_graph_kind(g, value)
    if: kind = 1 || kind = 3
        status := lmx_graph_named_int(g, (cast: (@: c.Lmx) frame\code), name, @ number)
        if: status != 0
            return: status
        value := c.lmx_graph_int(g, number)
        if: value = 0
            return: 4
        ---
    ---
    if: frame\count = frame\capacity
        capacity := (cast: (size_t) frame\capacity) * 2U + 8U
        rows := (cast: (@: c.LmxGraphWork) c.realloc((cast: (@: void) frame\rows), capacity * c.sizeof(c.LmxGraphWork)))
        if: rows = 0
            return: 4
        frame\rows := rows
        frame\capacity := capacity
    ---
    rows := frame\rows
    row := rows + (cast: (size_t) frame\count)
    c.memset((cast: (@: void) row), 0, c.sizeof(c.LmxGraphWork))
    row\name := name
    row\cell := value
    row\slot := (cast: (size_t) -1)
    frame\count := frame\count + 1U
    return: 0
end: lmx_graph_work_capture

# Bind a required int place to its actual data slot, by canonical name. No data is allocated or extended.
# Duplicate bare names are inadmissible. This map belongs only to the current activation.
fn: lmx_graph_work_require (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: name char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: rows c.LmxGraphWork frame\rows
    @: row c.LmxGraphWork lmx_graph_work_row(frame, name)
    size_t: slot lmx_graph_data_slot(g, (cast: (@: c.Lmx) frame\data), name)
    size_t: capacity 0U
    @: cell void 0
    if: name = 0 || state = 0
        return: 3
    if: row != 0
        if: row\slot = (cast: (size_t) -1)
            return: 3
        if: row\cell != 0 || frame\own != 0
            return: 0
        return: 3
    if: slot >= c.lmx_graph_count(frame\data) || lmx_graph_data_twice(g, (cast: (@: c.Lmx) frame\data), slot, name) != 0
        return: 3
    # The int place of data, or its computed declaration not executed yet (lmx_graph_data_cell). A reference declaration
    # `@: name T` in data is not executed by this slice (5), as in the model of a launch.
    cell := lmx_graph_data_cell(g, (cast: (@: c.Lmx) frame\data), slot)
    if: cell = 0 && c.lmx_graph_name_of(g, c.lmx_graph_get(frame\data, slot)) = state\w_at
        return: 5
    if: cell = 0
        return: 4
    if: frame\count = frame\capacity
        capacity := (cast: (size_t) frame\capacity) * 2U + 8U
        rows := (cast: (@: c.LmxGraphWork) c.realloc((cast: (@: void) rows), capacity * c.sizeof(c.LmxGraphWork)))
        if: rows = 0
            return: 4
        frame\rows := rows
        frame\capacity := capacity
    ---
    row := rows + (cast: (size_t) frame\count)
    c.memset((cast: (@: void) row), 0, c.sizeof(c.LmxGraphWork))
    row\name := name
    row\slot := slot
    row\cell := cell
    frame\count := frame\count + 1U
    return: 0
end: lmx_graph_work_require

# Does a Frame of the code a frame scans launch -- the receiver call or fncall, or a record whose head is an ordinary
# Structure, directly or through a reference place (lmx_graph_eval_launch_record)? Its operands are then operands of a
# launch (lmx_graph_launch_operand), and its named actuals select formals of the launch. 1 or 0.
fn: lmx_graph_scan_launch (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: lead char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: target void 0
    if: state = 0 || lead = 0
        return: 0
    if: lead = state\w_call || lead = state\w_fncall
        return: 1
    if: lmx_graph_language_word(state, lead) != 0
        return: 0
    target := c.lmx_graph_target(g, lmx_graph_resolve(g, (cast: (@: c.Lmx) frame\code), lead))
    if: c.lmx_graph_kind(g, target) = 4 && c.lmx_graph_method(g, (cast: (@: c.Lmx) target)) = 0
        return: 1
    return: 0
end: lmx_graph_scan_launch

# One body traversal captures free inputs and records needed own loads. After data, loading iterates only rows,
# never the body again. Nested methods are not scanned, and a selector is not an input; no transitive interface.
fn: lmx_graph_work_scan (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: body c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @@: queue c.Lmx 0
    size_t: count 0U
    size_t: cap 0U
    size_t: at 0U
    size_t: i 0U
    size_t: n 0U
    size_t: first 0U
    @: current c.Lmx 0
    @: raw void 0
    @: word char 0
    @: op char 0
    @: lead char 0
    @: row c.LmxGraphWork 0
    int: framed 0
    int: callable 0
    int: status c.lmx_graph_scan_add(@ queue, @ count, @ cap, body)
    while: at < count && status = 0
        current := queue[at]
        at := at + 1U
        if: c.lmx_graph_method(g, current) != 0
            continue
        n := c.lmx_graph_count(current)
        lead := c.lmx_graph_name_of(g, (cast: (@: void) current))
        # A Frame is its head and its arguments; the scanned body itself is its statements. Nested declarations and the
        # data part (data, its initializers run where they are written) are not scanned.
        framed := (cast: (int) (lead != 0 && current != body))
        if: framed != 0 && (lead = state\w_fn || lead = state\w_sub || lead = state\w_fm || lead = state\w_data)
            continue
        callable := 0
        if: framed != 0 && lmx_graph_language_word(state, lead) = 0
            callable := c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_target(g, lmx_graph_resolve(g, (cast: (@: c.Lmx) frame\code), lead))))
        first := 0U
        if: framed != 0
            word := lead
            op := 0
            if: n != 0U
                op := c.lmx_graph_word_text(g, c.lmx_graph_get(current, 0U))
            ---
        else:
            word := c.lmx_graph_word_text(g, c.lmx_graph_get(current, 0U))
            op := c.lmx_graph_word_text(g, c.lmx_graph_get(current, 1U))
            lead := word
        ---
        if: framed = 0 && n = 2U && word = state\w_at
            raw := c.lmx_graph_get(current, 1U)
            while: c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_count((cast: (@: c.Lmx) raw)) = 1U && c.lmx_graph_name_of(g, raw) = 0
                raw := c.lmx_graph_get((cast: (@: c.Lmx) raw), 0U)
            word := c.lmx_graph_word_text(g, raw)
            if: word != 0
                status := lmx_graph_work_capture(g, frame, word)
                continue
            ---
        ---
        i := 0U
        if: framed != 0 && word = state\w_int
            word := c.lmx_graph_word_text(g, c.lmx_graph_get(current, 0U))
            if: frame\own = 0
                status := lmx_graph_work_require(g, frame, word)
            else:
                status := lmx_graph_work_capture(g, frame, word)
            ---
            i := 1U
        else:
            # The head of a Frame names a place or a callable of this code: a free input, never a load by itself.
            if: framed != 0 && lmx_graph_language_word(state, word) = 0
                status := lmx_graph_work_capture(g, frame, word)
            ---
        ---
        while: i < n && status = 0
            if: framed = 0 && n = 3U && op = state\w_deref && i = 2U
                i := i + 1U
                continue
            raw := c.lmx_graph_get(current, i)
            # A named actual selects the callee's formal, or a formal of a launch (lmx_graph_scan_launch), never a free
            # input of this caller.
            if: framed != 0 && c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_word_text(g, c.lmx_graph_get((cast: (@: c.Lmx) raw), 0U)) = state\w_assign
                if: callable != 0
                    if: c.lmx_graph_count((cast: (@: c.Lmx) raw)) != 3U
                        status := 5
                        break
                    raw := c.lmx_graph_get((cast: (@: c.Lmx) raw), 2U)
                else:
                    if: c.lmx_graph_count((cast: (@: c.Lmx) raw)) = 3U && lmx_graph_scan_launch(g, frame, lead) != 0
                        raw := c.lmx_graph_get((cast: (@: c.Lmx) raw), 2U)
                    ---
                ---
            ---
            # The written fields of an anonymous Structure operand of merge define their names; only their values are
            # read (lmx_graph_merge_literal, lmx_graph_work_scan_literal).
            if: framed != 0 && lead = state\w_merge && lmx_graph_merge_literal(g, (cast: (@: c.Lmx) frame\code), raw) != 0
                status := lmx_graph_work_scan_literal(g, frame, (cast: (@: c.Lmx) raw), @ queue, @ count, @ cap)
                i := i + 1U
                continue
            ---
            # A callable receives this written Structure as data. Its fields
            # are not declarations or free inputs of the caller's frame.
            if: callable != 0 && c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && lmx_graph_group_expression(g, (cast: (@: c.Lmx) frame\code), raw) = 0
                i := i + 1U
                continue
            # Such an operand of a launch is data as written (lmx_graph_launch_operand; R21, item 4): this code reads
            # nothing of it.
            if: framed != 0 && lmx_graph_merge_literal(g, (cast: (@: c.Lmx) frame\code), raw) != 0 && lmx_graph_scan_launch(g, frame, lead) != 0
                i := i + 1U
                continue
            ---
            # A place of the body or of a control body in it (`int: absent 8` under if) is a declaration of this code:
            # ordinary code requires it of its data, a callable has it in its data.
            if: framed = 0 && (c.lmx_graph_kind(g, raw) = 1 || c.lmx_graph_kind(g, raw) = 3)
                word := c.lmx_graph_slot_name(g, current, i)
                if: word != 0
                    if: frame\own = 0
                        status := lmx_graph_work_require(g, frame, word)
                    else:
                        status := lmx_graph_work_capture(g, frame, word)
                    ---
                    i := i + 1U
                    continue
                ---
            ---
            if: c.lmx_graph_kind(g, raw) = 4
                status := c.lmx_graph_scan_add(@ queue, @ count, @ cap, (cast: (@: c.Lmx) raw))
            else:
                word := c.lmx_graph_word_text(g, raw)
                if: word != 0 && lmx_graph_language_word(state, word) = 0
                    status := lmx_graph_work_capture(g, frame, word)
                    if: status = 0
                        row := lmx_graph_work_row(frame, word)
                        # Every word argument of a Frame is read; in an expression the left operand of `:=` is written,
                        # and the first field is read when it is an operand.
                        if: row != 0 && row\slot != (cast: (size_t) -1) && (framed != 0 || ((i != 1U || c.lmx_graph_word_text(g, c.lmx_graph_get(current, 0U)) != state\w_assign) && (i != 0U || n = 1U || op = state\w_plus || op = state\w_minus || op = state\w_star || op = state\w_slash || op = state\w_percent || op = state\w_deref || op = state\w_eq || op = state\w_ne || op = state\w_lt || op = state\w_le || op = state\w_gt || op = state\w_ge || op = state\w_and || op = state\w_or)))
                            row\loaded := row\loaded | 2
                        ---
                    ---
                ---
            ---
            i := i + 1U
        ---
    ---
    c.free((cast: (@: void) queue))
    return: status
end: lmx_graph_work_scan

fn: lmx_graph_work_flush (@: g c.LmxGraph) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: frame c.LmxGraphFrame 0
    @: rows c.LmxGraphWork 0
    @: row c.LmxGraphWork 0
    @: cell void 0
    size_t: i 0U
    if: active = 0 || active\frame = 0
        return: 0
    frame := (cast: (@: c.LmxGraphFrame) active\frame)
    rows := frame\rows
    while: i < frame\count
        row := rows + i
        if: row\dirty != 0 && row\slot != (cast: (size_t) -1)
            # A computed declaration of data that got its value in this launch -- its line ran, or a write gave it --
            # is published into its slot: from then on the slot holds the place (R12; plan M11 5a).
            if: c.lmx_graph_kind(g, row\cell) = 4
                cell := c.lmx_graph_int(g, row\number)
                if: cell = 0 || c.lmx_graph_publish(g, frame\data, row\slot, cell) != 0
                    return: 4
                row\cell := cell
            else:
                if: c.lmx_graph_assign_int(g, frame\code, frame\data, row\slot, row\number) != 0
                    return: 4
            ---
            row\dirty := 0
        ---
        i := i + 1U
    ---
    return: 0
end: lmx_graph_work_flush

fn: lmx_graph_work_finish (@: g c.LmxGraph; @: frame c.LmxGraphFrame; int: status) int
    int: published lmx_graph_work_flush(g)
    if: frame\activation != 0
        frame\activation\frame := frame\prior
    c.free((cast: (@: void) frame\rows))
    frame\rows := 0
    frame\count := 0U
    if: published != 0
        return: published
    return: status
end: lmx_graph_work_finish

# Open the work frame of one launch over its parts (the book, call-receivers): the Structure of its formals (0 for
# none), the data it runs over, the callable's own data model or 0 for ordinary code,
# its body and whether it returns a result. The same rows
# cache and publish every launch: the call of a callable, an explicit code/data pair, a composition a receiver gave.
fn: lmx_graph_work_open_parts (@: g c.LmxGraph; @: code c.Lmx; @: args c.Lmx; @: data c.Lmx; @: model c.Lmx; @: body c.Lmx; int: result; @: frame c.LmxGraphFrame) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: declaration c.Lmx 0
    @: head char 0
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: rows c.LmxGraphWork 0
    @: row c.LmxGraphWork 0
    size_t: i 0U
    size_t: slot 0U
    int: status 0
    if: frame = 0 || active = 0 || active\code != code
        return: 5
    c.memset((cast: (@: void) frame), 0, c.sizeof(c.LmxGraphFrame))
    frame\code := code
    frame\data := data
    frame\args := args
    frame\body := body
    frame\result := result
    # A callable over its own data: that data was completed when the graph was built, so the code's places are in it by
    # construction. Any other data is read as it is and must have every place the code uses: a literal value is data and
    # stands in its place from the start; a computed declaration is code, executed at its line in the code, so a launch
    # finds its place without a value until then (the author 2026-11-11, R12; plan M11 5a -- lmx_graph_data_cell).
    frame\own := (cast: (int) (model != 0 && data = model && c.lmx_graph_method(g, code) != 0))
    frame\count := 0U
    frame\capacity := c.lmx_graph_count(model) + 8U
    frame\rows := (cast: (@: c.LmxGraphWork) c.calloc(frame\capacity, c.sizeof(c.LmxGraphWork)))
    if: frame\rows = 0
        return: 4
    frame\activation := active
    frame\prior := active\frame
    active\frame := frame
    rows := frame\rows
    while: i < c.lmx_graph_count(model) && status = 0
        # A Structure of the model -- a named Lmx that declares no place -- gets no row: the code finds it by reference in
        # the registry of the launch's data (lmx_graph_resolve; plan M11 5b). The rows are the places of the data.
        head := c.lmx_graph_name_of(g, c.lmx_graph_get(model, i))
        if: c.lmx_graph_kind(g, c.lmx_graph_get(model, i)) = 4 && head != 0 && head != state\w_int && head != state\w_at
            i := i + 1U
            continue
        row := rows + frame\count
        frame\count := frame\count + 1U
        row\name := c.lmx_graph_slot_name(g, model, i)
        # A computed declaration `int: name expression` (an Lmx named int, §3.3) is the place name before its publication;
        # a reference declaration `@: name T` in a data is not executed by this slice (5), as before.
        if: row\name = state\w_int && c.lmx_graph_kind(g, c.lmx_graph_get(model, i)) = 4
            declaration := (cast: (@: c.Lmx) c.lmx_graph_get(model, i))
            row\name := c.lmx_graph_word_text(g, c.lmx_graph_get(declaration, 0U))
        ---
        if: row\name = state\w_at && c.lmx_graph_kind(g, c.lmx_graph_get(model, i)) = 4
            status := 5
        slot := i
        if: data != model
            slot := lmx_graph_data_slot(g, data, (cast: (@: char) row\name))
            if: slot < c.lmx_graph_count(data) && lmx_graph_data_twice(g, data, slot, (cast: (@: char) row\name)) != 0
                status := 3
        ---
        row\slot := slot
        row\cell := lmx_graph_data_cell(g, data, slot)
        if: row\name = 0
            status := 5
        i := i + 1U
    ---
    if: status = 0
        status := lmx_graph_work_scan(g, frame, body)
    # Only the callable's own data executes its retained initializers here, by its contract; other data is read as it
    # is, and no call ever adds a field to it.
    if: status = 0 && frame\own != 0
        status := lmx_graph_call(g, data)
    rows := frame\rows
    i := 0U
    while: i < frame\count && status = 0
        row := rows + i
        if: row\slot != (cast: (size_t) -1)
            row\cell := lmx_graph_data_cell(g, data, row\slot)
            row\loaded := row\loaded & 2
            # A place without a value yet (a computed declaration not executed) is not loaded: its line or a write
            # gives it a value, and a read before that is refused (lmx_graph_work_load).
            if: row\loaded != 0 && c.lmx_graph_kind(g, row\cell) != 4
                status := lmx_graph_work_load(g, row)
            ---
        ---
        i := i + 1U
    ---
    if: status != 0
        return: lmx_graph_work_finish(g, frame, status)
    return: 0
end: lmx_graph_work_open_parts

# The launch of code over data by the parts code itself carries: a callable has its args, data, code and result
# description; an ordinary Structure is its own body, has no formals or result,
# and requires its places through the same body scan and data map. A child named
# data is an ordinary written field, never an implicit model. Native entries and
# the interpreter open their frame here; a receiver given the parts uses the same
# lmx_graph_work_open_parts.
fn: lmx_graph_work_open_data (@: g c.LmxGraph; @: code c.Lmx; @: data c.Lmx; @: frame c.LmxGraphFrame) int
    if: c.lmx_graph_method(g, code) != 0
        return: lmx_graph_work_open_parts(g, code, c.lmx_graph_method_args(g, code), data, c.lmx_graph_method_data(g, code), c.lmx_graph_method_code(g, code), c.lmx_graph_has_result(g, code), frame)
return: lmx_graph_work_open_parts(g, code, 0, data, 0, code, 0, frame)

fn: lmx_graph_work_open (@: g c.LmxGraph; @: code c.Lmx; @: frame c.LmxGraphFrame) int
    return: lmx_graph_work_open_data(g, code, c.lmx_graph_method_data(g, code), frame)
end: lmx_graph_work_open

# The Structure of the formals of an activation: that of its launch when it has a work frame -- a callable's args part
# or the Structure a receiver gave (lmx_graph_work_open_parts); a callable running without a frame answers by its own
# args part. 0 for an activation without formals.
fn: lmx_graph_activation_args (@: g c.LmxGraph; @: active c.LmxActivation) @: c.Lmx
    @: frame c.LmxGraphFrame 0
    if: active = 0
        return: 0
    if: active\frame != 0
        frame := (cast: (@: c.LmxGraphFrame) active\frame)
        return: (cast: (@: c.Lmx) frame\args)
    if: c.lmx_graph_method(g, active\code) != 0
        return: c.lmx_graph_method_args(g, active\code)
    return: 0
end: lmx_graph_activation_args

# A bare int name reads the current working value before caller bindings and lexical graph data. Explicit paths
# still read published cells. Argument operands snapshot this value before the caller publishes at the call boundary.
fn: lmx_graph_named_int (@: g c.LmxGraph; @: scope c.Lmx; @: name char; @: out int) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: args c.Lmx 0
    @: row c.LmxGraphWork 0
    @: value void 0
    size_t: slot 0U
    int: status 0
    while: active != 0
        if: active\frame != 0
            row := lmx_graph_work_row((cast: (@: c.LmxGraphFrame) active\frame), name)
            if: row != 0
                if: row\slot = (cast: (size_t) -1)
                    return: c.lmx_graph_value_int(g, row\cell, out)
                status := lmx_graph_work_load(g, row)
                if: status = 0
                    out[0] := row\number
                return: status
            ---
        ---
        args := lmx_graph_activation_args(g, active)
        if: args != 0
            slot := c.lmx_graph_formal(g, args, name)
            if: slot < active\width && active\refs != 0
                return: c.lmx_graph_value_int(g, active\refs[slot], out)
            ---
        ---
        active := active\parent
    ---
    # A name that answers nothing here -- none, or two or more records of it (lmx_graph_resolve) -- is unknown (3).
    value := lmx_graph_resolve(g, scope, name)
    if: value = 0
        return: 3
    return: c.lmx_graph_value_int(g, value, out)
end: lmx_graph_named_int

fn: lmx_graph_operand_name (@: g c.LmxGraph; @: scope c.Lmx; @: name char) @: void
    @: value void lmx_graph_resolve(g, scope, name)
    int: kind c.lmx_graph_kind(g, value)
    int: number 0
    if: kind = 1 || kind = 3
        if: lmx_graph_named_int(g, scope, name, @ number) != 0
            return: 0
        return: c.lmx_graph_int(g, number)
    return: value
end: lmx_graph_operand_name

# A typed declaration without a candidate verifies its already allocated local place; it reads no value and
# resets nothing. Own fields were collected by construction, formals were admitted by the call.
fn: lmx_graph_local_int (@: g c.LmxGraph; @: code c.Lmx; @: name char) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: row c.LmxGraphWork 0
    @: args c.Lmx 0
    size_t: slot 0U
    if: active = 0 || active\code != code
        return: 5
    if: active\frame != 0
        row := lmx_graph_work_row((cast: (@: c.LmxGraphFrame) active\frame), name)
        if: row != 0
            # An int place, or a computed declaration of data not executed yet (lmx_graph_data_cell): its line gives it
            # a value.
            return: (cast: (int) (c.lmx_graph_kind(g, row\cell) != 1 && c.lmx_graph_kind(g, row\cell) != 4))
        ---
    ---
    args := lmx_graph_activation_args(g, active)
    if: args = 0
        return: 3
    slot := c.lmx_graph_formal(g, args, name)
    if: active\refs != 0 && slot < active\width
        return: (cast: (int) (c.lmx_graph_kind(g, active\refs[slot]) != 1))
    return: 3
end: lmx_graph_local_int

# Check a known int destination without reading it or evaluating the RHS. No field is introduced here.
fn: lmx_graph_known_int (@: g c.LmxGraph; @: code c.Lmx; @: name char; int: mode) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: row c.LmxGraphWork 0
    @: args c.Lmx 0
    @: value void 0
    size_t: slot 0U
    if: name = 0
        return: 3
    if: mode != 0
        slot := lmx_graph_visible_slot(g, code, name)
        if: slot >= c.lmx_graph_count(code)
            # A known name that is no place of this block -- a function, a Structure -- refuses the write.
            if: lmx_graph_resolve(g, code, name) != 0
                return: 4
            return: 3
        value := c.lmx_graph_place_cell(g, code, slot)
    else:
        if: active = 0 || active\code != code
            return: 5
        if: active\frame != 0
            row := lmx_graph_work_row((cast: (@: c.LmxGraphFrame) active\frame), name)
        if: row != 0
            value := row\cell
        else:
            args := lmx_graph_activation_args(g, active)
            if: args != 0
                slot := c.lmx_graph_formal(g, args, name)
                if: active\refs != 0 && slot < active\width
                    value := active\refs[slot]
                ---
            ---
            if: value = 0
                return: 3
            ---
        ---
    ---
    # A row of a launch may stand for a computed declaration of data not executed yet (lmx_graph_data_cell): the place
    # exists, and a write gives it its value.
    if: c.lmx_graph_kind(g, value) != 1 && (row = 0 || c.lmx_graph_kind(g, value) != 4)
        return: 4
    return: 0
end: lmx_graph_known_int

# Explicit paths write the graph, even when they address this activation's data. They neither publish nor refresh
# bare working values (semantics, working-state); only a later bare write marks that working place dirty.
fn: lmx_graph_store_field (@: g c.LmxGraph; @: code c.Lmx; @: owner c.Lmx; size_t: slot; int: number) int
    if: c.lmx_graph_kind(g, (cast: (@: void) owner)) != 4
        return: 4
    return: c.lmx_graph_assign_int(g, code, owner, slot, number)
end: lmx_graph_store_field

# The field a written path `owner\field` names, for a write through it: the owner evaluated -- a Structure, or the
# target of a reference to it (the same instance) -- and the place its last step names, through an atom too
# (lmx_graph_step_place). 0 and the Structure holding the place and its slot in owner_out and slot_out; 2 for no path;
# 3 for no field of that name; 4 for an owner that is no Structure; the answer of the owner's evaluation.
fn: lmx_graph_path_field (@: g c.LmxGraph; @: code c.Lmx; @: left void; @@: owner_out c.Lmx; @: slot_out size_t) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: path c.Lmx (cast: (@: c.Lmx) left)
    @: value void 0
    size_t: slot 0U
    int: status 0
    if: state = 0 || c.lmx_graph_kind(g, left) != 4 || c.lmx_graph_count(path) != 3U || c.lmx_graph_word_text(g, c.lmx_graph_get(path, 1U)) != state\w_deref
        return: 2
    status := lmx_graph_eval_value(g, code, c.lmx_graph_get(path, 0U), @ value)
    if: status != 0
        return: status
    status := lmx_graph_step_place(g, value, c.lmx_graph_word_text(g, c.lmx_graph_get(path, 2U)), @ value, @ slot)
    if: status != 0
        return: status
    owner_out[0] := (cast: (@: c.Lmx) value)
    slot_out[0] := slot
    return: 0
end: lmx_graph_path_field

# A write through the index of a Structure, `base[index] := value` (the book, structure-index): the base and the index
# first, then the value -- an address, not a number --, then the kernel's admission and slot write
# (lmx_graph_index_write). 0; 4 or 7 as the kernel answers; the answer of an evaluation.
fn: lmx_graph_eval_index_write (@: g c.LmxGraph; @: code c.Lmx; @: left c.Lmx; @: operand void) int
    @: base void 0
    @: value void 0
    int: index 0
    int: status 0
    status := lmx_graph_eval_value(g, code, c.lmx_graph_get(left, 0U), @ base)
    if: status != 0
        return: status
    status := lmx_graph_eval_number(g, code, c.lmx_graph_get(left, 2U), @ index)
    if: status != 0
        return: status
    status := lmx_graph_eval_value(g, code, operand, @ value)
    if: status != 0
        return: status
    return: c.lmx_graph_index_write(g, code, base, index, value)
end: lmx_graph_eval_index_write

fn: lmx_graph_eval_assignment (@: g c.LmxGraph; @: code c.Lmx; @: statement c.Lmx; int: mode) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: left void c.lmx_graph_get(statement, 1U)
    @: name char c.lmx_graph_word_text(g, left)
    @: owner c.Lmx code
    size_t: slot 0U
    int: number 0
    int: status 0
    if: state = 0 || c.lmx_graph_count(statement) != 3U
        return: 2
    if: name = 0 && c.lmx_graph_index_form(g, left) != 0
        return: lmx_graph_eval_index_write(g, code, (cast: (@: c.Lmx) left), c.lmx_graph_get(statement, 2U))
    if: name != 0
        status := lmx_graph_known_int(g, code, name, mode)
        slot := lmx_graph_visible_slot(g, code, name)
    else:
        status := lmx_graph_path_field(g, code, left, @ owner, @ slot)
        if: status != 0
            return: status
        if: c.lmx_graph_place_cell(g, owner, slot) = 0
            return: 4
        ---
    ---
    if: status != 0
        return: status
    status := lmx_graph_eval_number(g, code, c.lmx_graph_get(statement, 2U), @ number)
    if: status != 0
        return: status
    if: name != 0 && mode = 0
        return: lmx_graph_store_name(g, code, name, number)
    return: lmx_graph_store_field(g, code, owner, slot, number)
end: lmx_graph_eval_assignment

# A statement written on a path head, `owner\field: tail` (the builder's [path, actuals], lm_graph_build_node): the
# head is resolved first, by the general rule of a Frame, and nothing is read from the form of the tail. A callable
# there would be applied (not yet through a path: 5). A place that is no Structure -- an int place, a reference place
# -- is declared by no such form and is not written by it (the book, forms-declare-or-call: `p\f: 1` is written
# `p\f := 1`): 8. A Structure there would be declared again through the path (the book, colon-declares:
# `Outer\Model:`), which this slice does not execute: 5. 3 or 4 as lmx_graph_path_field; the answer of the owner's
# evaluation.
fn: lmx_graph_eval_path_statement (@: g c.LmxGraph; @: code c.Lmx; @: statement c.Lmx) int
    @: owner c.Lmx 0
    @: held void 0
    size_t: slot 0U
    int: status 0
    status := lmx_graph_path_field(g, code, (cast: (@: void) c.lmx_graph_get(statement, 0U)), @ owner, @ slot)
    if: status != 0
        return: status
    held := c.lmx_graph_get(owner, slot)
    if: c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_target(g, held))) != 0
        return: 5
    if: c.lmx_graph_kind(g, held) != 4
        return: 8
    return: 5
end: lmx_graph_eval_path_statement

fn: lmx_graph_store_name (@: g c.LmxGraph; @: code c.Lmx; @: name char; int: number) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: row c.LmxGraphWork 0
    @: args c.Lmx 0
    size_t: slot 0U
    if: active = 0 || active\code != code
        return: 5
    if: active\frame != 0
        row := lmx_graph_work_row((cast: (@: c.LmxGraphFrame) active\frame), name)
        if: row != 0
            if: row\slot = (cast: (size_t) -1)
                if: c.lmx_graph_kind(g, row\cell) != 1
                    return: 4
                return: c.lmx_int_store_known(row\cell, number)
            row\number := number
            row\loaded := 1
            row\dirty := 1
            return: 0
        ---
    ---
    args := lmx_graph_activation_args(g, active)
    if: args = 0
        return: 3
    slot := c.lmx_graph_formal(g, args, name)
    if: active\refs != 0 && slot < active\width && c.lmx_graph_kind(g, active\refs[slot]) = 1
        return: c.lmx_int_store_known(active\refs[slot], number)
    # An unbound name is not created by assignment; never write an outer lexical source by a bare assignment.
    return: 3
end: lmx_graph_store_name

# ---- The registry of data and the path step (plan M11 5a; the book, fields, colon-declares, declaration-visibility) ----

# The registry of data (the author 2026-11-11: data is read whole, a repeated declaration is one more occurrence): the
# records of the root level of data that declare name, read whole and both ways each time it is consulted -- no table
# is kept. A place answers by the name of its cell (an int place, a place without a value, a reference place, a named
# word); a declaration Frame of a receiver of a place (`int: name expression`, `@: name ...`) by its declared name; any
# other named Lmx by its head -- a Structure and, with mode 0 (a path), also a written call and a receiver of control
# (`data\if`, the author 2026-11-11). With mode 1 (the reading of a bare name) a Frame whose head is a word of the
# language or names a callable answering in data's block is a statement and declares nothing. A named Lmx beside a
# place of its name declares nothing either: it is a statement on that place -- a call through a reference to a
# callable, or the refused form (the book, forms-declare-or-call), as `x: x + 2` beside `int: x 4`. An assignment, an
# unnamed Structure and an atom declare nothing. The number of the records; the slot of the record n (from 0) in
# at_out, or the count of the slots of data when there is no such record.
fn: lmx_graph_data_find (@: g c.LmxGraph; @: data c.Lmx; @: name char; int: mode; size_t: n; @: at_out size_t) size_t
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: value void 0
    @: head char 0
    @: answer void 0
    size_t: count 0U
    size_t: found 0U
    size_t: places 0U
    size_t: place_at 0U
    size_t: i 0U
    int: kind 0
    int: place 0
    if: at_out != 0
        at_out[0] := 0U
    if: g = 0 || state = 0 || name = 0 || at_out = 0 || c.lmx_graph_kind(g, (cast: (@: void) data)) != 4
        return: 0U
    count := c.lmx_graph_count(data)
    at_out[0] := count
    place_at := count
    while: i < count
        value := c.lmx_graph_get(data, i)
        kind := c.lmx_graph_kind(g, value)
        head := 0
        place := 0
        if: kind = 1 || kind = 3 || kind = 5 || kind = 6 || (kind = 2 && c.lmx_graph_name_of(g, value) != 0)
            head := c.lmx_graph_slot_name(g, data, i)
            place := 1
        else:
            if: kind = 4
                head := c.lmx_graph_name_of(g, value)
                if: head != 0 && (head = state\w_int || head = state\w_at)
                    head := 0
                    place := 1
                    if: c.lmx_graph_count((cast: (@: c.Lmx) value)) != 0U
                        head := c.lmx_graph_word_text(g, c.lmx_graph_get((cast: (@: c.Lmx) value), 0U))
                    ---
                else:
                    if: head != 0 && mode != 0
                        if: lmx_graph_language_word(state, head) != 0 || c.lmx_graph_language_receiver(head) != 0
                            head := 0
                        else:
                            answer := c.lmx_graph_space_find(data, head)
                            if: answer != 0 && c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_target(g, answer))) != 0
                                head := 0
                            ---
                        ---
                    ---
                ---
            ---
        ---
        if: head = name && place != 0
            if: places = n
                place_at := i
            ---
            places := places + 1U
        ---
        if: head = name && place = 0
            if: found = n
                at_out[0] := i
            ---
            found := found + 1U
        ---
        i := i + 1U
    ---
    # Beside a place of the name, the named Lmx of that name are statements on it.
    if: places != 0U
        at_out[0] := place_at
        return: places
    return: found
end: lmx_graph_data_find

# A step word `[N]name` (the book, fields: the indexed path of an occurrence, `s\[N]field`): 1 with N in index_out and
# the canonical spelling of name in name_out; 0 for any other word.
fn: lmx_graph_occurrence_word (@: word char; @: index_out size_t; @@: name_out char) int
    size_t: text_size 0U
    size_t: i 1U
    size_t: index 0U
    if: word = 0 || word[0] != 91
        return: 0
    text_size := c.strlen(word)
    while: i < text_size && word[i] >= 48 && word[i] <= 57
        index := index * 10U + (cast: (size_t) (word[i] - 48))
        i := i + 1U
    ---
    if: i = 1U || i + 1U >= text_size || word[i] != 93
        return: 0
    name_out[0] := c.lmx_graph_intern((cast: (const: @: char) (word + i + 1U)), text_size - i - 1U)
    if: name_out[0] = 0
        return: 0
    index_out[0] := index
    return: 1
end: lmx_graph_occurrence_word

# The slot of owner the step `\word` of a path names: `[N]name` -- the record N of name in the registry of owner
# (lmx_graph_data_find); a bare name -- its only record, two or more being ambiguous (no first record is chosen, the
# book, fields); without a record of that name -- the atom of owner written with that word, its own field
# (`Struct1: Struct2`, the author 2026-11-11). The count of owner's slots for no such field or an ambiguous one.
fn: lmx_graph_step_index (@: g c.LmxGraph; @: owner c.Lmx; @: word char) size_t
    @: name char word
    @: field void 0
    size_t: index 0U
    size_t: at 0U
    size_t: found 0U
    size_t: count 0U
    size_t: i 0U
    if: g = 0 || word = 0 || c.lmx_graph_kind(g, (cast: (@: void) owner)) != 4
        return: (cast: (size_t) -1)
    count := c.lmx_graph_count(owner)
    if: lmx_graph_occurrence_word(word, @ index, @ name) != 0
        found := lmx_graph_data_find(g, owner, name, 0, index, @ at)
        if: index < found
            return: at
        return: count
    found := lmx_graph_data_find(g, owner, name, 0, 0U, @ at)
    if: found = 1U
        return: at
    if: found > 1U
        return: count
    at := count
    while: i < count
        field := c.lmx_graph_get(owner, i)
        if: c.lmx_graph_kind(g, field) = 2 && c.lmx_graph_name_of(g, field) = 0 && c.lmx_graph_word_text(g, field) = name
            if: at < count
                return: count
            at := i
        ---
        i := i + 1U
    ---
    return: at
end: lmx_graph_step_index

# The entity an atom of holder refers to, found when a path is read through it (the author 2026-11-11,
# LMX_blog/2026-11-11.md#known-name-not-expanded; the executor's readings P1, B3): its word is looked up lexically from
# the atom's place outwards, never through an activation -- the records of holder, whole, then the records of every
# enclosing level, whole, up to the root (lmx_graph_data_find), a callable the receivers fn and sub created answering in
# a level's block (lmx_graph_space_find), and the data part of a callable. The atom itself is no record, so an atom
# naming its own holder finds the holder at the enclosing level. The entity, with the level holding its record and the
# record's slot in owner_out and slot_out (0 for a callable the namespace answers); 0 for none or for a level with two
# or more records of the word.
fn: lmx_graph_atom_target (@: g c.LmxGraph; @: holder c.Lmx; @: word char; @@: owner_out c.Lmx; @: slot_out size_t) @: void
    @: current c.Lmx holder
    @: part c.Lmx 0
    @: value void 0
    size_t: at 0U
    size_t: found 0U
    owner_out[0] := 0
    slot_out[0] := 0U
    while: word != 0 && c.lmx_graph_kind(g, (cast: (@: void) current)) = 4
        found := lmx_graph_data_find(g, current, word, 1, 0U, @ at)
        if: found = 1U
            owner_out[0] := current
            slot_out[0] := at
            return: c.lmx_graph_get(current, at)
        if: found > 1U
            return: 0
        value := c.lmx_graph_space_find(current, word)
        if: value != 0
            return: value
        if: c.lmx_graph_method(g, current) != 0
            part := c.lmx_graph_method_data(g, current)
            found := lmx_graph_data_find(g, part, word, 1, 0U, @ at)
            if: found = 1U
                owner_out[0] := part
                slot_out[0] := at
                return: c.lmx_graph_get(part, at)
            if: found > 1U
                return: 0
        ---
        current := (cast: (@: c.Lmx) current\parent)
    ---
    return: 0
end: lmx_graph_atom_target

# The step `\word` of a path read from value: the field lmx_graph_step_index names in the Structure value stands for --
# the target of a reference, the same instance --; a field that is an atom answers the entity its word refers to
# (lmx_graph_atom_target), and the slot keeps the atom. 0 and the value in out; 3 for no such field, an ambiguous name
# or an atom that refers to nothing.
fn: lmx_graph_step (@: g c.LmxGraph; @: value void; @: word char; @@: out void) int
    @: base void c.lmx_graph_target(g, value)
    @: owner c.Lmx 0
    @: field void 0
    size_t: slot 0U
    if: out = 0 || c.lmx_graph_kind(g, base) != 4
        return: 3
    owner := (cast: (@: c.Lmx) base)
    slot := lmx_graph_step_index(g, owner, word)
    if: slot >= c.lmx_graph_count(owner)
        return: 3
    field := c.lmx_graph_get(owner, slot)
    if: c.lmx_graph_kind(g, field) = 2 && c.lmx_graph_name_of(g, field) = 0
        field := lmx_graph_atom_target(g, owner, c.lmx_graph_word_text(g, field), @ owner, @ slot)
    if: field = 0
        return: 3
    out[0] := field
    return: 0
end: lmx_graph_step

# The place the step `\word` of a path names for a write through it (the book, fields; plan M11 5a): the field
# lmx_graph_step_index names in the Structure value stands for or, when that field is an atom, the record its word
# refers to (lmx_graph_atom_target) -- a write through `Pair\i`, Pair holding the atom i, writes the place i itself, one
# instance. 0 with the Structure holding the place in owner_out and its slot in slot_out; 3 for no such field, an
# ambiguous name or an atom that refers to no record; 4 for a value that is no Structure.
fn: lmx_graph_step_place (@: g c.LmxGraph; @: value void; @: word char; @@: owner_out void; @: slot_out size_t) int
    @: base void c.lmx_graph_target(g, value)
    @: owner c.Lmx 0
    @: field void 0
    size_t: slot 0U
    if: owner_out = 0 || slot_out = 0
        return: 3
    if: c.lmx_graph_kind(g, base) != 4
        return: 4
    owner := (cast: (@: c.Lmx) base)
    slot := lmx_graph_step_index(g, owner, word)
    if: slot >= c.lmx_graph_count(owner)
        return: 3
    field := c.lmx_graph_get(owner, slot)
    if: c.lmx_graph_kind(g, field) = 2 && c.lmx_graph_name_of(g, field) = 0
        if: lmx_graph_atom_target(g, owner, c.lmx_graph_word_text(g, field), @ owner, @ slot) = 0 || owner = 0
            return: 3
        ---
    ---
    owner_out[0] := (cast: (@: void) owner)
    slot_out[0] := slot
    return: 0
end: lmx_graph_step_place

# The answers of the interpreter: 0 done; 1 an address has no int representation where an int is needed; 2 a malformed
# expression (an operator without an operand, two operands in a row, an unknown token); 3 an unknown name; 4 a write
# refused (a slot that holds no int place); 5 a statement this slice does not execute; 6 division by zero; 7 an index
# outside the fields of a Structure; 8 a structural form whose head is a known place that is no Structure (the book,
# forms-declare-or-call: such a form declares nothing and assigns nothing; the value of a known place is written by
# `:=`).

# The space above the code the live launch runs -- the value of the reserved word node (the book, node: one for the
# whole activation, its nested bodies included; the author's decision 2026-11-11 through fable2, plan M11 5b part 2).
# It is lexical by the code, not by the data the launch was given: the space of an ordinary Structure is its parent
# (`call(D; Bump)` gives the parent of Bump). The space of a callable is the block its declaration stands in, read up
# through the bodies of the control receivers, which run in the same activation (if, else, while, for, a post loop and
# its body, finally): a block that is a part of the declaration of another callable -- its written code or its data --
# gives that callable's data part (an inner method changes the enclosing's data through `node\name`); any other block is
# the space itself. The unit root has no parent, so it has no space and the name answers nothing. 0 for no space.
fn: lmx_graph_node_passes (@: state c.LmxGraphState; @: word char) int
    if: state = 0 || word = 0
        return: 0
    return: (cast: (int) (word = state\w_if || word = state\w_else || word = state\w_while || word = state\w_for || word = state\w_until || word = state\w_finally))
end: lmx_graph_node_passes

# The space itself (lmx_graph_node_space): a control receiver or its body is passed through, above, by its name or by
# the name of the Lmx it is a field of (an `if` is [condition, body], its body unnamed).
fn: lmx_graph_node_space (@: g c.LmxGraph) @: void
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: activation c.LmxActivation 0
    @: code c.Lmx 0
    @: current c.Lmx 0
    @: owner c.Lmx 0
    @: enclosing c.Lmx 0
    @: head char 0
    @: above char 0
    if: g = 0 || state = 0
        return: 0
    activation := (cast: (@: c.LmxActivation) g\arena\activation)
    if: activation = 0 || activation\code = 0
        return: 0
    code := activation\code
    if: c.lmx_graph_method(g, code) = 0
        return: (cast: (@: void) code\parent)
    owner := (cast: (@: c.Lmx) code\parent)
    if: owner = 0
        return: 0
    current := (cast: (@: c.Lmx) owner\parent)
    while: current != 0
        head := c.lmx_graph_name_of(g, (cast: (@: void) current))
        owner := (cast: (@: c.Lmx) current\parent)
        above := 0
        if: owner != 0
            above := c.lmx_graph_name_of(g, (cast: (@: void) owner))
        ---
        if: lmx_graph_node_passes(state, head) != 0 || lmx_graph_node_passes(state, above) != 0
            current := owner
            continue
        if: owner != 0 && owner\parent != 0 && (above = state\w_fn || above = state\w_sub)
            enclosing := (cast: (@: c.Lmx) c.lmx_graph_space_find((cast: (@: c.Lmx) owner\parent), lmx_graph_fn_decl_name(g, owner)))
            if: c.lmx_graph_method(g, enclosing) != 0 && enclosing\parent = owner
                return: (cast: (@: void) c.lmx_graph_method_data(g, enclosing))
            ---
        ---
        return: (cast: (@: void) current)
    ---
    return: 0
end: lmx_graph_node_space

# Resolve the current activation's formals, inherited inputs, then lexical graph fields. Each lookup consumes the
# current graph and the live activation chain; no binding is saved in the graph or reused by the next traversal.
fn: lmx_graph_resolve (@: g c.LmxGraph; @: scope c.Lmx; @: name char) @: void
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: activation c.LmxActivation 0
    @: active_frame c.LmxGraphFrame 0
    @: args c.Lmx 0
    @: row c.LmxGraphWork 0
    @: current c.Lmx scope
    @: launched c.Lmx 0
    @: part c.Lmx 0
    @: value void 0
    @: space c.LmxGraphSpace c.lmx_graph_space()
    @: head char 0
    size_t: slot 0U
    size_t: at 0U
    size_t: found 0U
    if: g = 0 || name = 0
        return: 0
    # The reserved word node names the space above the live launch's code (lmx_graph_node_space), never a binding: it is
    # read before the chain of activations, and no row, formal or field answers it.
    if: state != 0 && name = state\w_node
        return: lmx_graph_node_space(g)
    activation := (cast: (@: c.LmxActivation) g\arena\activation)
    while: activation != 0
        if: activation\frame != 0
            row := lmx_graph_work_row((cast: (@: c.LmxGraphFrame) activation\frame), name)
            if: row != 0
                return: row\cell
            ---
            if: activation = g\arena\activation && name = state\w_data
                active_frame := (cast: (@: c.LmxGraphFrame) activation\frame)
                return: (cast: (@: void) active_frame\data)
            ---
        ---
        args := lmx_graph_activation_args(g, activation)
        if: args != 0 && activation\refs != 0
            slot := c.lmx_graph_formal(g, args, name)
            if: slot < activation\width
                return: activation\refs[slot]
            ---
        ---
        # The registry of the data of this launch, after its rows and formals and before the lexical levels -- for every
        # launch of the chain, as for a number (plan M11 5b): a Structure of that data, a record that declares no place,
        # answers by reference -- one instance, a path writes it, a bare name is no place to write --; two or more records
        # of the name answer nothing.
        if: activation\frame != 0
            active_frame := (cast: (@: c.LmxGraphFrame) activation\frame)
            found := lmx_graph_data_find(g, (cast: (@: c.Lmx) active_frame\data), name, 1, 0U, @ at)
            if: found > 1U
                return: 0
            if: found = 1U
                value := c.lmx_graph_get((cast: (@: c.Lmx) active_frame\data), at)
                head := c.lmx_graph_name_of(g, value)
                if: c.lmx_graph_kind(g, value) = 4 && head != 0 && head != state\w_int && head != state\w_at
                    return: value
                ---
            ---
        ---
        activation := activation\parent
    ---
    # The special name `data` read by the root of a unit run over itself, with no frame, answers the root itself (the
    # author 2026-11-11, R6; plan M11 5a): `data\[1]Model` selects an occurrence of the root.
    if: state != 0 && name = state\w_data && space != 0 && space\root = scope
        return: (cast: (@: void) scope)
    # The code of the live launch of an ordinary Structure over data it was given is code, not data (the roles data and
    # code, the author 2026-11-11): its own records answer no name; the launch finds a name in its data, its inputs, and
    # the levels around its code. A callable's own fields are its parts -- args, data, code, return --, and they answer in
    # its code (the author 2026-11-11, LMX_blog/2026-11-11.md#callable-parts-visibility; plan M11 5b).
    activation := (cast: (@: c.LmxActivation) g\arena\activation)
    if: activation != 0 && activation\frame != 0
        active_frame := (cast: (@: c.LmxGraphFrame) activation\frame)
        if: active_frame\data != active_frame\code && c.lmx_graph_method(g, active_frame\code) = 0
            launched := (cast: (@: c.Lmx) active_frame\code)
        ---
    ---
    # Lexical: each block of the chain of parents by its registry (lmx_graph_data_find: its records, read whole, so a
    # place or a named Structure answers above and below its line, and two or more records of the name answer nothing
    # -- the book, fields; plan M11 5a), then by the namespace of this traversal (the callables fn and sub created);
    # a callable's body block and its own fields; a declaration by the own fields of what it created in this traversal.
    while: c.lmx_graph_kind(g, (cast: (@: void) current)) = 4
        found := 0U
        if: current != launched
            found := lmx_graph_data_find(g, current, name, 1, 0U, @ at)
        if: found > 1U
            return: 0
        if: found = 1U
            value := c.lmx_graph_get(current, at)
            # A place declared by its receiver with a computed value, not executed yet (`int: x five()`, `@: h f` before
            # its line, R12): the place exists without a value -- the name answers nothing now, and no outer level does.
            head := c.lmx_graph_name_of(g, value)
            if: c.lmx_graph_kind(g, value) = 4 && head != 0 && (head = state\w_int || head = state\w_at)
                return: 0
            return: value
        ---
        value := c.lmx_graph_space_find(current, name)
        if: value != 0
            return: value
        if: c.lmx_graph_method(g, current) != 0
            value := c.lmx_graph_space_find(c.lmx_graph_method_code(g, current), name)
            if: value != 0
                return: value
            part := c.lmx_graph_method_data(g, current)
            slot := c.lmx_graph_formal(g, part, name)
            if: slot < c.lmx_graph_count(part)
                return: c.lmx_graph_get(part, slot)
            ---
        else:
            head := c.lmx_graph_name_of(g, (cast: (@: void) current))
            if: (head = state\w_fn || head = state\w_sub) && current\parent != 0
                part := (cast: (@: c.Lmx) c.lmx_graph_space_find((cast: (@: c.Lmx) current\parent), lmx_graph_fn_decl_name(g, current)))
                if: c.lmx_graph_method(g, part) != 0 && part\parent = current
                    part := c.lmx_graph_method_data(g, part)
                    slot := c.lmx_graph_formal(g, part, name)
                    if: slot < c.lmx_graph_count(part)
                        return: c.lmx_graph_get(part, slot)
                    ---
                ---
            ---
        ---
        current := (cast: (@: c.Lmx) current\parent)
    ---
    return: 0
end: lmx_graph_resolve

# Shape/default preflight precedes evaluation of any actual. This migration executes int-returning fn bodies;
# explicit int own fields use the shared working-cache/publication mechanism. Other receiver/result forms refuse.
fn: lmx_graph_call_shape (@: g c.LmxGraph; @: code c.Lmx; size_t: actuals) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: args c.Lmx 0
    size_t: i actuals
    if: c.lmx_graph_method(g, code) = 0
        return: 5
    args := c.lmx_graph_method_args(g, code)
    if: actuals > c.lmx_graph_count(args)
        return: 5
    # An implementation boundary of this slice, not a norm: a result is executed when its written requirement is int.
    if: c.lmx_graph_has_result(g, code) != 0
        if: c.lmx_graph_word_text(g, c.lmx_graph_method_return(g, code)) != state\w_int
            return: 5
        ---
    ---
    while: i < c.lmx_graph_count(args)
        if: c.lmx_graph_kind(g, c.lmx_graph_get(args, i)) != 1
            return: 5
        i := i + 1U
    ---
    return: 0
end: lmx_graph_call_shape

# An anonymous value keeps its own fields unless it denotes an expression.
# Operations are already nested Lmx values; this reads their ordinary words,
# without parsing precedence or changing the source graph. A grouped name or
# application still evaluates, while a scalar field or nested data stays data.
fn: lmx_graph_group_expression (@: g c.LmxGraph; @: scope c.Lmx; @: raw void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: value c.Lmx (cast: (@: c.Lmx) raw)
    @: child void 0
    @: word char 0
    size_t: count 0U
    int: kind 0
    if: state = 0 || c.lmx_graph_kind(g, raw) != 4 || c.lmx_graph_name_of(g, raw) != 0
        return: 0
    count := c.lmx_graph_count(value)
    if: count = 1U
        child := c.lmx_graph_get(value, 0U)
        kind := c.lmx_graph_kind(g, child)
        if: kind = 2
            return: (cast: (int) (c.lmx_graph_name_of(g, child) = 0))
        if: kind != 4
            return: 0
        if: c.lmx_graph_name_of(g, child) != 0
            # A language application still belongs to its existing receiver,
            # including a receiver this subset must explicitly refuse.
            return: (cast: (int) (c.lmx_graph_language_receiver(c.lmx_graph_name_of(g, child)) != 0 || lmx_graph_applies(g, scope, child) != 0))
        return: lmx_graph_group_expression(g, scope, child)
    word := c.lmx_graph_word_text(g, c.lmx_graph_get(value, 0U))
    if: count = 2U
        return: (cast: (int) (word = state\w_plus || word = state\w_minus || word = state\w_not || word = state\w_deref || word = state\w_at))
    if: count = 3U
        if: word = state\w_assign
            return: 1
        word := c.lmx_graph_word_text(g, c.lmx_graph_get(value, 1U))
        return: (cast: (int) (word = state\w_deref || word = state\w_index || word = state\w_plus || word = state\w_minus || word = state\w_star || word = state\w_slash || word = state\w_percent || word = state\w_eq || word = state\w_ne || word = state\w_lt || word = state\w_le || word = state\w_gt || word = state\w_ge || word = state\w_and || word = state\w_or))
return: 0

# One positional value without effects -- written data, a name or a field
# path -- or a merge may supply the whole argument Structure. Its direct
# fields bind by name or position through lmx_graph_call_single. The operands
# of a merge run before that check, as for a held result. Operations, addresses,
# calls and named actuals keep ordinary preflight before their effects.
fn: lmx_graph_single_candidate (@: g c.LmxGraph; @: scope c.Lmx; @: expression c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void 0
    @: path c.Lmx 0
    int: kind 0
    if: g = 0 || state = 0 || c.lmx_graph_kind(g, (cast: (@: void) expression)) != 4 || c.lmx_graph_count(expression) != 1U
        return: 0
    raw := c.lmx_graph_get(expression, 0U)
    kind := c.lmx_graph_kind(g, raw)
    if: kind = 2
        return: 1
    if: kind != 4
        return: 0
    if: c.lmx_graph_name_of(g, raw) = state\w_merge
        return: 1
    if: c.lmx_graph_name_of(g, raw) != 0
        return: 0
    path := (cast: (@: c.Lmx) raw)
    # Written data uses the same field/whole decision as a held Structure.
    if: lmx_graph_group_expression(g, scope, raw) = 0
        return: 1
    if: c.lmx_graph_count(path) = 3U && c.lmx_graph_word_text(g, c.lmx_graph_get(path, 1U)) = state\w_deref
        return: 1
    # A grouped name/path remains a value without effects. A grouped call or
    # operation remains an ordinary actual, with shape checked before it runs.
    if: c.lmx_graph_count(path) = 1U
        return: lmx_graph_single_candidate(g, scope, path)
return: 0

# Bind the written actuals of expression to the formals of a signature before any of them is evaluated -- the one binder
# of a call (lmx_graph_bind_call) and of the contract of a receiver (lmx_graph_receiver_bind). A positional actual takes
# the formal at its position; a named actual `name := value` the formal of that name, after which no positional actual
# comes; with by_head (the parts of a receiver's written form), a Frame `name: ...` whose head names a formal and
# answers no callable in scope binds that formal too, whatever fields it holds (none, one, a vertical block: the Frame
# is the part, lmx_graph_frame_value) (the author 2026-11-09: `fn: name: "test"; args: (); ...` creates the function
# when no callable name exists; a callable name is applied once by the general rule, as a positional actual).
# A formal is bound at most once. bindings[i] the formal of actual i, modes[i] how (0 position, 1 `:=`, 2 head; modes may
# be 0), seen[slot] 1 for a bound formal: arrays of the caller. 0, or 5 for actuals that bind no formal of the signature.
fn: lmx_graph_bind_formals (@: g c.LmxGraph; @: formals c.Lmx; @: expression c.Lmx; @: bindings size_t; @: modes int; @: seen int; int: by_head; @: scope c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: argument c.Lmx 0
    @: raw void 0
    @: name char 0
    size_t: width c.lmx_graph_count(formals)
    size_t: count c.lmx_graph_count(expression)
    size_t: i 0U
    size_t: slot 0U
    int: named 0
    int: mode 0
    int: status 0
    if: state = 0 || bindings = 0 || seen = 0
        return: 5
    while: i < count && status = 0
        raw := c.lmx_graph_get(expression, i)
        argument := (cast: (@: c.Lmx) raw)
        slot := i
        mode := 0
        name := 0
        if: c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_word_text(g, c.lmx_graph_get(argument, 0U)) = state\w_assign
            mode := 1
            name := c.lmx_graph_word_text(g, c.lmx_graph_get(argument, 1U))
            if: c.lmx_graph_count(argument) != 3U || name = 0
                status := 5
            ---
        else:
            if: by_head != 0 && c.lmx_graph_kind(g, raw) = 4
                name := c.lmx_graph_name_of(g, raw)
                if: name != 0 && c.lmx_graph_formal(g, formals, name) < width && c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_target(g, lmx_graph_resolve(g, scope, name)))) = 0
                    mode := 2
                ---
            ---
        ---
        if: mode != 0
            named := 1
            slot := c.lmx_graph_formal(g, formals, name)
        else:
            if: named != 0
                status := 5
            ---
        ---
        if: slot >= width
            status := 5
        if: status = 0
            if: seen[slot] != 0
                status := 5
            else:
                seen[slot] := 1
                bindings[i] := slot
                if: modes != 0
                    modes[i] := mode
                ---
            ---
        ---
        i := i + 1U
    ---
    return: status
end: lmx_graph_bind_formals

# Does the Structure give formals of the signature by its fields -- a named field by name, an unnamed field by position,
# each formal by one field at most (the book, whole-arguments)? from[slot] 1 + the index of its field, 0 for none (the caller's array, width
# + 1 long). The caller tells what an unsupplied formal needs (a default of a call; none for a receiver). 1 or 0.
fn: lmx_graph_bind_fields (@: g c.LmxGraph; @: formals c.Lmx; @: structure c.Lmx; @: from size_t) int
    @: name char 0
    size_t: width c.lmx_graph_count(formals)
    size_t: n c.lmx_graph_count(structure)
    size_t: i 0U
    size_t: slot 0U
    if: from = 0
        return: 0
    while: i < n
        name := c.lmx_graph_slot_name(g, structure, i)
        slot := i
        if: name != 0
            slot := c.lmx_graph_formal(g, formals, name)
        if: slot >= width
            return: 0
        if: from[slot] != 0U
            return: 0
        from[slot] := i + 1U
        i := i + 1U
return: 1

# Bind written arguments to the selected method before evaluating any of them. The map and the seen set belong
# only to this call; labels are canonical name addresses and the map stores physical formal slots, not name codes.
fn: lmx_graph_bind_call (@: g c.LmxGraph; @: scope c.Lmx; @: code c.Lmx; @: expression c.Lmx; @: bindings size_t) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: args c.Lmx 0
    @: argument c.Lmx 0
    @: raw void 0
    @: name char 0
    @: seen int 0
    size_t: count 0U
    size_t: width 0U
    size_t: i 0U
    size_t: slot 0U
    int: named 0
    int: status 0
    if: c.lmx_graph_method(g, code) = 0 || c.lmx_graph_kind(g, (cast: (@: void) expression)) != 4 || bindings = 0
        return: 5
    args := c.lmx_graph_method_args(g, code)
    width := c.lmx_graph_count(args)
    count := c.lmx_graph_count(expression)
    if: lmx_graph_call_shape(g, code, width) != 0
        return: 5
    # A possible whole argument structure -- an empty Structure included, which is the empty field chain of a nullary
    # or default-only call -- is matched with the formals by lmx_graph_call_single once its value is known.
    if: lmx_graph_single_candidate(g, scope, expression) != 0
        return: 0
    if: count > width
        return: 5
    seen := (cast: (@: int) c.calloc(width + 1U, sizeof(int)))
    if: seen = 0
        return: 4
    status := lmx_graph_bind_formals(g, args, expression, bindings, 0, seen, 0, 0)
    i := 0U
    while: i < width && status = 0
        if: seen[i] = 0 && c.lmx_graph_kind(g, c.lmx_graph_get(args, i)) != 1
            status := 5
        i := i + 1U
    ---
    c.free((cast: (@: void) seen))
    return: status
end: lmx_graph_bind_call

# The first structural receiving pass for the field-reading subset: compare the paths actually used from this
# formal against the written model and the candidate, by canonical names and address types. The temporary queue
# belongs only to this admission. It neither checks unused model fields nor depends on their positions.
# Follow a nested path rooted at this formal. 0 unrelated, 1 matched, -1 a required field/type is absent.
fn: lmx_graph_admit_path (@: g c.LmxGraph; @: expression void; @: name char; @: model void; @: candidate void; @@: wanted void; @@: found void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: path c.Lmx 0
    @: field char 0
    int: status 0
    int: kind 0
    if: c.lmx_graph_word_text(g, expression) = name
        wanted[0] := model
        found[0] := candidate
        return: 1
    if: c.lmx_graph_kind(g, expression) != 4
        return: 0
    path := (cast: (@: c.Lmx) expression)
    if: c.lmx_graph_count(path) != 3U || c.lmx_graph_word_text(g, c.lmx_graph_get(path, 1U)) != state\w_deref
        return: 0
    status := lmx_graph_admit_path(g, c.lmx_graph_get(path, 0U), name, model, candidate, wanted, found)
    if: status != 1
        return: status
    field := c.lmx_graph_word_text(g, c.lmx_graph_get(path, 2U))
    # The same path step as a read (lmx_graph_step): through an atom of the model or of the candidate too.
    if: lmx_graph_step(g, wanted[0], field, wanted) != 0
        wanted[0] := 0
    if: lmx_graph_step(g, found[0], field, found) != 0
        found[0] := 0
    kind := c.lmx_graph_kind(g, wanted[0])
    if: kind = 3
        kind := 1
    if: c.lmx_graph_kind(g, found[0]) = 3
        found[0] := c.lmx_arena_pointer_void_read(found[0])
    if: kind = 0 || kind != c.lmx_graph_kind(g, found[0])
        return: -1
    return: 1
end: lmx_graph_admit_path

fn: lmx_graph_admit_paths (@: g c.LmxGraph; @: code c.Lmx; @: name char; @: model void; @: candidate void) int
    @@: queue c.Lmx 0
    size_t: count 0U
    size_t: cap 0U
    size_t: at 0U
    size_t: i 0U
    @: current c.Lmx 0
    @: value void 0
    @: wanted void 0
    @: found void 0
    int: status 0
    if: c.lmx_graph_kind(g, model) != 4 || c.lmx_graph_kind(g, candidate) != 4
        return: 4
    status := c.lmx_graph_scan_add(@ queue, @ count, @ cap, c.lmx_graph_method_code(g, code))
    while: at < count && status = 0
        current := queue[at]
        at := at + 1U
        if: lmx_graph_admit_path(g, (cast: (@: void) current), name, model, candidate, @ wanted, @ found) < 0
            status := 4
        i := 0U
        while: i < c.lmx_graph_count(current) && status = 0
            value := c.lmx_graph_get(current, i)
            if: c.lmx_graph_kind(g, value) = 4
                status := c.lmx_graph_scan_add(@ queue, @ count, @ cap, (cast: (@: c.Lmx) value))
            i := i + 1U
        ---
    ---
    c.free((cast: (@: void) queue))
    return: status
end: lmx_graph_admit_paths

# Admit each already evaluated argument immediately, before evaluating the next. Int arguments receive independent
# cells; a Structure is checked using its field names. The caller's transient refs array carries the admitted values.
fn: lmx_graph_admit_int (@: g c.LmxGraph; int: number; @@: out void) int
    out[0] := c.lmx_graph_int(g, number)
    if: out[0] = 0
        return: 4
return: 0

fn: lmx_graph_admit (@: g c.LmxGraph; @: code c.Lmx; size_t: index; @: actual void; @@: out void) int
    @: args c.Lmx c.lmx_graph_method_args(g, code)
    @: formal void c.lmx_graph_get(args, index)
    @: model void 0
    @: declaration c.Lmx 0
    @: requirement char 0
    int: kind (cast: (int) c.lmx_graph_kind(g, formal))
    int: status 0
    int: number 0
    if: out = 0
        return: 4
    if: kind = 1 || kind = 3
        if: c.lmx_graph_value_int(g, actual, @ number) != 0
            return: 4
        return: lmx_graph_admit_int(g, number, out)
    if: kind != 4
        return: 5
    # Read the receiving declaration through its shared model query. The flat
    # reference receiver and compatible descriptions use the same admission.
    declaration := (cast: (@: c.Lmx) formal)
    requirement := c.lmx_graph_formal_model(g, declaration)
    if: requirement = 0
        return: 5
    model := lmx_graph_resolve(g, (cast: (@: c.Lmx) code\parent), requirement)
    status := lmx_graph_admit_paths(g, code, c.lmx_graph_formal_name(g, args, index), model, actual)
    if: status = 0
        out[0] := actual
    return: status
end: lmx_graph_admit

# Read a written actual by the selected formal's contract, then receive it.
# A numeric formal reads a group as an expression; a Structure formal keeps
# its data. The numeric result enters the same independent argument cell,
# without allocating an intermediate cell just to copy it at admission.
fn: lmx_graph_read_actual (@: g c.LmxGraph; @: scope c.Lmx; @: code c.Lmx; size_t: index; @: raw void; @@: out void) int
    @: formal void c.lmx_graph_get(c.lmx_graph_method_args(g, code), index)
    @: actual void 0
    int: kind c.lmx_graph_kind(g, formal)
    int: number 0
    int: status 0
    if: out = 0
        return: 4
    if: (kind = 1 || kind = 3) && c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && lmx_graph_group_expression(g, scope, raw) = 0
        status := lmx_graph_eval_number(g, scope, raw, @ number)
        if: status != 0
            return: status
        return: lmx_graph_admit_int(g, number, out)
    status := lmx_graph_eval_value(g, scope, raw, @ actual)
    if: status = 0
        status := lmx_graph_admit(g, code, index, actual, out)
return: status

# Sequential statements over the current method activation. Bodies stay in the graph on every call.
# A control body is consumed in the same activation. Flow is the canonical word address, never an opcode or
# retained plan. mode 0 uses activation places; mode 1 is construction-root execution; mode 2 is its inline body.
fn: lmx_graph_block (@: g c.LmxGraph; @: code c.Lmx; @: body c.Lmx; size_t: from; size_t: to; int: mode; @: out int; @@: flow char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: statement c.Lmx 0
    @: nested c.Lmx 0
    @: header c.Lmx 0
    @: head char 0
    @: name char 0
    @: target void 0
    @: raw void 0
    size_t: i from
    size_t: n 0U
    size_t: slot 0U
    int: number 0
    int: status 0
    int: kind 0
    int: nested_mode mode
    int: cleanup_status 0
    int: pending_result 0
    int: reached 0
    @: pending_flow char 0
    if: mode = 1
        nested_mode := 2
    while: i < to && status = 0 && flow[0] = 0
        raw := c.lmx_graph_get(body, i)
        kind := c.lmx_graph_kind(g, raw)
        # A field of the root that stands -- a place, a named Structure, declared when the traversal reaches it
        # (lmx_graph_space_reach) -- is passed; a statement or a definition runs.
        if: mode = 1
            reached := lmx_graph_space_reach(g, code, i)
            # A negative answer carries the interpreter's own (lmx_graph_space_reach): 8 for the refused form.
            if: reached < 0
                return: 0 - reached
            if: reached > 0
                i := i + 1U
                continue
            ---
        ---
        # A declaration of an int place is that place (§3.2). Reached in a body, it runs at its written position, at every
        # reach -- each pass of a loop too (the author 2026-11-11, R12; plan M11 5a, B5, B10): a literal declaration
        # writes into the activation's place what stands in its slot now -- the place's own cell when the Structure runs
        # over itself, so a value published by an earlier launch is what it writes --, a place without a value is
        # checked; in an inline body of the root it writes the root's place; at the root it is the root's own place
        # and stands.
        if: kind = 1 || kind = 3
            name := c.lmx_graph_slot_name(g, body, i)
            if: name != 0 && mode = 0
                status := lmx_graph_local_int(g, code, name)
                if: status = 0 && kind = 1
                    status := lmx_graph_store_name(g, code, name, c.lmx_int_value_known(raw))
                i := i + 1U
                continue
            ---
            if: name != 0 && mode = 2
                slot := lmx_graph_visible_slot(g, code, name)
                if: slot >= c.lmx_graph_count(code)
                    return: 3
                if: kind = 1
                    status := c.lmx_graph_assign_int(g, code, code, slot, c.lmx_int_value_known(raw))
                i := i + 1U
                continue
            ---
            if: name != 0 || kind = 3
                i := i + 1U
                continue
            ---
        ---
        if: kind = 5 || kind = 6
            i := i + 1U
            continue
        head := c.lmx_graph_word_text(g, raw)
        if: head = state\w_return
            if: lmx_graph_launch_result(g, code) != 0
                return: 5
            flow[0] := head
            return: 0
        if: head = state\w_break || head = state\w_continue || head = state\w_redo
            flow[0] := head
            return: 0
        if: kind != 4
            if: mode = 0
                status := lmx_graph_eval_number(g, code, raw, @ number)
            i := i + 1U
            continue
        statement := (cast: (@: c.Lmx) raw)
        n := c.lmx_graph_count(statement)
        head := c.lmx_graph_name_of(g, raw)
        if: head = 0
            # An unnamed Lmx: the assignment `a := v`, a statement on a path head, an anonymous body, or an expression
            # whose value is not used.
            if: n != 0U
                head := c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 0U))
            if: head = state\w_assign
                status := lmx_graph_eval_assignment(g, code, statement, mode)
                i := i + 1U
                continue
            # A statement on a path head, `owner\field: value` (c.lmx_graph_path_head): the write of that field.
            if: head = 0 && c.lmx_graph_path_head(g, raw) != 0
                status := lmx_graph_eval_path_statement(g, code, statement)
                i := i + 1U
                continue
            if: head = 0
                status := lmx_graph_block(g, code, statement, 0U, n, nested_mode, out, flow)
                i := i + 1U
                continue
            if: mode = 0
                status := lmx_graph_eval_number(g, code, raw, @ number)
            i := i + 1U
            continue
        # A declaration of fn or sub with written arguments created its Structure in this traversal when its block was
        # entered (lmx_graph_space_declarations); the receiver applied to arguments the traversal computes creates it
        # here, where the root reaches it (lmx_graph_fn_apply) -- in a body or an inline block that is open (5). The data
        # part of a Structure is its data; a named Structure of the root stands.
        if: head = state\w_fn || head = state\w_sub
            if: lmx_graph_fn_written(g, statement) = 0
                if: mode != 1
                    return: 5
                status := lmx_graph_fn_apply(g, code, i)
            ---
            i := i + 1U
            continue
        # A record headed by data launches the data of the live launch in the code of a callable (the book,
        # #ordinary-var; the author's decision 2026-11-11 through fable2, plan M11 5b part 2, В3): `data()` runs it over
        # itself, `data(D)` over D -- the launch of a Structure by name, whose name data resolves to the data of the live
        # launch (lmx_graph_launch_head, lmx_graph_eval_launch_record). Elsewhere -- the root, an ordinary Structure over
        # itself or over data it was given, where its field data is still the model of the places of the data until
        # plan M11 5в -- the record is passed by.
        if: head = state\w_data
            if: mode = 0 && lmx_graph_callable_code(g) != 0
                target := lmx_graph_launch_head(g, code, head)
                if: target = 0
                    return: 5
                status := lmx_graph_eval_launch_record(g, code, statement, target)
            ---
            i := i + 1U
            continue
        if: head = state\w_fm
            return: 5
        if: head = state\w_finally
            # Reaching this field registers its body in this scope. Recursing over the remaining statements makes
            # multiple registrations unwind in reverse order, without a persistent plan or a second graph.
            status := lmx_graph_block(g, code, body, i + 1U, to, mode, out, flow)
            pending_flow := flow[0]
            if: pending_flow = state\w_return
                pending_result := out[0]
            if: status != 0 || pending_flow = state\w_return
                cleanup_status := lmx_graph_work_flush(g)
                if: cleanup_status != 0
                    status := cleanup_status
                ---
            ---
            flow[0] := 0
            cleanup_status := lmx_graph_block(g, code, statement, 0U, n, nested_mode, out, flow)
            if: cleanup_status != 0
                return: cleanup_status
            if: flow[0] = 0
                flow[0] := pending_flow
                if: pending_flow = state\w_return
                    out[0] := pending_result
                ---
            ---
            return: status
        if: head = state\w_if
            if: n != 2U || c.lmx_graph_kind(g, c.lmx_graph_get(statement, 1U)) != 4
                return: 2
            status := lmx_graph_eval_number(g, code, c.lmx_graph_get(statement, 0U), @ number)
            if: status != 0
                return: status
            if: number != 0
                nested := (cast: (@: c.Lmx) c.lmx_graph_get(statement, 1U))
                status := lmx_graph_block(g, code, nested, 0U, c.lmx_graph_count(nested), nested_mode, out, flow)
            i := i + 1U
            if: i < to && c.lmx_graph_kind(g, c.lmx_graph_get(body, i)) = 4 && c.lmx_graph_name_of(g, c.lmx_graph_get(body, i)) = state\w_else
                statement := (cast: (@: c.Lmx) c.lmx_graph_get(body, i))
                if: number = 0 && status = 0
                    status := lmx_graph_block(g, code, statement, 0U, c.lmx_graph_count(statement), nested_mode, out, flow)
                i := i + 1U
            ---
            continue
        if: head = state\w_else
            return: 2
        if: head = state\w_while || head = state\w_for || head = state\w_until
            if: n != 2U || c.lmx_graph_kind(g, c.lmx_graph_get(statement, 1U)) != 4
                return: 2
            nested := (cast: (@: c.Lmx) c.lmx_graph_get(statement, 1U))
            header := (cast: (@: c.Lmx) c.lmx_graph_get(statement, 0U))
            if: head = state\w_for
                if: c.lmx_graph_kind(g, (cast: (@: void) header)) != 4 || c.lmx_graph_count(header) != 3U
                    return: 2
                status := lmx_graph_block(g, code, header, 0U, 1U, nested_mode, out, flow)
            while: status = 0 && flow[0] = 0
                number := 1
                if: head != state\w_until
                    if: head = state\w_for
                        status := lmx_graph_eval_number(g, code, c.lmx_graph_get(header, 1U), @ number)
                    else:
                        status := lmx_graph_eval_number(g, code, c.lmx_graph_get(statement, 0U), @ number)
                    ---
                ---
                if: status != 0 || number = 0
                    break
                while: status = 0
                    flow[0] := 0
                    status := lmx_graph_block(g, code, nested, 0U, c.lmx_graph_count(nested), nested_mode, out, flow)
                    if: flow[0] != state\w_redo
                        break
                ---
                if: status != 0 || flow[0] = state\w_return
                    break
                if: flow[0] = state\w_break
                    flow[0] := 0
                    break
                if: flow[0] = state\w_continue
                    flow[0] := 0
                if: head = state\w_for && flow[0] = 0
                    status := lmx_graph_block(g, code, header, 2U, 3U, nested_mode, out, flow)
                ---
                if: status = 0 && head = state\w_until && flow[0] = 0
                    status := lmx_graph_eval_number(g, code, c.lmx_graph_get(statement, 0U), @ number)
                    if: status != 0 || number != 0
                        break
                    ---
                ---
            ---
            i := i + 1U
            continue
        if: head = state\w_break || head = state\w_continue || head = state\w_redo
            if: n != 0U
                return: 5
            flow[0] := head
            return: 0
        if: head = state\w_return
            if: n = 0U
                if: lmx_graph_launch_result(g, code) != 0
                    return: 5
                ---
            else:
                if: lmx_graph_launch_result(g, code) = 0
                    return: 5
                status := lmx_graph_eval(g, code, statement, 0U, n, out)
            ---
            flow[0] := state\w_return
            return: status
        if: mode = 1
            status := lmx_graph_exec_statement(g, code, i)
            i := i + 1U
            continue
        if: head = state\w_call
            status := lmx_graph_eval_explicit_call(g, code, statement)
            i := i + 1U
            continue
        # fncall written as a statement: the launch runs and its result is not used.
        if: head = state\w_fncall
            status := lmx_graph_eval_fncall(g, code, statement, @ number)
            i := i + 1U
            continue
        if: head = state\w_at
            return: 5
        if: head = state\w_include || head = state\w_predef
            i := i + 1U
            continue
        if: head != state\w_int
            raw := lmx_graph_resolve(g, code, head)
            target := c.lmx_graph_target(g, raw)
            if: c.lmx_graph_method(g, (cast: (@: c.Lmx) target)) != 0
                status := lmx_graph_eval_call(g, code, statement, (cast: (@: c.Lmx) target), @ number)
                i := i + 1U
                continue
            # A head that is an ordinary Structure launches it where the record does (lmx_graph_launch_head: in code
            # separated from its data, or through a reference place; the author 2026-11-11, R21, R22).
            target := lmx_graph_launch_head(g, code, head)
            if: target != 0
                status := lmx_graph_eval_launch_record(g, code, statement, target)
                i := i + 1U
                continue
            # A structural form declares or calls, it never assigns (the book, forms-declare-or-call). A head that
            # answers a place that is no Structure -- an int place, a reference place that points to no callable and no
            # Structure -- is declared by no such form, and its value is written by `:=`: 8. Any other head would
            # declare a Structure inside a running body or an inline block, which this slice does not execute: 5.
            if: raw != 0 && c.lmx_graph_kind(g, raw) != 4
                return: 8
            return: 5
        # `int: name` checks the place; `int: name value` writes it.
        head := c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 0U))
        if: mode = 0
            status := lmx_graph_local_int(g, code, head)
        else:
            slot := lmx_graph_visible_slot(g, code, head)
            if: slot = c.lmx_graph_count(code)
                return: 3
        ---
        if: status = 0 && n != 1U
            status := lmx_graph_eval(g, code, statement, 1U, n, @ number)
            if: status = 0
                if: mode = 0
                    status := lmx_graph_store_name(g, code, head, number)
                else:
                    status := c.lmx_graph_assign_int(g, code, code, slot, number)
                ---
            ---
        ---
        i := i + 1U
    ---
    return: status
end: lmx_graph_block

# Does the launch that runs code return a result? The parts of the live launch answer (its work frame,
# lmx_graph_work_open_parts); code asked outside its own launch -- a root, a Structure running without a frame -- answers
# by what it is: a callable by its return part, anything else has none.
fn: lmx_graph_launch_result (@: g c.LmxGraph; @: code c.Lmx) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: frame c.LmxGraphFrame 0
    if: active != 0 && active\code = code && active\frame != 0
        frame := (cast: (@: c.LmxGraphFrame) active\frame)
        return: frame\result
    return: c.lmx_graph_has_result(g, code)
end: lmx_graph_launch_result

# The code of the live launch runs to its end or to its return: the code part the launch was opened with
# (lmx_graph_work_open_parts): for a callable its own part code, for an ordinary Structure the Structure itself.
fn: lmx_graph_method_run (@: g c.LmxGraph; @: code c.Lmx; @: out int) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: frame c.LmxGraphFrame 0
    @: body c.Lmx code
    @: flow char 0
    int: status 0
    if: active != 0 && active\code = code && active\frame != 0
        frame := (cast: (@: c.LmxGraphFrame) active\frame)
        body := (cast: (@: c.Lmx) frame\body)
    else:
        if: c.lmx_graph_method(g, code) != 0
            body := c.lmx_graph_method_code(g, code)
        ---
    ---
    status := lmx_graph_block(g, code, body, 0U, c.lmx_graph_count(body), 0, out, @ flow)
    if: status != 0
        return: status
    if: flow != 0 && flow != state\w_return
        return: 5
    if: lmx_graph_launch_result(g, code) != 0 && flow != state\w_return
        return: 5
    return: 0
end: lmx_graph_method_run

# Invoke with arguments that have already passed admission. Missing literal defaults are copied into this call's
# private places. Native and interpretation share the ordinary activation ABI; the signature graph remains intact.
fn: lmx_graph_invoke_data (@: g c.LmxGraph; @: code c.Lmx; @: data c.Lmx; @@: actuals void; size_t: count; @: bindings size_t; @: out int) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: args c.Lmx 0
    @: body c.Lmx 0
    @: statement c.Lmx 0
    @@: refs void 0
    @: returned void 0
    c.LmxActivation: activation
    c.LmxGraphFrame: frame
    size_t: width 0U
    size_t: i 0U
    size_t: slot 0U
    int: status 0
    if: c.lmx_graph_method(g, code) = 0 || out = 0
        return: 5
    args := c.lmx_graph_method_args(g, code)
    width := c.lmx_graph_count(args)
    if: bindings = 0
        status := lmx_graph_call_shape(g, code, count)
    else:
        status := lmx_graph_call_shape(g, code, width)
    ---
    if: status != 0 || count > width
        return: 5
    refs := (cast: (@@: void) c.calloc(width + 1U, sizeof(@: void)))
    if: refs = 0
        return: 4
    while: i < count && status = 0
        slot := i
        if: bindings != 0
            slot := bindings[i]
        if: slot >= width
            status := 5
        else:
            if: refs[slot] != 0 || actuals = 0 || actuals[i] = 0
                status := 5
            else:
                refs[slot] := actuals[i]
            ---
        ---
        i := i + 1U
    ---
    i := 0U
    while: i < width && status = 0
        if: refs[i] = 0
            if: c.lmx_graph_kind(g, c.lmx_graph_get(args, i)) != 1
                status := 5
            else:
                status := lmx_graph_admit(g, code, i, c.lmx_graph_get(args, i), @ refs[i])
            ---
        ---
        i := i + 1U
    ---
    if: status = 0
        status := lmx_graph_work_flush(g)
    if: status = 0
        if: code\native != 0
            status := c.lmx_call_prim(g\arena, code, data, refs, width, (cast: (@: void) out), @ returned)
        else:
            status := c.lmx_activation_push(g\arena, @ activation, 2, code, refs, 0, width, 0)
            if: status = 0
                status := lmx_graph_work_open_data(g, code, data, @ frame)
                if: status = 0
                    status := lmx_graph_method_run(g, code, out)
                    status := lmx_graph_work_finish(g, @ frame, status)
                ---
                c.lmx_activation_pop(g\arena, @ activation)
            ---
        ---
    ---
    c.free((cast: (@: void) refs))
    return: status
end: lmx_graph_invoke_data

fn: lmx_graph_invoke (@: g c.LmxGraph; @: code c.Lmx; @@: actuals void; size_t: count; @: out int) int
    return: lmx_graph_invoke_data(g, code, c.lmx_graph_method_data(g, code), actuals, count, 0, out)
end: lmx_graph_invoke

fn: lmx_graph_invoke_bound (@: g c.LmxGraph; @: code c.Lmx; @@: actuals void; size_t: count; @: bindings size_t; @: out int) int
    return: lmx_graph_invoke_data(g, code, c.lmx_graph_method_data(g, code), actuals, count, bindings, out)
end: lmx_graph_invoke_bound

# The call of one positional actual that names a value without effects (lmx_graph_single_candidate), once that value
# is known (the book, whole-arguments: one Structure is its chain of fields). A Structure whose every direct field names
# a formal of the selected callee, each formal at most once, while every formal without a field has its written
# default, is the whole argument structure when each field is accepted by its formal: the common admission of this
# subset (lmx_graph_admit -- an int formal reads an int, a model formal the first part of implements over the used
# paths) decides, field by field in the callee's order. An empty Structure is the empty chain: the call of a nullary or
# default-only callee. Otherwise the value is the ordinary first argument and every other formal needs its default. One
# method decides by its formals and the value's direct fields: no tree search, no second reading, no conversion table
# yet (an implementation boundary of this subset). The arrays belong only to this call. 0, or the refusal of the form
# (5) or of a reception.
fn: lmx_graph_call_single (@: g c.LmxGraph; @: code c.Lmx; @: given void; @: out int) int
    # A reference to a Structure stands for that Structure as the whole argument structure (lmx_graph_target).
    @: value void c.lmx_graph_target(g, given)
    @: args c.Lmx 0
    @: structure c.Lmx 0
    @: field void 0
    @: name char 0
    @@: values void 0
    @: bindings size_t 0
    @: from size_t 0
    size_t: width 0U
    size_t: n 0U
    size_t: i 0U
    size_t: slot 0U
    size_t: k 0U
    int: whole 0
    int: status 0
    if: c.lmx_graph_method(g, code) = 0 || out = 0
        return: 5
    args := c.lmx_graph_method_args(g, code)
    width := c.lmx_graph_count(args)
    values := (cast: (@@: void) c.calloc(width + 1U, sizeof(@: void)))
    bindings := (cast: (@: size_t) c.calloc(width + 1U, sizeof(size_t)))
    from := (cast: (@: size_t) c.calloc(width + 1U, sizeof(size_t)))
    if: values = 0 || bindings = 0 || from = 0
        status := 4
    if: status = 0 && c.lmx_graph_kind(g, value) = 4 && c.lmx_graph_method(g, (cast: (@: c.Lmx) value)) = 0
        structure := (cast: (@: c.Lmx) value)
        n := c.lmx_graph_count(structure)
        whole := 1
        # from[slot]: 1 + the index of the field that names the formal at slot, 0 for none.
        whole := lmx_graph_bind_fields(g, args, structure, from)
        i := 0U
        while: i < width && whole != 0
            if: from[i] = 0U && c.lmx_graph_kind(g, c.lmx_graph_get(args, i)) != 1
                whole := 0
            i := i + 1U
        ---
        # The reading is applicable when every field is accepted by its formal.
        i := 0U
        while: i < width && whole != 0
            if: from[i] != 0U
                field := c.lmx_graph_get(structure, from[i] - 1U)
                if: lmx_graph_admit(g, code, i, field, @ values[k]) != 0
                    whole := 0
                else:
                    bindings[k] := i
                    k := k + 1U
                ---
            ---
            i := i + 1U
        ---
    ---
    if: status = 0 && whole = 0
        k := 0U
        if: width = 0U
            status := 5
        i := 1U
        while: i < width && status = 0
            if: c.lmx_graph_kind(g, c.lmx_graph_get(args, i)) != 1
                status := 5
            i := i + 1U
        ---
        if: status = 0
            status := lmx_graph_admit(g, code, 0U, value, @ values[0])
        bindings[0] := 0U
        k := 1U
    ---
    if: status = 0
        status := lmx_graph_invoke_bound(g, code, values, k, bindings, out)
    c.free((cast: (@: void) values))
    c.free((cast: (@: void) bindings))
    c.free((cast: (@: void) from))
    return: status
end: lmx_graph_call_single

fn: lmx_graph_eval_call (@: g c.LmxGraph; @: scope c.Lmx; @: expression c.Lmx; @: code c.Lmx; @: out int) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    size_t: count (cast: (size_t) c.lmx_graph_count(expression))
    size_t: i 0U
    @@: values void (cast: (@@: void) c.calloc(count + 1U, sizeof(@: void)))
    @: bindings size_t (cast: (@: size_t) c.calloc(count + 1U, sizeof(size_t)))
    @: actual void 0
    @: raw void 0
    int: status 4
    if: values != 0 && bindings != 0
        status := lmx_graph_bind_call(g, scope, code, expression, bindings)
    if: status = 0 && lmx_graph_single_candidate(g, scope, expression) != 0
        status := lmx_graph_eval_value(g, scope, c.lmx_graph_get(expression, 0U), @ actual)
        if: status = 0
            status := lmx_graph_call_single(g, code, actual, out)
        c.free((cast: (@: void) values))
        c.free((cast: (@: void) bindings))
        return: status
    while: i < count && status = 0
        raw := c.lmx_graph_get(expression, i)
        if: c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_word_text(g, c.lmx_graph_get((cast: (@: c.Lmx) raw), 0U)) = state\w_assign
            raw := c.lmx_graph_get((cast: (@: c.Lmx) raw), 2U)
        status := lmx_graph_read_actual(g, scope, code, bindings[i], raw, @ values[i])
        i := i + 1U
    ---
    if: status = 0
        status := lmx_graph_invoke_bound(g, code, values, count, bindings, out)
    c.free((cast: (@: void) values))
    c.free((cast: (@: void) bindings))
    return: status
end: lmx_graph_eval_call

# Evaluate an address-valued operand. A path returns the actual current field cell/Structure; arithmetic and a call
# create a result cell only where a receiving boundary needs an address. Arithmetic's intermediate ints stay local.
fn: lmx_graph_eval_value (@: g c.LmxGraph; @: scope c.Lmx; @: raw void; @@: out void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: expression c.Lmx 0
    @: value void raw
    @: word char 0
    size_t: count 0U
    int: kind (cast: (int) c.lmx_graph_kind(g, raw))
    int: number 0
    int: status 0
    if: out = 0 || kind = 0
        return: 2
    if: kind = 2
        value := lmx_graph_operand_name(g, scope, c.lmx_graph_word_text(g, raw))
        if: value = 0
            return: 3
        ---
    else:
        if: kind = 4 && c.lmx_graph_name_of(g, raw) != 0
            # A Frame: merge builds a new Structure from its operands (the book, composition; lmx_graph_eval_merge); any
            # other is the application of its head, an int result in a new cell.
            if: c.lmx_graph_name_of(g, raw) = state\w_merge
                return: lmx_graph_eval_merge(g, scope, (cast: (@: c.Lmx) raw), out)
            status := lmx_graph_eval_number(g, scope, raw, @ number)
            if: status != 0
                return: status
            value := c.lmx_graph_int(g, number)
            if: value = 0
                return: 4
            ---
        else:
            if: kind = 4 && lmx_graph_group_expression(g, scope, raw) != 0
                expression := (cast: (@: c.Lmx) raw)
                count := c.lmx_graph_count(expression)
                word := c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 1U))
                # The index of a Structure, `base[index]` (the book, structure-index): the base's value and the index's
                # number, then the kernel's read of the slot -- an untyped reference to what the slot holds.
                if: count = 3U && word = state\w_index
                    status := lmx_graph_eval_value(g, scope, c.lmx_graph_get(expression, 0U), @ value)
                    if: status != 0
                        return: status
                    status := lmx_graph_eval_number(g, scope, c.lmx_graph_get(expression, 2U), @ number)
                    if: status != 0
                        return: status
                    return: c.lmx_graph_index(g, value, number, out)
                if: count = 3U && word = state\w_deref
                    status := lmx_graph_eval_value(g, scope, c.lmx_graph_get(expression, 0U), @ value)
                    if: status != 0
                        return: status
                    # The path step, through an atom too (lmx_graph_step; plan M11 5a).
                    status := lmx_graph_step(g, value, c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 2U)), @ value)
                    if: status != 0
                        return: status
                    ---
                else:
                    word := c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 0U))
                    if: count = 2U && word = state\w_at
                        value := c.lmx_graph_get(expression, 1U)
                        if: c.lmx_graph_kind(g, value) = 2
                            value := lmx_graph_resolve(g, scope, c.lmx_graph_word_text(g, value))
                            status := 0
                            if: value = 0
                                status := 3
                            ---
                        else:
                            status := lmx_graph_eval_value(g, scope, value, @ value)
                        ---
                        if: status != 0
                            return: status
                        if: c.lmx_graph_kind(g, value) = 3
                            value := c.lmx_arena_pointer_void_read(value)
                        value := c.lmx_graph_ref_int(g, value)
                        if: value = 0
                            return: 4
                        ---
                    else:
                        if: count = 1U
                            return: lmx_graph_eval_value(g, scope, c.lmx_graph_get(expression, 0U), out)
                        status := lmx_graph_eval_number(g, scope, raw, @ number)
                        if: status != 0
                            return: status
                        value := c.lmx_graph_int(g, number)
                        if: value = 0
                            return: 4
                        ---
                    ---
                ---
            ---
        ---
    ---
    out[0] := value
    return: 0
end: lmx_graph_eval_value

# Consume the nested expression itself. No precedence parser or saved expression plan exists in either consumer.
fn: lmx_graph_eval_number (@: g c.LmxGraph; @: scope c.Lmx; @: raw void; @: out int) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: expression c.Lmx 0
    @: value void raw
    @: word char 0
    size_t: count 0U
    int: kind (cast: (int) c.lmx_graph_kind(g, raw))
    int: left 0
    int: right 0
    int: status 0
    if: kind = 2
        return: lmx_graph_named_int(g, scope, c.lmx_graph_word_text(g, raw), out)
    if: kind != 4
        return: c.lmx_graph_value_int(g, value, out)
    expression := (cast: (@: c.Lmx) raw)
    count := c.lmx_graph_count(expression)
    word := c.lmx_graph_name_of(g, raw)
    if: word != 0
        # The receiver typeof (the book, get-type): the type of the region of the arena that holds the address its one
        # argument stands for (lmx_graph_address_type). A written zero is the null address, which no region holds.
        if: word = state\w_typeof
            if: count != 1U
                return: 5
            value := c.lmx_graph_get(expression, 0U)
            if: c.lmx_graph_kind(g, value) = 1 && c.lmx_graph_name_of(g, value) = 0 && c.lmx_int_value_known(value) = 0
                out[0] := c.LMX_TYPE_NONE
                return: 0
            status := lmx_graph_eval_value(g, scope, value, @ value)
            if: status != 0
                return: status
            return: c.lmx_graph_address_type(g, value, out)
        # The receiver length (the book, structure-index): the number of the fields of the Structure its one argument
        # stands for (lmx_graph_length).
        if: word = state\w_length
            if: count != 1U
                return: 5
            status := lmx_graph_eval_value(g, scope, c.lmx_graph_get(expression, 0U), @ value)
            if: status != 0
                return: status
            return: c.lmx_graph_length(g, value, out)
        # The receiver fncall (the book, call-receivers): the launch of the code it is given, with its result.
        if: word = state\w_fncall
            return: lmx_graph_eval_fncall(g, scope, expression, out)
        # A Frame in an operand position: the application of the callable its head names (directly or through a
        # reference to it), once; a merge or another head gives no int here.
        value := c.lmx_graph_target(g, lmx_graph_resolve(g, scope, word))
        if: c.lmx_graph_method(g, (cast: (@: c.Lmx) value)) != 0
            if: c.lmx_graph_has_result(g, (cast: (@: c.Lmx) value)) = 0
                return: 5
            return: lmx_graph_eval_call(g, scope, expression, (cast: (@: c.Lmx) value), out)
        ---
        if: word = state\w_merge || lmx_graph_language_word(state, word) != 0
            return: 2
        # The record that launches an ordinary Structure, directly or through a reference place: the launch gives no
        # result (R22), so the record in an operand position answers 5, as a launch by fncall of code without one.
        if: c.lmx_graph_kind(g, value) = 4
            return: 5
        if: value = 0
            return: 3
        return: 2
    word := c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 1U))
    # A field path gives the int of its place; the index of a Structure gives an address, which has no int (answer 1).
    if: count = 3U && (word = state\w_deref || word = state\w_index)
        status := lmx_graph_eval_value(g, scope, raw, @ value)
        if: status != 0
            return: status
        return: c.lmx_graph_value_int(g, value, out)
    if: count = 3U && (word = state\w_plus || word = state\w_minus || word = state\w_star || word = state\w_slash || word = state\w_percent || word = state\w_eq || word = state\w_ne || word = state\w_lt || word = state\w_le || word = state\w_gt || word = state\w_ge || word = state\w_and || word = state\w_or)
        status := lmx_graph_eval_number(g, scope, c.lmx_graph_get(expression, 0U), @ left)
        if: status != 0
            return: status
        if: (word = state\w_and && left = 0) || (word = state\w_or && left != 0)
            out[0] := (cast: (int) (left != 0))
            return: 0
        status := lmx_graph_eval_number(g, scope, c.lmx_graph_get(expression, 2U), @ right)
        if: status != 0
            return: status
        if: word = state\w_plus
            left := left + right
        if: word = state\w_minus
            left := left - right
        if: word = state\w_star
            left := left * right
        if: word = state\w_slash || word = state\w_percent
            if: right = 0
                return: 6
            if: word = state\w_slash
                left := left / right
            else:
                left := left % right
            ---
        ---
        if: word = state\w_eq
            left := (cast: (int) (left = right))
        if: word = state\w_ne
            left := (cast: (int) (left != right))
        if: word = state\w_lt
            left := (cast: (int) (left < right))
        if: word = state\w_le
            left := (cast: (int) (left <= right))
        if: word = state\w_gt
            left := (cast: (int) (left > right))
        if: word = state\w_ge
            left := (cast: (int) (left >= right))
        if: word = state\w_and
            left := (cast: (int) (left && right))
        if: word = state\w_or
            left := (cast: (int) (left || right))
        out[0] := left
        return: 0
    word := c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 0U))
    if: count = 2U && (word = state\w_plus || word = state\w_minus || word = state\w_not)
        status := lmx_graph_eval_number(g, scope, c.lmx_graph_get(expression, 1U), out)
        if: status = 0 && word = state\w_minus
            out[0] := 0 - out[0]
        if: status = 0 && word = state\w_not
            out[0] := (cast: (int) (out[0] = 0))
        return: status
    if: count = 2U && word = state\w_deref
        status := lmx_graph_eval_value(g, scope, c.lmx_graph_get(expression, 1U), @ value)
        if: status != 0
            return: status
        if: c.lmx_graph_kind(g, value) != 5
            return: 2
        return: c.lmx_graph_value_int(g, c.lmx_arena_pointer_void_read(value), out)
    if: count = 1U
        return: lmx_graph_eval_number(g, scope, c.lmx_graph_get(expression, 0U), out)
    return: 2
end: lmx_graph_eval_number

# A receiving expression occupies one field: the builder has already put every operation into its ordinary Lmx.
fn: lmx_graph_eval (@: g c.LmxGraph; @: scope c.Lmx; @: expr c.Lmx; size_t: from; size_t: to; @: out int) int
    if: g = 0 || scope = 0 || expr = 0 || out = 0 || to != from + 1U
        return: 2
    return: lmx_graph_eval_number(g, scope, c.lmx_graph_get(expr, from), out)
end: lmx_graph_eval

# One statement of the root: the Frame at slot index, a statement of the language or the application of a callable
# (lmx_graph_space_reach answered 0). `int: name expression` publishes the value in a new int cell named name in that
# slot; `@: name value` and `@: name int value` publish a reference place.
fn: lmx_graph_exec_statement (@: g c.LmxGraph; @: root c.Lmx; size_t: index) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: statement c.Lmx (cast: (@: c.Lmx) c.lmx_graph_get(root, index))
    @: head char 0
    @: name char 0
    @: cell void 0
    size_t: n 0U
    int: value 0
    int: r 0
    if: state = 0 || statement = 0
        return: 5
    n := c.lmx_graph_count(statement)
    head := c.lmx_graph_name_of(g, (cast: (@: void) statement))
    if: head = 0
        return: 5
    if: head = state\w_call
        return: lmx_graph_eval_explicit_call(g, root, statement)
    # fncall written as a statement of the root: the launch runs and its result is not used.
    if: head = state\w_fncall
        return: lmx_graph_eval_fncall(g, root, statement, @ value)
    # The unit's C-door declarations (`include: "<stdio.h>"`, `predef: "l2src/x.h.lm1"`) stand: they tell a
    # translation which C headers and generated declarations the unit's machine code uses; the root runs nothing for them.
    if: head = state\w_include || head = state\w_predef
        return: 0
    # A declaration of fn or sub with written arguments created its Structure when the traversal began; the receiver
    # applied to arguments the traversal computes creates it now (lmx_graph_fn_apply).
    if: head = state\w_fn || head = state\w_sub
        return: lmx_graph_fn_apply(g, root, index)
    if: head = state\w_fm
        return: 5
    cell := lmx_graph_resolve(g, root, head)
    # A head naming a callable, directly or through a reference to it, applies it (the book :454, :1237).
    if: c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_target(g, cell))) != 0
        return: lmx_graph_eval_call(g, root, statement, (cast: (@: c.Lmx) c.lmx_graph_target(g, cell)), @ value)
    # A head that is a reference place to an ordinary Structure launches it (lmx_graph_launch_head; R22: a record on a
    # place head is never a declaration, so the root executes it now).
    cell := lmx_graph_launch_head(g, root, head)
    if: cell != 0
        return: lmx_graph_eval_launch_record(g, root, statement, cell)
    if: n < 1U
        return: 5
    if: head = state\w_at
        # `@: name value` (the book, receiver-args-only): a reference place for the Structure or the callable the value
        # stands for -- a new named reference to that instance (lmx_graph_lmx_ref_of). A place is declared by its
        # receiver; `name: Structure` declares a Structure, it binds no reference.
        if: n = 2U
            name := c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 0U))
            if: name = 0
                return: 5
            r := lmx_graph_eval_value(g, root, c.lmx_graph_get(statement, 1U), @ cell)
            if: r != 0
                return: r
            cell := c.lmx_graph_lmx_ref_of(g, cell)
            if: cell = 0
                return: 4
            return: c.lmx_graph_publish(g, root, index, cell)
        ---
        # The initialized reference form of this int-only slice: @: p int @i. The words stay in the source graph;
        # resolving i belongs to this traversal, and the resulting p is an ordinary primitive pointer value.
        if: n != 3U || c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 1U)) != state\w_int
            return: 5
        name := c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 0U))
        if: name = 0
            return: 5
        r := lmx_graph_eval_value(g, root, c.lmx_graph_get(statement, 2U), @ cell)
        if: r != 0
            return: r
        # The place takes an int reference, or the address an index of a Structure read when it is an int cell's
        # (lmx_graph_int_ref_of).
        cell := c.lmx_graph_int_ref_of(g, cell)
        if: cell = 0
            return: 4
        return: c.lmx_graph_publish(g, root, index, cell)
    if: head = state\w_int
        name := c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 0U))
        if: n < 2U || name = 0
            return: 5
        r := lmx_graph_eval(g, root, statement, 1U, n, @ value)
        if: r != 0
            return: r
        cell := c.lmx_graph_int(g, value)
        if: cell = 0
            return: 4
        return: c.lmx_graph_publish(g, root, index, cell)
    # Any other Frame the root runs is a statement of the language this slice does not execute. A form on a name never
    # comes here: it is a declaration of a Structure or the refused form on a known place (lmx_graph_space_reach) -- no
    # structural form writes a place, `:=` does (lmx_graph_eval_assignment).
    return: 5
end: lmx_graph_exec_statement

# The execution of a root: its fields in order; a field holding a primitive is a value and stands; a field holding an
# unnamed Lmx whose field 0 is a word is a statement and runs; a named Lmx (a data Structure) stands. 0, or the first
# statement's answer.
fn: lmx_graph_run (@: g c.LmxGraph; @: root c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: flow char 0
    int: number 0
    int: status 0
    int: opened 0
    if: g = 0 || root = 0
        return: 5
    status := lmx_graph_space_open(g, root, @ opened)
    if: status != 0
        return: status
    status := lmx_graph_block(g, root, root, 0U, c.lmx_graph_count(root), 1, @ number, @ flow)
    if: status = 0 && flow != 0 && flow != state\w_return
        status := 5
    lmx_graph_space_close(opened)
    return: status
end: lmx_graph_run

# Dispatch the current clean graph. Native uses the existing common nullary call boundary; with no entry the clean
# interpreter gets a fresh activation frame, discarded on return. No previous traversal's bindings are retained.
fn: lmx_graph_call (@: g c.LmxGraph; @: root c.Lmx) int
    c.LmxActivation: activation
    int: value 0
    int: status 0
    int: opened 0
    if: g = 0 || c.lmx_graph_kind(g, (cast: (@: void) root)) != 4
        return: 5
    status := lmx_graph_space_open(g, root, @ opened)
    if: status != 0
        return: status
    if: root\native != 0
        status := c.lmx_call0(g\arena, root, @ value)
    else:
        status := 5
        if: c.lmx_activation_push(g\arena, @ activation, 2, root, 0, 0, 0U, 0) = 0
            status := lmx_graph_run(g, root)
            c.lmx_activation_pop(g\arena, @ activation)
        ---
    ---
    lmx_graph_space_close(opened)
    return: status
end: lmx_graph_call



# The formals the written actuals of a launch record give (the author 2026-11-11: the arguments of every receiver are
# named and given by position or by name, LMX_blog/2026-11-11.md#structure-call-by-name; R22): the record of the
# receiver call or fncall, head its canonical word, or the record that launches an ordinary Structure by name, head 0
# (lmx_graph_eval_launch_record) -- by the contract of the record (lmx_graph_receivers_open) and the one binder
# (lmx_graph_receiver_form_of): by position or by name through `:=`, every formal of the form given. The form depends on
# what is written alone, so a translation binds the record as the interpreter does. formals[i] the name of the formal
# actual i gives -- args, data, return, code --: the caller's array, one per actual. 0; 4 without memory; 5 for no form.
fn: lmx_graph_launch_formals (@: g c.LmxGraph; @: head char; @: expression c.Lmx; @@: formals char) int
    @: space c.LmxGraphSpace c.lmx_graph_space()
    @: key char head
    @: list c.Lmx 0
    @: chosen c.Lmx 0
    @: bindings size_t 0
    size_t: n 0U
    size_t: i 0U
    int: status 0
    if: g = 0 || space = 0 || formals = 0 || c.lmx_graph_kind(g, (cast: (@: void) expression)) != 4
        return: 5
    if: key = 0
        key := c.lmx_graph_intern("()", 2U)
    list := (cast: (@: c.Lmx) c.lmx_graph_space_find((cast: (@: c.Lmx) space\root), key))
    if: c.lmx_graph_kind(g, (cast: (@: void) list)) != 4
        return: 5
    n := c.lmx_graph_count(expression)
    bindings := (cast: (@: size_t) c.calloc(n + 1U, sizeof(size_t)))
    if: bindings = 0
        return: 4
    chosen := lmx_graph_receiver_form_of(g, list, expression, 0, 0, bindings, 0, @ status)
    while: status = 0 && i < n
        formals[i] := c.lmx_graph_slot_name(g, chosen, bindings[i])
        i := i + 1U
    ---
    c.free((cast: (@: void) bindings))
    return: status
end: lmx_graph_launch_formals

# The written value of the actual i of a launch record: the operand of `name := value` (lmx_graph_launch_formals took
# its name), or the actual as written.
fn: lmx_graph_launch_actual (@: g c.LmxGraph; @: expression c.Lmx; size_t: i) @: void
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void c.lmx_graph_get(expression, i)
    if: state != 0 && c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_count((cast: (@: c.Lmx) raw)) = 3U && c.lmx_graph_word_text(g, c.lmx_graph_get((cast: (@: c.Lmx) raw), 0U)) = state\w_assign
        return: c.lmx_graph_get((cast: (@: c.Lmx) raw), 2U)
    return: raw
end: lmx_graph_launch_actual

# An operand of a launch that stands for a Structure -- the arguments, the data, the code: a name, a path, a reference
# place, or an anonymous Structure written in parentheses (R21): such a Structure is itself, as written
# (lmx_graph_merge_literal); any other operand is evaluated (lmx_graph_eval_value). 0 and the value in out, or the answer
# of the evaluation.
fn: lmx_graph_launch_operand (@: g c.LmxGraph; @: scope c.Lmx; @: raw void; @@: out void) int
    if: out = 0
        return: 2
    if: lmx_graph_merge_literal(g, scope, raw) != 0
        out[0] := raw
        return: 0
    return: lmx_graph_eval_value(g, scope, raw, out)
end: lmx_graph_launch_operand

# Does the live launch run code separated from its data -- a callable's code over its data part or data it was given,
# an ordinary Structure's code over data it was given (the roles data and code, the author 2026-11-11)? A Structure
# running over itself does not, nor a root, which runs with no work frame. 1 or 0.
fn: lmx_graph_code_apart (@: g c.LmxGraph) int
    @: activation c.LmxActivation 0
    @: frame c.LmxGraphFrame 0
    if: g = 0 || g\arena = 0
        return: 0
    activation := (cast: (@: c.LmxActivation) g\arena\activation)
    if: activation = 0 || activation\frame = 0
        return: 0
    frame := (cast: (@: c.LmxGraphFrame) activation\frame)
    if: frame\data != frame\code
        return: 1
    return: 0
end: lmx_graph_code_apart

# Does the live launch run the code of a callable -- an fn or sub, interpreted, not the data its initializers run in
# nor an ordinary Structure? 1 or 0.
fn: lmx_graph_callable_code (@: g c.LmxGraph) int
    @: activation c.LmxActivation 0
    if: g = 0
        return: 0
    activation := (cast: (@: c.LmxActivation) g\arena\activation)
    if: activation = 0 || activation\code = 0 || activation\frame = 0
        return: 0
    return: (cast: (int) (c.lmx_graph_method(g, activation\code) != 0))
end: lmx_graph_callable_code

# The ordinary Structure a record whose head is name launches in block scope (the author 2026-11-11,
# LMX_blog/2026-11-11.md#structure-call-by-name; R21, R22). Through a reference place, wherever the record stands: a
# record on a place head is never a declaration. By the Structure's own name, in code separated from its data
# (lmx_graph_code_apart): the code of a callable, code over data it was given. Until plan M11 5g the root of a unit and a
# Structure running over itself do not execute the role of code of a record whose head is an ordinary Structure: there
# the record stays a declaration. The Structure, or 0.
fn: lmx_graph_launch_head (@: g c.LmxGraph; @: scope c.Lmx; @: name char) @: void
    @: raw void 0
    @: target void 0
    if: g = 0 || name = 0
        return: 0
    raw := lmx_graph_resolve(g, scope, name)
    target := c.lmx_graph_target(g, raw)
    if: raw = 0 || c.lmx_graph_kind(g, target) != 4 || c.lmx_graph_method(g, (cast: (@: c.Lmx) target)) != 0
        return: 0
    if: c.lmx_graph_kind(g, raw) != 4 || lmx_graph_code_apart(g) != 0
        return: target
    return: 0
end: lmx_graph_launch_head

# The record that launches an ordinary Structure by name (the author 2026-11-11,
# LMX_blog/2026-11-11.md#structure-call-by-name; R21, R22): `S()` runs S over itself, `S(D)` and `S(data := D)` over
# the data D -- the one argument data, by position or by name, bound by the one binder (lmx_graph_launch_formals: the
# forms [] and [data]; two positional arguments or another name are no form, 5). The data is an operand of a launch
# (lmx_graph_launch_operand) and the launch is the one of the receiver call (lmx_graph_call_data), so data that gives no
# Structure answers as there. 0, or the answer of the launch.
fn: lmx_graph_eval_launch_record (@: g c.LmxGraph; @: scope c.Lmx; @: expression c.Lmx; @: structure void) int
    @@: formals char 0
    @: raw void 0
    @: data void 0
    size_t: count c.lmx_graph_count(expression)
    int: status 0
    formals := (cast: (@@: char) c.calloc(count + 1U, sizeof(@: char)))
    if: formals = 0
        return: 4
    status := lmx_graph_launch_formals(g, 0, expression, formals)
    c.free((cast: (@: void) formals))
    if: status != 0
        return: status
    if: count = 0U
        return: lmx_graph_call_data(g, 0, (cast: (@: c.Lmx) structure), 1)
    raw := lmx_graph_launch_actual(g, expression, 0U)
    status := lmx_graph_launch_operand(g, scope, raw, @ data)
    if: status != 0
        return: status
    return: lmx_graph_call_data(g, (cast: (@: c.Lmx) data), (cast: (@: c.Lmx) structure), 0)
end: lmx_graph_eval_launch_record

# The receiver call (the book, call-receivers; the author 2026-11-11): the actual code and data are selected when the
# call runs. Its forms (lmx_graph_receivers_open) are bound by the one binder, by position or by name through `:=`
# (lmx_graph_launch_formals; R22): [args data code] is the launch without a result by its parts (lmx_graph_launch);
# [code] is the code alone -- an ordinary Structure runs over itself as its data, a callable over its own data; [data
# code] runs the code over the data: the data stands before the code (the author 2026-11-11,
# LMX_blog/2026-11-11.md#data-before-code; formerly the sources wrote `call: code data`). The operands are evaluated in
# the order they are written (lmx_graph_launch_operand).
fn: lmx_graph_eval_explicit_call (@: g c.LmxGraph; @: scope c.Lmx; @: expression c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @@: formals char 0
    @: head char 0
    @: raw void 0
    @: code void 0
    @: data void 0
    @: args void 0
    @: value void 0
    size_t: count c.lmx_graph_count(expression)
    size_t: i 0U
    int: parts 0
    int: given 0
    int: status 0
    if: state = 0
        return: 5
    formals := (cast: (@@: char) c.calloc(count + 1U, sizeof(@: char)))
    if: formals = 0
        return: 4
    head := state\w_call
    status := lmx_graph_launch_formals(g, head, expression, formals)
    while: status = 0 && i < count
        raw := lmx_graph_launch_actual(g, expression, i)
        status := lmx_graph_launch_operand(g, scope, raw, @ value)
        if: formals[i] = state\w_args
            args := value
            parts := 1
        ---
        if: formals[i] = state\w_data
            data := value
            given := 1
        ---
        if: formals[i] = state\w_code
            code := value
        i := i + 1U
    ---
    c.free((cast: (@: void) formals))
    if: status != 0
        return: status
    if: parts != 0
        if: args = 0 || data = 0 || code = 0
            return: 5
        return: lmx_graph_launch(g, (cast: (@: c.Lmx) args), (cast: (@: c.Lmx) data), 0, (cast: (@: c.Lmx) code), 0)
    ---
    if: given != 0
        return: lmx_graph_call_data(g, (cast: (@: c.Lmx) data), (cast: (@: c.Lmx) code), 0)
    return: lmx_graph_call_data(g, 0, (cast: (@: c.Lmx) code), 1)
end: lmx_graph_eval_explicit_call

# The data and the code of a launch by the receiver call, in the order of the form: the data before the code. With
# shorthand set (the one-argument form) no data is given and the code selects it.
fn: lmx_graph_call_data (@: g c.LmxGraph; @: given_data c.Lmx; @: given_code c.Lmx; int: shorthand) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    # A reference to a Structure or a callable stands for its target as the code or the data (lmx_graph_target).
    @: code c.Lmx (cast: (@: c.Lmx) c.lmx_graph_target(g, (cast: (@: void) given_code)))
    @: data c.Lmx (cast: (@: c.Lmx) c.lmx_graph_target(g, (cast: (@: void) given_data)))
    c.LmxActivation: activation
    c.LmxGraphFrame: frame
    @: returned void 0
    int: number 0
    int: status 0
    if: state = 0 || c.lmx_graph_kind(g, (cast: (@: void) code)) != 4
        return: 5
    if: shorthand != 0
        if: c.lmx_graph_method(g, code) != 0
            data := c.lmx_graph_method_data(g, code)
        else:
            # One argument (the book, call-receivers): an ordinary Structure runs over itself as its data. Its `data`
            # child is not selected for it; when that child is the data it is passed explicitly.
            data := code
        ---
    ---
    if: c.lmx_graph_kind(g, (cast: (@: void) data)) != 4
        return: 5
    # Callable arguments retain their own contract; this explicit nullary form has no actual arguments.
    if: c.lmx_graph_method(g, code) != 0
        return: lmx_graph_invoke_data(g, code, data, 0, 0U, 0, @ number)
    status := lmx_graph_work_flush(g)
    if: status != 0
        return: status
    if: code\native != 0
        return: c.lmx_call_prim(g\arena, code, data, 0, 0U, (cast: (@: void) @ number), @ returned)
    status := c.lmx_activation_push(g\arena, @ activation, 2, code, 0, 0, 0U, 0)
    if: status = 0
        status := lmx_graph_work_open_data(g, code, data, @ frame)
        if: status = 0
            status := lmx_graph_method_run(g, code, @ number)
            status := lmx_graph_work_finish(g, @ frame, status)
        ---
        c.lmx_activation_pop(g\arena, @ activation)
    ---
    return: status
end: lmx_graph_call_data

# The launch of code over data by its parts (the book, call-receivers; the author 2026-11-11): the receivers call and
# fncall give them -- the Structure of the arguments (0 for none), the data (0 for none), the canonical word of the
# description of the result (0 for a launch without one) and the code. A reference stands for its target. The formals
# of the launch are the fields of the arguments, each with its value: an int place gives this launch an independent
# cell, a reference place is passed as it is; a place without a value has no input and any other field is not a
# formal of this subset (5). An ordinary Structure is its own code; a callable given as code runs its code part. With
# no data an ordinary Structure runs over itself and a callable over its own data. A callable given without arguments
# keeps its own contract and its own entry (lmx_graph_invoke_data). Data is not completed for the launch: it must have
# every place the code declares or uses (lmx_graph_work_require) -- only fn, sub and catch complete their data, when
# the graph is built. The result of this subset is an int, so its description must be the word int
# (lmx_graph_call_shape); a launch with a result must return one. 0 and the result in out, or the interpreter's answer.
fn: lmx_graph_launch (@: g c.LmxGraph; @: given_args c.Lmx; @: given_data c.Lmx; @: result char; @: given_code c.Lmx; @: out int) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: code c.Lmx (cast: (@: c.Lmx) c.lmx_graph_target(g, (cast: (@: void) given_code)))
    @: args c.Lmx (cast: (@: c.Lmx) c.lmx_graph_target(g, (cast: (@: void) given_args)))
    @: data c.Lmx (cast: (@: c.Lmx) c.lmx_graph_target(g, (cast: (@: void) given_data)))
    @: model c.Lmx 0
    @: body c.Lmx 0
    @: field void 0
    @@: refs void 0
    c.LmxActivation: activation
    c.LmxGraphFrame: frame
    size_t: width 0U
    size_t: i 0U
    int: kind 0
    int: has 0
    int: number 0
    int: status 0
    if: state = 0 || c.lmx_graph_kind(g, (cast: (@: void) code)) != 4
        return: 5
    if: given_args != 0 && c.lmx_graph_kind(g, (cast: (@: void) args)) != 4
        return: 5
    if: given_data != 0 && c.lmx_graph_kind(g, (cast: (@: void) data)) != 4
        return: 5
    if: result != 0
        if: result != state\w_int || out = 0
            return: 5
        has := 1
    ---
    body := code
    if: c.lmx_graph_method(g, code) != 0
        if: has != c.lmx_graph_has_result(g, code) && (has != 0 || given_args != 0)
            return: 5
        model := c.lmx_graph_method_data(g, code)
        if: data = 0
            data := model
        if: given_args = 0
            status := lmx_graph_invoke_data(g, code, data, 0, 0U, 0, @ number)
            if: status = 0 && has != 0
                out[0] := number
            return: status
        body := c.lmx_graph_method_code(g, code)
    ---
    if: data = 0
        data := code
    width := c.lmx_graph_count(args)
    refs := (cast: (@@: void) c.calloc(width + 1U, sizeof(@: void)))
    if: refs = 0
        return: 4
    while: i < width && status = 0
        field := c.lmx_graph_get(args, i)
        kind := c.lmx_graph_kind(g, field)
        if: kind = 1
            refs[i] := c.lmx_graph_int(g, c.lmx_int_value_known(field))
            if: refs[i] = 0
                status := 4
            ---
        else:
            if: kind = 6
                refs[i] := field
            else:
                status := 5
            ---
        ---
        i := i + 1U
    ---
    if: status = 0
        status := lmx_graph_work_flush(g)
    if: status = 0
        status := c.lmx_activation_push(g\arena, @ activation, 2, code, refs, 0, width, 0)
        if: status = 0
            status := lmx_graph_work_open_parts(g, code, args, data, model, body, has, @ frame)
            if: status = 0
                status := lmx_graph_method_run(g, code, @ number)
                status := lmx_graph_work_finish(g, @ frame, status)
            ---
            c.lmx_activation_pop(g\arena, @ activation)
        ---
    ---
    c.free((cast: (@: void) refs))
    if: status = 0 && has != 0
        out[0] := number
    return: status
end: lmx_graph_launch

# The receiver fncall (the book, call-receivers; the author 2026-11-11): the launch of code that returns a result. Its
# forms (lmx_graph_receivers_open) are bound by the one binder, by position or by name through `:=`
# (lmx_graph_launch_formals; R22): `fncall(args data return code)`, `fncall(data return code)`, `fncall(return code)`.
# The arguments, the data and the code are operands of a launch (lmx_graph_launch_operand); the description is a word of
# the language written as it is (`int`) or a value that holds one (the return part of a callable, `f\return`). The
# operands are evaluated in the order they are written, each received before the next. 0 and the result in out.
fn: lmx_graph_eval_fncall (@: g c.LmxGraph; @: scope c.Lmx; @: expression c.Lmx; @: out int) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @@: formals char 0
    @: head char 0
    @: args void 0
    @: data void 0
    @: code void 0
    @: raw void 0
    @: value void 0
    @: described void 0
    @: result char 0
    size_t: count c.lmx_graph_count(expression)
    size_t: i 0U
    int: status 0
    if: state = 0 || out = 0
        return: 5
    formals := (cast: (@@: char) c.calloc(count + 1U, sizeof(@: char)))
    if: formals = 0
        return: 4
    head := state\w_fncall
    status := lmx_graph_launch_formals(g, head, expression, formals)
    while: status = 0 && i < count
        raw := lmx_graph_launch_actual(g, expression, i)
        if: formals[i] = state\w_return
            raw := lmx_graph_description_value(g, raw)
            result := c.lmx_graph_word_text(g, raw)
            if: result = 0 || lmx_graph_language_word(state, result) = 0
                status := lmx_graph_eval_value(g, scope, raw, @ described)
                result := c.lmx_graph_word_text(g, described)
            ---
            if: status = 0 && result = 0
                status := 5
            ---
        else:
            value := 0
            status := lmx_graph_launch_operand(g, scope, raw, @ value)
            if: status = 0 && value = 0 && formals[i] != state\w_code
                status := 5
            if: formals[i] = state\w_args
                args := value
            if: formals[i] = state\w_data
                data := value
            if: formals[i] = state\w_code
                code := value
        ---
        i := i + 1U
    ---
    c.free((cast: (@: void) formals))
    if: status != 0
        return: status
    if: code = 0
        return: 5
    return: lmx_graph_launch(g, (cast: (@: c.Lmx) args), (cast: (@: c.Lmx) data), result, (cast: (@: c.Lmx) code), out)
end: lmx_graph_eval_fncall

# ---- merge in the clean graph (the book, composition and whole-arguments; kernel §6.4) -----------------------------
# The author 2026-11-08 (LMX_blog/2026-11-08.md): a head naming a function is applied once and its result is the
# operand -- a slot of the model never intercepts the call; a Frame whose head names no function describes a structure.
# Operands are evaluated once, left to right, by their general meaning; their composition is one kernel operation
# (lmx_graph_merge_values) shared by the interpreter and native code.

# A word of the language: the state's words, none of which names a place.
fn: lmx_graph_language_word (@: state c.LmxGraphState; @: word char) int
    if: state = 0 || word = 0
        return: 0
    if: word = state\w_int || word = state\w_plus || word = state\w_minus || word = state\w_star || word = state\w_slash || word = state\w_percent || word = state\w_at || word = state\w_deref || word = state\w_fn || word = state\w_sub || word = state\w_assign || word = state\w_return || word = state\w_call || word = state\w_data
        return: 1
    if: word = state\w_eq || word = state\w_ne || word = state\w_lt || word = state\w_le || word = state\w_gt || word = state\w_ge || word = state\w_and || word = state\w_or || word = state\w_not || word = state\w_if || word = state\w_else || word = state\w_while || word = state\w_for || word = state\w_break
        return: 1
    if: word = state\w_continue || word = state\w_redo || word = state\w_until || word = state\w_finally || word = state\w_merge || word = state\w_include || word = state\w_predef || word = state\w_fm || word = state\w_typeof
        return: 1
    if: word = state\w_index || word = state\w_length || word = state\w_fncall || word = state\w_node
        return: 1
    return: 0
end: lmx_graph_language_word

# A written field of an anonymous Structure in this subset, by its form only: a declaration of a place by its receiver
# (the book, receiver-args-only) -- `int: name value` or `int: name` (2), `@: name int value` (3). Its name word and
# value (0 for none) in the outs; 0 for any other form. A field `name: tail` is no field of this subset: it declares a
# Structure name inside the written one (the book, colon-declares), no place (lmx_graph_merge_description).
fn: lmx_graph_literal_field (@: g c.LmxGraph; @: raw void; @@: name char; @@: value void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: field c.Lmx 0
    @: head char 0
    size_t: n 0U
    int: kind 0
    name[0] := 0
    value[0] := 0
    if: g = 0 || state = 0
        return: 0
    kind := c.lmx_graph_kind(g, raw)
    # A declaration of an int place in the Structure is that place (§3.2): `int: name value` or `int: name`.
    if: kind = 1 || kind = 3
        if: kind = 3
            name[0] := c.lmx_graph_name_of(g, c.lmx_arena_pointer_void_read(raw))
        else:
            name[0] := c.lmx_graph_name_of(g, raw)
            value[0] := raw
        ---
        if: name[0] = 0 || lmx_graph_language_word(state, name[0]) != 0
            return: 0
        return: 2
    if: kind != 4
        return: 0
    field := (cast: (@: c.Lmx) raw)
    n := c.lmx_graph_count(field)
    head := c.lmx_graph_name_of(g, raw)
    if: head = state\w_int
        if: n != 1U && n != 2U
            return: 0
        name[0] := c.lmx_graph_word_text(g, c.lmx_graph_get(field, 0U))
        if: name[0] = 0 || lmx_graph_language_word(state, name[0]) != 0
            return: 0
        if: n = 2U
            value[0] := c.lmx_graph_get(field, 1U)
        return: 2
    if: head = state\w_at
        if: n != 3U || c.lmx_graph_word_text(g, c.lmx_graph_get(field, 1U)) != state\w_int
            return: 0
        name[0] := c.lmx_graph_word_text(g, c.lmx_graph_get(field, 0U))
        if: name[0] = 0 || lmx_graph_language_word(state, name[0]) != 0
            return: 0
        value[0] := c.lmx_graph_get(field, 2U)
        return: 3
    return: 0
end: lmx_graph_literal_field

# An anonymous Structure written as an operand of merge (the book, whole-arguments: the inner parentheses form a
# Structure with the field a): an unnamed Lmx all of whose fields are written fields of this subset, the empty one
# included. 1 or 0.
fn: lmx_graph_merge_literal (@: g c.LmxGraph; @: scope c.Lmx; @: raw void) int
    @: literal c.Lmx 0
    @: name char 0
    @: value void 0
    size_t: i 0U
    if: g = 0 || c.lmx_graph_kind(g, raw) != 4 || c.lmx_graph_name_of(g, raw) != 0
        return: 0
    literal := (cast: (@: c.Lmx) raw)
    if: c.lmx_graph_method(g, literal) != 0
        return: 0
    while: i < c.lmx_graph_count(literal)
        if: lmx_graph_literal_field(g, c.lmx_graph_get(literal, i), @ name, @ value) = 0
            return: 0
        i := i + 1U
    ---
    return: 1
end: lmx_graph_merge_literal

# An operand of merge describing a structure: a bare Frame whose head word names no callable, such as `v: 9` for an
# unknown v (the author 2026-11-08: such a Frame may simply describe a structure; expressions are structures in the tree
# too), or an anonymous Structure with such a Frame among its fields, `(v: 9)` -- the Frame declares a Structure v
# inside it (the book, colon-declares), no place. It is that structure, not a supply of a model slot. How its unnamed
# and nested fields compose is the open part asked of the author with the fn/return parts: both consumers refuse it
# with the form answer (5). 1 or 0.
fn: lmx_graph_merge_description (@: g c.LmxGraph; @: scope c.Lmx; @: raw void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: frame c.Lmx 0
    @: field void 0
    @: head char 0
    size_t: i 0U
    if: g = 0 || state = 0 || c.lmx_graph_kind(g, raw) != 4
        return: 0
    frame := (cast: (@: c.Lmx) raw)
    head := c.lmx_graph_name_of(g, raw)
    if: head = 0
        if: c.lmx_graph_method(g, frame) != 0
            return: 0
        while: i < c.lmx_graph_count(frame)
            field := c.lmx_graph_get(frame, i)
            if: c.lmx_graph_kind(g, field) = 4 && c.lmx_graph_name_of(g, field) != 0 && lmx_graph_merge_description(g, scope, field) != 0
                return: 1
            i := i + 1U
        ---
        return: 0
    if: c.lmx_graph_count(frame) < 1U || lmx_graph_language_word(state, head) != 0
        return: 0
    if: c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_target(g, lmx_graph_resolve(g, scope, head)))) != 0
        return: 0
    return: 1
end: lmx_graph_merge_description

# The value of a written anonymous Structure: a new Structure with one place per written field, in order -- each
# declared by its receiver (`int: a 5`, `@: p int @x`; the book, receiver-args-only). A name that already resolves and a
# name repeated in the literal are open in this subset (5). The places come from lmx_graph_merge_literal_put. 0 and the
# Structure in out.
fn: lmx_graph_merge_literal_open (@: g c.LmxGraph; @: scope c.Lmx; @: literal c.Lmx; @@: out void) int
    @: name char 0
    @: other char 0
    @: value void 0
    @: made c.Lmx 0
    size_t: n 0U
    size_t: i 0U
    size_t: j 0U
    int: form 0
    if: out = 0 || lmx_graph_merge_literal(g, scope, (cast: (@: void) literal)) = 0
        return: 5
    out[0] := 0
    n := c.lmx_graph_count(literal)
    while: i < n
        form := lmx_graph_literal_field(g, c.lmx_graph_get(literal, i), @ name, @ value)
        if: lmx_graph_resolve(g, scope, name) != 0
            return: 5
        j := 0U
        while: j < i
            form := lmx_graph_literal_field(g, c.lmx_graph_get(literal, j), @ other, @ value)
            if: other = name
                return: 5
            j := j + 1U
        ---
        i := i + 1U
    ---
    made := c.lmx_graph_lmx(g, 0, n)
    if: made = 0
        return: 4
    out[0] := (cast: (@: void) made)
    return: 0
end: lmx_graph_merge_literal_open

# The place of written field index of the constructed literal, named at its cell: for `int: name value` a new int place
# holding the int of the value (a literal of the code is not shared with a place, §3.2); for `int: name` a place without
# a value; for `@: name int value` a new int reference to the cell the value refers to -- an int reference, or the
# address an index of a Structure read when it is an int cell's (lmx_graph_int_ref_of) --, never the evaluated reference
# itself, which may be another place. 0; 4 for a value the place does not admit, or without memory; 5 for no field of
# this subset.
fn: lmx_graph_merge_literal_put (@: g c.LmxGraph; @: literal c.Lmx; @: made c.Lmx; size_t: index; @: value void) int
    @: name char 0
    @: written void 0
    @: place void 0
    @: cell void 0
    int: form 0
    int: number 0
    if: g = 0 || literal = 0 || made = 0 || index >= c.lmx_graph_count(literal) || index >= c.lmx_graph_count(made)
        return: 5
    form := lmx_graph_literal_field(g, c.lmx_graph_get(literal, index), @ name, @ written)
    if: form = 0
        return: 5
    if: written = 0
        place := c.lmx_graph_uninit_int(g)
        if: place = 0
            return: 4
        cell := c.lmx_arena_pointer_void_read(place)
    else:
        if: form = 3
            if: c.lmx_graph_kind(g, value) = 5
                place := c.lmx_graph_ref_int(g, c.lmx_arena_pointer_void_read(value))
            else:
                place := c.lmx_graph_int_ref_of(g, value)
            ---
            cell := place
        else:
            if: c.lmx_graph_value_int(g, value, @ number) != 0
                return: 4
            place := c.lmx_graph_int(g, number)
            cell := place
        ---
    ---
    if: place = 0 || cell = 0 || c.lmx_graph_name_address(g, cell, name) != 0 || c.lmx_graph_put(made, index, place) != 0
        return: 4
    return: 0
end: lmx_graph_merge_literal_put

# The used graph of the operands admits the copy: int places, int references, written names (word primitives),
# Structures -- callables included --, references to them and empty slots; another primitive kind is open (5). A written
# name or a callable resolves names through its lexical chain, so then chain is 1 and the copy takes the needed lexical
# ancestors along. 4 for an operand that is no Structure, or without memory. The visited set is this check's.
fn: lmx_graph_merge_check (@: g c.LmxGraph; @@: values void; size_t: n; @: chain int) int
    @@: seen c.Lmx 0
    @: current c.Lmx 0
    @: value void 0
    size_t: count 0U
    size_t: cap 0U
    size_t: at 0U
    size_t: i 0U
    int: kind 0
    int: status 0
    chain[0] := 0
    while: i < n && status = 0
        kind := c.lmx_graph_kind(g, values[i])
        if: kind != 4
            status := 4
        else:
            if: c.lmx_graph_scan_add(@ seen, @ count, @ cap, (cast: (@: c.Lmx) values[i])) != 0
                status := 4
            ---
        ---
        i := i + 1U
    ---
    while: at < count && status = 0
        current := seen[at]
        at := at + 1U
        if: c.lmx_graph_method(g, current) != 0
            chain[0] := 1
        i := 0U
        while: i < c.lmx_graph_count(current) && status = 0
            value := c.lmx_graph_get(current, i)
            kind := c.lmx_graph_kind(g, value)
            if: kind = 3 || kind = 5
                if: c.lmx_graph_kind(g, c.lmx_arena_pointer_void_read(value)) != 1
                    status := 5
                ---
            else:
                # A reference to a Structure or a callable: its target belongs to the used graph too.
                if: kind = 4 || kind = 6
                    if: c.lmx_graph_scan_add(@ seen, @ count, @ cap, (cast: (@: c.Lmx) c.lmx_graph_target(g, value))) != 0
                        status := 4
                    ---
                else:
                    if: kind = 2
                        chain[0] := 1
                    else:
                        if: kind != 1 && value != 0
                            status := 5
                        ---
                    ---
                ---
            ---
            i := i + 1U
        ---
    ---
    c.free((cast: (@: void) seen))
    return: status
end: lmx_graph_merge_check

# The copy of one value reached by merge through the one map (kernel §6.4): an int place keeps its form (a direct cell;
# a place without a value as its copied cell and a new pointer of the same type), an int reference points at the copy of
# its cell, a reference to an Lmx at the copy of its target (the operand root's copy is R, a cycle meets its copy), a data
# Structure gets a new Lmx of its count whose slots the caller fills from the work list; the copies'
# name rows keep the canonical names. A value already copied answers its copy. 0 and the copy in out; 4 without memory;
# 5 for a kind whose copy is open.
fn: lmx_graph_merge_copy (@: g c.LmxGraph; @: map c.LmxCopyMap; @: value void; @@@: work c.Lmx; @: count size_t; @: cap size_t; @@: out void) int
    @: copy void 0
    @: referent void 0
    @: target void 0
    @: name char 0
    int: kind 0
    int: number 0
    int: status 0
    out[0] := 0
    if: value = 0
        return: 0
    copy := c.lmx_copy_map_get(map, value)
    if: copy != 0
        out[0] := copy
        return: 0
    kind := c.lmx_graph_kind(g, value)
    if: kind = 1
        if: c.lmx_graph_value_int(g, value, @ number) != 0
            return: 4
        copy := c.lmx_graph_int(g, number)
    else:
        if: kind = 3 || kind = 5 || kind = 6
            referent := c.lmx_arena_pointer_void_read(value)
            if: (kind = 6 && c.lmx_graph_kind(g, referent) != 4) || (kind != 6 && c.lmx_graph_kind(g, referent) != 1)
                return: 5
            status := lmx_graph_merge_copy(g, map, referent, work, count, cap, @ target)
            if: status != 0
                return: status
            if: kind = 3
                copy := c.lmx_graph_uninit_int_at(g, target)
            else:
                if: kind = 5
                    copy := c.lmx_graph_ref_int(g, target)
                else:
                    copy := c.lmx_graph_ref_lmx(g, (cast: (@: c.Lmx) target))
                ---
            ---
        else:
            if: kind = 2
                copy := c.lmx_graph_word_of(g, c.lmx_graph_word_text(g, value))
            else:
                # A Structure, a callable included: a new Lmx of its count, filled from the work list. The new Lmx has no
                # native entry; reusing one needs a proven compatible contract (L2 §13), so a copied callable is
                # dispatched by the interpreter.
                if: kind != 4
                    return: 5
                copy := (cast: (@: void) c.lmx_graph_lmx(g, 0, c.lmx_graph_count((cast: (@: c.Lmx) value))))
                if: copy != 0 && c.lmx_graph_scan_add(work, count, cap, (cast: (@: c.Lmx) value)) != 0
                    return: 4
                ---
            ---
        ---
    ---
    if: copy = 0
        return: 4
    name := c.lmx_graph_name_of(g, value)
    if: name != 0 && c.lmx_graph_name_address(g, copy, name) != 0
        return: 4
    if: c.lmx_copy_map_put(map, value, copy) != 0
        return: 4
    out[0] := copy
    return: 0
end: lmx_graph_merge_copy

# A named field of a later operand written into the slot of the result it names, as at an assignment: an int place takes
# the field's int and the same cell is written (§3.2); a word place takes a later word. 4 for a field without an int; 5
# when the slot holds no int or word place (replacing a Structure or a reference slot by another value is open; two
# Structures of data are composed, lmx_graph_merge_level).
fn: lmx_graph_merge_write (@: g c.LmxGraph; @: result c.Lmx; size_t: slot; @: value void) int
    @: word void 0
    @: name char 0
    int: kind c.lmx_graph_kind(g, c.lmx_graph_get(result, slot))
    int: number 0
    # A word place takes the later word: a new word cell named as the place (a word cell holds its spelling, §4).
    if: kind = 2 && c.lmx_graph_kind(g, value) = 2
        name := c.lmx_graph_slot_name(g, result, slot)
        word := c.lmx_graph_word_of(g, c.lmx_graph_word_text(g, value))
        if: word = 0 || (name != 0 && c.lmx_graph_name_address(g, word, name) != 0) || c.lmx_graph_put(result, slot, word) != 0
            return: 4
        return: 0
    if: kind != 1 && kind != 3
        return: 5
    if: c.lmx_graph_value_int(g, value, @ number) != 0
        return: 4
    if: c.lmx_graph_assign_int(g, result, result, slot, number) != 0
        return: 4
    return: 0
end: lmx_graph_merge_write

# A later field that names an int place of the result it does not provide is that place in the one source -> copy map
# (the review of 325): its value answers the result's place and its cell -- the cell behind a place without a value
# included -- the result's cell, so a reference to it reached by the copy goes to the result's place. A source already
# mapped keeps its first copy. 0, or 4 without memory.
fn: lmx_graph_merge_alias (@: g c.LmxGraph; @: map c.LmxCopyMap; @: field void; @: place void) int
    @: cell void field
    @: target void place
    if: c.lmx_graph_kind(g, place) = 3
        target := c.lmx_arena_pointer_void_read(place)
    if: c.lmx_graph_kind(g, field) = 3
        if: c.lmx_copy_map_get(map, field) = 0 && c.lmx_copy_map_put(map, field, place) != 0
            return: 4
        cell := c.lmx_arena_pointer_void_read(field)
    ---
    if: c.lmx_copy_map_get(map, cell) = 0 && c.lmx_copy_map_put(map, cell, target) != 0
        return: 4
    return: 0
end: lmx_graph_merge_alias

# The value a field gives where a receiver consumes a Structure by its parts (§3.3; the contract of merge and of fn,
# not the reading of a form at the root, where `name: value` declares a Structure -- lmx_graph_root_declares): a
# reference answers its target; a part `name: value` whose single field is a value -- a word, an unnamed int, a
# reference, an unnamed Lmx -- answers that value; any other field (a place, a word place, a named Structure of fields)
# answers itself, and so does a part whose single field is an assignment `a := v`: a statement, the body of one
# statement, no value. Whatever made the Structure -- written code, merge, a function a receiver created -- its fields
# are read so (merge, lmx_graph_fn_part).
fn: lmx_graph_field_value (@: g c.LmxGraph; @: value void) @: void
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: field void 0
    int: kind 0
    if: g = 0 || state = 0 || value = 0
        return: value
    if: c.lmx_graph_kind(g, value) = 6
        return: c.lmx_graph_target(g, value)
    if: c.lmx_graph_kind(g, value) != 4 || c.lmx_graph_count((cast: (@: c.Lmx) value)) != 1U
        return: value
    field := c.lmx_graph_get((cast: (@: c.Lmx) value), 0U)
    kind := c.lmx_graph_kind(g, field)
    if: kind = 6
        return: c.lmx_graph_target(g, field)
    if: kind = 4 && c.lmx_graph_name_of(g, field) = 0 && c.lmx_graph_word_text(g, c.lmx_graph_get((cast: (@: c.Lmx) field), 0U)) = state\w_assign
        return: value
    if: kind = 2 || ((kind = 1 || kind = 4) && c.lmx_graph_name_of(g, field) = 0)
        return: field
    return: value
end: lmx_graph_field_value

# One level of merge (lmx_graph_merge_values): the result of the operands values[0..n) through the one map -- its field
# set and its fixed Lmx, the operand roots mapped to it, the int places first, the later fields naming them as those
# places, the other slots by their first source, then the writes of later fields in operand order. Every field is
# taken by its value (lmx_graph_field_value): a slot whose value is a Structure that later operands give again as
# Structures is the composition of those Structures by this same level, recursively, through the same map -- the book,
# composition of the structural parts, for any operands, whatever made them (code, merge, a created function); its
# first model goes to the nested list, so that the caller gives it its parent. 0 and the result in out; 4 or 5 as
# lmx_graph_merge_values.
fn: lmx_graph_merge_level (@: g c.LmxGraph; @: map c.LmxCopyMap; @@@: work c.Lmx; @: count size_t; @: cap size_t; @@@: nested c.Lmx; @: ncount size_t; @: ncap size_t; @@: values void; size_t: n; @@: out void) int
    @@: names char 0
    @@: first void 0
    @@: parts void 0
    @: from_k size_t 0
    @: from_j size_t 0
    @: composed int 0
    @: model c.Lmx 0
    @: operand c.Lmx 0
    @: result c.Lmx 0
    @: copy void 0
    @: held void 0
    @: part void 0
    @: name char 0
    size_t: m 0U
    size_t: room 0U
    size_t: total 0U
    size_t: i 0U
    size_t: j 0U
    size_t: k 0U
    size_t: p 0U
    size_t: slot 0U
    int: kind 0
    int: status 0
    out[0] := 0
    model := (cast: (@: c.Lmx) values[0])
    m := c.lmx_graph_count(model)
    room := m
    k := 1U
    while: k < n
        room := room + c.lmx_graph_count((cast: (@: c.Lmx) values[k]))
        k := k + 1U
    ---
    names := (cast: (@@: char) c.calloc(room + 1U, sizeof(@: char)))
    first := (cast: (@@: void) c.calloc(room + 1U, sizeof(@: void)))
    parts := (cast: (@@: void) c.calloc(n + 1U, sizeof(@: void)))
    from_k := (cast: (@: size_t) c.calloc(room + 1U, sizeof(size_t)))
    from_j := (cast: (@: size_t) c.calloc(room + 1U, sizeof(size_t)))
    composed := (cast: (@: int) c.calloc(room + 1U, sizeof(int)))
    if: names = 0 || first = 0 || parts = 0 || from_k = 0 || from_j = 0 || composed = 0
        c.free((cast: (@: void) names))
        c.free((cast: (@: void) first))
        c.free((cast: (@: void) parts))
        c.free((cast: (@: void) from_k))
        c.free((cast: (@: void) from_j))
        c.free((cast: (@: void) composed))
        return: 4
    # The field set of R before its fixed Lmx, with the field that first provides each slot -- its value and its position
    # (operand, field), local data of this merge: the model's slots, then each named field of a later operand that names no
    # slot so far, in operand order. A later supply is told from the first fill by its position, not by its address: the
    # same source given again later (merge(M; N; M)) is written again in operand order. An unnamed field of a later operand
    # is matched by no name and is open here (5).
    while: i < m
        names[i] := c.lmx_graph_slot_name(g, model, i)
        first[i] := c.lmx_graph_get(model, i)
        from_k[i] := 0U
        from_j[i] := i
        i := i + 1U
    ---
    total := m
    k := 1U
    while: k < n && status = 0
        operand := (cast: (@: c.Lmx) values[k])
        j := 0U
        while: j < c.lmx_graph_count(operand) && status = 0
            name := c.lmx_graph_slot_name(g, operand, j)
            if: name = 0
                status := 5
            else:
                i := 0U
                while: i < total && names[i] != name
                    i := i + 1U
                ---
                if: i = total
                    names[total] := name
                    first[total] := c.lmx_graph_get(operand, j)
                    from_k[total] := k
                    from_j[total] := j
                    total := total + 1U
                ---
            ---
            j := j + 1U
        ---
        k := k + 1U
    ---
    if: status = 0
        result := c.lmx_graph_lmx(g, 0, total)
        if: result = 0
            status := 4
    ---
    k := 0U
    while: k < n && status = 0
        if: c.lmx_copy_map_put(map, values[k], (cast: (@: void) result)) != 0
            status := 4
        k := k + 1U
    ---
    # R's int places first: a slot whose first source is an int place gets its copy.
    i := 0U
    while: i < total && status = 0
        kind := c.lmx_graph_kind(g, first[i])
        if: kind = 1 || kind = 3
            status := lmx_graph_merge_copy(g, map, first[i], work, count, cap, @ copy)
            if: status = 0 && c.lmx_graph_put(result, i, copy) != 0
                status := 4
            ---
        ---
        i := i + 1U
    ---
    # Every later field naming an int place of R it does not provide is that place in the map.
    k := 1U
    while: k < n && status = 0
        operand := (cast: (@: c.Lmx) values[k])
        j := 0U
        while: j < c.lmx_graph_count(operand) && status = 0
            held := c.lmx_graph_get(operand, j)
            slot := c.lmx_graph_named(g, result, c.lmx_graph_slot_name(g, operand, j))
            kind := c.lmx_graph_kind(g, held)
            if: slot < total && (from_k[slot] != k || from_j[slot] != j) && (kind = 1 || kind = 3)
                kind := c.lmx_graph_kind(g, c.lmx_graph_get(result, slot))
                if: kind = 1 || kind = 3
                    status := lmx_graph_merge_alias(g, map, held, c.lmx_graph_get(result, slot))
                ---
            ---
            j := j + 1U
        ---
        k := k + 1U
    ---
    # The other slots by their first source: references, Structures and new fields now reach merged places. A slot whose
    # value is a Structure that later operands give again as Structures is the composition of those Structures by this
    # same level, through the same map (the book, composition of the structural parts: nested parts; `merge(f1; f2)` with
    # a descriptor f2 gives the signature of both and the body of f1); the slot keeps the model's form (a named reference
    # stays one, to the composition; another field is the composition named by it).
    i := 0U
    while: i < total && status = 0
        if: c.lmx_graph_get(result, i) = 0 && first[i] != 0
            p := 0U
            part := lmx_graph_field_value(g, first[i])
            if: c.lmx_graph_kind(g, part) = 4
                parts[0] := part
                p := 1U
                k := 1U
                while: k < n
                    operand := (cast: (@: c.Lmx) values[k])
                    slot := c.lmx_graph_named(g, operand, names[i])
                    if: slot < c.lmx_graph_count(operand) && (from_k[i] != k || from_j[i] != slot)
                        held := lmx_graph_field_value(g, c.lmx_graph_get(operand, slot))
                        if: c.lmx_graph_kind(g, held) = 4
                            parts[p] := held
                            p := p + 1U
                        ---
                    ---
                    k := k + 1U
                ---
            ---
            if: p > 1U
                composed[i] := 1
                status := lmx_graph_merge_level(g, map, work, count, cap, nested, ncount, ncap, parts, p, @ part)
                if: status = 0 && c.lmx_graph_scan_add(nested, ncount, ncap, (cast: (@: c.Lmx) parts[0])) != 0
                    status := 4
                if: status = 0 && c.lmx_graph_kind(g, first[i]) = 6
                    part := c.lmx_graph_ref_lmx(g, (cast: (@: c.Lmx) part))
                    if: part = 0
                        status := 4
                    ---
                ---
                if: status = 0 && names[i] != 0 && c.lmx_graph_name_address(g, part, names[i]) != 0
                    status := 4
                if: status = 0 && c.lmx_graph_put(result, i, part) != 0
                    status := 4
                ---
            else:
                status := lmx_graph_merge_copy(g, map, first[i], work, count, cap, @ copy)
                if: status = 0 && c.lmx_graph_put(result, i, copy) != 0
                    status := 4
            ---
        ---
        i := i + 1U
    ---
    # The writes of later fields into the slots they name but do not provide, in operand order; a composed part was
    # given by its composition.
    k := 1U
    while: k < n && status = 0
        operand := (cast: (@: c.Lmx) values[k])
        j := 0U
        while: j < c.lmx_graph_count(operand) && status = 0
            held := c.lmx_graph_get(operand, j)
            i := 0U
            name := c.lmx_graph_slot_name(g, operand, j)
            while: i < total && names[i] != name
                i := i + 1U
            ---
            # A later field writes the slot by its value (lmx_graph_field_value): an int or a word place takes it as at an
            # assignment; a definition `name: value` of a primitive value is replaced by the later field of one. The slot
            # has the form of its first source (its copy is filled from the work list only after the levels).
            if: i < total && (from_k[i] != k || from_j[i] != j) && composed[i] = 0
                part := lmx_graph_field_value(g, held)
                if: c.lmx_graph_kind(g, first[i]) = 4 && c.lmx_graph_kind(g, lmx_graph_field_value(g, first[i])) != 4 && c.lmx_graph_kind(g, part) != 4
                    status := lmx_graph_merge_copy(g, map, held, work, count, cap, @ copy)
                    if: status = 0 && c.lmx_graph_put(result, i, copy) != 0
                        status := 4
                    ---
                else:
                    status := lmx_graph_merge_write(g, result, i, part)
                ---
            ---
            j := j + 1U
        ---
        k := k + 1U
    ---
    c.free((cast: (@: void) names))
    c.free((cast: (@: void) first))
    c.free((cast: (@: void) parts))
    c.free((cast: (@: void) from_k))
    c.free((cast: (@: void) from_j))
    c.free((cast: (@: void) composed))
    if: status = 0
        out[0] := (cast: (@: void) result)
    return: status
end: lmx_graph_merge_level

# merge of evaluated operands (the book, composition; L2 §13; kernel §6.4). The result R has the layout of the model
# (operand 0), then the new fields in operand order; a named field of a later operand naming a slot of R is written into
# that slot by the admission of an assignment, any other is appended, so the model's field numbers do not move. One
# source -> copy map serves all operands: every operand root maps to R (the instance obtained by copying and
# composition), shared targets and cycles stay shared, the copies' name rows keep the canonical names, and a copied
# Structure's parent is the copy of its parent where that was copied. The order makes merged places one place: R's int
# places are copied first, then every later field naming one of them is that place in the map (lmx_graph_merge_alias),
# and only then are references, Structures and new fields copied, so a reference reaches R's place in any field order.
# A copy with written names or callables takes their needed lexical ancestors along, whole, through the same map up to
# parent 0, and R's parent is the copy of the model's parent; a copy without them resolves no name through a parent, so R
# has none (parent 0, which is no arena-root object). The place of execution never gives one. The operands stay
# unchanged. Corresponding Structure parts of the operands are composed recursively by the same rules and the same map
# (lmx_graph_merge_level), whatever made the operands. 0 and R in out; 4 for an operand that is no Structure or a refused
# write; 5 for an open form.
fn: lmx_graph_merge_values (@: g c.LmxGraph; @@: values void; size_t: n; @@: out void) int
    c.LmxCopyMap: map
    @@: work c.Lmx 0
    @@: nested c.Lmx 0
    @: model c.Lmx 0
    @: operand c.Lmx 0
    @: result c.Lmx 0
    @: child c.Lmx 0
    @: copy void 0
    @: name char 0
    size_t: count 0U
    size_t: cap 0U
    size_t: ncount 0U
    size_t: ncap 0U
    size_t: at 0U
    size_t: i 0U
    size_t: j 0U
    int: mapped 0
    int: chain 0
    int: status 0
    if: g = 0 || values = 0 || out = 0 || n = 0U
        return: 5
    out[0] := 0
    # An operand that is a reference to a Structure or a callable stands for its target, in both consumers (the operand
    # array is this evaluation's).
    while: i < n
        values[i] := c.lmx_graph_target(g, values[i])
        i := i + 1U
    ---
    status := lmx_graph_merge_check(g, values, n, @ chain)
    if: status != 0
        return: status
    model := (cast: (@: c.Lmx) values[0])
    if: c.lmx_copy_map_init(@ map) != 0
        return: 4
    mapped := 1
    status := lmx_graph_merge_level(g, @ map, @ work, @ count, @ cap, @ nested, @ ncount, @ ncap, values, n, @ copy)
    result := (cast: (@: c.Lmx) copy)
    # One operand: R is the copy of that root, so a named root's copy keeps its name row with the same name pointer
    # (kernel §5.1), and a copied lexical ancestor's slot of the root answers that name at R -- the body's own name
    # finds the copy. A new place for R is then a reference to it, `@: R merge(...)`. A composition of several
    # roots is named by what receives it (`fn: new_name merge(f1, f2)`), not here.
    if: status = 0 && n = 1U
        name := c.lmx_graph_name_of(g, values[0])
        if: name != 0 && c.lmx_graph_name_address(g, (cast: (@: void) result), name) != 0
            status := 4
        ---
    ---
    # The lexical chain of a copy with written names or callables: the model's parent, the parent of the model of every
    # composed part and the source parent of every copied Structure are copied too, as ordinary Lmx through the same map,
    # whole -- their fields, references and cycles -- up to parent 0 (the book :1205-1207; kernel §6.4). Not the whole
    # arena: the reachable closure of what is copied. The source's mutable ancestors are never borrowed, and the place of
    # this merge gives no parent.
    if: status = 0 && chain != 0 && model\parent != 0
        status := lmx_graph_merge_copy(g, @ map, (cast: (@: void) model\parent), @ work, @ count, @ cap, @ copy)
    i := 0U
    while: i < ncount && status = 0
        if: chain != 0 && nested[i]\parent != 0
            status := lmx_graph_merge_copy(g, @ map, (cast: (@: void) nested[i]\parent), @ work, @ count, @ cap, @ copy)
        i := i + 1U
    ---
    at := 0U
    while: at < count && status = 0
        operand := work[at]
        child := (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) operand)))
        j := 0U
        while: j < c.lmx_graph_count(operand) && status = 0
            status := lmx_graph_merge_copy(g, @ map, c.lmx_graph_get(operand, j), @ work, @ count, @ cap, @ copy)
            if: status = 0 && c.lmx_graph_put(child, j, copy) != 0
                status := 4
            ---
            j := j + 1U
        ---
        if: status = 0 && chain != 0 && operand\parent != 0
            status := lmx_graph_merge_copy(g, @ map, (cast: (@: void) operand\parent), @ work, @ count, @ cap, @ copy)
        at := at + 1U
    ---
    # Parent edges once every copy exists, a parent reached after its child included. R's parent is the copy of the
    # model's parent when the chain was needed, otherwise none; a composed part's is the copy of its model's parent.
    at := 0U
    while: at < count && status = 0
        operand := work[at]
        child := (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) operand)))
        child\parent := (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) operand\parent)))
        at := at + 1U
    ---
    i := 0U
    while: i < ncount && status = 0
        child := (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) nested[i])))
        if: child != 0
            child\parent := (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) nested[i]\parent)))
        i := i + 1U
    ---
    if: status = 0 && chain != 0
        child := (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) model\parent)))
        if: child != result
            result\parent := child
        ---
    ---
    if: mapped != 0
        c.lmx_copy_map_dispose(@ map)
    c.free((cast: (@: void) work))
    c.free((cast: (@: void) nested))
    if: status = 0
        out[0] := (cast: (@: void) result)
    return: status
end: lmx_graph_merge_values

# One operand of merge, evaluated once in its order: the constructed value of a written anonymous Structure, or any other
# expression in its general meaning -- a name, a path, a nested merge, a call (a head naming a callable is applied once,
# whatever slot the model has). The description of a structure by a bare Frame is open (5). 0 and the value in out.
fn: lmx_graph_merge_operand (@: g c.LmxGraph; @: scope c.Lmx; @: raw void; @@: out void) int
    @: literal c.Lmx 0
    @: made void 0
    @: name char 0
    @: written void 0
    @: value void 0
    size_t: i 0U
    int: form 0
    int: status 0
    out[0] := 0
    if: lmx_graph_merge_literal(g, scope, raw) != 0
        literal := (cast: (@: c.Lmx) raw)
        status := lmx_graph_merge_literal_open(g, scope, literal, @ made)
        while: status = 0 && i < c.lmx_graph_count(literal)
            form := lmx_graph_literal_field(g, c.lmx_graph_get(literal, i), @ name, @ written)
            value := 0
            if: written != 0
                status := lmx_graph_eval_value(g, scope, written, @ value)
            ---
            if: status = 0
                status := lmx_graph_merge_literal_put(g, literal, (cast: (@: c.Lmx) made), i, value)
            ---
            i := i + 1U
        ---
        if: status = 0
            out[0] := made
        ---
        return: status
    if: lmx_graph_merge_description(g, scope, raw) != 0
        return: 5
    return: lmx_graph_eval_value(g, scope, raw, out)
end: lmx_graph_merge_operand

# merge(operand; ...): the operands once, left to right, then their composition. The operand array is this evaluation's.
fn: lmx_graph_eval_merge (@: g c.LmxGraph; @: scope c.Lmx; @: expression c.Lmx; @@: out void) int
    @@: values void 0
    size_t: n 0U
    size_t: i 0U
    int: status 0
    if: g = 0 || out = 0 || c.lmx_graph_count(expression) < 1U
        return: 5
    n := c.lmx_graph_count(expression)
    values := (cast: (@@: void) c.calloc(n + 1U, sizeof(@: void)))
    if: values = 0
        return: 4
    while: i < n && status = 0
        status := lmx_graph_merge_operand(g, scope, c.lmx_graph_get(expression, i), @ values[i])
        i := i + 1U
    ---
    if: status = 0
        status := lmx_graph_merge_values(g, values, n, out)
    c.free((cast: (@: void) values))
    return: status
end: lmx_graph_eval_merge

# For the body scan: the written fields of an anonymous Structure operand of merge define their names, never free inputs
# of the body; a value Lmx joins the scan queue and a value word is a read input.
fn: lmx_graph_work_scan_literal (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: literal c.Lmx; @@@: queue c.Lmx; @: count size_t; @: cap size_t) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: name char 0
    @: written void 0
    @: word char 0
    @: row c.LmxGraphWork 0
    size_t: i 0U
    int: form 0
    int: status 0
    while: i < c.lmx_graph_count(literal) && status = 0
        form := lmx_graph_literal_field(g, c.lmx_graph_get(literal, i), @ name, @ written)
        if: c.lmx_graph_kind(g, written) = 4
            status := c.lmx_graph_scan_add(queue, count, cap, (cast: (@: c.Lmx) written))
        else:
            word := c.lmx_graph_word_text(g, written)
            if: word != 0 && lmx_graph_language_word(state, word) = 0
                status := lmx_graph_work_capture(g, frame, word)
                row := lmx_graph_work_row(frame, word)
                if: status = 0 && row != 0 && row\slot != (cast: (size_t) -1)
                    row\loaded := row\loaded | 2
                ---
            ---
        ---
        i := i + 1U
    ---
    return: status
end: lmx_graph_work_scan_literal

# ---- The receivers fn and sub in a traversal (§3.4, §5.2; the author 2026-11-09) ---------------------------------
# The graph keeps a declaration `fn: name args return [data] code` as written: the Frame of the receiver fn, an Lmx named
# fn with its arguments. Each traversal -- the interpreter's run, a translation, a native run of an emitted program --
# begins with an empty namespace (lmx_graph_space_push) and applies the receiver: the Structure named by the value of
# the name argument with the parts args, return, data, code (sub: args, data, code) is created in this traversal and
# answers its name in the declaration's block. The namespace and its rows are freed at the end of the traversal, and the
# next traversal creates its own Structure from the written declaration; a Structure the program holds by an ordinary
# reference of the graph stays an ordinary live value (§5.2).

# The slot of lmx holding the place named name -- an int place, a place without a value, a reference place (a Frame
# named by its head is no place) --, or the count of its slots when none is.
fn: lmx_graph_place_slot (@: g c.LmxGraph; @: lmx c.Lmx; @: name char) size_t
    size_t: n c.lmx_graph_count(lmx)
    size_t: i 0U
    int: kind 0
    if: g = 0 || name = 0
        return: n
    while: i < n
        kind := c.lmx_graph_kind(g, c.lmx_graph_get(lmx, i))
        if: (kind = 1 || kind = 3 || kind = 5 || kind = 6) && c.lmx_graph_slot_name(g, lmx, i) = name
            return: i
        i := i + 1U
    ---
    return: n
end: lmx_graph_place_slot

# The own fields a body declares (the book :691, :695; the author 2026-11-08: every own field is visible from the first
# line): the names of the int places declared in the body and in its inline control bodies (if, else, while, for,
# until, finally; a for header) -- a place `int: name [literal]` or a Frame `int: name expression` --, never in a nested
# declaration or in the data of a call. Appended to names without duplicates; the list belongs to this construction.
# 0, or 1 without memory.
fn: lmx_graph_fn_own (@: g c.LmxGraph; @: value void; @@@: names char; @: count size_t; @: capacity size_t) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: current c.Lmx 0
    @: head char 0
    @: name char 0
    @@: grown char 0
    size_t: i 0U
    size_t: j 0U
    int: kind c.lmx_graph_kind(g, value)
    int: status 0
    if: kind = 1
        name := c.lmx_graph_name_of(g, value)
    else:
        if: kind = 3
            name := c.lmx_graph_name_of(g, c.lmx_arena_pointer_void_read(value))
        else:
            if: kind != 4
                return: 0
            current := (cast: (@: c.Lmx) value)
            head := c.lmx_graph_name_of(g, value)
            if: head = state\w_int
                name := c.lmx_graph_word_text(g, c.lmx_graph_get(current, 0U))
            else:
                if: head != 0 && head != state\w_if && head != state\w_else && head != state\w_while && head != state\w_for && head != state\w_until && head != state\w_finally
                    return: 0
                while: i < c.lmx_graph_count(current) && status = 0
                    status := lmx_graph_fn_own(g, c.lmx_graph_get(current, i), names, count, capacity)
                    i := i + 1U
                ---
                return: status
            ---
        ---
    ---
    if: name = 0
        return: 0
    while: j < count[0] && names[0][j] != name
        j := j + 1U
    ---
    if: j < count[0]
        return: 0
    if: count[0] = capacity[0]
        grown := (cast: (@@: char) c.realloc((cast: (@: void) names[0]), (capacity[0] * 2U + 8U) * sizeof(@: char)))
        if: grown = 0
            return: 1
        names[0] := grown
        capacity[0] := capacity[0] * 2U + 8U
    ---
    names[0][count[0]] := name
    count[0] := count[0] + 1U
    return: 0
end: lmx_graph_fn_own

# The data of the Structure fn/sub creates: a new Lmx under it, named data, holding the copy of the fields of the written
# data -- through one source -> copy map in which the written data is the new data, so that the places, references and
# Structures of the written data keep their sharing, nesting and cycles in the copy, and the needed lexical ancestors of
# what it reaches come along as in merge (kernel §6.4) -- and then a new place
# without a value for every own field of the body that is no formal and no field of the written data. The set of fields is known before the Lmx is made; no initializer runs here
# (they run at their written places). 0 and the data in out; 1 without memory; 4 or 5 for a written field whose copy is
# refused or open (lmx_graph_merge_copy).
fn: lmx_graph_fn_data (@: g c.LmxGraph; @: owner c.Lmx; @: args c.Lmx; @: written c.Lmx; @: body c.Lmx; @@: out c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    c.LmxCopyMap: map
    @@: work c.Lmx 0
    @@: names char 0
    @: vars c.Lmx 0
    @: copy void 0
    @: child c.Lmx 0
    @: operand c.Lmx 0
    @: place void 0
    @: source void (cast: (@: void) written)
    size_t: capacity 0U
    size_t: explicit 0U
    size_t: own 0U
    size_t: kept 0U
    size_t: wcount 0U
    size_t: wcap 0U
    size_t: at 0U
    size_t: i 0U
    size_t: j 0U
    int: status 0
    int: mapped 0
    int: chain 0
    out[0] := 0
    if: written != 0
        explicit := c.lmx_graph_count(written)
    capacity := explicit + 8U
    names := (cast: (@@: char) c.calloc(capacity, sizeof(@: char)))
    if: names = 0
        return: 1
    # The own fields are those the statements of the body declare, whatever Structure holds them (the body of a written
    # declaration is anonymous; the part code of a prepared Structure is its Frame `code: (...)`).
    while: body != 0 && i < c.lmx_graph_count(body) && status = 0
        status := lmx_graph_fn_own(g, c.lmx_graph_get(body, i), @ names, @ own, @ capacity)
        i := i + 1U
    ---
    i := 0U
    while: i < own && status = 0
        if: c.lmx_graph_formal(g, args, names[i]) >= c.lmx_graph_count(args) && (written = 0 || c.lmx_graph_formal(g, written, names[i]) >= explicit)
            names[kept] := names[i]
            kept := kept + 1U
        ---
        i := i + 1U
    ---
    if: status = 0
        vars := c.lmx_graph_lmx(g, owner, explicit + kept)
        if: vars = 0 || c.lmx_graph_name_address(g, (cast: (@: void) vars), state\w_data) != 0
            status := 1
        ---
    ---
    # The used graph of the written data admits the copy and tells whether it resolves names through a lexical chain
    # (written names or callables), as for merge (lmx_graph_merge_check).
    if: status = 0 && explicit != 0
        status := lmx_graph_merge_check(g, @ source, 1U, @ chain)
        if: status = 4
            status := 1
        ---
    ---
    if: status = 0 && explicit != 0
        if: c.lmx_copy_map_init(@ map) != 0
            status := 1
        else:
            mapped := 1
            # The written data is the new data in the map before any field is copied (as an operand root is its result in
            # lmx_graph_merge_values): a reference to the written data, or a cycle through it, reaches the new data.
            if: c.lmx_copy_map_put(@ map, (cast: (@: void) written), (cast: (@: void) vars)) != 0
                status := 1
            ---
        ---
    ---
    i := 0U
    while: i < explicit && status = 0
        status := lmx_graph_merge_copy(g, @ map, c.lmx_graph_get(written, i), @ work, @ wcount, @ wcap, @ copy)
        if: status = 0 && c.lmx_graph_put(vars, i, copy) != 0
            status := 1
        i := i + 1U
    ---
    while: at < wcount && status = 0
        operand := work[at]
        child := (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) operand)))
        j := 0U
        while: j < c.lmx_graph_count(operand) && status = 0
            status := lmx_graph_merge_copy(g, @ map, c.lmx_graph_get(operand, j), @ work, @ wcount, @ wcap, @ copy)
            if: status = 0 && c.lmx_graph_put(child, j, copy) != 0
                status := 1
            j := j + 1U
        ---
        # A copied Structure whose source parent lies outside the written data -- a Structure the data reaches by a
        # reference -- takes that parent along when the copy resolves names through its chain: the parent is copied
        # through the same map, whole, up to parent 0 (kernel §6.4, as lmx_graph_merge_values); the written data's own
        # place in such a parent is the new data.
        if: status = 0 && chain != 0 && operand\parent != 0
            status := lmx_graph_merge_copy(g, @ map, (cast: (@: void) operand\parent), @ work, @ wcount, @ wcap, @ copy)
        at := at + 1U
    ---
    # Parent edges once every copy exists, as in merge: a copied Structure keeps the nesting of its source -- its parent is
    # the copy of its source's parent, the written data's children the new data's --; a source parent is none only when the
    # copy needs no chain (no written name or callable). The new data itself is under F, whose lexical chain it has.
    at := 0U
    while: at < wcount && status = 0
        operand := work[at]
        child := (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) operand)))
        if: child != 0
            child\parent := (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) operand\parent)))
        at := at + 1U
    ---
    i := 0U
    while: i < kept && status = 0
        place := c.lmx_graph_uninit_int(g)
        if: place = 0 || c.lmx_graph_name_address(g, c.lmx_arena_pointer_void_read(place), names[i]) != 0 || c.lmx_graph_put(vars, explicit + i, place) != 0
            status := 1
        i := i + 1U
    ---
    if: mapped != 0
        c.lmx_copy_map_dispose(@ map)
    c.free((cast: (@: void) work))
    c.free((cast: (@: void) names))
    if: status = 0
        out[0] := vars
    return: status
end: lmx_graph_fn_data

# The Structure the receiver fn or sub creates from its arguments (the author 2026-11-09: in the namespace of the
# traversal the structure name(args(), return(), data(), code()), by the rule by which `int: i 5` creates i): an Lmx of
# the FN pool role (§2.2 lmx:result) under the declaration, named by the value of the name argument, with the fields
# args, return (fn), data and code (none in a descriptor). A Structure part is a reference to that argument, named by the
# part -- the argument keeps its address, parent and namelessness (the reference's name is the reference's); the word of
# a result requirement is its own word cell, as every primitive place has its own cell; data is lmx_graph_fn_data. The
# native entry a translation installed on the declaration is the entry of what it creates (no other native code
# exists: the Structures a running program creates otherwise are interpreted). 0 and the Structure in out; 1 without
# memory; 5 for an argument of another kind.
fn: lmx_graph_fn_make (@: g c.LmxGraph; @: decl c.Lmx; @: name char; @: args c.Lmx; @: result void; @: written c.Lmx; @: body c.Lmx; int: with_result; @@: out c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: made c.Lmx 0
    @: vars c.Lmx 0
    @: part void 0
    size_t: count 2U
    size_t: at 0U
    int: status 0
    out[0] := 0
    if: g = 0 || state = 0 || decl = 0 || name = 0 || c.lmx_graph_kind(g, (cast: (@: void) args)) != 4
        return: 5
    if: (body != 0 && c.lmx_graph_kind(g, (cast: (@: void) body)) != 4) || (written != 0 && c.lmx_graph_kind(g, (cast: (@: void) written)) != 4)
        return: 5
    if: with_result != 0
        count := count + 1U
        if: c.lmx_graph_kind(g, result) != 2 && c.lmx_graph_kind(g, result) != 4
            return: 5
        ---
    ---
    if: body != 0
        count := count + 1U
    made := (cast: (@: c.Lmx) c.lmx_struct_new_role_profiled(decl, g\arena, 0, c.LMX_POOL_ROLE_FN))
    if: made = 0 || c.lmx_arena_refs_open_owned(g\arena, made, count) != 0 || c.lmx_graph_name_address(g, (cast: (@: void) made), name) != 0
        return: 1
    part := c.lmx_graph_ref_lmx(g, args)
    if: part = 0 || c.lmx_graph_name_address(g, part, state\w_args) != 0 || c.lmx_graph_put(made, at, part) != 0
        return: 1
    at := at + 1U
    if: with_result != 0
        if: c.lmx_graph_kind(g, result) = 2
            part := c.lmx_graph_word_of(g, c.lmx_graph_word_text(g, result))
        else:
            part := c.lmx_graph_ref_lmx(g, (cast: (@: c.Lmx) result))
        ---
        if: part = 0 || c.lmx_graph_name_address(g, part, state\w_return) != 0 || c.lmx_graph_put(made, at, part) != 0
            return: 1
        at := at + 1U
    ---
    status := lmx_graph_fn_data(g, made, args, written, body, @ vars)
    if: status != 0
        return: status
    if: c.lmx_graph_put(made, at, (cast: (@: void) vars)) != 0
        return: 1
    at := at + 1U
    if: body != 0
        part := c.lmx_graph_ref_lmx(g, body)
        if: part = 0 || c.lmx_graph_name_address(g, part, state\w_code) != 0 || c.lmx_graph_put(made, at, part) != 0
            return: 1
        ---
    ---
    made\native := decl\native
    out[0] := made
    return: 0
end: lmx_graph_fn_make

# One form of a receiver: an Lmx named by the receiver whose fields are its formals in order (lmx_graph_receivers_open).
# Formal i is a word cell -- an argument taken as written -- when bit i of words is set, otherwise an empty Lmx -- a
# Structure; each is named by its name. 0, or 1 without memory.
fn: lmx_graph_receiver_form (@: g c.LmxGraph; @: list c.Lmx; size_t: at; @: head char; size_t: n; @: f0 char; @: f1 char; @: f2 char; @: f3 char; @: f4 char; int: words) int
    @: form c.Lmx c.lmx_graph_lmx(g, list, n)
    @: formal void 0
    @: name char 0
    size_t: i 0U
    int: bit 1
    if: form = 0 || c.lmx_graph_name_address(g, (cast: (@: void) form), head) != 0
        return: 1
    while: i < n
        name := f0
        if: i = 1U
            name := f1
        if: i = 2U
            name := f2
        if: i = 3U
            name := f3
        if: i = 4U
            name := f4
        if: (words / bit) % 2 = 1
            formal := c.lmx_graph_word_of(g, name)
        else:
            formal := (cast: (@: void) c.lmx_graph_lmx(g, form, 0U))
        ---
        if: name = 0 || formal = 0 || c.lmx_graph_name_address(g, formal, name) != 0 || c.lmx_graph_put(form, i, formal) != 0
            return: 1
        bit := bit * 2
        i := i + 1U
    ---
    if: c.lmx_graph_put(list, at, (cast: (@: void) form)) != 0
        return: 1
    return: 0
end: lmx_graph_receiver_form

# The contracts of the receivers fn and sub (Codex 0605/0615, c5: ordinary signatures the one binder takes from the
# initial filling of the namespace of the traversal): the forms of a receiver are the fields of one Lmx registered under
# its canonical name in the root's block -- fn [name, args, return, data, code], [name, args, return, code], [name, args,
# return], [name, parts]; sub [name, args, data, code], [name, args, code], [name, parts] (receivers with different numbers
# of arguments share one name). name and the result requirement return are taken as written (word cells: a word, or a
# written form such as the type `@: c.FILE`), the other formals are Structures (empty Lmx). The receivers of a launch
# have contracts of the same kind, bound by the same binder (the author 2026-11-11: the arguments of every receiver are
# named and given by position or by name, LMX_blog/2026-11-11.md#structure-call-by-name; R22): call [code], [data, code],
# [args, data, code]; fncall [return, code], [data, return, code], [args, data, return, code], return taken as written;
# and the record that launches an ordinary Structure by name, which is no receiver and has one argument, data: [],
# [data] -- registered under `()`, the mark of an application, which spells no name (lmx_graph_launch_formals). Made for
# every traversal, released with its tables. 0, or 1 without memory.
fn: lmx_graph_receivers_open (@: g c.LmxGraph; @: root c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: w_name char c.lmx_graph_intern("name", 4U)
    @: w_parts char c.lmx_graph_intern("parts", 5U)
    @: w_launch char c.lmx_graph_intern("()", 2U)
    @: w_fn char 0
    @: w_sub char 0
    @: w_args char 0
    @: w_return char 0
    @: w_data char 0
    @: w_code char 0
    @: w_call char 0
    @: w_fncall char 0
    @: fns c.Lmx 0
    @: subs c.Lmx 0
    @: calls c.Lmx 0
    @: fncalls c.Lmx 0
    @: launches c.Lmx 0
    int: status 0
    if: g = 0 || state = 0 || root = 0 || w_name = 0 || w_parts = 0 || w_launch = 0
        return: 1
    w_fn := state\w_fn
    w_sub := state\w_sub
    w_args := state\w_args
    w_return := state\w_return
    w_data := state\w_data
    w_code := state\w_code
    w_call := state\w_call
    w_fncall := state\w_fncall
    fns := c.lmx_graph_lmx(g, 0, 4U)
    subs := c.lmx_graph_lmx(g, 0, 3U)
    calls := c.lmx_graph_lmx(g, 0, 3U)
    fncalls := c.lmx_graph_lmx(g, 0, 3U)
    launches := c.lmx_graph_lmx(g, 0, 2U)
    if: fns = 0 || subs = 0 || calls = 0 || fncalls = 0 || launches = 0
        return: 1
    status := lmx_graph_receiver_form(g, fns, 0U, w_fn, 5U, w_name, w_args, w_return, w_data, w_code, 5)
    if: status = 0
        status := lmx_graph_receiver_form(g, fns, 1U, w_fn, 4U, w_name, w_args, w_return, w_code, 0, 5)
    if: status = 0
        status := lmx_graph_receiver_form(g, fns, 2U, w_fn, 3U, w_name, w_args, w_return, 0, 0, 5)
    if: status = 0
        status := lmx_graph_receiver_form(g, fns, 3U, w_fn, 2U, w_name, w_parts, 0, 0, 0, 1)
    if: status = 0
        status := lmx_graph_receiver_form(g, subs, 0U, w_sub, 4U, w_name, w_args, w_data, w_code, 0, 1)
    if: status = 0
        status := lmx_graph_receiver_form(g, subs, 1U, w_sub, 3U, w_name, w_args, w_code, 0, 0, 1)
    if: status = 0
        status := lmx_graph_receiver_form(g, subs, 2U, w_sub, 2U, w_name, w_parts, 0, 0, 0, 1)
    if: status = 0
        status := lmx_graph_receiver_form(g, calls, 0U, w_call, 1U, w_code, 0, 0, 0, 0, 0)
    if: status = 0
        status := lmx_graph_receiver_form(g, calls, 1U, w_call, 2U, w_data, w_code, 0, 0, 0, 0)
    if: status = 0
        status := lmx_graph_receiver_form(g, calls, 2U, w_call, 3U, w_args, w_data, w_code, 0, 0, 0)
    if: status = 0
        status := lmx_graph_receiver_form(g, fncalls, 0U, w_fncall, 2U, w_return, w_code, 0, 0, 0, 1)
    if: status = 0
        status := lmx_graph_receiver_form(g, fncalls, 1U, w_fncall, 3U, w_data, w_return, w_code, 0, 0, 2)
    if: status = 0
        status := lmx_graph_receiver_form(g, fncalls, 2U, w_fncall, 4U, w_args, w_data, w_return, w_code, 0, 4)
    if: status = 0
        status := lmx_graph_receiver_form(g, launches, 0U, w_launch, 0U, 0, 0, 0, 0, 0, 0)
    if: status = 0
        status := lmx_graph_receiver_form(g, launches, 1U, w_launch, 1U, w_data, 0, 0, 0, 0, 0)
    if: status = 0 && (c.lmx_graph_space_put(root, w_fn, (cast: (@: void) fns)) != 0 || c.lmx_graph_space_put(root, w_sub, (cast: (@: void) subs)) != 0)
        status := 1
    if: status = 0 && (c.lmx_graph_space_put(root, w_call, (cast: (@: void) calls)) != 0 || c.lmx_graph_space_put(root, w_fncall, (cast: (@: void) fncalls)) != 0 || c.lmx_graph_space_put(root, w_launch, (cast: (@: void) launches)) != 0)
        status := 1
    return: status
end: lmx_graph_receivers_open

# Is the written value an application the traversal evaluates -- merge, or a Frame whose head answers a callable in
# scope (the one model of a Frame, as at the root)? Any other written value -- a word, an int, an anonymous Structure, a
# Frame applying nothing (a block, a type form `@: T`) -- is what is written. 1 or 0.
fn: lmx_graph_applies (@: g c.LmxGraph; @: scope c.Lmx; @: value void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: head char 0
    if: state = 0 || c.lmx_graph_kind(g, value) != 4
        return: 0
    head := c.lmx_graph_name_of(g, value)
    if: head = 0
        return: 0
    if: head = state\w_merge || c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_target(g, lmx_graph_resolve(g, scope, head)))) != 0
        return: 1
    return: 0
end: lmx_graph_applies

# The written value of a Frame `name: ...` that gives a part by its head, or of the body of `name := ...` (an unnamed
# Lmx of its fields, lm_graph_build_assignment) -- lmx_graph_bind_formals, by head or by `:=`: the one model of a Frame,
# as at the root -- a single field that is a value (a word, an unnamed int, a reference, an unnamed Lmx) or an
# application (lmx_graph_applies) is the value; any other Frame or body is a block of fields and is itself.
fn: lmx_graph_frame_value (@: g c.LmxGraph; @: scope c.Lmx; @: frame void) @: void
    @: field void 0
    if: c.lmx_graph_kind(g, frame) != 4 || c.lmx_graph_count((cast: (@: c.Lmx) frame)) != 1U
        return: frame
    if: lmx_graph_field_value(g, frame) != frame
        return: lmx_graph_field_value(g, frame)
    field := c.lmx_graph_get((cast: (@: c.Lmx) frame), 0U)
    if: lmx_graph_applies(g, scope, field) != 0
        return: field
    return: frame
end: lmx_graph_frame_value

# The value of the hexadecimal digit ch, or -1 for no hexadecimal digit.
fn: lmx_graph_hex_digit (int: ch) int
    if: ch >= 48 && ch <= 57
        return: ch - 48
    if: ch >= 97 && ch <= 102
        return: ch - 87
    if: ch >= 65 && ch <= 70
        return: ch - 55
    return: -1
end: lmx_graph_hex_digit

# The value of an ordinary string literal a word primitive holds (the grammar §6, by the rules of C99): the bytes
# between its quotes with each escape decoded -- the simple escapes, up to three octal digits, `\x` with the
# hexadecimal digits after it, `\u` and `\U` as the UTF-8 of the character, a backslash before a line break joining the
# lines --, as a canonical spelling (§4). 0 for a word that is no ordinary string literal (an identifier, a wide or a
# character literal), a malformed literal, a value holding a zero byte (no canonical spelling is a C string with one),
# or without memory.
fn: lmx_graph_string_value (@: g c.LmxGraph; @: value void) @: char
    @: text char c.lmx_graph_word_text(g, value)
    @: buf char 0
    @: canon char 0
    size_t: n 0U
    size_t: i 1U
    size_t: o 0U
    size_t: k 0U
    size_t: width 0U
    int: ch 0
    int: d 0
    int: code 0
    int: bad 0
    if: text = 0
        return: 0
    while: text[n] != (cast: (char) 0)
        n := n + 1U
    ---
    if: n < 2U || text[0] != (cast: (char) 34) || text[n - 1U] != (cast: (char) 34)
        return: 0
    buf := (cast: (@: char) c.calloc(n + 1U, sizeof(char)))
    if: buf = 0
        return: 0
    while: i < n - 1U && bad = 0
        ch := (cast: (int) text[i])
        i := i + 1U
        if: ch != 92
            # An unescaped quote or line break inside the literal is malformed.
            if: ch = 34 || ch = 10
                bad := 1
            buf[o] := (cast: (char) ch)
            o := o + 1U
            continue
        if: i >= n - 1U
            bad := 1
            continue
        ch := (cast: (int) text[i])
        i := i + 1U
        code := -1
        if: ch = 10
            continue
        if: ch = 13
            if: i < n - 1U && text[i] = (cast: (char) 10)
                i := i + 1U
            continue
        if: ch = 39 || ch = 34 || ch = 63 || ch = 92
            code := ch
        if: ch = 97
            code := 7
        if: ch = 98
            code := 8
        if: ch = 102
            code := 12
        if: ch = 110
            code := 10
        if: ch = 114
            code := 13
        if: ch = 116
            code := 9
        if: ch = 118
            code := 11
        # Up to three octal digits.
        if: ch >= 48 && ch <= 55
            code := ch - 48
            k := 1U
            while: k < 3U && i < n - 1U && text[i] >= (cast: (char) 48) && text[i] <= (cast: (char) 55)
                code := code * 8 + ((cast: (int) text[i]) - 48)
                i := i + 1U
                k := k + 1U
            ---
            if: code > 255
                bad := 1
        ---
        # `\x` and every hexadecimal digit after it.
        if: ch = 120
            code := 0
            k := 0U
            while: i < n - 1U && lmx_graph_hex_digit((cast: (int) text[i])) >= 0 && bad = 0
                code := code * 16 + lmx_graph_hex_digit((cast: (int) text[i]))
                if: code > 255
                    bad := 1
                i := i + 1U
                k := k + 1U
            ---
            if: k = 0U
                bad := 1
        ---
        # `\u` with four hexadecimal digits, `\U` with eight: the character's UTF-8.
        if: ch = 117 || ch = 85
            width := 4U
            if: ch = 85
                width := 8U
            code := 0
            k := 0U
            while: k < width && bad = 0
                d := -1
                if: i < n - 1U
                    d := lmx_graph_hex_digit((cast: (int) text[i]))
                if: d < 0 || code > 69631
                    bad := 1
                else:
                    code := code * 16 + d
                    i := i + 1U
                ---
                k := k + 1U
            ---
            if: bad = 0 && (code > 1114111 || (code >= 55296 && code <= 57343))
                bad := 1
            if: bad = 0
                if: code < 128
                    buf[o] := (cast: (char) code)
                    o := o + 1U
                else:
                    if: code < 2048
                        buf[o] := (cast: (char) (192 + code / 64))
                        buf[o + 1U] := (cast: (char) (128 + code % 64))
                        o := o + 2U
                    else:
                        if: code < 65536
                            buf[o] := (cast: (char) (224 + code / 4096))
                            buf[o + 1U] := (cast: (char) (128 + (code / 64) % 64))
                            buf[o + 2U] := (cast: (char) (128 + code % 64))
                            o := o + 3U
                        else:
                            buf[o] := (cast: (char) (240 + code / 262144))
                            buf[o + 1U] := (cast: (char) (128 + (code / 4096) % 64))
                            buf[o + 2U] := (cast: (char) (128 + (code / 64) % 64))
                            buf[o + 3U] := (cast: (char) (128 + code % 64))
                            o := o + 4U
                        ---
                    ---
                ---
                if: code = 0
                    bad := 1
            ---
            continue
        ---
        if: code < 0
            bad := 1
        if: code = 0
            bad := 1
        if: bad = 0
            buf[o] := (cast: (char) code)
            o := o + 1U
        ---
    ---
    if: bad = 0
        canon := c.lmx_graph_intern((cast: (@: char) buf), o)
    c.free((cast: (@: void) buf))
    return: canon
end: lmx_graph_string_value

# A word description reads anonymous grouping without resolving or applying the
# written value. A numeric field stays a Structure; empty and multiple fields,
# and every named form, keep their own description. The borrowed address is
# shared by receiver contracts and explicit launch descriptions, never stored
# back in the source graph.
fn: lmx_graph_description_value (@: g c.LmxGraph; @: value void) @: void
    @: child void 0
    int: kind 0
    while: c.lmx_graph_kind(g, value) = 4 && c.lmx_graph_name_of(g, value) = 0 && c.lmx_graph_count((cast: (@: c.Lmx) value)) = 1U
        child := c.lmx_graph_get((cast: (@: c.Lmx) value), 0U)
        kind := c.lmx_graph_kind(g, child)
        if: kind != 2 && kind != 4
            break
        value := child
return: value

# The name a written value gives a part name of a receiver -- the contract of a name, one for every receiver (the
# author 2026-11-09: `fn: name := "test"; ...` creates test): an identifier word its own spelling, an ordinary string
# literal its value (lmx_graph_string_value), the quotes being no part of it; 0 for any other value -- a word holding a
# quote (a malformed, wide or character literal), an int, a Structure.
fn: lmx_graph_name_value (@: g c.LmxGraph; @: value void) @: char
    @: text char 0
    size_t: i 0U
    value := lmx_graph_description_value(g, value)
    text := c.lmx_graph_word_text(g, value)
    if: text = 0
        return: 0
    if: text[0] = (cast: (char) 34)
        return: lmx_graph_string_value(g, value)
    while: text[i] != (cast: (char) 0)
        if: text[i] = (cast: (char) 34) || text[i] = (cast: (char) 39)
            return: 0
        i := i + 1U
    ---
    return: text
end: lmx_graph_name_value

# The reception of a value by a formal of a receiver's contract (lmx_graph_receivers_open): a formal taken as written (a
# word cell: name, return) takes a word or a written form (a Structure: the type form `@: c.FILE` of a result
# requirement), a Structure formal (an empty Lmx) a Structure; an int, a place, a pointer value is received by neither.
# What the receiver's action needs of a value it received (a word for the name) is the action's (lmx_graph_receiver_make).
# 0, or 5.
fn: lmx_graph_receiver_admit (@: g c.LmxGraph; @: formal void; @: value void) int
    int: kind c.lmx_graph_kind(g, value)
    if: c.lmx_graph_kind(g, formal) = 2 && (kind = 2 || kind = 4)
        return: 0
    if: c.lmx_graph_kind(g, formal) = 4 && kind = 4
        return: 0
    return: 5
end: lmx_graph_receiver_admit

# The widest form of a contract (lmx_graph_receivers_open): the most formals any of its forms has.
fn: lmx_graph_forms_width (@: list c.Lmx) size_t
    size_t: widest 0U
    size_t: f 0U
    while: f < c.lmx_graph_count(list)
        if: c.lmx_graph_count((cast: (@: c.Lmx) c.lmx_graph_get(list, f))) > widest
            widest := c.lmx_graph_count((cast: (@: c.Lmx) c.lmx_graph_get(list, f)))
        f := f + 1U
    ---
    return: widest
end: lmx_graph_forms_width

# The form of a contract (lmx_graph_receivers_open) the written actuals of expression bind to, by the one binder
# (lmx_graph_bind_formals): the first form of list whose formals they all give -- by position, by name through `:=`, with
# by_head by head too (the parts of fn and sub) -- with no actual left over and no formal unbound. The form is chosen
# before any actual is evaluated. bindings[i] the formal of actual i, modes[i] how (modes may be 0): arrays of the
# caller, one per actual. The form, or 0 for none; status[0] 0, 4 without memory, 5 for none.
fn: lmx_graph_receiver_form_of (@: g c.LmxGraph; @: list c.Lmx; @: expression c.Lmx; int: by_head; @: scope c.Lmx; @: bindings size_t; @: modes int; @: status int) @: c.Lmx
    @: chosen c.Lmx 0
    @: seen int 0
    size_t: n c.lmx_graph_count(expression)
    size_t: width 0U
    size_t: f 0U
    size_t: i 0U
    int: found 0
    status[0] := 5
    seen := (cast: (@: int) c.calloc(lmx_graph_forms_width(list) + 1U, sizeof(int)))
    if: seen = 0
        status[0] := 4
        return: 0
    while: found = 0 && f < c.lmx_graph_count(list)
        chosen := (cast: (@: c.Lmx) c.lmx_graph_get(list, f))
        width := c.lmx_graph_count(chosen)
        i := 0U
        while: i < width
            seen[i] := 0
            i := i + 1U
        ---
        if: n <= width && lmx_graph_bind_formals(g, chosen, expression, bindings, modes, seen, by_head, scope) = 0
            found := 1
            i := 0U
            while: i < width
                if: seen[i] = 0
                    found := 0
                i := i + 1U
            ---
        ---
        if: found = 0
            f := f + 1U
    ---
    c.free((cast: (@: void) seen))
    if: found = 0
        return: 0
    status[0] := 0
    return: chosen
end: lmx_graph_receiver_form_of

# The arguments of the receiver fn or sub of the Frame decl in block scope through its contracts
# (lmx_graph_receivers_open) and the one binder (lmx_graph_receiver_form_of): the first form its written actuals bind to --
# by position, by `:=`, by head -- with every formal bound; else one actual is the whole argument structure (the book,
# whole-arguments): a Structure whose fields give exactly the formals of a form (lmx_graph_bind_fields), read by their
# values (lmx_graph_field_value). The form is chosen before any actual is evaluated; the whole Structure, the only actual
# then, is evaluated once. What is written for a formal stands as written where it applies nothing (lmx_graph_applies):
# a formal taken as written (name, return) takes a written word or written form (`@: c.FILE`) as it is, a Structure
# formal a written Structure (an anonymous Structure, a block given by head or by `:=`, a Frame applying nothing); any
# other actual -- an application, a name a Structure formal resolves -- is an expression evaluated once, in order --
# when evaluate is 1; with 0 such an actual binds nothing (-1), so a declaration with written arguments is told
# (lmx_graph_fn_written). Each value is received by its formal before the next actual is evaluated
# (lmx_graph_receiver_admit). values[slot] the value of each formal, form[0] the form. 0; -1 an actual needs evaluation;
# 4 without memory; 5 for no form or a value its formal does not receive; the answer of an evaluation.
fn: lmx_graph_receiver_bind (@: g c.LmxGraph; @: scope c.Lmx; @: decl c.Lmx; int: evaluate; @@: values void; @@: form c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: space c.LmxGraphSpace c.lmx_graph_space()
    @: head char 0
    @: list c.Lmx 0
    @: chosen c.Lmx 0
    @: raw void 0
    @: value void 0
    @: bindings size_t 0
    @: modes int 0
    @: from size_t 0
    size_t: n 0U
    size_t: width 0U
    size_t: f 0U
    size_t: i 0U
    size_t: slot 0U
    int: found 0
    int: status 0
    form[0] := 0
    if: g = 0 || state = 0 || space = 0 || decl = 0 || values = 0
        return: 5
    head := c.lmx_graph_name_of(g, (cast: (@: void) decl))
    if: head != state\w_fn && head != state\w_sub
        return: 5
    list := (cast: (@: c.Lmx) c.lmx_graph_space_find((cast: (@: c.Lmx) space\root), head))
    if: c.lmx_graph_kind(g, (cast: (@: void) list)) != 4
        return: 5
    n := c.lmx_graph_count(decl)
    bindings := (cast: (@: size_t) c.calloc(n + 1U, sizeof(size_t)))
    modes := (cast: (@: int) c.calloc(n + 1U, sizeof(int)))
    from := (cast: (@: size_t) c.calloc(lmx_graph_forms_width(list) + 1U, sizeof(size_t)))
    if: bindings = 0 || modes = 0 || from = 0
        status := 4
    # The form, by the written actuals alone; with none, the whole-arguments reading below.
    if: status = 0
        chosen := lmx_graph_receiver_form_of(g, list, decl, 1, scope, bindings, modes, @ status)
        if: chosen != 0
            found := 1
            width := c.lmx_graph_count(chosen)
        ---
        if: status = 5
            status := 0
        ---
    ---
    if: status = 0 && found != 0
        i := 0U
        while: i < n && status = 0
            raw := c.lmx_graph_get(decl, i)
            slot := bindings[i]
            # The value written for a formal by `:=` or by head. For a formal taken as written (name, return) it is the
            # written field itself -- the single field of the part `name: ...`, the operand of `name := ...` (a body the
            # builder keeps as a Structure because it is no single value, lm_graph_build_assignment, read as its one
            # field) --, so one requirement is one value whether written by position, by head or by `:=`. For a
            # Structure formal it is the part by the one model of a Frame (lmx_graph_frame_value): the block, or the
            # value a single field gives.
            if: modes[i] = 1
                raw := c.lmx_graph_get((cast: (@: c.Lmx) raw), 2U)
                if: c.lmx_graph_kind(g, c.lmx_graph_get(chosen, slot)) = 2
                    if: c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_count((cast: (@: c.Lmx) raw)) = 1U && lmx_graph_field_value(g, raw) = raw
                        raw := c.lmx_graph_get((cast: (@: c.Lmx) raw), 0U)
                    ---
                else:
                    raw := lmx_graph_frame_value(g, scope, raw)
                ---
            ---
            if: modes[i] = 2
                if: c.lmx_graph_kind(g, c.lmx_graph_get(chosen, slot)) = 2 && c.lmx_graph_count((cast: (@: c.Lmx) raw)) = 1U
                    raw := c.lmx_graph_get((cast: (@: c.Lmx) raw), 0U)
                else:
                    raw := lmx_graph_frame_value(g, scope, raw)
                ---
            ---
            if: c.lmx_graph_kind(g, c.lmx_graph_get(chosen, slot)) = 2
                raw := lmx_graph_description_value(g, raw)
            value := 0
            if: (c.lmx_graph_kind(g, raw) = 2 && c.lmx_graph_kind(g, c.lmx_graph_get(chosen, slot)) = 2) || (c.lmx_graph_kind(g, raw) = 4 && lmx_graph_applies(g, scope, raw) = 0)
                value := raw
            else:
                if: evaluate = 0
                    status := -1
                else:
                    status := lmx_graph_eval_value(g, scope, raw, @ value)
                    if: status = 0
                        value := c.lmx_graph_target(g, value)
                    ---
                ---
            ---
            # The value is admitted to its formal at once, before the next actual is evaluated: a formal taken as
            # written (a word cell) takes a word or a written form, a Structure formal a Structure (the norm of a call:
            # each actual is received before the next).
            if: status = 0
                status := lmx_graph_receiver_admit(g, c.lmx_graph_get(chosen, slot), value)
            if: status = 0
                values[slot] := value
            i := i + 1U
        ---
    ---
    # No form by position, name or head: one actual is the whole argument structure of a form.
    if: status = 0 && found = 0
        status := 5
        raw := c.lmx_graph_get(decl, 0U)
        if: n = 1U && (c.lmx_graph_kind(g, raw) != 4 || c.lmx_graph_name_of(g, raw) != 0 || c.lmx_graph_word_text(g, c.lmx_graph_get((cast: (@: c.Lmx) raw), 0U)) != state\w_assign)
            status := 0
            value := raw
            if: c.lmx_graph_kind(g, raw) != 4 || c.lmx_graph_name_of(g, raw) != 0
                if: evaluate = 0
                    status := -1
                else:
                    status := lmx_graph_eval_value(g, scope, raw, @ value)
                ---
            ---
            if: status = 0
                value := c.lmx_graph_target(g, value)
                status := 5
                if: c.lmx_graph_kind(g, value) = 4
                    f := 0U
                    while: found = 0 && f < c.lmx_graph_count(list)
                        chosen := (cast: (@: c.Lmx) c.lmx_graph_get(list, f))
                        width := c.lmx_graph_count(chosen)
                        i := 0U
                        while: i <= width
                            from[i] := 0U
                            i := i + 1U
                        ---
                        if: lmx_graph_bind_fields(g, chosen, (cast: (@: c.Lmx) value), from) != 0
                            found := 1
                            i := 0U
                            while: i < width
                                if: from[i] = 0U
                                    found := 0
                                i := i + 1U
                            ---
                        ---
                        if: found = 0
                            f := f + 1U
                    ---
                    if: found != 0
                        status := 0
                        slot := 0U
                        while: slot < width && status = 0
                            values[slot] := lmx_graph_field_value(g, c.lmx_graph_get((cast: (@: c.Lmx) value), from[slot] - 1U))
                            if: c.lmx_graph_kind(g, c.lmx_graph_get(chosen, slot)) = 2
                                values[slot] := lmx_graph_description_value(g, values[slot])
                            status := lmx_graph_receiver_admit(g, c.lmx_graph_get(chosen, slot), values[slot])
                            slot := slot + 1U
                        ---
                    ---
                ---
            ---
        ---
    ---
    if: status = 0
        form[0] := chosen
    c.free((cast: (@: void) bindings))
    c.free((cast: (@: void) modes))
    c.free((cast: (@: void) from))
    return: status
end: lmx_graph_receiver_bind

# The receiver's action on its bound arguments (lmx_graph_receiver_bind): the Structure F of the function by the one
# constructor lmx_graph_fn_make (sub: without a result). The form with the formal parts takes the Structure of the parts
# and reads its fields by their values (lmx_graph_fn_part): a field name there is an ordinary field, another field is no
# part of the contract (5). The name is the contract of a name (lmx_graph_name_value: an identifier, or the value of
# a string literal). 0 and F in out, its name in name_out; 1 without memory; 5 for a value of
# another kind or a missing part.
fn: lmx_graph_receiver_make (@: g c.LmxGraph; @: decl c.Lmx; @: form c.Lmx; @@: values void; @@: out c.Lmx; @@: name_out char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: w_name char c.lmx_graph_intern("name", 4U)
    @: w_parts char c.lmx_graph_intern("parts", 5U)
    @: head char 0
    @: parts c.Lmx 0
    @: name char 0
    @: field char 0
    @: args c.Lmx 0
    @: result void 0
    @: written c.Lmx 0
    @: body c.Lmx 0
    size_t: width 0U
    size_t: slot 0U
    size_t: i 0U
    int: with_result 0
    out[0] := 0
    name_out[0] := 0
    if: g = 0 || state = 0 || form = 0 || values = 0 || w_name = 0 || w_parts = 0
        return: 5
    head := c.lmx_graph_name_of(g, (cast: (@: void) form))
    with_result := (cast: (int) (head = state\w_fn))
    width := c.lmx_graph_count(form)
    slot := c.lmx_graph_formal(g, form, w_name)
    if: slot >= width
        return: 5
    name := lmx_graph_name_value(g, values[slot])
    slot := c.lmx_graph_formal(g, form, w_parts)
    if: slot < width
        if: c.lmx_graph_kind(g, values[slot]) != 4
            return: 5
        parts := (cast: (@: c.Lmx) values[slot])
        while: i < c.lmx_graph_count(parts)
            field := c.lmx_graph_slot_name(g, parts, i)
            if: field != w_name && field != state\w_args && field != state\w_data && field != state\w_code && (field != state\w_return || with_result = 0)
                return: 5
            i := i + 1U
        ---
        args := (cast: (@: c.Lmx) lmx_graph_fn_part(g, parts, (cast: (@: char) state\w_args)))
        written := (cast: (@: c.Lmx) lmx_graph_fn_part(g, parts, (cast: (@: char) state\w_data)))
        body := (cast: (@: c.Lmx) lmx_graph_fn_part(g, parts, (cast: (@: char) state\w_code)))
        if: with_result != 0
            result := lmx_graph_fn_part(g, parts, (cast: (@: char) state\w_return))
        ---
    else:
        slot := c.lmx_graph_formal(g, form, state\w_args)
        if: slot < width
            args := (cast: (@: c.Lmx) values[slot])
        slot := c.lmx_graph_formal(g, form, state\w_data)
        if: slot < width
            written := (cast: (@: c.Lmx) values[slot])
        slot := c.lmx_graph_formal(g, form, state\w_code)
        if: slot < width
            body := (cast: (@: c.Lmx) values[slot])
        slot := c.lmx_graph_formal(g, form, state\w_return)
        if: slot < width
            result := values[slot]
        ---
    ---
    if: name = 0 || args = 0 || (with_result != 0 && result = 0)
        return: 5
    result := lmx_graph_description_value(g, result)
    name_out[0] := name
    return: lmx_graph_fn_make(g, decl, name, args, result, written, body, with_result, out)
end: lmx_graph_receiver_make

# The name a Frame of fn or sub gives as written, as the binder takes it (lmx_graph_bind_formals): the word at the first
# position of several actuals, the word of `name := word`, or the word of a Frame `name: word` given by head, read by
# the contract of a name (lmx_graph_name_value: `name := "test"` gives test); 0 when only an evaluated Structure gives
# it (the whole form, `fn: prepared`).
fn: lmx_graph_fn_decl_name (@: g c.LmxGraph; @: decl c.Lmx) @: char
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: w_name char c.lmx_graph_intern("name", 4U)
    @: raw void 0
    @: inner c.Lmx 0
    size_t: n 0U
    size_t: i 0U
    if: g = 0 || state = 0 || w_name = 0 || c.lmx_graph_kind(g, (cast: (@: void) decl)) != 4
        return: 0
    n := c.lmx_graph_count(decl)
    if: n > 1U && c.lmx_graph_kind(g, lmx_graph_description_value(g, c.lmx_graph_get(decl, 0U))) = 2
        return: lmx_graph_name_value(g, c.lmx_graph_get(decl, 0U))
    while: i < n
        raw := c.lmx_graph_get(decl, i)
        inner := (cast: (@: c.Lmx) raw)
        if: c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_count(inner) = 3U && c.lmx_graph_word_text(g, c.lmx_graph_get(inner, 0U)) = state\w_assign && c.lmx_graph_word_text(g, c.lmx_graph_get(inner, 1U)) = w_name
            return: lmx_graph_name_value(g, c.lmx_graph_get(inner, 2U))
        if: c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = w_name && c.lmx_graph_count(inner) = 1U
            return: lmx_graph_name_value(g, c.lmx_graph_get(inner, 0U))
        i := i + 1U
    ---
    return: 0
end: lmx_graph_fn_decl_name

# Is decl (a Frame named fn or sub) a declaration with written arguments -- its actuals bind a form of the receiver's
# contract with no evaluation (lmx_graph_receiver_bind): names and written Structures, by position, `:=` or head? Its
# Structure is created when its block is entered (lmx_graph_space_declarations) and answers in the whole block (the book
# :435). An application to arguments the traversal computes -- the whole prepared Structure, a Structure of the parts
# an expression gives, a part a call gives -- is applied where the traversal reaches it (lmx_graph_fn_apply). 1 or 0.
fn: lmx_graph_fn_written (@: g c.LmxGraph; @: decl c.Lmx) int
    @@: values void (cast: (@@: void) c.calloc(6U, sizeof(@: void)))
    @: form c.Lmx 0
    int: status 5
    if: g = 0 || values = 0 || c.lmx_graph_kind(g, (cast: (@: void) decl)) != 4
        c.free((cast: (@: void) values))
        return: 0
    status := lmx_graph_receiver_bind(g, (cast: (@: c.Lmx) decl\parent), decl, 0, values, @ form)
    c.free((cast: (@: void) values))
    return: (cast: (int) (status = 0))
end: lmx_graph_fn_written

# The receiver fn or sub applied to the written arguments of its declaration Frame, bound to a form of its contract by
# the one binder (lmx_graph_receiver_bind, no evaluation): the Structure it creates (lmx_graph_receiver_make,
# lmx_graph_fn_make) answers the name in the block scope of this traversal, then the declarations of its body answer
# theirs in the body's block. 0; -1 an argument needs evaluation and -2 no form binds (both told where the traversal
# reaches the Frame, lmx_graph_fn_apply); 1 without memory; 5 for a value of another kind.
fn: lmx_graph_space_declare (@: g c.LmxGraph; @: scope c.Lmx; @: decl c.Lmx) int
    @@: values void (cast: (@@: void) c.calloc(6U, sizeof(@: void)))
    @: form c.Lmx 0
    @: made c.Lmx 0
    @: name char 0
    @: body c.Lmx 0
    int: status 4
    if: values != 0
        status := lmx_graph_receiver_bind(g, scope, decl, 0, values, @ form)
    # No form of the contract binds the written actuals: refused, or applied, where the traversal reaches it.
    if: status = 5
        status := -2
    if: status = 0
        status := lmx_graph_receiver_make(g, decl, form, values, @ made, @ name)
    c.free((cast: (@: void) values))
    if: status != 0
        return: status
    if: c.lmx_graph_space_put(scope, name, (cast: (@: void) made)) != 0
        return: 1
    body := c.lmx_graph_method_code(g, made)
    if: body != 0
        status := lmx_graph_space_declarations(g, body)
    return: status
end: lmx_graph_space_declare

# Every declaration Frame of fn or sub with written arguments (lmx_graph_fn_written) among the fields of a block creates
# its Structure in this traversal before the block runs: the names of fn and sub are visible in both directions of their
# block (the book :435). The receiver applied to arguments the traversal computes creates its Structure where the
# traversal reaches it (lmx_graph_fn_apply), and the name answers from there on.
fn: lmx_graph_space_declarations (@: g c.LmxGraph; @: block c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: value void 0
    @: head char 0
    size_t: i 0U
    int: status 0
    while: i < c.lmx_graph_count(block) && status = 0
        value := c.lmx_graph_get(block, i)
        head := c.lmx_graph_name_of(g, value)
        # An argument to evaluate, or no form: applied, or refused, where the traversal reaches it (lmx_graph_fn_apply).
        if: c.lmx_graph_kind(g, value) = 4 && (head = state\w_fn || head = state\w_sub)
            status := lmx_graph_space_declare(g, block, (cast: (@: c.Lmx) value))
            if: status = -1 || status = -2
                status := 0
            ---
        ---
        i := i + 1U
    ---
    return: status
end: lmx_graph_space_declarations

# The value a Structure gives for the part name of a receiver: the value of its field named name, by the one model of a
# Frame (lmx_graph_field_value), whatever made the Structure. 0 when it has no field named name.
fn: lmx_graph_fn_part (@: g c.LmxGraph; @: structure c.Lmx; @: name char) @: void
    size_t: slot 0U
    if: g = 0 || structure = 0 || name = 0
        return: 0
    slot := c.lmx_graph_named(g, structure, name)
    if: slot >= c.lmx_graph_count(structure)
        return: 0
    return: lmx_graph_field_value(g, c.lmx_graph_get(structure, slot))
end: lmx_graph_fn_part

# The receiver fn or sub applied where the traversal reaches its Frame at field index of the root, to arguments the
# traversal computes (the author 2026-11-09: "в любой момент можем подставить заготовленную структуру ресиверу fn и это
# будет объявлением функции в namespace"): the same contract and binder as a written declaration
# (lmx_graph_receiver_bind) -- the whole prepared Structure (`fn: prepared`), the written name and a Structure of the
# parts (`fn: new_name merge(f1, f2)`), any form whose part an expression gives --, the arguments evaluated once in
# order, and the same action (lmx_graph_receiver_make: one constructor, data by lmx_graph_fn_data); from here on the name
# answers F in this block. A written name is checked before any argument is evaluated. A declaration with written
# arguments created its F when the block was entered (0 here). 0; 1 without memory; 3 for an unknown name; 4 for a name
# that already answers in this block; 5 for no form or a value of another kind, or in a body or an inline block (a
# repeated activation would bind the name again).
fn: lmx_graph_fn_apply (@: g c.LmxGraph; @: scope c.Lmx; size_t: index) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: space c.LmxGraphSpace c.lmx_graph_space()
    @@: values void 0
    @: decl c.Lmx 0
    @: form c.Lmx 0
    @: made c.Lmx 0
    @: name char 0
    @: head char 0
    @: body c.Lmx 0
    int: status 0
    if: g = 0 || state = 0 || scope = 0 || index >= c.lmx_graph_count(scope)
        return: 5
    decl := (cast: (@: c.Lmx) c.lmx_graph_get(scope, index))
    head := c.lmx_graph_name_of(g, (cast: (@: void) decl))
    if: c.lmx_graph_kind(g, (cast: (@: void) decl)) != 4 || (head != state\w_fn && head != state\w_sub)
        return: 5
    if: lmx_graph_fn_written(g, decl) != 0
        return: 0
    if: space = 0 || space\root != scope
        return: 5
    # A written name is checked before any argument is evaluated.
    name := lmx_graph_fn_decl_name(g, decl)
    if: name != 0 && c.lmx_graph_space_find(scope, name) != 0
        return: 4
    values := (cast: (@@: void) c.calloc(6U, sizeof(@: void)))
    if: values = 0
        return: 1
    status := lmx_graph_receiver_bind(g, scope, decl, 1, values, @ form)
    if: status = 0
        status := lmx_graph_receiver_make(g, decl, form, values, @ made, @ name)
    c.free((cast: (@: void) values))
    if: status != 0
        return: status
    if: c.lmx_graph_space_find(scope, name) != 0
        return: 4
    if: c.lmx_graph_space_put(scope, name, (cast: (@: void) made)) != 0
        return: 1
    body := c.lmx_graph_method_code(g, made)
    if: body != 0
        status := lmx_graph_space_declarations(g, body)
    return: status
end: lmx_graph_fn_apply

# The reading of the Frame at field index of the root, reached now (the book, colon-declares and forms-declare-or-call;
# the author 2026-11-10, 2026-11-11): a form `Name: tail` whose head is no word of the language, no receiver and no
# callable declares the Structure Name with the tail inside -- declared again, it is one more occurrence of the name --
# and never assigns: nothing is read from the form of the tail. A head that names a place of the root -- a place of a
# value or of a reference declared by its receiver, above or below the form, the root being data read whole (plan M11
# 5a) -- or that answers a place that is no Structure is declared by no such form: the value of a known place is
# written by `:=`. 1 a declaration; 0 a statement of the language or the application of a callable; -8 the refused
# form (the answer 8 of the interpreter).
fn: lmx_graph_root_declares (@: g c.LmxGraph; @: root c.Lmx; size_t: index) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: value void c.lmx_graph_get(root, index)
    @: name char c.lmx_graph_name_of(g, value)
    @: known void 0
    @: field void 0
    @: head char 0
    size_t: i 0U
    int: kind 0
    if: state = 0 || name = 0 || c.lmx_graph_statement(g, value) = 0 || lmx_graph_language_word(state, name) != 0 || c.lmx_graph_language_receiver(name) != 0
        return: 0
    known := lmx_graph_resolve(g, root, name)
    # A head naming a callable, directly or through a reference to it, applies it; a head that is a reference place to
    # an ordinary Structure launches it (lmx_graph_launch_head; R22: a record on a place head is never a declaration).
    if: known != 0 && known != value && c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_target(g, known))) != 0
        return: 0
    if: known != 0 && known != value && lmx_graph_launch_head(g, root, name) != 0
        return: 0
    # A place of the root named name, at any line: an int place, a place without a value, a reference place, a named
    # word, a declaration Frame of a receiver of a place (lmx_graph_data_find reads the same records).
    while: i < c.lmx_graph_count(root)
        field := c.lmx_graph_get(root, i)
        kind := c.lmx_graph_kind(g, field)
        head := 0
        if: kind = 1 || kind = 3 || kind = 5 || kind = 6 || (kind = 2 && c.lmx_graph_name_of(g, field) != 0)
            head := c.lmx_graph_slot_name(g, root, i)
        else:
            if: kind = 4
                head := c.lmx_graph_name_of(g, field)
                if: (head = state\w_int || head = state\w_at) && c.lmx_graph_count((cast: (@: c.Lmx) field)) != 0U
                    head := c.lmx_graph_word_text(g, c.lmx_graph_get((cast: (@: c.Lmx) field), 0U))
                else:
                    head := 0
                ---
            ---
        ---
        if: head = name
            return: -8
        i := i + 1U
    ---
    if: known = 0 || known = value
        return: 1
    if: c.lmx_graph_kind(g, known) != 4
        return: -8
    return: 1
end: lmx_graph_root_declares

# The declaration the traversal reaches at field index of the root (lmx_graph_root_declares answered 1). The declared
# Structure is the Lmx of the form with its tail as written -- an atom of the tail stays the written word, resolved
# when a path is read through it (lmx_graph_step; the author 2026-11-11, LMX_blog/2026-11-11.md#known-name-not-expanded)
# -- and it answers its name in the whole root, above and below its line (lmx_graph_resolve, the registry). When made
# is given, the Structure a receiver applied in the tail built -- `Name: merge(...)`, where the outer name receives the
# result (the book :375) -- takes the name and the slot of the form. A repeated declaration is one more occurrence of
# the name (the author 2026-11-11): nothing is replaced, assigned or called (the book, colon-declares). 0; 1 without
# memory or for a refused write; 5 for a built Structure that already has a name (a one-operand merge copy keeps its
# own: a reference to it is declared by `@: name merge(...)`).
fn: lmx_graph_root_declare (@: g c.LmxGraph; @: root c.Lmx; size_t: index; @: made void) int
    @: value void 0
    @: name char 0
    if: g = 0 || root = 0 || index >= c.lmx_graph_count(root)
        return: 5
    value := c.lmx_graph_get(root, index)
    name := c.lmx_graph_name_of(g, value)
    if: name = 0 || c.lmx_graph_kind(g, value) != 4
        return: 5
    if: made = 0
        return: 0
    if: c.lmx_graph_kind(g, made) != 4 || c.lmx_graph_name_of(g, made) != 0
        return: 5
    if: c.lmx_graph_name_address(g, made, name) != 0 || c.lmx_graph_write_slot(g, root, root, index, made) != 0
        return: 1
    return: 0
end: lmx_graph_root_declare

# The traversal reaches field index of the root (§5.2; the author 2026-11-11, plan M11 5a: the root is data read whole,
# a place and a named Structure answer their names above and below their lines -- lmx_graph_resolve reads the
# registry). A place stands. A form `Name: tail` that declares a Structure (lmx_graph_root_declares) is declared here
# (lmx_graph_root_declare), `Name: merge(...)` after the receiver built it; the interpreter calls it at every field,
# the program the translator emits at the fields the translation read as declarations. 1 when the field stands (a
# place, a declared Structure, an empty slot, a Structure a receiver created held as a value), 0 when it is a statement
# to run (a word as `return` included), a negative number for a failure: minus the answer of the interpreter -- -1
# without memory, -8 for the refused form on a known place, the answer of the receiver in the tail.
fn: lmx_graph_space_reach (@: g c.LmxGraph; @: root c.Lmx; size_t: index) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: value void 0
    @: made void 0
    @: inner c.Lmx 0
    int: kind 0
    int: status 0
    if: g = 0 || state = 0 || root = 0 || index >= c.lmx_graph_count(root)
        return: 0
    value := c.lmx_graph_get(root, index)
    # An empty slot stands.
    if: value = 0
        return: 1
    kind := c.lmx_graph_kind(g, value)
    if: kind = 1 || kind = 3 || kind = 5 || kind = 6
        return: 1
    if: kind != 4
        return: 0
    if: c.lmx_graph_fn_result(g, value) != 0
        return: 1
    status := lmx_graph_root_declares(g, root, index)
    if: status != 1
        return: status
    inner := (cast: (@: c.Lmx) value)
    if: c.lmx_graph_count(inner) = 1U && c.lmx_graph_name_of(g, c.lmx_graph_get(inner, 0U)) = state\w_merge
        status := lmx_graph_eval_merge(g, root, (cast: (@: c.Lmx) c.lmx_graph_get(inner, 0U)), @ made)
        if: status != 0
            return: 0 - status
        ---
    ---
    status := lmx_graph_root_declare(g, root, index, made)
    if: status != 0
        return: 0 - status
    return: 1
end: lmx_graph_space_reach

# The slot of the place named name of block that a write by a bare name reaches (plan M11 5a): the only record of that
# name in the registry of block (lmx_graph_data_find), read whole and both ways, when it is a place; the count of the
# slots of block for none, for two or more records, or for a record that is no place.
fn: lmx_graph_visible_slot (@: g c.LmxGraph; @: block c.Lmx; @: name char) size_t
    size_t: at 0U
    if: lmx_graph_data_find(g, block, name, 1, 0U, @ at) != 1U || lmx_graph_place_slot(g, block, name) != at
        return: c.lmx_graph_count(block)
    return: at
end: lmx_graph_visible_slot

# Begin the namespace of a traversal of root (§5.2): when no traversal is live, a new empty table and the Structures of
# the declarations of fn and sub created in it (they answer in their whole block); the places and named Structures of the
# root answer in the whole root, read whole by its registry (lmx_graph_resolve; plan M11 5a). A traversal begun inside a live
# one goes on with it. opened[0] says which (the argument of lmx_graph_space_close). 0; 1 without memory;
# 5 for a declaration form this slice does not execute.
fn: lmx_graph_space_open (@: g c.LmxGraph; @: root c.Lmx; @: opened int) int
    int: status 0
    if: g = 0 || root = 0 || opened = 0
        return: 5
    opened[0] := c.lmx_graph_space_push(root)
    if: opened[0] < 0
        opened[0] := 0
        return: 1
    if: opened[0] = 1
        status := lmx_graph_receivers_open(g, root)
        if: status = 0
            status := lmx_graph_space_declarations(g, root)
        if: status != 0
            c.lmx_graph_space_pop(opened[0])
            opened[0] := 0
        ---
    ---
    return: status
end: lmx_graph_space_open

# End the namespace lmx_graph_space_open began (opened: its answer in opened[0]); its rows are freed.
sub: lmx_graph_space_close (int: opened)
    c.lmx_graph_space_pop(opened)
    return
end: lmx_graph_space_close
