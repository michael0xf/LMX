# A supplied data Structure never executes its computed reference initializers (HG2-A, CALLFORM Р36 п.2 and rule Б).
# Self reaches its own receiver; a distinct Code writes the required data places. The launch of Writer over D2 is
# `call(D2; Writer\code)` (the body over the data), and every write into the given data is explicit (`data\seen`,
# `data\sseen`), so the values reach the data (#call-frame-20261115: no write-back of a local).
# Observation: the root values are written explicitly in sub: observe (#flush-receiver-contract).
(
    Observed:
        int: self_seen 0
        int: given_seen 0
        int: structure_seen 0
        int: callable_seen 0
        int: calls 0
        int: ignored_initializers 0
)
@: shared data[0]
int: calls 0
fn: touch () int
    node\calls := node\calls + 1
    return: 0
sub: Writer () (
    @: p int data[touch()]
    int: seen 0
)
    @: p int data[1]
    data\seen := \p
@: Self (
    int: x 40
    int: y 41
    @: p int Self[0]
    p := Self[1]
    int: seen 0
    Self\seen := \p
)
@: D (
    int: x 11
    int: y 13
    Target(int: n 30)
    @: p int data[touch()]
    @: s Missing
    int: seen 0
    int: sseen 0
)
@: Code (
    @: p int data[1]
    @: s Target
    data\seen := \p
    data\sseen := s\n
)
@: D2 (
    int: x 21
    int: y 23
    @: p int data[touch()]
    int: seen 0
)
call(Self)
call(D; Code)
call(D2; Writer\code)
int: self_seen Self\seen
int: given_seen D\seen
int: structure_seen D\sseen
int: callable_seen D2\seen
int: ignored_initializers data\calls

sub: observe ()
    shared\Observed\self_seen := self_seen
    shared\Observed\given_seen := given_seen
    shared\Observed\structure_seen := structure_seen
    shared\Observed\callable_seen := callable_seen
    shared\Observed\calls := calls
    shared\Observed\ignored_initializers := ignored_initializers
observe()
