# Explicit reference binding whose candidate is a formal: `@: Model b c` binds b to the Structure
# the caller passed (Structure values are references; the formal binds the caller's) -- the caller reads the write made
# through b.  Entry 7.
Model:
    size_t: value 1U
end: Model

Other:
    int: p 1
    int: q 2
end: Other

fn: m (Model: c) int
    @: Model b c
    b\value: 9U
    return: 7
end: m

fn: probe () int
    int: out 0
    mo: merge Model
    int: t m(mo)
    if: mo\value = 9U
        out: t
    return: out
end: probe

sendMessage: exit(exit_code: probe(); stdout: ""; stderr: "")
return
