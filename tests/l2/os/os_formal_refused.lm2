# The same name and arity, another formal type: the os branches give the method two contracts.
os:
    win:
        fn: os_id (int: n) int
            return: n
        end: os_id
    default:
        fn: os_id (size_t: n) int
            return: (cast: (int) n)
        end: os_id
end: os
sendMessage: exit(exit_code: os_id(7); stdout: ""; stderr: "")
return
