# A `for` at the root (OPUS-WALKLOOP-20260929-11): its counter is a field declared in a nested body -- the for frame
# -- which the walked root refuses as it refuses any such field, at the counter.
int: s 0
for: int(i, 1) (i <= 3) i++
    s: s + i
end: for
sendMessage: exit(exit_code: s; stdout: ""; stderr: "")
return
