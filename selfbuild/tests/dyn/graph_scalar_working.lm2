# The assertion owner uses the C ABI. The Code bodies below are parsed and
# executed as ordinary Structures over supplied typed DATA, without a fake fn.
# The nested launch over the same data goes through the structural link (step 21.7 K2, S3: no form of call supplies
# a data): the owner builds Touch as a child of the data object it creates, in its slot 4, and both bodies choose it
# by `call(code := data\Touch)`, over parent(Touch) = that data; the former records `call: data Touch` are no form.
predef: "l2src/l2_graph_build.lm1"
predef: "l2src/lmx_graph.h.lm1"
predef: "l2src/lmx_graph_run.h.lm1"
predef: "l2src/lmx_walk_values.h.lm1"
predef: "l2src/lmx_value_owned.h.lm1"
predef: "l2src/lmx_gc.h.lm1"
predef: "l2src/lmx_call.h.lm1"
predef: "l2src/lmx_pool.h.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>" "<float.h>"

fn: gs_binding (@: name char; @@: source void) const: @: c.LmxScalarABI
    return: c.lmx_graph_scalar_binding(c.lmx_graph_intern(name, c.strlen(name)), source)

fn: gs_cell (@: g c.LmxGraph; @: name char; const: (@: abi c.LmxScalarABI); @: source void; @: model c.Lmx; @: physical c.Lmx; @: bytes void) @: void
    c.LmxWalkValue: context
    c.LmxWalkValue: value
    @: context_p c.LmxWalkValue @ context
    @: value_p c.LmxWalkValue @ value
    @: cell void 0
    c.lmx_walk_value_clear(context_p)
    context_p\source_type := source
    context_p\model := model
    if: bytes = 0
        cell := c.lmx_arena_scalar_cells_profiled(g\arena, c.LMX_TYPE_FOREIGN, physical, abi, 1U)
        context_p := c.lmx_value_cell_context(g\arena, cell)
        if: context_p = 0
            return: 0
        context_p\source_type := source
        context_p\model := model
    else:
        if: c.lmx_walk_value_foreign_capture(g\arena, bytes, c.LMX_TYPE_FOREIGN, abi, physical, context_p, value_p) != c.LMX_WALK_OK
            return: 0
        cell := value_p\ref
    ---
    if: cell = 0
        return: 0
    if: c.lmx_graph_name(g, cell, name, c.strlen(name)) != 0
        c.fprintf(c.stderr, "scalar name failed: wanted=%s cell=%p previous=%s\n", name, cell, (cast: (@: char) c.lmx_graph_name_of(g, cell)))
        return: 0
    return: cell

fn: gs_write (@: arena c.LmxArena; @: cell void; @: bytes void; @: model c.Lmx) int
    @: context c.LmxWalkValue c.lmx_value_cell_context(arena, cell)
    c.LmxWalkPlace: place
    c.LmxWalkValue: value
    if: context = 0 || c.lmx_walk_cell_place(arena, cell, 0, @ place) != c.LMX_WALK_OK
        return: 1
    c.LmxWalkValue: producer
    @: producer_p c.LmxWalkValue @ producer
    c.memcpy((cast: (@: void) producer_p), (cast: (const: @: void) context), c.sizeof(c.LmxWalkValue))
    producer_p\model := model
    if: c.lmx_walk_value_foreign_capture(arena, bytes, c.LMX_TYPE_FOREIGN, (cast: (const: @: c.LmxScalarABI) context\scalar_abi), (cast: (@: c.Lmx) context\physical_profile), producer_p, @ value) != c.LMX_WALK_OK
        return: 1
    return: c.lmx_walk_value_store(arena, @ place, @ value)

fn: gs_expect (@: arena c.LmxArena; @: cell void; const: (@: abi c.LmxScalarABI); @: source void; @: model c.Lmx; @: physical c.Lmx; @: bytes void) int
    @: pool c.LmxPool c.lmx_range_cell_pool(arena, cell)
    @: context c.LmxWalkValue c.lmx_value_cell_context(arena, cell)
    if: pool = 0 || pool\type != c.LMX_TYPE_FOREIGN || pool\scalar_abi != abi || pool\profile != physical || context = 0 || context\present = 0 || context\ref != cell || context\scalar_abi != abi || context\source_type != source || context\model != model || context\physical_profile != physical
        return: 1
    return: c.memcmp(cell, bytes, abi\size)

# A real callable enters over supplied DATA through the public frame entry.
# Its first local row must retain ABI/context even for a present0 input.
fn: gs_model_entry (@: g c.LmxGraph; @: code c.Lmx; @: data c.Lmx; @: model c.Lmx; const: (@: absent_abi c.LmxScalarABI); @: source void; @: receiving_model c.Lmx) int
    c.LmxActivation: activation
    c.LmxGraphFrame: frame
    @: frame_p c.LmxGraphFrame @ frame
    @: row c.LmxGraphWork 0
    @: current c.LmxWalkValue 0
    int: status c.lmx_activation_push(g\arena, @ activation, 2, code, 0, 0, 0U, 0)
    if: status != 0
        return: 98
    if: c.lmx_graph_method_data(g, code) != model
        c.lmx_activation_pop(g\arena, @ activation)
        return: 98
    status := c.lmx_graph_work_open_data(g, code, data, frame_p)
    if: status = 0
        row := frame_p\rows
        current := (cast: (@: c.LmxWalkValue) (@ row\value))
        if: absent_abi != 0 && (frame_p\count = 0U || current\present != 0 || current\kind != c.LMX_WALK_VALUE_FOREIGN || current\scalar_abi != absent_abi || current\source_type != source || current\model != receiving_model)
            status := 98
        status := c.lmx_graph_work_finish(g, frame_p, status)
    ---
    c.lmx_activation_pop(g\arena, @ activation)
    return: status

# Entry keeps a ready immutable value's identity. An absent immutable local
# owns initialized storage without loading the source's poisoned payload.
fn: gs_immutable_entry (@: g c.LmxGraph; @: code c.Lmx; @: data c.Lmx; @: raw void; @: bytes void; int: present) int
    c.LmxActivation: activation
    c.LmxGraphFrame: frame
    c.LmxWalkValue: expected
    @: expected_p c.LmxWalkValue @ expected
    @: frame_p c.LmxGraphFrame @ frame
    @: row c.LmxGraphWork 0
    @: current c.LmxWalkValue 0
    @: context c.LmxWalkValue c.lmx_value_cell_context(g\arena, raw)
    @: pool c.LmxPool 0
    @: name char 0
    int: status 0
    if: context = 0
        return: 129
    status := c.lmx_activation_push(g\arena, @ activation, 2, code, 0, 0, 0U, 0)
    if: status != 0
        return: 129
    status := c.lmx_graph_work_open_data(g, code, data, frame_p)
    if: status = 0
        if: frame_p\count = 0U
            status := 129
        else:
            row := frame_p\rows
            current := (cast: (@: c.LmxWalkValue) (@ row\value))
            pool := c.lmx_range_cell_pool(g\arena, (cast: (@: void) row\cell))
            c.memcpy((cast: (@: void) expected_p), (cast: (const: @: void) context), c.sizeof(c.LmxWalkValue))
            expected_p\ref := row\cell
            if: pool = 0 || pool\type != 0 - c.LMX_TYPE_FOREIGN || pool\profile != context\physical_profile || pool\scalar_abi != context\scalar_abi || current\present != present || c.memcmp((cast: (const: @: void) current), (cast: (const: @: void) expected_p), c.sizeof(c.LmxWalkValue)) != 0 || c.memcmp((cast: (const: @: void) row\cell), bytes, pool\scalar_abi\size) != 0
                status := 129
            if: present != 0
                name := c.lmx_graph_name_of(g, raw)
                if: row\cell != raw || name = 0 || c.lmx_graph_operand_name(g, code, name) != raw
                    status := 129
                ---
            else:
                if: row\cell = raw
                    status := 129
            ---
        ---
        status := c.lmx_graph_work_finish(g, frame_p, status)
    ---
    c.lmx_activation_pop(g\arena, @ activation)
    return: status

# Both physical copies lose Model A; only the outer working Values retain it.
fn: gs_touch (@: owner void; @@: refs void; size_t: nargs; @: dest void; @@: out void; @: arena c.LmxArena; @: code c.Lmx; @: inputs c.LmxWalkValue; @: result c.LmxWalkValue) int
    @: g c.LmxGraph arena\graph_metadata
    @: data c.Lmx (cast: (@: c.Lmx) owner)
    @: replacement void c.lmx_graph_get(data, 2U)
    c.LmxWalkValue: value
    c.LmxWalkPlace: place
    @: original c.LmxWalkValue c.lmx_value_cell_context(arena, c.lmx_graph_get(data, 1U))
    @: model_a c.Lmx 0
    @: pool c.LmxPool c.lmx_range_cell_pool(arena, replacement)
    @: chunk c.LmxChunk 0
    @: contexts c.LmxWalkValue 0
    size_t: i 0U
    size_t: cleared 0U
    int: nested_space 0
    int: gc_status 0
    if: data = code || nargs != 0U || c.lmx_walk_value_cell(arena, replacement, @ value) != c.LMX_WALK_OK
        return: 91
    if: original = 0 || pool = 0
        return: 95
    model_a := original\model
    while: i < 2U
        if: c.lmx_walk_cell_place(arena, c.lmx_graph_get(data, i), 0, @ place) != c.LMX_WALK_OK || c.lmx_walk_value_store(arena, @ place, @ value) != c.LMX_WALK_OK
            return: 92
        i := i + 1U
    ---
    # Chunk GC follows every physical companion, including obsolete snapshots.
    # Remove those physical edges; the independent current row Values keep A.
    chunk := c.lmx_pool_chunk_head(pool)
    while: chunk != 0
        contexts := (cast: (@: c.LmxWalkValue) chunk\value_contexts)
        i := 0U
        while: contexts != 0 && i < c.lmx_chunk_cells(chunk, (cast: (size_t) pool\stride))
            original := contexts + i
            if: original\model = model_a
                original\model := 0
                cleared := cleared + 1U
            i := i + 1U
        ---
        chunk := (cast: (@: c.LmxChunk) chunk\next)
    ---
    if: model_a = 0 || cleared = 0U
        return: 95
    # Construction can suspend the calling traversal's namespace. Its
    # receiver catalogs must remain live through that existing prior link.
    nested_space := c.lmx_graph_space_push_fresh(g, data)
    if: nested_space != 1
        return: 99
    gc_status := c.lmx_gc_sweep(arena, c.lmx_arena_generation_next(arena))
    c.lmx_graph_space_pop(g, nested_space)
    if: gc_status != c.LMX_GC_OK
        return: 93
    if: out != 0
        out[0] := 0
    if: result != 0
        c.lmx_walk_value_clear(result)
    return: 0

# The assertion owner keeps the current int-reference chunk through one real
# reference cell. It fills that chunk before the call, isolating pending actuals in a new chunk.
# The full-Value route no longer consumes that temporary reference wrapper.
# Its target survives as the received Value; this unused wrapper is reclaimed.
# Complete pending-Value metadata lifetime is covered by graph_call_values.
fn: gs_pending_collect (@: owner void; @@: refs void; size_t: nargs; @: dest void; @@: out void; @: arena c.LmxArena; @: code c.Lmx; @: inputs c.LmxWalkValue; @: result c.LmxWalkValue) int
    @: pool c.LmxPool arena\arrays
    @: pending void 0
    @: counter void c.lmx_graph_get((cast: (@: c.Lmx) owner), 0U)
    @: source void 0
    const: (@: abi c.LmxScalarABI gs_binding("int", @ source))
    c.LmxWalkValue: value
    int: number 7
    if: nargs != 0U || counter = 0 || abi = 0
        return: 120
    while: pool != 0
        if: pool\type = c.LMX_TYPE_GRAPH_INT_REF && pool\tail != 0 && pool\tail != pool\head
            pending := c.lmx_chunk_data(pool\tail)
            break
        pool := pool\next
    if: pending = 0 || c.lmx_range_cell_pool(arena, pending) = 0
        return: 121
    if: c.lmx_gc_sweep(arena, c.lmx_arena_generation_next(arena)) != c.LMX_GC_OK || c.lmx_range_cell_pool(arena, pending) != 0
        return: 122
    if: c.lmx_int_store_known(counter, c.lmx_int_value_known(counter) + 1) != 0 || c.lmx_walk_value_foreign_capture(arena, @ number, c.LMX_TYPE_FOREIGN, abi, 0, 0, @ value) != c.LMX_WALK_OK
        return: 123
    return: c.lmx_call_result_value(arena, code, @ value, dest, out, result)

fn: gs_pending_actuals () int
    c.LmxArena: arena
    @: g c.LmxGraph 0
    @: root c.Lmx 0
    @: collect c.Lmx 0
    @: data c.Lmx 0
    @: counter void 0
    @: answer void 0
    @: pool c.LmxPool 0
    @: first_chunk c.LmxChunk 0
    @: target void 0
    @: anchor void 0
    @: pending c.Lmx 0
    @: file c.FILE 0
    c.LmxExecutionRoots: anchor_roots
    @: roots_before c.LmxExecutionRoots 0
    unsigned: gen 0U
    int: opened 0
    int: status 0
    int: number 0
    int: span_ok 0
    c.memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: c.lmx_arena_open(@ arena) != 0
        return: 124
    g := c.lmx_graph_open(@ arena)
    file := c.fopen("graph_pending_actuals.lm3", "wb")
    if: g = 0 || file = 0
        return: 124
    if: c.fputs("fn: Pending (@: first int; int: second) int\n    return: \\first + second\nend: Pending\n\nfn: Collect () int (int: count 0)\n    return: 7\nend: Collect\n\nint: number 73\nint: answer 0\nanswer := Pending(@number; Collect())\nanswer := Pending(@number; Collect())\nsub: publish ()\n    node\\answer := answer\npublish()\n", file) < 0 || c.fclose(file) != 0
        return: 124
    status := c.lm_graph_build_file(g, "graph_pending_actuals.lm3", @ root)
    c.remove("graph_pending_actuals.lm3")
    if: status != 0 || root = 0 || c.lmx_graph_space_open(g, root, @ opened) != 0
        c.fprintf(c.stderr, "pending setup build/space status=%d root=%p opened=%d\n", status, (cast: (@: void) root), opened)
        return: 125
    collect := (cast: (@: c.Lmx) c.lmx_graph_resolve(g, root, c.lmx_graph_intern("Collect", 7U)))
    data := c.lmx_graph_method_data(g, collect)
    counter := c.lmx_graph_get(data, 0U)
    if: collect = 0 || counter = 0
        c.fprintf(c.stderr, "pending setup Collect=%p data=%p counter=%p\n", (cast: (@: void) collect), (cast: (@: void) data), counter)
        return: 125
    pending := (cast: (@: c.Lmx) c.lmx_graph_resolve(g, root, c.lmx_graph_intern("Pending", 7U)))
    target := c.lmx_graph_get(root, c.lmx_graph_named(g, root, c.lmx_graph_intern("number", 6U)))
    anchor := c.lmx_graph_ref_int(g, target)
    pool := c.lmx_range_cell_pool(@ arena, anchor)
    if: pending = 0 || pool = 0 || pool\type != c.LMX_TYPE_GRAPH_INT_REF || pool\tail = 0 || c.lmx_graph_kind(g, target) != 1
        c.fprintf(c.stderr, "pending setup Pending=%p target=%p kind=%d anchor=%p pool=%p\n", (cast: (@: void) pending), target, c.lmx_graph_kind(g, target), anchor, (cast: (@: void) pool))
        if: pool != 0
            c.fprintf(c.stderr, "pending setup pool type=%d expected=%d head=%p tail=%p\n", (cast: (int) pool\type), c.LMX_TYPE_GRAPH_INT_REF, (cast: (@: void) pool\head), (cast: (@: void) pool\tail))
        ---
        return: 125
    first_chunk := c.lmx_pool_chunk_at(pool, anchor)
    if: first_chunk = 0 || first_chunk != pool\tail
        c.fprintf(c.stderr, "pending setup anchor chunk=%p tail=%p\n", (cast: (@: void) first_chunk), (cast: (@: void) pool\tail))
        return: 125
    while: c.lmx_chunk_cells(first_chunk, pool\stride) < c.lmx_chunk_room(first_chunk, pool\stride)
        if: c.lmx_graph_ref_int(g, target) = 0
            c.fprintf(c.stderr, "pending setup filling reference anchor chunk: cells=%zu room=%zu\n", (cast: (size_t) c.lmx_chunk_cells(first_chunk, pool\stride)), c.lmx_chunk_room(first_chunk, pool\stride))
            return: 125
    ---
    if: c.lmx_native_install(@arena, collect, (cast: (c.LmxPrimitiveEntry) c.gs_pending_collect), 0, 0, 0, 0, 0) != 0
        return: 1
    roots_before := c.lmx_execution_roots_mark(@ arena)
    c.lmx_execution_roots_push(@ arena, @ anchor_roots, 0, 0U, (cast: (@@: void) (@ anchor)), 1U, 0, 0)
    status := c.lmx_graph_call(g, root)
    span_ok := (cast: (int) (arena\execution_roots = @ anchor_roots))
    c.lmx_execution_roots_restore(@ arena, roots_before)
    answer := c.lmx_graph_get(root, c.lmx_graph_named(g, root, c.lmx_graph_intern("answer", 6U)))
    if: status != 0 || c.lmx_graph_value_int(g, answer, @ number) != 0 || number != 80 || c.lmx_int_value_known(counter) != 2 || arena\activation != 0 || span_ok = 0 || arena\execution_roots != 0
        c.fprintf(c.stderr, "pending actuals status=%d answer=%d counter=%d\n", status, number, c.lmx_int_value_known(counter))
        return: 126
    # The retained declaration namespace legitimately owns older reference
    # chunks. Close it before proving that only the explicit anchor survives.
    c.lmx_graph_space_close(g, opened)
    opened := 0
    # Neither an execution span nor its transient pointers survive the call.
    gen := c.lmx_arena_generation_next(@ arena)
    if: c.lmx_gc_mark_value(@ arena, anchor, gen, 0) != c.LMX_GC_OK || c.lmx_gc_sweep(@ arena, gen) != c.LMX_GC_OK
        return: 127
    pool := arena\arrays
    while: pool != 0
        if: pool\type = c.LMX_TYPE_GRAPH_INT_REF && (pool\head != first_chunk || pool\tail != first_chunk)
            return: 128
        pool := pool\next
    c.lmx_graph_space_close(g, opened)
    c.lmx_graph_close(g)
    c.lmx_arena_release(@ arena)
    return: 0

fn: gs_working_check () int
    int: pending_status gs_pending_actuals()
    if: pending_status != 0
        return: pending_status
    c.LmxArena: arena
    c.memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: c.lmx_arena_open(@ arena) != 0
        return: 80
    @: g c.LmxGraph c.lmx_graph_open(@ arena)
    @: root c.Lmx 0
    @: file c.FILE c.fopen("graph_scalar_working_code.lm3", "wb")
    @: source void 0
    @: alias_source void 0
    @: float_source void 0
    const: (@: abi c.LmxScalarABI gs_binding("double", @ source))
    const: (@: alias_abi c.LmxScalarABI gs_binding("f64", @ alias_source))
    const: (@: narrow_abi c.LmxScalarABI gs_binding("float", @ float_source))
    double: zero (cast: (double) 0)
    double: precise (cast: (double) 1) + c.DBL_EPSILON
    double: replacement c.strtod("3.5", 0)
    double: empty_bytes zero
    double: immutable_bytes zero
    float: narrow (cast: (float) 1) + c.FLT_EPSILON
    @: physical c.Lmx c.lmx_node_new_owned(@ arena)
    @: profile_a c.Lmx c.lmx_node_new_owned(@ arena)
    @: profile_b c.Lmx c.lmx_node_new_owned(@ arena)
    @: model_a c.Lmx c.lmx_node_new_profiled(@ arena, profile_a)
    @: model_b c.Lmx c.lmx_node_new_profiled(@ arena, profile_b)
    @: data c.Lmx c.lmx_graph_lmx(g, 0, 5U)
    @: x void gs_cell(g, "x", abi, source, model_b, physical, @ zero)
    @: y void gs_cell(g, "y", abi, alias_source, model_a, physical, @ precise)
    @: z void gs_cell(g, "z", abi, source, model_b, physical, @ replacement)
    @: saved void gs_cell(g, "saved", abi, source, model_b, physical, @ zero)
    @: empty void gs_cell(g, "empty", abi, source, model_b, physical, 0)
    @: copy_code c.Lmx 0
    @: fill_code c.Lmx 0
    @: protected_code c.Lmx 0
    @: snapshot_code c.Lmx 0
    @: touch_code c.Lmx 0
    @: read_code c.Lmx 0
    @: rejected c.Lmx 0
    @: empty_data c.Lmx 0
    @: immutable_data c.Lmx 0
    @: immutable_empty_data c.Lmx 0
    @: immutable_x void 0
    @: immutable_empty void 0
    @: returned_pool c.LmxPool 0
    @: wrong void 0
    @: scalar_model c.Lmx 0
    @: scalar_actual c.Lmx 0
    @: wrong_x void 0
    @: absent_x void 0
    @: hold_code c.Lmx 0
    @: replace_code c.Lmx 0
    @: int_code c.Lmx 0
    @: forward_code c.Lmx 0
    @: forward_hold_code c.Lmx 0
    @: int_data c.Lmx 0
    @: int_cell void 0
    @: int_source void 0
    const: (@: int_abi c.LmxScalarABI gs_binding("c.int", @ int_source))
    @: address_a void 0
    @: address_b void 0
    @: delivery_cell void 0
    @: delivery_out void 0
    @: rejected_delivery void 0
    float: rejected_bytes (cast: (float) 0)
    size_t: data_slot 0U
    int: integer 73
    int: integer_read 0
    int: hold_shape 0
    int: hold_entry 0
    c.LmxWalkValue: returned
    c.LmxWalkValue: boxed
    c.LmxExecutionRoots: code_roots
    @: roots_before c.LmxExecutionRoots 0
    @@: held_codes void c.calloc(5U, sizeof(@: void))
    @: context c.LmxWalkValue 0
    c.LmxWalkValue: before
    c.LmxWalkValue: absent
    int: status 0
    int: opened 0
    if: g = 0 || file = 0 || abi = 0 || alias_abi != abi || alias_source = source || narrow_abi = 0 || physical = 0 || profile_a = 0 || profile_b = 0 || model_a = 0 || model_b = 0 || data = 0 || x = 0 || y = 0 || z = 0 || saved = 0 || empty = 0
        return: 81
    if: c.fputs("Copy:\n    x := y\n    y := z\n    saved := x\n    return: saved\nend: Copy\n\nFill:\n    empty := y\n    return: empty\nend: Fill\n\nsub: Read ()\n    saved := x\nend: Read\n\nSnapshot:\n    x := y\n    call(code := data\\Touch)\n    saved := x\n    return: saved\nend: Snapshot\n", file) < 0
        return: 82
    if: c.fputs("\nProtected:\n    data\\x := data\\y\nend: Protected\n", file) < 0
        return: 82
    if: c.fputs("\nfn: GSHold () double\n    finally:\n        call(code := data\\Touch)\n    end: finally\n    return: data\\y\nend: GSHold\n\nfn: GSReplace () f64\n    finally:\n        return: data\\z\n    end: finally\n    return: data\\y\nend: GSReplace\n\nfn: GSCInt () int\n    return: data\\number\nend: GSCInt\n\nfn: GSForward () int\n    return: GSCInt()\nend: GSForward\n\nfn: GSForwardHold () double\n    return: GSHold()\nend: GSForwardHold\n", file) < 0 || c.fclose(file) != 0
        return: 82
    status := c.lm_graph_build_file(g, "graph_scalar_working_code.lm3", @ root)
    c.remove("graph_scalar_working_code.lm3")
    if: status != 0 || root = 0
        return: 83
    if: c.lmx_graph_space_open(g, root, @ opened) != 0
        return: 83
    copy_code := (cast: (@: c.Lmx) c.lmx_graph_get(root, c.lmx_graph_named(g, root, c.lmx_graph_intern("Copy", 4U))))
