Example:
    int[]: xs
    int: seed
    return: @
    run:
        throws: copy(FxSeqPush\append\throws) copy(record\throws)
        @[]: out []
        int: total seed
        FxSeqPush\append(out; (total record))
        int: i 0
        while: i < length(xs)
            total += xs[i]
            FxSeqPush\append(out; (total record))
            i += 1
        return: out
