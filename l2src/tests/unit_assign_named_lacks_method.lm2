# In a method, `Model:` + fields assigns that Structure to the root's named Structure Model: the assignment with
# admission (book §9 :561), by name (the author's Q39, D-105), as at the root.  Model's field value has no field of
# that name in it -- refused by admission (OPUS-Q54-CONTINUE-20260929-14).
Model:
    size_t: value 1U
fn: m () int
    Model:
        size_t: other 2U
    return: 7
end: m
int: r 0
r: m()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
