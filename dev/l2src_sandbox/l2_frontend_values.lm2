fn: lm_compiler_ret_cell_ty (int: mi) int
    @: foreign_n_cell int (cast: (@: int) (@ c.l2_foreign_n))
    @@: foreign_depth_cell int (cast: (@@: int) (@ c.l2_foreign_depth))
    int: rt lm_compiler_sig_ret(mi)
