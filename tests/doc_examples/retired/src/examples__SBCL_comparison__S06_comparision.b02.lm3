Negative:
    int: value
    return: int
    accepts:
        return: value < 0

Example:
    int[]: items
    return: int
    run:
        throws: copy(FxThrows\predicate) FxRecordArity
        @: found index(items; Negative\accepts)
        if: found\present = 0
            return: -1
        return: \found\value
