                # K04: what reaches the formal is recorded (l2_cfl_note): the method named, or the caller's
                # own formal handed on.
                if: check_unevaluated_cell[0] = 0 && cf_kind = 1 && c.lm_compiler_cfl_note(idx, mi, fi, actual_i, 1, cand_mi, 0 - 1, source_node) != 0
                    return: (cast: (int) (1))
                if: check_unevaluated_cell[0] = 0 && cf_kind = 2 && c.lm_compiler_cfl_note(idx, mi, fi, actual_i, 2, mi, cf_fi, source_node) != 0
