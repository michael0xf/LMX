+        throws:
+            FxCallFailure
+            FxKernelFailure
+            FxPredicate
+            FxTypeToken
+            ReceiverIndex
+            SequenceElement
+            SequenceSize
+        private: @: info FxSeqInfo\get(items)
+        private: int: count length(items)
+        private: @: result FxSeqAllocate\make(info\arrayType; count)
+        private: int: used 0
+        private: int: i 0
