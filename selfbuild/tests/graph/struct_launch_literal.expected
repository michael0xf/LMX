---
    Observed:
        int: seen 8
        int: after 12
    end: Observed
---
sub: main () (
    Total:
        int: sum 0
    end: Total
    Add: (:= (Total \ sum) ((Total \ sum) + v))
    int: seen 0
)
    fn: f () int
        Add: (:= data ((int v 5)))
        call: ((int v 3)) Add
        return: (Total \ sum)
    end: f
    :=: (data \ seen) (f)
end: main
main:
int: seen ((main \ data) \ seen)
call: ((int v 4)) ((main \ data) \ Add)
int: after (((main \ data) \ Total) \ sum)
sub: observe ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) seen
    :=: ((shared \ Observed) \ after) after
end: observe
observe:
