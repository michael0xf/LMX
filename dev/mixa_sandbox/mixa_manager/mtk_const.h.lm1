# mtk_const.h.lm1 - Constants from Const.java interface (com.mtk.map).
# Pure-define unit: Const.java has no methods, only static final fields.
# No struct or prototype block; consumers include this header for sentinels.

define: MTK_CONST_NIL (-2147483647 - 1)   # Integer.MIN_VALUE
define: MTK_CONST_FNIL (0.0f / 0.0f)      # Float.NaN
define: MTK_CONST_ERROR (-1)
define: MTK_CONST_EOF (-1)
