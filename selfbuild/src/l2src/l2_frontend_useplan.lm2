# Original: l2src/l2trans.lm1:8570
fn: lm_compiler_reference_source_core (@: first c.LmP0Field; int: n; int: mi; @: out c.L2ReferenceSource) int
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
