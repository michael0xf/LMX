# Sequence algorithms with explicit comparison/encoding profiles.
# Public value adapters retain exact Array/result types; internal @ values are
# complete typed records. Text defaults apply only in the text representation.

FxSequenceSearch:
    private:
        @: text
        @: part
        int: start
        int: backwards
        @: same 0
    required: text part start backwards
    return: int
    search:
        throws: copy(FxThrows\predicate)
        FxSeqInfo\get(text)
        FxSeqInfo\get(part)
        if: length(part) > length(text)
            return: -1
        private: int: last length(text) - length(part)
        private: int: at start
        private: int: step 1
        private: int: stop last
        if: at < 0
            at := 0
        if: backwards != 0
            step := -1
            stop := 0
            if: at > last
                at := last
        ---
        else:
            if: at > last
                return: -1
        ---
        while: 1
            if: FxSequenceDifference\find(text; part; same; at; length(part)) < 0
                return: at
            if: at = stop
                return: -1
            at += step

FxIndexOf:
    private:
        @: text
        @: part
        int: start 0
        @: same 0
    required: text part
    return: int
    indexOf:
        throws: copy(FxThrows\predicate)
        return: FxSequenceSearch\search(text; part; start; 0; same)

FxLastIndexOf:
    private:
        @: text
        @: part
        int: start length(text)
        @: same 0
    required: text part
    return: int
    lastIndexOf:
        throws: copy(FxThrows\predicate)
        return: FxSequenceSearch\search(text; part; start; 1; same)

FxValueOrder:
    private:
        @: first
        @: second
        @: order 0
    required: first second
    return: int
    compare:
        throws: copy(FxThrows\call)
        if: order != 0
            private: @: record FxApply\apply(order; FxTwo\make(first; second))
            private: int: result \record
            return: (result > 0) - (result < 0)
        return: (\first > \second) - (\first < \second)

FxByteOrder:
    private:
        char: first
        char: second
    required: first second
    return: int
    compare:
        private: int: a first
        private: int: b second
        if: a < 0
            a += 256
        if: b < 0
            b += 256
        return: (a > b) - (a < b)

FxCompare:
    private:
        @: first
        @: second
        @: order 0
    required: first second
    return: int
    compare:
        throws: copy(FxThrows\traversal)
        private: @: a FxSeqInfo\get(first)
        private: @: b FxSeqInfo\get(second)
        private: @: selected order
        if: selected = 0 && a\elementType = char && b\elementType = char
            selected := FxByteOrder\compare
        private: int: i 0
        while: i < length(first) && i < length(second)
            private: int: compared FxValueOrder\compare(FxSeqRead\read(first; i); FxSeqRead\read(second; i); selected)
            if: compared != 0
                return: compared
            i += 1
        return: (length(first) > length(second)) - (length(first) < length(second))

FxTrimMember:
    private:
        @: item
        @: members
        @: predicate 0
        @: same 0
    required: item members
    return: int
    test:
        throws: copy(FxThrows\predicate) FxShape
        if: predicate != 0
            return: FxSeqPredicate\truth(FxApply\apply(predicate; FxOne\make(item)))
        return: FxKeyIndex\find(members; item; same) >= 0

FxSequenceTrim:
    private:
        @: text
        @: members
        int: side
        @: predicate 0
        @: same 0
    required: text members side
    return: @
    trim:
        throws: copy(FxThrows\predicate) FxShape SequenceSize
        FxSeqInfo\get(text)
        FxSeqInfo\get(members)
        private: int: begin 0
        private: int: end length(text)
        if: side != 2
            while: begin < end
                if: FxTrimMember\test(FxSeqRead\read(text; begin); members; predicate; same) = 0
                    break
                begin += 1
        ---
        if: side != 1
            while: end > begin
                if: FxTrimMember\test(FxSeqRead\read(text; end - 1); members; predicate; same) = 0
                    break
                end -= 1
        ---
        return: FxSeqSlice\slice(text; begin; end)

FxTrimInputs:
    private:
        @: text
        @: chars
        @: predicate 0
        @: same 0
    required: text chars
    return: @

FxTrim:
    copy: FxTrimInputs
    trim:
        throws: copy(FxThrows\predicate) FxShape SequenceSize
        return: FxSequenceTrim\trim(text; chars; 0; predicate; same)

FxTrimStart:
    copy: FxTrimInputs
    trim:
        throws: copy(FxThrows\predicate) FxShape SequenceSize
        return: FxSequenceTrim\trim(text; chars; 1; predicate; same)

FxTrimEnd:
    copy: FxTrimInputs
    trim:
        throws: copy(FxThrows\predicate) FxShape SequenceSize
        return: FxSequenceTrim\trim(text; chars; 2; predicate; same)

FxSequencePad:
    private:
        @: text
        int: width
        @: fill
        int: right
    required: text width fill right
    return: @
    pad:
        throws: copy(FxThrows\sequence)
        FxSeqInfo\get(text)
        FxSeqInfo\get(fill)
        if: width <= length(text)
            return: FxSeqSlice\slice(text; 0; length(text))
        private: int: missing width - length(text)
        if: length(fill) = 0
            throw: SequenceSize()
        private: int: count missing / length(fill)
        private: int: rest missing % length(fill)
        private: @: padding FxStdCycle\cycle(fill; count)
        private: @: tail FxSeqSlice\slice(fill; 0; rest)
        private: @: extra FxSeqConcat\concat((padding; tail))
        if: right != 0
            return: FxSeqConcat\concat((text; extra))
        return: FxSeqConcat\concat((extra; text))

FxPadInputs:
    private:
        @: text
        int: width
        @: fill
    required: text width fill
    return: @

FxPadLeft:
    copy: FxPadInputs
    pad:
        throws: copy(FxThrows\sequence)
        return: FxSequencePad\pad(text; width; fill; 0)

FxPadRight:
    copy: FxPadInputs
    pad:
        throws: copy(FxThrows\sequence)
        return: FxSequencePad\pad(text; width; fill; 1)

FxTranslate:
    private:
        @: text
        @: from
        @: to
        @: same 0
    required: text from to
    return: @
    translate:
        throws: copy(FxThrows\predicate) FxShape SequenceElement SequenceSize
        FxSeqInfo\get(text)
        FxSeqInfo\get(from)
        FxSeqInfo\get(to)
        if: length(from) != length(to)
            throw: SequenceSize()
        private: @: out FxSeqSlice\slice(text; 0; length(text))
        private: int: i 0
        while: i < length(text)
            private: int: found FxKeyIndex\find(from; FxSeqRead\read(text; i); same)
            if: found >= 0
                FxSeqStore\write(out; i; FxSeqRead\read(to; found))
            i += 1
        return: out

FxRemoveAffix:
    private:
        @: text
        @: affix
        int: suffix
        @: same 0
    required: text affix suffix
    return: @
    remove:
        throws: copy(FxThrows\predicate) SequenceSize
        FxSeqInfo\get(text)
        FxSeqInfo\get(affix)
        private: int: begin 0
        private: int: end length(text)
        private: int: at 0
        if: length(affix) <= end
            if: suffix != 0
                at := end - length(affix)
            if: FxSequenceDifference\find(text; affix; same; at; length(affix)) < 0
                if: suffix != 0
                    end -= length(affix)
                else:
                    begin := length(affix)
        ---
        return: FxSeqSlice\slice(text; begin; end)

FxAffixInputs:
    private:
        @: text
        @: affix
        @: same 0
    required: text affix
    return: @

FxRemovePrefix:
    copy: FxAffixInputs
    remove:
        throws: copy(FxThrows\predicate) SequenceSize
        return: FxRemoveAffix\remove(text; affix; 0; same)

FxRemoveSuffix:
    copy: FxAffixInputs
    remove:
        throws: copy(FxThrows\predicate) SequenceSize
        return: FxRemoveAffix\remove(text; affix; 1; same)

# Exact integer encoding is one explicit format/parse profile.

FxFormat:
    private:
        bigint: value
        int: base 10
    return: char[]
    format:
        throws: copy(FxThrows\selection)
        if: base < 2 || base > 36
            throw: FxIndex()
        private: char[]: digits "0123456789abcdefghijklmnopqrstuvwxyz"
        private: bigint: magnitude value
        private: int: negative value < 0
        if: negative != 0
            magnitude := -magnitude
        private: char[]: out []
        private: @: info FxSeqInfo\get(out)
        while: 1
            private: int: digit magnitude % base
            private: int: at length(out)
            sys\resize(out; FxSeqSize\sum(at; 1; info\maxLength))
            out[at] := digits[digit]
            magnitude := magnitude / base
            if: magnitude = 0
                break
        ---
        if: negative != 0
            out := \FxSeqConcat\concat((out; "-"))
        return: \FxSeqReverse\reverse(out)

FxParse:
    private:
        char[]: text
        int: base 10
    return: bigint
    parse:
        throws: NumericDomain copy(FxThrows\predicate) FxShape FxRecordArity
        if: base < 2 || base > 36 || length(text) = 0
            throw: NumericDomain()
        private: char[]: digits "0123456789abcdefghijklmnopqrstuvwxyz"
        private: int: at 0
        private: int: negative 0
        if: text[0] = '-' || text[0] = '+'
            negative := text[0] = '-'
            at := 1
        if: at = length(text)
            throw: NumericDomain()
        private: bigint: result 0
        while: at < length(text)
            private: char: value text[at]
            if: value >= 'A' && value <= 'Z'
                value := value - 'A' + 'a'
            private: int: digit FxKeyIndex\find(digits; (value FxRecordOperands\record))
            if: digit < 0 || digit >= base
                throw: NumericDomain()
            result := result * base + digit
            at += 1
        if: negative != 0
            result := -result
        return: result

