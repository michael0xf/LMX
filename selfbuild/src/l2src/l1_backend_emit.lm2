        c.lm_p0_document_destroy((cast: (@: c.LmP0Document) (document)))
        c.l1_imp_pop()
        return: (cast: (int) (1))
    root: c.lm_p0_document_root((cast: (const: @: c.LmP0Document) (document)))
    if: root = 0
        c.lm_p0_document_destroy((cast: (@: c.LmP0Document) (document)))
        c.fprintf(c.stderr, "l1trans error: %s:1:1: empty implicit L1 body\n", in_path)
        c.l1_imp_pop()
        return: (cast: (int) (1))
    if: l1_hdr_register_unit(root, in_path, depth) != 0
        c.lm_p0_document_destroy((cast: (@: c.LmP0Document) (document)))
        c.l1_imp_pop()
        return: (cast: (int) (1))
    if: c.l1_hdr_mark_unit_emitted(root, in_path) != 0
        c.lm_p0_document_destroy((cast: (@: c.LmP0Document) (document)))
        c.l1_imp_pop()
        return: (cast: (int) (1))
    c.lm_p0_document_destroy((cast: (@: c.LmP0Document) (document)))
    c.l1_imp_pop()
    if: c.l1_imp_push(0, in_path) != 0
        return: (cast: (int) (c.l1_error(in_path, 0, "cannot store import path")))
    return: (cast: (int) (0))
end: l1_hdr_register_path

