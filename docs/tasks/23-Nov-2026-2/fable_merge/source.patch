+    private:
+        char[]: text
+        char[]: affix
+    return: char[]
+
+FxRemovePrefix:
+    copy: FxAffixInputs
+    remove:
+        throws: copy(FxThrows\sequence)
+        return: FxRemoveAffix\remove(text; affix; 0)
+
+FxRemoveSuffix:
+    copy: FxAffixInputs
+    remove:
+        throws: copy(FxThrows\sequence)
+        return: FxRemoveAffix\remove(text; affix; 1)
