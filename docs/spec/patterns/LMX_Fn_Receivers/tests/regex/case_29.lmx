@: named choice(patterns := alternatives)
@: unnamed choice(patterns := ([]Pattern: [literal("cat") literal("dog")]))
(matches(utf8Text("cat"); named); matches(utf8Text("dog"); unnamed); matches(utf8Text("cow"); named))
