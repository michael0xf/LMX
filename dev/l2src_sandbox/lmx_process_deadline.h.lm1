include: "<windows.h>"
predef: "l2src/lmx.h.lm1"

# THE PROCESS DEADLINE: ONE COARSE, ONE-SHOT, INDEPENDENT WATCHDOG FOR ONE SYNCHRONOUS OPERATION
# (author's ruling of 2026-09-21, via Codex: the upper frame's close may not depend on the operation
# returning in order to be bounded).
#
# WHAT IT IS FOR, in one sentence: the cooperative closure checks can only fire where a pass runs, so
# a child body that never returns -- or a lane that never comes back -- cannot be ended by them, and
# a bound that lives on the operation's own stack cannot fire while that stack is stuck.  This module
# owns the bound instead: ONE OS thread waiting ONCE on a completion event shared with the caller.
#
# WHY THE WAIT CAN BE DISARMED WITHOUT POLLING.  The wait is a single `WaitForSingleObject(event,
# ms)`: the caller signals that event when the operation SUCCEEDS, so a successful operation cannot
# be killed later, and the timeout branch is the failure branch.  Nothing is sampled in a loop, there
# is no Sleep-driven polling and no second timestamp -- the wait comes from the operation's ONE
# deadline through the modular helpers, so an already-expired deadline arms a ZERO wait instead of
# underflowing into a word-sized eternity.
#
# WHAT THIS MODULE MAY NOT DO: it is not a Message, Thread, mailbox or graph mechanism; it touches
# none of those and is not reachable from them.  The completion event is synchronisation between ONE
# caller and ONE watchdog of the same operation, nothing else.
#
# WIDTHS, stated because a mistake here is invisible to every test this build can run: the deadline
# is a size_t PLATFORM WORD (lmx_clock_word casts GetTickCount64 directly -- see lmx_clock.h.lm1) and
# the platform's wait parameter is a 32-bit millisecond count, so the wait is clamped, not truncated.
# Precision is NOT a claim of this module: minute-scale tolerance was accepted, and the value is used
# coarsely.

struct: LmxProcessDeadline
    @: void event
    @: void thread
    unsigned: wait_ms
    int: armed
end: LmxProcessDeadline

prototype:
    # Arm one watchdog for ONE operation with the ONE deadline that bounds it; zero is refused as "no
    # bound at all".  Setup failure is FATAL and leaves no partially armed resource behind.
    fn: lmx_process_deadline_arm (@: LmxProcessDeadline d; size_t: deadline) int
    # Disarm and join: signal the event, wait for the watchdog to leave its wait, close both handles.
    fn: lmx_process_deadline_disarm (@: LmxProcessDeadline d) int
    # The watchdog's own entry, named here so the thread start above can cast it.
    fn: lmx_process_deadline_body (@: void arg) DWORD
end: prototype
