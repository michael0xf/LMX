# Probe G: two deref-prefixed operands in one arithmetic expression, no call actual list.
include: "<stdio.h>"
fn: show (@: out int) int
    int: s \out + \out
    if: c.printf("%d\n", s) < 0
        return: 1
    return: 0
end: show
fn: run () int
    int: v 7
    if: show(@ v) != 0
        return: 80
    return: 7
end: run
sendMessage: exit(exit_code: run(); stdout: ""; stderr: "")
return
