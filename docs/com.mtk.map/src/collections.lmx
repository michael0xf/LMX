        @: staged MapVector\range(source; offset; offset + count)
        int: oldSize length(vector)
        int: newSize MapSize\sum(oldSize; count)
        sys\resize(vector; newSize)
        int: i oldSize
        while: i > at
            i -= 1
            vector[i + count] := vector[i]
        i := 0
        while: i < count
            vector[at + i] := staged[i]
            i += 1
        return: count

