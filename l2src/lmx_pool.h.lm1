include: "<stddef.h>"
predef: "l2src/lmx_arena.h.lm1"

# The typed service array's API, declared here so a module can use an array without
# pulling the array's source into its own translation unit.  The unit is lmx_pool.lm1.
#
# An array is one of the arena's N arrays (spec 2, 6.5): it hands out CELLS of one stride
# and grows by adding a CHUNK, and every chunk joins the arena's index as one more
# interval of this same array.  So a cell is classified by the address it lands in, and
# nothing is stored on the cell to say what it is.
#
# The arena is the context of every act here: taking a cell, growing, and joining the
# index are all things the arena's manager performs, so the arena is named explicitly --
# L1 has no hidden state to hang it on.
#
# An array is the owner's storage, not a general allocator: cells are added on demand and
# never individually returned, and nothing relocates (14.8, 14.9: live L1/L2 arena entries
# never move, including at end_turn).  A caller that must reuse cells keeps its own free
# list over them, the way lmx_post does.

prototype:
    # `want` is a floor under THIS one new chunk's width (max(want, pool\chunk_capacity));
    # it is never written back to pool\chunk_capacity, which stays the pool's configured
    # step for every future chunk regardless of `want` here (D-67).  0 = no floor beyond
    # the pool's own step.
    fn: lmx_pool_add_chunk (@: LmxArena arena; @: LmxPool pool; size_t: want) int
    fn: lmx_pool_open (@: LmxArena arena; @: LmxPool pool; size_t: stride; size_t: chunk_capacity; int: kind; int: type) int
    # A nonzero profile is an ordinary graph Structure already visible in arena's
    # local/imported address index; arbitrary or activation-local pointers are refused.
    fn: lmx_pool_open_profiled (@: LmxArena arena; @: LmxPool pool; size_t: stride; size_t: chunk_capacity; int: kind; int: type; @: Lmx profile) int
    # ONE array of the arena holding exactly `bytes` of storage for `bytes / stride`
    # cells, which the arena allocates and owns: the payload block joins the arena's
    # block list, the descriptor record joins it as the array's own, and the array's
    # interval joins the index.  This is how a constructor gets its cell -- the storage
    # of an array of the arena is the arena's, never the caller's.
    fn: lmx_pool_make (@: LmxArena arena; size_t: bytes; size_t: stride; int: kind; int: type) @: LmxPool
    fn: lmx_pool_make_profiled (@: LmxArena arena; size_t: bytes; size_t: stride; int: kind; int: type; @: Lmx profile) @: LmxPool
    # The same descriptor over caller-provided records and caller-owned storage: nothing
    # is owned or freed, and the array joins the arena and the index all the same.
    fn: lmx_pool_over (@: LmxArena arena; @: LmxPool pool; @: LmxChunk chunk; @: void base; size_t: bytes; size_t: stride; int: kind; int: type) int
    # Seal after construction.  Sealing is only lifecycle/GC policy: the optional profile
    # was selected independently when the array was opened/made and is never inferred here.
    fn: lmx_pool_seal (@: LmxPool pool) int
    fn: lmx_pool_is_sealed (@: LmxPool pool) int
    fn: lmx_pool_take (@: LmxArena arena; @: LmxPool pool) @: void
    # `count` consecutive cells of one array, in one chunk.  The array grows when the
    # last chunk cannot seat them all, and growth ADDS a chunk (never reallocates), so an
    # address handed out earlier never moves.  A request larger than the array's own
    # chunk makes that one chunk that big -- and ONLY that chunk (D-67): the new chunk's
    # width is `count` floored at the pool's configured step, never a write to the step
    # itself, so one wide request never inflates what a LATER, unrelated growth of the
    # same pool is sized at.  The doctrine draws no line between "a pool dedicated to one
    # growing array" and "a pool shared across many independent requests" (lmx_scratch,
    # for one) -- one rule serves both, at the cost of one add_chunk call per growth that
    # outgrows the step, never fewer.  A FAILED growth changes nothing (the step was
    # never touched to begin with).  Growth is the arena's act: the new chunk's
    # storage and the chunk's own record are blocks of the arena's list, so a rollback
    # that drops them drops the interval with them.
    fn: lmx_pool_take_n (@: LmxArena arena; @: LmxPool pool; size_t: count) @: void
    fn: lmx_pool_count (@: LmxPool pool) size_t
    # An Array descriptor: logical length and a pointer to element storage --
    # no node, no name, no tag. Its `len` is an element count, unlike the `len` in the Lmx header;
    # the backing has exactly `len` cells. Dynamic membership is an L1 list (KIND_LIST), not Array.
    fn: lmx_array_desc_new (@: LmxArena arena; @: LmxPool pool; size_t: len; @: void data) @: LmxArrayDesc
    fn: lmx_pool_release (@: LmxArena arena; @: LmxPool pool) int
    # The first chunk of the array's chain: a walk that must see every cell the array handed
    # out (the collection pass) starts here and follows each chunk's own `next`.
    fn: lmx_pool_chunk_head (@: LmxPool pool) @: LmxChunk
    # The chunk of THIS array that contains `p`, or null when the address is elsewhere.  A
    # chunk covers [base, base + capacity * stride) and the chunks of one array never overlap,
    # so this is a bounded scan of one array's own chain -- never of another arena's index.
    fn: lmx_pool_chunk_at (@: LmxPool pool; @: void p) @: LmxChunk
    # One chunk leaves its array's chain: the array no longer hands its cells out, and no
    # index entry is touched here -- the chunk's storage and its record are blocks of the
    # arena's list, and dropping those (with their interval) is the arena's act, which the
    # caller does next.  A pool that kept a freed chunk would hand out storage nobody owns.
    fn: lmx_pool_chunk_drop (@: LmxPool pool; @: LmxChunk chunk) int
    # Sole cell-arithmetic helper pair for chunk byte storage (FABLE-134 disposition).
    # cells = len/stride; room = capacity/stride. All cell counts go through these;
    # multiply on the way in via lmx_chunk_set_used / lmx_chunk_set_room.
    fn: lmx_chunk_cells (@: LmxChunk chunk; size_t: stride) size_t
    fn: lmx_chunk_room (@: LmxChunk chunk; size_t: stride) size_t
    fn: lmx_chunk_set_used (@: LmxChunk chunk; size_t: stride; size_t: cells) void
    fn: lmx_chunk_set_room (@: LmxChunk chunk; size_t: stride; size_t: cells) void
    # Byte base of the chunk payload (unsigned char *).
    fn: lmx_chunk_data (@: LmxChunk chunk) @: void
end: prototype
