    @@: m_steps_cell int (cast: (@@: int) (@ c.l2_m_steps))
    int: n
    @: source c.L2SourceContainer c.lm_compiler_source_root(mi)
    if: source != 0
        return: (cast: (int) (source\width))
    if: m_src_end_cell[0] != 0 && mi >= 0 && mi < m_n_cell[0] && m_src_end_cell[0][mi] >= 0
        n: m_src_end_cell[0][mi]
    else:
        n: lm_compiler_m_kids(mi)
        if: m_steps_cell[0] != 0 && mi >= 0 && mi < m_n_cell[0] && m_steps_cell[0][mi] > 0
            n: n + m_steps_cell[0][mi]
        ---
    return: (cast: (int) (n))
end: lm_compiler_m_width

fn: lm_compiler_schema_width (int: schema) int
    if: c.lm_compiler_schema_kind(schema) = 1
        return: (cast: (int) (lm_compiler_ns_width(schema)))
    if: c.lm_compiler_schema_kind(schema) = 3
        return: (cast: (int) (lm_compiler_method_field_count(c.lm_compiler_schema_index(schema))))
    if: c.lm_compiler_schema_kind(schema) = 2
        return: (cast: (int) (lm_compiler_mrs_width(c.lm_compiler_schema_index(schema))))
    return: (cast: (int) (0))
end: lm_compiler_schema_width

fn: lm_compiler_schema_field (int: schema; int: slot; @: out c.L2SchemaField) int
    @@@: own_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_own_name))
    @@: own_ty_cell int (cast: (@@: int) (@ c.l2_own_ty))
    @: mrs_n_cell int (cast: (@: int) (@ c.l2_mrs_n))
    @@: mrs_res_cell int (cast: (@@: int) (@ c.l2_mrs_res))
    @@@: mrs_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_mrs_name))
    @@@: mrs_type_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_mrs_type))
    @@: mrs_kind_cell int (cast: (@@: int) (@ c.l2_mrs_kind))
    @@: mrs_ent_cell int (cast: (@@: int) (@ c.l2_mrs_ent))
    @@@: nsf_fname_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_nsf_fname))
    @@@: nsf_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_nsf_name))
    @@: nsf_kind_cell int (cast: (@@: int) (@ c.l2_nsf_kind))
    @@: nsf_ref_cell int (cast: (@@: int) (@ c.l2_nsf_ref))
    int: row 0
    int: ordinal 0
    int: own
    int: owner c.lm_compiler_schema_index(schema)
    if: out = 0 || slot < 0 || schema = -1
        return: (cast: (int) (1))
    out\name: 0
    out\type_word: 0
    out\kind: -1
    out\model: -1
    out\pointee: -1
    if: c.lm_compiler_schema_kind(schema) = 3
        own: lm_compiler_method_field_own(owner, slot)
        if: own < 0
            return: (cast: (int) (1))
        out\name: own_name_cell[0][own]
        out\type_word: 0
        out\kind: c.lm_compiler_own_nsf_kind(own_ty_cell[0][own])
        out\model: 0 - 1
        if: out\kind = 10
            out\model: c.lm_compiler_ft_of_own(own_ty_cell[0][own])
            out\pointee: c.lm_compiler_own_nsty_get(own)
        return: (cast: (int) (0))
    ---
    if: c.lm_compiler_schema_kind(schema) = 2
        while: row < mrs_n_cell[0]
            if: mrs_res_cell[0][row] = owner
                if: ordinal = slot
                    out\name: mrs_name_cell[0][row]
                    out\type_word: mrs_type_cell[0][row]
                    out\kind: mrs_kind_cell[0][row]
                    out\model: mrs_ent_cell[0][row]
                    if: out\kind = 10
                        out\pointee: lm_compiler_mrs_ref_pointee(owner, slot)
                    return: (cast: (int) (0))
                ordinal: ordinal + 1
            row: row + 1
        ---
        return: (cast: (int) (1))
    ---
    row: lm_compiler_ns_row_at_slot(owner, slot)
    if: row = -2
        return: (cast: (int) (1))
    if: row >= 0
        out\name: nsf_fname_cell[0][row]
        out\type_word: nsf_name_cell[0][row]
        out\kind: nsf_kind_cell[0][row]
        out\model: nsf_ref_cell[0][row]
        if: out\kind = 10
            out\pointee: lm_compiler_nsf_pointee(row)
        return: (cast: (int) (0))
    # Unnamed operation children retain their actual physical coordinates.
    if: slot < lm_compiler_ns_width(owner)
        return: (cast: (int) (0))
    return: (cast: (int) (1))
end: lm_compiler_schema_field

fn: lm_compiler_schema_named (int: schema; const: (@: name c.LmP0Text); int: occurrence; @: out c.L2SchemaField) int
    return: (cast: (int) (lm_compiler_schema_named_select(schema, name, occurrence, out, 1)))
end: lm_compiler_schema_named

