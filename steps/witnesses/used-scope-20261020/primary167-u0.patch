+    L2ValueSpan: operand
+    L2Path: ready
+    int: status
+    int: type
+    int: t
+    int: role l2_primary_role(value, mi)
+    []: char text_own 1024
+    []: char result_own 1024
+    L2Tx: text_tx
+    L2Tx: result_tx
+    @: L2Tx text l2_tx_local(@ text_tx, text_own, 1024U)
+    @: L2Tx result l2_tx_local(@ result_tx, result_own, 1024U)
+    if: role = 0
+        return: 2
+    if: role = 3
+        l2_ccall_into: dest
+        status: l2_native_member_path(value\node, mi, @ ready)
+        if: status = 1
+            l2_ccall_into: 0
