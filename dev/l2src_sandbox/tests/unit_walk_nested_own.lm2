# An inline body does not create a second data name scope. A bare assignment
# writes the same activation's selected place; its value stays visible after
# the body.
# nest(1) is 4 and nest(0) is 3, so nest(1) * 10 + nest(0) is 43.
# keep(3) is 4: `int: n` creates the method field and carries 3; `n: n + 1`
# inside the if writes that same cell; `return: n` reads 4.
# branch(3) is 44: the inline `int: n` carries the input and then updates
# the one selected data place to 4, which remains visible after the body.
fn: nest (int: c) int
    int: a 0
    int: i 0
    if: c
        int: x 2
        a: x
    else:
        int: y 1
        a: y
    while: i < 2
        int: z 1
        a: a + z
        i: i + 1
    return: a

fn: keep (int: n) int
    int: n
    if: 1
        n: n + 1
    return: n

fn: branch (int: n) int
    int: a 0
    if: 1
        int: n
        n: n + 1
        a: n
    return: a * 10 + n

int: r 0
if: nest(1) * 10 + nest(0) = 43
    r: r + 1
if: keep(3) = 4
    r: r + 2
if: branch(3) = 44
    r: r + 4
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
