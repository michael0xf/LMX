# Reentry uses one declared occurrence and independent working values.
# Inner x9 is published; outer bare x stays2 and explicit M\x reads9.
# The final outer write publishes3: observable result293.
fn: M (int: n) int
    int: x 1
    if: n = 0
        x: 9
        return: 0
    x: 2
    M(0)
    int: seen 0
    seen: x
    int: pub 0
    pub: M\x
    x: x + 1
    return: seen * 10 + pub
end: M

fn: check () int
    return: M\x
end: check

int: v 0
v: M(1)
int: w 0
w: check()
sendMessage: exit(exit_code: v * 10 + w; stdout: ""; stderr: "")
return
