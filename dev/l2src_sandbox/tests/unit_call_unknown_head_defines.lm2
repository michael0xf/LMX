# K03 NS-ROLES-CALL control: an unknown head defines, whatever its tail -- `Fresh: zz extra` at the root,
# `Inner: zz extra` in Outer's body and `Local: zz extra` in a method, each head unknown, are named
# Structures with the written contents zz and extra; nothing runs.  Exit 7.
int: extra 1
Fresh: zz extra
Outer:
    Inner: zz extra
end: Outer
fn: m () int
    Local: zz extra
    return: 7
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
