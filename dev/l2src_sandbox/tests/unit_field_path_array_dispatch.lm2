Model:
    size_t: value 1U
end: Model

# FABLE-SONNET-UNIT-LEVEL-ROOTS-20260923-117 generalized the own-array
# helpers past the two literal roots "for"/"node". FABLE-SONNET-ARRAY-
# WRITE-DISPATCH-20260923-119 found and fixed a write-dispatch ordering
# gap for that generalization, then fable corrected the generalization's
# MEANING itself: root\name[idx] for a general own-field/formal root
# (anything other than literally "for"/"node") is a field path -- name
# must denote a field OF root's Structure type, never a same-named
# sibling own array elsewhere in the method. l2_own_array_root/_span (the
# -117 helpers) now refuse unconditionally for any non-node/for root, so
# this shape falls through to the ordinary field-path machinery. See
# unit_array_write_general_root_no_field.lm2 and
# unit_array_write_general_root_real_field.lm2 for that refusal, both
# sub-cases (no such field at all; a real Array field this ticket still
# cannot address). This fixture covers only what "for"/"node" and a bare
# own name have always meant, unaffected by any of this: the own-table
# gate/lookup itself.
fn: build () int
    []: int buf 3
    buf[0]: 6
    node\buf[1]: 8
    if: buf[0] != 6
        return: 97
    if: node\buf[1] != 8
        return: 98
    if: length(buf) != 3
        return: 96
    if: length(node\buf) != 3
        return: 99
    return: 0
end: build

return: build()
