            l2_rw_shell_fid: fid
        if: l2_rw_body(last\value\as\structure, node, 2) != 0
            l2_rw_shell_fid: -1
            l2_rw_leave(bsave)
            return: 1
        l2_rw_shell_fid: -1
        if: l2_rw_leave(bsave) != 0
            return: 1
        if: els != 0
