L2:
    ---
        Observed:
            int: effects 1
            int: arithmetic 15
            int: called 6
            int: indexed 12
            int: via_whole 13
        end: Observed
    ---
    int: effects 1
    fn: produce () int
        :=: (node \ effects) ((node \ effects) + 1)
        return: 4
    end: produce
    fn: add (int: value; int: other 2) int
        return: (value + other)
    end: add
    int: a 6
    int: b 7
    int: arithmetic (add ((a + b)))
    int: called (add ((produce)))
    Any:
    end: Any
    fn: frame_value (@: value Any; int: other 12) int
        return: other
    end: frame_value
    Carrier:
        const: ((@ field Any))
    end: Carrier
    int: indexed (frame_value (Carrier [] 0))
    Fielded:
        int: field 0
    end: Fielded
    fn: frame_whole (@: value Fielded; int: other 12) int
        return: (other + ((value \ field) * 0))
    end: frame_whole
    Whole:
        Holder:
            int: field 5
        end: Holder
        Pass:
            @: value Holder
            int: other 13
        end: Pass
    end: Whole
    int: via_whole (frame_whole (Whole \ Pass))
    fn: qualified ((const ((int value)))) int
        return: 1
    end: qualified
    fn: deep (@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@: value) int
        return: 1
    end: deep
    fn: array ((char ([] ([] value)))) int
        return: 1
    end: array
    fn: profile (c.uint8_t: value) int
        return: 1
    end: profile
    if: 0 ((qualified ((const ((int value 9))))) (deep ((@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ value c.FILE))) (array ((char ([] ([] value))))) (profile ((c.uint8_t value 7))))
    int: done 1
    sub: main ()
        @: shared (node [] 0)
        :=: ((shared \ Observed) \ effects) (node \ effects)
        :=: ((shared \ Observed) \ arithmetic) arithmetic
        :=: ((shared \ Observed) \ called) called
        :=: ((shared \ Observed) \ indexed) indexed
        :=: ((shared \ Observed) \ via_whole) via_whole
    end: main
    main:
end: L2
