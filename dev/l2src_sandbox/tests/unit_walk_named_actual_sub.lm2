# REVIEW 394f6a9 (fable_pc's P62 d): a sub called as a statement binds its named arguments like any call --
# add(b: 1; a: 8) gives a 8, b 1, and y is a - b = 7 (by position it would be -7).  Before the named actuals:
# "unknown method".  Entry 7.
int: y 0

sub: add (int: a; int: b)
    y: a - b
end: add

add(b: 1; a: 8)
sendMessage: exit(exit_code: y; stdout: ""; stderr: "")
return
