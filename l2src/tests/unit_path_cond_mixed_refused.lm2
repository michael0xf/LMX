# A path in a method's condition: `if: P\v = k` with P's size_t v and an int k is two types; the kind check
# (l2_check_value_kinds) now reads the path's type.  Refused at the path.
P:
    size_t: v 5U
fn: m () int
    int: k 5
    int: out 0
    if: P\v = k
        out: 7
    return: out

sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
