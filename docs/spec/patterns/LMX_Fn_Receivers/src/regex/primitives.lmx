# Elementary recognizers: a probe returns its new position or internal -1.
# The integer -1 is never a public Match/Maybe/Span representation.
# A probe is an ordinary selected method, not an opcode or a regex instruction.

RxPrimitiveConfig:
    @: probe 0
    @: payload 0

RxPrimitiveState:
    @: source 0
    int: position 0
    @: captures 0
    @: probe 0
    @: payload 0
    int: finished 0

RxPrimitiveMake:
    private:
        @: probe
        @: payload 0
    return: @
    make:
        private: @: config (copy(RxPrimitiveConfig))
        config\probe := probe
        config\payload := payload
        return: RxPatternFactory\make(RxPrimitiveOpen\open; config)

RxPrimitiveOpen:
    private:
        @: config
        RxPreparedSource@: source
        int: position
        @: captures
    return: @
    open:
        private: @: state (copy(RxPrimitiveState))
        state\source := source
        state\position := position
        state\captures := captures
        state\probe := config\probe
        state\payload := config\payload
        return: RxCursorFactory\make(RxPrimitiveStep\step; state)

RxPrimitiveStep:
    private: @: state
    return: @
    step:
        if: state\finished != 0
            return: FxNone\none()
        state\finished := 1
        private: @: probe state\probe
        private: int: end probe(payload := state\payload; source := state\source; position := state\position; captures := state\captures)
        if: end < 0
            return: FxNone\none()
        return: FxSome\some(value := RxCandidateMake\make(end; state\captures))

RxLiteral:
    private: @: value
    required: value
    return: @
    literal:
        return: RxPrimitiveMake\make(RxLiteralProbe\probe; value)

RxLiteralProbe:
    private:
        @: payload
        RxPreparedSource@: source
        int: position
        @: captures
    return: int
    probe:
        throws: copy(FxThrows\pattern)
        private: @: prepare source\domain\literalUnits
        private: @: part prepare(value := payload; profile := source\profile)
        private: int: count length(part)
        if: count > length(source\units) - position
            return: -1
        if: FxSequenceDifference\find(source\units; part; 0; position; count) >= 0
            return: -1
        return: position + count

RxClassConfig:
    @: values 0
    int: inverted 0

RxClassMake:
    private:
        @: values
        int: inverted
    required: values inverted
    return: @
    make:
        private: @: config (copy(RxClassConfig))
        config\values := values
        config\inverted := inverted
        return: RxPrimitiveMake\make(RxClassProbe\probe; config)

RxMembers:
    private: @: values
    required: values
    return: @
    oneOf:
        return: RxClassMake\make(values; 0)
    noneOf:
        return: RxClassMake\make(values; 1)

RxClassProbe:
    private:
        RxClassConfig@: payload
        RxPreparedSource@: source
        int: position
        @: captures
    return: int
    probe:
        throws: copy(FxThrows\pattern)
        private: @: prepare source\domain\literalUnits
        private: @: values prepare(value := payload\values; profile := source\profile)
        if: position = length(source\units)
            return: -1
        private: @: item FxSeqRead\read(source\units; position)
        private: int: found FxKeyIndex\find(values; item) >= 0
        if: found = payload\inverted
            return: -1
        return: position + 1

RxWithinConfig:
    @: first 0
    @: last 0
    @: order 0

RxWithin:
    private:
        @: first
        @: last
        @: order 0
    required: first last
    return: @
    within:
        private: @: payload (copy(RxWithinConfig))
        payload\first := first
        payload\last := last
        payload\order := order
        return: RxPrimitiveMake\make(RxWithinProbe\probe; payload)

RxWithinProbe:
    private:
        RxWithinConfig@: payload
        RxPreparedSource@: source
        int: position
        @: captures
    return: int
    probe:
        throws: copy(FxThrows\pattern)
        private: @: bound source\domain\rangeUnit
        private: @: first bound(value := payload\first; profile := source\profile)
        private: @: last bound(value := payload\last; profile := source\profile)
        if: FxValueOrder\compare(first; last; payload\order) > 0
            throw: PatternArgument()
        if: position = length(source\units)
            return: -1
        private: @: item FxSeqRead\read(source\units; position)
        if: FxValueOrder\compare(item; first; payload\order) < 0 || FxValueOrder\compare(item; last; payload\order) > 0
            return: -1
        return: position + 1

RxPredicateConfig:
    @: predicate 0

RxSatisfy:
    private: @: predicate
    required: predicate
    return: @
    satisfy:
        throws: copy(FxThrows\pattern)
        return: RxPrimitiveMake\make(
            RxPredicateProbe\probe;
            FxUnaryPredicate\check(predicate)
        )

RxPredicateProbe:
    private:
        @: payload
        RxPreparedSource@: source
        int: position
        @: captures
    return: int
    probe:
        throws: copy(FxThrows\pattern)
        if: position = length(source\units)
            return: -1
        private: @: item FxSeqRead\read(source\units; position)
        private: @: accepted FxApply\apply(payload; FxOne\make(item))
        if: FxSeqPredicate\truth(accepted) = 0
            return: -1
        return: position + 1

RxBoundaryOf:
    private: @: predicate
    required: predicate
    return: @
    boundaryOf:
        throws: copy(FxThrows\pattern)
        return: RxPrimitiveMake\make(RxBoundaryProbe\probe; FxUnaryPredicate\check(predicate))

RxBoundaryProbe:
    private:
        @: payload
        RxPreparedSource@: source
        int: position
        @: captures
    return: int
    probe:
        throws: copy(FxThrows\pattern)
        private: int: before 0
        private: int: after 0
        if: position > 0
            before := FxSeqPredicate\truth(FxApply\apply(payload; FxOne\make(FxSeqRead\read(source\units; position - 1))))
        if: position < length(source\units)
            after := FxSeqPredicate\truth(FxApply\apply(payload; FxOne\make(FxSeqRead\read(source\units; position))))
        if: before != after
            return: position
        return: -1

RxNameConfig:
    char[]: name ""

RxSameAs:
    private: char[]: name
    required: name
    return: @
    sameAs:
        private: @: payload (copy(RxNameConfig))
        payload\name := name
        return: RxPrimitiveMake\make(RxSameAsProbe\probe; payload)

RxSameAsProbe:
    private:
        RxNameConfig@: payload
        RxPreparedSource@: source
        int: position
        @: captures
    return: int
    probe:
        throws: copy(FxThrows\pattern)
        private: @: found RxCaptureLatest\find(captures; payload\name)
        if: found\present = 0
            return: -1
        private: @: capture found\value
        private: int: count capture\end - capture\begin
        if: count > length(source\units) - position
            return: -1
        if: FxSequenceDifference\find(source\units; source\units; 0; position; count; capture\begin) >= 0
            return: -1
        return: position + count

RxEmptyProbe:
    private:
        @: payload
        RxPreparedSource@: source
        int: position
        @: captures
    return: int
    probe:
        return: position

RxNeverProbe:
    private:
        @: payload
        RxPreparedSource@: source
        int: position
        @: captures
    return: int
    probe:
        return: -1

RxAnyProbe:
    private:
        @: payload
        RxPreparedSource@: source
        int: position
        @: captures
    return: int
    probe:
        if: position < length(source\units)
            return: position + 1
        return: -1

RxLineCharProbe:
    private:
        @: payload
        RxPreparedSource@: source
        int: position
        @: captures
    return: int
    probe:
        private: RxPreparedText@: profile source\profile
        if: position = length(source\units)
            return: -1
        private: int: unit source\units[position]
        if: unit = 13 || unit = 10
            return: -1
        return: position + 1

RxLineBreakProbe:
    private:
        @: payload
        RxPreparedSource@: source
        int: position
        @: captures
    return: int
    probe:
        private: RxPreparedText@: profile source\profile
        if: position = length(source\units)
            return: -1
        private: int: unit source\units[position]
        if: unit = 13
            if: position + 1 < length(source\units)
                if: source\units[position + 1] = 10
                    return: position + 2
            ---
            return: position + 1
        if: unit = 10
            if: position > 0
                if: source\units[position - 1] = 13
                    return: -1
            ---
            return: position + 1
        return: -1

RxStartProbe:
    private:
        @: payload
        RxPreparedSource@: source
        int: position
        @: captures
    return: int
    probe:
        if: position = 0
            return: position
        return: -1

RxEndProbe:
    private:
        @: payload
        RxPreparedSource@: source
        int: position
        @: captures
    return: int
    probe:
        if: position = length(source\units)
            return: position
        return: -1

RxLineStartProbe:
    private:
        @: payload
        RxPreparedSource@: source
        int: position
        @: captures
    return: int
    probe:
        private: RxPreparedText@: profile source\profile
        if: position = 0
            return: position
        private: int: before source\units[position - 1]
        if: before = 10
            return: position
        if: before = 13
            if: position = length(source\units)
                return: position
            if: source\units[position] != 10
                return: position
        ---
        return: -1

RxLineEndProbe:
    private:
        @: payload
        RxPreparedSource@: source
        int: position
        @: captures
    return: int
    probe:
        private: RxPreparedText@: profile source\profile
        if: position = length(source\units)
            return: position
        private: int: after source\units[position]
        if: after = 13
            return: position
        if: after = 10
            if: position = 0
                return: position
            if: source\units[position - 1] != 13
                return: position
        ---
        return: -1

RxAsciiDigit:
    private: int: unit
    return: int
    test:
        return: unit >= 48 && unit <= 57

RxAsciiLetter:
    private: int: unit
    return: int
    test:
        return: (unit >= 65 && unit <= 90) || (unit >= 97 && unit <= 122)

RxAsciiWord:
    private: int: unit
    return: int
    test:
        return: RxAsciiLetter\test(unit) || RxAsciiDigit\test(unit) || unit = 95

RxAsciiSpace:
    private: int: unit
    return: int
    test:
        return: unit = 32 || (unit >= 9 && unit <= 13)


RxElement:
    private: @: value
    required: value
    return: @
    element:
        return: RxPrimitiveMake\make(RxElementProbe\probe; value)

RxElementProbe:
    private:
        @: payload
        RxPreparedSource@: source
        int: position
        @: captures
    return: int
    probe:
        throws: copy(FxThrows\pattern)
        if: position = length(source\units)
            return: -1
        if: FxValueSame\test(FxSeqRead\read(source\units; position); payload) = 0
            return: -1
        return: position + 1
