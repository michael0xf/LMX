        return: 1
    if: bld_hash_note(rec, source) != 0 || bld_hash_note(rec, cfile) != 0 || bld_hash_note(rec, exe) != 0
        return: 1
    return: 0
end: bld_backend

# Existing single C storage, printed as declarations only by ordinary L3.
# Imported sequentially at the old state position, never by the public API.
fn: decl_l1_backend_state (@: f c.FILE) int
    if: c.fputs("@: LmP0Text l1_imp_act 0\n@: LmP0Text l1_imp_done 0\nsize_t: l1_imp_actcap 0U\nsize_t: l1_imp_donecap 0U\nint: l1_imp_actn 0\nint: l1_imp_donen 0\nconst: @: char l1_src 0\nsize_t: l1_srcn 0\n[]: char l1_th_names 2048\n[]: int l1_th_ar 32\nint: l1_th_n 0\nint: l1_in_finally 0\n@: char l1_fn_names 0\n@: int l1_fn_th 0\n@: int l1_fn_thn 0\n@: int l1_fn_ar 0\nint: l1_fnn 0\nint: l1_fn_cap 0\n[]: char l1_ca_names 2048\n[]: int l1_ca_ids 32\n[]: int l1_ca_d 32\nint: l1_ca_n 0\nint: l1_ca_next 0\nint: l1_blk_d 0\n@: LmP0Field l1_fin_f 0\nint: l1_fin_depth 0\nint: l1_has_fin 0\nint: l1_th_ch 0\nint: l1_cur_void 0\nint: l1_throw_ok 0\n[]: int l1_cur_th 8\nint: l1_cur_thn 0\nint: l1_allow_throws 0\n[]: char l1_hdr_types 8192\nint: l1_hdr_typen 0\n[]: char l1_hdr_kinds 128\nconst: @: char l1_unit_root 0\nint: l1_unit_root_set 0\n[]: char l1_hdr_emitted 2048\nint: l1_hdr_emittedn 0\n[]: char l1_hdr_pending 2048\nint: l1_hdr_pendingn 0\nint: l1_hdr_emitting 0\n", f) < 0
        return: 1
    return: 0
end: decl_l1_backend_state

# Declarative backend root and the standard C entry bridge only.
fn: decl_l1_backend_root (@: f c.FILE) int
    if: c.fputs("# Generated by maintained L3; platform and CLI algorithms remain ordinary L2.\npredef: \"l1src/parser.lm1\"\npredef: \"l2src/l1_backend_text.h.lm1\"\npredef: \"l2src/l1_backend_state_helpers.h.lm1\"\npredef: \"l2src/l1_backend_emit.h.lm1\"\ninclude: \"<stdio.h>\" \"<string.h>\" \"<stdlib.h>\" \"<limits.h>\" \"<errno.h>\"\nos:\n    win:\n        predef: \"l2src/l1_backend_platform_win.h.lm1\"\n        import: \"l2src/l1_backend_platform_win.lm1\"\n    default:\n        predef: \"l2src/l1_backend_platform_posix.h.lm1\"\n        import: \"l2src/l1_backend_platform_posix.lm1\"\nend: os\n\nimport: \"l1src/l1_backend_state.lm1\"\nimport: \"l2src/l1_backend_text.lm1\"\nimport: \"l2src/l1_backend_state_helpers.lm1\"\nimport: \"l2src/l1_backend_emit.lm1\"\n\nexternal:\n    fn: main (int: argc; @@: char argv) int\n    return: l1_cli_main(argc, argv)\nend: external\n", f) < 0
        return: 1
    return: 0
end: decl_l1_backend_root
