# `node` names a body's field, never the method's args part (book §2; slice 2c-4): the method's formal q is no field of
# S's `node`.  Unresolved where it stands.
fn: m (int: q) int
    S:
        int: v 0
        v: node\q
    S()
    return: 7
end: m
int: r 0
r: m(3)
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
