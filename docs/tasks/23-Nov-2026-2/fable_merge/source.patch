diff --git a/patterns/examples/julia_comparison/tools/check.py b/patterns/examples/julia_comparison/tools/check.py
new file mode 100644
index 0000000000000000000000000000000000000000..cb9452fcf6d99d7799ef6176c4c29b42cd824231
--- /dev/null
+++ b/patterns/examples/julia_comparison/tools/check.py
@@ -0,0 +1,151 @@
+#!/usr/bin/env python3
+"""Ограниченная текстовая проверка и независимый oracle ожиданий; не runtime."""
+import sys
+sys.dont_write_bytecode = True
+from pathlib import Path
+import copy, hashlib, json, re, shutil
+from functools import reduce
+from rebuild import metrics, production, closure, COMPONENTS, R
+
+def check_lmx(path):
+    errors=[];stack=[];quote=None;escaped=False;last=None
+    for number,line in enumerate(path.read_text().splitlines(),1):
+        if '\t' in line:errors.append(f'{number}: tab indentation')
+        if not line.strip():
+            last=None;continue
+        body=[];i=0
+        while i<len(line):
+            char=line[i]
+            if quote:
+                if escaped:escaped=False
+                elif char=='\\' and quote!='`':escaped=True
+                elif char==quote:
+                    if quote=='`' and i+1<len(line) and line[i+1]=='`':i+=1
+                    else:quote=None
+                body.append(' ')
+            elif char=='#':break
+            elif char in ('"',"'",'`'):
+                quote=char;body.append(' ')
+            else:
+                body.append(char)
+                if char in '([{':stack.append((char,number))
+                elif char in ')]}':
+                    if not stack or stack[-1][0]!={')':'(',']':'[','}':'{'}[char]:errors.append(f'{number}: unmatched {char}')
+                    else:stack.pop()
+            i+=1
+        code=''.join(body).rstrip()
+        if not code.strip():continue
+        indent=len(line)-len(line.lstrip())
+        if indent%4:errors.append(f'{number}: indentation {indent}')
+        if last and indent<last[0]-4 and code.strip()!='---' and not code.lstrip().startswith('end:'):errors.append(f'{number}: multi-level decrease {last[0]}->{indent} without cutter')
+        last=(indent,number)
+    if stack:errors.append('unclosed brackets '+repr(stack))
+    if quote:errors.append('unclosed literal '+quote)
+    return errors
+
+def logical(ident,a):
+    if ident=='J01':
+        if a[2]==0:raise ValueError('zero_step')
+        return list(range(*a))
+    if ident=='J02':
+        xs,lo,hi=a
+        if not 0<=lo<=hi<=len(xs):raise ValueError('bounds')
+        return xs[lo:hi]
+    if ident=='J03':return a[0][::-1]
+    if ident=='J04':
+        if len(a[0])!=len(a[1]):raise ValueError('shape')
+        return [x for x,m in zip(*a) if m!=0]
+    if ident=='J05':return [x*x for x in a[0]]
+    if ident=='J06':return [x for x in a[0] if x%2!=0]
+    if ident=='J07':return reduce(lambda x,y:x-y,a[0],a[1])
+    if ident=='J08':
+        out=[a[1]]
+        for x in a[0]:out.append(out[-1]+x)
+        return out
+    if ident=='J09':return [list(p) for p in zip(*a)]
+    if ident=='J10':
+        assert len(a[0])==len(a[1])
+        return [2*x+y*y for x,y in zip(*a)]
+    if ident=='J11':return [y for x in a[0] for y in (x,x*x)]
+    if ident=='J12':
+        out={}
+        for x in a[0]:out.setdefault('true' if x%2 else 'false',[]).append(x)
+        return out
+    if ident=='J13':return any(x>a[1] for x in a[0])
+    if ident=='J14':return all(x>0 for x in a[0])
+    if ident=='J15':
+        for i,x in enumerate(a[0]):
+            if x>a[1]:return {'present':True,'value':i}
+        return {'present':False}
+    if ident=='J16':return sum(x%2==0 for x in a[0])
+    if ident=='J17':
+        a[0].extend(a[1]);return {'returned':a[0],'target':a[0],'same_target':True}
+    if ident=='J18':
+        target,lo,hi,values=a
+        if not 0<=lo<=hi<=len(target):raise ValueError('bounds')
+        removed=target[lo:hi];target[lo:hi]=values
+        return {'removed':removed,'target':target}
+    if ident=='J19':return [list(column) for column in zip(*a[0])]
+    if ident=='J20':return sorted(a[0],key=lambda x:x['key'])
+    if ident=='J21':return list(dict.fromkeys(a[0]))
+    if ident=='J22':return ''.join(c for c in a[0] if '0'<=c<='9')
+    if ident=='J23':return [value for part in a[0] for value in part]
+    if ident=='J24':return [[x,y] for x in a[0] for y in a[1]]
+    raise AssertionError(ident)
+
+def main():
+    data=json.loads((R/'examples.json').read_text());errors=[];checks=[];expectations=[]
+    assert len(data['examples'])==24 and len(data['implementations'])==4
+    current=production()
+    stats=json.loads((R/'statistics.json').read_text());by_stats={(x['id'],x['language']):x for x in stats['rows']}
+    for item in data['examples']+data['implementations']:
+        for language,key in [('LMX','lmx'),('Julia','foreign')]:
+            path=R/item['source_files'][key]
+            if path.read_text()!=item[key]:errors.append(item['id']+' source mismatch '+language)
+            for metric,value in metrics(item[key]).items():
+                if by_stats[item['id'],language][metric]!=value:errors.append(item['id']+' metric mismatch '+metric)
+            checks.append({'id':item['id'],'language':language,'check':'source_json_statistics_equal','status':'PASS'})
+        if 'production_definitions' in item:
+            for owner in item['production_definitions']:
+                if hashlib.sha256(current[owner['name']]['code'].encode()).hexdigest()!=owner['sha256']:errors.append('Production source drift '+owner['name'])
+        else:
+            for name in item['core_functions']:
+                if not (R/item['implementation_links'][name]).is_file():errors.append(item['id']+' uncovered core '+name)
+            if re.search(r'Julia(?:Ordered|Array|Mutation|OrderGroup)Reference|include\(|library_comparisons',item['foreign']):errors.append(item['id']+' custom library imported by client')
+            if item['alternatives']:errors.append(item['id']+' unreviewed alternative')
+            cases=[{'inputs':list(item['inputs'].values()),'expected':item['expected']}]+item['semantic_cases']
+            for number,case in enumerate(cases):
+                try:
+                    observed=logical(item['id'],copy.deepcopy(case['inputs']))
+                    okay='error' not in case and observed==case['expected']
+                except ValueError as err:
+                    observed={'error':str(err)};okay=str(err)==case.get('error')
+                if not okay:errors.append(item['id']+' expectation mismatch '+str(number))
+                expectations.append({'example':item['id'],'case':number,'status':'PASS' if okay else 'FAIL','observed':observed})
+    dep_report=json.loads((R/'validation/implementation_dependencies.json').read_text())
+    for definition in dep_report['definitions']:
+        name=definition['name']
+        if name not in current or hashlib.sha256(current[name]['code'].encode()).hexdigest()!=definition['sha256']:
+            errors.append('Shared production source drift '+name)
+    lmx_paths=list((R/'source/lmx').glob('*.lm3'))+list((R/'library_comparisons').glob('*.lmx'))
+    for path in sorted(lmx_paths):
+        found=check_lmx(path)
+        errors.extend(str(path.relative_to(R))+': '+x for x in found)
+        checks.append({'source':path.relative_to(R).as_posix(),'check':'literal_bracket_indent_cutter','status':'FAIL' if found else 'PASS','errors':found})
+    cases_json=json.loads((R/'validation/semantic_cases.json').read_text())
+    if len(cases_json['cases'])!=len(expectations):errors.append('Cases count mismatch')
+    # Check concrete local links. Root is responsible for these pending PDFs/XLSX.
+    pending={'LMX_Comparison_Julia.pdf','LMX_Comparison_Julia.xlsx','../STATISTICS.md'}
+    for path in R.rglob('*.md'):
+        text=path.read_text()
+        for target in re.findall(r'\]\(([^)]+)\)',text):
+            if '://' in target or target.startswith('#'):continue
+            plain=target.split('#')[0]
+            if path==R/'README.md' and plain in pending:continue
+            if not (path.parent/plain).exists():errors.append(str(path.relative_to(R))+': missing local link '+plain)
+    report={'status':'FAIL' if errors else 'PASS','edition':'2026-11-23','scope':'Static source/metrics/provenance checks plus Python logical expectation oracle; not Julia/LMX execution.','checks':checks,'errors':errors,'logical_cases_checked':len(expectations),'lmx_source_files_checked':len(lmx_paths),'julia_executable':shutil.which('julia'),'julia_execution':'NOT_RUN','lmx_execution':'NOT_RUN'}
+    (R/'validation/check_report.json').write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\n')
+    (R/'validation/python_expectation_check.json').write_text(json.dumps({'status':'PASS' if all(x['status']=='PASS' for x in expectations) else 'FAIL','kind':'logical expectations in Python, not language execution','cases':expectations},ensure_ascii=False,indent=2)+'\n')
+    print(json.dumps({'status':report['status'],'checks':len(checks),'cases':len(expectations),'errors':errors},ensure_ascii=False))
+    if errors:raise SystemExit(1)
+if __name__=='__main__':main()
diff --git a/patterns/examples/julia_comparison/tools/rebuild.py b/patterns/examples/julia_comparison/tools/rebuild.py
new file mode 100644
index 0000000000000000000000000000000000000000..767701a20e0599115723b2acb1c4531269d75925
--- /dev/null
+++ b/patterns/examples/julia_comparison/tools/rebuild.py
@@ -0,0 +1,206 @@
+#!/usr/bin/env python3
+"""Пересобрать источники/MD/метрики Julia suite; LMX и Julia не исполняются."""
+import sys
+sys.dont_write_bytecode = True
+from pathlib import Path
+import csv, hashlib, json, re, shutil
+R = Path(__file__).resolve().parents[1]
+LIB = R.parents[1] / 'LMX_Fn_Receivers'
+CORE = LIB
+PATTERNS = R.parents[1]
+sys.path.insert(0, str(PATTERNS / 'tools'))
+from throws_metrics import measure_throws
+EDITION = '2026-11-23'
+COMPONENTS = [
+ ('JI01','Упорядоченные обходы, предикаты и свёртки','JI01_ordered.jl',
+  ['map','filter','foldl','scanl','zip','zipWith','flatMap','any','all','index','count','record'],
+  ['FxMap','FxFilter','FxFold','FxScan','FxPair','FxZip','FxZipWith','FxListBind','FxSeqFlatMap','FxSeqAny','FxSeqAll','FxSeqIndex','FxSeqCount','FxRecordOperands','FxMaybe','FxSome','FxNone'],
+  'Конечные последовательности, произвольные типы полезных значений, упорядоченные callbacks в одной Message. map/flatMap/scan/zip возвращают записи значений; filter сохраняет исходный профиль. Предикаты возвращают int LMX, Bool/Int Julia. Ошибка callback распространяется; callback не изменяет входную последовательность. Частичный результат не выдаётся. index различает отсутствие и индекс 0. record сохраняет принятое значение, а не копирует граф.',
+  ['https://docs.julialang.org/en/v1/base/collections/','https://docs.julialang.org/en/v1/base/iterators/','https://docs.julialang.org/en/v1/base/arrays/'],[]),
+ ('JI02','Границы, маски и устройство массивов','JI02_arrays.jl',
+  ['range','slice','reverse','compress','concat','transpose'],
+  ['FxSeqRange','FxSeqSlice','FxSeqReverse','FxSeqCompress','FxSeqConcat','FxTranspose'],
+  'Полные конечные одномерные массивы и прямоугольные массивы строк. Диапазоны и срезы полуоткрыты и используют нулевые позиции. Предусмотрены пустые входы, отрицательный шаг, отказ на нулевом шаге, проверка размеров и несовместимой формы. Копируются внешние позиции, ссылочные цели сохраняются. concat не делает рекурсивного flatten. Julia reference принимает обычные one-based AbstractVector, а не все возможные AbstractArray/OffsetArray.',
+  ['https://docs.julialang.org/en/v1/base/arrays/','https://docs.julialang.org/en/v1/base/collections/'],[]),
+ ('JI03','Изменение диапазона с сохранением target','JI03_mutation.jl',
+  ['append','splice','replaceRange'],['FxSeqReplaceRange','FxSeqSplice','FxSeqAppend'],
+  'Один общий алгоритм replaceRange, splice возвращает удалённые элементы, append возвращает исходный target. Обе reference-реализации полностью подготавливают вставку до первой записи, в том числе при перекрытии. Обычное принятие типа и исчерпание ресурсов остаются правилами respective runtime; обещания общей транзакции нет. Сравнение клиентов J17/J18 ограничено совместимыми неперекрывающимися входами, поскольку Base.splice! предупреждает о разделяемой памяти.',
+  ['https://docs.julialang.org/en/v1/base/collections/'],['JI02']),
+ ('JI04','Сортировка, уникальность и группировка','JI04_order_group.jl',
+  ['sort','unique','groupBy'],['FxSort','FxUnique','FxGroup','FxGroupBy'],
+  'Общие типы элементов и ключей. Устойчивая bottom-up merge sort с целочисленным трёхсторонним comparator; unique оставляет первое появление по явному равенству; groupBy вызывает keyOf один раз на элемент и сохраняет порядок внутри групп. Пустые входы и неверные ответы comparator/predicate обработаны. Источник и ключи callbacks не меняют. Generic unique/groupBy используют поиск без hash; их асимптотика не приравнивается к оптимизированным Base.unique/SplitApplyCombine.group.',
+  ['https://docs.julialang.org/en/v1/base/sort/','https://docs.julialang.org/en/v1/base/collections/','https://github.com/JuliaData/SplitApplyCombine.jl#grouping'],['JI01'])
+]
+def canonical(code): return code.strip() + '\n'
+def metrics(code):
+    effects=measure_throws(code,PATTERNS)
+    return {'without_complex_throws_characters':effects['without_complex_throws_characters'],'complex_throws_removed_characters':effects['removed_characters'],'characters_with_whitespace':len(code),'characters_without_whitespace':sum(not c.isspace() for c in code),'nonblank_lines':sum(bool(x.strip()) for x in code.splitlines()),'utf8_bytes':len(code.encode('utf-8'))}
+def sha(code): return hashlib.sha256(code.encode()).hexdigest()
+def write_json(path, value): path.write_text(json.dumps(value,ensure_ascii=False,indent=2)+'\n')
+
+def production():
+    found = {}
+    for path in sorted((CORE / 'src').rglob('*.lmx')):
+        lines = path.read_text().splitlines(keepends=True)
+        starts = []
+        for i, line in enumerate(lines):
+            match = re.match(r'^(?:independent:\s*)?((?:Fx|Rx)\w*)\s*(?:::|:)', line)
+            if match:
+                starts.append((i, match.group(1)))
+        for pos, (start, name) in enumerate(starts):
+            stop = starts[pos + 1][0] if pos + 1 < len(starts) else len(lines)
+            body = lines[start:stop]
+            while body and (not body[-1].strip() or body[-1].lstrip().startswith('#')):
+                body.pop()
+            if name in found:
+                raise ValueError('Duplicate production root: ' + name)
+            found[name] = {'code': ''.join(body).strip() + '\n', 'source': path.relative_to(CORE).as_posix()}
+    return found
+
+def refs(code, available=None):
+    # Follow actual qualified roots, model heads, copy/merge DATA streams and
+    # ready Structure values. Plain failure labels in throws banks are not calls.
+    clean = '\n'.join(line.split('#', 1)[0] for line in code.splitlines())
+    found = set(re.findall(r'\b((?:Fx|Rx)\w+)(?=\\|@)', clean))
+    found.update(re.findall(r'\b(?:copy|merge|import)\s*(?:\(|:)\s*((?:Fx|Rx)\w+)', clean))
+    if available is not None:
+        throws_indent = None
+        for line in clean.splitlines():
+            if not line.strip():
+                continue
+            indent = len(line) - len(line.lstrip())
+            if throws_indent is not None and indent <= throws_indent:
+                throws_indent = None
+            if line.lstrip().startswith('throws:'):
+                throws_indent = indent
+                continue
+            if throws_indent is not None or line.lstrip().startswith('throw:'):
+                continue
+            found.update(set(re.findall(r'\b(?:Fx|Rx)\w+\b', line)) & set(available))
+    return found
+
+def closure(names, available):
+    result, external, stack = set(), set(), list(names)
+    while stack:
+        name = stack.pop()
+        if name in result:
+            continue
+        if name not in available:
+            external.add(name)
+            continue
+        result.add(name)
+        if name != 'FxThrows':
+            stack.extend(refs(available[name]['code'], available) - result)
+    return result, external
+
+def public_roots(available):
+    aliases = {m[1]: m[2] for m in re.finditer(r'^\s*@:\s+(\w+)\s+((?:Fx|Rx)\w+)\\\w+', (CORE / 'src/public.lmx').read_text(), re.M)}
+    # New source can be reviewed before root exports are regenerated. Resolve
+    # only its real unambiguous method, never a fabricated comparison component.
+    for name, body in available.items():
+        for method in re.findall(r'^    ([a-z][A-Za-z0-9]*):\s*$', body['code'], re.M):
+            if method not in aliases:
+                candidates = [n for n, b in available.items() if re.search(r'^    ' + re.escape(method) + r':\s*$', b['code'], re.M)]
+                if len(candidates) == 1:
+                    aliases[method] = name
+    return aliases
+
+def main():
+    data=json.loads((R/'examples.json').read_text())
+    available=production(); aliases=public_roots(available); implementations=[]; mapping={}; all_defs=set(); primary_defs=set(); ledger=[]
+    for ident,title,filename,names,owners,contract,sources,dependencies in COMPONENTS:
+        missing=set(owners)-set(available)
+        if missing: raise ValueError(f'{ident}: {missing}')
+        lmx='\n'.join(available[x]['code'] for x in owners)
+        foreign=canonical((R/'library_comparisons'/filename).read_text())
+        source=f'library_comparisons/{ident}.lmx'
+        (R/source).write_text(lmx)
+        needed,external=closure(owners,available)
+        all_defs|=needed; primary_defs.update(owners)
+        rec={'id':ident,'title':title,'core_functions':names,'lmx':lmx,'foreign':foreign,'contract':contract,'sources':sources,
+             'source_files':{'lmx':source,'foreign':'library_comparisons/'+filename},
+             'implementation_dependencies':dependencies,'production_definitions':[{'name':x,'source':'../../LMX_Fn_Receivers/'+available[x]['source'],'sha256':sha(available[x]['code'])} for x in owners],
+             'shared_lmx_definitions':sorted(needed-set(owners)),'external_boundaries':sorted(external),'complete_with_declared_dependencies':True,'runtime_execution':'NOT_RUN'}
+        implementations.append(rec)
+        ledger.append({'id':ident,'primary_definitions':owners,'all_definitions':sorted(needed),'external_boundaries':sorted(external),
+                       'primary':metrics(lmx),'shared':metrics('\n'.join(available[x]['code'] for x in sorted(needed-set(owners))))})
+        for name in names: mapping[name]=f'library_comparisons/{ident}_comparision.md'
+    data['implementations']=implementations
+    data['core_additions']=[]
+    data['shared_existing_additions']=['sort','unique']
+    shared=all_defs-primary_defs
