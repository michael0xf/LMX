# A unary ordinary Structure has no implicit alias to its source.
# Caller working cells retain their snapshots after explicit external writes.
int: quote 7
int: signal 0
NoData:
    node\signal: 7
end: NoData
FreeOnly:
    quote: 9
    node\signal: quote
end: FreeOnly
S:
    int: x 2
    x: 4
end: S
X:
    int: x 0
end: X
@: held S
fn: try_call () int
    int: answer 81
    call: held
    catch: call ()
        answer: 7
    ---
    return: answer
end: try_call
fn: read_signal () int
    return: node\signal
end: read_signal
@: absent NoData 0
fn: try_null () int
    call: NoData absent
    catch: interpreter ()
        return: 7
    ---
    return: 86
end: try_null
int: answer try_call()
if: try_null() != 7
    answer: 86
if: S\[0]x != 2
    answer: 82
@: empty NoData
call: empty
if: read_signal() != 7 || signal != 0
    answer: 83
@: local FreeOnly
call: local
if: read_signal() != 9 || quote != 7 || signal != 0
    answer: 84
# Two root heads of x: as data S answers to no bare x and the selected call refuses; as code its two writes land in the one place of X.
int: refused 0
---
    call: held S
    catch: call ()
        refused: 1
---
if: refused != 1 || S\[0]x != 2
    answer: 85
call: held X
if: X\x != 4
    answer: 85
send: exit(exit_code: answer; stdout: ""; stderr: "")
return
