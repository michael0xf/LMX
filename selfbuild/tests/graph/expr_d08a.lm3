# Witness expr_d08a -- D08a: 0 && tick(): the skipped branch runs no call
# Norm: ТЗ 10.3. Step: a. The expected file holds the values BY THE NORM; the code echo is the builder's echo re-written by the flatten rule of step (a).
(
    Observed:
        int: seen 0
        int: ticks 0
)
fn: tick () int
    @: shared node[0]
    shared\Observed\ticks := shared\Observed\ticks + 1
    return: shared\Observed\ticks
sub: main () (
    int: seen 5
)
    @: shared node[0]
    seen := 0 && tick()
    shared\Observed\seen := seen
main()
