# Probe, slice 275: the map of an admitted reordered Structure at a modelled formal, an own reference and a field reference.  Entry 7.
Model:
    int: y 3
end: Model
Other:
    int: z 9
    int: y 7
end: Other
Box:
    @: kid Model Model
end: Box
fn: formal (@: p Model) int
    return: p\y
end: formal
fn: own () int
    @: q Model Other
    return: q\y
end: own
fn: write_it (@: p Model) int
    p\y: 8
    return: p\y
end: write_it
fn: m () int
    if: formal(Other) != 7
        return: 81
    if: own() != 7
        return: 82
    Box\kid: Other
    if: Box\kid\y != 7
        return: 83
    if: write_it(Other) != 8 || Other\y != 8 || Other\z != 9
        return: 84
    return: 7
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
