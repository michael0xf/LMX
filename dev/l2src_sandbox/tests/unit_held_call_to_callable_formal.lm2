# An explicitly declared callable formal receives the occurrence of the
# callable it is given and does not execute it on reception. run's formal q
# is declared by the method f0, whose header takes nothing and gives an int.
# The held callable p0 has that header: run(p0) hands p0 itself, nothing is
# called before run's body calls q, and the two calls of q there give 100
# each and note 1 each. Entry 7.
int: trace 0

fn: note (int: v) int
    node\trace: node\trace + v
    return: 0
end: note

fn: seen () int
    return: node\trace
end: seen

fn: f0 () int
    return: 1
end: f0

fn: make0 (int: n) fn: () int
    fn: g0 () int
        return: n + note(1)
    return: g0

fn: run (f0: q) int
    if: seen() != 0
        return: 80
    return: q() + q()
end: run

p0: make0 100
int: r run(p0)
int: ok 7
if: r != 200
    ok: 81
if: seen() != 2
    ok: 82
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
