# Original: l2src/l2trans.lm1:4474
fn: lm_compiler_unit_role (const: (@: item c.LmP0Node)) int
    @@: ns_parent_cell int (cast: (@@: int) (@ c.l2_ns_parent))
    const: (@: fr c.LmP0Frame)
    @: ah c.LmP0Text c.lm_compiler_app_head(item)
    # K03 S5: the item's application -- the atom or its Frame (l2_app_head) -- decides: `fn` and `fn()`, `os` and `os()`,
    # `include` and `include()` are one item each, meeting one contract.
    if: c.lm_compiler_root_method_head(ah) != 0
        return: (cast: (int) (1))
    if: c.lm_compiler_text_eq(ah, "independent") != 0
        return: (cast: (int) (2))
    if: c.lm_compiler_text_eq(ah, "os") != 0
        return: (cast: (int) (3))
