# Ordinary text algorithms. Public names are wired in public.lmx.
# The input is char[] and positions/counts are octets in the declared byte
# profile, not grapheme/display-column positions. There is no implicit locale.
# Existing UTF-8 TextView/Pattern operations remain the Unicode search route.
# Exact equality already exists as matches(byteText(first); second).

FxTextSearch:
    private:
        char[]: text
        char[]: part
        int: start
        int: backwards
    return: int
    search:
        char[]: unitSource text
        char[]: unitPart part
        if: length(part) > length(text)
            return: -1
        private: int: last length(text) - length(part)
        private: int: at start
        private: int: step 1
        private: int: stop last
        if: at < 0
            at := 0
        if: backwards != 0
            step := -1
            stop := 0
            if: at > last
                at := last
        ---
        else:
            if: at > last
                return: -1
        ---
        while: 1
            if: FxUnitRange\equal(at) != 0
                return: at
            if: at = stop
                return: -1
            at += step

FxIndexOf:
    private:
        char[]: text
        char[]: part
        int: start 0
    return: int
    indexOf:
        return: FxTextSearch\search(text; part; start; 0)

FxLastIndexOf:
    private:
        char[]: text
        char[]: part
        int: start length(text)
    return: int
    lastIndexOf:
        return: FxTextSearch\search(text; part; start; 1)

FxCompareText:
    private:
        char[]: first
        char[]: second
    return: int
    compareText:
        throws: copy(FxThrows\kernel)
        private: @: a FxSeqInfo\get(first)
        private: @: b FxSeqInfo\get(second)
        if: a\elementBits != 8 || b\elementBits != 8
            throw: FxTypeToken()
        private: int: i 0
        while: i < length(first) && i < length(second)
            private: int: x RxOctet\read(first; i)
            private: int: y RxOctet\read(second; i)
            if: x != y
                return: (x > y) - (x < y)
            i += 1
        return: (length(first) > length(second)) - (length(first) < length(second))

FxCharIndex:
    private:
        char[]: chars
        char: value
    return: int
    index:
        private: int: i 0
        while: i < length(chars)
            if: chars[i] = value
                return: i
            i += 1
        return: -1

FxTextTrim:
    private:
        char[]: text
        char[]: chars
        int: side
    return: char[]
    trim:
        throws: copy(FxThrows\sequence)
        private: int: begin 0
        private: int: end length(text)
        if: side != 2
            while: begin < end
                if: FxCharIndex\index(chars; text[begin]) < 0
                    break
                begin += 1
        ---
        if: side != 1
            while: end > begin
                if: FxCharIndex\index(chars; text[end - 1]) < 0
                    break
                end -= 1
        ---
        return: \FxSeqSlice\slice(text; begin; end)

FxTrimInputs:
    private:
        char[]: text
        char[]: chars " \t\r\n\v\f"
    return: char[]

FxTrim:
    copy: FxTrimInputs
    trim:
        throws: copy(FxThrows\sequence)
        return: FxTextTrim\trim(text; chars; 0)

FxTrimStart:
    copy: FxTrimInputs
    trim:
        throws: copy(FxThrows\sequence)
        return: FxTextTrim\trim(text; chars; 1)

FxTrimEnd:
    copy: FxTrimInputs
    trim:
        throws: copy(FxThrows\sequence)
        return: FxTextTrim\trim(text; chars; 2)

# Repetition delegates to the single storage-preserving generic cycle body.
# This text contract rejects negative counts before using that shared body.
FxRepeatText:
    private:
        char[]: text
        int: count
    return: char[]
    repeatText:
        throws: copy(FxThrows\sequence)
        if: count < 0
            throw: SequenceSize()
        return: \FxStdCycle\cycle(text; count)

FxTextPad:
    private:
        char[]: text
        int: width
        char[]: fill
        int: right
    return: char[]
    pad:
        throws: copy(FxThrows\sequence)
        if: width <= length(text)
            return: \FxSeqSlice\slice(text; 0; length(text))
        private: int: missing width - length(text)
        if: length(fill) = 0
            throw: SequenceSize()
        private: int: count missing / length(fill)
        private: int: rest missing % length(fill)
        private: char[]: padding FxRepeatText\repeatText(fill; count)
        private: char[]: tail \FxSeqSlice\slice(fill; 0; rest)
        private: char[]: extra \FxSeqConcat\concat((padding; tail))
        if: right != 0
            return: \FxSeqConcat\concat((text; extra))
        return: \FxSeqConcat\concat((extra; text))

FxPadInputs:
    private:
        char[]: text
        int: width
        char[]: fill " "
    return: char[]

FxPadLeft:
    copy: FxPadInputs
    pad:
        throws: copy(FxThrows\sequence)
        return: FxTextPad\pad(text; width; fill; 0)

FxPadRight:
    copy: FxPadInputs
    pad:
        throws: copy(FxThrows\sequence)
        return: FxTextPad\pad(text; width; fill; 1)

# Translation is literal and simultaneous. Duplicate source characters use
# their first mapping; unmapped characters survive. No regex interpolation.
FxTranslate:
    private:
        char[]: text
        char[]: from
        char[]: to
    return: char[]
    translate:
        throws: copy(FxThrows\sequence)
        if: length(from) != length(to)
            throw: SequenceSize()
        private: char[]: out \FxSeqSlice\slice(text; 0; length(text))
        private: int: i 0
        while: i < length(text)
            private: int: found FxCharIndex\index(from; text[i])
            if: found >= 0
                out[i] := to[found]
            i += 1
        return: out

# A caller supplies already rendered text parts. The generic intercalate
# algorithm owns separator placement, allocation and overflow checks.
FxJoin:
    private:
        @: parts
        char[]: separator ""
    return: char[]
    join:
        throws: copy(FxThrows\mutation)
        return: \FxStdIntercalate\intercalate(parts; separator)

# Existing hasPrefix, hasSuffix, matches, replace and split already accept
# literal text patterns. Clients choose byteText/utf8Text explicitly; there are
# no parallel public string-equality, prefix, suffix or replacement algorithms.

# Exact signed integer formatting. This also owns the decimal digit algorithm
# used by graph/callable builders; they do not keep another copy of that loop.
FxFormatInt:
    private:
        bigint: value
        int: base 10
    return: char[]
    formatInt:
        throws: copy(FxThrows\selection)
        if: base < 2 || base > 36
            throw: FxIndex()
        private: char[]: digits "0123456789abcdefghijklmnopqrstuvwxyz"
        private: bigint: magnitude value
        private: int: negative value < 0
        if: negative != 0
            magnitude := -magnitude
        private: char[]: out []
        private: @: info FxSeqInfo\get(out)
        while: 1
            private: int: digit magnitude % base
            private: int: at length(out)
            sys\resize(out; FxSeqSize\sum(at; 1; info\maxLength))
            out[at] := digits[digit]
            magnitude := magnitude / base
            if: magnitude = 0
                break
        ---
        if: negative != 0
            out := \FxSeqConcat\concat((out; "-"))
        return: \FxSeqReverse\reverse(out)

FxParseInt:
    private:
        char[]: text
        int: base 10
    return: bigint
    parseInt:
        throws: NumericDomain
        if: base < 2 || base > 36 || length(text) = 0
            throw: NumericDomain()
        private: char[]: digits "0123456789abcdefghijklmnopqrstuvwxyz"
        private: int: at 0
        private: int: negative 0
        if: text[0] = '-' || text[0] = '+'
            negative := text[0] = '-'
            at := 1
        if: at = length(text)
            throw: NumericDomain()
        private: bigint: result 0
        while: at < length(text)
            private: char: value text[at]
            if: value >= 'A' && value <= 'Z'
                value := value - 'A' + 'a'
            private: int: digit FxCharIndex\index(digits; value)
            if: digit < 0 || digit >= base
                throw: NumericDomain()
            result := result * base + digit
            at += 1
        if: negative != 0
            result := -result
        return: result

FxRemoveAffix:
    private:
        char[]: text
        char[]: affix
        int: suffix
    return: char[]
    remove:
        throws: copy(FxThrows\sequence)
        char[]: unitSource text
        char[]: unitPart affix
        private: int: begin 0
        private: int: end length(text)
        private: int: at 0
        if: suffix != 0
            at := end - length(affix)
        if: FxUnitRange\equal(at) != 0
            if: suffix != 0
                end -= length(affix)
            else:
                begin := length(affix)
        ---
        return: \FxSeqSlice\slice(text; begin; end)

FxAffixInputs:
    private:
        char[]: text
        char[]: affix
    return: char[]

FxRemovePrefix:
    copy: FxAffixInputs
    remove:
        throws: copy(FxThrows\sequence)
        return: FxRemoveAffix\remove(text; affix; 0)

FxRemoveSuffix:
    copy: FxAffixInputs
    remove:
        throws: copy(FxThrows\sequence)
        return: FxRemoveAffix\remove(text; affix; 1)
