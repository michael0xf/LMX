predef: "l2src/lmx.h.lm1"
include: "<stddef.h>" "<limits.h>"
predef: "l2src/lmx_arena.h.lm1"
predef: "lmx_graph_copy_owned.h.lm1"

# Runtime merge over the accepted used-graph copier (SPEC 2.3/21, user
# decisions 2026-09-12). Merge takes live operand Structures left to right and
# an optional body Structure whose fields follow the operand children, and
# produces a THIRD INDEPENDENT Structure. The operands are never written: two
# structures in, three out.
#
# With a null override map the result's direct slots are, in order, the copies
# of each operand's direct children, operand by operand and child by child, then
# the body's fields (flat append). With a non-null map (Q21 = A): the model
# (operands[0]) keeps its layout; each pair stores an operand field's value into
# a model slot; unmatched later-operand fields append; body fields append. The
# operand ROOTS are not visible result slots; only their children are.
# With one operand, no body and no active overrides, the completed used-graph
# copy itself is the fresh result. It keeps native, self/back edges, names and
# the parent the copy gave it. Exact-profile retention still returns
# the original occurrence without changing it. General composition requires
# separate whole-body/native selection and is not certified by this identity.
#
# ONE lmx_graph_copy_many_owned operation, hence one operation-local map, spans
# every ordinary operand root and the body root together. An object reachable
# from two operands is therefore copied ONCE and both references point at that
# one copy; cross-operand aliases and cycles keep their shape; every copied
# Structure's parent is rewritten to the copy of its structural parent or to zero.
# Every operand is an ordinary Structure. The copier includes ordinary lexical
# trees; an outside parent does not by itself make a Structure a shared terminal.
# Only the exact retained physical profiles and actual terminal values remain
# shared by address. An operand that does not classify as a Structure is refused.
#
# Qualification is an address-domain property.  A caller may name any number of ordinary
# graph receiver-expressions whose physical addresses denote full
# independent+const+immutable profiles.  Only exact membership in an array carrying one of
# those physical profiles retains an address; another profile with identical kind/type, an
# unprofiled independent root, foreign ownership, and sealing all take the copy path.
# A retained foreign address must already be visible through an explicit sealed-range import
# in dst_arena. Only sealed ranges may be retained; merge never adopts their storage or
# installs a hidden range view. The caller supplies the profiles as a call-bounded span of
# physical Lmx references. Duplicates are idempotent; no global set, numeric qualifier or
# textual identity participates.
#
# TWO arenas, because the act has two sides: `src_arena` is the arena the
# operands and the body live in and answers every classification
# question; `dst_arena` is the arena the copies and the result are built in.
#
# The result's parent is the copy's own: merge copies the used part of the tree and
# rewrites parent links inside the copy; the place that executes the merge has no part
# in it (the author, LMX_blog/2026-10-05.md#merge-parent; docs #composition).  One
# operand: the completed copy keeps the parent the copier gave it -- the copy of the
# model's structural parent, an exact retained-profile parent's own address, or zero.
# A composition: the fresh root takes the model's (operands[0]'s) place, so its parent is
# the one the copier gave the model's copy, and the copy absorbs the operand roots into it
# -- every link the copy makes to a copied operand root names the result, never a
# discarded intermediate root (lmx_graph_copy_many_profiles_staged's `absorb`).  No
# argument names a parent.
#
# Atomicity is the arena's own act, exactly as it is for one Array: merge takes
# `mark: lmx_arena_mark(dst_arena)` before it builds anything and reverts to it
# on any failure, so the copies, the result root and its slots join dst_arena
# together or none of them does. On any failure out stays null, the destination
# arena is left as it was at the mark, every source graph is unchanged. There is
# no empty-success substitute for a failed merge.
# One override pair from the translator: store operand[k].field[j]'s value into
# the model's slot of the result (Q21 = A specialization). Null map / count 0
# keeps today's flat append. The graph has no names; the translator resolves
# matches and hands pairs of positions.
struct: LmxMergePair
    size_t: model_slot
    size_t: operand
    size_t: field
end: LmxMergePair

define: LMX_MERGE_OK 0
define: LMX_MERGE_INVALID 1
define: LMX_MERGE_NOMEM 2
define: LMX_MERGE_UNSUPPORTED 3

prototype:
    # Exposed so the overflow boundary can be exercised directly: a width
    # past SIZE_MAX is not constructible as a live Structure in a test
    # without fabricating a header, and a fabricated header would test the
    # fake rather than the guard.
    fn: lmx_merge_add_width (@: size_t total; @: Lmx x) int
    # `overrides` null or override_count 0 = flat append (today). Non-null: model
    # (operands[0]) layout kept; each pair writes operand[k].field[j] into the
    # model's slot; unmatched later-operand fields append; body appends as today.
    fn: lmx_merge_owned (@@: Lmx operands; size_t: count; @: Lmx body; @: LmxArena src_arena; @: LmxArena dst_arena; @@: LmxMergePair overrides; size_t: override_count; @@: Lmx out) int
    fn: lmx_merge_profiles_owned (@@: Lmx operands; size_t: count; @: Lmx body; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @@: LmxMergePair overrides; size_t: override_count; @@: Lmx out) int
    # The same merge with the uses of its copied code (Q42; Codex K03-READ-FIELD-CLOSURE-20261007-28): use k
    # is a slot path of use_len[k] >= 1 slots (consecutive in use_slot, use_slots in all) from its anchor --
    # source Structure use_anchor[k] when use_sel[k] is 0, else the lexical parent of operand use_sel[k] - 1
    # (an operand with none: the use names nothing) -- a
    # lexical ancestor of an operand or a Structure reached from one; the operands' lexical chains are copied
    # in part -- their links and these uses -- every other ancestor place absent
    # (lmx_graph_copy_many_used_staged).  lmx_merge_profiles_owned is this merge with no use.
    fn: lmx_merge_used_owned (@@: Lmx operands; size_t: count; @: Lmx body; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @@: Lmx use_anchor; @: size_t use_sel; @: size_t use_slot; @: size_t use_len; size_t: use_count; size_t: use_slots; @@: LmxMergePair overrides; size_t: override_count; @@: Lmx out) int
    # A fresh merge made under a qualified profile: the result and every copied cell in the pools of dst_profile, a
    # Structure of dst_arena (RR2a); the caller preflights, frees the root of a lexical parent when independent, and
    # seals before publication.
    fn: lmx_merge_qualified_owned (@@: Lmx operands; size_t: count; @: Lmx body; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @@: LmxMergePair overrides; size_t: override_count; @: Lmx dst_profile; @@: Lmx out) int
    # `retain_profile` is the exact physical profile representing the full
    # independent+const+immutable receiver chain.  No other profile/lifecycle/owner
    # property retains an address.
    fn: lmx_merge_profiled_owned (@@: Lmx operands; size_t: count; @: Lmx body; @: LmxArena src_arena; @: LmxArena dst_arena; @: Lmx retain_profile; @@: LmxMergePair overrides; size_t: override_count; @@: Lmx out) int
    # One pair's value, copied from src's own field into dst's own slot -- shared by
    # lmx_merge_profiles_owned's override path and lmx_merge_into_profiles_owned.
    fn: lmx_merge_apply_pair (@: Lmx src; size_t: field; @: Lmx dst; size_t: target_slot) int
    # -194 к.3 (Q26.1 / Q1): merge INTO an already-existing target -- op's fields are
    # copied and written into target's existing slots (target keeps its address and its
    # own parent; nothing is built fresh). The pair map must be an exact bijection onto a
    # subset of target's slots: pair_count = op's own width, no source field or target
    # slot repeated (target's layout is fixed once built, so an unmatched op field is
    # INVALID, never appended). A target slot no pair names is left untouched.
    fn: lmx_merge_into_profiles_owned (@: Lmx target; @: Lmx op; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @@: LmxMergePair pairs; size_t: pair_count) int
    fn: lmx_merge_into_owned (@: Lmx target; @: Lmx op; @: LmxArena src_arena; @: LmxArena dst_arena; @@: LmxMergePair pairs; size_t: pair_count) int
    # -174 c3: walk PRIM entry for Model: m (see lmx_walk.h.lm1).
    fn: lmx_walk_merge_model (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    # -194 к.6 (K2), D1: decodes a PRIM's inline pairs (3 size cells each, (model_slot, operand, field)) into the
    # LmxMergePair** shape the kernel's own merge functions take; freed by lmx_walk_merge_pairs_free. Shared by both
    # walk PRIM entries below.
    fn: lmx_walk_merge_pairs_cells (@: LmxArena arena; @@: void cells; size_t: n; @@@: LmxMergePair out_pairs; @: size_t out_count) int
    fn: lmx_walk_merge_pairs_free (@@: LmxMergePair pairs; size_t: n) void
    # -194 к.6: walk PRIM entry for a fresh multi-operand merge with an override map,
    # `R: merge: A B ... [body]` -- [prim, record, catch, P, Q,
    # boxed_fresh_token, boxed_direct_source_token, op0, ..., opN-1, body_or_0,
    # 3P pair cells, Q qualified branch roots]. The result's parent is the copy's own,
    # as above; the reached place gives none; the program's Q qualified branches are
    # retained by their exact profiles as the operands' are. Source evidence may
    # name only a directly known operand producer, never its receiving model.
    # A retained result preserves its held layout; a fresh result gets its own.
    # к.b (-202): each operand's lmx_range_profile, when nonzero, is collected and passed
    # to lmx_merge_profiles_owned as retain_profiles -- classified by the arena alone,
    # matching what the native emission already does (l2trans.lm1:20390-20399).
    # RR2c-2b: the exact profile an operand is retained by -- its profile when it lies in a qualified tree whose
    # root has no lexical parent (the independent immutable branch, static or made at run time) -- or 0: a qualified
    # value under a lexical parent is copied as any value is.  Read by the native merge emission and the walk alike.
    fn: lmx_merge_retain_profile (@: LmxArena arena; @: Lmx operand) @: Lmx
    fn: lmx_walk_merge_map (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    # RR2d: the same merge under the qualifier chain -- its own PRIM entry: after the ordinary inputs a trailer
    # [L leaf slots, O opaque type ids, roles, L, O, bits (1 independent, 4 immutable)]; the native emission's steps
    # (parent freed, the subtree copied under a fresh profile with the callable fields as leaves, the layout proved,
    # the tree proved, the pools sealed) before the value is published; a failed qualification is status 1.
    fn: lmx_walk_merge_qualified_map (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    # RR2d-2: the field PRIM of a merge operand written as a typed declaration: [kind, value] -> a fresh Structure of
    # one cell of that kind holding the value; the merge copies it as any operand.
    fn: lmx_walk_field_map (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    fn: lmx_walk_merge_run (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; size_t: bits; @: Lmx roles; @: size_t leaf_slots; size_t: leaf_count; @: int opaque_ids; size_t: opaque_count) int
    # Successful construction only: publish genuine producer evidence without
    # relabeling an operand whose exact descriptor the copier retained.
    fn: lmx_merge_result_layout (@: LmxArena arena; @: Lmx result; @@: Lmx operands; size_t: count; @: void fresh; @: void direct_source) int
    # -194 к.6: walk PRIM entry for merge INTO an existing target (Q26.1's own-field
    # write, `o\inner: a`) -- [prim, record, catch, target, op, P, 3P pair cells] (D1); \out is always 0.
    fn: lmx_walk_merge_into_map (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
end: prototype
