Counter:
    int: value 0
    Add:
        int: delta
        return: int
        add:
            @: owner parent(node)
            owner\value += delta
            return: owner\value

Example:
    int: initial
    return: @
    run:
        @: first (merge(Counter; (int: value initial)))
        @: second (merge(Counter; (int: value 100)))
        return: (first\Add\add(1); first\Add\add(3); second\Add\add(2); first\Add\add(-2))
