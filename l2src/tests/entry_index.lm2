# An argument read by index: m\mainArgs[1] is argv[1]'s char Array at exact
# len, no NUL. c.puts wants a C string; that copy is the c.* door. This row
# stays root-pending because the call is outside a method (Q7), not because
# the graph stores a NUL.
MainLetter:
    char: []: []: mainArgs
end: MainLetter

MainLetter: m
receiveMessage: m
if: length(m\mainArgs) != 2
    sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
    return
c.puts: @ m\mainArgs[1][0]
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
