MapBytesParseInt:
    @: bytes
    int: begin 0
    int: end -1
    int: limit 2147483647
    required: bytes
    return: int
    parseInt:
        throws: copy(MapThrows)
        if: end < 0
            end := bytes\count
        if: begin < 0 || end <= begin || end > bytes\count || limit < 1
            throw: MapFailure("integer text range")
        int: at begin
        int: negative 0
        int: first MapBytes\get(bytes; at)
        if: first = 45 || first = 43
            negative := first = 45
            at += 1
        if: at = end
            throw: MapFailure("integer has no digits")
        int: minimum 0 - limit
        if: negative != 0
            minimum -= 1
        int: cutoff minimum / 10
        int: result 0
        while: at < end
            int: digit MapBytes\get(bytes; at) - 48
            if: digit < 0 || digit > 9 || result < cutoff
                throw: MapFailure("invalid or overflowing decimal")
            result *= 10
            if: result < minimum + digit
                throw: MapFailure("decimal overflow")
            result -= digit
            at += 1
        if: negative != 0
            return: result
        return: 0 - result

