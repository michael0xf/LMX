fn: read () int
    Outer:
        int: pad 17
        Inner:
            int: x 11
        end: Inner
        @: Inner ref Inner
    end: Outer
    if: Outer\ref != Outer\Inner || Outer\ref\x != 11
        return: 81
    if: @Outer\ref\x != @Outer\Inner\x
        return: 81
    Outer\ref\x: 13
    if: Outer\Inner\x != 13 || Outer\pad != 17
        return: 81
    return: Outer\Inner\x
end: read
int: ok 7
if: read() != 13
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
