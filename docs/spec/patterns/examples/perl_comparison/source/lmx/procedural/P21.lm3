Example:
    []char: text
    return: []char
    run:
        throws: copy(sys\resize\throws)
        []char: from "ACGT"
        []char: to "TGCA"
        []char: out []
        sys\resize(out; length(text))
        int: i 0
        while: i < length(text)
            char: value text[i]
            int: j 0
            while: j < length(from)
                if: value = from[j]
                    value := to[j]
                    break
                j += 1
            out[length(text) - 1 - i] := value
            i += 1
        return: out
