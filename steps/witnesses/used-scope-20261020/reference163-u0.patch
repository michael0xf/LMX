+                held: application\held
+                bound: application\bound
+            ---
+        ---
+    ---
+    if: source = 0
+        # Numeric/composite/address values without a source port have
+        # unknown provenance. Their ordinary value/type checks still run.
+        out\origin: value\node
+        out\origin_count: value\count
+        out\origin_method: mi
+        return: 0
+    if: source\status != 0 && source\method = mi && source\revision = l2_value_revision && source\source_revision = l2_source_revision && source\signature = signature && source\held = held && source\bound = bound
+        if: source\status < 0
+            return: 1
+        \out: source\result
+        return: 0
+    source\status: 0
+    status: l2_reference_value_core(value, mi, selected, out)
+    out\origin: value\node
+    out\origin_count: value\count
+    out\origin_method: mi
+    source\method: mi
+    source\revision: l2_value_revision
+    source\source_revision: l2_source_revision
+    source\signature: signature
+    source\held: held
+    source\bound: bound
+    if: status != 0 || l2_alloc_err != 0
+        source\status: -1
+        return: 1
+    source\result: \out
+    source\status: 1
+return: 0
