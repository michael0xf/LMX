    # Every input with a receiving schema uses that schema's bound map.
    # Predicted source substitutions/capture origins do not prove physical
    # identity: an opaque actual can carry a genuine reordered admission.
    # The SAME root verdict is retained for CHECK, native and walker.
    if: fi >= 0 && cur_mi_cell[0] >= 0
        view_model: c.lm_compiler_input_schema(cur_mi_cell[0], fi)
    # Only a signature description stores its requirement in args. A
    # transported value's header child is a typed value cell, not that model.
    # Use the same logical input category as header construction/marshalling.
    out\model_input: lm_compiler_path_root_model_input(cur_mi_cell[0], fi)
    if: oi >= 0 && lm_compiler_d105_sub(own_mi_cell[0][oi], c.lm_compiler_d105_own_key(oi)) != 0
        view_model: c.lm_compiler_input_schema(own_mi_cell[0][oi], c.lm_compiler_d105_own_key(oi))
    # A named receiving contract is independent of predicted candidate flow.
    # Read its already bound model in the declaration's namespace, not the
    # candidate's composed layout or a new lookup of its source type word.
    # Ordinary definitions/constructed results have no such pointer contract;
    # their existing physical/composed coordinate mode above remains intact.
