        out\leaf_level: value
    ---
    out\in_eternal: protected
    return: (cast: (int) (0))
end: lm_compiler_path_walk_steps_from

# Original: l2src/l2trans.lm1:25398
fn: lm_compiler_path_walk (@: out c.L2Path) int
    @: alloc_err_cell int (cast: (@: int) (@ c.l2_alloc_err))
    if: alloc_err_cell[0] != 0
        return: (cast: (int) (c.lm_compiler_path_fail(out, 0, 7)))
    if: out\n < 0 || (out\n > 0 && out\steps = 0) || out\text = 0 || out\length = 0U
        return: (cast: (int) (c.lm_compiler_path_fail(out, 0, 4)))
    if: lm_compiler_path_root_resolve(out) != 0
        return: (cast: (int) (c.lm_compiler_path_fail(out, 0, 1)))
    return: (cast: (int) (lm_compiler_path_walk_selected(out)))
end: lm_compiler_path_walk

# Original: l2src/l2trans.lm1:25409
fn: lm_compiler_path_walk_selected (@: out c.L2Path) int
    @: cur_mi_cell int (cast: (@: int) (@ c.l2_cur_mi))
    int: status
    if: lm_compiler_path_root_close(out, cur_mi_cell[0]) != 0
        return: (cast: (int) (c.lm_compiler_path_fail(out, 0, 7)))
    status: lm_compiler_path_walk_bound(out)
    if: lm_compiler_path_fact_note(out) != 0
        return: (cast: (int) (c.lm_compiler_path_fail(out, (cast: (int) (out\fail_seg)), 4)))
    return: (cast: (int) (status))
end: lm_compiler_path_walk_selected

# Original: l2src/l2trans.lm1:25421
fn: lm_compiler_path_walk_bound (@: out c.L2Path) int
    @: alloc_err_cell int (cast: (@: int) (@ c.l2_alloc_err))
    @@: ns_eternal_cell int (cast: (@@: int) (@ c.l2_ns_eternal))
    @: for_n_cell int (cast: (@: int) (@ c.l2_for_n))
    @@: for_mi_cell int (cast: (@@: int) (@ c.l2_for_mi))
    @: cur_mi_cell int (cast: (@: int) (@ c.l2_cur_mi))
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    @@@: own_decl_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_own_decl))
    int: ni 0 - 1
    int: res 0 - 1
    int: oi 0 - 1
    int: root_kind 0
    int: root 0 - 1
    int: fi 0 - 1
    int: bh 0 - 1
    int: bm 0 - 1
    int: view_model -1
    int: protected 0
    int: original 0
    int: status
    @: value c.L2TypeContract 0
    @: receiving c.L2TypeContract 0
    if: alloc_err_cell[0] != 0
        return: (cast: (int) (c.lm_compiler_path_fail(out, 0, 7)))
    @: source_value c.L2ValueSource (cast: (@: c.L2ValueSource) (@ out\source_value))
    source_value\status: 0
    out\model_input: -1
    if: out\n < 0 || (out\n > 0 && out\steps = 0)
        return: (cast: (int) (c.lm_compiler_path_fail(out, 0, 4)))
    ni: out\ni
    res: out\res
    oi: out\oi
    root_kind: out\root_kind
    root: out\root
    fi: out\fi
    # Qualification (RR2): only the exact original namespace root proves the selected value qualified; a declared
    # model is not an immutable address -- a formal or a local reference can hold a compatible mutable value.
    if: ni >= 0 && root_kind = 0 && oi < 0 && fi < 0 && res < 0
        original: 1
        if: ns_eternal_cell[0][ni] >= 0
            protected: 1
        ---
    ---
    if: c.lm_compiler_own_in_eternal(oi) != 0 || (root_kind = 2 && root < for_n_cell[0] && c.lm_compiler_method_in_eternal(for_mi_cell[0][root]) != 0)
        protected: 1
    # The host the next name is resolved in: a body root's body, a method root's own level, an own root's Structure
    # (FABLE-SONNET-FIELD-PATHS-20260923-113: seeded with the own field's Structure type, if known; unknown refuses at
    # the first name below, the same "no Structure here" outcome a non-Structure slot gives).
    if: root_kind = 2
        bh: root
    if: root_kind = 3
        bm: root
    if: oi >= 0
        ni: c.lm_compiler_own_nsty_get(oi)
    # The value an own or formal root is (R5-2: a binding's carried contract), for an index step that follows it at once.
    if: out\n = 0 || out\steps\locus = 7
        value: c.lm_compiler_path_root_contract(out)
