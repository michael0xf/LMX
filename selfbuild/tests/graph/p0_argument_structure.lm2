# M8: the same written shape is a value for a Structure formal, or fields for
# numeric formals. Restoring parser unwrapping loses the first argument's shape.
sub: main () (
    Q(int: x 0)
    int: retained 0
    int: unpacked 0
)
    fn: take_value (@: value Q) int
        return: value\x
    fn: take_field (int: x) int
        return: x
    retained := take_value((int: x 7))
    unpacked := take_field((int: x 7))
main()
int: retained main\data\retained
int: unpacked main\data\unpacked
