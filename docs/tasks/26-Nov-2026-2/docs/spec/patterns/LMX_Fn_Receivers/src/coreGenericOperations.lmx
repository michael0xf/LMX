# One algorithm per semantic action. Public input/output adapters preserve the
# actual value records and publish the exact result of the selected profile.
# Ordinary call and Expression use these same bodies.

FxProjectValue:
    private:
        @: value
        @: projection 0
    required: value
    return: @
    get:
        throws: copy(FxThrows\call)
        if: projection = 0
            return: value
        return: FxApply\apply(projection; FxOne\make(value))

FxEquals:
    private:
        @: first
        @: second
        @: projection 0
        @: same 0
    required: first second
    return: int
    equals:
        throws: copy(FxThrows\predicate)
        private: @: a FxProjectValue\get(first; projection)
        private: @: b FxProjectValue\get(second; projection)
        return: FxValueSame\test(a; b; same)

FxPipe:
    private:
        @: value
        @: stages
    required: value stages
    return: @
    pipe:
        throws: copy(FxThrows\call) FxArity ReceiverIndex
        FxSeqInfo\get(stages)
        private: @: current value
        private: int: i 0
        while: i < length(stages)
            private: @: stage \FxSeqRead\read(stages; i)
            private: @: shape FxKernel\signature(stage)
            if: length(shape\inputTypes) != 1 || shape\hasResult = 0
                throw: FxArity()
            current := FxApply\apply(stage; FxOne\make(current))
            i += 1
        return: current

# Exact prepared pipe T -> R, for publication when the stage list is fixed.
# The same engine is used; FxWrap supplies true result R, never a false @ ABI.
FxPipeState:
    @: stages 0

FxPipeEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws: copy(FxThrows\call) FxArity ReceiverIndex
        private: @: slot FxKernel\frameSlot(frame; 0; 1)
        return: FxPipe\pipe(slot\value; state\stages)

FxPipeBuild:
    private:
        @: inputType
        @: stages
    required: inputType stages
    return: @
    make:
        throws: copy(FxThrows\adapter)
        private: @: resultType FxKernel\normalizeType(inputType)
        private: @: failures (copy(()))
        private: int: i 0
        while: i < length(stages)
            private: @: operation \FxSeqRead\read(stages; i)
            private: @: shape FxKernel\signature(operation)
            if: length(shape\inputTypes) != 1 || shape\hasResult = 0
                throw: FxArity()
            resultType := shape\resultType
            failures := FxFailures\union(failures; shape\throws)
            i += 1
        private: @: input FxKernel\normalizeType(inputType)
        private: @: contract FxSignatures\make(FxOne\make(input); resultType)
        private: @: state (copy(FxPipeState))
        state\stages := FxSeqRecords\make(stages)
        return: FxWrap\make(contract; FxPipeEngine\run; state; failures)

FxRetryValue:
    private:
        @: operation
        @: retryOn
        int: limit
        @: delay 0
        @: arguments ()
    required: operation retryOn limit
    return: @
    retry:
        throws: copy(FxThrows\call) FxArity FxPredicate FxRecordArity ReceiverIndex
        if: limit < 1
            throw: FxArity()
        private: int: attempt 1
        while: 1
            private: @: result FxApply\apply(operation; arguments)
            if: attempt = limit
                return: result
            private: @: retryArgs FxTwo\make(result; (attempt FxRecordOperands\record))
            if: FxSeqPredicate\truth(FxApply\apply(retryOn; retryArgs)) = 0
                return: result
            if: delay != 0
                FxApply\apply(delay; FxOne\make((attempt FxRecordOperands\record)))
            attempt += 1

# retry decides on ordinary results. retryCall owns declared-exception retry;
# retryPost owns asynchronous Message completion. Their effects stay distinct.

FxRetryValueState:
    @: operation 0
    @: retryOn 0
    int: limit
    @: delay 0
    @: arguments ()

FxRetryValueEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws: copy(FxThrows\call) FxArity FxPredicate FxRecordArity ReceiverIndex
        return: FxRetryValue\retry(
            state\operation;
            state\retryOn;
            state\limit;
            state\delay;
            state\arguments
        )

FxRetryBuild:
    private:
        @: operation
        @: retryOn
        int: limit
        @: delay 0
        @: arguments ()
    required: operation retryOn limit
    return: @
    make:
        throws: copy(FxThrows\adapter)
        private: @: shape FxKernel\signature(operation)
        if: shape\hasResult = 0 || limit < 1
            throw: FxArity()
        private: @: selected FxKernel\signature(retryOn)
        if: length(selected\inputTypes) != 2
            throw: FxArity()
        private: @: failures FxFailures\union(shape\throws; selected\throws)
        if: delay != 0
            private: @: delayShape FxKernel\signature(delay)
            if: length(delayShape\inputTypes) != 1
                throw: FxArity()
            failures := FxFailures\union(failures; delayShape\throws)
        private: @: contract FxSignatures\make((); shape\resultType)
        private: @: state (copy(FxRetryValueState))
        state\operation := operation
        state\retryOn := retryOn
        state\limit := limit
        state\delay := delay
        state\arguments := arguments
        return: FxWrap\make(contract; FxRetryValueEngine\run; state; failures)
