# Slice 286 probe: a fn whose formal has another name, admitted into a callable place by position (the same signature),
# then the place called with a named actual of the declared name: the contract of the call actually selected (Codex, 285
# norm answers item 3) has no input of that name -- the implicit `call`.  Entry 7.
fn: g (int: y) int
    return: y
end: g
Places:
    fn: f (int: x) int
        return: x
    end: f
end: Places
int: Hw 0
fn: write_free () int
    @: Places\f Hw
    ---
        int: r Places\f(x: 5)
        return: r
        catch: call ()
            return: 22
        catch: implements ()
            return: 24
        catch: interpreter ()
            return: 23
    ---
end: write_free
fn: run () int
    @: Hw g g
    return: write_free()
end: run
int: code 7
int: got run()
if: got != 22
    code: got
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
