fn: lm_compiler_emit_catalog_cells (const: (@: catalog c.L2D105Catalog); const: (@: frame char); const: (@: ind char); const: (@: failure char)) int
    @@: out_cell c.FILE (cast: (@@: c.FILE) (@ c.l2_out))
