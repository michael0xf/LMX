            step\host_ns: ni
            step\host_res: res
            step\view_model: view_model
            step\model_step: contract_from
            if: value != 0 && value\kind = 1
                elem: value\operand
                if: elem != 0
                    step\elem_model: c.lm_compiler_contract_model(elem, 0)
                if: c.lm_compiler_contract_element_ty(elem, (cast: (@: int) (@ step\elem_ty))) != 0
                    return: (cast: (int) (c.lm_compiler_path_fail(out, k + 1, 6)))
                value: elem
                indirect: 0
            else:
                if: value_ft < 0 || c.lm_compiler_colon_is_graph_ty(value_ft) != 0
                    return: (cast: (int) (c.lm_compiler_path_fail(out, k + 1, 5)))
                step\address_ft: value_ft
                step\elem_ty: c.lm_compiler_indirect_type(value_ft)
                if: step\elem_ty < 0
                    step\address_ft: -1
                    return: (cast: (int) (c.lm_compiler_path_fail(out, k + 1, 5)))
                if: c.lm_compiler_type_parts(c.lm_compiler_formal_raw(value_ft), @ address_word, @ address_depth, @ address_qualified) != 0
                    return: (cast: (int) (c.lm_compiler_path_fail(out, k + 1, 6)))
                step\cell_const: (cast: (int) (address_qualified != 0 && address_depth <= 1))
                indirect: indirect + 1
                if: value != 0
                    step\elem_model: c.lm_compiler_contract_model_depth(value, 0, indirect)
