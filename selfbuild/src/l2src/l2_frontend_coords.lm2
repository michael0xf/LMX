end: lm_compiler_ab_find

fn: lm_compiler_rb_own_of (const: (@: stmt c.LmP0Node)) int
    @: rb_n_cell int (cast: (@: int) (@ c.l2_rb_n))
    @@@: rb_at_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_rb_at))
    @@: rb_own_cell int (cast: (@@: int) (@ c.l2_rb_own))
    int: i 0
