Meter:
    int: calls 0
    return: int
    next:
        node\calls += 1
        return: node\calls

PreparedOps:
    @: left int
    []: @(int) right
    const: int: PASS_ARGS_AS_IS 0
    const: int: PRIORITY sys\priority("+")
    return: int
    twice:
        return: \left + \left

RawOps:
    @: left
    []: @ right
    const: int: PASS_ARGS_AS_IS 1
    const: int: PRIORITY sys\priority("+")
    return: int
    twice:
        int: first sys\eval(left)
        int: second sys\eval(left)
        return: first + second

Evaluation:
    return: int
    prepared:
        import: PreparedOps
        return: (Meter\next() twice 0)
    raw:
        import: RawOps
        return: (Meter\next() twice 0)
