# Fixed six-hex-digit field of our immutable data representation.
fn: uc_hex6 (@: data char; size_t: first) unsigned
    unsigned: value 0U
    unsigned: byte 0U
    size_t: at 0U
    while: at < 6U
        byte: (cast: (unsigned) data[first + at]) & 255U
        if: byte <= 57U
            byte: byte - 48U
        else:
            byte: byte - 55U
        ---
        value: 16U * value + byte
        at: at + 1U
    ---
    return: value
end: uc_hex6

fn: uc_in_ranges (unsigned: point; @: records char; size_t: count) int
    size_t: at 0U
    unsigned: low 0U
    unsigned: high 0U
    while: at < count
        low: uc_hex6(records, 12U * at)
        if: point < low
            return: 0
        high: uc_hex6(records, 12U * at + 6U)
        if: point <= high
            return: 1
        at: at + 1U
    ---
    return: 0
end: uc_in_ranges

fn: uc_cased (unsigned: point) int
    return: uc_in_ranges(point, "", 159U)
end: uc_cased

fn: uc_ignorable (unsigned: point) int
    return: uc_in_ranges(point, "", 452U)
end: uc_ignorable

# Fixed19 bytes: lo6,hi6,stride1,mappedLo6. The output offset is point-lo,
# NOT (point-lo)/stride; stride only tells which inputs belong to the record.
fn: uc_simple_lower (unsigned: point) unsigned
    @: records char ""
    size_t: at 0U
    unsigned: low 0U
    unsigned: high 0U
    unsigned: step 0U
    while: at < 187U
        low: uc_hex6(records, 19U * at)
        if: point < low
            return: point
        high: uc_hex6(records, 19U * at + 6U)
        if: point <= high
            step: ((cast: (unsigned) records[19U * at + 12U]) & 255U) - 48U
            if: (point - low) % step = 0U
                return: uc_hex6(records, 19U * at + 13U) + point - low
            return: point
        ---
        at: at + 1U
    ---
    return: point
end: uc_simple_lower

# 1 final sigma,0 ordinary sigma,-1 invalid input. Inspect ORIGINAL text.
# Case_Ignorable has priority over Cased when both properties apply.
fn: uc_final_sigma (@: data char; size_t: count; size_t: first; size_t: after) int
    size_t: pos first
    size_t: before 0U
    size_t: width 0U
    unsigned: point 0U
    unsigned: byte 0U
    int: preceding_cased 0
    while: pos > 0U
        before: pos - 1U
        while: before > 0U
            byte: (cast: (unsigned) data[before]) & 255U
            if: (byte & 192U) != 128U
                break
            before: before - 1U
        ---
        width: dt_point(data, count, before, @ point)
        if: width = 0U || before + width != pos
            return: -1
        pos: before
        if: uc_ignorable(point) != 0
            continue
        preceding_cased: uc_cased(point)
        break
    ---
    if: preceding_cased = 0
        return: 0
    pos: after
    while: pos < count
        width: dt_point(data, count, pos, @ point)
        if: width = 0U
            return: -1
        pos: pos + width
        if: uc_ignorable(point) != 0
            continue
        if: uc_cased(point) != 0
            return: 0
        break
    ---
    return: 1
end: uc_final_sigma

# 1 output point,0 EOF,-1 invalid. Pending0130 expansion is emitted even
# after original input EOF; it does not move the original context position.
fn: uc_lower_next (@: data char; size_t: count; @: position size_t; @: pending unsigned; @: out unsigned) int
    size_t: first position[0]
    size_t: width 0U
    unsigned: point 0U
    int: final_sigma 0
    if: pending[0] != 0U
        out[0]: pending[0]
        pending[0]: 0U
        return: 1
    if: first >= count
        return: 0
    width: dt_point(data, count, first, @ point)
    if: width = 0U
        return: -1
    position[0]: first + width
    if: point = 304U
        out[0]: 105U
        pending[0]: 775U
        return: 1
    if: point = 931U
        final_sigma: uc_final_sigma(data, count, first, first + width)
        if: final_sigma < 0
            return: -1
        out[0]: 963U
        if: final_sigma != 0
            out[0]: 962U
        return: 1
    ---
    out[0]: uc_simple_lower(point)
    return: 1
end: uc_lower_next

# 1 lower-equal,0 different,-1 invalid. No allocation, locale, casefold or
# normalization. Different original byte lengths do not imply inequality.
fn: uc_lower_equal (@: left char; size_t: left_count; @: right char; size_t: right_count) int
    size_t: at 0U
    size_t: lp 0U
    size_t: rp 0U
    unsigned: a 0U
    unsigned: b 0U
    unsigned: lqueue 0U
    unsigned: rqueue 0U
    int: ascii 1
    int: lstatus 0
    int: rstatus 0
    if: left = 0 || right = 0
        return: -1
    if: left_count = right_count && c.memcmp(left, right, left_count) = 0
        return: 1
    while: at < left_count
        if: ((cast: (unsigned) left[at]) & 255U) >= 128U
            ascii: 0
            break
        at: at + 1U
    ---
    at: 0U
    while: at < right_count && ascii != 0
        if: ((cast: (unsigned) right[at]) & 255U) >= 128U
            ascii: 0
            break
        at: at + 1U
    ---
    if: ascii != 0
        if: left_count != right_count
            return: 0
        at: 0U
        while: at < left_count
            a: (cast: (unsigned) left[at]) & 255U
            b: (cast: (unsigned) right[at]) & 255U
            if: a >= 65U && a <= 90U
                a: a + 32U
            if: b >= 65U && b <= 90U
                b: b + 32U
            if: a != b
                return: 0
            at: at + 1U
        ---
        return: 1
    ---
    while: 1
        lstatus: uc_lower_next(left, left_count, @ lp, @ lqueue, @ a)
        rstatus: uc_lower_next(right, right_count, @ rp, @ rqueue, @ b)
        if: lstatus < 0 || rstatus < 0
            return: -1
        if: lstatus = 0 || rstatus = 0
            return: (cast: (int) (lstatus = 0 && rstatus = 0))
        if: a != b
            return: 0
    ---
end: uc_lower_equal
