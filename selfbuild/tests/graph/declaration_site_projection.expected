sub: main () (
    D:
        int: seen 0
        int: pad 99
        int: x 10
    end: D
    Code:
        :=: seen x
        int: x 2
        int: x 3
    end: Code
    Inline:
        int: pad 90
        int: x 1
        int: seen 0
        if: 1 ((int x 7))
        :=: seen x
    end: Inline
)
    call: D Code
    call: Inline
end: main
main:
int: seen 10
int: x 3
int: pad 99
int: inline_seen 7
int: inline_x 7
int: inline_pad 90
