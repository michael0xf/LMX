# A supplied actual reaches its input of a structural launch when `return` stands before that input in the data: the
# field return takes no number among the inputs (the book #fn-signature), and the frame reads the supplied Value by the
# number the formals of the data give the input (step 21.7 K2, the seam).
(
    Observed:
        int: seen 0
)
sub: main () (
    D:
        return: int
        int: seen 0
        int: x 0
    end: D
    Change:
        data\seen := x
    end: Change
    int: result 0
)
    call(args := (int: x 7); data := D; code := Change)
    data\result := D\seen
main()
int: result main\data\result

sub: observe ()
    @: shared node[0]
    shared\Observed\seen := result
observe()
