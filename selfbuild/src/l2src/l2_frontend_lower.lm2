            # slots, the fields the later operands added, the body fields; a pair writes a later
            # operand's field INTO a model slot (the author's merge rule, plan §4).
            mnp: 0
            mq: 0
            while: mq < msrc_n_cell[0]
                if: msrc_res_cell[0][mq] = sl && msrc_pair_cell[0][mq] != 0 && c.fprintf(out_cell[0], "%sl2_mpp[%dU]: @ l2_mpv[%dU]\n%sl2_mpp[%dU]\\model_slot: %dU\n%sl2_mpp[%dU]\\operand: %dU\n%sl2_mpp[%dU]\\field: %dU\n", ind, mnp, mnp, ind, mnp, msrc_slot_cell[0][mq], ind, mnp, msrc_op_cell[0][mq], ind, mnp, msrc_fld_cell[0][mq]) < 0
                    return: (cast: (int) (1))
                if: msrc_res_cell[0][mq] = sl && msrc_pair_cell[0][mq] != 0
                    mnp: mnp + 1
                mq: mq + 1
            ---
            # §7b: merge copies graph state (the walk's PRIM) -- what is marked is published before it.
            if: c.lm_compiler_emit_publish(ind) != 0
                return: (cast: (int) (1))
