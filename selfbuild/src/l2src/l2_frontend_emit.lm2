    # in it records its edges -- of the throw closure and of D-105 -- and meets the static rule of §14.
    if: n != 0 && lm_compiler_check_fields((cast: (@: c.LmP0Field) (body\first_field)), n, mi, path, at) != 0
        return: (cast: (int) (1))
    if: n != 0 && c.lm_compiler_d105_note_return(mi, (cast: (@: c.LmP0Field) (body\first_field)), n, at) != 0
        return: (cast: (int) (1))
    return: (cast: (int) (0))
