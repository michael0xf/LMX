---
    Observed:
        int: self_value 5
        int: given_value 11
        int: kept_value 3
    end: Observed
---
sub: main () (
    Table:
        Code: (:= (data \ x) ((data \ x) + 1))
        Self:
            int: x 1
            :=: (data \ x) ((data \ x) + 2)
        end: Self
        Data:
            int: x 10
        end: Data
        Kept[x]:
            int: value 3
        end: Kept[x]
    end: Table
)
    Table\Self()
    Table\Self()
    Table\Code((Table \ Data))
end: main
main:
int: self_value ((((main \ data) \ Table) \ Self) \ x)
int: given_value ((((main \ data) \ Table) \ Data) \ x)
int: kept_value ((((main \ data) \ Table) [] 3) \ value)
sub: observe ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ self_value) self_value
    :=: ((shared \ Observed) \ given_value) given_value
    :=: ((shared \ Observed) \ kept_value) kept_value
end: observe
observe:
