predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_call.h.lm1"
predef: "l2src/lmx_walk.h.lm1"

# Graph interpreter entry: recognise a callable, then lmx_walk_run.
# Never METHOD.addr. Work only in dev/l2src_sandbox.

define: LMX_INTERP_OK 0
define: LMX_INTERP_INVALID 1
define: LMX_INTERP_NO_GRAPH 2
define: LMX_INTERP_RETURN 3
# Walk LMX_WALK_NOT_CALLABLE (descriptor-only / ready but unwalkable).
define: LMX_INTERP_NOT_CALLABLE 4

define: LMX_OP_RETURN 1
define: LMX_OP_CALL 2

prototype:
    fn: lmx_interp_callable (@: LmxArena arena; @: Lmx node) int
    fn: lmx_interp_method (@: LmxArena arena; @: Lmx node) @: LmxMethod
    fn: lmx_interp_run (@: LmxWalkContext context; @: Lmx node) int
    fn: lmx_interp_apply (@: LmxWalkContext context; @: Lmx node; @@: void args; size_t: nargs) int
end: prototype
