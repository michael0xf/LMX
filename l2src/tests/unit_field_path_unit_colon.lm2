Model:
    size_t: value 1U
end: Model

# FABLE-SONNET-UNIT-LEVEL-ROOTS-20260923-117: \field write and read on a
# unit-level colon declaration (-113's own-field root category, now also
# exercised at unit level -- the same l2_own_add(e, ...)/l2_own_find(e, ...)
# machinery method bodies already used, since E is an ordinary method row).
Model: fresh
fresh\value: 99U
size_t: got
got: fresh\value
if: got != 99U
    sendMessage: exit(exit_code: 91; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
