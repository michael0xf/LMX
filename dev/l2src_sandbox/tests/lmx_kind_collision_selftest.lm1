predef: "l2src/lmx_list_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_thread.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# ONE NUMBER SPACE FOR CLASSIFICATION (FABLE-OPUS-KERNEL-KIND-COLLISION-20260922-101).
# lmx_range_classify answers LmxKind (lmx.h.lm1) and the domain kinds (lmx_implements.h.lm1)
# as plain ints, so no two of them may share a value.  LMX_KIND_LIST was once 7, the value of
# LMX_DOMAIN_KIND_MSG_RECORD: a Thread record then classified as a List, the List operations
# accepted it, and graph copy took the List branch for it and reported the refusal as NOMEM.
# This file pins the three consequences of the rule, not a particular number.

sub: kind_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: kind_check

fn: main () int
    LmxArena: arena
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    @: void thread
    @: void list
    @: Lmx holder
    @: Lmx copy 0
    @: void p0
    int: status
    int: failures
    if: counts = 0
        return: 2
    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        free(counts)
        return: 2
    # A Thread record exactly as lmx_root / lmx_child allocate one.
    thread: lmx_arena_take(@ arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD)
    list: lmx_list_new_owned(c.LMX_TYPE_ARRAY_OF_POINTER_BASE + c.LMX_DOMAIN_THREAD, @ arena)
    p0: lmx_int_new_owned(@ arena)
    kind_check(counts, thread != 0 && list != 0 && p0 != 0, "a Thread record, a Thread List and a cell are allocated")
    kind_check(counts, c.LMX_KIND_LIST != c.LMX_DOMAIN_KIND_MSG_RECORD, "LMX_KIND_LIST and LMX_DOMAIN_KIND_MSG_RECORD are distinct values")
    kind_check(counts, lmx_range_classify(@ arena, thread) = c.LMX_DOMAIN_KIND_MSG_RECORD && lmx_range_type_of(@ arena, thread) = c.LMX_DOMAIN_THREAD, "a Thread record classifies as a Message record of Thread type")
    kind_check(counts, lmx_range_classify(@ arena, thread) != c.LMX_KIND_LIST, "a Thread record does not classify as a List")
    kind_check(counts, lmx_range_classify(@ arena, list) = c.LMX_KIND_LIST && lmx_range_classify(@ arena, list) != c.LMX_DOMAIN_KIND_MSG_RECORD, "a List classifies as a List and not as a Message record")
    # The List operations are asked with a Thread record in the List's place: refused, and the
    # record is not written.
    status: lmx_list_append_owned(thread, p0, @ arena)
    kind_check(counts, status != c.LMX_LIST_OK, "lmx_list_append_owned refuses a Thread record")
    kind_check(counts, lmx_list_append_owned(list, thread, @ arena) = c.LMX_LIST_OK && lmx_list_len(list) = 1U, "the real List accepts the Thread reference")
    # Graph copy reaching a Thread record answers the copier's existing precise status for a
    # value that is not a graph value (INVALID), not the List branch's allocation refusal.
    holder: lmx_node_new_owned(@ arena)
    kind_check(counts, holder != 0 && lmx_arena_refs_open_owned(@ arena, holder, 1U) = 0 && lmx_arena_ref_store(holder, 0U, thread) = 0, "a Structure holds the Thread record in a slot")
    status: lmx_graph_copy_owned(holder, 0, @ arena, @ arena, @ copy)
    kind_check(counts, status = c.LMX_GRAPH_COPY_INVALID && copy = 0, "graph copy of a Thread record reference is INVALID, not NOMEM")
    failures: counts[1]
    c.printf("lmx_kind_collision_selftest checks=%d failures=%d\n", counts[0], failures)
    free(counts)
    lmx_arena_release(@ arena)
    if: failures != 0
        return: 1
return: 0
