# The first check accepts raw int-reference data without executing it.
# The second wrapper requires a Structure reference and refuses the int s.
int: before 0
int: after 0
int: calls 0
fn: touch () int
    node\calls := node\calls + 1
    return: 0
@: Bad (@: p int data[touch()]; int: s 99)
sub: main () (
    int: i 3
    A(int: v 7)
    sub: Types () ()
        @: p int @i
        @: s A
)
    node\before := 1
    call(Bad; Types\data)
    node\after := 1
main()
