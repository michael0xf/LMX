+# Every nested edge carries its giving contract through the SAME field
+# producer. A pointer's current/default value is never used as its Model.
+fn: lmx_implements_source_child (@: LmxArena arena; @: Lmx source; @: LmxImplEntry bridge; size_t: index; int: last; @: Lmx references; @@: Lmx out) int
+    size_t: field
+    int: answer
+    LmxImplContractFact: fact
+    if: out = 0
+        return: c.LMX_IMPLEMENTS_UNKNOWN
+    \out: 0
+    if: source = 0 || bridge = 0 || bridge\value = 0
+        return: c.LMX_IMPLEMENTS_YES
+    if: last = 0
+        answer: lmx_implements_at(arena, bridge, index, @ field)
+    else:
+        answer: lmx_implements_at_last(arena, bridge, index, @ field)
+    if: answer != 0
+        return: c.LMX_IMPLEMENTS_UNKNOWN
+    if: field = (cast: (size_t) -1)
+        return: c.LMX_IMPLEMENTS_YES
+    answer: lmx_implements_contract_field(arena, source, field, 1, references, @ fact)
+    if: answer != c.LMX_IMPLEMENTS_YES
+        return: answer
+    if: fact.kind = c.LMX_KIND_STRUCT || fact.kind = c.LMX_KIND_ARRAY
+        \out: (cast: (@: Lmx) fact.cell)
+    if: fact.kind = c.LMX_KIND_PRIMITIVE && fact.type >= c.LMX_TYPE_POINTER_BASE && fact.type < c.LMX_TYPE_ARRAY_OF_POINTER_BASE
+        \out: fact.reference
+return: c.LMX_IMPLEMENTS_YES
