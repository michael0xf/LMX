sub: main () (
    A(int: value 1)
    B(int: value 7)
    C(int: value 9; int: extra 2)
    Grid(A; A; A; A; A; A; A; A; A; A; A; A)
    int: j 41
    @: p int @j
    int: i 0
    int: sum 0
    int: last 0
    int: count 0
)
    while: i < 12
        Grid[i] := B
        i := i + 1
    i := 0
    while: i < 12
        Grid[i] := @j
        p := Grid[i]
        sum := sum + \p
        i := i + 1
    Grid[11] := C
    last := length(Grid[11])
    count := length(Grid)
main()
int: sum main\data\sum
int: last main\data\last
int: count main\data\count
