            if: call_plan\shape = 5
                return: (cast: (int) (c.lm_compiler_error(path, (cast: (const: @: c.LmP0Node) ((call_plan\extra\value))), "call takes a code and one data operand: the data operand is incomplete")))
            return: (cast: (int) (c.lm_compiler_error(path, stmt, "call needs a code Structure")))
        if: c.lm_compiler_check_struct_call(stmt, @ call_plan, mi, path) != 0
            return: (cast: (int) (1))
        if: call_plan\shape = 1
            return: (cast: (int) (c.lm_compiler_check_call_data(stmt, @ call_plan, mi, path)))
