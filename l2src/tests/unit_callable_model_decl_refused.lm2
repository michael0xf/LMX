# REVIEW 9256c3b (fable_pc's P47, first form): a callable merge's model that declares a local is refused
# once -- "a callable merge binds a name that is not a formal", at the model's header.  The scan said it,
# and the pass that ran the scan added "unsupported body" at the same place: one cause, two lines.  The
# harness now holds every refusal to at most one "l2trans error:" line.
Model:
    int: other 5
    int: value 0
end: Model

fn: makeCounter (Model: m) fn: (int: x) int
    fn: bump (int: x) int
        int: q m\value
        return: q + x
    return: bump

Model: left
c: makeCounter left
int: a (c: 1)
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
