+FxRemoveAffix:
+    private:
+        char[]: text
+        char[]: affix
+        int: suffix
+    return: char[]
+    remove:
+        throws: copy(FxThrows\sequence)
+        char[]: unitSource text
+        char[]: unitPart affix
+        private: int: begin 0
+        private: int: end length(text)
+        private: int: at 0
