# Slice 309, the vertical slice (b): a place without a value, its first assignment, then a read and a write.
# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: observed 0
)
@: shared data[0]
int: x
x := 5
x := x + 1
int: observed x

sub: main ()
    shared\Observed\observed := observed
main()
