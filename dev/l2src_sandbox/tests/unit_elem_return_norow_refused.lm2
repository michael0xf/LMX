# A value that is only an element takes its type's conversion edge: `return: a[1]` gives a size_t element to an int
# result, and this program has no receiver row.  Before, it was untyped and C converted.
fn: m () int
    []: size_t a 2
    a[1]: 2U
    return: a[1]

sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
