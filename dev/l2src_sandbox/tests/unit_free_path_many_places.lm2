# The name passes through more methods than any table of the translator
# once held, two of them in a cycle. r reads box\v, and nothing in its
# sight declares box. f000 calls r, and each of f001 to f259 calls the one
# before it; ping and pong call one another, counting down, and ping calls
# f259 at zero. None of them has a box: each only hands the name on. has
# gives a reference to Model's Structure through three turns of the cycle
# and the whole chain: 31. wide gives one to Wide's, which has v at
# another position: 41. Entry 7.
Model:
    int: v 4
end: Model

Wide:
    int: pad 1
    int: v 4
end: Wide

fn: r () int
    return: box\v + 1
end: r

fn: f000 () int
    return: r()
end: f000

fn: f001 () int
    return: f000()
end: f001

fn: f002 () int
    return: f001()
end: f002

