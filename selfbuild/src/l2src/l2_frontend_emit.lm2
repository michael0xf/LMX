    if: role = 1
        if: c.lm_compiler_primary_cast_value(value, @ type, 0, @ operand) != 0
            return: (cast: (int) (c.lm_compiler_error(path, (cast: (const: @: c.LmP0Node) (value\node)), "unsupported cast contract")))
        return: (cast: (int) (lm_compiler_check_value_span(@ operand, mi, path, (cast: (const: @: c.LmP0Node) (value\node)))))
    if: role = 2
        if: c.lm_compiler_primary_array_value(value, mi, @ operand) != 0
            return: (cast: (int) (c.lm_compiler_error(path, (cast: (const: @: c.LmP0Node) (value\node)), "length requires one Array value")))
        return: (cast: (int) (lm_compiler_check_value_span(@ operand, mi, path, (cast: (const: @: c.LmP0Node) (value\node)))))
