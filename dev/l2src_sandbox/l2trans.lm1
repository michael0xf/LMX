    oi: l2_own_ref_decl(stmt, l2_rw_mi)
    if: oi >= 0
        l2_own_excl: oi
        k: l2_rw_reference_store(l2_declaration(stmt)\candidate, l2_declaration(stmt)\candidate_count, oi, into, @ node)
        l2_own_excl: -1
        if: k != 0 || l2_rw_bseq_mark(oi) != 0
            return: 1
        \made: 1
        if: l2_rw_put(into, slot, node) != 0
            return: 1
        return: 0
    if: l2_deref_word(h, l2_rw_mi, @ indirect_base, @ indirect_levels, @ indirect_type) = 0
        if: stmt\as\frame\body = 0 || l2_rw_frame(into, "LMX_WALK_OP_PUT", 3, @ node) != 0 || l2_rw_deref_word(h, node, @ t) != 0 || l2_rw_put(node, 1, t) != 0
            return: 1
        if: l2_rw_reference_receive(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), l2_own_ty_of_param(indirect_type), l2_contract_model_depth(l2_binding_contract(l2_rw_mi, @ indirect_base), 0, indirect_levels), node, @ t) != 0 || l2_rw_put(node, 2, t) != 0 || l2_rw_put(into, slot, node) != 0
            return: 1
