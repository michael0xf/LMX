# Standalone written groups are values. Only the explicitly supplied Body
# and consumed numeric/operator expressions execute their fields/operands.
int: calls 0
fn: tick () int
    node\calls := node\calls + 1
    return: 4
sub: quiet () ()
    (tick())
    (tick() + 1)
    (int: phantom 7)
    (missing_a missing_b missing_c)
quiet()
int: quiet_fields length(quiet\data)
(tick())
@: Body (
    int: x 1
    (tick())
    (missing_a missing_b missing_c)
    x := x + 2
)
call(Body)
int: after_body data\calls
+(tick() + 1)
int: after_ast data\calls
int: math tick() + 1
int: after_math data\calls
int: arithmetic 2 + 3 * 4
int: body_x Body\x
