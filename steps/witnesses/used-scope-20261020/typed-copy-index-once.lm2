# Positive7: the same source Model and one copy map apply to an indexed
# source. The source's effectful prefix is evaluated exactly once.
include: "l2src/tests/opaque_declared_views_test.h"
D: (int: v 0; int: w 0)
E: (int: w 0; int: v 0)
SeedD: (int: v 1; int: w 2)
SeedE: (int: w 1; int: v 2)
Counter: (int: calls 0)
fn: opaque () @: void
    return: c.l2_test_opaque_declared()
end: opaque
fn: pick () size_t
    Counter\calls: Counter\calls + 1
    return: 0U
end: pick
fn: check () int
    @: d D SeedD
    @: e E SeedE
    if: d\v != 1 || e\v != 2
        return: 80
    []: (@: E) values 1
    values[0]: opaque()
    copy: merge(values[pick()])
    if: Counter\calls != 1 || copy\v != 9 || copy\w != 7
        return: 81
    copy\v: 41
    @: cell int @copy\v
    \cell: 43
    if: Counter\calls != 1 || copy\v != 43 || copy\w != 7
        return: 82
    if: values[0]\v != 9 || values[0]\w != 7
        return: 83
    return: 7
end: check
sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
