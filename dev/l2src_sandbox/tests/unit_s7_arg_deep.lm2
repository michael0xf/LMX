# take(h\a\p). The leaf is a nested Structure, not Equatable: it has an
# unread extra before its equals. take writes equals through the admitted
# argument; the write is seen in Holder's own leaf and extra keeps its
# value. Entry 7.

Equatable:
    size_t: equals 0U
end: Equatable

Holder:
    a:
        p:
            size_t: extra 5U
            size_t: equals 0U
end: Holder

fn: take (Equatable: slot) size_t
    slot\equals: 9U
return: slot\equals

fn: pass (Holder: h) size_t
return: take(h\a\p)

fn: go () size_t
return: pass(Holder)

size_t: k
k: go()
if: k = 9U && Holder\a\p\equals = 9U && Holder\a\p\extra = 5U
    sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
return
