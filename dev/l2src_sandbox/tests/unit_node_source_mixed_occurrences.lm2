# Structure and primitive fields both retain their own source positions.
hStruct:
    int: p 3
end: hStruct
int: hInt 77
Model:
    int: k 0
    int: last 0
    k: node\hStruct\p
    last: node\hInt
end: Model
Model
int: ok 7
if: Model\k != 3 || Model\last != 77
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
