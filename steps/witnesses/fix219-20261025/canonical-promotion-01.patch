+    # nothing in it runs, so it builds no executable node or site.
+    if: role = 4
+        if: l2_primary_sizeof_value(value, l2_rw_mi, @ operand, 0) != 0
+            return: l2_rw_refuse(value\node, "an operand without a known storage contract")
+        l2_rw_machine: 1
