# Значение private-места передано явным фактическим аргументом — передача разрешена: seen 5.
# Норма: книга, #private-binding, наблюдение B13.
(
    Observed:
        int: seen 0
)
fn: callee (int: v) int
    return: v
fn: f () int
    private: int: x 5
    return: callee(x)
sub: main ()
    @: shared node[0]
    shared\Observed\seen := f()
main()
