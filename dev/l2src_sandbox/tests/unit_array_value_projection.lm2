# Ordinary Array values retain the existing arena descriptor in every receiving
# position. This witness searches the constructed code graph for the
# descriptor; data-field placement is a separate contract. The observer
# checks kind/type/identity before reading the descriptor.
include: "l2src/tests/array_value_observer.h"
int: calls 0
fn: index () size_t
    node\calls: node\calls + 1
return: 1U
fn: pass (@: value c.VoidArray) @: c.VoidArray
return: value
fn: opaque (@: value void) @: void
return: value
fn: formal (@: values c.VoidArray; @: expected c.VoidArray) int
    if: values != expected
        return: 81
return: 7
fn: check () int
    []: int values 3
    values[0]: 17
    values[1]: 23
    @: initialized c.VoidArray values
    if: c.l2_test_array_address(c.l2_program_arena, c.l2_call_code, initialized, c.LMX_TYPE_ARRAY_OF_INT, 3U, @values[0]) = 0
        return: 82
    @: assigned c.VoidArray
    assigned: values
    if: assigned != initialized || pass(values) != initialized || opaque(values) != initialized
        return: 83
    const: @(readonly c.VoidArray values)
    if: readonly != initialized
        return: 84
    if: c.l2_test_array_address(c.l2_program_arena, c.l2_call_code, values, c.LMX_TYPE_ARRAY_OF_INT, 3U, @values[0]) = 0
        return: 85
    if: 1
        []: char letters 4
        letters[0]: 'Q'
        @: inner c.VoidArray letters
        if: inner = initialized || pass(letters) != inner
            return: 86
        if: c.l2_test_array_address(c.l2_program_arena, c.l2_call_code, letters, c.LMX_TYPE_ARRAY_OF_CHAR, 4U, @letters[0]) = 0
            return: 87
        if: length(letters) != 4U || letters[0] != 'Q'
            return: 88
    ---
    if: values != initialized || length(values) != 3U || values[index()] != 23 || node\calls != 1
        return: 89
    if: 1
        int: scalar 31
        if: scalar != 31
            return: 90
    ---
    if: formal(values, initialized) != 7 || values[0] != 17
        return: 91
    []: char empty 0
    @: emptyValue void empty
    if: emptyValue = 0 || pass(empty) != emptyValue
        return: 92
    if: c.l2_test_array_address(c.l2_program_arena, c.l2_call_code, emptyValue, c.LMX_TYPE_ARRAY_OF_CHAR, 0U, 0) = 0
        return: 93
return: 7
fn: result () @: c.VoidArray
    []: int returned 2
    returned[0]: 41
    if: c.l2_test_array_return_mark(c.l2_program_arena, c.l2_call_code, returned, c.LMX_TYPE_ARRAY_OF_INT, 2U, @returned[0]) = 0
        return: 0
return: returned

[]: int values 5
values[0]: 47
if: c.l2_test_array_address(c.l2_program_arena, c.self, values, c.LMX_TYPE_ARRAY_OF_INT, 5U, @values[0]) = 0
    sendMessage: exit(exit_code: 94; stdout: ""; stderr: "")
    return
int: checked check()
if: checked != 7
    sendMessage: exit(exit_code: checked; stdout: ""; stderr: "")
    return
if: c.l2_test_array_return_check(result()) = 0
    sendMessage: exit(exit_code: 96; stdout: ""; stderr: "")
    return
if: c.l2_test_array_address_count(6) = 0
    sendMessage: exit(exit_code: 97; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
