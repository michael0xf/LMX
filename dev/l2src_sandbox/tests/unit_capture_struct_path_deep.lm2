# A path through a captured Structure past its first field: `loc\box\c` reads
# the nested Structure's field through the same path resolver as any other
# path (the author, 2026-10-17: all paths through one general algorithm; no
# capture-specific depth). 5 + 2 = 7; 81 is the program's own refusal.
Inner:
    int: c 5
end: Inner

Model:
    int: other 5
    box: Inner
    int: count 0
    int: value 0
end: Model

fn: makeReader (int: n) fn: (int: x) int
    loc: merge: Model
    loc\value: n
    fn: read (int: x) int
        return: loc\box\c + x
    return: read

@: r40 makeReader(40)
int: a (r40: 2)
int: ok 7
if: a != 7
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
