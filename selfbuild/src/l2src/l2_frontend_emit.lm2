                        return: (cast: (int) (1))
                    ---
                ---
            ---
            if: handled = 0 && actual_span = 1 && a0\value != 0 && a0\value\kind = c.LM_P0_NODE_ATOM && nst >= 0 && m_node_cell[0][idx] != 0 && m_node_cell[0][idx]\as != 0
                if: c.lm_compiler_admit_consumer_uses((cast: (const: @: c.LmP0Text) (a0\value\as\atom)), nst, idx, actual_i, path, source_node, "function argument") != 0
                    return: (cast: (int) (1))
