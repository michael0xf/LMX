# A merge body retains its source-order statement in the result. Construction
# initializes w to 4; calling the resulting Structure executes its w: 5 step.
Model:
    size_t: x 1U
end: Model

R: merge: Model
    int: w 4
    w: 5
end: merge
int: before R\w
R
int: after R\w
if: before != 4 || after != 5
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: after; stdout: ""; stderr: "")
return
