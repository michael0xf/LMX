# Plan M11 5v: the declarations of ordinary Structures live in the data part of main; the root holds places and the call main().
fn: numeric (int: x; int: y) int
    return: x * 10 + y
fn: a (int: x) int
    return: x + 1
fn: mytest (int: a) int
    return: a + 30
sub: main () (
    Point:
        Inner(int: y 0; int: x 0)
    Candidate:
        Inner(int: y 3)
    Flat:
        int: y 0
    int: arithmetic 0
    int: negative 0
    int: nested 0
    int: through_path 0
)
    fn: take (Point: p; int: q) int
        return: p\Inner\y * 10 + q
    fn: choose (Point: p) int
        return: take(p, (1 + 2))
    fn: access (Flat: value) int
        return: value\y
    arithmetic := take(Candidate, 1 + 2)
    negative := take(Candidate, -2)
    nested := choose(Candidate)
    through_path := access(Candidate\Inner)
main()
int: arithmetic main\data\arithmetic
int: negative main\data\negative
int: boundary numeric(8 - 2; 3 * 4)
int: unary -(2 + 3) * 4
int: nested main\data\nested
int: through_path main\data\through_path
int: call_parentheses mytest(a(5))
int: call_colon mytest(a: 5)
int: candidate_inner_len length(main\data\Candidate\Inner)
