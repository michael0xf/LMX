# := survives construction as an ordinary graph operator. Same stable int cells and working places.
# Plan M11 5v: the declarations of ordinary Structures live in the data part of main; the root holds places and the call main().
# The old Code carried a child block `data:`; the pair is written apart: CodeData holds the places (model_x reads it),
# Code holds the code.
int: root 1
root := 5
root:=int: 7
int: i
@: p int @i
i := 5
int: first \p
i:=7
int: second \p
sub: main () (
    Box:
        int: value 1
        Child(int: item 2)
    CodeData:
        int: x 1
        int: y 2
    Code:
        x := x + 1
        y := x * 2
    Data:
        int: y 30
        int: x 10
    int: changed 0
)
    Box\value := root + 2
    Box\Child\item := 11
    call: Data Code
    changed := change(Box)
fn: tick () int (int: calls 0)
    calls := calls + 1
    return: 3
fn: local (int: arg) int
    x := 7
    int: x
    arg := arg + 1
    x := x + arg
    x := x + tick()
    return: x
int: local_result local(4)
int: calls tick\data\calls
sub: bump (int: delta 2) (int: count 0)
    count := count + delta
bump()
bump: 3
int: procedure_count bump\data\count
fn: change (Box: target) int
    target\value := 17
    return: target\value
main()
int: data_x main\data\Data\x
int: data_y main\data\Data\y
int: model_x main\data\CodeData\x
int: changed main\data\changed
int: nested_value main\data\Box\Child\item
int: box_value main\data\Box\value
fn: clean_path () int (int: x 1)
    data\x := 9
    return: x * 10 + data\x
int: clean_snapshot clean_path()
int: clean_published clean_path\data\x
fn: dirty_path () int (int: x 1)
    x := 2
    data\x := 9
    return: x * 100 + data\x
int: dirty_snapshot dirty_path()
int: dirty_published dirty_path\data\x
int: n 0
for: (n := 0; n < 3; n := n + 1)
    root := root + 1
finally:
    root := root + 10
