# b's actual is the a read in g's body, not the a that names f's formal: g
# has no a and nothing hands it one, and the root calls g. The call that starts
# the chain is refused: the root's g(), column 30 (DORMANT-BODY-FREE-INPUT).
fn: f (int: a; int: b) int
    return: a - b
end: f

fn: g () int
    return: f(a: 1; b: a)
end: g

sendMessage: exit(exit_code: g(); stdout: ""; stderr: "")
return
