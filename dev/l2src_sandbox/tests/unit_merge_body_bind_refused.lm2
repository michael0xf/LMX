# R6-2 (1): the binding `p: Model` in a merge result body is read by the common body construction as a named
# Structure's binding is (K03 NS-ROLES-2) and meets the rule of a body read where a method stands: not built yet, said at
# the target -- the common path's message, not a merge-only one.
Model:
    size_t: x 1U
end: Model

R: merge: Model
    p: Model
end: merge
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
