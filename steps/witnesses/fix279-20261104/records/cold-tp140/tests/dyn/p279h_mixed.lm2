# A written form over a head declared as a number: the occurrence reads as written, the first stays a number.
S:
    int: t 1
    t: (int: x 5)
end: S
int: code 7
if: S\[0]t != 1
    code: 81
---
if: code = 7 && S\[1]t\x != 5
    code: 82
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
