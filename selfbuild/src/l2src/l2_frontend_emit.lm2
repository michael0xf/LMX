        nb: t7_nb_cell[0][s]
        if: base < 0 || nb < 0 || steps > c.INT_MAX - base || nb > c.INT_MAX - base - steps
            return: (cast: (int) (c.lm_compiler_error(src_cell[0], t7_at_cell[0][s], "a callable merge has too many fields")))
