predef: "l2src/lmx_arena.h.lm1"

# Mutable int cells. Same discipline as lmx_size: interned chars share an
# address by value; mutable primitives need their own registered domain.
# Each own int field gets one cell of the arena's array of int primitives at
# construction; assignment stores through that cell (unique backing, stable live
# addresses, no relocation). LMX_TYPE_INT is the existing range type; this is
# not a new user-semantic choice.
#
# There is no module-level pool and no init any more: a process-wide array cannot
# be a Message's array, so the array this unit hands cells out of is the ARENA's
# own -- made by the first request of this kind and type, grown by adding a chunk
# after that, and found again by every later request through the arena's list of
# its N arrays (lmx_arena_take_n).  What this unit needs of another unit is that
# take and nothing else, so that is what it opens.

# One cell of the arena's array of int primitives, zeroed.  Nothing is consulted
# but the arena: the array answers for itself, and a request from any module of
# this arena lands in the SAME array -- the cells are intervals of one array, not
# arrays of their own.

# All mutable-int cell APIs now live in lmx_value_owned.lm1
# (lmx_int_new_owned / lmx_int_value_known / lmx_int_store_known).
# The prior lmx_int_take/value/store shims had zero callers and were removed.
