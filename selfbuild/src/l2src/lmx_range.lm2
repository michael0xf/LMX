# The arena's index of its arrays. Lingvamyxa_spec.txt 2, 6.5, 12.1.
#
# A field carries no type tag. `data` is a pointer, and its type is whichever array of
# the arena contains it: the index maps an address to the DESCRIPTOR of that array -- one
# entry per INTERVAL, not per array (an array that grew by a chunk has several intervals,
# and every one of them names the same descriptor; Mikhail, 2026-09-17, verbatim: "У тебя
# есть N массивов в арене.  Как
# ты можешь его отсортировать если у каждого массива адрес фиксирован?!!!! Ты должен
# сделать _таблицу адрес->дескриптор массива_ и после вставку в таблицу делает менеджер
# арены (в том числе когда он присоединяет другую арену)").  The arrays never move, so
# it is the ENTRIES that are ordered and bisected, never the arrays.
#
# The index lives INSIDE the arena: range metadata belongs to the Message that arena
# belongs to (6.5), not to a module.  In this kernel the arena is not yet owned by a
# Message, but it is already an object of its own.
#
# Ordinary typed writes go straight to their stable cell address. Qualified immutable
# writes are different: their generated barrier consults this address index to refuse
# a write span overlapping a sealed profile, including an interior-byte alias. This
# adds no runtime name lookup, per-value tag, or movable cell.
#
# The table GROWS instead of refusing: as many ranges (types) as needed may be created
# (verbatim: "вы можете этих диапазонов (типов) заводить сколько вам угодно"), so a full
# table is not an error and no fixed cap exists.  Nothing holds a pointer into the table
# across calls -- every access is `lmx_arena_index_data(arena) + index` -- so the entries may move; the
# ARRAYS they name never do.
#
# A machine module (L2 section 20): each function has a direct C-compatible entry, and the kernel's code calls it with
# its explicit arguments. The records it reads and writes (LmxArena, LmxRange, LmxPool, LmxChunk) and the prototypes
# the kernel calls through are in the kernel's headers lmx.h.lm1 and lmx_arena.h.lm1, which L3 code of the recipe
# writes as L1 text (decls_write_all, tools/l2/build.lm2); the accessors of the arena's index and of a chunk are the
# kernel's C functions, called through the C door.
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_pool.h.lm1"
predef: "l2src/lmx_source_names.h.lm1"
include: "<stdlib.h>" "<stddef.h>" "<limits.h>"

# Draft additions for the existing range module, not a new maintained module.
# Full physical types use the existing LmxPool.type int. Zero remains NONE.
# Positive identifiers retain their current mutable base identities. Their
# negative counterparts denote distinct immutable storage types, not a flag
# attached after validation. INT_MIN is not a valid type (negation would overflow).
# The containing range module will include <limits.h> before integration.

fn: lmx_type_base (int: physical_type) int
    if: physical_type = c.INT_MIN
        return: c.LMX_TYPE_NONE
    if: physical_type < 0
        return: 0 - physical_type
    return: physical_type
end: lmx_type_base

# A primitive reference cell keeps its actual logical type. Graph and Array
# nodes have a different kind; their type numbers also name boxed references.
fn: lmx_type_reference_cell (int: physical_type) int
    int: base_type lmx_type_base(physical_type)
    return: base_type = c.LMX_TYPE_LMX || base_type = c.LMX_TYPE_DESC || base_type = c.LMX_TYPE_CHAR_PTR || (base_type >= c.LMX_TYPE_POINTER_BASE && base_type < c.LMX_TYPE_ARRAY_OF_POINTER_BASE)
end: lmx_type_reference_cell

fn: lmx_type_immutable (int: physical_type) int
    if: physical_type = c.INT_MIN || physical_type = c.LMX_TYPE_NONE
        return: c.LMX_TYPE_NONE
    if: physical_type < 0
        return: physical_type
    return: 0 - physical_type
end: lmx_type_immutable

fn: lmx_type_is_immutable (int: physical_type) int
    return: physical_type < 0 && physical_type != c.INT_MIN
end: lmx_type_is_immutable

# Exact storage family of the receiving physical owner, never its lexical
# parent, allocation profile or a validation/sealed mark.
fn: lmx_type_storage_like (int: owner_type; int: element_type) int
    int: base_type lmx_type_base(element_type)
    if: owner_type = c.INT_MIN || owner_type = c.LMX_TYPE_NONE || base_type = c.LMX_TYPE_NONE
        return: c.LMX_TYPE_NONE
    if: lmx_type_is_immutable(owner_type) != 0
        return: lmx_type_immutable(base_type)
    return: base_type
end: lmx_type_storage_like

# Complete descriptor -> element storage type, preserving the physical family.
# This is representation metadata, not Consumer admission or a type erasure.
fn: lmx_type_element (int: array_type) int
    int: base_type lmx_type_base(array_type)
    int: element_type c.LMX_TYPE_NONE
    if: base_type = c.LMX_TYPE_ARRAY_OF_CHAR
        element_type: c.LMX_TYPE_CHAR
    if: base_type = c.LMX_TYPE_ARRAY_OF_UNSIGNED_CHAR
        element_type: c.LMX_TYPE_UNSIGNED_CHAR
    if: base_type = c.LMX_TYPE_ARRAY_OF_INT
        element_type: c.LMX_TYPE_INT
    if: base_type = c.LMX_TYPE_ARRAY_OF_SIZE_T
        element_type: c.LMX_TYPE_SIZE_T
    if: base_type = c.LMX_TYPE_ARRAY_OF_ULONG
        element_type: c.LMX_TYPE_ULONG
    if: base_type = c.LMX_TYPE_ARRAY_OF_LMX
        element_type: c.LMX_TYPE_LMX
    if: base_type = c.LMX_TYPE_ARRAY_OF_DESC
        element_type: c.LMX_TYPE_DESC
    if: base_type >= c.LMX_TYPE_ARRAY_OF_POINTER_BASE
        element_type: c.LMX_TYPE_POINTER_BASE + (base_type - c.LMX_TYPE_ARRAY_OF_POINTER_BASE)
        if: element_type >= c.LMX_TYPE_ARRAY_OF_POINTER_BASE
            return: c.LMX_TYPE_NONE
        ---
    ---
    return: lmx_type_storage_like(array_type, element_type)
end: lmx_type_element

# Common executable exact-cell barrier. The full physical type is authority
# before any profile seal. Keep legacy profile evidence for old constructors
# without changing its separate retention/lifetime query contracts.
fn: lmx_range_write_exact_blocked (@: arena c.LmxArena; @: p void; @: exact_profile c.Lmx; @@: roots c.Lmx; size_t: root_count) int
    if: lmx_type_is_immutable(lmx_range_type_of(arena, p)) != 0
        return: 1
    if: lmx_range_sealed_profile(arena, p) != 0
        return: 1
    if: exact_profile != 0 && lmx_range_profile(arena, p) = exact_profile
        return: 1
    return: lmx_range_has_root_profile(arena, p, roots, root_count)
end: lmx_range_write_exact_blocked

fn: lmx_range_reserve (@: arena c.LmxArena; size_t: need) int
    size_t: capacity 0U
    @: grown c.LmxRange 0
    if: arena = 0
        return: 1
    if: need <= c.lmx_arena_index_cap(arena)
        return: 0
    # Letter-scale: index stays, but does not grow without bound (Mikhail 19.09).
    if: arena\simple != 0U && need > 32U
        return: 1
    ---
    capacity: c.lmx_arena_index_cap(arena)
    if: capacity = 0U
        capacity: 16U
    ---
    while: capacity < need
        if: capacity > ((cast: (size_t) -1) / 2U)
            return: 1
        ---
        capacity: capacity * 2U
        if: arena\simple != 0U && capacity > 32U
            capacity: 32U
            if: capacity < need
                return: 1
            ---
            break
        ---
    ---
    if: capacity > ((cast: (size_t) -1) / c.sizeof(c.LmxRange))
        return: 1
    grown: (cast: (@: LmxRange) c.realloc((cast: (@: void) c.lmx_arena_index_data(arena)), capacity * c.sizeof(c.LmxRange)))
    if: grown = 0
        return: 1
    ---
    c.lmx_arena_index_set_data(arena, grown)
    c.lmx_arena_index_set_cap(arena, capacity)
    return: 0
end: lmx_range_reserve

# One interval of one array joins the index.  This IS the insertion into the table, and
# only the arena's manager performs it (lmx_arena_span is the only caller).
fn: lmx_range_add (@: arena c.LmxArena; @: array c.LmxPool; @: lo void; @: hi void) int
    return: lmx_range_add_view(arena, arena, array, lo, hi)
end: lmx_range_add

fn: lmx_range_add_view (@: arena c.LmxArena; @: owner c.LmxArena; @: array c.LmxPool; @: lo void; @: hi void) int
    @: entry c.LmxRange 0
    @: slot c.LmxRange 0
    size_t: at 0U
    size_t: index 0U
    size_t: low 0U
    size_t: high 0U
    size_t: mid 0U
    if: arena = 0 || owner = 0
        return: 1
    if: array = 0
        return: 1
    if: array\stride = 0U
        return: 1
    # A live arena imports only immutable foreign rows. A disposable
    # classification-only source view may inspect mutable foreign rows, but
    # it cannot allocate or be attached to a live Message arena.
    if: owner != arena && array\sealed = 0U && arena\source_view = 0U
        return: 1
    if: lo = 0
        return: 1
    if: hi <= lo
        return: 1
    # The entry names ONE array and its interval; stride, kind and type are the array's
    # and stay there.  The table is kept SORTED by base address, because the lookups
    # find an entry by BISECTION, not by walking it (verbatim: "надеюсь не простым
    # перебором а нормальным бинарным"), and the position for a new interval is found
    # the same way.  A registration walks the tail up one place; lmx_range_drop keeps the
    # order by shifting the tail down, so both operations preserve it.
    high: c.lmx_arena_index_len(arena)
    while: low < high
        mid: low + (high - low) / 2U
        slot: c.lmx_arena_index_data(arena) + mid
        if: lo < slot\lo
            high: mid
        else:
            low: mid + 1U
        ---
    ---
    at: low
    # Re-importing the exact same physical range is a no-op.  Same addresses with a
    # different descriptor or owner would make physical classification ambiguous.
    if: at > 0U
        slot: c.lmx_arena_index_data(arena) + (at - 1U)
        if: slot\lo = lo && slot\hi = hi
            if: slot\array = array && slot\owner = owner
                return: 0
            ---
            return: 1
        ---
    ---
    # An address falls in exactly ONE array of the arena (6.5), so two arrays may not
    # share a cell.  Touching intervals are fine (half-open); overlapping ones would make
    # both the lookup and the retirement ambiguous, and they are refused here rather than
    # registered twice.  The neighbours are exactly the two entries the bisection landed
    # between.
    if: at > 0U
        slot: c.lmx_arena_index_data(arena) + (at - 1U)
        if: lo < slot\hi
            return: 1
        ---
    ---
    if: at < c.lmx_arena_index_len(arena)
        slot: c.lmx_arena_index_data(arena) + at
        if: hi > slot\lo
            return: 1
        ---
    ---
    # Reserve only after duplicate/overlap validation.  An idempotent import therefore
    # cannot fail merely because growing an index that it does not need would fail.
    if: c.lmx_arena_index_len(arena) = (cast: (size_t) -1) || lmx_range_reserve(arena, c.lmx_arena_index_len(arena) + 1U) != 0
        return: 1
    ---
    index: c.lmx_arena_index_len(arena)
    while: index > at
        entry: c.lmx_arena_index_data(arena) + index
        slot: c.lmx_arena_index_data(arena) + (index - 1U)
        entry\lo: slot\lo
        entry\hi: slot\hi
        entry\array: slot\array
        entry\owner: slot\owner
        entry\chunk: slot\chunk
        entry\chunk_gen: slot\chunk_gen
        entry\links: slot\links
        entry\slot_owner: slot\slot_owner
        entry\holder: slot\holder
        entry\side_cells: slot\side_cells
        entry\side_stride: slot\side_stride
        entry\kind: slot\kind
        index: index - 1U
    ---
    entry: c.lmx_arena_index_data(arena) + at
    entry\lo: lo
    entry\hi: hi
    entry\array: array
    entry\owner: owner
    entry\chunk: 0
    entry\chunk_gen: 0U
    entry\links: 0
    entry\slot_owner: 0
    entry\holder: 0
    entry\side_cells: 0U
    entry\side_stride: 0U
    entry\kind: 0
    # The array's stride and kind, kept here because at drop time the array record may already be freed.
    if: array != 0
        entry\side_stride: (cast: (size_t) array\stride)
        entry\kind: array\kind
    ---
    c.lmx_arena_index_set_len(arena, c.lmx_arena_index_len(arena) + 1U)
    return: 0
end: lmx_range_add_view

# One interval leaves the index.  The caller is the arena's manager, retiring an entry
# with the block that carried it, or an array whose chunk is released.
fn: lmx_range_drop (@: arena c.LmxArena; @: lo void; @: hi void) int
    @: entry c.LmxRange 0
    @: next c.LmxRange 0
    size_t: index 0U
    if: arena = 0 || lo = 0 || hi = 0 || c.lmx_arena_index_data(arena) = 0
        return: 1
    index: 0U
    while: index < c.lmx_arena_index_len(arena)
        entry: c.lmx_arena_index_data(arena) + index
        if: entry\lo = lo && entry\hi = hi
            # Spelling keys/text must retire while this storage is still
            # registered and readable, before its address can be reused.
            c.lmx_source_names_drop(arena, lo, hi)
            # The interval's code links go the same way, while its cells are still readable (design 4.4).
            lmx_range_side_drop(arena, entry)
            while: index + 1U < c.lmx_arena_index_len(arena)
                next: entry + 1
                entry\lo: next\lo
                entry\hi: next\hi
                entry\array: next\array
                entry\owner: next\owner
                entry\chunk: next\chunk
                entry\chunk_gen: next\chunk_gen
                entry\links: next\links
                entry\slot_owner: next\slot_owner
                entry\holder: next\holder
                entry\side_cells: next\side_cells
                entry\side_stride: next\side_stride
                entry\kind: next\kind
                index: index + 1U
                entry: next
            ---
            entry\lo: 0
            entry\hi: 0
            entry\array: 0
            entry\owner: 0
            entry\chunk: 0
            entry\chunk_gen: 0U
            entry\links: 0
            entry\slot_owner: 0
            entry\holder: 0
            entry\side_cells: 0U
            entry\side_stride: 0U
            entry\kind: 0
            c.lmx_arena_index_set_len(arena, c.lmx_arena_index_len(arena) - 1U)
            return: 0
        index: index + 1U
    ---
    return: 1
end: lmx_range_drop

# The whole mechanism: no value tag and no out-of-band store is read.  One sorted index
# contains both local ranges and explicitly imported non-owning views.  The address selects
# the entry; the entry's array gives representation/profile and its owner gives lifetime.

# The one bisection shared by both questions below. It answers only which REGISTERED
# interval contains `p`; it does not yet say that `p` is a language-level cell. The
# allocator needs the interval question for an empty-but-registered chunk, while every
# public typing question needs the stricter live-cell question.
fn: lmx_range_entry_at (@: arena c.LmxArena; @: p void) @: c.LmxRange
    @: entry c.LmxRange 0
    size_t: low 0U
    size_t: high 0U
    size_t: mid 0U
    if: arena = 0 || p = 0 || c.lmx_arena_index_data(arena) = 0
        return: 0
    high: c.lmx_arena_index_len(arena)
    while: low < high
        mid: low + (high - low) / 2U
        entry: c.lmx_arena_index_data(arena) + mid
        if: p < entry\lo
            high: mid
        else:
            if: p < entry\hi
                return: entry
            ---
            low: mid + 1U
        ---
    ---
    return: 0
end: lmx_range_entry_at

# A registered interval's descriptor, irrespective of how many cells of that chunk have
# been handed out. This is allocator bookkeeping, not value classification: an empty
# first chunk must still be reused by lmx_pool_take_n instead of being mistaken for an
# unregistered chunk.  It answers only for local ownership: an imported view must never
# make the allocator adopt a foreign chunk.
fn: lmx_range_interval_pool (@: arena c.LmxArena; @: p void) @: c.LmxPool
    @: entry c.LmxRange 0
    entry: lmx_range_entry_at(arena, p)
    if: entry = 0 || entry\owner != arena
        return: 0
    return: (cast: (@: LmxPool) entry\array)
end: lmx_range_interval_pool

# Typed pointer reads belong to classification of existing cells. Their one
# implementation is shared by implements, allocation clients and graph copy.
fn: lmx_pointer_pool_in (@: arena c.LmxArena; @: cell void) @: c.LmxPool
    @: pool c.LmxPool 0
    pool: lmx_range_cell_pool(arena, cell)
    if: pool = 0 || pool\kind != c.LMX_KIND_PRIMITIVE || lmx_type_reference_cell((cast: (int) pool\type)) = 0 || pool\stride = 0U || pool\pointer_read = 0 || pool\pointer_write = 0
        return: 0
    return: pool
end: lmx_pointer_pool_in

fn: lmx_pointer_value_in (@: arena c.LmxArena; @: cell void) @: void
    @: pool c.LmxPool 0
    pool: lmx_pointer_pool_in(arena, cell)
    if: pool = 0
        return: 0
    return: pool\pointer_read(cell)
end: lmx_pointer_value_in

# The chunk of entry's array whose storage starts at entry's lo while that chunk is in the array's chain, or 0: the
# walk of the chain, kept in the entry with the array's chain_gen of that walk (RANGE-CELL-POOL-LINEAR: the walk on
# every read made each graph read O(chunks)).  The kept chunk answers again only while chain_gen is unchanged: no
# chunk has left the chain since, so the kept one is still in it and its record is alive (a chunk leaves its chain
# before its record is freed, lmx_arena_drop).  Its storage must still start at lo, as the walk requires, so a chunk
# whose storage was set anew is a walk too.  A chain that only grew keeps the answer.  A miss walks the chain once and
# keeps every chunk of it in its own entry of this index, so a changed chain_gen costs one walk per array and not one
# per entry; a chunk is kept when it joins the chain (lmx_range_keep_chunk), so a new chunk costs none.
fn: lmx_range_entry_chunk (@: arena c.LmxArena; @: entry c.LmxRange) @: c.LmxChunk
    @: array c.LmxPool 0
    @: chunk c.LmxChunk 0
    @: found c.LmxChunk 0
    @: other c.LmxRange 0
    @: lo void 0
    if: entry = 0 || entry\array = 0
        return: 0
    array: entry\array
    chunk: (cast: (@: LmxChunk) entry\chunk)
    if: chunk != 0 && entry\chunk_gen = array\chain_gen && (cast: (@: void) c.lmx_chunk_data(chunk)) = entry\lo
        return: chunk
    ---
    entry\chunk: 0
    chunk: array\head
    while: chunk != 0
        lo: (cast: (@: void) c.lmx_chunk_data(chunk))
        if: found = 0 && lo = entry\lo
            found: chunk
        ---
        other: lmx_range_entry_at(arena, lo)
        if: other != 0 && other\lo = lo && other\array = array
            other\chunk: (cast: (@: void) chunk)
            other\chunk_gen: array\chain_gen
        ---
        chunk: chunk\next
    ---
    return: found
end: lmx_range_entry_chunk

# A chunk that has just joined array's chain is kept in its storage's entry at the array's current chain_gen: the walk
# would find it now (lmx_range_entry_chunk), so its first read walks nothing.  The pool calls this once the chunk is
# both linked and registered (lmx_pool_add_chunk, lmx_pool_make_profiled, lmx_pool_over).
sub: lmx_range_keep_chunk (@: arena c.LmxArena; @: array c.LmxPool; @: chunk c.LmxChunk)
    @: entry c.LmxRange 0
    @: lo void 0
    if: arena = 0 || array = 0 || chunk = 0
        return
    lo: (cast: (@: void) c.lmx_chunk_data(chunk))
    entry: lmx_range_entry_at(arena, lo)
    if: entry = 0 || entry\lo != lo || entry\array != array
        return
    entry\chunk: (cast: (@: void) chunk)
    entry\chunk_gen: array\chain_gen
end: lmx_range_keep_chunk

# The exact live cell whose START address is `p`, or null. A range covers the whole
# allocated chunk, including spare capacity, so interval membership alone is insufficient:
# after bisection, use that interval's own base and the descriptor's stride, find the
# corresponding chunk, require cell alignment and require the cell index to be below that
# chunk's logical count. Matching by entry.lo (not by a cumulative count) is what keeps
# this correct for one array spread over non-contiguous chunks.
fn: lmx_range_cell_pool (@: arena c.LmxArena; @: p void) @: c.LmxPool
    @: entry c.LmxRange 0
    @: array c.LmxPool 0
    @: chunk c.LmxChunk 0
    size_t: offset 0U
    entry: lmx_range_entry_at(arena, p)
    if: entry = 0 || entry\array = 0
        return: 0
    array: entry\array
    if: array\stride = 0U
        return: 0
    ---
    chunk: lmx_range_entry_chunk(arena, entry)
    if: chunk = 0
        return: 0
    if: c.lmx_chunk_cells(chunk, array\stride) > c.lmx_chunk_room(chunk, array\stride)
        return: 0
    ---
    offset: (cast: (size_t) p) - (cast: (size_t) entry\lo)
    if: offset % array\stride != 0U
        return: 0
    if: offset / array\stride >= c.lmx_chunk_cells(chunk, array\stride)
        return: 0
    ---
    return: array
end: lmx_range_cell_pool

# The chunk that holds the live cell at p, or 0: the chunk lmx_range_cell_pool reads for p, from the entry's kept
# chunk (lmx_range_entry_chunk) instead of a walk of the array's chain (lmx_pool_chunk_at).  The collector asks it for
# every value it marks (lmx_gc_graph.lm1).
fn: lmx_range_cell_chunk (@: arena c.LmxArena; @: p void) @: c.LmxChunk
    @: entry c.LmxRange 0
    if: lmx_range_cell_pool(arena, p) = 0
        return: 0
    entry: lmx_range_entry_at(arena, p)
    return: lmx_range_entry_chunk(arena, entry)
end: lmx_range_cell_chunk

fn: lmx_range_classify (@: arena c.LmxArena; @: p void) int
    @: array c.LmxPool 0
    if: arena = 0 || p = 0
        return: c.LMX_KIND_NONE
    array: lmx_range_cell_pool(arena, p)
    if: array != 0
        return: (cast: (int) array\kind)
    ---
    return: c.LMX_KIND_NONE
end: lmx_range_classify

# Which element type the array containing the address holds.  The same bisection, read
# from the descriptor the entry names.
fn: lmx_range_type_of (@: arena c.LmxArena; @: p void) int
    @: array c.LmxPool 0
    if: arena = 0 || p = 0
        return: c.LMX_TYPE_NONE
    array: lmx_range_cell_pool(arena, p)
    if: array != 0
        return: (cast: (int) array\type)
    ---
    return: c.LMX_TYPE_NONE
end: lmx_range_type_of

# How many bytes one entry of that array occupies.  Read from the same entry, never
# guessed from the address arithmetic; 0 when the address lies in no array of the arena.
fn: lmx_range_stride (@: arena c.LmxArena; @: p void) size_t
    @: array c.LmxPool 0
    if: arena = 0 || p = 0
        return: 0U
    array: lmx_range_cell_pool(arena, p)
    if: array != 0
        return: (cast: (size_t) array\stride)
    ---
    return: 0U
end: lmx_range_stride

# The DESCRIPTOR of the array that contains this address: the array itself, with its
# stride, kind and type.  This is what a classifier hands back to code that then casts
# the pointer and writes straight into the cell, because a cell's address never changes
# (verbatim: "_Получив дескриптор типа код сразу делает приведение типа указателя и
# пишет напрямую в ячейку_ _Это обязательно_").  Null when no array of the arena has it.
fn: lmx_range_pool (@: arena c.LmxArena; @: p void) @: c.LmxPool
    @: entry c.LmxRange 0
    if: lmx_range_cell_pool(arena, p) = 0
        return: 0
    entry: lmx_range_entry_at(arena, p)
    if: entry = 0 || entry\owner != arena
        return: 0
    return: (cast: (@: LmxPool) entry\array)
end: lmx_range_pool

# True owner of a live cell selected by this index.  Imported ranges therefore answer their
# foreign owner, while allocator/GC ownership continues to use lmx_range_pool and sees only
# local ranges.
fn: lmx_range_home (@: arena c.LmxArena; @: p void) @: c.LmxArena
    @: entry c.LmxRange 0
    if: arena = 0 || p = 0
        return: 0
    if: lmx_range_cell_pool(arena, p) = 0
        return: 0
    entry: lmx_range_entry_at(arena, p)
    if: entry = 0
        return: 0
    return: (cast: (@: LmxArena) entry\owner)
end: lmx_range_home

fn: lmx_range_has_root_profile (@: arena c.LmxArena; @: p void; @@: roots c.Lmx; size_t: count) int
    size_t: i 0U
    @: p_profile c.Lmx 0
    if: arena = 0 || p = 0 || roots = 0 || count = 0U
        return: 0
    p_profile: lmx_range_profile(arena, p)
    if: p_profile = 0
        return: 0
    while: i < count
        if: roots[i] != 0 && lmx_range_profile(arena, (cast: (@: void) roots[i])) = p_profile
            return: 1
        i: i + 1U
    ---
    return: 0
end: lmx_range_has_root_profile

# Unlike exact-cell classification, a store must protect every live byte that
# it touches. A cast to char* can select the middle of a qualified int cell;
# weakening lmx_range_profile would instead misclassify that byte as an int.
# The index is sorted by disjoint physical intervals, so find the first interval
# whose end exceeds the write start and visit every later interval before the
# write end. Each interval's own chunk determines its live used prefix. Imported
# views retain their physical profile and are deliberately not filtered by owner.
fn: lmx_range_write_overlaps_profile (@: arena c.LmxArena; @: p void; size_t: bytes; @: exact_profile c.Lmx; @@: roots c.Lmx; size_t: root_count) int
    size_t: first 0U
    size_t: last 0U
    size_t: low 0U
    size_t: high 0U
    size_t: mid 0U
    size_t: i 0U
    size_t: cells 0U
    size_t: used 0U
    size_t: lo 0U
    size_t: hi 0U
    @: entry c.LmxRange 0
    @: array c.LmxPool 0
    @: chunk c.LmxChunk 0
    @: array_profile c.Lmx 0
    int: selected 0
    first: (cast: (size_t) p)
    # With no exact profile and no roots the barrier still protects the sealed profiled intervals (RR2b): a value
    # qualified at run time is in no list.
    if: arena = 0 || p = 0 || bytes = 0U
        return: 0
    if: bytes > ((cast: (size_t) -1) - first)
        return: 1
    last: first + bytes
    high: c.lmx_arena_index_len(arena)
    while: low < high
        mid: low + (high - low) / 2U
        entry: c.lmx_arena_index_data(arena) + mid
        if: (cast: (size_t) entry\hi) <= first
            low: mid + 1U
        else:
            high: mid
        ---
    ---
    while: low < c.lmx_arena_index_len(arena)
        entry: c.lmx_arena_index_data(arena) + low
        lo: (cast: (size_t) entry\lo)
        hi: (cast: (size_t) entry\hi)
        if: lo >= last
            break
        if: entry\array = 0 || hi < lo
            return: 1
        array: entry\array
        array_profile: array\profile
        # Physical immutable type protects live bytes even before a seal or callback.
        # Legacy positive-family constructors still retain their exact/root/sealed-profile
        # guard until all construction routes have been migrated.
        selected: (cast: (int) (lmx_type_is_immutable((cast: (int) array\type)) != 0 || (array_profile != 0 && (array_profile = exact_profile || array\sealed != 0U))))
        i: 0U
        while: selected = 0 && roots != 0 && i < root_count
            if: roots[i] != 0 && array_profile != 0 && lmx_range_profile(arena, (cast: (@: void) roots[i])) = array_profile
                selected: 1
            i: i + 1U
        ---
        if: selected != 0
            if: array\stride = 0U
                return: 1
            chunk: array\head
            while: chunk != 0 && (cast: (@: void) c.lmx_chunk_data(chunk)) != entry\lo
                chunk: chunk\next
            ---
            if: chunk = 0
                return: 1
            cells: c.lmx_chunk_cells(chunk, array\stride)
            if: cells > c.lmx_chunk_room(chunk, array\stride) || cells > ((cast: (size_t) -1) / array\stride)
                return: 1
            used: cells * array\stride
            if: used > hi - lo
                return: 1
            if: first < lo + used && last > lo
                return: 1
            ---
        ---
        low: low + 1U
    ---
    return: 0
end: lmx_range_write_overlaps_profile

fn: lmx_range_profile (@: arena c.LmxArena; @: p void) @: c.Lmx
    @: array c.LmxPool 0
    array: lmx_range_cell_pool(arena, p)
    if: array = 0
        return: 0
    return: (cast: (@: Lmx) array\profile)
end: lmx_range_profile

# The physical mark of a QUALIFIED value, read from the index alone (docs #eternal: membership is the typed-address-range
# index, neither a flag on the branch nor a registry): the cell's array carries a nonzero profile and is sealed, so the
# cell belongs to a branch the program qualified -- at translation (the prologue seals a static branch's pools) or at
# run time (lmx_arena_seal_profile after a copy or merge under the profile, RR2a; steps/qualifier-receivers-20261010.md).
# An imported view answers as its owner's array does.  The MSG pool sealed for import carries profile 0 and answers 0,
# as every unprofiled or unsealed cell does.  0 for no live cell at p.
fn: lmx_range_sealed_profile (@: arena c.LmxArena; @: p void) @: c.Lmx
    @: array c.LmxPool 0
    array: lmx_range_cell_pool(arena, p)
    if: array = 0 || array\profile = 0 || array\sealed = 0U
        return: 0
    return: (cast: (@: Lmx) array\profile)
end: lmx_range_sealed_profile

# Import is a range-table operation, not an arena attachment. Live arenas
# import only sealed arrays; source_mode is restricted to disposable copy
# views and can also classify mutable lexical context. Blocks, descriptors
# and array-list membership stay with the true owner. Since source may itself
# contain imports, each entry retains its owner. Exact repeats are no-ops.
fn: lmx_range_import_selected (@: arena c.LmxArena; @: source c.LmxArena; @: wanted c.Lmx; int: all_profiles; int: source_mode) int
    @: entry c.LmxRange 0
    @: present c.LmxRange 0
    size_t: index 0U
    size_t: scan 0U
    size_t: needed 0U
    int: exact 0
    int: selected 0
    if: arena = 0 || source = 0
        return: 1
    if: arena = source
        return: 0
    if: source_mode != 0 && arena\source_view = 0U
        return: 1
    ---
    # Preflight the complete view before changing the borrower.  A caller must never see
    # half of a type view merely because a later interval conflicts or index allocation
    # fails.  Existing exact rows are retained and do not count toward the reservation.
    while: index < c.lmx_arena_index_len(source)
        entry: c.lmx_arena_index_data(source) + index
        selected: 0
        if: entry\array != 0 && (entry\array\sealed != 0U || source_mode != 0)
            if: all_profiles != 0 || entry\array\profile = wanted
                selected: 1
            ---
        ---
        if: selected != 0
            exact: 0
            scan: 0U
            while: scan < c.lmx_arena_index_len(arena)
                present: c.lmx_arena_index_data(arena) + scan
                if: entry\lo < present\hi && entry\hi > present\lo
                    if: entry\lo = present\lo && entry\hi = present\hi && entry\array = present\array && entry\owner = present\owner
                        exact: 1
                    else:
                        return: 1
                    ---
                    break
                ---
                scan: scan + 1U
            ---
            if: exact = 0
                if: needed = (cast: (size_t) -1)
                    return: 1
                needed: needed + 1U
            ---
        ---
        index: index + 1U
    ---
    if: needed > (cast: (size_t) -1) - c.lmx_arena_index_len(arena)
        return: 1
    if: lmx_range_reserve(arena, c.lmx_arena_index_len(arena) + needed) != 0
        return: 1
    ---
    # The source index is internally non-overlapping and the preflight validated every
    # destination overlap.  With capacity reserved, this pass cannot expose a partial
    # import on an expected error path.
    index: 0U
    while: index < c.lmx_arena_index_len(source)
        entry: c.lmx_arena_index_data(source) + index
        selected: 0
        if: entry\array != 0 && (entry\array\sealed != 0U || source_mode != 0)
            if: all_profiles != 0 || entry\array\profile = wanted
                selected: 1
            ---
        ---
        if: selected != 0
            if: lmx_range_add_view(arena, (cast: (@: LmxArena) entry\owner), (cast: (@: LmxPool) entry\array), (cast: (@: void) entry\lo), (cast: (@: void) entry\hi)) != 0
                return: 1
            ---
        ---
        index: index + 1U
    ---
    return: 0
end: lmx_range_import_selected

# Explicit whole-view import, used when a caller intentionally grants every sealed physical
# domain visible in source (for example, a module-level import).
fn: lmx_range_import (@: arena c.LmxArena; @: source c.LmxArena) int
    return: lmx_range_import_selected(arena, source, 0, 1, 0)
end: lmx_range_import

# Narrow import used by a profiled copy/merge: grant only arrays carrying the exact physical
# profile that was named.  Other sealed profiles and ordinary sealed arrays remain invisible.
fn: lmx_range_import_profile (@: arena c.LmxArena; @: source c.LmxArena; @: wanted c.Lmx) int
    if: wanted = 0
        return: 1
    return: lmx_range_import_selected(arena, source, wanted, 0, 0)
end: lmx_range_import_profile

# Build a disposable read-only union for a graph-copy source. This is never a
# runtime import: unsealed cells remain owned by source and cannot be published
# into any ordinary Message arena through this function.
fn: lmx_range_import_source_view (@: arena c.LmxArena; @: source c.LmxArena) int
    if: arena = 0 || arena\source_view = 0U
        return: 1
    ---
    return: lmx_range_import_selected(arena, source, 0, 1, 1)
end: lmx_range_import_source_view

fn: lmx_range_unimport_profile (@: arena c.LmxArena; @: wanted c.Lmx) int
    @: entry c.LmxRange 0
    @: lo void 0
    @: hi void 0
    size_t: i 0U
    if: arena = 0 || wanted = 0
        return: 1
    ---
    while: i < c.lmx_arena_index_len(arena)
        entry: c.lmx_arena_index_data(arena) + i
        if: entry\array != 0 && entry\owner != arena && entry\array\profile = wanted
            lo: entry\lo
            hi: entry\hi
            if: lmx_range_drop(arena, lo, hi) != 0
                return: 1
            ---
        else:
            i: i + 1U
        ---
    ---
    return: 0
end: lmx_range_unimport_profile

# ---- Code links (slice 253, design 4.4): the side storage of an interval ---------------------------------------------
#
# A cell that stands in a place of code is linked to that place: the chain of (holder, slot) records of one cell hangs
# from the entry of the cell's interval -- the lazily made `links` array of heads, one per cell ordinal -- and the
# records are C-heap nodes of that chain and of no other list.  The interval of a Structure's child array also names
# that Structure (`holder`), and an interval of the shared REF pool names the Array owning each of its cells
# (`slot_owner`), so a slot cell alone recovers the (holder, slot) it is.  None of this is graph storage: the
# collector neither marks nor sweeps it, copy and merge do not see it, the arena's block list does not hold it.  It
# lives exactly as long as its entry: lmx_range_drop frees it while the cells are still registered and readable (the
# records naming a dropped child array as their holder go first), lmx_range_side_release frees it for a bulk release
# and lmx_arena_attach moves it with the entry.  The stride and the kind are the array's, copied at the insertion of
# the entry (`side_stride`, `kind`): at drop time the entry's array record may already be freed.

fn: lmx_range_side_cells (@: entry c.LmxRange; size_t: stride) size_t
    if: entry = 0 || stride = 0U
        return: 0U
    return: ((cast: (size_t) entry\hi) - (cast: (size_t) entry\lo)) / stride
end: lmx_range_side_cells

# The ordinal of `cell` in its entry, or (size_t) -1 when the entry has no side storage or the cell is past it.
fn: lmx_range_side_ordinal (@: entry c.LmxRange; @: cell void) size_t
    size_t: ordinal 0U
    if: entry = 0 || cell = 0 || entry\side_stride = 0U || entry\side_cells = 0U
        return: (cast: (size_t) -1)
    if: (cast: (size_t) cell) < (cast: (size_t) entry\lo)
        return: (cast: (size_t) -1)
    ordinal: ((cast: (size_t) cell) - (cast: (size_t) entry\lo)) / entry\side_stride
    if: ordinal >= entry\side_cells
        return: (cast: (size_t) -1)
    return: ordinal
end: lmx_range_side_ordinal

# The side storage of an entry comes into being with its first use: the cell count follows from the interval and the
# stride kept since the entry's insertion.
fn: lmx_range_side_open (@: entry c.LmxRange) int
    size_t: stride 0U
    if: entry = 0 || entry\side_stride = 0U
        return: 1
    if: entry\side_cells != 0U
        return: 0
    stride: entry\side_stride
    entry\side_cells: lmx_range_side_cells(entry, stride)
    if: entry\side_cells = 0U
        return: 1
    return: 0
end: lmx_range_side_open

fn: lmx_range_holder_set (@: arena c.LmxArena; @: base void; @: holder c.Lmx) int
    @: entry c.LmxRange 0
    if: arena = 0 || base = 0
        return: 1
    entry: lmx_range_entry_at(arena, base)
    if: entry = 0 || entry\lo != base || lmx_range_side_open(entry) != 0
        return: 1
    entry\holder: holder
    return: 0
end: lmx_range_holder_set

# The (holder, slot) a slot cell is: the Structure whose child array the cell's interval is, or the Array owning the
# cell in the shared REF pool; 0 when the cell is no slot of a graph node this index knows.
fn: lmx_range_slot_holder (@: arena c.LmxArena; @: cell void; @: slot size_t) @: c.Lmx
    @: entry c.LmxRange 0
    @: owner c.Lmx 0
    @: va c.VoidArray 0
    size_t: ordinal 0U
    if: arena = 0 || cell = 0 || slot = 0
        return: 0
    entry: lmx_range_entry_at(arena, cell)
    if: entry = 0 || entry\side_cells = 0U
        return: 0
    ordinal: lmx_range_side_ordinal(entry, cell)
    if: ordinal = (cast: (size_t) -1)
        return: 0
    if: entry\holder != 0
        \slot: ordinal
        return: entry\holder
    ---
    if: entry\slot_owner = 0
        return: 0
    owner: entry\slot_owner[ordinal]
    if: owner = 0
        return: 0
    va: @ owner\array
    if: va\data = 0 || (cast: (size_t) cell) < (cast: (size_t) va\data)
        return: 0
    \slot: ((cast: (size_t) cell) - (cast: (size_t) va\data)) / entry\side_stride
    return: owner
end: lmx_range_slot_holder

# One record, PREPARED before the write it will describe: `child` is to stand in slot `slot` of `holder`, a place of
# code.  The entry's heads are made here too, so the write that follows allocates nothing (lmx_range_link_commit).  A
# child this index does not own gets no record (`out` 0; an imported view is another arena's cell), which is not a
# failure; 1 only when the C heap refuses -- and then nothing has been written.
fn: lmx_range_link_prepare (@: arena c.LmxArena; @: child void; @: holder c.Lmx; size_t: slot; @@: out c.LmxCodeLink) int
    @: entry c.LmxRange 0
    @: link c.LmxCodeLink 0
    size_t: ordinal 0U
    if: arena = 0 || child = 0 || holder = 0 || out = 0
        return: 1
    \out: 0
    entry: lmx_range_entry_at(arena, child)
    if: entry = 0 || entry\owner != (cast: (@: void) arena)
        return: 0
    if: lmx_range_side_open(entry) != 0
        return: 0
    ordinal: lmx_range_side_ordinal(entry, child)
    if: ordinal = (cast: (size_t) -1)
        return: 0
    if: entry\links = 0
        entry\links: (cast: (@@: c.LmxCodeLink) c.calloc(entry\side_cells, sizeof(@: void)))
        if: entry\links = 0
            return: 1
        ---
    ---
    link: (cast: (@: c.LmxCodeLink) c.malloc(c.sizeof(c.LmxCodeLink)))
    if: link = 0
        return: 1
    link\child: child
    link\holder: holder
    link\slot: slot
    link\next: 0
    link\mark: 0U
    link\work: 0
    \out: link
    return: 0
end: lmx_range_link_prepare

# The prepared record joins its child's chain, after the write.  No allocation: the heads exist since the preparation.
fn: lmx_range_link_commit (@: arena c.LmxArena; @: record c.LmxCodeLink) int
    @: entry c.LmxRange 0
    @: child void 0
    size_t: ordinal 0U
    if: record = 0
        return: 0
    child: record\child
    entry: lmx_range_entry_at(arena, child)
    if: entry = 0 || entry\links = 0
        c.free((cast: (@: void) record))
        return: 1
    ordinal: lmx_range_side_ordinal(entry, child)
    if: ordinal = (cast: (size_t) -1)
        c.free((cast: (@: void) record))
        return: 1
    record\next: entry\links[ordinal]
    entry\links[ordinal]: record
    return: 0
end: lmx_range_link_commit

# A prepared record whose write did not happen.
sub: lmx_range_link_abandon (@: record c.LmxCodeLink)
    if: record != 0
        c.free((cast: (@: void) record))
    ---
    return
end: lmx_range_link_abandon

# Remove the records of `child` naming `holder`: exactly the one of slot `slot`, or every one when `any_slot`.
fn: lmx_range_link_cut (@: arena c.LmxArena; @: child void; @: holder c.Lmx; size_t: slot; int: any_slot) int
    @: entry c.LmxRange 0
    @@: at c.LmxCodeLink 0
    @: link c.LmxCodeLink 0
    size_t: ordinal 0U
    if: arena = 0 || child = 0 || holder = 0
        return: 1
    entry: lmx_range_entry_at(arena, child)
    if: entry = 0 || entry\links = 0
        return: 0
    ordinal: lmx_range_side_ordinal(entry, child)
    if: ordinal = (cast: (size_t) -1)
        return: 0
    at: entry\links + ordinal
    link: \at
    while: link != 0
        if: link\holder = holder && (any_slot != 0 || link\slot = slot)
            \at: link\next
            c.free((cast: (@: void) link))
            if: any_slot = 0
                return: 0
            ---
        else:
            at: @ link\next
        ---
        link: \at
    ---
    return: 0
end: lmx_range_link_cut

fn: lmx_range_link_remove (@: arena c.LmxArena; @: child void; @: holder c.Lmx; size_t: slot) int
    return: lmx_range_link_cut(arena, child, holder, slot, 0)
end: lmx_range_link_remove

# The chain of the places of code `child` stands in, or 0.
fn: lmx_range_links_of (@: arena c.LmxArena; @: child void) @: c.LmxCodeLink
    @: entry c.LmxRange 0
    size_t: ordinal 0U
    if: arena = 0 || child = 0
        return: 0
    entry: lmx_range_entry_at(arena, child)
    if: entry = 0 || entry\links = 0
        return: 0
    ordinal: lmx_range_side_ordinal(entry, child)
    if: ordinal = (cast: (size_t) -1)
        return: 0
    return: entry\links[ordinal]
end: lmx_range_links_of

# Free one entry's side storage: every chain, the heads and the owners.
sub: lmx_range_side_free (@: entry c.LmxRange)
    @: link c.LmxCodeLink 0
    @: next c.LmxCodeLink 0
    size_t: i 0U
    if: entry = 0
        return
    if: entry\links != 0
        while: i < entry\side_cells
            link: entry\links[i]
            while: link != 0
                next: link\next
                c.free((cast: (@: void) link))
                link: next
            ---
            i: i + 1U
        ---
        c.free((cast: (@: void) entry\links))
    ---
    if: entry\slot_owner != 0
        c.free((cast: (@: void) entry\slot_owner))
    ---
    entry\links: 0
    entry\slot_owner: 0
    entry\holder: 0
    entry\side_cells: 0U
    entry\side_stride: 0U
    return
end: lmx_range_side_free

# The Array owning `count` cells of a REF backing from `base`.  A cell changing owner takes the old owner's records of
# its child away (no path re-backs an Array today; the rule holds for one that will).  1 when the C heap refuses.
fn: lmx_range_slot_owner_set (@: arena c.LmxArena; @: base void; size_t: count; @: owner c.Lmx) int
    @: entry c.LmxRange 0
    @: old c.Lmx 0
    @@: cells void 0
    size_t: first 0U
    size_t: i 0U
    if: arena = 0 || base = 0 || count = 0U
        return: 1
    entry: lmx_range_entry_at(arena, base)
    if: entry = 0 || lmx_range_side_open(entry) != 0
        return: 1
    first: lmx_range_side_ordinal(entry, base)
    if: first = (cast: (size_t) -1) || count > entry\side_cells - first
        return: 1
    if: entry\slot_owner = 0
        entry\slot_owner: (cast: (@@: c.Lmx) c.calloc(entry\side_cells, sizeof(@: void)))
        if: entry\slot_owner = 0
            return: 1
        ---
    ---
    cells: (cast: (@@: void) entry\lo)
    while: i < count
        old: entry\slot_owner[first + i]
        if: old != 0 && old != owner && cells[first + i] != 0
            lmx_range_link_cut(arena, cells[first + i], old, 0U, 1)
        ---
        entry\slot_owner[first + i]: owner
        i: i + 1U
    ---
    return: 0
end: lmx_range_slot_owner_set

# An interval of Array descriptors leaves: each descriptor's backing cells in a still-registered REF interval lose their
# owner, and the children standing in them lose the records naming the descriptor as their holder -- while the
# descriptors are still readable, so a shared REF interval never names a freed Array (P1-A of Codex's review of
# slice 253).  A backing whose own interval already left has no entry and nothing to retire; an untaken descriptor
# cell is zero (the chunks are calloc'd) and has no backing.
sub: lmx_range_descriptors_retire (@: arena c.LmxArena; @: entry c.LmxRange)
    @: desc c.Lmx 0
    @: va c.VoidArray 0
    @: backing c.LmxRange 0
    @@: cells void 0
    @: data void 0
    size_t: size 0U
    size_t: stride 0U
    size_t: n 0U
    size_t: i 0U
    size_t: k 0U
    size_t: first 0U
    if: arena = 0 || entry = 0 || entry\side_stride = 0U
        return
    stride: entry\side_stride
    n: lmx_range_side_cells(entry, stride)
    while: i < n
        desc: (cast: (@: c.Lmx) ((cast: (@: char) entry\lo) + i * stride))
        va: @ desc\array
        data: va\data
        size: va\size
        if: data != 0 && size != 0U
            backing: lmx_range_entry_at(arena, data)
            if: backing != 0 && backing != entry && backing\slot_owner != 0
                first: lmx_range_side_ordinal(backing, data)
                if: first != (cast: (size_t) -1)
                    cells: (cast: (@@: void) data)
                    k: 0U
                    while: k < size && first + k < backing\side_cells
                        if: backing\slot_owner[first + k] = desc
                            backing\slot_owner[first + k]: 0
                            if: cells[k] != 0
                                lmx_range_link_cut(arena, cells[k], desc, 0U, 1)
                            ---
                        ---
                        k: k + 1U
                    ---
                ---
            ---
        ---
        i: i + 1U
    ---
    return
end: lmx_range_descriptors_retire

# An interval leaves the index: a departing interval of Array descriptors retires their owners first; the children its
# slots still hold lose the records naming this holder (the cells are registered and readable until the caller frees
# the block; a child whose own interval already left has no chain); then the side storage goes.
sub: lmx_range_side_drop (@: arena c.LmxArena; @: entry c.LmxRange)
    @@: cells void 0
    @: child void 0
    @: holder c.Lmx 0
    size_t: n 0U
    size_t: i 0U
    if: entry = 0
        return
    if: entry\kind = c.LMX_KIND_ARRAY
        lmx_range_descriptors_retire(arena, entry)
    ---
    if: entry\holder != 0 || entry\slot_owner != 0
        n: entry\side_cells
        cells: (cast: (@@: void) entry\lo)
        while: i < n
            child: cells[i]
            holder: entry\holder
            if: holder = 0
                holder: entry\slot_owner[i]
            ---
            if: child != 0 && holder != 0
                lmx_range_link_cut(arena, child, holder, 0U, 1)
            ---
            i: i + 1U
        ---
    ---
    lmx_range_side_free(entry)
    return
end: lmx_range_side_drop

# Bulk: every entry's side storage goes with the index (lmx_arena_release).
sub: lmx_range_side_release (@: arena c.LmxArena)
    @: entry c.LmxRange 0
    size_t: index 0U
    if: arena = 0 || c.lmx_arena_index_data(arena) = 0
        return
    while: index < c.lmx_arena_index_len(arena)
        entry: c.lmx_arena_index_data(arena) + index
        lmx_range_side_free(entry)
        index: index + 1U
    ---
    return
end: lmx_range_side_release
