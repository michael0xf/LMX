predef: "l2src/lmx_arena.h.lm1"

# Mutable size_t cells. Spec 2: interned chars share an address by value;
# mutable primitives need their own registered domain. Each own size_t field
# gets one cell of the arena's array of size_t primitives at construction;
# assignment stores through that cell (unique backing, no interned shared
# size_t, no int narrowing).
#
# There is no module-level pool and no init any more: a process-wide array cannot
# be a Message's array, so the array this unit hands cells out of is the ARENA's
# own -- made by the first request of this kind and type, grown by adding a chunk
# after that, and found again by every later request through the arena's list of
# its N arrays (lmx_arena_take_n).  What this unit needs of another unit is that
# take and nothing else, so that is what it opens.

# One cell of the arena's array of size_t primitives, zeroed.  Nothing is consulted
# but the arena: the array answers for itself, and a request from any module of
# this arena lands in the SAME array -- the cells are intervals of one array, not
# arrays of their own.
fn: lmx_size_take (@: LmxArena arena) @: void
    @: void cell
    size_t: z 0U
    @: size_t p
    if: arena = 0
        return: 0
    cell: lmx_arena_take(arena, c.sizeof(z), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_SIZE_T)
    if: cell = 0
        return: 0
    p: (cast: (@: size_t) cell)
    \p: 0U
return: cell

# The type is known statically here -- the caller holds a size_t cell it took from
# the arena's array -- so the arena's table is NOT consulted: it answers only about
# an untyped void * (Mikhail, 2026-09-17, verbatim: "_Получив дескриптор типа
# код сразу делает приведение типа указателя и пишет напрямую в ячейку_ _Это
# обязательно_").  The re-check through the table that stood here is removed.
fn: lmx_size_value (@: void cell) size_t
    @: size_t p
    if: cell = 0
        return: 0U
    p: (cast: (@: size_t) cell)
return: \p

fn: lmx_size_store (@: void cell; size_t: v) int
    @: size_t p
    if: cell = 0
        return: 1
    p: (cast: (@: size_t) cell)
    \p: v
return: 0
