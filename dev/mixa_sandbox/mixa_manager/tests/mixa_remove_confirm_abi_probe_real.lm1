# ABI parity guard — L1 port of mixa_remove_confirm_abi_probe_real.c (ticket 20260918-082421).
# offsetof is a C macro with no L1 spelling (c. pastes a call, not a preprocessor
# name). Field offsets are computed at run time via pointer arithmetic on a local
# store (same pattern as l2src/lmx_message_selftest.lm1). Output format strings
# are kept byte-identical to the C probe so L2-vs-real parity still diffs stdout.
predef: "mixa_manager/mixa_remove_confirm.h.lm1"
include: "<stdio.h>"

fn: main () int
    MixaRemoveConfirmCtx: store0
    @: MixaRemoveConfirmCtx p0
    p0: @ store0

    c.printf("MixaRemoveConfirmCtx sizeof=%zu\n", c.sizeof(c.MixaRemoveConfirmCtx))
    c.printf("MixaRemoveConfirmCtx stack=%zu\n", (cast: (size_t) @ p0\stack) - (cast: (size_t) p0))
    c.printf("MixaRemoveConfirmCtx rect=%zu\n", (cast: (size_t) @ p0\rect) - (cast: (size_t) p0))
    c.printf("MixaRemoveConfirmCtx fm=%zu\n", (cast: (size_t) @ p0\fm) - (cast: (size_t) p0))
    c.printf("MixaRemoveConfirmCtx window_row=%zu\n", (cast: (size_t) @ p0\window_row) - (cast: (size_t) p0))
    c.printf("MixaRemoveConfirmCtx window_col=%zu\n", (cast: (size_t) @ p0\window_col) - (cast: (size_t) p0))
    c.printf("MixaRemoveConfirmCtx nrows=%zu\n", (cast: (size_t) @ p0\nrows) - (cast: (size_t) p0))
    c.printf("MixaRemoveConfirmCtx ncols=%zu\n", (cast: (size_t) @ p0\ncols) - (cast: (size_t) p0))
    c.printf("MixaRemoveConfirmCtx hb=%zu\n", (cast: (size_t) @ p0\hb) - (cast: (size_t) p0))
    c.printf("MixaRemoveConfirmCtx is_open=%zu\n", (cast: (size_t) @ p0\is_open) - (cast: (size_t) p0))
    c.printf("MixaRemoveConfirmCtx invocations=%zu\n", (cast: (size_t) @ p0\invocations) - (cast: (size_t) p0))
    c.printf("MixaRemoveConfirmCtx last_status=%zu\n", (cast: (size_t) @ p0\last_status) - (cast: (size_t) p0))
    c.printf("MixaRemoveConfirmCtx has_failure=%zu\n", (cast: (size_t) @ p0\has_failure) - (cast: (size_t) p0))
    c.printf("MixaRemoveConfirmCtx failing_path=%zu\n", (cast: (size_t) @ p0\failing_path) - (cast: (size_t) p0))
    return: 0

