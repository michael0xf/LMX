Checked:
    int: value
    return: int
    checked:
        throws: InputFailure
        if: value < 0
            throw: InputFailure()
        return: value * 2

ResultValue:
    int: value
    return: int
    use:
        return: value

FailureValue:
    @: reason
    return: int
    use:
        return: 99

Example:
    int: value
    return: int
    run:
        throws: copy(attempt\throws) copy(foldResult\throws)
        return: \(foldResult (attempt Checked\checked (value)) FailureValue\use ResultValue\use)
