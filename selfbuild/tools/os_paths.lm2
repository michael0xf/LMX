# Add reversed slash-separated components, including empty ones, to the stack.
# A failed partial append is owned by the caller's normal stack cleanup.
fn: fp_reverse_parts (@: text char; @@@: names char; @@: kinds unsigned; @: count size_t; @: capacity size_t; @: parts size_t) int
    size_t: after c.strlen(text)
    size_t: first 0U
    @: name char 0
    while: 1
        first: after
        while: first > 0U && text[first - 1U] != (cast: (char) 47)
            first: first - 1U
        name: txt_ndup(text + first, after - first)
        if: name = 0
            return: -1
        if: fs_entry_append(names, kinds, count, capacity, name, 0U) != 0
            c.free(name)
            return: -1
        parts[0]: parts[0] + 1U
        if: first = 0U
            break
        after: first - 1U
    ---
    return: 0
end: fp_reverse_parts

# Each seen row is [owned key, owned resolved value or NULL=pending].
# Growing a single vector preserves old ownership on realloc failure.
fn: fp_seen_add (@@@: rows char; @: count size_t; @: capacity size_t; @: key char) int
    size_t: limit (cast: (size_t) -1)
    size_t: grown 0U
    @@: next_rows char 0
    @: owned char 0
    limit: limit / sizeof(@: char) / 2U
    if: count[0] >= limit
        return: -1
    owned: txt_dup(key)
    if: owned = 0
        return: -1
    if: count[0] = capacity[0]
        grown: 16U
        if: capacity[0] > 0U
            grown: limit
            if: capacity[0] <= limit / 2U
                grown: 2U * capacity[0]
            ---
        ---
        if: grown > limit
            grown: limit
        next_rows: c.realloc(rows[0], 2U * grown * sizeof(@: char))
        if: next_rows = 0
            c.free(owned)
            return: -1
        rows[0]: next_rows
        capacity[0]: grown
    ---
    rows[0][2U * count[0]]: owned
    rows[0][2U * count[0] + 1U]: 0
    count[0]: count[0] + 1U
    return: 0
end: fp_seen_add

fn: fp_seen_free (@@: rows char; size_t: count) int
    size_t: at 0U
    while: at < 2U * count
        c.free(rows[at])
        at: at + 1U
    c.free(rows)
    return: 0
end: fp_seen_free

os:
    # default is fallback, including on Windows when win is absent. Select
    # this ordinary header-only branch so POSIX bodies stay unselected there.
    win:
        include: "<stddef.h>"
    default:
        include: "<unistd.h>" "<sys/stat.h>" "<errno.h>" "<limits.h>"
        define: LmxPathStat struct stat

        fn: os_path_join (@: base char; @: tail char) @: char
            size_t: count 0U
            if: base = 0 || tail = 0
                return: 0
            if: tail[0] = (cast: (char) 47) || base[0] = (cast: (char) 0)
                return: txt_dup(tail)
            count: c.strlen(base)
            if: base[count - 1U] = (cast: (char) 47)
                return: txt_cat(base, tail)
            return: txt_path(base, tail)
        end: os_path_join

        fn: os_path_dirname (@: path char) @: char
            size_t: after c.strlen(path)
            size_t: at 0U
            int: all_slashes 1
            while: after > 0U && path[after - 1U] != (cast: (char) 47)
                after: after - 1U
            while: at < after
                if: path[at] != (cast: (char) 47)
                    all_slashes: 0
                    break
                at: at + 1U
            ---
            if: all_slashes = 0
                while: after > 0U && path[after - 1U] = (cast: (char) 47)
                    after: after - 1U
                ---
            return: txt_ndup(path, after)
        end: os_path_dirname

        fn: fp_posix_parent (@: path char) @: char
            size_t: count c.strlen(path)
            while: count > 0U && path[count - 1U] != (cast: (char) 47)
                count: count - 1U
            if: count > 0U
                count: count - 1U
            if: count = 0U
                return: txt_dup("/")
            return: txt_ndup(path, count)
        end: fp_posix_parent

        # Unlike an OS failure, memory/length failure is never ignored.
        # readlink's ssize_t is converted as a whole before a size_t local.
        fn: fp_posix_readlink (@: path char; @@: out char) int
            @: buffer char 0
            size_t: capacity 256U
            size_t: got 0U
            size_t: limit (cast: (size_t) c.SSIZE_MAX)
            out[0]: 0
            while: 1
                if: capacity > limit || capacity = (cast: (size_t) -1)
                    return: -1
                buffer: c.malloc(capacity + 1U)
                if: buffer = 0
                    return: -1
                got: (cast: (size_t) c.readlink(path, buffer, capacity))
                if: got = (cast: (size_t) -1)
                    c.free(buffer)
                    return: 1
                if: got < capacity
                    buffer[got]: (cast: (char) 0)
                    out[0]: buffer
                    return: 0
                ---
                c.free(buffer)
                if: capacity > limit / 2U
                    return: -1
                capacity: 2U * capacity
            ---
        end: fp_posix_readlink

        fn: fp_posix_cwd () @: char
            @: buffer char 0
            @: error_cell int (cast: (@: int) (@ c.errno))
            size_t: capacity 256U
            size_t: limit (cast: (size_t) -1)
            int: error 0
            while: 1
                buffer: c.malloc(capacity)
                if: buffer = 0
                    return: 0
                error_cell[0]: 0
                if: c.getcwd(buffer, capacity) != 0
                    return: buffer
                error: error_cell[0]
                c.free(buffer)
                if: error != c.ERANGE || capacity > limit / 2U
                    return: 0
                capacity: 2U * capacity
            ---
        end: fp_posix_cwd

        # Input has explicit length: embedded NUL must not truncate into a
        # different existing pathname. A result is fresh and NUL-terminated.
        fn: os_path_resolve_nonstrict (@: input char; size_t: input_count; @@: out char; @: out_count size_t) int
            @: initial char 0
            @: path char 0
            @: name char 0
            @: next_path char 0
            @: target char 0
            @: marker char 0
            @: copy char 0
            @: status c.LmxPathStat 0
            @@: stack char 0
            @: kinds unsigned 0
            @@: seen char 0
            size_t: stack_count 0U
            size_t: stack_capacity 0U
            size_t: parts 0U
            size_t: seen_count 0U
            size_t: seen_capacity 0U
            size_t: found 0U
            unsigned: kind 0U
            int: failed 0
            int: link_result 0
            if: input = 0 || out = 0 || out_count = 0
                return: 1
            out[0]: 0
            out_count[0]: 0U
            if: c.memchr(input, 0, input_count) != 0
                return: 1
            initial: txt_ndup(input, input_count)
            status: c.calloc(1U, c.sizeof(c.LmxPathStat))
            if: initial = 0 || status = 0
                failed: 1
            if: failed = 0
                path: txt_dup("/")
                if: initial[0] != (cast: (char) 47)
                    c.free(path)
                    path: fp_posix_cwd()
                if: path = 0 || fp_reverse_parts(initial, @ stack, @ kinds, @ stack_count, @ stack_capacity, @ parts) != 0
                    failed: 1
                ---
            ---
            while: failed = 0 && parts > 0U
                if: stack_count = 0U
                    failed: 1
                    break
                stack_count: stack_count - 1U
                name: stack[stack_count]
                kind: kinds[stack_count]
                stack[stack_count]: 0
                if: kind = 1U
                    found: 0U
                    while: found < seen_count && c.strcmp(seen[2U * found], name) != 0
                        found: found + 1U
                    if: found = seen_count
                        failed: 1
                    else:
                        copy: txt_dup(path)
                        if: copy = 0
                            failed: 1
                        else:
                            c.free(seen[2U * found + 1U])
                            seen[2U * found + 1U]: copy
                        ---
                        copy: 0
                    ---
                    c.free(name)
                    name: 0
                    continue
                ---
                parts: parts - 1U
                if: name[0] = (cast: (char) 0) || c.strcmp(name, ".") = 0
                    c.free(name)
                    name: 0
                    continue
                if: c.strcmp(name, "..") = 0
                    next_path: fp_posix_parent(path)
                    c.free(path)
                    c.free(name)
                    path: next_path
                    next_path: 0
                    name: 0
                    if: path = 0
                        failed: 1
                    continue
                ---
                next_path: os_path_join(path, name)
                c.free(name)
                name: 0
                if: next_path = 0
                    failed: 1
                    break
                # Any lstat/readlink OS failure is ignored in this mode.
                link_result: 1
                if: c.lstat(next_path, status) = 0
                    if: c.S_ISLNK(status\st_mode) != 0
                        found: 0U
                        while: found < seen_count && c.strcmp(seen[2U * found], next_path) != 0
                            found: found + 1U
                        if: found < seen_count
                            c.free(path)
                            path: next_path
                            next_path: 0
                            if: seen[2U * found + 1U] != 0
                                c.free(path)
                                path: txt_dup(seen[2U * found + 1U])
                                if: path = 0
                                    failed: 1
                                ---
                            ---
                            continue
                        ---
                        link_result: fp_posix_readlink(next_path, @ target)
                    ---
                ---
                if: link_result < 0
                    failed: 1
                    break
                if: link_result != 0
                    c.free(path)
                    path: next_path
                    next_path: 0
                    continue
                ---
                if: target[0] = (cast: (char) 47)
                    c.free(path)
                    path: txt_dup("/")
                    if: path = 0
                        failed: 1
                    ---
                if: failed = 0
                    failed: fp_seen_add(@ seen, @ seen_count, @ seen_capacity, next_path)
                if: failed = 0
                    marker: txt_dup(next_path)
                    if: marker = 0
                        failed: 1
                    else:
                        failed: fs_entry_append(@ stack, @ kinds, @ stack_count, @ stack_capacity, marker, 1U)
                        if: failed = 0
                            marker: 0
                        ---
                    ---
                ---
                if: failed = 0
                    failed: fp_reverse_parts(target, @ stack, @ kinds, @ stack_count, @ stack_capacity, @ parts)
                c.free(marker)
                c.free(target)
                c.free(next_path)
                marker: 0
                target: 0
                next_path: 0
            ---
            if: failed = 0
                out[0]: path
                out_count[0]: c.strlen(path)
                path: 0
            fs_entries_free(stack, kinds, stack_count)
            fp_seen_free(seen, seen_count)
            c.free(initial)
            c.free(path)
            c.free(name)
            c.free(next_path)
            c.free(target)
            c.free(marker)
            c.free(copy)
            c.free(status)
            if: failed != 0
                return: 1
            return: 0
        end: os_path_resolve_nonstrict
end: os

