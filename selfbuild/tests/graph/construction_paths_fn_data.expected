---
    Observed:
        int: initial 11
        int: args_deferred 2
        int: code_deferred 2
        int: first 8
        int: after_first 11
        int: changed 11
        int: second 9
        int: after_second 11
        int: current 9
    end: Observed
---
@: shared (data [] 0)
fn: f () int (
    int: value 7
)
    :=: (data \ value) ((data \ value) + 1)
    return: (data \ value)
end: f
D:
    @: data_snapshot data
    @: args_snapshot (f \ args)
    @: code_snapshot (f \ code)
end: D
int: initial 0
:=: initial ((D \ data_snapshot) \ value)
int: args_deferred 0
:=: args_deferred (length (D [] 1))
int: code_deferred 0
:=: code_deferred (length (D [] 2))
int: first 0
:=: first (f)
int: after_first 0
:=: after_first ((D \ data_snapshot) \ value)
:=: ((D \ data_snapshot) \ value) 11
int: changed 0
:=: changed ((D \ data_snapshot) \ value)
int: second 0
:=: second (f)
int: after_second 0
:=: after_second ((D \ data_snapshot) \ value)
int: current 0
:=: current ((f \ data) \ value)
sub: main ()
    :=: ((shared \ Observed) \ initial) initial
    :=: ((shared \ Observed) \ args_deferred) args_deferred
    :=: ((shared \ Observed) \ code_deferred) code_deferred
    :=: ((shared \ Observed) \ first) first
    :=: ((shared \ Observed) \ after_first) after_first
    :=: ((shared \ Observed) \ changed) changed
    :=: ((shared \ Observed) \ second) second
    :=: ((shared \ Observed) \ after_second) after_second
    :=: ((shared \ Observed) \ current) current
end: main
main:
