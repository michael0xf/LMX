# Descriptor recipe, not an installer. Expand from canonical Entries.
C99PublicationPlan:
    char[]: source "catalog/*.lmx"
    char[]: eligible "Profiles.callable = 1; publication still requires review"
    char[]: ordinaryPath "Placements.package + backslash + Entries.symbol"
    char[]: directMethod "C99Direct_<entry-id>\\invoke"
    char[]: shimMethod "C99Calls_<component-id>\\<entry-id>"
    char[]: status "proposal_only; runtime NOT_RUN"
    @: exceptionColumns ("id"; "publicationPath")
