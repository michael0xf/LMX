fn: lm_compiler_mad_return_point (const: (@: body c.LmP0Structure); int: mi; @: field c.LmP0Field) int
    @@: mad_model_cell int (cast: (@@: int) (@ c.l2_mad_model))
    @@@: m_node_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_m_node))
    @: f c.LmP0Field
    int: model
    if: body = 0 || field = 0 || field\value = 0 || mad_model_cell[0] = 0 || mi < 0
        return: (cast: (int) (0))
    model: mad_model_cell[0][mi]
    if: model < 0
        return: (cast: (int) (0))
    if: c.lm_compiler_mad_is_return(field\value, model) != 0 || lm_compiler_t7_return_stmt(mi, (cast: (const: @: c.LmP0Node) (field\value))) != 0
        return: (cast: (int) (1))
    if: c.lm_compiler_frame_head(field\value, "fn") = 0 || field\value != m_node_cell[0][model]
        return: (cast: (int) (0))
    f: c.lm_compiler_next_active(body\first_field)
    while: f != 0
        if: c.lm_compiler_mad_is_return(f\value, model) != 0
            return: (cast: (int) (0))
        f: c.lm_compiler_next_active(f\next)
    ---
    if: c.lm_compiler_mad_trailer_return(mi, model) != 0
        return: (cast: (int) (0))
    return: (cast: (int) (1))
end: lm_compiler_mad_return_point

