predef: "l2src/lmx_walk.h.lm1"
predef: "l2src/lmx_call.h.lm1"
predef: "l2src/lmx_implements.h.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_chars.lm1"
predef: "l2src/lmx_scratch.lm1"
predef: "l2src/lmx_primitive.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<string.h>" "<limits.h>"

prototype:
    fn: lmx_walk_call0_dispatch (@: LmxArena arena; @: Lmx callable) int
    fn: lmx_walk_call_prim_dispatch (@: LmxArena arena; @: Lmx code; @: Lmx data; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    fn: lmx_walk_catch_count (@: LmxWalkFrame f; @: void cell; @: size_t out) int
    fn: lmx_walk_callable_addr (@: LmxArena arena; @: Lmx node) LmxEntry
    fn: lmx_walk_empty (@: LmxWalkFrame f; @: Lmx code; @: LmxWalkValue out) int
    fn: lmx_walk_data_holder (@: LmxWalkFrame f; @: void holder) @: void
    fn: lmx_walk_body (@: LmxWalkFrame f; @: Lmx body; size_t: first) int
    fn: lmx_walk_admit_against (@: LmxArena arena; @: Lmx value; @: Lmx model; @@: void out) int
    fn: lmx_walk_admit_op (@: LmxWalkFrame f; @: Lmx code; @: LmxWalkValue out) int
    fn: lmx_walk_model_operand (@: LmxWalkFrame f; @: void operand; @@: Lmx out) int
    fn: lmx_walk_admit_resolve (@: LmxArena arena; @: void raw; @@: void out_value) int
    fn: lmx_walk_immutable (@: LmxWalkFrame f; @: void p) int
    fn: lmx_walk_array_from (@: LmxWalkFrame f; @: void node; int: write; @@: VoidArray out) int
    fn: lmx_walk_array_elem_meta (int: type; @: int elem; @: size_t stride) int
    fn: lmx_walk_index (@: LmxWalkFrame f; @: void node; @: size_t out) int
end: prototype

# k.4 (author, next_core_tasks.md §3 item 8): dispatch is the word alone, non-null ->
# native, null -> walk; there is no separate "is this callable" question any more.
fn: lmx_walk_callable_addr (@: LmxArena arena; @: Lmx node) LmxEntry
    if: node = 0
        return: 0
return: node\native

# lmx_walk.lm1 - one activation of the graph interpreter.  The contract, its sources and
# the limits of this slice are in lmx_walk.h.lm1.

# ---- construction of body nodes --------------------------------------------------------

fn: lmx_walk_plain (@: LmxArena arena; @: Lmx parent; size_t: children) @: Lmx
    @: Lmx s 0
    if: arena = 0 || parent = 0
        return: 0
    s: lmx_struct_new_owned(parent, arena)
    if: s = 0
        return: 0
    if: children != 0U && lmx_arena_refs_open_owned(arena, s, children) != 0
        return: 0
return: s

# One record per role, made once: child k of the result is THE record of role k, and it
# is the address of that record that a frame node carries.
fn: lmx_walk_roles_open (@: LmxArena arena) @: Lmx
    @: Lmx roles 0
    @: LmxOp role 0
    int: k 1
    if: arena = 0
        return: 0
    roles: lmx_node_new_owned(arena)
    if: roles = 0 || lmx_arena_refs_open_owned(arena, roles, (cast: (size_t) (c.LMX_WALK_OP_COUNT * c.LMX_WALK_SOURCE_COUNT))) != 0
        return: 0
    while: k < c.LMX_WALK_OP_COUNT * c.LMX_WALK_SOURCE_COUNT
        role: lmx_op_new_owned(arena, k)
        if: role = 0 || lmx_arena_ref_store(roles, (cast: (size_t) k), (cast: (@: void) role)) != 0
            return: 0
        k: k + 1
    ---
    lmx_call_install_walk((cast: (LmxCallWalkFn) lmx_walk_call0_dispatch))
    lmx_call_install_prim_walk((cast: (LmxCallPrimWalkFn) lmx_walk_call_prim_dispatch))
return: roles

# Program-stable roles for op dispatch (call0 / thread): address identity of role records
# must match the body.  Bind once per program (selftest, L3 bind) before building
# bodies; call0 reads these.
@: Lmx lmx_walk_program_roles_g 0

fn: lmx_walk_program_bind (@: Lmx roles) void
    lmx_walk_program_roles_g: roles
    lmx_call_install_walk((cast: (LmxCallWalkFn) lmx_walk_call0_dispatch))
    lmx_call_install_prim_walk((cast: (LmxCallPrimWalkFn) lmx_walk_call_prim_dispatch))

fn: lmx_walk_program_roles () @: Lmx
return: lmx_walk_program_roles_g

# Descriptor-dispatch body for lmx_call0 (addr=0): ephemeral scratch, program-bound
# roles, run; return last expression as int (LmxWalkValue.number / int cell).  k.4: no
# plan, no prepare -- executing what was given is entry's whole job (lmx_walk_enter).
fn: lmx_walk_call0_dispatch (@: LmxArena arena; @: Lmx callable) int
    LmxArena: sa
    LmxPool: cells
    LmxScratch: scratch
    LmxWalkContext: ctx
    LmxWalkValue: wv
    @: Lmx roles 0
    int: st
    if: arena = 0 || callable = 0
        return: c.LMX_CALL_NOT_CALLABLE
    lmx_call_clear_walk_fail()
    roles: lmx_walk_program_roles()
    if: roles = 0
        roles: lmx_walk_roles_open(arena)
    ---
    if: roles = 0
        return: c.LMX_CALL_NOT_CALLABLE
    memset((cast: (@: void) (@ sa)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ scratch)), 0, c.sizeof(c.LmxScratch))
    memset((cast: (@: void) (@ ctx)), 0, c.sizeof(c.LmxWalkContext))
    memset((cast: (@: void) (@ wv)), 0, c.sizeof(c.LmxWalkValue))
    if: lmx_arena_open(@ sa) != 0
        return: c.LMX_CALL_NOT_CALLABLE
    if: lmx_scratch_open(@ scratch, @ sa, @ cells, 64U) != c.LMX_SCRATCH_OK
        lmx_arena_release(@ sa)
        return: c.LMX_CALL_NOT_CALLABLE
    ---
    ctx.arena: arena
    ctx.scratch: @ scratch
    ctx.roles: roles
    st: lmx_walk_run(@ ctx, callable, 0, 0U, @ wv)
    lmx_scratch_close(@ scratch)
    lmx_arena_release(@ sa)
    if: st != c.LMX_WALK_OK
        # G2/D-37: note_walk_fail X1s walker errors; throws decode to k on the turn channel.
        lmx_call_note_walk_fail(st)
        return: lmx_call_walk_fail_status()
    ---
    if: wv.present = 0
        return: 0
    ---
    if: wv.kind = c.LMX_WALK_VALUE_NUMBER && wv.type = c.LMX_TYPE_INT
        return: wv.number
    ---

return: 0

# Thin (arena, occurrence) entry for descriptor dispatch: ephemeral scratch,
# program-bound roles (or freshly opened when unbound), prepare + run.
fn: lmx_walk_frame (@: LmxArena arena; @: Lmx roles; @: Lmx parent; int: code; size_t: children) @: Lmx
    @: Lmx s 0
    @: void role 0
    if: roles = 0 || code <= c.LMX_WALK_OP_NONE || code >= c.LMX_WALK_OP_COUNT || children = 0U
        return: 0
    role: lmx_arena_ref_value(roles, (cast: (size_t) code))
    s: lmx_walk_plain(arena, parent, children)
    if: s = 0 || role = 0
        return: 0
    if: lmx_arena_ref_store(s, 0U, role) != 0
        return: 0
return: s

# Preserve a declaration's source role on its existing operation. Its operands,
# physical destination and execution opcode do not change. There is one shared
# record per role, not another record or wrapper on each materialized cell.
fn: lmx_walk_source_mark (@: Lmx roles; @: Lmx operation; int: source) int
    @: void head lmx_arena_ref_value(operation, 0U)
    size_t: k 1U
    while: k < roles\array.size
        if: head = lmx_arena_ref_value(roles, k)
            return: lmx_arena_ref_store(operation, 0U, lmx_arena_ref_value(roles, (cast: (size_t) (source * c.LMX_WALK_OP_COUNT)) + k % (cast: (size_t) c.LMX_WALK_OP_COUNT)))
        k: k + 1U
    ---
return: c.LMX_WALK_INVALID

fn: lmx_walk_store_size (@: LmxArena arena; @: Lmx code; size_t: slot; size_t: value) int
    @: void cell lmx_size_new_owned(arena)
    if: cell = 0
        return: c.LMX_WALK_NOMEM
    if: lmx_size_store_known(cell, value) != 0 || lmx_arena_ref_store(code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
return: c.LMX_WALK_OK

fn: lmx_walk_store_int (@: LmxArena arena; @: Lmx code; size_t: slot; int: value) int
    @: void cell lmx_int_new_owned(arena)
    if: cell = 0
        return: c.LMX_WALK_NOMEM
    if: lmx_int_store_known(cell, value) != 0 || lmx_arena_ref_store(code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
return: c.LMX_WALK_OK

fn: lmx_walk_store_charptr (@: LmxArena arena; @: Lmx code; size_t: slot; @: char value) int
    @: void cell lmx_charptr_new_owned(arena)
    if: cell = 0
        return: c.LMX_WALK_NOMEM
    if: lmx_charptr_store_known(cell, value) != 0 || lmx_arena_ref_store(code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
return: c.LMX_WALK_OK


fn: lmx_walk_store_char (@: LmxArena arena; @: Lmx code; size_t: slot; int: value) int
    @: void cell 0
    if: arena = 0 || code = 0
        return: c.LMX_WALK_INVALID
    if: lmx_chars_init(arena) != 0 && lmx_arena_find(arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR) = 0
        return: c.LMX_WALK_NOMEM
    ---
    cell: lmx_char_cell(arena, value)
    if: cell = 0 || lmx_arena_ref_store(code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
return: c.LMX_WALK_OK

fn: lmx_walk_store_unsigned (@: LmxArena arena; @: Lmx code; size_t: slot; unsigned: value) int
    @: void cell lmx_unsigned_new_owned(arena)
    if: cell = 0
        return: c.LMX_WALK_NOMEM
    if: lmx_unsigned_store_known(cell, value) != 0 || lmx_arena_ref_store(code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
return: c.LMX_WALK_OK

fn: lmx_walk_store_ulong (@: LmxArena arena; @: Lmx code; size_t: slot; ulong: value) int
    @: void cell lmx_ulong_new_owned(arena)
    if: cell = 0
        return: c.LMX_WALK_NOMEM
    if: lmx_ulong_store_known(cell, value) != 0 || lmx_arena_ref_store(code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
return: c.LMX_WALK_OK

# A value's C type is its CELL's, asked of the arena -- never a tag on the value (-167 A).
# Returns the LMX_TYPE_* for a numeric primitive cell, or 0 when the address is not one
# (pointer cell, Structure, unknown). Destination-passing temps (KIND_NONE) are not cells.
fn: lmx_walk_numeric_type (@: LmxArena arena; @: void cell) int
    int: kind
    int: ty
    if: arena = 0 || cell = 0
        return: 0
    kind: lmx_domain_kind(arena, cell)
    if: kind != c.LMX_KIND_PRIMITIVE
        return: 0
    ty: lmx_domain_type(arena, cell)
    if: ty = c.LMX_TYPE_INT || ty = c.LMX_TYPE_CHAR || ty = c.LMX_TYPE_SIZE_T || ty = c.LMX_TYPE_UNSIGNED || ty = c.LMX_TYPE_ULONG || ty = c.LMX_TYPE_UNSIGNED_CHAR
        return: ty
return: 0

# Load a numeric arena cell into the widest working width. INVALID when not numeric.
fn: lmx_walk_load_numeric (@: LmxArena arena; @: void cell; @: size_t out) int
    int: ty
    if: out = 0
        return: c.LMX_WALK_INVALID
    ty: lmx_walk_numeric_type(arena, cell)
    if: ty = 0
        return: c.LMX_WALK_INVALID
    if: ty = c.LMX_TYPE_INT
        \out: (cast: (size_t) lmx_int_value_known(cell))
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_CHAR
        \out: (cast: (size_t) lmx_char_value_known(cell))
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_UNSIGNED_CHAR
        \out: (cast: (size_t) lmx_uchar_value_known(cell))
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_SIZE_T
        \out: lmx_size_value_known(cell)
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_UNSIGNED
        \out: (cast: (size_t) lmx_unsigned_value_known(cell))
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_ULONG
        \out: (cast: (size_t) lmx_ulong_value_known(cell))
        return: c.LMX_WALK_OK
return: c.LMX_WALK_INVALID

# Value operand of PUT/SET: an arena numeric cell, or a destination-passing temp
# (unclassified address -- today's computed int in the caller's dest / spare).
fn: lmx_walk_store_numeric_into (@: LmxArena arena; @: void cell; size_t: value) int
    int: ty lmx_walk_numeric_type(arena, cell)
    if: ty = 0
        return: c.LMX_WALK_INVALID
    if: ty = c.LMX_TYPE_CHAR
        return: c.LMX_WALK_INVALID
    if: ty = c.LMX_TYPE_INT
        if: lmx_int_store_known(cell, (cast: (int) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_SIZE_T
        if: lmx_size_store_known(cell, (cast: (size_t) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_UNSIGNED
        if: lmx_unsigned_store_known(cell, (cast: (unsigned) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_ULONG
        if: lmx_ulong_store_known(cell, (cast: (ulong) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_UNSIGNED_CHAR
        if: lmx_uchar_store_known(cell, (cast: (unsigned) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
return: c.LMX_WALK_INVALID

# A raw, UNCLASSIFIED numeric store into `cell`, keyed by a TYPE THE CALLER ALREADY
# KNOWS (not re-derived from `cell` itself, unlike lmx_walk_store_numeric_into's own
# lmx_walk_numeric_type(arena, cell) gate) -- for a destination that is not necessarily
# an arena-classified cell at all (a dynamic caller's own local, a CALL trampoline's raw
# dest). Shared by lmx_walk_call_prim_dispatch (G-call, -194 к.4) and lmx_walk_call's
# own addr = 0 branch (K-RET, -194 к.5b) -- both copy a walked callee's numeric result
# out of whatever reference lmx_walk_activate handed back and into the caller's own
# destination, the same way the native path already does by construction.
# The caller proves this destination mutable; unlike a numeric operand it is not
# an interned literal, including when its declared type is CHAR.
fn: lmx_walk_store_numeric_raw (@: void cell; int: ty; size_t: value) int
    if: cell = 0 || ty = 0
        return: c.LMX_WALK_INVALID
    if: ty = c.LMX_TYPE_CHAR
        if: lmx_char_store_known(cell, (cast: (int) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_INT
        if: lmx_int_store_known(cell, (cast: (int) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_SIZE_T
        if: lmx_size_store_known(cell, value) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_UNSIGNED
        if: lmx_unsigned_store_known(cell, (cast: (unsigned) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_ULONG
        if: lmx_ulong_store_known(cell, (cast: (ulong) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_UNSIGNED_CHAR
        if: lmx_uchar_store_known(cell, (cast: (unsigned) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
return: c.LMX_WALK_INVALID

# Typed temporary values. A value is never identified by the address of its
# temporary storage, and a held reference is never loaded for a second time.
fn: lmx_walk_value_clear (@: LmxWalkValue value) void
    memset((cast: (@: void) value), 0, c.sizeof(c.LmxWalkValue))

fn: lmx_walk_value_ref (@: LmxWalkValue out; int: ty; @: void ref) int
    lmx_walk_value_clear(out)
    out\present: 1
    out\kind: c.LMX_WALK_VALUE_REFERENCE
    out\type: ty
    out\ref: ref
return: c.LMX_WALK_OK

# The ordinary ABI uses value storage for every present argument.  A pointer's
# storage contains its held address, including null; it is not that address.
fn: lmx_walk_value_storage (@: LmxWalkValue value) @: void
    if: value = 0 || value\present = 0
        return: 0
    if: value\kind = c.LMX_WALK_VALUE_REFERENCE
        return: (cast: (@: void) (@ value\ref))
    if: value\type = c.LMX_TYPE_INT
        return: (cast: (@: void) (@ value\number))
    if: value\type = c.LMX_TYPE_SIZE_T
        return: (cast: (@: void) (@ value\wide))
    if: value\type = c.LMX_TYPE_UNSIGNED
        return: (cast: (@: void) (@ value\natural))
    if: value\type = c.LMX_TYPE_ULONG
        return: (cast: (@: void) (@ value\longnum))
    if: value\type = c.LMX_TYPE_CHAR || value\type = c.LMX_TYPE_UNSIGNED_CHAR
        return: (cast: (@: void) (@ value\byte))
return: 0

fn: lmx_walk_value_num (@: LmxWalkValue out; int: ty; size_t: number) int
    lmx_walk_value_clear(out)
    out\present: 1
    out\kind: c.LMX_WALK_VALUE_NUMBER
    out\type: ty
return: lmx_walk_store_numeric_raw(lmx_walk_value_storage(out), ty, number)

fn: lmx_walk_value_number (@: LmxWalkValue value; @: size_t number; @: int ty) int
    if: value = 0 || value\present = 0 || value\kind != c.LMX_WALK_VALUE_NUMBER
        return: c.LMX_WALK_INVALID
    \ty: value\type
    if: value\type = c.LMX_TYPE_INT
        \number: (cast: (size_t) value\number)
    else:
        if: value\type = c.LMX_TYPE_SIZE_T
            \number: value\wide
        else:
            if: value\type = c.LMX_TYPE_UNSIGNED
                \number: (cast: (size_t) value\natural)
            else:
                if: value\type = c.LMX_TYPE_ULONG
                    \number: (cast: (size_t) value\longnum)
                else:
                    if: value\type = c.LMX_TYPE_CHAR
                        \number: (cast: (size_t) lmx_char_value_known((cast: (@: void) (@ value\byte))))
                    else:
                        if: value\type != c.LMX_TYPE_UNSIGNED_CHAR
                            return: c.LMX_WALK_INVALID
                        \number: (cast: (size_t) lmx_uchar_value_known((cast: (@: void) (@ value\byte))))
                    ---
                ---
            ---
        ---
    ---
return: c.LMX_WALK_OK

# Load according to an already resolved storage contract. In particular a pointer
# payload is opaque even when it happens to point at another pointer-value cell.
fn: lmx_walk_value_load (@: void storage; int: ty; @: LmxWalkValue out) int
    LmxWalkValue: value
    if: storage = 0
        lmx_walk_value_clear(out)
        return: c.LMX_WALK_OK
    if: ty >= c.LMX_TYPE_POINTER_BASE || ty = c.LMX_TYPE_LMX || ty = c.LMX_TYPE_DESC || ty = c.LMX_TYPE_CHAR_PTR
        return: lmx_walk_value_ref(out, ty, lmx_pointer_value_known(storage))
    lmx_walk_value_clear(@ value)
    value.present: 1
    value.kind: c.LMX_WALK_VALUE_NUMBER
    value.type: ty
    if: ty = c.LMX_TYPE_INT
        value.number: lmx_int_value_known(storage)
    else:
        if: ty = c.LMX_TYPE_SIZE_T
            value.wide: lmx_size_value_known(storage)
        else:
            if: ty = c.LMX_TYPE_UNSIGNED
                value.natural: lmx_unsigned_value_known(storage)
            else:
                if: ty = c.LMX_TYPE_ULONG
                    value.longnum: lmx_ulong_value_known(storage)
                else:
                    if: ty != c.LMX_TYPE_CHAR && ty != c.LMX_TYPE_UNSIGNED_CHAR
                        return: c.LMX_WALK_INVALID
                    memcpy((cast: (@: void) (@ value.byte)), storage, c.sizeof(c.char))
                ---
            ---
        ---
    ---
    memcpy((cast: (@: void) out), (cast: (@: void) (@ value)), c.sizeof(c.LmxWalkValue))
return: c.LMX_WALK_OK

# This is a producer boundary: classify the graph value's storage once, then carry
# its source type and loaded payload. Consumers never inspect a held pointee.
fn: lmx_walk_value_cell (@: LmxArena arena; @: void cell; @: LmxWalkValue out) int
    int: kind
    if: cell = 0
        return: lmx_walk_value_ref(out, c.LMX_TYPE_LMX, 0)
    kind: lmx_domain_kind(arena, cell)
    if: kind = c.LMX_KIND_STRUCT
        return: lmx_walk_value_ref(out, c.LMX_TYPE_LMX, cell)
    if: kind = c.LMX_KIND_ARRAY
        return: lmx_walk_value_ref(out, c.LMX_TYPE_DESC, cell)
    if: kind != c.LMX_KIND_PRIMITIVE
        return: c.LMX_WALK_INVALID
return: lmx_walk_value_load(cell, lmx_domain_type(arena, cell), out)

fn: lmx_walk_witness_type (@: LmxArena arena; @: void witness) int
    int: kind lmx_domain_kind(arena, witness)
    if: kind = c.LMX_KIND_STRUCT
        return: c.LMX_TYPE_LMX
    if: kind = c.LMX_KIND_ARRAY
        return: c.LMX_TYPE_DESC
return: lmx_domain_type(arena, witness)

# True when cell is a typed pointer primitive (POINTER_BASE+).
fn: lmx_walk_is_pointer_cell (@: LmxArena arena; @: void cell) int
    int: ty
    if: arena = 0 || cell = 0
        return: 0
    if: lmx_domain_kind(arena, cell) != c.LMX_KIND_PRIMITIVE
        return: 0
    ty: lmx_domain_type(arena, cell)
    if: ty < c.LMX_TYPE_POINTER_BASE
        return: 0
return: 1

# Publish a numeric working value into its existing physical cell.
fn: lmx_walk_store_slot (@: LmxArena arena; @@: void slot; size_t: value) int
    @: void cell 0
    int: ty
    if: arena = 0 || slot = 0 || slot[0] = 0
        return: c.LMX_WALK_INVALID
    cell: slot[0]
    ty: lmx_walk_numeric_type(arena, cell)
    if: ty = 0
        return: c.LMX_WALK_INVALID
    if: ty = c.LMX_TYPE_CHAR
        if: lmx_char_store_known(cell, (cast: (int) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
return: lmx_walk_store_numeric_into(arena, cell, value)


# Count a physical domain lookup made by ordinary graph traversal.
fn: lmx_walk_kind (@: LmxWalkFrame f; @: void p) int
    f\context\classified: f\context\classified + 1U
return: lmx_range_classify(f\arena, p)

# Which of the program's roles `head` IS: the address compared with the role records, in
# the order of the discriminators.  Nothing is dereferenced and nothing is classified.
fn: lmx_walk_role (@: LmxWalkFrame f; @: void head) int
    @@: void records 0
    int: k 1
    if: f = 0 || head = 0 || f\roles = 0 || f\roles\array.data = 0
        return: c.LMX_WALK_OP_NONE
    records: (cast: (@@: void) f\roles\array.data)
    while: (cast: (size_t) k) < f\roles\array.size
        if: records[k] = head
            return: k % c.LMX_WALK_OP_COUNT
        k: k + 1
    ---
return: c.LMX_WALK_OP_NONE

# The role of an OPERAND: a node at a position its parent's role fixes.  It is read as a
# node without asking the arena (see the header).  UNKNOWN when its child[0] is an op
# record of a role this program does not have; NONE when it is no frame node at all.
fn: lmx_walk_head (@: LmxWalkFrame f; @: Lmx s) int
    @: void head lmx_arena_ref_value(s, 0U)
    int: k
    k: lmx_walk_role(f, head)
    if: k != c.LMX_WALK_OP_NONE
        return: k
    if: head != 0 && lmx_walk_kind(f, head) = c.LMX_DOMAIN_KIND_OP
        return: c.LMX_WALK_OP_UNKNOWN
return: c.LMX_WALK_OP_NONE

# Classify an operand's existing role. Typed evaluation snapshots its value
# before ordinary publication; a held reference remains opaque thereafter.
fn: lmx_walk_node (@: LmxWalkFrame f; @: void node) int
    int: k
    if: f = 0 || node = 0
        return: c.LMX_WALK_OP_NONE
    k: lmx_walk_role(f, node)
    if: k != c.LMX_WALK_OP_NONE
        return: k
    # The same arena-kind rule applies to an operand and a body field. A bare
    # symbolic OP, Array or primitive is not an Lmx header.
return: lmx_walk_op(f, node)

# The role of a FIELD OF A BODY, where own cells and frame nodes stand mixed: NONE for
# anything that is not a frame node (an own cell, a plain Structure, a nested callable's
# M); UNKNOWN for a step of a role this program does not have -- refused, never skipped.
# This is the one place the arena's index is asked, once, whether the field is a
# Structure; a bare role record is recognised before that, by its address.
fn: lmx_walk_op (@: LmxWalkFrame f; @: void code) int
    int: kind
    int: k
    if: f = 0 || code = 0
        return: c.LMX_WALK_OP_NONE
    k: lmx_walk_role(f, code)
    if: k != c.LMX_WALK_OP_NONE
        return: k
    kind: lmx_walk_kind(f, code)
    if: kind = c.LMX_KIND_STRUCT
        return: lmx_walk_head(f, (cast: (@: Lmx) code))
    if: kind = c.LMX_DOMAIN_KIND_OP
        return: c.LMX_WALK_OP_UNKNOWN
return: c.LMX_WALK_OP_NONE

# Whether `node` is a bare role record rather than a Structure with a role in child[0].
fn: lmx_walk_bare (@: LmxWalkFrame f; @: void node) int
return: (cast: (int) (lmx_walk_role(f, node) != c.LMX_WALK_OP_NONE))

# The slot a node names by its two operands at `first`: the Structure that holds the
# field, by reference, and the number of the slot inside it.  k.4 (no cached plan, no
# membership set -- next_core_tasks.md §3 item 9): the holder must classify as a Structure
# and the index must be within its own `array.size`, asked here, every time, unconditionally --
# there is no separate counting/prepare pass left to have asked it once.  A translator
# mistake that names an arbitrary operator node or literal fails this same check.
# A compact OWN/AT operand is itself a Structure whose child1 stores the output;
# both implicit and explicit coordinates resolve that same physical place.
# `write` refuses a holder in the exact qualified
# immutable profile (lmx_walk_immutable); a read (`write = 0`) never does.
fn: lmx_walk_slot_place (@: LmxWalkFrame f; @: Lmx code; size_t: first; int: write; @@: Lmx out_holder; @: size_t out_index; @@@: void out_slot) int
    @: void holder 0
    size_t: index
    int: op
    int: holder_op
    \out_holder: 0
    \out_index: 0U
    \out_slot: 0
    if: f = 0 || code = 0
        return: c.LMX_WALK_INVALID
    op: lmx_walk_node(f, (cast: (@: void) code))
    # A compact OWN/AT is the actual output operand. Its child1 is the
    # descriptor-reference place, not another storage object or body field.
    if: first = 1U && code\array.size = 2U && (op = c.LMX_WALK_OP_OWN || op = c.LMX_WALK_OP_AT)
        holder: (cast: (@: void) code)
        index: 1U
    else:
        holder: lmx_arena_ref_value(code, first)
        index: lmx_size_value_known(lmx_arena_ref_value(code, first + 1U))
    ---
    # -188 k.3c: when holder is the running activation's code, use its data (f\node).
    # K-OT2 (-194 к.5): holder = 0 is no longer refused here outright -- it is now a
    # valid sentinel lmx_walk_data_holder resolves to this activation's own data;
    # the classify-as-Structure check just below still refuses it when that
    # resolution has nothing to give (f\node = 0).
    holder: lmx_walk_data_holder(f, holder)
    if: lmx_walk_kind(f, holder) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_INVALID
    ---
    # -177 c4 / D-54 X1: a fixed holder must be a plain Structure reference, not an OP node.
    # Mutant: accept DEREF as holder -> silent write into the node RED.
    holder_op: lmx_walk_node(f, holder)
    if: holder_op > c.LMX_WALK_OP_NONE && ((holder_op != c.LMX_WALK_OP_OWN && holder_op != c.LMX_WALK_OP_AT) || (cast: (@: Lmx) holder)\array.size != 2U || index != 1U)
        return: c.LMX_WALK_INVALID
    ---
    if: write != 0 && lmx_walk_immutable(f, holder) != 0
        return: c.LMX_WALK_INVALID
    ---
    if: index >= (cast: (@: Lmx) holder)\array.size
        return: c.LMX_WALK_INVALID
    \out_holder: (cast: (@: Lmx) holder)
    \out_index: index
    \out_slot: lmx_arena_ref_cell(\out_holder, index)
    if: \out_slot = 0
        return: c.LMX_WALK_INVALID
return: c.LMX_WALK_OK

fn: lmx_walk_slot (@: LmxWalkFrame f; @: Lmx code; size_t: first; int: write) @@: void
    @: Lmx holder 0
    size_t: index 0U
    @@: void slot 0
    if: lmx_walk_slot_place(f, code, first, write, @ holder, @ index, @ slot) != c.LMX_WALK_OK
        return: 0
return: slot

# Replay only the accessed owned edge chain in the existing unequal-occurrence
# ABI. Foreign/ancestor holders stay themselves. A missing corresponding edge
# is not permission to write the original occurrence. This creates no graph
# or mapping registry; ordinary execution already has code == node.
fn: lmx_walk_owned_holder (@: LmxWalkFrame f; @: Lmx holder) @: Lmx
    @: Lmx parent holder\parent
    @: Lmx mapped 0
    @: void child 0
    size_t: index 0U
    if: holder = f\code
        return: f\node
    if: parent = 0
        return: holder
    mapped: lmx_walk_owned_holder(f, parent)
    if: mapped = parent
        return: holder
    if: mapped = 0
        return: 0
    while: index < parent\array.size && lmx_arena_ref_value(parent, index) != (cast: (@: void) holder)
        index: index + 1U
    ---
    if: index >= parent\array.size || index >= mapped\array.size
        return: 0
    child: lmx_arena_ref_value(mapped, index)
    if: lmx_walk_kind(f, child) != c.LMX_KIND_STRUCT
        return: 0
return: (cast: (@: Lmx) child)

# A zero holder names the selected occurrence. Fixed holders inside the
# original executing body follow its actual child edges in the selected
# occurrence; evaluated OF/OWN_OF references do not use this projection.
fn: lmx_walk_data_holder (@: LmxWalkFrame f; @: void holder) @: void
    if: f = 0
        return: holder
    ---
    if: holder = 0
        if: f\node = 0
            return: 0
        ---
        return: (cast: (@: void) f\node)
    ---
    if: f\code = 0 || f\node = 0 || f\code = f\node
        return: holder
    ---
    if: lmx_walk_kind(f, holder) != c.LMX_KIND_STRUCT
        return: holder
    ---
return: (cast: (@: void) lmx_walk_owned_holder(f, (cast: (@: Lmx) holder)))

# §7b: the slot an own-field node names, with its holder and index.  OWN [own, holder, slot] names its holder by
# reference, under lmx_walk_slot's rules (a Structure, never an op node; `write` refuses the exact immutable
# profile).  OWN_OF [own_of, holder-expr, slot] and SET_OF [set_of, holder-expr, slot, value] evaluate theirs -- a
# nested body's Structure -- under the same rules.  Any other node is INVALID.
fn: lmx_walk_work_cell (@: LmxWalkFrame f; @: void node; int: write; @@: Lmx holder; @: size_t index; @@@: void slot) int
    @: Lmx code 0
    LmxWalkValue: value
    int: op
    int: status
    if: f = 0 || node = 0 || holder = 0 || index = 0 || slot = 0
        return: c.LMX_WALK_INVALID
    \holder: 0
    \index: 0U
    \slot: 0
    op: lmx_walk_node(f, node)
    code: (cast: (@: Lmx) node)
    if: op = c.LMX_WALK_OP_OWN
        return: lmx_walk_slot_place(f, code, 1U, write, holder, index, slot)
    ---
    if: (op != c.LMX_WALK_OP_OWN_OF && op != c.LMX_WALK_OP_SET_OF) || code\array.size < 3U
        return: c.LMX_WALK_INVALID
    status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), @ value)
    if: status != c.LMX_WALK_OK
        return: status
    if: value.present = 0 || value.kind != c.LMX_WALK_VALUE_REFERENCE || value.ref = 0 || lmx_walk_kind(f, (value.ref)) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_INVALID
    if: write != 0 && lmx_walk_immutable(f, (value.ref)) != 0
        return: c.LMX_WALK_INVALID
    \index: lmx_size_value_known(lmx_arena_ref_value(code, 2U))
    if: \index >= (cast: (@: Lmx) value.ref)\array.size
        return: c.LMX_WALK_INVALID
    \holder: (cast: (@: Lmx) value.ref)
    \slot: lmx_arena_ref_cell((cast: (@: Lmx) value.ref), \index)
    if: \slot = 0
        return: c.LMX_WALK_INVALID
return: c.LMX_WALK_OK

# §7b: the working table's row of `slot`, or 0.
fn: lmx_walk_work_find (@: LmxWalkFrame f; @@: void slot) @: LmxWalkWork
    @: LmxWalkWork e 0
    if: f = 0 || slot = 0
        return: 0
    e: f\work
    while: e != 0
        if: e\slot = slot
            return: e
        e: e\next
    ---
return: 0

# §7b: one row of the working table, loaded now from `slot` (holder's child `index`) and clean, linked after the last
# row; a slot that already has one keeps it.  A number is kind 1 (its value and type), a pointer cell kind 2 (the
# reference it holds), a Structure slot kind 3 (the Structure, or 0 while empty).  The row is taken from the scratch
# store after the activation's mark and is gone with its rewind.
fn: lmx_walk_work_make (@: LmxWalkFrame f; @: Lmx holder; size_t: index; @@: void slot) int
    @: void room 0
    @: LmxWalkWork e 0
    @: LmxWalkWork last 0
    size_t: wv 0U
    if: f = 0 || f\context = 0 || f\context\scratch = 0 || slot = 0
        return: c.LMX_WALK_INVALID
    if: lmx_walk_work_find(f, slot) != 0
        return: c.LMX_WALK_OK
    if: lmx_scratch_take(f\context\scratch, c.sizeof(c.LmxWalkWork), @ room) != c.LMX_SCRATCH_OK || room = 0
        return: c.LMX_WALK_NOMEM
    e: (cast: (@: LmxWalkWork) room)
    e\holder: holder
    e\index: index
    e\slot: slot
    e\ref: 0
    e\num: 0U
    e\ty: c.LMX_TYPE_LMX
    e\dirty: 0
    e\next: 0
    e\kind: 3
    if: slot[0] != 0 && lmx_walk_is_pointer_cell(f\arena, slot[0]) != 0
        e\kind: 2
        e\ty: lmx_domain_type(f\arena, slot[0])
        e\ref: lmx_pointer_value_known(slot[0])
    ---
    if: slot[0] != 0 && e\kind = 3 && (lmx_walk_kind(f, slot[0]) = c.LMX_KIND_STRUCT || lmx_walk_kind(f, slot[0]) = c.LMX_KIND_ARRAY)
        e\ref: slot[0]
        if: lmx_walk_kind(f, slot[0]) = c.LMX_KIND_ARRAY
            e\ty: c.LMX_TYPE_DESC
        ---
    ---
    if: slot[0] != 0 && e\kind = 3 && e\ref = 0
        e\ty: lmx_walk_numeric_type(f\arena, slot[0])
        if: e\ty = 0 || lmx_walk_load_numeric(f\arena, slot[0], @ wv) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        e\kind: 1
        e\num: wv
    ---
    if: f\work = 0
        f\work: e
    else:
        last: f\work
        while: last\next != 0
            last: last\next
        ---
        last\next: e
    ---
    f\nwork: f\nwork + 1U
return: c.LMX_WALK_OK

# §7b: whether `holder` belongs to this activation -- its data, its code, or a body lexically inside them (up the
# parent links).  Another occurrence's Structure does not: an own node naming it gets no row.
fn: lmx_walk_holder_here (@: LmxWalkFrame f; @: Lmx holder) int
    @: Lmx h holder
    while: h != 0
        if: h = f\node || h = f\code
            return: 1
        h: h\parent
    ---
return: 0

# §7b: THE ENTRY LOAD (Lingvamyxa spec 21.5), derived from the code (lmx_walk_load_code): node, and below it every
# Structure it owns -- a child whose parent is node, an operand or a nested body; a referenced callee, holder, datum or
# table is not node's own and is not entered.  An OWN whose holder is this activation's, an OWN_OF and a SET_OF (a
# SET names its field by its OWN child) get their field's row.
fn: lmx_walk_load_node (@: LmxWalkFrame f; @: Lmx node) int
    @: Lmx holder 0
    @@: void slot 0
    @: void v 0
    size_t: index 0U
    size_t: i 0U
    int: op
    int: status
    if: f = 0 || node = 0
        return: c.LMX_WALK_INVALID
    op: lmx_walk_node(f, (cast: (@: void) node))
    if: op = c.LMX_WALK_OP_OWN || op = c.LMX_WALK_OP_OWN_OF || op = c.LMX_WALK_OP_SET_OF
        status: lmx_walk_work_cell(f, (cast: (@: void) node), 0, @ holder, @ index, @ slot)
        if: status != c.LMX_WALK_OK
            return: status
        if: op != c.LMX_WALK_OP_OWN || lmx_walk_holder_here(f, holder) != 0
            status: lmx_walk_work_make(f, holder, index, slot)
            if: status != c.LMX_WALK_OK
                return: status
        ---
    ---
    while: i < node\array.size
        v: lmx_arena_ref_value(node, i)
        if: v != 0 && lmx_walk_kind(f, v) = c.LMX_KIND_STRUCT && (cast: (@: Lmx) v)\parent = node
            status: lmx_walk_load_node(f, (cast: (@: Lmx) v))
            if: status != c.LMX_WALK_OK
                return: status
        ---
        i: i + 1U
    ---
return: c.LMX_WALK_OK

# §7b: entry load starts at each owned application in this occurrence's slots.
# A copied occurrence has copied applications and lexical parents; bare role
# records remain shared. Field cells are not entered by lmx_walk_load_node.
fn: lmx_walk_load_code (@: LmxWalkFrame f) int
    @: void v 0
    size_t: i 0U
    int: status
    if: f = 0 || f\code = 0
        return: c.LMX_WALK_INVALID
    while: i < f\code\array.size
        v: lmx_arena_ref_value(f\code, i)
        if: v != 0 && lmx_walk_kind(f, v) = c.LMX_KIND_STRUCT && lmx_walk_op(f, v) != c.LMX_WALK_OP_NONE
            status: lmx_walk_load_node(f, (cast: (@: Lmx) v))
            if: status != c.LMX_WALK_OK
                return: status
        ---
        i: i + 1U
    ---
return: c.LMX_WALK_OK

# §7b: THE PUBLICATION (book §12, §14; Lingvamyxa spec 21.6) -- every dirty row, in row order (the order the entry
# load made them), written into its slot: a number by its cell's type, a pointer into its pointer cell, a Structure as
# the slot's reference; then unmarked.  A clean row is never written.  A failed store is INVALID (X1); the rows after
# it stay dirty.
fn: lmx_walk_publish (@: LmxWalkFrame f) int
    @: LmxWalkWork e 0
    if: f = 0
        return: c.LMX_WALK_OK
    e: f\work
    while: e != 0
        if: e\dirty != 0
            if: e\kind = 1 && lmx_walk_store_slot(f\arena, e\slot, e\num) != c.LMX_WALK_OK
                return: c.LMX_WALK_INVALID
            if: e\kind = 2 && lmx_pointer_store_known(e\slot[0], e\ref) != 0
                return: c.LMX_WALK_INVALID
            if: e\kind = 3 && lmx_arena_ref_store(e\holder, e\index, e\ref) != 0
                return: c.LMX_WALK_INVALID
            e\dirty: 0
        ---
        e: e\next
    ---
return: c.LMX_WALK_OK

# SET_ARG changes only this activation's input value; caller storage and lexical
# fallback cells remain unchanged. All input places are activation-owned and stable.
# Allocate input places at activation entry, outside every nested-call scratch
# mark. Their values may be loaded lazily from the per-ARG declared witness.
fn: lmx_walk_args_open (@: LmxWalkFrame f) int
    @: void room 0
    @@: void mine 0
    size_t: i 0U
    if: f\nargs = 0U
        return: c.LMX_WALK_OK
    if: f\args = 0
        return: c.LMX_WALK_INVALID
    if: lmx_scratch_take(f\context\scratch, f\nargs * c.sizeof(c.LmxWalkValue), @ room) != c.LMX_SCRATCH_OK
        return: c.LMX_WALK_NOMEM
    f\argown: (cast: (@: LmxWalkValue) room)
    memset(room, 0, f\nargs * c.sizeof(c.LmxWalkValue))
    if: lmx_scratch_take(f\context\scratch, f\nargs * c.sizeof(@: void), @ room) != c.LMX_SCRATCH_OK
        return: c.LMX_WALK_NOMEM
    mine: (cast: (@@: void) room)
    while: i < f\nargs
        mine[i]: f\args[i]
        i: i + 1U
    ---
    f\args: mine
return: c.LMX_WALK_OK

# The per-input address remains stable through calls, rebinding and address-of.
fn: lmx_walk_arg_place (@: LmxWalkFrame f; size_t: k; int: ty; @: LmxWalkPlace out) int
    int: status
    if: f = 0 || k >= f\nargs || f\args = 0 || f\argown = 0
        return: c.LMX_WALK_INVALID
    if: f\argown[k].present = 0
        if: f\args[k] != 0
            status: lmx_walk_value_load(f\args[k], ty, f\argown + k)
        else:
            # SET_ARG may introduce the activation's binding after an absent
            # caller input. This storage is filled by the receiving act below.
            if: ty >= c.LMX_TYPE_POINTER_BASE || ty = c.LMX_TYPE_LMX || ty = c.LMX_TYPE_DESC || ty = c.LMX_TYPE_CHAR_PTR
                status: lmx_walk_value_ref(f\argown + k, ty, 0)
            else:
                status: lmx_walk_value_num(f\argown + k, ty, 0U)
            ---
        ---
        if: status != c.LMX_WALK_OK
            return: status
        f\args[k]: lmx_walk_value_storage(f\argown + k)
    ---
    out\address: f\args[k]
    out\type: ty
    out\descriptor: 0
return: c.LMX_WALK_OK

fn: lmx_walk_value_store (@: LmxWalkPlace place; @: LmxWalkValue value) int
    size_t: number 0U
    int: ty 0
    if: value\present = 0 || place\address = 0 || place\descriptor != 0
        return: c.LMX_WALK_INVALID
    if: place\type >= c.LMX_TYPE_POINTER_BASE || place\type = c.LMX_TYPE_LMX || place\type = c.LMX_TYPE_DESC || place\type = c.LMX_TYPE_CHAR_PTR
        if: value\kind != c.LMX_WALK_VALUE_REFERENCE
            return: c.LMX_WALK_INVALID
        return: lmx_pointer_store_known(place\address, value\ref)
    ---
    if: lmx_walk_value_number(value, @ number, @ ty) != c.LMX_WALK_OK || ty != place\type
        return: c.LMX_WALK_INVALID
return: lmx_walk_store_numeric_raw(place\address, ty, number)

# One physical-place resolution for reads, explicit stores and ADDRESS.
# ELEM selects backing storage here, before any char value or pointer is loaded.
fn: lmx_walk_place (@: LmxWalkFrame f; @: void node; int: write; @: LmxWalkPlace out) int
    LmxWalkValue: holder
    @: Lmx code (cast: (@: Lmx) node)
    @: Lmx view_model 0
    @: VoidArray array 0
    @@: void slot 0
    @: void cell 0
    @: void root 0
    size_t: index 0U
    size_t: stride 0U
    int: type 0
    int: kind 0
    int: op 0
    int: status
    memset((cast: (@: void) out), 0, c.sizeof(c.LmxWalkPlace))
    op: lmx_walk_node(f, node)
    if: op = c.LMX_WALK_OP_ARG
        index: lmx_size_value_known(lmx_arena_ref_value(code, 1U))
        type: lmx_walk_witness_type(f\arena, lmx_arena_ref_value(code, 3U))
        if: index >= f\nargs || f\args = 0
            return: c.LMX_WALK_INVALID
        if: f\args[index] = 0
            if: lmx_arena_ref_value(code, 2U) = 0
                return: c.LMX_WALK_INVALID
            status: lmx_walk_eval(f, lmx_arena_ref_value(code, 2U), @ holder)
            if: status != c.LMX_WALK_OK
                return: status
            status: lmx_walk_arg_place(f, index, type, out)
            if: status != c.LMX_WALK_OK
                return: status
            return: lmx_walk_value_store(out, @ holder)
        ---
        return: lmx_walk_arg_place(f, index, type, out)
    if: op = c.LMX_WALK_OP_DEREF
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), @ holder)
        if: status != c.LMX_WALK_OK
            return: status
        if: holder.present = 0 || holder.kind != c.LMX_WALK_VALUE_REFERENCE || holder.ref = 0
            return: c.LMX_WALK_INVALID
        out\address: holder.ref
        out\type: lmx_walk_witness_type(f\arena, lmx_arena_ref_value(code, 2U))
        out\descriptor: (cast: (int) (out\type = c.LMX_TYPE_LMX || out\type = c.LMX_TYPE_DESC))
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_ELEM || op = c.LMX_WALK_OP_ELEMPUT
        status: lmx_walk_array_from(f, lmx_arena_ref_value(code, 1U), write, @ array)
        if: status != c.LMX_WALK_OK
            return: status
        status: lmx_walk_index(f, lmx_arena_ref_value(code, 2U), @ index)
        if: status != c.LMX_WALK_OK
            return: status
        if: index >= array\size || array\data = 0
            return: c.LMX_WALK_INVALID
        if: lmx_walk_array_elem_meta(lmx_domain_type(f\arena, (cast: (@: void) array)), @ type, @ stride) = 0
            return: c.LMX_WALK_INVALID
        out\address: (cast: (@: void) ((cast: (@: char) array\data) + index * stride))
        out\type: type
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_AT || op = c.LMX_WALK_OP_OWN
        slot: lmx_walk_slot(f, code, 1U, write)
    else:
        if: op != c.LMX_WALK_OP_OF && op != c.LMX_WALK_OP_OWN_OF && op != c.LMX_WALK_OP_PUT_OF && op != c.LMX_WALK_OP_SET_OF
            return: c.LMX_WALK_INVALID
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), @ holder)
        if: status != c.LMX_WALK_OK
            return: status
        if: holder.present = 0 || holder.kind != c.LMX_WALK_VALUE_REFERENCE || holder.ref = 0
            return: c.LMX_WALK_INVALID
        root: holder.ref
        if: lmx_walk_kind(f, root) != c.LMX_KIND_STRUCT || (write != 0 && lmx_walk_immutable(f, root) != 0)
            return: c.LMX_WALK_INVALID
        index: lmx_size_value_known(lmx_arena_ref_value(code, 2U))
        # The optional model occupies child3 on OF and child4 on PUT_OF.
        kind: 3
        if: op = c.LMX_WALK_OP_PUT_OF
            kind: 4
        if: (op = c.LMX_WALK_OP_OF || op = c.LMX_WALK_OP_PUT_OF) && code\array.size > (cast: (size_t) kind) && lmx_arena_ref_value(code, (cast: (size_t) kind)) != 0
            status: lmx_walk_model_operand(f, lmx_arena_ref_value(code, (cast: (size_t) kind)), @ view_model)
            if: status != c.LMX_WALK_OK
                return: status
            if: lmx_implements_slot(f\arena, (cast: (@: Lmx) root), view_model, index, @ index) != 0
                return: c.LMX_WALK_INVALID
            ---
        ---
        slot: lmx_arena_ref_cell((cast: (@: Lmx) root), index)
    ---
    if: slot = 0
        return: c.LMX_WALK_INVALID
    cell: slot[0]
    kind: lmx_domain_kind(f\arena, cell)
    if: cell = 0 || kind = c.LMX_KIND_STRUCT || kind = c.LMX_KIND_ARRAY
        out\address: cell
        out\type: c.LMX_TYPE_LMX
        if: kind = c.LMX_KIND_ARRAY
            out\type: c.LMX_TYPE_DESC
        out\descriptor: 1
        return: c.LMX_WALK_OK
    ---
    out\address: cell
    out\type: lmx_domain_type(f\arena, cell)
return: c.LMX_WALK_OK

fn: lmx_walk_arg_write (@: LmxWalkFrame f; size_t: k; int: ty; @: LmxWalkValue value; @: LmxWalkValue out) int
    LmxWalkPlace: place
    int: status lmx_walk_arg_place(f, k, ty, @ place)
    if: status != c.LMX_WALK_OK
        return: status
    status: lmx_walk_value_store(@ place, value)
    if: status != c.LMX_WALK_OK
        return: status
return: lmx_walk_value_load((place.address), ty, out)
fn: lmx_walk_array_from (@: LmxWalkFrame f; @: void node; int: write; @@: VoidArray out) int
    LmxWalkValue: value
    int: status
    \out: 0
    status: lmx_walk_eval(f, node, @ value)
    if: status != c.LMX_WALK_OK
        return: status
    if: value.present = 0 || value.kind != c.LMX_WALK_VALUE_REFERENCE
        return: c.LMX_WALK_INVALID
    if: value.ref = 0 || lmx_walk_kind(f, (value.ref)) != c.LMX_KIND_ARRAY
        return: c.LMX_WALK_INVALID
    if: write != 0 && lmx_walk_immutable(f, (value.ref)) != 0
        return: c.LMX_WALK_INVALID
    \out: (cast: (@: VoidArray) value.ref)
return: c.LMX_WALK_OK
fn: lmx_walk_array_elem_meta (int: aty; @: int out_ety; @: size_t out_stride) int
    ulong: ulong_probe 0U
    if: out_ety = 0 || out_stride = 0
        return: 0
    if: aty = c.LMX_TYPE_ARRAY_OF_CHAR
        \out_ety: c.LMX_TYPE_CHAR
        \out_stride: c.sizeof(c.char)
        return: 1
    if: aty = c.LMX_TYPE_ARRAY_OF_UNSIGNED_CHAR
        \out_ety: c.LMX_TYPE_UNSIGNED_CHAR
        \out_stride: c.sizeof(c.char)
        return: 1
    if: aty = c.LMX_TYPE_ARRAY_OF_INT
        \out_ety: c.LMX_TYPE_INT
        \out_stride: c.sizeof(c.int)
        return: 1
    if: aty = c.LMX_TYPE_ARRAY_OF_SIZE_T
        \out_ety: c.LMX_TYPE_SIZE_T
        \out_stride: c.sizeof(c.size_t)
        return: 1
    if: aty = c.LMX_TYPE_ARRAY_OF_ULONG
        \out_ety: c.LMX_TYPE_ULONG
        \out_stride: c.sizeof(ulong_probe)
        return: 1
    if: aty = c.LMX_TYPE_ARRAY_OF_LMX
        \out_ety: c.LMX_TYPE_LMX
        \out_stride: c.sizeof(@: void)
        return: 1
    if: aty = c.LMX_TYPE_ARRAY_OF_DESC
        \out_ety: c.LMX_TYPE_DESC
        \out_stride: c.sizeof(@: void)
        return: 1
    if: aty >= c.LMX_TYPE_ARRAY_OF_POINTER_BASE
        \out_ety: c.LMX_TYPE_POINTER_BASE + (aty - c.LMX_TYPE_ARRAY_OF_POINTER_BASE)
        \out_stride: c.sizeof(@: void)
        return: 1
return: 0

# Exact physical receiver-profile test for QUALIFIED IMMUTABILITY.  Ownership and sealing
# are deliberately irrelevant: an owner-local address in this profile is immutable, while a
# foreign or sealed address of any other profile is not made immutable by accident.  Asked
# at the point of every write (k.4: OWN/SET target via lmx_walk_slot, PUT_REF/PUT_OF at
# their own sites, PRIM through its owner) -- there is no separate prepare pass any more.
fn: lmx_walk_immutable (@: LmxWalkFrame f; @: void p) int
    if: p = 0
        return: 0
    if: f\context\immutable_profile = 0
        return: 0
    f\context\classified: f\context\classified + 1U
return: (cast: (int) (lmx_range_profile(f\arena, p) = f\context\immutable_profile))

# ---- execution -------------------------------------------------------------------------

# The external callable ABI carries declared-width value storage for arguments.
# A typed evaluation result is converted once here: scalar into the supplied
# destination, held reference through out, and absent/void through out = 0.
fn: lmx_walk_call_prim_dispatch (@: LmxArena arena; @: Lmx code; @: Lmx data; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    LmxArena: sa
    LmxPool: cells
    LmxScratch: scratch
    LmxWalkContext: ctx
    @: Lmx roles 0
    LmxWalkValue: result
    int: st
    int: rty 0
    size_t: wv 0U
    if: out = 0
        return: c.LMX_CALL_NOT_CALLABLE
    \out: 0
    if: arena = 0 || code = 0 || data = 0
        return: c.LMX_CALL_NOT_CALLABLE
    lmx_call_clear_walk_fail()
    roles: lmx_walk_program_roles()
    if: roles = 0
        roles: lmx_walk_roles_open(arena)
    ---
    if: roles = 0
        return: c.LMX_CALL_NOT_CALLABLE
    memset((cast: (@: void) (@ sa)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ scratch)), 0, c.sizeof(c.LmxScratch))
    memset((cast: (@: void) (@ ctx)), 0, c.sizeof(c.LmxWalkContext))
    if: lmx_arena_open(@ sa) != 0
        return: c.LMX_CALL_NOT_CALLABLE
    if: lmx_scratch_open(@ scratch, @ sa, @ cells, 64U) != c.LMX_SCRATCH_OK
        lmx_arena_release(@ sa)
        return: c.LMX_CALL_NOT_CALLABLE
    ---
    ctx.arena: arena
    ctx.scratch: @ scratch
    ctx.roles: roles
    st: lmx_walk_activate(@ ctx, code, data, refs, nargs, @ result)
    lmx_scratch_close(@ scratch)
    lmx_arena_release(@ sa)
    if: st = c.LMX_WALK_STOPPED
        return: 0
    if: st != c.LMX_WALK_OK
        # G2/D-37: note_walk_fail X1s walker errors; throws decode to k on the turn channel.
        if: st >= c.LMX_WALK_THROWN
            \out: result.ref
        lmx_call_note_walk_fail(st)
        return: lmx_call_walk_fail_status()
    ---
    if: result.present = 0
        return: 0
    if: result.kind = c.LMX_WALK_VALUE_REFERENCE
        \out: result.ref
        return: 0
    # A statement-position call may discard a numeric body-last value. The
    # typed value is already detached from activation scratch; no int box is
    # fabricated for a caller that supplied no result destination.
    if: dest = 0
        return: 0
    if: lmx_walk_value_number(@ result, @ wv, @ rty) != c.LMX_WALK_OK
        return: c.LMX_CALL_NOT_CALLABLE
    if: lmx_walk_store_numeric_raw(dest, rty, wv) != c.LMX_WALK_OK
        return: c.LMX_CALL_NOT_CALLABLE
    \out: dest
return: 0
fn: lmx_walk_empty (@: LmxWalkFrame f; @: Lmx code; @: LmxWalkValue out) int
    @: Lmx value lmx_node_new_owned(f\arena)
    if: value = 0
        return: c.LMX_WALK_NOMEM
return: lmx_walk_value_ref(out, c.LMX_TYPE_LMX, (cast: (@: void) value))
fn: lmx_walk_catch_scan (@: LmxWalkFrame f; @: Lmx rows; size_t: base; size_t: n; int: status) int
    @: void kin_cell 0
    @: void pad 0
    @: void kout_cell 0
    size_t: i 0U
    size_t: k 0U
    size_t: k_in 0U
    size_t: k_out 0U
    int: hit 0
    if: f = 0 || status < c.LMX_WALK_THROWN || rows = 0 || n = 0U
        return: status
    if: base + 3U * n > rows\array.size
        return: c.LMX_WALK_INVALID
    ---
    k: (cast: (size_t) (status - c.LMX_WALK_THROWN))
    while: i < n && hit = 0
        kin_cell: lmx_arena_ref_value(rows, base + i * 3U)
        pad: lmx_arena_ref_value(rows, base + i * 3U + 1U)
        kout_cell: lmx_arena_ref_value(rows, base + i * 3U + 2U)
        if: kin_cell = 0 || kout_cell = 0
            return: c.LMX_WALK_INVALID
        if: lmx_walk_numeric_type(f\arena, kin_cell) != c.LMX_TYPE_SIZE_T || lmx_walk_numeric_type(f\arena, kout_cell) != c.LMX_TYPE_SIZE_T
            return: c.LMX_WALK_INVALID
        ---
        if: pad != 0 && lmx_walk_kind(f, pad) != c.LMX_KIND_STRUCT
            return: c.LMX_WALK_INVALID
        ---
        k_in: lmx_size_value_known(kin_cell)
        if: k_in = k
            k_out: lmx_size_value_known(kout_cell)
            hit: 1
        ---
        i: i + 1U
    ---
    if: hit = 0
        return: status
    if: pad = 0
        return: c.LMX_WALK_THROWN + (cast: (int) k_out)
    ---
    f\landing: (cast: (@: Lmx) pad)
return: status

# D1: how many catch rows a frame carries, from its catch slot's value -- a size cell, or 0 for none.
fn: lmx_walk_catch_count (@: LmxWalkFrame f; @: void cell; @: size_t out) int
    \out: 0U
    if: cell = 0
        return: c.LMX_WALK_OK
    if: lmx_walk_numeric_type(f\arena, cell) != c.LMX_TYPE_SIZE_T
        return: c.LMX_WALK_INVALID
    \out: lmx_size_value_known(cell)
return: c.LMX_WALK_OK

# Bind pad parameters from f\payload, then walk the handler body (the pad's last child).
# A numeric parameter is a typed store; a type mismatch is an invariant (the translator
# already knows both types). A Structure parameter is a pointer cell: store the argument
# reference and nothing else. Admission is not this function. The translator emits PRIM
# admit as the handler's own first statement, with that site's catch table, so a NO is
# THROWN+k_out of that site rather than a constant in the kernel.
# Landing is cleared before the handler so a throw inside it can name an outer pad.
fn: lmx_walk_catch_bind (@: LmxWalkFrame f) int
    @: Lmx pad 0
    @: Lmx payload 0
    @: Lmx handler 0
    @: void cell 0
    @: void arg 0
    size_t: pcount 0U
    size_t: i 0U
    LmxWalkValue: value
    LmxWalkPlace: place
    int: status c.LMX_WALK_OK
    if: f = 0 || f\landing = 0 || f\landing\array.size < 2U
        return: c.LMX_WALK_INVALID
    ---
    pad: f\landing
    pcount: pad\array.size - 2U
    payload: (cast: (@: Lmx) f\payload)
    if: pcount != 0U && (f\payload = 0 || lmx_walk_kind(f, f\payload) != c.LMX_KIND_STRUCT || payload\array.size < pcount)
        c.fprintf(l1_stderr(), "lmx: invariant: catch payload\n")
        c.abort()
    ---
    while: i < pcount && status = c.LMX_WALK_OK
        cell: lmx_arena_ref_value(pad, i + 1U)
        arg: lmx_arena_ref_value(payload, i)
        status: lmx_walk_value_cell(f\arena, arg, @ value)
        if: status = c.LMX_WALK_OK
            place.address: cell
            place.type: lmx_domain_type(f\arena, cell)
            place.descriptor: 0
            status: lmx_walk_value_store(@ place, @ value)
        ---
        i: i + 1U
    ---
    if: status != c.LMX_WALK_OK
        return: status
    handler: lmx_arena_ref_struct(pad, (pad\array.size) - 1U)
    f\landing: 0
    f\payload: 0
    if: handler = 0
        return: c.LMX_WALK_INVALID
    return: lmx_walk_body(f, handler, 0U)

# Evaluate actuals once into typed temporaries, then expose their declared-width
# value storage. Missing operands remain absent; present null references have boxes.
fn: lmx_walk_actuals (@: LmxWalkFrame f; @: Lmx code; size_t: first; size_t: n; @: Lmx contract; @@@: void refs_out) int
    @: void room 0
    @: void child 0
    @: LmxWalkValue values 0
    @@: void refs 0
    size_t: i 0U
    size_t: at 0U
    int: status c.LMX_WALK_OK
    int: ty
    \refs_out: 0
    if: contract = 0 || contract\array.size != n
        return: c.LMX_WALK_INVALID
    if: n = 0U
        return: c.LMX_WALK_OK
    if: lmx_scratch_take(f\context\scratch, n * c.sizeof(c.LmxWalkValue), @ room) != c.LMX_SCRATCH_OK
        return: c.LMX_WALK_NOMEM
    values: (cast: (@: LmxWalkValue) room)
    memset(room, 0, n * c.sizeof(c.LmxWalkValue))
    if: lmx_scratch_take(f\context\scratch, n * c.sizeof(@: void), @ room) != c.LMX_SCRATCH_OK
        return: c.LMX_WALK_NOMEM
    refs: (cast: (@@: void) room)
    memset(room, 0, n * c.sizeof(@: void))
    # Operands are evaluated in the order they stand. A NAMED operand hands its
    # payload's value to the formal whose coordinate it carries; any other one
    # to the formal of its own position. No coordinate is supplied twice: an
    # empty operand supplies its coordinate too, so the test is the mark left
    # in the references and not the presence of a value.
    while: i < n && status = c.LMX_WALK_OK
        child: lmx_arena_ref_value(code, first + i)
        at: i
        if: child != 0 && lmx_walk_op(f, child) = c.LMX_WALK_OP_NAMED
            if: (cast: (@: Lmx) child)\array.size != 3U || lmx_walk_load_numeric(f\arena, lmx_arena_ref_value((cast: (@: Lmx) child), 1U), @ at) != c.LMX_WALK_OK || at >= n
                status: c.LMX_WALK_INVALID
                at: i
            else:
                child: lmx_arena_ref_value((cast: (@: Lmx) child), 2U)
            ---
        ---
        if: status = c.LMX_WALK_OK && refs[at] != 0
            status: c.LMX_WALK_INVALID
        refs[at]: (cast: (@: void) (values + at))
        if: status = c.LMX_WALK_OK && child != 0
            if: lmx_walk_op(f, child) = c.LMX_WALK_OP_NONE
                status: lmx_walk_value_cell(f\arena, child, values + at)
            else:
                status: lmx_walk_eval(f, child, values + at)
            ---
        ---
        if: status = c.LMX_WALK_OK && values[at].present != 0
            ty: lmx_walk_witness_type(f\arena, lmx_arena_ref_value(contract, at))
            if: ty >= c.LMX_TYPE_POINTER_BASE || ty = c.LMX_TYPE_LMX || ty = c.LMX_TYPE_DESC || ty = c.LMX_TYPE_CHAR_PTR
                if: values[at].kind != c.LMX_WALK_VALUE_REFERENCE
                    status: c.LMX_WALK_INVALID
                ---
            else:
                if: values[at].kind != c.LMX_WALK_VALUE_NUMBER || values[at].type != ty
                    status: c.LMX_WALK_INVALID
                ---
            ---
        ---
        i: i + 1U
    ---
    i: 0U
    while: i < n
        refs[i]: lmx_walk_value_storage(values + i)
        i: i + 1U
    ---
    \refs_out: refs
return: status

# This is the only raw native result boundary. The declared result witness
# distinguishes void from present null without looking at a returned pointee.
fn: lmx_walk_native_result (@: LmxWalkFrame f; @: void witness; @: void raw; @: LmxWalkValue out) int
    int: ty
    lmx_walk_value_clear(out)
    if: witness = 0
        return: c.LMX_WALK_OK
    ty: lmx_walk_witness_type(f\arena, witness)
    if: ty >= c.LMX_TYPE_POINTER_BASE || ty = c.LMX_TYPE_LMX || ty = c.LMX_TYPE_DESC || ty = c.LMX_TYPE_CHAR_PTR
        return: lmx_walk_value_ref(out, ty, raw)
    if: raw = 0
        return: c.LMX_WALK_INVALID
return: lmx_walk_value_load(raw, ty, out)

fn: lmx_walk_native_dest (@: LmxWalkFrame f; @: void witness; @: LmxWalkValue temp) @: void
    int: ty
    lmx_walk_value_clear(temp)
    if: witness = 0
        return: 0
    ty: lmx_walk_witness_type(f\arena, witness)
    if: ty >= c.LMX_TYPE_POINTER_BASE || ty = c.LMX_TYPE_LMX || ty = c.LMX_TYPE_DESC || ty = c.LMX_TYPE_CHAR_PTR
        lmx_walk_value_ref(temp, ty, 0)
    else:
        if: lmx_walk_value_num(temp, ty, 0U) != c.LMX_WALK_OK
            return: 0
        ---
    ---
return: lmx_walk_value_storage(temp)

fn: lmx_walk_call (@: LmxWalkFrame f; @: Lmx code; @: LmxWalkValue out) int
    LmxScratchMark: mark
    LmxWalkValue: selected
    LmxWalkValue: temp
    @: Lmx callee 0
    @: Lmx data 0
    @: Lmx contract 0
    @: Lmx inputs 0
    @: Lmx returns 0
    @: void rtype 0
    @: void raw 0
    @: void dest 0
    @@: void refs 0
    LmxEntry: addr 0
    LmxPrimitiveEntry: entry 0
    size_t: n 0U
    size_t: catch_n 0U
    size_t: arg_at 5U
    int: status c.LMX_WALK_OK
    int: said 0
    int: called 0
    int: short_ok 0
    int: exec (cast: (int) (lmx_walk_op(f, (cast: (@: void) code)) = c.LMX_WALK_OP_EXEC))
    @: void third 0
    lmx_walk_value_clear(out)
    # A short direct call is only the callee and its inputs, at any arity. A long
    # frame still has an empty data slot, or a contract at slot 3. Kernel tests
    # keep that frame.
    if: exec = 0 && code\array.size >= 2U
        if: code\array.size < 5U
            short_ok: 1
        else:
            if: lmx_arena_ref_value(code, 2U) != 0
                third: lmx_arena_ref_value(code, 3U)
                if: third = 0 || lmx_walk_kind(f, third) != c.LMX_KIND_STRUCT || lmx_walk_op(f, third) != c.LMX_WALK_OP_NONE || (cast: (@: Lmx) third)\array.size != 2U
                    short_ok: 1
                ---
            ---
        ---
    ---
    if: short_ok != 0
        n: code\array.size - 2U
        catch_n: 0U
        arg_at: 2U
        callee: lmx_arena_ref_struct(code, 1U)
        data: callee
        if: callee = 0 || callee\array.size = 0U
            return: c.LMX_WALK_INVALID
        addr: lmx_walk_callable_addr(f\arena, callee)
        contract: callee
    else:
        if: code\array.size < 5U || lmx_walk_catch_count(f, lmx_arena_ref_value(code, 4U), @ catch_n) != c.LMX_WALK_OK || code\array.size < 5U + 3U * catch_n
            return: c.LMX_WALK_INVALID
        n: code\array.size - 5U - 3U * catch_n
        # An old call stores its contract at slot 3 and evaluates its data at slot 2.
        # A long direct call uses the callee's own input/result parts.
        if: lmx_arena_ref_value(code, 3U) != 0
            contract: lmx_arena_ref_struct(code, 3U)
        ---
        if: lmx_arena_ref_value(code, 2U) != 0
            status: lmx_walk_eval(f, lmx_arena_ref_value(code, 2U), @ selected)
            if: status = c.LMX_WALK_OK
                if: selected.present = 0 || selected.kind != c.LMX_WALK_VALUE_REFERENCE || selected.ref = 0 || lmx_walk_kind(f, (selected.ref)) != c.LMX_KIND_STRUCT
                    status: c.LMX_WALK_INVALID
                else:
                    data: (cast: (@: Lmx) selected.ref)
                    callee: data
                    if: exec = 0
                        callee: lmx_arena_ref_struct(code, 1U)
                    ---
                    if: callee = 0
                        status: c.LMX_WALK_INVALID
                    else:
                        addr: lmx_walk_callable_addr(f\arena, callee)
                    ---
                ---
            ---
        else:
            if: exec != 0
                status: c.LMX_WALK_INVALID
            else:
                callee: lmx_arena_ref_struct(code, 1U)
                data: callee
                if: callee = 0 || callee\array.size = 0U
                    status: c.LMX_WALK_INVALID
                else:
                    addr: lmx_walk_callable_addr(f\arena, callee)
                    if: contract = 0
                        contract: callee
                    ---
                ---
            ---
        ---
    ---
    if: status != c.LMX_WALK_OK || contract = 0
        return: c.LMX_WALK_INVALID
    inputs: lmx_arena_ref_struct(contract, 0U)
    returns: lmx_arena_ref_struct(contract, 1U)
    if: inputs = 0 || returns = 0 || inputs\array.size != n
        return: c.LMX_WALK_INVALID
    if: returns\array.size != 0U
        rtype: lmx_arena_ref_value(returns, 0U)
    if: lmx_scratch_mark(f\context\scratch, @ mark) != c.LMX_SCRATCH_OK
        return: c.LMX_WALK_INVALID
    if: status = c.LMX_WALK_OK
        status: lmx_walk_actuals(f, code, arg_at, n, inputs, @ refs)
    if: status = c.LMX_WALK_OK
        status: lmx_walk_publish(f)
    if: status = c.LMX_WALK_OK
        called: 1
        if: addr != 0
            entry: (cast: (LmxPrimitiveEntry) addr)
            dest: lmx_walk_native_dest(f, rtype, @ temp)
            said: entry((cast: (@: void) data), refs, n, dest, @ raw)
            if: lmx_msg_poll_escape() != 0
                status: c.LMX_WALK_STOPPED
            else:
                if: said != 0
                    status: c.LMX_WALK_THROWN + said
                    lmx_walk_value_ref(out, c.LMX_TYPE_LMX, raw)
                else:
                    status: lmx_walk_native_result(f, rtype, raw, out)
            ---
        else:
            status: lmx_walk_activate(f\context, callee, data, refs, n, out)
        ---
    ---
    # The receiving CALL contract owns result presence in both dispatch modes.
    # A void body may execute valued statements, but does not return their value.
    if: status = c.LMX_WALK_OK && rtype = 0
        lmx_walk_value_clear(out)
    # The callee's own throw: its payload is this call's, and this call's catch
    # rows map its number.  A throw raised while an operand was evaluated is the
    # operand's: the callee did not run, the payload and the number are already
    # the ones the throwing operation set, and they leave unchanged.
    if: status >= c.LMX_WALK_THROWN && called != 0
        f\payload: out\ref
        if: catch_n != 0U
            status: lmx_walk_catch_scan(f, code, arg_at + n, catch_n, status)
        ---
    ---
    if: lmx_scratch_rewind(f\context\scratch, @ mark) != c.LMX_SCRATCH_OK && status = c.LMX_WALK_OK
        status: c.LMX_WALK_INVALID
return: status
fn: lmx_walk_prim (@: LmxWalkFrame f; @: Lmx code; @: LmxWalkValue out) int
    LmxScratchMark: mark
    LmxWalkValue: temp
    @: LmxPrimitive record 0
    @: Lmx returns 0
    @: Lmx inputs 0
    @: void target 0
    @: void witness 0
    @: void raw 0
    @: void dest 0
    @@: void refs 0
    size_t: n 0U
    size_t: catch_n 0U
    int: status c.LMX_WALK_OK
    int: said 0
    int: called 0
    lmx_walk_value_clear(out)
    if: code\array.size < 3U
        return: c.LMX_WALK_INVALID
    target: lmx_arena_ref_value(code, 1U)
    if: target = 0 || lmx_range_classify(f\arena, target) != c.LMX_DOMAIN_KIND_PRIMITIVE
        return: c.LMX_WALK_INVALID
    record: (cast: (@: LmxPrimitive) target)
    if: record\fn = 0 || record\signature = 0 || lmx_walk_immutable(f, record\owner) != 0
        return: c.LMX_WALK_INVALID
    if: lmx_walk_catch_count(f, lmx_arena_ref_value(code, 2U), @ catch_n) != c.LMX_WALK_OK || code\array.size < 3U + 3U * catch_n
        return: c.LMX_WALK_INVALID
    n: code\array.size - 3U - 3U * catch_n
    inputs: lmx_arena_ref_struct(record\signature, 0U)
    returns: lmx_arena_ref_struct(record\signature, 1U)
    if: returns != 0 && returns\array.size != 0U
        witness: lmx_arena_ref_value(returns, 0U)
    if: lmx_scratch_mark(f\context\scratch, @ mark) != c.LMX_SCRATCH_OK
        return: c.LMX_WALK_INVALID
    status: lmx_walk_actuals(f, code, 3U, n, inputs, @ refs)
    if: status = c.LMX_WALK_OK && lmx_walk_node(f, (cast: (@: void) code)) = c.LMX_WALK_OP_PRIM_PUB
        status: lmx_walk_publish(f)
    if: status = c.LMX_WALK_OK
        called: 1
        dest: lmx_walk_native_dest(f, witness, @ temp)
        said: record\fn(record\owner, refs, n, dest, @ raw)
        if: lmx_msg_poll_escape() != 0
            status: c.LMX_WALK_STOPPED
        else:
            if: said = c.LMX_PRIMITIVE_THROW_MERGE
                status: c.LMX_WALK_THROWN + 1
            else:
                if: said = c.LMX_PRIMITIVE_THROW_IMPLEMENTS
                    status: c.LMX_WALK_THROWN + 2
                else:
                    if: said != c.LMX_PRIMITIVE_OK
                        status: c.LMX_WALK_PRIMITIVE
                    else:
                        status: lmx_walk_native_result(f, witness, raw, out)
                ---
            ---
        ---
    ---
    # As in lmx_walk_call: only the primitive's own throw takes its payload and
    # its catch rows; an operand's throw leaves as the operand set it.
    if: status >= c.LMX_WALK_THROWN && called != 0
        f\payload: raw
        lmx_walk_value_ref(out, c.LMX_TYPE_LMX, raw)
        if: catch_n != 0U
            status: lmx_walk_catch_scan(f, code, 3U + n, catch_n, status)
        ---
    ---
    if: lmx_scratch_rewind(f\context\scratch, @ mark) != c.LMX_SCRATCH_OK && status = c.LMX_WALK_OK
        status: c.LMX_WALK_INVALID
return: status
fn: lmx_walk_index (@: LmxWalkFrame f; @: void node; @: size_t out) int
    LmxWalkValue: value
    int: status lmx_walk_eval(f, node, @ value)
    if: status != c.LMX_WALK_OK
        return: status
    if: value.present = 0 || value.kind != c.LMX_WALK_VALUE_NUMBER || value.type != c.LMX_TYPE_SIZE_T
        return: c.LMX_WALK_INVALID
    \out: value.wide
return: c.LMX_WALK_OK
fn: lmx_walk_eval (@: LmxWalkFrame f; @: void node; @: LmxWalkValue out) int
    LmxWalkValue: value
    LmxWalkValue: other
    LmxWalkPlace: place
    @: Lmx code (cast: (@: Lmx) node)
    @: LmxWalkWork work 0
    @: Lmx wholder 0
    @@: void slot 0
    @: void root 0
    @: void want 0
    @: void leaf 0
    @: VoidArray array 0
    size_t: index 0U
    size_t: ua 0U
    size_t: ub 0U
    size_t: wv 0U
    int: a 0
    int: b 0
    int: op
    int: going 1
    int: status c.LMX_WALK_OK
    if: f = 0 || node = 0 || out = 0
        return: c.LMX_WALK_INVALID
    lmx_walk_value_clear(out)
    op: lmx_walk_node(f, node)
    if: op = c.LMX_WALK_OP_UNKNOWN || op = c.LMX_WALK_OP_SOURCE_MACHINE
        return: c.LMX_WALK_UNSUPPORTED
    # Retained source is not a request to execute directive arguments. In
    # particular, symbolic leaves and machine expressions below it are inert.
    if: op = c.LMX_WALK_OP_SOURCE_INERT || op = c.LMX_WALK_OP_ELSE
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_NONE
        if: lmx_walk_kind(f, node) != c.LMX_KIND_STRUCT && lmx_walk_kind(f, node) != c.LMX_KIND_ARRAY
            return: c.LMX_WALK_INVALID
        return: lmx_walk_value_cell(f\arena, node, out)
    if: lmx_walk_bare(f, node) != 0
        if: op != c.LMX_WALK_OP_RET
            return: c.LMX_WALK_INVALID
        f\returned: 1
        memcpy((cast: (@: void) out), (cast: (@: void) (@ f\result)), c.sizeof(c.LmxWalkValue))
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_LIT
        root: lmx_arena_ref_value(code, 1U)
        if: root = 0
            return: c.LMX_WALK_INVALID
        return: lmx_walk_value_cell(f\arena, root, out)
    if: op = c.LMX_WALK_OP_OWN || op = c.LMX_WALK_OP_OWN_OF
        status: lmx_walk_work_cell(f, node, 0, @ wholder, @ index, @ slot)
        if: status != c.LMX_WALK_OK
            return: status
        work: lmx_walk_work_find(f, slot)
        if: work = 0
            return: c.LMX_WALK_INVALID
        if: work\kind = 1
            return: lmx_walk_value_num(out, work\ty, work\num)
        return: lmx_walk_value_ref(out, work\ty, work\ref)
    if: op = c.LMX_WALK_OP_ARG
        index: lmx_size_value_known(lmx_arena_ref_value(code, 1U))
        if: index >= f\nargs || f\args = 0
            return: c.LMX_WALK_INVALID
        if: f\args[index] = 0
            if: lmx_arena_ref_value(code, 2U) = 0
                return: c.LMX_WALK_OK
            ---
        ---
        status: lmx_walk_place(f, node, 0, @ place)
        if: status != c.LMX_WALK_OK
            return: status
        return: lmx_walk_value_load((place.address), (place.type), out)
    if: op = c.LMX_WALK_OP_SET_ARG
        index: lmx_size_value_known(lmx_arena_ref_value(code, 1U))
        a: lmx_walk_witness_type(f\arena, lmx_arena_ref_value(code, 3U))
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 2U), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        return: lmx_walk_arg_write(f, index, a, @ value, out)
    if: op = c.LMX_WALK_OP_SELF
        if: f\node = 0
            return: c.LMX_WALK_INVALID
        return: lmx_walk_value_ref(out, c.LMX_TYPE_LMX, lmx_walk_data_holder(f, 0))
    if: op = c.LMX_WALK_OP_NODE
        if: f\node = 0 || f\node\parent = 0
            return: c.LMX_WALK_INVALID
        return: lmx_walk_value_ref(out, c.LMX_TYPE_LMX, (cast: (@: void) f\node\parent))
    if: op = c.LMX_WALK_OP_ADDRESS
        status: lmx_walk_place(f, lmx_arena_ref_value(code, 1U), 0, @ place)
        if: status != c.LMX_WALK_OK
            return: status
        a: lmx_walk_witness_type(f\arena, lmx_arena_ref_value(code, 2U))
        return: lmx_walk_value_ref(out, a, (place.address))
    if: op = c.LMX_WALK_OP_AT || op = c.LMX_WALK_OP_OF || op = c.LMX_WALK_OP_DEREF || op = c.LMX_WALK_OP_ELEM
        status: lmx_walk_place(f, node, 0, @ place)
        if: status != c.LMX_WALK_OK
            return: status
        if: place.descriptor != 0
            return: lmx_walk_value_ref(out, (place.type), (place.address))
        return: lmx_walk_value_load((place.address), (place.type), out)
    if: op = c.LMX_WALK_OP_PUT || op = c.LMX_WALK_OP_PUT_OF || op = c.LMX_WALK_OP_ELEMPUT
        # Select the physical place exactly once, then receive the value.
        # Fixed AT has no source evaluation; OF/DEREF/ELEM retain target-first
        # ordering. No write occurs before the complete RHS succeeds.
        if: op = c.LMX_WALK_OP_PUT
            status: lmx_walk_place(f, lmx_arena_ref_value(code, 1U), 1, @ place)
        else:
            status: lmx_walk_place(f, node, 1, @ place)
        ---
        if: status != c.LMX_WALK_OK
            return: status
        index: 3U
        if: op = c.LMX_WALK_OP_PUT
            index: 2U
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, index), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        status: lmx_walk_value_store(@ place, @ value)
        if: status != c.LMX_WALK_OK
            return: status
        return: lmx_walk_value_load((place.address), (place.type), out)
    if: op = c.LMX_WALK_OP_PUT_REF
        status: lmx_walk_slot_place(f, code, 1U, 1, @ wholder, @ index, @ slot)
        if: status != c.LMX_WALK_OK
            return: status
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 3U), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        if: value.present = 0 || value.kind != c.LMX_WALK_VALUE_REFERENCE
            return: c.LMX_WALK_INVALID
        if: slot = 0 || lmx_walk_is_pointer_cell(f\arena, slot[0]) != 0
            return: c.LMX_WALK_INVALID
        if: value.ref != 0 && lmx_walk_kind(f, (value.ref)) != c.LMX_KIND_STRUCT
            return: c.LMX_WALK_INVALID
        slot[0]: value.ref
        memcpy((cast: (@: void) out), (cast: (@: void) (@ value)), c.sizeof(c.LmxWalkValue))
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_SET || op = c.LMX_WALK_OP_SET_OF
        if: op = c.LMX_WALK_OP_SET
            status: lmx_walk_eval(f, lmx_arena_ref_value(code, 2U), @ value)
            if: status != c.LMX_WALK_OK
                return: status
            status: lmx_walk_work_cell(f, lmx_arena_ref_value(code, 1U), 1, @ wholder, @ index, @ slot)
        else:
            status: lmx_walk_work_cell(f, node, 1, @ wholder, @ index, @ slot)
            if: status != c.LMX_WALK_OK
                return: status
            status: lmx_walk_eval(f, lmx_arena_ref_value(code, 3U), @ value)
        ---
        if: status != c.LMX_WALK_OK
            return: status
        work: lmx_walk_work_find(f, slot)
        if: work = 0 || value.present = 0
            return: c.LMX_WALK_INVALID
        if: work\kind != 1
            if: value.kind != c.LMX_WALK_VALUE_REFERENCE
                return: c.LMX_WALK_INVALID
            work\ref: value.ref
            work\dirty: 1
            return: lmx_walk_value_ref(out, work\ty, work\ref)
        ---
        if: lmx_walk_value_number(@ value, @ wv, @ a) != c.LMX_WALK_OK || a != work\ty
            return: c.LMX_WALK_INVALID
        work\num: wv
        work\dirty: 1
        return: lmx_walk_value_num(out, work\ty, wv)
    if: op = c.LMX_WALK_OP_AND || op = c.LMX_WALK_OP_OR
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        if: lmx_walk_value_number(@ value, @ ua, @ a) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        if: (op = c.LMX_WALK_OP_AND && ua = 0U) || (op = c.LMX_WALK_OP_OR && ua != 0U)
            return: lmx_walk_value_num(out, c.LMX_TYPE_INT, (cast: (size_t) (op = c.LMX_WALK_OP_OR)))
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 2U), @ other)
        if: status != c.LMX_WALK_OK
            return: status
        if: lmx_walk_value_number(@ other, @ ub, @ b) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        return: lmx_walk_value_num(out, c.LMX_TYPE_INT, (cast: (size_t) (ub != 0U)))
    # A prefix sign: one operand, evaluated once. The C99 integer promotion
    # comes first, as for every arithmetic operand below; the result has the
    # promoted type. Negation is the unsigned one of the stored width, which is
    # the two's complement negation for an int.
    if: op = c.LMX_WALK_OP_NEG || op = c.LMX_WALK_OP_POS
        if: code\array.size != 2U
            return: c.LMX_WALK_INVALID
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        if: lmx_walk_value_number(@ value, @ ua, @ a) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        if: a = c.LMX_TYPE_CHAR
            a: c.LMX_TYPE_INT
            if: c.CHAR_MAX > c.INT_MAX
                a: c.LMX_TYPE_UNSIGNED
        ---
        if: a = c.LMX_TYPE_UNSIGNED_CHAR
            a: c.LMX_TYPE_INT
            if: c.UCHAR_MAX > c.INT_MAX
                a: c.LMX_TYPE_UNSIGNED
        ---
        wv: ua
        if: op = c.LMX_WALK_OP_NEG
            wv: 0U - ua
        return: lmx_walk_value_num(out, a, wv)
    if: op = c.LMX_WALK_OP_ADD || op = c.LMX_WALK_OP_SUB || op = c.LMX_WALK_OP_MUL || op = c.LMX_WALK_OP_DIV || op = c.LMX_WALK_OP_MOD || op = c.LMX_WALK_OP_LT || op = c.LMX_WALK_OP_EQ
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 2U), @ other)
        if: status != c.LMX_WALK_OK
            return: status
        if: value.present = 0 || other.present = 0
            return: c.LMX_WALK_INVALID
        if: op = c.LMX_WALK_OP_EQ && (value.kind = c.LMX_WALK_VALUE_REFERENCE || other.kind = c.LMX_WALK_VALUE_REFERENCE)
            if: value.kind != c.LMX_WALK_VALUE_REFERENCE || other.kind != c.LMX_WALK_VALUE_REFERENCE
                return: c.LMX_WALK_INVALID
            return: lmx_walk_value_num(out, c.LMX_TYPE_INT, (cast: (size_t) (value.ref = other.ref)))
        ---
        if: lmx_walk_value_number(@ value, @ ua, @ a) != c.LMX_WALK_OK || lmx_walk_value_number(@ other, @ ub, @ b) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        # C99 integer promotions happen before operand type matching. The stored
        # char cell keeps its own type; arithmetic produces the promoted type.
        if: a = c.LMX_TYPE_CHAR
            a: c.LMX_TYPE_INT
            if: c.CHAR_MAX > c.INT_MAX
                a: c.LMX_TYPE_UNSIGNED
        ---
        if: b = c.LMX_TYPE_CHAR
            b: c.LMX_TYPE_INT
            if: c.CHAR_MAX > c.INT_MAX
                b: c.LMX_TYPE_UNSIGNED
        ---
        if: a = c.LMX_TYPE_UNSIGNED_CHAR
            a: c.LMX_TYPE_INT
            if: c.UCHAR_MAX > c.INT_MAX
                a: c.LMX_TYPE_UNSIGNED
        ---
        if: b = c.LMX_TYPE_UNSIGNED_CHAR
            b: c.LMX_TYPE_INT
            if: c.UCHAR_MAX > c.INT_MAX
                b: c.LMX_TYPE_UNSIGNED
        ---
        if: a != b
            return: c.LMX_WALK_INVALID
        if: op = c.LMX_WALK_OP_LT
            if: a = c.LMX_TYPE_INT
                return: lmx_walk_value_num(out, c.LMX_TYPE_INT, (cast: (size_t) ((cast: (int) ua) < (cast: (int) ub))))
            return: lmx_walk_value_num(out, c.LMX_TYPE_INT, (cast: (size_t) (ua < ub)))
        if: op = c.LMX_WALK_OP_EQ
            return: lmx_walk_value_num(out, c.LMX_TYPE_INT, (cast: (size_t) (ua = ub)))
        if: op = c.LMX_WALK_OP_ADD
            if: a = c.LMX_TYPE_INT
                wv: (cast: (size_t) ((cast: (int) ua) + (cast: (int) ub)))
            else:
                wv: ua + ub
            ---
            return: lmx_walk_value_num(out, a, wv)
        ---
        if: op = c.LMX_WALK_OP_SUB
            if: a = c.LMX_TYPE_INT
                wv: (cast: (size_t) ((cast: (int) ua) - (cast: (int) ub)))
            else:
                wv: ua - ub
            ---
            return: lmx_walk_value_num(out, a, wv)
        ---
        # -170 c1 / D-58: MUL/DIV/MOD. Mutant: MUL as ADD -> RED. Div/mod by 0 -> INVALID (X1 of D-37/D-44), not a throw.
        if: op = c.LMX_WALK_OP_MUL
            if: a = c.LMX_TYPE_INT
                wv: (cast: (size_t) ((cast: (int) ua) * (cast: (int) ub)))
            else:
                wv: ua * ub
            ---
            return: lmx_walk_value_num(out, a, wv)
        ---
        if: op = c.LMX_WALK_OP_DIV || op = c.LMX_WALK_OP_MOD
            if: ub = 0U
                return: c.LMX_WALK_INVALID
            ---
            if: a = c.LMX_TYPE_INT
                if: op = c.LMX_WALK_OP_DIV
                    wv: (cast: (size_t) ((cast: (int) ua) / (cast: (int) ub)))
                else:
                    wv: (cast: (size_t) ((cast: (int) ua) % (cast: (int) ub)))
                ---
            else:
                if: op = c.LMX_WALK_OP_DIV
                    wv: ua / ub
                else:
                    wv: ua % ub
                ---
            ---
            return: lmx_walk_value_num(out, a, wv)
        ---
    if: op = c.LMX_WALK_OP_IF
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        if: lmx_walk_value_number(@ value, @ wv, @ a) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        if: wv != 0U
            return: lmx_walk_body(f, lmx_arena_ref_struct(code, 2U), 0U)
        if: code\array.size > 3U
            return: lmx_walk_body(f, lmx_arena_ref_struct(lmx_arena_ref_struct(code, 3U), 1U), 0U)
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_BREAK
        return: c.LMX_WALK_BREAK
    if: op = c.LMX_WALK_OP_CONTINUE
        return: c.LMX_WALK_CONTINUE
    if: op = c.LMX_WALK_OP_UNTIL || op = c.LMX_WALK_OP_WHILE || op = c.LMX_WALK_OP_FOR
        while: going != 0
            if: lmx_msg_poll_escape() != 0
                return: c.LMX_WALK_STOPPED
            if: op != c.LMX_WALK_OP_UNTIL
                status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), @ value)
                if: status = c.LMX_WALK_OK
                    status: lmx_walk_value_number(@ value, @ wv, @ a)
                if: status != c.LMX_WALK_OK || wv = 0U
                    going: 0
                ---
            ---
            if: going != 0
                status: lmx_walk_body(f, lmx_arena_ref_struct(code, 2U), 0U)
                if: status = c.LMX_WALK_CONTINUE
                    status: c.LMX_WALK_OK
                if: status = c.LMX_WALK_BREAK
                    status: c.LMX_WALK_OK
                    going: 0
                if: status != c.LMX_WALK_OK || f\returned != 0
                    going: 0
                ---
            ---
            if: going != 0 && op = c.LMX_WALK_OP_FOR
                status: lmx_walk_body(f, lmx_arena_ref_struct(code, 3U), 0U)
                if: status != c.LMX_WALK_OK || f\returned != 0
                    going: 0
                ---
            ---
            if: going != 0 && op = c.LMX_WALK_OP_UNTIL
                status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), @ value)
                if: status = c.LMX_WALK_OK
                    status: lmx_walk_value_number(@ value, @ wv, @ a)
                if: status != c.LMX_WALK_OK || wv != 0U
                    going: 0
                ---
            ---
        ---
        return: status
    if: op = c.LMX_WALK_OP_RET
        if: code\array.size > 1U
            status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), @ f\result)
            if: status != c.LMX_WALK_OK
                return: status
        ---
        f\returned: 1
        memcpy((cast: (@: void) out), (cast: (@: void) (@ f\result)), c.sizeof(c.LmxWalkValue))
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_PRIM || op = c.LMX_WALK_OP_PRIM_PUB
        return: lmx_walk_prim(f, code, out)
    if: op = c.LMX_WALK_OP_ADMIT_AS
        return: lmx_walk_admit_op(f, code, out)
    if: op = c.LMX_WALK_OP_EMPTY
        return: lmx_walk_empty(f, code, out)
    if: op = c.LMX_WALK_OP_CALL || op = c.LMX_WALK_OP_EXEC
        return: lmx_walk_call(f, code, out)
    if: op = c.LMX_WALK_OP_EXPECT_INT
        # This model predicate's declared first input is a Structure reference.
        if: f\args = 0 || f\nargs < 1U || f\args[0] = 0 || code\array.size < 3U
            return: lmx_walk_value_num(out, c.LMX_TYPE_INT, 0U)
        root: lmx_pointer_value_known(f\args[0])
        wholder: lmx_arena_ref_struct(code, 1U)
        want: lmx_arena_ref_value(code, 2U)
        if: root = 0 || wholder = 0 || want = 0
            return: lmx_walk_value_num(out, c.LMX_TYPE_INT, 0U)
        if: lmx_domain_kind(f\arena, (cast: (@: void) wholder)) != c.LMX_KIND_STRUCT
            return: c.LMX_WALK_INVALID
        index: 0U
        while: index < wholder\array.size
            a: lmx_int_value_known(lmx_arena_ref_value(wholder, index))
            if: a < 0 || (cast: (size_t) a) >= (cast: (@: Lmx) root)\array.size
                return: c.LMX_WALK_INVALID
            leaf: lmx_arena_ref_value((cast: (@: Lmx) root), (cast: (size_t) a))
            if: leaf = 0
                return: c.LMX_WALK_INVALID
            if: lmx_domain_kind(f\arena, leaf) = c.LMX_KIND_STRUCT
                root: leaf
            index: index + 1U
        ---
        if: leaf = 0 || lmx_domain_kind(f\arena, leaf) != c.LMX_KIND_PRIMITIVE || lmx_domain_type(f\arena, leaf) != c.LMX_TYPE_INT
            return: lmx_walk_value_num(out, c.LMX_TYPE_INT, 0U)
        return: lmx_walk_value_num(out, c.LMX_TYPE_INT, (cast: (size_t) (lmx_int_value_known(leaf) = lmx_int_value_known(want))))
    if: op = c.LMX_WALK_OP_LENGTH
        status: lmx_walk_array_from(f, lmx_arena_ref_value(code, 1U), 0, @ array)
        if: status != c.LMX_WALK_OK
            return: status
        return: lmx_walk_value_num(out, c.LMX_TYPE_SIZE_T, array\size)
    if: op = c.LMX_WALK_OP_PAD
        return: c.LMX_WALK_OK
return: c.LMX_WALK_INVALID
fn: lmx_walk_body (@: LmxWalkFrame f; @: Lmx body; size_t: first) int
    @: void child 0
    LmxWalkValue: dropped
    @: Lmx pad 0
    int: step_op
    int: status c.LMX_WALK_OK
    size_t: i first
    size_t: j 0U
    if: f = 0 || body = 0
        return: c.LMX_WALK_INVALID
    while: status = c.LMX_WALK_OK && f\returned = 0 && i < body\array.size
        if: lmx_msg_poll_escape() != 0
            return: c.LMX_WALK_STOPPED
        child: lmx_arena_ref_value(body, i)
        step_op: lmx_walk_op(f, child)
        if: step_op != c.LMX_WALK_OP_NONE
            status: lmx_walk_eval(f, child, @ dropped)
            # Activation value = last evaluated expression. SET/PUT/IF/WHILE/FOR are
            # statements (void fall-off). LIT/arith/CALL/OWN/... count. RET sets valued itself.
            if: status = c.LMX_WALK_OK && dropped.present != 0 && step_op != c.LMX_WALK_OP_SET && step_op != c.LMX_WALK_OP_SET_OF && step_op != c.LMX_WALK_OP_SET_ARG && step_op != c.LMX_WALK_OP_PUT && step_op != c.LMX_WALK_OP_PUT_REF && step_op != c.LMX_WALK_OP_PUT_OF && step_op != c.LMX_WALK_OP_ELEMPUT && step_op != c.LMX_WALK_OP_IF && step_op != c.LMX_WALK_OP_WHILE && step_op != c.LMX_WALK_OP_FOR && step_op != c.LMX_WALK_OP_UNTIL && step_op != c.LMX_WALK_OP_PAD
                memcpy((cast: (@: void) (@ f\result)), (cast: (@: void) (@ dropped)), c.sizeof(c.LmxWalkValue))
            ---
        ---
        # A throw from the handler can name another pad of this same body.
        # Landing is cleared before each handler, so this loop runs again only
        # when that handler throws onto a pad whose parent is still this body.
        # One such pad is bound once: the next turn sees landing 0 unless a new throw sets it.
        while: status >= c.LMX_WALK_THROWN && f\landing != 0 && f\landing\parent = body
            pad: f\landing
            status: lmx_walk_catch_bind(f)
            if: status = c.LMX_WALK_OK
                j: 0U
                while: j < body\array.size && lmx_arena_ref_value(body, j) != (cast: (@: void) pad)
                    j: j + 1U
                ---
                if: j >= body\array.size
                    status: c.LMX_WALK_INVALID
                else:
                    i: j
                ---
            ---
        ---
        i: i + 1U
    ---
return: status

sub: lmx_walk_frame_open (@: LmxWalkFrame f; @: LmxWalkContext context; @: Lmx code; @: Lmx data; @@: void args; size_t: nargs)
    memset((cast: (@: void) f), 0, c.sizeof(c.LmxWalkFrame))
    f\context: context
    f\arena: context\arena
    f\roles: context\roles
    f\code: code
    f\node: data
    f\args: args
    f\nargs: nargs
end: lmx_walk_frame_open

# ENTRY (k.4, next_core_tasks.md §3 item 9: no descriptor, no cached plan -- nothing
# beyond the two Structures themselves).  `code` and `data` must each classify as a
# Structure; that is the whole check.  There is no "callable" test and no refusal for a
# code Structure with zero body steps -- "no operator" is not "invalid", it is a body
# that runs zero steps and falls off the end, the same as any other (author, §3 item 8:
# "отдельного признака callable нет... отказ — дело транслятора").
fn: lmx_walk_enter (@: LmxWalkFrame f; @: LmxWalkContext context; @: Lmx code; @: Lmx data; @@: void args; size_t: nargs) int
    if: f = 0
        return: c.LMX_WALK_INVALID
    if: context = 0 || context\arena = 0 || context\scratch = 0 || context\roles = 0 || code = 0 || data = 0
        memset((cast: (@: void) f), 0, c.sizeof(c.LmxWalkFrame))
        return: c.LMX_WALK_INVALID
    lmx_walk_frame_open(f, context, code, data, args, nargs)
    if: lmx_walk_kind(f, (cast: (@: void) code)) != c.LMX_KIND_STRUCT || lmx_walk_kind(f, (cast: (@: void) data)) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_INVALID
return: lmx_walk_args_open(f)

fn: lmx_walk_activate (@: LmxWalkContext context; @: Lmx code; @: Lmx data; @@: void args; size_t: nargs; @: LmxWalkValue result) int
    LmxWalkFrame: frame
    LmxScratchMark: mark
    @: LmxWalkFrame f 0
    @: LmxScratchMark pm 0
    int: status
    int: a 0
    if: result != 0
        lmx_walk_value_clear(result)
    if: context = 0 || context\scratch = 0
        return: c.LMX_WALK_INVALID
    f: @ frame
    pm: @ mark
    # Everything this activation takes from the scratch arena is taken after this mark and is
    # gone with the rewind below, whichever way the activation ends.
    if: lmx_scratch_mark(context\scratch, pm) != c.LMX_SCRATCH_OK
        return: c.LMX_WALK_INVALID
    status: lmx_walk_enter(f, context, code, data, args, nargs)
    # §7b: the entry load (Lingvamyxa spec 21.5): the working table of the own fields the code uses, from the code.
    if: status = c.LMX_WALK_OK
        status: lmx_walk_load_code(f)
    if: status = c.LMX_WALK_OK
        status: lmx_walk_body(f, code, 0U)
    # §7b: the activation ends -- a RET with its value already evaluated, a fall-off, or a throw that leaves -- so what
    # is dirty is published before control goes back (book §14).  Nested bodies end nothing: only this does.
    if: status = c.LMX_WALK_OK || status = c.LMX_WALK_STOPPED || status >= c.LMX_WALK_THROWN
        a: lmx_walk_publish(f)
        if: a != c.LMX_WALK_OK
            status: a
    ---
    if: status = c.LMX_WALK_OK && result != 0
        memcpy((cast: (@: void) result), (cast: (@: void) (@ f\result)), c.sizeof(c.LmxWalkValue))
    ---
    # THROWN: the callee's landing stays 0 when its site renumbered. Only the
    # payload crosses. The caller reads it from this out-parameter.
    if: status >= c.LMX_WALK_THROWN && result != 0
        lmx_walk_value_ref(result, c.LMX_TYPE_LMX, f\payload)
    ---
    if: lmx_scratch_rewind(context\scratch, pm) != c.LMX_SCRATCH_OK && (status = c.LMX_WALK_OK || status = c.LMX_WALK_STOPPED)
        status: c.LMX_WALK_INVALID
    ---
return: status

# Public value-storage boundary. ARG witnesses provide declared types; a held
# reference is checked only where its consuming operation requires a category.
# A direct/root caller executes one complete Structure over itself.
fn: lmx_walk_run (@: LmxWalkContext context; @: Lmx node; @@: void args; size_t: nargs; @: LmxWalkValue out) int
    LmxWalkValue: ignored
    int: status
    if: out = 0
        out: @ ignored
    if: context = 0 || context\arena = 0 || (nargs != 0U && args = 0)
        return: c.LMX_WALK_INVALID
    status: lmx_walk_activate(context, node, node, args, nargs, out)
    if: status = c.LMX_WALK_STOPPED
        lmx_walk_value_clear(out)
        return: c.LMX_WALK_OK
return: status
fn: lmx_walk_admit_resolve (@: LmxArena arena; @: void raw; @@: void out_value) int
    \out_value: 0
    if: arena = 0
        return: 1
    ---
    if: raw = 0
        return: 0
    ---
    if: lmx_range_classify(arena, raw) = c.LMX_KIND_STRUCT
        \out_value: raw
        return: 0
    ---
return: 1

fn: lmx_walk_admit_against (@: LmxArena arena; @: Lmx value; @: Lmx model; @@: void out) int
    int: admit
    if: arena = 0 || value = 0 || model = 0 || out = 0
        return: 1
    ---
    admit: lmx_implements_receiver_view(arena, value, model, model, 0)
    if: admit = c.LMX_IMPLEMENTS_YES && lmx_implements_find(arena, value, model) = 0
        admit: lmx_implements_register_map(arena, value, model, 0, 0U, 0)
    if: admit = c.LMX_IMPLEMENTS_YES
        \out: (cast: (@: void) value)
        return: 0
    ---
    \out: 0
return: c.LMX_PRIMITIVE_THROW_IMPLEMENTS

fn: lmx_walk_admit (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    @: LmxArena arena 0
    @: Lmx model 0
    @: void value 0
    int: st
    \out: 0
    if: owner = 0 || refs = 0 || out = 0 || nargs != 2U
        return: 1
    ---
    arena: (cast: (@: LmxArena) owner)
    model: (cast: (@: Lmx) lmx_pointer_value_known(refs[1]))
    if: model = 0 || lmx_range_classify(arena, (cast: (@: void) model)) != c.LMX_KIND_STRUCT
        return: 1
    ---
    st: lmx_walk_admit_resolve(arena, lmx_pointer_value_known(refs[0]), @ value)
    if: st != 0
        return: 1
    ---
    if: value = 0
        return: 0
    ---
return: lmx_walk_admit_against(arena, (cast: (@: Lmx) value), model, out)

fn: lmx_walk_admit_letter (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    @: LmxArena arena 0
    @: Lmx model 0
    @: Lmx letter 0
    @: void value 0
    @: void payload 0
    int: st
    \out: 0
    if: owner = 0 || refs = 0 || out = 0 || nargs != 2U
        return: 1
    ---
    arena: (cast: (@: LmxArena) owner)
    model: (cast: (@: Lmx) lmx_pointer_value_known(refs[1]))
    if: model = 0 || lmx_range_classify(arena, (cast: (@: void) model)) != c.LMX_KIND_STRUCT
        return: 1
    ---
    st: lmx_walk_admit_resolve(arena, lmx_pointer_value_known(refs[0]), @ value)
    if: st != 0
        return: 1
    ---
    if: value = 0
        return: 0
    ---
    letter: (cast: (@: Lmx) value)
    # q25 (ii): admit payload at slot 1; \out = payload (keep this line obvious if author picks (i)=\out letter).
    payload: lmx_arena_ref_value(letter, 1U)
    if: payload = 0 || lmx_range_classify(arena, payload) != c.LMX_KIND_STRUCT
        return: c.LMX_PRIMITIVE_THROW_IMPLEMENTS
    ---
return: lmx_walk_admit_against(arena, (cast: (@: Lmx) payload), model, out)

# A MODEL operand -- ADMIT_AS's child 4, OF's child 3, PUT_OF's child 4: the model Structure itself, or (K02c) a
# frame standing in its place, evaluated here to the model's reference -- a merge result's own Structure, which
# does not exist when the frames are built.  Told apart by role, as every operand is (lmx_walk_node): a Structure
# is no frame.  0 stays 0 (no model).  Writes the model to out; a status other than OK is the evaluation's.
fn: lmx_walk_model_operand (@: LmxWalkFrame f; @: void operand; @@: Lmx out) int
    LmxWalkValue: mv
    int: status
    \out: (cast: (@: Lmx) operand)
    if: operand = 0 || lmx_walk_node(f, operand) = c.LMX_WALK_OP_NONE
        return: c.LMX_WALK_OK
    status: lmx_walk_eval(f, operand, @ mv)
    if: status != c.LMX_WALK_OK
        return: status
    if: mv.present = 0 || mv.kind != c.LMX_WALK_VALUE_REFERENCE || mv.ref = 0
        return: c.LMX_WALK_INVALID
    \out: (cast: (@: Lmx) mv.ref)
return: c.LMX_WALK_OK

# ADMIT_AS carries one flat immutable instruction: source schema token/target model,
# default target map, alternatives keyed by exact physical layout, then catches.
# Existing ImplEntry views borrow this instruction and an offset; there is no
# correspondence-only Structure or allocated/composed map. Candidate once;
# null passes before source-view lookup. NO is the implicit implements throw.
fn: lmx_walk_admit_op (@: LmxWalkFrame f; @: Lmx code; @: LmxWalkValue out) int
    LmxImplEntry: view
    LmxImplUses: cover
    @: LmxImplUses uses 0
    size_t: uses_n 0U
    @: LmxImplEntry v 0
    @: LmxImplEntry known 0
    @: Lmx model 0
    @: void source_layout 0
    @: void layout 0
    @: void token_cell 0
    int: selected 0
    size_t: choice 0U
    size_t: choices 0U
    size_t: at 9U
    size_t: full_receiver 0U
    size_t: default_n 0U
    size_t: width
    size_t: stride
    size_t: catch_at
    size_t: catch_n 0U
    size_t: n
    int: status
    int: answer
    lmx_walk_value_clear(out)
    if: code\array.size < 9U
        return: c.LMX_WALK_INVALID
    ---
    if: lmx_walk_catch_count(f, lmx_arena_ref_value(code, 2U), @ catch_n) != c.LMX_WALK_OK || catch_n > (code\array.size - 9U) / 3U
        return: c.LMX_WALK_INVALID
    ---
    catch_at: code\array.size - 3U * catch_n
    status: lmx_walk_model_operand(f, lmx_arena_ref_value(code, 4U), @ model)
    if: status != c.LMX_WALK_OK
        return: status
    token_cell: lmx_arena_ref_value(code, 1U)
    if: token_cell != 0
        if: lmx_domain_kind(f\arena, token_cell) != c.LMX_KIND_PRIMITIVE || lmx_domain_type(f\arena, token_cell) != c.LMX_TYPE_CHAR_PTR
            return: c.LMX_WALK_INVALID
        source_layout: (cast: (@: void) lmx_charptr_value_known(token_cell))
    ---
    token_cell: lmx_arena_ref_value(code, 7U)
    if: token_cell != 0
        if: lmx_domain_kind(f\arena, token_cell) != c.LMX_KIND_PRIMITIVE || lmx_domain_type(f\arena, token_cell) != c.LMX_TYPE_CHAR_PTR
            return: c.LMX_WALK_INVALID
        layout: (cast: (@: void) lmx_charptr_value_known(token_cell))
    ---
    if: model = 0 || lmx_walk_kind(f, (cast: (@: void) model)) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_INVALID
    ---
    width: model\array.size
    if: lmx_walk_load_numeric(f\arena, lmx_arena_ref_value(code, 5U), @ choices) != c.LMX_WALK_OK || lmx_walk_load_numeric(f\arena, lmx_arena_ref_value(code, 6U), @ default_n) != c.LMX_WALK_OK
        return: c.LMX_WALK_INVALID
    if: lmx_walk_load_numeric(f\arena, lmx_arena_ref_value(code, 8U), @ full_receiver) != c.LMX_WALK_OK || full_receiver > 2U
        return: c.LMX_WALK_INVALID
    # The coverage of this receiving instruction, read in place: its first cell
    # is its count of cells, and the maps follow it.
    if: full_receiver = 2U
        if: lmx_walk_load_numeric(f\arena, lmx_arena_ref_value(code, 9U), @ uses_n) != c.LMX_WALK_OK || uses_n < 2U || uses_n > catch_at - 9U
            return: c.LMX_WALK_INVALID
        uses: @ cover
        memset((cast: (@: void) uses), 0, c.sizeof(c.LmxImplUses))
        uses\frame: code
        uses\at: 9U
        at: 9U + uses_n
    ---
    # default_n is the PHYSICAL cell count of an explicit map: two per required field (K01,
    # the ordinal half then the LAST half), or zero for the compact identity case.  The
    # registered entry's n stays the semantic width.
    if: (default_n != 0U && default_n != width * 2U) || default_n > catch_at - at || width = (cast: (size_t) -1)
        return: c.LMX_WALK_INVALID
    stride: width * 2U + 1U
    n: catch_at - at - default_n
    if: n / stride != choices || n % stride != 0U
        return: c.LMX_WALK_INVALID
    status: lmx_walk_eval(f, lmx_arena_ref_value(code, 3U), out)
    if: status != c.LMX_WALK_OK
        return: status
    ---
    # An operand that evaluates absent -- an input its caller left out, handed on as it is -- has no candidate
    # to admit: the result stays absent, and nothing is viewed, recorded or thrown.  A present value that is
    # no reference is not a candidate either, and stays the instruction's error.  A present null reference is
    # present, below.
    if: out\present = 0
        return: c.LMX_WALK_OK
    ---
    if: out\kind != c.LMX_WALK_VALUE_REFERENCE
        return: c.LMX_WALK_INVALID
    ---
    if: out\ref = 0
        return: c.LMX_WALK_OK
    ---
    if: layout = 0
        layout: lmx_implements_layout(f\arena, (cast: (@: Lmx) out\ref))
    v: @ view
    memset((cast: (@: void) v), 0, c.sizeof(c.LmxImplEntry))
    v\layout: layout
    if: layout != 0 && layout = source_layout
        selected: 1
    if: default_n != 0U
        v\frame: code
        v\at: at
        v\n: width
    ---
    at: at + default_n
    while: layout != 0 && choice < choices
        token_cell: lmx_arena_ref_value(code, at)
        if: lmx_domain_kind(f\arena, token_cell) != c.LMX_KIND_PRIMITIVE || lmx_domain_type(f\arena, token_cell) != c.LMX_TYPE_CHAR_PTR
            return: c.LMX_WALK_INVALID
        if: layout = (cast: (@: void) lmx_charptr_value_known(token_cell))
            v\frame: code
            v\at: at + 1U
            v\n: width
            selected: 1
        at: at + stride
        choice: choice + 1U
    ---
    answer: c.LMX_IMPLEMENTS_UNKNOWN
    if: selected != 0
        answer: c.LMX_IMPLEMENTS_YES
        if: full_receiver != 0U
            v\value: (cast: (@: Lmx) out\ref)
            v\req: model
            answer: lmx_implements_receiving_use(f\arena, (cast: (@: Lmx) out\ref), model, model, v, uses)
        if: answer = c.LMX_IMPLEMENTS_YES
            answer: lmx_implements_register(f\arena, (cast: (@: Lmx) out\ref), model, v)
    ---
    if: selected = 0
        known: lmx_implements_find(f\arena, (cast: (@: Lmx) out\ref), model)
        if: known != 0
            # An old correspondence is not proof for a new consumer. Without
            # a selected compile-proved map, check this receiver first: by its
            # own coverage when the instruction carries one, else in full. The
            # record gives the places and no permission.
            answer: lmx_implements_receiving_use(f\arena, (cast: (@: Lmx) out\ref), model, model, 0, uses)
            if: answer = c.LMX_IMPLEMENTS_YES
                memcpy((cast: (@: void) v), (cast: (@: void) known), c.sizeof(c.LmxImplEntry))
                v\layout: layout
                answer: lmx_implements_register(f\arena, (cast: (@: Lmx) out\ref), model, v)
        ---
        else:
            if: layout = 0
                # A successful full positional check establishes identity,
                # never physical-layout evidence. Nested unused holes still
                # fail this current-receiver check before any publication.
                answer: lmx_implements_receiver_view(f\arena, (cast: (@: Lmx) out\ref), model, model, 0)
                if: answer = c.LMX_IMPLEMENTS_YES
                    answer: lmx_implements_register_map(f\arena, (cast: (@: Lmx) out\ref), model, 0, 0U, 0)
    ---
    if: answer = c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    ---
    # UNKNOWN is no successful proof, just as NO is not. The receiving
    # operation refuses both through implements; the predicate remains
    # three-valued. Malformed graph/evaluation failures return above.
    status: c.LMX_WALK_THROWN + 2
    f\payload: 0
    if: catch_n != 0U
        status: lmx_walk_catch_scan(f, code, catch_at, catch_n, status)
    ---
return: status

# A copy of what a slot holds, as a merge copies data: a value cell -- a number -- is a fresh cell of its own type
# holding its value now, including char; anything else (a Structure, a reference)
# is itself. 0 on no room.
fn: lmx_walk_cell_copy (@: LmxArena arena; @: void cell) @: void
    @: void fresh 0
    int: ty
    if: arena = 0 || cell = 0 || lmx_range_classify(arena, cell) != c.LMX_KIND_PRIMITIVE
        return: cell
    ty: lmx_range_type_of(arena, cell)
    if: ty = c.LMX_TYPE_CHAR
        fresh: lmx_char_new_owned(arena)
        if: fresh = 0 || lmx_char_store_known(fresh, lmx_char_value_known(cell)) != 0
            return: 0
        return: fresh
    if: ty = c.LMX_TYPE_INT
        fresh: lmx_int_new_owned(arena)
        if: fresh = 0 || lmx_int_store_known(fresh, lmx_int_value_known(cell)) != 0
            return: 0
        return: fresh
    ---
    if: ty = c.LMX_TYPE_SIZE_T
        fresh: lmx_size_new_owned(arena)
        if: fresh = 0 || lmx_size_store_known(fresh, lmx_size_value_known(cell)) != 0
            return: 0
        return: fresh
    ---
    if: ty = c.LMX_TYPE_UNSIGNED
        fresh: lmx_unsigned_new_owned(arena)
        if: fresh = 0 || lmx_unsigned_store_known(fresh, lmx_unsigned_value_known(cell)) != 0
            return: 0
        return: fresh
    ---
    if: ty = c.LMX_TYPE_ULONG
        fresh: lmx_ulong_new_owned(arena)
        if: fresh = 0 || lmx_ulong_store_known(fresh, lmx_ulong_value_known(cell)) != 0
            return: 0
        return: fresh
    ---
return: cell

# Item 738 (Q38/Q42/Q44, the author: a capture is a copy of the fields the model reads; steps/capture-
# 738.md): a Structure in req's own layout -- req's width, each field fields[0..n) names a fresh cell at req's
# own slot holding src's value now in an independent typed cell, every
# other slot empty.  It is recorded in the arena's `implements` table as req's own layout with holes (D-105; Codex,
# 2026-09-28): the model reads the fields at req's slots, and an empty slot is not carried -- a read of it is
# refused, never read as present.  No correspondence Structure is made.  The copy hangs under `parent` (no slot
# of it).  0 when a field is not a value cell, or on no room.  The translator names value fields only
# (l2_cap_add), so its host's abort on 0 is a guard and an out-of-memory stop.
fn: lmx_walk_capture (@: LmxArena arena; @: Lmx parent; @: Lmx src; @: Lmx req; @: size_t fields; size_t: n; @: void layout) @: Lmx
    LmxImplEntry: view
    @: LmxImplEntry v 0
    @: Lmx copy 0
    size_t: i 0U
    size_t: j
    @: void cell
    @: void fresh
    size_t: sj
    @: LmxImplEntry own 0
    if: arena = 0 || parent = 0 || src = 0 || req = 0 || fields = 0
        return: 0
    # D-105 native x item 738 (steps/d105-native.md): a source admitted to req by name -- a formal that a
    # value of another type reached -- holds req's field j at the slot its record gives, not at j.
    own: lmx_implements_find(arena, src, req)
    copy: lmx_struct_new_owned(parent, arena)
    if: copy = 0
        return: 0
    if: (req\array.size) != 0U && lmx_arena_refs_open_owned(arena, copy, (req\array.size)) != 0
        return: 0
    while: i < n
        j: fields[i]
        if: j >= req\array.size
            return: 0
        sj: j
        if: own != 0 && lmx_implements_slot(arena, src, req, j, @ sj) != 0
            return: 0
        if: sj >= src\array.size
            return: 0
        cell: lmx_arena_ref_value(src, sj)
        if: cell = 0 || lmx_range_classify(arena, cell) != c.LMX_KIND_PRIMITIVE
            return: 0
        fresh: lmx_walk_cell_copy(arena, cell)
        if: fresh = 0 || fresh = cell
            return: 0
        if: lmx_arena_ref_store(copy, j, fresh) != 0
            return: 0
        i: i + 1U
    ---
    v: @ view
    memset((cast: (@: void) v), 0, c.sizeof(c.LmxImplEntry))
    v\holes: 1
    v\layout: layout
    if: lmx_implements_register(arena, copy, req, v) != c.LMX_IMPLEMENTS_YES
        return: 0
return: copy
