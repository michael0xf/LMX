# Ordinary L2 frontend value, ownership and representation helpers.
# The26 inherited C cells stay owned by the existing frontend; aliases address the same cells.
predef: "l2src/l2_application.h.lm1"
predef: "l2src/l2_frontend_helpers.h.lm1"
predef: "l2src/l2_frontend_alloc.h.lm1"
include: "<stddef.h>" "<stdio.h>" "<stdlib.h>" "<string.h>" "<limits.h>"

fn: lm_compiler_fn (int: mi; int: k) @: c.LmP0Text
    @@@: m_fn_cell void (cast: (@@@: void) (@ c.l2_m_fn))
    @@: row c.LmP0Text
    if: mi < 0 || k < 0 || m_fn_cell[0][mi] = 0
        return: (cast: (@: c.LmP0Text) (0))
    row: (cast: (@@: c.LmP0Text) m_fn_cell[0][mi])
    return: (cast: (@: c.LmP0Text) (row[k]))
end: lm_compiler_fn

fn: lm_compiler_ft (int: mi; int: k) int
    @@@: m_ft_cell int (cast: (@@@: int) (@ c.l2_m_ft))
    @: row int
    if: mi < 0 || k < 0 || m_ft_cell[0][mi] = 0
        return: (cast: (int) (0))
    row: m_ft_cell[0][mi]
    return: (cast: (int) (row[k]))
end: lm_compiler_ft

fn: lm_compiler_fn_set (int: mi; int: k; @: v c.LmP0Text) int
    @@@: m_fn_cell void (cast: (@@@: void) (@ c.l2_m_fn))
    @@: row c.LmP0Text
    if: mi < 0 || k < 0 || m_fn_cell[0][mi] = 0
        return: (cast: (int) (1))
    row: (cast: (@@: c.LmP0Text) m_fn_cell[0][mi])
    row[k]: v
    return: (cast: (int) (0))
end: lm_compiler_fn_set

fn: lm_compiler_ft_set (int: mi; int: k; int: v) int
    @@@: m_ft_cell int (cast: (@@@: int) (@ c.l2_m_ft))
    @: row int
    if: mi < 0 || k < 0 || m_ft_cell[0][mi] = 0
        return: (cast: (int) (1))
    row: m_ft_cell[0][mi]
    row[k]: v
    return: (cast: (int) (0))
end: lm_compiler_ft_set

fn: lm_compiler_emit_empty_return (int: mi; const: (@: ind char)) int
    @@: m_throws_cell int (cast: (@@: int) (@ c.l2_m_throws))
    @@: out_cell c.FILE (cast: (@@: c.FILE) (@ c.l2_out))
    if: m_throws_cell[0] != 0 && m_throws_cell[0][mi] != 0
        return: (cast: (int) ((cast: (int) (c.fprintf(out_cell[0], "%sreturn: 0\n", ind) < 0))))
    return: (cast: (int) ((cast: (int) (c.fprintf(out_cell[0], "%sreturn\n", ind) < 0))))
end: lm_compiler_emit_empty_return

fn: lm_compiler_method_by_source (const: (@: source_node c.LmP0Node)) int
    @: m_n_cell int (cast: (@: int) (@ c.l2_m_n))
    @@@: m_node_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_m_node))
    int: mi 0
    if: source_node = 0
        return: (cast: (int) (-1))
    while: mi < m_n_cell[0]
        if: m_node_cell[0][mi] = source_node
            return: (cast: (int) (mi))
        mi: mi + 1
    return: (cast: (int) (-1))
end: lm_compiler_method_by_source

fn: lm_compiler_root_names_method (const: (@: root c.LmP0Structure); const: (@: name c.LmP0Text)) int
    @: field c.LmP0Field
    @: item c.LmP0Node
    @: nm c.LmP0Text
    if: root = 0 || name = 0
        return: (cast: (int) (0))
    field: c.lm_compiler_next_active(root\first_field)
    while: field != 0
        item: field\value
        if: c.lm_compiler_root_method_head(c.lm_compiler_app_head(item)) != 0
            nm: c.lm_compiler_os_fn_name(item)
            if: nm != 0 && c.lm_compiler_text_same(nm, name) != 0
                return: (cast: (int) (1))
            ---
        ---
        if: c.lm_compiler_text_eq(c.lm_compiler_app_head(item), "os") != 0 && c.lm_compiler_os_branch_method(lm_compiler_os_selected_branch(item), name) != 0
            return: (cast: (int) (1))
        field: c.lm_compiler_next_active(field\next)
    ---
    return: (cast: (int) (0))
end: lm_compiler_root_names_method

fn: lm_compiler_find_method (const: (@: name c.LmP0Text)) int
    @: m_n_cell int (cast: (@: int) (@ c.l2_m_n))
    @@@: m_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_m_name))
    int: i 0
    while: i < m_n_cell[0]
        if: c.lm_compiler_text_same(m_name_cell[0][i], name)
            return: (cast: (int) (i))
        i: i + 1
    return: (cast: (int) (-1))
end: lm_compiler_find_method

fn: lm_compiler_occ_head (const: (@: t c.LmP0Text); @: out_occ int; @@: out_name c.LmP0Text) int
    @: result_text c.LmP0Text
    size_t: i 0U
    size_t: n
    unsigned: ch
    int: occ 0
    if: t = 0 || t\data = 0 || out_occ = 0 || out_name = 0
        return: (cast: (int) (1))
    n: t\length
    if: n < 5U || t\data[0] != 92 || t\data[1] != 91
        return: (cast: (int) (1))
    i: 2U
    if: i >= n || t\data[i] < 48 || t\data[i] > 57
        return: (cast: (int) (2))
    while: i < n && t\data[i] >= 48 && t\data[i] <= 57
        ch: (cast: (unsigned) t\data[i]) - 48U
        if: occ > (c.INT_MAX / 10) - (cast: (int) ch)
            return: (cast: (int) (2))
        occ: occ * 10 + (cast: (int) ch)
        i: i + 1U
    if: i >= n || t\data[i] != 93
        return: (cast: (int) (2))
    i: i + 1U
    if: i >= n
        return: (cast: (int) (2))
    \out_name: (cast: (@: c.LmP0Text) c.lm_compiler_xmalloc(c.sizeof(c.LmP0Text)))
    if: \out_name = 0
        return: (cast: (int) (2))
    result_text: (cast: (@: c.LmP0Text) (\out_name))
    result_text\data: t\data + i
    result_text\length: n - i
    \out_occ: occ
    return: (cast: (int) (0))
end: lm_compiler_occ_head

fn: lm_compiler_predef_import (const: (@: quoted c.LmP0Text); const: (@: source_path char)) const: @: c.LmP0Text
    @: alloc_err_cell int (cast: (@: int) (@ c.l2_alloc_err))
    size_t: n
    size_t: i 0U
    size_t: text_length
    size_t: slash 0U
    size_t: maximum (cast: (size_t) -1)
    @: data char
    c.LmP0Text: joined
    @: kept c.LmP0Text
    if: quoted = 0 || quoted\data = 0 || quoted\length < 2U
        return: (cast: (const: @: c.LmP0Text) (quoted))
    if: quoted\data[0] != 34 || quoted\data[quoted\length - 1U] != 34 || source_path = 0
        return: (cast: (const: @: c.LmP0Text) (quoted))
    n: quoted\length - 2U
    if: n = 0U || (n >= 2U && quoted\data[2] = 58)
        return: (cast: (const: @: c.LmP0Text) (quoted))
    i: 1U
    while: i <= n
        if: quoted\data[i] = 47 || quoted\data[i] = 92
            return: (cast: (const: @: c.LmP0Text) (quoted))
        i: i + 1U
    ---
    text_length: c.strlen(source_path)
    i: 0U
    while: i < text_length
        if: source_path[i] = 47 || source_path[i] = 92
            slash: i + 1U
        i: i + 1U
    ---
    if: slash = 0U && text_length >= 2U && source_path[1] = 58
        slash: 2U
    if: slash = 0U
        return: (cast: (const: @: c.LmP0Text) (quoted))
    if: quoted\length = maximum || slash > maximum - quoted\length - 1U
        alloc_err_cell[0]: 2
        return: (cast: (const: @: c.LmP0Text) (0))
    data: (cast: (@: char) c.lm_compiler_xmalloc(quoted\length + slash + 1U))
    if: data = 0
        return: (cast: (const: @: c.LmP0Text) (0))
    data[0]: 34
    c.memcpy(data + 1U, source_path, slash)
    c.memcpy(data + 1U + slash, quoted\data + 1U, quoted\length - 1U)
    data[quoted\length + slash]: 0
    joined\data: data
    joined\length: quoted\length + slash
    kept: c.lm_compiler_cnt_keep(@ joined)
    c.lm_compiler_xfree((cast: (@: void) data))
    if: kept = 0 && alloc_err_cell[0] = 0
        alloc_err_cell[0]: 1
    return: (cast: (const: @: c.LmP0Text) (kept))
end: lm_compiler_predef_import

fn: lm_compiler_foreign_truncate (int: count) int
    @: foreign_n_cell int (cast: (@: int) (@ c.l2_foreign_n))
    @@@: foreign_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_foreign_name))
    int: i count
    while: i < foreign_n_cell[0]
        c.lm_compiler_xfree((cast: (@: void) foreign_name_cell[0][i]))
        foreign_name_cell[0][i]: 0
        i: i + 1
    foreign_n_cell[0]: count
    return: (cast: (int) (0))
end: lm_compiler_foreign_truncate

fn: lm_compiler_foreign_free () int
    @@@: foreign_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_foreign_name))
    @@: foreign_depth_cell int (cast: (@@: int) (@ c.l2_foreign_depth))
    @@: foreign_const_cell int (cast: (@@: int) (@ c.l2_foreign_const))
    @@: foreign_raw_c_cell int (cast: (@@: int) (@ c.l2_foreign_raw_c))
    @: foreign_n_cell int (cast: (@: int) (@ c.l2_foreign_n))
    @: foreign_cap_cell int (cast: (@: int) (@ c.l2_foreign_cap))
    lm_compiler_foreign_truncate(0)
    if: foreign_name_cell[0] != 0
        c.lm_compiler_xfree((cast: (@: void) foreign_name_cell[0]))
    if: foreign_depth_cell[0] != 0
        c.lm_compiler_xfree((cast: (@: void) foreign_depth_cell[0]))
    if: foreign_const_cell[0] != 0
        c.lm_compiler_xfree((cast: (@: void) foreign_const_cell[0]))
    if: foreign_raw_c_cell[0] != 0
        c.lm_compiler_xfree((cast: (@: void) foreign_raw_c_cell[0]))
    foreign_name_cell[0]: 0
    foreign_depth_cell[0]: 0
    foreign_const_cell[0]: 0
    foreign_raw_c_cell[0]: 0
    foreign_n_cell[0]: 0
    foreign_cap_cell[0]: 0
    return: (cast: (int) (0))
end: lm_compiler_foreign_free

fn: lm_compiler_ret_code_of_formal (int: ft; @: out_ty int) int
    int: depth
    int: qualified
    c.LmP0Text: word
    ft: lm_compiler_formal_raw(ft)
    \out_ty: ft
    if: ft = 34
        \out_ty: 33
    if: ft = 12
        \out_ty: 3
    if: ft = 3
        \out_ty: 35
    if: ft = 17
        \out_ty: 32
    # Preserve the established return-code adapters; all other pointer types
    # use the same stable closed type interner as declarations and addresses.
    if: ft != 3 && ft != 12 && ft != 16 && ft != 17 && ft < 100 && lm_compiler_pointer_depth(ft) > 0
        if: lm_compiler_type_parts(ft, @ word, @ depth, @ qualified) != 0
            return: (cast: (int) (1))
        \out_ty: lm_compiler_foreign_intern(@ word, depth, qualified)
        if: \out_ty < 100
            return: (cast: (int) (1))
        ---
    ---
    return: (cast: (int) (0))
end: lm_compiler_ret_code_of_formal

fn: lm_compiler_foreign_intern (const: (@: name c.LmP0Text); int: depth; int: is_const) int
    int: raw_c 0
    c.LmP0Text: raw
    if: c.lm_compiler_c_stmt_door(name) != 0
        raw\data: name\data + 2U
        raw\length: name\length - 2U
        name: @ raw
        raw_c: 1
    ---
    return: (cast: (int) (lm_compiler_foreign_intern_parts(name, depth, is_const, raw_c)))
end: lm_compiler_foreign_intern

fn: lm_compiler_foreign_intern_parts (const: (@: name c.LmP0Text); int: depth; int: is_const; int: raw_c) int
    @: foreign_n_cell int (cast: (@: int) (@ c.l2_foreign_n))
    @@: foreign_depth_cell int (cast: (@@: int) (@ c.l2_foreign_depth))
    @@: foreign_const_cell int (cast: (@@: int) (@ c.l2_foreign_const))
    @@: foreign_raw_c_cell int (cast: (@@: int) (@ c.l2_foreign_raw_c))
    @@@: foreign_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_foreign_name))
    @: alloc_err_cell int (cast: (@: int) (@ c.l2_alloc_err))
    @: foreign_cap_cell int (cast: (@: int) (@ c.l2_foreign_cap))
    int: i 0
    int: cap
    size_t: nb
    @: saved c.LmP0Text
    @@: nn c.LmP0Text 0
    @: nd int 0
    @: nc int 0
    @: nr int 0
    if: name = 0 || c.lm_compiler_ident_word(name) = 0 || depth < 0
        return: (cast: (int) (0 - 1))
    # A foreign type is spelled as written (Stage B, Mikhail 2026-09-14): no
    # header is read to admit it, and the C compiler checks the spelling.
    while: i < foreign_n_cell[0]
        if: foreign_depth_cell[0][i] = depth && foreign_const_cell[0][i] = is_const && foreign_raw_c_cell[0][i] = raw_c && c.lm_compiler_text_same(foreign_name_cell[0][i], name)
            return: (cast: (int) (100 + i))
        i: i + 1
    if: foreign_n_cell[0] = c.INT_MAX - 100
        alloc_err_cell[0]: 2
        return: (cast: (int) (0 - 1))
    if: foreign_n_cell[0] >= foreign_cap_cell[0]
        cap: foreign_cap_cell[0]
        if: cap < 1
            cap: 4
        while: cap <= foreign_n_cell[0]
            if: cap > c.INT_MAX / 2
                cap: foreign_n_cell[0] + 1
            else:
                cap: cap * 2
            ---
        ---
        if: c.lm_compiler_mul_ok((cast: (size_t) cap), c.sizeof((cast: (@: char) 0))) = 0 || c.lm_compiler_mul_ok((cast: (size_t) cap), c.sizeof(c.int)) = 0
            alloc_err_cell[0]: 2
            return: (cast: (int) (0 - 1))
        nb: (cast: (size_t) cap) * c.sizeof((cast: (@: char) 0))
        nn: (cast: (@@: c.LmP0Text) c.lm_compiler_xmalloc(nb))
        nd: (cast: (@: int) c.lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        nc: (cast: (@: int) c.lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        nr: (cast: (@: int) c.lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        if: nn = 0 || nd = 0 || nc = 0 || nr = 0
            if: nn != 0
                c.lm_compiler_xfree((cast: (@: void) nn))
            if: nd != 0
                c.lm_compiler_xfree((cast: (@: void) nd))
            if: nc != 0
                c.lm_compiler_xfree((cast: (@: void) nc))
            if: nr != 0
                c.lm_compiler_xfree((cast: (@: void) nr))
            return: (cast: (int) (0 - 1))
        if: foreign_n_cell[0] > 0
            c.memcpy((cast: (@: void) nn), (cast: (@: void) foreign_name_cell[0]), (cast: (size_t) foreign_n_cell[0]) * c.sizeof((cast: (@: char) 0)))
            c.memcpy((cast: (@: void) nd), (cast: (@: void) foreign_depth_cell[0]), (cast: (size_t) foreign_n_cell[0]) * c.sizeof(c.int))
            c.memcpy((cast: (@: void) nc), (cast: (@: void) foreign_const_cell[0]), (cast: (size_t) foreign_n_cell[0]) * c.sizeof(c.int))
            c.memcpy((cast: (@: void) nr), (cast: (@: void) foreign_raw_c_cell[0]), (cast: (size_t) foreign_n_cell[0]) * c.sizeof(c.int))
        ---
        if: foreign_name_cell[0] != 0
            c.lm_compiler_xfree((cast: (@: void) foreign_name_cell[0]))
        if: foreign_depth_cell[0] != 0
            c.lm_compiler_xfree((cast: (@: void) foreign_depth_cell[0]))
        if: foreign_const_cell[0] != 0
            c.lm_compiler_xfree((cast: (@: void) foreign_const_cell[0]))
        if: foreign_raw_c_cell[0] != 0
            c.lm_compiler_xfree((cast: (@: void) foreign_raw_c_cell[0]))
        foreign_name_cell[0]: nn
        foreign_depth_cell[0]: nd
        foreign_const_cell[0]: nc
        foreign_raw_c_cell[0]: nr
        foreign_cap_cell[0]: cap
    ---
    # A new interned contract owns its text, including bytes from a predef
    # document that may be destroyed before this contract is emitted.
    saved: c.lm_compiler_text_clone(name)
    if: saved = 0
        return: (cast: (int) (-1))
    foreign_name_cell[0][foreign_n_cell[0]]: saved
    foreign_depth_cell[0][foreign_n_cell[0]]: depth
    foreign_const_cell[0][foreign_n_cell[0]]: is_const
    foreign_raw_c_cell[0][foreign_n_cell[0]]: raw_c
    i: foreign_n_cell[0]
    foreign_n_cell[0]: foreign_n_cell[0] + 1
    # Source-driven predef/include: the unit declares what runtime headers it needs.
    # Name/prefix triggers (LmP0*, c.lm_p0_set_diagnostic, per-name stdlib/string) are gone.
    return: (cast: (int) (100 + i))
end: lm_compiler_foreign_intern_parts

fn: lm_compiler_foreign_byvalue (const: (@: t c.LmP0Text)) int
    if: t = 0 || t\data = 0
        return: (cast: (int) (0 - 1))
    if: t\length > 2U && t\data[0] = 99 && t\data[1] = 46
        return: (cast: (int) (lm_compiler_foreign_intern(t, 0, 0)))
    ---
    # Bare foreign by-value names are refused (type-position rule, ticket 106 PART2).
    return: (cast: (int) (0 - 1))
end: lm_compiler_foreign_byvalue

fn: lm_compiler_foreign_native_void (int: i) int
    @: foreign_n_cell int (cast: (@: int) (@ c.l2_foreign_n))
    @@: foreign_raw_c_cell int (cast: (@@: int) (@ c.l2_foreign_raw_c))
    @@: foreign_depth_cell int (cast: (@@: int) (@ c.l2_foreign_depth))
    @@@: foreign_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_foreign_name))
    if: i < 0 || i >= foreign_n_cell[0] || foreign_raw_c_cell[0][i] != 0 || foreign_depth_cell[0][i] < 1
        return: (cast: (int) (0))
    return: (cast: (int) (c.lm_compiler_text_eq(foreign_name_cell[0][i], "Lmx") || c.lm_compiler_text_eq(foreign_name_cell[0][i], "LmxArray")))
end: lm_compiler_foreign_native_void

fn: lm_compiler_write_foreign_native (@: out c.FILE; int: i) int
    @@@: foreign_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_foreign_name))
    if: lm_compiler_foreign_native_void(i) != 0
        return: (cast: (int) ((cast: (int) (c.fputs("void", out) < 0))))
    return: (cast: (int) (c.lm_compiler_write_text(out, foreign_name_cell[0][i])))
end: lm_compiler_write_foreign_native

fn: lm_compiler_emit_foreign_named (@: out c.FILE; int: ty; const: (@: prefix char); const: (@: name c.LmP0Text)) int
    @: foreign_n_cell int (cast: (@: int) (@ c.l2_foreign_n))
    @@: foreign_depth_cell int (cast: (@@: int) (@ c.l2_foreign_depth))
    @@@: foreign_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_foreign_name))
    @@: foreign_const_cell int (cast: (@@: int) (@ c.l2_foreign_const))
    int: i ty - 100
    if: out = 0 || i < 0 || i >= foreign_n_cell[0]
        return: (cast: (int) (1))
    if: prefix != 0 && c.fputs(prefix, out) < 0
        return: (cast: (int) (1))
    if: foreign_depth_cell[0][i] = 0
        if: c.lm_compiler_write_text(out, foreign_name_cell[0][i]) != 0 || c.fputs(": ", out) < 0 || c.lm_compiler_write_text(out, name) != 0
            return: (cast: (int) (1))
        return: (cast: (int) (0))
    if: foreign_const_cell[0][i] != 0 && c.fputs("const: ", out) < 0
        return: (cast: (int) (1))
    if: c.lm_compiler_emit_address_marks(out, foreign_depth_cell[0][i]) != 0
        return: (cast: (int) (1))
    if: foreign_const_cell[0][i] != 0
        if: c.fputs("(", out) < 0
            return: (cast: (int) (1))
        ---
    else:
        if: c.fputs(": ", out) < 0
            return: (cast: (int) (1))
    ---
    if: lm_compiler_write_foreign_native(out, i) != 0
        return: (cast: (int) (1))
    if: c.fputs(" ", out) < 0 || c.lm_compiler_write_text(out, name) != 0
        return: (cast: (int) (1))
    if: foreign_const_cell[0][i] != 0 && c.fputs(")", out) < 0
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: lm_compiler_emit_foreign_named

fn: lm_compiler_emit_foreign_temp (@: out c.FILE; int: ty; const: (@: ind char); int: temp) int
    @: foreign_n_cell int (cast: (@: int) (@ c.l2_foreign_n))
    @@: foreign_const_cell int (cast: (@@: int) (@ c.l2_foreign_const))
    @@: foreign_depth_cell int (cast: (@@: int) (@ c.l2_foreign_depth))
    @@@: foreign_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_foreign_name))
    int: i ty - 100
    if: out = 0 || i < 0 || i >= foreign_n_cell[0]
        return: (cast: (int) (1))
    if: c.fputs(ind, out) < 0
        return: (cast: (int) (1))
    # A const foreign pointer keeps its qualifier: `const: @(T l2_tN)`.
    if: foreign_const_cell[0][i] != 0
        if: foreign_depth_cell[0][i] < 1 || c.fputs("const: ", out) < 0 || c.lm_compiler_emit_address_marks(out, foreign_depth_cell[0][i]) != 0 || c.fputs("(", out) < 0 || lm_compiler_write_foreign_native(out, i) != 0 || c.fprintf(out, " l2_t%d)\n", temp) < 0
            return: (cast: (int) (1))
        return: (cast: (int) (0))
    if: foreign_depth_cell[0][i] = 0
        if: c.lm_compiler_write_text(out, foreign_name_cell[0][i]) != 0 || c.fprintf(out, ": l2_t%d\n", temp) < 0
            return: (cast: (int) (1))
        return: (cast: (int) (0))
