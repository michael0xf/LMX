---
    Observed:
        int: seen 10
        int: x 10
        int: pad 99
        int: inline_seen 7
        int: inline_x 1
        int: inline_pad 90
    end: Observed
---
@: shared (data [] 0)
sub: main () (
    D:
        int: seen 0
        int: pad 99
        int: x 10
    end: D
    Code:
        :=: (data \ seen) x
        int: x 2
        int: x 3
    end: Code
    Inline:
        int: pad 90
        int: x 1
        int: seen 0
        if: 1 ((int x 7))
        :=: (data \ seen) x
    end: Inline
)
    call: D Code
    call: Inline
end: main
main:
int: seen (((main \ data) \ D) \ seen)
int: x (((main \ data) \ D) \ x)
int: pad (((main \ data) \ D) \ pad)
int: inline_seen (((main \ data) \ Inline) \ seen)
int: inline_x (((main \ data) \ Inline) \ x)
int: inline_pad (((main \ data) \ Inline) \ pad)
sub: observe ()
    :=: ((shared \ Observed) \ seen) seen
    :=: ((shared \ Observed) \ x) x
    :=: ((shared \ Observed) \ pad) pad
    :=: ((shared \ Observed) \ inline_seen) inline_seen
    :=: ((shared \ Observed) \ inline_x) inline_x
    :=: ((shared \ Observed) \ inline_pad) inline_pad
end: observe
observe:
