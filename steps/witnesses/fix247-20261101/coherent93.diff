+# A raw dereference raises `interpreter` on a null holder wherever Lower lowers
+# it as the checked walker DEREF (LMX_semantics #exceptions);
+# lm_compiler_indirect_managed is that one classification, so the method gets
+# the status channel. A dereference without a pointer contract is Lower's
+# diagnostic.
+fn: lm_compiler_indirect_span_raises (@: span c.L2ValueSpan; int: mi) int
+    c.L2ValueSpan: operand
+    int: levels 0
+    int: source_type -1
+    int: result_type -1
+    if: span = 0 || span\operand = 0 || span\node = 0 || span\node\kind != c.LM_P0_NODE_ATOM || span\node\as = 0 || c.lm_compiler_is_slash((cast: (const: @: c.LmP0Text) (span\node\as\atom))) = 0
+        return: 0
+    if: c.lm_compiler_indirect_span(span, mi, @ operand, @ levels, @ source_type, @ result_type) != 0
+        return: 0
+    return: c.lm_compiler_indirect_managed(levels, source_type, mi)
+end: lm_compiler_indirect_span_raises
+
+# The field scan meets the same dereference as its prefix atom: the common value
+# grammar prepares its one operand, then it is classified as above.
+fn: lm_compiler_fields_indirect_raises (@: first c.LmP0Field; int: count; int: mi) int
+    c.L2ValueSpan: span
+    int: raises 0
+    if: c.lm_compiler_value_span_prepare(first, count, @ span) > 1
+        raises: lm_compiler_indirect_span_raises(@ span, mi)
+    c.lm_compiler_value_span_release(@ span)
+    return: raises
+end: lm_compiler_fields_indirect_raises
