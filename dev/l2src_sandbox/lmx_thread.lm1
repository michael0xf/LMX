predef: "l2src/lmx_thread.h.lm1"
predef: "l2src/lmx_implements.h.lm1"
predef: "l2src/lmx_call.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_clock.lm1"
predef: "l2src/lmx_manager.lm1"
predef: "l2src/lmx_settle.lm1"
predef: "l2src/lmx_list_owned.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"

# lmx_thread.lm1 - running an L3 Thread's turns, and the kernel side of lmx.h's poll hook.
#
# An L3 Thread begins with one by-value closed Message record (model 25). The shared prefix has
# the exact Thread address; mailbox, turn, scheduler and all other mechanisms follow it and remain
# outside LmxMsg. The
# boundary the spec names (19.29.7.1, model 31) is here: `running` is read at the
# turn boundary, and a zero read there is a stop request -- never the message's own
# completion.  `success` is the only completion mark, and a heartbeat, an empty
# inbox or the end of a single turn must not set it.
#
# Polling is a Thread act: a plain letter has no turn, so a message that is not
# being executed has no current state and the hooks answer 0.  lmx.h declares the
# two hooks and leaves their bodies to the kernel because an executable body in a
# header unit is refused; these are those bodies, and the fast path is what
# 19.29.7.1 asks for -- an ordinary flag load and test, no fence, no read-modify-
# write, no helper call in the path.
#
# The current object is PER THREAD, not per runtime: a turn belongs to the thread that
# runs it, so two lanes running two Threads at the same time must not see each other's
# current.  That is what `thread_local:` (C11 _Thread_local) is for, and L1 has had the
# spelling since Mikhail's TLS step landed (l1trans f42eabc: the qualifier is admitted on
# unit-level globals and the definition stays in the .lm1 unit).  What the kernel still
# does NOT promise is that a lane exists: a runtime may step its objects on one OS thread,
# and then the cell is one cell for that thread -- which is the same thing, one level down.
thread_local: @: LmxThread lmx_thread_current_slot 0

fn: lmx_thread_current () @: LmxThread
return: lmx_thread_current_slot

fn: lmx_thread_init (@: LmxArena arena; @: LmxThread t; @: Lmx graph; @: LmxPost mail; @: LmxSchedule slot) int
    @: LmxMsg message
    if: arena = 0 || t = 0
        return: c.LMX_THREAD_INVALID
    # Construction accepts only an exact Thread range. The range deliberately carries the common
    # Message kind, so generic Message operations also admit this same prefix address; exact type
    # is what refuses a standalone LmxMsg cast to LmxThread. The constructor supplies the owner
    # arena explicitly, so validation precedes every Message-tail write and does not impose a
    # schedule-initialization order.
    if: lmx_range_classify(arena, (cast: (@: void) t)) != c.LMX_DOMAIN_KIND_MSG_RECORD || lmx_range_type_of(arena, (cast: (@: void) t)) != c.LMX_DOMAIN_THREAD || lmx_range_stride(arena, (cast: (@: void) t)) != c.sizeof(c.LmxThread) || lmx_range_home(arena, (cast: (@: void) t)) != arena
        return: c.LMX_THREAD_INVALID
    ---
    if: graph = 0 || mail = 0 || slot = 0
        return: c.LMX_THREAD_INVALID
    ---
    # Every mechanism is an exact cell owned by this Thread's arena.  Validate the complete
    # construction tuple before touching either the Message prefix or the Thread tail: a forged
    # common-kind range, a foreign graph/mail/schedule, or a wrong-stride exact type cannot turn
    # an address into an executable object.
    if: lmx_range_classify(arena, (cast: (@: void) graph)) != c.LMX_KIND_STRUCT || lmx_range_type_of(arena, (cast: (@: void) graph)) != c.LMX_TYPE_STRUCT || lmx_range_stride(arena, (cast: (@: void) graph)) != c.sizeof(c.Lmx) || lmx_range_home(arena, (cast: (@: void) graph)) != arena
        return: c.LMX_THREAD_INVALID
    ---
    if: lmx_range_classify(arena, (cast: (@: void) mail)) != c.LMX_DOMAIN_KIND_POST || lmx_range_type_of(arena, (cast: (@: void) mail)) != c.LMX_DOMAIN_POST || lmx_range_stride(arena, (cast: (@: void) mail)) != c.sizeof(c.LmxPost) || lmx_range_home(arena, (cast: (@: void) mail)) != arena
        return: c.LMX_THREAD_INVALID
    ---
    if: lmx_range_classify(arena, (cast: (@: void) slot)) != c.LMX_DOMAIN_KIND_SCHEDULE || lmx_range_type_of(arena, (cast: (@: void) slot)) != c.LMX_DOMAIN_SCHEDULE || lmx_range_stride(arena, (cast: (@: void) slot)) != c.sizeof(c.LmxSchedule) || lmx_range_home(arena, (cast: (@: void) slot)) != arena
        return: c.LMX_THREAD_INVALID
    ---
    # Construction is historically usable in two orders: most callers initialise the schedule
    # first, while a few bootstrap fixtures bind a freshly zeroed exact schedule cell and fill it
    # immediately afterwards.  The zero cell is therefore the only deferred form.  Once any
    # schedule identity field is present, the complete binding must already name this exact Thread
    # and this exact arena; accepting another owner/band here would make the manager execute a
    # different Thread and make this Thread's end-turn collect the wrong arena.
    if: slot\owner != 0 || slot\arena != 0 || slot\started != 0U || slot\limit != 0U || slot\state != 0 || slot\lane != 0
        if: slot\owner != (cast: (@: void) t) || slot\arena != arena || slot\started != 0U || slot\limit = 0U || slot\state != c.LMX_SCHEDULE_IDLE || slot\lane != 0
            return: c.LMX_THREAD_INVALID
        ---
    ---
    message: (cast: (@: LmxMsg) t)
    # lmx_child_create has already installed the copied graph in the embedded prefix.  It may be
    # confirmed, never rebound.  A fresh allocation has a zero prefix.  Nonzero tail mechanisms
    # are the durable initialized marker and make a second init fail before any mutation.
    if: t\mail != 0 || t\slot != 0
        return: c.LMX_THREAD_INVALID
    ---
    if: message\graph != 0 && message\graph != graph
        return: c.LMX_THREAD_INVALID
    ---
    message\running: 1
    message\success: 0
    message\handoff_ready: 0
    message\graph: graph
    t\mail: mail
    t\slot: slot
    t\turn: 0U
    t\state: c.LMX_THREAD_IDLE
    # Bootstrap compatibility is an explicit state, not an inference from entry or graph shape.
    # No turn has run yet, so nothing was reserved, and nothing has linked this object into a
    # family: the up-link of the address walk starts empty (lmx_child's publication writes it).
    t\prepared: 0
    t\parent: 0
    t\service: 0
    t\children: 0
    t\alive: 0U
    t\stopped: 0U
    t\close_deadline: 0U
    t\orphaned: 0
    t\orphan_started: 0U
    t\orphan_limit: 0U
    t\result: 0
    t\manager: 0
    # The object's interfaces are composed at initialization, each table separate: the
    # thread's own, and its mail.  A caller gets one or the other, never a merge.
    t\api.enter: lmx_thread_enter
    t\api.leave: lmx_thread_leave
    t\api.running: lmx_thread_running
    t\api.current: lmx_thread_current
    t\mail_api.accept: lmx_thread_mail_accept
    t\mail_api.take: lmx_thread_mail_take
    t\mail_api.count: lmx_thread_mail_count
    t\mail_api.close: lmx_thread_mail_close
return: c.LMX_THREAD_OK

fn: lmx_thread_api (@: LmxThread t) @: LmxThreadApi
    if: t = 0
        return: 0
return: @ t\api

fn: lmx_thread_mail_api (@: LmxThread t) @: LmxThreadMailApi
    if: t = 0
        return: 0
return: @ t\mail_api

fn: lmx_thread_message (@: LmxThread t) @: LmxMsg
    if: t = 0
        return: 0
return: (cast: (@: LmxMsg) t)

fn: lmx_thread_parent (@: LmxThread t) @: LmxThread
    if: t = 0
        return: 0
return: (cast: (@: LmxThread) t\parent)

# The record's own service, read from the STABLE reference registration stores (never from a
# position inside the service's compacted entries vector).
fn: lmx_thread_service (@: LmxThread t) @: void
    if: t = 0
        return: 0
return: t\service

# Live direct children are exactly the physical Thread references in one ordinary graph
# Array<@LmxThread>.  The descriptor is stable while its backing grows; no second chain or queue
# exists.  A caller that constructs a Thread supplies this graph field explicitly and the arena's
# address-range table proves both descriptor type and backing type.

fn: lmx_thread_children_bind (@: LmxThread t; @: void children; @: LmxArena arena) int
    @: LmxMsg message
    @: LmxArrayDesc list
    int: type
    int: found
    int: index
    if: t = 0 || children = 0 || arena = 0 || t\children != 0
        return: c.LMX_THREAD_INVALID
    list: (cast: (@: LmxArrayDesc) children)
    type: c.LMX_TYPE_ARRAY_OF_POINTER_BASE + c.LMX_DOMAIN_THREAD
    if: lmx_range_classify(arena, children) != c.LMX_KIND_LIST
        return: c.LMX_THREAD_INVALID
    if: lmx_range_type_of(arena, children) != type
        return: c.LMX_THREAD_INVALID
    if: lmx_range_home(arena, children) != arena
        return: c.LMX_THREAD_INVALID
    if: list\len != 0U
        return: c.LMX_THREAD_INVALID
    if: list\len > lmx_list_cap((cast: (@: void) list))
        return: c.LMX_THREAD_INVALID
    if: lmx_list_cap((cast: (@: void) list)) != 0U
        if: list\data = 0
            return: c.LMX_THREAD_INVALID
        if: lmx_range_classify(arena, list\data) != c.LMX_KIND_PRIMITIVE
            return: c.LMX_THREAD_INVALID
        if: lmx_range_type_of(arena, list\data) != c.LMX_TYPE_POINTER_BASE + c.LMX_DOMAIN_THREAD
            return: c.LMX_THREAD_INVALID
        if: lmx_range_home(arena, list\data) != arena
            return: c.LMX_THREAD_INVALID
        ---
    ---
    # Binding is not enough merely because an Array happens to live in this arena.  It must be
    # the exact physical descriptor already present as an ordinary field of this Thread's graph.
    message: lmx_thread_message(t)
    if: message = 0 || message\graph = 0
        return: c.LMX_THREAD_INVALID
    found: 0
    index: 0
    while: index < message\graph\len
        if: lmx_arena_ref_value(message\graph, (cast: (size_t) index)) = children
            found: 1
        ---
        index: index + 1
    ---
    if: found = 0
        return: c.LMX_THREAD_INVALID
    ---
    t\children: children
return: c.LMX_THREAD_OK

fn: lmx_thread_children_bind_graph (@: LmxThread t; @: LmxArena arena) int
    @: LmxMsg message
    @: Lmx graph
    @: LmxArrayDesc found 0
    @: void value
    int: index
    int: type c.LMX_TYPE_ARRAY_OF_POINTER_BASE + c.LMX_DOMAIN_THREAD
    if: t = 0 || arena = 0 || t\children != 0
        return: c.LMX_THREAD_INVALID
    message: lmx_thread_message(t)
    if: message = 0 || message\graph = 0
        return: c.LMX_THREAD_INVALID
    ---
    graph: message\graph
    index: 0
    while: index < graph\len
        value: lmx_arena_ref_value(graph, (cast: (size_t) index))
        if: value != 0 && lmx_range_classify(arena, value) = c.LMX_KIND_LIST && lmx_range_type_of(arena, value) = type
            if: found != 0
                return: c.LMX_THREAD_INVALID
            ---
            found: (cast: (@: LmxArrayDesc) value)
        ---
        index: index + 1
    ---
    if: found = 0
        return: c.LMX_THREAD_INVALID
    ---
return: lmx_thread_children_bind(t, (cast: (@: void) found), arena)

fn: lmx_thread_children_field_new (@: LmxArena arena; @: Lmx graph; size_t: field) @: void
    @: LmxArrayDesc children
    if: arena = 0 || graph = 0 || field >= graph\len
        return: 0
    ---
    children: (cast: (@: LmxArrayDesc) lmx_list_new_owned(c.LMX_TYPE_ARRAY_OF_POINTER_BASE + c.LMX_DOMAIN_THREAD, arena))
    if: children = 0
        return: 0
    ---
    if: lmx_arena_ref_store(graph, field, (cast: (@: void) children)) != 0
        return: 0
    ---
return: (cast: (@: void) children)

fn: lmx_thread_children (@: LmxThread t) @: void
    if: t = 0
        return: 0
return: t\children

fn: lmx_thread_child_count (@: LmxThread parent) size_t
    if: parent = 0 || parent\children = 0
        return: 0U
return: lmx_list_len(parent\children)

fn: lmx_thread_child_at (@: LmxThread parent; size_t: index) @: LmxThread
    if: parent = 0 || parent\children = 0
        return: 0
return: (cast: (@: LmxThread) lmx_list_value(parent\children, index))

# The address of this Thread's own handshake word (19.29.7.1): the child stamps it with
# milliseconds and its parent reaches it through the physical child reference in the graph Array.
fn: lmx_thread_manager (@: LmxThread t) @: void
    if: t = 0
        return: 0
return: t\manager

# THE OBJECT'S OWN SCHEDULER.  The arena is NAMED BY THE CALLER -- the kernel's own rule ("the
# arena is the context of the act, so the caller supplies it"), and here it is also the only
# correct source: Thread initialization receives its owner arena explicitly and does not infer it
# from schedule state. Refused while one is already open: a second scheduler for one object would
# be a second answer to "which queue steps my children".
fn: lmx_thread_scheduler_open (@: LmxThread t; @: LmxArena arena) int
    @: LmxManager m
    if: t = 0 || arena = 0
        return: c.LMX_THREAD_INVALID
    if: t\manager != 0
        return: c.LMX_THREAD_INVALID
    ---
    m: (cast: (@: LmxManager) lmx_arena_take(arena, c.sizeof(c.LmxManager), c.LMX_DOMAIN_KIND_MANAGER, c.LMX_DOMAIN_MANAGER))
    if: m = 0
        return: c.LMX_THREAD_INVALID
    ---
    if: lmx_manager_init(m) != c.LMX_MANAGER_OK
        return: c.LMX_THREAD_INVALID
    ---
    if: lmx_manager_bind(m, t) != c.LMX_MANAGER_OK
        return: c.LMX_THREAD_INVALID
    ---
    t\manager: (cast: (@: void) m)
return: c.LMX_THREAD_OK

fn: lmx_thread_alive_cell (@: LmxThread t) @: size_t
    if: t = 0
        return: 0
return: @ t\alive

fn: lmx_thread_child_is (@: LmxThread parent; @: LmxThread child) int
    size_t: index
    if: parent = 0 || child = 0
        return: 0
    ---
    index: 0U
    while: index < lmx_thread_child_count(parent)
        if: lmx_thread_child_at(parent, index) = child
            return: 1
        ---
        index: index + 1U
    ---
return: 0

# The physical value is appended to the one Array in the parent's graph.  Growth is the standard
# Array growth (minimum 2, then approximately 1.5x); it never relocates a live referent.
fn: lmx_thread_child_add (@: LmxThread parent; @: LmxThread child; @: LmxArena into) int
    @: LmxArena arena
    if: parent = 0 || child = 0 || parent = child || child\parent != 0
        return: c.LMX_THREAD_INVALID
    ---
    if: lmx_thread_child_is(parent, child) != 0
        return: c.LMX_THREAD_INVALID
    ---
    arena: into
    if: arena = 0 && parent\slot != 0
        arena: parent\slot\arena
    ---
    if: arena = 0
        return: c.LMX_THREAD_INVALID
    ---
    if: parent\children = 0
        return: c.LMX_THREAD_INVALID
    if: lmx_range_home(arena, parent\children) != arena
        return: c.LMX_THREAD_INVALID
    if: lmx_list_cap(parent\children) != 0U && lmx_range_home(arena, lmx_list_data(parent\children)) != arena
        return: c.LMX_THREAD_INVALID
    ---
    ---
    if: lmx_list_append_owned(parent\children, (cast: (@: void) child), arena) != c.LMX_LIST_OK
        return: c.LMX_THREAD_INVALID
    ---
    child\parent: (cast: (@: void) parent)
return: c.LMX_THREAD_OK

fn: lmx_thread_child_remove (@: LmxThread parent; @: LmxThread child) int
    size_t: index
    if: parent = 0 || child = 0 || child\parent != (cast: (@: void) parent)
        return: c.LMX_THREAD_INVALID
    ---
    if: parent\children = 0
        return: c.LMX_THREAD_INVALID
    index: 0U
    while: index < lmx_list_len(parent\children)
        if: lmx_thread_child_at(parent, index) = child
            if: parent\slot = 0 || parent\slot\arena = 0
                return: c.LMX_THREAD_INVALID
            if: lmx_list_remove_owned(parent\children, index, 0, parent\slot\arena) != c.LMX_LIST_OK
                return: c.LMX_THREAD_INVALID
            child\parent: 0
            return: c.LMX_THREAD_OK
        ---
        index: index + 1U
    ---
return: c.LMX_THREAD_INVALID

fn: lmx_thread_child_first (@: LmxThread parent) @: LmxThread
return: lmx_thread_child_at(parent, 0U)

fn: lmx_thread_child_next (@: LmxThread child) @: LmxThread
    @: LmxThread parent
    size_t: index
    if: child = 0
        return: 0
    parent: lmx_thread_parent(child)
    if: parent = 0
        return: 0
    index: 0U
    while: index < lmx_thread_child_count(parent)
        if: lmx_thread_child_at(parent, index) = child
            return: lmx_thread_child_at(parent, index + 1U)
        ---
        index: index + 1U
    ---
return: 0

# The mail API's methods.  Each one delegates: today to the mailbox module, later to
# the mail service -- the caller's interface stays what it is.  The arena the delegate
# needs is the caller's to name: this state holds the mailbox, not the arena.
fn: lmx_thread_mail_accept (@: LmxArena arena; @: LmxThread t; @: void target; int: lane) int
    if: t = 0 || t\mail = 0
        return: c.LMX_POST_INVALID
return: lmx_post_accept(arena, t\mail, target, lane)

fn: lmx_thread_mail_take (@: LmxThread t; int: lane) @: void
    if: t = 0 || t\mail = 0
        return: 0
    if: t\slot = 0
        return: 0
    ---
return: lmx_post_take_owned(t\slot\arena, t\mail, lane)

fn: lmx_thread_mail_count (@: LmxThread t; int: lane) size_t
    if: t = 0 || t\mail = 0
        return: 0U
return: lmx_post_count(t\mail, lane)

fn: lmx_thread_mail_close (@: LmxArena arena; @: LmxThread t) int
    @: LmxPost box
    if: t = 0 || t\mail = 0
        return: c.LMX_POST_INVALID
    ---
    box: t\mail
    if: lmx_post_close(arena, box) != c.LMX_POST_OK
        return: c.LMX_POST_INVALID
    ---
    # EXACTLY-ONCE, and it is the existing guard that enforces it: with the mailbox forgotten, a
    # second close (and accept, take, count) refuses through `if: t\mail = 0` above, and a delivery
    # aimed at this record refuses in lmx_service_post, which answers MISSING when t\mail = 0.
    t\mail: 0
return: c.LMX_POST_OK

fn: lmx_thread_running (@: LmxThread t) int
    @: LmxMsg message
    message: lmx_thread_message(t)
    if: message = 0
        return: 0
return: message\running






# Entering a turn.  Refused when the object is already done (a close never
# resurrects it) and refused when the boundary says stop: not running, or already
# successful.  Otherwise the turn cursor advances and this object becomes the
# current one.
fn: lmx_thread_enter (@: LmxThread t) int
    @: LmxMsg message
    message: lmx_thread_message(t)
    if: message = 0
        return: c.LMX_THREAD_INVALID
    if: t\state = c.LMX_THREAD_DONE
        return: c.LMX_THREAD_STOPPED
    if: t\state = c.LMX_THREAD_TURN
        return: c.LMX_THREAD_INVALID
    if: message\running = 0 || message\success != 0
        t\state: c.LMX_THREAD_DONE
        return: c.LMX_THREAD_STOPPED
    t\turn: t\turn + 1U
    t\state: c.LMX_THREAD_TURN
    lmx_thread_current_slot: t
return: c.LMX_THREAD_OK

fn: lmx_thread_leave (@: LmxThread t) int
    @: LmxMsg message
    if: t = 0
        return: c.LMX_THREAD_INVALID
    message: lmx_thread_message(t)
    if: t\state = c.LMX_THREAD_TURN
        t\state: c.LMX_THREAD_IDLE
    lmx_thread_current_slot: 0
    # The Message marks ITSELF handoff-safe when it has left its last turn and nothing
    # native uses its arena (model 32 / spec 19.29.7.1): the work is over -- stopped or
    # successful -- so the arena may be attached (19.29.7).  An ordinary turn leaves the
    # mark alone: the work continues and the arena is not free yet.
    if: message != 0 && (message\running = 0 || message\success != 0)
        message\handoff_ready: 1
        # ... and running is cleared HERE, at the boundary that ENDS the incarnation -- the
        # flag's own contract (lmx_message.h.lm1: "1 while the work is assigned; cleared at the
        # turn boundary that ends the incarnation.  One designated cross-lane writer: the parent
        # stopping a child, or the lane that takes the turn").  This is that lane.
        #
        # Read the guard as ONE statement: this object will not take another turn -- either the
        # work is over (success), or it was already ended from outside (running = 0).  That is
        # exactly when 0 may be written here, in Mikhail's words: "когда уже вышли из последнего
        # цикла и больше не делаем turn то обнулили running; до этого подобное обнуление --
        # признак аварии и делает его по спеке пока только родитель".
        #
        # The two ways an incarnation ends, and the ORDER that tells them apart (Mikhail,
        # 2026-09-19: "тело выходит нормальным способом в нормальном режиме, выход из тела по
        # running=0 это авария"):
        #   normal -- the body leaves its loop by SUCCESS, returns, and the exit clears 0 here;
        #             a finished Message therefore reads success && !running.
        #   emergency -- 0 arrived FIRST (the parent's stop request, or the child's own close
        #             when the parent goes silent), the body was driven out of its loop by
        #             lmx_msg_poll_escape, and success stayed 0; this store is a no-op then.
        # An ORDINARY turn (success = 0, running = 1) is left alone: another turn is coming, and
        # permission to continue is exactly what must not be touched between turns.  The
        # emergency zero, by contrast, is the PARENT's act and leaves success = 0 behind it --
        # what the settling side then holds is a snapshot of arenas that never completed
        # (19.29.8's failure path: adopt without copying, retain the failure root).  Same store,
        # opposite meaning, told apart by success and by who wrote it.  Before this store nothing cleared
        # running on the normal path at all, so the settling side -- whose gate is running = 0 --
        # never reclaimed a child that had finished successfully, and the leak appeared exactly
        # when the parent was healthy enough to answer the handshake (the child, having left its
        # last turn, never stamped again and so was never emergency-closed either).
        message\running: 0
        # The child record remains valid until its serialized parent removes the exact physical
        # reference from the sole membership Array and settles the arena.  No outcome copy in a
        # parallel membership record is therefore needed.
    ---
return: c.LMX_THREAD_OK

# ONE TURN, whole.  See the header for what the acts are; what is worth spelling out here is the
# ORDER, because the order is what makes the body a body:
#
#   enter (the cursor advances, lm.current becomes this object)
#     -> the body: the caller's own handler, or the callable THIS GRAPH names
#     -> leave (lm.current clears; the handoff mark, if the work is over)
#     -> the boundary (19.29.4.1: outcome, outbox, children, collection)
#
# The body's answer is not a stop and is not stored: what ends an object's work is the Message's
# flags, and a handler that reports a status is reporting its own business (model 31).  A turn the
# boundary refuses is not a turn, so nothing of it is written.
fn: lmx_thread_dispatch_native (@: LmxThread t; LmxCallEntry: entry) int
    @: LmxMsg message
    @: Lmx graph
    @: LmxArena arena
    int: st
    int: fail
    message: lmx_thread_message(t)
    if: message = 0
        return: c.LMX_THREAD_INVALID
    ---
    graph: message\graph
    if: graph != 0
        if: entry != 0
            # THE HANDLER'S ANSWER IS ITS OWN BUSINESS AND IS NOT REINTERPRETED (model 31, stated
            # in the turn's own comment above and in lmx_thread.h.lm1).  A native handler that
            # returns a status is reporting its own business; the turn that ran it is failed by
            # the MESSAGE'S FLAGS, which is this kernel's existing contract for a native turn and
            # is not redefined here.  Only the INTERPRETER's status is carried (lmx_thread_turn):
            # that is the boundary whose failure has to reach the turn -- a primitive failure
            # inside an interpreted activation -- and it has no other meaning to lose.
            # A non-null `entry` is only the synthetic R0/host adapter. Its graph stands in the
            # callable-occurrence position, so its reserved ABI `node` is graph.parent -- which is
            # 0, because the graph hanging in a Thread is independent (parent = 0).  Ordinary
            # graph callables take the branch below and lmx_call0 passes M.parent. Neither path
            # rebinds node while executing control bodies nested inside the current method.
            entry(graph\parent)
        else:
            if: t\slot != 0
                arena: t\slot\arena
                if: arena != 0
                    # One turn shape: lmx_call0. L2 walk returns an activation int (ignored
                    # here -- model 31 / Message flags) on success. G2: a nonzero walk_run
                    # status (METHOD throw / walk failure) is in lmx_call_walk_fail_status
                    # and stops the Message like today's entry adapter (S1.1 numbering).
                    # L3 bind installs a status walk: INTERP_* is the turn body status.
                    st: lmx_call0(arena, graph)
                    if: lmx_call_walk_returns_status() != 0
                        if: st = c.LMX_CALL_NOT_CALLABLE
                            return: c.LMX_TURN_BODY_OK
                        ---
                        return: st
                    ---
                    fail: lmx_call_walk_fail_status()
                    if: fail != 0
                        message\running: 0
                        return: fail
                    ---
                ---
            ---
        ---
    ---
return: c.LMX_TURN_BODY_OK

fn: lmx_thread_turn (@: LmxThread t; LmxCallEntry: entry; ulong: now) int
    @: LmxMsg message
    int: code
    int: body c.LMX_TURN_BODY_OK
    size_t: ctx_deadline 0U
    message: lmx_thread_message(t)
    if: message = 0
        return: c.LMX_THREAD_INVALID
    # One turn shape: enter, body via dispatch_native (lmx_call0), leave, boundary.
    code: lmx_thread_enter(t)
    if: code != c.LMX_THREAD_OK
        # A THREAD STOPPED FROM OUTSIDE MUST STILL CLOSE ITS OWN LEVEL.  Its boundary acts are
        # unreachable here: enter refused before lmx_turn_end_status, which is the only route to
        # lmx_stop_children.  And nobody above will do it for it -- lmx_manager_step takes a stopped
        # record out of the queue and does not re-add it, and lmx_thread_finish refuses while the
        # record still has children -- so its subtree would be orphaned in place.  So the one-level
        # duty is performed HERE, with THIS thread's own manager and its own arena and service.
        if: code = c.LMX_THREAD_STOPPED && message\running = 0
            # NOTHING WAS ENTERED, SO NOTHING IS IN FLIGHT: this Thread runs its own one-level
            # cascade NOW, and only when its own child chain is empty does it publish its
            # handoff-safe boundary.  THE ORDER IS NOT COSMETIC: publishing first would let a
            # concurrent parent observe the boundary and settle this Thread's arena while its
            # grandchildren are still live.  Nothing was entered, so no window is waited out --
            # the window stays for the case it was written for, a child that might be MID-TURN.
            # THE BOUNDARY IS PUBLISHED ONLY ON A SUCCESSFUL CASCADE (item 1), AND ONLY WHEN THIS
            # RECORD'S OWN LANE HAS ENDED.  Both halves were measured.  A refused cascade leaves a
            # chain that is not provably empty, so a refusal stops the next act rather than being
            # stepped over.  And a cascade that ran on the PARENT's thread (this hook is reached
            # through lmx_manager_round -> lmx_manager_step, whichever manager is stepping) must not
            # speak for a record whose own lane is still unwinding: publishing there let the parent
            # attach the live child's arena -- the running-lane test's check for exactly that is
            # `arena gone while lane alive`.  A record with no lane of its own answers the same
            # question YES, which is the stepped manager's normal state, so the single-threaded
            # close still reaches its boundary at once and never waits out a window it does not need.
            # A MANAGER IS NOT REQUIRED FOR THIS DUTY, and demanding one was measured wrong
            # (2026-09-21): a record whose own manager field was zero was stepped, stopped, and then
            # published nothing at all, so its parent waited out that child's whole slot window --
            # 100000 ms of real time in both focused tests -- and the close's overall bound aborted
            # first.  The cascade asks its manager ONLY when it has children to drive (`if: manager
            # != 0` around the round inside the helper); what the act needs is the thread's OWN
            # arena, which its slot names.
            # A nested cascade cannot see the top close's context from here (it arrives through
            # lmx_manager_round -> lmx_manager_step -> this function, and none carries one), so it
            # passes no bound of its own and the top's bound remains the only overall one.
            # THE CLOSURE DEADLINE COMES FROM THIS RECORD'S OWN NODE -- the parent's cell, holding
            # the ONE value the upper close computed, so this level hands down exactly what it was
            # given under either manager binding and with no value crossing a thread boundary: the
            # lane reads the same cell the stepped path reads, each through lmx_link_deadline.  A
            # record whose parent published none (a stop that is not a closure) passes zero, and its
            # subtree is then bounded by the children's own slot windows, as it was before.
            ctx_deadline: lmx_thread_close_deadline(t)
            # THE ACT IS THE CHILD'S OWN CLOSE, NOT A REAP AND NOTHING IS PUBLISHED HERE.  A record
            # that was stopped runs the same one-level close its parent would run for it if it were
            # quiescent (lmx_settle_close_one_level), and `handoff_ready` is left alone: that flag
            # means an ARENA WAS HANDED OVER, and a child that has merely closed has handed nothing
            # over.  Publishing it here was the defect the close-chain test caught by name ("the close
            # closed the child instead of asking it").
            if: t\slot != 0
                lmx_settle_close_one_level(t, t\slot\arena, t\service, t\manager, ctx_deadline)
            ---
        ---
        return: code
    ---
    # Body: always dispatch_native -> host entry or lmx_call0.
    body: lmx_thread_dispatch_native(t, entry)
    ---
    lmx_thread_leave(t)
    # THE BOUNDARY RUNS EVEN FOR A FAILED BODY, and it runs WITH the body's status: a failed turn
    # discards what it staged, drops what it reserved, and carries out its cleanup -- before this act reports anything.  A failure that
    # skipped the boundary would leave the letters and the children of a dead turn in flight.
    if: lmx_turn_end_status(t, now, body) != c.LMX_TURN_OK
        return: c.LMX_THREAD_INVALID
    ---
    if: body != c.LMX_TURN_BODY_OK
        # G2: running=0 for a walked throw is written in dispatch_native when
        # lmx_call_walk_fail_status is set (adapter shape). L3 INTERP_* body statuses
        # keep today's contract (Message flags / existing ABI) -- do not blanket-clear.
        # The body failed, and the boundary has run.  What it wrote STANDS: there is no rollback
        # engine and this return value does not promise one -- the turn's graph and own writes
        # are exactly where the body left them, while its staging and its reservations are gone.
        #
        # The report is the Thread ABI's EXISTING failure status.  The finer distinction lives
        # where it is meaningful and stays there: the walk reports a primitive failure as
        # LMX_WALK_PRIMITIVE, and a METHOD trampoline throw as its S1.1 number (G1); the body's
        # status carries it to this line.  The Thread ABI has no status for "a body ran and
        # failed", and this act does not invent one -- adding a value to a public enum is a new
        # contract, not a repair.  (Documented ABI compromise,
        # DEEPSEEK-L2-PRIMITIVE-KERNEL-IMPLEMENT-20260921-27.)
        return: c.LMX_THREAD_INVALID
    ---
return: c.LMX_THREAD_OK

# The loop escape: the object's letter is no longer running, so the loop the
# generated code is inside must be left now.

# Parent half of 19.29.7.1 (ticket 20260919-113000): walk live direct children.
# Read stamp BEFORE zeroing. Fresh (now-stamp < limit, mod 2^32) -> store 0 = ANSWER.
# Stale stamp -> the child is ASKED TO CLOSE: `running=0` + the moment of the first ask in the
# parent's node, and the mark only when that ask has outlived the child's OWN window (19.09 --
# `lmx_stop_request` + `lmx_stop_close`; the box is NOT the test, and the mark is not this act's
# to write: see the long note in the stale branch).
# Zero is NOT a kill signal (already answered / not yet polled). RELAXED; no fences.
fn: lmx_thread_cycle_reading (ulong: v) ulong
return: v

fn: lmx_poll_answer_children (@: LmxThread t; ulong: now) int
    @: LmxThread child
    @: LmxSchedule slot
    size_t: index
    size_t: mark
    ulong: reading
    int: overdue
    reading: lmx_thread_cycle_reading(now)
    if: t = 0
        return: c.LMX_THREAD_INVALID
    # The child remains valid until this parent removes it from the sole Array and settles its
    # arena.  The walk therefore reads that Array directly and never needs a shadow node.
    index: 0U
    while: index < lmx_thread_child_count(t)
        child: lmx_thread_child_at(t, index)
        if: child != 0
            mark: c.__atomic_load_n(lmx_thread_alive_cell(child), c.__ATOMIC_RELAXED)
            # Zero: already answered or child has not stamped yet — leave alone.
            if: mark != 0U
                overdue: 0
                slot: child\slot
                # The reading arrives from the cycle (the caller's), never from the platform here.
                if: slot != 0 && slot\limit != 0U
                    if: reading - (cast: (ulong) mark) >= slot\limit
                        overdue: 1
                    ---
                ---
                ---
                if: overdue = 0
                    c.__atomic_store_n(lmx_thread_alive_cell(child), 0U, c.__ATOMIC_RELAXED)
                else:
                    # THE SILENT CHILD IS ASKED TO CLOSE -- and this act is a REQUESTER, like the
                # cascade, the settle's deferral and the root's close: `lmx_stop_request` writes
                # `running=0` and the MOMENT of the first ask into the PARENT's node, and
                # `lmx_stop_close` closes the child when that ask has outlived the child's OWN
                # window (lmx_thread.h.lm1 carries the model).
                #
                # WHY THE INBOX IS NOT THE TEST HERE EITHER (19.09).  This branch used to close a
                # child whose inbox was EMPTY at once and leave one with pending input stopped and
                # unmarked -- and that second kind was measured UNRECOVERABLE when its parent is
                # alive and not closing: `tests\lmx_app_poll_stale_selftest.lm1`, run 1, with a
                # letter waiting --
                #     PW POLL  mail=1 stopped=0 b_running=0 b_handoff=0 b_mail=1 svc=3
                #     PW CHAIN mail=1 b_count 8->8 svc 3->3 orphans=0
                # -- the child had no turn coming (the entrance refuses on the very `running` this
                # act writes), no moment was recorded for its wait, and the parent was retained for
                # good.  The same child with an empty box was closed and reaped, so the BOX was
                # deciding a lifecycle, which it never could.
                #
                    # AND THE MARK IS NOT THIS ACT'S TO WRITE.  A stale stamp says "no boundary for
                    # a whole window" -- the same quantity the window counts, so the ask is already
                    # due when it is made; but writing the mark here would be the same lie the stop
                    # told before 70ba526 (a child may be INSIDE its turn: measured as
                    # TAKEN_IN_FLIGHT in tests\lmx_app_reroot_forbidden_selftest.lm1, run 3).  The
                    # request is the whole of this act; the close follows from the window, whoever
                    # next walks this parent.
                    lmx_stop_request(child, reading, 0U)
                    lmx_stop_close(child, reading)
                ---
            ---
        ---
        index: index + 1U
    ---
return: c.LMX_THREAD_OK

# Spec 32: "its stop requests their close".  This act lives with the THREAD, next to the poll of
# the same handshake, because it is the supervision of one's own children -- the settle (which is
# what comes AFTER a child has ended) is a separate act in lmx_settle.lm1.
#
# The act has TWO halves and the difference between them is the whole of it (lmx_thread.h.lm1
# carries the model): the REQUEST is `running=0` written at the first call and never moving, and
# the CLOSE is the handoff mark, written only when the child's own window has passed -- for a child
# that reaches no boundary of its own.  A child on its own context closes itself in the meantime,
# and its own leave writes the mark; the parent's stop never writes it early.
#
# Both halves are the parent's own cells where they can be: the request's moment goes into the
# parent's NODE (`stopped`), so this act reads nothing of a child that may be mid-turn except its
# two message flags -- which are the cells model 31 assigns to the one cross-lane writer this act
# is.
# ONE CHILD, ASKED TO CLOSE: `running=0`, and the moment of the FIRST ask goes into the PARENT'S
# node, where the window below is counted from.  A repeated ask changes nothing -- a parent asking
# at every boundary of its own must not keep postponing the close it asked for.
fn: lmx_stop_request (@: LmxThread child; ulong: now; size_t: deadline) int
    @: LmxMsg message
    if: child = 0
        return: c.LMX_THREAD_INVALID
    message: lmx_thread_message(child)
    if: message = 0
        return: c.LMX_THREAD_INVALID
    ---
    message\running: 0
    if: child\stopped = 0U
        child\stopped: now
    ---
    # THE CLOSURE'S ONE DEADLINE, PUBLISHED WITH THE SAME ASK AND INHERITED, NEVER RESTARTED.  Zero
    # means no closure context -- a plain supervision ask leaves it zero on purpose, so a closure
    # that begins later still publishes its own value once.  The publish is the simple atomic
    # first-write (load, then store): the request is serialized by this child's parent, so there
    # is no second writer to lose a
    # race with; the atomicity is what makes the CHILD'S OWN LANE a sound reader of the value.
    lmx_thread_close_deadline_publish(child, deadline)
return: c.LMX_THREAD_OK

# THE CLOSURE DEADLINE AS THE NODE HOLDS IT: one relaxed atomic load of ONE self-contained word.
# A single value needs no ordering against a second field, and the deadline test itself is modular
# (lmx_deadline_passed), so nothing here depends on store ordering.
fn: lmx_thread_close_deadline (@: LmxThread child) size_t
    if: child = 0
        return: 0U
return: c.__atomic_load_n((cast: (@: size_t) (@ child\close_deadline)), c.__ATOMIC_RELAXED)

# THE FIRST CLOSURE WINS: a nonzero value already stored is never overwritten, which is what keeps
# every level reading the value the upper close computed.  Returns 1 when this call stored it.
fn: lmx_thread_close_deadline_publish (@: LmxThread child; size_t: deadline) int
    if: child = 0 || deadline = 0U
        return: 0
    ---
    if: lmx_thread_close_deadline(child) != 0U
        return: 0
    ---
    c.__atomic_store_n((cast: (@: size_t) (@ child\close_deadline)), deadline, c.__ATOMIC_RELAXED)
return: 1

# ONE CHILD, THE END OF THE WAIT: a child that was asked to close and has not reached a boundary of
# its own within its own band's window is closed HERE -- without a turn, stopped AND handoff-safe,
# mail or no mail.  This is the maintenance rule of 19.29.8 ("nothing may be retained forever")
# applied to a stopped child of a closing parent, and it is what makes the mark honest: it is never
# written while a turn can still be in flight, because the window is the same number the handshake
# already trusts for "not reaching a boundary within your window is not working" (lmx_turn_end's
# stamp, lmx_orphan_maintain's retention).
#
# It is called from TWO places and both need it: the parent's stop act (which asks first and closes
# here when the ask is overdue) and the settle's own walk over the children it cannot reap yet (a
# child of the ROOT reaches no deferral -- the root is never settled -- so the walk is the only
# boundary that can end its wait).  The walk calls THIS one only: asking a RUNNING child to stop is
# the cascade's business, never a settle's -- a settle would otherwise stop every live child it
# passed by.
fn: lmx_stop_close (@: LmxThread child; ulong: now) int
    @: LmxMsg message
    @: LmxSchedule slot
    if: child = 0
        return: c.LMX_THREAD_INVALID
    if: child\stopped = 0U
        # An ordinary settle pass is allowed to inspect a live child. No stop protocol exists
        # yet, so there is nothing to age or close and this is not an invalid state.
        return: c.LMX_THREAD_OK
    ---
    message: lmx_thread_message(child)
    if: message = 0
        return: c.LMX_THREAD_INVALID
    ---
    slot: child\slot
    # THE CLOSURE'S DEADLINE, CHECKED WHEREVER A LEVEL WALKS ITS CHILDREN -- at the top and inside
    # every nested cascade alike, because this function is what each pass of each level calls.  It
    # is the SAME word at every level (the node carries it), so no level can restart it.  THE
    # COMPARISON IS MODULAR, and it is the kernel's first stored-deadline test -- the header of
    # lmx_clock.h.lm1 says why that is sound here and why every other timeout site still subtracts.
    # This check is COOPERATIVE: it can only fire where a pass runs.  The process-wide guarantee is
    # the watchdog armed by lmx_root_close from the SAME deadline (lmx_process_deadline), and that
    # is the one that covers a child body which never returns.
    # The inherited word is deliberately not turned into an ordinary INVALID return here. The
    # outer R0 frame owns the one process watchdog for this deadline. Returning at expiry would
    # let R0 disarm that watchdog and expose a half-closed OPEN runtime while a lane still executes.
    # Nested levels only propagate real operation failures; a non-returning body remains in this
    # synchronous cascade until the independent top watchdog terminates the process.
    if: slot != 0 && slot\limit != 0U
        if: now - child\stopped >= slot\limit
            message\handoff_ready: 1
        ---
    ---
    # WHAT USED TO BE HERE IS GONE, AND ITS REMOVAL IS THE CORRECTION THE AUTHOR RULED (2026-09-21):
    # this function published `handoff_ready` as soon as a stopped child's chain was empty and its
    # lane had ended.  `lane == 0` is NOT terminal by itself -- it means only "no active OS lane" --
    # and a child that was merely stopped has NOT ended: it still owes its own terminal close, which
    # the closer now CLAIMS and runs for it (lmx_settle_close_one_level) instead of faking the
    # handoff.  The WINDOW publish above stays: it is the maintenance rule of 19.29.8, and it fires
    # only after the child's OWN window has passed, which is the child's own liveness policy.
return: c.LMX_THREAD_OK

# WHETHER THIS RECORD'S OWN LANE HAS ENDED -- the one question that separates "the boundary may be
# published" from "the record's own thread is still unwinding".  A record with NO lane of its own
# (the stepped manager's normal state, and every child that was never started) answers YES: there is
# no other thread that could still be inside its storage.  A lane that HAS ended is observed the same
# way the running manager observes it -- a zero-timeout reap -- so nothing new is invented here: the
# handle already exists (LmxSchedule.lane) and the join already exists
# (lmx_manager_running_lane_reap).  A handle that has ended but not yet been reaped answers YES:
# the thread is gone either way, and the reap itself stays with the queue that owns the lane.
fn: lmx_thread_lane_ended (@: LmxThread t) int
    @: LmxSchedule slot
    if: t = 0
        return: 0
    slot: t\slot
    if: slot = 0
        return: 1
    if: slot\lane = 0
        return: 1
    if: c.WaitForSingleObject(slot\lane, 0U) = c.WAIT_OBJECT_0
        return: 1
return: 0

fn: lmx_stop_children (@: LmxThread t; ulong: now; size_t: deadline) int
    @: LmxThread child
    @: LmxThread next
    if: t = 0
        return: c.LMX_THREAD_INVALID
    child: lmx_thread_child_first(t)
    while: child != 0
        next: lmx_thread_child_next(child)
        if: lmx_stop_request(child, now, deadline) != c.LMX_THREAD_OK || lmx_stop_close(child, now) != c.LMX_THREAD_OK
            return: c.LMX_THREAD_INVALID
        ---
        child: next
    ---
return: c.LMX_THREAD_OK

# A child publishes its safe completion boundary but does not release its own arena.  Its physical
# Thread address is still a live element of the parent's sole membership Array.  The serialized
# parent removes that exact element first and only then releases or attaches the arena in settle.
# This is intentionally a no-op for storage; it remains the driver's uniform terminal hook.
fn: lmx_thread_finish (@: LmxThread t) int
    if: t = 0
        return: c.LMX_THREAD_INVALID
return: c.LMX_THREAD_OK

fn: lmx_msg_poll_escape () int
    @: LmxThread t
    @: LmxMsg message
    t: lmx_thread_current_slot
    message: lmx_thread_message(t)
    if: message = 0
        return: 0
    if: message\running = 0
        return: 1
return: 0

# The work abort: the letter reports completion, so the remaining work is
# abandoned rather than continued.
fn: lmx_msg_poll_abort () int
    @: LmxThread t
    @: LmxMsg message
    t: lmx_thread_current_slot
    message: lmx_thread_message(t)
    if: message = 0
        return: 0
    if: message\success != 0
        return: 1
return: 0

# -177 c1: take as one registered kernel PRIM (prim ABI). Empty inbox -> \out 0, OK.
# Lives here (not walk.lm1) so walk selftests that omit thread still link. Declared in lmx_walk.h.lm1.
# Opus: LmxPrimitive.fn = lmx_walk_mail_take; PRIM [prim, record] (nargs 0). Graph through \out.
# Mutant: refuse empty / leave status FAIL -> empty take RED.
fn: lmx_walk_mail_take (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    @: LmxMsg letter 0
    \out: 0
    if: out = 0 || nargs != 0U
        return: 1
    ---
    letter: (cast: (@: LmxMsg) lmx_thread_mail_take(lmx_thread_current(), c.LMX_POST_INBOX))
    if: letter = 0
        return: 0
    ---
    \out: (cast: (@: void) letter\graph)
return: 0

# -177 c3: receive-if PRIM over the inbox cursor. Operand = model; take first letter whose
# payload (graph field 1) is LMX_IMPLEMENTS_YES against the model (native admit shape:
# implements(arena, payload, model, model)). Others stay. Empty / no match -> \out 0 OK.
# Mutant: take head always / skip implements -> RED.
fn: lmx_walk_receive_if (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    @: LmxArena arena 0
    @: Lmx model 0
    @: LmxThread thread 0
    @: LmxPost box 0
    LmxPostCursor: cur
    @: void target 0
    @: LmxMsg letter 0
    @: Lmx graph 0
    @: Lmx payload 0
    \out: 0
    if: out = 0 || refs = 0 || nargs != 1U
        return: 1
    ---
    arena: (cast: (@: LmxArena) owner)
    model: (cast: (@: Lmx) refs[0])
    if: arena = 0 || model = 0
        return: 1
    ---
    thread: lmx_thread_current()
    if: thread = 0 || thread\mail = 0
        return: 0
    ---
    box: thread\mail
    cur.box: 0
    cur.index: 0U
    cur.has_current: 0
    cur.open: 0
    if: lmx_post_cursor_open(box, @ cur) != c.LMX_POST_OK
        return: 1
    ---
    while: 1
        target: lmx_post_cursor_next(@ cur)
        if: target = 0
            lmx_post_cursor_close(@ cur)
            return: 0
        ---
        letter: (cast: (@: LmxMsg) target)
        graph: letter\graph
        if: graph != 0 && lmx_range_classify(arena, (cast: (@: void) graph)) = c.LMX_KIND_STRUCT
            payload: (cast: (@: Lmx) lmx_arena_ref_value(graph, 1U))
            if: payload != 0 && lmx_runtime_implements(arena, payload, model, model) = c.LMX_IMPLEMENTS_YES
                target: lmx_post_cursor_take(arena, @ cur)
                lmx_post_cursor_close(@ cur)
                if: target = 0
                    return: 1
                ---
                letter: (cast: (@: LmxMsg) target)
                \out: (cast: (@: void) letter\graph)
                return: 0
            ---
        ---
    ---
return: 1
