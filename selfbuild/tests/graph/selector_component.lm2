# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: before 0
        int: after 0
        int: nested 0
)
@: shared data[0]
@: S (int: `a\b` 7; a(int: b 70))
int: before S\`a\b`
S\`a\b` := 9
int: after S\`a\b`
int: nested S\a\b

sub: main ()
    shared\Observed\before := before
    shared\Observed\after := after
    shared\Observed\nested := nested
main()
