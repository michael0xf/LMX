# The execution pair (FABLE-OPUS-CODE-DATA-SPLIT-20260925-189 commit c3a; next_core_tasks.md §3 item 7;
# Q28): a call from outside a cycle of calls runs over the callee's own graph, (M, M), and a field
# whose declaration did not run in this activation keeps the previous activation's value.
# - keep(1) reaches `int: v 7`: keep\v is 7 (h).
# - keep(0) returns before the declaration, so keep\v is still keep(1)'s 7.
# h * 10 + keep\v is 77.  A fresh instance for every activation (c2, and option (ii)) gives 70 with
# the slot showing the latest instance, or 0 with the instance frame-only, not in the slot.
fn: keep (int: go) int
    if: go = 0
        return: 0
    int: v 7
    return: 0
end: keep

fn: probe () int
    int: h 0
    int: g 0
    keep(1)
    h: keep\v
    keep(0)
    g: h * 10 + keep\v
    return: g
end: probe

sendMessage: exit(exit_code: probe(); stdout: ""; stderr: "")
return
