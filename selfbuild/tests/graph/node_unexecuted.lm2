# node is a word of the language, never a free input (plan M11 5b part 2): a method whose unexecuted branch reads
# `node\hits` is entered without looking for a name node -- the scan of its entry takes no word of the language -- and
# gives 7.
int: hits 4
fn: f () int
    if: 0
        return: node\hits
    return: 7
int: r f()
