# A callable field in the explicit merge body is constructed and copied with
# that body, just like a callable field of an ordinary named Structure.
Model:
    size_t: x 1U
end: Model

fn: f () int
    return: 1
end: f

R: merge: Model
    fn: f
end: merge
int: answer R\f()
sendMessage: exit(exit_code: answer; stdout: ""; stderr: "")
return
