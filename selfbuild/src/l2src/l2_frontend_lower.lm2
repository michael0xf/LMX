            return: (cast: (int) (lm_compiler_scan_fields(f, (cast: (int) (c.lm_compiler_count_active((cast: (const: @: c.LmP0Structure) (source_node\as\frame\body))) - 1)), mi, seen)))
        return: (cast: (int) (lm_compiler_scan_node((cast: (const: @: c.LmP0Node) (f\value)), mi, seen)))
