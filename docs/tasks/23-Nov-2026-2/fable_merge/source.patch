+FxSeqSize:
+    private:
+        int: base
+        int: extra
+        int: limit
+    required: base extra limit
+    return: int
+    sum:
+        throws: SequenceSize
+        if: base < 0 || extra < 0 || base > limit
+            throw: SequenceSize()
+        if: extra > limit - base
+            throw: SequenceSize()
+        return: base + extra
