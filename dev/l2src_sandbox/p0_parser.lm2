    frame: lm_p0_dump_frame_new(c.LM_P0_DUMP_NODE, indent)
    if: (frame != 0)
        frame\node: p0_node
    ---
    return: lm_p0_dump_push_frame(stack, frame)
end: lm_p0_dump_push_node

