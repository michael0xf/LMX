# Explicit NODE prevents a caller's free input from masking a stale copy.
# full05 returned 5 here; the copied current parent plus bound y gives 16.
int: cnt 7
fn: bin () int
return: 0
fn: take (bin: op) int
return: op()
fn: model (int: y) int
return: node\cnt + y
cnt: 11
int: a (take: merge(model; y: 5))
int: out 81
if: a = 16
    out: 7
sendMessage: exit(exit_code: out; stdout: ""; stderr: "")
return
