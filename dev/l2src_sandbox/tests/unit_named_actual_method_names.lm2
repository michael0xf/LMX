# A formal may have the name of a method. Among f's actuals `g(2)` and `h(3)`
# name f's formals g and h; they are not calls of the methods g and h. The
# payload of one is read as any value is, a call of the method included:
# f(g(g(2)); h(h())) gives formal g the method g's result and formal h the
# method h's. The written order of evaluation holds: mark(1), then mark(2).
# Entry 7.
int: trace 0

fn: mark (int: v) int
    node\trace: node\trace * 10 + v
    return: v
end: mark

fn: seen () int
    return: node\trace
end: seen

fn: g (int: q) int
    return: q + 28
end: g

fn: h () int
    return: 1000
end: h

fn: f (int: g; int: h) int
    return: g + h
end: f

fn: both () int
    return: f(h(3); g(2))
end: both

fn: guard () int
    int: x 1
    if: x = 1 && f(g(2); h: 3) = 5
        return: 1
    return: 0
end: guard

fn: real () int
    return: f(g(g(2)); h(h()))
end: real

fn: order () int
    return: f(h(mark(1)); g(mark(2)))
end: order

int: r0 both()
int: r1 guard()
int: r2 real()
int: r3 order()
int: t seen()
int: ok 7
if: r0 != 5
    ok: 80
if: r1 != 1
    ok: 81
if: r2 != 1030
    ok: 82
if: r3 != 3
    ok: 83
if: t != 12
    ok: 84
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
