predef: "l2src/lmx_gc.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# D-43: five Message mails on one arena. Sweep must drop embedded Post.nodes from
# arena->arrays before freeing a recycled Post cell; else lmx_post_init fails.
# Mutant: skip lmx_gc_drop_arrays_in_block -> POST_INVALID on reused address.
#
# GC must not word-walk Post records (nodes.next is arena->arrays); abandoned
# Posts stay unmarked while the live mail is marked via mark_value + mark_pool.

sub: ps_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: ps_check

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: arena
    @: LmxArena arena_at 0
    @: LmxThread thread 0
    @: LmxMsg message 0
    @: LmxSchedule slot 0
    @: LmxPost mail 0
    @: Lmx graph 0
    @: LmxPost orphan 0
    @: void prev 0
    @: void now 0
    int: round 0
    int: recycled 0
    int: failures
    if: counts = 0
        return: 2
    ---
    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    arena_at: @ arena
    if: lmx_arena_open(@ arena) != 0
        fputs("lmx_post_sweep: arena did not open\n", l1_stdout())
        free(counts)
        return: 2
    ---
    thread: (cast: (@: LmxThread) lmx_arena_take(@ arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD))
    message: (cast: (@: LmxMsg) thread)
    slot: (cast: (@: LmxSchedule) lmx_arena_take(@ arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    mail: (cast: (@: LmxPost) lmx_arena_take(@ arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    graph: lmx_node_new_owned(@ arena)
    ps_check(counts, thread != 0 && mail != 0 && slot != 0 && graph != 0, "live fixtures")
    if: thread = 0 || mail = 0 || slot = 0 || graph = 0
        free(counts)
        return: 2
    ---
    ps_check(counts, lmx_arena_refs_open_owned(@ arena, graph, 1U) = 0, "graph slots")
    ps_check(counts, lmx_post_init(@ arena, mail) = c.LMX_POST_OK, "live mail init")
    ps_check(counts, lmx_schedule_init(slot, @ arena, (cast: (@: void) thread), 8U) = c.LMX_SCHEDULE_OK, "schedule init")
    ps_check(counts, lmx_thread_init(@ arena, thread, graph, mail, slot) = c.LMX_THREAD_OK, "thread init")

    round: 0
    recycled: 0
    prev: 0
    while: round < 5
        orphan: (cast: (@: LmxPost) lmx_arena_take(@ arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
        ps_check(counts, orphan != 0, "orphan take")
        if: orphan = 0
            round: 5
        else:
            now: (cast: (@: void) orphan)
            if: prev != 0 && now = prev
                recycled: recycled + 1
            ---
            ps_check(counts, lmx_post_init(@ arena, orphan) = c.LMX_POST_OK, "D-43 post_init on Message mail")
            prev: now
            ps_check(counts, lmx_gc_collect(@ arena, thread) = c.LMX_GC_OK, "collect after orphan")
            round: round + 1
        ---
    ---
    ps_check(counts, recycled >= 1, "D-43 freelist recycled a Post address at least once")

    failures: counts[1]
    if: lmx_post_close(@ arena, mail) != c.LMX_POST_OK
        failures: failures + 1
    ---
    if: lmx_arena_release(@ arena) != 0
        failures: failures + 1
    ---
    c.printf("lmx_post_sweep checks=%d failures=%d recycled=%d\n", counts[0], failures, recycled)
    free(counts)
return: failures
