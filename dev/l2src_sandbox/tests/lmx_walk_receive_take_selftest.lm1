predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_plan.lm1"
predef: "l2src/lmx_scratch.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_primitive.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# -177 c1: take PRIM + null PUT + pointer EQ vs LIT 0.
# Mutant: empty take FAIL / PUT refuse 0 / EQ load_operand on pointer -> RED.

@: LmxArena ga 0
@: Lmx groles 0
@: Lmx gplan_roles 0
@: LmxWalkContext gctx 0
@: LmxWalkValue gv 0
int: broken 0
int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(ga, groles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(ga, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

sub: ref (@: Lmx code; size_t: slot; @: Lmx target)
    if: code = 0 || target = 0 || lmx_arena_ref_store(code, slot, (cast: (@: void) target)) != 0
        broken: broken + 1
    ---
end: ref

sub: sz (@: Lmx code; size_t: slot; size_t: value)
    if: code = 0 || lmx_walk_store_size(ga, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: sz

fn: mk_m (@: Lmx unit; size_t: slot; size_t: children) @: Lmx
    @: Lmx m pl(unit, slot, children)
    @: LmxCallable info lmx_callable_new_owned(ga)
    if: m = 0 || info = 0 || lmx_arena_ref_store(m, 0U, (cast: (@: void) info)) != 0
        broken: broken + 1
        return: 0
    ---
return: m

fn: go (@: Lmx m) int
    int: st
    if: m = 0 || gctx = 0 || gv = 0
        return: c.LMX_WALK_INVALID
    st: lmx_walk_prepare(gctx, ga, gplan_roles, m)
    if: st != c.LMX_WALK_OK
        return: st
return: lmx_walk_run(gctx, m, 0, 0U, gv)

fn: main () int
    LmxArena: arena
    LmxArena: context_arena
    LmxPool: context_cells
    LmxScratch: store
    LmxWalkContext: context
    @: Lmx unit 0
    @: Lmx m 0
    @: Lmx n 0
    @: Lmx holder 0
    @: Lmx letter_graph 0
    @: Lmx putn 0
    @: Lmx eqn 0
    @: Lmx atn 0
    @: Lmx litn 0
    @: Lmx pn 0
    @: Lmx prim_rec 0
    @: LmxPrimitive prim 0
    @: void pcell 0
    @: LmxPost mailbox 0
    @: LmxSchedule slot 0
    @: LmxThread thread 0
    @: LmxMsg letter 0
    @: LmxMsg thread_message 0
    @: Lmx graph 0
    int: st 0
    int: pty c.LMX_TYPE_POINTER_BASE + 7

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        return: 2
    ga: @ arena
    groles: lmx_walk_roles_open(ga)
    gplan_roles: lmx_plan_roles_open(ga)
    memset((cast: (@: void) (@ context_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxScratch))
    if: lmx_arena_open(@ context_arena) != 0 || lmx_scratch_open(@ store, @ context_arena, @ context_cells, 16U) != c.LMX_SCRATCH_OK
        return: 2
    context.arena: ga
    context.scratch: @ store
    context.roles: groles
    context.plan_roles: gplan_roles
    context.immutable_profile: 0
    context.classified: 0U
    gctx: @ context
    gv: (cast: (@: LmxWalkValue) calloc(1U, c.sizeof(c.LmxWalkValue)))

    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 16U) != 0
        return: 2
    ---
    holder: pl(unit, 1U, 2U)
    letter_graph: pl(unit, 2U, 2U)
    if: holder = 0 || letter_graph = 0 || lmx_walk_store_int(ga, letter_graph, 1U, 77) != c.LMX_WALK_OK
        return: 2
    pcell: lmx_pointer_new_owned(pty, ga)
    if: pcell = 0 || lmx_arena_ref_store(holder, 1U, pcell) != 0
        return: 2

    mailbox: (cast: (@: LmxPost) lmx_arena_take(ga, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    slot: (cast: (@: LmxSchedule) lmx_arena_take(ga, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    thread: (cast: (@: LmxThread) lmx_arena_take(ga, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD))
    graph: lmx_node_new_owned(ga)
    if: mailbox = 0 || slot = 0 || thread = 0 || graph = 0
        return: 2
    ---
    if: lmx_post_init(ga, mailbox) != c.LMX_POST_OK || lmx_schedule_init(slot, ga, (cast: (@: void) thread), 4U) != c.LMX_SCHEDULE_OK || lmx_thread_init(ga, thread, graph, mailbox, slot) != c.LMX_THREAD_OK
        return: 2
    ---
    thread_message: lmx_thread_message(thread)
    thread_message\running: 1
    if: lmx_thread_enter(thread) != c.LMX_THREAD_OK || lmx_thread_current() != thread
        return: 2
    ---

    prim: (cast: (@: LmxPrimitive) lmx_arena_take(ga, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))
    if: prim = 0
        return: 2
    ---
    prim\fn: lmx_walk_mail_take
    prim\signature: 0
    prim\owner: 0
    prim_rec: (cast: (@: Lmx) prim)

    # take on empty inbox -> null out, OK
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    pn: fr(n, 1U, c.LMX_WALK_OP_PRIM, 2U)
    ref(pn, 1U, prim_rec)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref = 0)), "take empty -> null")

    # accept one letter; take -> letter graph
    letter: (cast: (@: LmxMsg) lmx_arena_take(ga, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
    if: letter = 0
        return: 2
    ---
    letter\graph: letter_graph
    if: lmx_thread_mail_accept(ga, thread, (cast: (@: void) letter), c.LMX_POST_INBOX) != c.LMX_POST_OK
        return: 2
    ---
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    pn: fr(n, 1U, c.LMX_WALK_OP_PRIM, 2U)
    ref(pn, 1U, prim_rec)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) letter_graph))), "take one -> letter graph")

    # PUT null (empty take as value) then EQ AT(pointer) vs LIT 0 -> true
    m: mk_m(unit, 0U, 3U)
    putn: fr(m, 1U, c.LMX_WALK_OP_PUT, 4U)
    ref(putn, 1U, holder)
    sz(putn, 2U, 1U)
    pn: fr(putn, 3U, c.LMX_WALK_OP_PRIM, 2U)
    ref(pn, 1U, prim_rec)
    eqn: fr(m, 2U, c.LMX_WALK_OP_RET, 2U)
    n: fr(eqn, 1U, c.LMX_WALK_OP_EQ, 3U)
    atn: fr(n, 1U, c.LMX_WALK_OP_AT, 3U)
    ref(atn, 1U, holder)
    sz(atn, 2U, 1U)
    litn: fr(n, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 0) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref != 0 && lmx_int_value_known(gv\ref) = 1)), "PUT null then EQ 0 true")
    check((cast: (int) (lmx_pointer_value_known(pcell) = 0)), "pointer cell holds null")

    lmx_thread_leave(thread)
    c.printf("lmx_walk_receive_take_selftest checks=%d failures=%d broken=%d\n", checks, failures, broken)
    if: failures != 0 || broken != 0
        return: 1
return: 0
