include: "<stddef.h>"
predef: "l2src/lmx_message.h.lm1"
predef: "l2src/lmx_post.h.lm1"
predef: "l2src/lmx_schedule.h.lm1"
predef: "l2src/lmx_arena.h.lm1"
# LmxCallEntry: one turn takes the handler the caller already holds (lmx_call.h.lm1).
predef: "l2src/lmx_call.h.lm1"

define: LMX_THREAD_OK 0
define: LMX_THREAD_INVALID 1
define: LMX_THREAD_STOPPED 2
define: LMX_THREAD_IDLE 0
define: LMX_THREAD_TURN 1
define: LMX_THREAD_DONE 2

# The object's interfaces, each its own table.  An L3 Thread supports all of them
# and hands them out SEPARATELY -- a thread API and a mail API, composed, never
# merged into one heap of functions (Mikhail, 2026-09-17: "сделайте нормальной
# композицией чтобы он возвращал все свои API по отдельности а не сваливайте в
# кучу").  LmxThread is named before it is defined so the function-pointer types can
# point at it; the struct: below completes the same tag.
type: LmxThread struct LmxThread

fnptr: LmxThreadEnter (@: LmxThread t) int
fnptr: LmxThreadLeave (@: LmxThread t) int
fnptr: LmxThreadRunning (@: LmxThread t) int
fnptr: LmxThreadCurrent () @: LmxThread
# The interpreter is a replaceable L2 boundary until the L3 interpreter has a stable ABI.
# It receives only the Thread.  In particular it cannot receive or accidentally call the native
# entry: the ABI itself makes the two paths mutually exclusive.
fnptr: LmxThreadMailAccept (@: LmxArena arena; @: LmxThread t; @: void target; int: lane) int
fnptr: LmxThreadMailTake (@: LmxThread t; int: lane) @: void
fnptr: LmxThreadMailCount (@: LmxThread t; int: lane) size_t
fnptr: LmxThreadMailClose (@: LmxArena arena; @: LmxThread t) int


# A child remains a live physical Thread until its serialized parent removes that exact address
# from the parent's graph Array and then releases or attaches the child's arena.  Consequently no
# parallel family-link record is needed: membership is one ordinary growable Array<@LmxThread>.
# The liveness stamp and close request state live on the child Thread they describe.  They do not
# form another collection and cannot answer membership independently of the Array.

struct: LmxThreadApi
    LmxThreadEnter: enter
    LmxThreadLeave: leave
    LmxThreadRunning: running
    LmxThreadCurrent: current
end: LmxThreadApi

# The thread's mail API -- every L3 Thread has one, because the mailbox is what makes
# a Message an L3 Thread.  Today each method delegates to the mailbox module
# (lmx_post).  The interface a caller holds does not change.  It is a
# separate table from LmxThreadApi on purpose -- two APIs, returned separately.
#
# The arena appears on exactly the two methods whose delegate needs it (accept takes
# a queue node from the node pool and asks the target's domain, close hands the pool
# back to the arena), and is left off the two that need neither.  The thread stores
# no arena of its own: the arena is the context of the act, so the caller supplies it.
struct: LmxThreadMailApi
    LmxThreadMailAccept: accept
    LmxThreadMailTake: take
    LmxThreadMailCount: count
    LmxThreadMailClose: close
end: LmxThreadMailApi

# The execution state of an L3 Thread.
#
# Model 25, Mikhail on 2026-09-14, verbatim: "L3 Thread -- Message, который может
# присоединять и/или исполнять любой Message.  Каждый L3 Thread -- Message, но не
# каждый Message -- L3 Thread (у шаблона и у письма нет turn, у запущенного
# ребёнка есть).  Почта и задел под turn есть только у L3 Thread ...  Планировщик
# есть только у разновидностей L3 Thread".
#
# So an L3 Thread has a Message as its exact physical prefix. `LmxMsg message` is the first
# by-value member, hence `@thread == @thread\message`; a plain letter remains a standalone
# LmxMsg. Mail, schedule, routing and supervision remain Thread-only fields after that
# closed four-field prefix and are never added to LmxMsg.
#
# It is an object and not a mechanism: "Полоса на экране не может не быть L3
# Thread. Message без L3 Thread это просто письмо. Полоса же это полноценный
# объект" (Mikhail, 2026-09-15).
#
# How it is implemented is open by design: the object carries its interfaces, and an
# implementation may run a thread of its own or be stepped by its parent -- "lmx_thread
# имеет API и реализации могут быть разными, в том числе бегающая и небегающая"
# (Mikhail, 2026-09-17).  Nothing in this header promises an OS thread.
#
# The two poll hooks of lmx.h are NOT redeclared here: lmx.h declares them and says
# the kernel owns the bodies; this unit is the kernel side of that, and a second
# declaration would only be a second place to keep in step.
struct: LmxThread
    LmxMsg: message
    @: LmxPost mail
    @: LmxSchedule slot
    unsigned: turn
    int: state
    # Execution is a property of the Thread, never an inference from entry, METHOD, graph body,
    # a previous result or a failure.  A request made before or during a turn is committed only
    # by that turn's end boundary and therefore selects the following turn.
    # This turn's reserved children (lmx_child.h.lm1): the head of the list the end-turn
    # boundary publishes or drops (model 26, 28 -- "при успехе публикуются ... подготовленные
    # дети").  It is UNTYPED, like every other reference in this kernel: what a node is follows
    # from the array its address falls into (LMX_DOMAIN_RESERVATION), never from a typed field
    # here -- and the type would otherwise be a header cycle, since the child module names this
    # thread.  The list belongs to the turn's owner, which is this object.
    @: void prepared
    # The parent Message's L3 Thread -- for R0 this is the structural upper frame, not null.  It is
    # the UP-LINK used by the postman's physical-address step (lmx_deliver): a child knows its
    # parent and a parent knows its children through the one graph Array.  The cell belongs to the
    # PARENT and is written on the PARENT's lane
    # at publication (spec 19.29.6).
    @: void parent
    # THE STABLE ROUTE BACK TO THIS RECORD'S SERVICE (lmx_service): registration stores it and
    # unregister clears it, so a record can ask which registry owns it without going near the
    # service's entries vector.  It must NOT be a pointer INTO that vector: the vector is compacted
    # by memmove on a removal and moved by realloc on growth, so a stored row pointer is stale
    # after either act -- measured 2026-09-21, single-threaded, no timing involved.  Untyped like
    # every other reference here; zero for a record no service has registered.
    @: void service
    # The sole direct-child membership collection: the L1 list descriptor that is
    # an ordinary typed field of this Thread's graph.  Untyped here so L3 thread TUs
    # do not import LmxArrayDesc.  The constructor validates it by the arena's
    # address-range table and caches only this same physical reference.  There is no link chain or
    # scheduler queue containing another membership set.
    @: void children
    # Per-child supervision state.  These cells do not establish membership; only the parent's
    # children list does.  `alive` is stamped by the child's lane and answered by its parent.
    # `close_deadline` is the one relaxed atomic platform word inherited by a close cascade.
    size_t: alive
    ulong: stopped
    size_t: close_deadline
    # Orphan retention is supervision state of this same child record, never a second
    # membership list.  `orphaned` selects the R0 retention policy while the physical Thread
    # remains an element of R0's one children list.
    int: orphaned
    ulong: orphan_started
    ulong: orphan_limit
    # Optional ordinary application-graph field that published this child Message.  It is a
    # physical cell address, never a numeric slot: success clears it, failure leaves the graph
    # reference as the retained result.  It is not child-membership; the children list is.
    @@: void result
    # THIS object's OWN scheduler (Mikhail, 19.09: "У каждого Thread своя арена и свой
    # планировщик!", "менеджер у каждого ребёнка свой"): it traverses this Thread's one graph
    # children list. Untyped, like every other reference here -- the manager module names this one, so
    # the type in this header would be an import cycle (measured: l1trans refuses it).
    # Opened by lmx_thread_scheduler_open, which takes the arena from its CALLER rather than
    # inferring ownership from another mechanism record.
    @: void manager
    LmxThreadApi: api
    LmxThreadMailApi: mail_api
end: LmxThread

prototype:
    # Canonical construction of an executable Message. The embedded prefix is initialized in
    # place; no arbitrary external Message can be attached or rebound later.
    fn: lmx_thread_init (@: LmxArena arena; @: LmxThread t; @: Lmx graph; @: LmxPost mail; @: LmxSchedule slot) int
    fn: lmx_thread_enter (@: LmxThread t) int
    fn: lmx_thread_leave (@: LmxThread t) int
    # ONE TURN, whole: the boundary, the body, the boundary.  `entry` is
    # a handler GIVEN FROM OUTSIDE -- the host's for R0 (25 (ii): "the entry program is R0's
    # handler"), which is not a graph callable and has no METHOD record of its own; zero means the
    # native body is what its OWN GRAPH names when entry is 0: lmx_call0.  A
    # translated Message's body is a callable occurrence, because "all executable bodies are part
    # of the graph" (model 8); lmx_call0 passes the selected occurrence M's immediate M.parent as
    # reserved `Lmx *node`. A non-null external `entry` is only the synthetic R0/host adapter and
    # analogously receives graph.parent, which is 0: the graph hanging in a Thread is independent
    # (parent = 0), so nothing lexical lies above it. Control bodies inside that invocation never rebind node. A
    # graph that names no callable is a legitimate state: the turn is then pure boundary work.
    # The body runs INSIDE the turn (lm.current is this object while it runs), its status is its own
    # report and never a stop (model 31), and the boundary follows on the turn's own outcome
    # (19.29.4.1).  Answers LMX_THREAD_STOPPED when the boundary refuses the turn -- a close is
    # never resurrected -- and LMX_THREAD_INVALID when the boundary's work failed.
    fn: lmx_thread_turn (@: LmxThread t; LmxCallEntry: entry; ulong: now) int
    fn: lmx_thread_running (@: LmxThread t) int
    fn: lmx_thread_current () @: LmxThread
    fn: lmx_thread_api (@: LmxThread t) @: LmxThreadApi
    fn: lmx_thread_mail_api (@: LmxThread t) @: LmxThreadMailApi
    # The embedded closed Message prefix. Its address is exactly the Thread address.
    fn: lmx_thread_message (@: LmxThread t) @: LmxMsg
    # The parent Message's L3 Thread: the up-link the postman follows.  R0 points to its ordinary
    # structural parent stub; only that stub and a Message not yet linked have null here.
    fn: lmx_thread_parent (@: LmxThread t) @: LmxThread
    # This record's own service entry, or null (lmx_service writes it at registration).
    fn: lmx_thread_service (@: LmxThread t) @: void
    # Bind the one ordinary graph children list supplied by this Thread's constructor.  The
    # descriptor and its backing must belong to `arena`; a second binding is refused.
    fn: lmx_thread_children_bind (@: LmxThread t; @: void children; @: LmxArena arena) int
    # Constructor helper: locate the unique exact typed children list among ordinary graph
    # fields and bind that physical descriptor. No field position or runtime name is involved.
    fn: lmx_thread_children_bind_graph (@: LmxThread t; @: LmxArena arena) int
    # Construct one ordinary graph field holding the sole child-membership list.
    # `field` is chosen by the graph producer; it is not a runtime ABI slot.
    fn: lmx_thread_children_field_new (@: LmxArena arena; @: Lmx graph; size_t: field) @: void
    fn: lmx_thread_children (@: LmxThread t) @: void
    fn: lmx_thread_child_count (@: LmxThread parent) size_t
    fn: lmx_thread_child_at (@: LmxThread parent; size_t: index) @: LmxThread
    # Live direct children: append, remove, membership, and ordered iteration over that list.
    # The address of this Thread's handshake word -- the child-owned cell the child stamps and
    # its parent answers (19.29.7.1). Membership itself comes only from the graph list.
    # This object's own scheduler, or null while none was opened.  Untyped: a caller casts.
    fn: lmx_thread_manager (@: LmxThread t) @: void
    # Open this object's own scheduler as a record of `arena` (the caller names it).  Refused
    # when it already has one.  Initialized as the STEPPED manager: a lane is a later choice.
    fn: lmx_thread_scheduler_open (@: LmxThread t; @: LmxArena arena) int
    fn: lmx_thread_alive_cell (@: LmxThread t) @: size_t
    # The driver's terminal hook publishes no ownership change.  The serialized parent removes
    # the exact physical child reference first, then releases or attaches the child's arena.
    fn: lmx_thread_finish (@: LmxThread t) int
    # The Array backing is owned by the parent's arena, named explicitly by the caller.  Addition
    # preserves insertion order; removal compacts the Array and changes no other ownership state.
    fn: lmx_thread_child_add (@: LmxThread parent; @: LmxThread child; @: LmxArena arena) int
    fn: lmx_thread_child_remove (@: LmxThread parent; @: LmxThread child) int
    fn: lmx_thread_child_is (@: LmxThread parent; @: LmxThread child) int
    fn: lmx_thread_child_first (@: LmxThread parent) @: LmxThread
    fn: lmx_thread_child_next (@: LmxThread child) @: LmxThread
    # Parent half of 19.29.7.1: zero children's fresh stamps (answer); emergency-close stale.
    fn: lmx_poll_answer_children (@: LmxThread t; ulong: now) int
    # Spec 32, verbatim: "a stopped Message has no lane, so nothing runs its children's turns from
    # it; ITS STOP REQUESTS THEIR CLOSE; a child whose inbox is empty is closed by the maintenance
    # without a turn, and a child on its own context runs its closing turn there".  Model 31 names
    # the parent as the one cross-lane writer of `running`, so this write is the sanctioned one.
    #
    # WHAT IS THE REQUEST AND WHAT IS THE CLOSE (read this before touching the act).  The request
    # is `running = 0`, and it is NOT the close:
    #   * a child on its own context closes ITSELF -- its lane reaches its boundary, leaves the
    #     turn and writes the handoff mark there (lmx_thread_leave).  That is the ordinary way, and
    #     it is the only writer of the mark that cannot be wrong;
    #   * a child NOBODY RUNS reaches no boundary of its own, so the maintenance closes it -- and
    #     the wait that ends there is counted from the FIRST request, held in this node's `stopped`.
    #     When the child's own window (`slot\limit`, the same number lmx_turn_end's stamp and
    #     lmx_orphan_maintain age against) has passed, it is closed WITHOUT a turn: stopped AND
    #     handoff-safe, mail or no mail -- a stopped Message does not wait for letters (Mikhail,
    #     19.09: "с какой радости закрытое приложение должно на последнем издыхании ловить
    #     какие-то письма").  This act is where that window is evaluated, and it is called at every
    #     settle boundary of the parent and at the parent's own closing boundary, so the cascade
    #     gets its window level by level.
    #
    # WHY THE INBOX IS NOT THE TEST ANY MORE.  This act used to close a child whose inbox was EMPTY
    # at once, reading "no letter waiting" as "no turn coming, so it has ended".  That reading is
    # false for a child that is INSIDE its turn -- and inside its turn its box IS empty, because its
    # body took the letter at the start of the turn.  Measured (tests\lmx_app_reroot_forbidden_selftest.lm1,
    # run 3): the mark went onto a child whose own boundary had not run, and the very next settle
    # attached its arena to the parent's and released the parent -- under a turn still in flight
    # (`b_count 7->0 a_count 9->0`).  Handoff-safe means "I have LEFT my last turn", and only the
    # child's own boundary, or a window that says it is not working, can establish that.
    fn: lmx_stop_children (@: LmxThread t; ulong: now; size_t: deadline) int
    # The two halves of that act, each reachable on its own: the request for one child, and the
    # close of one child whose ask has outlived its own band's window.  `lmx_settle_children` calls
    # the CLOSE for a child it cannot reap yet (and only the close: a settle must never ask a
    # running child to stop).  The REQUEST carries the closure's ONE deadline down into the child's
    # node -- zero for a stop that is not a closure, so a closure beginning later still publishes.
    fn: lmx_stop_request (@: LmxThread child; ulong: now; size_t: deadline) int
    fn: lmx_stop_close (@: LmxThread child; ulong: now) int
    # The closure deadline as the node holds it: one relaxed atomic load of one self-contained word
    # The one inherited close deadline carried by this child Thread itself.
    fn: lmx_thread_close_deadline (@: LmxThread child) size_t
    fn: lmx_thread_close_deadline_publish (@: LmxThread child; size_t: deadline) int
    # Whether this record's own lane has ended: the stronger boundary the close publishes from, and
    # the one the STOPPED hook asks before it speaks for a record whose lane may still be unwinding.
    # A record with no lane answers YES (the stepped manager's normal state).
    fn: lmx_thread_lane_ended (@: LmxThread t) int
    fn: lmx_thread_mail_accept (@: LmxArena arena; @: LmxThread t; @: void target; int: lane) int
    fn: lmx_thread_mail_take (@: LmxThread t; int: lane) @: void
    fn: lmx_thread_mail_count (@: LmxThread t; int: lane) size_t
    fn: lmx_thread_mail_close (@: LmxArena arena; @: LmxThread t) int
end: prototype
