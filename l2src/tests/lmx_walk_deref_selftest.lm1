predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# -174 c1: DEREF yields the Structure a pointer cell holds; OF can follow m\f.
# Mutant: deref returns the cell address -> OF INVALID RED.

@: LmxArena ga 0
@: Lmx groles 0
@: LmxWalkContext gctx 0
@: LmxWalkValue gv 0
int: broken 0
int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(ga, groles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(ga, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

sub: ref (@: Lmx code; size_t: slot; @: Lmx target)
    if: code = 0 || target = 0 || lmx_arena_ref_store(code, slot, (cast: (@: void) target)) != 0
        broken: broken + 1
    ---
end: ref

sub: sz (@: Lmx code; size_t: slot; size_t: value)
    if: code = 0 || lmx_walk_store_size(ga, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: sz

# k.4: a walked callable occurrence is just the ordinary body Structure -- no descriptor;
# `native` stays 0 by construction. `children` now counts body steps only, so every call
# site below shrinks by one and its first body-step frame moves from slot 1 to slot 0.
fn: mk_m (@: Lmx unit; size_t: slot; size_t: children) @: Lmx
return: pl(unit, slot, children)

fn: go (@: Lmx m) int
    if: m = 0 || gctx = 0 || gv = 0
        return: c.LMX_WALK_INVALID
return: lmx_walk_run(gctx, m, 0, 0U, gv)

fn: main () int
    LmxArena: arena
    LmxArena: context_arena
    LmxPool: context_cells
    LmxScratch: store
    LmxWalkContext: context
    @: Lmx unit 0
    @: Lmx m 0
    @: Lmx n 0
    @: Lmx holder 0
    @: Lmx model 0
    @: Lmx ofn 0
    @: Lmx der 0
    @: Lmx atn 0
    @: void pcell 0
    @: void got 0
    int: st 0
    int: pty c.LMX_TYPE_POINTER_BASE + 7

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        return: 2
    ga: @ arena
    groles: lmx_walk_roles_open(ga)
    memset((cast: (@: void) (@ context_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxScratch))
    if: lmx_arena_open(@ context_arena) != 0 || lmx_scratch_open(@ store, @ context_arena, @ context_cells, 16U) != c.LMX_SCRATCH_OK
        return: 2
    context.arena: ga
    context.scratch: @ store
    context.roles: groles
    context.immutable_profile: 0
    context.classified: 0U
    gctx: @ context
    gv: (cast: (@: LmxWalkValue) calloc(1U, c.sizeof(c.LmxWalkValue)))

    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 8U) != 0
        return: 2
    ---
    # holder[1] = pointer cell -> model; model[1] = int 42
    holder: pl(unit, 1U, 2U)
    model: pl(unit, 2U, 2U)
    if: holder = 0 || model = 0 || lmx_walk_store_int(ga, model, 1U, 42) != c.LMX_WALK_OK
        return: 2
    pcell: lmx_pointer_new_owned(pty, ga)
    if: pcell = 0 || lmx_pointer_store_known(pcell, (cast: (@: void) model)) != 0 || lmx_arena_ref_store(holder, 1U, pcell) != 0
        return: 2

    # body: ret (of (deref (at holder 1)) 1)  -- field 1 of model through pointer
    m: mk_m(unit, 0U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    ofn: fr(n, 1U, c.LMX_WALK_OP_OF, 3U)
    der: fr(ofn, 1U, c.LMX_WALK_OP_DEREF, 2U)
    atn: fr(der, 1U, c.LMX_WALK_OP_AT, 3U)
    ref(atn, 1U, holder)
    sz(atn, 2U, 1U)
    sz(ofn, 2U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && broken = 0)), "deref+of run")
    got: gv\ref
    if: got = 0
        got: (cast: (@: void) (@ gv\number))
    ---
    # ret of int field copies into dest; number should be 42
    check((cast: (int) (gv\present != 0 && gv\ref != 0 && lmx_int_value_known(gv\ref) = 42)), "of after deref reads 42")

    # AT alone still yields the pointer CELL, not the Structure
    m: mk_m(unit, 0U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    atn: fr(n, 1U, c.LMX_WALK_OP_AT, 3U)
    ref(atn, 1U, holder)
    sz(atn, 2U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref = pcell)), "at stays pointer cell")

    c.printf("lmx_walk_deref_selftest checks=%d failures=%d broken=%d\n", checks, failures, broken)
    if: failures != 0 || broken != 0
        return: 1
return: 0
