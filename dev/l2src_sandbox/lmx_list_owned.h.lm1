predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_arena.h.lm1"

# Independent L1 dynamic container. Not an Array. Capacity is here, never on LmxArrayDesc.
# Public operations: create, indexed read, append, remove. Reserve is internal only.
define: LMX_LIST_OK 0
define: LMX_LIST_INVALID 1
define: LMX_LIST_NOMEM 2
define: LMX_LIST_OVERFLOW 3
define: LMX_LIST_BOUNDS 4
define: LMX_LIST_MIN_CAP 2

struct: LmxListDesc
    size_t: len
    size_t: cap
    @: void data
    int: etype
    int: backing_kind
end: LmxListDesc

prototype:
    fn: lmx_list_new_owned (int: type; @: LmxArena arena) @: LmxListDesc
    fn: lmx_list_append_owned (@: LmxListDesc list; @: void value; @: LmxArena arena) int
    fn: lmx_list_remove_owned (@: LmxListDesc list; size_t: index; @@: void removed; @: LmxArena arena) int
    fn: lmx_list_value (@: LmxListDesc list; size_t: index) @: void
end: prototype
