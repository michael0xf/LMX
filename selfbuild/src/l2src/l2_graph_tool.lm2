# The graph tool of the kernel implementation specification (docs/kernel-implementation.ru.md, EN beside it; slice 309,
# the vertical slice of §11 item 0): the emitter of a program over the clean graph (§7) and the command line of the
# tool tools/graph_trans.lm2, which runs the kernel's interpreter over the same graph (lmx_graph_run.lm2, §6). The
# graph is built by the common builder (src/l2src/l2_graph_build.lm2, §1a, §3), which the frontend hosted by the
# runtime shares (slice 338). The new path stands beside the old pipeline and does not touch its emission.
#
# The emitter is a consumer of the clean graph: it reads the graph, not the parse tree. It writes the L1 of a program
# (the form the pipeline's L1 translator and gcc build and the driver runs): the generated initialization of the same
# graph through the common constructor (lmx_graph_*; §1a), the program hooks the driver expects, and the native body of
# the root over the same cells (§7) -- or, in the forced mode, a body that hands the root to the kernel's interpreter.
# The emitter resolves written names itself, at translation, with its own table of the declarations it has emitted and
# the names of the built graph (§3.5, §5.2); the emitted native reads and writes places by their slots.
#
# A machine module (L2 section 20) of the program tools/graph_trans.lm2: built by `lmxtool build-graph` (bld_graph,
# tools/build.lm2) after the builder's module, with the P0 parser's modules of the stage; its exports are named
# there.
predef: "l1src/p0.h.lm1"
predef: "l1src/parser.lm1"
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_graph.h.lm1"
predef: "l2src/lmx_graph_run.h.lm1"
predef: "l2src/lmx_source_names.h.lm1"
predef: "l2src/lmx_graph_copy_owned.h.lm1"
predef: "l2src/l2_graph_build.h.lm1"
predef: "l2src/l2_graph_retype.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>"
include: "<stdlib.h>"
include: "<string.h>"

# ---- The emitter: clean graph -> the L1 of a program (§7) ---------------------------------------------------------

# A spelling as an L1 string literal: a quote and a backslash escaped.
sub: lm_graph_emit_quoted_bytes (c.FILE@: f; char@: text; size_t: count; int: single_line)
    size_t: i 0U
    c.fputc(34, f)
    while: i < count
        if: single_line != 0 && text[i] = 10
            c.fputs("\\n", f)
        else:
            if: single_line != 0 && text[i] = 13
                c.fputs("\\r", f)
            else:
                if: single_line != 0 && text[i] = 9
                    c.fputs("\\t", f)
                else:
                    if: text[i] = 92 || text[i] = 34
                        c.fputc(92, f)
                    c.fputc((cast: (int) text[i]), f)
        ---
        i := i + 1U
    c.fputc(34, f)
return

sub: lm_graph_emit_quoted (c.FILE@: f; char@: text)
    lm_graph_emit_quoted_bytes(f, text, c.strlen(text), 0)
return

# The row of the name table for the value, if any, as a name call after its construction into the L1 local `local`.
fn: lm_graph_emit_name_row (c.LmxGraph@: g; c.FILE@: f; @: address; char@: local) int
    char@: name (cast: (char@) c.lmx_graph_name_of(g, address))
    if: name = 0
        return: 0
    c.fprintf(f, "        if: lmx_graph_name(l2_g, %s, ", local)
    lm_graph_emit_quoted(f, name)
    c.fprintf(f, ", %zuU) != 0\n            return: 1\n", (cast: (size_t) c.strlen(name)))
    return: 0
end: lm_graph_emit_name_row

# One temporary source-address map covers the emitted graph, primitives and uninitialized referents. Each live
# address is allocated once; subsequent edges use that generated local. The map is destroyed by this translation.
fn: lm_graph_emit_node (c.LmxGraph@: g; c.FILE@: f; @: value; c.LmxCopyMap@: map; size_t@: next; size_t@: out) int
    int: kind (cast: (int) c.lmx_graph_kind(g, value))
    c.Lmx@: inner 0
    char@: text 0
    char@: pointer_type 0
    c.LmxGraphEmitScratch: name_storage
    char@: local (cast: (char@) name_storage\failure)
    char@: spelled (cast: (char@) name_storage\returned)
    int: scalar 0
    size_t: id (cast: (size_t) c.lmx_copy_map_get(map, value))
    size_t: target 0U
    size_t: n 0U
    size_t: j 0U
    int: status 0
    if: out = 0
        return: 1
    out[0] := id
    if: value = 0 || id != 0U
        return: 0
    id := next[0]
    next[0] := id + 1U
    out[0] := id
    if: c.lmx_copy_map_put(map, value, (cast: (@) id)) != 0
        return: 1
    # Reserve and allocate before following any edge: a pointer target or a
    # lexical parent may lead back to this very cell or Structure.
    c.fprintf(f, "        @: void l2_gv%zu 0\n", id)
    if: kind = 1
        c.fprintf(f, "        l2_gv%zu: lmx_graph_int(l2_g, %d)\n", id, c.lmx_int_value_known(value))
    if: kind = 2
        text := c.lmx_graph_word_text(g, value)
        if: text = 0
            return: 1
        c.fprintf(f, "        l2_gv%zu: lmx_graph_word(l2_g, ", id)
        lm_graph_emit_quoted(f, text)
        c.fprintf(f, ", %zuU)\n", (cast: (size_t) c.strlen(text)))
    # G2.1: a typed number (a value cell of a literal row) is made again from its canonical spelling by the one reader
    # of number spellings, lmx_graph_number -- the same type and value.
    if: kind = 0 && c.lmx_graph_scalar_text(g, value, spelled, 64U) = 0
        c.fprintf(f, "        int: l2_gi%zu 0\n        if: lmx_graph_number(l2_g, ", id)
        lm_graph_emit_quoted(f, spelled)
        c.fprintf(f, ", %zuU, @ l2_gv%zu, @ l2_gi%zu) != 2\n            return: 1\n", (cast: (size_t) c.strlen(spelled)), id, id)
        scalar := 1
    if: kind = 4
        inner := (cast: (c.Lmx@) value)
        n := c.lmx_graph_count(inner)
        if: c.lmx_graph_fn_result(g, value) != 0
            # An image preserves a real constructed value, unlike language
            # merge(F), which deliberately produces an ordinary descriptor.
            c.fprintf(f, "        l2_gv%zu: (cast: (@: void) lmx_node_new_role_profiled(arena, 0, LMX_POOL_ROLE_FN))\n        if: l2_gv%zu = 0 || lmx_arena_refs_open_owned(arena, (cast: (@: Lmx) l2_gv%zu), %zuU) != 0\n            return: 1\n", id, id, id, n)
        else:
            c.fprintf(f, "        l2_gv%zu: (cast: (@: void) lmx_graph_lmx(l2_g, 0, %zuU))\n", id, n)
        ---
    if: kind = 3
        pointer_type := "LMX_TYPE_UNINIT_INT"
    if: kind = 5
        pointer_type := "LMX_TYPE_GRAPH_INT_REF"
    if: kind = 6
        pointer_type := "LMX_TYPE_GRAPH_LMX_REF"
    if: kind = 8
        pointer_type := "LMX_TYPE_UNINIT_GRAPH_INT_REF"
    if: kind = 9
        pointer_type := "LMX_TYPE_UNINIT_GRAPH_LMX_REF"
    if: pointer_type != 0
        c.fprintf(f, "        l2_gv%zu: lmx_arena_pointer_cells_profiled(arena, %s, 0, sizeof(@: void), lmx_arena_pointer_void_read, lmx_arena_pointer_void_write, 1U)\n", id, pointer_type)
    else:
        if: kind != 1 && kind != 2 && kind != 4 && scalar = 0
            return: 1
    ---
    c.fprintf(f, "        if: l2_gv%zu = 0\n            return: 1\n", id)
    c.snprintf(local, 64U, "l2_gv%zu", id)
    status := lm_graph_emit_name_row(g, f, value, local)
    if: pointer_type != 0 && status = 0
        # This copies a physical edge, including zero bits. It does not
        # consume a language value or infer an initialized state.
        status := lm_graph_emit_node(g, f, c.lmx_arena_pointer_void_read(value), map, next, @ target)
        if: status = 0
            if: target = 0U
                c.fprintf(f, "        if: lmx_arena_pointer_void_write(l2_gv%zu, 0) != 0\n            return: 1\n", id)
            else:
                c.fprintf(f, "        if: lmx_arena_pointer_void_write(l2_gv%zu, l2_gv%zu) != 0\n            return: 1\n", id, target)
            ---
        ---
    ---
    if: kind = 4 && status = 0
        while: j < n && status = 0
            status := lm_graph_emit_node(g, f, c.lmx_graph_get_in(g, inner, j), map, next, @ target)
            if: status = 0 && target != 0U
                c.fprintf(f, "        if: lmx_graph_put_in(l2_g, (cast: (@: Lmx) l2_gv%zu), %zuU, l2_gv%zu) != 0\n            return: 1\n", id, j, target)
            else:
                status := 1
            ---
            j := j + 1U
        ---
        if: status = 0 && inner\parent != 0
            status := lm_graph_emit_node(g, f, (cast: (@) inner\parent), map, next, @ target)
        ---
    ---
    return: status
end: lm_graph_emit_node

# A field edge uses the same map as every pointer and lexical parent edge.
fn: lm_graph_emit_value (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: source; @: value; char@: holder; size_t: k; c.LmxCopyMap@: map; size_t@: next) int
    size_t: id 0U
    int: status lm_graph_emit_node(g, f, value, map, next, @ id)
    if: status = 0 && id = 0U
        return: 1
    if: status = 0
        c.fprintf(f, "        if: lmx_graph_put_in(l2_g, %s, %zuU, l2_gv%zu) != 0\n            return: 1\n", holder, k, id)
    return: status
end: lm_graph_emit_value

# All graph addresses exist before lexical parent edges are installed, including
# a parent reached after its child. Use the emission's existing local labels to
# order these writes independently of the source-address hash buckets.
fn: lm_graph_emit_parents (c.LmxGraph@: g; c.FILE@: f; c.LmxCopyMap@: map; size_t: limit) int
    c.VoidDynamicArray@: keys @ map\keys
    c.VoidArray@: base (cast: (c.VoidArray@) keys)
    c.VoidArray@: vals (cast: (c.VoidArray@) (@ map\vals))
    @@: sources void (cast: (@@) base\data)
    @@: labels void (cast: (@@) vals\data)
    c.Lmx@@: ordered (cast: (c.Lmx@@) c.calloc(limit, sizeof(c.Lmx@)))
    c.Lmx@: current 0
    size_t: i 0U
    size_t: id 1U
    size_t: parent 0U
    int: status 0
    if: ordered = 0
        return: 1
    while: i < keys\capacity
        if: sources[i] != 0 && c.lmx_graph_kind(g, sources[i]) = 4
            ordered[(cast: (size_t) labels[i])] := (cast: (c.Lmx@) sources[i])
        i := i + 1U
    while: id < limit
        current := ordered[id]
        if: current = 0
            id := id + 1U
            continue
        parent := (cast: (size_t) c.lmx_copy_map_get(map, (cast: (@) current\parent)))
        if: current\parent != 0 && parent = 0U
            status := 1
            break
        c.fprintf(f, "        l2_method: (cast: (@: Lmx) l2_gv%zu)\n", id)
        if: current\parent = 0
            c.fputs("        l2_method\\parent: 0\n", f)
        else:
            c.fprintf(f, "        l2_method\\parent: (cast: (@: Lmx) l2_gv%zu)\n", parent)
        id := id + 1U
    c.free((cast: (@) ordered))
return: status


# Emit the address of a written substructure relative to this native activation's code. These field coordinates
# belong to emitted code only; the source graph has no saved lookup plan. Code mutation invalidates this entry.
fn: lm_graph_emit_address (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: scope; c.Lmx@: target) int
    c.Lmx@: parent 0
    size_t: i 0U
    if: target = scope
        c.fputs("lmx_call_code", f)
        return: 0
    if: target = 0
        return: 3
    # The body of the Structure the receiver created: the native code reaches it through that Structure's own part (the
    # Structure of the running traversal, lmx_call_code), never through a coordinate of the translation's Structure.
    if: c.lmx_graph_method(g, scope) != 0 && target = c.lmx_graph_method_code(g, scope)
        c.fputs("lmx_graph_method_code(l2_g, lmx_call_code)", f)
        return: 0
    parent := (cast: (c.Lmx@) target\parent)
    if: parent = 0
        return: 3
    while: i < c.lmx_graph_count(parent) && c.lmx_graph_get_in(g, parent, i) != (cast: (@) target)
        i := i + 1U
    ---
    if: i >= c.lmx_graph_count(parent)
        return: 3
    c.fputs("(cast: (@: Lmx) lmx_graph_get_in(l2_g, ", f)
    if: lm_graph_emit_address(g, f, scope, parent) != 0
        return: 3
    c.fprintf(f, ", %zuU))", i)
    return: 0
end: lm_graph_emit_address

# The head of a Frame read when the code runs: the name of its Lmx (§3.3), the canonical spelling.
fn: lm_graph_emit_head (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: scope; c.Lmx@: expression) int
    c.fputs("lmx_graph_name_of(l2_g, (cast: (@: void) ", f)
    if: lm_graph_emit_address(g, f, scope, expression) != 0
        return: 3
    c.fputs("))", f)
    return: 0
end: lm_graph_emit_head

fn: lm_graph_emit_word (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: scope; c.Lmx@: expression; size_t: index) int
    c.fputs("lmx_graph_word_text(l2_g, lmx_graph_get_in(l2_g, ", f)
    if: lm_graph_emit_address(g, f, scope, expression) != 0
        return: 3
    c.fprintf(f, ", %zuU))", index)
    return: 0
end: lm_graph_emit_word

# Calls compile argument evaluation and immediate admission in source order. The common invocation owns only the
# activation and default places; it dispatches the native method body, not an interpreter wrapper.
# The native emitter carries only its current temporary counter and error/return destinations. These are
# compiler traversal data; no cleanup stack, code or dispatch IDs are stored in the program graph.
sub: lm_graph_emit_leave_text (char@: buffer; int: label; int: status)
    if: label < 0
        c.snprintf(buffer, 64U, "return: %d", status)
    else:
        c.snprintf(buffer, 64U, "goto: l2_label%d", label)
    ---
    return
end: lm_graph_emit_leave_text

fn: lm_graph_emit_call_selected (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: scope; c.Lmx@: expression; int: selected; int@: temps; char@@: decl_names; size_t@: decl_slots; size_t: decl_n; int: want_result; int@: temp) int
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    c.LmxGraphState@: state (cast: (c.LmxGraphState@) c.lmx_graph_state())
    size_t: count (cast: (size_t) c.lmx_graph_count(expression))
    size_t: i 0U
    @: actual void 0
    c.Lmx@: holder expression
    size_t: at 0U
    int: call_id temps[0]
    int: done 0
    int: value 0
    int: status 0
    int: prior_failure temps[1]
    int: failed 0
    int: finished 0
    temps[0] := temps[0] + 1
    # The common head reader has already selected this target before actuals.
    c.fprintf(f, "        @: Lmx l2_call%d (cast: (@: Lmx) l2_v%d)\n", call_id, selected)
    if: want_result != 0
        c.fprintf(f, "        if: lmx_graph_has_result(l2_g, l2_call%d) = 0\n            %s\n", call_id, leave_failure)
    c.fprintf(f, "        []: size_t l2_binding%d %zuU\n        if: lmx_graph_bind_call(l2_g, lmx_call_code, l2_call%d, (cast: (@: Lmx) ", call_id, count + 1U, call_id)
    if: status = 0
        status := lm_graph_emit_address(g, f, scope, expression)
    c.fprintf(f, "), l2_binding%d) != 0\n            %s\n        LmxWalkValue: l2_cv%d\n        lmx_walk_value_clear(@ l2_cv%d)\n", call_id, leave_failure, call_id, call_id)
    # Actual storage is live before evaluating the first operand. A later
    # operand may collect; the selected target and pending result share the
    # same existing root span until this call's success or error cleanup.
    c.fprintf(f, "        []: LmxWalkValue l2_av%d %zuU\n        c.memset((cast: (@: void) l2_av%d), 0, sizeof(l2_av%d))\n        @: LmxExecutionRoots l2_arm%d lmx_execution_roots_mark(lmx_call_arena)\n        LmxExecutionRoots: l2_ar%d\n        LmxExecutionRoots: l2_ap%d\n", call_id, count + 1U, call_id, call_id, call_id, call_id, call_id)
    c.fprintf(f, "        lmx_execution_roots_push(lmx_call_arena, @ l2_ar%d, (cast: (@: void) @ l2_cv%d), 1U, 0, 0U, (cast: (@: void) l2_call%d), 0)\n        lmx_execution_roots_push(lmx_call_arena, @ l2_ap%d, (cast: (@: void) l2_av%d), %zuU, 0, 0U, 0, 0)\n", call_id, call_id, call_id, call_id, call_id, count)
    failed := temps[0]
    finished := failed + 1
    temps[0] := finished + 1
    temps[1] := failed
    lm_graph_emit_leave_text(leave_failure, failed, 1)
    # The live target determines how the preserved argument is read. The
    # binding map carries that choice; no lexical prediction is repeated here.
    if: count = 1U && status = 0
        done := temps[0]
        temps[0] := done + 1
        c.fprintf(f, "        if: l2_binding%d[1U] != 0U\n            if: l2_binding%d[1U] = 1U\n                if: lmx_graph_eval_record(l2_g, lmx_call_code, lmx_graph_get_in(l2_g, ", call_id, call_id)
        status := lm_graph_emit_address(g, f, scope, expression)
        c.fprintf(f, ", 0U), @ l2_av%d[0U]) != 0\n                    %s\n                ---\n            else:\n                if: lmx_walk_value_cell(lmx_call_arena, lmx_graph_get_in(l2_g, ", call_id, leave_failure)
        status := lm_graph_emit_address(g, f, scope, expression)
        c.fprintf(f, ", 0U), @ l2_av%d[0U]) != 0\n                    %s\n                ---\n            ---\n            if: lmx_graph_call_single_record(l2_g, l2_call%d, @ l2_av%d[0U], @ l2_cv%d) != 0\n                %s\n            goto: l2_label%d\n", call_id, leave_failure, call_id, call_id, call_id, leave_failure, done)
    while: i < count && status = 0
        holder := expression
        at := i
        actual := c.lmx_graph_get_in(g, expression, at)
        if: c.lmx_graph_kind(g, actual) = 4 && c.lmx_graph_name_of(g, actual) = 0 && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, (cast: (c.Lmx@) actual), 0U)) = state\w_assign
            if: c.lmx_graph_count((cast: (c.Lmx@) actual)) != 3U
                return: 5
            holder := (cast: (c.Lmx@) actual)
            at := 2U
        actual := c.lmx_graph_get_in(g, holder, at)
        # A written group and a form (a declaration among the actuals: a Frame of a declaring receiver, or the named cell of a
        # literal form) are read by the reader of the runtime, as the interpreter reads them: nothing of a form is compiled or run here.
        if: c.lmx_graph_written_group(g, actual) != 0 || (c.lmx_graph_kind(g, actual) = 4 && c.lmx_graph_declaration_name(g, actual) != 0) || (c.lmx_graph_kind(g, actual) = 1 && c.lmx_graph_name_of(g, actual) != 0)
            c.fprintf(f, "        if: lmx_graph_read_actual_value(l2_g, lmx_call_code, l2_call%d, l2_binding%d[%zuU], lmx_graph_get_in(l2_g, ", call_id, call_id, i)
            status := lm_graph_emit_address(g, f, scope, holder)
            c.fprintf(f, ", %zuU), @ l2_av%d[%zuU]) != 0\n            %s\n", at, call_id, i, leave_failure)
        else:
            status := lm_graph_emit_record(g, f, scope, holder, at, temps, decl_names, decl_slots, decl_n, @ value)
            c.fprintf(f, "        c.memcpy((cast: (@: void) (@ l2_av%d[%zuU])), (cast: (const: @: void) (@ l2_cv%d)), c.sizeof(LmxWalkValue))\n", call_id, i, value)
            c.fprintf(f, "        if: lmx_graph_admit_value(l2_g, l2_call%d, lmx_graph_method_data(l2_g, l2_call%d), l2_binding%d[%zuU], @ l2_av%d[%zuU], @ l2_av%d[%zuU]) != 0\n            %s\n", call_id, call_id, call_id, i, call_id, i, call_id, i, leave_failure)
        i := i + 1U
    ---
    c.fprintf(f, "        if: lmx_graph_invoke_values(l2_g, l2_call%d, l2_av%d, %zuU, l2_binding%d, @ l2_cv%d) != 0\n            %s\n", call_id, call_id, count, call_id, call_id, leave_failure)
    if: done != 0
        c.fprintf(f, "        l2_label%d:\n", done)
    if: want_result = 1
        c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_result_int(l2_g, @ l2_cv%d, @ l2_t%d) != 0\n            %s\n", call_id, call_id, call_id, leave_failure)
    if: want_result = 2
        c.fprintf(f, "        @: void l2_v%d 0\n        if: lmx_graph_result_cell(l2_g, @ l2_cv%d, @ l2_v%d) != 0\n            %s\n", call_id, call_id, call_id, leave_failure)
    c.fprintf(f, "        lmx_execution_roots_restore(lmx_call_arena, l2_arm%d)\n        goto: l2_label%d\n        l2_label%d:\n        lmx_execution_roots_restore(lmx_call_arena, l2_arm%d)\n", call_id, finished, failed, call_id)
    temps[1] := prior_failure
    lm_graph_emit_leave_text(leave_failure, prior_failure, 1)
    c.fprintf(f, "        %s\n        l2_label%d:\n", leave_failure, finished)
    temp[0] := call_id
    return: status
end: lm_graph_emit_call_selected

# Compile an operand's address. Field paths preserve Structure values for receiving; only arithmetic/call results
# need a new result cell. Formal places are addressed directly in the current activation.
# Full result consumers do not turn a call into an address and reload it.
# The record retains the actual per-Value SOURCE/Model across cleanup.
fn: lm_graph_emit_record (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: scope; c.Lmx@: holder; size_t: index; int@: temps; char@@: decl_names; size_t@: decl_slots; size_t: decl_n; int@: temp) int
    c.LmxGraphState@: state (cast: (c.LmxGraphState@) c.lmx_graph_state())
    @: raw void c.lmx_graph_get_in(g, holder, index)
    char@: word 0
    int: cell 0
    int: result 0
    int: status 0
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    if: c.lmx_graph_kind(g, raw) = 2
        # A bare name already has its complete selected working Value. Do
        # not materialize a numeric cell and reload away its SOURCE/Model.
        result := temps[0]
        temps[0] := result + 1
        c.fprintf(f, "        LmxWalkValue: l2_cv%d\n        lmx_walk_value_clear(@ l2_cv%d)\n        if: lmx_graph_eval_record(l2_g, lmx_call_code, lmx_graph_get_in(l2_g, ", result, result)
        status := lm_graph_emit_address(g, f, scope, holder)
        c.fprintf(f, ", %zuU), @ l2_cv%d) != 0\n            %s\n", index, result, leave_failure)
        temp[0] := result
        return: status
    if: c.lmx_graph_kind(g, raw) = 4
        word := c.lmx_graph_name_of(g, raw)
        if: word = 0 && c.lmx_graph_count((cast: (c.Lmx@) raw)) = 1U && c.lmx_graph_group_expression(g, scope, raw) != 0
            return: lm_graph_emit_record(g, f, scope, (cast: (c.Lmx@) raw), 0U, temps, decl_names, decl_slots, decl_n, temp)
        if: word = state\w_fncall
            return: lm_graph_emit_fncall(g, f, scope, (cast: (c.Lmx@) raw), temps, decl_names, decl_slots, decl_n, 3, temp)
        if: word = 0 || c.lmx_graph_language_word(state, word) = 0
            if: c.lmx_graph_application_parts(g, raw, 0, 0, 0) != 0
                return: lm_graph_emit_application(g, f, scope, (cast: (c.Lmx@) raw), temps, decl_names, decl_slots, decl_n, 3, temp)
            ---
        ---
    ---
    status := lm_graph_emit_operand(g, f, scope, holder, index, temps, decl_names, decl_slots, decl_n, @ cell)
    if: status != 0
        return: status
    result := temps[0]
    temps[0] := result + 1
    c.fprintf(f, "        LmxWalkValue: l2_cv%d\n        lmx_walk_value_clear(@ l2_cv%d)\n        if: lmx_graph_kind(l2_g, l2_v%d) = 3\n            l2_v%d: lmx_arena_pointer_void_read(l2_v%d)\n        if: lmx_walk_value_cell(lmx_call_arena, l2_v%d, @ l2_cv%d) != 0\n            %s\n", result, result, cell, cell, cell, cell, result, leave_failure)
    temp[0] := result
    return: 0
end: lm_graph_emit_record

fn: lm_graph_emit_operand (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: scope; c.Lmx@: holder; size_t: index; int@: temps; char@@: decl_names; size_t@: decl_slots; size_t: decl_n; int@: temp) int
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    c.LmxGraphState@: state (cast: (c.LmxGraphState@) c.lmx_graph_state())
    @: raw void c.lmx_graph_get_in(g, holder, index)
    c.Lmx@: expression 0
    c.Lmx@: args 0
    char@: word c.lmx_graph_word_text(g, raw)
    size_t: count 0U
    size_t: slot 0U
    int: kind (cast: (int) c.lmx_graph_kind(g, raw))
    int: value 0
    int: number 0
    int: status 0
    # User applications carry a full result. Numeric built-ins keep their
    # existing emitter; only a numerical consumer asks for an int projection.
    if: kind = 4 && c.lmx_graph_name_of(g, raw) != 0
        if: c.lmx_graph_name_of(g, raw) = state\w_merge
            return: lm_graph_emit_merge(g, f, scope, (cast: (c.Lmx@) raw), temps, decl_names, decl_slots, decl_n, temp)
        if: c.lmx_graph_name_of(g, raw) = state\w_fncall
            return: lm_graph_emit_fncall(g, f, scope, (cast: (c.Lmx@) raw), temps, decl_names, decl_slots, decl_n, 2, temp)
        if: c.lmx_graph_language_word(state, c.lmx_graph_name_of(g, raw)) = 0
            return: lm_graph_emit_application(g, f, scope, (cast: (c.Lmx@) raw), temps, decl_names, decl_slots, decl_n, 2, temp)
        status := lm_graph_emit_number(g, f, scope, holder, index, temps, decl_names, decl_slots, decl_n, @ number)
        if: status != 0
            return: status
        value := temps[0]
        temps[0] := temps[0] + 1
        c.fprintf(f, "        @: void l2_v%d lmx_graph_int(l2_g, l2_t%d)\n        if: l2_v%d = 0\n            %s\n", value, number, value, leave_failure)
        temp[0] := value
        return: 0
    if: kind = 4 && c.lmx_graph_application_parts(g, raw, 0, 0, 0) != 0
        return: lm_graph_emit_application(g, f, scope, (cast: (c.Lmx@) raw), temps, decl_names, decl_slots, decl_n, 2, temp)
    if: kind = 4 && c.lmx_graph_group_expression(g, scope, raw) != 0
        expression := (cast: (c.Lmx@) raw)
        count := c.lmx_graph_count(expression)
        # The index of a Structure, `base[index]` (the book, structure-index), as the interpreter reads it: the base's
        # value and the index's number, then the kernel's read of the slot.
        if: count = 3U && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, expression, 1U)) = state\w_index
            status := lm_graph_emit_received_operand(g, f, scope, expression, 0U, 2, -1, temps, decl_names, decl_slots, decl_n, @ value)
            if: status != 0
                return: status
            status := lm_graph_emit_number(g, f, scope, expression, 2U, temps, decl_names, decl_slots, decl_n, @ number)
            if: status != 0
                return: status
            c.fprintf(f, "        if: lmx_graph_index(l2_g, l2_v%d, l2_t%d, @ l2_v%d) != 0\n            %s\n", value, number, value, leave_failure)
            temp[0] := value
            return: 0
        if: count = 3U && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, expression, 1U)) = state\w_deref
            status := lm_graph_emit_received_operand(g, f, scope, expression, 0U, 2, -1, temps, decl_names, decl_slots, decl_n, @ value)
            if: status != 0
                return: status
            # The path step, through an atom too, as the interpreter takes it (lmx_graph_step; plan M11 5a).
            c.fputs("        if: lmx_graph_step(l2_g, l2_v", f)
            c.fprintf(f, "%d, ", value)
            c.fputs("lmx_graph_get_in(l2_g, ", f)
            if: lm_graph_emit_address(g, f, scope, expression) != 0
                return: 3
            c.fputs(", 2U)", f)
            c.fprintf(f, ", @ l2_v%d) != 0\n            %s\n", value, leave_failure)
            c.fprintf(f, "        if: lmx_graph_reference_cell(l2_g, l2_v%d) != 0\n            l2_v%d: lmx_graph_reference_value(l2_g, l2_v%d)\n        if: l2_v%d = 0\n            %s\n", value, value, value, value, leave_failure)
            temp[0] := value
            return: 0
        word := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, expression, 0U))
        if: count = 2U && word = state\w_at
            if: c.lmx_graph_kind(g, c.lmx_graph_get_in(g, expression, 1U)) = 2
                value := temps[0]
                temps[0] := temps[0] + 1
                c.fputs("        if: lmx_graph_input_take(l2_g, ", f)
                status := lm_graph_emit_word(g, f, scope, expression, 1U)
                if: status != 0
                    return: status
                c.fprintf(f, ") != 0\n            %s\n", leave_failure)
                c.fprintf(f, "        @: void l2_v%d lmx_graph_resolve(l2_g, lmx_call_code, ", value)
                status := lm_graph_emit_word(g, f, scope, expression, 1U)
                c.fputs(")\n", f)
            else:
                status := lm_graph_emit_operand(g, f, scope, expression, 1U, temps, decl_names, decl_slots, decl_n, @ value)
            ---
            if: status != 0
                return: status
            c.fprintf(f, "        if: lmx_graph_kind(l2_g, l2_v%d) = 3\n            l2_v%d: lmx_arena_pointer_void_read(l2_v%d)\n        l2_v%d: lmx_graph_ref_int(l2_g, l2_v%d)\n        if: l2_v%d = 0\n            %s\n", value, value, value, value, value, value, leave_failure)
            temp[0] := value
            return: 0
        if: count = 1U && c.lmx_graph_method(g, (cast: (c.Lmx@) c.lmx_graph_target(g, c.lmx_graph_resolve(g, scope, word)))) = 0
            return: lm_graph_emit_operand(g, f, scope, expression, 0U, temps, decl_names, decl_slots, decl_n, temp)
        status := lm_graph_emit_number(g, f, scope, holder, index, temps, decl_names, decl_slots, decl_n, @ number)
        if: status != 0
            return: status
        value := temps[0]
        temps[0] := temps[0] + 1
        c.fprintf(f, "        @: void l2_v%d lmx_graph_int(l2_g, l2_t%d)\n        if: l2_v%d = 0\n            %s\n", value, number, value, leave_failure)
        temp[0] := value
        return: 0
    value := temps[0]
    temps[0] := temps[0] + 1
    if: kind = 2
        c.fprintf(f, "        @: void l2_v%d lmx_graph_operand_name(l2_g, lmx_call_code, ", value)
        if: lm_graph_emit_word(g, f, scope, holder, index) != 0
            return: 3
        c.fputs(")\n", f)
    else:
        c.fprintf(f, "        @: void l2_v%d lmx_graph_get_in(l2_g, ", value)
        if: lm_graph_emit_address(g, f, scope, holder) != 0
            return: 3
        c.fprintf(f, ", %zuU)\n", index)
    ---
    c.fprintf(f, "        if: l2_v%d = 0\n            %s\n", value, leave_failure)
    if: kind != 2
        c.fprintf(f, "        if: lmx_graph_reference_cell(l2_g, l2_v%d) != 0\n            l2_v%d: lmx_graph_reference_value(l2_g, l2_v%d)\n        if: l2_v%d = 0\n            %s\n", value, value, value, value, leave_failure)
    temp[0] := value
    return: 0
end: lm_graph_emit_operand

# A known Structure/address context keeps a written value in its source slot.
# For a dynamic reference destination only live kind6 does so; live kind5
# evaluates the same group after preflight, as the existing actual reader does.
fn: lm_graph_emit_received_operand (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: scope; c.Lmx@: holder; size_t: index; int: contract; int: receiving_kind; int@: temps; char@@: decl_names; size_t@: decl_slots; size_t: decl_n; int@: temp) int
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    int: value 0
    int: status 0
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    if: (contract = 2 || receiving_kind >= 0) && c.lmx_graph_written_group(g, c.lmx_graph_get_in(g, holder, index)) != 0
        value := temps[0]
        temps[0] := temps[0] + 1
        c.fprintf(f, "        @: void l2_v%d lmx_graph_get_in(l2_g, ", value)
        status := lm_graph_emit_address(g, f, scope, holder)
        if: status != 0
            return: status
        c.fprintf(f, ", %zuU)\n", index)
        if: receiving_kind >= 0
            c.fprintf(f, "        if: l2_k%d != 6 && lmx_graph_eval_value(l2_g, lmx_call_code, l2_v%d, @ l2_v%d) != 0\n            %s\n", receiving_kind, value, value, leave_failure)
        temp[0] := value
        return: 0
    return: lm_graph_emit_operand(g, f, scope, holder, index, temps, decl_names, decl_slots, decl_n, temp)

# Compile one nested numeric expression. All grouping/precedence is already represented by its child Lmx fields.
# A well-formed value without a numeric interpretation fails when reached.
# Keep its temporary valid in every generated receiving-context branch.
fn: lm_graph_emit_number_refused (c.FILE@: f; int@: temps; int@: temp) int
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    int: value temps[0]
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    temps[0] := temps[0] + 1
    c.fprintf(f, "        int: l2_t%d 0\n        if: 1\n            %s\n", value, leave_failure)
    temp[0] := value
return: 0

fn: lm_graph_emit_number (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: scope; c.Lmx@: holder; size_t: index; int@: temps; char@@: decl_names; size_t@: decl_slots; size_t: decl_n; int@: temp) int
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    c.LmxGraphState@: state (cast: (c.LmxGraphState@) c.lmx_graph_state())
    @: raw void c.lmx_graph_get_in(g, holder, index)
    c.Lmx@: expression 0
    char@: word 0
    @: method void 0
    size_t: count 0U
    size_t: slot 0U
    int: kind (cast: (int) c.lmx_graph_kind(g, raw))
    int: left 0
    int: right 0
    int: value 0
    int: status 0
    int: finish 0
    if: kind = 1
        left := temps[0]
        temps[0] := temps[0] + 1
        c.fprintf(f, "        int: l2_t%d %d\n", left, c.lmx_int_value_known(raw))
        temp[0] := left
        return: 0
    if: kind = 2
        left := temps[0]
        temps[0] := temps[0] + 1
        c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_named_int(l2_g, lmx_call_code, ", left)
        status := lm_graph_emit_word(g, f, scope, holder, index)
        c.fprintf(f, ", @ l2_t%d) != 0\n            %s\n", left, leave_failure)
        temp[0] := left
        return: status
    if: kind = 4 && c.lmx_graph_name_of(g, raw) != 0
        # A Frame: the application of the callable its head names when this translation resolves it; a head it cannot
        # resolve names a place the code declares when it runs (a reference to a callable or to a merge result) or none:
        # its call is then resolved, bound and dispatched by the kernel when the code runs, as by the interpreter -- the
        # callee's native entry, or the interpreter for a Structure without one; a missing name fails there. No merge is
        # computed ahead of execution.
        expression := (cast: (c.Lmx@) raw)
        word := c.lmx_graph_name_of(g, raw)
        # The receiver typeof (the book, get-type), as the interpreter reads it: the code asks the kernel for the type of
        # the region that holds the address its one argument stands for; a written zero is the null address.
        if: word = state\w_typeof
            if: c.lmx_graph_count(expression) != 1U
                return: 5
            left := temps[0]
            temps[0] := temps[0] + 1
            method := c.lmx_graph_get_in(g, expression, 0U)
            if: c.lmx_graph_kind(g, method) = 1 && c.lmx_graph_name_of(g, method) = 0 && c.lmx_int_value_known(method) = 0
                c.fprintf(f, "        int: l2_t%d %d\n", left, c.LMX_TYPE_NONE)
                temp[0] := left
                return: 0
            status := lm_graph_emit_received_operand(g, f, scope, expression, 0U, 2, -1, temps, decl_names, decl_slots, decl_n, @ value)
            if: status != 0
                return: status
            c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_address_type(l2_g, l2_v%d, @ l2_t%d) != 0\n            %s\n", left, value, left, leave_failure)
            temp[0] := left
            return: 0
        # The receiver length (the book, structure-index): the code asks the kernel for the number of the fields of the
        # Structure its one argument stands for.
        if: word = state\w_length
            if: c.lmx_graph_count(expression) != 1U
                return: 5
            status := lm_graph_emit_received_operand(g, f, scope, expression, 0U, 2, -1, temps, decl_names, decl_slots, decl_n, @ value)
            if: status != 0
                return: status
            left := temps[0]
            temps[0] := temps[0] + 1
            c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_length(l2_g, l2_v%d, @ l2_t%d) != 0\n            %s\n", left, value, left, leave_failure)
            temp[0] := left
            return: 0
        # The receiver fncall (the book, call-receivers): the launch of the code it is given, with its result.
        if: word = state\w_fncall
            return: lm_graph_emit_fncall(g, f, scope, expression, temps, decl_names, decl_slots, decl_n, 1, temp)
        # The live launch selects the callee before actuals, including a local
        # declaration that shadows this translation's lexical fallback. Its
        # result contract is checked before any actual can have an effect.
        if: c.lmx_graph_language_word(state, word) = 0
            return: lm_graph_emit_application(g, f, scope, expression, temps, decl_names, decl_slots, decl_n, 1, temp)
        return: lm_graph_emit_number_refused(f, temps, temp)
    if: kind = 4
        expression := (cast: (c.Lmx@) raw)
        if: c.lmx_graph_application_parts(g, raw, 0, 0, 0) != 0
            return: lm_graph_emit_application(g, f, scope, expression, temps, decl_names, decl_slots, decl_n, 1, temp)
        count := c.lmx_graph_count(expression)
        word := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, expression, 1U))
        if: c.lmx_expr_is_chain(g, raw) != 0
            return: lm_graph_emit_chain(g, f, scope, expression, temps, decl_names, decl_slots, decl_n, temp)
        word := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, expression, 0U))
        if: count = 2U && word = state\w_deref
            status := lm_graph_emit_operand(g, f, scope, expression, 1U, temps, decl_names, decl_slots, decl_n, @ value)
            if: status != 0
                return: status
            left := temps[0]
            temps[0] := temps[0] + 1
            c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_kind(l2_g, l2_v%d) != 5\n            %s\n        if: lmx_graph_value_int(l2_g, lmx_arena_pointer_void_read(l2_v%d), @ l2_t%d) != 0\n            %s\n", left, value, leave_failure, value, left, leave_failure)
            temp[0] := left
            return: 0
        if: count = 1U
            return: lm_graph_emit_number(g, f, scope, expression, 0U, temps, decl_names, decl_slots, decl_n, temp)
        # A field path gives the int of its place; the index of a Structure gives an address, which has no int: the code
        # refuses it when it runs, as the interpreter does.
        if: count != 3U || (c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, expression, 1U)) != state\w_deref && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, expression, 1U)) != state\w_index)
            return: lm_graph_emit_number_refused(f, temps, temp)
        ---
    ---
    status := lm_graph_emit_operand(g, f, scope, holder, index, temps, decl_names, decl_slots, decl_n, @ value)
    if: status != 0
        return: status
    left := temps[0]
    temps[0] := temps[0] + 1
    c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_value_int(l2_g, l2_v%d, @ l2_t%d) != 0\n            %s\n", left, value, left, leave_failure)
    temp[0] := left
    return: 0
end: lm_graph_emit_number

# The test of a lazy operation (&& or ||) before its next argument: the value so far becomes 0 or 1, and a decided result jumps to the end label (the text the interpreter's
# lmx_graph_eval_tree decides at run time).
sub: lm_graph_emit_lazy_step (c.FILE@: f; char@: word; int: left; int: finish)
    c.LmxGraphState@: state (cast: (c.LmxGraphState@) c.lmx_graph_state())
    c.fprintf(f, "        l2_t%d: (l2_t%d != 0)\n", left, left)
    if: word = state\w_and
        c.fprintf(f, "        if: l2_t%d = 0\n            goto: l2_label%d\n", left, finish)
    if: word = state\w_or
        c.fprintf(f, "        if: l2_t%d != 0\n            goto: l2_label%d\n", left, finish)
    return

# One node of the tree of the common analysis (lmx_expr_tree), emitted in the order the interpreter walks it (lmx_graph_eval_tree): a field of the chain is compiled by
# lm_graph_emit_number; an operation emits its first argument, then for each next argument the argument and one line of C that applies the operator to the temporaries (a lazy operation
# first tests the value so far). For a node of two arguments the text is the text of the former nested node. The temporary of the value in temp.
fn: lm_graph_emit_tree (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: scope; size_t@: tn; int@: temps; char@@: decl_names; size_t@: decl_slots; size_t: decl_n; int@: temp) int
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    c.LmxGraphState@: state (cast: (c.LmxGraphState@) c.lmx_graph_state())
    char@: word 0
    size_t: i 1U
    int: left 0
    int: right 0
    int: finish 0
    int: status 0
    if: state = 0 || tn = 0
        return: 2
    if: tn[0] = 0U
        return: lm_graph_emit_number(g, f, scope, (cast: (c.Lmx@) tn[3]), tn[1], temps, decl_names, decl_slots, decl_n, temp)
    word := (cast: (char@) tn[1])
    status := lm_graph_emit_tree(g, f, scope, (cast: (size_t@) tn[4U]), temps, decl_names, decl_slots, decl_n, @ left)
    if: status != 0
        return: status
    if: tn[3] = 1U
        if: word = state\w_minus
            c.fprintf(f, "        l2_t%d: 0 - l2_t%d\n", left, left)
        if: word = state\w_not
            c.fprintf(f, "        l2_t%d: (l2_t%d = 0)\n", left, left)
        temp[0] := left
        return: 0
    if: tn[3] = 2U
        finish := temps[0]
        temps[0] := temps[0] + 1
    while: i < tn[2]
        if: tn[3] = 2U
            lm_graph_emit_lazy_step(f, word, left, finish)
        status := lm_graph_emit_tree(g, f, scope, (cast: (size_t@) tn[4U + i]), temps, decl_names, decl_slots, decl_n, @ right)
        if: status != 0
            return: status
        if: word = state\w_slash || word = state\w_percent
            c.fprintf(f, "        if: l2_t%d = 0\n            %s\n", right, leave_failure)
        c.fprintf(f, "        l2_t%d: l2_t%d %s l2_t%d\n", left, left, word, right)
        i := i + 1U
    if: tn[3] = 2U
        c.fprintf(f, "        l2_label%d:\n", finish)
    temp[0] := left
    return: 0

# An expression the fields of chain are, compiled: the tree of the common analysis, emitted by lm_graph_emit_tree and released. Fields that do not read as an expression are compiled
# as a refusal that the code gives when it runs, as for any shape without a numeric reading.
fn: lm_graph_emit_chain (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: scope; c.Lmx@: chain; int@: temps; char@@: decl_names; size_t@: decl_slots; size_t: decl_n; int@: temp) int
    size_t@: tree 0
    int: status c.lmx_expr_tree(g, chain, @ tree)
    if: status = 2
        return: lm_graph_emit_number_refused(f, temps, temp)
    if: status != 0
        return: status
    status := lm_graph_emit_tree(g, f, scope, tree, temps, decl_names, decl_slots, decl_n, temp)
    c.lmx_expr_free(tree)
    return: status

fn: lm_graph_emit_expr (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: root; c.Lmx@: expr; size_t: from; size_t: to; int@: temps; char@@: decl_names; size_t@: decl_slots; size_t: decl_n; int@: temp) int
    if: to != from + 1U
        return: 2
    return: lm_graph_emit_number(g, f, root, expr, from, temps, decl_names, decl_slots, decl_n, temp)
end: lm_graph_emit_expr

# The written value of actual index of a launch record, as the interpreter takes it (lmx_graph_launch_actual): the
# operand of `name := value` -- its holder and index in out --, or the actual itself.
sub: lm_graph_launch_actual (c.LmxGraph@: g; c.Lmx@: expression; size_t: index; c.Lmx@@: holder; size_t@: at)
    c.LmxGraphState@: state (cast: (c.LmxGraphState@) c.lmx_graph_state())
    @: raw void c.lmx_graph_get_in(g, expression, index)
    holder[0] := expression
    at[0] := index
    if: state != 0 && c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_count((cast: (c.Lmx@) raw)) = 3U && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, (cast: (c.Lmx@) raw), 0U)) = state\w_assign
        holder[0] := (cast: (c.Lmx@) raw)
        at[0] := 2U
    ---
    return
end: lm_graph_launch_actual

# An operand of a launch that stands for a Structure -- the arguments, the data, the code --, actual index of a launch
# record, as the interpreter takes it (lmx_graph_launch_operand): an anonymous Structure written in parentheses is that
# Structure as written (lmx_graph_merge_literal), the code reads it from its place in the graph; any other operand is
# evaluated (lm_graph_emit_operand). The value in the void temporary in temp.
fn: lm_graph_emit_launch_operand (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: scope; c.Lmx@: expression; size_t: index; int@: temps; char@@: decl_names; size_t@: decl_slots; size_t: decl_n; int@: temp) int
    c.Lmx@: holder 0
    size_t: at 0U
    lm_graph_launch_actual(g, expression, index, @ holder, @ at)
    return: lm_graph_emit_received_operand(g, f, scope, holder, at, 2, -1, temps, decl_names, decl_slots, decl_n, temp)
end: lm_graph_emit_launch_operand

# call in native code (the book, call-receivers): the forms [code], [data code], [args data code], given by position or
# by name through `:=` -- the translation binds the record by the interpreter's one binder (lmx_graph_launch_formals;
# R22). The operands are evaluated in the order they are written (lm_graph_emit_launch_operand); the launch is the
# kernel's own (lmx_graph_call_data, lmx_graph_launch), shared with the interpreter. No form: the code refuses the record
# where it reaches it, as the interpreter does (5).
fn: lm_graph_emit_explicit_call (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: scope; c.Lmx@: expression; int@: temps; char@@: decl_names; size_t@: decl_slots; size_t: decl_n) int
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    c.LmxGraphState@: state (cast: (c.LmxGraphState@) c.lmx_graph_state())
    char@@: formals 0
    char@: head 0
    size_t: count c.lmx_graph_count(expression)
    size_t: i 0U
    int: code -1
    int: data -1
    int: args -1
    int: value 0
    int: reading -1
    int: status 0
    if: state = 0
        return: 5
    formals := (cast: (char@@) c.calloc(count + 1U, sizeof(char@)))
    if: formals = 0
        return: 4
    head := state\w_call
    status := c.lmx_graph_launch_formals(g, head, expression, formals)
    # One actual: the reading of the general algorithm decides first (R87-R93); the record as written goes on below.
    if: count = 1U && status = 0
        reading := temps[0]
        temps[0] := temps[0] + 1
        c.fprintf(f, "        @: Lmx l2_ro%d 0\n        int: l2_rr%d lmx_graph_receiver_reading(l2_g, lmx_call_code, ", reading, reading)
        status := lm_graph_emit_head(g, f, scope, expression)
        c.fputs(", (cast: (@: Lmx) ", f)
        if: status = 0
            status := lm_graph_emit_address(g, f, scope, expression)
        c.fprintf(f, "), 1, @ l2_ro%d)\n        if: l2_rr%d = 3 || (l2_rr%d = 1 && lmx_graph_eval_explicit_call(l2_g, lmx_call_code, l2_ro%d) != 0)\n            %s\n        if: l2_rr%d != 0\n            goto: l2_label%d\n", reading, reading, reading, reading, leave_failure, reading, reading)
    if: status = 5
        c.free((cast: (@) formals))
        c.fprintf(f, "        if: 1\n            %s\n", leave_failure)
        return: 0
    ---
    while: status = 0 && i < count
        status := lm_graph_emit_launch_operand(g, f, scope, expression, i, temps, decl_names, decl_slots, decl_n, @ value)
        if: formals[i] = state\w_args
            args := value
        if: formals[i] = state\w_data
            data := value
        if: formals[i] = state\w_code
            code := value
        i := i + 1U
    ---
    c.free((cast: (@) formals))
    if: status != 0
        return: status
    # [args data code]: the parts of a launch without a result (lmx_graph_launch).
    if: args >= 0
        c.fprintf(f, "        if: l2_v%d = 0 || l2_v%d = 0 || l2_v%d = 0 || lmx_graph_launch(l2_g, (cast: (@: Lmx) l2_v%d), (cast: (@: Lmx) l2_v%d), 0, (cast: (@: Lmx) l2_v%d), 0) != 0\n            %s\n", args, data, code, args, data, code, leave_failure)
        return: 0
    # [data code]: the code over the data (the author 2026-11-11, LMX_blog/2026-11-11.md#data-before-code).
    if: data >= 0
        c.fprintf(f, "        if: lmx_graph_call_data(l2_g, (cast: (@: Lmx) l2_v%d), (cast: (@: Lmx) l2_v%d), 0) != 0\n            %s\n", data, code, leave_failure)
        return: 0
    # [code]: the code alone; it selects its data (lmx_graph_call_data, shorthand).
    c.fprintf(f, "        if: lmx_graph_call_data(l2_g, 0, (cast: (@: Lmx) l2_v%d), 1) != 0\n            %s\n", code, leave_failure)
    if: reading >= 0
        c.fprintf(f, "        l2_label%d:\n", reading)
    return: 0
end: lm_graph_emit_explicit_call

# fncall in native code (the book, call-receivers): `fncall(args data return code)`, `fncall(data return code)`,
# `fncall(return code)`, given by position or by name through `:=` -- the translation binds the record by the
# interpreter's one binder (lmx_graph_launch_formals; R22). The operands are evaluated in the order they are written:
# the arguments, the data and the code as operands of a launch (lm_graph_emit_launch_operand); the description of the
# result is the word of the language written there, or the word a value holds when the code runs (the return part of a
# callable); the launch is the kernel's own (lmx_graph_launch), shared with the interpreter. The result is the int
# temporary in temp.
fn: lm_graph_emit_fncall (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: scope; c.Lmx@: expression; int@: temps; char@@: decl_names; size_t@: decl_slots; size_t: decl_n; int: want_result; int@: temp) int
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    c.LmxGraphState@: state (cast: (c.LmxGraphState@) c.lmx_graph_state())
    char@@: formals 0
    c.Lmx@: holder 0
    char@: word 0
    size_t: count c.lmx_graph_count(expression)
    size_t: i 0U
    size_t: at 0U
    int: args -1
    int: data -1
    int: described -1
    int: code 0
    int: value 0
    int: left 0
    int: status 0
    if: state = 0
        return: 5
    formals := (cast: (char@@) c.calloc(count + 1U, sizeof(char@)))
    if: formals = 0
        return: 4
    word := state\w_fncall
    status := c.lmx_graph_launch_formals(g, word, expression, formals)
    word := 0
    # No form of fncall: the code refuses it where it reaches it, as the interpreter does (5).
    if: status = 5
        c.free((cast: (@) formals))
        left := temps[0]
        temps[0] := temps[0] + 1
        if: want_result = 3
            c.fprintf(f, "        LmxWalkValue: l2_cv%d\n        lmx_walk_value_clear(@ l2_cv%d)\n", left, left)
        else:
            if: want_result = 2
                c.fprintf(f, "        @: void l2_v%d 0\n", left)
            else:
                c.fprintf(f, "        int: l2_t%d 0\n", left)
            ---
        ---
        c.fprintf(f, "        if: 1\n            %s\n", leave_failure)
        temp[0] := left
        return: 0
    ---
    while: status = 0 && i < count
        if: formals[i] = state\w_return
            lm_graph_launch_actual(g, expression, i, @ holder, @ at)
            word := c.lmx_graph_word_text(g, c.lmx_graph_description_value(g, c.lmx_graph_get_in(g, holder, at)))
            if: word = 0 || c.lmx_graph_language_word(state, word) = 0
                word := 0
                status := lm_graph_emit_operand(g, f, scope, holder, at, temps, decl_names, decl_slots, decl_n, @ described)
            ---
        else:
            status := lm_graph_emit_launch_operand(g, f, scope, expression, i, temps, decl_names, decl_slots, decl_n, @ value)
            if: formals[i] = state\w_args
                args := value
            if: formals[i] = state\w_data
                data := value
            if: formals[i] = state\w_code
                code := value
        ---
        i := i + 1U
    ---
    c.free((cast: (@) formals))
    if: status != 0
        return: status
    left := temps[0]
    temps[0] := temps[0] + 1
    c.fprintf(f, "        LmxWalkValue: l2_cv%d\n        lmx_walk_value_clear(@ l2_cv%d)\n        if: l2_v%d = 0", left, left, code)
    if: args >= 0
        c.fprintf(f, " || l2_v%d = 0", args)
    if: data >= 0
        c.fprintf(f, " || l2_v%d = 0", data)
    if: word = 0
        c.fprintf(f, " || lmx_graph_word_text(l2_g, l2_v%d) = 0", described)
    c.fputs(" || lmx_graph_launch_value(l2_g, ", f)
    if: args >= 0
        c.fprintf(f, "(cast: (@: Lmx) l2_v%d), ", args)
    else:
        c.fputs("0, ", f)
    ---
    if: data >= 0
        c.fprintf(f, "(cast: (@: Lmx) l2_v%d), ", data)
    else:
        c.fputs("0, ", f)
    ---
    if: word != 0
        lm_graph_emit_quoted_word(f, word)
    else:
        c.fprintf(f, "lmx_graph_word_text(l2_g, l2_v%d)", described)
    ---
    c.fprintf(f, ", (cast: (@: Lmx) l2_v%d), @ l2_cv%d) != 0\n            %s\n", code, left, leave_failure)
    if: want_result = 1
        c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_result_int(l2_g, @ l2_cv%d, @ l2_t%d) != 0\n            %s\n", left, left, left, leave_failure)
    if: want_result = 2
        c.fprintf(f, "        @: void l2_v%d 0\n        if: lmx_graph_result_cell(l2_g, @ l2_cv%d, @ l2_v%d) != 0\n            %s\n", left, left, left, leave_failure)
    temp[0] := left
    return: 0
end: lm_graph_emit_fncall

# One proxy records the pending transfer and reaches either the cleanup body or its final dispatch. The word is
# the same canonical arena string used by the interpreter. A failing cleanup retains the pending error.
sub: lm_graph_emit_pending (c.FILE@: f; int: id; int: label; int: destination; char@: word; int: failed)
    c.fprintf(f, "        l2_label%d:\n", label)
    if: failed != 0
        c.fprintf(f, "        l2_pending_error%d: 1\n", id)
    if: word != 0
        c.fprintf(f, "        l2_pending_word%d: l2_pending_words%d\\w_%s\n", id, id, word)
    c.fprintf(f, "        goto: l2_label%d\n", destination)
    return
end: lm_graph_emit_pending

# Registration protects the remaining statements of this scope. All their exits pass through this cleanup;
# the cleanup itself targets a separate dispatch, so it cannot run itself again. Outer registrations still apply.
fn: lm_graph_emit_finally (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: code; c.Lmx@: body; size_t: at; size_t: to; c.Lmx@: cleanup; int: mode; int: exit_label; int: again_label; int: step_label; int@: temps) int
    c.Lmx@: cleanup_body 0
    size_t: cleanup_from 0U
    size_t: cleanup_to 0U
    int: id temps[0]
    int: saved_failure temps[1]
    int: saved_return temps[2]
    int: protected_exit -1
    int: protected_again -1
    int: protected_step -1
    int: status 0
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    char@: leave_return (cast: (char@) leave_storage\returned)
    lm_graph_emit_leave_text(leave_failure, saved_failure, 1)
    lm_graph_emit_leave_text(leave_return, saved_return, 0)
    temps[0] := id + 12
    if: exit_label >= 0
        protected_exit := id + 3
    if: again_label >= 0
        protected_again := id + 4
    if: step_label >= 0
        protected_step := id + 5
    c.fprintf(f, "        int: l2_pending_error%d 0\n        @: char l2_pending_word%d 0\n        @: LmxGraphState l2_pending_words%d lmx_graph_state()\n", id, id, id)
    temps[1] := id + 1
    temps[2] := id + 2
    status := lm_graph_emit_block(g, f, code, body, at + 1U, to, mode, protected_exit, protected_again, protected_step, temps)
    temps[1] := saved_failure
    temps[2] := saved_return
    if: status != 0
        return: status
    c.fprintf(f, "        goto: l2_label%d\n", id)
    lm_graph_emit_pending(f, id, id + 1, id, 0, 1)
    lm_graph_emit_pending(f, id, id + 2, id, "return", 0)
    if: exit_label >= 0
        lm_graph_emit_pending(f, id, id + 3, id, "break", 0)
        protected_exit := id + 8
    if: again_label >= 0
        lm_graph_emit_pending(f, id, id + 4, id, "redo", 0)
        protected_again := id + 9
    if: step_label >= 0
        lm_graph_emit_pending(f, id, id + 5, id, "continue", 0)
        protected_step := id + 10
    c.fprintf(f, "        l2_label%d:\n", id)
    temps[1] := id + 6
    temps[2] := id + 7
    c.lmx_graph_code_body(g, cleanup, 0U, @ cleanup_body, @ cleanup_from, @ cleanup_to)
    status := lm_graph_emit_block(g, f, code, cleanup_body, cleanup_from, cleanup_to, mode, protected_exit, protected_again, protected_step, temps)
    temps[1] := saved_failure
    temps[2] := saved_return
    if: status != 0
        return: status
    c.fprintf(f, "        goto: l2_label%d\n", id + 11)
    lm_graph_emit_pending(f, id, id + 6, id + 11, 0, 1)
    lm_graph_emit_pending(f, id, id + 7, id + 11, "return", 0)
    if: exit_label >= 0
        lm_graph_emit_pending(f, id, id + 8, id + 11, "break", 0)
    if: again_label >= 0
        lm_graph_emit_pending(f, id, id + 9, id + 11, "redo", 0)
    if: step_label >= 0
        lm_graph_emit_pending(f, id, id + 10, id + 11, "continue", 0)
    c.fprintf(f, "        l2_label%d:\n        if: l2_pending_error%d != 0\n            %s\n        if: l2_pending_word%d = l2_pending_words%d\\w_return\n            %s\n", id + 11, id, leave_failure, id, id, leave_return)
    if: exit_label >= 0
        c.fprintf(f, "        if: l2_pending_word%d = l2_pending_words%d\\w_break\n            goto: l2_label%d\n", id, id, exit_label)
    if: again_label >= 0
        c.fprintf(f, "        if: l2_pending_word%d = l2_pending_words%d\\w_redo\n            goto: l2_label%d\n", id, id, again_label)
    if: step_label >= 0
        c.fprintf(f, "        if: l2_pending_word%d = l2_pending_words%d\\w_continue\n            goto: l2_label%d\n", id, id, step_label)
    return: 0
end: lm_graph_emit_finally

# The field a written path `owner\field` names, emitted for a write through it as the interpreter finds it
# (lmx_graph_path_field): the owner's value, then the Structure holding the place the path's last step names -- through
# an atom too -- and its slot (lmx_graph_step_place), a place there. The temporary of that Structure in owner_out; the
# slot is l2_s<owner>. 0, 2 for no path, or the answer of the owner's emission.
fn: lm_graph_emit_field_place (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: code; @: left; int@: temps; char@@: decl_names; size_t@: decl_slots; size_t: decl_n; int@: owner_out) int
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    c.LmxGraphState@: state (cast: (c.LmxGraphState@) c.lmx_graph_state())
    c.Lmx@: path (cast: (c.Lmx@) left)
    int: owner 0
    int: status 0
    if: state = 0 || c.lmx_graph_kind(g, left) != 4 || c.lmx_graph_count(path) != 3U || c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, path, 1U)) != state\w_deref
        return: 2
    status := lm_graph_emit_received_operand(g, f, code, path, 0U, 2, -1, temps, decl_names, decl_slots, decl_n, @ owner)
    if: status != 0
        return: status
    # The Structure holding the written place and its slot, as in the interpreter: the owner, or the target of a
    # reference to it; through an atom, the record the atom refers to.
    c.fprintf(f, "        size_t: l2_s%d 0U\n        if: lmx_graph_step_place(l2_g, l2_v%d, ", owner, owner)
    c.fputs("lmx_graph_get_in(l2_g, ", f)
    status := lm_graph_emit_address(g, f, code, path)
    c.fputs(", 2U)", f)
    c.fprintf(f, ", @ l2_v%d, @ l2_s%d) != 0\n            %s\n", owner, owner, leave_failure)
    owner_out[0] := owner
    return: status
end: lm_graph_emit_field_place



# A callable's data model fixes these primitive contracts for every admitted D.
# Ordinary code, explicit paths, formals and inherited inputs keep dynamic dispatch.
fn: lm_graph_emit_model_kind (c.LmxGraph@: g; c.Lmx@: code; char@: name; int: mode) int
    c.LmxGraphState@: state (cast: (c.LmxGraphState@) c.lmx_graph_state())
    c.Lmx@: model 0
    @: value void 0
    size_t: slot 0U
    int: kind 0
    if: name = 0 || mode != 0 || c.lmx_graph_method(g, code) = 0
        return: 0
    model := c.lmx_graph_method_data(g, code)
    slot := c.lmx_graph_formal(g, model, name)
    if: slot >= c.lmx_graph_count(model)
        return: 0
    value := c.lmx_graph_get_in(g, model, slot)
    kind := c.lmx_graph_kind(g, value)
    if: kind = 3
        return: 1
    if: kind = 8 || kind = 9
        return: kind - 3
    if: kind = 1 || kind = 5 || kind = 6
        return: kind
    if: kind = 4 && c.lmx_graph_name_of(g, value) = state\w_int
        return: 1
return: 0

# Emit a checked stable destination in the live activation, before its RHS.
fn: lm_graph_emit_site (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: code; c.Lmx@: holder; size_t: index; int: place; int@: temps) int
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    int: status 0
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    c.fprintf(f, "        size_t: l2_s%d 0U\n        int: l2_k%d 0\n        if: lmx_graph_place_site(l2_g, lmx_call_code, ", place, place)
    status := lm_graph_emit_address(g, f, code, holder)
    c.fprintf(f, ", %zuU, @ l2_s%d, @ l2_k%d) != 0\n            %s\n", index, place, place, leave_failure)
    if: status = 0
        c.fprintf(f, "        int: l2_supplied%d lmx_graph_place_supplied(l2_g, lmx_call_code, ", place)
        status := lm_graph_emit_address(g, f, code, holder)
        c.fprintf(f, ", %zuU, l2_s%d)\n", index, place)
    return: status
end: lm_graph_emit_site

# Emit only the selected primitive receiving context, after its preflight.
fn: lm_graph_emit_assignment_value (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: code; c.Lmx@: statement; int: mode; int@: temps; char@@: decl_names; size_t@: decl_slots; size_t: decl_n; int: kind; int: receiving_kind; int: owner) int
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    char@: name c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, statement, 1U))
    int: value 0
    int: contract 0
    int: status 0
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    if: kind != 1
        if: kind = 6
            contract := 2
        status := lm_graph_emit_received_operand(g, f, code, statement, 2U, contract, receiving_kind, temps, decl_names, decl_slots, decl_n, @ value)
        if: status != 0
            return: status
        if: name = 0
            c.fprintf(f, "        if: lmx_graph_assign_reference(l2_g, lmx_call_code, l2_c%d, l2_v%d) != 0\n            %s\n", owner, value, leave_failure)
            return: 0
        if: mode = 0
            c.fprintf(f, "        if: lmx_graph_place_store_reference(l2_g, lmx_call_code, l2_s%d, l2_v%d) != 0\n            %s\n", owner, value, leave_failure)
            return: 0
        c.fputs("        if: lmx_graph_store_reference(l2_g, lmx_call_code, ", f)
        status := lm_graph_emit_word(g, f, code, statement, 1U)
        c.fprintf(f, ", %d, l2_v%d) != 0\n            %s\n", mode, value, leave_failure)
        return: status
    status := lm_graph_emit_number(g, f, code, statement, 2U, temps, decl_names, decl_slots, decl_n, @ value)
    if: status != 0
        return: status
    if: name = 0
        c.fprintf(f, "        if: lmx_graph_store_field(l2_g, lmx_call_code, (cast: (@: Lmx) l2_v%d), l2_s%d, l2_t%d) != 0\n            %s\n", owner, owner, value, leave_failure)
        return: 0
    if: mode = 0
        c.fprintf(f, "        if: lmx_graph_place_store_int(l2_g, lmx_call_code, l2_s%d, l2_t%d) != 0\n            %s\n", owner, value, leave_failure)
        return: 0
    c.fputs("        if: lmx_graph_store_field(l2_g, lmx_call_code, lmx_call_code, lmx_graph_visible_slot(l2_g, lmx_call_code, ", f)
    status := lm_graph_emit_word(g, f, code, statement, 1U)
    c.fprintf(f, "), l2_t%d) != 0\n            %s\n", value, leave_failure)
return: status

# Compile the same visible assignment. Preflight comes before either RHS;
# fixed model contracts emit one path, dynamic places retain both contexts.
fn: lm_graph_emit_assignment (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: code; c.Lmx@: statement; int: mode; int@: temps; char@@: decl_names; size_t@: decl_slots; size_t: decl_n) int
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    c.LmxGraphState@: state (cast: (c.LmxGraphState@) c.lmx_graph_state())
    @: left void c.lmx_graph_get_in(g, statement, 1U)
    char@: name c.lmx_graph_word_text(g, left)
    int: owner 0
    int: value 0
    int: source 0
    int: status 0
    int: place_kind 0
    int: reference_label 0
    int: end_label 0
    int: fixed_kind 0
    if: state = 0 || c.lmx_graph_count(statement) != 3U
        return: 2
    # A write through the index of a Structure, `base[index] := value` (the book, structure-index), as the interpreter
    # runs it (lmx_graph_eval_index_write): the base and the index, then the value's address, then the kernel's
    # physical slot write.
    if: name = 0 && c.lmx_graph_index_form(g, left) != 0
        status := lm_graph_emit_received_operand(g, f, code, (cast: (c.Lmx@) left), 0U, 2, -1, temps, decl_names, decl_slots, decl_n, @ owner)
        if: status != 0
            return: status
        status := lm_graph_emit_number(g, f, code, (cast: (c.Lmx@) left), 2U, temps, decl_names, decl_slots, decl_n, @ value)
        if: status != 0
            return: status
        status := lm_graph_emit_received_operand(g, f, code, statement, 2U, 2, -1, temps, decl_names, decl_slots, decl_n, @ source)
        if: status != 0
            return: status
        c.fprintf(f, "        if: lmx_graph_index_write(l2_g, lmx_call_code, l2_v%d, l2_t%d, l2_v%d) != 0\n            %s\n", owner, value, source, leave_failure)
        return: 0
    place_kind := temps[0]
    temps[0] := temps[0] + 1
    if: name != 0
        if: mode = 0
            status := lm_graph_emit_site(g, f, code, statement, 1U, place_kind, temps)
            owner := place_kind
        else:
            c.fprintf(f, "        int: l2_k%d 0\n", place_kind)
            c.fputs("        if: lmx_graph_known_place(l2_g, lmx_call_code, ", f)
            status := lm_graph_emit_word(g, f, code, statement, 1U)
            c.fprintf(f, ", %d, @ l2_k%d) != 0\n            %s\n", mode, place_kind, leave_failure)
        ---
    else:
        c.fprintf(f, "        int: l2_k%d 0\n", place_kind)
        status := lm_graph_emit_field_place(g, f, code, left, temps, decl_names, decl_slots, decl_n, @ owner)
        c.fprintf(f, "        @: void l2_c%d lmx_graph_reference_cell(l2_g, lmx_graph_get_in(l2_g, (cast: (@: Lmx) l2_v%d), l2_s%d))\n        l2_k%d: lmx_graph_kind(l2_g, l2_c%d)\n        if: lmx_graph_place_cell(l2_g, (cast: (@: Lmx) l2_v%d), l2_s%d) != 0\n            l2_k%d: 1\n        if: l2_k%d != 1 && l2_k%d != 5 && l2_k%d != 6\n            %s\n", owner, owner, owner, place_kind, owner, owner, owner, place_kind, place_kind, place_kind, place_kind, leave_failure)
    ---
    if: status != 0
        return: status
    fixed_kind := lm_graph_emit_model_kind(g, code, name, mode)
    if: fixed_kind != 0
        c.fprintf(f, "        if: l2_k%d != %d\n            %s\n", place_kind, fixed_kind, leave_failure)
        return: lm_graph_emit_assignment_value(g, f, code, statement, mode, temps, decl_names, decl_slots, decl_n, fixed_kind, -1, owner)
    reference_label := temps[0]
    end_label := reference_label + 1
    temps[0] := temps[0] + 2
    c.fprintf(f, "        if: l2_k%d != 1\n            goto: l2_label%d\n", place_kind, reference_label)
    status := lm_graph_emit_assignment_value(g, f, code, statement, mode, temps, decl_names, decl_slots, decl_n, 1, -1, owner)
    if: status != 0
        return: status
    c.fprintf(f, "        goto: l2_label%d\n        l2_label%d:\n", end_label, reference_label)
    status := lm_graph_emit_assignment_value(g, f, code, statement, mode, temps, decl_names, decl_slots, decl_n, 0, place_kind, owner)
    c.fprintf(f, "        l2_label%d:\n", end_label)
    return: status
end: lm_graph_emit_assignment


# Native method statements compute their own arithmetic/calls. The shared kernel only owns admission, working
# cells and publication. Every return/error passes through the entry wrapper's work_finish.
# Select only the lexical cursor of the current activation. Address generation
# still uses the selected launch code; no inline activation or method is made.
fn: lm_graph_emit_scope (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: code; c.Lmx@: body; int: reset; int@: temps) int
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    int: status 0
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    c.fputs("        if: lmx_graph_work_scope(l2_g, lmx_call_code, ", f)
    status := lm_graph_emit_address(g, f, code, body)
    if: status != 0
        return: status
    c.fprintf(f, ", %d) != 0\n            %s\n", reset, leave_failure)
    return: 0
end: lm_graph_emit_scope

# One declaration of a body, the field index of holder, as the interpreter reaches it (lmx_graph_block_declaration): the place is selected, checked, and
# written with what stands in the slot when the line runs. declared_holder, when not 0, is the body that holds the record of modifiers the place was declared
# by, declared_index its field: the row keeps that record (lmx_graph_place_declared), so that const and private are read from it.
fn: lm_graph_emit_declaration (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: code; c.Lmx@: holder; size_t: index; c.Lmx@: declared_holder; size_t: declared_index; int: mode; int@: temps) int
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    @: raw void c.lmx_graph_binding_leaf(g, c.lmx_graph_get_in(g, holder, index))
    char@: name 0
    int: kind c.lmx_graph_kind(g, raw)
    int: number 0
    int: contract 0
    int: result 0
    int: status 0
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    if: kind = 1 || kind = 3
        name := c.lmx_graph_slot_name(g, holder, index)
        if: name != 0 && mode = 0
            number := temps[0]
            temps[0] := temps[0] + 1
            status := lm_graph_emit_site(g, f, code, holder, index, number, temps)
            if: status != 0
                return: status
            c.fprintf(f, "        if: l2_k%d != 1\n            %s\n", number, leave_failure)
            if: declared_holder != 0
                c.fprintf(f, "        lmx_graph_place_declared(l2_g, lmx_call_code, l2_s%d, lmx_graph_get_in(l2_g, ", number)
                status := lm_graph_emit_address(g, f, code, declared_holder)
                if: status != 0
                    return: status
                c.fprintf(f, ", %zuU))\n", declared_index)
            c.fprintf(f, "        if: l2_supplied%d != 0\n            goto: l2_site_done%d\n", number, number)
            if: kind = 1
                c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_value_int(l2_g, lmx_graph_binding_leaf(l2_g, lmx_graph_get_in(l2_g, ", number)
                if: lm_graph_emit_address(g, f, code, holder) != 0
                    return: 3
                c.fprintf(f, ", %zuU)), @ l2_t%d) != 0\n            %s\n", index, number, leave_failure)
                c.fprintf(f, "        if: lmx_graph_place_store_int(l2_g, lmx_call_code, l2_s%d, l2_t%d) != 0\n            %s\n", number, number, leave_failure)
            ---
            c.fprintf(f, "        l2_site_done%d:\n", number)
        ---
        if: name != 0 && mode = 2 && kind = 1
            c.fputs("        if: lmx_graph_assign_int(l2_g, lmx_call_code, lmx_call_code, lmx_graph_visible_slot(l2_g, lmx_call_code, ", f)
            lm_graph_emit_quoted_word(f, name)
            c.fprintf(f, "), %d) != 0\n            %s\n", c.lmx_int_value_known(raw), leave_failure)
        ---
        return: status
    if: kind = 5 || kind = 6 || kind = 8 || kind = 9
        name := c.lmx_graph_slot_name(g, holder, index)
        if: name != 0
            contract := kind
            if: kind = 8 || kind = 9
                contract := kind - 3
            number := temps[0]
            temps[0] := temps[0] + 1
            if: mode = 0
                status := lm_graph_emit_site(g, f, code, holder, index, number, temps)
            else:
                c.fprintf(f, "        int: l2_k%d 0\n        if: lmx_graph_known_place(l2_g, lmx_call_code, ", number)
                lm_graph_emit_quoted_word(f, name)
                c.fprintf(f, ", %d, @ l2_k%d) != 0\n            %s\n", mode, number, leave_failure)
            if: status != 0
                return: status
            c.fprintf(f, "        if: l2_k%d != %d\n            %s\n", number, contract, leave_failure)
            if: mode = 0
                c.fprintf(f, "        if: l2_supplied%d != 0\n            goto: l2_site_done%d\n", number, number)
            if: kind = 5 || kind = 6
                status := lm_graph_emit_operand(g, f, code, holder, index, temps, 0, 0, 0U, @ result)
                if: status != 0
                    return: status
                if: mode = 0
                    c.fprintf(f, "        if: lmx_graph_place_store_reference(l2_g, lmx_call_code, l2_s%d, l2_v%d) != 0\n            %s\n", number, result, leave_failure)
                else:
                    c.fputs("        if: lmx_graph_store_reference(l2_g, lmx_call_code, ", f)
                    lm_graph_emit_quoted_word(f, name)
                    c.fprintf(f, ", %d, l2_v%d) != 0\n            %s\n", mode, result, leave_failure)
            ---
            if: mode = 0
                c.fprintf(f, "        l2_site_done%d:\n", number)
        ---
        return: status
    return: 0

fn: lm_graph_emit_block (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: code; c.Lmx@: body; size_t: from; size_t: to; int: mode; int: exit_label; int: again_label; int: step_label; int@: temps) int
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    c.LmxGraphState@: state (cast: (c.LmxGraphState@) c.lmx_graph_state())
    c.Lmx@: statement 0
    char@: head 0
    char@: name 0
    size_t: i from
    size_t: n 0U
    size_t: code_from 0U
    size_t: code_to 0U
    size_t: marked 0U
    size_t: member 0U
    size_t: member_at 0U
    char@: leave_return (cast: (char@) leave_storage\returned)
    lm_graph_emit_leave_text(leave_return, temps[2], 0)
    int: result 0
    int: status 0
    int: kind 0
    int: contract 0
    int: number 0
    int: test_label 0
    int: body_label 0
    int: next_label 0
    int: end_label 0
    int: target_label -1
    int: finish -1
    c.Lmx@: nested 0
    c.Lmx@: header 0
    @: raw void 0
    status := lm_graph_emit_scope(g, f, code, body, (cast: (int) (from = 0U && (to = c.lmx_graph_count(body) || (to = 1U && body\parent != 0 && c.lmx_graph_name_of(g, (cast: (@) body\parent)) = state\w_for && c.lmx_graph_get_in(g, (cast: (c.Lmx@) body\parent), 0U) = (cast: (@) body))))), temps)
    while: i < to && status = 0
        if: i != from
            status := lm_graph_emit_scope(g, f, code, body, 0, temps)
        if: status != 0
            return: status
        # A reached `required:` over names is the use of each name and its check, at run time, as in the interpreter (lmx_graph_block_required);
        # it comes before the modifiers over declarations, which count a written name as a declaration.
        marked := c.lmx_graph_required_names(g, c.lmx_graph_get_in(g, body, i))
        if: marked != 0U
            c.fputs("        if: lmx_graph_block_required(l2_g, lmx_call_code, lmx_graph_get_in(l2_g, ", f)
            status := lm_graph_emit_address(g, f, code, body)
            if: status != 0
                return: status
            c.fprintf(f, ", %zuU), %zuU) != 0\n            %s\n", i, marked, leave_failure)
            i := i + 1U
            continue
        # A reached record of the modifiers executes the declarations given to them as arguments, each as a reached declaration of this body
        # (the author 2026-11-18, #marking-receivers-execute), as the interpreter does (lmx_graph_block_marked).
        marked := c.lmx_graph_marked_count(g, body, i)
        if: marked != 0U
            member := 0U
            while: member < marked && status = 0
                status := c.lmx_graph_declared_at(g, body, i, member, @ nested, @ member_at)
                if: status = 0
                    status := lm_graph_emit_declaration(g, f, code, nested, member_at, body, i, mode, temps)
                member := member + 1U
            i := i + 1U
            continue
        raw := c.lmx_graph_binding_leaf(g, c.lmx_graph_get_in(g, body, i))
        kind := c.lmx_graph_kind(g, raw)
        # A declaration of an int place in a body runs at its written position (§3.2), at every reach, as in the
        # interpreter (plan M11 5a, B5, B10): a literal declaration writes into the activation's place what stands in its
        # slot when the line runs -- read from the graph then, not the value the translation saw --, a place without a
        # value is checked; in an inline body of the root the root's place is written.
        if: kind = 1 || kind = 3 || kind = 5 || kind = 6 || kind = 8 || kind = 9
            status := lm_graph_emit_declaration(g, f, code, body, i, 0, 0U, mode, temps)
            if: status != 0
                return: status
            i := i + 1U
            continue
        if: kind = 4 && c.lmx_graph_fn_result(g, raw) != 0
            i := i + 1U
            continue
        if: kind != 4
            # Raw primitive values stand; a bare word has no call arguments.
            i := i + 1U
            continue
        statement := (cast: (c.Lmx@) raw)
        n := c.lmx_graph_count(statement)
        head := c.lmx_graph_name_of(g, raw)
        if: head = 0
            if: n != 0U
                head := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, statement, 0U))
            if: c.lmx_graph_application_parts(g, raw, 0, 0, 0) != 0
                status := lm_graph_emit_application(g, f, code, statement, temps, 0, 0, 0U, 0, @ result)
                i := i + 1U
                continue
            if: head = state\w_assign
                status := lm_graph_emit_assignment(g, f, code, statement, mode, temps, 0, 0, 0U)
                i := i + 1U
                continue
            if: c.lmx_graph_written_group(g, raw) != 0
                i := i + 1U
                continue
            status := lm_graph_emit_operand(g, f, code, body, i, temps, 0, 0, 0U, @ result)
            i := i + 1U
            continue
        # Computed receiver arguments run at this line through the same binder
        # as the interpreter. Its actual holder owns the construction binding.
        if: head = state\w_fn || head = state\w_sub
            if: c.lmx_graph_fn_written(g, statement) = 0
                c.fputs("        if: lmx_graph_fn_apply(l2_g, ", f)
                status := lm_graph_emit_address(g, f, code, body)
                if: status != 0
                    return: status
                c.fprintf(f, ", %zuU) != 0\n            %s\n", i, leave_failure)
            i := i + 1U
            continue
        if: head = state\w_fm
            return: 5
        if: head = state\w_finally
            return: lm_graph_emit_finally(g, f, code, body, i, to, statement, mode, exit_label, again_label, step_label, temps)
        if: head = state\w_if
            if: n != 2U || c.lmx_graph_kind(g, c.lmx_graph_get_in(g, statement, 1U)) != 4
                return: 2
            end_label := temps[0]
            next_label := end_label + 1
            temps[0] := temps[0] + 2
            status := lm_graph_emit_number(g, f, code, statement, 0U, temps, 0, 0, 0U, @ result)
            c.fprintf(f, "        if: l2_t%d = 0\n            goto: l2_label%d\n", result, next_label)
            nested := (cast: (c.Lmx@) c.lmx_graph_get_in(g, statement, 1U))
            if: status = 0
                status := lm_graph_emit_block(g, f, code, nested, 0U, c.lmx_graph_count(nested), mode, exit_label, again_label, step_label, temps)
            c.fprintf(f, "        goto: l2_label%d\n        l2_label%d:\n", end_label, next_label)
            i := i + 1U
            if: i < to && c.lmx_graph_kind(g, c.lmx_graph_get_in(g, body, i)) = 4 && c.lmx_graph_name_of(g, c.lmx_graph_get_in(g, body, i)) = state\w_else
                statement := (cast: (c.Lmx@) c.lmx_graph_get_in(g, body, i))
                if: status = 0
                    c.lmx_graph_code_body(g, statement, 0U, @ nested, @ code_from, @ code_to)
                    status := lm_graph_emit_block(g, f, code, nested, code_from, code_to, mode, exit_label, again_label, step_label, temps)
                i := i + 1U
            ---
            c.fprintf(f, "        l2_label%d:\n", end_label)
            if: status = 0
                status := lm_graph_emit_scope(g, f, code, body, 0, temps)
            continue
        # An explicit `L2:` (the book #scope): the statements of the record are emitted here, in the same call, as the interpreter
        # runs them (lmx_graph_block_body); its names end with it.
        if: head = state\w_l2
            c.lmx_graph_code_body(g, statement, 0U, @ nested, @ code_from, @ code_to)
            status := lm_graph_emit_block(g, f, code, nested, code_from, code_to, mode, exit_label, again_label, step_label, temps)
            if: status = 0
                status := lm_graph_emit_scope(g, f, code, body, 0, temps)
            i := i + 1U
            continue
        if: head = state\w_else
            return: 2
        if: head = state\w_while || head = state\w_for || head = state\w_until
            if: n != 2U || c.lmx_graph_kind(g, c.lmx_graph_get_in(g, statement, 1U)) != 4
                return: 2
            nested := (cast: (c.Lmx@) c.lmx_graph_get_in(g, statement, 1U))
            header := (cast: (c.Lmx@) c.lmx_graph_get_in(g, statement, 0U))
            test_label := temps[0]
            body_label := test_label + 1
            next_label := test_label + 2
            end_label := test_label + 3
            temps[0] := temps[0] + 4
            if: head = state\w_for
                if: c.lmx_graph_kind(g, (cast: (@) header)) != 4 || c.lmx_graph_count(header) != 3U
                    return: 2
                status := lm_graph_emit_block(g, f, code, header, 0U, 1U, mode, exit_label, again_label, step_label, temps)
            if: head = state\w_until
                c.fprintf(f, "        goto: l2_label%d\n", body_label)
            c.fprintf(f, "        l2_label%d:\n", test_label)
            if: status = 0
                if: head = state\w_for
                    status := lm_graph_emit_scope(g, f, code, header, 0, temps)
                else:
                    status := lm_graph_emit_scope(g, f, code, body, 0, temps)
            ---
            if: status = 0
                if: head = state\w_for
                    status := lm_graph_emit_number(g, f, code, header, 1U, temps, 0, 0, 0U, @ result)
                else:
                    status := lm_graph_emit_number(g, f, code, statement, 0U, temps, 0, 0, 0U, @ result)
                ---
            ---
            if: head = state\w_until
                c.fprintf(f, "        if: l2_t%d != 0\n            goto: l2_label%d\n        l2_label%d:\n", result, end_label, body_label)
            else:
                c.fprintf(f, "        if: l2_t%d = 0\n            goto: l2_label%d\n        l2_label%d:\n", result, end_label, body_label)
            ---
            if: status = 0
                status := lm_graph_emit_block(g, f, code, nested, 0U, c.lmx_graph_count(nested), mode, end_label, body_label, next_label, temps)
            c.fprintf(f, "        l2_label%d:\n", next_label)
            if: status = 0 && head = state\w_for
                status := lm_graph_emit_block(g, f, code, header, 2U, 3U, mode, exit_label, again_label, step_label, temps)
            c.fprintf(f, "        goto: l2_label%d\n        l2_label%d:\n", test_label, end_label)
            if: status = 0
                status := lm_graph_emit_scope(g, f, code, body, 0, temps)
            i := i + 1U
            continue
        if: head = state\w_break || head = state\w_continue || head = state\w_redo
            if: n != 0U
                return: 5
            target_label := exit_label
            if: head = state\w_continue
                target_label := step_label
            if: head = state\w_redo
                target_label := again_label
            if: target_label < 0
                return: 5
            c.fprintf(f, "        goto: l2_label%d\n", target_label)
            i := i + 1U
            continue
        if: head = state\w_return
            if: n = 0U
                if: c.lmx_graph_has_result(g, code) != 0
                    c.fprintf(f, "        %s\n", leave_failure)
                else:
                    c.fprintf(f, "        %s\n", leave_return)
                ---
                return: 0
            if: c.lmx_graph_has_result(g, code) = 0
                return: 5
            if: n != 1U
                return: 5
            status := lm_graph_emit_record(g, f, code, statement, 0U, temps, 0, 0, 0U, @ result)
            c.fprintf(f, "        if: lmx_graph_result_receive(l2_g, lmx_call_code, @ l2_cv%d) != 0\n            %s\n        c.memcpy(result, @ l2_cv%d, c.sizeof(LmxWalkValue))\n        %s\n", result, leave_failure, result, leave_return)
            return: status
        if: head = state\w_call
            status := lm_graph_emit_explicit_call(g, f, code, statement, temps, 0, 0, 0U)
            i := i + 1U
            continue
        # fncall written as a statement: the launch runs and its result is not used.
        if: head = state\w_fncall
            status := lm_graph_emit_fncall(g, f, code, statement, temps, 0, 0, 0U, 0, @ result)
            i := i + 1U
            continue
        if: head = state\w_at
            if: n = 2U && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, statement, 1U)) = state\w_int
                return: 5
            kind := 6
            if: n = 3U && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, statement, 1U)) = state\w_int
                kind := 5
            if: n != 2U && kind != 5
                return: 5
            number := temps[0]
            temps[0] := temps[0] + 1
            if: mode = 0
                status := lm_graph_emit_site(g, f, code, body, i, number, temps)
            else:
                c.fprintf(f, "        int: l2_k%d 0\n        if: lmx_graph_known_place(l2_g, lmx_call_code, ", number)
                status := lm_graph_emit_word(g, f, code, statement, 0U)
                c.fprintf(f, ", %d, @ l2_k%d) != 0\n            %s\n", mode, number, leave_failure)
            c.fprintf(f, "        if: l2_k%d != %d\n            %s\n", number, kind, leave_failure)
            if: status != 0
                return: status
            if: mode = 0
                c.fprintf(f, "        if: l2_supplied%d != 0\n            goto: l2_site_done%d\n", number, number)
            contract := 0
            if: kind = 6
                contract := 2
            status := lm_graph_emit_received_operand(g, f, code, statement, n - 1U, contract, -1, temps, 0, 0, 0U, @ result)
            if: status != 0
                return: status
            if: mode = 0
                c.fprintf(f, "        if: lmx_graph_place_store_reference(l2_g, lmx_call_code, l2_s%d, l2_v%d) != 0\n            %s\n", number, result, leave_failure)
            else:
                c.fputs("        if: lmx_graph_store_reference(l2_g, lmx_call_code, ", f)
                status := lm_graph_emit_word(g, f, code, statement, 0U)
                c.fprintf(f, ", %d, l2_v%d) != 0\n            %s\n", mode, result, leave_failure)
            if: mode = 0
                c.fprintf(f, "        l2_site_done%d:\n", number)
            i := i + 1U
            continue
        if: head = state\w_include || head = state\w_predef
            i := i + 1U
            continue
        # `send: Message(...)`: the letter is built and posted by the one function the interpreter calls (lmx_graph_send).
        if: head = state\w_send
            c.fputs("        if: lmx_graph_send(l2_g, lmx_call_code, ", f)
            status := lm_graph_emit_address(g, f, code, body)
            c.fprintf(f, ", %zuU) != 0\n            %s\n", i, leave_failure)
            i := i + 1U
            continue
        if: mode != 0
            if: head = state\w_int
                c.fputs("        if: lmx_graph_visible_slot(l2_g, lmx_call_code, ", f)
                status := lm_graph_emit_word(g, f, code, statement, 0U)
                c.fprintf(f, ") = lmx_graph_count(lmx_call_code)\n            %s\n", leave_failure)
                if: n > 1U && status = 0
                    status := lm_graph_emit_expr(g, f, code, statement, 1U, n, temps, 0, 0, 0U, @ result)
                    c.fputs("        if: lmx_graph_assign_int(l2_g, lmx_call_code, lmx_call_code, lmx_graph_visible_slot(l2_g, lmx_call_code, ", f)
                    if: status = 0
                        status := lm_graph_emit_word(g, f, code, statement, 0U)
                    c.fprintf(f, "), l2_t%d) != 0\n            %s\n", result, leave_failure)
                ---
            else:
                status := lm_graph_emit_application(g, f, code, statement, temps, 0, 0, 0U, 0, @ result)
            i := i + 1U
            continue
        if: head = state\w_int
            number := temps[0]
            temps[0] := temps[0] + 1
            status := lm_graph_emit_site(g, f, code, body, i, number, temps)
            c.fprintf(f, "        if: l2_k%d != 1\n            %s\n", number, leave_failure)
            c.fprintf(f, "        if: l2_supplied%d != 0\n            goto: l2_site_done%d\n", number, number)
            if: status = 0 && n > 1U
                status := lm_graph_emit_expr(g, f, code, statement, 1U, n, temps, 0, 0, 0U, @ result)
                c.fprintf(f, "        if: lmx_graph_place_store_int(l2_g, lmx_call_code, l2_s%d, l2_t%d) != 0\n            %s\n", number, result, leave_failure)
            ---
            c.fprintf(f, "        l2_site_done%d:\n", number)
            i := i + 1U
            continue
        # Entry data and formals may shadow a lexical callable with an ordinary
        # Structure (or conversely). Select the action from the live value.
        status := lm_graph_emit_application(g, f, code, statement, temps, 0, 0, 0U, 0, @ result)
        i := i + 1U
    ---
    return: status
end: lm_graph_emit_block

# A canonical spelling as the L1 of the same canonical word when the code runs: lmx_graph_intern of its bytes, which
# answers the process's canonical address of that spelling (§4).
sub: lm_graph_emit_quoted_word (c.FILE@: f; char@: name)
    c.fputs("lmx_graph_intern(", f)
    lm_graph_emit_quoted(f, name)
    c.fprintf(f, ", %zuU)", (cast: (size_t) c.strlen(name)))
    return
end: lm_graph_emit_quoted_word

fn: lm_graph_emit_method_body (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: code; int@: temps) int
    c.Lmx@: body code
    int: status 0
    if: c.lmx_graph_method(g, code) != 0
        body := c.lmx_graph_method_code(g, code)
    status := lm_graph_emit_block(g, f, code, body, 0U, c.lmx_graph_count(body), 0, -1, -1, -1, temps)
    if: status = 0
        c.fprintf(f, "        return: %d\n", c.lmx_graph_has_result(g, code))
    return: status
end: lm_graph_emit_method_body

# The consumer collects method addresses once from the completed graph. This list belongs only to this translation,
# not to construction and not to a future execution. Emit and install reuse it without walking all children twice.
fn: lm_graph_collect_methods (c.LmxGraph@: g; c.Lmx@: root; c.Lmx@@@: methods; size_t@: methods_count) int
    c.LmxGraphState@: state (cast: (c.LmxGraphState@) c.lmx_graph_state())
    c.Lmx@@: queue 0
    size_t: count 0U
    size_t: capacity 0U
    size_t: method_capacity 0U
    size_t: at 0U
    size_t: i 0U
    c.Lmx@: current 0
    c.Lmx@: made 0
    @: value void 0
    char@: head 0
    int: status c.lmx_graph_scan_add(@ queue, @ count, @ capacity, root)
    while: at < count && status = 0
        current := queue[at]
        at := at + 1U
        head := c.lmx_graph_name_of(g, (cast: (@) current))
        if: (head = state\w_fn || head = state\w_sub) && current\parent != 0
            made := (cast: (c.Lmx@) c.lmx_graph_space_find((cast: (c.Lmx@) current\parent), c.lmx_graph_fn_decl_name(g, current)))
            if: c.lmx_graph_method(g, made) != 0 && made\parent = current
                status := c.lmx_graph_scan_add(methods, methods_count, @ method_capacity, made)
            ---
        ---
        i := 0U
        while: i < c.lmx_graph_count(current) && status = 0
            value := c.lmx_graph_get_in(g, current, i)
            if: c.lmx_graph_kind(g, value) = 4
                status := c.lmx_graph_scan_add(@ queue, @ count, @ capacity, (cast: (c.Lmx@) value))
            i := i + 1U
        ---
    ---
    c.free((cast: (@) queue))
    return: status
end: lm_graph_collect_methods

fn: lm_graph_emit_methods (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: scope; c.Lmx@@: methods; size_t: count; int: install) int
    c.Lmx@: current 0
    size_t: i 0U
    int: label 0
    c.LmxGraphEmitScratch: temp_storage
    int@: temps (cast: (int@) temp_storage\control)
    temps[0] := 0
    temps[1] := -1
    temps[2] := -1
    int: status 0
    while: i < count && status = 0
        current := methods[i]
        label := (cast: (int) i)
        if: install != 0
            # The entry goes on the declaration (the Frame of the graph): the Structure each traversal creates from it
            # takes it (lmx_graph_fn_make); the data a traversal makes runs its initializers through the interpreter.
            c.fputs("        l2_method: ", f)
            status := lm_graph_emit_address(g, f, scope, (cast: (c.Lmx@) current\parent))
            c.fprintf(f, "\n        l2_method\\native: (cast: (LmxEntry) lm_graph_method%d)\n", label)
        else:
            temps[0] := 0
            temps[1] := -1
            temps[2] := -1
            c.fprintf(f, "external:\n    fn: lm_graph_body%d (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue input; @: LmxWalkValue result) int\n        @: LmxGraph l2_g lmx_graph_find(lmx_call_arena)\n        if: l2_g = 0 || result = 0\n            return: 1\n", label)
            if: status = 0
                status := lm_graph_emit_method_body(g, f, current, temps)
            c.fprintf(f, "    end: lm_graph_body%d\nend: external\n\nexternal:\n", label)
            c.fprintf(f, "    fn: lm_graph_method%d (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue input; @: LmxWalkValue result) int\n        @: LmxGraph l2_g lmx_graph_find(lmx_call_arena)\n        LmxGraphFrame: l2_frame\n        int: l2_status 0\n        if: l2_g = 0 || result = 0\n            return: 1\n        l2_status: lmx_graph_work_open_data(l2_g, lmx_call_code, (cast: (@: Lmx) owner), @ l2_frame)\n        if: l2_status != 0\n            return: 1\n        l2_status: lm_graph_body%d(owner, refs, nargs, dest, out, lmx_call_arena, lmx_call_code, input, result)\n        l2_status: lmx_graph_work_finish(l2_g, @ l2_frame, l2_status)\n        if: l2_status != 0\n            return: l2_status\n        return: lmx_call_result_value(lmx_call_arena, lmx_call_code, result, dest, out, result)\n    end: lm_graph_method%d\nend: external\n\n", label, label, label)
        ---
        i := i + 1U
    ---
    return: status
end: lm_graph_emit_methods

# The entry of an image (step 21.6, decision R117): the function lm_graph_entry of the generated program does what
# `run` does with the entry (lm_graph_call_entry). Every segment of the path is read from the one before it as a call
# reads the head of a call (lmx_graph_application_head, the first from the code of the file); the body found is
# launched as code over its parent as data (lmx_graph_call_data); the root is not executed. The path is known when
# the image is written, so its segments stand in the generated text. A segment that is no Structure body, or not a
# member, makes the program answer 3 and say which path. Both hosts of the image call it: the root of an ordinary
# program and the adapter of emit-check. 0, or the failing answer.
fn: lm_graph_emit_entry (c.FILE@: f; const: (char@: entry)) int
    size_t: start 0U
    size_t: stop 0U
    size_t: size 0U
    size_t: k 0U
    if: f = 0 || entry = 0
        return: 5
    size := c.strlen(entry)
    if: size = 0U
        return: 5
    c.fputs("external:\n    fn: lm_graph_entry (@: LmxGraph l2_g; @: Lmx l2_file) int\n        @: Lmx l2_es l2_file\n        @: Lmx l2_ep 0\n        @: Lmx l2_ex 0\n        @: void l2_ev 0\n        int: l2_st 0\n        int: l2_op 0\n", f)
    c.fputs("        l2_st: lmx_graph_space_open(l2_g, l2_es, @ l2_op)\n        if: l2_st != 0\n            return: l2_st\n", f)
    while: start < size
        stop := start
        while: stop < size && entry[stop] != 92
            stop := stop + 1U
        ---
        c.fprintf(f, "        if: l2_st = 0\n            l2_st: lmx_graph_application_head(l2_g, l2_es, lmx_graph_intern(\"%.*s\", %zuU), 0, @ l2_ev)\n            l2_ex: (cast: (@: Lmx) l2_ev)\n", (cast: (int) (stop - start)), entry + start, stop - start)
        c.fputs("            if: l2_st = 0 && lmx_graph_method(l2_g, l2_ex) != 0\n                l2_st: 3\n", f)
        if: start > 0U
            c.fputs("            if: l2_st = 0 && l2_ex\\parent != l2_es\n                l2_st: 3\n", f)
        c.fputs("            l2_ep: l2_es\n            l2_es: l2_ex\n", f)
        start := stop + 1U
    ---
    c.fputs("        if: l2_st = 8\n            l2_st: 3\n        if: l2_st = 3\n            c.fputs(\"graph: entry ", f)
    k := 0U
    while: k < size
        if: entry[k] = 92
            c.fputs("\\\\", f)
        else:
            c.fputc((cast: (int) entry[k]), f)
        ---
        k := k + 1U
    ---
    c.fputs(" is not found or is not a Structure body\\n\", c.stderr)\n        if: l2_st = 0\n            l2_st: lmx_graph_call_data(l2_g, (cast: (@: Lmx) l2_ep), (cast: (@: Lmx) l2_es), 0)\n        lmx_graph_space_close(l2_op)\n        return: l2_st\n    end: lm_graph_entry\nend: external\n\n", f)
    return: 0
end: lm_graph_emit_entry

# The L1 of the program of root at out_path (§7): the kernel headers, the program hooks the driver expects, the body of
# the root -- native (its statements over the cells of the graph) or forced (the kernel's interpreter over the same
# graph) -- which prints the graph before and after between GRAPH markers, the generated initialization of the clean
# graph in R0's arena and root (l2_program_build), and main as the host's launch. 0, or the failing answer.
fn: lm_graph_emit_program (c.LmxGraph@: g; c.Lmx@: root; const: (char@: out_path); int: forced; int: check_root; int: runs; const: (char@: entry)) int
    c.FILE@: f 0
    @: value void 0
    # The code of the file (lmx_graph_file_code): the content of the record L2 an .lm2 file is wrapped in, else the root.
    # The image copies the whole graph from the root; the native body, the methods and the entry are the code's.
    c.Lmx@: code c.lmx_graph_file_code(g, root)
    size_t: code_id 1U
    size_t: n (cast: (size_t) c.lmx_graph_count(root))
    size_t: i 0U
    c.LmxCopyMap: emitted
    size_t: next 2U
    c.LmxGraphEmitScratch: temp_storage
    int@: temps (cast: (int@) temp_storage\control)
    temps[0] := 0
    temps[1] := -1
    temps[2] := -1
    int: r 0
    c.Lmx@@: methods 0
    size_t: methods_count 0U
    size_t: host_fields n
    if: check_root != 0
        host_fields := 1U
    int: opened 0
    char@: call_text "lmx_graph_call(g, unit)"
    if: g = 0 || root = 0 || out_path = 0 || runs < 1
        return: 5
    # The translation is a traversal of the graph: its namespace begins empty and ends with the translation.
    r := c.lmx_graph_space_open(g, code, @ opened)
    if: r != 0
        return: r
    f := c.fopen(out_path, "wb")
    if: f = 0
        c.lmx_graph_space_close(opened)
        return: 5
    c.fputs("# Generated by the graph tool of slice 309 (src/l2src/l2_graph_tool.lm2): the program of a clean graph.\n", f)
    c.fputs("predef: \"l2src/lmx_arena_refs.h.lm1\" \"l2src/lmx_value_owned.h.lm1\" \"l2src/lmx.h.lm1\" \"l2src/lmx_message.h.lm1\" \"l2src/lmx_root.h.lm1\" \"l2src/lmx_call.h.lm1\" \"l2src/lmx_clock.h.lm1\" \"l2src/lmx_ids.h.lm1\" \"l2src/lmx_arena.h.lm1\" \"l2src/lmx_graph.h.lm1\" \"l2src/lmx_graph_run.h.lm1\" \"l2src/lmx_walk_values.h.lm1\" \"l2src/lmx_source_names.h.lm1\"\n", f)
    if: check_root != 0
        c.fputs("predef: \"l2src/lmx_thread.h.lm1\"\n", f)
    c.fputs("include: \"<string.h>\"\n", f)
    c.fputs("include: \"<stdio.h>\" \"<stdlib.h>\"\n\n@: LmxArena l2_program_arena 0\n@: Lmx l2_program_unit 0\n@: Lmx l2_program_root_graph 0\n\nfn: l2_program_graph () @: Lmx\nreturn: l2_program_root_graph\n\nfn: l2_program_qualified_count () size_t\nreturn: 0U\n\nfn: l2_program_qualified_at (size_t: index) @: Lmx\nreturn: 0\n\n", f)
    # Declare each native temporary where its first value is emitted. The emitter needs no temporary file or second
    # copy of the body; its traversal-local counter only supplies distinct L1 names.
    if: forced = 0
        r := lm_graph_collect_methods(g, code, @ methods, @ methods_count)
        if: r = 0
            r := lm_graph_emit_methods(g, f, code, methods, methods_count, 0)
        if: r != 0
            c.fclose(f)
            c.free((cast: (@) methods))
            c.lmx_graph_space_close(opened)
            return: r
        ---
    ---
    if: entry != 0
        call_text := "lm_graph_entry(g, lmx_graph_file_code(g, unit))"
        r := lm_graph_emit_entry(f, entry)
    if: r != 0
        c.fclose(f)
        c.free((cast: (@) methods))
        c.lmx_graph_space_close(opened)
        return: r
    c.fputs("external:\n    fn: lm_graph_root (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n        @: LmxGraph l2_g 0\n        @: void l2_c 0\n        l2_g: lmx_graph_find(lmx_call_arena)\n", f)
    c.fputs("        if: l2_g = 0 || lmx_call_code = 0\n            return: 1\n", f)
    if: check_root = 0
        c.fputs("        if: lmx_graph_dump_marked(l2_g, lmx_call_code, c.stdout, \"BEFORE\") != 0\n            return: 1\n", f)
    if: entry != 0
        c.fputs("        if: lm_graph_entry(l2_g, lmx_call_code) != 0\n            return: 1\n", f)
    else:
        if: forced = 0
            r := lm_graph_emit_block(g, f, code, code, 0U, c.lmx_graph_count(code), 0, -1, -1, -1, temps)
            if: r != 0
                c.fclose(f)
                c.free((cast: (@) methods))
                c.lmx_graph_space_close(opened)
                return: r
            ---
        else:
            c.fputs("        if: lmx_graph_run(l2_g, lmx_call_code) != 0\n            return: 1\n", f)
        ---
    ---
    c.fputs("        return: 0\n    end: lm_graph_root\nend: external\n\n", f)
    # The root's entry: the run of the program is a traversal with its own namespace (lmx_graph_space_open), shared
    # when it is entered inside a live one. R0's frame has no data (the book #root-entry).
    c.fputs("external:\n    fn: lm_graph_body (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n        @: LmxGraph l2_g lmx_graph_find(lmx_call_arena)\n        LmxGraphFrame: l2_frame\n        int: l2_opened 0\n        int: l2_status 0\n        if: l2_g = 0 || lmx_call_code = 0\n            return: 1\n        if: lmx_graph_space_open(l2_g, lmx_call_code, @ l2_opened) != 0\n            return: 1\n        l2_status: lmx_graph_work_open_data(l2_g, lmx_call_code, 0, @ l2_frame)\n        if: l2_status != 0\n            lmx_graph_space_close(l2_opened)\n            return: 1\n        l2_status: lm_graph_root(owner, refs, nargs, dest, out, lmx_call_arena, lmx_call_code, lmx_input_values, lmx_result_context)\n        l2_status: lmx_graph_work_finish(l2_g, @ l2_frame, l2_status)\n", f)
    if: check_root = 0
        c.fputs("        if: l2_status = 0\n            if: lmx_graph_dump_marked(l2_g, lmx_call_code, c.stdout, \"AFTER\") != 0\n                l2_status: 1\n            ---\n        ---\n", f)
    c.fputs("        lmx_graph_space_close(l2_opened)\n        return: l2_status\n    end: lm_graph_body\nend: external\n\n", f)
    if: code != root && check_root = 0
        c.fputs("external:\n    fn: lm_graph_file (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n        @: LmxGraph l2_g lmx_graph_find(lmx_call_arena)\n        if: l2_g = 0 || lmx_call_code = 0\n            return: 1\n        return: lmx_graph_call(l2_g, lmx_call_code)\n    end: lm_graph_file\nend: external\n\n", f)
    # Only emit-check supplies a test host. The body keeps the language rule: returning 0 is NOT Message success.
    # Like the `run` command's host, this separate adapter completes its own test after a successful body. Ordinary
    # `emit` gets no adapter and still fails R0 when the source supplies neither success nor an exit Message.
    if: check_root != 0
        c.fprintf(f, "external:\n    fn: lm_graph_check_root (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena arena; @: Lmx code; @: LmxWalkValue input; @: LmxWalkValue result) int\n        @: LmxGraph g lmx_graph_find(arena)\n        @: Lmx unit (cast: (@: Lmx) lmx_graph_get_in(g, code, 0U))\n        int: status 0\n        int: count 0\n        if: g = 0 || unit = 0 || lmx_graph_dump_marked(g, unit, c.stdout, \"BEFORE\") != 0\n            return: 1\n        while: count < %d && status = 0\n            status: %s\n            count: count + 1\n        ---\n        if: lmx_graph_dump_marked(g, unit, c.stdout, \"AFTER\") != 0\n            return: 1\n        if: status != 0\n            return: status\n        @: LmxThread thread lmx_thread_current()\n        @: LmxMsg message lmx_thread_message(thread)\n        if: message = 0\n            return: 1\n        message\\success: (cast: (LmxFlag) 1)\n        return: 0\n    end: lm_graph_check_root\nend: external\n\n", runs, call_text)
    # Ordinary emission builds the program in R0. A private emit-check host owns a separate program root, so clearing
    # the program's native entry cannot erase the adapter or change the program's lexical parent.
    c.fputs("external:\n    fn: l2_program_build (@: LmxArena arena; @: Lmx graph; @: Lmx settings) int\n        @: LmxGraph l2_g 0\n        @: void l2_c 0\n        @: Lmx lmx_call_code 0\n        @: Lmx l2_method 0\n", f)
    c.fputs("        l2_g: lmx_graph_open(arena)\n        if: l2_g = 0 || graph = 0\n            return: 1\n        l2_program_arena: arena\n        l2_program_root_graph: graph\n        l2_program_unit: graph\n", f)
    if: check_root != 0
        c.fprintf(f, "        l2_program_unit: lmx_graph_lmx(l2_g, 0, %zuU)\n        if: l2_program_unit = 0 || lmx_graph_put_in(l2_g, graph, 0U, (cast: (@: void) l2_program_unit)) != 0\n            return: 1\n", n)
    c.fputs("        @: void l2_gv1 (cast: (@: void) l2_program_unit)\n", f)
    r := c.lmx_copy_map_init(@ emitted)
    if: r = 0
        r := c.lmx_copy_map_put(@ emitted, (cast: (@) root), (cast: (@) 1U))
    while: i < n && r = 0
        value := c.lmx_graph_get_in(g, root, i)
        r := lm_graph_emit_value(g, f, root, value, "l2_program_unit", i, @ emitted, @ next)
        i := i + 1U
    ---
    if: r = 0
        r := lm_graph_emit_parents(g, f, @ emitted, next)
    if: code != root
        code_id := (cast: (size_t) c.lmx_copy_map_get(@ emitted, (cast: (@) code)))
    c.lmx_copy_map_dispose(@ emitted)
    if: r != 0
        c.fclose(f)
        c.free((cast: (@) methods))
        c.lmx_graph_space_close(opened)
        return: 5
    ---
    if: forced = 0
        if: code_id = 1U
            c.fputs("        lmx_call_code: l2_program_unit\n", f)
        else:
            c.fprintf(f, "        lmx_call_code: (cast: (@: Lmx) l2_gv%zu)\n", code_id)
        r := lm_graph_emit_methods(g, f, code, methods, methods_count, 1)
        if: r != 0
            c.fclose(f)
            c.free((cast: (@) methods))
            c.lmx_graph_space_close(opened)
            return: r
        ---
    ---
    # The entry of the code: the root's, or the record's when the file is wrapped in the record L2; a host that launches
    # the root of an ordinary program enters it through lm_graph_file, which calls the file (lmx_graph_call passes
    # through the record to the record's entry).
    if: code_id = 1U
        c.fputs("        l2_program_unit\\native: (cast: (LmxEntry) lm_graph_body)\n", f)
    else:
        c.fprintf(f, "        lmx_call_code: (cast: (@: Lmx) l2_gv%zu)\n        lmx_call_code\\native: (cast: (LmxEntry) lm_graph_body)\n", code_id)
        if: check_root = 0
            c.fputs("        l2_program_unit\\native: (cast: (LmxEntry) lm_graph_file)\n", f)
    ---
    if: check_root != 0
        c.fputs("        graph\\native: (cast: (LmxEntry) lm_graph_check_root)\n", f)
    c.fputs("        return: 0\n    end: l2_program_build\nend: external\n\n", f)
    c.fprintf(f, "external:\n    fn: main (int: argc; @@: char argv) int\n        LmxRoot: l2_program_root\n        return: lmx_root_launch(@ l2_program_root, argc, argv, l2_program_build, %zuU, lmx_root_settings, 5000U, (cast: (@: void) c.stdout), (cast: (@: void) c.stderr))\n    end: main\nend: external\n", host_fields)
    c.free((cast: (@) methods))
    c.lmx_graph_space_close(opened)
    if: c.fclose(f) != 0
        return: 5
    return: 0
end: lm_graph_emit_program

# ---- The command line of tools/graph_trans.lm2 ---------------------------------------------------------------------

# Is text a count -- digits only, not empty? The last argument of a command that is not one is its ENTRY.
fn: lm_graph_is_count (const: (char@: text)) int
    size_t: i 0U
    if: text = 0 || text[0] = 0
        return: 0
    while: text[i] != 0
        if: text[i] < 48 || text[i] > 57
            return: 0
        i := i + 1U
    ---
    return: 1

# SOURCES of a command: one path, or several joined by `;`. Several are built into ONE fresh root as a description, in
# the order written: their texts are joined, each ended by a blank line (a full boundary of the block, step 21.3), and
# parsed once; a diagnostic of the parser shows as PATH:LINE:COLUMN of the source it falls in. Nothing is executed.
# Sources of both levels (.lm2 and others) are not built into one root: answer 2.
fn: lm_graph_build_sources (c.LmxGraph@: g; const: (char@: paths); c.Lmx@@: out) int
    char@: copy 0
    char@: joined 0
    char@@: names 0
    char@@: texts 0
    size_t@: sizes 0
    size_t@: firsts 0
    c.LmP0Document@: doc 0
    c.LmP0Diagnostic@: diag 0
    size_t: n 1U
    size_t: i 0U
    size_t: k 0U
    size_t: total 0U
    size_t: used 0U
    size_t: line 1U
    size_t: len 0U
    int: level2 0
    int: other 0
    int: r 0
    if: paths = 0 || out = 0
        return: 2
    if: c.strchr(paths, 59) = 0
        return: lm_graph_build_file(g, paths, out)
    copy := (cast: (char@) c.malloc(c.strlen(paths) + 1U))
    if: copy = 0
        return: 1
    c.strcpy(copy, paths)
    while: copy[i] != 0
        n := n + (cast: (size_t) (copy[i] = 59))
        i := i + 1U
    ---
    names := (cast: (char@@) c.calloc(n, sizeof(char@)))
    texts := (cast: (char@@) c.calloc(n, sizeof(char@)))
    sizes := (cast: (size_t@) c.calloc(n, sizeof(size_t)))
    firsts := (cast: (size_t@) c.calloc(n, sizeof(size_t)))
    if: names = 0 || texts = 0 || sizes = 0 || firsts = 0
        r := 1
    if: r = 0
        names[0] := copy
        i := 0U
        k := 1U
        while: copy[i] != 0
            if: copy[i] = 59
                copy[i] := (cast: (char) 0)
                names[k] := copy + (i + 1U)
                k := k + 1U
            i := i + 1U
        ---
        i := 0U
        while: i < n && r = 0
            len := c.strlen(names[i])
            if: len >= 4U && c.strcmp(names[i] + (len - 4U), ".lm2") = 0
                level2 := 1
            else:
                other := 1
            ---
            texts[i] := lm_graph_groups_read(names[i], @ sizes[i])
            if: texts[i] = 0
                c.fprintf(c.stderr, "graph: %s: cannot read or parse\n", names[i])
                r := 2
            total := total + sizes[i]
            i := i + 1U
        ---
    if: r = 0 && level2 != 0 && other != 0
        c.fputs("graph: sources of both levels (.lm2 and others) are not built into one root\n", c.stderr)
        r := 2
    if: r = 0
        joined := (cast: (char@) c.malloc(total + (2U * n) + 1U))
        if: joined = 0
            r := 1
        ---
    if: r = 0
        i := 0U
        while: i < n
            firsts[i] := line
            c.memcpy(joined + used, texts[i], sizes[i])
            used := used + sizes[i]
            k := 0U
            while: k < sizes[i]
                line := line + (cast: (size_t) (texts[i][k] = 10))
                k := k + 1U
            ---
            if: sizes[i] = 0U || texts[i][sizes[i] - 1U] != 10
                joined[used] := (cast: (char) 10)
                used := used + 1U
                line := line + 1U
            joined[used] := (cast: (char) 10)
            used := used + 1U
            line := line + 1U
            i := i + 1U
        ---
        joined[used] := (cast: (char) 0)
        if: c.lm_p0_parse_bytes(joined, used, @ doc) != 0
            r := 2
            if: doc != 0
                diag := (cast: (c.LmP0Diagnostic@) c.lm_p0_document_diagnostic(doc))
            if: diag != 0
                i := n - 1U
                while: i > 0U && firsts[i] > diag\line
                    i := i - 1U
                ---
                c.fprintf(c.stderr, "graph: %s:%zu:%zu: %s\n", names[i], (cast: (size_t) (diag\line)) - firsts[i] + 1U, (cast: (size_t) (diag\column)), (cast: (char@) (diag\message)))
            else:
                c.fputs("graph: the sources cannot be read or parsed\n", c.stderr)
            ---
        else:
            r := lm_graph_build_root(g, doc, level2, out)
        ---
    if: doc != 0
        c.lm_p0_document_destroy(doc)
    i := 0U
    while: texts != 0 && i < n
        c.free((cast: (@) texts[i]))
        i := i + 1U
    ---
    c.free((cast: (@) texts))
    c.free((cast: (@) names))
    c.free((cast: (@) sizes))
    c.free((cast: (@) firsts))
    c.free((cast: (@) joined))
    c.free((cast: (@) copy))
    return: r

# ENTRY of a command: the path of a body (`Case\run`). Every segment is read from the one before it as a call reads the
# head of a call (lmx_graph_application_head: a written declaration is loaded, the first segment is looked up from the
# code of the file). A segment after the first must be a member of the Structure before it (its parent is that
# Structure): the lookup of the head goes outward, a path does not. The body is a Structure, launched as code over its
# parent as data (lmx_graph_call_data) -- the structural call of the edition: the DATA of an executable Structure C is
# parent(C) (CORE.md 3.1, L2_L3_CODING_INSTRUCTION.md 4). A callable (fn, sub) is no entry: it has its own data and its
# own way of call, and a call of it is written in the body of the case. The root is not executed. A segment that is no
# Structure body, or not a member, answers 3 and says which path; any other answer of the kernel is the answer.
fn: lm_graph_call_entry (c.LmxGraph@: g; c.Lmx@: file; const: (char@: entry)) int
    c.Lmx@: scope c.lmx_graph_file_code(g, file)
    c.Lmx@: parent 0
    @: target void 0
    c.Lmx@: probe 0
    size_t: start 0U
    size_t: stop 0U
    size_t: size 0U
    int: opened 0
    int: status 0
    int: first 1
    if: entry = 0 || scope = 0
        return: 5
    size := c.strlen(entry)
    if: size = 0U
        return: 5
    status := c.lmx_graph_space_open(g, scope, @ opened)
    if: status != 0
        return: status
    parent := scope
    while: start < size && status = 0
        stop := start
        while: stop < size && entry[stop] != 92
            stop := stop + 1U
        ---
        status := c.lmx_graph_application_head(g, scope, c.lmx_graph_intern(entry + start, stop - start), 0, @ target)
        probe := (cast: (c.Lmx@) target)
        if: status = 0 && c.lmx_graph_method(g, probe) != 0
            status := 3
        if: status = 0 && first = 0 && probe\parent != scope
            status := 3
        if: status = 8
            status := 3
        if: status = 3
            c.fprintf(c.stderr, "graph: entry %s is not found or is not a Structure body\n", entry)
        if: status = 0
            parent := scope
            scope := probe
            first := 0
        start := stop + 1U
    ---
    if: status = 0
        status := c.lmx_graph_call_data(g, parent, scope, 0)
    c.lmx_graph_space_close(opened)
    return: status

# `run FILE`: the clean graph of FILE in a fresh arena, printed before and after the kernel's interpreter ran it
# (GRAPH-BEFORE / GRAPH-AFTER markers). 0, or the interpreter's answer (printed).
fn: lm_graph_run_file (const: (char@: path); int: runs; const: (char@: entry)) int
    c.LmxArena@: arena (cast: (c.LmxArena@) c.calloc(1U, c.sizeof(c.LmxArena)))
    c.LmxGraph@: g 0
    c.Lmx@: root 0
    int: r 0
    int: count 0
    if: arena = 0
        return: 1
    if: c.lmx_arena_open(arena) != 0
        c.fputs("graph: cannot open an arena\n", c.stderr)
        return: 1
    g := c.lmx_graph_open(arena)
    if: g = 0
        return: 1
    r := lm_graph_build_sources(g, path, @ root)
    if: r != 0
        c.fprintf(c.stderr, "graph: build answered %d\n", r)
        return: r
    if: c.lmx_graph_dump_marked(g, root, c.stdout, "BEFORE") != 0
        c.fputs("graph: the graph does not print\n", c.stderr)
        return: 1
    while: count < runs && r = 0
        if: entry = 0
            r := c.lmx_graph_call(g, root)
        else:
            r := lm_graph_call_entry(g, root, entry)
        ---
        count := count + 1
    ---
    if: r != 0
        c.fprintf(c.stderr, "graph: run answered %d\n", r)
    if: c.lmx_graph_dump_marked(g, root, c.stdout, "AFTER") != 0
        c.fputs("graph: the graph does not print\n", c.stderr)
        return: 1
    c.lmx_graph_close(g)
    c.lmx_arena_release(arena)
    c.free((cast: (@) arena))
    return: r
end: lm_graph_run_file

# `emit FILE OUT.lm1 native|forced`: the clean graph of FILE emitted as the L1 of a program (lm_graph_emit_program).
fn: lm_graph_emit_file (const: (char@: path); const: (char@: out_path); int: forced; int: check_root; int: runs; const: (char@: entry)) int
    c.LmxArena@: arena (cast: (c.LmxArena@) c.calloc(1U, c.sizeof(c.LmxArena)))
    c.LmxGraph@: g 0
    c.Lmx@: root 0
    int: r 0
    if: arena = 0
        return: 1
    if: c.lmx_arena_open(arena) != 0
        c.fputs("graph: cannot open an arena\n", c.stderr)
        return: 1
    g := c.lmx_graph_open(arena)
    if: g = 0
        return: 1
    r := lm_graph_build_sources(g, path, @ root)
    if: r != 0
        c.fprintf(c.stderr, "graph: build answered %d\n", r)
        return: r
    r := lm_graph_emit_program(g, root, out_path, forced, check_root, runs, entry)
    if: r != 0
        c.fprintf(c.stderr, "graph: emit answered %d\n", r)
    c.lmx_graph_close(g)
    c.lmx_arena_release(arena)
    c.free((cast: (@) arena))
    return: r
end: lm_graph_emit_file

# `p0 FILE`: the P0 tree of FILE as the parser dumps it (the builder's input, for the record of a slice).  A file that
# does not parse prints the parser's diagnostic -- its number, line and column, as the P0 tests record them
# (tests/parser: `P0 parse error N at L:C`) -- and answers 2.
fn: lm_graph_p0_open (const: (char@: path); c.LmP0Document@@: out_document) int
    c.LmP0Document@: doc 0
    c.LmP0Diagnostic@: diag 0
    out_document[0] := 0
    if: c.lm_p0_parse_file(path, @ doc) != 0
        if: doc != 0
            diag := (cast: (c.LmP0Diagnostic@) c.lm_p0_document_diagnostic(doc))
        ---
        if: diag != 0
            c.fprintf(c.stderr, "P0 parse error %d at %zu:%zu: %s\n", (cast: (int) (diag\code)), (cast: (size_t) (diag\line)), (cast: (size_t) (diag\column)), (cast: (char@) (diag\message)))
        else:
            c.fprintf(c.stderr, "graph: %s: cannot read or parse\n", path)
        ---
        if: doc != 0
            c.lm_p0_document_destroy(doc)
        return: 2
    out_document[0] := doc
return: 0

# ---- `p0 FILE [lower-types] [flags|nodes]`: the tree with what the ordinary print hides ------------------------------------
# The ordinary print shows a node's kind, its text and its field count, and a few of its flags as words before the kind.
# `flags` adds to every line of that print, after the text ` ##`, the flags of the node in [] and the flags of its Frame or
# trailer in {}; `nodes` adds the position of the node before them: its offset and length in bytes and its line and column
# (`@12+4 3:5`). Everything before ` ##` is the ordinary line byte for byte, so a case of the parser suite can pin a flag
# the ordinary print cannot show (the separator after a field, the colon of a Frame, the mark of a postfix) and a position.

# The name of one flag of a node (table 0), of a Frame (1) or of a trailer (2); the bit is 2 to the power index. 0 when the
# table has no flag at that bit.
fn: lm_graph_flag_name (int: flagset; int: index) const: char@
    if: flagset = 0
        if: index = 0
            return: "INACTIVE"
        if: index = 1
            return: "MIX"
        if: index = 2
            return: "SKIP"
        if: index = 3
            return: "SEP"
        if: index = 4
            return: "DOCUMENT"
        if: index = 5
            return: "STRMARK"
        if: index = 6
            return: "SQUARE"
        if: index = 7
            return: "POSTFIX"
        ---
    if: flagset = 1
        if: index = 0
            return: "COLON"
        if: index = 1
            return: "COMPACT"
        if: index = 2
            return: "INLINE"
        if: index = 3
            return: "SEPCLOSED"
        if: index = 4
            return: "DELIMCLOSED"
        if: index = 5
            return: "ASSIGN"
        if: index = 6
            return: "SOLE"
        ---
    if: flagset = 2
        if: index = 0
            return: "CUTTER"
        if: index = 1
            return: "COLON"
        if: index = 2
            return: "DELIMCLOSED"
        if: index = 3
            return: "SOLE"
        ---
    return: 0

# ` [A B]` or ` {A B}`: the names of the set bits, an unknown bit as `?` and its value; nothing when no bit is set.
sub: lm_graph_flags_text (c.FILE@: out; unsigned: flags; int: flagset; int: open; int: close)
    unsigned: bit 1U
    int: index 0
    int: first 1
    char@: name 0
    if: flags = 0U
        return
    c.fputc(32, out)
    c.fputc(open, out)
    while: index < 32
        if: (flags & bit) != 0U
            if: first = 0
                c.fputc(32, out)
            name := (cast: (char@) lm_graph_flag_name(flagset, index))
            if: name != 0
                c.fputs(name, out)
            else:
                c.fprintf(out, "?%u", bit)
            ---
            first := 0
        bit := bit * 2U
        index := index + 1
    ---
    c.fputc(close, out)
return

# The tail of a line of the print: ` ##` and, by mode, the position and the flags. mode 1 is `flags`, 2 is `nodes`.
sub: lm_graph_nodes_tail (c.FILE@: out; c.LmP0Node@: item; unsigned: own; int: flagset; int: mode)
    c.fputs(" ##", out)
    if: mode = 2 && item != 0
        c.fprintf(out, " @%zu+%zu %zu:%zu", (cast: (size_t) item\span\offset), (cast: (size_t) item\span\length), (cast: (size_t) item\span\line), (cast: (size_t) item\span\column))
    if: item != 0
        lm_graph_flags_text(out, (cast: (unsigned) item\flags), 0, 91, 93)
    lm_graph_flags_text(out, own, flagset, 123, 125)
    c.fputc(10, out)
return

sub: lm_graph_nodes_indent (c.FILE@: out; size_t: indent)
    size_t: i 0U
    while: i < indent
        c.fputs("  ", out)
        i := i + 1U
    ---
return

sub: lm_graph_nodes_text (c.FILE@: out; c.LmP0Text@: text)
    c.fputc(34, out)
    if: text != 0
        c.fwrite((cast: (@) text\data), 1U, (cast: (size_t) text\length), out)
    c.fputc(34, out)
return

# The words the ordinary print puts before the kind of a node.
sub: lm_graph_nodes_prefix (c.FILE@: out; c.LmP0Node@: item)
    if: (item\flags & c.LM_P0_NODE_INACTIVE) != 0U
        c.fputs("Inactive ", out)
    if: (item\flags & c.LM_P0_NODE_MIX) != 0U
        c.fputs("MIX ", out)
        if: (item\flags & c.LM_P0_NODE_STRING_MARK) != 0U
            c.fprintf(out, "at %zu ", (cast: (size_t) item\atom_char))
        ---
    if: (item\flags & c.LM_P0_NODE_POSITIONAL_SKIP) != 0U
        c.fputs("PositionalSkip ", out)
    if: (item\flags & c.LM_P0_NODE_SQUARE) != 0U
        c.fputs("Square ", out)
    if: (item\flags & c.LM_P0_NODE_POSTFIX) != 0U
        c.fputs("Postfix ", out)
    ---
return

sub: lm_graph_nodes_structure (c.FILE@: out; c.LmP0Structure@: structure; size_t: indent; int: mode)
    c.LmP0Field@: field 0
    if: structure != 0
        field := (cast: (c.LmP0Field@) structure\first_field)
    while: field != 0
        lm_graph_nodes_node(out, (cast: (c.LmP0Node@) field\value), indent, mode)
        field := (cast: (c.LmP0Field@) field\next)
    ---
return

sub: lm_graph_nodes_trailer (c.FILE@: out; c.LmP0Trailer@: trailer; size_t: indent; int: mode)
    if: trailer = 0
        return
    lm_graph_nodes_indent(out, indent)
    if: (trailer\flags & c.LM_P0_TRAILER_TAIL_CUTTER) != 0U
        c.fputs("Tail cutter trailer spelling=", out)
    else:
        c.fputs("Trailer spelling=", out)
    ---
    lm_graph_nodes_text(out, (cast: (c.LmP0Text@) trailer\spelling))
    c.fprintf(out, " fields=%zu", (cast: (size_t) trailer\body\field_count))
    lm_graph_nodes_tail(out, 0, (cast: (unsigned) trailer\flags), 2, mode)
    lm_graph_nodes_structure(out, (cast: (c.LmP0Structure@) trailer\body), indent + 1U, mode)
return

# One node, its fields and its trailer, in the order of the ordinary print: the line, the fields, the trailer.
sub: lm_graph_nodes_node (c.FILE@: out; c.LmP0Node@: item; size_t: indent; int: mode)
    c.LmP0Frame@: frame 0
    c.LmP0Structure@: structure 0
    if: item = 0
        return
    lm_graph_nodes_indent(out, indent)
    lm_graph_nodes_prefix(out, item)
    if: item\kind = c.LM_P0_NODE_STRUCTURE
        structure := (cast: (c.LmP0Structure@) item\as\structure)
        c.fprintf(out, "%s fields=%zu", c.lm_p0_node_kind_class_name((cast: (c.LmP0NodeKind) item\kind)), (cast: (size_t) structure\field_count))
        lm_graph_nodes_tail(out, item, 0U, 0, mode)
        lm_graph_nodes_structure(out, structure, indent + 1U, mode)
        lm_graph_nodes_trailer(out, (cast: (c.LmP0Trailer@) structure\trailer), indent + 1U, mode)
        return
    if: item\kind = c.LM_P0_NODE_FRAME
        frame := (cast: (c.LmP0Frame@) item\as\frame)
        c.fprintf(out, "%s head=", c.lm_p0_node_kind_class_name((cast: (c.LmP0NodeKind) item\kind)))
        lm_graph_nodes_text(out, (cast: (c.LmP0Text@) frame\head))
        c.fprintf(out, " body=%s fields=%zu", c.lm_p0_node_kind_class_name(c.LM_P0_NODE_STRUCTURE), (cast: (size_t) frame\body\field_count))
        lm_graph_nodes_tail(out, item, (cast: (unsigned) frame\flags), 1, mode)
        lm_graph_nodes_structure(out, (cast: (c.LmP0Structure@) frame\body), indent + 1U, mode)
        lm_graph_nodes_trailer(out, (cast: (c.LmP0Trailer@) frame\trailer), indent + 1U, mode)
        return
    if: item\kind = c.LM_P0_NODE_ATOM || item\kind = c.LM_P0_NODE_DISABLED
        c.fprintf(out, "%s ", c.lm_p0_node_kind_class_name((cast: (c.LmP0NodeKind) item\kind)))
        lm_graph_nodes_text(out, (cast: (c.LmP0Text@) item\as\atom))
        lm_graph_nodes_tail(out, item, 0U, 0, mode)
        if: item\kind = c.LM_P0_NODE_ATOM
            lm_graph_nodes_structure(out, (cast: (c.LmP0Structure@) item\marks), indent + 1U, mode)
        return
    c.fprintf(out, "%s kind=%zu", c.lm_p0_node_kind_class_name((cast: (c.LmP0NodeKind) item\kind)), (cast: (size_t) item\kind))
    lm_graph_nodes_tail(out, item, 0U, 0, mode)
return

# `p0 FILE [lower-types] [flags|nodes]`: the tree of a file, read by P0 (and, with lower-types, lowered by the pass of
# the typed notation). Without flags and nodes the print is the parser's own, byte for byte.
fn: lm_graph_p0_file (const: (char@: path); int: lowered; int: mode) int
    c.LmP0Document@: doc 0
    char@: dump 0
    c.LmP0Diagnostic@: diag 0
    if: lm_graph_p0_open(path, @ doc) != 0
        return: 2
    if: lowered != 0 && c.lm_p0_lower_types(doc) != 0
        diag := (cast: (c.LmP0Diagnostic@) c.lm_p0_document_diagnostic(doc))
        if: diag != 0
            c.fprintf(c.stderr, "P0 parse error %d at %zu:%zu: %s\n", (cast: (int) (diag\code)), (cast: (size_t) (diag\line)), (cast: (size_t) (diag\column)), (cast: (char@) (diag\message)))
        c.lm_p0_document_destroy(doc)
        return: 2
    if: mode != 0
        lm_graph_nodes_node(c.stdout, (cast: (c.LmP0Node@) c.lm_p0_document_root(doc)), 0U, mode)
        c.lm_p0_document_destroy(doc)
        return: 0
    dump := c.lm_p0_dump_alloc(doc)
    if: dump != 0
        c.fputs(dump, c.stdout)
        c.lm_p0_free((cast: (@) dump))
    ---
    c.lm_p0_document_destroy(doc)
return: 0

# The words after the file of the p0 command: lower-types, flags and nodes, each at most once and in any order; anything
# else is a usage error (2).
fn: lm_graph_p0_command (char@@: args; int: n) int
    int: lowered 0
    int: mode 0
    int: i 3
    while: i < n
        if: c.strcmp(args[i], "lower-types") = 0
            lowered := 1
        if: c.strcmp(args[i], "flags") = 0
            mode := 1
        if: c.strcmp(args[i], "nodes") = 0
            mode := 2
        if: c.strcmp(args[i], "lower-types") != 0 && c.strcmp(args[i], "flags") != 0 && c.strcmp(args[i], "nodes") != 0
            c.fputs("graph_trans: p0 takes FILE [lower-types] [flags|nodes]\n", c.stderr)
            return: 2
        i := i + 1
    ---
    return: lm_graph_p0_file(args[2], lowered, mode)

# M8 observes a written sole anonymous group without changing its boundary or
# guessing its head's semantic role. Mix payload is counted separately.
fn: lm_graph_groups_sole (c.LmP0Structure@: body) int
    c.LmP0Field@: only 0
    c.LmP0Node@: item 0
    if: body = 0 || body\field_count != 1U
        return: 0
    only := (cast: (c.LmP0Field@) body\first_field)
    if: only = 0 || only\value = 0
        return: 0
    item := (cast: (c.LmP0Node@) only\value)
    if: item\kind != c.LM_P0_NODE_STRUCTURE || item\as = 0 || item\as\structure = 0 || (item\flags & (c.LM_P0_NODE_INACTIVE | c.LM_P0_NODE_MIX | c.LM_P0_NODE_POSITIONAL_SKIP)) != 0U
        return: 0
return: (cast: (int) (item\as\structure\trailer = 0))

sub: lm_graph_groups_row (c.FILE@: out; char@: path; char@: kind; int: metadata; c.LmP0Node@: owner; c.LmP0Text@: head; unsigned: flags; size_t@: count)
    c.fprintf(out, "%s\t%s\t%d\t%zu\t%zu\t%zu\t%u\t", path, kind, metadata, (cast: (size_t) owner\span\offset), (cast: (size_t) owner\span\line), (cast: (size_t) owner\span\column), flags)
    lm_graph_emit_quoted_bytes(out, (cast: (char@) head\data), (cast: (size_t) head\length), 1)
    c.fputc(10, out)
    count[0] := count[0] + 1U
return

sub: lm_graph_groups_trailer (c.FILE@: out; char@: path; c.LmP0Node@: owner; c.LmP0Trailer@: tail; int: metadata; size_t@: count)
    if: tail = 0
        return
    if: lm_graph_groups_sole((cast: (c.LmP0Structure@) tail\body)) != 0
        lm_graph_groups_row(out, path, "trailer", metadata, owner, (cast: (c.LmP0Text@) tail\spelling), (cast: (unsigned) tail\flags), count)
    lm_graph_groups_structure(out, path, (cast: (c.LmP0Structure@) tail\body), metadata, count)
return

sub: lm_graph_groups_node (c.FILE@: out; char@: path; c.LmP0Node@: item; int: metadata; size_t@: count)
    if: item = 0
        return
    if: (item\flags & c.LM_P0_NODE_MIX) != 0U
        metadata := 1
    if: item\kind = c.LM_P0_NODE_FRAME && item\as != 0 && item\as\frame != 0
        c.LmP0Frame@: frame (cast: (c.LmP0Frame@) item\as\frame)
        if: lm_graph_groups_sole((cast: (c.LmP0Structure@) frame\body)) != 0
            lm_graph_groups_row(out, path, "frame", metadata, item, (cast: (c.LmP0Text@) frame\head), (cast: (unsigned) frame\flags), count)
        lm_graph_groups_structure(out, path, (cast: (c.LmP0Structure@) frame\body), metadata, count)
        lm_graph_groups_trailer(out, path, item, (cast: (c.LmP0Trailer@) frame\trailer), metadata, count)
    if: item\kind = c.LM_P0_NODE_STRUCTURE && item\as != 0 && item\as\structure != 0
        c.LmP0Structure@: structure (cast: (c.LmP0Structure@) item\as\structure)
        lm_graph_groups_structure(out, path, structure, metadata, count)
        lm_graph_groups_trailer(out, path, item, (cast: (c.LmP0Trailer@) structure\trailer), metadata, count)
    if: item\marks != 0
        lm_graph_groups_structure(out, path, (cast: (c.LmP0Structure@) item\marks), 1, count)
return

sub: lm_graph_groups_structure (c.FILE@: out; char@: path; c.LmP0Structure@: structure; int: metadata; size_t@: count)
    c.LmP0Field@: field 0
    if: structure != 0
        field := (cast: (c.LmP0Field@) structure\first_field)
    while: field != 0
        lm_graph_groups_node(out, path, (cast: (c.LmP0Node@) field\value), metadata, count)
        field := (cast: (c.LmP0Field@) field\next)
return

fn: lm_graph_groups_read (const: (char@: path); size_t@: count) char@
    c.FILE@: file c.fopen(path, "rb")
    c.LmP0FileScratch: scratch
    char@: text 0
    size_t: got 0U
    count[0] := 0U
    if: file = 0
        return: 0
    if: c.fseek(file, 0, c.SEEK_END) != 0
        c.fclose(file)
        return: 0
    scratch\file_size := c.ftell(file)
    if: scratch\file_size < 0 || c.fseek(file, 0, c.SEEK_SET) != 0
        c.fclose(file)
        return: 0
    count[0] := (cast: (size_t) scratch\file_size)
    text := (cast: (char@) c.malloc(count[0] + 1U))
    if: text != 0
        got := c.fread(text, 1U, count[0], file)
        if: got != count[0]
            c.free(text)
            text := 0
    ---
    c.fclose(file)
    if: text != 0
        text[count[0]] := (cast: (char) 0)
return: text

# Relative paths come from the selected tracked-source list, not a filesystem traversal of build directories.
fn: lm_graph_groups_list (char@: root; char@: list; char@: output) int
    size_t: n 0U
    char@: text lm_graph_groups_read(list, @ n)
    c.FILE@: file 0
    char@: full 0
    c.LmP0Document@: doc 0
    size_t: root_length c.strlen(root)
    size_t: at 0U
    size_t: start 0U
    size_t: stop 0U
    size_t: files 0U
    size_t: groups 0U
    int: failed 0
    if: text = 0
        return: 2
    file := c.fopen(output, "rb")
    if: file != 0
        c.fclose(file)
        c.free(text)
        c.fprintf(c.stderr, "groups: output already exists: %s\n", output)
        return: 2
    file := c.fopen(output, "wb")
    if: file = 0
        c.free(text)
        return: 2
    c.fputs("# file\tkind\tmetadata\toffset\tline\tcolumn\tflags\thead\n", file)
    while: at < n
        start := at
        while: at < n && text[at] != 10 && text[at] != 13
            at := at + 1U
        stop := at
        if: at < n && text[at] = 13
            at := at + 1U
        if: at < n && text[at] = 10
            at := at + 1U
        text[stop] := (cast: (char) 0)
        if: stop > start && text[start] != 35
            files := files + 1U
            full := (cast: (char@) c.malloc(root_length + 1U + stop - start + 1U))
            if: full = 0
                failed := failed + 1
            else:
                c.memcpy(full, root, root_length)
                full[root_length] := (cast: (char) 47)
                c.memcpy(full + root_length + 1U, text + start, stop - start + 1U)
                if: lm_graph_p0_open(full, @ doc) != 0
                    c.fprintf(c.stderr, "groups: %s\n", full)
                    failed := failed + 1
                else:
                    lm_graph_groups_node(file, text + start, (cast: (c.LmP0Node@) c.lm_p0_document_root(doc)), 0, @ groups)
                    c.lm_p0_document_destroy(doc)
                    doc := 0
            ---
            c.free(full)
            full := 0
    ---
    if: files = 0 || c.ferror(file) != 0
        failed := failed + 1
    if: c.fclose(file) != 0
        failed := failed + 1
    c.free(text)
    c.printf("GROUP-REPORT %zu files, %zu groups, %d failed\n", files, groups, failed)
return: failed

# One line of the intern witness: INTERN-CHECK <what> PASS|FAIL. 0 for a pass, 1 for a failure.
fn: lm_graph_intern_report (const: (char@: what); int: ok) int
    if: ok != 0
        c.fprintf(c.stdout, "INTERN-CHECK %s PASS\n", what)
        return: 0
    c.fprintf(c.stdout, "INTERN-CHECK %s FAIL\n", what)
    return: 1
end: lm_graph_intern_report

# The spelling "s<i>" (i below 1000000), NUL-terminated, into buf of at least 12 bytes: the distinct spellings of the
# growth part of the intern witness.
sub: lm_graph_intern_spelling (char@: buf; int: i)
    int: k 1
    int: d 100000
    int: started 0
    int: digit 0
    buf[0] := (cast: (char) 115)
    while: d > 0
        digit := (i / d) % 10
        if: digit != 0 || started != 0 || d = 1
            buf[k] := (cast: (char) (48 + digit))
            k := k + 1
            started := 1
        ---
        d := d / 10
    ---
    buf[k] := (cast: (char) 0)
    return
end: lm_graph_intern_spelling

# `intern`: the witness of section 4 of the specification for this slice. One spelling is one address of the `text`
# region of the arena that owns the string state: the word x written in two live arenas is two word cells of two arenas
# holding one spelling address; that address is classified in the owner's region and in neither graph's arena; it does
# not move while the index grows through its first capacities (300 further spellings); a heap string is no spelling.
# 0 when every line passes, else 1.
fn: lm_graph_intern_check () int
    c.LmxArena@: a1 (cast: (c.LmxArena@) c.calloc(1U, c.sizeof(c.LmxArena)))
    c.LmxArena@: a2 (cast: (c.LmxArena@) c.calloc(1U, c.sizeof(c.LmxArena)))
    char@: buf (cast: (char@) c.calloc(16U, 1U))
    c.LmxGraph@: g1 0
    c.LmxGraph@: g2 0
    @: w1 void 0
    @: w2 void 0
    char@: t1 0
    char@: t2 0
    char@: first 0
    char@: again 0
    int: i 0
    int: grown 1
    int: fails 0
    if: a1 = 0 || a2 = 0 || buf = 0
        return: 1
    if: c.lmx_arena_open(a1) != 0 || c.lmx_arena_open(a2) != 0
        c.fputs("graph: cannot open an arena\n", c.stderr)
        return: 1
    g1 := c.lmx_graph_open(a1)
    g2 := c.lmx_graph_open(a2)
    if: g1 = 0 || g2 = 0
        return: 1
    w1 := c.lmx_graph_word(g1, "x", 1U)
    w2 := c.lmx_graph_word(g2, "x", 1U)
    t1 := c.lmx_graph_word_text(g1, w1)
    t2 := c.lmx_graph_word_text(g2, w2)
    fails := fails + lm_graph_intern_report("two-word-cells", (cast: (int) (w1 != 0 && w2 != 0 && w1 != w2 && c.lmx_graph_kind(g1, w1) = 2 && c.lmx_graph_kind(g2, w2) = 2)))
    fails := fails + lm_graph_intern_report("one-spelling-address-from-two-arenas", (cast: (int) (t1 != 0 && t1 = t2 && c.strcmp(t1, "x") = 0)))
    fails := fails + lm_graph_intern_report("spelling-in-the-owner-text-region", c.lmx_graph_intern_owned(t1))
    fails := fails + lm_graph_intern_report("spelling-in-neither-graph-arena", (cast: (int) (c.lmx_graph_kind(g1, (cast: (@) t1)) = 0 && c.lmx_graph_kind(g2, (cast: (@) t1)) = 0)))
    fails := fails + lm_graph_intern_report("heap-string-is-no-spelling", (cast: (int) (c.lmx_graph_intern_owned(buf) = 0)))
    first := c.lmx_graph_intern("s0", 2U)
    while: i < 300
        lm_graph_intern_spelling(buf, i)
        if: c.lmx_graph_intern(buf, c.strlen(buf)) = 0
            grown := 0
        i := i + 1
    ---
    again := c.lmx_graph_intern("x", 1U)
    fails := fails + lm_graph_intern_report("index-grown-by-300-spellings", grown)
    fails := fails + lm_graph_intern_report("address-stable-after-growth", (cast: (int) (again = t1 && first != 0 && c.lmx_graph_intern("s0", 2U) = first && c.lmx_graph_intern("s299", 4U) != 0 && c.lmx_graph_intern_owned(c.lmx_graph_intern("s299", 4U)) != 0)))
    c.lmx_graph_close(g1)
    c.lmx_graph_close(g2)
    c.lmx_arena_release(a1)
    c.lmx_arena_release(a2)
    c.free((cast: (@) a1))
    c.free((cast: (@) a2))
    c.free((cast: (@) buf))
    if: fails != 0
        return: 1
    return: 0
end: lm_graph_intern_check

# A real native entry whose distinct answer proves that dispatch used the entry, not the walker.
fn: lm_graph_native_probe (@: owner; @@: refs; size_t: nargs; @: dest; @@: out; c.LmxArena@: arena; c.Lmx@: code; c.LmxWalkValue@: input; c.LmxWalkValue@: result) int
    return: 77
end: lm_graph_native_probe

fn: lm_graph_mutation_report (const: (char@: what); int: ok) int
    if: ok != 0
        c.printf("MUTATION-CHECK %s PASS\n", what)
        return: 0
    c.printf("MUTATION-CHECK %s FAIL\n", what)
    return: 1
end: lm_graph_mutation_report

# The data of a created function reaches, by a reference, a Structure C whose lexical parent P lies outside the written
# data (the review of 332R): the copy keeps that chain -- the copy of C has a copy of P for its parent, through the same
# map (kernel §6.4), never the source's mutable P and never none --, and the sources stay as they were.
fn: lm_graph_mutation_var_chain (c.LmxGraph@: g) int
    c.LmxGraphState@: state (cast: (c.LmxGraphState@) c.lmx_graph_state())
    c.Lmx@: outer 0
    c.Lmx@: inner 0
    c.Lmx@: written 0
    c.Lmx@: args 0
    c.Lmx@: body 0
    c.Lmx@: decl 0
    c.Lmx@: made 0
    c.Lmx@: vars 0
    c.Lmx@: copied 0
    @: held void 0
    @: kept void 0
    @: link void 0
    @: k void 0
    @: word void 0
    char@: name 0
    char@: field 0
    int: value 0
    int: status 5
    outer := c.lmx_graph_lmx(g, 0, 2U)
    inner := c.lmx_graph_lmx(g, outer, 1U)
    written := c.lmx_graph_lmx(g, 0, 1U)
    args := c.lmx_graph_lmx(g, 0, 0U)
    body := c.lmx_graph_lmx(g, 0, 0U)
    decl := c.lmx_graph_lmx(g, 0, 0U)
    k := c.lmx_graph_int(g, 7)
    if: state = 0 || outer = 0 || inner = 0 || written = 0 || args = 0 || body = 0 || decl = 0 || k = 0
        return: 1
    link := c.lmx_graph_ref_lmx(g, inner)
    if: link = 0 || c.lmx_graph_name(g, k, "k", 1U) != 0 || c.lmx_graph_name(g, (cast: (@) outer), "P", 1U) != 0 || c.lmx_graph_name(g, (cast: (@) inner), "C", 1U) != 0 || c.lmx_graph_name(g, link, "c", 1U) != 0
        return: 1
    if: c.lmx_graph_put_in(g, outer, 0U, k) != 0 || c.lmx_graph_put_in(g, outer, 1U, (cast: (@) inner)) != 0 || c.lmx_graph_put_in(g, inner, 0U, c.lmx_graph_word(g, "k", 1U)) != 0 || c.lmx_graph_put_in(g, written, 0U, link) != 0
        return: 1
    name := c.lmx_graph_intern("probe", 5U)
    field := c.lmx_graph_intern("k", 1U)
    word := c.lmx_graph_word(g, "int", 3U)
    if: name = 0 || field = 0 || word = 0
        return: 1
    status := c.lmx_graph_fn_make(g, decl, name, args, word, written, body, 1, @ made)
    if: status = 0
        vars := c.lmx_graph_method_data(g, made)
    if: vars != 0 && c.lmx_graph_count(vars) = 1U
        held := c.lmx_graph_get_in(g, vars, 0U)
        copied := (cast: (c.Lmx@) c.lmx_graph_target(g, held))
    ---
    if: copied != 0 && copied\parent != 0
        kept := c.lmx_graph_field(g, (cast: (@) copied\parent), field)
    return: lm_graph_mutation_report("var-copy-keeps-the-lexical-chain-of-a-reached-structure", (cast: (int) (status = 0 && c.lmx_graph_kind(g, held) = 6 && copied != inner && copied\parent != 0 && copied\parent != outer && kept != k && c.lmx_graph_value_int(g, kept, @ value) = 0 && value = 7 && inner\parent = outer && c.lmx_graph_target(g, c.lmx_graph_get_in(g, written, 0U)) = (cast: (@) inner))))
end: lm_graph_mutation_var_chain

# First/later writes preserve uninit reference identities; one construction map
# copies the wrapper, its shared typed cell and the referent without aliasing source.
fn: lm_graph_mutation_reference (c.LmxGraph@: g; int: kind) int
    c.Lmx@: written c.lmx_graph_lmx(g, 0, 3U)
    c.Lmx@: args c.lmx_graph_lmx(g, 0, 0U)
    c.Lmx@: body c.lmx_graph_lmx(g, 0, 0U)
    c.Lmx@: decl c.lmx_graph_lmx(g, 0, 0U)
    c.Lmx@: made 0
    c.Lmx@: copied 0
    @: wrapper void c.lmx_graph_uninit_reference(g, kind, 0)
    @: cell void c.lmx_graph_reference_cell(g, wrapper)
    @: first void 0
    @: second void 0
    @: first_value void 0
    @: second_value void 0
    @: copied_wrapper void 0
    @: copied_cell void 0
    @: copied_target void 0
    @: word void c.lmx_graph_word(g, "int", 3U)
    char@: name c.lmx_graph_intern("refprobe", 8U)
    int: status 0
    int: fails 0
    if: kind = 5
        first := c.lmx_graph_int(g, 5)
        second := c.lmx_graph_int(g, 7)
        first_value := c.lmx_graph_ref_int(g, first)
        second_value := c.lmx_graph_ref_int(g, second)
    if: kind = 6
        first := (cast: (@) c.lmx_graph_lmx(g, 0, 0U))
        second := (cast: (@) c.lmx_graph_lmx(g, 0, 0U))
        first_value := first
        second_value := second
    if: written = 0 || args = 0 || body = 0 || decl = 0 || wrapper = 0 || cell = 0 || first_value = 0 || second_value = 0 || word = 0 || name = 0
        return: 1
    if: c.lmx_graph_name(g, cell, "r", 1U) != 0 || c.lmx_graph_put_in(g, written, 0U, wrapper) != 0 || c.lmx_graph_put_in(g, written, 1U, cell) != 0 || c.lmx_graph_put_in(g, written, 2U, first) != 0
        return: 1
    c.printf("MUTATION-REFERENCE kind%d\n", kind)
    status := c.lmx_graph_fn_make(g, decl, name, args, word, written, body, 1, @ made)
    if: status = 0
        copied := c.lmx_graph_method_data(g, made)
    if: copied != 0
        copied_wrapper := c.lmx_graph_get_in(g, copied, 0U)
        copied_cell := c.lmx_graph_get_in(g, copied, 1U)
    fails := fails + lm_graph_mutation_report("unwritten-reference-copy-keeps-service-wrapper-and-shared-cell", (cast: (int) (status = 0 && copied_wrapper != wrapper && copied_cell != cell && c.lmx_graph_kind(g, copied_wrapper) = kind + 3 && c.lmx_graph_kind(g, copied_cell) = kind && c.lmx_graph_reference_cell(g, copied_wrapper) = copied_cell)))
    if: fails != 0
        return: fails
    status := c.lmx_graph_assign_reference(g, written, wrapper, first_value)
    fails := fails + lm_graph_mutation_report("reference-first-write-keeps-slot-wrapper-and-typed-cell", (cast: (int) (status = 0 && c.lmx_graph_get_in(g, written, 0U) = wrapper && c.lmx_graph_kind(g, wrapper) = kind + 3 && c.lmx_graph_reference_cell(g, wrapper) = cell && c.lmx_graph_kind(g, cell) = kind && c.lmx_arena_pointer_void_read(cell) = first)))
    status := c.lmx_graph_assign_reference(g, written, wrapper, wrapper)
    fails := fails + lm_graph_mutation_report("reference-service-wrapper-is-a-value-of-its-type", (cast: (int) (status = 0 && c.lmx_arena_pointer_void_read(cell) = first)))
    status := c.lmx_graph_fn_make(g, decl, name, args, word, written, body, 1, @ made)
    if: status = 0
        copied := c.lmx_graph_method_data(g, made)
    if: copied != 0
        copied_wrapper := c.lmx_graph_get_in(g, copied, 0U)
        copied_cell := c.lmx_graph_get_in(g, copied, 1U)
        copied_target := c.lmx_graph_get_in(g, copied, 2U)
    fails := fails + lm_graph_mutation_report("reference-copy-map-keeps-wrapper-cell-and-target-sharing", (cast: (int) (status = 0 && copied_wrapper != wrapper && copied_cell != cell && copied_target != first && c.lmx_graph_kind(g, copied_wrapper) = kind + 3 && c.lmx_graph_kind(g, copied_cell) = kind && c.lmx_graph_reference_cell(g, copied_wrapper) = copied_cell && c.lmx_arena_pointer_void_read(copied_cell) = copied_target)))
    if: fails != 0
        return: fails
    status := c.lmx_graph_assign_reference(g, copied, copied_wrapper, second_value)
    fails := fails + lm_graph_mutation_report("reference-copy-write-keeps-source-target", (cast: (int) (status = 0 && c.lmx_arena_pointer_void_read(copied_cell) = second && c.lmx_arena_pointer_void_read(cell) = first)))
    status := c.lmx_graph_assign_reference(g, written, cell, second_value)
    fails := fails + lm_graph_mutation_report("reference-later-write-through-saved-cell-keeps-identities", (cast: (int) (status = 0 && c.lmx_graph_get_in(g, written, 0U) = wrapper && c.lmx_graph_reference_cell(g, wrapper) = cell && c.lmx_graph_kind(g, wrapper) = kind + 3 && c.lmx_graph_kind(g, cell) = kind && c.lmx_arena_pointer_void_read(cell) = second)))
return: fails

# Shared code, a data alias to its literal, and a cycle are ordinary Lmx slots. There is no retained reverse index.
fn: lm_graph_mutation_check () int
    c.LmxArena@: arena (cast: (c.LmxArena@) c.calloc(1U, c.sizeof(c.LmxArena)))
    c.LmxGraph@: g 0
    c.Lmx@: scope 0
    c.Lmx@: a 0
    c.Lmx@: b 0
    c.Lmx@: data 0
    c.Lmx@: fresh 0
    c.Lmx@: statement 0
    c.Lmx@: expression 0
    @: x void 0
    @: literal void 0
    @: uninit void 0
    @: same_cell void 0
    @: plus void 0
    @: minus void 0
    int: value 0
    int: status 0
    int: fails 0
    if: arena = 0 || c.lmx_arena_open(arena) != 0
        return: 1
    g := c.lmx_graph_open(arena)
    scope := c.lmx_graph_lmx(g, 0, 5U)
    a := c.lmx_graph_lmx(g, scope, 2U)
    b := c.lmx_graph_lmx(g, scope, 2U)
    data := c.lmx_graph_lmx(g, scope, 1U)
    fresh := c.lmx_graph_lmx(g, scope, 1U)
    statement := c.lmx_graph_lmx(g, a, 3U)
    expression := c.lmx_graph_lmx(g, statement, 3U)
    x := c.lmx_graph_int(g, 5)
    literal := c.lmx_graph_int(g, 1)
    uninit := c.lmx_graph_uninit_int(g)
    plus := c.lmx_graph_word(g, "+", 1U)
    minus := c.lmx_graph_word(g, "-", 1U)
    if: scope = 0 || a = 0 || b = 0 || data = 0 || fresh = 0 || statement = 0 || expression = 0 || x = 0 || literal = 0 || uninit = 0 || plus = 0 || minus = 0
        return: 1
    if: c.lmx_graph_name(g, x, "x", 1U) != 0
        return: 1
    if: c.lmx_graph_put_in(g, scope, 0U, (cast: (@) a)) != 0 || c.lmx_graph_put_in(g, scope, 1U, (cast: (@) b)) != 0 || c.lmx_graph_put_in(g, scope, 2U, (cast: (@) data)) != 0 || c.lmx_graph_put_in(g, scope, 3U, (cast: (@) fresh)) != 0 || c.lmx_graph_put_in(g, scope, 4U, (cast: (@) scope)) != 0
        return: 1
    if: c.lmx_graph_put_in(g, a, 0U, x) != 0 || c.lmx_graph_put_in(g, a, 1U, (cast: (@) statement)) != 0 || c.lmx_graph_put_in(g, b, 0U, x) != 0 || c.lmx_graph_put_in(g, b, 1U, (cast: (@) statement)) != 0 || c.lmx_graph_put_in(g, data, 0U, literal) != 0 || c.lmx_graph_put_in(g, fresh, 0U, uninit) != 0
        return: 1
    if: c.lmx_graph_put_in(g, statement, 0U, c.lmx_graph_word(g, ":=", 2U)) != 0 || c.lmx_graph_put_in(g, statement, 1U, c.lmx_graph_word(g, "x", 1U)) != 0 || c.lmx_graph_put_in(g, statement, 2U, (cast: (@) expression)) != 0 || c.lmx_graph_put_in(g, expression, 0U, c.lmx_graph_word(g, "x", 1U)) != 0 || c.lmx_graph_put_in(g, expression, 1U, plus) != 0 || c.lmx_graph_put_in(g, expression, 2U, literal) != 0
        return: 1
    a\native := (cast: (c.LmxEntry) c.lm_graph_native_probe)
    b\native := (cast: (c.LmxEntry) c.lm_graph_native_probe)
    fresh\native := (cast: (c.LmxEntry) c.lm_graph_native_probe)
    same_cell := c.lmx_graph_place_cell(g, fresh, 0U)
    status := c.lmx_graph_assign_int(g, scope, fresh, 0U, 5)
    fails := fails + lm_graph_mutation_report("first-write-preserves-slot-pointer-cell-and-entry", (cast: (int) (status = 0 && c.lmx_graph_get_in(g, fresh, 0U) = uninit && c.lmx_graph_kind(g, uninit) = 3 && c.lmx_arena_pointer_void_read(uninit) = same_cell && c.lmx_graph_kind(g, same_cell) = 1 && fresh\native != 0 && c.lmx_graph_read_int(g, fresh, 0U, @ value) = 0 && value = 5)))
    status := c.lmx_graph_assign_int(g, scope, fresh, 0U, 7)
    fails := fails + lm_graph_mutation_report("later-write-preserves-slot-pointer-cell-and-entry", (cast: (int) (status = 0 && c.lmx_graph_get_in(g, fresh, 0U) = uninit && c.lmx_arena_pointer_void_read(uninit) = same_cell && fresh\native != 0 && c.lmx_graph_value_int(g, same_cell, @ value) = 0 && value = 7)))
    status := c.lmx_graph_assign_int(g, scope, a, 0U, 9)
    fails := fails + lm_graph_mutation_report("ordinary-data-write-preserves-both-entries", (cast: (int) (status = 0 && a\native != 0 && b\native != 0 && c.lmx_graph_read_int(g, b, 0U, @ value) = 0 && value = 9)))
    fails := fails + lm_graph_mutation_report("preserved-entry-is-dispatched", (cast: (int) (c.lmx_graph_call(g, a) = 77)))
    status := c.lmx_graph_write_slot(g, scope, expression, 1U, (cast: (@) (@ value)))
    fails := fails + lm_graph_mutation_report("foreign-value-refused-before-publication", (cast: (int) (status != 0 && c.lmx_graph_get_in(g, expression, 1U) = plus && a\native != 0 && b\native != 0)))
    status := c.lmx_graph_assign_int(g, scope, data, 0U, 7)
    fails := fails + lm_graph_mutation_report("literal-written-through-data-alias-clears-both", (cast: (int) (status = 0 && a\native = 0 && b\native = 0 && fresh\native != 0)))
    status := c.lmx_graph_call(g, a)
    fails := fails + lm_graph_mutation_report("fresh-walk-reads-updated-literal", (cast: (int) (status = 0 && c.lmx_graph_read_int(g, a, 0U, @ value) = 0 && value = 16)))
    status := c.lmx_graph_call(g, b)
    fails := fails + lm_graph_mutation_report("second-shared-code-walk", (cast: (int) (status = 0 && c.lmx_graph_read_int(g, b, 0U, @ value) = 0 && value = 23)))
    a\native := (cast: (c.LmxEntry) c.lm_graph_native_probe)
    b\native := (cast: (c.LmxEntry) c.lm_graph_native_probe)
    status := c.lmx_graph_write_slot(g, scope, expression, 1U, minus)
    fails := fails + lm_graph_mutation_report("operator-write-clears-both-not-unrelated-entry", (cast: (int) (status = 0 && a\native = 0 && b\native = 0 && fresh\native != 0)))
    status := c.lmx_graph_call(g, a)
    fails := fails + lm_graph_mutation_report("fresh-walk-reads-updated-operator", (cast: (int) (status = 0 && c.lmx_graph_read_int(g, a, 0U, @ value) = 0 && value = 16)))
    fails := fails + lm_graph_mutation_var_chain(g)
    fails := fails + lm_graph_mutation_reference(g, 5)
    fails := fails + lm_graph_mutation_reference(g, 6)
    fails := fails + lm_graph_mutation_report("activation-state-discarded", (cast: (int) (arena\activation = 0)))
    c.lmx_graph_close(g)
    c.lmx_arena_release(arena)
    c.free((cast: (@) arena))
    if: fails != 0
        return: 1
    return: 0
end: lm_graph_mutation_check

# Mutate the published Point/take witness through the same write API. The sentinel proves whether native survives;
# once code changes, invocation must execute the current body with a fresh activation and untouched formal slots.
fn: lm_graph_method_mutation (const: (char@: path)) int
    c.LmxArena@: arena (cast: (c.LmxArena@) c.calloc(1U, c.sizeof(c.LmxArena)))
    c.LmxGraph@: g 0
    c.Lmx@: root 0
    c.Lmx@: point 0
    c.Lmx@: method 0
    c.Lmx@: args 0
    c.Lmx@: body 0
    c.Lmx@: statement 0
    c.Lmx@: expression 0
    c.Lmx@: product 0
    c.Lmx@: formal 0
    @: required void 0
    @@: values void (cast: (@@) c.calloc(2U, sizeof(@)))
    int: status 0
    int: answer 0
    int: fails 0
    int: opened 0
    if: values = 0 || arena = 0 || c.lmx_arena_open(arena) != 0
        return: 1
    g := c.lmx_graph_open(arena)
    if: g = 0 || lm_graph_build_file(g, path, @ root) != 0
        return: 1
    root := c.lmx_graph_file_code(g, root)
    # One traversal creates take. Point already answers through the whole
    # data registry, without executing a declaration on the way to r.
    if: c.lmx_graph_space_open(g, root, @ opened) != 0
        return: 1
    point := (cast: (c.Lmx@) c.lmx_graph_get_in(g, root, 0U))
    method := (cast: (c.Lmx@) c.lmx_graph_target(g, c.lmx_graph_resolve(g, root, c.lmx_graph_intern("take", 4U))))
    if: c.lmx_graph_method(g, method) = 0
        return: 1
    args := c.lmx_graph_method_data(g, method)
    body := c.lmx_graph_method_code(g, method)
    statement := (cast: (c.Lmx@) c.lmx_graph_get_in(g, body, 0U))
    expression := (cast: (c.Lmx@) c.lmx_graph_get_in(g, statement, 0U))
    product := (cast: (c.Lmx@) c.lmx_graph_get_in(g, expression, 0U))
    required := c.lmx_graph_get_in(g, args, 1U)
    method\native := (cast: (c.LmxEntry) c.lm_graph_native_probe)
    status := c.lmx_graph_assign_int(g, root, point, 0U, 3)
    fails := fails + lm_graph_mutation_report("method-data-write-preserves-entry", (cast: (int) (status = 0 && method\native != 0)))
    status := c.lmx_graph_admit(g, method, 0U, (cast: (@) point), @ values[0])
    status := status + c.lmx_graph_admit(g, method, 1U, c.lmx_graph_int(g, 1), @ values[1])
    if: status = 0
        status := c.lmx_graph_invoke(g, method, values, 2U, @ answer)
    fails := fails + lm_graph_mutation_report("method-preserved-native-is-dispatched", (cast: (int) (status = 77)))
    status := c.lmx_graph_assign_int(g, root, product, 2U, 20)
    fails := fails + lm_graph_mutation_report("method-body-literal-clears-entry", (cast: (int) (status = 0 && method\native = 0)))
    status := c.lmx_graph_invoke(g, method, values, 2U, @ answer)
    fails := fails + lm_graph_mutation_report("method-fresh-body-result61", (cast: (int) (status = 0 && answer = 61)))
    method\native := (cast: (c.LmxEntry) c.lm_graph_native_probe)
    status := c.lmx_graph_write_slot(g, root, expression, 1U, c.lmx_graph_word(g, "-", 1U))
    fails := fails + lm_graph_mutation_report("method-body-operator-clears-entry", (cast: (int) (status = 0 && method\native = 0)))
    status := c.lmx_graph_invoke(g, method, values, 2U, @ answer)
    fails := fails + lm_graph_mutation_report("method-next-body-result59", (cast: (int) (status = 0 && answer = 59)))
    method\native := (cast: (c.LmxEntry) c.lm_graph_native_probe)
    formal := (cast: (c.Lmx@) c.lmx_graph_get_in(g, args, 0U))
    status := c.lmx_graph_write_slot(g, root, formal, 0U, c.lmx_graph_word(g, "Point", 5U))
    fails := fails + lm_graph_mutation_report("method-written-formal-clears-entry", (cast: (int) (status = 0 && method\native = 0)))
    fails := fails + lm_graph_mutation_report("method-formal-and-activation-lifetime", (cast: (int) (required = c.lmx_graph_get_in(g, args, 1U) && c.lmx_graph_kind(g, required) = 3 && arena\activation = 0)))
    c.lmx_graph_space_close(opened)
    c.free((cast: (@) values))
    c.lmx_graph_close(g)
    c.lmx_arena_release(arena)
    c.free((cast: (@) arena))
    return: (cast: (int) (fails != 0))
end: lm_graph_method_mutation

# The tool's commands: run, emit, emit-check, p0, retype, groups, intern, mutation, method-mutation. args[0] is the program, args[1]
# the command. The exit: 0 done, else the answer; 2 for a usage error.
fn: lm_graph_main (char@@: args; int: n) int
    int: forced 0
    int: check_root 0
    int: runs 1
    char@: entry 0
    if: n >= 3 && c.strcmp(args[1], "method-mutation") = 0
        return: lm_graph_method_mutation(args[2])
    if: n >= 2 && c.strcmp(args[1], "mutation") = 0
        return: lm_graph_mutation_check()
    if: n >= 2 && c.strcmp(args[1], "intern") = 0
        return: lm_graph_intern_check()
    # Build/preflight only, through the same loader and dumps; no activation or executor is entered.
    if: n = 3 && c.strcmp(args[1], "check") = 0
        return: lm_graph_run_file(args[2], 0, 0)
    if: n >= 3 && c.strcmp(args[1], "run") = 0
        if: n >= 4
            if: lm_graph_is_count(args[3]) != 0
                runs := c.atoi(args[3])
                if: n >= 5
                    entry := args[4]
                ---
            else:
                entry := args[3]
            ---
        if: runs < 1
            return: 2
        return: lm_graph_run_file(args[2], runs, entry)
    if: n >= 3 && c.strcmp(args[1], "p0") = 0
        return: lm_graph_p0_command(args, n)
    if: n >= 3 && c.strcmp(args[1], "retype") = 0
        return: lm_graph_retype_main(args, n)
    if: n = 5 && c.strcmp(args[1], "groups") = 0
        return: lm_graph_groups_list(args[2], args[3], args[4])
    if: n >= 5 && (c.strcmp(args[1], "emit") = 0 || c.strcmp(args[1], "emit-check") = 0)
        check_root := (cast: (int) (c.strcmp(args[1], "emit-check") = 0))
        if: c.strcmp(args[4], "forced") = 0
            forced := 1
        else:
            if: c.strcmp(args[4], "native") != 0
                c.fputs("graph_trans: emit takes native or forced\n", c.stderr)
                return: 2
            ---
        ---
        if: n >= 6
            if: lm_graph_is_count(args[5]) != 0
                runs := c.atoi(args[5])
                if: n >= 7
                    entry := args[6]
                ---
            else:
                entry := args[5]
            ---
        if: runs < 1
            return: 2
        return: lm_graph_emit_file(args[2], args[3], forced, check_root, runs, entry)
    c.fputs("graph_trans: usage: check FILE | run SOURCES [COUNT] [ENTRY] | emit|emit-check SOURCES OUT.lm1 native|forced [COUNT] [ENTRY] | p0 FILE [lower-types] [flags|nodes] | retype --dry|--write ROOT LIST [REPORT] | groups ROOT LIST NEW_OUT | intern\n", c.stderr)
    return: 2
end: lm_graph_main

# merge(operand; ...) in native code: each operand once, in order, by its own route -- the constructed value of a written
# anonymous Structure through the kernel's literal calls, a nested merge, any other operand address (a call included,
# applied once) -- then the one composition of the kernel (lmx_graph_merge_values), shared with the interpreter. A bare
# Frame describing a structure is refused at run time by the kernel's own predicate, with the interpreter's form answer.
# The emitted code computes no merge ahead of execution: the result is built when the code runs.
fn: lm_graph_emit_merge (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: scope; c.Lmx@: expression; int@: temps; char@@: decl_names; size_t@: decl_slots; size_t: decl_n; int@: temp) int
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    c.LmxGraphState@: state (cast: (c.LmxGraphState@) c.lmx_graph_state())
    @: raw void 0
    c.Lmx@: literal 0
    c.Lmx@: element 0
    size_t: n (cast: (size_t) c.lmx_graph_count(expression))
    size_t: j 0U
    size_t: i 0U
    size_t: at 0U
    int: ops temps[0]
    int: made 0
    int: value 0
    int: status 0
    temps[0] := temps[0] + 1
    c.fprintf(f, "        []: @(void) l2_ops%d %zuU\n", ops, n + 1U)
    while: j < n && status = 0
        raw := c.lmx_graph_get_in(g, expression, j)
        if: c.lmx_graph_merge_literal(g, scope, raw) != 0
            literal := (cast: (c.Lmx@) raw)
            made := temps[0]
            temps[0] := temps[0] + 1
            c.fprintf(f, "        @: void l2_v%d 0\n        if: lmx_graph_merge_literal_open(l2_g, lmx_call_code, ", made)
            status := lm_graph_emit_address(g, f, scope, literal)
            c.fprintf(f, ", @ l2_v%d) != 0\n            %s\n", made, leave_failure)
            i := 0U
            while: i < c.lmx_graph_count(literal) && status = 0
                # A field of the literal: a place `int: name [literal]` is its own value (the literal cell) or none; a
                # Frame `int: name value` has its value second, a Frame `@: name int value` third
                # (lmx_graph_literal_field).
                value := -1
                if: c.lmx_graph_kind(g, c.lmx_graph_get_in(g, literal, i)) = 1
                    status := lm_graph_emit_operand(g, f, scope, literal, i, temps, decl_names, decl_slots, decl_n, @ value)
                ---
                if: c.lmx_graph_kind(g, c.lmx_graph_get_in(g, literal, i)) = 4
                    element := (cast: (c.Lmx@) c.lmx_graph_get_in(g, literal, i))
                    at := 1U
                    if: c.lmx_graph_name_of(g, (cast: (@) element)) = state\w_at
                        at := 2U
                    ---
                    if: at < c.lmx_graph_count(element)
                        status := lm_graph_emit_operand(g, f, scope, element, at, temps, decl_names, decl_slots, decl_n, @ value)
                    ---
                ---
                if: status = 0
                    c.fputs("        if: lmx_graph_merge_literal_put(l2_g, ", f)
                    status := lm_graph_emit_address(g, f, scope, literal)
                    if: value < 0
                        c.fprintf(f, ", (cast: (@: Lmx) l2_v%d), %zuU, 0) != 0\n            %s\n", made, i, leave_failure)
                    else:
                        c.fprintf(f, ", (cast: (@: Lmx) l2_v%d), %zuU, l2_v%d) != 0\n            %s\n", made, i, value, leave_failure)
                    ---
                ---
                i := i + 1U
            ---
            value := made
        else:
            if: c.lmx_graph_merge_description(g, scope, raw) != 0
                value := temps[0]
                temps[0] := temps[0] + 1
                c.fprintf(f, "        @: void l2_v%d 0\n        if: lmx_graph_merge_description(l2_g, lmx_call_code, (cast: (@: void) ", value)
                status := lm_graph_emit_address(g, f, scope, (cast: (c.Lmx@) raw))
                c.fprintf(f, ")) != 0\n            %s\n", leave_failure)
            else:
                status := lm_graph_emit_operand(g, f, scope, expression, j, temps, decl_names, decl_slots, decl_n, @ value)
            ---
        ---
        c.fprintf(f, "        l2_ops%d[%zuU]: l2_v%d\n", ops, j, value)
        j := j + 1U
    ---
    value := temps[0]
    temps[0] := temps[0] + 1
    c.fprintf(f, "        @: void l2_v%d 0\n        if: lmx_graph_merge_values(l2_g, l2_ops%d, %zuU, @ l2_v%d) != 0\n            %s\n", value, ops, n, value, leave_failure)
    temp[0] := value
    return: status
end: lm_graph_emit_merge

# The emitted selection of a call (lmx_graph_eval_selected): its record value in l2_cv, then the projection the consumer
# asks for -- an int (want_result 1, l2_t), a cell (2, l2_v), the record itself (3, l2_cv), nothing (0).
fn: lm_graph_emit_selected_call (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: scope; c.Lmx@: application; c.Lmx@: actuals; int@: temps; int: want_result; int@: temp) int
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    int: call_id temps[0]
    int: status 0
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    temps[0] := temps[0] + 1
    c.fprintf(f, "        LmxWalkValue: l2_cv%d\n        lmx_walk_value_clear(@ l2_cv%d)\n        if: lmx_graph_eval_selected(l2_g, lmx_call_code, ", call_id, call_id)
    status := lm_graph_emit_head(g, f, scope, application)
    c.fputs(", (cast: (@: Lmx) ", f)
    if: status = 0
        status := lm_graph_emit_address(g, f, scope, actuals)
    c.fprintf(f, "), %d, @ l2_cv%d) != 0\n            %s\n", (cast: (int) (want_result != 0)), call_id, leave_failure)
    if: want_result = 1
        c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_result_int(l2_g, @ l2_cv%d, @ l2_t%d) != 0\n            %s\n", call_id, call_id, call_id, leave_failure)
    if: want_result = 2
        c.fprintf(f, "        @: void l2_v%d 0\n        if: lmx_graph_result_cell(l2_g, @ l2_cv%d, @ l2_v%d) != 0\n            %s\n", call_id, call_id, call_id, leave_failure)
    temp[0] := call_id
    return: status

# Named and expression-headed Frames select one live target before actuals.
# The same target then uses the common callable binder or ordinary launch.
fn: lm_graph_emit_application (c.LmxGraph@: g; c.FILE@: f; c.Lmx@: scope; c.Lmx@: application; int@: temps; char@@: decl_names; size_t@: decl_slots; size_t: decl_n; int: want_result; int@: temp) int
    c.LmxGraphEmitScratch: leave_storage
    char@: leave_failure (cast: (char@) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    char@: name 0
    @: head void 0
    c.Lmx@: actuals 0
    char@@: formals 0
    size_t: count 0U
    int: structure temps[0]
    int: other structure + 1
    int: finish structure + 2
    int: data -1
    int: result 0
    int: status 0
    if: c.lmx_graph_application_parts(g, (cast: (@) application), @ name, @ head, @ actuals) = 0
        return: 2
    count := c.lmx_graph_count(actuals)
    # A call chosen among declarations (the book #declaration-selection) is handed to the selection of the interpreter:
    # the image does not prepare it yet (fable's answer Q6 (b); the call tables are OPEN).
    if: name != 0 && c.lmx_graph_call_selects(g, scope, name, actuals) != 0
        return: lm_graph_emit_selected_call(g, f, scope, application, actuals, temps, want_result, temp)
    temps[0] := temps[0] + 3
    c.fprintf(f, "        @: void l2_v%d 0\n        if: lmx_graph_application_head(l2_g, lmx_call_code, ", structure)
    if: name != 0
        status := lm_graph_emit_head(g, f, scope, application)
        c.fputs(", 0", f)
    else:
        c.fputs("0, lmx_graph_get_in(l2_g, ", f)
        status := lm_graph_emit_address(g, f, scope, application)
        c.fputs(", 0U)", f)
    ---
    c.fprintf(f, ", @ l2_v%d) != 0\n            %s\n", structure, leave_failure)
    if: status != 0
        return: status
    if: want_result != 0
        c.fprintf(f, "        if: lmx_graph_fn_result(l2_g, l2_v%d) = 0\n            %s\n", structure, leave_failure)
        return: lm_graph_emit_call_selected(g, f, scope, actuals, structure, temps, decl_names, decl_slots, decl_n, want_result, temp)
    c.fprintf(f, "        if: lmx_graph_fn_result(l2_g, l2_v%d) = 0\n            goto: l2_label%d\n", structure, other)
    status := lm_graph_emit_call_selected(g, f, scope, actuals, structure, temps, decl_names, decl_slots, decl_n, 0, @ result)
    c.fprintf(f, "        goto: l2_label%d\n        l2_label%d:\n", finish, other)
    if: status = 0
        formals := (cast: (char@@) c.calloc(count + 1U, sizeof(char@)))
        status := 4
        if: formals != 0
            status := c.lmx_graph_launch_formals(g, 0, actuals, formals)
        if: status = 5
            status := 0
            c.fprintf(f, "        if: 1\n            %s\n", leave_failure)
        else:
            if: status = 0 && count = 1U
                status := lm_graph_emit_launch_operand(g, f, scope, actuals, 0U, temps, decl_names, decl_slots, decl_n, @ data)
            if: status = 0 && data >= 0
                c.fprintf(f, "        if: lmx_graph_call_data(l2_g, (cast: (@: Lmx) l2_v%d), (cast: (@: Lmx) l2_v%d), 0) != 0\n            %s\n", data, structure, leave_failure)
            if: status = 0 && data < 0
                c.fprintf(f, "        if: lmx_graph_call_data(l2_g, 0, (cast: (@: Lmx) l2_v%d), 1) != 0\n            %s\n", structure, leave_failure)
        ---
        c.free((cast: (@) formals))
    ---
    c.fprintf(f, "        l2_label%d:\n", finish)
    temp[0] := result
    return: status
end: lm_graph_emit_application
