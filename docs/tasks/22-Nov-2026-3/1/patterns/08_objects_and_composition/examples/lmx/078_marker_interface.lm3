Marker:
    auditable:

Marked:
    auditable:

Unmarked:
    int: value 7

Check:
    @: item
    return: int
    accepts:
        return: satisfies(item; Marker) != 0
    demo:
        return: accepts(item := Marked) * 10 + accepts(item := Unmarked)

