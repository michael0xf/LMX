# СОХРАНЁННЫЕ СПЕЦИАЛИЗАЦИИ int И @.
# Здесь прежние компактные примеры и зависимости коллекций/обёрток.
# Основные lambda/partial/uncurry/flip теперь находятся в generic_functions.lmx
# и работают с произвольной конечной сигнатурой. Rx*Int остаются дополнениями.
# Эти специализации требуют указанные здесь сигнатуры и не поддерживают
# дополнительные throws целевой функции; общий путь задаёт их отдельно.
# Статически подготовленные исходники, без заявления о запуске LMX.

RxIntUnarySignature :: (int: value; return: int)

RxIntBinarySignature :: (int: first; int: second; return: int)

RxIntCurriedSignature :: (int: first; return: @)

RxRefUnarySignature :: (@: value; return: @)

# Вспомогательное замыкание: захватить первое int по значению.
# Это отделённая от формалов исходной функции собственная ячейка saved.
RxCapturedIntPrototype:
    private:
        @: operation RxIntBinarySignature 0
        int: saved 0
    inputs:
        private: int: value
        return: int
        invoke:
            return: node\private\operation(first := node\private\saved; second := value)

RxCaptureInt:
    private:
        @: operation RxIntBinarySignature
        int: first
    return: @
    capture:
        private: @: instance (copy(RxCapturedIntPrototype))
        private: @: owner parent(instance\inputs)
        owner\private\operation := operation
        owner\private\saved := first
        return: instance\inputs\invoke

# partial(F, prefix): специализация для бинарного F и структуры из одного int.
# prefix копируется по значению в saved; позднейшая правка prefix не меняет
# замыкание. Пример: partial(operation := Add\add; prefix := numbers), где
# numbers = (copy((5))); вызов результата с 3 даёт 8. prefix — структура
# записей значений, а не плотный Array<int>; чтение поля требует \prefix[i].
RxPartialInt:
    private:
        @: operation RxIntBinarySignature
        @: prefix
    return: @
    partial:
        throws: RxFunctionArity
        if: length(prefix) != 1
            throw: RxFunctionArity()
        return: RxCaptureInt\capture(operation; \prefix[0])

# lambda(F): для F:(int,int)->int даёт int -> (int -> int).
# Каждое применение первой ступени создаёт независимый saved.
# Пример: @: curried RxLambdaInt\lambda(operation := Add\add)
#         @: add5 curried(5)
#         int: eight add5(3)
RxLambdaIntPrototype:
    private:
        @: operation RxIntBinarySignature 0
    inputs:
        private: int: first
        return: @
        take:
            return: RxCaptureInt\capture(node\private\operation; first)

RxLambdaInt:
    private: @: operation RxIntBinarySignature
    return: @
    lambda:
        private: @: instance (copy(RxLambdaIntPrototype))
        private: @: owner parent(instance\inputs)
        owner\private\operation := operation
        return: instance\inputs\take

# uncurry(F): F:(int)->@(int->int) превращается в (int,int)->int.
# Проверяется сигнатура возвращённой ступени; результат не превращается в @.
# Пример: @: binary RxUncurryInt\uncurry(operation := curried)
#         binary(5; 3) даёт 8.
RxUncurryIntPrototype:
    private:
        @: operation RxIntCurriedSignature 0
    inputs:
        private:
            int: first
            int: second
        return: int
        invoke:
            private: @: next RxIntUnarySignature node\private\operation(first := first)
            return: next(value := second)

RxUncurryInt:
    private: @: operation RxIntCurriedSignature
    return: @
    uncurry:
        private: @: instance (copy(RxUncurryIntPrototype))
        private: @: owner parent(instance\inputs)
        owner\private\operation := operation
        return: instance\inputs\invoke

# flip(F): переставить ровно два int-аргумента F.
# Пример: flipped(10; 3) = F(3; 10). В частности, для вычитания это -7.
RxFlipIntPrototype:
    private:
        @: operation RxIntBinarySignature 0
    inputs:
        private:
            int: first
            int: second
        return: int
        invoke:
            return: node\private\operation(first := second; second := first)

RxFlipInt:
    private: @: operation RxIntBinarySignature
    return: @
    flip:
        private: @: instance (copy(RxFlipIntPrototype))
        private: @: owner parent(instance\inputs)
        owner\private\operation := operation
        return: instance\inputs\invoke

# compose(F,G): вернуть x -> F(G(x)); обе функции int -> int.
# G вызывается один раз, затем F один раз. Ошибка G не запускает F.
# Пример: compose(Double\twice; Increment\inc)(3) == 8.
RxComposeIntPrototype:
    private:
        @: outer RxIntUnarySignature 0
        @: inner RxIntUnarySignature 0
    inputs:
        private: int: value
        return: int
        invoke:
            return: node\private\outer(value := node\private\inner(value := value))

RxComposeInt:
    private:
        @: outer RxIntUnarySignature
        @: inner RxIntUnarySignature
    return: @
    compose:
        private: @: instance (copy(RxComposeIntPrototype))
        private: @: owner parent(instance\inputs)
        owner\private\outer := outer
        owner\private\inner := inner
        return: instance\inputs\invoke

# pipe(F,G): порядок слева направо, x -> G(F(x)).
# Пример: pipe(Increment\inc; Double\twice)(3) == 8.
RxPipeInt:
    private:
        @: first RxIntUnarySignature
        @: second RxIntUnarySignature
    return: @
    pipe:
        return: RxComposeInt\compose(second; first)

# identity(T): здесь T уже выбран именем семейства Int.
# identity() возвращает int -> int без собственного изменяемого состояния.
# Пример: @: same RxIdentityInt\identity(); same(17) == 17.
RxIdentityIntValue:
    private: int: value
    return: int
    invoke:
        return: value

RxIdentityInt:
    return: @
    identity:
        return: RxIdentityIntValue\invoke

# apply(F,args): точная специализация для структуры из двух int-записей.
# Здесь использован обычный вызов F с явно выбранными двумя значениями.
# Пример: apply(operation := Add\add; actuals := pair), pair = (5;3), даёт 8.
RxApplyInt:
    private:
        @: operation RxIntBinarySignature
        @: actuals
    return: int
    apply:
        throws: RxFunctionArity
        if: length(actuals) != 2
            throw: RxFunctionArity()
        return: operation(first := \actuals[0]; second := \actuals[1])

# Для одной int-позиции отдельная сигнатура сохраняет статический контракт F.
RxApplyUnaryInt:
    private:
        @: operation RxIntUnarySignature
        int: actual
    return: int
    apply:
        return: operation(value := actual)

# ============================================================================
# Общее ссылочное семейство. Оно работает с произвольными структурами/массивами
# как значениями @, но НЕ выдаёт ссылку за скалярный return:int исходной функции.
# Именованный value выбран в fn-контракте: он отображается по позиции на
# настоящее имя формала F и исключает случайное W/E-разворачивание структуры.

RxComposeRefPrototype:
    private:
        @: outer RxRefUnarySignature 0
        @: inner RxRefUnarySignature 0
    inputs:
        private: @: value
        return: @
        invoke:
            return: node\private\outer(value := node\private\inner(value := value))

RxComposeRef:
    private:
        @: outer RxRefUnarySignature
        @: inner RxRefUnarySignature
    return: @
    compose:
        private: @: instance (copy(RxComposeRefPrototype))
        private: @: owner parent(instance\inputs)
        owner\private\outer := outer
        owner\private\inner := inner
        return: instance\inputs\invoke

RxPipeRef:
    private:
        @: first RxRefUnarySignature
        @: second RxRefUnarySignature
    return: @
    pipe:
        return: RxComposeRef\compose(second; first)

RxIdentityRefValue:
    private: @: value
    return: @
    invoke:
        return: value

RxIdentityRef:
    return: @
    identity:
        return: RxIdentityRefValue\invoke

RxApplyUnaryRef:
    private:
        @: operation RxRefUnarySignature
        @: actual
    return: @
    apply:
        return: operation(value := actual)

# ============================================================================
# Самопроверка Int-семейства. Её вызывают явно; чтение/подключение файла не
# запускает её. Это проверочные примеры для будущего запуска ядром LMX.

RxDemoAddInt:
    int: x
    int: y
    return: int
    add:
        return: x + y

RxDemoSubtractInt:
    int: x
    int: y
    return: int
    subtract:
        return: x - y

RxDemoIncrementInt:
    int: x
    return: int
    increment:
        return: x + 1

RxDemoDoubleInt:
    int: x
    return: int
    twice:
        return: x * 2

RxFunctionExamples:
    run:
        throws: RxFunctionArity
        @: curried RxLambdaInt\lambda(operation := RxDemoAddInt\add)
        @: add5 curried(5)
        @: add100 curried(100)
        sys\assert(add5(3) = 8)
        sys\assert(add100(3) = 103)
        sys\assert(add5(1) = 6)
        @: prefix (copy((5)))
        @: fromPrefix RxPartialInt\partial(operation := RxDemoAddInt\add; prefix := prefix)
        sys\assert(fromPrefix(3) = 8)
        @: pair (copy((5; 3)))
        sys\assert(RxApplyInt\apply(operation := RxDemoAddInt\add; actuals := pair) = 8)
        @: direct RxUncurryInt\uncurry(operation := curried)
        sys\assert(direct(5; 3) = 8)
        @: reversed RxFlipInt\flip(operation := RxDemoSubtractInt\subtract)
        sys\assert(reversed(10; 3) = -7)
        @: composition RxComposeInt\compose(RxDemoDoubleInt\twice; RxDemoIncrementInt\increment)
        @: pipeline RxPipeInt\pipe(RxDemoIncrementInt\increment; RxDemoDoubleInt\twice)
        sys\assert(composition(3) = 8)
        sys\assert(pipeline(3) = 8)
        @: identity RxIdentityInt\identity()
        sys\assert(identity(17) = 17)
        sys\assert(RxApplyUnaryInt\apply(RxDemoIncrementInt\increment; 3) = 4)
