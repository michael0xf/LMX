---
    Observed:
        int: terminal 5
        int: indented 5
    end: Observed
---
@: shared (data [] 0)
fn: add_terminal (int: a; int: b) int
    return: ((a + b))
end: add_terminal
fn: add_indented (int: a; int: b) int
    return: ((a + b))
end: add_indented
int: terminal (add_terminal 2 3)
int: indented (add_indented 2 3)
sub: main ()
    :=: ((shared \ Observed) \ terminal) terminal
    :=: ((shared \ Observed) \ indented) indented
end: main
main:
