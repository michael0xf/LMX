Inner:
    size_t: c 5U
end: Inner

Middle:
    Inner: inner
    size_t: tag 7U
end: Middle

Outer:
    Middle: mid
    size_t: keep 3U
end: Outer

# FABLE-GROKBOT-NESTED-FIELD-CONSTRUCT-20260923-116: three-hop path plus a
# primitive field on Outer that must stay at its model default (unchanged).
fn: build () int
    Outer: a
    a\mid\inner\c: 99U
    size_t: got
    size_t: kept
    got: a\mid\inner\c
    kept: a\keep
    if: got != 99U
        return: 91
    if: kept != 3U
        return: 92
    return: 0
end: build

return: build()
