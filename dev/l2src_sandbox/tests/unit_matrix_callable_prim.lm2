# FABLE-GROKBOT-MATRIX-20260924-143 cell: existing callable x primitive, three
# spellings. Physical operation = CALL (never assignment). Side effects on own
# fields are the observable; dirty/checkpoint runs before each call.
int: hits 0
int: last 0

fn: foo (int: n) int
    hits: hits + 1
    last: n
    return: 0
end: foo

foo: 5
if: hits != 1
    return: 90
if: last != 5
    return: 91

foo(6)
if: hits != 2
    return: 92
if: last != 6
    return: 93

foo:
    7
if: hits != 3
    return: 94
if: last != 7
    return: 95

return: 0
