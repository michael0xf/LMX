# An element in a method's condition: `if: a[1] = k` with a size_t element and an int k is two types.  Refused at
# the element.
fn: m () int
    int: k 5
    []: size_t a 2
    a[1]: 5U
    int: out 0
    if: a[1] = k
        out: 7
    return: out

sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
