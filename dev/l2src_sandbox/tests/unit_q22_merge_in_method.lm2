A:
    fn: M
    size_t: tag 7U
end: A

size_t: other 5U
size_t: tag 3U

fn: M () size_t
    return: node\tag
end: M

# Merge copies the callable occurrence, retaining its native implementation and lexical parent.
# R\M() therefore reads the file's tag: 3, not A's 7. Success is 3.
fn: probe () int
    R: merge: A
    size_t: r R\M()
    return: (cast: (int) r)
end: probe

sendMessage: exit(exit_code: probe(); stdout: ""; stderr: "")
return
