# The part method reads Counter\n as a hidden input from this caller's
# physical Counter. This does not grant the part lexical access to this source.
Counter:
    size_t: n 4U
end: Counter
size_t: got 0U
got: peekN()
if: got = 4U
    sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
return
