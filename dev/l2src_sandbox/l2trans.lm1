# Room in the pool of conditions, and in the row being formed, for `need` entries.
fn: l2_dyc_reserve (int: need) int
    int: cap
    size_t: isz
    @: void p
    if: need <= l2_dyc_cap
        return: 0
    cap: lm_compiler_cap_next(l2_dyc_cap, need)
    if: cap < 0
        l2_alloc_err: 2
        return: 1
    isz: c.sizeof(c.int)
    p: lm_compiler_vec_grow((cast: (@: void) l2_dyc_t), l2_dyc_n, cap, isz)
    if: p = 0
        return: 1
    l2_dyc_t: (cast: (@: int) p)
