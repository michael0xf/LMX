# Positive7: distinct child scopes, reordered outer and inner layouts.
# Writing A.y must preserve the adjacent A.x and the independently used B.x.
Leaf: (int: x 1; int: y 2)
Model: (A: (int: x 1; int: y 2); B: (int: x 1; int: y 2))
Candidate: (B: (int: x 9); A: (int: y 8; int: x 99))
fn: readX (Leaf: p) int
    return: p\x
end: readX
fn: go () int
    @: m Model Candidate
    m\A\y: 18
    if: m\A\x != 99
        return: 81
    if: m\A\y != 18
        return: 82
    return: m\A\y + readX(m\B) - 20
end: go
sendMessage: exit(exit_code: go(); stdout: ""; stderr: "")
return
