predef: "l2src/lmx_dec.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<string.h>"

# lmx_dec — the decimal backend over vendored C decNumber.  Was lmx_dec.c.
#
# The three private helpers of the C original (digits_ok, op_ctx, finish_op) carry
# the lmx_dec_ prefix here: L1 has no `static`, a unit's fn is emitted with external
# linkage, and bare names like finish_op would collide with any other unit that
# wants them.
fn: lmx_dec_digits_ok (const: @(LmxDecCtx ctx)) int
    if: ctx = 0
        return: 0
    ---
    if: ctx\set.digits < 1
        return: 0
    ---
    if: ctx\set.digits > LMX_DEC_DIGITS
        return: 0
    ---
    return: 1

fn: lmx_dec_op_ctx (const: @(LmxDecCtx owner); @: decContext op) void
    \op: owner\set
    op\status: 0

fn: lmx_dec_finish_op (@: LmxDecCtx owner; const: @(decContext op)) int
    owner\set.status: owner\set.status | op\status
    if: (op\status & c.DEC_Errors) != 0U
        return: 1
    ---
    return: 0

fn: lmx_dec_digits () int
    return: LMX_DEC_DIGITS

fn: lmx_dec_ctx_set_digits (@: LmxDecCtx ctx; int: digits) int
    if: ctx = 0
        return: 1
    ---
    ctx\set.digits: digits
    return: 0

fn: lmx_dec_ctx_init (@: LmxDecCtx ctx) int
    if: ctx = 0
        return: 1
    ---
    if: c.decContextTestEndian(1) != 0
        return: 1
    ---
    c.decContextDefault(@ ctx\set, c.DEC_INIT_BASE)
    ctx\set.traps: 0
    ctx\set.digits: LMX_DEC_DIGITS
    ctx\set.round: c.DEC_ROUND_HALF_EVEN
    ctx\set.status: 0
    return: 0

fn: lmx_dec_ctx_status (const: @(LmxDecCtx ctx)) unsigned
    if: ctx = 0
        return: 0U
    ---
    return: ctx\set.status

fn: lmx_dec_ctx_clear (@: LmxDecCtx ctx) void
    if: ctx != 0
        ctx\set.status: 0
    ---

fn: lmx_dec_from_text (@: LmxDec out; const: @(char text); @: LmxDecCtx ctx) int
    decContext: op
    if: out = 0 || text = 0 || lmx_dec_digits_ok(ctx) = 0
        return: 1
    ---
    lmx_dec_op_ctx(ctx, @ op)
    c.decNumberFromString(@ out\n, text, @ op)
    return: lmx_dec_finish_op(ctx, @ op)

fn: lmx_dec_add (@: LmxDec out; const: @(LmxDec a); const: @(LmxDec b); @: LmxDecCtx ctx) int
    decContext: op
    if: out = 0 || a = 0 || b = 0 || lmx_dec_digits_ok(ctx) = 0
        return: 1
    ---
    lmx_dec_op_ctx(ctx, @ op)
    c.decNumberAdd(@ out\n, @ a\n, @ b\n, @ op)
    return: lmx_dec_finish_op(ctx, @ op)

fn: lmx_dec_mul (@: LmxDec out; const: @(LmxDec a); const: @(LmxDec b); @: LmxDecCtx ctx) int
    decContext: op
    if: out = 0 || a = 0 || b = 0 || lmx_dec_digits_ok(ctx) = 0
        return: 1
    ---
    lmx_dec_op_ctx(ctx, @ op)
    c.decNumberMultiply(@ out\n, @ a\n, @ b\n, @ op)
    return: lmx_dec_finish_op(ctx, @ op)

fn: lmx_dec_div (@: LmxDec out; const: @(LmxDec a); const: @(LmxDec b); @: LmxDecCtx ctx) int
    decContext: op
    if: out = 0 || a = 0 || b = 0 || lmx_dec_digits_ok(ctx) = 0
        return: 1
    ---
    lmx_dec_op_ctx(ctx, @ op)
    c.decNumberDivide(@ out\n, @ a\n, @ b\n, @ op)
    return: lmx_dec_finish_op(ctx, @ op)

fn: lmx_dec_neg (@: LmxDec out; const: @(LmxDec a); @: LmxDecCtx ctx) int
    decContext: op
    if: out = 0 || a = 0 || lmx_dec_digits_ok(ctx) = 0
        return: 1
    ---
    lmx_dec_op_ctx(ctx, @ op)
    c.decNumberMinus(@ out\n, @ a\n, @ op)
    return: lmx_dec_finish_op(ctx, @ op)

fn: lmx_dec_pow (@: LmxDec out; const: @(LmxDec a); const: @(LmxDec b); @: LmxDecCtx ctx) int
    decContext: op
    if: out = 0 || a = 0 || b = 0 || lmx_dec_digits_ok(ctx) = 0
        return: 1
    ---
    lmx_dec_op_ctx(ctx, @ op)
    c.decNumberPower(@ out\n, @ a\n, @ b\n, @ op)
    return: lmx_dec_finish_op(ctx, @ op)

fn: lmx_dec_compare (const: @(LmxDec a); const: @(LmxDec b); @: LmxDecCtx ctx; @: int rel) int
    decContext: op
    decNumber: cmp
    if: a = 0 || b = 0 || rel = 0 || lmx_dec_digits_ok(ctx) = 0
        return: 1
    ---
    lmx_dec_op_ctx(ctx, @ op)
    c.decNumberCompare(@ cmp, @ a\n, @ b\n, @ op)
    if: lmx_dec_finish_op(ctx, @ op) != 0 || c.decNumberIsNaN(@ cmp) != 0
        return: 1
    ---
    if: c.decNumberIsZero(@ cmp) != 0
        \rel: 0
    else:
        if: c.decNumberIsNegative(@ cmp) != 0
            \rel: -1
        else:
            \rel: 1
        ---
    ---
    return: 0

fn: lmx_dec_quantize_places (@: LmxDec out; const: @(LmxDec a); int: places; LmxDecRounding: round; @: LmxDecCtx ctx) int
    decContext: op
    # A bare decNumber, not the LmxDec wrapper: the C original declared `LmxDec exp`
    # only to reach its single field, and decNumber wants a decNumber * -- L1 cannot
    # take the address of a by-value field (`@ exp.n` is not an expression).
    decNumber: exp
    c.array: []: char exptext 24
    if: out = 0 || a = 0 || lmx_dec_digits_ok(ctx) = 0
        return: 1
    ---
    if: places < 0 || places > LMX_DEC_DIGITS || round >= c.DEC_ROUND_MAX
        return: 1
    ---
    if: places = 0
        memcpy(exptext, "1", 2)
    else:
        if: c.sprintf(exptext, "1E-%d", places) < 0
            return: 1
        ---
    ---
    lmx_dec_op_ctx(ctx, @ op)
    op.round: round
    c.decNumberFromString(@ exp, exptext, @ op)
    c.decNumberQuantize(@ out\n, @ a\n, @ exp, @ op)
    return: lmx_dec_finish_op(ctx, @ op)

fn: lmx_dec_to_text (const: @(LmxDec a); @: char buf; size_t: n) int
    c.array: []: char tmp LMX_DEC_TEXT_MIN
    size_t: k 0U
    if: a = 0 || buf = 0
        return: 1
    ---
    c.decNumberToString(@ a\n, tmp)
    k: strlen(tmp)
    if: k + 1U > n
        return: 1
    ---
    memcpy(buf, tmp, k + 1U)
    return: 0
