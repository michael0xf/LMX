# Exact C scalar transport keeps bytes in stable owned cells. The source row
# remains semantic evidence, separate from the physical C access contract.
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_graph.h.lm1"
predef: "l2src/lmx_primitive_profile.h.lm1"
predef: "l2src/lmx_graph_run.h.lm1"
predef: "l2src/lmx_walk.h.lm1"
predef: "l2src/lmx_walk_values.h.lm1"
predef: "l2src/lmx_call.h.lm1"
predef: "l2src/lmx_value_owned.h.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l2src/lmx_graph_copy_owned.h.lm1"
predef: "l2src/lmx_gc.h.lm1"
predef: "l2src/lmx_pool.h.lm1"
predef: "l2src/lmx_implements.h.lm1"
include: "<stdlib.h>" "<string.h>" "<float.h>" "<stdint.h>"

fn: es_binding (@: name char; @@: description void) const: @: c.LmxScalarABI
    return: c.lmx_graph_scalar_binding(c.lmx_graph_intern(name, c.strlen(name)), description)

fn: es_field (@: g c.LmxGraph; @: head char) @: c.Lmx
    @: raw c.Lmx c.lmx_graph_lmx(g, 0, 1U)
    if: raw = 0 || c.lmx_graph_name(g, (cast: (@: void) raw), head, c.strlen(head)) != 0
        return: (cast: (@: c.Lmx) 0)
    if: c.lmx_graph_put(raw, 0U, c.lmx_graph_word(g, "x", 1U)) != 0
        return: (cast: (@: c.Lmx) 0)
    return: raw

# Return from this helper before the caller uses its complete Value. Loading
# and materializing use the ordinary kernel operations, not numeric projection.
fn: es_capture (@: arena c.LmxArena; @: source void; const: (@: abi c.LmxScalarABI); @: description void; @: model c.Lmx; @@: out void) int
    c.LmxWalkValue: context
    c.LmxWalkValue: value
    c.LmxWalkValue: received
    c.LmxWalkValue: loaded
    c.memset((cast: (@: void) (@ context)), 0, c.sizeof(c.LmxWalkValue))
    context\source_type := description
    context\model := model
    if: c.lmx_walk_value_foreign_capture(arena, source, c.LMX_TYPE_FOREIGN, abi, 0, @ context, @ value) != c.LMX_WALK_OK
        return: 1
    if: value\ref = source || value\scalar_abi != abi || value\source_type != description || value\model != model
        return: 2
    if: c.lmx_walk_value_receive_scalar(@ value, c.LMX_TYPE_FOREIGN, abi, @ received) != c.LMX_WALK_OK
        return: 3
    if: c.lmx_walk_value_materialize(arena, @ received, out) != c.LMX_WALK_OK || out[0] = value\ref
        return: 4
    if: c.lmx_walk_value_load(arena, out[0], c.LMX_TYPE_FOREIGN, @ loaded) != c.LMX_WALK_OK
        return: 5
    if: loaded\ref = out[0] || loaded\scalar_abi != abi || loaded\source_type != description || loaded\model != model
        return: 6
    return: 0

fn: es_rows (@: arena c.LmxArena; @: g c.LmxGraph) int
    @: state c.LmxGraphState c.lmx_graph_state()
    @@: description void c.calloc(1U, sizeof(@: void))
    @@: cell void c.calloc(1U, sizeof(@: void))
    @: answer int c.calloc(1U, c.sizeof(c.int))
    const: (@: abi c.LmxScalarABI 0)
    @: source void 0
    @: head char 0
    @: value c.Lmx c.lmx_graph_lmx(g, 0, 1U)
    @: req c.Lmx c.lmx_graph_lmx(g, 0, 1U)
    size_t: first 0U
    size_t: row 0U
    size_t: bound 0U
    size_t: absent 0U
    if: state = 0 || description = 0 || cell = 0 || answer = 0 || value = 0 || req = 0 || state\receivers_count < 35U
        return: 11
    first := state\receivers_count - 35U
    while: row < 35U
        head := state\receivers[first + row]
        abi := c.lmx_graph_scalar_binding(head, description)
        if: abi = 0
            if: c.strcmp(head, "None") != 0 && c.strcmp(head, "void") != 0 && c.strcmp(head, "FILE") != 0
                return: 12
            absent := absent + 1U
        else:
            if: abi\size = 0U || abi\init = 0 || abi\copy = 0 || description[0] = 0
                return: 13
            source := c.malloc(abi\size)
            if: source = 0 || abi\init(source) != 0 || es_capture(arena, source, abi, description[0], 0, cell) != 0
                return: 14
            c.free(source)
            if: c.lmx_graph_name(g, cell[0], "x", 1U) != 0
                return: 15
            c.lmx_graph_put(value, 0U, cell[0])
            c.lmx_graph_put(req, 0U, (cast: (@: void) es_field(g, head)))
            if: c.lmx_graph_source_interface(g, value, req, answer) != c.LMX_WALK_OK || \answer != c.LMX_IMPLEMENTS_YES
                return: 16
            if: c.strcmp(head, "Boolean") = 0
                c.lmx_graph_put(req, 0U, (cast: (@: void) es_field(g, "i8")))
                # Shared C access is not a proof between distinct source rows.
                if: c.lmx_graph_source_interface(g, value, req, answer) != c.LMX_WALK_OK || \answer != c.LMX_IMPLEMENTS_UNKNOWN
                    return: 18
                ---
            ---
            bound := bound + 1U
        ---
        row := row + 1U
    if: bound != 32U || absent != 3U
        return: 17
    c.free(description)
    c.free(cell)
    c.free(answer)
    return: 0

fn: es_values (@: arena c.LmxArena; @: g c.LmxGraph) int
    @@: description void c.calloc(1U, sizeof(@: void))
    @@: other_description void c.calloc(1U, sizeof(@: void))
    @@: output void c.calloc(1U, sizeof(@: void))
    const: (@: abi c.LmxScalarABI 0)
    const: (@: other_abi c.LmxScalarABI 0)
    @: source c.LmxScalarType9 c.calloc(1U, sizeof(c.LmxScalarType9))
    @: result c.LmxScalarType9 0
    @: fixed_read c.LmxScalarType9 0
    @: fraction c.LmxScalarType8 c.calloc(1U, sizeof(c.LmxScalarType8))
    @: fraction_result c.LmxScalarType8 0
    @: extended c.LmxScalarType10 c.calloc(1U, sizeof(c.LmxScalarType10))
    @: extended_result c.LmxScalarType10 0
    @: wide c.LmxScalarType31 c.calloc(1U, sizeof(c.LmxScalarType31))
    @: wide_result c.LmxScalarType31 0
    @: count c.LmxScalarType26 c.calloc(1U, sizeof(c.LmxScalarType26))
    @: count_result c.LmxScalarType26 0
    @: model c.Lmx c.lmx_graph_lmx(g, 0, 0U)
    @: physical c.Lmx c.lmx_graph_lmx(g, 0, 0U)
    @: destination void 0
    @: context c.LmxWalkValue 0
    @: chunk c.LmxChunk 0
    c.LmxWalkValue: value
    c.LmxWalkValue: fixed_value
    c.LmxWalkValue: received
    c.LmxWalkPlace: place
    if: description = 0 || other_description = 0 || output = 0 || source = 0 || fraction = 0 || extended = 0 || wide = 0 || count = 0 || model = 0 || physical = 0 || physical = model
        return: 21
    abi := es_binding("double", description)
    \source := (cast: (c.LmxScalarType9) 1) + c.DBL_EPSILON
    if: es_capture(arena, source, abi, description[0], model, output) != 0
        return: 22
    result := (cast: (@: c.LmxScalarType9) output[0])
    \source := (cast: (c.LmxScalarType9) 9)
    if: \result != (cast: (c.LmxScalarType9) 1) + c.DBL_EPSILON
        return: 23
    destination := output[0]
    c.memset((cast: (@: void) (@ place)), 0, c.sizeof(c.LmxWalkPlace))
    place\address := destination
    place\type := c.LMX_TYPE_FOREIGN
    if: c.lmx_walk_value_foreign_owned(arena, @ value, source, abi) != c.LMX_WALK_OK || c.lmx_walk_value_store(arena, @ place, @ value) != c.LMX_WALK_OK
        return: 24
    if: \result != (cast: (c.LmxScalarType9) 9) || place\address != destination
        return: 25
    \source := (cast: (c.LmxScalarType9) 17)
    if: c.lmx_walk_value_foreign_owned(arena, @ value, source, abi) != c.LMX_WALK_OK || c.lmx_walk_value_store(arena, @ place, @ value) != c.LMX_WALK_OK
        return: 26
    context := c.lmx_value_cell_context(arena, destination)
    if: \result != (cast: (c.LmxScalarType9) 17) || context = 0 || context\source_type != description[0]
        return: 27
    other_abi := es_binding("i64", other_description)
    \wide := c.INT64_MAX - 2
    if: es_capture(arena, wide, other_abi, other_description[0], 0, output) != 0
        return: 28
    wide_result := (cast: (@: c.LmxScalarType31) output[0])
    \wide := c.INT64_MIN + 2
    if: \wide_result != c.INT64_MAX - 2
        return: 29
    if: c.lmx_walk_value_foreign_owned(arena, @ value, wide, other_abi) != c.LMX_WALK_OK
        return: 30
    if: c.lmx_walk_value_store(arena, @ place, @ value) != c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT || \result != (cast: (c.LmxScalarType9) 17)
        return: 31
    if: c.lmx_implements(arena, destination, output[0], 0) != c.LMX_IMPLEMENTS_NO
        return: 32
    if: c.lmx_walk_value_foreign_capture(arena, destination, c.LMX_TYPE_FOREIGN, other_abi, 0, 0, @ received) != c.LMX_WALK_INVALID
        return: 49
    if: c.lmx_walk_value_foreign_owned(arena, @ value, wide, other_abi) != c.LMX_WALK_OK || c.lmx_walk_value_materialize(arena, @ value, output) != c.LMX_WALK_OK
        return: 33
    wide_result := (cast: (@: c.LmxScalarType31) output[0])
    if: \wide_result != c.INT64_MIN + 2
        return: 34
    other_abi := es_binding("u64", other_description)
    \count := c.UINT64_MAX - 1
    if: es_capture(arena, count, other_abi, other_description[0], 0, output) != 0
        return: 35
    count_result := (cast: (@: c.LmxScalarType26) output[0])
    \count := (cast: (c.LmxScalarType26) 0)
    if: \count_result != c.UINT64_MAX - 1
        return: 36
    other_abi := es_binding("flong", other_description)
    \extended := (cast: (c.LmxScalarType10) 1) + c.LDBL_EPSILON
    if: es_capture(arena, extended, other_abi, other_description[0], 0, output) != 0
        return: 37
    extended_result := (cast: (@: c.LmxScalarType10) output[0])
    \extended := (cast: (c.LmxScalarType10) 9)
    if: \extended_result != (cast: (c.LmxScalarType10) 1) + c.LDBL_EPSILON
        return: 38
    other_abi := es_binding("float", other_description)
    \fraction := (cast: (c.LmxScalarType8) 5) / (cast: (c.LmxScalarType8) 4)
    if: es_capture(arena, fraction, other_abi, other_description[0], 0, output) != 0
        return: 45
    fraction_result := (cast: (@: c.LmxScalarType8) output[0])
    \fraction := (cast: (c.LmxScalarType8) 9)
    if: \fraction_result != (cast: (c.LmxScalarType8) 5) / (cast: (c.LmxScalarType8) 4)
        return: 46
    other_abi := es_binding("flong", other_description)
    if: c.lmx_walk_value_foreign_capture(arena, destination, c.LMX_TYPE_FOREIGN, other_abi, 0, 0, @ received) != c.LMX_WALK_INVALID
        return: 48
    if: c.lmx_walk_value_foreign_capture(arena, result, 0 - c.LMX_TYPE_FOREIGN, abi, physical, context, @ fixed_value) != c.LMX_WALK_OK
        return: 39
    if: c.lmx_walk_value_receive_scalar(@ fixed_value, c.LMX_TYPE_FOREIGN, abi, @ received) != c.LMX_WALK_OK || received\type != 0 - c.LMX_TYPE_FOREIGN || received\physical_profile != physical
        return: 40
    if: c.lmx_walk_value_materialize(arena, @ received, output) != c.LMX_WALK_OK || output[0] != fixed_value\ref || c.lmx_range_profile(arena, output[0]) != physical
        return: 41
    place\address := output[0]
    place\type := 0 - c.LMX_TYPE_FOREIGN
    fixed_read := (cast: (@: c.LmxScalarType9) output[0])
    \source := (cast: (c.LmxScalarType9) 23)
    if: c.lmx_walk_value_foreign_owned(arena, @ value, source, abi) != c.LMX_WALK_OK || c.lmx_walk_value_store(arena, @ place, @ value) != c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
        return: 42
    if: \fixed_read != (cast: (c.LmxScalarType9) 17)
        return: 47
    # GC follows metadata, while the scalar bytes are never guessed as edges.
    context := c.lmx_value_cell_context(arena, destination)
    context\model := model
    if: c.lmx_gc_mark_value(arena, destination, 17U, 0) != c.LMX_GC_OK
        return: 43
    chunk := c.lmx_pool_chunk_at(c.lmx_range_cell_pool(arena, (cast: (@: void) model)), (cast: (@: void) model))
    if: chunk = 0 || chunk\mark != 17U
        return: 44
    c.free(description)
    c.free(other_description)
    c.free(output)
    c.free(source)
    c.free(fraction)
    c.free(extended)
    c.free(wide)
    c.free(count)
    return: 0

fn: es_copy (@: arena c.LmxArena; @: g c.LmxGraph; @: source_type void) int
    c.LmxArena: destination
    c.LmxCopyMap: footprint
    c.LmxCopyMap: projection
    c.LmxImplContractFact: fact
    int: answer 0
    unsigned: generation 0U
    @@: description void c.calloc(1U, sizeof(@: void))
    @@: cell void c.calloc(1U, sizeof(@: void))
    @@: copied c.Lmx c.calloc(1U, sizeof(@: c.Lmx))
    const: (@: abi c.LmxScalarABI 0)
    @: source c.LmxScalarType9 c.calloc(1U, sizeof(c.LmxScalarType9))
    @: result c.LmxScalarType9 0
    @: root c.Lmx c.lmx_graph_lmx(g, 0, 1U)
    @: absorb c.Lmx 0
    @: context c.LmxWalkValue 0
    @: copy_cell void 0
    c.memset((cast: (@: void) (@ destination)), 0, c.sizeof(c.LmxArena))
    if: description = 0 || cell = 0 || copied = 0 || source = 0 || root = 0 || c.lmx_arena_open(@ destination) != 0
        return: 51
    abi := es_binding("double", description)
    if: source_type != 0
        description[0] := source_type
    \source := (cast: (c.LmxScalarType9) 1) + c.DBL_EPSILON
    if: es_capture(arena, source, abi, description[0], root, cell) != 0 || c.lmx_graph_put(root, 0U, cell[0]) != 0
        return: 52
    if: c.lmx_graph_source_fact((cast: (@: void) g), arena, root, 0U, 0, 0, 0, @ fact, @ answer) != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES || fact\declared != 1 || fact\declared_type != description[0] || fact\cell != cell[0] || fact\kind != c.LMX_KIND_PRIMITIVE || fact\type != c.LMX_TYPE_FOREIGN || fact\scalar_abi != abi
        return: 129
    if: c.lmx_graph_copy_owned(root, arena, @ destination, copied) != c.LMX_GRAPH_COPY_OK || copied[0] = root
        return: 53
    copy_cell := c.lmx_graph_get(copied[0], 0U)
    context := c.lmx_value_cell_context(@ destination, copy_cell)
    if: copy_cell = cell[0] || context = 0 || context\ref != copy_cell || context\model != copied[0] || context\source_type != description[0] || context\scalar_abi != abi
        return: 54
    result := (cast: (@: c.LmxScalarType9) copy_cell)
    c.free(source)
    if: \result != (cast: (c.LmxScalarType9) 1) + c.DBL_EPSILON
        return: 55
    generation := c.lmx_arena_generation_next(@ destination)
    if: generation = 0U || c.lmx_gc_mark_value(@ destination, (cast: (@: void) copied[0]), generation, 0) != c.LMX_GC_OK || c.lmx_gc_sweep(@ destination, generation) != c.LMX_GC_OK
        return: 130
    context := c.lmx_value_cell_context(@ destination, copy_cell)
    if: context = 0 || context\ref != copy_cell || context\model != copied[0] || context\source_type != description[0] || context\scalar_abi != abi || context\physical_profile != 0 || \result != (cast: (c.LmxScalarType9) 1) + c.DBL_EPSILON
        return: 131
    absorb := (cast: (@: c.Lmx) c.lmx_node_new_owned(@ destination))
    if: absorb = 0 || c.lmx_copy_map_init(@ footprint) != 0 || c.lmx_copy_map_init(@ projection) != 0
        return: 56
    # A graph type description is an edge; a validated module row is not.
    context\source_type := (cast: (@: void) copied[0])
    if: c.lmx_copy_map_put(@ footprint, copy_cell, copy_cell) != 0 || c.lmx_copy_map_put(@ projection, (cast: (@: void) copied[0]), (cast: (@: void) absorb)) != 0
        return: 57
    if: c.lmx_graph_copy_project_mapped(@ destination, @ footprint, @ projection, 0) != c.LMX_GRAPH_COPY_OK
        return: 58
    if: context\model != absorb || context\source_type != (cast: (@: void) absorb) || context\ref != copy_cell || context\physical_profile != 0 || \result != (cast: (c.LmxScalarType9) 1) + c.DBL_EPSILON
        return: 59
    c.lmx_copy_map_dispose(@ footprint)
    c.lmx_copy_map_dispose(@ projection)
    c.lmx_arena_release(@ destination)
    c.free(description)
    c.free(cell)
    c.free(copied)
    return: 0

fn: es_source_factory (@: arena c.LmxArena; @: g c.LmxGraph) int
    # Sorted pairs are the factory boundary; compiler ordering has its own gate.
    const: (@: legacy char "primitive.description\000callable\0000\000cell\0001\000class\000double\000convert\000keyed\000descriptor\0000\000floating\0001\000integer\0000\000numeric\0001\000opaque\0000\000range\000\"C99-double(profile)\"\000reference\0000\000semantic\000float\000signed\0000\000spelling\000double\000width\000profile\000")
    const: (@: custom char "primitive.description\000callable\0000\000cell\0001\000class\000ProbeReal\000convert\000keyed\000descriptor\0000\000floating\0001\000integer\0000\000numeric\0001\000opaque\0000\000range\000\"C99-double(profile)\"\000reference\0000\000semantic\000float\000signed\0000\000spelling\000double\000width\000profile\000")
    const: (@: other char "primitive.description\000callable\0000\000cell\0001\000class\000ProbeTwin\000convert\000keyed\000descriptor\0000\000floating\0001\000integer\0000\000numeric\0001\000opaque\0000\000range\000\"C99-double(profile)\"\000reference\0000\000semantic\000float\000signed\0000\000spelling\000double\000width\000profile\000")
    const: (@: minimal char "primitive.description\000callable\0000\000cell\0001\000class\000ProbeReal\000descriptor\0000\000opaque\0000\000reference\0000\000spelling\000double\000")
    const: (@: malformed char "primitive.description\000callable\0000\000cell\0001\000class\000ProbeReal\000class\000ProbeTwin\000descriptor\0000\000opaque\0000\000reference\0000\000spelling\000double\000")
    @: kernel void 0
    @: float_source void 0
    @: selected void 0
    @: probe void 0
    @: twin void 0
    @: small void 0
    @: bad void 0
    const: (@: abi c.LmxScalarABI es_binding("double", @ kernel))
    const: (@: wrong_abi c.LmxScalarABI es_binding("float", @ float_source))
    @: bytes char c.malloc(217U)
    @: before char c.malloc(217U)
    @: wrapped char c.malloc(218U)
    @: wrapped_text char 0
    @: short_text char 0
    @: malformed_text char 0
    if: abi = 0 || wrong_abi = 0 || kernel = 0 || bytes = 0 || before = 0 || wrapped = 0
        return: 113
    if: c.lmx_graph_scalar_description(abi, legacy, 214U, @ selected) != c.LMX_WALK_OK || selected != kernel
        return: 114
    if: c.lmx_graph_scalar_description(abi, custom, 217U, @ probe) != c.LMX_WALK_OK || probe = 0 || probe = kernel || c.lmx_graph_scalar_source(abi, probe) = 0
        return: 115
    if: c.lmx_graph_scalar_description(abi, other, 217U, @ twin) != c.LMX_WALK_OK || twin = 0 || twin = probe || twin = kernel || c.lmx_graph_scalar_source(abi, twin) = 0
        return: 116
    if: c.lmx_graph_scalar_description(abi, minimal, 106U, @ small) != c.LMX_WALK_OK || small = 0 || small = probe || small = kernel || c.lmx_graph_scalar_source(abi, small) = 0
        return: 117
    c.memcpy((cast: (@: void) bytes), (cast: (const: @: void) custom), 217U)
    c.memcpy((cast: (@: void) before), (cast: (const: @: void) bytes), 217U)
    if: c.lmx_graph_scalar_description(abi, bytes, 217U, @ selected) != c.LMX_WALK_OK || selected != probe || probe = (cast: (@: void) bytes) || c.lmx_graph_scalar_source(abi, (cast: (@: void) bytes)) != 0
        return: 118
    wrapped[0] := 33
    c.memcpy((cast: (@: void) (wrapped + 1U)), (cast: (const: @: void) bytes), 217U)
    wrapped_text := c.lmx_graph_intern(wrapped, 218U)
    short_text := c.lmx_graph_intern(bytes, 216U)
    if: wrapped_text = 0 || short_text = 0 || c.lmx_graph_scalar_source(abi, (cast: (@: void) (wrapped_text + 1U))) != 0 || c.lmx_graph_scalar_source(abi, (cast: (@: void) short_text)) != 0
        return: 119
    bad := probe
    if: c.lmx_graph_scalar_description(wrong_abi, bytes, 217U, @ bad) != c.LMX_WALK_OK || bad != 0 || c.lmx_graph_scalar_source(wrong_abi, probe) != 0
        return: 120
    bad := probe
    if: c.lmx_graph_scalar_description(abi, bytes, 216U, @ bad) != c.LMX_WALK_OK || bad != 0
        return: 121
    bad := probe
    if: c.lmx_graph_scalar_description((cast: (const: @: c.LmxScalarABI) 0), bytes, 217U, @ bad) != c.LMX_WALK_OK || bad != 0 || c.memcmp((cast: (const: @: void) before), (cast: (const: @: void) bytes), 217U) != 0
        return: 122
    malformed_text := c.lmx_graph_intern(malformed, 122U)
    bad := probe
    if: malformed_text = 0 || c.lmx_graph_scalar_description(abi, malformed, 122U, @ bad) != c.LMX_WALK_OK || bad != 0 || c.lmx_graph_scalar_source(abi, (cast: (@: void) malformed_text)) != 0
        return: 123
    c.free(bytes)
    c.free(before)
    c.free(wrapped)
    return: es_copy(arena, g, probe)

fn: es_qualify (@: arena c.LmxArena) int
    @@: description void c.calloc(1U, sizeof(@: void))
    const: (@: abi c.LmxScalarABI 0)
    @: source c.LmxScalarType9 c.calloc(1U, sizeof(c.LmxScalarType9))
    @: seal c.Lmx (cast: (@: c.Lmx) c.lmx_node_new_owned(arena))
    @: outside c.Lmx (cast: (@: c.Lmx) c.lmx_node_new_owned(arena))
    @: root c.Lmx (cast: (@: c.Lmx) c.lmx_node_new_profiled(arena, seal))
    @: context c.LmxWalkValue 0
    c.LmxWalkValue: value
    c.LmxWalkValue: metadata
    if: description = 0 || source = 0 || seal = 0 || outside = 0 || root = 0 || c.lmx_arena_refs_open_profiled(arena, root, 1U, seal) != 0
        return: 61
    abi := es_binding("double", description)
    c.memset((cast: (@: void) (@ metadata)), 0, c.sizeof(c.LmxWalkValue))
    metadata\source_type := description[0]
    \source := (cast: (c.LmxScalarType9) 7)
    if: c.lmx_walk_value_foreign_capture(arena, source, c.LMX_TYPE_FOREIGN, abi, seal, @ metadata, @ value) != c.LMX_WALK_OK || c.lmx_arena_ref_store(arena, root, 0U, (cast: (@: void) value\ref)) != 0
        return: 62
    context := c.lmx_value_cell_context(arena, (cast: (@: void) value\ref))
    if: context = 0 || c.lmx_qualify_tree_preflight_full(arena, root, 0, 0U, 0, 0U, 0, 0U) != c.LMX_QUALIFY_OK
        return: 63
    # The declaration's metadata survives without a current value as well.
    context\present := 0
    context\model := outside
    if: c.lmx_qualify_tree_preflight_full(arena, root, 0, 0U, 0, 0U, 0, 0U) != c.LMX_QUALIFY_INVALID
        return: 64
    context\model := 0
    context\source_type := (cast: (@: void) outside)
    if: c.lmx_qualify_tree_preflight_full(arena, root, 0, 0U, 0, 0U, 0, 0U) != c.LMX_QUALIFY_INVALID
        return: 65
    context\source_type := description[0]
    if: c.lmx_qualify_tree_preflight_full(arena, root, 0, 0U, 0, 0U, 0, 0U) != c.LMX_QUALIFY_OK
        return: 66
    c.free(source)
    c.free(description)
    return: 0

fn: es_unfilled () int
    c.LmxArena: source_arena
    c.LmxArena: target_arena
    @@: description void c.calloc(1U, sizeof(@: void))
    @@: output void c.calloc(1U, sizeof(@: void))
    @@: copied c.Lmx c.calloc(1U, sizeof(@: c.Lmx))
    const: (@: abi c.LmxScalarABI 0)
    @: root c.Lmx 0
    @: model c.Lmx 0
    @: cell void 0
    @: copy_cell void 0
    @: context c.LmxWalkValue 0
    @: copy_context c.LmxWalkValue 0
    @: chunk c.LmxChunk 0
    c.LmxWalkValue: value
    c.memset((cast: (@: void) (@ source_arena)), 0, c.sizeof(c.LmxArena))
    c.memset((cast: (@: void) (@ target_arena)), 0, c.sizeof(c.LmxArena))
    if: description = 0 || output = 0 || copied = 0 || c.lmx_arena_open(@ source_arena) != 0 || c.lmx_arena_open(@ target_arena) != 0
        return: 71
    root := (cast: (@: c.Lmx) c.lmx_node_new_owned(@ source_arena))
    model := (cast: (@: c.Lmx) c.lmx_node_new_owned(@ source_arena))
    abi := es_binding("double", description)
    cell := c.lmx_arena_scalar_cells_profiled(@ source_arena, c.LMX_TYPE_FOREIGN, 0, abi, 1U)
    context := c.lmx_value_cell_context(@ source_arena, cell)
    if: root = 0 || model = 0 || cell = 0 || context = 0 || context\present != 0 || context\scalar_abi != abi
        return: 72
    context\model := model
    context\source_type := description[0]
    if: c.lmx_arena_refs_open_owned(@ source_arena, root, 1U) != 0 || c.lmx_arena_ref_store(@ source_arena, root, 0U, cell) != 0
        return: 73
    if: c.lmx_walk_value_load(@ source_arena, cell, c.LMX_TYPE_FOREIGN, @ value) != c.LMX_WALK_OK || value\present != 0
        return: 74
    if: c.lmx_walk_value_materialize(@ source_arena, @ value, output) != c.LMX_WALK_OK || output[0] != 0
        return: 75
    context\referent := @ value
    if: c.lmx_graph_copy_owned(root, @ source_arena, @ target_arena, copied) != c.LMX_GRAPH_COPY_UNSUPPORTED || copied[0] != 0
        return: 83
    context\referent := 0
    if: c.lmx_graph_copy_owned(root, @ source_arena, @ target_arena, copied) != c.LMX_GRAPH_COPY_OK
        return: 76
    copy_cell := c.lmx_graph_get(copied[0], 0U)
    copy_context := c.lmx_value_cell_context(@ target_arena, copy_cell)
    if: copy_cell = cell || copy_context = 0 || copy_context\present != 0 || copy_context\model = 0 || copy_context\model = model || copy_context\source_type != description[0] || copy_context\scalar_abi != abi
        return: 77
    if: c.lmx_walk_value_load(@ target_arena, copy_cell, c.LMX_TYPE_FOREIGN, @ value) != c.LMX_WALK_OK || value\present != 0
        return: 78
    if: c.lmx_gc_mark_value(@ source_arena, cell, 29U, 0) != c.LMX_GC_OK
        return: 79
    chunk := c.lmx_pool_chunk_at(c.lmx_range_cell_pool(@ source_arena, (cast: (@: void) model)), (cast: (@: void) model))
    if: chunk = 0 || chunk\mark != 29U
        return: 82
    c.lmx_arena_release(@ target_arena)
    c.lmx_arena_release(@ source_arena)
    c.free(description)
    c.free(output)
    c.free(copied)
    return: 0

fn: es_physical_binding (@: public_name char; @: c_name char) int
    @: semantic void 0
    @: physical void 0
    const: (@: public_abi c.LmxScalarABI es_binding(public_name, @ semantic))
    const: (@: physical_abi c.LmxScalarABI es_binding(c_name, @ physical))
    if: public_abi = 0 || physical_abi != public_abi || semantic = 0 || physical = 0 || physical = semantic
        return: 83
    if: physical != (cast: (@: void) c.lmx_graph_intern(c_name, c.strlen(c_name))) || c.lmx_graph_scalar_source(physical_abi, physical) = 0
        return: 84
    return: 0

# These are real selected callable SOURCE/witness entries. The witness is
# unfilled; only entry[2] could be a default. No scalar payload is read here.
fn: es_selected_receive (@: arena c.LmxArena; @: code c.Lmx; @: value c.LmxWalkValue) int
    size_t: slot 0U
    size_t: plan 0U
    return: c.lmx_call_bind_receive(arena, code, 1U, 1U, @ slot, @ plan, 0U, value, 0U, 0, 0, 0)

fn: es_operation (@: arena c.LmxArena; @: parent c.Lmx; int: role; size_t: width) @: c.Lmx
    @: frame c.Lmx c.lmx_walk_plain(arena, parent, width)
    @: op void c.lmx_walk_role_cell(arena, role, 0)
    if: frame = 0 || op = 0 || c.lmx_graph_put(frame, 0U, op) != 0
        return: 0
    return: frame

# Execute a real portable RET(ARG) body through the existing dispatcher.
# A native C-ABI producer needs its declared-width destination before entry.
# The common delivery retains the actual SOURCE/Model from the supplied Value.
fn: es_result_entry (@: owner void; @@: refs void; size_t: nargs; @: dest void; @@: out void; @: arena c.LmxArena; @: code c.Lmx; @: input c.LmxWalkValue; @: result c.LmxWalkValue) int
    if: dest = 0 || out = 0 || input = 0 || result = 0 || nargs != 1U
        return: 1
    if: c.lmx_call_scalar_result(arena, code, input, dest, out) != 0
        return: 1
    c.memcpy((cast: (@: void) result), (cast: (const: @: void) input), c.sizeof(c.LmxWalkValue))
    result\ref := dest
    return: 0

# Its complete scalar result must reach both native C and graph destinations.
fn: es_dispatch (@: arena c.LmxArena; @: g c.LmxGraph; @: code c.Lmx; @: witness void; @: value c.LmxWalkValue; const: (@: abi c.LmxScalarABI)) int
    @: vars c.Lmx c.lmx_graph_lmx(g, code, 0U)
    @: body c.Lmx c.lmx_graph_lmx(g, code, 1U)
    @: ret c.Lmx es_operation(arena, body, c.LMX_WALK_OP_RET, 2U)
    @: arg c.Lmx es_operation(arena, ret, c.LMX_WALK_OP_ARG, 4U)
    @: index void c.lmx_size_new_profiled(arena, 0)
    @@: refs void c.calloc(1U, sizeof(@: void))
    @@: output void c.calloc(1U, sizeof(@: void))
    @: destination void 0
    @: protected void 0
    @: before char c.malloc(2U * abi\size)
    double: copied (cast: (double) 0)
    @: read c.LmxScalarType9 0
    c.LmxWalkValue: result
    c.LmxWalkValue: destination_value
    c.LmxWalkValue: pending
    c.LmxWalkValue: numeric
    c.LmxWalkValue: canary
    c.LmxWalkValue: prior_context
    c.LmxWalkValue: wrong_context
    @: wrong_source void 0
    const: (@: wrong_abi c.LmxScalarABI es_binding("float", @ wrong_source))
    @: wrong_dest void 0
    @: wrong_bytes void 0
    @: protected_int void 0
    @: stored c.LmxWalkValue 0
    @: result_p c.LmxWalkValue @ result
    int: status 0
    if: vars = 0 || body = 0 || ret = 0 || arg = 0 || index = 0 || refs = 0 || output = 0 || before = 0
        return: 103
    if: c.lmx_size_store_known(index, 0U) != 0 || c.lmx_graph_put(code, 2U, (cast: (@: void) vars)) != 0 || c.lmx_graph_put(code, 3U, (cast: (@: void) body)) != 0 || c.lmx_graph_put(body, 0U, (cast: (@: void) ret)) != 0 || c.lmx_graph_put(ret, 1U, (cast: (@: void) arg)) != 0 || c.lmx_graph_put(arg, 1U, index) != 0 || c.lmx_graph_put(arg, 3U, witness) != 0
        return: 104
    refs[0] := c.lmx_walk_value_storage(value)
    c.lmx_walk_value_clear(@ result)
    if: c.lmx_walk_call_prim_dispatch(arena, code, vars, refs, 1U, 0, output, value, @ result) != 0 || result\present = 0 || result\kind != c.LMX_WALK_VALUE_FOREIGN || result\scalar_abi != abi || result\source_type != value\source_type || result\model != value\model || result\physical_profile != value\physical_profile || output[0] != result\ref
        return: 105
    read := (cast: (@: c.LmxScalarType9) result\ref)
    if: \read != (cast: (c.LmxScalarType9) 1) + c.DBL_EPSILON
        return: 106
    if: c.lmx_walk_call_prim_dispatch(arena, code, vars, refs, 1U, @ copied, output, value, @ result) != 0 || copied = (cast: (double) 1) || copied != (cast: (double) 1) + c.DBL_EPSILON
        return: 107
    destination := c.lmx_walk_result_storage(arena, c.LMX_TYPE_FOREIGN, abi, (cast: (@: c.Lmx) value\physical_profile), value\source_type, @ destination_value)
    if: destination = 0 || destination_value\present != 0 || destination_value\ref != destination || destination_value\scalar_abi != abi || destination_value\physical_profile != value\physical_profile || destination_value\source_type != value\source_type || destination_value\model != 0
        return: 108
    code\native := (cast: (c.LmxEntry) c.es_result_entry)
    status := c.lmx_call_prim_values(arena, code, vars, refs, 1U, destination, output, value, @ result)
    code\native := 0
    if: status != 0 || output[0] != destination || result\present = 0 || result\ref != destination || result\scalar_abi != abi || result\source_type != value\source_type || result\model != value\model || result\physical_profile != value\physical_profile
        return: 108
    read := (cast: (@: c.LmxScalarType9) destination)
    if: \read != (cast: (c.LmxScalarType9) 1) + c.DBL_EPSILON
        return: 109
    if: c.lmx_call_result_value(arena, code, value, destination, output, @ result) != 0 || output[0] != destination || c.memcmp((cast: (const: @: void) (@ result)), (cast: (const: @: void) value), c.sizeof(c.LmxWalkValue)) != 0
        return: 114
    if: c.lmx_walk_value_cell(arena, destination, @ pending) != c.LMX_WALK_OK || pending\ref = destination
        return: 115
    read[0] := (cast: (c.LmxScalarType9) 9)
    if: c.lmx_call_result_value(arena, code, @ pending, 0, output, @ result) != 0 || output[0] != pending\ref || c.memcmp((cast: (const: @: void) (@ result)), (cast: (const: @: void) (@ pending)), c.sizeof(c.LmxWalkValue)) != 0
        return: 115
    read := (cast: (@: c.LmxScalarType9) output[0])
    if: read[0] != (cast: (c.LmxScalarType9) 1) + c.DBL_EPSILON || c.lmx_range_cell_pool(arena, output[0]) = 0
        return: 115
    if: c.lmx_walk_value_num(@ numeric, c.LMX_TYPE_INT, 73U) != c.LMX_WALK_OK || c.lmx_call_result_value(arena, code, @ numeric, 0, output, @ result) != 0 || output[0] != 0 || c.memcmp((cast: (const: @: void) (@ result)), (cast: (const: @: void) (@ numeric)), c.sizeof(c.LmxWalkValue)) != 0
        return: 116
    if: wrong_abi = 0
        return: 117
    wrong_dest := c.lmx_walk_result_storage(arena, c.LMX_TYPE_FOREIGN, wrong_abi, 0, wrong_source, @ wrong_context)
    wrong_bytes := c.malloc(wrong_abi\size)
    stored := c.lmx_value_cell_context(arena, wrong_dest)
    if: wrong_dest = 0 || wrong_bytes = 0 || stored = 0
        return: 117
    c.memcpy(wrong_bytes, wrong_dest, wrong_abi\size)
    c.memcpy((cast: (@: void) (@ wrong_context)), (cast: (const: @: void) stored), c.sizeof(c.LmxWalkValue))
    c.memcpy((cast: (@: void) (@ canary)), (cast: (const: @: void) (@ numeric)), c.sizeof(c.LmxWalkValue))
    c.memcpy((cast: (@: void) (@ prior_context)), (cast: (const: @: void) (@ canary)), c.sizeof(c.LmxWalkValue))
    output[0] := destination
    status := c.lmx_call_result_value(arena, code, value, wrong_dest, output, @ canary)
    if: status != 3 || output[0] != destination || c.memcmp(wrong_dest, wrong_bytes, wrong_abi\size) != 0 || c.memcmp((cast: (const: @: void) stored), (cast: (const: @: void) (@ wrong_context)), c.sizeof(c.LmxWalkValue)) != 0 || c.memcmp((cast: (const: @: void) (@ canary)), (cast: (const: @: void) (@ prior_context)), c.sizeof(c.LmxWalkValue)) != 0
        return: 117
    protected_int := c.lmx_scalar_new_physical_profiled(arena, c.lmx_type_immutable(c.LMX_TYPE_INT), 0)
    if: protected_int = 0
        return: 118
    c.memcpy((cast: (@: void) (@ canary)), (cast: (const: @: void) (@ pending)), c.sizeof(c.LmxWalkValue))
    c.memcpy((cast: (@: void) (@ prior_context)), (cast: (const: @: void) (@ canary)), c.sizeof(c.LmxWalkValue))
    status := c.lmx_call_result_value(arena, code, @ numeric, protected_int, output, @ canary)
    if: status != 4 || output[0] != destination || c.lmx_int_value_known(protected_int) != 0 || c.memcmp((cast: (const: @: void) (@ canary)), (cast: (const: @: void) (@ prior_context)), c.sizeof(c.LmxWalkValue)) != 0
        return: 118
    c.free(wrong_bytes)
    protected := c.lmx_arena_scalar_cells_profiled(arena, 0 - c.LMX_TYPE_FOREIGN, 0, abi, 2U)
    if: protected = 0
        return: 110
    c.memcpy((cast: (@: void) before), protected, 2U * abi\size)
    status := c.lmx_walk_call_prim_dispatch(arena, code, vars, refs, 1U, (cast: (@: void) ((cast: (@: char) protected) + 1U)), output, value, @ result)
    if: status != c.LMX_CALL_NOT_CALLABLE || c.memcmp((cast: (const: @: void) before), protected, 2U * abi\size) != 0
        return: 111
    status := c.lmx_walk_call_prim_dispatch(arena, code, vars, refs, 1U, (cast: (@: void) ((cast: (size_t) protected) - 1U)), output, value, @ result)
    if: status != c.LMX_CALL_NOT_CALLABLE || c.memcmp((cast: (const: @: void) before), protected, 2U * abi\size) != 0
        return: 112
    c.free(refs)
    c.free(output)
    c.free(before)
    return: 0

# A compiled contract is metadata, not a fake callable. Header selection is
# explicit even with extra fields, reordered edges or an unavailable edge.
fn: es_compiled_headers (@: arena c.LmxArena; @: g c.LmxGraph; @: args c.Lmx; @: returns c.Lmx; @: witness void) int
    @: variant c.Lmx c.lmx_graph_lmx(g, 0, 5U)
    @: metadata void c.lmx_graph_word(g, "native-metadata", 15U)
    @: got_args c.Lmx 0
    @: got_returns c.Lmx 0
    @: got_source void 0
    @: got_witness void 0
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    if: variant = 0 || metadata = 0 || c.lmx_graph_put(variant, 0U, (cast: (@: void) args)) != 0 || c.lmx_graph_put(variant, 1U, (cast: (@: void) returns)) != 0 || c.lmx_graph_put(variant, 4U, metadata) != 0
        return: 130
    if: c.lmx_callable_headers_at(arena, variant, 0U, 1U, @ got_args, @ got_returns, @ answer) != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES || got_args != args || got_returns != returns || c.lmx_graph_fn_result(g, (cast: (@: void) variant)) != 0
        return: 131
    if: c.lmx_callable_entry(arena, got_returns, 0U, @ got_source, @ got_witness) != 0 || got_source = 0 || got_witness != witness
        return: 132
    if: c.lmx_graph_put(variant, 0U, metadata) != 0 || c.lmx_graph_put(variant, 4U, (cast: (@: void) args)) != 0 || c.lmx_callable_headers_at(arena, variant, 4U, 1U, @ got_args, @ got_returns, @ answer) != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES || got_args != args || got_returns != returns
        return: 133
    if: c.lmx_graph_put(variant, 4U, 0) != 0 || c.lmx_callable_headers_at(arena, variant, 4U, 1U, @ got_args, @ got_returns, @ answer) != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_UNKNOWN || got_args != 0 || got_returns != returns
        return: 134
    # Source edge5 must not alias LAST edge0 of a five-field structure.
    if: c.lmx_graph_put(variant, 0U, (cast: (@: void) args)) != 0 || c.lmx_callable_headers_at(arena, variant, 5U, 1U, @ got_args, @ got_returns, @ answer) != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_UNKNOWN || got_args != 0 || got_returns != returns
        return: 135
    if: c.lmx_callable_headers_at(arena, variant, 0U, (cast: (size_t) -1), @ got_args, @ got_returns, @ answer) != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES || got_args != args || got_returns != 0
        return: 136
    if: c.lmx_callable_headers_at(arena, variant, 0U, 5U, @ got_args, @ got_returns, @ answer) != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_UNKNOWN || got_args != args || got_returns != 0 || c.lmx_graph_count(variant) != 5U
        return: 137
    return: 0

fn: es_receiving (@: arena c.LmxArena; @: g c.LmxGraph) int
    @: code c.Lmx c.lmx_arena_take_struct_role(arena, 0, c.LMX_POOL_ROLE_FN)
    @: args c.Lmx c.lmx_graph_lmx(g, 0, 1U)
    @: returns c.Lmx c.lmx_graph_lmx(g, 0, 1U)
    @: return_entry c.Lmx c.lmx_graph_lmx(g, returns, 2U)
    @: entry c.Lmx c.lmx_graph_lmx(g, args, 4U)
    @: model c.Lmx c.lmx_graph_lmx(g, 0, 0U)
    @: physical c.Lmx c.lmx_graph_lmx(g, 0, 0U)
    @: description void 0
    @: other_description void 0
    const: (@: abi c.LmxScalarABI es_binding("double", @ description))
    const: (@: other_abi c.LmxScalarABI es_binding("float", @ other_description))
    @: witness void 0
    @: metadata c.LmxWalkValue 0
    double: precise (cast: (double) 1) + c.DBL_EPSILON
    float: narrow (cast: (float) 1) + c.FLT_EPSILON
    c.LmxWalkValue: context
    c.LmxWalkValue: value
    c.LmxWalkValue: before
    @: prior c.LmxWalkValue @ before
    @: original_input void 0
    double: changed (cast: (double) 9)
    c.LmxWalkValue: destination_value
    c.LmxWalkValue: result_value
    @: value_p c.LmxWalkValue @ value
    c.LmxWalkFrame: frame
    @: destination void 0
    int: status 0
    if: code = 0 || args = 0 || returns = 0 || return_entry = 0 || entry = 0 || model = 0 || physical = 0 || abi = 0 || other_abi = 0
        return: 85
    if: c.lmx_arena_refs_open_owned(arena, code, 4U) != 0 || c.lmx_graph_put(code, 0U, (cast: (@: void) args)) != 0 || c.lmx_graph_put(code, 1U, (cast: (@: void) returns)) != 0 || c.lmx_graph_put(args, 0U, (cast: (@: void) entry)) != 0
        return: 86
    witness := c.lmx_arena_scalar_cells_profiled(arena, c.LMX_TYPE_FOREIGN, physical, abi, 1U)
    metadata := c.lmx_value_cell_context(arena, witness)
    if: witness = 0 || metadata = 0 || metadata\present != 0 || c.lmx_graph_put(entry, 0U, (cast: (@: void) es_field(g, "double"))) != 0 || c.lmx_graph_put(entry, 1U, witness) != 0
        return: 87
    metadata\source_type := description
    if: c.lmx_graph_put(returns, 0U, (cast: (@: void) return_entry)) != 0 || c.lmx_graph_put(return_entry, 0U, (cast: (@: void) es_field(g, "double"))) != 0 || c.lmx_graph_put(return_entry, 1U, witness) != 0
        return: 97
    status := es_compiled_headers(arena, g, args, returns, witness)
    if: status != 0
        return: status
    c.memset((cast: (@: void) (@ frame)), 0, c.sizeof(c.LmxWalkFrame))
    frame\arena := arena
    frame\code := code
    c.memset((cast: (@: void) (@ context)), 0, c.sizeof(c.LmxWalkValue))
    context\source_type := other_description
    context\model := model
    if: c.lmx_walk_value_foreign_capture(arena, @ narrow, c.LMX_TYPE_FOREIGN, other_abi, physical, @ context, @ value) != c.LMX_WALK_OK
        return: 88
    c.memcpy((cast: (@: void) (@ before)), (cast: (const: @: void) (@ value)), c.sizeof(c.LmxWalkValue))
    status := es_selected_receive(arena, code, @ value)
    if: status != c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT || c.memcmp((cast: (const: @: void) (@ before)), (cast: (const: @: void) (@ value)), c.sizeof(c.LmxWalkValue)) != 0
        return: 89
    if: c.lmx_walk_native_result_context(@ frame, witness, value_p\ref, @ result_value, @ value) != c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT || c.memcmp((cast: (const: @: void) (@ before)), (cast: (const: @: void) (@ value)), c.sizeof(c.LmxWalkValue)) != 0
        return: 90
    context\source_type := description
    if: c.lmx_walk_value_foreign_capture(arena, @ precise, c.LMX_TYPE_FOREIGN, abi, physical, @ context, @ value) != c.LMX_WALK_OK
        return: 91
    c.memcpy((cast: (@: void) (@ before)), (cast: (const: @: void) (@ value)), c.sizeof(c.LmxWalkValue))
    original_input := (cast: (@: void) value_p\ref)
    if: es_selected_receive(arena, code, @ value) != c.LMX_WALK_OK || value_p\ref = original_input || c.memcmp((cast: (const: @: void) original_input), value_p\ref, abi\size) != 0 || c.lmx_walk_native_result_context(@ frame, witness, value_p\ref, @ result_value, @ value) != c.LMX_WALK_OK || metadata\present != 0
        return: 92
    # Only the owned storage address changes: the complete context survives.
    prior\ref := value_p\ref
    if: c.memcmp((cast: (const: @: void) (@ before)), (cast: (const: @: void) (@ value)), c.sizeof(c.LmxWalkValue)) != 0 || abi\copy(original_input, @ changed) != 0 || c.memcmp(value_p\ref, (cast: (const: @: void) (@ precise)), abi\size) != 0
        return: 92
    destination := c.lmx_walk_native_dest(@ frame, witness, @ destination_value)
    if: destination = 0 || destination_value\present != 0 || destination_value\scalar_abi != abi || destination_value\physical_profile != physical || destination_value\source_type != description || destination_value\model != 0 || abi\copy(destination, @ precise) != 0
        return: 100
