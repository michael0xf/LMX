predef: "l2src/lmx_root.lm1"
predef: "l2src/lmx_settle.lm1"
predef: "l2src/lmx_service.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_manager.lm1"
predef: "l2src/lmx_gc.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_list_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_call.lm1"
predef: "l2src/lmx_clock.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# lmx_app_min_selftest.lm1 -- GROK-APP-MIN-DYNAMIC-CHILD-20260921-02
# ONE R0 lifetime: success child -> settle -> lmx_arena_open(@ child_arena) AGAIN
# -> fail child (stop_children) -> settle -> close.
# Honest mixa check: long-lived R0 creates a second child after the Array is empty
# (exposes empty-Array grow that hid behind two-session / same-slot reuse).
# Membership is R0's sole dynamic graph Array<@LmxThread>, with no parallel registry.
# lmx_root_open is (root, entry, limit). lmx_root_create is (root, child_arena, source).
# SUCCESS turn: manager_round (no settle in same round); settle via root_cycle after live asserts.
# Body writes success=1 only; running=0 cleared by lmx_thread_leave (kernel).
# pool_make; child_is not child_add; c.fflush(0) after every check.
# entry_diag: 0=ok path, 1=precond, 2=lmx_root_create returned 0, 3+=later wire fail.

@: LmxRoot app_root 0
@: LmxArena app_child_arena 0
@: Lmx app_source 0
@: LmxMsg app_child_msg 0
@: LmxThread app_child_t 0
@: LmxSchedule app_child_sched 0
@: LmxMsg app_letter 0
size_t: app_phase 0U
size_t: app_letters_taken 0U
int: app_letter_owned_after_take 0
size_t: app_child_turns 0U
size_t: app_mode 0U
size_t: app_entry_diag 0U

fn: app_child_body (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    @: LmxThread t
    @: LmxMsg message
    @: void letter
    app_child_turns: app_child_turns + 1U
    t: lmx_thread_current()
    message: lmx_thread_message(t)
    if: t = 0 || message = 0
        return: 0
    ---
    if: lmx_thread_mail_count(t, c.LMX_POST_INBOX) > 0U
        letter: lmx_thread_mail_take(t, c.LMX_POST_INBOX)
        if: letter != 0
            app_letters_taken: app_letters_taken + 1U
            app_letter: (cast: (@: LmxMsg) letter)
            if: t\slot != 0 && lmx_range_classify(t\slot\arena, letter) = c.LMX_DOMAIN_KIND_MSG_RECORD
                app_letter_owned_after_take: 1
            ---
            if: app_mode = 1U
                message\success: 1
            ---
        ---
    ---
return: 0

fn: app_root_entry (@: Lmx node) int
    @: LmxMsg child
    @: LmxThread child_t
    @: LmxPost child_mail
    @: LmxSchedule child_sched
    @: Lmx graph
    if: app_phase != 0U || app_root = 0 || app_child_arena = 0 || app_source = 0
        app_entry_diag: 1U
        return: 0
    ---
    child: lmx_root_create(app_root, app_child_arena, app_source)
    if: child = 0
        app_entry_diag: 2U
        return: 0
    ---
    child_t: (cast: (@: LmxThread) child)
    child: lmx_thread_message(child_t)
    if: child = 0
        app_entry_diag: 2U
        return: 0
    ---
    app_child_msg: child
    # k.4: no descriptor, no shared method record -- the copied graph's `native` word is
    # set directly.
    graph: child\graph
    if: graph = 0
        app_entry_diag: 4U
        return: 0
    ---
    graph\native: (cast: (LmxEntry) app_child_body)
    child_mail: (cast: (@: LmxPost) lmx_arena_take(app_child_arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    child_sched: (cast: (@: LmxSchedule) lmx_arena_take(app_child_arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: child_mail = 0 || child_t = 0 || child_sched = 0
        app_entry_diag: 5U
        return: 0
    ---
    if: lmx_post_init(app_child_arena, child_mail) != c.LMX_POST_OK
        app_entry_diag: 6U
        return: 0
    ---
    if: lmx_schedule_init(child_sched, app_child_arena, (cast: (@: void) child_t), 100000U) != c.LMX_SCHEDULE_OK
        app_entry_diag: 7U
        return: 0
    ---
    if: lmx_thread_init(app_child_arena, child_t, graph, child_mail, child_sched) != c.LMX_THREAD_OK
        app_entry_diag: 8U
        return: 0
    ---
    # THE CHILD'S OWN SCHEDULER: the queue ITS children would be stepped from.  The arena is
    # named here, by the caller -- the kernel act never guesses it (see lmx_thread.h.lm1).
    if: lmx_thread_scheduler_open(child_t, app_child_arena) != c.LMX_THREAD_OK
        app_entry_diag: 11U
        return: 0
    ---
    if: lmx_child_thread(lmx_root_thread(app_root), child, child_t) != c.LMX_CHILD_OK
        app_entry_diag: 9U
        return: 0
    ---
    app_child_t: child_t
    app_child_sched: child_sched
    app_phase: 1U
    app_entry_diag: 10U
return: 0

# A C global is not a GC root. After the first child-boundary collect, the original
# template is unclassified; same-R0 reopen must rebuild it in R0's arena.
fn: app_make_source (@: LmxArena arena) @: Lmx
    @: Lmx source
    @: LmxArrayDesc source_children
    if: arena = 0
        return: 0
    ---
    source: lmx_node_new_owned(arena)
    source_children: lmx_list_new_owned(c.LMX_TYPE_ARRAY_OF_POINTER_BASE + c.LMX_DOMAIN_THREAD, arena)
    if: source = 0 || source_children = 0
        return: 0
    ---
    # k.4: no reserved descriptor slot -- the children list is the sole own field, at 0.
    if: lmx_arena_refs_open_owned(arena, source, 1U) != 0
        return: 0
    ---
    if: lmx_arena_ref_store(source, 0U, (cast: (@: void) source_children)) != 0
        return: 0
    ---
return: source

sub: app_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
    c.fflush(0)
end: app_check

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    int: failures
    LmxRoot: root
    LmxArena: child_arena
    LmxArena: letter_arena
    LmxArena: fail_letter_arena
    @: LmxArena child_at 0
    @: LmxArena letter_at 0
    @: LmxArena fail_letter_at 0
    @: LmxArena root_arena 0
    @: LmxMsg message 0
    @: LmxThread r0 0
    @: Lmx graph 0
    @: Lmx source 0
    @: LmxMsg letter 0
    @: LmxMsg fail_letter 0
    @: void witness 0
    @: void fail_witness 0
    @: LmxService service 0
    @: LmxManager manager 0
    @: LmxMsg child_msg 0
    @: LmxThread child_t 0
    @: LmxThread success_t 0
    size_t: success_turns_snap 0U
    ulong: stop_base 0U
    int: cycle_code 0
    if: counts = 0
        return: 2
    ---
    memset((cast: (@: void) (@ root)), 0, c.sizeof(c.LmxRoot))
    memset((cast: (@: void) (@ child_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ letter_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ fail_letter_arena)), 0, c.sizeof(c.LmxArena))
    app_root: @ root
    child_at: @ child_arena
    letter_at: @ letter_arena
    fail_letter_at: @ fail_letter_arena
    app_phase: 0U
    app_mode: 1U
    app_child_msg: 0
    app_child_t: 0
    app_child_sched: 0
    app_letters_taken: 0U
    app_letter_owned_after_take: 0
    app_child_turns: 0U
    app_entry_diag: 0U
    app_check(counts, lmx_root_open(@ root, app_root_entry, 120000U) = c.LMX_ROOT_OK, "R0 did not open")
    message: lmx_root_message(@ root)
    r0: lmx_root_thread(@ root)
    root_arena: lmx_root_arena(@ root)
    graph: message\graph
    service: lmx_root_service(@ root)
    manager: lmx_root_manager(@ root)
    app_check(counts, message != 0 && r0 != 0 && root_arena != 0 && service != 0 && manager != 0, "R0 missing pieces")
    if: message = 0 || r0 = 0
        failures: counts[1]
        c.printf("lmx_app_min checks=%d failures=%d entry_diag=%u (abort)\n", counts[0], failures, (cast: (unsigned) app_entry_diag))
        c.fflush(0)
        free(counts)
        return: failures
    ---
    source: app_make_source(root_arena)
    app_check(counts, source != 0, "template not built")
    if: source = 0
        failures: counts[1]
        c.printf("lmx_app_min checks=%d failures=%d entry_diag=%u (abort)\n", counts[0], failures, (cast: (unsigned) app_entry_diag))
        c.fflush(0)
        free(counts)
        return: failures
    ---
    app_source: source
    app_check(counts, lmx_arena_open(@ child_arena) = 0, "child arena did not open")
    app_child_arena: @ child_arena

    # ========== SUCCESS CHILD ==========
    cycle_code: lmx_root_cycle(@ root, 4U)
    c.printf("app_min cycle1=%d phase=%u diag=%u child_t=%p count=%u is=%d\n", cycle_code, (cast: (unsigned) app_phase), (cast: (unsigned) app_entry_diag), (cast: (@: void) app_child_t), (cast: (unsigned) lmx_thread_child_count(r0)), lmx_thread_child_is(r0, app_child_t))
    c.fflush(0)
    app_check(counts, cycle_code = c.LMX_ROOT_OK, "success-create cycle did not run")
    app_check(counts, app_phase = 1U && app_child_msg != 0 && app_child_t != 0, "success child was not wired")
    if: cycle_code != c.LMX_ROOT_OK || app_child_msg = 0 || app_child_t = 0 || lmx_thread_child_is(r0, app_child_t) = 0
        failures: counts[1]
        c.printf("lmx_app_min checks=%d failures=%d entry_diag=%u (abort after create; child not in Array)\n", counts[0], failures, (cast: (unsigned) app_entry_diag))
        c.fflush(0)
        free(counts)
        return: failures
    ---
    child_msg: app_child_msg
    child_t: app_child_t
    success_t: app_child_t
    app_check(counts, lmx_thread_children(r0) != 0 && lmx_arena_ref_value(graph, 0U) = (cast: (@: void) lmx_thread_children(r0)), "R0 graph field 0 is not the children Array")
    app_check(counts, lmx_thread_child_count(r0) = 1U, "success child not the sole Array member")
    app_check(counts, lmx_thread_child_at(r0, 0U) = child_t && lmx_thread_child_first(r0) = child_t, "success child is not the physical Array element")
    app_check(counts, lmx_range_classify(@ child_arena, (cast: (@: void) child_msg)) = c.LMX_DOMAIN_KIND_MSG_RECORD, "success child not in own arena")
    app_check(counts, lmx_thread_child_is(r0, child_t) != 0, "success child not live after publish")
    app_check(counts, lmx_thread_manager(child_t) != 0, "the child has no scheduler of its own")
    app_check(counts, lmx_thread_manager(child_t) != lmx_thread_manager(r0), "the child's scheduler is not its own")
    app_check(counts, lmx_schedule_wait(app_child_sched, lmx_root_clock(@ root)) = c.LMX_SCHEDULE_OK, "success schedule wait failed")
    app_check(counts, lmx_manager_add(manager, app_child_sched) = c.LMX_MANAGER_OK, "success child not in manager")
    app_check(counts, lmx_service_find(service, (cast: (@: void) child_t)) = (cast: (@: void) child_t), "success child not in service")
    witness: lmx_arena_take(@ child_arena, 1U, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT)
    app_check(counts, witness != 0 && lmx_arena_ref_store(child_msg\graph, 0U, witness) = 0, "success witness not rooted")
    app_check(counts, lmx_arena_open_simple(@ letter_arena) = 0, "letter arena did not open")
    letter: (cast: (@: LmxMsg) lmx_arena_take(@ letter_arena, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
    app_check(counts, letter != 0, "success letter missing")
    letter\running: 1
    letter\success: 0
    letter\handoff_ready: 0
    letter\graph: 0
    app_check(counts, lmx_service_post(service, (cast: (@: void) child_t), letter, @ letter_arena) = c.LMX_SERVICE_OK, "success post refused")
    app_check(counts, lmx_arena_index_len(letter_at) != 0U && letter_at\blocks != 0, "producer lost success letter arena before owner take")
    app_check(counts, lmx_range_classify(@ letter_arena, (cast: (@: void) letter)) = c.LMX_DOMAIN_KIND_MSG_RECORD, "producer no longer owns queued success letter")
    app_check(counts, lmx_range_classify(@ child_arena, (cast: (@: void) letter)) = c.LMX_KIND_NONE, "recipient classified success letter before owner take")
    app_check(counts, lmx_thread_mail_count(child_t, c.LMX_POST_INBOX) = 1U, "success inbox empty after post")
    # Last turn publishes the safe boundary; the physical Thread stays in R0's Array until settle.
    app_check(counts, lmx_manager_round(manager, 4U, lmx_root_clock(@ root)) = c.LMX_MANAGER_OK, "success-turn manager round did not run")
    app_check(counts, app_child_turns >= 1U && app_letters_taken = 1U, "success child did not take letter")
    app_check(counts, app_letter = letter, "success taken letter mismatch")
    app_check(counts, lmx_arena_index_len(letter_at) = 0U && letter_at\blocks = 0, "success letter arena did not empty on owner take")
    app_check(counts, app_letter_owned_after_take != 0, "owner take did not attach success letter before exposure")
    app_check(counts, child_msg\success != 0 && child_msg\handoff_ready != 0, "the child did not publish its safe success boundary")
    app_check(counts, lmx_thread_child_is(r0, child_t) != 0 && lmx_thread_child_count(r0) = 1U, "success child left the Array before settle")
    app_check(counts, child_at\blocks != 0 && lmx_arena_index_len(child_at) != 0U, "child self-released before parent removal")
    app_check(counts, lmx_root_cycle(@ root, 1U) = c.LMX_ROOT_OK, "success-settle cycle did not run")
    app_check(counts, lmx_thread_child_is(r0, success_t) = 0, "success child stayed live after settle")
    app_check(counts, lmx_thread_child_count(r0) = 0U, "success child stayed in R0's Array after settle")
    app_check(counts, child_at\blocks = 0 && lmx_arena_index_len(child_at) = 0U, "success arena not released")
    app_check(counts, lmx_manager_count(manager) = 0U, "manager not empty after success")
    app_check(counts, lmx_service_count(service) = 1U, "service should hold only R0 after success")
    success_turns_snap: app_child_turns
    source: app_make_source(root_arena)
    app_check(counts, source != 0, "template not rebuilt after settle")
    app_source: source

    # ========== SAME-R0 REOPEN + FAIL CHILD ==========
    # After success settle: arena released, Array empty. Reopen child_arena; second reserve
    # (mixa path that exposed empty-Array grow — second child on the same parent).
    app_check(counts, lmx_arena_open(@ child_arena) = 0, "child arena reopen after success settle failed")
    app_child_arena: @ child_arena
    app_phase: 0U
    app_child_msg: 0
    app_child_t: 0
    app_child_sched: 0
    app_letter: 0
    app_letters_taken: 0U
    app_letter_owned_after_take: 0
    app_child_turns: 0U
    app_mode: 0U
    app_entry_diag: 0U
    app_check(counts, lmx_root_cycle(@ root, 4U) = c.LMX_ROOT_OK, "fail-create cycle did not run")
    app_check(counts, app_phase = 1U && app_child_msg != 0 && app_child_t != 0, "fail child was not wired after reopen")
    if: app_child_msg = 0 || app_child_t = 0
        failures: counts[1]
        c.printf("lmx_app_min checks=%d failures=%d success_turns=%d entry_diag=%u (abort after reopen create)\n", counts[0], failures, success_turns_snap, (cast: (unsigned) app_entry_diag))
        c.fflush(0)
        free(counts)
        return: failures
    ---
    child_msg: app_child_msg
    child_t: app_child_t
    app_check(counts, lmx_thread_child_count(r0) = 1U, "fail child not the sole Array member")
    app_check(counts, lmx_thread_child_at(r0, 0U) = child_t && lmx_thread_child_first(r0) = child_t, "fail child is not the physical Array element")
    app_check(counts, lmx_range_classify(@ child_arena, (cast: (@: void) child_msg)) = c.LMX_DOMAIN_KIND_MSG_RECORD, "fail child not in own arena")
    app_check(counts, lmx_thread_child_is(r0, child_t) != 0, "fail child not live after publish")
    app_check(counts, lmx_schedule_wait(app_child_sched, lmx_root_clock(@ root)) = c.LMX_SCHEDULE_OK, "fail schedule wait failed")
    app_check(counts, lmx_manager_add(manager, app_child_sched) = c.LMX_MANAGER_OK, "fail child not in manager")
    app_check(counts, lmx_service_find(service, (cast: (@: void) child_t)) = (cast: (@: void) child_t), "fail child not in service")
    fail_witness: lmx_arena_take(@ child_arena, 1U, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT)
    app_check(counts, fail_witness != 0 && lmx_arena_ref_store(child_msg\graph, 0U, fail_witness) = 0, "fail witness not rooted")
    app_check(counts, lmx_arena_open_simple(@ fail_letter_arena) = 0, "fail letter arena did not open")
    fail_letter: (cast: (@: LmxMsg) lmx_arena_take(@ fail_letter_arena, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
    app_check(counts, fail_letter != 0, "fail letter missing")
    fail_letter\running: 1
    fail_letter\success: 0
    fail_letter\handoff_ready: 0
    fail_letter\graph: 0
    app_check(counts, lmx_service_post(service, (cast: (@: void) child_t), fail_letter, @ fail_letter_arena) = c.LMX_SERVICE_OK, "fail post refused")
    app_check(counts, lmx_arena_index_len(fail_letter_at) != 0U && fail_letter_at\blocks != 0, "producer lost fail letter arena before owner take")
    app_check(counts, lmx_range_classify(@ fail_letter_arena, (cast: (@: void) fail_letter)) = c.LMX_DOMAIN_KIND_MSG_RECORD, "producer no longer owns queued fail letter")
    app_check(counts, lmx_range_classify(@ child_arena, (cast: (@: void) fail_letter)) = c.LMX_KIND_NONE, "recipient classified fail letter before owner take")
    app_check(counts, lmx_thread_mail_count(child_t, c.LMX_POST_INBOX) = 1U, "fail inbox empty after post")
    app_check(counts, lmx_root_cycle(@ root, 4U) = c.LMX_ROOT_OK, "fail-turn cycle did not run")
    app_check(counts, app_child_turns >= 1U && app_letters_taken = 1U, "fail child did not take letter")
    app_check(counts, lmx_arena_index_len(fail_letter_at) = 0U && fail_letter_at\blocks = 0, "fail letter arena did not empty on owner take")
    app_check(counts, app_letter_owned_after_take != 0, "owner take did not attach fail letter before exposure")
    app_check(counts, child_msg\running = 1 && child_msg\success = 0, "fail child completed itself")
    # THE STOP IS A REQUEST; THE WAIT ENDS BY THE WINDOW (19.09, lmx_thread.h.lm1).  This child is
    # a DIRECT child of R0, and a direct child reaches no deferral (the root is never settled), so
    # the root's own settle walk is the boundary that ends its wait: a child asked to close that
    # reached no boundary of its own within its own band's window (100000U here) is closed there
    # WITHOUT a turn, and that same boundary reaps it.  One reading drives the whole sequence --
    # this is what lmx_root_cycle_at is for.
    stop_base: lmx_clock_ticks()
    app_check(counts, lmx_stop_children(r0, stop_base, 0U) = c.LMX_SETTLE_OK, "stop_children refused")
    app_check(counts, child_msg\running = 0, "stop did not clear running")
    app_check(counts, child_msg\handoff_ready = 0, "stop closed the child before its window")
    app_check(counts, lmx_settle_ready(child_msg) = 0, "a child asked to close reads settle_ready at once")
    app_check(counts, lmx_root_cycle_at(@ root, 1U, stop_base) = c.LMX_ROOT_OK, "the cycle at the request did not run")
    app_check(counts, lmx_thread_child_is(r0, child_t) != 0, "the asked child was settled before its window")
    app_check(counts, lmx_root_cycle_at(@ root, 1U, stop_base + 100001U) = c.LMX_ROOT_OK, "fail-settle cycle did not run")
    app_check(counts, child_msg\handoff_ready != 0, "the child was not closed at its window")
    app_check(counts, lmx_thread_child_is(r0, child_t) = 0, "fail child stayed live")
    app_check(counts, lmx_thread_child_count(r0) = 0U, "fail child stayed in R0's Array")
    app_check(counts, lmx_range_classify(root_arena, fail_witness) != c.LMX_KIND_NONE, "failed blocks did not join parent")
    app_check(counts, lmx_range_classify(@ child_arena, fail_witness) = c.LMX_KIND_NONE, "fail arena not emptied")
    app_check(counts, lmx_manager_count(manager) = 0U, "manager not empty after fail")
    app_check(counts, lmx_service_count(service) = 1U, "service should hold only R0 after fail")

    app_check(counts, lmx_root_close(@ root) = c.LMX_ROOT_OK, "R0 did not close")
    app_check(counts, lmx_root_state(@ root) = c.LMX_ROOT_CLOSED, "closed root not closed")

    failures: counts[1]
    c.printf("lmx_app_min checks=%d failures=%d success_turns=%d fail_turns=%d entry_diag=%u\n", counts[0], failures, success_turns_snap, app_child_turns, (cast: (unsigned) app_entry_diag))
    c.fflush(0)
    free(counts)
return: failures
