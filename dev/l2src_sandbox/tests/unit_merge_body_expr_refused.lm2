# A computed declaration in a merge body is retained as an executable step,
# not collapsed into a constant or lost from the copied Structure.
Model:
    size_t: x 1U
end: Model

R: merge: Model
    int: y 0
    int: w 2 + 2
    y: w
end: merge
R
int: y R\y
sendMessage: exit(exit_code: y; stdout: ""; stderr: "")
return
