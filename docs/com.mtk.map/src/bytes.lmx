            i += 1
        return: result

MapBytesReplaceEntities:
    @: bytes
    @: names
    @: replacements
    int: opening 38
    int: closing 59
    int: fallback 63
    required: bytes names replacements
    return: int
    replaceEntities:
        throws: copy(MapThrows)
        if: length(names) != length(replacements)
            throw: MapFailure("entity table lengths")
        @: source MapBytes\snapshot(bytes)
        @: result MapBytes\allocate()
        int: at 0
        int: changes 0
        while: at < source\count
            int: value MapBytes\get(source; at)
            if: value != opening
                MapBytes\append(result; value)
                at += 1
            else:
                int: end MapBytes\find(source; closing; at + 1)
                if: end < 0
                    while: at < source\count
                        MapBytes\append(result; MapBytes\get(source; at))
                        at += 1
                ---
                else:
                    @: key MapBytes\slice(source; at + 1; end)
                    int: index 0
                    int: found -1
                    while: index < length(names)
                        if: MapBytes\equal(key; names[index])
                            found := index
                            break
                        index += 1
                    if: found < 0
                        MapBytes\append(result; fallback)
                    else:
                        MapBytes\append(result; \replacements[found])
                    changes += 1
                    at := end + 1
        ---
        MapBytes\retarget(bytes; result)
        return: changes


# Compatibility split: the receiver keeps the prefix; result is the suffix.
# Both views are trimmed. An absent/leading/final separator has no suffix.
MapBytesDivideAt:
    @: bytes
    int: at
    required: bytes at
    return: @
    divideAt:
        throws: copy(MapThrows)
        if: at <= 0 || at >= bytes\count
            return: MapNil
        @: result MapBytes\slice(bytes; at + 1; bytes\count)
        bytes\count := at
        MapBytes\trim(bytes)
        MapBytes\trim(result)
        return: result

MapBytesTakeWord:
    @: bytes
    @: separators
    int: consume 1
    required: bytes separators
    return: @
    takeWord:
        throws: copy(MapThrows)
        if: bytes\count = 0
            return: MapNil
        int: at MapBytes\findSet(bytes; separators)
        if: at = 0
            return: MapNil
        int: skip consume != 0
        if: at < 0
            at := bytes\count
            skip := 0
        @: result MapBytes\takePrefix(bytes; at; skip)
        MapBytes\trim(result)
        if: result\count = 0
            return: MapNil
        return: result

MapBytesHtmlFind:
    @: bytes
    int: value
    int: begin 0
    int: end -1
    required: bytes value
    return: int
    htmlFind:
        throws: copy(MapThrows)
        if: end < 0
            end := bytes\count
        if: begin < 0 || end < begin || end > bytes\count
            throw: MapFailure("HTML search range")
        @: names MapVector\create()
        MapVector\push(names; MapBytes\fromText("nbsp"))
        MapVector\push(names; MapBytes\fromText("amp"))
        MapVector\push(names; MapBytes\fromText("lt"))
        MapVector\push(names; MapBytes\fromText("gt"))
        MapVector\push(names; MapBytes\fromText("quot"))
        @: replacements (copy(()))
        MapVector\push(replacements; (32 record))
        MapVector\push(replacements; (38 record))
        MapVector\push(replacements; (60 record))
        MapVector\push(replacements; (62 record))
        MapVector\push(replacements; (34 record))
        @: part MapBytes\snapshot(MapBytes\slice(bytes; begin; end))
        MapBytes\replaceEntities(part; names; replacements; fallback := 32)
        int: found MapBytes\find(part; value)
        MapBytes\splice(bytes; begin; end; part)
        if: found < 0
            return: -1
        return: begin + found

MapBytes:
    @: indexIn MapBytesIndexIn\indexIn
    @: divideAt MapBytesDivideAt\divideAt
    @: takeWord MapBytesTakeWord\takeWord
    @: htmlFind MapBytesHtmlFind\htmlFind
    @: view MapBytesView\view
    @: allocate MapBytesAllocate\allocate
    @: fromText MapBytesFromText\fromText
    @: get MapBytesGet\get
    @: getSigned MapBytesGetSigned\getSigned
    @: set MapBytesSet\set
    @: slice MapBytesSlice\slice
    @: clone MapBytesClone\clone
    @: snapshot MapBytesSnapshot\snapshot
    @: clear MapBytesClear\clear
    @: retarget MapBytesRetarget\retarget
    @: setLength MapBytesSetLength\setLength
    @: setOffset MapBytesSetOffset\setOffset
    @: shift MapBytesShift\shift
    @: append MapBytesAppend\append
    @: copyFrom MapBytesCopyFrom\copyFrom
    @: foldAscii MapBytesFoldAscii\foldAscii
    @: matches MapBytesMatches\matches
    @: equal MapBytesEqual\equal
    @: wordMatches MapBytesWordMatches\wordMatches
    @: findSequence MapBytesFindSequence\findSequence
    @: findSet MapBytesFindSet\findSet
    @: find MapBytesFind\find
    @: findClass MapBytesFindClass\findClass
    @: allInSet MapBytesAllInSet\allInSet
    @: collapse MapBytesCollapse\collapse
    @: splice MapBytesSplice\splice
    @: replaceAll MapBytesReplaceAll\replaceAll
    @: trim MapBytesTrim\trim
    @: takePrefix MapBytesTakePrefix\takePrefix
    @: divide MapBytesDivide\divide
    @: removeFirstLine MapBytesRemoveFirstLine\removeFirstLine
    @: removeWord MapBytesRemoveWord\removeWord
    @: parseInt MapBytesParseInt\parseInt
    @: parseText MapBytesParseText\parseText
    @: parseLittleEndian MapBytesParseLittleEndian\parseLittleEndian
    @: hash MapBytesHash\hash
    @: appendScalar MapBytesAppendScalar\appendScalar
    @: encodeUtf8 MapBytesEncodeUtf8\encodeUtf8
    @: decodeUtf8 MapBytesDecodeUtf8\decodeUtf8
    @: appendLegacyUnit MapBytesAppendLegacyUnit\appendLegacyUnit
    @: decodeLegacy MapBytesDecodeLegacy\decodeLegacy
    @: toText MapBytesToText\toText
    @: escapeHtml MapBytesEscapeHtml\escapeHtml
    @: replaceEntities MapBytesReplaceEntities\replaceEntities

MapBytesIndexIn:
    @: bytes
    @: candidates
    int: fold 1
    required: bytes candidates
    return: int
    indexIn:
        throws: copy(MapThrows)
        int: i 0
        while: i < length(candidates)
            if: MapBytes\equal(bytes; candidates[i]; fold)
                return: i
            i += 1
        return: -1
