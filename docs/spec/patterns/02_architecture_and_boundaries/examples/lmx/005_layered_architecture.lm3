Data:
    return: int
    price:
        return: 10

Application:
    int: quantity
    return: int
    total:
        return: quantity * Data\price()

Presentation:
    int: quantity
    return: int
    handle:
        return: Application\total(quantity)
    demo:
        return: handle(3)

