        throws: copy(MapThrows)
        if: begin < 0 || count < 0 || begin > bytes\count || count > bytes\count - begin
            throw: MapFailure("little-endian range")
        int: result 0
        int: i count
        while: i > 0
            i -= 1
            int: digit MapBytes\get(bytes; begin + i)
            if: digit > limit || result > (limit - digit) / 256
                throw: MapFailure("little-endian integer overflow")
            result := result * 256 + digit
        return: result

