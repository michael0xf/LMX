# return: h\p. The field is Rich. Equatable requires equals.
# take reads that field. Entry 7.

Rich:
    size_t: equals 0U
    size_t: extra 0U
end: Rich

Equatable:
    size_t: equals 0U
end: Equatable

Holder:
    Rich: p
end: Holder

fn: pick (Holder: h) Equatable
return: h\p

fn: take (Equatable: slot) int
    slot\equals: 1U
return: 4

fn: go () int
return: take(pick(Holder))

int: k
k: go()
if: k = 4
    sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
return
