    l2_xfree((cast: (@: void) l2_d105s_ty))
    l2_d105s_ty: 0
    l2_xfree((cast: (@: void) l2_d105s_no))
    l2_d105s_no: 0
    l2_xfree((cast: (@: void) l2_d105s_at))
    l2_d105s_at: 0
    l2_d105s_n: 0
    l2_d105s_cap: 0
    l2_xfree((cast: (@: void) l2_d105e_fmi))
    l2_d105e_fmi: 0
    l2_xfree((cast: (@: void) l2_d105e_fk))
    l2_d105e_fk: 0
    l2_xfree((cast: (@: void) l2_d105e_tmi))
    l2_d105e_tmi: 0
    l2_xfree((cast: (@: void) l2_d105e_tk))
    l2_d105e_tk: 0
    l2_xfree((cast: (@: void) l2_d105e_at))
    l2_d105e_at: 0
    l2_d105e_n: 0
    l2_d105e_cap: 0
    l2_xfree((cast: (@: void) l2_d105e_soft))
    l2_d105e_soft: 0
    l2_xfree((cast: (@: void) l2_cfa_mi))
    l2_cfa_mi: 0
    l2_xfree((cast: (@: void) l2_cfa_fi))
    l2_cfa_fi: 0
    l2_xfree((cast: (@: void) l2_cfa_j))
    l2_cfa_j: 0
    l2_xfree((cast: (@: void) l2_cfa_kind))
    l2_cfa_kind: 0
    l2_xfree((cast: (@: void) l2_cfa_ty))
    l2_cfa_ty: 0
    l2_xfree((cast: (@: void) l2_cfa_sp))
    l2_cfa_sp: 0
    l2_xfree((cast: (@: void) l2_cfa_span))
    l2_cfa_span: 0
    l2_xfree((cast: (@: void) l2_cfa_a0))
    l2_cfa_a0: 0
    l2_xfree((cast: (@: void) l2_cfa_at))
    l2_cfa_at: 0
    l2_cfa_n: 0
    l2_cfa_cap: 0
    l2_xfree((cast: (@: void) l2_d105t_cand))
    l2_d105t_cand: 0
    l2_xfree((cast: (@: void) l2_d105t_req))
    l2_d105t_req: 0
    l2_d105t_n: 0
    l2_d105t_cap: 0
    l2_xfree((cast: (@: void) l2_d105a_mi))
    l2_d105a_mi: 0
    l2_xfree((cast: (@: void) l2_d105a_k))
    l2_d105a_k: 0
    l2_xfree((cast: (@: void) l2_d105a_ty))
    l2_d105a_ty: 0
    l2_d105a_n: 0
    l2_d105a_cap: 0
    l2_d105a_done: 0
    l2_xfree((cast: (@: void) l2_ide_fmi))
    l2_ide_fmi: 0
    l2_xfree((cast: (@: void) l2_ide_fk))
    l2_ide_fk: 0
    l2_xfree((cast: (@: void) l2_ide_tmi))
    l2_ide_tmi: 0
    l2_xfree((cast: (@: void) l2_ide_tk))
    l2_ide_tk: 0
    l2_xfree((cast: (@: void) l2_ide_ty))
    l2_ide_ty: 0
    l2_xfree((cast: (@: void) l2_ide_cls))
    l2_ide_cls: 0
    l2_ide_n: 0
    l2_ide_cap: 0
    l2_xfree((cast: (@: void) l2_d105x_fmi))
    l2_d105x_fmi: 0
    l2_xfree((cast: (@: void) l2_d105x_fk))
    l2_d105x_fk: 0
    l2_xfree((cast: (@: void) l2_d105x_tmi))
    l2_d105x_tmi: 0
    l2_xfree((cast: (@: void) l2_d105x_tk))
    l2_d105x_tk: 0
    l2_d105x_n: 0
    l2_d105x_cap: 0
    l2_xfree((cast: (@: void) l2_d105_tbuf))
    l2_d105_tbuf: 0
    l2_d105_tcap: 0
    l2_xfree((cast: (@: void) l2_anc_m))
    l2_anc_m: 0
    l2_xfree((cast: (@: void) l2_anc_nm))
    l2_anc_nm: 0
    l2_xfree((cast: (@: void) l2_anc_ns))
    l2_anc_ns: 0
    l2_anc_n: 0
    l2_anc_cap: 0
    l2_anc_on: 0
    l2_xfree((cast: (@: void) l2_cfl_callee))
    l2_cfl_callee: 0
    l2_xfree((cast: (@: void) l2_cfl_via))
    l2_cfl_via: 0
    l2_xfree((cast: (@: void) l2_cfl_via_fi))
    l2_cfl_via_fi: 0
    l2_xfree((cast: (@: void) l2_cfl_t))
    l2_cfl_t: 0
    l2_xfree((cast: (@: void) l2_cfl_kind))
    l2_cfl_kind: 0
    l2_xfree((cast: (@: void) l2_cfl_a))
    l2_cfl_a: 0
    l2_xfree((cast: (@: void) l2_cfl_a_fi))
    l2_cfl_a_fi: 0
    l2_xfree((cast: (@: void) l2_cfr_c))
    l2_cfr_c: 0
    l2_xfree((cast: (@: void) l2_cfr_t))
    l2_cfr_t: 0
    l2_xfree((cast: (@: void) l2_cfr_m))
    l2_cfr_m: 0
    l2_xfree((cast: (@: void) l2_cfr_built))
    l2_cfr_built: 0
    l2_xfree((cast: (@: void) l2_dyr_m))
    l2_dyr_m: 0
    l2_xfree((cast: (@: void) l2_dyr_at))
    l2_dyr_at: 0
    l2_xfree((cast: (@: void) l2_dyr_c))
    l2_dyr_c: 0
    l2_xfree((cast: (@: void) l2_dyr_hard))
    l2_dyr_hard: 0
    l2_xfree((cast: (@: void) l2_dyc_t))
    l2_dyc_t: 0
    l2_xfree((cast: (@: void) l2_dyc_a))
    l2_dyc_a: 0
    l2_xfree((cast: (@: void) l2_dys_t))
    l2_dys_t: 0
    l2_xfree((cast: (@: void) l2_dys_a))
    l2_dys_a: 0
    l2_xfree((cast: (@: void) l2_cfl_node))
    l2_cfl_node: 0
    l2_xfree((cast: (@: void) l2_dyr_nm))
    l2_dyr_nm: 0
    l2_cfl_n: 0
    l2_cfl_cap: 0
    l2_cfr_n: 0
    l2_cfr_cap: 0
    l2_dyr_n: 0
    l2_dyr_cap: 0
    l2_dyc_n: 0
    l2_dyc_cap: 0
    l2_dys_cap: 0
return: 0

fn: l2_cfl_note (int: callee; int: caller; int: caller_fi; int: t; int: kind; int: a; int: a_fi; const: @(LmP0Node at)) int
    int: i 0
    int: via 0 - 1
    int: via_fi 0 - 1
    if: caller_fi >= 0
        via: caller
        via_fi: caller_fi
    ---
    while: i < l2_cfl_n
        if: l2_cfl_callee[i] = callee && l2_cfl_via[i] = via && l2_cfl_via_fi[i] = via_fi && l2_cfl_t[i] = t && l2_cfl_kind[i] = kind && l2_cfl_a[i] = a && l2_cfl_a_fi[i] = a_fi && l2_cfl_node[i] = at
            return: 0
        i: i + 1
    ---
    if: l2_cfl_reserve() != 0
        return: l2_alloc_or(l2_src, at, "out of memory")
    l2_cfl_node[l2_cfl_n]: (cast: (@: LmP0Node) at)
    l2_cfl_callee[l2_cfl_n]: callee
    l2_cfl_via[l2_cfl_n]: via
    l2_cfl_via_fi[l2_cfl_n]: via_fi
    l2_cfl_t[l2_cfl_n]: t
    l2_cfl_kind[l2_cfl_n]: kind
    l2_cfl_a[l2_cfl_n]: a
    l2_cfl_a_fi[l2_cfl_n]: a_fi
    l2_cfl_n: l2_cfl_n + 1
return: 0

fn: l2_cfr_has (int: c; int: t; int: m) int
    int: i 0
    while: i < l2_cfr_n
        if: l2_cfr_c[i] = c && l2_cfr_t[i] = t && l2_cfr_m[i] = m
            return: 1
        i: i + 1
    ---
return: 0

# Method m reaches formal t of consumer c.  built: as a node made when the program runs -- by the return of the
# method that holds a definition, or by a merge -- and not as the one occurrence the unit has of m.  One row
# says both when both happen.
fn: l2_cfr_add (int: c; int: t; int: m; int: built; @: int changed) int
    int: i 0
    if: c < 0
        return: 0
    while: i < l2_cfr_n
        if: l2_cfr_c[i] = c && l2_cfr_t[i] = t && l2_cfr_m[i] = m
            if: built != 0 && l2_cfr_built[i] = 0
                l2_cfr_built[i]: 1
                \changed: 1
            ---
            return: 0
        i: i + 1
    ---
    if: l2_cfr_reserve() != 0
        return: l2_alloc_or(l2_src, 0, "out of memory")
    l2_cfr_c[l2_cfr_n]: c
    l2_cfr_t[l2_cfr_n]: t
    l2_cfr_m[l2_cfr_n]: m
    l2_cfr_built[l2_cfr_n]: built
    l2_cfr_n: l2_cfr_n + 1
    \changed: 1
return: 0

# Whether a node built when the program runs reaches formal t of consumer c.
fn: l2_cfr_any_built (int: c; int: t) int
    int: i 0
    while: i < l2_cfr_n
        if: l2_cfr_c[i] = c && l2_cfr_t[i] = t && l2_cfr_m[i] >= 0 && l2_cfr_built[i] != 0
            return: 1
        i: i + 1
    ---
return: 0

# What fact f brings to its formal of consumer c.  A method named (1) is the unit's occurrence of it.  A held
# name (4) is a node of its model, and a merge given as the actual (5) a node the merge builds of its model:
# each is formed as its model is and is no occurrence of the unit.
fn: l2_cfl_bring (int: f; int: c; @: int changed) int
    int: j 0
    int: n
    if: l2_cfl_kind[f] = 1
        return: l2_cfr_add(c, l2_cfl_t[f], l2_cfl_a[f], 0, changed)
    if: l2_cfl_kind[f] = 4 || l2_cfl_kind[f] = 5
        return: l2_cfr_add(c, l2_cfl_t[f], l2_cfl_a[f], 1, changed)
    if: l2_cfl_kind[f] = 3
        return: l2_cfr_add(c, l2_cfl_t[f], 0 - 1, 0, changed)
    # A formal handed on: whatever reaches it, an unfollowed occurrence included.  The table may grow under
    # the loop; its first n rows serve this round, and the closure repeats until nothing is added.
    n: l2_cfr_n
    while: j < n
        if: l2_cfr_c[j] = l2_cfl_a[f] && l2_cfr_t[j] = l2_cfl_a_fi[f] && l2_cfr_add(c, l2_cfl_t[f], l2_cfr_m[j], l2_cfr_built[j], changed) != 0
            return: 1
        j: j + 1
    ---
return: 0

# The closure of the facts: finite, each round only adds rows.
fn: l2_cfl_close () int
    int: changed 1
    int: f
    int: j
    int: n
    # A library unit exports a wrapper for every method (l2_emit_library_wrappers), so every callable formal of
    # the unit can receive an occurrence from another translation: an ingress this one does not follow.
    if: l2_library_mode != 0
        f: 0
        while: f < l2_m_n
            j: 0
            while: j < l2_m_arity[f]
                if: l2_cf_get(f, j) >= 0 && l2_cfr_add(f, j, 0 - 1, 0, @ changed) != 0
                    return: 1
                j: j + 1
            ---
            f: f + 1
        ---
    ---
    while: changed != 0
        changed: 0
        f: 0
        while: f < l2_cfl_n
            if: l2_cfl_via[f] < 0
                if: l2_cfl_bring(f, l2_cfl_callee[f], @ changed) != 0
                    return: 1
                ---
            else:
                # The callee is the value of a formal: each method that reaches that formal is a consumer.
                j: 0
                n: l2_cfr_n
                while: j < n
                    if: l2_cfr_c[j] = l2_cfl_via[f] && l2_cfr_t[j] = l2_cfl_via_fi[f] && l2_cfr_m[j] >= 0 && l2_cfl_bring(f, l2_cfr_m[j], @ changed) != 0
                        return: 1
                    j: j + 1
                ---
            ---
            f: f + 1
        ---
    ---
return: 0

# The methods that reach formal t of consumer c: how many, and the k-th.
fn: l2_cfl_count (int: c; int: t) int
    int: i 0
    int: n 0
    while: i < l2_cfr_n
        if: l2_cfr_c[i] = c && l2_cfr_t[i] = t && l2_cfr_m[i] >= 0
            n: n + 1
        i: i + 1
    ---
return: n

fn: l2_cfl_at (int: c; int: t; int: k) int
    int: i 0
    while: i < l2_cfr_n
        if: l2_cfr_c[i] = c && l2_cfr_t[i] = t && l2_cfr_m[i] >= 0
            if: k = 0
                return: l2_cfr_m[i]
            k: k - 1
        ---
        i: i + 1
    ---
return: 0 - 1

# Whether methods a and b form their hidden inputs alike: the same free names in the same order, of the
# same types and the same receiving schemas.  One formation then serves both.  Their lexical declarations may
# differ: an input no caller binds is handed absent and each method reads its own (K04 S2).  Their declared
# formals, result and exits are those of the one contract each was admitted to (l2_method_sig_compatible), so
# they are not compared again here.
fn: l2_cfl_alike (int: a; int: b) int
    int: k 0
    if: a = b
        return: 1
    if: l2_m_dyn[a] != l2_m_dyn[b]
        return: 0
    while: k < l2_m_dyn[a]
        if: l2_text_same(l2_dn(a, k), l2_dn(b, k)) = 0 || l2_dt(a, k) != l2_dt(b, k)
            return: 0
        if: l2_cap_arg_ns(a, l2_m_arity[a] + k) != l2_cap_arg_ns(b, l2_m_arity[b] + k) || l2_input_schema(a, l2_m_arity[a] + k) != l2_input_schema(b, l2_m_arity[b] + k)
            return: 0
        k: k + 1
    ---
return: l2_cfl_recv_alike(a, b)

# Whether methods a and b receive formal t alike: the same model and schema, read in the same kind of space
# (the same lexical-edge depth). A formal no named Structure types on either side has nothing to admit. An emission decision
# (which admission a class emits), no equality of types: a candidate may be admitted to either model.
fn: l2_cfl_formal_alike (int: a; int: b; int: t) int
    int: da
    int: db
    if: a = b
        return: 1
    if: l2_nsty_get(a, t) < 0 && l2_nsty_get(b, t) < 0
        return: 1
    if: l2_input_model(a, t) != l2_input_model(b, t) || l2_input_schema(a, t) != l2_input_schema(b, t)
        return: 0
    da: l2_lex_depth_at(a, l2_e, 0)
    db: l2_lex_depth_at(b, l2_e, 0)
    if: da < 0 || db < 0
        return: 0
return: (cast: (int) (da = db))

# Whether methods a and b, formed alike, have one receiving contract where they admit anything: every declared
# Structure formal alike (l2_cfl_formal_alike), and the same space for the free inputs they admit (l2_free_admits).
# Methods that admit nothing -- number inputs only -- stay one class whatever space their bodies read.
fn: l2_cfl_recv_alike (int: a; int: b) int
    int: j 0
    int: da
    int: db
    if: a = b
        return: 1
    while: j < l2_m_arity[a] && j < l2_m_arity[b]
        if: l2_cfl_formal_alike(a, b, j) = 0
            return: 0
        j: j + 1
    ---
    if: l2_free_admits(a) != 0 || l2_free_admits(b) != 0
        da: l2_lex_depth_at(a, l2_e, 0)
        db: l2_lex_depth_at(b, l2_e, 0)
        if: da < 0 || db < 0 || da != db
            return: 0
        ---
    ---
return: 1

# The class of reaching method m at formal t of consumer c: the first method that reaches the formal and
# forms its hidden inputs as m does (l2_cfl_alike).
fn: l2_cfl_class_of (int: c; int: t; int: m) int
    int: n l2_cfl_count(c, t)
    int: i 0
    while: i < n
        if: l2_cfl_alike(l2_cfl_at(c, t, i), m) != 0
            return: l2_cfl_at(c, t, i)
        i: i + 1
    ---
return: m

# A held callable's call in method mi gives hidden input k of its model nothing: this caller has no binding of
# the name, and a held call asks only its own caller.  The model's readers then resolve the name, each from its
# own source.  Where one of them has none (need 2) the call cannot be entered.  From the root nothing more can
# give the name: the ordinary refusal.  From a method, its callers may bind it; a held call does not ask them
# yet: a limit of this implementation, said where the call stands.
fn: l2_held_unbound (const: @(LmP0Node node); int: mi; int: model; int: k) int
    int: need
    @: LmP0Text nm
    nm: l2_dn(model, k)
    need: l2_site_needs(mi, node, 0 - 1, model, k, 0, 0, l2_src)
    if: need < 0
        return: 1
    if: need != 2 || nm = 0
        return: 0
    if: mi != l2_e
        return: l2_error(l2_src, node, "a name a held callable requires is not asked of this method's callers yet")
return: l2_error_name(l2_src, node, "unbound dynamic input ", nm\data, nm\length, "")

# How many classes of formation reach formal t of consumer c.  0 when no flow of this translation reaches the
# formal: the definition is dormant, asks nothing of anyone and its call forms no hidden input.  One class is
# formed as it is.  More than one is selected by exact occurrence (l2_emit_call_classes).  The list of the
# method that declares the formal is used by no path.  Where an occurrence the translation does not follow
# reaches the formal (an ingress from another translation, recorded by l2_cfl_close) the call is refused
# where it stands, and so is a call that would have to tell a node built when the program runs from a
# callable formed differently: limits of this implementation and no rules of the language.
fn: l2_cfl_classes (int: c; int: t; const: @(LmP0Node at); @: int out) int
    int: n
    int: i 0
    int: k 0
    \out: 0
    if: l2_cfr_has(c, t, 0 - 1) != 0
        return: l2_error(l2_src, at, "a call through a callable formal that receives a callable this translation does not follow is not built yet")
    n: l2_cfl_count(c, t)
    while: i < n
        if: l2_lex_depth_at(l2_cfl_at(c, t, i), l2_e, 0) < 0
            return: l2_error(l2_src, at, "a callable formation has no resolved receiving unit before source placement")
        if: l2_cfl_class_of(c, t, l2_cfl_at(c, t, i)) = l2_cfl_at(c, t, i)
            k: k + 1
        i: i + 1
    ---
    # K04 S3: a node built when the program runs is no occurrence of the unit; telling its class from
    # another's where the formal is called is not built yet.
    if: k > 1 && l2_cfr_any_built(c, t) != 0
        return: l2_error(l2_src, at, "a call through a callable formal that receives a callable built at run time among callables formed differently is not built yet")
    \out: k
return: 0

# Class keys are formed before PLACE. Validate the same method-edge relation
# once physical places have committed, without a runtime map or phase fallback.
fn: l2_cfl_receiving_validate () int
    int: i 0
    int: mi
    int: depth
    while: i < l2_cfr_n
        mi: l2_cfr_m[i]
        if: mi >= 0
            depth: l2_lex_depth_at(mi, l2_e, 0)
            if: depth >= 0 && depth != l2_lex_depth(mi, l2_e)
                return: l2_error(l2_method_src(mi, l2_src), l2_m_node[mi], "internal: a receiving class changed its lexical projection after source placement")
            ---
        ---
        i: i + 1
    ---
return: 0

# The fact of the call at `node` for formal t: the call is of method x, or goes through method m's formal fi.
# Its row, or -1.
fn: l2_cfl_site_fact (const: @(LmP0Node node); int: m; int: fi; int: x; int: t) int
    int: f 0
    while: f < l2_cfl_n
        if: l2_cfl_node[f] = node && l2_cfl_t[f] = t && ((fi < 0 && l2_cfl_via[f] < 0 && l2_cfl_callee[f] = x) || (fi >= 0 && l2_cfl_via[f] = m && l2_cfl_via_fi[f] = fi))
            return: f
        f: f + 1
    ---
return: 0 - 1

fn: l2_anc_reserve () int
    int: cap
    size_t: isz
    size_t: psz
    @: void p
    if: l2_anc_n < l2_anc_cap
        return: 0
    cap: l2_cap_next(l2_anc_cap, l2_anc_n + 1)
    if: cap < 0
        l2_alloc_err: 2
        return: 1
    isz: c.sizeof(c.int)
    psz: c.sizeof(@: char)
    p: l2_vec_grow((cast: (@: void) l2_anc_m), l2_anc_n, cap, isz)
    if: p = 0
        return: 1
    l2_anc_m: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_anc_nm), l2_anc_n, cap, psz)
    if: p = 0
        return: 1
    l2_anc_nm: (cast: (@@: LmP0Text) p)
    p: l2_vec_grow((cast: (@: void) l2_anc_ns), l2_anc_n, cap, isz)
    if: p = 0
        return: 1
    l2_anc_ns: (cast: (@: int) p)
    l2_anc_cap: cap
return: 0

# The row of hidden input nm of method m, or -1.
fn: l2_anc_row (int: m; const: @(LmP0Text nm)) int
    int: r 0
    if: nm = 0
        return: 0 - 1
    while: r < l2_anc_n
        if: l2_anc_m[r] = m && l2_text_same(l2_anc_nm[r], nm) != 0
            return: r
        r: r + 1
    ---
return: 0 - 1

# The coordinate space of hidden input nm of method m (l2_anchor_close), or -1: no row, or none established, or
# the rows are not made yet.
fn: l2_anchor_of (int: m; const: @(LmP0Text nm)) int
    int: r
    if: l2_anc_on = 0
        return: 0 - 1
    r: l2_anc_row(m, nm)
    if: r < 0 || l2_anc_ns[r] < 0
        return: 0 - 1
return: l2_anc_ns[r]

# Whether no coordinate space is established for hidden input nm of method m because the declarations that
# reach it, each having every path the method uses, disagree in one of them.
fn: l2_anchor_differ (int: m; const: @(LmP0Text nm)) int
    int: r
    if: l2_anc_on = 0
        return: 0
    r: l2_anc_row(m, nm)
return: (cast: (int) (r >= 0 && l2_anc_ns[r] = -2))

# A path through input j of method mi, where j is a free name that nothing in mi's sight declares and no
# coordinate space is established for its paths: refused where the path stands, with which of the two it is --
# the declarations that reach the name give a used field different types, or none of them is known to give the
# fields.  Both are limits of this implementation.  0 where j is no such input.  The expression pass would copy
# the path verbatim.
fn: l2_free_path_refused (int: mi; int: j; const: @(char path); const: @(LmP0Node at)) int
    if: mi < 0 || mi >= l2_m_n || mi = l2_e || j < l2_m_arity[mi] || l2_input_undeclared(mi, j) = 0
        return: 0
    if: l2_dt(mi, j - l2_m_arity[mi]) != l2_graph_dt() || l2_input_schema(mi, j) != -1
        return: 0
    if: l2_anchor_differ(mi, l2_input_name(mi, j)) != 0
        return: l2_error(path, at, "the declarations reaching a free name give a field the method uses different types; reading it by conversion is not built yet")
return: l2_error(path, at, "a path through a free name that no declaration reaching it gives its fields to is not built yet")

# The named declaration whose layout the Structure own field `own` holds has, where `own` is the result of a merge
# of one Structure: that operand's.  -1 otherwise.  A place's own declaration -- a typed reference's, a formal's
# -- is not taken: what the place holds was given to it, and what is given is followed (l2_anchor_reach).
fn: l2_anchor_own_layout (int: own) int
    int: res
    int: ly
    @: L2ReferenceSource source
    if: own < 0 || own >= l2_own_n || l2_mres_source = 0
        return: 0 - 1
    res: l2_mres_of_own(own)
    if: res < 0
        return: 0 - 1
    source: @ l2_mres_source[res]
    ly: source\layout
    if: ly != -1 && l2_schema_kind(ly) = 1
        return: ly
return: 0 - 1

# One more named declaration among the candidates (set, of *n).  The set has room for every named declaration
# of the unit (l2_anchor_close), and each is in it once.
sub: l2_anchor_add (@: int set; @: int n; int: ns)
    int: i 0
    if: ns < 0
        return
    while: i < \n
        if: set[i] = ns
            return
        i: i + 1
    ---
    set[\n]: ns
    \n: \n + 1
end: l2_anchor_add

# The named declarations that reach place key of method mi: what a merge makes in its own field, what a site
# records for it, and what reaches every place handed on to it -- the edges the fixed point recorded
# (l2_d105_edge), followed against their direction.  seen_m/seen_k are the places reached, in the order they are
# met, and the list of work: each is visited once, so a cycle of methods that hand the name to one another ends.
# A place joins the list as the giving end of an edge, so the edges and the place asked about bound it
# (l2_anchor_close gives that room).
sub: l2_anchor_reach (int: mi; int: key; @: int set; @: int n; @: int seen_m; @: int seen_k)
    int: at 0
    int: seen_n 1
    int: i
    int: e
    int: j
    seen_m[0]: mi
    seen_k[0]: key
    while: at < seen_n
        mi: seen_m[at]
        key: seen_k[at]
        if: l2_d105_key_own(key) >= 0
            l2_anchor_add(set, n, l2_anchor_own_layout(l2_d105_key_own(key)))
        # The declaration of a typed reference that hands the name on is a coordinate witness of the paths too
        # (Codex, FABLE-CODEX-20261004-12, the twenty-first reply Q3): what the reference holds was admitted to that
        # declaration, and the admission where the reader's input is formed asks the held value's own record when
        # the program runs.  The declaration proves nothing about the value by itself.
        if: l2_d105_key_own(key) >= 0 && l2_own_is_slot(l2_d105_key_own(key)) = 0 && l2_schema_kind(l2_own_nsty_get(l2_d105_key_own(key))) = 1
            l2_anchor_add(set, n, l2_own_nsty_get(l2_d105_key_own(key)))
        i: 0
        while: i < l2_d105s_n
            if: l2_d105s_mi[i] = mi && l2_d105s_k[i] = key && l2_schema_kind(l2_d105s_ty[i]) = 1
                l2_anchor_add(set, n, l2_d105s_ty[i])
            i: i + 1
        ---
        e: 0
        while: e < l2_d105e_n
            if: l2_d105e_tmi[e] = mi && l2_d105e_tk[e] = key && l2_d105e_fmi[e] >= 0
                j: 0
                while: j < seen_n && (seen_m[j] != l2_d105e_fmi[e] || seen_k[j] != l2_d105e_fk[e])
                    j: j + 1
                if: j = seen_n
                    seen_m[seen_n]: l2_d105e_fmi[e]
                    seen_k[seen_n]: l2_d105e_fk[e]
                    seen_n: seen_n + 1
                ---
            e: e + 1
        ---
        at: at + 1
    ---
end: l2_anchor_reach

# Whether declaration ns has every path of the uses just collected (l2_uses_walk_frame), each to its end.
fn: l2_anchor_covers (int: ns) int
    size_t: off 0U
    @: char slot
    size_t: n
    size_t: at
    size_t: cut
    int: si
    int: occurrence
    size_t: name_at
    LmP0Text: name
    L2SchemaField: meta
    if: ns < 0 || l2_uses_buf = 0
        return: 0
    while: off < (cast: (size_t) l2_uses_len)
        slot: l2_uses_buf + off
        n: strlen(slot)
        si: ns
        at: 0U
        while: at < n
            cut: at
            while: cut < n && slot[cut] != 92
                cut: cut + 1U
            if: cut = at || si < 0
                return: 0
            occurrence: -1
            name_at: 0U
            if: slot[at] = 91
                occurrence: 0
                name_at: 1U
                while: name_at < cut - at && slot[at + name_at] >= 48 && slot[at + name_at] <= 57
                    occurrence: occurrence * 10 + (cast: (int) (slot[at + name_at] - 48))
                    name_at: name_at + 1U
                if: name_at >= cut - at || slot[at + name_at] != 93
                    return: 0
                name_at: name_at + 1U
            name.data: slot + at + name_at
            name.length: cut - at - name_at
            if: l2_schema_named_meta(si, @ name, occurrence, @ meta) < 0
                return: 0
            si: 0 - 1
            if: cut < n
                if: (meta.kind != 2 && meta.kind != 3) || meta.model < 0
                    return: 0
                si: meta.model
            ---
            at: cut + 1U
        ---
        off: off + n + 1U
    ---
return: 1

# The fixed point has closed which names each method needs and what each site hands.  For every hidden input
# that nothing in its method's sight declares and through which the method reads a path, find the coordinate
# space of those paths: among the named declarations that reach the input, one that has every path the method
# uses.  Every such declaration serves alike -- a candidate is admitted to it by the method's uses only, as to a
# declared requirement, so what is accepted and what is read do not depend on which one is taken; the first in
# the unit's order is.  That holds while the declarations that have every path agree in each: the admission of
# one to another by those paths is then the same either way.  Where two of them disagree -- a field the method
# reads is a number of one type in one and of another type in the other -- none is the coordinate space, and
# the row says so (-2): to take the first would refuse the second by the first's type, and the other order
# would refuse the other.  That refusal is a limit: what the method consumes at the read decides, and a field of
# another type is to be read at its own type and converted there (the receiving-edge conversion, not built).
# A declaration that reaches the input and has not a path the method uses is no
# coordinate space, and is refused where it is handed, by the ordinary admission.  Where none is established
# the path is refused where it stands (l2_check_fields, l2_check_path_write).
# The fixed point runs again after the waited checks (l2_wait_run): the rows are found again, and a coordinate
# space a checked path relied on cannot be lost.
fn: l2_anchor_close () int
    @: int set 0
    @: int seen_m 0
    @: int seen_k 0
    int: n
    int: m 0
    int: k
    int: i
    int: best
    int: row
    int: same
    int: was l2_anc_on
    int: status 0
    size_t: isz
    @: LmP0Text nm
    l2_anc_on: 0
    # The room of one search, from the program itself: a candidate is a named declaration of the unit, each once;
    # a place reached is the place asked about or the giving end of a recorded edge.  No count is assumed.
    isz: c.sizeof(c.int)
    if: l2_mul_ok((cast: (size_t) l2_ns_n) + 1U, isz) = 0 || l2_mul_ok((cast: (size_t) l2_d105e_n) + 1U, isz) = 0
        l2_alloc_err: 2
        return: l2_alloc_or(l2_src, 0, "out of memory")
    l2_alloc_kind: 5
    set: (cast: (@: int) l2_xmalloc(((cast: (size_t) l2_ns_n) + 1U) * isz))
    seen_m: (cast: (@: int) l2_xmalloc(((cast: (size_t) l2_d105e_n) + 1U) * isz))
    seen_k: (cast: (@: int) l2_xmalloc(((cast: (size_t) l2_d105e_n) + 1U) * isz))
    if: set = 0 || seen_m = 0 || seen_k = 0
        status: l2_alloc_or(l2_src, 0, "out of memory")
    while: status = 0 && m < l2_m_n
        k: 0
        while: status = 0 && m != l2_e && k < l2_m_dyn[m]
            nm: l2_dn(m, k)
            if: nm = 0 || l2_dt(m, k) != l2_graph_dt() || l2_input_undeclared(m, l2_m_arity[m] + k) = 0 || l2_m_consumer(m) = 0
                k: k + 1
                continue
            l2_uses_reset()
            if: l2_uses_walk_method(nm, m) != 0 || l2_uses_oom != 0
                l2_uses_reset()
                status: l2_alloc_or(l2_src, l2_m_node[m], "out of memory")
                continue
            # A name the method only hands on has no path of its own: it needs no coordinate space.
            if: l2_uses_len = 0
                l2_uses_reset()
                k: k + 1
                continue
            n: 0
            best: 0 - 1
            l2_anchor_reach(m, l2_m_arity[m] + k, set, @ n, seen_m, seen_k)
            i: 0
            while: i < n
                if: (best < 0 || set[i] < best) && l2_anchor_covers(set[i]) != 0
                    best: set[i]
                i: i + 1
            ---
            i: 0
            while: best >= 0 && i < n
                if: set[i] != best && l2_anchor_covers(set[i]) != 0
                    same: 0
                    if: l2_descriptor_used(set[i], best, @ same) != 0 || same = 0
                        best: 0 - 2
                    ---
                i: i + 1
            ---
            l2_uses_reset()
            row: l2_anc_row(m, nm)
            if: row < 0
                if: l2_anc_reserve() != 0
                    status: l2_alloc_or(l2_src, l2_m_node[m], "out of memory")
                    continue
                row: l2_anc_n
                l2_anc_m[row]: m
                l2_anc_nm[row]: nm
                l2_anc_ns[row]: best
                l2_anc_n: l2_anc_n + 1
            else:
                if: was != 0 && l2_anc_ns[row] >= 0 && best < 0
                    status: l2_error(l2_src, l2_m_node[m], "internal: the coordinate space of a free name was lost after its paths were checked")
                    continue
                l2_anc_ns[row]: best
            ---
            k: k + 1
        ---
        m: m + 1
    ---
    l2_xfree((cast: (@: void) set))
    l2_xfree((cast: (@: void) seen_m))
    l2_xfree((cast: (@: void) seen_k))
    if: status != 0
        return: status
    l2_anc_on: 1
return: 0

# Whether some call of method m can hand a value for name nm (K04 S3).  A library unit's methods are called
# from other translations, which may bind anything.
fn: l2_dyp_has (int: m; const: @(LmP0Text nm)) int
    int: r 0
    if: l2_library_mode != 0
        return: 1
    while: r < l2_dyp_n
        if: l2_dyp_m[r] = m && l2_text_same(l2_dyp_nm[r], nm) != 0
            return: 1
        r: r + 1
    ---
return: 0

fn: l2_dyp_mark (int: m; const: @(LmP0Text nm); @: int changed) int
    if: m < 0 || m >= l2_m_n || nm = 0 || l2_dyp_has(m, nm) != 0
        return: 0
    if: l2_dyp_reserve() != 0
        return: l2_alloc_or(l2_src, 0, "out of memory")
    l2_dyp_m[l2_dyp_n]: m
    l2_dyp_nm[l2_dyp_n]: (cast: (@: LmP0Text) nm)
    l2_dyp_n: l2_dyp_n + 1
    if: changed != 0
        \changed: 1
return: 0

# HELD-FREE-NAME-OTHER-TYPE: method m gained input nm only to hand it to a held definition that reads it as type ty
# (l2_dyn_site_held); the input itself has no type until a caller's binding gives it one.
fn: l2_dyk_note (int: m; const: @(LmP0Text nm); int: ty) int
    int: cap
    int: r 0
    size_t: isz
    size_t: psz
    @: void p
    while: r < l2_dyk_n
        if: l2_dyk_m[r] = m && l2_text_same(l2_dyk_nm[r], nm) != 0
            return: 0
        r: r + 1
    ---
    if: l2_dyk_n >= l2_dyk_cap
        cap: l2_cap_next(l2_dyk_cap, l2_dyk_n + 1)
        if: cap < 0
            l2_alloc_err: 2
            return: 1
        isz: c.sizeof(c.int)
        psz: c.sizeof(@: char)
        p: l2_vec_grow((cast: (@: void) l2_dyk_m), l2_dyk_n, cap, isz)
        if: p = 0
            return: 1
        l2_dyk_m: (cast: (@: int) p)
        p: l2_vec_grow((cast: (@: void) l2_dyk_nm), l2_dyk_n, cap, psz)
        if: p = 0
            return: 1
        l2_dyk_nm: (cast: (@@: LmP0Text) p)
        p: l2_vec_grow((cast: (@: void) l2_dyk_ty), l2_dyk_n, cap, isz)
        if: p = 0
            return: 1
        l2_dyk_ty: (cast: (@: int) p)
        l2_dyk_cap: cap
    ---
    l2_dyk_m[l2_dyk_n]: m
    l2_dyk_nm[l2_dyk_n]: (cast: (@: LmP0Text) nm)
    l2_dyk_ty[l2_dyk_n]: ty
    l2_dyk_n: l2_dyk_n + 1
return: 0

# The inputs l2_dyk_note recorded that no binding has typed take the type of the model that asked them.  None of
# them can arrive present: a present value comes from a binding, and a binding types the input it reaches.  So the
# type carries nothing; it is what their entries and the methods that hand them on are written with.
fn: l2_dyk_close (@: int changed) int
    int: r 0
    int: k
    while: r < l2_dyk_n
        k: l2_dyn_find(l2_dyk_m[r], l2_dyk_nm[r])
        if: k >= 0 && l2_dt(l2_dyk_m[r], k) = 0
            if: l2_dt_set(l2_dyk_m[r], k, l2_dyk_ty[r]) != 0
                return: 1
            \changed: 1
        ---
        r: r + 1
    ---
return: 0

# A held call in method mi whose model requires name k as another type than the input of that name mi hands
# on, where that input can never arrive present: no caller of mi, up the chain, has a value to give.  Nothing
# then reaches the model for the name, and its readers resolve it.  Where the input can be present its value
# would have to be converted to the model's type, which is not built: the caller's binding is refused as one of
# another type, as before.
fn: l2_held_never (int: mi; int: model; int: k) int
    @: LmP0Text nm
    int: pi
    if: mi < 0 || mi = l2_e || model < 0 || k < 0 || k >= l2_m_dyn[model]
        return: 0
    nm: l2_dn(model, k)
    if: nm = 0 || l2_cap_arg_ns(model, l2_m_arity[model] + k) >= 0
        return: 0
    pi: l2_param_find(mi, nm)
    if: pi < l2_m_arity[mi] || l2_dyn_fwd(mi, pi - l2_m_arity[mi]) = 0 || l2_formal_row(mi, pi) >= 0
        return: 0
    if: l2_own_ty_of_param(l2_input_ft(mi, pi)) = l2_own_of_dt(l2_dt(model, k))
        return: 0
return: (cast: (int) (l2_dyp_has(mi, nm) = 0))

# Whether method x has a recorded reason for name nm.
fn: l2_dyr_any (int: x; const: @(LmP0Text nm)) int
    int: r 0
    while: r < l2_dyr_n
        if: l2_dyr_m[r] = x && l2_text_same(l2_dyr_nm[r], nm) != 0
            return: 1
        r: r + 1
    ---
return: 0

# One reason method m needs name nm: the n conditions standing in the row being formed (l2_dys_*), none for
# always; hard as given.  The conditions are put in the order of their formals.  A row already there whose
# conditions are among the new one's, and which is hard if the new one is, says all the new one would.
fn: l2_dyr_add (int: m; const: @(LmP0Text nm); int: n; int: hard; @: int changed) int
    int: r 0
    int: i 1
    int: j
    int: e
    int: sw
    int: within
    if: m < 0 || m >= l2_m_n || m = l2_e || nm = 0 || n < 0
        return: 0
    while: i < n
        j: i
        while: j > 0 && l2_dys_t[j - 1] > l2_dys_t[j]
            sw: l2_dys_t[j]
            l2_dys_t[j]: l2_dys_t[j - 1]
            l2_dys_t[j - 1]: sw
            sw: l2_dys_a[j]
            l2_dys_a[j]: l2_dys_a[j - 1]
            l2_dys_a[j - 1]: sw
            j: j - 1
        ---
        i: i + 1
    ---
    while: r < l2_dyr_n
        if: l2_dyr_m[r] = m && l2_dyr_c[r] <= n && (hard = 0 || l2_dyr_hard[r] != 0) && l2_text_same(l2_dyr_nm[r], nm) != 0
            within: 1
            e: 0
            j: 0
            while: within != 0 && e < l2_dyr_c[r]
                while: j < n && l2_dys_t[j] < l2_dyc_t[l2_dyr_at[r] + e]
                    j: j + 1
                ---
                if: j >= n || l2_dys_t[j] != l2_dyc_t[l2_dyr_at[r] + e] || l2_dys_a[j] != l2_dyc_a[l2_dyr_at[r] + e]
                    within: 0
                e: e + 1
            ---
            if: within != 0
                return: 0
            ---
        r: r + 1
    ---
    if: l2_dyr_reserve() != 0 || l2_dyc_reserve(l2_dyc_n + n) != 0
        return: l2_alloc_or(l2_src, 0, "out of memory")
    l2_dyr_m[l2_dyr_n]: m
    l2_dyr_nm[l2_dyr_n]: (cast: (@: LmP0Text) nm)
    l2_dyr_at[l2_dyr_n]: l2_dyc_n
    l2_dyr_c[l2_dyr_n]: n
    l2_dyr_hard[l2_dyr_n]: hard
    j: 0
    while: j < n
        l2_dyc_t[l2_dyc_n]: l2_dys_t[j]
        l2_dyc_a[l2_dyc_n]: l2_dys_a[j]
        l2_dyc_n: l2_dyc_n + 1
        j: j + 1
    ---
    l2_dyr_n: l2_dyr_n + 1
    if: changed != 0
        \changed: 1
return: 0

# Whether the actual the call at `node` in method m gives formal t is method a: 1 it is or can be, 0 the flow
# proves it is not, 2 not known.  The call is of method x, or goes through m's formal fi and x reaches that
# formal.  A named unit method decides it.  The caller's own formal handed on can be whatever reaches that
# formal, and \via_fi names it: the condition goes on as one on m.  No fact of this site, or an occurrence the
# translation does not follow: not known.
fn: l2_site_denotes (int: m; const: @(LmP0Node node); int: fi; int: x; int: t; int: a; @: int via_fi) int
    int: f
    \via_fi: 0 - 1
    f: l2_cfl_site_fact(node, m, fi, x, t)
    if: f < 0
        return: 2
    if: l2_cfl_kind[f] = 1 || l2_cfl_kind[f] = 4 || l2_cfl_kind[f] = 5
        return: (cast: (int) (l2_cfl_a[f] = a))
    if: l2_cfl_kind[f] = 2 && l2_cfl_a[f] = m
        if: l2_cfr_has(m, l2_cfl_a_fi[f], 0 - 1) != 0
            return: 2
        if: l2_cfr_has(m, l2_cfl_a_fi[f], a) = 0
            return: 0
        \via_fi: l2_cfl_a_fi[f]
        return: 1
return: 2

# Whether method x, which reads its free name k, has a source of its own for it when no caller gives it: a
# field of the unit it sees (l2_own_lexical), or, for a definition inside a method, a name of the host's body
# kept in the node the host's return builds (the fallback of its ARG, l2_rw_arg_fb).
fn: l2_reader_source (int: x; int: k) int
    @: LmP0Text nm
    int: slot 0 - 1
    int: kind 0 - 1
    int: ent 0 - 1
    nm: l2_dn(x, k)
    if: nm = 0
        return: 0
    if: l2_own_lexical(x, nm) >= 0
        return: 1
    if: l2_mad_host_of(x) >= 0 && nm\data != 0 && l2_node_seg_meta(x, nm\data, 0U, nm\length, @ slot, @ kind, @ ent, 0) = 0
        return: 1
return: 0

# Whether the call at `node` in method m needs hidden input k of method x: x is the callee, or reaches m's
# formal fi when the call goes through it.  0 not needed: the entry is handed absent and the caller is asked
# nothing.  1 needed.  2 needed and hard: an absent entry would reach a method that reads the name and has no
# lexical source of its own, so a caller with nothing to give makes the call inadmissible.  -1: said -- a
# limit of this implementation, where what the site's callable is cannot be told.
# An input x reads is x's own requirement, and so is one no site gave x.  An input x only forwards is needed
# when one of x's reasons holds for this site's actuals.  With add != 0 the reasons m then has for the name are
# recorded: m hands it on from its own input.
fn: l2_site_needs (int: m; const: @(LmP0Node node); int: fi; int: x; int: k; int: add; @: int changed; const: @(char path)) int
    int: r 0
    int: j
    int: d
    int: n
    int: n0 0
    int: ok
    int: unk
    int: vf
    int: dn
    int: need 0
    int: unknown 0
    int: ty
    int: hard
    int: room 2
    @: LmP0Text nm
    if: x < 0 || x >= l2_m_n || k < 0 || k >= l2_m_dyn[x]
        return: 1
    nm: l2_dn(x, k)
    ty: l2_dt(x, k)
    # A row has one condition for a formal of m, and m has l2_m_arity[m] formals.
    if: m >= 0 && m < l2_m_n
        room: l2_m_arity[m] + 2
    if: l2_dys_reserve(room) != 0
        l2_alloc_or(path, node, "out of memory")
        return: 0 - 1
    # A call through m's formal fi reaches x only while that formal holds x.
    if: fi >= 0
        l2_dys_t[0]: fi
        l2_dys_a[0]: x
        n0: 1
    ---
    if: x = l2_e || l2_dyn_reads(x, k) != 0 || l2_dyr_any(x, nm) = 0
        hard: (cast: (int) (l2_reader_source(x, k) = 0))
        if: add != 0 && l2_dyr_add(m, nm, n0, hard, changed) != 0
            return: 0 - 1
        return: 1 + hard
    while: r < l2_dyr_n
        if: l2_dyr_m[r] = x && l2_text_same(l2_dyr_nm[r], nm) != 0
            ok: 1
            unk: 0
            n: n0
            if: fi >= 0
                l2_dys_t[0]: fi
                l2_dys_a[0]: x
            j: 0
            while: ok != 0 && j < l2_dyr_c[r]
                vf: 0 - 1
                dn: l2_site_denotes(m, node, fi, x, l2_dyc_t[l2_dyr_at[r] + j], l2_dyc_a[l2_dyr_at[r] + j], @ vf)
                if: dn = 0
                    ok: 0
                if: dn = 2
                    unk: 1
                if: dn = 1 && vf >= 0
                    d: 0
                    while: d < n && l2_dys_t[d] != vf
                        d: d + 1
                    ---
                    # One formal holds one method.
                    if: d < n && l2_dys_a[d] != l2_dyc_a[l2_dyr_at[r] + j]
                        ok: 0
                    if: ok != 0 && d = n
                        l2_dys_t[n]: vf
                        l2_dys_a[n]: l2_dyc_a[l2_dyr_at[r] + j]
                        n: n + 1
                    ---
                j: j + 1
            ---
            if: ok != 0 && unk != 0
                unknown: 1
            if: ok != 0 && unk = 0
                hard: l2_dyr_hard[r]
                if: need < 1 + hard
                    need: 1 + hard
                if: add != 0 && l2_dyr_add(m, nm, n, hard, changed) != 0
                    return: 0 - 1
            ---
        r: r + 1
    ---
    if: unknown != 0
        l2_error(path, node, "which inputs this call needs depends on a callable this translation does not follow: not built yet")
        return: 0 - 1
return: need

# K04 S2 (ledger section 58; Codex, FABLE-CODEX-20261004-12).  Does method m itself read free name k: is the
# read its record keeps (l2_dyn_add takes the text of the read that makes it) in m's own body or return
# trailer?  A name a method does not read is one it only passes on to what it calls.
fn: l2_dyn_reads (int: m; int: k) int
    @: LmP0Node r 0
    if: m < 0 || m >= l2_m_n || k < 0 || k >= l2_m_dyn[m] || l2_dn(m, k) = 0
        return: 0
    if: l2_m_body[m] != 0 && l2_m_body[m]\as != 0
        r: l2_node_of_text(l2_m_body[m]\as\structure, l2_dn(m, k))
    if: r = 0 && l2_m_node[m] != 0 && l2_m_node[m]\as != 0 && l2_m_node[m]\kind = c.LM_P0_NODE_FRAME && l2_m_node[m]\as\frame != 0 && l2_m_node[m]\as\frame\trailer != 0
        r: l2_node_of_text(l2_m_node[m]\as\frame\trailer\body, l2_dn(m, k))
return: (cast: (int) (r != 0))

# A forward-only input: one method m does not read, a number or a reference alike -- whether an input is formed
# does not depend on how it is represented.  It stays its entry of refs through m's activation -- the typed body
# takes the entry itself, l2_pr<m>_<j> -- and goes on as it is, possibly absent (refs[k] = 0).
fn: l2_dyn_fwd (int: m; int: k) int
    if: m < 0 || m >= l2_m_n || m = l2_e || k < 0 || k >= l2_m_dyn[m]
        return: 0
return: (cast: (int) (l2_dyn_reads(m, k) = 0))

# Hidden input k of method m as an input m resolves itself when it arrives absent:
# m reads the name and its lexical declaration is a visible numeric field. The own row of that field,
# or -1.  The native entry (l2_emit_tramp_lex) and the walked body's ARG (l2_rw_arg_fb) read that cell through
# the occurrence's own parent.
fn: l2_hid_own_lex (int: m; int: k) int
    int: child
    @: LmP0Text nm
    if: m < 0 || m >= l2_m_n || k < 0 || k >= l2_m_dyn[m]
        return: 0 - 1
    nm: l2_dn(m, k)
    if: nm = 0 || l2_rw_num_ty(l2_own_of_dt(l2_dt(m, k))) = 0 || l2_dyn_reads(m, k) = 0
        return: 0 - 1
    child: l2_own_lexical(m, nm)
    if: child < 0 || l2_own_is_slot(child) != 0 || l2_own_ty[child] != l2_own_of_dt(l2_dt(m, k))
        return: 0 - 1
return: child

# Resolve an existing hidden-input source before/after PLACE. Mode identifies
# the existing NODE or own-field projection, never a runtime metadata record.
fn: l2_hid_source (int: mi; int: k; int: project; @: int mode; @: int depth; @: int slot; @: int kind; @: int own) int
    @: LmP0Text nm
    int: ent
    int: child
    \mode: 0
    \depth: 0 - 1
    \slot: 0 - 1
    \kind: 0 - 1
    \own: 0 - 1
    if: mi < 0 || mi >= l2_m_n || k < 0 || k >= l2_m_dyn[mi]
        return: 1
    nm: l2_dn(mi, k)
    if: nm = 0 || nm\data = 0
        return: 1
    # The same lexical resolver the source-visible node path uses already
    # locates a captured host formal in the snapshot's appended body fields.
    if: l2_mad_host_of(mi) >= 0 && l2_node_seg_resolve(mi, nm\data, 0U, nm\length, project, slot, kind, @ ent, own, 0) = 0
        \mode: 1
        \depth: 1
        return: 0
    child: l2_hid_own_lex(mi, k)
    # Preserve the existing hosted-body unit fallback, including a complete
    # Structure held in a root field, when the host has no such declaration.
    if: child < 0 && l2_mad_host_of(mi) >= 0
        child: l2_own_lexical(mi, nm)
        if: child >= 0 && l2_own_mi[child] != l2_e
            child: 0 - 1
        ---
    ---
    if: child < 0
        return: 1
    \mode: 2
    \own: child
    \slot: child
    if: project != 0
        \slot: l2_graph_field_child(child)
    \depth: l2_lex_depth_at(mi, l2_own_mi[child], project)
    \kind: l2_num_kind(l2_own_ty[child])
    if: l2_own_is_slot(child) != 0
        \kind: 2
return: 0

# An adapter-local reference normalizes an absent lexical input to the
# existing cell. The ordinary type unmarshaler remains the only value loader.
fn: l2_tramp_ref (int: mi; int: k; @: L2Tx dest) int
    int: mode
    int: depth
    int: slot
    int: kind
    int: own
    []: char name 64
    if: k >= l2_m_arity[mi] && l2_dyn_fwd(mi, k - l2_m_arity[mi]) = 0 && l2_hid_source(mi, k - l2_m_arity[mi], 0, @ mode, @ depth, @ slot, @ kind, @ own) = 0
        if: c.snprintf(name, 64U, "l2_href%d", k) < 0
            return: 1
        return: l2_tx_set(dest, name)
    ---
    if: c.snprintf(name, 64U, "refs[%d]", k) < 0
        return: 1
return: l2_tx_set(dest, name)

fn: l2_hid_takes_absent (int: callee; int: k) int
    int: mode
    int: depth
    int: slot
    int: kind
    int: own
    if: l2_dyn_fwd(callee, k) != 0
        return: 1
return: (cast: (int) (l2_hid_source(callee, k, 0, @ mode, @ depth, @ slot, @ kind, @ own) = 0))

# One hidden input into its place among the call's refs.  ABSENT: no entry.  REF:<expr>: an entry handed on as
# it is.  Else a value, boxed in caller-owned storage of its type (l2_emit_call_ref).
fn: l2_emit_hidden_ref (int: ft; const: @(char value); const: @(char ind); const: @(char dest)) int
    if: value = 0 || ind = 0 || dest = 0
        return: 1
    if: c.strcmp(value, "ABSENT") = 0
        return: (cast: (int) (c.fprintf(l2_out, "%s%s: 0\n", ind, dest) < 0))
    if: c.strncmp(value, "REF:", 4U) = 0
        return: (cast: (int) (c.fprintf(l2_out, "%s%s: %s\n", ind, dest, value + 4) < 0))
return: l2_emit_call_ref(ft, value, ind, dest)

# The entry of method i takes hidden input k (its position among the inputs) absent: the method then reads
# its own lexical source, a field of the unit, through its occurrence's parent -- as a walked body's ARG reads
# its fallback.  A present entry is read as before; a present zero is present.
fn: l2_emit_tramp_lex (int: i; int: k) int
    int: mode
    int: slot
    int: depth
    int: kind
    int: own
    if: l2_dyn_fwd(i, k - l2_m_arity[i]) != 0 || l2_hid_source(i, k - l2_m_arity[i], 1, @ mode, @ depth, @ slot, @ kind, @ own) != 0
        return: 0
    if: slot < 0 || depth < 0
        return: l2_error(l2_src, l2_m_node[i], "internal: a hidden input's lexical cell has no place")
    # A Structure field is its reference; the ABI carries the address of a
    # pointer-value cell. This temporary is ordinary machine transport and
    # lives through the typed call, outside the conditional block.
    if: kind = 2 && c.fprintf(l2_out, "    @: void l2_hpointer%d 0\n", k) < 0
        return: 1
    if: c.fprintf(l2_out, "    @: void l2_href%d refs[%d]\n    if: l2_href%d = 0\n        @@: void l2_txp%d lmx_arena_ref_cell(l2_self", k, k, k, k) < 0
        return: 1
    while: depth > 0
        if: fputs("\\parent", l2_out) < 0
            return: 1
        depth: depth - 1
    ---
    if: c.fprintf(l2_out, ", %uU)\n        if: l2_txp%d = 0\n            c.fprintf(c.stderr, \"lmx: invariant: a dynamic input has no cell to read\\n\")\n            c.abort()\n", (cast: (unsigned) slot), k) < 0
        return: 1
    if: kind = 2
        if: c.fprintf(l2_out, "        l2_hpointer%d: l2_txp%d[0]\n        l2_href%d: (cast: (@: void) (@ l2_hpointer%d))\n", k, k, k, k) < 0
            return: 1
        ---
    else:
        if: c.fprintf(l2_out, "        l2_href%d: l2_txp%d[0]\n", k, k) < 0
            return: 1
        ---
    if: fputs("    ---\n", l2_out) < 0
        return: 1
return: 0

# One edge of the lexical occurrence relation after source PLACE. A local
# definition's actual owning source container supplies its host and all the
# physical links to that host, including operation/argument Frames. Counting
# control levels instead would lose those Frames. This is translation-only
# layout information; no graph object or runtime name lookup is introduced.
# A negative parent is an isolated/root occurrence, not a module fallback.
fn: l2_lex_parent (int: mi; @: int links) int
    int: ni
    int: part
    @: L2SourceContainer owner 0
    @: L2SourceField field
    @: L2GraphPlace place
    \links: 1
    if: mi < 0 || mi >= l2_m_n || mi = l2_e
        return: -1
    ni: l2_m_nsof(mi)
    if: ni >= 0
        if: l2_ns_local[ni] >= 0
            field: l2_source_definition_field(ni, 0, -1, @ owner)
            if: field = 0 || owner = 0
                return: -2
            place: owner\place
            while: place != 0
                if: \links = c.INT_MAX
                    return: -2
                \links: \links + 1
                place: place\parent
            ---
            return: owner\source_mi
        ---
        if: l2_ns_parent[ni] >= 0
            return: l2_ns_proc[l2_ns_parent[ni]]
        if: l2_ns_eternal[ni] >= 0
            return: -1
        return: l2_e
    ---
    if: l2_mad_host_of(mi) >= 0
        return: l2_mad_host_of(mi)
    part: l2_m_part(mi)
    if: part >= 0 && l2_part_ns[part] >= 0
        return: l2_ns_proc[l2_part_ns[part]]
return: l2_e

# A finite walk over the resolved ownership relation, not a language depth
# limit. Places provide physical edge counts only after the committed PLACE
# pass. -1 means absent ancestry; -2 means invalid construction metadata.
fn: l2_lex_depth_at (int: mi; int: ancestor; int: committed) int
    int: depth 0
    int: links
    int: steps 0
    while: mi >= 0 && mi < l2_m_n && steps <= l2_m_n
        if: mi = ancestor
            return: depth
        # Local source-container links do not exist before PLACE. They are
        # deferred, never silently counted as one link or a global unit.
        if: committed = 0 && l2_m_nsof(mi) >= 0 && l2_ns_local[l2_m_nsof(mi)] >= 0
            return: -2
        mi: l2_lex_parent(mi, @ links)
        if: depth > c.INT_MAX - links
            return: -2
        depth: depth + links
        steps: steps + 1
    ---
    if: mi = -1
        return: -1
return: -2

fn: l2_lex_depth (int: mi; int: ancestor) int
return: l2_lex_depth_at(mi, ancestor, 1)

# Activation-local addresses of lexical ancestors. The chains come from the
# same construction relation as field paths, and are emitted incrementally:
# arbitrary nesting does not require a fixed text buffer or a runtime scan.
fn: l2_emit_lex_spaces (int: mi) int
    int: current mi
    int: parent
    int: links
    int: steps 0
    while: current >= 0 && current < l2_m_n && current != l2_e && steps <= l2_m_n
        parent: l2_lex_parent(current, @ links)
        if: parent = -1
            return: fputs("    @: Lmx l2_lex_unit 0\n", l2_out) < 0
        if: parent < 0 || parent >= l2_m_n || links < 1
            return: l2_error(l2_method_src(mi, l2_src), l2_m_node[mi], "internal: a lexical occurrence has no constructed parent")
        if: parent = l2_e && current = mi && links = 1
            return: 0
        if: parent = l2_e
            if: fputs("    @: Lmx l2_lex_unit ", l2_out) < 0
                return: 1
            ---
        else:
            if: c.fprintf(l2_out, "    @: Lmx l2_lex_o%d ", parent) < 0
                return: 1
            ---
        if: current = mi
            if: fputs("node", l2_out) < 0
                return: 1
            links: links - 1
            ---
        else:
            if: c.fprintf(l2_out, "l2_lex_o%d", current) < 0
                return: 1
            ---
        while: links > 0
            if: fputs("\\parent", l2_out) < 0
                return: 1
            links: links - 1
        ---
        if: fputs("\n", l2_out) < 0
            return: 1
        current: parent
        steps: steps + 1
    ---
    if: current != l2_e
        return: l2_error(l2_method_src(mi, l2_src), l2_m_node[mi], "internal: cyclic lexical occurrence ownership")
return: 0

# Native unit readers use the selected occurrence's actual parent chain. E is
# itself the unit. All other aliases are ordinary activation-local pointers.
fn: l2_m_unit_ref (int: i) const: @: char
    if: i = l2_e
        return: "self"
    if: l2_lex_depth(i, l2_e) = 1
        return: "node"
return: "l2_lex_unit"

# The boundary reads requirements in the selected occurrence's actual unit,
# exactly as its body does. Arbitrary ancestry uses growable expression text.
fn: l2_recv_ref (int: callee; const: @(char occ); @: L2Tx dest) int
    int: depth
    if: callee < 0 || callee >= l2_m_n || occ = 0 || dest = 0
        return: 1
    depth: l2_lex_depth(callee, l2_e)
    if: depth < 0
        return: l2_error(l2_method_src(callee, l2_src), l2_m_node[callee], "a receiving model has no constructed lexical unit")
    if: l2_tx_set(dest, occ) != 0
        return: 1
    while: depth > 0
        if: l2_tx_cat(dest, "\\parent") != 0
            return: 1
        depth: depth - 1
    ---
return: 0

# Whether method mi is a method of the unit itself: its occurrence's parent is the unit, which its own code
# reaches as `node` (the choice of l2_unit_ref).
fn: l2_m_unit_level (int: mi) int
    if: mi < 0 || mi >= l2_m_n || mi = l2_e
        return: 0
    if: l2_m_part(mi) >= 0 && l2_part_ns[l2_m_part(mi)] >= 0
        return: 0
    if: l2_mad_host_of(mi) >= 0
        return: 0
    if: l2_m_nsof(mi) >= 0 && (l2_ns_parent[l2_m_nsof(mi)] >= 0 || l2_ns_local[l2_m_nsof(mi)] >= 0)
        return: 0
return: 1

fn: l2_cf_get (int: omi; int: fk) int
    int: i 0
    if: omi < 0 || fk < 0
        return: 0 - 1
    while: i < l2_cf_n
        if: l2_cf_omi[i] = omi && l2_cf_fk[i] = fk
            return: l2_cf_req[i]
        i: i + 1
    ---
return: 0 - 1

fn: l2_method_sig_compatible (int: cand; int: req) int
    int: j 0
    if: cand < 0 || req < 0
        return: 0
    if: cand = req
        return: 1
    if: l2_m_arity[cand] != l2_m_arity[req]
        return: 0
    if: l2_m_ret[cand] != l2_m_ret[req]
        return: 0
    if: l2_throws_same(cand, req) = 0
        return: 0
    while: j < l2_m_arity[cand]
        if: l2_ft(cand, j) != l2_ft(req, j)
            return: 0
        j: j + 1
return: 1

fn: l2_prep (const: @(LmP0Node node); int: mi; const: @(char ind); @: L2Tx dest) int
    []: char lpd_own 1024
    @: char lpd 0
    size_t: lpn 0U
    int: lkind 0
    int: lelem 0
    int: ldepth 0
    size_t: li0 0U
    const: @: LmP0Frame call
    @: LmP0Field a0
    @: LmP0Field a1
    int: t
    int: idx
    int: k
    int: occ 0
    @: LmP0Text onm 0
    int: actual_span
    int: raw_j
    []: char s0_own 1024
    []: char s1_own 1024
    []: char s2_own 1024
    L2Tx: s0_tx
    L2Tx: s1_tx
    L2Tx: s2_tx
    @: L2Tx s0 @ s0_tx
    @: L2Tx s1 @ s1_tx
    @: L2Tx s2 @ s2_tx
    []: char num 32
    size_t: array_index
    int: d0 l2_diag_n
    L2IndexedOperand: indexed_value
    @: L2IndexedOperand indexed @ indexed_value
    l2_here_at_method(mi, node)
    if: node = 0 || dest = 0 || l2_tx_open(s0, s0_own, 1024U) != 0 || l2_tx_open(s1, s1_own, 1024U) != 0 || l2_tx_open(s2, s2_own, 1024U) != 0
        return: 1
    if: l2_indexed_node(node, mi, indexed) = 0
        return: l2_emit_indexed(indexed, mi, ind, dest)
    # A held callable's bare name received as its result: its call, as `name()` is emitted.
    if: node\kind = c.LM_P0_NODE_ATOM && l2_held_result_site(node) != 0
        if: l2_call_head_held(mi, node\as\atom) < 0
            return: l2_error(l2_src, node, "internal: a result site whose held callable is not selected at its emission")
        return: l2_prep_held_call(node, l2_call_head_held(mi, node\as\atom), mi, ind, dest)
    if: node\kind = c.LM_P0_NODE_ATOM
        k: l2_occ_head(node\as\atom, @ occ, @ onm)
        if: k = 2
            return: l2_error(l2_src, node, "unsupported index")
        if: k = 0
            idx: l2_own_find_occ(mi, onm, occ)
            if: onm != 0
                l2_xfree((cast: (@: void) onm))
            if: idx < 0
                return: l2_error(l2_src, node, "no such occurrence")
            if: l2_m_uses[l2_own_off(mi, idx)] != 0
                if: l2_own_load(idx, dest) != 0
                    return: 1
                return: 0
            ---
            return: l2_error(l2_src, node, "no such occurrence")
        ---
        k: l2_prefix_deref(node\as\atom, mi, ind, dest)
        if: k = 0
            return: 0
        if: k = 2
            return: 1
        if: l2_raw_head(node\as\atom, mi, @ raw_j) = 0
            return: l2_emit_raw_path(node\as\atom\data, node\as\atom\length, mi, ind, dest)
        k: l2_emit_own_index(node\as\atom, mi, ind, @ idx, s0)
        if: k = 0
            return: l2_emit_array_load_at(idx, s0\data, ind, dest)
        if: k = 2
            return: l2_error(l2_src, node, "an own array index could not be emitted")
        # A callable formal of this method named as a value is its callable's result
        # (l2_check_primary): called with no arguments through lmx_call0.
        idx: l2_param_find(mi, node\as\atom)
        if: idx >= 0 && l2_head_is_callable_formal(mi, node\as\atom) != 0
            return: l2_emit_call(node, l2_cf_get(mi, idx), 2, idx, 0, mi, ind, dest, 0)
        if: idx >= 0
            return: l2_tok_formal(mi, idx, dest)
        ---
        # K03 NS-ROLES-1b: a binding `b: tick` named as a value is tick's result -- its call with no arguments, on the
        # occurrence b holds (as a method named as a value, below).
        if: l2_call_alias_own(mi, node\as\atom) >= 0
            if: l2_emit_alias_self(l2_call_alias_own(mi, node\as\atom), mi, ind) != 0
                return: 1
            return: l2_emit_call(node, l2_rb_meth_of(l2_own_decl[l2_call_alias_own(mi, node\as\atom)]), 1, 0 - 1, 0, mi, ind, dest, 0)
        # D-10 (steps/defects.md): the l2_own_find fallback here was dead --
        # see l2_check_sizeof's copy of this reasoning above.
        idx: l2_own_visible(mi, node\as\atom)
        if: idx >= 0 && l2_own_is_array(l2_own_ty[idx]) != 0
            return: l2_emit_array_desc(idx, ind, dest)
        if: idx >= 0 && l2_m_uses[l2_own_off(mi, idx)] != 0
            if: l2_own_load(idx, dest) != 0
                return: 1
            return: 0
        ---
        idx: l2_slot_find(mi, node\as\atom)
        if: idx >= 0
            return: l2_tok_slot(mi, idx, dest)
        ---
        idx: l2_ns_find(node\as\atom)
        if: idx >= 0
            if: l2_unit_ref = 0
                return: 1
            if: c.snprintf(num, 32U, "%uU)", (cast: (unsigned) (l2_ns_unit_slot(idx)))) < 0 || l2_tx_join(dest, "lmx_arena_ref_struct(", l2_unit_ref, ", ", num, 0) != 0
                return: l2_alloc_or(l2_src, node, "out of memory")
            return: 0
        ---
        # A method named as a value is its result: it runs with no arguments on the call path of
        # `m()` (l2_check_primary refused one without a result) -- the method the site sees (l2_site_method), the
        # check's.
        if: l2_head_is_method_call(mi, node\as\atom) != 0
            return: l2_emit_call(node, l2_site_method(mi, node\as\atom), 0, 0 - 1, 0, mi, ind, dest, 0)
        ---
        if: l2_tok_tx(dest, node\as\atom) != 0
            return: l2_alloc_or(l2_src, node, "out of memory")
        return: 0
    if: node\kind = c.LM_P0_NODE_FRAME && l2_frame_head(node, "@")
        return: l2_prep_addr(node, mi, ind, dest)
    # A prefix sign applied to a group: the group's value, as a group's is
    # prepared just below, then the sign. C promotes and negates.
    if: l2_prefix_frame(node) != 0
        l2_tx_clear(s2)
        if: l2_fields_has_call(node\as\frame\body\first_field, l2_count_active(node\as\frame\body))
            if: l2_eval_fields(node\as\frame\body\first_field, l2_count_active(node\as\frame\body), mi, ind, s2) != 0
                return: 1
            ---
        else:
            if: l2_emit_fields(node\as\frame\body\first_field, l2_count_active(node\as\frame\body), mi, ind, s2) != 0
                return: 1
            ---
        ---
        if: l2_prefix_frame(node) = 1
            t: l2_tx_join(dest, "(- (", s2\data, "))", 0, 0)
        else:
            t: l2_tx_join(dest, "(+ (", s2\data, "))", 0, 0)
        ---
        if: t != 0
            return: l2_alloc_or(l2_src, node, "out of memory")
        return: 0
    # A group is one operand of the operation around it: its text goes out in parentheses whether
    # its fields are evaluated through calls or written in place.
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0
        l2_tx_clear(s2)
        if: l2_fields_has_call(node\as\structure\first_field, l2_count_active(node\as\structure))
            if: l2_eval_fields(node\as\structure\first_field, l2_count_active(node\as\structure), mi, ind, s2) != 0
                return: 1
            ---
        else:
            if: l2_emit_fields(node\as\structure\first_field, l2_count_active(node\as\structure), mi, ind, s2) != 0
                return: 1
            ---
        ---
        if: l2_tx_join(dest, "(", s2\data, ")", 0, 0) != 0
            return: l2_alloc_or(l2_src, node, "out of memory")
        return: 0
    if: node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: 1
    call: node\as\frame
    if: l2_text_eq(call\head, "cast")
        if: call\body = 0 || call\trailer != 0 || call\body\trailer != 0 || l2_count_active(call\body) < 2
            return: 1
        a0: l2_next_active(call\body\first_field)
        a1: l2_next_active(a0\next)
        l2_tx_clear(s0)
        if: l2_cast_type(a0\value, s1) != 0
            return: 1
        # A field/index expression reaches here as flat fields, and
        # l2_emit_fields already renders that complete shape.
        if: l2_count_active(call\body) > 2 && l2_emit_fields(a1, l2_count_active(call\body) - 1, mi, ind, s0) != 0
            return: 1
        if: l2_count_active(call\body) = 2 && l2_prep(a1\value, mi, ind, s0) != 0
            return: 1
        if: l2_tx_join(dest, "(cast: (", s1\data, ") ", s0\data, ")") != 0
            return: l2_alloc_or(l2_src, node, "out of memory")
        return: 0
    ---
    if: l2_text_eq(call\head, "sizeof")
        return: l2_emit_sizeof(node, mi, ind, dest)
    ---
    if: l2_text_eq(call\head, "implements")
        return: l2_prep_implements(node, dest)
    # K03 S6: the callee is the check's one resolution of the head (l2_call_head_method; D-106: a callable formal of this
    # method shadows a unit method of its name), read once.  What it resolved selects the occurrence called: a callable
    # formal -- the one the formal holds (sel 2); a binding `b: tick` (NS-ROLES-1b) -- tick's occurrence b holds now
    # (sel 1); a method's path -- the occurrence the path selects (sel 1): its slot 0 holds a typed LmxCallable
    # referring to the shared METHOD, the occurrence is the hidden self, its node the source-visible lexical space above
    # the method, fixed for the entire activation; a method by its name -- the unit's occurrence (sel 0).
    idx: l2_call_head_method(mi, call\head, @ l2_call_fi)
    l2_call_sel: 0
    if: idx >= 0 && l2_call_fi >= 0
        l2_call_sel: 2
    if: idx >= 0 && l2_call_sel = 0 && l2_call_alias_own(mi, call\head) >= 0
        if: l2_emit_alias_self(l2_call_alias_own(mi, call\head), mi, ind) != 0
            return: 1
        l2_call_sel: 1
    ---
    if: idx >= 0 && l2_call_sel = 0 && l2_seg_count(call\head\data, call\head\length) > 1
        if: l2_emit_path(call\head\data, call\head\length, mi, ind, node, @ l2_call_k) != 0
            return: 1
        l2_call_sel: 1
    ---
    if: idx < 0 && l2_text_eq(call\head, "length") && l2_array_length_own(node, mi) < 0 && l2_arr_len_shape(node, lpd_own, 1024U, @ lpd, @ lpn, @ lkind, @ lelem, @ ldepth, @ li0) = 0
        return: l2_emit_arr_operand(mi, lpd, lpn, lkind, lelem, ldepth, li0, 0U, 1, ind, node, dest)
    if: idx < 0 && l2_text_eq(call\head, "length")
        return: l2_emit_array_length(l2_array_length_own(node, mi), ind, dest)
    raw_j: -1
    if: idx < 0
        k: l2_raw_head(call\head, mi, @ raw_j)
    # Typed fnptr (ty40) expression emission: same call-args sequence as statement
    # emit_fnptr_call. Do not route through l2_emit_ccall (c.* door stays untouched).
    if: idx < 0 && l2_ml_find(call\head) >= 0 && l2_ml_ty[l2_ml_find(call\head)] = 40
        l2_tx_clear(s0)
        if: call\body != 0
            a0: l2_next_active(call\body\first_field)
            t: 1
            while: a0 != 0
                actual_span: l2_expr_span(a0)
                if: actual_span < 1
                    return: 1
                l2_tx_clear(s1)
                if: l2_emit_fields(a0, actual_span, mi, ind, s1) != 0
                    return: 1
                if: t = 0 && l2_tx_cat(s0, ", ") != 0
                    return: l2_alloc_or(l2_src, node, "out of memory")
                if: l2_tx_cat(s0, s1\data) != 0
                    return: l2_alloc_or(l2_src, node, "out of memory")
                t: 0
                a0: l2_skip_span(a0, actual_span)
            ---
        ---
        if: l2_tok_tx(s1, call\head) != 0 || l2_tx_join(dest, s1\data, "(", s0\data, ")", 0) != 0
            return: l2_alloc_or(l2_src, node, "out of memory")
        if: l2_emit_publish(ind) != 0
            return: 1
        return: 0
    ---
    if: idx < 0 && (l2_c_stmt_door(call\head) != 0 || l2_predef_has_function(call\head) != 0 || k = 0)
        l2_ccall_into: dest
        if: l2_emit_ccall(node, mi, ind) != 0
            l2_ccall_into: 0
            return: 1
        return: 0
    ---
    # WHAT STOOD HERE AND IS GONE (FABLE-SONNET-NAME-SPECIALS-20260924-155
    # commit 3): four name-keyed branches hand-emitting lm_own_new_zero/
    # _copy_bytes/_delete/_resize, dead since commit 2 -- l2_predef_has_
    # function(call\head) is now required just to reach this emitter for
    # one of these names (l2_check_fields :13061 admits on l2_is_known,
    # which for a non-c.* name IS that check), so the l2_predef_has_
    # function(...) arm just above (:14862) always fires first and returns
    # before any of these four could run. The lm_own_new_zero arm was also
    # the strstr(s0,"IndentStack"|"size_t") substring dispatch named in
    # plan §7a; its replacement is simply that it is gone -- the call now
    # emits through the general l2_emit_ccall path, verbatim, and the
    # caller's own cast (if any) supplies the type, exactly like every
    # other predef'd C call. See :18296 for the matching auto-injected-
    # header deletion (same commit, same reasoning).  Two more such arms,
    # l2_immut_query_fill and l2_hash_compare_q, stood here until the §GATE
    # measurement (steps/gate-measure-20260927.md): the same predef arm just
    # above returns before either name could reach them.
    # A held callable (steps/merge-callable-r48.md S1): called as the walk calls it, through its l2_mad_call helper.
    if: idx < 0 && l2_call_head_held(mi, call\head) >= 0
        return: l2_prep_held_call(node, l2_call_head_held(mi, call\head), mi, ind, dest)
    # A head the check admitted and no branch above emits is a translator gap: said here, at the frame, once.
    if: idx < 0
        return: l2_said_or(l2_src, node, d0, "internal: a call the emitter does not know")
return: l2_emit_call(node, idx, l2_call_sel, l2_call_fi, call\body, mi, ind, dest, 0)

# K03 NS-ROLES-1b: l2_pst := the occurrence own field oi (a binding `b: tick`) holds now -- in a method that sees the
# unit's binding, its hidden input's value (Q52, as a held callable's, l2_prep_held_call); else the field's working
# value, or a load of its cell -- for a call whose self it is (sel 1).  The binding stored an occurrence, so none is an
# invariant.
fn: l2_emit_alias_self (int: oi; int: mi; const: @(char ind)) int
    []: char root_own 64
    L2Tx: root_tx
    @: L2Tx root l2_tx_local(@ root_tx, root_own, 64U)
    if: mi != l2_e && l2_own_mi[oi] != mi && l2_param_find(mi, l2_own_name[oi]) >= 0
        if: l2_tok_formal(mi, l2_param_find(mi, l2_own_name[oi]), root) != 0
            return: 1
        if: c.fprintf(l2_out, "%sl2_pst: (cast: (@: Lmx) %s)\n%sif: l2_pst = 0\n", ind, root\data, ind) < 0
            return: 1
        return: l2_emit_invariant(ind, "a reference binding holds no callable occurrence")
    if: l2_own_cached(l2_work_mi, oi) != 0 && l2_own_load(oi, root) != 0
        return: 1
    if: l2_own_cached(l2_work_mi, oi) = 0 && l2_emit_path_load(mi, oi, ind, root) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_pst: (cast: (@: Lmx) %s)\n%sif: l2_pst = 0\n", ind, root\data, ind) < 0
        return: 1
return: l2_emit_invariant(ind, "a reference binding holds no callable occurrence")

# THE CALL (FABLE-OPUS-RECEIVER-CONTRACT-20260924-139).  One emission for every spelling of a call
# of the resolved callee idx: l2_prep's call Frame, and a bare atom statement, which has no
# argument Structure (body 0).  sel is how the called occurrence is selected: 0 the unit's own
# occurrence of the method, 1 the occurrence a method path has just selected (l2_pst), 2 the one
# the callable formal fi holds.  sel and fi arrive as values: a call among the actuals goes
# through l2_prep again and must not re-select this one.
# Every present input names caller-owned automatic value storage, live through
# this invocation. Scalars/foreign values keep exact width; references use a
# canonical void* payload box. None of these boxes is a language @place.
fn: l2_emit_call_ref (int: ft; const: @(char value); const: @(char ind); const: @(char dest)) int
    int: t
    []: char name 64
    []: char declaration_own 1024
    L2Tx: declaration_tx
    @: L2Tx declaration l2_tx_local(@ declaration_tx, declaration_own, 1024U)
    ft: l2_formal_raw(ft)
    if: l2_pointer_depth(ft) > 0
        t: l2_tn
        l2_tn: l2_tn + 1
        return: (cast: (int) (c.fprintf(l2_out, "%s@: void l2_arg_ref%d (cast: (@: void) %s)\n%s%s: (cast: (@: void) (@ l2_arg_ref%d))\n", ind, t, value, ind, dest, t) < 0))
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.sprintf(name, "l2_arg%d", t) < 0 || l2_value_decl_text(ft, 0, name, declaration) != 0
        return: 1
return: (cast: (int) (c.fprintf(l2_out, "%s%s %s\n%s%s: (cast: (@: void) (@ %s))\n", ind, declaration\data, value, ind, dest, name) < 0))

# The hidden inputs of one call, each evaluated into a text of its own -- one block in \out, which the caller frees:
# nhid texts, then a slot of 1024 bytes for each, where its text starts -- what the call's refs take after the
# declared actuals.  An input the callable this site has does not need (l2_site_needs) is handed absent, and nothing
# of the caller is evaluated for it.
fn: l2_emit_call_hides (int: mi; int: hid; int: nhid; int: nact; int: self_t; const: @(char ind); const: @(LmP0Node node); int: mcall; int: cfi; @@: L2Tx out) int
    []: char occ 48
    int: ai 0
    int: need
    @: L2Tx hides 0
    @: char slots 0
    \out: 0
    if: nhid <= 0
        return: 0
    if: l2_mul_ok((cast: (size_t) nhid), 1024U + c.sizeof(c.L2Tx)) = 0
        l2_alloc_err: 2
        return: l2_error(l2_src, node, "size overflow")
    hides: (cast: (@: L2Tx) l2_xmalloc((cast: (size_t) nhid) * (1024U + c.sizeof(c.L2Tx))))
    if: hides = 0
        return: l2_error(l2_src, node, "out of memory")
    \out: hides
    slots: (cast: (@: char) (hides + nhid))
    memset((cast: (@: void) slots), 0, (cast: (size_t) nhid) * 1024U)
    while: ai < nhid
        l2_tx_open(hides + ai, slots + (cast: (size_t) ai) * 1024U, 1024U)
        ai: ai + 1
    ---
    ai: 0
    while: ai < nhid
        need: l2_site_needs(mi, node, cfi, hid, ai, 0, 0, l2_src)
        if: need < 0
            return: 1
        if: need = 0
            if: l2_tx_set(l2_act_tx(hides, ai), "ABSENT") != 0
                return: 1
            ai: ai + 1
            continue
        if: l2_hidden_from(mi, hid, ai, self_t, ind, l2_act_tx(hides, ai), node) != 0
            return: 1
        if: l2_cap_arg_ns(hid, l2_m_arity[hid] + ai) < 0 && l2_free_admit(hid, ai) = 0 && l2_admit_entry(mi, hid, ai, 0 - 1, l2_act_tx(hides, ai)\data, ind) != 0
            return: 1
        # A free input is admitted to its requirement read in the space of the occurrence this call selected.
        if: l2_free_admit(hid, ai) != 0
            c.snprintf(occ, 48U, "l2_c%d", self_t)
            if: l2_admit_received(mi, hid, ai, occ, l2_act_tx(hides, ai)\data, ind) != 0
                return: 1
        ---
        # Capturing nested/PAP occurrences retain their existing admission
        # role, but admission completes before this call's publication.
        if: mcall != 0 && l2_cap_arg_ns(hid, l2_m_arity[hid] + ai) >= 0 && l2_cap_src_marked(mi, l2_dn(hid, ai)) = 0 && l2_admit_entry(mi, hid, ai, l2_cap_arg_ns(hid, l2_m_arity[hid] + ai), l2_act_tx(hides, ai)\data, ind) != 0
            return: 1
        ai: ai + 1
    ---
return: 0

# The declarations a call's result lands in: l2_t<t>, and for a throwing callee its status and record.
fn: l2_emit_call_result (int: idx; int: t; const: @(char ind)) int
    int: prty
    # A named-Structure return holds the graph code, spelled `Lmx *` (l2_formal_raw), as l2_emit_formal/l2_emit_sig
    # spell it -- a discarded or captured call to a Structure-returning method must not reach l2_emit_foreign_temp
    # with a code of another space (FABLE-SONNET-DECL-PREPASS-20260923-137 part 2).
    prty: l2_formal_raw(l2_m_ret[idx])
    if: prty = 1 && c.fprintf(l2_out, "%schar: l2_t%d\n", ind, t) < 0
        return: 1
    if: prty = 2 && c.fprintf(l2_out, "%ssize_t: l2_t%d\n", ind, t) < 0
        return: 1
    if: prty = 33 && c.fprintf(l2_out, "%sunsigned: l2_t%d\n", ind, t) < 0
        return: 1
    if: prty = 36 && c.fprintf(l2_out, "%sulong: l2_t%d\n", ind, t) < 0
        return: 1
    if: prty = 3 && c.fprintf(l2_out, "%s@: char l2_t%d\n", ind, t) < 0
        return: 1
    if: prty = 16 && c.fprintf(l2_out, "%s@: void l2_t%d\n", ind, t) < 0
        return: 1
    if: prty = 35 && c.fprintf(l2_out, "%sconst: @(char l2_t%d)\n", ind, t) < 0
        return: 1
    if: prty = 32 && c.fprintf(l2_out, "%s@@: char l2_t%d\n", ind, t) < 0
        return: 1
    if: prty >= 100 && l2_emit_foreign_temp(l2_out, prty, ind, t) != 0
        return: 1
    if: l2_ret_uns(idx) = 0 && prty != 1 && prty != 3 && prty != 8 && prty != 16 && prty != 32 && prty != 35 && prty < 100 && c.fprintf(l2_out, "%sint: l2_t%d\n", ind, t) < 0
        return: 1
    if: l2_m_throws[idx] != 0 && c.fprintf(l2_out, "%sint: l2_ts%d 0\n%s@: Lmx l2_te%d 0\n", ind, t, ind, t) < 0
        return: 1
return: 0

# The publication, the refs and the dispatch of one call whose actuals (acts) and hidden inputs (hides, of
# method hid) are evaluated.
fn: l2_emit_call_go (int: mi; int: idx; int: hid; int: t; int: self_t; const: @(char ind); int: nact; int: nhid; @: L2Tx acts; @: L2Tx hides) int
    int: ai
    []: char ref_dest 128
    # §7b: control passes to another callable -- the actuals and hidden inputs are evaluated above, so what is marked
    # is published now, before the call (book §12, the `9 0` order).
    if: l2_emit_publish(ind) != 0
        return: 1
    # Selection is complete. Every occurrence now uses the same typed transport
    # and dispatches by its actual native word, independently of selector syntax.
    if: nact + nhid > 0 && c.fprintf(l2_out, "%s[]: @(void) l2_cfr%d %d\n", ind, t, nact + nhid) < 0
        return: 1
    ai: 0
    while: ai < nact
        c.sprintf(ref_dest, "l2_cfr%d[%d]", t, ai)
        if: l2_emit_call_ref(l2_ft(idx, ai), l2_act_tx(acts, ai)\data, ind, ref_dest) != 0
            return: 1
        ai: ai + 1
    ai: 0
    while: ai < nhid
        c.sprintf(ref_dest, "l2_cfr%d[%d]", t, nact + ai)
        if: l2_emit_hidden_ref(l2_input_ft(hid, l2_m_arity[hid] + ai), l2_act_tx(hides, ai)\data, ind, ref_dest) != 0
            return: 1
        ai: ai + 1
    if: l2_emit_dyn_call(mi, idx, t, self_t, ind, nact + nhid) != 0
        return: 1
return: 0

# The parent links from an occurrence of method m up to the Structure that holds it as a child, at l2_occ_slot(m):
# the unit, or any copy of it -- the copier keeps every child's position and points a copied Structure's parent at the
# copy of its parent (lmx_graph_copy_owned's parent fixup), and a composition absorbs only its operand roots, never
# the unit's child.  The construction (l2_emit_build_occ and the parents it sets) gives: a file-level method's
# occurrence is the unit's child (1); a method of a program part whose root is built runs under that root, itself
# the unit's child (2); a nested method under its host's occurrence (1 + its host's); a named Structure's procedure is
# the Structure, the unit's child where the Structure is the unit's (1).  0 where the parents do not reach the holder:
# a named Structure nested in another or eternal.
fn: l2_occ_hops (int: m) int
    int: h 0
    int: steps 0
    while: m >= 0 && m < l2_m_n && m != l2_e && steps <= l2_m_n
        if: l2_m_nsof(m) >= 0
            if: l2_ns_parent[l2_m_nsof(m)] >= 0 || l2_ns_eternal[l2_m_nsof(m)] >= 0
                return: 0
            return: h + 1
        ---
        if: l2_mad_host_of(m) < 0
            if: l2_m_part(m) >= 0 && l2_part_ns[l2_m_part(m)] >= 0
                return: h + 2
            return: h + 1
        ---
        h: h + 1
        m: l2_mad_host_of(m)
        steps: steps + 1
    ---
return: 0

# K04 S2 / COPIED-METHOD-DECLARED-FORMAL: the class of the occurrence a call through callable formal fi of mi
# selected, chosen once, right after that occurrence is captured (l2_c<self_t>) and before any actual is evaluated,
# so that no actual's effect can change it: class k when the occurrence is the child its holder keeps at a member's
# slot -- reached by its parents (l2_occ_hops), the unit and any copy of it alike, a copy sharing the original's
# code but not its parent -- or, for a member whose holder its parents do not reach, the occurrence the unit this
# method reads holds (l2_tok_method_occ).  One child per slot and one slot per method: at most one member holds it.
# Every class is tested and none is a remainder; an absent occurrence, and one no class holds, stop at the shared
# invariant.
fn: l2_emit_call_select (int: mi; int: fi; int: self_t; const: @(char ind)) int
    int: n l2_cfl_count(mi, fi)
    int: i 0
    int: j
    int: k 0
    int: m
    int: h
    int: head
    []: char occ_own 256
    L2Tx: occ_tx
    @: L2Tx occ l2_tx_local(@ occ_tx, occ_own, 256U)
    if: c.fprintf(l2_out, "%sif: l2_c%d = 0\n", ind, self_t) < 0 || l2_emit_invariant(ind, "a call through a callable formal has no occurrence") != 0
        return: 1
    if: c.fprintf(l2_out, "%sint: l2_cfk%d 0\n%sl2_cfk%d: 0 - 1\n%s@: Lmx l2_cfu%d 0\n", ind, self_t, ind, self_t, ind, self_t) < 0
        return: 1
    while: i < n
        head: l2_cfl_at(mi, fi, i)
        if: l2_cfl_class_of(mi, fi, head) != head
            i: i + 1
            continue
        j: 0
        while: j < n
            m: l2_cfl_at(mi, fi, j)
            if: l2_cfl_class_of(mi, fi, m) = head
                h: l2_occ_hops(m)
                if: h > 0
                    if: c.fprintf(l2_out, "%sl2_cfu%d: l2_c%d\n", ind, self_t, self_t) < 0
                        return: 1
                    while: h > 0
                        if: c.fprintf(l2_out, "%sif: l2_cfu%d != 0\n%s    l2_cfu%d: l2_cfu%d\\parent\n", ind, self_t, ind, self_t, self_t) < 0
                            return: 1
                        h: h - 1
                    ---
                    if: c.fprintf(l2_out, "%sif: l2_cfk%d < 0 && l2_cfu%d != 0 && lmx_arena_ref_struct(l2_cfu%d, %uU) = l2_c%d\n%s    l2_cfk%d: %d\n", ind, self_t, self_t, self_t, (cast: (unsigned) (l2_occ_slot(m))), self_t, ind, self_t, k) < 0
                        return: 1
                    ---
                else:
                    if: l2_tok_method_occ(m, occ) != 0
                        return: 1
                    if: c.fprintf(l2_out, "%sif: l2_cfk%d < 0 && l2_c%d = %s\n%s    l2_cfk%d: %d\n", ind, self_t, self_t, occ\data, ind, self_t, k) < 0
                        return: 1
                    ---
                ---
            ---
            j: j + 1
        ---
        k: k + 1
        i: i + 1
    ---
    if: c.fprintf(l2_out, "%sif: l2_cfk%d < 0\n", ind, self_t) < 0 || l2_emit_invariant(ind, "the occurrence a callable formal holds is in no class the translation proved") != 0
        return: 1
return: 0

# A call through callable formal fi of method mi that more than one formation reaches (K04 S2 part two;
# Codex, FABLE-CODEX-20261004-12).  The class of the occurrence the formal holds was chosen before the actuals
# (l2_emit_call_select, l2_cfk<self_t>); each class forms its own list of hidden inputs by the one route
# (l2_hidden_from) and calls.  No class serves the method that declares the formal.  The flow holds no occurrence
# the translation does not follow: l2_cfl_classes refuses the call then, as a limit, before this is reached.
fn: l2_emit_call_classes (int: mi; int: idx; int: fi; int: t; int: self_t; const: @(char ind); int: nact; @: L2Tx acts; const: @(LmP0Node node)) int
    int: n l2_cfl_count(mi, fi)
    int: i 0
    int: k 0
    int: head
    int: rc
    @: L2Tx hides
    @: char deep 0
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    while: i < n
        head: l2_cfl_at(mi, fi, i)
        if: l2_cfl_class_of(mi, fi, head) != head
            i: i + 1
            continue
        if: c.fprintf(l2_out, "%sif: l2_cfk%d = %d\n", ind, self_t, k) < 0
            return: 1
        hides: 0
        rc: l2_emit_call_hides(mi, head, l2_m_dyn[head], nact, self_t, deep, node, 0, fi, @ hides)
        if: rc = 0
            rc: l2_emit_call_go(mi, idx, head, t, self_t, deep, nact, l2_m_dyn[head], acts, hides)
        if: hides != 0
            l2_xfree((cast: (@: void) hides))
        if: rc != 0
            return: 1
        if: c.fprintf(l2_out, "%s---\n", ind) < 0
            return: 1
        k: k + 1
        i: i + 1
    ---
return: 0

# The receiver whose contract admits a call's declared inputs: idx itself, or -- through a callable formal with one
# class (hid, l2_cfl_classes) -- that class's head.
fn: l2_call_receiver (int: idx; int: formal; int: hid) int
    if: formal >= 0 && hid >= 0
        return: hid
return: idx

# One admission of actual t into formal t of receiver r, its requirement read in the space of the occurrence `occ`
# the call selected (l2_recv_ref, read by l2_type_inst alone while it is emitted, as a free input's): form 1 an
# occurrence (its pair map), 2 by position, 3 a record by name (D-105).  The candidate is as it was formed.
fn: l2_emit_formal_admit (int: mi; int: r; int: t; int: form; int: occ_mi; @: L2ReferenceSource source; int: dyn_mi; const: @(char occ); const: @(char value); const: @(char ind)) int
    []: char recv_local 128
    L2Tx: recv_text
    @: L2Tx recv l2_tx_local(@ recv_text, recv_local, 128U)
    int: st 0
    const: @(char saved) l2_recv_unit
    if: recv = 0 || l2_recv_ref(r, occ, recv) != 0
        return: 1
    l2_recv_unit: recv\data
    if: form = 1
        st: l2_emit_occ_admit(mi, l2_input_schema(r, t), l2_schema_method(occ_mi), value, ind)
    if: form = 2
        st: l2_emit_admit(mi, l2_nsty_get(r, t), value, ind)
    if: form = 3
        st: l2_emit_model_admit(mi, l2_input_model(r, t), source, value, ind, 0, 0, -1, dyn_mi, r, t)
    l2_recv_unit: saved
return: st

# One class's admission, its head h's: a static candidate h's Consumer does not admit (l2_d105_fits) is refused where
# the input is formed, as mi's implicit `implements`, when this class is the selected one; no other class is asked.
fn: l2_emit_class_admit (int: mi; int: h; int: t; int: form; int: occ_mi; @: L2ReferenceSource source; int: dyn_mi; const: @(char occ); const: @(char value); const: @(char ind)) int
    int: req l2_input_schema(h, t)
    int: cand 0 - 1
    if: form = 1
        cand: l2_schema_method(occ_mi)
    if: form = 3 && source\method < 0
        cand: source\layout
    if: cand != -1 && req != -1 && cand != req && l2_d105_fits(cand, req, h, t) = 0
        if: c.fprintf(l2_out, "%sif: %s != 0\n", ind, value) < 0
            return: 1
        return: l2_emit_implicit_throw(mi, "implements", ind)
    ---
return: l2_emit_formal_admit(mi, h, t, form, occ_mi, source, dyn_mi, occ, value, ind)

# The admission of actual t of a call into its declared formal, in the space of the occurrence the call selected
# (l2_c<self_t>): the formal of idx for a call of idx; through callable formal cfi, the formal of the selected
# occurrence's class -- under that class's key where the classes receive the formal differently, once where they
# receive it alike (l2_cfl_formal_alike).  The actual was evaluated once before; only its admission is chosen.
fn: l2_emit_formal_admits (int: mi; int: idx; int: cfi; int: ncls; int: self_t; int: t; int: form; int: occ_mi; @: L2ReferenceSource source; int: dyn_mi; const: @(char value); const: @(char ind)) int
    int: n
    int: i 0
    int: k 0
    int: head
    int: first 0 - 1
    int: alike 1
    @: char deep 0
    []: char occ 48
    if: c.snprintf(occ, 48U, "l2_c%d", self_t) < 0
        return: 1
    if: cfi < 0 || ncls < 1
        return: l2_emit_formal_admit(mi, idx, t, form, occ_mi, source, dyn_mi, occ, value, ind)
    n: l2_cfl_count(mi, cfi)
    while: i < n
        head: l2_cfl_at(mi, cfi, i)
        if: l2_cfl_class_of(mi, cfi, head) = head
            if: first < 0
                first: head
            if: l2_cfl_formal_alike(first, head, t) = 0
                alike: 0
            ---
        i: i + 1
    ---
    if: ncls = 1 || alike != 0
        return: l2_emit_class_admit(mi, first, t, form, occ_mi, source, dyn_mi, occ, value, ind)
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    i: 0
    while: i < n
        head: l2_cfl_at(mi, cfi, i)
        if: l2_cfl_class_of(mi, cfi, head) = head
            if: c.fprintf(l2_out, "%sif: l2_cfk%d = %d\n", ind, self_t, k) < 0
                return: 1
            if: l2_emit_class_admit(mi, head, t, form, occ_mi, source, dyn_mi, occ, value, deep) != 0
                return: 1
            if: c.fprintf(l2_out, "%s---\n", ind) < 0
                return: 1
            k: k + 1
        ---
        i: i + 1
    ---
return: 0

fn: l2_emit_call (const: @(LmP0Node node); int: idx; int: sel; int: fi; const: @(LmP0Structure body); int: mi; const: @(char ind); @: L2Tx dest; int: edge) int
    L2ReferenceSource: source
    @: LmP0Field a0 0
    int: t
    int: self_t
    int: actual_span
    int: bound 0 - 1
    int: written 0
    @: L2Tx acts 0
    @: char act_slots 0
    int: ak
    @: L2Tx hides 0
    int: nact 0
    int: nhid 0
    int: er
    int: occ_mi
    int: mcall 0
    int: hid
    int: ncls 0
    int: cfi 0 - 1
    int: dyn_mi
    # Capture the selected physical occurrence before evaluating actuals: a
    # nested call may reuse l2_pst, but `self` for this call must remain the
    # originally selected callable. Source `node` is self\parent; own storage
    # is based on self itself.
    self_t: l2_tn
    l2_tn: l2_tn + 1
    # Every call runs the callee over its own graph, (M, M) -- a re-entry too: no instance of M is made (the author,
    # 2026-09-28: no auxiliary structures in the graph; a declared field stays where it is declared).  What one
    # activation keeps apart from another is the machine activation's: its arguments and its working values (§7b).
    # A3: the host calls a capturing nested method -- its model or another -- over the method's own occurrence, (M, M),
    # its captures the hidden inputs it supplies below (l2_hidden_from): the host's current values.  The method is
    # walked (native 0, l2_emit_native_word), so it is called through its leaf, lmx_call_prim, as a merge result is
    # (S2a below).
    if: sel = 0 && l2_mad_nested_call(mi, idx) != 0
        if: l2_m_steps = 0 || l2_m_steps[idx] <= 0 || l2_m_walkable[idx] = 0
            return: l2_mad_unwalkable(mi, idx)
        mcall: 1
        sel: 2
        if: c.fprintf(l2_out, "%s@: Lmx l2_c%d lmx_arena_ref_struct(%s, %uU)\n", ind, self_t, l2_unit_ref, (cast: (unsigned) (l2_occ_slot(idx)))) < 0
            return: 1
        ---
    if: sel = 0 && c.fprintf(l2_out, "%s@: Lmx l2_c%d lmx_arena_ref_struct(%s, %uU)\n", ind, self_t, l2_unit_ref, (cast: (unsigned) (l2_occ_slot(idx)))) < 0
        return: 1
    if: sel = 1 && c.fprintf(l2_out, "%s@: Lmx l2_c%d l2_pst\n", ind, self_t) < 0
        return: 1
    ---
    # S2a (steps/merge-callable-r48.md §4): a merge result (l2_pap_on) has native 0, and its C function is no body of
    # it -- it is called through its leaf, as the root's walk calls it: the A3 path, its occurrence (l2_c above) the
    # code and the data, its arguments cells of their types (lmx_call_prim, no fresh instance).
    if: sel != 2 && l2_pap_on(idx) != 0
        mcall: 1
        sel: 2
    if: sel = 2 && mcall = 0 && c.fprintf(l2_out, "%s@: Lmx l2_c%d l2_p%d_%d\n", ind, self_t, mi, fi) < 0
        return: 1
    if: body != 0
        a0: l2_next_active(l2_call_actuals(body))
    t: 0
    nact: l2_m_arity[idx]
    nhid: l2_m_dyn[idx]
    # K04: a call through a callable formal forms the hidden inputs of the methods that reach the
    # formal (l2_cfl_classes), never the list of the method that declares it.  A dormant definition's
    # call forms none.
    hid: idx
    if: sel = 2 && mcall = 0
        # K04 S2 part two: one class of formation is formed as it is; more than one, by exact occurrence
        # (l2_emit_call_classes).
        cfi: fi
        if: l2_cfl_classes(mi, fi, node, @ ncls) != 0
            return: 1
        hid: 0 - 1
        nhid: 0
        if: ncls >= 1
            hid: l2_cfl_at(mi, fi, 0)
            nhid: l2_m_dyn[hid]
    ---
    # The class of the occurrence this call selected, chosen once, before the actuals (l2_emit_call_select).
    if: ncls > 1 && l2_emit_call_select(mi, fi, self_t, ind) != 0
        return: 1
    acts: 0
    hides: 0
    l2_alloc_kind: 4
    # One block: the actuals' texts (L2Tx), then a slot of 1024 bytes for each, where its text starts; a text
    # grows past its slot into storage of the translation (FIXED-BLOCKS-AUDIT, the expression text).
    if: nact > 0
        if: l2_mul_ok((cast: (size_t) nact), 1024U + c.sizeof(c.L2Tx)) = 0
            l2_alloc_err: 2
            return: l2_error(l2_src, node, "size overflow")
        acts: (cast: (@: L2Tx) l2_xmalloc((cast: (size_t) nact) * (1024U + c.sizeof(c.L2Tx))))
        if: acts = 0
            return: l2_error(l2_src, node, "out of memory")
        act_slots: (cast: (@: char) (acts + nact))
        memset((cast: (@: void) act_slots), 0, (cast: (size_t) nact) * 1024U)
        ak: 0
        while: ak < nact
            l2_tx_open(acts + ak, act_slots + (cast: (size_t) ak) * 1024U, 1024U)
            ak: ak + 1
        ---
    # The actuals are evaluated in the order they were written (book §10: fields are evaluated
    # in lexical order), each into its formal's place. A call bound with named actuals keeps its
    # written order beside its formal-ordered fields (l2_bound_find).
    if: body != 0
        bound: l2_bound_find(body)
    while: a0 != 0
        actual_span: l2_expr_span(a0)
        if: t >= nact || actual_span < 1
            return: l2_prep_drop(acts, hides)
        t: t + 1
        a0: l2_skip_span(a0, actual_span)
    ---
    if: t != nact
        return: l2_prep_drop(acts, hides)
    while: written < nact
        t: l2_bound_formal(bound, written)
        if: t < 0 || t >= nact
            return: l2_prep_drop(acts, hides)
        a0: l2_actual_field(l2_call_actuals(body), t)
        if: a0 = 0
            return: l2_prep_drop(acts, hides)
        actual_span: l2_expr_span(a0)
        occ_mi: 0 - 1
        l2_reference_source(a0, actual_span, mi, @ source)
        # A callable formal takes the occurrence its actual names, or one merge
        # built here in the caller's native code (T7). Not a call.
        if: l2_cf_get(idx, t) >= 0 && actual_span = 1 && a0\value != 0 && l2_frame_head(a0\value, "merge") != 0
            if: l2_t7_emit_actual(a0\value, mi, ind, l2_act_tx(acts, t)) != 0
                return: l2_prep_drop(acts, hides)
            ---
        else:
            if: l2_cf_get(idx, t) >= 0
                if: l2_cf_actual_emit(mi, a0, actual_span, ind, l2_act_tx(acts, t)) != 0
                    return: l2_prep_drop(acts, hides)
                ---
            ---
        ---
        if: l2_cf_get(idx, t) < 0 && l2_empty_actual(a0, idx, t) != 0 && l2_emit_empty_actual(idx, t, mi, ind, l2_act_tx(acts, t)) != 0
            return: l2_prep_drop(acts, hides)
        if: l2_cf_get(idx, t) < 0 && l2_empty_actual(a0, idx, t) = 0
            er: 2
            # A no-result unit method is the occurrence a nonprimitive formal receives.
            # Its fields are admitted by the pair map; the call is not evaluated here.
            if: l2_nsty_get(idx, t) >= 0
                occ_mi: l2_occ_actual(mi, a0, actual_span)
            if: occ_mi >= 0
                if: l2_cf_actual_emit(mi, a0, actual_span, ind, l2_act_tx(acts, t)) != 0
                    return: l2_prep_drop(acts, hides)
                if: l2_emit_formal_admits(mi, idx, cfi, ncls, self_t, t, 1, occ_mi, @ source, 0 - 1, l2_act_tx(acts, t)\data, ind) != 0
                    l2_prep_drop(acts, hides)
                    return: l2_error(l2_src, node, "internal: an occurrence was not admitted to its formal")
                ---
                er: 0
            ---
            if: occ_mi < 0 && l2_nsty_get(idx, t) < 0
                er: l2_emit_value_convert_field(node, a0, actual_span, l2_ft(idx, t), mi, ind, l2_act_tx(acts, t))
            if: occ_mi < 0 && actual_span >= 3 && l2_nsty_get(idx, t) >= 0
                er: l2_emit_actual_path(mi, a0, actual_span, ind, node, l2_act_tx(acts, t))
            if: er = 1
                return: l2_prep_drop(acts, hides)
            if: occ_mi < 0 && er = 2 && (actual_span < 1 || l2_emit_fields(a0, actual_span, mi, ind, l2_act_tx(acts, t)) != 0)
                return: l2_prep_drop(acts, hides)
            ---
        # A letter goes to a typed formal as its payload, admitted (D-57).
        if: occ_mi < 0 && actual_span = 1 && l2_nsty_get(idx, t) >= 0 && l2_untyped_graph(mi, a0\value) != 0 && l2_is_letter_name(mi, a0\value) != 0 && l2_payload_expr(l2_act_tx(acts, t)) != 0
            return: l2_prep_drop(acts, hides)
        if: occ_mi < 0 && actual_span = 1 && l2_nsty_get(idx, t) >= 0 && l2_untyped_graph(mi, a0\value) != 0 && l2_emit_formal_admits(mi, idx, cfi, ncls, self_t, t, 2, 0 - 1, @ source, 0 - 1, l2_act_tx(acts, t)\data, ind) != 0
            return: l2_prep_drop(acts, hides)
        # D-105 native (steps/d105-native.md): the actual of a formal admitted by name is recorded before
        # the call (l2_d105_emit_admit). An occurrence already registered its pair map above.
        # A dynamic candidate's refusal is this method's implicit `implements`: the input is formed here.
        dyn_mi: 0 - 1
        if: l2_d105_dynamic(@ source) != 0
            dyn_mi: mi
        if: occ_mi < 0 && l2_cf_get(idx, t) < 0 && l2_nsty_get(idx, t) >= 0 && l2_emit_formal_admits(mi, idx, cfi, ncls, self_t, t, 3, 0 - 1, @ source, dyn_mi, l2_act_tx(acts, t)\data, ind) != 0
            return: l2_prep_drop(acts, hides)
        written: written + 1
    ---
    if: ncls <= 1
        if: l2_emit_call_hides(mi, hid, nhid, nact, self_t, ind, node, mcall, cfi, @ hides) != 0
            return: l2_prep_drop(acts, hides)
        t: l2_tn
        l2_tn: l2_tn + 1
        if: l2_emit_call_result(idx, t, ind) != 0
            return: l2_prep_drop(acts, hides)
        if: l2_emit_call_go(mi, idx, hid, t, self_t, ind, nact, nhid, acts, hides) != 0
            return: l2_prep_drop(acts, hides)
        ---
    else:
        t: l2_tn
        l2_tn: l2_tn + 1
        if: l2_emit_call_result(idx, t, ind) != 0
            return: l2_prep_drop(acts, hides)
        if: l2_emit_call_classes(mi, idx, fi, t, self_t, ind, nact, acts, node) != 0
            return: l2_prep_drop(acts, hides)
        ---
    l2_prep_drop(acts, hides)
    # A conversion edge's call (Q33, `edge`): whatever its receiver throws is this
    # method's implicit throw `convert`; the receiver's names are not the caller's.
    if: l2_m_throws[idx] != 0 && edge != 0
        if: c.fprintf(l2_out, "%sif: l2_ts%d != 0\n", ind, t) < 0 || l2_emit_implicit_throw(mi, "convert", ind) != 0
            return: 1
        ---
    if: l2_m_throws[idx] != 0 && edge = 0 && l2_emit_propagate(mi, idx, t, ind) != 0
        return: 1
    # A callable without a result names no value: its temporary is never declared.
    if: l2_m_ret[idx] = 8
        return: l2_tx_clear(dest)
return: l2_tx_temp(dest, t)

# The unit's own occurrence of method idx (@: Lmx): what a callable formal receives.
fn: l2_tok_method_occ (int: idx; @: L2Tx dest) int
    if: idx < 0 || l2_unit_ref = 0
        return: 1
return: l2_occ_expr(idx, l2_unit_ref, dest)

# The physical occurrence selected from an already constructed unit.
fn: l2_occ_expr (int: mi; const: @(char unit); @: L2Tx dest) int
    []: char nm 32
    if: mi = l2_e
        return: l2_tx_set(dest, unit)
    if: c.snprintf(nm, 32U, ", %uU)", (cast: (unsigned) l2_occ_slot(mi))) < 0
        return: 1
return: l2_tx_join(dest, "lmx_arena_ref_struct(", unit, nm, 0, 0)

# Stream an occurrence only inside the builder, after its allocation phase.
# Namespace aliases already name their real parented objects; no nested path
# string or reconstruction object is needed. Reached local constructors have
# no global occurrence and must not borrow an unrelated unit slot.
fn: l2_emit_build_occ (int: mi) int
    int: ni
    int: slot
    if: mi < 0 || mi >= l2_m_n
        return: l2_error(l2_src, 0, "internal: invalid construction occurrence")
    if: mi = l2_e
        return: (cast: (int) (fputs("l2_entry_unit", l2_out) < 0))
    ni: l2_m_nsof(mi)
    if: ni >= 0
        return: (cast: (int) (c.fprintf(l2_out, "l2_nsp[%d]", ni) < 0))
    slot: l2_occ_slot(mi)
    if: slot < 0
        return: l2_error(l2_src, l2_m_node[mi], "internal: a construction occurrence has no source slot")
return: (cast: (int) (c.fprintf(l2_out, "lmx_arena_ref_struct(l2_entry_unit, %uU)", (cast: (unsigned) slot)) < 0))

# Follow the admitted unit-child/descriptor/backing contract, without allocation,
# scalar dirty caches, intern lookup, or descriptor rebinding.
fn: l2_emit_array_desc (int: oi; const: @(char ind); @: L2Tx dest) int
    int: t
    []: char nm 32
    []: char l2_eap_expr_own 128
    L2Tx: l2_eap_expr_tx
    @: L2Tx l2_eap_expr l2_tx_local(@ l2_eap_expr_tx, l2_eap_expr_own, 128U)
    if: oi < 0 || l2_own_is_array(l2_own_ty[oi]) = 0 || (l2_own_fid[oi] < 0 && l2_own_uchild[oi] < 0) || dest = 0
        c.fprintf(l1_stderr(), "l2trans detail: array descriptor unavailable oi=%d\n", oi)
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.fprintf(l2_out, "%s@@: void l2_a%d_leaf\n%s@: VoidArray l2_a%d_desc\n", ind, t, ind, t) < 0
        return: 1
    if: l2_own_from_expr(oi, l2_eap_expr) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_a%d_leaf: %s\n", ind, t, l2_eap_expr\data) < 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_a%d_desc: (cast: (@: VoidArray) l2_a%d_leaf[0])\n", ind, t, t) < 0
        return: 1
    if: c.snprintf(nm, 32U, "l2_a%d_desc", t) < 0
        return: 1
return: l2_tx_set(dest, nm)

# Backing is selected only by element operations; a whole Array is the
# descriptor above. Length and elements share that same physical selection.
fn: l2_emit_array_ptr (int: oi; const: @(char ind); @: L2Tx dest) int
    int: t l2_tn
    const: @(char element) "int"
    @: LmP0Field type_field
    []: char descriptor_own 128
    L2Tx: descriptor_tx
    @: L2Tx descriptor @ descriptor_tx
    []: char nm 32
    if: l2_tx_open(descriptor, descriptor_own, 128U) != 0 || l2_emit_array_desc(oi, ind, descriptor) != 0
        return: 1
    if: l2_own_ty[oi] = 5
        element: "char"
    if: l2_own_ty[oi] = 7
        element: "size_t"
    if: l2_own_ty[oi] = 37
        element: "ulong"
    if: l2_own_ty[oi] = 8
        type_field: l2_next_active(l2_own_decl[oi]\as\frame\body\first_field)
        if: type_field = 0 || type_field\value = 0 || type_field\value\kind != c.LM_P0_NODE_ATOM
            c.fprintf(l1_stderr(), "l2trans detail: imported array type spelling unavailable oi=%d\n", oi)
            return: 1
        ---
    if: l2_own_ty[oi] != 8 && l2_oc_is_parray(l2_own_ty[oi]) = 0 && c.fprintf(l2_out, "%s@: %s l2_a%d_data\n", ind, element, t) < 0
        return: 1
    if: l2_own_ty[oi] = 8
        if: c.fprintf(l2_out, "%s@: ", ind) < 0 || l2_write_text(l2_out, type_field\value\as\atom) != 0 || c.fprintf(l2_out, " l2_a%d_data\n", t) < 0
            return: 1
        ---
    if: l2_oc_is_parray(l2_own_ty[oi]) != 0
        if: fputs(ind, l2_out) < 0 || l2_emit_own_pointer_array_data_type(l2_out, l2_own_ty[oi]) != 0 || c.fprintf(l2_out, " l2_a%d_data\n", t) < 0
            return: 1
    ---
    if: l2_own_ty[oi] != 8 && l2_oc_is_parray(l2_own_ty[oi]) = 0 && c.fprintf(l2_out, "%sl2_a%d_data: (cast: (@: %s) %s\\data)\n", ind, t, element, descriptor\data) < 0
        return: 1
    if: l2_own_ty[oi] = 8
        if: c.fprintf(l2_out, "%sl2_a%d_data: (cast: (@: ", ind, t) < 0 || l2_write_text(l2_out, type_field\value\as\atom) != 0 || c.fprintf(l2_out, ") %s\\data)\n", descriptor\data) < 0
            return: 1
        ---
    if: l2_oc_is_parray(l2_own_ty[oi]) != 0
        if: c.fprintf(l2_out, "%sl2_a%d_data: (cast: (", ind, t) < 0 || l2_emit_own_pointer_array_data_type(l2_out, l2_own_ty[oi]) != 0 || c.fprintf(l2_out, ") %s\\data)\n", descriptor\data) < 0
            return: 1
        ---
    if: c.snprintf(nm, 32U, "l2_a%d_data", t) < 0
        return: 1
return: l2_tx_set(dest, nm)

fn: l2_emit_array_length (int: oi; const: @(char ind); @: L2Tx dest) int
    int: t l2_tn
    []: char descriptor_own 128
    L2Tx: descriptor_tx
    @: L2Tx descriptor @ descriptor_tx
    if: l2_tx_open(descriptor, descriptor_own, 128U) != 0 || l2_emit_array_desc(oi, ind, descriptor) != 0
        return: 1
    if: c.fprintf(l2_out, "%ssize_t: l2_t%d %s\\size\n", ind, t, descriptor\data) < 0
        return: 1
return: l2_tx_temp(dest, t)

# One native element path: literals and evaluated indices both produce the
# same typed backing access. Capture a dynamic index before evaluating a RHS.
fn: l2_emit_own_index (const: @(LmP0Text name); int: mi; const: @(char ind); @: int own; @: L2Tx index) int
    size_t: literal
    int: status
    int: field
    int: t
    []: char num 32
    []: char value_own 1024
    L2Tx: value_tx
    @: L2Tx value l2_tx_local(@ value_tx, value_own, 1024U)
    status: l2_own_index_head(name, mi, own, @ literal)
    if: status = 0
        if: c.snprintf(num, 32U, "%zuU", literal) < 0
            return: 1
        return: l2_tx_set(index, num)
    if: l2_dyn_own_index(mi, name, own, @ field) != 1
        return: 1
    if: l2_own_load(field, value) != 0
        return: 2
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.fprintf(l2_out, "%ssize_t: l2_t%d %s\n", ind, t, value\data) < 0 || l2_tx_temp(index, t) != 0
        return: 2
return: 0

fn: l2_emit_array_load_at (int: oi; const: @(char index); const: @(char ind); @: L2Tx dest) int
    int: t
    const: @(char element) "int"
    []: char ptr_own 1024
    L2Tx: ptr_tx
    @: L2Tx ptr l2_tx_local(@ ptr_tx, ptr_own, 1024U)
    if: l2_emit_array_ptr(oi, ind, ptr) != 0
        return: 1
    if: l2_own_ty[oi] = 5
        element: "char"
    if: l2_own_ty[oi] = 7
        element: "size_t"
    if: l2_own_ty[oi] = 37
        element: "ulong"
    if: l2_own_ty[oi] = 8
        # The admitted imported type is an unsigned-char alias. Keep its exact
        # spelling for ABI pointers, but widen a loaded value to L2's ordinary
        # unsigned scalar because L1 has no scalar unsigned-char declaration.
        element: "unsigned"
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_oc_is_parray(l2_own_ty[oi]) = 0 && c.fprintf(l2_out, "%s%s: l2_t%d\n", ind, element, t) < 0
        return: 1
    if: l2_oc_is_parray(l2_own_ty[oi]) != 0
        if: fputs(ind, l2_out) < 0 || l2_emit_own_pointer_type(l2_out, l2_oc_pointer(l2_oc_ft(l2_own_ty[oi]))) != 0 || c.fprintf(l2_out, " l2_t%d\n", t) < 0
            return: 1
    ---
    if: c.fprintf(l2_out, "%sl2_t%d: %s[%s]\n", ind, t, ptr\data, index) < 0
        return: 1
return: l2_tx_temp(dest, t)

fn: l2_emit_fields (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: L2Tx dest) int
    L2ValueSpan: indirect_span
    L2ValueSpan: indirect_operand
    @: L2ValueSpan indirect @ indirect_span
    int: indirect_levels
    int: indirect_source
    int: indirect_type
    int: indirect_count
    @: LmP0Field f
    @: LmP0Field p1
    @: LmP0Field p2
    @: LmP0Field p3
    @: LmP0Field p4
    @: LmP0Field p5
    @: LmP0Node at 0
    int: i
    int: ao
    int: after 0
    int: fld
    int: po
    int: fpr
    []: char chbuf_own 256
    @: char chbuf 0
    size_t: room 0U
    size_t: chn 0U
    int: chain
    int: chk
    int: cck
    int: ck
    int: have_value 0
    size_t: array_index
    int: array_count
    []: char apd_own 1024
    @: char apd 0
    size_t: apn 0U
    int: acnt 0
    int: akind 0
    int: aelem 0
    int: adepth 0
    int: ast 1
    size_t: ai0 0U
    size_t: ai1 0U
    @: LmP0Field aafter 0
    []: char buf_own 1024
    L2Tx: buf_tx
    @: L2Tx buf @ buf_tx
    []: char piece_own 1024
    L2Tx: piece_tx
    @: L2Tx piece @ piece_tx
    @: LmP0Field aidx_f
    []: char aptr 1024
    []: char occx_own 128
    L2Tx: occx_tx
    @: L2Tx occx l2_tx_local(@ occx_tx, occx_own, 128U)
    int: occt
    []: char pbuf_own 256
    @: char pbuf 0
    size_t: l2_pn2 0U
    int: pni2 0
    int: pres2 0
    int: poi2 0
    int: proot2 0
    int: pfi2 0
    int: pkind2 0
    int: pmi2 0
    int: pnt 0
    int: pcallee
    int: prc
    @: char path_operand 0
    L2Address: address_value
    @: L2Address address @ address_value
    L2IndexedOperand: indexed_value
    @: L2IndexedOperand indexed @ indexed_value
    L2ArrayPlace: array_place
    if: dest = 0 || l2_tx_open(buf, buf_own, 1024U) != 0 || l2_tx_open(piece, piece_own, 1024U) != 0
        return: 1
    # Preparation belongs to the selected logical arm, even when it only
    # loads a field/element and calls no method. All expression consumers
    # share the same lazy splitter, including direct call-actual lowering.
    if: l2_span_or(field, n) < n || l2_span_and(field, n) < n
        return: l2_eval_fields(field, n, mi, ind, dest)
    if: l2_address_operand(field, n, mi, address) = 0
        return: l2_emit_address(mi, address, ind, dest)
    # K01: a value-position field path whose member carries an occurrence
    # selector (`v\x`, `v\[N]x`) is one joined path, resolved by the common
    # path machinery and loaded as a number -- the same route a statement
    # initializer takes.  The atom-splitting walk below would otherwise emit
    # its atoms as an L1 member chain (NAMED-MODEL-OCCURRENCE-PATH-LOWERING);
    # a non-number leaf keeps the walk below.
    # A path's text of any length (l2_text_room), as l2_check_fields has it.
    room: l2_atoms_len(field, -1) + 1U
    pbuf: l2_text_room(room, pbuf_own, 256U)
    chbuf: l2_text_room(room, chbuf_own, 256U)
    apd: l2_text_room(room, apd_own, 1024U)
    if: pbuf = 0 || chbuf = 0 || apd = 0
        return: l2_alloc_or(l2_src, 0, "out of memory")
    pbuf[0]: 0
    l2_pn2: l2_join_path(field, n, pbuf, room - 1U)
    if: l2_pn2 != 0U && l2_path_root(pbuf, l2_pn2, @ pni2, @ pres2, @ poi2, @ proot2, @ pfi2) = 0
        pkind2: l2_path_kind(pbuf, l2_pn2, @ pmi2)
        if: pkind2 = 0 || pkind2 = 1 || pkind2 = 7 || pkind2 = 8 || pkind2 = 9
            if: l2_emit_path(pbuf, l2_pn2, mi, ind, l2_next_active(field)\value, @ pkind2) != 0
                return: 1
            # The read is materialized into a typed temp where the path is
            # evaluated -- an explicit path read of a call actual must capture
            # its cell before the call's checkpoint publishes a working value
            # (book §12: unit_body_path_for's `pair(acc for\j)`).
            pnt: l2_tn
            l2_tn: l2_tn + 1
            if: pkind2 = 0 && c.fprintf(l2_out, "%ssize_t: l2_t%d\n%sl2_t%d: lmx_size_value_known(l2_pxp[0])\n", ind, pnt, ind, pnt) < 0
                return: 1
            if: pkind2 = 1 && c.fprintf(l2_out, "%schar: l2_t%d\n%sl2_t%d: (cast: (char) lmx_char_value_known(l2_pxp[0]))\n", ind, pnt, ind, pnt) < 0
                return: 1
            if: pkind2 = 7 && c.fprintf(l2_out, "%sint: l2_t%d\n%sl2_t%d: lmx_int_value_known(l2_pxp[0])\n", ind, pnt, ind, pnt) < 0
                return: 1
            if: pkind2 = 8 && c.fprintf(l2_out, "%sunsigned: l2_t%d\n%sl2_t%d: lmx_unsigned_value_known(l2_pxp[0])\n", ind, pnt, ind, pnt) < 0
                return: 1
            if: pkind2 = 9 && c.fprintf(l2_out, "%sulong: l2_t%d\n%sl2_t%d: lmx_ulong_value_known(l2_pxp[0])\n", ind, pnt, ind, pnt) < 0
                return: 1
            if: l2_tx_temp(dest, pnt) != 0
                return: l2_alloc_or(l2_src, l2_next_active(field)\value, "out of memory")
            return: 0
        ---
    ---
    l2_tx_clear(buf)
    if: n = 1
        return: l2_prep(l2_next_active(field)\value, mi, ind, dest)
    f: l2_next_active(field)
    i: 0
    ao: 0
    while: i < n && f != 0 && f\value != 0
        at: f\value
        indirect\first: f
        indirect\node: at
        indirect\count: l2_operand_run(f, n - i)
        if: have_value = 0 && l2_indirect_span(indirect, mi, @ indirect_operand, @ indirect_levels, @ indirect_source, @ indirect_type) = 0
            if: l2_emit_indirect_span(@ indirect_operand, indirect_levels, indirect_source, mi, ind, piece) != 0
                return: 1
            if: l2_tx_cat(buf, piece\data) != 0
                return: l2_alloc_or(l2_src, at, "out of memory")
            indirect_count: indirect\count
            i: i + indirect_count
            f: l2_skip_span(f, indirect_count)
            have_value: 1
            ao: 0
            after: 0
            continue
        if: l2_address_operand(f, indirect\count, mi, address) = 0
            if: l2_emit_address(mi, address, ind, piece) != 0
                return: 1
            if: l2_tx_cat(buf, piece\data) != 0
                return: l2_alloc_or(l2_src, at, "out of memory")
            indirect_count: indirect\count
            i: i + indirect_count
            f: l2_skip_span(f, indirect_count)
            have_value: 1
            ao: 0
            after: 0
            continue
        # K03 S6: a path operand that selects a callable is its nullary call on the occurrence the path selects
        # (l2_emit_path, sel 1), its result the operand, as `Holder\tick()`'s is.
        pcallee: l2_path_run_callee(f, indirect\count, mi, @ path_operand)
        if: pcallee >= 0
            l2_tx_clear(piece)
            prc: l2_emit_path(path_operand, c.strlen(path_operand), mi, ind, at, @ l2_call_k)
            if: prc = 0 && l2_m_ret[pcallee] != 8
                prc: l2_emit_call(at, pcallee, 1, 0 - 1, 0, mi, ind, piece, 0)
            if: prc = 0 && l2_m_ret[pcallee] = 8
                prc: l2_selected_occurrence_temp(ind, piece)
            l2_xfree((cast: (@: void) path_operand))
            path_operand: 0
            if: prc != 0
                return: 1
            if: l2_tx_cat(buf, piece\data) != 0
                return: l2_alloc_or(l2_src, at, "out of memory")
            indirect_count: indirect\count
            i: i + indirect_count
            f: l2_skip_span(f, indirect_count)
            have_value: 1
            ao: 0
            after: 0
            continue
        ast: l2_array_span(f, n - i, mi, @ array_place)
        if: ast = 3
            return: 1
        if: ast = 2
            return: l2_error(l2_src, at, "the Array element has no supported value contract")
        if: ast = 0
            ast: l2_emit_array_place_operand(at, mi, ind, @ array_place, piece)
            l2_array_place_release(@ array_place)
            if: ast != 0
                return: 1
            if: l2_tx_cat(buf, piece\data) != 0
                return: l2_alloc_or(l2_src, at, "out of memory")
            ao: 0
            after: 0
            have_value: 1
            i: i + array_place.count
            f: l2_skip_span(f, (array_place.count))
            continue
        ast: l2_indexed_operand(f, n - i, mi, indexed)
        if: ast > 1
            return: l2_error(l2_src, at, "own array index requires a supported integer expression")
        if: ast = 0
            if: l2_emit_indexed(indexed, mi, ind, piece) != 0
                return: 1
            if: l2_tx_cat(buf, piece\data) != 0
                return: l2_alloc_or(l2_src, at, "out of memory")
            ao: 0
            after: 0
            have_value: 1
            i: i + indexed\count
            f: indexed\after
            continue
        ast: l2_arr_operand(f, 0, apd, room, @ apn, @ acnt, @ aafter, @ akind, @ aelem, @ adepth, @ ai0, @ ai1)
        if: ast = 0
            if: l2_emit_arr_operand(mi, apd, apn, akind, aelem, adepth, ai0, ai1, 0, ind, at, piece) != 0
                return: 1
            if: l2_tx_cat(buf, piece\data) != 0
                return: l2_alloc_or(l2_src, at, "out of memory")
            ao: 0
            after: 0
            have_value: 1
            i: i + acnt
            f: aafter
            continue
        # Resolve one complete operand, not the whole arithmetic/comparison
        # arm. The shared span keeps every [N] selector and nesting level.
        # Raw C members remain excluded by the ordinary root classification.
        path_operand: l2_address_path_text(f, indirect\count)
        if: path_operand != 0
            cck: l2_path_chain_check(mi, f\value\as\atom, path_operand, c.strlen(path_operand), @ chk)
            if: cck = 1 || cck = 2
                l2_xfree((cast: (@: void) path_operand))
                if: cck = 1
                    return: l2_error(l2_src, at, "a field path must end at a primitive field")
                return: l2_error(l2_src, at, "unknown field path segment")
            ---
            if: cck = 0
                chain: l2_path_text_read(mi, path_operand, c.strlen(path_operand), ind, at, piece)
                l2_xfree((cast: (@: void) path_operand))
                if: chain != 0
                    return: 1
                if: l2_tx_cat(buf, piece\data) != 0
                    return: l2_alloc_or(l2_src, at, "out of memory")
                ao: 0
                after: 0
                have_value: 1
                i: i + indirect\count
                f: l2_skip_span(f, indirect\count)
                continue
            ---
            l2_xfree((cast: (@: void) path_operand))
        ---
        fld: 0
        l2_tx_clear(piece)
        p1: 0
        p2: 0
        po: -1
        if: f\value\kind = c.LM_P0_NODE_ATOM
            p1: l2_next_active(f\next)
        if: p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom)
            p2: l2_next_active(p1\next)
        # A field path off an own field, a namespace-typed name, or node/for
        # -- FABLE-SONNET-NODE-ROOT-20260923-121, FABLE-SONNET-FIELD-PATHS-
        # 20260923-113.
        # D-112: a path deeper than one field is one value, read by the general path walk
        # (l2_path_text_read); its first hop alone is a Structure field, and the single-hop read below
        # failed on it without a word.
        chain: l2_path_chain(f, chbuf, room, @ chn)
        cck: 0 - 1
        if: chain > 0
            cck: l2_path_chain_check(mi, f\value\as\atom, chbuf, chn, @ chk)
        # A value the check does not see (a `return:` value, a call's actual) is refused here as the check refuses it --
        # never the single-hop read with the rest written out raw (it gave `l2_t1\while\j`).
        if: cck = 1
            return: l2_error(l2_src, f\value, "a field path must end at a primitive field")
        if: cck = 2
            return: l2_error(l2_src, f\value, "unknown field path segment")
        if: cck = 0
            if: l2_path_text_read(mi, chbuf, chn, ind, at, piece) != 0
                return: 1
            if: l2_tx_cat(buf, piece\data) != 0
                return: l2_alloc_or(l2_src, at, "out of memory")
            ao: 0
            after: 0
            have_value: 1
            i: i + chain
            ck: 0
            while: ck < chain && f != 0
                f: l2_next_active(f\next)
                ck: ck + 1
            ---
            continue
        ---
        fpr: 0 - 1
        if: p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM
            fpr: l2_field_path_read(mi, f\value\as\atom, p2\value\as\atom, ind, at, piece)
        if: fpr = 1
            return: 1
        if: fpr = 0
            if: l2_tx_cat(buf, piece\data) != 0
                return: l2_alloc_or(l2_src, at, "out of memory")
            ao: 0
            after: 0
            have_value: 1
            i: i + 3
            f: l2_next_active(p2\next)
            continue
        # `merged\[N]x` -- see l2_check_fields.
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(f\value\as\atom) != 0 && l2_mres_find(mi, f\value\as\atom) >= 0 && p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom) && p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(p2\value\as\atom, "[") != 0
            p3: l2_next_active(p2\next)
            p4: 0
            p5: 0
            if: p3 != 0
                p4: l2_next_active(p3\next)
            if: p4 != 0
                p5: l2_next_active(p4\next)
            if: p3 = 0 || p3\value = 0 || p3\value\kind != c.LM_P0_NODE_ATOM || l2_num(p3\value\as\atom) = 0 || p4 = 0 || p4\value = 0 || p4\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(p4\value\as\atom, "]") = 0 || p5 = 0 || p5\value = 0 || p5\value\kind != c.LM_P0_NODE_ATOM || l2_ident(p5\value\as\atom) = 0
                return: 1
            l2_tx_clear(piece)
            if: l2_mrs_occ_read(l2_mres_find(mi, f\value\as\atom), p5\value\as\atom, (cast: (int) l2_literal_value(p3\value\as\atom)), mi, ind, piece, f\value) != 0
                return: 1
            if: l2_tx_cat(buf, piece\data) != 0
                return: l2_alloc_or(l2_src, f\value, "out of memory")
            ao: 0
            after: 0
            have_value: 1
            i: i + 6
            f: l2_next_active(p5\next)
            continue
        # A method name as a path root denotes its occurrence -- see
        # l2_check_fields's copy of this comment (FABLE-SONNET-OCC-ROOT-
        # 20260924-146): recognized at the flat-token level, not inside
        # l2_path_root, reusing l2_find_method and l2_own_find_occ (the same
        # pair the rootless `\[N]name` form just below already uses).
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(f\value\as\atom) != 0 && l2_find_method(f\value\as\atom) >= 0 && p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom) && p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(p2\value\as\atom, "[") != 0
            p3: l2_next_active(p2\next)
            p4: 0
            p5: 0
            if: p3 != 0
                p4: l2_next_active(p3\next)
            if: p4 != 0
                p5: l2_next_active(p4\next)
            if: p3 = 0 || p3\value = 0 || p3\value\kind != c.LM_P0_NODE_ATOM || l2_num(p3\value\as\atom) = 0 || p4 = 0 || p4\value = 0 || p4\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(p4\value\as\atom, "]") = 0 || p5 = 0 || p5\value = 0 || p5\value\kind != c.LM_P0_NODE_ATOM || l2_ident(p5\value\as\atom) = 0
                return: 1
            po: l2_own_find_occ(l2_find_method(f\value\as\atom), p5\value\as\atom, (cast: (int) l2_literal_value(p3\value\as\atom)))
            if: po < 0 || l2_m_uses[l2_own_off(l2_find_method(f\value\as\atom), po)] = 0
                return: l2_error(l2_src, p5\value, "no such occurrence")
            # This own row belongs to ANOTHER method's activation, not the
            # one this C function is being emitted for: l2_q%d is that
            # OTHER method's own local, out of scope here (a same-method
            # rootless \[N]name never has this problem). Read it through
            # the graph instead, l2_own_from_expr, the same accessor
            # l2_emit_array_ptr and l2_emit_own_from already use for a
            # cross-activation own cell.
            if: l2_own_from_expr(po, occx) != 0
                return: 1
            if: c.fprintf(l2_out, "%sl2_xp: %s\n", ind, occx\data) < 0
                return: 1
            occt: l2_tn
            l2_tn: l2_tn + 1
            if: l2_emit_own_cell_load(po, ind, occt, at) != 0
                return: 1
            if: l2_tx_temp(piece, occt) != 0 || l2_tx_cat(buf, piece\data) != 0
                return: l2_alloc_or(l2_src, at, "out of memory")
            ao: 0
            after: 0
            have_value: 1
            i: i + 6
            f: l2_next_active(p5\next)
            continue
        # `test\arg` (no [N]): unqualified is the LAST occurrence
        # (FABLE-SONNET-LAST-OCCURRENCE-20260924-164) -- see l2_check_fields's
        # copy of this comment.
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(f\value\as\atom) != 0 && l2_find_method(f\value\as\atom) >= 0 && p1 != 0 && p1\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(p1\value\as\atom) && p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && l2_ident(p2\value\as\atom) != 0
            po: l2_own_find_last(l2_find_method(f\value\as\atom), p2\value\as\atom)
            if: po < 0
                return: l2_error(l2_src, p2\value, "unresolved name")
            if: l2_m_uses[l2_own_off(l2_find_method(f\value\as\atom), po)] = 0
                return: l2_error(l2_src, p2\value, "no such occurrence")
            if: l2_own_from_expr(po, occx) != 0
                return: 1
            if: c.fprintf(l2_out, "%sl2_xp: %s\n", ind, occx\data) < 0
                return: 1
            occt: l2_tn
            l2_tn: l2_tn + 1
            if: l2_emit_own_cell_load(po, ind, occt, at) != 0
                return: 1
            if: l2_tx_temp(piece, occt) != 0 || l2_tx_cat(buf, piece\data) != 0
                return: l2_alloc_or(l2_src, at, "out of memory")
            ao: 0
            after: 0
            have_value: 1
            i: i + 3
            f: l2_next_active(p2\next)
            continue
        if: after != 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_ident(f\value\as\atom)
            fld: 1
        if: fld = 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(f\value\as\atom, "@")
            if: l2_addr_tail(f, @ aidx_f, @ p2) = 0
                if: l2_address_name(mi, aidx_f\value\as\atom, address) != 0 || l2_emit_address(mi, address, ind, piece) != 0
                    return: l2_error(l2_src, aidx_f\value, "unresolved addressable name")
                if: l2_tx_cat(buf, piece\data) != 0
                    return: l2_alloc_or(l2_src, at, "out of memory")
                ao: 0
                after: 0
                have_value: 1
                i: i + 2
                f: p2
                continue
            ---
            if: l2_tx_cat(buf, "@ ") != 0
                return: l2_alloc_or(l2_src, at, "out of memory")
            ao: 0
            after: 0
            have_value: 0
            i: i + 1
            f: l2_next_active(f\next)
            continue
        if: f\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(f\value\as\atom)
            p1: l2_next_active(f\next)
            p2: 0
            p3: 0
            p4: 0
            if: p1 != 0
                p2: l2_next_active(p1\next)
            if: p2 != 0
                p3: l2_next_active(p2\next)
            if: p3 != 0
                p4: l2_next_active(p3\next)
            if: have_value = 0 && p1 != 0 && p2 != 0 && p3 != 0 && p4 != 0 && p1\value != 0 && p2\value != 0 && p3\value != 0 && p4\value != 0 && p1\value\kind = c.LM_P0_NODE_ATOM && p2\value\kind = c.LM_P0_NODE_ATOM && p3\value\kind = c.LM_P0_NODE_ATOM && p4\value\kind = c.LM_P0_NODE_ATOM && l2_text_eq(p1\value\as\atom, "[") != 0 && l2_num(p2\value\as\atom) != 0 && l2_text_eq(p3\value\as\atom, "]") != 0 && l2_ident(p4\value\as\atom) != 0
                po: l2_own_find_occ(mi, p4\value\as\atom, (cast: (int) l2_literal_value(p2\value\as\atom)))
                if: po < 0 || l2_m_uses[l2_own_off(mi, po)] = 0
                    return: l2_error(l2_src, p4\value, "no such occurrence")
                if: l2_own_load(po, piece) != 0
                    return: 1
                if: l2_tx_cat(buf, piece\data) != 0
                    return: l2_alloc_or(l2_src, at, "out of memory")
                ao: 0
                after: 0
                have_value: 1
                i: i + 5
                f: l2_next_active(p4\next)
                continue
            ---
            if: l2_tx_cat(buf, "\\") != 0
                return: l2_alloc_or(l2_src, at, "out of memory")
            ao: 0
            if: have_value != 0
                after: 1
            else:
                after: 0
            ---
            fld: 2
        if: fld = 1
            if: l2_tok_tx(piece, f\value\as\atom) != 0 || l2_tx_cat(buf, piece\data) != 0
                return: l2_alloc_or(l2_src, at, "out of memory")
            ao: 0
            after: 0
            have_value: 1
        if: fld = 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_brack(f\value\as\atom)
            if: l2_tok_tx(piece, f\value\as\atom) != 0 || l2_tx_cat(buf, piece\data) != 0
                return: l2_alloc_or(l2_src, at, "out of memory")
            ao: 0
            fld: 2
        if: fld = 0 && f\value\kind = c.LM_P0_NODE_ATOM && l2_is_binop(f\value\as\atom)
            if: l2_tx_cat(buf, " ") != 0
                return: l2_alloc_or(l2_src, at, "out of memory")
            if: l2_tok_tx(piece, f\value\as\atom) != 0 || l2_tx_cat(buf, piece\data) != 0
                return: l2_alloc_or(l2_src, at, "out of memory")
            if: l2_tx_cat(buf, " ") != 0
                return: l2_alloc_or(l2_src, at, "out of memory")
            ao: l2_is_andor(f\value\as\atom)
            have_value: 0
            fld: 2
        if: fld = 0 && ao != 0 && f\value\kind = c.LM_P0_NODE_FRAME && l2_head_is_method_call(mi, f\value\as\frame\head) != 0
            return: 1
        if: fld = 0 && (ao = 0 || f\value\kind != c.LM_P0_NODE_FRAME || l2_head_is_method_call(mi, f\value\as\frame\head) = 0) && l2_prep(f\value, mi, ind, piece) != 0
            return: 1
        if: fld = 0 && (ao = 0 || f\value\kind != c.LM_P0_NODE_FRAME || l2_head_is_method_call(mi, f\value\as\frame\head) = 0) && l2_tx_cat(buf, piece\data) != 0
            return: l2_alloc_or(l2_src, at, "out of memory")
        if: fld = 0
            ao: 0
            after: 0
            have_value: 1
        f: l2_next_active(f\next)
        i: i + 1
    if: l2_tx_set(dest, buf\data) != 0
        return: l2_alloc_or(l2_src, at, "out of memory")
return: 0

fn: l2_eval_and (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: L2Tx dest) int
    @: LmP0Field f
    @: LmP0Field nxt
    int: span
    int: rest
    @: char deep 0
    []: char rhs_own 1024
    L2Tx: rhs_tx
    @: L2Tx rhs @ rhs_tx
    if: dest = 0 || n <= 0 || l2_tx_open(rhs, rhs_own, 1024U) != 0
        return: 1
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    span: l2_span_and(field, n)
    if: span = n
        return: l2_emit_fields(field, n, mi, ind, dest)
    if: l2_new_temp(ind, dest) != 0
        return: 1
    f: l2_next_active(field)
    if: l2_emit_fields(f, span, mi, ind, rhs) != 0
        return: 1
    if: l2_bool_set(ind, dest\data, rhs\data) != 0
        return: 1
    rest: n - span
    nxt: l2_advance(f, span)
    if: rest > 0 && nxt != 0 && l2_is_and_atom(nxt\value)
        rest: rest - 1
        nxt: l2_next_active(nxt\next)
    while: rest > 0 && nxt != 0
        span: l2_span_and(nxt, rest)
        if: c.fprintf(l2_out, "%sif: %s\n", ind, dest\data) < 0
            return: 1
        if: l2_emit_fields(nxt, span, mi, deep, rhs) != 0
            return: 1
        if: l2_bool_set(deep, dest\data, rhs\data) != 0
            return: 1
        rest: rest - span
        nxt: l2_advance(nxt, span)
        if: rest > 0 && nxt != 0 && l2_is_and_atom(nxt\value)
            rest: rest - 1
            nxt: l2_next_active(nxt\next)
        ---
return: 0

fn: l2_eval_fields (@: LmP0Field field; int: n; int: mi; const: @(char ind); @: L2Tx dest) int
    @: LmP0Field f
    @: LmP0Field nxt
    int: span
    int: rest
    @: char deep 0
    []: char rhs_own 1024
    L2Tx: rhs_tx
    @: L2Tx rhs @ rhs_tx
    if: dest = 0 || n <= 0 || l2_tx_open(rhs, rhs_own, 1024U) != 0
        return: 1
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    span: l2_span_or(field, n)
    if: span = n
        return: l2_eval_and(field, n, mi, ind, dest)
    if: l2_new_temp(ind, dest) != 0
        return: 1
    f: l2_next_active(field)
    if: l2_eval_and(f, span, mi, ind, rhs) != 0
        return: 1
    if: l2_bool_set(ind, dest\data, rhs\data) != 0
        return: 1
    rest: n - span
    nxt: l2_advance(f, span)
    if: rest > 0 && nxt != 0 && l2_is_or_atom(nxt\value)
        rest: rest - 1
        nxt: l2_next_active(nxt\next)
    while: rest > 0 && nxt != 0
        span: l2_span_or(nxt, rest)
        if: c.fprintf(l2_out, "%sif: %s = 0\n", ind, dest\data) < 0
            return: 1
        if: l2_eval_and(nxt, span, mi, deep, rhs) != 0
            return: 1
        if: l2_bool_set(deep, dest\data, rhs\data) != 0
            return: 1
        rest: rest - span
        nxt: l2_advance(nxt, span)
        if: rest > 0 && nxt != 0 && l2_is_or_atom(nxt\value)
            rest: rest - 1
            nxt: l2_next_active(nxt\next)
        ---
return: 0

# One formal of a generated signature: its FORMAL type code, the method, and its position among
# the method's parameters (declared formals first, hidden/dynamic inputs after them).
# With `arg` 1, the same formal is written as its TRAMPOLINE input (l2_emit_trampoline): the
# argument read from refs[idx].  A scalar is read from the typed storage its reference addresses
# (a cell is that storage, lmx_value_owned.lm1); a pointer is the reference itself.  With `arg` 2
# only a by-value foreign input writes something: the trampoline's typed pointer to that storage.
# One table spells all three, so a trampoline passes exactly the arguments the signature declares.
fn: l2_emit_formal (int: ft; int: mi; int: idx; int: arg) int
    int: oty
    const: @(char sig) 0
    const: @(char read) 0
    []: char ref_own 64
    L2Tx: ref_tx
    @: L2Tx ref l2_tx_local(@ ref_tx, ref_own, 64U)
    if: arg = 1 && (ref = 0 || l2_tramp_ref(mi, idx, ref) != 0)
        return: 1
    # K04 S2: a forward-only input is its entry of refs in the typed body, under a name of its own so that no
    # read of the value can be written against it. An input the method resolves
    # itself comes through the ordinary unmarshaler using l2_href<idx>.
    if: idx >= l2_m_arity[mi] && l2_dyn_fwd(mi, idx - l2_m_arity[mi]) != 0
        if: arg = 0 && c.fprintf(l2_out, "; @: void l2_pr%d_%d", mi, idx) < 0
            return: 1
        if: arg = 1 && c.fprintf(l2_out, ", refs[%d]", idx) < 0
            return: 1
        return: 0
    ---
    if: ft = 0
        sig: "; int: l2_p%d_%d"
        read: ", lmx_int_value_known(%s)"
    if: ft = 1
        sig: "; char: l2_p%d_%d"
        read: ", (cast: (char) lmx_char_value_known(%s))"
    if: ft = 2
        sig: "; size_t: l2_p%d_%d"
        read: ", lmx_size_value_known(%s)"
    if: ft = 34
        sig: "; unsigned: l2_p%d_%d"
        read: ", lmx_unsigned_value_known(%s)"
    if: ft = 36
        sig: "; ulong: l2_p%d_%d"
        read: ", lmx_ulong_value_known(%s)"
    if: ft = 3
        sig: "; const: @(char l2_p%d_%d)"
    if: ft = 9
        sig: "; @: size_t l2_p%d_%d"
    if: ft = 11
        sig: "; @: int l2_p%d_%d"
    if: ft = 12
        sig: "; @: char l2_p%d_%d"
    if: ft = 16
        sig: "; @: void l2_p%d_%d"
    if: ft = 17
        sig: "; @@: char l2_p%d_%d"
    if: ft = 18
        sig: "; @@: void l2_p%d_%d"
    if: ft = 19
        sig: "; @@: int l2_p%d_%d"
    if: ft = 24
        sig: "; @@: unsigned l2_p%d_%d"
    if: ft = 39
        sig: "; @@: ulong l2_p%d_%d"
    if: ft = 25
        sig: "; @: unsigned l2_p%d_%d"
    if: ft = 38
        sig: "; @: ulong l2_p%d_%d"
    if: ft = 20
        sig: "; @@: size_t l2_p%d_%d"
    if: sig != 0 && arg = 0 && c.fprintf(l2_out, sig, mi, idx) < 0
        return: 1
    if: sig != 0 && arg = 1 && read != 0 && c.fprintf(l2_out, read, ref\data) < 0
        return: 1
    if: sig != 0 && arg = 1 && read = 0 && c.fprintf(l2_out, ", lmx_pointer_value_known(%s)", ref\data) < 0
        return: 1
    # A graph formal holds the graph code, spelled `Lmx *`.
    ft: l2_formal_raw(ft)
    if: ft >= 100 && l2_emit_foreign_formal(l2_out, ft, mi, idx, arg) != 0
        return: 1
return: 0

# The return type of method mi as its signature spells it: a named-Structure return holds the graph code, spelled
# as the raw foreign `Lmx *` l2_emit_foreign_return expects (l2_formal_raw), as l2_emit_formal spells a formal.  Read
# raw, `fn: same (Model: x) Model / return: x` once failed translation with no located diagnostic
# (FABLE-SONNET-DECL-PREPASS-20260923-137 part 2).  The signature and the method's trampoline both read it here.
fn: l2_sig_ret (int: mi) int
return: l2_formal_raw(l2_m_ret[mi])

fn: l2_emit_sig (int: mi) int
    int: j 0
    long: mark
    int: ret_ty
    []: char declaration_own 1024
    L2Tx: declaration_tx
    @: L2Tx declaration l2_tx_local(@ declaration_tx, declaration_own, 1024U)
    ret_ty: l2_sig_ret(mi)
    if: fputs(" (@: Lmx node; @: Lmx self", l2_out) < 0
        return: 1
    while: j < l2_m_arity[mi]
        if: l2_emit_formal(l2_ft(mi, j), mi, j, 0) != 0
            return: 1
        j: j + 1
    j: 0
    while: j < l2_m_dyn[mi]
        # A hidden formal that spells nothing is a signature that quietly lacks a parameter.
        mark: c.ftell(l2_out)
        if: l2_emit_formal(l2_ft_of_own(l2_own_of_dt(l2_dt(mi, j))), mi, l2_m_arity[mi] + j, 0) != 0
            return: 1
        if: c.ftell(l2_out) = mark
            return: l2_error(l2_src, l2_m_node[mi], "dynamic input type has no formal spelling")
        j: j + 1
    # Declared-throw ABI: the outputs follow every input, the normal result
    # first and the throw payload last, and the control status is the return.
    # A callable that cannot throw keeps its direct return unchanged.
    if: l2_m_throws != 0 && l2_m_throws[mi] != 0
        if: ret_ty = 1 && fputs("; @: char l2_out_result", l2_out) < 0
            return: 1
        if: ret_ty = 2 && fputs("; @: size_t l2_out_result", l2_out) < 0
            return: 1
        if: ret_ty = 33 && fputs("; @: unsigned l2_out_result", l2_out) < 0
            return: 1
        if: ret_ty = 36 && fputs("; @: ulong l2_out_result", l2_out) < 0
            return: 1
        if: ret_ty = 3 && fputs("; @@: char l2_out_result", l2_out) < 0
            return: 1
        if: ret_ty = 16 && fputs("; @@: void l2_out_result", l2_out) < 0
            return: 1
        if: ret_ty = 35 && fputs("; const: @@(char l2_out_result)", l2_out) < 0
            return: 1
        if: ret_ty = 32 && fputs("; @@@: char l2_out_result", l2_out) < 0
            return: 1
        if: ret_ty >= 100 && (l2_value_decl_text(ret_ty, 1, "l2_out_result", declaration) != 0 || c.fprintf(l2_out, "; %s", declaration\data) < 0)
            return: 1
        if: l2_ret_uns(mi) = 0 && ret_ty != 1 && ret_ty != 3 && ret_ty != 8 && ret_ty != 16 && ret_ty != 32 && ret_ty != 35 && ret_ty < 100 && fputs("; @: int l2_out_result", l2_out) < 0
            return: 1
        if: fputs("; @@: Lmx l2_out_throw) int", l2_out) < 0
            return: 1
        return: 0
    ---
    if: ret_ty = 1 && fputs(") char", l2_out) < 0
        return: 1
    if: ret_ty = 2 && fputs(") size_t", l2_out) < 0
        return: 1
    if: ret_ty = 33 && fputs(") unsigned", l2_out) < 0
        return: 1
    if: ret_ty = 36 && fputs(") ulong", l2_out) < 0
        return: 1
    if: ret_ty = 3 && fputs(") @: char", l2_out) < 0
        return: 1
    if: ret_ty = 16 && fputs(") @: void", l2_out) < 0
        return: 1
    if: ret_ty = 35 && fputs(") const: @(char)", l2_out) < 0
        return: 1
    if: ret_ty = 32 && fputs(") @@: char", l2_out) < 0
        return: 1
    if: ret_ty >= 100 && l2_emit_foreign_return(l2_out, ret_ty) != 0
        return: 1
    if: ret_ty = 8 && fputs(")", l2_out) < 0
        return: 1
    if: l2_ret_uns(mi) = 0 && ret_ty != 1 && ret_ty != 3 && ret_ty != 8 && ret_ty != 16 && ret_ty != 32 && ret_ty != 35 && ret_ty < 100 && fputs(") int", l2_out) < 0
        return: 1
return: 0

# The formal type code of input k of method mi, in signature order: declared formals first,
# hidden/dynamic inputs after them.
fn: l2_input_ft (int: mi; int: k) int
    if: k < l2_m_arity[mi]
        return: l2_ft(mi, k)
return: l2_ft_of_own(l2_own_of_dt(l2_dt(mi, k - l2_m_arity[mi])))

# THE TRAMPOLINE (FABLE-OPUS-ROOT-WALK-TRANSLATOR-20260924-159; plan §3 «Пользовательский код
# интерпретируется по умолчанию»; steps/root-walk-trampolines.md).  Every method with a native
# body has one more entry, with the uniform prim ABI LmxPrimitiveEntry (owner, refs, nargs,
# dest, out) -> status (lmx_primitive.h.lm1), and its native word is that entry: a walked body's
# call op, lmx_call0 and every generated call reach the selected native method
# through this adapter. Only the selected adapter invokes its typed body symbol.
#   * owner is the method's occurrence: node = owner\parent (lmx_call_node), self = owner;
#   * refs are the inputs in signature order, read by l2_emit_formal's own table;
#   * nargs that differs from the signature is the caller's broken promise -- the translator
#     wrote both -- so it is X1, never a status;
#   * the status is the method's own throw status (S1.1: declared names 1..d in `throws:`
#     order, implicit d+g), 0 for a method that cannot throw; on a throw `out` carries the
#     thrown record (the method's l2_out_throw);
#   * the result reaches the caller the way the walker takes values: a scalar is written into
#     the typed storage `dest` addresses and `out` is dest; a pointer is the reference itself
#     in `out`; no result leaves `out` 0.
# A method with a native body: a body, or a return trailer that is its body.
fn: l2_m_native (int: i) int
    if: i < 0
        return: 0
    if: l2_mad_on(i) != 0
        return: 1
return: (cast: (int) (l2_m_body[i] != 0 || (l2_m_node[i] != 0 && l2_m_node[i]\as != 0 && l2_ret_tr(l2_m_node[i]\as\frame) != 0)))

# How a trampoline delivers the result of method mi -- the cases l2_emit_sig spells: 0 none,
# 1 int, 2 size_t, 3 unsigned, 4 ulong, 5 a pointer (the reference itself), 6 a foreign value
# (the typed storage `dest` addresses).
fn: l2_tramp_class (int: mi) int
    int: rt l2_sig_ret(mi)
    int: fi
    if: rt = 8
        return: 0
    if: rt = 2
        return: 2
    if: rt = 33
        return: 3
    if: rt = 36
        return: 4
    if: rt = 3 || rt = 16 || rt = 35 || rt = 32
        return: 5
    # Foreign by-value results have exact destination storage even when throwing.
    fi: rt - 100
    if: rt >= 100 && fi < l2_foreign_n && l2_foreign_depth[fi] = 0
        return: 6
    if: rt >= 100
        return: 5
    if: l2_ret_uns(mi) = 0 && rt != 3 && rt != 8 && rt != 16 && rt != 32 && rt != 35
        return: 1
return: 0

# A foreign C type held by value (depth 0), by its formal code: its storage is
# native C storage of that exact type, and the graph has no cell type for it.
fn: l2_foreign_value_ft (int: ft) int
    int: fi ft - 100
    if: ft < 100 || fi >= l2_foreign_n
        return: 0
return: (cast: (int) (l2_foreign_depth[fi] = 0))

# The typed store of a scalar result class (l2_tramp_class 1-4).
fn: l2_tramp_store (int: cls) const: @: char
    if: cls = 2
        return: "lmx_size_store_known"
    if: cls = 3
        return: "lmx_unsigned_store_known"
    if: cls = 4
        return: "lmx_ulong_store_known"
return: "lmx_int_store_known"

# The callee runs over its own Structure, lmx_call_prim(code, code): no instance is made (the author, 2026-09-28).
fn: l2_emit_dyn_tail (int: mi; int: idx; int: t; int: self_t; const: @(char ind); int: nargs) int
    int: cls l2_tramp_class(idx)
    []: char args 64
    # refs and nargs: l2_cfr<t> (l2_emit_call builds it) for a call with arguments.
    if: nargs = 0 && c.sprintf(args, "0, 0U") < 0
        return: 1
    if: nargs != 0 && c.sprintf(args, "l2_cfr%d, %dU", t, nargs) < 0
        return: 1
    if: l2_m_throws[idx] != 0 && c.fprintf(l2_out, "%sl2_ts%d: lmx_call_prim(l2_program_arena, l2_c%d, l2_c%d, %s, ", ind, t, self_t, self_t, args) < 0
        return: 1
    if: l2_m_throws[idx] = 0 && c.fprintf(l2_out, "%sif: lmx_call_prim(l2_program_arena, l2_c%d, l2_c%d, %s, ", ind, self_t, self_t, args) < 0
        return: 1
    if: (cls = 0 || cls = 5) && fputs("0", l2_out) < 0
        return: 1
    if: cls != 0 && cls != 5 && c.fprintf(l2_out, "(cast: (@: void) (@ l2_t%d))", t) < 0
        return: 1
    if: c.fprintf(l2_out, ", @ l2_o%d)", t) < 0
        return: 1
    if: l2_m_throws[idx] = 0 && c.fprintf(l2_out, " != 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: a callable that cannot throw reported a status\\n\")\n%s    c.abort()\n", ind, ind) < 0
        return: 1
    if: l2_m_throws[idx] != 0 && c.fprintf(l2_out, "\n%sif: l2_ts%d != 0\n%s    l2_te%d: (cast: (@: Lmx) l2_o%d)\n", ind, t, ind, t, t) < 0
        return: 1
    if: l2_emit_poll(mi, ind) != 0
        return: 1
    if: cls = 5 && l2_m_throws[idx] = 0 && c.fprintf(l2_out, "%sl2_t%d: l2_o%d\n", ind, t, t) < 0
        return: 1
    if: cls = 5 && l2_m_throws[idx] != 0 && c.fprintf(l2_out, "%sif: l2_ts%d = 0\n%s    l2_t%d: l2_o%d\n", ind, t, ind, t, t) < 0
        return: 1
    if: l2_sig_ret(idx) = 1 && l2_m_throws[idx] = 0 && c.fprintf(l2_out, "%sl2_t%d: (cast: (char) lmx_char_value_known(l2_o%d))\n", ind, t, t) < 0
        return: 1
    if: l2_sig_ret(idx) = 1 && l2_m_throws[idx] != 0 && c.fprintf(l2_out, "%sif: l2_ts%d = 0\n%s    l2_t%d: (cast: (char) lmx_char_value_known(l2_o%d))\n", ind, t, ind, t, t) < 0
        return: 1
return: 0

# The call of the already selected occurrence l2_c<self_t>, with method idx's
# resolved signature, through lmx_call_prim; nargs > 0 passes l2_cfr<t>. The value lands the way the
# method's trampoline delivers it (l2_tramp_class): a scalar or a foreign value in l2_t<t> through
# dest; a pointer through out, then into l2_t<t>.  On a throw `out` is the thrown record.
# The callee runs over its selected Structure; this does not allocate a callable
# instance or turn caller transport storage into a language place.
fn: l2_emit_dyn_call (int: mi; int: idx; int: t; int: self_t; const: @(char ind); int: nargs) int
    if: c.fprintf(l2_out, "%s@: void l2_o%d 0\n", ind, t) < 0
        return: 1
    return: l2_emit_dyn_tail(mi, idx, t, self_t, ind, nargs)

# The call of method i from its trampoline: node, self, the inputs, and for the declared-throw
# ABI the result local and the thrown-record local.
fn: l2_emit_tramp_call (int: i; int: n; int: thr; int: cls) int
    int: k 0
    if: l2_write_sym(l2_out, i) != 0 || fputs("(l2_self\\parent, l2_self", l2_out) < 0
        return: 1
    while: k < n
        if: l2_emit_formal(l2_input_ft(i, k), i, k, 1) != 0
            return: 1
        k: k + 1
    if: thr != 0 && cls != 0 && fputs(", @ l2_tv", l2_out) < 0
        return: 1
    if: thr != 0 && fputs(", @ l2_tt", l2_out) < 0
        return: 1
return: (cast: (int) (fputs(")", l2_out) < 0))

# The trampoline of method i: its prototype line (proto) or its definition.
fn: l2_emit_trampoline (int: i; int: proto) int
    int: k 0
    int: n l2_m_arity[i] + l2_m_dyn[i]
    int: cls l2_tramp_class(i)
    int: rt l2_sig_ret(i)
    int: thr 0
    []: char declaration_own 1024
    L2Tx: declaration_tx
    @: L2Tx declaration l2_tx_local(@ declaration_tx, declaration_own, 1024U)
    if: l2_m_throws != 0 && l2_m_throws[i] != 0
        thr: 1
    ---
    if: proto != 0 && fputs("    fn: ", l2_out) < 0
        return: 1
    if: proto = 0 && fputs("fn: ", l2_out) < 0
        return: 1
    if: l2_write_sym(l2_out, i) != 0 || fputs("_tr (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int\n", l2_out) < 0
        return: 1
    if: proto != 0
        return: 0
    # owner is the data its caller passed: the occurrence itself, (M, M).
    if: c.fprintf(l2_out, "    @: Lmx l2_self (cast: (@: Lmx) owner)\n") < 0
        return: 1
    if: c.fprintf(l2_out, "    if: nargs != %dU || out = 0", n) < 0
        return: 1
    if: (cls = 1 || cls = 2 || cls = 3 || cls = 4 || cls = 6) && fputs(" || dest = 0", l2_out) < 0
        return: 1
    if: fputs("\n        c.fprintf(c.stderr, \"lmx: invariant: a trampoline was called outside its method's signature\\n\")\n        c.abort()\n", l2_out) < 0
        return: 1
    # K04 S2: a hidden input the method reads may arrive absent (l2_emit_tramp_lex).
    k: l2_m_arity[i]
    while: k < n
        if: l2_emit_tramp_lex(i, k) != 0
            return: 1
        k: k + 1
    ---
    k: 0
    while: k < n
        if: l2_emit_formal(l2_input_ft(i, k), i, k, 2) != 0
            return: 1
        k: k + 1
    ---
    # Invoke the typed body first. A stopped Message supplies no value, so
    # neither initialized scalar placeholders nor uninitialized foreign storage
    # may be copied to the caller. Only normal completion reaches result stores.
    if: fputs("    \\out: 0\n", l2_out) < 0
        return: 1
    if: cls != 0
        k: rt
        if: rt < 100
            k: l2_ft_of_own(l2_ret_cell_ty(i))
        if: l2_value_decl_text(k, 0, "l2_tv", declaration) != 0 || c.fprintf(l2_out, "    %s\n", declaration\data) < 0
            return: 1
    ---
    if: thr != 0 && fputs("    @: Lmx l2_tt 0\n    int: l2_ts 0\n    l2_ts: ", l2_out) < 0
        return: 1
    if: thr = 0 && cls != 0 && fputs("    l2_tv: ", l2_out) < 0
        return: 1
    if: thr = 0 && cls = 0 && fputs("    ", l2_out) < 0
        return: 1
    if: l2_emit_tramp_call(i, n, thr, cls) != 0 || fputs("\n    if: lmx_msg_poll_escape() != 0\n        return: 0\n", l2_out) < 0
        return: 1
    if: thr != 0 && fputs("    if: l2_ts != 0\n        \\out: (cast: (@: void) l2_tt)\n        return: l2_ts\n", l2_out) < 0
        return: 1
    if: rt = 1 && fputs("    lmx_char_store_known(dest, (cast: (int) l2_tv))\n    \\out: dest\n", l2_out) < 0
        return: 1
    if: rt != 1 && cls >= 1 && cls <= 4 && c.fprintf(l2_out, "    %s(dest, l2_tv)\n    \\out: dest\n", l2_tramp_store(cls)) < 0
        return: 1
    if: cls = 5 && fputs("    \\out: (cast: (@: void) l2_tv)\n", l2_out) < 0
        return: 1
    if: cls = 6 && (l2_value_decl_text(rt, 1, "l2_rv", declaration) != 0 || c.fprintf(l2_out, "    %s (cast: (@: ", declaration\data) < 0 || l2_write_text(l2_out, l2_foreign_name[rt - 100]) != 0 || fputs(") dest)\n    \\l2_rv: l2_tv\n    \\out: dest\n", l2_out) < 0)
        return: 1
    if: fputs("    return: 0\nend: ", l2_out) < 0 || l2_write_sym(l2_out, i) != 0 || fputs("_tr\n\n", l2_out) < 0
        return: 1
return: 0

# Retained operator bodies are built in the same complete Structure used by
# native dispatch. A nonzero native word selects its adapter; a zero word walks
# that occurrence's retained operators. Root and method eligibility are checked
# by the same lowering machinery; unsupported operations are diagnosed, not
# silently omitted. This builder does not establish a language-level L2/L3 ban.
# The count/check pass (l2_rw_emit=0) precedes physical graph construction.

# A root statement or operand this translator does not build as walker nodes yet.
fn: l2_rw_refuse (const: @(LmP0Node node); const: @(char what)) int
    @: char msg 0
    size_t: n
    int: r
    if: what = 0
        what: ""
    # The longest lead, "named Structure body not walkable yet: ", is 39 bytes: the message is never cut.
    n: strlen(what) + 48U
    msg: (cast: (@: char) malloc(n))
    if: msg = 0
        return: l2_error(l2_src, node, what)
    c.snprintf(msg, n, "root operation not walkable yet: %s", what)
    r: l2_error(l2_src, node, msg)
    free((cast: (@: void) msg))
return: r

# The name of container t: the unit (t < 0) or the node temp l2_rw<t>.
sub: l2_rw_name (int: t; @: char dest)
    if: t < 0
        c.sprintf(dest, "l2_entry_unit")
    else:
        c.sprintf(dest, "l2_rw%d", t)
    ---
end: l2_rw_name

# A frame node of role `code` with `children` slots (its role slot included) under container
# `parent`; its temp is written to out.
fn: l2_rw_frame (int: parent; const: @(char code); int: children; @: int out) int
    []: char pn 32
    int: t l2_rw_t
    l2_rw_t: l2_rw_t + 1
    \out: t
    if: l2_construct_temp(t, parent, 0) != 0
        return: 1
    if: l2_rw_emit = 0
        return: 0
    l2_rw_name(parent, pn)
return: (cast: (int) (c.fprintf(l2_out, "        @: Lmx l2_rw%d lmx_walk_frame(l2_program_arena, l2_rw_roles, %s, c.%s, %dU)\n        if: l2_rw%d = 0\n            return: 1\n", t, pn, code, children, t) < 0))

# One source producer owns its actual cells and operands. COUNT determines
# cardinality, PLACE records its edges, and FILL uses that same allocation.
# `code = 0` is an ordinary source body; otherwise slot 0 is its shared role.
fn: l2_rw_source_frame (@: L2SourceContainer row; int: parent; const: @(char code); int: width; @: int out) int
    int: t l2_rw_t
    []: char pn 32
    if: row = 0 || l2_source_fill(row) != 0
        return: 1
    l2_rw_t: l2_rw_t + 1
    \out: t
    if: l2_construct_phase = 0
        row\width: width
    if: l2_construct_phase > 0 && row\width != width
        return: l2_error(l2_src, 0, "internal: a source producer changed width between passes")
    if: l2_construct_phase = 1
        row\temp: t
    if: l2_construct_temp(t, parent, 0) != 0
        return: 1
    if: l2_rw_emit = 0
        return: 0
    l2_rw_name(parent, pn)
    if: c.fprintf(l2_out, "        @: Lmx l2_rw%d l2_sc%zu\n        l2_rw%d\\parent: %s\n", t, row\id, t, pn) < 0
        return: 1
    if: code != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 0U, lmx_arena_ref_value(l2_rw_roles, (cast: (size_t) c.%s))) != 0\n            return: 1\n", t, code) < 0
        return: 1
return: 0

# Node `node`'s slot `slot` takes node `child`.
fn: l2_rw_put (int: node; int: slot; int: child) int
    []: char parent 32
    if: l2_construct_link(node, slot, child) != 0
        return: 1
    if: l2_rw_emit = 0
        return: 0
    l2_rw_name(node, parent)
return: (cast: (int) (c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", parent, slot, child) < 0))

# The ordinary physical input/return parts are also operation contracts. Their
# witnesses use the same typed-cell constructor as declarations and method parts.
# Descriptor witnesses name existing Structures, never companion data instances.
fn: l2_rw_witness (int: parent; int: slot; int: ty; int: descriptor) int
    if: l2_rw_emit = 0
        return: 0
    if: descriptor != 0
        return: (cast: (int) (c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, %dU, (cast: (@: void) l2_entry_unit)) != 0\n            return: 1\n", parent, slot) < 0))
    if: ty < 0
        return: 1
    if: c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_rw%d, %dU)\n        if: l2_entry_slot = 0\n            return: 1\n", parent, slot) < 0
        return: 1
return: l2_emit_cell_new_ty(ty, 0U, "        ", "l2_entry_slot", "return: 1", 0)

fn: l2_rw_contract (int: parent; int: n; int: rty; int: descriptor; @: int out; @: int inputs) int
    int: returns
    int: nr (cast: (int) (rty >= 0 || descriptor != 0))
    if: l2_rw_plain(parent, 2, out) != 0 || l2_rw_plain(\out, n, inputs) != 0 || l2_rw_put(\out, 0, \inputs) != 0 || l2_rw_plain(\out, nr, @ returns) != 0 || l2_rw_put(\out, 1, returns) != 0
        return: 1
    if: nr != 0
        return: l2_rw_witness(returns, 0, rty, descriptor)
return: 0

fn: l2_rw_input_witness (int: parent; int: slot; int: mi; int: j) int
    int: model l2_nsty_get(mi, j)
    int: callable l2_cf_get(mi, j)
    # In a merge's view the witness is the program's occurrence or Structure (l2_rw_types_unit, l2_rw_types_nsp),
    # not the copy's (steps/defects.md, T7-MODEL-OPERAND-SOURCE).
    if: l2_rw_emit != 0 && callable >= 0
        return: (cast: (int) (c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, %dU, (cast: (@: void) lmx_arena_ref_struct(%s, %uU))) != 0\n            return: 1\n", parent, slot, l2_rw_types_unit(), (cast: (unsigned) (l2_occ_slot(callable)))) < 0))
    if: l2_rw_emit != 0 && model >= 0 && l2_input_is_descriptor(mi, j) != 0
        return: (cast: (int) (c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, %dU, (cast: (@: void) %s[%d])) != 0\n            return: 1\n", parent, slot, l2_rw_types_nsp(), model) < 0))
    # A foreign by-value input is native C storage with no graph cell. Its
    # witness place stays empty, as its place in the method's own declared
    # part does, and the body that transports it is native-only.
    if: callable < 0 && model < 0 && l2_foreign_value_ft(l2_input_ft(mi, j)) != 0
        l2_rw_machine: 1
        return: 0
return: l2_rw_witness(parent, slot, l2_own_ty_of_param(l2_input_ft(mi, j)), l2_input_is_descriptor(mi, j))

# Retain a parser-established source distinction on the existing operation.
# COUNT/PLACE do not need another object; FILL selects its shared role.
fn: l2_rw_source_facet (int: node; const: @(char source)) int
    if: l2_rw_emit = 0
        return: 0
return: (cast: (int) (c.fprintf(l2_out, "        if: lmx_walk_source_mark(l2_rw_roles, l2_rw%d, c.%s) != 0\n            return: 1\n", node, source) < 0))

# A call's declared inputs/result come from its admitted signature; hidden
# inputs come from the selected formation, not that signature anchor. Direct
# calls supply the same method for both. No METHOD row is modified.
fn: l2_rw_call_contract (int: parent; int: mi; int: hidden; @: int out) int
    int: inputs
    int: j 0
    int: n l2_m_arity[mi]
    if: hidden >= 0
        n: n + l2_m_dyn[hidden]
    if: l2_rw_contract(parent, n, l2_ret_cell_ty(mi), 0, out, @ inputs) != 0
        return: 1
    while: j < l2_m_arity[mi]
        if: l2_rw_input_witness(inputs, j, mi, j) != 0
            return: 1
        j: j + 1
    ---
    while: j < n
        if: l2_rw_input_witness(inputs, j, hidden, l2_m_arity[hidden] + j - l2_m_arity[mi]) != 0
            return: 1
        j: j + 1
    ---
return: 0

fn: l2_rw_method_contract (int: parent; int: mi; @: int out) int
return: l2_rw_call_contract(parent, mi, mi, out)

fn: l2_rw_primitive_contract (int: primitive; int: contract) int
    if: l2_rw_emit = 0
        return: 0
return: (cast: (int) (c.fprintf(l2_out, "        l2_rwp%d\\signature: l2_rw%d\n", primitive, contract) < 0))

# An int literal.
fn: l2_rw_lit (int: parent; int: value; @: int out) int
    if: l2_rw_frame(parent, "LMX_WALK_OP_LIT", 2, out) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_int(l2_program_arena, l2_rw%d, 1U, %d) != c.LMX_WALK_OK\n            return: 1\n", \out, value) < 0
        return: 1
return: 0

# THE ROOT'S NUMERIC TYPES (FABLE-OPUS-ROOT-TYPED-20260925-175; -167 Part A: a value's type is its
# cell's).  A root field or value is an int, a char, a size_t, an unsigned or a ulong -- the own
# storage codes 0, 1, 2, 3 and 36 -- and the walker takes the operands of + - < = and of a store as
# one type, refusing a mix at run time.  So the translator gives every root expression its static
# type first (l2_rw_tyof): a field's own type; a literal's is its context's -- -1 marks a literal
# alone, -2 one with a `U`, which only an unsigned type takes; a comparison's is int; -3 marks two
# types met, refused where they meet: a conversion is a later ticket (Q24/D-48).  The emission then
# gives each literal the type its place resolved to (`got != 1U` with a size_t got is LIT size_t 1).
fn: l2_rw_num_ty (int: ty) int
    if: ty = 0 || ty = 1 || ty = 2 || ty = 3 || ty = 36
        return: 1
return: 0

# The refusal for the root's own field oi, which is not a number: what it is.
fn: l2_rw_refuse_ty (const: @(LmP0Node node); int: oi) int
    if: l2_own_is_array(l2_own_ty[oi]) != 0
        return: l2_rw_refuse(node, "an array")
    if: l2_own_is_pointer(l2_own_ty[oi]) != 0 && l2_ft_of_own(l2_own_ty[oi]) >= 100
        return: l2_rw_refuse(node, "a Structure-typed field")
return: l2_rw_refuse(node, "a value that is not a number")

# The own field named t that the body being built sees (-193 T4a), or -1: the last one of that
# name of the method being built (l2_rw_mi; the root's are the unit's), else a unit field the method
# sees -- l2_own_find_last's own fallback. An argument's name -- a formal or a dynamic input -- is its
# input (ARG) until a same-name field declared in scope has had its declaration line; from then on it is
# that field (bafca4c: an assignment binds nothing).
fn: l2_rw_find (const: @(LmP0Text t)) int
    int: oi
    if: l2_rw_mi != l2_e && l2_param_find(l2_rw_mi, t) >= 0
        oi: l2_rw_bound(t)
        if: oi >= 0
            return: oi
        return: 0 - 1
return: l2_own_visible(l2_rw_mi, t)

# The numeric own field named t that is already bound to a formal, or -1.
# The latest mark wins (l2_formal_row). Leaving a body clears only a field
# declared in that body (D-79); a formal's method cell stays bound.
fn: l2_rw_bound (const: @(LmP0Text t)) int
    int: own l2_own_visible(l2_rw_mi, t)
    if: own >= 0 && l2_own_mi[own] = l2_rw_mi
        return: own
return: -1

# The visible numeric own field named t that an argument's -- a formal's or a dynamic input's -- declaration will bind,
# or -1.  Not bound yet. A hosted field is visible only while its body is the scope (class 3).
fn: l2_rw_formal_slot (const: @(LmP0Text t)) int
    int: own
    if: l2_rw_mi = l2_e || l2_param_find(l2_rw_mi, t) < 0
        return: -1
    own: l2_own_visible(l2_rw_mi, t)
    if: own >= 0 && l2_own_mi[own] = l2_rw_mi
        return: own
return: -1

# Clear the walk's binding marks. The array lives for the whole translation.
fn: l2_rw_bseq_zero () int
    int: i 0
    l2_rw_bseq_n: 0
    if: l2_own_n <= 0
        return: 0
    if: l2_rw_bseq = 0
        l2_rw_bseq: (cast: (@: int) calloc((cast: (size_t) l2_own_n), c.sizeof(c.int)))
        if: l2_rw_bseq = 0
            return: 1
        return: 0
    ---
    while: i < l2_own_n
        l2_rw_bseq[i]: 0
        i: i + 1
    ---
return: 0

# Remember that own row oi's binding line has been reached.
fn: l2_rw_bseq_mark (int: oi) int
    if: l2_rw_bseq = 0 || oi < 0 || oi >= l2_own_n
        return: 1
    l2_rw_bseq_n: l2_rw_bseq_n + 1
    l2_rw_bseq[oi]: l2_rw_bseq_n
return: 0

# Enter host's body. saved is the mark counter; marks above it belong to this body.
fn: l2_rw_enter (const: @(LmP0Node host); @: int saved) int
    \saved: l2_rw_bseq_n
return: l2_scope_push(host)

# Leave the body: drop its scope and the marks of fields declared in it (D-79).
# A formal bound by a bare write keeps that mark past the body.
fn: l2_rw_leave (int: saved) int
    @: LmP0Node host
    int: k 0
    host: l2_scope_host()
    if: l2_scope_pop() != 0
        return: 1
    if: l2_rw_bseq = 0
        return: 0
    while: k < l2_own_n
        if: l2_rw_bseq[k] > saved && l2_own_host[k] = host
            l2_rw_bseq[k]: 0
        k: k + 1
    ---
return: 0

# A value cell declared in a nested body, including its catch parameters.
fn: l2_rw_is_hosted (int: oi) int
    if: oi < 0 || oi >= l2_own_n || l2_own_host[oi] = 0
        return: 0
    if: l2_own_fid[oi] < 0 || l2_own_fchild[oi] < 0 || (l2_rw_num_ty(l2_own_ty[oi]) = 0 && l2_own_is_pointer(l2_own_ty[oi]) = 0)
        return: 0
return: 1

# One shared physical path, rooted at this activation's selected occurrence.
# Keep the existing AT root and OF child expressions; no auxiliary graph is built.
fn: l2_rw_graph_place (int: parent; @: L2GraphPlace place; @: int out) int
    if: place = 0
        return: 1
return: l2_rw_graph_path(parent, place, 0, 0 - 1, 0, 0, out)

# A relative physical edge chain over an already evaluated holder. base=-1
# retains AT's implicit current-occurrence root; all other roots stay explicit.
fn: l2_rw_graph_path (int: parent; @: L2GraphPlace place; @: L2GraphPlace stop; int: base; @: int root_path; int: root_level; @: int out) int
    int: holder
    if: place = stop
        if: root_path != 0
            return: l2_rw_path_value(root_path, root_level, parent, out)
        if: base < 0
            return: 1
        \out: base
        return: 0
    if: place = 0
        return: 1
    if: place\parent = stop && base = 0 - 1 && root_path = 0
        if: l2_rw_frame(parent, "LMX_WALK_OP_AT", 3, out) != 0
            return: 1
        ---
    else:
        if: l2_rw_frame(parent, "LMX_WALK_OP_OF", 3, out) != 0
            return: 1
        if: l2_rw_graph_path(\out, place\parent, stop, base, root_path, root_level, @ holder) != 0 || l2_rw_put(\out, 1, holder) != 0
            return: 1
        ---
    ---
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", \out, place\child) < 0
        return: 1
return: 0

# A retained body's existing physical place. Missing places remain a refusal,
# not a guessed root or a fallback to packed/shell arithmetic.
fn: l2_rw_host_at (int: parent; int: fid; @: int out) int
    if: fid < 0 || fid >= l2_for_n || l2_for_place = 0
        return: 1
return: l2_rw_graph_place(parent, l2_graph_body_place(fid), out)

# Read hosted field oi: OF(its control body, its child). The cell, as AT is for a method field.
fn: l2_rw_host_read (int: parent; int: oi; @: int out) int
    int: base
    @: L2GraphField field l2_graph_field(oi)
    if: field = 0 || field\holder = 0
        return: 1
    if: l2_rw_frame(parent, "LMX_WALK_OP_OF", 3, out) != 0
        return: 1
    if: l2_rw_graph_place(\out, field\holder, @ base) != 0 || l2_rw_put(\out, 1, base) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", \out, field\child) < 0
        return: 1
return: 0

# Write hosted field oi: PUT_OF(its control body, its child, value).
fn: l2_rw_host_put (int: into; int: oi; @: LmP0Field first; int: n; @: int out) int
    int: value
    int: h
    @: L2GraphField field l2_graph_field(oi)
    if: field = 0 || field\holder = 0
        return: 1
    if: l2_rw_frame(into, "LMX_WALK_OP_PUT_OF", 4, out) != 0
        return: 1
    if: l2_rw_graph_place(\out, field\holder, @ h) != 0 || l2_rw_put(\out, 1, h) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", \out, field\child) < 0
        return: 1
    if: l2_rw_texpr(first, n, l2_own_ty[oi], \out, @ value) != 0
        return: 1
return: l2_rw_put(\out, 3, value)

# Materialize an input into a hosted field from its preceding visible binding.
fn: l2_rw_host_carry (int: into; int: oi; @: int out) int
    int: j l2_param_find(l2_rw_mi, l2_own_name[oi])
    if: j < 0
        return: 1
return: l2_rw_carry_work(into, oi, out)

# A declaration of a formal's field with no initializer carries the argument: into its working value when it has one
# (l2_rw_carry_work, 7b-2), else into the cell.
fn: l2_rw_carry (int: into; int: oi; @: int out) int
    int: j l2_param_find(l2_rw_mi, l2_own_name[oi])
    if: j < 0
        return: 1
return: l2_rw_carry_work(into, oi, out)

# Carry is the existing input-materialization route, not a default for arbitrary
# omitted numeric declarations. Receive the preceding selected binding through
# normal conversion and SET/SET_OF; publication remains the ordinary dirty rule.
fn: l2_rw_carry_work (int: into; int: oi; @: int out) int
    @: LmP0Field first
    int: excluded l2_own_excl
    int: status
    first: l2_next_active(l2_own_decl[oi]\as\frame\body\first_field)
    l2_own_excl: oi
    status: l2_rw_assign(into, oi, first, 1, out)
    l2_own_excl: excluded
return: status

# Is own row oi one the body being built reaches: its own, or its lexical space's -- the unit's, or for a
# method of a program part its part's root's (§10)?
fn: l2_rw_seen (int: oi) int
    int: k
    if: oi < 0
        return: 0
    if: l2_own_mi[oi] = l2_rw_mi || l2_own_mi[oi] = l2_e
        return: 1
    k: l2_m_code_file(l2_rw_mi)
return: (cast: (int) (k >= 0 && l2_part_ns[k] >= 0 && l2_own_mi[oi] = l2_ns_proc[l2_part_ns[k]]))

# The type of the root's own numeric field named t, or -9 (not one: the emission says why).
fn: l2_rw_own_ty (const: @(LmP0Text t)) int
    int: oi l2_rw_find(t)
    if: oi < 0 || l2_rw_seen(oi) = 0
        return: 0 - 9
    # A catch parameter is a hosted numeric cell of its catch frame (l2_b of that frame).
    # T4b class 3: any other numeric field declared in a nested body, in a method.
    if: l2_own_host[oi] != 0
        if: l2_rw_is_hosted(oi) != 0
            return: l2_own_ty[oi]
        if: l2_frame_head(l2_own_host[oi], "catch") = 0 || l2_own_fid[oi] < 0 || l2_own_fchild[oi] < 0 || l2_rw_num_ty(l2_own_ty[oi]) = 0
            return: 0 - 9
        return: l2_own_ty[oi]
    if: l2_own_fid[oi] >= 0 || l2_own_uchild[oi] < 0
        return: 0 - 9
    # A reference field (a pointer cell: a letter, a Structure-typed field) has its own type too,
    # 1000 and above: it is compared with 0 or another reference only (-179).
    if: l2_rw_num_ty(l2_own_ty[oi]) = 0 && l2_own_is_pointer(l2_own_ty[oi]) = 0
        return: 0 - 9
return: l2_own_ty[oi]

# A decimal literal: an optional minus, digits, an optional `U`; its sign, magnitude and suffix.
fn: l2_rw_num_lit (const: @(LmP0Text t); @: int neg; @: size_t mag; @: int usuf) int
    size_t: i 0U
    size_t: stop
    size_t: v 0U
    size_t: d
    size_t: top 0U
    top: top - 1U
    \neg: 0
    \mag: 0U
    \usuf: 0
    if: t = 0 || t\data = 0 || t\length = 0U
        return: 0
    stop: t\length
    if: t\data[stop - 1U] = 85 || t\data[stop - 1U] = 117
        \usuf: 1
        stop: stop - 1U
    ---
    if: t\data[0] = 45
        \neg: 1
        i: 1U
    ---
    if: i >= stop || (\neg != 0 && \usuf != 0)
        return: 0
    while: i < stop
        if: t\data[i] < 48 || t\data[i] > 57
            return: 0
        d: (cast: (size_t) (t\data[i] - 48))
        if: v > (top - d) / 10U
            return: 0
        v: v * 10U + d
        i: i + 1U
    ---
    \mag: v
return: 1

# A char literal: one byte between quotes, or \0 \n \t \\ \'; its byte value.
fn: l2_rw_char_lit (const: @(LmP0Text t); @: int value) int
    if: t = 0 || t\data = 0 || t\length < 3U || t\data[0] != 39 || t\data[t\length - 1U] != 39
        return: 0
    if: t\length = 3U && t\data[1] != 92 && t\data[1] != 39
        \value: (cast: (int) t\data[1]) & 255
        return: 1
    if: t\length != 4U || t\data[1] != 92
        return: 0
    if: t\data[2] = 48
        \value: 0
        return: 1
    if: t\data[2] = 110
        \value: 10
        return: 1
    if: t\data[2] = 116
        \value: 9
        return: 1
    if: t\data[2] = 92 || t\data[2] = 39
        \value: (cast: (int) t\data[2])
        return: 1
return: 0

# A char literal node: the byte's cell.
fn: l2_rw_clit (int: parent; int: value; @: int out) int
    if: l2_rw_frame(parent, "LMX_WALK_OP_LIT", 2, out) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_char(l2_program_arena, l2_rw%d, 1U, %d) != c.LMX_WALK_OK\n            return: 1\n", \out, value) < 0
        return: 1
return: 0

# A decimal literal in type ty: in its range, a `U` only in an unsigned type, a char as its byte
# (a negative one as C stores it, -1 is 255).
fn: l2_rw_tlit (const: @(LmP0Node node); int: parent; int: ty; int: neg; size_t: mag; int: usuf; @: int out) int
    int: v 0
    # A source null literal in pointer context is a typed reference before EQ;
    # a numeric value that happens to be zero is never reclassified at runtime.
    if: l2_oc_is_ref(ty) != 0
        if: mag != 0U
            return: l2_rw_refuse(node, "a reference compared with a number other than 0")
        return: l2_rw_reference_value(0, 0, ty, parent, out)
    ---
    if: usuf != 0 && (ty = 0 || ty = 1)
        return: l2_rw_refuse(node, "a U literal in a signed type")
    if: neg != 0 && (ty = 2 || ty = 3 || ty = 36)
        return: l2_rw_refuse(node, "a literal out of its type's range")
    if: ty = 0
        if: (neg = 0 && mag > 2147483647U) || (neg != 0 && mag > 2147483648U)
            return: l2_rw_refuse(node, "a literal out of its type's range")
        if: neg != 0 && mag > 0U
            v: 0 - (cast: (int) (mag - 1U)) - 1
        else:
            v: (cast: (int) mag)
        ---
        return: l2_rw_lit(parent, v, out)
    if: ty = 1
        if: (neg = 0 && mag > (cast: (size_t) c.CHAR_MAX)) || (neg != 0 && mag > (cast: (size_t) (0 - c.CHAR_MIN)))
            return: l2_rw_refuse(node, "a literal out of its type's range")
        v: (cast: (int) mag)
        if: neg != 0
            v: 0 - v
        ---
        return: l2_rw_clit(parent, v & 255, out)
    if: (ty = 3 || ty = 36) && mag > 4294967295U
        return: l2_rw_refuse(node, "a literal out of its type's range")
    if: l2_rw_frame(parent, "LMX_WALK_OP_LIT", 2, out) != 0
        return: 1
    if: l2_rw_emit = 0
        return: 0
    if: ty = 2 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 1U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", \out, mag) < 0
        return: 1
    if: ty = 3 && c.fprintf(l2_out, "        if: lmx_walk_store_unsigned(l2_program_arena, l2_rw%d, 1U, %uU) != c.LMX_WALK_OK\n            return: 1\n", \out, (cast: (unsigned) mag)) < 0
        return: 1
    if: ty = 36 && c.fprintf(l2_out, "        if: lmx_walk_store_ulong(l2_program_arena, l2_rw%d, 1U, %uU) != c.LMX_WALK_OK\n            return: 1\n", \out, (cast: (unsigned) mag)) < 0
        return: 1
return: 0

# Tokens lo..hi (operands at lo, lo + 2, ...; operators between): the operator that splits them,
# the rightmost of the lowest precedence, so the operators associate to the left.
fn: l2_rw_split (@: L2ValueSpan tok; int: lo; int: hi) int
    int: k lo + 1
    int: best lo + 1
    int: bestp 99
    int: p
    while: k < hi
        p: l2_rw_prec(l2_span_node(tok, k)\as\atom)
        if: p <= bestp
            bestp: p
            best: k
        ---
        k: k + 2
    ---
return: best

# The shared native/walker operator type. C char is promoted before arithmetic;
# this never changes the type of its declared cell or the intern-table index.
fn: l2_rw_unify (int: a; int: b) int
    if: a = 1
        a: 0
        if: c.CHAR_MAX > c.INT_MAX
            a: 3
    ---
    if: b = 1
        b: 0
        if: c.CHAR_MAX > c.INT_MAX
            b: 3
    ---
    if: a = 0 - 3 || b = 0 - 3
        return: 0 - 3
    if: a = b
        return: a
    if: a < 0 && b < 0
        return: 0 - 2
    if: a < 0
        return: b
    if: b < 0
        return: a
return: 0 - 3

# The static type of tokens lo..hi; where two types first meet is kept in l2_rw_mix_at.
fn: l2_rw_tyof (@: L2ValueSpan tok; int: lo; int: hi) int
    int: best
    int: p
    int: u
    int: a
    int: b
    if: lo = hi
        return: l2_rw_span_ty(tok + lo)
    best: l2_rw_split(tok, lo, hi)
    # `a && b`, `a || b` (-196): two conditions, each of its own type; the value is an int.
    p: l2_rw_prec(l2_span_node(tok, best)\as\atom)
    if: p = 1 || p = 2
        if: l2_rw_tyof(tok, lo, best - 1) = 0 - 3 || l2_rw_tyof(tok, best + 1, hi) = 0 - 3
            return: 0 - 3
        return: 0
    ---
    a: l2_rw_tyof(tok, lo, best - 1)
    b: l2_rw_tyof(tok, best + 1, hi)
    # Equality consumes each already-checked reference value without numeric
    # unification or replacing its source pointer contract.
    if: p = 3 && l2_own_is_pointer(a) != 0 && l2_own_is_pointer(b) != 0
        return: 0
    u: l2_rw_unify(a, b)
    if: u = 0 - 3
        if: l2_rw_mix_at = 0
            l2_rw_mix_at: l2_span_node(tok, best)
        ---
        return: 0 - 3
    ---
    p: l2_rw_prec(l2_span_node(tok, best)\as\atom)
    if: p = 3 || p = 4
        return: 0
return: u

# The CALL result uses the existing closed return-cell contract, never an
# invented numeric type for an unsupported/unknown return representation.
fn: l2_rw_call_ty (int: idx) int
return: l2_ret_cell_ty(idx)

# The static type of one operand.  One this typing does not know takes any type (-1), like a
# literal: its emission names what it is (an L2 operation, a field path, a Structure value ...).
fn: l2_rw_opty (const: @(LmP0Node node)) int
    @: LmP0Text t
    int: neg 0
    size_t: mag 0U
    int: usuf 0
    int: v 0
    int: ty
    int: idx
    int: formal 0 - 1
    int: pmi 0 - 1
    size_t: eix 0U
    []: int path_own 42
    @: int path 0
    LmP0Text: base
    int: levels
    L2RawIndex: raw_index
    if: node = 0
        return: 0 - 1
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0 && node\as\structure != 0
        return: l2_rw_fields_ty(node\as\structure\first_field, l2_count_active(node\as\structure))
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0
        if: l2_prefix_frame(node) != 0
            ty: l2_rw_fields_ty(node\as\frame\body\first_field, l2_count_active(node\as\frame\body))
            return: l2_rw_unify(ty, ty)
        idx: l2_call_head_method(l2_rw_mi, node\as\frame\head, @ formal)
        if: idx >= 0 && idx != l2_e
            return: l2_rw_call_ty(idx)
        # Parsed prototypes supply their ordinary consumed-value contract.
        # A raw C token still has no invented L2 result type.
        if: l2_rw_external_head(node\as\frame\head) != 0 && l2_predef_result_ty(node\as\frame\head, @ ty) = 1
            return: l2_own_ty_of_param(ty)
        # The same context-aware resolver supplies formal, name and path
        # contracts. A unit method never overrides an actual callable formal.
        if: l2_text_eq(node\as\frame\head, "implements")
            return: 0
        if: l2_text_eq(node\as\frame\head, "length")
            return: 2
        # Item 739: a held callable's call is typed by its header's result (l2_mad_held_sig), not
        # as int -- the result comes back as a cell of that type (l2_mad_call's typed variants), so
        # the root never wraps the call in a conversion edge it does not need (REVIEW e639eca-1).
        if: l2_call_head_held(l2_rw_mi, node\as\frame\head) >= 0
            ty: l2_mad_held_ret_ty(l2_call_head_held(l2_rw_mi, node\as\frame\head))
            if: ty >= 0
                return: ty
            return: 0
        return: 0 - 1
    ---
    if: node\kind != c.LM_P0_NODE_ATOM || node\as = 0
        return: 0 - 1
    t: node\as\atom
    # K03 NS-ROLES-1b: a binding `b: tick` named bare is tick's call: its result's type.
    if: l2_call_alias_own(l2_rw_mi, t) >= 0
        return: l2_rw_call_ty(l2_rb_meth_of(l2_own_decl[l2_call_alias_own(l2_rw_mi, t)]))
    # A held callable's bare name received as its result has the type of that result.
    if: l2_held_result_site(node) != 0
        return: l2_mad_held_ret_ty(l2_call_head_held(l2_rw_mi, t))
    if: l2_raw_index_text(t, l2_rw_mi, @ raw_index) = 0
        if: raw_index.type < 0
            return: -1
        ty: raw_index.type
        return: l2_own_ty_of_param(ty)
    if: l2_deref_word(t, l2_rw_mi, @ base, @ levels, @ ty) = 0
        return: l2_own_ty_of_param(ty)
    if: l2_rw_num_lit(t, @ neg, @ mag, @ usuf) != 0
        if: usuf != 0
            return: 0 - 2
        return: 0 - 1
    ---
    if: l2_rw_char_lit(t, @ v) != 0
        return: 1
    if: l2_rw_has_slash(t) != 0 && t\data[0] != 92
        eix: 0U
        while: eix < t\length && (t\data[eix] != 91 || (eix > 0U && t\data[eix - 1U] = 92))
            eix: eix + 1U
        ---
        if: eix < t\length
            return: l2_rw_index_ty(node, t)
        path: l2_rw_path_room(t, path_own, 42)
        if: l2_rw_path_meta(node, t, 0, path) = 0 && path[3] >= 0
            return: path[3]
        return: 0 - 1
    ---
    idx: l2_rw_elem_of(t, @ eix)
    if: idx >= 0
        return: l2_rw_elem_ty(idx)
    pmi: l2_dyn_own_index(l2_rw_mi, t, @ idx, @ v)
    if: pmi = 1
        return: l2_rw_elem_ty(idx)
    if: pmi = 2
        return: 0 - 3
    if: l2_t7_walk != 0 && l2_t7_bound_slot(t) >= 0
        return: 0
    if: l2_t7_walk != 0 && l2_t7_arg_ty(t) >= 0
        return: l2_t7_arg_ty(t)
    idx: l2_call_head_method(l2_rw_mi, t, @ formal)
    if: idx >= 0 && formal >= 0 && l2_cf_get(l2_rw_mi, formal) >= 0
        return: l2_rw_call_ty(idx)
    if: l2_colon_bound_ty(l2_rw_mi, t, @ ty) = 0
        return: l2_own_ty_of_param(ty)
    if: l2_mad_slot(l2_rw_mi, t) >= 0
        return: l2_mad_slot_ty(l2_rw_mi, t)
    ty: l2_rw_own_ty(t)
    if: ty >= 0
        return: ty
    idx: l2_call_head_method(l2_rw_mi, t, @ formal)
    if: idx >= 0 && idx != l2_e
        return: l2_rw_call_ty(idx)
return: 0 - 1

# The static type of an expression given as the run of n fields from `first` (any, -1, when it is
# not one: its emission refuses it).
fn: l2_rw_fields_ty (@: LmP0Field first; int: n) int
    @: L2ValueSpan tok
    int: m
    int: ty
    tok: l2_value_spans(first, n, @ m)
    if: tok = 0
        return: 0 - 1
    ty: l2_rw_tyof(tok, 0, m - 1)
    l2_xfree((cast: (@: void) tok))
return: ty

# A path operand `a\b...`, which P0 gives inside an expression as the fields `a`, `\`, `b` (and
# more): the count of fields from f the run takes (1 when f does not start one), at most `avail`.
fn: l2_rw_path_run (@: LmP0Field f; int: avail) int
return: l2_rw_path_run_mode(f, avail, 1)

# The same path prefix, optionally stopping before element indexing. A field
# occurrence selector remains part of the path, not an element index.
fn: l2_rw_path_run_mode (@: LmP0Field f; int: avail; int: indices) int
    int: n 1
    @: LmP0Field s
    @: LmP0Field member
    @: LmP0Field index
    @: LmP0Field close
    @: LmP0Field after
    L2ValueSpan: indexed
    int: group
    if: f = 0 || f\value = 0
        return: 0
    s: l2_next_active(f\next)
    while: n < avail && s != 0 && s\value != 0
        if: s\value\kind = c.LM_P0_NODE_ATOM && l2_is_slash(s\value\as\atom) != 0
            # A bare Frame followed by a slash starts the next statement.
            if: n = 1 && f\value\kind != c.LM_P0_NODE_ATOM
                break
            if: n + 2 > avail
                return: 0
            member: l2_next_active(s\next)
            if: member = 0 || member\value = 0 || member\value\kind != c.LM_P0_NODE_ATOM
                return: 0
            # An occurrence selector is one original five-field path step.
            if: l2_text_eq(member\value\as\atom, "[") != 0
                index: l2_next_active(member\next)
                if: index = 0
                    return: 0
                close: l2_next_active(index\next)
                if: close = 0
                    return: 0
                after: l2_next_active(close\next)
                if: n + 5 > avail || index\value = 0 || index\value\kind != c.LM_P0_NODE_ATOM || close\value = 0 || close\value\kind != c.LM_P0_NODE_ATOM || l2_text_eq(close\value\as\atom, "]") = 0 || after = 0 || after\value = 0 || after\value\kind != c.LM_P0_NODE_ATOM
                    return: 0
                n: n + 5
                s: l2_next_active(after\next)
            else:
                n: n + 2
                s: l2_next_active(member\next)
            ---
            continue
        ---
        if: indices = 0
            break
        group: l2_field_index_group(s, avail - n, @ indexed, @ after)
        if: group = 0
            break
        n: n + group
        s: after
    ---
return: n

# The first operand's bounded source span. Existing path/index delimiters stay
# in source; prefix receivers belong to the operand, not to a following actual.
fn: l2_operand_run (@: LmP0Field first; int: count) int
    @: LmP0Field f l2_next_active(first)
    int: run
    if: count < 1 || f = 0 || f\value = 0
        return: 0
    # The existing rootless occurrence selector is one borrowed operand,
    # before the same leading slash can be considered a raw dereference.
    if: count >= 5 && l2_occ_run(f) = 5
        return: 5
    # A prefix sign and its operand are one operand; a sign before a sign is
    # one too, to any depth. This is asked only where an operand begins, so a
    # `-` between two operands stays the binary operator whatever the spacing.
    if: f\value\kind = c.LM_P0_NODE_ATOM && f\value\as != 0 && l2_prefix_sign(f\value\as\atom) != 0
        if: count < 2
            return: 0
        run: l2_operand_run(l2_next_active(f\next), count - 1)
        if: run < 1
            return: 0
        return: run + 1
    ---
    if: f\value\kind = c.LM_P0_NODE_ATOM && f\value\as != 0 && (l2_text_eq(f\value\as\atom, "@") != 0 || l2_is_slash(f\value\as\atom) != 0)
        if: count < 2
            return: 0
        run: l2_operand_run(l2_next_active(f\next), count - 1)
        if: run < 1
            return: 0
        return: run + 1
    ---
return: l2_rw_path_run(f, count)

# Resolve the existing five-field selector without joining text or making a
# P0 node. -2: another operand; -1: no declared occurrence; name is the
# original source name node used by every located refusal.
fn: l2_operand_occurrence (@: LmP0Field first; int: count; int: mi; @@: LmP0Node name) int
    @: LmP0Field index
    @: LmP0Field last
    int: own
    \name: 0
    if: count != 5 || l2_occ_run(first) != 5
        return: -2
    index: l2_skip_span(first, 2)
    last: l2_skip_span(first, 4)
    \name: last\value
    if: mi < 0
        return: -1
    own: l2_own_find_occ(mi, last\value\as\atom, (cast: (int) l2_literal_value(index\value\as\atom)))
    if: own < 0 || l2_m_uses[l2_own_off(mi, own)] = 0
        return: -1
return: own

fn: l2_span_node (@: L2ValueSpan spans; int: index) @: LmP0Node
return: spans[index].node

# The maximum number of tokens is the actual supplied field count. Every token
# borrows one bounded source span; no P0 node, text atom or operand is cloned.
fn: l2_value_spans (@: LmP0Field first; int: count; @: int length) @: L2ValueSpan
    @: L2ValueSpan spans 0
    @: L2ValueSpan item
    @: LmP0Field f l2_next_active(first)
    int: used 0
    int: n 0
    int: run
    \length: 0
    if: count < 1 || l2_mul_ok((cast: (size_t) count), c.sizeof(c.L2ValueSpan)) = 0
        return: 0
    spans: (cast: (@: L2ValueSpan) l2_xmalloc((cast: (size_t) count) * c.sizeof(c.L2ValueSpan)))
    if: spans = 0
        return: 0
    while: used < count && f != 0
        run: 1
        if: (n % 2) = 0
            run: l2_operand_run(f, count - used)
        else:
            if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || l2_rw_prec(f\value\as\atom) = 0
                run: 0
            ---
        ---
        if: run < 1 || run > count - used
            l2_xfree((cast: (@: void) spans))
            return: 0
        item: spans + n
        item\first: f
        item\count: run
        item\node: f\value
        used: used + run
        n: n + 1
        f: l2_skip_span(f, run)
    ---
    if: used != count || (n % 2) = 0
        l2_xfree((cast: (@: void) spans))
        return: 0
    \length: n
return: spans

# Native kind checking and retained-graph typing resolve the same source span.
fn: l2_native_span_ty (@: L2ValueSpan span; int: mi) int
    L2ValueSpan: operand
    int: levels
    int: source_type
    int: result_type
    L2Address: address
    L2IndexedOperand: indexed
    L2RawIndex: raw_index
    L2ArrayPlace: array_place
    @: char text
    LmP0Text: word
    int: ty
    int: status
    int: own
    @: LmP0Node name
    if: l2_prefix_rest(span, @ operand) = 0
        return: l2_prefix_native_ty(l2_native_span_ty(@ operand, mi), (operand.node))
    own: l2_operand_occurrence(span\first, span\count, mi, @ name)
    if: own != -2
        if: own < 0
            return: -99
        ty: l2_ft_of_own(l2_own_ty[own])
        if: l2_pointer_depth(ty) > 0
            return: -5
        return: ty
    if: l2_indirect_span(span, mi, @ operand, @ levels, @ source_type, @ result_type) = 0
        if: l2_pointer_depth(result_type) > 0
            return: -5
        return: result_type
    status: l2_array_span(span\first, span\count, mi, @ array_place)
    if: status = 3
        return: -99
    if: status = 0
        ty: array_place.type
        l2_array_place_release(@ array_place)
        if: array_place.count = span\count
            if: l2_pointer_depth(ty) > 0
                return: -5
            return: ty
        ---
    ---
    if: l2_indexed_operand(span\first, span\count, mi, @ indexed) = 0 && indexed.count = span\count
        ty: indexed.type
        if: indexed.address != 0 || l2_pointer_depth(ty) > 0
            return: 0 - 5
        return: ty
    if: l2_raw_index_span(span, mi, @ raw_index) = 0
        # An element whose C type L2 does not know is opaque: the C compiler
        # checks it. It is not a literal that takes its place's type.
        if: raw_index.type < 0
            return: 0 - 99
        ty: raw_index.type
        if: l2_pointer_depth(ty) > 0
            return: -5
        return: raw_index.type
    if: l2_address_operand(span\first, span\count, mi, @ address) = 0
        return: 0 - 5
    if: span\count = 1
        return: l2_native_leaf_ty(span\node, mi)
    text: l2_address_path_text(span\first, span\count)
    if: text = 0
        return: 0 - 99
    word.data: text
    word.length: strlen(text)
    # K03 S6: a path that selects a callable is its call: the callable's result (l2_path_callee), as a call's.
    own: l2_path_callee(mi, @ word)
    if: own >= 0
        l2_xfree(text)
        if: l2_m_ret[own] = 8
            return: 0 - 5
        if: l2_colon_ret_ty(own, @ ty) != 0
            return: 0 - 99
        if: l2_colon_is_graph_ty(ty) != 0
            return: 0 - 5
        if: l2_prim_code_name(ty) = 0
            return: 0 - 99
        return: ty
    ty: l2_native_path_ty(@ word)
    l2_xfree(text)
return: ty

fn: l2_rw_span_ty (@: L2ValueSpan span) int
    L2ValueSpan: operand
    int: levels
    int: source_type
    int: result_type
    L2Address: address
    L2IndexedOperand: indexed
    L2RawIndex: raw_index
    L2ArrayPlace: array_place
    @: char text
    LmP0Text: word
    []: int path_own 42
    @: int path 0
    int: ty 0 - 1
    int: status
    int: own
    @: LmP0Node name
    # A prefix sign: its operand's type, promoted as C promotes it. A literal
    # alone stays a literal and takes its place's type.
    if: l2_prefix_rest(span, @ operand) = 0
        ty: l2_rw_span_ty(@ operand)
        return: l2_rw_unify(ty, ty)
    own: l2_operand_occurrence(span\first, span\count, l2_rw_mi, @ name)
    if: own != -2
        if: own < 0
            return: -1
        return: l2_own_ty[own]
    if: l2_indirect_span(span, l2_rw_mi, @ operand, @ levels, @ source_type, @ result_type) = 0
        return: l2_own_ty_of_param(result_type)
    status: l2_array_span(span\first, span\count, l2_rw_mi, @ array_place)
    if: status = 3
        return: -1
    if: status = 0
        ty: array_place.type
        l2_array_place_release(@ array_place)
        if: array_place.count = span\count
            return: l2_own_ty_of_param(ty)
        ---
    ---
    if: l2_indexed_operand(span\first, span\count, l2_rw_mi, @ indexed) = 0 && indexed.count = span\count
        ty: indexed.type
        return: l2_own_ty_of_param(ty)
    if: l2_raw_index_span(span, l2_rw_mi, @ raw_index) = 0
        if: raw_index.type < 0
            return: -1
        ty: raw_index.type
        return: l2_own_ty_of_param(ty)
    # The address of a raw element is a pointer to that element's type.
    if: l2_rw_address_rest(span, @ operand) = 0 && l2_raw_index_span(@ operand, l2_rw_mi, @ raw_index) = 0
        if: raw_index.type < 0
            return: -1
        ty: raw_index.type
        ty: l2_address_type(ty)
        if: ty < 0
            return: -1
        return: l2_own_ty_of_param(ty)
    # The address of an Array place's element is a pointer to the element's type.
    if: l2_rw_address_rest(span, @ operand) = 0
        status: l2_array_span((operand.first), (operand.count), l2_rw_mi, @ array_place)
        if: status = 3
            return: -1
        if: status = 0
            ty: array_place.type
            own: array_place.count
            l2_array_place_release(@ array_place)
            if: own = operand.count
                ty: l2_address_type(ty)
                if: ty < 0
                    return: -1
                return: l2_own_ty_of_param(ty)
            ---
        ---
    ---
    if: l2_address_operand(span\first, span\count, l2_rw_mi, @ address) = 0
        ty: address.type
        return: l2_own_ty_of_param(ty)
    if: span\count = 1
        if: span\node != 0 && span\node\kind = c.LM_P0_NODE_ATOM && span\node\as != 0
            own: l2_resolved_own(l2_rw_mi, span\node\as\atom)
            if: own >= 0 && l2_own_is_array(l2_own_ty[own]) != 0
                return: l2_own_ty_of_param(l2_array_desc_ty())
            ---
        ---
        return: l2_rw_opty(span\node)
    text: l2_address_path_text(span\first, span\count)
    if: text = 0
        return: 0 - 1
    word.data: text
    word.length: strlen(text)
    # K03 S6: a path that selects a callable is its call: the callable's result, as the walk types a call's.
    own: l2_path_callee(l2_rw_mi, @ word)
    if: own >= 0
        l2_xfree(text)
        if: l2_m_ret[own] = 8
            return: l2_graph_own()
        return: l2_rw_call_ty(own)
    if: l2_rw_foreign_path(@ word) != 0
        # The same declared member contract the native checker reads.
        ty: l2_native_path_ty(@ word)
        if: ty >= 0
            ty: l2_own_ty_of_param(ty)
        else:
            ty: 0 - 1
        ---
    else:
        path: l2_rw_path_room(@ word, path_own, 42)
        if: l2_rw_path_meta(span\node, @ word, 0, path) = 0
            ty: path[3]
        ---
    ---
    l2_xfree(text)
return: ty


# A path at the walked root, `a\b...` (FABLE-OPUS-ROOT-STRUCTS-20260925-178 commit 2), resolved
# through the named Structures' field table (l2_ns_slot_named) into `path`:
#   [0] 1: its root is a root own field of a Structure type -- a reference, whose Structure is
#       DEREF(AT(unit, its cell)); 2: a named Structure of the unit, which the builder makes before
#       the steps; 3: a method, whose occurrence is the root and whose own field (`M\x`, or the
#       occurrence `M\[N]x`) is the one name after it (-196); 4: a qualified (eternal) branch, read
#       only (-196); merge results use category 1 and their complete compiler schema;
#       6: a Structure formal of
#       the method being built (T4b class 1: `T: m` and `@: T m`) -- [1] is the formal index, and
#       the value is the reference the caller passed (ARG), not a cell; [1] that own field, that
#       named Structure or branch, that method, or that formal;
#   [2] the count of names after the root; [3] the last field's number type (own storage code), or
#       -1 when it is not a number; [4] the Structure that holds the last field; [5] 1 when the way
#       goes through a reference (the root, or a reference field, kind 10);
#   [6 + 3i], [7 + 3i], [8 + 3i] the slot, kind and admitted holder model
#   of name i + 1. The model is -1 between reference-binding crossings.
# Each name but the last is an inline nested Structure (kind 2) or a letter's payload (kind 3); the
# last is a number field -- size_t, char, int, unsigned, ulong (kinds 0, 1, 7, 8, 9) -- or not.  0,
# or 1 with the refusal made when `say` (the typing pass asks silently).
# Lexical resolution is shared by metadata and actual operand production.
# Metadata row coordinates are never passed to l2_rw_path_value.
# The names a resolved path of t can have: its segments, at least one (l2_rw_path_room sizes a table by it).
fn: l2_rw_seg_cap (const: @(LmP0Text t)) int
    int: n
    if: t = 0 || t\data = 0
        return: 1
    n: l2_seg_count(t\data, t\length)
    if: n < 1
        return: 1
return: n

# A table for the resolved path of t: six header cells and three per name, in `local` when its cap cells hold
# them, else storage of that size kept until l2_release (l2_text_room).  0 when there is no memory or the count
# does not fit; the resolver then refuses (a null table), as for a path it cannot resolve.
fn: l2_rw_path_room (const: @(LmP0Text t); @: int local; int: cap) @: int
    int: n l2_rw_seg_cap(t)
    size_t: isz
    if: n > (c.INT_MAX - 6) / 3
        l2_alloc_err: 2
        return: 0
    if: 6 + 3 * n <= cap && local != 0
        return: local
    isz: c.sizeof(c.int)
    if: l2_mul_ok((cast: (size_t) (6 + 3 * n)), isz) = 0
        l2_alloc_err: 2
        return: 0
return: (cast: (@: int) l2_text_room((cast: (size_t) (6 + 3 * n)) * isz, 0, 0U))

fn: l2_rw_path_resolve (const: @(LmP0Node node); const: @(LmP0Text t); int: project; int: say; @: int path) int
return: l2_rw_path_resolve_sized(node, t, project, say, l2_rw_seg_cap(t), path)

fn: l2_rw_path_resolve_sized (const: @(LmP0Node node); const: @(LmP0Text t); int: project; int: say; int: capacity; @: int path) int
    LmP0Text: segment
    @: LmP0Text occurrence_name 0
    int: occurrence -1
    size_t: i 0U
    size_t: b
    int: oi
    int: ni
    int: n 0
    int: slot
    int: kind 0
    int: ent 0
    int: last
    int: res 0 - 1
    int: fi 0 - 1
    int: rooted 0
    int: bh 0 - 1
    int: bm -1
    int: nb
    int: field_own
    int: model
    int: view_model -1
    int: segocc
    if: t = 0 || t\data = 0 || path = 0
        return: 1
    while: i < t\length && t\data[i] != 92
        i: i + 1U
    ---
    if: l2_rw_seg = 0
        l2_rw_seg: (cast: (@: LmP0Text) calloc(1U, c.sizeof(c.LmP0Text)))
        if: l2_rw_seg = 0
            return: 1
        ---
    ---
    l2_rw_seg\data: t\data
    l2_rw_seg\length: i
    path[5]: 0
    if: l2_rw_mi != l2_e
        fi: l2_param_find(l2_rw_mi, l2_rw_seg)
    oi: l2_rw_find(l2_rw_seg)
    # A method-local Structure (a letter) has a namespace and no unit child.
    if: l2_rw_seen(oi) != 0 && l2_own_schema(oi) != -1
        path[0]: 1
        path[1]: oi
        ni: l2_own_nsty_get(oi)
        res: l2_own_res(oi)
        path[5]: 1
        rooted: 1
    # T4b class 1. A Structure formal hides an own field of the same name (l2_rw_find already
    # returned -1) and a unit Structure of the same spelling. The reference is the caller's.
    if: rooted = 0 && fi >= 0 && l2_input_schema(l2_rw_mi, fi) != -1 && l2_cap_arg_ns(l2_rw_mi, fi) < 0
        path[0]: 6
        path[1]: fi
        ni: l2_input_schema(l2_rw_mi, fi)
        # K02c: a hidden input whose schema is a merge result's reads its slot map (res), as an own merge root does.
        if: l2_schema_kind(ni) = 2
            res: l2_schema_index(ni)
            ni: 0 - 1
        ---
        path[4]: 0 - 1
        path[5]: 1
        rooted: 1
    # `node` (book §3; Codex, 2026-09-28): the walker's NODE -- the activation's data's parent, the physical lexical
    # space above the method -- then a value field of that space's body (l2_node_seg), read and written in place.
    if: rooted = 0 && l2_rw_mi != l2_e && l2_text_eq(l2_rw_seg, "node") != 0
        path[0]: 8
        # A source-declared first child may have a namespace but no own row.
        # Keep that existing producer identity for lexical-use collection;
        # it is not a runtime coordinate and never replaces NODE.
        path[1]: -1
        path[4]: 0 - 1
        path[5]: 1
        rooted: 1
        ni: 0 - 1
    # Item 738 with A3: a Structure the host's activation gives the nested method -- its hidden input, ARG: the host's
    # own Structure at a direct call, the node's copy of the fields the method reads at a call of the returned node --
    # its field read through the capture type's table (D-105); the host's own is admitted as itself at the call.
    if: rooted = 0 && l2_rw_mi != l2_e && l2_cap_arg_ns(l2_rw_mi, l2_param_find(l2_rw_mi, l2_rw_seg)) >= 0
        path[0]: 7
        path[1]: l2_param_find(l2_rw_mi, l2_rw_seg)
        ni: l2_cap_arg_ns(l2_rw_mi, path[1])
        path[4]: 0 - 1
        path[5]: 1
        rooted: 1
    # A control body (7b-3, l2_body_root): the body its statement left in this activation's data (l2_rw_host_at); its
    # first name is a field declared there, read OF and written PUT_OF -- the graph, never its working value.
    if: rooted = 0 && l2_rw_mi >= 0 && l2_body_root(l2_rw_mi, l2_rw_seg\data, 0U, l2_rw_seg\length) >= 0
        path[0]: 9
        path[1]: l2_body_root(l2_rw_mi, l2_rw_seg\data, 0U, l2_rw_seg\length)
        path[4]: 0 - 1
        path[5]: 1
        rooted: 1
        ni: 0 - 1
    if: rooted = 0
        ni: l2_ns_find(l2_rw_seg)
        if: ni < 0 && l2_find_method(l2_rw_seg) >= 0 && l2_find_method(l2_rw_seg) != l2_e
            bm: l2_find_method(l2_rw_seg)
            path[0]: 3
            path[1]: bm
            path[4]: -1
            path[5]: 1
        if: bm < 0 && res < 0 && (ni < 0 || l2_ns_parent[ni] >= 0)
            if: say != 0
                l2_rw_refuse(node, "a field path")
            return: 1
        if: bm < 0 && res < 0
            path[0]: 2
            if: l2_ns_eternal[ni] >= 0
                path[0]: 4
            path[1]: ni
        ---
    ---
    if: path[0] = 1 && l2_d105_sub(l2_own_mi[path[1]], l2_d105_own_key(path[1])) != 0
        view_model: l2_own_nsty_get(path[1])
    if: path[0] = 6 && l2_d105_sub(l2_rw_mi, path[1]) != 0
        view_model: l2_input_schema(l2_rw_mi, path[1])
    if: path[0] = 7
        view_model: l2_cap_arg_ns(l2_rw_mi, path[1])
    while: i < t\length
        # i stands on a backslash: the next name runs to the next one.
        i: i + 1U
        b: i
        while: i < t\length && t\data[i] != 92
            i: i + 1U
        ---
        if: n >= capacity || i = b
            if: say != 0
                l2_rw_refuse(node, "a field path")
            return: 1
        occurrence: -1
        if: t\data[b] = 91
            segment.data: t\data + b - 1U
            segment.length: i - b + 1U
            # A merge result's `[N]` is its compiler schema's occurrence (l2_occ_head, l2_mrs_slot_nth);
            # every other root's `[N]name` is resolved by the same occurrence-exact lookup the bare
            # name is (l2_ns_slot_named reads the segment itself, K01), so a malformed or absent
            # occurrence is refused below, at the slot -- not refused as a shape here.
            if: res >= 0 && l2_occ_head(@ segment, @ occurrence, @ occurrence_name) != 0
                if: say != 0
                    l2_rw_refuse(node, "a field path")
                return: 1
            ---
        ---
        # The host the name is resolved in (l2_body_seg): a body root's body, then any body a name hops into -- a
        # field declared there, or a body of it, OF(host, its child slot), the next name that body's.
        if: n = 0 && path[0] = 9
            bh: path[1]
        nb: 0 - 1
        field_own: 0 - 1
        if: bm >= 0
            slot: l2_own_seg_scan(bm, 0, t\data, b, i - b, @ kind, @ ent)
            field_own: slot
            if: slot < 0
                nb: l2_body_seg(bm, -1, t\data, b, i - b, l2_rw_mi)
            if: nb >= 0
                slot: nb
                kind: 15
                ent: -1
            ---
        else:
            if: bh >= 0
                slot: l2_for_own_seg(bh, t\data, b, i - b, @ kind, @ ent)
                field_own: slot
                if: slot < 0
                    nb: l2_body_seg(l2_for_mi[bh], bh, t\data, b, i - b, l2_rw_mi)
                if: nb >= 0
                    slot: nb
                    kind: 15
                    ent: -1
                ---
            else:
                if: n = 0 && path[0] = 8
                    if: l2_node_seg_resolve(l2_rw_mi, t\data, b, i - b, project, @ slot, @ kind, @ ent, @ field_own, path + 1) != 0
                        slot: -1
                    ---
                else:
                    if: res >= 0
                        if: occurrence >= 0
                            slot: l2_mrs_slot_nth(res, occurrence_name, occurrence, @ kind, @ ent)
                            l2_xfree(occurrence_name)
                            occurrence_name: 0
                        else:
                            slot: l2_mrs_slot_named(res, t\data, b, i - b, @ kind, @ ent)
                        ---
                    else:
                        if: project != 0
                            slot: l2_ns_slot_named(ni, t\data, b, i - b, @ kind, @ ent)
                        else:
                            slot: l2_ns_named_row(ni, t\data, b, i - b, @ kind, @ ent)
                        ---
                    ---
                ---
            ---
        ---
        last: (cast: (int) (i >= t\length))
        model: ent
        if: last = 0 && kind = 10
            model: l2_field_pointee(ni, field_own, t\data, b, i - b)
        if: last = 0 && kind = 10 && res >= 0
            model: l2_mrs_ref_pointee(res, slot)
        # Item 738: the same words as the capture's own check (l2_cap_add).
        if: slot < 0 && path[0] = 7
            if: say != 0
                l2_rw_refuse(node, "a path through a captured Structure names no field of its type")
            return: 1
        if: slot < 0 || (last = 0 && kind != 2 && kind != 3 && kind != 15 && (kind != 10 || model < 0))
            if: say != 0
                l2_rw_refuse(node, "a field path")
            return: 1
        # K01: where this level reads through a correspondence, the OF/PUT_OF index is
        # the EDGE -- the required field plus the half this use's own selector names.
        # A bare `name` is the value's LAST occurrence (the map's second half); an
        # explicit `[N]name` its occurrence N (the ordinal half).  Where no
        # correspondence is carried (view_model < 0) the model IS the value's layout
        # and the resolved slot is already the physical one.
        segocc: 0 - 1
        if: l2_seg_occurrence(t\data, b, i - b, @ segocc) != 0
            if: say != 0
                l2_rw_refuse(node, "a field path")
            return: 1
        ---
        path[6 + 3 * n]: slot
        if: project != 0 && view_model >= 0 && segocc < 0
            path[6 + 3 * n]: slot + l2_d105_width(view_model)
        ---
        path[7 + 3 * n]: kind
        path[8 + 3 * n]: view_model
        if: field_own >= 0 && (bm >= 0 || bh >= 0 || (n = 0 && path[0] = 8))
            path[6 + 3 * n]: field_own
            path[7 + 3 * n]: 16
            path[8 + 3 * n]: -1
        ---
        view_model: -1
        if: kind = 10 && field_own >= 0 && l2_d105_sub(l2_own_mi[field_own], l2_d105_own_key(field_own)) != 0
            view_model: l2_own_nsty_get(field_own)
        if: n > 0 || res < 0
            path[4]: ni
        n: n + 1
        bm: -1
        bh: nb
        if: last = 0
            if: kind = 10
                path[5]: 1
            ni: model
            res: -1
            if: l2_schema_kind(model) = 2
                res: l2_schema_index(model)
                ni: -1
            ---
        ---
    ---
    if: n = 0
        if: say != 0
            l2_rw_refuse(node, "a field path")
        return: 1
    path[2]: n
    # Item 738: a captured Structure carries its value fields, one level (l2_cap_fields refused deeper).
    if: path[0] = 7 && n > 1
        if: say != 0
            l2_rw_refuse(node, "a path through a captured Structure past its field")
        return: 1
    path[3]: 0 - 1
    if: kind = 0
        path[3]: 2
    if: kind = 1
        path[3]: 1
    if: kind = 7
        path[3]: 0
    if: kind = 8
        path[3]: 3
    if: kind = 9
        path[3]: 36
    # A reference field (`@: LmxMsg sender` is kind 10, pointee 29). Its static type is the
    # pointer, the same 1000+pointee a formal of that type has. Structures share one address
    # range; this is the type, not a range.
    if: kind = 10
        path[3]: l2_oc_pointer(ent)
    ---
return: 0

fn: l2_rw_path (const: @(LmP0Node node); const: @(LmP0Text t); int: say; @: int path) int
return: l2_rw_path_resolve(node, t, 1, say, path)

fn: l2_rw_path_meta (const: @(LmP0Node node); const: @(LmP0Text t); int: say; @: int path) int
return: l2_rw_path_resolve(node, t, 0, say, path)

fn: l2_rw_path_current (@: int path) int
    if: path[0] = 3
        return: l2_path_current(l2_rw_mi, 0 - 1, path[1])
    if: path[0] = 2
        return: l2_path_current(l2_rw_mi, path[1], 0 - 1)
return: 0

# The value of a resolved path at `level` (0 its root, path[2] its last name), a node under
# container `parent`: the Structure reached so far, or the last field's cell.  A reference is
# opened by DEREF only for an actual pointer cell. A current-occurrence root
# starts with AT(holder 0, first slot); another named root comes from the unit.
# One lexical use of the walked home l2_rw_mi: base 0 from the unit, 1 from the home's node, `len` named levels
# (tags, vals; a node field's name `text`), once -- the same names recorded in every pass are one use.
fn: l2_use_note (int: base; @: int tags; @: int vals; int: len; @: char text; size_t: tlen) int
    int: k 0
    int: j
    int: same
    @: int g
    @@: char gt
    @: size_t gl
    if: l2_rw_mi < 0 || len <= 0 || tags = 0 || vals = 0
        return: 0
    while: k < l2_use_n
        if: l2_use_home[k] = l2_rw_mi && l2_use_base[k] = base && l2_use_len[k] = len && l2_use_tlen[k] = tlen
            same: 1
            j: 0
            while: j < len
                if: l2_use_slots[l2_use_off[k] + j] != vals[j] || l2_use_tags[l2_use_off[k] + j] != tags[j]
                    same: 0
                j: j + 1
            ---
            if: same != 0 && tlen != 0U && memcmp((cast: (@: void) l2_use_text[k]), (cast: (@: void) text), tlen) != 0
                same: 0
            if: same != 0
                return: 0
        ---
        k: k + 1
    ---
    if: l2_use_n >= l2_use_cap
        l2_use_cap: l2_use_cap * 2 + 16
        g: (cast: (@: int) realloc((cast: (@: void) l2_use_home), (cast: (size_t) l2_use_cap) * c.sizeof(c.int)))
        if: g = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_use_home: g
        g: (cast: (@: int) realloc((cast: (@: void) l2_use_base), (cast: (size_t) l2_use_cap) * c.sizeof(c.int)))
        if: g = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_use_base: g
        g: (cast: (@: int) realloc((cast: (@: void) l2_use_off), (cast: (size_t) l2_use_cap) * c.sizeof(c.int)))
        if: g = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_use_off: g
        g: (cast: (@: int) realloc((cast: (@: void) l2_use_len), (cast: (size_t) l2_use_cap) * c.sizeof(c.int)))
        if: g = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_use_len: g
        gt: (cast: (@@: char) realloc((cast: (@: void) l2_use_text), (cast: (size_t) l2_use_cap) * c.sizeof(@: char)))
        if: gt = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_use_text: gt
        gl: (cast: (@: size_t) realloc((cast: (@: void) l2_use_tlen), (cast: (size_t) l2_use_cap) * c.sizeof(c.size_t)))
        if: gl = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_use_tlen: gl
    ---
    if: l2_use_sn + len > l2_use_scap
        l2_use_scap: (l2_use_sn + len) * 2 + 32
        g: (cast: (@: int) realloc((cast: (@: void) l2_use_slots), (cast: (size_t) l2_use_scap) * c.sizeof(c.int)))
        if: g = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_use_slots: g
        g: (cast: (@: int) realloc((cast: (@: void) l2_use_tags), (cast: (size_t) l2_use_scap) * c.sizeof(c.int)))
        if: g = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_use_tags: g
    ---
    l2_use_home[l2_use_n]: l2_rw_mi
    l2_use_base[l2_use_n]: base
    l2_use_off[l2_use_n]: l2_use_sn
    l2_use_len[l2_use_n]: len
    l2_use_text[l2_use_n]: text
    l2_use_tlen[l2_use_n]: tlen
    j: 0
    while: j < len
        l2_use_slots[l2_use_sn + j]: vals[j]
        l2_use_tags[l2_use_sn + j]: tags[j]
        j: j + 1
    ---
    l2_use_sn: l2_use_sn + len
    l2_use_n: l2_use_n + 1
return: 0

# The use a whole resolved path makes (l2_rw_path_value's outermost call): from a unit child (a named Structure, a
# method's occurrence, a qualified branch) or from `node`, through its own-field levels by name and a named
# Structure's levels by their field rows (tag 14: an inline nested Structure, then a value field or a reference cell,
# which ends it), each laid out where the layout is final -- the count pass knows a row's ordinal only -- up to the
# first crossing: past one, the actual Structure's slots are its admitted layout's, so the recorded path ends before
# it (that holder used whole).  A level of another kind, or a row the holder does not have, ends the recorded path
# there too, as does, where the use is resolved, an own field with no place.  Roots inside the home (its own fields,
# formals, captures, control bodies) are no lexical use.
fn: l2_use_path (@: int path) int
    @: int tags 0
    @: int vals 0
    int: n 0
    int: base 0
    int: level 1
    int: kind
    int: holder 0 - 1
    int: row
    int: rc
    if: path[0] = 1 || path[0] = 6 || path[0] = 7 || path[0] = 9
        return: 0
    # The whole resolved path, however deep: one name per level and the root's.
    tags: (cast: (@: int) calloc((cast: (size_t) (path[2] + 2)), c.sizeof(c.int)))
    vals: (cast: (@: int) calloc((cast: (size_t) (path[2] + 2)), c.sizeof(c.int)))
    if: tags = 0 || vals = 0
        free((cast: (@: void) tags))
        free((cast: (@: void) vals))
        return: l2_error(l2_src, 0, "out of memory")
    ---
    if: path[0] = 8
        base: 1
        # The selected first source declaration is a namespace, not an own
        # row. Record its existing place relation and continue inside it.
        # The same producer identity survives COUNT through final PLACE.
        if: path[1] >= 0 && path[7] = 2
            tags[0]: 3
            if: l2_ns_parent[path[1]] >= 0
                tags[0]: 7
            vals[0]: path[1]
            holder: path[1]
            n: 1
            level: 2
        ---
    ---
    else:
        tags[0]: 3
        vals[0]: path[1]
        if: path[0] = 3
            tags[0]: 1
        if: path[0] = 4
            tags[0]: 2
            vals[0]: l2_ns_eternal[path[1]]
        ---
        if: path[0] = 2 || path[0] = 4
            holder: path[1]
        n: 1
    ---
    while: level <= path[2]
        kind: path[7 + 3 * (level - 1)]
        if: kind = 16
            tags[n]: 4
            vals[n]: path[6 + 3 * (level - 1)]
            holder: l2_own_nsty_get(path[6 + 3 * (level - 1)])
        else:
            if: path[8 + 3 * (level - 1)] != 0 - 1 || (kind != 2 && kind != 10 && kind != 0 && kind != 1 && kind != 7 && kind != 8 && kind != 9)
                break
            row: l2_use_ns_row(holder, path[6 + 3 * (level - 1)])
            if: row < 0
                break
            tags[n]: 14
            vals[n]: row
            holder: 0 - 1
            if: kind = 2
                holder: l2_nsf_ref[row]
        ---
        n: n + 1
        level: level + 1
        if: kind != 16 && kind != 2
            break
    ---
    rc: l2_use_note(base, tags, vals, n, 0, 0U)
    free((cast: (@: void) tags))
    free((cast: (@: void) vals))
return: rc

# The levels that reach named Structure ni from the unit as the builder reaches it (l2_nsp): the unit-level one, then
# one per named Structure enclosing ni, down to ni -- 0 for a local one, which no unit child holds.
fn: l2_use_ns_depth (int: ni) int
    int: n 0
    while: ni >= 0 && ni < l2_ns_n
        if: l2_ns_local[ni] >= 0
            return: 0
        n: n + 1
        ni: l2_ns_parent[ni]
    ---
return: n

# One use of the unit that the walked home's emitted code makes by naming a unit child directly (T7 SAME policy: a
# callable merge's view builds its frames from its copy of the unit).  `kind` names the child as the emitted text does:
# 1 method v's occurrence (l2_occ_slot), 2 qualified branch v, 3 named Structure v's unit slot (l2_ns_unit_slot), 7
# named Structure v as the builder holds it (l2_nsp: the unit-level one, then each enclosing one's slot of the next).
# Noted in every pass, as every use is.
fn: l2_use_unit_child (int: kind; int: v) int
    @: int tags 0
    @: int vals 0
    int: d 1
    int: i
    int: rc
    if: (kind != 1 && kind != 2 && kind != 3 && kind != 7) || v < 0
        return: l2_error(l2_src, 0, "internal: a use names an unknown unit child")
    if: kind = 7
        d: l2_use_ns_depth(v)
    if: d = 0
        return: 0
    tags: (cast: (@: int) calloc((cast: (size_t) d), c.sizeof(c.int)))
    vals: (cast: (@: int) calloc((cast: (size_t) d), c.sizeof(c.int)))
    if: tags = 0 || vals = 0
        free((cast: (@: void) tags))
        free((cast: (@: void) vals))
        return: l2_error(l2_src, 0, "out of memory")
    ---
    if: kind = 7
        i: d - 1
        while: i > 0
            tags[i]: 7
            vals[i]: v
            v: l2_ns_parent[v]
            i: i - 1
        ---
        kind: 3
    ---
    tags[0]: kind
    vals[0]: v
    rc: l2_use_note(0, tags, vals, d, 0, 0U)
    free((cast: (@: void) tags))
    free((cast: (@: void) vals))
return: rc

# The field row of named Structure ni whose slot is `slot` in the layout this pass knows (l2_nsf_slot: an ordinal in
# the count pass, the laid-out slot later), or -1.  A path names a row by the slot it resolved through.
fn: l2_use_ns_row (int: ni; int: slot) int
    int: fx 0
    if: ni < 0 || slot < 0
        return: 0 - 1
    while: fx < l2_nsf_n
        if: l2_nsf_owner[fx] = ni && l2_nsf_slot(fx) = slot
            return: fx
        fx: fx + 1
    ---
return: 0 - 1

# The edge chain below place `stop` down to `place` -- l2_rw_graph_path's: `stop` 0 for the whole chain from the
# Structure the places hang from (the owner's occurrence, or the Structure a path's previous name reached) -- each
# place's child into s[0..) when s is given; their count, or -1 when `stop` is not above `place` or a child does not
# fit the int slot vocabulary: never a clipped slot.
fn: l2_use_place_below (@: L2GraphPlace place; @: L2GraphPlace stop; @: int s) int
    int: n
    if: place = stop
        return: 0
    if: place = 0 || place\child > (cast: (size_t) c.INT_MAX)
        return: 0 - 1
    n: l2_use_place_below(place\parent, stop, s)
    if: n < 0
        return: 0 - 1
    if: s != 0
        s[n]: (cast: (int) place\child)
return: n + 1

# Named Structure ni's slots from the unit as the builder reaches it (l2_nsp) into s[0..) when s is given: the
# unit-level one's unit slot, then each enclosing one's slot of the next.  Their count, 0 for a local one.
fn: l2_use_ns_slots (int: ni; @: int s) int
    int: d l2_use_ns_depth(ni)
    int: i
    if: s != 0 && d > 0
        i: d - 1
        while: i > 0
            s[i]: l2_ns_field_in_parent(ni)
            ni: l2_ns_parent[ni]
            i: i - 1
        ---
        s[0]: l2_ns_unit_slot(ni)
    ---
return: d

# Own field oi's cell as the walk addresses it, its slots from the unit into s[0..) when s is given, their count (0 when
# the field has no place, or a slot does not fit the int slot vocabulary): a field held in a graph place through its
# owner's occurrence as the builder streams it (l2_emit_build_occ: none for the root, l2_nsp for a named Structure's
# procedure, else its occurrence) and the place chain; one with no holder, form 9 (l2_rw_cell, another home's cell)
# under a program part's root or the unit itself, form 10 (l2_rw_callee_at, a callee field of its own method) under
# its owner's occurrence; then the field's child.  Read only where the layout is final (l2_use_resolve).
fn: l2_use_cell_slots (int: form; int: oi; @: int s) int
    @: L2GraphField field 0
    int: owner
    int: n 0
    int: k
    if: oi < 0 || oi >= l2_own_n
        return: 0
    field: l2_graph_field(oi)
    if: field = 0
        return: 0
    owner: l2_own_mi[oi]
    if: field\holder != 0
        if: owner != l2_e && l2_m_nsof(owner) >= 0
            n: l2_use_ns_slots(l2_m_nsof(owner), s)
            if: n = 0
                return: 0
            ---
        ---
        if: owner != l2_e && l2_m_nsof(owner) < 0
            if: s != 0
                s[0]: l2_occ_slot(owner)
            n: 1
        ---
        k: l2_use_place_below(field\holder, 0, 0)
        if: k < 0
            return: 0
        if: s != 0
            l2_use_place_below(field\holder, 0, s + n)
        n: n + k
    else:
        if: form = 10
            if: s != 0
                s[0]: l2_occ_slot(owner)
            n: 1
        else:
            k: l2_m_file(owner)
            if: k >= 0 && l2_part_ns[k] >= 0 && owner = l2_ns_proc[l2_part_ns[k]]
                n: l2_use_ns_slots(l2_part_ns[k], s)
                if: n = 0
                    return: 0
                ---
            ---
        ---
    ---
    if: field\child > (cast: (size_t) c.INT_MAX)
        return: 0
    if: s != 0
        s[n]: (cast: (int) field\child)
return: n + 1

# One use of own field oi's cell, form 9 or 10 (l2_use_cell_slots), from the unit: noted by its declaration in every
# pass -- the check pass too, before any layout -- so that a merge emitted before the walk's writing pass (natively, or
# a callable merge's lexical copy) holds it.
fn: l2_use_cell_note (int: form; int: oi) int
    []: int ut 1
    []: int uv 1
    ut[0]: form
    uv[0]: oi
return: l2_use_note(0, ut, uv, 1, 0, 0U)

# l2_mu_rbuf holds at least `need` slots: it grows, never clips.
fn: l2_mu_room (int: need) int
    @: int g
    int: cap
    if: need <= l2_mu_rcap
        return: 0
    if: need > (c.INT_MAX - 16) / 2
        return: l2_error(l2_src, 0, "out of memory")
    cap: need * 2 + 16
    g: (cast: (@: int) realloc((cast: (@: void) l2_mu_rbuf), (cast: (size_t) cap) * c.sizeof(c.int)))
    if: g = 0
        return: l2_error(l2_src, 0, "out of memory")
    l2_mu_rbuf: g
    l2_mu_rcap: cap
return: 0

# Entry j of use k when it names an own field a graph place holds -- an own field (tag 4), or a node field by name
# (tag 6) that l2_node_seg resolves to one --: the field in *field, and in *stop the place its edge chain starts
# below, as l2_rw_path_value walks it: for the first name of a use from the home's node, the node's own place
# (l2_node_graph_stop: NODE has crossed that prefix), else none -- the chain hangs from the Structure the previous
# name reached.  *field is 0 for any other entry.  1 on an error.
fn: l2_use_held (int: k; int: j; @@: L2GraphField out_field; @@: L2GraphPlace out_stop) int
    int: tag l2_use_tags[l2_use_off[k] + j]
    int: v l2_use_slots[l2_use_off[k] + j]
    int: s 0 - 1
    int: kind 0 - 1
    int: ent 0 - 1
    int: own 0 - 1
    @: L2GraphField field 0
    \out_field: 0
    \out_stop: 0
    if: tag = 4
        field: l2_graph_field(v)
    if: tag = 6 && l2_node_seg(v, l2_use_text[k], 0U, l2_use_tlen[k], @ s, @ kind, @ ent, @ own) = 0 && own >= 0
        field: l2_graph_field(own)
    if: field = 0 || field\holder = 0
        return: 0
    if: j = 0 && l2_use_base[k] = 1 && l2_node_graph_stop(l2_use_home[k], out_stop) != 0
        return: 1
    \out_field: field
return: 0

# Use k's final slot path in l2_mu_rbuf, its length in *n, read where the layout is complete -- a native merge's
# emission, the walk's writing pass -- from the use's names: a method's occurrence, a qualified branch, a named
# Structure, a nested named Structure's slot in the one enclosing it, an own field (4) or a node field by name (6,
# l2_node_seg) -- one a graph place holds by its edge chain first (l2_use_held), then its child --, a cell as the
# walk addresses it (forms 9 and 10, l2_use_cell_slots), a named Structure's field row (14, l2_nsf_slot).  An own
# field with no place ends the path there; a name with no place is an internal error, never a skipped use.
fn: l2_use_resolve (int: k; @: int n) int
    int: j 0
    int: cap 0
    int: s
    int: d
    int: v
    int: tag
    int: kind
    int: ent
    @: L2GraphField field
    @: L2GraphPlace stop
    \n: 0
    while: j < l2_use_len[k]
        tag: l2_use_tags[l2_use_off[k] + j]
        if: cap > c.INT_MAX - 2
            return: l2_error(l2_src, 0, "out of memory")
        cap: cap + 1
        if: l2_use_held(k, j, @ field, @ stop) != 0
            return: 1
        if: field != 0
            d: l2_use_place_below(field\holder, stop, 0)
            if: d < 0
                return: l2_error(l2_src, 0, "internal: a lexical use names a field its node does not hold")
            if: d > c.INT_MAX - 1 - cap
                return: l2_error(l2_src, 0, "out of memory")
            cap: cap + d
        ---
        if: tag = 9 || tag = 10
            s: l2_use_cell_slots(tag, l2_use_slots[l2_use_off[k] + j], 0)
            if: s < 1
                return: l2_error(l2_src, 0, "internal: a lexical use names a cell with no place")
            if: s > c.INT_MAX - 1 - cap
                return: l2_error(l2_src, 0, "out of memory")
            cap: cap + s
        ---
        j: j + 1
    ---
    if: l2_mu_room(cap) != 0
        return: 1
    j: 0
    while: j < l2_use_len[k]
        tag: l2_use_tags[l2_use_off[k] + j]
        v: l2_use_slots[l2_use_off[k] + j]
        s: 0 - 1
        if: tag = 4 && l2_graph_field(v) = 0
            break
        # A field a graph place holds: its edge chain goes in place, its child is s.
        if: l2_use_held(k, j, @ field, @ stop) != 0
            return: 1
        if: field != 0
            \n: \n + l2_use_place_below(field\holder, stop, l2_mu_rbuf + \n)
        if: tag = 1
            s: l2_occ_slot(v)
        if: tag = 2
            s: l2_ebr_unit_slot(v)
        if: tag = 3
            s: l2_ns_unit_slot(v)
        if: tag = 7
            s: l2_ns_field_in_parent(v)
        if: tag = 14
            s: l2_nsf_slot(v)
        if: tag = 4
            s: l2_graph_field_child(v)
        # A cell as the walk addresses it (l2_use_cell_slots): its leading slots go in place, its child is s.
        if: tag = 9 || tag = 10
            \n: \n + l2_use_cell_slots(tag, v, l2_mu_rbuf + \n) - 1
            s: l2_mu_rbuf[\n]
        ---
        if: tag = 6 && l2_node_seg(v, l2_use_text[k], 0U, l2_use_tlen[k], @ s, @ kind, @ ent, 0) != 0
            s: 0 - 1
        if: s < 0
            return: l2_error(l2_src, 0, "internal: a lexical use has no completed place")
        l2_mu_rbuf[\n]: s
        \n: \n + 1
        j: j + 1
    ---
    if: \n = 0
        return: l2_error(l2_src, 0, "internal: a lexical use reaches no place")
return: 0

fn: l2_rw_path_value (@: int path; int: level; int: parent; @: int out) int
    int: model_frame
    int: node
    int: raw
    int: base
    int: kind
    int: uslot
    @: L2GraphPlace stop
    @: L2GraphPlace place
    @: L2GraphField field
    int: req 0 - 1
    if: level = path[2] && l2_use_path(path) != 0
        return: 1
    # An own Structure root is its slot (-189 c3b-3): AT reads the Structure the slot holds.
    # §7b: so is a cached pointer field -- its working value is the Structure its cell holds (OWN), no cell to open.
    if: level = 0 && path[0] = 1
        return: l2_rw_own(parent, path[1], out)
    # A Structure formal is already the Structure the caller passed (ARG), not a cell to open.  A hidden
    # input of a definition its method returns may be absent: its lexical source then (l2_rw_arg_fb).
    if: level = 0 && path[0] = 6
        return: l2_rw_arg_fb(parent, path[1], out)
    # Item 738 with A3: a captured Structure is the method's hidden input -- absent (a returned node called with no
    # binding of it), the graph's: its node path (l2_rw_arg_fb).
    if: level = 0 && path[0] = 7
        return: l2_rw_arg_fb(parent, path[1], out)
    # `node`: the walker's NODE.
    if: level = 0 && path[0] = 8
        return: l2_rw_frame(parent, "LMX_WALK_OP_NODE", 1, out)
    # A control body (7b-3): the body in this activation's data.
    if: level = 0 && path[0] = 9
        return: l2_rw_host_at(parent, path[1], out)
    # A named Structure, a method's occurrence (-196) or a qualified branch (-196) is a unit child:
    # AT(unit, its child).
    if: level = 0
        # path[1] is a named Structure's number only for a named Structure: a method's (3) is not
        # one, and ranking it among the named Structures read past them.
        if: path[0] = 3
            uslot: l2_occ_slot(path[1])
        else:
            if: path[0] = 4
                uslot: l2_ebr_unit_slot(l2_ns_eternal[path[1]])
            else:
                uslot: l2_ns_unit_slot(path[1])
            ---
        ---
        if: l2_rw_frame(parent, "LMX_WALK_OP_AT", 3, out) != 0
            return: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_entry_unit)) != 0 || lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %dU) != c.LMX_WALK_OK\n            return: 1\n", \out, \out, uslot) < 0
            return: 1
        return: 0
    ---
    kind: path[7 + 3 * (level - 1)]
    node: parent
    # A resolved own-field leaf retains its declaration identity. Project
    # the actual holder before reading its child, rather than guessing that
    # the last lexical body is also the physical cell owner.
    if: kind = 16
        field: l2_graph_field(path[6 + 3 * (level - 1)])
        if: field = 0
            return: 1
        stop: 0
        if: level = 1 && path[0] = 9
            stop: l2_graph_body_place(path[1])
        if: level = 1 && path[0] = 8 && l2_node_graph_stop(l2_rw_mi, @ stop) != 0
            return: 1
        if: level > 1 && path[7 + 3 * (level - 2)] = 15
            stop: l2_graph_body_place(path[6 + 3 * (level - 2)])
        if: level = 1 && l2_rw_path_current(path) != 0 && field\holder = stop
            if: l2_rw_frame(parent, "LMX_WALK_OP_AT", 3, @ raw) != 0
                return: 1
            ---
        else:
            if: l2_rw_frame(parent, "LMX_WALK_OP_OF", 3, @ raw) != 0 || l2_rw_graph_path(raw, field\holder, stop, -2, path, level - 1, @ base) != 0 || l2_rw_put(raw, 1, base) != 0
                return: 1
            ---
        ---
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", raw, field\child) < 0
            return: 1
        \out: raw
        return: 0
    ---
    # A resolved body segment carries its body index, not a separately decoded
    # packed/shell path. Project the edge suffix over the actual preceding root.
    if: kind = 15
        if: l2_for_place = 0 || path[6 + 3 * (level - 1)] < 0 || path[6 + 3 * (level - 1)] >= l2_for_n
            return: 1
        place: l2_graph_body_place(path[6 + 3 * (level - 1)])
        if: place = 0
            return: 1
        stop: 0
        if: level = 1 && path[0] = 9
            stop: l2_graph_body_place(path[1])
        if: level > 1 && path[7 + 3 * (level - 2)] = 15
            stop: l2_graph_body_place(path[6 + 3 * (level - 2)])
        if: level = 1 && l2_rw_path_current(path) != 0
            return: l2_rw_graph_path(parent, place, stop, 0 - 1, 0, 0, out)
        return: l2_rw_graph_path(parent, place, stop, 0 - 2, path, level - 1, out)
    # Every reference-binding crossing carries its already resolved receiving
    # model. Structural tails between crossings keep their original slots.
    req: path[8 + 3 * (level - 1)]
    if: level = 1 && l2_rw_path_current(path) != 0
        if: l2_rw_frame(node, "LMX_WALK_OP_AT", 3, @ raw) != 0
            return: 1
        ---
    else:
        if: l2_rw_frame(node, "LMX_WALK_OP_OF", 3 + (cast: (int) (req != -1)), @ raw) != 0 || l2_rw_path_value(path, level - 1, raw, @ base) != 0 || l2_rw_put(raw, 1, base) != 0
            return: 1
        ---
    ---
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %dU) != c.LMX_WALK_OK\n            return: 1\n", raw, path[6 + 3 * (level - 1)]) < 0
        return: 1
    # The same declared-instance operand is used at every reference crossing.
    if: l2_schema_kind(req) = 1 && l2_rw_ns_model(raw, 3, req, -1) != 0
        return: 1
    if: l2_schema_kind(req) = 2 && l2_rw_model_own(raw, 3, l2_mres_own[l2_schema_index(req)]) != 0
        return: 1
    \out: raw
return: 0

# A model operand written at child `slot` of `parent` from own row oi, a merge result's own Structure (K02c): in a
# merge's view the place is reached from the program's unit (l2_rw_type_base) -- the program's merge result, not
# the copy's; whether that is its right source is open (steps/defects.md, T7-MODEL-OPERAND-SOURCE) -- elsewhere
# as any own field's.
fn: l2_rw_model_own (int: parent; int: slot; int: oi) int
    int: frame 0
    int: st
    l2_rw_type_base: (cast: (int) (l2_t7_walk != 0))
    st: l2_rw_own(parent, oi, @ frame)
    l2_rw_type_base: 0
    if: st != 0
        return: 1
return: l2_rw_put(parent, slot, frame)

# The unit a witness occurrence is read from: in a merge's view the program's, elsewhere the entry unit.
fn: l2_rw_types_unit () const: @: char
    if: l2_t7_walk != 0
        return: "l2_program_unit"
return: "l2_entry_unit"

# The array a named Structure's model operand is read from: in a merge's view the program's own Structures
# (l2_nst), not the copy's (l2_nsp); elsewhere they are one.
fn: l2_rw_types_nsp () const: @: char
    if: l2_t7_walk != 0
        return: "l2_nst"
return: "l2_nsp"

# A path read `a\b...` as an operand: the last field's cell (OF over the way to it).
fn: l2_rw_path_read (const: @(LmP0Node node); const: @(LmP0Text t); int: parent; @: int out) int
    []: int path_own 42
    @: int path 0
    path: l2_rw_path_room(t, path_own, 42)
    if: l2_rw_path(node, t, 1, path) != 0
        return: 1
    if: path[3] < 0
        return: l2_rw_refuse(node, "a Structure value")
return: l2_rw_path_value(path, path[2], parent, out)

# A path write `a\b...: v` into a number field.
# - A way fixed when the graph is built -- a named Structure and its inline nested ones, whose nodes
#   the builder has made (l2_nsp) -- is PUT with that holder.
# - Through a reference the holder exists only in R0's turn, so it is PUT_OF (-177 c4, D-54): its
#   holder is evaluated -- the way to the Structure holding the last field (l2_rw_path_value one
#   level up), DEREF opening each reference (-183).
# A whole Structure assigned through a path stays fail-closed (the ruling pinned by
# unit_*_struct_rebind_refused).
fn: l2_rw_path_write (const: @(LmP0Node stmt); const: @(LmP0Text t); @: LmP0Field value; int: n; int: into; @: int out) int
    []: int path_own 42
    @: int path 0
    int: v
    int: h
    int: kind
    int: raw_type
    int: model 0 - 1
    int: saved_mi
    path: l2_rw_path_room(t, path_own, 42)
    if: l2_rw_path(stmt, t, 1, path) != 0
        return: 1
    if: path[3] < 0
        kind: path[7 + 3 * (path[2] - 1)]
        # A physical own-row coordinate does not replace its value category.
        if: kind = 16 && l2_own_is_slot(path[6 + 3 * (path[2] - 1)]) != 0 && l2_own_schema(path[6 + 3 * (path[2] - 1)]) != -1
            kind: 2
        if: kind = 2 || kind = 3
            return: l2_rw_refuse(stmt, "a Structure assigned through a path")
        return: l2_rw_refuse(stmt, "a field path")
    ---
    if: n < 1
        return: l2_rw_refuse(stmt, "this assignment")
    if: l2_own_is_pointer(path[3]) != 0
        saved_mi: l2_cur_mi
        l2_cur_mi: l2_rw_mi
        kind: l2_path_contract(t\data, t\length, @ raw_type, @ model)
        l2_cur_mi: saved_mi
        if: kind != 10 && kind != 11
            return: l2_rw_refuse(stmt, "this reference path")
    ---
    if: path[0] = 4
        return: l2_error(l2_src, stmt, "a qualified immutable branch is not written")
    if: l2_rw_frame(into, "LMX_WALK_OP_PUT", 3, out) != 0
        return: 1
    if: l2_rw_path_value(path, path[2], \out, @ h) != 0 || l2_rw_put(\out, 1, h) != 0
        return: 1
    if: l2_rw_reference_receive(value, n, path[3], model, \out, @ v) != 0
        return: 1
return: l2_rw_put(\out, 2, v)

# D-105 slice 1: is formal k of method mi one a root call site fills with another named type?
fn: l2_d105_sub (int: mi; int: k) int
    int: i 0
    while: i < l2_d105_n
        if: l2_d105_mi[i] = mi && l2_d105_k[i] = k
            return: 1
        i: i + 1
    ---
return: 0

# The tables of the admission by name grow one entry at a time, their blocks doubling.  One block of ints carried
# into `want` entries of room, n of them used.  1 when there is no memory.
fn: l2_d105_ints (@@: int block; int: n; int: want) int
    @: void p
    p: l2_vec_grow((cast: (@: void) (\block)), n, want, c.sizeof(c.int))
    if: p = 0
        return: 1
    \block: (cast: (@: int) p)
return: 0

# Room for one more formal admitted by name.
fn: l2_d105_room () int
    int: want
    if: l2_d105_n < l2_d105_cap
        return: 0
    want: l2_cap_next(l2_d105_cap, l2_d105_n + 1)
    if: want < 0
        l2_alloc_err: 2
        return: 1
    if: l2_d105_ints(@ l2_d105_mi, l2_d105_n, want) != 0 || l2_d105_ints(@ l2_d105_k, l2_d105_n, want) != 0
        return: 1
    l2_d105_cap: want
return: 0

# Room for one more source.
fn: l2_d105s_room () int
    int: want
    @: void p
    if: l2_d105s_n < l2_d105s_cap
        return: 0
    want: l2_cap_next(l2_d105s_cap, l2_d105s_n + 1)
    if: want < 0
        l2_alloc_err: 2
        return: 1
    if: l2_d105_ints(@ l2_d105s_mi, l2_d105s_n, want) != 0 || l2_d105_ints(@ l2_d105s_k, l2_d105s_n, want) != 0 || l2_d105_ints(@ l2_d105s_ty, l2_d105s_n, want) != 0
        return: 1
    if: l2_d105_ints(@ l2_d105s_no, l2_d105s_n, want) != 0
        return: 1
    p: l2_vec_grow((cast: (@: void) l2_d105s_at), l2_d105s_n, want, c.sizeof(@: char))
    if: p = 0
        return: 1
    l2_d105s_at: (cast: (@@: LmP0Node) p)
    l2_d105s_cap: want
return: 0

# Room for one more edge.
fn: l2_d105e_room () int
    int: want
    @: void p
    if: l2_d105e_n < l2_d105e_cap
        return: 0
    want: l2_cap_next(l2_d105e_cap, l2_d105e_n + 1)
    if: want < 0
        l2_alloc_err: 2
        return: 1
    if: l2_d105_ints(@ l2_d105e_fmi, l2_d105e_n, want) != 0 || l2_d105_ints(@ l2_d105e_fk, l2_d105e_n, want) != 0
        return: 1
    if: l2_d105_ints(@ l2_d105e_tmi, l2_d105e_n, want) != 0 || l2_d105_ints(@ l2_d105e_tk, l2_d105e_n, want) != 0
        return: 1
    if: l2_d105_ints(@ l2_d105e_soft, l2_d105e_n, want) != 0
        return: 1
    p: l2_vec_grow((cast: (@: void) l2_d105e_at), l2_d105e_n, want, c.sizeof(@: char))
    if: p = 0
        return: 1
    l2_d105e_at: (cast: (@@: LmP0Node) p)
    l2_d105e_cap: want
return: 0

# Room for one more pair of types.
fn: l2_d105t_room () int
    int: want
    if: l2_d105t_n < l2_d105t_cap
        return: 0
    want: l2_cap_next(l2_d105t_cap, l2_d105t_n + 1)
    if: want < 0
        l2_alloc_err: 2
        return: 1
    if: l2_d105_ints(@ l2_d105t_cand, l2_d105t_n, want) != 0 || l2_d105_ints(@ l2_d105t_req, l2_d105t_n, want) != 0
        return: 1
    l2_d105t_cap: want
return: 0

# Room for the cells of one pair map of required type req: two per field.  0 when there is no memory.
fn: l2_d105_cells (int: req) @: int
    int: need l2_schema_width(req)
    int: want
    @: void p
    if: need < 1
        need: 1
    if: need > c.INT_MAX / 2
        l2_alloc_err: 2
        return: 0
    need: need * 2
    if: need <= l2_d105_tcap
        return: l2_d105_tbuf
    want: l2_cap_next(l2_d105_tcap, need)
    if: want < 0
        l2_alloc_err: 2
        return: 0
    p: l2_vec_grow((cast: (@: void) l2_d105_tbuf), 0, want, c.sizeof(c.int))
    if: p = 0
        return: 0
    l2_d105_tbuf: (cast: (@: int) p)
    l2_d105_tcap: want
return: l2_d105_tbuf

# Record it (once).  1 when there is no memory.
fn: l2_d105_mark (int: mi; int: k) int
    if: l2_d105_sub(mi, k) != 0
        return: 0
    if: l2_d105_room() != 0
        return: 1
    l2_d105_mi[l2_d105_n]: mi
    l2_d105_k[l2_d105_n]: k
    l2_d105_n: l2_d105_n + 1
return: 0

# One cell of the pair table: the slot of cand's field that req's field `name` reaches
# under one occurrence SELECTOR (0 - 1 = the name's LAST occurrence, else the explicit N).
# The selector is resolved on cand exactly as l2_descriptor_used resolves it on both
# schemas -- one selector, two schemas -- so `[N]name` and bare `name` can name different
# candidate fields even when both name one required field (K01).
# 0 and *out filled (-1: a hole, "not carried"); 2 a plain refusal; 3 the nested crossing
# the slice-1 translation boundary owns.
fn: l2_d105_cell (int: cand; const: @(LmP0Text name); int: kind; int: model; const: @(LmP0Text type_word); int: occurrence; int: holes; @: int out) int
    L2SchemaField: actual
    int: hit
    \out: 0 - 1
    if: name = 0
        return: 0
    hit: l2_schema_named(cand, name, occurrence, @ actual)
    if: hit < 0 || actual.kind != kind
        # The map records correspondence, not permission: an absent field, or one
        # of another kind, is a hole where the used-edge check (l2_descriptor_used)
        # owns the refusal for a Consumer that actually reads it.
        if: holes != 0
            return: 0
        return: 2
    ---
    # A nested Structure field, or a reference field, of another named type stays the
    # translation boundary: slice 1 does not translate reading that type's slots through.
    if: (kind = 2 || kind = 3) && actual.model != model
        return: 3
    if: kind = 10 && (actual.type_word = 0 || type_word = 0 || l2_text_same((actual.type_word), type_word) = 0)
        return: 3
    \out: hit
return: 0

# D-105 (Q39): the first, heavy `implements` of named Structure cand admitted to req is by NAME.
# The table carries TWO targets per required field: t[j] is the ORDINAL half -- the slot of
# cand's field named as req's field j, its own occurrence r_j among the required same-named
# fields -- and t[width + j] is the LAST half, cand's LAST occurrence of that name, which is
# what a bare path names.  Both halves come from the same selector applied to cand; a use is
# executed at the edge its own selector chose, so the two coincide only when the value's own
# layout makes them coincide (K01; the layout itself is an implementation decision).
# With holes (every current caller builds the pair MAP), a field of req cand has not, or one
# of another kind, is -1, "not carried": the used-edge check (l2_descriptor_used, via
# l2_admit_consumer_ix) refuses the Consumer that actually reads such a field, and an unused
# incompatible field must not reject the candidate.  Without holes the old strict result
# stays: 1 when a field of req has no field of that name in cand (or another kind), 2 when a
# Structure field -- nested or a reference -- is of another named type.
fn: l2_d105_table (int: cand; int: req; @: int t; int: cap; @: int out_n; int: holes) int
    L2SchemaField: needed
    L2SchemaField: other
    int: w l2_schema_width(req)
    int: j 0
    int: k
    int: occurrence
    int: hit
    \out_n: 0
    if: cand = -1 || req = -1 || w * 2 > cap
        return: 1
    while: j < w
        if: l2_schema_field(req, j, @ needed) != 0
            return: 1
        occurrence: 0
        k: 0
        while: k < j
            if: l2_schema_field(req, k, @ other) != 0
                return: 1
            if: l2_text_same((needed.name), (other.name)) != 0
                occurrence: occurrence + 1
            ---
            k: k + 1
        ---
        hit: l2_d105_cell(cand, (needed.name), (needed.kind), (needed.model), (needed.type_word), occurrence, holes, @ t[j])
        if: hit = 2
            return: 1
        if: hit = 3
            return: 2
        hit: l2_d105_cell(cand, (needed.name), (needed.kind), (needed.model), (needed.type_word), 0 - 1, holes, @ t[w + j])
        if: hit = 2
            return: 1
        if: hit = 3
            return: 2
        j: j + 1
    ---
    \out_n: w * 2
return: 0

# D-105 native (steps/d105-native.md): the native slice's state starts empty with each translation's
# checks.
fn: l2_d105_reset () int
    l2_d105s_n: 0
    l2_d105e_n: 0
    l2_cfa_n: 0
    l2_d105t_n: 0
    l2_d105a_n: 0
    l2_d105a_done: 0
    l2_ide_n: 0
    l2_d105x_n: 0
return: 0

# Is named type ty already a source of formal k of mi?
fn: l2_d105_has (int: mi; int: k; int: ty) int
    int: i 0
    while: i < l2_d105s_n
        if: l2_d105s_mi[i] = mi && l2_d105s_k[i] = k && l2_d105s_ty[i] = ty
            return: 1
        i: i + 1
    ---
return: 0

# D-105 native: named type ty reaches place k of method mi -- formal k, or its result (k = -1) -- at
# `at` (recorded once).
fn: l2_d105_source (int: mi; int: k; int: ty; const: @(LmP0Node at)) int
    if: mi < 0 || ty = -1 || l2_d105_has(mi, k, ty) != 0
        return: 0
    if: l2_d105s_room() != 0
        return: l2_alloc_or(l2_src, at, "out of memory")
    l2_d105s_mi[l2_d105s_n]: mi
    l2_d105s_k[l2_d105s_n]: k
    l2_d105s_ty[l2_d105s_n]: ty
    l2_d105s_no[l2_d105s_n]: 0
    l2_d105s_at[l2_d105s_n]: (cast: (@: LmP0Node) at)
    l2_d105s_n: l2_d105s_n + 1
return: 0

# D-105 native: formal fk of fmi is passed on, as it is, to formal tk of tmi at `at` (recorded once).
fn: l2_d105_edge (int: fmi; int: fk; int: tmi; int: tk; const: @(LmP0Node at)) int
return: l2_d105_edge_add(fmi, fk, tmi, tk, at, 0)

# The edge, hard (0) or soft (1, l2_d105e_soft): a soft edge is no proof that a candidate it brings reaches the input,
# so it is kept apart from a hard one between the same places, which is.
fn: l2_d105_edge_add (int: fmi; int: fk; int: tmi; int: tk; const: @(LmP0Node at); int: soft) int
    int: i 0
    while: i < l2_d105e_n
        if: l2_d105e_fmi[i] = fmi && l2_d105e_fk[i] = fk && l2_d105e_tmi[i] = tmi && l2_d105e_tk[i] = tk && l2_d105e_soft[i] = soft
            return: 0
        i: i + 1
    ---
    if: l2_d105e_room() != 0
        return: l2_alloc_or(l2_src, at, "out of memory")
    l2_d105e_fmi[l2_d105e_n]: fmi
    l2_d105e_fk[l2_d105e_n]: fk
    l2_d105e_tmi[l2_d105e_n]: tmi
    l2_d105e_tk[l2_d105e_n]: tk
    l2_d105e_at[l2_d105e_n]: (cast: (@: LmP0Node) at)
    l2_d105e_soft[l2_d105e_n]: soft
    l2_d105e_n: l2_d105e_n + 1
return: 0

# D-105 native: the unit's pair table cand -> req -- its index (added once), or -1 when there is no memory.
fn: l2_d105_pair (int: cand; int: req) int
    int: i 0
    while: i < l2_d105t_n
        if: l2_d105t_cand[i] = cand && l2_d105t_req[i] = req
            return: i
        i: i + 1
    ---
    if: l2_d105t_room() != 0
        return: 0 - 1
    l2_d105t_cand[l2_d105t_n]: cand
    l2_d105t_req[l2_d105t_n]: req
    l2_d105t_n: l2_d105t_n + 1
return: l2_d105t_n - 1

# D-105 native: a value of static named type cand, written a0 in method mi, reaches place k of idx --
# formal k, or (k = -1) idx's result, at its `return:`.  A formal of mi passed on as it is, or a call
# of a method, whose result is a place too -- an edge; any other value -- a source of its type.
fn: l2_input_name (int: mi; int: k) @: LmP0Text
    int: own l2_d105_key_own(k)
    if: own >= 0 && own < l2_own_n
        return: l2_own_name[own]
    if: mi < 0 || mi >= l2_m_n || k < 0
        return: 0
    if: k < l2_m_arity[mi]
        return: l2_fn(mi, k)
    if: k < l2_m_arity[mi] + l2_m_dyn[mi]
        return: l2_dn(mi, k - l2_m_arity[mi])
return: 0

# The receiving model is declaration metadata, not the value of the lexical
# fallback. An explicit opaque formal must not inherit an outer named type.
fn: l2_input_model (int: mi; int: k) int
    int: model
    int: own l2_d105_key_own(k)
    if: own >= 0 && own < l2_own_n
        return: l2_own_nsty_get(own)
    if: mi < 0 || mi >= l2_m_n
        return: -1
    if: k < l2_m_arity[mi]
        return: l2_nsty_get(mi, k)
    if: k >= l2_m_arity[mi] + l2_m_dyn[mi]
        return: -1
    model: l2_cap_arg_ns(mi, k)
    if: model >= 0
        return: model
    own: l2_own_lexical(mi, l2_input_name(mi, k))
    if: own >= 0
        return: l2_own_nsty_get(own)
return: -1

# Project the same site-selected source as hidden value emission. The input
# index retains forwarding provenance for the existing D105 map closure.
fn: l2_hidden_model_source (int: mi; int: idx; int: k; @: int source_input) int
    @: LmP0Text name l2_dn(idx, k)
    int: own l2_resolved_own(mi, name)
    \source_input: -1
    if: own >= 0 && l2_m_uses[l2_own_off(mi, own)] != 0
        \source_input: l2_d105_own_key(own)
        return: l2_own_schema(own)
    \source_input: l2_param_find(mi, name)
    if: \source_input >= 0
        return: l2_input_schema(mi, \source_input)
    own: l2_own_lexical(idx, name)
    if: own >= 0
        \source_input: l2_d105_own_key(own)
        return: l2_own_schema(own)
return: -1

fn: l2_d105_note (int: mi; int: idx; int: k; @: LmP0Field a0; int: span; const: @(LmP0Node at)) int
    L2ReferenceSource: source
    if: mi < 0 || idx < 0
        return: 0
    l2_reference_source(a0, span, mi, @ source)
    if: source.method >= 0
        return: l2_d105_edge((source.method), (source.place), idx, k, at)
    if: source.layout != -1
        return: l2_d105_source(idx, k, (source.layout), at)
return: 0

# An opaque reference result has no receiving model, but its checked value
# can still contribute possible sources to the existing result key.
fn: l2_d105_note_return (int: mi; @: LmP0Field first; int: n; const: @(LmP0Node at)) int
    int: type
    if: n < 1 || l2_colon_ret_ty(mi, @ type) != 0 || l2_pointer_depth(type) = 0
        return: 0
return: l2_d105_note(mi, mi, -1, first, n, at)

# Room for one more row of the formal-call facts (l2_cfa_*).
fn: l2_cfa_room () int
    int: want
    @: void p
    if: l2_cfa_n < l2_cfa_cap
        return: 0
    want: l2_cap_next(l2_cfa_cap, l2_cfa_n + 1)
    if: want < 0
        l2_alloc_err: 2
        return: 1
    if: l2_d105_ints(@ l2_cfa_mi, l2_cfa_n, want) != 0 || l2_d105_ints(@ l2_cfa_fi, l2_cfa_n, want) != 0 || l2_d105_ints(@ l2_cfa_j, l2_cfa_n, want) != 0
        return: 1
    if: l2_d105_ints(@ l2_cfa_kind, l2_cfa_n, want) != 0 || l2_d105_ints(@ l2_cfa_ty, l2_cfa_n, want) != 0 || l2_d105_ints(@ l2_cfa_sp, l2_cfa_n, want) != 0 || l2_d105_ints(@ l2_cfa_span, l2_cfa_n, want) != 0
        return: 1
    p: l2_vec_grow((cast: (@: void) l2_cfa_a0), l2_cfa_n, want, c.sizeof(@: char))
    if: p = 0
        return: 1
    l2_cfa_a0: (cast: (@@: LmP0Field) p)
    p: l2_vec_grow((cast: (@: void) l2_cfa_at), l2_cfa_n, want, c.sizeof(@: char))
    if: p = 0
        return: 1
    l2_cfa_at: (cast: (@@: LmP0Node) p)
    l2_cfa_cap: want
return: 0

# One row: 1 when there is no memory.
fn: l2_cfa_row (int: mi; int: fi; int: j; int: kind; int: ty; int: sp; @: LmP0Field a0; int: span; const: @(LmP0Node at)) int
    if: l2_cfa_room() != 0
        return: 1
    l2_cfa_mi[l2_cfa_n]: mi
    l2_cfa_fi[l2_cfa_n]: fi
    l2_cfa_j[l2_cfa_n]: j
    l2_cfa_kind[l2_cfa_n]: kind
    l2_cfa_ty[l2_cfa_n]: ty
    l2_cfa_sp[l2_cfa_n]: sp
    l2_cfa_span[l2_cfa_n]: span
    l2_cfa_a0[l2_cfa_n]: a0
    l2_cfa_at[l2_cfa_n]: (cast: (@: LmP0Node) at)
    l2_cfa_n: l2_cfa_n + 1
return: 0

# The D-105 facts of actual j of a call into idx, written a0 in method mi at `at`: idx's own for a call of idx; through
# callable formal fi of mi they are kept for the methods that reach the formal (l2_cfa_apply) -- the contract is no
# callee.
fn: l2_cfa_note (int: mi; int: idx; int: fi; int: j; @: LmP0Field a0; int: span; const: @(LmP0Node at)) int
    if: fi < 0
        return: l2_d105_note(mi, idx, j, a0, span, at)
    if: l2_cfa_row(mi, fi, j, 1, 0 - 1, 0 - 1, a0, span, at) != 0
        return: l2_alloc_or(l2_src, at, "out of memory")
return: 0

fn: l2_cfa_source (int: mi; int: idx; int: fi; int: j; int: ty; const: @(LmP0Node at)) int
    if: fi < 0
        return: l2_d105_source(idx, j, ty, at)
    if: l2_cfa_row(mi, fi, j, 2, ty, 0 - 1, 0, 0, at) != 0
        return: l2_alloc_or(l2_src, at, "out of memory")
return: 0

# 1 when there is no memory, as l2_d105x_add.
fn: l2_cfa_anchor (int: mi; int: idx; int: fi; int: j; int: smi; int: sk) int
    if: fi < 0
        return: l2_d105x_add(smi, sk, idx, j)
return: l2_cfa_row(mi, fi, j, 3, smi, sk, 0, 0, 0)

# Once the flow is closed (l2_cfl_close), the facts kept for each call through a callable formal are given to every
# method that reaches the formal, each into its own formal: analysis metadata, which asks of no method what the call
# does not select.  A static candidate a method's Consumer does not admit (l2_d105_fits) gives that method no record:
# its class refuses the candidate when it is the selected one (l2_emit_class_admit).  A place handed on is a soft edge
# (l2_d105_edge_add): a candidate it brings that a method does not admit is refused where that class forms the input.
fn: l2_cfa_apply () int
    int: r 0
    int: i
    int: n
    while: r < l2_cfa_n
        n: l2_cfl_count(l2_cfa_mi[r], l2_cfa_fi[r])
        i: 0
        while: i < n
            if: l2_cfa_to(r, l2_cfl_at(l2_cfa_mi[r], l2_cfa_fi[r], i)) != 0
                return: 1
            i: i + 1
        ---
        r: r + 1
    ---
return: 0

fn: l2_cfa_to (int: r; int: m) int
    L2ReferenceSource: source
    int: j l2_cfa_j[r]
    int: ty l2_cfa_ty[r]
    int: req
    if: m < 0 || m >= l2_m_n || j < 0 || j >= l2_m_arity[m]
        return: 0
    if: l2_cfa_kind[r] = 3
        if: l2_d105x_add(l2_cfa_ty[r], l2_cfa_sp[r], m, j) != 0
            return: l2_alloc_or(l2_src, 0, "out of memory")
        return: 0
    ---
    if: l2_cfa_kind[r] = 1
        l2_reference_source(l2_cfa_a0[r], l2_cfa_span[r], l2_cfa_mi[r], @ source)
        if: source.method >= 0
            return: l2_d105_edge_add((source.method), (source.place), m, j, l2_cfa_at[r], 1)
        ty: source.layout
    ---
    if: ty = -1
        return: 0
    req: l2_input_schema(m, j)
    if: req != -1 && ty != req && l2_d105_fits(ty, req, m, j) = 0
        return: 0
return: l2_d105_source(m, j, ty, l2_cfa_at[r])

# A receiving instruction needs maps, not a false publication into its
# pointer-holder. The existing compiler edge table uses target method -1
# for this preparation request; target key is the required schema directly.
# These edges never publish values and have no runtime representation.
fn: l2_d105_prepare (int: req; @: L2ReferenceSource source; const: @(LmP0Node at)) int
    if: source\schema != -1 && source\schema != req && l2_d105_edge(-1, source\schema, -1, req, at) != 0
        return: 1
    if: source\layout != -1 && source\layout != source\schema && source\layout != req && l2_d105_edge(-1, source\layout, -1, req, at) != 0
        return: 1
    if: source\method >= 0
        return: l2_d105_edge(source\method, source\place, -1, req, at)
return: 0

# Run only after physical schemas are complete. Unsupported table projection
# stays a located translation refusal, never a later internal emission error.
fn: l2_d105_prepare_pair (int: cand; int: req; const: @(LmP0Node at)) int
    @: int table
    int: length 0
    int: status
    if: cand = -1 || req = -1 || cand = req
        return: 0
    table: l2_d105_cells(req)
    if: table = 0
        return: l2_alloc_or(l2_src, at, "out of memory")
    status: l2_d105_table(cand, req, table, l2_d105_tcap, @ length, 1)
    if: status = 2
        return: l2_error(l2_src, at, "an admission to a Structure type through a Structure field of another type")
    if: status != 0
        return: l2_error(l2_src, at, "an admission to a Structure type")
    if: l2_d105_pair(cand, req) < 0
        return: l2_alloc_or(l2_src, at, "out of memory")
return: 0

# THE COVERAGE OF A RECEIVING PLACE (the receiving-use contract: Codex,
# FABLE-CODEX-20261003-01 and -20261004-01; steps/fable-continuation-20261003.md,
# sections 3 and 29).  A typed reference receives a candidate by what the Consumer
# of that place reads through it, not by the whole shape of its model.  The
# Consumer of a method's own reference is the method's body, and this analysis
# reads it as written: every spelling of the place's name is classified where it
# stands, and one that is not classified makes the coverage UNKNOWN -- which is
# the full reception, never an empty one.
#
# Known coverage is a bounded fact:
#   * the place is an own typed reference of a plain method -- not of the root or
#     of a named Structure's procedure, whose fields are reached by path from
#     elsewhere -- with a named Structure as its model, in a program (a library
#     unit does not see its users);
#   * no path anywhere in the program has the name as a segment below another
#     root: a method's own field is reached that way too;
#   * no definition inside the method -- a nested callable, a named Structure --
#     spells the name: such a definition is another Consumer;
#   * in the method's own body each spelling is the place being received into, an
#     operand of an identity comparison, the root of a path below the place, or
#     the whole candidate of another typed reference of the method -- whose own
#     receiving instruction admits the value by that reference's coverage.
# A pass as an actual, a return, a copy, an address of the place and every other
# whole-value use are UNKNOWN in this slice: their downstream receiving contract
# is not composed.  Same-named declarations of the method are not told apart: the
# uses of all of them are the coverage of each, which only asks for more.
#
# What the bound rests on: the cells of a plain method's occurrence are read by
# that method's body and by paths that spell their names, and by nothing else.
# The occurrence of a plain method is not a value in this translator -- it is no
# merge operand, no copy and no actual (measured 2026-10-04: `merge m` is an
# unknown merge operand, `y: m` an unresolved name).  When it becomes one, a
# spelling of the method's name as a value is a use of every reference the
# method owns, and belongs in this analysis.
#
# A path below the place is resolved on the model, level by level: a number or a
# reference cell is consumed as it stands; a nested Structure the path goes on
# through gets a level of its own; a Structure or a callable the path ends at is
# consumed whole.  The selector is kept: a bare name and `[N]name` are different
# edges of one required field.
fn: l2_ruse_reset () int
    if: l2_ruse_state != 0
        free((cast: (@: void) l2_ruse_state))
    if: l2_ruse_first != 0
        free((cast: (@: void) l2_ruse_first))
    if: l2_ruse_count != 0
        free((cast: (@: void) l2_ruse_count))
    if: l2_ruse_levels != 0
        free((cast: (@: void) l2_ruse_levels))
    if: l2_ruse_e_level != 0
        free((cast: (@: void) l2_ruse_e_level))
    if: l2_ruse_e_row != 0
        free((cast: (@: void) l2_ruse_e_row))
    if: l2_ruse_e_last != 0
        free((cast: (@: void) l2_ruse_e_last))
    if: l2_ruse_e_below != 0
        free((cast: (@: void) l2_ruse_e_below))
    if: l2_ruse_chain_m != 0
        free((cast: (@: void) l2_ruse_chain_m))
    if: l2_ruse_chain_k != 0
        free((cast: (@: void) l2_ruse_chain_k))
    l2_ruse_chain_m: 0
    l2_ruse_chain_k: 0
    l2_ruse_chain_n: 0
    l2_ruse_chain_cap: 0
    l2_ruse_state: 0
    l2_ruse_first: 0
    l2_ruse_count: 0
    l2_ruse_levels: 0
    l2_ruse_cap: 0
    l2_ruse_e_level: 0
    l2_ruse_e_row: 0
    l2_ruse_e_last: 0
    l2_ruse_e_below: 0
    l2_ruse_e_n: 0
    l2_ruse_e_cap: 0
    l2_ruse_unknown: 0
    l2_ruse_unit: 0
return: 0

# One int table grown to `want` cells, the new ones zero.  1 when there is no room.
fn: l2_ruse_grow (@@: int table; int: have; int: want) int
    @: int grown
    int: i have
    grown: (cast: (@: int) realloc((cast: (@: void) (\table)), (cast: (size_t) want) * c.sizeof(c.int)))
    if: grown = 0
        return: 1
    while: i < want
        grown[i]: 0
        i: i + 1
    ---
    \table: grown
return: 0

# The per-row tables hold own row `own`; a row not asked before starts at 0.
fn: l2_ruse_room (int: own) int
    int: want l2_ruse_cap * 2
    if: own < l2_ruse_cap
        return: 0
    if: want < 64
        want: 64
    while: want <= own
        want: want * 2
    ---
    if: l2_ruse_grow(@ l2_ruse_state, l2_ruse_cap, want) != 0 || l2_ruse_grow(@ l2_ruse_first, l2_ruse_cap, want) != 0 || l2_ruse_grow(@ l2_ruse_count, l2_ruse_cap, want) != 0 || l2_ruse_grow(@ l2_ruse_levels, l2_ruse_cap, want) != 0
        return: 1
    l2_ruse_cap: want
return: 0

# The entry of (level, row, half) in the analysis in progress, added when it is
# not there.  -1 when there is no room.
fn: l2_ruse_entry (int: level; int: row; int: last) int
    int: i l2_ruse_cur_first
    int: want l2_ruse_e_cap * 2
    while: i < l2_ruse_e_n
        if: l2_ruse_e_level[i] = level && l2_ruse_e_row[i] = row && l2_ruse_e_last[i] = last
            return: i
        i: i + 1
    ---
    if: l2_ruse_e_n >= l2_ruse_e_cap
        if: want < 64
            want: 64
        if: l2_ruse_grow(@ l2_ruse_e_level, l2_ruse_e_cap, want) != 0 || l2_ruse_grow(@ l2_ruse_e_row, l2_ruse_e_cap, want) != 0 || l2_ruse_grow(@ l2_ruse_e_last, l2_ruse_e_cap, want) != 0 || l2_ruse_grow(@ l2_ruse_e_below, l2_ruse_e_cap, want) != 0
            return: -1
        l2_ruse_e_cap: want
    ---
    l2_ruse_e_level[l2_ruse_e_n]: level
    l2_ruse_e_row[l2_ruse_e_n]: row
    l2_ruse_e_last[l2_ruse_e_n]: last
    l2_ruse_e_below[l2_ruse_e_n]: 0
    l2_ruse_e_n: l2_ruse_e_n + 1
return: l2_ruse_e_n - 1

# One use of the place through the path pd[0..pn): the segments written below
# the place's own name.  A segment the model does not declare, or one that
# cannot be read, makes the coverage unknown.
fn: l2_ruse_path (int: req; const: @(char pd); size_t: pn) int
    int: segs
    int: i 0
    int: level 0
    int: model req
    int: row
    int: kind
    int: ent
    int: occ
    int: e
    size_t: off 0U
    size_t: len 0U
    if: l2_ruse_unknown != 0
        return: 0
    segs: l2_seg_count(pd, pn)
    if: segs < 1
        l2_ruse_unknown: 1
    while: i < segs && l2_ruse_unknown = 0
        kind: -1
        ent: -1
        occ: -1
        row: -1
        if: l2_seg_at(pd, pn, i, @ off, @ len) = 0 && len != 0U && l2_seg_occurrence(pd, off, len, @ occ) = 0
            row: l2_ns_named_row(model, pd, off, len, @ kind, @ ent)
        e: -1
        if: row >= 0
            e: l2_ruse_entry(level, row, (cast: (int) (occ < 0)))
        if: e < 0
            l2_ruse_unknown: 1
            return: 0
        # A number, or a reference cell, is the field itself and nothing below
        # it: a path that goes on through a reference cell goes on in another
        # value, received in full where it was stored.
        if: kind = 0 || kind = 1 || kind = 7 || kind = 8 || kind = 9 || kind = 10 || kind = 11
            return: 0
        # A Structure or a callable the path ends at is consumed whole.
        if: i + 1 = segs || (kind != 2 && kind != 3) || ent < 0
            l2_ruse_e_below[e]: -1
            return: 0
        if: l2_ruse_e_below[e] = -1
            return: 0
        if: l2_ruse_e_below[e] = 0
            l2_ruse_e_below[e]: l2_ruse_cur_levels
            l2_ruse_cur_levels: l2_ruse_cur_levels + 1
        ---
        level: l2_ruse_e_below[e]
        model: ent
        i: i + 1
    ---
return: 0

# How a text spells the name: 0 not at all, 1 exactly, 2 with a mark in front of
# it (`@`, `\`) or a foreign member behind it (`.`) -- a use this analysis does
# not classify.
fn: l2_ruse_spells (const: @(LmP0Text t); const: @(LmP0Text name)) int
    const: @(char d)
    size_t: n
    size_t: skip 0U
    if: t = 0 || t\data = 0 || name = 0 || name\data = 0 || name\length = 0U
        return: 0
    if: l2_uses_name_eq(t, name) != 0
        return: 1
    d: t\data
    n: t\length
    while: skip < n && (d[skip] = 64 || d[skip] = 92)
        skip: skip + 1U
    ---
    if: n - skip < name\length || memcmp(d + skip, name\data, name\length) != 0
        return: 0
    if: n - skip = name\length
        return: 2
    if: d[skip + name\length] = 46
        return: 2
return: 0

# Which segment of a head spells the name: -1 none, 0 its root exactly, 1 any
# other way -- a later segment, a marked root.
fn: l2_ruse_head_at (const: @(LmP0Text head); const: @(LmP0Text name)) int
    LmP0Text: seg
    int: n
    int: i 0
    int: occ 0
    int: how
    size_t: off 0U
    size_t: len 0U
    size_t: noff 0U
    size_t: nlen 0U
    if: head = 0 || head\data = 0 || head\length = 0U || name = 0
        return: -1
    n: l2_seg_count(head\data, head\length)
    while: i < n
        if: l2_seg_at(head\data, head\length, i, @ off, @ len) = 0 && len != 0U
            noff: off
            nlen: len
            if: l2_seg_split(head\data, off, len, @ occ, @ noff, @ nlen) != 0
                noff: off
                nlen: len
            seg.data: head\data + noff
            seg.length: nlen
            how: l2_ruse_spells(@ seg, name)
            if: how != 0
                if: i = 0 && how = 1 && noff = off
                    return: 0
                return: 1
            ---
        ---
        i: i + 1
    ---
return: -1

# Is the field an atom of the one character `ch`?
fn: l2_ruse_one (const: @(LmP0Field f); int: ch) int
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || f\value\as\atom = 0 || f\value\as\atom\data = 0
        return: 0
return: f\value\as\atom\length = 1U && (cast: (int) f\value\as\atom\data[0]) = ch

# Is the field `=` or `!=`: a comparison of identity, for a reference?
fn: l2_ruse_cmp (const: @(LmP0Field f)) int
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
        return: 0
return: l2_text_eq(f\value\as\atom, "=") != 0 || l2_text_eq(f\value\as\atom, "!=") != 0

# The far side of a compared operand: nothing, `&&`, `||`, or -- behind the
# comparison -- the block of the statement the condition heads.  Anything else
# may bind the operand before the comparison does.
fn: l2_ruse_far (const: @(LmP0Field f); int: behind) int
    if: f = 0 || f\value = 0
        return: 1
    if: behind != 0 && f\value\kind = c.LM_P0_NODE_STRUCTURE
        return: 1
    if: f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
        return: 0
return: l2_text_eq(f\value\as\atom, "&&") != 0 || l2_text_eq(f\value\as\atom, "||") != 0

# Any path in this text with the name as a segment below another root?  The
# program-wide half of the analysis: such a path reaches the place from outside
# its method's body.
fn: l2_ruse_seg_struct (const: @(LmP0Structure body); const: @(LmP0Text name)) int
    @: LmP0Field f
    @: LmP0Field g
    if: body = 0
        return: 0
    # A call's actuals, not the Frames that name them (here and in the two scans below).
    f: l2_next_active(l2_call_actuals(body))
    while: f != 0
        if: l2_ruse_one(f, 92) != 0
            g: l2_next_active(f\next)
            if: l2_ruse_one(g, 91) != 0
                while: g != 0 && l2_ruse_one(g, 93) = 0
                    g: l2_next_active(g\next)
                if: g != 0
                    g: l2_next_active(g\next)
            ---
            if: g != 0 && g\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM && g\value\as != 0 && l2_ruse_spells(g\value\as\atom, name) != 0
                return: 1
        ---
        if: l2_ruse_seg_node(f\value, name) != 0
            return: 1
        f: l2_next_active(f\next)
    ---
    if: body\trailer != 0
        return: l2_ruse_seg_struct(body\trailer\body, name)
return: 0

fn: l2_ruse_seg_node (const: @(LmP0Node node); const: @(LmP0Text name)) int
    if: node = 0 || node\as = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        return: l2_ruse_seg_struct(node\as\structure, name)
    if: node\kind != c.LM_P0_NODE_FRAME || node\as\frame = 0
        return: 0
    if: l2_ruse_head_at(node\as\frame\head, name) = 1
        return: 1
    if: l2_ruse_seg_struct(node\as\frame\body, name) != 0
        return: 1
    if: node\as\frame\trailer != 0
        return: l2_ruse_seg_struct(node\as\frame\trailer\body, name)
return: 0

# Does this text spell the name anywhere, in any way?
fn: l2_ruse_mentions_struct (const: @(LmP0Structure body); const: @(LmP0Text name)) int
    @: LmP0Field f
    if: body = 0
        return: 0
    f: l2_next_active(l2_call_actuals(body))
    while: f != 0
        if: l2_ruse_mentions(f\value, name) != 0
            return: 1
        f: l2_next_active(f\next)
    ---
    if: body\trailer != 0
        return: l2_ruse_mentions_struct(body\trailer\body, name)
return: 0

fn: l2_ruse_mentions (const: @(LmP0Node node); const: @(LmP0Text name)) int
    if: node = 0 || node\as = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_ATOM
        return: l2_ruse_spells(node\as\atom, name) != 0
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        return: l2_ruse_mentions_struct(node\as\structure, name)
    if: node\kind != c.LM_P0_NODE_FRAME || node\as\frame = 0
        return: 0
    if: l2_ruse_head_at(node\as\frame\head, name) >= 0
        return: 1
    if: l2_ruse_mentions_struct(node\as\frame\body, name) != 0
        return: 1
    if: node\as\frame\trailer != 0
        return: l2_ruse_mentions_struct(node\as\frame\trailer\body, name)
return: 0

# Is this node the definition of a callable or of a named Structure?
fn: l2_ruse_is_definition (const: @(LmP0Node node)) int
    int: i 0
    if: l2_source_is_callable_definition(node) != 0
        return: 1
    while: i < l2_ns_n
        if: l2_ns_at[i] = node
            return: 1
        i: i + 1
    ---
return: 0

# The name atom of the declaration this statement is, when it declares an own
# row of the method under this name; else null.  That atom is the place being
# declared, not a use of it.
fn: l2_ruse_declared (int: mi; const: @(LmP0Node node); const: @(LmP0Text name)) @: LmP0Text
    int: i 0
    while: i < l2_own_n
        if: l2_own_decl[i] = node && l2_own_mi[i] = mi && l2_uses_name_eq(l2_own_name[i], name) != 0
            return: l2_own_name[i]
        i: i + 1
    ---
return: 0

# Is own row i of method mi a typed reference with a model: a place whose every
# reception runs its own admission?
fn: l2_ruse_typed (int: mi; int: i) int
return: i >= 0 && i < l2_own_n && l2_own_mi[i] = mi && l2_own_is_pointer(l2_own_ty[i]) != 0 && l2_own_is_slot(i) = 0 && l2_own_nsty_get(i) >= 0

# The name atom of the typed reference this statement declares, or null.
fn: l2_ruse_decl_place (int: mi; const: @(LmP0Node node)) @: LmP0Text
    int: i 0
    while: i < l2_own_n
        if: l2_own_decl[i] = node && l2_ruse_typed(mi, i) != 0
            return: l2_own_name[i]
        i: i + 1
    ---
return: 0

# Does this head name typed references of the method and nothing else of it:
# at least one own row of that name, every one of them a typed reference with a
# model, and no formal or hidden input of that name?
fn: l2_ruse_place_named (int: mi; const: @(LmP0Text head)) int
    int: i 0
    int: n 0
    if: head = 0 || l2_param_find(mi, head) >= 0
        return: 0
    while: i < l2_own_n
        if: l2_own_mi[i] = mi && l2_uses_name_eq(l2_own_name[i], head) != 0
            if: l2_ruse_typed(mi, i) = 0
                return: 0
            n: n + 1
        ---
        i: i + 1
    ---
return: n > 0

# The path written after a name in value position: `\` name, or `\` `[` N `]`
# name, repeated.  Its text goes to path[0..*out_n); the result is the field
# after it.  *bad is set when it cannot be read or does not fit.
fn: l2_ruse_follow (@: LmP0Field slash; @: char path; size_t: cap; @: size_t out_n; @: int bad) @: LmP0Field
    @: LmP0Field f slash
    @: LmP0Text t
    size_t: used 0U
    \out_n: 0U
    \bad: 0
    while: f != 0 && l2_ruse_one(f, 92) != 0
        f: l2_next_active(f\next)
        if: used != 0U
            if: used + 1U >= cap
                \bad: 1
                return: f
            path[used]: 92
            used: used + 1U
        ---
        if: l2_ruse_one(f, 91) != 0
            while: f != 0 && l2_ruse_one(f, 93) = 0
                if: f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || f\value\as\atom = 0 || f\value\as\atom\data = 0 || used + f\value\as\atom\length >= cap
                    \bad: 1
                    return: f
                t: f\value\as\atom
                memcpy(path + used, t\data, t\length)
                used: used + t\length
                f: l2_next_active(f\next)
            ---
            if: f = 0 || used + 1U >= cap
                \bad: 1
                return: f
            path[used]: 93
            used: used + 1U
            f: l2_next_active(f\next)
        ---
        if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || f\value\as\atom = 0 || f\value\as\atom\data = 0 || f\value\as\atom\length = 0U || used + f\value\as\atom\length >= cap
            \bad: 1
            return: f
        t: f\value\as\atom
        memcpy(path + used, t\data, t\length)
        used: used + t\length
        f: l2_next_active(f\next)
    ---
    \out_n: used
return: f

# The fields of one body, as statements and as expressions alike: every
# spelling of the name is classified where it stands.  `declared` is the name
# atom of the declaration this body belongs to, or null.  `recv` says the body
# is the candidate of a typed reference of the method: 1 its declaration, whose
# name atom is `place` and whose candidate follows it, 2 a store into it, whose
# whole body is the candidate.
# The place among a call's actuals of field f, when f is one whole actual of it and the call
# gives every formal of `callee` its actual; else -1.
fn: l2_ruse_actual_index (const: @(LmP0Structure body); const: @(LmP0Field f); int: callee) int
    @: LmP0Field a
    int: k 0
    int: span
    if: body = 0 || callee < 0 || callee >= l2_m_n
        return: -1
    a: l2_next_active(l2_call_actuals(body))
    if: l2_actual_count(a) != l2_m_arity[callee]
        return: -1
    while: a != 0
        span: l2_expr_span(a)
        if: span < 1
            return: -1
        if: a = f
            if: span != 1
                return: -1
            return: k
        a: l2_skip_span(a, span)
        k: k + 1
    ---
return: -1

fn: l2_ruse_scan_struct (int: mi; int: req; const: @(LmP0Structure body); const: @(LmP0Text name); const: @(LmP0Text declared); int: recv; const: @(LmP0Text place); int: callee) int
    @: LmP0Field f
    @: LmP0Field prev 0
    @: LmP0Field next
    []: char path_own 256
    @: char path 0
    size_t: room 0U
    size_t: used 0U
    int: bad 0
    int: how
    int: left
    int: right
    if: body = 0
        return: 0
    # A path below the place of any length (l2_text_room).
    room: l2_atoms_len(l2_call_actuals(body), -1) + 1U
    path: l2_text_room(room, path_own, 256U)
    if: path = 0
        l2_ruse_unknown: 1
        return: 0
    f: l2_next_active(l2_call_actuals(body))
    while: f != 0 && l2_ruse_unknown = 0
        next: l2_next_active(f\next)
        how: 0
        if: f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && f\value\as != 0 && f\value\as\atom != 0
            how: l2_ruse_spells(f\value\as\atom, name)
            if: how = 1 && f\value\as\atom = declared
                how: 0
            if: how = 2 || (how = 1 && l2_ruse_one(prev, 92) != 0)
                l2_ruse_unknown: 1
                return: 0
            if: how = 1 && l2_ruse_one(next, 92) != 0
                # The root of a path below the place.
                next: l2_ruse_follow(next, path, room, @ used, @ bad)
                if: bad != 0 || used = 0U
                    l2_ruse_unknown: 1
                    return: 0
                l2_ruse_path(req, path, used)
                how: 0
            ---
            if: how = 1
                # The place itself as a value: only as an operand of a
                # comparison of identity, which consumes none of its fields.
                left: l2_ruse_cmp(prev)
                right: l2_ruse_cmp(next)
                if: (right != 0 && left = 0 && l2_ruse_far(prev, 0) != 0) || (left != 0 && right = 0 && l2_ruse_far(next, 1) != 0)
                    how: 0
                # The whole candidate of another typed reference: that
                # reference's instruction receives the value by its own coverage.
                if: recv = 1 && next = 0 && place != 0 && prev != 0 && prev\value != 0 && prev\value\kind = c.LM_P0_NODE_ATOM && prev\value\as != 0 && prev\value\as\atom = place
                    how: 0
                if: recv = 2 && next = 0 && prev = 0
                    how: 0
                # The whole actual of a method's call.  The callee's formal consumes what the
                # callee reads through it: those reads are composed into this coverage by the
                # same scan, over the callee's body (l2_ruse_compose).
                if: how != 0 && callee >= 0 && l2_ruse_compose(callee, l2_ruse_actual_index(body, f, callee), req) = 0
                    how: 0
                if: how != 0
                    l2_ruse_unknown: 1
                    return: 0
            ---
        else:
            l2_ruse_scan_node(mi, req, f\value, name)
        ---
        prev: f
        f: next
    ---
    if: body\trailer != 0 && l2_ruse_unknown = 0
        return: l2_ruse_scan_struct(mi, req, body\trailer\body, name, 0, 0, 0, 0 - 1)
return: 0

fn: l2_ruse_scan_node (int: mi; int: req; const: @(LmP0Node node); const: @(LmP0Text name)) int
    @: LmP0Frame fr
    @: LmP0Text place 0
    int: recv 0
    int: at
    int: callee 0 - 1
    int: callee_formal 0 - 1
    size_t: k 0U
    if: node = 0 || node\as = 0 || l2_ruse_unknown != 0
        return: 0
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        return: l2_ruse_scan_struct(mi, req, node\as\structure, name, 0, 0, 0, 0 - 1)
    if: node\kind != c.LM_P0_NODE_FRAME || node\as\frame = 0
        return: 0
    fr: node\as\frame
    # A definition inside the method is another Consumer: it is not read here,
    # and a spelling of the name inside it is a use this analysis cannot place.
    # One the program neither calls nor forms into a value is no Consumer (l2_ruse_unconsumed).
    if: l2_ruse_is_definition(node) != 0
        if: l2_ruse_mentions(node, name) != 0 && l2_ruse_unconsumed(node) = 0
            l2_ruse_unknown: 1
        return: 0
    at: l2_ruse_head_at(fr\head, name)
    if: at = 1
        l2_ruse_unknown: 1
        return: 0
    if: at = 0
        while: k < fr\head\length && fr\head\data[k] != 92
            k: k + 1U
        if: k < fr\head\length
            # A path below the place heads the frame: a store to that field, or its call.
            l2_ruse_path(req, fr\head\data + k + 1U, fr\head\length - k - 1U)
        else:
            # The place itself heads the frame.  Written with its colon it is
            # the store that receives into the place; any other application of
            # it is a use this analysis does not classify.
            if: (fr\flags & c.LM_P0_FRAME_COLON) = 0U
                l2_ruse_unknown: 1
                return: 0
        ---
    ---
    # A typed reference of the method received into here: by its declaration,
    # or by a store written with its colon.
    place: l2_ruse_decl_place(mi, node)
    if: place != 0
        recv: 1
    if: place = 0 && (fr\flags & c.LM_P0_FRAME_COLON) != 0U && l2_ruse_place_named(mi, fr\head) != 0
        recv: 2
    # A call of a method by its own name: its actuals are received by its formals.
    if: fr\head != 0
        callee: l2_call_head_method(mi, fr\head, @ callee_formal)
    if: callee >= 0 && callee_formal >= 0
        callee: 0 - 1
    l2_ruse_scan_struct(mi, req, fr\body, name, l2_ruse_declared(mi, node, name), recv, place, callee)
    if: fr\trailer != 0 && l2_ruse_unknown = 0
        l2_ruse_scan_struct(mi, req, fr\trailer\body, name, 0, 0, 0, 0 - 1)
return: 0

# Is the name a segment of a path anywhere in the program: in the unit or in a part?  Such a
# name is reached from other bodies, which this analysis does not read.
fn: l2_ruse_named_by_path (const: @(LmP0Text name)) int
    int: k 0
    if: l2_ruse_unit = 0 || l2_ruse_seg_struct(l2_ruse_unit, name) != 0
        return: 1
    while: k < l2_part_n
        if: l2_part_doc != 0 && l2_part_doc[k] != 0 && l2_ruse_seg_node(lm_p0_document_root(l2_part_doc[k]), name) != 0
            return: 1
        k: k + 1
    ---
return: 0

# The body of method mi read for the spellings of one name, into the analysis in progress:
# past the method's own name and its formals, the rest of the header, then the body and its
# trailers.
fn: l2_ruse_scan_method (int: mi; int: req; const: @(LmP0Text name)) int
    @: LmP0Node node
    @: LmP0Frame fr
    @: LmP0Field f
    node: 0
    if: mi >= 0 && mi < l2_m_n
        node: l2_m_node[mi]
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0
        l2_ruse_unknown: 1
        return: 0
    fr: node\as\frame
    f: l2_next_active(fr\body\first_field)
    if: f != 0
        f: l2_next_active(f\next)
    if: f != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_STRUCTURE
        f: l2_next_active(f\next)
    while: f != 0 && l2_ruse_unknown = 0
        if: f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM
            if: l2_ruse_mentions(f\value, name) != 0
                l2_ruse_unknown: 1
            ---
        else:
            l2_ruse_scan_node(mi, req, f\value, name)
        ---
        f: l2_next_active(f\next)
    ---
    if: l2_ruse_unknown = 0 && fr\body\trailer != 0
        l2_ruse_scan_struct(mi, req, fr\body\trailer\body, name, 0, 0, 0, 0 - 1)
    if: l2_ruse_unknown = 0 && fr\trailer != 0
        l2_ruse_scan_struct(mi, req, fr\trailer\body, name, 0, 0, 0, 0 - 1)
return: 0

# The reads of method `callee` through its formal k, composed into the analysis in progress.
# 0 when they are composed.  The formal receives by the same model; it is a plain method's;
# nothing else in the callee has its name and no path in the program names it; and the
# callee's body is classified by the same scan, which leaves the coverage unknown where it
# cannot classify.  1 when they are not composed: the caller's use stays unclassified.
# A call chain that comes back to a formal already being read adds nothing to that formal.
fn: l2_ruse_compose (int: callee; int: k; int: req) int
    @: LmP0Text name
    int: i 0
    int: want
    if: callee < 0 || callee >= l2_m_n || callee = l2_e || k < 0 || k >= l2_m_arity[callee]
        return: 1
    if: l2_m_nsof(callee) >= 0 || l2_mad_on(callee) != 0 || l2_mad_host_of(callee) >= 0 || l2_m_file(callee) >= 0
        return: 1
    if: l2_nsty_get(callee, k) != req
        return: 1
    name: l2_fn(callee, k)
    if: name = 0 || l2_own_any(callee, name) >= 0 || l2_ruse_named_by_path(name) != 0
        return: 1
    while: i < l2_ruse_chain_n
        if: l2_ruse_chain_m[i] = callee && l2_ruse_chain_k[i] = k
            return: 0
        i: i + 1
    ---
    if: l2_ruse_chain_n >= l2_ruse_chain_cap
        want: l2_ruse_chain_cap * 2
        if: want < 16
            want: 16
        if: l2_ruse_grow(@ l2_ruse_chain_m, l2_ruse_chain_cap, want) != 0 || l2_ruse_grow(@ l2_ruse_chain_k, l2_ruse_chain_cap, want) != 0
            return: 1
        l2_ruse_chain_cap: want
    ---
    l2_ruse_chain_m[l2_ruse_chain_n]: callee
    l2_ruse_chain_k[l2_ruse_chain_n]: k
    l2_ruse_chain_n: l2_ruse_chain_n + 1
    l2_ruse_scan_method(callee, req, name)
    l2_ruse_chain_n: l2_ruse_chain_n - 1
return: l2_ruse_unknown

# Is this definition inside a method unconsumed: a callable's definition that the checked
# program neither calls nor forms into a value?  These are facts of the definition's own
# identity, established by the check of every body: no call edge leads to it -- a call by its
# name, by a path, through a copy -- it is no callable actual and no converter's model
# (l2_m_value_used), and no host returns it (l2_mad_model).  What such a definition reads is no
# requirement of the Consumer that runs: the presence of a definition is not its execution.
# Any other definition stays another Consumer this analysis does not compose.
fn: l2_ruse_unconsumed (const: @(LmP0Node node)) int
    int: d 0 - 1
    int: i 0
    while: i < l2_m_n && d < 0
        if: l2_m_node[i] = node
            d: i
        i: i + 1
    ---
    if: d < 0 || d = l2_e || l2_m_nsof(d) >= 0 || l2_m_edge = 0
        return: 0
    if: l2_m_value_used != 0 && l2_m_value_used[d] != 0
        return: 0
    i: 0
    while: i < l2_m_n
        if: l2_edge_off(i, d) = (cast: (size_t) -1) || l2_m_edge[l2_edge_off(i, d)] != 0
            return: 0
        if: l2_mad_on(i) != 0 && l2_mad_model[i] = d
            return: 0
        i: i + 1
    ---
return: 1

# The analysis of own row `own`: 2 with its entries recorded, or 1.
fn: l2_ruse_analyse (int: own) int
    int: mi
    int: req
    @: LmP0Node node
    @: LmP0Text name
    if: own < 0 || own >= l2_own_n || l2_library_mode != 0
        return: 1
    mi: l2_own_mi[own]
    name: l2_own_name[own]
    req: l2_own_nsty_get(own)
    if: mi < 0 || mi >= l2_m_n || mi = l2_e || name = 0 || l2_m_nsof(mi) >= 0
        return: 1
    if: l2_own_is_pointer(l2_own_ty[own]) = 0 || l2_own_is_slot(own) != 0 || req < 0 || l2_schema_kind(req) != 1
        return: 1
    if: l2_param_find(mi, name) >= 0
        return: 1
    node: l2_m_node[mi]
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0
        return: 1
    if: l2_ruse_named_by_path(name) != 0
        return: 1
    l2_ruse_unknown: 0
    l2_ruse_cur_first: l2_ruse_e_n
    l2_ruse_cur_levels: 1
    l2_ruse_chain_n: 0
    l2_ruse_scan_method(mi, req, name)
    if: l2_ruse_unknown != 0
        l2_ruse_e_n: l2_ruse_cur_first
        l2_ruse_unknown: 0
        return: 1
    l2_ruse_first[own]: l2_ruse_cur_first
    l2_ruse_count[own]: l2_ruse_e_n - l2_ruse_cur_first
    l2_ruse_levels[own]: l2_ruse_cur_levels
return: 2

# Which half of the model's field at `slot` the known coverage of own row `own` names at its
# root: 0 none, 1 the ordinal half (or both), 2 the last half alone.
fn: l2_ruse_root_slot (int: own; int: req; int: slot) int
    int: row
    int: half 0
    int: i l2_ruse_first[own]
    int: end l2_ruse_first[own] + l2_ruse_count[own]
    if: l2_schema_kind(req) != 1
        return: 0
    row: l2_ns_row_at_slot(l2_schema_index(req), slot)
    if: row < 0
        return: 0
    while: i < end
        if: l2_ruse_e_level[i] = 0 && l2_ruse_e_row[i] = row
            if: l2_ruse_e_last[i] = 0
                return: 1
            half: 2
        ---
        i: i + 1
    ---
return: half

# The coverage of own row `own`: 2 known, 1 unknown.  Asked once per row: the
# answer is a fact of the source, the same for the flow of types, for native
# emission and for both passes of the graph producer.
fn: l2_ruse_of (int: own) int
    if: own < 0 || own >= l2_own_n || l2_ruse_room(own) != 0
        return: 1
    if: l2_ruse_state[own] = 0
        l2_ruse_state[own]: l2_ruse_analyse(own)
return: l2_ruse_state[own]

# The cells a receiving instruction carries for the known coverage of own row
# `own` (LmxImplUses, lmx_implements.h): the count of cells, then each level --
# its count of pairs, then (edge, below) per entry.  An edge is the field's
# placed slot in its model, plus the model's width for a bare name's half.
fn: l2_ruse_level_count (int: own; int: level) int
    int: i l2_ruse_first[own]
    int: end l2_ruse_first[own] + l2_ruse_count[own]
    int: n 0
    while: i < end
        if: l2_ruse_e_level[i] = level
            n: n + 1
        i: i + 1
    ---
return: n

# The cell a level starts at; for the count of levels, the count of cells.
fn: l2_ruse_level_at (int: own; int: level) int
    int: at 1
    int: lv 0
    while: lv < level
        at: at + 1 + 2 * l2_ruse_level_count(own, lv)
        lv: lv + 1
    ---
return: at

fn: l2_ruse_cells (int: own) int
return: l2_ruse_level_at(own, l2_ruse_levels[own])

# Cell k: \whole is set for the cell that says "everything below", else \value
# is the cell.  1 when the row has no such cell or a field has no place yet.
fn: l2_ruse_cell (int: own; int: k; @: int whole; @: int value) int
    int: i
    int: end l2_ruse_first[own] + l2_ruse_count[own]
    int: lv 0
    int: at 1
    int: ix
    int: slot
    \whole: 0
    \value: 0
    if: k = 0
        \value: l2_ruse_cells(own)
        return: 0
    while: lv < l2_ruse_levels[own]
        if: k = at
            \value: l2_ruse_level_count(own, lv)
            return: 0
        ix: 0
        i: l2_ruse_first[own]
        while: i < end
            if: l2_ruse_e_level[i] = lv
                if: k = at + 1 + 2 * ix
                    slot: l2_nsf_slot(l2_ruse_e_row[i])
                    if: slot < 0
                        return: 1
                    if: l2_ruse_e_last[i] != 0
                        slot: slot + l2_d105_width(l2_nsf_owner[l2_ruse_e_row[i]])
                    \value: slot
                    return: 0
                if: k = at + 2 + 2 * ix
                    if: l2_ruse_e_below[i] < 0
                        \whole: 1
                    if: l2_ruse_e_below[i] > 0
                        \value: l2_ruse_level_at(own, l2_ruse_e_below[i])
                    return: 0
                ix: ix + 1
            ---
            i: i + 1
        ---
        at: at + 1 + 2 * ix
        lv: lv + 1
    ---
return: 1

# Native: the coverage as the instruction's own cells, and the view over them.
fn: l2_ruse_emit_native (int: own; int: seq; const: @(char ind)) int
    int: n l2_ruse_cells(own)
    int: k 0
    int: whole 0
    int: value 0
    if: c.fprintf(l2_out, "%s[]: size_t l2_ruse%d %d\n", ind, seq, n) < 0
        return: 1
    while: k < n
        if: l2_ruse_cell(own, k, @ whole, @ value) != 0
            return: l2_error(l2_src, 0, "internal: a coverage cell has no place")
        if: whole != 0 && c.fprintf(l2_out, "%sl2_ruse%d[%d]: (cast: (size_t) -1)\n", ind, seq, k) < 0
            return: 1
        if: whole = 0 && c.fprintf(l2_out, "%sl2_ruse%d[%d]: %dU\n", ind, seq, k, value) < 0
            return: 1
        k: k + 1
    ---
    if: c.fprintf(l2_out, "%sLmxImplUses: l2_rusev%d\n%sl2_rusev%d.map: l2_ruse%d\n%sl2_rusev%d.frame: 0\n%sl2_rusev%d.at: 0U\n", ind, seq, ind, seq, seq, ind, seq, ind, seq) < 0
        return: 1
return: 0

# A full reference reception publishes a value only after successful
# admission. Prune only definitely missing/incompatible named fields from
# downstream source facts. Unnamed operations and unresolved crossings are
# not interface rejection; ordinary formal edges retain used-field admission.
# A place whose Consumer's coverage is known prunes by the fields that coverage
# names at the root; a place of unknown coverage, by every field.
fn: l2_d105_receiving_flow (int: cand; int: mi; int: key) int
    L2SchemaField: needed
    L2SchemaField: actual
    L2SchemaField: previous
    int: own l2_d105_key_own(key)
    int: req l2_input_schema(mi, key)
    int: width
    int: slot 0
    int: prior
    int: occurrence
    int: known
    int: half
    if: own < 0 || req = -1 || cand = req || l2_schema_kind(cand) = 0
        return: 1
    # A place of known coverage requires the fields its coverage names at the root, each by
    # the half it names, and looks at no other field: a candidate that lacks one of them is
    # refused where the place receives it and reaches no later Consumer.  A place of unknown
    # coverage receives in full and requires every field.
    known: (cast: (int) (l2_ruse_of(own) = 2))
    width: l2_schema_width(req)
    while: slot < width
        if: l2_schema_field(req, slot, @ needed) != 0
            return: 1
        half: 1
        if: known != 0
            half: l2_ruse_root_slot(own, req, slot)
        if: needed.name != 0 && half != 0
            occurrence: 0
            prior: 0
            while: prior < slot
                if: l2_schema_field(req, prior, @ previous) != 0
                    return: 1
                if: l2_text_same((needed.name), (previous.name)) != 0
                    occurrence: occurrence + 1
                prior: prior + 1
            ---
            if: half = 2
                occurrence: 0 - 1
            if: l2_schema_named_meta(cand, (needed.name), occurrence, @ actual) < 0
                return: 0
            if: actual.kind >= 0 && needed.kind >= 0
                # Nested values, stored Structure references and callable
                # values share the materialized Structure domain. Different
                # schema producers are not by themselves a runtime mismatch.
                if: actual.kind != needed.kind && (actual.kind < 2 || actual.kind > 4 || needed.kind < 2 || needed.kind > 4)
                    return: 0
                if: actual.kind >= 10 && actual.model >= 0 && needed.model >= 0 && actual.model != needed.model
                    return: 0
                if: actual.kind = 5 && actual.model >= 0 && needed.model >= 0 && actual.model != needed.model
                    return: 0
            ---
        ---
        slot: slot + 1
    ---
return: 1

# D-105 native: the method a value written a0 calls, when it is one call (its result is the value), or -1.
fn: l2_d105_callee (int: mi; @: LmP0Field a0; int: span) int
    int: formal -1
    if: span != 1 || a0 = 0 || a0\value = 0 || a0\value\as = 0
        return: -1
    if: a0\value\kind = c.LM_P0_NODE_ATOM
        return: l2_call_head_method(mi, a0\value\as\atom, @ formal)
    if: a0\value\kind != c.LM_P0_NODE_FRAME || a0\value\as\frame = 0 || a0\value\as\frame\head = 0
        return: 0 - 1
return: l2_call_head_method(mi, a0\value\as\frame\head, @ formal)

# Whether the Consumer of place k of mi admits named type ty to req, said nowhere: 1 yes, 0 no, -1 when the question
# cannot be answered quietly (the check that says it is then the ordinary one).
fn: l2_d105_fits (int: ty; int: req; int: mi; int: k) int
    int: compatible 0
    int: status
    if: k >= 0 && l2_m_node[mi] != 0 && l2_m_node[mi]\as != 0
        l2_uses_reset()
        if: l2_uses_walk_frame(l2_input_name(mi, k), l2_m_node[mi]\as\frame) != 0 || l2_uses_oom != 0
            l2_uses_reset()
            return: -1
        status: l2_descriptor_used(ty, req, @ compatible)
        l2_uses_reset()
    else:
        status: l2_descriptor_implements(ty, req, req, @ compatible)
    ---
    if: status != 0
        return: -1
return: compatible

# RECEPTION-EDGE-DEBTS (d) (Codex, FABLE-CODEX-20261004-12: "A merely POSSIBLE incompatible dynamic source is not
# proof that every call is incompatible.  Keep the actual runtime selection and ordinary admission: the good branch
# succeeds, the incompatible branch fails catchably at the receiving edge.").  Source i, a type ty at input k of mi
# that the input's Consumer does not admit, is a possible candidate there when every edge that brings ty to the
# input brings, from the same place, a candidate the Consumer admits: no call through such an edge is proved
# incompatible.  A source no edge brings -- the checks recorded it at the input, and refused it there when it does
# not fit -- is a definite one, and so is one an edge brings with nothing admissible beside it: every call through
# that edge is incompatible.
fn: l2_d105_possible (int: i; int: req) int
    int: e 0
    int: j
    int: alt
    int: found 0
    if: l2_d105s_k[i] < -1
        return: 0
    while: e < l2_d105e_n
        if: l2_d105e_tmi[e] = l2_d105s_mi[i] && l2_d105e_tk[e] = l2_d105s_k[i] && l2_d105e_fmi[e] >= 0 && l2_d105_has(l2_d105e_fmi[e], l2_d105e_fk[e], l2_d105s_ty[i]) != 0
            # COPIED-METHOD-DECLARED-FORMAL: a soft edge brings its candidate only when the method's class is the one a
            # call through a callable formal selects -- no proof that a call is incompatible.
            if: l2_d105e_soft[e] != 0
                found: 1
                e: e + 1
                continue
            # RECEPTION-EDGE-DEBTS (f): at a result, only the return of a value of opaque type admits its value when
            # the program runs as the method's implicit `implements`; any other return's admission is a proof.
            if: l2_d105s_k[i] = -1 && l2_d105_opaque_place(l2_d105e_fmi[e], l2_d105e_fk[e]) = 0 && (l2_d105e_fk[e] != -1 || l2_m_ret[l2_d105e_fmi[e]] != 16)
                return: 0
            found: 1
            alt: 0
            j: 0
            while: j < l2_d105s_n && alt = 0
                if: l2_d105s_mi[j] = l2_d105e_fmi[e] && l2_d105s_k[j] = l2_d105e_fk[e] && (l2_d105s_ty[j] = req || l2_d105_fits(l2_d105s_ty[j], req, l2_d105s_mi[i], l2_d105s_k[i]) = 1)
                    alt: 1
                j: j + 1
            ---
            if: alt = 0
                return: 0
        ---
        e: e + 1
    ---
return: found

# Whether named type ty is a possible candidate of input tk of tmi that its Consumer refused (l2_d105_close): an
# admission formed into that input offers it no pair map, and its value is refused when the program runs.
fn: l2_d105_refused (int: tmi; int: tk; int: ty) int
    int: i 0
    if: tmi < 0
        return: 0
    while: i < l2_d105s_n
        if: l2_d105s_mi[i] = tmi && l2_d105s_k[i] = tk && l2_d105s_ty[i] = ty && l2_d105s_no[i] != 0
            return: 1
        i: i + 1
    ---
return: 0

# D-105 native (REVIEW 9c34b3b: marking is transitive; the tables are the unit's, one per pair of types):
# after the checks and the root's count, before any layout.  The sources flow along the edges to a fixed
# point; a formal that a source of another type reaches is marked (l2_d105_mark), and the pair table
# source -> the formal's type joins the unit's (l2_d105_pair) -- built by name (l2_d105_table), refused
# here, located at the call site, when it cannot be.
fn: l2_d105_close () int
    @: L2ReferenceSource source
    int: own
    int: changed 1
    int: before
    int: e
    int: i
    int: n
    int: req
    int: ty
    int: why
    int: tn 0
    @: int t 0
    i: 0
    while: i < l2_own_n
        ty: l2_own_source_layout(i)
        if: ty != -1 && l2_d105_source(l2_own_mi[i], l2_d105_own_key(i), ty, l2_own_decl[i]) != 0
            return: 1
        i: i + 1
    ---
    # A single retained operand can return its existing physical descriptor.
    # Catalogue that possible source alongside the fresh declaration source;
    # only reached construction decides which origin the actual value has.
    i: 0
    while: i < l2_mres_n
        source: @ l2_mres_source[i]
        own: l2_mres_own[i]
        if: source\method >= 0
            if: l2_d105_edge(source\method, source\place, l2_own_mi[own], l2_d105_own_key(own), l2_own_decl[own]) != 0
                return: 1
            ---
        else:
            if: source\layout != -1 && l2_d105_source(l2_own_mi[own], l2_d105_own_key(own), source\layout, l2_own_decl[own]) != 0
                return: 1
            ---
        ---
        i: i + 1
    ---
    while: changed != 0
        changed: 0
        e: 0
        while: e < l2_d105e_n
            if: l2_d105e_tmi[e] < 0
                e: e + 1
                continue
            i: 0
            n: l2_d105s_n
            while: i < n
                if: l2_d105s_mi[i] = l2_d105e_fmi[e] && l2_d105s_k[i] = l2_d105e_fk[e] && l2_d105_has(l2_d105e_tmi[e], l2_d105e_tk[e], l2_d105s_ty[i]) = 0
                    # Direct candidates are also catalogued at their receiving
                    # own key. A definite failed reception never publishes that
                    # candidate for a later consumer of the stored value.
                    if: l2_d105_receiving_flow(l2_d105s_ty[i], l2_d105e_fmi[e], l2_d105e_fk[e]) = 0
                        i: i + 1
                        continue
                    # Even a refused candidate needs its instruction's exact
                    # alternative. Reserve it before cutting publication flow;
                    # this does not register a runtime successful admission.
                    req: l2_input_schema(l2_d105e_tmi[e], l2_d105e_tk[e])
                    ty: l2_d105s_ty[i]
                    if: req != -1 && ty != req && l2_d105_pair(ty, req) < 0
                        return: l2_alloc_or(l2_src, l2_d105e_at[e], "out of memory")
                    if: l2_d105_receiving_flow(ty, l2_d105e_tmi[e], l2_d105e_tk[e]) = 0
                        i: i + 1
                        continue
                    before: l2_d105s_n
                    if: l2_d105_source(l2_d105e_tmi[e], l2_d105e_tk[e], l2_d105s_ty[i], l2_d105e_at[e]) != 0
                        return: 1
                    # A change is a source added: the fixed point cannot turn on one that was not.
                    if: l2_d105s_n != before
                        changed: 1
                ---
                i: i + 1
            ---
            e: e + 1
        ---
    ---
    i: 0
    while: i < l2_d105s_n
        # K02c: the requirement is the place's SCHEMA -- a hidden input's may be a merge result's (tagged).
        req: l2_input_schema(l2_d105s_mi[i], l2_d105s_k[i])
        ty: l2_d105s_ty[i]
        if: req != -1 && ty != req
            if: l2_library_mode != 0
                return: l2_error(l2_src, l2_d105s_at[i], "an admission to a Structure type by name in a library unit (D-105: the pair tables are a program's)")
            # RECEPTION-EDGE-DEBTS (d): a possible candidate an input's Consumer cannot admit is refused when the
            # program runs, where the input is formed, and not here: it gets no pair map and marks nothing.
            if: l2_d105s_k[i] >= -1 && l2_d105_fits(ty, req, l2_d105s_mi[i], l2_d105s_k[i]) = 0 && l2_d105_possible(i, req) != 0
                l2_d105s_no[i]: 1
                i: i + 1
                continue
            ---
            # Admission is by the consumer's uses (book: a field the formal's method never reads need not
            # be there): the same check a direct call site had, for every source -- one carried along an
            # edge too; a field the source has not is a hole of the pair table.
            if: l2_d105s_k[i] >= 0
                if: l2_m_node[l2_d105s_mi[i]] != 0 && l2_m_node[l2_d105s_mi[i]]\as != 0
                    if: l2_admit_consumer_ix(ty, req, l2_input_name(l2_d105s_mi[i], l2_d105s_k[i]), l2_m_node[l2_d105s_mi[i]]\as\frame, l2_src, l2_d105s_at[i], "function argument") != 0
                        return: 1
                    ---
                else:
                    if: l2_admit_implements(ty, req, req, 0, l2_src, l2_d105s_at[i], "function argument") != 0
                        return: 1
                    ---
                ---
            # A result's callers are not in its method: its value is admitted as a return value is, by
            # every field of the result's type (l2_admit_return), for a type carried along an edge too.
            if: l2_d105s_k[i] = -1 && l2_admit_implements(ty, req, req, 0, l2_src, l2_d105s_at[i], "return value") != 0
                return: 1
            # An ordinary reference binding checks its full receiver only
            # when reached, after evaluating the candidate. Recording layout
            # alternatives must not turn that runtime refusal into a check here.
            t: l2_d105_cells(req)
            if: t = 0
                return: l2_alloc_or(l2_src, l2_d105s_at[i], "out of memory")
            why: l2_d105_table(ty, req, t, l2_d105_tcap, @ tn, 1)
            if: why = 2
                return: l2_error(l2_src, l2_d105s_at[i], "an admission to a Structure type through a Structure field of another type")
            if: why != 0
                return: l2_error(l2_src, l2_d105s_at[i], "an admission to a Structure type")
            if: l2_d105_mark(l2_d105s_mi[i], l2_d105s_k[i]) != 0
                return: l2_alloc_or(l2_src, l2_d105s_at[i], "out of memory")
            if: l2_d105_pair(ty, req) < 0
                return: l2_alloc_or(l2_src, l2_d105s_at[i], "out of memory")
        ---
        i: i + 1
    ---
    # Every modeled edge has a declared-source default map in the emitted
    # admission, even when no genuine layout source propagated along it.
    # Reserve that instruction constant before the maps are declared. This
    # does not establish layout evidence or a successful receiving admission.
    e: 0
    while: e < l2_d105e_n
        if: l2_d105e_fmi[e] < 0
            ty: l2_d105e_fk[e]
        else:
            ty: l2_input_schema(l2_d105e_fmi[e], l2_d105e_fk[e])
        ---
        if: l2_d105e_tmi[e] < 0
            req: l2_d105e_tk[e]
            i: 0
            while: l2_d105e_fmi[e] >= 0 && i < l2_d105s_n
                if: l2_d105s_mi[i] = l2_d105e_fmi[e] && l2_d105s_k[i] = l2_d105e_fk[e] && l2_d105_prepare_pair(l2_d105s_ty[i], req, l2_d105e_at[e]) != 0
                    return: 1
                i: i + 1
            ---
        else:
            req: l2_input_schema(l2_d105e_tmi[e], l2_d105e_tk[e])
        ---
        if: l2_d105_prepare_pair(ty, req, l2_d105e_at[e]) != 0
            return: 1
        e: e + 1
    ---
    # The identity entries of every reception along a recorded edge (l2_identity_list) have their pair maps among
    # the program's, reserved here before the maps are declared.  An entry is no admission: the record is asked.
    e: 0
    while: e < l2_d105e_n
        if: l2_ide_reserve(l2_d105e_fmi[e], l2_d105e_fk[e], l2_d105e_tmi[e], l2_d105e_tk[e]) != 0
            return: 1
        e: e + 1
    ---
    e: 0
    while: e < l2_d105x_n
        if: l2_ide_reserve(l2_d105x_fmi[e], l2_d105x_fk[e], l2_d105x_tmi[e], l2_d105x_tk[e]) != 0
            return: 1
        e: e + 1
    ---
return: 0

# Has method mi a formal admitted by name?
fn: l2_d105_any (int: mi) int
    int: i 0
    while: i < l2_d105_n
        if: l2_d105_mi[i] = mi
            return: 1
        i: i + 1
    ---
return: 0

# The program's pair map p, as an expression in the method being written: its static array.  A pair asked for after
# the maps were declared has none -- an internal error, said.
fn: l2_d105_tnode (int: p; @: char dest) int
    if: p < 0 || p >= l2_d105t_n
        return: 1
    if: l2_d105t_declared >= 0 && p >= l2_d105t_declared
        return: l2_error(l2_src, 0, "internal: a pair map of D-105 was asked for after the maps were declared")
return: (cast: (int) (c.sprintf(dest, "l2_d105m%d", p) < 0))

# The width of named type req's node -- its fields, and a procedure's bodies and steps (R9): a pair map has one slot
# per child of req (lmx_implements_register_map: n is req's width).
fn: l2_d105_width (int: req) int
    if: l2_schema_kind(req) = 2
        return: l2_mrs_width(l2_schema_index(req))
    if: req < 0 || req >= l2_ns_n
        return: 0
return: l2_ns_width(req)

# The pair maps at module scope, one static size_t array per pair (a library unit's names are unit-hashed, as its
# module cells are); the builder fills them (l2_d105_emit_tables).  A pair map carries 2*width cells: the ORDINAL
# half then the LAST half (K01) -- the entry's registered width stays the semantic width of req.
fn: l2_d105_declare_maps () int
    int: q 0
    int: count l2_ns_n + l2_mres_n
    if: count = 0
        count: 1
    if: l2_library_mode != 0 && c.fprintf(l2_out, "define: l2_layout_tokens l2_u%08X%08X_layout_tokens\n", l2_module_hash_a, l2_module_hash_b) < 0
        return: 1
    if: c.fprintf(l2_out, "[]: char l2_layout_tokens %d\n", count) < 0
        return: 1
    while: q < l2_d105t_n
        if: l2_library_mode != 0 && c.fprintf(l2_out, "define: l2_d105m%d l2_u%08X%08X_d105m%d\n", q, l2_module_hash_a, l2_module_hash_b, q) < 0
            return: 1
        if: c.fprintf(l2_out, "[]: size_t l2_d105m%d %d\n", q, l2_d105_width(l2_d105t_req[q]) * 2) < 0
            return: 1
        q: q + 1
    ---
    l2_d105t_declared: l2_d105t_n
return: 0

# Whether a candidate read from place `key` of method mi -- an input's index, or an own key -- can be a value the
# translation has no layout for.  A reference place holds what was given to it: an input of the method, an own
# reference, a field bound when the program runs can hold a letter, or a value no site of this translation gave.
# A Structure a merge or a declaration made, held by value, is that one and no other.
fn: l2_d105_place_dynamic (int: mi; int: key) int
    int: own l2_d105_key_own(key)
    if: own < 0 || own >= l2_own_n
        return: 1
    if: l2_mres_of_own(own) >= 0
        return: 0
return: (cast: (int) (l2_own_is_slot(own) = 0 || l2_own_source_layout(own) = -1))

# The same for a candidate as its expression gives it (l2_reference_source).  Direct producer evidence -- a named
# Structure, the leaf of a path -- is no dynamic candidate.  A place is what l2_d105_place_dynamic says.  A
# candidate with no place and no evidence is one.
fn: l2_d105_dynamic (@: L2ReferenceSource source) int
    if: source = 0 || source\layout != -1
        return: 0
    if: source\method < 0
        return: 1
return: l2_d105_place_dynamic(source\method, source\place)

# How many declarations the translation records as reaching place k of method mi (l2_d105_close).
fn: l2_d105_place_sources (int: mi; int: k) int
    int: i 0
    int: n 0
    while: i < l2_d105s_n
        if: l2_d105s_mi[i] = mi && l2_d105s_k[i] = k
            n: n + 1
        i: i + 1
    ---
return: n

# POSSIBLE ANCHORS (TYPED-PLACE-LETTER-READMISSION; Codex, FABLE-CODEX-20261004-12, replies nineteen (b) and
# twenty-two, OPUS-HANDOFF-20261005-103112).  A value with no layout of its own -- a letter -- that the positional
# check admitted into a place of a declaration carries the record of that reception (lmx_implements_identity): the
# declaration's fields are where they are in the value.  Which declarations a value may carry such a record of is
# known to the translation only as a possibility: the declarations of the places it passes through.  An anchor is
# that possibility and nothing else -- no source, no layout, no admission; when the program runs the value's own
# records are asked.

# Room for one more anchor.
fn: l2_d105a_room () int
    int: want
    if: l2_d105a_n < l2_d105a_cap
        return: 0
    want: l2_cap_next(l2_d105a_cap, l2_d105a_n + 1)
    if: want < 0
        l2_alloc_err: 2
        return: 1
    if: l2_d105_ints(@ l2_d105a_mi, l2_d105a_n, want) != 0 || l2_d105_ints(@ l2_d105a_k, l2_d105a_n, want) != 0 || l2_d105_ints(@ l2_d105a_ty, l2_d105a_n, want) != 0
        return: 1
    l2_d105a_cap: want
return: 0

fn: l2_d105a_has (int: mi; int: k; int: ty) int
    int: i 0
    while: i < l2_d105a_n
        if: l2_d105a_mi[i] = mi && l2_d105a_k[i] = k && l2_d105a_ty[i] = ty
            return: 1
        i: i + 1
    ---
return: 0

# Declaration ty is an anchor of place k of method mi, once; *changed when it is new.  1 when there is no memory.
fn: l2_d105a_add (int: mi; int: k; int: ty; @: int changed) int
    if: mi < 0 || ty = -1 || l2_d105a_has(mi, k, ty) != 0
        return: 0
    if: l2_d105a_room() != 0
        return: 1
    l2_d105a_mi[l2_d105a_n]: mi
    l2_d105a_k[l2_d105a_n]: k
    l2_d105a_ty[l2_d105a_n]: ty
    l2_d105a_n: l2_d105a_n + 1
    \changed: 1
return: 0

# The declaration of place k of method mi, where the place has one of its own and it is a named Structure: an own
# reference's or field's, a formal's, a hidden input's lexical source's, a result's.  -1 otherwise, a hidden input
# nothing in its method's sight declares among them: the coordinate space of its paths declares no place.
fn: l2_place_declaration (int: mi; int: k) int
    int: s
    if: mi < 0 || mi >= l2_m_n
        return: -1
    if: k >= l2_m_arity[mi] && l2_input_undeclared(mi, k) != 0
        return: -1
    s: l2_input_schema(mi, k)
    if: l2_schema_kind(s) != 1
        return: -1
return: s

# ANCHOR EDGES.  A held value given to a Structure formal from a place of the caller is an edge of the way it
# came (l2_d105x_add), recorded where the checks see the site: the formal's admission asks for the identity entries
# of the places the value passed through.  Recorded apart from the edges of D-105 (l2_d105_edge): those carry
# layouts and their checks, and an anchor edge carries possibilities only.
fn: l2_d105x_room () int
    int: want
    if: l2_d105x_n < l2_d105x_cap
        return: 0
    want: l2_cap_next(l2_d105x_cap, l2_d105x_n + 1)
    if: want < 0
        l2_alloc_err: 2
        return: 1
    if: l2_d105_ints(@ l2_d105x_fmi, l2_d105x_n, want) != 0 || l2_d105_ints(@ l2_d105x_fk, l2_d105x_n, want) != 0
        return: 1
    if: l2_d105_ints(@ l2_d105x_tmi, l2_d105x_n, want) != 0 || l2_d105_ints(@ l2_d105x_tk, l2_d105x_n, want) != 0
        return: 1
    l2_d105x_cap: want
return: 0

# The anchor edge from place fk of fmi to input tk of tmi, once, where no edge of D-105 is that edge already.  1
# when there is no memory.
fn: l2_d105x_add (int: fmi; int: fk; int: tmi; int: tk) int
    if: fmi < 0 || tmi < 0 || l2_d105_edge_known(fmi, fk, tmi, tk) != 0
        return: 0
    if: l2_d105x_room() != 0
        return: 1
    l2_d105x_fmi[l2_d105x_n]: fmi
    l2_d105x_fk[l2_d105x_n]: fk
    l2_d105x_tmi[l2_d105x_n]: tmi
    l2_d105x_tk[l2_d105x_n]: tk
    l2_d105x_n: l2_d105x_n + 1
return: 0

# Along one edge, from place fk of fmi to place tk of tmi: the giving place's own declaration and every anchor of
# the giving place reach the place it hands to.  1 when there is no memory.
fn: l2_d105a_along (int: fmi; int: fk; int: tmi; int: tk; @: int changed) int
    int: i 0
    int: n l2_d105a_n
    if: fmi < 0 || tmi < 0
        return: 0
    if: l2_d105a_add(tmi, tk, l2_place_declaration(fmi, fk), changed) != 0
        return: 1
    while: i < n
        if: l2_d105a_mi[i] = fmi && l2_d105a_k[i] = fk && l2_d105a_add(tmi, tk, l2_d105a_ty[i], changed) != 0
            return: 1
        i: i + 1
    ---
return: 0

# The anchors over the edges every site recorded -- of D-105 (l2_d105_edge) and the anchor edges (l2_d105x_add) --
# to the fixed point.  An anchor joins a place once, so a cycle of methods ends; the tables grow with the program.
fn: l2_d105a_close () int
    int: changed 1
    int: e
    l2_d105a_n: 0
    while: changed != 0
        changed: 0
        e: 0
        while: e < l2_d105e_n
            if: l2_d105a_along(l2_d105e_fmi[e], l2_d105e_fk[e], l2_d105e_tmi[e], l2_d105e_tk[e], @ changed) != 0
                return: l2_alloc_or(l2_src, l2_d105e_at[e], "out of memory")
            e: e + 1
        ---
        e: 0
        while: e < l2_d105x_n
            if: l2_d105a_along(l2_d105x_fmi[e], l2_d105x_fk[e], l2_d105x_tmi[e], l2_d105x_tk[e], @ changed) != 0
                return: l2_alloc_or(l2_src, 0, "out of memory")
            e: e + 1
        ---
    ---
    l2_d105a_done: 1
return: 0

# Whether the checks recorded the edge from place fk of fmi to input tk of tmi: an edge of D-105 or an anchor edge.
fn: l2_d105_edge_known (int: fmi; int: fk; int: tmi; int: tk) int
    int: e 0
    while: e < l2_d105e_n
        if: l2_d105e_fmi[e] = fmi && l2_d105e_fk[e] = fk && l2_d105e_tmi[e] = tmi && l2_d105e_tk[e] = tk
            return: 1
        e: e + 1
    ---
    e: 0
    while: e < l2_d105x_n
        if: l2_d105x_fmi[e] = fmi && l2_d105x_fk[e] = fk && l2_d105x_tmi[e] = tmi && l2_d105x_tk[e] = tk
            return: 1
        e: e + 1
    ---
return: 0

# The index of the program's pair map cand -> req, or -1 when it is not among them.  Asks, adds nothing.
fn: l2_d105_pair_find (int: cand; int: req) int
    int: i 0
    while: i < l2_d105t_n
        if: l2_d105t_cand[i] = cand && l2_d105t_req[i] = req
            return: i
        i: i + 1
    ---
return: -1

# Room for one more row of identity entries.
fn: l2_ide_room () int
    int: want
    if: l2_ide_n < l2_ide_cap
        return: 0
    want: l2_cap_next(l2_ide_cap, l2_ide_n + 1)
    if: want < 0
        l2_alloc_err: 2
        return: 1
    if: l2_d105_ints(@ l2_ide_fmi, l2_ide_n, want) != 0 || l2_d105_ints(@ l2_ide_fk, l2_ide_n, want) != 0 || l2_d105_ints(@ l2_ide_tmi, l2_ide_n, want) != 0
        return: 1
    if: l2_d105_ints(@ l2_ide_tk, l2_ide_n, want) != 0 || l2_d105_ints(@ l2_ide_ty, l2_ide_n, want) != 0 || l2_d105_ints(@ l2_ide_cls, l2_ide_n, want) != 0
        return: 1
    l2_ide_cap: want
return: 0

fn: l2_ide_push (int: fmi; int: fk; int: tmi; int: tk; int: ty; int: cls) int
    if: l2_ide_room() != 0
        return: 1
    l2_ide_fmi[l2_ide_n]: fmi
    l2_ide_fk[l2_ide_n]: fk
    l2_ide_tmi[l2_ide_n]: tmi
    l2_ide_tk[l2_ide_n]: tk
    l2_ide_ty[l2_ide_n]: ty
    l2_ide_cls[l2_ide_n]: cls
    l2_ide_n: l2_ide_n + 1
return: 0

# The first step of each path the Consumer reads (the uses just collected, l2_uses_walk_frame) as an edge of req, of
# width w: field j through its ordinal half for an explicit `[N]name`, the LAST half (w + j) for a bare name.  A step
# req does not declare is no part of this Consumer.  Each edge once, into used (room for 2 * w), *n.
sub: l2_anchor_used (int: req; int: w; @: int used; @: int n)
    size_t: off 0U
    @: char slot
    size_t: len
    size_t: cut
    size_t: name_at
    int: occurrence
    int: j
    int: edge
    int: k
    LmP0Text: name
    \n: 0
    if: l2_uses_buf = 0
        return
    while: off < (cast: (size_t) l2_uses_len)
        slot: l2_uses_buf + off
        len: strlen(slot)
        cut: 0U
        while: cut < len && slot[cut] != 92
            cut: cut + 1U
        occurrence: -1
        name_at: 0U
        if: cut > 0U && slot[0] = 91
            occurrence: 0
            name_at: 1U
            while: name_at < cut && slot[name_at] >= 48 && slot[name_at] <= 57
                occurrence: occurrence * 10 + (cast: (int) (slot[name_at] - 48))
                name_at: name_at + 1U
            if: name_at >= cut || slot[name_at] != 93
                name_at: cut
            else:
                name_at: name_at + 1U
            ---
        ---
        if: name_at < cut
            name.data: slot + name_at
            name.length: cut - name_at
            j: l2_schema_named(req, @ name, occurrence, 0)
            if: j >= 0 && j < w
                edge: j
                if: occurrence < 0
                    edge: w + j
                k: 0
                while: k < \n && used[k] != edge
                    k: k + 1
                if: k = \n
                    used[\n]: edge
                    \n: \n + 1
                ---
            ---
        ---
        off: off + len + 1U
    ---
end: l2_anchor_used

# Whether declaration a is an identity entry where the Consumer whose uses were just collected reads a value admitted
# to req: a named declaration other than req whose correspondence to req the translation builds (l2_d105_table) and
# that gives every path the Consumer reads (l2_descriptor_used: the admission by the consumer's uses).  Its places for
# the Consumer's used first steps go to row.  1, 0, or -1 when there is no memory.  A declaration that is no entry
# condemns no value: it is only not offered.
fn: l2_anchor_offer (int: a; int: req; @: int used; int: used_n; @: int row) int
    int: ok 0
    int: tn 0
    int: u 0
    int: status
    @: int t
    if: a = -1 || a = req || l2_schema_kind(a) != 1
        return: 0
    if: l2_descriptor_used(a, req, @ ok) != 0 || ok = 0
        return: 0
    t: l2_d105_cells(req)
    if: t = 0
        return: -1
    status: l2_d105_table(a, req, t, l2_d105_tcap, @ tn, 1)
    if: status != 0
        return: 0
    while: u < used_n
        row[u]: -1
        if: used[u] < tn
            row[u]: t[used[u]]
        u: u + 1
    ---
return: 1

# The identity entries of the reception where a candidate with no layout of its own, read from place fk of fmi, is
# formed into input tk of tmi and admitted to req by the Consumer's uses (fullReceiver 0): the giving place's own
# declaration s first, then the anchors that reach the giving place, each offered by l2_anchor_offer.  Class 0 is s;
# the others share a class where they give every used first step the same place, so that entries of one class place
# what the Consumer reads alike.  Rows are added after a marker row of the key.
fn: l2_ide_compute (int: req; int: s; int: fmi; int: fk; int: tmi; int: tk; @: int first; @: int count) int
    int: w l2_d105_width(req)
    int: anchors 0
    int: i 0
    int: k
    int: j
    int: u
    int: a
    int: ok
    int: cls
    int: next_cls 1
    int: used_n 0
    int: others 0
    int: rc 0
    int: base
    int: lead
    size_t: isz
    @: int used 0
    @: int proj 0
    @: LmP0Text nm
    \first: 0
    \count: 0
    # Before the model's width is known -- when the walked frames are first counted -- there is nothing to compute
    # and nothing is kept: the entries are found once the width is there.
    if: w < 1
        return: 0
    if: l2_ide_push(fmi, fk, tmi, tk, -2, 0) != 0
        return: l2_alloc_or(l2_src, 0, "out of memory")
    base: l2_ide_n
    \first: base
    if: l2_m_node[tmi] = 0 || l2_m_node[tmi]\as = 0 || l2_m_node[tmi]\as\frame = 0
        return: 0
    nm: l2_input_name(tmi, tk)
    if: nm = 0
        return: 0
    while: i < l2_d105a_n
        if: l2_d105a_mi[i] = fmi && l2_d105a_k[i] = fk
            anchors: anchors + 1
        i: i + 1
    ---
    isz: c.sizeof(c.int)
    if: l2_mul_ok((cast: (size_t) w) * 2U, isz) = 0 || l2_mul_ok(((cast: (size_t) anchors) + 1U) * (cast: (size_t) w) * 2U, isz) = 0
        l2_alloc_err: 2
        return: l2_alloc_or(l2_src, 0, "out of memory")
    l2_alloc_kind: 5
    used: (cast: (@: int) l2_xmalloc((cast: (size_t) w) * 2U * isz))
    proj: (cast: (@: int) l2_xmalloc(((cast: (size_t) anchors) + 1U) * (cast: (size_t) w) * 2U * isz))
    if: used = 0 || proj = 0
        rc: l2_alloc_or(l2_src, 0, "out of memory")
    if: rc = 0
        l2_uses_reset()
        if: l2_uses_walk_frame(nm, l2_m_node[tmi]\as\frame) != 0 || l2_uses_oom != 0
            rc: l2_alloc_or(l2_src, l2_m_node[tmi], "out of memory")
        ---
    ---
    if: rc = 0
        l2_anchor_used(req, w, used, @ used_n)
        ok: l2_anchor_offer(s, req, used, used_n, proj)
        if: ok < 0
            rc: l2_alloc_or(l2_src, 0, "out of memory")
        if: ok > 0 && l2_ide_push(fmi, fk, tmi, tk, s, 0) != 0
            rc: l2_alloc_or(l2_src, 0, "out of memory")
        lead: l2_ide_n
    ---
    i: 0
    while: rc = 0 && i < l2_d105a_n
        a: l2_d105a_ty[i]
        if: l2_d105a_mi[i] = fmi && l2_d105a_k[i] = fk && a != s && a != req
            ok: l2_anchor_offer(a, req, used, used_n, proj + others * used_n)
            if: ok < 0
                rc: l2_alloc_or(l2_src, 0, "out of memory")
            if: ok > 0
                cls: 0
                k: 0
                while: cls = 0 && k < others
                    j: 1
                    u: 0
                    while: u < used_n
                        if: proj[k * used_n + u] != proj[others * used_n + u]
                            j: 0
                        u: u + 1
                    ---
                    if: j != 0
                        cls: l2_ide_cls[lead + k]
                    k: k + 1
                ---
                if: cls = 0
                    cls: next_cls
                    next_cls: next_cls + 1
                ---
                if: l2_ide_push(fmi, fk, tmi, tk, a, cls) != 0
                    rc: l2_alloc_or(l2_src, 0, "out of memory")
                others: others + 1
            ---
        ---
        i: i + 1
    ---
    l2_uses_reset()
    l2_xfree((cast: (@: void) used))
    l2_xfree((cast: (@: void) proj))
    \count: l2_ide_n - base
return: rc

# The identity entries of a reception (lmx_walk_admit_op, l2_emit_model_admit): rows first .. first + count - 1 of
# the identity entries, or none.  Only a candidate the translation has no layout for (l2_d105_dynamic), read from a
# place, formed into an input admitted by the Consumer's uses (fullReceiver 0), along an edge the checks recorded --
# so that the native text finds its pair maps among the program's (l2_d105_close) and the walked instruction and
# the native text offer the same entries.  Computed once per site; 1 when there is no memory.
fn: l2_identity_list (int: req; @: L2ReferenceSource source; int: tmi; int: tk; int: full_receiver; @: int first; @: int count) int
    int: r 0
    int: fmi
    int: fk
    \first: 0
    \count: 0
    if: full_receiver != 0 || req = -1 || source = 0 || source\method < 0 || tmi < 0 || tmi >= l2_m_n || tk < 0
        return: 0
    if: l2_d105_dynamic(source) = 0
        return: 0
    fmi: source\method
    fk: source\place
    if: l2_d105_edge_known(fmi, fk, tmi, tk) = 0 || l2_input_schema(tmi, tk) != req
        return: 0
    if: l2_d105a_done = 0 && l2_d105a_close() != 0
        return: 1
    while: r < l2_ide_n
        if: l2_ide_ty[r] = -2 && l2_ide_fmi[r] = fmi && l2_ide_fk[r] = fk && l2_ide_tmi[r] = tmi && l2_ide_tk[r] = tk
            \first: r + 1
            r: r + 1
            while: r < l2_ide_n && l2_ide_ty[r] != -2
                \count: \count + 1
                r: r + 1
            ---
            return: 0
        ---
        r: r + 1
    ---
return: l2_ide_compute(req, source\schema, fmi, fk, tmi, tk, first, count)

# The pair maps of the identity entries of the reception along the edge from place fk of fmi to input tk of tmi,
# reserved among the program's (l2_d105_close, before the maps are declared).  1 when there is no memory.
fn: l2_ide_reserve (int: fmi; int: fk; int: tmi; int: tk) int
    L2ReferenceSource: source
    int: req
    int: first 0
    int: count 0
    int: i
    if: fmi < 0 || tmi < 0 || tk < 0
        return: 0
    source.schema: l2_input_schema(fmi, fk)
    source.layout: -1
    source.method: fmi
    source.place: fk
    req: l2_input_schema(tmi, tk)
    if: l2_identity_list(req, @ source, tmi, tk, 0, @ first, @ count) != 0
        return: 1
    i: first
    while: i < first + count
        if: l2_d105_pair(l2_ide_ty[i], req) < 0
            return: l2_alloc_or(l2_src, 0, "out of memory")
        i: i + 1
    ---
return: 0

# Input j of method mi is a hidden input whose name nothing in mi's sight declares: it has no schema of its own,
# mi can only hand it on, and the declarations that reach it are the translation's record.
fn: l2_input_undeclared (int: mi; int: j) int
    if: mi < 0 || mi >= l2_m_n || mi = l2_e || j < l2_m_arity[mi] || j >= l2_m_arity[mi] + l2_m_dyn[mi]
        return: 0
return: (cast: (int) (l2_own_lexical(mi, l2_dn(mi, j - l2_m_arity[mi])) < 0))

# RECEPTION-EDGE-DEBTS (e): whether place `key` of mi is a reference of opaque type -- an own reference or a formal
# declared `@: void` -- which holds what was given to it.
fn: l2_d105_opaque_place (int: mi; int: key) int
    int: own l2_d105_key_own(key)
    if: own >= 0 && own < l2_own_n
        return: (cast: (int) (l2_own_schema(own) = -1 && l2_ft_of_own(l2_own_ty[own]) = 16))
    if: mi < 0 || mi >= l2_m_n || key < 0 || key >= l2_m_arity[mi]
        return: 0
return: (cast: (int) (l2_input_schema(mi, key) = -1 && l2_ft(mi, key) = 16))

# Explicit and hidden actuals share the reached admission of an already evaluated
# candidate. Compiler-known producer schema tokens select immutable pair maps;
# forwarded values retain genuine schema evidence in the existing implements
# table. Equal partial maps never identify a source schema. Current Consumer uses
# are checked independently of correspondence caching; ordinary reference and
# return reception require every field. Neither wrapper re-evaluates the value.
fn: l2_hidden_emit_admit (int: mi; int: idx; int: k; const: @(char value); const: @(char ind)) int
    int: req l2_input_schema(idx, l2_m_arity[idx] + k)
    int: source_input -1
    int: source_method -1
    int: at_mi -1
    int: cand
    if: req = -1
        return: 0
    cand: l2_hidden_model_source(mi, idx, k, @ source_input)
    # A value with no schema is admitted by position.  An input the method has no declaration of in sight has
    # no schema either, but the declarations that reach it are the translation's record (l2_d105_close): its
    # value is admitted by the one it carries, as a value of a known schema is.  Where the record has none the
    # value carries no layout to tell, and its admission is the positional one.
    # RECEPTION-EDGE-DEBTS (e): a place that holds what was given to it -- an opaque reference, an opaque formal --
    # has the declarations that reached it in the record too (l2_check_receiving_value): its value is admitted by
    # the one it carries, as the explicit analogue's is.
    if: cand = -1 && ((l2_input_undeclared(mi, source_input) = 0 && l2_d105_opaque_place(mi, source_input) = 0) || l2_d105_place_sources(mi, source_input) = 0)
        return: l2_emit_admit(mi, req, value, ind)
    if: source_input != -1
        source_method: l2_d105_key_method(mi, source_input)
        # The input is formed in mi: a dynamic candidate's refusal is mi's implicit `implements`.
        if: l2_d105_place_dynamic(mi, source_input) != 0
            at_mi: mi
    ---
return: l2_d105_emit_source(idx, l2_m_arity[idx] + k, cand, source_method, source_input, value, ind, at_mi)

# idx is the callee, whose input's schema the value is admitted to; at_mi the method that hands it, where the
# candidate is a dynamic one, or -1.
fn: l2_d105_emit_source (int: idx; int: k; int: cand; int: smi; int: sk; const: @(char value); const: @(char ind); int: at_mi) int
    L2ReferenceSource: source
    source.schema: cand
    source.layout: -1
    source.method: l2_d105_key_method(smi, sk)
    source.place: sk
    if: smi < 0
        source.layout: cand
return: l2_emit_model_admit(idx, l2_input_schema(idx, k), @ source, value, ind, 0, 0, -1, at_mi, idx, k)

# The candidate has already been evaluated once. Its physical layout is either
# direct producer evidence or a completed source admission, never its declared
# required type. Only the reached target admission may publish a new proof.
# mi is the context the receiving model is found in.  at_mi is the method whose activation executes the admission
# where the candidate is a dynamic one (l2_d105_dynamic), or -1: an input is formed in the calling method before
# the callee is entered, so a refusal there is that method's implicit `implements`, with its own result and
# status, its handlers and its publication -- as the walked instruction throws it (LMX_WALK_OP_ADMIT_AS).
# tmi/tk name the input the value is formed into where it is one -- a formal or a hidden input -- else -1.
fn: l2_emit_model_admit (int: mi; int: req; @: L2ReferenceSource source; const: @(char value); const: @(char ind); int: full_receiver; int: implicit_throw; int: uses_own; int: at_mi; int: tmi; int: tk) int
    int: i 0
    int: p
    int: r
    int: pi
    int: id_first 0
    int: id_n 0
    int: amb 0
    int: seq l2_d105_seq
    const: @(char receive) "lmx_implements_receiver_view"
    []: char cover 64
    []: char rinst_own 320
    L2Tx: rinst_tx
    @: L2Tx rinst l2_tx_local(@ rinst_tx, rinst_own, 320U)
    []: char sinst 128
    []: char origin 128
    []: char table 160
    if: req = -1 || l2_model_inst(mi, req, ind, rinst) != 0
        return: l2_error(l2_src, 0, "internal: admission without receiving model")
    l2_d105_seq: l2_d105_seq + 1
    strcpy(origin, "0")
    strcpy(sinst, "0")
    if: source\schema != -1 && l2_layout_token(source\schema, sinst) != 0
        return: 1
    if: source\layout != -1 && l2_layout_token(source\layout, origin) != 0
        return: 1
    if: c.fprintf(l2_out, "%s@: void l2_layout%d %s\n", ind, seq, origin) < 0
        return: 1
    if: source\layout = -1 && c.fprintf(l2_out, "%sl2_layout%d: lmx_implements_layout(l2_program_arena, (cast: (@: Lmx) %s))\n", ind, seq, value) < 0
        return: 1
    if: c.fprintf(l2_out, "%s@: size_t l2_d105t%d 0\n%sint: l2_layout_found%d 0\n", ind, seq, ind, seq) < 0
        return: 1
    if: source\schema != -1
        strcpy(table, "0")
        if: source\schema != req
            p: l2_d105_pair(source\schema, req)
            if: l2_d105_tnode(p, table) != 0
                return: 1
        ---
        if: c.fprintf(l2_out, "%sif: l2_layout%d = %s\n%s    l2_d105t%d: %s\n%s    l2_layout_found%d: 1\n", ind, seq, sinst, ind, seq, table, ind, seq) < 0
            return: 1
    ---
    while: i < l2_d105s_n
        # RECEPTION-EDGE-DEBTS (d): a candidate the input's Consumer refused has no alternative; its value meets no
        # record and no alternative, and the admission refuses it.
        if: source\method >= 0 && l2_d105s_mi[i] = source\method && l2_d105s_k[i] = source\place && l2_d105s_ty[i] != source\schema && l2_d105_refused(tmi, tk, l2_d105s_ty[i]) = 0
            if: l2_layout_token(l2_d105s_ty[i], origin) != 0
                return: 1
            strcpy(table, "0")
            if: l2_d105s_ty[i] != req && l2_d105_tnode(l2_d105_pair(l2_d105s_ty[i], req), table) != 0
                return: 1
            if: c.fprintf(l2_out, "%sif: l2_layout%d = %s\n%s    l2_d105t%d: %s\n%s    l2_layout_found%d: 1\n", ind, seq, origin, ind, seq, table, ind, seq) < 0
                return: 1
        ---
        i: i + 1
    ---
    # Identity entries (TYPED-PLACE-LETTER-READMISSION; lmx_walk_admit_op does the same for ADMIT_AS).  A candidate
    # with no layout of its own is asked, when the program runs, whether a completed reception proved it identical
    # by position with an entry's declaration (lmx_implements_identity); the entry's pair map then gives the model's
    # fields among that declaration's places.  The giving place's own declaration (class 0) decides when it answers.
    # Otherwise the first entry that answers is taken, and an entry of another class that answers too makes l2_idsel
    # 2: the reception is refused, and neither the order of the entries nor the positional check decides which
    # places the Consumer reads.  No layout is published for the value.
    if: l2_identity_list(req, source, tmi, tk, full_receiver, @ id_first, @ id_n) != 0
        return: 1
    r: id_first
    while: r < id_first + id_n
        pi: l2_d105_pair_find(l2_ide_ty[r], req)
        if: pi < 0
            return: l2_error(l2_src, 0, "internal: the pair map of an identity entry was not reserved")
        if: l2_d105_tnode(pi, table) != 0 || l2_layout_token(l2_ide_ty[r], origin) != 0
            return: 1
        if: l2_ide_cls[r] = 0 && c.fprintf(l2_out, "%sif: l2_layout%d = 0 && l2_layout_found%d = 0 && %s != 0 && lmx_implements_identity(l2_program_arena, (cast: (@: Lmx) %s), %s) != 0\n%s    l2_d105t%d: %s\n%s    l2_layout_found%d: 1\n", ind, seq, seq, value, value, origin, ind, seq, table, ind, seq) < 0
            return: 1
        if: l2_ide_cls[r] != 0
            if: amb = 0 && c.fprintf(l2_out, "%sint: l2_idsel%d 0\n%sint: l2_idcls%d 0\n", ind, seq, ind, seq) < 0
                return: 1
            amb: 1
            if: c.fprintf(l2_out, "%sif: l2_layout%d = 0 && l2_layout_found%d = 0 && %s != 0 && lmx_implements_identity(l2_program_arena, (cast: (@: Lmx) %s), %s) != 0\n%s    if: l2_idsel%d != 0 && l2_idcls%d != %d\n%s        l2_idsel%d: 2\n%s    if: l2_idsel%d = 0\n%s        l2_d105t%d: %s\n%s        l2_idcls%d: %d\n%s        l2_idsel%d: 1\n%s    ---\n", ind, seq, seq, value, value, origin, ind, seq, seq, l2_ide_cls[r], ind, seq, ind, seq, ind, seq, table, ind, seq, l2_ide_cls[r], ind, seq, ind) < 0
                return: 1
        ---
        r: r + 1
    ---
    if: amb != 0 && c.fprintf(l2_out, "%sif: l2_layout_found%d = 0 && l2_idsel%d = 1\n%s    l2_layout_found%d: 1\n", ind, seq, seq, ind, seq) < 0
        return: 1
    # The instruction carries the coverage of the place it receives into when
    # that coverage is known: the reception then asks for the fields it names.
    # Unknown coverage stays the full reception.
    cover[0]: 0
    if: full_receiver != 0 && uses_own >= 0 && l2_ruse_of(uses_own) = 2
        if: l2_ruse_emit_native(uses_own, seq, ind) != 0
            return: 1
        receive: "lmx_implements_receiving_use"
        c.sprintf(cover, ", @ l2_rusev%d", seq)
    ---
    if: amb = 0 && c.fprintf(l2_out, "%sint: l2_admission%d c.LMX_IMPLEMENTS_YES\n%sif: %s != 0\n%s    if: l2_layout_found%d != 0\n", ind, seq, ind, value, ind, seq) < 0
        return: 1
    if: amb != 0 && c.fprintf(l2_out, "%sint: l2_admission%d c.LMX_IMPLEMENTS_YES\n%sif: l2_idsel%d = 2\n%s    l2_admission%d: c.LMX_IMPLEMENTS_UNKNOWN\n%sif: %s != 0 && l2_idsel%d != 2\n%s    if: l2_layout_found%d != 0\n", ind, seq, ind, seq, ind, seq, ind, value, seq, ind, seq) < 0
        return: 1
    if: full_receiver != 0
        if: c.fprintf(l2_out, "%s        LmxImplEntry: l2_pending%d\n%s        l2_pending%d.frame: 0\n%s        l2_pending%d.at: 0U\n%s        l2_pending%d.holes: 0\n%s        l2_pending%d.value: (cast: (@: Lmx) %s)\n%s        l2_pending%d.req: %s\n%s        l2_pending%d.map: l2_d105t%d\n%s        l2_pending%d.n: %dU\n%s        l2_pending%d.layout: l2_layout%d\n%s        l2_admission%d: %s(l2_program_arena, (cast: (@: Lmx) %s), %s, %s, @ l2_pending%d%s)\n", ind, seq, ind, seq, ind, seq, ind, seq, ind, seq, value, ind, seq, rinst\data, ind, seq, seq, ind, seq, l2_d105_width(req), ind, seq, seq, ind, seq, receive, value, rinst\data, rinst\data, seq, cover) < 0
            return: 1
    ---
    if: c.fprintf(l2_out, "%s        if: l2_admission%d = c.LMX_IMPLEMENTS_YES\n%s            l2_admission%d: lmx_implements_register_map(l2_program_arena, (cast: (@: Lmx) %s), %s, l2_d105t%d, %dU, l2_layout%d)\n%s        ---\n%s    else:\n%s        @: LmxImplEntry l2_known%d lmx_implements_find(l2_program_arena, (cast: (@: Lmx) %s), %s)\n", ind, seq, ind, seq, value, rinst\data, seq, l2_d105_width(req), seq, ind, ind, ind, seq, value, rinst\data) < 0
        return: 1
    if: c.fprintf(l2_out, "%s        if: l2_known%d = 0 && l2_layout%d != 0\n%s            l2_admission%d: c.LMX_IMPLEMENTS_UNKNOWN\n%s        if: l2_known%d = 0 && l2_layout%d = 0\n%s            l2_admission%d: lmx_implements_receiver_view(l2_program_arena, (cast: (@: Lmx) %s), %s, %s, 0)\n", ind, seq, seq, ind, seq, ind, seq, seq, ind, seq, value, rinst\data, rinst\data) < 0
        return: 1
    if: c.fprintf(l2_out, "%s            if: l2_admission%d = c.LMX_IMPLEMENTS_YES\n%s                l2_admission%d: lmx_implements_register_map(l2_program_arena, (cast: (@: Lmx) %s), %s, 0, 0U, 0)\n%s        ---\n", ind, seq, ind, seq, value, rinst\data, ind) < 0
        return: 1
    if: c.fprintf(l2_out, "%s        if: l2_known%d != 0\n%s            l2_admission%d: %s(l2_program_arena, (cast: (@: Lmx) %s), %s, %s, 0%s)\n%s            if: l2_admission%d = c.LMX_IMPLEMENTS_YES\n%s                LmxImplEntry: l2_known_view%d (\\l2_known%d)\n%s                l2_known_view%d.layout: l2_layout%d\n%s                l2_admission%d: lmx_implements_register(l2_program_arena, (cast: (@: Lmx) %s), %s, @ l2_known_view%d)\n%s---\n", ind, seq, ind, seq, receive, value, rinst\data, rinst\data, cover, ind, seq, ind, seq, seq, ind, seq, seq, ind, seq, value, rinst\data, seq, ind) < 0
        return: 1
    if: c.fprintf(l2_out, "%sif: l2_admission%d != c.LMX_IMPLEMENTS_YES\n", ind, seq) < 0
        return: 1
    if: implicit_throw != 0
        return: l2_emit_implicit_throw(mi, "implements", ind)
    if: at_mi >= 0
        if: l2_m_throws = 0 || l2_m_throws[at_mi] = 0
            return: l2_error(l2_src, 0, "internal: the admission of a dynamic candidate was not checked")
        return: l2_emit_implicit_throw(at_mi, "implements", ind)
    ---
    # DUPLICATE-STOP: here the candidate is static and its admission proved by the translation -- a refusal is no
    # outcome.  What can still fail is the record the reads by name need: a broken invariant, or the arena's table
    # of records that cannot grow.  That is said as such.
    if: c.fprintf(l2_out, "%s    c.fprintf(c.stderr, \"lmx: invariant: the record of a proved admission was not kept\\n\")\n%s    c.abort()\n", ind, ind) < 0
        return: 1
return: 0

# D-105 native: the first field of formal fi of mi, admitted by name, is at the slot its value's record
# gives -- into l2_dslot.  No record, or a hole, is a guard: every call site into the formal records its
# value (l2_d105_emit_admit, and the walked root's ADMIT_AS), and the translator emits no read
# of a field a source does not carry -- the formal's uses are checked for every source (l2_d105_close).
# The edge read: `last` selects bare `name` (the map's second half, the value's LAST
# occurrence of it); otherwise the ordinal half -- the slot this use already resolved
# on the required model (K01).
fn: l2_d105_emit_slot (int: mi; int: fi; int: slot; int: last; const: @(char ind)) int
    []: char rinst_own 320
    L2Tx: rinst_tx
    @: L2Tx rinst l2_tx_local(@ rinst_tx, rinst_own, 320U)
    int: edge slot
    if: l2_model_inst(mi, l2_input_schema(mi, fi), ind, rinst) != 0
        return: l2_error(l2_src, 0, "internal: a formal admitted by name has no shape")
    if: last != 0
        edge: slot + l2_d105_width(l2_input_schema(mi, fi))
    if: c.fprintf(l2_out, "%sif: lmx_implements_slot(l2_program_arena, l2_pst, %s, %uU, @ l2_dslot) != 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: a field of a formal admitted by name is not carried by its value (no record, or a hole)\\n\")\n%s    c.abort()\n", ind, rinst\data, (cast: (unsigned) edge), ind, ind) < 0
        return: 1
return: 0

# D-105 native: the builder fills the program's pair maps -- the ORDINAL half then the
# LAST half per required field (K01), "not carried" (SIZE_MAX) where the source has none
# or where req's child is no field (a procedure's bodies and steps, R9).
fn: l2_d105_emit_tables () int
    int: p 0
    int: j
    int: n 0
    int: w
    int: cells
    @: int t 0
    while: p < l2_d105t_n
        t: l2_d105_cells(l2_d105t_req[p])
        if: t = 0
            return: l2_alloc_or(l2_src, 0, "out of memory")
        if: l2_d105_table(l2_d105t_cand[p], l2_d105t_req[p], t, l2_d105_tcap, @ n, 1) != 0
            return: l2_error(l2_src, 0, "internal: a pair table of D-105 could not be built")
        w: l2_d105_width(l2_d105t_req[p])
        cells: w * 2
        j: 0
        while: j < cells
            if: j < n && t[j] >= 0 && c.fprintf(l2_out, "        l2_d105m%d[%d]: %dU\n", p, j, t[j]) < 0
                return: 1
            if: (j >= n || t[j] < 0) && c.fprintf(l2_out, "        l2_d105m%d[%d]: (cast: (size_t) -1)\n", p, j) < 0
                return: 1
            j: j + 1
        ---
        p: p + 1
    ---
return: 0

# D-105 slice 1: how input k of callee idx, whose actual is of named type cand (-1: not a named
# root field -- a letter, a fresh empty Structure), is admitted: \out 0 as before, 1 as the formal's
# own type through the walker's ADMIT_AS (the formal is one a root call site fills with another type),
# 2 by name through the correspondence table.  Another type is admitted at the walked root only,
# into a walked callee (--walk-methods): a native callee reads the formal's type's slots -- the
# native slice of D-105 -- and a method's walk is refused and stays native, as it did.
fn: l2_rw_d105_need (const: @(LmP0Node node); int: idx; int: k; int: cand; @: int out) int
    \out: 0
    if: l2_input_schema(idx, k) != -1
        \out: 1
return: 0

# Every ADMIT_AS uses the same flat instruction layout (lmx_walk.h).
fn: l2_rw_admit_as (int: parent; int: ni; int: cand; @: int out) int
    L2ReferenceSource: source
    source.schema: cand
    source.layout: -1
    source.method: -1
    source.place: -1
return: l2_rw_admit_project(parent, ni, @ source, 0, -1, -1, -1, out)

# D105 map constants are ordinary instruction operands with the same lifetime
# as the admitting frame. They are never executable source-level values.  The
# frame carries the pair map's 2*width cells: the ordinal half then the last
# half (K01); an identity admission writes the same slot on both halves.
fn: l2_rw_map_inline (int: frame; int: at; int: cand; int: req) int
    @: int slots 0
    int: n 0
    int: width l2_d105_width(req)
    int: j 0
    int: slot
    int: status 0
    # COUNT retains ADMIT's frame extent but cannot project unfinished source
    # places. PLACE still resolves/checks the actual map even without emission.
    if: l2_construct_phase = 0
        return: 0
    if: cand != req
        slots: l2_d105_cells(req)
        if: slots = 0
            return: l2_alloc_or(l2_src, l2_here_node, "out of memory")
        status: l2_d105_table(cand, req, slots, l2_d105_tcap, @ n, 1)
    ---
    if: status = 2
        return: l2_rw_refuse(l2_here_node, "an admission to a Structure type through a Structure field of another type")
    if: status != 0
        return: l2_error(l2_src, l2_here_node, "internal: an admission map has no completed physical schema")
    while: j < width
        slot: -1
        if: j < n
            slot: slots[j]
        if: cand = req
            slot: j
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, (cast: (size_t) %d)) != c.LMX_WALK_OK\n            return: 1\n", frame, at + j, slot) < 0
            return: 1
        slot: -1
        if: width + j < n
            slot: slots[width + j]
        if: cand = req
            slot: j
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, (cast: (size_t) %d)) != c.LMX_WALK_OK\n            return: 1\n", frame, at + width + j, slot) < 0
            return: 1
        j: j + 1
    ---
return: 0

# Whether input tk reads its unit-level requirement in the selected occurrence's
# lexical unit: declared Structure formals and admitted free inputs share the
# same receiving contract, regardless of the number of physical parent links.
fn: l2_rw_recv_req (int: tmi; int: tk; int: req) int
    if: tmi < 0 || tmi >= l2_m_n || tk < 0 || tk >= l2_m_arity[tmi] + l2_m_dyn[tmi]
        return: 0
    if: req < 0 || req >= l2_ns_n || l2_schema_kind(req) != 1 || l2_ns_local[req] >= 0
        return: 0
    if: tk < l2_m_arity[tmi]
        return: (cast: (int) (l2_nsty_get(tmi, tk) >= 0))
return: l2_free_admit(tmi, tk - l2_m_arity[tmi])

# The requirement of a RECEIVING admission uses the same model operand.
fn: l2_rw_recv_model (int: admit; int: req; int: callee) int
return: l2_rw_ns_model(admit, 4, req, callee)

# A declared model operand projects the completed source-owned child from
# the selected root. No descriptor is built to stand in for that declaration.
# Root selection retains the existing receiving/local/unit policies; every
# descendant uses the same ordinary OF operation and the committed slot.
fn: l2_rw_ns_model (int: parent; int: slot; int: req; int: callee) int
    int: frame
    int: own
    int: child
    if: req < 0 || req >= l2_ns_n
        return: 1
    if: l2_ns_parent[req] >= 0
        child: l2_ns_field_in_parent(req)
        if: l2_rw_emit != 0 && child < 0
            return: l2_error(l2_src, l2_ns_at[req], "internal: a nested model has no completed source place")
        if: l2_rw_frame(parent, "LMX_WALK_OP_OF", 3, @ frame) != 0 || l2_rw_ns_model(frame, 1, l2_ns_parent[req], callee) != 0
            return: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %dU) != c.LMX_WALK_OK\n            return: 1\n", frame, child) < 0
            return: 1
        return: l2_rw_put(parent, slot, frame)
    ---
    if: l2_ns_local[req] >= 0
        own: l2_own_of_local_ns(l2_rw_mi, req)
        if: own < 0
            return: l2_rw_refuse(l2_here_node, "an unresolved local admission model")
        return: l2_rw_model_own(parent, slot, own)
    ---
    if: callee >= 0
        # COUNT chooses topology from source ownership; FILL uses committed
        # physical ancestry, including local source-container places.
        int: of
        int: nd
        int: depth l2_lex_depth_at(callee, l2_e, 0)
        int: width 2
        int: unit_slot l2_ns_unit_slot(req)
        if: l2_ns_eternal[req] >= 0
            unit_slot: l2_ebr_unit_slot(l2_ns_eternal[req])
        if: depth = 1
            width: 1
        if: l2_rw_emit != 0
            depth: l2_lex_depth(callee, l2_e)
            if: depth < 0
                return: l2_error(l2_method_src(callee, l2_src), l2_m_node[callee], "a receiving model has no constructed lexical unit")
            ---
        ---
        if: l2_rw_frame(parent, "LMX_WALK_OP_OF", 3, @ of) != 0 || l2_rw_frame(of, "LMX_WALK_OP_NODE", width, @ nd) != 0 || l2_rw_put(of, 1, nd) != 0
            return: 1
        if: width = 2 && l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 1U, %dU) != c.LMX_WALK_OK\n            return: 1\n", nd, depth) < 0
            return: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %dU) != c.LMX_WALK_OK\n            return: 1\n", of, unit_slot) < 0
            return: 1
        return: l2_rw_put(parent, slot, of)
    ---
return: (cast: (int) (l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, %dU, (cast: (@: void) %s[%d])) != 0\n            return: 1\n", parent, slot, l2_rw_types_nsp(), req) < 0))

# tmi/tk name the input the value is formed into.
fn: l2_rw_admit_source (int: parent; int: req; int: cand; int: source_mi; int: source_input; int: tmi; int: tk; @: int out) int
    L2ReferenceSource: source
    source.schema: cand
    source.layout: -1
    source.method: l2_d105_key_method(source_mi, source_input)
    source.place: source_input
    if: source_mi < 0
        source.layout: cand
return: l2_rw_admit_project(parent, req, @ source, 0, -1, tmi, tk, out)

# `uses_own` is the own row the instruction receives into, or -1.  When its
# coverage is known the instruction carries it in its own cells (fullReceiver 2,
# lmx_walk.h) between the fixed nine and the maps.
# tmi/tk name the input the value is formed into where it is one -- a formal or a hidden input -- else -1.
fn: l2_rw_admit_project (int: parent; int: req; @: L2ReferenceSource source; int: full_receiver; int: uses_own; int: tmi; int: tk; @: int out) int
    int: i 0
    int: r
    int: id_first 0
    int: id_n 0
    int: count 0
    int: cover 0
    int: mode full_receiver
    int: whole 0
    int: cell 0
    int: width l2_d105_width(req)
    int: default_n 0
    int: nc 0
    int: extent
    int: slot 9
    if: req = -1
        return: l2_rw_refuse(l2_here_node, "an unresolved admission model")
    if: source\schema != -1 && source\schema != req
        # An explicit pair map: two cells per required field -- the ordinal half and
        # the last half (K01).  The entry's registered width stays `width`; only the
        # physical cell count doubles, so the walker's `default_n` is read as cells.
        default_n: width * 2
    while: i < l2_d105s_n
        if: source\method >= 0 && l2_d105s_mi[i] = source\method && l2_d105s_k[i] = source\place && l2_d105s_ty[i] != source\schema && l2_d105_refused(tmi, tk, l2_d105s_ty[i]) = 0
            count: count + 1
        i: i + 1
    ---
    if: full_receiver != 0 && uses_own >= 0 && l2_ruse_of(uses_own) = 2
        cover: l2_ruse_cells(uses_own)
        mode: 2
    ---
    # The identity entries of this reception (l2_identity_list), after the alternatives: (token, class, map) each.
    if: l2_identity_list(req, source, tmi, tk, full_receiver, @ id_first, @ id_n) != 0
        return: 1
    extent: 9 + cover + default_n + count * (1 + width * 2) + id_n * (2 + width * 2)
    if: l2_rw_catch_fixed(-1, 0, 2, "implements", @ nc) != 0 || l2_rw_frame(parent, "LMX_WALK_OP_ADMIT_AS", extent + 3 * nc, out) != 0
        return: 1
    i: 0
    while: i < cover
        if: l2_ruse_cell(uses_own, i, @ whole, @ cell) != 0
            return: l2_error(l2_src, 0, "internal: a coverage cell has no place")
        if: l2_rw_emit != 0 && whole != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, (cast: (size_t) -1)) != c.LMX_WALK_OK\n            return: 1\n", \out, 9 + i) < 0
            return: 1
        if: l2_rw_emit != 0 && whole = 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %dU) != c.LMX_WALK_OK\n            return: 1\n", \out, 9 + i, cell) < 0
            return: 1
        i: i + 1
    ---
    slot: 9 + cover
    if: l2_rw_emit != 0 && source\schema != -1 && c.fprintf(l2_out, "        if: lmx_walk_store_charptr(l2_program_arena, l2_rw%d, 1U, l2_layout_tokens + %d) != c.LMX_WALK_OK\n            return: 1\n", \out, l2_schema_token_slot(source\schema)) < 0
        return: 1
    if: l2_rw_emit != 0 && source\layout != -1 && c.fprintf(l2_out, "        if: lmx_walk_store_charptr(l2_program_arena, l2_rw%d, 7U, l2_layout_tokens + %d) != c.LMX_WALK_OK\n            return: 1\n", \out, l2_schema_token_slot(source\layout)) < 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 8U, %dU) != c.LMX_WALK_OK\n            return: 1\n", \out, mode) < 0
        return: 1
    # The required instance uses the common declared-model projection.
    if: l2_schema_kind(req) = 1
        if: l2_rw_recv_req(tmi, tk, req) != 0
            if: l2_rw_recv_model(\out, req, tmi) != 0 || l2_rw_source_facet(\out, "LMX_WALK_SOURCE_RECEIVING") != 0
                return: 1
            ---
        else:
            if: l2_rw_ns_model(\out, 4, req, -1) != 0
                return: 1
            ---
        ---
    ---
    if: l2_schema_kind(req) = 2 && l2_rw_model_own(\out, 4, l2_mres_own[l2_schema_index(req)]) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 5U, %dU) != c.LMX_WALK_OK || lmx_walk_store_size(l2_program_arena, l2_rw%d, 6U, %dU) != c.LMX_WALK_OK\n            return: 1\n", \out, count, \out, default_n) < 0
        return: 1
    if: default_n != 0 && l2_rw_map_inline(\out, slot, source\schema, req) != 0
        return: 1
    slot: slot + default_n
    i: 0
    while: i < l2_d105s_n
        if: source\method >= 0 && l2_d105s_mi[i] = source\method && l2_d105s_k[i] = source\place && l2_d105s_ty[i] != source\schema && l2_d105_refused(tmi, tk, l2_d105s_ty[i]) = 0
            if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_charptr(l2_program_arena, l2_rw%d, %dU, l2_layout_tokens + %d) != c.LMX_WALK_OK\n            return: 1\n", \out, slot, l2_schema_token_slot(l2_d105s_ty[i])) < 0
                return: 1
            if: l2_rw_map_inline(\out, slot + 1, l2_d105s_ty[i], req) != 0
                return: 1
            slot: slot + 1 + width * 2
        i: i + 1
    ---
    r: id_first
    while: r < id_first + id_n
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_charptr(l2_program_arena, l2_rw%d, %dU, l2_layout_tokens + %d) != c.LMX_WALK_OK || lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %dU) != c.LMX_WALK_OK\n            return: 1\n", \out, slot, l2_schema_token_slot(l2_ide_ty[r]), \out, slot + 1, l2_ide_cls[r]) < 0
            return: 1
        if: l2_rw_map_inline(\out, slot + 2, l2_ide_ty[r], req) != 0
            return: 1
        slot: slot + 2 + width * 2
        r: r + 1
    ---
return: l2_rw_catch_fixed(\out, extent, 2, "implements", @ nc)

# An admission at the walked root (FABLE-OPUS-ROOT-STRUCTS-20260925-178 commit 3; the 2026-09-23
# rule B2: binding an untyped graph to a typed place admits it at the binding point, and a refusal
# is the implicit throw `implements`).  One registered kernel primitive (Grok -180):
#   PRIM [prim, record, value, model]
# - record: fn lmx_walk_admit, or lmx_walk_admit_letter when the value is a letter, whose payload
#   (slot 1) is what the user's model describes (the mail design); owner the program's arena.
# - value: a node the caller builds next, into slot 2: a take, or AT of a reference field.  A null
#   value passes unadmitted, as natively (l2_emit_admit: `value != 0 && ...`).
# - model: the named Structure T itself (l2_nsp).
# Its out is the admitted value (what a letter gives is q25's answer).  A refusal is
# LMX_PRIMITIVE_THROW_IMPLEMENTS, which the walk carries as the caller's implicit throw
# (-177 c5: THROWN + 2 at the root).
fn: l2_rw_admit (int: parent; int: ni; int: letter; int: source_ty; @: int out) int
    const: @(char rec) "lmx_walk_admit"
    int: nc 0
    int: contract
    int: inputs
    if: l2_schema_kind(ni) != 1
        return: 1
    if: letter != 0
        rec: "lmx_walk_admit_letter"
    ---
    # D1: a catch row is the PRIM's last operands -- counted first, for its width.
    if: l2_rw_catch_fixed(0 - 1, 0, 2, "implements", @ nc) != 0 || l2_rw_frame(parent, "LMX_WALK_OP_PRIM", 5 + 3 * nc, out) != 0 || l2_use_unit_child(7, ni) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        @: LmxPrimitive l2_rwp%d (cast: (@: LmxPrimitive) lmx_arena_take(l2_program_arena, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))\n        if: l2_rwp%d = 0\n            return: 1\n        l2_rwp%d\\fn: %s\n        l2_rwp%d\\signature: 0\n        l2_rwp%d\\owner: (cast: (@: Lmx) l2_program_arena)\n        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_rwp%d)) != 0\n            return: 1\n", \out, \out, \out, rec, \out, \out, \out, \out) < 0
        return: 1
    if: l2_rw_ns_model(\out, 4, ni, -1) != 0
        return: 1
    if: l2_rw_contract(\out, 2, l2_graph_own(), 0, @ contract, @ inputs) != 0 || l2_rw_witness(inputs, 0, source_ty, 0) != 0 || l2_rw_witness(inputs, 1, 0, 1) != 0 || l2_rw_primitive_contract(\out, contract) != 0
        return: 1
return: l2_rw_catch_fixed(\out, 5, 2, "implements", @ nc)

# The named Structure T of the walked root's typed reference `@: T r` (l2_ref_formal_ns), its name into out_name -- or
# -1 for any other statement, and in any other body: a method's `@: T r` is its local (D-76).
fn: l2_root_ref_ns (int: mi; const: @(LmP0Node stmt); @@: LmP0Text out_name) int
    int: ni
    @: L2Declaration application
    if: out_name != 0
        \out_name: 0
    if: mi < 0 || mi != l2_e || l2_library_mode != 0 || stmt = 0
        return: 0 - 1
    ni: l2_declaration_model(stmt, 0)
    if: ni < 0
        return: 0 - 1
    application: l2_declaration(stmt)
    if: application = 0
        return: 0 - 1
    if: out_name != 0
        \out_name: application\name
return: ni

# The root's own field that `@: T r` at stmt declares (l2_root_ref_ns), or -1.
fn: l2_root_ref_row (const: @(LmP0Node stmt)) int
    int: oi 0
    if: stmt = 0 || l2_e < 0
        return: 0 - 1
    while: oi < l2_own_n
        if: l2_own_decl[oi] = stmt && l2_own_mi[oi] = l2_e
            return: oi
        oi: oi + 1
    ---
return: 0 - 1

# The already-collected pointer-value cell declared by this source act. The
# receiving model, if any, remains independent of the closed pointer type.
fn: l2_own_ref_decl (const: @(LmP0Node stmt); int: mi) int
    int: oi 0
    # The receiver of a factory's result, `@: h f(a)`, has its row from the store (l2_mad_store_stmt): its value
    # is the call's, not a declaration's candidate.
    if: stmt = 0 || l2_mad_store_stmt(stmt) != 0
        return: 0 - 1
    while: oi < l2_own_n
        if: l2_own_decl[oi] = stmt && l2_own_mi[oi] = mi && l2_own_is_pointer(l2_own_ty[oi]) != 0 && l2_own_is_slot(oi) = 0
            return: oi
        oi: oi + 1
    ---
return: 0 - 1

# A reference receiving operand uses the existing value nodes. A null literal
# has its declared pointer-cell type; numeric zero expressions elsewhere keep
# their numeric representation. No source binding or companion graph is made.
fn: l2_rw_reference_value (@: LmP0Field first; int: n; int: ty; int: parent; @: int out) int
    L2Address: descriptor_value
    @: L2Address descriptor @ descriptor_value
    int: is_descriptor
    int: source_ty
    int: neg 0
    int: uns 0
    size_t: mag 1U
    int: slot
    []: char cell_type 128
    l2_reference_fields(@ first, @ n)
    if: n = 1 && first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && first\value\as != 0
        if: l2_rw_num_lit(first\value\as\atom, @ neg, @ mag, @ uns) != 0 && mag = 0U
            n: 0
    ---
    if: n = 0
        # The null literal is a pointer cell of the place's value type (l2_value_ft_of_own): a pointer's held formal
        # type, an Array's descriptor reference.
        if: l2_ptr_cell_type(l2_value_ft_of_own(ty), cell_type) != 0 || l2_rw_frame(parent, "LMX_WALK_OP_LIT", 2, out) != 0
            return: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, lmx_pointer_new_owned(%s, l2_program_arena)) != 0\n            return: 1\n", \out, cell_type) < 0
            return: 1
        return: 0
    is_descriptor: l2_reference_descriptor(first, n, l2_rw_mi, descriptor)
    if: is_descriptor != 0 && l2_address_operand(first, n, l2_rw_mi, descriptor) = 0 && descriptor\descriptor != 0
        is_descriptor: 0
    if: is_descriptor = 0
        if: descriptor\kind = 1
            return: l2_rw_own(parent, descriptor\index, out)
        if: descriptor\kind = 2
            return: l2_rw_arg_fb(parent, descriptor\index, out)
        if: descriptor\kind = 5
            slot: l2_ns_unit_slot(descriptor\index)
            if: l2_ns_eternal[descriptor\index] >= 0
                slot: l2_ebr_unit_slot(l2_ns_eternal[descriptor\index])
            if: l2_rw_frame(parent, "LMX_WALK_OP_AT", 3, out) != 0 || l2_use_unit_child(3, descriptor\index) != 0
                return: 1
            if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_entry_unit)) != 0 || lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %dU) != c.LMX_WALK_OK\n            return: 1\n", \out, \out, slot) < 0
                return: 1
            return: 0
        return: l2_rw_refuse(first\value, "this reference operand")
    # The receiving checker already closed the object-pointer conversion.
    # Keep the candidate's actual return-cell type until structural admission;
    # ADMIT produces the same held reference, not a numeric conversion.
    source_ty: l2_rw_fields_ty(first, n)
    if: l2_own_is_pointer(source_ty) != 0
        ty: source_ty
return: l2_rw_texpr(first, n, ty, parent, out)

# Declarations and later assignments share the same admitted value/store chain.
# The existing write helper selects working SET/SET_OF or physical PUT.
fn: l2_rw_reference_receive (@: LmP0Field first; int: n; int: ty; int: model; int: parent; @: int out) int
return: l2_rw_reference_receive_at(first, n, ty, model, parent, -1, out)

# The same, received into own row `place` (-1: no such place).
fn: l2_rw_reference_receive_at (@: LmP0Field first; int: n; int: ty; int: model; int: parent; int: place; @: int out) int
    int: raw
    L2ReferenceSource: source
    int: source_ty l2_rw_fields_ty(first, n)
    if: l2_own_is_pointer(ty) = 0
        return: l2_rw_texpr(first, n, ty, parent, out)
    if: model < 0
        return: l2_rw_reference_value(first, n, ty, parent, out)
    if: l2_own_is_pointer(source_ty) = 0
        source_ty: ty
    l2_reference_source(first, n, l2_rw_mi, @ source)
    if: l2_is_letter_value(l2_rw_mi, first, n) != 0
        if: l2_rw_admit(parent, model, 1, source_ty, out) != 0
            return: 1
        ---
    else:
        if: l2_rw_admit_project(parent, model, @ source, 1, place, -1, -1, out) != 0
            return: 1
        ---
    ---
    if: l2_rw_reference_value(first, n, ty, \out, @ raw) != 0
        return: 1
return: l2_rw_put(\out, 3, raw)

fn: l2_rw_reference_store (@: LmP0Field first; int: n; int: oi; int: into; @: int out) int
    int: adm
    int: vs
    if: l2_rw_write(into, oi, l2_rw_bind_op(oi), out, @ vs) != 0
        return: 1
    if: l2_rw_reference_receive_at(first, n, l2_own_ty[oi], l2_own_nsty_get(oi), \out, oi, @ adm) != 0
        return: 1
return: l2_rw_put(\out, vs, adm)

# Is the root own field oi a letter -- declared by `receiveMessage: oi`?
fn: l2_rw_is_letter (int: oi) int
    @: LmP0Text name 0
    if: oi < 0 || l2_own_decl[oi] = 0
        return: 0
return: (cast: (int) (l2_receive_msg_shape(l2_own_decl[oi], @ name, 0) = 0))

# `receiveMessage: m` at the walked root (FABLE-OPUS-ROOT-TAKE-20260925-179; Grok -177 c1): the
# current Thread's next letter, taken by the walker's one kernel take primitive (a PRIM
# [prim, record] whose record's fn is lmx_walk_mail_take: the letter's graph through `out`, or no
# value when the inbox is empty), stored by reference into m's pointer cell -- null for no letter
# (a PUT into a pointer cell admits it).  m of a declared Structure type admits the letter first:
# that is an admission (the caller's implicit `implements`, D-55), not this take.
fn: l2_rw_take (const: @(LmP0Node stmt); int: into; @: int out) int
    L2Address: receiver_place
    @: LmP0Text cname 0
    @: LmP0Text cmodel 0
    int: oi
    int: prim
    int: ni
    int: adm
    int: holder
    int: slotv 3
    int: contract
    int: inputs
    if: l2_receive_msg_shape(stmt, @ cname, @ cmodel) != 0 || cname = 0
        return: l2_rw_refuse(stmt, "this receiveMessage")
    if: l2_receiver_output_place(stmt, l2_rw_mi, @ receiver_place) != 0
        return: l2_rw_refuse(stmt, "an unresolved receiver output place")
    oi: receiver_place.index
    if: l2_rw_seen(oi) = 0
        return: l2_rw_refuse(stmt, "this receiveMessage")
    if: l2_own_is_pointer(l2_own_ty[oi]) = 0
        return: l2_rw_refuse(stmt, "this receiveMessage")
    # §7b: the letter goes to m's working value when it has one (SET), else to its cell (l2_rw_write).
    if: l2_rw_write(into, oi, l2_rw_bind_op(oi), out, @ slotv) != 0
        return: 1
    holder: \out
    # m of a declared Structure type T takes the NEXT letter and admits it to T -- its payload, the
    # user's model describes the payload -- a refusal being the implicit throw `implements`
    # (-178 commit 3): PUT(m, admit_letter(take, T)). The two-name form `receiveMessage: m T`
    # types m with the synthesized letter model: m holds the whole letter, admitted to that
    # model as it is (-172 c2), PUT(m, admit(take, letter model)).
    ni: l2_own_nsty_get(oi)
    if: ni >= 0
        if: l2_rw_admit(holder, ni, (cast: (int) (cmodel = 0)), l2_own_ty[oi], @ adm) != 0 || l2_rw_put(holder, slotv, adm) != 0
            return: 1
        holder: adm
        slotv: 3
    ---
    if: l2_rw_frame(holder, "LMX_WALK_OP_PRIM", 3, @ prim) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        @: LmxPrimitive l2_rwp%d (cast: (@: LmxPrimitive) lmx_arena_take(l2_program_arena, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))\n        if: l2_rwp%d = 0\n            return: 1\n        l2_rwp%d\\fn: lmx_walk_mail_take\n        l2_rwp%d\\signature: 0\n        l2_rwp%d\\owner: l2_entry_unit\n        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_rwp%d)) != 0\n            return: 1\n", prim, prim, prim, prim, prim, prim, prim) < 0
        return: 1
    if: l2_rw_contract(prim, 0, l2_own_ty[oi], 0, @ contract, @ inputs) != 0 || l2_rw_primitive_contract(prim, contract) != 0
        return: 1
return: l2_rw_put(holder, slotv, prim)

# `Model: m` at the walked root: m, a root own field of the named Structure type Model, takes a
# fresh merge of Model (merge(Model, empty), the contextual `left: right` rule), made in R0's turn
# by the walker's one kernel merge primitive (-174 c3: a PRIM whose record's fn is
# lmx_walk_merge_model, its owner the program's arena, its input the model) and stored by reference
# into m's pointer cell (PUT, -174 c2).
fn: l2_rw_model (const: @(LmP0Node stmt); const: @(LmP0Text h); int: into; @: int out) int
    @: LmP0Field f
    int: ni l2_ns_find(h)
    int: oi 0
    int: prim
    int: vs
    int: contract
    int: inputs
    int: admission
    L2ReferenceSource: source
    # `S()` / `S: ()` on the named Structure is its nullary call, made before (l2_rw_struct_call): no empty body is
    # this declaration.
    if: stmt\as\frame\body = 0 || l2_count_active(stmt\as\frame\body) = 0
        return: l2_rw_refuse(stmt, "this call")
    f: l2_next_active(stmt\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || l2_next_active(f\next) != 0
        return: l2_rw_refuse(stmt, "this declaration")
    while: oi < l2_own_n && (l2_own_decl[oi] != stmt || l2_own_mi[oi] != l2_rw_mi)
        oi: oi + 1
    ---
    if: oi >= l2_own_n
        return: l2_rw_refuse(stmt, "this declaration")
    if: l2_own_host[oi] != 0 || l2_own_fid[oi] >= 0 || l2_own_uchild[oi] < 0
        return: l2_rw_refuse(stmt, "a field declared in a nested body")
    if: ni < 0 || l2_own_nsty_get(oi) != ni || l2_ns_parent[ni] >= 0 || l2_ns_eternal[ni] >= 0
        return: l2_rw_refuse(stmt, "a Structure-typed field")
    # §7b: making a Model is a merge -- a receiver that copies graph state, so PRIM_PUB publishes before it; the result
    # goes to m's working value when it has one (l2_rw_write).
    source.schema: ni
    source.layout: ni
    source.method: -1
    source.place: -1
    if: l2_rw_write(into, oi, l2_rw_bind_op(oi), out, @ vs) != 0 || l2_rw_admit_project(\out, ni, @ source, 0, -1, -1, -1, @ admission) != 0 || l2_rw_frame(admission, "LMX_WALK_OP_PRIM_PUB", 4, @ prim) != 0 || l2_use_unit_child(7, ni) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        @: LmxPrimitive l2_rwp%d (cast: (@: LmxPrimitive) lmx_arena_take(l2_program_arena, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))\n        if: l2_rwp%d = 0\n            return: 1\n        l2_rwp%d\\fn: lmx_walk_merge_model\n        l2_rwp%d\\signature: 0\n        l2_rwp%d\\owner: (cast: (@: Lmx) l2_program_arena)\n        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_rwp%d)) != 0 || lmx_arena_ref_store(l2_rw%d, 3U, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n", prim, prim, prim, prim, prim, prim, prim, prim, ni) < 0
        return: 1
    if: l2_rw_contract(prim, 1, 0, 1, @ contract, @ inputs) != 0 || l2_rw_witness(inputs, 0, 0, 1) != 0 || l2_rw_primitive_contract(prim, contract) != 0
        return: 1
    if: l2_rw_put(admission, 3, prim) != 0
        return: 1
return: l2_rw_put(\out, vs, admission)

# A reached merge produces one fresh descriptor through PRIM_PUB and stores it
# in its ordinary own row. Operands are read once from visible bindings. The
# instruction carries expression host, producer schema token and inline pairs;
# no result-only unit children or correspondence Structures are constructed.
# The current appended-body subset is a plain Structure of size_t literals.
fn: l2_rw_merge (const: @(LmP0Node stmt); int: res; int: into; @: int out) int
    @: L2ReferenceSource source @ l2_mres_source[res]
    @: LmP0Node mf l2_merge_frame(stmt)
    @: LmP0Structure bd l2_merge_body(stmt)
    @: LmP0Field last
    @: LmP0Field bf
    @: LmP0Field lit
    int: n l2_merge_arity(mf)
    int: bn 0
    int: np 0
    int: nc 0
    int: prim
    int: node
    int: k 0
    int: oi
    int: ni
    int: sl
    int: fi
    int: q 0
    int: contract
    int: inputs
    int: ci
    int: own l2_mres_own[res]
    int: value_slot
    int: excluded l2_own_excl
    int: form
    int: span 0
    int: nt 0
    int: nrec 0
    int: ur
    int: uj
    int: uslot
    int: selfn 0
    int: uform
    int: uspan 0
    @: LmP0Field ufirst
    if: n < 1
        return: l2_error(l2_src, stmt, "merge needs at least one operand")
    if: bd != 0
        bn: l2_count_active(bd)
    if: bd != 0 && bn = 0
        return: l2_error(l2_src, stmt, "an empty merge result body is not a field list")
    while: q < l2_msrc_n
        if: l2_msrc_res[q] = res && l2_msrc_pair[q] != 0
            np: np + 1
        q: q + 1
    ---
    # §7b: merge copies graph state -- PRIM_PUB publishes after its operands, before it runs.
    # The pair count, the qualified-branch count, the use-cell count and the two boxed producer tokens precede the
    # operands; the qualified branch roots follow the pair cells, and their exact profiles are retained as the
    # operands' are, so the copied lexical chain keeps each independent: const: immutable branch itself (docs
    # #composition), as a callable merge's copy does (l2_t7_emit_lex_copy).  No input names a parent: the result's is
    # the copy's own (lmx_merge_profiles_owned; LMX_blog/2026-10-05.md#merge-parent), wherever the merge is reached.
    # All map cells remain inline in this existing instruction, not a helper graph.
    # READ-FIELD-CLOSURE: each operand's model, then the uses of the operands' copied code -- the native merge's own
    # records (l2_mu_collect) -- carried as T use cells after the qualified roots: nt = 3 * records + their slots.
    l2_own_excl: own
    k: 0
    while: k < n
        uform: l2_merge_decl_operand(mf, k, l2_rw_mi, l2_src, @ ufirst, @ uspan)
        if: uform = 1
            l2_own_excl: excluded
            return: 1
        if: l2_mu_set(k, l2_mu_operand_model(ufirst, uspan, uform, l2_rw_mi)) != 0
            l2_own_excl: excluded
            return: 1
        k: k + 1
    ---
    l2_own_excl: excluded
    k: 0
    # The records are read where the layout is complete: in the pass that writes the frame (l2_use_resolve).
    if: l2_rw_emit != 0
        if: l2_mu_collect(n) != 0
            return: 1
        nrec: l2_mur_n
        nt: 3 * l2_mur_n + l2_mur_slots
    ---
    if: l2_rw_catch_fixed(0 - 1, 0, 1, "merge", @ nc) != 0
        return: 1
    if: l2_rw_write(into, own, l2_rw_bind_op(own), out, @ value_slot) != 0 || l2_rw_frame(\out, "LMX_WALK_OP_PRIM_PUB", n + 9 + 3 * np + l2_ebr_n + nt + 3 * nc, @ prim) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        @: LmxPrimitive l2_rwp%d (cast: (@: LmxPrimitive) lmx_arena_take(l2_program_arena, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))\n        if: l2_rwp%d = 0\n            return: 1\n        l2_rwp%d\\fn: lmx_walk_merge_map\n        l2_rwp%d\\signature: 0\n        l2_rwp%d\\owner: (cast: (@: Lmx) l2_program_arena)\n        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_rwp%d)) != 0\n            return: 1\n", prim, prim, prim, prim, prim, prim, prim) < 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 3U, %dU) != c.LMX_WALK_OK || lmx_walk_store_size(l2_program_arena, l2_rw%d, 4U, %dU) != c.LMX_WALK_OK || lmx_walk_store_size(l2_program_arena, l2_rw%d, 5U, %dU) != c.LMX_WALK_OK\n            return: 1\n", prim, np, prim, l2_ebr_n, prim, nt) < 0
        return: 1
    if: l2_rw_catch_fixed(prim, n + 9 + 3 * np + l2_ebr_n + nt, 1, "merge", @ nc) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_charptr(l2_program_arena, l2_rw%d, 6U, l2_layout_tokens + %d) != c.LMX_WALK_OK\n            return: 1\n", prim, l2_schema_token_slot(l2_schema_merge(res))) < 0
        return: 1
    if: l2_rw_emit != 0 && source\layout != -1 && c.fprintf(l2_out, "        if: lmx_walk_store_charptr(l2_program_arena, l2_rw%d, 7U, l2_layout_tokens + %d) != c.LMX_WALK_OK\n            return: 1\n", prim, l2_schema_token_slot(source\layout)) < 0
        return: 1
    if: l2_rw_emit != 0 && source\layout = -1 && c.fprintf(l2_out, "        if: lmx_walk_store_charptr(l2_program_arena, l2_rw%d, 7U, 0) != c.LMX_WALK_OK\n            return: 1\n", prim) < 0
        return: 1
    # The use cells: [anchor, k, len, len slots] per record -- the unit an explicit anchor, named by the activation's
    # own occurrence (SELF), whose lexical root the walk anchors the record at: no frame holds the unit itself, so a
    # copy of this code that runs elsewhere names its own copy's unit, and copying the code never copies the unit as a
    # value; an operand's lexical parent its selector k + 1 with the anchor input left empty (lmx_walk_merge_map).
    uslot: n + 9 + 3 * np + l2_ebr_n
    ur: 0
    while: ur < nrec
        if: l2_mur_sel[ur] = 0 && (l2_rw_frame(prim, "LMX_WALK_OP_SELF", 1, @ selfn) != 0 || l2_rw_put(prim, uslot, selfn) != 0)
            return: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %dU) != c.LMX_WALK_OK || lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %dU) != c.LMX_WALK_OK\n            return: 1\n", prim, uslot + 1, l2_mur_sel[ur], prim, uslot + 2, l2_mur_len[ur]) < 0
            return: 1
        uj: 0
        while: uj < l2_mur_len[ur]
            if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %dU) != c.LMX_WALK_OK\n            return: 1\n", prim, uslot + 3 + uj, l2_mur_sbuf[l2_mur_off[ur] + uj]) < 0
                return: 1
            uj: uj + 1
        ---
        uslot: uslot + 3 + l2_mur_len[ur]
        ur: ur + 1
    ---
    l2_own_excl: own
    while: k < n
        form: l2_merge_decl_operand(mf, k, l2_rw_mi, l2_src, @ last, @ span)
        if: form = 1
            l2_own_excl: excluded
            return: 1
        # K03 S7b: a path or a call operand -- its reference walked under the merge, evaluated before it runs.
        if: form = 2
            if: l2_rw_merge_operand(last, span, l2_own_ty[own], prim, @ node) != 0 || l2_rw_put(prim, k + 8, node) != 0
                l2_own_excl: excluded
                return: 1
            k: k + 1
            continue
        ---
        sl: l2_resolved_own(l2_rw_mi, last\value\as\atom)
        oi: l2_ebr_find(last\value\as\atom)
        ni: l2_ns_find(last\value\as\atom)
        if: sl >= 0
            if: l2_rw_own(prim, sl, @ node) != 0 || l2_rw_put(prim, k + 8, node) != 0
                l2_own_excl: excluded
                return: 1
            ---
        else:
            # K02: a formal operand -- the caller's value through the ordinary ARG frame.
            fi: l2_param_find(l2_rw_mi, last\value\as\atom)
            if: fi >= 0
                if: l2_rw_arg(prim, fi, @ node) != 0 || l2_rw_put(prim, k + 8, node) != 0
                    l2_own_excl: excluded
                    return: 1
                ---
            else:
                if: oi < 0 && ni < 0
                    l2_own_excl: excluded
                    return: l2_error(l2_src, stmt, "unknown merge operand")
                if: (oi >= 0 && l2_use_unit_child(2, oi) != 0) || (oi < 0 && l2_use_unit_child(7, ni) != 0)
                    l2_own_excl: excluded
                    return: 1
                if: oi >= 0 && l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, %dU, (cast: (@: void) lmx_arena_ref_struct(l2_entry_unit, %uU))) != 0\n            return: 1\n", prim, k + 8, (cast: (unsigned) (l2_ebr_unit_slot(oi)))) < 0
                    l2_own_excl: excluded
                    return: 1
                if: oi < 0 && l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, %dU, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n", prim, k + 8, ni) < 0
                    l2_own_excl: excluded
                    return: 1
                ---
            ---
        k: k + 1
    ---
    l2_own_excl: excluded
    if: bd != 0
        if: l2_rw_plain(prim, bn, @ node) != 0 || l2_rw_put(prim, n + 8, node) != 0
            return: 1
        bf: l2_next_active(bd\first_field)
        k: 0
        while: bf != 0
            if: l2_frame_head(bf\value, "size_t") = 0 || l2_count_active(bf\value\as\frame\body) != 2
                return: l2_error(l2_src, stmt, "unsupported merge result body field")
            lit: l2_next_active(l2_next_active(bf\value\as\frame\body\first_field)\next)
            if: lit\value = 0 || lit\value\kind != c.LM_P0_NODE_ATOM || l2_num(lit\value\as\atom) = 0
                return: l2_error(l2_src, stmt, "a merge result body field needs a literal")
            if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %zuU) != c.LMX_WALK_OK\n            return: 1\n", node, k, l2_literal_value(lit\value\as\atom)) < 0
                return: 1
            bf: l2_next_active(bf\next)
            k: k + 1
        ---
    ---
    if: np > 0
        q: 0
        k: 0
        while: q < l2_msrc_n
            if: l2_msrc_res[q] = res && l2_msrc_pair[q] != 0 && l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %dU) != c.LMX_WALK_OK || lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %dU) != c.LMX_WALK_OK || lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %dU) != c.LMX_WALK_OK\n            return: 1\n", prim, n + 9 + 3 * k, l2_msrc_slot[q], prim, n + 9 + 3 * k + 1, l2_msrc_op[q], prim, n + 9 + 3 * k + 2, l2_msrc_fld[q]) < 0
                return: 1
            if: l2_msrc_res[q] = res && l2_msrc_pair[q] != 0
                k: k + 1
            q: q + 1
        ---
    ---
    # The qualified roots: the program's qualified branches (l2_program_qualified_at), the retained set the native
    # merge keeps (l2_emit_keep) -- shared, never copied, so no lexical use of the unit: a callable merge's view, whose
    # unit is its copy, passes the same branches.
    q: 0
    while: q < l2_ebr_n
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, %dU, (cast: (@: void) l2_program_qualified_at(%dU))) != 0\n            return: 1\n", prim, n + 9 + 3 * np + q, q) < 0
            return: 1
        q: q + 1
    ---
    if: l2_rw_contract(prim, n + 6 + 3 * np + l2_ebr_n + nt, 0, 1, @ contract, @ inputs) != 0 || l2_rw_witness(inputs, 0, 2, 0) != 0
        return: 1
    if: l2_rw_witness(inputs, 1, 2, 0) != 0 || l2_rw_witness(inputs, 2, 2, 0) != 0 || l2_rw_witness(inputs, 3, l2_own_ty_of_param(12), 0) != 0 || l2_rw_witness(inputs, 4, l2_own_ty_of_param(12), 0) != 0
        return: 1
    ci: 5
    while: ci <= n + 5
        if: l2_rw_witness(inputs, ci, 0, 1) != 0
            return: 1
        ci: ci + 1
    ---
    while: ci < n + 6 + 3 * np
        if: l2_rw_witness(inputs, ci, 2, 0) != 0
            return: 1
        ci: ci + 1
    ---
    while: ci < n + 6 + 3 * np + l2_ebr_n
        if: l2_rw_witness(inputs, ci, 0, 1) != 0
            return: 1
        ci: ci + 1
    ---
    # A use record's anchor input is a Structure (left empty for a selector); its k, len and slots are size_t.
    ur: 0
    while: ur < nrec
        if: l2_rw_witness(inputs, ci, 0, 1) != 0
            return: 1
        ci: ci + 1
        uj: 0
        while: uj < 2 + l2_mur_len[ur]
            if: l2_rw_witness(inputs, ci, 2, 0) != 0
                return: 1
            ci: ci + 1
            uj: uj + 1
        ---
        ur: ur + 1
    ---
    if: l2_rw_primitive_contract(prim, contract) != 0
        return: 1
return: l2_rw_put(\out, value_slot, prim)

# The root's own int field oi is a field of the unit, and a unit field's cell is shared with every
# method that can see it: a callee's write is what the activation sees.  So the walked root holds
# no working copy of it: it is read (`at`) and assigned (`put`) in the unit, at the unit's child
# l2_own_uchild[oi].  Node `node`'s slots 1 and 2 name that cell.
# The body being built names its OWN fields by no holder (-193 T4a; Sonnet's K-OT2): holder 0 is
# «this activation's data» -- the root's is the unit, (R0, R0); a method's is its occurrence at every
# call, a merge result's own slots when its frames are a model's -- and the slot is the field's own
# child (l2_own_mslot).  A unit field a method sees is
# named by its holder, the unit.
fn: l2_rw_cell (int: node; int: oi) int
    int: k
    @: L2GraphField field l2_graph_field(oi)
    # A cell of another home -- the root's field a method reads as its lexical fallback, held in a graph place or not,
    # a program part's root's field -- is a use of the unit as the code below addresses it (form 9, l2_use_cell_slots),
    # noted by its declaration in every pass and resolved where the layout is final; a merge's view reading the
    # program's unit (l2_rw_type_base) reads no copy.
    if: l2_own_mi[oi] != l2_rw_mi && l2_own_mi[oi] >= 0 && l2_rw_type_base = 0 && l2_use_cell_note(9, oi) != 0
        return: 1
    # A merge's node is built by a constructor of its own, when the merge runs.  A holder the unit's
    # constructor allocated is named there by that constructor's own alias (l2_emit_graph_build_place), which
    # the node's constructor does not have.  The unit is complete when a merge runs: a cell it holds in a nested
    # body is reached from the unit along the edges of its places, as a native body reaches it
    # (l2_emit_graph_holder).  A holder of another owner -- a method, a program part -- is not reached from a
    # merge's node yet.
    if: l2_t7_walk != 0 && l2_t7_walk <= l2_t7_n && field != 0 && field\holder != 0
        if: l2_own_mi[oi] != l2_e
            return: l2_error(l2_src, l2_t7_at[l2_t7_walk - 1], "a callable merge whose body reads a cell held in a nested body of a method or a program part is not built yet")
        if: l2_rw_emit = 0
            return: 0
        if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) ", node) < 0 || l2_emit_graph_unit_place(field\holder) != 0
            return: 1
        return: (cast: (int) (c.fprintf(l2_out, ")) != 0 || lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", node, field\child) < 0))
    ---
    if: l2_rw_emit = 0
        return: 0
    if: field = 0
        return: 1
    # Fixed construction-time holders use the same physical edge chain as
    # runtime OF addressing, rooted at their actual owning occurrence.
    if: field\holder != 0
        if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) ", node) < 0 || l2_emit_graph_build_place(field\holder, l2_own_mi[oi]) != 0
            return: 1
        return: (cast: (int) (c.fprintf(l2_out, ")) != 0 || lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", node, field\child) < 0))
    if: l2_own_mi[oi] = l2_rw_mi
        return: (cast: (int) (c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", node, field\child) < 0))
    # A field of a program part's root (§10) is named by its holder, that root -- a unit child the builder holds
    # in l2_nsp -- whichever code reads it: a method of that part, or a caller passing it as the hidden input of
    # a method of that part (Q52: the callee's lexical source, book :1196).
    k: l2_m_file(l2_own_mi[oi])
    if: k >= 0 && l2_part_ns[k] >= 0 && l2_own_mi[oi] = l2_ns_proc[l2_part_ns[k]]
        return: (cast: (int) (c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_nsp[%d])) != 0 || lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", node, l2_part_ns[k], node, field\child) < 0))
    if: l2_rw_type_base != 0
        return: (cast: (int) (c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_program_unit)) != 0 || lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", node, node, field\child) < 0))
return: (cast: (int) (c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_entry_unit)) != 0 || lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", node, node, field\child) < 0))

# The walker op that binds the root's own field oi (-189 c3b-3; grok_bot -186): an own Structure
# field's slot takes the Structure itself, [put_ref, holder, slot, value]; any other field is a cell,
# [put, holder, slot, value].
fn: l2_rw_bind_op (int: oi) const: @: char
    if: l2_own_is_slot(oi) != 0
        return: "LMX_WALK_OP_PUT_REF"
return: "LMX_WALK_OP_PUT"

# A read of the root's own int field oi.
# ARRAYS IN THE BODY BEING BUILT (-170, over grok_bot's ELEM / ELEMPUT roles): an element `x[i]` of
# an own Array x of the body -- the Array's descriptor in the own field's slot, [op, holder, slot]
# as AT has it (l2_rw_cell), the literal index next -- for the element types the roles take: int,
# char, size_t, ulong (own storage 4, 5, 7, 37).  x's row, or -1 when t is not such an element; the
# index goes to `index`.
fn: l2_rw_elem_of (const: @(LmP0Text t); @: size_t index) int
    int: oi 0 - 1
    if: t = 0 || l2_own_index_head(t, l2_rw_mi, @ oi, index) != 0 || oi < 0
        return: 0 - 1
    if: l2_rw_seen(oi) = 0 || l2_rw_array_placed(oi) = 0 || l2_rw_elem_ty(oi) < 0
        return: 0 - 1
return: oi

# Own field oi has a physical place for an Array descriptor: a child of the
# body being built, or a child of the nested body that declares it. Both are
# assigned by the one layout (l2_layout_owns); neither is a working value.
fn: l2_rw_array_placed (int: oi) int
    if: oi < 0 || oi >= l2_own_n
        return: 0
    if: l2_own_host[oi] = 0
        return: (cast: (int) (l2_own_fid[oi] < 0 && l2_own_uchild[oi] >= 0))
return: (cast: (int) (l2_own_fid[oi] >= 0 && l2_own_fchild[oi] >= 0))

# The declared element's closed value type, projected to ordinary storage.
fn: l2_rw_elem_ty (int: oi) int
    @: L2Declaration declaration
    int: ft
    if: oi < 0 || oi >= l2_own_n
        return: -1
    if: l2_own_ty[oi] = 8
        return: 3
    declaration: l2_declaration(l2_own_decl[oi])
    if: declaration = 0 || declaration\contract = 0 || declaration\contract\kind != 1 || l2_contract_formal(declaration\contract\operand, @ ft) != 0
        return: -1
return: l2_own_ty_of_param(ft)

# Element type of `path[i]` (kind 5) or `path[i][j]` (kind 6): the field's element
# code, 0 int or 1 char. An array value itself (one index of kind 6) is not a number.
fn: l2_rw_index_ty (const: @(LmP0Node node); const: @(LmP0Text t)) int
    size_t: cut 0U
    size_t: b
    size_t: nidx 0U
    int: kind 0
    int: ent 0
    int: slot
    int: ni
    []: int path_own 42
    @: int path 0
    @: LmP0Text prefix
    if: t = 0
        return: 0 - 1
    while: cut < t\length && t\data[cut] != 91
        cut: cut + 1U
    ---
    if: cut = 0U || cut >= t\length
        return: 0 - 1
    prefix: (cast: (@: LmP0Text) calloc(1U, c.sizeof(c.LmP0Text)))
    if: prefix = 0
        return: 0 - 1
    prefix\data: t\data
    prefix\length: cut
    path: l2_rw_path_room(prefix, path_own, 42)
    if: l2_rw_path_meta(node, prefix, 0, path) != 0 || path[2] < 1
        free((cast: (@: void) prefix))
        return: 0 - 1
    free((cast: (@: void) prefix))
    b: cut
    while: b < t\length
        if: t\data[b] = 91
            nidx: nidx + 1U
        b: b + 1U
    ---
    b: cut
    while: b > 0U && t\data[b - 1U] != 92
        b: b - 1U
    ---
    ni: path[4]
    if: ni < 0
        return: 0 - 1
    slot: l2_ns_named_row(ni, t\data, b, cut - b, @ kind, @ ent)
    if: slot < 0
        return: 0 - 1
    if: kind = 5 && nidx = 1U
        return: ent
    if: kind = 6 && nidx = 2U
        return: ent
return: 0 - 1

# One `[digits]` at `at`. 0 = taken, `at` stands after the `]`.
fn: l2_rw_take_index (const: @(LmP0Text t); @: size_t at; @: size_t out_v) int
    size_t: i
    size_t: v 0U
    size_t: digit
    i: \at
    if: t = 0 || i >= t\length || t\data[i] != 91
        return: 1
    i: i + 1U
    if: i >= t\length || t\data[i] < 48 || t\data[i] > 57
        return: 1
    while: i < t\length && t\data[i] >= 48 && t\data[i] <= 57
        digit: (cast: (size_t) (t\data[i] - 48))
        if: v > (((cast: (size_t) -1) - digit) / 10U)
            return: 1
        v: v * 10U + digit
        i: i + 1U
    ---
    if: i >= t\length || t\data[i] != 93
        return: 1
    \out_v: v
    \at: i + 1U
return: 0

# `path[i]` or `path[i][j]`: ELEM over the path's array field. Two indices nest.
fn: l2_rw_indexed_path (const: @(LmP0Node node); const: @(LmP0Text t); int: parent; @: int out) int
    size_t: cut 0U
    size_t: at
    size_t: i0 0U
    size_t: i1 0U
    int: nidx 0
    int: base
    int: inner
    []: int path_own 42
    @: int path 0
    @: LmP0Text prefix
    while: cut < t\length && t\data[cut] != 91
        cut: cut + 1U
    ---
    if: cut = 0U || cut >= t\length
        return: l2_rw_refuse(node, "an array")
    prefix: (cast: (@: LmP0Text) calloc(1U, c.sizeof(c.LmP0Text)))
    if: prefix = 0
        return: l2_rw_refuse(node, "an array")
    prefix\data: t\data
    prefix\length: cut
    path: l2_rw_path_room(prefix, path_own, 42)
    if: l2_rw_path(node, prefix, 1, path) != 0
        free((cast: (@: void) prefix))
        return: 1
    free((cast: (@: void) prefix))
    at: cut
    if: l2_rw_take_index(t, @ at, @ i0) != 0
        return: l2_rw_refuse(node, "an array")
    nidx: 1
    if: at < t\length
        if: l2_rw_take_index(t, @ at, @ i1) != 0 || at != t\length
            return: l2_rw_refuse(node, "an array")
        nidx: 2
    ---
    if: nidx = 1
        if: l2_rw_frame(parent, "LMX_WALK_OP_ELEM", 3, out) != 0
            return: 1
        if: l2_rw_path_value(path, path[2], \out, @ base) != 0 || l2_rw_put(\out, 1, base) != 0
            return: 1
        if: l2_rw_size_index(\out, i0) != 0
            return: 1
        return: 0
    ---
    if: l2_rw_frame(parent, "LMX_WALK_OP_ELEM", 3, out) != 0
        return: 1
    if: l2_rw_frame(\out, "LMX_WALK_OP_ELEM", 3, @ inner) != 0 || l2_rw_put(\out, 1, inner) != 0
        return: 1
    if: l2_rw_path_value(path, path[2], inner, @ base) != 0 || l2_rw_put(inner, 1, base) != 0
        return: 1
    if: l2_rw_size_index(inner, i0) != 0 || l2_rw_size_index(\out, i1) != 0
        return: 1
return: 0

# length(array). Own name, length(path), or length(path[i]) of an array-of-arrays.
fn: l2_rw_length_of (const: @(LmP0Node node); int: parent; @: int out) int
    @: LmP0Field first
    @: LmP0Field g
    @: LmP0Field nm
    int: n
    int: nseen
    int: oi
    int: k
    int: arr
    int: elem
    []: char pd_own 256
    @: char pd 0
    size_t: room 0U
    size_t: pn 0U
    size_t: iv 0U
    int: kind
    int: depth
    size_t: i0 0U
    []: int path_own 42
    @: int path 0
    @: LmP0Text prefix
    if: node = 0 || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0
        return: l2_rw_refuse(node, "an array")
    first: l2_next_active(node\as\frame\body\first_field)
    n: l2_count_active(node\as\frame\body)
    if: n = 1 && first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && first\value\as != 0 && first\value\as\atom != 0
        k: 0
        while: k < (cast: (int) first\value\as\atom\length) && first\value\as\atom\data[k] != 91
            k: k + 1
        ---
        if: k = (cast: (int) first\value\as\atom\length)
            oi: l2_rw_find(first\value\as\atom)
            if: oi >= 0 && l2_own_is_array(l2_own_ty[oi]) != 0
                if: l2_rw_frame(parent, "LMX_WALK_OP_LENGTH", 2, out) != 0 || l2_rw_own(\out, oi, @ arr) != 0 || l2_rw_put(\out, 1, arr) != 0
                    return: 1
                return: 0
            ---
        ---
    ---
    # The root's own table is l2_rw_find, not l2_path_root. Join the body into a path
    # and ask that table. Kind 5/6 is an array field; one index is its inner array.
    if: first = 0 || first\value = 0 || first\value\kind != c.LM_P0_NODE_ATOM || first\value\as = 0 || l2_ident(first\value\as\atom) = 0
        return: l2_rw_refuse(node, "an array")
    # The path's text of any length (l2_text_room).
    room: l2_atoms_len(node\as\frame\body\first_field, -1) + 1U
    pd: l2_text_room(room, pd_own, 256U)
    if: pd = 0
        return: l2_alloc_or(l2_src, node, "out of memory")
    if: first\value\as\atom\length + 1U > room
        return: l2_rw_refuse(node, "an array")
    memcpy((cast: (@: void) pd), (cast: (@: void) first\value\as\atom\data), first\value\as\atom\length)
    pn: first\value\as\atom\length
    nseen: 1
    g: l2_next_active(first\next)
    while: g != 0 && g\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM && g\value\as != 0 && l2_is_slash(g\value\as\atom)
        nm: l2_next_active(g\next)
        if: nm = 0 || nm\value = 0 || l2_ident(nm\value\as\atom) = 0
            return: l2_rw_refuse(node, "an array")
        if: pn + 1U + nm\value\as\atom\length + 1U > room
            return: l2_rw_refuse(node, "an array")
        pd[pn]: 92
        memcpy((cast: (@: void) (pd + pn + 1U)), (cast: (@: void) nm\value\as\atom\data), nm\value\as\atom\length)
        pn: pn + 1U + nm\value\as\atom\length
        nseen: nseen + 2
        g: l2_next_active(nm\next)
    ---
    depth: 0
    while: g != 0 && g\value != 0 && l2_text_eq(g\value\as\atom, "[")
        nm: l2_next_active(g\next)
        if: nm = 0 || l2_dec_literal(nm\value\as\atom, @ iv) != 0
            return: l2_rw_refuse(node, "an array")
        g: l2_next_active(nm\next)
        if: g = 0 || l2_text_eq(g\value\as\atom, "]") = 0
            return: l2_rw_refuse(node, "an array")
        depth: depth + 1
        if: depth = 1
            i0: iv
        nseen: nseen + 3
        g: l2_next_active(g\next)
    ---
    if: nseen != n || g != 0
        return: l2_rw_refuse(node, "an array")
    prefix: (cast: (@: LmP0Text) calloc(1U, c.sizeof(c.LmP0Text)))
    if: prefix = 0
        return: l2_rw_refuse(node, "an array")
    prefix\data: pd
    prefix\length: pn
    path: l2_rw_path_room(prefix, path_own, 42)
    if: l2_rw_path(node, prefix, 0, path) != 0 || path[2] < 1
        free((cast: (@: void) prefix))
        return: l2_rw_refuse(node, "an array")
    free((cast: (@: void) prefix))
    kind: path[7 + 3 * (path[2] - 1)]
    if: kind != 5 && kind != 6
        return: l2_rw_refuse(node, "an array")
    if: l2_rw_frame(parent, "LMX_WALK_OP_LENGTH", 2, out) != 0
        return: 1
    if: depth = 0
        if: l2_rw_path_value(path, path[2], \out, @ arr) != 0 || l2_rw_put(\out, 1, arr) != 0
            return: 1
        return: 0
    ---
    if: depth != 1
        return: l2_rw_refuse(node, "an array")
    if: l2_rw_frame(\out, "LMX_WALK_OP_ELEM", 3, @ elem) != 0 || l2_rw_put(\out, 1, elem) != 0
        return: 1
    if: l2_rw_path_value(path, path[2], elem, @ arr) != 0 || l2_rw_put(elem, 1, arr) != 0
        return: 1
    if: l2_rw_size_index(elem, i0) != 0
        return: 1
return: 0

# Child 2 of an array op is a LIT size. The walker evaluates it (D-39).
fn: l2_rw_size_index (int: elem; size_t: index) int
    int: lit
    if: l2_rw_frame(elem, "LMX_WALK_OP_LIT", 2, @ lit) != 0 || l2_rw_put(elem, 2, lit) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 1U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", lit, index) < 0
        return: 1
return: 0

# ELEM [elem, array, index]. field >= 0: the index is that size_t own field (AT).
# field < 0: index is the decimal literal.
fn: l2_rw_elem (int: parent; int: oi; int: field; size_t: index; @: int out) int
    int: at
    int: ix
    if: l2_rw_frame(parent, "LMX_WALK_OP_ELEM", 3, out) != 0
        return: 1
    if: l2_rw_frame(\out, "LMX_WALK_OP_AT", 3, @ at) != 0 || l2_rw_put(\out, 1, at) != 0 || l2_rw_cell(at, oi) != 0
        return: 1
    if: field >= 0
        if: l2_rw_own(\out, field, @ ix) != 0 || l2_rw_put(\out, 2, ix) != 0
            return: 1
        return: 0
    return: l2_rw_size_index(\out, index)

# ELEMPUT [elemput, array, index, value]: `x[i]: v`, v at the element's type.
fn: l2_rw_elemput (int: into; int: oi; int: field; size_t: index; @: LmP0Field first; int: n; @: int out) int
    int: value
    int: at
    int: ix
    if: l2_rw_frame(into, "LMX_WALK_OP_ELEMPUT", 4, out) != 0
        return: 1
    if: l2_rw_frame(\out, "LMX_WALK_OP_AT", 3, @ at) != 0 || l2_rw_put(\out, 1, at) != 0 || l2_rw_cell(at, oi) != 0
        return: 1
    if: field >= 0
        if: l2_rw_own(\out, field, @ ix) != 0 || l2_rw_put(\out, 2, ix) != 0
            return: 1
    ---
    if: field < 0 && l2_rw_size_index(\out, index) != 0
        return: 1
    if: l2_rw_reference_receive(first, n, l2_rw_elem_ty(oi), -1, \out, @ value) != 0
        return: 1
return: l2_rw_put(\out, 3, value)

# §7b, THE WORKING STATE IN THE WALK (steps/working-state-7b.md §2.3; lmx_walk.h.lm1).  Own field oi of the body being
# walked has a working value when the body is walked with working values (l2_rw_cache_on: a walkable method's, or the
# root's) and the field has one natively (l2_own_cached) -- and the walk can name its slot: a field of a nested body of a method by
# OWN_OF over its body (l2_rw_host_at), any other one by OWN over the slot l2_rw_cell names.  Such a field is read by
# OWN/OWN_OF and written by SET/SET_OF, never by AT/PUT, which stay the explicit graph operations.  No load step is
# emitted: the walker loads the rows at entry from the OWN/OWN_OF/SET_OF nodes of the code itself (lmx_walk_load_code;
# the author, 2026-09-28: no auxiliary structures in the graph).
fn: l2_rw_cached (int: oi) int
    if: l2_rw_cache_on = 0 || oi < 0 || oi >= l2_own_n || l2_own_cached(l2_rw_mi, oi) = 0
        return: 0
    if: l2_rw_is_hosted(oi) != 0
        return: 1
return: (cast: (int) (l2_own_host[oi] = 0 && l2_own_uchild[oi] >= 0))

# One preallocated output operand, and only aliases for its later uses. The
# PLACE producer records ownership once; pass-local temp numbers do not name
# extra objects. FILL uses the explicitly predeclared PLACE allocation alias.
fn: l2_rw_output_operand (int: parent; int: oi; int: declaration; @: int out) int
    @: L2SourceContainer owner 0
    @: L2SourceField field l2_source_field_owner(oi, @ owner)
    []: char pn 32
    const: @(char role) "LMX_WALK_OP_AT"
    int: t l2_rw_t
    if: field = 0
        return: 1
    l2_rw_t: l2_rw_t + 1
    \out: t
    if: declaration != 0
        if: l2_construct_phase = 1
            if: field\storage_temp >= 0
                return: l2_error(l2_src, l2_own_decl[oi], "internal: an output operand has two producers")
            field\storage_temp: t
        ---
        if: l2_construct_temp(t, parent, 0) != 0
            return: 1
        ---
    ---
    if: l2_rw_emit = 0
        return: 0
    if: field\storage_temp < 0 || c.fprintf(l2_out, "        @: Lmx l2_rw%d l2_rw%d\n", t, field\storage_temp) < 0
        return: 1
    if: declaration != 0
        if: l2_rw_cached(oi) != 0
            role: "LMX_WALK_OP_OWN"
        l2_rw_name(parent, pn)
        if: c.fprintf(l2_out, "        l2_rw%d\\parent: %s\n        if: lmx_arena_ref_store(l2_rw%d, 0U, lmx_arena_ref_value(l2_rw_roles, (cast: (size_t) c.%s))) != 0\n            return: 1\n", t, pn, t, role) < 0
            return: 1
        ---
    ---
return: 0

# The node that names cached field oi's working value under `parent`: OWN_OF over its nested body, or OWN.
fn: l2_rw_ownnode (int: parent; int: oi; @: int out) int
    int: base
    @: L2SourceContainer owner 0
    @: L2GraphField field l2_graph_field(oi)
    if: l2_own_computed(oi) != 0 && l2_source_field_owner(oi, @ owner) != 0
        return: l2_rw_output_operand(parent, oi, 0, out)
    if: field = 0
        return: 1
    if: l2_rw_is_hosted(oi) != 0
        if: l2_rw_frame(parent, "LMX_WALK_OP_OWN_OF", 3, out) != 0 || l2_rw_graph_place(\out, field\holder, @ base) != 0 || l2_rw_put(\out, 1, base) != 0
            return: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", \out, field\child) < 0
            return: 1
        return: 0
    ---
    if: l2_rw_frame(parent, "LMX_WALK_OP_OWN", 3, out) != 0
        return: 1
return: l2_rw_cell(\out, oi)

# The frame that writes own field oi under `into`, and the slot its value goes to: SET_OF over the nested body (value
# 3) or SET over its OWN node (value 2) for a cached field; otherwise the graph write `op` (PUT, PUT_REF) with its
# holder and slot (value 3) -- the explicit write every caller made before.
fn: l2_rw_write (int: into; int: oi; const: @(char op); @: int out; @: int vslot) int
    int: own
    int: base
    @: L2SourceContainer owner 0
    @: L2GraphField field l2_graph_field(oi)
    if: l2_own_computed(oi) != 0 && l2_source_field_owner(oi, @ owner) != 0
        if: l2_rw_cached(oi) != 0 || strcmp(op, "LMX_WALK_OP_PUT") = 0
            \vslot: 2
            if: l2_rw_cached(oi) != 0
                op: "LMX_WALK_OP_SET"
            if: l2_rw_frame(into, op, 3, out) != 0 || l2_rw_output_operand(\out, oi, (cast: (int) (l2_here_node = l2_own_decl[oi])), @ own) != 0
                return: 1
            return: l2_rw_put(\out, 1, own)
        ---
        \vslot: 3
        if: l2_rw_frame(into, op, 4, out) != 0 || l2_rw_output_operand(\out, oi, (cast: (int) (l2_here_node = l2_own_decl[oi])), @ own) != 0 || l2_rw_put(\out, 1, own) != 0
            return: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, 1U) != c.LMX_WALK_OK\n            return: 1\n", \out) < 0
            return: 1
        return: 0
    ---
    if: field = 0
        return: 1
    if: l2_rw_cached(oi) != 0 && l2_rw_is_hosted(oi) != 0
        \vslot: 3
        if: l2_rw_frame(into, "LMX_WALK_OP_SET_OF", 4, out) != 0 || l2_rw_graph_place(\out, field\holder, @ base) != 0 || l2_rw_put(\out, 1, base) != 0
            return: 1
        return: (cast: (int) (l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", \out, field\child) < 0))
    ---
    if: l2_rw_cached(oi) != 0
        \vslot: 2
        if: l2_rw_frame(into, "LMX_WALK_OP_SET", 3, out) != 0 || l2_rw_ownnode(\out, oi, @ own) != 0
            return: 1
        return: l2_rw_put(\out, 1, own)
    ---
    \vslot: 3
    if: l2_rw_is_hosted(oi) != 0 && l2_own_is_slot(oi) = 0
        if: l2_rw_frame(into, "LMX_WALK_OP_PUT_OF", 4, out) != 0 || l2_rw_graph_place(\out, field\holder, @ base) != 0 || l2_rw_put(\out, 1, base) != 0
            return: 1
        return: (cast: (int) (l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", \out, field\child) < 0))
    ---
    if: strcmp(op, "LMX_WALK_OP_PUT") = 0
        \vslot: 2
        if: l2_rw_frame(into, op, 3, out) != 0 || l2_rw_frame(\out, "LMX_WALK_OP_AT", 3, @ own) != 0 || l2_rw_cell(own, oi) != 0
            return: 1
        return: l2_rw_put(\out, 1, own)
    if: l2_rw_frame(into, op, 4, out) != 0
        return: 1
return: l2_rw_cell(\out, oi)

fn: l2_rw_own (int: parent; int: oi; @: int out) int
    if: l2_rw_cached(oi) != 0
        return: l2_rw_ownnode(parent, oi, out)
    if: l2_rw_is_hosted(oi) != 0
        return: l2_rw_host_read(parent, oi, out)
    if: l2_rw_frame(parent, "LMX_WALK_OP_AT", 3, out) != 0
        return: 1
return: l2_rw_cell(\out, oi)

# An assignment of the root's own int field oi from the n fields at `first`, a node of `into`: its working value (SET,
# SET_OF) when it has one, else the graph (PUT, PUT_OF).
fn: l2_rw_assign (int: into; int: oi; @: LmP0Field first; int: n; @: int out) int
    int: value
    int: vs
    if: l2_rw_cached(oi) = 0 && l2_rw_is_hosted(oi) != 0 && l2_own_computed(oi) = 0
        return: l2_rw_host_put(into, oi, first, n, out)
    if: l2_rw_write(into, oi, "LMX_WALK_OP_PUT", out, @ vs) != 0 || l2_rw_texpr(first, n, l2_own_ty[oi], \out, @ value) != 0
        return: 1
return: l2_rw_put(\out, vs, value)

# Does a head spell a field path (a\b)?
fn: l2_rw_has_slash (const: @(LmP0Text t)) int
    size_t: i 0U
    if: t = 0 || t\data = 0
        return: 0
    while: i < t\length
        if: t\data[i] = 92
            return: 1
        i: i + 1U
    ---
return: 0

# The root's own numeric field named t, or -1 with the refusal made.
fn: l2_rw_own_row (const: @(LmP0Node node); const: @(LmP0Text t)) int
    int: oi l2_rw_find(t)
    if: l2_rw_seen(oi) = 0
        return: 0 - 2
    if: l2_own_host[oi] != 0
        if: l2_rw_is_hosted(oi) != 0
            return: oi
        if: l2_frame_head(l2_own_host[oi], "catch") = 0 || l2_own_fid[oi] < 0 || l2_own_fchild[oi] < 0 || l2_rw_num_ty(l2_own_ty[oi]) = 0
            l2_rw_refuse(node, "a field declared in a nested body")
            return: 0 - 1
        return: oi
    if: l2_own_fid[oi] >= 0
        l2_rw_refuse(node, "a field declared in a nested body")
        return: 0 - 1
    if: l2_rw_num_ty(l2_own_ty[oi]) = 0 || l2_own_uchild[oi] < 0
        l2_rw_refuse_ty(node, oi)
        return: 0 - 1
return: oi

# The walker node already made for this catch, or -1.
fn: l2_rw_pad_slot (const: @(LmP0Node cf)) int
    int: i 0
    while: i < l2_rw_pn
        if: l2_rw_pcf[i] = cf
            return: l2_rw_pid[i]
        i: i + 1
    ---
return: 0 - 1

fn: l2_rw_param_own (const: @(LmP0Node decl)) int
    int: oi 0
    while: oi < l2_own_n
        if: l2_own_decl[oi] = decl && l2_own_mi[oi] = l2_rw_mi
            return: oi
        oi: oi + 1
    ---
return: 0 - 1

# [pad, param cell..., handler]. The handler is filled when the catch statement is reached.
# A parameter that is not a number is refused: this slice emits only numeric cells.
fn: l2_rw_pad_new (int: into; const: @(LmP0Node cf)) int
    @: LmP0Structure ps
    @: LmP0Field f
    int: np 0
    int: id
    int: oi
    int: k 0
    @: L2GraphField field
    @: L2SourceContainer source
    id: l2_rw_pad_slot(cf)
    if: id >= 0
        return: id
    # -2: no room for the pad (out of memory), which is not the catch's own refusal.
    if: l2_rw_pad_room() != 0
        return: 0 - 2
    ps: l2_catch_params(cf)
    if: ps != 0
        np: l2_count_active(ps)
    f: 0
    if: ps != 0
        f: l2_next_active(ps\first_field)
    while: f != 0
        oi: l2_rw_param_own(f\value)
        if: oi < 0 || l2_rw_num_ty(l2_own_ty[oi]) = 0
            return: 0 - 1
        f: l2_next_active(f\next)
    ---
    source: l2_source_container(cf\as\frame\body, 0)
    if: source = 0 || l2_rw_source_frame(source, into, "LMX_WALK_OP_PAD", 2 + np, @ id) != 0
        return: 0 - 1
    f: 0
    if: ps != 0
        f: l2_next_active(ps\first_field)
    while: f != 0
        oi: l2_rw_param_own(f\value)
        if: l2_source_field_slot(source, oi, 1 + k) != 0
            return: 0 - 1
        k: k + 1
        f: l2_next_active(f\next)
    ---
    l2_rw_pcf[l2_rw_pn]: (cast: (@: LmP0Node) cf)
    l2_rw_pid[l2_rw_pn]: id
    l2_rw_pn: l2_rw_pn + 1
return: id

# One row (k_in, pad, 0). k_out stays 0: the row catches.
fn: l2_rw_catch_row (int: table; int: at; int: k_in; int: pad) int
    if: l2_rw_emit = 0
        return: 0
    if: c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %dU) != c.LMX_WALK_OK || lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, 0U) != c.LMX_WALK_OK || lmx_arena_ref_store(l2_rw%d, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", table, at, k_in, table, at + 2, table, at + 1, pad) < 0
        return: 1
return: 0

# The call's catch rows: one per name this callee can throw that a pad here covers, k_in the callee's own status
# number.  D1: the rows are the CALL's own last operands from `base` -- no table Structure -- and its catch slot 4 holds
# their count.  With node < 0 only the count, into \count (the frame's width is made with it).
fn: l2_rw_catch_call (int: node; int: base; int: callee; @: int count) int
    @: LmP0Text nm
    @: LmP0Node cf
    int: n 0
    int: k 1
    int: d
    int: g
    int: at base
    int: table node
    int: pad
    \count: 0
    if: l2_rw_emit = 0 || callee < 0
        return: 0
    d: l2_throws_declared(callee)
    while: k <= d
        nm: l2_throws_name(callee, k)
        cf: l2_catch_find(l2_rw_mi, nm, 0, 0, 0)
        if: cf != 0 && l2_rw_pad_slot(cf) >= 0
            n: n + 1
        k: k + 1
    ---
    g: 1
    while: l2_implicit_name(g) != 0
        cf: l2_catch_find(l2_rw_mi, 0, l2_implicit_name(g), 0, 0)
        if: cf != 0 && l2_rw_pad_slot(cf) >= 0 && l2_implicit_status(callee, l2_implicit_name(g)) > 0
            n: n + 1
        g: g + 1
    ---
    \count: n
    if: n = 0 || node < 0
        return: 0
    if: c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 4U, %dU) != c.LMX_WALK_OK\n            return: 1\n", node, n) < 0
        return: 1
    k: 1
    while: k <= d
        nm: l2_throws_name(callee, k)
        cf: l2_catch_find(l2_rw_mi, nm, 0, 0, 0)
        pad: l2_rw_pad_slot(cf)
        if: cf != 0 && pad >= 0
            if: l2_rw_catch_row(table, at, k, pad) != 0
                return: 1
            at: at + 3
        ---
        k: k + 1
    ---
    g: 1
    while: l2_implicit_name(g) != 0
        cf: l2_catch_find(l2_rw_mi, 0, l2_implicit_name(g), 0, 0)
        pad: l2_rw_pad_slot(cf)
        if: cf != 0 && pad >= 0 && l2_implicit_status(callee, l2_implicit_name(g)) > 0
            if: l2_rw_catch_row(table, at, l2_implicit_status(callee, l2_implicit_name(g)), pad) != 0
                return: 1
            at: at + 3
        ---
        g: g + 1
    ---
return: 0

# implements-port slice 13: a conversion edge's receiver call.  Whatever the receiver throws is
# the caller's implicit throw `convert` (as edge 1 makes it natively, l2_emit_call): one row per
# status the receiver can leave with -- caught by a `catch: convert ()` pad here, or renumbered to
# the caller's own `convert` status (pad 0, lmx_walk_catch_scan).  The receiver's names are not
# the caller's: a pad for its `range` does not catch it.
fn: l2_rw_catch_edge (int: node; int: base; int: callee; @: int count) int
    @: LmP0Node cf
    int: n 0
    int: k 1
    int: d
    int: g
    int: at base
    int: table node
    int: pad 0 - 1
    int: kout
    \count: 0
    if: l2_rw_emit = 0 || callee < 0
        return: 0
    d: l2_throws_declared(callee)
    n: d
    g: 1
    while: l2_implicit_name(g) != 0
        if: l2_implicit_status(callee, l2_implicit_name(g)) > 0
            n: n + 1
        g: g + 1
    ---
    if: n = 0
        return: 0
    cf: l2_catch_find(l2_rw_mi, 0, "convert", 0, 0)
    if: cf != 0
        pad: l2_rw_pad_slot(cf)
    kout: l2_implicit_status(l2_rw_mi, "convert")
    if: pad < 0 && kout <= 0
        return: l2_error(l2_src, 0, "internal: a conversion edge with no convert status")
    \count: n
    if: node < 0
        return: 0
    if: c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 4U, %dU) != c.LMX_WALK_OK\n            return: 1\n", node, n) < 0
        return: 1
    k: 1
    while: k <= n
        if: pad >= 0 && l2_rw_catch_row(table, at, k, pad) != 0
            return: 1
        if: pad < 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %dU) != c.LMX_WALK_OK || lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %dU) != c.LMX_WALK_OK\n            return: 1\n", table, at, k, table, at + 2, kout) < 0
            return: 1
        at: at + 3
        k: k + 1
    ---
return: 0

# implements-port slice 13 (B3, the root; steps/implements-port-plan.md): at the root a value of
# one named primitive type given to a place of another -- an own field, a call's formal, a
# message field -- calls the conversion row's receiver on it, as a method's store, argument and
# return do (Q33): an ordinary call node of the receiver over the value's own fields, its result
# the place's value, its refusal the root's `convert` (l2_rw_catch_edge).  With no row the root
# refuses as a method does.  A receiver the unit has not taken yet is noted here, in the count
# pass, and l2_emit_unit has the unit translated again with it before anything is written.
fn: l2_rw_convert (@: LmP0Field field; int: n; int: from; int: to; const: @(LmP0Node at); int: parent; @: int out) int
    int: cidx
    int: rc
    int: i 0
    @: LmP0Field f
    @: LmP0Field copy 0
    @: LmP0Field cur 0
    @: LmP0Field prev 0
    if: l2_rw_num_ty(from) = 0 || l2_rw_num_ty(to) = 0
        return: l2_rw_refuse(at, "mixed numeric types (a conversion)")
    if: l2_convert_hit(l2_own_ty_word(from), l2_own_ty_word(to)) = 0
        if: l2_cv_gap = 2
            return: l2_convert_norecv(l2_src, at)
        if: l2_cv_gap = 3
            return: l2_cv_refused(l2_src, at, "internal: a conversion refused without its reason")
        if: l2_cv_gap = 5
            return: l2_error(l2_src, at, "the program has no source table `primitive.convert`")
        return: l2_error(l2_src, at, "mixed numeric types (a conversion)")
    cidx: l2_convert_method()
    if: cidx < 0
        return: l2_error(l2_src, at, "internal: a conversion site was not checked")
    copy: (cast: (@: LmP0Field) l2_xmalloc((cast: (size_t) n) * c.sizeof(c.LmP0Field)))
    if: copy = 0
        return: l2_error(l2_src, at, "out of memory")
    f: l2_next_active(field)
    while: i < n && f != 0
        cur: copy + i
        memcpy((cast: (@: void) cur), (cast: (@: void) f), c.sizeof(c.LmP0Field))
        cur\next: 0
        if: prev != 0
            prev\next: cur
        ---
        prev: cur
        f: l2_next_active(f\next)
        i: i + 1
    ---
    if: i != n
        l2_xfree((cast: (@: void) copy))
        return: l2_error(l2_src, at, "internal: a conversion value is shorter than its run")
    l2_rw_conv: 1
    rc: l2_rw_call(at, cidx, -1, copy, parent, out)
    l2_rw_conv: 0
    l2_xfree((cast: (@: void) copy))
return: rc

# A primitive's own fixed throw code (merge 1, implements 2), caught here: one row, the PRIM's own last operands from
# `base` (D1: no table Structure), its catch slot 2 holding the count.  With node < 0 only the count, into \count.
fn: l2_rw_catch_fixed (int: node; int: base; int: k_in; const: @(char cname); @: int count) int
    @: LmP0Node cf
    int: pad
    \count: 0
    if: l2_rw_emit = 0
        return: 0
    cf: l2_catch_find(l2_rw_mi, 0, cname, 0, 0)
    if: cf = 0
        return: 0
    pad: l2_rw_pad_slot(cf)
    if: pad < 0
        return: 0
    \count: 1
    if: node < 0
        return: 0
    if: c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, 1U) != c.LMX_WALK_OK\n            return: 1\n", node) < 0
        return: 1
return: l2_rw_catch_row(node, base, k_in, pad)

fn: l2_rw_pads (@: LmP0Field first; int: into) int
    @: LmP0Field f
    int: id
    f: l2_next_active(first)
    while: f != 0
        if: l2_frame_head(f\value, "catch")
            id: l2_rw_pad_new(into, f\value)
            if: id = 0 - 2
                return: l2_alloc_or(l2_src, f\value, "out of memory")
            if: id < 0
                return: l2_rw_refuse(f\value, "a catch parameter that is not a number")
            ---
        f: l2_next_active(f\next)
    ---
return: 0

fn: l2_rw_catch_stmt (const: @(LmP0Node stmt); int: into; int: slot; @: int made) int
    @: LmP0Structure body
    @: LmP0Structure ps
    int: id
    int: np 0
    int: empty
    int: bsave
    \made: 1
    id: l2_rw_pad_new(into, stmt)
    if: id = 0 - 2
        return: l2_alloc_or(l2_src, stmt, "out of memory")
    if: id < 0
        return: l2_rw_refuse(stmt, "a catch parameter that is not a number")
    ps: l2_catch_params(stmt)
    if: ps != 0
        np: l2_count_active(ps)
    if: l2_rw_enter(stmt, @ bsave) != 0
        return: 1
    body: l2_catch_body(stmt)
    if: body != 0
        if: l2_rw_body(body, id, 1 + np) != 0
            l2_rw_leave(bsave)
            return: 1
        ---
    else:
        if: l2_rw_plain(id, 0, @ empty) != 0 || l2_rw_put(id, 1 + np, empty) != 0
            l2_rw_leave(bsave)
            return: 1
        ---
    ---
    if: l2_rw_leave(bsave) != 0
        return: 1
    if: l2_rw_put(into, slot, id) != 0
        return: 1
return: 0

# A new empty Structure (EMPTY), admitted to ni, as one call input (D-23).
fn: l2_rw_empty_arg (int: ni; int: parent; @: int out) int
    int: adm
    int: fr
    if: l2_rw_admit(parent, ni, 0, l2_graph_own(), @ adm) != 0
        return: 1
    if: l2_rw_frame(adm, "LMX_WALK_OP_EMPTY", 1, @ fr) != 0
        return: 1
    if: l2_rw_put(adm, 3, fr) != 0
        return: 1
    \out: adm
return: 0

# The existing path resolver supplies the occurrence for a path-headed call.
# EXEC evaluates this value once and dispatches on that very Structure.
fn: l2_rw_path_reference (const: @(LmP0Node node); const: @(LmP0Text head); int: parent; @: int out) int
    @: int path
    int: rc 1
    int: segments l2_seg_count(head\data, head\length)
    # Six header cells followed by one three-cell record per path segment.
    if: segments < 0 || segments > (c.INT_MAX - 6) / 3
        return: 1
    if: l2_mul_ok((cast: (size_t) (6 + 3 * segments)), c.sizeof(c.int)) = 0
        return: 1
    path: (cast: (@: int) calloc((cast: (size_t) (6 + 3 * segments)), c.sizeof(c.int)))
    if: path = 0
        return: 1
    if: l2_rw_path(node, head, 1, path) = 0
        rc: l2_rw_path_value(path, path[2], parent, out)
    ---
    free(path)
return: rc

fn: l2_rw_call_path (const: @(LmP0Node node); const: @(LmP0Text head); int: call) int
    int: value
    if: l2_rw_path_reference(node, head, call, @ value) != 0
        return: 1
return: l2_rw_put(call, 2, value)

# A call of method idx under container parent: the occurrence by reference, then each input from
# `args` (a field run, split by l2_expr_span like any actual list).
fn: l2_rw_call (const: @(LmP0Node node); int: idx; int: selected_formal; @: LmP0Field args; int: parent; @: int out) int
return: l2_rw_call_at(node, 0, idx, selected_formal, args, parent, out)

# The same call, its written head given -- the path a path operand writes (K03 S6, l2_rw_span), the head and selector
# of the call there; else (0) the node's own.
fn: l2_rw_call_at (const: @(LmP0Node node); @: LmP0Text given; int: idx; int: selected_formal; @: LmP0Field args; int: parent; @: int out) int
    @: LmP0Field a
    const: @: LmP0Text head 0
    const: @: char call_op "LMX_WALK_OP_CALL"
    int: path_call 0
    int: formal_call selected_formal
    int: cand
    int: occurrence 0 - 1
    int: need 0
    int: holder
    int: oi
    int: n 0
    int: k 0
    int: span
    int: arg
    int: j
    int: d 0
    int: nc 0
    int: arg0 5
    int: conv l2_rw_conv
    int: contract
    int: contract_hidden
    int: hidden_model
    int: hidden_source
    int: source_mi
    int: source_input
    int: bound 0 - 1
    int: site
    int: hid
    int: dynn
    int: sneed
    int: alias -1
    L2ReferenceSource: reference_source
    int: guarded l2_rw_conv_guarded
    l2_rw_conv: 0
    l2_rw_conv_guarded: 0
    if: conv = 0 && node != 0 && node\as != 0
        if: node\kind = c.LM_P0_NODE_FRAME && node\as\frame != 0
            head: node\as\frame\head
        if: node\kind = c.LM_P0_NODE_ATOM
            head: node\as\atom
        if: given != 0
            head: given
        # K03 S6: a head the one resolution gives idx through a path (l2_head_method), not by its name (l2_site_method):
        # the call runs on the occurrence the path selects.
        if: formal_call < 0 && head != 0 && l2_site_method(l2_rw_mi, head) < 0 && l2_head_method(l2_rw_mi, head) = idx
            path_call: 1
            call_op: "LMX_WALK_OP_EXEC"
        # K03 NS-ROLES-1b: through a binding `b: tick` -- EXEC on the occurrence b holds now.
        if: formal_call < 0 && head != 0 && l2_call_alias_own(l2_rw_mi, head) >= 0
            alias: l2_call_alias_own(l2_rw_mi, head)
            path_call: 1
            call_op: "LMX_WALK_OP_EXEC"
        ---
    ---
    if: formal_call >= 0
        path_call: 1
        call_op: "LMX_WALK_OP_EXEC"
    ---
    # A3: the host calls a capturing nested method -- its model or another -- as any method, (M, M), its captures the
    # hidden inputs it supplies (l2_rw_dyn_arg): the host's current values.  The method is walked (native 0,
    # l2_emit_native_word), so one the walk refused cannot be called.
    if: l2_rw_emit != 0 && l2_rw_mi != l2_e && l2_mad_nested_call(l2_rw_mi, idx) != 0 && (l2_m_steps = 0 || l2_m_steps[idx] <= 0 || l2_m_walkable[idx] = 0)
        return: l2_mad_unwalkable(l2_rw_mi, idx)
    # A callee that can throw is called like any other (commit 3; -161 c3 D-37): its trampoline
    # returns the throw's number k, the walk carries it as LMX_WALK_THROWN + k and stops, and the
    # turn's channel holds k.  The root has no catch yet (no walker role), so a throw there is
    # uncaught: R0 stops and the host maps its success 0 to exit 1.
    # A caller -- the root or a walked method -- passes each dynamic input as one more argument, after the declared
    # ones, in the same activation frame: its own input of that name, its own field, or the callee's lexical field
    # (l2_rw_dyn_arg).  No third graph.
    # A result is an int, a size_t, an unsigned or a ulong (-178): the walk hands a trampoline of a
    # wider type a destination of that type, by the class of the callee's return cell (rtype).
    # A foreign by-value result (class 6) is delivered into exact C storage
    # and has no graph cell: the call is retained whole, native-only.
    if: l2_tramp_class(idx) > 4 && l2_mad_on(idx) = 0 && l2_own_is_pointer(l2_ret_cell_ty(idx)) = 0
        if: l2_tramp_class(idx) != 6
            return: l2_rw_refuse(node, "a call whose result is not a number")
        l2_rw_machine: 1
    ---
    # An input is a number (its formal's type: the trampoline reads that cell type), a Structure
    # of the formal's own named type (by reference, -179), or a callable formal, which takes a
    # method's occurrence by reference.
    j: 0
    while: j < l2_m_arity[idx]
        if: l2_cf_get(idx, j) < 0 && l2_rw_num_ty(l2_own_ty_of_param(l2_input_ft(idx, j))) = 0 && l2_own_is_pointer(l2_own_ty_of_param(l2_input_ft(idx, j))) = 0 && l2_nsty_get(idx, j) < 0
            # A foreign by-value input travels in exact C storage: the
            # written actual keeps its place and the call is native-only.
            if: l2_foreign_value_ft(l2_input_ft(idx, j)) = 0
                return: l2_rw_refuse(node, "a call with an input that is not a number")
            l2_rw_machine: 1
        ---
        j: j + 1
    ---
    a: l2_next_active(args)
    while: a != 0
        span: l2_expr_span(a)
        if: span < 1
            return: l2_rw_refuse(node, "this call's inputs")
        n: n + 1
        a: l2_skip_span(a, span)
    ---
    if: n != l2_m_arity[idx]
        return: l2_rw_refuse(node, "this call's inputs")
    # K04: the hidden inputs of a call through a callable formal are those of the methods that reach the
    # formal (l2_cfl_classes), as the native call forms them.  Where more than one formation reaches it the
    # native call selects the class by the exact occurrence (l2_emit_call_classes); the walk has no such
    # operation yet, so the frame keeps the declared inputs only and the body is native only.
    hid: idx
    dynn: l2_m_dyn[idx]
    if: formal_call >= 0
        if: l2_cfl_classes(l2_rw_mi, formal_call, node, @ sneed) != 0
            return: 1
        hid: 0 - 1
        dynn: 0
        if: sneed = 1
            hid: l2_cfl_at(l2_rw_mi, formal_call, 0)
            dynn: l2_m_dyn[hid]
        if: sneed > 1
            l2_rw_machine: 1
    ---
    # [call, code, data, rtype, args...] (-188 k.3c; -189 c4). A direct call stores the callee
    # once, at slot 1; the walker uses that occurrence as both code and data. EXEC still
    # evaluates slot 2. One activation is not a second graph node (the author, 2026-09-28).
    # rtype is the callee's result cell in its `return` part (l2_emit_parts), by reference: the walk
    # types the call's destination by that cell's range; a `sub` has none (0).
    # D1: the catch rows are the CALL's last operands, after the inputs; counted first, for its width.
    if: conv = 0 && l2_rw_catch_call(0 - 1, 0, idx, @ nc) != 0
        return: 1
    if: conv != 0 && l2_rw_catch_edge(0 - 1, 0, idx, @ nc) != 0
        return: 1
    # A direct call with no catch and no hidden input keeps only the callee and
    # those inputs. Path calls, catches, and hidden inputs keep the long frame.
    if: path_call = 0 && l2_m_nsof(idx) < 0 && nc = 0 && dynn = 0
        arg0: 2
    ---
    if: l2_rw_frame(parent, call_op, arg0 + n + dynn + 3 * nc, out) != 0
        return: 1
    if: arg0 = 5 && conv = 0 && l2_rw_catch_call(\out, 5 + n + dynn, idx, @ nc) != 0
        return: 1
    if: arg0 = 5 && conv != 0 && l2_rw_catch_edge(\out, 5 + n + dynn, idx, @ nc) != 0
        return: 1
    # EXEC obtains the selected occurrence from the caller's actual formal;
    # the signature row supplies the contract, never a substitute callee.
    if: formal_call >= 0
        if: l2_rw_arg_fb(\out, formal_call, @ arg) != 0 || l2_rw_put(\out, 2, arg) != 0
            return: 1
        ---
    else:
        # The unit's binding seen from a walked method is its hidden input (Q52): ARG, as a held name's is.
        if: alias >= 0 && l2_rw_mi != l2_e && l2_own_mi[alias] != l2_rw_mi && l2_param_find(l2_rw_mi, l2_own_name[alias]) >= 0
            if: l2_rw_arg_fb(\out, l2_param_find(l2_rw_mi, l2_own_name[alias]), @ arg) != 0 || l2_rw_put(\out, 2, arg) != 0
                return: 1
            ---
        if: alias >= 0 && (l2_rw_mi = l2_e || l2_own_mi[alias] = l2_rw_mi || l2_param_find(l2_rw_mi, l2_own_name[alias]) < 0)
            if: l2_rw_own(\out, alias, @ arg) != 0 || l2_rw_put(\out, 2, arg) != 0
                return: 1
            ---
        if: alias < 0 && path_call != 0 && l2_rw_call_path(node, head, \out) != 0
            return: 1
        ---
    ---
    if: path_call = 0 && l2_use_unit_child(1, idx) != 0
        return: 1
    if: path_call = 0 && l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) lmx_arena_ref_struct(l2_entry_unit, %uU))) != 0\n            return: 1\n", \out, (cast: (unsigned) (l2_occ_slot(idx)))) < 0
        return: 1
    # The ordinary method's declared input/result parts already are its
    # contract. Do not append a second contract Structure after its source body.
    # A selected path or a signature-less named body still receives the
    # caller's explicit contract at the existing CALL/EXEC operand.
    if: path_call != 0 || l2_m_nsof(idx) >= 0
        contract_hidden: idx
        if: formal_call >= 0
            contract_hidden: hid
        if: l2_rw_call_contract(\out, idx, contract_hidden, @ contract) != 0 || l2_rw_put(\out, 3, contract) != 0
            return: 1
        ---
    # A call bound with named actuals keeps its operands in the order they were written. A
    # named one stands at its written place under a NAMED operand that carries its formal's
    # coordinate and the written name; the walk evaluates the operands in that order and hands
    # each value to its formal.
    if: node != 0 && node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\body != 0 && l2_call_actuals(node\as\frame\body) = args
        bound: l2_bound_find(node\as\frame\body)
    a: l2_next_active(args)
    while: a != 0
        span: l2_expr_span(a)
        site: \out
        if: l2_bound_wrap(bound, k) != 0
            if: l2_rw_frame(\out, "LMX_WALK_OP_NAMED", 3, @ site) != 0 || l2_rw_source_name(site, l2_fn(idx, k)) != 0
                return: 1
            if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 1U, %dU) != c.LMX_WALK_OK\n            return: 1\n", site, k) < 0
                return: 1
            ---
        if: l2_cf_get(idx, k) >= 0
            # The caller's resolved occurrence, not the descriptor of a
            # same-named unit method or the formal's signature anchor.
            if: l2_rw_callable_actual(a, span, site, @ arg) != 0 || l2_rw_put_actual(\out, site, arg0 + l2_bound_rank(bound, k), arg) != 0
                return: 1
            ---
        else:
            if: l2_nsty_get(idx, k) >= 0
                # D-105 slice 1: the actual's own named type (a root field of one), and whether the
                # input goes through the walker's ADMIT_AS (l2_rw_d105_need) -- then it is built into
                # that admission's slot 3, and the admission is the input.
                cand: 0 - 1
                occurrence: l2_occ_actual(l2_rw_mi, a, span)
                if: occurrence >= 0
                    cand: l2_schema_method(occurrence)
                if: occurrence < 0 && l2_empty_actual(a, idx, k) = 0 && l2_actual_ns(l2_rw_mi, a, span, l2_src, node, @ cand) = 1
                    return: 1
                if: occurrence < 0 && l2_empty_actual(a, idx, k) = 0 && span = 1 && a\value != 0 && a\value\kind = c.LM_P0_NODE_ATOM && a\value\as != 0
                    oi: l2_rw_find(a\value\as\atom)
                    if: oi >= 0 && l2_rw_seen(oi) != 0
                        cand: l2_own_nsty_get(oi)
                    ---
                ---
                if: l2_rw_d105_need(node, l2_call_receiver(idx, formal_call, hid), k, cand, @ need) != 0
                    return: 1
                holder: site
                l2_reference_source(a, span, l2_rw_mi, @ reference_source)
                if: occurrence >= 0
                    reference_source.schema: cand
                    reference_source.layout: cand
                    reference_source.method: -1
                    reference_source.place: -1
                ---
                if: need != 0 && l2_rw_admit_project(site, l2_nsty_get(l2_call_receiver(idx, formal_call, hid), k), @ reference_source, 0, -1, l2_call_receiver(idx, formal_call, hid), k, @ holder) != 0
                    return: 1
                if: l2_empty_actual(a, idx, k) != 0
                    if: l2_rw_empty_arg(l2_nsty_get(idx, k), holder, @ arg) != 0
                        return: 1
                    ---
                else:
                    if: occurrence >= 0
                        if: l2_rw_callable_actual(a, span, holder, @ arg) != 0
                            return: 1
                        ---
                    else:
                        if: l2_rw_struct_arg(node, a, span, l2_nsty_get(idx, k), (cast: (int) (need != 0)), holder, @ arg) != 0
                            return: 1
                        ---
                    ---
                ---
                if: need != 0
                    if: l2_rw_put(holder, 3, arg) != 0
                        return: 1
                    arg: holder
                ---
                if: l2_rw_put_actual(\out, site, arg0 + l2_bound_rank(bound, k), arg) != 0
                    return: 1
                ---
            else:
                if: guarded != 0
                    if: l2_rw_frame(site, "LMX_WALK_OP_GUARDED", 1, @ arg) != 0 || l2_rw_put_actual(\out, site, arg0 + l2_bound_rank(bound, k), arg) != 0
                        return: 1
                    ---
                else:
                    if: l2_rw_reference_receive(a, span, l2_own_ty_of_param(l2_input_ft(idx, k)), -1, site, @ arg) != 0 || l2_rw_put_actual(\out, site, arg0 + l2_bound_rank(bound, k), arg) != 0
                        return: 1
                    ---
                ---
            ---
        ---
        k: k + 1
        a: l2_skip_span(a, span)
    ---
    d: 0
    while: d < dynn
        # K04 S2 part two: an input the callable this site has does not need is handed absent -- no operand.
        sneed: l2_site_needs(l2_rw_mi, node, formal_call, hid, d, 0, 0, l2_src)
        if: sneed < 0
            return: 1
        if: sneed = 0
            d: d + 1
            continue
        ---
        # A3 with item 738: the host's own Structure handed to its nested method is admitted as the capture's type
        # itself -- the method reads it through that type's table (path kind 7) -- unless the host's formal is one a
        # call site fills by name (D-105): that value is admitted already, with its table.
        holder: \out
        if: l2_cap_arg_ns(hid, l2_m_arity[hid] + d) >= 0 && l2_cap_src_marked(l2_rw_mi, l2_dn(hid, d)) = 0 && l2_rw_admit_as(\out, l2_cap_arg_ns(hid, l2_m_arity[hid] + d), l2_cap_arg_ns(hid, l2_m_arity[hid] + d), @ holder) != 0
            return: 1
        hidden_model: l2_input_schema(hid, l2_m_arity[hid] + d)
        if: l2_cap_arg_ns(hid, l2_m_arity[hid] + d) < 0 && hidden_model != -1
            cand: l2_hidden_model_source(l2_rw_mi, hid, d, @ hidden_source)
            # An input the method has no declaration of in sight is admitted by the declaration its value
            # carries, among those the translation records as reaching it, and may be absent: the admitting
            # instruction takes both (LMX_WALK_OP_ADMIT_AS).  Any other value with no schema is admitted by
            # position.
            if: cand = -1 && l2_input_undeclared(l2_rw_mi, hidden_source) = 0 && (l2_d105_opaque_place(l2_rw_mi, hidden_source) = 0 || l2_d105_place_sources(l2_rw_mi, hidden_source) = 0)
                if: l2_rw_admit(\out, hidden_model, 0, l2_own_of_dt(l2_dt(hid, d)), @ holder) != 0
                    return: 1
                ---
            else:
                # Forwarding an already admitted input of this same model
                # preserves its existing correspondence, not an identity map.
                source_mi: -1
                if: hidden_source != -1
                    source_mi: l2_d105_key_method(l2_rw_mi, hidden_source)
                if: l2_rw_admit_source(\out, hidden_model, cand, source_mi, hidden_source, hid, l2_m_arity[hid] + d, @ holder) != 0
                    return: 1
                ---
            ---
        if: l2_rw_dyn_arg(node, hid, d, holder, @ arg) != 0
            return: 1
        # K04 S2: an input handed absent has no operand.
        if: arg < 0
            d: d + 1
            continue
        ---
        if: holder != \out
            if: l2_rw_put(holder, 3, arg) != 0
                return: 1
            arg: holder
        ---
        if: l2_rw_put(\out, arg0 + n + d, arg) != 0
            return: 1
        d: d + 1
    ---
return: 0

# An actual goes to its place among the call's operands: directly, or through the NAMED
# operand `site` that holds it as its payload.
fn: l2_rw_put_actual (int: call; int: site; int: place; int: arg) int
    if: site != call
        if: l2_rw_put(site, 2, arg) != 0
            return: 1
        return: l2_rw_put(call, place, site)
    ---
return: l2_rw_put(call, place, arg)

# A merge given as the actual of a callable formal, in the graph of the body that gives it: the step that builds
# its node (l2_rw_t7_build), the construction that body's native code calls (l2_t7_emit_actual).
fn: l2_rw_merge_actual (const: @(LmP0Node node); int: parent; @: int out) int
    int: s 0
    while: s < l2_t7_n
        if: l2_t7_kind[s] = 2 && l2_t7_at[s] = node && l2_t7_host[s] = l2_rw_mi
            return: l2_rw_t7_build(s, parent, out)
        s: s + 1
    ---
return: l2_rw_refuse(node, "an unresolved callable occurrence")

# Callable receiving contexts share the native resolver's exact occurrence
# classification. Nullary frames and paths do not execute here; a forwarded
# formal is the value the caller supplied, not a borrowed signature row.
fn: l2_rw_callable_actual (@: LmP0Field first; int: span; int: parent; @: int out) int
    int: kind 0
    int: formal 0 - 1
    int: candidate l2_cf_actual(l2_rw_mi, first, span, @ kind, @ formal)
    @: LmP0Text text 0
    LmP0Text: joined
    @: char buffer 0
    @: LmP0Field field
    int: i 0
    int: status
    size_t: capacity 1U
    size_t: top (cast: (size_t) -1)
    # K04 S3: a held name -- the node it holds; in a walked method the name is a hidden input (Q52).
    if: candidate < 0 && l2_cf_held(l2_rw_mi, first, span) >= 0
        formal: l2_cf_held(l2_rw_mi, first, span)
        if: l2_rw_mi != l2_e && l2_param_find(l2_rw_mi, l2_own_name[formal]) >= 0
            return: l2_rw_arg_fb(parent, l2_param_find(l2_rw_mi, l2_own_name[formal]), out)
        return: l2_rw_own(parent, formal, out)
    ---
    # K04 S3: a merge given as the actual, where the check made it a site (l2_t7_from_actual).
    if: candidate < 0 && span = 1 && first\value != 0 && l2_frame_head(first\value, "merge") != 0 && l2_t7_actual_model(l2_rw_mi, first\value) >= 0
        return: l2_rw_merge_actual(first\value, parent, out)
    if: candidate < 0 || candidate = l2_e
        return: l2_rw_refuse((first\value), "an unresolved callable occurrence")
    if: kind = 2
        return: l2_rw_arg_fb(parent, formal, out)
    if: span = 1 && first\value\kind = c.LM_P0_NODE_ATOM
        text: first\value\as\atom
    if: span = 1 && first\value\kind = c.LM_P0_NODE_FRAME
        text: first\value\as\frame\head
    # Use the selected path's physical leaf, not its static contract's unit
    # occurrence. Joined value spans share the existing path resolver.
    if: text != 0 && l2_rw_has_slash(text) != 0
        return: l2_rw_path_reference((first\value), text, parent, out)
    if: span > 1
        field: first
        while: field != 0 && i < span
            if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || field\value\as = 0 || field\value\as\atom = 0 || field\value\as\atom\length > top - capacity
                return: l2_rw_refuse((first\value), "this callable occurrence path")
            capacity: capacity + field\value\as\atom\length
            field: l2_next_active(field\next)
            i: i + 1
        ---
        buffer: (cast: (@: char) l2_xmalloc(capacity))
        if: buffer = 0
            return: l2_error(l2_src, first\value, "out of memory")
        joined.data: buffer
        joined.length: l2_join_path(first, span, buffer, capacity - 1U)
        status: 1
        if: joined.length != 0U
            status: l2_rw_path_reference((first\value), @ joined, parent, out)
        l2_xfree((cast: (@: void) buffer))
        return: status
    ---
    if: l2_rw_frame(parent, "LMX_WALK_OP_AT", 3, out) != 0 || l2_use_unit_child(1, candidate) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_entry_unit)) != 0 || lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %uU) != c.LMX_WALK_OK\n            return: 1\n", \out, \out, (cast: (unsigned) l2_occ_slot(candidate))) < 0
        return: 1
return: 0

# One dynamic input of callee idx, as one more argument of the call (after the declared
# formals). Same order as l2_hidden_from: the caller's formal, then the caller's own
# field, then the callee's lexical field. None of those is a third graph. A miss is the
# same located refusal the native call emits.
fn: l2_rw_dyn_arg (const: @(LmP0Node node); int: idx; int: k; int: parent; @: int out) int
    @: LmP0Text nm
    int: oty
    int: gr
    int: oi
    int: pi
    []: char msg 256
    if: idx < 0 || k < 0 || k >= l2_m_dyn[idx]
        return: 1
    nm: l2_dn(idx, k)
    oty: l2_own_of_dt(l2_dt(idx, k))
    # A3 with item 738: a Structure capture, from its host -- the host's input (ARG), or the Structure its own field
    # holds.
    if: l2_cap_arg_ns(idx, l2_m_arity[idx] + k) >= 0 && l2_mad_host_of(idx) = l2_rw_mi && l2_param_find(l2_rw_mi, nm) >= 0
        return: l2_rw_arg(parent, l2_param_find(l2_rw_mi, nm), out)
    if: l2_cap_arg_ns(idx, l2_m_arity[idx] + k) >= 0 && l2_mad_host_of(idx) = l2_rw_mi
        return: l2_rw_mad_host_struct(parent, l2_rw_mi, nm, out)
    # A number, or a graph reference -- a Structure, a held callable -- passed by reference as a Structure formal is.
    gr: (cast: (int) (l2_dt(idx, k) = l2_graph_dt()))
    if: l2_rw_num_ty(oty) = 0 && l2_own_is_pointer(oty) = 0 && gr = 0
        return: l2_rw_refuse(node, "a call with an input that is not a number")
    pi: l2_param_find(l2_rw_mi, nm)
    if: pi >= 0 && l2_rw_mi != l2_e
        oi: l2_rw_bound(nm)
        if: oi >= 0
            return: l2_rw_own(parent, oi, out)
        # K04 S2: the caller's own input.  One it only forwards goes on as it is, possibly absent; where the
        # callee cannot take it absent, the callee's lexical cell stands behind it (l2_rw_arg_lex).  One it
        # reads is its working value: where it arrived absent, its own lexical source (l2_rw_arg_fb).
        if: pi >= l2_m_arity[l2_rw_mi] && l2_dyn_fwd(l2_rw_mi, pi - l2_m_arity[l2_rw_mi]) != 0
            if: l2_hid_takes_absent(idx, k) != 0 || l2_own_lexical(idx, nm) < 0
                return: l2_rw_arg(parent, pi, out)
            return: l2_rw_arg_lex(node, parent, pi, idx, k, out)
        ---
        return: l2_rw_arg_fb(parent, pi, out)
    # The root has no ARG slot for an entry formal. Do not pass the callee's cell instead.
    if: pi >= 0 && l2_rw_mi = l2_e
        return: l2_rw_refuse(node, "a call of a method with dynamic inputs")
    oi: l2_own_visible(l2_rw_mi, nm)
    if: oi >= 0 && l2_m_uses[l2_own_off(l2_rw_mi, oi)] != 0 && (l2_rw_num_ty(l2_own_ty[oi]) != 0 || l2_own_is_pointer(l2_own_ty[oi]) != 0 || (gr != 0 && l2_own_is_slot(oi) != 0)) && (l2_own_uchild[oi] >= 0 || l2_rw_is_hosted(oi) != 0)
        return: l2_rw_own(parent, oi, out)
    # K04 S2: the caller has no binding of the name.  A callee that takes the input absent gets no operand:
    # the lexical source read is the reader's own.  \out is -1 then.
    if: l2_hid_takes_absent(idx, k) != 0
        \out: 0 - 1
        return: 0
    ---
return: l2_rw_lex_operand(node, idx, k, parent, out)

# The callee's lexical cell of its input k as an operand under parent: where the callee cannot take the input
# absent.
fn: l2_rw_lex_operand (const: @(LmP0Node node); int: idx; int: k; int: parent; @: int out) int
    @: LmP0Text nm
    int: gr
    int: oi
    if: idx < 0 || k < 0 || k >= l2_m_dyn[idx]
        return: 1
    nm: l2_dn(idx, k)
    gr: (cast: (int) (l2_dt(idx, k) = l2_graph_dt()))
    oi: l2_own_lexical(idx, nm)
    if: oi < 0
        if: nm = 0
            return: l2_error(l2_src, node, "unbound dynamic input")
        return: l2_error_name(l2_src, node, "unbound dynamic input ", nm\data, nm\length, "")
    if: l2_own_mi[oi] = idx && l2_own_uchild[oi] >= 0 && (l2_rw_num_ty(l2_own_ty[oi]) != 0 || l2_own_is_pointer(l2_own_ty[oi]) != 0 || (gr != 0 && l2_own_is_slot(oi) != 0))
        return: l2_rw_callee_at(parent, idx, oi, out)
    if: (l2_rw_num_ty(l2_own_ty[oi]) != 0 || l2_own_is_pointer(l2_own_ty[oi]) != 0 || (gr != 0 && l2_own_is_slot(oi) != 0)) && l2_own_uchild[oi] >= 0
        return: l2_rw_own(parent, oi, out)
return: l2_rw_refuse(node, "a call with an input that is not a number")

# The caller's forward-only input pi handed to a callee that cannot take it absent: [arg, pi, fallback], the
# fallback the callee's lexical cell.  Present, the entry is the value; absent, that cell is read.
fn: l2_rw_arg_lex (const: @(LmP0Node node); int: parent; int: pi; int: idx; int: k; @: int out) int
    int: fb
    if: l2_rw_frame(parent, "LMX_WALK_OP_ARG", 4, out) != 0 || l2_rw_input_witness(\out, 3, l2_rw_mi, pi) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 1U, %dU) != c.LMX_WALK_OK\n            return: 1\n", \out, l2_rw_arg_pos(pi)) < 0
        return: 1
    if: l2_rw_lex_operand(node, idx, k, \out, @ fb) != 0 || l2_rw_put(\out, 2, fb) != 0
        return: 1
return: 0

# AT of method idx's own field oi: the occurrence itself, not the unit.
fn: l2_rw_callee_at (int: parent; int: idx; int: oi; @: int out) int
    @: L2GraphField field l2_graph_field(oi)
    if: l2_rw_frame(parent, "LMX_WALK_OP_AT", 3, out) != 0
        return: 1
    # The callee's place is named from the unit (form 10, l2_use_cell_slots): a use, noted by its declaration in every
    # pass.
    if: l2_use_cell_note(10, oi) != 0
        return: 1
    if: l2_rw_emit = 0
        return: 0
    if: field = 0
        return: 1
    if: field\holder != 0
        if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) ", \out) < 0 || l2_emit_graph_build_place(field\holder, idx) != 0 || fputs(")) != 0\n            return: 1\n", l2_out) < 0
            return: 1
        ---
    else:
        if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) lmx_arena_ref_struct(l2_entry_unit, %uU))) != 0\n            return: 1\n", \out, (cast: (unsigned) l2_occ_slot(idx))) < 0
            return: 1
        ---
    ---
    if: c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %dU) != c.LMX_WALK_OK\n            return: 1\n", \out, l2_graph_field_child(oi)) < 0
        return: 1
return: 0

# A Structure argument by reference (FABLE-OPUS-ROOT-TAKE-20260925-179 commit 2): the actual is a
# root own field of the formal's own named Structure type `ni`, and the callee receives the
# Structure that field holds -- DEREF(AT(unit, its cell)), the same node, not a copy -- so a write
# through the formal is the caller's.  An actual of another type, or an untyped graph (a letter),
# is admitted first: the caller's implicit `implements` (D-55), not built here.
fn: l2_rw_struct_arg (const: @(LmP0Node node); @: LmP0Field a; int: span; int: ni; int: other_ok; int: parent; @: int out) int
    int: candidate
    int: status l2_actual_ns(l2_rw_mi, a, span, l2_src, node, @ candidate)
    int: ty l2_graph_own()
    if: status = 1
        return: 1
    if: candidate = -1 && span = 1 && a != 0 && a\value != 0 && a\value\kind = c.LM_P0_NODE_ATOM && a\value\as != 0
        candidate: l2_bound_nsty(l2_rw_mi, a\value\as\atom)
    # Known candidates use the correspondence already selected by the common
    # receiving contract. An unknown candidate is admitted by the admission that
    # forms this input (other_ok: the site's ADMIT_AS, by the Consumer's uses, as
    # the native text admits it -- l2_emit_model_admit); a second, whole-model
    # structural admission before it would refuse what that one admits. A letter
    # named here is received first all the same: the reception takes it as its
    # payload (D-57), as the native text does. Without that admission the
    # candidate keeps the ordinary structural admission.
    if: candidate = -1 && (other_ok = 0 || l2_is_letter_value(l2_rw_mi, a, span) != 0)
        return: l2_rw_reference_receive(a, span, ty, ni, parent, out)
    if: candidate != ni && other_ok = 0
        return: l2_rw_refuse(node, "an admission to a Structure type")
return: l2_rw_reference_value(a, span, ty, parent, out)

# Input j of the method being built, as its reads take it: a hidden input of a nested method -- which a returned
# node's call may leave absent, Reading 1 (Codex, 2026-09-28: the caller's binding first, the graph's value the
# fallback) -- is [arg, j, fallback]: a name of the host's body read through `node` (l2_rw_node_read), else the
# declaration of the unit field it names (Q52).  Any other input is [arg, j].
fn: l2_rw_arg_fb (int: parent; int: j; @: int out) int
    @: LmP0Text nm
    int: oi
    int: fb
    int: mode
    int: depth
    int: slot 0 - 1
    int: kind 0 - 1
    []: int ut 1
    []: int uv 1
    if: l2_rw_mi = l2_e || j < l2_m_arity[l2_rw_mi] || j >= l2_m_arity[l2_rw_mi] + l2_m_dyn[l2_rw_mi]
        return: l2_rw_arg(parent, j, out)
    if: l2_hid_source(l2_rw_mi, j - l2_m_arity[l2_rw_mi], 1, @ mode, @ depth, @ slot, @ kind, @ oi) != 0
        return: l2_rw_arg(parent, j, out)
    nm: l2_dn(l2_rw_mi, j - l2_m_arity[l2_rw_mi])
    if: l2_rw_frame(parent, "LMX_WALK_OP_ARG", 4, out) != 0 || l2_rw_input_witness(\out, 3, l2_rw_mi, j) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 1U, %dU) != c.LMX_WALK_OK\n            return: 1\n", \out, l2_rw_arg_pos(j)) < 0
        return: 1
    if: mode = 1
        if: slot < 0 && l2_construct_phase != 0
            return: l2_error(l2_src, l2_callable_source_node(l2_rw_mi), "internal: a hidden input has no completed source place")
        # The fallback reads the node's field by its name: a use of the home's node (l2_use_resolve).
        ut[0]: 6
        uv[0]: l2_rw_mi
        if: l2_use_note(1, ut, uv, 1, (cast: (@: char) nm\data), nm\length) != 0
            return: 1
        if: l2_rw_node_read(\out, slot, kind, @ fb) != 0 || l2_rw_put(\out, 2, fb) != 0
            return: 1
        return: 0
    ---
    if: mode = 2 && oi >= 0
        if: l2_rw_own(\out, oi, @ fb) != 0 || l2_rw_put(\out, 2, fb) != 0
            return: 1
    ---
return: 0

# The value field `slot` (path kind `kind`) of the running method's `node`: OF(NODE, slot) -- the cell of a number,
# the Structure a slot holds itself (kind 2) -- and, through a letter's payload (kind 3), the Structure it holds.
fn: l2_rw_node_read (int: parent; int: slot; int: kind; @: int out) int
    int: of
    int: nd
    int: holder parent
    if: l2_rw_frame(holder, "LMX_WALK_OP_OF", 3, @ of) != 0 || l2_rw_frame(of, "LMX_WALK_OP_NODE", 1, @ nd) != 0 || l2_rw_put(of, 1, nd) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %dU) != c.LMX_WALK_OK\n            return: 1\n", of, slot) < 0
        return: 1
    \out: of
return: 0

# The place, among the references a call hands, of input j of the method whose body is being built: j.  A
# merge builds a node of its own of its model's body (T7), and that node has its own contract: the formals
# the merge leaves unbound, in their order, then the model's hidden inputs, as in any callable's args part
# (l2_emit_parts).  The body reads each input at its place in the node's contract, never at the model's.  A
# formal the merge binds is no input of the node: -1.
fn: l2_rw_arg_pos (int: j) int
    int: site
    int: model
    if: l2_t7_walk = 0 || j < 0
        return: j
    site: l2_t7_walk - 1
    if: site < 0 || site >= l2_t7_n
        return: j
    model: l2_t7_model[site]
    if: j >= l2_m_arity[model]
        return: l2_t7_argc[site] + (j - l2_m_arity[model])
return: l2_t7_arg_of(l2_fn(model, j))

# Input j of the method being built (-193 T4a): [arg, j], the reference its caller passed (the
# walker's ARG reads f\args[j]).  In a merge's node a formal the merge binds is the field that holds its value.
fn: l2_rw_arg (int: parent; int: j; @: int out) int
    if: l2_t7_walk != 0 && j >= 0 && j < l2_m_arity[l2_rw_mi] && l2_t7_bound_slot(l2_fn(l2_rw_mi, j)) >= 0
        return: l2_rw_mad_at(parent, l2_t7_bound_slot(l2_fn(l2_rw_mi, j)), out)
    if: l2_rw_frame(parent, "LMX_WALK_OP_ARG", 4, out) != 0 || l2_rw_input_witness(\out, 3, l2_rw_mi, j) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 1U, %dU) != c.LMX_WALK_OK\n            return: 1\n", \out, l2_rw_arg_pos(j)) < 0
        return: 1
return: 0

# One operand of type ty (resolved by l2_rw_texpr): an atom, a call frame, or a parenthesized
# expression.
# Prefix indirection is a place selected from the held pointer value. The
# source binding and each closed pointee type are retained through the chain.
fn: l2_rw_indirect (const: @(LmP0Text base); int: levels; int: source_type; int: parent; @: int out) int
    int: oi
    int: pi
    int: ty source_type
    int: i 0
    int: child
    if: levels = 0
        oi: l2_resolved_own(l2_rw_mi, base)
        if: oi >= 0
            return: l2_rw_own(parent, oi, out)
        pi: l2_param_find(l2_rw_mi, base)
        if: pi >= 0
            return: l2_rw_arg_fb(parent, pi, out)
        if: l2_rw_machine_local(base, out) = 0
            return: 0
        return: l2_rw_refuse(0, "a dereference without a retained binding")
    while: i < levels
        ty: l2_indirect_type(ty)
        if: ty < 0
            return: 1
        i: i + 1
    if: l2_rw_frame(parent, "LMX_WALK_OP_DEREF", 3, out) != 0 || l2_rw_witness(\out, 2, l2_own_ty_of_param(ty), 0) != 0
        return: 1
    if: l2_rw_indirect(base, levels - 1, source_type, \out, @ child) != 0
        return: 1
return: l2_rw_put(\out, 1, child)

fn: l2_rw_deref_word (const: @(LmP0Text text); int: parent; @: int out) int
    LmP0Text: base
    int: levels
    int: result
    int: source_type
    if: l2_deref_word(text, l2_rw_mi, @ base, @ levels, @ result) != 0 || l2_colon_bound_ty(l2_rw_mi, @ base, @ source_type) != 0
        return: 1
return: l2_rw_indirect(@ base, levels, source_type, parent, out)

fn: l2_rw_indirect_span (@: L2ValueSpan operand; int: levels; int: source_type; int: parent; @: int out) int
    int: ty source_type
    int: i 0
    int: child
    if: levels = 0
        return: l2_rw_span(operand, l2_own_ty_of_param(source_type), parent, out)
    while: i < levels
        ty: l2_indirect_type(ty)
        if: ty < 0
            return: 1
        i: i + 1
    if: l2_rw_frame(parent, "LMX_WALK_OP_DEREF", 3, out) != 0 || l2_rw_witness(\out, 2, l2_own_ty_of_param(ty), 0) != 0 || l2_rw_indirect_span(operand, levels - 1, source_type, \out, @ child) != 0
        return: 1
return: l2_rw_put(\out, 1, child)

# The retained prefix sign: one operator with ONE operand, NEG for `-` and POS
# for `+`, at the operand's place in `parent`. Nothing else stands for it: no
# subtraction from a zero the source does not have, no signed literal made of
# an operator and its operand.
fn: l2_rw_prefix_node (int: sign; int: parent; @: int out) int
    if: sign = 1
        return: l2_rw_frame(parent, "LMX_WALK_OP_NEG", 2, out)
return: l2_rw_frame(parent, "LMX_WALK_OP_POS", 2, out)

# The type a prefix sign's operand is built with: its own static type `sub`,
# or, for a literal alone, the type `ty` of the place. 0 and \out_ty, or the
# refusal. A reference has no sign. A literal in a char's place would be
# promoted to int by the sign and stored back into the char: a conversion.
fn: l2_rw_prefix_operand_ty (const: @(LmP0Node at); int: opty; int: ty; @: int out_ty) int
    if: opty = 0 - 3
        return: l2_rw_refuse(at, "mixed numeric types (a conversion)")
    if: l2_oc_is_ref(opty) != 0
        return: l2_rw_refuse(at, "arithmetic on a reference")
    if: opty < 0
        if: ty = 1
            return: l2_rw_refuse(at, "mixed numeric types (a conversion)")
        if: l2_oc_is_ref(ty) != 0
            return: l2_rw_refuse(at, "arithmetic on a reference")
        opty: ty
    ---
    \out_ty: opty
return: 0

# A prefix sign and the fields after it, `- x`.
fn: l2_rw_prefix (@: L2ValueSpan span; @: L2ValueSpan operand; int: ty; int: parent; @: int out) int
    @: LmP0Field f l2_next_active(span\first)
    int: opty 0
    int: child
    if: l2_rw_prefix_operand_ty(operand\node, l2_rw_span_ty(operand), ty, @ opty) != 0
        return: 1
    if: l2_rw_prefix_node(l2_prefix_sign(f\value\as\atom), parent, out) != 0
        return: 1
    if: l2_rw_span(operand, opty, \out, @ child) != 0 || l2_rw_put(\out, 1, child) != 0
        return: 1
return: 0

# A prefix sign applied to a group, `-(a + b)`.
fn: l2_rw_prefix_group (const: @(LmP0Node node); int: ty; int: parent; @: int out) int
    @: LmP0Field first node\as\frame\body\first_field
    int: n l2_count_active(node\as\frame\body)
    int: opty 0
    int: child
    if: n < 1
        return: l2_rw_refuse(node, "an empty operand")
    if: l2_rw_prefix_operand_ty(node, l2_rw_fields_ty(first, n), ty, @ opty) != 0
        return: 1
    if: l2_rw_prefix_node(l2_prefix_frame(node), parent, out) != 0
        return: 1
    if: l2_rw_texpr(first, n, opty, \out, @ child) != 0 || l2_rw_put(\out, 1, child) != 0
        return: 1
return: 0

fn: l2_rw_operand (const: @(LmP0Node node); int: ty; int: parent; @: int out) int
    int: v 0
    size_t: eix 0U
    int: oi
    int: idx
    int: formal 0 - 1
    int: pmi 0 - 1
    int: neg 0
    size_t: mag 0U
    int: usuf 0
    @: LmP0Text t
    []: char ib_own 8
    L2Tx: ib_tx
    @: L2Tx ib @ ib_tx
    L2RawIndex: indexed
    l2_here_at_method(l2_rw_mi, node)
    if: node = 0
        return: l2_rw_refuse(node, "an empty operand")
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0 && node\as\structure != 0
        if: l2_count_active(node\as\structure) = 0
            return: l2_rw_refuse(node, "an empty operand")
        return: l2_rw_texpr(node\as\structure\first_field, l2_count_active(node\as\structure), ty, parent, out)
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0
        t: node\as\frame\head
        if: l2_prefix_frame(node) != 0
            return: l2_rw_prefix_group(node, ty, parent, out)
        if: l2_rw_external_head(t) != 0
            return: l2_rw_machine_application(node, parent, out)
        if: l2_text_eq(t, "sizeof") || l2_text_eq(t, "cast") || (t != 0 && t\length > 0U && (t\data[0] = 64 || t\data[0] = 92))
            return: l2_rw_source_node(node, parent, "LMX_WALK_OP_SOURCE_MACHINE", out)
        # The one resolution of the head (l2_call_head_method): a method by its name, a binding, a callable formal, or
        # a call through a path, `Holder\viaPath(4U)` (-196) -- the general path resolver gives the callable field's
        # method (kind 4, its occurrence -- a shared terminal, Q22 = II), called as that method is, on the occurrence
        # the path selects (l2_rw_call).
        idx: l2_call_head_method(l2_rw_mi, t, @ formal)
        if: idx >= 0 && idx != l2_e
            if: node\as\frame\body = 0
                return: l2_rw_call(node, idx, formal, 0, parent, out)
            return: l2_rw_call(node, idx, formal, l2_call_actuals(node\as\frame\body), parent, out)
        if: l2_text_eq(t, "merge")
            return: l2_rw_refuse(node, "merge")
        if: l2_rw_has_slash(t) != 0
            return: l2_rw_refuse(node, "a field path")
        oi: l2_call_head_held(l2_rw_mi, t)
        if: oi >= 0
            return: l2_rw_mad_call(node, oi, parent, out)
        if: l2_text_eq(t, "length")
            return: l2_rw_length_of(node, parent, out)
        # `implements(candidate, required, consumer)` over descriptor names is decided when the
        # program is translated: l2_prep_implements' own answer, 1 or 0, as the native emission
        # writes it, is an int literal here (-176).
        if: l2_text_eq(t, "implements")
            if: l2_tx_open(ib, ib_own, 8U) != 0 || l2_prep_implements(node, ib) != 0
                return: 1
            return: l2_rw_lit(parent, (cast: (int) (ib\data[0] = 49)), out)
        return: l2_rw_refuse(node, "this operand")
    if: node\kind != c.LM_P0_NODE_ATOM || node\as = 0
        return: l2_rw_refuse(node, "this operand")
    t: node\as\atom
    # A held callable's bare name received as its result: its call, as `name()` is built.
    if: l2_held_result_site(node) != 0
        if: l2_call_head_held(l2_rw_mi, t) < 0
            return: l2_error(l2_src, node, "internal: a result site whose held callable is not selected at its emission")
        return: l2_rw_mad_call(node, l2_call_head_held(l2_rw_mi, t), parent, out)
    if: l2_raw_index_text(t, l2_rw_mi, @ indexed) = 0
        return: l2_rw_machine_index(@ indexed, 0, 0, parent, out)
    if: t != 0 && t\length > 0U && t\data[0] = 92
        return: l2_rw_deref_word(t, parent, out)
    if: l2_rw_num_lit(t, @ neg, @ mag, @ usuf) != 0
        return: l2_rw_tlit(node, parent, ty, neg, mag, usuf, out)
    if: t != 0 && t\length > 0U && t\data[0] >= 48 && t\data[0] <= 57
        return: l2_rw_refuse(node, "a literal that is not a decimal number")
    if: l2_rw_char_lit(t, @ v) != 0
        if: ty != 1 && ty != 0
            return: l2_rw_refuse(node, "mixed numeric types (a conversion)")
        return: l2_rw_clit(parent, v, out)
    # A string literal is a char Array value of its exact length. The graph
    # keeps that value at the operand's place. Its use where a raw character
    # pointer is consumed is a machine conversion with no interpreted
    # implementation, so the retained body stays native-only.
    if: t != 0 && t\length > 1U && t\data[0] = 34 && t\data[t\length - 1U] = 34
        l2_rw_machine: 1
        return: l2_rw_source_atom(t, parent, out)
    if: t != 0 && t\length > 0U && (t\data[0] = 34 || t\data[0] = 39)
        return: l2_rw_refuse(node, "a string or char literal")
    if: t != 0 && t\length > 0U && (t\data[0] = 64 || t\data[0] = 92)
        return: l2_rw_source_node(node, parent, "LMX_WALK_OP_SOURCE_MACHINE", out)
    if: t != 0 && t\length > 2U && t\data[0] = 99 && t\data[1] = 46
        return: l2_rw_source_node(node, parent, "LMX_WALK_OP_SOURCE_MACHINE", out)
    # An explicitly defined external constant has no L2 value cell. Retain
    # that source identity, without replacing a lexical binding or inventing
    # an interpreted value for the C expression.
    if: l2_colon_bound_ty(l2_rw_mi, t, @ v) != 0 && l2_define_name(t) != 0
        return: l2_rw_source_node(node, parent, "LMX_WALK_OP_SOURCE_MACHINE", out)
    # An activation-local machine value has no cell: its use borrows the leaf
    # of its own declaration.
    if: l2_rw_machine_local(t, out) = 0
        return: 0
    # A member path whose root is foreign C storage is retained with that
    # resolved root; it is not a graph field path.
    if: l2_rw_foreign_path(t) != 0
        return: l2_rw_machine_word(t, parent, out)
    if: l2_rw_has_slash(t) != 0
        # An element index is `[` after a name. `\[N]` is an occurrence, not an index.
        oi: 0
        idx: 0
        while: oi < (cast: (int) t\length)
            if: t\data[oi] = 91 && (oi = 0 || t\data[oi - 1] != 92)
                idx: 1
            oi: oi + 1
        ---
        if: idx != 0
            return: l2_rw_indexed_path(node, t, parent, out)
        return: l2_rw_path_read(node, t, parent, out)
    oi: l2_rw_elem_of(t, @ eix)
    if: oi >= 0
        return: l2_rw_elem(parent, oi, 0 - 1, eix, out)
    idx: l2_dyn_own_index(l2_rw_mi, t, @ oi, @ pmi)
    if: idx = 2
        return: l2_rw_refuse(node, "mixed numeric types (a conversion)")
    if: idx = 1
        return: l2_rw_elem(parent, oi, pmi, 0U, out)
    # A reference where a reference is asked (`m = 0`, -179): the field's pointer cell, as AT
    # gives it; the walker's EQ compares the address it holds.
    if: l2_oc_is_ref(ty) != 0
        oi: l2_rw_find(t)
        if: l2_rw_seen(oi) != 0 && (l2_rw_is_hosted(oi) != 0 || (l2_own_host[oi] = 0 && l2_own_fid[oi] < 0 && l2_own_uchild[oi] >= 0)) && l2_own_is_pointer(l2_own_ty[oi]) != 0
            return: l2_rw_own(parent, oi, out)
        ---
    ---
    # A formal of the method being built is its input j (-193 T4a): [arg, j], until its numeric
    # field's binding line (T4b class 2); from then on the name is that field.
    # T7 walks the model with the binding in effect: a bound name is AT of its
    # field, a remaining formal is ARG of the declared header.
    if: l2_t7_walk != 0
        idx: l2_t7_bound_slot(t)
        if: idx >= 0
            return: l2_rw_mad_at(parent, idx, out)
        idx: l2_t7_arg_of(t)
        if: idx >= 0 && l2_formal_find(l2_rw_mi, t) >= 0
            return: l2_rw_arg(parent, l2_formal_find(l2_rw_mi, t), out)
        ---
    # Item 738: a captured Structure is read through its fields -- used whole, the node's copy (the fields read, through
    # its table) would travel where its type's own layout is read.
    if: l2_rw_mi != l2_e && l2_cap_arg_ns(l2_rw_mi, l2_param_find(l2_rw_mi, t)) >= 0
        return: l2_rw_refuse(node, "a captured Structure used whole (item 738: its fields are read)")
    if: l2_rw_mi != l2_e && l2_param_find(l2_rw_mi, t) >= 0
        oi: l2_rw_bound(t)
        if: oi >= 0
            return: l2_rw_own(parent, oi, out)
        if: l2_head_is_callable_formal(l2_rw_mi, t) != 0
            idx: l2_call_head_method(l2_rw_mi, t, @ formal)
            return: l2_rw_call(node, idx, formal, 0, parent, out)
        return: l2_rw_arg_fb(parent, l2_param_find(l2_rw_mi, t), out)
    # K03 NS-ROLES-1b: a binding `b: tick` named alone is tick's call with no actuals (l2_rw_call: EXEC on the occurrence
    # b holds).
    if: l2_call_alias_own(l2_rw_mi, t) >= 0
        return: l2_rw_call(node, l2_rb_meth_of(l2_own_decl[l2_call_alias_own(l2_rw_mi, t)]), -1, 0, parent, out)
    oi: l2_rw_own_row(node, t)
    if: oi = 0 - 1
        return: 1
    if: oi >= 0
        return: l2_rw_own(parent, oi, out)
    idx: l2_site_method(l2_rw_mi, t)
    if: idx >= 0 && idx != l2_e
        return: l2_rw_call(node, idx, -1, 0, parent, out)
    if: l2_text_eq(t, "mainArgs")
        return: l2_rw_refuse(node, "mainArgs")
    if: l2_ns_find(t) >= 0
        return: l2_rw_refuse(node, "a Structure value")
return: l2_rw_refuse(node, "this operand")

# The precedence of a binary operator: 1 || , 2 && , 3 = != , 4 < > <= >= , 5 + - , 6 * / % .
fn: l2_rw_prec (const: @(LmP0Text t)) int
    if: l2_text_eq(t, "||")
        return: 1
    if: l2_text_eq(t, "&&")
        return: 2
    if: l2_text_eq(t, "=") || l2_text_eq(t, "!=")
        return: 3
    if: l2_text_eq(t, "<") || l2_text_eq(t, ">") || l2_text_eq(t, "<=") || l2_text_eq(t, ">=")
        return: 4
    if: l2_text_eq(t, "+") || l2_text_eq(t, "-")
        return: 5
    if: l2_text_eq(t, "*") || l2_text_eq(t, "/") || l2_text_eq(t, "%")
        return: 6
return: 0

# A plain Structure of n slots under container `parent` -- a body, or the holder of a value.
fn: l2_rw_plain (int: parent; int: n; @: int out) int
    []: char pn 32
    \out: l2_rw_t
    l2_rw_t: l2_rw_t + 1
    if: l2_construct_temp(\out, parent, 0) != 0
        return: 1
    if: l2_rw_emit = 0
        return: 0
    l2_rw_name(parent, pn)
return: (cast: (int) (c.fprintf(l2_out, "        @: Lmx l2_rw%d lmx_walk_plain(l2_program_arena, %s, %dU)\n        if: l2_rw%d = 0\n            return: 1\n", \out, pn, n, \out) < 0))

# The static type of one side of `&&` / `||`, normalized as a comparison's operands are (a bare
# literal is an int, one with `U` an unsigned); -9 for a reference, which is not a condition here.
fn: l2_rw_sc_ty (@: L2ValueSpan tok; int: lo; int: hi) int
    int: ty
    ty: l2_rw_tyof(tok, lo, hi)
    if: ty = 0 - 1
        return: 0
    if: ty = 0 - 2
        return: 3
    if: l2_oc_is_ref(ty) != 0
        return: 0 - 9
return: ty

# `a && b` / `a || b` in the walk (-196): the walker's AND / OR (OPUS-WALKLOOP-20260929-11), one value, short-circuit
# -- b is evaluated only when a does not decide.  (The value used to be a flag cell written by a flag STEP the statement
# ran first; a loop re-ran it at the end of its body, so a `continue` left the condition stale: `while: i < 5 && n <
# 100` with a continue gave 10, natively 5.)  andp is the operator's precedence: 2 &&, 1 ||.
fn: l2_rw_sc (@: L2ValueSpan tok; int: lo; int: best; int: hi; int: andp; int: parent; @: int out) int
    int: a
    int: b
    int: aty
    int: bty
    aty: l2_rw_sc_ty(tok, lo, best - 1)
    bty: l2_rw_sc_ty(tok, best + 1, hi)
    if: aty = 0 - 3 || bty = 0 - 3
        return: l2_rw_refuse(l2_span_node(tok, best), "mixed numeric types (a conversion)")
    if: aty = 0 - 9 || bty = 0 - 9
        return: l2_rw_refuse(l2_span_node(tok, best), "a reference as a condition of && or ||")
    if: andp = 2 && l2_rw_frame(parent, "LMX_WALK_OP_AND", 3, out) != 0
        return: 1
    if: andp = 1 && l2_rw_frame(parent, "LMX_WALK_OP_OR", 3, out) != 0
        return: 1
    if: l2_rw_bin(tok, lo, best - 1, aty, \out, @ a) != 0 || l2_rw_put(\out, 1, a) != 0
        return: 1
    if: l2_rw_bin(tok, best + 1, hi, bty, \out, @ b) != 0 || l2_rw_put(\out, 2, b) != 0
        return: 1
return: 0

# Tokens lo..hi of type ty (operands at lo, lo + 2, ...; operators between), split by l2_rw_split.
fn: l2_rw_address (const: @(L2Address address); int: parent; @: int out) int
    int: value
    int: holder parent
    int: slot
    int: status
    @: char text
    LmP0Text: word
    []: int path_own 42
    @: int path 0
    if: address\descriptor = 0
        if: l2_rw_frame(parent, "LMX_WALK_OP_ADDRESS", 3, out) != 0 || l2_rw_witness(\out, 2, l2_own_ty_of_param(address\type), 0) != 0
            return: 1
        holder: \out
    ---
    if: address\kind = 1
        status: l2_rw_own(holder, address\index, @ value)
    else:
        if: address\kind = 2
            status: l2_rw_arg_fb(holder, address\index, @ value)
        else:
            if: address\kind = 5
                slot: l2_ns_unit_slot(address\index)
                if: l2_ns_eternal[address\index] >= 0
                    slot: l2_ebr_unit_slot(l2_ns_eternal[address\index])
                if: l2_rw_frame(holder, "LMX_WALK_OP_AT", 3, @ value) != 0 || l2_use_unit_child(3, address\index) != 0
                    return: 1
                status: (cast: (int) (l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_entry_unit)) != 0 || lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %dU) != c.LMX_WALK_OK\n            return: 1\n", value, value, slot) < 0))
            else:
                if: address\kind != 6
                    return: l2_rw_refuse(0, "an address without a retained declared place")
                text: l2_address_path_text(address\target, address\target_count)
                if: text = 0
                    return: 1
                word.data: text
                word.length: strlen(text)
                path: l2_rw_path_room(@ word, path_own, 42)
                status: l2_rw_path(l2_next_active(address\target)\value, @ word, 1, path)
                if: status = 0
                    status: l2_rw_path_value(path, path[2], holder, @ value)
                l2_xfree(text)
            ---
        ---
    ---
    if: status != 0
        return: status
    if: address\descriptor = 0
        return: l2_rw_put(\out, 1, value)
    \out: value
return: 0

fn: l2_rw_indexed (const: @(L2IndexedOperand indexed); int: parent; @: int out) int
    int: holder parent
    int: value
    int: array
    int: index
    if: indexed\address != 0
        if: l2_rw_frame(parent, "LMX_WALK_OP_ADDRESS", 3, out) != 0 || l2_rw_witness(\out, 2, l2_own_ty_of_param(indexed\type), 0) != 0
            return: 1
        holder: \out
    ---
    if: l2_rw_frame(holder, "LMX_WALK_OP_ELEM", 3, @ value) != 0 || l2_rw_own(value, indexed\own, @ array) != 0 || l2_rw_put(value, 1, array) != 0
        return: 1
    if: indexed\index != 0
        if: l2_rw_operand(indexed\index, 2, value, @ index) != 0 || l2_rw_put(value, 2, index) != 0
            return: 1
        ---
    else:
        if: indexed\dynamic >= 0
            if: l2_rw_own(value, indexed\dynamic, @ index) != 0 || l2_rw_put(value, 2, index) != 0
                return: 1
            ---
        else:
            if: l2_rw_size_index(value, indexed\literal) != 0
                return: 1
            ---
        ---
    ---
    if: indexed\address != 0
        return: l2_rw_put(\out, 1, value)
    \out: value
return: 0

# Resolve only this borrowed operand. Typing and emission use the same ordinary
# address/index projections, and evaluation occurs only in the emitted child.
fn: l2_rw_span (@: L2ValueSpan span; int: ty; int: parent; @: int out) int
    L2ValueSpan: operand
    int: levels
    int: source_type
    int: result_type
    L2Address: address
    L2IndexedOperand: indexed
    L2RawIndex: raw_index
    L2ArrayPlace: array_place
    @: char text
    LmP0Text: word
    int: status
    int: own
    @: LmP0Node name
    if: l2_prefix_rest(span, @ operand) = 0
        return: l2_rw_prefix(span, @ operand, ty, parent, out)
    own: l2_operand_occurrence(span\first, span\count, l2_rw_mi, @ name)
    if: own != -2
        if: own < 0
            return: l2_error(l2_src, name, "no such occurrence")
        return: l2_rw_own(parent, own, out)
    if: l2_indirect_span(span, l2_rw_mi, @ operand, @ levels, @ source_type, @ result_type) = 0
        return: l2_rw_indirect_span(@ operand, levels, source_type, parent, out)
    status: l2_array_span(span\first, span\count, l2_rw_mi, @ array_place)
    if: status = 3
        return: 1
    if: status = 0
        if: array_place.count = span\count
            status: l2_rw_array_place_operand(span\node, @ array_place, "LMX_WALK_OP_ELEM", 3, parent, out)
            l2_array_place_release(@ array_place)
            return: status
        ---
        l2_array_place_release(@ array_place)
    ---
    if: l2_indexed_operand(span\first, span\count, l2_rw_mi, @ indexed) = 0 && indexed.count = span\count
        return: l2_rw_indexed(@ indexed, parent, out)
    if: l2_raw_index_span(span, l2_rw_mi, @ raw_index) = 0
        return: l2_rw_machine_index(@ raw_index, 0, 0, parent, out)
    # `@ p[i]`: the address of a raw element. The written address operator
    # keeps the machine index as its one operand; nothing is read.
    if: l2_rw_address_rest(span, @ operand) = 0 && l2_raw_index_span(@ operand, l2_rw_mi, @ raw_index) = 0
        if: l2_rw_machine_operator(l2_next_active(span\first)\value\as\atom, 1, parent, out, @ own) != 0
            return: 1
        if: l2_rw_machine_index(@ raw_index, 0, 0, own, @ status) != 0
            return: 1
        return: l2_rw_put(own, 0, status)
    # `@ P[i]`: the address of an element of an Array place reached by a path.
    if: l2_rw_address_rest(span, @ operand) = 0
        status: l2_array_span((operand.first), (operand.count), l2_rw_mi, @ array_place)
        if: status = 3
            return: 1
        if: status = 0
            if: array_place.count = operand.count
                status: l2_rw_array_place_address((operand.node), @ array_place, parent, out)
                l2_array_place_release(@ array_place)
                return: status
            ---
            l2_array_place_release(@ array_place)
        ---
    ---
    if: l2_address_operand(span\first, span\count, l2_rw_mi, @ address) = 0
        return: l2_rw_address(@ address, parent, out)
    if: span\count = 1
        if: span\node != 0 && span\node\kind = c.LM_P0_NODE_ATOM && span\node\as != 0
            own: l2_resolved_own(l2_rw_mi, span\node\as\atom)
            if: own >= 0 && l2_own_is_array(l2_own_ty[own]) != 0
                return: l2_rw_own(parent, own, out)
            ---
        ---
        return: l2_rw_operand(span\node, ty, parent, out)
    ---
    text: l2_address_path_text(span\first, span\count)
    if: text = 0
        return: l2_rw_refuse(span\node, "this operand")
    word.data: text
    word.length: strlen(text)
    # K03 S6: a path that selects a callable is its nullary call on the occurrence the path selects: the path is the
    # call's written head and the selector l2_rw_call_path reads (l2_rw_call_at).
    own: l2_path_callee(l2_rw_mi, @ word)
    if: own >= 0
        if: l2_m_ret[own] = 8
            status: l2_rw_path_reference(span\node, @ word, parent, out)
        else:
            status: l2_rw_call_at(span\node, @ word, own, 0 - 1, 0, parent, out)
        ---
        l2_xfree(text)
        return: status
    # A member path rooted at foreign C storage keeps its resolved root; it
    # is native-only source, not a graph field read.
    if: l2_rw_foreign_path(@ word) != 0
        status: l2_rw_machine_word(@ word, parent, out)
    else:
        # Where a reference is received a path may end at a Structure field: the value is
        # that Structure. A number is never read from one (l2_rw_path_read).
        if: l2_own_is_pointer(ty) != 0
            status: l2_rw_path_reference(span\node, @ word, parent, out)
        else:
            status: l2_rw_path_read(span\node, @ word, parent, out)
        ---
    ---
    l2_xfree(text)
return: status

# Tokens lo..hi of type ty, split by the same precedence relation.
# + and - take ty for both operands; a comparison is an int whose operands have their own one
# type, resolved here (a literal alone is an int, with a `U` an unsigned).
fn: l2_rw_bin (@: L2ValueSpan tok; int: lo; int: hi; int: ty; int: parent; @: int out) int
    int: best
    int: bestp
    int: ot
    int: node
    int: inner
    int: one
    int: left
    int: right
    int: left_ty
    int: right_ty
    @: LmP0Text op
    const: @(char code) 0
    int: swap 0
    int: negate 0
    if: lo = hi
        return: l2_rw_span(tok + lo, ty, parent, out)
    best: l2_rw_split(tok, lo, hi)
    bestp: l2_rw_prec(l2_span_node(tok, best)\as\atom)
    ot: ty
    left_ty: ty
    right_ty: ty
    if: bestp = 3 || bestp = 4
        left_ty: l2_rw_tyof(tok, lo, best - 1)
        right_ty: l2_rw_tyof(tok, best + 1, hi)
        ot: l2_rw_unify(left_ty, right_ty)
        if: bestp = 3 && l2_own_is_pointer(left_ty) != 0 && l2_own_is_pointer(right_ty) != 0
            ot: left_ty
        if: ot = 0 - 3
            return: l2_rw_refuse(l2_span_node(tok, best), "mixed numeric types (a conversion)")
        if: ot = 0 - 1
            ot: 0
        if: ot = 0 - 2
            ot: 3
        # References are equal or not (-179): the walker's EQ over pointer cells has no order.
        if: l2_oc_is_ref(ot) != 0 && bestp = 4
            return: l2_rw_refuse(l2_span_node(tok, best), "a reference compared by order")
    ---
    if: bestp != 3 || l2_own_is_pointer(left_ty) = 0 || l2_own_is_pointer(right_ty) = 0
        left_ty: ot
        right_ty: ot
    # `+` or `-` whose result is a reference is C address arithmetic.
    if: bestp = 5 && l2_oc_is_ref(ty) != 0
        return: l2_rw_machine_offset(tok, lo, best, hi, parent, out)
    op: l2_span_node(tok, best)\as\atom
    if: bestp = 1 || bestp = 2
        return: l2_rw_sc(tok, lo, best, hi, bestp, parent, out)
    # `* / %` (-183 commit 2; Grok -170 c1): MUL, DIV, MOD over one type, as + and - are -- an int
    # divides as C does (-7 / 2 is -3), an unsigned one unsigned. Construction
    # retains both operands even if executing this expression would fail; a
    # literal divisor and a computed divisor have the same runtime contract.
    if: bestp = 6
        if: l2_oc_is_ref(ty) != 0
            return: l2_rw_refuse(l2_span_node(tok, best), "arithmetic on a reference")
        if: l2_text_eq(op, "*")
            code: "LMX_WALK_OP_MUL"
        if: l2_text_eq(op, "/")
            code: "LMX_WALK_OP_DIV"
        if: l2_text_eq(op, "%")
            code: "LMX_WALK_OP_MOD"
    ---
    if: l2_text_eq(op, "+")
        code: "LMX_WALK_OP_ADD"
    if: l2_text_eq(op, "-")
        code: "LMX_WALK_OP_SUB"
    if: l2_text_eq(op, "<")
        code: "LMX_WALK_OP_LT"
    if: l2_text_eq(op, "=")
        code: "LMX_WALK_OP_EQ"
    if: l2_text_eq(op, ">")
        code: "LMX_WALK_OP_LT"
        swap: 1
    ---
    if: l2_text_eq(op, "!=")
        code: "LMX_WALK_OP_EQ"
        negate: 1
    ---
    if: l2_text_eq(op, "<=")
        code: "LMX_WALK_OP_LT"
        swap: 1
        negate: 1
    ---
    if: l2_text_eq(op, ">=")
        code: "LMX_WALK_OP_LT"
        negate: 1
    ---
    if: code = 0
        return: l2_rw_refuse(l2_span_node(tok, best), "this operator")
    # a != b is 1 - (a = b); a <= b is 1 - (b < a); a >= b is 1 - (a < b); a > b is b < a.
    if: negate != 0
        if: l2_rw_frame(parent, "LMX_WALK_OP_SUB", 3, out) != 0 || l2_rw_lit(\out, 1, @ one) != 0 || l2_rw_put(\out, 1, one) != 0
            return: 1
        if: l2_rw_frame(\out, code, 3, @ inner) != 0 || l2_rw_put(\out, 2, inner) != 0
            return: 1
        node: inner
    else:
        if: l2_rw_frame(parent, code, 3, out) != 0
            return: 1
        node: \out
    ---
    if: l2_rw_bin(tok, lo, best - 1, left_ty, node, @ left) != 0 || l2_rw_bin(tok, best + 1, hi, right_ty, node, @ right) != 0
        return: 1
    if: swap = 0 && (l2_rw_put(node, 1, left) != 0 || l2_rw_put(node, 2, right) != 0)
        return: 1
    if: swap != 0 && (l2_rw_put(node, 1, right) != 0 || l2_rw_put(node, 2, left) != 0)
        return: 1
return: 0

# An expression given as the run of n fields from `field`, in a place that asks no type (a
# condition, an expression statement): its own.
fn: l2_rw_expr (@: LmP0Field field; int: n; int: parent; @: int out) int
return: l2_rw_texpr(field, n, 0 - 1, parent, out)

# An expression given as the run of n fields from `field`, in a place that asks type `want` (a
# field's, a formal's, a message field's), or -1: its static type (l2_rw_tyof) must be that one,
# and a literal alone takes it.
fn: l2_rw_texpr (@: LmP0Field field; int: n; int: want; int: parent; @: int out) int
    @: L2ValueSpan tok
    @: LmP0Node at 0
    @: LmP0Field f l2_next_active(field)
    int: m
    int: ty
    int: result
    if: f != 0
        at: f\value
    # A number place: the bare name of a held callable is received as its result.
    if: want >= 0 && l2_held_result_receive(l2_rw_mi, field, n, l2_rw_num_ty(want), l2_src) != 0
        return: 1
    tok: l2_value_spans(field, n, @ m)
    if: tok = 0
        return: l2_rw_refuse(at, "this expression")
    l2_rw_mix_at: 0
    ty: l2_rw_tyof(tok, 0, m - 1)
    if: ty = 0 - 3
        l2_xfree((cast: (@: void) tok))
        return: l2_rw_refuse(l2_rw_mix_at, "mixed numeric types (a conversion)")
    if: l2_oc_is_ref(ty) != 0 && want >= 0 && l2_own_is_pointer(want) = 0
        l2_xfree((cast: (@: void) tok))
        return: l2_rw_refuse(at, "a reference where a number is asked")
    if: want >= 0
        if: ty >= 0 && ty != want && (l2_own_is_pointer(ty) = 0 || l2_own_is_pointer(want) = 0)
            l2_xfree((cast: (@: void) tok))
            if: l2_rw_mi >= 0
                return: l2_rw_convert(field, n, ty, want, at, parent, out)
            return: l2_rw_refuse(at, "mixed numeric types (a conversion)")
        ---
        ty: want
    ---
    if: ty = 0 - 1
        ty: 0
    if: ty = 0 - 2
        ty: 3
    result: l2_rw_bin(tok, 0, m - 1, ty, parent, out)
    l2_xfree((cast: (@: void) tok))
return: result

# The steps a statement list builds (the count pass), without emitting anything.
fn: l2_rw_count (@: LmP0Field first) int
    int: save l2_rw_emit
    int: save_n l2_rw_bseq_n
    int: made 0
    int: bad 0
    int: i 0
    @: int snap 0
    # The count walk is a second pass over the same statements (emit calls it before
    # writing). Binding marks it sets must not stick, or the emit walk would see a
    # field as already bound on its binding line.
    if: l2_rw_bseq != 0 && l2_own_n > 0
        snap: (cast: (@: int) calloc((cast: (size_t) l2_own_n), c.sizeof(c.int)))
        if: snap = 0
            return: 0 - 1
        while: i < l2_own_n
            snap[i]: l2_rw_bseq[i]
            i: i + 1
        ---
    ---
    l2_rw_emit: 0
    if: l2_rw_stmts(first, 0 - 2, 0, 0, @ made) != 0
        bad: 1
    ---
    if: snap != 0
        i: 0
        while: i < l2_own_n
            l2_rw_bseq[i]: snap[i]
            i: i + 1
        ---
        free((cast: (@: void) snap))
    ---
    l2_rw_bseq_n: save_n
    l2_rw_emit: save
    if: bad != 0
        return: 0 - 1
return: made

# The send sites' memory beyond the unit's places.
fn: l2_msend_free () int
    l2_xfree((cast: (@: void) l2_msend_at))
    l2_xfree((cast: (@: void) l2_msend_owner))
    l2_xfree((cast: (@: void) l2_msend_inputs))
    l2_xfree((cast: (@: void) l2_msend_count))
    l2_xfree((cast: (@: void) l2_msend_off))
    l2_xfree((cast: (@: void) l2_msend_has_ref))
return: 0

# Room for one more send site (SEND-SITE-ARTIFICIAL-CAPS): the unit's 64 places while they suffice, then memory of
# twice the sites, the sites kept.  0, or 1 out of memory.
fn: l2_msend_room () int
    @@: LmP0Node at
    @: int ow
    @: int ip
    @: int co
    @: int of
    @: int hr
    int: cap
    size_t: psz
    size_t: isz
    size_t: ok 1U
    if: l2_msend_cap = 0
        l2_msend_at: (cast: (@@: LmP0Node) l2_msend_at_own)
        l2_msend_owner: l2_msend_owner_own
        l2_msend_inputs: l2_msend_inputs_own
        l2_msend_count: l2_msend_count_own
        l2_msend_off: l2_msend_off_own
        l2_msend_has_ref: l2_msend_has_ref_own
        l2_msend_cap: 64
    if: l2_msend_n < l2_msend_cap
        return: 0
    if: l2_msend_cap > c.INT_MAX / 2
        return: 1
    cap: l2_msend_cap * 2
    psz: c.sizeof(@: void)
    isz: c.sizeof(c.int)
    at: (cast: (@@: LmP0Node) l2_xmalloc((cast: (size_t) cap) * psz))
    ow: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * isz))
    ip: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * isz))
    co: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * isz))
    of: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * isz))
    hr: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * isz))
    if: at = 0 || ow = 0 || ip = 0 || co = 0 || of = 0 || hr = 0
        ok: 0U
    if: ok = 0U
        l2_xfree((cast: (@: void) at))
        l2_xfree((cast: (@: void) ow))
        l2_xfree((cast: (@: void) ip))
        l2_xfree((cast: (@: void) co))
        l2_xfree((cast: (@: void) of))
        l2_xfree((cast: (@: void) hr))
        return: 1
    memcpy((cast: (@: void) at), (cast: (@: void) l2_msend_at), (cast: (size_t) l2_msend_n) * psz)
    memcpy((cast: (@: void) ow), (cast: (@: void) l2_msend_owner), (cast: (size_t) l2_msend_n) * isz)
    memcpy((cast: (@: void) ip), (cast: (@: void) l2_msend_inputs), (cast: (size_t) l2_msend_n) * isz)
    memcpy((cast: (@: void) co), (cast: (@: void) l2_msend_count), (cast: (size_t) l2_msend_n) * isz)
    memcpy((cast: (@: void) of), (cast: (@: void) l2_msend_off), (cast: (size_t) l2_msend_n) * isz)
    memcpy((cast: (@: void) hr), (cast: (@: void) l2_msend_has_ref), (cast: (size_t) l2_msend_n) * isz)
    if: l2_msend_cap > 64
        l2_msend_free()
    l2_msend_at: at
    l2_msend_owner: ow
    l2_msend_inputs: ip
    l2_msend_count: co
    l2_msend_off: of
    l2_msend_has_ref: hr
    l2_msend_cap: cap
return: 0

# Room for field `at` of the sites, the fields before it kept: the unit's 1024 places while they suffice, then
# memory of twice the fields.  0, or 1 out of memory.
fn: l2_msend_froom (int: at) int
    @: int ki
    @@: LmP0Text tx
    int: cap
    size_t: psz
    size_t: isz
    if: l2_msend_fcap = 0
        l2_msend_kind: l2_msend_kind_own
        l2_msend_text: (cast: (@@: LmP0Text) l2_msend_text_own)
        l2_msend_fcap: 1024
    if: at < l2_msend_fcap
        return: 0
    cap: l2_msend_fcap
    while: cap <= at
        if: cap > c.INT_MAX / 2
            return: 1
        cap: cap * 2
    psz: c.sizeof(@: void)
    isz: c.sizeof(c.int)
    ki: (cast: (@: int) l2_xmalloc((cast: (size_t) cap) * isz))
    tx: (cast: (@@: LmP0Text) l2_xmalloc((cast: (size_t) cap) * psz))
    if: ki = 0 || tx = 0
        l2_xfree((cast: (@: void) ki))
        l2_xfree((cast: (@: void) tx))
        return: 1
    memcpy((cast: (@: void) ki), (cast: (@: void) l2_msend_kind), (cast: (size_t) at) * isz)
    memcpy((cast: (@: void) tx), (cast: (@: void) l2_msend_text), (cast: (size_t) at) * psz)
    if: l2_msend_fcap > 1024
        l2_xfree((cast: (@: void) l2_msend_kind))
        l2_xfree((cast: (@: void) l2_msend_text))
    l2_msend_kind: ki
    l2_msend_text: tx
    l2_msend_fcap: cap
return: 0

# FABLE-SONNET-SEND-IN-METHODS-20260925-168 commit 2: `sendMessage: X` inside a method body --
# the same field shape l2_rw_send validates for the root (one Structure `Name(f: v; ...)`, fields
# `name: literal-or-int-expr`, as many as written, a text field is a quoted literal with no escape),
# recorded into the method-send arrays instead of a walker-op-tree.
# FABLE-SONNET-SEND-REF-20260925-172 commit 3: `sendMessage: Ref X` -- the message Structure is
# always the LAST active field of the statement's body; every field before it (there may be
# several -- a field path like `m\sender` is itself several sibling P0 fields, merged back into
# one expression only by l2_eval_fields/l2_rw_texpr's own tokenizer) is the Ref expression.  No
# field before the last means no Ref: the ordinary form, unchanged.
fn: l2_msend_register (const: @(LmP0Node stmt); const: @(char path); int: mi; @: int out_k; @: int out_ni) int
    @: LmP0Field f
    @: LmP0Field mf
    @: LmP0Field g
    @: LmP0Field b
    @: LmP0Node x
    @: LmP0Node v
    @: LmP0Text t
    int: k
    int: nf 0
    int: ni 0
    int: n
    int: total
    int: refn
    int: has_ref 0
    int: refty 0
    int: save_mi 0
    int: save_cur 0
    size_t: i
    \out_k: -1
    \out_ni: 0
    k: 0
    while: k < l2_msend_n
        if: l2_msend_at[k] = stmt && l2_msend_owner[k] = mi
            \out_k: k
            \out_ni: l2_msend_inputs[k]
            return: 0
        k: k + 1
    ---
    if: l2_count_active(l2_app_actuals(stmt)) = 0
        return: l2_error(path, stmt, "this sendMessage")
    ---
    f: l2_next_active(stmt\as\frame\body\first_field)
    total: l2_count_active(stmt\as\frame\body)
    refn: total - 1
    mf: f
    if: refn > 0
        mf: l2_skip_span(f, refn)
        has_ref: 1
    ---
    if: mf = 0
        return: l2_error(path, stmt, "this sendMessage")
    x: mf\value
    if: x = 0 || x\kind != c.LM_P0_NODE_FRAME || x\as = 0 || x\as\frame = 0 || x\as\frame\body = 0 || l2_ident(x\as\frame\head) = 0
        return: l2_error(path, stmt, "a message that is not one Structure")
    ---
    k: l2_msend_n
    if: l2_msend_room() != 0
        return: l2_alloc_or(path, stmt, "out of memory")
    l2_msend_has_ref[k]: has_ref
    if: has_ref != 0
        save_mi: l2_rw_mi
        save_cur: l2_cur_mi
        l2_rw_mi: mi
        l2_cur_mi: mi
        refty: l2_rw_fields_ty(f, refn)
        l2_rw_mi: save_mi
        l2_cur_mi: save_cur
        if: refty != l2_oc_pointer(l2_msg_ref_ty())
            if: l2_oc_is_ref(refty) = 0
                return: l2_error(path, f\value, "a Ref that is not a reference")
            return: l2_error(path, f\value, "a plain Message does not implement Thread")
        ---
        ---
    ---
    g: l2_next_active(x\as\frame\body\first_field)
    while: g != 0
        v: g\value
        if: v = 0 || v\kind != c.LM_P0_NODE_FRAME || v\as = 0 || v\as\frame = 0 || v\as\frame\body = 0 || l2_ident(v\as\frame\head) = 0
            return: l2_error(path, v, "a message field that is not `name: value`")
        ---
        if: l2_msend_froom(l2_msend_nfield + nf) != 0
            return: l2_alloc_or(path, v, "out of memory")
        n: l2_count_active(v\as\frame\body)
        b: l2_next_active(v\as\frame\body\first_field)
        t: 0
        if: n = 1 && b\value != 0 && b\value\kind = c.LM_P0_NODE_ATOM && b\value\as != 0
            t: b\value\as\atom
        ---
        if: t != 0 && t\length > 0U && t\data[0] = 34
            if: t\length < 2U || t\data[t\length - 1U] != 34
                return: l2_error(path, b\value, "this text")
            i: 1U
            while: i + 1U < t\length
                if: t\data[i] = 92 || t\data[i] = 34
                    return: l2_error(path, b\value, "a text with an escape in a message")
                i: i + 1U
            ---
            l2_msend_kind[l2_msend_nfield + nf]: 2
            l2_msend_text[l2_msend_nfield + nf]: t
        else:
            l2_msend_kind[l2_msend_nfield + nf]: 1
            l2_msend_text[l2_msend_nfield + nf]: 0
            ni: ni + 1
        ---
        nf: nf + 1
        g: l2_next_active(g\next)
    ---
    if: nf = 0
        return: l2_error(path, x, "an empty message")
    l2_msend_count[k]: nf
    l2_msend_off[k]: l2_msend_nfield
    l2_msend_nfield: l2_msend_nfield + nf
    l2_msend_at[k]: (cast: (@: LmP0Node) stmt)
    l2_msend_owner[k]: mi
    l2_msend_inputs[k]: ni
    if: k + 1 > l2_msend_n
        l2_msend_n: k + 1
    ---
    \out_k: k
    \out_ni: ni
return: 0

# `sendMessage: X` in the root (author 2026-09-24, LMX_blog/2026-09-24.md; K3 = a): X, one
# Structure `Name(f: v; ...)`, goes to the parent of the current Message -- for R0 the host -- as
# the letter (sender; X), an anonymous Structure whose field 0 is the sender's reference.  It goes
# through the service (lmx_service_post): the transport of a published outbox is kernel step K4.
# X's fields are positional (their names say what they are, the receiver admits by position): an
# int expression, walked into the primitive's inputs, or a text literal without escapes.  The step
# is a `prim` node whose record's fn is the generated l2_send<k> (l2_emit_send), which builds the
# letter in an arena of its own and posts it.
# `sendMessage: Ref X` (FABLE-SONNET-SEND-REF-20260925-172 commit 3): the message Structure is
# always the LAST active field of the statement's body; every field before it is the Ref
# expression, walked like any other operand (l2_rw_texpr already merges a field-path run such as
# `m\sender` -- itself several sibling P0 fields -- back into one expression; l2_rw_fields_ty gives
# its static type the same way).  Ref must resolve to a reference (>= 1000): the field's own
# pointer/reference value, exactly what AT gives a formal or local of that type.  It becomes the
# primitive's LAST input, after the payload's own int-expression inputs; l2_emit_send reads it as
# refs[nargs - 1] and posts there instead of to lmx_thread_parent(t).
fn: l2_rw_send (@: LmP0Node stmt; int: into; @: int out) int
    @: LmP0Field f
    @: LmP0Field mf
    @: LmP0Field g
    @: LmP0Field b
    @: LmP0Node x
    @: LmP0Node v
    int: k
    int: ni
    int: j 0
    int: n
    int: e
    int: refn
    int: has_ref
    int: refty 0
    int: contract
    int: inputs
    int: ci 0
    # Checking, native emission and graph emission share the same source site.
    if: l2_msend_register(stmt, l2_src, l2_rw_mi, @ k, @ ni) != 0
        return: 1
    f: l2_next_active(stmt\as\frame\body\first_field)
    refn: l2_count_active(stmt\as\frame\body) - 1
    mf: l2_skip_span(f, refn)
    x: mf\value
    has_ref: l2_msend_has_ref[k]
    if: has_ref != 0
        refty: l2_rw_fields_ty(f, refn)
    # The evaluated payload is published before the shared send primitive runs.
    if: l2_rw_frame(into, "LMX_WALK_OP_PRIM_PUB", 3 + ni + has_ref, out) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        @: LmxPrimitive l2_rwp%d (cast: (@: LmxPrimitive) lmx_arena_take(l2_program_arena, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))\n        if: l2_rwp%d = 0\n            return: 1\n        l2_rwp%d\\fn: l2_msend%d\n        l2_rwp%d\\signature: 0\n        l2_rwp%d\\owner: l2_entry_unit\n        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_rwp%d)) != 0\n            return: 1\n", \out, \out, \out, k, \out, \out, \out, \out) < 0
        return: 1
    ni: 0
    g: l2_next_active(x\as\frame\body\first_field)
    while: g != 0
        v: g\value
        n: l2_count_active(v\as\frame\body)
        b: l2_next_active(v\as\frame\body\first_field)
        if: l2_msend_kind[l2_msend_off[k] + j] = 1
            if: l2_rw_texpr(b, n, 0, \out, @ e) != 0 || l2_rw_put(\out, 3 + ni, e) != 0
                return: 1
            ni: ni + 1
        j: j + 1
        g: l2_next_active(g\next)
    ---
    if: has_ref != 0
        if: l2_rw_texpr(f, refn, refty, \out, @ e) != 0 || l2_rw_put(\out, 3 + ni, e) != 0
            return: 1
        ---
    ---
    if: l2_rw_contract(\out, ni + has_ref, 0 - 1, 0, @ contract, @ inputs) != 0
        return: 1
    while: ci < ni
        if: l2_rw_witness(inputs, ci, 0, 0) != 0
            return: 1
        ci: ci + 1
    ---
    if: has_ref != 0 && l2_rw_witness(inputs, ni, refty, 0) != 0
        return: 1
    if: l2_rw_primitive_contract(\out, contract) != 0
        return: 1
return: 0

# FABLE-SONNET-SEND-IN-METHODS-20260925-168 commit 2: `sendMessage: X` inside a method body --
# a direct native call of l2_msend<k> (l2_emit_send, prefix "l2_msend"), the same generated
# sender the root's own walker step calls through a prim record, no twin. Each int-typed field's
# value is evaluated the ordinary way (l2_eval_fields, exactly as any other native call's actual
# argument) into a local temp; refs[i] is just that temp's address (lmx_int_value_known is
# *(int*)cell, no boxing needed). A nonzero status is the same invariant-failure shape the root's
# own walker step would give a failed send -- there is no separate recoverable-failure route for
# this prim there either.
# FABLE-SONNET-SEND-REF-20260925-172 commit 3: `sendMessage: Ref X` -- the Ref expression (before
# the message, l2_msend_register already validated it), evaluated the same way (l2_eval_fields)
# and stored as the LAST refs[] slot, refs[ni]; l2_emit_send reads it there when its own
# has_ref_arr[k] says this site named one.
fn: l2_emit_msend (const: @(LmP0Node stmt); int: mi; const: @(char ind)) int
    @: LmP0Field f
    @: LmP0Field mf
    @: LmP0Field g
    @: LmP0Node v
    @: LmP0Node x
    int: k
    int: ni
    int: nf
    int: j
    int: ii
    int: total
    int: refn
    int: has_ref
    []: char tok_own 1024
    []: char reftok_own 1024
    L2Tx: tok_tx
    L2Tx: reftok_tx
    @: L2Tx tok @ tok_tx
    @: L2Tx reftok @ reftok_tx
    if: l2_msend_register(stmt, l2_src, mi, @ k, @ ni) != 0 || l2_tx_open(tok, tok_own, 1024U) != 0 || l2_tx_open(reftok, reftok_own, 1024U) != 0
        return: 1
    nf: l2_msend_count[k]
    has_ref: l2_msend_has_ref[k]
    if: c.fprintf(l2_out, "%s[]: @(void) l2_msr%d %d\n", ind, k, (cast: (int) (1 + ni + has_ref))) < 0
        return: 1
    f: l2_next_active(stmt\as\frame\body\first_field)
    total: l2_count_active(stmt\as\frame\body)
    refn: total - 1
    mf: f
    if: refn > 0
        mf: l2_skip_span(f, refn)
    ---
    x: mf\value
    g: l2_next_active(x\as\frame\body\first_field)
    j: 0
    ii: 0
    while: g != 0
        v: g\value
        if: l2_msend_kind[l2_msend_off[k] + j] = 1
            if: l2_eval_fields(l2_next_active(v\as\frame\body\first_field), l2_count_active(v\as\frame\body), mi, ind, tok) != 0
                return: 1
            # A copy into a named local first: l2_eval_fields's own token can be a bare literal
            # (e.g. "7"), and `@` needs an addressable variable, never a literal.
            if: c.fprintf(l2_out, "%sint: l2_msf%d_%d %s\n%sl2_msr%d[%d]: @ l2_msf%d_%d\n", ind, k, ii, tok\data, ind, k, ii, k, ii) < 0
                return: 1
            ii: ii + 1
        ---
        j: j + 1
        g: l2_next_active(g\next)
    ---
    if: has_ref != 0
        if: l2_eval_fields(f, refn, mi, ind, reftok) != 0
            return: 1
        if: c.fprintf(l2_out, "%s@: void l2_msref%d (cast: (@: void) (%s))\n%sl2_msr%d[%d]: (cast: (@: void) (@ l2_msref%d))\n", ind, k, reftok\data, ind, k, ni, k) < 0
            return: 1
        ---
    ---
    # §7b: a letter leaves the activation -- the letter's fields are evaluated above, and what is marked is published
    # before it is sent.
    if: l2_emit_publish(ind) != 0
        return: 1
    if: c.fprintf(l2_out, "%sif: l2_msend%d(0, l2_msr%d, %dU, 0, 0) != 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: sendMessage failed\\n\")\n%s    c.abort()\n%s---\n", ind, k, k, (ni + has_ref), ind, ind, ind) < 0
        return: 1
return: 0

# The primitive of send site k: it builds the letter (sender; payload) in an arena of its own and
# posts it through the current Message's service to its parent.  The payload is a Structure of the
# site's fields in order: an int cell from the next input, or a char Array holding the text
# (exact length, no NUL).  The letter's arena is the service's from the post on (attached to the
# receiver at its take); the record that describes it is this primitive's, and stays allocated.
# FABLE-SONNET-SEND-IN-METHODS-20260925-168 commit 2: parameterised (prefix, count/off/kind/text
# arrays) so a method-body send site and a root send site share this one emission path -- no
# twin -- while keeping their k-spaces (and so their generated function names) apart.
# FABLE-SONNET-SEND-REF-20260925-172 commit 3: has_ref_arr[k], 1 when the site named `sendMessage:
# Ref X` -- a STATIC, per-k fact, so which of the two lmx_service_post lines below this k's body
# gets is chosen here, at generation time, not by any runtime branch on dest (dest/out stay the
# walker's own step-destination pair, untouched, exactly as every other prim already treats them).
# The Ref value, when named, travels as the LAST of the caller's evaluated inputs -- refs[ni],
# after the payload's own ni int-expression inputs -- both call sites (l2_rw_send's PRIM, whose
# refs[] the walker itself evaluates one slot per primitive input; l2_emit_msend's direct call)
# already place it there.
fn: l2_emit_send (int: k; int: proto; @: char prefix; @: int count_arr; @: int off_arr; @: int kind_arr; @@: LmP0Text text_arr; @: int has_ref_arr) int
    int: j
    int: ni 0
    int: nf
    int: has_ref
    @: LmP0Text t
    nf: count_arr[k]
    has_ref: has_ref_arr[k]
    if: proto != 0
        return: (cast: (int) (c.fprintf(l2_out, "    fn: %s%d (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int\n", prefix, k) < 0))
    if: c.fprintf(l2_out, "fn: %s%d (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int\n", prefix, k) < 0
        return: 1
    if: fputs("    @: LmxThread t lmx_thread_current()\n    @: LmxArena a (cast: (@: LmxArena) calloc(1U, c.sizeof(c.LmxArena)))\n    @: LmxMsg m 0\n    @: Lmx g 0\n    @: Lmx p 0\n    @: void cell 0\n    @: VoidArray text 0\n    if: t = 0 || a = 0 || lmx_arena_open(a) != 0\n        l2_send_fail()\n", l2_out) < 0
        return: 1
    j: 0
    while: j < nf
        if: kind_arr[off_arr[k] + j] = 1
            ni: ni + 1
        ---
        j: j + 1
    ---
    if: c.fprintf(l2_out, "    if: nargs != %dU || (nargs != 0U && refs = 0)\n        l2_send_fail()\n    m: (cast: (@: LmxMsg) lmx_arena_take(a, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))\n    g: lmx_node_new_owned(a)\n    p: lmx_node_new_owned(a)\n    if: m = 0 || g = 0 || p = 0 || lmx_arena_refs_open_owned(a, g, 2U) != 0 || lmx_arena_refs_open_owned(a, p, %dU) != 0\n        l2_send_fail()\n", (ni + has_ref), nf) < 0
        return: 1
    ni: 0
    j: 0
    while: j < nf
        t: text_arr[off_arr[k] + j]
        if: kind_arr[off_arr[k] + j] = 1 && c.fprintf(l2_out, "    cell: lmx_int_new_owned(a)\n    if: cell = 0 || refs[%d] = 0 || lmx_int_store_known(cell, lmx_int_value_known(refs[%d])) != 0 || lmx_arena_ref_store(p, %dU, cell) != 0\n        l2_send_fail()\n", ni, ni, j) < 0
            return: 1
        if: kind_arr[off_arr[k] + j] = 1
            ni: ni + 1
        ---
        if: kind_arr[off_arr[k] + j] = 2 && c.fprintf(l2_out, "    text: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_CHAR, %uU, a)\n    if: text = 0 || lmx_arena_ref_store(p, %dU, (cast: (@: void) text)) != 0\n        l2_send_fail()\n", (cast: (unsigned) (t\length - 2U)), j) < 0
            return: 1
        if: kind_arr[off_arr[k] + j] = 2 && t\length > 2U && c.fprintf(l2_out, "    memcpy(text\\data, (cast: (@: void) %.*s), %uU)\n", (cast: (int) t\length), t\data, (cast: (unsigned) (t\length - 2U))) < 0
            return: 1
        j: j + 1
    ---
    # The sender slot is a pointer CELL holding the current Message's address, not the address
    # itself (FABLE-SONNET-SEND-REF-20260925-172 commit 4, author's Q26.2 ruling: a reference is a
    # reference TO a reference -- storing the raw address directly would make the sender a CHILD of
    # the letter, and its domain would then disagree with a receiving field's own prototype cell at
    # admission, D-56's real cause). Same cell type D-52's kind-10/11 cells get from
    # l2_ptr_cell_type (LMX_TYPE_MSG_REF) so a receiver's `m\sender` field agrees.
    if: c.fprintf(l2_out, "    cell: lmx_pointer_new_owned(c.LMX_TYPE_MSG_REF, a)\n    if: cell = 0 || lmx_pointer_store_known(cell, (cast: (@: void) lmx_thread_message(t))) != 0 || lmx_arena_ref_store(g, 0U, cell) != 0 || lmx_arena_ref_store(g, 1U, (cast: (@: void) p)) != 0\n        l2_send_fail()\n    m\\running: 1\n    m\\success: 0\n    m\\handoff_ready: 0\n    m\\graph: g\n") < 0
        return: 1
    if: has_ref != 0
        if: c.fprintf(l2_out, "    if: lmx_service_post(lmx_child_service(t), lmx_pointer_value_known(refs[%d]), m, a) != c.LMX_SERVICE_OK\n        l2_send_fail()\n    return: 0\n", ni) < 0
            return: 1
        ---
    else:
        if: fputs("    if: lmx_service_post(lmx_child_service(t), (cast: (@: void) lmx_thread_parent(t)), m, a) != c.LMX_SERVICE_OK\n        l2_send_fail()\n    return: 0\n", l2_out) < 0
            return: 1
        ---
    ---
return: (cast: (int) (c.fprintf(l2_out, "end: %s%d\n\n", prefix, k) < 0))

# `return: V` in the method being built (-193 T4a): [ret, V], V of the method's result type -- the
# type of its result cell (l2_ret_cell_ty).
fn: l2_rw_ret (@: LmP0Field first; int: n; int: into; @: int out) int
    int: v
    if: l2_rw_frame(into, "LMX_WALK_OP_RET", 2, out) != 0 || l2_rw_reference_receive(first, n, l2_ret_cell_ty(l2_rw_mi), l2_nsty_get(l2_rw_mi, -1), \out, @ v) != 0
        return: 1
return: l2_rw_put(\out, 1, v)

# Slot 3 of FOR node `node`: the step, a body of one step -- counter oi takes oi + 1 (dec: oi - 1), written as `i: i + 1`
# is (l2_rw_assign): its working value when it has one (SET, SET_OF), else its cell (PUT_OF for a nested body's field).
fn: l2_rw_for_step (int: node; int: oi; int: dec; @: int out) int
    int: body
    int: w
    int: vs 3
    int: sum
    int: own
    int: one
    if: l2_rw_plain(node, 1, @ body) != 0
        return: 1
    if: l2_rw_write(body, oi, "LMX_WALK_OP_PUT", @ w, @ vs) != 0
        return: 1
    if: dec = 0 && l2_rw_frame(w, "LMX_WALK_OP_ADD", 3, @ sum) != 0
        return: 1
    if: dec != 0 && l2_rw_frame(w, "LMX_WALK_OP_SUB", 3, @ sum) != 0
        return: 1
    if: l2_rw_own(sum, oi, @ own) != 0 || l2_rw_put(sum, 1, own) != 0 || l2_rw_lit(sum, 1, @ one) != 0 || l2_rw_put(sum, 2, one) != 0
        return: 1
    if: l2_rw_put(w, vs, sum) != 0 || l2_rw_put(body, 0, w) != 0
        return: 1
    \out: body
return: l2_rw_put(node, 3, body)

# Materialize an inert source container through its actual parent, retaining
# every field/span and every nested container. COUNT freezes its width; PLACE
# and FILL replay the same source, with one constructor and owning attachment.
fn: l2_rw_inert (@: LmP0Structure body; int: parent; @: int out) int
    @: L2SourceContainer row l2_source_container(body, 1)
    int: actual
    int: width 0
    if: row = 0
        return: l2_alloc_or(l2_src, 0, "internal: a source container has no committed producer")
    if: l2_source_fill(row) != 0
        return: 1
    if: l2_construct_phase != 0
        width: row\width
    if: l2_rw_plain(parent, width, out) != 0
        return: 1
    if: l2_construct_phase = 1
        row\temp: \out
    actual: l2_source_container_fields(body, -1, l2_construct_phase, \out)
    if: actual < 0
        return: l2_error(l2_src, 0, "internal: a retained source field changed between passes")
    if: l2_construct_phase = 0
        row\width: actual
    else:
        if: row\width != actual
            return: l2_error(l2_src, 0, "internal: a source container changed width between passes")
        ---
    ---
return: 0

# The single original-field/span traversal used by both committed producers.
# fid >= 0 identifies an already allocated GLOBAL object; fid < 0 is the
# actual source-owned constructor. Producer choice changes construction, not
# source syntax, nesting, expression boundaries or child order.
fn: l2_source_container_fields (@: LmP0Structure body; int: fid; int: phase; int: holder) int
    @: LmP0Field field l2_next_active(body\first_field)
    @: LmP0Node node
    int: slot 0
    int: span
    int: child
    int: value
    []: char pn 32
    if: l2_rw_emit != 0
        l2_rw_name(holder, pn)
    while: field != 0
        node: field\value
        span: l2_discard_run(field)
        if: span > 0
            if: fid < 0 || phase = 2
                if: span = 1 && node\kind = c.LM_P0_NODE_ATOM && node\as != 0 && l2_quoted(node\as\atom) != 0
                    if: l2_rw_spell(pn, slot, node\as\atom) != 0
                        return: -1
                    ---
                else:
                    if: l2_rw_expr(field, span, holder, @ value) != 0 || l2_rw_put(holder, slot, value) != 0
                        return: -1
                    ---
                ---
            ---
            field: l2_skip_span(field, span)
        else:
            if: node = 0 || node\kind != c.LM_P0_NODE_STRUCTURE || node\as = 0 || node\as\structure = 0
                return: -1
            if: fid >= 0
                child: l2_for_find(node)
                if: child < 0 || l2_for_parent[child] != fid || l2_source_inert_container(node\as\structure, child, phase) < 0
                    return: -1
                if: phase = 1
                    l2_for_uchild[child]: slot
                ---
            else:
                if: l2_rw_inert(node\as\structure, holder, @ value) != 0 || l2_rw_put(holder, slot, value) != 0
                    return: -1
                ---
            ---
            field: l2_next_active(field\next)
        ---
        slot: slot + 1
    ---
return: slot

# The actual source body under node `parent` at slot `slot`. Keep its Structure
# identity at this boundary: a first-field pointer cannot identify an empty body
# or distinguish the source body from a FOR/CATCH lexical scope.
# The legacy shell/step layout below is not yet universal source placement.
fn: l2_rw_body (@: LmP0Structure body; int: parent; int: slot) int
    @: LmP0Field first body\first_field
    int: n 0
    int: t 0
    int: made 0
    int: bad 0
    int: shell l2_rw_shell_fid
    @: L2SourceContainer row 0
    if: l2_construct_phase >= 0 && l2_body_inert(body, l2_rw_mi) != 0
        if: l2_rw_inert(body, parent, @ t) != 0
            return: 1
        return: l2_rw_put(parent, slot, t)
    if: l2_construct_phase >= 0
        row: l2_source_container(body, 0)
        if: row = 0
            return: l2_alloc_or(l2_src, 0, "internal: a source body has no committed count")
        ---
        shell: -1
    ---
    # Its size is needed only when it is written: the count pass counts a body's steps where it builds
    # them (l2_rw_stmts below).  Asking l2_rw_count there too counted each nesting level's body twice,
    # 2^depth in all (-193 T4a: a method's 70 nested ifs, l2src/tests/unit_deepif.lm2).
    # A nested if or while clears l2_rw_shell_fid while the count walks. Keep this body's shell.
    # This list is nested. Its statements are not method steps (l2_rw_nest).
    l2_rw_nest: l2_rw_nest + 1
    if: l2_construct_phase > 0
        n: row\width
    else:
        if: l2_rw_emit != 0
            n: l2_rw_count(first)
            if: shell >= 0
                n: n + 1
            if: n < 0
                bad: 1
            ---
        ---
    ---
    if: bad = 0
        if: row != 0
            if: l2_rw_source_frame(row, parent, 0, n, @ t) != 0
                bad: 1
            ---
        else:
            if: l2_rw_plain(parent, n, @ t) != 0
                bad: 1
            ---
        ---
    ---
    if: bad = 0 && row != 0 && l2_construct_phase = 1
        row\temp: t
    if: bad = 0 && shell >= 0 && l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 0U, (cast: (@: void) l2_b%d)) != 0\n            return: 1\n", t, shell) < 0
        bad: 1
    if: bad = 0 && shell < 0 && (l2_rw_stmts(first, t, 0, row, @ made) != 0 || l2_rw_put(parent, slot, t) != 0)
        bad: 1
    if: bad = 0 && shell >= 0 && (l2_rw_stmts(first, t, 1, row, @ made) != 0 || l2_rw_put(parent, slot, t) != 0)
        bad: 1
    if: bad = 0 && l2_construct_phase = 0
        row\width: made
        if: shell >= 0
            row\width: row\width + 1
        ---
    ---
    l2_rw_nest: l2_rw_nest - 1
    if: bad != 0
        return: 1
return: 0

# Source spelling belongs to the external address table, never to Lmx fields.
# The key is the existing physical occurrence or declaration place. Borrowed
# referents keep their own names; a formal/alias names its owning child cell.
fn: l2_emit_source_name (const: @(char key); const: @(LmP0Text text); const: @(char ind); const: @(char fail); const: @(char fail2)) int
    if: text = 0 || text\length = 0U
        return: 0
    if: c.fprintf(l2_out, "%sif: lmx_source_name_set(l2_program_arena, (cast: (@: void) %s), ", ind, key) < 0 || l2_emit_cstr(text) != 0
        return: 1
    if: c.fprintf(l2_out, ", %zuU) != 0\n%s    %s\n", (text\length), ind, fail) < 0
        return: 1
    if: fail2 != 0 && c.fprintf(l2_out, "%s    %s\n", ind, fail2) < 0
        return: 1
return: 0

# A field name denotes its actual place, independently of that place's value.
# This also handles shared callable and Structure referents without renaming
# them. Written atoms have no declaration name and are named at their leaf.
fn: l2_emit_ns_names (int: ni; const: @(char holder); const: @(char ind); const: @(char fail); const: @(char fail2)) int
    int: fx 0
    int: slot 0
    []: char key 256
    while: fx < l2_nsf_n
        if: l2_nsf_owner[fx] = ni
            slot: l2_nsf_slot(fx)
            if: slot < 0
                return: l2_error(l2_src, l2_ns_at[ni], "internal: a namespace field has no source place")
            if: c.sprintf(key, "lmx_arena_ref_cell(%s, %uU)", holder, (cast: (unsigned) slot)) < 0 || l2_emit_source_name(key, l2_nsf_fname[fx], ind, fail, fail2) != 0
                return: 1
            if: l2_nsf_kind[fx] = 0 || l2_nsf_kind[fx] = 1 || l2_nsf_kind[fx] = 5 || l2_nsf_kind[fx] = 6 || l2_nsf_kind[fx] = 7 || l2_nsf_kind[fx] = 8 || l2_nsf_kind[fx] = 9 || (l2_nsf_kind[fx] >= 10 && l2_nsf_fname[fx] != 0)
                if: c.sprintf(key, "lmx_arena_ref_value(%s, %uU)", holder, (cast: (unsigned) slot)) < 0 || l2_emit_source_name(key, l2_nsf_fname[fx], ind, fail, fail2) != 0
                    return: 1
                ---
            ---
        ---
        fx: fx + 1
    ---
return: 0

fn: l2_rw_source_name (int: node; const: @(LmP0Text text)) int
    []: char key 48
    if: l2_rw_emit = 0
        return: 0
    if: c.sprintf(key, "l2_rw%d", node) < 0
        return: 1
return: l2_emit_source_name(key, text, "        ", "return: 1", 0)

fn: l2_emit_source_failure (const: @(char ind); const: @(char fail); const: @(char fail2)) int
    if: c.fprintf(l2_out, "%s    %s\n", ind, fail) < 0
        return: 1
    if: fail2 != 0 && c.fprintf(l2_out, "%s    %s\n", ind, fail2) < 0
        return: 1
return: 0

# One source-atom producer for native-only operands, inert content and named
# bodies. It writes an existing place: literals use real typed arena storage;
# symbolic leaves use their occurrence and the external spelling service.
# A qualified branch passes its ordinary allocation profile, not a different
# representation. No source text is stored in a char-pointer value cell.
fn: l2_emit_source_atom (const: @(LmP0Text text); const: @(char key); const: @(char ind); const: @(char profile); const: @(char fail); const: @(char fail2)) int
    int: t l2_source_atom_n
    int: neg 0
    int: suffix 0
    int: ch 0
    int: scalar 0
    size_t: magnitude 0U
    size_t: top (cast: (size_t) -1)
    size_t: cap
    @: char literal 0
    int: status 0
    const: @(char ctype) 0
    const: @(char type) 0
    const: @(char store) 0
    []: char inner 256
    if: text = 0
        return: 1
    l2_source_atom_n: l2_source_atom_n + 1
    if: l2_rw_char_lit(text, @ ch) != 0
        scalar: 1
        ctype: "c.char"
        type: "c.LMX_TYPE_CHAR"
        store: "lmx_char_store_known"
    if: scalar = 0 && l2_rw_num_lit(text, @ neg, @ magnitude, @ suffix) != 0
        scalar: 2
        ctype: "c.int"
        type: "c.LMX_TYPE_INT"
        store: "lmx_int_store_known"
        if: suffix != 0
            ctype: "c.unsigned"
            type: "c.LMX_TYPE_UNSIGNED"
            store: "lmx_unsigned_store_known"
        ---
    ---
    if: scalar != 0
        if: scalar = 1 && (c.fprintf(l2_out, "%sif: lmx_chars_init(l2_program_arena) != 0 && lmx_arena_find(l2_program_arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR) = 0\n", ind) < 0 || l2_emit_source_failure(ind, fail, fail2) != 0)
            return: 1
        if: c.fprintf(l2_out, "%s%s: lmx_arena_take_profiled(l2_program_arena, c.sizeof(%s), c.LMX_KIND_PRIMITIVE, %s, %s)\n%sif: %s = 0 || %s((cast: (@: void) %s), ", ind, key, ctype, type, profile, ind, key, store, key) < 0
            return: 1
        if: scalar = 1 && c.fprintf(l2_out, "%d", ch) < 0
            return: 1
        if: scalar = 2 && c.fprintf(l2_out, "%.*s", (cast: (int) text\length), (text\data)) < 0
            return: 1
        if: fputs(") != 0\n", l2_out) < 0 || l2_emit_source_failure(ind, fail, fail2) != 0
            return: 1
        return: 0
    if: l2_quoted(text) != 0
        if: text\length > (top - 3U) / 4U
            return: l2_error(l2_src, 0, "source literal is too large")
        cap: text\length * 4U + 3U
        literal: (cast: (@: char) l2_xmalloc(cap))
        if: literal = 0
            return: l2_error(l2_src, 0, "out of memory")
        status: l2_tok_text(text, literal, cap)
        if: status = 0 && (c.fprintf(l2_out, "%s@: VoidArray l2_source_text%d (cast: (@: VoidArray) lmx_arena_take_profiled(l2_program_arena, c.sizeof(c.VoidArray), c.LMX_KIND_ARRAY, c.LMX_TYPE_ARRAY_OF_CHAR, %s))\n%sif: l2_source_text%d = 0\n", ind, t, profile, ind, t) < 0 || l2_emit_source_failure(ind, fail, fail2) != 0)
            status: 1
        if: c.snprintf(inner, c.sizeof(inner), "%s    ", ind) < 0
            status: 1
        if: status = 0 && (c.fprintf(l2_out, "%sif: lmx_chars_init(l2_program_arena) != 0 && lmx_arena_find(l2_program_arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR) = 0\n", ind) < 0 || l2_emit_source_failure(ind, fail, fail2) != 0)
            status: 1
        if: status = 0 && (c.fprintf(l2_out, "%sl2_source_text%d\\size: c.sizeof(%s) - 1U\n%sl2_source_text%d\\data: 0\n%sif: l2_source_text%d\\size != 0U\n%sl2_source_text%d\\data: lmx_arena_take_n_profiled(l2_program_arena, c.sizeof(c.char), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR, %s, (l2_source_text%d\\size))\n%sif: l2_source_text%d\\data = 0\n", ind, t, literal, ind, t, ind, t, inner, t, profile, t, inner, t) < 0 || l2_emit_source_failure(inner, fail, fail2) != 0)
            status: 1
        if: status = 0 && c.fprintf(l2_out, "%smemcpy((l2_source_text%d\\data), (cast: (@: void) %s), (l2_source_text%d\\size))\n%s---\n%s%s: (cast: (@: void) l2_source_text%d)\n", inner, t, literal, t, ind, ind, key, t) < 0
            status: 1
        l2_xfree((cast: (@: void) literal))
        return: status
    # A retained symbolic leaf is an identity, not an executable role. Its
    # range gives the representation and its external name gives the spelling.
    if: c.fprintf(l2_out, "%s%s: lmx_arena_take_profiled(l2_program_arena, c.sizeof(c.char), c.LMX_KIND_SOURCE_SYMBOL, c.LMX_TYPE_SOURCE_SYMBOL, %s)\n%sif: %s = 0\n", ind, key, profile, ind, key) < 0 || l2_emit_source_failure(ind, fail, fail2) != 0
        return: 1
    if: c.fprintf(l2_out, "%smemset((cast: (@: void) %s), 0, c.sizeof(c.char))\n", ind, key) < 0
        return: 1
return: l2_emit_source_name(key, text, ind, fail, fail2)

fn: l2_rw_source_atom (const: @(LmP0Text text); int: parent; @: int out) int
    int: t l2_rw_t
    []: char key 48
    if: text = 0
        return: 1
    l2_rw_t: l2_rw_t + 1
    \out: t
    if: l2_construct_temp(t, parent, 0) != 0
        return: 1
    if: l2_rw_emit = 0
        return: 0
    if: c.sprintf(key, "l2_rw%d", t) < 0 || c.fprintf(l2_out, "        @: void %s 0\n", key) < 0
        return: 1
return: l2_emit_source_atom(text, key, "        ", "0", "return: 1", 0)

fn: l2_rw_source_application (const: @(LmP0Text head); const: @(LmP0Structure body); const: @(LmP0Trailer trailer); int: parent; const: @(char role); @: int out) int
    int: operands
    if: l2_rw_frame(parent, role, 2, out) != 0 || l2_rw_source_name(\out, head) != 0
        return: 1
    if: l2_rw_source_body(body, trailer, \out, role, @ operands) != 0
        return: 1
return: l2_rw_put(\out, 1, operands)

# Use the same resolved native-call categories as the native emitter. Unit
# methods and callable formals keep their language call producer; prototypes,
# explicit c.* heads and foreign callable places share this source producer.
# This is not a C-name registry and does not inspect any header text.
fn: l2_rw_external_head (const: @(LmP0Text head)) int
    int: formal
    int: local
    int: ty
    if: l2_c_stmt_door(head) != 0
        return: 1
    if: head = 0 || l2_call_head_method(l2_rw_mi, head, @ formal) >= 0
        return: 0
    local: l2_ml_find(head)
    if: local >= 0
        return: (cast: (int) (l2_ml_ty[local] = 40))
    # A real lexical value wins over a prototype with the same spelling.
    # Unresolved hidden inputs also remain bindings, never foreign calls.
    if: l2_colon_bound_ty(l2_rw_mi, head, @ ty) = 0 || l2_formal_find(l2_rw_mi, head) >= 0 || l2_dyn_find(l2_rw_mi, head) >= 0 || l2_slot_find(l2_rw_mi, head) >= 0
        return: 0
    if: l2_is_known(head) != 0
        return: 1
return: (cast: (int) (l2_raw_head(head, l2_rw_mi, @ formal) = 0))

# An external actual is an ordinary resolved value span, not a new symbol for
# a known L2 name. Only literals and explicitly external symbols have their
# own source leaf here. Reads retain the existing OWN/ARG/path/index producer.
fn: l2_rw_machine_actual (@: LmP0Field first; int: span; int: parent; @: int out) int
    @: LmP0Node node
    @: LmP0Text text
    int: ty
    int: neg
    int: uns
    int: ch
    size_t: magnitude
    if: first = 0 || first\value = 0 || span < 1
        return: 1
    node: first\value
    if: span = 1 && node\kind = c.LM_P0_NODE_ATOM && node\as != 0
        text: node\as\atom
        if: l2_c_stmt_door(text) != 0 || l2_quoted(text) != 0 || l2_rw_num_lit(text, @ neg, @ magnitude, @ uns) != 0 || l2_rw_char_lit(text, @ ch) != 0
            return: l2_rw_source_atom(text, parent, out)
        if: l2_colon_bound_ty(l2_rw_mi, text, @ ty) != 0 && l2_define_name(text) != 0
            return: l2_rw_source_atom(text, parent, out)
        if: l2_rw_machine_local(text, out) = 0
            return: 0
        if: l2_rw_foreign_path(text) != 0
            return: l2_rw_machine_word(text, parent, out)
        if: l2_bare_structure(text, l2_rw_mi) != 0
            return: l2_rw_reference_value(first, span, l2_graph_own(), parent, out)
        ---
    ---
return: l2_rw_texpr(first, span, -1, parent, out)

# A native-only source operand still selects the actual language binding.
# Only explicitly foreign symbols and literal/operator pieces have new cells.
fn: l2_rw_machine_word (const: @(LmP0Text text); int: parent; @: int out) int
    LmP0Text: root
    size_t: root_end 0U
    int: ty
    int: child
    int: body
    while: root_end < text\length && text\data[root_end] != 92
        root_end: root_end + 1U
    if: root_end > 0U && root_end < text\length
        root.data: text\data
        root.length: root_end
        if: l2_raw_c_root(l2_rw_mi, @ root) = 0 || l2_colon_bound_ty(l2_rw_mi, @ root, @ ty) != 0
            return: l2_rw_refuse(0, "an unresolved native member root")
        l2_rw_machine: 1
        if: l2_rw_frame(parent, "LMX_WALK_OP_SOURCE_MACHINE", 2, out) != 0 || l2_rw_source_name(\out, text) != 0 || l2_rw_plain(\out, 1, @ body) != 0 || l2_rw_put(\out, 1, body) != 0 || l2_rw_indirect(@ root, 0, ty, body, @ child) != 0
            return: 1
        return: l2_rw_put(body, 0, child)
    ---
    if: l2_rw_machine_local(text, out) = 0
        return: 0
    if: l2_colon_bound_ty(l2_rw_mi, text, @ ty) = 0
        return: l2_rw_indirect(text, 0, ty, parent, out)
    if: l2_ident(text) != 0 && l2_define_name(text) = 0 && l2_is_known(text) = 0
        return: l2_rw_refuse(0, "an unresolved native index operand")
return: l2_rw_source_atom(text, parent, out)

# A written machine operator with no interpreted implementation: the node is
# named by the operator and holds exactly `operands` operand places, which
# the caller fills in source order. The body that contains it is native-only.
fn: l2_rw_machine_operator (const: @(LmP0Text op); int: operands; int: parent; @: int out; @: int body) int
    l2_rw_machine: 1
    if: l2_rw_frame(parent, "LMX_WALK_OP_SOURCE_MACHINE", 2, out) != 0 || l2_rw_source_name(\out, op) != 0 || l2_rw_plain(\out, operands, body) != 0
        return: 1
return: l2_rw_put(\out, 1, \body)

# 0 when the span is the address operator followed by one operand run; `rest`
# is that run. Nothing is resolved or built.
fn: l2_rw_address_rest (@: L2ValueSpan span; @: L2ValueSpan rest) int
    @: LmP0Field f l2_next_active(span\first)
    if: span\count < 2 || f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || l2_text_eq(f\value\as\atom, "@") = 0
        return: 1
    rest\first: l2_next_active(f\next)
    rest\count: span\count - 1
    if: rest\first = 0
        return: 1
    rest\node: rest\first\value
return: 0

# Arithmetic whose result is a reference, `p + n` or `p - n`, is C address
# arithmetic: a machine operation the interpreter does not implement. The
# written operator stays at its place with both operands in source order,
# each built by its own static type. Nothing is scaled or folded here.
fn: l2_rw_machine_offset (@: L2ValueSpan tok; int: lo; int: best; int: hi; int: parent; @: int out) int
    int: body
    int: child
    int: left_ty l2_rw_tyof(tok, lo, best - 1)
    int: right_ty l2_rw_tyof(tok, best + 1, hi)
    if: left_ty = 0 - 3 || right_ty = 0 - 3
        return: l2_rw_refuse(l2_span_node(tok, best), "mixed numeric types (a conversion)")
    if: left_ty = 0 - 1
        left_ty: 0
    if: left_ty = 0 - 2
        left_ty: 3
    if: right_ty = 0 - 1
        right_ty: 0
    if: right_ty = 0 - 2
        right_ty: 3
    if: l2_rw_machine_operator(l2_span_node(tok, best)\as\atom, 2, parent, out, @ body) != 0
        return: 1
    if: l2_rw_bin(tok, lo, best - 1, left_ty, body, @ child) != 0 || l2_rw_put(body, 0, child) != 0
        return: 1
    if: l2_rw_bin(tok, best + 1, hi, right_ty, body, @ child) != 0
        return: 1
return: l2_rw_put(body, 1, child)

# The declaration leaf of an activation-local machine value named `text`, once
# its declaration has been produced in this method body: 0 and *out. 1 when
# `text` is no such value; nothing is diagnosed or built in that case.
fn: l2_rw_machine_local (const: @(LmP0Text text); @: int out) int
    int: local l2_ml_find(text)
    if: local < 0 || l2_ml_rw = 0 || l2_ml_rw[local] < 0
        return: 1
    l2_rw_machine: 1
    \out: l2_ml_rw[local]
return: 0

# Is `text` a member path `root\member...` whose root is foreign C storage --
# a formal, own pointer, slot or machine local of a raw C record type? A path
# that begins with a backslash is a dereference word, not this.
fn: l2_rw_foreign_path (const: @(LmP0Text text)) int
    LmP0Text: root
    size_t: root_end 0U
    if: text = 0 || text\length = 0U || text\data[0] = 92
        return: 0
    while: root_end < text\length && text\data[root_end] != 92
        root_end: root_end + 1U
    if: root_end = 0U || root_end >= text\length
        return: 0
    root.data: text\data
    root.length: root_end
return: l2_raw_c_root(l2_rw_mi, @ root)

# A store through a foreign member path, `root\member: value`. The operation
# is named by its written path and keeps the resolved root and the complete
# assigned value. It is native-only: no graph cell stands for C storage.
fn: l2_rw_machine_store (const: @(LmP0Text text); @: LmP0Field assigned; int: assigned_count; int: parent; @: int out) int
    LmP0Text: root
    size_t: root_end 0U
    int: ty
    int: body
    int: child
    while: root_end < text\length && text\data[root_end] != 92
        root_end: root_end + 1U
    root.data: text\data
    root.length: root_end
    if: l2_colon_bound_ty(l2_rw_mi, @ root, @ ty) != 0
        return: l2_rw_refuse(0, "an unresolved native member root")
    l2_rw_machine: 1
    if: l2_rw_frame(parent, "LMX_WALK_OP_SOURCE_MACHINE", 2, out) != 0 || l2_rw_source_name(\out, text) != 0 || l2_rw_plain(\out, 2, @ body) != 0 || l2_rw_put(\out, 1, body) != 0
        return: 1
    if: l2_rw_indirect(@ root, 0, ty, body, @ child) != 0 || l2_rw_put(body, 0, child) != 0
        return: 1
    if: l2_rw_machine_actual(assigned, assigned_count, body, @ child) != 0
        return: 1
return: l2_rw_put(body, 1, child)

# The lexical pieces are borrowed from the same parser scanner used by native
# index emission. This operation is retained, never represented as Array ELEM.
fn: l2_rw_machine_index_expression (const: @(LmP0Text text); int: parent; @: int out) int
    size_t: cursor 0U
    int: count 0
    int: slot 0
    int: body
    int: child
    int: status
    LmP0Text: part
    while: cursor < text\length
        status: l2_index_piece(text, @ cursor, @ part)
        if: status = 0
            break
        if: status != 1
            return: 1
        count: count + 1
    ---
    if: count = 0
        return: l2_rw_refuse(0, "an empty native index")
    if: count = 1
        cursor: 0U
        if: l2_index_piece(text, @ cursor, @ part) != 1
            return: 1
        return: l2_rw_machine_word(@ part, parent, out)
    ---
    l2_rw_machine: 1
    if: l2_rw_frame(parent, "LMX_WALK_OP_SOURCE_MACHINE", 2, out) != 0 || l2_rw_source_name(\out, text) != 0 || l2_rw_plain(\out, count, @ body) != 0 || l2_rw_put(\out, 1, body) != 0
        return: 1
    cursor: 0U
    while: slot < count
        if: l2_index_piece(text, @ cursor, @ part) != 1 || l2_rw_machine_word(@ part, body, @ child) != 0 || l2_rw_put(body, slot, child) != 0
            return: 1
        slot: slot + 1
    ---
return: 0

fn: l2_rw_machine_index (const: @(L2RawIndex indexed); @: LmP0Field assigned; int: assigned_count; int: parent; @: int out) int
    size_t: cursor indexed\begin
    LmP0Text: part
    int: width indexed\groups + 1
    int: slot 1
    int: body
    int: child
    int: ty
    @: LmP0Field field
    L2ValueSpan: operand
    if: assigned_count > 0
        width: width + 1
    l2_rw_machine: 1
    if: l2_rw_frame(parent, "LMX_WALK_OP_SOURCE_MACHINE", 2, out) != 0 || l2_rw_plain(\out, width, @ body) != 0 || l2_rw_put(\out, 1, body) != 0
        return: 1
    if: indexed\text != 0
        if: l2_rw_source_name(\out, indexed\text) != 0 || l2_rw_machine_word(@ indexed\base, body, @ child) != 0 || l2_rw_put(body, 0, child) != 0
            return: 1
        while: slot <= indexed\groups
            if: l2_raw_index_group(indexed\text, @ cursor, @ part) != 0 || l2_rw_machine_index_expression(@ part, body, @ child) != 0 || l2_rw_put(body, slot, child) != 0
                return: 1
            slot: slot + 1
        ---
    else:
        # Prefix path selectors are original foreign source, not lexical names.
        # Their resolved root is kept once; the ordinary bracket spelling names
        # the indexed operation. No P0 field or joined atom is manufactured.
        field: l2_skip_span(indexed\first, (cast: (int) indexed\begin))
        if: field = 0 || l2_rw_source_name(\out, field\value\as\atom) != 0
            return: 1
        if: indexed\foreign = 0
            if: l2_colon_bound_ty(l2_rw_mi, @ indexed\root, @ ty) != 0 || l2_rw_indirect(@ indexed\root, 0, ty, body, @ child) != 0 || l2_rw_put(body, 0, child) != 0
                return: 1
            ---
        else:
            if: l2_rw_plain(body, (cast: (int) indexed\begin), @ child) != 0 || l2_rw_put(body, 0, child) != 0
                return: 1
            ty: child
            field: indexed\first
            if: l2_rw_machine_word(@ indexed\root, ty, @ child) != 0 || l2_rw_put(ty, 0, child) != 0
                return: 1
            slot: 1
            field: l2_next_active(field\next)
            while: slot < (cast: (int) indexed\begin)
                if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM || l2_rw_source_atom(field\value\as\atom, ty, @ child) != 0 || l2_rw_put(ty, slot, child) != 0
                    return: 1
                field: l2_next_active(field\next)
                slot: slot + 1
            ---
        ---
        slot: 1
        field: l2_skip_span(indexed\first, (cast: (int) indexed\begin))
        while: slot <= indexed\groups
            ty: l2_field_index_group(field, indexed\count, @ operand, @ field)
            if: ty = 0
                return: 1
            ty: l2_rw_span_ty(@ operand)
            if: ty = -1
                ty: 0
            if: ty = -2
                ty: 3
            if: l2_rw_texpr((operand.first), (operand.count), -1, body, @ child) != 0 || l2_rw_put(body, slot, child) != 0
                return: 1
            slot: slot + 1
        ---
    ---
    if: assigned_count > 0
        if: l2_rw_machine_actual(assigned, assigned_count, body, @ child) != 0 || l2_rw_put(body, width - 1, child) != 0
            return: 1
        ---
    ---
return: 0

# Retain an already admitted native application independently of whether the
# interpreter can run it. Actual boundaries are the native emitter's common
# expression spans; no fixed arity, duplicated binding cell or replay AST.
fn: l2_rw_machine_application (const: @(LmP0Node node); int: parent; @: int out) int
    @: LmP0Frame frame
    @: LmP0Field field 0
    int: width 0
    int: slot 0
    int: span
    int: body
    int: child
    if: node = 0 || node\as = 0 || node\as\frame = 0
        return: 1
    frame: node\as\frame
    l2_rw_machine: 1
    if: frame\body != 0
        field: l2_next_active(frame\body\first_field)
    while: field != 0
        span: l2_expr_span(field)
        if: span < 1
            return: l2_rw_refuse(field\value, "this native argument span")
        width: width + 1
        field: l2_skip_span(field, span)
    ---
    if: frame\trailer != 0
        width: width + 1
    if: l2_rw_frame(parent, "LMX_WALK_OP_SOURCE_MACHINE", 2, out) != 0 || l2_rw_source_name(\out, frame\head) != 0 || l2_rw_plain(\out, width, @ body) != 0 || l2_rw_put(\out, 1, body) != 0
        return: 1
    if: frame\body != 0
        field: l2_next_active(frame\body\first_field)
    while: field != 0
        span: l2_expr_span(field)
        if: l2_rw_machine_actual(field, span, body, @ child) != 0 || l2_rw_put(body, slot, child) != 0
            return: 1
        slot: slot + 1
        field: l2_skip_span(field, span)
    ---
    if: frame\trailer != 0
        if: l2_rw_source_application((frame\trailer\spelling), (frame\trailer\body), 0, body, "LMX_WALK_OP_SOURCE_INERT", @ child) != 0 || l2_rw_source_facet(child, "LMX_WALK_SOURCE_TRAILER") != 0 || l2_rw_put(body, slot, child) != 0
            return: 1
        ---
    ---
return: 0

# The declaration of an activation-local machine value: an imported C
# function-pointer or by-value record local, `TYPE: name [initializer]`. The
# frame is retained as written: its type head by spelling, the declared name
# as one source leaf, and every initializer span through the ordinary resolved
# actual producer. The value lives in machine activation storage only, so no
# cell is allocated and nothing in the graph addresses the stack object; later
# uses borrow this declaration's leaf (l2_rw_machine_local).
fn: l2_rw_machine_declaration (const: @(LmP0Node node); const: @(LmP0Text name); int: parent; @: int out) int
    @: LmP0Frame frame
    @: LmP0Field first
    @: LmP0Field field
    int: local l2_ml_find(name)
    int: width 1
    int: slot 1
    int: span
    int: body
    int: child
    if: node = 0 || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0 || local < 0 || l2_ml_rw = 0
        return: 1
    frame: node\as\frame
    if: frame\trailer != 0 || frame\body\trailer != 0
        return: l2_rw_refuse(node, "this native declaration")
    first: l2_next_active(frame\body\first_field)
    if: first = 0
        return: 1
    l2_rw_machine: 1
    field: l2_next_active(first\next)
    while: field != 0
        span: l2_expr_span(field)
        if: span < 1
            return: l2_rw_refuse(field\value, "this native initializer span")
        width: width + 1
        field: l2_skip_span(field, span)
    ---
    if: l2_rw_frame(parent, "LMX_WALK_OP_SOURCE_MACHINE", 2, out) != 0 || l2_rw_source_name(\out, frame\head) != 0 || l2_rw_plain(\out, width, @ body) != 0 || l2_rw_put(\out, 1, body) != 0
        return: 1
    # The initializer cannot name the value it initializes: produce it before
    # the declaration leaf becomes the binding of that name.
    field: l2_next_active(first\next)
    while: field != 0
        span: l2_expr_span(field)
        if: l2_rw_machine_actual(field, span, body, @ child) != 0 || l2_rw_put(body, slot, child) != 0
            return: 1
        slot: slot + 1
        field: l2_skip_span(field, span)
    ---
    if: l2_rw_source_atom(name, body, @ child) != 0 || l2_rw_put(body, 0, child) != 0
        return: 1
    l2_ml_rw[local]: child
return: 0

# The cast receiver's existing contract separates its first type child from
# the entire value tail. Retain the type as source description, not a lexical
# value; lower the value through the ordinary actual producer. No source P0
# node or binding is copied, and a nested external call uses that same route.
fn: l2_rw_machine_cast (const: @(LmP0Node node); int: parent; @: int out) int
    @: LmP0Frame frame
    @: LmP0Field type_field
    @: LmP0Field value_field
    int: count
    int: type_code
    int: body
    int: child
    if: node = 0 || node\as = 0 || node\as\frame = 0
        return: 1
    frame: node\as\frame
    count: l2_count_active(frame\body)
    if: frame\body = 0 || count < 2 || frame\trailer != 0 || frame\body\trailer != 0
        return: l2_rw_refuse(node, "this cast contract")
    type_field: l2_next_active(frame\body\first_field)
    value_field: l2_next_active(type_field\next)
    if: l2_cast_resolve(type_field\value, @ type_code, 0) != 0
        return: l2_rw_refuse(type_field\value, "this cast type")
    l2_rw_machine: 1
    if: l2_rw_frame(parent, "LMX_WALK_OP_SOURCE_MACHINE", 2, out) != 0 || l2_rw_source_name(\out, frame\head) != 0 || l2_rw_plain(\out, 2, @ body) != 0 || l2_rw_put(\out, 1, body) != 0
        return: 1
    if: l2_rw_source_node(type_field\value, body, "LMX_WALK_OP_SOURCE_INERT", @ child) != 0 || l2_rw_put(body, 0, child) != 0
        return: 1
    if: l2_rw_machine_actual(value_field, count - 1, body, @ child) != 0
        return: 1
return: l2_rw_put(body, 1, child)

fn: l2_rw_source_body (const: @(LmP0Structure body); const: @(LmP0Trailer trailer); int: parent; const: @(char role); @: int out) int
    @: LmP0Field field 0
    int: width 0
    int: at 0
    int: child
    if: body != 0
        field: body\first_field
    while: field != 0
        width: width + 1
        field: field\next
    ---
    if: trailer != 0
        width: width + 1
    if: l2_rw_plain(parent, width, out) != 0
        return: 1
    if: body != 0
        field: body\first_field
    while: field != 0
        if: l2_rw_source_node((field\value), \out, role, @ child) != 0 || l2_rw_put(\out, at, child) != 0
            return: 1
        at: at + 1
        field: field\next
    ---
    if: trailer != 0
        if: l2_rw_source_application((trailer\spelling), (trailer\body), 0, \out, "LMX_WALK_OP_SOURCE_INERT", @ child) != 0 || l2_rw_source_facet(child, "LMX_WALK_SOURCE_TRAILER") != 0 || l2_rw_put(\out, at, child) != 0
            return: 1
        ---
    ---
return: 0

fn: l2_rw_source_node (const: @(LmP0Node node); int: parent; const: @(char role); @: int out) int
    if: c.strcmp(role, "LMX_WALK_OP_SOURCE_MACHINE") = 0
        l2_rw_machine: 1
    if: node = 0 || node\as = 0
        return: 1
    if: node\kind = c.LM_P0_NODE_ATOM || node\kind = c.LM_P0_NODE_DISABLED
        return: l2_rw_source_atom((node\as\atom), parent, out)
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as\structure != 0
        return: l2_rw_source_body((node\as\structure), (node\as\structure\trailer), parent, role, out)
    if: node\kind = c.LM_P0_NODE_FRAME && node\as\frame != 0
        if: c.strcmp(role, "LMX_WALK_OP_SOURCE_MACHINE") = 0 && l2_frame_head(node, "cast") != 0
            return: l2_rw_machine_cast(node, parent, out)
        if: c.strcmp(role, "LMX_WALK_OP_SOURCE_MACHINE") = 0 && l2_rw_external_head(node\as\frame\head) != 0
            return: l2_rw_machine_application(node, parent, out)
        return: l2_rw_source_application((node\as\frame\head), (node\as\frame\body), (node\as\frame\trailer), parent, role, out)
return: 1

# Retain one source atom through its common typed constructor. Numeric/char
# values are real cells, strings real Array descriptors, and an unresolved
# symbolic leaf gets only its ordinary source role plus external spelling.
fn: l2_rw_spell (const: @(char pn); int: slot; const: @(LmP0Text t)) int
    int: atom
    if: l2_rw_source_atom(t, 0 - 1, @ atom) != 0
        return: 1
    if: l2_rw_emit = 0
        return: 0
return: (cast: (int) (c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", pn, slot, atom) < 0))

# Child 0 of a placed method-local expression definition: the operator tree. The Structure
# shell is already the own slot. Walk roles are open, so the node can be built here.
fn: l2_fill_method_expr (int: oi) int
    @: LmP0Node stmt
    @: LmP0Field f
    int: span
    int: mi
    int: host
    int: node
    []: char bn 32
    @: L2SourceContainer source 0
    @: L2SourceField source_field
    @: L2GraphField field
    stmt: l2_own_decl[oi]
    if: stmt = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 1
    f: l2_next_active(stmt\as\frame\body\first_field)
    span: l2_discard_run(f)
    if: span < 2
        return: 1
    mi: l2_own_mi[oi]
    if: mi < 0 || mi >= l2_m_n
        return: 1
    host: l2_rw_t
    l2_rw_t: l2_rw_t + 1
    source_field: l2_source_field_owner(oi, @ source)
    if: source_field != 0
        if: c.fprintf(l2_out, "        l2_entry_leaf: l2_sc%zu\n        @: Lmx l2_rw%d lmx_arena_ref_struct(l2_entry_leaf, %uU)\n", source\id, host, (cast: (unsigned) source_field\slot)) < 0
            return: 1
        ---
    else:
        if: l2_construct_view_kind != 0
            return: l2_error(l2_src, stmt, "internal: a projected expression has no source field")
        field: l2_graph_field(oi)
        if: field = 0 || fputs("        l2_entry_leaf: ", l2_out) < 0 || l2_emit_graph_build_place(field\holder, mi) != 0 || c.fprintf(l2_out, "\n        @: Lmx l2_rw%d lmx_arena_ref_struct(l2_entry_leaf, %zuU)\n", host, field\child) < 0
            return: 1
        ---
    ---
    if: c.fprintf(l2_out, "        if: l2_entry_leaf = 0 || l2_rw%d = 0\n            return: 1\n", host) < 0
        return: 1
    if: l2_rw_expr(f, span, host, @ node) != 0
        return: 1
    l2_rw_name(host, bn)
    if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, 0U, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n", bn, node) < 0
        return: 1
return: 0

# An expression-span method-local definition whose procedure was not built.
fn: l2_expr_own (int: oi) int
    @: LmP0Node stmt
    int: ni
    if: oi < 0 || oi >= l2_own_n
        return: 0
    stmt: l2_own_decl[oi]
    if: stmt = 0 || stmt\as = 0 || stmt\as\frame = 0
        return: 0
    if: l2_expr_only_tail(stmt\as\frame) = 0
        return: 0
    ni: l2_own_nsty_get(oi)
    if: ni < 0 || ni >= l2_ns_n || l2_ns_proc[ni] >= 0
        return: 0
return: 1

# File-level helper l2_kx<oi>: the walk builder returns int, and the method is a sub.
# The fresh Structure is `host`; child 0 is the operator. Roles are the program's.
fn: l2_emit_expr_keep (int: oi) int
    @: LmP0Node stmt
    @: LmP0Field f
    @: int snap 0
    int: span
    int: mi
    int: host 0
    int: node 0
    int: si 0
    int: bad 0
    int: saved_mi
    int: saved_cur
    int: saved_emit
    int: saved_n
    stmt: l2_own_decl[oi]
    if: stmt = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 1
    f: l2_next_active(stmt\as\frame\body\first_field)
    span: l2_discard_run(f)
    if: span < 2
        return: 1
    mi: l2_own_mi[oi]
    if: mi < 0 || mi >= l2_m_n
        return: 1
    saved_n: l2_rw_bseq_n
    if: l2_rw_bseq != 0 && l2_own_n > 0
        snap: (cast: (@: int) calloc((cast: (size_t) l2_own_n), c.sizeof(c.int)))
        if: snap = 0
            return: 1
        while: si < l2_own_n
            snap[si]: l2_rw_bseq[si]
            si: si + 1
        ---
    ---
    saved_mi: l2_rw_mi
    saved_cur: l2_cur_mi
    saved_emit: l2_rw_emit
    l2_rw_mi: mi
    l2_cur_mi: mi
    l2_rw_emit: 1
    if: c.fprintf(l2_out, "fn: l2_kx%d (@: Lmx host) int\n    @: Lmx l2_rw_roles lmx_walk_program_roles()\n    if: l2_rw_roles = 0\n        return: 1\n    if: 1\n", oi) < 0
        bad: 1
    if: bad = 0
        host: l2_rw_t
        l2_rw_t: l2_rw_t + 1
        if: c.fprintf(l2_out, "        @: Lmx l2_rw%d host\n", host) < 0
            bad: 1
        ---
    if: bad = 0 && l2_rw_expr(f, span, host, @ node) != 0
        bad: 1
    if: bad = 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(host, 0U, (cast: (@: void) l2_rw%d)) != 0\n            return: 1\n    ---\nreturn: 0\nend: l2_kx%d\n\n", node, oi) < 0
        bad: 1
    l2_rw_mi: saved_mi
    l2_cur_mi: saved_cur
    l2_rw_emit: saved_emit
    l2_rw_bseq_n: saved_n
    if: snap != 0
        si: 0
        while: si < l2_own_n
            l2_rw_bseq[si]: snap[si]
            si: si + 1
        ---
        free((cast: (@: void) snap))
    ---
    if: bad != 0
        return: 1
return: 0

# A method-local definition whose tail is only written atoms. The Structure is one
# child of its actual source body; each atom uses the common typed/symbolic
# producer. The declaration does not execute the retained body's contents.
fn: l2_rw_atom_ns (const: @(LmP0Node stmt); const: @(char pn); int: slot; @: int made) int
    int: own l2_own_by_decl(l2_rw_mi, stmt)
    @: L2SourceContainer source 0
    \made: 0
    if: own < 0 || l2_source_definition_ns(own) < 0 || l2_source_field_owner(own, @ source) = 0
        return: l2_rw_refuse(stmt, "a source definition without an owning producer")
    # The original child and its complete body are filled by their own source
    # producer. Reaching the definition is neither invocation nor allocation.
return: 0

# Statement `field`: its step (if it makes one) goes to container `into` at slot `slot`, and
# `made` says whether one was made; `next` is the field after the statement.
fn: l2_rw_stmt (@: LmP0Field field; @@: LmP0Field next; int: into; int: slot; @: int made) int
    @: L2Declaration declaration
    []: char source_container 32
    int: source_role
    int: own
    int: status l2_rw_stmt_content(field, next, into, slot, made)
    if: status != 0
        return: status
    # Every statement entry, including a receiver used as another operation's
    # operand, preserves its resolved declaration role. The destination remains
    # the existing typed cell; this annotates only the existing operation head.
    own: l2_own_by_decl(l2_rw_mi, field\value)
    if: l2_rw_emit != 0 && \made != 0 && own >= 0
        declaration: l2_declaration(field\value)
        # The receiving contract must own exactly this source name token.
        # Deriving a possible contract is not enough: an ordinary named body
        # owns its head token, not the first atom inside that body.
        if: declaration != 0 && declaration\name = l2_own_name[own]
            source_role: 1
            if: declaration\candidate_count = 0
                source_role: 2
            l2_rw_name(into, source_container)
            if: c.fprintf(l2_out, "        if: lmx_walk_source_mark(l2_rw_roles, lmx_arena_ref_struct(%s, %dU), %d) != 0\n            return: 1\n", source_container, slot, source_role) < 0
                return: 1
            ---
        ---
    ---
return: 0

fn: l2_rw_stmt_content (@: LmP0Field field; @@: LmP0Field next; int: into; int: slot; @: int made) int
    LmP0Text: indirect_base
    LmP0Text: selected_head
    @: char selected_path 0
    int: indirect_levels
    int: indirect_type
    size_t: eix 0U
    @: LmP0Node stmt
    @: LmP0Text h
    @: LmP0Field f
    @: LmP0Field cond
    @: LmP0Field last
    @: LmP0Field els
    int: n
    int: k
    int: t
    int: node
    int: else_node
    int: oi
    int: idx
    int: formal 0 - 1
    int: fid
    int: bsave 0
    L2RawIndex: indexed
    L2ArrayPlace: array_place
    @: LmP0Text machine_name 0
    []: char pn 32
    \made: 0
    stmt: field\value
    \next: l2_next_active(field\next)
    l2_here_at_method(l2_rw_mi, stmt)
    l2_rw_name(into, pn)
    # Construction consumes the original unit, including non-executable
    # directives. Preserve their complete source subtree before lowering;
    # their bodies are descriptions, not evaluated runtime arguments.
    k: l2_unit_role(stmt)
    if: k = 3 || k = 4
        if: l2_rw_source_node(stmt, into, "LMX_WALK_OP_SOURCE_INERT", @ node) != 0 || l2_rw_put(into, slot, node) != 0
            return: 1
        \made: 1
        return: 0
    # A forward header whose definition is another occurrence of this unit
    # is a validated description: it stays at its written place with its
    # complete signature, executes nothing and gains no fabricated body.
    if: k = 1 && l2_fn_defined(stmt) = 0 && l2_os_fn_name(stmt) != 0 && l2_unit_defined_fn(stmt, l2_os_fn_name(stmt)) != 0
        if: l2_rw_source_node(stmt, into, "LMX_WALK_OP_SOURCE_INERT", @ node) != 0 || l2_rw_put(into, slot, node) != 0
            return: 1
        \made: 1
        return: 0
    # An expression statement: a run of fields read as one expression.  A string literal alone
    # has nothing to evaluate (natively it is dropped, l2_eval_discard): it makes no step
    # (FABLE-OPUS-ROOT-CLASSES-20260926-196).
