# Witness: a named argument sitting on its own position counts as a positional one
# Norm: the book #declaration-selection (its table), #admission; the plan #two-kinds-of-receivers-plan item 1; R65-R68, R71, R76.
# Slice «selection of the declaration by the call» (plan #two-kinds-of-receivers-plan).
(
    Observed:
        int: seen 0
)
@: shared data[0]

fn: g (int: b; int: a) int
    return: b * 10 + a

sub: main () (
    int: k 0
)
    shared\Observed\seen := g(b := 2; 5)
main()
