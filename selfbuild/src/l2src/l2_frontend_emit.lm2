        if: na != 0
            return: (cast: (int) (c.lm_compiler_error_name(path, stmt, "", (cast: (const: @: char) (w\data)), (cast: (size_t) (w\length)), " expression is not lowered in this receiving context")))
        if: c.lm_compiler_text_eq(w, "merge")
            return: (cast: (int) (c.lm_compiler_error(path, stmt, "merge needs at least one operand")))
        if: c.lm_compiler_text_eq(w, "length")
            return: (cast: (int) (c.lm_compiler_error(path, stmt, "length requires one known primitive own array")))
        if: c.lm_compiler_text_eq(w, "cast")
            return: (cast: (int) (c.lm_compiler_error(path, stmt, "unsupported cast")))
        return: (cast: (int) (c.lm_compiler_error(path, stmt, "sizeof: requires one operand")))
    if: na != 0
        return: (cast: (int) (2))
    # No written argument.  A bare `return` ends the walked root (mi = E): its value is its last evaluated expression
