# Ordinary L2 frontend helpers; declarations come from the existing L3 recipe.
# One inherited descriptor-word cache cell is explicit; no new state/context/registry.
predef: "l2src/l2_application.h.lm1"
include: "<stddef.h>" "<stdio.h>" "<stdlib.h>" "<string.h>" "<limits.h>"

fn: lm_compiler_text_eq (const: (@: text c.LmP0Text); const: (@: s char)) int
    size_t: n
    if: text = 0 || s = 0
        return: (cast: (int) (0))
    n: c.strlen(s)
    if: text\data = 0
        return: (cast: (int) (n = 0U))
    return: (cast: (int) (text\length = n && c.memcmp(text\data, s, n) = 0))
end: lm_compiler_text_eq

fn: lm_compiler_ignored (const: (@: source_node c.LmP0Node)) int
    if: source_node = 0
        return: (cast: (int) (1))
    if: source_node\kind = c.LM_P0_NODE_DISABLED
        return: (cast: (int) (1))
    if: (source_node\flags & (c.LM_P0_NODE_INACTIVE | c.LM_P0_NODE_MIX)) != 0U
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: lm_compiler_ignored

fn: lm_compiler_msg_copy (const: (@: s char)) @: char
    @: p char
    size_t: n
    if: s = 0
        return: (cast: (@: char) (0))
    n: c.strlen(s)
    p: (cast: (@: char) c.malloc(n + 1U))
    if: p = 0
        return: (cast: (@: char) (0))
    c.memcpy((cast: (@: void) p), s, n + 1U)
    return: (cast: (@: char) (p))
end: lm_compiler_msg_copy

fn: lm_compiler_msg_drop (@: p char) @: char
    if: p != 0
        c.free((cast: (@: void) p))
    return: (cast: (@: char) (0))
end: lm_compiler_msg_drop

fn: lm_compiler_msg_text (const: (@: p char)) const: @: char
    if: p = 0
        return: (cast: (const: @: char) (""))
    return: (cast: (const: @: char) (p))
end: lm_compiler_msg_text

fn: lm_compiler_node_in (const: (@: n c.LmP0Node); const: (@: x c.LmP0Node)) int
    if: n = 0 || x = 0
        return: (cast: (int) (0))
    if: n = x
        return: (cast: (int) (1))
    if: n\as = 0
        return: (cast: (int) (0))
    if: n\kind = c.LM_P0_NODE_FRAME && n\as\frame != 0
        if: lm_compiler_struct_has((cast: (const: @: c.LmP0Structure) n\as\frame\body), x) != 0
            return: (cast: (int) (1))
        if: n\as\frame\trailer != 0
            return: (cast: (int) (lm_compiler_struct_has((cast: (const: @: c.LmP0Structure) n\as\frame\trailer\body), x)))
        return: (cast: (int) (0))
    if: n\kind = c.LM_P0_NODE_STRUCTURE
        return: (cast: (int) (lm_compiler_struct_has((cast: (const: @: c.LmP0Structure) n\as\structure), x)))
    return: (cast: (int) (0))
end: lm_compiler_node_in

fn: lm_compiler_struct_has (const: (@: s c.LmP0Structure); const: (@: x c.LmP0Node)) int
    @: f c.LmP0Field
    if: s = 0
        return: (cast: (int) (0))
    f: s\first_field
    while: f != 0
        if: lm_compiler_node_in((cast: (const: @: c.LmP0Node) f\value), x) != 0
            return: (cast: (int) (1))
        f: f\next
    ---
    if: s\trailer != 0
        return: (cast: (int) (lm_compiler_struct_has((cast: (const: @: c.LmP0Structure) s\trailer\body), x)))
    return: (cast: (int) (0))
end: lm_compiler_struct_has

fn: lm_compiler_act_tx (@: base c.L2Tx; int: i) @: c.L2Tx
    if: base = 0 || i < 0
        return: (cast: (@: c.L2Tx) (0))
    return: (cast: (@: c.L2Tx) (base + i))
end: lm_compiler_act_tx

fn: lm_compiler_mul_ok (size_t: n; size_t: sz) int
    if: sz = 0U
        return: (cast: (int) (1))
    if: n > ((cast: (size_t) -1) / sz)
        return: (cast: (int) (0))
    return: (cast: (int) (1))
end: lm_compiler_mul_ok

fn: lm_compiler_mul3_ok (size_t: a; size_t: b; size_t: c) int
    size_t: p
    if: lm_compiler_mul_ok(a, b) = 0
        return: (cast: (int) (0))
    p: a * b
    if: lm_compiler_mul_ok(p, c) = 0
        return: (cast: (int) (0))
    return: (cast: (int) (1))
end: lm_compiler_mul3_ok

fn: lm_compiler_path_is_lm2 (const: (@: path char)) int
    size_t: n
    if: path = 0
        return: (cast: (int) (0))
    n: c.strlen(path)
    if: n < 4U
        return: (cast: (int) (0))
    if: path[n - 4U] != 46
        return: (cast: (int) (0))
    if: path[n - 3U] != 108 && path[n - 3U] != 76
        return: (cast: (int) (0))
    if: path[n - 2U] != 109 && path[n - 2U] != 77
        return: (cast: (int) (0))
    if: path[n - 1U] != 50
        return: (cast: (int) (0))
    return: (cast: (int) (1))
end: lm_compiler_path_is_lm2

fn: lm_compiler_next_active (@: field c.LmP0Field) @: c.LmP0Field
    while: field != 0 && lm_compiler_ignored((cast: (const: @: c.LmP0Node) field\value))
        field: field\next
    return: (cast: (@: c.LmP0Field) (field))
end: lm_compiler_next_active

fn: lm_compiler_count_active_tail (@: field c.LmP0Field) int
    int: n 0
    field: lm_compiler_next_active(field)
    while: field != 0
        n: n + 1
        field: lm_compiler_next_active((cast: (@: c.LmP0Field) field\next))
    return: (cast: (int) (n))
end: lm_compiler_count_active_tail

fn: lm_compiler_count_active (const: (@: body c.LmP0Structure)) int
    if: body = 0
        return: (cast: (int) (0))
    return: (cast: (int) (lm_compiler_count_active_tail((cast: (@: c.LmP0Field) body\first_field))))
end: lm_compiler_count_active

fn: lm_compiler_digits (const: (@: text c.LmP0Text)) int
    size_t: i
    if: text = 0 || text\data = 0 || text\length = 0U
        return: (cast: (int) (0))
    if: text\length > 1U && text\data[0] = 48
        return: (cast: (int) (0))
    i: 0U
    while: i < text\length
        if: text\data[i] < 48 || text\data[i] > 57
            return: (cast: (int) (0))
        i: i + 1U
    return: (cast: (int) (1))
end: lm_compiler_digits

fn: lm_compiler_num (const: (@: text c.LmP0Text)) int
    size_t: n
    size_t: i
    int: base 10
    int: d
    if: text = 0 || text\data = 0 || text\length = 0U
        return: (cast: (int) (0))
    n: text\length
    if: text\data[n - 1U] = 85 || text\data[n - 1U] = 117
        n: n - 1U
    if: n = 0U
        return: (cast: (int) (0))
    if: n > 1U && text\data[0] = 48
        base: 8
        if: text\data[1] = 120 || text\data[1] = 88
            base: 16
            i: 2U
            if: i = n
                return: (cast: (int) (0))
        ---
    ---
    if: base = 10 || base = 8
        i: 0U
    ---
    while: i < n
        d: -1
        if: text\data[i] >= 48 && text\data[i] <= 57
            d: text\data[i] - 48
        if: text\data[i] >= 65 && text\data[i] <= 70
            d: text\data[i] - 65 + 10
        if: text\data[i] >= 97 && text\data[i] <= 102
            d: text\data[i] - 97 + 10
        if: d < 0 || d >= base
            return: (cast: (int) (0))
        i: i + 1U
    return: (cast: (int) (1))
end: lm_compiler_num

fn: lm_compiler_num_value_span (const: (@: text c.LmP0Text); size_t: start; size_t: stop; @: out size_t) int
    size_t: i start
    size_t: acc 0U
    size_t: digit 0U
    size_t: base 10U
    if: text = 0 || text\data = 0 || out = 0 || start >= stop || stop > text\length
        return: (cast: (int) (0))
    if: stop - start > 1U && text\data[start] = 48
        base: 8U
        if: text\data[start + 1U] = 120 || text\data[start + 1U] = 88
            base: 16U
            i: start + 2U
            if: i >= stop
                return: (cast: (int) (0))
        ---
    ---
    while: i < stop
        digit: (cast: (size_t) -1)
        if: text\data[i] >= 48 && text\data[i] <= 57
            digit: (cast: (size_t) (text\data[i] - 48))
        if: text\data[i] >= 65 && text\data[i] <= 70
            digit: (cast: (size_t) (text\data[i] - 65 + 10))
        if: text\data[i] >= 97 && text\data[i] <= 102
            digit: (cast: (size_t) (text\data[i] - 97 + 10))
        if: digit >= base || acc > (((cast: (size_t) -1) - digit) / base)
            return: (cast: (int) (0))
        acc: acc * base + digit
        i: i + 1U
    ---
    \out: acc
    return: (cast: (int) (1))
end: lm_compiler_num_value_span

fn: lm_compiler_num_value (const: (@: text c.LmP0Text); @: out size_t) int
    size_t: stop
    if: lm_compiler_num(text) = 0 || out = 0
        return: (cast: (int) (0))
    stop: text\length
    if: text\data[stop - 1U] = 85 || text\data[stop - 1U] = 117
        stop: stop - 1U
    return: (cast: (int) (lm_compiler_num_value_span(text, 0U, stop, out)))
end: lm_compiler_num_value

fn: lm_compiler_octal_digits (const: (@: text c.LmP0Text)) int
    size_t: n
    size_t: i 0U
    if: text = 0 || text\data = 0 || text\length = 0U
        return: (cast: (int) (0))
    n: text\length
    if: text\data[n - 1U] = 85 || text\data[n - 1U] = 117
        n: n - 1U
    if: n = 0U
        return: (cast: (int) (0))
    while: i < n
        if: text\data[i] < 48 || text\data[i] > 55
            return: (cast: (int) (0))
        i: i + 1U
    return: (cast: (int) (1))
end: lm_compiler_octal_digits

fn: lm_compiler_signed_num (const: (@: text c.LmP0Text)) int
    size_t: i 1U
    if: text = 0 || text\data = 0 || text\length < 2U || text\data[0] != 45
        return: (cast: (int) (0))
    if: text\length > 2U && text\data[1] = 48
        return: (cast: (int) (0))
    while: i < text\length
        if: text\data[i] < 48 || text\data[i] > 57
            return: (cast: (int) (0))
        i: i + 1U
    return: (cast: (int) (1))
end: lm_compiler_signed_num

fn: lm_compiler_int_fits (const: (@: text c.LmP0Text)) int
    size_t: value 0U
    if: lm_compiler_num_value(text, @ value) = 0
        return: (cast: (int) (0))
    if: text\data[text\length - 1U] = 85 || text\data[text\length - 1U] = 117
        return: (cast: (int) (0))
    return: (cast: (int) ((cast: (int) (value <= (cast: (size_t) c.INT_MAX)))))
end: lm_compiler_int_fits

fn: lm_compiler_int_literal_bits (const: (@: text c.LmP0Text); @: out_bits size_t) int
    size_t: i 1U
    size_t: acc 0U
    size_t: d 0U
    size_t: lim
    int: v 0
    if: text = 0 || out_bits = 0
        return: (cast: (int) (0))
    if: lm_compiler_num(text) != 0
        if: lm_compiler_int_fits(text) = 0
            return: (cast: (int) (2))
        \out_bits: lm_compiler_literal_value(text)
        return: (cast: (int) (1))
    if: lm_compiler_signed_num(text) = 0
        return: (cast: (int) (0))
    lim: (cast: (size_t) c.INT_MAX) + 1U
    while: i < text\length
        d: (cast: (size_t) (text\data[i] - 48))
        if: acc > (lim - d) / 10U
            return: (cast: (int) (2))
        acc: acc * 10U + d
        i: i + 1U
    ---
    if: acc > lim
        return: (cast: (int) (2))
    if: acc = lim
        v: 0 - c.INT_MAX - 1
    else:
        v: 0 - (cast: (int) acc)
    ---
    \out_bits: (cast: (size_t) v)
    return: (cast: (int) (1))
end: lm_compiler_int_literal_bits

fn: lm_compiler_lit_kind_from_ft (int: ft) int
    if: ft = 0
        return: (cast: (int) (0))
    if: ft = 1
        return: (cast: (int) (1))
    if: ft = 2
        return: (cast: (int) (2))
    if: ft = 34
        return: (cast: (int) (3))
    if: ft = 36
        return: (cast: (int) (4))
    return: (cast: (int) (0 - 1))
end: lm_compiler_lit_kind_from_ft

fn: lm_compiler_lit_kind_from_own (int: oty) int
    # Own/loc storage uses 0 for int (same hole as dynamic inputs).
    if: oty = 0 || oty = 3
        return: (cast: (int) (0))
    if: oty = 1
        return: (cast: (int) (1))
    if: oty = 2
        return: (cast: (int) (2))
    if: oty = 6
        return: (cast: (int) (3))
    if: oty = 36
        return: (cast: (int) (4))
    return: (cast: (int) (0 - 1))
end: lm_compiler_lit_kind_from_own

fn: lm_compiler_lit_kind_from_ret (int: mret) int
    if: mret = 0
        return: (cast: (int) (0))
    if: mret = 1
        return: (cast: (int) (1))
    if: mret = 2
        return: (cast: (int) (2))
    if: mret = 33
        return: (cast: (int) (3))
    if: mret = 36
        return: (cast: (int) (4))
    return: (cast: (int) (0 - 1))
end: lm_compiler_lit_kind_from_ret

fn: lm_compiler_u32_fits (const: (@: text c.LmP0Text)) int
    size_t: value 0U
    if: lm_compiler_num_value(text, @ value) = 0
        return: (cast: (int) (0))
    return: (cast: (int) ((cast: (int) (value <= (cast: (size_t) (cast: (unsigned) -1))))))
end: lm_compiler_u32_fits

fn: lm_compiler_char_digit_fits (const: (@: text c.LmP0Text)) int
    size_t: bits 0U
    int: value
    if: lm_compiler_int_literal_bits(text, @ bits) != 1
        return: (cast: (int) (0))
    value: (cast: (int) bits)
    return: (cast: (int) ((cast: (int) (value >= c.CHAR_MIN && value <= c.CHAR_MAX))))
end: lm_compiler_char_digit_fits

fn: lm_compiler_size_t_fits_text (const: (@: text c.LmP0Text)) int
    size_t: value 0U
    return: (cast: (int) (lm_compiler_num_value(text, @ value)))
end: lm_compiler_size_t_fits_text

fn: lm_compiler_literal_fits_kind (const: (@: text c.LmP0Text); int: kind) int
    if: kind < 0 || text = 0
        return: (cast: (int) (1))
    if: kind = 0
        return: (cast: (int) (lm_compiler_int_fits(text)))
    if: kind = 1
        return: (cast: (int) (lm_compiler_char_digit_fits(text)))
    if: kind = 2
        return: (cast: (int) (lm_compiler_size_t_fits_text(text)))
    if: kind = 3
        return: (cast: (int) (lm_compiler_u32_fits(text)))
    if: kind = 4
        return: (cast: (int) (lm_compiler_u32_fits(text)))
    return: (cast: (int) (1))
end: lm_compiler_literal_fits_kind

fn: lm_compiler_block_until (const: (@: stmt c.LmP0Node)) @: c.LmP0Structure
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_STRUCTURE || stmt\as = 0 || stmt\as\structure = 0 || stmt\as\structure\trailer = 0
        return: (cast: (@: c.LmP0Structure) (0))
    if: stmt\as\structure\trailer\spelling = 0 || lm_compiler_text_eq((cast: (const: @: c.LmP0Text) stmt\as\structure\trailer\spelling), "until") = 0
        return: (cast: (@: c.LmP0Structure) (0))
    return: (cast: (@: c.LmP0Structure) (stmt\as\structure\trailer\body))
end: lm_compiler_block_until

fn: lm_compiler_end_named (const: (@: frame c.LmP0Frame); const: (@: name char)) int
    @: field c.LmP0Field
    if: frame = 0 || frame\trailer = 0
        return: (cast: (int) (0))
    if: lm_compiler_text_eq((cast: (const: @: c.LmP0Text) frame\trailer\spelling), "end") = 0
        return: (cast: (int) (0))
    if: frame\trailer\body = 0
        return: (cast: (int) (0))
    field: lm_compiler_next_active((cast: (@: c.LmP0Field) frame\trailer\body\first_field))
    if: field = 0 || lm_compiler_next_active((cast: (@: c.LmP0Field) field\next)) != 0
        return: (cast: (int) (0))
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: (cast: (int) (0))
    return: (cast: (int) (lm_compiler_text_eq((cast: (const: @: c.LmP0Text) field\value\as\atom), name)))
end: lm_compiler_end_named

fn: lm_compiler_fn_close (const: (@: frame c.LmP0Frame); const: (@: name c.LmP0Text); const: (@: head char)) int
    @: field c.LmP0Field
    @: actual c.LmP0Text
    if: frame = 0
        return: (cast: (int) (1))
    if: frame\trailer = 0
        return: (cast: (int) (0))
    if: lm_compiler_text_eq((cast: (const: @: c.LmP0Text) frame\trailer\spelling), "return")
        return: (cast: (int) (0))
    if: lm_compiler_text_eq((cast: (const: @: c.LmP0Text) frame\trailer\spelling), "end") = 0
        return: (cast: (int) (1))
    if: frame\trailer\body = 0
        return: (cast: (int) (1))
    field: lm_compiler_next_active((cast: (@: c.LmP0Field) frame\trailer\body\first_field))
    if: field = 0 || lm_compiler_next_active((cast: (@: c.LmP0Field) field\next)) != 0
        return: (cast: (int) (1))
    if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: (cast: (int) (1))
    actual: field\value\as\atom
    if: name != 0 && lm_compiler_text_same(actual, name)
        return: (cast: (int) (0))
    if: head != 0 && lm_compiler_text_eq(actual, head)
        return: (cast: (int) (0))
    return: (cast: (int) (1))
end: lm_compiler_fn_close

fn: lm_compiler_source_ret_tr (const: (@: frame c.LmP0Frame)) @: c.LmP0Structure
    if: frame = 0 || frame\trailer = 0 || frame\trailer\spelling = 0
        return: (cast: (@: c.LmP0Structure) (0))
    if: lm_compiler_text_eq((cast: (const: @: c.LmP0Text) frame\trailer\spelling), "return") = 0
        return: (cast: (@: c.LmP0Structure) (0))
    return: (cast: (@: c.LmP0Structure) (frame\trailer\body))
end: lm_compiler_source_ret_tr

fn: lm_compiler_frame_head (const: (@: source_node c.LmP0Node); const: (@: name char)) int
    if: source_node = 0 || source_node\kind != c.LM_P0_NODE_FRAME || source_node\as = 0 || source_node\as\frame = 0
        return: (cast: (int) (0))
    return: (cast: (int) (lm_compiler_text_eq((cast: (const: @: c.LmP0Text) source_node\as\frame\head), name)))
end: lm_compiler_frame_head

fn: lm_compiler_empty_struct (const: (@: source_node c.LmP0Node)) int
    if: source_node = 0 || source_node\kind != c.LM_P0_NODE_STRUCTURE || source_node\as = 0
        return: (cast: (int) (0))
    return: (cast: (int) (lm_compiler_count_active((cast: (const: @: c.LmP0Structure) source_node\as\structure)) = 0))
end: lm_compiler_empty_struct

fn: lm_compiler_triple_fence_n (const: (@: t c.LmP0Text)) size_t
    int: q
    if: t = 0 || t\data = 0 || t\length < 6U
        return: (cast: (size_t) (0U))
    q: (cast: (int) t\data[0])
    if: q != 34 && q != 39
        return: (cast: (size_t) (0U))
    if: t\data[1] != t\data[0] || t\data[2] != t\data[0]
        return: (cast: (size_t) (0U))
    if: t\data[t\length - 1U] != t\data[0] || t\data[t\length - 2U] != t\data[0] || t\data[t\length - 3U] != t\data[0]
        return: (cast: (size_t) (0U))
    return: (cast: (size_t) (3U))
end: lm_compiler_triple_fence_n

fn: lm_compiler_triple_q (const: (@: t c.LmP0Text)) int
    if: lm_compiler_triple_fence_n(t) = 0U
        return: (cast: (int) (0))
    return: (cast: (int) ((cast: (int) t\data[0])))
end: lm_compiler_triple_q

fn: lm_compiler_quoted (const: (@: t c.LmP0Text)) int
    if: t = 0 || t\data = 0 || t\length < 2U
        return: (cast: (int) (0))
    if: lm_compiler_triple_q(t) != 0
        return: (cast: (int) (1))
    if: t\data[0] != 34 || t\data[t\length - 1U] != 34
        return: (cast: (int) (0))
    if: t\length >= 6U && t\data[1] = 34 && t\data[2] = 34
        return: (cast: (int) (0))
    return: (cast: (int) (1))
end: lm_compiler_quoted

fn: lm_compiler_fmt_l1_string (@: dest char; size_t: cap; const: (@: data char); size_t: n) int
    size_t: i 0U
    size_t: o 0U
    int: ch
    size_t: need
    if: dest = 0 || cap < 3U
        return: (cast: (int) (1))
    dest[o]: 34
    o: o + 1U
    while: i < n
        if: data = 0
            return: (cast: (int) (1))
        ch: (cast: (int) data[i])
        if: ch < 0
            ch: ch + 256
        need: 1U
        if: ch = 34 || ch = 92 || ch = 10 || ch = 13 || ch = 63
            need: 2U
        else:
            if: ch < 32 || ch > 126
                need: 4U
            ---
        ---
        if: o + need + 2U > cap
            return: (cast: (int) (1))
        if: ch = 34
            dest[o]: 92
            dest[o + 1U]: 34
            o: o + 2U
