Model:
    size_t: value 1U
end: Model

# A local typed reference receives the existing mo occurrence through ordinary
# Structure-to-reference conversion and admission. Model and mo have distinct
# persistent storage. This tests alias/path reception, not unary @ depth.
fn: check () int
    mo:
        size_t: value 1U
    @: Model r
    size_t: v
    r: mo
    mo\value: 9U
    v: r\value
    if: v != 9U
        return: 1
    r\value: 11U
    v: mo\value
    if: v != 11U
        return: 2
return: 7

sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
