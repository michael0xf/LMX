    l2_hr_val: 0
    l2_hr_n: 0
    l2_hr_cap: 0
    lm_compiler_xfree((cast: (@: void) l2_rb_at))
    lm_compiler_xfree((cast: (@: void) l2_rb_model))
    lm_compiler_xfree((cast: (@: void) l2_rb_meth))
    lm_compiler_xfree((cast: (@: void) l2_rb_own))
    l2_rb_at: 0
    l2_rb_model: 0
    l2_rb_meth: 0
    l2_rb_own: 0
    l2_rb_n: 0
    l2_rb_cap: 0
    lm_compiler_xfree((cast: (@: void) l2_urm_at))
    lm_compiler_xfree((cast: (@: void) l2_urm_val))
    l2_urm_at: 0
    l2_urm_val: 0
    l2_urm_n: 0
    l2_urm_cap: 0
    l2_flow_free()
    l2_e_free()
    l2_ns_def_free()
    # Source tables, method contexts and their part documents belong to one
    # translation. The next pre-table pass must see an empty source context.
    l2_ns_n: 0
    l2_ns_split_any: 0
    l2_spr_n: 0
    l2_spw_n: 0
    l2_spw_failed: 0
    l2_nsf_n: 0
    l2_nsty_n: 0
    l2_ebr_n: 0
    l2_mres_n: 0
    l2_addr_own_n: 0
    l2_call_body_sites_n: 0
    l2_m2_reset()
    l2_mrs_n: 0
    l2_msrc_n: 0
    l2_letter_model_n: 0
    l2_here_at_method(-1, 0)
    l2_here_source_mi: -1
    l2_cur_mi: -1
    l2_own_excl: -1
    l2_cur_unit: 0
    l2_ruse_unit: 0
    l2_src: 0
    l2_os_node: 0
    l2_part_class: 0
    l2_q_at: 0
    l2_q_path: 0
    l2_kind_at: 0
    l2_cv_recv: 0
    l2_cv_ready: 0
    l2_cv_failed: 0
    l2_cv_gap: 0
    l2_cv_said: 0
    l2_cv_used: 0
    l2_pr_ready: 0
    l2_pr_failed: 0
    l2_pr_said: 0
    l2_parts_free()
return: 0

fn: l2_e_free () int
    if: l2_e_fields != 0
        lm_compiler_xfree((cast: (@: void) l2_e_fields))
    if: l2_e_struct != 0
        lm_compiler_xfree((cast: (@: void) l2_e_struct))
    if: l2_e_as != 0
        lm_compiler_xfree((cast: (@: void) l2_e_as))
    if: l2_e_node != 0
        lm_compiler_xfree((cast: (@: void) l2_e_node))
    l2_e_fields: 0
    l2_e_struct: 0
    l2_e_as: 0
    l2_e_node: 0
    l2_e: 0 - 1
    l2_e_n: 0
    l2_vis_on: 0
return: 0

# Is source offset `at` visible from the code being read? A node without a span
# is the translator's own and always visible.
fn: l2_vis_ok (const: @(LmP0Node at)) int
    if: l2_vis_on = 0 || at = 0 || at\span = 0
        return: 1
    # A method of a program part reads another unit (§8): places of two files do not compare, and nothing the
    # source declares is visible from it by its place.
    if: l2_vis_on = 2
        return: 0
return: at\span\offset <= l2_vis_at

# Read everything below as seen from the source position of `at`.
fn: l2_vis_from (const: @(LmP0Node at)) int
    l2_vis_on: 0
    if: at != 0 && at\span != 0
        l2_vis_on: 1
        l2_vis_at: at\span\offset
    ---
return: 0

# A method reads the unit from its header: what is declared above the method is
# visible in its whole body. E reads the unit statement by statement.
fn: l2_vis_method (int: mi) int
    int: ns
    l2_here_at_method(mi, 0)
    l2_here_source_mi: mi
    l2_vis_on: 0
    if: mi >= 0 && mi != l2_e && mi < l2_m_n && l2_m_node[mi] != 0
        l2_vis_from(l2_m_node[mi])
    ---
    # A named Structure's code reads the unit from the Structure's declaration, as a method's from its header: an
    # ordinary declaration is visible forward and down from where it stands, a later one is not (docs
    # #declaration-visibility) -- a name the code reads that only a later declaration spells is a free name.
    if: mi >= 0 && mi != l2_e && mi < l2_m_n && l2_m_node[mi] = 0
        ns: l2_m_nsof(mi)
        if: ns >= 0 && l2_ns_at[ns] != 0
            l2_vis_from(l2_ns_at[ns])
        ---
    ---
    # Code of a program part -- a method a part gave (§8), its root's procedure (§10): nothing of the source is
    # visible from it by its place (l2_vis_ok).
    if: l2_m_code_file(mi) >= 0
        l2_vis_on: 2
return: 0

fn: l2_vis_stmt (int: mi; const: @(LmP0Node stmt)) int
    l2_here_at_method(mi, stmt)
    if: mi >= 0 && mi = l2_e
        l2_vis_from(stmt)
    ---
return: 0

# Is own row oi a unit field as seen from method mi -- reached through the unit,
# not through mi's own occurrence -- and visible from where mi is being read?
# E's top-level own fields are the unit fields; inside E they are E's own.  For a
# method of a program part, its unit's fields are its part's root's (§10),
# reached through its node.
fn: l2_own_unit_seen (int: oi; int: mi) int
    int: k
    @: LmP0Node source
    if: oi < 0 || oi >= l2_own_n || l2_own_host[oi] != 0
        return: 0
    if: l2_own_mi[oi] = mi
        return: 0
    # §10: a method of a program part sees its part's root's fields -- own fields of that root's procedure, in
    # the root's slots -- declared above it in the part, as a method of the source sees the unit's fields.
    k: l2_m_code_file(mi)
    if: k >= 0 && l2_part_ns[k] >= 0 && l2_ns_proc[l2_part_ns[k]] >= 0 && l2_own_mi[oi] = l2_ns_proc[l2_part_ns[k]]
        if: l2_source_definition_method(oi) >= 0
            return: 1
        source: l2_callable_source_node(mi)
        if: l2_own_decl[oi] = 0 || l2_own_decl[oi]\span = 0 || source = 0 || source\span = 0
            return: 1
        return: (cast: (int) (l2_own_decl[oi]\span\offset <= source\span\offset))
    if: l2_e < 0 || l2_own_mi[oi] != l2_e || mi = l2_e
        return: 0
    # Code of a program part -- a method a part gave, its root's procedure -- is another unit's (§8, §10): the
    # source's fields are not in its scope -- a name it reads that it does not declare is a free name, bound
    # by its callers or unresolved.
    if: k >= 0
        return: 0
    if: l2_source_definition_method(oi) >= 0
        return: 1
return: l2_vis_ok(l2_own_decl[oi])

# Unit children that hold callable occurrences: one per method except E, whose
# occurrence is the unit itself.
fn: l2_occ_n () int
    if: l2_e >= 0
        return: l2_e
return: l2_m_n



fn: l2_own_off (int: mi; int: oi) size_t
    size_t: base
    size_t: cap
    size_t: idx
    if: mi < 0 || oi < 0 || l2_own_cap <= 0 || l2_m_cap <= 0 || mi >= l2_m_cap || oi >= l2_own_cap
        return: (cast: (size_t) -1)
    cap: (cast: (size_t) l2_own_cap)
    if: lm_compiler_mul_ok((cast: (size_t) mi), cap) = 0
        return: (cast: (size_t) -1)
    base: (cast: (size_t) mi) * cap
    idx: (cast: (size_t) oi)
    if: base + idx < base
        return: (cast: (size_t) -1)
return: base + idx

fn: l2_own_free () int
    @: L2OwnReuse reuse
    while: l2_own_reuses != 0
        reuse: l2_own_reuses
        l2_own_reuses: reuse\allocated_next
        lm_compiler_xfree((cast: (@: void) reuse))
    ---
    free((cast: (@: void) l2_rw_bseq))
    l2_rw_bseq: 0
    l2_rw_bseq_n: 0
    l2_rw_bseq_cap: 0
    if: l2_own_name != 0
        lm_compiler_xfree((cast: (@: void) l2_own_name))
    if: l2_own_ty != 0
        lm_compiler_xfree((cast: (@: void) l2_own_ty))
    if: l2_own_bseq != 0
        lm_compiler_xfree((cast: (@: void) l2_own_bseq))
    if: l2_own_mi != 0
        lm_compiler_xfree((cast: (@: void) l2_own_mi))
    if: l2_own_host != 0
        lm_compiler_xfree((cast: (@: void) l2_own_host))
    if: l2_own_decl != 0
        lm_compiler_xfree((cast: (@: void) l2_own_decl))
    if: l2_own_fid != 0
        lm_compiler_xfree((cast: (@: void) l2_own_fid))
    if: l2_own_fchild != 0
        lm_compiler_xfree((cast: (@: void) l2_own_fchild))
    if: l2_own_uchild != 0
        lm_compiler_xfree((cast: (@: void) l2_own_uchild))
    if: l2_m_uses != 0
        lm_compiler_xfree((cast: (@: void) l2_m_uses))
    if: l2_m_alias != 0
        lm_compiler_xfree((cast: (@: void) l2_m_alias))
    if: l2_m_pre != 0
        lm_compiler_xfree((cast: (@: void) l2_m_pre))
    if: l2_own_count != 0
        lm_compiler_xfree((cast: (@: void) l2_own_count))
    l2_own_count: 0
    l2_own_name: 0
    l2_own_ty: 0
    l2_own_bseq: 0
    l2_own_mi: 0
    l2_own_host: 0
    l2_own_decl: 0
    l2_own_fid: 0
    l2_own_fchild: 0
    l2_own_uchild: 0
    l2_m_uses: 0
    l2_m_alias: 0
    l2_m_pre: 0
    l2_own_n: 0
    l2_own_cap: 0
return: 0

fn: l2_own_reserve (int: need) int
    size_t: cap
    size_t: need_u
    size_t: rows
    size_t: psz
    size_t: nb
    size_t: ni
    size_t: nmeta
    size_t: oldcap
    size_t: off
    size_t: noff
    int: mi
    int: oi
    @@: LmP0Text nn 0
    @@: LmP0Text nc 0
    @: int nt 0
    @: int nl 0
    @: int nmi 0
    @@: LmP0Node nh 0
    @@: LmP0Node nd 0
    @: int nfid 0
    @: int nfch 0
    @: int nuch 0
    @: int nu 0
    @: int na 0
    @: int np 0
    if: need < 0
        return: 1
    if: need <= l2_own_cap
        return: 0
    if: need > c.INT_MAX
        l2_alloc_err: 2
        return: 1
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) l2_own_cap)
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    if: cap > (cast: (size_t) c.INT_MAX) && need_u > (cast: (size_t) c.INT_MAX)
        l2_alloc_err: 2
        return: 1
    if: cap > (cast: (size_t) c.INT_MAX)
        cap: need_u
    rows: 1U
    if: l2_m_cap > 0
        rows: (cast: (size_t) l2_m_cap)
    if: lm_compiler_mul_ok(rows, cap) = 0
        l2_alloc_err: 2
        return: 1
    nmeta: rows * cap
    psz: c.sizeof(@: char)
    if: lm_compiler_mul_ok(cap, psz) = 0
        l2_alloc_err: 2
        return: 1
    if: lm_compiler_mul_ok(cap, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    if: lm_compiler_mul_ok(nmeta, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    nb: cap * psz
    ni: cap * c.sizeof(c.int)
    l2_alloc_kind: 5
    nn: (cast: (@@: LmP0Text) lm_compiler_xmalloc(nb))
    nc: (cast: (@@: LmP0Text) lm_compiler_xmalloc(nb))
    nt: (cast: (@: int) lm_compiler_xmalloc(ni))
    nl: (cast: (@: int) lm_compiler_xmalloc(ni))
    nmi: (cast: (@: int) lm_compiler_xmalloc(ni))
    nh: (cast: (@@: LmP0Node) lm_compiler_xmalloc(nb))
    nd: (cast: (@@: LmP0Node) lm_compiler_xmalloc(nb))
    nfid: (cast: (@: int) lm_compiler_xmalloc(ni))
    nfch: (cast: (@: int) lm_compiler_xmalloc(ni))
    nuch: (cast: (@: int) lm_compiler_xmalloc(ni))
    nu: (cast: (@: int) lm_compiler_xmalloc(nmeta * c.sizeof(c.int)))
    na: (cast: (@: int) lm_compiler_xmalloc(nmeta * c.sizeof(c.int)))
    np: (cast: (@: int) lm_compiler_xmalloc(nmeta * c.sizeof(c.int)))
    if: nn = 0 || nc = 0 || nt = 0 || nl = 0 || nmi = 0 || nh = 0 || nd = 0 || nfid = 0 || nfch = 0 || nuch = 0 || nu = 0 || na = 0 || np = 0
        if: nc != 0
            lm_compiler_xfree((cast: (@: void) nc))
        if: nn != 0
            lm_compiler_xfree((cast: (@: void) nn))
        if: nt != 0
            lm_compiler_xfree((cast: (@: void) nt))
        if: nl != 0
            lm_compiler_xfree((cast: (@: void) nl))
        if: nmi != 0
            lm_compiler_xfree((cast: (@: void) nmi))
        if: nh != 0
            lm_compiler_xfree((cast: (@: void) nh))
        if: nd != 0
            lm_compiler_xfree((cast: (@: void) nd))
        if: nfid != 0
            lm_compiler_xfree((cast: (@: void) nfid))
        if: nfch != 0
            lm_compiler_xfree((cast: (@: void) nfch))
        if: nuch != 0
            lm_compiler_xfree((cast: (@: void) nuch))
        if: nu != 0
            lm_compiler_xfree((cast: (@: void) nu))
        if: na != 0
            lm_compiler_xfree((cast: (@: void) na))
        if: np != 0
            lm_compiler_xfree((cast: (@: void) np))
        return: 1
    memset((cast: (@: void) nn), 0, nb)
    memset((cast: (@: void) nc), 0, nb)
    memset((cast: (@: void) nt), 0, ni)
    memset((cast: (@: void) nl), 0, ni)
    memset((cast: (@: void) nh), 0, nb)
    memset((cast: (@: void) nd), 0, nb)
    oi: 0
    while: oi < (cast: (int) cap)
        nmi[oi]: -1
        nfid[oi]: -1
        nfch[oi]: -1
        nuch[oi]: -1
        oi: oi + 1
    memset((cast: (@: void) nu), 0, nmeta * c.sizeof(c.int))
    memset((cast: (@: void) np), 0, nmeta * c.sizeof(c.int))
    mi: 0
    while: mi < (cast: (int) rows)
        oi: 0
        while: oi < (cast: (int) cap)
            off: (cast: (size_t) mi) * cap
            off: off + (cast: (size_t) oi)
            na[off]: -1
            oi: oi + 1
        mi: mi + 1
    oldcap: (cast: (size_t) l2_own_cap)
    if: oldcap != 0U && l2_own_name != 0
        oi: 0
        while: oi < l2_own_n
            nn[oi]: l2_own_name[oi]
            nc[oi]: l2_own_count[oi]
            nt[oi]: l2_own_ty[oi]
            nl[oi]: l2_own_bseq[oi]
            nmi[oi]: l2_own_mi[oi]
            nh[oi]: l2_own_host[oi]
            nd[oi]: l2_own_decl[oi]
            nfid[oi]: l2_own_fid[oi]
            nfch[oi]: l2_own_fchild[oi]
            nuch[oi]: l2_own_uchild[oi]
            oi: oi + 1
        mi: 0
        while: mi < l2_m_cap
            oi: 0
            while: oi < l2_own_n
                off: (cast: (size_t) mi) * oldcap
                off: off + (cast: (size_t) oi)
                noff: (cast: (size_t) mi) * cap
                noff: noff + (cast: (size_t) oi)
                nu[noff]: l2_m_uses[off]
                na[noff]: l2_m_alias[off]
                np[noff]: l2_m_pre[off]
                oi: oi + 1
            mi: mi + 1
        lm_compiler_xfree((cast: (@: void) l2_own_name))
        lm_compiler_xfree((cast: (@: void) l2_own_count))
        lm_compiler_xfree((cast: (@: void) l2_own_ty))
        lm_compiler_xfree((cast: (@: void) l2_own_bseq))
        lm_compiler_xfree((cast: (@: void) l2_own_mi))
        lm_compiler_xfree((cast: (@: void) l2_own_host))
        lm_compiler_xfree((cast: (@: void) l2_own_decl))
        lm_compiler_xfree((cast: (@: void) l2_own_fid))
        lm_compiler_xfree((cast: (@: void) l2_own_fchild))
        lm_compiler_xfree((cast: (@: void) l2_own_uchild))
        lm_compiler_xfree((cast: (@: void) l2_m_uses))
        lm_compiler_xfree((cast: (@: void) l2_m_alias))
        lm_compiler_xfree((cast: (@: void) l2_m_pre))
    l2_own_name: nn
    l2_own_count: nc
    l2_own_ty: nt
    l2_own_bseq: nl
    l2_own_mi: nmi
    l2_own_host: nh
    l2_own_decl: nd
    l2_own_fid: nfid
    l2_own_fchild: nfch
    l2_own_uchild: nuch
    l2_m_uses: nu
    l2_m_alias: na
    l2_m_pre: np
    l2_own_cap: (cast: (int) cap)
return: 0

fn: l2_edge_off (int: a; int: b) size_t
    size_t: cap
    size_t: base
    if: a < 0 || b < 0 || l2_m_cap <= 0 || a >= l2_m_cap || b >= l2_m_cap
        return: (cast: (size_t) -1)
    cap: (cast: (size_t) l2_m_cap)
    if: lm_compiler_mul_ok((cast: (size_t) a), cap) = 0
        return: (cast: (size_t) -1)
    base: (cast: (size_t) a) * cap
    if: base + (cast: (size_t) b) < base
        return: (cast: (size_t) -1)
return: base + (cast: (size_t) b)

fn: l2_slot_off (int: mi; int: si) size_t
    size_t: base
    if: mi < 0 || si < 0 || si >= l2_slot_cap || l2_m_cap <= 0 || mi >= l2_m_cap
        return: (cast: (size_t) -1)
    if: lm_compiler_mul_ok((cast: (size_t) mi), (cast: (size_t) l2_slot_cap)) = 0
        return: (cast: (size_t) -1)
    base: (cast: (size_t) mi) * (cast: (size_t) l2_slot_cap)
    if: base + (cast: (size_t) si) < base
        return: (cast: (size_t) -1)
return: base + (cast: (size_t) si)

# Grow the per-method address-slot matrix transactionally. Four is only the
# first allocation size; source semantics have no slot-count limit.
fn: l2_slot_reserve (int: need) int
    size_t: cap
    size_t: oldcap
    size_t: rows
    size_t: count
    size_t: psz
    size_t: off
    size_t: noff
    @@: LmP0Text names 0
    @: int types 0
    int: i
    int: j
    if: need < 0 || l2_m_cap <= 0
        return: 1
    if: need <= l2_slot_cap
        return: 0
    cap: (cast: (size_t) l2_slot_cap)
    if: cap < 1U
        cap: 4U
    while: cap < (cast: (size_t) need)
        if: cap > ((cast: (size_t) -1) / 2U)
            l2_alloc_err: 2
            return: 1
        cap: cap * 2U
    if: cap > (cast: (size_t) c.INT_MAX)
        cap: (cast: (size_t) need)
    rows: (cast: (size_t) l2_m_cap)
    if: lm_compiler_mul_ok(rows, cap) = 0
        l2_alloc_err: 2
        return: 1
    count: rows * cap
    psz: c.sizeof(@: char)
    if: lm_compiler_mul_ok(count, psz) = 0 || lm_compiler_mul_ok(count, c.sizeof(c.int)) = 0
        l2_alloc_err: 2
        return: 1
    l2_alloc_kind: 6
    names: (cast: (@@: LmP0Text) lm_compiler_xmalloc(count * psz))
    types: (cast: (@: int) lm_compiler_xmalloc(count * c.sizeof(c.int)))
    if: names = 0 || types = 0
        if: names != 0
            lm_compiler_xfree((cast: (@: void) names))
        if: types != 0
            lm_compiler_xfree((cast: (@: void) types))
        return: 1
    memset((cast: (@: void) names), 0, count * psz)
    memset((cast: (@: void) types), 0, count * c.sizeof(c.int))
    oldcap: (cast: (size_t) l2_slot_cap)
    i: 0
    # A method being collected occupies row l2_m_n until collection finishes,
    # so copy every allocated row rather than only committed methods.
    while: i < l2_m_cap
        j: 0
        while: j < l2_m_sn[i]
            off: (cast: (size_t) i) * oldcap + (cast: (size_t) j)
            noff: (cast: (size_t) i) * cap + (cast: (size_t) j)
            names[noff]: l2_sn[off]
            types[noff]: l2_st[off]
            j: j + 1
        i: i + 1
    if: l2_sn != 0
        lm_compiler_xfree((cast: (@: void) l2_sn))
    if: l2_st != 0
        lm_compiler_xfree((cast: (@: void) l2_st))
    l2_sn: names
    l2_st: types
    l2_slot_cap: (cast: (int) cap)
return: 0

fn: l2_meth_free () int
    if: l2_m_name != 0
        lm_compiler_xfree((cast: (@: void) l2_m_name))
    if: l2_m_f0 != 0
        lm_compiler_xfree((cast: (@: void) l2_m_f0))
    if: l2_m_f1 != 0
        lm_compiler_xfree((cast: (@: void) l2_m_f1))
    if: l2_m_node != 0
        lm_compiler_xfree((cast: (@: void) l2_m_node))
    if: l2_m_body != 0
        lm_compiler_xfree((cast: (@: void) l2_m_body))
    if: l2_m_sig != 0
        lm_compiler_xfree((cast: (@: void) l2_m_sig))
    if: l2_m_arity != 0
        lm_compiler_xfree((cast: (@: void) l2_m_arity))
    if: l2_m_dyn != 0
        lm_compiler_xfree((cast: (@: void) l2_m_dyn))
    if: l2_m_ret != 0
        lm_compiler_xfree((cast: (@: void) l2_m_ret))
    if: l2_m_value_used != 0
        lm_compiler_xfree((cast: (@: void) l2_m_value_used))
    if: l2_m_own != 0
        lm_compiler_xfree((cast: (@: void) l2_m_own))
    if: l2_m_sn != 0
