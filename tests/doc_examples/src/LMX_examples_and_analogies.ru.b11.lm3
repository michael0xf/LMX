Functions:
    int: x
    return: int
    twice:
        return: x * 2
    next:
        return: x + 1

CompositionProbe:
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxTypeToken
            FxKernelFailure
            SequenceSize
            ReceiverIndex
        @: forward pipe(Functions\twice; Functions\next)
        @: backward pipe(Functions\next; Functions\twice)
        return: forward(4) * 100 + backward(4)
