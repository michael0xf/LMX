TypeData:
    int: damage 2

First:
    @: kind TypeData

Second:
    @: kind TypeData

Operations:
    @: item
    return: int
    damage:
        return: item\kind\damage
    demo:
        TypeData\damage := 2
        int: before damage(item := First)
        TypeData\damage := 3
        return: before * 10 + damage(item := Second)
