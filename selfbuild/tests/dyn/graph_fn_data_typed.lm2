# Real sub/fn construction and ordinary Code exercise the common copier.
# The C ABI supplies exact scalar bytes and observes physical identities.
predef: "l2src/l2_graph_build.lm1"
predef: "l2src/lmx_graph_run.h.lm1"
predef: "l2src/lmx_graph_copy_owned.h.lm1"
predef: "l2src/lmx_walk_values.h.lm1"
predef: "l2src/lmx_value_owned.h.lm1"
predef: "l2src/lmx_gc.h.lm1"
predef: "l2src/lmx_pool.h.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>" "<float.h>"

fn: fd_binding (@: name char; @@: source void) const: @: c.LmxScalarABI
    return: c.lmx_graph_scalar_binding(c.lmx_graph_intern(name, c.strlen(name)), source)

fn: fd_named (@: g c.LmxGraph; @: root c.Lmx; @: name char) @: void
    return: c.lmx_graph_get_in(g, root, c.lmx_graph_named(g, root, c.lmx_graph_intern(name, c.strlen(name))))

fn: fd_cell (@: g c.LmxGraph; @: name char; const: (@: abi c.LmxScalarABI); @: source void; @: model c.Lmx; @: physical c.Lmx; @: bytes void) @: void
    c.LmxWalkValue: context
    c.LmxWalkValue: value
    @: cp c.LmxWalkValue @ context
    @: vp c.LmxWalkValue @ value
    @: cell void 0
    c.lmx_walk_value_clear(cp)
    cp\source_type := source
    cp\model := model
    if: bytes = 0
        cell := c.lmx_arena_scalar_cells_profiled(g\arena, c.LMX_TYPE_FOREIGN, physical, abi, 1U)
        cp := c.lmx_value_cell_context(g\arena, cell)
        if: cp = 0
            return: 0
        cp\source_type := source
        cp\model := model
    else:
        if: c.lmx_walk_value_foreign_capture(g\arena, bytes, c.LMX_TYPE_FOREIGN, abi, physical, cp, vp) != c.LMX_WALK_OK
            return: 0
        cell := vp\ref
    ---
    if: cell = 0 || c.lmx_graph_name(g, cell, name, c.strlen(name)) != 0
        return: 0
    return: cell

fn: fd_expect (@: arena c.LmxArena; @: cell void; const: (@: abi c.LmxScalarABI); @: source void; @: model c.Lmx; @: physical c.Lmx; @: bytes void) int
    @: pool c.LmxPool c.lmx_range_cell_pool(arena, cell)
    @: context c.LmxWalkValue c.lmx_value_cell_context(arena, cell)
    if: pool = 0 || pool\type != c.LMX_TYPE_FOREIGN || pool\scalar_abi != abi || pool\profile != physical || context = 0 || context\present = 0 || context\ref != cell || context\type != pool\type || context\scalar_abi != abi || context\source_type != source || context\model != model || context\physical_profile != physical
        return: 1
    return: c.memcmp(cell, bytes, abi\size)

fn: fd_count (@: g c.LmxGraph; @: parts c.Lmx; int: expected) int
    @: data c.Lmx c.lmx_graph_method_data(g, parts)
    size_t: slot c.lmx_graph_named(g, data, c.lmx_graph_intern("count", 5U))
    int: actual 0
    if: data = 0 || slot >= c.lmx_graph_count(data) || c.lmx_graph_value_int(g, c.lmx_graph_get_in(g, data, slot), @ actual) != 0 || actual != expected
        return: 1
    return: 0

fn: fd_verify_data (@: g c.LmxGraph; @: original c.Lmx; @: data c.Lmx; int: after) int
    @: arena c.LmxArena (cast: (@: c.LmxArena) g\arena)
    @: source void 0
    @: alias_source void 0
    const: (@: abi c.LmxScalarABI fd_binding("double", @ source))
    const: (@: alias_abi c.LmxScalarABI fd_binding("f64", @ alias_source))
    @: physical c.Lmx (cast: (@: c.Lmx) c.lmx_range_profile(arena, c.lmx_graph_get_in(g, original, 0U)))
    @: make c.Lmx (cast: (@: c.Lmx) fd_named(g, (cast: (@: c.Lmx) original\parent), "Make"))
    @: f c.Lmx (cast: (@: c.Lmx) c.lmx_graph_space_find(make, c.lmx_graph_intern("F", 1U)))
    @: source_held c.Lmx (cast: (@: c.Lmx) c.lmx_graph_space_find((cast: (@: c.Lmx) original\parent), c.lmx_graph_intern("Held", 4U)))
    @: held c.Lmx (cast: (@: c.Lmx) c.lmx_arena_pointer_void_read(c.lmx_graph_get_in(g, data, 9U)))
    @: empty void c.lmx_graph_get_in(g, data, 4U)
    @: context c.LmxWalkValue c.lmx_value_cell_context(arena, empty)
    @: word void c.lmx_graph_get_in(g, data, 5U)
    @: other_word void c.lmx_graph_get_in(g, data, 7U)
    @: pool c.LmxPool c.lmx_range_cell_pool(arena, word)
    double: zero (cast: (double) 0)
    double: precise (cast: (double) 1) + c.DBL_EPSILON
    double: replacement c.strtod("3.5", 0)
    double: x_value zero
    double: y_value precise
    double: initialized precise
    int: touched 0
    if: after != 0
        x_value := precise
        y_value := replacement
    ---
    if: abi = 0 || alias_abi != abi || f = 0 || c.lmx_graph_method(g, f) = 0 || data = original || data != c.lmx_graph_method_data(g, f) || data\parent != f || c.lmx_graph_count(data) != 11U || c.lmx_graph_name_of(g, (cast: (@: void) data)) != c.lmx_graph_intern("data", 4U)
        return: 101
    if: fd_expect(arena, c.lmx_graph_get_in(g, data, 0U), abi, source, data, physical, @ x_value) != 0 || fd_expect(arena, c.lmx_graph_get_in(g, data, 1U), abi, alias_source, data, physical, @ y_value) != 0 || fd_expect(arena, c.lmx_graph_get_in(g, data, 2U), abi, source, data, physical, @ replacement) != 0 || fd_expect(arena, c.lmx_graph_get_in(g, data, 3U), abi, source, data, physical, @ x_value) != 0
        return: 102
    if: fd_expect(arena, c.lmx_graph_get_in(g, original, 0U), abi, source, original, physical, @ zero) != 0 || fd_expect(arena, c.lmx_graph_get_in(g, original, 1U), abi, alias_source, original, physical, @ precise) != 0 || fd_expect(arena, c.lmx_graph_get_in(g, original, 3U), abi, source, original, physical, @ zero) != 0 || c.lmx_graph_get_in(g, data, 0U) = c.lmx_graph_get_in(g, original, 0U)
        return: 103
    if: abi\init(@ initialized) != 0 || empty = c.lmx_graph_get_in(g, original, 4U) || context = 0 || context\present != 0 || context\ref != empty || context\kind != c.LMX_WALK_VALUE_FOREIGN || context\type != c.LMX_TYPE_FOREIGN || context\scalar_abi != abi || context\source_type != alias_source || context\model != data || context\physical_profile != physical || c.memcmp(empty, @ initialized, abi\size) != 0
        return: 104
    if: word = 0 || word = c.lmx_graph_get_in(g, original, 5U) || word != c.lmx_graph_get_in(g, data, 6U) || other_word = word || other_word = c.lmx_graph_get_in(g, original, 7U) || pool = 0 || pool\type != c.LMX_TYPE_WORD || pool\profile != physical || c.lmx_graph_word_text(g, word) != c.lmx_graph_word_text(g, other_word) || c.lmx_graph_word_text(g, word) != c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, original, 5U))
        return: 105
    if: c.lmx_arena_pointer_void_read(c.lmx_graph_get_in(g, data, 8U)) != data || c.lmx_arena_pointer_void_read(c.lmx_graph_get_in(g, original, 8U)) != original || c.lmx_graph_slot_name(g, data, 10U) != c.lmx_graph_intern("touched", 7U)
        return: 106
    if: held = 0 || held = source_held || c.lmx_graph_fn_result(g, (cast: (@: void) held)) != 0 || c.lmx_graph_method(g, held) != 0 || fd_count(g, held, 3) != 0 || fd_count(g, source_held, 3) != 0
        return: 107
    if: after != 0
        @: again c.Lmx (cast: (@: c.Lmx) c.lmx_graph_space_find(make, c.lmx_graph_intern("Again", 5U)))
        if: c.lmx_graph_value_int(g, c.lmx_graph_get_in(g, data, 10U), @ touched) != 0 || touched != 7 || again = 0 || c.lmx_graph_method(g, again) = 0 || fd_count(g, again, 4) != 0 || c.lmx_graph_method_data(g, again) = c.lmx_graph_method_data(g, held)
            return: 108
        ---
    ---
    return: 0

fn: fd_callback (@: owner void; @@: refs void; size_t: nargs; @: dest void; @@: out void; @: arena c.LmxArena; @: code c.Lmx; @: inputs c.LmxWalkValue; @: result c.LmxWalkValue) int
    @: g c.LmxGraph c.lmx_graph_find(arena)
    @: root c.Lmx (cast: (@: c.Lmx) code\parent)
    @: original c.Lmx (cast: (@: c.Lmx) c.lmx_graph_space_find(root, c.lmx_graph_intern("D", 1U)))
    @: data c.Lmx (cast: (@: c.Lmx) owner)
    size_t: checked_slot c.lmx_graph_named(g, root, c.lmx_graph_intern("checked", 7U))
    int: after (cast: (int) (c.lmx_graph_name_of(g, (cast: (@: void) code)) = c.lmx_graph_intern("Verify", 6U)))
    int: checked 0
    int: status 0
    if: g = 0 || original = 0 || nargs != 0U || c.lmx_graph_value_int(g, c.lmx_graph_get_in(g, root, checked_slot), @ checked) != 0 || checked != after
        return: 109
    status := fd_verify_data(g, original, data, after)
    if: status != 0
        c.fprintf(c.stderr, "fn_data phase %d check %d\n", after, status)
        return: status
    if: after != 0
        @: make c.Lmx (cast: (@: c.Lmx) fd_named(g, root, "Make"))
        @: f c.Lmx (cast: (@: c.Lmx) c.lmx_graph_space_find(make, c.lmx_graph_intern("F", 1U)))
        @: again c.Lmx (cast: (@: c.Lmx) c.lmx_graph_space_find(make, c.lmx_graph_intern("Again", 5U)))
        unsigned: gen c.lmx_arena_generation_next(arena)
        if: c.lmx_gc_mark_value(arena, original, gen, 0) != c.LMX_GC_OK || c.lmx_gc_mark_value(arena, f, gen, 0) != c.LMX_GC_OK || c.lmx_gc_mark_value(arena, again, gen, 0) != c.LMX_GC_OK || c.lmx_gc_sweep(arena, gen) != c.LMX_GC_OK || fd_verify_data(g, original, data, after) != 0
            return: 110
        ---
    ---
    if: c.lmx_graph_assign_int(g, code, root, checked_slot, after + 1) != 0
        return: 111
    if: out != 0
        out[0] := 0
    if: result != 0
        c.lmx_walk_value_clear(result)
    return: 0

# The canonical TEXT interner outlives the source arena. This is the existing
# cross-arena API with an explicitly selected destination physical profile.
fn: fd_word_cross () int
    c.LmxArena: src
    c.LmxArena: dst
    c.memset((cast: (@: void) (@ src)), 0, c.sizeof(c.LmxArena))
    c.memset((cast: (@: void) (@ dst)), 0, c.sizeof(c.LmxArena))
    if: c.lmx_arena_open(@ src) != 0 || c.lmx_arena_open(@ dst) != 0
        return: 112
    @: sg c.LmxGraph c.lmx_graph_open(@ src)
    @: dg c.LmxGraph c.lmx_graph_open(@ dst)
    @: root c.Lmx c.lmx_graph_lmx(sg, 0, 3U)
    @: copied c.Lmx 0
    @: physical c.Lmx c.lmx_node_new_owned(@ dst)
    @: word_a void c.lmx_graph_word(sg, "token", 5U)
    @: word_b void c.lmx_graph_word(sg, "token", 5U)
    @: canon char c.lmx_graph_word_text(sg, word_a)
    c.LmxCopyMap: pending
    c.LmxCopyMap: relocated
    int: status 0
    c.memset((cast: (@: void) (@ pending)), 0, c.sizeof(c.LmxCopyMap))
    c.memset((cast: (@: void) (@ relocated)), 0, c.sizeof(c.LmxCopyMap))
    if: sg = 0 || dg = 0 || root = 0 || physical = 0 || word_a = 0 || word_b = word_a || c.lmx_graph_put_in(sg, root, 0U, word_a) != 0 || c.lmx_graph_put_in(sg, root, 1U, word_a) != 0 || c.lmx_graph_put_in(sg, root, 2U, word_b) != 0
        return: 113
    status := c.lmx_graph_copy_forest_profiled_staged(@ root, 1U, @ src, @ dst, 0, 0U, physical, @ copied, @ pending, @ relocated)
    c.lmx_copy_names_finish(@ pending, (cast: (int) (status = c.LMX_GRAPH_COPY_OK)))
    c.lmx_graph_copy_map_dispose(@ relocated)
    if: status != c.LMX_GRAPH_COPY_OK || copied = 0 || c.lmx_graph_get_in(dg, copied, 0U) = word_a || c.lmx_graph_get_in(dg, copied, 0U) != c.lmx_graph_get_in(dg, copied, 1U) || c.lmx_graph_get_in(dg, copied, 2U) = word_b || c.lmx_graph_get_in(dg, copied, 2U) = c.lmx_graph_get_in(dg, copied, 0U)
        return: 114
    c.lmx_graph_close(sg)
    c.lmx_arena_release(@ src)
    @: first void c.lmx_graph_get_in(dg, copied, 0U)
    @: second void c.lmx_graph_get_in(dg, copied, 2U)
    @: pool c.LmxPool c.lmx_range_cell_pool(@ dst, first)
    unsigned: gen c.lmx_arena_generation_next(@ dst)
    if: pool = 0 || pool\type != c.LMX_TYPE_WORD || pool\profile != physical || c.lmx_graph_word_text(dg, first) != canon || c.lmx_graph_word_text(dg, second) != canon || c.strcmp(canon, "token") != 0 || c.lmx_gc_mark_value(@ dst, copied, gen, 0) != c.LMX_GC_OK || c.lmx_gc_sweep(@ dst, gen) != c.LMX_GC_OK || c.lmx_graph_word_text(dg, c.lmx_graph_get_in(dg, copied, 0U)) != canon
        return: 115
    c.lmx_graph_close(dg)
    c.lmx_arena_release(@ dst)
    return: 0

fn: fd_merge_callback (@: owner void; @@: refs void; size_t: nargs; @: dest void; @@: out void; @: arena c.LmxArena; @: code c.Lmx; @: inputs c.LmxWalkValue; @: result c.LmxWalkValue) int
    @: g c.LmxGraph c.lmx_graph_find(arena)
    @: root c.Lmx (cast: (@: c.Lmx) code\parent)
    @: m c.Lmx (cast: (@: c.Lmx) c.lmx_graph_space_find(root, c.lmx_graph_intern("M", 1U)))
    @: n c.Lmx (cast: (@: c.Lmx) c.lmx_graph_space_find(root, c.lmx_graph_intern("N", 1U)))
    @: merged c.Lmx (cast: (@: c.Lmx) owner)
    @: source void 0
    @: alias_source void 0
    const: (@: abi c.LmxScalarABI fd_binding("double", @ source))
    const: (@: alias_abi c.LmxScalarABI fd_binding("f64", @ alias_source))
    @: cell void c.lmx_graph_get_in(g, merged, 0U)
    @: pointer void fd_named(g, merged, "cellAlias")
    @: slot_pointer void fd_named(g, merged, "slotAlias")
    @: context c.LmxWalkValue c.lmx_value_cell_context(arena, pointer)
    size_t: checked_slot c.lmx_graph_named(g, root, c.lmx_graph_intern("merge_checks", 12U))
    int: checked 0
    double: zero (cast: (double) 0)
    double: precise (cast: (double) 1) + c.DBL_EPSILON
    double: expected precise
    if: c.lmx_graph_value_int(g, c.lmx_graph_get_in(g, root, checked_slot), @ checked) != 0 || checked < 0 || checked > 1
        return: 120
    if: checked = 1
        expected := zero
    if: nargs != 0U || merged = m || merged = n || c.lmx_graph_count(merged) != 4U || c.lmx_graph_named(g, merged, c.lmx_graph_intern("x", 1U)) != 0U || merged\parent != 0 || fd_expect(arena, cell, abi, source, merged, 0, @ expected) != 0
        return: 121
    if: pointer = 0 || slot_pointer = 0 || c.lmx_pointer_value_in(arena, pointer) != cell || c.lmx_pointer_value_in(arena, slot_pointer) != c.lmx_graph_ref_cell_in(arena, merged, 0U) || context = 0 || context\referent != c.lmx_value_cell_context(arena, cell)
        return: 122
    if: fd_expect(arena, c.lmx_graph_get_in(g, m, 0U), abi, source, m, 0, @ zero) != 0 || fd_expect(arena, c.lmx_graph_get_in(g, n, 2U), alias_abi, alias_source, n, 0, @ precise) != 0 || c.lmx_pointer_value_in(arena, c.lmx_graph_get_in(g, n, 0U)) != c.lmx_graph_get_in(g, n, 2U) || c.lmx_pointer_value_in(arena, c.lmx_graph_get_in(g, n, 1U)) != c.lmx_graph_ref_cell_in(arena, n, 2U)
        return: 123
    if: c.lmx_graph_assign_int(g, code, root, checked_slot, checked + 1) != 0
        return: 124
    if: out != 0
        out[0] := 0
    if: result != 0
        c.lmx_walk_value_clear(result)
    return: 0
end: fd_merge_callback

fn: fd_merge_ref (@: g c.LmxGraph; @: target c.Lmx; @: name char) @: void
    @: cell void c.lmx_graph_ref_lmx(g, target)
    if: cell = 0 || c.lmx_graph_name(g, cell, name, c.strlen(name)) != 0
        return: 0
    return: cell
end: fd_merge_ref

# Shared P in three siblings is composed with Q,R,Q. One receiving header
# must contain p/q/r, and the final q comes from the repeated late Q.
fn: fd_merge_siblings (@: g c.LmxGraph) int
    @: arena c.LmxArena (cast: (@: c.LmxArena) g\arena)
    @: p c.Lmx c.lmx_graph_lmx(g, 0, 1U)
    @: q c.Lmx c.lmx_graph_lmx(g, 0, 1U)
    @: r c.Lmx c.lmx_graph_lmx(g, 0, 2U)
    @: m c.Lmx c.lmx_graph_lmx(g, 0, 3U)
    @: n c.Lmx c.lmx_graph_lmx(g, 0, 3U)
    @: copied void 0
    @: common c.Lmx 0
    @: source void 0
    const: (@: abi c.LmxScalarABI fd_binding("f64", @ source))
    double: precise (cast: (double) 1) + c.DBL_EPSILON
    double: replacement c.strtod("3.5", 0)
    @: p_value void c.lmx_graph_int(g, 1)
    @: q_value void fd_cell(g, "q", abi, source, q, 0, @ precise)
    @: r_value void c.lmx_graph_int(g, 3)
    @: r_q void fd_cell(g, "q", abi, source, r, 0, @ replacement)
    @@: operands void (cast: (@@: void) c.calloc(2U, sizeof(@: void)))
    int: status 0
    int: number 0
    if: p = 0 || q = 0 || r = 0 || m = 0 || n = 0 || p_value = 0 || q_value = 0 || r_value = 0 || r_q = 0 || operands = 0
        return: 125
    if: c.lmx_graph_name(g, p_value, "p", 1U) != 0 || c.lmx_graph_name(g, r_value, "r", 1U) != 0 || c.lmx_graph_put_in(g, p, 0U, p_value) != 0 || c.lmx_graph_put_in(g, q, 0U, q_value) != 0 || c.lmx_graph_put_in(g, r, 0U, r_value) != 0 || c.lmx_graph_put_in(g, r, 1U, r_q) != 0
        return: 126
    if: c.lmx_graph_put_in(g, m, 0U, fd_merge_ref(g, p, "a")) != 0 || c.lmx_graph_put_in(g, m, 1U, fd_merge_ref(g, p, "b")) != 0 || c.lmx_graph_put_in(g, m, 2U, fd_merge_ref(g, p, "c")) != 0 || c.lmx_graph_put_in(g, n, 0U, fd_merge_ref(g, q, "a")) != 0 || c.lmx_graph_put_in(g, n, 1U, fd_merge_ref(g, r, "b")) != 0 || c.lmx_graph_put_in(g, n, 2U, fd_merge_ref(g, q, "c")) != 0
        return: 127
    operands[0] := m
    operands[1] := n
    status := c.lmx_graph_merge_values(g, operands, 2U, @ copied)
    c.free((cast: (@: void) operands))
    if: status != 0 || copied = 0
        return: 128
    common := (cast: (@: c.Lmx) c.lmx_pointer_value_in(arena, fd_named(g, (cast: (@: c.Lmx) copied), "a")))
    if: common = 0 || common = p || common = q || common = r || c.lmx_graph_count(common) != 3U || c.lmx_pointer_value_in(arena, fd_named(g, (cast: (@: c.Lmx) copied), "b")) != common || c.lmx_pointer_value_in(arena, fd_named(g, (cast: (@: c.Lmx) copied), "c")) != common
        return: 129
    if: fd_expect(arena, fd_named(g, common, "q"), abi, source, common, 0, @ precise) != 0 || c.lmx_graph_value_int(g, fd_named(g, common, "p"), @ number) != 0 || number != 1 || c.lmx_graph_value_int(g, fd_named(g, common, "r"), @ number) != 0 || number != 3 || fd_expect(arena, q_value, abi, source, q, 0, @ precise) != 0 || fd_expect(arena, r_q, abi, source, r, 0, @ replacement) != 0
        return: 130
    return: 0
end: fd_merge_siblings

fn: fd_merge_pointer (@: g c.LmxGraph; @: target void; @: name char) @: void
    @: cell void c.lmx_pointer_new_profiled(c.LMX_TYPE_CELL_POINTER, (cast: (@: c.LmxArena) g\arena), 0)
    if: cell = 0 || c.lmx_pointer_store_in(g\arena, cell, target) != 0 || c.lmx_graph_name(g, cell, name, c.strlen(name)) != 0
        return: 0
    return: cell
end: fd_merge_pointer

fn: fd_merge_word_aliases (@: g c.LmxGraph) int
    @: arena c.LmxArena (cast: (@: c.LmxArena) g\arena)
    @: physical c.Lmx c.lmx_node_new_owned(arena)
    @: m c.Lmx c.lmx_graph_lmx(g, 0, 2U)
    @: n c.Lmx c.lmx_graph_lmx(g, 0, 2U)
    @: first void c.lmx_scalar_new_physical_profiled(arena, c.LMX_TYPE_WORD, physical)
    @: late void c.lmx_scalar_new_physical_profiled(arena, c.LMX_TYPE_WORD, physical)
    @: copied void 0
    @: cell void 0
    @: pool c.LmxPool 0
    @: old_text char c.lmx_graph_intern("old", 3U)
    @: new_text char c.lmx_graph_intern("new", 3U)
    @@: operands void (cast: (@@: void) c.calloc(2U, sizeof(@: void)))
    int: status 0
    if: physical = 0 || m = 0 || n = 0 || first = 0 || late = 0 || operands = 0 || c.lmx_charptr_store_known(first, old_text) != 0 || c.lmx_charptr_store_known(late, new_text) != 0 || c.lmx_graph_name(g, first, "x", 1U) != 0 || c.lmx_graph_name(g, late, "x", 1U) != 0
        return: 140
    if: c.lmx_graph_put_in(g, m, 0U, first) != 0 || c.lmx_graph_put_in(g, m, 1U, fd_merge_pointer(g, first, "firstWord")) != 0 || c.lmx_graph_put_in(g, n, 0U, fd_merge_pointer(g, late, "lateWord")) != 0 || c.lmx_graph_put_in(g, n, 1U, late) != 0
        return: 141
    operands[0] := m
    operands[1] := n
