# One place for one name: the declared number of neighbouring inline bodies.
fn: m (int: k) int
    if: k = 0
        int: x 3
    ---
    if: k = 1
        int: x 7
    ---
    return: x
end: m
int: first m(0)
int: second m(1)
sendMessage: exit(exit_code: first * 10 + second; stdout: ""; stderr: "")
return
