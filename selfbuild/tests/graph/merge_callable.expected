---
    Observed:
        int: k 5
        int: r1 15
        int: r2 15
        int: r3 25
        int: c1 1
        int: c2 2
    end: Observed
---
@: shared (data [] 0)
int: k 2
fn: f1 (int: a) int (
    int: calls 0
)
    :=: (data \ calls) ((data \ calls) + 1)
    return: ((a * 10) + k)
end: f1
fn:
    g
    merge: f1
end: fn
:=: k 5
int: r1 (f1 1)
int: r2 (g 1)
int: r3 (g 2)
int: c1 ((f1 \ data) \ calls)
int: c2 ((g \ data) \ calls)
sub: main ()
    :=: ((shared \ Observed) \ k) k
    :=: ((shared \ Observed) \ r1) r1
    :=: ((shared \ Observed) \ r2) r2
    :=: ((shared \ Observed) \ r3) r3
    :=: ((shared \ Observed) \ c1) c1
    :=: ((shared \ Observed) \ c2) c2
end: main
main:
