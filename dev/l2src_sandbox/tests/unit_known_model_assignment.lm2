# Both names already exist. Model: Other replaces Model's reference after
# admission; it does not declare a second field or call a method.
Model:
    int: v 11
end: Model
Other:
    int: v 23
end: Other
Model: Other
int: code 7
if: Model\v != 23
    code: 90
end: if
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
