---
    Observed:
        int: seen 3
    end: Observed
---
sub: main () (
    Point: a b
    int: seen 0
)
    fn: f () int (
        Point: a b c
    )
        return: (length Point)
    end: f
    :=: (data \ seen) (f)
end: main
main:
int: seen ((main \ data) \ seen)
sub: observe ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) seen
end: observe
observe:
