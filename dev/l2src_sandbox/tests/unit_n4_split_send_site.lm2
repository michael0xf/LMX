# N4 (LMX_semantics.ru.md #method-parts): a send site of the code is a place of the code graph, reached from the
# selected code occurrence, never through the data: S sends exit with the x of D plus 1. Entry 7.
S:
    int: x
    x: x + 1
    sendMessage: exit(exit_code: x; stdout: ""; stderr: "")
end: S
D:
    int: pad 0
    int: x 6
end: D
call: S D
sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
return
