try { [Console]::OutputEncoding=[System.Text.Encoding]::UTF8 } catch {}
# FE83 with RT83 on their own coherent stage83 (kernel declaration headers
# regenerated by RT83 from writer83). owner73b keeps the two local
# observation bridges of CODEX-OPUS-81ANS (BARE-DEREF-ACTUAL-MERGED OPEN).
$p='C:\Nyasha_Planet\LMX\build2\codex_fix250generationchain01'
$P2='C:/Nyasha_Planet/LMX/build2/codex_fix250generationchain01'
$repo='C:/Nyasha_Planet/LMX'
$tool="$p\cold-generator83b\tool83b-parts\lmxtool-tool.exe"
$term="$p\pins\suites83.terminal.txt"
$live=Get-CimInstance Win32_Process -Filter "Name = 'l2trans.exe' OR Name = 'l1trans.exe' OR Name = 'cc1.exe' OR Name = 'lmxtool-tool.exe'"
if ($live) { $live | Select-Object ProcessId,Name | Out-String | Write-Output; throw 'pipeline already live' }
if (-not (Test-Path -LiteralPath "$p\cold-candidate83\fe83\l2trans.exe")) { throw 'nofe83' }
if (-not (Test-Path -LiteralPath "$p\cold-candidate83\rt83\driver.o")) { throw 'nort83' }
if (Test-Path -LiteralPath $term) { throw 'terminalexists' }
Remove-Item Env:CPATH,Env:C_INCLUDE_PATH,Env:CPLUS_INCLUDE_PATH,Env:LIBRARY_PATH -ErrorAction SilentlyContinue
$suiteRows = @(
  ,@('held-forward78', 'held-forward78.tsv')
  ,@('owner-values73b-hidden55', 'owner-values73b-callable-hidden55.tsv')
)
foreach ($suiteRow in $suiteRows) {
  $name="$($suiteRow[0])-fe83-rt83-suite"
  $out="$p\$name-01"
  $cwd="$p\$name-run-01"
  if ((Test-Path -LiteralPath $out) -or (Test-Path -LiteralPath $cwd)) { throw "exists $name" }
  $argv=@('suite', "$P2/pins/$($suiteRow[1])", $repo, "$P2/cold-candidate83", "$P2/cold-candidate48/full48/g2/frontend", "$P2/cold-candidate83/fe83/l2trans.exe", "$P2/cold-candidate83/rt83/driver.o", "$P2/$name-01", "$P2/cold-candidate83/rt83/driver-observe.o")
  if ($argv.Count -ne 9) { throw "argv $($argv.Count)" }
  New-Item -ItemType Directory -Path $cwd | Out-Null
  Set-Location -LiteralPath $cwd
  Add-Content -LiteralPath $term -Value ([DateTime]::UtcNow.ToString('o') + " start $name argv: 0 entry 0 -- " + ($argv -join ' ')) -Encoding utf8
  & $tool 0 entry 0 -- @argv *> "$p\pins\$name-01.log"
  $e=$LASTEXITCODE
  Add-Content -LiteralPath $term -Value ([DateTime]::UtcNow.ToString('o') + " $name exit=$e") -Encoding utf8
}
Write-Output 'SUITES83 done'
