# Two T7 views of one P0 body must retain independent anonymous containers.
fn: add (int: y; int: x) int
    (1 + 2; ())
    return: y + x
fn: wrap (int: k) fn: (int: x) int
    return: merge(y: k; add)
w: wrap 5
u: wrap 100
int: a (w: 1)
int: b (u: 1)
int: c (w: 1)
int: ok 0
if: a = 6 && b = 101 && c = 6
    ok: 7
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
