# ABI parity guard — L1 port of mixa_app_window_abi_probe_l2.c (ticket 20260918-082421).
# offsetof is a C macro with no L1 spelling (c. pastes a call, not a preprocessor
# name). Field offsets are computed at run time via pointer arithmetic on a local
# store (same pattern as l2src/lmx_message_selftest.lm1). Output format strings
# are kept byte-identical to the C probe so L2-vs-real parity still diffs stdout.
predef: "mixa_manager/mixa_app_window_l2.h.lm1"
include: "<stdio.h>"

fn: main () int
    MixaAppWindow: store0
    @: MixaAppWindow p0
    p0: @ store0
    MixaAppWindowStack: store1
    @: MixaAppWindowStack p1
    p1: @ store1

    c.printf("MixaAppWindow sizeof=%zu\n", c.sizeof(c.MixaAppWindow))
    c.printf("MixaAppWindow saved=%zu\n", (cast: (size_t) @ p0\saved) - (cast: (size_t) p0))
    c.printf("MixaAppWindow saved_count=%zu\n", (cast: (size_t) @ p0\saved_count) - (cast: (size_t) p0))
    c.printf("MixaAppWindow panel=%zu\n", (cast: (size_t) @ p0\panel) - (cast: (size_t) p0))
    c.printf("MixaAppWindow msg_row=%zu\n", (cast: (size_t) @ p0\msg_row) - (cast: (size_t) p0))
    c.printf("MixaAppWindow msg_col=%zu\n", (cast: (size_t) @ p0\msg_col) - (cast: (size_t) p0))
    c.printf("MixaAppWindow origin_row=%zu\n", (cast: (size_t) @ p0\origin_row) - (cast: (size_t) p0))
    c.printf("MixaAppWindow origin_col=%zu\n", (cast: (size_t) @ p0\origin_col) - (cast: (size_t) p0))
    c.printf("MixaAppWindow nrows=%zu\n", (cast: (size_t) @ p0\nrows) - (cast: (size_t) p0))
    c.printf("MixaAppWindow ncols=%zu\n", (cast: (size_t) @ p0\ncols) - (cast: (size_t) p0))
    c.printf("MixaAppWindow hb=%zu\n", (cast: (size_t) @ p0\hb) - (cast: (size_t) p0))
    c.printf("MixaAppWindow is_open=%zu\n", (cast: (size_t) @ p0\is_open) - (cast: (size_t) p0))
    c.printf("MixaAppWindowStack sizeof=%zu\n", c.sizeof(c.MixaAppWindowStack))
    c.printf("MixaAppWindowStack windows=%zu\n", (cast: (size_t) @ p1\windows) - (cast: (size_t) p1))
    c.printf("MixaAppWindowStack count=%zu\n", (cast: (size_t) @ p1\count) - (cast: (size_t) p1))
    c.printf("MixaAppWindowStack cap=%zu\n", (cast: (size_t) @ p1\cap) - (cast: (size_t) p1))
    c.printf("MixaAppWindowStack is_open=%zu\n", (cast: (size_t) @ p1\is_open) - (cast: (size_t) p1))
    return: 0

