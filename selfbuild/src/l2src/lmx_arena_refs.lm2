# Arena's array of references: a Structure's child-pointer array is an array of
# the arena like every other (SPEC 1237 / SPEC 2 at 1141). The arena allocates
# it, owns it, and its descriptor -- KIND_CHILDREN with TYPE_REFS (ABI number 7)
# -- answers for every slot. data addresses an ordered array of void * child
# values and array.size is exactly their count. A slot holds the address of its child's
# value in the array of that child's type; a slot ADDRESS classifies as the
# storage location it is (KIND_CHILDREN), never as the child.
#
# Only an empty parent may be opened. This storage constructor does not alter
# structural parent link; graph-copy traversal performs parent fixups.
#
# A machine module (L2 section 20): each function has a direct C-compatible entry, and the kernel's code calls it with
# its explicit arguments. The build writes its header, lmx_arena_refs.h.lm1, with its exports. The records it
# reads and writes (Lmx, its by-value VoidArray, LmxPool, LmxRange, LmxChunk) are in the kernel's headers that L3 code
# of the recipe writes as L1 text (decls_write_all, tools/l2/build.lm2); the index's acts (lmx_range_*) and the arrays'
# (lmx_pool_*, lmx_chunk_*) are the kernel's C functions, called through the C door. A Structure's or an Array's
# by-value VoidArray is read and written through its address.
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_pool.h.lm1"
predef: "l2src/lmx_implements.h.lm1"
predef: "l2src/lmx_source_names.h.lm1"
predef: "l2src/lmx_walk.h.lm1"
include: "<stdlib.h>"

# A graph header selected by its actual typed pool, never by field shape
# or by casting a raw C/List descriptor. Both Structure and Array use it.
fn: lmx_graph_node_in (c.LmxArena@: arena; @: value) c.Lmx@
    int: kind 0
    if: arena = 0 || value = 0
        return: 0
    kind := (cast: (int) c.lmx_range_classify(arena, value))
    if: kind != c.LMX_KIND_STRUCT && kind != c.LMX_KIND_ARRAY
        return: 0
    if: (cast: (size_t) c.lmx_range_stride(arena, value)) != c.sizeof(c.Lmx)
        return: 0
    return: (cast: (Lmx@) value)
end: lmx_graph_node_in

fn: lmx_graph_backing_cell_in (c.LmxArena@: arena; c.Lmx@: array; size_t: index) @
    size_t: stride 0U
    int: expected_type c.LMX_TYPE_NONE
    size_t: offset 0U
    size_t: start 0U
    size_t: issued 0U
    @: cell void 0
    c.LmxPool@: pool 0
    c.LmxRange@: entry 0
    c.LmxChunk@: chunk 0
    c.VoidArray@: va 0
    if: lmx_graph_node_in(arena, (cast: (@) array)) = 0
        return: 0
    if: arena = 0 || array = 0
        return: 0
    va := @ array\array
    if: va\data = 0 || index >= (cast: (size_t) va\size)
        return: 0
    pool := (cast: (LmxPool@) c.lmx_range_cell_pool(arena, va\data))
    stride := (cast: (size_t) c.lmx_range_stride(arena, va\data))
    entry := (cast: (LmxRange@) c.lmx_range_entry_at(arena, va\data))
    if: pool = 0 || entry = 0 || entry\array != pool || stride = 0U || index > ((cast: (size_t) -1) / stride)
        return: 0
    if: (cast: (int) c.lmx_range_classify(arena, (cast: (@) array))) = c.LMX_KIND_STRUCT
        expected_type := c.lmx_type_storage_like(c.lmx_range_type_of(arena, (cast: (@) array)), c.LMX_TYPE_REFS)
        if: expected_type = c.LMX_TYPE_NONE || (pool\kind != c.LMX_KIND_CHILDREN && pool\kind != c.LMX_KIND_FIELD_ADDRESSES) || c.lmx_type_base(pool\type) != c.LMX_TYPE_REFS || (c.lmx_type_is_immutable(expected_type) != 0 && pool\type != expected_type) || stride != sizeof(@)
            return: 0
        ---
    else:
        expected_type := c.lmx_type_element(c.lmx_range_type_of(arena, (cast: (@) array)))
        if: expected_type = c.LMX_TYPE_NONE || pool\type != expected_type || (pool\kind != c.LMX_KIND_REF && pool\kind != c.LMX_KIND_PRIMITIVE)
            return: 0
        ---
    ---
    chunk := (cast: (LmxChunk@) c.lmx_pool_chunk_at(pool, entry\lo))
    if: chunk = 0 || (cast: (size_t) c.lmx_chunk_cells(chunk, stride)) > (cast: (size_t) c.lmx_chunk_room(chunk, stride))
        return: 0
    offset := (cast: (size_t) va\data) - (cast: (size_t) entry\lo)
    if: offset % stride != 0U
        return: 0
    start := offset / stride
    issued := (cast: (size_t) c.lmx_chunk_cells(chunk, stride))
    # The descriptor's claimed span must fit within issued cells of this
    # single backing chunk before any C pointer arithmetic is performed.
    if: start > issued || (cast: (size_t) va\size) > issued - start
        return: 0
    cell := (cast: (@) ((cast: (char@) va\data) + index * stride))
    if: (cast: (LmxPool@) c.lmx_range_cell_pool(arena, cell)) != pool
        return: 0
    return: cell
end: lmx_graph_backing_cell_in

# One backing-cell address algorithm for graph fields and Array elements.
# The physical pool supplies stride; a primitive T cell is not void*.
fn: lmx_graph_cell_in (c.LmxArena@: arena; c.Lmx@: graph_node; size_t: index) @
    @: cell void 0
    int: expected_type c.LMX_TYPE_NONE
    @@: address void 0
    c.LmxPool@: pool 0
    cell := lmx_graph_backing_cell_in(arena, graph_node, index)
    if: cell = 0
        return: 0
    if: (cast: (int) c.lmx_range_classify(arena, cell)) != c.LMX_KIND_FIELD_ADDRESSES
        return: cell
    # Exactly one physical indirection. Entries are physical addresses,
    # never ordinals or another field-address table to project again.
    address := (cast: (@@) cell)
    cell := \address
    pool := (cast: (LmxPool@) c.lmx_range_cell_pool(arena, cell))
    expected_type := c.lmx_type_storage_like(c.lmx_range_type_of(arena, (cast: (@) graph_node)), c.LMX_TYPE_REFS)
    # An ordinary receiving view can address an immutable target; retain its
    # actual full type for the ordinary write guard. An immutable owner cannot
    # acquire mutable field storage by projecting through an address table.
    if: expected_type = c.LMX_TYPE_NONE || pool = 0 || pool\kind != c.LMX_KIND_CHILDREN || c.lmx_type_base(pool\type) != c.LMX_TYPE_REFS || (c.lmx_type_is_immutable(expected_type) != 0 && pool\type != expected_type) || (cast: (size_t) pool\stride) != sizeof(@)
        return: 0
    return: cell
end: lmx_graph_cell_in

# Construction-only: preserves the logical order of actual stable field
# addresses, using direct contiguous backing where possible.
fn: lmx_graph_fields_bind (c.LmxArena@: arena; c.Lmx@: graph_node; @@: cells) int
    c.LmxPool@: first_pool 0
    c.LmxRange@: first_range 0
    c.LmxPool@: pool 0
    c.LmxPool@: backing 0
    c.Lmx@: fields_profile 0
    c.VoidArray@: va 0
    @@: addresses void 0
    size_t: i 0U
    size_t: n 0U
    size_t: stride 0U
    int: contiguous 1
    int: owner_type c.LMX_TYPE_NONE
    int: storage_type c.LMX_TYPE_NONE
    stride := sizeof(@)
    if: graph_node = 0 || cells = 0
        return: 1
    if: (cast: (int) c.lmx_range_classify(arena, (cast: (@) graph_node))) != c.LMX_KIND_STRUCT
        return: 1
    owner_type := c.lmx_range_type_of(arena, (cast: (@) graph_node))
    if: c.lmx_type_base(owner_type) != c.LMX_TYPE_STRUCT
        return: 1
    storage_type := c.lmx_type_storage_like(owner_type, c.LMX_TYPE_REFS)
    if: storage_type = c.LMX_TYPE_NONE
        return: 1
    va := @ graph_node\array
    n := (cast: (size_t) va\size)
    if: n = 0U || n > ((cast: (size_t) -1) / stride)
        return: 1
    first_pool := (cast: (LmxPool@) c.lmx_range_cell_pool(arena, cells[0]))
    first_range := (cast: (LmxRange@) c.lmx_range_entry_at(arena, cells[0]))
    while: i < n
        pool := (cast: (LmxPool@) c.lmx_range_cell_pool(arena, cells[i]))
        if: pool = 0 || pool\kind != c.LMX_KIND_CHILDREN || c.lmx_type_base(pool\type) != c.LMX_TYPE_REFS || (c.lmx_type_is_immutable(storage_type) != 0 && pool\type != storage_type) || (cast: (size_t) pool\stride) != stride
            return: 1
        # One direct span cannot straddle two chunks, even if separate
        # allocations happen to have adjacent numerical addresses.
        if: pool != first_pool || (cast: (LmxRange@) c.lmx_range_entry_at(arena, cells[i])) != first_range || i > (((cast: (size_t) -1) - (cast: (size_t) cells[0])) / stride) || (cast: (size_t) cells[i]) != (cast: (size_t) cells[0]) + i * stride
            contiguous := 0
        i := i + 1U
    ---
    if: contiguous != 0
        va\data := cells[0]
        return: 0
    fields_profile := (cast: (Lmx@) c.lmx_range_profile(arena, (cast: (@) graph_node)))
    backing := (cast: (LmxPool@) c.lmx_pool_make_profiled(arena, n * stride, stride, c.LMX_KIND_FIELD_ADDRESSES, storage_type, fields_profile))
    if: backing = 0
        return: 1
    addresses := (cast: (@@) c.lmx_chunk_data(backing\head))
    i := 0U
    while: i < n
        addresses[i] := cells[i]
        i := i + 1U
    ---
    va\data := (cast: (@) addresses)
    return: 0
end: lmx_graph_fields_bind

# Typed adapters of the SAME resolved cell/value, not another traversal.
fn: lmx_graph_ref_cell_in (c.LmxArena@: arena; c.Lmx@: graph_node; size_t: index) @@
    @: cell void 0
    c.LmxPool@: pool 0
    cell := lmx_graph_cell_in(arena, graph_node, index)
    pool := (cast: (LmxPool@) c.lmx_range_cell_pool(arena, cell))
    if: pool = 0 || (pool\kind != c.LMX_KIND_CHILDREN && pool\kind != c.LMX_KIND_REF) || (cast: (size_t) pool\stride) != sizeof(@)
        return: 0
    return: (cast: (@@) cell)
end: lmx_graph_ref_cell_in

fn: lmx_graph_ref_struct_in (c.LmxArena@: arena; c.Lmx@: graph_node; size_t: index) c.Lmx@
    return: lmx_graph_node_in(arena, lmx_graph_value_in(arena, graph_node, index))
end: lmx_graph_ref_struct_in

fn: lmx_graph_ref_store_in (c.LmxArena@: arena; c.Lmx@: graph_node; size_t: index; @: value) int
    @: cell void lmx_graph_cell_in(arena, graph_node, index)
    if: cell = 0 || c.lmx_range_write_exact_blocked(arena, cell, 0, 0, 0U) != 0
        return: 1
    return: lmx_graph_ref_fill_in(arena, graph_node, index, value)
end: lmx_graph_ref_store_in

# Constructor-only initialization/fixup of newly allocated reference slots.
# This is separate from ordinary rebinding through the admitted physical map.
fn: lmx_graph_ref_fill_in (c.LmxArena@: arena; c.Lmx@: graph_node; size_t: index; @: value) int
    @@: slot void 0
    @: old void 0
    c.LmxCodeLink@: record 0
    int: code 0
    int: status 0
    slot := lmx_graph_ref_cell_in(arena, graph_node, index)
    if: slot = 0
        return: 1
    old := \slot
    # One of the three physical rebindings of a slot (design 4.4): prepared before the write (a refusal writes nothing),
    # committed after it.
    status := lmx_code_rebind_prepare(arena, (cast: (@) slot), old, value, @ record, @ code)
    if: status != 0
        return: status
    \slot := value
    return: lmx_code_rebind_commit(arena, (cast: (@) slot), old, value, record, code)
end: lmx_graph_ref_fill_in

# Logical child value: a CHILDREN/REF cell holds an address; a primitive
# element IS its typed value cell (including a machine @T pointer cell).
fn: lmx_graph_value_in (c.LmxArena@: arena; c.Lmx@: graph_node; size_t: index) @
    @: cell void 0
    @@: address void 0
    c.LmxPool@: pool 0
    int: kind 0
    cell := lmx_graph_cell_in(arena, graph_node, index)
    if: cell = 0
        return: 0
    pool := (cast: (LmxPool@) c.lmx_range_cell_pool(arena, cell))
    if: pool = 0
        return: 0
    kind := (cast: (int) pool\kind)
    if: kind = c.LMX_KIND_CHILDREN || kind = c.LMX_KIND_REF
        if: (cast: (size_t) pool\stride) != sizeof(@)
            return: 0
        address := (cast: (@@) cell)
        return: \address
    if: kind = c.LMX_KIND_PRIMITIVE
        return: cell
    return: 0
end: lmx_graph_value_in

# The payload IS the void * child-pointer array of one Structure (ABI 3.3).  It is an
# array of the arena like every other -- "ЧЕМ МАССИВЫ ОТЛИЧАЮТСЯ ОТ ВСЕГО ОСТАЛЬНОГО?
# НИЧЕМ!!!" (Mikhail, 2026-09-17) -- so it has a descriptor and an entry in the arena's
# index, and a slot ADDRESS classifies as CHILDREN: a storage location, not the child
# stored in it.  What types a child is the child's own VALUE, classified on its own
# (SPEC 2: "The address of the pointer slot &children[i] is a storage location, not the
# address used to identify the child's type").  The structure's `array.data` holds the base;
# nothing else is stored anywhere to say what a slot is.  Slots start null; construction
# stores each child's typed address afterwards.
#
# This function is the CREATION step for this structure's child block, so it is the one
# that sets array.data and array.size: the count is given once, here, and never changes afterwards
# (SPEC 2, ABI 14.22).  There is no later writer of either field.
fn: lmx_arena_refs_open_owned (c.LmxArena@: arena; c.Lmx@: parent; size_t: children) int
    return: lmx_arena_refs_open_profiled(arena, parent, children, 0)
end: lmx_arena_refs_open_owned

fn: lmx_arena_refs_open_profiled (c.LmxArena@: arena; c.Lmx@: parent; size_t: children; c.Lmx@: refs_profile) int
    size_t: slot 0U
    size_t: bytes 0U
    c.LmxPool@: array 0
    c.VoidArray@: va 0
    int: owner_type c.LMX_TYPE_NONE
    int: storage_type c.LMX_TYPE_NONE
    slot := sizeof(@)
    if: arena = 0 || parent = 0 || children = 0U
        return: 1
    owner_type := c.lmx_range_type_of(arena, (cast: (@) parent))
    if: c.lmx_range_classify(arena, (cast: (@) parent)) != c.LMX_KIND_STRUCT || c.lmx_type_base(owner_type) != c.LMX_TYPE_STRUCT
        return: 1
    storage_type := c.lmx_type_storage_like(owner_type, c.LMX_TYPE_REFS)
    if: storage_type = c.LMX_TYPE_NONE
        return: 1
    va := @ parent\array
    if: va\data != 0 || (cast: (size_t) va\size) != 0U
        return: 1
    if: children > ((cast: (size_t) -1) / slot)
        return: 1
    bytes := children * slot
    # The slot array is an array of the arena like every other: the arena allocates it,
    # owns it and classifies it (KIND_CHILDREN with TYPE_REFS), so this constructor
    # prepares no storage of its own and a refusal leaves the arena untouched.
    array := (cast: (LmxPool@) c.lmx_pool_make_profiled(arena, bytes, slot, c.LMX_KIND_CHILDREN, storage_type, refs_profile))
    if: array = 0
        return: 1
    # The interval of this child array names its Structure first, so a slot cell alone recovers (holder, slot)
    # (lmx_range_slot_holder; design 4.4); a refusal leaves the Structure without a child array.
    if: c.lmx_range_holder_set(arena, (cast: (@) c.lmx_chunk_data(array\head)), parent) != 0
        return: 1
    va\data := (cast: (@) c.lmx_chunk_data(array\head))
    va\size := children
    return: 0
end: lmx_arena_refs_open_profiled

# Slot address &children[index], or null when parent/data is null or index
# is out of range. A store through it rebinds that child reference; the
# parent's field count never changes. For a compiler-proven child index, the
# slot's current value may itself be null before construction has stored a child.
fn: lmx_arena_ref_cell (c.Lmx@: parent; size_t: index) @@
    c.VoidArray@: va 0
    if: parent = 0
        return: 0
    va := @ parent\array
    if: va\data = 0
        return: 0
    if: index >= (cast: (size_t) va\size)
        return: 0
    return: (cast: (@@) va\data) + index
end: lmx_arena_ref_cell

# Current child value, or null when unset or out of range.
fn: lmx_arena_ref_value (c.Lmx@: parent; size_t: index) @
    @@: slot void 0
    slot := lmx_arena_ref_cell(parent, index)
    if: slot = 0
        return: 0
    return: \slot
end: lmx_arena_ref_value

# Rebinds one child reference (ABI 14.22). The referenced object is not
# touched; the previous referent is neither freed nor retained here.  The arena is the slot's: the write is one of
# the three physical rebindings of a slot (design 4.4), so the code links follow it and a write of code resets the
# native words above -- no global names the arena, every caller passes it (slice 253).
fn: lmx_arena_ref_store (c.LmxArena@: arena; c.Lmx@: parent; size_t: index; @: value) int
    @@: slot void 0
    @: old void 0
    c.LmxCodeLink@: record 0
    int: code 0
    int: status 0
    if: arena = 0
        return: 1
    slot := lmx_arena_ref_cell(parent, index)
    if: slot = 0
        return: 1
    old := \slot
    status := lmx_code_rebind_prepare(arena, (cast: (@) slot), old, value, @ record, @ code)
    if: status != 0
        return: status
    \slot := value
    return: lmx_code_rebind_commit(arena, (cast: (@) slot), old, value, record, code)
end: lmx_arena_ref_store

# Only for closed-unit paths whose child is a compiler-proven Structure.
# This is not dynamic type discovery and not a generic raw-pointer cast.
fn: lmx_arena_ref_struct (c.Lmx@: parent; size_t: index) c.Lmx@
    return: (cast: (Lmx@) lmx_arena_ref_value(parent, index))
end: lmx_arena_ref_struct

# ---- Code and its native words (slice 253, design 4.4; slice 274) ------------------------------------------------------
#
# Executable code selects the native word `native` of ANY operand (lmx_walk_callable_addr), so a change of the code a
# word was compiled over must drop that word: the next dispatch then walks the actual code.  The rule is neither a
# role nor a slot number but what is written where.  A write into a slot is a write of CODE when
#   (1) the holder is an operation -- a node whose head (slot 0) is a cell of the operations' array: the slot is its
#       literal, an operand, a throws item, a pad -- whatever the child;
#   (2) the child leaving or the child arriving is itself an operation;
#   (3) the holder is a callable (the FN role pool) and the slot is one of its parts (args, return, var, body: 0-3);
#   (4) the holder is a part of a callable, or a named occurrence without an operation head, and the child leaving
#       or arriving is a NODE WITHOUT A NAME OF ITS OWN: a formal, a result description, a part of a `sub`.
# Every other write is data and keeps the words (L2 88: a compatible entry survives an ordinary data-value change).  A
# primitive cell in such a slot -- an own or formal value, a field of a named Structure -- is data.  So is a node whose
# own address keys the table of source names, a named Structure or Array or a callable (slice 274): the generated code
# holds none of them.  It reads such a slot when it runs and calls a callable through that callable's own word
# (lmx_call_prim_values; a direct l2_mN call stands only in its own trampoline), and the walker takes it as a value.
# A publication of `T:` or a field rebound by name keeps every word, and an operation arriving there is still (2).
#
# A write of code resets `native` of the holder and of every node that holds it AS CODE, and theirs, each once
# (lmx_code_reset_from).  Replacing an operand is a change of the operation that has it (1); a change inside what an
# unchanged operand refers to is not (lmx_code_holds): the operand `AT(root, 3)` or the `Box` of `@: q Box Box` is
# read when the operation runs, and a node reached through a data edge -- a callable in a field, a library instance
# under its owner -- is called through its own word, so its holder's word does not contain it.  `parent` is not
# climbed, and a subgraph built under compiled code (S8.1 instances) leaves that code's words alone until it is
# itself installed in a place of code.  The links are the index's side
# storage (lmx_range_link_*): one record per current installation of a child in a place of code, made and removed
# where the three physical rebinding paths write the slot -- lmx_graph_ref_fill_in, lmx_arena_ref_store and
# lmx_value_cell_fill -- all through lmx_code_rebind_prepare before the write and lmx_code_rebind_commit after it,
# which recover (holder, slot) from the slot cell itself (lmx_range_slot_holder).  A write of a VALUE into a cell (a
# number, a pointer object) asks the cell's own records (lmx_code_changed_cell): none means data.
#
# A source-code write clears affected native entries. Whether the resulting
# code is suitable for the requested executor is checked by that execution
# or an explicit check operation; it does not restrict the physical write.

fn: lmx_code_head_is_op (c.LmxArena@: arena; @: head) int
    if: arena = 0 || head = 0
        return: 0
    return: (cast: (int) (c.lmx_range_classify(arena, head) = c.LMX_DOMAIN_KIND_OP))
end: lmx_code_head_is_op

# The node `x` when it is an operation.
fn: lmx_code_node (c.LmxArena@: arena; @: x) c.Lmx@
    c.Lmx@: graph lmx_graph_node_in(arena, x)
    if: graph = 0
        return: 0
    if: lmx_code_head_is_op(arena, lmx_graph_value_in(arena, graph, 0U)) != 0
        return: graph
    return: 0
end: lmx_code_node

fn: lmx_code_unnamed_node (c.LmxArena@: arena; @: x) int
    if: x = 0 || lmx_graph_node_in(arena, x) = 0
        return: 0
    return: (cast: (int) (c.lmx_source_name_get(arena, x) = 0))
end: lmx_code_unnamed_node

fn: lmx_code_callable (c.LmxArena@: arena; c.Lmx@: x) int
    c.LmxPool@: pool 0
    if: arena = 0 || x = 0
        return: 0
    pool := (cast: (LmxPool@) c.lmx_range_cell_pool(arena, (cast: (@) x)))
    if: pool = 0 || pool\kind != c.LMX_KIND_STRUCT
        return: 0
    return: (cast: (int) (pool\role = c.LMX_POOL_ROLE_FN))
end: lmx_code_callable

# `x` stands in a part slot (0-3) of the callable `parent`.
fn: lmx_code_part_slot (c.LmxArena@: arena; c.Lmx@: parent; c.Lmx@: x) int
    size_t: k 0U
    if: x = 0 || lmx_code_callable(arena, parent) = 0
        return: 0
    while: k < 4U
        if: lmx_graph_value_in(arena, parent, k) = (cast: (@) x)
            return: 1
        ---
        k := k + 1U
    ---
    return: 0
end: lmx_code_part_slot

fn: lmx_code_write (c.LmxArena@: arena; c.Lmx@: holder; size_t: slot; @: old; @: new) int
    @: head void 0
    c.Lmx@: parent 0
    if: arena = 0 || holder = 0
        return: 0
    # The head as it stands for this decision: installing a frame's own head (slot 0, over nothing) is construction
    # of that frame, not a change of the code it is in.
    if: slot = 0U
        head := old
    else:
        head := lmx_graph_value_in(arena, holder, 0U)
    ---
    if: lmx_code_head_is_op(arena, head) != 0
        return: 1
    if: old != 0 && lmx_code_node(arena, old) != 0
        return: 1
    if: new != 0 && lmx_code_node(arena, new) != 0
        return: 1
    if: slot < 4U && lmx_code_callable(arena, holder) != 0
        return: 1
    if: lmx_code_unnamed_node(arena, old) = 0 && lmx_code_unnamed_node(arena, new) = 0
        return: 0
    # A named node leaving shows the place for what it is, whatever Structure now takes it.
    if: old != 0 && lmx_graph_node_in(arena, old) != 0 && c.lmx_source_name_get(arena, old) != 0
        return: 0
    if: c.lmx_source_name_get(arena, (cast: (@) holder)) != 0
        return: 1
    parent := (cast: (c.Lmx@) holder\parent)
    return: lmx_code_part_slot(arena, parent, holder)
end: lmx_code_write

# Slot `slot` of `holder` has `item` as a part of its code: an operation wherever it stands (one statement in two bodies
# is in both), a part of a callable, or a node without a name of its own built for this holder (a block, a call's list,
# a formal).  Anything else standing in an operation's slot is an operand that refers to a node living elsewhere, and
# a named node is read when the code runs (see the head of this section).
fn: lmx_code_holds (c.LmxArena@: arena; c.Lmx@: holder; size_t: slot; c.Lmx@: item) int
    if: lmx_code_head_is_op(arena, lmx_graph_value_in(arena, item, 0U)) != 0
        return: 1
    if: slot < 4U && lmx_code_callable(arena, holder) != 0
        return: 1
    if: (cast: (c.Lmx@) item\parent) != holder
        return: 0
    return: (cast: (int) (c.lmx_source_name_get(arena, (cast: (@) item)) = 0))
end: lmx_code_holds

fn: lmx_code_next_gen (c.LmxArena@: arena) size_t
    arena\reset_gen := arena\reset_gen + 1U
    if: arena\reset_gen = 0U
        arena\reset_gen := 1U
    ---
    return: arena\reset_gen
end: lmx_code_next_gen

# `native: 0` at `start` and at everything that holds it as code: the holders it is linked into, and theirs, each
# once.  The records themselves are the worklist (threaded through `work`) and carry the visit mark (the arena's reset
# generation), so a reset allocates nothing and cannot fail: once a write of code is decided, the words above it are
# gone for sure (P1-B of Codex's review).  Cycles and shared subgraphs end because a record is taken once per
# generation; a holder reached through two records is expanded twice, which only repeats finished work.
sub: lmx_code_reset_from (c.LmxArena@: arena; c.Lmx@: start)
    c.LmxCodeLink@: work 0
    c.LmxCodeLink@: link 0
    c.Lmx@: at 0
    size_t: gen 0U
    if: arena = 0 || start = 0
        return
    gen := lmx_code_next_gen(arena)
    start\native := 0
    link := (cast: (LmxCodeLink@) c.lmx_range_links_of(arena, (cast: (@) start)))
    while: link != 0
        if: link\mark != gen && lmx_code_holds(arena, (cast: (c.Lmx@) (link\holder)), (cast: (size_t) (link\slot)), start) != 0
            link\mark := gen
            link\work := work
            work := link
        ---
        link := link\next
    ---
    while: work != 0
        link := work
        work := link\work
        at := link\holder
        at\native := 0
        link := (cast: (LmxCodeLink@) c.lmx_range_links_of(arena, (cast: (@) at)))
        while: link != 0
            if: link\mark != gen && lmx_code_holds(arena, (cast: (c.Lmx@) (link\holder)), (cast: (size_t) (link\slot)), at) != 0
                link\mark := gen
                link\work := work
                work := link
            ---
            link := link\next
        ---
    ---
    return
end: lmx_code_reset_from

# A value was written into `cell`: every place of code it stands in loses its word, with everything above.
sub: lmx_code_changed_cell (c.LmxArena@: arena; @: cell)
    c.LmxCodeLink@: link 0
    c.LmxCodeLink@: next 0
    if: arena = 0 || cell = 0
        return
    link := (cast: (LmxCodeLink@) c.lmx_range_links_of(arena, cell))
    while: link != 0
        next := link\next
        lmx_code_reset_from(arena, (cast: (c.Lmx@) (link\holder)))
        link := next
    ---
    return
end: lmx_code_changed_cell

# The rebinding of a slot cell, in two steps around the physical write, so that the write and its consequences stand or
# fall together. PREPARE decides whether this changes code in its current state
# and allocates the new child's link. Future execution is checked when requested,
# not as a condition of writing a pointer. Non-zero refuses the
# write: nothing written, nothing linked, every word in place.  COMMIT, after the write: the old child's record of this
# place goes, the prepared one joins, and a write of code drops the words above the holder; nothing allocates or fails, and
# no dispatch stands between the write and the drop.  ABANDON: the prepared record of a write that did not happen.
fn: lmx_code_rebind_prepare (c.LmxArena@: arena; @: cell; @: old; @: new; c.LmxCodeLink@@: record; int@: code) int
    c.Lmx@: holder 0
    size_t: slot 0U
    int: is_code 0
    if: arena = 0 || cell = 0 || record = 0 || code = 0
        return: 1
    \record := 0
    \code := 0
    if: old = new
        return: 0
    holder := (cast: (c.Lmx@) c.lmx_range_slot_holder(arena, cell, @ slot))
    if: holder = 0
        return: 0
    is_code := lmx_code_write(arena, holder, slot, old, new)
    if: is_code != 0
        if: new != 0
            if: c.lmx_range_link_prepare(arena, new, holder, slot, record) != 0
                return: 1
            ---
        ---
    ---
    \code := is_code
    return: 0
end: lmx_code_rebind_prepare

fn: lmx_code_rebind_commit (c.LmxArena@: arena; @: cell; @: old; @: new; c.LmxCodeLink@: record; int: code) int
    c.Lmx@: holder 0
    size_t: slot 0U
    int: status 0
    if: arena = 0 || cell = 0
        c.lmx_range_link_abandon(record)
        return: 1
    if: old = new
        c.lmx_range_link_abandon(record)
        return: 0
    holder := (cast: (c.Lmx@) c.lmx_range_slot_holder(arena, cell, @ slot))
    if: old != 0 && holder != 0
        c.lmx_range_link_remove(arena, old, holder, slot)
    ---
    if: record != 0
        status := (cast: (int) c.lmx_range_link_commit(arena, record))
    ---
    if: code != 0
        lmx_code_reset_from(arena, holder)
    ---
    return: status
end: lmx_code_rebind_commit

sub: lmx_code_rebind_abandon (c.LmxCodeLink@: record)
    c.lmx_range_link_abandon(record)
    return
end: lmx_code_rebind_abandon
