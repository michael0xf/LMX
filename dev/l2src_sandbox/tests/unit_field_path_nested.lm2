Inner:
    size_t: c 5U
end: Inner

Outer:
    b:
        size_t: c 5U
end: Outer

# FABLE-GROKBOT-NESTED-FIELD-CONSTRUCT-20260923-116: a\b\c chains two hops
# off an explicit copy of Outer whose nested Structure b is a real occurrence
# written in Outer's body. `a: merge Outer` deep-copies b; writing 99U
# round-trips.
fn: build () size_t
    a: merge Outer
    a\b\c: 99U
    size_t: got
    got: a\b\c
    return: got
end: build

size_t: got
got: build()
if: got != 99U
    sendMessage: exit(exit_code: 90; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
