Steps:
    int: n
    return: @
    even_step:
        if: n = 0
            return: Bounce\done(value := 1)
        return: Bounce\more(next := odd_step; argument := n - 1)
    odd_step:
        if: n = 0
            return: Bounce\done(value := 0)
        return: Bounce\more(next := even_step; argument := n - 1)

Example:
    int: n
    return: int
    run:
        return: BounceRunner\run(Steps\even_step(n))
