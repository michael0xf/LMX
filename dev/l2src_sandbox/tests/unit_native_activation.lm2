# Ordinary own char array + sizeof: bytes (was c.array + c.sizeof).
# The root passes a string literal as a raw character pointer: a machine
# conversion compiled in the root like in any body. Success is 7.
fn: activation (@: char text) size_t
    []: char buffer 32
    size_t: used 0U
    buffer[0]: text[0]
    used: sizeof: buffer
    while: used > 0U
        break
    return: used
end: activation

@: char text
text: "x"
if: activation(text) != 32U
    sendMessage: exit(exit_code: 5; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
