Example:
    []int: left
    []int: right
    int: limit
    return: @
    run:
        throws: copy(FxSeqPush\append\throws) copy(record\throws) SequenceSize
        if: length(left) != length(right)
            throw: SequenceSize()
        []int: out []
        int: i 0
        while: i < length(left)
            int: score 2 * left[i] + right[i] * right[i]
            if: score >= limit
                FxSeqPush\append(out; (score record))
            i += 1
        return: out
