Options:
    int: count 0
    int: price 0
    int: value
    return: @
    withCount:
        node\count := value
        return: Options
    withPrice:
        node\price := value
        return: Options

Demo:
    return: int
    run:
        @: options Options\withCount(value := 3)
        options := options\withPrice(value := 7)
        return: options\count * options\price
