# An ordinary named Structure is visible forward from its declaration. m is
# defined before Later, so Later is m's hidden input; the root call after the
# declaration supplies its actual Structure by reference.
fn: m () int
    if: Later\v != 4U
        return: 81
    Later\v: 6U
    if: Later\v != 6U
        return: 82
    return: 7
end: m
Later:
    size_t: v 4U
end: Later
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
