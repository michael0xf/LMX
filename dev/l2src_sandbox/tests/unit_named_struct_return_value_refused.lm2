# Q19.1: "У именнованной структуры может быть только "return" без аргументов" -- a `return` with a
# value in a named Structure's body is refused where it stands.  §12: in the words for every callable
# that returns nothing -- a `sub:`'s too (unit_sub_return_value_refused) -- in any place of the body.
Counter:
    size_t: n 0U
    return: n
return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
