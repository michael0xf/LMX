# M11.5e: Each actual is admitted before the next actual: effects1, later0, refusal5.
int: effects 0
int: later 0
int: before 0
int: after 0
fn: bad () int
    node\effects := node\effects + 1
    return: 7
end: bad
fn: later_code () int
    node\later := node\later + 1
    return: 9
end: later_code
before := 1
fn: f bad() int later_code()
after := 2
