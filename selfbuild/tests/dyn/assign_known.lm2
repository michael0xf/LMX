# The write of a known place is `left: right` (M6 4b; the book, assign-known: := removed): a local, a formal (the
# activation's own value), a field through a path, a reference place holding a method (the method's Structure is
# referenced, a bare right side is not called) -- through the ordinary admission of the place. Only the call mark calls
# (the author 2026-11-09): a callable formal rebound inside its method (swap) is the write of the formal, not a call of
# what it holds -- inside a method the head of `cb: two` is a call head (l2_call_head_method), and lm_compiler_is_asgn
# takes it for a call only when the Frame carries the call mark; the unit-level `target: two`, a binding holding a
# method, likewise (slice 349: before it both were refused as calls, "more arguments than cb has formals").
# Entry 7; 81-90 the failing step.
Box:
    int: k 1
end: Box
Seen:
    int: v 0
end: Seen
fn: one () int
    Seen\v: 1
    return: 1
end: one
fn: two () int
    Seen\v: 2
    return: 2
end: two
@: target one
fn: f (int: a) int
    a: a + 1
    return: a
end: f
fn: swap (cb(fn: () int)) int
    cb: two
    return: cb()
end: swap
fn: run () int
    int: x 1
    x: 5
    if: x != 5
        return: 81
    x: 7
    if: x != 7
        return: 82
    x: x + 2
    if: x != 9
        return: 83
    if: f(3) != 4
        return: 84
    Box\k: 9
    if: Box\k != 9
        return: 85
    size_t: s 1U
    s: 3U
    if: s != 3U
        return: 86
    x: 11
    if: x != 11
        return: 87
    return: 7
end: run
int: code run()
if: code = 7
    target: two
    call: target
    if: Seen\v != 2
        code: 88
---
if: code = 7
    code: 7
    if: code != 7
        code: 89
---
if: code = 7 && swap(one) != 2
    code: 90
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
