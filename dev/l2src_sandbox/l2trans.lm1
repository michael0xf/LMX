            return: l2_rw_refuse(stmt, "a value that is not a number")
        f: l2_next_active(stmt\as\frame\body\first_field)
        if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM
            return: l2_rw_refuse(stmt, "this declaration")
        oi: 0
        while: oi < l2_own_n && (l2_own_decl[oi] != stmt || l2_own_mi[oi] != l2_rw_mi)
            oi: oi + 1
        ---
        if: oi >= l2_own_n
            return: l2_rw_refuse(stmt, "this declaration")
        if: (l2_own_host[oi] != 0 || l2_own_fid[oi] >= 0) && l2_rw_is_hosted(oi) = 0
            return: l2_rw_refuse(stmt, "a field declared in a nested body")
        if: l2_rw_is_hosted(oi) = 0 && (l2_rw_num_ty(l2_own_ty[oi]) = 0 || l2_own_uchild[oi] < 0)
            return: l2_rw_refuse_ty(stmt, oi)
        f: l2_next_active(f\next)
        if: f = 0
            # T4b class 2: `int: n` with no initializer, n an argument (a formal or a dynamic input), carries it.
            # Class 3: the same carry into a field declared in the nested body.
            if: l2_rw_formal_slot(l2_own_name[oi]) = oi
                if: l2_rw_is_hosted(oi) != 0 && l2_rw_host_carry(into, oi, @ node) != 0
                    return: 1
                if: l2_rw_is_hosted(oi) = 0 && l2_rw_carry(into, oi, @ node) != 0
                    return: 1
                if: l2_rw_bseq_mark(oi) != 0
                    return: 1
                \made: 1
                if: l2_rw_put(into, slot, node) != 0
                    return: 1
            ---
            return: 0
        n: 0
        cond: f
        while: f != 0
            n: n + 1
            f: l2_next_active(f\next)
        ---
        # The declaration's own row is invisible to its own initializer (Q24, D-48; l2_own_excl, as
        # natively): `int: x (x + 2)` after `int: x 1` reads the first x.
        l2_own_excl: oi
        k: l2_rw_assign(into, oi, cond, n, @ node)
        l2_own_excl: 0 - 1
        if: k != 0
            return: 1
        if: l2_rw_formal_slot(l2_own_name[oi]) = oi && l2_rw_bseq_mark(oi) != 0
            return: 1
        \made: 1
        if: l2_rw_put(into, slot, node) != 0
            return: 1
        return: 0
    # A call statement.
    idx: l2_call_head_method(l2_rw_mi, h, @ formal)
    if: idx >= 0 && idx != l2_e
        if: l2_rw_call(stmt, idx, formal, l2_call_actuals(stmt\as\frame\body), into, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_put(into, slot, node) != 0
            return: 1
        return: 0
    # A held callable of the site applied by a statement: its call, as in an expression.
    if: idx < 0 && l2_call_head_held(l2_rw_mi, h) >= 0
        if: l2_rw_mad_call(stmt, l2_call_head_held(l2_rw_mi, h), into, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_put(into, slot, node) != 0
            return: 1
        return: 0
    # One Array descriptor place, before raw-pointer and scalar path stores.
    k: l2_array_place(stmt, l2_rw_mi, @ array_place)
    if: k = 3
        return: 1
    if: k = 2
        return: l2_rw_refuse(stmt, "this indexed Array operand contract")
    if: k = 0
        if: l2_rw_array_place(stmt, @ array_place, into, @ node) != 0 || l2_rw_put(into, slot, node) != 0
            return: 1
        \made: 1
        return: 0
    # `x[i]: v` into an own Array's element (-170): ELEMPUT.
    # D-39: i a size_t field is that field's AT, not a literal. An int index is not cast.
    oi: l2_rw_elem_of(h, @ eix)
    k: 0 - 1
    if: oi < 0
        idx: l2_dyn_own_index(l2_rw_mi, h, @ oi, @ k)
        if: idx = 2
            return: l2_rw_refuse(stmt, "mixed numeric types (a conversion)")
        if: idx != 1
            oi: 0 - 1
    ---
    if: oi >= 0
        n: 0
        if: stmt\as\frame\body != 0
            n: l2_count_active(stmt\as\frame\body)
        if: n < 1
            return: l2_rw_refuse(stmt, "this assignment")
        if: l2_rw_elemput(into, oi, k, eix, stmt\as\frame\body\first_field, n, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_put(into, slot, node) != 0
            return: 1
        return: 0
    # A raw-pointer indexed place is retained with its actual base, every
    # index and RHS. It is native-only, not a fake descriptor Array operation.
    if: l2_raw_index_text(h, l2_rw_mi, @ indexed) = 0
        n: l2_count_active(stmt\as\frame\body)
        if: n < 1 || l2_rw_machine_index(@ indexed, stmt\as\frame\body\first_field, n, into, @ node) != 0 || l2_rw_put(into, slot, node) != 0
            return: 1
        \made: 1
        return: 0
    # A store through a member path rooted at foreign C storage.
    if: l2_rw_foreign_path(h) != 0
        if: stmt\as\frame\body = 0 || l2_count_active(stmt\as\frame\body) < 1
            return: l2_rw_refuse(stmt, "this assignment")
        if: l2_rw_machine_store(h, stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), into, @ node) != 0 || l2_rw_put(into, slot, node) != 0
            return: 1
        \made: 1
        return: 0
    # A write through a path `a\b...: v` (-178).
    if: l2_rw_has_slash(h) != 0
        if: stmt\as\frame\body = 0
            return: l2_rw_refuse(stmt, "this assignment")
        if: l2_rw_path_write(stmt, h, stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), into, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_put(into, slot, node) != 0
            return: 1
        return: 0
    # A merge result `R: merge: A B ... [body]` (-193 T3): the root's step; a method's merge stays
    # native (its method throws `merge`, outside the walkable subset).
    if: l2_merge_frame(stmt) != 0 && l2_mres_decl(l2_rw_mi, stmt) >= 0
        if: l2_rw_merge(stmt, l2_mres_decl(l2_rw_mi, stmt), into, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_put(into, slot, node) != 0
            return: 1
        return: 0
    # A written-atom definition is one child of the method. A numeric constructor
    # in a method still has no walk frame, so that method stays native.
    if: l2_local_ns_shape(stmt, l2_rw_mi) != 0
        return: l2_rw_atom_ns(stmt, pn, slot, made)
    # A declaration by an empty frame (`f()`, `f: ()`): the root's own field it declares is a
    # field of the unit, and nothing runs.
    oi: 0
    while: oi < l2_own_n && (l2_own_decl[oi] != stmt || l2_own_mi[oi] != l2_rw_mi)
        oi: oi + 1
    ---
    if: oi < l2_own_n && (stmt\as\frame\body = 0 || l2_count_active(stmt\as\frame\body) = 0)
        return: 0
    # A declaration of a root field that is not a number (`Model: m`): what it is.
    if: oi < l2_own_n && l2_rw_num_ty(l2_own_ty[oi]) = 0
        return: l2_rw_refuse_ty(stmt, oi)
    # An explicit reference cell receives an admitted reference value. A direct
    # Structure slot retains its separately resolved callable behavior.
    oi: l2_rw_find(h)
    if: l2_rw_seen(oi) != 0 && (l2_rw_is_hosted(oi) != 0 || (l2_own_host[oi] = 0 && l2_own_fid[oi] < 0 && l2_own_uchild[oi] >= 0)) && l2_own_is_pointer(l2_own_ty[oi]) != 0 && l2_own_is_slot(oi) = 0
        if: l2_rw_reference_store(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), oi, into, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_put(into, slot, node) != 0
            return: 1
        return: 0
    ---
    if: l2_rw_seen(oi) != 0 && l2_own_host[oi] = 0 && l2_own_fid[oi] < 0 && l2_own_uchild[oi] >= 0 && l2_own_is_pointer(l2_own_ty[oi]) != 0
        return: l2_rw_refuse(stmt, "a reference assignment")
    # An assignment of the root's own numeric field. A field declared in the
    # nested body is still that body's cell (class 3). A bare write of a formal
    # is the method's cell, including from inside the body (D-79).
    oi: l2_rw_own_row(stmt, h)
    if: oi = 0 - 1
        return: 1
    if: oi >= 0
        n: l2_count_active(stmt\as\frame\body)
        if: n < 1
            return: l2_rw_refuse(stmt, "this assignment")
        if: l2_rw_assign(into, oi, stmt\as\frame\body\first_field, n, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_put(into, slot, node) != 0
            return: 1
        return: 0
    # A bare write of an argument's name -- a formal or a dynamic input -- that no same-name field declared in scope has
    # bound (l2_rw_find gave none): the activation's input, [set_arg, k, value], never a field (the author, bafca4c:
    # assignment is not a declaration; Q52: only the hidden input changes).
    idx: l2_param_find(l2_rw_mi, h)
    if: l2_rw_mi != l2_e && idx >= 0
        n: l2_count_active(stmt\as\frame\body)
        if: n < 1
            return: l2_rw_refuse(stmt, "this assignment")
        if: l2_rw_frame(into, "LMX_WALK_OP_SET_ARG", 4, @ node) != 0 || l2_rw_input_witness(node, 3, l2_rw_mi, idx) != 0
            return: 1
        if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 1U, %dU) != c.LMX_WALK_OK\n            return: 1\n", node, idx) < 0
            return: 1
        if: l2_rw_reference_receive(stmt\as\frame\body\first_field, n, l2_own_ty_of_param(l2_param_ty(l2_rw_mi, h)), l2_nsty_get(l2_rw_mi, idx), node, @ t) != 0 || l2_rw_put(node, 2, t) != 0
            return: 1
        \made: 1
        if: l2_rw_put(into, slot, node) != 0
            return: 1
        return: 0
    if: l2_ns_find(h) >= 0 || (stmt\as\frame\body != 0 && stmt\as\frame\body\first_field != 0 && l2_frame_head(stmt\as\frame\body\first_field\value, "merge") != 0)
        return: l2_rw_refuse(stmt, "a Structure value")
return: l2_rw_refuse(stmt, "this statement")

# A statement list from `first`: each step goes to container `into`. A method placed in source
# order stores the step at the statement's recorded child; every other list still uses base + k.
# `into` -2 is the count pass's container, which nothing is stored into.
fn: l2_rw_stmts (@: LmP0Field first; int: into; int: base; @: L2SourceContainer source; @: int made) int
    @: LmP0Field field
    @: LmP0Field next
    int: one
    int: slot
    int: placed 0
    int: own
    if: source = 0 && l2_t7_walk = 0 && l2_rw_nest = 0 && l2_m_src_end != 0 && l2_rw_mi >= 0 && l2_rw_mi < l2_m_n && l2_m_src_end[l2_rw_mi] >= 0
        placed: 1
    if: l2_rw_pads(first, into) != 0
        return: 1
    field: l2_next_active(first)
    while: field != 0
        # D-94: nothing after the host's return point is built -- the build is the host's trailer,
        # so a statement built here would run before it (REVIEW e8b8a8d).
        if: l2_mad_on(l2_rw_mi) != 0 && l2_m_body[l2_rw_mi] != 0 && l2_m_body[l2_rw_mi]\as != 0 && l2_mad_return_point(l2_m_body[l2_rw_mi]\as\structure, l2_rw_mi, field) != 0
            field: 0
            continue
        # T6/T6b: a nested fn: is the host's model, not a statement to walk (l2_check_body's
        # own l2_mad_on(mi)/"fn" skip, l2trans.lm1:15469, mirrored here for the walk pass).
        if: l2_mad_on(l2_rw_mi) != 0 && l2_frame_head(field\value, "fn") != 0
            next: l2_next_active(field\next)
            field: next
            continue
        l2_here_at_method(l2_rw_mi, field\value)
        slot: base + \made
        if: placed != 0
            slot: l2_ps_lookup(field\value)
        # An original constructed namespace child is filled once by its
        # existing NSF constructor, never reclassified as an invocation.
        one: -1
        if: source != 0
            one: l2_ns_constructed_row(l2_rw_mi, field\value)
        if: one = -2
            return: 1
        if: one >= 0
            own: l2_ps_lookup(field\value)
            if: l2_construct_phase = 0 && own < 0
                if: l2_ps_add(field\value, slot) != 0
                    return: 1
                own: slot
            ---
            if: own != slot
                return: l2_error(l2_src, field\value, "internal: a constructed child changed source slot")
            own: l2_own_by_decl(l2_rw_mi, field\value)
            if: own >= 0 && l2_source_field_slot(source, own, slot) != 0
                return: 1
            \made: \made + 1
            field: l2_next_active(field\next)
            continue
        # The original root also contains definitions. Their existing
        # constructors fill exactly this child; they are not executable steps
        # and do not get another wrapper or a second owning tail edge.
        if: source != 0 && source\root != 0 && source\body = l2_cur_unit && l2_source_unit_declaration(field\value) != 0
            slot: base + \made
            own: l2_ps_lookup(field\value)
            if: l2_construct_phase = 0 && own < 0
                if: l2_ps_add(field\value, slot) != 0
                    return: 1
                own: slot
            ---
            if: own != slot
                return: l2_error(l2_src, field\value, "internal: a definition changed source slot")
            \made: \made + 1
            field: l2_next_active(field\next)
            continue
        # A declaration's storage precedes its initializer at the original
        # field, not in a separate all-values prefix. Match exact source
        # identity; lexical scope membership alone cannot identify its body.
        if: source != 0
            own: l2_own_by_decl(l2_rw_mi, field\value)
            if: own >= 0 && l2_source_borrowed_constructor(source, own) < 0
                if: l2_source_field_slot(source, own, slot) != 0
                    return: 1
                if: l2_own_computed(own) = 0
                    \made: \made + 1
                    slot: slot + 1
                ---
            ---
        ---
        if: l2_rw_stmt(field, @ next, into, slot, @ one) != 0
            return: 1
        if: placed != 0 && one != 0 && slot < 0
            l2_rw_quiet: 0
            return: l2_error(l2_src, field\value, "internal: a statement has no source slot")
        \made: \made + one
        field: next
    ---
return: 0

# Interpreter capability only: this predicate does not select source fields,
# count retained bodies or authorize erasure. Ordinary construction uses the
# common source-order producer even for native-only methods. Formal reads use
# the existing ARG transport; own reads use actual arena places and activation
# working values. Numeric catch parameters use their existing hosted cells.
# The test knob clears native only when the retained body is also interpretable.
fn: l2_rw_may (int: mi) int
    int: j 0
    int: oi 0
    int: cls
    if: mi < 0 || mi >= l2_m_n || l2_m_native(mi) = 0
        return: 0
    cls: l2_tramp_class(mi)
    # §6: a T6/T6b callable-merge host (l2_mad_on) has a callable result (code 16, cls 5) by
    # its own declared header -- excluded here by the generic numeric-class gate like any other
    # callable result, UNLESS its return is confirmed the host's one exit (l2_mad_return_confirmed,
    # l2_mad_host_body's own three-way "where the return is" check): l2_rw_trailer's own l2_mad_on
    # branch builds the PRIM-based return, never the numeric one this gate exists for, so the class
    # check does not apply to it. A malformed host (no confirmed return: model) still falls through
    # to this gate and stays excluded, diagnosed by l2_rw_callable_excluded as before.
    if: (l2_mad_on(mi) = 0 || l2_mad_return_confirmed(mi, l2_mad_model[mi]) = 0) && l2_m_ret[mi] != 8 && l2_rw_num_ty(l2_ret_cell_ty(mi)) = 0 && l2_own_is_pointer(l2_ret_cell_ty(mi)) = 0
        return: 0
    while: j < l2_m_arity[mi]
        # Callable formals use the existing whole-occurrence ARG/EXEC route,
        # not a numeric cell. COUNT records any unsupported formation as a
        # retained machine operation; mere presence of the formal excludes none.
        if: l2_cf_get(mi, j) < 0 && l2_nsty_get(mi, j) < 0 && l2_rw_num_ty(l2_own_ty_of_param(l2_ft(mi, j))) = 0 && l2_own_is_pointer(l2_own_ty_of_param(l2_ft(mi, j))) = 0
            return: 0
        j: j + 1
    ---
    while: oi < l2_own_n
        # Class 3 admits a numeric field of a nested body, including a catch parameter,
        # and an Array of a walked element type: its descriptor is a placed child of
        # that body, read through AT. A Structure field declared there still keeps
        # the method out.
        if: l2_own_mi[oi] = mi && l2_own_host[oi] != 0 && l2_rw_is_hosted(oi) = 0 && (l2_own_is_array(l2_own_ty[oi]) = 0 || l2_rw_elem_ty(oi) < 0)
            return: 0
        # A method-level numeric field named like an argument -- a formal or a dynamic input -- is class 2. A pointer or
        # a Structure field of that name stays out. A hosted numeric field is class 3.
        if: l2_own_mi[oi] = mi && l2_param_find(mi, l2_own_name[oi]) >= 0 && l2_rw_is_hosted(oi) = 0 && ((l2_rw_num_ty(l2_own_ty[oi]) = 0 && l2_own_is_pointer(l2_own_ty[oi]) = 0) || l2_own_uchild[oi] < 0)
            return: 0
        oi: oi + 1
    ---
return: 1

# REVIEW c953b22: why l2_rw_may keeps method mi out of the walk -- its gates in order, in words, for
# the note a callable-merge host gets when the knob does not walk it.
fn: l2_rw_may_why (int: mi) const: @: char
    int: j 0
    int: oi 0
    if: l2_m_native(mi) = 0
        return: "it has no native body"
    if: l2_mad_on(mi) != 0 && l2_mad_return_confirmed(mi, l2_mad_model[mi]) = 0
        return: "its return is not confirmed as its one exit"
    while: j < l2_m_arity[mi]
        if: l2_cf_get(mi, j) < 0 && l2_nsty_get(mi, j) < 0 && l2_rw_num_ty(l2_own_ty_of_param(l2_ft(mi, j))) = 0 && l2_own_is_pointer(l2_own_ty_of_param(l2_ft(mi, j))) = 0
            return: "a formal that is not a number"
        j: j + 1
    ---
    while: oi < l2_own_n
        if: l2_own_mi[oi] = mi && l2_own_host[oi] != 0 && l2_rw_is_hosted(oi) = 0 && (l2_own_is_array(l2_own_ty[oi]) = 0 || l2_rw_elem_ty(oi) < 0)
            return: "a field of a nested body that is not a number"
        if: l2_own_mi[oi] = mi && l2_param_find(mi, l2_own_name[oi]) >= 0 && l2_rw_is_hosted(oi) = 0 && ((l2_rw_num_ty(l2_own_ty[oi]) = 0 && l2_own_is_pointer(l2_own_ty[oi]) = 0) || l2_own_uchild[oi] < 0)
            return: "a field named like an argument that is not a number"
        oi: oi + 1
    ---
return: "its walk was refused"

# An unbuilt callable-result producer remains a located --walk-methods limit.
# Callable formals themselves are transported by ARG/EXEC and are not this
# boundary. Other retained machine operations keep their recorded capability.
fn: l2_rw_callable_excluded (int: mi) int
    if: mi < 0 || mi = l2_e || mi >= l2_m_n || l2_m_native(mi) = 0
        return: 0
    if: l2_m_throws != 0 && l2_m_throws[mi] != 0
        return: 0
    if: l2_m_ret[mi] = 16
        return: 1
return: 0

# Method mi's return trailer (its column-0 `return: V`), built at slot `slot` of `into`: one step,
# [ret, V] -- a `sub`'s bare `return` is its own one-child RET Structure.
# The shared role identifies the operation; it is never the source occurrence.
# None without a trailer.
fn: l2_rw_trailer (int: mi; int: into; int: slot; @: int made) int
    @: LmP0Structure tr 0
    int: node
    \made: 0
    # §6: a T6/T6b host's `return: model` is not a numeric value -- l2_ret_tr on the method's own
    # frame can even miss it (the parser may hang it on the model's own fn: frame instead,
    # l2_mad_trailer_return checks both spots); l2_rw_may already confirmed one exists.
    if: l2_mad_on(mi) != 0
        return: l2_rw_mad_trailer(mi, into, slot, made)
    # A namespace procedure executes its original Structure occurrence; its
    # compiler method row has no fn node. Keep the real source frame's trailer,
    # not a trailer invented on the translation-only body adapter.
    tr: l2_ret_tr(l2_callable_source_frame(mi))
    if: tr = 0
        return: 0
    if: l2_count_active(tr) = 0
        \made: 1
        if: l2_rw_frame(into, "LMX_WALK_OP_RET", 1, @ node) != 0 || l2_rw_source_facet(node, "LMX_WALK_SOURCE_TRAILER") != 0
            return: 1
        return: l2_rw_put(into, slot, node)
    if: l2_rw_ret(tr\first_field, l2_count_active(tr), into, @ node) != 0 || l2_rw_source_facet(node, "LMX_WALK_SOURCE_TRAILER") != 0
        return: 1
    if: l2_rw_put(into, slot, node) != 0
        return: 1
    \made: 1
return: 0

# §6: a T6/T6b host's trailer is the PRIM-built node, not a numeric [ret, V] -- l2_rw_ret/
# l2_rw_texpr never run for it. l2_mad_trailer_return re-confirms the shape (l2_rw_may already
# checked it, but a direct call keeps this function correct standalone, matching l2_rw_trailer's
# own re-derivation of `tr` from scratch above).
fn: l2_rw_mad_trailer (int: mi; int: into; int: slot; @: int made) int
    int: node
    \made: 0
    if: l2_mad_return_confirmed(mi, l2_mad_model[mi]) = 0
        return: l2_error(l2_src, l2_m_node[mi], "a callable merge needs its return as the host's own trailer")
    if: l2_rw_mad_ret(mi, into, @ node) != 0
        return: 1
    \made: 1
    if: l2_rw_put(into, slot, node) != 0
        return: 1
return: 0

# §6: [ret, [prim, rec, 0, model_ref, in0, in1, ...]] -- rec's native fn is a standalone
# per-host constructor (l2_mad_construct_<mi>, emitted once by l2_emit_mad_constructs). Operand 0
# is the model's own occurrence Structure -- fetched the same way l2_rw_methods_emit fetches any
# method's occurrence (lmx_arena_ref_struct(l2_entry_unit, l2_unit_base+model)), a native
# statement run once when the program's graph is built, then read like any other fixed Structure
# operand (lmx_walk_eval's OP_NONE/STRUCT case, the same shape l2_rw_model already uses for
# l2_nsp[ni]) -- not the host's own node, which no LmxPrimitiveEntry signature carries. Operands
# 1..nc are the values of the host's body the model uses (l2_mcap_*, in their order), the activation's at the
# return -- copied into the node's lexical context (l2_emit_mad_construct_one). Model index/widths/slots are
# translation-time constants baked into the constructor's own generated body, never operands.
fn: l2_rw_mad_ret (int: mi; int: into; @: int out) int
    int: prim
    if: l2_mad_model[mi] < 0
        return: l2_error(l2_src, l2_m_node[mi], "a callable merge lost its model")
    if: l2_rw_frame(into, "LMX_WALK_OP_RET", 2, out) != 0
        return: 1
    # A method that returns a merge builds that merge's node (l2_rw_t7_build); any other host, its model's.
    if: l2_t7_host_site(mi) >= 0 && l2_rw_t7_build(l2_t7_host_site(mi), \out, @ prim) != 0
        return: 1
    if: l2_t7_host_site(mi) < 0 && l2_rw_mad_build(mi, \out, @ prim) != 0
        return: 1
return: l2_rw_put(\out, 1, prim)

# Item 738: the Structure the walked host's own field `name` holds, as an operand -- the slot itself
# for a direct own Structure, DEREF of the cell otherwise (as a path rooted there reads it).
fn: l2_rw_mad_host_struct (int: parent; int: mi; const: @(LmP0Text name); @: int out) int
    int: oi
    int: raw
    oi: l2_mad_host_own(mi, name)
    if: oi < 0
        return: l2_error(l2_src, l2_m_node[mi], "a callable merge lost a captured name")
return: l2_rw_own(parent, oi, out)

# The step that builds the node of the merge at `site`, under `parent`: [prim, record, contract, model, bound
# values].  The record's function is the site's constructor (l2_t7_construct_<site>), the construction the native
# body calls (l2_t7_write). The first operand is the selected model occurrence, a real consumed value and
# therefore a dependency of this host when the host itself is copied; then, in the order the merge
# writes them, the value each formal of the performing method that the merge binds to has where the merge stands.
fn: l2_rw_t7_build (int: site; int: parent; @: int out) int
    []: char cname 64
    int: prim
    int: occ
    int: v
    int: j 0
    int: nv 0
    int: ci 0
    int: at
    int: contract
    int: inputs
    if: site < 0 || site >= l2_t7_n
        return: 1
    while: j < l2_t7_nb[site]
        if: l2_t7b_how[l2_t7_b0[site] + j] != 0
            nv: nv + 1
        j: j + 1
    ---
    if: c.sprintf(cname, "l2_t7_construct_%d", site) < 0
        return: 1
    # Graph copying observes published values, as the other callable constructor does.
    if: l2_rw_frame(parent, "LMX_WALK_OP_PRIM_PUB", 4 + nv, @ prim) != 0
        return: 1
    occ: l2_rw_t
    l2_rw_t: l2_rw_t + 1
    if: l2_use_unit_child(1, l2_t7_model[site]) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        @: Lmx l2_rw%d lmx_arena_ref_struct(l2_entry_unit, %uU)\n        if: l2_rw%d = 0\n            return: 1\n", occ, (cast: (unsigned) l2_occ_slot(l2_t7_model[site])), occ) < 0
        return: 1
    if: l2_rw_put(prim, 3, occ) != 0
        return: 1
    j: 0
    while: j < l2_t7_nb[site]
        at: l2_t7_b0[site] + j
        if: l2_t7b_how[at] != 0
            if: l2_rw_bound(l2_fn(l2_rw_mi, l2_t7b_val[at])) >= 0 && l2_rw_own(prim, l2_rw_bound(l2_fn(l2_rw_mi, l2_t7b_val[at])), @ v) != 0
                return: 1
            if: l2_rw_bound(l2_fn(l2_rw_mi, l2_t7b_val[at])) < 0 && l2_rw_arg(prim, l2_t7b_val[at], @ v) != 0
                return: 1
            if: l2_rw_put(prim, 4 + ci, v) != 0
                return: 1
            ci: ci + 1
        ---
        j: j + 1
    ---
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        @: LmxPrimitive l2_rwp%d (cast: (@: LmxPrimitive) lmx_arena_take(l2_program_arena, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))\n        if: l2_rwp%d = 0\n            return: 1\n        l2_rwp%d\\fn: %s\n        l2_rwp%d\\signature: 0\n        l2_rwp%d\\owner: (cast: (@: Lmx) l2_program_arena)\n        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_rwp%d)) != 0\n            return: 1\n", prim, prim, prim, cname, prim, prim, prim, prim) < 0
        return: 1
    if: l2_rw_contract(prim, 1 + nv, 0, 1, @ contract, @ inputs) != 0 || l2_rw_witness(inputs, 0, 0, 1) != 0
        return: 1
    ci: 0
    while: ci < nv
        if: l2_rw_witness(inputs, 1 + ci, 0, 0) != 0
            return: 1
        ci: ci + 1
    ---
    if: l2_rw_primitive_contract(prim, contract) != 0
        return: 1
    \out: prim
return: 0

# The PRIM that builds host mi's node under parent (the return's operand above).  The values of the host's body the
# model uses are evaluated where it stands: the activation's, there.
fn: l2_rw_mad_build (int: mi; int: parent; @: int out) int
    int: model l2_mad_model[mi]
    int: nc 0
    []: char cname 64
    int: prim
    int: mref
    int: k 0
    int: ci 0
    int: v
    int: fi
    int: oi
    int: contract
    int: inputs
    if: model < 0
        return: l2_error(l2_src, l2_m_node[mi], "a callable merge lost its model")
    while: k < l2_mcap_n
        if: l2_mcap_model[k] = model
            nc: nc + 1
        k: k + 1
    ---
    if: c.sprintf(cname, "l2_mad_construct_%d", mi) < 0
        return: 1
    # §7b: building the callable copies its captures -- graph copying, so PRIM_PUB publishes first.
    if: l2_rw_frame(parent, "LMX_WALK_OP_PRIM_PUB", 4 + nc, @ prim) != 0
        return: 1
    mref: l2_rw_t
    l2_rw_t: l2_rw_t + 1
    if: l2_use_unit_child(1, model) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        @: Lmx l2_rw%d lmx_arena_ref_struct(l2_entry_unit, %uU)\n        if: l2_rw%d = 0\n            return: 1\n", mref, (cast: (unsigned) (l2_occ_slot(model))), mref) < 0
        return: 1
    if: l2_rw_put(prim, 3, mref) != 0
        return: 1
    # The values of the host's body the model uses (l2_mcap_*, in their order), the activation's here: a formal is its
    # input (ARG, or the field it is bound to), an own field its working value or its cell; item 738: a Structure is
    # the Structure the name holds, which the constructor copies.
    k: 0
    while: k < l2_mcap_n
        if: l2_mcap_model[k] = model
            oi: l2_mad_host_own(mi, l2_mcap_name[k])
            fi: l2_param_find(mi, l2_mcap_name[k])
            if: oi < 0 && fi < 0
                return: l2_error(l2_src, l2_m_node[model], "a callable merge lost a captured name")
            if: l2_mcap_ns[k] >= 0 && oi >= 0 && l2_rw_mad_host_struct(prim, mi, l2_mcap_name[k], @ v) != 0
                return: 1
            if: l2_mcap_ns[k] >= 0 && oi < 0 && l2_rw_arg(prim, fi, @ v) != 0
                return: 1
            if: l2_mcap_ns[k] < 0 && oi >= 0 && l2_rw_own(prim, oi, @ v) != 0
                return: 1
            if: l2_mcap_ns[k] < 0 && oi < 0 && l2_rw_bound(l2_mcap_name[k]) >= 0 && l2_rw_own(prim, l2_rw_bound(l2_mcap_name[k]), @ v) != 0
                return: 1
            if: l2_mcap_ns[k] < 0 && oi < 0 && l2_rw_bound(l2_mcap_name[k]) < 0 && l2_rw_arg(prim, fi, @ v) != 0
                return: 1
            if: l2_rw_put(prim, 4 + ci, v) != 0
                return: 1
            ci: ci + 1
        ---
        k: k + 1
    ---
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        @: LmxPrimitive l2_rwp%d (cast: (@: LmxPrimitive) lmx_arena_take(l2_program_arena, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))\n        if: l2_rwp%d = 0\n            return: 1\n        l2_rwp%d\\fn: %s\n        l2_rwp%d\\signature: 0\n        l2_rwp%d\\owner: (cast: (@: Lmx) l2_program_arena)\n        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_rwp%d)) != 0\n            return: 1\n", prim, prim, prim, cname, prim, prim, prim, prim) < 0
        return: 1
    if: l2_rw_contract(prim, 1 + nc, 0, 1, @ contract, @ inputs) != 0 || l2_rw_witness(inputs, 0, 0, 1) != 0
        return: 1
    k: 0
    ci: 1
    while: k < l2_mcap_n
        if: l2_mcap_model[k] = model
            if: l2_rw_witness(inputs, ci, l2_mcap_ty[k], (cast: (int) (l2_mcap_ns[k] >= 0))) != 0
                return: 1
            ci: ci + 1
        ---
        k: k + 1
    ---
    if: l2_rw_primitive_contract(prim, contract) != 0
        return: 1
    \out: prim
return: 0

# T6. return: addN builds one node: the model, {n: the activation's value}, the declared header.
# Frames are the model's, shared by address. native of the node stays 0.
fn: l2_mad_on (int: mi) int
    if: l2_mad_model = 0 || mi < 0 || mi >= l2_mad_cap
        return: 0
return: l2_mad_model[mi] >= 0

# K03 NS-ROLES-V2 (#declaration-visibility): is method r visible from a site in method mi (mi < 0: the unit's root,
# outside every method)?  A callable fn, fm or sub creates is visible both ways within its lexical block: the unit's
# methods throughout the unit, a method's own fn (l2_mad_host_of: a factory's fn) in its host's body and in every method
# nested in that host -- r itself among them -- never from a sibling method or the root.
fn: l2_method_visible_at (int: r; int: mi) int
    int: host l2_mad_host_of(r)
    int: m mi
    int: hops 0
    if: host < 0
        return: 1
    while: m >= 0 && hops <= l2_m_n
        if: m = host
            return: 1
        m: l2_mad_host_of(m)
        hops: hops + 1
    ---
return: 0

# How deep method r's block lies: 0 for a method of the unit, one more for each host above it.
fn: l2_method_depth (int: r) int
    int: d 0
    int: m l2_mad_host_of(r)
    while: m >= 0 && d <= l2_m_n
        d: d + 1
        m: l2_mad_host_of(m)
    ---
return: d

# K03 NS-ROLES-V2: the method a written name t names at a site in method mi (mi < 0: the unit's root) -- among the
# methods of that name, the innermost whose block holds the site (l2_method_visible_at); -1 when none is visible there,
# so that the name reads as any unknown name does.  Every reader of a written method name asks this; a lookup of a
# registered name (registration, a factory's own model) keeps l2_find_method.
fn: l2_site_method (int: mi; const: @(LmP0Text t)) int
    int: i 0
    int: best -1
    int: best_depth -1
    if: t = 0
        return: -1
    while: i < l2_m_n
        if: l2_text_same(l2_m_name[i], t) != 0 && l2_method_visible_at(i, mi) != 0 && l2_method_depth(i) > best_depth
            best: i
            best_depth: l2_method_depth(i)
        i: i + 1
    ---
return: best

fn: l2_mad_host_of (int: mi) int
    if: l2_mad_host = 0 || mi < 0 || mi >= l2_mad_cap
        return: 0 - 1
return: l2_mad_host[mi]

fn: l2_mad_ensure (int: need) int
    @: int nm
    @: int nh
    int: i 0
    if: need <= l2_mad_cap
        return: 0
    if: need < 4
        need: 4
    nm: (cast: (@: int) calloc((cast: (size_t) need), c.sizeof(c.int)))
    nh: (cast: (@: int) calloc((cast: (size_t) need), c.sizeof(c.int)))
    if: nm = 0 || nh = 0
        return: 1
    while: i < need
        nm[i]: 0 - 1
        nh[i]: 0 - 1
        i: i + 1
    i: 0
    while: i < l2_mad_cap
        nm[i]: l2_mad_model[i]
        nh[i]: l2_mad_host[i]
        i: i + 1
    if: l2_mad_model != 0
        l2_xfree((cast: (@: void) l2_mad_model))
    if: l2_mad_host != 0
        l2_xfree((cast: (@: void) l2_mad_host))
    l2_mad_model: nm
    l2_mad_host: nh
    l2_mad_cap: need
return: 0

# `fn: (int: x) int` — a signature, not a new return code.
fn: l2_mad_sig (const: @(LmP0Node node)) int
    @: LmP0Field f
    @: LmP0Field s
    int: ty 0
    if: l2_frame_head(node, "fn") = 0 || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0
        return: 0
    if: l2_count_active(node\as\frame\body) != 2
        return: 0
    f: l2_next_active(node\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_STRUCTURE
        return: 0
    s: l2_next_active(f\next)
    if: s = 0 || s\value = 0 || s\value\kind != c.LM_P0_NODE_ATOM || s\value\as = 0
        return: 0
    if: l2_ret_type_word(s\value\as\atom, 0, 0, @ ty) != 0
        return: 0
return: 1

# node names name anywhere: an atom, a frame head (a call `name: 1` is a head), in fields and in
# trailers.  T6b: a host statement that names a nested method is refused (l2_mad_names_nested).
fn: l2_mad_mentions (const: @(LmP0Node node); const: @(LmP0Text name)) int
    @: LmP0Field f
    if: node = 0 || name = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_ATOM && node\as != 0 && l2_text_same(node\as\atom, name) != 0
        return: 1
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0 && node\as\structure != 0
        f: l2_next_active(node\as\structure\first_field)
        while: f != 0
            if: l2_mad_mentions(f\value, name) != 0
                return: 1
            f: l2_next_active(f\next)
        ---
        if: node\as\structure\trailer != 0 && node\as\structure\trailer\body != 0
            f: l2_next_active(node\as\structure\trailer\body\first_field)
            while: f != 0
                if: l2_mad_mentions(f\value, name) != 0
                    return: 1
                f: l2_next_active(f\next)
            ---
        return: 0
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0 && node\as\frame\head != 0 && l2_text_same(node\as\frame\head, name) != 0
        return: 1
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0
        if: node\as\frame\body != 0
            f: l2_next_active(l2_call_actuals(node\as\frame\body))
            while: f != 0
                if: l2_mad_mentions(f\value, name) != 0
                    return: 1
                f: l2_next_active(f\next)
            ---
        if: node\as\frame\trailer != 0 && node\as\frame\trailer\body != 0
            f: l2_next_active(node\as\frame\trailer\body\first_field)
            while: f != 0
                if: l2_mad_mentions(f\value, name) != 0
                    return: 1
                f: l2_next_active(f\next)
            ---
        ---
    return: 0

# T6b: node returns -- a `return:` frame, or a `return` trailer of a frame or a structure, at any
# depth.  A host's one exit is its `return: model`; any other return is refused before emission.
fn: l2_mad_has_return (const: @(LmP0Node node)) int
    @: LmP0Field f
    @: LmP0Structure st 0
    if: node = 0 || node\as = 0
        return: 0
    if: l2_frame_head(node, "return") != 0
        return: 1
    if: node\kind = c.LM_P0_NODE_FRAME && node\as\frame != 0
        if: l2_ret_tr(node\as\frame) != 0
            return: 1
        st: node\as\frame\body
        ---
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        st: node\as\structure
    if: st = 0
        return: 0
    if: st\trailer != 0 && st\trailer\spelling != 0 && l2_text_eq(st\trailer\spelling, "return") != 0
        return: 1
    f: l2_next_active(l2_call_actuals(st))
    while: f != 0
        if: l2_mad_has_return(f\value) != 0
            return: 1
        f: l2_next_active(f\next)
    ---
return: 0

# D-94: whether node returns a number -- a `return:` frame, or a `return` trailer, whose one value is
# a numeric literal or has a named numeric type.  A callable result cannot be a number: that return
# is a type error of the result, said so, not a limit of the callable merge.
fn: l2_mad_ret_body_number (const: @(LmP0Structure body); int: mi) int
    @: LmP0Field only
    int: ty 0
    if: body = 0 || l2_count_active(body) != 1
        return: 0
    only: l2_next_active(body\first_field)
    if: only = 0 || only\value = 0 || l2_colon_simple_ty(only\value, mi, @ ty) != 0
        return: 0
return: ty = 0 - 10 || (ty != 8 && l2_prim_code_name(ty) != 0)

fn: l2_mad_returns_number (const: @(LmP0Node node); int: mi) int
    @: LmP0Field f
    @: LmP0Structure st 0
    if: node = 0 || node\as = 0
        return: 0
    if: l2_frame_head(node, "return") != 0
        return: l2_mad_ret_body_number(node\as\frame\body, mi)
    if: node\kind = c.LM_P0_NODE_FRAME && node\as\frame != 0
        if: l2_mad_ret_body_number(l2_ret_tr(node\as\frame), mi) != 0
            return: 1
        st: node\as\frame\body
        ---
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        st: node\as\structure
    if: st = 0
        return: 0
    if: st\trailer != 0 && st\trailer\spelling != 0 && l2_text_eq(st\trailer\spelling, "return") != 0 && l2_mad_ret_body_number(st\trailer\body, mi) != 0
        return: 1
    f: l2_next_active(l2_call_actuals(st))
    while: f != 0
        if: l2_mad_returns_number(f\value, mi) != 0
            return: 1
        f: l2_next_active(f\next)
    ---
return: 0

# D-94 (REVIEW e8b8a8d, fable_pc's finding): whether field is the host's return point -- a
# `return: model` statement, or the model's own `fn:` frame when the return hangs there (no such
# statement and no trailer return), exactly as l2_mad_host_body finds it.  What follows it in the
# body is dead: never emitted, natively or in the walk (whose build is the host's trailer, so a
# statement built after the point would run BEFORE the build).  l2_check_body still checks it.
fn: l2_mad_return_point (const: @(LmP0Structure body); int: mi; @: LmP0Field field) int
    @: LmP0Field f
    int: model
    if: body = 0 || field = 0 || field\value = 0 || l2_mad_model = 0 || mi < 0
        return: 0
    model: l2_mad_model[mi]
    if: model < 0
        return: 0
    if: l2_mad_is_return(field\value, model) != 0 || l2_t7_return_stmt(mi, field\value) != 0
        return: 1
    if: l2_frame_head(field\value, "fn") = 0 || field\value != l2_m_node[model]
        return: 0
    f: l2_next_active(body\first_field)
    while: f != 0
        if: l2_mad_is_return(f\value, model) != 0
            return: 0
        f: l2_next_active(f\next)
    ---
    if: l2_mad_trailer_return(mi, model) != 0
        return: 0
return: 1

# `return: model` as a statement of the host's body.
fn: l2_mad_is_return (const: @(LmP0Node stmt); int: model) int
    @: LmP0Field only
    if: model < 0 || l2_frame_head(stmt, "return") = 0 || stmt\as\frame\body = 0 || l2_count_active(stmt\as\frame\body) != 1
        return: 0
    only: l2_next_active(stmt\as\frame\body\first_field)
    if: only = 0 || only\value = 0 || only\value\kind != c.LM_P0_NODE_ATOM || only\value\as = 0
        return: 0
return: l2_find_method(only\value\as\atom) = model

# stmt names a method nested in host mi -- the model or another -- that captures host names (its
# native function is the stub, returning 0, so the host cannot call it as C).  A nested method
# that captures nothing has its own native body and is called like any other; a capturing one may be
# called (l2_mad_nested_call, A3: over its own occurrence, walked, its captures the host's values as
# hidden inputs), but not named as a value.  No fixture reaches
# this refusal today: the check pass refuses a value mention first (a bare atom is a nullary call,
# "incompatible entry signature"), and a T7 host has no nested method -- kept as the emitter's guard.
fn: l2_mad_names_nested (const: @(LmP0Node stmt); int: mi) int
    int: k 0
    while: k < l2_m_n
        if: l2_mad_host_of(k) = mi && l2_mcap_count(k) > 0 && l2_mad_nested_call(mi, k) = 0 && l2_mad_mentions(stmt, l2_m_name[k]) != 0
            return: 1
        if: l2_mad_host_of(k) = mi && l2_mcap_count(k) > 0 && l2_mad_nested_call(mi, k) != 0 && l2_mad_mentions_value(stmt, l2_m_name[k]) != 0
            return: 1
        k: k + 1
    ---
return: 0

# D-93: node names name other than as a call's head (`name: 1`): an atom, in fields and trailers.
fn: l2_mad_mentions_value (const: @(LmP0Node node); const: @(LmP0Text name)) int
    @: LmP0Field f
    if: node = 0 || name = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_ATOM && node\as != 0 && l2_text_same(node\as\atom, name) != 0
        return: 1
    if: node\kind = c.LM_P0_NODE_STRUCTURE && node\as != 0 && node\as\structure != 0
        f: l2_next_active(node\as\structure\first_field)
        while: f != 0
            if: l2_mad_mentions_value(f\value, name) != 0
                return: 1
            f: l2_next_active(f\next)
        ---
        if: node\as\structure\trailer != 0 && node\as\structure\trailer\body != 0
            f: l2_next_active(node\as\structure\trailer\body\first_field)
            while: f != 0
                if: l2_mad_mentions_value(f\value, name) != 0
                    return: 1
                f: l2_next_active(f\next)
            ---
        return: 0
    if: node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0
        if: node\as\frame\body != 0
            f: l2_next_active(l2_call_actuals(node\as\frame\body))
            while: f != 0
                if: l2_mad_mentions_value(f\value, name) != 0
                    return: 1
                f: l2_next_active(f\next)
            ---
        if: node\as\frame\trailer != 0 && node\as\frame\trailer\body != 0
            f: l2_next_active(node\as\frame\trailer\body\first_field)
            while: f != 0
                if: l2_mad_mentions_value(f\value, name) != 0
                    return: 1
                f: l2_next_active(f\next)
            ---
        ---
return: 0

# A trailer `return: model`.
fn: l2_mad_tr_is (const: @(LmP0Structure tr); int: model) int
    @: LmP0Field only
    if: tr = 0 || model < 0 || l2_count_active(tr) != 1
        return: 0
    only: l2_next_active(tr\first_field)
    if: only = 0 || only\value = 0 || only\value\kind != c.LM_P0_NODE_ATOM || only\value\as = 0
        return: 0
return: l2_find_method(only\value\as\atom) = model

# `return: model` as the trailer of the host's method frame or of its signature's `fn:` frame: a
# return after every statement of the body.
fn: l2_mad_trailer_return (int: mi; int: model) int
    @: LmP0Field f
    if: l2_m_node[mi] = 0 || l2_m_node[mi]\as = 0 || l2_m_node[mi]\as\frame = 0
        return: 0
    if: l2_mad_tr_is(l2_ret_tr(l2_m_node[mi]\as\frame), model) != 0
        return: 1
    if: l2_m_node[mi]\as\frame\body = 0
        return: 0
    f: l2_next_active(l2_m_node[mi]\as\frame\body\first_field)
    if: f != 0
        f: l2_next_active(f\next)
    if: f != 0
        f: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || l2_frame_head(f\value, "fn") = 0
        return: 0
return: l2_mad_tr_is(l2_ret_tr(f\value\as\frame), model)

# §6: the full "does mi have a confirmed return: model" check l2_mad_host_body's own native path
# already uses (:22186 area, its own three-way "where the return is" comment) -- (1) an ordinary
# `return: model` body FIELD (l2_mad_is_return); (2) the trailer-hung form (l2_mad_trailer_return,
# T6b: statements before the nested fn:); (3) neither found (at_fn stays 1, l2_mad_host_body's own
# :22214 `stmt = l2_m_node[model]`), so the model's own `fn:` field appearing as a body field is
# itself the implicit exit -- T6's simplest shape (unit_make_adder.lm2: no leading statements, no
# explicit return: model anywhere, the nested fn: is the body's only field). l2_mad_trailer_return
# alone is not the whole answer, and neither is adding just case (1); this is, and is what
# l2_rw_may/l2_rw_mad_trailer call.
fn: l2_mad_return_confirmed (int: mi; int: model) int
    @: LmP0Field f
    # A method recorded with the merge it returns: that return is its one exit, wherever it stands.
    if: l2_t7_host_site(mi) >= 0
        return: 1
    if: l2_m_body[mi] = 0 || l2_m_body[mi]\as = 0 || l2_m_body[mi]\as\structure = 0
        return: l2_mad_trailer_return(mi, model)
    f: l2_next_active(l2_m_body[mi]\as\structure\first_field)
    while: f != 0
        if: l2_mad_is_return(f\value, model) != 0
            return: 1
        f: l2_next_active(f\next)
    ---
    if: l2_mad_trailer_return(mi, model) != 0
        return: 1
    f: l2_next_active(l2_m_body[mi]\as\structure\first_field)
    while: f != 0
        if: f\value = l2_m_node[model]
            return: 1
        f: l2_next_active(f\next)
    ---
return: 0

# The field host declares at method level under name, the last such, or -1.  Not the lexical
# chain: a unit field or a field of a nested body of the host is not the host's activation.
fn: l2_mad_host_own (int: host; const: @(LmP0Text name)) int
    int: i 0
    int: hit 0 - 1
    if: host < 0 || name = 0
        return: 0 - 1
    while: i < l2_own_n
        if: l2_own_mi[i] = host && l2_own_host[i] = 0 && l2_text_same(l2_own_name[i], name) != 0
            hit: i
        i: i + 1
    ---
return: hit

# A numeric capture is an independent typed value cell the walk reads through AT.
fn: l2_mcap_ty_ok (int: ty) int
    if: ty = 0 || ty = 1 || ty = 2 || ty = 3 || ty = 36
        return: 1
return: 0

fn: l2_mcap_new_helper (int: ty) @: char
    if: ty = 1
        return: "lmx_char_new_owned"
    if: ty = 2
        return: "lmx_size_new_owned"
    if: ty = 3
        return: "lmx_unsigned_new_owned"
    if: ty = 36
        return: "lmx_ulong_new_owned"
return: "lmx_int_new_owned"

# §6: the walked constructor reads a capture's value out of refs[] (a walker-evaluated operand,
# never a native C expression) with the getter matching l2_mcap_new_helper/l2_own_store_helper's
# same type.
fn: l2_mcap_value_helper (int: ty) const: @: char
    if: ty = 1
        return: "lmx_char_value_known"
    if: ty = 2
        return: "lmx_size_value_known"
    if: ty = 3
        return: "lmx_unsigned_value_known"
    if: ty = 36
        return: "lmx_ulong_value_known"
return: "lmx_int_value_known"

fn: l2_mcap_add (int: mi; const: @(LmP0Text name); int: ty; int: ns) int
    int: k 0
    int: room
    @: LmP0Text saved
    @: int nm
    @: int nt
    @: int nns
    @@: LmP0Text nn
    while: k < l2_mcap_n
        if: l2_mcap_model[k] = mi && l2_text_same(l2_mcap_name[k], name) != 0
            return: 0
        k: k + 1
    ---
    if: l2_mcap_n >= l2_mcap_room
        room: l2_mcap_room * 2
        if: room < 8
            room: 8
        nm: (cast: (@: int) calloc((cast: (size_t) room), c.sizeof(c.int)))
        nt: (cast: (@: int) calloc((cast: (size_t) room), c.sizeof(c.int)))
        nn: (cast: (@@: LmP0Text) calloc((cast: (size_t) room), c.sizeof(@: char)))
        nns: (cast: (@: int) calloc((cast: (size_t) room), c.sizeof(c.int)))
        if: nm = 0 || nt = 0 || nn = 0 || nns = 0
            return: l2_error(l2_src, 0, "out of memory")
        k: 0
        while: k < l2_mcap_n
            nm[k]: l2_mcap_model[k]
            nt[k]: l2_mcap_ty[k]
            nn[k]: l2_mcap_name[k]
            nns[k]: l2_mcap_ns[k]
            k: k + 1
        ---
        if: l2_mcap_ns != 0
            l2_xfree((cast: (@: void) l2_mcap_ns))
        l2_mcap_ns: nns
        if: l2_mcap_model != 0
            l2_xfree((cast: (@: void) l2_mcap_model))
        if: l2_mcap_ty != 0
            l2_xfree((cast: (@: void) l2_mcap_ty))
        if: l2_mcap_name != 0
            l2_xfree((cast: (@: void) l2_mcap_name))
        l2_mcap_model: nm
        l2_mcap_ty: nt
        l2_mcap_name: nn
        l2_mcap_room: room
        ---
    # A capture may arrive as a temporary prefix view of a path head. Own
    # that view, as hidden-input storage does, while borrowing live P0 bytes.
    l2_alloc_kind: 5
    saved: (cast: (@: LmP0Text) l2_xmalloc(c.sizeof(c.LmP0Text)))
    if: saved = 0
        return: l2_alloc_or(l2_src, l2_m_node[mi], "out of memory")
    saved\data: name\data
    saved\length: name\length
    l2_mcap_model[l2_mcap_n]: mi
    l2_mcap_ty[l2_mcap_n]: ty
    l2_mcap_ns[l2_mcap_n]: ns
    l2_mcap_name[l2_mcap_n]: saved
    l2_mcap_n: l2_mcap_n + 1
return: 0

# How many host names nested method mi captures (l2_scan_ident recorded them).  A nested method that
# captures nothing uses the same completed native entry as a capturing method.
# Captures are hidden inputs (A3); an absent input reads the existing snapshot
# cell. Its host calls it through its actual leaf (l2_mad_nested_call).
fn: l2_mcap_count (int: mi) int
    int: k 0
    int: n 0
    while: k < l2_mcap_n
        if: l2_mcap_model[k] = mi
            n: n + 1
        k: k + 1
    ---
return: n

# A3: capture t of nested method mi joins its hidden inputs, typed as the host's value is: a number by its cell,
# a Structure (whole) as the reference it is.
fn: l2_cap_dyn_add (int: mi; const: @(LmP0Text t); int: ty; int: whole) int
    int: dt
    dt: l2_dt_of_own(ty)
    if: dt = 0 && whole != 0
        dt: l2_graph_dt()
    if: dt = 0
        return: l2_error(l2_src, l2_m_node[mi], "a capture whose type has no value cell")
return: l2_dyn_add(mi, t, dt)

# A3 with item 738: the named Structure type of input k of method mi when it is a Structure capture -- a hidden
# input whose name the host's activation gives (l2_mcap_*) -- or -1.
fn: l2_cap_arg_ns (int: mi; int: k) int
    int: c
    if: mi < 0 || mi >= l2_m_n || k < l2_m_arity[mi] || k >= l2_m_arity[mi] + l2_m_dyn[mi]
        return: 0 - 1
    c: l2_cap_named(mi, l2_dn(mi, k - l2_m_arity[mi]))
    if: c = 0
        return: 0 - 1
return: l2_mcap_ns[c - 1]

# A3 with D-105: name, in caller mi, is a formal some call site fills by name with another type -- its value is
# admitted already, with its table (l2_d105_emit_admit, l2_rw_admit_as).
fn: l2_cap_src_marked (int: mi; const: @(LmP0Text name)) int
    int: fi
    if: mi < 0 || name = 0
        return: 0
    fi: l2_formal_find(mi, name)
    if: fi < 0
        return: 0
return: l2_d105_sub(mi, fi)

# Item 738 with A3: the Structure host mi's name holds, as its code reads it here -- its formal, or its own
# field's working value, else the field's load.
fn: l2_cap_host_src (int: mi; const: @(LmP0Text name); const: @(char ind); @: L2Tx dest) int
    int: fi
    int: oi
    fi: l2_formal_find(mi, name)
    if: fi >= 0
        return: l2_tok_formal(mi, fi, dest)
    oi: l2_mad_host_own(mi, name)
    if: oi < 0
        return: l2_error(l2_src, l2_m_node[mi], "a callable merge lost a captured name")
    if: l2_own_cached(l2_work_mi, oi) != 0
        return: l2_own_load(oi, dest)
return: l2_emit_path_load(mi, oi, ind, dest)

# A3 with item 738: the host's own Structure handed to its nested method is admitted as the capture's type
# itself -- the method reads it through that type's table (path kind 7), as it reads the node's copy.
fn: l2_cap_emit_admit (int: ns; const: @(char value); const: @(char ind)) int
    []: char inst_own 128
    L2Tx: inst_tx
    @: L2Tx inst l2_tx_local(@ inst_tx, inst_own, 128U)
    if: l2_type_inst(ns, inst) != 0
        return: l2_error(l2_src, 0, "internal: a captured Structure's type has no shape")
    if: c.fprintf(l2_out, "%sif: lmx_implements_register_map(l2_program_arena, (cast: (@: Lmx) %s), %s, 0, 0U, 0) != c.LMX_IMPLEMENTS_YES\n%s    c.fprintf(c.stderr, \"lmx: invariant: a captured Structure was not admitted as itself\\n\")\n%s    c.abort()\n", ind, value, inst\data, ind, ind) < 0
        return: 1
return: 0

# Slot of host name t in model mi's node, or -1. Slot 0 is args, 1 is return, then the captures
# in the order the scan recorded them (T6b: what the model resolves, not every host formal).
fn: l2_mad_slot (int: mi; const: @(LmP0Text name)) int
    int: k 0
    int: slot 2
    if: l2_mad_host_of(mi) < 0 || name = 0 || l2_m_body[mi] = 0
        return: 0 - 1
    while: k < l2_mcap_n
        if: l2_mcap_model[k] = mi
            if: l2_text_same(l2_mcap_name[k], name) != 0
                return: slot
            slot: slot + 1
            ---
        k: k + 1
    ---
return: 0 - 1

# Item 738: is t a path `name\...` rooted at a Structure capture of model mi -- 1 + the capture's
# index in l2_mcap_*, or 0?  Such a path is the walk's (the model is interpreted, its native function
# a stub): its fields are checked there and by the capture (l2_cap_text), not by the native path root.
fn: l2_cap_path_head (int: mi; const: @(LmP0Text t)) int
    size_t: e 0U
    int: k 0
    if: t = 0 || t\data = 0 || mi < 0
        return: 0
    while: e < t\length && t\data[e] != 92
        e: e + 1U
    ---
    if: e = 0U || e >= t\length
        return: 0
    while: k < l2_mcap_n
        if: l2_mcap_model[k] = mi && l2_mcap_ns[k] >= 0 && l2_mcap_name[k] != 0 && l2_mcap_name[k]\length = e && memcmp(l2_mcap_name[k]\data, t\data, e) = 0
            return: k + 1
        k: k + 1
    ---
return: 0

# Item 738: the root of a frame head `name\f` in model mi.  In value position the root is an atom
# of its own and l2_scan_ident meets it; a head is one text, so a model that only writes through a
# capture (`m\count: x`) recorded no capture, and its check refused the head as an unknown path root.
# The root resolves as that atom would: the host's formal or own field of that spelling, by its own
# name -- so the model's own names shadow it here as there.
fn: l2_scan_path_root (int: mi; const: @(LmP0Text t); @: int seen) int
    size_t: e 0U
    int: host
    int: j 0
    LmP0Text: root
    if: mi < 0 || t = 0 || t\data = 0
        return: 0
    host: l2_mad_host_of(mi)
    if: host < 0
        return: 0
    while: e < t\length && t\data[e] != 92
        e: e + 1U
    ---
    if: e = 0U || e >= t\length
        return: 0
    # `node\name: v` -- a lexical use of the host's body (l2_scan_node_use).
    if: e = 4U && memcmp(t\data, "node", 4U) = 0
        return: l2_scan_node_text(mi, t, e + 1U)
    # Keep the occurrence of the read, not the declaration's text. Hidden
    # input provenance determines read versus forwarding in the common pass.
    root.data: t\data
    root.length: e
    while: j < l2_m_arity[host]
        if: l2_fn(host, j) != 0 && l2_fn(host, j)\length = e && memcmp(l2_fn(host, j)\data, t\data, e) = 0
            return: l2_scan_ident(mi, @ root, seen)
        j: j + 1
    ---
    j: 0
    while: j < l2_own_n
        if: l2_own_mi[j] = host && l2_own_host[j] = 0 && l2_own_name[j] != 0 && l2_own_name[j]\length = e && memcmp(l2_own_name[j]\data, t\data, e) = 0
            return: l2_scan_ident(mi, @ root, seen)
        j: j + 1
    ---
return: 0

# `node\name` in nested method mi (book §3): name is a value of its host's body -- the host's formal or own field --
# which the node its host's return builds carries in its copied context (l2_mad_emit).  A lexical use: recorded
# with the captures (l2_mcap_*, its type kept), not a hidden input of mi -- the method reads it through `node`, never
# from its caller.
fn: l2_scan_node_use (int: mi; const: @(LmP0Text name)) int
    int: host
    int: fi
    int: oi
    int: ty
    host: l2_mad_host_of(mi)
    if: host < 0 || name = 0 || l2_hr_on != 0
        return: 0
    fi: l2_formal_find(host, name)
    if: fi >= 0
        ty: l2_own_ty_of_param(l2_ft(host, fi))
        if: l2_nsty_get(host, fi) >= 0
            return: l2_mcap_add(mi, name, ty, l2_nsty_get(host, fi))
        if: l2_mcap_ty_ok(ty) != 0
            return: l2_mcap_add(mi, name, ty, 0 - 1)
        return: 0
    ---
    oi: l2_mad_host_own(host, name)
    if: oi >= 0 && l2_own_capture_ns(oi) >= 0
        return: l2_mcap_add(mi, name, l2_own_ty[oi], l2_own_capture_ns(oi))
    if: oi >= 0 && l2_mcap_ty_ok(l2_own_ty[oi]) != 0
        return: l2_mcap_add(mi, name, l2_own_ty[oi], 0 - 1)
return: 0

# The same for a frame head `node\name...` whose name starts at byte off of t: the head's text, once.
fn: l2_scan_node_text (int: mi; const: @(LmP0Text t); size_t: off) int
    size_t: e off
    int: host
    int: j 0
    host: l2_mad_host_of(mi)
    if: host < 0 || t = 0 || t\data = 0 || off >= t\length
        return: 0
    while: e < t\length && t\data[e] != 92
        e: e + 1U
    ---
    while: j < l2_m_arity[host]
        if: l2_fn(host, j) != 0 && l2_name_is_seg(l2_fn(host, j), t\data, off, e - off) != 0
            return: l2_scan_node_use(mi, l2_fn(host, j))
        j: j + 1
    ---
    j: 0
    while: j < l2_own_n
        if: l2_own_mi[j] = host && l2_own_host[j] = 0 && l2_own_name[j] != 0 && l2_name_is_seg(l2_own_name[j], t\data, off, e - off) != 0
            return: l2_scan_node_use(mi, l2_own_name[j])
        j: j + 1
    ---
return: 0

# FIXED-BLOCKS-AUDIT: the places the constructor of model mi's node needs for the fields one capture of a Structure
# copies -- as many as the widest captured Structure has fields, at least one.
fn: l2_mad_capf_room (int: mi) int
    int: k 0
    int: room 1
    while: k < l2_mcap_n
        if: l2_mcap_model[k] = mi && l2_mcap_ns[k] >= 0 && l2_ns_width(l2_mcap_ns[k]) > room
            room: l2_ns_width(l2_mcap_ns[k])
        k: k + 1
    ---
return: room

# Item 738: does model mi capture a Structure?  Only then do its host and its walk constructor
# declare the capture's field list (l2_capf).
fn: l2_mad_struct_caps (int: mi) int
    int: k 0
    while: k < l2_mcap_n
        if: l2_mcap_model[k] = mi && l2_mcap_ns[k] >= 0
            return: 1
        k: k + 1
    ---
return: 0

# Item 738: is name a Structure capture of model mi -- 1 + its index in l2_mcap_*, or 0?
fn: l2_cap_named (int: mi; const: @(LmP0Text name)) int
    int: k 0
    if: name = 0 || mi < 0
        return: 0
    while: k < l2_mcap_n
        if: l2_mcap_model[k] = mi && l2_mcap_ns[k] >= 0 && l2_text_same(l2_mcap_name[k], name) != 0
            return: k + 1
        k: k + 1
    ---
return: 0

# Item 738: one text of model mi's body -- if it is a path `name\f` through the capture, f's slot in
# ns joins out[0..n) (ascending, once).  A path deeper than the field, a name ns has not, or a field
# that is itself a Structure is refused, located (slice 1 copies value fields one level deep).
fn: l2_cap_text (const: @(LmP0Text t); const: @(LmP0Node at); const: @(LmP0Text name); int: ns; @: int out; int: cap; @: int n) int
    size_t: off
    size_t: e
    size_t: b 0U
    if: t = 0 || t\data = 0 || name = 0
        return: 0
    # `node\m\f`: the same field of the capture, named through `node` (book §3).
    if: t\length > 5U && memcmp(t\data, "node", 4U) = 0 && t\data[4] = 92
        b: 5U
    if: t\length <= b + name\length + 1U
        return: 0
    if: memcmp(t\data + b, name\data, name\length) != 0 || t\data[b + name\length] != 92
        return: 0
    off: b + name\length + 1U
    e: off
    while: e < t\length && t\data[e] != 92
        e: e + 1U
    ---
    if: e < t\length
        return: l2_error(l2_src, at, "a path through a captured Structure goes past its field (item 738: one level)")
return: l2_cap_add(t\data, off, e - off, at, ns, out, cap, n)

# Item 738: the field pd[off..off+len) of named Structure ns joins out[0..n) (its slot, ascending, once).
fn: l2_cap_add (const: @(char pd); size_t: off; size_t: len; const: @(LmP0Node at); int: ns; @: int out; int: cap; @: int n) int
    int: slot
    int: row
    int: kind 0
    int: ent 0
    int: k
    int: m
    row: l2_ns_named_row(ns, pd, off, len, @ kind, @ ent)
    if: row < 0
        return: l2_error(l2_src, at, "a path through a captured Structure names no field of its type")
    if: kind = 2 || kind = 3 || kind = 10
        return: l2_error(l2_src, at, "a captured Structure's Structure field is not copied yet (item 738: value fields)")
    # A number or a char (kinds 0, 1, 7, 8, 9) is what lmx_walk_capture copies; a callable, an array
    # or a reference's pointee is not copied yet.  So every field named here is one the kernel copies.
    if: kind != 0 && kind != 1 && kind != 7 && kind != 8 && kind != 9
        return: l2_error(l2_src, at, "a captured Structure's field that is not a number or a char is not copied yet (item 738: value fields)")
    # Validation-only traversal needs no slot list or artificial capacity.
    if: out = 0
        return: 0
    slot: l2_nsf_slot(row)
    if: slot < 0
        return: l2_error(l2_src, at, "internal: a captured field has no completed source place")
    k: 0
    while: k < \n && out[k] < slot
        k: k + 1
    ---
    if: k < \n && out[k] = slot
        return: 0
    if: \n >= cap
        return: l2_error(l2_src, at, "a captured Structure has too many fields read")
    m: \n
    while: m > k
        out[m]: out[m - 1]
        m: m - 1
    ---
    out[k]: slot
    \n: \n + 1
return: 0

fn: l2_cap_scan_struct (const: @(LmP0Structure s); const: @(LmP0Text name); int: ns; @: int out; int: cap; @: int n) int
    @: LmP0Field f
    @: LmP0Field s1
    @: LmP0Field s2
    @: LmP0Field s3
    if: s = 0
        return: 0
    f: l2_next_active(l2_call_actuals(s))
    while: f != 0
        # In value position P0 gives a path as atoms: `name`, the separator, the field (SOURCE FIELD
        # PATHS); in update position as one frame head text (l2_cap_text).
        s1: 0
        if: f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM && f\value\as != 0 && l2_text_same(f\value\as\atom, name) != 0
            s1: l2_next_active(f\next)
        if: s1 != 0 && (s1\value = 0 || s1\value\kind != c.LM_P0_NODE_ATOM || s1\value\as = 0 || l2_is_slash(s1\value\as\atom) = 0)
            s1: 0
        if: s1 != 0
            s2: l2_next_active(s1\next)
            if: s2 = 0 || s2\value = 0 || s2\value\kind != c.LM_P0_NODE_ATOM || s2\value\as = 0 || s2\value\as\atom = 0
                return: l2_error(l2_src, f\value, "a path through a captured Structure names no field of its type")
            s3: l2_next_active(s2\next)
            if: s3 != 0 && s3\value != 0 && s3\value\kind = c.LM_P0_NODE_ATOM && s3\value\as != 0 && l2_is_slash(s3\value\as\atom) != 0
                return: l2_error(l2_src, f\value, "a path through a captured Structure goes past its field (item 738: one level)")
            if: l2_cap_add(s2\value\as\atom\data, 0U, s2\value\as\atom\length, s2\value, ns, out, cap, n) != 0
                return: 1
            f: s3
            continue
        ---
        if: l2_cap_scan(f\value, name, ns, out, cap, n) != 0
            return: 1
        f: l2_next_active(f\next)
    ---
    if: s\trailer != 0 && l2_cap_scan_struct(s\trailer\body, name, ns, out, cap, n) != 0
        return: 1
return: 0

fn: l2_cap_scan (const: @(LmP0Node node); const: @(LmP0Text name); int: ns; @: int out; int: cap; @: int n) int
    if: node = 0 || node\as = 0
        return: 0
    if: node\kind = c.LM_P0_NODE_ATOM
        return: l2_cap_text(node\as\atom, node, name, ns, out, cap, n)
    if: node\kind = c.LM_P0_NODE_STRUCTURE
        return: l2_cap_scan_struct(node\as\structure, name, ns, out, cap, n)
    if: node\kind != c.LM_P0_NODE_FRAME || node\as\frame = 0
        return: 0
    if: l2_cap_text(node\as\frame\head, node, name, ns, out, cap, n) != 0
        return: 1
    if: l2_cap_scan_struct(node\as\frame\body, name, ns, out, cap, n) != 0
        return: 1
    if: node\as\frame\trailer != 0 && l2_cap_scan_struct(node\as\frame\trailer\body, name, ns, out, cap, n) != 0
        return: 1
return: 0

# Item 738 (Q42 p. 2: only the fields read are copied): the fields of named Structure ns that model mi
# reads or writes through its capture `name`, as their slots in ns, ascending -- the copy's order.
# Their number, or -1 once refused.
fn: l2_cap_fields (int: mi; const: @(LmP0Text name); int: ns; @: int out; int: cap) int
    int: n 0
    if: mi < 0 || mi >= l2_m_n || l2_m_node[mi] = 0 || name = 0 || ns < 0
        return: 0 - 1
    if: l2_cap_scan(l2_m_node[mi], name, ns, out, cap, @ n) != 0
        return: 0 - 1
return: n

# The storage code of capture name of model mi, or -1.
fn: l2_mad_slot_ty (int: mi; const: @(LmP0Text name)) int
    int: k 0
    if: name = 0
        return: 0 - 1
    while: k < l2_mcap_n
        if: l2_mcap_model[k] = mi && l2_text_same(l2_mcap_name[k], name) != 0
            return: l2_mcap_ty[k]
        k: k + 1
    ---
return: 0 - 1

# T6b (D-92): the host's statements run, in order, before its return builds the node.  The nested
# `fn`s are the host's models, not statements; the return is the build.  Before this the body was
# replaced whole by the build, and `n: n + 1` ahead of the return was never emitted.
#
# Where the return is: a `return: model` statement of the body; else the trailer of the method or
# of its signature's `fn:` frame, after every statement; else the model's own `fn:` field -- the
# parser hangs a `return: model` that follows the model's block on that frame, and
# l2_mad_take_nested took it off there.  A statement after the return, one that names a capturing
# nested method other than as a call of it (its native function returns 0; A3: the call goes through
# its leaf), or one that returns, is refused: the build is
# the host's one exit.  D-94: a statement after the return is dead -- checked, never emitted (natively
# or in the walk, l2_mad_return_point); a return of a number is the result's type error.
fn: l2_mad_host_body (const: @(LmP0Structure body); int: mi; const: @(char ind)) int
    @: LmP0Field f
    @: LmP0Field seg
    @: LmP0Node stmt
    int: model
    int: done 0
    int: cut
    int: at_fn 1
    model: l2_mad_model[mi]
    if: body = 0 || model < 0
        return: l2_mad_emit(mi, ind)
    f: l2_next_active(body\first_field)
    while: f != 0
        if: l2_mad_is_return(f\value, model) != 0 || l2_t7_return_stmt(mi, f\value) != 0
            at_fn: 0
        f: l2_next_active(f\next)
    ---
    if: at_fn != 0 && l2_mad_trailer_return(mi, model) != 0
        at_fn: 0
    seg: l2_next_active(body\first_field)
    f: seg
    while: f != 0
        stmt: f\value
        if: done != 0
            f: 0
            continue
        cut: 0
        if: l2_frame_head(stmt, "fn") != 0
            cut: 1
            if: at_fn != 0 && stmt = l2_m_node[model]
                cut: 2
            ---
        if: l2_mad_is_return(stmt, model) != 0 || l2_t7_return_stmt(mi, stmt) != 0
            cut: 2
        if: cut = 0 && l2_mad_names_nested(stmt, mi) != 0
            return: l2_error(l2_src, stmt, "a callable merge host names a nested method outside the return")
        if: cut = 0 && l2_mad_returns_number(stmt, mi) != 0
            return: l2_error(l2_src, stmt, "a callable result returns a number")
        if: cut = 0 && l2_mad_has_return(stmt) != 0
            return: l2_error(l2_src, stmt, "a callable merge host returns outside its model")
        if: cut != 0
            if: l2_emit_stmts(body, seg, f, mi, ind, 0) != 0
                return: 1
            seg: l2_next_active(f\next)
            if: cut = 2
                done: 1
            ---
        f: l2_next_active(f\next)
    ---
    if: done = 0 && l2_emit_stmts(body, seg, 0, mi, ind, 0) != 0
        return: 1
return: l2_mad_emit(mi, ind)

fn: l2_mad_take_nested (int: mi; @: LmP0Node body; const: @(char path)) int
    @: LmP0Field field
    @: LmP0Node stmt
    @: LmP0Text nm
    @: LmP0Structure tr
    @: LmP0Field only
    @: LmP0Frame frw
    int: model 0 - 1
    int: idx
    int: selfret
    int: merges 0
    @: LmP0Node mnode 0
    if: l2_mad_ensure(l2_m_n) != 0
        return: l2_error(path, body, "out of memory")
    if: body != 0 && (body\kind != c.LM_P0_NODE_STRUCTURE || body\as = 0 || body\as\structure = 0)
        return: l2_error(path, body, "a callable merge needs one model")
    field: 0
    if: body != 0
        field: l2_next_active(body\as\structure\first_field)
    while: field != 0
        stmt: field\value
        selfret: 0
        if: l2_frame_head(stmt, "fn") != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0
            nm: 0
            only: l2_next_active(stmt\as\frame\body\first_field)
            if: only != 0 && only\value != 0 && only\value\kind = c.LM_P0_NODE_ATOM && only\value\as != 0
                nm: only\value\as\atom
            tr: l2_ret_tr(stmt\as\frame)
            if: tr != 0 && l2_count_active(tr) = 1 && nm != 0
                only: l2_next_active(tr\first_field)
                if: only != 0 && only\value != 0 && only\value\kind = c.LM_P0_NODE_ATOM && only\value\as != 0 && l2_text_same(only\value\as\atom, nm) != 0
                    selfret: 1
                    frw: (cast: (@: LmP0Frame) stmt\as\frame)
                    frw\trailer: 0
                ---
            # Collection publishes this declaration's row first, then any
            # nested methods/callable-formal descriptors. A bound declaration
            # may publish no row at all. Never assign its host to the last row
            # of those later producers, or to an earlier existing row.
            idx: l2_m_n
            if: l2_collect_method(stmt, path, mi) != 0
                return: 1
            if: l2_mad_ensure(l2_m_n) != 0
                return: l2_error(path, stmt, "out of memory")
            idx: l2_collected_row(idx, stmt)
            if: idx < 0 - 1
                return: l2_error(path, stmt, "internal: nested method collection lost its declaration row")
            if: idx >= 0
                l2_mad_host[idx]: mi
                if: selfret != 0
                    model: idx
                ---
            ---
        if: l2_frame_head(stmt, "return") != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0 && l2_count_active(stmt\as\frame\body) = 1
            only: l2_next_active(stmt\as\frame\body\first_field)
            if: only != 0 && only\value != 0 && only\value\kind = c.LM_P0_NODE_ATOM && only\value\as != 0
                idx: l2_find_method(only\value\as\atom)
                if: idx >= 0 && idx != l2_e
                    model: idx
                ---
            if: only != 0 && only\value != 0 && l2_frame_head(only\value, "merge") != 0
                merges: merges + 1
                mnode: only\value
            ---
        field: l2_next_active(field\next)
    # A lone `return:` is the method trailer, not a body statement.
    if: merges = 0 && model < 0 && l2_m_node[mi] != 0 && l2_m_node[mi]\as != 0
        tr: l2_ret_tr(l2_m_node[mi]\as\frame)
        if: tr != 0 && l2_count_active(tr) = 1
            only: l2_next_active(tr\first_field)
            if: only != 0 && only\value != 0 && only\value\kind = c.LM_P0_NODE_ATOM && only\value\as != 0
                idx: l2_find_method(only\value\as\atom)
                if: idx >= 0 && idx != l2_e
                    model: idx
                ---
            if: only != 0 && only\value != 0 && l2_frame_head(only\value, "merge") != 0
                merges: 1
                mnode: only\value
            ---
        ---
    # The indented return of `fn: name (...) fn: ...` hangs on the signature frame.
    if: merges = 0 && model < 0 && l2_m_node[mi] != 0 && l2_m_node[mi]\as != 0 && l2_m_node[mi]\as\frame\body != 0
        field: l2_next_active(l2_m_node[mi]\as\frame\body\first_field)
        if: field != 0
            field: l2_next_active(field\next)
        if: field != 0
            field: l2_next_active(field\next)
        if: field != 0 && field\value != 0 && l2_frame_head(field\value, "fn") != 0
            tr: l2_ret_tr(field\value\as\frame)
            if: tr != 0 && l2_count_active(tr) = 1
                only: l2_next_active(tr\first_field)
                if: only != 0 && only\value != 0 && only\value\kind = c.LM_P0_NODE_ATOM && only\value\as != 0
                    idx: l2_find_method(only\value\as\atom)
                    if: idx >= 0 && idx != l2_e
                        model: idx
                    ---
                if: only != 0 && only\value != 0 && l2_frame_head(only\value, "merge") != 0
                    merges: 1
                    mnode: only\value
                    frw: field\value\as\frame
                    frw\trailer: 0
                ---
            ---
        ---
    if: merges > 1 || (merges = 1 && model >= 0)
        return: l2_error(path, mnode, "a callable merge needs one model")
    if: merges = 1
        return: l2_t7_from_return(mi, mnode, path)
    if: model < 0
        return: l2_error(path, l2_m_node[mi], "a callable merge needs one model")
    if: l2_mad_ensure(l2_m_n) != 0
        return: l2_error(path, body, "out of memory")
    l2_mad_model[mi]: model
    l2_mad_host[model]: mi
return: 0

# `@: h f(a)` by its shape: the receiver `@:` of a call, its first field the name h it declares, its second the
# call's Frame.  Read without the method table, it answers the same in every pass: l2_head_absent asks it in
# the count and fill walks of the unit's roles.  The call's Frame, or 0.
fn: l2_receiver_frame (const: @(LmP0Node stmt); @@: LmP0Text out_name) @: LmP0Node
    @: LmP0Field f
    @: LmP0Field g
    if: out_name != 0
        \out_name: 0
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || stmt\as\frame\body = 0 || stmt\as\frame\trailer != 0
        return: 0
    if: l2_text_eq(stmt\as\frame\head, "@") = 0 || l2_count_active(stmt\as\frame\body) != 2
        return: 0
    f: l2_next_active(stmt\as\frame\body\first_field)
    g: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || l2_ident(f\value\as\atom) = 0
        return: 0
    if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_FRAME || g\value\as = 0 || g\value\as\frame = 0 || g\value\as\frame\head = 0 || g\value\as\frame\trailer != 0
        return: 0
    if: out_name != 0
        \out_name: f\value\as\atom
return: g\value

# `@: h f(a)`: the receiver `@:` takes the reference the call of method f returns (the author, 2026-10-05;
# docs/LMX_semantics.en.md#factory-reference-result).  h is the name it declares, the call is its value, a Frame
# of its own: the binding binds its actuals as any call's.  The call's Frame, or 0 when stmt is no such receiver.
fn: l2_receiver_call (const: @(LmP0Node stmt); @@: LmP0Text out_name) @: LmP0Node
    @: LmP0Node g
    g: l2_receiver_frame(stmt, out_name)
    if: g != 0 && l2_find_method(g\as\frame\head) >= 0
        return: g
    if: out_name != 0
        \out_name: 0
return: 0

# The store of a callable merge: the receiver `@:` of a call of its host (l2_receiver_call).
fn: l2_mad_store_stmt (const: @(LmP0Node stmt)) int
    const: @(LmP0Node call) l2_receiver_call(stmt, 0)
    if: call = 0
        return: 0
return: l2_mad_on(l2_find_method(call\as\frame\head))

# The host a store of a callable merge calls, or -1.
fn: l2_store_host (const: @(LmP0Node stmt)) int
    const: @(LmP0Node call) l2_receiver_call(stmt, 0)
    if: call = 0
        return: -1
return: l2_find_method(call\as\frame\head)

# The name a store of a callable merge declares, or 0.
fn: l2_store_name (const: @(LmP0Node stmt)) @: LmP0Text
    @: LmP0Text name 0
    if: l2_receiver_call(stmt, @ name) = 0
        return: 0
return: name

# The body a held callable's call gives its actuals in: the Frame's own, or none for the bare
# name, which is the call with no actuals.
fn: l2_call_node_body (const: @(LmP0Node node)) @: LmP0Structure
    if: node != 0 && node\kind = c.LM_P0_NODE_FRAME && node\as != 0 && node\as\frame != 0
        return: node\as\frame\body
return: 0

# The check of a held callable's call: its actuals as expressions, then their count against
# its header.  The node is the call's Frame, or the bare name.
fn: l2_check_held_call (const: @(LmP0Node node); int: oi; int: mi; const: @(char path)) int
    const: @(LmP0Structure body) l2_call_node_body(node)
    int: given 0
    # An empty argument body contains no expressions to check; signature
    # admission still applies at the same held-call construction route.
    if: body != 0 && l2_call_actual_fields(body) > 0 && l2_check_fields(l2_call_actuals(body), l2_call_actual_fields(body), mi, path, node) != 0
        return: 1
    # K03 S4/S6: a bare held name writes no argument; a header formal it leaves without one is said by the one binding
    # (l2_bind_call), as for `h()`.
    if: body = 0 && node != 0 && node\kind = c.LM_P0_NODE_ATOM && l2_mad_held_formals(oi) > 0 && l2_bind_call(node, 0 - 1, oi, path) != 0
        return: 1
    # The call passes what the held callable's header declares, no more and no less.
    if: l2_mad_held_arity(oi) >= 0
        if: body != 0
            given: l2_actual_count(l2_call_actuals(body))
        if: given != l2_mad_held_arity(oi)
            return: l2_error(path, node, "a held callable takes the arguments of its header")
    ---
    # The same native held-call helper is needed for every compiled body.
    l2_mad_need_held(oi)
    # K04 S3: a held call is a site of the fixed point of dynamic inputs (count -1, l2_dyn_site_held): what its
    # model needs is asked along the chain of callers, as for a call of a method.
    if: l2_mad_held_model(oi) >= 0 && l2_wait_add(4, mi, (cast: (@: void) node), 0 - 1, l2_mad_held_model(oi), node, path) != 0
        return: 1
    # HELD-FREE-NAME-OTHER-TYPE: whether a binding the call hands is converted is known once the inputs are typed.
    if: l2_mad_held_model(oi) >= 0 && l2_wait_add(8, mi, (cast: (@: void) node), oi, l2_mad_held_model(oi), node, path) != 0
        return: 1
return: 0

# HELD-FREE-NAME-OTHER-TYPE (Codex, OPUS-HANDOFF-20261005-103112 §5: "a reached present value invokes the ordinary
# converter; absent stays absent without calling it"; "Conversion/failure belongs to the executing forming caller").
# A held call in method mi hands each name its model reads from mi's binding of the name.  Where that binding can
# arrive present (l2_held_never) and is a number of another type than the model's, it is converted where the call
# stands, by the ordinary conversion of its row: the check here records the edge to the row's receiver, so that mi
# is a method that can throw `convert` before its signature is written.  Asked once the inputs are typed
# (l2_wait_run, kind 8): an input's type is its callers'.  A binding of another kind is refused where the call stands.
fn: l2_check_held_convert (const: @(LmP0Node node); int: oi; int: mi; const: @(char path)) int
    []: char bv_own 1024
    L2Tx: bv_tx
    @: L2Tx bv l2_tx_local(@ bv_tx, bv_own, 1024U)
    int: model
    int: k 0
    int: bty
    int: oty
    model: l2_mad_held_model(oi)
    if: model < 0
        return: 0
    while: k < l2_m_dyn[model]
        bty: 0 - 1
        l2_tx_clear(bv)
        if: l2_held_binding(mi, model, k, bv, @ bty) = 0 && l2_held_never(mi, model, k) = 0 && l2_held_cap_same(mi, model, k) = 0
            oty: l2_own_of_dt(l2_dt(model, k))
            if: bty != oty && (l2_rw_num_ty(bty) = 0 || l2_rw_num_ty(oty) = 0)
                return: l2_error(path, node, "a caller's binding of a held callable's free name is of another type")
            if: bty != oty && l2_check_value_convert_core(node, l2_ft_of_own(bty), l2_ft_of_own(oty), mi, path) != 0
                return: 1
        ---
        k: k + 1
    ---
return: 0

# Is this statement the declaration of a held callable: the store of a callable merge that gave
# its head its binding, which is the statement the collector reserved a row for?  A statement of
# the same shape under a head that has a binding at its site is an application of that binding
# (semantics, section 9): its row is another statement's, and it has none of its own.
fn: l2_mad_declaring (const: @(LmP0Node stmt); int: mi) int
    if: l2_mad_store_stmt(stmt) = 0
        return: 0
return: (cast: (int) (l2_own_by_decl(mi, stmt) >= 0))

# The held callable a call head names at its site, in method mi, or -1.  A formal, a slot or a
# machine local of the name is that binding and no held callable.  Otherwise the name
# selects a row as any name of the site does (l2_own_visible): the site's own row declared
# last before it, or, in a method, the field of the unit visible from the method -- declared
# above it, the last of the name.  The head names a held callable when the store of a callable
# merge declared the selected row, a field of the root and a local of a method alike; a
# selected row of another kind is that binding, and a later declaration of the name does not
# reach back to the site.  A head that selects no row names no held callable: without a site
# there is none to select at, and a method standing above every declaration of the name has no
# binding of it -- the head is an unknown head there, whatever a later statement of the unit
# declares.
fn: l2_call_head_held (int: mi; const: @(LmP0Text head)) int
    int: own
    if: mi < 0 || head = 0 || l2_formal_find(mi, head) >= 0 || l2_slot_find(mi, head) >= 0 || l2_ml_find(head) >= 0
        return: -1
    own: l2_own_visible(mi, head)
    if: own < 0 || l2_mad_store_stmt(l2_own_decl[own]) = 0
        return: -1
return: own

# The own-type code of a result code (unsigned is 33 as a result, 3 as an own).
fn: l2_ret_own (int: code) int
    if: code = 33
        return: 3
return: code

# The header a root own's held callable was declared with -- `fn: wrap (int: k) fn: (int: x) int`,
# its third field (l2_mad_sig checked it when the host was read): the Structure of its formals and
# the atom of its result. The header, not the model: a merge may bind some of the model's formals
# (T5/T7), and the header is what a call of the held node passes and gets. 0 when read; 1 when oi
# holds no such callable. A header of no formals is `()`: \formals is then a Structure of no field.
fn: l2_mad_held_header (int: oi; @@: LmP0Node formals; @@: LmP0Node result) int
    @: LmP0Field f
    @: LmP0Field g
    @: LmP0Node h
    int: host
    if: oi < 0 || formals = 0 || result = 0 || l2_mad_store_stmt(l2_own_decl[oi]) = 0
        return: 1
    host: l2_store_host(l2_own_decl[oi])
    if: host < 0 || l2_m_node[host] = 0 || l2_m_node[host]\as = 0 || l2_m_node[host]\as\frame = 0 || l2_m_node[host]\as\frame\body = 0
        return: 1
    f: l2_next_active(l2_m_node[host]\as\frame\body\first_field)
    if: f != 0
        f: l2_next_active(f\next)
    if: f != 0
        f: l2_next_active(f\next)
    if: f = 0 || l2_mad_sig(f\value) = 0
        return: 1
    h: f\value
    f: l2_next_active(h\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_STRUCTURE
        return: 1
    g: l2_next_active(f\next)
    if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_ATOM || g\value\as = 0
        return: 1
    \formals: f\value
    \result: g\value
return: 0

# The own-type code of formal k of that header, a number's; -1 when the header has no such formal
# or the formal is no number.
fn: l2_mad_held_arg_ty (int: oi; int: k) int
    @: LmP0Node formals 0
    @: LmP0Node result 0
    @: LmP0Field g
    int: code 0
    int: own
    if: k < 0 || l2_mad_held_header(oi, @ formals, @ result) != 0 || formals\as = 0 || formals\as\structure = 0
        return: -1
    g: l2_next_active(formals\as\structure\first_field)
    while: g != 0 && k > 0
        g: l2_next_active(g\next)
        k: k - 1
    ---
    if: g = 0 || g\value = 0 || g\value\kind != c.LM_P0_NODE_FRAME || g\value\as = 0 || g\value\as\frame = 0 || l2_ret_type_word(g\value\as\frame\head, 0, 0, @ code) != 0
        return: -1
    own: l2_ret_own(code)
    if: l2_rw_num_ty(own) = 0
        return: -1
return: own

# The own-type code of that header's result, a number's; -1 otherwise.
fn: l2_mad_held_ret_ty (int: oi) int
    @: LmP0Node formals 0
    @: LmP0Node result 0
    int: code 0
    int: own
    if: l2_mad_held_header(oi, @ formals, @ result) != 0 || l2_ret_type_word(result\as\atom, 0, 0, @ code) != 0
        return: -1
    own: l2_ret_own(code)
    if: l2_rw_num_ty(own) = 0
        return: -1
return: own

# The value type of that header's result, as l2_colon_ret_ty gives a method's: 0 and the type,
# or 1 when the header is not readable or its result is no number.
fn: l2_mad_held_value_ty (int: oi; @: int out_ty) int
    @: LmP0Node formals 0
    @: LmP0Node result 0
    int: code 0
    if: out_ty = 0 || l2_mad_held_header(oi, @ formals, @ result) != 0 || l2_ret_type_word(result\as\atom, 0, 0, @ code) != 0
        return: 1
    if: l2_rw_num_ty(l2_ret_own(code)) = 0
        return: 1
    \out_ty: l2_result_value_ty(code)
return: 0

# How many formals that header declares, zero included; -1 when oi holds no such callable or the
# header is not numbers to a number (item 739: each formal and the result a number).
# How many formals the header of held callable oi declares, of any type, or -1 with no header.
fn: l2_mad_held_formals (int: oi) int
    @: LmP0Node formals 0
    @: LmP0Node result 0
    if: l2_mad_held_header(oi, @ formals, @ result) != 0
        return: -1
    if: formals\as = 0 || formals\as\structure = 0
        return: 0
return: l2_count_active(formals\as\structure)

# The written name of formal k of the header of held callable oi, or 0.
fn: l2_mad_held_arg_name (int: oi; int: k) @: LmP0Text
    @: LmP0Node formals 0
    @: LmP0Node result 0
    @: LmP0Field g
    @: L2Declaration declaration
    if: k < 0 || l2_mad_held_header(oi, @ formals, @ result) != 0 || formals\as = 0 || formals\as\structure = 0
        return: 0
    g: l2_next_active(formals\as\structure\first_field)
    while: g != 0 && k > 0
        g: l2_next_active(g\next)
        k: k - 1
    ---
    if: g = 0 || g\value = 0
        return: 0
    declaration: l2_declaration(g\value)
    if: declaration = 0
        return: 0
return: declaration\name

fn: l2_mad_held_arity (int: oi) int
    @: LmP0Node formals 0
    @: LmP0Node result 0
    int: n 0
    int: k 0
    if: l2_mad_held_header(oi, @ formals, @ result) != 0 || l2_mad_held_ret_ty(oi) < 0
        return: -1
    if: formals\as != 0 && formals\as\structure != 0
        n: l2_count_active(formals\as\structure)
    while: k < n
        if: l2_mad_held_arg_ty(oi, k) < 0
            return: -1
        k: k + 1
    ---
return: n

fn: l2_hres_reset () int
    if: l2_hres_node != 0
        free((cast: (@: void) l2_hres_node))
    l2_hres_node: 0
    l2_hres_n: 0
    l2_hres_cap: 0
return: 0

# Is this value site one where the bare name of a held callable is received as its result?
fn: l2_held_result_site (const: @(LmP0Node value)) int
    int: i 0
    while: i < l2_hres_n
        if: l2_hres_node[i] = value
            return: 1
        i: i + 1
    ---
return: 0

# THE BARE NAME OF A HELD CALLABLE WHERE A RESULT IS RECEIVED (semantics, #callables: "the
# receiving contract selects a result or the reference itself ... when a result is received, a
# value-returning callable is executed").  The run of n fields from `field` is the whole value
# given to a place, and `number` says that the place's contract is a number: only such a place
# asks.  When the value is one bare name that selects a held callable at the site
# (l2_call_head_held) whose header gives a number, the place receives what the call `name()`
# gives: the call is checked by the check of that call, whatever it accepts or refuses, and
# the site is recorded.  Every later reader of the site takes its category from the record:
# the typers give the header's result, to which the place's ordinary conversion applies, and
# both emissions emit the call.  A place that receives a reference -- a pointer, a Structure,
# a callable formal -- does not ask, and the name stays the occurrence there.
# A run of several fields is an operation, whatever place its value goes to: each operand of
# it is a place of its own that receives a number (l2_held_result_operands).
# 0: recorded, or no such value.  1: refused.
fn: l2_held_result_receive (int: mi; @: LmP0Field field; int: n; int: number; const: @(char path)) int
    @: LmP0Field only
    @: LmP0Node value
    @@: LmP0Node grown
    int: oi
    int: want
    if: mi < 0 || field = 0 || n < 1
        return: 0
    if: n > 1
        return: l2_held_result_operands(mi, field, n, path)
    if: number = 0
        return: 0
    only: l2_next_active(field)
    if: only = 0 || only\value = 0 || only\value\kind != c.LM_P0_NODE_ATOM || only\value\as = 0 || only\value\as\atom = 0
        return: 0
    value: only\value
    oi: l2_call_head_held(mi, value\as\atom)
    if: oi < 0 || l2_mad_held_ret_ty(oi) < 0
        return: 0
    if: l2_check_held_call(value, oi, mi, path) != 0
        return: 1
    if: l2_held_result_site(value) != 0
        return: 0
    if: l2_hres_n >= l2_hres_cap
        want: l2_hres_cap * 2
        if: want < 16
            want: 16
        grown: (cast: (@@: LmP0Node) realloc((cast: (@: void) l2_hres_node), (cast: (size_t) want) * c.sizeof(@: LmP0Node)))
        if: grown = 0
            return: l2_error(path, value, "out of memory")
        l2_hres_node: grown
        l2_hres_cap: want
    ---
    l2_hres_node[l2_hres_n]: value
    l2_hres_n: l2_hres_n + 1
return: 0

# One operand of an operation.  The operand of a prefix sign is the operand.  A group is the
# expression its fields make, and a group of one value is that value.  Any other operand of
# several fields -- a path, an address, an indexed place -- is not a bare name.
fn: l2_held_result_span (int: mi; @: L2ValueSpan span; const: @(char path)) int
    L2ValueSpan: rest
    if: span = 0
        return: 0
    if: l2_prefix_rest(span, @ rest) = 0
        return: l2_held_result_span(mi, @ rest, path)
    if: span\count != 1 || span\node = 0
        return: 0
    if: span\node\kind = c.LM_P0_NODE_STRUCTURE && span\node\as != 0 && span\node\as\structure != 0
        return: l2_held_result_receive(mi, span\node\as\structure\first_field, l2_count_active(span\node\as\structure), 1, path)
return: l2_held_result_receive(mi, span\first, 1, 1, path)

# THE OPERANDS OF AN OPERATION (Codex, FABLE-CODEX-20261004-12: "arithmetic and numeric ordering
# operands are result-receiving places.  This is the same receiving-contract rule as the
# whole-value edge").  The run of n fields is read as the typers read it, operands and
# operators in turn; each operand of arithmetic, of a comparison, of an equality and of a
# logical operation receives a number, so the bare name of a held callable there is received as
# its result, and `name = 0` compares what the callable gives.  A run that is no operation --
# one operand of several fields, or fields with no operator between them -- has no such place.
fn: l2_held_result_operands (int: mi; @: LmP0Field field; int: n; const: @(char path)) int
    @: L2ValueSpan tok
    int: m 0
    int: i 0
    int: rc 0
    tok: l2_value_spans(field, n, @ m)
    if: tok = 0
        return: 0
    while: i < m && rc = 0
        rc: l2_held_result_span(mi, tok + i, path)
        i: i + 2
    ---
    l2_xfree((cast: (@: void) tok))
return: rc

fn: l2_mad_hdr_arity (int: mi) int
    @: LmP0Field f
    @: LmP0Node h
    if: l2_m_node[mi] = 0 || l2_m_node[mi]\as = 0 || l2_m_node[mi]\as\frame = 0 || l2_m_node[mi]\as\frame\body = 0
        return: 0
    f: l2_next_active(l2_m_node[mi]\as\frame\body\first_field)
    if: f != 0
        f: l2_next_active(f\next)
    if: f != 0
        f: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || l2_frame_head(f\value, "fn") = 0 || f\value\as\frame\body = 0
        return: 0
    h: f\value
    f: l2_next_active(h\as\frame\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_STRUCTURE || f\value\as = 0
        return: 0
return: l2_count_active(f\value\as\structure)

# The node host mi's return builds -- A3: a merge result of the model carrying, after its args part and its return
# part, one value per hidden input of the model, then the model's steps (shared by address).  A T7 host's return is
# its merge (l2_t7_write).
fn: l2_mad_emit (int: mi; const: @(char ind)) int
    int: model
    int: kids
    int: mw
    int: hw
    int: k 0
    int: slot
    int: fi
    int: oi
    int: ty
    int: site
    []: char cv_own 1024
    L2Tx: cv_tx
    @: L2Tx cv l2_tx_local(@ cv_tx, cv_own, 1024U)
    site: l2_t7_host_site(mi)
    if: site >= 0
        return: l2_t7_write(site, ind, 1)
    model: l2_mad_model[mi]
    if: model < 0 || l2_m_steps = 0 || l2_m_steps[model] <= 0 || l2_m_walkable[model] = 0
        return: l2_mad_unwalkable(mi, model)
    # Typed cells now interleave operations in the committed source body.
    # Inspect the entire body range, not the former all-values prefix.
    kids: l2_m_width(model)
    mw: l2_m_width(model)
    hw: l2_m_width(mi)
    if: l2_mad_struct_caps(model) != 0 && c.fprintf(l2_out, "%s[]: size_t l2_capf %d\n", ind, l2_mad_capf_room(model)) < 0
        return: 1
    # C, the copied lexical context (book §composition, "Returned nested methods"; Codex, 2026-09-28): the host's
    # layout -- and after its width one body field per formal of the host, which the merge appends (`node\n`,
    # l2_node_seg) -- carrying only what the model uses, each the activation's value here, at the return.  Its parent
    # is the host's `node`.
    if: c.fprintf(l2_out, "%s@: Lmx l2_madc 0\n%s@: Lmx l2_mad 0\n%s@: Lmx l2_mad_src 0\n%s@: void l2_mad_cell 0\n%ssize_t: l2_mad_k 0U\n%sl2_madc: lmx_struct_new_owned(node, l2_program_arena)\n%sif: l2_madc = 0 || lmx_arena_refs_open_owned(l2_program_arena, l2_madc, %uU) != 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: a callable merge could not be built\\n\")\n%s    c.abort()\n", ind, ind, ind, ind, ind, ind, ind, (cast: (unsigned) (hw + l2_m_arity[mi])), ind, ind) < 0
        return: 1
    while: k < l2_mcap_n
        if: l2_mcap_model[k] = model
            slot: l2_madc_slot(mi, k)
            if: slot < 0
                return: l2_error(l2_src, l2_m_node[model], "a callable merge lost a captured name")
            # Item 738: a Structure -- the copy of the fields the model reads, in its type's layout.
            if: l2_mcap_ns[k] >= 0 && l2_mad_cap_emit(mi, model, k, "l2_madc", ind, slot) != 0
                return: 1
            if: l2_mcap_ns[k] < 0
                l2_tx_clear(cv)
                fi: l2_formal_find(mi, l2_mcap_name[k])
                oi: l2_mad_host_own(mi, l2_mcap_name[k])
                if: oi >= 0 && l2_own_load(oi, cv) != 0
                    return: 1
                if: oi < 0 && fi >= 0 && l2_tok_formal(mi, fi, cv) != 0
                    return: 1
                if: oi < 0 && fi < 0
                    return: l2_error(l2_src, l2_m_node[model], "a callable merge lost a captured name")
                ty: l2_mcap_ty[k]
                if: c.fprintf(l2_out, "%sl2_mad_cell: %s(l2_program_arena)\n%sif: l2_mad_cell = 0 || %s(l2_mad_cell, %s) != 0 || lmx_arena_ref_store(l2_madc, %uU, l2_mad_cell) != 0\n%s    c.abort()\n", ind, l2_mcap_new_helper(ty), ind, l2_own_store_helper(ty), cv\data, (cast: (unsigned) slot), ind) < 0
                    return: 1
            ---
        ---
        k: k + 1
    ---
    # N, the model's occurrence copied under C: its args and return parts -- the signature -- and its steps shared by
    # address (the code and the signature stay the model's), its fields and control bodies copied as data
    # (lmx_walk_cell_copy).  The model's occurrence is a unit child, reached through the unit (l2_unit_ref).
    if: c.fprintf(l2_out, "%sl2_mad_src: lmx_arena_ref_struct(%s, %uU)\n%sif: l2_mad_src = 0\n%s    c.abort()\n%sl2_mad: lmx_struct_new_owned(l2_madc, l2_program_arena)\n%sif: l2_mad = 0 || lmx_arena_refs_open_owned(l2_program_arena, l2_mad, %uU) != 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: a callable merge could not be built\\n\")\n%s    c.abort()\n%sl2_mad_k: 0U\n%swhile: l2_mad_k < %uU\n%s    l2_mad_cell: lmx_arena_ref_value(l2_mad_src, l2_mad_k)\n%s    if: l2_mad_k >= 2U && l2_mad_k < %uU\n%s        l2_mad_cell: lmx_walk_cell_copy(l2_program_arena, l2_mad_cell)\n%s    if: lmx_arena_ref_store(l2_mad, l2_mad_k, l2_mad_cell) != 0\n%s        c.abort()\n%s    l2_mad_k: l2_mad_k + 1U\n", ind, l2_unit_ref, (cast: (unsigned) (l2_occ_slot(model))), ind, ind, ind, ind, (cast: (unsigned) mw), ind, ind, ind, ind, (cast: (unsigned) mw), ind, ind, (cast: (unsigned) kids), ind, ind, ind, ind) < 0
        return: 1
    # Retain the model's one completed native implementation; the walked
    # constructor does the same. The test knob's zero word remains zero.
    if: c.fprintf(l2_out, "%sl2_mad\\native: l2_mad_src\\native\n", ind) < 0
        return: 1
    # D-103: a host that can throw has the declared-throw ABI -- its return is the status and the
    # node goes out through l2_out_result, as any throwing method's result does.  Returned as the
    # status, the node's address met the caller as a throw number (an unknown walk status).
    if: (l2_m_throws = 0 || l2_m_throws[mi] = 0) && c.fprintf(l2_out, "%sreturn: (cast: (@: void) l2_mad)\n", ind) < 0
        return: 1
    if: l2_m_throws != 0 && l2_m_throws[mi] != 0 && c.fprintf(l2_out, "%sl2_out_result[0]: (cast: (@: void) l2_mad)\n%sreturn: 0\n", ind, ind) < 0
        return: 1
return: 0

# The slot of capture k of the model of host mi (a name of the host's body, l2_mcap_*) in the copied lexical context
# C of the node the host's return builds: a host own field at its slot, a host formal after the host's width -- the
# layout `node\name` reads (l2_node_seg).  -1 when it is neither.
fn: l2_madc_slot (int: mi; int: k) int
    int: oi
    int: fi
    oi: l2_mad_host_own(mi, l2_mcap_name[k])
    if: oi >= 0
        return: l2_graph_field_child(oi)
    fi: l2_formal_find(mi, l2_mcap_name[k])
    if: fi >= 0
        return: l2_m_width(mi) + fi
return: 0 - 1

# A callable merge in host `host` whose model is not walked: the model's own first refusal, where it
# stands, when its quiet walk kept one (l2_rw_methods_count) -- the model is tried silently, and without
# this its reason (a path past a captured field, an operation the walk does not build) stopped at the
# host's header; the host's header otherwise.
fn: l2_mad_unwalkable (int: host; int: model) int
    @: char why 0
    @: char msg 0
    size_t: n
    int: r
    if: model >= 0 && model < l2_m_n && l2_m_why != 0
        why: l2_m_why[model]
    if: why = 0 || why[0] = 0
        return: l2_error(l2_src, l2_m_node[host], "a callable merge needs a walkable body")
    if: l2_rw_quiet = 0 && l2_src != 0 && l2_m_why_line != 0 && l2_m_why_col != 0 && l2_m_why_line[model] != 0U
        c.fprintf(l1_stderr(), "l2trans error: %s:%zu:%zu: a callable merge needs a walkable body: %s\n", l2_src, l2_m_why_line[model], l2_m_why_col[model], why)
        l2_diag_n: l2_diag_n + 1
        return: 1
    n: strlen(why) + 48U
    msg: (cast: (@: char) malloc(n))
    if: msg = 0
        return: l2_error(l2_src, l2_m_node[host], "a callable merge needs a walkable body")
    c.snprintf(msg, n, "a callable merge needs a walkable body: %s", why)
    r: l2_error(l2_src, l2_m_node[host], msg)
    free((cast: (@: void) msg))
return: r

# Whether idx, called in host mi's body, is a nested method of it that captures host names -- its model or
# another: A3, an ordinary (M, M) call with the host's current values as hidden inputs, through lmx_call_prim
# natively (the method is walked, l2_emit_call) and a CALL in the walk (l2_rw_call).  A PAP host's (T7) model is
# not called so.
fn: l2_mad_nested_call (int: mi; int: idx) int
    if: l2_mad_on(mi) = 0 || idx < 0 || idx >= l2_m_n || l2_mcap_count(idx) <= 0
        return: 0
    if: l2_mad_model[mi] != idx && l2_mad_host_of(idx) != mi
        return: 0
    if: l2_t7_host_site(mi) >= 0
        return: 0
return: 1

# The declared inputs of the node host mi's return builds: the host's declared header (a header of width 0 is that
# header -- do not borrow the model's width).
fn: l2_mad_node_arity (int: mi) int
    int: arity
    arity: l2_mad_hdr_arity(mi)
    if: arity < 1 && l2_m_ret[mi] != 16
        arity: l2_m_arity[l2_mad_model[mi]]
return: arity

# Item 739: the variant of l2_mad_call for a held call whose header result is rty (own-type code):
# int keeps l2_mad_call; each other number has its own, which hands back a cell of that type.
# A held numeric result uses the destination's declared width, supplied by
# either the native caller's local or the walked PRIM return contract.
fn: l2_emit_mad_call () int
    if: l2_mad_need_call = 0
        return: 0
    if: l2_emit_mad_inputs() != 0
        return: 1
    if: c.fprintf(l2_out, "fn: l2_mad_call (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int\n    @: Lmx l2_code 0\n    []: @(void) l2_all %d\n    size_t: l2_n 0U\n    if: nargs < 1U || refs = 0 || refs[0] = 0 || dest = 0 || out = 0\n        c.fprintf(c.stderr, \"lmx: invariant: a callable merge was called outside its header\\n\")\n        c.abort()\n    l2_code: (cast: (@: Lmx) lmx_pointer_value_known(refs[0]))\n    if: l2_mad_inputs(l2_code, refs + 1, 0U, refs + 1, nargs - 1U, l2_all, %dU, @ l2_n) != 0\n        c.fprintf(c.stderr, \"lmx: invariant: a callable merge was called outside its header\\n\")\n        c.abort()\n    if: lmx_call_prim((cast: (@: LmxArena) owner), l2_code, l2_code, l2_all, l2_n, dest, out) != 0\n        c.fprintf(c.stderr, \"lmx: invariant: a callable merge call failed\\n\")\n        c.abort()\n    if: lmx_msg_poll_escape() != 0\n        \\out: 0\n        return: 0\n    \\out: dest\n    return: 0\nend: l2_mad_call\n\n", l2_mad_max_inputs(), l2_mad_max_inputs()) < 0
        return: 1
return: 0

# A3: the widest input list of a node a host's return builds -- its declared inputs and its hidden ones.
fn: l2_mad_max_inputs () int
    int: i 0
    int: w 1
    while: i < l2_m_n
        if: l2_mad_on(i) != 0 && l2_mad_model[i] >= 0 && l2_mad_node_arity(i) + l2_m_dyn[l2_mad_model[i]] > w
            w: l2_mad_node_arity(i) + l2_m_dyn[l2_mad_model[i]]
        i: i + 1
    ---
return: w

# The inputs of a call of node `code` a host's return built: the n declared ones the caller passes, then, per hidden
# input of the model, the caller's own binding of its name, or nothing (0) -- Reading 1 (book, "Dynamic sources
# and the lexical fallback"; Codex, 2026-09-28): the caller's binding first; where it has none, the model reads the
# node's copied lexical context through `node` (ARG's fallback).  The args part says how many there are.  0 and
# *count, or 1.
fn: l2_emit_mad_inputs () int
    if: fputs("fn: l2_mad_inputs (@: Lmx code; @@: void args; size_t: n; @@: void sup; size_t: ns; @@: void all; size_t: cap; @: size_t count) int\n    @: Lmx part 0\n    size_t: k 0U\n    size_t: w 0U\n    \\count: 0U\n    part: lmx_arena_ref_struct(code, 0U)\n    if: part = 0\n        return: 1\n    w: part\\array.size\n    if: w < n || w > cap || ns > w - n\n        return: 1\n    while: k < w\n        all[k]: 0\n        if: k < n\n            all[k]: args[k]\n        if: k >= n && k - n < ns\n            all[k]: sup[k - n]\n        k: k + 1U\n    ---\n    \\count: w\n    return: 0\nend: l2_mad_inputs\n\n", l2_out) < 0
        return: 1
return: 0

# Mark the single held-call adapter before native method prototypes are emitted.
fn: l2_mad_need_held (int: oi) int
    if: l2_mad_held_arity(oi) < 0
        return: 0
    l2_mad_need_call: 1
return: 0

fn: l2_emit_mad_call_protos () int
    if: l2_mad_need_call != 0 && fputs("    fn: l2_mad_call (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int\n", l2_out) < 0
        return: 1
return: 0

# The model of the node the held callable own oi holds -- its host's, the method its store statement calls -- or -1.
fn: l2_mad_held_model (int: oi) int
    int: host
    if: oi < 0 || l2_mad_store_stmt(l2_own_decl[oi]) = 0
        return: 0 - 1
    host: l2_store_host(l2_own_decl[oi])
    if: host < 0 || l2_mad_on(host) = 0
        return: 0 - 1
return: l2_mad_model[host]

# Whether what method mi gives under the name of hidden input k of `model` is a capture of the model's host given
# as a Structure of the capture's own type: it is admitted as itself then (l2_cap_emit_admit, l2_rw_admit_as).
# Anything else the method gives -- a Structure of another declaration, an input it only hands on, whose
# declaration is its giver's -- is a candidate for the ordinary admission to the input's schema.
fn: l2_held_cap_same (int: mi; int: model; int: k) int
    int: ns
    int: oi
    @: LmP0Text nm
    if: mi < 0 || model < 0 || k < 0 || k >= l2_m_dyn[model]
        return: 0
    ns: l2_cap_arg_ns(model, l2_m_arity[model] + k)
    nm: l2_dn(model, k)
    if: ns < 0 || nm = 0
        return: 0
    if: mi != l2_e && l2_param_find(mi, nm) >= 0
        return: (cast: (int) (l2_bound_nsty(mi, nm) = ns))
    oi: l2_own_visible(mi, nm)
return: (cast: (int) (oi >= 0 && l2_own_nsty_get(oi) = ns))

# The value a number cell of own type ty holds, read through the pointer text p, into dest: what a hidden input's
# entry carries (l2_emit_tramp_lex reads the same cells).
fn: l2_num_read_text (int: ty; const: @(char p); @: L2Tx dest) int
    const: @(char f) "lmx_int_value_known("
    const: @(char e) ")"
    if: ty = 1
        f: "(cast: (char) lmx_char_value_known("
        e: "))"
    if: ty = 2
        f: "lmx_size_value_known("
    if: ty = 3
        f: "lmx_unsigned_value_known("
    if: ty = 36
        f: "lmx_ulong_value_known("
return: l2_tx_join(dest, f, p, e, 0, 0)

# The receiver of the conversion row from own type bty to oty, called on a value method mi already holds -- value,
# an expression of type bty its caller evaluated once -- its result's token into dest.  A refusal of the receiver is
# mi's implicit throw `convert`, as at every conversion edge (l2_emit_call, edge 1).
fn: l2_emit_convert_raw (int: mi; int: bty; int: oty; const: @(char value); const: @(LmP0Node node); const: @(char ind); @: L2Tx dest) int
    int: idx
    int: self_t
    int: t
    int: rc
    []: char act_own 1024
    L2Tx: act_tx
    if: l2_convert_hit(l2_own_ty_word(bty), l2_own_ty_word(oty)) = 0
        return: l2_error(l2_src, node, "internal: a conversion site was not checked")
    idx: l2_convert_method()
    if: idx < 0 || l2_m_arity[idx] != 1 || l2_m_dyn[idx] != 0
        return: l2_error(l2_src, node, "internal: a conversion site was not checked")
    self_t: l2_tn
    l2_tn: l2_tn + 1
    if: c.fprintf(l2_out, "%s@: Lmx l2_c%d lmx_arena_ref_struct(%s, %uU)\n", ind, self_t, l2_unit_ref, (cast: (unsigned) (l2_occ_slot(idx)))) < 0
        return: 1
    if: l2_tx_open(@ act_tx, act_own, 1024U) != 0 || l2_tx_set(@ act_tx, value) != 0
        return: l2_alloc_or(l2_src, node, "out of memory")
    t: l2_tn
    l2_tn: l2_tn + 1
    rc: l2_emit_call_result(idx, t, ind)
    if: rc = 0
        rc: l2_emit_call_go(mi, idx, idx, t, self_t, ind, 1, 0, @ act_tx, 0)
    if: rc != 0
        return: 1
    if: l2_m_throws[idx] != 0
        if: c.fprintf(l2_out, "%sif: l2_ts%d != 0\n", ind, t) < 0 || l2_emit_implicit_throw(mi, "convert", ind) != 0
            return: 1
        ---
return: l2_tx_temp(dest, t)

# HELD-FREE-NAME-OTHER-TYPE: method mi's binding bv of a name a held call hands -- a value of own type bty, or an
# entry mi only hands on (REF:), which may be absent -- converted to the model's type oty (l2_check_held_convert made
# the edge).  The value is evaluated once; the receiver's result goes into a cell of oty in this activation; an
# absent entry stays absent and calls nothing.  bv becomes that cell's entry.
fn: l2_held_convert_emit (int: mi; int: bty; int: oty; const: @(LmP0Node node); const: @(char ind); @: L2Tx bv) int
    int: t
    @: char deep 0
    []: char val_own 256
    L2Tx: val_tx
    @: L2Tx val l2_tx_local(@ val_tx, val_own, 256U)
    []: char res_own 64
    L2Tx: res_tx
    @: L2Tx res @ res_tx
    []: char nm 32
    t: l2_tn
    l2_tn: l2_tn + 1
    if: bv = 0 || val = 0 || l2_tx_open(res, res_own, 64U) != 0 || c.fprintf(l2_out, "%s%s: l2_hcv%d\n", ind, l2_own_ty_word(oty), t) < 0
        return: 1
    if: c.strncmp(bv\data, "REF:", 4U) = 0
        if: c.fprintf(l2_out, "%s@: void l2_hcr%d %s\n%sif: l2_hcr%d != 0\n", ind, t, bv\data + 4, ind, t) < 0
            return: 1
        if: l2_bump_ind(ind, @ deep) != 0
            return: 1
        if: c.snprintf(nm, 32U, "l2_hcr%d", t) < 0 || l2_num_read_text(bty, nm, val) != 0
            return: 1
        if: l2_emit_convert_raw(mi, bty, oty, val\data, node, deep, res) != 0
            return: 1
        if: c.fprintf(l2_out, "%sl2_hcv%d: %s\n%sl2_hcr%d: (cast: (@: void) (@ l2_hcv%d))\n%s---\n", deep, t, res\data, deep, t, t, ind) < 0
            return: 1
        ---
    else:
        if: l2_emit_convert_raw(mi, bty, oty, bv\data, node, ind, res) != 0
            return: 1
        if: c.fprintf(l2_out, "%sl2_hcv%d: %s\n%s@: void l2_hcr%d (cast: (@: void) (@ l2_hcv%d))\n", ind, t, res\data, ind, t, t) < 0
            return: 1
        ---
    if: c.snprintf(nm, 32U, "REF:l2_hcr%d", t) < 0
        return: 1
return: l2_tx_set(bv, nm)

# Reading 1 (book, "Dynamic sources and the lexical fallback"; Codex, 2026-09-28): native caller mi's own binding of
# hidden input k of model -- its input of that name, or its own field of that name it uses -- as its code reads it
# here, into dest, its type in *ty (own-type code).  0, or 1 when it has none: the model then reads the node's copied
# lexical context (its ARG's fallback).
fn: l2_held_binding (int: mi; int: model; int: k; @: L2Tx dest; @: int ty) int
    @: LmP0Text nm
    int: pi
    int: oi
    []: char ref 48
    nm: l2_dn(model, k)
    if: nm = 0
        return: 1
    pi: l2_param_find(mi, nm)
    if: pi >= 0
        \ty: l2_own_ty_of_param(l2_input_ft(mi, pi))
        # K04 S2: an input this caller only forwards goes to the held callable as its entry, possibly absent:
        # the callable's ARG reads its own fallback then.
        if: pi >= l2_m_arity[mi] && l2_dyn_fwd(mi, pi - l2_m_arity[mi]) != 0 && l2_formal_row(mi, pi) < 0
            if: c.snprintf(ref, 48U, "REF:l2_pr%d_%d", mi, pi) < 0
                return: 1
            return: l2_tx_set(dest, ref)
        return: l2_tok_formal(mi, pi, dest)
    ---
    oi: l2_own_visible(mi, nm)
    if: oi >= 0 && l2_m_uses[l2_own_off(mi, oi)] != 0
        \ty: l2_own_ty[oi]
        return: l2_own_load(oi, dest)
    ---
return: 1

# HELD-FREE-NAME-OTHER-TYPE in the walk: the binding of type bty -- input pi of the running caller (ARG, or the own
# field oi it is bound to), or its own field oi -- converted to oty where a held call hands it, under parent into
# *out: GUARD [guard, the binding, CALL receiver [GUARDED]].  The binding is evaluated once; an absent one leaves the
# operand absent and calls nothing; a present one is the receiver's result, its refusal the caller's implicit
# `convert` (the edge's catch rows, as at every conversion edge: l2_rw_call with l2_rw_conv).
fn: l2_rw_held_convert (const: @(LmP0Node node); int: bty; int: oty; int: pi; int: oi; int: parent; @: int out) int
    LmP0Field: one
    int: cidx
    int: src
    int: call
    if: l2_rw_num_ty(bty) = 0 || l2_rw_num_ty(oty) = 0
        return: l2_rw_refuse(node, "a caller's binding of a held callable's free name is of another type")
    if: l2_convert_hit(l2_own_ty_word(bty), l2_own_ty_word(oty)) = 0
        return: l2_error(l2_src, node, "internal: a conversion site was not checked")
    cidx: l2_convert_method()
    if: cidx < 0
        return: l2_error(l2_src, node, "internal: a conversion site was not checked")
    if: l2_rw_frame(parent, "LMX_WALK_OP_GUARD", 3, out) != 0
        return: 1
    if: oi >= 0 && l2_rw_own(\out, oi, @ src) != 0
        return: 1
    if: oi < 0 && l2_rw_arg(\out, pi, @ src) != 0
        return: 1
    if: l2_rw_put(\out, 1, src) != 0
        return: 1
    memset((cast: (@: void) (@ one)), 0, c.sizeof(c.LmP0Field))
    one.value: (cast: (@: LmP0Node) node)
    l2_rw_conv: 1
    l2_rw_conv_guarded: 1
    if: l2_rw_call(node, cidx, -1, @ one, \out, @ call) != 0
        l2_rw_conv: 0
        l2_rw_conv_guarded: 0
        return: 1
    ---
return: l2_rw_put(\out, 2, call)

# The same in the walk, as an operand under parent into *out: the caller's input (ARG, or the field it is bound to), its
# own field (the root's are its declared fields); 1 with nothing built when it has none, or refused (a type the input
# does not have).
fn: l2_rw_held_binding (const: @(LmP0Node node); int: model; int: k; int: parent; @: int out) int
    @: LmP0Text nm
    int: oi
    int: pi
    int: ns
    int: oty
    int: same
    nm: l2_dn(model, k)
    ns: l2_cap_arg_ns(model, l2_m_arity[model] + k)
    oty: l2_own_of_dt(l2_dt(model, k))
    if: nm = 0
        return: 1
    pi: 0 - 1
    if: l2_rw_mi != l2_e
        pi: l2_param_find(l2_rw_mi, nm)
    # A capture given as a Structure of the capture's own type is the Structure itself.  Anything else must
    # travel as the model's input does: a value of another transport is not converted here, a limit said where
    # it stands.
    same: l2_held_cap_same(l2_rw_mi, model, k)
    if: pi >= 0
        if: same = 0 && l2_own_ty_of_param(l2_input_ft(l2_rw_mi, pi)) != oty
            return: l2_rw_held_convert(node, l2_own_ty_of_param(l2_input_ft(l2_rw_mi, pi)), oty, pi, l2_rw_bound(nm), parent, out)
        oi: l2_rw_bound(nm)
        if: oi >= 0
            return: l2_rw_own(parent, oi, out)
        return: l2_rw_arg(parent, pi, out)
    ---
    oi: l2_own_visible(l2_rw_mi, nm)
    if: oi < 0 || (l2_rw_mi != l2_e && l2_m_uses[l2_own_off(l2_rw_mi, oi)] = 0) || l2_own_uchild[oi] < 0
        return: 1
    if: same != 0
        return: l2_rw_mad_host_struct(parent, l2_rw_mi, nm, out)
    if: l2_own_ty[oi] != oty
        return: l2_rw_held_convert(node, l2_own_ty[oi], oty, -1, oi, parent, out)
    # A reference of another declaration than the one the model's lexical source names is another value: it is
    # admitted to the model's use by the ordinary admission, where the model's input has a schema to admit to
    # (l2_rw_mad_call).  A held callable under the name has none: its admission is not built, a limit of this
    # implementation and no rule, said where it stands.
    if: l2_rw_num_ty(oty) = 0 && l2_own_visible(model, nm) != oi && l2_input_schema(model, l2_m_arity[model] + k) = -1
        return: l2_rw_refuse(node, "a caller's own reference under a held callable's free name is not admitted to its use yet")
return: l2_rw_own(parent, oi, out)

# Whether hidden input j of callable mi is a free input admitted at the boundary that forms it: a name no declaration in
# mi's sight spells (l2_input_undeclared) whose paths read the coordinate space the declarations reaching it give
# (l2_input_schema, l2_anchor_close); a capture keeps its own admission.
fn: l2_free_admit (int: mi; int: j) int
    int: key
    if: mi < 0 || mi >= l2_m_n || mi = l2_e || j < 0 || j >= l2_m_dyn[mi]
        return: 0
    key: l2_m_arity[mi] + j
return: (cast: (int) (l2_input_undeclared(mi, key) != 0 && l2_cap_arg_ns(mi, key) < 0 && l2_input_schema(mi, key) != -1))

fn: l2_free_admits (int: mi) int
    int: j 0
    if: mi < 0 || mi >= l2_m_n
        return: 0
    while: j < l2_m_dyn[mi]
        if: l2_free_admit(mi, j) != 0
            return: 1
        j: j + 1
    ---
return: 0

# The admission of free input j of `callee` as method mi forms it (l2_admit_entry), its requirement read in the space
# of the selected occurrence `occ` (l2_recv_ref): the model instances it names are rendered through that reference,
# the candidate, its sources and everything else in mi's own emission.  The reference is this admission's alone.
fn: l2_admit_received (int: mi; int: callee; int: j; const: @(char occ); const: @(char value); const: @(char ind)) int
    []: char recv_local 128
    L2Tx: recv_text
    @: L2Tx recv l2_tx_local(@ recv_text, recv_local, 128U)
    int: st
    const: @(char saved) l2_recv_unit
    if: recv = 0 || l2_recv_ref(callee, occ, recv) != 0
        return: 1
    l2_recv_unit: recv\data
    st: l2_admit_entry(mi, callee, j, 0 - 1, value, ind)
    l2_recv_unit: saved
return: st

# The admission of hidden input k of the selected callable `callee`, as the body of method mi hands it: `value`
# as it was formed (l2_hidden_from, l2_held_binding).  An input handed absent has no value to admit.  An entry
# handed on as it is (REF:) is admitted as the value it carries, where it carries one: an absent entry goes on
# absent.  ns is the type of a capture of the callee's host (l2_cap_emit_admit), or -1: the callee's own input
# schema then (l2_hidden_emit_admit).
fn: l2_admit_entry (int: mi; int: callee; int: k; int: ns; const: @(char value); const: @(char ind)) int
    @: char deep 0
    []: char pay 1100
    if: value = 0 || ind = 0
        return: 1
    if: c.strcmp(value, "ABSENT") = 0
        return: 0
    if: c.strncmp(value, "REF:", 4U) != 0
        if: ns >= 0
            return: l2_cap_emit_admit(ns, value, ind)
        return: l2_hidden_emit_admit(mi, callee, k, value, ind)
    ---
    if: ns < 0 && l2_input_schema(callee, l2_m_arity[callee] + k) = -1
        return: 0
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    if: c.snprintf(pay, 1100U, "lmx_pointer_value_known(%s)", value + 4) < 0 || c.fprintf(l2_out, "%sif: %s != 0\n", ind, value + 4) < 0
        return: 1
    if: ns >= 0 && l2_cap_emit_admit(ns, pay, deep) != 0
        return: 1
    if: ns < 0 && l2_hidden_emit_admit(mi, callee, k, pay, deep) != 0
        return: 1
return: (cast: (int) (c.fprintf(l2_out, "%s---\n", ind) < 0))

# steps/merge-callable-r48.md S1: the held callable of own oi called from a native method as the walk's PRIM calls it
# (l2_rw_mad_call), using declared-width argument and result storage. The numeric
# result remains in this caller's local after the nested activation returns.
fn: l2_prep_held_call (const: @(LmP0Node node); int: oi; int: mi; const: @(char ind); @: L2Tx dest) int
    int: n
    int: rty
    int: j 0
    int: given 0
    int: t
    int: span
    int: model
    int: nh 0
    int: k
    int: bty
    int: ns
    int: oty
    int: same
    int: bound 0 - 1
    int: written 0
    @: LmP0Field f 0
    []: char hv_own 1024
    L2Tx: hv_tx
    @: L2Tx hv l2_tx_local(@ hv_tx, hv_own, 1024U)
    []: char av_own 1024
    L2Tx: av_tx
    @: L2Tx av @ av_tx
    []: char bv_own 1024
    L2Tx: bv_tx
    @: L2Tx bv l2_tx_local(@ bv_tx, bv_own, 1024U)
    []: char ref_dest 128
    []: char nm 32
    const: @(LmP0Structure body) l2_call_node_body(node)
    n: l2_mad_held_arity(oi)
    rty: l2_mad_held_ret_ty(oi)
    if: n < 0 || rty < 0
        return: l2_error(l2_src, node, "a held callable whose header is not numbers to a number")
    if: body != 0
        given: l2_actual_count(l2_call_actuals(body))
        bound: l2_bound_find(body)
    ---
    if: given != n
        return: l2_error(l2_src, node, "a held callable takes the arguments of its header")
    # In a method the held callable's name is a hidden input (Q52): its value is the parameter.
    if: l2_param_find(mi, l2_own_name[oi]) >= 0
        if: l2_tok_formal(mi, l2_param_find(mi, l2_own_name[oi]), hv) != 0
            return: l2_error(l2_src, node, "internal: a held callable's node could not be read")
        ---
    else:
        if: l2_own_load(oi, hv) != 0
            return: l2_error(l2_src, node, "internal: a held callable's node could not be read")
    ---
    l2_mad_need_held(oi)
    model: l2_mad_held_model(oi)
    if: model >= 0
        nh: l2_m_dyn[model]
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.fprintf(l2_out, "%s[]: @(void) l2_hr%d %d\n%s@: void l2_hcode%d (cast: (@: void) %s)\n%sl2_hr%d[0]: (cast: (@: void) (@ l2_hcode%d))\n%s@: void l2_ho%d 0\n", ind, t, 1 + n + nh, ind, t, hv\data, ind, t, t, ind, t) < 0
        return: 1
    # The declared arguments, each evaluated once in the order they are written, each a value of
    # its formal's type, each into its formal's place: a call bound with named actuals keeps its
    # written order in its record (l2_bound_formal).
    while: written < n
        j: l2_bound_formal(bound, written)
        f: 0
        if: j >= 0 && j < n
            f: l2_actual_field(l2_call_actuals(body), j)
        if: f = 0
            return: l2_error(l2_src, node, "a held callable takes the arguments of its header")
        span: l2_expr_span(f)
        if: span < 1
            return: l2_error(l2_src, node, "a held callable takes the arguments of its header")
        if: l2_tx_open(av, av_own, 1024U) != 0 || l2_eval_fields(f, span, mi, ind, av) != 0
            return: 1
        c.sprintf(ref_dest, "l2_hr%d[%d]", t, 1 + j)
        if: l2_emit_call_ref(l2_ft_of_own(l2_mad_held_arg_ty(oi, j)), av\data, ind, ref_dest) != 0
            return: 1
        written: written + 1
    ---
    # Reading 1: per hidden input of the model, this caller's own binding of its name, or nothing.
    k: 0
    while: k < nh
        l2_tx_clear(bv)
        bty: 0 - 1
        if: l2_held_binding(mi, model, k, bv, @ bty) != 0
            if: l2_held_unbound(node, mi, model, k) != 0
                return: 1
            if: c.fprintf(l2_out, "%sl2_hr%d[%d]: 0\n", ind, t, 1 + n + k) < 0
                return: 1
            k: k + 1
            continue
        ---
        ns: l2_cap_arg_ns(model, l2_m_arity[model] + k)
        oty: l2_own_of_dt(l2_dt(model, k))
        # K04 S3: the caller only hands the name on, as another type, and it can never arrive: nothing to give.
        if: l2_held_never(mi, model, k) != 0
            if: l2_held_unbound(node, mi, model, k) != 0
                return: 1
            if: c.fprintf(l2_out, "%sl2_hr%d[%d]: 0\n", ind, t, 1 + n + k) < 0
                return: 1
            k: k + 1
            continue
        ---
        # A capture given as a Structure of the capture's own type is admitted as itself.  A number of another
        # type is converted here, its absence kept (HELD-FREE-NAME-OTHER-TYPE, l2_held_convert_emit); a binding of
        # another kind was refused where the call stands (l2_check_held_convert).
        same: l2_held_cap_same(mi, model, k)
        if: same = 0 && bty != oty && (l2_rw_num_ty(bty) = 0 || l2_rw_num_ty(oty) = 0)
            return: l2_error(l2_src, node, "a caller's binding of a held callable's free name is of another type")
        if: same = 0 && bty != oty && l2_held_convert_emit(mi, bty, oty, node, ind, bv) != 0
            return: 1
        if: same != 0 && l2_cap_src_marked(mi, l2_dn(model, k)) = 0 && l2_admit_entry(mi, model, k, ns, bv\data, ind) != 0
            return: 1
        # Any other reference the method gives -- a Structure of another declaration, an input it only hands
        # on -- is admitted to the model's use as a call of a method admits a hidden input, a present entry as
        # the value it carries.
        if: same = 0 && l2_admit_entry(mi, model, k, 0 - 1, bv\data, ind) != 0
            return: 1
        c.sprintf(ref_dest, "l2_hr%d[%d]", t, 1 + n + k)
        if: l2_emit_hidden_ref(l2_input_ft(model, l2_m_arity[model] + k), bv\data, ind, ref_dest) != 0
            return: 1
        k: k + 1
    ---
    # §7b: the held callable runs after its arguments are evaluated -- what is marked is published before it.
    if: l2_emit_publish(ind) != 0
        return: 1
    if: c.fprintf(l2_out, "%s%s: l2_hd%d 0\n%sif: l2_mad_call(l2_program_arena, l2_hr%d, %dU, (cast: (@: void) (@ l2_hd%d)), @ l2_ho%d) != 0\n%s    c.abort()\n", ind, l2_own_ty_word(rty), t, ind, t, 1 + n + nh, t, t, ind) < 0
        return: 1
    if: c.snprintf(nm, 32U, "l2_hd%d", t) < 0 || l2_tx_set(dest, nm) != 0
        return: 1
return: l2_emit_poll(mi, ind)

# Item 738: the node slot of the named Structure ns's own node, as the unit holds it -- an eternal
# one among the occurrences' tail, any other among the named Structures.
fn: l2_ns_unit_slot (int: ns) int
    int: slot
    if: ns < 0
        return: 0 - 1
    if: l2_ns_eternal[ns] >= 0
        return: l2_ebr_unit_slot(l2_ns_eternal[ns])
    slot: -1
    if: l2_ns_synthesized(ns) = 0
        slot: l2_source_unit_slot(l2_ns_at[ns])
    if: slot >= 0
        return: slot
return: l2_ns_base + l2_ns_tail_rank(ns)

# Qualified declarations and ordinary occurrences share the same unit-place
# boundary. Consumers never reconstruct a physical slot from a table ordinal.
fn: l2_ebr_unit_slot (int: branch) int
    int: slot l2_source_unit_slot(l2_ebr_at[branch])
    if: slot >= 0
        return: slot
return: l2_unit_base + l2_occ_tail_rank(l2_m_n) + l2_ebr_tail_rank(branch)

# Item 738: in the walked constructor, capture j of model -- refs[ri], the Structure the host's name
# holds -- copied field by field into the node's copied context at `slot`.  The type's node is the unit's child
# (the program's unit: the model's occurrence hangs under its host, book §3).
fn: l2_mad_cap_emit_walk (int: model; int: j; int: ri; int: slot) int
    []: int fl_own 32
    @: int fl 0
    int: n
    int: k 0
    int: room l2_ns_width(l2_mcap_ns[j])
    size_t: isz
    isz: c.sizeof(c.int)
    if: room < 1
        room: 1
    # As many places as the captured Structure has fields: it copies no more (FIXED-BLOCKS-AUDIT).
    fl: (cast: (@: int) l2_text_room((cast: (size_t) room) * isz, (cast: (@: char) fl_own), 32U * isz))
    if: fl = 0
        return: l2_alloc_or(l2_src, 0, "out of memory")
    n: l2_cap_fields(model, l2_mcap_name[j], l2_mcap_ns[j], fl, room)
    if: n < 0
        return: 1
    while: k < n
        if: c.fprintf(l2_out, "    l2_capf[%dU]: %dU\n", k, fl[k]) < 0
            return: 1
        k: k + 1
    ---
    if: c.fprintf(l2_out, "    l2_mad_cell: (cast: (@: void) lmx_walk_capture((cast: (@: LmxArena) owner), l2_madc, (cast: (@: Lmx) lmx_pointer_value_known(refs[%uU])), lmx_arena_ref_struct(l2_program_unit, %uU), l2_capf, %dU, (cast: (@: void) (l2_layout_tokens + %d))))\n    if: l2_mad_cell = 0 || lmx_arena_ref_store(l2_madc, %uU, l2_mad_cell) != 0\n        c.fprintf(c.stderr, \"lmx: invariant: a Structure capture could not be copied\\n\")\n        c.abort()\n", (cast: (unsigned) ri), (cast: (unsigned) l2_ns_unit_slot(l2_mcap_ns[j])), n, l2_mcap_ns[j], (cast: (unsigned) slot)) < 0
        return: 1
return: 0

# Item 738: in the native host mi, capture j of model -- the Structure the host's formal or own field
# holds -- copied field by field into Structure `tgt` (the node's copied context) at `slot`.  The abort on
# lmx_walk_capture's 0 is a guard (and out of memory): l2_cap_add names value fields only, and those the kernel
# copies.
fn: l2_mad_cap_emit (int: mi; int: model; int: j; const: @(char tgt); const: @(char ind); int: slot) int
    []: int fl_own 32
    @: int fl 0
    []: char src_own 128
    L2Tx: src_tx
    @: L2Tx src l2_tx_local(@ src_tx, src_own, 128U)
    int: n
    int: k 0
    int: fi
    int: oi
    int: room l2_ns_width(l2_mcap_ns[j])
    size_t: isz
    isz: c.sizeof(c.int)
    if: room < 1
        room: 1
    # As many places as the captured Structure has fields: it copies no more (FIXED-BLOCKS-AUDIT).
    fl: (cast: (@: int) l2_text_room((cast: (size_t) room) * isz, (cast: (@: char) fl_own), 32U * isz))
    if: fl = 0
        return: l2_alloc_or(l2_src, 0, "out of memory")
    n: l2_cap_fields(model, l2_mcap_name[j], l2_mcap_ns[j], fl, room)
    if: n < 0
        return: 1
    l2_tx_clear(src)
    # §7b: the host composes the values it uses -- an own field with a working value is that value, the reference the
    # activation holds, not the slot's last publication.
    if: l2_cap_host_src(mi, l2_mcap_name[j], ind, src) != 0
        return: 1
    while: k < n
        if: c.fprintf(l2_out, "%sl2_capf[%dU]: %dU\n", ind, k, fl[k]) < 0
            return: 1
        k: k + 1
    ---
    # §7b: a capture copies graph state -- what is marked is published before it.
    if: l2_emit_publish(ind) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_mad_cell: (cast: (@: void) lmx_walk_capture(l2_program_arena, %s, (cast: (@: Lmx) %s), lmx_arena_ref_struct(%s, %uU), l2_capf, %dU, (cast: (@: void) (l2_layout_tokens + %d))))\n%sif: l2_mad_cell = 0 || lmx_arena_ref_store(%s, %uU, l2_mad_cell) != 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: a Structure capture could not be copied\\n\")\n%s    c.abort()\n", ind, tgt, src\data, l2_unit_ref, (cast: (unsigned) l2_ns_unit_slot(l2_mcap_ns[j])), n, l2_mcap_ns[j], ind, tgt, (cast: (unsigned) slot), ind, ind) < 0
        return: 1
return: 0

# §6: l2_mad_construct_<mi>'s body is l2_mad_emit's own Structure-building code (the copied lexical context C with
# the values of the host's body the model uses, the model's occurrence copied under it), moved from a
# native trampoline's inline text to a standalone LmxPrimitiveEntry function: model/arity/steps/
# caps/base are baked in here as literal constants (computed once, same helpers l2_mad_emit
# itself calls), never read from refs[]. refs[0] is the model's own occurrence Structure
# (l2_rw_mad_ret's operand 0); refs[1..nc] are the host's values the model uses, read by the same
# l2_mcap_new_helper/l2_own_store_helper type dispatch l2_mad_emit uses natively, sourced from
# l2_mcap_value_helper's getter instead of a native C expression. l2_mad_src doubles as both the
# new Structure's parent (a real, arena-resident Lmx -- the model occurrence, not the host's own
# node, which nothing here has access to) and the source of the range copy, exactly as l2_mad_src
# does in l2_mad_emit.
fn: l2_emit_mad_construct_one (int: mi) int
    int: model l2_mad_model[mi]
    int: kids
    int: mw
    int: hw
    int: nc 0
    int: k 0
    int: ci 0
    int: slot
    int: ty
    if: model < 0 || l2_m_steps = 0 || l2_m_steps[model] <= 0 || l2_m_walkable[model] = 0
        return: l2_mad_unwalkable(mi, model)
    # The constructor reaches the host's `node` through the model's occurrence, whose parent the unit's builder
    # sets to the host's occurrence for every method recorded under a host (l2_mad_host_of).  That record is
    # the translation's own, and it is verified here, once, where the constructor is written: the constructor
    # itself checks neither it nor the count and presence of its operands, which the step naming it is built
    # with (l2_rw_mad_build).
    if: l2_mad_host_of(model) != mi
        return: l2_error(l2_src, l2_m_node[mi], "internal: a returned definition is not recorded under the method that returns it")
    # Same physical range as the native producer: cells are source-ordered.
    kids: l2_m_width(model)
    mw: l2_m_width(model)
    hw: l2_m_width(mi)
    while: k < l2_mcap_n
        if: l2_mcap_model[k] = model
            nc: nc + 1
        k: k + 1
    ---
    if: c.fprintf(l2_out, "fn: l2_mad_construct_%d (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int\n    @: Lmx l2_madc 0\n    @: Lmx l2_mad 0\n    @: Lmx l2_mad_src 0\n    @: void l2_mad_cell 0\n    size_t: l2_mad_k 0U\n", mi) < 0
        return: 1
    if: l2_mad_struct_caps(model) != 0 && c.fprintf(l2_out, "    []: size_t l2_capf %d\n", l2_mad_capf_room(model)) < 0
        return: 1
    # C, the copied lexical context, under the host's `node` -- the model's occurrence hangs under its host (book §3),
    # whose parent that is.
    if: c.fprintf(l2_out, "    l2_mad_src: (cast: (@: Lmx) lmx_pointer_value_known(refs[0]))\n    l2_madc: lmx_struct_new_owned(l2_mad_src\\parent\\parent, (cast: (@: LmxArena) owner))\n    if: l2_madc = 0 || lmx_arena_refs_open_owned((cast: (@: LmxArena) owner), l2_madc, %uU) != 0\n        c.fprintf(c.stderr, \"lmx: invariant: a callable merge could not be built\\n\")\n        c.abort()\n", (cast: (unsigned) (hw + l2_m_arity[mi]))) < 0
        return: 1
    k: 0
    while: k < l2_mcap_n
        if: l2_mcap_model[k] = model
            slot: l2_madc_slot(mi, k)
            if: slot < 0
                return: l2_error(l2_src, l2_m_node[model], "a callable merge lost a captured name")
            ty: l2_mcap_ty[k]
            # Item 738: a Structure capture -- the copy of the fields the model reads, from the walked host's operand.
            if: l2_mcap_ns[k] >= 0 && l2_mad_cap_emit_walk(model, k, 1 + ci, slot) != 0
                return: 1
            if: l2_mcap_ns[k] < 0 && c.fprintf(l2_out, "    l2_mad_cell: %s((cast: (@: LmxArena) owner))\n    if: l2_mad_cell = 0 || %s(l2_mad_cell, %s(refs[%uU])) != 0 || lmx_arena_ref_store(l2_madc, %uU, l2_mad_cell) != 0\n        c.abort()\n", l2_mcap_new_helper(ty), l2_own_store_helper(ty), l2_mcap_value_helper(ty), (cast: (unsigned) (1 + ci)), (cast: (unsigned) slot)) < 0
                return: 1
            ci: ci + 1
        ---
        k: k + 1
    ---
    # N, the model's occurrence copied under C: signature parts and steps shared, fields and control bodies copied.
    if: c.fprintf(l2_out, "    l2_mad: lmx_struct_new_owned(l2_madc, (cast: (@: LmxArena) owner))\n    if: l2_mad = 0 || lmx_arena_refs_open_owned((cast: (@: LmxArena) owner), l2_mad, %uU) != 0\n        c.fprintf(c.stderr, \"lmx: invariant: a callable merge could not be built\\n\")\n        c.abort()\n    l2_mad_k: 0U\n    while: l2_mad_k < %uU\n        l2_mad_cell: lmx_arena_ref_value(l2_mad_src, l2_mad_k)\n        if: l2_mad_k >= 2U && l2_mad_k < %uU\n            l2_mad_cell: lmx_walk_cell_copy((cast: (@: LmxArena) owner), l2_mad_cell)\n        if: lmx_arena_ref_store(l2_mad, l2_mad_k, l2_mad_cell) != 0\n            c.abort()\n        l2_mad_k: l2_mad_k + 1U\n    l2_mad\\native: l2_mad_src\\native\n    \\out: (cast: (@: void) l2_mad)\n    return: c.LMX_PRIMITIVE_OK\nend: l2_mad_construct_%d\n\n", (cast: (unsigned) mw), (cast: (unsigned) mw), (cast: (unsigned) kids), mi) < 0
        return: 1
return: 0

# Once per translation, after every method's own trampoline/body is emitted (l2_mad_call's own
# emission point): every T6/T6b host that actually walked (l2_m_steps[i] > 0, set only when
# l2_rw_may admitted it) gets its own constructor. A host l2_rw_may excluded (a malformed mad
# shape) never reaches here -- l2_m_steps stays -1 for it. A method that returns a merge is walked
# too, and the node it builds is the merge's, by the merge's constructor (l2_t7_emit_makes), not
# one of these. NOT conditioned on l2_walk_methods:
# l2_rw_methods_count/l2_rw_methods_emit (:25860/:26703) build the op-tree unconditionally, the
# same way a method's native trampoline is always emitted regardless of the knob -- the knob picks
# which one an entry uses, not whether the walked one compiles. Gating this behind the knob while
# l2_rw_mad_ret's own reference to l2_mad_construct_<mi> is not is exactly what left the reference
# dangling (measured: gcc undeclared identifier on unit_make_adder.lm2 with no --walk-methods).
fn: l2_emit_mad_constructs () int
    int: i 0
    while: i < l2_m_n
        if: l2_library_mode = 0 && l2_mad_on(i) != 0 && l2_t7_host_site(i) < 0 && l2_m_steps != 0 && l2_m_steps[i] > 0
            if: l2_emit_mad_construct_one(i) != 0
                return: 1
            ---
        i: i + 1
return: 0

fn: l2_rw_mad_at (int: parent; int: slot; @: int out) int
    if: l2_rw_frame(parent, "LMX_WALK_OP_AT", 3, out) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %uU) != c.LMX_WALK_OK\n            return: 1\n", \out, (cast: (unsigned) slot)) < 0
        return: 1
return: 0

fn: l2_rw_mad_store (const: @(LmP0Node stmt); int: into; @: int out) int
    const: @(LmP0Node made) l2_receiver_call(stmt, 0)
    @: LmP0Field f 0
    int: idx
    int: oi
    int: call
    int: vs
    idx: l2_store_host(stmt)
    oi: l2_own_by_decl(l2_rw_mi, stmt)
    if: oi < 0 || idx < 0 || made = 0
        return: l2_rw_refuse(stmt, "a callable merge")
    if: made\as\frame\body != 0
        f: l2_call_actuals(made\as\frame\body)
    # §7b: the node goes to the field's working value when it has one (SET), else to its slot (l2_rw_write).
    if: l2_rw_write(into, oi, l2_rw_bind_op(oi), out, @ vs) != 0
        return: 1
    if: l2_rw_call(made, idx, -1, f, \out, @ call) != 0 || l2_rw_put(\out, vs, call) != 0
        return: 1
return: 0

fn: l2_rw_mad_call (const: @(LmP0Node node); int: oi; int: parent; @: int out) int
    @: LmP0Field f 0
    int: hidden_model
    int: hidden_source
    int: cand
    int: source_mi
    int: same
    int: n
    int: j 0
    int: given 0
    int: span
    int: arg
    int: at
    int: model
    int: nh 0
    int: k
    int: ns
    int: holder
    int: contract
    int: inputs
    int: rty
    int: bound 0 - 1
    int: site
    int: hb
    const: @(LmP0Structure body) l2_call_node_body(node)
    if: node = 0 || node\as = 0
        return: l2_rw_refuse(node, "this call's inputs")
    # The primitive contract carries the actual formal and result widths. The
    # common adapter forwards value storage; it does not infer type from an address.
    n: l2_mad_held_arity(oi)
    rty: l2_mad_held_ret_ty(oi)
    if: n < 0 || rty < 0
        return: l2_rw_refuse(node, "a held callable whose header is not numbers to a number")
    if: body != 0
        f: l2_next_active(l2_call_actuals(body))
        given: l2_actual_count(l2_call_actuals(body))
        bound: l2_bound_find(body)
    ---
    if: given != n
        return: l2_rw_refuse(node, "this call's inputs")
    l2_mad_need_call: 1
    model: l2_mad_held_model(oi)
    if: model >= 0
        nh: l2_m_dyn[model]
    # §7b: a held callable is LMX code -- PRIM_PUB publishes after its operands, before the call.
    if: l2_rw_frame(parent, "LMX_WALK_OP_PRIM_PUB", 4 + n + nh, out) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        @: LmxPrimitive l2_rwp%d (cast: (@: LmxPrimitive) lmx_arena_take(l2_program_arena, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))\n        if: l2_rwp%d = 0\n            return: 1\n        l2_rwp%d\\fn: %s\n        l2_rwp%d\\signature: 0\n        l2_rwp%d\\owner: (cast: (@: Lmx) l2_program_arena)\n        if: lmx_arena_ref_store(l2_rw%d, 1U, (cast: (@: void) l2_rwp%d)) != 0\n            return: 1\n", \out, \out, \out, "l2_mad_call", \out, \out, \out, \out) < 0
        return: 1
    # In a walked method the held callable's name is a hidden input (Q52): ARG, else the root's own field.
    # In a definition its method returns the caller may leave that input absent: the definition then
    # reads its lexical source, as it reads a number's (l2_rw_arg_fb).
    if: l2_rw_mi != l2_e && l2_param_find(l2_rw_mi, l2_own_name[oi]) >= 0
        if: l2_rw_arg_fb(\out, l2_param_find(l2_rw_mi, l2_own_name[oi]), @ at) != 0 || l2_rw_put(\out, 3, at) != 0
            return: 1
        ---
    else:
        if: l2_rw_own(\out, oi, @ at) != 0 || l2_rw_put(\out, 3, at) != 0
            return: 1
    ---
    # The declared arguments, each of its formal's type, at the places they are written.  A
    # named one stands there under a NAMED operand that carries its formal's coordinate among
    # the primitive's inputs -- the held callable is input 0, formal j is input 1 + j -- and
    # the written name; the walk evaluates the operands in that order (l2_rw_call does the same).
    while: j < n
        span: l2_expr_span(f)
        if: span < 1
            return: l2_rw_refuse(node, "this call's inputs")
        site: \out
        if: l2_bound_wrap(bound, j) != 0
            if: l2_rw_frame(\out, "LMX_WALK_OP_NAMED", 3, @ site) != 0 || l2_rw_source_name(site, l2_mad_held_arg_name(oi, j)) != 0
                return: 1
            if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 1U, %dU) != c.LMX_WALK_OK\n            return: 1\n", site, 1 + j) < 0
                return: 1
            ---
        if: l2_rw_texpr(f, span, l2_mad_held_arg_ty(oi, j), site, @ arg) != 0 || l2_rw_put_actual(\out, site, 4 + l2_bound_rank(bound, j), arg) != 0
            return: 1
        f: l2_skip_span(f, span)
        j: j + 1
    ---
    # Reading 1: per hidden input of the model, this caller's own binding of its name (item 738: a Structure admitted as
    # the capture's type, unless the caller's formal is admitted by name already), or nothing -- an empty operand.
    k: 0
    while: k < nh
        hb: l2_rw_held_bound(model, k)
        # K04 S3: the caller only hands the name on, as another type, and it can never arrive: nothing to give.
        if: hb != 0 && l2_held_never(l2_rw_mi, model, k) != 0
            hb: 0
        if: hb = 0 && l2_held_unbound(node, l2_rw_mi, model, k) != 0
            return: 1
        if: hb != 0
            holder: \out
            ns: l2_cap_arg_ns(model, l2_m_arity[model] + k)
            # A capture given as a Structure of the capture's own type is admitted as itself.
            same: l2_held_cap_same(l2_rw_mi, model, k)
            if: same != 0 && l2_cap_src_marked(l2_rw_mi, l2_dn(model, k)) = 0 && l2_rw_admit_as(\out, ns, ns, @ holder) != 0
                return: 1
            # Any other reference the method gives -- a Structure of another declaration, an input it only
            # hands on -- is admitted to the model's use as a call of a method admits a hidden input
            # (l2_rw_call).
            hidden_model: l2_input_schema(model, l2_m_arity[model] + k)
            if: same = 0 && hidden_model != -1
                hidden_source: 0 - 1
                cand: l2_hidden_model_source(l2_rw_mi, model, k, @ hidden_source)
                if: cand = -1 && l2_input_undeclared(l2_rw_mi, hidden_source) = 0 && (l2_d105_opaque_place(l2_rw_mi, hidden_source) = 0 || l2_d105_place_sources(l2_rw_mi, hidden_source) = 0)
                    if: l2_rw_admit(\out, hidden_model, 0, l2_own_of_dt(l2_dt(model, k)), @ holder) != 0
                        return: 1
                    ---
                else:
                    source_mi: 0 - 1
                    if: hidden_source != -1
                        source_mi: l2_d105_key_method(l2_rw_mi, hidden_source)
                    if: l2_rw_admit_source(\out, hidden_model, cand, source_mi, hidden_source, model, l2_m_arity[model] + k, @ holder) != 0
                        return: 1
                    ---
                ---
            ---
            if: l2_rw_held_binding(node, model, k, holder, @ arg) != 0
                return: 1
            if: holder != \out
                if: l2_rw_put(holder, 3, arg) != 0
                    return: 1
                arg: holder
            ---
            if: l2_rw_put(\out, 4 + n + k, arg) != 0
                return: 1
        ---
        k: k + 1
    ---
    if: l2_rw_contract(\out, 1 + n + nh, rty, 0, @ contract, @ inputs) != 0 || l2_rw_witness(inputs, 0, 0, 1) != 0
        return: 1
    j: 0
    while: j < n
        if: l2_rw_witness(inputs, 1 + j, l2_mad_held_arg_ty(oi, j), 0) != 0
            return: 1
        j: j + 1
    ---
    k: 0
    while: k < nh
        if: l2_rw_input_witness(inputs, 1 + n + k, model, l2_m_arity[model] + k) != 0
            return: 1
        k: k + 1
    ---
    if: l2_rw_primitive_contract(\out, contract) != 0
        return: 1
return: 0

# Reading 1: has the running caller its own binding of hidden input k of model -- its input of that name, or its own
# field of that name it uses (the root's: every declared field)?  Nothing is built.
fn: l2_rw_held_bound (int: model; int: k) int
    @: LmP0Text nm
    int: oi
    nm: l2_dn(model, k)
    if: nm = 0
        return: 0
    if: l2_rw_mi != l2_e && l2_param_find(l2_rw_mi, nm) >= 0
        return: 1
    oi: l2_own_visible(l2_rw_mi, nm)
    if: oi < 0 || l2_own_uchild[oi] < 0
        return: 0
    if: l2_rw_mi != l2_e && l2_m_uses[l2_own_off(l2_rw_mi, oi)] = 0
        return: 0
return: 1

# T5 slice 1. A method whose whole body is one `merge(name: literal; Model)` is that model
# with the named formals bound as its own data fields. The declared header stays the signature.
fn: l2_pap_on (int: mi) int
    if: l2_pap_model = 0 || mi < 0 || mi >= l2_m_n
        return: 0
return: l2_pap_model[mi] >= 0

fn: l2_pap_method_of (const: @(LmP0Node node)) int
    int: idx
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM || node\as = 0 || node\as\atom = 0
        return: 0 - 1
    idx: l2_find_method(node\as\atom)
    if: idx < 0 || idx = l2_e
        return: 0 - 1
return: idx

fn: l2_pap_bind (const: @(LmP0Node node); @@: LmP0Text name; @@: LmP0Text lit) int
    @: LmP0Frame fr
    @: LmP0Field only
    size_t: bits 0U
    if: name = 0 || lit = 0
        return: 1
    \name: 0
    \lit: 0
    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
        return: 1
    fr: node\as\frame
    if: fr\head = 0 || l2_ident(fr\head) = 0 || fr\body = 0 || fr\trailer != 0 || fr\body\trailer != 0 || l2_count_active(fr\body) != 1
        return: 1
    only: l2_next_active(fr\body\first_field)
    if: only = 0 || only\value = 0 || only\value\kind != c.LM_P0_NODE_ATOM || only\value\as = 0 || only\value\as\atom = 0
        return: 1
    if: l2_int_literal_bits(only\value\as\atom, @ bits) != 1
        return: 1
    \name: fr\head
    \lit: only\value\as\atom
return: 0

fn: l2_pap_is_bind (const: @(LmP0Node node)) int
    @: LmP0Text nm 0
    @: LmP0Text lit 0
    if: l2_pap_bind(node, @ nm, @ lit) != 0
        return: 0
return: 1

# T7. A bound name of the merge being walked, or -1. Slot is on the result node.
fn: l2_t7_bound_slot (const: @(LmP0Text name)) int
    int: site
    int: i 0
    int: at
    if: l2_t7_walk = 0 || name = 0
        return: 0 - 1
    site: l2_t7_walk - 1
    if: site < 0 || site >= l2_t7_n
        return: 0 - 1
    while: i < l2_t7_nb[site]
        at: l2_t7_b0[site] + i
        if: l2_text_same(l2_t7b_nm[at], name) != 0
            return: l2_t7b_slot[at]
        i: i + 1
    ---
return: 0 - 1

# Index of name in the declared header, or -1.
fn: l2_t7_arg_of (const: @(LmP0Text name)) int
    int: site
    int: i 0
    int: at
    if: l2_t7_walk = 0 || name = 0
        return: 0 - 1
    site: l2_t7_walk - 1
    if: site < 0 || site >= l2_t7_n
        return: 0 - 1
    while: i < l2_t7_argc[site]
        at: l2_t7_h0[site] + i
        if: l2_text_same(l2_t7h_nm[at], name) != 0
            return: i
        i: i + 1
    ---
return: 0 - 1

fn: l2_t7_arg_ty (const: @(LmP0Text name)) int
    int: site
    int: i
    i: l2_t7_arg_of(name)
    if: i < 0
        return: 0 - 1
    site: l2_t7_walk - 1
return: l2_own_ty_of_param(l2_t7h_ty[l2_t7_h0[site] + i])

fn: l2_t7_host_site (int: mi) int
    int: s 0
    while: s < l2_t7_n
        if: l2_t7_kind[s] = 1 && l2_t7_host[s] = mi
            return: s
        s: s + 1
    ---
return: 0 - 1

# stmt is the `return:` whose value is the merge method mi returns: the one the method was recorded with
# (l2_t7_from_return), which checked it there.
fn: l2_t7_return_stmt (int: mi; const: @(LmP0Node stmt)) int
    @: LmP0Field only
    int: site l2_t7_host_site(mi)
    if: site < 0 || stmt = 0 || l2_frame_head(stmt, "return") = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0 || l2_count_active(stmt\as\frame\body) != 1
        return: 0
    only: l2_next_active(stmt\as\frame\body\first_field)
    if: only = 0 || only\value = 0
        return: 0
return: (cast: (int) (l2_t7_at[site] = only\value))

fn: l2_t7_name_bound (int: b0; int: nb; const: @(LmP0Text name)) int
    int: i 0
    int: at
    if: name = 0
        return: 0
    while: i < nb
        at: b0 + i
        if: l2_text_same(l2_t7b_nm[at], name) != 0
            return: 1
        i: i + 1
    ---
return: 0

# Remaining model formals, in order, are the declared header. Bound names are fields.
fn: l2_t7_header_match (int: model; int: h0; int: argc; int: ret; int: b0; int: nb) int
    int: j 0
    int: r 0
    int: at
    @: LmP0Text nm
    while: j < l2_m_arity[model]
        nm: l2_fn(model, j)
        if: l2_t7_name_bound(b0, nb, nm) = 0
            if: r >= argc
                return: 0
            at: h0 + r
            if: nm = 0 || l2_text_same(nm, l2_t7h_nm[at]) = 0 || l2_ft(model, j) != l2_t7h_ty[at]
                return: 0
            r: r + 1
        j: j + 1
    ---
    if: r != argc
        return: 0
    if: l2_m_ret[model] != ret
        return: 0
return: 1

fn: l2_t7_host_sig (int: mi) @: LmP0Node
    @: LmP0Field f
    if: l2_m_node[mi] = 0 || l2_m_node[mi]\as = 0 || l2_m_node[mi]\as\frame = 0 || l2_m_node[mi]\as\frame\body = 0
        return: 0
    f: l2_next_active(l2_m_node[mi]\as\frame\body\first_field)
    if: f != 0
        f: l2_next_active(f\next)
    if: f != 0
        f: l2_next_active(f\next)
    if: f = 0 || f\value = 0 || l2_frame_head(f\value, "fn") = 0
        return: 0
return: f\value

# Writes the declared fn: header at l2_t7h_n. Returns its arity, or -1.
# Room for one more merge, one more binding, one more entry of a declared header.
fn: l2_t7_reserve () int
    int: cap
    size_t: isz
    size_t: psz
    @: void p
    if: l2_t7_n < l2_t7_cap
        return: 0
    cap: l2_cap_next(l2_t7_cap, l2_t7_n + 1)
    if: cap < 0
        l2_alloc_err: 2
        return: 1
    isz: c.sizeof(c.int)
    psz: c.sizeof(@: char)
    p: l2_vec_grow((cast: (@: void) l2_t7_kind), l2_t7_n, cap, isz)
    if: p = 0
        return: 1
    l2_t7_kind: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_t7_host), l2_t7_n, cap, isz)
    if: p = 0
        return: 1
    l2_t7_host: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_t7_model), l2_t7_n, cap, isz)
    if: p = 0
        return: 1
    l2_t7_model: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_t7_ret), l2_t7_n, cap, isz)
    if: p = 0
        return: 1
    l2_t7_ret: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_t7_argc), l2_t7_n, cap, isz)
    if: p = 0
        return: 1
    l2_t7_argc: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_t7_h0), l2_t7_n, cap, isz)
    if: p = 0
        return: 1
    l2_t7_h0: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_t7_nb), l2_t7_n, cap, isz)
    if: p = 0
        return: 1
    l2_t7_nb: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_t7_b0), l2_t7_n, cap, isz)
    if: p = 0
        return: 1
    l2_t7_b0: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_t7_steps), l2_t7_n, cap, isz)
    if: p = 0
        return: 1
    l2_t7_steps: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_t7_anchor), l2_t7_n, cap, isz)
    if: p = 0
        return: 1
    l2_t7_anchor: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_t7_at), l2_t7_n, cap, psz)
    if: p = 0
        return: 1
    l2_t7_at: (cast: (@@: LmP0Node) p)
    l2_t7_cap: cap
return: 0

fn: l2_t7b_reserve () int
    int: cap
    size_t: isz
    size_t: psz
    @: void p
    if: l2_t7b_n < l2_t7b_cap
        return: 0
    cap: l2_cap_next(l2_t7b_cap, l2_t7b_n + 1)
    if: cap < 0
        l2_alloc_err: 2
        return: 1
    isz: c.sizeof(c.int)
    psz: c.sizeof(@: char)
    p: l2_vec_grow((cast: (@: void) l2_t7b_how), l2_t7b_n, cap, isz)
    if: p = 0
        return: 1
    l2_t7b_how: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_t7b_val), l2_t7b_n, cap, isz)
    if: p = 0
        return: 1
    l2_t7b_val: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_t7b_slot), l2_t7b_n, cap, isz)
    if: p = 0
        return: 1
    l2_t7b_slot: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_t7b_nm), l2_t7b_n, cap, psz)
    if: p = 0
        return: 1
    l2_t7b_nm: (cast: (@@: LmP0Text) p)
    l2_t7b_cap: cap
return: 0

fn: l2_t7h_reserve () int
    int: cap
    size_t: isz
    size_t: psz
    @: void p
    if: l2_t7h_n < l2_t7h_cap
        return: 0
    cap: l2_cap_next(l2_t7h_cap, l2_t7h_n + 1)
    if: cap < 0
        l2_alloc_err: 2
        return: 1
    isz: c.sizeof(c.int)
    psz: c.sizeof(@: char)
    p: l2_vec_grow((cast: (@: void) l2_t7h_ty), l2_t7h_n, cap, isz)
    if: p = 0
        return: 1
    l2_t7h_ty: (cast: (@: int) p)
    p: l2_vec_grow((cast: (@: void) l2_t7h_nm), l2_t7h_n, cap, psz)
    if: p = 0
        return: 1
    l2_t7h_nm: (cast: (@@: LmP0Text) p)
    l2_t7h_cap: cap
return: 0

fn: l2_t7_take_sig (const: @(LmP0Node sig); const: @(char path); @: int out_ret) int
    @: LmP0Field args
    @: LmP0Field retf
    @: LmP0Field p
    @: LmP0Text nm
    int: ty 0
    int: n 0
    int: saved
    if: out_ret = 0 || sig = 0 || l2_mad_sig(sig) = 0
        return: 0 - 1
    args: l2_next_active(sig\as\frame\body\first_field)
    retf: l2_next_active(args\next)
    if: args = 0 || retf = 0 || retf\value = 0 || retf\value\as = 0
        return: 0 - 1
    if: l2_ret_type_word(retf\value\as\atom, 0, 0, @ ty) != 0
        return: 0 - 1
    \out_ret: ty
    saved: l2_last_cf_req
    p: l2_next_active(args\value\as\structure\first_field)
    while: p != 0
        if: l2_t7h_reserve() != 0
            l2_last_cf_req: saved
            return: 0 - 1
        nm: 0
        ty: 0
        if: l2_typed_formal(p\value, path, @ nm, @ ty) != 0
            l2_last_cf_req: saved
            return: 0 - 1
        l2_t7h_nm[l2_t7h_n]: nm
        l2_t7h_ty[l2_t7h_n]: ty
        l2_t7h_n: l2_t7h_n + 1
        l2_last_cf_req: saved
        n: n + 1
        p: l2_next_active(p\next)
    ---
    l2_last_cf_req: saved
return: n

fn: l2_t7_take_contract (int: req; @: int out_ret) int
    int: j 0
    if: out_ret = 0 || req < 0 || req >= l2_m_n
        return: 0 - 1
    \out_ret: l2_m_ret[req]
    while: j < l2_m_arity[req]
        if: l2_t7h_reserve() != 0
            return: 0 - 1
        l2_t7h_nm[l2_t7h_n]: l2_fn(req, j)
        l2_t7h_ty[l2_t7h_n]: l2_ft(req, j)
        l2_t7h_n: l2_t7h_n + 1
        j: j + 1
    ---
return: j

# One merge. kind 1: the host's return. kind 2: an actual of a callable formal.
# req is the formal's contract method for kind 2.
fn: l2_t7_fill (const: @(LmP0Node node); int: host; int: kind; int: req; const: @(char path)) int
    @: LmP0Field f
    @: LmP0Field only
    @: LmP0Frame fr
    @: LmP0Text nm
    @: LmP0Node sig
    int: methods 0
    int: model 0 - 1
    int: md
    int: h_save
    int: b_save
    int: argc
    int: ret 0
    int: nb
    int: fj
    int: how
    int: val
    int: slot
    int: at
    int: nop
    int: k
    size_t: bits 0U
    if: node = 0 || l2_frame_head(node, "merge") = 0 || node\as = 0 || node\as\frame = 0 || node\as\frame\body = 0
        return: l2_error(path, node, "a callable merge needs one model")
    nop: l2_merge_arity(node)
    if: nop < 0
        return: l2_error(path, node, "a merge operand is not an expression")
    if: nop = 0
        return: l2_error(path, node, "a callable merge needs one model")
    k: 0
    while: k < nop
        if: l2_merge_operand_node(node, k, host, path, @ f) != 0
            return: 1
        md: l2_pap_method_of(f\value)
        if: md >= 0
            methods: methods + 1
            model: md
        else:
            if: f\value = 0 || f\value\kind != c.LM_P0_NODE_FRAME || f\value\as = 0 || f\value\as\frame = 0
                return: l2_error(path, f\value, "a callable merge binds a name that is not a formal")
            fr: f\value\as\frame
            if: fr\head = 0 || l2_ident(fr\head) = 0 || fr\body = 0 || fr\trailer != 0 || l2_count_active(fr\body) != 1
                return: l2_error(path, f\value, "a callable merge binds a name that is not a formal")
            ---
        ---
        k: k + 1
    ---
    if: methods != 1 || model < 0
        return: l2_error(path, node, "a callable merge needs one model")
    h_save: l2_t7h_n
    b_save: l2_t7b_n
    if: kind = 1
        sig: l2_t7_host_sig(host)
        if: sig = 0
            return: l2_error(path, node, "a callable merge header does not match the model")
        argc: l2_t7_take_sig(sig, path, @ ret)
    else:
        argc: l2_t7_take_contract(req, @ ret)
    ---
    if: argc < 0
        l2_t7h_n: h_save
        return: l2_error(path, node, "out of memory")
    k: 0
    while: k < nop
        if: l2_merge_operand_node(node, k, host, path, @ f) != 0
            l2_t7h_n: h_save
            l2_t7b_n: b_save
            return: 1
        if: l2_pap_method_of(f\value) < 0
            fr: f\value\as\frame
            only: l2_next_active(fr\body\first_field)
            nm: fr\head
            fj: l2_formal_find(model, nm)
            if: fj < 0
                l2_t7h_n: h_save
                l2_t7b_n: b_save
                return: l2_error(path, f\value, "a callable merge binds a name that is not a formal")
            if: l2_ft(model, fj) != 0
                l2_t7h_n: h_save
                l2_t7b_n: b_save
                return: l2_error(path, f\value, "a callable merge binds an int formal")
            if: l2_t7_name_bound(b_save, l2_t7b_n - b_save, nm) != 0
                l2_t7h_n: h_save
                l2_t7b_n: b_save
                return: l2_error(path, f\value, "a callable merge binds one field once")
            how: 0 - 1
            val: 0
            if: only != 0 && only\value != 0 && only\value\kind = c.LM_P0_NODE_ATOM && only\value\as != 0 && l2_int_literal_bits(only\value\as\atom, @ bits) = 1
                how: 0
                val: (cast: (int) bits)
            if: how < 0 && only != 0 && only\value != 0 && only\value\kind = c.LM_P0_NODE_ATOM && only\value\as != 0 && l2_ident(only\value\as\atom) != 0
                val: l2_formal_find(host, only\value\as\atom)
                if: val >= 0 && l2_ft(host, val) = 0
                    how: 1
                ---
            if: how < 0
                l2_t7h_n: h_save
                l2_t7b_n: b_save
                return: l2_error(path, f\value, "a callable merge binds an int formal")
            if: l2_t7b_reserve() != 0
                l2_t7h_n: h_save
                l2_t7b_n: b_save
                return: l2_alloc_or(path, f\value, "out of memory")
            # COUNT needs only a nonnegative datum marker. Its final coordinate
            # is assigned after the model's complete source width is measured.
            slot: 2 + l2_t7b_n - b_save
            at: l2_t7b_n
            l2_t7b_nm[at]: nm
            l2_t7b_how[at]: how
            l2_t7b_val[at]: val
            l2_t7b_slot[at]: slot
            l2_t7b_n: l2_t7b_n + 1
        k: k + 1
    ---
    nb: l2_t7b_n - b_save
    if: l2_t7_header_match(model, h_save, argc, ret, b_save, nb) = 0
        l2_t7h_n: h_save
        l2_t7b_n: b_save
        return: l2_error(path, node, "a callable merge header does not match the model")
    if: l2_t7_reserve() != 0
        l2_t7h_n: h_save
        l2_t7b_n: b_save
        return: l2_alloc_or(path, node, "out of memory")
    at: l2_t7_n
    l2_t7_kind[at]: kind
    l2_t7_host[at]: host
    l2_t7_model[at]: model
    l2_t7_ret[at]: ret
    l2_t7_argc[at]: argc
    l2_t7_h0[at]: h_save
    l2_t7_nb[at]: nb
    l2_t7_b0[at]: b_save
    l2_t7_steps[at]: 0
    l2_t7_anchor[at]: host
    l2_t7_at[at]: (cast: (@: LmP0Node) node)
    l2_t7_n: l2_t7_n + 1
    if: kind = 1
        if: l2_mad_model = 0 || host < 0 || host >= l2_mad_cap
            l2_t7_n: l2_t7_n - 1
            l2_t7h_n: h_save
            l2_t7b_n: b_save
            return: l2_error(path, node, "out of memory")
        l2_mad_model[host]: model
    return: 0

fn: l2_t7_from_return (int: mi; const: @(LmP0Node node); const: @(char path)) int
return: l2_t7_fill(node, mi, 1, 0 - 1, path)

# The model of the merge at `node`, given as an actual in method mi, or -1.
fn: l2_t7_actual_model (int: mi; const: @(LmP0Node node)) int
    int: s 0
    while: s < l2_t7_n
        if: l2_t7_kind[s] = 2 && l2_t7_at[s] = node && l2_t7_host[s] = mi
            return: l2_t7_model[s]
        s: s + 1
    ---
return: 0 - 1

fn: l2_t7_from_actual (int: mi; int: callee; int: fi; const: @(LmP0Node node); const: @(char path)) int
    int: req
    if: mi < 0
        return: l2_error(path, node, "incompatible entry signature")
    req: l2_cf_get(callee, fi)
    if: req < 0
        return: l2_error(path, node, "incompatible entry signature")
    # One merge is one site, however often its call is checked.
    if: l2_t7_actual_model(mi, node) >= 0
        return: 0
    if: l2_t7_fill(node, mi, 2, req, path) != 0
        return: 1
return: 0

# The header of the constructor of the merge at `site`: the selected model occurrence, then, in
# the order the merge writes them, one int per formal of the performing method that the merge binds to.
fn: l2_t7_make_sig (int: site) int
    int: j 0
    if: c.fprintf(l2_out, "fn: l2_t7_make_%d (@: Lmx l2_t7_at", site) < 0
        return: 1
    while: j < l2_t7_nb[site]
        if: l2_t7b_how[l2_t7_b0[site] + j] != 0 && c.fprintf(l2_out, "; int: l2_t7b%d", j) < 0
            return: 1
        j: j + 1
    ---
    if: fputs(") @: Lmx\n", l2_out) < 0
        return: 1
return: 0

# The walked body's entry to the same construction: the primitive entry over l2_t7_make_<site>.  refs[0] is the
# selected model occurrence; refs[1..] are the bound values, in the order of the constructor's header.
# How many operands there are, and that each is present, is what the step naming this entry is built with
# (l2_rw_t7_build) and what the primitive's contract says: the entry does not check it again.
fn: l2_t7_emit_construct (int: site) int
    int: j 0
    int: nv 0
    while: j < l2_t7_nb[site]
        if: l2_t7b_how[l2_t7_b0[site] + j] != 0
            nv: nv + 1
        j: j + 1
    ---
    if: c.fprintf(l2_out, "fn: l2_t7_construct_%d (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int\n    @: Lmx l2_t7_at 0\n    @: Lmx l2_t7_made 0\n    l2_t7_at: (cast: (@: Lmx) lmx_pointer_value_known(refs[0]))\n    l2_t7_made: l2_t7_make_%d(l2_t7_at", site, site) < 0
        return: 1
    j: 0
    while: j < nv
        if: c.fprintf(l2_out, ", lmx_int_value_known(refs[%uU])", (cast: (unsigned) (1 + j))) < 0
            return: 1
        j: j + 1
    ---
    if: c.fprintf(l2_out, ")\n    \\out: (cast: (@: void) l2_t7_made)\n    return: c.LMX_PRIMITIVE_OK\nend: l2_t7_construct_%d\n\n", site) < 0
        return: 1
return: 0

# The node of the merge at `site` is built in one place, by one function of the generated module, for the native
# body and for the walked one: l2_t7_make_<site>.  The native body calls it (l2_t7_write); the walked body's step
# calls it through its primitive entry (l2_rw_t7_build, l2_t7_emit_construct).  The author's rule (2026-10-05,
# T7-NODE-LEXICAL-LINKS): merge copies the used part of the tree and rewrites the parent links inside the copy;
# the place of the merge gives the copy no parent and resolves nothing there. The selected model's actual
# parent is the copy seed; its source unit anchors its uses. The node hangs under the
# copy.  Its body reads that copy where no caller gives a name -- the fallback of a free name (AT of the entry
# unit, l2_rw_arg_fb) and `node\x` (the node's parent) -- the state of the merge, not the live one.
fn: l2_t7_emit_make (int: site; const: @(char ind)) int
    int: steps
    int: nb
    int: arity
    int: width
    int: j 0
    int: at
    int: slot
    int: b0
    int: how
    int: val
    int: nh 0
    int: ty
    []: char cell 64
    if: site < 0 || site >= l2_t7_n
        return: 1
    if: l2_t7_ret[site] != 0
        return: l2_error(l2_src, l2_t7_at[site], "a callable merge needs a walkable body")
    steps: l2_t7_steps[site]
    if: steps < 1
        return: l2_error(l2_src, l2_t7_at[site], "a callable merge needs a walkable body")
    nb: l2_t7_nb[site]
    arity: l2_t7_argc[site]
    b0: l2_t7_b0[site]
    width: l2_m_head(l2_t7_model[site]) + nb + steps
    # The node's args part is its complete contract: the declared formals, then the model's hidden inputs.
    nh: l2_m_dyn[l2_t7_model[site]]
    if: l2_t7_make_sig(site) != 0
        return: 1
    if: c.fprintf(l2_out, "%s@: Lmx l2_t7_up 0\n%s@: Lmx l2_t7n%d 0\n%s@: Lmx l2_t7p%d 0\n%s@: void l2_t7c%d 0\n", ind, ind, site, ind, site, ind, site) < 0
        return: 1
    if: nh > 0 && c.fprintf(l2_out, "%s@@: void l2_t7s%d 0\n", ind, site) < 0
        return: 1
    # A unit alias exists only for a non-namespace method row. Hosted rows
    # require the activation-local producer, not a borrowed prototype alias.
    # Main and part methods share this allocation predicate; depth is derived
    # from completed parent metadata, never bounded by a language constant.
    if: l2_t7_model[site] = l2_e || l2_m_nsof(l2_t7_model[site]) >= 0 || l2_mad_host_of(l2_t7_model[site]) >= 0 || l2_lex_depth(l2_t7_model[site], l2_e) <= 0
        return: l2_error(l2_src, l2_t7_at[site], "a callable merge's model has no selectable source occurrence yet")
    if: l2_t7_emit_lex_copy(site, ind) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_t7n%d: lmx_struct_new_owned(l2_t7_up, l2_program_arena)\n%sif: l2_t7n%d = 0 || lmx_arena_refs_open_owned(l2_program_arena, l2_t7n%d, %uU) != 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: a callable merge could not be built\\n\")\n%s    c.abort()\n", ind, site, ind, site, site, (cast: (unsigned) width), ind, ind) < 0
        return: 1
    if: arity + nh > 0 && c.fprintf(l2_out, "%sl2_t7p%d: lmx_struct_new_owned(l2_t7n%d, l2_program_arena)\n%sif: l2_t7p%d = 0 || lmx_arena_refs_open_owned(l2_program_arena, l2_t7p%d, %uU) != 0 || lmx_arena_ref_store(l2_t7n%d, 0U, (cast: (@: void) l2_t7p%d)) != 0\n%s    c.abort()\n", ind, site, site, ind, site, site, (cast: (unsigned) (arity + nh)), site, site, ind) < 0
        return: 1
    if: arity + nh = 0 && c.fprintf(l2_out, "%sl2_t7p%d: lmx_struct_new_owned(l2_t7n%d, l2_program_arena)\n%sif: l2_t7p%d = 0 || lmx_arena_ref_store(l2_t7n%d, 0U, (cast: (@: void) l2_t7p%d)) != 0\n%s    c.abort()\n", ind, site, site, ind, site, site, site, ind) < 0
        return: 1
    while: j < arity
        if: c.fprintf(l2_out, "%sl2_t7c%d: lmx_int_new_owned(l2_program_arena)\n%sif: l2_t7c%d = 0 || lmx_arena_ref_store(l2_t7p%d, %uU, l2_t7c%d) != 0\n%s    c.abort()\n", ind, site, ind, site, site, (cast: (unsigned) j), site, ind) < 0
            return: 1
        j: j + 1
    ---
    # A cell of each hidden input's type, as a method's own args part has (l2_emit_parts).
    j: 0
    while: j < nh
        ty: l2_own_of_dt(l2_dt(l2_t7_model[site], j))
        if: ty >= 0
            if: c.sprintf(cell, "l2_t7s%d", site) < 0 || c.fprintf(l2_out, "%sl2_t7s%d: lmx_arena_ref_cell(l2_t7p%d, %uU)\n%sif: l2_t7s%d = 0\n%s    c.abort()\n", ind, site, site, (cast: (unsigned) (arity + j)), ind, site, ind) < 0 || l2_emit_cell_new_ty(ty, 0U, ind, cell, "c.abort()", 0) != 0
                return: 1
            ---
        j: j + 1
    ---
    if: c.fprintf(l2_out, "%sl2_t7p%d: lmx_struct_new_owned(l2_t7n%d, l2_program_arena)\n%sif: l2_t7p%d = 0 || lmx_arena_refs_open_owned(l2_program_arena, l2_t7p%d, 1U) != 0 || lmx_arena_ref_store(l2_t7n%d, 1U, (cast: (@: void) l2_t7p%d)) != 0\n%s    c.abort()\n%sl2_t7c%d: lmx_int_new_owned(l2_program_arena)\n%sif: l2_t7c%d = 0 || lmx_arena_ref_store(l2_t7p%d, 0U, l2_t7c%d) != 0\n%s    c.abort()\n", ind, site, site, ind, site, site, site, site, ind, ind, site, ind, site, site, site, ind) < 0
        return: 1
    j: 0
    while: j < nb
        at: b0 + j
        how: l2_t7b_how[at]
        val: l2_t7b_val[at]
        slot: l2_t7b_slot[at]
        if: how = 0 && c.fprintf(l2_out, "%sl2_t7c%d: lmx_int_new_owned(l2_program_arena)\n%sif: l2_t7c%d = 0 || lmx_int_store_known(l2_t7c%d, %d) != 0 || lmx_arena_ref_store(l2_t7n%d, %uU, l2_t7c%d) != 0\n%s    c.abort()\n", ind, site, ind, site, site, val, site, (cast: (unsigned) slot), site, ind) < 0
            return: 1
        if: how != 0 && c.fprintf(l2_out, "%sl2_t7c%d: lmx_int_new_owned(l2_program_arena)\n%sif: l2_t7c%d = 0 || lmx_int_store_known(l2_t7c%d, l2_t7b%d) != 0 || lmx_arena_ref_store(l2_t7n%d, %uU, l2_t7c%d) != 0\n%s    c.abort()\n", ind, site, ind, site, site, j, site, (cast: (unsigned) slot), site, ind) < 0
            return: 1
        j: j + 1
    ---
    if: c.fprintf(l2_out, "%sif: l2_view_build_%d(l2_t7_lex, l2_t7n%d) != 0\n%s    c.abort()\n%sreturn: l2_t7n%d\nend: l2_t7_make_%d\n\n", ind, site, site, ind, ind, site, site) < 0
        return: 1
return: l2_t7_emit_construct(site)

# The copy of the model's lexical tree a callable merge's node hangs under (l2_t7_emit_make), made the way a merge
# copies (READ-FIELD-CLOSURE; Codex -29 step 4): in part -- only the places the node's code uses, its model's and the
# unit methods' its uses reach, all anchored at the unit (l2_mu_collect_home), resolved where the layout is final --
# and the links that reach them, every other place absent; never a whole copy of the unit.  The
# program's qualified branches are retained by their exact profiles where a use reaches one. `l2_t7_up` is the
# copied model parent; `l2_t7_lex` is its copied source unit for the view. No global prototype supplies either.
# A failed copy stops the program, as every other failure of this constructor does.
fn: l2_t7_emit_lex_copy (int: site; const: @(char ind)) int
    int: q 0
    int: i 0
    int: j
    int: depth l2_lex_depth(l2_t7_model[site], l2_e)
    int: d 1
    if: depth <= 0
        return: l2_error(l2_src, l2_t7_at[site], "internal: a callable merge model has no constructed source unit")
    if: c.fprintf(l2_out, "%s[]: @(Lmx) l2_t7_keep %d\n%ssize_t: l2_t7_kn 0U\n%s@: Lmx l2_t7_lex 0\n%s@: Lmx l2_t7_source l2_t7_at\\parent\n%s@: Lmx l2_t7_unit l2_t7_source\n", ind, (cast: (int) (l2_ebr_n + 1)), ind, ind, ind, ind) < 0
        return: 1
    while: d < depth
        if: c.fprintf(l2_out, "%sl2_t7_unit: l2_t7_unit\\parent\n", ind) < 0
            return: 1
        d: d + 1
    ---
    while: q < l2_ebr_n
        if: c.fprintf(l2_out, "%sl2_t7_keep[l2_t7_kn]: lmx_range_profile(l2_program_arena, (cast: (@: void) l2_program_qualified_at(%dU)))\n%sif: l2_t7_keep[l2_t7_kn] != 0\n%s    l2_t7_kn: l2_t7_kn + 1U\n", ind, q, ind, ind) < 0
            return: 1
        q: q + 1
    ---
    if: l2_mu_collect_home(l2_t7_model[site]) != 0
        return: 1
    if: l2_mur_n = 0 && c.fprintf(l2_out, "%sif: lmx_graph_copy_part_used_owned(l2_t7_source, l2_program_arena, l2_program_arena, l2_t7_keep, l2_t7_kn, 0, 0, 0, 0, 0U, 0U, @ l2_t7_lex) != 0 || l2_t7_lex = 0\n", ind) < 0
        return: 1
    if: l2_mur_n > 0
        if: c.fprintf(l2_out, "%s[]: @(Lmx) l2_t7ua %d\n%s[]: size_t l2_t7uk %d\n%s[]: size_t l2_t7ul %d\n%s[]: size_t l2_t7us %d\n", ind, l2_mur_n, ind, l2_mur_n, ind, l2_mur_n, ind, l2_mur_slots) < 0
            return: 1
        while: i < l2_mur_n
            if: c.fprintf(l2_out, "%sl2_t7ua[%dU]: l2_t7_unit\n%sl2_t7uk[%dU]: 0U\n%sl2_t7ul[%dU]: %dU\n", ind, i, ind, i, ind, i, l2_mur_len[i]) < 0
                return: 1
            j: 0
            while: j < l2_mur_len[i]
                if: c.fprintf(l2_out, "%sl2_t7us[%dU]: %dU\n", ind, l2_mur_off[i] + j, l2_mur_sbuf[l2_mur_off[i] + j]) < 0
                    return: 1
                j: j + 1
            ---
            i: i + 1
        ---
        if: c.fprintf(l2_out, "%sif: lmx_graph_copy_part_used_owned(l2_t7_source, l2_program_arena, l2_program_arena, l2_t7_keep, l2_t7_kn, l2_t7ua, l2_t7uk, l2_t7us, l2_t7ul, %dU, %dU, @ l2_t7_lex) != 0 || l2_t7_lex = 0\n", ind, l2_mur_n, l2_mur_slots) < 0
            return: 1
    ---
    if: c.fprintf(l2_out, "%s    c.fprintf(c.stderr, \"lmx: invariant: a callable merge could not copy its lexical tree\\n\")\n%s    c.abort()\n%sl2_t7_up: l2_t7_lex\n", ind, ind, ind) < 0
        return: 1
    d: 1
    while: d < depth
        if: c.fprintf(l2_out, "%sl2_t7_lex: l2_t7_lex\\parent\n", ind) < 0
            return: 1
        d: d + 1
    ---
return: 0

# Every merge's constructor, once, after the methods' bodies.
fn: l2_t7_emit_makes () int
    int: s 0
    while: s < l2_t7_n
        if: l2_t7_emit_make(s, "    ") != 0
            return: 1
        s: s + 1
    ---
return: 0

# The merge at `site`, where the performing body stands: one call of the site's constructor (l2_t7_emit_make) over
# the selected model occurrence, with the value each bound formal of this method has here.
fn: l2_t7_write (int: site; const: @(char ind); int: do_ret) int
    int: j 0
    int: at
    []: char tok_own 1024
    L2Tx: tok_tx
    @: L2Tx tok l2_tx_local(@ tok_tx, tok_own, 1024U)
    if: site < 0 || site >= l2_t7_n
        return: 1
    if: l2_t7_ret[site] != 0 || l2_t7_steps[site] < 1
        return: l2_error(l2_src, l2_t7_at[site], "a callable merge needs a walkable body")
    l2_tx_clear(tok)
    if: l2_tok_method_occ(l2_t7_model[site], tok) != 0 || l2_emit_publish(ind) != 0
        return: 1
    if: c.fprintf(l2_out, "%s@: Lmx l2_t7n%d 0\n%sl2_t7n%d: l2_t7_make_%d(%s", ind, site, ind, site, site, tok\data) < 0
        return: 1
    while: j < l2_t7_nb[site]
        at: l2_t7_b0[site] + j
        if: l2_t7b_how[at] != 0
            l2_tx_clear(tok)
            if: l2_tok_formal(l2_t7_host[site], l2_t7b_val[at], tok) != 0 || c.fprintf(l2_out, ", (%s)", tok\data) < 0
                return: 1
            ---
        j: j + 1
    ---
    if: fputs(")\n", l2_out) < 0
        return: 1
    if: do_ret != 0 && c.fprintf(l2_out, "%sreturn: (cast: (@: void) l2_t7n%d)\n", ind, site) < 0
        return: 1
return: 0


fn: l2_t7_emit_actual (const: @(LmP0Node node); int: mi; const: @(char ind); @: L2Tx dest) int
    int: s 0
    []: char nm 32
    if: dest = 0
        return: 1
    while: s < l2_t7_n
        if: l2_t7_at[s] = node && l2_t7_host[s] = mi
            if: l2_t7_write(s, ind, 0) != 0
                return: 1
            if: c.snprintf(nm, 32U, "l2_t7n%d", s) < 0
                return: 1
            return: l2_tx_set(dest, nm)
        s: s + 1
    ---
return: l2_error(l2_src, node, "a callable merge needs one model")

fn: l2_t7_count () int
    int: s 0
    int: saved_cur l2_cur_mi
    int: made
    int: one
    int: bad
    int: model
    int: base
    int: steps
    int: nb
    int: width
    int: j
    @: L2SourceContainer source
    while: s < l2_t7_n
        model: l2_t7_model[s]
        l2_construct_begin(1, s, 0)
        if: l2_rw_bseq_zero() != 0
            return: l2_error(l2_src, l2_t7_at[s], "out of memory")
        l2_vis_method(model)
        l2_t7_walk: s + 1
        l2_rw_mi: model
        l2_cur_mi: model
        l2_rw_quiet: 1
        l2_rw_emit: 0
        l2_rw_machine: 0
        made: 0
        one: 0
        bad: 0
        # Data-only composition preserves the model's source slots. New data
        # append after its complete body/trailer, never before its fields.
        base: l2_m_head(model)
        # A model whose only line is its trailer `return:` has no body Structure: no source view and no body
        # steps, the trailer walked alone -- as a merge result's steps (l2_pap_steps) and a walked method's
        # (l2_rw_methods_count) take it.
        source: 0
        if: l2_m_body[model] != 0
            if: l2_m_body[model]\kind != c.LM_P0_NODE_STRUCTURE || l2_m_body[model]\as = 0 || l2_m_body[model]\as\structure = 0
                return: l2_error(l2_src, l2_t7_at[s], "internal: a callable merge's model has no Structure body producer")
            source: l2_source_container(l2_m_body[model]\as\structure, 0)
            if: source = 0
                return: l2_alloc_or(l2_src, l2_t7_at[s], "a source view could not be allocated")
            source\root: 1
            if: l2_rw_stmts(source\body\first_field, 0 - 2, base, source, @ made) != 0
                bad: 1
            ---
        ---
        if: bad = 0 && l2_rw_trailer(model, 0 - 2, base + made, @ one) != 0
            bad: 1
        l2_t7_walk: 0
        l2_rw_quiet: 0
        l2_rw_mi: l2_e
        l2_cur_mi: saved_cur
        l2_vis_on: 0
        if: bad != 0 || l2_rw_machine != 0
            return: l2_error(l2_src, l2_t7_at[s], "a callable merge needs a walkable body")
        if: made < 0 || one < 0 || one > c.INT_MAX - made
            return: l2_error(l2_src, l2_t7_at[s], "a callable merge has too many fields")
        steps: made + one
        if: steps <= 0
            return: l2_error(l2_src, l2_t7_at[s], "a callable merge needs a walkable body")
        nb: l2_t7_nb[s]
        if: base < 0 || nb < 0 || steps > c.INT_MAX - base || nb > c.INT_MAX - base - steps
            return: l2_error(l2_src, l2_t7_at[s], "a callable merge has too many fields")
        width: base + steps + nb
        l2_t7_steps[s]: steps
        j: 0
        while: j < nb
            l2_t7b_slot[l2_t7_b0[s] + j]: base + steps + j
            j: j + 1
        ---
        if: source != 0
            source\width: width
        if: l2_source_definition_roots(1, s, 0) != 0 || l2_source_refs_note(1, s, model) != 0
            return: 1
        if: l2_m_value_used != 0
            l2_m_value_used[model]: 1
        s: s + 1
    ---
    l2_construct_phase: -1
return: 0

# Produce the projected view in the selected occurrence itself. PLACE binds
# edges relative to that root; FILL emits its constructor, not an anchor pack
# which would later be borrowed at unrelated child positions.
fn: l2_t7_emit_frames (int: phase) int
    int: s 0
    int: saved_cur l2_cur_mi
    int: t
    int: made
    int: one
    int: bad
    int: model
    int: base
    int: ns
    @: L2SourceContainer source
    while: s < l2_t7_n
        model: l2_t7_model[s]
        base: l2_m_head(model)
        l2_construct_begin(1, s, phase)
        if: l2_rw_bseq_zero() != 0
            return: l2_error(l2_src, l2_t7_at[s], "out of memory")
        l2_vis_method(model)
        l2_t7_walk: s + 1
        l2_rw_mi: model
        l2_cur_mi: model
        l2_rw_emit: (cast: (int) (phase = 2))
        t: l2_rw_t
        l2_rw_t: l2_rw_t + 1
        made: 0
        one: 0
        bad: 0
        # A trailer-only model has no source view (l2_t7_count).
        source: 0
        if: l2_m_body[model] != 0
            source: l2_source_container(l2_m_body[model]\as\structure, 0)
            if: source = 0
                return: l2_error(l2_src, l2_t7_at[s], "internal: a projected source root is missing")
            if: phase = 1
                source\temp: t
            ---
        ---
        if: l2_construct_temp(t, -1, 1) != 0
            bad: 1
        if: phase = 2
            if: c.fprintf(l2_out, "fn: l2_view_build_%d (@: Lmx l2_entry_unit; @: Lmx target) int\n        @: Lmx l2_rw_roles lmx_walk_program_roles()\n        @: Lmx l2_entry_leaf 0\n        @@: void l2_entry_slot 0\n        @: Lmx l2_fkid 0\n        @: Lmx l2_pst 0\n        @@: void l2_pxp 0\n", s) < 0
                return: 1
            if: l2_ns_n > 0
                if: c.fprintf(l2_out, "        []: @(Lmx) l2_nsp %d\n", l2_ns_n) < 0
                    return: 1
                ns: 0
                while: ns < l2_ns_n
                    if: c.fprintf(l2_out, "        l2_nsp[%d]: 0\n", ns) < 0
                        return: 1
                    if: l2_ns_local[ns] < 0
                        if: l2_ns_parent[ns] >= 0
                            if: c.fprintf(l2_out, "        l2_nsp[%d]: lmx_arena_ref_struct(l2_nsp[%d], %uU)\n", ns, l2_ns_parent[ns], (cast: (unsigned) l2_ns_field_in_parent(ns))) < 0
                                return: 1
                            ---
                        else:
                            if: c.fprintf(l2_out, "        l2_nsp[%d]: lmx_arena_ref_struct(l2_entry_unit, %uU)\n", ns, (cast: (unsigned) l2_ns_unit_slot(ns))) < 0
                                return: 1
                            ---
                        ---
                    ---
                    ns: ns + 1
                ---
                # The model operands of the view are read from the program's unit (l2_rw_types_nsp): the places
                # l2_nsp holds in the copy (steps/defects.md, T7-MODEL-OPERAND-SOURCE).
                if: c.fprintf(l2_out, "        []: @(Lmx) l2_nst %d\n", l2_ns_n) < 0
                    return: 1
                ns: 0
                while: ns < l2_ns_n
                    if: c.fprintf(l2_out, "        l2_nst[%d]: 0\n", ns) < 0
                        return: 1
                    if: l2_ns_local[ns] < 0
                        if: l2_ns_parent[ns] >= 0
                            if: c.fprintf(l2_out, "        l2_nst[%d]: lmx_arena_ref_struct(l2_nst[%d], %uU)\n", ns, l2_ns_parent[ns], (cast: (unsigned) l2_ns_field_in_parent(ns))) < 0
                                return: 1
                            ---
                        else:
                            if: c.fprintf(l2_out, "        l2_nst[%d]: lmx_arena_ref_struct(l2_program_unit, %uU)\n", ns, (cast: (unsigned) l2_ns_unit_slot(ns))) < 0
                                return: 1
                            ---
                        ---
                    ---
                    ns: ns + 1
                ---
            ---
            if: l2_merge_build != 0 && c.fprintf(l2_out, "        []: @(Lmx) l2_mops 1\n        []: @(Lmx) l2_mkeep %d\n        size_t: l2_mkn 0U\n        int: l2_mstatus 0\n        @: Lmx l2_mresult 0\n        @: Lmx l2_mbody 0\n", l2_ebr_n + 1) < 0
                return: 1
            if: l2_source_cells_emit(1, s, "target") != 0 || c.fprintf(l2_out, "        @: Lmx l2_rw%d target\n", t) < 0 || (source != 0 && l2_source_fill(source) != 0)
                return: 1
            ---
        ---
        if: bad = 0 && source != 0 && l2_rw_stmts(source\body\first_field, t, base, source, @ made) != 0
            bad: 1
        if: bad = 0 && l2_rw_trailer(model, t, base + made, @ one) != 0
            bad: 1
        l2_t7_walk: 0
        l2_rw_emit: 0
        l2_rw_mi: l2_e
        l2_cur_mi: saved_cur
        l2_vis_on: 0
        if: bad != 0
            return: 1
        if: made + one != l2_t7_steps[s]
            return: l2_error(l2_src, l2_t7_at[s], "internal: a method's steps changed between the passes")
        if: l2_source_definition_roots(1, s, phase) != 0 || l2_source_refs_note(1, s, model) != 0 || (phase = 2 && (l2_source_refs_emit(1, s) != 0 || l2_source_fields_emit(1, s) != 0 || l2_source_layouts_emit(1, s) != 0)) || l2_source_fills_verify() != 0
            return: 1
        if: phase = 2 && c.fprintf(l2_out, "        return: 0\nend: l2_view_build_%d\n\n", s) < 0
            return: 1
        s: s + 1
    ---
return: 0

fn: l2_t7_emit_builders () int
    if: l2_t7_emit_frames(2) != 0
        return: 1
    l2_construct_phase: -1
    l2_construct_view_index: -1
return: 0

fn: l2_pap_sole (int: mi) @: LmP0Node
    @: LmP0Field f
    if: mi < 0 || mi >= l2_m_n || l2_m_body[mi] = 0 || l2_m_body[mi]\as = 0 || l2_m_body[mi]\as\structure = 0
        return: 0
    if: l2_m_node[mi] != 0 && l2_m_node[mi]\as != 0 && l2_ret_tr(l2_m_node[mi]\as\frame) != 0
        return: 0
    if: l2_count_active(l2_m_body[mi]\as\structure) != 1
        return: 0
    f: l2_next_active(l2_m_body[mi]\as\structure\first_field)
    if: f = 0
        return: 0
return: f\value

fn: l2_pap_consider (int: mi; const: @(char path)) int
    @: LmP0Node stmt
    @: LmP0Field f
    @: LmP0Text nm
    @: LmP0Text lit
    int: methods 0
    int: model 0 - 1
    int: md
    int: oi
    int: fj
    int: nop
    int: k
    size_t: off
    stmt: l2_pap_sole(mi)
    if: stmt = 0 || l2_frame_head(stmt, "merge") = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0
    nop: l2_merge_arity(stmt)
    if: nop < 1
        return: 0
    k: 0
    while: k < nop
        if: l2_merge_operand_node(stmt, k, mi, path, @ f) != 0
            return: 1
        md: l2_pap_method_of(f\value)
        if: md >= 0
            methods: methods + 1
            model: md
        else:
            if: l2_pap_is_bind(f\value) = 0
                return: 0
            ---
        ---
        k: k + 1
    ---
    if: methods != 1 || model < 0
        return: l2_error(path, stmt, "a callable merge needs one model")
    k: 0
    while: k < nop
        if: l2_merge_operand_node(stmt, k, mi, path, @ f) != 0
            return: 1
        if: l2_pap_method_of(f\value) < 0
            nm: 0
            lit: 0
            if: l2_pap_bind(f\value, @ nm, @ lit) != 0
                return: l2_error(path, f\value, "a callable merge binds a name that is not a formal")
            fj: l2_formal_find(model, nm)
            if: fj < 0
                return: l2_error(path, f\value, "a callable merge binds a name that is not a formal")
            if: l2_formal_find(mi, nm) >= 0
                return: l2_error(path, f\value, "a callable merge binds a formal the result still declares")
            if: l2_ft(model, fj) != 0
                return: l2_error(path, f\value, "a callable merge binds an int formal")
            if: l2_own_find(mi, nm) >= 0
                return: l2_error(path, f\value, "a callable merge binds one field once")
            if: l2_check_literal_kind(lit, 0, path, f\value) != 0
                return: 1
            oi: l2_own_add(mi, nm, 0, path, f\value)
            if: oi < 0
                return: 1
            off: l2_own_off(mi, oi)
            if: off = (cast: (size_t) -1)
                return: l2_error(path, f\value, "size overflow")
            l2_m_uses[off]: 1
            l2_m_own[mi]: l2_m_own[mi] + 1
            if: l2_bind_own(mi, oi, path, f\value) != 0
                return: 1
            ---
        ---
        k: k + 1
    ---
    l2_pap_model[mi]: model
return: 0

fn: l2_pap_prepare (const: @(char path)) int
    int: i 0
    if: l2_pap_model != 0
        l2_xfree((cast: (@: void) l2_pap_model))
    l2_pap_model: 0
    if: l2_m_n <= 0
        return: 0
    l2_pap_model: (cast: (@: int) calloc((cast: (size_t) l2_m_n), c.sizeof(c.int)))
    if: l2_pap_model = 0
        return: l2_error(path, 0, "out of memory")
    while: i < l2_m_n
        l2_pap_model[i]: 0 - 1
        i: i + 1
    ---
    i: 0
    while: i < l2_m_n
        if: l2_pap_consider(i, path) != 0
            return: 1
        i: i + 1
    ---
return: 0

fn: l2_pap_store (int: oi) int
    @: LmP0Text nm 0
    @: LmP0Text lit 0
    size_t: bits 0U
    if: oi < 0 || oi >= l2_own_n || l2_pap_on(l2_own_mi[oi]) = 0 || l2_own_ty[oi] != 0
        return: 0
    if: l2_pap_bind(l2_own_decl[oi], @ nm, @ lit) != 0
        return: 0
    if: l2_int_literal_bits(lit, @ bits) != 1
        return: 0
    if: c.fprintf(l2_out, "        if: lmx_int_store_known(l2_entry_slot[0], %d) != 0\n            return: 1\n", (cast: (int) bits)) < 0
        return: 1
return: 0

# The declared header is the model's formals that were not bound, in order, and the same return.
fn: l2_pap_header (int: mi) int
    int: model
    int: j 0
    int: r 0
    @: LmP0Text nm
    model: l2_pap_model[mi]
    if: model < 0 || l2_m_ret[mi] != l2_m_ret[model]
        return: 0
    while: j < l2_m_arity[model]
        nm: l2_fn(model, j)
        if: nm != 0 && l2_own_find(mi, nm) >= 0
            j: j + 1
            continue
        if: r >= l2_m_arity[mi]
            return: 0
        if: nm = 0 || l2_text_same(nm, l2_fn(mi, r)) = 0 || l2_ft(model, j) != l2_ft(mi, r)
            return: 0
        r: r + 1
        j: j + 1
    ---
    if: r != l2_m_arity[mi]
        return: 0
    ---
return: 1

# Frames of the model, names resolved in the result: a bound formal is AT of its field,
# any other formal is ARG of the declared header. No name is stored in the node.
fn: l2_pap_steps (int: mi) int
    int: saved_cur l2_cur_mi
    int: model
    int: made 0
    int: one 0
    int: bad 0
    @: LmP0Node stmt
    l2_construct_begin(0, mi, 0)
    model: l2_pap_model[mi]
    stmt: l2_pap_sole(mi)
    if: model < 0 || l2_rw_may(model) = 0
        return: l2_error(l2_src, stmt, "a callable merge needs a walkable body")
    if: l2_pap_header(mi) = 0
        return: l2_error(l2_src, stmt, "a callable merge header does not match the model")
    if: l2_rw_bseq_zero() != 0
        return: l2_error(l2_src, stmt, "out of memory")
    l2_vis_method(mi)
    l2_rw_mi: mi
    l2_cur_mi: mi
    l2_here_source_mi: model
    l2_rw_quiet: 1
    l2_rw_emit: 0
    if: l2_m_body[model] != 0 && l2_m_body[model]\as != 0 && l2_m_body[model]\as\structure != 0 && l2_rw_stmts(l2_m_body[model]\as\structure\first_field, 0 - 2, 0, 0, @ made) != 0
        bad: 1
    if: bad = 0 && l2_rw_trailer(model, 0 - 2, made, @ one) != 0
        bad: 1
    l2_rw_quiet: 0
    l2_rw_mi: l2_e
    l2_cur_mi: saved_cur
    l2_vis_on: 0
    if: bad != 0 || made + one <= 0 || l2_rw_machine != 0
        return: l2_error(l2_src, stmt, "a callable merge needs a walkable body")
    l2_m_steps[mi]: made + one
    l2_m_walkable[mi]: 1
return: 0

# NAMED STRUCTURE EXECUTION (steps/named-struct-exec.md §12; Q45 and its additions: a named Structure
# is a procedure with no arguments and no result).  S's body is the body of a method of its own --
# its procedure, l2_ns_proc -- checked, emitted natively and walked as every method's; its own fields
# are S's fields, in S's slots (l2_own_mslot).  R9: S is that procedure's occurrence -- after its fields
# it holds its control bodies and its steps, and its native word is the trampoline -- so executing S is
# S over itself: [exec, 0, S, 0, 0], the Structure in slot 2 run over itself (lmx_walk_call); natively
# lmx_call_prim(S, S) (l2_emit_ns_exec).  No result type: nothing is returned.
# The root's execution of named Structure ni.  Its hidden inputs follow the five slots (l2_rw_ns_hidden).
fn: l2_rw_ns_call (const: @(LmP0Node node); int: ni; int: into; @: int out) int
    if: l2_rw_frame(into, "LMX_WALK_OP_EXEC", 5 + l2_m_dyn[l2_ns_proc[ni]], out) != 0 || l2_use_unit_child(3, ni) != 0
        return: 1
    if: l2_rw_emit != 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_rw%d, 2U, (cast: (@: void) lmx_arena_ref_struct(l2_entry_unit, %uU))) != 0\n            return: 1\n", \out, (cast: (unsigned) (l2_ns_unit_slot(ni)))) < 0
        return: 1
return: l2_rw_ns_hidden(node, ni, \out)

# The nullary call of the Structure bound to h, walked (l2_check_struct_call): the pair of an ordinary named Structure
# the check pass marked (l2_rw_ns_call) or of the root's field declared `Model: v` (l2_rw_ns_var_call) -- one step,
# stored in container `into` at slot `slot` -- and no step for a Structure whose type is empty (l2_struct_call_inert).
fn: l2_rw_struct_call (const: @(LmP0Node node); const: @(LmP0Text h); int: into; int: slot; @: int made) int
    int: ni
    int: k
    int: st 0
    int: go 0
    \made: 0
    ni: l2_ns_exec_named(h, l2_rw_mi)
    k: l2_ns_exec_field(h, l2_rw_mi)
    if: k < 0
        k: l2_local_ns_callee(h, l2_rw_mi)
    if: ni >= 0 && l2_ns_exec[ni] != 0
        if: l2_rw_ns_call(node, ni, into, @ st) != 0
            return: 1
        go: 1
    ---
    if: go = 0 && k >= 0 && l2_ns_exec[l2_own_call_origin(k)] != 0
        if: l2_rw_ns_var_call(node, l2_own_call_origin(k), k, into, @ st) != 0
            return: 1
        go: 1
    ---
    if: go = 0 && l2_struct_call_inert(h, l2_rw_mi) != 0
        return: 0
    if: go = 0
        return: l2_rw_refuse(node, "this call")
    \made: 1
return: l2_rw_put(into, slot, st)

# Whether the bare atom h is the nullary call of a Structure the walk makes (l2_rw_struct_call): a named Structure or the
# root's field `Model: v` the check pass marked, or a Structure whose type is empty.
fn: l2_rw_struct_callee (const: @(LmP0Text h)) int
    int: ni
    int: k
    ni: l2_ns_exec_named(h, l2_rw_mi)
    if: ni >= 0 && l2_ns_exec[ni] != 0
        return: 1
    k: l2_ns_exec_field(h, l2_rw_mi)
    if: k < 0
        k: l2_local_ns_callee(h, l2_rw_mi)
    if: k >= 0 && l2_ns_exec[l2_own_call_origin(k)] != 0
        return: 1
return: l2_struct_call_inert(h, l2_rw_mi)

# The hidden inputs of named Structure ni's procedure, each at slot 5 + k of EXEC frame `frame`: the caller's binding
# first, then the callee's lexical source (book §12), as a call passes them (l2_rw_dyn_arg) -- a procedure without
# arguments is one with hidden arguments (the author, 2026-09-28).
fn: l2_rw_ns_hidden (const: @(LmP0Node node); int: ni; int: frame) int
    int: d 0
    int: arg
    int: contract
    int: pr l2_ns_proc[ni]
    int: holder
    int: hidden_model
    int: hidden_source
    int: cand
    int: source_mi
    if: l2_rw_method_contract(frame, pr, @ contract) != 0 || l2_rw_put(frame, 3, contract) != 0
        return: 1
    while: d < l2_m_dyn[pr]
        # A free input is admitted where it is formed, as a walked call admits one (l2_rw_call_at), to its requirement in
        # the space of the occurrence this EXEC selects (l2_rw_admit_project); a declared input keeps the record of its
        # declaration.
        holder: frame
        if: l2_free_admit(pr, d) != 0
            hidden_model: l2_input_schema(pr, l2_m_arity[pr] + d)
            hidden_source: -1
            cand: l2_hidden_model_source(l2_rw_mi, pr, d, @ hidden_source)
            if: cand = -1 && l2_input_undeclared(l2_rw_mi, hidden_source) = 0 && (l2_d105_opaque_place(l2_rw_mi, hidden_source) = 0 || l2_d105_place_sources(l2_rw_mi, hidden_source) = 0)
                if: l2_rw_admit(frame, hidden_model, 0, l2_own_of_dt(l2_dt(pr, d)), @ holder) != 0
                    return: 1
                ---
            else:
                source_mi: -1
                if: hidden_source != -1
                    source_mi: l2_d105_key_method(l2_rw_mi, hidden_source)
                if: l2_rw_admit_source(frame, hidden_model, cand, source_mi, hidden_source, pr, l2_m_arity[pr] + d, @ holder) != 0
                    return: 1
                ---
            ---
        if: l2_rw_dyn_arg(node, pr, d, holder, @ arg) != 0
            return: 1
        # An input handed absent has no operand.
        if: arg < 0
            d: d + 1
            continue
        if: holder != frame
            if: l2_rw_put(holder, 3, arg) != 0
                return: 1
            arg: holder
        ---
        if: l2_rw_put(frame, 5 + d, arg) != 0
            return: 1
        d: d + 1
    ---
return: 0

# Slice 4 (§11), R9: the root's execution of its slot field oi, declared `Model: v` with Model = ni: [exec, 0, v, 0,
# 0] -- the Structure the slot holds when the step runs (its AT, as a field path reads its root, l2_rw_path_value),
# run over itself: a merge copy of Model, its code with it (the author, 2026-09-28: «merge клонирует куски дерева»),
# dispatched through the actual value's native word, otherwise walked. A bare
# field above its declaration is refused before (unresolved name).
fn: l2_rw_ns_var_call (const: @(LmP0Node node); int: ni; int: oi; int: into; @: int out) int
    int: d
    if: l2_rw_frame(into, "LMX_WALK_OP_EXEC", 5 + l2_m_dyn[l2_ns_proc[ni]], out) != 0
        return: 1
    if: l2_rw_own(\out, oi, @ d) != 0 || l2_rw_put(\out, 2, d) != 0
        return: 1
return: l2_rw_ns_hidden(node, ni, \out)

# The count pass records retained source cardinality, independently of the
# interpreted capability. A descriptor-only declaration has no invented body.
# Missing source producers fail at their actual occurrence, never erase a
# method's body while reporting successful native translation.
fn: l2_rw_methods_count () int
    int: i 0
    int: saved_cur l2_cur_mi
    int: made
    int: one
    int: bad
    int: present
    int: d0
    @: L2SourceContainer source
    l2_m_steps: (cast: (@: int) calloc((cast: (size_t) (l2_m_n + 1)), c.sizeof(c.int)))
    l2_m_walkable: (cast: (@: int) calloc((cast: (size_t) (l2_m_n + 1)), c.sizeof(c.int)))
    if: l2_m_steps = 0 || l2_m_walkable = 0
        return: l2_error(l2_src, 0, "out of memory")
    l2_m_why: (cast: (@@: char) calloc((cast: (size_t) (l2_m_n + 1)), c.sizeof(@: char)))
    l2_m_why_line: (cast: (@: size_t) calloc((cast: (size_t) (l2_m_n + 1)), c.sizeof(c.size_t)))
    l2_m_why_col: (cast: (@: size_t) calloc((cast: (size_t) (l2_m_n + 1)), c.sizeof(c.size_t)))
    if: l2_m_why = 0 || l2_m_why_line = 0 || l2_m_why_col = 0
        return: l2_error(l2_src, 0, "out of memory")
    while: i < l2_m_n
        l2_construct_begin(0, i, 0)
        l2_m_steps[i]: 0 - 1
        l2_rw_machine: 0
        l2_rw_quiet_msg: l2_msg_drop(l2_rw_quiet_msg)
        l2_rw_quiet_line: 0U
        l2_rw_quiet_col: 0U
        if: l2_library_mode = 0 && l2_pap_on(i) != 0
            if: l2_pap_steps(i) != 0
                return: 1
            ---
        ---
        present: (cast: (int) (i = l2_e || l2_m_body[i] != 0 || l2_t7_host_site(i) >= 0))
        if: l2_m_node[i] != 0 && l2_m_node[i]\kind = c.LM_P0_NODE_FRAME && l2_m_node[i]\as != 0 && l2_m_node[i]\as\frame != 0 && l2_m_node[i]\as\frame\trailer != 0
            present: 1
        if: l2_library_mode = 0 && l2_pap_on(i) = 0 && present != 0
            if: l2_m_body[i] != 0 && (l2_m_body[i]\kind != c.LM_P0_NODE_STRUCTURE || l2_m_body[i]\as = 0 || l2_m_body[i]\as\structure = 0)
                return: l2_error(l2_src, l2_m_node[i], "internal: a source method has no Structure body producer")
            if: l2_rw_bseq_zero() != 0
                return: l2_error(l2_src, 0, "out of memory")
            l2_vis_method(i)
            l2_rw_mi: i
            l2_cur_mi: i
            l2_rw_quiet: 0
            d0: l2_diag_n
            l2_rw_emit: 0
            made: 0
            one: 0
            bad: 0
            source: 0
            # The machine locals are the ones of this method's own body, in
            # every pass that produces its source.
            l2_ml_free()
            if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_m_body[i]\as\structure != 0 && l2_ml_collect(l2_m_body[i]\as\structure, i, l2_src) != 0
                return: 1
            if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_m_body[i]\as\structure != 0
                if: i = l2_e
                    source: l2_source_container((cast: (@: LmP0Structure) l2_cur_unit), 0)
                else:
                    source: l2_source_container(l2_m_body[i]\as\structure, 0)
                ---
                if: source = 0
                    return: l2_error(l2_src, l2_m_body[i], "out of memory")
                source\root: 1
            ---
            # §7b: the body's fields with working values are read by OWN and written by SET; the walker loads them at
            # entry from these nodes (no load step).
            l2_rw_cache_on: 1
            if: source != 0
                if: l2_rw_stmts(source\body\first_field, 0 - 2, l2_m_head(i), source, @ made) != 0
                    bad: 1
                ---
            else:
                if: bad = 0 && l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_m_body[i]\as\structure != 0 && l2_rw_stmts(l2_m_body[i]\as\structure\first_field, 0 - 2, 0, source, @ made) != 0
                    bad: 1
                ---
            ---
            if: bad = 0 && l2_rw_trailer(i, 0 - 2, l2_m_head(i) + made, @ one) != 0
                bad: 1
            if: bad = 0
                l2_m_steps[i]: made + one
                l2_m_walkable[i]: (cast: (int) (l2_rw_machine = 0 && l2_rw_may(i) != 0))
                if: l2_rw_machine != 0
                    l2_m_why[i]: l2_msg_copy("retained machine operation has no interpreted implementation")
                ---
                if: source != 0
                    source\width: l2_m_head(i) + made + one
                ---
            if: bad != 0
                return: l2_said_or(l2_src, l2_m_node[i], d0, "internal: a source method occurrence has no graph producer")
            ---
            l2_rw_cache_on: 0
            l2_rw_quiet: 0
            l2_rw_mi: l2_e
            l2_cur_mi: saved_cur
            l2_vis_on: 0
        # Interpreter eligibility records a capability reason, not permission
        # to skip source construction or overwrite a real machine occurrence.
        if: l2_library_mode = 0 && l2_pap_on(i) = 0 && l2_rw_may(i) = 0 && l2_m_why[i] = 0 && l2_m_node[i] != 0 && l2_m_node[i]\span != 0
            l2_m_why[i]: l2_msg_copy(l2_rw_may_why(i))
            l2_m_why_line[i]: l2_m_node[i]\span\line
            l2_m_why_col[i]: l2_m_node[i]\span\column
        ---
        # A still-unbuilt callable-result producer is diagnosed at its own
        # declaration under --walk-methods. A callable formal is not a ban:
        # COUNT has already measured its actual formation/EXEC capability.
        if: l2_walk_methods != 0 && l2_library_mode = 0 && l2_pap_on(i) = 0 && l2_rw_may(i) = 0 && l2_rw_callable_excluded(i) != 0
            return: l2_error(l2_src, l2_m_node[i], "a callable result is outside the walkable subset (--walk-methods)")
        # REVIEW c953b22: a callable-merge host the knob does not walk stays native, where its
        # return and its calls of the model are built -- said in a note, not only visible in the L1:
        # located at the first refusal of its walk, or at the host when it was kept out before.
        if: l2_walk_methods != 0 && l2_library_mode = 0 && l2_pap_on(i) = 0 && l2_mad_on(i) != 0 && l2_t7_host_site(i) < 0 && (l2_m_steps[i] < 0 || l2_m_walkable[i] = 0)
            if: l2_rw_quiet_msg = 0
                l2_rw_quiet_msg: l2_msg_copy(l2_m_why[i])
                if: l2_m_node[i] != 0 && l2_m_node[i]\span != 0
                    l2_rw_quiet_line: l2_m_node[i]\span\line
                    l2_rw_quiet_col: l2_m_node[i]\span\column
                ---
            ---
            c.fprintf(l1_stderr(), "l2trans note: %s:%zu:%zu: the callable merge host %.*s stays native under --walk-methods: %s\n", l2_src, l2_rw_quiet_line, l2_rw_quiet_col, (cast: (int) l2_m_name[i]\length), l2_m_name[i]\data, l2_msg_text(l2_rw_quiet_msg))
        ---
        i: i + 1
    ---
    if: l2_t7_count() != 0
        return: 1
return: 0

# The emission of every method's frames, into its occurrence (a node temp, l2_rw<t>), from slot
# l2_m_kids(i): the same steps the count pass made.
fn: l2_rw_methods_emit (int: phase) int
    int: i 0
    int: saved_cur l2_cur_mi
    int: t
    int: made
    int: one
    int: bad
    int: src
    int: tslot
    @: L2SourceContainer source
    if: phase = 2 && l2_fill_inert() != 0
        return: 1
    while: i < l2_m_n
        source: l2_source_root(i)
        if: l2_m_steps[i] > 0 || source != 0
            l2_construct_begin(0, i, phase)
            if: l2_rw_bseq_zero() != 0
                return: l2_error(l2_src, 0, "out of memory")
            l2_vis_method(i)
            l2_rw_mi: i
            l2_cur_mi: i
            l2_rw_emit: (cast: (int) (phase = 2))
            t: l2_rw_t
            l2_rw_t: l2_rw_t + 1
            made: 0
            one: 0
            bad: 0
            src: i
            if: l2_pap_on(i) != 0
                src: l2_pap_model[i]
            ---
            l2_here_source_mi: src
            l2_ml_free()
            if: l2_m_body[src] != 0 && l2_m_body[src]\as != 0 && l2_m_body[src]\as\structure != 0 && l2_ml_collect(l2_m_body[src]\as\structure, src, l2_src) != 0
                bad: 1
            if: l2_construct_temp(t, -1, 1) != 0
                bad: 1
            if: source != 0
                source\temp: t
                if: phase = 2 && l2_source_fill(source) != 0
                    bad: 1
                ---
            ---
            if: bad = 0 && phase = 2
                if: c.fprintf(l2_out, "        @: Lmx l2_rw%d ", t) < 0 || l2_emit_build_occ(i) != 0 || c.fprintf(l2_out, "\n        if: l2_rw%d = 0\n            return: 1\n", t) < 0
                    bad: 1
                ---
            # §7b: a walked method's body has working values (the walker loads them at entry from its own nodes); a
            # merge result's frames -- its model's, counted by l2_pap_steps -- read and write the graph.
            if: l2_pap_on(i) = 0
                l2_rw_cache_on: 1
            if: source != 0
                if: bad = 0 && l2_rw_stmts(source\body\first_field, t, l2_m_kids(i), source, @ made) != 0
                    bad: 1
                ---
            else:
                if: bad = 0 && l2_m_body[src] != 0 && l2_m_body[src]\as != 0 && l2_m_body[src]\as\structure != 0 && l2_rw_stmts(l2_m_body[src]\as\structure\first_field, t, l2_m_kids(i), source, @ made) != 0
                    bad: 1
                ---
            ---
            tslot: l2_m_kids(i) + made
            if: source = 0 && l2_m_src_end != 0 && i >= 0 && i < l2_m_n && l2_m_src_end[i] >= 0
                tslot: l2_m_src_end[i]
                if: l2_m_trail != 0 && l2_m_trail[i] != 0
                    tslot: l2_m_src_end[i] - 1
            ---
            if: bad = 0 && l2_rw_trailer(src, t, tslot, @ one) != 0
                bad: 1
            l2_rw_cache_on: 0
            l2_rw_emit: 0
            l2_rw_mi: l2_e
            l2_cur_mi: saved_cur
            l2_vis_on: 0
            if: bad != 0
                return: 1
            if: made + one != l2_m_steps[i]
                return: l2_error(l2_src, l2_m_node[i], "internal: a method's steps changed between the passes")
            if: l2_source_fills_verify() != 0
                return: 1
        ---
        i: i + 1
    ---
    if: phase = 1 && l2_t7_emit_frames(phase) != 0
        return: 1
    l2_construct_phase: -1
    l2_construct_view_index: -1
return: 0

# A method the walk does not build still names its if or while shell through the operator.
# The shell already exists. Hang it at child 0 of a one-child body, child 2 of the operator,
# and store that operator at the statement's slot.
fn: l2_emit_shell_anchor () int
    int: k 0
    int: at
    int: mi
    int: ej
    int: j
    int: wide
    const: @(char op)
    while: k < l2_for_n
        mi: l2_for_owner(k)
        if: l2_for_uchild[k] = 0 - 2 && mi >= 0 && l2_source_root(mi) = 0 && (l2_m_steps = 0 || l2_m_steps[mi] <= 0)
            at: l2_ps_lookup(l2_for_stmt[k])
            if: at < 0
                return: 1
            op: "LMX_WALK_OP_IF"
            if: l2_frame_head(l2_for_stmt[k], "while") != 0
                op: "LMX_WALK_OP_WHILE"
            ej: 0 - 1
            j: 0
            while: j < l2_for_n
                if: l2_frame_head(l2_for_stmt[j], "else") != 0 && l2_for_owner(j) = mi && l2_for_parent[j] = l2_for_parent[k] && l2_ps_lookup(l2_for_stmt[j]) = at + 1
                    ej: j
                    j: l2_for_n
                j: j + 1
            ---
            wide: 3
            if: ej >= 0
                wide: 4
            if: fputs("        l2_entry_leaf: ", l2_out) < 0 || l2_emit_build_occ(mi) != 0 || c.fprintf(l2_out, "\n        if: l2_entry_leaf = 0\n            return: 1\n        l2_fkid: lmx_walk_frame(l2_program_arena, l2_rw_roles, l2_entry_leaf, c.%s, %uU)\n        if: l2_fkid = 0\n            return: 1\n        l2_pst: lmx_walk_plain(l2_program_arena, l2_fkid, 1U)\n        if: l2_pst = 0\n            return: 1\n        if: lmx_arena_ref_store(l2_pst, 0U, (cast: (@: void) l2_b%d)) != 0\n            return: 1\n        if: lmx_arena_ref_store(l2_fkid, 2U, (cast: (@: void) l2_pst)) != 0\n            return: 1\n", op, (cast: (unsigned) wide), k) < 0
                return: 1
            if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_entry_leaf, %uU, (cast: (@: void) l2_fkid)) != 0\n            return: 1\n", (cast: (unsigned) at)) < 0
                return: 1
            if: ej >= 0
                if: c.fprintf(l2_out, "        @: Lmx l2_shell_else%d lmx_walk_frame(l2_program_arena, l2_rw_roles, l2_entry_leaf, c.LMX_WALK_OP_ELSE, 2U)\n        if: l2_shell_else%d = 0\n            return: 1\n        if: lmx_arena_ref_store(l2_entry_leaf, %uU, (cast: (@: void) l2_shell_else%d)) != 0 || lmx_arena_ref_store(l2_fkid, 3U, (cast: (@: void) l2_shell_else%d)) != 0\n            return: 1\n", ej, ej, (cast: (unsigned) (at + 1)), ej, ej) < 0
                    return: 1
                if: l2_for_uchild[ej] = 0 - 3
                    if: c.fprintf(l2_out, "        l2_pst: lmx_walk_plain(l2_program_arena, l2_shell_else%d, 1U)\n        if: l2_pst = 0\n            return: 1\n        if: lmx_arena_ref_store(l2_pst, 0U, (cast: (@: void) l2_b%d)) != 0\n            return: 1\n", ej, ej) < 0
                        return: 1
                    ---
                else:
                    if: c.fprintf(l2_out, "        l2_pst: lmx_walk_plain(l2_program_arena, l2_shell_else%d, 0U)\n        if: l2_pst = 0\n            return: 1\n", ej) < 0
                        return: 1
                    ---
                ---
                if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_shell_else%d, 1U, (cast: (@: void) l2_pst)) != 0\n            return: 1\n", ej) < 0
                    return: 1
                ---
            ---
            ---
        k: k + 1
    ---
return: 0

# The children of method mi's occurrence: its header parts, fields and control bodies (l2_m_kids),
# then its frames (-193 T4a). T7 frame packs sit after that walked region.
fn: l2_m_width (int: mi) int
    int: n
    @: L2SourceContainer source l2_source_root(mi)
    if: source != 0
        return: source\width
    if: l2_m_src_end != 0 && mi >= 0 && mi < l2_m_n && l2_m_src_end[mi] >= 0
        n: l2_m_src_end[mi]
    else:
        n: l2_m_kids(mi)
        if: l2_m_steps != 0 && mi >= 0 && mi < l2_m_n && l2_m_steps[mi] > 0
            n: n + l2_m_steps[mi]
        ---
return: n

# Public C/L1 adapter signature for a source method. The fixed lexical space
# above the method and selected occurrence remain internal ABI arguments and
# are therefore omitted.
fn: l2_emit_public_sig (int: mi) int
    int: j 0
    int: ty
    int: oty
    int: rt l2_sig_ret(mi)
    const: @(char sep) ""
    if: fputs(" (", l2_out) < 0
        return: 1
    while: j < l2_m_arity[mi]
        ty: l2_ft(mi, j)
        # D-101: a declared graph formal holds the graph code, spelled as l2_emit_formal spells it
        # (l2_formal_raw); read raw, l2_emit_foreign_named got an index past its table
        # and the translation failed with no located diagnostic.  The result goes through
        # l2_sig_ret for the same reason (-137 part 2).
        ty: l2_formal_raw(ty)
        if: j != 0
            sep: "; "
        if: ty = 0 && c.fprintf(l2_out, "%sint: ", sep) < 0
            return: 1
        if: ty = 1 && c.fprintf(l2_out, "%schar: ", sep) < 0
            return: 1
        if: ty = 2 && c.fprintf(l2_out, "%ssize_t: ", sep) < 0
            return: 1
        if: ty = 34 && c.fprintf(l2_out, "%sunsigned: ", sep) < 0
            return: 1
        if: ty = 36 && c.fprintf(l2_out, "%sulong: ", sep) < 0
            return: 1
        if: ty = 3 && c.fprintf(l2_out, "%sconst: @(char ", sep) < 0
            return: 1
        if: ty = 9 && c.fprintf(l2_out, "%s@: size_t ", sep) < 0
            return: 1
        if: ty = 11 && c.fprintf(l2_out, "%s@: int ", sep) < 0
            return: 1
        if: ty = 12 && c.fprintf(l2_out, "%s@: char ", sep) < 0
            return: 1
        if: ty = 16 && c.fprintf(l2_out, "%s@: void ", sep) < 0
            return: 1
        if: ty = 17 && c.fprintf(l2_out, "%s@@: char ", sep) < 0
            return: 1
        if: ty = 18 && c.fprintf(l2_out, "%s@@: void ", sep) < 0
            return: 1
        if: ty = 19 && c.fprintf(l2_out, "%s@@: int ", sep) < 0
            return: 1
        if: ty = 20 && c.fprintf(l2_out, "%s@@: size_t ", sep) < 0
            return: 1
        if: ty = 24 && c.fprintf(l2_out, "%s@@: unsigned ", sep) < 0
            return: 1
        if: ty = 39 && c.fprintf(l2_out, "%s@@: ulong ", sep) < 0
            return: 1
        if: ty = 25 && c.fprintf(l2_out, "%s@: unsigned ", sep) < 0
            return: 1
        if: ty = 38 && c.fprintf(l2_out, "%s@: ulong ", sep) < 0
            return: 1
        if: ty >= 100
            if: l2_emit_foreign_named(l2_out, ty, sep, l2_fn(mi, j)) != 0
                return: 1
            ---
        else:
            if: ty != 0 && ty != 1 && ty != 2 && ty != 3 && ty != 9 && ty != 11 && ty != 12 && ty != 16 && ty != 17 && ty != 18 && ty != 19 && ty != 20 && ty != 24 && ty != 25 && ty != 34 && ty != 36 && ty != 38 && ty != 39
                c.fprintf(l1_stderr(), "l2trans: a library signature cannot spell formal type %d\n", ty)
                return: 1
            if: l2_write_text(l2_out, l2_fn(mi, j)) != 0
                return: 1
            if: ty = 3 && fputs(")", l2_out) < 0
                return: 1
        ---
        j: j + 1
    ---
    if: rt = 2 && fputs(") size_t", l2_out) < 0
        return: 1
    if: rt = 33 && fputs(") unsigned", l2_out) < 0
        return: 1
    if: rt = 36 && fputs(") ulong", l2_out) < 0
        return: 1
    if: rt = 3 && fputs(") @: char", l2_out) < 0
        return: 1
    if: rt = 16 && fputs(") @: void", l2_out) < 0
        return: 1
    if: rt = 35 && fputs(") const: @(char)", l2_out) < 0
        return: 1
    if: rt = 32 && fputs(") @@: char", l2_out) < 0
        return: 1
    if: rt >= 100 && l2_emit_foreign_return(l2_out, rt) != 0
        return: 1
    if: rt = 8 && fputs(")", l2_out) < 0
        return: 1
    if: l2_ret_uns(mi) = 0 && rt != 3 && rt != 8 && rt != 16 && rt != 32 && rt != 35 && rt < 100 && fputs(") int", l2_out) < 0
        return: 1
return: 0

fn: l2_emit_library_wrappers () int
    int: i 0
    int: j
    if: c.fprintf(l2_out, "\n@: LmxMsg l2_library_message 0\n@: Lmx l2_library_unit 0\nint: l2_library_opened 0\n\nfn: l2_library_open () int\n    LmxRoot: l2_library_root\n    if: l2_library_opened != 0\n        return: 0\n    memset((cast: (@: void) (@ l2_library_root)), 0, c.sizeof(c.LmxRoot))\n    if: lmx_root_open(@ l2_library_root, l2_program_entry, 5000U) != c.LMX_ROOT_OK\n        return: 1\n    l2_program_arena: lmx_root_arena(@ l2_library_root)\n    if: l2_program_arena = 0\n        lmx_root_close(@ l2_library_root)\n        return: 1\n    if: lmx_root_turn(@ l2_library_root, lmx_clock_ticks()) != c.LMX_ROOT_OK\n        lmx_root_close(@ l2_library_root)\n        return: 1\n    l2_library_message: lmx_root_message(@ l2_library_root)\n    if: l2_library_message = 0\n        lmx_root_close(@ l2_library_root)\n        return: 1\n    # TODO(kernel): no act returning the program-unit Lmx from root/message (see lmx_root.h.lm1 / lmx_message.h.lm1).\n    # Need approved act for l2_library_unit; also need persistent LmxRoot storage (by-value aggregate is illegal at module scope — currently local, so open cannot stay open across calls).\n    l2_library_unit: 0\n    if: l2_library_unit = 0\n        lmx_root_close(@ l2_library_root)\n        l2_library_message: 0\n        return: 1\n    l2_library_opened: 1\n    return: 0\n\n") < 0
        return: 1
    while: i < l2_m_n
        if: fputs("external:\n", l2_out) < 0
            return: 1
        if: l2_m_ret[i] = 8 && fputs("    sub: ", l2_out) < 0
            return: 1
        if: l2_m_ret[i] != 8 && fputs("    fn: ", l2_out) < 0
            return: 1
        if: l2_write_text(l2_out, l2_m_name[i]) != 0 || l2_emit_public_sig(i) != 0 || fputs("\n", l2_out) < 0
            return: 1
        if: fputs("        if: l2_library_open() != 0\n", l2_out) < 0
            return: 1
        # A failed open is reported on every call and then follows the abort
        # policy, exactly as a failed own-field store does; it is never
        # a silent zero.
        if: c.fprintf(l2_out, "            c.fprintf(c.stderr, \"lmx: library open failed: l2_u%08X%08X ", l2_module_hash_a, l2_module_hash_b) < 0 || l2_write_text(l2_out, l2_m_name[i]) != 0
            return: 1
        if: fputs("\\n\")\n            if: lmx_msg_poll_abort() != 0\n                c.abort()\n", l2_out) < 0
            return: 1
        if: l2_m_ret[i] = 8 && fputs("            return\n        ", l2_out) < 0
            return: 1
        if: l2_m_ret[i] = 2 && fputs("            return: 0U\n        return: ", l2_out) < 0
            return: 1
        if: l2_m_ret[i] != 2 && l2_m_ret[i] != 8 && fputs("            return: 0\n        return: ", l2_out) < 0
            return: 1
        if: l2_m_ret[i] = 8 && fputs("", l2_out) < 0
            return: 1
        if: l2_write_sym(l2_out, i) != 0 || c.fprintf(l2_out, "(l2_library_unit, lmx_arena_ref_struct(l2_library_unit, %uU)", (cast: (unsigned) (l2_occ_slot(i)))) < 0
            return: 1
        j: 0
        while: j < l2_m_arity[i]
            if: fputs(", ", l2_out) < 0 || l2_write_text(l2_out, l2_fn(i, j)) != 0
                return: 1
            j: j + 1
        if: fputs(")\n", l2_out) < 0
            return: 1
        if: fputs("end: external\n\n", l2_out) < 0
            return: 1
        i: i + 1
return: 0

fn: l2_has_own_ty (int: ty) int
    int: i 0
    while: i < l2_own_n
        if: l2_own_ty[i] = ty
            return: 1
        i: i + 1
return: 0

fn: l2_has_pointer_array () int
    int: i 0
    while: i < l2_own_n
        if: l2_oc_is_parray(l2_own_ty[i]) != 0
            return: 1
        i: i + 1
return: 0

fn: l2_emit_poll (int: mi; const: @(char ind)) int
    @: char deep 0
    if: ind = 0 || l2_profile_runtime != 0
        return: 0
    if: c.fprintf(l2_out, "%sif: lmx_msg_poll_escape() != 0\n", ind) < 0 || l2_bump_ind(ind, @ deep) != 0
        return: 1
    # §7b: the stop is an exit (book §12, Lingvamyxa spec 21.6: stop and cancellation) -- what is marked is published
    # on the way out, and only there: the poll itself is no boundary.
    if: l2_emit_publish(deep) != 0
        return: 1
    if: l2_m_ret[mi] = 8
        return: l2_emit_empty_return(mi, deep)
    if: c.fprintf(l2_out, "%sreturn: 0\n", deep) < 0
        return: 1
return: 0

# THE TYPE DESCRIPTOR OF AN OWN STORE.  What a store does with an own field depends on its type in
# exactly three ways, and they are answered here and nowhere else: which kernel operation puts a
# value into the field's cell, whether that operation REBINDS the cell (char) or stores into it,
# and how the value is spelled as that operation's argument.  0 from the first
# means the graph has no cell for the type -- an error of the program, not a type to skip.
fn: l2_own_store_helper (int: ty) @: char
    if: ty = 0
        return: "lmx_int_store_known"
    if: ty = 1
        return: "lmx_char_store_known"
    if: ty = 2
        return: "lmx_size_store_known"
    if: ty = 3
        return: "lmx_unsigned_store_known"
    if: ty = 36
        return: "lmx_ulong_store_known"
    if: l2_own_is_pointer(ty) != 0
        return: "lmx_pointer_store_known"
return: 0

fn: l2_emit_path_load (int: mi; int: oi; const: @(char ind); @: L2Tx dest) int
    int: t
    int: fid
    @: char deep 0
    []: char expr_own 128
    L2Tx: expr_tx
    @: L2Tx l2_epl_expr l2_tx_local(@ expr_tx, expr_own, 128U)
    if: dest = 0 || oi < 0 || ind = 0 || l2_epl_expr = 0
        return: 1
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    fid: l2_own_fid[oi]
    if: fid < 0 && l2_own_uchild[oi] < 0
        return: 1
    if: l2_own_from_expr(oi, l2_epl_expr) != 0
        return: 1
    if: c.fprintf(l2_out, "%sl2_xp: %s\n", ind, l2_epl_expr\data) < 0
        return: 1
    if: c.fprintf(l2_out, "%sif: l2_xp = 0\n", ind) < 0
        return: 1
    # A missing cell of a bound own field is a broken promise (D-05): X1, not a return of 0.
    if: l2_emit_invariant(ind, "an own field has no cell to load") != 0
        return: 1
    t: l2_tn
    l2_tn: l2_tn + 1
    if: l2_emit_own_cell_load(oi, ind, t, l2_own_decl[oi]) != 0
        return: 1
return: l2_tx_temp(dest, t)

fn: l2_index_tail (@: LmP0Field f; @@: LmP0Field out_idx; @@: LmP0Field out_after) int
    @: LmP0Field p1
    @: LmP0Field p2
    @: LmP0Field p3
    if: out_idx = 0 || out_after = 0
        return: 1
    \out_idx: 0
    \out_after: 0
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
        return: 1
    if: l2_ident(f\value\as\atom) = 0
        return: 1
    p1: l2_next_active(f\next)
    if: p1 = 0 || p1\value = 0 || p1\value\kind != c.LM_P0_NODE_ATOM || p1\value\as = 0
        return: 1
    if: l2_text_eq(p1\value\as\atom, "[") = 0
        return: 1
    p2: l2_next_active(p1\next)
    if: p2 = 0 || p2\value = 0
        return: 1
    p3: l2_next_active(p2\next)
    if: p3 = 0 || p3\value = 0 || p3\value\kind != c.LM_P0_NODE_ATOM || p3\value\as = 0
        return: 1
    if: l2_text_eq(p3\value\as\atom, "]") = 0
        return: 1
    \out_idx: p2
    \out_after: l2_next_active(p3\next)
return: 0

# THE TEMPORARY RULE (FABLE-L2-R0-WRITE-GUARD-DESIGN-20260921-111).  An address taken with `@` is a WRITABLE
# address, and nothing downstream can refuse a write through it: a raw pointer write bypasses every cell
# helper.  So until a read-only address exists as a type, the address of a field of an
# `independent: const: immutable` branch is refused where it is TAKEN, by name, by the same test that
# refuses a path write to it (l2_path_in_eternal) -- no type is asked.  It used to pass the translator and
# die at the C compiler for want of a lowering, and a missing declaration is never protection.
fn: l2_addr_names_eternal (@: LmP0Field name; @: LmP0Field fld) int
    size_t: a
    size_t: b
    @: char pd
    if: name = 0 || fld = 0 || name\value = 0 || fld\value = 0 || name\value\kind != c.LM_P0_NODE_ATOM || fld\value\kind != c.LM_P0_NODE_ATOM
        return: 0
    if: name\value\as = 0 || fld\value\as = 0 || name\value\as\atom = 0 || fld\value\as\atom = 0
        return: 0
    a: name\value\as\atom\length
    b: fld\value\as\atom\length
    if: a = 0U || b = 0U
        return: 0
    # Names of any length (l2_text_room).
    pd: l2_text_room(a + b + 2U, l2_addr_path, 1024U)
    if: pd = 0
        return: l2_alloc_or(l2_src, 0, "out of memory")
    memcpy((cast: (@: void) pd), (cast: (@: void) name\value\as\atom\data), a)
    pd[a]: 92
    memcpy((cast: (@: void) (pd + a + 1U)), (cast: (@: void) fld\value\as\atom\data), b)
return: l2_path_in_eternal(pd, a + b + 1U)

# The flat spelling: `@`, a name, `\`, a field, as four fields of an argument list.
fn: l2_addr_flat_eternal (@: LmP0Field at) int
    @: LmP0Field name
    @: LmP0Field sep
    if: at = 0
        return: 0
    name: l2_next_active(at\next)
    if: name = 0
        return: 0
    sep: l2_next_active(name\next)
    if: sep = 0 || sep\value = 0 || sep\value\kind != c.LM_P0_NODE_ATOM || l2_is_slash(sep\value\as\atom) = 0
        return: 0
return: l2_addr_names_eternal(name, l2_next_active(sep\next))

fn: l2_addr_tail (@: LmP0Field f; @@: LmP0Field out_name; @@: LmP0Field out_after) int
    @: LmP0Field p1
    @: LmP0Field p2
    if: out_name = 0 || out_after = 0
        return: 1
    \out_name: 0
    \out_after: 0
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0
        return: 1
    if: l2_text_eq(f\value\as\atom, "@") = 0
        return: 1
    p1: l2_next_active(f\next)
    if: p1 = 0 || p1\value = 0 || p1\value\kind != c.LM_P0_NODE_ATOM || p1\value\as = 0
        return: 1
    if: l2_ident(p1\value\as\atom) = 0
        return: 1
    # In `@ value\field`, address-taking covers the complete postfix path.
    # Do not consume only `@ value` and strand the following separator.
    p2: l2_next_active(p1\next)
    if: p2 != 0 && p2\value != 0 && p2\value\kind = c.LM_P0_NODE_ATOM && (l2_is_slash(p2\value\as\atom) || l2_text_eq(p2\value\as\atom, "["))
        return: 1
    \out_name: p1
    \out_after: p2
return: 0

fn: l2_ccall_box_int (const: @(LmP0Node node); int: mi) int
    int: ei
    int: fi
    int: oi
    int: si
    int: ty
    if: node = 0 || node\kind != c.LM_P0_NODE_ATOM || node\as = 0 || node\as\atom = 0
        return: 0
    if: l2_quoted(node\as\atom) != 0
        return: 0
    if: l2_num(node\as\atom)
        return: 0
    if: node\as\atom\length >= 2U && node\as\atom\data[0] = 99 && node\as\atom\data[1] = 46
        return: 0
    ei: l2_ml_find(node\as\atom)
    if: ei >= 0
        ty: l2_ml_ty[ei]
        if: ty = 0 || ty = 1
            return: 1
        return: 0
    ---
    fi: l2_param_find(mi, node\as\atom)
    if: fi >= 0
        ty: l2_param_ty(mi, node\as\atom)
        if: ty = 0 || ty = 1
            return: 1
        return: 0
    oi: l2_own_visible(mi, node\as\atom)
    if: oi >= 0
        ty: l2_own_ty[oi]
        if: ty = 0 || ty = 1
            return: 1
        return: 0
    si: l2_slot_find(mi, node\as\atom)
    if: si >= 0
        ty: l2_st[l2_slot_off(mi, si)]
        if: ty = 0 || ty = 1
            return: 1
        return: 0
    ---
    # A `define:` constant (l2_define_name) is passed as itself (D-68): it holds no L2 value to
    # stage, and an `int` temporary cut a char* define to 32 bits -- the b5 mixa crash
    # unit_define_actual was written for, back until this.  Its type is C's, checked against
    # the callee's prototype, as `c.NAME`'s is.
    if: l2_define_name(node\as\atom) != 0
        return: 0
return: 1

fn: l2_emit_ccall (const: @(LmP0Node stmt); int: mi; const: @(char ind)) int
    L2IndexedOperand: indexed_value
    @: L2IndexedOperand indexed @ indexed_value
    @: LmP0Field f
    int: n
    int: i
    int: span
    int: hj
    int: hf
    size_t: root_len
    size_t: suffix_len
    int: first 1
    []: char buf_own 1024
    []: char piece_own 1024
    L2Tx: buf_tx
    L2Tx: piece_tx
    @: L2Tx buf @ buf_tx
    @: L2Tx piece @ piece_tx
    # The boxed-actual temporary name. l2_tok may be the caller's destination.
    []: char boxt_own 64
    L2Tx: boxt_tx
    @: L2Tx boxt @ boxt_tx
    # The value destination of THIS call; a nested C call in an actual
    # takes and clears its own.
    @: L2Tx into_buf
    into_buf: l2_ccall_into
    l2_ccall_into: 0
    if: stmt = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || l2_tx_open(buf, buf_own, 1024U) != 0 || l2_tx_open(piece, piece_own, 1024U) != 0
        return: 1
    hj: -1
    hf: l2_raw_head(stmt\as\frame\head, mi, @ hj)
    if: hf = 0
        if: l2_emit_raw_path(stmt\as\frame\head\data, stmt\as\frame\head\length, mi, ind, buf) != 0
            return: 1
    ---
    else:
        if: l2_tok_tx(buf, stmt\as\frame\head) != 0
            return: l2_alloc_or(l2_src, stmt, "out of memory")
    ---
    if: l2_tx_cat(buf, "(") != 0
        return: l2_alloc_or(l2_src, stmt, "out of memory")
    # A call with no arguments has no body, or an empty one.
    n: 0
    f: 0
    if: stmt\as\frame\body != 0
        n: l2_count_active(stmt\as\frame\body)
        f: l2_next_active(stmt\as\frame\body\first_field)
    i: 0
    while: i < n && f != 0 && f\value != 0
        span: l2_expr_span(f)
        if: span < 1 || span > n - i
            return: 1
        if: span > 1
            if: l2_eval_fields(f, span, mi, ind, piece) != 0
                return: 1
            if: first = 0 && l2_tx_cat(buf, ", ") != 0
                return: l2_alloc_or(l2_src, stmt, "out of memory")
            if: l2_tx_cat(buf, piece\data) != 0
                return: l2_alloc_or(l2_src, stmt, "out of memory")
            first: 0
            i: i + span
            f: l2_advance(f, span)
            continue
        if: l2_indexed_operand(f, n - i, mi, indexed) = 0
            if: first = 0 && l2_tx_cat(buf, ", ") != 0
                return: l2_alloc_or(l2_src, stmt, "out of memory")
            if: l2_emit_indexed(indexed, mi, ind, piece) != 0
                return: 1
            if: l2_tx_cat(buf, piece\data) != 0
                return: l2_alloc_or(l2_src, stmt, "out of memory")
            first: 0
            i: i + indexed\count
            f: indexed\after
            continue
        l2_tx_clear(piece)
        if: l2_prep(f\value, mi, ind, piece) != 0
            return: 1
        if: l2_ccall_box_int(f\value, mi) != 0 && (l2_tx_open(boxt, boxt_own, 64U) != 0 || l2_new_temp(ind, boxt) != 0)
            return: 1
        if: l2_ccall_box_int(f\value, mi) != 0 && c.fprintf(l2_out, "%s%s: %s\n", ind, boxt\data, piece\data) < 0
            return: 1
        if: l2_ccall_box_int(f\value, mi) != 0 && l2_tx_set(piece, boxt\data) != 0
            return: l2_alloc_or(l2_src, stmt, "out of memory")
        if: first = 0 && l2_tx_cat(buf, ", ") != 0
            return: l2_alloc_or(l2_src, stmt, "out of memory")
        if: l2_tx_cat(buf, piece\data) != 0
            return: l2_alloc_or(l2_src, stmt, "out of memory")
        first: 0
        i: i + 1
        f: l2_next_active(f\next)
    if: l2_tx_cat(buf, ")") != 0
        return: l2_alloc_or(l2_src, stmt, "out of memory")
    # §7b: a c.* call is a foreign boundary (book §12; Lingvamyxa spec 21.6: an uncertain external call is one) -- its
    # actuals are spelled above, so what is marked is published before the statement that calls it.
    if: l2_emit_publish(ind) != 0
        return: 1
    if: into_buf != 0
        if: l2_tx_set(into_buf, buf\data) != 0
            return: l2_alloc_or(l2_src, stmt, "out of memory")
        return: 0
    ---
    if: c.fprintf(l2_out, "%s%s\n", ind, buf\data) < 0
        return: 1
return: 0

# Step one actual forward: span fields from here.
fn: l2_skip_span (@: LmP0Field a; int: span) @: LmP0Field
    int: i 0
    while: i < span && a != 0
        a: l2_next_active(a\next)
        i: i + 1
    ---
return: a

# The call through a function-pointer local: head(actual, actual). Each actual
# may itself be a field read, so the actuals are walked by span rather than by
# field.
fn: l2_emit_fnptr_call (const: @(LmP0Node stmt); int: mi; const: @(char ind)) int
    const: @: LmP0Frame fr
    @: LmP0Field a
    int: span
    int: first 1
    []: char buf_own 1024
    L2Tx: buf_tx
    @: L2Tx buf @ buf_tx
    []: char piece_own 1024
    L2Tx: piece_tx
    @: L2Tx piece @ piece_tx
    if: stmt = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || l2_tx_open(buf, buf_own, 1024U) != 0 || l2_tx_open(piece, piece_own, 1024U) != 0
        return: 1
    fr: stmt\as\frame
    if: fr\body != 0
        a: l2_next_active(fr\body\first_field)
        while: a != 0
            span: l2_expr_span(a)
            if: span < 1
                return: 1
            if: l2_emit_fields(a, span, mi, ind, piece) != 0
                return: 1
            if: first = 0 && l2_tx_cat(buf, ", ") != 0
                return: l2_alloc_or(l2_src, stmt, "out of memory")
            if: l2_tx_cat(buf, piece\data) != 0
                return: l2_alloc_or(l2_src, stmt, "out of memory")
            first: 0
            a: l2_skip_span(a, span)
        ---
    ---
    # §7b: a call through a function pointer is an uncertain external call (Lingvamyxa spec 21.6): publish first.
    if: l2_emit_publish(ind) != 0
        return: 1
    if: c.fprintf(l2_out, "%s", ind) < 0
        return: 1
    if: l2_write_text(l2_out, fr\head) != 0
        return: 1
    if: c.fprintf(l2_out, "(%s)\n", buf\data) < 0
        return: 1
return: 0

# Evaluate once into the receiving machine pointer before referent admission.
# The temporary is activation storage, not a new graph or binding.
fn: l2_emit_receiving_admit (int: ty; int: model; int: mi; const: @(char ind); @: L2Tx value; @: L2ReferenceSource source; int: place) int
    int: t
    []: char type_text_own 1024
    L2Tx: type_text_tx
    @: L2Tx type_text l2_tx_local(@ type_text_tx, type_text_own, 1024U)
    []: char temp 128
    if: model < 0
        return: 0
    t: l2_tn
    l2_tn: l2_tn + 1
    if: c.sprintf(temp, "l2_t%d", t) < 0 || l2_pointer_decl_text(l2_formal_raw(ty), 0, temp, type_text) != 0 || c.fprintf(l2_out, "%s%s %s\n", ind, type_text\data, value\data) < 0
        return: 1
    if: source != 0 && l2_emit_model_admit(mi, model, source, temp, ind, 1, 1, place, -1, -1, -1) != 0
        return: 1
    if: source = 0 && l2_emit_admit(mi, model, temp, ind) != 0
        return: 1
return: l2_tx_set(value, temp)

fn: l2_emit_reference_value (@: LmP0Field first; int: n; int: ty; int: model; int: mi; const: @(char ind); @: L2Tx value) int
return: l2_emit_reference_value_at(first, n, ty, model, mi, ind, value, -1)

# The same, received into own row `place` of the method (-1: no such place): the
# instruction then carries the coverage of that place when it is known.
fn: l2_emit_reference_value_at (@: LmP0Field first; int: n; int: ty; int: model; int: mi; const: @(char ind); @: L2Tx value; int: place) int
    L2Address: descriptor_value
    @: L2Address descriptor @ descriptor_value
    L2ReferenceSource: source
    l2_reference_fields(@ first, @ n)
    l2_reference_source(first, n, mi, @ source)
    if: n = 0
        return: l2_tx_set(value, "0")
    if: l2_reference_descriptor(first, n, mi, descriptor) = 0
        if: l2_emit_address(mi, descriptor, ind, value) != 0
            return: 1
    ---
    else:
        if: l2_eval_fields(first, n, mi, ind, value) != 0
            return: 1
        ---
    ---
    if: model >= 0 && l2_is_letter_value(mi, first, n) != 0 && l2_payload_expr(value) != 0
        return: 1
return: l2_emit_receiving_admit(ty, model, mi, ind, value, @ source, place)

fn: l2_emit_reference_declaration (const: @(LmP0Node stmt); int: mi; const: @(char ind)) int
    @: L2Declaration declaration l2_declaration(stmt)
    int: ty
    []: char name_own 256
    L2Tx: name_tx
    @: L2Tx name l2_tx_local(@ name_tx, name_own, 256U)
    []: char declarator_own 1024
    L2Tx: declarator_tx
    @: L2Tx declarator l2_tx_local(@ declarator_tx, declarator_own, 1024U)
    []: char value_own 1024
    L2Tx: value_tx
    @: L2Tx value @ value_tx
    if: declaration = 0 || l2_tx_open(value, value_own, 1024U) != 0 || l2_contract_formal(declaration\contract, @ ty) != 0 || l2_tok_tx(name, declaration\name) != 0 || l2_pointer_decl_text(ty, 0, name\data, declarator) != 0
        return: 1
    if: l2_emit_reference_value(declaration\candidate, declaration\candidate_count, ty, l2_declaration_model(stmt, 0), mi, ind, value) != 0
        return: 1
return: (cast: (int) (c.fprintf(l2_out, "%s%s %s\n", ind, declarator\data, value\data) < 0))

fn: l2_emit_loc_stmt (const: @(LmP0Node stmt); int: mi; const: @(char ind)) int
    @: L2Declaration declaration
    int: converted
    @: LmP0Text lnm 0
    int: lty 0
    @: LmP0Field initf
    @: LmP0Field last
    const: @: LmP0Frame fr
    if: stmt = 0
        return: 1
    if: (l2_ptr_local_ty(stmt, @ lnm, @ lty) != 0 || l2_ml_find(lnm) < 0) && (l2_const_local_ty(stmt, @ lnm, @ lty) != 0 || l2_ml_find(lnm) < 0) && (l2_fnptr_local(stmt, @ lnm) != 0 || l2_ml_find(lnm) < 0) && (l2_struct_local(stmt, @ lnm) != 0 || l2_ml_find(lnm) < 0) && (stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || l2_ml_find(stmt\as\frame\head) < 0) && (stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || l2_ml_array_head(stmt\as\frame\head) < 0)
        return: 1
    if: stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0
        if: l2_ml_array_head(stmt\as\frame\head) >= 0
            if: c.fprintf(l2_out, "%s", ind) < 0
                return: 2
            if: l2_write_text(l2_out, stmt\as\frame\head) != 0
                return: 2
            if: stmt\as\frame\body = 0 || l2_eval_fields(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), mi, ind, l2_tok) != 0
                return: 2
            if: c.fprintf(l2_out, ": %s\n", l2_tok\data) < 0
                return: 2
            return: 0
        ---
    ---
    if: l2_frame_head(stmt, "immutable")
        if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
            return: 2
        if: c.fprintf(l2_out, "%simmutable:\n", ind) < 0
            return: 2
        initf: l2_next_active(stmt\as\frame\body\first_field)
        while: initf != 0
            if: l2_ptr_local_ty(initf\value, @ lnm, @ lty) != 0
                return: 2
            if: c.fprintf(l2_out, "%s    @: char ", ind) < 0
                return: 2
            if: l2_write_text(l2_out, lnm) != 0
                return: 2
            last: l2_next_active(initf\value\as\frame\body\first_field)
            last: l2_next_active(last\next)
            last: l2_next_active(last\next)
            if: last = 0 || last\value = 0 || l2_prep(last\value, mi, ind, l2_tok) != 0
                return: 2
            if: c.fprintf(l2_out, " %s\n", l2_tok\data) < 0
                return: 2
            initf: l2_next_active(initf\next)
        return: 0
    if: l2_const_local_ty(stmt, @ lnm, @ lty) = 0
        if: l2_emit_reference_declaration(stmt, mi, ind) != 0
            return: 2
        return: 0
    # A call through a function-pointer local, before the assignment path: the
    # head names what is CALLED, not what is assigned to.
    if: stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0 && l2_ml_find(stmt\as\frame\head) >= 0 && l2_ml_ty[l2_ml_find(stmt\as\frame\head)] = 40
        if: l2_emit_fnptr_call(stmt, mi, ind) != 0
            return: 2
        return: 0
    # A function-pointer local: the header names the type, so the emitted
    # declaration spells it exactly as the header does.
    if: l2_fnptr_local(stmt, @ lnm) = 0
        if: c.fprintf(l2_out, "%s", ind) < 0
            return: 2
        if: l2_write_text(l2_out, stmt\as\frame\head) != 0
            return: 2
        if: fputs(": ", l2_out) < 0
            return: 2
        if: l2_write_text(l2_out, lnm) != 0
            return: 2
        if: l2_count_active(stmt\as\frame\body) > 1 && l2_emit_fields(l2_next_active(stmt\as\frame\body\first_field)\next, l2_count_active(stmt\as\frame\body) - 1, mi, ind, l2_tok) != 0
            return: 2
        if: l2_count_active(stmt\as\frame\body) > 1 && c.fprintf(l2_out, " %s", l2_tok\data) < 0
            return: 2
        if: fputs("\n", l2_out) < 0
            return: 2
        return: 0
    if: l2_struct_local(stmt, @ lnm) = 0
        if: c.fprintf(l2_out, "%s", ind) < 0
            return: 2
        if: l2_write_text(l2_out, stmt\as\frame\head) != 0
            return: 2
        if: fputs(": ", l2_out) < 0
            return: 2
        if: l2_write_text(l2_out, lnm) != 0
            return: 2
        if: l2_count_active(stmt\as\frame\body) > 1 && l2_emit_fields(l2_next_active(stmt\as\frame\body\first_field)\next, l2_count_active(stmt\as\frame\body) - 1, mi, ind, l2_tok) != 0
            return: 2
        if: l2_count_active(stmt\as\frame\body) > 1 && c.fprintf(l2_out, " %s", l2_tok\data) < 0
            return: 2
        if: fputs("\n", l2_out) < 0
            return: 2
        return: 0
    if: l2_ptr_local_ty(stmt, @ lnm, @ lty) = 2
        l2_error(0, l2_next_active(stmt\as\frame\body\first_field)\value, "unknown type")
        return: 2
    if: l2_ptr_local_ty(stmt, @ lnm, @ lty) = 0
        if: l2_emit_reference_declaration(stmt, mi, ind) != 0
            return: 2
        return: 0
    if: l2_own_decl_ty(stmt) != 0
        declaration: l2_declaration(stmt)
        lnm: declaration\name
        lty: l2_own_store_ty(l2_own_decl_ty(stmt))
        if: declaration\candidate_count > 0
            converted: l2_emit_init_convert(stmt, declaration\candidate, mi, ind, l2_tok)
            if: converted = 1
                return: 2
            if: converted = 2 && l2_eval_fields(declaration\candidate, declaration\candidate_count, mi, ind, l2_tok) != 0
                return: 2
            ---
        if: lty = 0 && c.fprintf(l2_out, "%sint: ", ind) < 0
            return: 2
        if: lty = 1 && c.fprintf(l2_out, "%schar: ", ind) < 0
            return: 2
        if: lty = 2 && c.fprintf(l2_out, "%ssize_t: ", ind) < 0
            return: 2
        if: lty != 0 && lty != 1 && lty != 2
            return: 2
        if: l2_write_text(l2_out, lnm) != 0
            return: 2
        if: declaration\candidate_count > 0
            if: c.fprintf(l2_out, " %s", l2_tok\data) < 0
                return: 2
        ---
        if: fputs("\n", l2_out) < 0
            return: 2
        return: 0
    if: stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0
        return: 1
    fr: stmt\as\frame
    if: l2_ml_find(fr\head) < 0
        return: 1
    if: fr\body = 0
        return: 2
    if: l2_pointer_depth(l2_ml_ty[l2_ml_find(fr\head)]) > 0
        if: l2_emit_reference_value(fr\body\first_field, l2_count_active(fr\body), l2_ml_ty[l2_ml_find(fr\head)], l2_ml_ns[l2_ml_find(fr\head)], mi, ind, l2_tok) != 0
            return: 2
        if: c.fprintf(l2_out, "%s", ind) < 0 || l2_write_text(l2_out, fr\head) != 0 || c.fprintf(l2_out, ": %s\n", l2_tok\data) < 0
            return: 2
        return: 0
    initf: l2_next_active(fr\body\first_field)
    if: l2_count_active(fr\body) = 1 && initf != 0 && initf\value != 0 && initf\value\kind = c.LM_P0_NODE_FRAME && initf\value\as != 0 && initf\value\as\frame != 0 && l2_is_known(initf\value\as\frame\head)
        l2_ccall_into: l2_tok
        if: l2_emit_ccall(initf\value, mi, ind) != 0
            l2_ccall_into: 0
            return: 2
        ---
    if: l2_count_active(fr\body) != 1 || initf = 0 || initf\value = 0 || initf\value\kind != c.LM_P0_NODE_FRAME || l2_is_known(initf\value\as\frame\head) = 0
        if: l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 2
        ---
    ---
    # A typed reference `@: T r` to a named Structure (D-76) takes its value only after the admission to T -- the
    # native admission (implements, consumer T), a refusal the implicit throw `implements`; a null passes.
    if: l2_ml_ns[l2_ml_find(fr\head)] >= 0 && l2_is_letter_value(mi, fr\body\first_field, l2_count_active(fr\body)) != 0 && l2_payload_expr(l2_tok) != 0
        return: 2
    if: l2_emit_receiving_admit(l2_ml_ty[l2_ml_find(fr\head)], l2_ml_ns[l2_ml_find(fr\head)], mi, ind, l2_tok, 0, -1) != 0
        return: 2
    if: c.fprintf(l2_out, "%s", ind) < 0
        return: 2
    if: l2_write_text(l2_out, fr\head) != 0
        return: 2
    if: c.fprintf(l2_out, ": %s\n", l2_tok\data) < 0
        return: 2
return: 0

    # Widest merge in a body, found before the entry preamble is written, because
# the operand array is a local of that preamble. Recurses through the frames
# that carry nested bodies.
# A merge statement is an outer result-name frame whose single body element is a
# merge frame: R: merge: A B. The statement head is R, not merge. This pass
# finds them before the entry preamble is written, because the operand array and
# the result slots are fixed there.
# Printed tree of R: merge: A with a result body, from printTree:
#
#   frame head="R" body=structure fields=2
#     frame head="merge" body=structure fields=1
#       atom "A"
#     structure fields=1
#       frame head="size_t" ...
#
# The result body is a SIBLING of the merge frame inside R, not a child of it.
# Without a body, R holds the merge frame alone.
fn: l2_merge_frame (const: @(LmP0Node stmt)) @: LmP0Node
    @: LmP0Field f
    int: n
    if: stmt = 0 || stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0
        return: 0
    if: stmt\as\frame\body = 0
        return: 0
    n: l2_count_active(stmt\as\frame\body)
    if: n = 1 || n = 2
        f: l2_next_active(stmt\as\frame\body\first_field)
        if: f != 0 && l2_frame_head(f\value, "merge") != 0
            return: f\value
return: 0

# Inner merge syntax does not determine the outer statement's role. Reuse the
# ordinary head/binding classifier before reserving an own declaration. Once
# reserved, the exact source row preserves that decision across later passes.
fn: l2_merge_declaration (const: @(LmP0Structure body); const: @(LmP0Node stmt); int: mi) @: LmP0Node
    @: LmP0Node mf l2_merge_frame(stmt)
    if: mf = 0 || l2_is_asgn(stmt, mi) = 0
        return: 0
    if: l2_own_find_decl(mi, stmt\as\frame\head, stmt) >= 0
        return: mf
    if: l2_colon_bound_before(body, stmt, mi, stmt\as\frame\head) != 0
        return: 0
return: mf

# The result body fields, or 0 when the form has none.
fn: l2_merge_body (const: @(LmP0Node stmt)) @: LmP0Structure
    @: LmP0Field f
    if: l2_merge_frame(stmt) = 0
        return: 0
    if: l2_count_active(stmt\as\frame\body) != 2
        return: 0
    f: l2_next_active(l2_next_active(stmt\as\frame\body\first_field)\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_STRUCTURE || f\value\as = 0
        return: 0
return: f\value\as\structure

# K03 S7 (Codex K03-UNIFIED-HEAD-IMPLEMENT-20261006-01; docs/LMX_semantics.en.md#composition): the operands of a
# merge are its application's actuals, read as every application's are (l2_actual_count) -- a path, a call, a field,
# a group or an operator expression is one operand, and P0 has already made a sole argument container transparent
# (`merge((A C))` is `merge(A C)`).  A result body is no operand: P0 gives it beside the merge Frame, in the
# statement (l2_merge_body).  -1: a written argument is no expression.  The leading-atom reading this replaces dropped
# every operand after the first that was not an atom, split a path into its atoms and gave a leading call or group
# no operand at all.
fn: l2_merge_arity (const: @(LmP0Node mf)) int
    if: mf = 0 || mf\as = 0 || mf\as\frame = 0 || mf\as\frame\body = 0
        return: 0
return: l2_actual_count(mf\as\frame\body\first_field)

# A merge operand written as a group is the value the group holds when it holds one value -- one name, one path, one
# call, one operator expression: the ordinary transparent one-value group (l2_reference_fields), to any depth.  A group
# holding a field, a declaration, a definition or several items holds no one value: it is an anonymous Structure and the
# operand itself (docs/LMX_semantics.en.md#composition: `merge((n: 5); addN)`).  Nothing beside the group is taken.
fn: l2_merge_group_value (@@: LmP0Field first; @: int span; int: mi) int
    @: LmP0Field g
    @: LmP0Field in
    int: count
    g: \first
    while: \span = 1 && g != 0 && g\value != 0 && g\value\kind = c.LM_P0_NODE_STRUCTURE && g\value\as != 0 && g\value\as\structure != 0
        count: l2_count_active(g\value\as\structure)
        in: l2_next_active(g\value\as\structure\first_field)
        if: count < 1 || in = 0 || in\value = 0 || l2_expr_span(in) != count
            return: 0
        if: count = 1 && in\value\kind = c.LM_P0_NODE_FRAME && l2_d105_callee(mi, in, 1) < 0
            return: 0
        \first: in
        \span: count
        g: in
    ---
return: 0

# An operand no merge of the translator lowers, said at the written operand by its resolved category: a number by the
# common typing (l2_native_group_ty) is no Structure -- merge's contract; any other form (a field, an anonymous
# Structure, a prefixed operand, a Structure the typing reaches by an expression) is a located limit.
fn: l2_merge_operand_limit (@: LmP0Field first; int: span; int: mi; const: @(char path); const: @(LmP0Node at)) int
    int: ty
    ty: l2_native_group_ty(first, span, mi)
    if: ty >= 0 && l2_prim_code_name(ty) != 0
        return: l2_error(path, at, "a merge operand is not a Structure")
return: l2_error(path, at, "this merge operand form is not lowered yet")

# A name operand no Structure route resolves, said by what the name is: a callable's occurrence is a form the
# declaration merge does not lower (the callable merges are lowered where a callable result is received, T5 and T7);
# a number is no Structure; a name the site does not see is unknown.
fn: l2_merge_unknown_operand (@: LmP0Field name; int: mi; const: @(char path)) int
    int: formal 0 - 1
    int: ty
    if: l2_call_head_method(mi, name\value\as\atom, @ formal) >= 0
        return: l2_error(path, name\value, "this merge operand form is not lowered yet")
    ty: l2_native_group_ty(name, 1, mi)
    if: ty >= 0 && l2_prim_code_name(ty) != 0
        return: l2_error(path, name\value, "a merge operand is not a Structure")
return: l2_error(path, name\value, "unknown merge operand")

# Operand k of a callable merge (T5, T7) by that reading: 0 and *out its one field -- a name or a Frame, which the
# callable merge's own contract reads; 1 said at the operand (l2_merge_operand_limit).
fn: l2_merge_operand_node (const: @(LmP0Node mf); int: k; int: mi; const: @(char path); @@: LmP0Field out) int
    @: LmP0Field f
    @: LmP0Field g
    int: span
    \out: 0
    if: mf = 0 || mf\as = 0 || mf\as\frame = 0 || mf\as\frame\body = 0
        return: l2_error(path, mf, "a merge operand is not an expression")
    f: l2_actual_field(mf\as\frame\body\first_field, k)
    if: f = 0 || f\value = 0 || l2_expr_span(f) < 1
        return: l2_error(path, mf, "a merge operand is not an expression")
    span: l2_expr_span(f)
    g: f
    l2_merge_group_value(@ g, @ span, mi)
    if: span != 1 || g = 0 || g\value = 0 || g\value\kind = c.LM_P0_NODE_STRUCTURE
        return: l2_merge_operand_limit(g, span, mi, path, f\value)
    \out: g
return: 0

# The declaration merge's operand k by its form, read where mi stands (K03 S7, S7b): 0, a name -- *first its field;
# 2, a path whose last field is a Structure (l2_reference_path_leaf) or a call whose callee gives a named Structure
# (l2_d105_callee) -- *first and *span its fields, seen through a one-value group (l2_merge_group_value); 1, said at the
# operand by its category (l2_merge_operand_limit): a number is no Structure; a field, an anonymous Structure, a call of
# no named result and a path to no Structure are the forms no merge lowers yet.
fn: l2_merge_decl_operand (const: @(LmP0Node mf); int: k; int: mi; const: @(char path); @@: LmP0Field first; @: int span) int
    @: LmP0Field f
    @: LmP0Field g
    int: n
    int: callee
    \first: 0
    \span: 0
    if: mf = 0 || mf\as = 0 || mf\as\frame = 0 || mf\as\frame\body = 0
        return: l2_error(path, mf, "a merge operand is not an expression")
    f: l2_actual_field(mf\as\frame\body\first_field, k)
    if: f = 0 || f\value = 0 || l2_expr_span(f) < 1
        return: l2_error(path, mf, "a merge operand is not an expression")
    n: l2_expr_span(f)
    g: f
    l2_merge_group_value(@ g, @ n, mi)
    if: n = 1 && g != 0 && g\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM && g\value\as != 0 && g\value\as\atom != 0
        \first: g
        \span: 1
        return: 0
    ---
    if: n >= 3 && g != 0 && g\value != 0 && g\value\kind = c.LM_P0_NODE_ATOM && l2_operand_run(g, n) = n && l2_reference_path_leaf(g, n, mi) >= 0
        \first: g
        \span: n
        return: 2
    ---
    if: n = 1 && g != 0 && g\value != 0 && g\value\kind = c.LM_P0_NODE_FRAME
        callee: l2_d105_callee(mi, g, 1)
        if: callee >= 0 && callee != l2_e && l2_nsty_get(callee, 0 - 1) >= 0
            \first: g
            \span: 1
            return: 2
        ---
    ---
return: l2_merge_operand_limit(g, n, mi, path, f\value)

# K03 S7b: a call operand is checked where the merge is, as any call in a value is (l2_check_fields): its arity,
# edges, throws and inputs.  A name is checked at emission, where the qualified branch table is complete; a path was
# resolved by the schema.
fn: l2_check_merge_operands (const: @(LmP0Node mf); int: mi; const: @(char path)) int
    @: LmP0Field first 0
    int: span 0
    int: k 0
    int: n l2_merge_arity(mf)
    while: k < n
        if: l2_merge_decl_operand(mf, k, mi, path, @ first, @ span) = 1
            return: 1
        if: span = 1 && first\value\kind = c.LM_P0_NODE_FRAME && l2_check_fields(first, 1, mi, path, first\value) != 0
            return: 1
        k: k + 1
    ---
return: 0

# The value of a path or call operand into dest, evaluated once where the merge runs, before it (K03 S7b): a call is
# the ordinary reference value (l2_emit_reference_value: the call into its temporary); a path walks to its leaf
# Structure (l2_emit_path_to's Structure leaf, l2_pst).
fn: l2_merge_operand_value (@: LmP0Field first; int: span; int: ty; int: mi; const: @(char ind); @: L2Tx dest) int
    @: char text 0
    int: kind 0
    int: rc
    if: span = 1
        return: l2_emit_reference_value(first, span, ty, 0 - 1, mi, ind, dest)
    text: l2_address_path_text(first, span)
    if: text = 0
        return: l2_alloc_or(l2_src, first\value, "out of memory")
    rc: l2_emit_path_to(text, strlen(text), mi, ind, first\value, @ kind, 2)
    l2_xfree((cast: (@: void) text))
    if: rc != 0
        return: 1
return: l2_tx_set(dest, "l2_pst")

# The same operand walked: a path's reference (l2_rw_path_reference: AT down to the leaf Structure), a call's value.
fn: l2_rw_merge_operand (@: LmP0Field first; int: span; int: ty; int: parent; @: int out) int
    @: char text 0
    LmP0Text: written
    int: rc
    if: span = 1
        return: l2_rw_reference_value(first, span, ty, parent, out)
    text: l2_address_path_text(first, span)
    if: text = 0
        return: 1
    written.data: text
    written.length: strlen(text)
    rc: l2_rw_path_reference(first\value, @ written, parent, out)
    l2_xfree((cast: (@: void) text))
return: rc

# Operand k's physical profile, classified when the program runs (lmx_range_profile) and counted when it has one.
fn: l2_emit_merge_profile (const: @(char ind); int: msf; int: k) int
return: (cast: (int) (c.fprintf(l2_out, "%sl2_mprofiles[l2_mprofile_n%d]: lmx_range_profile(l2_program_arena, (cast: (@: void) l2_mops[%dU]))\n%sif: l2_mprofiles[l2_mprofile_n%d] != 0\n%s    l2_mprofile_n%d: l2_mprofile_n%d + 1U\n%s---\n", ind, msf, k, ind, msf, ind, msf, msf, ind) < 0))

# Merge operand k's model (l2_mu_operand_model), read by l2_mu_collect; the list grows.
fn: l2_mu_set (int: k; int: ns) int
    @: int g
    if: k >= l2_mu_cap
        g: (cast: (@: int) realloc((cast: (@: void) l2_mu_opns), (cast: (size_t) (k + 16)) * c.sizeof(c.int)))
        if: g = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_mu_opns: g
        l2_mu_cap: k + 16
    ---
    l2_mu_opns[k]: ns
return: 0

# Merge use record (sel, slot path s[0..n)) once (READ-FIELD-CLOSURE): two homes' uses that name one place are one.
fn: l2_mur_add (int: sel; @: int s; int: n) int
    int: j 0
    int: i
    int: same
    @: int g
    while: j < l2_mur_n
        if: l2_mur_sel[j] = sel && l2_mur_len[j] = n
            same: 1
            i: 0
            while: i < n
                if: l2_mur_sbuf[l2_mur_off[j] + i] != s[i]
                    same: 0
                i: i + 1
            ---
            if: same != 0
                return: 0
        ---
        j: j + 1
    ---
    if: l2_mur_n >= l2_mur_cap
        g: (cast: (@: int) realloc((cast: (@: void) l2_mur_sel), (cast: (size_t) (l2_mur_cap * 2 + 16)) * c.sizeof(c.int)))
        if: g = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_mur_sel: g
        g: (cast: (@: int) realloc((cast: (@: void) l2_mur_off), (cast: (size_t) (l2_mur_cap * 2 + 16)) * c.sizeof(c.int)))
        if: g = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_mur_off: g
        g: (cast: (@: int) realloc((cast: (@: void) l2_mur_len), (cast: (size_t) (l2_mur_cap * 2 + 16)) * c.sizeof(c.int)))
        if: g = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_mur_len: g
        l2_mur_cap: l2_mur_cap * 2 + 16
    ---
    if: l2_mur_slots + n > l2_mur_scap
        g: (cast: (@: int) realloc((cast: (@: void) l2_mur_sbuf), (cast: (size_t) ((l2_mur_slots + n) * 2 + 32)) * c.sizeof(c.int)))
        if: g = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_mur_sbuf: g
        l2_mur_scap: (l2_mur_slots + n) * 2 + 32
    ---
    l2_mur_sel[l2_mur_n]: sel
    l2_mur_off[l2_mur_n]: l2_mur_slots
    l2_mur_len[l2_mur_n]: n
    i: 0
    while: i < n
        l2_mur_sbuf[l2_mur_slots + i]: s[i]
        i: i + 1
    ---
    l2_mur_slots: l2_mur_slots + n
    l2_mur_n: l2_mur_n + 1
return: 0

# Code home m with node anchor sel belongs to the collected closure, once.
fn: l2_muh_add (int: m; int: sel) int
    int: j 0
    @: int g
    while: j < l2_muh_n
        if: l2_muh[j] = m && l2_muh_sel[j] = sel
            return: 0
        j: j + 1
    ---
    if: l2_muh_n >= l2_muh_cap
        g: (cast: (@: int) realloc((cast: (@: void) l2_muh), (cast: (size_t) (l2_muh_cap * 2 + 16)) * c.sizeof(c.int)))
        if: g = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_muh: g
        g: (cast: (@: int) realloc((cast: (@: void) l2_muh_sel), (cast: (size_t) (l2_muh_cap * 2 + 16)) * c.sizeof(c.int)))
        if: g = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_muh_sel: g
        l2_muh_cap: l2_muh_cap * 2 + 16
    ---
    l2_muh[l2_muh_n]: m
    l2_muh_sel[l2_muh_n]: sel
    l2_muh_n: l2_muh_n + 1
return: 0

# Every local definition physically retained in h's source, including one
# inside a control body, carries its own code uses. Its node is already in
# the selected view; only its external uses extend the lexical copy. Derive
# these homes from source definition fields, not namespace spelling or the
# collector's outer-method stamp. The same worklist closes nested definitions.
fn: l2_mu_local_homes (int: h) int
    @: L2SourceContainer row l2_source_containers
    @: L2SourceField field
    int: ni
    while: row != 0
        if: row\view_kind = 0 && row\source_mi = h && row\inert = 0
            field: row\fields
            while: field != 0
                ni: l2_source_definition_ns(field\own)
                if: ni >= 0 && l2_ns_local[ni] >= 0 && l2_ns_proc[ni] >= 0 && l2_muh_add(l2_ns_proc[ni], -1) != 0
                    return: 1
                field: field\next
            ---
        ---
        row: row\allocated_next
    ---
return: 0

# Named Structure r is reached from the operand being collected, once.
fn: l2_mus_add (int: r) int
    int: j 0
    @: int g
    while: j < l2_mus_n
        if: l2_mus[j] = r
            return: 0
        j: j + 1
    ---
    if: l2_mus_n >= l2_mus_cap
        g: (cast: (@: int) realloc((cast: (@: void) l2_mus), (cast: (size_t) (l2_mus_cap * 2 + 16)) * c.sizeof(c.int)))
        if: g = 0
            return: l2_error(l2_src, 0, "out of memory")
        l2_mus: g
        l2_mus_cap: l2_mus_cap * 2 + 16
    ---
    l2_mus[l2_mus_n]: r
    l2_mus_n: l2_mus_n + 1
return: 0

# The recorded uses of home h as records, each resolved to its slot path (l2_use_resolve).  A use from the unit
# (base 0) is anchored at the unit, selector 0; one from the home's node (base 1) at `sel`: 0 the unit -- a unit-level
# home's node, the unit path of its part's root first for a program part's method (l2_mu_node_prefix) --, k + 1
# operand k's lexical parent (the operand's own procedure), -1 no record -- that node lies inside the copy, which
# holds the place already.  A use anchored at the unit that names a unit method's occurrence makes that method a
# home: its code is copied with it.
fn: l2_mu_home (int: h; int: sel) int
    int: k 0
    int: m
    int: anchor
    int: n
    while: k < l2_use_n
        if: l2_use_home[k] = h
            anchor: 0
            if: l2_use_base[k] = 1
                anchor: sel
            if: anchor >= 0
                if: l2_use_resolve(k, @ n) != 0
                    return: 1
                if: anchor = 0 && l2_use_base[k] = 1 && l2_mu_node_prefix(h, @ n) != 0
                    return: 1
                if: l2_mur_add(anchor, l2_mu_rbuf, n) != 0
                    return: 1
                if: anchor = 0 && n = 1
                    m: 0
                    while: m < l2_m_n
                        if: l2_occ_slot(m) = l2_mu_rbuf[0] && l2_mad_host_of(m) < 0 && l2_muh_add(m, 0) != 0
                            return: 1
                        m: m + 1
                    ---
                ---
            ---
        ---
        k: k + 1
    ---
return: l2_mu_local_homes(h)

# A use from the node of unit-level home h, anchored at the unit: a program part's method runs with its part's root as
# its node (l2_m_lexparent, §10), so the root's unit path (l2_use_ns_slots) goes before the use's *n slots in
# l2_mu_rbuf; any other unit-level home's node is the unit itself.  *n grows by that path's length.
fn: l2_mu_node_prefix (int: h; @: int n) int
    int: k l2_m_part(h)
    int: d
    int: i
    if: k < 0 || l2_part_ns[k] < 0
        return: 0
    d: l2_use_ns_slots(l2_part_ns[k], 0)
    if: d <= 0
        return: l2_error(l2_src, 0, "internal: a program part's root has no unit place")
    if: \n > c.INT_MAX - d || l2_mu_room(\n + d) != 0
        return: l2_error(l2_src, 0, "out of memory")
    i: \n
    while: i > 0
        i: i - 1
        l2_mu_rbuf[i + d]: l2_mu_rbuf[i]
    ---
    l2_use_ns_slots(l2_part_ns[k], l2_mu_rbuf)
    \n: \n + d
return: 0

# One merge's use records, the same for the native and the walked merge: every operand's homes -- its model's body
# procedure (selector k + 1), a nested Structure's procedure (its node inside the copy), the unit methods its
# callable fields hold -- and the unit methods their uses reach, closed to a fixed point.  Every list grows: no
# home, Structure or record is dropped (l2_mur_*, l2_muh, l2_mus).
fn: l2_mu_collect (int: nops) int
    int: k 0
    int: ns
    int: r
    int: i
    int: fx
    l2_mur_n: 0
    l2_mur_slots: 0
    l2_muh_n: 0
    while: k < nops
        ns: 0 - 1
        if: k < l2_mu_cap
            ns: l2_mu_opns[k]
        if: ns >= 0 && ns < l2_ns_n && l2_ns_eternal[ns] < 0
            l2_mus_n: 0
            if: l2_mus_add(ns) != 0
                return: 1
            i: 0
            while: i < l2_mus_n
                r: l2_mus[i]
                if: l2_ns_proc[r] >= 0 && r = ns && l2_mu_home(l2_ns_proc[r], k + 1) != 0
                    return: 1
                if: l2_ns_proc[r] >= 0 && r != ns && l2_mu_home(l2_ns_proc[r], 0 - 1) != 0
                    return: 1
                fx: 0
                while: fx < l2_nsf_n
                    if: l2_nsf_owner[fx] = r && l2_nsf_kind[fx] = 4 && l2_nsf_ref[fx] >= 0 && l2_mad_host_of(l2_nsf_ref[fx]) < 0 && l2_muh_add(l2_nsf_ref[fx], 0) != 0
                        return: 1
                    if: l2_nsf_owner[fx] = r && l2_nsf_kind[fx] = 2 && l2_nsf_ref[fx] >= 0 && l2_mus_add(l2_nsf_ref[fx]) != 0
                        return: 1
                    fx: fx + 1
                ---
                i: i + 1
            ---
        ---
        k: k + 1
    ---
    i: 0
    while: i < l2_muh_n
        if: l2_mu_home(l2_muh[i], l2_muh_sel[i]) != 0
            return: 1
        i: i + 1
    ---
return: 0

# The use records of one home h, a unit method -- a callable merge's model, whose node is the unit -- closed over the
# unit methods its uses reach, as l2_mu_collect closes a merge's operands' homes (T7).  The node runs h's code built
# from h's source (l2_view_build), not h's occurrence: that occurrence is a place of the copy only where a use names it.
fn: l2_mu_collect_home (int: h) int
    int: i 0
    l2_mur_n: 0
    l2_mur_slots: 0
    l2_muh_n: 0
    if: h < 0
        return: 0
    if: l2_muh_add(h, 0) != 0
        return: 1
    while: i < l2_muh_n
        if: l2_mu_home(l2_muh[i], l2_muh_sel[i]) != 0
            return: 1
        i: i + 1
    ---
return: 0

# The model whose code the copy of merge operand k carries (READ-FIELD-CLOSURE), or -1: a named Structure by its
# name, an own field's declared Structure, a path's leaf Structure, a call's named result.  A unit eternal branch is
# retained, not copied; a formal's model is not known here (recorded OPEN).  first/span/form: l2_merge_decl_operand.
fn: l2_mu_operand_model (@: LmP0Field first; int: span; int: form; int: mi) int
    int: sl
    int: ni
    int: callee
    if: first = 0 || first\value = 0
        return: 0 - 1
    if: form = 2 && span >= 3
        return: l2_reference_path_leaf(first, span, mi)
    if: form = 2
        callee: l2_d105_callee(mi, first, 1)
        if: callee < 0
            return: 0 - 1
        return: l2_nsty_get(callee, 0 - 1)
    ---
    if: form != 0 || first\value\kind != c.LM_P0_NODE_ATOM || first\value\as = 0 || first\value\as\atom = 0
        return: 0 - 1
    sl: l2_resolved_own(mi, first\value\as\atom)
    # An own field's declared Structure, or, for a row a whole copy fills (`rb: merge: ra`), the Structure whose
    # completed occurrence it holds, proved through its merge chain (l2_own_copy_chain).
    if: sl >= 0 && l2_own_nsty_get(sl) >= 0
        return: l2_own_nsty_get(sl)
    if: sl >= 0
        return: l2_own_copy_chain(sl)
    if: l2_ebr_find(first\value\as\atom) >= 0
        return: 0 - 1
    ni: l2_ns_find(first\value\as\atom)
    if: ni >= 0 && (l2_ns_parent[ni] >= 0 || l2_ns_eternal[ni] >= 0)
        return: 0 - 1
return: ni

# The native merge's use records (l2_mu_collect) as its arrays l2_mua/l2_muk/l2_mul/l2_mus: the unit an explicit
# anchor, an operand's lexical parent its selector.  Returns the record and slot counts; none, no arrays.
fn: l2_merge_uses_native (const: @(char ind); int: msf; int: nops; @: int out_n; @: int out_slots) int
    int: i 0
    int: j
    \out_n: 0
    \out_slots: 0
    if: l2_mu_collect(nops) != 0
        return: 1
    if: l2_mur_n = 0
        return: 0
    if: c.fprintf(l2_out, "%s[]: @(Lmx) l2_mua%d %d\n%s[]: size_t l2_muk%d %d\n%s[]: size_t l2_mul%d %d\n%s[]: size_t l2_mus%d %d\n", ind, msf, l2_mur_n, ind, msf, l2_mur_n, ind, msf, l2_mur_n, ind, msf, l2_mur_slots) < 0
        return: 1
    while: i < l2_mur_n
        if: l2_mur_sel[i] = 0 && c.fprintf(l2_out, "%sl2_mua%d[%dU]: %s\n", ind, msf, i, l2_unit_ref) < 0
            return: 1
        if: l2_mur_sel[i] != 0 && c.fprintf(l2_out, "%sl2_mua%d[%dU]: 0\n", ind, msf, i) < 0
            return: 1
        if: c.fprintf(l2_out, "%sl2_muk%d[%dU]: %dU\n%sl2_mul%d[%dU]: %dU\n", ind, msf, i, l2_mur_sel[i], ind, msf, i, l2_mur_len[i]) < 0
            return: 1
        j: 0
        while: j < l2_mur_len[i]
            if: c.fprintf(l2_out, "%sl2_mus%d[%dU]: %dU\n", ind, msf, l2_mur_off[i] + j, l2_mur_sbuf[l2_mur_off[i] + j]) < 0
                return: 1
            j: j + 1
        ---
        i: i + 1
    ---
    \out_n: l2_mur_n
    \out_slots: l2_mur_slots
return: 0

# The program's qualified branches (l2_program_qualified_at) appended to a merge's retained profile span `arr`, its
# length `cnt`: a branch qualified independent: const: immutable is not copied (docs #composition), and the copied
# lexical chain a merge result hangs under keeps it itself, as a callable merge's copy keeps it
# (l2_t7_emit_lex_copy).  The caller sets `cnt` before; profiles already there stay.
fn: l2_emit_keep (const: @(char ind); const: @(char arr); const: @(char cnt)) int
    int: q 0
    while: q < l2_ebr_n
        if: c.fprintf(l2_out, "%s%s[%s]: lmx_range_profile(l2_program_arena, (cast: (@: void) l2_program_qualified_at(%dU)))\n%sif: %s[%s] != 0\n%s    %s: %s + 1U\n%s---\n", ind, arr, cnt, q, ind, arr, cnt, ind, cnt, cnt, ind) < 0
            return: 1
        q: q + 1
    ---
return: 0

# Compiler schema handles reuse existing metadata: named namespace indices,
# -1 absent, and tagged merge indices. A handle at or below -1500000000 is
# one method occurrence's own fields. No handle is a runtime type or binding.
fn: l2_schema_kind (int: schema) int
    if: schema = -1
        return: 0
    if: schema >= 0
        return: 1
    if: schema <= (0 - 1500000000)
        return: 3
return: 2

fn: l2_schema_index (int: schema) int
    if: l2_schema_kind(schema) = 3
        return: (0 - 1500000000) - schema
    if: l2_schema_kind(schema) = 2
        return: -2 - schema
return: schema

fn: l2_schema_merge (int: result) int
    if: result < 0
        return: -1
return: -2 - result

fn: l2_schema_width (int: schema) int
    if: l2_schema_kind(schema) = 1
        return: l2_ns_width(schema)
    if: l2_schema_kind(schema) = 3
        return: l2_method_field_count(l2_schema_index(schema))
    if: l2_schema_kind(schema) = 2
        return: l2_mrs_width(l2_schema_index(schema))
return: 0

fn: l2_schema_token_slot (int: schema) int
    # A method occurrence has no layout-token cell. Callers fail closed.
    if: l2_schema_kind(schema) = 3
        return: 0 - 1
    if: l2_schema_kind(schema) = 2
        return: l2_ns_n + l2_schema_index(schema)
return: schema

fn: l2_schema_field (int: schema; int: slot; @: L2SchemaField out) int
    int: row 0
    int: ordinal 0
    int: own
    int: owner l2_schema_index(schema)
    if: out = 0 || slot < 0 || schema = -1
        return: 1
    out\name: 0
    out\type_word: 0
    out\kind: -1
    out\model: -1
    if: l2_schema_kind(schema) = 3
        own: l2_method_field_own(owner, slot)
        if: own < 0
            return: 1
        out\name: l2_own_name[own]
        out\type_word: 0
        out\kind: l2_own_nsf_kind(l2_own_ty[own])
        out\model: 0 - 1
        return: 0
    ---
    if: l2_schema_kind(schema) = 2
        while: row < l2_mrs_n
            if: l2_mrs_res[row] = owner
                if: ordinal = slot
                    out\name: l2_mrs_name[row]
                    out\type_word: l2_mrs_type[row]
                    out\kind: l2_mrs_kind[row]
                    out\model: l2_mrs_ent[row]
                    return: 0
                ordinal: ordinal + 1
            row: row + 1
        ---
        return: 1
    ---
    row: l2_ns_row_at_slot(owner, slot)
    if: row = -2
        return: 1
    if: row >= 0
        out\name: l2_nsf_fname[row]
        out\type_word: l2_nsf_name[row]
        out\kind: l2_nsf_kind[row]
        out\model: l2_nsf_ref[row]
        return: 0
    # Unnamed operation children retain their actual physical coordinates.
    if: slot < l2_ns_width(owner)
        return: 0
return: 1

fn: l2_schema_named (int: schema; const: @(LmP0Text name); int: occurrence; @: L2SchemaField out) int
return: l2_schema_named_select(schema, name, occurrence, out, 1)

# Interface existence/type checks select declaration metadata, not the
# unfinished graph. LAST and [N] use the same selector as physical lookup.
fn: l2_schema_named_meta (int: schema; const: @(LmP0Text name); int: occurrence; @: L2SchemaField out) int
return: l2_schema_named_select(schema, name, occurrence, out, 0)

fn: l2_schema_named_select (int: schema; const: @(LmP0Text name); int: occurrence; @: L2SchemaField out; int: project) int
    L2SchemaField: field
    int: slot 0
    int: seen 0
    int: found -1
    int: row 0
    int: width l2_schema_width(schema)
    int: owner l2_schema_index(schema)
    if: project = 0 && l2_schema_kind(schema) = 1
        width: l2_ns_count[owner]
    while: slot < width
        if: project = 0 && l2_schema_kind(schema) = 1
            while: row < l2_nsf_n && l2_nsf_owner[row] != owner
                row: row + 1
            if: row >= l2_nsf_n
                return: -1
            field.name: l2_nsf_fname[row]
            field.type_word: l2_nsf_name[row]
            field.kind: l2_nsf_kind[row]
            field.model: l2_nsf_ref[row]
            row: row + 1
        else:
            if: l2_schema_field(schema, slot, @ field) != 0
                return: -1
        ---
        if: l2_text_same((field.name), name) != 0
            if: occurrence < 0 || occurrence = seen
                found: slot
                if: out != 0
                    \out: field
                if: occurrence >= 0
                    if: project = 0
                        return: found
                    return: l2_schema_placed(schema, found)
            ---
            seen: seen + 1
        slot: slot + 1
    ---
    if: project = 0
        return: found
return: l2_schema_placed(schema, found)

# Reuse a named body's complete namespace schema, including nonprimitive
# fields. Other method occurrences use their existing own-row schema tag;
# l2_schema_index recovers the method. No namespace is created for it.
fn: l2_schema_method (int: mi) int
    int: ns
    if: mi < 0
        return: 0 - 1
    ns: l2_m_nsof(mi)
    if: ns >= 0
        return: ns
return: (0 - 1500000000) - mi

# Unhosted own rows of one method, in declaration order. Layout stores the
# physical child in l2_own_uchild; this ordinal is not that child.
fn: l2_method_field_count (int: mi) int
    int: i 0
    int: n 0
    if: mi < 0
        return: 0
    while: i < l2_own_n
        if: l2_own_mi[i] = mi && l2_own_host[i] = 0 && l2_own_fid[i] < 0
            n: n + 1
        i: i + 1
    ---
return: n

fn: l2_method_field_own (int: mi; int: ordinal) int
    int: i 0
    int: seen 0
    if: mi < 0 || ordinal < 0
        return: 0 - 1
    while: i < l2_own_n
        if: l2_own_mi[i] = mi && l2_own_host[i] = 0 && l2_own_fid[i] < 0
            if: seen = ordinal
                return: i
            seen: seen + 1
        ---
        i: i + 1
    ---
return: 0 - 1

fn: l2_method_field_slot (int: schema; int: ordinal) int
    int: own
    if: l2_schema_kind(schema) != 3 || ordinal < 0
        return: 0 - 1
    own: l2_method_field_own(l2_schema_index(schema), ordinal)
    if: own < 0
        return: 0 - 1
return: l2_graph_field_child(own)

# Own type codes to the field kinds a named Structure already uses.
fn: l2_own_nsf_kind (int: oty) int
    if: oty = 0
        return: 7
    if: oty = 1
        return: 1
    if: oty = 2
        return: 0
    if: oty = 3
        return: 8
    if: oty = 36
        return: 9
return: 0 - 1

# Namespace and merge schemas name a field by its ordinal. A method occurrence
# names it by the physical child layout already stored.
fn: l2_schema_placed (int: schema; int: ordinal) int
    if: ordinal < 0
        return: 0 - 1
    if: l2_schema_kind(schema) = 3
        return: l2_method_field_slot(schema, ordinal)
return: ordinal

fn: l2_own_schema (int: own) int
    int: result l2_own_res(own)
    if: result >= 0
        return: l2_schema_merge(result)
return: l2_own_nsty_get(own)

# K03 NS-ROLES-1c: the merge record own field `own`'s paths read -- its own merge result's, or, for a binding `b: A` to
# a merge result (l2_rb_own_of), its referent's: b holds A's Structure, whose coordinates are A's record.  -1 for none.
fn: l2_own_res (int: own) int
    int: result l2_mres_of_own(own)
    int: hops 0
    while: result < 0 && own >= 0 && own < l2_own_n && l2_own_decl[own] != 0 && l2_rb_own_of(l2_own_decl[own]) >= 0 && hops < l2_own_n
        own: l2_rb_own_of(l2_own_decl[own])
        result: l2_mres_of_own(own)
        hops: hops + 1
    ---
return: result

# The schema of input k of mi -- an own-key source's, a formal's declared model, or a HIDDEN input's: the schema of
# the callee's lexical source (K02c: a merge result's is the tagged merge schema, which the named-only
# l2_input_model cannot carry).  -1 when there is none.  The transport type stays l2_input_ft's; this is the
# receiving metadata.
fn: l2_input_schema (int: mi; int: k) int
    int: own l2_d105_key_own(k)
    int: model
    if: own >= 0
        return: l2_own_schema(own)
    if: mi < 0 || mi >= l2_m_n || k < l2_m_arity[mi] || k >= l2_m_arity[mi] + l2_m_dyn[mi]
        return: l2_input_model(mi, k)
    model: l2_cap_arg_ns(mi, k)
    if: model >= 0
        return: model
    own: l2_own_lexical(mi, l2_input_name(mi, k))
    if: own >= 0
        return: l2_own_schema(own)
# No declaration in sight: the coordinate space of the method's paths through the name, where one is
# established (l2_anchor_close).
return: l2_anchor_of(mi, l2_input_name(mi, k))

fn: l2_mres_of_own (int: own) int
    int: i 0
    if: own < 0
        return: -1
    while: i < l2_mres_n
        if: l2_mres_own[i] = own
            return: i
        i: i + 1
    ---
return: -1

# Lookup starts with the ordinary site-selected binding. mres is only schema.
fn: l2_mres_find (int: mi; const: @(LmP0Text t)) int
return: l2_mres_of_own(l2_resolved_own(mi, t))

fn: l2_mres_decl (int: mi; const: @(LmP0Node stmt)) int
    if: stmt = 0 || stmt\as = 0 || stmt\as\frame = 0
        return: -1
return: l2_mres_of_own(l2_own_find_decl(mi, stmt\as\frame\head, stmt))

# Nested bodies of an ordinary frame: if, while and for carry their statements
# in a STRUCTURE node among the frame fields.
fn: l2_merge_nested (const: @(LmP0Structure fields); int: mi; const: @(LmP0Node host)) int
    @: LmP0Field f
    const: @: LmP0Node scope
    int: status
    if: fields = 0
        return: 0
    # A registered body's statement list can belong to its frame directly,
    # rather than appear as a STRUCTURE operand among the frame's fields.
    if: l2_for_find(host) >= 0 && l2_scope_block(host) = fields
        if: l2_scope_push(host) != 0
            return: 1
        status: l2_merge_scan(fields, mi)
        l2_scope_pop()
        return: status
    # The fields of any Frame, a call among them: a call's actuals, not the Frames
    # that name them (a naming Frame `Model: x` is no declaration of x).
    f: l2_next_active(l2_call_actuals(fields))
    while: f != 0
        if: l2_source_is_callable_definition(f\value) != 0
            f: l2_next_active(f\next)
            continue
        if: f\value != 0 && f\value\kind = c.LM_P0_NODE_FRAME && f\value\as != 0 && f\value\as\frame != 0 && f\value\as\frame\body != 0
            if: l2_merge_nested(f\value\as\frame\body, mi, f\value) != 0
                return: 1
            ---
        if: f\value != 0 && f\value\kind = c.LM_P0_NODE_FRAME && f\value\as != 0 && f\value\as\frame != 0 && f\value\as\frame\trailer != 0 && f\value\as\frame\trailer\body != 0
            if: l2_merge_scan(f\value\as\frame\trailer\body, mi) != 0
                return: 1
            ---
        if: f\value != 0 && f\value\kind = c.LM_P0_NODE_STRUCTURE && f\value\as != 0
            # The existing control-body declaration is the lexical host.
            # For has its header/body on the frame; if/while use the body node.
            scope: f\value
            if: l2_for_find(host) >= 0
                scope: host
            if: l2_scope_push(scope) != 0
                return: 1
            if: l2_merge_scan(f\value\as\structure, mi) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            ---
        ---
        f: l2_next_active(f\next)
    ---
return: 0

# Does a body contain a merge anywhere? A method that does declares
# throws merge(args) and therefore takes the full declared-throw ABI; every
# other callable keeps its direct return, so nothing else changes shape.
fn: l2_body_throws (const: @(LmP0Structure body); int: mi) int
    @: LmP0Field field
    @: LmP0Field inner
    @: LmP0Node stmt
    if: body = 0
        return: 0
    # A method that declares throw names is on the throw channel by its declaration (S1.2).
    if: l2_throws_declared(mi) > 0
        return: 1
    # body is a statement list or, by the recursion below, the body of any Frame: a
    # call's actuals are read, not the Frames that name them.
    field: l2_next_active(l2_call_actuals(body))
    while: field != 0
        stmt: field\value
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0 && l2_body_throws(stmt\as\structure, mi) != 0
            return: 1
        if: l2_merge_declaration(body, stmt, mi) != 0
            return: 1
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0
            if: l2_for_find(stmt) >= 0 && l2_scope_block(stmt) = stmt\as\frame\body && l2_body_throws(stmt\as\frame\body, mi) != 0
                return: 1
            inner: l2_next_active(l2_call_actuals(stmt\as\frame\body))
            while: inner != 0
                if: inner\value != 0 && inner\value\kind = c.LM_P0_NODE_STRUCTURE && inner\value\as != 0
                    if: l2_body_throws(inner\value\as\structure, mi) != 0
                        return: 1
                    ---
                if: inner\value != 0 && inner\value\kind = c.LM_P0_NODE_FRAME && inner\value\as != 0 && inner\value\as\frame != 0
                    if: inner\value\as\frame\body != 0 && l2_body_throws(inner\value\as\frame\body, mi) != 0
                        return: 1
                    ---
                ---
                inner: l2_next_active(inner\next)
            ---
            if: stmt\as\frame\trailer != 0 && stmt\as\frame\trailer\body != 0 && l2_body_throws(stmt\as\frame\trailer\body, mi) != 0
                return: 1
        ---
        field: l2_next_active(field\next)
    ---
return: 0

# A call that can throw makes its caller throwing as well. The same closure is
# the current-Message dynamic dependency closure: entry supplies the Message,
# and every throwing method receives and forwards it.
fn: l2_throws_close () int
    int: changed 1
    int: caller
    int: callee
    while: changed != 0
        changed: 0
        caller: 0
        while: caller < l2_m_n
            callee: 0
            while: callee < l2_m_n
                if: l2_m_edge[l2_edge_off(caller, callee)] != 0 && l2_m_throws[callee] != 0 && l2_m_throws[caller] = 0
                    l2_m_throws[caller]: 1
                    changed: 1
                callee: callee + 1
            caller: caller + 1
        ---
    ---
return: 0

# K02: the model the value of this reference binding actually has, when the declaration names
# one -- `@: A p B` is the `@` frame's body [declared model, name, candidate], so the third
# atom is the candidate's model.  -1 when the binding names no candidate or names something
# other than a unit Structure: the declared model then stands.
fn: l2_own_ref_candidate (int: own) int
    @: LmP0Node stmt
    @: LmP0Frame fr
    @: LmP0Field a0
    @: LmP0Field a1
    @: LmP0Field a2
    if: own < 0 || own >= l2_own_n
        return: 0 - 1
    stmt: l2_own_decl[own]
    if: stmt = 0 || stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\body = 0
        return: 0 - 1
    fr: stmt\as\frame
    a0: l2_next_active(fr\body\first_field)
    if: a0 = 0
        return: 0 - 1
    a1: l2_next_active(a0\next)
    if: a1 = 0
        return: 0 - 1
    a2: l2_next_active(a1\next)
    if: a2 = 0 || a2\value = 0 || a2\value\kind != c.LM_P0_NODE_ATOM || a2\value\as = 0 || a2\value\as\atom = 0
        return: 0 - 1
    return: l2_ns_find(a2\value\as\atom)

# Build the result-slot map for one merge statement by the author's rule (plan §4): the
# model's fields, then each later operand's and the body's -- INTO the placed slot of the
# same name, or a slot of their own. Runs in the PRE-SCAN, because a method
# lowered before the entry E may already read a field of the result.
fn: l2_mrs_build (int: res; const: @(LmP0Node stmt); const: @(LmP0Node mf)) int
    @: L2ReferenceSource source @ l2_mres_source[res]
    @: LmP0Field last 0
    @: LmP0Field bf
    @: LmP0Field bv
    @: LmP0Structure bd
    int: n
    int: k 0
    int: oi
    int: ni
    int: sl
    int: own
    int: mi l2_own_mi[l2_mres_own[res]]
    int: bj 0
    int: pairs 0
    int: q 0
    int: cand 0 - 1
    int: fi 0 - 1
    int: form
    int: span 0
    int: osch
    L2ReferenceSource: operand
    if: mf = 0 || mf\as = 0 || mf\as\frame = 0 || mf\as\frame\body = 0
        return: 0
    n: l2_merge_arity(mf)
    if: n < 0
        return: l2_error(l2_method_src(mi, l2_src), mf, "a merge operand is not an expression")
    if: l2_reference_source(0, 0, mi, source) != 0
        return: 1
    if: l2_mres_from != 0
        l2_mres_from[res]: 0 - 1
    if: n = 1 && l2_merge_body(stmt) = 0
        form: l2_merge_decl_operand(mf, 0, mi, l2_method_src(mi, l2_src), @ last, @ span)
        if: form = 1
            return: 1
        if: l2_reference_source(last, span, mi, source) != 0
            return: 1
        own: 0 - 1
        if: form = 0
            own: l2_resolved_own(mi, last\value\as\atom)
        if: own >= 0
            source\schema: l2_own_schema(own)
            source\layout: -1
            source\method: l2_own_mi[own]
            source\place: l2_d105_own_key(own)
            # The whole copy of a row: the link of l2_own_copy_chain. The
            # admission source above stays without a layout.
            if: l2_mres_from != 0 && own != l2_mres_own[res]
                l2_mres_from[res]: own
            ---
        ---
    ---
    while: k < n
        form: l2_merge_decl_operand(mf, k, mi, l2_method_src(mi, l2_src), @ last, @ span)
        if: form = 1
            return: 1
        # K03 S7b: a path or a call operand has its reference source's model -- the path's leaf Structure, the
        # callee's result model, a merge result's record.
        if: form = 2
            l2_reference_source(last, span, mi, @ operand)
            osch: operand.schema
            if: l2_schema_kind(osch) = 1 && l2_mrs_take_entry(res, k, osch, last\value) != 0
                return: 1
            if: l2_schema_kind(osch) = 2 && l2_mrs_take_result(res, k, l2_schema_index(osch), last\value) != 0
                return: 1
            if: l2_schema_kind(osch) != 1 && l2_schema_kind(osch) != 2
                return: l2_error(l2_method_src(mi, l2_src), last\value, "this merge operand form is not lowered yet")
            k: k + 1
            continue
        ---
        own: l2_resolved_own(mi, last\value\as\atom)
        oi: -1
        ni: -1
        sl: l2_mres_of_own(own)
        if: own >= 0
            ni: l2_own_nsty_get(own)
            # K02: an explicit reference binding contributes the model of the value it
            # actually holds; the declared model is only the fallback.
            cand: l2_own_ref_candidate(own)
            if: cand >= 0
                ni: cand
            ---
        else:
            # K02: a FORMAL operand of this method -- its declared model, when that model is a
            # named Structure.  The value it carries is the caller's, reached by the ordinary
            # value path, so only the schema has to be named here.
            fi: l2_param_find(mi, last\value\as\atom)
            if: fi >= 0
                ni: l2_input_model(mi, fi)
            else:
                oi: l2_ebr_find(last\value\as\atom)
                ni: l2_ns_find(last\value\as\atom)
                if: ni >= 0 && l2_ns_parent[ni] >= 0
                    ni: -1
                ---
            ---
        ---
        if: oi < 0 && ni < 0 && sl < 0
            return: l2_merge_unknown_operand(last, mi, l2_method_src(mi, l2_src))
        if: oi >= 0 && l2_mrs_take_entry(res, k, l2_ebr_root(oi), last\value) != 0
            return: 1
        if: oi < 0 && ni >= 0 && l2_mrs_take_entry(res, k, ni, last\value) != 0
            return: 1
        if: oi < 0 && ni < 0 && sl >= 0 && l2_mrs_take_result(res, k, sl, last\value) != 0
            return: 1
        k: k + 1
    ---
    bd: l2_merge_body(stmt)
    bf: 0
    if: bd != 0
        bf: l2_next_active(bd\first_field)
    while: bf != 0
        if: bf\value = 0 || bf\value\kind != c.LM_P0_NODE_FRAME || bf\value\as = 0 || bf\value\as\frame = 0 || bf\value\as\frame\body = 0
            return: 0
        bv: l2_next_active(bf\value\as\frame\body\first_field)
        if: bv = 0 || bv\value = 0 || bv\value\kind != c.LM_P0_NODE_ATOM
            return: 0
        if: l2_mrs_join(res, n, bj, bv\value\as\atom, 0, 0 - 1, 0, -1, bf\value) != 0
            return: 1
        bj: bj + 1
        bf: l2_next_active(bf\next)
    ---
    l2_mres_width[res]: l2_mrs_width(res)
    while: q < l2_msrc_n
        if: l2_msrc_res[q] = res && l2_msrc_pair[q] != 0
            pairs: pairs + 1
        q: q + 1
    ---
    if: pairs > l2_merge_pmax
        l2_merge_pmax: pairs
return: 0

fn: l2_merge_scan (const: @(LmP0Structure body); int: mi) int
    @: L2ReferenceSource sources
    @: LmP0Field field
    @: LmP0Node stmt
    @: LmP0Node mf
    @: int grown
    @: int widths 0
    int: n
    int: own
    int: res
    int: excluded
    int: built
    if: body = 0
        return: 0
    field: l2_next_active(body\first_field)
    while: field != 0
        stmt: field\value
        if: l2_source_is_callable_definition(stmt) != 0
            field: l2_next_active(field\next)
            continue
        l2_vis_stmt(mi, stmt)
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0
            if: l2_scope_push(stmt) != 0
                return: 1
            if: l2_merge_scan(stmt\as\structure, mi) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            field: l2_next_active(field\next)
            continue
        mf: l2_merge_declaration(body, stmt, mi)
        if: mf != 0
            n: l2_merge_arity(mf)
            if: n > l2_merge_max
                l2_merge_max: n
            own: l2_own_find_decl(mi, stmt\as\frame\head, stmt)
            if: own < 0
                own: l2_own_add(mi, stmt\as\frame\head, l2_graph_own(), l2_method_src(mi, l2_src), stmt)
            if: own < 0
                return: 1
            res: l2_mres_of_own(own)
            if: res < 0
                grown: (cast: (@: int) realloc((cast: (@: void) l2_mres_own), (cast: (size_t) (l2_mres_n + 1)) * c.sizeof(c.int)))
                if: grown = 0
                    return: 1
                l2_mres_own: grown
                widths: (cast: (@: int) realloc((cast: (@: void) l2_mres_width), (cast: (size_t) (l2_mres_n + 1)) * c.sizeof(c.int)))
                if: widths = 0
                    return: 1
                l2_mres_width: widths
                sources: (cast: (@: L2ReferenceSource) realloc((cast: (@: void) l2_mres_source), (cast: (size_t) (l2_mres_n + 1)) * c.sizeof(c.L2ReferenceSource)))
                if: sources = 0
                    return: 1
                l2_mres_source: sources
                l2_mres_addressed: (cast: (@: int) realloc((cast: (@: void) l2_mres_addressed), (cast: (size_t) (l2_mres_n + 1)) * c.sizeof(c.int)))
                l2_mres_called: (cast: (@@: LmP0Node) realloc((cast: (@: void) l2_mres_called), (cast: (size_t) (l2_mres_n + 1)) * c.sizeof(@: LmP0Node)))
                l2_mres_called_mi: (cast: (@: int) realloc((cast: (@: void) l2_mres_called_mi), (cast: (size_t) (l2_mres_n + 1)) * c.sizeof(c.int)))
                l2_mres_from: (cast: (@: int) realloc((cast: (@: void) l2_mres_from), (cast: (size_t) (l2_mres_n + 1)) * c.sizeof(c.int)))
                if: l2_mres_addressed = 0 || l2_mres_called = 0 || l2_mres_called_mi = 0 || l2_mres_from = 0
                    return: 1
                l2_mres_from[l2_mres_n]: 0 - 1
                l2_mres_addressed[l2_mres_n]: 0
                l2_mres_called[l2_mres_n]: 0
                l2_mres_called_mi[l2_mres_n]: 0 - 1
                l2_mres_width[l2_mres_n]: 0
                res: l2_mres_n
                l2_mres_own[res]: own
                l2_mres_n: l2_mres_n + 1
            ---
            if: l2_mrs_width(res) = 0
                excluded: l2_own_excl
                l2_own_excl: own
                built: l2_mrs_build(res, stmt, mf)
                l2_own_excl: excluded
                if: built != 0
                    return: 1
            ---
        ---
        if: mf = 0 && stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0
            if: l2_merge_nested(stmt\as\frame\body, mi, stmt) != 0
                return: 1
            ---
        if: mf = 0 && stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\trailer != 0 && stmt\as\frame\trailer\body != 0
            if: l2_merge_scan(stmt\as\frame\trailer\body, mi) != 0
                return: 1
            ---
        ---
        field: l2_next_active(field\next)
    ---
return: 0

# steps/named-struct-exec.md, slice 3 and §12, R9: a unit-level method's native execution of named Structure ni --
# the Structure over itself through lmx_call_prim: its native word, the procedure's trampoline, runs with owner =
# data = the Structure; walked under the knob, the call is the walker's activation (lmx_walk_call_prim_dispatch).
# A status is an invariant here, as at every call that cannot throw (l2_emit_dyn_tail).
fn: l2_emit_ns_exec (int: ni; int: mi; const: @(LmP0Node node); const: @(char ind)) int
    []: char at 128
    if: c.sprintf(at, "lmx_arena_ref_struct(%s, %uU)", l2_unit_ref, (cast: (unsigned) (l2_ns_unit_slot(ni)))) < 0
        return: 1
return: l2_emit_ns_exec_at(ni, mi, node, ind, at)

# Slice 2c: method mi's execution of its own named Structure, the one own field oi holds -- its procedure over it, as a
# unit named Structure's over its unit child (l2_emit_ns_exec_at): the Structure the field holds now, its working value
# when it has one (l2_q<oi>), else its slot.
fn: l2_emit_local_exec (int: oi; int: mi; const: @(LmP0Node node); const: @(char ind)) int
    []: char slot 256
    []: char at 320
    []: char load_own 64
    L2Tx: load_tx
    @: L2Tx load l2_tx_local(@ load_tx, load_own, 64U)
    if: mi = l2_work_mi && l2_own_cached(mi, oi) != 0 && c.sprintf(at, "(cast: (@: Lmx) l2_q%d)", oi) < 0
        return: 1
    # K03 NS-ROLES-1b: a reference cell -- a binding `b: A` -- holds the Structure: its load, not a slot's.
    if: (mi != l2_work_mi || l2_own_cached(mi, oi) = 0) && l2_own_is_slot(oi) = 0
        if: l2_emit_path_load(mi, oi, ind, load) != 0 || c.snprintf(at, 320U, "(cast: (@: Lmx) %s)", load\data) < 0
            return: 1
        return: l2_emit_ns_exec_at(l2_own_call_origin(oi), mi, node, ind, at)
    if: (mi != l2_work_mi || l2_own_cached(mi, oi) = 0) && (l2_own_slot_at(oi, slot) != 0 || c.sprintf(at, "lmx_arena_ref_struct(%s)", slot) < 0)
        return: 1
return: l2_emit_ns_exec_at(l2_own_call_origin(oi), mi, node, ind, at)

# The execution of named Structure ni over the Structure `at` names: its procedure through lmx_call_prim, owner = data
# = that Structure.
fn: l2_emit_ns_exec_at (int: ni; int: mi; const: @(LmP0Node node); const: @(char ind); const: @(char at)) int
    int: k l2_nso_n
    int: pr
    int: nh
    int: j 0
    []: char hv_own 1024
    L2Tx: hv_tx
    @: L2Tx hv l2_tx_local(@ hv_tx, hv_own, 1024U)
    []: char ref_dest 128
    []: char occ 48
    l2_nso_n: l2_nso_n + 1
    pr: l2_ns_proc[ni]
    nh: l2_m_dyn[pr]
    # A procedure without arguments is one with hidden arguments (the author, 2026-09-28): each where the caller's
    # binding or the procedure's lexical source gives it (l2_hidden_from), in refs as its trampoline reads it -- a
    # number from a local of its type, a reference as itself.
    if: nh > 0 && c.fprintf(l2_out, "%s[]: @(void) l2_nsr%d %d\n", ind, k, nh) < 0
        return: 1
    # The occurrence this execution selects receives its free inputs in its own space (l2_admit_received): l2_nsn<k>.
    if: l2_free_admits(pr) != 0 && c.fprintf(l2_out, "%s@: Lmx l2_nsn%d (cast: (@: Lmx) %s)\n%sif: l2_nsn%d = 0\n%s    c.fprintf(c.stderr, \"lmx: invariant: an executed named Structure is absent\\n\")\n%s    c.abort()\n", ind, k, at, ind, k, ind, ind) < 0
        return: 1
    c.sprintf(occ, "l2_nsn%d", k)
    while: j < nh
        l2_tx_clear(hv)
        if: l2_hidden_from(mi, pr, j, 0 - 1, ind, hv, node) != 0
            return: 1
        # A free input is admitted where it is formed, as at a call (l2_emit_call_hides); a declared one keeps the
        # record of its declaration.
        if: l2_free_admit(pr, j) != 0 && l2_admit_received(mi, pr, j, occ, hv\data, ind) != 0
            return: 1
        c.sprintf(ref_dest, "l2_nsr%d[%d]", k, j)
        if: l2_emit_hidden_ref(l2_input_ft(pr, j), hv\data, ind, ref_dest) != 0
            return: 1
        j: j + 1
    ---
    # §7b: control passes to another callable -- the hidden inputs are evaluated above, so what is marked is published
    # now, before the call (book §12), as before every call (l2_emit_call): the procedure may read the caller's fields
    # through the graph (a method's own named Structure's `node\x`, slice 2c-4).
    if: l2_emit_publish(ind) != 0
        return: 1
    if: nh = 0 && c.fprintf(l2_out, "%s@: void l2_nso%d 0\n%sif: lmx_call_prim(l2_program_arena, %s, %s, 0, 0U, 0, @ l2_nso%d) != 0\n", ind, k, ind, at, at, k) < 0
        return: 1
    if: nh > 0 && c.fprintf(l2_out, "%s@: void l2_nso%d 0\n%sif: lmx_call_prim(l2_program_arena, %s, %s, l2_nsr%d, %dU, 0, @ l2_nso%d) != 0\n", ind, k, ind, at, at, k, nh, k) < 0
        return: 1
    if: c.fprintf(l2_out, "%s    c.fprintf(c.stderr, \"lmx: invariant: executing a named Structure reported a status\\n\")\n%s    c.abort()\n", ind, ind) < 0
        return: 1
return: l2_emit_poll(mi, ind)

# The nullary call of the Structure bound to t, emitted (l2_check_struct_call): an ordinary named Structure's own name
# executes it natively (l2_emit_ns_exec); an own field runs the same procedure
# over its bound Structure (l2_emit_local_exec).
fn: l2_emit_struct_call (const: @(LmP0Node node); const: @(LmP0Text t); int: mi; const: @(char ind)) int
    int: idx
    idx: l2_ns_exec_named(t, mi)
    if: idx >= 0 && l2_ns_exec[idx] != 0
        return: l2_emit_ns_exec(idx, mi, node, ind)
    idx: l2_local_ns_callee(t, mi)
    if: idx >= 0
        return: l2_emit_local_exec(idx, mi, node, ind)
    idx: l2_ns_exec_field(t, mi)
    if: idx >= 0
        return: l2_emit_local_exec(idx, mi, node, ind)
return: 0

# THE EXPRESSION STATEMENT, emitted (l2_check_discard; plan §3; FABLE-OPUS-DISCARD-20260924-147).
# One consumer for every expression in statement position: a bare atom, a run of fields, and a
# call Frame -- a callable head or a known external.  A callable atom is called with no arguments
# on the call path of `m()` (a void one too); a c.* or predef C call is emitted as a statement;
# anything else is evaluated on the value path (l2_prep, l2_eval_fields) and the value is dropped.  Its destination is the typed l2_tN the
# calls in it already declared; a pure expression declares none and emits nothing.
fn: l2_eval_discard (@: LmP0Field field; int: span; int: mi; const: @(char ind)) int
    @: LmP0Node e
    int: idx
    int: fi 0
    int: prc
    @: char ptext 0
    e: field\value
    # K03 S6: a path operand that selects a callable, written alone, is its nullary call on the occurrence the path
    # selects (l2_emit_path, sel 1), as `Holder\tick()` is.
    if: span > 1
        idx: l2_path_run_callee(field, span, mi, @ ptext)
        if: idx >= 0
            prc: l2_emit_path(ptext, strlen(ptext), mi, ind, e, @ l2_call_k)
            if: prc = 0
                prc: l2_emit_call(e, idx, 1, 0 - 1, 0, mi, ind, l2_tok, 0)
            l2_xfree((cast: (@: void) ptext))
            return: prc
        ---
    ---
    if: span = 1 && e\kind = c.LM_P0_NODE_ATOM
        idx: l2_atom_callee(e\as\atom, mi, @ fi)
        if: idx >= 0 && fi >= 0
            return: l2_emit_call(e, idx, 2, fi, 0, mi, ind, l2_tok, 0)
        # K03 NS-ROLES-1b: a binding `b: tick` named alone -- tick's call on the occurrence b holds.
        if: idx >= 0 && l2_call_alias_own(mi, e\as\atom) >= 0
            if: l2_emit_alias_self(l2_call_alias_own(mi, e\as\atom), mi, ind) != 0
                return: 1
            return: l2_emit_call(e, idx, 1, 0 - 1, 0, mi, ind, l2_tok, 0)
        if: idx >= 0
            return: l2_emit_call(e, idx, 0, 0 - 1, 0, mi, ind, l2_tok, 0)
        # A held callable named alone is its call with no actuals: the emission of `p0()`.
        if: l2_call_head_held(mi, e\as\atom) >= 0
            return: l2_prep_held_call(e, l2_call_head_held(mi, e\as\atom), mi, ind, l2_tok)
        return: l2_emit_struct_call(e, e\as\atom, mi, ind)
    # A c.* or predef C call whose value is dropped is emitted as a statement.  On the value
    # path (l2_prep) l2_emit_ccall writes the call into l2_tok for its consumer, and here there is
    # no consumer: the call would be lost (§GATE G3, steps/gate-measure-20260927.md).
    if: span = 1 && e\kind = c.LM_P0_NODE_FRAME && e\as != 0 && e\as\frame != 0 && l2_find_method(e\as\frame\head) < 0 && (l2_c_stmt_door(e\as\frame\head) != 0 || l2_predef_has_function(e\as\frame\head) != 0)
        return: l2_emit_ccall(e, mi, ind)
    if: span = 1
        return: l2_prep(e, mi, ind, l2_tok)
return: l2_eval_fields(field, span, mi, ind, l2_tok)

# A body with nothing to run: every statement in it is an expression with no call in it -- no
# callable atom, no call among its fields -- or such a body itself.  Its block emits no code.
fn: l2_body_inert (const: @(LmP0Structure body); int: mi) int
    @: LmP0Field f
    @: LmP0Node e
    int: n
    int: fi 0
    if: body = 0
        return: 1
    # A trailer is not part of first_field. Do not erase its semantics when
    # deciding whether native execution of the containing body can be omitted.
    if: body\trailer != 0
        return: 0
    f: l2_next_active(body\first_field)
    while: f != 0
        e: f\value
        n: l2_discard_run(f)
        if: n > 0
            if: n = 1 && e\kind = c.LM_P0_NODE_ATOM && (l2_atom_callee(e\as\atom, mi, @ fi) >= 0 || l2_call_head_held(mi, e\as\atom) >= 0)
                return: 0
            # steps/named-struct-exec.md, slice 2: executing a named Structure runs its body.
            if: n = 1 && e\kind = c.LM_P0_NODE_ATOM && l2_ns_exec_any(e\as\atom, mi) >= 0
                return: 0
            if: l2_fields_has_call(f, n) != 0
                return: 0
            f: l2_skip_span(f, n)
            continue
        if: e != 0 && e\kind = c.LM_P0_NODE_STRUCTURE && e\as != 0 && e\as\structure != 0 && l2_body_inert(e\as\structure, mi) != 0
            f: l2_next_active(f\next)
            continue
        return: 0
    ---
return: 1

fn: l2_emit_stmts (const: @(LmP0Structure body); @: LmP0Field from; @: LmP0Field stop; int: mi; const: @(char ind); int: empty_body) int
    L2Address: receiver_place
    LmP0Text: indirect_base
    L2ReferenceSource: return_source
    int: indirect_levels
    int: indirect_type
    int: indirect_model
    @: L2Declaration declaration
    long: emitted_from 0
    int: rbadmit 0
    int: pret 2
    int: excluded
    int: array_own
    int: array_status
    size_t: array_index
    L2ArrayPlace: array_place
    []: char array_ptr_own 1024
    L2Tx: array_ptr_tx
    @: L2Tx array_ptr l2_tx_local(@ array_ptr_tx, array_ptr_own, 1024U)
    []: char index_tok_own 64
    L2Tx: index_tok_tx
    @: L2Tx index_tok @ index_tok_tx
    @: LmP0Field field
    @: LmP0Field nxt
    @: LmP0Node stmt
    const: @: LmP0Frame fr
    @: LmP0Field last
    int: n
    int: k
    int: cst 0
    int: oi
    int: si
    int: fi
    int: sl
    int: rj 0
    int: raw 1
    int: ix 1
    int: pd 1
    int: need_cut 0
    @: LmP0Structure bd 0
    int: msf 0
    int: merge_own
    int: form
    int: span 0
    @: L2ReferenceSource merge_source
    []: char merge_source_token 128
    []: char merge_keep_n 64
    size_t: l2_pn 0U
    size_t: l2_pv 0U
    int: l2_pkind 0
    int: l2_ptype 0 - 1
    int: l2_pmodel 0 - 1
    int: l2_pni 0
    int: l2_pres 0
    int: l2_poi 0
    int: l2_proot 0
    int: l2_pfi 0
    int: l2_pown 0
    int: l2_prhs_lit 0
    int: l2_pw 0 - 1
    []: char l2_pbuf_own 1024
    @: char l2_pbuf 0
    size_t: l2_proom 0U
    []: char l2_pnm 1024
    []: char l2_pval_own 160
    L2Tx: l2_pval_tx
    @: L2Tx l2_pval l2_tx_local(@ l2_pval_tx, l2_pval_own, 160U)
    []: char l2_pval2_own 192
    L2Tx: l2_pval2_tx
    @: L2Tx l2_pval2 l2_tx_local(@ l2_pval2_tx, l2_pval2_own, 192U)
    []: char l2_dind_own 64
    @: char l2_dind 0
    []: char pdest_own 1024
    L2Tx: pdest_tx
    @: L2Tx pdest l2_tx_local(@ pdest_tx, pdest_own, 1024U)
    @: LmP0Text cname
    []: char l2_esd_tok 64
    []: char l2_bind_tok_own 1100
    L2Tx: l2_bind_tok_tx
    @: L2Tx l2_bind_tok l2_tx_local(@ l2_bind_tok_tx, l2_bind_tok_own, 1100U)
    int: mnp 0
    int: mq 0
    int: mslots 0
    int: ni 0
    @: LmP0Field bf 0
    @: LmP0Field call_head
    @: LmP0Structure call_body 0
    int: call_idx
    int: call_result
    int: bn 0
    int: retained
    @: char deep 0
    @: char wdeep 0
    []: char wcond_own 64
    []: char wkeep_own 64
    []: char wfirst_own 64
    L2Tx: wcond_tx
    L2Tx: wkeep_tx
    L2Tx: wfirst_tx
    @: L2Tx wcond @ wcond_tx
    @: L2Tx wkeep @ wkeep_tx
    @: L2Tx wfirst @ wfirst_tx
    if: empty_body != 0
        emitted_from: c.ftell(l2_out)
    if: body = 0
        return: 0
    if: l2_bump_ind(ind, @ deep) != 0
        return: 1
    field: from
    while: field != 0 && field != stop
        stmt: field\value
        l2_vis_stmt(mi, stmt)
        l2_here_at(stmt)
        pd: 1
        retained: l2_ns_constructed_row(mi, stmt)
        if: retained = -2
            return: 1
        if: retained >= 0
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "return") && need_cut != 0 && c.fprintf(l2_out, "%s---\n", ind) < 0
            return: 1
        if: l2_frame_head(stmt, "return") = 0 && l2_frame_head(stmt, "if") = 0
            need_cut: 0
        # An expression statement (l2_eval_discard); the walker moves past its whole run.
        n: l2_discard_run(field)
        if: n > 0
            if: l2_eval_discard(field, n, mi, ind) != 0
                return: 1
            field: l2_skip_span(field, n)
            continue
        # An anonymous `---` block is a nested executable body, like an if body (§14, Q14 K); one
        # with nothing to run (`()`, `(2 + 2)`: l2_body_inert) emits nothing -- its graph
        # Structure is built like every control body's, and an L1 `if:` needs a body.
        # A block closed by `until` (l2_block_until) is a postcondition loop: `while: keep` whose later turns begin with
        # the condition -- the first turn skips it (first), so the body runs at least once and a `continue` goes to the
        # condition -- and whose body runs while keep holds; the condition sees the block's fields (its scope).
        if: l2_block_until(stmt) != 0
            if: l2_tx_open(wkeep, wkeep_own, 64U) != 0
                return: 1
            if: l2_tx_open(wcond, wcond_own, 64U) != 0
                return: 1
            if: l2_tx_open(wfirst, wfirst_own, 64U) != 0
                return: 1
            if: l2_bump_ind(deep, @ wdeep) != 0
                return: 1
            if: l2_new_temp(ind, wkeep) != 0 || c.fprintf(l2_out, "%s%s: 1\n", ind, wkeep\data) < 0
                return: 1
            if: l2_new_temp(ind, wfirst) != 0 || c.fprintf(l2_out, "%s%s: 1\n", ind, wfirst\data) < 0
                return: 1
            if: l2_new_temp(ind, wcond) != 0
                return: 1
            if: c.fprintf(l2_out, "%swhile: %s\n%sif: %s = 0\n", ind, wkeep\data, deep, wfirst\data) < 0
                return: 1
            if: l2_scope_push(stmt) != 0
                return: 1
            if: l2_eval_cond(l2_block_until(stmt)\first_field, l2_count_active(l2_block_until(stmt)), mi, wdeep, wcond\data) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%sif: %s != 0\n%s    %s: 0\n%s---\n%s%s: 0\n%sif: %s\n", wdeep, wcond\data, wdeep, wkeep\data, wdeep, deep, wfirst\data, deep, wkeep\data) < 0
                l2_scope_pop()
                return: 1
            if: l2_emit_poll(mi, wdeep) != 0
                l2_scope_pop()
                return: 1
            l2_loop_depth: l2_loop_depth + 1
            if: l2_lp_push(0, 0 - 1) != 0 || l2_emit_body(stmt\as\structure, mi, wdeep, 1) != 0
                l2_loop_depth: l2_loop_depth - 1
                l2_scope_pop()
                return: 1
            l2_lp_pop()
            l2_loop_depth: l2_loop_depth - 1
            l2_scope_pop()
            if: c.fprintf(l2_out, "%send: while\n", ind) < 0
                return: 1
            if: l2_emit_loop_exit(0 - 1, ind) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0 && l2_body_inert(stmt\as\structure, mi) != 0
            field: l2_next_active(field\next)
            continue
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_STRUCTURE && stmt\as != 0 && stmt\as\structure != 0
            if: c.fprintf(l2_out, "%sif: 1\n", ind) < 0
                return: 1
            if: l2_scope_push(stmt) != 0
                return: 1
            if: l2_emit_body(stmt\as\structure, mi, deep, 1) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            if: c.fprintf(l2_out, "%s---\n", deep) < 0
                return: 1
            field: l2_next_active(field\next)
            need_cut: 1
            continue
        if: l2_frame_head(stmt, "throws")
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "throw")
            if: l2_emit_throw(stmt, mi, ind) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        oi: -1
        si: -1
        fi: -1
        sl: -1
        # K03 NS-ROLES-1b: a binding `b: tick` stores tick's occurrence in b's cell -- the unit's occurrence of tick, as
        # a callable formal receives it (l2_cf_actual_emit); tick runs not.
        if: l2_rb_meth_of(stmt) >= 0
            oi: l2_own_ref_decl(stmt, mi)
            if: oi < 0
                return: l2_error(l2_src, stmt, "internal: a reference binding to a method has no cell")
            if: l2_tok_method_occ(l2_rb_meth_of(stmt), l2_tok) != 0 || l2_own_store(mi, oi, ind, l2_tok\data) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # A reached reference declaration evaluates/admit its candidate before
        # binding the existing cell. Omission is zero on every execution.
        oi: l2_own_ref_decl(stmt, mi)
        if: oi >= 0
            declaration: l2_declaration(stmt)
            l2_own_excl: oi
            pret: l2_emit_reference_value_at(declaration\candidate, declaration\candidate_count, l2_ft_of_own(l2_own_ty[oi]), l2_own_nsty_get(oi), mi, ind, l2_tok, oi)
            l2_own_excl: -1
            if: pret != 0 || l2_own_store(mi, oi, ind, l2_tok\data) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # A callable-result binding is a field declaration whose value is the
        # Structure returned by its initializer. Use the same own cell and
        # expression lowering as any other declaration, in every native body.
        if: l2_mad_declaring(stmt, mi) != 0
            oi: 0
            while: oi < l2_own_n && (l2_own_decl[oi] != stmt || l2_own_mi[oi] != mi)
                oi: oi + 1
            ---
            if: oi >= l2_own_n
                return: l2_error(l2_src, stmt, "callable result field was not reserved")
            call_result: l2_emit_call(l2_receiver_call(stmt, 0), l2_store_host(stmt), 0, 0 - 1, l2_receiver_call(stmt, 0)\as\frame\body, mi, ind, l2_tok, 0)
            if: call_result != 0 || l2_own_store(mi, oi, ind, l2_tok\data) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # 19.17 merge at its execution site, the form R: merge: A B. The
        # statement head is the RESULT NAME; the merge frame is its single body
        # element. Leading atoms are operands; a trailing Structure would be the
        # result body fields and is refused below rather than silently dropped.
        #
        # In a source method, process_message is the compiler-selected dynamic
        # input carried by METHOD.sig. Failure throws the implicit name `merge`
        # (l2_emit_implicit_throw): no payload, status d + 1, and
        # the ordinary result is not published.
        if: l2_merge_declaration(body, stmt, mi) != 0
            n: l2_merge_arity(l2_merge_frame(stmt))
            if: n < 1
                return: l2_error(l2_src, stmt, "merge needs at least one operand")
            # The result body, when present, is built as a small Structure whose
            # children are the declared fields in source order, and handed to the
            # helper as its body operand. Only a size_t leaf is admitted, the same
            # restriction the qualified branches carry.
            bd: l2_merge_body(stmt)
            bn: 0
            if: bd != 0
                bn: l2_count_active(bd)
            if: bd != 0 && bn = 0
                return: l2_error(l2_src, stmt, "an empty merge result body is not a field list")
            if: bd != 0 && c.fprintf(l2_out, "%sl2_mbody: lmx_node_new_owned(l2_program_arena)\n%sif: l2_mbody = 0 || lmx_arena_refs_open_owned(l2_program_arena, l2_mbody, %dU) != 0\n", ind, ind, bn) < 0
                return: 1
            if: bd != 0 && l2_emit_implicit_throw(mi, "merge", ind) != 0
                return: 1
            bf: 0
            if: bd != 0
                bf: l2_next_active(bd\first_field)
            k: 0
            while: bf != 0
                if: l2_frame_head(bf\value, "size_t") = 0 || l2_count_active(bf\value\as\frame\body) != 2
                    return: l2_error(l2_src, stmt, "unsupported merge result body field")
                last: l2_next_active(bf\value\as\frame\body\first_field)
                last: l2_next_active(last\next)
                if: last\value = 0 || last\value\kind != c.LM_P0_NODE_ATOM || l2_num(last\value\as\atom) = 0
                    return: l2_error(l2_src, stmt, "a merge result body field needs a literal")
                if: c.fprintf(l2_out, "%sl2_mxp: lmx_arena_ref_cell(l2_mbody, %dU)\n%sif: l2_mxp = 0\n", ind, k, ind) < 0
                    return: 1
                if: l2_emit_invariant(ind, "merge result body has no cell for its field") != 0
                    return: 1
                if: c.fprintf(l2_out, "%sl2_mxp[0]: lmx_size_new_owned(l2_program_arena)\n%sif: l2_mxp[0] = 0\n", ind, ind) < 0
                    return: 1
                if: l2_emit_implicit_throw(mi, "merge", ind) != 0
                    return: 1
                if: c.fprintf(l2_out, "%sif: lmx_size_store_known(l2_mxp[0], %zuU) != 0\n", ind, l2_literal_value(last\value\as\atom)) < 0
                    return: 1
                if: l2_emit_invariant(ind, "merge result body field refused its value") != 0
                    return: 1
                bf: l2_next_active(bf\next)
                k: k + 1
            ---
            msf: l2_mres_decl(mi, stmt)
            if: msf < 0
                return: l2_error(l2_src, stmt, "merge result name was not reserved")
            merge_own: l2_mres_own[msf]
            merge_source: @ l2_mres_source[msf]
            strcpy(merge_source_token, "0")
            if: merge_source\layout != -1
                c.sprintf(merge_source_token, "(cast: (@: void) (l2_layout_tokens + %d))", l2_schema_token_slot(merge_source\layout))
            if: c.fprintf(l2_out, "%ssize_t: l2_mprofile_n%d 0U\n", ind, msf) < 0
                return: 1
            excluded: l2_own_excl
            l2_own_excl: merge_own
            k: 0
            while: k < n
                form: l2_merge_decl_operand(l2_merge_frame(stmt), k, mi, l2_src, @ last, @ span)
                if: form = 1
                    l2_own_excl: excluded
                    return: 1
                # READ-FIELD-CLOSURE: the operand's model, whose code the copy carries (l2_mu_operand_model).
                if: l2_mu_set(k, l2_mu_operand_model(last, span, form, mi)) != 0
                    l2_own_excl: excluded
                    return: 1
                # K03 S7b: a path or a call operand is evaluated once here, in operand order, before the merge runs.
                if: form = 2
                    if: l2_merge_operand_value(last, span, l2_own_ty[merge_own], mi, ind, l2_bind_tok) != 0 || c.fprintf(l2_out, "%sl2_mops[%dU]: (cast: (@: Lmx) %s)\n", ind, k, l2_bind_tok\data) < 0
                        l2_own_excl: excluded
                        return: 1
                    if: l2_emit_merge_profile(ind, msf, k) != 0
                        return: 1
                    k: k + 1
                    continue
                ---
                oi: l2_ebr_find(last\value\as\atom)
                # The operand must be identified BEFORE its width and literals are
                # read: this lookup used to sit at the bottom of the loop, so every
                # named operand contributed the PREVIOUS operand's fields.
                ni: l2_ns_find(last\value\as\atom)
                if: ni >= 0 && l2_ns_parent[ni] >= 0
                    ni: 0 - 1
                if: ni >= 0 && l2_ns_eternal[ni] >= 0
                    ni: 0 - 1
                sl: l2_resolved_own(mi, last\value\as\atom)
                if: sl >= 0
                    oi: -1
                # The result-slot map was built in the pre-scan, because a
                # method lowered before the entry E may already read a field of this
                # result. Nothing to add here.
                if: oi < 0 && sl < 0 && ni < 0
                    # K02: a formal operand -- the value the method's own code reads there.
                    fi: l2_param_find(mi, last\value\as\atom)
                    if: fi < 0
                        return: l2_error(l2_src, stmt, "unknown merge operand")
                    ---
                    if: l2_tok_formal(mi, fi, l2_bind_tok) != 0 || c.fprintf(l2_out, "%sl2_mops[%dU]: %s\n", ind, k, l2_bind_tok\data) < 0
                        l2_own_excl: excluded
                        return: 1
                    ---
                ---
                if: oi >= 0 && c.fprintf(l2_out, "%sl2_mops[%dU]: lmx_arena_ref_struct(%s, %uU)\n", ind, k, l2_unit_ref, (cast: (unsigned) (l2_ebr_unit_slot(oi)))) < 0
                    return: 1
                if: oi < 0 && sl >= 0
                    if: l2_own_load(sl, l2_bind_tok) != 0 || c.fprintf(l2_out, "%sl2_mops[%dU]: %s\n", ind, k, l2_bind_tok\data) < 0
                        l2_own_excl: excluded
                        return: 1
                    ---
                if: oi < 0 && sl < 0 && ni >= 0 && c.fprintf(l2_out, "%sl2_mops[%dU]: lmx_arena_ref_struct(%s, %uU)\n", ind, k, l2_unit_ref, (cast: (unsigned) (l2_ns_unit_slot(ni)))) < 0
                    return: 1
                # The actual operand, including a held alias, supplies its physical
                # profile. This is the same runtime classification as PRIM_PUB.
                if: l2_emit_merge_profile(ind, msf, k) != 0
                    return: 1
                k: k + 1
            ---
            l2_own_excl: excluded
            if: c.sprintf(merge_keep_n, "l2_mprofile_n%d", msf) < 0 || l2_emit_keep(ind, "l2_mprofiles", merge_keep_n) != 0
                return: 1
            if: bd = 0 && c.fprintf(l2_out, "%sl2_mbody: 0\n", ind) < 0
                return: 1
            sl: msf
            # The pairs are the result-slot map's (l2_mrs_build): the model's
            # slots, the fields the later operands added, the body fields; a pair writes a later
            # operand's field INTO a model slot (the author's merge rule, plan §4).
            mnp: 0
            mq: 0
            while: mq < l2_msrc_n
                if: l2_msrc_res[mq] = sl && l2_msrc_pair[mq] != 0 && c.fprintf(l2_out, "%sl2_mpp[%dU]: @ l2_mpv[%dU]\n%sl2_mpp[%dU]\\model_slot: %dU\n%sl2_mpp[%dU]\\operand: %dU\n%sl2_mpp[%dU]\\field: %dU\n", ind, mnp, mnp, ind, mnp, l2_msrc_slot[mq], ind, mnp, l2_msrc_op[mq], ind, mnp, l2_msrc_fld[mq]) < 0
                    return: 1
                if: l2_msrc_res[mq] = sl && l2_msrc_pair[mq] != 0
                    mnp: mnp + 1
                mq: mq + 1
            ---
            # §7b: merge copies graph state (the walk's PRIM) -- what is marked is published before it.
            if: l2_emit_publish(ind) != 0
                return: 1
            # READ-FIELD-CLOSURE: the uses of the operands' copied code; none, and the chains are links only.
            if: l2_merge_uses_native(ind, msf, n, @ mq, @ mslots) != 0
                return: 1
            if: mq > 0 && mnp = 0 && c.fprintf(l2_out, "%sl2_mstatus: lmx_merge_used_owned(l2_mops, %dU, l2_mbody, l2_program_arena, l2_program_arena, l2_mprofiles, l2_mprofile_n%d, l2_mua%d, l2_muk%d, l2_mus%d, l2_mul%d, %dU, %dU, 0, 0U, @ l2_mresult)\n", ind, n, msf, msf, msf, msf, msf, mq, mslots) < 0
                return: 1
            if: mq > 0 && mnp > 0 && c.fprintf(l2_out, "%sl2_mstatus: lmx_merge_used_owned(l2_mops, %dU, l2_mbody, l2_program_arena, l2_program_arena, l2_mprofiles, l2_mprofile_n%d, l2_mua%d, l2_muk%d, l2_mus%d, l2_mul%d, %dU, %dU, l2_mpp, %dU, @ l2_mresult)\n", ind, n, msf, msf, msf, msf, msf, mq, mslots, mnp) < 0
                return: 1
            if: mq = 0 && mnp = 0 && c.fprintf(l2_out, "%sl2_mstatus: lmx_merge_profiles_owned(l2_mops, %dU, l2_mbody, l2_program_arena, l2_program_arena, l2_mprofiles, l2_mprofile_n%d, 0, 0U, @ l2_mresult)\n", ind, n, msf) < 0
                return: 1
            if: mq = 0 && mnp > 0 && c.fprintf(l2_out, "%sl2_mstatus: lmx_merge_profiles_owned(l2_mops, %dU, l2_mbody, l2_program_arena, l2_program_arena, l2_mprofiles, l2_mprofile_n%d, l2_mpp, %dU, @ l2_mresult)\n", ind, n, msf, mnp) < 0
                return: 1
            if: c.fprintf(l2_out, "%sif: l2_mstatus != 0 || l2_mresult = 0\n", ind) < 0
                return: 1
            if: l2_emit_implicit_throw(mi, "merge", ind) != 0
                return: 1
            if: c.fprintf(l2_out, "%sif: lmx_merge_result_layout(l2_program_arena, l2_mresult, l2_mops, %dU, (cast: (@: void) (l2_layout_tokens + %d)), %s) != c.LMX_IMPLEMENTS_YES\n", ind, n, l2_schema_token_slot(l2_schema_merge(msf)), merge_source_token) < 0
                return: 1
            if: l2_emit_invariant(ind, "successful merge has conflicting producer evidence") != 0 || l2_own_store(mi, merge_own, ind, "l2_mresult") != 0
                return: 1
            field: l2_next_active(field\next)
            need_cut: 1
            continue
        ---
        # CHECK and both backends use the same original Array/index contract.
        array_status: l2_array_place(stmt, mi, @ array_place)
        if: array_status = 3
            return: 1
        if: array_status = 2
            return: l2_error(l2_src, stmt, "unsupported indexed Array operand contract")
        if: array_status = 0
            if: l2_emit_array_place(stmt, mi, ind, @ array_place) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # An indexed final segment (root\name[idx]) is a case of the own
        # array store, tried before FIELD PATHS below exactly as
        # l2_check_body already orders its own copy of this same check
        # ahead of the path guards (FABLE-SONNET-ARRAY-WRITE-DISPATCH-
        # 20260923-119): an Array-typed own field followed by an index is
        # not a competing path that needs the head to have escaped
        # l2_is_path_head, it is resolved first, uniformly, whether or not
        # the root is also a general path root (fresh\buf[0], not just the
        # legacy node\/for\).
        array_status: 1
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && l2_tx_open(index_tok, index_tok_own, 64U) = 0
            array_status: l2_emit_own_index(stmt\as\frame\head, mi, ind, @ array_own, index_tok)
        if: array_status = 2
            return: l2_error(l2_src, stmt, "an own array index could not be emitted")
        if: array_status = 0
            fr: stmt\as\frame
            # A value of another number type: the receiver is called on it and its result stored (3: the call is emitted),
            # as for a write through a path (OPUS-PATHCONV-20260929-10).
            cst: l2_convert_value_to(mi, l2_ft_of_own(l2_rw_elem_ty(array_own)), stmt, fr, ind)
            if: cst = 1
                return: 1
            if: cst = 2
                return: l2_error(l2_src, stmt, "mixed numeric types (a conversion)")
            if: cst != 3 && l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
                return: 1
            if: l2_emit_array_ptr(array_own, ind, array_ptr) != 0
                return: 1
            if: c.fprintf(l2_out, "%s%s[%s]: %s\n", ind, array_ptr\data, index_tok\data, l2_tok\data) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        ---
        # ---------------------------------------------------------------
        # FIELD PATHS. In UPDATE position the whole path is the statement head
        # and the single body item is the value:  R\x: 5U
        # In VALUE position it is the body of an ordinary assignment, spelled
        # as atoms around separator atoms:        v: R\x
        # Both roots are reserved children of the program UNIT, which inside a
        # method is its fixed above-method lexical space rather than a name in
        # scope.
        # l2_emit_path spells that root through l2_unit_ref, so the same walk
        # serves every method body, the entry E included.
        # ---------------------------------------------------------------
        l2_pn: 0U
        if: stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && l2_is_path_head(stmt\as\frame\head) != 0 && l2_head_is_call(stmt\as\frame\head, stmt\as\frame\body, stmt\as\frame\flags, mi) = 0 && l2_raw_index_head(stmt\as\frame\head, mi) != 0
            if: l2_path_in_eternal(stmt\as\frame\head\data, stmt\as\frame\head\length) != 0
                return: l2_error(l2_src, stmt, "an eternal branch field cannot be updated")
            if: l2_emit_path(stmt\as\frame\head\data, stmt\as\frame\head\length, mi, ind, stmt, @ l2_pkind) != 0
                return: 1
            # A literal RHS parses directly. Any other shape (a name, a call, an
            # expression) evaluates through l2_eval_fields exactly like an
            # ordinary own-field assignment's RHS does -- the generality the old
            # node/for write block had (FABLE-L2-ARG-ADDRESS-DIRTY-20260921-67's
            # `node\x: hi` case), lost when FABLE-SONNET-NODE-ROOT-20260923-121
            # folded node/for writes into this general path-write branch (which
            # only ever parsed a literal), restored here rather than left a
            # silent narrowing of what a path write accepts.
            if: l2_path_rhs_range(stmt\as\frame\body, l2_pkind, stmt) != 0
                return: 1
            l2_prhs_lit: l2_path_rhs(stmt\as\frame\body, l2_pkind, @ l2_pv) = 0
            # The target's cell is kept in a variable of its own while the value is evaluated -- a value that reads a path
            # moves l2_pxp itself (`b\v: c\v` stored into c's cell) -- and put back for the store below.
            l2_pw: 0 - 1
            if: l2_prhs_lit = 0
                l2_pw: l2_pw_n
                l2_pw_n: l2_pw_n + 1
                if: c.fprintf(l2_out, "%s@@: void l2_pw%d l2_pxp\n", ind, l2_pw) < 0
                    return: 1
                ---
            # A number of another type has the store's conversion edge (OPUS-PATHCONV-20260929-10), as a write to an
            # own field has: the receiver is called on the value and its result is stored (3: the call is emitted).
            cst: 0
            if: l2_pkind = 10 || l2_pkind = 11
                l2_pkind: l2_path_contract(stmt\as\frame\head\data, stmt\as\frame\head\length, @ l2_ptype, @ l2_pmodel)
                if: l2_emit_reference_value(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), l2_ptype, l2_pmodel, mi, ind, l2_tok) != 0
                    return: 1
                cst: 3
            ---
            if: l2_prhs_lit = 0 && cst != 3
                cst: l2_convert_value_to(mi, l2_path_kind_ft(l2_pkind), stmt, stmt\as\frame, ind)
            if: cst = 1
                return: 1
            if: cst = 2
                return: l2_error(l2_src, stmt, "mixed numeric types (a conversion)")
            if: l2_prhs_lit = 0 && cst != 3 && l2_eval_fields(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), mi, ind, l2_tok) != 0
                return: 1
            if: l2_pw >= 0 && c.fprintf(l2_out, "%sl2_pxp: l2_pw%d\n", ind, l2_pw) < 0
                return: 1
            # Explicit paths write the real typed cell in place. They do not
            # update a separately loaded working value or substitute its cell.
            if: l2_pkind = 0 && l2_prhs_lit != 0 && c.fprintf(l2_out, "%sif: lmx_size_store_known(l2_pxp[0], %zuU) != 0\n", ind, l2_pv) < 0
                return: 1
            if: l2_pkind = 0 && l2_prhs_lit = 0 && c.fprintf(l2_out, "%sif: lmx_size_store_known(l2_pxp[0], %s) != 0\n", ind, l2_tok\data) < 0
                return: 1
            if: l2_pkind = 1 && l2_prhs_lit != 0 && c.fprintf(l2_out, "%sif: lmx_char_store_known(l2_pxp[0], %d) != 0\n", ind, (cast: (int) l2_pv)) < 0
                return: 1
            if: l2_pkind = 1 && l2_prhs_lit = 0 && c.fprintf(l2_out, "%sif: lmx_char_store_known(l2_pxp[0], (cast: (int) %s)) != 0\n", ind, l2_tok\data) < 0
                return: 1
            if: l2_pkind = 7 && l2_prhs_lit != 0 && c.fprintf(l2_out, "%sif: lmx_int_store_known(l2_pxp[0], %d) != 0\n", ind, (cast: (int) l2_pv)) < 0
                return: 1
            if: l2_pkind = 7 && l2_prhs_lit = 0 && c.fprintf(l2_out, "%sif: lmx_int_store_known(l2_pxp[0], %s) != 0\n", ind, l2_tok\data) < 0
                return: 1
            if: l2_pkind = 8 && l2_prhs_lit != 0 && c.fprintf(l2_out, "%sif: lmx_unsigned_store_known(l2_pxp[0], %zuU) != 0\n", ind, l2_pv) < 0
                return: 1
            if: l2_pkind = 8 && l2_prhs_lit = 0 && c.fprintf(l2_out, "%sif: lmx_unsigned_store_known(l2_pxp[0], %s) != 0\n", ind, l2_tok\data) < 0
                return: 1
            if: l2_pkind = 9 && l2_prhs_lit != 0 && c.fprintf(l2_out, "%sif: lmx_ulong_store_known(l2_pxp[0], %zuU) != 0\n", ind, l2_pv) < 0
                return: 1
            if: l2_pkind = 9 && l2_prhs_lit = 0 && c.fprintf(l2_out, "%sif: lmx_ulong_store_known(l2_pxp[0], %s) != 0\n", ind, l2_tok\data) < 0
                return: 1
            # A reference field (FABLE-SONNET-SEND-REF-20260925-172 commit 1,
            # RESTORED in commit 4: l2_pxp is the SLOT's own address (a
            # pointer CELL's address per the author's Q26.2 ruling -- a
            # reference is a reference TO a reference, not the pointee
            # stored directly), so the store goes THROUGH the cell like any
            # other own-storage pointer write. Never a literal RHS
            # (l2_path_rhs does not recognize one for this kind), so only
            # the l2_eval_fields token side applies.
            if: (l2_pkind = 10 || l2_pkind = 11) && c.fprintf(l2_out, "%sif: lmx_pointer_store_known(l2_pxp[0], (cast: (@: void) %s)) != 0\n", ind, l2_tok\data) < 0
                return: 1
            if: l2_emit_path_bail(mi, ind) != 0
                return: 1
            field: l2_next_active(field\next)
            need_cut: 1
            continue
        ---
        if: stmt != 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\body != 0
            l2_proom: l2_atoms_len(stmt\as\frame\body\first_field, -1) + 1U
            l2_pbuf: l2_text_room(l2_proom, l2_pbuf_own, 1024U)
            if: l2_pbuf = 0
                return: l2_alloc_or(l2_src, stmt, "out of memory")
            l2_pn: l2_join_path(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), l2_pbuf, l2_proom - 1U)
        # A field path is an ordinary expression: it only claims this statement
        # when the head is a real declared own field (an assignment into that
        # field). Any other head (return, a call argument, ...) falls through
        # to the general expression-value handling below -- a field path used
        # there resolves and reads through l2_eval_fields like any other value.
        # A path to a number field stored into an own field of another number type is a conversion, and a path to a
        # reference field is a reference: the general store below makes both (l2_convert_on_store; the reference read,
        # l2_path_text_read), as for any value (l2_path_store_general).
        if: l2_pn != 0U && l2_path_root(l2_pbuf, l2_pn, @ l2_pni, @ l2_pres, @ l2_poi, @ l2_proot, @ l2_pfi) = 0 && l2_own_visible(mi, stmt\as\frame\head) >= 0 && l2_path_store_general(mi, stmt\as\frame\head, l2_pbuf, l2_pn) = 0
            if: l2_emit_path(l2_pbuf, l2_pn, mi, ind, stmt, @ l2_pkind) != 0
                return: 1
            # The destination is an OWN field, stored into its cell like any
            # other own-field assignment. Nothing here is a new category.
            l2_pown: l2_own_visible(mi, stmt\as\frame\head)
            if: l2_pown < 0
                return: l2_error(l2_src, stmt, "a field path value needs a declared destination")
            if: l2_pown >= 0 && l2_pkind = 0 && l2_own_ty[l2_pown] != 2
                return: l2_error(l2_src, stmt, "a size_t field needs a size_t local")
            if: l2_pown >= 0 && l2_pkind = 1 && l2_own_ty[l2_pown] != 1
                return: l2_error(l2_src, stmt, "a char field needs a char local")
            if: l2_pown >= 0 && l2_pkind = 7 && l2_own_ty[l2_pown] != 0
                return: l2_error(l2_src, stmt, "an int field needs an int local")
            if: l2_pown >= 0 && l2_pkind = 8 && l2_own_ty[l2_pown] != 3
                return: l2_error(l2_src, stmt, "an unsigned field needs an unsigned local")
            if: l2_pown >= 0 && l2_pkind = 9 && l2_own_ty[l2_pown] != 36
                return: l2_error(l2_src, stmt, "a ulong field needs a ulong local")
            if: l2_pkind = 0 && l2_tx_set(l2_pval, "lmx_size_value_known(l2_pxp[0])") != 0
                return: 1
            if: l2_pkind = 1 && l2_tx_set(l2_pval, "(cast: (char) lmx_char_value_known(l2_pxp[0]))") != 0
                return: 1
            if: l2_pkind = 7 && l2_tx_set(l2_pval, "lmx_int_value_known(l2_pxp[0])") != 0
                return: 1
            if: l2_pkind = 8 && l2_tx_set(l2_pval, "lmx_unsigned_value_known(l2_pxp[0])") != 0
                return: 1
            if: l2_pkind = 9 && l2_tx_set(l2_pval, "lmx_ulong_value_known(l2_pxp[0])") != 0
                return: 1
            # The value goes to the own field's working value, or to its cell when it has none (l2_own_store, §7b).
            if: l2_own_direct(mi, l2_pown) != 0 && l2_own_store(mi, l2_pown, ind, l2_pval\data) != 0
                return: 1
            # Every field the checks above admit has a cell (l2_own_direct): a field without one is the translator's
            # own broken promise.
            if: l2_own_direct(mi, l2_pown) = 0
                return: l2_error(l2_src, stmt, "internal: an own field with no cell")
            field: l2_next_active(field\next)
            need_cut: 1
            continue
        ---

        if: l2_frame_head(stmt, "if")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: l2_eval_fields(fr\body\first_field, n - 1, mi, ind, l2_tok) != 0
                return: 1
            if: c.fprintf(l2_out, "%sif: %s\n", ind, l2_tok\data) < 0
                return: 1
            if: l2_scope_push(last\value) != 0
                return: 1
            if: l2_emit_body(last\value\as\structure, mi, deep, 1) != 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            # The P0 tree has already consumed indentation cutters, so every
            # emitted nested body needs an explicit L1 cutter before its next
            # sibling. Depending on fr.trailer loses source `---` tokens.
            if: c.fprintf(l2_out, "%s---\n", deep) < 0
                return: 1
            nxt: l2_next_active(field\next)
            if: nxt != 0 && l2_frame_head(nxt\value, "else") && c.fprintf(l2_out, "%selse:\n", ind) < 0
                return: 1
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                if: l2_scope_push(nxt\value) != 0
                    return: 1
                if: l2_emit_body(nxt\value\as\frame\body, mi, deep, 1) != 0
                    l2_scope_pop()
                    return: 1
                l2_scope_pop()
                if: c.fprintf(l2_out, "%s---\n", deep) < 0
                    return: 1
                ---
            if: nxt != 0 && l2_frame_head(nxt\value, "else")
                field: l2_next_active(nxt\next)
            if: nxt = 0 || l2_frame_head(nxt\value, "else") = 0
                field: nxt
            need_cut: 1
            ---
        if: l2_frame_head(stmt, "while")
            fr: stmt\as\frame
            n: l2_count_active(fr\body)
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < n
                last: l2_next_active(last\next)
                k: k + 1
            if: l2_tx_open(wkeep, wkeep_own, 64U) != 0
                return: 1
            if: l2_tx_open(wcond, wcond_own, 64U) != 0
                return: 1
            if: l2_bump_ind(deep, @ wdeep) != 0
                return: 1
            if: l2_new_temp(ind, wkeep) != 0
                return: 1
            if: c.fprintf(l2_out, "%s%s: 1\n", ind, wkeep\data) < 0
                return: 1
            if: l2_new_temp(ind, wcond) != 0
                return: 1
            if: c.fprintf(l2_out, "%swhile: %s\n", ind, wkeep\data) < 0
                return: 1
            if: l2_eval_cond(fr\body\first_field, n - 1, mi, deep, wcond\data) != 0
                return: 1
            if: c.fprintf(l2_out, "%sif: %s = 0\n", deep, wcond\data) < 0
                return: 1
            if: c.fprintf(l2_out, "%s    %s: 0\n", deep, wkeep\data) < 0
                return: 1
            if: c.fprintf(l2_out, "%sif: %s\n", deep, wkeep\data) < 0
                return: 1
            if: l2_emit_poll(mi, wdeep) != 0
                return: 1
            l2_loop_depth: l2_loop_depth + 1
            if: l2_scope_push(last\value) != 0 || l2_lp_push(0, 0 - 1) != 0
                l2_loop_depth: l2_loop_depth - 1
                return: 1
            if: l2_emit_body(last\value\as\structure, mi, wdeep, 1) != 0
                l2_scope_pop()
                l2_loop_depth: l2_loop_depth - 1
                return: 1
            l2_lp_pop()
            l2_scope_pop()
            l2_loop_depth: l2_loop_depth - 1
            if: c.fprintf(l2_out, "%send: while\n", ind) < 0
                return: 1
            if: l2_emit_loop_exit(0 - 1, ind) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "for")
            fr: stmt\as\frame
            if: l2_for_cstyle(stmt) = 0
                return: 1
            last: l2_next_active(fr\body\first_field)
            if: l2_scope_push(stmt) != 0
                return: 1
            if: l2_tx_open(wkeep, wkeep_own, 64U) != 0
                return: 1
            if: l2_tx_open(wcond, wcond_own, 64U) != 0
                return: 1
            if: l2_tx_open(wfirst, wfirst_own, 64U) != 0
                return: 1
            if: l2_bump_ind(deep, @ wdeep) != 0
                l2_scope_pop()
                return: 1
            declaration: l2_declaration(last\value)
            oi: l2_own_find_decl(mi, declaration\name, last\value)
            if: oi < 0
                l2_scope_pop()
                return: 1
            # The header contains an ordinary declaration. Its candidate,
            # input carry and no-action cases use the same statement emitter
            # as any other declaration; no compulsory FOR initializer.
            if: l2_emit_stmts(fr\body, last, l2_next_active(last\next), mi, ind, 0) != 0
                l2_scope_pop()
                return: 1
            if: l2_own_direct(mi, oi) = 0
                l2_scope_pop()
                return: l2_error(l2_src, stmt, "internal: an own field with no cell")
            last: l2_next_active(last\next)
            if: l2_new_temp(ind, wkeep) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%s%s: 1\n", ind, wkeep\data) < 0
                l2_scope_pop()
                return: 1
            if: l2_new_temp(ind, wfirst) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%s%s: 1\n", ind, wfirst\data) < 0
                l2_scope_pop()
                return: 1
            if: l2_new_temp(ind, wcond) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%swhile: %s\n", ind, wkeep\data) < 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%sif: %s = 0\n", deep, wfirst\data) < 0
                l2_scope_pop()
                return: 1
            nxt: l2_next_active(last\next)
            if: nxt = 0 || nxt\value = 0 || nxt\value\kind != c.LM_P0_NODE_ATOM
                l2_scope_pop()
                return: 1
            l2_here_at_method(mi, nxt\value)
            si: l2_own_visible(mi, nxt\value\as\atom)
            if: si < 0
                l2_scope_pop()
                return: 1
            nxt: l2_next_active(nxt\next)
            # The counter steps in its working value, or in its cell when it has none (§7b).  Its step is indented one
            # level below the body, as deep as the loops are nested: in memory of its own size (SPRINTF-PAST-BUFFER).
            if: l2_own_direct(mi, si) != 0
                l2_dind: l2_text_room(strlen(deep) + 5U, l2_dind_own, 64U)
                if: l2_dind = 0
                    l2_scope_pop()
                    return: l2_alloc_or(l2_src, stmt, "out of memory")
                if: c.snprintf(l2_dind, strlen(deep) + 5U, "%s    ", deep) < 0 || l2_own_load(si, l2_pval) != 0
                    l2_scope_pop()
                    return: 1
                if: nxt != 0 && nxt\value != 0 && l2_text_eq(nxt\value\as\atom, "--") && l2_tx_join(l2_pval2, l2_pval\data, " - 1", 0, 0, 0) != 0
                    l2_scope_pop()
                    return: 1
                if: (nxt = 0 || nxt\value = 0 || l2_text_eq(nxt\value\as\atom, "--") = 0) && l2_tx_join(l2_pval2, l2_pval\data, " + 1", 0, 0, 0) != 0
                    l2_scope_pop()
                    return: 1
                if: l2_own_store(mi, si, l2_dind, l2_pval2\data) != 0
                    l2_scope_pop()
                    return: 1
            ---
            if: l2_own_direct(mi, si) = 0
                l2_scope_pop()
                return: l2_error(l2_src, stmt, "internal: an own field with no cell")
            if: c.fprintf(l2_out, "%s%s: 0\n", deep, wfirst\data) < 0
                l2_scope_pop()
                return: 1
            if: last\value = 0 || last\value\kind != c.LM_P0_NODE_STRUCTURE || last\value\as = 0
                l2_scope_pop()
                return: 1
            if: l2_eval_cond(last\value\as\structure\first_field, l2_count_active(last\value\as\structure), mi, deep, wcond\data) != 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%sif: %s = 0\n", deep, wcond\data) < 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%s    %s: 0\n", deep, wkeep\data) < 0
                l2_scope_pop()
                return: 1
            if: c.fprintf(l2_out, "%sif: %s\n", deep, wkeep\data) < 0
                l2_scope_pop()
                return: 1
            if: l2_emit_poll(mi, wdeep) != 0
                l2_scope_pop()
                return: 1
            last: l2_next_active(fr\body\first_field)
            k: 1
            while: k < 5
                last: l2_next_active(last\next)
                k: k + 1
            l2_loop_depth: l2_loop_depth + 1
            if: l2_lp_push(0, 0 - 1) != 0 || last = 0 || last\value = 0 || last\value\as = 0 || l2_emit_body(last\value\as\structure, mi, wdeep, 1) != 0
                l2_loop_depth: l2_loop_depth - 1
                l2_scope_pop()
                return: 1
            l2_lp_pop()
            l2_loop_depth: l2_loop_depth - 1
            if: c.fprintf(l2_out, "%send: while\n", ind) < 0
                l2_scope_pop()
                return: 1
            l2_scope_pop()
            if: l2_emit_loop_exit(0 - 1, ind) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # K03: `continue`, `break` and `return` with no written argument -- the bare word or its empty Frame, one
        # application (l2_stmt_word) -- are emitted here, one consumer for both spellings.
        if: l2_stmt_word(stmt, mi, "continue") != 0 && l2_count_active(l2_app_actuals(stmt)) = 0
            if: l2_lp_n > 0 && l2_lpk[l2_lp_n - 1] = 1 && c.fprintf(l2_out, "%sl2_uc%d: 1\n%sbreak\n", ind, l2_lpp[l2_lp_n - 1], ind) < 0
                return: 1
            if: (l2_lp_n = 0 || l2_lpk[l2_lp_n - 1] = 0) && c.fprintf(l2_out, "%scontinue\n", ind) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_stmt_word(stmt, mi, "break") != 0 && l2_count_active(l2_app_actuals(stmt)) = 0
            if: l2_lp_n > 0 && l2_lpk[l2_lp_n - 1] = 1 && c.fprintf(l2_out, "%sl2_ub%d: 1\n%sbreak\n", ind, l2_lpp[l2_lp_n - 1], ind) < 0
                return: 1
            if: (l2_lp_n = 0 || l2_lpk[l2_lp_n - 1] = 0) && c.fprintf(l2_out, "%sbreak\n", ind) < 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_stmt_word(stmt, mi, "return") != 0 && l2_count_active(l2_app_actuals(stmt)) = 0 && l2_m_ret[mi] = 8
            # §7b: a return is an exit -- what is marked is published before it (book §14).
            if: l2_emit_publish(ind) != 0 || l2_emit_poll(mi, ind) != 0
                return: 1
            if: l2_emit_empty_return(mi, ind) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        if: l2_stmt_word(stmt, mi, "return") != 0 && l2_count_active(l2_app_actuals(stmt)) = 0
            return: 1
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0
            pd: l2_prefix_deref(stmt\as\frame\head, mi, ind, pdest)
        if: pd = 0
            fr: stmt\as\frame
            if: fr\body = 0 || fr\trailer != 0 || fr\body\trailer != 0
                return: 1
            cst: 0
            indirect_model: -1
            if: l2_deref_word(fr\head, mi, @ indirect_base, @ indirect_levels, @ indirect_type) = 0
                if: l2_capture_indirect_place(indirect_type, ind, pdest) != 0
                    return: 1
                indirect_model: l2_contract_model_depth(l2_binding_contract(mi, @ indirect_base), 0, indirect_levels)
                cst: l2_convert_value_to(mi, indirect_type, stmt, fr, ind)
                if: cst = 1 || cst = 2
                    return: 1
                if: cst = 0 && l2_pointer_depth(indirect_type) > 0
                    if: l2_emit_reference_value(fr\body\first_field, l2_count_active(fr\body), indirect_type, indirect_model, mi, ind, l2_tok) != 0
                        return: 1
                    cst: 3
                ---
            ---
            if: cst = 0 && l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
                return: 1
            if: c.fprintf(l2_out, "%s%s: %s\n", ind, pdest\data, l2_tok\data) < 0
                return: 1
            field: l2_next_active(field\next)
            pd: 1
            continue
        ---
        ix: 1
        if: stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0
            ix: l2_index_head(stmt\as\frame\head, mi)
        if: ix = 0
            fr: stmt\as\frame
        if: ix = 0 && (fr\body = 0 || fr\trailer != 0)
            return: 1
        if: ix = 0 && l2_eval_fields(fr\body\first_field, l2_count_active(fr\body), mi, ind, l2_tok) != 0
            return: 1
        if: ix = 0 && l2_emit_index_place(fr\head, mi, ind, array_ptr) != 0
            return: 1
        if: ix = 0 && c.fprintf(l2_out, "%s%s: %s\n", ind, array_ptr\data, l2_tok\data) < 0
            return: 1
        if: ix = 0
            field: l2_next_active(field\next)
            continue
        if: l2_frame_head(stmt, "continue") || l2_frame_head(stmt, "break")
            return: 1
        n: l2_emit_loc_stmt(stmt, mi, ind)
        if: n = 2
            return: 1
        if: n = 0
            field: l2_next_active(field\next)
            continue
        # sendMessage: X (FABLE-SONNET-SEND-IN-METHODS-20260925-168 commit 2) -- see
        # l2_emit_msend's own comment; l2_check_body already validated and registered the shape.
        if: l2_frame_head(stmt, "sendMessage") != 0
            if: l2_emit_msend(stmt, mi, ind) != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # receiveMessage: m -- take the next admitted letter of the current Thread
        # (the owner attaches its arena before exposing it) and assign m its
        # graph, or 0 when the inbox is empty: m's slot takes it (l2_own_store; -189
        # c3b-3, an own Structure field is a direct slot).  A slot that cannot be
        # stored is an invariant failure (X1, -128), never a throw.
        if: l2_receive_msg_shape(stmt, @ cname, 0) = 0
            if: l2_receiver_output_place(stmt, mi, @ receiver_place) != 0
                return: l2_error(l2_src, stmt, "unresolved name")
            oi: receiver_place.index
            if: c.fprintf(l2_out, "%sl2_nmsg: (cast: (@: LmxMsg) lmx_thread_mail_take(lmx_thread_current(), c.LMX_POST_INBOX))\n%sl2_ngraph: 0\n%sif: l2_nmsg != 0\n%s    l2_ngraph: l2_nmsg\\graph\n", ind, ind, ind, ind) < 0
                return: 1
            # A field of a declared Structure type, in the one-name form `T: m` / `receiveMessage:
            # m`, takes the letter's payload, admitted to its type (D-57; q25 (ii): the field holds
            # what its declaration says).  The two-name form `receiveMessage: m T` (-172 c2) types m
            # with the synthesized letter model, and m holds the whole letter.
            if: l2_own_nsty_get(oi) >= 0 && l2_count_active(stmt\as\frame\body) = 1 && c.fprintf(l2_out, "%sl2_ngraph: (cast: (@: Lmx) lmx_arena_ref_value(l2_ngraph, 1U))\n", ind) < 0
                return: 1
            if: l2_own_nsty_get(oi) >= 0 && l2_emit_admit(mi, l2_own_nsty_get(oi), "l2_ngraph", ind) != 0
                return: 1
            if: l2_own_store(mi, oi, ind, "l2_ngraph") != 0
                return: 1
            field: l2_next_active(field\next)
            continue
        # `f()`/`f: ()`/closed empty vertical, name absent (FABLE-SONNET-
        # EMPTY-STRUCT-20260923-132): the row l2_check_body already
        # registered gets a fresh, genuinely empty Lmx node every
        # activation -- the same lmx_node_new_owned the unit root and a
        # merge result body use, but with NO lmx_arena_refs_open_owned
        # call: that refuses a 0-children count outright (lmx_arena_refs
        # .lm1), and a 0-field structural type has none to open. No
        # lmx_merge_owned either -- there is no model to merge a
        # declaration from, so nothing here can fail on admission the way
        # `Model: fresh` can; only allocation, the same class the unit
        # root's own construction already leaves as a bare propagated
        # failure, not a caught throw.
        # All original named definitions are retained at their exact source
        # fields before execution. Reaching one does not execute or replace it.
        if: l2_local_ns_shape(stmt, mi) != 0 || l2_empty_struct_decl_shape(stmt, mi) != 0
            oi: l2_own_find_decl(mi, stmt\as\frame\head, stmt)
            if: oi < 0 || l2_source_definition_ns(oi) < 0
                return: l2_error(l2_src, stmt, "internal: a source definition has no owning producer")
            field: l2_next_active(field\next)
            continue
