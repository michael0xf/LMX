# Language-word probe t7: a value local named `table`.
fn: probe (size_t: n) size_t
    size_t: table 2U
    return: n + table
end: probe
size_t: r probe(5U)
if: r != 7U
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
