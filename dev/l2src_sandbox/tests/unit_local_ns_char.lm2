# A char field of a method's own named Structure has a fresh typed cell, like a unit Structure's.
# S\c written 'z' reads 'z'; `S()` stores its initializer again: 'a'. Was
# refused as a field of another kind.  Entry 7.
fn: m () int
    S:
        char: c 'a'
        size_t: v 4U
    S\c: 'z'
    int: r 0
    if: S\c = 'z'
        r: r + 1
    S()
    if: S\c = 'a'
        r: r + 6
    int: out r
    return: out
end: m
int: r 0
r: m()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
