# A method of the win branch that the default branch does not declare: one contract per name.
os:
    win:
        fn: os_one () int
            return: 1
        end: os_one
        fn: os_two () int
            return: 2
        end: os_two
    default:
        fn: os_one () int
            return: 1
        end: os_one
end: os
sendMessage: exit(exit_code: os_one(); stdout: ""; stderr: "")
return
