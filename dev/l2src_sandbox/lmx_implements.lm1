predef: "l2src/lmx_implements.h.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l2src/lmx_pool.h.lm1"
predef: "l2src/lmx_scratch.lm1"
include: "<string.h>"

# lmx_implements.lm1 - the domain questions, answered from the address alone.
#
# The whole mechanism is the arena's index (lmx_range_classify, lmx_range_type_of):
# membership in one of the arena's arrays, no tag read.  This unit adds two things
# and nothing else -- a way to register a whole domain (count * stride) in one call,
# and the compatibility primitive itself.  The table is not created here: it is the
# arena's, opened by the caller with lmx_arena_open, which is why every question
# below names the arena it is asked of.

# Register one domain's storage: a domain is one array of the arena like every
# other, so the caller supplies the two records that describe it and the array's
# interval is registered against them. Nothing is owned here: the storage is the
# caller's frame or the arena's block list, never this unit's.
fn: lmx_domain_register (@: LmxArena arena; @: LmxPool pool; @: LmxChunk chunk; @: void lo; size_t: count; size_t: stride; int: kind; int: type) int
    if: arena = 0 || lo = 0 || count = 0U || stride = 0U
        return: c.LMX_DOMAIN_REGISTER_FAIL
    if: count > ((cast: (size_t) -1) / stride)
        return: c.LMX_DOMAIN_REGISTER_FAIL
    if: lmx_pool_over(arena, pool, chunk, lo, count * stride, stride, kind, type) != 0
        return: c.LMX_DOMAIN_REGISTER_FAIL
return: c.LMX_DOMAIN_REGISTER_OK

fn: lmx_domain_kind (@: LmxArena arena; @: void p) int
return: lmx_range_classify(arena, p)

fn: lmx_domain_type (@: LmxArena arena; @: void p) int
return: lmx_range_type_of(arena, p)

fn: lmx_domain_known (@: LmxArena arena; @: void p) int
    if: p = 0
        return: c.LMX_IMPLEMENTS_NO
    if: lmx_range_classify(arena, p) = c.LMX_KIND_NONE
        return: c.LMX_IMPLEMENTS_NO
return: c.LMX_IMPLEMENTS_YES

# implements(varA, varB, Consumer) -- the first stage of 2.1.
# Both operands must be of one registered domain: same kind, same type, and
# neither of them unknown.  That is exactly what a mailbox has to ask before it
# accepts a letter or an executable object, and it is asked here once rather than
# spelled again in every caller.
#
# Directionality is preserved the L2 way: this stage is symmetric only because the
# question it answers is symmetric (are these the same domain).  The consumer-
# relative direction of 2.1 -- varA providing what varB's consumer uses -- is the
# RUNTIME walk at the end of this unit (lmx_runtime_implements), which reads the
# Consumer's own shape; the SOURCE check stays the translator's, over requirements
# known at the site.
#
# The arena is the one whose index answers for both operands: a domain question is
# asked of an address, and the answer comes from the arena the address lives in.
fn: lmx_implements (@: LmxArena arena; @: void varA; @: void varB; @: void consumer) int
    int: kindA
    int: typeA
    if: varA = 0 || varB = 0
        return: c.LMX_IMPLEMENTS_NO
    kindA: lmx_range_classify(arena, varA)
    typeA: lmx_range_type_of(arena, varA)
    if: kindA = c.LMX_KIND_NONE || typeA = c.LMX_TYPE_NONE
        return: c.LMX_IMPLEMENTS_NO
    if: lmx_range_classify(arena, varB) != kindA
        return: c.LMX_IMPLEMENTS_NO
    if: lmx_range_type_of(arena, varB) != typeA
        return: c.LMX_IMPLEMENTS_NO
return: c.LMX_IMPLEMENTS_YES

# RuntimeImplements(varA, varB, Consumer) -- the second predicate of 2.1: the same used-path,
# leaf and signature rules, applied to what is AVAILABLE at run time.
#
# The Consumer here is a STRUCTURE, and that is what makes a runtime walk possible at all: "the
# used tree is the contract" (2.5.1) -- the Consumer's own shape gives the paths it uses, because
# names are absent from ordinary LMX execution (spec 1178) and every path is an index path.  A
# child of the Consumer that is UNSET is not a used path ("An empty `uses` is true: there is
# nothing to use"), so a Consumer with no children is satisfied by anything.
#
# Per used path, in the order the spec gives it:
#   * the path must be PRESENT on both operands -- "every path in uses(Consumer varB) is present
#     on varA";
#   * the leaf must be ADMITTED: one domain kind and one type on all three (2.2.3's primitive-leaf
#     admission -- an address is admitted where its domain is);
#   * at a callable ON a used path the METHOD signatures must be EQUAL -- "at every callable path
#     p actually invoked by Consumer: sig(varA.p) == sig(varB.p) == ExpectedSig(Consumer, p)".
#     child[0] is an LmxCallable descriptor; the walk unwraps descriptor.method for the compare.
#     A runtime cannot see which callable a Consumer invokes and which it only names, so a callable
#     on a used path is taken as invoked: that reading can only refuse a substitution it might have
#     allowed, never accept one whose generated typed call would be invalid.
#
# One operation's DFS frame and visited triple. These records live only in temporary scratch,
# never in the checked graph or the arena's cache of completed admissions. Keeping a frame
# after its DFS return lets shared targets and back-edges reuse the same expansion.
# An address of no known domain is UNKNOWN, never YES. A known mismatch is NO.
# Frames preserve the recursive walk's depth-first sibling order without a depth bound.
fn: lmx_implements_view (@: LmxArena arena; @: Lmx value; @: Lmx req; @: LmxImplEntry pending) @: LmxImplEntry
    if: pending != 0 && pending\value = value && pending\req = req
        return: pending
return: lmx_implements_find(arena, value, req)

fn: lmx_implements_walk_view (@: LmxArena arena; @: Lmx varA; @: Lmx varB; @: Lmx consumer; @: LmxImplEntry pending; int: skip_unused) int
    LmxArena: temporary
    LmxPool: cells
    LmxScratch: scratch
    LmxImplementsFrame: root
    @: LmxImplementsFrame current (@ root)
    @: LmxImplementsFrame seen (@ root)
    @: LmxImplementsFrame found 0
    @: LmxImplementsFrame child 0
    @: void room 0
    size_t: index
    size_t: indexA
    size_t: indexB
    @: void a
    @: void b
    @: void c
    int: kindA
    int: kindB
    int: kindC
    int: answer c.LMX_IMPLEMENTS_YES
    if: consumer = 0
        return: c.LMX_IMPLEMENTS_YES
    if: varA = 0 || varB = 0
        return: c.LMX_IMPLEMENTS_NO
    if: lmx_domain_kind(arena, (cast: (@: void) consumer)) = c.LMX_KIND_NONE
        return: c.LMX_IMPLEMENTS_UNKNOWN
    if: lmx_domain_kind(arena, (cast: (@: void) consumer)) != c.LMX_KIND_STRUCT
        return: c.LMX_IMPLEMENTS_UNKNOWN
    if: lmx_domain_kind(arena, (cast: (@: void) varA)) = c.LMX_KIND_NONE || lmx_domain_kind(arena, (cast: (@: void) varB)) = c.LMX_KIND_NONE
        return: c.LMX_IMPLEMENTS_UNKNOWN
    if: lmx_domain_kind(arena, (cast: (@: void) varA)) != c.LMX_KIND_STRUCT || lmx_domain_kind(arena, (cast: (@: void) varB)) != c.LMX_KIND_STRUCT
        return: c.LMX_IMPLEMENTS_NO
    ---
    if: consumer\array.size = 0U
        return: c.LMX_IMPLEMENTS_YES
    memset((cast: (@: void) (@ temporary)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ scratch)), 0, c.sizeof(c.LmxScratch))
    if: lmx_arena_open(@ temporary) != 0
        return: c.LMX_IMPLEMENTS_UNKNOWN
    if: lmx_scratch_open(@ scratch, @ temporary, @ cells, 64U) != c.LMX_SCRATCH_OK
        lmx_arena_release(@ temporary)
        return: c.LMX_IMPLEMENTS_UNKNOWN
    ---
    current\varA: varA
    current\varB: varB
    current\consumer: consumer
    current\viewA: lmx_implements_view(arena, varA, consumer, pending)
    current\viewB: lmx_implements_view(arena, varB, consumer, pending)
    current\index: 0U
    current\caller: 0
    current\seen_next: 0
    while: current != 0
        if: current\index = current\consumer\array.size
            current: current\caller
            continue
        ---
        index: current\index
        current\index: index + 1U
        c: lmx_arena_ref_value(current\consumer, index)
        if: c != 0
            indexA: index
            indexB: index
            if: current\viewA != 0 && lmx_implements_at(arena, current\viewA, index, @ indexA) != 0
                answer: c.LMX_IMPLEMENTS_NO
                break
            if: current\viewB != 0 && lmx_implements_at(arena, current\viewB, index, @ indexB) != 0
                answer: c.LMX_IMPLEMENTS_NO
                break
            if: indexA = (cast: (size_t) -1) || indexB = (cast: (size_t) -1)
                if: skip_unused != 0
                    continue
                answer: c.LMX_IMPLEMENTS_NO
                break
            ---
            a: lmx_arena_ref_value(current\varA, indexA)
            b: lmx_arena_ref_value(current\varB, indexB)
            if: a = 0 || b = 0
                answer: c.LMX_IMPLEMENTS_NO
                break
            ---
            kindA: lmx_domain_kind(arena, a)
            kindB: lmx_domain_kind(arena, b)
            kindC: lmx_domain_kind(arena, c)
            if: kindA = c.LMX_KIND_NONE || kindB = c.LMX_KIND_NONE || kindC = c.LMX_KIND_NONE
                answer: c.LMX_IMPLEMENTS_UNKNOWN
                break
            ---
            if: kindA != kindC || kindB != kindC
                answer: c.LMX_IMPLEMENTS_NO
                break
            ---
            if: kindC = c.LMX_KIND_STRUCT
                found: seen
                while: found != 0
                    if: found\varA = (cast: (@: Lmx) a) && found\varB = (cast: (@: Lmx) b) && found\consumer = (cast: (@: Lmx) c)
                        break
                    found: found\seen_next
                ---
                if: found = 0
                    if: lmx_scratch_take(@ scratch, c.sizeof(c.LmxImplementsFrame), @ room) != c.LMX_SCRATCH_OK
                        answer: c.LMX_IMPLEMENTS_UNKNOWN
                        break
                    ---
                    child: (cast: (@: LmxImplementsFrame) room)
                    child\varA: (cast: (@: Lmx) a)
                    child\varB: (cast: (@: Lmx) b)
                    child\consumer: (cast: (@: Lmx) c)
                    child\viewA: lmx_implements_view(arena, child\varA, child\consumer, pending)
                    child\viewB: lmx_implements_view(arena, child\varB, child\consumer, pending)
                    child\index: 0U
                    child\caller: current
                    child\seen_next: seen
                    seen: child
                    current: child
                ---
            else:
                if: lmx_domain_type(arena, a) != lmx_domain_type(arena, c) || lmx_domain_type(arena, b) != lmx_domain_type(arena, c)
                    answer: c.LMX_IMPLEMENTS_NO
                    break
                ---
            ---
        ---
    ---
    lmx_scratch_close(@ scratch)
    lmx_arena_release(@ temporary)
return: answer

fn: lmx_implements_walk (@: LmxArena arena; @: Lmx varA; @: Lmx varB; @: Lmx consumer) int
return: lmx_implements_walk_view(arena, varA, varB, consumer, 0, 0)

fn: lmx_runtime_implements (@: LmxArena arena; @: Lmx varA; @: Lmx varB; @: Lmx consumer) int
    if: arena = 0
        return: c.LMX_IMPLEMENTS_UNKNOWN
return: lmx_implements_walk(arena, varA, varB, consumer)

# D-105 (the author's Q39, 2026-09-27, LMX_blog/2026-09-27.md: "если поставляется исходная
# структура то берется прямо по смещению исходной. Если подставляется другая то надо ей прикрепить
# таблицу преобразований индексов. ОЧевидное место длятакой таблице -- сам implements. Все равно
# там тяжелеовесный только первый implements должен быть а в дальнейших проверках он должен брать
# соответствие адресов из своей таблицы").  The table is the arena's (LmxArena.impl): the arena
# is the context of every question in this unit, and its values are what the records name.  A record is a view of
# its correspondence (LmxImplEntry), never a Structure made for it (Codex, 2026-09-28).

# Slot j of view e: the place of req's field j in the value -- the admitting frame's size cell frame[at + j], the
# static map's map[j], or j itself (the value's own layout; with holes, an empty slot is not carried).  0 and *out
# (SIZE_MAX: not carried), or 1 when the view has no slot j.
fn: lmx_implements_at (@: LmxArena arena; @: LmxImplEntry e; size_t: j; @: size_t out) int
    @: void cell
    @: size_t at
    if: e = 0 || out = 0
        return: 1
    if: e\frame != 0
        if: j >= e\n
            return: 1
        cell: lmx_arena_ref_value(e\frame, e\at + j)
        if: cell = 0 || lmx_domain_type(arena, cell) != c.LMX_TYPE_SIZE_T
            return: 1
        at: (cast: (@: size_t) cell)
        \out: at[0]
        return: 0
    ---
    if: e\map != 0
        if: j >= e\n
            return: 1
        \out: e\map[j]
        return: 0
    ---
    \out: j
    if: e\holes != 0 && (e\value = 0 || j >= e\value\array.size || lmx_arena_ref_value(e\value, j) = 0)
        \out: (cast: (size_t) -1)
return: 0

# The record of (value, req), or null.
fn: lmx_implements_find (@: LmxArena arena; @: Lmx value; @: Lmx req) @: LmxImplEntry
    size_t: i 0U
    @: LmxImplEntry e
    if: arena = 0 || arena\impl = 0 || value = 0 || req = 0
        return: 0
    while: i < arena\impl_len
        e: arena\impl + i
        if: e\value = value && e\req = req
            return: e
        i: i + 1U
    ---
return: 0

# Genuine schema evidence is a property of the held value. Looking across its
# completed correspondences supplies only that identity, never another receiver's
# map or Consumer proof. Register keeps all known evidence for one value consistent.
fn: lmx_implements_layout (@: LmxArena arena; @: Lmx value) @: void
    size_t: i 0U
    @: LmxImplEntry entry
    if: arena = 0 || value = 0
        return: 0
    while: i < arena\impl_len
        entry: arena\impl + i
        if: entry\value = value && entry\layout != 0
            return: entry\layout
        i: i + 1U
    ---
return: 0

# Two views give req's fields (width of them) the same places.
fn: lmx_implements_same_map (@: LmxArena arena; @: LmxImplEntry a; @: LmxImplEntry b; size_t: width) int
    size_t: j 0U
    size_t: sa 0U
    size_t: sb 0U
    while: j < width
        if: lmx_implements_at(arena, a, j, @ sa) != 0 || lmx_implements_at(arena, b, j, @ sb) != 0
            return: 0
        if: sa != sb
            return: 0
        j: j + 1U
    ---
return: 1

# Native D-105: does record e give req's fields (width of them) the places the static map does (null: the identity)?
fn: lmx_implements_is_map (@: LmxArena arena; @: LmxImplEntry e; @: size_t map; size_t: width) int
    LmxImplEntry: view
    @: LmxImplEntry v 0
    if: e = 0
        return: 0
    v: @ view
    memset((cast: (@: void) v), 0, c.sizeof(c.LmxImplEntry))
    v\map: map
    v\n: width
return: lmx_implements_same_map(arena, e, v, width)

# The heavy check uses the same operation DFS. Its pending view remains available on back-edges,
# and nested pairs use their already admitted correspondence. SIZE_MAX is proved unused here;
# unlike the runtime used-tree predicate, req describes the whole declared layout, not just uses.
fn: lmx_implements_through (@: LmxArena arena; @: Lmx value; @: Lmx req; @: LmxImplEntry view) int
    LmxImplEntry: selected
    @: LmxImplEntry pending (@ selected)
    if: arena = 0 || value = 0 || req = 0
        return: c.LMX_IMPLEMENTS_UNKNOWN
    if: lmx_domain_kind(arena, (cast: (@: void) value)) != c.LMX_KIND_STRUCT || lmx_domain_kind(arena, (cast: (@: void) req)) != c.LMX_KIND_STRUCT
        return: c.LMX_IMPLEMENTS_NO
    if: view = 0
        memset((cast: (@: void) pending), 0, c.sizeof(c.LmxImplEntry))
    else:
        memcpy((cast: (@: void) pending), (cast: (@: void) view), c.sizeof(c.LmxImplEntry))
    ---
    pending\value: value
    pending\req: req
return: lmx_implements_walk_view(arena, value, value, req, pending, 1)

fn: lmx_implements_register (@: LmxArena arena; @: Lmx value; @: Lmx req; @: LmxImplEntry view) int
    @: LmxImplEntry e
    @: void layout
    int: answer
    if: arena = 0 || value = 0 || req = 0 || view = 0
        return: c.LMX_IMPLEMENTS_UNKNOWN
    view\value: value
    view\req: req
    if: (view\frame != 0 || view\map != 0) && view\n != req\array.size
        return: c.LMX_IMPLEMENTS_NO
    layout: lmx_implements_layout(arena, value)
    if: layout != 0 && view\layout != 0 && layout != view\layout
        return: c.LMX_IMPLEMENTS_NO
    e: lmx_implements_find(arena, value, req)
    if: e != 0
        # A later admission: the record answers.  One value has one own type, so a different
        # correspondence to the same req is a broken promise of the caller, refused.
        if: lmx_implements_same_map(arena, e, view, (req\array.size)) != 0
            if: e\layout != 0 && view\layout != 0 && e\layout != view\layout
                return: c.LMX_IMPLEMENTS_NO
            if: e\layout = 0 && view\layout != 0
                e\layout: view\layout
            return: c.LMX_IMPLEMENTS_YES
        return: c.LMX_IMPLEMENTS_NO
    ---
    answer: lmx_implements_through(arena, value, req, view)
    if: answer != c.LMX_IMPLEMENTS_YES
        return: answer
    if: lmx_arena_impl_room(arena, arena\impl_len + 1U) != 0
        return: c.LMX_IMPLEMENTS_UNKNOWN
    e: arena\impl + arena\impl_len
    e\value: value
    e\req: req
    e\layout: view\layout
    e\frame: view\frame
    e\at: view\at
    e\map: view\map
    e\n: view\n
    e\holes: view\holes
    arena\impl_len: arena\impl_len + 1U
return: c.LMX_IMPLEMENTS_YES

# Native D-105: the value admitted to req through the translator's static map of its pair of types (n slots), or
# as req's own (map null).
fn: lmx_implements_register_map (@: LmxArena arena; @: Lmx value; @: Lmx req; @: size_t map; size_t: n; @: void layout) int
    LmxImplEntry: view
    @: LmxImplEntry v 0
    v: @ view
    memset((cast: (@: void) v), 0, c.sizeof(c.LmxImplEntry))
    v\map: map
    v\layout: layout
    if: map != 0
        v\n: n
return: lmx_implements_register(arena, value, req, v)

fn: lmx_implements_slot (@: LmxArena arena; @: Lmx value; @: Lmx req; size_t: j; @: size_t out) int
    @: LmxImplEntry e
    size_t: k 0U
    if: out = 0
        return: 1
    e: lmx_implements_find(arena, value, req)
    if: e = 0
        return: 1
    if: lmx_implements_at(arena, e, j, @ k) != 0
        return: 1
    # Item 738: req's field j is not carried by this value (a capture copies only what is read).
    if: k = (cast: (size_t) -1)
        return: 1
    \out: k
return: 0
