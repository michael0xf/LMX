# A prepared declaration whose argument names nothing: the read of the written name answers the unknown name.
@: D (
    int: here 0
)
fn: outer () int (
    prepared:
        args: (int: a)
        return: int
        code: (return: a * 3)
    fn: local nosuch
    int: r 0
)
    r := local(a := 3)
    node\D\here := r
    return: r
outer()
