Nodes:
    return: int
    on_number:
        throws: NoAction
        throw: NoAction()
    on_pair:
        throws: NoAction
        throw: NoAction()
    Number:
        int: value 6
        return: int
        accept:
            throws: NoAction
            return: on_number()
    ---
    Pair:
        int: left 2
        int: right 7
        return: int
        accept:
            throws: NoAction
            return: on_pair()

Summing:
    return: int
    on_number:
        return: value
    on_pair:
        return: left + right
    demo:
        int: result 0
        result := Nodes\Number\accept()
        result += Nodes\Pair\accept()
        catch: NoAction ()
            result := -1
        return: result
