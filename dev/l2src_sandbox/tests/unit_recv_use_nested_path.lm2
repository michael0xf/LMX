# A path below the place is a requirement of its own depth. b reads in\x in
# the nested Structure, then the distinct aFirst and aLast fields. The
# receiving instruction carries a nested level and one edge per named field.
# The candidate is Model itself: reads produce 4, 1 and 2. Entry 7.
Model:
    in:
        size_t: x 4U
        int: y 6
    int: aFirst 1
    int: aLast 2
    size_t: tail 9U
end: Model

fn: reads () int
    g: merge: Model
    @: b Model g
    size_t: gx b\in\x
    int: first b\aFirst
    int: last b\aLast
    if: gx != 4U
        return: 81
    if: first != 1
        return: 82
    if: last != 2
        return: 83
    if: b != g
        return: 84
    return: 7
end: reads

sendMessage: exit(exit_code: reads(); stdout: ""; stderr: "")
return
