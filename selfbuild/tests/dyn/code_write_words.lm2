# Graph writes and native entries (kernel-implementation §6.5; the book, #explicit-compilation): a write of data or of
# code takes effect on its addressed graph place and keeps every native entry. Which body a rebound callable runs
# before an explicit compilation and endturn is not fixed by the norm, so it is not observed here: the checks pin the
# data a write leaves and the calls the writes do not touch. Entry 7; 81.. name the failing check.
int: k 7
fn: machined () int
    return: (cast: (int) k)
end: machined
sub: machined_sub ()
    k := (cast: (int) k)
end: machined_sub
fn: target () int
    return: 1
end: target
fn: refused_target () int
    return: 1
end: refused_target
fn: caller () int
    int: got target()
    return: (cast: (int) got)
end: caller
# Holds `target` as an unchanged operand of a statement: a body with a machine operation that only refers to the code written.
fn: binder () int
    @: bound target target
    return: (cast: (int) 5)
end: binder
fn: replacement () int
    return: 1 + 1
end: replacement
fn: leaving () int
    return: (cast: (int) 3)
end: leaving
fn: machine_body () int
    return: (cast: (int) 4)
end: machine_body
S1:
    T:
        int: v 1
    end: T
end: S1
D:
    T:
        int: v 0
    end: T
end: D
int: quote 11
int: src 12
Other:
    T:
        int: v 2
    end: T
end: Other
sub: put_body ()
    quote\code := src\code
end: put_body
sub: put_args ()
    quote\args := src\args
end: put_args
sub: put_part ()
    quote\T := src\T
end: put_part
sub: plain_sub ()
    k := k
end: plain_sub
fn: machines_run () int
    machined_sub()
    return: machined()
end: machines_run
# A split call runs the code S1 over the data D: the form `T:` in S1 is a call of its head in code and writes nothing
# into D (the book, colon-declares; slice 416), so D\T\v stays 0.
fn: data_call () int
    call(D S1)
    if: D\T\v != 0 || machines_run() != 7
        return: 81
    return: 0
end: data_call
# The part of a Structure rebound by name is its slot's value: the word of the Structure stays and reads the new part.
fn: part_rebound () int
    @: quote S1 S1
    @: src Other Other
    put_part()
    if: S1\T\v != 2
        return: 88
    call(D S1)
    if: D\T\v != 0 || machines_run() != 7
        return: 89
    return: 0
end: part_rebound
# The whole body of a callable rebound: the write succeeds, and the calls it does not touch keep their answers.
fn: swap_body () int
    @: quote target target
    @: src replacement replacement
    if: target() != 1 || caller() != 1
        return: 82
    put_body()
    if: binder() != 5 || machines_run() != 7
        return: 84
    return: 0
end: swap_body
# The write succeeds and unrelated native calls still work.
fn: refuse_arriving () int
    @: quote refused_target refused_target
    @: src machine_body machine_body
    put_body()
    if: machine_body() != 4
        return: 85
    return: 0
end: refuse_arriving
# Changing a callable's inputs is a write like any other: it succeeds and leaves the data as it was.
fn: refuse_args_fn () int
    @: quote machined machined
    @: src replacement replacement
    put_args()
    if: k != 7
        return: 90
    return: 0
end: refuse_args_fn
fn: refuse_args_sub () int
    @: quote machined_sub machined_sub
    @: src plain_sub plain_sub
    put_args()
    if: k != 7
        return: 91
    return: 0
end: refuse_args_sub
# A body that had the machine operation rebound whole: the write succeeds.
fn: machine_leaving () int
    @: quote leaving leaving
    @: src replacement replacement
    if: leaving() != 3
        return: 86
    put_body()
    return: 0
end: machine_leaving
fn: m () int
    int: status data_call()
    if: status != 0
        return: status
    status := part_rebound()
    if: status != 0
        return: status
    status := swap_body()
    if: status != 0
        return: status
    status := refuse_arriving()
    if: status != 0
        return: status
    status := refuse_args_fn()
    if: status != 0
        return: status
    status := refuse_args_sub()
    if: status != 0
        return: status
    status := machine_leaving()
    if: status != 0
        return: status
    return: 7
end: m
send: exit(exit_code: m(); stdout: ""; stderr: "")
return
