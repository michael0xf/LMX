# private x во внешней Outer не закрывает имя: read видит публичное x = 5 вложенной Inner, и динамический
# источник побеждает как прежде — x = 11 вызывающего: seen 11. Норма: книга, #private-binding, #binding-caller-place, #binding-fallback.
(
    Outer:
        private: int: x 7
        Inner:
            int: x 5
            fn: read () int
                return: x
            end: read
        end: Inner
    end: Outer
    Observed:
        int: seen 0
    end: Observed
)
fn: f () int
    @: shared node[0]
    int: x 11
    return: shared\Outer\Inner\read()
sub: main ()
    @: shared node[0]
    shared\Observed\seen := f()
main()
