---
    Observed:
        int: calls 2
        int: before_effect 0
        int: after_effect 1
        int: after_call 2
    end: Observed
---
int: calls 2
fn: effect () int
    :=: (node \ calls) ((node \ calls) + 1)
    return: 4
end: effect
sub: quiet ()
    :=: (node \ calls) ((node \ calls) + 1)
end: quiet
sub: hold ()
    unknown_inside
    quiet
end: hold
sub: snap_before_effect ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ before_effect) (node \ calls)
end: snap_before_effect
sub: snap_after_effect ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ after_effect) (node \ calls)
end: snap_after_effect
sub: snap_after_call ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ after_call) (node \ calls)
end: snap_after_call
unknown_outside
quiet
Bag:
    missing_a
    quiet
end: Bag
Bag
@
calls
hold:
snap_before_effect:
+: ((effect) + 1)
snap_after_effect:
quiet:
snap_after_call:
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ calls) (node \ calls)
end: main
main:
