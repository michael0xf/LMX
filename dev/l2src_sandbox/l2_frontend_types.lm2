        if: \out_ty >= 100
            return: (cast: (int) (0))
        return: (cast: (int) (2))
    if: c.lm_compiler_site_method(here_mi_cell[0], atom) >= 0
        \out_ty: c.lm_compiler_foreign_intern(c.lm_compiler_lmx_text(), depth, is_const)
        if: \out_ty >= 100
