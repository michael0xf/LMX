predef: "l2src/lmx_arena_blocks.h.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>"

# All test logic is authored in L1. GNU ld --wrap=free counts both default
# payload disposal and metadata release, without adding hooks to the module.
prototype:
    fn: __real_free (@: void p) void
end: prototype

int: failures 0
int: checks 0
int: frees 0
int: callbacks 0
size_t: disposed_bytes 0U
@@: LmxArenaBlock reenter_head 0

sub: __wrap_free (@: void p)
    if: p != 0
        frees: frees + 1
    c.__real_free(p)
end: __wrap_free

sub: check (int: condition; const: @(char label))
    checks: checks + 1
    if: condition = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
end: check

sub: custom_dispose (@: void base; size_t: n)
    callbacks: callbacks + 1
    disposed_bytes: disposed_bytes + n
    if: reenter_head != 0
        check(reenter_head[0] = 0, "owner cleared before callback")
        check(lmx_arena_blocks_dispose_all(reenter_head) = LMX_ARENA_BLOCKS_OK, "reentrant disposal is empty")
    free(base)
end: custom_dispose

fn: make_block (size_t: n; unsigned: cls; LmxArenaBlockDisposer: disposer) @: LmxArenaBlock
    @: LmxArenaBlock b
    b: (cast: (@: LmxArenaBlock) calloc(1U, c.sizeof(c.LmxArenaBlock)))
    if: b = 0
        c.exit(2)
    if: n != 0U
        b\base: calloc(1U, n)
        if: b\base = 0
            free(b)
            c.exit(2)
    ---
    b\n: n
    b\class: cls
    b\dispose: disposer
    return: b

fn: main () int
    @: LmxArenaBlock src 0
    @: LmxArenaBlock dst 0
    @: LmxArenaBlock alias 0
    @: LmxArenaBlock a
    @: LmxArenaBlock b
    @: LmxArenaBlock d
    @: LmxArenaBlock node
    @: Lmx first
    @: Lmx second
    int: before
    int: i

    check(lmx_arena_blocks_push(0, 0) = LMX_ARENA_BLOCKS_INVALID, "push null head/node")
    check(lmx_arena_blocks_push(@ src, 0) = LMX_ARENA_BLOCKS_INVALID, "push null node")
    check(lmx_arena_blocks_move_all(0, @ src) = LMX_ARENA_BLOCKS_INVALID, "move null destination")
    check(lmx_arena_blocks_move_all(@ dst, 0) = LMX_ARENA_BLOCKS_INVALID, "move null source")
    check(lmx_arena_blocks_move_all(@ src, @ src) = LMX_ARENA_BLOCKS_INVALID, "self move empty rejected")
    check(lmx_arena_blocks_dispose_all(0) = LMX_ARENA_BLOCKS_INVALID, "dispose null head")
    check(lmx_arena_blocks_dispose_all(@ src) = LMX_ARENA_BLOCKS_OK, "dispose empty")
    check(lmx_arena_blocks_move_all(@ dst, @ src) = LMX_ARENA_BLOCKS_OK, "move two empty owners")

    # Real Lmx payloads with forward/back links: moving metadata must not copy
    # or reparent the graph. A separate destination block already exists.
    a: make_block(c.sizeof(c.Lmx), 11U, custom_dispose)
    b: make_block(c.sizeof(c.Lmx), 12U, 0)
    d: make_block(3U, 13U, custom_dispose)
    first: (cast: (@: Lmx) a\base)
    second: (cast: (@: Lmx) b\base)
    first\data: (cast: (@: void) second)
    second\node: first
    second\data: (cast: (@: void) first)
    check(lmx_arena_blocks_push(@ src, b) = LMX_ARENA_BLOCKS_OK, "push first node")
    check(lmx_arena_blocks_push(@ src, a) = LMX_ARENA_BLOCKS_OK, "push second node")
    check(lmx_arena_blocks_push(@ dst, d) = LMX_ARENA_BLOCKS_OK, "push destination")
    check(src = a && a\next = b && b\next = 0, "push preserves detached chain")
    check(lmx_arena_blocks_push(@ src, a) = LMX_ARENA_BLOCKS_INVALID, "linked node rejected")
    check(lmx_arena_blocks_push(@ src, b) = LMX_ARENA_BLOCKS_INVALID, "duplicate tail rejected")
    check(src = a && a\next = b && b\next = 0, "rejected pushes unchanged")
    alias: b
    check(lmx_arena_blocks_move_all(@ src, @ alias) = LMX_ARENA_BLOCKS_INVALID, "overlapping lists rejected")
    check(alias = b && src = a && a\next = b, "overlap rejection unchanged")
    alias: 0
    check(lmx_arena_blocks_move_all(@ src, @ src) = LMX_ARENA_BLOCKS_INVALID, "self move nonempty rejected")
    before: frees
    check(lmx_arena_blocks_move_all(@ dst, @ src) = LMX_ARENA_BLOCKS_OK, "move graph blocks")
    check(src = 0 && dst = a && a\next = b && b\next = d, "move source cleared and order retained")
    check(frees = before && callbacks = 0, "move performs no disposal")
    check(a\base = (cast: (@: void) first) && b\base = (cast: (@: void) second), "payload pointer identity")
    check(first\data = (cast: (@: void) second) && second\node = first && second\data = (cast: (@: void) first), "internal graph aliases unchanged")
    check(a\class = 11U && b\class = 12U && d\class = 13U, "metadata classes retained")
    check(a\n = c.sizeof(c.Lmx) && a\dispose = custom_dispose, "length and disposer retained")
    check(lmx_arena_blocks_dispose_all(@ src) = LMX_ARENA_BLOCKS_OK, "source cleanup after transfer")
    check(frees = before, "source no longer owns moved storage")
    check(lmx_arena_blocks_move_all(@ dst, @ src) = LMX_ARENA_BLOCKS_OK && dst = a, "repeat move empty source")
    check(lmx_arena_blocks_move_all(@ src, @ dst) = LMX_ARENA_BLOCKS_OK && dst = 0 && src = a, "move into empty owner")
    reenter_head: @ src
    check(lmx_arena_blocks_dispose_all(@ src) = LMX_ARENA_BLOCKS_OK, "dispose mixed default/custom blocks")
    reenter_head: 0
    check(src = 0, "disposed owner empty")
    check(frees = before + 6, "three payloads and three nodes freed exactly once")
    check(callbacks = 2 && disposed_bytes = c.sizeof(c.Lmx) + 3U, "callback count and sizes exact")
    before: frees
    check(lmx_arena_blocks_dispose_all(@ src) = LMX_ARENA_BLOCKS_OK && frees = before, "repeat dispose frees nothing")

    # Failure cases leave metadata/ownership untouched. Repair test corruption
    # explicitly before final disposal; module must not try to free a cycle.
    a: make_block(0U, 21U, 0)
    a\n: 1U
    check(lmx_arena_blocks_push(@ src, a) = LMX_ARENA_BLOCKS_INVALID && src = 0, "missing nonempty payload rejected")
    a\n: 0U
    check(lmx_arena_blocks_push(@ src, a) = LMX_ARENA_BLOCKS_OK, "zero byte empty block")
    a\next: a
    before: frees
    check(lmx_arena_blocks_move_all(@ dst, @ src) = LMX_ARENA_BLOCKS_INVALID, "cyclic source rejected")
    check(lmx_arena_blocks_dispose_all(@ src) = LMX_ARENA_BLOCKS_INVALID, "cyclic disposal rejected")
    b: make_block(1U, 22U, 0)
    check(lmx_arena_blocks_push(@ src, b) = LMX_ARENA_BLOCKS_INVALID, "push into cycle rejected")
    check(src = a && a\next = a && b\next = 0 && frees = before, "cycle failures unchanged")
    a\next: 0
    check(lmx_arena_blocks_push(@ dst, b) = LMX_ARENA_BLOCKS_OK, "second list for cycle test")
    b\next: b
    check(lmx_arena_blocks_move_all(@ dst, @ src) = LMX_ARENA_BLOCKS_INVALID && src = a, "cyclic destination rejected")
    b\next: 0
    lmx_arena_blocks_dispose_all(@ src)
    lmx_arena_blocks_dispose_all(@ dst)
    check(frees = before + 3, "zero payload block frees only metadata")

    # No arbitrary child/block count cap: mix 65 blocks, two groups and repeated
    # transfers. Metadata is allocated only by this caller, never by helpers.
    before: frees
    i: 0
    while: i < 65
        node: make_block(1U, (cast: (unsigned) i), 0)
        if: i < 32
            check(lmx_arena_blocks_push(@ src, node) = LMX_ARENA_BLOCKS_OK, "push source many")
        else:
            check(lmx_arena_blocks_push(@ dst, node) = LMX_ARENA_BLOCKS_OK, "push destination many")
        ---
        i: i + 1
    ---
    check(lmx_arena_blocks_move_all(@ dst, @ src) = LMX_ARENA_BLOCKS_OK, "move 65 blocks")
    check(lmx_arena_blocks_dispose_all(@ dst) = LMX_ARENA_BLOCKS_OK, "dispose 65 blocks")
    check(src = 0 && dst = 0 && frees = before + 130, "65 payloads and nodes exactly once")

    # Selective removal: the owner keeps live allocations and their graph links.
    # Removing metadata does not itself collect anything or call a disposer.
    a: make_block(c.sizeof(c.Lmx), 31U, 0)
    b: make_block(c.sizeof(c.Lmx), 32U, 0)
    d: make_block(c.sizeof(c.Lmx), 33U, 0)
    node: make_block(1U, 34U, 0)
    first: (cast: (@: Lmx) a\base)
    second: (cast: (@: Lmx) d\base)
    first\data: second
    second\node: first
    second\data: first
    before: frees
    check(lmx_arena_blocks_remove(@ src, a) = LMX_ARENA_BLOCKS_INVALID && src = 0 && a\next = 0, "remove from empty owner")
    check(lmx_arena_blocks_remove(0, a) = LMX_ARENA_BLOCKS_INVALID, "remove null owner slot")
    check(lmx_arena_blocks_remove(@ src, 0) = LMX_ARENA_BLOCKS_INVALID, "remove null member")
    check(lmx_arena_blocks_push(@ src, d) = LMX_ARENA_BLOCKS_OK, "remove fixture tail")
    check(lmx_arena_blocks_push(@ src, b) = LMX_ARENA_BLOCKS_OK, "remove fixture middle")
    check(lmx_arena_blocks_push(@ src, a) = LMX_ARENA_BLOCKS_OK, "remove fixture head")
    node\next: b
    check(lmx_arena_blocks_remove(@ src, node) = LMX_ARENA_BLOCKS_INVALID, "remove absent linked member")
    check(src = a && a\next = b && b\next = d && d\next = 0 && node\next = b, "absent rejection changes neither chain")
    node\next: 0
    d\next: a
    check(lmx_arena_blocks_remove(@ src, a) = LMX_ARENA_BLOCKS_INVALID, "remove rejects cyclic list before mutation")
    check(src = a && a\next = b && b\next = d && d\next = a && frees = before, "cyclic rejection leaves ownership untouched")
    d\next: 0
    check(lmx_arena_blocks_remove(@ src, b) = LMX_ARENA_BLOCKS_OK, "remove exact middle member")
    check(src = a && a\next = d && d\next = 0 && b\next = 0, "middle detached and survivors ordered")
    check(frees = before && callbacks = 2, "remove has no disposal or callback")
    check(a\base = (cast: (@: void) first) && d\base = (cast: (@: void) second) && first\data = (cast: (@: void) second) && second\node = first && second\data = (cast: (@: void) first), "survivor addresses and graph links unchanged")
    alias: b
    check(lmx_arena_blocks_dispose_all(@ alias) = LMX_ARENA_BLOCKS_OK && alias = 0, "existing disposer releases detached block only")
    check(frees = before + 2 && src = a && a\next = d && first\data = (cast: (@: void) second), "selective disposal preserves live owner")
    check(lmx_arena_blocks_remove(@ src, d) = LMX_ARENA_BLOCKS_OK && src = a && a\next = 0 && d\next = 0, "remove exact tail")
    check(a\base = (cast: (@: void) first) && first\data = (cast: (@: void) second) && second\node = first, "detaching tail does not change graph payload")
    check(lmx_arena_blocks_push(@ src, d) = LMX_ARENA_BLOCKS_OK && src = d && d\next = a, "reinsert detached block")
    check(lmx_arena_blocks_remove(@ src, d) = LMX_ARENA_BLOCKS_OK, "remove exact head")
    check(src = a && a\next = 0 && d\next = 0, "head removal preserves remaining member")
    check(lmx_arena_blocks_remove(@ src, a) = LMX_ARENA_BLOCKS_OK && src = 0 && a\next = 0, "remove only member")
    check(lmx_arena_blocks_remove(@ src, a) = LMX_ARENA_BLOCKS_INVALID && src = 0 && a\next = 0, "repeat remove is a non-mutating miss")
    check(frees = before + 2 && callbacks = 2, "all removes retain payload ownership with caller")
    check(lmx_arena_blocks_dispose_all(@ d) = LMX_ARENA_BLOCKS_OK && d = 0, "dispose detached tail fixture")
    check(lmx_arena_blocks_dispose_all(@ a) = LMX_ARENA_BLOCKS_OK && a = 0, "dispose detached head fixture")
    check(lmx_arena_blocks_dispose_all(@ node) = LMX_ARENA_BLOCKS_OK && node = 0, "dispose absent fixture")
    check(frees = before + 8 && src = 0 && dst = 0, "four fixture blocks released exactly once")
    c.printf("blocks checks=%d failures=%d frees=%d callbacks=%d\n", checks, failures, frees, callbacks)
    if: failures != 0
        return: 1
    return: 0
