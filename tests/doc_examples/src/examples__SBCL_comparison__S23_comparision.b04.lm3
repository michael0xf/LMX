Memo:
    int: value
    return: int
    get:
        int: i 0
        while: i < length(cache)
            @: row cache[i]
            if: \row[0] = value
                return: \row[1]
            i += 1
        int: square value * value
        calls += 1
        sys\resize(cache; i + 1)
        cache[i] := (value; square)
        return: square

Example:
    []int: items
    return: @
    run:
        []@: cache []
        int: calls 0
        []int: result []
        sys\resize(result; length(items))
        int: i 0
        while: i < length(items)
            result[i] := Memo\get(items[i])
            i += 1
        return: (result; calls)
