# C ABI: frozen parser symbol -> L2 compact-atom callable.
predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stddef.h>" "<stdio.h>"

extern: @: Lmx l2_registry_unit

prototype:
    fn: l2_registry_boot () int
    fn: l2_registry_m0 (@: Lmx node; const: @(char text); size_t: end_index; size_t: start) size_t
end: prototype

int: l2_registry_compact_calls 0

fn: l2_registry_ensure () void
    if: l2_registry_unit = 0
        if: c.l2_registry_boot() != 0 || l2_registry_unit = 0
            fputs("l2_registry_boot failed\n", l1_stderr())
---

fn: lm_p0_scan_registry_compact_atom_piece (const: @(char text); size_t: end_index; size_t: start) size_t
    l2_registry_ensure()
    l2_registry_compact_calls: l2_registry_compact_calls + 1
    return: c.l2_registry_m0(c.lmx_arena_ref_struct(l2_registry_unit, 0U), text, end_index, start)
