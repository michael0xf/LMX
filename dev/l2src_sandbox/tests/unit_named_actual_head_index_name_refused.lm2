# A named actual inside the index of a store's head is bound as any call's:
# one that names no formal of its callee is refused, at its own place in the
# head.
fn: pick (size_t: a; size_t: b) size_t
    return: a * 2U + b
end: pick

fn: put () int
    []: int row 3
    row[pick(c: 1U; a: 0U)]: 5
    return: row[1]
end: put

int: ok put()
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
