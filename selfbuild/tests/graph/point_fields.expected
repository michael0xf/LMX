fn: bump (int: v) int
    return: (v + 1)
end: bump
sub: main () (
    Point:
        int: y 0
        int: x 0
    end: Point
    Reordered:
        int: x 999
        int: extra 17
        int: y 3
    end: Reordered
    OnlyUsed:
        int: y 4
    end: OnlyUsed
    int: reordered 0
    int: defaulted 0
    int: nested 0
)
    fn: take (Point: p; int: q 2) int
        return: (((p \ y) * 10) + q)
    end: take
    :=: reordered ((take Reordered 1))
    :=: defaulted ((take OnlyUsed))
    :=: nested ((take Reordered (bump 1)))
end: main
