+# Raw callers enter at an explicit ownership boundary. An existing site is
+# borrowed; it is never reparsed after an admitted/failed child projection.
+fn: l2_primary_use (const: @(LmP0Node node); int: mi; @: L2ValueSpan temporary; @@: L2ValueSpan out) int
+    @: L2ApplicationSite site l2_application_site_find(node, mi)
+    l2_value_span_ref(temporary, 0, 0)
+    if: site != 0
+        \out: @ site\value
+        return: 0
+    temporary\node: (cast: (@: LmP0Node) node)
+    temporary\count: 1
+    temporary\grammar: 2
+    \out: temporary
+return: l2_value_source_children(temporary)
+
+# These are receiver contracts, not another argument grammar. A selected
+# L2 application keeps its signature even if its name is an intrinsic word.
+fn: l2_primary_role (@: L2ValueSpan value; int: mi) int
+    @: LmP0Node node
+    @: LmP0Text head
+    @: L2ApplicationSite site
+    int: formal
+    if: value = 0 || value\node = 0
+        return: 0
+    node: value\node
+    if: node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
+        return: 0
+    head: node\as\frame\head
+    site: l2_application_site_find(node, mi)
+    if: site != 0 && (site\signature >= 0 || site\held >= 0)
+        return: 0
+    if: l2_text_eq(head, "cast") != 0
+        return: 1
+    if: l2_text_eq(head, "length") != 0 && l2_call_head_method(mi, head, @ formal) < 0
+        return: 2
+    if: l2_external_head(head, mi) != 0
+        return: 3
+return: 0
+
+# A borrowed range of the SAME prepared body, also used by signature actuals.
+# width=-1 selects the complete tail. No field or index is decoded here.
+fn: l2_primary_slice (@: L2ValueSpan value; int: start; int: width; @: L2ValueSpan out) int
+    int: n
+    @: L2ValueSpan values l2_primary_values(value, @ n)
+    if: n < 0 || start < 0 || start > n
+        return: 1
+    if: width < 0
+        width: n - start
+    if: width > n - start
+        return: 1
+    if: width = 0
+        return: l2_value_argument_ref(0, 0, value\node, out)
+return: l2_value_argument_ref(values + start, width, value\node, out)
+
+fn: l2_primary_cast_value (@: L2ValueSpan value; @: int type; @: L2Tx text; @: L2ValueSpan operand) int
+    @: LmP0Frame frame value\node\as\frame
+    int: n
+    @: L2ValueSpan values l2_primary_values(value, @ n)
+    if: frame\body = 0 || frame\trailer != 0 || frame\body\trailer != 0 || n < 2 || values = 0 || values[0].count != 1
+        return: 1
+    if: l2_cast_resolve(l2_span_node(values, 0), type, text) != 0 || l2_primary_slice(value, 1, -1, operand) != 0
+        return: 1
+    if: operand\grammar = 3 && l2_value_spans_expression(operand\values, operand\value_n) = 0
+        return: 1
+return: 0
+
+fn: l2_primary_array_value (@: L2ValueSpan value; int: mi; @: L2ValueSpan operand) int
+    @: LmP0Frame frame value\node\as\frame
+    int: type -1
+    int: kind
+    if: frame\body = 0 || frame\trailer != 0 || frame\body\trailer != 0 || l2_primary_slice(value, 0, -1, operand) != 0 || operand\count < 1
+        return: 1
+    if: operand\grammar = 3 && l2_value_spans_expression(operand\values, operand\value_n) = 0
+        return: 1
+    kind: l2_value_span_type(operand, mi, @ type)
+    # A failed source contract is final. Never compare its sentinel with
+    # another failed query (including allocation failure in type interning).
+    if: type < 0
+        return: 1
+return: (cast: (int) (type != l2_array_desc_ty()))
+
+fn: l2_primary_value_type (@: L2ValueSpan value; int: mi; @: int type) int
+    L2ValueSpan: operand
+    int: role l2_primary_role(value, mi)
+    if: role = 0
+        return: 2
+    if: role = 1
+        return: l2_primary_cast_value(value, type, 0, @ operand)
+    if: role = 2
+        \type: 2
+    else:
+        \type: -12
+    ---
+return: 0
+
+# CHECK/native/COUNT/EMIT project those same receiver operands. 2 means a
+# different receiver role, never a failed projection followed by raw retry.
+fn: l2_check_primary_value (@: L2ValueSpan value; int: mi; const: @(char path)) int
+    L2ValueSpan: operand
+    @: L2ValueSpan values
+    int: n
+    int: k 0
+    int: width
+    int: type
+    int: role l2_primary_role(value, mi)
+    if: role = 0
+        return: 2
+    if: role = 1
+        if: l2_primary_cast_value(value, @ type, 0, @ operand) != 0
+            return: l2_error(path, value\node, "unsupported cast contract")
+        return: l2_check_value_span(@ operand, mi, path, value\node)
+    if: role = 2
+        if: l2_primary_array_value(value, mi, @ operand) != 0
+            return: l2_error(path, value\node, "length requires one Array value")
+        return: l2_check_value_span(@ operand, mi, path, value\node)
+    values: l2_primary_values(value, @ n)
+    if: n < 0
+        return: l2_error_fatal(path, value\node, "internal: a machine call lost its prepared body")
+    while: k < n
+        width: l2_value_argument_extent(values, n, k)
+        if: width < 1 || l2_primary_slice(value, k, width, @ operand) != 0
+            return: l2_error(path, value\node, "incomplete machine argument expression")
+        if: l2_check_value_span(@ operand, mi, path, value\node) != 0
+            return: 1
+        k: k + width
+    ---
+return: 0
