MapBytesDecodeLegacy:
    @: bytes
    required: bytes
    return: @
    decodeLegacy:
        throws: copy(MapThrows)
        @: units MapVector\create()
        int: i 0
        while: i < bytes\count
            int: value MapBytes\get(bytes; i)
            i += 1
            if: value = 0
                if: bytes\count - i < 2
                    throw: MapFailure("truncated legacy escaped unit")
                value := MapBytes\get(bytes; i) * 256 + MapBytes\get(bytes; i + 1)
                i += 2
            else:
                if: value >= 128
                    throw: MapFailure("ambiguous unescaped legacy non-ASCII byte")
            MapVector\push(units; (value record))
        @: result MapVector\create()
        i := 0
        while: i < length(units)
            int: value \units[i]
            i += 1
            if: value >= 55296 && value <= 56319
                if: i >= length(units)
                    throw: MapFailure("missing legacy low surrogate")
                int: low \units[i]
                if: low < 56320 || low > 57343
                    throw: MapFailure("invalid legacy low surrogate")
                value := 65536 + (value - 55296) * 1024 + low - 56320
                i += 1
            else:
                if: value >= 56320 && value <= 57343
                    throw: MapFailure("unpaired legacy low surrogate")
            MapVector\push(result; (value record))
        return: result

