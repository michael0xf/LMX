# A later body segment names a body, and the name after it a field declared there (unit_body_seg_method): M's while body
# declares no q, so the path M\while\q is refused where it stands -- the walked root says it as the check does.
fn: M () int
    int: k 0
    while: k < 3
        int: j 0
        j: k * 10
        k: k + 1
    return: 0
end: M
M()
int: r 0
r: M\while\q
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
