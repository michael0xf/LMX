# Ordinary L2 frontend namespace, callable and source views.
# The48 inherited compiler cells remain in the existing frontend; aliases address those same cells.
predef: "l2src/l2_application.h.lm1"
predef: "l2src/l2_frontend_helpers.h.lm1"
predef: "l2src/l2_frontend_alloc.h.lm1"
predef: "l2src/l2_frontend_values.h.lm1"
include: "<stddef.h>" "<stdio.h>" "<stdlib.h>" "<string.h>" "<limits.h>"

fn: lm_compiler_head_source_node (const: (@: source_node c.LmP0Node)) const: @: c.LmP0Node
    @@: head_expressions_cell c.L2HeadExpression (cast: (@@: c.L2HeadExpression) (@ c.l2_head_expressions))
    @: expression c.L2HeadExpression
    int: found 1
    while: source_node != 0 && found != 0
        found: 0
        expression: head_expressions_cell[0]
        while: expression != 0 && found = 0
            if: c.lm_compiler_node_in(c.lm_p0_document_root(expression\document), source_node) != 0
                source_node: expression\source
                found: 1
            expression: expression\allocated_next
        ---
    ---
    return: (cast: (const: @: c.LmP0Node) (source_node))
end: lm_compiler_head_source_node

fn: lm_compiler_dn (int: mi; int: k) @: c.LmP0Text
    @@@: m_dn_cell void (cast: (@@@: void) (@ c.l2_m_dn))
    @@: row c.LmP0Text
    if: mi < 0 || k < 0 || m_dn_cell[0][mi] = 0
        return: (cast: (@: c.LmP0Text) (0))
    row: (cast: (@@: c.LmP0Text) m_dn_cell[0][mi])
    return: (cast: (@: c.LmP0Text) (row[k]))
end: lm_compiler_dn

fn: lm_compiler_dt (int: mi; int: k) int
    @@@: m_dt_cell int (cast: (@@@: int) (@ c.l2_m_dt))
    @: row int
    if: mi < 0 || k < 0 || m_dt_cell[0] = 0 || m_dt_cell[0][mi] = 0
        return: (cast: (int) (0))
    row: m_dt_cell[0][mi]
    return: (cast: (int) (row[k]))
end: lm_compiler_dt

fn: lm_compiler_dn_set (int: mi; int: k; @: v c.LmP0Text) int
    @@@: m_dn_cell void (cast: (@@@: void) (@ c.l2_m_dn))
    @@: row c.LmP0Text
    if: mi < 0 || k < 0 || m_dn_cell[0][mi] = 0
        return: (cast: (int) (1))
    row: (cast: (@@: c.LmP0Text) m_dn_cell[0][mi])
    row[k]: v
    return: (cast: (int) (0))
end: lm_compiler_dn_set

fn: lm_compiler_dt_set (int: mi; int: k; int: v) int
    @@@: m_dt_cell int (cast: (@@@: int) (@ c.l2_m_dt))
    @: row int
    if: mi < 0 || k < 0 || m_dt_cell[0][mi] = 0
        return: (cast: (int) (1))
    row: m_dt_cell[0][mi]
    row[k]: v
    return: (cast: (int) (0))
end: lm_compiler_dt_set

fn: lm_compiler_ret_tr (const: (@: frame c.LmP0Frame)) @: c.LmP0Structure
    @: mad_cap_cell int (cast: (@: int) (@ c.l2_mad_cap))
    @@@: mad_suppressed_trailer_cell c.LmP0Frame (cast: (@@@: c.LmP0Frame) (@ c.l2_mad_suppressed_trailer))
    int: i 0
    while: i < mad_cap_cell[0]
        if: mad_suppressed_trailer_cell[0] != 0 && mad_suppressed_trailer_cell[0][i] = frame
            return: (cast: (@: c.LmP0Structure) (0))
        i: i + 1
    return: (cast: (@: c.LmP0Structure) (c.lm_compiler_source_ret_tr(frame)))
end: lm_compiler_ret_tr

fn: lm_compiler_source_definition_method (int: own) int
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@@: own_decl_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_own_decl))
    int: mi
    if: own < 0 || own >= own_n_cell[0]
        return: (cast: (int) (-1))
    mi: c.lm_compiler_method_by_source(own_decl_cell[0][own])
    if: mi < 0 || lm_compiler_m_nsof(mi) >= 0
        return: (cast: (int) (-1))
    return: (cast: (int) (mi))
end: lm_compiler_source_definition_method

fn: lm_compiler_ns_defining_node (int: ni) @: c.LmP0Node
    @: ns_n_cell int (cast: (@: int) (@ c.l2_ns_n))
    @@@: ns_def_node_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_ns_def_node))
    if: ni < 0 || ni >= ns_n_cell[0] || ns_def_node_cell[0] = 0
        return: (cast: (@: c.LmP0Node) (0))
    return: (cast: (@: c.LmP0Node) (ns_def_node_cell[0][ni]))
end: lm_compiler_ns_defining_node

fn: lm_compiler_ns_defining_body (int: ni) @: c.LmP0Structure
    @: ns_n_cell int (cast: (@: int) (@ c.l2_ns_n))
    @@@: ns_def_body_cell c.LmP0Structure (cast: (@@@: c.LmP0Structure) (@ c.l2_ns_def_body))
    if: ni < 0 || ni >= ns_n_cell[0] || ns_def_body_cell[0] = 0
        return: (cast: (@: c.LmP0Structure) (0))
    return: (cast: (@: c.LmP0Structure) (ns_def_body_cell[0][ni]))
end: lm_compiler_ns_defining_body

fn: lm_compiler_ns_defining_frame (int: ni) @: c.LmP0Frame
    @: source_node c.LmP0Node lm_compiler_ns_defining_node(ni)
    if: source_node = 0 || source_node\kind != c.LM_P0_NODE_FRAME || source_node\as = 0
        return: (cast: (@: c.LmP0Frame) (0))
    return: (cast: (@: c.LmP0Frame) (source_node\as\frame))
end: lm_compiler_ns_defining_frame

fn: lm_compiler_ns_def_free () int
    @@@: ns_def_node_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_ns_def_node))
    @@@: ns_def_body_cell c.LmP0Structure (cast: (@@@: c.LmP0Structure) (@ c.l2_ns_def_body))
    c.free((cast: (@: void) ns_def_node_cell[0]))
    c.free((cast: (@: void) ns_def_body_cell[0]))
    ns_def_node_cell[0]: 0
    ns_def_body_cell[0]: 0
    return: (cast: (int) (0))
end: lm_compiler_ns_def_free

fn: lm_compiler_ns_loop_body (int: ni; @: nas c.LmP0NodeAs) int
    @@@: ns_at_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_ns_at))
    @: body c.LmP0Structure lm_compiler_ns_defining_body(ni)
    @: defining c.LmP0Frame lm_compiler_ns_defining_frame(ni)
    @: blk_s c.LmP0Structure
    @: blk_as c.LmP0NodeAs
    @: blk c.LmP0Node
    @: fld c.LmP0Field
    @: outer c.LmP0Structure
    if: body = 0 || defining = 0
        return: (cast: (int) (1))
    blk_s: (cast: (@: c.LmP0Structure) c.lm_compiler_xmalloc(c.sizeof(c.LmP0Structure)))
    blk_as: (cast: (@: c.LmP0NodeAs) c.lm_compiler_xmalloc(c.sizeof(c.LmP0NodeAs)))
    blk: (cast: (@: c.LmP0Node) c.lm_compiler_xmalloc(c.sizeof(c.LmP0Node)))
    fld: (cast: (@: c.LmP0Field) c.lm_compiler_xmalloc(c.sizeof(c.LmP0Field)))
    outer: (cast: (@: c.LmP0Structure) c.lm_compiler_xmalloc(c.sizeof(c.LmP0Structure)))
    if: blk_s = 0 || blk_as = 0 || blk = 0 || fld = 0 || outer = 0
        c.lm_compiler_xfree((cast: (@: void) blk_s))
        c.lm_compiler_xfree((cast: (@: void) blk_as))
        c.lm_compiler_xfree((cast: (@: void) blk))
        c.lm_compiler_xfree((cast: (@: void) fld))
        c.lm_compiler_xfree((cast: (@: void) outer))
        return: (cast: (int) (1))
    c.memset((cast: (@: void) blk_s), 0, c.sizeof(c.LmP0Structure))
    c.memset((cast: (@: void) blk_as), 0, c.sizeof(c.LmP0NodeAs))
    c.memset((cast: (@: void) blk), 0, c.sizeof(c.LmP0Node))
    c.memset((cast: (@: void) fld), 0, c.sizeof(c.LmP0Field))
    c.memset((cast: (@: void) outer), 0, c.sizeof(c.LmP0Structure))
    blk_s\first_field: body\first_field
    blk_s\last_field: body\last_field
    blk_s\field_count: body\field_count
    blk_s\trailer: defining\trailer
    blk_as\structure: blk_s
    blk\kind: c.LM_P0_NODE_STRUCTURE
    blk\as: blk_as
    blk\span: ns_at_cell[0][ni]\span
    fld\value: blk
    outer\first_field: fld
    outer\last_field: fld
    outer\field_count: 1U
    nas\structure: outer
    return: (cast: (int) (0))
end: lm_compiler_ns_loop_body

fn: lm_compiler_ns_proc_body_free (int: ni; @: source_node c.LmP0Node) int
    @: outer c.LmP0Structure
    @: field c.LmP0Field
    @: block c.LmP0Node
    if: source_node = 0
        return: (cast: (int) (0))
    outer: source_node\as\structure
    if: outer != lm_compiler_ns_defining_body(ni)
        field: outer\first_field
        block: field\value
        c.lm_compiler_xfree((cast: (@: void) block\as\structure))
        c.lm_compiler_xfree((cast: (@: void) block\as))
        c.lm_compiler_xfree((cast: (@: void) block))
        c.lm_compiler_xfree((cast: (@: void) field))
        c.lm_compiler_xfree((cast: (@: void) outer))
    ---
    c.lm_compiler_xfree((cast: (@: void) source_node\as))
    c.lm_compiler_xfree((cast: (@: void) source_node))
    return: (cast: (int) (0))
end: lm_compiler_ns_proc_body_free

fn: lm_compiler_ns_original_body (int: ni) @: c.LmP0Structure
    @: ns_n_cell int (cast: (@: int) (@ c.l2_ns_n))
    @@@: ns_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_ns_name))
    @: source_node c.LmP0Node
    @: defining c.LmP0Frame
    @: body c.LmP0Structure
    @: field c.LmP0Field
    @: operand c.LmP0Node
    if: ni < 0 || ni >= ns_n_cell[0]
        return: (cast: (@: c.LmP0Structure) (0))
    source_node: lm_compiler_ns_defining_node(ni)
    body: lm_compiler_ns_defining_body(ni)
    if: source_node = 0 || body = 0
        return: (cast: (@: c.LmP0Structure) (0))
    defining: lm_compiler_ns_defining_frame(ni)
    if: defining != 0
        # The Structure constructor's name and body are its operands, not its
        # receiver head. Keep the captured producer identities authoritative.
        if: c.lm_compiler_text_eq(defining\head, "()") != 0 && defining\body != 0 && c.lm_compiler_count_active(defining\body) = 2
            field: c.lm_compiler_next_active(defining\body\first_field)
            @: operand_field c.LmP0Field c.lm_compiler_next_active(field\next)
            operand: operand_field\value
            if: field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM && field\value\as != 0 && field\value\as\atom = ns_name_cell[0][ni] && operand != 0 && operand\kind = c.LM_P0_NODE_STRUCTURE && operand\as != 0 && operand\as\structure = body
                return: (cast: (@: c.LmP0Structure) (body))
        ---
        if: ns_name_cell[0][ni] != defining\head && lm_compiler_ns_part(ni) < 0
            return: (cast: (@: c.LmP0Structure) (0))
        ---
    else:
        if: source_node\kind != c.LM_P0_NODE_STRUCTURE || lm_compiler_ns_part(ni) < 0
            return: (cast: (@: c.LmP0Structure) (0))
        ---
    return: (cast: (@: c.LmP0Structure) (body))
end: lm_compiler_ns_original_body

fn: lm_compiler_ns_part (int: ni) int
    @@: part_ns_cell int (cast: (@@: int) (@ c.l2_part_ns))
    @: part_n_cell int (cast: (@: int) (@ c.l2_part_n))
    int: k 0
    while: ni >= 0 && part_ns_cell[0] != 0 && k < part_n_cell[0]
        if: part_ns_cell[0][k] = ni
            return: (cast: (int) (k))
        k: k + 1
    ---
    return: (cast: (int) (0 - 1))
end: lm_compiler_ns_part

fn: lm_compiler_ns_top (int: ni) int
    @: ns_n_cell int (cast: (@: int) (@ c.l2_ns_n))
    @@: ns_parent_cell int (cast: (@@: int) (@ c.l2_ns_parent))
    int: t ni
    while: t >= 0 && t < ns_n_cell[0] && ns_parent_cell[0][t] >= 0
        t: ns_parent_cell[0][t]
    ---
    return: (cast: (int) (t))
end: lm_compiler_ns_top

fn: lm_compiler_own_find_decl (int: mi; const: (@: t c.LmP0Text); const: (@: at c.LmP0Node)) int
    @@: own_reuses_cell c.L2OwnReuse (cast: (@@: c.L2OwnReuse) (@ c.l2_own_reuses))
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@@: own_decl_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_own_decl))
    @@@: own_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_own_name))
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    int: i 0
    @: reuse c.L2OwnReuse own_reuses_cell[0]
    if: t = 0 || at = 0
        return: (cast: (int) (-1))
    while: i < own_n_cell[0]
        if: own_decl_cell[0][i] = at && c.lm_compiler_text_same(own_name_cell[0][i], t)
            if: own_mi_cell[0][i] = mi
                return: (cast: (int) (i))
        ---
        i: i + 1
    while: reuse != 0
        if: reuse\source = at && reuse\method = mi && reuse\own >= 0 && reuse\own < own_n_cell[0] && c.lm_compiler_text_same(own_name_cell[0][reuse\own], t) != 0
            return: (cast: (int) (reuse\own))
        reuse: reuse\allocated_next
    return: (cast: (int) (-1))
end: lm_compiler_own_find_decl

fn: lm_compiler_own_source_after (int: row; int: previous) int
    @@@: own_decl_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_own_decl))
    const: (@: source c.LmP0Node lm_compiler_head_source_node(own_decl_cell[0][row]))
    const: (@: before c.LmP0Node 0)
    if: previous < 0
        return: (cast: (int) (1))
    before: lm_compiler_head_source_node(own_decl_cell[0][previous])
    if: source != 0 && source\span != 0 && before != 0 && before\span != 0 && source\span\offset != before\span\offset
        return: (cast: (int) (source\span\offset > before\span\offset))
    # Generated/no-span bindings retain their stable existing identity order.
    return: (cast: (int) (row > previous))
end: lm_compiler_own_source_after

fn: lm_compiler_own_any (int: mi; const: (@: t c.LmP0Text)) int
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    @@@: own_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_own_name))
    int: i 0
    if: mi < 0 || t = 0
        return: (cast: (int) (-1))
    while: i < own_n_cell[0]
        if: own_mi_cell[0][i] = mi && c.lm_compiler_text_same(own_name_cell[0][i], t)
            return: (cast: (int) (i))
        i: i + 1
    return: (cast: (int) (-1))
end: lm_compiler_own_any

fn: lm_compiler_dyn_find (int: mi; const: (@: t c.LmP0Text)) int
    @@: m_dyn_cell int (cast: (@@: int) (@ c.l2_m_dyn))
    int: i 0
    if: mi < 0 || t = 0
        return: (cast: (int) (-1))
    while: i < m_dyn_cell[0][mi]
        if: c.lm_compiler_text_same(lm_compiler_dn(mi, i), t)
            return: (cast: (int) (i))
        i: i + 1
    return: (cast: (int) (-1))
end: lm_compiler_dyn_find

fn: lm_compiler_param_find (int: mi; const: (@: t c.LmP0Text)) int
    @@: m_arity_cell int (cast: (@@: int) (@ c.l2_m_arity))
    int: fi
    int: di
    fi: c.lm_compiler_formal_find(mi, t)
    if: fi >= 0
        return: (cast: (int) (fi))
    di: lm_compiler_dyn_find(mi, t)
    if: di >= 0
        return: (cast: (int) (m_arity_cell[0][mi] + di))
    return: (cast: (int) (-1))
end: lm_compiler_param_find

fn: lm_compiler_param_is (int: mi; const: (@: t c.LmP0Text)) int
    if: mi < 0 || t = 0
        return: (cast: (int) (0))
    if: c.lm_compiler_formal_find(mi, t) >= 0
        return: (cast: (int) (1))
    if: lm_compiler_dyn_find(mi, t) >= 0
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: lm_compiler_param_is

fn: lm_compiler_param_ty (int: mi; const: (@: t c.LmP0Text)) int
    int: fi
    int: di
    if: mi < 0 || t = 0
        return: (cast: (int) (0))
    fi: c.lm_compiler_formal_find(mi, t)
    if: fi >= 0
        return: (cast: (int) (c.lm_compiler_ft(mi, fi)))
    di: lm_compiler_dyn_find(mi, t)
    if: di >= 0 && lm_compiler_dt(mi, di) != 0
        return: (cast: (int) (c.lm_compiler_ft_of_own(c.lm_compiler_own_of_dt(lm_compiler_dt(mi, di)))))
    return: (cast: (int) (0))
end: lm_compiler_param_ty

fn: lm_compiler_application_actual_empty (const: (@: actual c.L2ApplicationActual); int: signature; int: formal) int
    const: (@: value c.L2ValueSpan)
    if: actual = 0 || signature < 0 || formal < 0 || lm_compiler_nsty_get(signature, formal) < 0
        return: (cast: (int) (0))
    value: @ actual\value
    if: actual\structured != 0 && value\value_n = 0
        return: (cast: (int) (1))
    return: (cast: (int) (c.lm_compiler_empty_struct(value\node)))
end: lm_compiler_application_actual_empty

fn: lm_compiler_d105_key_own (int: key) int
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    if: key > -2 || key < -1 - own_n_cell[0]
        return: (cast: (int) (-1))
    return: (cast: (int) (-2 - key))
end: lm_compiler_d105_key_own

fn: lm_compiler_d105_key_field (int: key) int
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @: nsf_n_cell int (cast: (@: int) (@ c.l2_nsf_n))
    int: row
    if: key >= -1 - own_n_cell[0]
        return: (cast: (int) (-1))
    row: key - c.INT_MIN
    if: row < 0 || row >= nsf_n_cell[0]
        return: (cast: (int) (-1))
    return: (cast: (int) (row))
end: lm_compiler_d105_key_field

fn: lm_compiler_d105_key_method (int: mi; int: key) int
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    int: own lm_compiler_d105_key_own(key)
    if: own >= 0 && own < own_n_cell[0]
        return: (cast: (int) (own_mi_cell[0][own]))
    return: (cast: (int) (mi))
end: lm_compiler_d105_key_method

fn: lm_compiler_own_self_typed (int: oi) int
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@@: own_decl_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_own_decl))
    @@@: own_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_own_name))
    @: d c.LmP0Node
    if: oi < 0 || oi >= own_n_cell[0]
        return: (cast: (int) (0))
    d: own_decl_cell[0][oi]
    if: d = 0 || d\kind != c.LM_P0_NODE_FRAME || d\as = 0 || d\as\frame = 0 || d\as\frame\head = 0 || d\as\frame\body = 0
        return: (cast: (int) (0))
    if: d\as\frame\trailer != 0 || d\as\frame\body\trailer != 0 || c.lm_compiler_count_active(d\as\frame\body) != 0
        return: (cast: (int) (0))
    return: (cast: (int) ((cast: (int) (c.lm_compiler_text_same(d\as\frame\head, own_name_cell[0][oi]) != 0))))
end: lm_compiler_own_self_typed

fn: lm_compiler_ns_empty (int: ni) int
    @: ns_n_cell int (cast: (@: int) (@ c.l2_ns_n))
    @@@: ns_at_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_ns_at))
    @: at c.LmP0Node
    if: ni < 0 || ni >= ns_n_cell[0]
        return: (cast: (int) (0))
    at: ns_at_cell[0][ni]
    if: at = 0 || at\kind != c.LM_P0_NODE_FRAME || at\as = 0 || at\as\frame = 0
        return: (cast: (int) (0))
    if: at\as\frame\trailer != 0 && at\as\frame\trailer\spelling != 0 && c.lm_compiler_text_eq(at\as\frame\trailer\spelling, "until") != 0
        return: (cast: (int) (0))
    return: (cast: (int) ((cast: (int) (at\as\frame\body = 0 || c.lm_compiler_count_active(at\as\frame\body) = 0))))
end: lm_compiler_ns_empty

fn: lm_compiler_own_formal (int: mi; int: k) int
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@@: own_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_own_name))
    if: mi < 0 || k < 0 || k >= own_n_cell[0]
        return: (cast: (int) (0 - 1))
    return: (cast: (int) (lm_compiler_param_find(mi, own_name_cell[0][k])))
end: lm_compiler_own_formal

fn: lm_compiler_source_materialized (int: fid) @: c.L2SourceContainer
    @@: source_containers_cell c.L2SourceContainer (cast: (@@: c.L2SourceContainer) (@ c.l2_source_containers))
    @: row c.L2SourceContainer source_containers_cell[0]
    if: fid < 0
        return: (cast: (@: c.L2SourceContainer) (0))
    while: row != 0
        if: row\fid = fid && row\inert = 0
