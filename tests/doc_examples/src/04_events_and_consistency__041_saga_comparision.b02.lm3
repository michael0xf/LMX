SagaMessage:
    int: phase 0
    int: kind
    int: ok
    @: transport
    handle:
        int: action 0
        if: kind = 0 && node\phase = 0
            action := 1
        if: kind = 1 && node\phase = 1
            if: ok
                action := 2
            else:
                action := 4
        ---
        if: kind = 2 && node\phase = 2
            if: ok
                action := 5
            else:
                action := 3
        ---
        if: kind = 3 && node\phase = 3 && ok
            action := 4
        if: action != 0
            node\phase := action
            node\transport\publish(action)
