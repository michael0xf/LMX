# Positive: the exported machine function m_twice calls the module's own function m_inc, defined after it; the exports
# compute where C's operator is L2's: size_t arithmetic, and an int division and remainder by positive literals.
fn: m_twice (size_t: a) size_t
    return: m_inc(m_inc(a))
end: m_twice
fn: m_half (int: a) int
    return: a / 2
end: m_half
fn: m_rest (int: a) int
    return: a % 3
end: m_rest
fn: m_span (size_t: a; size_t: b) size_t
    return: (a - b) * 2U + a / b
end: m_span
fn: m_inc (size_t: a) size_t
    return: a + 1U
end: m_inc
