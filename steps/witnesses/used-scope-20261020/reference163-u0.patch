+# Match original SOURCE identity to an existing fact,not a spelling or a
+# reconstructed field run. Transparent groups are normalized by the owning
+# value list before this query. Ambiguity remains unknown evidence.
+fn: l2_reference_value_fact (@: L2ValueSpan value; int: mi; @@: L2PathFact out) int
+    @: L2PathFact fact l2_path_facts
+    @: L2PathFact found 0
+    int: matches
+    \out: 0
+    if: value = 0 || value\node = 0 || value\count < 1
+        return: 0
+    while: fact != 0
+        if: fact\method = mi && fact\source = value\node && fact\source_use != 0
+            matches: (cast: (int) ((fact\source_use = 2 && value\count = 1) || (fact\source_use = 1 && fact\resolved.run_count = value\count)))
+            if: matches != 0
+                if: found != 0
+                    return: 2
+                found: fact
+            ---
+        ---
+        fact: fact\next
+    ---
+    \out: found
+return: (cast: (int) (found != 0))
+
+# Complete source provenance is a projection of the held value. Casts
+# preserve a POINTER operand's source,not the cast target's declared type.
+# An ordinary call borrows its already bound application signature/result
+# port;unclassified data Frames do not turn into calls in this query.
+fn: l2_reference_value_core (@: L2ValueSpan value; int: mi; const: @(L2Path selected); @: L2ReferenceSource out) int
+    @: L2PathFact fact 0
+    @: L2ApplicationSite application
+    @: L2ValueSpan operand
+    int: status
+    int: projected
+    int: target
+    int: exact -1
+    int: kind
+    if: selected != 0
+        if: selected\fail_why != 0
+            return: 0
+        status: l2_reference_value_fact(value, mi, @ fact)
+        if: status = 2
+            return: 0
+        if: selected\fail_why = 0
+            projected: l2_reference_record_source(selected, mi, out)
+            # An earlier query fact is the SAME current prepared path,not
+            # a request to resolve it again in a later source environment.
+            if: fact = 0 && selected\n > 0 && projected = 0
+                l2_reference_source_of_path(selected, out)
+            ---
+        ---
+        if: fact != 0
+            out\path: fact
+        if: l2_alloc_err != 0
+            return: l2_alloc_or(l2_src, value\node, "cannot project a prepared source")
+        return: 0
+    ---
+    if: value\primary = 0 || value\count != 1
+        return: 0
+    if: l2_frame_head(value\node, "cast") != 0
+        if: value\primary\body_n != 2
+            return: 0
+        if: l2_cast_resolve(value\primary\body\node, @ target, 0) != 0 || l2_pointer_depth(target) = 0
+            return: 0
+        operand: value\primary\body + 1
+        kind: l2_value_span_type(operand, mi, @ exact)
+        if: l2_alloc_err != 0
+            return: l2_alloc_or(l2_src, value\node, "cannot type a cast source")
+        if: kind != -5 && l2_pointer_depth(exact) = 0
+            return: 0
+        return: l2_reference_source_value(operand, mi, out)
+    application: l2_application_site_find(value\node, mi)
+    if: application != 0 && application\bound != 0 && application\signature >= 0
+        out\schema: l2_input_model((application\signature), -1)
+        out\method: application\signature
+        out\place: -1
+return: 0
