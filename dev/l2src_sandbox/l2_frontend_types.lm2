    const: (@: root c.LmP0Node)
    @: expression c.L2HeadExpression head_expressions_cell[0]
    int: i 0
    while: site = 0 && part_doc_cell[0] != 0 && i < part_n_cell[0]
        root: c.lm_p0_document_root(part_doc_cell[0][i])
        if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0
            site: lm_compiler_node_of_text((cast: (const: @: c.LmP0Structure) (root\as\structure)), t)
        i: i + 1
    ---
    while: site = 0 && expression != 0
        site: lm_compiler_node_of_text((cast: (const: @: c.LmP0Structure) (expression\body)), t)
        expression: expression\allocated_next
    ---
    if: site = 0
        site: here_node_cell[0]
    return: (cast: (const: @: c.LmP0Node) (c.lm_compiler_head_source_node(site)))
end: lm_compiler_ns_source_site

fn: lm_compiler_ns_find (const: (@: t c.LmP0Text)) int
    @: ns_n_cell int (cast: (@: int) (@ c.l2_ns_n))
    @@@: ns_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_ns_name))
    int: i 0
    int: rank
    int: selected -1
    int: selected_rank -1
    int: site_ready 0
    const: (@: site c.LmP0Node 0)
    while: i < ns_n_cell[0]
        if: c.lm_compiler_text_same(ns_name_cell[0][i], t) != 0
            if: site_ready = 0
                site: lm_compiler_ns_source_site(t)
                site_ready: 1
            ---
            rank: c.lm_compiler_ns_source_rank(i, site)
            # At one eligible lexical depth, the latest source occurrence is
            # the bare-name binding; an ineligible (-1) later declaration must
            # never win merely because the selected rank is still -1.
            if: rank >= 0 && rank >= selected_rank
                selected: i
                selected_rank: rank
            ---
        ---
        i: i + 1
    ---
    return: (cast: (int) (selected))
end: lm_compiler_ns_find

fn: lm_compiler_contract_model_word (@: contract c.L2TypeContract; const: (@: word c.LmP0Text)) int
    c.L2SourceSite: saved
    int: horizon_on
    size_t: horizon_at
    int: entered c.lm_compiler_contract_source_begin(contract, @ saved, @ horizon_on, @ horizon_at)
    int: answer
    if: entered < 0
        return: (cast: (int) (-1))
    answer: lm_compiler_type_model(word)
    if: entered > 0 && c.lm_compiler_contract_source_end(@ saved, horizon_on, horizon_at) != 0
        return: (cast: (int) (-1))
    return: (cast: (int) (answer))
