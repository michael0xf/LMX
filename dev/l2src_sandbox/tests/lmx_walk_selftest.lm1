predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# The walk of a body tree, on graphs built by hand: no translator emits body nodes yet.
# Every program below is an ordinary callable occurrence M in one unit; its body is M
# after child[0].  A node refers to its role, to the Structure that holds a field and to
# a callee by ADDRESS; the only numbers are the slot of a field inside its Structure and
# the ordinal of a declared input.  There are no names anywhere.
#
# Every body is PREPARED once (lmx_walk_prepare: its activation plan is published into the
# descriptor) before it is run; an unprepared body is refused.  The letters in the
# comments below are the acceptance tests of steps/l3-activation-plan.md.

@: LmxArena ga 0
@: Lmx groles 0
@: Lmx gplan_roles 0
@: LmxWalkContext gctx 0
@: LmxWalkValue gv 0
int: broken 0
int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

# A frame node under `parent`, stored into parent[slot].
fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(ga, groles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

# A plain Structure (a body) under `parent`, stored into parent[slot].
fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(ga, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

# A reference stored into code[slot].
sub: ref (@: Lmx code; size_t: slot; @: Lmx target)
    if: code = 0 || target = 0 || lmx_arena_ref_store(code, slot, (cast: (@: void) target)) != 0
        broken: broken + 1
    ---
end: ref

sub: sz (@: Lmx code; size_t: slot; size_t: value)
    if: code = 0 || lmx_walk_store_size(ga, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: sz

# An own int cell of `holder` at `slot`, with its initial value.
fn: icell (@: Lmx holder; size_t: slot; int: value) @: void
    if: holder = 0 || lmx_walk_store_int(ga, holder, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
        return: 0
    ---
return: lmx_arena_ref_value(holder, slot)

fn: lit (@: Lmx parent; size_t: slot; int: value) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_LIT, 2U)
    if: n != 0 && lmx_walk_store_int(ga, n, 1U, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
return: n

# [own, holder, slot]: the field `index` of the Structure `holder`, by reference.
fn: own (@: Lmx parent; size_t: slot; @: Lmx holder; size_t: index) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_OWN, 3U)
    ref(n, 1U, holder)
    sz(n, 2U, index)
return: n

fn: argn (@: Lmx parent; size_t: slot; size_t: k) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_ARG, 2U)
    sz(n, 1U, k)
return: n


# G1 native trampolines (prim ABI). Mutant: refuse addr!=0 -> RED; collapse status -> RED.
fn: g1_seven (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    if: nargs != 1U || refs = 0 || dest = 0 || out = 0
        c.fprintf(l1_stderr(), "lmx: invariant: g1_seven nargs\n")
        c.abort()
    ---
    lmx_int_store_known(dest, 7)
    \out: dest
return: 0

fn: g1_throw2 (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    \out: 0
return: 2

# A callable occurrence under the unit: child[0] is a fresh LmxCallable, nothing native.
fn: mk_m (@: Lmx unit; size_t: slot; size_t: children) @: Lmx
    @: Lmx m pl(unit, slot, children)
    @: LmxCallable info lmx_callable_new_owned(ga)
    if: m = 0 || info = 0 || lmx_arena_ref_store(m, 0U, (cast: (@: void) info)) != 0
        broken: broken + 1
        return: 0
    ---
return: m

# One direct call.  The value comes back as a REFERENCE; an int result is read through
# it, whether it is the record's own destination cell or a cell of the graph.
fn: go (@: Lmx m; @@: void args; size_t: nargs; @: int r; @: int v) int
    int: st
    st: lmx_walk_run(gctx, m, args, nargs, gv)
    \v: gv\present
    if: st = c.LMX_WALK_OK && gv\present != 0 && gv\ref != 0
        \r: lmx_int_value_known(gv\ref)
    ---
return: st

# Cells every array of the arena has handed out so far: an allocation anywhere moves it.
fn: handed (@: LmxArena a) size_t
    @: LmxPool pool 0
    size_t: n 0U
    if: a = 0
        return: 0U
    pool: a\arrays
    while: pool != 0
        n: n + lmx_pool_count(pool)
        pool: pool\next
    ---
return: n

# A sum over every byte the arena's arrays have handed out -- cells, slot arrays and
# Structure headers alike: any write anywhere in the graph moves it.
fn: digest (@: LmxArena a) size_t
    @: LmxPool pool 0
    @: LmxChunk chunk 0
    @: char bytes 0
    size_t: sum 0U
    size_t: n
    size_t: i
    if: a = 0
        return: 0U
    pool: a\arrays
    while: pool != 0
        chunk: lmx_pool_chunk_head(pool)
        while: chunk != 0
            bytes: (cast: (@: char) (cast: (@: void) lmx_chunk_data(chunk)))
            n: lmx_chunk_cells(chunk, pool\stride) * pool\stride
            i: 0U
            while: i < n
                sum: (sum * 31U) + (cast: (size_t) ((cast: (int) bytes[i]) & 255))
                i: i + 1U
            ---
            chunk: chunk\next
        ---
        pool: pool\next
    ---
return: sum

fn: main () int
    LmxArena: arena
    LmxArena: context_arena
    LmxPool: context_cells
    LmxScratch: store
    LmxWalkContext: context
    LmxScratchMark: mark
    LmxWalkFrame: frame
    @: LmxArena pca 0
    @: LmxScratch ps 0
    @: LmxWalkContext pc 0
    @: LmxScratchMark pm 0
    @: LmxArenaBlock blocks 0
    @: Lmx impostor 0
    @: Lmx lexer 0
    @: Lmx alone 0
    @: Lmx shorted 0
    @: Lmx padded 0
    @: Lmx plan 0
    @: Lmx entry 0
    @: LmxCallable info 0
    @: LmxCallable fresh 0
    @: size_t flat 0
    @: size_t lens 0
    @@: size_t paths 0
    size_t: before
    size_t: sum_before
    size_t: warm
    int: i 0
    @: LmxArena pa 0
    @: LmxWalkFrame pf 0
    @: LmxWalkOwn po 0
    @: Lmx unit 0
    @: Lmx immutable_profile 0
    @: Lmx other_profile 0
    @: Lmx immutable_local 0
    @: Lmx other_local 0
    @: Lmx n 0
    @: Lmx b 0
    @: Lmx e 0
    @: Lmx counter 0
    @: Lmx outer 0
    @: Lmx inner 0
    @: Lmx publisher 0
    @: Lmx reader 0
    @: Lmx summer 0
    @: Lmx looper 0
    @: Lmx bare 0
    @: Lmx faller 0
    @: Lmx stopper 0
    @: Lmx refuser 0
    @: Lmx orderer 0
    @: Lmx stranger 0
    @: Lmx copy 0
    @: void cell 0
    @: void xcell 0
    @@: void argv 0
    @: void abox 0
    @: void foreign 0
    @: Lmx subject 0
    @: Lmx peek 0
    @: Lmx bump 0
    @: Lmx relay 0
    @: Lmx echo 0
    @: Lmx hop 0
    @: Lmx self 0
    @: Lmx poke 0
    @: Lmx qualified_writer 0
    # Stage C (GROKBOT-CALLABLE-INTERP-STAGEC): nullary RET invoke + descriptor-only.
    @: Lmx test 0
    @: Lmx test2 0
    @: Lmx test3 0
    @: Lmx test4 0
    @: Lmx host 0
    @: Lmx tracer 0
    @: Lmx bare_stmt 0
    @: Lmx data_stmt 0
    @: Lmx pair 0
    @: Lmx tramp 0
    @: Lmx tramp2 0
    @: Lmx native7 0
    @: Lmx native2 0
    @: Lmx caller7 0
    @: Lmx caller2 0
    @: LmxMethod method7 0
    @: LmxMethod method2 0
    @: Lmx plain_data 0
    @: Lmx g3_body 0
    @: Lmx g3_decl 0
    @: Lmx d45_body 0
    @: Lmx d45_eternal 0
    @: Lmx tramp3 0
    int: r 0
    int: v 0
    int: st 0

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        fputs("lmx_walk: arena\n", l1_stdout())
        return: 2
    pa: @ arena
    ga: pa
    groles: lmx_walk_roles_open(ga)
    # The execution context: an ordinary arena of its own, never attached to the graph's,
    # the temporary-frame store in it, and the program's roles.
    memset((cast: (@: void) (@ context_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxScratch))
    pca: @ context_arena
    ps: @ store
    pc: @ context
    pm: @ mark
    if: lmx_arena_open(pca) != 0 || lmx_scratch_open(ps, pca, @ context_cells, 16U) != c.LMX_SCRATCH_OK
        fputs("lmx_walk: context\n", l1_stdout())
        return: 2
    gplan_roles: lmx_plan_roles_open(ga)
    pc\arena: ga
    pc\scratch: ps
    pc\roles: groles
    pc\plan_roles: gplan_roles
    pc\immutable_profile: 0
    pc\classified: 0U
    gctx: pc
    flat: (cast: (@: size_t) calloc(8U, c.sizeof(size_t)))
    lens: (cast: (@: size_t) calloc(4U, c.sizeof(size_t)))
    paths: (cast: (@@: size_t) calloc(4U, c.sizeof(@: void)))
    argv: (cast: (@@: void) calloc(2U, c.sizeof(@: void)))
    gv: (cast: (@: LmxWalkValue) calloc(1U, c.sizeof(c.LmxWalkValue)))
    # An input is a reference: the one integer input of these tests lives in a cell of
    # the graph's arena, and the programs are handed its address.
    abox: lmx_int_new_owned(ga)
    unit: lmx_node_new_owned(ga)
    argv[0]: abox
    if: groles = 0 || gplan_roles = 0 || flat = 0 || lens = 0 || paths = 0 || argv = 0 || gv = 0 || abox = 0 || unit = 0 || lmx_arena_refs_open_owned(ga, unit, 50U) != 0
        fputs("lmx_walk: unit\n", l1_stdout())
        return: 2
    ---

    # Immutable is an exact physical receiver-expression profile, not foreign ownership,
    # sealing or representation.  Prove the owner-local case explicitly: two STRUCT values
    # with different physical profiles must receive different answers.
    immutable_profile: lmx_node_new_owned(ga)
    other_profile: lmx_node_new_owned(ga)
    immutable_local: lmx_node_new_profiled(ga, immutable_profile)
    other_local: lmx_node_new_profiled(ga, other_profile)
    pf: @ frame
    pf\context: pc
    pf\arena: ga
    pc\immutable_profile: immutable_profile
    check(immutable_profile != 0 && other_profile != 0 && immutable_profile != other_profile && immutable_local != 0 && other_local != 0, "physical immutable-profile fixtures")
    check(lmx_range_classify(ga, (cast: (@: void) immutable_local)) = c.LMX_KIND_STRUCT && lmx_range_classify(ga, (cast: (@: void) other_local)) = c.LMX_KIND_STRUCT, "profile does not alter STRUCT representation")
    check(lmx_walk_immutable(pf, (cast: (@: void) immutable_local)) != 0, "owner-local exact immutable profile was writable")
    check(lmx_walk_immutable(pf, (cast: (@: void) other_local)) = 0, "same representation with another profile became immutable")
    if: lmx_arena_refs_open_owned(ga, immutable_local, 1U) != 0 || icell(immutable_local, 0U, 0) = 0
        broken: broken + 1
    ---
    pc\immutable_profile: 0
    pc\classified: 0U

    # Every occurrence first: a node refers to a callee and to a holder by address, so
    # the Structures have to exist before the bodies that point at them.
    counter: mk_m(unit, 0U, 4U)
    outer: mk_m(unit, 1U, 4U)
    inner: mk_m(unit, 2U, 2U)
    publisher: mk_m(unit, 3U, 4U)
    reader: mk_m(unit, 4U, 2U)
    summer: mk_m(unit, 5U, 3U)
    looper: mk_m(unit, 6U, 5U)
    bare: mk_m(unit, 7U, 2U)
    faller: mk_m(unit, 8U, 3U)
    stopper: mk_m(unit, 9U, 5U)
    refuser: mk_m(unit, 10U, 4U)
    orderer: mk_m(unit, 11U, 6U)
    stranger: mk_m(unit, 12U, 2U)
    impostor: mk_m(unit, 13U, 2U)
    lexer: mk_m(unit, 14U, 6U)
    alone: mk_m(unit, 15U, 2U)
    shorted: mk_m(unit, 16U, 5U)
    padded: mk_m(unit, 17U, 5U)
    peek: mk_m(unit, 18U, 2U)
    bump: mk_m(unit, 19U, 2U)
    relay: mk_m(unit, 20U, 2U)
    echo: mk_m(unit, 21U, 2U)
    hop: mk_m(unit, 22U, 2U)
    self: mk_m(unit, 23U, 2U)
    poke: mk_m(unit, 24U, 4U)
    # Stage C fixtures (slots 27..)
    test: mk_m(unit, 27U, 2U)
    test2: mk_m(unit, 28U, 2U)
    test3: mk_m(unit, 29U, 1U)
    test4: mk_m(unit, 30U, 2U)
    host: mk_m(unit, 31U, 2U)
    tracer: mk_m(unit, 37U, 3U)
    bare_stmt: mk_m(unit, 38U, 3U)
    data_stmt: mk_m(unit, 39U, 3U)
    # A subject: plain data, not a callable.  [ 7, 35 ]
    subject: pl(unit, 25U, 2U)
    icell(subject, 0U, 7)
    icell(subject, 1U, 35)
    # A body that would write an owner-local value of the exact immutable profile.
    qualified_writer: mk_m(unit, 26U, 2U)
    n: fr(qualified_writer, 1U, c.LMX_WALK_OP_PUT, 4U)
    ref(n, 1U, immutable_local)
    sz(n, 2U, 0U)
    lit(n, 3U, 1)

    # counter:   own n 0;  n: n + 1;  return: n
    cell: icell(counter, 1U, 0)
    n: fr(counter, 2U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, counter, 1U)
    e: fr(n, 2U, c.LMX_WALK_OP_ADD, 3U)
    own(e, 1U, counter, 1U)
    lit(e, 2U, 1)
    n: fr(counter, 3U, c.LMX_WALK_OP_RET, 2U)
    own(n, 1U, counter, 1U)

    # outer:     own x 1;  inner;  return: x          (21.6's worked case)
    # inner:     outer\x: 2                           (explicit field write, no cache)
    xcell: icell(outer, 1U, 1)
    n: fr(outer, 2U, c.LMX_WALK_OP_CALL, 3U)
    ref(n, 1U, inner)
    ref(n, 2U, inner)
    n: fr(outer, 3U, c.LMX_WALK_OP_RET, 2U)
    own(n, 1U, outer, 1U)
    n: fr(inner, 1U, c.LMX_WALK_OP_PUT, 4U)
    ref(n, 1U, outer)
    sz(n, 2U, 1U)
    lit(n, 3U, 2)

    # publisher: own y 0;  y: 5;  return: reader()    (dirty published before a call)
    # reader:    return: publisher\y                  (reads the graph)
    icell(publisher, 1U, 0)
    n: fr(publisher, 2U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, publisher, 1U)
    lit(n, 2U, 5)
    n: fr(publisher, 3U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_CALL, 3U)
    ref(e, 1U, reader)
    ref(e, 2U, reader)
    n: fr(reader, 1U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_AT, 3U)
    ref(e, 1U, publisher)
    sz(e, 2U, 1U)

    # summer (k): if: k < 1 { return: 0 };  return: k + summer(k - 1)
    n: fr(summer, 1U, c.LMX_WALK_OP_IF, 3U)
    e: fr(n, 1U, c.LMX_WALK_OP_LT, 3U)
    argn(e, 1U, 0U)
    lit(e, 2U, 1)
    b: pl(n, 2U, 1U)
    e: fr(b, 0U, c.LMX_WALK_OP_RET, 2U)
    lit(e, 1U, 0)
    n: fr(summer, 2U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_ADD, 3U)
    argn(e, 1U, 0U)
    n: fr(e, 2U, c.LMX_WALK_OP_CALL, 4U)
    ref(n, 1U, summer)
    e: fr(n, 2U, c.LMX_WALK_OP_FRESH, 2U)
    ref(e, 1U, summer)
    e: fr(n, 3U, c.LMX_WALK_OP_SUB, 3U)
    argn(e, 1U, 0U)
    lit(e, 2U, 1)

    # looper (k): own acc 0; own i 0
    #             while: i < k { own t 0;  t: i + 1;  acc: acc + t;  i: t }
    #             return: acc
    # `t` is a field of the loop's body: its holder is that body.
    icell(looper, 1U, 0)
    icell(looper, 2U, 0)
    n: fr(looper, 3U, c.LMX_WALK_OP_WHILE, 3U)
    e: fr(n, 1U, c.LMX_WALK_OP_LT, 3U)
    own(e, 1U, looper, 2U)
    argn(e, 2U, 0U)
    b: pl(n, 2U, 4U)
    icell(b, 0U, 0)
    n: fr(b, 1U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, b, 0U)
    e: fr(n, 2U, c.LMX_WALK_OP_ADD, 3U)
    own(e, 1U, looper, 2U)
    lit(e, 2U, 1)
    n: fr(b, 2U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, looper, 1U)
    e: fr(n, 2U, c.LMX_WALK_OP_ADD, 3U)
    own(e, 1U, looper, 1U)
    own(e, 2U, b, 0U)
    n: fr(b, 3U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, looper, 2U)
    own(n, 2U, b, 0U)
    n: fr(looper, 4U, c.LMX_WALK_OP_RET, 2U)
    own(n, 1U, looper, 1U)

    # bare:      own q 3                              (no body node at all)
    icell(bare, 1U, 3)

    # faller:    own z 0;  z: 7                       (void: falls off the end)
    icell(faller, 1U, 0)
    n: fr(faller, 2U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, faller, 1U)
    lit(n, 2U, 7)

    # stopper:   own w 0;  w: 9;  return;  w: 11      (a BARE role record as the return)
    icell(stopper, 1U, 0)
    n: fr(stopper, 2U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, stopper, 1U)
    lit(n, 2U, 9)
    if: stopper = 0 || lmx_arena_ref_store(stopper, 3U, lmx_arena_ref_value(groles, (cast: (size_t) c.LMX_WALK_OP_RET))) != 0
        broken: broken + 1
    ---
    n: fr(stopper, 4U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, stopper, 1U)
    lit(n, 2U, 11)

    # refuser:   own v 0;  v: 5;  if: 1 { } else { <a node whose role nobody reads> }
    # The unsupported node sits in a branch that would never be taken.
    icell(refuser, 1U, 0)
    n: fr(refuser, 2U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, refuser, 1U)
    lit(n, 2U, 5)
    n: fr(refuser, 3U, c.LMX_WALK_OP_IF, 4U)
    lit(n, 1U, 1)
    pl(n, 2U, 0U)
    b: pl(n, 3U, 1U)
    e: pl(b, 0U, 1U)
    if: e = 0 || lmx_arena_ref_store(e, 0U, (cast: (@: void) lmx_op_new_owned(ga, 99))) != 0
        broken: broken + 1
    ---

    # orderer:   own a 0; own b 0;  b: 2;  while: 0 { own t 0;  t: 3 };  a: 1
    # The body mentions b, then t, then a; lexically the fields stand a, b, t.
    icell(orderer, 1U, 0)
    icell(orderer, 2U, 0)
    n: fr(orderer, 3U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, orderer, 2U)
    lit(n, 2U, 2)
    n: fr(orderer, 4U, c.LMX_WALK_OP_WHILE, 3U)
    lit(n, 1U, 0)
    b: pl(n, 2U, 2U)
    icell(b, 0U, 0)
    e: fr(b, 1U, c.LMX_WALK_OP_SET, 3U)
    own(e, 1U, b, 0U)
    lit(e, 2U, 3)
    n: fr(orderer, 5U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, orderer, 1U)
    lit(n, 2U, 1)

    # stranger:  return: <counter's n, named as if it were stranger's OWN field>
    n: fr(stranger, 1U, c.LMX_WALK_OP_RET, 2U)
    own(n, 1U, counter, 1U)

    # impostor:  <a node whose child[0] is a PRIVATE op record with the number of `ret`>
    # The role is the shared record's address; the same number in another record is not it.
    n: pl(impostor, 1U, 1U)
    if: n = 0 || lmx_arena_ref_store(n, 0U, (cast: (@: void) lmx_op_new_owned(ga, c.LMX_WALK_OP_RET))) != 0
        broken: broken + 1
    ---

    # lexer (B):   own a 0;  while: 0 { own t 0;  t: 3 };  own b 0;  b: 2;  a: 1
    # Lexically the fields stand a, t, b -- t, inside the loop body, BEFORE b.  The body
    # mentions them t, b, a.  A layout that groups the fields of M before its bodies
    # (l2_layout_owns) would say a, b, t; the plan must say a, t, b.
    icell(lexer, 1U, 0)
    n: fr(lexer, 2U, c.LMX_WALK_OP_WHILE, 3U)
    lit(n, 1U, 0)
    b: pl(n, 2U, 2U)
    icell(b, 0U, 0)
    e: fr(b, 1U, c.LMX_WALK_OP_SET, 3U)
    own(e, 1U, b, 0U)
    lit(e, 2U, 3)
    icell(lexer, 3U, 0)
    n: fr(lexer, 4U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, lexer, 3U)
    lit(n, 2U, 2)
    n: fr(lexer, 5U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, lexer, 1U)
    lit(n, 2U, 1)

    # alone (H):   return          the whole body is one BARE role record
    if: alone = 0 || lmx_arena_ref_store(alone, 1U, lmx_arena_ref_value(groles, (cast: (size_t) c.LMX_WALK_OP_RET))) != 0
        broken: broken + 1
    ---

    # shorted, padded (G):   own p 0; own q 0;  p: 1;  q: 2      twice, for two wrong plans
    icell(shorted, 1U, 0)
    icell(shorted, 2U, 0)
    n: fr(shorted, 3U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, shorted, 1U)
    lit(n, 2U, 1)
    n: fr(shorted, 4U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, shorted, 2U)
    lit(n, 2U, 2)
    icell(padded, 1U, 0)
    icell(padded, 2U, 0)
    n: fr(padded, 3U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, padded, 1U)
    lit(n, 2U, 1)
    n: fr(padded, 4U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, padded, 1U)
    lit(n, 2U, 2)

    # peek (s):   return: s\1            a field of a reference input, by reference
    n: fr(peek, 1U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_OF, 3U)
    argn(e, 1U, 0U)
    sz(e, 2U, 1U)
    # bump (s):   return: s\0 + 1        an integer computed from a field of the subject
    n: fr(bump, 1U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_ADD, 3U)
    b: fr(e, 1U, c.LMX_WALK_OP_OF, 3U)
    argn(b, 1U, 0U)
    sz(b, 2U, 0U)
    lit(e, 2U, 1)
    # relay (s):  return: peek(s)        a reference handed down and back through two frames
    n: fr(relay, 1U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_CALL, 4U)
    ref(e, 1U, peek)
    ref(e, 2U, peek)
    argn(e, 3U, 0U)
    # echo (k):   return: k              an input returned as it came
    n: fr(echo, 1U, c.LMX_WALK_OP_RET, 2U)
    argn(n, 1U, 0U)
    # hop (k):    return: echo(k - 1)    the dangerous one: k - 1 lives in hop's scratch slice,
    #                                    echo returns that very reference, hop returns it on
    n: fr(hop, 1U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_CALL, 4U)
    ref(e, 1U, echo)
    ref(e, 2U, echo)
    b: fr(e, 3U, c.LMX_WALK_OP_SUB, 3U)
    argn(b, 1U, 0U)
    lit(b, 2U, 1)
    # self (s):   return: s              the subject itself
    n: fr(self, 1U, c.LMX_WALK_OP_RET, 2U)
    argn(n, 1U, 0U)
    # poke (s):   own z 0;  z: 1;  return: s       leaves a trace if it ever runs
    icell(poke, 1U, 0)
    n: fr(poke, 2U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, poke, 1U)
    lit(n, 2U, 1)
    n: fr(poke, 3U, c.LMX_WALK_OP_RET, 2U)
    argn(n, 1U, 0U)

    # ---- Stage C: callable occurrence fixtures ------------------------------------
    # test: return: 1
    n: fr(test, 1U, c.LMX_WALK_OP_RET, 2U)
    lit(n, 1U, 1)
    # test2(f): return: f   -- RET of ARG nullary-activates when f is callable
    n: fr(test2, 1U, c.LMX_WALK_OP_RET, 2U)
    argn(n, 1U, 0U)
    # test3: descriptor-only (CALLABLE child0, no body steps, header unset)
    # test4(f): same as test2; formal is the test3 shape (descriptor-compatible pass of test)
    n: fr(test4, 1U, c.LMX_WALK_OP_RET, 2U)
    argn(n, 1U, 0U)
    # host: return: 7  -- nullary callee for optional bag-arg CALL forms
    n: fr(host, 1U, c.LMX_WALK_OP_RET, 2U)
    lit(n, 1U, 7)
    # tracer: own t 0; t: 1  -- side effect for bare-callable statement
    icell(tracer, 1U, 0)
    n: fr(tracer, 2U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, tracer, 1U)
    lit(n, 2U, 1)
    # bare_stmt: tracer; return: 9  -- bare callable occurrence then return
    ref(bare_stmt, 1U, tracer)
    n: fr(bare_stmt, 2U, c.LMX_WALK_OP_RET, 2U)
    lit(n, 1U, 9)
    # a plain Structure (1 2) under unit, handed to a call as one argument; parent==caller
    # set at the use site
    pair: pl(unit, 33U, 2U)
    icell(pair, 0U, 1)
    icell(pair, 1U, 2)
    # data_stmt: plain; return: 1  -- plain Structure STATEMENT (parent != body) must not be silent OK
    # G3: a Structure whose parent IS the body is a declaration and is skipped; D-03 needs a
    # reference to an occurrence held elsewhere (same shape as bare_stmt / tracer).
    plain_data: pl(unit, 46U, 1U)
    icell(plain_data, 0U, 0)
    ref(data_stmt, 1U, plain_data)
    n: fr(data_stmt, 2U, c.LMX_WALK_OP_RET, 2U)
    lit(n, 1U, 1)

    check(broken = 0, "construction")
    if: broken != 0
        c.printf("lmx_walk: %d construction steps failed\n", broken)
        return: 2
    ---

    # ---- preparation ----------------------------------------------------------------
    # Unprepared, a body is refused: it is neither analysed at entry nor run natively.
    r: -5
    st: go(counter, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_UNSUPPORTED && r = -5 && v = 0 && lmx_int_value_known(cell) = 0, "an unprepared body is UNSUPPORTED, nothing of it runs, no value is reported")
    check(lmx_walk_plan_check(gctx, counter) = c.LMX_WALK_UNSUPPORTED, "and there is no plan to check")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, counter) = c.LMX_WALK_OK, "counter prepared")
    pc\immutable_profile: immutable_profile
    check(lmx_walk_prepare(gctx, ga, gplan_roles, qualified_writer) = c.LMX_WALK_INVALID && lmx_int_value_known(lmx_arena_ref_value(immutable_local, 0U)) = 0, "owner-local exact-profile write is refused during preparation")
    pc\immutable_profile: 0
    info: (cast: (@: LmxCallable) lmx_arena_ref_value(counter, 0U))
    plan: info\header
    check(plan != 0 && lmx_plan_entry_count(plan) = 1U && lmx_plan_slot_known(counter, plan, 0U) = lmx_arena_ref_cell(counter, 1U), "its plan: one entry, the slot of n")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, counter) = c.LMX_WALK_OK && info\header = plan, "preparing again is OK and leaves the published plan alone")
    check(lmx_walk_plan_check(gctx, counter) = c.LMX_WALK_OK, "the plan says what the body says")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, outer) = c.LMX_WALK_OK && lmx_walk_prepare(gctx, ga, gplan_roles, inner) = c.LMX_WALK_OK, "outer, inner prepared")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, publisher) = c.LMX_WALK_OK && lmx_walk_prepare(gctx, ga, gplan_roles, reader) = c.LMX_WALK_OK, "publisher, reader prepared")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, summer) = c.LMX_WALK_OK && lmx_walk_prepare(gctx, ga, gplan_roles, looper) = c.LMX_WALK_OK, "summer, looper prepared")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, faller) = c.LMX_WALK_OK && lmx_walk_prepare(gctx, ga, gplan_roles, stopper) = c.LMX_WALK_OK, "faller, stopper prepared")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, orderer) = c.LMX_WALK_OK && lmx_walk_prepare(gctx, ga, gplan_roles, alone) = c.LMX_WALK_OK, "orderer, alone prepared")
    info: (cast: (@: LmxCallable) lmx_arena_ref_value(summer, 0U))
    check(info\header != 0 && lmx_plan_entry_count(info\header) = 0U, "a body with no own field has a plan with no entry: prepared, not absent")
    # What cannot be prepared is not published.
    check(lmx_walk_prepare(gctx, ga, gplan_roles, bare) = c.LMX_WALK_NO_GRAPH, "no body node: nothing to prepare")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, refuser) = c.LMX_WALK_UNSUPPORTED, "a role outside the slice, even in a branch never taken: no plan")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, impostor) = c.LMX_WALK_UNSUPPORTED, "a private op record is not a role: no plan")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, stranger) = c.LMX_WALK_INVALID, "an own node naming another occurrence's field: no plan")
    info: (cast: (@: LmxCallable) lmx_arena_ref_value(stranger, 0U))
    check(info\header = 0, "and nothing was published for it")
    check(ps\used = 0U && ps\top = 0U, "preparation rewound everything it took from the store")

    # B: the plan is in the LEXICAL order of the fields -- a, t, b -- whatever the order
    # of mention and whatever a native layout would group.
    check(lmx_walk_prepare(gctx, ga, gplan_roles, lexer) = c.LMX_WALK_OK, "lexer prepared")
    info: (cast: (@: LmxCallable) lmx_arena_ref_value(lexer, 0U))
    plan: info\header
    check(plan != 0 && lmx_plan_entry_count(plan) = 3U, "three own fields")
    if: plan != 0 && lmx_plan_entry_count(plan) = 3U
        check(lmx_plan_slot_known(lexer, plan, 0U) = lmx_arena_ref_cell(lexer, 1U), "first: a")
        check(lmx_plan_slot_known(lexer, plan, 1U) = lmx_arena_ref_cell(lmx_arena_ref_struct(lmx_arena_ref_struct(lexer, 2U), 2U), 0U), "second: t, the loop body's field, which stands before b")
        check(lmx_plan_slot_known(lexer, plan, 2U) = lmx_arena_ref_cell(lexer, 3U), "third: b")
        entry: lmx_arena_ref_struct(plan, 2U)
        check(entry != 0 && entry\len = 4 && lmx_size_value_known(lmx_arena_ref_value(entry, 1U)) = 2U && lmx_size_value_known(lmx_arena_ref_value(entry, 2U)) = 2U && lmx_size_value_known(lmx_arena_ref_value(entry, 3U)) = 0U, "the position of t is 2, 2, 0: through the while node and its body")
    ---
    st: go(lexer, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && lmx_int_value_known(lmx_arena_ref_value(lexer, 1U)) = 1 && lmx_int_value_known(lmx_arena_ref_value(lexer, 3U)) = 2, "lexer ran by its plan")

    # G, the receiver's half: a plan that is well formed -- the generic unit publishes it --
    # and does not say what the body says.
    flat[0]: 1U
    lens[0]: 1U
    paths[0]: flat
    check(lmx_plan_build_from_paths(ga, gplan_roles, paths, lens, 1U, @ plan) = c.LMX_PLAN_OK && lmx_plan_publish(ga, gplan_roles, shorted, plan) = c.LMX_PLAN_OK, "a plan that omits q is well formed and gets published")
    check(lmx_walk_plan_check(gctx, shorted) = c.LMX_WALK_INVALID, "the receiver's check refuses it: the body uses a field the plan omits")
    st: go(shorted, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_INVALID, "and running by it is INVALID, not a guess")
    flat[0]: 1U
    flat[1]: 2U
    lens[0]: 1U
    lens[1]: 1U
    paths[0]: flat
    paths[1]: flat + 1U
    check(lmx_plan_build_from_paths(ga, gplan_roles, paths, lens, 2U, @ plan) = c.LMX_PLAN_OK && lmx_plan_publish(ga, gplan_roles, padded, plan) = c.LMX_PLAN_OK, "a plan with an entry no own node names gets published too")
    check(lmx_walk_plan_check(gctx, padded) = c.LMX_WALK_INVALID, "the receiver's check refuses the extra entry")

    # H: what an entry costs, counted at the one door this unit asks the arena through.
    pc\classified: 0U
    st: go(alone, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && v = 0 && pc\classified = 2U, "to the first body step: exactly two questions -- M a Structure, child[0] a CALLABLE; a bare return reports no value")
    pc\classified: 0U
    lmx_int_store_known(abox, 0)
    st: go(summer, argv, 1U, @ r, @ v)
    check(st = c.LMX_WALK_OK && pc\classified = 5U, "summer(0): one for the input at the public boundary, two on entry, one per executed body field -- the if, then the return inside it")
    pc\classified: 0U
    st: go(faller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && pc\classified = 4U, "faller: two, plus its two fields")
    lmx_int_store_known(lmx_arena_ref_value(faller, 1U), 0)

    # The role is the reference: two nodes of one role point at the very same record.
    check(lmx_arena_ref_value(lmx_arena_ref_struct(counter, 3U), 0U) = lmx_arena_ref_value(lmx_arena_ref_struct(outer, 3U), 0U), "two returns share one role record")
    check(lmx_arena_ref_value(lmx_arena_ref_struct(counter, 3U), 0U) != lmx_arena_ref_value(lmx_arena_ref_struct(counter, 2U), 0U), "different roles are different records")

    # counter: SET writes the cell; the next activation reads that cell.
    r: -1
    st: go(counter, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 1 && v = 1, "counter first run returns 1, and says it returned a value")
    check(lmx_int_value_known(cell) = 1, "counter cell n = 1 after SET")
    st: go(counter, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 2, "counter second run returns 2")

    # -188: cells are the graph — outer RET OWN after CALL sees inner's PUT (no snapshot).
    r: -1
    st: go(outer, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 2, "outer RET OWN sees callee PUT (mutant snapshot -> RED)")
    check(lmx_int_value_known(xcell) = 2, "callee write visible in cell immediately")

    # -188: SET writes the cell before the outbound call; reader sees it.
    r: -1
    st: go(publisher, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 5, "SET cell visible to callee before the call")

    # Recursion is recursion of the C stack on one published M; an early return inside
    # a nested body ends the activation, the last return is never reached then.
    r: -1
    lmx_int_store_known(abox, 4)
    st: go(summer, argv, 1U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 10, "summer(4) = 10")
    r: -1
    lmx_int_store_known(abox, 0)
    st: go(summer, argv, 1U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 0, "summer(0) takes the early return")
    st: go(summer, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_INVALID, "a missing declared input is refused")

    # A field of a nested body is an own field too; its holder is the body.
    r: -1
    lmx_int_store_known(abox, 4)
    st: go(looper, argv, 1U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 10, "looper(4) = 10")
    check(lmx_int_value_known(lmx_arena_ref_value(looper, 1U)) = 10, "looper cell acc")
    check(lmx_int_value_known(lmx_arena_ref_value(looper, 2U)) = 4, "looper cell i")

    # No body node: nothing to walk, nothing is invented, nothing native is called.
    st: go(bare, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_NOT_CALLABLE, "a callable without body nodes is NOT_CALLABLE (ready, nothing to walk)")
    st: go(unit, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_INVALID, "a Structure that is not a callable is refused")

    # Falling off the end is an exit: the dirty value is published, no result is written.
    r: -77
    st: go(faller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = -77 && v = 0, "void fall-off leaves the result alone and reports no value")
    check(lmx_int_value_known(lmx_arena_ref_value(faller, 1U)) = 7, "void fall-off published z")

    # A bare role record as a return still publishes what is dirty, and ends the body.
    st: go(stopper, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && lmx_int_value_known(lmx_arena_ref_value(stopper, 1U)) = 9, "bare return publishes and stops")

    # A node outside the slice is reported at entry, wherever it sits, and nothing of the
    # activation runs: the assignment before it is neither executed nor published.
    st: go(refuser, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_UNSUPPORTED, "an unprepared body with an unread role is UNSUPPORTED, not skipped")
    check(lmx_int_value_known(lmx_arena_ref_value(refuser, 1U)) = 0, "nothing ran before the refusal")

    # Entry keeps the own records in the lexical order of the fields, which is the order
    # of every checkpoint -- not the order in which the body mentions them.
    pf: @ frame
    lmx_scratch_mark(ps, pm)
    st: lmx_walk_enter(pf, gctx, orderer, 0, 0U)
    check(st = c.LMX_WALK_OK && pf\nowns = 3U, "orderer loads three own fields")
    if: st = c.LMX_WALK_OK && pf\nowns = 3U
        po: pf\owns
        check(po\from = lmx_arena_ref_cell(orderer, 1U), "first record is field a")
        po: pf\owns + 1U
        check(po\from = lmx_arena_ref_cell(orderer, 2U), "second record is field b")
        po: pf\owns + 2U
        check(po\from = lmx_arena_ref_cell(lmx_arena_ref_struct(lmx_arena_ref_struct(orderer, 4U), 2U), 0U), "third record is the loop body's field t")
    ---
    check(lmx_scratch_rewind(ps, pm) = c.LMX_SCRATCH_OK && ps\used = 0U && ps\top = 0U, "the store is empty again after the rewind")

    # The role is a physical reference: the right NUMBER in a record of one's own is not
    # the role, and such a step is refused rather than skipped or guessed.
    st: go(impostor, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_UNSUPPORTED, "a private op record with the number of `ret` is not the role `ret`")

    # An invocation is not a copy.  Twenty-one activations of summer neither allocate a
    # cell in the graph's arena nor change a byte of it; and once the store is warm they
    # add no block to the context's arena either, and leave the store empty.
    lmx_int_store_known(abox, 20)
    go(summer, argv, 1U, @ r, @ v)
    before: handed(ga)
    sum_before: digest(ga)
    blocks: lmx_arena_mark(pca)
    warm: lmx_pool_count(@ context_cells)
    i: 0
    while: i < 50
        st: go(summer, argv, 1U, @ r, @ v)
        i: i + 1
    ---
    check(st = c.LMX_WALK_OK && r = 210, "summer(20) = 210, fifty times")
    check(handed(ga) = before, "invocations allocate nothing in the graph's arena")
    check(digest(ga) = sum_before, "and write nothing into it")
    check(lmx_arena_mark(pca) = blocks && lmx_pool_count(@ context_cells) = warm, "and, once warm, nothing in the context's arena")
    check(ps\used = 0U && ps\top = 0U, "every activation rewound what it took")

    # The ONLY write of an activation is the publication of a dirty own value: counter
    # changes the graph, and putting n back restores it byte for byte.
    sum_before: digest(ga)
    before: handed(ga)
    r: lmx_int_value_known(cell)
    st: go(counter, 0, 0U, @ i, @ v)
    check(st = c.LMX_WALK_OK && digest(ga) != sum_before && handed(ga) = before, "counter wrote, and allocated nothing")
    lmx_int_store_known(cell, r)
    check(digest(ga) = sum_before, "undoing the one published value restores the whole graph")

    # An own field is a field of M or of a body inside M.  Somebody else's field named as
    # own is refused at entry; it is reachable only as an explicit field (`at` / `put`).
    st: go(stranger, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_UNSUPPORTED, "stranger could not be prepared, so it does not run")

    # F: data writes do not touch a plan.  counter, outer and publisher have all written
    # into own cells by now, and inner wrote into outer's field through an explicit path.
    info: (cast: (@: LmxCallable) lmx_arena_ref_value(outer, 0U))
    check(info\header != 0 && lmx_walk_plan_check(gctx, outer) = c.LMX_WALK_OK && lmx_walk_plan_check(gctx, counter) = c.LMX_WALK_OK, "after all those writes the plans still say what the bodies say")

    # ---- values are references: integer, nothing, Structure ---------------------------
    check(lmx_walk_prepare(gctx, ga, gplan_roles, peek) = c.LMX_WALK_OK && lmx_walk_prepare(gctx, ga, gplan_roles, bump) = c.LMX_WALK_OK && lmx_walk_prepare(gctx, ga, gplan_roles, relay) = c.LMX_WALK_OK, "peek, bump, relay prepared")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, echo) = c.LMX_WALK_OK && lmx_walk_prepare(gctx, ga, gplan_roles, hop) = c.LMX_WALK_OK && lmx_walk_prepare(gctx, ga, gplan_roles, self) = c.LMX_WALK_OK && lmx_walk_prepare(gctx, ga, gplan_roles, poke) = c.LMX_WALK_OK, "echo, hop, self, poke prepared")
    before: handed(ga)
    sum_before: digest(ga)
    argv[0]: (cast: (@: void) subject)
    # An integer the activation computed comes back in the caller's own destination cell:
    # the reference IS that cell, and that identity is how the caller knows.
    st: lmx_walk_run(gctx, bump, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\present = 1 && gv\ref = (cast: (@: void) (@ gv\number)) && gv\number = 8, "an integer computed from a field of the subject: 7 + 1, in the caller's cell")
    # A field of the subject comes back as the graph's own cell -- the same address.
    st: lmx_walk_run(gctx, peek, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\present = 1 && gv\ref = lmx_arena_ref_value(subject, 1U), "a field of a Structure input is returned BY REFERENCE: the very cell")
    check(gv\ref != (cast: (@: void) (@ gv\number)) && lmx_int_value_known(gv\ref) = 35, "not a computed integer, and it reads 35")
    # The subject itself, handed in and handed back: the same Structure, not a copy.
    st: lmx_walk_run(gctx, self, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\present = 1 && gv\ref = (cast: (@: void) subject), "a Structure input returned as it came: the same address")
    # Through a nested call: two frames down and back, still the same cell.
    st: lmx_walk_run(gctx, relay, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\ref = lmx_arena_ref_value(subject, 1U), "a reference handed through a nested call is the same reference")
    check(handed(ga) = before && digest(ga) = sum_before, "none of it allocated in the graph or wrote a byte of it: the subject was never copied")
    check(ps\used = 0U && ps\top = 0U, "and the store is empty again")
    # A temporary never outlives the frame that made it: k - 1 is a cell of hop's scratch
    # slice, echo returns that reference, hop must not let it out.
    argv[0]: abox
    lmx_int_store_known(abox, 41)
    st: lmx_walk_run(gctx, hop, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\present = 1 && gv\ref = (cast: (@: void) (@ gv\number)) && gv\number = 40, "a temporary passed down and returned comes out by value, in the caller's cell")
    st: go(summer, argv, 1U, @ r, @ v)
    check(gv\number = 861 && v = 1, "and the store was reused since: summer(41) = 861")
    # echo of an integer input that IS a cell of the graph: that cell, by reference.
    st: lmx_walk_run(gctx, echo, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\ref = abox, "an input that is a cell of the graph is returned as that cell")
    # No value: nothing is a value, and says so.
    st: lmx_walk_run(gctx, faller, 0, 0U, gv)
    check(st = c.LMX_WALK_OK && gv\present = 0 && gv\ref = 0, "a void activation: no reference, present = 0")
    argv[0]: 0
    st: lmx_walk_run(gctx, echo, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\present = 0 && gv\ref = 0, "an absent input returned is no value")
    check(lmx_walk_run(gctx, echo, argv, 1U, 0) = c.LMX_WALK_OK, "a caller that wants no value passes none")
    # ---- what is refused ----
    # A FOREIGN reference: an address no arena of this context can classify.  Nothing runs.
    foreign: calloc(1U, 64U)
    argv[0]: foreign
    st: lmx_walk_run(gctx, poke, argv, 1U, gv)
    check(st = c.LMX_WALK_INVALID && gv\present = 0 && lmx_int_value_known(lmx_arena_ref_value(poke, 1U)) = 0, "a reference outside every arena of the context is INVALID, and nothing ran")
    free(foreign)
    # A cell of ANOTHER arena -- the context's own store arena, never bound to the graph's.
    lmx_scratch_mark(ps, pm)
    lmx_scratch_take(ps, c.sizeof(@: void), @ foreign)
    argv[0]: foreign
    st: lmx_walk_run(gctx, poke, argv, 1U, gv)
    check(st = c.LMX_WALK_INVALID && lmx_int_value_known(lmx_arena_ref_value(poke, 1U)) = 0, "so is a cell of an arena the graph's arena is not bound to")
    lmx_scratch_rewind(ps, pm)
    # A reference that is NOT a Structure, read as one: `of` asks, and refuses.
    argv[0]: abox
    st: lmx_walk_run(gctx, peek, argv, 1U, gv)
    check(st = c.LMX_WALK_INVALID && gv\present = 0, "a field of something that is not a Structure is INVALID")
    argv[0]: (cast: (@: void) subject)
    st: lmx_walk_run(gctx, poke, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) subject) && lmx_int_value_known(lmx_arena_ref_value(poke, 1U)) = 1, "the same program with a good subject runs, and leaves its trace")
    argv[0]: abox

    # A COPY of M runs unchanged on its own state: the copier remaps the references of
    # the body along with the rest of M's tree, so the copy's nodes point at the copy;
    # child[0] and the role records are shared by address.
    before: handed(ga)
    st: lmx_graph_copy_owned(counter, 0, ga, ga, @ copy)
    check(st = c.LMX_GRAPH_COPY_OK && copy != 0 && copy != counter, "counter copied")
    check(handed(ga) > before, "an explicit copy DOES allocate in the graph's arena; an invocation never did")
    if: copy != 0
        check(lmx_arena_ref_value(copy, 0U) = lmx_arena_ref_value(counter, 0U), "copy shares child[0]")
        check(lmx_arena_ref_value(copy, 1U) != cell, "copy has its own n")
        check(lmx_arena_ref_value(lmx_arena_ref_struct(copy, 3U), 0U) = lmx_arena_ref_value(lmx_arena_ref_struct(counter, 3U), 0U), "copy shares the role records")
        check(lmx_arena_ref_struct(lmx_arena_ref_struct(lmx_arena_ref_struct(copy, 3U), 1U), 1U) = copy, "the copy's node refers to the copy, not to the original")
        r: -1
        st: go(copy, 0, 0U, @ r, @ v)
        check(st = c.LMX_WALK_OK && r = 3, "copy continues from the copied value")
        check(lmx_int_value_known(cell) = 2, "original n untouched by the copy's run")
        check(lmx_int_value_known(lmx_arena_ref_value(copy, 1U)) = 3, "copy published into its own n")
        # C: the copy was never prepared -- it shares the descriptor, hence the plan, and
        # the same positions resolve to ITS slots.
        info: (cast: (@: LmxCallable) lmx_arena_ref_value(counter, 0U))
        check(lmx_plan_slot_known(copy, info\header, 0U) = lmx_arena_ref_cell(copy, 1U) && lmx_plan_slot_known(copy, info\header, 0U) != lmx_plan_slot_known(counter, info\header, 0U), "one plan, two occurrences, two different slots")
        # E: changing the shape of ONE occurrence starts with a fresh descriptor in ITS
        # child[0].  That occurrence is unprepared; the other keeps running by the old plan.
        fresh: lmx_callable_new_owned(ga)
        check(fresh != 0 && lmx_arena_ref_store(copy, 0U, (cast: (@: void) fresh)) = 0, "a fresh descriptor for the copy only")
        st: go(copy, 0, 0U, @ r, @ v)
        check(st = c.LMX_WALK_UNSUPPORTED, "the copy is now unprepared")
        st: go(counter, 0, 0U, @ r, @ v)
        check(st = c.LMX_WALK_OK && r = 3 && info\header != 0, "the original runs on, its shared plan untouched")
        check(lmx_walk_prepare(gctx, ga, gplan_roles, copy) = c.LMX_WALK_OK && fresh\header != 0 && fresh\header != info\header, "the copy is prepared again, under its own descriptor")
        st: go(copy, 0, 0U, @ r, @ v)
        check(st = c.LMX_WALK_OK && r = 4, "and runs again")
    ---

    # ---- Stage C acceptance (GROKBOT-CALLABLE-INTERP-STAGEC-20260922-65) ----------
    check(lmx_walk_prepare(gctx, ga, gplan_roles, test) = c.LMX_WALK_OK, "test prepared")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, test2) = c.LMX_WALK_OK, "test2 prepared")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, test4) = c.LMX_WALK_OK, "test4 prepared")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, host) = c.LMX_WALK_OK, "host prepared")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, tracer) = c.LMX_WALK_OK, "tracer prepared")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, bare_stmt) = c.LMX_WALK_OK, "bare_stmt prepared")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, data_stmt) = c.LMX_WALK_OK, "data_stmt prepared")
    # test3 stays unprepared / header unset
    info: (cast: (@: LmxCallable) lmx_arena_ref_value(test3, 0U))
    check(info != 0 && info\header = 0, "test3 descriptor-only, header unset")
    st: go(test, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 1 && v = 1, "test: body return lit 1 => 1")
    argv[0]: (cast: (@: void) test)
    st: go(test2, argv, 1U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 1 && v = 1, "test2: RET of ARG nullary-invokes test => 1")
    st: go(test3, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_NOT_CALLABLE, "test3: descriptor-only CALL => NOT_CALLABLE")
    # test4 formal constrained to test3 shape; pass test (compatible occurrence)
    argv[0]: (cast: (@: void) test)
    st: go(test4, argv, 1U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 1 && v = 1, "test4: formal~test3, pass test => 1")
    # A call with no argument children is the empty argument list: P0 gives `host()`,
    # `host: ()` and the closed vertical form one tree with no fields (-127), so the walker
    # meets no container to unwrap (-133).
    tramp: mk_m(unit, 35U, 2U)
    n: fr(tramp, 1U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_CALL, 3U)
    ref(e, 1U, host)
    ref(e, 2U, host)
    check(lmx_walk_prepare(gctx, ga, gplan_roles, tramp) = c.LMX_WALK_OK, "tramp: host() prepared")
    st: go(tramp, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 7 && v = 1, "CALL host with no argument children => 7")
    # D-04: host() with one extra Structure argument is refused at entry (native refuses).
    tramp3: mk_m(unit, 40U, 2U)
    n: fr(tramp3, 1U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_CALL, 4U)
    ref(e, 1U, host)
    ref(e, 2U, host)
    if: pair != 0
        pair\parent: e
        check(lmx_arena_ref_store(e, 3U, (cast: (@: void) pair)) = 0, "pair under tramp3 CALL as extra arg")
    ---
    check(lmx_walk_prepare(gctx, ga, gplan_roles, tramp3) = c.LMX_WALK_INVALID, "D-04 host(extra Structure) refused at prepare")
    # D-03: bare callable in body executes (tracer own published), then return 9.
    st: go(bare_stmt, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 9 && v = 1, "D-03 bare callable statement then return => 9")
    check(lmx_int_value_known(lmx_arena_ref_value(tracer, 1U)) = 1, "D-03 bare callable statement published tracer")
    # D-03: plain Structure statement is explicit UNSUPPORTED (never silent OK).
    st: go(data_stmt, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_UNSUPPORTED, "D-03 plain Structure statement is UNSUPPORTED")
    # A plain Structure child of a call is ONE Structure argument (-133): test2(pair), pair =
    # (1 2) -- the graph of `test2(((1 2)))` after P0's one-level normalization -- reaches the
    # formal as that very Structure, as it does natively.  The CALL-only unwrap would have
    # made it two int arguments and returned the first.
    tramp2: mk_m(unit, 36U, 2U)
    n: fr(tramp2, 1U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_CALL, 4U)
    ref(e, 1U, test2)
    ref(e, 2U, test2)
    if: pair != 0
        pair\parent: e
        check(lmx_arena_ref_store(e, 3U, (cast: (@: void) pair)) = 0, "pair under tramp2 CALL")
    ---
    check(lmx_walk_prepare(gctx, ga, gplan_roles, tramp2) = c.LMX_WALK_OK, "tramp2(pair) prepared")
    st: lmx_walk_run(gctx, tramp2, 0, 0U, gv)
    check(st = c.LMX_WALK_OK && gv\present != 0 && gv\ref = (cast: (@: void) pair), "a sole Structure argument reaches the formal unchanged")
    check(pair != 0 && pair\len = 2 && lmx_int_value_known(lmx_arena_ref_value(pair, 0U)) = 1 && lmx_int_value_known(lmx_arena_ref_value(pair, 1U)) = 2, "the Structure argument keeps its two fields")


    # ---- G1: native descriptor via prim ABI (FABLE-158) --------------------------------
    # Prim-ABI callee behind LmxCallable.addr, called from walked op tree with one int
    # operand -> dest = 7. Mutant: addr!=0 refused (old never-METHOD.addr) -> RED.
    native7: mk_m(unit, 41U, 1U)
    native2: mk_m(unit, 42U, 1U)
    caller7: mk_m(unit, 43U, 2U)
    caller2: mk_m(unit, 44U, 2U)
    method7: lmx_method_new_owned(ga)
    method2: lmx_method_new_owned(ga)
    check(native7 != 0 && native2 != 0 && caller7 != 0 && caller2 != 0 && method7 != 0 && method2 != 0, "G1 fixtures")
    method7\addr: (cast: (LmxEntry) g1_seven)
    method7\sig: 0U
    method2\addr: (cast: (LmxEntry) g1_throw2)
    method2\sig: 0U
    info: (cast: (@: LmxCallable) lmx_arena_ref_value(native7, 0U))
    check(info != 0, "G1 native7 descriptor")
    info\method: method7
    info: (cast: (@: LmxCallable) lmx_arena_ref_value(native2, 0U))
    check(info != 0, "G1 native2 descriptor")
    info\method: method2
    # caller7: CALL native7(LIT 1) -- one int operand; trampoline writes 7
    n: fr(caller7, 1U, c.LMX_WALK_OP_CALL, 4U)
    ref(n, 1U, native7)
    ref(n, 2U, native7)
    lit(n, 3U, 1)
    check(lmx_walk_prepare(gctx, ga, gplan_roles, caller7) = c.LMX_WALK_OK, "G1 caller7 prepared (addr!=0 skips ARG arity)")
    st: go(caller7, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && v = 1 && r = 7, "G1 native addr!=0 CALL with one int -> dest 7 (mutant: addr!=0 refused)")
    # caller2: CALL native2() -- status 2 must reach walk as 2, not LMX_WALK_PRIMITIVE
    n: fr(caller2, 1U, c.LMX_WALK_OP_CALL, 3U)
    ref(n, 1U, native2)
    ref(n, 2U, native2)
    check(lmx_walk_prepare(gctx, ga, gplan_roles, caller2) = c.LMX_WALK_OK, "G1 caller2 prepared")
    st: go(caller2, 0, 0U, @ r, @ v)
    # D-37: throw k is LMX_WALK_THROWN + k (never bare 2 / NO_GRAPH). Mutant: status: said -> RED.
    check(st = c.LMX_WALK_THROWN + 2, "G1 METHOD throw encoded as THROWN+2 (D-37; mutant: bare 2 collides with NO_GRAPH)")
    check(st != c.LMX_WALK_PRIMITIVE, "G1 status distinct from LMX_WALK_PRIMITIVE (LmxCallable vs LmxPrimitive)")
    check(st != 2, "D-37: throw 2 must not equal bare walker status 2")


    # ---- G3: declarations among root fields (FABLE-158) --------------------------------
    # body {int cell, callable occurrence (addr=0, never run), OP literal 7} -> value 7;
    # occurrence body untouched (side-effect cell stays 0). Mutant: declared callable
    # activated -> RED.
    g3_body: mk_m(unit, 45U, 4U)
    check(g3_body != 0, "G3 body")
    icell(g3_body, 1U, 0)
    g3_decl: mk_m(g3_body, 2U, 3U)
    check(g3_decl != 0 && g3_decl\parent = g3_body, "G3 declared callable parent is body")
    icell(g3_decl, 1U, 0)
    n: fr(g3_decl, 2U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, g3_decl, 1U)
    lit(n, 2U, 1)
    n: fr(g3_body, 3U, c.LMX_WALK_OP_LIT, 2U)
    check(lmx_walk_store_int(ga, n, 1U, 7) = c.LMX_WALK_OK, "G3 LIT 7")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, g3_body) = c.LMX_WALK_OK, "G3 body prepared")
    # Prepare the declared callable so a mutant activation would run its SET.
    check(lmx_walk_prepare(gctx, ga, gplan_roles, g3_decl) = c.LMX_WALK_OK, "G3 decl prepared (must not run)")
    st: go(g3_body, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && v = 1 && r = 7, "G3 body {cell, decl callable, LIT 7} -> 7")
    check(lmx_int_value_known(lmx_arena_ref_value(g3_decl, 1U)) = 0, "G3 declared callable not activated (mutant: activated)")

    # ---- D-45 (F3): eternal branch (parent 0) among root fields ---------------------
    # body {Structure with parent 0, OP literal 7} -> 7. Mutant (skip only parent=body)
    # -> LMX_WALK_UNSUPPORTED RED.
    d45_body: mk_m(unit, 46U, 3U)
    check(d45_body != 0, "D-45 body")
    d45_eternal: pl(d45_body, 1U, 1U)
    check(d45_eternal != 0, "D-45 eternal field")
    d45_eternal\parent: 0
    check(d45_eternal\parent = 0, "D-45 eternal parent is 0")
    n: fr(d45_body, 2U, c.LMX_WALK_OP_LIT, 2U)
    check(lmx_walk_store_int(ga, n, 1U, 7) = c.LMX_WALK_OK, "D-45 LIT 7")
    check(lmx_walk_prepare(gctx, ga, gplan_roles, d45_body) = c.LMX_WALK_OK, "D-45 body prepared")
    st: go(d45_body, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && v = 1 && r = 7, "D-45 body {eternal parent0, LIT 7} -> 7 (mutant: UNSUPPORTED)")

    free((cast: (@: void) argv))
    free((cast: (@: void) gv))
    free((cast: (@: void) flat))
    free((cast: (@: void) lens))
    free((cast: (@: void) paths))
    if: failures != 0
        c.printf("lmx_walk: %d failed of %d\n", failures, checks)
        return: 1
    ---
    c.printf("lmx_walk: %d checks\n", checks)
return: 0
