predef: "l2src/lmx_root.lm1"
predef: "l2src/lmx_array_grow_owned.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

size_t: dr_calls 0U
@: LmxThread dr_seen 0

fn: dr_body (@: Lmx node) int
    @: LmxMsg message
    dr_calls: dr_calls + 1U
    dr_seen: lmx_thread_current()
    message: lmx_thread_message(dr_seen)
    if: message != 0
        message\success: 1
    ---
return: 0

sub: dr_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: dr_check

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxRoot: root
    LmxArena: donor_arena
    LmxArena: child_arena
    @: Lmx donor_graph
    @: Lmx child_graph
    @: LmxArrayDesc donor_children
    @: LmxMsg donor_message
    @: LmxMsg child_message
    @: LmxPost donor_mail
    @: LmxPost child_mail
    @: LmxThread donor
    @: LmxThread child
    @: LmxSchedule donor_slot
    @: LmxSchedule child_slot
    @: LmxPool methods
    @: LmxMethod method
    int: failures
    if: counts = 0
        return: 2
    ---
    memset((cast: (@: void) (@ root)), 0, c.sizeof(c.LmxRoot))
    memset((cast: (@: void) (@ donor_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ child_arena)), 0, c.sizeof(c.LmxArena))
    dr_check(counts, lmx_root_open(@ root, 0, 5000U) = c.LMX_ROOT_OK, "root open")
    dr_check(counts, lmx_arena_open(@ donor_arena) = 0 && lmx_arena_open(@ child_arena) = 0, "arenas open")
    donor_graph: lmx_node_new_owned(@ donor_arena)
    donor_children: lmx_array_grow_ref_new_owned(c.LMX_TYPE_ARRAY_OF_POINTER_BASE + c.LMX_DOMAIN_THREAD, @ donor_arena)
    child_graph: lmx_node_new_owned(@ child_arena)
    methods: lmx_pool_make(@ child_arena, 2U * c.sizeof(c.LmxMethod), c.sizeof(c.LmxMethod), c.LMX_KIND_METHOD, c.LMX_TYPE_METHOD)
    method: lmx_method_intern(@ child_arena, methods, (cast: (LmxEntry) dr_body), 1U)
    dr_check(counts, donor_graph != 0 && donor_children != 0 && child_graph != 0 && method != 0, "graph values")
    dr_check(counts, lmx_arena_refs_open_owned(@ donor_arena, donor_graph, 1U) = 0 && lmx_arena_ref_store(donor_graph, 0U, (cast: (@: void) donor_children)) = 0, "donor graph")
    dr_check(counts, lmx_arena_refs_open_owned(@ child_arena, child_graph, 1U) = 0 && lmx_arena_ref_store(child_graph, 0U, (cast: (@: void) method)) = 0, "child callable")
    donor_mail: (cast: (@: LmxPost) lmx_arena_take(@ donor_arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    donor: (cast: (@: LmxThread) lmx_arena_take(@ donor_arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD))
    donor_message: (cast: (@: LmxMsg) donor)
    donor_slot: (cast: (@: LmxSchedule) lmx_arena_take(@ donor_arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    child_mail: (cast: (@: LmxPost) lmx_arena_take(@ child_arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    child: (cast: (@: LmxThread) lmx_arena_take(@ child_arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD))
    child_message: (cast: (@: LmxMsg) child)
    child_slot: (cast: (@: LmxSchedule) lmx_arena_take(@ child_arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    dr_check(counts, lmx_post_init(@ donor_arena, donor_mail) = c.LMX_POST_OK && lmx_post_init(@ child_arena, child_mail) = c.LMX_POST_OK, "mail init")
    dr_check(counts, lmx_thread_init(@ donor_arena, donor, donor_graph, donor_mail, donor_slot) = c.LMX_THREAD_OK && lmx_schedule_init(donor_slot, @ donor_arena, (cast: (@: void) donor), 1000U) = c.LMX_SCHEDULE_OK && lmx_thread_children_bind(donor, donor_children, @ donor_arena) = c.LMX_THREAD_OK, "donor init")
    dr_check(counts, lmx_thread_init(@ child_arena, child, child_graph, child_mail, child_slot) = c.LMX_THREAD_OK && lmx_schedule_init(child_slot, @ child_arena, (cast: (@: void) child), 1000U) = c.LMX_SCHEDULE_OK, "child init")
    dr_check(counts, lmx_thread_child_add(donor, child, @ donor_arena) = c.LMX_THREAD_OK, "donor membership")
    dr_check(counts, lmx_root_orphan_adopt(@ root, child_message, @ child_arena, child, lmx_root_clock(@ root)) = c.LMX_ORPHAN_OK, "adopt")
    dr_check(counts, lmx_manager_round(lmx_root_manager(@ root), 1U, lmx_root_clock(@ root)) = c.LMX_MANAGER_OK, "array scheduler round")
    dr_check(counts, dr_calls = 1U && dr_seen = child && child_message\success != 0 && child_message\handoff_ready != 0, "orphan body boundary")
    dr_check(counts, lmx_thread_child_is(lmx_root_thread(@ root), child) != 0, "child remained until maintenance")
    dr_check(counts, lmx_root_orphan_maintain(@ root, lmx_root_clock(@ root)) = c.LMX_ORPHAN_OK, "maintain")
    dr_check(counts, lmx_thread_child_count(lmx_root_thread(@ root)) = 0U, "maintenance removed then released")
    dr_check(counts, lmx_arena_release(@ donor_arena) = 0 && lmx_root_close(@ root) = c.LMX_ROOT_OK, "close")
    failures: counts[1]
    c.printf("lmx_orphan_drain: %d checks, %d failures\n", counts[0], failures)
    free(counts)
return: failures
