# Original: l2src/l2trans.lm1:10507
fn: lm_compiler_scan_node_value (const: (@: source_node c.LmP0Node); @: value c.L2ValueSpan; int: mi; @: seen int) int
    const: (@@: src_cell char (cast: (const: @@: char) (@ c.l2_src)))
    @: hr_on_cell int (cast: (@: int) (@ c.l2_hr_on))
    @: e_cell int (cast: (@: int) (@ c.l2_e))
    c.L2ValueSpan: prepared_address
    @: values c.L2ValueSpan 0
    int: value_n 0
    @: f c.LmP0Field
    int: n
    int: oi
    int: span
    int: status
    c.lm_compiler_here_at_method(mi, source_node)
    if: value != 0
        values: c.lm_compiler_primary_values(value, @ value_n)
        if: value_n < 0
            return: (cast: (int) (c.lm_compiler_error_fatal(src_cell[0], source_node, "internal: a primary lost its prepared fields")))
        ---
    ---
    if: source_node = 0
        return: (cast: (int) (0))
    if: source_node\kind = c.LM_P0_NODE_ATOM
        status: lm_compiler_scan_ident(mi, (cast: (const: @: c.LmP0Text) (source_node\as\atom)), seen)
        if: status != 0 || hr_on_cell[0] != 0
            return: (cast: (int) (status))
        return: (cast: (int) (lm_compiler_root_use_note(source_node, mi)))
    if: source_node\kind = c.LM_P0_NODE_STRUCTURE && source_node\as != 0 && source_node\as\structure != 0
        if: value != 0
            return: (cast: (int) (lm_compiler_scan_value_list(values, value_n, mi, seen, 0)))
        f: source_node\as\structure\first_field
        n: c.lm_compiler_count_active((cast: (const: @: c.LmP0Structure) (source_node\as\structure)))
        return: (cast: (int) (lm_compiler_scan_fields(f, n, mi, seen)))
    # A sizeof type operand is type syntax even if its resolution will fail.
    # It cannot introduce a hidden value input; ordinary sizeof(name) can.
    if: value != 0
        if: c.lm_compiler_primary_sizeof_type(value) != 0
            return: (cast: (int) (0))
        ---
    else:
        if: lm_compiler_sizeof_is_type(source_node) != 0
            return: (cast: (int) (0))
        ---
    ---
    # A raw address entry prepares one ordinary expression list. The same
    # lexical address role below consumes retained children at any depth.
    if: source_node\kind = c.LM_P0_NODE_FRAME && c.lm_compiler_frame_head(source_node, "@") && source_node\as\frame\body != 0 && c.lm_compiler_count_active((cast: (const: @: c.LmP0Structure) (source_node\as\frame\body))) > 0
        if: value != 0
            return: (cast: (int) (lm_compiler_scan_value_list(values, value_n, mi, seen, 1)))
        if: c.lm_compiler_value_expression_prepare((cast: (@: c.LmP0Field) (source_node\as\frame\body\first_field)), (cast: (int) (c.lm_compiler_count_active((cast: (const: @: c.LmP0Structure) (source_node\as\frame\body))))), @ prepared_address) != 0
            return: (cast: (int) (1))
        status: lm_compiler_scan_value_span(@ prepared_address, mi, seen, 1)
        c.lm_compiler_value_span_release(@ prepared_address)
        return: (cast: (int) (status))
    # implements(candidate, required, consumer) is decided at translation from
    # declarations; its head and operands are not lexical references either.
    if: source_node\kind = c.LM_P0_NODE_FRAME && c.lm_compiler_frame_head(source_node, "implements")
        return: (cast: (int) (0))
    # A cast contributes only its operand to lexical free-name analysis. The
    # head and its first field name a language operation and a C type.
    if: source_node\kind = c.LM_P0_NODE_FRAME && c.lm_compiler_frame_head(source_node, "cast") && source_node\as\frame\body != 0 && c.lm_compiler_count_active((cast: (const: @: c.LmP0Structure) (source_node\as\frame\body))) >= 2
        if: value != 0
            return: (cast: (int) (lm_compiler_scan_value_list(values + 1, value_n - 1, mi, seen, 0)))
        f: c.lm_compiler_next_active((cast: (@: c.LmP0Field) (source_node\as\frame\body\first_field)))
        f: c.lm_compiler_next_active((cast: (@: c.LmP0Field) (f\next)))
