# Numeric conveniences use the selected scalar arithmetic/comparison profile.
# Numeric values travel as ordinary type/value records, never as int payloads
# disguised as pointers. Reduction uses the common Expression, with one shared extremum loop.
# Default sum/product seeds are int zero/one; supply the profile's own record
# when a different neutral value or non-default numeric context is required.

# Explicit copy opens the caller's ready sequence into the common Expression
# argument stream. Empty arrays still contribute the neutral initial value.
FxSum:
    private:
        @: items
        @: initial (0 record)
    return: @
    sum:
        throws: FxRecordArity
        return: ((+ \initial copy(items)) record)

FxProduct:
    private:
        @: items
        @: initial (1 record)
    return: @
    product:
        throws: FxRecordArity
        return: ((* \initial copy(items)) record)

FxNumericExtreme:
    private:
        @: items
        int: greatest
    return: @
    find:
        throws: copy(FxThrows\sequence) FxRecordArity
        FxSeqInfo\get(items)
        if: length(items) = 0
            throw: SequenceSize()
        private: @: value FxSeqRead\read(items; 0)
        private: int: at 0
        private: int: i 1
        while: i < length(items)
            private: @: candidate FxSeqRead\read(items; i)
            private: @: selected FxNumericPair\choose(value; candidate; greatest)
            if: selected != value
                value := selected
                at := i
            i += 1
        return: FxTwo\make(value; (at record))

FxMinimum:
    private: @: items
    return: @
    minimum:
        throws: copy(FxThrows\sequence) FxRecordArity
        private: @: result FxNumericExtreme\find(items; 0)
        return: result[0]

FxMaximum:
    private: @: items
    return: @
    maximum:
        throws: copy(FxThrows\sequence) FxRecordArity
        private: @: result FxNumericExtreme\find(items; 1)
        return: result[0]

FxArgMin:
    private: @: items
    return: int
    argMin:
        throws: copy(FxThrows\sequence) FxRecordArity
        private: @: result FxNumericExtreme\find(items; 0)
        return: \result[1]

FxArgMax:
    private: @: items
    return: int
    argMax:
        throws: copy(FxThrows\sequence) FxRecordArity
        private: @: result FxNumericExtreme\find(items; 1)
        return: \result[1]

FxExtrema:
    private: @: items
    return: @
    extrema:
        throws: copy(FxThrows\sequence) FxRecordArity
        return: FxTwo\make(FxMinimum\minimum(items); FxMaximum\maximum(items))

FxNumericPair:
    private:
        @: first
        @: second
        int: greatest
    return: @
    choose:
        private: int: order (\second > \first) - (\second < \first)
        if: (greatest = 0 && order < 0) || (greatest != 0 && order > 0)
            return: second
        return: first

FxMin:
    private:
        @: first
        @: second
    return: @
    min:
        return: FxNumericPair\choose(first; second; 0)

FxMax:
    private:
        @: first
        @: second
    return: @
    max:
        return: FxNumericPair\choose(first; second; 1)

FxMinMax:
    private:
        @: first
        @: second
    return: @
    minMax:
        if: \second < \first
            return: FxTwo\make(second; first)
        return: FxTwo\make(first; second)

FxClamp:
    private:
        @: value
        @: lower
        @: upper
    return: @
    clamp:
        throws: NumericDomain
        if: \upper < \lower
            throw: NumericDomain()
        return: FxMin\min(FxMax\max(value; lower); upper)

FxSign:
    private: @: value
    return: int
    sign:
        return: (\value > 0) - (\value < 0)

# Exact integer helpers select bigint explicitly, avoiding MIN_INT negation
# and intermediate machine overflow. Machine narrowing is a caller conversion.
FxGcd:
    private:
        bigint: first
        bigint: second
    return: bigint
    gcd:
        if: first < 0
            first := -first
        if: second < 0
            second := -second
        while: second != 0
            private: bigint: rest first % second
            first := second
            second := rest
        return: first

FxLcm:
    private:
        bigint: first
        bigint: second
    return: bigint
    lcm:
        if: first = 0 || second = 0
            return: 0
        private: bigint: result (first / FxGcd\gcd(first; second)) * second
        if: result < 0
            result := -result
        return: result

# Floor quotient, unlike the target C99 truncating division for negative input.
FxDivMod:
    private:
        bigint: dividend
        bigint: divisor
    return: @
    divMod:
        throws: NumericDomain
        if: divisor = 0
            throw: NumericDomain()
        private: bigint: quotient dividend / divisor
        private: bigint: remainder dividend % divisor
        if: remainder != 0 && ((remainder < 0) != (divisor < 0))
            quotient -= 1
            remainder += divisor
        return: (quotient; remainder)
