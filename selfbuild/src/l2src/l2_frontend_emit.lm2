fn: lm_compiler_t7_from_return (int: mi; const: (@: source_node c.LmP0Node); const: (@: path char)) int
    return: (cast: (int) (lm_compiler_t7_fill(source_node, mi, 1, 0 - 1, path)))
end: lm_compiler_t7_from_return

