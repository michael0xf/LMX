# Walked twin. One-level dedents close by themselves. --- jumps out of the inner if and the else.
fn: nop () int
    return: 0
fn: read_while () int
    int: k 0
    int: answer 64
    if: 0
        int: unused 1
    else:
        while: k < 1
            int: hosted 21
            k: k + 1
        nop()
        if: while\hosted = 21
            answer: 7
    ---
    return: answer
int: r 0
r: read_while()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
