# R6-2 (4): a number is no reference -- the assignment `@: Model p 5` would make is refused where it stands (the typed null
# is the literal 0 alone).
Model:
    int: v 11
end: Model
Holder:
    @: Model p 5
end: Holder
h: merge: Holder
h
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
