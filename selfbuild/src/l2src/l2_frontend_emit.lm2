        return: (cast: (int) (1))
    if: library_mode_cell[0] != 0 && (c.fputs("    end: ", out_cell[0]) < 0 || c.fputs(construct_name_cell[0], out_cell[0]) < 0 || c.fputs("\nend: external\n", out_cell[0]) < 0)
