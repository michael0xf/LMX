InlineChain:
    return: @
    run:
        throws: copy(`+`\throws)
        int: a 1
        int: b 2
        int: d 4
        return: a + b + [10 20] + d

InlineMatrixChain:
    return: @
    run:
        throws: copy(`[+]`\throws)
        [1][2]int: arr0 [1 2]
        [1][2]int: arr1 [10 20]
        return: arr0 [+] arr1 [+] ([1][2]int: [100 200])
