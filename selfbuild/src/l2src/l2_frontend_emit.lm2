# One directive producer for a real source-unit body. Main and parts visit
# it in argv order before method classification; relative predef imports use
# that unit's actual source path. No directive becomes a runtime statement.
fn: lm_compiler_source_directives (const: (@: unit c.LmP0Structure); const: (@: path char); int: main_source) int
    @: field c.LmP0Field
    @: item c.LmP0Node
    int: os_count 0
    if: unit = 0
        return: 0
    field: c.lm_compiler_next_active((cast: (@: c.LmP0Field) unit\first_field))
    while: field != 0
        item: field\value
        if: c.lm_compiler_text_eq(c.lm_compiler_app_head(item), "predef") != 0 && c.lm_compiler_take_predef(item, path) != 0
            return: 1
        if: c.lm_compiler_text_eq(c.lm_compiler_app_head(item), "define") != 0 && c.lm_compiler_take_define(item, path) != 0
            return: 1
        if: c.lm_compiler_text_eq(c.lm_compiler_app_head(item), "include") != 0 && c.lm_compiler_take_include(item, path) != 0
            return: 1
        # profile remains an existing main-source option, not a new part
        # directive. Unsupported part options retain part_refused below.
        if: main_source != 0 && c.lm_compiler_text_eq(c.lm_compiler_app_head(item), "profile") != 0 && c.lm_compiler_take_profile(item, path) != 0
            return: 1
        if: c.lm_compiler_text_eq(c.lm_compiler_app_head(item), "os") != 0
            os_count: os_count + 1
            if: os_count > 1
                return: c.lm_compiler_error(path, item, "a second os block is not supported yet (a source unit reads one os block)")
            if: c.lm_compiler_os_directives(item, path) != 0
                return: 1
        ---
        field: c.lm_compiler_next_active((cast: (@: c.LmP0Field) field\next))
    ---
    return: 0
end: lm_compiler_source_directives

