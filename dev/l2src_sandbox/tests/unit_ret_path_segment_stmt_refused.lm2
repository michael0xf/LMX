# unit_ret_path_segment_refused as a statement `return:` inside a body (not the method's trailer): the same whole-path
# check, the same refusal where the path stands.
Box:
    int: v 0
end: Box
fn: peek () int
    Box: b
    if: 1 = 1
        return: b\q
    return: 0
end: peek
int: r 0
r: peek()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
