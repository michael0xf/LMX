---
    Observed:
        int: first 4
        int: second 9
        int: cell 14
    end: Observed
---
@: shared (data [] 0)
fn: outer () int (
    int: total 4
)
    sub: inner ()
        :=: (node \ total) (total + 5)
    end: inner
    inner:
    return: total
end: outer
int: first (outer)
int: second (outer)
int: cell ((outer \ data) \ total)
sub: main ()
    :=: ((shared \ Observed) \ first) first
    :=: ((shared \ Observed) \ second) second
    :=: ((shared \ Observed) \ cell) cell
end: main
main:
