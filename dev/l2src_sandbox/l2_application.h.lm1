predef: "l1src/p0.h.lm1"

# Translation-owned contracts. These records are not runtime graph objects.
# A constructor has one ordinary operand contract; no Array rank/depth table.
struct: L2TypeContract
    int: kind
    int: depth
    @: LmP0Text word
    @: L2TypeContract operand
    @: L2TypeContract allocated_next
end: L2TypeContract

# A receiver may derive this contract from an application. Name visibility is
# resolved at the source position, never cached from allocated storage.
struct: L2Declaration
    @: LmP0Node source
    @: L2TypeContract contract
    @: LmP0Text name
    @: LmP0Field candidate
    int: candidate_count
    # An explicit type/value receiver nested in a repeated reference write
    # validates its value before the original place contract does.
    @: L2TypeContract asserted_contract
    @: LmP0Text extent
    # Translator-only atom view of the receiving name. Candidate-free carry
    # reads the prior binding by name, independent of receiver spelling.
    LmP0NodeAs: carry_as
    LmP0Node: carry_node
    LmP0Field: carry_field
    @: L2Declaration allocated_next
end: L2Declaration

# A later source operation may write an already declared field. This is a
# translator-only association: the runtime graph retains the source operation,
# while the field still has exactly one physical cell.
struct: L2OwnReuse
    @: LmP0Node source
    int: method
    int: own
    @: L2OwnReuse allocated_next
end: L2OwnReuse

# A field projected from either existing named or composed compiler metadata.
# This record has no runtime representation and contains no binding identity.
struct: L2SchemaField
    @: LmP0Text name
    @: LmP0Text type_word
    int: kind
    int: model
    # A reference's declared structural pointee, independent of model's
    # machine pointer ABI and of the current/null cell value. Source-owned
    # declaration metadata resolves this once; sealed consumers only read it.
    int: pointee
end: L2SchemaField

# Translation-only resolved correspondence. The physical field and its two
# contracts survive the source planning fixed point. No runtime permission
# or guessed constructor is represented by one of these records.
struct: L2D105Step
    L2SchemaField: requirement
    L2SchemaField: actual
    int: selector
    int: physical
    int: slot
    int: status
    int: child_pair
end: L2D105Step

struct: L2D105StepDynamicArray
    size_t: size
    size_t: capacity
    @: L2D105Step data
end: L2D105StepDynamicArray

struct: L2D105Plan
    int: candidate
    int: requirement
    int: width
    int: physical_width
    int: source_width
    int: ready
    L2D105StepDynamicArray: steps
    @: L2D105Plan next
end: L2D105Plan

# One operation's reachable PAIRS, not another source/value graph. Rows
# borrow the already resolved typed plans. Both backend representations
# consume this same closure; no backend selects child models by name.
struct: L2D105CatalogRow
    @: L2D105Plan plan
    @: L2D105CatalogRow next
end: L2D105CatalogRow

struct: L2D105Catalog
    size_t: count
    size_t: extent
    int: ready
    @: L2D105CatalogRow first
    @: L2D105CatalogRow last
    # Declared requirement closure also includes equal-layout references.
    # These rows borrow identity plans, not candidate-layout evidence.
    @: L2D105CatalogRow required_first
    @: L2D105CatalogRow required_last
    size_t: reference_count
end: L2D105Catalog

# Translation-only source projection, made before candidate evaluation. schema
# names complete candidate metadata, not the required receiving model. layout
# is absent unless a real descriptor producer establishes that schema. A held
# own/input/result uses the existing D105 source place. Tagged schema handles
# are decoded only by the shared schema helpers; -1 alone means absent. A handle
# at or below -1500000000 is one method occurrence's own fields, not a merge tag.
struct: L2ReferenceSource
    int: schema
    int: layout
    int: method
    int: place
    # Identity of the CURRENT source operand run, independent of the helper
    # that last changed the diagnostic/visibility cursor. Compiler-only;
    # neither a source graph copy nor runtime provenance is stored here.
    const: @: LmP0Node origin
    int: origin_count
    int: origin_method
    # Borrow the existing current resolver fact, never a temporary path or
    # an ancestor verdict. The fact's bound allocation lives to translation
    # close and retains the whole selected namespace/contract route.
    # A whole binding may borrow its zero-step source_use2 fact here too;
    # that fact remains stage0 and is never an empty field-path proof.
    const: @: L2PathFact path
end: L2ReferenceSource

# One translation-owned source verdict,embedded in the existing grammar
# owner. Borrowed spans/arguments share it,not a copied mutable cache flag.
# Nothing here becomes a program graph field or runtime binding record.
struct: L2ValueSource
    L2ReferenceSource: result
    # 0 not queried,1 complete(including unknown),-1 failed.
    int: status
    int: method
    size_t: revision
    size_t: source_revision
    int: signature
    int: held
    int: bound
end: L2ValueSource

# The text the emitter builds (FIXED-BLOCKS-AUDIT, the expression text): `data` holds `len` bytes and a NUL in
# `cap` bytes -- its owner's buffer while that suffices, then storage of the translation (l2trans.lm1, l2_tx_*).
struct: L2Tx
    @: char data
    size_t: len
    size_t: cap
end: L2Tx

# A bounded source operand view. All source pointers are borrowed; no AST or
# runtime graph is copied. The index is either a literal, an existing joined
# own-name projection, or the original P0 index expression.
# One borrowed operand or operator in a bounded expression. No joined text or
# replacement P0 node is retained: consumers resolve the original source span.
struct: L2ValueSpan
    @: LmP0Field first
    int: count
    @: LmP0Node node
    # Expression-owned preparation. Borrowed span copies retain these
    # pointers but never release them independently. One recursive release
    # of the root token list owns the grammar and prefix operand.
    @: L2Path prepared
    @: L2ValueSpan operand
    # An embedded value expression owns its ordinary operand list,too.
    # Direct CHECK/type/native/retained expression consumers borrow it.
    # Receiving/conversion call plans remain a separate migration debt.
    @: L2ValueSpan values
    int: value_n
    # A general primary keeps its complete written body without making it
    # a numeric expression. The head's contract selects its roles later.
    @: L2PrimaryBody primary
    # 0 borrowed/unprepared,1 held path grammar,2 authoritative primary,
    # 3 owned expression-list view (e.g.an INDEX operand). Its first node
    # does not turn the entire expression into that node's unary role.
    int: grammar
end: L2ValueSpan

struct: L2PrimaryBody
    @: LmP0Node source
    @: L2ValueSpan body
    int: body_n
    # A container's own trailer is distinct from the Frame's trailer.
    # Anonymous Structures and Frame bodies retain it without inventing
    # another P0 node or suppressing its fields after a head-role choice.
    @: L2ValueSpan body_trailer
    int: body_trailer_n
    @: L2ValueSpan trailer
    int: trailer_n
    L2ValueSource: source_value
end: L2PrimaryBody

# A formal-ordered borrowing projection of one written actual. The value
# keeps the already owned grammar and nested path verdicts; the record owns
# no P0 fields and no value children. written selects lexical evaluation
# order,independent of formal coordinate. structured keeps a named body
# which is not one expression as its written structural value.
struct: L2ApplicationActual
    L2ValueSpan: value
    @: L2ValueSpan written
    @: LmP0Node wrapper
    int: rank
    int: structured
end: L2ApplicationActual

# This short-lived semantic projection borrows its complete source owner.
# Releasing it frees only actuals,never the owner's recursive grammar.
struct: L2ApplicationActuals
    @: L2ApplicationActual actuals
    int: count
    int: written_count
end: L2ApplicationActuals

# Persistent translation owner for one source occurrence in one method's
# namespace. Descendant call sites own grammar copies,not borrowed pointers
# into path INDEX lists which a semantic view can replace. All copies use
# the ordinary grammar clone;no site reparses after a held failure.
struct: L2ApplicationSite
    const: @: LmP0Node source
    # -1 owns grammar before a method namespace exists. It never stands
    # in for a resolved method or supplies a semantic binding fallback.
    int: method
    L2ValueSpan: value
    L2ApplicationActuals: arguments
    int: signature
    int: held
    int: bound
    @: L2ApplicationSite allocated_next
end: L2ApplicationSite

# Compiler-only receiving result. The expression and its complete path
# verdicts stay with their ordinary owner; all projections borrow them.
# converter selects a signature/current occurrence,not a frozen code value.
struct: L2NumericReceive
    @: L2ValueSpan value
    @: LmP0Node literal
    int: kind
    int: source_ft
    int: target_ft
    int: converter
end: L2NumericReceive

# One transient decision for a written `call:` operand. The current supported
# static route is recorded without claiming that it proves a mutable binding's
# future body; that provenance remains an M2 gate. `ni` selects the procedure
# and hidden-input contract; `target_ns` selects a unit slot, or `oi` an own
# place. A compatible layout or field type alone is not body identity. No
# source text is joined and this record is never part of a runtime Lmx graph.
struct: L2StructCallPlan
    L2ValueSpan: operand
    # N4 (LMX_semantics.ru.md #method-parts): the data operand of `call: code data` (count 0 for the one-operand
    # call), the operand shape l2_struct_call_operands gives, and the field a refused shape names.
    L2ValueSpan: data
    int: shape
    @: LmP0Field extra
    # The executable body and the place holding the current value are
    # independent. A named unit slot may later hold another body.
    int: ni
    int: target_ns
    int: oi
    int: result
    int: inert
end: L2StructCallPlan

# A CHECK-time source-site certificate for a written call. It is translator
# metadata, not a runtime graph field: body selects the executable occurrence,
# while target_ns/oi select the physical slot whose current value is called.
struct: L2CallBodySite
    @: LmP0Node source
    int: method
    int: body
    int: target_ns
    int: oi
    int: inert
    # N4 `call: code data`: split is 1 and data_node is the data operand. data_place is its analysis place
    # (l2_m2_root_own), data_target_ns or data_oi the unit slot or own place holding it, and data_layout the named
    # Structure whose layout it keeps (l2_m2_fixed). prow is the place row the kind-9 check reserves, and can_fail is
    # 1 when that row can refuse the call at run time.
    int: split
    @: LmP0Node data_node
    int: data_place
    int: data_target_ns
    int: data_oi
    int: data_layout
    int: prow
    int: can_fail
end: L2CallBodySite

# One step of a resolved written path (the author, 2026-10-18: one general algorithm for every path -- the check,
# native emission and the walker, references and indices included).  The resolver (l2_path_resolve) records the
# semantic coordinates of the field a segment selects in the host the previous step reached; a backend derives the
# physical address from them (l2_nsf_slot, l2_graph_field_child, the graph places) and never chooses a field, a
# type or an admission map again.  Translation-only; no runtime representation.
struct: L2PathStep
    # 1 a field of a Structure (row: its NSF row); 2 a slot of a merge result (row: the slot, nsrow: the contributing
    # NSF row or -1); 3 an own-declared field of a method, a control body or a part (own); 4 a control body (row: the
    # body index); 5 a part of a four-part fn (row: the part, ent: the method); 6 a field of the lexical space `node`
    # names (row: its ordinal there; own or ns the selected declaration, formal the host formal's index)
    int: locus
    # the selected field's value kind as the segment resolvers give it (0 size_t, 1 char, 2 nested Structure,
    # 3 Structure reference, 4 callable, 5/6 Array, 7 int, 8 unsigned, 9 ulong, 10 reference field, 11); 2 for a
    # body, 12 for a part
    int: kind
    int: row
    int: nsrow
    int: own
    int: ns
    int: formal
    # locus 6: the host method and the scope the selected declaration was read in (l2_node_seg_resolve), for the
    # backend's projection of its slot (l2_source_field_project, a host formal's l2_madc_formal_slot)
    int: node_host
    @: LmP0Node node_scope
    # the segment resolver's ent: the Structure of kind 2/3, the method of kind 4/12, the pointer code of kind 10
    int: ent
    # kind 10 continued: the pointee the next segment is resolved in (a schema handle), else -1
    int: pointee
    # the host the segment was resolved in -- the Structure, the merge result, the method's own level, the control
    # body, the part scope -- as the walk had them before this step
    int: host_ns
    int: host_res
    int: host_bm
    int: host_bh
    int: host_part
    # the admission map in force when this step is read (D-105): a schema handle or -1; the context of the receiving
    # model (l2_reference_model_context; -2 for the map a host formal named after `node` carries)
    int: view_model
    int: model_context
    # The prepared step whose declaration supplied the current contract;
    # -1 is the selected root. Indexing carries that origin, not the parent
    # of the candidate element. Translation metadata, never a graph field.
    int: model_step
    # The selected source host's args child is the outgoing requirement.
    # -1 denotes no header anchor. The current lexical context's parent is
    # that actual host code, also when this context was copied by a factory.
    int: model_input
    # kind 10: the pointer code of the reference cell (POINTER_BASE + code is its storage type)
    int: cell_ft
    # A typed machine INDEX's exact address contract BEFORE the step,
    # including C qualification. -1 means no machine-address verdict.
    # Its value after the step remains elem_ty. Compiler metadata only.
    int: address_ft
    # Write qualification of that selected machine cell. Obtaining a
    # qualified address remains legal; this is not graph eternity.
    int: cell_const
    # an occurrence selector `[N]name` written at this segment, -1 for none (K01: refused before declarations)
    int: segocc
    # the segment's text in the path text, and its atom when the path was written as atoms (a located refusal)
    size_t: off
    size_t: len
    @: LmP0Node node
    # locus 7, an INDEX step (R5-3b): the index expression, kept as its span (never flattened into text); the Array
    # contract the step consumes (its level: the value before it); the element's type code and model
    L2ValueSpan: index
    @: L2TypeContract level
    int: elem_ty
    int: elem_model
end: L2PathStep

# A resolved written path: its selected root and its steps. Filled by l2_path_resolve from the
# path text (borrowed for the record's life) or by the run adapter from the atoms (a text of its own); read by every
# consumer -- the check pass, admission and qualification, initializer typing, the address route, the native emitter
# and the walker -- none of which splits the text or resolves a segment again.  Translation-only; the steps are
# released by l2_path_release.
#
# THE RECORD'S CONTRACT (the author, 2026-10-19: counters, types and maps stay consistent after every operation on the
# record).  Two sets of fields.  The VIEW -- text, length, owned, steps, cap, n, names, indexed, run_count, names_run,
# flat -- is written as one by an adapter (l2_path_steps_text, l2_path_steps_run, l2_path_steps_all), cut as one by
# l2_path_names_only (the steps before the first index step; n, names, indexed, run_count, the text length, flat
# together) and cleared as one by l2_path_release; no count of the view is stored twice (the native emitter walks the
# name steps, names, and the place emitter the index steps after them, both from the record).  The VERDICT -- the root (ni, res, oi, root, fi), each step's resolution (kind, ent, locus, row,
# the hosts, the maps view_model/model_context, the pointee and cell_ft of a reference crossed, an index step's level
# and element), the leaf (leaf_kind, leaf_mi, leaf_model, leaf_ty, array_leaf, leaf_level), ref_follow, in_eternal and
# a refusal's fail_seg/fail_why -- is written by ONE walk (l2_path_walk, l2_path_walk_steps) of the view as it stands
# then: a view is cut before its walk, never after (every caller prepares, cuts, walks, reads, releases, in that order),
# and no consumer derives any of it again from the text (the Array place is a view of this record, l2_array_place_view).
struct: L2Path
    const: @: char text
    size_t: length
    # the text is the record's own (the run adapter joins the names of a path written as atoms)
    int: owned
    # the steps of the record (the resolver walks exactly these, l2_path_walk_steps; the native emitter reads exactly
    # these, l2_emit_path_resolved): one count for every reader -- a view that cuts the record (l2_path_names_only)
    # cuts it here, and no second count of segments is stored beside it (R3)
    int: n
    # the name steps before the first index step; the index steps; the fields of the written run the atoms adapter
    # consumed. Adjacent groups are also retained steps;flat marks the FIRST
    # adjacency so a receiving Array contract can distinguish that shape.
    int: names
    int: indexed
    int: run_count
    # the fields of the run before its first index step (the root and the name steps): what the operand grammar's
    # names-only mode returns (l2_rw_path_run_mode reads run_count and this; nothing else re-decides where a run ends)
    int: names_run
    # Original run anchor, borrowed from P0. Together with run_count this
    # identifies the adapter's exact operand without reparsing its spelling.
    # Text-only/synthetic views have no run anchor. It travels with every
    # prepared view and fact; it does not mark a query as source consumption.
    @: LmP0Field source_first
    @: LmP0Field flat
    int: ni
    int: res
    int: oi
    # The selected binding's physical place remains valid when its VALUE
    # is projected to an original namespace/method occurrence (oi becomes
    # -1 in that value view). Address projection consumes this coordinate,
    # never reconstructing the binding from the value's name or parent.
    int: root_own
    # Declared requirement source of this binding,closed with root_ft and
    # root_level. A hidden input may borrow its lexical declaration's
    # contract even when it only forwards the value and needs no physical
    # lexical fallback. It never replaces fi/oi or the runtime input value.
    # -1 means no own declaration (e.g.an explicit formal or namespace).
    int: root_contract_own
    # Exact selected binding type,closed with root_level at the common
    # selection boundary. -2 is not closed;-1 is closed with no L2 cell
    # type (e.g.a namespace/method/declared C constant). Never a fallback
    # invitation to consult a changed source type table in a backend.
    int: root_ft
    # Root selection is a kind plus an index, not disjoint numeric ranges of one int.
    # 0: ni/res/oi/fi select an ordinary namespace or binding; 1: node;
    # 2: root indexes a control body; 3: a method occurrence; 4: a machine local;
    # 5: an activation-local slot; 6: a declared external constant with no
    # L2 storage cell. All binding roots retain their selected index.
    # These are compiler decisions only, never opcodes stored in an Lmx graph.
    int: root_kind
    int: root
    int: fi
    # The resolver selected this fn args child as the root's required model.
    # -1 means another already resolved origin. Backends never rediscover it
    # from formal/type spelling or candidate flow. Translation metadata only.
    int: model_input
    # the leaf: the last step's kind; its Structure (kind 2/3) or pointee (kind 10/11) as the model; its method
    # (kind 4) or pointer code (kind 10/11) as mi -- what l2_path_kind and l2_path_contract answer
    int: leaf_kind
    int: leaf_mi
    int: leaf_model
    # the leaf's value is an Array (leaf_level its contract): a name whose declaration is one, an element that is one;
    # leaf_ty: the value type code of an element leaf (kind 13)
    int: array_leaf
    @: L2TypeContract leaf_level
    int: leaf_ty
    int: ref_follow
    # the destination is a cell of a qualified immutable graph (l2_path_in_eternal)
    int: in_eternal
    # a refused walk: the segment and why (1 the root, 2 a segment the host has not, 3 a slot with no Structure to go
    # on through, 4 a malformed segment, 5 an index on a value that is no Array, 6 an element with no value contract)
    # -- l2_path_seg_refusal / l2_path_seg_refusal_at say it
    int: fail_seg
    int: fail_why
    # Expression-owned value preparation carries its readiness WITH this
    # shared record,not in copied span views. 0 not walked,1 success,-1
    # refused. The method identifies this use's explicit source context;
    # this is transient compiler metadata,not a global binding cache.
    int: value_status
    int: value_method
    # Compiler source-plan revision,not a runtime graph generation. Planning
    # may change MRS/field maps after CHECK. The next shared projection then
    # recloses this SAME owned grammar once for the new complete plan.
    size_t: value_revision
    L2ValueSource: source_value
    # The selected root's carried requirement,closed by the same dispatcher.
    # A language Array contract is not opaque C storage merely because its
    # physical descriptor has a foreign C spelling.
    @: L2TypeContract root_level
    @: L2PathStep steps
    int: cap
end: L2Path

# A CHECK-resolved receiving contract of one source value occurrence. This
# borrows existing method/input/site identities; it is not a prediction of
# the selected implementation's body or the candidate's physical layout.
# A dynamic callable selector belongs to the source fact's method and must
# later use the existing callable-class closure, never the prototype's body.
struct: L2UseReceiver
    int: method
    int: key
    @: LmP0Text input_symbol
    @: LmP0Text selector_symbol
    const: @: LmP0Node site
    @: L2UseReceiver next
end: L2UseReceiver

# One concrete written call and its actual CHECK environment. This is
# binding-owned compiler metadata; it borrows the original source occurrence
# and never substitutes a descriptor body or an ABI witness for that call.
# The saved site's scopes are released before the binding allocations.
struct: L2ConsumerCallUse
    int: method
    int: source_method
    const: @: LmP0Node source
    int: signature
    int: formal
    @: L2SourceSite use_site
    @: L2ConsumerCallUse next
end: L2ConsumerCallUse

# One observed result of the common resolver in its actual source context.
# This is compiler metadata, not a second value graph or a complete Consumer.
# Receiving roles and propagation are separate consumers of these facts.
struct: L2PathFact
    int: method
    int: source_method
    @: LmP0Node source
    # Canonical input-row address, not its provisional sorted position. Hidden
    # input insertion may move fi without changing this binding. No character
    # comparison or source reparse is needed to select its current Consumer.
    @: LmP0Text input_symbol
    # A source consumption is recorded by the existing namespace/capture
    # traversal, not inferred from a later compiler typing query. The saved
    # source environment borrows the original P0; it is not a binding table.
    # 0 compiler query,1 written path,2 independently written whole binding
    # read. A path's root contributes only its path observation. A whole read
    # has a resolved root and zero steps; it is NOT a prepared path view or
    # proof that all fields of its Model are consumed. Receiving roles and
    # forwarding must propagate actual downstream requirements explicitly.
    int: source_use
    # CHECK evidence only: bit 0 compares the reference itself; bit 1
    # forwards the value to receivers below; bit 2 (value 4): a written call
    # takes the path as its head (l2_use_invoked). Zero is UNCLASSIFIED, not an
    # empty Consumer. Bound Consumer equations read this CHECK evidence;
    # incidental compiler queries never classify an original source use.
    int: use_roles
    @: L2UseReceiver receivers
    @: L2ConsumerCallUse calls
    # 0: grammar and resolved root only; 1: the common semantic step walk ran.
    # A root-only record must never be mistaken for an empty successful use.
    int: stage
    @: L2SourceSite use_site
    L2Path: resolved
    @: L2PathFact next
end: L2PathFact

# A finite Consumer equation over existing bound ports. These are temporary
# compiler demands, not another value/source graph or runtime binding table.
# Aliases union demands without merging their child scopes: repeated edges
# may check the same place under different nested Consumers independently.
struct: L2UsePlanEdge
    L2PathStep: step
    int: schema
    int: whole
    # The Consumer calls the field this edge selects (a written call's head,
    # fact use_roles bit 2): its coverage cell asks the value there to take the
    # call (below SIZE_MAX - 1), not to be entered whole.
    int: called
    # Borrowed concrete occurrences from the selected source fact, not a
    # reconstructed invocation of the field's declared signature.
    @: L2ConsumerCallUse calls
    @: L2UsePlanLevel below
    @: L2UsePlanEdge next
end: L2UsePlanEdge

struct: L2UsePlanLink
    @: L2UsePlanLevel target
    @: L2UsePlanLink next
end: L2UsePlanLink

struct: L2UsePlanLevel
    int: method
    int: key
    int: schema
    int: id
    int: full
    int: seen
    @: L2UsePlanEdge edges
    @: L2UsePlanLink links
    @: L2UsePlanLevel next
end: L2UsePlanLevel

# Prepared Consumer scope for one bound port and required schema. Own,
# formal and hidden inputs share the same equations and physical-cell fold.
struct: L2UseScope
    int: method
    int: key
    int: schema
    int: state
    int: first
    int: count
    int: levels
    @: L2UseScope next
end: L2UseScope

# A compact head's original P0 expression and the common adapter's prepared
# path. Both are translation-owned; deferred checks and both backends borrow
# them. A use takes an independent grammar view, then resolves that view in
# its source environment. It never reparses the retained expression to decide
# its path shape again. No binding or runtime graph object is retained here.
struct: L2HeadExpression
    @: LmP0Node source
    @: LmP0Document document
    @: LmP0Structure body
    # The common adapter's grammar verdict (2 means no path run). Retain it
    # too: a computed/non-path head must not be parsed again after a miss.
    int: path_status
    L2Path: prepared
    # A non-path head still owns its complete written expression grammar.
    # A grammar miss is not permission to rebuild it in a later consumer.
    @: L2ValueSpan values
    int: value_n
    @: L2HeadExpression allocated_next
end: L2HeadExpression

# A resolved source location, not another binding table. kind selects the
# existing own/argument/local-slot/machine-local/namespace entry; descriptor
# distinguishes the actual Structure from a cell holding a reference to it.
# Kind 6 -- the target as one path -- carries the path's resolved record (`path`; `resolved` = 1): l2_address_target
# resolves it once, the emitters (l2_emit_address, l2_rw_address) read it, and the consumer that was answered 0 releases
# the address (l2_address_release) when it is done with it; the scalars stay readable after the release (U7 D4).
# Declared after L2Path: the record is a member.
struct: L2Address
    # Kind9: an opaque physical C-symbol location borrowed from the prepared
    # operand. No language value cell or default numeric/pointer type is made.
    int: kind
    int: index
    int: descriptor
    int: model
    int: type
    @: LmP0Field target
    int: target_count
    int: immutable
    L2Path: path
    int: resolved
    # Kind8: raw-pointer indexing;path retains every prepared index span and
    # its consumed type. descriptor marks opaque C member storage. Kind7:
    # an explicit pointer-cell location. Borrow the complete parsed
    # receiver,not a cut root/suffix. index is the leaf value type,type the
    # address type;path retains a resolved receiver path when one was used.
    L2ValueSpan: operand
    int: levels
    int: source_type
end: L2Address

# One Array place (R5-3b): the Array-place VIEW of a resolved path (l2_array_place_view).  The record's name prefix
# is the base (`base` its text; `own` the own binding when the base is one name), its index steps the place's steps
# (`steps` their number; step k's expression span is read from the record, l2_place_step), its leaf the result --
# the last level's element type and model, or the Array value itself (the descriptor reference) with no step.
# `count` is the number of fields of the written run the place consumed.  `said` is the node of a located refusal
# (an index on no Array, a field after an index, the flat `[i][j]` form).  `expression` is the statement head's
# parsed tree when the place is a head.  Released by l2_array_place_release.
struct: L2ArrayPlace
    int: own
    LmP0Text: base
    int: type
    int: model
    @: L2HeadExpression expression
    int: count
    int: steps
    @: LmP0Node said
    L2Path: path
end: L2ArrayPlace

# A borrowed source environment for deferred checks and actual call sites.
# Names still resolve through the existing own/formal rows; this is not a
# binding table. source_method records the source owner separately when a
# partial callable borrows its model's body; unrelated offsets are not compared.
# unevaluated: the site is inside an UNEVALUATED operand (sizeof, C's sizeof),
# so a check replayed there records no obligation of a call.
struct: L2SourceSite
    int: kind
    int: method
    int: current_method
    int: source_method
    int: count
    int: target
    int: scope_count
    @@: LmP0Node scopes
    int: excluded
    int: visibility
    size_t: visible_at
    int: unevaluated
    @: void site
    @: LmP0Node source
end: L2SourceSite

# Translation-only physical child edges, in parent-before-child allocation order.
# A null parent starts at the selected callable occurrence, never its lexical node.
# These rows name existing graph places; they allocate no runtime graph objects.
struct: L2GraphPlace
    size_t: id
    int: method
    size_t: child
    @: L2GraphPlace parent
    @: L2GraphPlace allocated_next
end: L2GraphPlace

# A field's physical slot, independent of the lexical scope that resolves it.
# A null holder means the field owner's selected occurrence itself.
struct: L2GraphField
    @: L2GraphPlace holder
    size_t: child
end: L2GraphField

# A source container's committed producer, in one construction view. These
# records borrow P0 identity and disappear with the translation; they are not
# graph fields, source leaves, primitive wrappers or runtime binding metadata.
struct: L2SourceContainer
    size_t: id
    int: view_kind
    int: view_index
    # Actual callable owner, distinct from a projection site's view index.
    int: source_mi
    # Translator-only identity of a part of that occurrence: 0 is the
    # existing producer, 1 is var, 2 is body. It is not a runtime field.
    int: part
    @: LmP0Structure body
    int: fid
    int: inert
    int: root
    int: width
    int: temp
    int: fills
    int: shell_state
    @: L2GraphPlace place
    @: L2SourceField fields
    @: L2SourceContainer allocated_next
end: L2SourceContainer

# Original declaration cells of this actual source body, in its construction
# view. Only compiler planning owns these records; the graph keeps real cells.
struct: L2SourceField
    int: own
    int: slot
    # PLACE handle of the existing computed-output operand, preallocated
    # before any borrow; -1 for a separately written typed declaration cell.
    int: storage_temp
    L2GraphField: place
    @: L2SourceField next
end: L2SourceField

# PLACE records actual constructor/attachment edges. Temp numbers are private
# emission handles; only the resulting ordinary GraphPlace reaches backends.
struct: L2ConstructionTemp
    int: view_kind
    int: view_index
    int: index
    int: parent
    int: slot
    int: root
    @: L2GraphPlace place
    @: L2ConstructionTemp allocated_next
end: L2ConstructionTemp

# Exact compiler-state history for source-plan convergence. Never allocated
# in a program arena or represented by additional fields of an Lmx value.
struct: L2SourcePlanState
    @: char data
    size_t: length
    @: L2SourcePlanState next
end: L2SourcePlanState

# A source expression site's construction in one view (G1): the first written
# node of its field run and the run's count identify the exact P0 occurrence;
# the construction view and the selecting method keep each walk of that node
# apart (a T7 projection, a merge result's body). `temp` is the expression's
# root node in PLACE and resolves to an ordinary GraphPlace after bind. Only
# the translator reads these records; the graph keeps no site, name or P0.
# The receiving operation's compiler-owned contract. Only expression-site
# role3 owns one; ordinary numeric/expression sites pay no payload cost.
# Runtime graph operands are the representation, never this record.
struct: L2AdmissionPlan
    int: requirement
    int: mode
    int: own
    int: target_method
    int: target_key
    @: LmP0Text target_symbol
    L2ReferenceSource: source
    L2D105Catalog: catalog
    @: L2UseScope scope
end: L2AdmissionPlan

struct: L2ExpressionSite
    int: view_kind
    int: view_index
    int: method
    const: @: LmP0Node node
    int: count
    # 0 = complete field run; 1 = source numeric LIT leaf; 2 = numeric binary
    # source node. Role 2 uses value_type as the graph-lowering layout:
    # bit 0 swaps source operands in physical child order, bit 1 means the
    # root is SUB(LIT 1, inner OP). This is translation-only, not graph data.
    # A conversion may wrap a leaf in another run.
    # 3 = exact receiving operation; admission retains its common catalog
    # and canonical receiving port. No opcode or origin enters the graph.
    # 4 = exact written CALL/EXEC, not an outer expression or a converter.
    # Its existing owning GraphPlace is the call-use payload; no new call
    # graph or runtime source address is introduced by the compiler row.
    int: role
    int: value_type
    @: L2AdmissionPlan admission
    int: temp
    # 0 noted; 1 bound to `place`; 2 no owning attachment in its view; 3 two
    # sibling constructions of one run in one view (refused, never chosen).
    int: state
    @: L2GraphPlace place
    @: L2ExpressionSite allocated_next
end: L2ExpressionSite
