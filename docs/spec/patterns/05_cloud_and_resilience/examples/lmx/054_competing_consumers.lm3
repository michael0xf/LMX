JobQueueMessage:
    @: queue
    return: int
    take:
        if: queue\size() = 0
            return: -1
        return: queue\pop()

WorkerMessage:
    int: job
    @: queueOwner
    @: selfAddress
    @: process
    start:
        post:
            ask:
                queueOwner\take()
            answer:
                selfAddress\received
    ---
    received:
        if: job = -1
            return
        process(job)
        start()

