Adapters:
    return: int
    memory:
        return: 10
    alternate:
        return: 12

Core:
    int: quantity
    @: price
    return: int
    quote:
        return: quantity * price()
    demo:
        return: quote(2; Adapters\memory) + quote(2; Adapters\alternate)

