Example:
    int: a 1
    int: b 2
    int: c 3
    int: d 4
    return: @
    run:
        @: semicolon ([][]int: [a b c; a b d; a b c])
        @: grouped ([][]int: [[a b c] [a b d] [a b c]])
        @: numericSemicolon ([][]int: [1 2; 3 4; 5 6])
        @: numericGrouped ([][]int: [[1 2] [3 4] [5 6]])
        return: (semicolon grouped numericSemicolon numericGrouped)
