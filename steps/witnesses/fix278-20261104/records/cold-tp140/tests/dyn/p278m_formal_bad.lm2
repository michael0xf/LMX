# A written form at a formal is admitted to the formal's used fields: a form without them is the implicit implements on the assignment.
Holder:
    int: x 2
end: Holder
fn: f (@: t Holder) int
    ---
        t: (int: z 5)
        return: t\x
        catch: implements ()
            return: 7
    ---
end: f
sendMessage: exit(exit_code: f(Holder); stdout: ""; stderr: "")
return
