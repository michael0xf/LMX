                return: (cast: (int) (1))
            ---
        if: lm_compiler_rw_graph_path_full(prepared, (cast: (int) (\out)), (cast: (@: c.L2GraphPlace) (place\parent)), stop, base, root_path, root_level, code_base, @ holder) != 0 || c.lm_compiler_rw_put((cast: (int) (\out)), 1, holder) != 0
            return: (cast: (int) (1))
        ---
    ---
    if: rw_emit_cell[0] != 0 && c.fprintf(out_cell[0], "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 2U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", \out, place\child) < 0
        return: (cast: (int) (1))
