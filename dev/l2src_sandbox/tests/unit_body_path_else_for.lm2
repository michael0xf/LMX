# An else shell inside a for stays readable after a call publishes the cell.
fn: nop () int
    return: 0
fn: read_else () int
    int: answer 64
    for: int(i, 0) (i < 1) i++
        if: 0
            int: unused 1
        else:
            int: hosted 21
        nop()
        if: else\hosted = 21
            answer: 7
    end: for
    return: answer
int: r 0
r: read_else()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
