# Original: l2src/l2trans.lm1:25686
fn: lm_compiler_path_resolve_contract (const: (@: pd char); size_t: pn; @: out_mi int; @: out_model int; @@: out_contract c.L2TypeContract; @: out_ref_follow int) int
    c.L2Path: path_value
    @: path c.L2Path @ path_value
    int: kind 0 - 1
    \out_mi: 0 - 1
    if: out_contract != 0
        \out_contract: 0
    if: out_model != 0
        \out_model: 0 - 1
    if: out_ref_follow != 0
        \out_ref_follow: 0
