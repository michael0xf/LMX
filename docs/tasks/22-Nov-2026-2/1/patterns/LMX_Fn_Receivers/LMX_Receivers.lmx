# SOURCE: src/regex/combinators.lmx
# Composition enumerates complete candidates in written order. It is NOT
# Boolean short circuit. All stacks below are explicit ordinary linked DATA.

RxPartsConfig:
    @: originalParts 0
    @[]: parts []

RxPartsPrepare:
    private: @: patterns
    return: @
    prepare:
        private: @: info FxSeqInfo\get(source := patterns)
        private: @[]: parts []
        sys\resize(parts; length(patterns))
        private: int: i 0
        while: i < length(patterns)
            private: @: item FxSeqRead\read(patterns; i)
            parts[i] := RxNormalize\make(value := item)
            i += 1
        private: @: config (copy(RxPartsConfig))
        config\originalParts := patterns
        config\parts := parts
        return: config

RxSequence:
    private: @: patterns
    required: patterns
    return: @
    sequence:
        private: @: config RxPartsPrepare\prepare(patterns := patterns)
        if: length(config\parts) = 0
            return: emptyPattern
        if: length(config\parts) = 1
            return: config\parts[0]
        return: RxPatternFactory\make(RxSequenceOpen\open; config)

RxChoice:
    private: @: patterns
    required: patterns
    return: @
    choice:
        private: @: config RxPartsPrepare\prepare(patterns := patterns)
        if: length(config\parts) = 0
            return: neverPattern
        if: length(config\parts) = 1
            return: config\parts[0]
        return: RxPatternFactory\make(RxChoiceOpen\open; config)

RxSequenceState:
    @: source 0
    @: parts 0
    @: top 0

RxSequenceFrame:
    @: previous 0
    int: index 0
    @: cursor 0

RxSequenceFrameMake:
    private:
        RxPreparedText@: source
        @: parts
        int: index
        @: candidate
        @: previous
    return: @
    make:
        private: @: frame (copy(RxSequenceFrame))
        frame\previous := previous
        frame\index := index
        frame\cursor := RxOpen\open(parts[index]; source; candidate\position; candidate\captures)
        return: frame

RxSequenceOpen:
    private:
        @: config
        RxPreparedText@: source
        int: position
        @: captures
    return: @
    open:
        private: @: state (copy(RxSequenceState))
        state\source := source
        state\parts := config\parts
        state\top := RxSequenceFrameMake\make(source; config\parts; 0; RxCandidateMake\make(position; captures); 0)
        return: RxCursorFactory\make(RxSequenceStep\step; state)

RxSequenceStep:
    private: @: state
    return: @
    step:
        while: state\top != 0
            private: @: frame state\top
            private: @: cursor frame\cursor
            private: @: next cursor()
            if: next\present = 0
                state\top := frame\previous
            else:
                private: @: candidate next\value
                if: frame\index + 1 = length(state\parts)
                    return: next
                state\top := RxSequenceFrameMake\make(state\source; state\parts; frame\index + 1; candidate; frame)
        ---
        return: FxNone\none()

RxChoiceState:
    @: source 0
    @: parts 0
    int: position 0
    @: captures 0
    int: index 0
    @: cursor 0

RxChoiceOpen:
    private:
        @: config
        RxPreparedText@: source
        int: position
        @: captures
    return: @
    open:
        private: @: state (copy(RxChoiceState))
        state\source := source
        state\parts := config\parts
        state\position := position
        state\captures := captures
        return: RxCursorFactory\make(RxChoiceStep\step; state)

RxChoiceStep:
    private: @: state
    return: @
    step:
        while: state\index < length(state\parts)
            if: state\cursor = 0
                state\cursor := RxOpen\open(state\parts[state\index]; state\source; state\position; state\captures)
            private: @: cursor state\cursor
            private: @: next cursor()
            if: next\present != 0
                return: next
            state\cursor := 0
            state\index += 1
        return: FxNone\none()

RxRepeatConfig:
    @: pattern 0
    int: minimum 0
    int: bounded 0
    int: maximum 0
    int: order 0

RxRepeated:
    private:
        @: pattern
        int: minimum 0
        @: maximum unbounded
        int: order extendFirst
    required: pattern
    return: @
    repeated:
        throws: PatternArgument
        if: minimum < 0
            throw: PatternArgument()
        if: order != extendFirst && order != stopFirst
            throw: PatternArgument()
        private: @: config (copy(RxRepeatConfig))
        config\pattern := RxNormalize\make(value := pattern)
        config\minimum := minimum
        config\order := order
        if: satisfies(maximum; RxUnbounded) = 0
            private: int: bound \maximum
            if: bound < minimum || bound < 0
                throw: PatternArgument()
            config\bounded := 1
            config\maximum := bound
        return: RxPatternFactory\make(RxRepeatOpen\open; config)

RxRepeatState:
    @: source 0
    @: config 0
    @: top 0

RxRepeatFrame:
    @: previous 0
    @: candidate 0
    int: count 0
    int: lastWasEmpty 0
    int: stopReturned 0
    int: extendFinished 0
    @: cursor 0

RxRepeatFrameMake:
    private:
        @: previous
        @: candidate
        int: count
        int: lastWasEmpty
    return: @
    make:
        private: @: frame (copy(RxRepeatFrame))
        frame\previous := previous
        frame\candidate := candidate
        frame\count := count
        frame\lastWasEmpty := lastWasEmpty
        return: frame

RxRepeatOpen:
    private:
        @: config
        RxPreparedText@: source
        int: position
        @: captures
    return: @
    open:
        private: @: state (copy(RxRepeatState))
        state\source := source
        state\config := config
        state\top := RxRepeatFrameMake\make(0; RxCandidateMake\make(position; captures); 0; 0)
        return: RxCursorFactory\make(RxRepeatStep\step; state)

RxRepeatStep:
    private: @: state
    return: @
    step:
        private: @: config state\config
        while: state\top != 0
            private: @: frame state\top
            private: int: mayStop frame\count >= config\minimum
            if: config\order = stopFirst && mayStop && frame\stopReturned = 0
                frame\stopReturned := 1
                return: FxSome\some(value := frame\candidate)
            private: int: mayExtend frame\extendFinished = 0
            if: config\bounded != 0 && frame\count >= config\maximum
                mayExtend := 0
            # A nonprogressing iteration may only be followed by still
            # mandatory iterations. Alternative candidates remain on cursor.
            if: frame\lastWasEmpty != 0 && mayStop
                mayExtend := 0
            if: mayExtend != 0
                if: frame\cursor = 0
                    frame\cursor := RxOpen\open(config\pattern; state\source; frame\candidate\position; frame\candidate\captures)
                private: @: cursor frame\cursor
                private: @: next cursor()
                if: next\present != 0
                    private: @: child next\value
                    private: int: didNotMove child\position = frame\candidate\position
                    state\top := RxRepeatFrameMake\make(frame; child; frame\count + 1; didNotMove)
                    continue
                frame\extendFinished := 1
            if: config\order = extendFirst && mayStop && frame\stopReturned = 0
                frame\stopReturned := 1
                return: FxSome\some(value := frame\candidate)
            state\top := frame\previous
        return: FxNone\none()

RxUnaryConfig:
    @: pattern 0

RxAtomic:
    private: @: pattern
    required: pattern
    return: @
    atomic:
        private: @: config (copy(RxUnaryConfig))
        config\pattern := RxNormalize\make(value := pattern)
        return: RxPatternFactory\make(RxAtomicOpen\open; config)

RxAtomicState:
    @: cursor 0
    int: finished 0

RxAtomicOpen:
    private:
        @: config
        RxPreparedText@: source
        int: position
        @: captures
    return: @
    open:
        private: @: state (copy(RxAtomicState))
        state\cursor := RxOpen\open(config\pattern; source; position; captures)
        return: RxCursorFactory\make(RxAtomicStep\step; state)

RxAtomicStep:
    private: @: state
    return: @
    step:
        if: state\finished != 0
            return: FxNone\none()
        state\finished := 1
        private: @: cursor state\cursor
        return: cursor()

RxCaptureConfig:
    char[]: name ""
    @: pattern 0

RxCapture:
    private:
        char[]: name
        @: pattern
    required: name pattern
    return: @
    capture:
        private: @: config (copy(RxCaptureConfig))
        config\name := name
        config\pattern := RxNormalize\make(value := pattern)
        return: RxPatternFactory\make(RxCaptureOpen\open; config)

RxCaptureState:
    char[]: name ""
    int: begin 0
    @: cursor 0

RxCaptureOpen:
    private:
        @: config
        RxPreparedText@: source
        int: position
        @: captures
    return: @
    open:
        private: @: state (copy(RxCaptureState))
        state\name := config\name
        state\begin := position
        state\cursor := RxOpen\open(config\pattern; source; position; captures)
        return: RxCursorFactory\make(RxCaptureStep\step; state)

RxCaptureStep:
    private: @: state
    return: @
    step:
        private: @: cursor state\cursor
        private: @: next cursor()
        if: next\present = 0
            return: next
        private: @: candidate next\value
        private: @: captures RxCaptureAdd\add(candidate\captures; state\name; state\begin; candidate\position)
        return: FxSome\some(value := RxCandidateMake\make(candidate\position; captures))

RxLookConfig:
    @: pattern 0
    int: backward 0
    int: inverted 0

RxLookProbe:
    private:
        @: payload
        RxPreparedText@: source
        int: position
        @: captures
    return: int
    probe:
        private: int: found 0
        if: payload\backward = 0
            private: @: cursor RxOpen\open(payload\pattern; source; position; captures)
            private: @: next cursor()
            found := next\present
        else:
            # No fixed-width restriction. Inner patterns see the whole source;
            # only accepted end positions are constrained to this position.
            private: int: start 0
            while: start <= position && found = 0
                private: @: cursor RxOpen\open(payload\pattern; source; start; captures)
                private: @: next cursor()
                while: next\present != 0
                    if: next\value\position = position
                        found := 1
                        break
                    next := cursor()
                start += 1
        # Local journals are discarded: only this unchanged position survives.
        # No exception is caught here, especially not PatternEncoding.
        ---
        if: (found != 0) != (payload\inverted != 0)
            return: position
        return: -1

RxAhead:
    private: @: pattern
    required: pattern
    return: @
    ahead:
        private: @: config (copy(RxLookConfig))
        config\pattern := RxNormalize\make(value := pattern)
        config\backward := 0
        config\inverted := 0
        return: RxPrimitiveMake\make(RxLookProbe\probe; config)

RxNotAhead:
    private: @: pattern
    required: pattern
    return: @
    notAhead:
        private: @: config (copy(RxLookConfig))
        config\pattern := RxNormalize\make(value := pattern)
        config\backward := 0
        config\inverted := 1
        return: RxPrimitiveMake\make(RxLookProbe\probe; config)

RxBehind:
    private: @: pattern
    required: pattern
    return: @
    behind:
        private: @: config (copy(RxLookConfig))
        config\pattern := RxNormalize\make(value := pattern)
        config\backward := 1
        config\inverted := 0
        return: RxPrimitiveMake\make(RxLookProbe\probe; config)

RxNotBehind:
    private: @: pattern
    required: pattern
    return: @
    notBehind:
        private: @: config (copy(RxLookConfig))
        config\pattern := RxNormalize\make(value := pattern)
        config\backward := 1
        config\inverted := 1
        return: RxPrimitiveMake\make(RxLookProbe\probe; config)

# SOURCE: src/regex/operations.lmx
# Public matching/search/result operations. None of these interprets Pattern
# source code; each applies its already constructed ordinary callable.

RxSelectAt:
    private:
        RxPreparedText@: source
        Pattern@: pattern
        int: position
        int: whole 0
        int: nonEmpty 0
    return: @
    select:
        # whole filters the END position only; the supplied start may be nonzero.
        private: @: cursor RxOpen\open(pattern; source; position; 0)
        private: @: next cursor()
        while: next\present != 0
            private: @: candidate next\value
            private: int: accepted 1
            if: whole != 0 && candidate\position != length(source\units)
                accepted := 0
            if: nonEmpty != 0 && candidate\position = position
                accepted := 0
            if: accepted != 0
                return: FxSome\some(value := RxMatchMake\make(source; position; candidate))
            next := cursor()
        return: FxNone\none()

RxMatchAt:
    private:
        TextView@: source
        @: pattern
        int: position
    required: source pattern position
    return: @
    matchAt:
        private: @: prepared RxPrepare\make(source := source)
        private: @: ready RxNormalize\make(value := pattern)
        return: RxSelectAt\select(source := prepared; pattern := ready; position := position)

RxWholeMatch:
    private:
        TextView@: source
        @: pattern
    required: source pattern
    return: @
    wholeMatch:
        private: @: prepared RxPrepare\make(source := source)
        private: @: ready RxNormalize\make(value := pattern)
        return: RxSelectAt\select(source := prepared; pattern := ready; position := 0; whole := 1)

RxFindState:
    @: source 0
    @: pattern 0
    int: position 0
    int: nonEmpty 0
    int: finished 0

RxFindStateMake:
    private:
        RxPreparedText@: source
        Pattern@: pattern
    return: @
    make:
        private: @: out (copy(RxFindState))
        out\source := source
        out\pattern := pattern
        return: out

RxFindNext:
    private: @: state
    return: @
    step:
        if: state\finished != 0
            return: FxNone\none()
        private: int: end length(state\source\units)
        while: state\position <= end
            private: @: selected RxSelectAt\select(source := state\source; pattern := state\pattern; position := state\position; nonEmpty := state\nonEmpty)
            if: selected\present != 0
                private: @: matched selected\value
                if: matched\end > matched\begin
                    state\position := matched\end
                    state\nonEmpty := 0
                else:
                    if: matched\end = end
                        state\finished := 1
                    else:
                        state\nonEmpty := 1
                ---
                return: selected
            state\nonEmpty := 0
            if: state\position = end
                state\finished := 1
                return: FxNone\none()
            state\position += 1
        state\finished := 1
        return: FxNone\none()

RxFind:
    private:
        TextView@: source
        @: pattern
    required: source pattern
    return: @
    find:
        private: @: prepared RxPrepare\make(source := source)
        private: @: ready RxNormalize\make(value := pattern)
        private: @: state RxFindStateMake\make(prepared; ready)
        return: RxFindNext\step(state := state)

RxFindAllOwner:
    private: @: state 0
    Next:
        return: @
        next:
            throws: Stop
            private: @: owner parent()
            private: @: state owner\private\state
            while: 1
                private: @: selected RxFindNext\step(state := state)
                if: selected\present = 0
                    throw: Stop()
                yield: selected\value

RxEachMatch:
    private:
        TextView@: source
        @: pattern
    required: source pattern
    return: @
    eachMatch:
        private: @: prepared RxPrepare\make(source := source)
        private: @: ready RxNormalize\make(value := pattern)
        private: @: owner (copy(RxFindAllOwner))
        owner\private\state := RxFindStateMake\make(prepared; ready)
        return: owner\Next\next

RxContains:
    private:
        TextView@: source
        @: pattern
    required: source pattern
    return: int
    contains:
        private: @: found RxFind\find(source := source; pattern := pattern)
        return: found\present

RxHasPrefix:
    private:
        TextView@: source
        @: pattern
    required: source pattern
    return: int
    hasPrefix:
        private: @: found RxMatchAt\matchAt(source := source; pattern := pattern; position := 0)
        return: found\present

RxHasSuffix:
    private:
        TextView@: source
        @: pattern
    required: source pattern
    return: int
    hasSuffix:
        private: @: prepared RxPrepare\make(source := source)
        private: @: ready RxNormalize\make(value := pattern)
        private: int: position 0
        private: int: end length(prepared\units)
        # Try every valid start on the same complete prepared source.
        # Filtering while enumerating preserves alternatives and overlaps.
        while: position <= end
            private: @: found RxSelectAt\select(source := prepared; pattern := ready; position := position; whole := 1)
            if: found\present != 0
                return: 1
            if: position = end
                return: 0
            position += 1
        return: 0

RxMatches:
    private:
        TextView@: source
        @: pattern
    required: source pattern
    return: int
    matches:
        private: @: found RxWholeMatch\wholeMatch(source := source; pattern := pattern)
        return: found\present

RxMatchedSpan:
    private: Match@: result
    required: result
    return: @
    matchedSpan:
        return: RxSpanMake\make(result\private\prepared; result\begin; result\end)

RxMatchedText:
    private: Match@: result
    required: result
    return: char[]
    matchedText:
        return: RxTextSlice\copyText(result\private\prepared; result\begin; result\end)

RxCaptureSpans:
    private:
        Match@: result
        char[]: name
    required: result name
    return: @
    captureSpans:
        private: int: count 0
        private: @: cursor result\captures
        while: cursor != 0
            if: FxSameText\same(cursor\name; name) != 0
                count += 1
            cursor := cursor\previous
        private: @[]: spans []
        sys\resize(spans; count)
        cursor := result\captures
        while: cursor != 0
            if: FxSameText\same(cursor\name; name) != 0
                count -= 1
                spans[count] := RxSpanMake\make(result\private\prepared; cursor\begin; cursor\end)
            cursor := cursor\previous
        return: spans

RxLastCapture:
    private:
        Match@: result
        char[]: name
    required: result name
    return: @
    lastCapture:
        private: @: latest RxCaptureLatest\find(result\captures; name)
        if: latest\present = 0
            return: latest
        private: @: entry latest\value
        return: FxSome\some(value := RxSpanMake\make(result\private\prepared; entry\begin; entry\end))

RxCaptureText:
    private:
        Match@: result
        char[]: name
    required: result name
    return: @
    captureText:
        private: @: latest RxLastCapture\lastCapture(result; name)
        if: latest\present = 0
            return: latest
        private: @: span latest\value
        private: char[]: text RxTextSlice\copyText(span\private\prepared; span\begin; span\end)
        return: FxSome\some(value := FxRecords\reference(value := text))

RxCaptureTexts:
    private:
        Match@: result
        char[]: name
    required: result name
    return: @
    captureTexts:
        private: @: spans RxCaptureSpans\captureSpans(result; name)
        private: @[]: texts []
        sys\resize(texts; length(spans))
        private: int: i 0
        while: i < length(spans)
            private: @: span spans[i]
            private: char[]: text RxTextSlice\copyText(span\private\prepared; span\begin; span\end)
            texts[i] := FxRecords\reference(value := text)
            i += 1
        return: texts

RxReplacementAccept:
    private: @: replacement
    required: replacement
    return: @
    accept:
        if: satisfies(replacement; char[]) != 0
            private: char[]: text \replacement
            return: replacement
        private: RxReplacement@: operation replacement
        return: operation

RxReplacementText:
    private:
        @: replacement
        Match@: matched
    return: char[]
    make:
        private: char[]: text
        if: satisfies(replacement; char[]) != 0
            text := \replacement
        else:
            private: RxReplacement@: operation replacement
            # The callback is reached once, after selection, with one whole
            # Match by named actual. Its ordinary failure is never a mismatch.
            text := operation(matched := matched)
        private: @: checked RxTextBuild\make(text; matched\private\prepared\profile)
        return: text

RxReplaceFirst:
    private:
        TextView@: source
        @: pattern
        @: replacement
    required: source pattern replacement
    return: char[]
    replaceFirst:
        private: @: admittedReplacement RxReplacementAccept\accept(replacement := replacement)
        private: @: prepared RxPrepare\make(source := source)
        private: @: ready RxNormalize\make(value := pattern)
        private: @: state RxFindStateMake\make(prepared; ready)
        private: @: selected RxFindNext\step(state := state)
        if: selected\present = 0
            return: RxTextSlice\copyText(prepared; 0; length(prepared\units))
        private: @: matched selected\value
        private: char[]: replacementText RxReplacementText\make(admittedReplacement; matched)
        private: char[]: out []
        RxTextAppendSpan\append(out; prepared; 0; matched\begin)
        RxTextAppend\append(out; replacementText)
        RxTextAppendSpan\append(out; prepared; matched\end; length(prepared\units))
        return: out

RxReplace:
    private:
        TextView@: source
        @: pattern
        @: replacement
    required: source pattern replacement
    return: char[]
    replace:
        private: @: admittedReplacement RxReplacementAccept\accept(replacement := replacement)
        private: @: prepared RxPrepare\make(source := source)
        private: @: ready RxNormalize\make(value := pattern)
        private: @: state RxFindStateMake\make(prepared; ready)
        private: char[]: out []
        private: int: copiedUntil 0
        private: @: selected RxFindNext\step(state := state)
        while: selected\present != 0
            private: @: matched selected\value
            private: char[]: replacementText RxReplacementText\make(admittedReplacement; matched)
            RxTextAppendSpan\append(out; prepared; copiedUntil; matched\begin)
            RxTextAppend\append(out; replacementText)
            copiedUntil := matched\end
            selected := RxFindNext\step(state := state)
        # Search position and source-copy position remain separate.
        RxTextAppendSpan\append(out; prepared; copiedUntil; length(prepared\units))
        return: out

RxSplit:
    private:
        TextView@: source
        @: pattern
    required: source pattern
    return: @
    split:
        private: @: prepared RxPrepare\make(source := source)
        private: @: ready RxNormalize\make(value := pattern)
        private: @: state RxFindStateMake\make(prepared; ready)
        private: @[]: parts []
        private: int: copiedUntil 0
        private: @: selected RxFindNext\step(state := state)
        while: selected\present != 0
            private: @: matched selected\value
            private: char[]: text RxTextSlice\copyText(prepared; copiedUntil; matched\begin)
            FxSeqPush\append(parts; FxRecords\reference(value := text))
            copiedUntil := matched\end
            selected := RxFindNext\step(state := state)
        private: char[]: tail RxTextSlice\copyText(prepared; copiedUntil; length(prepared\units))
        FxSeqPush\append(parts; FxRecords\reference(value := tail))
        return: parts

# SOURCE: src/regex/operands.lmx
# The common executor already prepares left/right exactly once, including the
# one conditional RIGHT-only opening. Nothing in this file opens a container.
# An absent left stays nil; it is not replaced by null/zero or autofill.

RxLogicalArguments:
    private:
        @: left
        @[]: right
    required: right
    return: @
    collect:
        private: int: extra 0
        if: left != nil
            extra := 1
        private: @[]: out []
        sys\resize(out; length(right) + extra)
        if: extra != 0
            out[0] := left
        private: int: i 0
        while: i < length(right)
            out[i + extra] := right[i]
            i += 1
        return: out

RxThenOperand:
    private:
        @: left
        @[]: right
    required: right
    const: int: PASS_ARGS_AS_IS 0
    const: int: PRIORITY sys\priority("+")
    return: @
    then:
        throws: PatternArgument
        private: @: args RxLogicalArguments\collect(left := left; right := right)
        if: length(args) < 2
            throw: PatternArgument()
        return: RxSequence\sequence(patterns := args)

RxRepeatOperands:
    private:
        @: left
        @[]: right
    required: right
    const: int: PASS_ARGS_AS_IS 0
    const: int: PRIORITY sys\priority("*")
    return: @
    times:
        throws: PatternArgument
        private: @: args RxLogicalArguments\collect(left := left; right := right)
        if: length(args) != 2
            throw: PatternArgument()
        private: int: count \args[1]
        return: RxRepeated\repeated(pattern := args[0]; minimum := count; maximum := args[1])
    atLeast:
        throws: PatternArgument
        private: @: args RxLogicalArguments\collect(left := left; right := right)
        if: length(args) != 2
            throw: PatternArgument()
        private: int: count \args[1]
        return: RxRepeated\repeated(pattern := args[0]; minimum := count)
    atMost:
        throws: PatternArgument
        private: @: args RxLogicalArguments\collect(left := left; right := right)
        if: length(args) != 2
            throw: PatternArgument()
        private: int: count \args[1]
        if: count < 0
            throw: PatternArgument()
        return: RxRepeated\repeated(pattern := args[0]; maximum := args[1])
    optional:
        throws: PatternArgument
        private: @: args RxLogicalArguments\collect(left := left; right := right)
        if: length(args) != 1
            throw: PatternArgument()
        return: RxRepeated\repeated(pattern := args[0]; maximum := 1)

RxAlternativeDispatchResult:
    int: handled 0
    @: value 0

# Call this branch INSIDE the existing | body, after its existing preparation.
# If handled=0, run that body's original implementation with the ORIGINAL
# left/right. Its header, defaults, modifiers and priority are not replaced.
# This is a normal LMX helper, not an overload registry or another parser.
RxAlternativeDispatch:
    private:
        @: left
        @[]: right
    required: right
    return: @
    probe:
        throws: PatternArgument
        private: @: out (copy(RxAlternativeDispatchResult))
        private: @: args RxLogicalArguments\collect(left := left; right := right)
        private: int: hasPattern 0
        private: int: i 0
        while: i < length(args)
            if: RxIsPattern\test(value := args[i]) != 0
                hasPattern := 1
                break
            i += 1
        if: hasPattern = 0
            return: out
        if: length(args) < 2
            throw: PatternArgument()
        out\value := RxChoice\choice(patterns := args)
        out\handled := 1
        return: out

# SOURCE: src/public.lmx
# ВНУТРЕННИЙ НАБОР ЭКСПОРТОВ ЕДИНОГО ЯДРА: fun.
# Ядро включает fun/const в штатные корневые объявления; клиенты пишут прямые имена.
# Один const-блок даёт root-constant экспорты общего namespace; CODE не копируется.
# signatureTypes — обычный ядерный type-token оператор; declaration head удалён.
# Name :: DATA — единственная именованная форма того же вида сигнатуры.
fun:
    const:
        @: types RxTypes\types
        @: names RxNames\names
        @: signature RxSignature\signature
        @: signatureTypes FxSignatureOperand\make
        @: curry FxLambda\lambda
        @: apply FxApply\apply
        @: partial FxPartial\partial
        @: uncurry FxUncurry\uncurry
        @: flip FxFlip\flip
        @: compose FxCompose\compose
        @: pipe FxPipe\pipe
        @: identity FxIdentity\identity
        @: map FxMap\map
        @: filter FxFilter\filter
        @: foldl FxFold\fold
        @: zip FxZip\zip
        @: zipWith FxZipWith\zipWith
        @: scanl FxScan\scan
        @: bind FxBind\bind
        @: traverse FxTraverse\traverse
        @: memoize FxMemo\memo
        @: fix FxFix\fix
        @: select RxSelect\select
        @: omit RxOmit\omit
        @: rename RxRename\rename
        @: reorder RxReorder\reorder
        @: project RxProject\project
        @: defaults RxDefaults\defaults
        @: diff RxDiff\diff
        @: patch RxPatch\patch
        @: bindFields RxBindFields\bindFields
        @: derive RxDerive\derive
        @: transpose FxTranspose\transpose
        @: groupBy FxGroupBy\groupBy
        @: lazy FxLazy\lazy
        @: force FxForce\force
        @: once FxOnce\once
        @: repeat FxRepeat\repeat
        @: runUntil FxUntil\runUntil
        @: retryCall FxRetry\retryCall
        @: bracket FxAround\around
        @: recover FxRecover\recover
        @: adapter FxAdapter\adapter
        @: permute FxPermute\permute
        @: overload FxOverload\overload
        @: predicate FxPredicate\predicate
        @: guard FxGuard\guard
        @: trace FxTrace\trace
        @: contract FxContract\contract
        @: composeData RxComposeData\composeData
        @: record FxRecordOperands\record
        @: some FxSome\some
        @: none FxNone\none
        @: ok FxOk\ok
        @: err FxErr\err
        @: bindResult FxBindResult\bindResult
        @: list FxList\list
        @: flatMap FxListBind\flatMap
        @: done FxDone\done
        @: more FxMore\more
        @: trampoline FxTrampoline\trampoline
        @: range FxSeqRange\range
        @: slice FxSeqSlice\slice
        @: reverse FxSeqReverse\reverse
        @: concat FxSeqConcat\concat
        @: compress FxSeqCompress\compress
        @: any FxSeqAny\any
        @: all FxSeqAll\all
        @: index FxSeqIndex\index
        @: count FxSeqCount\count
        @: replaceRange FxSeqReplaceRange\replaceRange
        @: splice FxSeqSplice\splice
        @: append FxSeqAppend\append
        @: insert FxSeqInsert\insert
        @: deleteAt FxSeqDeleteAt\deleteAt
        @: literal RxLiteral\literal
        @: oneOf RxChars\oneOf
        @: noneOf RxChars\noneOf
        @: charRange RxRange\charRange
        @: satisfy RxSatisfy\satisfy
        @: boundaryOf RxBoundaryOf\boundaryOf
        @: sameAs RxSameAs\sameAs
        @: sequence RxSequence\sequence
        @: choice RxChoice\choice
        @: repeated RxRepeated\repeated
        @: atomic RxAtomic\atomic
        @: capture RxCapture\capture
        @: ahead RxAhead\ahead
        @: notAhead RxNotAhead\notAhead
        @: behind RxBehind\behind
        @: notBehind RxNotBehind\notBehind
        @: utf8Text RxUtf8Text\utf8Text
        @: byteText RxByteText\byteText
        @: matchAt RxMatchAt\matchAt
        @: wholeMatch RxWholeMatch\wholeMatch
        @: find RxFind\find
        @: eachMatch RxEachMatch\eachMatch
        @: contains RxContains\contains
        @: hasPrefix RxHasPrefix\hasPrefix
        @: hasSuffix RxHasSuffix\hasSuffix
        @: matches RxMatches\matches
        @: matchedSpan RxMatchedSpan\matchedSpan
        @: matchedText RxMatchedText\matchedText
        @: captureSpans RxCaptureSpans\captureSpans
        @: lastCapture RxLastCapture\lastCapture
        @: captureText RxCaptureText\captureText
        @: captureTexts RxCaptureTexts\captureTexts
        @: replaceFirst RxReplaceFirst\replaceFirst
        @: replace RxReplace\replace
        @: split RxSplit\split
        @: then RxThenOperand\then
        @: times RxRepeatOperands\times
        @: atLeast RxRepeatOperands\atLeast
        @: atMost RxRepeatOperands\atMost
        @: optional RxRepeatOperands\optional

# SOURCE: examples/generic_callable_examples.lmx
# ПРИМЕРЫ ОБЩЕГО СЕМЕЙСТВА (не выполнены ядром).
# Здесь намеренно три НЕОДИНАКОВЫХ типа, double-результат и проверка отсутствия
# раннего запуска. Это проверяет обобщение, а не повторяет прежнее int+int.
FxGenericCounter:
    int: calls 0

FxMixedTarget:
    private:
        int: number
        double: scale
        char[]: text
    return: double
    evaluate:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        FxGenericCounter\calls += 1
        # В этом тесте number >= 0. Смешанная сигнатура не подразумевает
        # неоговорённое автоматическое int -> double promotion в арифметике.
        private: double: total 0.0
        private: int: i 0
        while: i < number
            total += scale
            i += 1
        i := 0
        while: i < length(text)
            total += 1.0
            i += 1
        return: total

FxProcedureTarget:
    private:
        int: count
        char[]: label
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        FxGenericCounter\calls += count + length(label)

FxNullaryTarget:
    return: double
    value:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        FxGenericCounter\calls += 1
        return: 2.5

FxPairTarget:
    private:
        int: count
        char[]: label
    return:
        int: number
        char[]: text
    create:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        return: count label

FxReturnedCallable:
    private: int: value
    return: int
    increment:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        return: value + 1

FxCallableResultTarget:
    private:
        int: first
        double: second
    return: @
    choose:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        FxGenericCounter\calls += 1
        return: FxReturnedCallable\increment

FxGenericExamples:
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            ReceiverPermutation
            SequenceSize
        FxGenericCounter\calls := 0
        @: mixed FxLambda\lambda(operation := FxMixedTarget\evaluate)
        @: afterInt mixed(p0 := 2)
        @: afterDouble afterInt(p0 := 1.5)
        sys\assert(FxGenericCounter\calls = 0)
        double: result afterDouble(p0 := "abc")
        sys\assert(result = 6.0)
        sys\assert(FxGenericCounter\calls = 1)
        @: another afterInt(p0 := 2.0)
        sys\assert(another(p0 := "a") = 5.0)
        sys\assert(afterDouble(p0 := "abcd") = 7.0)
        @: prefix (copy(()))
        sys\resize(prefix; 1)
        prefix[0] := (4 FxRecordOperands\record)
        @: bound FxPartial\partial(FxMixedTarget\evaluate; prefix)
        sys\assert(bound(p0 := 0.5; p1 := "xy") = 4.0)
        @: flipped FxFlip\flip(operation := FxMixedTarget\evaluate)
        sys\assert(flipped(p0 := 1.5; p1 := 2; p2 := "abc") = 6.0)
        @: mixedInfo FxKernel\signature(subject := FxMixedTarget\evaluate)
        @: mixedContract FxSignatures\make(mixedInfo\inputTypes; mixedInfo\resultType)
        @: flattened FxUncurry\uncurry(mixed; mixedContract; FxStageFailures\names())
        sys\assert(flattened(p0 := 2; p1 := 1.5; p2 := "abc") = 6.0)
        @: empty (copy(()))
        @: same FxPartial\partial(FxMixedTarget\evaluate; empty)
        sys\assert(same(p0 := 2; p1 := 1.5; p2 := "abc") = 6.0)
        @: all (copy(()))
        sys\resize(all; 3)
        all[0] := (2 FxRecordOperands\record)
        all[1] := (1.5 FxRecordOperands\record)
        all[2] := ("abc" FxRecordOperands\record)
        @: thunk FxPartial\partial(FxMixedTarget\evaluate; all)
        int: before FxGenericCounter\calls
        sys\assert(thunk() = 6.0)
        sys\assert(FxGenericCounter\calls = before + 1)
        @: noArgs FxLambda\lambda(operation := FxNullaryTarget\value)
        sys\assert(noArgs() = 2.5)
        @: pair FxLambda\lambda(operation := FxPairTarget\create)
        @: pairLast pair(p0 := 7)
        int: pairNumber 0
        char[]: pairText ""
        @: pairValue pairLast(p0 := "seven")
        (pairNumber pairText) := (copy(pairValue))
        sys\assert(pairNumber = 7)
        sys\assert(length(pairText) = 5)
        @: procedure FxLambda\lambda(operation := FxProcedureTarget\run)
        @: procedureLast procedure(p0 := 3)
        before := FxGenericCounter\calls
        procedureLast(p0 := "ab")
        sys\assert(FxGenericCounter\calls = before + 5)
        @: returnsCallable FxLambda\lambda(operation := FxCallableResultTarget\choose)
        @: chooseLast returnsCallable(p0 := 1)
        @: returned chooseLast(p0 := 2.0)
        sys\assert(returned = FxReturnedCallable\increment)
        sys\assert(returned(4) = 5)
        return: 1

# SOURCE: examples/structure_examples.lmx
# Проверяемые примеры для будущего прогона реальным LMX-ядром.
# Здесь нет утверждения, что эти проверки уже выполнены интерпретатором.
independent: RxStructureSample:
    int: a 10
    int: b 20
    int: c 30

independent: RxAdditionSample:
    int: x
    int: y
    return: int
    add:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        return: x + y

RxStructureExamples:
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            ReceiverParent
            ReceiverPatchBase
            ReceiverPatchFormat
            ReceiverPermutation
            SequenceSize
        @: picked RxSelect\select(RxStructureSample; (2;0;2))
        sys\assert(length(picked) = 3)
        sys\assert(picked[0] = RxStructureSample[2])
        sys\assert(picked[0] = picked[2])
        @: kept RxOmit\omit(RxStructureSample; (1;1))
        sys\assert(length(kept) = 2)
        sys\assert(kept[0] = RxStructureSample[0])
        sys\assert(kept[1] = RxStructureSample[2])
        @: swapped RxReorder\reorder(RxStructureSample; (2;1;0))
        @: change RxDiff\diff(RxStructureSample; swapped)
        @: replay RxPatch\patch(RxStructureSample; change)
        sys\assert(length(change\indices) = 2)
        sys\assert(replay[0] = swapped[0])
        sys\assert(replay[1] = swapped[1])
        sys\assert(replay[2] = swapped[2])
        @: empty (copy(()))
        @: toEmpty RxDiff\diff(RxStructureSample; empty)
        @: cleared RxPatch\patch(RxStructureSample; toEmpty)
        sys\assert(length(cleared) = 0)
        @: fromEmpty RxDiff\diff(empty; RxStructureSample)
        @: restored RxPatch\patch(empty; fromEmpty)
        sys\assert(length(restored) = 3)
        sys\assert(restored[2] = RxStructureSample[2])
        @: copied RxProject\project(RxStructureSample; (2;0;2))
        sys\assert(copied[0] = copied[2])
        sys\assert(copied[0] != RxStructureSample[2])
        sys\assert(\copied[0] = 30)
        @: filled RxDefaults\defaults((int: x 0); (int: x 7; int: y 9))
        sys\assert(filled\x = 0 && filled\y = 9)
        @: extended RxDerive\derive((int: x 1); (int: y 2))
        sys\assert(extended\x = 1 && extended\y = 2)
        @: add5 RxBindFields\bindFields(RxAdditionSample\add; (int: y 5))
        sys\assert(add5(1) = 6)
        sys\assert(add5(1; y := 25) = 26)
        sys\assert(add5(1) = 6)
        return: 1

# SOURCE: examples/fn_and_assignment.lmx
# Подготовленные проверки приёмки, а не отчёт о выполненном прогоне ядра.
# Нужны generic_functions.lmx, fn_operand.lmx и поставщик FxKernel из KERNEL_REQUIREMENTS.md.
# Реальный метод операнда — FxSignatureOperand\make. Каноническое написание
# R signatureTypes T0 T1 — обычное ядерное имя в стандартном namespace ядра.
# Именованное объявление полностью перенесено в Name :: Signature.
# Пустые строки разделяют только корневые формы.
# Каждый run возвращает 1 при выполнении всех проверок.

# Готовые записи. Индекс Structure выдаёт указатель на саму запись.
# sys\typeof(FxFnReadySamples[i]) возвращает готовый int с КОДОМ её типа.
# Этот код не фиксируется числом и не равен автоматически типу int-токена.
FxFnReadySamples:
    int: number 7
    double: scale 1.5
    @: reference 0

# Эти три записи имеют только uninit:T-тег, без байтов значения.
# Каждый вложенный контейнер содержит ровно одну запись, поэтому [0]
# передаёт её адрес без @cell и без дополнительного ссылочного уровня.
FxFnUninitSamples:
    integral:
        int: value
    real:
        double: value
    reference:
        @: value

# Имена исходного callable намеренно отличаются от p0/p1/p2 новой сигнатуры.
FxFnMixedTarget:
    private:
        int: number
        double: scale
        @: reference
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        return: number

# Старое двухаргументное объявление остаётся доступным в том же документе.
FxFnExpectedMixed :: (int: p0; double: p1; @: p2; return: int)

# 1. Настоящее операндное применение квалифицированного метода.
# left = запись готового int-кода результата int.
# right = три записи int-кодов: int, double, @ — именно в этом порядке.
# Проверка приёма target выявляет ошибку «все токены сами являются int,
# значит все входы должны быть int»; последний правый токен остаётся входом.
FxFnReadyCodesExample:
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        @: made (sys\typeof(FxFnReadySamples[0]) FxSignatureOperand\make sys\typeof(FxFnReadySamples[0]) sys\typeof(FxFnReadySamples[1]) sys\typeof(FxFnReadySamples[2]))
        @: info FxKernel\signature(subject := made)
        sys\assert(length(info\inputTypes) = 3)
        sys\assert(info\hasResult = 1)
        made@: selected FxFnMixedTarget\run
        sys\assert(selected(p0 := 7; p1 := 1.5; p2 := FxFnReadySamples) = 7)
        FxFnExpectedMixed@: oldStyle FxFnMixedTarget\run
        sys\assert(oldStyle(p0 := 9; p1 := 2.0; p2 := FxFnReadySamples) = 9)
        return: 1

# 2. Обычный explicit named call того же метода.
# left и элементы tokens уже содержат указатели на записи, поэтому здесь
# не требуется prepared boxing и нет операции разыменования их payload.
# Не следует заменять left := ...[0] адресным выражением @...[0]: это иной уровень.
FxFnUninitExample:
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceSize
        int: integralTag sys\typeof(FxFnUninitSamples\integral[0])
        int: realTag sys\typeof(FxFnUninitSamples\real[0])
        int: referenceTag sys\typeof(FxFnUninitSamples\reference[0])
        @[]: tokens []
        sys\resize(tokens; 3)
        tokens[0] := FxFnUninitSamples\integral[0]
        tokens[1] := FxFnUninitSamples\real[0]
        tokens[2] := FxFnUninitSamples\reference[0]
        @: made FxSignatureOperand\make(left := FxFnUninitSamples\integral[0]; right := tokens)
        @: info FxKernel\signature(subject := made)
        sys\assert(length(info\inputTypes) = 3)
        sys\assert(info\hasResult = 1)
        made@: selected FxFnMixedTarget\run
        sys\assert(selected(p0 := 11; p1 := 3.0; p2 := FxFnReadySamples) = 11)
        sys\assert(sys\typeof(FxFnUninitSamples\integral[0]) = integralTag)
        sys\assert(sys\typeof(FxFnUninitSamples\real[0]) = realTag)
        sys\assert(sys\typeof(FxFnUninitSamples\reference[0]) = referenceTag)
        return: 1

# Для контроля нульарной процедуры нужен настоящий callable без return в DATA.
# Создание сигнатуры не должно исполнять его тело.
FxFnProcedureState:
    int: calls 0

FxFnProcedureTarget:
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        FxFnProcedureState\calls += 1

# 3. Полное описание void берётся из согласованного результата signature.
# Мы не выдумываем недокументированный литерал void, void: x или int-код void.
# Этот пример зависит от FxKernel-контракта (KERNEL_REQUIREMENTS.md), как и остальные фабрики.
FxFnProcedureExample:
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceSize
        FxFnProcedureState\calls := 0
        @: original FxKernel\signature(subject := FxFnProcedureTarget\run)
        sys\assert(original\hasResult = 0)
        @[]: tokens []
        @: made FxSignatureOperand\make(left := original\resultType; right := tokens)
        @: info FxKernel\signature(subject := made)
        sys\assert(length(info\inputTypes) = 0)
        sys\assert(info\hasResult = 0)
        sys\assert(FxFnProcedureState\calls = 0)
        made@: selected FxFnProcedureTarget\run
        selected()
        sys\assert(FxFnProcedureState\calls = 1)
        return: 1

# 4. Правая группа даёт три старых значения до первой записи.
# Результат должен быть a=2, b=3, c=1, а не последствия последовательных
# чтений уже перезаписанных переменных.
FxGroupRotateExample:
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        int: a 1
        int: b 2
        int: c 3
        (a b c) := (b c a)
        sys\assert(a = 2)
        sys\assert(b = 3)
        sys\assert(c = 1)
        return: 1

# Имена полей намеренно не совпадают с именами получателей присваивания.
FxAssignmentSource:
    int: first 4
    int: second 5
    int: third 6

# 5. Сохранённая P0 группа содержит copy(s), а общий механизм потребления
# получает его поля для позиционной записи. Не требуется снимать группу
# при разборе и не разрешается рекурсивно раскрывать произвольные контейнеры.
FxGroupCopyExample:
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        int: a 0
        int: b 0
        int: c 0
        @: s FxAssignmentSource
        (a b c) := (copy(s))
        sys\assert(a = 4)
        sys\assert(b = 5)
        sys\assert(c = 6)
        sys\assert(FxAssignmentSource\first = 4)
        sys\assert(FxAssignmentSource\second = 5)
        sys\assert(FxAssignmentSource\third = 6)
        return: 1

FxFnAndAssignmentExamples:
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceSize
        sys\assert(FxFnReadyCodesExample\run() = 1)
        sys\assert(FxFnUninitExample\run() = 1)
        sys\assert(FxFnProcedureExample\run() = 1)
        sys\assert(FxGroupRotateExample\run() = 1)
        sys\assert(FxGroupCopyExample\run() = 1)
        return: 1

# Дополнительная приёмка на стороне ядра:
# - инструментировать чтение uninit: ни make, ни normalizeType не читают payload;
# - проверить qualified operand в interpreter/native и всех переходах между ними;
# - обеспечить lifetime материализованных ready int-токенов;
# - повторить операндный пример с прямым ядерным именем signatureTypes и проверить
#   совместимость с FxFnExpectedMixed :: (...);
# - неизвестный код типа отказывает с FxTypeToken, не создавая успешный descriptor;
# - mismatch длины в групповом присваивании обнаруживается до первой записи;
# - присваивание как операнд выражения сохраняет общий variadic right-контракт;
# - группа передаёт только непосредственные поля, без рекурсивного снятия оболочек;
# - для void отдельно отличать отсутствие результата от пустой возвращённой Structure.

# SOURCE: examples/fn_equivalence.lmx
# ВЗАИМОЗАМЕНЯЕМОСТЬ ИМЕНОВАННОЙ И ПОСТРОЕННОЙ ИЗ ТИПОВ СИГНАТУР В ОБОИХ НАПРАВЛЕНИЯХ.
# Это admission/callable-reference fixtures, а не изменение контракта call.
# Существующее отношение Name :: DATA с receiver call остаётся неизменным.
# Передача описания сигнатуры в call не получает новую семантику исполнения.
# Имена формалов специально НЕ p0/p1/p2 и не имена исходного callable.

FxLegacyMixedContract :: (int: amount; double: factor; char[]: suffix; return: double)

FxLegacyProcedureContract :: (int: amount; char[]: suffix)

FxLegacyNullaryContract :: (return: double)

FxFnEquivalenceExamples:
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: empty (copy(()))
        private: @: originalInfo FxKernel\signature(subject := FxMixedTarget\evaluate)
        private: @: tokenContract FxSignatureOperand\make(left := originalInfo\resultType; right := originalInfo\inputTypes)
        # Новое fn-требование принимает callable с прежним именованным DATA.
        private: tokenContract@: acceptsNamed FxMixedTarget\evaluate
        sys\assert(acceptsNamed(p0 := 2; p1 := 1.5; p2 := "abc") = 6.0)
        # Именованная сигнатура принимает callable, созданный общим type builder.
        private: @: generated FxPartial\partial(FxMixedTarget\evaluate; prefix := empty)
        private: FxLegacyMixedContract@: acceptsGenerated generated
        sys\assert(acceptsGenerated(amount := 2; factor := 1.5; suffix := "abc") = 6.0)
        # Оба описания передаются одному общему introspection/construction API.
        private: @: legacyInfo FxKernel\signature(subject := FxLegacyMixedContract)
        private: @: tokenInfo FxKernel\signature(subject := tokenContract)
        sys\assert(length(legacyInfo\inputTypes) = length(tokenInfo\inputTypes))
        sys\assert(legacyInfo\hasResult = tokenInfo\hasResult)
        private: tokenContract@: generatedForToken generated
        sys\assert(generatedForToken(p0 := 1; p1 := 2.0; p2 := "x") = 3.0)
        # void остаётся отсутствием return, не @0, int0 или пустой Structure.
        private: @: procedureInfo FxKernel\signature(subject := FxProcedureTarget\run)
        private: @: procedureType FxSignatureOperand\make(left := procedureInfo\resultType; right := procedureInfo\inputTypes)
        private: procedureType@: newAcceptsOldProcedure FxProcedureTarget\run
        private: @: generatedProcedure FxPartial\partial(FxProcedureTarget\run; prefix := empty)
        private: FxLegacyProcedureContract@: oldAcceptsNewProcedure generatedProcedure
        private: int: before FxGenericCounter\calls
        newAcceptsOldProcedure(p0 := 2; p1 := "x")
        oldAcceptsNewProcedure(amount := 3; suffix := "xy")
        sys\assert(FxGenericCounter\calls = before + 8)
        # Нулевая арность не подменяется одним фиктивным void-параметром.
        private: @: nullaryInfo FxKernel\signature(subject := FxNullaryTarget\value)
        private: @: nullaryType FxSignatureOperand\make(left := nullaryInfo\resultType; right := empty)
        private: nullaryType@: typedNullary FxNullaryTarget\value
        private: @: generatedNullary FxPartial\partial(FxNullaryTarget\value; prefix := empty)
        private: FxLegacyNullaryContract@: legacyNullary generatedNullary
        sys\assert(typedNullary() = 2.5)
        sys\assert(legacyNullary() = 2.5)
        return: 1

# Дополнительная обязательная приёмка ядра (не притворяется выполненной):
# 1. requirements с разными full reference/array models должны различаться.
# 2. параметры с разными именами/defaults, но теми же полными типами совместимы.
# 3. normalizeType для uninit:T читает только tag; existing ready int содержит код.
# 4. несовместимое число, порядок или тип входов отклоняются в обоих направлениях.
# 5. несовместимое hasResult/R отклоняется в обоих направлениях.
# 6. существующий corpus Name :: DATA + call прогоняется без изменения ожиданий.
# 7. ни signature, ни satisfies не исполняют candidate/default/test/converter.

# SOURCE: examples/value_generic_examples.lmx
# ПРИМЕРЫ: int В ДАННЫХ ТЕСТА НЕ ОГРАНИЧИВАЕТ РЕАЛИЗАЦИИ.
# Сами коллекции, Maybe, Bounce и wrappers хранят type/value записи.

FxTextLength:
    private: char[]: value
    return: int
    measure:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxLazyCycle
            FxRecordArity
            FxTypeToken
        return: length(value)

FxDoubleStep:
    private: double: value
    return: double
    increase:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxLazyCycle
            FxRecordArity
            FxTypeToken
        return: value + 0.5

FxStringMaybe:
    private: char[]: value
    return: @
    accept:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxLazyCycle
            FxRecordArity
            FxTypeToken
        if: length(value) = 0
            return: FxNone\none()
        return: FxSome\some(value := (value FxRecordOperands\record))

FxValueGenericExamples:
    return: int
    run:
        throws:
            FxArity
            FxCallFailure
            FxIndex
            FxKernelFailure
            FxLazyCycle
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: textSizes FxMap\map(items := ("a"; "abcd"); transform := FxTextLength\measure)
        sys\assert(\textSizes[0] = 1 && \textSizes[1] = 4)
        private: @: doubles FxMap\map(items := (1.5; 2.5); transform := FxDoubleStep\increase)
        sys\assert(\doubles[0] = 2.0 && \doubles[1] = 3.0)
        private: @: maybe FxSome\some(value := ("abc" FxRecordOperands\record))
        private: @: bound FxBind\bind(maybe; FxStringMaybe\accept)
        private: char[]: text \bound\value
        sys\assert(bound\present = 1 && length(text) = 3)
        private: @: absent FxBind\bind(FxNone\none(); FxStringMaybe\accept)
        sys\assert(absent\present = 0)
        private: @: terminal FxDone\done(value := ("answer" FxRecordOperands\record))
        private: @: terminalRecord FxTrampoline\trampoline(current := terminal)
        private: char[]: terminalText \terminalRecord
        sys\assert(length(terminalText) = 6)
        private: @: lazyValue FxLazy\lazy(operation := FxNullaryTarget\value)
        private: int: before FxGenericCounter\calls
        sys\assert(lazyValue() = 2.5)
        sys\assert(lazyValue() = 2.5)
        sys\assert(FxGenericCounter\calls = before + 1)
        private: @: mixed (2; "abc"; 1.5)
        private: @: selected RxSelect\select(mixed; (2; 0))
        sys\assert(\selected[0] = 1.5 && \selected[1] = 2)
        return: 1

# SOURCE: examples/sequence_examples.lmx
# PREPARED SOURCE FIXTURES. No LMX runtime was available when these were added.
# The assertion literals below are examples, not implementation type limits.

FxSeqProbeEqualInts:
    private:
        @: actual
        @: expected
    required: actual expected
    check:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceElement
        sys\assert(length(actual) = length(expected))
        private: int: i 0
        while: i < length(expected)
            private: int: a FxSeqInteger\read(FxSeqRead\read(actual; i))
            private: int: b FxSeqInteger\read(FxSeqRead\read(expected; i))
            sys\assert(a = b)
            i += 1

FxSeqProbeScale:
    int: value
    int: factor 3
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        return: value * factor

FxSeqProbeSubtract:
    int: accumulated
    int: value
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        return: accumulated - value

FxSeqProbeLog:
    int: calls 0

FxSeqProbeOdd:
    int: value
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        FxSeqProbeLog\calls += 1
        return: value % 2 != 0

FxSeqProbeBelowFive:
    int: value
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        FxSeqProbeLog\calls += 1
        return: value < 5

FxSeqProbeDuplicate:
    int: value
    return: @
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        return: (int[]: [value value])

FxSeqProbeKey:
    int: value
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        return: value % 2

FxSeqProbeSameKey:
    int: first
    int: second
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        return: first = second

FxSeqProbeSome:
    int: value
    return: @
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        return: FxSome\some(value := (value FxRecordOperands\record))

FxSeqProbeNumeric:
    return: int
    run:
        throws:
            FxArity
            FxCallFailure
            FxIndex
            FxKernelFailure
            FxPredicate
            FxRecordArity
            FxShape
            FxTypeToken
            ReceiverIndex
            ReceiverPermutation
            SequenceElement
            SequenceSize
            SequenceStep
        private: int[]: input [1 2 3]
        private: @: mapped FxMap\map(input; FxSeqProbeScale\run)
        FxSeqProbeEqualInts\check(mapped; (3; 6; 9))
        sys\assert(sys\typeof(mapped) = @[])
        private: @: filtered FxFilter\filter(input; FxSeqProbeOdd\run)
        FxSeqProbeEqualInts\check(filtered; (1; 3))
        sys\assert(sys\typeof(filtered) = int[])
        private: @: total FxFold\fold(input; (10 FxRecordOperands\record); FxSeqProbeSubtract\run)
        sys\assert(\total = 4)
        private: @: states FxScan\scan(input; (10 FxRecordOperands\record); FxSeqProbeSubtract\run)
        FxSeqProbeEqualInts\check(states; (10; 9; 7; 4))
        private: @: positions FxSeqRange\range(1; 7; 2)
        FxSeqProbeEqualInts\check(positions; (1; 3; 5))
        FxSeqProbeEqualInts\check(FxSeqRange\range(5; 0; -2); (5; 3; 1))
        sys\assert(length(FxSeqRange\range(2; 2)) = 0)
        FxSeqProbeEqualInts\check(FxSeqSlice\slice(input; 1; 3); (2; 3))
        FxSeqProbeEqualInts\check(FxSeqReverse\reverse(input); (3; 2; 1))
        FxSeqProbeEqualInts\check(FxSeqSelect\select(input; (2; 0; 2)); (3; 1; 3))
        FxSeqProbeEqualInts\check(FxSeqOmit\omit(input; (1; 1)); (1; 3))
        FxSeqProbeEqualInts\check(FxSeqReorder\reorder(input; (2; 0; 1)); (3; 1; 2))
        FxSeqProbeEqualInts\check(FxSeqCompress\compress(input; (0; -2; 1)); (2; 3))
        private: @: denseConcat FxSeqConcat\concat(parts := (input; (int[]: [])))
        sys\assert(sys\typeof(denseConcat) = int[])
        FxSeqProbeEqualInts\check(denseConcat; input)
        private: @: mixedConcat FxSeqConcat\concat(parts := (input; (4; 5)))
        sys\assert(sys\typeof(mixedConcat) = @[])
        FxSeqProbeEqualInts\check(mixedConcat; (1; 2; 3; 4; 5))
        private: @: listed FxSeqList\list(input)
        input[0] := 100
        FxSeqProbeEqualInts\check(listed; (1; 2; 3))
        private: @: flattened FxSeqFlatMap\flatMap((1; 2); FxSeqProbeDuplicate\run)
        FxSeqProbeEqualInts\check(flattened; (1; 1; 2; 2))
        private: @: zipped FxZip\zip(first := (1; 2; 3); second := (10; 20))
        sys\assert(length(zipped) = 2)
        private: FxPair@: pair zipped[1]
        sys\assert(\pair\first = 2 && \pair\second = 20)
        private: @: traversed FxTraverse\traverse((1; 2); FxSeqProbeSome\run)
        sys\assert(traversed\present = 1)
        FxSeqProbeEqualInts\check(traversed\value; (1; 2))
        private: @: groups FxGroupBy\groupBy((1; 2; 3; 4); FxSeqProbeKey\run; FxSeqProbeSameKey\run)
        sys\assert(length(groups) = 2)
        private: FxGroup@: firstGroup groups[0]
        FxSeqProbeEqualInts\check(firstGroup\items; (1; 3))
        private: @: columns FxTranspose\transpose(rows := ((int[]: [1 2]); (3; 4)))
        FxSeqProbeEqualInts\check(columns[0]; (1; 3))
        FxSeqProbeEqualInts\check(columns[1]; (2; 4))
        return: 1

FxSeqProbeQueries:
    return: int
    run:
        throws:
            FxArity
            FxCallFailure
            FxIndex
            FxKernelFailure
            FxPredicate
            FxRecordArity
            FxTypeToken
            ReceiverIndex
        private: int[]: input [2 4 5 8]
        FxSeqProbeLog\calls := 0
        sys\assert(FxSeqAny\any(input; FxSeqProbeOdd\run) = 1)
        sys\assert(FxSeqProbeLog\calls = 3)
        FxSeqProbeLog\calls := 0
        sys\assert(FxSeqAll\all(input; FxSeqProbeBelowFive\run) = 0)
        sys\assert(FxSeqProbeLog\calls = 3)
        FxSeqProbeLog\calls := 0
        private: @: found FxSeqIndex\index(input; FxSeqProbeOdd\run)
        sys\assert(found\present = 1 && \found\value = 2)
        sys\assert(FxSeqProbeLog\calls = 3)
        FxSeqProbeLog\calls := 0
        sys\assert(FxSeqCount\count(input; FxSeqProbeOdd\run) = 1)
        sys\assert(FxSeqProbeLog\calls = 4)
        private: int[]: empty []
        sys\assert(FxSeqAny\any(empty; FxSeqProbeOdd\run) = 0)
        sys\assert(FxSeqAll\all(empty; FxSeqProbeOdd\run) = 1)
        sys\assert(FxSeqCount\count(empty; FxSeqProbeOdd\run) = 0)
        private: @: missing FxSeqIndex\index(empty; FxSeqProbeOdd\run)
        sys\assert(missing\present = 0)
        sys\assert(FxSeqProbeLog\calls = 4)
        private: @: zeroIndex FxSeqIndex\index((1); FxSeqProbeOdd\run)
        sys\assert(zeroIndex\present = 1 && \zeroIndex\value = 0)
        return: 1

FxSeqProbeMutation:
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceElement
            SequenceSize
        private: int[]: values [1 2 3 4]
        private: @: alias values
        private: @: replaced FxSeqReplaceRange\replaceRange(values; 1; 3; (9; 8; 7))
        replaced[0] := 11
        sys\assert(values[0] = 11 && alias[0] = 11)
        replaced[0] := 1
        FxSeqProbeEqualInts\check(values; (1; 9; 8; 7; 4))
        private: @: appended FxSeqAppend\append(values; values)
        appended[0] := 21
        sys\assert(values[0] = 21 && alias[0] = 21)
        appended[0] := 1
        FxSeqProbeEqualInts\check(values; (1; 9; 8; 7; 4; 1; 9; 8; 7; 4))
        FxSeqInsert\insert(values; 0; (10; 20))
        FxSeqDeleteAt\deleteAt(values; 2; 12)
        FxSeqProbeEqualInts\check(values; (10; 20))
        private: int[]: overlap [1 2 3 4]
        FxSeqReplaceRange\replaceRange(overlap; 1; 3; overlap)
        FxSeqProbeEqualInts\check(overlap; (1; 1; 2; 3; 4; 4))
        private: @: nodeValue (int: width 7)
        private: @: source (nodeValue; nodeValue)
        private: @: selected FxSeqSelect\select(source; (1; 0; 1))
        sys\assert(selected[0]\width = 7 && selected[2]\width = 7)
        private: @: other (int: width 9)
        selected[0] := other
        sys\assert(source[0]\width = 7)
        nodeValue\width := 11
        sys\assert(selected[2]\width = 11)
        private: @: copied FxSeqProject\project(source; (0; 1))
        copied[0]\width := 22
        sys\assert(copied[1]\width = 22 && nodeValue\width = 11)
        return: 1

FxSeqProbeSpliceDense:
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceElement
            SequenceSize
        private: int[]: values [1 2 3 4]
        private: @: alias values
        private: @: removed FxSeqSplice\splice(values; 1; 3; (9; 8; 7))
        alias[0] := 10
        sys\assert(values[0] = 10 && length(alias) = 5)
        alias[0] := 1
        sys\assert(sys\typeof(removed) = int[])
        FxSeqProbeEqualInts\check(removed; (2; 3))
        FxSeqProbeEqualInts\check(values; (1; 9; 8; 7; 4))
        removed[0] := 200
        FxSeqProbeEqualInts\check(values; (1; 9; 8; 7; 4))
        values[2] := 80
        FxSeqProbeEqualInts\check(removed; (200; 3))
        # Both inserted and removed values must come from the original target.
        private: int[]: overlap [1 2 3 4]
        private: @: oldMiddle FxSeqSplice\splice(overlap; 1; 3; overlap)
        FxSeqProbeEqualInts\check(oldMiddle; (2; 3))
        FxSeqProbeEqualInts\check(overlap; (1; 1; 2; 3; 4; 4))
        private: char[]: text "abcd"
        private: @: textAlias text
        private: char[]: removedText FxSeqSplice\splice(text; 1; 3; "XY")
        textAlias[0] := 'A'
        sys\assert(text[0] = 'A')
        textAlias[0] := 'a'
        sys\assert(sys\typeof(removedText) = char[])
        sys\assert(length(removedText) = 2 && removedText[0] = 'b' && removedText[1] = 'c')
        sys\assert(length(text) = 4 && text[0] = 'a' && text[1] = 'X' && text[2] = 'Y' && text[3] = 'd')
        removedText[0] := 'z'
        sys\assert(text[1] = 'X')
        return: 1

FxSeqProbeSpliceReferences:
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceElement
            SequenceSize
        private: @: first (int: width 1)
        private: @: second (int: width 2)
        private: @: third (int: width 3)
        private: @: values (first; second; third)
        private: @: alias values
        private: @: removed FxSeqSplice\splice(values; 1; 2; (third; first))
        alias[1] := second
        sys\assert(values[1]\width = 2 && length(alias) = 4)
        alias[1] := third
        sys\assert(sys\typeof(removed) = @[] && length(removed) = 1)
        sys\assert(removed[0]\width = 2)
        sys\assert(length(values) = 4 && values[0]\width = 1 && values[1]\width = 3 && values[2]\width = 1 && values[3]\width = 3)
        # Referenced objects remain shared; only the outer result slots are new.
        second\width := 20
        sys\assert(removed[0]\width = 20)
        removed[0] := first
        sys\assert(values[1]\width = 3 && values[2]\width = 1)
        private: @: overlap (first; second; third)
        private: @: oldMiddle FxSeqSplice\splice(overlap; 1; 2; overlap)
        sys\assert(length(oldMiddle) = 1 && oldMiddle[0]\width = 20)
        sys\assert(length(overlap) = 5 && overlap[0]\width = 1 && overlap[1]\width = 1 && overlap[2]\width = 20 && overlap[3]\width = 3 && overlap[4]\width = 3)
        second\width := 21
        sys\assert(oldMiddle[0]\width = 21 && overlap[2]\width = 21)
        return: 1

FxSeqProbeSpliceTypedReferences:
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceElement
            SequenceSize
        private: int: first 10
        private: int: second 20
        private: int: third 30
        private: int@: firstRef @first
        private: int@: secondRef @second
        private: int@: thirdRef @third
        private: int@[]: values [firstRef secondRef thirdRef]
        private: int@[]: inserted [firstRef]
        private: int@[]: removed FxSeqSplice\splice(values; 1; 2; inserted)
        sys\assert(sys\typeof(removed) = int@[])
        sys\assert(length(removed) = 1 && \removed[0] = 20)
        sys\assert(length(values) = 3 && \values[0] = 10 && \values[1] = 10 && \values[2] = 30)
        second := 21
        sys\assert(\removed[0] = 21)
        removed[0] := thirdRef
        sys\assert(\values[1] = 10)
        return: 1

FxSeqProbeSpliceEmpty:
    return: int
