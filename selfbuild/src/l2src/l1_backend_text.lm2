fn: l1_hdr_fnptr_parts (const: (@: frame c.LmP0Frame); @@: name_out c.LmP0Node; @@: params_out c.LmP0Node; @@: ret_out c.LmP0Node) int
    @: field c.LmP0Field
    if: frame = 0 || frame\body = 0 || name_out = 0 || params_out = 0 || ret_out = 0
