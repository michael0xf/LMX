+    out\cap: capacity
+    out\owned: 0
+    memcpy(steps, source\steps, (cast: (size_t) source\n) * c.sizeof(c.L2PathStep))
+return: 0
+
+# Representation dispatch reads the resolved step verdict, not the source
+# spelling, root name or candidate graph. A physical machine address is not
