---
    Observed:
        int: direct_result 12
        int: wrapped_result 12
    end: Observed
---
fn: (:= name direct) (:= args ((int x))) (:= return int) (:= data ((int bias 7))) (:= code ((return (x + bias))))
fn: ((name wrapped) (args ((int x))) (return int) (data ((int bias 7))) (code ((return (x + bias)))))
int: direct_result (direct 5)
int: wrapped_result (wrapped 5)
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ direct_result) direct_result
    :=: ((shared \ Observed) \ wrapped_result) wrapped_result
end: main
main:
