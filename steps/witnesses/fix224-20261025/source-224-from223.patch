new file mode 100644
--- /dev/null
+++ b/dev/l2src_sandbox/p0_scan.lm2
@@ -0,0 +1,235 @@
+# P0 compact-token scanners through the existing machine C ABI.
+predef: "l1src/p0.h.lm1"
+predef: "l2src/p0_text.h.lm1"
+include: "<ctype.h>"
+
+fn: lm_p0_scan_registry_compact_atom_piece (const: (@: text char); size_t: end_index; size_t: start) size_t
+    size_t: best 0U
+    if: start >= end_index
+        return: start
+    if: start + 1U >= end_index
+        return: start + 1U
+    if: text[start] = 33 && text[start + 1U] = 61
+        best: 2U
+    if: text[start] = 60 && text[start + 1U] = 61
+        best: 2U
+    if: text[start] = 62 && text[start + 1U] = 61
+        best: 2U
+    if: text[start] = 38 && text[start + 1U] = 38
+        best: 2U
+    if: text[start] = 124 && text[start + 1U] = 124
+        best: 2U
+    if: text[start] = 43 && text[start + 1U] = 43
+        best: 2U
+    if: text[start] = 45 && text[start + 1U] = 45
+        best: 2U
+    if: text[start] = 91 && text[start + 1U] = 93
+        best: 2U
+    if: text[start] = 60 && text[start + 1U] = 60
+        best: 2U
+    if: text[start] = 62 && text[start + 1U] = 62
+        best: 2U
+    if: best > 0U
+        return: start + best
+    return: start + 1U
+end: lm_p0_scan_registry_compact_atom_piece
+
+fn: lm_p0_is_bare_identifier_start (char: character) int
+    return: c.isalpha((cast: (c.uchar) character)) || character = '_'
+end: lm_p0_is_bare_identifier_start
+
+fn: lm_p0_is_bare_identifier_rest (char: character) int
+    return: c.isalnum((cast: (c.uchar) character)) || character = '_'
+end: lm_p0_is_bare_identifier_rest
+
+fn: lm_p0_is_hex_digit (char: character) int
+    return: c.isxdigit((cast: (c.uchar) character)) != 0
+end: lm_p0_is_hex_digit
+
+fn: lm_p0_scan_number_token (const: (@: text char); size_t: end_index; size_t: start; @: out_end size_t) int
+    size_t: i start
+    int: saw_digit 0
+    size_t: hex_exponent_start 0U
+    size_t: decimal_exponent_start 0U
+    if: i < end_index && (text[i] = '+' || text[i] = '-')
+        if: i + 1U < end_index && c.lm_p0_is_decimal_digit(text[i + 1U])
+            i: i + 1U
+        else:
+            out_end[0]: start
+            return: 0
+        ---
+    if: i + 1U < end_index && text[i] = '0' && (text[i + 1U] = 'x' || text[i + 1U] = 'X')
+        i: i + 2U
+        while: i < end_index && lm_p0_is_hex_digit(text[i])
+            saw_digit: 1
+            i: i + 1U
+        if: i < end_index && text[i] = '.'
+            i: i + 1U
+            while: i < end_index && lm_p0_is_hex_digit(text[i])
+                saw_digit: 1
+                i: i + 1U
+            ---
+        if: saw_digit && i < end_index && (text[i] = 'p' || text[i] = 'P')
+            hex_exponent_start: i
+            i: i + 1U
+            if: i < end_index && (text[i] = '+' || text[i] = '-')
+                i: i + 1U
+            if: i < end_index && c.lm_p0_is_decimal_digit(text[i])
+                while: i < end_index && c.lm_p0_is_decimal_digit(text[i])
+                    i: i + 1U
+                ---
+            else:
+                i: hex_exponent_start
+            ---
+        while: i < end_index && lm_p0_is_bare_identifier_rest(text[i])
+            i: i + 1U
+        if: saw_digit
+            out_end[0]: i
+        else:
+            out_end[0]: start + 1U
+        ---
+        return: 1
+    while: i < end_index && c.lm_p0_is_decimal_digit(text[i])
+        saw_digit: 1
+        i: i + 1U
+    if: i < end_index && text[i] = '.'
+        i: i + 1U
+        while: i < end_index && c.lm_p0_is_decimal_digit(text[i])
+            saw_digit: 1
+            i: i + 1U
+        ---
+    if: saw_digit && i < end_index && (text[i] = 'e' || text[i] = 'E')
+        decimal_exponent_start: i
+        i: i + 1U
+        if: i < end_index && (text[i] = '+' || text[i] = '-')
+            i: i + 1U
+        if: i < end_index && c.lm_p0_is_decimal_digit(text[i])
+            while: i < end_index && c.lm_p0_is_decimal_digit(text[i])
+                i: i + 1U
+            ---
+        else:
+            i: decimal_exponent_start
+        ---
+    while: i < end_index && lm_p0_is_bare_identifier_rest(text[i])
+        i: i + 1U
+    if: saw_digit
+        out_end[0]: i
+    else:
+        out_end[0]: start
+    ---
+    return: saw_digit
+end: lm_p0_scan_number_token
+
+fn: lm_p0_scan_c_quoted_token (const: (@: text char); size_t: end_index; size_t: quote_index) size_t
+    size_t: i 0U
+    char: quote 0
+    size_t: line_break_width 0U
+    if: quote_index >= end_index || (text[quote_index] != '\'' && text[quote_index] != '"')
+        return: quote_index
+    quote: text[quote_index]
+    i: quote_index + 1U
+    while: i < end_index
+        if: text[i] = '\\' && i + 1U < end_index
+            line_break_width: c.lm_p0_line_break_width_at(text, end_index, i + 1U)
+            if: line_break_width > 0U
+                i: i + 1U + line_break_width
+            else:
+                i: i + 2U
+            ---
+            continue
+        if: text[i] = quote
