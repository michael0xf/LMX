# ABI parity guard — L1 port of mixa_process_marker_abi_probe_real.c (ticket 20260918-082421).
# offsetof is a C macro with no L1 spelling (c. pastes a call, not a preprocessor
# name). Field offsets are computed at run time via pointer arithmetic on a local
# store (same pattern as l2src/lmx_message_selftest.lm1). Output format strings
# are kept byte-identical to the C probe so L2-vs-real parity still diffs stdout.
predef: "mixa_manager/mixa_process_marker.h.lm1"
include: "<stdio.h>"

fn: main () int
    MixaProcessMarkerFaultVTable: store0
    @: MixaProcessMarkerFaultVTable p0
    p0: @ store0
    MixaProcessMarkerGen: store1
    @: MixaProcessMarkerGen p1
    p1: @ store1
    MixaProcessMarkerScanner: store2
    @: MixaProcessMarkerScanner p2
    p2: @ store2
    MixaProcessMarkerSink: store3
    @: MixaProcessMarkerSink p3
    p3: @ store3

    c.printf("MixaProcessMarkerFaultVTable sizeof=%zu\n", c.sizeof(c.MixaProcessMarkerFaultVTable))
    c.printf("MixaProcessMarkerFaultVTable on_alloc=%zu\n", (cast: (size_t) @ p0\on_alloc) - (cast: (size_t) p0))
    c.printf("MixaProcessMarkerFaultVTable on_collide=%zu\n", (cast: (size_t) @ p0\on_collide) - (cast: (size_t) p0))
    c.printf("MixaProcessMarkerFaultVTable ctx=%zu\n", (cast: (size_t) @ p0\ctx) - (cast: (size_t) p0))
    c.printf("MixaProcessMarkerGen sizeof=%zu\n", c.sizeof(c.MixaProcessMarkerGen))
    c.printf("MixaProcessMarkerGen counter=%zu\n", (cast: (size_t) @ p1\counter) - (cast: (size_t) p1))
    c.printf("MixaProcessMarkerSink sizeof=%zu\n", c.sizeof(c.MixaProcessMarkerSink))
    c.printf("MixaProcessMarkerSink on_ordinary=%zu\n", (cast: (size_t) @ p3\on_ordinary) - (cast: (size_t) p3))
    c.printf("MixaProcessMarkerSink ctx=%zu\n", (cast: (size_t) @ p3\ctx) - (cast: (size_t) p3))
    c.printf("MixaProcessMarkerScanner sizeof=%zu\n", c.sizeof(c.MixaProcessMarkerScanner))
    c.printf("MixaProcessMarkerScanner marker=%zu\n", (cast: (size_t) @ p2\marker) - (cast: (size_t) p2))
    c.printf("MixaProcessMarkerScanner marker_len=%zu\n", (cast: (size_t) @ p2\marker_len) - (cast: (size_t) p2))
    c.printf("MixaProcessMarkerScanner state=%zu\n", (cast: (size_t) @ p2\state) - (cast: (size_t) p2))
    c.printf("MixaProcessMarkerScanner pending=%zu\n", (cast: (size_t) @ p2\pending) - (cast: (size_t) p2))
    c.printf("MixaProcessMarkerScanner pending_len=%zu\n", (cast: (size_t) @ p2\pending_len) - (cast: (size_t) p2))
    c.printf("MixaProcessMarkerScanner pending_cap=%zu\n", (cast: (size_t) @ p2\pending_cap) - (cast: (size_t) p2))
    c.printf("MixaProcessMarkerScanner status_start=%zu\n", (cast: (size_t) @ p2\status_start) - (cast: (size_t) p2))
    c.printf("MixaProcessMarkerScanner tab2_pos=%zu\n", (cast: (size_t) @ p2\tab2_pos) - (cast: (size_t) p2))
    c.printf("MixaProcessMarkerScanner exit_code=%zu\n", (cast: (size_t) @ p2\exit_code) - (cast: (size_t) p2))
    c.printf("MixaProcessMarkerScanner cwd=%zu\n", (cast: (size_t) @ p2\cwd) - (cast: (size_t) p2))
    c.printf("MixaProcessMarkerScanner cwd_len=%zu\n", (cast: (size_t) @ p2\cwd_len) - (cast: (size_t) p2))
    c.printf("MixaProcessMarkerScanner at_line_start=%zu\n", (cast: (size_t) @ p2\at_line_start) - (cast: (size_t) p2))
    c.printf("MixaProcessMarkerScanner fault=%zu\n", (cast: (size_t) @ p2\fault) - (cast: (size_t) p2))
    return: 0

