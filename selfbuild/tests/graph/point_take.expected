---
    Observed:
        int: r 1
    end: Observed
---
sub: main () (
    Point:
        int: y 0
        int: x 0
    end: Point
    int: r 0
)
    fn: take (@: p Point; int: q) int
        return: (((p \ y) * 10) + q)
    end: take
    :=: (data \ r) (take Point 1)
end: main
main:
int: r ((main \ data) \ r)
sub: observe ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ r) r
end: observe
observe:
