    if: c.fprintf(out_cell[0], "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: %s(l2_program_arena, lmx_range_profile(l2_program_arena, (cast: (@: void) l2_entry_slot)))\n        if: l2_entry_slot[0] = 0\n            return: 1\n        if: %s(l2_entry_slot[0], %s) != 0\n            return: 1\n", k, (cast: (unsigned) oi), newf, store, lit) < 0
