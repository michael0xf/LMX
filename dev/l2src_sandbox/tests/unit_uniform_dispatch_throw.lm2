# The same copied-occurrence tap returns status 1, payload 91 and a deliberately
# unrelated numeric destination 999. Caller/root remain native.
Holder:
    fn: target
end: Holder
fn: target (int: n; char: letter; size_t: wide; @: int p) int
    throws: Oops
return: n + hidden
fn: walked () int
return: 37
fn: effect (@: int count) int
    \count: \count + 1
return: 23
fn: caller () int
    int: hidden 17
    int: count 0
    int: cell 41
    @: int calls @count
    @: int p @cell
    int: caught 0
    int: a 11
    int: b 22
    int: c 33
    if: 1
        a: Holder\target(effect(calls), 'Q', 4294967303U, p)
        catch: Oops (int: payload)
            caught: caught + payload
    ---
    if: 1
        b: Holder\target(effect(calls), 'Q', 4294967303U, p)
        catch: Oops (int: payload)
            caught: caught + payload
    ---
    if: 1
        c: Holder\target(effect(calls), 'Q', 4294967303U, p)
        catch: Oops (int: payload)
            caught: caught + payload
    ---
    int: d walked()
    int: bad 0
    if: caught != 273 || a != 11 || b != 22 || c != 33 || \calls != 3
        bad: bad + 1
    if: d != 73
        bad: bad + 2
    if: bad != 0
        return: 80 + bad
return: 7
sendMessage: exit(exit_code: caller(); stdout: ""; stderr: "")
return
