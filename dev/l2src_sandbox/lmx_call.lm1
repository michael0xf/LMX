predef: "l2src/lmx_call.h.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l2src/lmx_implements.h.lm1"

# lmx_call.lm1 - the call.  Every check here is the domain question, and the call itself is one
# cast: the METHOD's `addr` is a typed entry, and the shape this unit names is the
# zero-source-argument one.  child[0] must be an LmxCallable descriptor; its address range
# selects the descriptor-backed `(node,self)` ABI.  A generated body WITH source arguments is
# called by generated code, which knows the signature it emitted; this unit is what a runtime
# calls when it holds a Structure and must find out whether it can call it at all.

fn: lmx_call_ready (@: LmxArena arena; @: Lmx callable) int
    @: void target
    if: arena = 0 || callable = 0
        return: c.LMX_CALL_NOT_CALLABLE
    if: lmx_domain_kind(arena, (cast: (@: void) callable)) != c.LMX_KIND_STRUCT
        return: c.LMX_CALL_NOT_CALLABLE
    # A callable with no slot has nothing to hold its method; a structure whose len is 0 is a
    # value, not an occurrence of a callable.
    if: callable\len < 1
        return: c.LMX_CALL_NOT_CALLABLE
    ---
    target: lmx_arena_ref_value(callable, 0U)
    if: target = 0
        return: c.LMX_CALL_NOT_CALLABLE
    # Descriptor-only: child[0] is LmxCallable. A bare METHOD is not a callable occurrence.
    if: lmx_domain_kind(arena, target) != c.LMX_DOMAIN_KIND_CALLABLE
        return: c.LMX_CALL_NOT_CALLABLE
    ---
return: c.LMX_CALL_OK

fn: lmx_callable_offset (@: LmxArena arena; @: Lmx occurrence) size_t
    @: void target
    @: LmxCallable info
    int: kind
    if: arena = 0 || occurrence = 0
        return: (cast: (size_t) -1)
    if: occurrence\len < 1
        return: (cast: (size_t) -1)
    ---
    target: lmx_arena_ref_value(occurrence, 0U)
    if: target = 0
        return: (cast: (size_t) -1)
    ---
    # child[0] present: classify in the arena of the occurrence's own fields.
    # A positive non-CALLABLE in that arena is not a callable occurrence --
    # refuse with the same sentinel so missing and not-callable never look like
    # offset 0. LMX_KIND_NONE means this arena does not index the pointer
    # (shared descriptor after plain copy / offset-0 merge first-operand keep);
    # cast as for a foreign CALLABLE -- the occurrence arena cannot say otherwise.
    kind: lmx_domain_kind(arena, target)
    if: kind != c.LMX_KIND_NONE && kind != c.LMX_DOMAIN_KIND_CALLABLE
        return: (cast: (size_t) -1)
    ---
    info: (cast: (@: LmxCallable) target)
return: info\offset

fn: lmx_call_method (@: LmxArena arena; @: Lmx callable) @: LmxMethod
    @: void target
    @: LmxCallable info
    if: lmx_call_ready(arena, callable) != c.LMX_CALL_OK
        return: 0
    target: lmx_arena_ref_value(callable, 0U)
    info: (cast: (@: LmxCallable) target)
    if: info = 0
        return: 0
return: info\method

fn: lmx_call_node (@: Lmx callable) @: Lmx
    if: callable = 0
        return: 0
return: callable\parent

fn: lmx_call_callable (@: LmxArena arena; @: Lmx node) @: LmxCallable
    @: void target
    if: lmx_call_ready(arena, node) != c.LMX_CALL_OK
        return: 0
    target: lmx_arena_ref_value(node, 0U)
    if: lmx_domain_kind(arena, target) != c.LMX_DOMAIN_KIND_CALLABLE
        return: 0
return: (cast: (@: LmxCallable) target)

fn: lmx_call0 (@: LmxArena arena; @: Lmx callable) int
    @: void target
    @: LmxCallable info
    LmxCallEntrySelf: self_entry
    LmxEntry: addr
    if: lmx_call_ready(arena, callable) != c.LMX_CALL_OK
        return: c.LMX_CALL_NOT_CALLABLE
    target: lmx_arena_ref_value(callable, 0U)
    info: (cast: (@: LmxCallable) target)
    addr: 0
    if: info != 0 && info\method != 0
        addr: info\method\addr
    ---
    if: addr = 0
        return: c.LMX_CALL_NOT_CALLABLE
    ---
    self_entry: (cast: (LmxCallEntrySelf) addr)
return: self_entry(lmx_call_node(callable), callable)
