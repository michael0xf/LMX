---
    Observed:
        int: fields 2
        int: untouched 7
    end: Observed
---
S:
    int: a[ 7
end: S
Box:
    int: seed 0
    S\`a[`(9)
end: Box
int: fields (length Box)
int: untouched (S \ `a[`)
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ fields) fields
    :=: ((shared \ Observed) \ untouched) untouched
end: main
main:
