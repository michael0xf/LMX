-            return: c.LMX_IMPLEMENTS_UNKNOWN
-        source: lmx_graph_node_in(arena, lmx_graph_value_in(arena, context, 0U))
-        source_references: lmx_graph_node_in(arena, lmx_graph_value_in(arena, context, 1U))
-        if: source = 0 || source_references = 0
+    if: source != 0 || source_references != 0
+        if: source = 0 || source_references = 0 || lmx_graph_node_in(arena, (cast: (@: void) source)) = 0 || lmx_graph_node_in(arena, (cast: (@: void) source_references)) = 0
