            private: int: before length(out)
            private: int: added length(part)
            private: int: after FxSeqSize\sum(before; added; info\maxLength)
            sys\resize(out; after)
            private: int: j 0
            while: j < added
                out[before + j] := FxSeqRead\read(part; j)
                j += 1
            i += 1
        return: out

# SOURCE: src/sequences.lmx
# New ordinary receivers. Public names are wired in public.lmx, not registered
# as ad-hoc Expression operators. All intervals are zero-based and half-open.

FxSeqRange:
    private:
        int: start
        int: stop
        int: step 1
    required: start stop
    return: @
    range:
        throws:
            FxKernelFailure
            FxTypeToken
            SequenceSize
            SequenceStep
        if: step = 0
            throw: SequenceStep()
        private: @: out FxSeqAllocate\make(int[]; 0)
        if: step > 0 && start >= stop
            return: out
        if: step < 0 && start <= stop
            return: out
        # Use the existing exact-integer numeric profile only for preflight.
        # This handles MIN_INT/-1 and ranges spanning both signs without a
        # wrapped subtraction, fixed word width, or an overflowing abs(step).
        private: bigint: first start
        private: bigint: last stop
        private: bigint: stride step
        private: bigint: distance last - first
        if: stride < 0
            distance := first - last
            stride := -stride
        private: bigint: wideCount (distance - 1) / stride + 1
        private: @: info FxSeqInfo\get(out)
        if: wideCount > info\maxLength
            throw: SequenceSize()
        private: int: count wideCount
        sys\resize(out; count)
        private: int: current start
        private: int: i 0
        while: i < count
            out[i] := current
            i += 1
            # Do not compute the nonexistent value after the final element.
            if: i < count
                current += step
        ---
        return: out

FxSeqSlice:
    private:
        @: source
        int: begin
        int: end
    required: source begin end
    return: @
    slice:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: int: count FxSeqBounds\count(source; begin; end)
        private: @: info FxSeqInfo\get(source)
        private: @: out FxSeqAllocate\make(info\arrayType; count)
        private: int: i 0
        while: i < count
            private: @: value FxSeqRead\read(source; begin + i)
            FxKernel\arrayWrite(target := out; index := i; value := value)
            i += 1
        return: out

FxSeqReverse:
    private: @: source
    required: source
    return: @
    reverse:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
