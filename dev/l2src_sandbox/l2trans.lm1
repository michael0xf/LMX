        if: l2_rw_source_node(stmt, into, "LMX_WALK_OP_SOURCE_MACHINE", @ node) != 0 || l2_rw_put(into, slot, node) != 0
            return: 1
        \made: 1
        return: 0
    if: l2_text_eq(h, "if")
