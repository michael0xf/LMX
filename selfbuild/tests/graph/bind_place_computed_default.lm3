# A computed default replaced by an actual, or not used, does not run (the book, #binding-autofill, #callable-observations).
(
    Observed:
        int: ticks 0
        int: seen 0
        int: unused 0
)
fn: tick () int
    @: shared node[0]
    shared\Observed\ticks := shared\Observed\ticks + 1
    return: 40
fn: callee (int: x tick()) int
    return: x
fn: idle (int: x tick()) int
    return: 1
sub: main ()
    @: shared node[0]
    shared\Observed\seen := callee(3)
    shared\Observed\unused := idle()
main()
