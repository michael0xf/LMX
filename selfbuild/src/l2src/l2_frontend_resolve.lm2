            locus: 6
        ---
        if: bh >= 0
            slot: lm_compiler_for_own_seg(bh, pd, off, len, @ kind, @ ent)
            field_own: slot
            locus: 3
        ---
        if: bm >= 0
            if: part_scope >= 0
                slot: lm_compiler_method_part_own_seg(bm, part_scope, pd, off, len, @ kind, @ ent)
                field_own: slot
                locus: 3
            else:
                selected_part: c.lm_compiler_method_part_seg(bm, pd, off, len, @ part_scope)
                if: selected_part >= 0
                    slot: selected_part
                    kind: 12
                    ent: bm
                    locus: 5
                else:
                    slot: lm_compiler_own_seg_scan(bm, 0, pd, off, len, @ kind, @ ent)
                    field_own: slot
                    locus: 3
                ---
            ---
        ---
        # A body of the host: an inline nested Structure (kind 2), the next name that body's.
        if: slot < 0 && bh >= 0
            nb: c.lm_compiler_body_seg(for_mi_cell[0][bh], bh, pd, off, len, cur_mi_cell[0])
        if: slot < 0 && bm >= 0 && part_scope < 0
            nb: c.lm_compiler_body_seg(bm, 0 - 1, pd, off, len, cur_mi_cell[0])
        if: nb >= 0
            slot: nb
            kind: 2
            ent: 0 - 1
            locus: 4
        ---
        nsroute: 0
        if: res < 0 && bh < 0 && bm < 0 && (i > 1 || root_kind = 0 || root_kind = 4)
            nsroute: 1
        if: nsroute != 0 && ni < 0
            return: (cast: (int) (c.lm_compiler_path_fail(out, k + 1, 3)))
        if: nsroute != 0 && ni >= 0
