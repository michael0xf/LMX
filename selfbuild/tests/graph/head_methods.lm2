# The selector is a formed call, while both written groups remain values.
@: Holder (
    fn: calc (int: value 0) int (int: calls 0)
        calls := calls + 1
        return: value + calls
)
call(Holder)
(Holder\calc)
(Holder\calc())
int: quiet Holder\calc\data\calls
int: first Holder\calc(4)
int: empty Holder\calc()
int: named Holder\calc(value := 7)
int: calls Holder\calc\data\calls
