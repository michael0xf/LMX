        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) = 0 && raw = 0 && rf = 2 && rj < l2_m_arity[mi] && c.fprintf(l2_out, "%sl2_p%d_%d\\columns: %s\n", ind, mi, rj, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) = 0 && raw = 0 && rf = 3 && rj < l2_m_arity[mi] && c.fprintf(l2_out, "%sl2_p%d_%d\\count: %s\n", ind, mi, rj, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) = 0 && raw = 0 && rf = 4 && rj < l2_m_arity[mi] && c.fprintf(l2_out, "%sl2_p%d_%d\\capacity: %s\n", ind, mi, rj, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) = 0 && raw = 0 && rf = 5 && rj < l2_m_arity[mi] && c.fprintf(l2_out, "%sl2_p%d_%d\\%.*s: %s\n", ind, mi, rj, (cast: (int) (fr\head\length - l2_fn(mi, rj)\length - 1U)), fr\head\data + l2_fn(mi, rj)\length + 1U, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) = 0 && raw = 0 && rf = 5 && rj >= l2_m_arity[mi] + l2_m_sn[mi] && c.fprintf(l2_out, "%s%.*s: %s\n", ind, (cast: (int) fr\head\length), fr\head\data, l2_tok) < 0
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) = 0 && raw = 0
            field: l2_next_active(field\next)
        # node/for's own single-hop write emission (l2_slash_own/l2_slash_for)
        # is removed (FABLE-SONNET-NODE-ROOT-20260923-121): the FIELD PATHS
        # branch above now claims every node/for-rooted write first (l2_is_
        # path_head recognizes them as ordinary roots), so the sl-based block
        # this used to be is gone. What remains is the general backstop: an
        # assignment target that resolved to none of own/slot/formal/call/
        # known/raw-dispatch by the time emission reaches it. l2_check_body
        # already refuses an unresolvable assignment target with a location
        # ("assignment target must be a declared typed mutable value") before
        # emission runs at all -- undeclared and declared-below both measured
        # refused there (FABLE-SONNET-UNIT-FIELD-WRITE-20260923-129). This was
        # a SILENT return: 1 regardless, reachable the moment check-time and
        # emit-time own-field lookup ever disagree (exactly what happened
        # here: l2_own_find_last lacked the same unit-field fallback
        # l2_own_find already had, so a name check_body accepted -- a
        # backward-visible unit field -- still fell all the way through
        # emission unresolved). Translation must never fail without a
        # located diagnostic; this is the same one check_body already gives,
        # as a backstop, not a new rule.
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && fi < 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) = 0 && l2_is_known(fr\head) = 0 && raw != 0
            return: l2_error(l2_src, stmt, "assignment target must be a declared typed mutable value")
        ---
    # A body ending in an if/else can leave the last emitted line multiple
    # levels deeper than its caller's next statement. Source cutters need
    # not be frame trailers, so close this body explicitly before returning
    # to the caller. This is L1 structure only; no loop action.
    if: need_cut != 0 && c.fprintf(l2_out, "%s---\n", ind) < 0
        return: 1
return: 0

# A fresh typed cell for own row oi into `<slot>[0]`, at indent `ind`: the builder's cells, and a
# fresh instance's (-189).  A char is the interned cell `chr0` names; every other type gets a new
# cell, checked, with `fail` (and `fail2`, a second line) when it could not be made.  A type with
# no cell emits nothing, as the builder never did.
# A fresh typed cell of own storage type ty into `slot`[0] (an Array of n elements), with `fail`
# (and `fail2`) when it cannot be made: the one typed-cell emission, for an own field and a header
# part alike.
fn: l2_emit_cell_new_ty (int: ty; size_t: n; const: @(char ind); const: @(char slot); const: @(char chr0); const: @(char fail); const: @(char fail2)) int
    if: ty = 1
        return: (cast: (int) (c.fprintf(l2_out, "%s%s[0]: %s\n", ind, slot, chr0) < 0))
    if: ty = 2 && c.fprintf(l2_out, "%s%s[0]: lmx_size_new_owned(l2_program_arena)\n", ind, slot) < 0
        return: 1
    if: ty = 0 && c.fprintf(l2_out, "%s%s[0]: lmx_int_new_owned(l2_program_arena)\n", ind, slot) < 0
        return: 1
    if: ty = 3 && c.fprintf(l2_out, "%s%s[0]: lmx_unsigned_new_owned(l2_program_arena)\n", ind, slot) < 0
        return: 1
    if: ty = 36 && c.fprintf(l2_out, "%s%s[0]: lmx_ulong_new_owned(l2_program_arena)\n", ind, slot) < 0
        return: 1
    if: l2_own_is_pointer(ty) != 0 && c.fprintf(l2_out, "%s%s[0]: lmx_pointer_new_owned(c.LMX_TYPE_POINTER_BASE + %d, l2_program_arena)\n", ind, slot, ty - 1000) < 0
        return: 1
    if: ty = 4 && c.fprintf(l2_out, "%s%s[0]: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_INT, %zuU, l2_program_arena)\n", ind, slot, n) < 0
        return: 1
    if: ty = 5 && c.fprintf(l2_out, "%s%s[0]: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_CHAR, %zuU, l2_program_arena)\n", ind, slot, n) < 0
        return: 1
    if: ty = 7 && c.fprintf(l2_out, "%s%s[0]: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_SIZE_T, %zuU, l2_program_arena)\n", ind, slot, n) < 0
        return: 1
    if: ty = 37 && c.fprintf(l2_out, "%s%s[0]: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_ULONG, %zuU, l2_program_arena)\n", ind, slot, n) < 0
        return: 1
    if: ty = 8 && c.fprintf(l2_out, "%s%s[0]: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_UNSIGNED_CHAR, %zuU, l2_program_arena)\n", ind, slot, n) < 0
        return: 1
    if: ty >= 2000 && c.fprintf(l2_out, "%s%s[0]: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_POINTER_BASE + %d, %zuU, l2_program_arena)\n", ind, slot, ty - 2000, n) < 0
        return: 1
    if: ty != 0 && ty != 2 && ty != 3 && ty != 36 && l2_own_is_pointer(ty) = 0 && l2_own_is_array(ty) = 0
        return: 0
    if: c.fprintf(l2_out, "%sif: %s[0] = 0\n%s    %s\n", ind, slot, ind, fail) < 0
        return: 1
    if: fail2 != 0 && c.fprintf(l2_out, "%s    %s\n", ind, fail2) < 0
        return: 1
return: 0

# Own field oi's cell: an own Structure field is a direct slot, empty until it is bound (-189
# c3b-3): no cell; an Array has its declared length.
fn: l2_emit_cell_new (int: oi; const: @(char ind); const: @(char slot); const: @(char chr0); const: @(char fail); const: @(char fail2)) int
    size_t: n 0U
    if: l2_own_is_slot(oi) != 0
        return: 0
    if: l2_own_is_array(l2_own_ty[oi]) != 0
        n: l2_literal_value(l2_own_count[oi])
return: l2_emit_cell_new_ty(l2_own_ty[oi], n, ind, slot, chr0, fail, fail2)

# The own storage type of method mi's result cell in its `return` part, or -1 for no cell: a
# number by the trampoline's class, a pointer by its return code (the table of l2_emit_sig).
fn: l2_ret_cell_ty (int: mi) int
    int: rt l2_sig_ret(mi)
    int: cls l2_tramp_class(mi)
    int: fi rt - 100
    if: cls = 1
        return: 0
    if: cls = 2
        return: 2
    if: cls = 3
        return: 3
    if: cls = 4
        return: 36
    if: rt = 3
        return: 1012
    if: rt = 16
        return: 1016
    if: rt = 35
        return: 1003
    if: rt = 32
        return: 1017
    if: rt >= 100 && fi < l2_foreign_n && l2_foreign_depth[fi] > 0
        return: 1000 + rt
return: 0 - 1

# THE HEADER PARTS OF METHOD i (-189 c4; form A): its signature is an ordinary graph field.
# - args, slot 0: one child per declared formal, in order -- a typed cell of the formal's type
#   (the prototype's 0), a callable formal's contract occurrence, a Structure formal's named
#   Structure (its type); a type with no cell leaves its slot empty.
# - return, slot 1: no child for a `sub`, else one -- the result's typed cell, or empty when the
#   result type has no cell.  The walked root's CALL refers to that cell (l2_rw_call).
# Then `native`: the trampoline for a method with a native body, 0 otherwise.
# Does a method's header part hold a char cell -- a char formal in `args`, a char result in
# `return` (l2_emit_parts)?  Its cell is the program's interned char, as an own char field's is, so
# the table and its predef exist (D-69).
fn: l2_parts_have_char () int
    int: i 0
    int: j
    while: i < l2_m_n
        j: 0
        while: i != l2_e && j < l2_m_arity[i]
            if: l2_cf_get(i, j) < 0 && l2_nsty_get(i, j) < 0 && l2_own_ty_of_param(l2_ft(i, j)) = 1
                return: 1
            j: j + 1
        ---
        if: i != l2_e && l2_m_ret[i] != 8 && l2_ret_cell_ty(i) = 1
            return: 1
        i: i + 1
    ---
return: 0

fn: l2_emit_parts (int: i) int
    int: j 0
    int: ty
    if: c.fprintf(l2_out, "        l2_entry_leaf: lmx_arena_ref_struct(l2_entry_unit, %uU)\n        if: l2_entry_leaf = 0\n            return: 1\n        l2_fkid: lmx_struct_new_owned(l2_entry_leaf, l2_program_arena)\n        if: l2_fkid = 0 || lmx_arena_ref_store(l2_entry_leaf, 0U, (cast: (@: void) l2_fkid)) != 0\n            return: 1\n", (cast: (unsigned) (l2_unit_base + i))) < 0
        return: 1
    if: l2_m_arity[i] > 0 && c.fprintf(l2_out, "        if: lmx_arena_refs_open_owned(l2_program_arena, l2_fkid, %uU) != 0\n            return: 1\n", (cast: (unsigned) l2_m_arity[i])) < 0
        return: 1
    while: j < l2_m_arity[i]
        ty: l2_own_ty_of_param(l2_ft(i, j))
        if: l2_cf_get(i, j) >= 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_fkid, %uU, (cast: (@: void) lmx_arena_ref_struct(l2_entry_unit, %uU))) != 0\n            return: 1\n", (cast: (unsigned) j), (cast: (unsigned) (l2_unit_base + l2_cf_get(i, j)))) < 0
            return: 1
        if: l2_cf_get(i, j) < 0 && l2_nsty_get(i, j) >= 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_fkid, %uU, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n", (cast: (unsigned) j), l2_nsty_get(i, j)) < 0
            return: 1
        if: l2_cf_get(i, j) < 0 && l2_nsty_get(i, j) < 0 && ty >= 0
            if: c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_fkid, %uU)\n        if: l2_entry_slot = 0\n            return: 1\n", (cast: (unsigned) j)) < 0 || l2_emit_cell_new_ty(ty, 0U, "        ", "l2_entry_slot", "lmx_char_cell_known(process_chars, 0)", "return: 1", 0) != 0
                return: 1
        ---
        j: j + 1
    ---
    if: fputs("        l2_fkid: lmx_struct_new_owned(l2_entry_leaf, l2_program_arena)\n        if: l2_fkid = 0 || lmx_arena_ref_store(l2_entry_leaf, 1U, (cast: (@: void) l2_fkid)) != 0\n            return: 1\n", l2_out) < 0
        return: 1
    if: l2_m_ret[i] != 8 && fputs("        if: lmx_arena_refs_open_owned(l2_program_arena, l2_fkid, 1U) != 0\n            return: 1\n", l2_out) < 0
        return: 1
    if: l2_m_ret[i] != 8 && l2_ret_cell_ty(i) >= 0
        if: fputs("        l2_entry_slot: lmx_arena_ref_cell(l2_fkid, 0U)\n        if: l2_entry_slot = 0\n            return: 1\n", l2_out) < 0 || l2_emit_cell_new_ty(l2_ret_cell_ty(i), 0U, "        ", "l2_entry_slot", "lmx_char_cell_known(process_chars, 0)", "return: 1", 0) != 0
            return: 1
    ---
    if: l2_m_native(i) = 0
        return: 0
    # The test knob `--walk-methods` (-193 T4a): a method with frames is walked.
    if: l2_walk_methods != 0 && l2_m_steps != 0 && l2_m_steps[i] > 0
        return: 0
    if: fputs("        l2_entry_leaf\\native: (cast: (LmxEntry) ", l2_out) < 0 || l2_write_sym(l2_out, i) != 0 || fputs("_tr)\n", l2_out) < 0
        return: 1
return: 0

fn: l2_emit_unit (const: @(char out_path)) int
    int: i 0
    int: k
    int: oi
    c.array: [192]: char sx
    unsigned: kids
    unsigned: l2_children_field
    int: fx
    size_t: bseq
    @: FILE chk
    int: had 0
    if: out_path = 0 || l2_m_n = 0 || (l2_library_mode = 0 && l2_e < 0)
        return: 1
    # Merge sites are scanned before output so locals and result slots have
    # their final sizes. Throw/Message dependency closure was computed during
    # analysis, before METHOD.sig interning.
    # The widest merge across methods (the entry is one) must be known before
    # the preamble and any callable-local operand array are written.
    l2_merge_max: 0
    i: 0
    while: i < l2_m_n
        l2_vis_method(i)
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0
            if: l2_merge_scan(l2_m_body[i]\as\structure) != 0
                return: 1
            ---
        ---
        i: i + 1
    ---
    l2_vis_on: 0
    i: 0
    # Structure-typed model fields materialize via merge(Type, empty) at
    # construction; size the shared scratch even when no body merge/colon exists.
    fx: 0
    l2_merge_build: 0
    while: fx < l2_nsf_n
        if: l2_nsf_kind[fx] = 3 && l2_nsf_ref[fx] >= 0 && l2_ns_eternal[l2_nsf_ref[fx]] < 0
            l2_merge_build: 1
            if: 1 > l2_merge_max
                l2_merge_max: 1
            ---
        ---
        fx: fx + 1
    ---
    if: l2_layout_owns() != 0
        return: 1
    # The walked root: its statements are checked and its steps counted once the own fields have
    # their cells laid out, and before anything is written -- after every check of E, so a
    # statement refused here is refused before the unit is.
    l2_rw_emit: 0
    l2_rw_t: 0
    l2_rw_pn: 0
    l2_rw_steps: 0
    l2_rw_send_n: 0
    l2_rw_send_i: 0
    l2_rw_send_rec: 1
    l2_rw_mi: l2_e
    if: l2_library_mode = 0 && l2_e >= 0 && l2_e_n > 0 && l2_rw_stmts(l2_e_fields, 0 - 2, 0, @ l2_rw_steps) != 0
        return: 1
    l2_rw_send_rec: 0
    # A root with no step (no statement, or only declarations without an initializer) is one bare
    # `return`: the walker has no empty body (a callable with no body node is LMX_WALK_NO_GRAPH).
    # It sends no exit and sets no success, so the host maps it to 1 (lmx_root_launch).
    if: l2_library_mode = 0 && l2_e >= 0 && l2_rw_steps = 0
        l2_rw_steps: 1
    # The methods' frames are counted too (-193 T4a), before the occurrences' widths are written.
    if: l2_rw_methods_count() != 0
        return: 1
    # The reserved unit-child bases must be known BEFORE any method body is
    # written: a field path inside a method addresses these same children
    # through the unit reference, and the entry is emitted last. They used to be
    # computed with the entry's child count, which left every in-method path
    # resolving to child 0.
    l2_mres_base: l2_unit_base + l2_occ_n() + l2_ebr_n
    l2_ns_base: l2_mres_base + l2_mres_n
    l2_pub_free()
    if: l2_pub_prepare(out_path) != 0
        return: l2_alloc_or(out_path, 0, "cannot prepare output path")
    l2_out: c.fopen(l2_pub_tmp, "wb")
    if: l2_out = 0
        c.fprintf(l1_stderr(), "l2trans error: cannot open %s\n", out_path)
        return: 1
    if: (l2_need_p0 != 0 || l2_need_query != 0) && c.fprintf(l2_out, "predef: \"%sl2_text_hash.lm1\"\n", l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    if: (l2_has_own_ty(4) != 0 || l2_has_own_ty(5) != 0 || l2_has_own_ty(7) != 0 || l2_has_own_ty(8) != 0 || l2_has_own_ty(37) != 0 || l2_has_pointer_array() != 0 || l2_ns_has_array != 0 || l2_library_mode = 0) && c.fprintf(l2_out, "predef: \"%slmx_array_owned.h.lm1\"\n", l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    if: (l2_has_own_ty(1) != 0 || l2_ns_has_char != 0 || l2_parts_have_char() != 0) && c.fprintf(l2_out, "predef: \"%slmx_chars_owned.h.lm1\"\n", l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    # WHAT STOOD HERE AND IS GONE (FABLE-SONNET-NAME-SPECIALS-20260924-155
    # commit 3): a literal prototype: block for the four lm_own_* names,
    # auto-injected by NAME (l2_need_own, set by l2_text_eq against each of
    # them) whenever any of the four was called, regardless of whether the
    # source unit predef'd them itself. That was a second, narrower name
    # special sitting right next to the one commit 2 deleted from
    # l2_is_known -- and since commit 2, admitting the call at all already
    # REQUIRES l2_predef_has_function(call\head) to be true (l2_check_fields
    # :13061 gates on l2_is_known, which for a non-c.* name is exactly that
    # check), so any unit whose code reaches this emitter for one of these
    # calls already carries a working predef chain for it. Measured
    # (unit_bad_sizeof.lm2, predef: "l1src/own.h.lm1"): the generated L1 had
    # BOTH this injected block and the unit's own predef line, declaring the
    # same four signatures twice: l1trans accepted the duplication (exit 0),
    # which is exactly the redundancy this deletion removes, not a
    # regression it introduces.
    # The root descriptor array is emitted unconditionally, so its constructor
    # is always needed.
    #
    # WHAT STOOD HERE AND IS GONE (48U): a second predef, lmx_owned_ranges.h.lm1,
    # emitted whenever l2_ebr_n was non-zero, justified as "the admitted eternal
    # set IS a range list".  That unit does not exist and never did in this
    # repository -- git knows the path at no commit, and
    # tests/lmx_merge_selftest.lm1:36 records absorbing the coverage of its
    # deleted selftest -- while this emitter went on naming it.  The effect was
    # that EVERY program with an eternal branch emitted L1 no translator could
    # read, which is why the gap was never measured rather than never hit.
    # Nothing generated here calls a symbol of it: qualification is answered by
    # the owner arena's exact profiled ranges, never by a per-program range list.
    if: c.fprintf(l2_out, "predef: \"%slmx_array_ref_owned.h.lm1\"\n", l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    # The executable profile's C main builds the argv letter: a Message record (S3).
    if: (l2_library_mode = 0 || l2_need_admit != 0) && c.fprintf(l2_out, "predef: \"%slmx_implements.h.lm1\"\n", l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    if: l2_merge_max != 0 && c.fprintf(l2_out, "predef: \"%slmx_merge_owned.h.lm1\"\n", l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    # Qualified immutable storage uses the ordinary owner arena's profiled pools.
    # The pool header supplies sealing; no permanent-store/root-slot API participates.
    if: l2_ebr_n != 0 && c.fprintf(l2_out, "predef: \"%slmx_pool.h.lm1\"\n", l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    i: 0
    while: i < l2_pd_n
        if: fputs("predef: ", l2_out) < 0 || l2_write_text(l2_out, l2_pd[i]) != 0 || fputs("\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        i: i + 1
    ---
    # The walked root (l2_rw_*): the program's graph builder makes walker nodes.
    if: l2_library_mode = 0 && l2_e >= 0 && c.fprintf(l2_out, "predef: \"%slmx_walk.h.lm1\" \"%slmx_primitive.h.lm1\" \"%slmx_child.h.lm1\" \"%slmx_list_owned.h.lm1\"\n", l2_rt_root, l2_rt_root, l2_rt_root, l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    # The C headers of the program's OWN mechanics, which the translator emits (GATE §7a, -197 (b)):
    # <stdio.h> and <stdlib.h> for every program -- an X1 invariant is `c.fprintf(c.stderr, ...)` then
    # `c.abort()`, the launch hands the host root `c.stdout`/`c.stderr`, a send's arena is calloc'd --
    # and <string.h> only where the emission uses it: the library profile's memset, a send copying a
    # text field (l2_send_copies_text).  What the SOURCE uses through `c.*` comes with its own
    # `include:` / `predef:` (the unit's list, written next).
    if: c.fprintf(l2_out, "predef: \"%slmx_arena_refs.h.lm1\" \"%slmx_value_owned.h.lm1\" \"%slmx.h.lm1\" \"%slmx_message.h.lm1\" \"%slmx_root.h.lm1\" \"%slmx_call.h.lm1\" \"%slmx_fresh.h.lm1\" \"%slmx_clock.h.lm1\"\ninclude: \"<stdio.h>\" \"<stdlib.h>\"", l2_rt_root, l2_rt_root, l2_rt_root, l2_rt_root, l2_rt_root, l2_rt_root, l2_rt_root, l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    if: (l2_library_mode != 0 || l2_send_copies_text(l2_rw_send_n, l2_rw_send_count, l2_rw_sf_kind, l2_rw_sf_text) != 0 || l2_send_copies_text(l2_msend_n, l2_msend_count, l2_msend_kind, l2_msend_text) != 0) && fputs(" \"<string.h>\"", l2_out) < 0
        fclose(l2_out)
        return: 1
    i: 0
    while: i < l2_inc_n
        if: fputs(" ", l2_out) < 0 || l2_write_text(l2_out, l2_inc[i]) != 0
            fclose(l2_out)
            return: 1
        i: i + 1
    ---
    if: l2_need_p0 != 0 && fputs(" \"l1src/p0.lm1.h\"", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_need_query != 0 && c.fprintf(l2_out, " \"%sl2_immut_query.h\"", l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    if: fputs("\n\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_write_defines(l2_out) != 0
        fclose(l2_out)
        return: 1
    # The two module cells of a LIBRARY unit are per-unit state, so their names are unit-hashed like the five below them.
    # These two renames stand BEFORE the definition of the arena: a define after a definition renames the later uses and
    # not the definition.  Two library units in one link collided on exactly these two names (link exit 1).
    if: l2_library_mode != 0 && c.fprintf(l2_out, "define: l2_program_arena l2_u%08X%08X_arena\ndefine: l2_program_unit l2_u%08X%08X_program_unit\ndefine: l2_program_graph l2_u%08X%08X_program_graph\ndefine: l2_program_qualified_roots l2_u%08X%08X_qualified_roots\ndefine: l2_program_qualified_count l2_u%08X%08X_qualified_count\ndefine: l2_program_qualified_at l2_u%08X%08X_qualified_at\ndefine: l2_library_opened l2_u%08X%08X_opened\n", l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b) < 0
        fclose(l2_out)
        return: 1
    if: fputs("@: LmxArena l2_program_arena 0\n@: Lmx l2_program_unit 0\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    # E1: the program's value is the int the entry returns. The adapter stores
    # it when the entry completes; a program whose entry did not complete has
    # no value and exits 1 (Q-S2-1 (a)).
    if: l2_e >= 0 && fputs("int: l2_program_result 0\nint: l2_program_done 0\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: fputs("\nfn: l2_program_graph () @: Lmx\nreturn: l2_program_unit\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    # Whether the entry completed (E1): an observation for the host, like the two
    # accessors below; a failed entry leaves the program without a value.
    if: l2_library_mode = 0 && l2_e >= 0 && fputs("\nfn: l2_program_completed () int\nreturn: l2_program_done\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_ebr_n != 0 && c.fprintf(l2_out, "c.array: [%d]: @: Lmx l2_program_qualified_roots\n", l2_ebr_n) < 0
        fclose(l2_out)
        return: 1
    if: c.fprintf(l2_out, "\nfn: l2_program_qualified_count () size_t\nreturn: %uU\n\nfn: l2_program_qualified_at (size_t: index) @: Lmx\n", (cast: (unsigned) l2_ebr_n)) < 0
        fclose(l2_out)
        return: 1
    if: l2_ebr_n = 0 && fputs("return: 0\n\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_ebr_n != 0 && c.fprintf(l2_out, "    if: index >= %uU\n        return: 0\nreturn: l2_program_qualified_roots[index]\n\n", (cast: (unsigned) l2_ebr_n)) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode != 0 && c.fprintf(l2_out, "define: l2_program_entry l2_u%08X%08X_entry\ndefine: l2_library_open l2_u%08X%08X_open\ndefine: l2_library_root l2_u%08X%08X_root\ndefine: l2_library_message l2_u%08X%08X_message\ndefine: l2_library_unit l2_u%08X%08X_unit\n\n", l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b) < 0
        fclose(l2_out)
        return: 1
    if: l2_emit_os(l2_out) != 0
        fclose(l2_out)
        return: 1
    if: l2_e >= 0 && c.fprintf(l2_out, "# entry statements: %d\n", l2_e_n) < 0
        fclose(l2_out)
        return: 1
    if: fputs("# interned contract: rec.sig is translator intern id of the full canonical contract.\n# L2_SIG_V0 schema plus return type, declared throw/Message ABI, arity and exact ordered source formal names/types (int, char, size_t, const char*, const LmP0Text* const-pointee, LmP0Text* mutable pointee, const L2ImmutQuery* const-pointee, L2ImmutQuery* mutable pointee, size_t* mutable out-param). No varargs. Method name is not interned.\n# Hidden DynRequired names, when present, are interned after declared formals, sorted by source-name bytes then type; declared arity is unchanged. Empty DynRequired keeps the declared-only intern.\n# Mapping: id 1 := first interned contract of this unit. The comment-only l2_sig_f0/f1 diagnostics are method 0's first two source names (empty if arity is below that).\n# Linked-program intern only, not inter-module canonicalization. One intern table for the unit, not reset per method.\n# Runtime: no memcmp; closed-unit devirtualization. Formal names are the intern entry for rec.sig. const pointee forbids stores through the pointee; mutable pointee stores address the referent fields, not a cache.\n# Diagnostic evidence only; no runtime storage or global table.\n# const: @(char l2_sig_f0) \"", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_m_f0[0] != 0 && l2_write_text(l2_out, l2_m_f0[0]) != 0
        fclose(l2_out)
        return: 1
    if: fputs("\"\n# const: @(char l2_sig_f1) \"", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_m_f1[0] != 0 && l2_write_text(l2_out, l2_m_f1[0]) != 0
        fclose(l2_out)
        return: 1
    if: c.fprintf(l2_out, "\"\n# unsigned: l2_intern_id %uU\n# unsigned: l2_intern_again %uU\n# unsigned: l2_intern_swap %uU\n# unsigned: l2_intern_probe %uU\n", l2_sigv, l2_intern_again, l2_intern_swap, l2_intern_probe) < 0
        fclose(l2_out)
        return: 1
    k: 0
    while: k < l2_own_n
        if: c.fprintf(l2_out, "# const: @(char l2_own%d) \"", k) < 0
            fclose(l2_out)
            return: 1
        if: l2_write_text(l2_out, l2_own_name[k]) != 0
            fclose(l2_out)
            return: 1
        if: fputs("\"\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        k: k + 1
    ---
    # The root (E) is walked and has no prototype: a file whose only method is its root has an
    # empty prototype list, and L1 refuses an empty colon frame, so the block is then left out.
    k: l2_m_n + l2_rw_send_n
    if: l2_e >= 0 && l2_e < l2_m_n
        k: k - 1
    if: k > 0 && fputs("\nprototype:\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    i: 0
    while: i < l2_m_n
        if: i = l2_e
            i: i + 1
            continue
        if: l2_m_ret[i] = 8 && l2_m_throws[i] = 0 && fputs("    sub: ", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: (l2_m_ret[i] != 8 || l2_m_throws[i] != 0) && fputs("    fn: ", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: l2_write_sym(l2_out, i) != 0
            fclose(l2_out)
            return: 1
        if: l2_emit_sig(i) != 0
            fclose(l2_out)
            return: 1
        if: fputs("\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        i: i + 1
    # Each native method's trampoline (l2_emit_trampoline): its METHOD.addr.
    i: 0
    while: i < l2_m_n
        if: l2_m_native(i) != 0 && i != l2_e && l2_emit_trampoline(i, 1) != 0
            fclose(l2_out)
            return: 1
        i: i + 1
    # The walked root's send primitives (l2_emit_send).
    i: 0
    while: i < l2_rw_send_n
        if: l2_emit_send(i, 1, "l2_send", l2_rw_send_count, l2_rw_sf_kind, l2_rw_sf_text, l2_rw_send_has_ref) != 0
            fclose(l2_out)
            return: 1
        i: i + 1
    # FABLE-SONNET-SEND-IN-METHODS-20260925-168 commit 2: a method body's own send primitives,
    # a separate k-space (l2_msend_*) so they cannot collide with the root's (l2_rw_send_*).
    i: 0
    while: i < l2_msend_n
        if: l2_emit_send(i, 1, "l2_msend", l2_msend_count, l2_msend_kind, l2_msend_text, l2_msend_has_ref) != 0
            fclose(l2_out)
            return: 1
        i: i + 1
    # Source method names can be used as ordinary C callback values inside an
    # earlier body. Their public wrappers are emitted after all graph-callable
    # bodies, so declare those wrapper signatures here as well.
    i: 0
    while: i < l2_m_n
        if: l2_library_mode = 0 && (l2_m_value_used = 0 || l2_m_value_used[i] = 0)
            i: i + 1
            continue
        if: l2_m_ret[i] = 8 && fputs("    sub: ", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: l2_m_ret[i] != 8 && fputs("    fn: ", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: l2_write_text(l2_out, l2_m_name[i]) != 0 || l2_emit_public_sig(i) != 0 || fputs("\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        i: i + 1
    if: k > 0 && fputs("end: prototype\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: fputs("\n# Backend method symbols are l2_m{i}; intern and find_method keep source names. c.malloc stays the foreign door.\n# Publication: write tmp; if dest.bak exists pick dest.bak.N; rename dest to that bak; rename tmp to dest; on fail restore bak or report its path. Not atomic. No recursive FS. Foreign bak is not deleted.\n# OwnUsed char/int/size_t/unsigned fields are children of the selected callable occurrence `self`; source-visible `node` is the fixed lexical space above the method for the whole activation. Char cache is typed char; graph data is all_chars cell. Numeric caches keep their declared C type; graph data uses a distinct owned LMX_TYPE_INT, LMX_TYPE_SIZE_T or LMX_TYPE_UNSIGNED cell mutated in place (no interned shared size_t, no int narrowing). Dirty-only checkpoint after actuals, immediately before the executed call, and before return. Explicit node\\name writes that fixed above-method graph, not the cache.\n# LmP0Text is the existing C ABI from l1src/p0.lm1.h (data, length), a limited migration adapter, not a general C header parser and not a silent layout for new L2 Structures. LmP0TrailerRole is that same header's typedef int (NONE/DASH_CUTTER/END/RETURN/UNTIL), not intern16. Lmx structural access stays child-index. Foreign C is spelled c.name and emitted as written; the C compiler checks it. A bare name is an L2 call resolved against unit methods and parsed prototype: declarations. Body @: LmP0Text is an 11.2.1 address slot l2_s, not OwnUsed. Pointer results @: char / @: LmP0Text; sub: is void. return: slot is the pointer value, not @slot. @: size_t is a typed out-param; name[0]: stores through it (literal 0 only). L2 @ actuals are not emitted; a type-9 actual is the pointer value forwarded. Checkpoint even if OwnUsed is empty. Same-name char/size_t argument and own field share the parameter from the own-decl line; dirty-only publish is to this method's selected occurrence self, not to source node and not to the caller. An argument without that bind is never published. Executable if/else/while/for bodies are graph Structures; body own fields publish into their exact host without rebinding source node. L2ImmutQuery is a borrowed immutable-query adapter (not LmP0Text); fill is a temporary L1 helper behind the L2 make method. text_equals is the mutable fallback (strlen+memcmp). equals_query hashes current text bytes against a prepared query hash. &&/|| with calls use guarded if/temps; skipped RHS does not prep nested actuals. Pure &&/|| stay L1 C expressions.\n\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    i: 0
    # FABLE-SONNET-SEND-IN-METHODS-20260925-168 commit 2: reset before this emit pass, matching
    # the reset before the check pass -- see the comment there.
    l2_msend_i: 0
    while: i < l2_m_n
        # Platform variants already emitted their graph-callable l2_mN bodies
        # inside the L1 os block above. Keep the common prototype and METHOD
        # descriptor, but never emit a second non-platform implementation.
        if: l2_method_is_os(i)
            i: i + 1
            continue
        # E is the walked root (l2_rw_*): its statements are walker nodes, not a native body.
        if: i = l2_e
            i: i + 1
            continue
        if: l2_m_ret[i] = 8 && l2_m_throws[i] = 0 && fputs("sub: ", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: (l2_m_ret[i] != 8 || l2_m_throws[i] != 0) && fputs("fn: ", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: l2_write_sym(l2_out, i) != 0
            fclose(l2_out)
            return: 1
        if: l2_emit_sig(i) != 0
            fclose(l2_out)
            return: 1
        # A method entered without its occurrence is its caller's broken promise (D-05): X1, not
        # a return of 0 -- which was a silent success, whatever the method's return shape.
        if: fputs("\n    if: self = 0\n        c.fprintf(c.stderr, \"lmx: invariant: a method was entered without its occurrence\\n\")\n        c.abort()\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: l2_m_throws[i] != 0 && c.fprintf(l2_out, "    c.array: [%d]: @: Lmx l2_mops\n    c.array: [%d]: @: Lmx l2_mprofiles\n    int: l2_mstatus 0\n    @: Lmx l2_mresult 0\n    @: Lmx l2_mbody 0\n    @@: void l2_mxp 0\n    @@: void l2_myp 0\n    @: Lmx l2_malias 0\n", l2_merge_max, l2_merge_max) < 0
            fclose(l2_out)
            return: 1
        if: l2_m_throws[i] != 0 && l2_merge_pmax > 0 && c.fprintf(l2_out, "    c.array: [%d]: LmxMergePair l2_mpv\n    c.array: [%d]: @: LmxMergePair l2_mpp\n", l2_merge_pmax, l2_merge_pmax) < 0
            fclose(l2_out)
            return: 1
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_body_receives(l2_m_body[i]\as\structure) != 0 && fputs("    @: LmxMsg l2_nmsg 0\n    @: Lmx l2_ngraph 0\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: l2_emit_poll(i, "    ") != 0
            fclose(l2_out)
            return: 1
        # `node` is the fixed lexical space above this method (the unit for a
        # unit-level method); nested body Structures do not rebind it. `self`
        # is the selected occurrence and own-field home. E's occurrence is the
        # unit, so in E the unit is `self` (and its node is 0).
        l2_unit_ref: "node"
        if: i = l2_e
            l2_unit_ref: "self"
        l2_cur_mi: i
        l2_vis_method(i)
        k: 0
        while: k < l2_for_n
            # A control body's Structure is built with the unit; missing, it is a broken promise
            # (D-05): X1, whatever the method returns -- it used to return 0, a silent success.
            if: l2_for_owner(k) = i && l2_for_parent[k] < 0 && c.fprintf(l2_out, "    @: Lmx l2_h%d 0\n    l2_h%d: lmx_arena_ref_struct(self, %uU)\n    if: l2_h%d = 0\n", k, k, (cast: (unsigned) l2_for_uchild[k]), k) < 0
                fclose(l2_out)
                return: 1
            if: l2_for_owner(k) = i && l2_for_parent[k] >= 0 && c.fprintf(l2_out, "    @: Lmx l2_h%d 0\n    l2_h%d: lmx_arena_ref_struct(l2_h%d, %uU)\n    if: l2_h%d = 0\n", k, k, l2_for_parent[k], (cast: (unsigned) l2_for_uchild[k]), k) < 0
                fclose(l2_out)
                return: 1
            if: l2_for_owner(k) = i && l2_emit_invariant("    ", "a control body has no Structure") != 0
                fclose(l2_out)
                return: 1
            k: k + 1
        ---
        k: 0
        while: k < l2_own_n
            if: l2_own_is_array(l2_own_ty[k]) != 0
                k: k + 1
                continue
            # -189 c3b: every own field but an array is direct: its slot handle, an address, not a value.
            if: l2_m_uses[l2_own_off(i, k)] != 0 && l2_own_direct(i, k) != 0 && c.fprintf(l2_out, "    @@: void l2_q%d_from 0\n", k) < 0
                fclose(l2_out)
                return: 1
            if: l2_m_uses[l2_own_off(i, k)] != 0 && l2_own_direct(i, k) != 0 && l2_own_fid[k] >= 0 && c.fprintf(l2_out, "    l2_q%d_from: lmx_arena_ref_cell(l2_h%d, %uU)\n    if: l2_q%d_from = 0\n        c.fprintf(c.stderr, \"lmx: invariant: own field %d has no cell\\n\")\n        c.abort()\n", k, l2_own_fid[k], (cast: (unsigned) l2_own_fchild[k]), k, k) < 0
                fclose(l2_out)
                return: 1
            if: l2_m_uses[l2_own_off(i, k)] != 0 && l2_own_direct(i, k) != 0 && l2_own_fid[k] < 0 && l2_own_uchild[k] >= 0 && c.fprintf(l2_out, "    l2_q%d_from: lmx_arena_ref_cell(%s, %uU)\n    if: l2_q%d_from = 0\n        c.fprintf(c.stderr, \"lmx: invariant: own field %d has no cell\\n\")\n        c.abort()\n", k, l2_own_ctr(k), (cast: (unsigned) l2_own_uchild[k]), k, k) < 0
                fclose(l2_out)
                return: 1
            k: k + 1
        ---
        k: 0
        while: k < l2_m_sn[i]
            if: l2_st[l2_slot_off(i, k)] = 3 && c.fprintf(l2_out, "    @: char l2_s%d_%d 0\n", i, k) < 0
                fclose(l2_out)
                return: 1
                fclose(l2_out)
                return: 1
            if: l2_st[l2_slot_off(i, k)] = 9 && c.fprintf(l2_out, "    @: size_t l2_s%d_%d 0\n", i, k) < 0
                fclose(l2_out)
                return: 1
                fclose(l2_out)
                return: 1
            k: k + 1
        ---
        if: (l2_own_n != 0 || l2_m_dyn[i] != 0 || l2_for_n != 0) && fputs("    @@: void l2_xp 0\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        # The field-path temps. A unit with no declaration and no bound
        # result can hold no path, so they are only declared where one is
        # possible.
        if: (l2_ns_n != 0 || l2_mres_n != 0 || l2_uses_node_for_root != 0) && fputs("    @: Lmx l2_pst 0\n    @@: void l2_pxp 0\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        l2_tn: 0
        l2_call_node: "self"
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_ml_rebuild(l2_m_body[i]\as\structure, l2_src) != 0
            fclose(l2_out)
            return: 1
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_emit_body(l2_m_body[i]\as\structure, i, "    ") != 0
            fclose(l2_out)
            return: 1
        # Descriptor-only rows emit no native body (catalog addr stays 0).
        if: l2_m_node[i] != 0 && l2_m_node[i]\as != 0 && l2_emit_ret_tr(i, "    ", l2_ret_tr(l2_m_node[i]\as\frame)) != 0
            fclose(l2_out)
            return: 1
        if: l2_m_ret[i] = 8 && l2_m_throws[i] != 0 && fputs("    return: 0\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        # An entry that runs off its end returns 0.
        if: i = l2_e && l2_e_falls_off() != 0 && l2_m_throws[i] = 0 && fputs("    return: 0\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: i = l2_e && l2_e_falls_off() != 0 && l2_m_throws[i] != 0 && fputs("    l2_out_result[0]: 0\n    return: 0\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: fputs("end: ", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: l2_write_sym(l2_out, i) != 0
            fclose(l2_out)
            return: 1
        if: fputs("\n\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        i: i + 1
    l2_vis_on: 0
    l2_cur_mi: 0 - 1
    # Each native method's trampoline, after every body it calls (l2_emit_trampoline).
    i: 0
    while: i < l2_m_n
        if: l2_m_native(i) != 0 && i != l2_e && l2_emit_trampoline(i, 0) != 0
            fclose(l2_out)
            return: 1
        i: i + 1
    if: (l2_rw_send_n > 0 || l2_msend_n > 0) && fputs("sub: l2_send_fail ()\n    c.fprintf(c.stderr, \"lmx: invariant: sendMessage failed\\n\")\n    c.abort()\nend: l2_send_fail\n\n", l2_out) < 0
        fclose(l2_out)
