A:
    int: x 7
end: A
B:
    int: x 9
end: B
fn: declaration (@: p int) int (
    @: p int (@ (A \ x))
)
    @: p int (@ (B \ x))
    return: (\ p)
end: declaration
fn: bare (@: p int) int (
    @: p int (@ (A \ x))
)
    :=: p (@ (B \ x))
    return: (\ p)
end: bare
