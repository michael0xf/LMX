---
    Observed:
        int: seen 0
    end: Observed
---
sub: foo ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) (((shared \ Observed) \ seen) + 1)
end: foo
sub: bar ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) (((shared \ Observed) \ seen) + 10)
end: bar
sub: main ((C (foo) (bar)))
    call: C
end: main
main:
