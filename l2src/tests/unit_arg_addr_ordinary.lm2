# -189 c3b-2 (FABLE-OPUS-CODE-DATA-SPLIT-20260925-189; L3 §12, R2 with carry, static by position):
# the name is the machine argument until its binding line and its field's cell from then on; a
# declaration without an initializer carries the argument's value into the field, and `@x` after
# the line is the cell's address.  There is no working copy and no sticky republication, so a line
# printed after `M\x: v` shows v (OC3, OE, OD3).  The sticky-rule text below is the old model's.
#
# FABLE-L2-ARG-ADDRESS-PROOF-20260921-84.  THE ORDINARY CASES IN A PROGRAM OF THEIR OWN.
#
# In this program every address is taken AFTER the binding line, so every field's cell is already
# resolved when the address is taken.  That matters for one wrong translator in particular: the
# one that raises sticky at the address site whether or not a binding line ever ran.  Next to a
# before-bind or never-bound activation that translator dies publishing through a cell nobody
# resolved, and the death hides everything else it gets wrong.  Here it cannot die: it must print
# OC2 9 9, OC3 9 9, OE 6 6, OD2 9 9 and OD3 9 9, and those are plain wrong lines, not a crash.
#
# Each line is "<case> <local> <graph field>".
#
# WORKAROUND, NAMED (GROK-FABLE-20260923-120 x FABLE-SONNET-NODE-ROOT-20260923-121): `M\x` read
# directly inside a compound expression (a printf argument list, here) lands in Grok Bot's -120
# c-member-access dispatch and emits a wrong raw C member access instead of a typed load -- a
# defect in that dispatcher's root test, handed to him as a separate ticket. Every read below is
# routed through a freshly assigned `<x>_g` local first (unit_occ_root_field.lm2's pattern).
fn: poke5 (@: int p) int
    \p: 5
    return: 0
end: poke5
fn: poke9 (@: int p) int
    \p: 9
    return: 0
end: poke9
fn: pokez9 (@: size_t p) int
    \p: 9U
    return: 0
end: pokez9
fn: nop () int
    return: 0
end: nop

# A declared formal: bound, then address.  The checkpoint before the call publishes and clears;
# the write through the address is no assignment and is not published.
fn: after_bind (int: oc) int
    int: oc_g
    int: oc
    oc: oc + 1
    nop()
    oc_g: after_bind\oc
    c.printf: "OC1 %d %d\n" oc oc_g
    poke9(@: oc)
    oc_g: after_bind\oc
    c.printf: "OC2 %d %d\n" oc oc_g
    after_bind\oc: 100
    nop()
    oc_g: after_bind\oc
    c.printf: "OC3 %d %d\n" oc oc_g
    return: 0
end: after_bind

# The DECLARATION is a binding line: declared, then address, then assigned.
fn: decl_binds (int: oe) int
    int: oe_g
    int: oe
    poke5(@: oe)
    oe: oe + 1
    nop()
    decl_binds\oe: 100
    nop()
    oe_g: decl_binds\oe
    c.printf: "OE %d %d\n" oe oe_g
    return: 0
end: decl_binds

# A dynamic input: read in the condition (that is what makes it one), bound, then address.
fn: dyn_after () int
    size_t: od_g
    if: od = 0U
        return: 0
    size_t: od
    od: od + 1U
    nop()
    od_g: dyn_after\od
    c.printf: "OD1 %d %d\n" (cast: (int) od) (cast: (int) od_g)
    pokez9(@: od)
    od_g: dyn_after\od
    c.printf: "OD2 %d %d\n" (cast: (int) od) (cast: (int) od_g)
    dyn_after\od: 100U
    nop()
    od_g: dyn_after\od
    c.printf: "OD3 %d %d\n" (cast: (int) od) (cast: (int) od_g)
    return: 0
end: dyn_after

fn: outer () int
    size_t: od
    od: 3U
    after_bind(3)
    decl_binds(3)
    dyn_after()
    return: 0
end: outer

outer()
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
