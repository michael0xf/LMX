stream:
    int: calls 0
    return: int
    next:
        throws: Stop
        node\calls += 1
        if: node\calls = 1
            return: -2
        if: node\calls = 2
            return: 0
        if: node\calls = 3
            return: 4
        throw: Stop()
    demo:
        node\calls := 0
        int: total 0
        cycles\iterate: int: item stream\next()
            item += 3
            total += item
            total += item
        return: total

cycles:
    @: iteration
    @: body
    iterate:
        while: 1
            iteration()
            catch: Stop ()
                break
            body()
