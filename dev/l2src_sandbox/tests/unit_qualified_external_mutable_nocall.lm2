# A known Structure candidate is stored in the reference cell when F is
# constructed, without executing F. An immutable F cannot retain mutable
# storage even when F is never called.
Model: (int: a 7)
Mutable: (int: a 0)
independent:
    const:
        immutable:
            (): F
                @: Model ref Mutable
            end: F
        end: immutable
    end: const
end: independent
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
