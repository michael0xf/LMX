# A value that is only a path is a value of its field's type: `return: P\v` gives P's size_t v to an int result -- a
# conversion, whose receiver this program has no row for.  P0 gives the path as the fields `P`, `\`, `v`, which the
# composite typer left untyped below three tokens: it translated, and C converted.
P:
    size_t: v 2U
fn: m () int
    return: P\v

sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
