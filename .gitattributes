*.jar -text
*.xlsx -text
*.zip -text
*.gz -text
# Comparison tables of the documentation are stored byte for byte as the author issued them (CRLF), so that the
# author's manifests hold and a new packet compares with the tree without line-end noise.
docs/**/*.csv -text
# Patches of the author's packets carry the line ends of the files they change: stored byte for byte as issued.
docs/tasks/**/*.patch -text
