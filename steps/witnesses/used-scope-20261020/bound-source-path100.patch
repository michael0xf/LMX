+# Replace a verdict in the SAME owned grammar storage. Both an ordinary
+# resolver query and a canonical source-use resolution publish here. No
+# geometry is cut and no second path/fact is allocated by this operation.
+fn: l2_path_fact_store (@: L2PathFact fact; const: @(L2Path path)) int
+    @: L2Path target
+    @: char text
+    @: L2PathStep steps
+    int: capacity
+    if: fact = 0 || path = 0 || path\n < 0
+        return: 1
+    target: @ fact\resolved
+    if: path\n > target\cap || l2_path_same_grammar(target, path) = 0
+        return: 1
+    text: (cast: (@: char) target\text)
+    steps: target\steps
+    capacity: target\cap
+    memmove((cast: (@: void) target), (cast: (@: void) path), c.sizeof(c.L2Path))
+    target\text: text
+    target\steps: steps
+    target\owned: 0
+    target\cap: capacity
+    if: path\n > 0
+        memmove((cast: (@: void) steps), (cast: (@: void) path\steps), (cast: (size_t) path\n) * c.sizeof(c.L2PathStep))
+    fact\stage: 1
+return: 0
+
