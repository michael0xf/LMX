# Slice 259 (design 4.5 B2b-2b; the ledger BITWISE-OPERATORS-NOT-CLASSIFIED): the machine profile's bitwise and shift
# operators over a free (runtime-typed) operand run through the kernel's one shared binary operation in both executors --
# the native runtime-typed expression calls lmx_walk_value_bin with the walker's codes BAND/BOR/BXOR/SHL/SHR, the walked body
# evaluates the same frames: & | ^ over two operands of one type (a contextual literal takes the other operand's type), a
# shift count of its own type and the result of the left's promoted type (a shift's left literal is an int, or an unsigned by
# its suffix; the width is the left's: 32 for unsigned, 64 for size_t).  Two numbers of different types are the implicit
# `convert`, a count outside [0, width) or an overflowing signed left shift (a negative left, a bit carried past the sign) the
# implicit `interpreter` throw -- before the operation, caught by the caller.  The free name `quote` is bound by the callers
# as unsigned (outer_bits), int (outer_ints) and size_t (outer_wide); `marks` has no binding and is read lexically (3); widen
# is a sub whose bare write `quote: quote << 1` is activation-local (Q52: the caller keeps its value); typed_walked has no
# free operand (the typed walked path of the same operators).  Slice 260 (P1-NUMERIC-KIND, Codex): outer_ref binds `quote` to a
# pointer -- the free POINTER in a numeric operation (low_bits) and under the order comparison (below) is the implicit `convert`
# before the operation, caught by the caller; `quote = 0` (is_null) is the null test of the free reference (false bound to a
# cell, true bound to the null pointer).  Entry 7; 81.. name the failing check.
int: quote 11
int: marks 3
fn: mask () unsigned
    return: quote & 0x0FF0U
end: mask
fn: pick () unsigned
    return: quote | 1U
end: pick
fn: flip () unsigned
    return: quote ^ 0xFFFFU
end: flip
fn: shifted (int: n) unsigned
    return: quote << n
end: shifted
fn: masked_by (unsigned: m) unsigned
    return: quote & m
end: masked_by
fn: low_bits () int
    return: quote & 7
end: low_bits
fn: halved (int: n) int
    return: quote >> n
end: halved
fn: doubled (int: n) int
    return: quote << n
end: doubled
fn: one_shifted () int
    return: 1 << quote
end: one_shifted
fn: both_free () int
    return: quote | marks
end: both_free
sub: widen ()
    quote: quote << 1
end: widen
fn: wide_shift (int: n) size_t
    return: quote << n
end: wide_shift
fn: typed_walked (unsigned: a; int: n) unsigned
    return: (a & 0xF0U) >> n
end: typed_walked
fn: outer_bits () int
    unsigned: quote 0x1234U
    unsigned: got 0U
    if: mask() != 0x0230U
        return: 81
    if: pick() != 0x1235U
        return: 82
    if: flip() != 0xEDCBU
        return: 83
    if: shifted(4) != 0x12340U
        return: 84
    if: masked_by(0xFF00U) != 0x1200U
        return: 85
    widen()
    if: quote != 0x1234U
        return: 86
    ---
        got: shifted(32)
        catch: interpreter ()
            got: 90U
    ---
    if: got != 90U
        return: 87
    return: 0
end: outer_bits
fn: outer_ints () int
    int: quote 0
    int: got 0
    unsigned: ugot 0U
    quote: 0 - 6
    if: low_bits() != 2
        return: 88
    if: both_free() != 0 - 5
        return: 89
    quote: 6
    if: halved(1) != 3
        return: 90
    if: doubled(2) != 24
        return: 91
    quote: 5
    if: one_shifted() != 32
        return: 92
    ---
        got: halved(0 - 1)
        catch: interpreter ()
            got: 93
    ---
    if: got != 93
        return: 94
    quote: 1073741824
    ---
        got: doubled(1)
        catch: interpreter ()
            got: 95
    ---
    if: got != 95
        return: 96
    quote: 0 - 6
    ---
        got: doubled(1)
        catch: interpreter ()
            got: 97
    ---
    if: got != 97
        return: 98
    ---
        ugot: masked_by(255U)
        catch: convert ()
            ugot: 99U
    ---
    if: ugot != 99U
        return: 99
    return: 0
end: outer_ints
fn: outer_wide () int
    size_t: quote 1U
    size_t: got 0U
    if: wide_shift(40) != 1099511627776U
        return: 100
    ---
        got: wide_shift(64)
        catch: interpreter ()
            got: 101U
    ---
    if: got != 101U
        return: 102
    return: 0
end: outer_wide
fn: is_null () int
    if: quote = 0
        return: 1
    return: 0
end: is_null
fn: below () int
    if: quote < 100
        return: 1
    return: 2
end: below
fn: outer_ref () int
    @: quote int 0
    int: cell 5
    int: got 0
    if: is_null() != 1
        return: 104
    quote: @ cell
    if: is_null() != 0
        return: 105
    ---
        got: low_bits()
        catch: convert ()
            got: 106
    ---
    if: got != 106
        return: 107
    ---
        got: below()
        catch: convert ()
            got: 108
    ---
    if: got != 108
        return: 109
    return: 0
end: outer_ref
fn: m () int
    int: r outer_bits()
    if: r != 0
        return: r
    r: outer_ints()
    if: r != 0
        return: r
    r: outer_wide()
    if: r != 0
        return: r
    r: outer_ref()
    if: r != 0
        return: r
    if: typed_walked(171U, 4) != 10U
        return: 103
    return: 7
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
