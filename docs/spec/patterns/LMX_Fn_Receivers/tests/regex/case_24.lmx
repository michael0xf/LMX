# Source acceptance fixture, NOT an executed test report.
# Expected: ("abcabc", 2); replacement text is not rescanned
Replacer:
    int: calls 0
    Apply:
        private: @Match: matched
        return: []char
        replace:
            private: @: owner parent()
            owner\calls += 1
            return: "abc"

@: pattern (then (literal("a") | "ab") "c")
[]char: result replace(utf8Text("abcabc"); pattern; Replacer\Apply\replace)
(result; Replacer\calls)
