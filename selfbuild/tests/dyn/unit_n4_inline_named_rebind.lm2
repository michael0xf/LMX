# The receiving contract is the prepared data field, not the value most
# recently stored there. An extra field of the first admitted candidate must
# not become a requirement for the second candidate.
# Neither call writes D: the form `T:` in the code of S1 and S2 is a call of its head (the book, colon-declares;
# slice 416), so D\T\v stays 0.
S1:
    T:
        int: v 1
        int: extra 7
end: S1
S2:
    T:
        int: v 2
end: S2
D:
    T:
        int: v 0
end: D
int: caught1 0
---
    call(D S1)
    catch: satisfies ()
        caught1 := 1
---
int: seen1 0
seen1 := D\T\v
int: caught2 0
---
    call(D S2)
    catch: satisfies ()
        caught2 := 1
---
int: code 7
if: caught1 != 0
    code := 94
if: code = 7 && seen1 != 0
    code := 97
if: code = 7 && caught2 != 0
    code := 95
if: code = 7 && D\T\v != 0
    code := 96
send: exit(exit_code: code; stdout: ""; stderr: "")
return
