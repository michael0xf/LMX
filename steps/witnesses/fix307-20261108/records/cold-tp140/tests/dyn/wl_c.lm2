# Probe of slice 307 (not a fixture of the suite): the merge written in the call itself only -- the lifted hidden declaration run where
# the actual is evaluated (native lm_compiler_emit_lifted, the walker's THEN operand).  Entry 7 when the call is 35; 80 otherwise.
fn: mytest (int: c 3; int: a) int
    return: c * 10 + a
end: mytest
fn: by_inline () int
    return: mytest(merge(mytest\args; (a: int: 5)))
end: by_inline
fn: run () int
    if: by_inline() != 35
        return: 80
    return: 7
end: run
int: code run()
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
