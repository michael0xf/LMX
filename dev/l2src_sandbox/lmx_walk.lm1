predef: "l2src/lmx_walk.h.lm1"
predef: "l2src/lmx_implements.h.lm1"
predef: "l2src/lmx_call.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdlib.h>" "<string.h>"

# lmx_walk.lm1 - one activation of the graph interpreter.  The contract, its sources and
# the limits of this slice are in lmx_walk.h.lm1.

# ---- construction of body nodes --------------------------------------------------------

fn: lmx_walk_plain (@: LmxArena arena; @: Lmx parent; size_t: children) @: Lmx
    @: Lmx s 0
    if: arena = 0 || parent = 0
        return: 0
    s: lmx_struct_new_owned(parent, arena)
    if: s = 0
        return: 0
    if: children != 0U && lmx_arena_refs_open_owned(arena, s, children) != 0
        return: 0
return: s

fn: lmx_walk_frame (@: LmxArena arena; @: Lmx parent; int: code; size_t: children) @: Lmx
    @: Lmx s 0
    @: LmxOp head 0
    if: code <= c.LMX_WALK_OP_NONE || code >= c.LMX_WALK_OP_COUNT || children = 0U
        return: 0
    s: lmx_walk_plain(arena, parent, children)
    head: lmx_op_new_owned(arena, code)
    if: s = 0 || head = 0
        return: 0
    if: lmx_arena_ref_store(s, 0U, (cast: (@: void) head)) != 0
        return: 0
return: s

fn: lmx_walk_store_size (@: LmxArena arena; @: Lmx code; size_t: slot; size_t: value) int
    @: void cell lmx_size_new_owned(arena)
    if: cell = 0
        return: c.LMX_WALK_NOMEM
    if: lmx_size_store_known(cell, value) != 0 || lmx_arena_ref_store(code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
return: c.LMX_WALK_OK

fn: lmx_walk_store_int (@: LmxArena arena; @: Lmx code; size_t: slot; int: value) int
    @: void cell lmx_int_new_owned(arena)
    if: cell = 0
        return: c.LMX_WALK_NOMEM
    if: lmx_int_store_known(cell, value) != 0 || lmx_arena_ref_store(code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
return: c.LMX_WALK_OK

# ---- recognition and paths -------------------------------------------------------------

# The code of the frame node a child is; NONE for anything else: an own cell, a plain
# Structure, a nested callable's M.  The child is read as a Structure, and its child[0]
# as an LmxOp, only after the arena's index says so.  A bare LmxOp child is its own
# frame with no operands (lmx_interp_exec reads a bare RETURN the same way).
fn: lmx_walk_op (@: LmxWalkFrame f; @: void code) int
    @: LmxOp op 0
    @: void head 0
    int: kind
    if: f = 0 || code = 0
        return: c.LMX_WALK_OP_NONE
    kind: lmx_range_classify(f\arena, code)
    head: code
    if: kind = c.LMX_KIND_STRUCT
        head: lmx_arena_ref_value((cast: (@: Lmx) code), 0U)
        if: head = 0
            return: c.LMX_WALK_OP_NONE
        kind: lmx_range_classify(f\arena, head)
    ---
    if: kind != c.LMX_DOMAIN_KIND_OP
        return: c.LMX_WALK_OP_NONE
    op: (cast: (@: LmxOp) head)
    if: op\code <= c.LMX_WALK_OP_NONE || op\code >= c.LMX_WALK_OP_COUNT
        return: c.LMX_WALK_OP_NONE
return: op\code

# Follow the size_t cells code[first .. len-1] from `start`: every step but the last
# enters a Structure, the last one names a slot of the Structure reached.
fn: lmx_walk_descend (@: Lmx start; @: Lmx code; size_t: first; @@: Lmx holder; @: size_t index) int
    @: Lmx at start
    size_t: i first
    size_t: last
    if: start = 0 || code = 0 || holder = 0 || index = 0 || code\len < 1
        return: c.LMX_WALK_INVALID
    last: (cast: (size_t) code\len) - 1U
    if: first > last
        return: c.LMX_WALK_INVALID
    while: i < last
        at: lmx_arena_ref_struct(at, lmx_size_value_known(lmx_arena_ref_value(code, i)))
        if: at = 0
            return: c.LMX_WALK_INVALID
        i: i + 1U
    ---
    \holder: at
    \index: lmx_size_value_known(lmx_arena_ref_value(code, last))
return: c.LMX_WALK_OK

# A plain path Structure [up, i0 .. ik]: `up` lexical parents of the reserved node first.
fn: lmx_walk_path (@: LmxWalkFrame f; @: Lmx path; @@: Lmx holder; @: size_t index) int
    @: Lmx at 0
    size_t: up
    if: f = 0 || path = 0 || path\len < 2
        return: c.LMX_WALK_INVALID
    at: f\node
    up: lmx_size_value_known(lmx_arena_ref_value(path, 0U))
    while: up != 0U
        if: at = 0
            return: c.LMX_WALK_INVALID
        at: at\node
        up: up - 1U
    ---
    if: at = 0
        return: c.LMX_WALK_INVALID
return: lmx_walk_descend(at, path, 1U, holder, index)

# The slot an `own` node names, from the reserved node down.
fn: lmx_walk_own_slot (@: LmxWalkFrame f; @: Lmx own) @@: void
    @: Lmx holder 0
    size_t: index 0U
    if: lmx_walk_descend(f\node, own, 1U, @ holder, @ index) != c.LMX_WALK_OK
        return: 0
return: lmx_arena_ref_cell(holder, index)

fn: lmx_walk_own_find (@: LmxWalkFrame f; @@: void from) @: LmxWalkOwn
    @: LmxWalkOwn o 0
    size_t: i 0U
    if: f = 0 || from = 0
        return: 0
    while: i < f\nowns
        o: f\owns + i
        if: o\from = from
            return: o
        i: i + 1U
    ---
return: 0

# ---- entry: load the own fields this body uses (21.5) ----------------------------------

fn: lmx_walk_scan_node (@: LmxWalkFrame f; @: void node) int
    @: LmxWalkOwn o 0
    @: Lmx code 0
    @@: void from 0
    int: op
    int: status c.LMX_WALK_OK
    size_t: i
    op: lmx_walk_op(f, node)
    if: op = c.LMX_WALK_OP_NONE
        return: c.LMX_WALK_INVALID
    # A bare LmxOp has no operands, so it names no own field.
    if: lmx_range_classify(f\arena, node) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_OK
    code: (cast: (@: Lmx) node)
    if: op = c.LMX_WALK_OP_OWN
        if: f\counting != 0
            f\cap: f\cap + 1U
            return: c.LMX_WALK_OK
        from: lmx_walk_own_slot(f, code)
        if: from = 0 || from[0] = 0
            return: c.LMX_WALK_INVALID
        if: lmx_walk_own_find(f, from) != 0
            return: c.LMX_WALK_OK
        if: f\nowns >= f\cap
            return: c.LMX_WALK_INVALID
        o: f\owns + f\nowns
        o\from: from
        o\value: lmx_int_value_known(from[0])
        o\dirty: 0
        f\nowns: f\nowns + 1U
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_LIT || op = c.LMX_WALK_OP_ARG || op = c.LMX_WALK_OP_AT
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_IF || op = c.LMX_WALK_OP_WHILE
        status: lmx_walk_scan_node(f, lmx_arena_ref_value(code, 1U))
        i: 2U
        while: status = c.LMX_WALK_OK && i < (cast: (size_t) code\len)
            status: lmx_walk_scan(f, lmx_arena_ref_struct(code, i), 0U)
            i: i + 1U
        ---
        return: status
    # put [put, path, value], call [call, path | M, arg ...]: child 1 is not a node.
    i: 1U
    if: op = c.LMX_WALK_OP_PUT || op = c.LMX_WALK_OP_CALL
        i: 2U
    while: status = c.LMX_WALK_OK && i < (cast: (size_t) code\len)
        status: lmx_walk_scan_node(f, lmx_arena_ref_value(code, i))
        i: i + 1U
    ---
return: status

# The children of a body from `first` on: frame nodes are scanned, everything else is data.
fn: lmx_walk_scan (@: LmxWalkFrame f; @: Lmx code; size_t: first) int
    @: void child 0
    int: status c.LMX_WALK_OK
    size_t: i first
    if: code = 0
        return: c.LMX_WALK_INVALID
    while: status = c.LMX_WALK_OK && i < (cast: (size_t) code\len)
        child: lmx_arena_ref_value(code, i)
        if: lmx_walk_op(f, child) != c.LMX_WALK_OP_NONE
            status: lmx_walk_scan_node(f, child)
        i: i + 1U
    ---
return: status

# ---- checkpoint (21.6): dirty only, in load order, a failed store is a failure ---------

fn: lmx_walk_checkpoint (@: LmxWalkFrame f) int
    @: LmxWalkOwn o 0
    size_t: i 0U
    if: f = 0
        return: c.LMX_WALK_INVALID
    while: i < f\nowns
        o: f\owns + i
        if: o\dirty != 0
            if: o\from = 0 || lmx_int_store_known(o\from[0], o\value) != 0
                return: c.LMX_WALK_CHECKPOINT
            o\dirty: 0
        ---
        i: i + 1U
    ---
return: c.LMX_WALK_OK

# ---- execution -------------------------------------------------------------------------

fn: lmx_walk_call (@: LmxWalkFrame f; @: Lmx code; @: int out) int
    @: Lmx holder 0
    @: Lmx callee 0
    @: int argv 0
    size_t: index 0U
    size_t: n
    size_t: i 0U
    int: status c.LMX_WALK_OK
    if: code\len < 2
        return: c.LMX_WALK_INVALID
    # child 1 is either the callee M itself (lmx_interp_exec's form: the copier remaps it
    # with the rest of M's tree) or a path that selects it by position.
    callee: lmx_arena_ref_struct(code, 1U)
    if: lmx_call_ready(f\arena, callee) != c.LMX_CALL_OK
        status: lmx_walk_path(f, callee, @ holder, @ index)
        if: status != c.LMX_WALK_OK
            return: status
        callee: lmx_arena_ref_struct(holder, index)
    ---
    if: callee = 0
        return: c.LMX_WALK_INVALID
    n: (cast: (size_t) code\len) - 2U
    if: n != 0U
        argv: (cast: (@: int) calloc(n, c.sizeof(int)))
        if: argv = 0
            return: c.LMX_WALK_NOMEM
    ---
    while: status = c.LMX_WALK_OK && i < n
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, i + 2U), argv + i)
        i: i + 1U
    ---
    # 21.6: dirty values are published before every outbound call, and nothing is
    # reloaded after it.
    if: status = c.LMX_WALK_OK
        status: lmx_walk_checkpoint(f)
    if: status = c.LMX_WALK_OK
        status: lmx_walk_run(f\arena, callee, argv, n, out)
    if: argv != 0
        free((cast: (@: void) argv))
    ---
return: status

fn: lmx_walk_eval (@: LmxWalkFrame f; @: void node; @: int out) int
    @: LmxWalkOwn o 0
    @: Lmx code 0
    @: Lmx holder 0
    @: void cell 0
    size_t: index 0U
    int: op
    int: a 0
    int: b 0
    int: going 1
    int: status c.LMX_WALK_OK
    if: f = 0 || node = 0 || out = 0
        return: c.LMX_WALK_INVALID
    op: lmx_walk_op(f, node)
    if: op = c.LMX_WALK_OP_NONE
        return: c.LMX_WALK_INVALID
    if: lmx_range_classify(f\arena, node) != c.LMX_KIND_STRUCT
        # A bare LmxOp: only a void return has no operands.
        if: op != c.LMX_WALK_OP_RET
            return: c.LMX_WALK_INVALID
        status: lmx_walk_checkpoint(f)
        if: status = c.LMX_WALK_OK
            f\returned: 1
        return: status
    code: (cast: (@: Lmx) node)
    if: op = c.LMX_WALK_OP_LIT
        cell: lmx_arena_ref_value(code, 1U)
        if: cell = 0
            return: c.LMX_WALK_INVALID
        \out: lmx_int_value_known(cell)
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_OWN
        # The working value of this activation: no reload from the graph (21.5).
        o: lmx_walk_own_find(f, lmx_walk_own_slot(f, code))
        if: o = 0
            return: c.LMX_WALK_INVALID
        \out: o\value
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_ARG
        index: lmx_size_value_known(lmx_arena_ref_value(code, 1U))
        if: index >= f\nargs || f\args = 0
            return: c.LMX_WALK_INVALID
        \out: f\args[index]
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_AT
        status: lmx_walk_path(f, lmx_arena_ref_struct(code, 1U), @ holder, @ index)
        if: status != c.LMX_WALK_OK
            return: status
        cell: lmx_arena_ref_value(holder, index)
        if: cell = 0
            return: c.LMX_WALK_INVALID
        \out: lmx_int_value_known(cell)
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_PUT
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 2U), @ a)
        if: status != c.LMX_WALK_OK
            return: status
        status: lmx_walk_path(f, lmx_arena_ref_struct(code, 1U), @ holder, @ index)
        if: status != c.LMX_WALK_OK
            return: status
        cell: lmx_arena_ref_value(holder, index)
        if: cell = 0 || lmx_int_store_known(cell, a) != 0
            return: c.LMX_WALK_INVALID
        \out: a
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_SET
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 2U), @ a)
        if: status != c.LMX_WALK_OK
            return: status
        if: lmx_walk_op(f, lmx_arena_ref_value(code, 1U)) != c.LMX_WALK_OP_OWN
            return: c.LMX_WALK_INVALID
        o: lmx_walk_own_find(f, lmx_walk_own_slot(f, lmx_arena_ref_struct(code, 1U)))
        if: o = 0
            return: c.LMX_WALK_INVALID
        # An executed assignment, and the only thing that sets dirty (21.6).
        o\value: a
        o\dirty: 1
        \out: a
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_ADD || op = c.LMX_WALK_OP_SUB || op = c.LMX_WALK_OP_LT || op = c.LMX_WALK_OP_EQ
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), @ a)
        if: status != c.LMX_WALK_OK
            return: status
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 2U), @ b)
        if: status != c.LMX_WALK_OK
            return: status
        if: op = c.LMX_WALK_OP_ADD
            \out: a + b
        if: op = c.LMX_WALK_OP_SUB
            \out: a - b
        if: op = c.LMX_WALK_OP_LT
            \out: (cast: (int) (a < b))
        if: op = c.LMX_WALK_OP_EQ
            \out: (cast: (int) (a = b))
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_IF
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), @ a)
        if: status != c.LMX_WALK_OK
            return: status
        \out: 0
        if: a != 0
            return: lmx_walk_body(f, lmx_arena_ref_struct(code, 2U), 0U)
        if: code\len > 3
            return: lmx_walk_body(f, lmx_arena_ref_struct(code, 3U), 0U)
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_WHILE
        \out: 0
        while: going != 0
            status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), @ a)
            if: status != c.LMX_WALK_OK || a = 0
                going: 0
            if: going != 0
                status: lmx_walk_body(f, lmx_arena_ref_struct(code, 2U), 0U)
                if: status != c.LMX_WALK_OK || f\returned != 0
                    going: 0
                ---
            ---
        ---
        return: status
    if: op = c.LMX_WALK_OP_RET
        # One exit order: evaluate the argument -> dirty-only checkpoint -> return.
        if: code\len > 1
            status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), @ a)
            if: status != c.LMX_WALK_OK
                return: status
            f\result: a
            f\valued: 1
        ---
        status: lmx_walk_checkpoint(f)
        if: status != c.LMX_WALK_OK
            return: status
        f\returned: 1
        \out: a
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_CALL
        return: lmx_walk_call(f, code, out)
    ---
return: c.LMX_WALK_INVALID

# The children of a body from `first` on, in order.  Own cells and anything that is not
# a frame node are data, not steps.  An executed return ends the walk of every enclosing
# body of this activation.
fn: lmx_walk_body (@: LmxWalkFrame f; @: Lmx body; size_t: first) int
    @: void child 0
    int: ignored 0
    int: status c.LMX_WALK_OK
    size_t: i first
    if: f = 0 || body = 0
        return: c.LMX_WALK_INVALID
    while: status = c.LMX_WALK_OK && f\returned = 0 && i < (cast: (size_t) body\len)
        child: lmx_arena_ref_value(body, i)
        if: lmx_walk_op(f, child) != c.LMX_WALK_OP_NONE
            status: lmx_walk_eval(f, child, @ ignored)
        i: i + 1U
    ---
return: status

fn: lmx_walk_run (@: LmxArena arena; @: Lmx node; @: int args; size_t: nargs; @: int result) int
    LmxWalkFrame: frame
    @: LmxWalkFrame f 0
    int: status
    int: steps 0
    size_t: i 1U
    if: arena = 0 || node = 0
        return: c.LMX_WALK_INVALID
    if: lmx_call_ready(arena, node) != c.LMX_CALL_OK
        return: c.LMX_WALK_INVALID
    f: @ frame
    memset((cast: (@: void) f), 0, c.sizeof(c.LmxWalkFrame))
    f\arena: arena
    f\node: node
    f\args: args
    f\nargs: nargs
    # The body is M after child[0].  With no frame node there, there is nothing to walk.
    while: i < (cast: (size_t) node\len)
        if: lmx_walk_op(f, lmx_arena_ref_value(node, i)) != c.LMX_WALK_OP_NONE
            steps: steps + 1
        i: i + 1U
    ---
    if: steps = 0
        return: c.LMX_WALK_NO_GRAPH
    # Entry (21.5): first count the own references of the body, then load each distinct
    # field once, in the order the body meets them.
    f\counting: 1
    status: lmx_walk_scan(f, node, 1U)
    if: status != c.LMX_WALK_OK
        return: status
    if: f\cap != 0U
        f\owns: (cast: (@: LmxWalkOwn) calloc(f\cap, c.sizeof(c.LmxWalkOwn)))
        if: f\owns = 0
            return: c.LMX_WALK_NOMEM
    ---
    f\counting: 0
    status: lmx_walk_scan(f, node, 1U)
    if: status = c.LMX_WALK_OK
        status: lmx_walk_body(f, node, 1U)
    # Falling off the end is an exit too: dirty values are published (21.6).
    if: status = c.LMX_WALK_OK && f\returned = 0
        status: lmx_walk_checkpoint(f)
    if: status = c.LMX_WALK_OK && f\valued != 0 && result != 0
        \result: f\result
    if: f\owns != 0
        free((cast: (@: void) f\owns))
    ---
return: status
