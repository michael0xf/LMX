# Witness (step 21.6, R117): the entry is the path of a body. With the entry Case\run the root is only a
# description and is not executed; the body run, a Structure nested in Case, is launched by the ordinary call
# without actuals, its data is its parent: `data\seen` is Case\seen.
Case:
    int: seen 0
    run:
        data\seen := 5
