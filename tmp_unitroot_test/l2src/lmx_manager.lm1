predef: "l2src/lmx_manager.h.lm1"
predef: "l2src/lmx_implements.h.lm1"
predef: "l2src/lmx_turn.lm1"

# lmx_manager.lm1 - the schedule, and one step of running over it.
#
# A step: take the next record, run one turn of its object, tick the record's wait,
# and put the record back while the letter is still running.  Nothing blocks, and
# nothing runs forever: the wait has its own limit (lmx_schedule) and a round is
# bounded by the caller's tick budget.

fn: lmx_manager_init (@: LmxManager m) int
    if: m = 0
        return: c.LMX_MANAGER_INVALID
    m\head: 0
    m\tail: 0
    m\count: 0U
    # The stepped binding: this implementation walks the objects itself.  The running
    # binding fills the same six slots with its own functions (lmx_manager_running).
    m\api.init: lmx_manager_init
    m\api.add: lmx_manager_add
    m\api.remove: lmx_manager_remove
    m\api.take: lmx_manager_take
    m\api.count: lmx_manager_count
    m\api.step: lmx_manager_step
    m\api.round: lmx_manager_round
return: c.LMX_MANAGER_OK

# The interface the manager is bound to.  A caller that holds this holds the manager's
# API and calls through it, whichever implementation is behind it.
fn: lmx_manager_api (@: LmxManager m) @: LmxManagerApi
    if: m = 0
        return: 0
return: @ m\api

# A record joins the schedule only if its owner really is an executable object --
# the domain question, asked of the address in the record's OWN band (the arena its cells were taken
# from and the arena its turn boundary will collect), not assumed from the caller.  A record that is
# already queued is refused: `next` is the queue link and a record cannot be in two places.
fn: lmx_manager_add (@: LmxManager m; @: LmxSchedule slot) int
    if: m = 0 || slot = 0 || slot\next != 0
        return: c.LMX_MANAGER_INVALID
    if: lmx_domain_kind(slot\arena, slot\owner) != c.LMX_DOMAIN_KIND_THREAD
        return: c.LMX_MANAGER_INVALID
    ---
    if: m\tail = 0
        m\head: slot
    else:
        m\tail\next: slot
    m\tail: slot
    m\count: m\count + 1U
return: c.LMX_MANAGER_OK

# A record leaves the schedule.  The walk is the queue's own list, and what it fixes is the ONE
# thing a settle needs: a record whose storage is about to be released must not stay queued, or a
# later step would run a turn on freed cells (the reclaim of a re-rooted orphan is exactly that
# case).  A record that is not in this queue is refused rather than quietly forgotten.
fn: lmx_manager_remove (@: LmxManager m; @: LmxSchedule slot) int
    @: LmxSchedule walk
    @: LmxSchedule before
    if: m = 0 || slot = 0
        return: c.LMX_MANAGER_INVALID
    if: m\head = slot
        m\head: slot\next
        if: m\head = 0
            m\tail: 0
        ---
        slot\next: 0
        m\count: m\count - 1U
        return: c.LMX_MANAGER_OK
    ---
    before: m\head
    walk: m\head
    while: walk != 0
        if: walk = slot
            before\next: slot\next
            if: m\tail = slot
                m\tail: before
            ---
            slot\next: 0
            m\count: m\count - 1U
            return: c.LMX_MANAGER_OK
        ---
        before: walk
        walk: walk\next
    ---
return: c.LMX_MANAGER_INVALID

fn: lmx_manager_take (@: LmxManager m) @: LmxSchedule
    @: LmxSchedule slot
    if: m = 0 || m\head = 0
        return: 0
    slot: m\head
    m\head: slot\next
    if: m\head = 0
        m\tail: 0
    slot\next: 0
    m\count: m\count - 1U
return: slot

fn: lmx_manager_count (@: LmxManager m) size_t
    if: m = 0
        return: 0U
return: m\count

fn: lmx_manager_step (@: LmxManager m; ulong: now) int
    @: LmxSchedule slot
    @: LmxThread t
    if: m = 0
        return: c.LMX_MANAGER_INVALID
    slot: lmx_manager_take(m)
    if: slot = 0
        return: c.LMX_MANAGER_EMPTY
    t: (cast: (@: LmxThread) slot\owner)
    # One turn of the object: the boundary, its body, the boundary -- the manager names no handler
    # of its own, so the body is the callable the object's own graph names (lmx_thread_turn).  A
    # Message that names none runs nothing, which is a legitimate state.  The band the turn's
    # boundary collects is the record's own, and the record was handed to this queue knowing it.
    lmx_thread_turn(t, 0, now)
    # The record ages against the cycle's reading, handed down by the caller: this unit
    # asks no clock.
    lmx_schedule_tick(slot, now)
    if: lmx_schedule_state(slot) = c.LMX_SCHEDULE_OVERDUE
        return: c.LMX_MANAGER_OK
    if: lmx_thread_running(t) = 0
        # The object ended: this record is no longer this queue's, so the driver's last act is the
        # thread's own -- a successful incarnation returns its arena (lmx_thread.lm1,
        # lmx_thread_finish).  Nothing of `t` is read after it.
        lmx_thread_finish(t)
        return: c.LMX_MANAGER_OK
    if: lmx_manager_add(m, slot) != c.LMX_MANAGER_OK
        return: c.LMX_MANAGER_INVALID
return: c.LMX_MANAGER_OK

# A bounded pass.  It stops at the budget even if work remains, so a caller can
# never be held by the schedule; an empty schedule is a normal end of a pass, not
# an error.
fn: lmx_manager_round (@: LmxManager m; unsigned: ticks; ulong: now) int
    unsigned: i
    int: code
    if: m = 0 || ticks = 0U
        return: c.LMX_MANAGER_INVALID
    i: 0U
    while: i < ticks
        code: lmx_manager_step(m, now)
        if: code = c.LMX_MANAGER_EMPTY
            return: c.LMX_MANAGER_OK
        if: code != c.LMX_MANAGER_OK
            return: code
        i: i + 1U
    ---
return: c.LMX_MANAGER_OK
