# K03 NS-ROLES-VIS (the author, 2026-10-07; semantics #declaration-visibility): a qualified branch's root is an
# ordinary named Structure, visible from its place on -- for every reader of it (a merge operand, a reference
# binding), as for a field path.
# A root statement above the branch merges it: cfg is no operand there, refused.
R: merge: cfg
independent:
    const:
        immutable:
            (): cfg
                size_t: e 7U
            end: cfg
        end: immutable
    end: const
end: independent
fn: go () int
    if: R\e != 7U
        return: 81
    return: 7
end: go
sendMessage: exit(exit_code: go(); stdout: ""; stderr: "")
return
