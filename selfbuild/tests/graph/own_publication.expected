---
    Observed:
        int: first 21
        int: published 1
        int: second 21
    end: Observed
---
fn: pair (int: a; int: b) int
    return: ((a * 10) + b)
end: pair
fn: work () int (
    int: x 1
    int: seen 0
)
    :=: x 2
    :=: seen (pair x ((work \ data) \ x))
    return: seen
end: work
int: first (work)
int: published ((work \ data) \ x)
int: second (work)
sub: observe ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ first) first
    :=: ((shared \ Observed) \ published) published
    :=: ((shared \ Observed) \ second) second
end: observe
observe:
