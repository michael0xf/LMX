# FABLE-SONNET-OCC-ROOT-20260924-146: mytest declares only two occurrences of
# arg (indices 0 and 1) -- a third, mytest\[2]arg, must be a located refusal,
# not a silent wrong read.
fn: mytest (int: arg) int
    arg: 1
    arg: 2
    return: 0
end: mytest

int: got
got: mytest(0)
if: mytest\[2]arg != 0
    return: 81
return: 0
