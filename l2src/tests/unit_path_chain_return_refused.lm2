# A method-rooted path that goes on through a number, M\k\q, is refused where it stands even as a `return:` value, a
# position the check does not look at: the emitter refuses the path the check would refuse, in its words, instead of
# reading M\k and writing `\q` out raw after it (C that did not compile).
fn: M () int
    int: k 0
    k: 3
    return: 0
end: M
fn: peek () int
    M()
    return: M\k\q
end: peek
int: r 0
r: peek()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
