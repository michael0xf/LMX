# GROKBOT-NESTED-BODY-WITNESSES-20260922-69: C-style for-arm nested body Structure hosts own.  Read
# back through read_shared's node\shared: the root's bare shared keeps its working value (book §12).
int: shared

fn: write_for_nested () int
    for: int(i, 0) (i < 1) i++
        int: hosted 4
        node\shared: 41
    end: for
    return: 0
end: write_for_nested

fn: read_shared () int
    return: node\shared
end: read_shared

int: ignored
shared: 3
ignored: write_for_nested()
if: ignored != 0
    sendMessage: exit(exit_code: ignored; stdout: ""; stderr: "")
    return
ignored: read_shared()
if: ignored != 41
    sendMessage: exit(exit_code: 75; stdout: ""; stderr: "")
    return
if: write_for_nested\for\hosted != 4 || write_for_nested\for\i != 1 || shared != 3
    sendMessage: exit(exit_code: 86; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
