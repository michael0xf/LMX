predef: "l2src/lmx_clock.h.lm1"
predef: "l2src/lmx_posix_abi.h.lm1"

# The cycle's clock. One reading and one difference, nothing else: a record's arithmetic
# stays in the record, and the platform is asked in exactly one place.
#
# The reading is milliseconds of CLOCK_MONOTONIC. lmx_clock_word casts that reading
# straight to size_t, not through lmx_clock_ticks: on a host where ulong is narrower
# than size_t the truncation would be zero-extended, and a modular deadline test at
# the wider width would answer "not yet" for a whole half-range after the wrap.

fn: lmx_clock_read () uint64_t
    LmxPosixTimespec: ts
    uint64_t: sec
    uint64_t: nsec
    if: c.clock_gettime(c.CLOCK_MONOTONIC, @ ts) != 0
        return: 0U
    ---
    sec: (cast: (uint64_t) c.ts.tv_sec)
    nsec: (cast: (uint64_t) c.ts.tv_nsec)
return: sec * 1000U + nsec / 1000000U

fn: lmx_clock_now () uint64_t
return: lmx_clock_read()

fn: lmx_clock_ticks () ulong
return: (cast: (ulong) lmx_clock_read())

fn: lmx_clock_since (uint64_t: start) uint64_t
    uint64_t: now
    now: lmx_clock_read()
    if: now < start
        return: 0U
    ---
return: now - start

fn: lmx_clock_word () size_t
return: (cast: (size_t) lmx_clock_read())

fn: lmx_clock_half () size_t
    size_t: zero 0U
return: (zero - 1U) / 2U + 1U

fn: lmx_deadline_passed (size_t: deadline; size_t: now) int
    if: now - deadline < lmx_clock_half()
        return: 1
return: 0

fn: lmx_deadline_wait (size_t: deadline; size_t: now) size_t
    if: lmx_deadline_passed(deadline, now) != 0
        return: 0U
return: deadline - now
