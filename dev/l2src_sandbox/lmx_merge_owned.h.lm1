predef: "l2src/lmx.h.lm1"
include: "<stddef.h>" "<limits.h>"
predef: "l2src/lmx_arena.h.lm1"
predef: "lmx_graph_copy_owned.h.lm1"

# Runtime merge over the accepted used-graph copier (SPEC 2.3/21, user
# decisions 2026-09-12). Merge takes live operand Structures left to right and
# an optional body Structure whose fields follow the operand children, and
# produces a THIRD INDEPENDENT Structure. The operands are never written: two
# structures in, three out.
#
# With a null override map the result's direct slots are, in order, the copies
# of each operand's direct children, operand by operand and child by child, then
# the body's fields (flat append). With a non-null map (Q21 = A): the model
# (operands[0]) keeps its layout; each pair stores an operand field's value into
# a model slot; unmatched later-operand fields append; body fields append. The
# operand ROOTS are not visible result slots; only their children are.
#
# ONE lmx_graph_copy_many_owned operation, hence one operation-local map, spans
# every ordinary operand root and the body root together. An object reachable
# from two operands is therefore copied ONCE and both references point at that
# one copy; cross-operand aliases and cycles keep their shape; every copied
# Structure's parent is rewritten to the copy of its structural parent or to zero.
# k.4: every operand is an ordinary Structure; a shared reference (a Structure whose
# parent lies outside the copied set -- Q22 = II) stays a terminal by address, decided
# structurally by the copier, never by a domain classification or a list the caller
# passes in. An operand that does not classify as a Structure is refused.
#
# Qualification is an address-domain property.  A caller may name any number of ordinary
# graph receiver-expressions whose physical addresses denote full
# independent+const+immutable profiles.  Only exact membership in an array carrying one of
# those physical profiles retains an address; another profile with identical kind/type, an
# unprofiled independent root, foreign ownership, and sealing all take the copy path.
# A retained foreign address must already be visible through an explicit sealed-range import
# in dst_arena. Only sealed ranges may be retained; merge never adopts their storage or
# installs a hidden range view. The caller supplies the profiles as a call-bounded span of
# physical Lmx references. Duplicates are idempotent; no global set, numeric qualifier or
# textual identity participates.
#
# TWO arenas, because the act has two sides: `src_arena` is the arena the
# operands, the body and the container live in and answers every classification
# question; `dst_arena` is the arena the copies and the result are built in.
#
# `container` is the live Structure through which the merge receiver executed.
# It becomes the RESULT's parent and nothing else: it is not assigned as the parent
# of any copied child, whose parent links come from the map. A nonzero container
# must classify as a Structure of src_arena -- the arena's table answers that,
# not an inventory -- and a foreign address is refused rather than stored.
#
# Atomicity is the arena's own act, exactly as it is for one Array: merge takes
# `mark: lmx_arena_mark(dst_arena)` before it builds anything and reverts to it
# on any failure, so the copies, the result root and its slots join dst_arena
# together or none of them does. On any failure out stays null, the destination
# arena is left as it was at the mark, every source graph is unchanged. There is
# no empty-success substitute for a failed merge.
# One override pair from the translator: store operand[k].field[j]'s value into
# the model's slot of the result (Q21 = A specialization). Null map / count 0
# keeps today's flat append. The graph has no names; the translator resolves
# matches and hands pairs of positions.
struct: LmxMergePair
    size_t: model_slot
    size_t: operand
    size_t: field
end: LmxMergePair

define: LMX_MERGE_OK 0
define: LMX_MERGE_INVALID 1
define: LMX_MERGE_NOMEM 2
define: LMX_MERGE_UNSUPPORTED 3

prototype:
    # Exposed so the overflow boundary can be exercised directly: a width
    # past INT_MAX is not constructible as a live Structure in a test
    # without fabricating a header, and a fabricated header would test the
    # fake rather than the guard.
    fn: lmx_merge_add_width (@: size_t total; @: Lmx x) int
    # `overrides` null or override_count 0 = flat append (today). Non-null: model
    # (operands[0]) layout kept; each pair writes operand[k].field[j] into the
    # model's slot; unmatched later-operand fields append; body appends as today.
    fn: lmx_merge_owned (@@: Lmx operands; size_t: count; @: Lmx body; @: Lmx container; @: char dst_chars; @: LmxArena src_arena; @: LmxArena dst_arena; @@: LmxMergePair overrides; size_t: override_count; @@: Lmx out) int
    fn: lmx_merge_profiles_owned (@@: Lmx operands; size_t: count; @: Lmx body; @: Lmx container; @: char dst_chars; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @@: LmxMergePair overrides; size_t: override_count; @@: Lmx out) int
    # `retain_profile` is the exact physical profile representing the full
    # independent+const+immutable receiver chain.  No other profile/lifecycle/owner
    # property retains an address.
    fn: lmx_merge_profiled_owned (@@: Lmx operands; size_t: count; @: Lmx body; @: Lmx container; @: char dst_chars; @: LmxArena src_arena; @: LmxArena dst_arena; @: Lmx retain_profile; @@: LmxMergePair overrides; size_t: override_count; @@: Lmx out) int
    # One pair's value, copied from src's own field into dst's own slot -- shared by
    # lmx_merge_profiles_owned's override path and lmx_merge_into_profiles_owned.
    fn: lmx_merge_apply_pair (@: Lmx src; size_t: field; @: Lmx dst; size_t: target_slot) int
    # -194 к.3 (Q26.1 / Q1): merge INTO an already-existing target -- op's fields are
    # copied and written into target's existing slots (target keeps its address and its
    # own parent; nothing is built fresh). The pair map must be an exact bijection onto a
    # subset of target's slots: pair_count = op's own width, no source field or target
    # slot repeated (target's layout is fixed once built, so an unmatched op field is
    # INVALID, never appended). A target slot no pair names is left untouched.
    fn: lmx_merge_into_profiles_owned (@: Lmx target; @: Lmx op; @: char dst_chars; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @@: LmxMergePair pairs; size_t: pair_count) int
    fn: lmx_merge_into_owned (@: Lmx target; @: Lmx op; @: char dst_chars; @: LmxArena src_arena; @: LmxArena dst_arena; @@: LmxMergePair pairs; size_t: pair_count) int
    # -174 c3: walk PRIM entry for Model: m (see lmx_walk.h.lm1).
    fn: lmx_walk_merge_model (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    # -194 к.6 (K2): decodes a translator-built pair-map Structure (3 size_t children per
    # pair) into the LmxMergePair** shape the kernel's own merge functions take; freed by
    # lmx_walk_merge_pairs_free. Shared by both walk PRIM entries below.
    fn: lmx_walk_merge_pairs_decode (@: LmxArena arena; @: Lmx pairs_s; @@@: LmxMergePair out_pairs; @: size_t out_count) int
    fn: lmx_walk_merge_pairs_free (@@: LmxMergePair pairs; size_t: n) void
    # -194 к.6: walk PRIM entry for a fresh multi-operand merge with an override map,
    # `R: merge: A B ... [body]` -- [prim, record, op0, ..., opN-1, body_or_0, pairs_or_0].
    # к.b (-202): each operand's lmx_range_profile, when nonzero, is collected and passed
    # to lmx_merge_profiles_owned as retain_profiles -- classified by the arena alone,
    # matching what the native emission already does (l2trans.lm1:20390-20399).
    fn: lmx_walk_merge_map (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    # -194 к.6: walk PRIM entry for merge INTO an existing target (Q26.1's own-field
    # write, `o\inner: a`) -- [prim, record, target, op, pairs]; \out is always 0.
    fn: lmx_walk_merge_into_map (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
end: prototype
