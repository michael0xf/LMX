---
    Observed:
        int: r1 3
        int: r2 200
        int: c 1
    end: Observed
---
@: shared (data [] 0)
fn: name (int: x) int (
    int: calls 0
)
    :=: (data \ calls) ((data \ calls) + 1)
    return: (x * 100)
end: name
fn: (:= name k3) (:= args ((int a))) (:= return int) (:= code ((return (a + 2))))
int: r1 (k3 1)
int: r2 (name 2)
int: c ((name \ data) \ calls)
sub: main ()
    :=: ((shared \ Observed) \ r1) r1
    :=: ((shared \ Observed) \ r2) r2
    :=: ((shared \ Observed) \ c) c
end: main
main:
