---
    Observed:
        int: r 7
        int: rx 7
    end: Observed
---
int: x 10
fn: w () int
    @: p int (@ x)
    :=: x 7
    return: (\ p)
end: w
int: r (w)
int: rx x
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ r) r
    :=: ((shared \ Observed) \ rx) rx
end: main
main:
