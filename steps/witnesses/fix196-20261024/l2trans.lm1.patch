+# L1's existing import rule: only a bare filename is relative to its includer. Explicit paths keep their spelling.
+# The quoted result uses the existing kept-text owner; no source/predef AST is changed, and no filesystem fallback
+# chooses another file. The four predef readers apply this to every nested import; the collector applies it to a
+# unit's and each part's own imports, so emitted L1 also names the dependency actually queried.
+fn: l2_predef_import (const: @(LmP0Text quoted); const: @(char source_path)) const: @: LmP0Text
+    size_t: n
+    size_t: i 0U
+    size_t: length
+    size_t: slash 0U
+    size_t: maximum (cast: (size_t) -1)
+    @: char data
+    LmP0Text: joined
+    @: LmP0Text kept
+    if: quoted = 0 || quoted\data = 0 || quoted\length < 2U
+        return: quoted
+    if: quoted\data[0] != 34 || quoted\data[quoted\length - 1U] != 34 || source_path = 0
+        return: quoted
+    n: quoted\length - 2U
+    if: n = 0U || (n >= 2U && quoted\data[2] = 58)
+        return: quoted
+    i: 1U
+    while: i <= n
+        if: quoted\data[i] = 47 || quoted\data[i] = 92
+            return: quoted
+        i: i + 1U
+    ---
+    length: strlen(source_path)
+    i: 0U
+    while: i < length
+        if: source_path[i] = 47 || source_path[i] = 92
+            slash: i + 1U
+        i: i + 1U
+    ---
+    if: slash = 0U && length >= 2U && source_path[1] = 58
+        slash: 2U
+    if: slash = 0U
+        return: quoted
+    if: quoted\length = maximum || slash > maximum - quoted\length - 1U
+        l2_alloc_err: 2
+        return: 0
+    data: (cast: (@: char) l2_xmalloc(quoted\length + slash + 1U))
+    if: data = 0
+        return: 0
+    data[0]: 34
+    memcpy(data + 1U, source_path, slash)
+    memcpy(data + 1U + slash, quoted\data + 1U, quoted\length - 1U)
+    data[quoted\length + slash]: 0
+    joined.data: data
+    joined.length: quoted\length + slash
+    kept: l2_cnt_keep(@ joined)
+    l2_xfree((cast: (@: void) data))
+    if: kept = 0 && l2_alloc_err = 0
+        l2_alloc_err: 1
+return: kept
+
