        held[2] := PythonGate\fromValue\run(context := context; session := session; value := PythonInteger\make(6))
        count := 3
        held[3] := PythonGate\call\run(context := context; session := session; callable := held[1]; args := (held[2]); kwargs := (copy(())))
        count := 4
        private: @PythonValue: result PythonGate\toValue\run(context := context; session := session; handle := held[3]; maxDepth := 1; maxItems := 1)
        return: PythonIntegerRead\read(result)

# Expected actual execution result: 720. No Python source string or eval.
# Four handles are held in a preallocated cleanup stack; no allocation follows
# native result publication before its reference is recorded.

# Second fixture: the application supplies score(x) = 2*x in this Python
# session after LMX translation. Its name has no corresponding LMX receiver.
PythonDirectExample:
    @PythonGateContext: context
    @PythonSession: session
    required: context session
    return: i64
    run:
        throws: copy(PythonBridgeThrows)
        private: @PythonHandle: answer py.score(21)
        finally:
            PythonGate\release\run(context; session; answer)
        private: @PythonValue: result PythonGate\toValue\run(context; session; answer; 1; 1)
