                throw: MapFailure("byte view advance")
            bytes\begin += amount
            bytes\count -= amount
        else:
            if: amount < 0 - bytes\begin
                throw: MapFailure("byte view rewind")
            bytes\begin += amount
            bytes\count -= amount
        return: bytes

