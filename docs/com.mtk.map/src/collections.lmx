    int: end
    required: vector begin end
    return: @
    range:
        throws: copy(MapThrows)
        if: begin < 0 || end < begin || end > length(vector)
            throw: MapFailure("vector range")
        @: out (copy(()))
        sys\resize(out; end - begin)
        int: i begin
        while: i < end
            out[i - begin] := vector[i]
            i += 1
        return: out

