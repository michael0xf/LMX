# Slice 283 probe: a Structure with no result called where the signature reads one.  Entry 7.
NoResult:
    int: unused_name_kept_out 0
end: NoResult
Places:
    fn: f () int
        return: 1
    end: f
end: Places
int: Hw 0
fn: write_free () int
    @: Places\f Hw
    ---
        int: r Places\f()
        return: r
        catch: call ()
            return: 22
        catch: interpreter ()
            return: 23
        catch: implements ()
            return: 24
        catch: convert ()
            return: 25
    ---
end: write_free
fn: run () int
    @: Hw NoResult NoResult
    return: write_free()
end: run
int: code 7
int: got run()
if: got != 22
    code: got
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
