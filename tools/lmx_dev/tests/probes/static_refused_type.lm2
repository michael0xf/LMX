# Valid for P0, refused by the hosted L2 CHECK: a bitwise operation on a reference (a reference where a number is
# asked). The refusal is the suite's own, tests/bits/bit_reference_refused.lm2: at 3:5.
fn: run (@: p char) int
    if: (p & 1U) != 0U
        return: 1
    return: 7
end: run
send: exit(exit_code: run("x"); stdout: ""; stderr: "")
return
