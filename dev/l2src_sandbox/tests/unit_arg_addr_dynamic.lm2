# FABLE-L2-ARG-ADDRESS-PROOF-20260921-84.  The same rule for a HIDDEN/DYNAMIC input.
#
# A free name read before the body's own same-name binding line is a dynamic input: the callee
# gets the caller's current value in a hidden formal, and the body's declaration (or an earlier
# assignment) is its binding line -- exactly the shape of a declared formal, so exactly the rule:
#
#   sticky  <=>  `@: x` was EVALUATED before x's first EXECUTED binding line, and that line then ran.
#
# The matrix is run twice, for int and for size_t.  int is the case that was silently WRONG: its
# storage code was also the dynamic-input code for "not typed yet", so an int was never passed at
# all -- the callee read its OWN graph field (the first line was IA1 1 1 with the caller holding 3).
# size_t already worked and pins that nothing moved.
#
# Each line is "<case> <local> <graph field>".  Callees come before `outer`: an explicit WRITE
# `node\x: v` resolves x in the FIRST method that has such a field, and the caller has one too.
fn: poke5 (@: int p) int
    \p: 5
    return: 0
end: poke5
fn: poke9 (@: int p) int
    \p: 9
    return: 0
end: poke9
fn: pokez5 (@: size_t p) int
    \p: 5U
    return: 0
end: pokez5
fn: pokez9 (@: size_t p) int
    \p: 9U
    return: 0
end: pokez9
fn: nop () int
    return: 0
end: nop

# BEFORE the binding line: sticky.  IA2 and IA4 follow no address-taking call, and an explicit
# graph write sits between each of them and the previous publication.
fn: int_before () int
    nop()
    poke5(@: ia)
    int: ia
    ia: ia + 1
    nop()
    c.printf: "IA1 %d %d\n" ia node\ia
    node\ia: 100
    nop()
    c.printf: "IA2 %d %d\n" ia node\ia
    poke9(@: ia)
    c.printf: "IA3 %d %d\n" ia node\ia
    node\ia: 200
    nop()
    nop()
    c.printf: "IA4 %d %d\n" ia node\ia
    return: 0
end: int_before

# NEVER BOUND when go = 0: the declaration is at method level (readable) and an early return
# skips it.  Nothing is published before the binding line in either activation.
fn: int_never (int: go) int
    poke5(@: ib)
    node\ib: 100
    nop()
    nop()
    c.printf: "IB %d %d\n" ib node\ib
    if: go = 0
        return: 0
    int: ib
    ib: ib + 1
    node\ib: 200
    nop()
    c.printf: "IB+ %d %d\n" ib node\ib
    return: 0
end: int_never

# AFTER the binding line: ordinary.  The read in the condition is what makes `ic` a dynamic input
# here -- it is neither an address nor a binding.
fn: int_after () int
    if: ic = 0
        return: 0
    int: ic
    ic: ic + 1
    nop()
    c.printf: "IC1 %d %d\n" ic node\ic
    poke9(@: ic)
    c.printf: "IC2 %d %d\n" ic node\ic
    node\ic: 100
    nop()
    c.printf: "IC3 %d %d\n" ic node\ic
    return: 0
end: int_after

fn: size_before () int
    nop()
    pokez5(@: za)
    size_t: za
    za: za + 1U
    nop()
    c.printf: "ZA1 %d %d\n" (cast: (int) za) (cast: (int) node\za)
    node\za: 100U
    nop()
    c.printf: "ZA2 %d %d\n" (cast: (int) za) (cast: (int) node\za)
    pokez9(@: za)
    c.printf: "ZA3 %d %d\n" (cast: (int) za) (cast: (int) node\za)
    node\za: 200U
    nop()
    nop()
    c.printf: "ZA4 %d %d\n" (cast: (int) za) (cast: (int) node\za)
    return: 0
end: size_before

fn: size_never (int: go) int
    pokez5(@: zb)
    node\zb: 100U
    nop()
    nop()
    c.printf: "ZB %d %d\n" (cast: (int) zb) (cast: (int) node\zb)
    if: go = 0
        return: 0
    size_t: zb
    zb: zb + 1U
    node\zb: 200U
    nop()
    c.printf: "ZB+ %d %d\n" (cast: (int) zb) (cast: (int) node\zb)
    return: 0
end: size_never

fn: size_after () int
    if: zc = 0U
        return: 0
    size_t: zc
    zc: zc + 1U
    nop()
    c.printf: "ZC1 %d %d\n" (cast: (int) zc) (cast: (int) node\zc)
    pokez9(@: zc)
    c.printf: "ZC2 %d %d\n" (cast: (int) zc) (cast: (int) node\zc)
    node\zc: 100U
    nop()
    c.printf: "ZC3 %d %d\n" (cast: (int) zc) (cast: (int) node\zc)
    return: 0
end: size_after

# The caller holds every name as its own field.  Its values never change: a dynamic input is a
# copy, and the address a callee takes is the address of that copy.
fn: outer () int
    int: ia
    int: ib
    int: ic
    size_t: za
    size_t: zb
    size_t: zc
    ia: 3
    ib: 3
    ic: 3
    za: 3U
    zb: 3U
    zc: 3U
    int_before()
    int_never(0)
    int_never(1)
    int_never(0)
    int_after()
    size_before()
    size_never(0)
    size_never(1)
    size_never(0)
    size_after()
    c.printf: "CALLER %d %d %d %d %d %d\n" ia ib ic (cast: (int) za) (cast: (int) zb) (cast: (int) zc)
    return: 0
end: outer

fn: main () int
    outer()
    return: 0
end: main
