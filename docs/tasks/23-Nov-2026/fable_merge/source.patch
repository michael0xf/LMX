+        "kind": 1,
+        "text": "b",
+        "width": 4
+      },
+      {
+        "kind": 2,
+        "text": "c",
+        "width": 12
+      }
+    ]
+  ],
+  "result": [
+    [
+      2,
+      [
+        {
+          "kind": 2,
