# Both initialized and implicit int-reference places keep working targets.
sub: main () (
    int: x 40
    int: y 41
    @: q int @(data\x)
    int: seen 0
    int: published 0
    int: rseen 0
)
    @: r int @(data\x)
    q := @(data\y)
    r := @(data\y)
    seen := \q
    published := \(data\q)
    rseen := \r
main()
int: seen main\data\seen
int: published main\data\published
int: rseen main\data\rseen
int: q \(main\data\q)
int: r \(main\data\r)
