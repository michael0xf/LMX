# implements-port slice 11 (B2; REVIEW f2a1578, fable_pc's M37/P37): unit_s7_prim_cross over its own
# convert.lm2 whose last row lacks a cell (tests/unit_s7_conv_partial_table.lm2): refused at `rows:`,
# "table rows are not whole rows of its columns" -- a partial row never falls out silently.

fn: go () int
    int: a 1
    size_t: b 2U
    a: b
    return: a

int: k
k: go()
if: k = 2
    sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
return
