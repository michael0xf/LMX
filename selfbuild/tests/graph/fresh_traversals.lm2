# Each traversal applies the receiver fn anew in its own initially clean namespace (the author 2026-11-09): the graph
# keeps the declaration as written, and the Structure named mark -- with its own var copied from the written one --
# exists only in the traversal that created it. Run twice, the second run's mark counts from the written 0 again.
fn: mark () int (int: calls 0)
    calls := calls + 1
    return: calls
end: mark
fn: twice () int
    int: first mark()
    int: second mark()
    return: first * 10 + second
end: twice
int: last 0
int: pair 0
last := mark()
pair := twice()
