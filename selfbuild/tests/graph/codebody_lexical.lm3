# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: result 0
        int: computed_result 0
)
@: shared data[0]
fn: leaf () int
    return: 90
fn: outer () int (int: inside 0; int: outside 0)
    if: 0 ()
    else: (fn: leaf () int (return: 7); inside := leaf())
    outside := leaf()
    return: inside * 100 + outside
int: result outer()
fn: computed () int (
    prepared:
        args: ()
        return: int
        code: (return: 8)
    int: inside 0
    int: outside 0
)
    if: 0 ()
    else: (fn: leaf prepared; inside := leaf())
    outside := leaf()
    return: inside * 100 + outside
int: computed_result computed()

sub: main ()
    shared\Observed\result := result
    shared\Observed\computed_result := computed_result
main()
