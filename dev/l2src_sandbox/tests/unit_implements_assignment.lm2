# Adapted from lingvamyxa_prev/tests/trans_implements_assignment.lm2.
# Remaining P0 of an assignment that never field-follows Equatable is empty
# uses: true. Fat Equatable as consumer is false for Plain.

Plain:
    size_t: toString 0U
end: Plain

Equatable:
    size_t: equals 0U
end: Equatable

ThinConsumer:
    size_t: extra 0U
end: ThinConsumer

fn: m () int
    size_t: q
    q: 1U
    return: 0
end: m

fn: main () int
    if: implements(Plain, Equatable, ThinConsumer) != 1
        return: 1
    if: implements(Plain, Equatable, Equatable) != 0
        return: 2
    return: 0
end: main
