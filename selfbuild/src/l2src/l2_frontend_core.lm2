        store: "lmx_size_store_known"
        if: c.sprintf(lit, "%zuU", nsf_val_cell[0][fx]) < 0
            return: (cast: (int) (1))
        ---
    if: nsf_kind_cell[0][fx] = 7
        newf: "lmx_int_new_profiled"
        store: "lmx_int_store_known"
