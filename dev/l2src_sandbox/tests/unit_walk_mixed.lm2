# -193 T4a, widened by T4b class 2. `bind` and `native_caller` assign a formal: that first store
# reads the argument and writes the field, and the return reads the field. Both are walked.
# wrap calls bind; native_caller calls leaf. Success is 0 (102 then 10).
fn: bind (int: n) int
    n: n + 100
    return: n
end: bind

fn: wrap (int: v) int
    int: got
    got: bind(v)
    return: got + 1
end: wrap

fn: leaf (int: v) int
    return: v * 2
end: leaf

fn: native_caller (int: v) int
    v: v + 0
    return: leaf(v)
end: native_caller

int: r
r: wrap(1)
if: r != 102
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
r: native_caller(5)
if: r != 10
    sendMessage: exit(exit_code: 82; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
