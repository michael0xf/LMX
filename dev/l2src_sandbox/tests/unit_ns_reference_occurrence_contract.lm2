# Distinct reference fields retain their own pointee contracts. These cells
# remain null: the two dormant readers verify the contracts without following
# either null pointer at runtime.
First: (size_t: left 1U)
Last: (size_t: right 7U)
Holder: (@: firstRef First; @: lastRef Last)
fn: readLast () size_t
return: Holder\lastRef\right
fn: readFirst () size_t
return: Holder\firstRef\left
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
