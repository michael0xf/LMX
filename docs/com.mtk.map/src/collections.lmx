        return: previous

MapVectorInsert:
    @: vector
    int: index
    @: value
    required: vector index value
    return: int
    insert:
        throws: copy(MapThrows)
        int: count length(vector)
        if: index < 0 || index > count
            throw: MapFailure("insert index")
        int: nextSize MapSize\sum(count; 1)
        sys\resize(vector; nextSize)
        int: i count
        while: i > index
            vector[i] := vector[i - 1]
            i -= 1
        vector[index] := value
        return: index

MapVectorPush:
    @: vector
    @: value
    required: vector value
    return: int
    push:
        throws: copy(MapThrows)
        return: MapVector\insert(vector; length(vector); value)

MapVectorRemove:
    @: vector
    int: index
    required: vector index
    return: @
    remove:
        throws: copy(MapThrows)
        @: previous MapVector\get(vector; index)
        int: count length(vector)
        int: i index
        while: i + 1 < count
            vector[i] := vector[i + 1]
            i += 1
        sys\resize(vector; count - 1)
        return: previous

MapVectorIndexOf:
    @: vector
    @: value
    required: vector value
    return: int
    indexOf:
        throws: copy(MapThrows)
