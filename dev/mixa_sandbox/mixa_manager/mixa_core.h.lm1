include: "<stddef.h>"

# mixa_core.h.lm1 - cell + text rect (from mixa_core.h).
# unsigned char fields use a one-token alias (mixa_tiles_l2.h.lm1 precedent).

type: MixaCellByte unsigned char

enum: MixaStyle
    MIXA_STYLE_BOLD 1
    MIXA_STYLE_UNDERLINE 2
    MIXA_STYLE_REVERSE 4
end: MixaStyle

struct: MixaCell
    unsigned: codepoint
    MixaCellByte: fg
    MixaCellByte: bg
    MixaCellByte: flags
    MixaCellByte: width
    MixaCellByte: alpha
end: MixaCell

struct: MixaTextRect
    size_t: rows
    size_t: cols
    @: MixaCell cells
end: MixaTextRect
