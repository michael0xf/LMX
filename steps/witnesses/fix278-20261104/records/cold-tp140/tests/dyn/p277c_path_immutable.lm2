# The book, #qualification: a reached write to a protected place is refused before the place changes.  A Structure written through a path into an immutable value the formal holds.
Holder:
    Inner:
        int: y 3
    end: Inner
end: Holder
Other:
    int: z 9
    int: y 7
end: Other
fn: write (@: h Holder) int
    h\Inner: Other
    return: h\Inner\y
end: write
fn: m () int
    b: immutable: merge(Holder)
    int: seen write(b)
    return: 80
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
