        @: typed_head c.LmxOp (cast: (@: c.LmxOp) head)
        if: typed_head\code % c.LMX_WALK_OP_COUNT = c.LMX_WALK_OP_RET
            child: c.lmx_arena_ref_struct(frame, 1U)
