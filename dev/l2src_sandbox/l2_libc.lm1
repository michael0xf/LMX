predef: "l1src/libc_abi.lm1"

# The ONE place the L1 libc layer's own functions are DEFINED.
#
# Every function the layer takes from libc needs no body here: a declaration maps onto the
# C function itself.  What needs a body is what the layer ADDS -- today the two streams, so
# that a caller names a stream without the `c.` door.  Those two have to live in exactly one
# compiled unit: `predef:` pulls bodies into every module that names the file, so a body in
# l1src\libc_abi.lm1 would be defined once per user of the layer and collide at link time
# (caught by the gate on 2026-09-18: lmx_dec.o and lmx_dec_selftest.o both defined
# l1_stderr).  Hence: declarations in the layer, bodies here, this unit compiled once.

fn: l1_stdout () @: FILE
    return: c.stdout

fn: l1_stderr () @: FILE
    return: c.stderr
