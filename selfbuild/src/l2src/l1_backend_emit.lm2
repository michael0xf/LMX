            if: i + 1 >= argc
                c.fputs((cast: (const: @: char) usage), (cast: (@: c.FILE) c.stderr))
                return: (cast: (int) 1)
            unit_root_cell[0]: argv[i + 1]
            unit_root_set_cell[0]: 1
            i: i + 2
        else:
            if: npos >= 2
                c.fputs((cast: (const: @: char) usage), (cast: (@: c.FILE) c.stderr))
                return: (cast: (int) 1)
            if: npos = 0
                src_arg: argv[i]
            else:
                out_arg: argv[i]
            ---
            npos: npos + 1
            i: i + 1
        ---
    ---
    if: npos != 2
        c.fputs((cast: (const: @: char) usage), (cast: (@: c.FILE) c.stderr))
        return: (cast: (int) 1)
    return: (cast: (int) l1_translate((cast: (const: @: char) src_arg), (cast: (const: @: char) out_arg)))
end: l1_cli_main
