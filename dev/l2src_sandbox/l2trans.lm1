        fid: l2_for_find(last\value)
        if: fid >= 0 && l2_for_uchild[fid] = 0 - 2
            l2_rw_shell_fid: fid
        l2_rw_loops: l2_rw_loops + 1
        if: l2_rw_body(last\value\as\structure, node, 2) != 0
            l2_rw_shell_fid: -1
            l2_rw_loops: l2_rw_loops - 1
            l2_rw_leave(bsave)
            return: 1
        l2_rw_shell_fid: -1
        l2_rw_loops: l2_rw_loops - 1
        if: l2_rw_leave(bsave) != 0
            return: 1
        \made: 1
        if: l2_rw_put(into, slot, node) != 0
            return: 1
        return: 0
    ---
    # `for: int(i, a) (c) i++` + body (OPUS-WALKLOOP-20260929-11; the shape the native emission takes, l2_for_cstyle):
    # the counter's declaration is a step of its own before the loop, then FOR(c, body, step) -- the step writes
