# Note: green today (skipped branch); must stay green when slice (zh) lands
(
    Observed:
        int: x 0
        int: v 0
        int: y 0
        int: ticks 0
)
@: shared data[0]
fn: f (int: x; int: y 99) int (int: v 0)
    shared\Observed\x := x
    shared\Observed\v := v
    shared\Observed\y := y
    return: x
fn: tick () int
