            if: l2_prhs_lit = 0
                l2_pw: pw_n_cell[0]
                pw_n_cell[0]: pw_n_cell[0] + 1
                if: c.fprintf(out_cell[0], "%s@@: void l2_pw%d l2_pxp\n", ind, l2_pw) < 0
