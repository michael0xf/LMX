+fn: shape_int_parse (const: (@: word char); @: out int) int
+    size_t: i 0U
+    size_t: magnitude 0U
+    size_t: digit 0U
+    size_t: limit (cast: (size_t) c.INT_MAX)
+    int: negative 0
+    if: word = 0 || out = 0
+        return: 0
+    if: word[0] = 45
+        negative: 1
+        limit: limit + 1U
+        i: 1U
+    if: word[i] = 0
+        return: 0
+    while: word[i] != 0
+        if: word[i] < 48 || word[i] > 57
+            return: 0
+        digit: (cast: (size_t) (word[i] - 48))
+        if: magnitude > (limit - digit) / 10U
+            return: 0
+        magnitude: magnitude * 10U + digit
+        i: i + 1U
+    ---
+    if: negative != 0
+        if: magnitude = limit
+            \out: 0 - c.INT_MAX - 1
+        else:
+            \out: 0 - (cast: (int) magnitude)
+        ---
+    else:
+        \out: (cast: (int) magnitude)
+    ---
+    return: 1
+end: shape_int_parse
+
+fn: shape_spell_is (const: (@: text char); const: (@: word char)) int
+    int: n 0
+    int: i 0
+    if: text = 0 || word = 0
+        return: 0
+    if: c.strcmp(text, word) = 0
+        return: 1
+    if: text[0] != 34
+        return: 0
+    while: text[n] != 0
+        n: n + 1
+    if: n < 2 || text[n - 1] != 34
+        return: 0
+    while: word[i] != 0 && i + 1 < n && text[i + 1] = word[i]
+        i: i + 1
+    if: word[i] = 0 && i + 2 = n
+        return: 1
+    return: 0
+end: shape_spell_is
