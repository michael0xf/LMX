            return: (cast: (int) (c.lm_compiler_error(path, stmt, "unsupported body")))
        return: (cast: (int) (0))
    if: c.lm_compiler_text_eq(w, "sendMessage")
        return: (cast: (int) (c.lm_compiler_msend_register(stmt, path, mi, @ msk, @ msni)))
    if: c.lm_compiler_text_eq(w, "receiveMessage") && c.lm_compiler_receive_msg_shape(stmt, @ rnm, 0) = 2
        return: (cast: (int) (c.lm_compiler_error(path, stmt, "receiveMessage binds one or two names")))
    if: c.lm_compiler_text_eq(w, "for")
        return: (cast: (int) (c.lm_compiler_error(path, stmt, "unsupported loop")))
    return: (cast: (int) (c.lm_compiler_error(path, stmt, "unsupported body")))
end: lm_compiler_check_word_stmt

