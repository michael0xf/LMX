+# A formal-ordered borrowing projection of one written actual. The value
+# keeps the already owned grammar and nested path verdicts; the record owns
+# no P0 fields and no value children. written selects lexical evaluation
+# order,independent of formal coordinate. structured keeps a named body
+# which is not one expression as its written structural value.
+struct: L2ApplicationActual
+    L2ValueSpan: value
+    @: L2ValueSpan written
+    @: LmP0Node wrapper
+    int: rank
+    int: structured
+end: L2ApplicationActual
+
+# This short-lived semantic projection borrows its complete source owner.
+# Releasing it frees only actuals,never the owner's recursive grammar.
+struct: L2ApplicationActuals
+    @: L2ApplicationActual actuals
+    int: count
+    int: written_count
+end: L2ApplicationActuals
