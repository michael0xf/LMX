Meter:
    int: calls 0
    return: int
    next:
        node\calls += 1
        return: node\calls

Evaluation:
    return: int
    prepared:
        throws:
            FxArity
            FxIndex
            FxTypeToken
            FxKernelFailure
            SequenceSize
            ReceiverIndex
            FxLazyCycle
        @: delayed lazy(Meter\next)
        int: first delayed()
        int: second delayed()
        return: first + second
    raw:
        int: first Meter\next()
        int: second Meter\next()
        return: first + second
