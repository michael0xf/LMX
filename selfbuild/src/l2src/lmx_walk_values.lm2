# The walker's existing stateless value operations, shared by both engines.
# C records are the existing ABI; all graph storage comes from the explicit arena.
# No new role table, global binding, extra graph, numeric width or admission rule is added.
predef: "l2src/lmx_walk.h.lm1"
predef: "l2src/lmx_walk_state_decl.lm1"
predef: "l2src/lmx_call.h.lm1"
predef: "l2src/lmx_implements.h.lm1"
predef: "l2src/lmx_primitive.h.lm1"
predef: "l2src/lmx_source_names.h.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_array_owned.h.lm1"
predef: "l2src/lmx_chars.lm1"
predef: "l1src/libc_abi.lm1"
include: "<string.h>" "<limits.h>"

fn: lmx_walk_store_size (@: arena c.LmxArena; @: code c.Lmx; size_t: slot; size_t: value) int
    @: cell void (cast: (@: void) c.lmx_arena_take_profiled(arena, sizeof(value), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_SIZE_T, c.lmx_range_profile(arena, (cast: (@: void) code))))
    if: cell = 0
        return: c.LMX_WALK_NOMEM
    if: c.lmx_size_store_known(cell, value) != 0 || c.lmx_graph_ref_store_in(arena, code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
    return: c.LMX_WALK_OK
end: lmx_walk_store_size

fn: lmx_walk_store_int (@: arena c.LmxArena; @: code c.Lmx; size_t: slot; int: value) int
    @: cell void (cast: (@: void) c.lmx_arena_take_profiled(arena, sizeof(value), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT, c.lmx_range_profile(arena, (cast: (@: void) code))))
    if: cell = 0
        return: c.LMX_WALK_NOMEM
    if: c.lmx_int_store_known(cell, value) != 0 || c.lmx_graph_ref_store_in(arena, code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
    return: c.LMX_WALK_OK
end: lmx_walk_store_int

fn: lmx_walk_store_charptr (@: arena c.LmxArena; @: code c.Lmx; size_t: slot; @: value char) int
    @: cell void (cast: (@: void) c.lmx_arena_take_profiled(arena, sizeof(value), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR_PTR, c.lmx_range_profile(arena, (cast: (@: void) code))))
    if: cell = 0
        return: c.LMX_WALK_NOMEM
    if: c.lmx_charptr_store_known(cell, value) != 0 || c.lmx_graph_ref_store_in(arena, code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
    return: c.LMX_WALK_OK
end: lmx_walk_store_charptr

fn: lmx_walk_store_char (@: arena c.LmxArena; @: code c.Lmx; size_t: slot; int: value) int
    @: cell void 0
    @: value_profile c.Lmx 0
    if: arena = 0 || code = 0
        return: c.LMX_WALK_INVALID
    value_profile: (cast: (@: c.Lmx) c.lmx_range_profile(arena, (cast: (@: void) code)))
    if: value_profile != 0
        cell: (cast: (@: void) c.lmx_arena_take_profiled(arena, c.sizeof(c.char), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR, value_profile))
        if: cell = 0
            return: c.LMX_WALK_NOMEM
        if: c.lmx_char_store_known(cell, value) != 0
            return: c.LMX_WALK_INVALID
        ---
    else:
        if: c.lmx_chars_init(arena) != 0 && c.lmx_arena_find(arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR) = 0
            return: c.LMX_WALK_NOMEM
        cell: (cast: (@: void) c.lmx_char_cell(arena, value))
    ---
    if: cell = 0 || c.lmx_graph_ref_store_in(arena, code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
    return: c.LMX_WALK_OK
end: lmx_walk_store_char

fn: lmx_walk_store_unsigned (@: arena c.LmxArena; @: code c.Lmx; size_t: slot; unsigned: value) int
    @: cell void (cast: (@: void) c.lmx_arena_take_profiled(arena, sizeof(value), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_UNSIGNED, c.lmx_range_profile(arena, (cast: (@: void) code))))
    if: cell = 0
        return: c.LMX_WALK_NOMEM
    if: c.lmx_unsigned_store_known(cell, value) != 0 || c.lmx_graph_ref_store_in(arena, code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
    return: c.LMX_WALK_OK
end: lmx_walk_store_unsigned

fn: lmx_walk_store_ulong (@: arena c.LmxArena; @: code c.Lmx; size_t: slot; ulong: value) int
    @: cell void (cast: (@: void) c.lmx_arena_take_profiled(arena, sizeof(value), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_ULONG, c.lmx_range_profile(arena, (cast: (@: void) code))))
    if: cell = 0
        return: c.LMX_WALK_NOMEM
    if: c.lmx_ulong_store_known(cell, value) != 0 || c.lmx_graph_ref_store_in(arena, code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
    return: c.LMX_WALK_OK
end: lmx_walk_store_ulong

# Classify the value cell, never the payload a pointer happens to hold.
fn: lmx_walk_numeric_type (@: arena c.LmxArena; @: cell void) int
    int: kind 0
    int: ty 0
    int: base_type 0
    if: arena = 0 || cell = 0
        return: 0
    kind: (cast: (int) c.lmx_domain_kind(arena, cell))
    if: kind != c.LMX_KIND_PRIMITIVE
        return: 0
    ty: (cast: (int) c.lmx_domain_type(arena, cell))
    base_type: c.lmx_type_base(ty)
    if: base_type = c.LMX_TYPE_INT || base_type = c.LMX_TYPE_CHAR || base_type = c.LMX_TYPE_SIZE_T || base_type = c.LMX_TYPE_UNSIGNED || base_type = c.LMX_TYPE_ULONG || base_type = c.LMX_TYPE_UNSIGNED_CHAR
        return: ty
    return: 0
end: lmx_walk_numeric_type

fn: lmx_walk_load_numeric (@: arena c.LmxArena; @: cell void; @: out size_t) int
    int: base_type 0
    int: ty 0
    if: out = 0
        return: c.LMX_WALK_INVALID
    ty: lmx_walk_numeric_type(arena, cell)
    if: ty = 0
        return: c.LMX_WALK_INVALID
    base_type: c.lmx_type_base(ty)
    if: base_type = c.LMX_TYPE_INT
        \out: (cast: (size_t) c.lmx_int_value_known(cell))
        return: c.LMX_WALK_OK
    if: base_type = c.LMX_TYPE_CHAR
        \out: (cast: (size_t) c.lmx_char_value_known(cell))
        return: c.LMX_WALK_OK
    if: base_type = c.LMX_TYPE_UNSIGNED_CHAR
        \out: (cast: (size_t) c.lmx_uchar_value_known(cell))
        return: c.LMX_WALK_OK
    if: base_type = c.LMX_TYPE_SIZE_T
        \out: (cast: (size_t) c.lmx_size_value_known(cell))
        return: c.LMX_WALK_OK
    if: base_type = c.LMX_TYPE_UNSIGNED
        \out: (cast: (size_t) c.lmx_unsigned_value_known(cell))
        return: c.LMX_WALK_OK
    if: base_type = c.LMX_TYPE_ULONG
        \out: (cast: (size_t) c.lmx_ulong_value_known(cell))
        return: c.LMX_WALK_OK
    return: c.LMX_WALK_INVALID
end: lmx_walk_load_numeric

# Ordinary numeric stores reject interned char operands. A caller-proved raw
# destination below may hold char, including an activation's own numeric member.
fn: lmx_walk_store_numeric_into (@: arena c.LmxArena; @: cell void; size_t: value) int
    int: base_type 0
    int: ty lmx_walk_numeric_type(arena, cell)
    base_type: c.lmx_type_base(ty)
    if: c.lmx_range_write_exact_blocked(arena, cell, 0, 0, 0U) != 0
        return: c.LMX_WALK_INVALID
    if: ty = 0 || base_type = c.LMX_TYPE_CHAR
        return: c.LMX_WALK_INVALID
    if: base_type = c.LMX_TYPE_INT
        if: c.lmx_int_store_known(cell, (cast: (int) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: base_type = c.LMX_TYPE_SIZE_T
        if: c.lmx_size_store_known(cell, value) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: base_type = c.LMX_TYPE_UNSIGNED
        if: c.lmx_unsigned_store_known(cell, (cast: (unsigned) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: base_type = c.LMX_TYPE_ULONG
        if: c.lmx_ulong_store_known(cell, (cast: (ulong) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: base_type = c.LMX_TYPE_UNSIGNED_CHAR
        if: c.lmx_uchar_store_known(cell, (cast: (unsigned) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    return: c.LMX_WALK_INVALID
end: lmx_walk_store_numeric_into

fn: lmx_walk_store_numeric_raw (@: cell void; int: ty; size_t: value) int
    int: base_type 0
    base_type: c.lmx_type_base(ty)
    if: cell = 0 || base_type = 0
        return: c.LMX_WALK_INVALID
    if: base_type = c.LMX_TYPE_CHAR
        if: c.lmx_char_store_known(cell, (cast: (int) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: base_type = c.LMX_TYPE_INT
        if: c.lmx_int_store_known(cell, (cast: (int) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: base_type = c.LMX_TYPE_SIZE_T
        if: c.lmx_size_store_known(cell, value) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: base_type = c.LMX_TYPE_UNSIGNED
        if: c.lmx_unsigned_store_known(cell, (cast: (unsigned) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: base_type = c.LMX_TYPE_ULONG
        if: c.lmx_ulong_store_known(cell, (cast: (ulong) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: base_type = c.LMX_TYPE_UNSIGNED_CHAR
        if: c.lmx_uchar_store_known(cell, (cast: (unsigned) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    return: c.LMX_WALK_INVALID
end: lmx_walk_store_numeric_raw

sub: lmx_walk_value_clear (@: value c.LmxWalkValue)
    c.memset((cast: (@: void) value), 0, c.sizeof(c.LmxWalkValue))
end: lmx_walk_value_clear

fn: lmx_walk_value_ref_context (@: out c.LmxWalkValue; int: ty; @: ref void; @: context c.LmxWalkValue) int
    c.LmxWalkValue: saved
    @: saved_value c.LmxWalkValue @ saved
    c.lmx_value_context_copy(saved_value, context)
    lmx_walk_value_ref_parts(out, ty, ref, (cast: (@: c.Lmx) saved_value\model), (cast: (@: c.Lmx) saved_value\references))
    out\referent: (cast: (@: c.LmxWalkValue) saved_value\referent)
    return: c.LMX_WALK_OK
end: lmx_walk_value_ref_context

fn: lmx_walk_value_ref (@: out c.LmxWalkValue; int: ty; @: ref void) int
    return: lmx_walk_value_ref_parts(out, ty, ref, 0, 0)
end: lmx_walk_value_ref

fn: lmx_walk_value_ref_parts (@: out c.LmxWalkValue; int: ty; @: ref void; @: model c.Lmx; @: references c.Lmx) int
    lmx_walk_value_clear(out)
    out\present: 1
    out\kind: c.LMX_WALK_VALUE_REFERENCE
    out\type: ty
    out\ref: ref
    out\model: model
    out\references: references
    return: c.LMX_WALK_OK
end: lmx_walk_value_ref_parts

# Preserve the common receiving admission and the supplied model/reference pair.
fn: lmx_walk_value_admit (@: arena c.LmxArena; @: value c.LmxWalkValue; @: model c.Lmx; @: record c.Lmx) int
    @: references c.Lmx 0
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    if: value = 0 || value\present = 0
        return: c.LMX_WALK_OK
    if: value\kind != c.LMX_WALK_VALUE_REFERENCE || c.lmx_graph_node_in(arena, (cast: (@: void) model)) = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) record)) = 0
        return: c.LMX_WALK_INVALID
    @: fields c.VoidArray @ record\array
    if: fields\size != 6U
        return: c.LMX_WALK_INVALID
    references: (cast: (@: c.Lmx) c.lmx_graph_node_in(arena, c.lmx_graph_value_in(arena, record, 3U)))
    if: value\ref != 0
        if: value\model != 0 || value\references != 0
            status: c.lmx_implements_admit_receiving_parts(arena, (cast: (@: c.Lmx) value\ref), model, record, value\model, value\references, @ answer)
        else:
            status: c.lmx_implements_admit_receiving_frame(arena, (cast: (@: c.Lmx) value\ref), model, record, @ answer)
        ---
        if: status != c.LMX_WALK_OK
            return: status
        if: answer = c.LMX_IMPLEMENTS_NO
            return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_IMPLEMENTS
        ---
    ---
    value\type: c.LMX_TYPE_LMX
    value\model: model
    value\references: references
    return: c.LMX_WALK_OK
end: lmx_walk_value_admit

# Present null has real pointer-value storage; absent has none.
fn: lmx_walk_value_storage (@: value c.LmxWalkValue) @: void
    int: base_type 0
    if: value = 0 || value\present = 0
        return: 0
    if: value\kind = c.LMX_WALK_VALUE_FOREIGN
        return: (cast: (@: void) value\ref)
    if: value\kind = c.LMX_WALK_VALUE_REFERENCE
        return: (cast: (@: void) (@ value\ref))
    base_type: c.lmx_type_base(value\type)
    if: base_type = c.LMX_TYPE_INT
        return: (cast: (@: void) (@ value\number))
    if: base_type = c.LMX_TYPE_SIZE_T
        return: (cast: (@: void) (@ value\wide))
    if: base_type = c.LMX_TYPE_UNSIGNED
        return: (cast: (@: void) (@ value\natural))
    if: base_type = c.LMX_TYPE_ULONG
        return: (cast: (@: void) (@ value\longnum))
    if: base_type = c.LMX_TYPE_CHAR || base_type = c.LMX_TYPE_UNSIGNED_CHAR
        return: (cast: (@: void) (@ value\byte))
    return: 0
end: lmx_walk_value_storage

# Project complete already evaluated Values through an existing numeric
# prefix/suffix adapter. No expression, name, type conversion or admission
# is executed. The caller owns both vectors and their referent lifetimes;
# output storage is separate from the input vector. Padding stays absent.
# Regenerate refs from the copied records, never retain pointers into an
# earlier scalar Value. Foreign by-value records keep their exact C storage.
fn: lmx_walk_values_project (@: input_values c.LmxWalkValue; @@: input_refs void; size_t: input_count; size_t: first; @: output_values c.LmxWalkValue; @@: output_refs void; size_t: output_count) int
    @: source c.LmxWalkValue 0
    @: destination c.LmxWalkValue 0
    size_t: copied 0U
    size_t: i 0U
    if: first > input_count
        return: c.LMX_WALK_INVALID
    copied: input_count - first
    if: copied > output_count
        return: c.LMX_WALK_INVALID
    if: input_count > (cast: (size_t) -1) / c.sizeof(c.LmxWalkValue) || output_count > (cast: (size_t) -1) / c.sizeof(c.LmxWalkValue)
        return: c.LMX_WALK_NOMEM
    if: copied != 0U && (input_values = 0 || input_refs = 0)
        return: c.LMX_WALK_INVALID
    if: output_count != 0U && (output_values = 0 || output_refs = 0)
        return: c.LMX_WALK_INVALID
    # Validate the supplied full-Value ABI before changing output storage.
    # Unavailable metadata must not silently erase a real supplied argument.
    while: i < copied
        source: input_values + first + i
        if: input_refs[first + i] != lmx_walk_value_storage(source)
            return: c.LMX_WALK_INVALID
        i: i + 1U
    ---
    i: 0U
    while: i < output_count
        destination: output_values + i
        if: i < copied
            source: input_values + first + i
            c.memcpy((cast: (@: void) destination), (cast: (@: void) source), c.sizeof(c.LmxWalkValue))
        else:
            lmx_walk_value_clear(destination)
        ---
        output_refs[i]: lmx_walk_value_storage(destination)
        i: i + 1U
    ---
    return: c.LMX_WALK_OK
end: lmx_walk_values_project

fn: lmx_walk_value_foreign (@: value c.LmxWalkValue; @: storage void) int
    if: value = 0 || storage = 0
        return: c.LMX_WALK_INVALID
    lmx_walk_value_clear(value)
    value\present: 1
    value\kind: c.LMX_WALK_VALUE_FOREIGN
    value\ref: storage
    return: c.LMX_WALK_OK
end: lmx_walk_value_foreign

# Slice 255 (design 4.5 B2a): a contextual literal -- a number with no type of its own (LMX_TYPE_NONE; the magnitude in
# `wide`, the U spelling in `natural`).  It takes the type of the operand or of the place it meets (lmx_walk_value_bin,
# lmx_walk_value_receive), as the frontend's rw_unify types a literal statically from its neighbour; alone it is an int (U:
# unsigned).  Native code emits it for a literal in a runtime-typed expression; the walker makes one of a LIT operand beside a
# non-literal operand.
fn: lmx_walk_value_lit (@: out c.LmxWalkValue; size_t: magnitude; int: usuf) int
    if: out = 0
        return: c.LMX_WALK_INVALID
    lmx_walk_value_clear(out)
    out\present: 1
    out\kind: c.LMX_WALK_VALUE_NUMBER
    out\type: c.LMX_TYPE_NONE
    out\wide: magnitude
    out\natural: (cast: (unsigned) usuf)
    return: c.LMX_WALK_OK
end: lmx_walk_value_lit

fn: lmx_walk_value_num (@: out c.LmxWalkValue; int: ty; size_t: number) int
    # A number with no type is a contextual literal (slice 255).
    if: c.lmx_type_base(ty) = c.LMX_TYPE_NONE
        return: lmx_walk_value_lit(out, number, 0)
    lmx_walk_value_clear(out)
    out\present: 1
    out\kind: c.LMX_WALK_VALUE_NUMBER
    out\type: ty
    return: lmx_walk_store_numeric_raw(lmx_walk_value_storage(out), ty, number)
end: lmx_walk_value_num

fn: lmx_walk_value_number (@: value c.LmxWalkValue; @: number size_t; @: ty int) int
    int: base_type 0
    if: value = 0 || value\present = 0 || value\kind != c.LMX_WALK_VALUE_NUMBER
        return: c.LMX_WALK_INVALID
    \ty: value\type
    base_type: c.lmx_type_base(value\type)
    # A contextual literal (LMX_TYPE_NONE, slice 255): its magnitude.
    if: base_type = c.LMX_TYPE_NONE
        \number: value\wide
        return: c.LMX_WALK_OK
    if: base_type = c.LMX_TYPE_INT
        \number: (cast: (size_t) value\number)
    else:
        if: base_type = c.LMX_TYPE_SIZE_T
            \number: value\wide
        else:
            if: base_type = c.LMX_TYPE_UNSIGNED
                \number: (cast: (size_t) value\natural)
            else:
                if: base_type = c.LMX_TYPE_ULONG
                    \number: (cast: (size_t) value\longnum)
                else:
                    if: base_type = c.LMX_TYPE_CHAR
                        \number: (cast: (size_t) c.lmx_char_value_known((cast: (@: void) (@ value\byte))))
                    else:
                        if: base_type != c.LMX_TYPE_UNSIGNED_CHAR
                            return: c.LMX_WALK_INVALID
                        \number: (cast: (size_t) c.lmx_uchar_value_known((cast: (@: void) (@ value\byte))))
                    ---
                ---
            ---
        ---
    ---
    return: c.LMX_WALK_OK
end: lmx_walk_value_number

# The C99 integer promotion of a numeric base type: char and unsigned char become int (unsigned where they do not fit).
fn: lmx_walk_value_promoted (int: ty) int
    ty: c.lmx_type_base(ty)
    if: ty = c.LMX_TYPE_CHAR
        ty: c.LMX_TYPE_INT
        if: c.CHAR_MAX > c.INT_MAX
            ty: c.LMX_TYPE_UNSIGNED
    ---
    if: ty = c.LMX_TYPE_UNSIGNED_CHAR
        ty: c.LMX_TYPE_INT
        if: c.UCHAR_MAX > c.INT_MAX
            ty: c.LMX_TYPE_UNSIGNED
    ---
    return: ty
end: lmx_walk_value_promoted

# A contextual literal takes the type `ty` (LMX_TYPE_NONE: its own default); any other number is copied as it is.
fn: lmx_walk_value_adopt (@: value c.LmxWalkValue; int: ty; @: out c.LmxWalkValue) int
    size_t: magnitude 0U
    if: value = 0 || out = 0 || value\present = 0 || value\kind != c.LMX_WALK_VALUE_NUMBER
        return: c.LMX_WALK_INVALID
    if: c.lmx_type_base(value\type) != c.LMX_TYPE_NONE
        if: out != value
            c.memcpy((cast: (@: void) out), (cast: (@: void) value), c.sizeof(c.LmxWalkValue))
        return: c.LMX_WALK_OK
    if: c.lmx_type_base(ty) = c.LMX_TYPE_NONE
        ty: c.LMX_TYPE_INT
        if: value\natural != 0U
            ty: c.LMX_TYPE_UNSIGNED
    ---
    magnitude: value\wide
    return: lmx_walk_value_num(out, ty, magnitude)
end: lmx_walk_value_adopt

# A present number becomes a contextual literal of its magnitude (the walker's LIT operand beside a non-literal operand).
sub: lmx_walk_value_contextual (@: value c.LmxWalkValue)
    size_t: number 0U
    int: ty 0
    int: usuf 0
    if: value = 0 || value\present = 0 || value\kind != c.LMX_WALK_VALUE_NUMBER
        return
    if: lmx_walk_value_number(value, @ number, @ ty) != c.LMX_WALK_OK
        return
    ty: c.lmx_type_base(ty)
    if: ty = c.LMX_TYPE_UNSIGNED || ty = c.LMX_TYPE_SIZE_T || ty = c.LMX_TYPE_ULONG
        usuf: 1
    lmx_walk_value_lit(value, number, usuf)
    return
end: lmx_walk_value_contextual

# Slice 255 (design 4.5 B2a): the reception of a complete value by a place of type `ty` -- the one runtime admission of a
# runtime-typed value at a typed receiving place (a typed local or field, a return, a formal, a C-ABI actual, a store into a
# free input's place).  A number of the same base type, after a contextual literal has taken the place's type, or a reference
# of the same type is received with the place's type; anything else is the language's implicit `convert` throw -- the named
# refusal of a receiving contract -- never INVALID.  An absent value or a null argument is malformed (INVALID).
fn: lmx_walk_value_receive (@: value c.LmxWalkValue; int: ty; @: out c.LmxWalkValue) int
    c.LmxWalkValue: taken
    @: taken_p c.LmxWalkValue @ taken
    int: status
    if: value = 0 || out = 0 || c.lmx_type_base(ty) = c.LMX_TYPE_NONE || value\present = 0
        return: c.LMX_WALK_INVALID
    if: value\kind = c.LMX_WALK_VALUE_NUMBER
        status: lmx_walk_value_adopt(value, ty, taken_p)
        if: status != c.LMX_WALK_OK
            return: status
        if: c.lmx_type_base(taken_p\type) != c.lmx_type_base(ty)
            return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
        taken_p\type: ty
        c.memcpy((cast: (@: void) out), (cast: (@: void) taken_p), c.sizeof(c.LmxWalkValue))
        return: c.LMX_WALK_OK
    if: value\kind = c.LMX_WALK_VALUE_REFERENCE
        if: c.lmx_type_base(value\type) != c.lmx_type_base(ty)
            return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
        if: out != value
            c.memcpy((cast: (@: void) out), (cast: (@: void) value), c.sizeof(c.LmxWalkValue))
        return: c.LMX_WALK_OK
    if: value\kind = c.LMX_WALK_VALUE_FOREIGN && c.lmx_type_base(value\type) != c.lmx_type_base(ty)
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    return: c.LMX_WALK_INVALID
end: lmx_walk_value_receive

# Slice 260 (design 4.5 B2b-2c): the one receive of a graph place -- a Structure reference by the kernel's actual pointee, not by a
# type code: a native graph own's record carries the translator's pointer code (LMX_TYPE_POINTER_BASE + its Lmx code), a walked
# row or a typed place carries LMX_TYPE_LMX; both are the same reference when the referent is a Structure of the arena.  A
# number or a foreign value at a graph place, or a reference to anything but a Structure, is the type mismatch -- the implicit
# `convert` (the book :777; P1-NUMERIC-KIND); the null reference is admitted (present, ref 0).  The received value is typed LMX;
# the admission against the place's model follows (lmx_implements_admit_receiving natively, lmx_walk_value_admit walked).
fn: lmx_walk_value_receive_graph (@: arena c.LmxArena; @: value c.LmxWalkValue; @: out c.LmxWalkValue) int
    if: arena = 0 || value = 0 || out = 0 || value\present = 0
        return: c.LMX_WALK_INVALID
    if: value\kind = c.LMX_WALK_VALUE_NUMBER || value\kind = c.LMX_WALK_VALUE_FOREIGN
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    if: value\kind != c.LMX_WALK_VALUE_REFERENCE
        return: c.LMX_WALK_INVALID
    if: value\ref != 0 && c.lmx_type_base(value\type) != c.LMX_TYPE_LMX && c.lmx_range_classify(arena, value\ref) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    if: out != value
        c.memcpy((cast: (@: void) out), (cast: (@: void) value), c.sizeof(c.LmxWalkValue))
    out\type: c.LMX_TYPE_LMX
    return: c.LMX_WALK_OK
end: lmx_walk_value_receive_graph

# Both native and walked prefix signs consume the same actual numeric value.
# Promotion changes the result type, not the operand's stored type.
# Slice 260 (P1-NUMERIC-KIND): a present contextual literal 0 -- the NONE-typed number a statically typed program writes as the
# null literal beside a reference (`p = 0`) and lmx_walk_value_contextual leaves for the operation to type.
fn: lmx_walk_value_null_literal (@: value c.LmxWalkValue) int
    if: value = 0 || value\present = 0 || value\kind != c.LMX_WALK_VALUE_NUMBER
        return: 0
    if: c.lmx_type_base(value\type) != c.LMX_TYPE_NONE
        return: 0
    return: (cast: (int) (value\wide = 0U))
end: lmx_walk_value_null_literal

fn: lmx_walk_value_unary (int: op; @: value c.LmxWalkValue; @: out c.LmxWalkValue) int
    size_t: number 0U
    int: ty 0
    if: op != c.LMX_WALK_OP_NEG && op != c.LMX_WALK_OP_POS && op != c.LMX_WALK_OP_BNOT
        return: c.LMX_WALK_INVALID
    # Slice 260 (P1-NUMERIC-KIND): a present reference or foreign value under a sign is the type mismatch -- the implicit `convert`.
    if: value != 0 && value\present != 0 && (value\kind = c.LMX_WALK_VALUE_REFERENCE || value\kind = c.LMX_WALK_VALUE_FOREIGN)
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    if: lmx_walk_value_number(value, @ number, @ ty) != c.LMX_WALK_OK
        return: c.LMX_WALK_INVALID
    ty: c.lmx_type_base(ty)
    if: ty = c.LMX_TYPE_CHAR
        ty: c.LMX_TYPE_INT
        if: c.CHAR_MAX > c.INT_MAX
            ty: c.LMX_TYPE_UNSIGNED
    ---
    if: ty = c.LMX_TYPE_UNSIGNED_CHAR
        ty: c.LMX_TYPE_INT
        if: c.UCHAR_MAX > c.INT_MAX
            ty: c.LMX_TYPE_UNSIGNED
    ---
    if: op = c.LMX_WALK_OP_NEG
        number: 0U - number
    if: op = c.LMX_WALK_OP_BNOT
        # Unsigned word complement; the numeric store keeps the promoted width.
        number: 0U - number - 1U
    return: lmx_walk_value_num(out, ty, number)
end: lmx_walk_value_unary

# A reference payload is loaded once using its proved pointer-cell accessors;
# the cell's companion qualifies it only while it records that reference
# (lmx_value_loaded_context).
fn: lmx_walk_value_load (@: arena c.LmxArena; @: storage void; int: ty; @: out c.LmxWalkValue) int
    int: base_type 0
    c.LmxWalkValue: current
    @: current_value c.LmxWalkValue @ current
    c.LmxPointerCellRead: read c.lmx_pointer_value_known
    c.LmxPointerCellWrite: write c.lmx_pointer_store_known
    @: raw void 0
    if: storage = 0
        lmx_walk_value_clear(out)
        return: c.LMX_WALK_OK
    base_type: c.lmx_type_base(ty)
    if: base_type >= c.LMX_TYPE_POINTER_BASE || base_type = c.LMX_TYPE_LMX || base_type = c.LMX_TYPE_DESC || base_type = c.LMX_TYPE_CHAR_PTR
        if: c.lmx_value_cell_access(arena, storage, @ read, @ write) != 0 || read = 0
            return: c.LMX_WALK_INVALID
        raw: read(storage)
        return: lmx_walk_value_ref_context(out, ty, raw, c.lmx_value_loaded_context(c.lmx_pointer_cell_context(arena, storage), raw))
    lmx_walk_value_clear(current_value)
    current_value\present: 1
    current_value\kind: c.LMX_WALK_VALUE_NUMBER
    current_value\type: ty
    if: base_type = c.LMX_TYPE_INT
        current_value\number: (cast: (int) c.lmx_int_value_known(storage))
    else:
        if: base_type = c.LMX_TYPE_SIZE_T
            current_value\wide: (cast: (size_t) c.lmx_size_value_known(storage))
        else:
            if: base_type = c.LMX_TYPE_UNSIGNED
                current_value\natural: (cast: (unsigned) c.lmx_unsigned_value_known(storage))
            else:
                if: base_type = c.LMX_TYPE_ULONG
                    current_value\longnum: (cast: (ulong) c.lmx_ulong_value_known(storage))
                else:
                    if: base_type != c.LMX_TYPE_CHAR && base_type != c.LMX_TYPE_UNSIGNED_CHAR
                        return: c.LMX_WALK_INVALID
                    c.memcpy((cast: (@: void) (@ current_value\byte)), storage, c.sizeof(c.char))
                ---
            ---
        ---
    ---
    c.memcpy((cast: (@: void) out), (cast: (@: void) current_value), c.sizeof(c.LmxWalkValue))
    return: c.LMX_WALK_OK
end: lmx_walk_value_load

fn: lmx_walk_value_cell (@: arena c.LmxArena; @: cell void; @: out c.LmxWalkValue) int
    int: kind 0
    if: cell = 0
        return: lmx_walk_value_ref(out, c.LMX_TYPE_LMX, 0)
    kind: (cast: (int) c.lmx_domain_kind(arena, cell))
    if: kind = c.LMX_KIND_STRUCT
        return: lmx_walk_value_ref(out, c.LMX_TYPE_LMX, cell)
    if: kind = c.LMX_KIND_ARRAY
        return: lmx_walk_value_ref(out, c.LMX_TYPE_DESC, cell)
    if: kind != c.LMX_KIND_PRIMITIVE
        return: c.LMX_WALK_INVALID
    return: lmx_walk_value_load(arena, cell, (cast: (int) c.lmx_domain_type(arena, cell)), out)
end: lmx_walk_value_cell

# A raw Graph consumer needs only the projection of the same selected child.
# Full consumers keep the record returned by value_cell instead.
fn: lmx_walk_graph_value_ref (@: arena c.LmxArena; @: child void) @: void
    c.LmxWalkValue: value
    int: status lmx_walk_value_cell(arena, child, @ value)
    if: status != c.LMX_WALK_OK
        c.lmx_call_note_walk_fail(status)
        return: 0
    if: value\present = 0 || value\kind != c.LMX_WALK_VALUE_REFERENCE
        c.lmx_call_note_walk_fail(c.LMX_WALK_INVALID)
        return: 0
    return: (cast: (@: void) value\ref)
end: lmx_walk_graph_value_ref

# Persist a completed value as one ordinary arena-owned cell. Absence has no
# cell; a present null reference still has its typed cell and saved context.
fn: lmx_walk_value_materialize (@: arena c.LmxArena; @: value c.LmxWalkValue; @@: outcell void) int
    c.LmxWalkValue: saved
    @: cell void 0
    size_t: number 0U
    int: ty c.LMX_TYPE_NONE
    int: status
    if: outcell = 0
        return: c.LMX_WALK_INVALID
    if: value = 0
        outcell[0]: 0
        return: c.LMX_WALK_INVALID
    # The output may alias a member of the supplying record.
    c.memcpy((cast: (@: void) (@ saved)), (cast: (@: void) value), c.sizeof(c.LmxWalkValue))
    outcell[0]: 0
    if: saved\present = 0
        return: c.LMX_WALK_OK
    if: arena = 0 || arena\source_view != 0U
        return: c.LMX_WALK_INVALID
    if: saved\kind = c.LMX_WALK_VALUE_NUMBER
        status: lmx_walk_value_number(@ saved, @ number, @ ty)
        if: status != c.LMX_WALK_OK
            return: status
        cell: c.lmx_scalar_new_physical_profiled(arena, ty, 0)
        if: cell = 0
            return: c.LMX_WALK_NOMEM
        status: lmx_walk_store_numeric_raw(cell, ty, number)
        if: status != c.LMX_WALK_OK
            return: status
        ---
    else:
        if: saved\kind = c.LMX_WALK_VALUE_REFERENCE
            ty: (cast: (int) saved\type)
            if: c.lmx_type_reference_cell(ty) = 0
                return: c.LMX_WALK_INVALID
            cell: c.lmx_pointer_new_profiled(ty, arena, 0)
            if: cell = 0
                return: c.LMX_WALK_NOMEM
            if: c.lmx_pointer_fill_in(arena, cell, (cast: (@: void) saved\ref), @ saved) != 0
                return: c.LMX_WALK_INVALID
            ---
        else:
            # Exact by-value C objects retain their typed transport boundary.
            if: saved\kind = c.LMX_WALK_VALUE_FOREIGN
                return: c.LMX_WALK_UNSUPPORTED
            return: c.LMX_WALK_INVALID
        ---
    ---
    outcell[0]: cell
    return: c.LMX_WALK_OK
end: lmx_walk_value_materialize

fn: lmx_walk_native_numeric_lit (@: arena c.LmxArena; @: code c.Lmx; int: expected_type; @: out c.LmxWalkValue) int
    @: cell void 0
    int: status 0
    if: arena = 0 || code = 0 || out = 0 || c.lmx_domain_kind(arena, (cast: (@: void) code)) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_INVALID
    @: fields c.VoidArray @ code\array
    if: fields\size < 2U || c.lmx_walk_code_in(arena, c.lmx_graph_value_in(arena, code, 0U)) % c.LMX_WALK_OP_COUNT != c.LMX_WALK_OP_LIT
        return: c.LMX_WALK_INVALID
    if: expected_type != c.LMX_TYPE_INT && expected_type != c.LMX_TYPE_CHAR && expected_type != c.LMX_TYPE_SIZE_T && expected_type != c.LMX_TYPE_UNSIGNED && expected_type != c.LMX_TYPE_ULONG
        return: c.LMX_WALK_INVALID
    cell: (cast: (@: void) c.lmx_graph_value_in(arena, code, 1U))
    if: cell = 0
        return: c.LMX_WALK_INVALID
    status: lmx_walk_value_cell(arena, cell, out)
    # value_cell reads the actual typed primitive. Compare only its numeric
    # representation here, without changing the full source storage identity.
    if: status != c.LMX_WALK_OK || out\present = 0 || out\kind != c.LMX_WALK_VALUE_NUMBER || c.lmx_type_base((cast: (int) out\type)) != expected_type
        return: c.LMX_WALK_INVALID
    return: c.LMX_WALK_OK
end: lmx_walk_native_numeric_lit

# Slice 259 (design 4.5 B2b-2b): the bit width of a numeric type's machine representation (C99: the bits of its largest
# value, counted) -- the range of a shift count is [0, width of the left operand's promoted type).
fn: lmx_type_width (int: ty) int
    size_t: all 0U
    int: width 0
    ty: c.lmx_type_base(ty)
    if: ty = c.LMX_TYPE_INT || ty = c.LMX_TYPE_UNSIGNED
        all: (cast: (size_t) c.UINT_MAX)
    if: ty = c.LMX_TYPE_SIZE_T
        all: c.SIZE_MAX
    if: ty = c.LMX_TYPE_ULONG
        all: (cast: (size_t) c.ULONG_MAX)
    if: ty = c.LMX_TYPE_CHAR || ty = c.LMX_TYPE_UNSIGNED_CHAR
        all: (cast: (size_t) c.UCHAR_MAX)
    while: all != 0U
        all: all >> 1
        width: width + 1
    ---
    return: width
end: lmx_type_width

fn: lmx_walk_native_int_bin_check (@: arena c.LmxArena; @: code c.Lmx; @: op int) int
    int: current 0
    if: arena = 0 || code = 0 || op = 0 || c.lmx_domain_kind(arena, (cast: (@: void) code)) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_INVALID
    @: fields c.VoidArray @ code\array
    if: fields\size < 3U
        return: c.LMX_WALK_INVALID
    current: (cast: (int) (c.lmx_walk_code_in(arena, c.lmx_graph_value_in(arena, code, 0U)) % c.LMX_WALK_OP_COUNT))
    if: current != c.LMX_WALK_OP_ADD && current != c.LMX_WALK_OP_SUB && current != c.LMX_WALK_OP_MUL && current != c.LMX_WALK_OP_DIV && current != c.LMX_WALK_OP_MOD && current != c.LMX_WALK_OP_LT && current != c.LMX_WALK_OP_EQ
        return: c.LMX_WALK_INVALID
    \op: current
    return: c.LMX_WALK_OK
end: lmx_walk_native_int_bin_check

fn: lmx_walk_native_int_bin_apply (int: op; int: left; int: right; @: result int) int
    if: result = 0
        return: c.LMX_WALK_INVALID
    if: op = c.LMX_WALK_OP_ADD
        if: (right > 0 && left > c.INT_MAX - right) || (right < 0 && left < c.INT_MIN - right)
            return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
        \result: left + right
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_SUB
        if: (right < 0 && left > c.INT_MAX + right) || (right > 0 && left < c.INT_MIN + right)
            return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
        \result: left - right
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_MUL
        if: left > 0
            if: (right > 0 && left > c.INT_MAX / right) || (right < 0 && right < c.INT_MIN / left)
                return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
        ---
        if: left < 0
            if: (right > 0 && left < c.INT_MIN / right) || (right < 0 && left < c.INT_MAX / right)
                return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
        ---
        \result: left * right
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_DIV || op = c.LMX_WALK_OP_MOD
        if: right = 0 || (left = c.INT_MIN && right = 0 - 1)
            return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
        if: op = c.LMX_WALK_OP_DIV
            \result: left / right
        else:
            \result: left % right
        ---
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_LT
        \result: (cast: (int) (left < right))
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_EQ
        \result: (cast: (int) (left = right))
        return: c.LMX_WALK_OK
    # Slice 259 (design 4.5 B2b-2b; the ledger BITWISE-OPERATORS-NOT-CLASSIFIED): the bitwise operators on the promoted int
    # operands as C's; a shift whose count is outside [0, width) and a signed left shift that does not fit (a negative left,
    # a bit carried past the sign) are the machine contract's undefined operations: the implicit `interpreter` throw before
    # the operation, as a signed ADD's overflow.  A right shift of a negative int is the platform's (C99: implementation-defined),
    # as the native engine's operator.
    if: op = c.LMX_WALK_OP_BAND
        \result: left & right
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_BOR
        \result: left | right
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_BXOR
        \result: left ^ right
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_SHL || op = c.LMX_WALK_OP_SHR
        if: right < 0 || right >= lmx_type_width(c.LMX_TYPE_INT)
            return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
        if: op = c.LMX_WALK_OP_SHL
            if: left < 0 || left > (c.INT_MAX >> right)
                return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
            \result: left << right
        else:
            \result: left >> right
        ---
        return: c.LMX_WALK_OK
    return: c.LMX_WALK_INVALID
end: lmx_walk_native_int_bin_apply

# Slice 255 (design 4.5 B2a): the one binary operation of both executors over two complete values -- ADD, SUB, MUL, DIV, MOD,
# LT, EQ.  Presence; EQ of two references; the numeric projections; the C99 integer promotions; a contextual literal takes
# the other operand's promoted type (two literals: int, or unsigned when one is U-spelled); an int operation runs through
# lmx_walk_native_int_bin_apply (its overflow and zero divisor are THROWN + LMX_WALK_NAME_INTERPRETER: the walker raises its
# interpreter fault from them, native code its implicit throw); the other types compute in their own width as before.  Two
# numbers of different types are the language's implicit `convert` throw (the frontend refuses the static case as "mixed
# numeric types (a conversion)"), not INVALID; malformed operands stay INVALID.
fn: lmx_walk_value_bin (int: op; @: value c.LmxWalkValue; @: other c.LmxWalkValue; @: out c.LmxWalkValue) int
    size_t: ua 0U
    size_t: ub 0U
    size_t: wv 0U
    int: a 0
    int: b 0
    int: status 0
    int: native_num_result 0
    if: op != c.LMX_WALK_OP_ADD && op != c.LMX_WALK_OP_SUB && op != c.LMX_WALK_OP_MUL && op != c.LMX_WALK_OP_DIV && op != c.LMX_WALK_OP_MOD && op != c.LMX_WALK_OP_LT && op != c.LMX_WALK_OP_EQ && op != c.LMX_WALK_OP_BAND && op != c.LMX_WALK_OP_BOR && op != c.LMX_WALK_OP_BXOR && op != c.LMX_WALK_OP_SHL && op != c.LMX_WALK_OP_SHR
        return: c.LMX_WALK_INVALID
    if: value = 0 || other = 0 || out = 0 || value\present = 0 || other\present = 0
        return: c.LMX_WALK_INVALID
    if: op = c.LMX_WALK_OP_EQ && (value\kind = c.LMX_WALK_VALUE_REFERENCE || other\kind = c.LMX_WALK_VALUE_REFERENCE)
        if: value\kind = c.LMX_WALK_VALUE_REFERENCE && other\kind = c.LMX_WALK_VALUE_REFERENCE
            return: lmx_walk_value_num(out, c.LMX_TYPE_INT, (cast: (size_t) (value\ref = other\ref)))
        # Slice 260 (P1-NUMERIC-KIND, Codex 2026-11-02): one reference beside a number.  A contextual literal 0 (the NONE-typed
        # literal a statically typed program writes as `p = 0`, lmx_walk_value_contextual) is the null test of the reference,
        # as the typed program's null literal is a typed null reference; any other number beside a reference is the language's
        # type mismatch in the operation -- the implicit `convert` (the book :777), not a malformed operand.
        if: value\kind = c.LMX_WALK_VALUE_REFERENCE && lmx_walk_value_null_literal(other) != 0
            return: lmx_walk_value_num(out, c.LMX_TYPE_INT, (cast: (size_t) (value\ref = 0)))
        if: other\kind = c.LMX_WALK_VALUE_REFERENCE && lmx_walk_value_null_literal(value) != 0
            return: lmx_walk_value_num(out, c.LMX_TYPE_INT, (cast: (size_t) (other\ref = 0)))
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    ---
    # Slice 260 (P1-NUMERIC-KIND): a PRESENT operand of another kind where a number is asked -- a reference or a foreign value in
    # the arithmetic, the order comparison, the bitwise and shift operators -- is the implicit `convert` before the operation,
    # the runtime twin of the typed program's refusals («a reference where a number is asked», «arithmetic on a reference», «a
    # reference compared by order»); an unresolved or malformed operand stays the mechanical INVALID.
    if: value\kind = c.LMX_WALK_VALUE_REFERENCE || value\kind = c.LMX_WALK_VALUE_FOREIGN || other\kind = c.LMX_WALK_VALUE_REFERENCE || other\kind = c.LMX_WALK_VALUE_FOREIGN
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    if: lmx_walk_value_number(value, @ ua, @ a) != c.LMX_WALK_OK || lmx_walk_value_number(other, @ ub, @ b) != c.LMX_WALK_OK
        return: c.LMX_WALK_INVALID
    # C99 integer promotions concern representation, not storage family.
    # Operand cells retain their full physical IDs; this is a new result.
    a: lmx_walk_value_promoted(a)
    b: lmx_walk_value_promoted(b)
    # Slice 259 (design 4.5 B2b-2b): a shift's operands are promoted apart (C99 6.5.7): the result has the left's promoted
    # type, the count keeps its own; a contextual left literal is an int, or an unsigned by its suffix.  A count outside
    # [0, width of the left's type) is the machine contract's undefined shift: the implicit `interpreter` throw before the
    # operation in both executors (the ledger BITWISE-OPERATORS-NOT-CLASSIFIED); a negative count is outside as a size_t.
    if: op = c.LMX_WALK_OP_SHL || op = c.LMX_WALK_OP_SHR
        if: a = c.LMX_TYPE_NONE
            a: c.LMX_TYPE_INT
            if: value\natural != 0U
                a: c.LMX_TYPE_UNSIGNED
        ---
        if: ub >= (cast: (size_t) lmx_type_width(a))
            return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
        b: a
    ---
    if: a = c.LMX_TYPE_NONE && b = c.LMX_TYPE_NONE
        a: c.LMX_TYPE_INT
        if: value\natural != 0U || other\natural != 0U
            a: c.LMX_TYPE_UNSIGNED
        b: a
    ---
    if: a = c.LMX_TYPE_NONE
        a: b
    if: b = c.LMX_TYPE_NONE
        b: a
    if: a != b
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    if: a = c.LMX_TYPE_INT
        status: lmx_walk_native_int_bin_apply(op, (cast: (int) ua), (cast: (int) ub), @ native_num_result)
        if: status != c.LMX_WALK_OK
            return: status
        return: lmx_walk_value_num(out, c.LMX_TYPE_INT, (cast: (size_t) native_num_result))
    ---
    if: op = c.LMX_WALK_OP_LT
        return: lmx_walk_value_num(out, c.LMX_TYPE_INT, (cast: (size_t) (ua < ub)))
    if: op = c.LMX_WALK_OP_EQ
        return: lmx_walk_value_num(out, c.LMX_TYPE_INT, (cast: (size_t) (ua = ub)))
    if: op = c.LMX_WALK_OP_ADD
        wv: ua + ub
    if: op = c.LMX_WALK_OP_SUB
        wv: ua - ub
    if: op = c.LMX_WALK_OP_MUL
        wv: ua * ub
    if: op = c.LMX_WALK_OP_BAND
        wv: ua & ub
    if: op = c.LMX_WALK_OP_BOR
        wv: ua | ub
    if: op = c.LMX_WALK_OP_BXOR
        wv: ua ^ ub
    if: op = c.LMX_WALK_OP_SHL
        wv: ua << ub
    if: op = c.LMX_WALK_OP_SHR
        wv: ua >> ub
    # -170 c1 / D-58: a zero divisor in a complete operation raises the implicit interpreter throw.
    if: op = c.LMX_WALK_OP_DIV || op = c.LMX_WALK_OP_MOD
        if: ub = 0U
            return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
        if: op = c.LMX_WALK_OP_DIV
            wv: ua / ub
        else:
            wv: ua % ub
        ---
    ---
    return: lmx_walk_value_num(out, a, wv)
end: lmx_walk_value_bin

fn: lmx_walk_witness_type (@: arena c.LmxArena; @: witness void) int
    int: kind (cast: (int) c.lmx_domain_kind(arena, witness))
    if: kind = c.LMX_KIND_STRUCT
        return: c.LMX_TYPE_LMX
    if: kind = c.LMX_KIND_ARRAY
        return: c.LMX_TYPE_DESC
    return: (cast: (int) c.lmx_domain_type(arena, witness))
end: lmx_walk_witness_type

fn: lmx_walk_is_pointer_cell (@: arena c.LmxArena; @: cell void) int
    if: arena = 0 || cell = 0
        return: 0
    return: (cast: (int) (c.lmx_pointer_pool_in(arena, cell) != 0))
end: lmx_walk_is_pointer_cell

fn: lmx_walk_pointer_cells_alike (@: arena c.LmxArena; @: a void; @: b void) int
    @: pa c.LmxPool (cast: (@: c.LmxPool) c.lmx_pointer_pool_in(arena, a))
    @: pb c.LmxPool (cast: (@: c.LmxPool) c.lmx_pointer_pool_in(arena, b))
    if: pa = 0 || pb = 0
        return: 0
    return: (cast: (int) (pa\type = pb\type && pa\stride = pb\stride && pa\pointer_read = pb\pointer_read && pa\pointer_write = pb\pointer_write))
end: lmx_walk_pointer_cells_alike

fn: lmx_walk_store_slot (@: arena c.LmxArena; @@: slot void; size_t: value) int
    @: cell void 0
    int: ty 0
    if: arena = 0 || slot = 0 || slot[0] = 0
        return: c.LMX_WALK_INVALID
    cell: slot[0]
    ty: lmx_walk_numeric_type(arena, cell)
    if: ty = 0
        return: c.LMX_WALK_INVALID
    if: c.lmx_range_write_exact_blocked(arena, cell, 0, 0, 0U) != 0
        return: c.LMX_WALK_INVALID
    if: c.lmx_type_base(ty) = c.LMX_TYPE_CHAR
        if: c.lmx_char_store_known(cell, (cast: (int) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    return: lmx_walk_store_numeric_into(arena, cell, value)
end: lmx_walk_store_slot

# Existing typed-role and throws-boundary operations. All storage and counters
# still belong to the explicit arena/frame; no program binding is introduced.
fn: lmx_walk_source_mark (@: arena c.LmxArena; @: operation c.Lmx; int: source) int
    @: head void 0
    @: pool c.LmxPool 0
    @: typed c.LmxOp 0
    int: code 0
    if: arena = 0 || operation = 0
        return: c.LMX_WALK_INVALID
    head: (cast: (@: void) c.lmx_graph_value_in(arena, operation, 0U))
    code: lmx_walk_code_in(arena, head)
    if: source < 0 || source >= c.LMX_WALK_SOURCE_COUNT || code = 0
        return: c.LMX_WALK_INVALID
    pool: (cast: (@: c.LmxPool) c.lmx_range_pool(arena, head))
    if: pool = 0 || c.lmx_pool_is_sealed(pool) != 0 || c.lmx_range_write_exact_blocked(arena, head, 0, 0, 0U) != 0
        return: c.LMX_WALK_INVALID
    typed: (cast: (@: c.LmxOp) head)
    typed\code: source * c.LMX_WALK_OP_COUNT + code % c.LMX_WALK_OP_COUNT
    return: c.LMX_WALK_OK
end: lmx_walk_source_mark

fn: lmx_walk_kind (@: f c.LmxWalkFrame; @: p void) int
    @: context c.LmxWalkContext (cast: (@: c.LmxWalkContext) f\context)
    context\classified: context\classified + 1U
    return: c.lmx_range_classify(f\arena, p)
end: lmx_walk_kind

fn: lmx_walk_code_in (@: arena c.LmxArena; @: head void) int
    int: code 0
    if: arena = 0 || head = 0
        return: 0
    if: c.lmx_range_classify(arena, head) != c.LMX_DOMAIN_KIND_OP || c.lmx_type_base(c.lmx_range_type_of(arena, head)) != c.LMX_DOMAIN_OP || c.lmx_range_stride(arena, head) != c.sizeof(c.LmxOp)
        return: 0
    @: typed c.LmxOp (cast: (@: c.LmxOp) head)
    code: typed\code
    if: code <= 0 || code >= c.LMX_WALK_OP_COUNT * c.LMX_WALK_SOURCE_COUNT
        return: 0
    return: code
end: lmx_walk_code_in

fn: lmx_walk_role_in (@: arena c.LmxArena; @: head void) int
    int: code lmx_walk_code_in(arena, head)
    if: code = 0
        return: c.LMX_WALK_OP_NONE
    return: code % c.LMX_WALK_OP_COUNT
end: lmx_walk_role_in

fn: lmx_walk_role (@: f c.LmxWalkFrame; @: head void) int
    if: f = 0
        return: c.LMX_WALK_OP_NONE
    return: lmx_walk_role_in((cast: (@: c.LmxArena) f\arena), head)
end: lmx_walk_role

fn: lmx_walk_throws_in (@: arena c.LmxArena; @: callable c.Lmx) @: c.Lmx
    @: child void 0
    size_t: i 0U
    if: arena = 0 || callable = 0
        return: 0
    @: fields c.VoidArray @ callable\array
    while: i < fields\size
        child: (cast: (@: void) c.lmx_graph_value_in(arena, callable, i))
        if: child != 0 && c.lmx_range_classify(arena, child) = c.LMX_KIND_STRUCT
            @: child_struct c.Lmx (cast: (@: c.Lmx) child)
            @: nested c.VoidArray @ child_struct\array
            if: nested\size != 0U && lmx_walk_role_in(arena, c.lmx_graph_value_in(arena, child_struct, 0U)) = c.LMX_WALK_OP_THROWS
                return: child_struct
            ---
        ---
        i: i + 1U
    ---
    return: 0
end: lmx_walk_throws_in

fn: lmx_walk_throws_node (@: arena c.LmxArena; @: callable c.Lmx) @: c.Lmx
    @: header c.Lmx lmx_walk_throws_in(arena, callable)
    if: header != 0 || arena = 0 || callable = 0
        return: header
    @: pool c.LmxPool c.lmx_range_cell_pool(arena, (cast: (@: void) callable))
    if: pool = 0 || pool\role != c.LMX_POOL_ROLE_FN
        return: 0
    # A fn's written THROWS belongs to its body part.
    return: lmx_walk_throws_in(arena, c.lmx_graph_ref_struct_in(arena, callable, c.lmx_implements_exec_index(arena, callable, 3U)))
end: lmx_walk_throws_node

fn: lmx_walk_declared_count (@: arena c.LmxArena; @: callable c.Lmx) size_t
    @: header c.Lmx lmx_walk_throws_node(arena, callable)
    if: header = 0
        return: 0U
    @: fields c.VoidArray @ header\array
    return: fields\size - 1U
end: lmx_walk_declared_count

fn: lmx_walk_key_from_ordinal (@: arena c.LmxArena; @: callable c.Lmx; size_t: ordinal; @: out size_t) int
    @: header c.Lmx lmx_walk_throws_node(arena, callable)
    size_t: d 0U
    if: out = 0 || ordinal = 0U
        return: c.LMX_WALK_INVALID
    if: header != 0
        @: fields c.VoidArray @ header\array
        d: fields\size - 1U
    ---
    if: ordinal <= d
        return: lmx_walk_load_numeric(arena, c.lmx_graph_value_in(arena, header, ordinal), out)
    if: ordinal - d >= (cast: (size_t) c.LMX_WALK_NAME_DECLARED)
        return: c.LMX_WALK_INVALID
    \out: ordinal - d
    return: c.LMX_WALK_OK
end: lmx_walk_key_from_ordinal

fn: lmx_walk_ordinal_from_key (@: arena c.LmxArena; @: callable c.Lmx; size_t: key; @: out size_t) int
    @: header c.Lmx lmx_walk_throws_node(arena, callable)
    size_t: d 0U
    size_t: k 1U
    size_t: have 0U
    if: out = 0 || key = 0U
        return: c.LMX_WALK_INVALID
    if: header != 0
        @: fields c.VoidArray @ header\array
        d: fields\size - 1U
    ---
    if: key < (cast: (size_t) c.LMX_WALK_NAME_DECLARED)
        \out: d + key
        return: c.LMX_WALK_OK
    ---
    while: k <= d
        if: lmx_walk_load_numeric(arena, c.lmx_graph_value_in(arena, header, k), @ have) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        if: have = key
            \out: k
            return: c.LMX_WALK_OK
        ---
        k: k + 1U
    ---
    return: c.LMX_WALK_INVALID
end: lmx_walk_ordinal_from_key

fn: lmx_walk_boundary_status (@: arena c.LmxArena; @: callable c.Lmx; int: status) int
    size_t: ordinal 0U
    if: status < c.LMX_WALK_THROWN
        return: status
    if: lmx_walk_ordinal_from_key(arena, callable, (cast: (size_t) (status - c.LMX_WALK_THROWN)), @ ordinal) != c.LMX_WALK_OK || ordinal > (cast: (size_t) c.INT_MAX) - (cast: (size_t) c.LMX_WALK_THROWN)
        return: c.LMX_WALK_INVALID
    return: c.LMX_WALK_THROWN + (cast: (int) ordinal)
end: lmx_walk_boundary_status

fn: lmx_walk_head (@: f c.LmxWalkFrame; @: s c.Lmx) int
    @: head void (cast: (@: void) c.lmx_graph_value_in(f\arena, s, 0U))
    int: k lmx_walk_role(f, head)
    if: k != c.LMX_WALK_OP_NONE
        return: k
    if: head != 0 && lmx_walk_kind(f, head) = c.LMX_DOMAIN_KIND_OP
        return: c.LMX_WALK_OP_UNKNOWN
    return: c.LMX_WALK_OP_NONE
end: lmx_walk_head

fn: lmx_walk_node (@: f c.LmxWalkFrame; @: operand void) int
    int: k 0
    if: f = 0 || operand = 0
        return: c.LMX_WALK_OP_NONE
    k: lmx_walk_role(f, operand)
    if: k != c.LMX_WALK_OP_NONE
        return: k
    return: lmx_walk_op(f, operand)
end: lmx_walk_node

fn: lmx_walk_op (@: f c.LmxWalkFrame; @: code void) int
    int: kind 0
    int: k 0
    if: f = 0 || code = 0
        return: c.LMX_WALK_OP_NONE
    k: lmx_walk_role(f, code)
    if: k != c.LMX_WALK_OP_NONE
        return: k
    kind: lmx_walk_kind(f, code)
    if: c.lmx_graph_node_in(f\arena, code) != 0
        return: lmx_walk_head(f, (cast: (@: c.Lmx) code))
    if: kind = c.LMX_DOMAIN_KIND_OP
        return: c.LMX_WALK_OP_UNKNOWN
    return: c.LMX_WALK_OP_NONE
end: lmx_walk_op

fn: lmx_walk_bare (@: f c.LmxWalkFrame; @: operand void) int
    return: (cast: (int) (lmx_walk_role(f, operand) != c.LMX_WALK_OP_NONE))
end: lmx_walk_bare

# Ordinary construction helpers use only the passed arena/profile/parent.
# Typed operation cells belong to their actual frame's arena/profile, not a roles table.
fn: lmx_walk_plain (@: arena c.LmxArena; @: parent c.Lmx; size_t: children) @: c.Lmx
    return: lmx_walk_plain_profiled(arena, parent, children, 0)
end: lmx_walk_plain

fn: lmx_walk_plain_profiled (@: arena c.LmxArena; @: parent c.Lmx; size_t: children; @: held_profile c.Lmx) @: c.Lmx
    @: structure c.Lmx 0
    if: arena = 0 || parent = 0
        return: 0
    structure: (cast: (@: c.Lmx) c.lmx_struct_new_profiled(parent, arena, held_profile))
    if: structure = 0
        return: 0
    if: children != 0U && c.lmx_arena_refs_open_profiled(arena, structure, children, held_profile) != 0
        return: 0
    return: structure
end: lmx_walk_plain_profiled

# A source-backed PRIM owns its source tree at slot2. Borrowed actuals must
# occur on physical owned edges, not merely claim that tree through parent.
fn: lmx_walk_source_find (@: f c.LmxWalkFrame; @: graph_root c.Lmx; @: target void; @: home c.LmxArena; @@: out_owner c.Lmx; @: out_count size_t; @: ordinal size_t; @: out_first size_t; @: out_last size_t) int
    @: child void 0
    @: data void 0
    @: cell void 0
    @: child_struct c.Lmx 0
    size_t: width 0U
    size_t: i 0U
    size_t: j 0U
    int: kind 0
    int: status 0
    if: graph_root = 0 || lmx_walk_kind(f, (cast: (@: void) graph_root)) != c.LMX_KIND_STRUCT || c.lmx_range_home(f\arena, (cast: (@: void) graph_root)) != home
        return: c.LMX_WALK_INVALID
    if: \ordinal = (cast: (size_t) -1)
        return: c.LMX_WALK_INVALID
    \ordinal: \ordinal + 1U
    @: fields c.VoidArray @ graph_root\array
    width: fields\size
    data: (cast: (@: void) fields\data)
    if: width != 0U
        if: c.lmx_graph_backing_cell_in(f\arena, graph_root, 0U) = 0 || c.lmx_range_home(f\arena, data) != home
            return: c.LMX_WALK_INVALID
        ---
    ---
    while: i < width
        cell: (cast: (@: void) c.lmx_graph_ref_cell_in(f\arena, graph_root, i))
        if: cell = 0 || c.lmx_range_home(f\arena, cell) != home
            return: c.LMX_WALK_INVALID
        child: (cast: (@: void) c.lmx_graph_value_in(f\arena, graph_root, i))
        if: child != 0
            kind: lmx_walk_kind(f, child)
            child_struct: (cast: (@: c.Lmx) child)
            if: kind = c.LMX_KIND_STRUCT && child_struct\parent = graph_root
                if: c.lmx_range_home(f\arena, child) != home
                    return: c.LMX_WALK_INVALID
                j: 0U
                while: j < i
                    if: c.lmx_graph_value_in(f\arena, graph_root, j) = child
                        return: c.LMX_WALK_INVALID
                    j: j + 1U
                ---
                if: child = target
                    \out_owner: graph_root
                    \out_count: \out_count + 1U
                    if: \ordinal = (cast: (size_t) -1)
                        return: c.LMX_WALK_INVALID
                    \out_first: \ordinal + 1U
                ---
                status: lmx_walk_source_find(f, child_struct, target, home, out_owner, out_count, ordinal, out_first, out_last)
                if: status != c.LMX_WALK_OK
                    return: status
                if: child = target
                    \out_last: \ordinal
                ---
            else:
                if: kind != c.LMX_KIND_STRUCT
                    if: \ordinal = (cast: (size_t) -1)
                        return: c.LMX_WALK_INVALID
                    \ordinal: \ordinal + 1U
                    if: child = target && c.lmx_range_home(f\arena, child) = home
                        \out_owner: graph_root
                        \out_count: \out_count + 1U
                        \out_first: \ordinal
                        \out_last: \ordinal
                    ---
                ---
            ---
            if: \out_count > 1U
                return: c.LMX_WALK_INVALID
        ---
        i: i + 1U
    ---
    return: c.LMX_WALK_OK
end: lmx_walk_source_find

# A NAMED actual evaluates its payload; other actuals evaluate themselves.
fn: lmx_walk_prim_source_value (@: f c.LmxWalkFrame; @: actual void) @: void
    if: actual = 0 || lmx_walk_kind(f, actual) != c.LMX_KIND_STRUCT || lmx_walk_op(f, actual) != c.LMX_WALK_OP_NAMED
        return: actual
    @: actual_struct c.Lmx (cast: (@: c.Lmx) actual)
    @: fields c.VoidArray @ actual_struct\array
    if: fields\size != 3U
        return: actual
    return: (cast: (@: void) c.lmx_graph_value_in(f\arena, actual_struct, 2U))
end: lmx_walk_prim_source_value

fn: lmx_walk_prim_source_actuals (@: f c.LmxWalkFrame; @: code c.Lmx; @: source c.Lmx; @: home c.LmxArena; @@: owners c.Lmx; @: firsts size_t; @: lasts size_t) int
    @: owner c.Lmx 0
    @: holder c.Lmx 0
    @: actual void 0
    @: value void 0
    @: previous void 0
    size_t: count 0U
    size_t: ordinal 0U
    size_t: first 0U
    size_t: last 0U
    size_t: inner_first 0U
    size_t: inner_last 0U
    size_t: i 3U
    size_t: j 3U
    int: status 0
    @: fields c.VoidArray @ code\array
    while: i < fields\size
        actual: (cast: (@: void) c.lmx_graph_value_in(f\arena, code, i))
        if: actual != 0
            owner: 0
            count: 0U
            ordinal: 0U
            first: 0U
            last: 0U
            status: lmx_walk_source_find(f, source, actual, home, @ owner, @ count, @ ordinal, @ first, @ last)
            if: status != c.LMX_WALK_OK || count != 1U || owner = 0 || first = 0U || last < first
                return: c.LMX_WALK_INVALID
            value: lmx_walk_prim_source_value(f, actual)
            if: value != 0 && value != actual
                holder: 0
                count: 0U
                ordinal: 0U
                inner_first: 0U
                inner_last: 0U
                status: lmx_walk_source_find(f, source, value, home, @ holder, @ count, @ ordinal, @ inner_first, @ inner_last)
                if: status != c.LMX_WALK_OK || count != 1U || holder = 0 || inner_first <= first || last < inner_last
                    return: c.LMX_WALK_INVALID
            ---
            owners[i - 3U]: owner
            firsts[i - 3U]: first
            lasts[i - 3U]: last
            j: 3U
            while: j < i
                previous: (cast: (@: void) c.lmx_graph_value_in(f\arena, code, j))
                if: previous != 0
                    if: previous = actual
                        return: c.LMX_WALK_INVALID
                    if: owners[j - 3U] = 0 || (first <= firsts[j - 3U] && lasts[j - 3U] <= last) || (firsts[j - 3U] <= first && last <= lasts[j - 3U])
                        return: c.LMX_WALK_INVALID
                ---
                j: j + 1U
            ---
        ---
        i: i + 1U
    ---
    return: c.LMX_WALK_OK
end: lmx_walk_prim_source_actuals

fn: lmx_walk_prim_source_check (@: f c.LmxWalkFrame; @: code c.Lmx) int
    c.LmxScratchMark: mark
    @: pm c.LmxScratchMark 0
    @: source c.Lmx 0
    @: owner c.Lmx 0
    @: home c.LmxArena 0
    @: room void 0
    @: first_room void 0
    @: last_room void 0
    size_t: count 0U
    size_t: ordinal 0U
    size_t: first 0U
    size_t: last 0U
    size_t: n 0U
    int: status 0
    if: f = 0 || code = 0
        return: c.LMX_WALK_INVALID
    @: fields c.VoidArray @ code\array
    if: fields\size < 3U
        return: c.LMX_WALK_INVALID
    source: (cast: (@: c.Lmx) c.lmx_graph_value_in(f\arena, code, 2U))
    if: source = 0
        return: c.LMX_WALK_OK
    home: (cast: (@: c.LmxArena) c.lmx_range_home(f\arena, (cast: (@: void) code)))
    if: home = 0 || c.lmx_graph_node_in(f\arena, (cast: (@: void) source)) = 0 || lmx_walk_kind(f, (cast: (@: void) source)) != c.LMX_KIND_STRUCT || c.lmx_range_home(f\arena, (cast: (@: void) source)) != home || source\parent != code || lmx_walk_node(f, (cast: (@: void) source)) != c.LMX_WALK_OP_NONE
        return: c.LMX_WALK_INVALID
    status: lmx_walk_source_find(f, source, 0, home, @ owner, @ count, @ ordinal, @ first, @ last)
    if: status != c.LMX_WALK_OK
        return: status
    n: fields\size - 3U
    if: n = 0U
        return: c.LMX_WALK_OK
    @: context c.LmxWalkContext (cast: (@: c.LmxWalkContext) f\context)
    if: context = 0
        return: c.LMX_WALK_INVALID
    @: scratch c.LmxScratch (cast: (@: c.LmxScratch) context\scratch)
    if: scratch = 0 || n > (cast: (size_t) -1) / c.sizeof(owner) || n > (cast: (size_t) -1) / c.sizeof(n)
        return: c.LMX_WALK_INVALID
    pm: @ mark
    if: c.lmx_scratch_mark(scratch, pm) != c.LMX_SCRATCH_OK
        return: c.LMX_WALK_INVALID
    if: c.lmx_scratch_take(scratch, n * c.sizeof(owner), @ room) != c.LMX_SCRATCH_OK || room = 0
        status: c.LMX_WALK_NOMEM
    else:
        c.memset(room, 0, n * c.sizeof(owner))
        if: c.lmx_scratch_take(scratch, n * c.sizeof(n), @ first_room) != c.LMX_SCRATCH_OK || first_room = 0 || c.lmx_scratch_take(scratch, n * c.sizeof(n), @ last_room) != c.LMX_SCRATCH_OK || last_room = 0
            status: c.LMX_WALK_NOMEM
        else:
            status: lmx_walk_prim_source_actuals(f, code, source, home, (cast: (@@: c.Lmx) room), (cast: (@: size_t) first_room), (cast: (@: size_t) last_room))
        ---
    ---
    if: c.lmx_scratch_rewind(scratch, pm) != c.LMX_SCRATCH_OK && status = c.LMX_WALK_OK
        status: c.LMX_WALK_INVALID
    return: status
end: lmx_walk_prim_source_check

# Stable written-source order, independent of the PRIM ABI input-slot order.
# Validation/sorting never executes actuals; absent actuals retain ordinal0.
fn: lmx_walk_prim_source_order (@: f c.LmxWalkFrame; @: code c.Lmx; @: firsts size_t; @: order size_t) int
    @: source c.Lmx 0
    @: owner c.Lmx 0
    @: home c.LmxArena 0
    @: actual void 0
    size_t: count 0U
    size_t: ordinal 0U
    size_t: first 0U
    size_t: last 0U
    size_t: n 0U
    size_t: i 0U
    size_t: j 0U
    size_t: previous 0U
    int: moving 0
    int: status 0
    if: f = 0 || code = 0 || firsts = 0 || order = 0
        return: c.LMX_WALK_INVALID
    @: fields c.VoidArray @ code\array
    if: fields\size < 3U
        return: c.LMX_WALK_INVALID
    source: (cast: (@: c.Lmx) c.lmx_graph_ref_struct_in(f\arena, code, 2U))
    home: (cast: (@: c.LmxArena) c.lmx_range_home(f\arena, (cast: (@: void) code)))
    if: source = 0 || home = 0
        return: c.LMX_WALK_INVALID
    n: fields\size - 3U
    while: i < n
        actual: (cast: (@: void) c.lmx_graph_value_in(f\arena, code, 3U + i))
        first: 0U
        if: actual != 0
            owner: 0
            count: 0U
            ordinal: 0U
            last: 0U
            status: lmx_walk_source_find(f, source, actual, home, @ owner, @ count, @ ordinal, @ first, @ last)
            if: status != c.LMX_WALK_OK || count != 1U || owner = 0 || first = 0U
                return: c.LMX_WALK_INVALID
        ---
        firsts[i]: first
        j: i
        moving: 1
        while: j > 0U && moving != 0
            previous: order[j - 1U]
            if: firsts[previous] > first
                order[j]: previous
                j: j - 1U
            else:
                moving: 0
            ---
        ---
        order[j]: i
        i: i + 1U
    ---
    return: c.LMX_WALK_OK
end: lmx_walk_prim_source_order

# The activation's input width is its selected callee's own receiving
# interface (RU section 12: the needed pass-through names are part of the
# signature): a fn's args part lists the written formals, then the hidden
# inputs. A call formed by a model hands only the inputs that model describes;
# each input it does not hand is the frame's zero input, absent as one handed
# absent, so a consumed hidden input takes its own lexical fallback at entry
# and a forwarded one goes on absent. The native trampoline receives into the
# same width. A fn without an args part declares no input to widen by.
fn: lmx_walk_input_width (@: f c.LmxWalkFrame; @: out size_t) int
    @: code c.Lmx 0
    @: pool c.LmxPool 0
    @: header c.Lmx 0
    if: f = 0 || out = 0
        return: c.LMX_WALK_INVALID
    out[0]: f\nargs
    code: f\code
    if: code = 0 || c.lmx_range_classify((cast: (@: c.LmxArena) f\arena), (cast: (@: void) code)) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_OK
    pool: c.lmx_range_cell_pool((cast: (@: c.LmxArena) f\arena), (cast: (@: void) code))
    if: pool = 0
        return: c.LMX_WALK_OK
    if: pool\role != c.LMX_POOL_ROLE_FN
        size_t: width 0U
        while: c.lmx_source_name_get_at((cast: (@: c.LmxArena) f\arena), (cast: (@: void) code), width + 1U) != 0
            width: width + 1U
        ---
        if: width > out[0]
            out[0]: width
        return: c.LMX_WALK_OK
    @: fields c.VoidArray @ code\array
    if: fields\size != 4U
        return: c.LMX_WALK_INVALID
    header: c.lmx_graph_ref_struct_in((cast: (@: c.LmxArena) f\arena), code, 0U)
    if: header = 0
        return: c.LMX_WALK_OK
    @: header_fields c.VoidArray @ header\array
    if: header_fields\size > out[0]
        out[0]: header_fields\size
    return: c.LMX_WALK_OK
end: lmx_walk_input_width

# Stable activation-owned declared-width input cells, outside nested call marks.
fn: lmx_walk_args_open_values (@: f c.LmxWalkFrame; @: values c.LmxWalkValue) int
    @: room void 0
    @@: mine void 0
    size_t: i 0U
    size_t: width 0U
    int: status
    status: lmx_walk_input_width(f, @ width)
    if: status != c.LMX_WALK_OK
        return: status
    if: width = 0U
        return: c.LMX_WALK_OK
    if: f\nargs != 0U && f\args = 0
        return: c.LMX_WALK_INVALID
    if: width > (cast: (size_t) -1) / c.sizeof(c.LmxWalkValue)
        return: c.LMX_WALK_NOMEM
    @: context c.LmxWalkContext (cast: (@: c.LmxWalkContext) f\context)
    @: scratch c.LmxScratch (cast: (@: c.LmxScratch) context\scratch)
    if: c.lmx_scratch_take(scratch, width * c.sizeof(c.LmxWalkValue), @ room) != c.LMX_SCRATCH_OK
        return: c.LMX_WALK_NOMEM
    @: owned c.LmxWalkValue (cast: (@: c.LmxWalkValue) room)
    f\argown: owned
    c.memset(room, 0, width * c.sizeof(c.LmxWalkValue))
    if: c.lmx_scratch_take(scratch, width * c.sizeof(room), @ room) != c.LMX_SCRATCH_OK
        return: c.LMX_WALK_NOMEM
    c.memset(room, 0, width * c.sizeof(room))
    mine: (cast: (@@: void) room)
    @@: inputs void (cast: (@@: void) f\args)
    while: i < f\nargs
        mine[i]: inputs[i]
        if: values != 0
            @: supplied c.LmxWalkValue (values + i)
            @: item c.LmxWalkValue (owned + i)
            if: inputs[i] != lmx_walk_value_storage(supplied) || (supplied\present != 0 && inputs[i] = 0)
                return: c.LMX_WALK_INVALID
            c.memcpy((cast: (@: void) item), (cast: (@: void) supplied), c.sizeof(c.LmxWalkValue))
            mine[i]: lmx_walk_value_storage(item)
        ---
        i: i + 1U
    ---
    if: i < width && c.lmx_source_name_get_at((cast: (@: c.LmxArena) f\arena), (cast: (@: void) f\code), i + 1U) != 0
        while: i < width
            lmx_walk_value_free_mark(owned + i)
            i: i + 1U
        ---
    ---
    f\args: mine
    f\nargs: width
    return: c.LMX_WALK_OK
end: lmx_walk_args_open_values

fn: lmx_walk_args_open (@: f c.LmxWalkFrame) int
    return: lmx_walk_args_open_values(f, 0)
end: lmx_walk_args_open

# The same activation-owned cells serve walked arguments and native body inputs.
# This prepares a working place; an ordinary absent read must stay absent before
# asking for a place, as it does in the ARG consumer below.
fn: lmx_walk_values_arg_place (@: arena c.LmxArena; @: owned c.LmxWalkValue; @@: inputs void; size_t: width; size_t: k; int: ty; @: out c.LmxWalkPlace) int
    int: status 0
    if: k >= width || inputs = 0 || owned = 0
        return: c.LMX_WALK_INVALID
    @: item c.LmxWalkValue (owned + k)
    # Slice 255 (design 4.5 B2a): no static witness (LMX_TYPE_NONE) -- the place has the type of the value it holds: the
    # present record's, else the input cell's; an absent input without a value is a missing input (INVALID).
    if: ty = c.LMX_TYPE_NONE
        if: item\present = 0
            if: inputs[k] = 0
                return: c.LMX_WALK_INVALID
            status: lmx_walk_value_cell(arena, inputs[k], item)
            if: status != c.LMX_WALK_OK
                return: status
            inputs[k]: lmx_walk_value_storage(item)
        ---
        ty: item\type
    ---
    if: item\present != 0 && item\type != ty
        return: c.LMX_WALK_INVALID
    if: item\present = 0
        if: inputs[k] != 0
            status: lmx_walk_value_load(arena, inputs[k], ty, item)
        else:
            if: c.lmx_type_base(ty) >= c.LMX_TYPE_POINTER_BASE || c.lmx_type_base(ty) = c.LMX_TYPE_LMX || c.lmx_type_base(ty) = c.LMX_TYPE_DESC || c.lmx_type_base(ty) = c.LMX_TYPE_CHAR_PTR
                status: lmx_walk_value_ref(item, ty, 0)
            else:
                status: lmx_walk_value_num(item, ty, 0U)
            ---
        ---
        if: status != c.LMX_WALK_OK
            return: status
        inputs[k]: lmx_walk_value_storage(item)
    ---
    out\address: inputs[k]
    out\storage: inputs[k]
    out\type: ty
    out\descriptor: 0
    out\context: item
    return: c.LMX_WALK_OK
end: lmx_walk_values_arg_place

fn: lmx_walk_arg_place (@: f c.LmxWalkFrame; size_t: k; int: ty; @: out c.LmxWalkPlace) int
    if: f = 0
        return: c.LMX_WALK_INVALID
    return: lmx_walk_values_arg_place((cast: (@: c.LmxArena) f\arena), (cast: (@: c.LmxWalkValue) f\argown), (cast: (@@: void) f\args), (cast: (size_t) f\nargs), k, ty, out)
end: lmx_walk_arg_place

# The place's context is snapshot, its recorded reference with it, before the
# load (out may alias it). After a raw read it is laid over the loaded REF only
# while it records that same reference; otherwise the REF keeps what the value
# load attached from the cell's own validated companion. A descriptor place
# loads no raw content: its address is the reference.
# Classify an already resolved physical cell once for both executors.
# storage is the holder's reference slot when cell is a direct descriptor;
# a primitive value already has its own typed storage. No names are resolved.
fn: lmx_walk_cell_place (@: arena c.LmxArena; @: cell void; @: storage void; @: out c.LmxWalkPlace) int
    if: arena = 0 || out = 0
        return: c.LMX_WALK_INVALID
    c.memset((cast: (@: void) out), 0, c.sizeof(c.LmxWalkPlace))
    int: kind c.lmx_domain_kind(arena, cell)
    out\address: cell
    if: cell = 0 || kind = c.LMX_KIND_STRUCT || kind = c.LMX_KIND_ARRAY
        out\storage: storage
        out\type: c.LMX_TYPE_LMX
        if: kind = c.LMX_KIND_ARRAY
            out\type: c.LMX_TYPE_DESC
        out\descriptor: 1
        return: c.LMX_WALK_OK
    ---
    out\storage: cell
    out\type: c.lmx_domain_type(arena, cell)
    return: c.LMX_WALK_OK
end: lmx_walk_cell_place

# A written graph-cell witness admits descriptors or the existing low box.
# This checks the same selected cell, without another field lookup or load.
# Admit one written field requirement over the actual held root, then expose
# its physical place. No free-name binding or lexical type is looked up here.
# Both OF with a named selector and native path emission call this operation.
# Slice 272: a written selection keeps the field's coordinates for its store (lmx_walk_value_field_store).
fn: lmx_walk_value_field_place (@: arena c.LmxArena; @: holder c.LmxWalkValue; @: name char; @: out c.LmxWalkPlace; @@: out_root c.Lmx; @: out_index size_t) int
    if: arena = 0 || holder = 0 || out = 0 || name = 0
        return: c.LMX_WALK_INVALID
    if: holder\present = 0
        return: c.LMX_WALK_INVALID
    if: holder\kind != c.LMX_WALK_VALUE_REFERENCE
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    if: holder\ref = 0
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
    @: root c.Lmx c.lmx_graph_node_in(arena, holder\ref)
    if: root = 0
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    c.VoidArray: wanted
    wanted\data: (cast: (@: void) name)
    wanted\size: c.strlen(name)
    size_t: index 0U
    int: answer c.lmx_implements_call_field(arena, root, @ wanted, c.LMX_TYPE_NONE, @ index)
    if: answer != c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_IMPLEMENTS
    @: physical void c.lmx_graph_cell_in(arena, root, index)
    if: physical = 0
        return: c.LMX_WALK_INVALID
    if: out_root != 0
        out_root[0]: root
    if: out_index != 0
        out_index[0]: index
    if: c.lmx_domain_kind(arena, physical) = c.LMX_KIND_PRIMITIVE
        return: lmx_walk_cell_place(arena, physical, physical, out)
    if: c.lmx_range_stride(arena, physical) != sizeof(@: void)
        return: c.LMX_WALK_INVALID
    @@: slot void (cast: (@@: void) physical)
    if: slot[0] = 0 && c.lmx_implements_holes(arena, root) != 0
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_IMPLEMENTS
    return: lmx_walk_cell_place(arena, slot[0], physical, out)
end: lmx_walk_value_field_place

fn: lmx_walk_value_named_place (@: arena c.LmxArena; @: holder c.LmxWalkValue; @: name char; @: out c.LmxWalkPlace) int
    return: lmx_walk_value_field_place(arena, holder, name, out, 0, 0)
end: lmx_walk_value_named_place

fn: lmx_walk_graph_cell_place (@: arena c.LmxArena; @@: slot void; int: desc_ok; @: out c.LmxWalkPlace) int
    if: slot = 0 || slot[0] = 0
        return: c.LMX_WALK_INVALID
    int: status lmx_walk_cell_place(arena, slot[0], (cast: (@: void) slot), out)
    if: status != c.LMX_WALK_OK || out\descriptor != 0
        return: status
    int: base c.lmx_type_base(out\type)
    if: c.lmx_domain_kind(arena, slot[0]) != c.LMX_KIND_PRIMITIVE || (base != c.LMX_TYPE_LMX && (desc_ok = 0 || base != c.LMX_TYPE_DESC))
        return: c.LMX_WALK_INVALID
    if: c.lmx_pointer_pool_in(arena, slot[0]) = 0
        return: c.LMX_WALK_INVALID
    out\context: c.lmx_pointer_cell_context(arena, slot[0])
    return: c.LMX_WALK_OK
end: lmx_walk_graph_cell_place

fn: lmx_walk_place_load (@: arena c.LmxArena; @: place c.LmxWalkPlace; @: out c.LmxWalkValue) int
    c.LmxWalkValue: saved
    @: context c.LmxWalkValue @ saved
    @: source c.LmxWalkValue lmx_walk_place_context(arena, place)
    c.LmxWalkValue: stamp_storage
    @: stamp c.LmxWalkValue @ stamp_storage
    int: status 0
    c.lmx_value_context_copy(context, source)
    lmx_walk_value_clear(stamp)
    if: source != 0
        stamp\present: source\present
        stamp\kind: source\kind
        stamp\ref: source\ref
    ---
    if: place\descriptor != 0
        status: lmx_walk_value_ref(out, (cast: (int) place\type), (cast: (@: void) place\address))
    else:
        status: lmx_walk_value_load(arena, (cast: (@: void) place\address), (cast: (int) place\type), out)
    ---
    if: status = c.LMX_WALK_OK && out\kind = c.LMX_WALK_VALUE_REFERENCE
        if: place\descriptor != 0 || c.lmx_value_loaded_context(stamp, (cast: (@: void) out\ref)) != 0
            c.lmx_value_context_copy(out, context)
        ---
    ---
    return: status
end: lmx_walk_place_load

fn: lmx_walk_place_context (@: arena c.LmxArena; @: place c.LmxWalkPlace) @: c.LmxWalkValue
    if: place\context != 0
        return: (cast: (@: c.LmxWalkValue) place\context)
    if: place\descriptor != 0
        return: 0
    return: (cast: (@: c.LmxWalkValue) c.lmx_value_address_context(arena, place\address, 0))
end: lmx_walk_place_context

# The DEREF receiver consumes its actual holder before a value is loaded.
# A pointer addresses a value cell, even for Structure/Array references.
fn: lmx_walk_value_deref_place (@: arena c.LmxArena; @: holder c.LmxWalkValue; int: ty; @: out c.LmxWalkPlace) int
    if: holder = 0 || out = 0
        return: c.LMX_WALK_INVALID
    c.memset((cast: (@: void) out), 0, c.sizeof(c.LmxWalkPlace))
    if: holder\present = 0 || holder\kind != c.LMX_WALK_VALUE_REFERENCE
        return: c.LMX_WALK_INVALID
    if: holder\ref = 0
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
    out\address: holder\ref
    out\storage: holder\ref
    out\type: ty
    out\descriptor: 0
    out\context: c.lmx_value_address_context(arena, holder\ref, holder)
    return: c.LMX_WALK_OK
end: lmx_walk_value_deref_place

# Slice 258 (design 4.5 B2b-2a): the algebra of the pointer codes the translator spells -- LMX_TYPE_POINTER_BASE + the
# formal's code (lm_compiler_ptr_cell_type; the codes of lm_compiler_core_pointer_type: 11 int*, 12 char*, 3 const char*,
# 9 size_t*, 25 unsigned*, 38 ulong*, 16 void*; 19 int**, 17 char**, 20 size_t**, 24 unsigned**, 39 ulong**, 18 void**) --
# read at run time where the translator had no type: a free pointer's deref and a free place's address.  The pointee of a
# text (CHAR_PTR) is a char.  An opaque pointee (void*, a foreign C type, a graph reference) and a place without a pointer
# code have no value type here: LMX_TYPE_NONE, the caller's runtime refusal -- never an invented type.
fn: lmx_type_pointee (int: code) int
    int: ft 0
    code: c.lmx_type_base(code)
    if: code = c.LMX_TYPE_CHAR_PTR
        return: c.LMX_TYPE_CHAR
    if: code < c.LMX_TYPE_POINTER_BASE
        return: c.LMX_TYPE_NONE
    ft: code - c.LMX_TYPE_POINTER_BASE
    if: ft = 11
        return: c.LMX_TYPE_INT
    if: ft = 12 || ft = 3
        return: c.LMX_TYPE_CHAR
    if: ft = 9
        return: c.LMX_TYPE_SIZE_T
    if: ft = 25
        return: c.LMX_TYPE_UNSIGNED
    if: ft = 38
        return: c.LMX_TYPE_ULONG
    if: ft = 19
        return: c.LMX_TYPE_POINTER_BASE + 11
    if: ft = 17
        return: c.LMX_TYPE_POINTER_BASE + 12
    if: ft = 20
        return: c.LMX_TYPE_POINTER_BASE + 9
    if: ft = 24
        return: c.LMX_TYPE_POINTER_BASE + 25
    if: ft = 39
        return: c.LMX_TYPE_POINTER_BASE + 38
    if: ft = 18
        return: c.LMX_TYPE_POINTER_BASE + 16
    return: c.LMX_TYPE_NONE
end: lmx_type_pointee

fn: lmx_type_pointer_to (int: ty) int
    int: ft 0
    ty: c.lmx_type_base(ty)
    if: ty = c.LMX_TYPE_INT
        return: c.LMX_TYPE_POINTER_BASE + 11
    if: ty = c.LMX_TYPE_CHAR
        return: c.LMX_TYPE_POINTER_BASE + 12
    if: ty = c.LMX_TYPE_SIZE_T
        return: c.LMX_TYPE_POINTER_BASE + 9
    if: ty = c.LMX_TYPE_UNSIGNED
        return: c.LMX_TYPE_POINTER_BASE + 25
    if: ty = c.LMX_TYPE_ULONG
        return: c.LMX_TYPE_POINTER_BASE + 38
    if: ty = c.LMX_TYPE_CHAR_PTR
        return: c.LMX_TYPE_POINTER_BASE + 17
    # Slice 261 (design 4.5 B2b-2d, P1-PTR-COVERAGE): a type without a pointer code of the table -- a graph or Array
    # reference cell (LMX, DESC), an unsigned char, a pointer cell of a translator code, a second level of the table's own
    # codes -- is addressed by the kernel's own code LMX_TYPE_CELL_POINTER: the pointee is read from the cell or its owning
    # record (lmx_walk_value_deref_actual), never from the code.  Only no type (NONE) has no address.
    if: ty = c.LMX_TYPE_NONE
        return: c.LMX_TYPE_NONE
    if: ty < c.LMX_TYPE_POINTER_BASE
        return: c.LMX_TYPE_CELL_POINTER
    ft: ty - c.LMX_TYPE_POINTER_BASE
    if: ft = 11
        return: c.LMX_TYPE_POINTER_BASE + 19
    if: ft = 12
        return: c.LMX_TYPE_POINTER_BASE + 17
    if: ft = 9
        return: c.LMX_TYPE_POINTER_BASE + 20
    if: ft = 25
        return: c.LMX_TYPE_POINTER_BASE + 24
    if: ft = 38
        return: c.LMX_TYPE_POINTER_BASE + 39
    if: ft = 16
        return: c.LMX_TYPE_POINTER_BASE + 18
    return: c.LMX_TYPE_CELL_POINTER
end: lmx_type_pointer_to

# Slice 258 (design 4.5 B2b-2a): the DEREF of an actual pointer whose pointee type the translator did not know (a free
# pointer): the place is typed by the holder's actual pointer code (lmx_type_pointee), the same selection as a typed DEREF's
# (lmx_walk_value_deref_place: a null holder is the implicit `interpreter` throw).  An opaque pointee is UNSUPPORTED -- the
# existing runtime refusal, no invented type.  Both the walker's DEREF without a witness and the native code run this.
fn: lmx_walk_value_deref_actual (@: arena c.LmxArena; @: holder c.LmxWalkValue; @: out c.LmxWalkPlace) int
    int: ty 0
    int: kind 0
    @: owner c.LmxWalkValue 0
    @: held void 0
    if: holder = 0 || out = 0
        return: c.LMX_WALK_INVALID
    c.memset((cast: (@: void) out), 0, c.sizeof(c.LmxWalkPlace))
    if: holder\present = 0 || holder\kind != c.LMX_WALK_VALUE_REFERENCE
        return: c.LMX_WALK_INVALID
    # The record owning the addressed payload first: the address of a free name (lmx_walk_place_address) refers to the
    # activation's input record -- the typed semantic cell of that local (the author, 2026-11-02: a hidden input is a local of
    # the activation, `@x` its local address) -- as its referent; the record's actual type is the pointee's (a number's, or a
    # pointer cell's: the next level of a known pointer).
    owner: holder\referent
    if: holder\ref != 0 && owner != 0 && (owner\kind = c.LMX_WALK_VALUE_NUMBER || owner\kind = c.LMX_WALK_VALUE_REFERENCE) && lmx_walk_value_storage(owner) = holder\ref
        ty: owner\type
    # The actual pointee cell first (P1-PTR-COVERAGE): a cell of the arena's pools tells its own kind and exact type -- a
    # Structure, an Array, a number, a pointer cell (the next level of a known pointer); the pointer-code table only for
    # storage outside the pools (a free input's own record, machine storage).
    if: holder\ref != 0
        kind: (cast: (int) c.lmx_domain_kind(arena, holder\ref))
        if: kind = c.LMX_KIND_STRUCT
            ty: c.LMX_TYPE_LMX
        if: kind = c.LMX_KIND_ARRAY
            ty: c.LMX_TYPE_DESC
        if: kind = c.LMX_KIND_PRIMITIVE
            ty: (cast: (int) c.lmx_domain_type(arena, holder\ref))
        # Slice 261 (P1-PTR-COVERAGE): a slot of a graph node (a CHILDREN/REF pool cell -- the storage of a descriptor place,
        # the address of a graph-valued field) holds a Structure or Array reference: the pointee is that reference, typed by
        # what the slot holds (an empty slot is a graph reference).
        if: kind = c.LMX_KIND_CHILDREN || kind = c.LMX_KIND_REF
            held: (cast: (@: void) c.lmx_arena_pointer_void_read(holder\ref))
            ty: c.LMX_TYPE_LMX
            if: held != 0 && c.lmx_domain_kind(arena, held) = c.LMX_KIND_ARRAY
                ty: c.LMX_TYPE_DESC
            ---
        ---
    ---
    if: ty = c.LMX_TYPE_NONE
        ty: lmx_type_pointee(holder\type)
    if: ty = c.LMX_TYPE_NONE
        return: c.LMX_WALK_UNSUPPORTED
    return: lmx_walk_value_deref_place(arena, holder, ty, out)
end: lmx_walk_value_deref_actual

# Slice 258 (design 4.5 B2b-2a): the ADDRESS of a selected place as a reference of the place's pointer code
# (lmx_type_pointer_to): the real typed storage, the place's context as the referent -- `@x` and `x` keep their reference
# depth (norm 470).  Slice 261 (design 4.5 B2b-2d, P1-PTR-COVERAGE): every typed place has an address -- a descriptor
# place's is its slot's (the storage), a reference cell's or an opaque cell's has the kernel's own code
# LMX_TYPE_CELL_POINTER (the pointee read cell-first: lmx_walk_value_deref_actual); only a place of no type is
# UNSUPPORTED.  Both the walker's ADDRESS without a witness and the native code run this.
fn: lmx_walk_place_address (@: arena c.LmxArena; @: place c.LmxWalkPlace; @: out c.LmxWalkValue) int
    int: ty 0
    int: status 0
    @: storage void 0
    if: place = 0 || out = 0
        return: c.LMX_WALK_INVALID
    storage: place\storage
    if: storage = 0
        storage: place\address
    if: storage = 0
        return: c.LMX_WALK_INVALID
    ty: lmx_type_pointer_to((cast: (int) place\type))
    if: ty = c.LMX_TYPE_NONE
        return: c.LMX_WALK_UNSUPPORTED
    status: lmx_walk_value_ref(out, ty, storage)
    out\referent: lmx_walk_place_context(arena, place)
    return: status
end: lmx_walk_place_address

# Slice 261 (design 4.5 B2b-2d, P1-PTR-COVERAGE): the one receive of a runtime-typed reference by a pointer place whose static
# shape the translator knows -- `depth` pointer levels (1: the place holds the leaf's reference itself) above a leaf of the
# kernel type `leaf` (LMX: a Structure; DESC: an Array; a number type; NONE: a `void` leaf, no leaf check) -- judged by the
# ACTUAL pointees, never by the value's type code (a free name's address carries the kernel's own code, a native graph own's
# record a translator code, a walked row LMX_TYPE_LMX): each level's addressed cell must be a reference cell -- its owning
# record or the arena's pool types it (lmx_walk_value_deref_actual) -- holding the next level; a Structure or Array met before
# the leaf is a chain too short, a number cell where a pointer cell is asked a wrong level: the implicit `convert`; a null ends
# the chain (nothing deeper to judge, as a null graph reference is received).  At the leaf a Structure or Array is classified
# by the arena (a walked LMX/DESC-typed reference passes, as lmx_walk_value_receive_graph admits it), a number by its cell's
# type.  The received value keeps its reference and its referent and takes the place's type `ty`, as a received number takes
# the place's type.  Both executors call it for a runtime-typed value at such a place: the native code with the translator's
# depth and leaf, the walker through the RECEIVE frame carrying the same two numbers and the place's witness.  A present
# value of another kind is the implicit `convert`, an absent one INVALID; a pointee the kernel cannot type is UNSUPPORTED.
fn: lmx_walk_value_receive_pointer (@: arena c.LmxArena; @: value c.LmxWalkValue; int: ty; int: depth; int: leaf; @: out c.LmxWalkValue) int
    c.LmxWalkValue: current
    @: current_p c.LmxWalkValue @ current
    c.LmxWalkValue: next
    @: next_p c.LmxWalkValue @ next
    c.LmxWalkPlace: place
    @: place_p c.LmxWalkPlace @ place
    int: level 0
    int: kind 0
    int: status 0
    if: arena = 0 || value = 0 || out = 0 || value\present = 0 || depth < 1
        return: c.LMX_WALK_INVALID
    if: value\kind = c.LMX_WALK_VALUE_NUMBER || value\kind = c.LMX_WALK_VALUE_FOREIGN
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    if: value\kind != c.LMX_WALK_VALUE_REFERENCE
        return: c.LMX_WALK_INVALID
    c.memcpy((cast: (@: void) current_p), (cast: (@: void) value), c.sizeof(c.LmxWalkValue))
    # The levels above the leaf: the addressed cell is a reference cell holding the next level.
    while: level + 1 < depth && current_p\ref != 0
        kind: (cast: (int) c.lmx_domain_kind(arena, current_p\ref))
        if: kind = c.LMX_KIND_STRUCT || kind = c.LMX_KIND_ARRAY
            return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
        status: lmx_walk_value_deref_actual(arena, current_p, place_p)
        if: status != c.LMX_WALK_OK
            return: status
        if: c.lmx_type_reference_cell((cast: (int) place_p\type)) = 0
            return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
        status: lmx_walk_place_load(arena, place_p, next_p)
        if: status != c.LMX_WALK_OK
            return: status
        if: next_p\present = 0 || next_p\kind != c.LMX_WALK_VALUE_REFERENCE
            return: c.LMX_WALK_INVALID
        c.memcpy((cast: (@: void) current_p), (cast: (@: void) next_p), c.sizeof(c.LmxWalkValue))
        level: level + 1
    ---
    # The leaf: what the last pointer addresses.
    if: current_p\ref != 0 && level + 1 = depth
        if: leaf = c.LMX_TYPE_LMX || leaf = c.LMX_TYPE_DESC
            kind: (cast: (int) c.lmx_domain_kind(arena, current_p\ref))
            if: leaf = c.LMX_TYPE_LMX && kind != c.LMX_KIND_STRUCT && c.lmx_type_base((cast: (int) current_p\type)) != c.LMX_TYPE_LMX
                return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
            if: leaf = c.LMX_TYPE_DESC && kind != c.LMX_KIND_ARRAY && c.lmx_type_base((cast: (int) current_p\type)) != c.LMX_TYPE_DESC
                return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
            ---
        if: leaf != c.LMX_TYPE_LMX && leaf != c.LMX_TYPE_DESC && leaf != c.LMX_TYPE_NONE
            status: lmx_walk_value_deref_actual(arena, current_p, place_p)
            if: status != c.LMX_WALK_OK
                return: status
            if: c.lmx_type_base((cast: (int) place_p\type)) != c.lmx_type_base(leaf)
                return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
            ---
        ---
    ---
    if: out != value
        c.memcpy((cast: (@: void) out), (cast: (@: void) value), c.sizeof(c.LmxWalkValue))
    out\type: ty
    return: c.LMX_WALK_OK
end: lmx_walk_value_receive_pointer

# Descriptor places are not numeric/pointer cells. Preserve the common cell store.
fn: lmx_walk_value_store (@: arena c.LmxArena; @: place c.LmxWalkPlace; @: value c.LmxWalkValue) int
    c.LmxPointerCellWrite: write c.lmx_pointer_store_known
    return: lmx_walk_value_store_with_writer(arena, place, value, write)
end: lmx_walk_value_store

# The physical writer may describe a native typed working cell. Admission,
# numeric storage, pointer context and write barriers remain the same operation.
fn: lmx_walk_value_store_with_writer (@: arena c.LmxArena; @: place c.LmxWalkPlace; @: value c.LmxWalkValue; c.LmxPointerCellWrite: write) int
    c.LmxWalkValue: received
    @: received_p c.LmxWalkValue @ received
    size_t: number 0U
    int: ty 0
    int: status 0
    if: value\present = 0 || place\address = 0 || place\descriptor != 0
        return: c.LMX_WALK_INVALID
    if: c.lmx_range_write_exact_blocked(arena, place\address, 0, 0, 0U) != 0
        return: c.LMX_WALK_INVALID
    int: base_type c.lmx_type_base(place\type)
    if: base_type >= c.LMX_TYPE_POINTER_BASE || base_type = c.LMX_TYPE_LMX || base_type = c.LMX_TYPE_DESC || base_type = c.LMX_TYPE_CHAR_PTR
        # Slice 272: another kind of value is the implicit `convert` before the write (the book :777); the contextual literal 0
        # is the present null, as a typed program writes `p: 0`.
        if: value\kind != c.LMX_WALK_VALUE_REFERENCE
            if: lmx_walk_value_null_literal(value) = 0
                return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
            status: lmx_walk_value_ref(received_p, place\type, 0)
            if: status != c.LMX_WALK_OK
                return: status
            return: (cast: (int) c.lmx_value_cell_store(arena, place\address, place\context, 0, received_p, write))
        ---
        return: (cast: (int) c.lmx_value_cell_store(arena, place\address, place\context, value\ref, value, write))
    ---
    # Slice 255 (design 4.5 B2a): the place receives the value by the one admission -- a contextual literal takes the
    # place's type, a number of another type is the implicit `convert` throw (lmx_walk_value_receive).
    status: lmx_walk_value_receive(value, place\type, received_p)
    if: status != c.LMX_WALK_OK
        return: status
    if: lmx_walk_value_number(received_p, @ number, @ ty) != c.LMX_WALK_OK || ty != place\type
        return: c.LMX_WALK_INVALID
    status: lmx_walk_store_numeric_raw((cast: (@: void) place\address), ty, number)
    if: status = c.LMX_WALK_OK && place\context != 0
        c.lmx_value_context_copy(place\context, 0)
    ---
    # A number written into a cell that stands in a place of code drops the words above it (design 4.4).
    if: status = c.LMX_WALK_OK
        c.lmx_code_changed_cell(arena, (cast: (@: void) place\address))
    ---
    return: status
end: lmx_walk_value_store_with_writer

# Slice 272: the write of a field selected by name from a runtime-typed holder.  The book (L3, construction): a path with a tail
# passes the value to the existing field after the ordinary admission.  A reference is admitted to the declared model of the
# field's slot, as typed code does at its statement.  A field holding a Structure or an Array receives a value of the same kind
# and, for an Array, of the same element type; what it holds is the slot's own descriptor or the low cell a former write left
# there.  A descriptor place is rebound as PUT_REF rebinds its slot.
fn: lmx_walk_value_field_store (@: arena c.LmxArena; @: root c.Lmx; size_t: index; @: place c.LmxWalkPlace; @: value c.LmxWalkValue) int
    c.LmxWalkValue: current
    @: current_p c.LmxWalkValue @ current
    @: raw void 0
    @: held void 0
    int: base
    int: kind
    int: status
    if: arena = 0 || root = 0 || place = 0 || value = 0 || value\present = 0
        return: c.LMX_WALK_INVALID
    if: value\kind = c.LMX_WALK_VALUE_REFERENCE && value\ref != 0
        status: c.lmx_implements_receive_cell(arena, c.lmx_graph_cell_in(arena, root, index), value\ref)
        if: status != c.LMX_WALK_OK
            return: status
        base: c.lmx_type_base(place\type)
        kind: (cast: (int) c.lmx_domain_kind(arena, value\ref))
        if: base = c.LMX_TYPE_DESC
            held: place\address
            if: place\descriptor = 0
                status: lmx_walk_place_load(arena, place, current_p)
                if: status != c.LMX_WALK_OK
                    return: status
                held: current_p\ref
            ---
            if: kind != c.LMX_KIND_ARRAY || (held != 0 && c.lmx_domain_type(arena, value\ref) != c.lmx_domain_type(arena, held))
                return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
            ---
        ---
        if: base = c.LMX_TYPE_LMX && kind != c.LMX_KIND_STRUCT && (place\descriptor = 0 || place\address != 0 || kind != c.LMX_KIND_ARRAY)
            return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    ---
    if: place\descriptor = 0
        return: lmx_walk_value_store(arena, place, value)
    if: value\kind != c.LMX_WALK_VALUE_REFERENCE
        if: lmx_walk_value_null_literal(value) = 0
            return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
        ---
    else:
        status: lmx_walk_value_materialize(arena, value, @ raw)
        if: status != c.LMX_WALK_OK
            return: status
        ---
    ---
    if: c.lmx_graph_ref_store_in(arena, root, index, raw) != 0
        return: c.LMX_WALK_INVALID
    return: c.LMX_WALK_OK
end: lmx_walk_value_field_store

fn: lmx_value_array_place (@: arena c.LmxArena; @: array c.LmxArray; size_t: index; @: out c.LmxWalkPlace) int
    int: type 0
    size_t: stride 0U
    if: array = 0
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
    if: out = 0 || c.lmx_domain_kind(arena, (cast: (@: void) array)) != c.LMX_KIND_ARRAY
        return: c.LMX_WALK_INVALID
    @: fields c.VoidArray @ array\array
    if: index >= fields\size
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
    if: fields\data = 0 || lmx_walk_array_elem_meta((cast: (int) c.lmx_domain_type(arena, (cast: (@: void) array))), @ type, @ stride) = 0
        return: c.LMX_WALK_INVALID
    out\address: c.lmx_array_cell_in(arena, array, index)
    out\storage: out\address
    out\type: type
    out\descriptor: 0
    out\context: c.lmx_pointer_cell_context(arena, out\address)
    if: out\address = 0 || c.lmx_range_type_of(arena, out\address) != type
        return: c.LMX_WALK_INVALID
    if: c.lmx_type_base(type) >= c.LMX_TYPE_POINTER_BASE
        if: c.lmx_pointer_pool_in(arena, out\address) = 0
            return: c.LMX_WALK_INVALID
        ---
    else:
        if: c.lmx_range_stride(arena, out\address) != stride
            return: c.LMX_WALK_INVALID
        ---
    ---
    return: c.LMX_WALK_OK
end: lmx_value_array_place

# The C size of one cell of a kernel type; 0 for a type that has no cell.
fn: lmx_walk_type_size (int: ty) size_t
    unsigned: probe_unsigned 0U
    ulong: probe_long 0U
    size_t: probe_size 0U
    @: probe_pointer void 0
    int: base c.lmx_type_base(ty)
    if: base = c.LMX_TYPE_CHAR || base = c.LMX_TYPE_UNSIGNED_CHAR
        return: c.sizeof(c.char)
    if: base = c.LMX_TYPE_INT
        return: c.sizeof(c.int)
    if: base = c.LMX_TYPE_UNSIGNED
        return: c.sizeof(probe_unsigned)
    if: base = c.LMX_TYPE_SIZE_T
        return: c.sizeof(probe_size)
    if: base = c.LMX_TYPE_ULONG
        return: c.sizeof(probe_long)
    if: base = c.LMX_TYPE_LMX || base = c.LMX_TYPE_DESC || base = c.LMX_TYPE_CHAR_PTR || base >= c.LMX_TYPE_POINTER_BASE
        return: c.sizeof(probe_pointer)
    return: 0U
end: lmx_walk_type_size

# INDEX consumes an already evaluated reference and received size_t index.
# Array cells use the descriptor's actual element metadata. Machine pointers
# use the same actual pointee classifier as DEREF; no lexical type is invented.
fn: lmx_walk_value_index_place (@: arena c.LmxArena; @: holder c.LmxWalkValue; size_t: index; @: out c.LmxWalkPlace) int
    int: status
    int: kind
    int: ty
    size_t: stride 0U
    size_t: offset 0U
    @: target void 0
    @: owner c.LmxWalkValue 0
    @: interval c.LmxRange 0
    if: holder = 0 || out = 0 || holder\present = 0
        return: c.LMX_WALK_INVALID
    if: holder\kind != c.LMX_WALK_VALUE_REFERENCE
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    if: holder\ref = 0
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
    kind: (cast: (int) c.lmx_domain_kind(arena, holder\ref))
    if: kind = c.LMX_KIND_ARRAY
        return: lmx_value_array_place(arena, (cast: (@: c.LmxArray) holder\ref), index, out)
    if: kind = c.LMX_KIND_STRUCT
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    status: lmx_walk_value_deref_actual(arena, holder, out)
    if: status != c.LMX_WALK_OK || index = 0U
        return: status
    owner: holder\referent
    if: owner != 0 && lmx_walk_value_storage(owner) = holder\ref
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
    ty: c.lmx_type_base((cast: (int) out\type))
    stride: c.lmx_range_stride(arena, holder\ref)
    if: stride = 0U
        stride: lmx_walk_type_size(ty)
    ---
    if: stride = 0U
        return: c.LMX_WALK_UNSUPPORTED
    if: index > c.SIZE_MAX / stride
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
    offset: index * stride
    if: (cast: (size_t) holder\ref) > c.SIZE_MAX - offset
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
    target: (cast: (@: void) ((cast: (@: char) holder\ref) + offset))
    interval: c.lmx_range_entry_at(arena, holder\ref)
    if: interval != 0
        if: c.lmx_range_entry_at(arena, target) != interval || c.lmx_range_type_of(arena, target) != out\type
            return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
        ---
    ---
    out\address: target
    out\storage: target
    out\context: c.lmx_value_address_context(arena, target, 0)
    return: c.LMX_WALK_OK
end: lmx_walk_value_index_place

# Slice 272: C sizeof of a value whose type is known only at run time, a free name: the size of its actual type's cell. A
# reference is one pointer cell. Reading the record evaluates nothing. A contextual literal or a foreign by-value object has no
# kernel cell size here.
fn: lmx_walk_value_size (@: value c.LmxWalkValue; @: out size_t) int
    @: probe_pointer void 0
    size_t: size 0U
    if: value = 0 || out = 0 || value\present = 0
        return: c.LMX_WALK_INVALID
    if: value\kind = c.LMX_WALK_VALUE_REFERENCE
        \out: c.sizeof(probe_pointer)
        return: c.LMX_WALK_OK
    if: value\kind != c.LMX_WALK_VALUE_NUMBER
        return: c.LMX_WALK_UNSUPPORTED
    size: lmx_walk_type_size((cast: (int) value\type))
    if: size = 0U
        return: c.LMX_WALK_UNSUPPORTED
    \out: size
    return: c.LMX_WALK_OK
end: lmx_walk_value_size

# Slice 272: the machine cast of a runtime-typed value to a pointer (L2 section 20: not a checked conversion). A reference gives
# its address, a number is taken as an address, as C casts them. A foreign by-value object has no such cast: the implicit `convert`.
fn: lmx_walk_value_cast_address (@: value c.LmxWalkValue; @@: out void) int
    size_t: number 0U
    int: ty 0
    if: value = 0 || out = 0 || value\present = 0
        return: c.LMX_WALK_INVALID
    if: value\kind = c.LMX_WALK_VALUE_REFERENCE
        out[0]: value\ref
        return: c.LMX_WALK_OK
    if: value\kind != c.LMX_WALK_VALUE_NUMBER
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    if: lmx_walk_value_number(value, @ number, @ ty) != c.LMX_WALK_OK
        return: c.LMX_WALK_INVALID
    out[0]: (cast: (@: void) number)
    return: c.LMX_WALK_OK
end: lmx_walk_value_cast_address

# Slice 272: the operand of a machine cast of a runtime-typed value to a number: a number as it is, a reference's address as a
# size_t number, as C casts a pointer. A foreign by-value object has no such cast: the implicit `convert`.
fn: lmx_walk_value_cast_operand (@: value c.LmxWalkValue; @: out c.LmxWalkValue) int
    if: value = 0 || out = 0 || value\present = 0
        return: c.LMX_WALK_INVALID
    if: value\kind = c.LMX_WALK_VALUE_REFERENCE
        return: lmx_walk_value_num(out, c.LMX_TYPE_SIZE_T, (cast: (size_t) value\ref))
    if: value\kind != c.LMX_WALK_VALUE_NUMBER
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    if: out != value
        c.memcpy((cast: (@: void) out), (cast: (@: void) value), c.sizeof(c.LmxWalkValue))
    return: c.LMX_WALK_OK
end: lmx_walk_value_cast_operand

# Slice 272: `length` of a runtime-typed value is the element count of the actual Array (the book, arrays).  Any other value is
# the implicit `convert`; a present null is the implicit `interpreter`, as a typed Array value's null use.
fn: lmx_walk_value_length (@: arena c.LmxArena; @: value c.LmxWalkValue; @: out size_t) int
    if: arena = 0 || value = 0 || out = 0 || value\present = 0
        return: c.LMX_WALK_INVALID
    if: value\kind != c.LMX_WALK_VALUE_REFERENCE
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    if: value\ref = 0
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
    if: c.lmx_domain_kind(arena, value\ref) != c.LMX_KIND_ARRAY
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    @: array c.LmxArray (cast: (@: c.LmxArray) value\ref)
    @: fields c.VoidArray @ array\array
    out[0]: (cast: (size_t) fields\size)
    return: c.LMX_WALK_OK
end: lmx_walk_value_length

fn: lmx_walk_arg_write (@: f c.LmxWalkFrame; size_t: k; int: ty; @: value c.LmxWalkValue; @: out c.LmxWalkValue) int
    c.LmxWalkPlace: local
    @: place c.LmxWalkPlace @ local
    int: status lmx_walk_arg_place(f, k, ty, place)
    if: status != c.LMX_WALK_OK
        return: status
    @: arena c.LmxArena (cast: (@: c.LmxArena) f\arena)
    status: lmx_walk_value_store(arena, place, value)
    if: status != c.LMX_WALK_OK
        return: status
    return: lmx_walk_place_load(arena, place, out)
end: lmx_walk_arg_write

fn: lmx_walk_array_elem_meta (int: aty; @: out_ety int; @: out_stride size_t) int
    ulong: ulong_probe 0U
    size_t: size_probe 0U
    @: pointer_probe void 0
    if: out_ety = 0 || out_stride = 0
        return: 0
    int: base_type c.lmx_type_base(aty)
    int: element_type c.lmx_type_element(aty)
    if: element_type = c.LMX_TYPE_NONE
        return: 0
    \out_ety: element_type
    if: base_type = c.LMX_TYPE_ARRAY_OF_CHAR
        \out_stride: c.sizeof(c.char)
        return: 1
    if: base_type = c.LMX_TYPE_ARRAY_OF_UNSIGNED_CHAR
        \out_stride: c.sizeof(c.char)
        return: 1
    if: base_type = c.LMX_TYPE_ARRAY_OF_INT
        \out_stride: c.sizeof(c.int)
        return: 1
    if: base_type = c.LMX_TYPE_ARRAY_OF_SIZE_T
        \out_stride: c.sizeof(size_probe)
        return: 1
    if: base_type = c.LMX_TYPE_ARRAY_OF_ULONG
        \out_stride: c.sizeof(ulong_probe)
        return: 1
    if: base_type = c.LMX_TYPE_ARRAY_OF_LMX
        \out_stride: c.sizeof(pointer_probe)
        return: 1
    if: base_type = c.LMX_TYPE_ARRAY_OF_DESC
        \out_stride: c.sizeof(pointer_probe)
        return: 1
    if: base_type >= c.LMX_TYPE_ARRAY_OF_POINTER_BASE
        \out_stride: c.sizeof(pointer_probe)
        return: 1
    return: 0
end: lmx_walk_array_elem_meta

# One raw native result boundary: absent witness is not a present null reference.
fn: lmx_walk_native_result_context (@: f c.LmxWalkFrame; @: witness void; @: raw void; @: out c.LmxWalkValue; @: context c.LmxWalkValue) int
    int: ty 0
    if: witness = 0
        lmx_walk_value_clear(out)
        return: c.LMX_WALK_OK
    ty: lmx_walk_witness_type((cast: (@: c.LmxArena) f\arena), witness)
    if: c.lmx_type_base(ty) >= c.LMX_TYPE_POINTER_BASE || c.lmx_type_base(ty) = c.LMX_TYPE_LMX || c.lmx_type_base(ty) = c.LMX_TYPE_DESC || c.lmx_type_base(ty) = c.LMX_TYPE_CHAR_PTR
        if: context != 0
            return: lmx_walk_value_ref_context(out, ty, raw, context)
        return: lmx_walk_value_ref(out, ty, raw)
    if: raw = 0
        lmx_walk_value_clear(out)
        return: c.LMX_WALK_INVALID
    return: lmx_walk_value_load((cast: (@: c.LmxArena) f\arena), raw, ty, out)
end: lmx_walk_native_result_context

fn: lmx_walk_native_result (@: f c.LmxWalkFrame; @: witness void; @: raw void; @: out c.LmxWalkValue) int
    return: lmx_walk_native_result_context(f, witness, raw, out, 0)
end: lmx_walk_native_result

fn: lmx_walk_result_dest (@: arena c.LmxArena; @: witness void; @: temp c.LmxWalkValue) @: void
    int: ty 0
    lmx_walk_value_clear(temp)
    if: witness = 0
        return: 0
    ty: lmx_walk_witness_type(arena, witness)
    if: c.lmx_type_base(ty) >= c.LMX_TYPE_POINTER_BASE || c.lmx_type_base(ty) = c.LMX_TYPE_LMX || c.lmx_type_base(ty) = c.LMX_TYPE_DESC || c.lmx_type_base(ty) = c.LMX_TYPE_CHAR_PTR
        lmx_walk_value_ref(temp, ty, 0)
    else:
        if: lmx_walk_value_num(temp, ty, 0U) != c.LMX_WALK_OK
            return: 0
        ---
    ---
    return: lmx_walk_value_storage(temp)
end: lmx_walk_result_dest

fn: lmx_walk_native_dest (@: f c.LmxWalkFrame; @: witness void; @: temp c.LmxWalkValue) @: void
    if: f = 0
        return: 0
    return: lmx_walk_result_dest((cast: (@: c.LmxArena) f\arena), witness, temp)
end: lmx_walk_native_dest

# Physical places and activation working rows: the existing common ABI, with explicit Frame/arena.
# Entry resolves PLACE once; publication uses saved physical slots and clears only successful dirty rows.
fn: lmx_walk_table_cells (@: f c.LmxWalkFrame; @: frame c.Lmx; size_t: at; @@: tokens char; @@: place_map size_t) int
    @: cell void 0
    \tokens: 0
    \place_map: 0
    if: f = 0 || frame = 0
        return: c.LMX_WALK_INVALID
    @: fields c.VoidArray @ frame\array
    if: fields\size < at + 2U
        return: c.LMX_WALK_INVALID
    cell: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), frame, at)
    if: cell = 0 || c.lmx_type_base(c.lmx_domain_type((cast: (@: c.LmxArena) f\arena), cell)) != c.LMX_TYPE_CHAR_PTR
        return: c.LMX_WALK_INVALID
    \tokens: c.lmx_charptr_value_known(cell)
    cell: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), frame, at + 1U)
    if: cell = 0 || c.lmx_type_base(c.lmx_domain_type((cast: (@: c.LmxArena) f\arena), cell)) != c.LMX_TYPE_CHAR_PTR
        return: c.LMX_WALK_INVALID
    \place_map: (cast: (@: size_t) c.lmx_charptr_value_known(cell))
    if: \tokens = 0 || \place_map = 0
        return: c.LMX_WALK_INVALID
    return: c.LMX_WALK_OK
end: lmx_walk_table_cells

fn: lmx_walk_place_open (@: f c.LmxWalkFrame; @: place c.Lmx) int
    @: tokens char 0
    @: place_map size_t 0
    @: room void 0
    size_t: m 0U
    int: answer
    if: lmx_walk_table_cells(f, place, 1U, @ tokens, @ place_map) != c.LMX_WALK_OK
        return: c.LMX_WALK_INVALID
    if: f\place_table = place_map
        return: c.LMX_WALK_OK
    if: f\place_table != 0 || f\node = 0 || f\context = 0
        return: c.LMX_WALK_INVALID
    @: context c.LmxWalkContext (cast: (@: c.LmxWalkContext) f\context)
    @: scratch c.LmxScratch (cast: (@: c.LmxScratch) context\scratch)
    if: scratch = 0
        return: c.LMX_WALK_INVALID
    m: place_map[0]
    if: m = 0U || m > (cast: (size_t) -1) / c.sizeof(m)
        return: c.LMX_WALK_INVALID
    if: c.lmx_scratch_take(scratch, m * c.sizeof(m), @ room) != c.LMX_SCRATCH_OK || room = 0
        return: c.LMX_WALK_NOMEM
    answer: c.lmx_implements_places((cast: (@: c.LmxArena) f\arena), f\node, tokens, place_map, (cast: (@: size_t) room))
    if: answer = c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_INVALID
    f\place_table: place_map
    f\place_slots: 0
    if: answer = c.LMX_IMPLEMENTS_YES
        f\place_slots: (cast: (@: size_t) room)
    f\place_n: m
    return: c.LMX_WALK_OK
end: lmx_walk_place_open

fn: lmx_walk_place_slot (@: f c.LmxWalkFrame; @: place c.Lmx; size_t: r; @: out size_t) int
    @: tokens char 0
    @: place_map size_t 0
    if: out = 0 || lmx_walk_table_cells(f, place, 1U, @ tokens, @ place_map) != c.LMX_WALK_OK
        return: c.LMX_WALK_INVALID
    if: f\place_table = 0 || f\place_table != place_map || r >= f\place_n
        return: c.LMX_WALK_INVALID
    if: f\place_slots = 0
        return: c.LMX_WALK_UNSUPPORTED
    @: slots size_t (cast: (@: size_t) f\place_slots)
    \out: slots[r]
    return: c.LMX_WALK_OK
end: lmx_walk_place_slot

fn: lmx_walk_inside (@: f c.LmxWalkFrame; @: root c.Lmx; @: p void) int
    @: h c.Lmx 0
    if: f = 0 || root = 0 || p = 0 || lmx_walk_kind(f, p) != c.LMX_KIND_STRUCT
        return: 0
    h: (cast: (@: c.Lmx) p)
    while: h != 0
        if: h = root
            return: 1
        h: (cast: (@: c.Lmx) h\parent)
    ---
    return: 0
end: lmx_walk_inside

fn: lmx_walk_slot_place (@: f c.LmxWalkFrame; @: code c.Lmx; size_t: first; int: write; @@: out_holder c.Lmx; @: out_index size_t; @@@: out_slot void) int
    @: holder void 0
    @: source_holder void 0
    @: index_cell void 0
    size_t: index
    size_t: resolved (cast: (size_t) -1)
    int: status
    int: answer
    int: op
    int: holder_op
    \out_holder: 0
    \out_index: 0U
    \out_slot: 0
    if: f = 0 || code = 0
        return: c.LMX_WALK_INVALID
    @: code_fields c.VoidArray @ code\array
    op: lmx_walk_node(f, (cast: (@: void) code))
    # A compact OWN/AT is the actual output operand. Its child1 is the
    # descriptor-reference place, not another storage object or body field.
    if: first = 1U && code_fields\size = 2U && (op = c.LMX_WALK_OP_OWN || op = c.LMX_WALK_OP_AT)
        holder: (cast: (@: void) code)
        index: 1U
    else:
        if: first >= code_fields\size || code_fields\size - first < 2U
            return: c.LMX_WALK_INVALID
        holder: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, first)
        index_cell: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, first + 1U)
        if: c.lmx_type_base(lmx_walk_numeric_type((cast: (@: c.LmxArena) f\arena), index_cell)) != c.LMX_TYPE_SIZE_T || c.lmx_range_stride((cast: (@: c.LmxArena) f\arena), index_cell) != c.sizeof(c.size_t)
            return: c.LMX_WALK_INVALID
        index: c.lmx_size_value_known(index_cell)
    ---
    source_holder: holder
    # N4: a PLACE holder names a code name's data place: its index is the name's ordinal, the slot the one the
    # activation resolved at its entry (lmx_walk_place_slot), and the holder the activation's data.  No projection
    # and no replay applies to it.
    if: holder != 0 && lmx_walk_kind(f, holder) = c.LMX_KIND_STRUCT && lmx_walk_head(f, (cast: (@: c.Lmx) holder)) = c.LMX_WALK_OP_PLACE
        status: lmx_walk_place_slot(f, (cast: (@: c.Lmx) holder), index, @ index)
        if: status != c.LMX_WALK_OK
            return: status
        holder: (cast: (@: void) f\node)
    else:
        # An OWN coordinate belongs to the code occurrence. If an admitted value
        # supplies that occurrence's data, its existing implements correspondence
        # selects the physical slot; the encoded source ordinal is not the data
        # ordinal. Explicit AT remains an address of its specified physical slot.
        if: op = c.LMX_WALK_OP_OWN && f\source != 0 && f\node != 0 && (source_holder = 0 || source_holder = (cast: (@: void) f\source))
            # A distinct data occurrence cannot silently use a code ordinal.
            # Its admission is composed with any earlier projection of that code;
            # the same accessor is used by the native callback.
            status: c.lmx_implements_code_slot((cast: (@: c.LmxArena) f\arena), f\node, f\source, index, @ resolved, @ answer)
            if: status != c.LMX_WALK_OK
                return: status
            if: answer = c.LMX_IMPLEMENTS_UNKNOWN
                return: c.LMX_WALK_UNSUPPORTED
            if: answer = c.LMX_IMPLEMENTS_NO
                return: c.LMX_WALK_INVALID
            ---
            index: resolved
            # N4 (SF14; Codex OPUS-CODEX-20261016-27): the slot is the one the actual pair's record names in the
            # data, so the data itself is the holder -- no position is replayed, under `call: code data` too.
            holder: (cast: (@: void) f\node)
        else:
            # -188 k.3c: when holder is the running activation's code, use its data (f\node).
            # K-OT2 (-194 к.5): holder = 0 is no longer refused here outright -- it is now a
            # valid sentinel lmx_walk_data_holder resolves to this activation's own data;
            # the classify-as-Structure check just below still refuses it when that
            # resolution has nothing to give (f\node = 0).
            holder: lmx_walk_data_holder(f, holder)
        ---
    ---
    if: lmx_walk_kind(f, holder) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_INVALID
    ---
    # -177 c4 / D-54 X1: a fixed holder must be a plain Structure reference, not an OP operand.
    # Mutant: accept DEREF as holder -> silent write into the operand RED.
    @: selected c.Lmx (cast: (@: c.Lmx) holder)
    @: holder_fields c.VoidArray @ selected\array
    holder_op: lmx_walk_node(f, holder)
    if: holder_op > c.LMX_WALK_OP_NONE && ((holder_op != c.LMX_WALK_OP_OWN && holder_op != c.LMX_WALK_OP_AT) || holder_fields\size != 2U || index != 1U)
        return: c.LMX_WALK_INVALID
    ---
    if: write != 0 && c.lmx_walk_immutable(f, holder) != 0
        return: c.LMX_WALK_INVALID
    ---
    if: index >= holder_fields\size
        return: c.LMX_WALK_INVALID
    \out_holder: (cast: (@: c.Lmx) holder)
    \out_index: index
    \out_slot: (cast: (@@: void) c.lmx_graph_cell_in((cast: (@: c.LmxArena) f\arena), \out_holder, index))
    if: \out_slot = 0
        return: c.LMX_WALK_INVALID
    return: c.LMX_WALK_OK
end: lmx_walk_slot_place

fn: lmx_walk_slot (@: f c.LmxWalkFrame; @: code c.Lmx; size_t: first; int: write) @@: void
    @: holder c.Lmx 0
    size_t: index 0U
    @@: slot void 0
    if: lmx_walk_slot_place(f, code, first, write, @ holder, @ index, @ slot) != c.LMX_WALK_OK
        return: 0
    return: slot
end: lmx_walk_slot

fn: lmx_walk_owned_holder (@: f c.LmxWalkFrame; @: holder c.Lmx) @: c.Lmx
    @: parent c.Lmx (cast: (@: c.Lmx) holder\parent)
    @: mapped c.Lmx 0
    @: child void 0
    size_t: index 0U
    if: holder = f\source
        return: (cast: (@: c.Lmx) f\node)
    if: parent = 0
        return: holder
    mapped: lmx_walk_owned_holder(f, parent)
    if: mapped = parent
        return: holder
    if: mapped = 0
        return: 0
    @: parent_fields c.VoidArray @ parent\array
    @: mapped_fields c.VoidArray @ mapped\array
    while: index < parent_fields\size && c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), parent, index) != (cast: (@: void) holder)
        index: index + 1U
    ---
    if: index >= parent_fields\size || index >= mapped_fields\size
        return: 0
    child: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), mapped, index)
    if: lmx_walk_kind(f, child) != c.LMX_KIND_STRUCT
        return: 0
    return: (cast: (@: c.Lmx) child)
end: lmx_walk_owned_holder

fn: lmx_walk_data_holder (@: f c.LmxWalkFrame; @: holder void) @: void
    if: f = 0
        return: holder
    ---
    # N4 (SF14; Codex OPUS-CODEX-20261016-27): an activation of `call: code data` -- entered by an EXEC with explicit
    # data, or resolving a place place_map -- reaches its data through PLACE or the record of the actual pair, and its code
    # through NODE.  Holder 0, or a fixed holder inside its code, would be the data's slot at the code's position --
    # wrong under `call: code data`, right only by accident when the code is the data: the translator's broken promise
    # (X1).
    if: (f\split != 0 || f\place_table != 0) && (holder = 0 || lmx_walk_inside(f, (cast: (@: c.Lmx) f\source), holder) != 0)
        return: 0
    ---
    if: holder = 0
        if: f\node = 0
            return: 0
        ---
        return: (cast: (@: void) f\node)
    ---
    if: f\source = 0 || f\node = 0 || f\source = f\node
        return: holder
    ---
    if: lmx_walk_kind(f, holder) != c.LMX_KIND_STRUCT
        return: holder
    ---
    return: (cast: (@: void) lmx_walk_owned_holder(f, (cast: (@: c.Lmx) holder)))
end: lmx_walk_data_holder

fn: lmx_walk_work_cell (@: f c.LmxWalkFrame; @: operand void; int: write; @@: holder c.Lmx; @: index size_t; @@@: slot void) int
    @: code c.Lmx 0
    c.LmxWalkValue: value
    @: valuep c.LmxWalkValue @ value
    int: op
    int: status
    if: f = 0 || operand = 0 || holder = 0 || index = 0 || slot = 0
        return: c.LMX_WALK_INVALID
    \holder: 0
    \index: 0U
    \slot: 0
    op: lmx_walk_node(f, operand)
    code: (cast: (@: c.Lmx) operand)
    if: op = c.LMX_WALK_OP_OWN
        return: lmx_walk_slot_place(f, code, 1U, write, holder, index, slot)
    ---
    if: op != c.LMX_WALK_OP_OWN_OF && op != c.LMX_WALK_OP_SET_OF
        return: c.LMX_WALK_INVALID
    @: code_fields c.VoidArray @ code\array
    if: code_fields\size < 3U
        return: c.LMX_WALK_INVALID
    status: c.lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U), @ value)
    if: status != c.LMX_WALK_OK
        return: status
    if: valuep\present = 0 || valuep\kind != c.LMX_WALK_VALUE_REFERENCE
        return: c.LMX_WALK_INVALID
    # A present reference holding nothing, followed: the implicit throw (as lmx_walk_place's OF).
    if: valuep\ref = 0
        return: lmx_walk_fault(f)
    if: lmx_walk_kind(f, (cast: (@: void) valuep\ref)) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_INVALID
    if: write != 0 && c.lmx_walk_immutable(f, (valuep\ref)) != 0
        return: c.LMX_WALK_INVALID
    \index: c.lmx_size_value_known(c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U))
    @: selected c.Lmx (cast: (@: c.Lmx) valuep\ref)
    @: selected_fields c.VoidArray @ selected\array
    if: \index >= selected_fields\size
        return: c.LMX_WALK_INVALID
    \holder: (cast: (@: c.Lmx) valuep\ref)
    \slot: (cast: (@@: void) c.lmx_graph_cell_in((cast: (@: c.LmxArena) f\arena), (cast: (@: c.Lmx) valuep\ref), \index))
    if: \slot = 0
        return: c.LMX_WALK_INVALID
    return: c.LMX_WALK_OK
end: lmx_walk_work_cell

fn: lmx_walk_work_find (@: f c.LmxWalkFrame; @@: slot void) @: c.LmxWalkWork
    @: e c.LmxWalkWork 0
    if: f = 0 || slot = 0
        return: 0
    e: (cast: (@: c.LmxWalkWork) f\work)
    while: e != 0
        if: e\slot = slot
            return: e
        e: (cast: (@: c.LmxWalkWork) e\next)
    ---
    return: 0
end: lmx_walk_work_find

fn: lmx_walk_work_make (@: f c.LmxWalkFrame; @: operand c.Lmx; @: holder c.Lmx; size_t: index; @@: slot void) int
    @: room void 0
    @: witness void 0
    @: e c.LmxWalkWork 0
    @: last c.LmxWalkWork 0
    size_t: witness_slot 0U
    int: op 0
    int: cell_kind 0
    int: status
    @: work_value c.LmxWalkValue 0
    if: f = 0 || f\context = 0 || slot = 0
        return: c.LMX_WALK_INVALID
    @: context c.LmxWalkContext (cast: (@: c.LmxWalkContext) f\context)
    @: scratch c.LmxScratch (cast: (@: c.LmxScratch) context\scratch)
    if: scratch = 0
        return: c.LMX_WALK_INVALID
    if: operand != 0
        @: operand_fields c.VoidArray @ operand\array
        op: lmx_walk_node(f, (cast: (@: void) operand))
        if: (op = c.LMX_WALK_OP_OWN || op = c.LMX_WALK_OP_OWN_OF) && operand_fields\size >= 4U
            witness_slot: 3U
        ---
        if: op = c.LMX_WALK_OP_SET_OF && operand_fields\size >= 5U
            witness_slot: 4U
        ---
    ---
    if: witness_slot != 0U
        witness: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), operand, witness_slot)
        if: witness = 0 || c.lmx_pointer_cell_canonical((cast: (@: c.LmxArena) f\arena), witness) = 0
            return: c.LMX_WALK_INVALID
        ---
        if: slot[0] = 0 || lmx_walk_pointer_cells_alike((cast: (@: c.LmxArena) f\arena), witness, slot[0]) = 0
            return: c.LMX_WALK_INVALID
        ---
    ---
    if: lmx_walk_work_find(f, slot) != 0
        return: c.LMX_WALK_OK
    if: c.lmx_scratch_take(scratch, c.sizeof(c.LmxWalkWork), @ room) != c.LMX_SCRATCH_OK || room = 0
        return: c.LMX_WALK_NOMEM
    e: (cast: (@: c.LmxWalkWork) room)
    e\holder: holder
    e\index: index
    e\slot: slot
    e\ty: c.LMX_TYPE_LMX
    e\dirty: 0
    e\next: 0
    e\kind: 3
    if: slot[0] != 0 && lmx_walk_is_pointer_cell((cast: (@: c.LmxArena) f\arena), slot[0]) != 0
        e\kind: 2
        e\ty: c.lmx_domain_type((cast: (@: c.LmxArena) f\arena), slot[0])
        # A materialized low graph value still belongs to its Graph slot.
        # Higher pointer-cell types retain their existing in-place writer.
        if: c.lmx_type_base(e\ty) = c.LMX_TYPE_LMX || c.lmx_type_base(e\ty) = c.LMX_TYPE_DESC
            e\kind: 3
        ---
    else:
        if: slot[0] != 0
            cell_kind: lmx_walk_kind(f, slot[0])
            if: cell_kind = c.LMX_KIND_ARRAY
                e\ty: c.LMX_TYPE_DESC
            ---
            if: cell_kind != c.LMX_KIND_STRUCT && cell_kind != c.LMX_KIND_ARRAY
                e\ty: lmx_walk_numeric_type((cast: (@: c.LmxArena) f\arena), slot[0])
                if: e\ty = 0
                    return: c.LMX_WALK_INVALID
                e\kind: 1
            ---
        ---
    ---
    # The selected physical cell is read once. Keep its complete Value as the
    # activation's payload; kind/ty above describe its publication place.
    work_value: @ e\value
    status: lmx_walk_value_cell((cast: (@: c.LmxArena) f\arena), slot[0], work_value)
    if: status != c.LMX_WALK_OK
        return: status
    if: f\work = 0
        f\work: e
    else:
        last: (cast: (@: c.LmxWalkWork) f\work)
        while: last\next != 0
            last: (cast: (@: c.LmxWalkWork) last\next)
        ---
        last\next: e
    ---
    f\nwork: f\nwork + 1U
    return: c.LMX_WALK_OK
end: lmx_walk_work_make

fn: lmx_walk_holder_here (@: f c.LmxWalkFrame; @: holder c.Lmx) int
    @: h c.Lmx holder
    while: h != 0
        if: h = f\node || h = f\code
            return: 1
        h: (cast: (@: c.Lmx) h\parent)
    ---
    return: 0
end: lmx_walk_holder_here

fn: lmx_walk_load_node (@: f c.LmxWalkFrame; @: operand c.Lmx) int
    return: lmx_walk_entry_node(f, operand, 0, 1)
end: lmx_walk_load_node

fn: lmx_walk_entry_body (@: f c.LmxWalkFrame; @: body c.Lmx; @@: entries c.Lmx; int: load) int
    @: child void 0
    size_t: i 0U
    int: status
    if: f = 0 || c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), (cast: (@: void) body)) = 0
        return: c.LMX_WALK_INVALID
    @: fields c.VoidArray @ body\array
    while: i < fields\size
        if: c.lmx_graph_cell_in((cast: (@: c.LmxArena) f\arena), body, i) = 0
            return: c.LMX_WALK_INVALID
        child: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), body, i)
        if: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), child) != 0 && lmx_walk_op(f, child) != c.LMX_WALK_OP_NONE
            status: lmx_walk_entry_node(f, (cast: (@: c.Lmx) child), entries, load)
            if: status != c.LMX_WALK_OK
                return: status
            ---
        ---
        i: i + 1U
    ---
    return: c.LMX_WALK_OK
end: lmx_walk_entry_body

fn: lmx_walk_entry_node (@: f c.LmxWalkFrame; @: operand c.Lmx; @@: entries c.Lmx; int: load) int
    @: child void 0
    @: named void 0
    @: actuals c.Lmx 0
    @: holder c.Lmx 0
    @@: slot void 0
    @: slow c.Lmx operand
    @: fast c.Lmx operand
    size_t: index 0U
    size_t: i 0U
    int: first_type 0
    int: current_type 0
    int: op 0
    int: child_op 0
    int: body_slot 0
    int: prim_source 0
    int: status
    if: f = 0 || operand = 0
        return: c.LMX_WALK_INVALID
    @: operand_fields c.VoidArray @ operand\array
    # Recursive traversal follows only a child whose physical parent is the
    # current operand. A cycle in such edges is a cycle in the parent chain.
    while: fast != 0 && fast\parent != 0
        slow: (cast: (@: c.Lmx) slow\parent)
        fast: (cast: (@: c.Lmx) fast\parent)
        fast: (cast: (@: c.Lmx) fast\parent)
        if: fast != 0 && slow = fast
            return: c.LMX_WALK_INVALID
    ---
    op: lmx_walk_node(f, (cast: (@: void) operand))
    # Inert source is never entered merely because it is an actual. THROW's
    # explicitly selected actual-body route is handled by its own parent below.
    if: op = c.LMX_WALK_OP_SOURCE_INERT
        return: c.LMX_WALK_OK
    ---
    # N4: a split call's data places are resolved here, at the activation's entry.
    if: op = c.LMX_WALK_OP_PLACE
        return: lmx_walk_place_open(f, operand)
    ---
    if: (op = c.LMX_WALK_OP_PRIM || op = c.LMX_WALK_OP_PRIM_PUB) && operand_fields\size >= 3U && c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), operand, 2U) != 0
        status: lmx_walk_prim_source_check(f, operand)
        if: status != c.LMX_WALK_OK
            return: status
        ---
        prim_source: 1
    ---
    if: load = 0 && op = c.LMX_WALK_OP_ARG && lmx_walk_source_of(f, operand) = c.LMX_WALK_SOURCE_ARG_ENTRY
        if: operand_fields\size < 4U || c.lmx_type_base(c.lmx_domain_type((cast: (@: c.LmxArena) f\arena), c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), operand, 1U))) != c.LMX_TYPE_SIZE_T || c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), operand, 2U) = 0
            return: c.LMX_WALK_INVALID
        index: c.lmx_size_value_known(c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), operand, 1U))
        current_type: lmx_walk_witness_type((cast: (@: c.LmxArena) f\arena), c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), operand, 3U))
        # Slice 255 (design 4.5 B2a): a witness type of NONE is a free input without a static witness -- typed by its value
        # when the place is made (lmx_walk_values_arg_place); two entries of one input must still agree.
        if: index >= f\nargs || f\args = 0 || entries = 0
            return: c.LMX_WALK_INVALID
        if: entries[index] = 0
            entries[index]: operand
        else:
            first_type: lmx_walk_witness_type((cast: (@: c.LmxArena) f\arena), c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), entries[index], 3U))
            if: first_type != current_type
                return: c.LMX_WALK_INVALID
            ---
        ---
        ---
    ---
    if: load != 0 && (op = c.LMX_WALK_OP_OWN || op = c.LMX_WALK_OP_OWN_OF || op = c.LMX_WALK_OP_SET_OF)
        status: lmx_walk_work_cell(f, (cast: (@: void) operand), 0, @ holder, @ index, @ slot)
        # Entry may visit an untaken OWN. An unresolved numeric place has no
        # row to preload; the reached access will report it if actually used.
        if: status != c.LMX_WALK_OK && (op != c.LMX_WALK_OP_OWN || status != c.LMX_WALK_UNSUPPORTED)
            return: status
        ---
        if: status = c.LMX_WALK_OK && (op != c.LMX_WALK_OP_OWN || lmx_walk_holder_here(f, holder) != 0)
            status: lmx_walk_work_make(f, operand, holder, index, slot)
            if: status != c.LMX_WALK_OK
                return: status
            ---
        ---
    ---
    while: i < operand_fields\size
        child: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), operand, i)
        if: child != 0 && lmx_walk_kind(f, child) = c.LMX_KIND_STRUCT
            @: nested c.Lmx (cast: (@: c.Lmx) child)
            if: nested\parent = operand || (prim_source != 0 && i >= 3U)
                @: nested_fields c.VoidArray @ nested\array
                child_op: lmx_walk_op(f, child)
                if: child_op != c.LMX_WALK_OP_NONE
                    status: lmx_walk_entry_node(f, (cast: (@: c.Lmx) child), entries, load)
                else:
                    body_slot: 0
                    if: (op = c.LMX_WALK_OP_IF || op = c.LMX_WALK_OP_WHILE || op = c.LMX_WALK_OP_UNTIL || op = c.LMX_WALK_OP_FOR) && i = 2U
                        body_slot: 1
                    if: op = c.LMX_WALK_OP_FOR && i = 3U
                        body_slot: 1
                    if: op = c.LMX_WALK_OP_ELSE && i = 1U
                        body_slot: 1
                    if: op = c.LMX_WALK_OP_PAD && i + 1U = operand_fields\size
                        body_slot: 1
                    # THROW has an inert-looking source wrapper, but its actuals
                    # are evaluated by lmx_walk_throw in this activation. Follow
                    # only that operand route; other SOURCE_INERT bodies remain data.
                    if: op = c.LMX_WALK_OP_THROW && i = 1U && nested_fields\size = 1U
                        named: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), (cast: (@: c.Lmx) child), 0U)
                        if: named != 0 && lmx_walk_op(f, named) = c.LMX_WALK_OP_SOURCE_INERT
                            actuals: c.lmx_graph_ref_struct_in((cast: (@: c.LmxArena) f\arena), (cast: (@: c.Lmx) named), 1U)
                            if: actuals = 0
                                return: c.LMX_WALK_INVALID
                            ---
                            status: lmx_walk_entry_body(f, actuals, entries, load)
                            if: status != c.LMX_WALK_OK
                                return: status
                            ---
                        ---
                    ---
                    if: body_slot != 0
                        status: lmx_walk_entry_body(f, (cast: (@: c.Lmx) child), entries, load)
                    else:
                        status: c.LMX_WALK_OK
                    ---
                ---
                if: status != c.LMX_WALK_OK
                    return: status
                ---
            ---
        ---
        i: i + 1U
    ---
    return: c.LMX_WALK_OK
end: lmx_walk_entry_node

fn: lmx_walk_snapshot_args (@: f c.LmxWalkFrame; @: body c.Lmx) int
    @: room void 0
    @@: entries c.Lmx 0
    c.LmxWalkPlace: place
    size_t: i 0U
    int: status
    if: f = 0 || body = 0
        return: c.LMX_WALK_INVALID
    @: entry_probe c.Lmx 0
    if: f\nargs != 0U
        if: f\nargs > (cast: (size_t) -1) / c.sizeof(entry_probe)
            return: c.LMX_WALK_NOMEM
        @: context c.LmxWalkContext (cast: (@: c.LmxWalkContext) f\context)
        @: scratch c.LmxScratch (cast: (@: c.LmxScratch) context\scratch)
        if: c.lmx_scratch_take(scratch, f\nargs * c.sizeof(entry_probe), @ room) != c.LMX_SCRATCH_OK
            return: c.LMX_WALK_NOMEM
        entries: (cast: (@@: c.Lmx) room)
        c.memset(room, 0, f\nargs * c.sizeof(entry_probe))
    ---
    status: lmx_walk_entry_body(f, body, entries, 0)
    if: status != c.LMX_WALK_OK
        return: status
    i: 0U
    while: i < f\nargs
        if: entries[i] != 0
            status: c.lmx_walk_place(f, (cast: (@: void) entries[i]), 0, @ place)
            if: status != c.LMX_WALK_OK
                return: status
            ---
        ---
        i: i + 1U
    ---
    return: c.LMX_WALK_OK
end: lmx_walk_snapshot_args

fn: lmx_walk_publish (@: f c.LmxWalkFrame) int
    @: e c.LmxWalkWork 0
    @: ready c.LmxWalkValue 0
    @: materialized void 0
    size_t: number 0U
    int: ty 0
    int: status 0
    if: f = 0
        return: c.LMX_WALK_OK
    e: (cast: (@: c.LmxWalkWork) f\work)
    while: e != 0
        if: e\dirty != 0
            ready: @ e\value
            @@: row_slot void (cast: (@@: void) e\slot)
            if: (e\kind = 3 && c.lmx_walk_immutable(f, (cast: (@: void) row_slot)) != 0) || (e\kind != 3 && c.lmx_walk_immutable(f, row_slot[0]) != 0)
                return: c.LMX_WALK_INVALID
            if: e\kind = 1
                if: lmx_walk_value_number(ready, @ number, @ ty) != c.LMX_WALK_OK || lmx_walk_store_slot((cast: (@: c.LmxArena) f\arena), row_slot, number) != c.LMX_WALK_OK
                    return: c.LMX_WALK_INVALID
                ---
            ---
            if: e\kind = 2
                if: c.lmx_pointer_store_context_in((cast: (@: c.LmxArena) f\arena), row_slot[0], ready\ref, ready) != 0
                    return: c.LMX_WALK_INVALID
                ---
            ---
            if: e\kind = 3
                # Graph slots hold a materialized complete value. SET has
                # already supplied the same present working record as OWN.
                status: lmx_walk_value_materialize((cast: (@: c.LmxArena) f\arena), ready, @ materialized)
                if: status != c.LMX_WALK_OK
                    return: status
                if: c.lmx_graph_ref_store_in((cast: (@: c.LmxArena) f\arena), e\holder, e\index, materialized) != 0
                    return: c.LMX_WALK_INVALID
                ---
            ---
            e\dirty: 0
        ---
        e: (cast: (@: c.LmxWalkWork) e\next)
    ---
    return: c.LMX_WALK_OK
end: lmx_walk_publish

fn: lmx_walk_fault (@: f c.LmxWalkFrame) int
    if: f = 0
        return: c.LMX_WALK_INVALID
    f\payload: 0
    f\landing: 0
    return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
end: lmx_walk_fault

fn: lmx_walk_source_of (@: f c.LmxWalkFrame; @: code c.Lmx) int
    @: head void 0
    int: op
    if: f = 0 || code = 0
        return: c.LMX_WALK_SOURCE_ORDINARY
    @: fields c.VoidArray @ code\array
    if: fields\size = 0U
        return: c.LMX_WALK_SOURCE_ORDINARY
    head: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 0U)
    op: lmx_walk_code_in((cast: (@: c.LmxArena) f\arena), head)
    return: op / c.LMX_WALK_OP_COUNT
end: lmx_walk_source_of

# Open/receive/activate the same explicit frame, then rewind the same activation scratch.
# These existing common admission entry points do not add a library/runtime-specific rule.
sub: lmx_walk_frame_open (@: f c.LmxWalkFrame; @: context c.LmxWalkContext; @: code c.Lmx; @: source c.Lmx; @: data c.Lmx; @@: args void; size_t: nargs)
    c.memset((cast: (@: void) f), 0, c.sizeof(c.LmxWalkFrame))
    f\context: context
    f\arena: (cast: (@: c.LmxArena) context\arena)
    f\code: code
    f\source: source
    f\node: data
    f\args: args
    f\nargs: nargs
    # N4 (SF14): the EXEC that enters this activation with explicit data marks it once; nothing nested inherits it.
    f\split: context\split_entry
    context\split_entry: 0
end: lmx_walk_frame_open

# Read the existing receiving Frame as syntax, without evaluating its body,
# candidate or model operand. This decoder establishes only the carrier's
# shape and fixed physical places, never candidate admission. An operand
# that is itself a Frame remains that operand for ordinary consumption.
fn: lmx_walk_reception_parts (@: arena c.LmxArena; @: code c.Lmx; @@: model_operand c.Lmx; @@: receiving_record c.Lmx; @@: witness void; @: formal_index size_t) int
    @: fields c.VoidArray
    @: admission c.Lmx
    @: record c.Lmx
    @: model c.Lmx
    @: cell void
    @: held void
    size_t: index
    int: word
    if: model_operand = 0 || receiving_record = 0 || witness = 0 || formal_index = 0
        return: c.LMX_WALK_INVALID
    \model_operand: 0
    \receiving_record: 0
    \witness: 0
    \formal_index: 0U
    if: arena = 0 || code = 0 || c.lmx_range_classify(arena, (cast: (@: void) code)) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_INVALID
    fields: @ code\array
    word: lmx_walk_code_in(arena, c.lmx_graph_value_in(arena, code, 0U))
    if: fields\size != 4U || word != c.LMX_WALK_SOURCE_RECEPTION * c.LMX_WALK_OP_COUNT + c.LMX_WALK_OP_SET_ARG
        return: c.LMX_WALK_INVALID
    cell: c.lmx_graph_value_in(arena, code, 1U)
    if: cell = 0 || c.lmx_range_classify(arena, cell) != c.LMX_KIND_PRIMITIVE || c.lmx_type_base(c.lmx_range_type_of(arena, cell)) != c.LMX_TYPE_SIZE_T || c.lmx_range_stride(arena, cell) != c.sizeof(c.size_t)
        return: c.LMX_WALK_INVALID
    index: c.lmx_size_value_known(cell)
    held: c.lmx_graph_value_in(arena, code, 3U)
    if: held = 0 || c.lmx_range_classify(arena, held) = c.LMX_KIND_NONE
        return: c.LMX_WALK_INVALID
    admission: c.lmx_graph_ref_struct_in(arena, code, 2U)
    if: admission = 0
        return: c.LMX_WALK_INVALID
    fields: @ admission\array
    if: fields\size != 5U || lmx_walk_code_in(arena, c.lmx_graph_value_in(arena, admission, 0U)) != c.LMX_WALK_OP_ADMIT_AS
        return: c.LMX_WALK_INVALID
    cell: c.lmx_graph_value_in(arena, admission, 2U)
    if: cell != 0
        if: c.lmx_range_classify(arena, cell) != c.LMX_KIND_PRIMITIVE || c.lmx_type_base(c.lmx_range_type_of(arena, cell)) != c.LMX_TYPE_SIZE_T || c.lmx_range_stride(arena, cell) != c.sizeof(c.size_t) || c.lmx_size_value_known(cell) > 1U
            return: c.LMX_WALK_INVALID
        ---
    ---
    # The actual candidate is an ordinary expression. ARG and T7's AT are
    # both existing producers; neither is interpreted or restricted here.
    record: c.lmx_graph_ref_struct_in(arena, admission, 1U)
    model: c.lmx_graph_ref_struct_in(arena, admission, 4U)
    if: record = 0 || model = 0
        return: c.LMX_WALK_INVALID
    fields: @ record\array
    if: fields\size != 6U
        return: c.LMX_WALK_INVALID
    # The ordinary admission reader checks the record's coverage, reference
    # contracts and source context. Decoding it is not a proof of those facts.
    \model_operand: model
    \receiving_record: record
    \witness: held
    \formal_index: index
    return: c.LMX_WALK_OK
end: lmx_walk_reception_parts

fn: lmx_walk_receive (@: f c.LmxWalkFrame; @: body c.Lmx) int
    c.LmxWalkValue: dropped
    @: droppedp c.LmxWalkValue @ dropped
    @: child void 0
    @: model_operand c.Lmx
    @: receiving_record c.Lmx
    @: witness void
    size_t: formal_index
    size_t: i 0U
    int: status
    if: f = 0 || c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), (cast: (@: void) body)) = 0
        return: c.LMX_WALK_INVALID
    @: fields c.VoidArray @ body\array
    while: i < fields\size
        if: c.lmx_graph_cell_in((cast: (@: c.LmxArena) f\arena), body, i) = 0
            return: c.LMX_WALK_INVALID
        child: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), body, i)
        if: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), child) != 0 && lmx_walk_op(f, child) = c.LMX_WALK_OP_SET_ARG && lmx_walk_source_of(f, (cast: (@: c.Lmx) child)) = c.LMX_WALK_SOURCE_RECEPTION
            status: lmx_walk_reception_parts((cast: (@: c.LmxArena) f\arena), (cast: (@: c.Lmx) child), @ model_operand, @ receiving_record, @ witness, @ formal_index)
            if: status != c.LMX_WALK_OK
                return: status
            ---
            status: c.lmx_walk_eval(f, child, @ dropped)
            if: status != c.LMX_WALK_OK
                return: status
            ---
        ---
        i: i + 1U
    ---
    return: c.LMX_WALK_OK
end: lmx_walk_receive

# Slice 254 (design 4.5 B1): the inputs the caller marked free (LMX_WALK_VALUE_FREE) are resolved here, once, at the
# entry, from the chain of activation records -- before the entry snapshot could read a lexical source for them.  The
# frame's record (pushed by lmx_walk_activate_parts_values before the entry) learns the activation's input records
# first, so that the callees of this activation see them.  A frame without a record of its own resolves nothing.
sub: lmx_walk_entry_resolve (@: f c.LmxWalkFrame)
    @: arena c.LmxArena 0
    @: record c.LmxActivation 0
    @: item c.LmxWalkValue 0
    size_t: i 0U
    if: f = 0
        return
    arena: (cast: (@: c.LmxArena) f\arena)
    if: arena = 0
        return
    record: (cast: (@: c.LmxActivation) arena\activation)
    if: record = 0 || record\frame != (cast: (@: void) f)
        return
    record\values: (cast: (@: void) f\argown)
    record\refs: f\args
    record\width: f\nargs
    f\activation: (cast: (@: void) record)
    if: f\argown = 0
        return
    while: i < f\nargs
        item: f\argown + i
        if: item\kind = c.LMX_WALK_VALUE_FREE && item\present = 0
            lmx_activation_resolve_input(arena, i, 0, 0, 0U, (cast: (@: c.Lmx) f\node))
        ---
        i: i + 1U
    ---
    return
end: lmx_walk_entry_resolve

# Called after the reached activation has selected its lexical defaults.
# A pending free row at this point has neither a dynamic nor a lexical source.
fn: lmx_walk_admit_free_inputs (@: values c.LmxWalkValue; size_t: width) int
    size_t: i 0U
    if: values = 0 && width != 0U
        return: c.LMX_WALK_INVALID
    while: i < width
        @: input c.LmxWalkValue (values + i)
        if: (input\kind = c.LMX_WALK_VALUE_FREE || input\kind = c.LMX_WALK_VALUE_MISSING) && input\present = 0
            return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_IMPLEMENTS
        i: i + 1U
    ---
    return: c.LMX_WALK_OK
end: lmx_walk_admit_free_inputs

fn: lmx_walk_enter_parts_values (@: f c.LmxWalkFrame; @: context c.LmxWalkContext; @: code c.Lmx; @: body c.Lmx; @: source c.Lmx; @: data c.Lmx; @@: args void; size_t: nargs; @: values c.LmxWalkValue) int
    int: status
    if: f = 0
        return: c.LMX_WALK_INVALID
    if: context = 0 || (cast: (@: c.LmxArena) context\arena) = 0 || context\scratch = 0 || code = 0 || body = 0 || source = 0
        c.memset((cast: (@: void) f), 0, c.sizeof(c.LmxWalkFrame))
        return: c.LMX_WALK_INVALID
    lmx_walk_frame_open(f, context, code, source, data, args, nargs)
    if: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), (cast: (@: void) code)) = 0 || c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), (cast: (@: void) body)) = 0 || c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), (cast: (@: void) source)) = 0 || (data != 0 && c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), (cast: (@: void) data)) = 0)
        return: c.LMX_WALK_INVALID
    status: lmx_walk_args_open_values(f, values)
    if: status != c.LMX_WALK_OK
        return: status
    # Slice 254: the free inputs the caller left to this activation are resolved from the chain of activation records
    # before anything below could read a lexical source for them.
    lmx_walk_entry_resolve(f)
    # A callee-owned hidden input is captured before any entry-load holder or
    # body expression can alter its source. Ordinary forwarded ARG stays lazy.
    status: lmx_walk_snapshot_args(f, body)
    if: status != c.LMX_WALK_OK
        return: status
    # Then each formal receives its value, before the entry load and the body (lmx_walk_receive).
    status: lmx_walk_admit_free_inputs((cast: (@: c.LmxWalkValue) f\argown), (cast: (size_t) f\nargs))
    if: status != c.LMX_WALK_OK
        return: status
    return: lmx_walk_receive(f, body)
end: lmx_walk_enter_parts_values

fn: lmx_walk_enter_parts (@: f c.LmxWalkFrame; @: context c.LmxWalkContext; @: code c.Lmx; @: body c.Lmx; @: source c.Lmx; @: data c.Lmx; @@: args void; size_t: nargs) int
    return: lmx_walk_enter_parts_values(f, context, code, body, source, data, args, nargs, 0)
end: lmx_walk_enter_parts

fn: lmx_walk_enter (@: f c.LmxWalkFrame; @: context c.LmxWalkContext; @: code c.Lmx; @: data c.Lmx; @@: args void; size_t: nargs) int
    return: lmx_walk_enter_parts(f, context, code, code, code, data, args, nargs)
end: lmx_walk_enter

fn: lmx_walk_activate_parts_values (@: context c.LmxWalkContext; @: code c.Lmx; @: body c.Lmx; @: source c.Lmx; @: data c.Lmx; @@: args void; size_t: nargs; @: values c.LmxWalkValue; @: result c.LmxWalkValue) int
    c.LmxWalkFrame: frame
    c.LmxScratchMark: mark
    c.LmxActivation: act
    @: f c.LmxWalkFrame 0
    @: pm c.LmxScratchMark 0
    int: status
    int: a 0
    if: context = 0 || context\scratch = 0
        if: result != 0
            lmx_walk_value_clear(result)
        return: c.LMX_WALK_INVALID
    @: scratch c.LmxScratch (cast: (@: c.LmxScratch) context\scratch)
    f: @ frame
    pm: @ mark
    # Everything this activation takes from the scratch arena is taken after this mark and is
    # gone with the rewind below, whichever way the activation ends.
    if: c.lmx_scratch_mark(scratch, pm) != c.LMX_SCRATCH_OK
        if: result != 0
            lmx_walk_value_clear(result)
        return: c.LMX_WALK_INVALID
    # Slice 254 (design 4.5): this activation's record joins the chain before its entry resolves its free inputs; it
    # leaves with the activation, below, whichever way the activation ends.
    c.lmx_activation_push((cast: (@: c.LmxArena) context\arena), @ act, 1, code, args, 0, nargs, (cast: (@: void) f))
    status: lmx_walk_enter_parts_values(f, context, code, body, source, data, args, nargs, values)
    # An output may be the caller's input record. Snapshot all inputs first;
    # no subsequent callee place borrows that record or its scalar storage.
    if: result != 0
        lmx_walk_value_clear(result)
    # §7b: load the working rows used by this activation's selected body.
    if: status = c.LMX_WALK_OK
        status: c.lmx_walk_load_body(f, body)
    if: status = c.LMX_WALK_OK
        status: c.lmx_walk_body(f, body, 0U)
    # §7b: the activation ends -- a RET with its value already evaluated, a fall-off, or a throw that leaves -- so what
    # is dirty is published before control goes back (book §14).  Nested bodies end nothing: only this does.
    if: status = c.LMX_WALK_OK || status = c.LMX_WALK_STOPPED || status >= c.LMX_WALK_THROWN
        a: lmx_walk_publish(f)
        if: a != c.LMX_WALK_OK
            status: a
    ---
    if: status = c.LMX_WALK_OK && result != 0
        @: returned c.LmxWalkValue @ f\result
        c.memcpy((cast: (@: void) result), (cast: (@: void) returned), c.sizeof(c.LmxWalkValue))
    ---
    # THROWN: the key leaves as it is (the caller's bodies find its pad); only
    # the payload crosses. The caller reads it from this out-parameter.
    if: status >= c.LMX_WALK_THROWN && result != 0
        lmx_walk_value_ref(result, c.LMX_TYPE_LMX, (cast: (@: void) f\payload))
    ---
    c.lmx_activation_pop((cast: (@: c.LmxArena) context\arena), @ act)
    if: c.lmx_scratch_rewind(scratch, pm) != c.LMX_SCRATCH_OK && (status = c.LMX_WALK_OK || status = c.LMX_WALK_STOPPED)
        status: c.LMX_WALK_INVALID
    ---
    return: status
end: lmx_walk_activate_parts_values

fn: lmx_walk_activate_parts (@: context c.LmxWalkContext; @: code c.Lmx; @: body c.Lmx; @: source c.Lmx; @: data c.Lmx; @@: args void; size_t: nargs; @: result c.LmxWalkValue) int
    return: lmx_walk_activate_parts_values(context, code, body, source, data, args, nargs, 0, result)
end: lmx_walk_activate_parts

fn: lmx_walk_activate_values (@: context c.LmxWalkContext; @: code c.Lmx; @: data c.Lmx; @@: args void; size_t: nargs; @: values c.LmxWalkValue; @: result c.LmxWalkValue) int
    @: pool c.LmxPool 0
    @: body c.Lmx 0
    @: vars c.Lmx 0
    if: context != 0 && (cast: (@: c.LmxArena) context\arena) != 0 && code != 0 && c.lmx_range_classify((cast: (@: c.LmxArena) context\arena), (cast: (@: void) code)) = c.LMX_KIND_STRUCT
        # A receiver-produced fn is a typed arena value. Source spelling is
        # metadata for translation/toLmx, not the dispatch classification:
        # ordinary data may have the same four parts and even the name "fn".
        pool: c.lmx_range_cell_pool((cast: (@: c.LmxArena) context\arena), (cast: (@: void) code))
        if: pool != 0 && pool\role = c.LMX_POOL_ROLE_FN
            @: fields c.VoidArray @ code\array
            if: fields\size != 4U
                return: c.LMX_WALK_INVALID
            vars: c.lmx_graph_ref_struct_in((cast: (@: c.LmxArena) context\arena), code, 2U)
            body: c.lmx_graph_ref_struct_in((cast: (@: c.LmxArena) context\arena), code, 3U)
            if: vars = 0 || body = 0
                return: c.LMX_WALK_INVALID
            # The data arrives already resolved: every unary call site
            # selects the var part by the structural form it sees
            # (lmx_call_unary_data); an explicitly passed Structure --
            # an alias `call: F F` included -- passes through unchanged.
            return: lmx_walk_activate_parts_values(context, code, body, vars, data, args, nargs, values, result)
        ---
    ---
    return: lmx_walk_activate_parts_values(context, code, code, code, data, args, nargs, values, result)
end: lmx_walk_activate_values

fn: lmx_walk_activate (@: context c.LmxWalkContext; @: code c.Lmx; @: data c.Lmx; @@: args void; size_t: nargs; @: result c.LmxWalkValue) int
    return: lmx_walk_activate_values(context, code, data, args, nargs, 0, result)
end: lmx_walk_activate

# An ordinary unary call selects the unique written var place of this
# actual occurrence. Absence stays null; the call's required-place admission
# decides whether this body can run without data.
fn: lmx_call_unary_data (@: arena c.LmxArena; @: code c.Lmx) @: c.Lmx
    if: arena = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) code)) = 0
        return: 0
    @: pool c.LmxPool c.lmx_range_cell_pool(arena, (cast: (@: void) code))
    if: pool != 0 && pool\role = c.LMX_POOL_ROLE_FN
        @: fields c.VoidArray @ code\array
        if: fields\size != 4U
            return: 0
        return: c.lmx_graph_ref_struct_in(arena, code, 2U)
    ---
    c.VoidArray: name
    name\data: (cast: (@: void) "var")
    name\size: 3U
    size_t: slot 0U
    if: c.lmx_implements_call_field(arena, code, @ name, c.LMX_TYPE_LMX, @ slot) != c.LMX_IMPLEMENTS_YES
        return: 0
    return: c.lmx_graph_ref_struct_in(arena, code, slot)
end: lmx_call_unary_data

fn: lmx_walk_run (@: context c.LmxWalkContext; @: operand c.Lmx; @@: args void; size_t: nargs; @: out c.LmxWalkValue) int
    c.LmxWalkValue: ignored
    @: ignoredp c.LmxWalkValue @ ignored
    int: status
    if: out = 0
        out: @ ignored
    if: context = 0 || (cast: (@: c.LmxArena) context\arena) = 0 || (nargs != 0U && args = 0)
        return: c.LMX_WALK_INVALID
    status: lmx_walk_activate(context, operand, operand, args, nargs, out)
    if: status = c.LMX_WALK_STOPPED
        lmx_walk_value_clear(out)
        return: c.LMX_WALK_OK
    return: status
end: lmx_walk_run

fn: lmx_walk_admit_resolve (@: arena c.LmxArena; @: raw void; @@: out_value void) int
    \out_value: 0
    if: arena = 0
        return: 1
    ---
    if: raw = 0
        return: 0
    ---
    if: c.lmx_range_classify(arena, raw) = c.LMX_KIND_STRUCT
        \out_value: raw
        return: 0
    ---
    return: 1
end: lmx_walk_admit_resolve

fn: lmx_walk_admit_against (@: arena c.LmxArena; @: value c.Lmx; @: model c.Lmx; @@: out void) int
    int: admit
    int: status
    if: arena = 0 || value = 0 || model = 0 || out = 0
        return: 1
    ---
    # No Consumer supplies a narrower scope here: receive this explicit
    # interface through the SAME resolver, including runtime-built values.
    status: c.lmx_implements_admit_receiving_templates(arena, value, model, 0, 0U, 0, @ admit)
    if: status != c.LMX_WALK_OK
        \out: 0
        return: c.lmx_call_note_walk_fail(status)
    if: admit != c.LMX_IMPLEMENTS_NO
        \out: (cast: (@: void) value)
        return: 0
    ---
    \out: 0
    return: c.LMX_PRIMITIVE_THROW_IMPLEMENTS
end: lmx_walk_admit_against

fn: lmx_walk_model_project (@: f c.LmxWalkFrame; @: operand void; int: closed; @@: trail void; @@: out c.Lmx) int
    c.LmxWalkValue: mv
    @: mvp c.LmxWalkValue @ mv
    int: status
    if: f = 0 || out = 0
        return: c.LMX_WALK_INVALID
    \out: 0
    if: operand = 0 || lmx_walk_node(f, operand) = c.LMX_WALK_OP_NONE
        if: closed != 0 && operand != 0
            if: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), operand) = 0 || c.lmx_domain_kind((cast: (@: c.LmxArena) f\arena), operand) != c.LMX_KIND_STRUCT
                return: c.LMX_WALK_INVALID
            ---
        ---
        \out: (cast: (@: c.Lmx) operand)
        return: c.LMX_WALK_OK
    status: lmx_walk_projection_at(f, operand, closed, trail, @ mv)
    if: status != c.LMX_WALK_OK
        return: status
    if: mvp\present = 0 || mvp\kind != c.LMX_WALK_VALUE_REFERENCE || mvp\ref = 0
        return: c.LMX_WALK_INVALID
    if: closed != 0
        if: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), mvp\ref) = 0 || c.lmx_domain_kind((cast: (@: c.LmxArena) f\arena), mvp\ref) != c.LMX_KIND_STRUCT
            return: c.LMX_WALK_INVALID
        ---
    ---
    \out: (cast: (@: c.Lmx) mvp\ref)
    return: c.LMX_WALK_OK
end: lmx_walk_model_project

fn: lmx_walk_model_operand (@: f c.LmxWalkFrame; @: operand void; @@: out c.Lmx) int
    return: lmx_walk_model_project(f, operand, 0, 0, out)
end: lmx_walk_model_operand

# A description is not an executed body. UNSUPPORTED is an unresolved
# receiving expression, not permission or a reason to evaluate it here.
fn: lmx_walk_model_closed (@: f c.LmxWalkFrame; @: operand void; @@: out c.Lmx) int
    return: lmx_walk_model_project(f, operand, 1, 0, out)
end: lmx_walk_model_closed

# Read a receiving description in its explicitly selected declaring home.
# Local interpreter state is not a live activation or another context graph:
# no scratch, actual/default input, working row, body or provider is executed.
# Unknown selected data stays absent, never guessed from code or parent.
# Head inspection is the existing address-to-name table, not variable binding.
fn: receiving_head_is (@: name c.VoidArray; const: (@: text char)) int
    if: name = 0 || name\data = 0 || text = 0 || name\size != c.strlen(text)
        return: 0
    return: (cast: (int) (c.memcmp(name\data, (cast: (@: void) text), name\size) = 0))
end: receiving_head_is

fn: receiving_reference_head (@: name c.VoidArray) int
    if: name = 0 || name\data = 0 || name\size = 0U
        return: 0
    @: text char (cast: (@: char) name\data)
    size_t: i 0U
    while: i < name\size
        if: text[i] != 64
            return: 0
        i: i + 1U
    ---
    return: 1
end: receiving_reference_head

# Extract only the structural Model operand of a receiving declaration.
# This is not admission of the full SOURCE, a signature or its qualifiers.
# Defaults/names remain syntax. The selected Model receiver is already an
# address expression; its external spelling is never resolved here.
fn: receiving_source_model_step (@: f c.LmxWalkFrame; @: source void; @@: trail void; @@: out c.Lmx) int
    @: arena c.LmxArena (cast: (@: c.LmxArena) f\arena)
    int: op lmx_walk_node(f, source)
    if: op != c.LMX_WALK_OP_NONE && op != c.LMX_WALK_OP_SOURCE_INERT
        return: lmx_walk_model_project(f, source, 1, trail, out)
    @: source_node c.Lmx c.lmx_graph_node_in(arena, source)
    if: source_node = 0 || lmx_walk_kind(f, source) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_UNSUPPORTED
    @: fields c.VoidArray @ source_node\array
    @: name c.VoidArray (cast: (@: c.VoidArray) c.lmx_source_name_get(arena, source))
    if: name = 0
        # A transparent source grouping has one field, not a guessed Model.
        if: op != c.LMX_WALK_OP_NONE || fields\size != 1U
            return: c.LMX_WALK_UNSUPPORTED
        return: receiving_source_model_at(f, c.lmx_graph_value_in(arena, source_node, 0U), trail, out)
    if: fields\size != 2U
        return: c.LMX_WALK_UNSUPPORTED
    @: body c.Lmx c.lmx_graph_node_in(arena, c.lmx_graph_value_in(arena, source_node, 1U))
    if: body = 0 || lmx_walk_kind(f, (cast: (@: void) body)) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_INVALID
    @: arguments c.VoidArray @ body\array
    if: op = c.LMX_WALK_OP_NONE
        # The Model was selected at the declaring source site. Read that
        # explicit receiver; do not enter its body or inspect any defaults.
        @: receiver void c.lmx_graph_value_in(arena, source_node, 0U)
        int: receiver_op lmx_walk_node(f, receiver)
        if: receiver_op = c.LMX_WALK_OP_NONE || receiver_op = c.LMX_WALK_OP_SOURCE_INERT
            return: c.LMX_WALK_INVALID
        return: lmx_walk_model_project(f, receiver, 1, trail, out)
    if: receiving_head_is(name, "const") != 0 || receiving_head_is(name, "immutable") != 0 || receiving_head_is(name, "independent") != 0
        if: arguments\size != 1U
            return: c.LMX_WALK_UNSUPPORTED
        return: receiving_source_model_at(f, c.lmx_graph_value_in(arena, body, 0U), trail, out)
    if: receiving_reference_head(name) != 0
        if: arguments\size = 1U
            return: receiving_source_model_at(f, c.lmx_graph_value_in(arena, body, 0U), trail, out)
        if: arguments\size = 2U || arguments\size = 3U
            # Flat @: name Requirement [default]: the second operand is
            # the contract, not the name or the optional default expression.
            return: receiving_source_model_at(f, c.lmx_graph_value_in(arena, body, 1U), trail, out)
        return: c.LMX_WALK_UNSUPPORTED
    if: receiving_head_is(name, "int") != 0 || receiving_head_is(name, "char") != 0 || receiving_head_is(name, "size_t") != 0 || receiving_head_is(name, "unsigned") != 0 || receiving_head_is(name, "ulong") != 0 || receiving_head_is(name, "void") != 0 || receiving_head_is(name, "[]") != 0 || receiving_head_is(name, "fn") != 0 || receiving_head_is(name, "fm") != 0 || receiving_head_is(name, "sub") != 0
        return: c.LMX_WALK_UNSUPPORTED
    if: arguments\size != 1U
        return: c.LMX_WALK_UNSUPPORTED
    @: nested void c.lmx_graph_value_in(arena, body, 0U)
    @: nested_name c.VoidArray (cast: (@: c.VoidArray) c.lmx_source_name_get(arena, nested))
    if: nested_name = 0
        return: c.LMX_WALK_UNSUPPORTED
    # A composition's outer name is a receiving place, never a provider.
    return: receiving_source_model_at(f, nested, trail, out)
end: receiving_source_model_step

fn: receiving_source_model_at (@: f c.LmxWalkFrame; @: source void; @@: trail void; @@: out c.Lmx) int
    @@: scan void trail
    @: pointer_width void 0
    while: scan != 0
        if: scan[0] = source
            return: c.LMX_WALK_UNSUPPORTED
        scan: (cast: (@@: void) scan[1])
    ---
    @@: row void (cast: (@@: void) c.calloc(2U, sizeof(pointer_width)))
    if: row = 0
        return: c.LMX_WALK_NOMEM
    row[0]: source
    row[1]: (cast: (@: void) trail)
    # Projection has its own dependency-cycle guard. The current source is
    # checked here; only its ancestors are supplied to a bare projection.
    int: op lmx_walk_node(f, source)
    int: status
    if: op != c.LMX_WALK_OP_NONE && op != c.LMX_WALK_OP_SOURCE_INERT
        status: lmx_walk_model_project(f, source, 1, trail, out)
    else:
        status: receiving_source_model_step(f, source, row, out)
    ---
    c.free((cast: (@: void) row))
    return: status
end: receiving_source_model_at

fn: receiving_home (@: arena c.LmxArena; @: selected_code c.Lmx; @: selected_data c.Lmx; @: operand void; int: source_form; @@: out c.Lmx) int
    c.LmxWalkContext: context
    @: cp c.LmxWalkContext @ context
    c.LmxWalkFrame: frame
    @: fp c.LmxWalkFrame @ frame
    if: out = 0
        return: c.LMX_WALK_INVALID
    \out: 0
    if: arena = 0 || selected_code = 0 || operand = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) selected_code)) = 0
        return: c.LMX_WALK_INVALID
    if: c.lmx_domain_kind(arena, (cast: (@: void) selected_code)) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_INVALID
    if: selected_data != 0 && c.lmx_graph_node_in(arena, (cast: (@: void) selected_data)) = 0
        return: c.LMX_WALK_INVALID
    c.memset((cast: (@: void) cp), 0, c.sizeof(c.LmxWalkContext))
    c.memset((cast: (@: void) fp), 0, c.sizeof(c.LmxWalkFrame))
    cp\arena: arena
    fp\context: cp
    fp\arena: arena
    fp\code: selected_code
    fp\source: lmx_call_unary_data(arena, selected_code)
    fp\node: selected_data
    fp\split: (cast: (int) (selected_data != fp\source))
    if: source_form != 0
        return: receiving_source_model_at(fp, operand, 0, out)
    return: lmx_walk_model_closed(fp, operand, out)
end: receiving_home

fn: lmx_walk_receiving_model (@: arena c.LmxArena; @: selected_code c.Lmx; @: selected_data c.Lmx; @: operand void; @@: out c.Lmx) int
    return: receiving_home(arena, selected_code, selected_data, operand, 0, out)
end: lmx_walk_receiving_model

fn: lmx_walk_receiving_header_model (@: arena c.LmxArena; @: selected_code c.Lmx; @: selected_data c.Lmx; size_t: input; @@: out c.Lmx) int
    @: source void 0
    @: witness void 0
    size_t: source_count 0U
    size_t: physical (cast: (size_t) -1)
    int: status
    int: answer
    if: out = 0 || arena = 0 || selected_code = 0
        return: c.LMX_WALK_INVALID
    out[0]: 0
    if: c.lmx_callable_source_count(arena, selected_code, @ source_count) != 0 || source_count = 0U
        return: c.LMX_WALK_INVALID
    status: c.lmx_implements_exec_slot(arena, selected_code, 0U, @ physical, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    if: answer = c.LMX_IMPLEMENTS_UNKNOWN
        return: c.LMX_WALK_UNSUPPORTED
    if: answer = c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_INVALID
    @: args c.Lmx c.lmx_graph_node_in(arena, c.lmx_graph_value_in(arena, selected_code, physical))
    if: args = 0
        return: c.LMX_WALK_INVALID
    # input is a declaration SOURCE coordinate, not an ordinal in the
    # completed physical header. The LAST half is not an input coordinate.
    if: c.lmx_callable_source_entry(arena, args, input, @ source, @ witness) != 0
        return: c.LMX_WALK_INVALID
    if: source = 0
        return: c.LMX_WALK_UNSUPPORTED
    return: receiving_home(arena, selected_code, selected_data, source, 1, out)
end: lmx_walk_receiving_header_model

# Ordinary native primitive ABI: explicit declaring code and input coordinate.
# Read the declaration SOURCE from that selected header, never the ABI witness.
# No guessed lexical owner, provider lookup, body or mutable context is involved.
fn: lmx_walk_receiving_pair (@: owner void; @@: refs void; size_t: nargs; @: dest void; @@: out void; @: arena c.LmxArena; @: call_code c.Lmx; @: input_values c.LmxWalkValue; @: result_context c.LmxWalkValue) int
    @: declaring c.Lmx 0
    size_t: input 0U
    @: model c.Lmx 0
    int: status
    if: out = 0
        return: 1
    \out: 0
    if: arena = 0 || nargs != 2U || refs = 0 || refs[0] = 0 || refs[1] = 0
        return: 1
    declaring: (cast: (@: c.Lmx) c.lmx_pointer_value_known(refs[0]))
    input: c.lmx_size_value_known(refs[1])
    status: lmx_walk_receiving_header_model(arena, declaring, 0, input, @ model)
    if: status != c.LMX_WALK_OK
        return: c.lmx_call_note_walk_fail(status)
    if: model = 0
        return: c.lmx_call_note_walk_fail(c.LMX_WALK_INVALID)
    \out: (cast: (@: void) model)
    return: 0
end: lmx_walk_receiving_pair

fn: lmx_walk_admit_op (@: f c.LmxWalkFrame; @: code c.Lmx; @: out c.LmxWalkValue) int
    return: lmx_walk_admit_in(f, 0, code, out)
end: lmx_walk_admit_op

fn: lmx_walk_admit_in (@: f c.LmxWalkFrame; @: receiver c.Lmx; @: code c.Lmx; @: out c.LmxWalkValue) int
    c.LmxWalkFrame: space
    @: mf c.LmxWalkFrame f
    @: model c.Lmx 0
    @: record c.Lmx
    @: cell void
    size_t: payload_from_letter 0U
    int: status
    int: answer
    lmx_walk_value_clear(out)
    @: fields c.VoidArray @ code\array
    if: fields\size < 5U
        return: c.LMX_WALK_INVALID
    if: (receiver != 0) != (lmx_walk_source_of(f, code) = c.LMX_WALK_SOURCE_RECEIVING)
        return: c.LMX_WALK_INVALID
    if: receiver != 0
        c.memcpy((cast: (@: void) (@ space)), (cast: (@: void) f), c.sizeof(c.LmxWalkFrame))
        mf: @ space
        mf\code: receiver
        mf\source: receiver
        mf\node: receiver
        mf\args: 0
        mf\nargs: 0U
        mf\argown: 0
        mf\returned: 0
        mf\landing: 0
        mf\payload: 0
        mf\guarded: 0
        mf\work: 0
        mf\nwork: 0U
        mf\place_table: 0
        mf\place_slots: 0
        mf\place_n: 0U
    ---
    status: lmx_walk_model_operand(mf, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 4U), @ model)
    if: status != c.LMX_WALK_OK
        return: status
    if: model = 0 || lmx_walk_kind(f, (cast: (@: void) model)) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_INVALID
    cell: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U)
    if: cell != 0
        if: lmx_walk_load_numeric((cast: (@: c.LmxArena) f\arena), cell, @ payload_from_letter) != c.LMX_WALK_OK || payload_from_letter > 1U
            return: c.LMX_WALK_INVALID
        ---
    ---
    status: c.lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 3U), out)
    if: status != c.LMX_WALK_OK
        return: status
    if: out\present = 0
        return: c.LMX_WALK_OK
    # Slice 260 (design 4.5 B2b-2c; P1-NUMERIC-KIND): the admitted value is received as a graph reference first -- a present
    # number or foreign value, or a reference to no Structure, is the implicit `convert`, not a malformed operand.
    status: lmx_walk_value_receive_graph((cast: (@: c.LmxArena) f\arena), out, out)
    if: status != c.LMX_WALK_OK
        return: status
    if: payload_from_letter != 0U && out\ref != 0
        if: lmx_walk_kind(f, (cast: (@: void) out\ref)) != c.LMX_KIND_STRUCT
            return: c.LMX_WALK_INVALID
        out\ref: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), (cast: (@: c.Lmx) out\ref), 1U)
        if: out\ref = 0 || lmx_walk_kind(f, (cast: (@: void) out\ref)) != c.LMX_KIND_STRUCT
            f\payload: 0
            return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_IMPLEMENTS
        ---
        out\type: c.LMX_TYPE_LMX
        # Envelope context is not evidence about its extracted payload.
        c.lmx_value_context_copy(out, 0)
    ---
    record: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U))
    if: record = 0 || c.lmx_domain_kind((cast: (@: c.LmxArena) f\arena), (cast: (@: void) record)) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_INVALID
    answer: lmx_walk_value_admit((cast: (@: c.LmxArena) f\arena), out, model, record)
    if: answer = c.LMX_WALK_OK || answer = c.LMX_WALK_INVALID
        return: answer
    f\payload: 0
    return: answer
end: lmx_walk_admit_in

# Physical places, actual values, body/throw execution and capture use the same ABI.

fn: lmx_walk_shape_min (int: op) size_t
    if: op = c.LMX_WALK_OP_LIT || op = c.LMX_WALK_OP_OWN || op = c.LMX_WALK_OP_AT || op = c.LMX_WALK_OP_NEG || op = c.LMX_WALK_OP_POS || op = c.LMX_WALK_OP_BNOT || op = c.LMX_WALK_OP_LENGTH || op = c.LMX_WALK_OP_CALL
        return: 2U
    if: op = c.LMX_WALK_OP_OWN_OF || op = c.LMX_WALK_OP_OF || op = c.LMX_WALK_OP_OF_EDGE || op = c.LMX_WALK_OP_DEREF || op = c.LMX_WALK_OP_ELEM || op = c.LMX_WALK_OP_PUT || op = c.LMX_WALK_OP_SET || op = c.LMX_WALK_OP_ADDRESS || op = c.LMX_WALK_OP_GUARD || op = c.LMX_WALK_OP_NAMED || op = c.LMX_WALK_OP_THROW || op = c.LMX_WALK_OP_PRIM || op = c.LMX_WALK_OP_PRIM_PUB
        return: 3U
    if: op = c.LMX_WALK_OP_ADD || op = c.LMX_WALK_OP_SUB || op = c.LMX_WALK_OP_MUL || op = c.LMX_WALK_OP_DIV || op = c.LMX_WALK_OP_MOD || op = c.LMX_WALK_OP_LT || op = c.LMX_WALK_OP_EQ || op = c.LMX_WALK_OP_BAND || op = c.LMX_WALK_OP_BOR || op = c.LMX_WALK_OP_BXOR || op = c.LMX_WALK_OP_SHL || op = c.LMX_WALK_OP_SHR || op = c.LMX_WALK_OP_AND || op = c.LMX_WALK_OP_OR
        return: 3U
    if: op = c.LMX_WALK_OP_IF || op = c.LMX_WALK_OP_WHILE || op = c.LMX_WALK_OP_UNTIL
        return: 3U
    if: op = c.LMX_WALK_OP_ARG || op = c.LMX_WALK_OP_SET_ARG || op = c.LMX_WALK_OP_PUT_OF || op = c.LMX_WALK_OP_ELEMPUT || op = c.LMX_WALK_OP_PUT_REF || op = c.LMX_WALK_OP_SET_OF || op = c.LMX_WALK_OP_FOR
        return: 4U
    if: op = c.LMX_WALK_OP_EXEC
        return: 5U
    if: op = c.LMX_WALK_OP_RECEIVE
        return: 3U
    if: op = c.LMX_WALK_OP_PLACE
        return: 3U
    if: op = c.LMX_WALK_OP_CALL_DATA
        return: 4U
    if: op = c.LMX_WALK_OP_LAYOUT_SWITCH
        return: 2U
    return: 1U
end: lmx_walk_shape_min

fn: lmx_walk_place_mode (@: f c.LmxWalkFrame; @: operand void; int: write; int: closed; @@: trail void; @: out c.LmxWalkPlace) int
    c.LmxWalkValue: holder
    @: holder_p c.LmxWalkValue @ holder
    @: code c.Lmx (cast: (@: c.Lmx) operand)
    @: view_model c.Lmx 0
    @: slot_holder c.Lmx 0
    @: array c.LmxArray 0
    @@: slot void 0
    @: physical void 0
    @: cell void 0
    @: root void 0
    @: witness void 0
    size_t: index 0U
    size_t: resolved (cast: (size_t) -1)
    size_t: stride 0U
    size_t: witness_slot 0U
    int: type 0
    int: kind 0
    int: op 0
    int: status
    int: answer
    @: own c.LmxWalkValue 0
    @: code_fields c.VoidArray 0
    @@: args void 0
    @: pointer_probe void 0
    if: f = 0 || operand = 0 || out = 0
        return: c.LMX_WALK_INVALID
    c.memset((cast: (@: void) out), 0, c.sizeof(c.LmxWalkPlace))
    op: lmx_walk_node(f, operand)
    # Closed analysis shares the physical projection below. It cannot load
    # activation/default/working state or evaluate a holder to discover it.
    if: closed != 0 && op != c.LMX_WALK_OP_OF && op != c.LMX_WALK_OP_OF_EDGE && op != c.LMX_WALK_OP_AT
        return: c.LMX_WALK_UNSUPPORTED
    if: closed != 0 && write != 0
        return: c.LMX_WALK_INVALID
    # AT is a physical coordinate of an explicitly saved plain holder. Closed
    # analysis cannot acquire a compact output, activation PLACE, or computed
    # holder by evaluating it. The ordinary slot selector below still decides
    # whether selected data is available; no code ordinal is replayed into data.
    if: closed != 0 && op = c.LMX_WALK_OP_AT
        code_fields: @ code\array
        if: code_fields\size != 3U
            return: c.LMX_WALK_UNSUPPORTED
        root: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U)
        if: root = 0 || c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), root) = 0 || lmx_walk_node(f, root) != c.LMX_WALK_OP_NONE
            return: c.LMX_WALK_UNSUPPORTED
    ---
    if: lmx_walk_bare(f, operand) != 0
        return: c.LMX_WALK_INVALID
    # Item 4: a place frame reached here directly (the target of PUT, SET or ADDRESS) is validated before its operands too.
    if: op != c.LMX_WALK_OP_NONE && op != c.LMX_WALK_OP_UNKNOWN
        code_fields: @ code\array
        if: code_fields\size < lmx_walk_shape_min(op)
            return: c.LMX_WALK_INVALID
        ---
    ---
    if: op = c.LMX_WALK_OP_ARG
        index: c.lmx_size_value_known(c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U))
        type: lmx_walk_witness_type((cast: (@: c.LmxArena) f\arena), c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 3U))
        if: index >= f\nargs || f\args = 0
            return: c.LMX_WALK_INVALID
        args: (cast: (@@: void) f\args)
        if: args[index] = 0
            if: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U) = 0
                return: c.LMX_WALK_INVALID
            if: f\argown = 0
                return: c.LMX_WALK_INVALID
            own: (cast: (@: c.LmxWalkValue) f\argown) + index
            if: own\present < 0
                return: c.LMX_WALK_INVALID
            ---
            own\present: -1
            status: c.lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U), @ holder)
            own\present: 0
            if: status != c.LMX_WALK_OK
                return: status
            # Slice 255 (design 4.5 B2a): without a static witness the place is typed by the default's value.
            if: type = c.LMX_TYPE_NONE
                type: holder_p\type
            status: lmx_walk_arg_place(f, index, type, out)
            if: status != c.LMX_WALK_OK
                return: status
            status: lmx_walk_value_store((cast: (@: c.LmxArena) f\arena), out, @ holder)
            return: status
        ---
        return: lmx_walk_arg_place(f, index, type, out)
    if: op = c.LMX_WALK_OP_DEREF
        status: c.lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U), @ holder)
        if: status != c.LMX_WALK_OK
            return: status
        # Slice 258 (design 4.5 B2b-2a): without a static witness (a free pointer) the pointee type is the holder's actual
        # pointer code's (lmx_walk_value_deref_actual).
        witness: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U)
        if: witness = 0
            status: lmx_walk_value_deref_actual((cast: (@: c.LmxArena) f\arena), @ holder, out)
        else:
            status: lmx_walk_value_deref_place((cast: (@: c.LmxArena) f\arena), @ holder, lmx_walk_witness_type((cast: (@: c.LmxArena) f\arena), witness), out)
        ---
        if: status = c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
            return: lmx_walk_fault(f)
        return: status
    if: op = c.LMX_WALK_OP_ELEM || op = c.LMX_WALK_OP_ELEMPUT
        status: c.lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U), @ holder)
        if: status != c.LMX_WALK_OK
            return: status
        status: lmx_walk_index(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U), @ index)
        if: status != c.LMX_WALK_OK
            return: status
        status: lmx_walk_value_index_place((cast: (@: c.LmxArena) f\arena), @ holder, index, out)
        if: status = c.LMX_WALK_OK && write != 0 && c.lmx_walk_immutable(f, holder_p\ref) != 0
            return: c.LMX_WALK_INVALID
        if: status = c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
            return: lmx_walk_fault(f)
        return: status
    if: op = c.LMX_WALK_OP_AT || op = c.LMX_WALK_OP_OWN
        status: lmx_walk_slot_place(f, code, 1U, write, @ slot_holder, @ index, @ slot)
        if: status != c.LMX_WALK_OK
            return: status
        ---
    else:
        if: op != c.LMX_WALK_OP_OF && op != c.LMX_WALK_OP_OF_EDGE && op != c.LMX_WALK_OP_OWN_OF && op != c.LMX_WALK_OP_PUT_OF && op != c.LMX_WALK_OP_SET_OF
            return: c.LMX_WALK_INVALID
        status: lmx_walk_projection_at(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U), closed, trail, @ holder)
        if: status != c.LMX_WALK_OK
            return: status
        cell: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U)
        if: (op = c.LMX_WALK_OP_OF || op = c.LMX_WALK_OP_PUT_OF) && c.lmx_type_base(c.lmx_domain_type((cast: (@: c.LmxArena) f\arena), cell)) = c.LMX_TYPE_CHAR_PTR
            status: lmx_walk_value_named_place((cast: (@: c.LmxArena) f\arena), holder_p, c.lmx_charptr_value_known(cell), out)
            if: status = c.LMX_WALK_OK && write != 0 && c.lmx_walk_immutable(f, holder_p\ref) != 0
                return: c.LMX_WALK_INVALID
            return: status
        if: holder_p\present = 0 || holder_p\kind != c.LMX_WALK_VALUE_REFERENCE
            return: c.LMX_WALK_INVALID
        # A present reference holding nothing, followed: the implicit throw (the book, exceptions; Codex,
        # CODEX-STRUCT-NULL-20261011-151401) -- an absent slot below (lmx_walk_slot = 0) stays INVALID.
        if: holder_p\ref = 0
            if: closed != 0
                return: c.LMX_WALK_INVALID
            return: lmx_walk_fault(f)
        root: holder_p\ref
        if: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), root) = 0 || (write != 0 && c.lmx_walk_immutable(f, root) != 0)
            return: c.LMX_WALK_INVALID
        cell: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U)
        if: c.lmx_type_base(lmx_walk_numeric_type((cast: (@: c.LmxArena) f\arena), cell)) != c.LMX_TYPE_SIZE_T || c.lmx_range_stride((cast: (@: c.LmxArena) f\arena), cell) != c.sizeof(c.size_t)
            return: c.LMX_WALK_INVALID
        index: c.lmx_size_value_known(cell)
        # OF_EDGE carries a SOURCE-CODE edge. The five-cell form may name its
        # required code at child3; project through that SAME data/code pair
        # used by native access. Without it the existing self execution map
        # remains selected. Never substitute the data's own layout for a
        # supplied required code. OF's index remains physical.
        # Historical four/six-cell store carriers use child3 as their RHS;
        # they are not this five-cell projection description.
        if: op = c.LMX_WALK_OP_OF_EDGE
            if: code_fields\size = 5U && c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 3U) != 0
                status: lmx_walk_model_project(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 3U), closed, trail, @ view_model)
                if: status != c.LMX_WALK_OK
                    return: status
                status: c.lmx_implements_code_slot((cast: (@: c.LmxArena) f\arena), (cast: (@: c.Lmx) root), view_model, index, @ resolved, @ answer)
            else:
                status: c.lmx_implements_exec_slot((cast: (@: c.LmxArena) f\arena), (cast: (@: c.Lmx) root), index, @ resolved, @ answer)
            ---
            if: status != c.LMX_WALK_OK
                return: status
            if: answer = c.LMX_IMPLEMENTS_UNKNOWN
                return: c.LMX_WALK_UNSUPPORTED
            if: answer = c.LMX_IMPLEMENTS_NO
                return: c.LMX_WALK_INVALID
            ---
            index: resolved
        ---
        # The optional model occupies child3 on OF and child4 on PUT_OF.
        kind: 3
        if: op = c.LMX_WALK_OP_PUT_OF
            kind: 4
        if: (op = c.LMX_WALK_OP_OF || op = c.LMX_WALK_OP_PUT_OF) && code_fields\size > (cast: (size_t) kind) && c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, (cast: (size_t) kind)) != 0
            status: lmx_walk_model_project(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, (cast: (size_t) kind)), closed, trail, @ view_model)
            if: status != c.LMX_WALK_OK
                return: status
            status: c.lmx_implements_slot((cast: (@: c.LmxArena) f\arena), (cast: (@: c.Lmx) root), view_model, index, @ resolved, @ answer)
            if: status != c.LMX_WALK_OK
                return: status
            if: answer = c.LMX_IMPLEMENTS_UNKNOWN
                return: c.LMX_WALK_UNSUPPORTED
            if: answer = c.LMX_IMPLEMENTS_NO
                return: c.LMX_WALK_INVALID
            ---
            index: resolved
        ---
        # The resolved projection selects one physical place. Array primitive
        # elements are already value cells; CHILDREN/REF backing stores an
        # address. This is a storage distinction, never another path lookup.
        physical: c.lmx_graph_cell_in((cast: (@: c.LmxArena) f\arena), (cast: (@: c.Lmx) root), index)
        if: physical = 0
            return: c.LMX_WALK_INVALID
        if: c.lmx_domain_kind((cast: (@: c.LmxArena) f\arena), physical) = c.LMX_KIND_PRIMITIVE
            out\storage: physical
        else:
            if: c.lmx_range_stride((cast: (@: c.LmxArena) f\arena), physical) != sizeof(pointer_probe)
                return: c.LMX_WALK_INVALID
            slot: (cast: (@@: void) physical)
        ---
        # A partial copy holds only the places its copied code uses (lmx_copy_carry_records): a read of one it holds no
        # object at was never carried and is refused, never read as nothing (Codex -28 review point 3).
        if: write = 0 && slot != 0 && slot[0] = 0 && c.lmx_implements_holes((cast: (@: c.LmxArena) f\arena), (cast: (@: c.Lmx) root)) != 0
            return: c.LMX_WALK_INVALID
    ---
    if: slot = 0
        if: out\storage = 0
            return: c.LMX_WALK_INVALID
        cell: out\storage
    else:
        cell: slot[0]
        out\storage: (cast: (@: void) slot)
    ---
    # A widened physical place carries the type promised by its declaration. It must be checked before the
    # live slot can classify itself as an ordinary Structure, a null descriptor, or a different pointer type.
    if: op = c.LMX_WALK_OP_AT && code_fields\size >= 4U
        witness_slot: 3U
    if: (op = c.LMX_WALK_OP_OF || op = c.LMX_WALK_OP_OF_EDGE) && code_fields\size >= 5U
        witness_slot: 4U
        # In the explicit code projection form the witness is optional:
        # graph/number places need no pointer-cell witness. Old pointer
        # carriers still require the same non-null witness as before.
        if: op = c.LMX_WALK_OP_OF_EDGE && code_fields\size = 5U && c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 3U) != 0 && c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 4U) = 0
            witness_slot: 0U
        ---
    if: op = c.LMX_WALK_OP_PUT_OF && code_fields\size >= 6U
        witness_slot: 5U
    if: witness_slot != 0U
        witness: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, witness_slot)
        if: witness = 0 || c.lmx_pointer_cell_canonical((cast: (@: c.LmxArena) f\arena), witness) = 0
            return: c.LMX_WALK_INVALID
        # An explicit typed place can have no value cell yet. Preserve that
        # absence on a read; a real typed cell containing null is nonzero.
        # Missing slots and holes were already refused above. A write still
        # requires an existing cell before evaluating its right-hand side.
        if: cell = 0
            if: write != 0 || slot = 0
                return: c.LMX_WALK_INVALID
            out\address: 0
            out\storage: 0
            out\type: c.lmx_domain_type((cast: (@: c.LmxArena) f\arena), witness)
            out\descriptor: 0
            out\context: 0
            return: c.LMX_WALK_OK
        ---
        # A logical Graph value keeps the same witness before and after a
        # lexical context is copied. Its original descriptor and a canonical
        # materialized low-LMX cell have different physical representations.
        if: c.lmx_type_base(c.lmx_domain_type((cast: (@: c.LmxArena) f\arena), witness)) = c.LMX_TYPE_LMX
            status: lmx_walk_graph_cell_place((cast: (@: c.LmxArena) f\arena), slot, 0, out)
            if: status = c.LMX_WALK_OK
                if: write != 0 && out\descriptor != 0
                    return: c.LMX_WALK_INVALID
                return: c.LMX_WALK_OK
            ---
        ---
        if: lmx_walk_pointer_cells_alike((cast: (@: c.LmxArena) f\arena), witness, cell) = 0
            return: c.LMX_WALK_INVALID
        ---
    ---
    return: lmx_walk_cell_place((cast: (@: c.LmxArena) f\arena), cell, (cast: (@: void) slot), out)
end: lmx_walk_place_mode

fn: lmx_walk_place (@: f c.LmxWalkFrame; @: operand void; int: write; @: out c.LmxWalkPlace) int
    return: lmx_walk_place_mode(f, operand, write, 0, 0, out)
end: lmx_walk_place

# NODE and OF/OF_EDGE use this same projection during ordinary execution
# and description analysis. Only ordinary execution may evaluate a dynamic
# base. There is no provider/name lookup or alternative positional map.
fn: lmx_walk_projection_step (@: f c.LmxWalkFrame; @: operand void; int: closed; @@: trail void; @: out c.LmxWalkValue) int
    @: code c.Lmx (cast: (@: c.Lmx) operand)
    @: fields c.VoidArray 0
    @: base c.Lmx 0
    @: leaf void 0
    c.LmxWalkValue: value
    @: vp c.LmxWalkValue @ value
    c.LmxWalkPlace: place
    size_t: steps 1U
    int: op 0
    int: status 0
    if: f = 0 || operand = 0 || out = 0
        return: c.LMX_WALK_INVALID
    lmx_walk_value_clear(out)
    op: lmx_walk_node(f, operand)
    if: op != c.LMX_WALK_OP_NODE && op != c.LMX_WALK_OP_SELF && op != c.LMX_WALK_OP_OF && op != c.LMX_WALK_OP_OF_EDGE && op != c.LMX_WALK_OP_AT
        if: closed = 0
            return: c.lmx_walk_eval(f, operand, out)
        if: op = c.LMX_WALK_OP_NONE
            if: lmx_walk_kind(f, operand) != c.LMX_KIND_STRUCT && lmx_walk_kind(f, operand) != c.LMX_KIND_ARRAY
                return: c.LMX_WALK_INVALID
            return: lmx_walk_value_cell((cast: (@: c.LmxArena) f\arena), operand, out)
        ---
        return: c.LMX_WALK_UNSUPPORTED
    ---
    if: lmx_walk_bare(f, operand) != 0
        return: c.LMX_WALK_INVALID
    fields: @ code\array
    if: fields\size < lmx_walk_shape_min(op)
        return: c.LMX_WALK_INVALID
    if: op = c.LMX_WALK_OP_SELF
        if: f\node = 0 || c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), (cast: (@: void) f\node)) = 0
            return: c.LMX_WALK_INVALID
        # SELF names selected data, not NODE(0)'s selected code.
        return: lmx_walk_value_ref(out, c.LMX_TYPE_LMX, (cast: (@: void) f\node))
    if: op = c.LMX_WALK_OP_OF || op = c.LMX_WALK_OP_OF_EDGE || op = c.LMX_WALK_OP_AT
        status: lmx_walk_place_mode(f, operand, 0, closed, trail, @ place)
        if: status != c.LMX_WALK_OK
            return: status
        return: lmx_walk_place_load((cast: (@: c.LmxArena) f\arena), @ place, out)
    # The historical one-cell NODE means one parent; typed SIZE_T gives
    # an exact count, including zero. A third operand selects its base.
    if: fields\size != 1U && fields\size != 2U && fields\size != 3U
        return: c.LMX_WALK_INVALID
    if: fields\size >= 2U
        leaf: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U)
        if: c.lmx_type_base(lmx_walk_numeric_type((cast: (@: c.LmxArena) f\arena), leaf)) != c.LMX_TYPE_SIZE_T || c.lmx_range_stride((cast: (@: c.LmxArena) f\arena), leaf) != c.sizeof(c.size_t)
            return: c.LMX_WALK_INVALID
        steps: c.lmx_size_value_known(leaf)
    ---
    base: (cast: (@: c.Lmx) f\code)
    if: fields\size = 3U
        status: lmx_walk_projection_at(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U), closed, trail, @ value)
        if: status != c.LMX_WALK_OK
            return: status
        if: vp\present = 0 || vp\kind != c.LMX_WALK_VALUE_REFERENCE || vp\type != c.LMX_TYPE_LMX || vp\ref = 0
            return: c.LMX_WALK_INVALID
        if: lmx_walk_kind(f, (cast: (@: void) vp\ref)) != c.LMX_KIND_STRUCT
            return: c.LMX_WALK_INVALID
        base: (cast: (@: c.Lmx) vp\ref)
    ---
    while: steps > 0U
        if: base = 0 || lmx_walk_kind(f, (cast: (@: void) base)) != c.LMX_KIND_STRUCT || base\parent = 0
            return: c.LMX_WALK_INVALID
        base: (cast: (@: c.Lmx) base\parent)
        steps: steps - 1U
    ---
    if: base = 0 || c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), (cast: (@: void) base)) = 0
        return: c.LMX_WALK_INVALID
    return: lmx_walk_value_ref(out, c.LMX_TYPE_LMX, (cast: (@: void) base))
end: lmx_walk_projection_step

# Temporary operation-local ancestry, not a graph field or an admission
# passport. Reject only an active dependency cycle; repeated model targets
# and ordinary data cycles are not traversed. Every row is freed on return.
fn: lmx_walk_projection_at (@: f c.LmxWalkFrame; @: operand void; int: closed; @@: trail void; @: out c.LmxWalkValue) int
    @@: scan void trail
    @@: row void 0
    @: pointer_width void 0
    int: status 0
    if: f = 0 || operand = 0 || out = 0
        return: c.LMX_WALK_INVALID
    if: closed = 0
        return: lmx_walk_projection_step(f, operand, 0, 0, out)
    lmx_walk_value_clear(out)
    while: scan != 0
        if: scan[0] = operand
            return: c.LMX_WALK_INVALID
        scan: (cast: (@@: void) scan[1])
    ---
    row: (cast: (@@: void) c.calloc(2U, sizeof(pointer_width)))
    if: row = 0
        return: c.LMX_WALK_NOMEM
    row[0]: operand
    row[1]: (cast: (@: void) trail)
    status: lmx_walk_projection_step(f, operand, 1, row, out)
    c.free((cast: (@: void) row))
    return: status
end: lmx_walk_projection_at

fn: lmx_walk_projection (@: f c.LmxWalkFrame; @: operand void; int: closed; @: out c.LmxWalkValue) int
    return: lmx_walk_projection_at(f, operand, closed, 0, out)
end: lmx_walk_projection

fn: lmx_walk_empty (@: f c.LmxWalkFrame; @: code c.Lmx; @: out c.LmxWalkValue) int
    @: value c.Lmx c.lmx_node_new_owned((cast: (@: c.LmxArena) f\arena))
    if: value = 0
        return: c.LMX_WALK_NOMEM
    return: lmx_walk_value_ref(out, c.LMX_TYPE_LMX, (cast: (@: void) value))
end: lmx_walk_empty

fn: lmx_walk_catch_bind (@: f c.LmxWalkFrame) int
    @: pad c.Lmx 0
    @: payload c.Lmx 0
    @: handler c.Lmx 0
    @: cell void 0
    @: arg void 0
    size_t: pcount 0U
    size_t: i 0U
    c.LmxWalkValue: value
    @: value_p c.LmxWalkValue @ value
    c.LmxWalkPlace: place
    @: place_p c.LmxWalkPlace @ place
    int: status c.LMX_WALK_OK
    int: payload_kind 0
    @: pad_fields c.VoidArray 0
    @: payload_fields c.VoidArray 0
    if: f = 0 || f\landing = 0
        return: c.LMX_WALK_INVALID
    ---
    pad: (cast: (@: c.Lmx) f\landing)
    pad_fields: @ pad\array
    if: pad_fields\size < 3U
        return: c.LMX_WALK_INVALID
    pcount: pad_fields\size - 3U
    payload: (cast: (@: c.Lmx) f\payload)
    if: pcount != 0U && f\payload != 0
        payload_kind: lmx_walk_kind(f, (cast: (@: void) f\payload))
        if: payload_kind = c.LMX_KIND_STRUCT
            payload_fields: @ payload\array
        ---
    ---
    if: pcount != 0U && (f\payload = 0 || payload_kind != c.LMX_KIND_STRUCT || payload_fields\size < pcount)
        c.fprintf(c.l1_stderr(), "lmx: invariant: catch payload\n")
        c.abort()
    ---
    while: i < pcount && status = c.LMX_WALK_OK
        cell: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), pad, i + 2U)
        arg: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), payload, i)
        status: lmx_walk_value_cell((cast: (@: c.LmxArena) f\arena), arg, @ value)
        if: status = c.LMX_WALK_OK
            place_p\address: cell
            place_p\type: c.lmx_domain_type((cast: (@: c.LmxArena) f\arena), cell)
            place_p\descriptor: 0
            place_p\context: 0
            status: lmx_walk_value_store((cast: (@: c.LmxArena) f\arena), @ place, @ value)
        ---
        i: i + 1U
    ---
    if: status != c.LMX_WALK_OK
        return: status
    handler: c.lmx_graph_ref_struct_in((cast: (@: c.LmxArena) f\arena), pad, (pad_fields\size) - 1U)
    f\landing: 0
    f\payload: 0
    if: handler = 0
        return: c.LMX_WALK_INVALID
    return: lmx_walk_body(f, handler, 0U)
end: lmx_walk_catch_bind

# Read written forms from the explicit arena, without a working activation.
# The execution reader's classification counter is not part of graph shape.
fn: lmx_walk_shape_op (@: arena c.LmxArena; @: operand void) int
    int: op 0
    @: graph c.Lmx 0
    @: head void 0
    if: arena = 0 || operand = 0
        return: c.LMX_WALK_OP_NONE
    op: lmx_walk_role_in(arena, operand)
    if: op != c.LMX_WALK_OP_NONE
        return: op
    graph: c.lmx_graph_node_in(arena, operand)
    if: graph != 0
        head: c.lmx_graph_value_in(arena, graph, 0U)
        op: lmx_walk_role_in(arena, head)
        if: op != c.LMX_WALK_OP_NONE
            return: op
        if: head != 0 && c.lmx_range_classify(arena, head) = c.LMX_DOMAIN_KIND_OP
            return: c.LMX_WALK_OP_UNKNOWN
        return: c.LMX_WALK_OP_NONE
    ---
    if: c.lmx_range_classify(arena, operand) = c.LMX_DOMAIN_KIND_OP
        return: c.LMX_WALK_OP_UNKNOWN
    return: c.LMX_WALK_OP_NONE
end: lmx_walk_shape_op

# This is only the CALL/EXEC envelope, not callable selection or admission.
# Keep raw nonnull contract presence: its validation follows selector effects.
fn: lmx_walk_call_shape (@: arena c.LmxArena; @: code c.Lmx; @: out_op int; @: out_first size_t; @: out_count size_t; @@: out_selector void; @@: out_data void; @@: out_contract void) int
    int: op 0
    int: short_ok 0
    size_t: first 5U
    @: fields c.VoidArray 0
    @: third void 0
    @: third_graph c.Lmx 0
    @: third_fields c.VoidArray 0
    if: out_op = 0 || out_first = 0 || out_count = 0 || out_selector = 0 || out_data = 0 || out_contract = 0
        return: c.LMX_WALK_INVALID
    \out_op: c.LMX_WALK_OP_NONE
    \out_first: 0U
    \out_count: 0U
    \out_selector: 0
    \out_data: 0
    \out_contract: 0
    if: arena = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) code)) = 0
        return: c.LMX_WALK_INVALID
    op: lmx_walk_shape_op(arena, (cast: (@: void) code))
    if: op != c.LMX_WALK_OP_CALL && op != c.LMX_WALK_OP_EXEC
        return: c.LMX_WALK_INVALID
    fields: @ code\array
    # A direct short CALL can have any arity. A long CALL retains an empty
    # data operand or a plain two-part contract at position3.
    if: op = c.LMX_WALK_OP_CALL && fields\size >= 2U
        if: fields\size < 5U
            short_ok: 1
        else:
            if: c.lmx_graph_value_in(arena, code, 2U) != 0
                third: c.lmx_graph_value_in(arena, code, 3U)
                if: third = 0 || c.lmx_range_classify(arena, third) != c.LMX_KIND_STRUCT || lmx_walk_shape_op(arena, third) != c.LMX_WALK_OP_NONE
                    short_ok: 1
                else:
                    third_graph: c.lmx_graph_node_in(arena, third)
                    if: third_graph = 0
                        return: c.LMX_WALK_INVALID
                    third_fields: @ third_graph\array
                    if: third_fields\size != 2U
                        short_ok: 1
                    ---
                ---
            ---
        ---
    ---
    if: short_ok != 0
        first: 2U
    if: fields\size < first
        return: c.LMX_WALK_INVALID
    \out_op: op
    \out_first: first
    \out_count: fields\size - first
    if: op = c.LMX_WALK_OP_EXEC
        \out_selector: c.lmx_graph_value_in(arena, code, 2U)
        \out_data: c.lmx_graph_value_in(arena, code, 1U)
    else:
        \out_selector: c.lmx_graph_value_in(arena, code, 1U)
        if: short_ok = 0
            \out_data: c.lmx_graph_value_in(arena, code, 2U)
        ---
    ---
    if: short_ok = 0
        \out_contract: c.lmx_graph_value_in(arena, code, 3U)
    return: c.LMX_WALK_OK
end: lmx_walk_call_shape

# A coordinate is a required-interface position, not a provider-layout index.
# Name binding, defaults and contract checking are deliberately outside this
# reader. Null operands still occupy their written coordinate.
# Written operands and NAMED interface coordinates have separate bounds.
# MAX denotes an unavailable coordinate. A source/name binding reader uses
# an unbounded coordinate_count and still obtains the real NAMED/payload;
# a legacy coordinate consumer must require a known coordinate before use.
fn: lmx_walk_actual_shape (@: arena c.LmxArena; @: operand void; size_t: written_slot; size_t: written_count; size_t: coordinate_count; @: out_coordinate size_t; @@: out_payload void; @@: out_named c.Lmx) int
    size_t: at 0U
    @: named c.Lmx 0
    @: fields c.VoidArray 0
    if: out_coordinate = 0 || out_payload = 0 || out_named = 0
        return: c.LMX_WALK_INVALID
    \out_coordinate: written_slot
    \out_payload: operand
    \out_named: 0
    if: arena = 0 || written_slot >= written_count
        return: c.LMX_WALK_INVALID
    if: lmx_walk_shape_op(arena, operand) != c.LMX_WALK_OP_NAMED
        return: c.LMX_WALK_OK
    named: c.lmx_graph_node_in(arena, operand)
    if: named = 0
        return: c.LMX_WALK_INVALID
    fields: @ named\array
    if: fields\size != 3U
        return: c.LMX_WALK_INVALID
    if: lmx_walk_load_numeric(arena, c.lmx_graph_value_in(arena, named, 1U), @ at) != c.LMX_WALK_OK
        if: c.lmx_graph_value_in(arena, named, 1U) != 0 && coordinate_count != (cast: (size_t) -1)
            return: c.LMX_WALK_INVALID
        at: (cast: (size_t) -1)
    ---
    if: at != (cast: (size_t) -1) && at >= coordinate_count
        return: c.LMX_WALK_INVALID
    \out_coordinate: at
    \out_payload: c.lmx_graph_value_in(arena, named, 2U)
    \out_named: named
    return: c.LMX_WALK_OK
end: lmx_walk_actual_shape

# A formed argument owns its head spelling through the caller's scratch
# lifetime. The source-name row is an arena service cell, but retirement can
# clear it; capture both header and bytes before evaluating payload effects.
# No target/formal/provider name is looked up by this copying helper.
fn: lmx_walk_capture_actual_name (@: scratch c.LmxScratch; @: name c.VoidArray; @@: out c.VoidArray) int
    @: room void 0
    @: bytes void 0
    @: captured c.VoidArray 0
    size_t: name_length
    int: status
    if: out = 0 || scratch = 0
        return: c.LMX_WALK_INVALID
    out[0]: 0
    if: name = 0 || name\size = 0U || name\data = 0
        return: c.LMX_WALK_OK
    name_length: name\size
    status: c.lmx_scratch_take(scratch, c.sizeof(c.VoidArray), @ room)
    if: status != c.LMX_SCRATCH_OK
        if: status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    captured: (cast: (@: c.VoidArray) room)
    status: c.lmx_scratch_take(scratch, name_length, @ bytes)
    if: status != c.LMX_SCRATCH_OK
        if: status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    c.memcpy(bytes, name\data, name_length)
    captured\size: name_length
    captured\data: bytes
    out[0]: captured
    return: c.LMX_WALK_OK
end: lmx_walk_capture_actual_name

# CALL-only evaluation phase. The caller owns the surrounding scratch mark
# and supplied physical-slot head arrays. Written operands are evaluated once
# in their written order; required-header scatter/type/default reception is a
# later phase. PRIM keeps the existing actuals_values path below.
# The normalized suffix after the written prefix (the hidden inputs this EXEC
# hands on) is evaluated once after every written operand, in slot order. A
# NULL suffix slot is an input handed absent: its Value stays absent.
fn: lmx_walk_written_values (@: f c.LmxWalkFrame; @: code c.Lmx; size_t: first; size_t: transport_count; size_t: written_count; @: actual_named int; @@: actual_names c.VoidArray; size_t: actual_capacity; @@: values_out c.LmxWalkValue) int
    @: context c.LmxWalkContext 0
    @: scratch c.LmxScratch 0
    @: arena c.LmxArena 0
    @: fields c.VoidArray 0
    @: values c.LmxWalkValue 0
    @: current c.LmxWalkValue 0
    @: named c.Lmx 0
    @: implicit c.Lmx 0
    @: implicit_fields c.VoidArray 0
    @: name c.VoidArray 0
    @: captured c.VoidArray 0
    @: room void 0
    @: payload void 0
    @: flag void 0
    size_t: coordinate 0U
    size_t: payload_from_letter 0U
    size_t: i 0U
    int: status
    if: values_out = 0
        return: c.LMX_WALK_INVALID
    values_out[0]: 0
    if: f = 0
        return: c.LMX_WALK_INVALID
    arena: (cast: (@: c.LmxArena) f\arena)
    context: (cast: (@: c.LmxWalkContext) f\context)
    if: arena = 0 || context = 0 || context\scratch = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) code)) = 0
        return: c.LMX_WALK_INVALID
    scratch: (cast: (@: c.LmxScratch) context\scratch)
    fields: @ code\array
    if: first > fields\size || transport_count > fields\size - first || written_count > transport_count
        return: c.LMX_WALK_INVALID
    if: transport_count = 0U
        return: c.LMX_WALK_OK
    if: written_count != 0U && (actual_named = 0 || actual_names = 0 || actual_capacity < first + written_count)
        return: c.LMX_WALK_INVALID
    if: transport_count > (cast: (size_t) -1) / c.sizeof(c.LmxWalkValue)
        return: c.LMX_WALK_NOMEM
    status: c.lmx_scratch_take(scratch, transport_count * c.sizeof(c.LmxWalkValue), @ room)
    if: status != c.LMX_SCRATCH_OK
        if: status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    values: (cast: (@: c.LmxWalkValue) room)
    c.memset(room, 0, transport_count * c.sizeof(c.LmxWalkValue))
    while: i < written_count
        current: values + i
        named: 0
        captured: 0
        implicit: 0
        payload_from_letter: 0U
        actual_named[first + i]: -1
        actual_names[first + i]: 0
        payload: c.lmx_graph_value_in(arena, code, first + i)
        status: lmx_walk_actual_shape(arena, payload, i, transport_count, (cast: (size_t) -1), @ coordinate, @ payload, @ named)
        if: status != c.LMX_WALK_OK
            return: status
        actual_named[first + i]: 0
        if: named != 0
            actual_named[first + i]: 1
            name: (cast: (@: c.VoidArray) c.lmx_source_name_get(arena, (cast: (@: void) named)))
            status: lmx_walk_capture_actual_name(scratch, name, @ captured)
            if: status != c.LMX_WALK_OK
                return: status
            actual_names[first + i]: captured
        ---
        # Only the compiler's implicit selected-formal reception is deferred.
        # An ordinary explicit ADMIT_AS still executes in its written place.
        if: payload != 0 && lmx_walk_op(f, payload) = c.LMX_WALK_OP_ADMIT_AS && lmx_walk_bare(f, payload) = 0 && lmx_walk_source_of(f, (cast: (@: c.Lmx) payload)) = c.LMX_WALK_SOURCE_RECEIVING
            implicit: c.lmx_graph_node_in(arena, payload)
            if: implicit = 0
                return: c.LMX_WALK_INVALID
            implicit_fields: @ implicit\array
            if: implicit_fields\size < 5U
                return: c.LMX_WALK_INVALID
            flag: c.lmx_graph_value_in(arena, implicit, 2U)
            if: flag != 0
                status: lmx_walk_load_numeric(arena, flag, @ payload_from_letter)
                if: status != c.LMX_WALK_OK || payload_from_letter > 1U
                    return: c.LMX_WALK_INVALID
                ---
            ---
            payload: c.lmx_graph_value_in(arena, implicit, 3U)
        ---
        if: payload != 0
            if: lmx_walk_op(f, payload) = c.LMX_WALK_OP_NONE
                status: lmx_walk_value_cell(arena, payload, current)
            else:
                status: c.lmx_walk_eval(f, payload, current)
            ---
            if: status != c.LMX_WALK_OK
                return: status
        ---
        if: payload_from_letter != 0U && current\present != 0
            if: current\kind != c.LMX_WALK_VALUE_REFERENCE
                return: c.LMX_WALK_INVALID
            if: current\ref != 0
                if: lmx_walk_kind(f, (cast: (@: void) current\ref)) != c.LMX_KIND_STRUCT
                    return: c.LMX_WALK_INVALID
                current\ref: c.lmx_graph_value_in(arena, (cast: (@: c.Lmx) current\ref), 1U)
                if: current\ref = 0 || lmx_walk_kind(f, (cast: (@: void) current\ref)) != c.LMX_KIND_STRUCT
                    f\payload: 0
                    return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_IMPLEMENTS
                ---
                current\type: c.LMX_TYPE_LMX
                # Envelope provenance does not describe the extracted payload.
                c.lmx_value_context_copy(current, 0)
            ---
        ---
        i: i + 1U
    ---
    while: i < transport_count
        current: values + i
        payload: c.lmx_graph_value_in(arena, code, first + i)
        if: payload != 0
            if: lmx_walk_op(f, payload) = c.LMX_WALK_OP_NONE
                status: lmx_walk_value_cell(arena, payload, current)
            else:
                status: c.lmx_walk_eval(f, payload, current)
            ---
            if: status != c.LMX_WALK_OK
                return: status
        ---
        i: i + 1U
    ---
    values_out[0]: values
    return: c.LMX_WALK_OK
end: lmx_walk_written_values

# Scatter values already evaluated in written order into the selected
# callable's complete SOURCE-order activation vector. The current binding
# supplies each s and verifies its forward physical q; no inverse/name search
# and no Consumer header width is used here.
# Occupancy is distinct from value presence: an explicit empty operand still
# occupies its formal and must never silently select a default.
# A written operand occupies its formal as 1. A normalized suffix input (the
# EXEC's hidden inputs after the written prefix) occupies it as 2, also when
# it was handed absent: that absence travels on to the selected entry.
# This is transport preparation only. The caller must first honor admission
# status/NO, then fill missing defaults and perform selected reception before
# taking ABI storage addresses. It owns the encompassing scratch mark.
fn: lmx_walk_scatter_written (@: f c.LmxWalkFrame; @: selected_args c.Lmx; @: written_call c.Lmx; size_t: first; size_t: transport_count; size_t: written_count; @: current c.LmxImplEntry; @: source_indices size_t; size_t: source_capacity; @: written_values c.LmxWalkValue; @@: out_values c.LmxWalkValue; @@: out_occupied int; @: out_count size_t) int
    @: context c.LmxWalkContext 0
    @: scratch c.LmxScratch 0
    @: values c.LmxWalkValue 0
    @: occupied int 0
    @: room void 0
    size_t: count 0U
    size_t: i 0U
    size_t: source_index (cast: (size_t) -1)
    size_t: physical (cast: (size_t) -1)
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    int: scratch_status
    if: out_values = 0 || out_occupied = 0 || out_count = 0
        return: c.LMX_WALK_INVALID
    out_values[0]: 0
    out_occupied[0]: 0
    out_count[0]: 0U
    if: f = 0 || f\arena = 0 || f\context = 0
        return: c.LMX_WALK_INVALID
    context: (cast: (@: c.LmxWalkContext) f\context)
    scratch: (cast: (@: c.LmxScratch) context\scratch)
    if: scratch = 0
        return: c.LMX_WALK_INVALID
    if: c.lmx_callable_source_count((cast: (@: c.LmxArena) f\arena), selected_args, @ count) != 0
        return: c.LMX_WALK_UNSUPPORTED
    if: written_count > transport_count
        return: c.LMX_WALK_INVALID
    if: transport_count != 0U
        if: written_values = 0
            return: c.LMX_WALK_INVALID
        if: current = 0 || current\map = 0
            return: c.LMX_WALK_UNSUPPORTED
        if: first > current\n || transport_count > current\n - first
            return: c.LMX_WALK_INVALID
    ---
    if: count > (cast: (size_t) -1) / c.sizeof(c.LmxWalkValue) || count > (cast: (size_t) -1) / c.sizeof(c.int)
        return: c.LMX_WALK_NOMEM
    if: count != 0U
        scratch_status: c.lmx_scratch_take(scratch, count * c.sizeof(c.LmxWalkValue), @ room)
        if: scratch_status != c.LMX_SCRATCH_OK
            if: scratch_status = c.LMX_SCRATCH_NOMEM
                return: c.LMX_WALK_NOMEM
            return: c.LMX_WALK_INVALID
        ---
        values: (cast: (@: c.LmxWalkValue) room)
        c.memset(room, 0, count * c.sizeof(c.LmxWalkValue))
        scratch_status: c.lmx_scratch_take(scratch, count * c.sizeof(c.int), @ room)
        if: scratch_status != c.LMX_SCRATCH_OK
            if: scratch_status = c.LMX_SCRATCH_NOMEM
                return: c.LMX_WALK_NOMEM
            return: c.LMX_WALK_INVALID
        ---
        occupied: (cast: (@: int) room)
        c.memset(room, 0, count * c.sizeof(c.int))
    ---
    while: i < transport_count
        status: c.lmx_callable_bound_operand((cast: (@: c.LmxArena) f\arena), selected_args, written_call, current, source_indices, source_capacity, first + i, @ source_index, @ physical, @ answer)
        if: status != c.LMX_WALK_OK
            return: status
        if: answer = c.LMX_IMPLEMENTS_UNKNOWN
            return: c.LMX_WALK_UNSUPPORTED
        if: answer != c.LMX_IMPLEMENTS_YES || source_index >= count || physical = (cast: (size_t) -1)
            return: c.LMX_WALK_INVALID
        if: occupied[source_index] != 0
            return: c.LMX_WALK_INVALID
        occupied[source_index]: 1
        if: i >= written_count
            occupied[source_index]: 2
        c.memcpy((cast: (@: void) (values + source_index)), (cast: (@: void) (written_values + i)), c.sizeof(c.LmxWalkValue))
        i: i + 1U
    ---
    out_values[0]: values
    out_occupied[0]: occupied
    out_count[0]: count
    return: c.LMX_WALK_OK
end: lmx_walk_scatter_written

# Only the existing physical native transport check of an already evaluated
# value. It evaluates no operand, converts no numeric value and grants no
# interface admission. A selected-call materializer can use this same check
# after common reception, without re-evaluating its written payload.
fn: lmx_walk_argument_storage (@: arena c.LmxArena; @: received c.LmxWalkValue; @: witness void; @: child void; @: receiver c.Lmx) int
    @: pointee void 0
    int: ty
    if: arena = 0 || received = 0
        return: c.LMX_WALK_INVALID
    if: received\present = 0
        return: c.LMX_WALK_OK
    ty: lmx_walk_witness_type(arena, witness)
    # A typed graph-reference witness retains its permitted address category.
    # Reading its referent here is not following the actual pointer twice.
    if: ty >= c.LMX_TYPE_POINTER_BASE && c.lmx_range_classify(arena, witness) = c.LMX_KIND_PRIMITIVE
        if: c.lmx_pointer_pool_in(arena, witness) = 0
            return: c.LMX_WALK_INVALID
        pointee: c.lmx_pointer_value_in(arena, witness)
    ---
    if: pointee != 0 && c.lmx_range_classify(arena, pointee) = c.LMX_KIND_STRUCT && received\kind = c.LMX_WALK_VALUE_REFERENCE
        if: received\type = c.LMX_TYPE_LMX && (received\ref = 0 || c.lmx_range_classify(arena, (cast: (@: void) received\ref)) = c.LMX_KIND_STRUCT)
            received\type: ty
        ---
        if: received\type = ty && received\ref != 0 && c.lmx_range_classify(arena, (cast: (@: void) received\ref)) != c.LMX_KIND_STRUCT
            return: c.LMX_WALK_INVALID
        ---
    ---
    # Preserve the existing one-level Structure reclassification. A null
    # actual has no address category to inspect: only the ordinary receiving
    # edge or selected entry reception supplies that fact.
    if: ty = c.LMX_TYPE_LMX && received\kind = c.LMX_WALK_VALUE_REFERENCE && received\type >= c.LMX_TYPE_POINTER_BASE
        if: received\ref != 0 && c.lmx_range_classify(arena, (cast: (@: void) received\ref)) = c.LMX_KIND_STRUCT
            received\type: ty
        if: received\ref = 0 && child != 0 && (lmx_walk_shape_op(arena, child) = c.LMX_WALK_OP_ADMIT_AS || receiver != 0)
            received\type: ty
        ---
    ---
    if: c.lmx_type_base(ty) >= c.LMX_TYPE_POINTER_BASE || c.lmx_type_base(ty) = c.LMX_TYPE_LMX || c.lmx_type_base(ty) = c.LMX_TYPE_DESC || c.lmx_type_base(ty) = c.LMX_TYPE_CHAR_PTR
        if: received\kind != c.LMX_WALK_VALUE_REFERENCE || received\type != ty
            return: c.LMX_WALK_INVALID
        ---
    else:
        if: received\kind != c.LMX_WALK_VALUE_NUMBER || received\type != ty
            return: c.LMX_WALK_INVALID
        ---
    ---
    return: c.LMX_WALK_OK
end: lmx_walk_argument_storage

fn: lmx_walk_actuals_values (@: f c.LmxWalkFrame; @: code c.Lmx; size_t: first; size_t: n; @: contract c.Lmx; @: receiver c.Lmx; @: order size_t; @@@: refs_out void; @@: values_out c.LmxWalkValue) int
    @: room void 0
    @: child void 0
    @: entry c.Lmx 0
    @: entry_fields c.VoidArray 0
    @: values c.LmxWalkValue 0
    @: received c.LmxWalkValue 0
    @: witness void 0
    @: header_source void 0
    @@: refs void 0
    size_t: i 0U
    size_t: slot 0U
    size_t: at 0U
    size_t: contract_count 0U
    int: status c.LMX_WALK_OK
    @: contract_fields c.VoidArray 0
    @: code_fields c.VoidArray 0
    @: named c.Lmx 0
    @: context c.LmxWalkContext 0
    @: scratch c.LmxScratch 0
    @: pointer_probe void 0
    if: refs_out = 0
        return: c.LMX_WALK_INVALID
    \refs_out: 0
    if: values_out != 0
        \values_out: 0
    if: f = 0
        return: c.LMX_WALK_INVALID
    if: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), (cast: (@: void) contract)) = 0
        return: c.LMX_WALK_INVALID
    contract_fields: @ contract\array
    contract_count: contract_fields\size
    # A callable receives SOURCE positions. A PRIM record deliberately uses
    # its physical C signature and enters with receiver=0.
    if: receiver != 0
        if: c.lmx_callable_source_count((cast: (@: c.LmxArena) f\arena), contract, @ contract_count) != 0
            return: c.LMX_WALK_INVALID
        ---
    ---
    if: contract_count != n
        return: c.LMX_WALK_INVALID
    if: n = 0U
        return: c.LMX_WALK_OK
    if: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), (cast: (@: void) code)) = 0
        return: c.LMX_WALK_INVALID
    code_fields: @ code\array
    if: first > code_fields\size || n > code_fields\size - first
        return: c.LMX_WALK_INVALID
    if: n > (cast: (size_t) -1) / c.sizeof(c.LmxWalkValue) || n > (cast: (size_t) -1) / sizeof(pointer_probe)
        return: c.LMX_WALK_INVALID
    context: (cast: (@: c.LmxWalkContext) f\context)
    scratch: (cast: (@: c.LmxScratch) context\scratch)
    if: c.lmx_scratch_take(scratch, n * c.sizeof(c.LmxWalkValue), @ room) != c.LMX_SCRATCH_OK
        return: c.LMX_WALK_NOMEM
    values: (cast: (@: c.LmxWalkValue) room)
    c.memset(room, 0, n * c.sizeof(c.LmxWalkValue))
    if: c.lmx_scratch_take(scratch, n * sizeof(pointer_probe), @ room) != c.LMX_SCRATCH_OK
        return: c.LMX_WALK_NOMEM
    refs: (cast: (@@: void) room)
    c.memset(room, 0, n * sizeof(pointer_probe))
    # Operands are evaluated in the order they stand, or, when `order` names
    # one, in the written order of the source body they borrow from
    # (lmx_walk_prim_source_order): a slot's position is its ABI place, not
    # its place in the written statement. A NAMED operand hands its
    # payload's value to the formal whose coordinate it carries; any other one
    # to the formal of its own position. No coordinate is supplied twice: an
    # empty operand supplies its coordinate too, so the test is the mark left
    # in the references and not the presence of a value.
    while: i < n && status = c.LMX_WALK_OK
        slot: i
        if: order != 0
            slot: order[i]
        if: slot >= n
            return: c.LMX_WALK_INVALID
        child: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, first + slot)
        status: lmx_walk_actual_shape((cast: (@: c.LmxArena) f\arena), child, slot, n, n, @ at, @ child, @ named)
        if: status != c.LMX_WALK_OK
            return: status
        if: at = (cast: (size_t) -1)
            return: c.LMX_WALK_UNSUPPORTED
        if: status = c.LMX_WALK_OK && refs[at] != 0
            status: c.LMX_WALK_INVALID
        refs[at]: (cast: (@: void) (values + at))
        if: status = c.LMX_WALK_OK && child != 0
            if: lmx_walk_op(f, child) = c.LMX_WALK_OP_NONE
                status: lmx_walk_value_cell((cast: (@: c.LmxArena) f\arena), child, values + at)
            else:
                if: receiver != 0 && lmx_walk_op(f, child) = c.LMX_WALK_OP_ADMIT_AS && lmx_walk_bare(f, child) = 0 && lmx_walk_source_of(f, (cast: (@: c.Lmx) child)) = c.LMX_WALK_SOURCE_RECEIVING
                    status: lmx_walk_admit_in(f, receiver, (cast: (@: c.Lmx) child), values + at)
                else:
                    status: c.lmx_walk_eval(f, child, values + at)
                ---
            ---
        ---
        received: values + at
        # Slice 258 (design 4.5 B1 fix): a hidden input the caller does not form -- no written child (the call site puts none
        # for a free input, lm_compiler_rw_call_arguments), absent, the contract's header entry of two fields (a written formal
        # has four) -- travels marked LMX_WALK_VALUE_FREE: the callee resolves it at its entry from the chain of activations
        # (lmx_walk_entry_resolve), as the signature path marks it (lmx_walk_selected_ready_values).  This path serves a
        # plain-role callable (a `sub`): before, its free input stayed an ordinary absent one and the entry's snapshot read the
        # lexical source whatever the caller bound.
        if: status = c.LMX_WALK_OK && child = 0 && received\present = 0
            entry: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), contract, at))
            if: entry != 0
                entry_fields: @ entry\array
                if: entry_fields\size = 2U || entry_fields\size = 3U
                    received\kind: c.LMX_WALK_VALUE_FREE
                ---
            ---
        ---
        if: status = c.LMX_WALK_OK && received\present != 0
            if: receiver != 0
                if: c.lmx_callable_source_entry((cast: (@: c.LmxArena) f\arena), contract, at, @ header_source, @ witness) != 0
                    return: c.LMX_WALK_INVALID
                ---
            else:
                if: c.lmx_callable_entry((cast: (@: c.LmxArena) f\arena), contract, at, @ header_source, @ witness) != 0
                    return: c.LMX_WALK_INVALID
                ---
                # The primitive's inputs have a physical contract. Admit a
                # present numeric argument before handing its storage to C.
                int: numeric lmx_walk_numeric_type((cast: (@: c.LmxArena) f\arena), witness)
                if: numeric != 0
                    status: lmx_walk_value_receive(received, numeric, received)
                    if: status != c.LMX_WALK_OK
                        return: status
                    ---
                ---
            ---
            status: lmx_walk_argument_storage((cast: (@: c.LmxArena) f\arena), received, witness, child, receiver)
            # A failed physical transport never returns a usable refs vector.
            # The caller still owns/rewinds the surrounding scratch mark.
            if: status != c.LMX_WALK_OK
                return: status
        ---
        i: i + 1U
    ---
    i: 0U
    while: i < n
        refs[i]: lmx_walk_value_storage(values + i)
        i: i + 1U
    ---
    \refs_out: refs
    if: status = c.LMX_WALK_OK && values_out != 0
        \values_out: values
    return: status
end: lmx_walk_actuals_values

fn: lmx_walk_actuals (@: f c.LmxWalkFrame; @: code c.Lmx; size_t: first; size_t: n; @: contract c.Lmx; @: receiver c.Lmx; @: order size_t; @@@: refs_out void) int
    return: lmx_walk_actuals_values(f, code, first, n, contract, receiver, order, refs_out, 0)
end: lmx_walk_actuals

fn: lmx_walk_exec_data (@: f c.LmxWalkFrame; @: callee c.Lmx; @: operand void; @@: out c.Lmx; @@: tokens char; @@: place_map size_t) int
    c.LmxWalkValue: value
    @: value_p c.LmxWalkValue @ value
    int: status
    \out: 0
    \tokens: 0
    \place_map: 0
    if: f = 0 || callee = 0 || operand = 0
        return: c.LMX_WALK_INVALID
    ---
    if: lmx_walk_kind(f, operand) = c.LMX_KIND_STRUCT && lmx_walk_op(f, operand) = c.LMX_WALK_OP_CALL_DATA && lmx_walk_bare(f, operand) = 0
        if: lmx_walk_table_cells(f, (cast: (@: c.Lmx) operand), 2U, tokens, place_map) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        ---
        operand: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), (cast: (@: c.Lmx) operand), 1U)
        if: operand = 0
            return: c.LMX_WALK_INVALID
        ---
    ---
    if: lmx_walk_kind(f, operand) = c.LMX_KIND_STRUCT && lmx_walk_op(f, operand) = c.LMX_WALK_OP_ADMIT_AS && lmx_walk_bare(f, operand) = 0 && lmx_walk_source_of(f, (cast: (@: c.Lmx) operand)) = c.LMX_WALK_SOURCE_RECEIVING
        status: lmx_walk_admit_in(f, callee, (cast: (@: c.Lmx) operand), @ value)
    else:
        status: c.lmx_walk_eval(f, operand, @ value)
    ---
    if: status != c.LMX_WALK_OK
        return: status
    ---
    if: value_p\present = 0 || value_p\kind != c.LMX_WALK_VALUE_REFERENCE
        return: c.LMX_WALK_INVALID
    ---
    if: value_p\ref = 0
        return: lmx_walk_fault(f)
    ---
    if: lmx_walk_kind(f, (cast: (@: void) value_p\ref)) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_INVALID
    ---
    \out: (cast: (@: c.Lmx) value_p\ref)
    return: c.LMX_WALK_OK
end: lmx_walk_exec_data

fn: lmx_walk_index (@: f c.LmxWalkFrame; @: operand void; @: out size_t) int
    c.LmxWalkValue: value
    c.LmxWalkValue: taken
    @: taken_p c.LmxWalkValue @ taken
    int: status c.lmx_walk_eval(f, operand, @ value)
    if: status != c.LMX_WALK_OK
        return: status
    # Slice 272: the one reception of a machine index, as native: another number or a reference is the implicit `convert`.
    status: lmx_walk_value_receive(@ value, c.LMX_TYPE_SIZE_T, taken_p)
    if: status != c.LMX_WALK_OK
        return: status
    \out: taken_p\wide
    return: c.LMX_WALK_OK
end: lmx_walk_index

fn: lmx_walk_throw (@: f c.LmxWalkFrame; @: code c.Lmx; @: out c.LmxWalkValue) int
    @: body c.Lmx 0
    @: named void 0
    @: actuals c.Lmx 0
    @: ordinal void 0
    @: room void 0
    @: values c.LmxWalkValue 0
    @: payload c.Lmx 0
    @: cell void 0
    @: child void 0
    size_t: n 0U
    size_t: i 0U
    size_t: k 0U
    size_t: number 0U
    int: ty 0
    int: status c.LMX_WALK_OK
    @: code_fields c.VoidArray 0
    @: body_fields c.VoidArray 0
    @: named_node c.Lmx 0
    @: named_fields c.VoidArray 0
    @: actuals_fields c.VoidArray 0
    @: item c.LmxWalkValue 0
    @: context c.LmxWalkContext 0
    @: scratch c.LmxScratch 0
    if: f = 0 || code = 0 || out = 0
        return: c.LMX_WALK_INVALID
    code_fields: @ code\array
    if: code_fields\size != 3U
        return: c.LMX_WALK_INVALID
    body: c.lmx_graph_ref_struct_in((cast: (@: c.LmxArena) f\arena), code, 1U)
    ordinal: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U)
    if: body = 0
        return: c.LMX_WALK_INVALID
    body_fields: @ body\array
    if: body_fields\size != 1U || c.lmx_type_base(lmx_walk_numeric_type((cast: (@: c.LmxArena) f\arena), ordinal)) != c.LMX_TYPE_SIZE_T
        return: c.LMX_WALK_INVALID
    k: c.lmx_size_value_known(ordinal)
    if: k = 0U || k > (cast: (size_t) c.INT_MAX) - (cast: (size_t) c.LMX_WALK_THROWN)
        return: c.LMX_WALK_INVALID
    named: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), body, 0U)
    if: lmx_walk_kind(f, named) != c.LMX_KIND_SOURCE_SYMBOL
        if: lmx_walk_op(f, named) != c.LMX_WALK_OP_SOURCE_INERT
            return: c.LMX_WALK_INVALID
        named_node: (cast: (@: c.Lmx) named)
        named_fields: @ named_node\array
        if: named_fields\size != 2U
            return: c.LMX_WALK_INVALID
        actuals: c.lmx_graph_ref_struct_in((cast: (@: c.LmxArena) f\arena), (cast: (@: c.Lmx) named), 1U)
        if: actuals = 0
            return: c.LMX_WALK_INVALID
        actuals_fields: @ actuals\array
        n: actuals_fields\size
    ---
    if: n > ((cast: (size_t) -1) / c.sizeof(c.LmxWalkValue))
        return: c.LMX_WALK_NOMEM
    if: n != 0U
        context: (cast: (@: c.LmxWalkContext) f\context)
        scratch: (cast: (@: c.LmxScratch) context\scratch)
        if: c.lmx_scratch_take(scratch, n * c.sizeof(c.LmxWalkValue), @ room) != c.LMX_SCRATCH_OK
            return: c.LMX_WALK_NOMEM
        values: (cast: (@: c.LmxWalkValue) room)
        c.memset(room, 0, n * c.sizeof(c.LmxWalkValue))
        while: i < n
            child: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), actuals, i)
            if: child = 0
                return: c.LMX_WALK_INVALID
            if: lmx_walk_op(f, child) = c.LMX_WALK_OP_NONE
                status: lmx_walk_value_cell((cast: (@: c.LmxArena) f\arena), child, values + i)
            else:
                status: c.lmx_walk_eval(f, child, values + i)
            ---
            if: status != c.LMX_WALK_OK
                return: status
            i: i + 1U
        ---
        payload: c.lmx_node_new_owned((cast: (@: c.LmxArena) f\arena))
        if: payload = 0 || c.lmx_arena_refs_open_owned((cast: (@: c.LmxArena) f\arena), payload, n) != 0
            return: c.LMX_WALK_NOMEM
        i: 0U
        while: i < n
            item: values + i
            cell: 0
            if: item\present = 0
                return: c.LMX_WALK_INVALID
            if: item\kind = c.LMX_WALK_VALUE_NUMBER
                ty: item\type
                if: lmx_walk_value_number(values + i, @ number, @ ty) != c.LMX_WALK_OK
                    return: c.LMX_WALK_INVALID
                cell: c.lmx_scalar_new_physical_profiled((cast: (@: c.LmxArena) f\arena), ty, 0)
                if: cell = 0
                    return: c.LMX_WALK_NOMEM
                if: lmx_walk_store_numeric_raw(cell, ty, number) != c.LMX_WALK_OK
                    return: c.LMX_WALK_INVALID
                ---
            else:
                if: item\kind != c.LMX_WALK_VALUE_REFERENCE || (item\ref != 0 && lmx_walk_kind(f, (cast: (@: void) item\ref)) != c.LMX_KIND_STRUCT)
                    return: c.LMX_WALK_INVALID
                cell: item\ref
            ---
            if: c.lmx_graph_ref_store_in((cast: (@: c.LmxArena) f\arena), payload, i, cell) != 0
                return: c.LMX_WALK_INVALID
            i: i + 1U
        ---
    ---
    f\payload: (cast: (@: void) payload)
    lmx_walk_value_ref(out, c.LMX_TYPE_LMX, (cast: (@: void) payload))
    return: c.LMX_WALK_THROWN + (cast: (int) k)
end: lmx_walk_throw

fn: lmx_walk_block_pad (@: arena c.LmxArena; @: body c.Lmx; size_t: key; @: exclude c.Lmx) @: c.Lmx
    @: child void 0
    @: child_node c.Lmx 0
    @: child_fields c.VoidArray 0
    @: body_fields c.VoidArray 0
    size_t: have 0U
    size_t: i 0U
    if: arena = 0 || body = 0 || key = 0U
        return: 0
    body_fields: @ body\array
    while: i < body_fields\size
        child: c.lmx_graph_value_in(arena, body, i)
        if: child != 0 && child != (cast: (@: void) exclude) && c.lmx_graph_node_in(arena, child) != 0 && lmx_walk_shape_op(arena, child) = c.LMX_WALK_OP_PAD
            child_node: (cast: (@: c.Lmx) child)
            child_fields: @ child_node\array
            if: child_fields\size >= 3U && lmx_walk_load_numeric(arena, c.lmx_graph_value_in(arena, child_node, 1U), @ have) = c.LMX_WALK_OK && have = key
                return: child_node
            ---
        ---
        i: i + 1U
    ---
    return: 0
end: lmx_walk_block_pad

fn: lmx_walk_pad_find (@: f c.LmxWalkFrame; @: body c.Lmx; size_t: key; @: exclude c.Lmx) @: c.Lmx
    if: f = 0
        return: 0
    return: lmx_walk_block_pad((cast: (@: c.LmxArena) f\arena), body, key, exclude)
end: lmx_walk_pad_find

# Each written throw of the selected callee must be declared by its caller
# or handled on the lexical block chain of this reached call. Handler
# bodies cannot catch themselves. Testing the contract executes no body.
fn: lmx_call_obligation (@: arena c.LmxArena; @: callee c.Lmx; @: caller c.Lmx; @: operation c.Lmx) int
    @: header c.Lmx lmx_walk_throws_node(arena, callee)
    if: header = 0
        return: c.LMX_WALK_OK
    @: fields c.VoidArray @ header\array
    size_t: i 1U
    while: i < fields\size
        size_t: key 0U
        if: lmx_walk_load_numeric(arena, c.lmx_graph_value_in(arena, header, i), @ key) != c.LMX_WALK_OK || key = 0U
            return: c.LMX_WALK_INVALID
        size_t: ordinal 0U
        if: lmx_walk_ordinal_from_key(arena, caller, key, @ ordinal) != c.LMX_WALK_OK
            @: cursor c.Lmx operation
            @: slow c.Lmx operation
            int: half 0
            int: found 0
            while: cursor != 0 && cursor != caller
                @: parent c.Lmx cursor\parent
                if: parent != 0 && lmx_walk_block_pad(arena, parent, key, cursor) != 0
                    found: 1
                    break
                cursor: parent
                if: half != 0 && slow != 0
                    slow: slow\parent
                half: 1 - half
                if: cursor != 0 && cursor = slow
                    return: c.LMX_WALK_INVALID
                ---
            ---
            if: found = 0
                return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_IMPLEMENTS
            ---
        ---
        i: i + 1U
    ---
    return: c.LMX_WALK_OK
end: lmx_call_obligation

fn: lmx_walk_body (@: f c.LmxWalkFrame; @: body c.Lmx; size_t: first) int
    @: child void 0
    c.LmxWalkValue: dropped
    @: dropped_p c.LmxWalkValue @ dropped
    @: pad c.Lmx 0
    @: exclude c.Lmx 0
    @: body_fields c.VoidArray 0
    @: landing c.Lmx 0
    @: result c.LmxWalkValue 0
    int: step_op
    int: status c.LMX_WALK_OK
    size_t: i first
    size_t: j 0U
    if: f = 0 || c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), (cast: (@: void) body)) = 0
        return: c.LMX_WALK_INVALID
    body_fields: @ body\array
    result: @ f\result
    while: status = c.LMX_WALK_OK && f\returned = 0 && i < body_fields\size
        if: c.lmx_msg_poll_escape() != 0
            return: c.LMX_WALK_STOPPED
        if: c.lmx_graph_cell_in((cast: (@: c.LmxArena) f\arena), body, i) = 0
            return: c.LMX_WALK_INVALID
        child: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), body, i)
        step_op: lmx_walk_op(f, child)
        # An entry reception ran at the activation's entry (lmx_walk_receive); the body does not run it again.
        if: step_op = c.LMX_WALK_OP_SET_ARG && c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), child) != 0 && lmx_walk_source_of(f, (cast: (@: c.Lmx) child)) = c.LMX_WALK_SOURCE_RECEPTION
            step_op: c.LMX_WALK_OP_NONE
        if: step_op != c.LMX_WALK_OP_NONE
            status: c.lmx_walk_eval(f, child, @ dropped)
            # Activation value = last evaluated expression. SET/PUT/IF/WHILE/FOR are
            # statements (void fall-off). LIT/arith/CALL/OWN/... count. RET sets valued itself.
            if: status = c.LMX_WALK_OK && dropped_p\present != 0 && step_op != c.LMX_WALK_OP_SET && step_op != c.LMX_WALK_OP_SET_OF && step_op != c.LMX_WALK_OP_SET_ARG && step_op != c.LMX_WALK_OP_PUT && step_op != c.LMX_WALK_OP_PUT_REF && step_op != c.LMX_WALK_OP_PUT_OF && step_op != c.LMX_WALK_OP_ELEMPUT && step_op != c.LMX_WALK_OP_IF && step_op != c.LMX_WALK_OP_WHILE && step_op != c.LMX_WALK_OP_FOR && step_op != c.LMX_WALK_OP_UNTIL && step_op != c.LMX_WALK_OP_PAD
                c.memcpy((cast: (@: void) result), (cast: (@: void) (@ dropped)), c.sizeof(c.LmxWalkValue))
            ---
        ---
        # A thrown status reaching this body: the pad of its key in this body takes
        # it (lmx_walk_pad_find), binds the payload and runs the handler
        # (lmx_walk_catch_bind), and the body goes on after that pad -- a handler
        # before the throwing step re-enters the region, one after it continues.
        # A throw from the handler may name another pad of this same body, never
        # the one that just ran; a key no pad here holds leaves for the enclosing
        # body, and from the activation's own body for the caller.
        exclude: 0
        while: status >= c.LMX_WALK_THROWN
            landing: (cast: (@: c.Lmx) f\landing)
            if: landing != 0 && (cast: (@: c.Lmx) landing\parent) != body
                break
            if: f\landing = 0
                f\landing: lmx_walk_block_pad((cast: (@: c.LmxArena) f\arena), body, (cast: (size_t) (status - c.LMX_WALK_THROWN)), exclude)
            if: f\landing = 0
                break
            pad: (cast: (@: c.Lmx) f\landing)
            exclude: pad
            status: lmx_walk_catch_bind(f)
            if: status = c.LMX_WALK_OK
                j: 0U
                while: j < body_fields\size && c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), body, j) != (cast: (@: void) pad)
                    j: j + 1U
                ---
                if: j >= body_fields\size
                    status: c.LMX_WALK_INVALID
                else:
                    i: j
                ---
            ---
        ---
        i: i + 1U
    ---
    return: status
end: lmx_walk_body

fn: lmx_walk_cell_copy (@: arena c.LmxArena; @: cell void) @: void
    @: fresh void 0
    int: ty
    size_t: number 0U
    if: arena = 0 || cell = 0
        return: cell
    ty: lmx_walk_numeric_type(arena, cell)
    if: ty = c.LMX_TYPE_NONE
        return: cell
    if: lmx_walk_load_numeric(arena, cell, @ number) != c.LMX_WALK_OK
        return: 0
    # An explicit storage copy preserves full physical identity. Its first
    # fill is not an ordinary mutation of the source or of published storage.
    fresh: c.lmx_scalar_new_physical_profiled(arena, ty, 0)
    if: fresh = 0 || lmx_walk_store_numeric_raw(fresh, ty, number) != c.LMX_WALK_OK
        return: 0
    return: fresh
end: lmx_walk_cell_copy

fn: lmx_walk_capture (@: arena c.LmxArena; @: parent c.Lmx; @: src c.Lmx; @: req c.Lmx; @: fields size_t; size_t: n; @: layout void) @: c.Lmx
    c.LmxImplEntry: view
    @: view_p c.LmxImplEntry @ view
    @: v c.LmxImplEntry 0
    @: copy c.Lmx 0
    size_t: i 0U
    size_t: j
    @: cell void
    @: fresh void
    size_t: sj
    int: status
    int: answer
    @: own c.LmxImplEntry 0
    @: req_fields c.VoidArray 0
    @: src_fields c.VoidArray 0
    if: arena = 0 || parent = 0 || src = 0 || req = 0 || fields = 0
        return: 0
    # D-105 native x item 738 (steps/d105-native.md): a source admitted to req by name -- a formal that a
    # value of another type reached -- holds req's field j at the slot its record gives, not at j.
    req_fields: @ req\array
    src_fields: @ src\array
    own: c.lmx_implements_find(arena, src, req)
    copy: c.lmx_struct_new_owned(parent, arena)
    if: copy = 0
        return: 0
    if: (req_fields\size) != 0U && c.lmx_arena_refs_open_owned(arena, copy, (req_fields\size)) != 0
        return: 0
    while: i < n
        j: fields[i]
        if: j >= req_fields\size
            return: 0
        sj: j
        # Identical physical source/requirement is explicit identity. Every
        # other source needs an installed numeric correspondence.
        if: own != 0 || src != req
            sj: (cast: (size_t) -1)
            status: c.lmx_implements_slot(arena, src, req, j, @ sj, @ answer)
            if: status != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
                return: 0
            ---
        ---
        if: sj >= src_fields\size
            return: 0
        cell: c.lmx_graph_value_in(arena, src, sj)
        if: cell = 0 || c.lmx_range_classify(arena, cell) != c.LMX_KIND_PRIMITIVE
            return: 0
        fresh: lmx_walk_cell_copy(arena, cell)
        if: fresh = 0 || fresh = cell
            return: 0
        if: c.lmx_graph_ref_store_in(arena, copy, j, fresh) != 0
            return: 0
        i: i + 1U
    ---
    v: @ view
    c.memset((cast: (@: void) v), 0, c.sizeof(c.LmxImplEntry))
    v\holes: 1
    v\layout: layout
    status: c.lmx_implements_register(arena, copy, req, v, @ answer)
    if: status != c.LMX_WALK_OK || answer = c.LMX_IMPLEMENTS_NO
        return: 0
    return: copy
end: lmx_walk_capture

# Existing native-word access, construction and exact immutable-context guards.

fn: lmx_walk_callable_addr (@: arena c.LmxArena; @: operand c.Lmx) c.LmxEntry
    if: operand = 0
        return: (cast: (c.LmxEntry) 0)
    return: (cast: (c.LmxEntry) operand\native)
end: lmx_walk_callable_addr

fn: lmx_walk_frame (@: arena c.LmxArena; @: parent c.Lmx; int: code; size_t: children) @: c.Lmx
    return: lmx_walk_frame_profiled(arena, parent, code, children, 0)
end: lmx_walk_frame

fn: lmx_walk_role_cell (@: arena c.LmxArena; int: code; @: held_profile c.Lmx) @: void
    if: arena = 0 || code <= c.LMX_WALK_OP_NONE || code >= c.LMX_WALK_OP_COUNT * c.LMX_WALK_SOURCE_COUNT
        return: 0
    return: (cast: (@: void) c.lmx_op_new_profiled(arena, code, held_profile))
end: lmx_walk_role_cell

fn: lmx_walk_frame_profiled (@: arena c.LmxArena; @: parent c.Lmx; int: code; size_t: children; @: held_profile c.Lmx) @: c.Lmx
    @: s c.Lmx 0
    @: role void 0
    if: code <= c.LMX_WALK_OP_NONE || code >= c.LMX_WALK_OP_COUNT || children = 0U
        return: 0
    role: lmx_walk_role_cell(arena, code, held_profile)
    s: lmx_walk_plain_profiled(arena, parent, children, held_profile)
    if: s = 0 || role = 0
        return: 0
    if: c.lmx_graph_ref_store_in(arena, s, 0U, role) != 0
        return: 0
    return: s
end: lmx_walk_frame_profiled

fn: lmx_walk_immutable (@: f c.LmxWalkFrame; @: p void) int
    @: context c.LmxWalkContext 0
    int: blocked 0
    if: p = 0
        return: 0
    context: (cast: (@: c.LmxWalkContext) f\context)
    blocked: c.lmx_range_write_exact_blocked((cast: (@: c.LmxArena) f\arena), p, context\immutable_profile, context\immutable_roots, context\immutable_root_count)
    if: blocked != 0 || context\immutable_profile != 0 || context\immutable_root_count != 0U
        context\classified: context\classified + 1U
    return: blocked
end: lmx_walk_immutable

# Calls select the actual native word only after actuals/publication/admission.

# Select this call's actual code/data through the ordinary selection path.
# A deferred receiving edge uses the same path BEFORE evaluating its raw
# actual. Only graph occurrences are retained, never an early native word.
fn: lmx_walk_select_call (@: f c.LmxWalkFrame; @: code c.Lmx; int: op; size_t: arg_at; @: raw_selector void; @: raw_data void; @: raw_contract void; @@: out_callee c.Lmx; @@: out_data c.Lmx; @@: out_contract c.Lmx; @@: out_tokens char; @@: out_place_map size_t) int
    c.LmxWalkValue: selected
    @: selected_p c.LmxWalkValue @ selected
    @: callee c.Lmx 0
    @: data c.Lmx 0
    @: contract c.Lmx 0
    @: tokens char 0
    @: place_map size_t 0
    @: eval_operand void 0
    @: callee_fields c.VoidArray 0
    @: context c.LmxWalkContext 0
    int: split_call 0
    int: status c.LMX_WALK_OK
    if: out_callee = 0 || out_data = 0 || out_contract = 0 || out_tokens = 0 || out_place_map = 0
        return: c.LMX_WALK_INVALID
    out_callee[0]: 0
    out_data[0]: 0
    out_contract[0]: 0
    out_tokens[0]: 0
    out_place_map[0]: 0
    if: f = 0
        return: c.LMX_WALK_INVALID
    split_call: (cast: (int) (op = c.LMX_WALK_OP_EXEC))
    if: arg_at = 2U
        callee: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), raw_selector)
        # A short direct call is the unary form: its data is the callee's
        # own var part when the callee is a four-part fn occurrence.
        context: (cast: (@: c.LmxWalkContext) f\context)
        data: lmx_call_unary_data((cast: (@: c.LmxArena) context\arena), callee)
        if: callee = 0
            return: c.LMX_WALK_INVALID
        callee_fields: @ callee\array
        if: callee_fields\size = 0U
            return: c.LMX_WALK_INVALID
        contract: callee
    else:
        # An old call stores its contract at slot 3 and evaluates its data at slot 2.
        # A long direct call uses the callee's own input/result parts.
        contract: (cast: (@: c.Lmx) raw_contract)
        eval_operand: raw_data
        if: split_call != 0
            eval_operand: raw_selector
        if: eval_operand != 0
            status: c.lmx_walk_eval(f, eval_operand, @ selected)
            if: status = c.LMX_WALK_OK
                if: selected_p\present = 0 || selected_p\kind != c.LMX_WALK_VALUE_REFERENCE
                    status: c.LMX_WALK_INVALID
                else:
                    if: selected_p\ref = 0
                        status: lmx_walk_fault(f)
                    else:
                        if: lmx_walk_kind(f, (cast: (@: void) selected_p\ref)) != c.LMX_KIND_STRUCT
                            status: c.LMX_WALK_INVALID
                        ---
                    ---
                ---
                if: status = c.LMX_WALK_OK
                    data: (cast: (@: c.Lmx) selected_p\ref)
                    callee: data
                    if: split_call = 0
                        callee: c.lmx_graph_ref_struct_in((cast: (@: c.LmxArena) f\arena), code, 1U)
                    ---
                    if: callee = 0
                        status: c.LMX_WALK_INVALID
                    ---
                ---
                # N4: `call: code data` passes its data at slot 1, evaluated after the code; an empty slot 1 keeps the
                # code itself as its data (`call: code` today).
                if: status = c.LMX_WALK_OK && split_call != 0 && c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U) != 0
                    status: lmx_walk_exec_data(f, callee, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U), @ data, @ tokens, @ place_map)
                ---
                # An empty EXEC data slot is the unary form: the callee's own
                # var part is its data, not the callee itself.
                if: status = c.LMX_WALK_OK && split_call != 0 && c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U) = 0
                    context: (cast: (@: c.LmxWalkContext) f\context)
                    data: lmx_call_unary_data((cast: (@: c.LmxArena) context\arena), callee)
                ---
            ---
        else:
            # A long EXEC frame needs its explicit data slot; this branch is
            # the CALL form.
            if: split_call != 0
                status: c.LMX_WALK_INVALID
            else:
                # An empty CALL data slot is the unary form: the callee's own
                # var part is its data, not the callee itself.
                callee: c.lmx_graph_ref_struct_in((cast: (@: c.LmxArena) f\arena), code, 1U)
                context: (cast: (@: c.LmxWalkContext) f\context)
                data: lmx_call_unary_data((cast: (@: c.LmxArena) context\arena), callee)
                if: callee != 0
                    callee_fields: @ callee\array
                ---
                if: callee = 0 || callee_fields\size = 0U
                    status: c.LMX_WALK_INVALID
                else:
                    if: contract = 0
                        contract: callee
                    ---
                ---
            ---
        ---
    ---
    if: status != c.LMX_WALK_OK
        return: status
    out_callee[0]: callee
    out_data[0]: data
    out_contract[0]: contract
    out_tokens[0]: tokens
    out_place_map[0]: place_map
    return: c.LMX_WALK_OK
end: lmx_walk_select_call

# The synchronous values dispatch shared by ordinary calls and a captured
# receiver after its values have been materialized. Its caller owns the
# published/admitted data and exact selected ABI cells. Receiving remains
# the selected entry's responsibility; no operand or selector executes here.
fn: lmx_walk_dispatch_values (@: f c.LmxWalkFrame; @: code c.Lmx; @: callee c.Lmx; @: data c.Lmx; @@: refs void; size_t: n; @: values c.LmxWalkValue; @: rtype void; int: split_call; @: out c.LmxWalkValue) int
    c.LmxWalkValue: temp
    c.LmxWalkValue: result_context
    c.LmxActivation: act
    @: raw void 0
    @: dest void 0
    @: context c.LmxWalkContext 0
    size_t: key 0U
    int: said 0
    int: status c.LMX_WALK_OK
    if: f = 0 || out = 0
        return: c.LMX_WALK_INVALID
    context: (cast: (@: c.LmxWalkContext) f\context)
    # Actuals and publication may mutate the selected code or its native
    # word. Select dispatch at the boundary, after those effects, not from
    # a value cached while resolving the callee.
    c.LmxEntry: addr (cast: (c.LmxEntry) c.lmx_walk_callable_addr((cast: (@: c.LmxArena) f\arena), callee))
    if: addr != 0
        c.LmxPrimitiveEntry: entry (cast: (c.LmxPrimitiveEntry) addr)
        dest: lmx_walk_result_dest((cast: (@: c.LmxArena) f\arena), rtype, @ temp)
        lmx_walk_value_clear(@ result_context)
        # Slice 254: the native activation's record, child of this frame's.
        c.lmx_activation_push((cast: (@: c.LmxArena) f\arena), @ act, 2, callee, refs, (cast: (@: void) values), n, 0)
        said: entry((cast: (@: void) data), refs, n, dest, @ raw, (cast: (@: c.LmxArena) f\arena), callee, values, @ result_context)
        c.lmx_activation_pop((cast: (@: c.LmxArena) f\arena), @ act)
        if: c.lmx_msg_poll_escape() != 0
            status: c.LMX_WALK_STOPPED
        else:
            if: said != 0
                # The native callee said its own ordinal: the key of the name it
                # means, through its retained THROWS header (lmx_walk.h, THROWN).
                if: lmx_walk_key_from_ordinal((cast: (@: c.LmxArena) f\arena), callee, (cast: (size_t) said), @ key) != c.LMX_WALK_OK
                    status: c.LMX_WALK_INVALID
                else:
                    status: c.LMX_WALK_THROWN + (cast: (int) key)
                    lmx_walk_value_ref(out, c.LMX_TYPE_LMX, raw)
                ---
            else:
                # A selected ordinary callable returns its actual full Value.
                # Absence is distinct from a returned zero/null; do not decode
                # either from a receiving descriptor or a raw placeholder.
                c.memcpy((cast: (@: void) out), (cast: (const: @: void) (@ result_context)), c.sizeof(c.LmxWalkValue))
        ---
    else:
        # N4 (SF14): explicit data enters a split activation; its entry takes the mark (lmx_walk_frame_open).
        if: split_call != 0 && c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U) != 0
            context\split_entry: 1
        status: lmx_walk_activate_values(context, callee, data, refs, n, values, out)
        context\split_entry: 0
    ---
    return: status
end: lmx_walk_dispatch_values

# Capture an ALREADY selected implicit receiving edge before its raw actual
# has effects. This does not choose an old Consumer's converter for a new
# formal: the caller must first select the genuine receiving descriptor.
# The raw operand is retained, not evaluated. Later value-only execution uses
# these code/data facts; running full walk_call would repeat selector effects.
# This runtime helper evaluates selector/data. Its caller marks scratch BEFORE
# capture and retains these facts/name/borrows until its final rewind.
fn: lmx_walk_capture_receiving (@: f c.LmxWalkFrame; @: operation c.Lmx; @: out c.LmxWalkReceiving) int
    @: arena c.LmxArena 0
    @: context c.LmxWalkContext 0
    @: scratch c.LmxScratch 0
    @: raw_selector void 0
    @: raw_data void 0
    @: raw_contract void 0
    @: callee c.Lmx 0
    @: data c.Lmx 0
    @: contract c.Lmx 0
    @: tokens char 0
    @: places size_t 0
    @: operand void 0
    @: named c.Lmx 0
    @: name c.VoidArray 0
    @: captured c.VoidArray 0
    size_t: first 0U
    @: operation_fields c.VoidArray 0
    size_t: transport_count 0U
    size_t: written_count 0U
    size_t: coordinate 0U
    int: op 0
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    if: out = 0
        return: c.LMX_WALK_INVALID
    c.memset((cast: (@: void) out), 0, c.sizeof(c.LmxWalkReceiving))
    if: f = 0 || f\arena = 0 || f\context = 0
        return: c.LMX_WALK_INVALID
    arena: (cast: (@: c.LmxArena) f\arena)
    context: (cast: (@: c.LmxWalkContext) f\context)
    scratch: (cast: (@: c.LmxScratch) context\scratch)
    if: scratch = 0
        return: c.LMX_WALK_INVALID
    if: operation = 0 || c.lmx_graph_node_in(arena, (cast: (@: void) operation)) != operation
        return: c.LMX_WALK_UNSUPPORTED
    if: lmx_walk_op(f, (cast: (@: void) operation)) != c.LMX_WALK_OP_EXEC || lmx_walk_source_of(f, operation) != c.LMX_WALK_SOURCE_RECEIVING
        return: c.LMX_WALK_UNSUPPORTED
    status: lmx_walk_call_shape(arena, operation, @ op, @ first, @ transport_count, @ raw_selector, @ raw_data, @ raw_contract)
    if: status != c.LMX_WALK_OK
        return: status
    status: c.lmx_callable_written_count(arena, operation, op, first, transport_count, @ written_count, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    if: answer != c.LMX_IMPLEMENTS_YES || written_count != 1U
        return: c.LMX_WALK_UNSUPPORTED
    status: lmx_walk_select_call(f, operation, op, first, raw_selector, raw_data, raw_contract, @ callee, @ data, @ contract, @ tokens, @ places)
    if: status != c.LMX_WALK_OK
        return: status
    if: c.lmx_graph_node_in(arena, (cast: (@: void) operation)) = 0
        return: c.LMX_WALK_INVALID
    operation_fields: @ operation\array
    if: first > operation_fields\size || transport_count > operation_fields\size - first
        return: c.LMX_WALK_INVALID
    # Read this operand after selector/data effects, as an ordinary call does.
    # Capture its head/name before any subsequent raw operand effects.
    operand: c.lmx_graph_value_in(arena, operation, first)
    status: lmx_walk_actual_shape(arena, operand, 0U, transport_count, (cast: (size_t) -1), @ coordinate, @ operand, @ named)
    if: status != c.LMX_WALK_OK
        return: status
    if: named != 0
        name: (cast: (@: c.VoidArray) c.lmx_source_name_get(arena, (cast: (@: void) named)))
        status: lmx_walk_capture_actual_name(scratch, name, @ captured)
        if: status != c.LMX_WALK_OK
            return: status
    ---
    out\operation: operation
    out\callee: callee
    out\data: data
    out\contract: contract
    out\tokens: tokens
    out\places: places
    out\operand: operand
    out\first: first
    out\transport_count: transport_count
    out\named: (cast: (int) (named != 0))
    out\name: captured
    return: c.LMX_WALK_OK
end: lmx_walk_capture_receiving

# Read only CURRENT args DATA. The formal SOURCE describes an interface;
# neither it nor a saved initializer is evaluated to obtain a default.
fn: lmx_walk_current_default (@: arena c.LmxArena; @: inputs c.Lmx; size_t: index; @: out c.LmxWalkValue) int
    @: entry c.Lmx 0
    @: fields c.VoidArray 0
    @: cell void 0
    size_t: physical (cast: (size_t) -1)
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    if: arena = 0 || inputs = 0 || out = 0
        return: c.LMX_WALK_INVALID
    lmx_walk_value_clear(out)
    status: c.lmx_implements_exec_slot(arena, inputs, index, @ physical, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    if: answer != c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_UNSUPPORTED
    entry: c.lmx_graph_node_in(arena, c.lmx_graph_value_in(arena, inputs, physical))
    if: entry = 0
        return: c.LMX_WALK_UNSUPPORTED
    fields: @ entry\array
    if: fields\size != 4U
        return: c.LMX_WALK_OK
    cell: c.lmx_graph_value_in(arena, entry, 2U)
    if: cell = 0
        return: c.LMX_WALK_OK
    return: lmx_walk_value_cell(arena, cell, out)
end: lmx_walk_current_default

# Prepare the actual invocation's captured heads and already evaluated values
# with the SAME binder as Source admission. Its correspondence lives only
# under the caller's scratch mark; selected-entry reception remains single.
# Consume ready written Values synchronously. This worker shares the admission
# binder and current-default path; it never evaluates, selects or publishes.
# The caller owns all buffers and the surrounding scratch mark.
# contract_inputs are the Consumer contract's inputs: the only identity of
# the normalized suffix the EXEC carries after its written prefix.
fn: lmx_walk_selected_ready_values (@: f c.LmxWalkFrame; @: code c.Lmx; @: callee c.Lmx; size_t: first; size_t: transport_count; size_t: written_count; @: contract_inputs c.Lmx; @: actual_named int; @@: actual_names c.VoidArray; size_t: width; @: map size_t; @: sources size_t; @: written c.LmxWalkValue; @@@: refs_out void; @@: values_out c.LmxWalkValue; @: out_count size_t) int
    c.LmxImplEntry: binding
    @: binding_p c.LmxImplEntry @ binding
    @: inputs c.Lmx 0
    @: context c.LmxWalkContext 0
    @: scratch c.LmxScratch 0
    @: room void 0
    @: pointer_probe void 0
    @: values c.LmxWalkValue 0
    @: received c.LmxWalkValue 0
    @: occupied int 0
    @@: refs void 0
    @: source void 0
    @: witness void 0
    size_t: count 0U
    size_t: i 0U
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    int: scratch_status
    if: f = 0 || f\context = 0 || refs_out = 0 || values_out = 0 || out_count = 0
        return: c.LMX_WALK_INVALID
    context: (cast: (@: c.LmxWalkContext) f\context)
    scratch: (cast: (@: c.LmxScratch) context\scratch)
    if: scratch = 0
        return: c.LMX_WALK_INVALID
    # Operand effects can replace a part. Bind the selected callable's
    # current args, not a descriptor or a header cached before those effects.
    size_t: args_at (cast: (size_t) -1)
    size_t: header_count 0U
    if: c.lmx_callable_source_count((cast: (@: c.LmxArena) f\arena), callee, @ header_count) != 0 || header_count < 2U
        return: c.LMX_WALK_UNSUPPORTED
    status: c.lmx_implements_exec_slot((cast: (@: c.LmxArena) f\arena), callee, 0U, @ args_at, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    if: answer != c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_UNSUPPORTED
    inputs: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), callee, args_at))
    if: inputs = 0
        return: c.LMX_WALK_UNSUPPORTED
    status: c.lmx_callable_bind_written((cast: (@: c.LmxArena) f\arena), inputs, code, first, transport_count, written_count, contract_inputs, actual_named, actual_names, width, map, width * 2U, sources, width, binding_p, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    if: answer = c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_INVALID
    # An overall U is not a semantic rejection. Scatter requests only each
    # actual operand's established forward SOURCE/physical correspondence.
    status: lmx_walk_scatter_written(f, inputs, code, first, transport_count, written_count, binding_p, sources, width, written, @ values, @ occupied, @ count)
    if: status != c.LMX_WALK_OK
        return: status
    if: count > (cast: (size_t) -1) / sizeof(pointer_probe)
        return: c.LMX_WALK_NOMEM
    if: count != 0U
        scratch_status: c.lmx_scratch_take(scratch, count * sizeof(pointer_probe), @ room)
        if: scratch_status != c.LMX_SCRATCH_OK
            if: scratch_status = c.LMX_SCRATCH_NOMEM
                return: c.LMX_WALK_NOMEM
            return: c.LMX_WALK_INVALID
        ---
        refs: (cast: (@@: void) room)
        c.memset(room, 0, count * sizeof(pointer_probe))
    ---
    while: i < count
        if: occupied[i] = 0
            status: lmx_walk_current_default((cast: (@: c.LmxArena) f\arena), inputs, i, values + i)
            if: status != c.LMX_WALK_OK
                return: status
        ---
        if: c.lmx_callable_source_entry((cast: (@: c.LmxArena) f\arena), inputs, i, @ source, @ witness) != 0
            return: c.LMX_WALK_UNSUPPORTED
        received: values + i
        # A hidden input handed absent travels as an absent full Value with no
        # storage (ref 0): the selected entry resolves it from its current
        # instance (semantics §9), never a zero/null forced here.
        if: received\present = 0 && occupied[i] = 2
            # Slice 254 (design 4.5): a free input of the callee; it resolves it at its entry from the chain.
            received\kind: c.LMX_WALK_VALUE_FREE
            i: i + 1U
            continue
        # The present scalar/reference transport cannot encode absence as
        # zero/null. This is unavailable execution storage, never a semantic
        # NO about the interface or permission to evaluate formal SOURCE.
        if: received\present = 0
            return: c.LMX_WALK_UNSUPPORTED
        # Entry reception is not a completed conversion proof here. In
        # particular a typed null must not lose reference depth merely
        # because there is a receiver waiting at the eventual entry.
        status: lmx_walk_argument_storage((cast: (@: c.LmxArena) f\arena), values + i, witness, 0, 0)
        if: status != c.LMX_WALK_OK
            return: status
        refs[i]: lmx_walk_value_storage(values + i)
        i: i + 1U
    ---
    refs_out[0]: refs
    values_out[0]: values
    out_count[0]: count
    return: c.LMX_WALK_OK
end: lmx_walk_selected_ready_values

fn: lmx_walk_selected_values (@: f c.LmxWalkFrame; @: code c.Lmx; @: callee c.Lmx; size_t: first; size_t: transport_count; int: op; @: contract_inputs c.Lmx; @@@: refs_out void; @@: values_out c.LmxWalkValue; @: out_count size_t) int
    @: context c.LmxWalkContext 0
    @: scratch c.LmxScratch 0
    @: fields c.VoidArray 0
    @: room void 0
    @: actual_named int 0
    @@: actual_names c.VoidArray 0
    @: map size_t 0
    @: sources size_t 0
    @: written c.LmxWalkValue 0
    @: pointer_probe void 0
    size_t: width 0U
    size_t: written_count 0U
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    int: scratch_status
    if: f = 0 || f\context = 0 || refs_out = 0 || values_out = 0 || out_count = 0
        return: c.LMX_WALK_INVALID
    refs_out[0]: 0
    values_out[0]: 0
    out_count[0]: 0U
    context: (cast: (@: c.LmxWalkContext) f\context)
    scratch: (cast: (@: c.LmxScratch) context\scratch)
    if: scratch = 0 || c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), (cast: (@: void) code)) = 0
        return: c.LMX_WALK_INVALID
    fields: @ code\array
    width: fields\size
    status: c.lmx_callable_written_count((cast: (@: c.LmxArena) f\arena), code, op, first, transport_count, @ written_count, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    if: answer != c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_UNSUPPORTED
    # Bound/hidden normalized suffix inputs still need their own current
    # data projection. Do not drop them and substitute a formal default:
    # each is evaluated and bound by its Consumer contract input, the only
    # identity it has. Without that contract the suffix cannot be bound.
    if: written_count != transport_count && contract_inputs = 0
        return: c.LMX_WALK_UNSUPPORTED
    if: width = 0U || width > ((cast: (size_t) -1) / c.sizeof(c.size_t)) / 2U || width > (cast: (size_t) -1) / c.sizeof(c.int) || width > (cast: (size_t) -1) / sizeof(pointer_probe)
        return: c.LMX_WALK_NOMEM
    scratch_status: c.lmx_scratch_take(scratch, width * c.sizeof(c.int), @ room)
    if: scratch_status != c.LMX_SCRATCH_OK
        if: scratch_status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    actual_named: (cast: (@: int) room)
    c.memset(room, 0, width * c.sizeof(c.int))
    scratch_status: c.lmx_scratch_take(scratch, width * sizeof(pointer_probe), @ room)
    if: scratch_status != c.LMX_SCRATCH_OK
        if: scratch_status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    actual_names: (cast: (@@: c.VoidArray) room)
    c.memset(room, 0, width * sizeof(pointer_probe))
    scratch_status: c.lmx_scratch_take(scratch, width * 2U * c.sizeof(c.size_t), @ room)
    if: scratch_status != c.LMX_SCRATCH_OK
        if: scratch_status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    map: (cast: (@: size_t) room)
    scratch_status: c.lmx_scratch_take(scratch, width * c.sizeof(c.size_t), @ room)
    if: scratch_status != c.LMX_SCRATCH_OK
        if: scratch_status = c.LMX_SCRATCH_NOMEM
            return: c.LMX_WALK_NOMEM
        return: c.LMX_WALK_INVALID
    sources: (cast: (@: size_t) room)
    status: lmx_walk_written_values(f, code, first, transport_count, written_count, actual_named, actual_names, width, @ written)
    if: status != c.LMX_WALK_OK
        return: status
    status: lmx_walk_publish(f)
    if: status != c.LMX_WALK_OK
        return: status
    return: lmx_walk_selected_ready_values(f, code, callee, first, transport_count, written_count, contract_inputs, actual_named, actual_names, width, map, sources, written, refs_out, values_out, out_count)
end: lmx_walk_selected_values

fn: lmx_walk_call_in (@: f c.LmxWalkFrame; @: code c.Lmx; @: out c.LmxWalkValue) int
    @: callee c.Lmx 0
    @: data c.Lmx 0
    @: contract c.Lmx 0
    @: inputs c.Lmx 0
    @: returns c.Lmx 0
    @: rtype void 0
    @: header_source void 0
    @@: refs void 0
    @: values c.LmxWalkValue 0
    size_t: n 0U
    size_t: arg_at 5U
    size_t: contract_count 0U
    size_t: callee_count 0U
    size_t: args_slot 0U
    size_t: input_count 0U
    size_t: return_count 0U
    size_t: return_slot 0U
    int: status c.LMX_WALK_OK
    int: called 0
    int: op 0
    int: split_call 0
    int: selected_signature 0
    int: want_result 0
    @: raw_selector void 0
    @: raw_data void 0
    @: raw_contract void 0
    @: tokens char 0
    @: place_map size_t 0
    int: answer 0
    @: context c.LmxWalkContext 0
    @: scratch c.LmxScratch 0
    @: callee_pool c.LmxPool 0
    lmx_walk_value_clear(out)
    if: f = 0
        return: c.LMX_WALK_INVALID
    status: lmx_walk_call_shape((cast: (@: c.LmxArena) f\arena), code, @ op, @ arg_at, @ n, @ raw_selector, @ raw_data, @ raw_contract)
    if: status != c.LMX_WALK_OK
        return: status
    split_call: (cast: (int) (op = c.LMX_WALK_OP_EXEC))
    status: lmx_walk_select_call(f, code, op, arg_at, raw_selector, raw_data, raw_contract, @ callee, @ data, @ contract, @ tokens, @ place_map)
    # Item 7 (interpreter-throw closure): a fault while evaluating the selector leaves as the status the selector
    # set -- an ordinary throw stays that throw, on the pad of its key as any operand's (lmx_walk_pad_find above);
    # a kernel error stays its code.  A missing contract is diagnosed separately: INVALID, as before.
    if: status != c.LMX_WALK_OK
        return: status
    callee_pool: c.lmx_range_cell_pool((cast: (@: c.LmxArena) f\arena), (cast: (@: void) callee))
    if: callee_pool != 0 && callee_pool\role = c.LMX_POOL_ROLE_FN
        selected_signature: 1
    # A nullary EXEC with no static contract takes its interface from
    # the selected code. Evaluation and publication happen exactly once.
    if: contract = 0 && split_call != 0 && n = 0U
        status: lmx_walk_publish(f)
        if: status != c.LMX_WALK_OK
            return: status
        if: place_map != 0
            return: c.LMX_WALK_INVALID
        status: lmx_call_selected_structure((cast: (@: c.LmxArena) f\arena), f, (cast: (@: c.Lmx) f\code), code, callee, data, out)
        if: status >= c.LMX_WALK_THROWN
            f\payload: out\ref
        return: status
    ---
    if: contract = 0
        if: selected_signature = 0
            return: c.LMX_WALK_INVALID
        contract: callee
    # A typed c.Lmx * is not evidence that the stored value is a graph header.
    # Resolve both signature parts through the common physical graph API
    # before reading their length (including the empty-input case). The
    # selected contract owns the execution map for its own header edges.
    if: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), (cast: (@: void) contract)) = 0
        return: c.LMX_WALK_INVALID
    if: c.lmx_callable_source_count((cast: (@: c.LmxArena) f\arena), contract, @ contract_count) != 0
        return: c.LMX_WALK_INVALID
    # Source edge1 is a return header only when the source has two fields;
    # for a one-field source edge1 belongs to its distinct LAST half.
    if: contract_count < 2U
        return: c.LMX_WALK_INVALID
    args_slot: (cast: (size_t) -1)
    return_slot: (cast: (size_t) -1)
    status: c.lmx_implements_exec_slot((cast: (@: c.LmxArena) f\arena), contract, 0U, @ args_slot, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    if: answer = c.LMX_IMPLEMENTS_UNKNOWN
        return: c.LMX_WALK_UNSUPPORTED
    if: answer = c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_INVALID
    status: c.lmx_implements_exec_slot((cast: (@: c.LmxArena) f\arena), contract, 1U, @ return_slot, @ answer)
    if: status != c.LMX_WALK_OK
        return: status
    if: answer = c.LMX_IMPLEMENTS_UNKNOWN
        return: c.LMX_WALK_UNSUPPORTED
    if: answer = c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_INVALID
    inputs: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), contract, args_slot))
    returns: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), contract, return_slot))
    if: inputs = 0 || returns = 0
        return: c.LMX_WALK_INVALID
    if: c.lmx_callable_source_count((cast: (@: c.LmxArena) f\arena), inputs, @ input_count) != 0 || c.lmx_callable_source_count((cast: (@: c.LmxArena) f\arena), returns, @ return_count) != 0
        return: c.LMX_WALK_INVALID
    if: input_count != n && selected_signature = 0
        return: c.LMX_WALK_INVALID
    if: return_count > 1U
        return: c.LMX_WALK_INVALID
    if: return_count != 0U
        if: c.lmx_callable_source_entry((cast: (@: c.LmxArena) f\arena), returns, 0U, @ header_source, @ rtype) != 0
            return: c.LMX_WALK_INVALID
        ---
    want_result: (cast: (int) (return_count != 0U))
    # The selected fn's current parts own its physical input/result ABI;
    # read its result below after actual evaluation/publication.
    context: (cast: (@: c.LmxWalkContext) f\context)
    scratch: (cast: (@: c.LmxScratch) context\scratch)
    if: status = c.LMX_WALK_OK
        if: selected_signature != 0
            status: lmx_walk_selected_values(f, code, callee, arg_at, n, op, inputs, @ refs, @ values, @ input_count)
            n: input_count
        else:
            status: lmx_walk_actuals_values(f, code, arg_at, n, inputs, callee, 0, @ refs, @ values)
        ---
    ---
    if: status = c.LMX_WALK_OK && selected_signature != 0
        # Source edge1 must be an ordinal return edge, not the LAST half
        # of a one-edge projection. Re-read after actual operand effects.
        if: c.lmx_callable_source_count((cast: (@: c.LmxArena) f\arena), callee, @ callee_count) != 0 || callee_count < 2U
            return: c.LMX_WALK_UNSUPPORTED
        status: c.lmx_implements_exec_slot((cast: (@: c.LmxArena) f\arena), callee, 1U, @ return_slot, @ answer)
        if: status != c.LMX_WALK_OK
            return: status
        if: answer != c.LMX_IMPLEMENTS_YES
            return: c.LMX_WALK_UNSUPPORTED
        returns: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), callee, return_slot))
        if: returns = 0
            return: c.LMX_WALK_UNSUPPORTED
        if: c.lmx_callable_source_count((cast: (@: c.LmxArena) f\arena), returns, @ return_count) != 0 || return_count > 1U
            return: c.LMX_WALK_UNSUPPORTED
        rtype: 0
        if: return_count != 0U
            if: c.lmx_callable_source_entry((cast: (@: c.LmxArena) f\arena), returns, 0U, @ header_source, @ rtype) != 0
                return: c.LMX_WALK_UNSUPPORTED
            ---
            # An unavailable physical result witness is not declared void.
            # This result transport requests a value; it needs storage.
            if: rtype = 0 && want_result != 0
                return: c.LMX_WALK_UNSUPPORTED
        ---
    ---
    if: status = c.LMX_WALK_OK && selected_signature = 0
        status: lmx_walk_publish(f)
    # N4 THE CALL'S ADMISSION (docs/LMX_semantics.ru.md: the selected call's admission checks the places it requires
    # before its body; a missing or ambiguous place is a runtime error of the call): a row that marks a name of the
    # code SIZE_MAX -- the data lacks the place, holds it ambiguously or holds it unfit -- is the call's implicit
    # `call` throw, no payload, the callee not entered.  Data of no proved layout (no token, no row, a slot past it)
    # is the translator's broken promise: INVALID (X1), never a catchable throw.  Nothing is recorded: the callee
    # resolves the same row at its entry.
    if: status = c.LMX_WALK_OK && place_map != 0
        answer: c.lmx_implements_places((cast: (@: c.LmxArena) f\arena), data, tokens, place_map, 0)
        if: answer = c.LMX_IMPLEMENTS_NO
            f\payload: 0
            f\landing: 0
            status: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CALL
        else:
            if: answer = c.LMX_IMPLEMENTS_UNKNOWN
                # This actual CALL cannot materialize a required physical
                # place yet. Report an execution limitation, not NO or an
                # implicit admission throw; native-word dispatch is unchanged.
                status: c.LMX_WALK_UNSUPPORTED
            ---
        ---
    ---
    if: status = c.LMX_WALK_OK
        called: 1
        status: lmx_walk_dispatch_values(f, code, callee, data, refs, n, values, rtype, split_call, out)
    ---
    # The receiving CALL contract owns result presence in both dispatch modes.
    # A void body may execute valued statements, but does not return their value.
    if: status = c.LMX_WALK_OK && (rtype = 0 || want_result = 0)
        lmx_walk_value_clear(out)
    # The callee's own throw: its payload is this call's.  A conversion edge's
    # receiver leaves as the caller's implicit `convert`, whatever it said.  A
    # throw raised while an operand was evaluated is the operand's: the callee
    # did not run, and its payload and key leave unchanged.  No row of this node
    # renumbers or lands anything: the bodies above find the pad by its key.
    if: status >= c.LMX_WALK_THROWN && called != 0
        f\payload: out\ref
        # An implicit numeric argument receiver retains its own boundary as
        # SOURCE_RECEIVING. It is still this normal converter EXEC: only its
        # callee's throw becomes convert, never an operand/selector throw.
        if: lmx_walk_source_of(f, code) = c.LMX_WALK_SOURCE_CONVERSION || (op = c.LMX_WALK_OP_EXEC && lmx_walk_source_of(f, code) = c.LMX_WALK_SOURCE_RECEIVING)
            status: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    ---
    return: status
end: lmx_walk_call_in

# Keep selector/data capture and all argument borrows under ONE call mark.
# Every early return of call_in passes through this same rewind.
fn: lmx_walk_call (@: f c.LmxWalkFrame; @: code c.Lmx; @: out c.LmxWalkValue) int
    c.LmxScratchMark: mark
    @: context c.LmxWalkContext 0
    @: scratch c.LmxScratch 0
    int: status
    lmx_walk_value_clear(out)
    if: f = 0 || f\context = 0
        return: c.LMX_WALK_INVALID
    context: (cast: (@: c.LmxWalkContext) f\context)
    scratch: (cast: (@: c.LmxScratch) context\scratch)
    if: c.lmx_scratch_mark(scratch, @ mark) != c.LMX_SCRATCH_OK
        return: c.LMX_WALK_INVALID
    status: lmx_walk_call_in(f, code, out)
    if: c.lmx_scratch_rewind(scratch, @ mark) != c.LMX_SCRATCH_OK && status = c.LMX_WALK_OK
        status: c.LMX_WALK_INVALID
    return: status
end: lmx_walk_call

fn: lmx_walk_prim (@: f c.LmxWalkFrame; @: code c.Lmx; @: out c.LmxWalkValue) int
    c.LmxActivation: prim_act
    c.LmxScratchMark: mark
    c.LmxWalkValue: temp
    @: temp_p c.LmxWalkValue @ temp
    c.LmxWalkValue: result_context
    @: result_context_p c.LmxWalkValue @ result_context
    @: record c.LmxPrimitive 0
    @: returns c.Lmx 0
    @: inputs c.Lmx 0
    @: target void 0
    @: witness void 0
    @: header_source void 0
    @: raw void 0
    @: dest void 0
    @@: refs void 0
    @: values c.LmxWalkValue 0
    @: room void 0
    @: firsts size_t 0
    @: order size_t 0
    size_t: n 0U
    int: status c.LMX_WALK_OK
    int: said 0
    int: called 0
    @: context c.LmxWalkContext 0
    @: scratch c.LmxScratch 0
    @: code_fields c.VoidArray 0
    @: inputs_fields c.VoidArray 0
    @: returns_fields c.VoidArray 0
    lmx_walk_value_clear(out)
    code_fields: @ code\array
    if: code_fields\size < 3U
        return: c.LMX_WALK_INVALID
    if: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U) != 0 && lmx_walk_prim_source_check(f, code) != c.LMX_WALK_OK
        return: c.LMX_WALK_INVALID
    ---
    target: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U)
    if: target = 0 || c.lmx_range_classify((cast: (@: c.LmxArena) f\arena), target) != c.LMX_DOMAIN_KIND_PRIMITIVE
        return: c.LMX_WALK_INVALID
    record: (cast: (@: c.LmxPrimitive) target)
    if: record\fn = 0 || record\signature = 0 || lmx_walk_immutable(f, (cast: (@: void) record\owner)) != 0
        return: c.LMX_WALK_INVALID
    n: code_fields\size - 3U
    inputs: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), (cast: (@: c.Lmx) record\signature), 0U))
    returns: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), (cast: (@: c.Lmx) record\signature), 1U))
    if: inputs = 0 || returns = 0
        return: c.LMX_WALK_INVALID
    inputs_fields: @ inputs\array
    returns_fields: @ returns\array
    if: inputs_fields\size != n
        return: c.LMX_WALK_INVALID
    if: returns_fields\size > 1U
        return: c.LMX_WALK_INVALID
    if: returns_fields\size != 0U
        if: c.lmx_callable_entry((cast: (@: c.LmxArena) f\arena), returns, 0U, @ header_source, @ witness) != 0
            return: c.LMX_WALK_INVALID
        ---
    context: (cast: (@: c.LmxWalkContext) f\context)
    scratch: (cast: (@: c.LmxScratch) context\scratch)
    if: c.lmx_scratch_mark(scratch, @ mark) != c.LMX_SCRATCH_OK
        return: c.LMX_WALK_INVALID
    # A source-backed primitive evaluates its actuals in the written order of
    # its source body (lmx_walk_prim_source_order); one or no actual has no
    # order to keep. The two index arrays live under this step's mark.
    if: n > 1U && c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U) != 0
        if: n > (cast: (size_t) -1) / sizeof(n) / 2U || c.lmx_scratch_take(scratch, n * sizeof(n), @ room) != c.LMX_SCRATCH_OK || room = 0
            status: c.LMX_WALK_NOMEM
        else:
            firsts: (cast: (@: size_t) room)
            if: c.lmx_scratch_take(scratch, n * sizeof(n), @ room) != c.LMX_SCRATCH_OK || room = 0
                status: c.LMX_WALK_NOMEM
            else:
                order: (cast: (@: size_t) room)
                status: lmx_walk_prim_source_order(f, code, firsts, order)
            ---
        ---
    ---
    if: status = c.LMX_WALK_OK
        status: lmx_walk_actuals_values(f, code, 3U, n, inputs, 0, order, @ refs, @ values)
    if: status = c.LMX_WALK_OK && lmx_walk_node(f, (cast: (@: void) code)) = c.LMX_WALK_OP_PRIM_PUB
        status: lmx_walk_publish(f)
    if: status = c.LMX_WALK_OK
        called: 1
        dest: lmx_walk_result_dest((cast: (@: c.LmxArena) f\arena), witness, @ temp)
        lmx_walk_value_clear(@ result_context)
        c.LmxPrimitiveEntry: entry (cast: (c.LmxPrimitiveEntry) record\fn)
        c.lmx_activation_push((cast: (@: c.LmxArena) f\arena), @ prim_act, 2, code, refs, (cast: (@: void) values), n, 0)
        said: entry((cast: (@: void) record\owner), refs, n, dest, @ raw, (cast: (@: c.LmxArena) f\arena), code, values, @ result_context)
        c.lmx_activation_pop((cast: (@: c.LmxArena) f\arena), @ prim_act)
        if: c.lmx_msg_poll_escape() != 0
            status: c.LMX_WALK_STOPPED
        else:
            if: said = c.LMX_PRIMITIVE_THROW_MERGE
                status: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_MERGE
            else:
                if: said = c.LMX_PRIMITIVE_THROW_IMPLEMENTS
                    status: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_IMPLEMENTS
                else:
                    # Item 6 (interpreter-throw closure): a primitive standing for a call of a callable value conveys
                    # its callee's throw -- LMX_PRIMITIVE_THROWN + the key, the thrown record in raw -- and it lands
                    # on the pad of that key as a callee's throw lands from lmx_walk_call (the payload is taken
                    # below, as for every throw of the primitive's own); a code outside the protocol is PRIMITIVE,
                    # a malformed runtime protocol.
                    if: said >= c.LMX_PRIMITIVE_THROWN
                        status: c.LMX_WALK_THROWN + (said - c.LMX_PRIMITIVE_THROWN)
                    else:
                        if: said != c.LMX_PRIMITIVE_OK
                            status: c.LMX_WALK_PRIMITIVE
                        else:
                            status: lmx_walk_native_result_context(f, witness, raw, out, @ result_context)
                    ---
                ---
            ---
        ---
    ---
    # As in lmx_walk_call: only the primitive's own throw takes its payload; an
    # operand's throw leaves as the operand set it.  The pad is found above.
    if: status >= c.LMX_WALK_THROWN && called != 0
        f\payload: raw
        lmx_walk_value_ref(out, c.LMX_TYPE_LMX, raw)
    ---
    if: c.lmx_scratch_rewind(scratch, @ mark) != c.LMX_SCRATCH_OK && status = c.LMX_WALK_OK
        status: c.LMX_WALK_INVALID
    return: status
end: lmx_walk_prim

# The evaluator preserves its temporary result and all original physical-place ordering.

# Slice 255 (design 4.5 B2a): the result place is a receiving place.  The value a RET evaluated is admitted by the kernel's
# one admission (lmx_walk_value_receive) into the selected code's declared result type -- the one witness of its contract's
# return part, read as the call site reads it (lmx_walk_call_in) -- as the native twin receives it at its return; a mismatch
# is the implicit `convert` throw raised at the RET, in the callee's own frame (its pads first, then the caller's).  Since
# slice 257 (P1-RET of Codex's answer to TP118) every present NUMBER or REFERENCE value goes through that admission: a number
# into a reference witness (LMX for a Structure, DESC for an Array, the pointer code of a typed pointer, CHAR_PTR for a text)
# and a reference into a numeric witness are the convert, as at the native return.  The graph's null literal where a
# reference is declared is a typed pointer cell (LMX_WALK_OP_LIT, lm_compiler_rw_reference_span): a REFERENCE of the
# witness's pointer code, received as one -- no number stands where a reference is declared.  A code without a readable
# one-witness return part (a contractless split entry, a void part, no static witness) receives nothing: the value passes as
# before.
fn: lmx_walk_result_receive (@: f c.LmxWalkFrame; @: value c.LmxWalkValue) int
    c.LmxWalkValue: received
    @: returns c.Lmx 0
    @: header_source void 0
    @: witness void 0
    size_t: return_slot 0U
    size_t: return_count 0U
    int: answer 0
    int: ty 0
    int: status c.LMX_WALK_OK
    if: f = 0 || value = 0 || value\present = 0 || f\code = 0
        return: c.LMX_WALK_OK
    if: value\kind != c.LMX_WALK_VALUE_NUMBER && value\kind != c.LMX_WALK_VALUE_REFERENCE
        return: c.LMX_WALK_OK
    if: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), (cast: (@: void) f\code)) = 0
        return: c.LMX_WALK_OK
    if: c.lmx_implements_exec_slot((cast: (@: c.LmxArena) f\arena), f\code, 1U, @ return_slot, @ answer) != c.LMX_WALK_OK || answer != c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    returns: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), f\code, return_slot))
    if: returns = 0 || c.lmx_callable_source_count((cast: (@: c.LmxArena) f\arena), returns, @ return_count) != 0 || return_count != 1U
        return: c.LMX_WALK_OK
    if: c.lmx_callable_source_entry((cast: (@: c.LmxArena) f\arena), returns, 0U, @ header_source, @ witness) != 0 || witness = 0
        return: c.LMX_WALK_OK
    ty: c.lmx_type_base(lmx_walk_witness_type((cast: (@: c.LmxArena) f\arena), witness))
    if: ty = c.LMX_TYPE_NONE
        return: c.LMX_WALK_OK
    status: lmx_walk_value_receive(value, ty, @ received)
    if: status != c.LMX_WALK_OK
        return: status
    c.memcpy((cast: (@: void) value), (cast: (@: void) (@ received)), c.sizeof(c.LmxWalkValue))
    return: c.LMX_WALK_OK
end: lmx_walk_result_receive

# Slice 272: a place frame whose selector is a field name, not a physical index.
fn: lmx_walk_field_selector (@: f c.LmxWalkFrame; @: frame void) int
    int: op lmx_walk_node(f, frame)
    if: op != c.LMX_WALK_OP_OF && op != c.LMX_WALK_OP_PUT_OF
        return: 0
    @: selector void c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), (cast: (@: c.Lmx) frame), 2U)
    if: selector = 0
        return: 0
    return: (cast: (int) (c.lmx_type_base(c.lmx_domain_type((cast: (@: c.LmxArena) f\arena), selector)) = c.LMX_TYPE_CHAR_PTR))
end: lmx_walk_field_selector

# Slice 272: the target of a write through a name selector: one selection of the held root's field, its coordinates kept for the store.
fn: lmx_walk_field_target (@: f c.LmxWalkFrame; @: code c.Lmx; @: out c.LmxWalkPlace; @@: out_root c.Lmx; @: out_index size_t) int
    c.LmxWalkValue: holder
    @: holder_p c.LmxWalkValue @ holder
    @: arena c.LmxArena (cast: (@: c.LmxArena) f\arena)
    int: status lmx_walk_projection_at(f, c.lmx_graph_value_in(arena, code, 1U), 0, 0, @ holder)
    if: status != c.LMX_WALK_OK
        return: status
    status: lmx_walk_value_field_place(arena, holder_p, c.lmx_charptr_value_known(c.lmx_graph_value_in(arena, code, 2U)), out, out_root, out_index)
    if: status = c.LMX_WALK_OK && c.lmx_walk_immutable(f, holder_p\ref) != 0
        return: c.LMX_WALK_INVALID
    return: status
end: lmx_walk_field_target

fn: lmx_walk_eval_result (@: f c.LmxWalkFrame; @: operand void; @: out c.LmxWalkValue) int
    c.LmxWalkValue: value
    @: value_p c.LmxWalkValue @ value
    c.LmxWalkValue: other
    @: other_p c.LmxWalkValue @ other
    c.LmxWalkPlace: place
    @: place_p c.LmxWalkPlace @ place
    @: outer c.LmxWalkValue 0
    @: code c.Lmx (cast: (@: c.Lmx) operand)
    @: work c.LmxWalkWork 0
    @: wholder c.Lmx 0
    @@: slot void 0
    @: root void 0
    @: materialized void 0
    int: slot_type 0
    @: want void 0
    @: leaf void 0
    @: write_target void 0
    size_t: index 0U
    size_t: field_index 0U
    size_t: ua 0U
    size_t: ub 0U
    size_t: wv 0U
    int: a 0
    int: b 0
    int: op
    int: going 1
    int: status c.LMX_WALK_OK
    int: native_num_result
    @: code_fields c.VoidArray 0
    @: holder_fields c.VoidArray 0
    @: root_graph c.Lmx 0
    @: root_fields c.VoidArray 0
    @@: args void 0
    @: frame_result c.LmxWalkValue 0
    if: f = 0 || operand = 0 || out = 0
        return: c.LMX_WALK_INVALID
    lmx_walk_value_clear(out)
    op: lmx_walk_node(f, operand)
    if: op = c.LMX_WALK_OP_UNKNOWN || op = c.LMX_WALK_OP_SOURCE_MACHINE
        return: c.LMX_WALK_UNSUPPORTED
    # Retained source is not a request to execute directive arguments. In
    # particular, symbolic leaves and machine expressions below it are inert.
    if: op = c.LMX_WALK_OP_SOURCE_INERT || op = c.LMX_WALK_OP_ELSE || op = c.LMX_WALK_OP_THROWS
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_NONE
        if: lmx_walk_kind(f, operand) != c.LMX_KIND_STRUCT && lmx_walk_kind(f, operand) != c.LMX_KIND_ARRAY
            return: c.LMX_WALK_INVALID
        return: lmx_walk_value_cell((cast: (@: c.LmxArena) f\arena), operand, out)
    # Item 4: the executed operation's frame is validated before any operand of it is evaluated (lmx_walk_shape_min).
    code_fields: @ code\array
    if: code_fields\size < lmx_walk_shape_min(op)
        return: c.LMX_WALK_INVALID
    if: lmx_walk_bare(f, operand) != 0
        if: op != c.LMX_WALK_OP_RET
            return: c.LMX_WALK_INVALID
        f\returned: 1
        c.memcpy((cast: (@: void) out), (cast: (@: void) (@ f\result)), c.sizeof(c.LmxWalkValue))
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_LIT
        root: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U)
        if: root = 0
            return: c.LMX_WALK_INVALID
        # A three-part LIT retains a contextual magnitude and U spelling.
        # A two-part LIT still produces its declared typed value unchanged.
        if: code_fields\size = 3U
            leaf: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U)
            if: leaf = 0 || c.lmx_type_base(c.lmx_domain_type((cast: (@: c.LmxArena) f\arena), root)) != c.LMX_TYPE_SIZE_T || c.lmx_type_base(c.lmx_domain_type((cast: (@: c.LmxArena) f\arena), leaf)) != c.LMX_TYPE_SIZE_T
                return: c.LMX_WALK_INVALID
            size_t: suffix c.lmx_size_value_known(leaf)
            if: suffix > 1U
                return: c.LMX_WALK_INVALID
            return: lmx_walk_value_lit(out, c.lmx_size_value_known(root), (cast: (int) suffix))
        return: lmx_walk_value_cell((cast: (@: c.LmxArena) f\arena), root, out)
    # [guard, source, continuation] (lmx_walk.h.lm1): the source once; an absent one leaves the guard's value absent.
    if: op = c.LMX_WALK_OP_GUARD
        if: code_fields\size != 3U
            return: c.LMX_WALK_INVALID
        status: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        if: value_p\present = 0
            return: c.LMX_WALK_OK
        outer: (cast: (@: c.LmxWalkValue) f\guarded)
        f\guarded: @ value
        status: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U), out)
        f\guarded: outer
        return: status
    if: op = c.LMX_WALK_OP_GUARDED
        if: code_fields\size != 1U || f\guarded = 0
            return: c.LMX_WALK_INVALID
        c.memcpy((cast: (@: void) out), (cast: (@: void) f\guarded), c.sizeof(c.LmxWalkValue))
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_OWN || op = c.LMX_WALK_OP_OWN_OF
        status: lmx_walk_work_cell(f, operand, 0, @ wholder, @ index, @ slot)
        if: status != c.LMX_WALK_OK
            return: status
        work: lmx_walk_work_find(f, slot)
        if: work = 0
            return: c.LMX_WALK_INVALID
        c.memcpy((cast: (@: void) out), (cast: (@: void) (@ work\value)), c.sizeof(c.LmxWalkValue))
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_ARG
        index: c.lmx_size_value_known(c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U))
        if: index >= f\nargs || f\args = 0
            return: c.LMX_WALK_INVALID
        args: (cast: (@@: void) f\args)
        if: args[index] = 0
            if: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U) = 0
                return: c.LMX_WALK_OK
            ---
        ---
        status: lmx_walk_place(f, operand, 0, @ place)
        if: status != c.LMX_WALK_OK
            return: status
        return: lmx_walk_place_load((cast: (@: c.LmxArena) f\arena), @ place, out)
    if: op = c.LMX_WALK_OP_SET_ARG
        index: c.lmx_size_value_known(c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U))
        a: lmx_walk_witness_type((cast: (@: c.LmxArena) f\arena), c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 3U))
        status: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        return: lmx_walk_arg_write(f, index, a, @ value, out)
    if: op = c.LMX_WALK_OP_SELF
        return: lmx_walk_projection(f, operand, 0, out)
    if: op = c.LMX_WALK_OP_LAYOUT_SWITCH
        # The translator has already built each branch's admission map from
        # the corresponding data layout. Only the selected branch runs.
        if: code_fields\size < 2U || code_fields\size % 2U != 0U
            return: c.LMX_WALK_INVALID
        status: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        if: value_p\present = 0 || value_p\kind != c.LMX_WALK_VALUE_REFERENCE || value_p\type != c.LMX_TYPE_LMX || value_p\ref = 0 || lmx_walk_kind(f, (cast: (@: void) value_p\ref)) != c.LMX_KIND_STRUCT
            return: c.LMX_WALK_INVALID
        root: c.lmx_implements_layout((cast: (@: c.LmxArena) f\arena), (cast: (@: c.Lmx) value_p\ref))
        if: root = 0
            return: c.LMX_WALK_INVALID
        index: 2U
        while: index < code_fields\size
            leaf: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, index)
            if: leaf = 0 || c.lmx_domain_kind((cast: (@: c.LmxArena) f\arena), leaf) != c.LMX_KIND_PRIMITIVE || c.lmx_type_base(c.lmx_domain_type((cast: (@: c.LmxArena) f\arena), leaf)) != c.LMX_TYPE_CHAR_PTR
                return: c.LMX_WALK_INVALID
            if: root = (cast: (@: void) c.lmx_charptr_value_known(leaf))
                return: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, index + 1U), out)
            index: index + 2U
        ---
        return: c.LMX_WALK_INVALID
    if: op = c.LMX_WALK_OP_NODE
        return: lmx_walk_projection(f, operand, 0, out)
    if: op = c.LMX_WALK_OP_ADDRESS
        status: lmx_walk_place(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U), 0, @ place)
        if: status != c.LMX_WALK_OK
            return: status
        if: place_p\descriptor = 0 && place_p\address = 0 && place_p\storage = 0
            return: c.LMX_WALK_INVALID
        # Slice 258 (design 4.5 B2b-2a): without a static witness (the address of a free name) the reference has the pointer
        # code of the place's actual type (lmx_walk_place_address).
        want: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U)
        if: want = 0
            return: lmx_walk_place_address((cast: (@: c.LmxArena) f\arena), @ place, out)
        a: lmx_walk_witness_type((cast: (@: c.LmxArena) f\arena), want)
        if: place_p\storage != 0
            status: lmx_walk_value_ref(out, a, (cast: (@: void) place_p\storage))
        else:
            status: lmx_walk_value_ref(out, a, (cast: (@: void) place_p\address))
        ---
        out\referent: lmx_walk_place_context((cast: (@: c.LmxArena) f\arena), @ place)
        return: status
    if: op = c.LMX_WALK_OP_AT || op = c.LMX_WALK_OP_OF || op = c.LMX_WALK_OP_OF_EDGE || op = c.LMX_WALK_OP_DEREF || op = c.LMX_WALK_OP_ELEM
        status: lmx_walk_place(f, operand, 0, @ place)
        if: status != c.LMX_WALK_OK
            return: status
        return: lmx_walk_place_load((cast: (@: c.LmxArena) f\arena), @ place, out)
    if: op = c.LMX_WALK_OP_PUT || op = c.LMX_WALK_OP_PUT_OF || op = c.LMX_WALK_OP_ELEMPUT
        # Select the physical place exactly once, then receive the value_p\
        # Fixed AT has no source evaluation; OF/DEREF/ELEM retain target-first
        # ordering. No write occurs before the complete RHS succeeds.
        write_target: operand
        if: op = c.LMX_WALK_OP_PUT
            write_target: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U)
        ---
        # Slice 272: a name selector keeps the selected field's coordinates for the store of the written value.
        if: lmx_walk_field_selector(f, write_target) != 0
            status: lmx_walk_field_target(f, (cast: (@: c.Lmx) write_target), @ place, @ wholder, @ field_index)
        else:
            status: lmx_walk_place(f, write_target, 1, @ place)
        ---
        if: status != c.LMX_WALK_OK
            return: status
        if: place_p\descriptor != 0
            if: lmx_walk_immutable(f, (cast: (@: void) place_p\storage)) != 0
                return: c.LMX_WALK_INVALID
            ---
        else:
            if: lmx_walk_immutable(f, (cast: (@: void) place_p\address)) != 0
                return: c.LMX_WALK_INVALID
            ---
        ---
        index: 3U
        if: op = c.LMX_WALK_OP_PUT
            index: 2U
        status: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, index), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        if: value_p\present = 0
            c.memcpy((cast: (@: void) out), (cast: (@: void) (@ value)), c.sizeof(c.LmxWalkValue))
            return: c.LMX_WALK_OK
        if: wholder != 0
            status: lmx_walk_value_field_store((cast: (@: c.LmxArena) f\arena), wholder, field_index, @ place, @ value)
        else:
            status: lmx_walk_value_store((cast: (@: c.LmxArena) f\arena), @ place, @ value)
        ---
        if: status != c.LMX_WALK_OK
            return: status
        if: place_p\descriptor != 0
            return: lmx_walk_value_ref_parts(out, (cast: (int) place_p\type), (cast: (@: void) value_p\ref), (cast: (@: c.Lmx) value_p\model), (cast: (@: c.Lmx) value_p\references))
        ---
        status: lmx_walk_place_load((cast: (@: c.LmxArena) f\arena), @ place, out)
        if: status = c.LMX_WALK_OK && out\kind = c.LMX_WALK_VALUE_REFERENCE
            # The result is this written value even for an unqualified raw
            # cell. Persistent state,when present,was updated by the store.
            c.lmx_value_context_copy(out, @ value)
        return: status
    if: op = c.LMX_WALK_OP_PUT_REF
        status: lmx_walk_slot_place(f, code, 1U, 1, @ wholder, @ index, @ slot)
        if: status != c.LMX_WALK_OK
            return: status
        status: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 3U), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        if: value_p\present = 0
            c.memcpy((cast: (@: void) out), (cast: (@: void) (@ value)), c.sizeof(c.LmxWalkValue))
            return: c.LMX_WALK_OK
        if: value_p\kind != c.LMX_WALK_VALUE_REFERENCE
            return: c.LMX_WALK_INVALID
        if: slot = 0
            return: c.LMX_WALK_INVALID
        if: lmx_walk_is_pointer_cell((cast: (@: c.LmxArena) f\arena), slot[0]) != 0
            slot_type: c.lmx_type_base(c.lmx_domain_type((cast: (@: c.LmxArena) f\arena), slot[0]))
            if: slot_type != c.LMX_TYPE_LMX && slot_type != c.LMX_TYPE_DESC
                return: c.LMX_WALK_INVALID
            ---
        ---
        if: lmx_walk_immutable(f, (cast: (@: void) slot)) != 0
            return: c.LMX_WALK_INVALID
        if: value_p\ref != 0 && lmx_walk_kind(f, (cast: (@: void) value_p\ref)) != c.LMX_KIND_STRUCT
            return: c.LMX_WALK_INVALID
        status: c.lmx_implements_receive_data_field((cast: (@: c.LmxArena) f\arena), wholder, index, (cast: (@: c.Lmx) value_p\ref))
        if: status != c.LMX_WALK_OK
            f\payload: 0
            return: status
        ---
        status: lmx_walk_value_materialize((cast: (@: c.LmxArena) f\arena), @ value, @ materialized)
        if: status != c.LMX_WALK_OK
            return: status
        if: c.lmx_graph_ref_store_in((cast: (@: c.LmxArena) f\arena), wholder, index, materialized) != 0
            return: c.LMX_WALK_INVALID
        c.memcpy((cast: (@: void) out), (cast: (@: void) (@ value)), c.sizeof(c.LmxWalkValue))
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_SET || op = c.LMX_WALK_OP_SET_OF
        if: op = c.LMX_WALK_OP_SET
            status: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U), @ value)
            if: status != c.LMX_WALK_OK
                return: status
            status: lmx_walk_work_cell(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U), 1, @ wholder, @ index, @ slot)
        else:
            status: lmx_walk_work_cell(f, operand, 1, @ wholder, @ index, @ slot)
            if: status != c.LMX_WALK_OK
                return: status
            status: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 3U), @ value)
        ---
        if: status != c.LMX_WALK_OK
            return: status
        work: lmx_walk_work_find(f, slot)
        if: work = 0
            return: c.LMX_WALK_INVALID
        # Receiving no result does not replace the old working record or
        # change an already pending dirty write. Preserve the actual absence.
        if: value_p\present = 0
            c.memcpy((cast: (@: void) out), (cast: (@: void) (@ value)), c.sizeof(c.LmxWalkValue))
            return: c.LMX_WALK_OK
        if: (work\kind = 3 && lmx_walk_immutable(f, (cast: (@: void) slot)) != 0) || (work\kind != 3 && lmx_walk_immutable(f, slot[0]) != 0)
            return: c.LMX_WALK_INVALID
        if: work\kind != 1
            if: value_p\kind != c.LMX_WALK_VALUE_REFERENCE
                return: c.LMX_WALK_INVALID
            ---
            if: work\kind = 3
                status: c.lmx_implements_receive_data_field((cast: (@: c.LmxArena) f\arena), wholder, index, (cast: (@: c.Lmx) value_p\ref))
                if: status != c.LMX_WALK_OK
                    f\payload: 0
                    return: status
                ---
            ---
        else:
            # Slice 255 (design 4.5 B2a): the working number cell is a receiving place -- the kernel's one admission
            # (lmx_walk_value_receive, in place: the received value replaces the evaluated one); a mismatch is the
            # statement's implicit `convert` throw, not INVALID.
            status: lmx_walk_value_receive(@ value, work\ty, @ value)
            if: status != c.LMX_WALK_OK
                return: status
            ---
        ---
        c.memcpy((cast: (@: void) (@ work\value)), (cast: (@: void) (@ value)), c.sizeof(c.LmxWalkValue))
        work\dirty: 1
        c.memcpy((cast: (@: void) out), (cast: (@: void) (@ work\value)), c.sizeof(c.LmxWalkValue))
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_AND || op = c.LMX_WALK_OP_OR
        status: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        if: lmx_walk_value_number(@ value, @ ua, @ a) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        if: (op = c.LMX_WALK_OP_AND && ua = 0U) || (op = c.LMX_WALK_OP_OR && ua != 0U)
            return: lmx_walk_value_num(out, c.LMX_TYPE_INT, (cast: (size_t) (op = c.LMX_WALK_OP_OR)))
        status: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U), @ other)
        if: status != c.LMX_WALK_OK
            return: status
        if: lmx_walk_value_number(@ other, @ ub, @ b) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        return: lmx_walk_value_num(out, c.LMX_TYPE_INT, (cast: (size_t) (ub != 0U)))
    # Slice 261 (design 4.5 B2b-2d, P1-PTR-COVERAGE): [receive, value, witness, depth, leaf] -- a runtime-typed value at a
    # pointer place whose shape the translator knows: the one receive by the actual pointees (lmx_walk_value_receive_pointer),
    # the same call the native code makes at that place; the received value takes the witness's type.  An absent value
    # stays absent.
    if: op = c.LMX_WALK_OP_RECEIVE
        if: code_fields\size != 3U && code_fields\size != 5U
            return: c.LMX_WALK_INVALID
        status: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        if: value_p\present = 0
            c.memcpy((cast: (@: void) out), (cast: (@: void) (@ value)), c.sizeof(c.LmxWalkValue))
            return: c.LMX_WALK_OK
        a: lmx_walk_witness_type((cast: (@: c.LmxArena) f\arena), c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U))
        if: code_fields\size = 3U
            return: lmx_walk_value_receive(value_p, a, out)
        if: lmx_walk_load_numeric((cast: (@: c.LmxArena) f\arena), c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 3U), @ ua) != c.LMX_WALK_OK || lmx_walk_load_numeric((cast: (@: c.LmxArena) f\arena), c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 4U), @ ub) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        return: lmx_walk_value_receive_pointer((cast: (@: c.LmxArena) f\arena), value_p, a, (cast: (int) ua), (cast: (int) ub), out)
    # A prefix sign: one operand, evaluated once. The C99 integer promotion
    # comes first, as for every arithmetic operand below; the result has the
    # promoted type. Negation is the unsigned one of the stored width, which is
    # the two's complement negation for an int.
    if: op = c.LMX_WALK_OP_NEG || op = c.LMX_WALK_OP_POS || op = c.LMX_WALK_OP_BNOT
        if: code_fields\size != 2U
            return: c.LMX_WALK_INVALID
        status: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        return: lmx_walk_value_unary(op, @ value, out)
    if: op = c.LMX_WALK_OP_ADD || op = c.LMX_WALK_OP_SUB || op = c.LMX_WALK_OP_MUL || op = c.LMX_WALK_OP_DIV || op = c.LMX_WALK_OP_MOD || op = c.LMX_WALK_OP_LT || op = c.LMX_WALK_OP_EQ || op = c.LMX_WALK_OP_BAND || op = c.LMX_WALK_OP_BOR || op = c.LMX_WALK_OP_BXOR || op = c.LMX_WALK_OP_SHL || op = c.LMX_WALK_OP_SHR
        status: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        status: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U), @ other)
        if: status != c.LMX_WALK_OK
            return: status
        # Slice 255 (design 4.5 B2a): one shared operation for both executors (lmx_walk_value_bin).  A LIT operand beside a
        # non-literal operand is contextual: it takes the other operand's type in the operation (a statically typed program
        # has already unified it with that operand; a runtime-typed operand types it now).  Slice 259: not across a shift --
        # its operands are typed apart (C99 6.5.7): the left literal keeps its type, the count its own.
        if: op != c.LMX_WALK_OP_SHL && op != c.LMX_WALK_OP_SHR
            if: lmx_walk_node(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U)) = c.LMX_WALK_OP_LIT && lmx_walk_node(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U)) != c.LMX_WALK_OP_LIT
                lmx_walk_value_contextual(value_p)
            if: lmx_walk_node(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U)) = c.LMX_WALK_OP_LIT && lmx_walk_node(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U)) != c.LMX_WALK_OP_LIT
                lmx_walk_value_contextual(other_p)
        ---
        status: lmx_walk_value_bin(op, value_p, other_p, out)
        if: status = c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
            return: lmx_walk_fault(f)
        return: status
    if: op = c.LMX_WALK_OP_IF
        status: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        if: lmx_walk_value_number(@ value, @ wv, @ a) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        if: wv != 0U
            return: lmx_walk_body(f, c.lmx_graph_ref_struct_in((cast: (@: c.LmxArena) f\arena), code, 2U), 0U)
        if: code_fields\size > 3U
            return: lmx_walk_body(f, c.lmx_graph_ref_struct_in((cast: (@: c.LmxArena) f\arena), c.lmx_graph_ref_struct_in((cast: (@: c.LmxArena) f\arena), code, 3U), 1U), 0U)
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_BREAK
        return: c.LMX_WALK_BREAK
    if: op = c.LMX_WALK_OP_CONTINUE
        return: c.LMX_WALK_CONTINUE
    if: op = c.LMX_WALK_OP_UNTIL || op = c.LMX_WALK_OP_WHILE || op = c.LMX_WALK_OP_FOR
        while: going != 0
            if: c.lmx_msg_poll_escape() != 0
                return: c.LMX_WALK_STOPPED
            if: op != c.LMX_WALK_OP_UNTIL
                status: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U), @ value)
                if: status = c.LMX_WALK_OK
                    status: lmx_walk_value_number(@ value, @ wv, @ a)
                if: status != c.LMX_WALK_OK || wv = 0U
                    going: 0
                ---
            ---
            if: going != 0
                status: lmx_walk_body(f, c.lmx_graph_ref_struct_in((cast: (@: c.LmxArena) f\arena), code, 2U), 0U)
                if: status = c.LMX_WALK_CONTINUE
                    status: c.LMX_WALK_OK
                if: status = c.LMX_WALK_BREAK
                    status: c.LMX_WALK_OK
                    going: 0
                if: status != c.LMX_WALK_OK || f\returned != 0
                    going: 0
                ---
            ---
            if: going != 0 && op = c.LMX_WALK_OP_FOR
                status: lmx_walk_body(f, c.lmx_graph_ref_struct_in((cast: (@: c.LmxArena) f\arena), code, 3U), 0U)
                if: status != c.LMX_WALK_OK || f\returned != 0
                    going: 0
                ---
            ---
            if: going != 0 && op = c.LMX_WALK_OP_UNTIL
                status: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U), @ value)
                if: status = c.LMX_WALK_OK
                    status: lmx_walk_value_number(@ value, @ wv, @ a)
                if: status != c.LMX_WALK_OK || wv != 0U
                    going: 0
                ---
            ---
        ---
        return: status
    if: op = c.LMX_WALK_OP_RET
        frame_result: @ f\result
        if: code_fields\size > 1U
            status: lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U), frame_result)
            if: status != c.LMX_WALK_OK
                return: status
            # Slice 255 (design 4.5 B2a): the result place receives the value (lmx_walk_result_receive).
            status: lmx_walk_result_receive(f, frame_result)
            if: status != c.LMX_WALK_OK
                return: status
        ---
        f\returned: 1
        c.memcpy((cast: (@: void) out), (cast: (@: void) (@ f\result)), c.sizeof(c.LmxWalkValue))
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_THROW
        return: lmx_walk_throw(f, code, out)
    if: op = c.LMX_WALK_OP_PRIM || op = c.LMX_WALK_OP_PRIM_PUB
        return: lmx_walk_prim(f, code, out)
    if: op = c.LMX_WALK_OP_ADMIT_AS
        return: lmx_walk_admit_op(f, code, out)
    if: op = c.LMX_WALK_OP_EMPTY
        return: lmx_walk_empty(f, code, out)
    if: op = c.LMX_WALK_OP_CALL || op = c.LMX_WALK_OP_EXEC
        return: lmx_walk_call(f, code, out)
    if: op = c.LMX_WALK_OP_EXPECT_INT
        # This model predicate's declared first input is a Structure reference.
        if: f\args = 0 || f\nargs < 1U
            return: lmx_walk_value_num(out, c.LMX_TYPE_INT, 0U)
        args: (cast: (@@: void) f\args)
        if: args[0] = 0 || code_fields\size < 3U
            return: lmx_walk_value_num(out, c.LMX_TYPE_INT, 0U)
        root: c.lmx_pointer_value_known(args[0])
        # Keep absence distinct from a present malformed value_p\ A typed
        # operand adapter alone would collapse the latter to null and turn a
        # malformed path into this predicate's ordinary false result.
        wholder: (cast: (@: c.Lmx) c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U))
        want: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 2U)
        if: root = 0 || wholder = 0 || want = 0
            return: lmx_walk_value_num(out, c.LMX_TYPE_INT, 0U)
        if: c.lmx_graph_node_in((cast: (@: c.LmxArena) f\arena), (cast: (@: void) wholder)) = 0 || c.lmx_domain_kind((cast: (@: c.LmxArena) f\arena), (cast: (@: void) wholder)) != c.LMX_KIND_STRUCT
            return: c.LMX_WALK_INVALID
        holder_fields: @ wholder\array
        index: 0U
        while: index < holder_fields\size
            a: c.lmx_int_value_known(c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), wholder, index))
            if: a < 0
                return: c.LMX_WALK_INVALID
            root_graph: (cast: (@: c.Lmx) root)
            root_fields: @ root_graph\array
            if: (cast: (size_t) a) >= root_fields\size
                return: c.LMX_WALK_INVALID
            leaf: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), (cast: (@: c.Lmx) root), (cast: (size_t) a))
            if: leaf = 0
                return: c.LMX_WALK_INVALID
            if: c.lmx_domain_kind((cast: (@: c.LmxArena) f\arena), leaf) = c.LMX_KIND_STRUCT
                root: leaf
            index: index + 1U
        ---
        if: leaf = 0 || c.lmx_domain_kind((cast: (@: c.LmxArena) f\arena), leaf) != c.LMX_KIND_PRIMITIVE || c.lmx_type_base(c.lmx_domain_type((cast: (@: c.LmxArena) f\arena), leaf)) != c.LMX_TYPE_INT
            return: lmx_walk_value_num(out, c.LMX_TYPE_INT, 0U)
        return: lmx_walk_value_num(out, c.LMX_TYPE_INT, (cast: (size_t) (c.lmx_int_value_known(leaf) = c.lmx_int_value_known(want))))
    if: op = c.LMX_WALK_OP_LENGTH
        status: c.lmx_walk_eval(f, c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), code, 1U), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        status: lmx_walk_value_length((cast: (@: c.LmxArena) f\arena), @ value, @ ua)
        if: status = c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
            return: lmx_walk_fault(f)
        if: status != c.LMX_WALK_OK
            return: status
        return: lmx_walk_value_num(out, c.LMX_TYPE_SIZE_T, ua)
    if: op = c.LMX_WALK_OP_PAD
        return: c.LMX_WALK_OK
    return: c.LMX_WALK_INVALID
end: lmx_walk_eval_result

fn: lmx_walk_eval (@: f c.LmxWalkFrame; @: operand void; @: out c.LmxWalkValue) int
    c.LmxWalkValue: result
    @: result_p c.LmxWalkValue @ result
    int: status
    if: f = 0 || operand = 0 || out = 0
        return: c.LMX_WALK_INVALID
    status: lmx_walk_eval_result(f, operand, @ result)
    c.memcpy((cast: (@: void) out), (cast: (@: void) (@ result)), c.sizeof(c.LmxWalkValue))
    return: status
end: lmx_walk_eval

fn: lmx_walk_admit (@: owner void; @@: refs void; size_t: nargs; @: dest void; @@: out void; @: lmx_call_arena c.LmxArena; @: lmx_call_code c.Lmx; @: lmx_input_values c.LmxWalkValue; @: lmx_result_context c.LmxWalkValue) int
    @: arena c.LmxArena 0
    @: model c.Lmx 0
    @: value void 0
    int: st
    \out: 0
    if: owner = 0 || refs = 0 || out = 0 || nargs != 2U
        return: 1
    ---
    arena: (cast: (@: c.LmxArena) owner)
    model: (cast: (@: c.Lmx) c.lmx_pointer_value_known(refs[1]))
    if: model = 0 || c.lmx_range_classify(arena, (cast: (@: void) model)) != c.LMX_KIND_STRUCT
        return: 1
    ---
    st: lmx_walk_admit_resolve(arena, c.lmx_pointer_value_known(refs[0]), @ value)
    if: st != 0
        return: 1
    ---
    if: value = 0
        return: 0
    ---
    return: lmx_walk_admit_against(arena, (cast: (@: c.Lmx) value), model, out)
end: lmx_walk_admit

fn: lmx_walk_admit_letter (@: owner void; @@: refs void; size_t: nargs; @: dest void; @@: out void; @: lmx_call_arena c.LmxArena; @: lmx_call_code c.Lmx; @: lmx_input_values c.LmxWalkValue; @: lmx_result_context c.LmxWalkValue) int
    @: arena c.LmxArena 0
    @: model c.Lmx 0
    @: letter c.Lmx 0
    @: value void 0
    @: payload void 0
    int: st
    \out: 0
    if: owner = 0 || refs = 0 || out = 0 || nargs != 2U
        return: 1
    ---
    arena: (cast: (@: c.LmxArena) owner)
    model: (cast: (@: c.Lmx) c.lmx_pointer_value_known(refs[1]))
    if: model = 0 || c.lmx_range_classify(arena, (cast: (@: void) model)) != c.LMX_KIND_STRUCT
        return: 1
    ---
    st: lmx_walk_admit_resolve(arena, c.lmx_pointer_value_known(refs[0]), @ value)
    if: st != 0
        return: 1
    ---
    if: value = 0
        return: 0
    ---
    letter: (cast: (@: c.Lmx) value)
    # q25 (ii): admit payload at slot 1; \out = payload (keep this line obvious if author picks (i)=\out letter).
    payload: c.lmx_graph_value_in(arena, letter, 1U)
    if: payload = 0 || c.lmx_range_classify(arena, payload) != c.LMX_KIND_STRUCT
        return: c.LMX_PRIMITIVE_THROW_IMPLEMENTS
    ---
    return: lmx_walk_admit_against(arena, (cast: (@: c.Lmx) payload), model, out)
end: lmx_walk_admit_letter

# Passive observation is a real private L2 body. The common build recipe gives
# every C unit LMX_OBSERVE_WALK=0 or1; production does not enter this body.
# Its definition is available in both variants, unlike the historical L1 ifdef.
fn: lmx_walk_observe_body (@: f c.LmxWalkFrame) int
    @: code c.Lmx 0
    @: holder c.Lmx 0
    @: fields c.VoidArray 0
    @: name c.VoidArray 0
    size_t: i 0U
    if: f != 0
        code: f\code
    if: code != 0
        holder: code\parent
    if: holder != 0
        fields: @ holder\array
    while: holder != 0 && i < fields\size && name = 0
        if: c.lmx_graph_value_in((cast: (@: c.LmxArena) f\arena), holder, i) = (cast: (@: void) code)
            name: (cast: (@: c.VoidArray) c.lmx_source_name_get((cast: (@: c.LmxArena) f\arena), (cast: (@: void) c.lmx_arena_ref_cell(holder, i))))
        i: i + 1U
    ---
    if: code != 0 && (name = 0 || name\data = 0)
        name: (cast: (@: c.VoidArray) c.lmx_source_name_get((cast: (@: c.LmxArena) f\arena), (cast: (@: void) code)))
    if: name = 0 || name\data = 0
        c.fprintf(c.stderr, "LMX_OBSERVE WALK_BODY -\n")
        return: 0
    c.fprintf(c.stderr, "LMX_OBSERVE WALK_BODY %.*s\n", (cast: (int) name\size), (cast: (@: char) name\data))
    return: 0
end: lmx_walk_observe_body

fn: lmx_walk_load_body (@: f c.LmxWalkFrame; @: body c.Lmx) int
    if: f = 0 || body = 0
        return: c.LMX_WALK_INVALID
    if: (cast: (int) c.LMX_OBSERVE_WALK) != 0
        lmx_walk_observe_body(f)
    return: lmx_walk_entry_body(f, body, 0, 1)
end: lmx_walk_load_body

# Existing host transports. Their scratch is activation-local; the inherited
# program root span remains explicit migration debt, not a new hidden context.
fn: lmx_walk_call0_dispatch (@: arena c.LmxArena; @: callable c.Lmx; @: value int) int
    c.LmxArena: sa
    c.LmxPool: cells
    c.LmxScratch: scratch
    c.LmxWalkContext: ctx
    c.LmxWalkValue: wv
    @: context c.LmxWalkContext @ ctx
    @: result c.LmxWalkValue @ wv
    int: st
    if: arena = 0 || callable = 0 || value = 0
        return: c.LMX_CALL_NOT_CALLABLE
    value[0]: 0
    c.memset((cast: (@: void) (@ sa)), 0, c.sizeof(c.LmxArena))
    c.memset((cast: (@: void) (@ cells)), 0, c.sizeof(c.LmxPool))
    c.memset((cast: (@: void) (@ scratch)), 0, c.sizeof(c.LmxScratch))
    c.memset((cast: (@: void) (@ ctx)), 0, c.sizeof(c.LmxWalkContext))
    c.memset((cast: (@: void) (@ wv)), 0, c.sizeof(c.LmxWalkValue))
    if: c.lmx_arena_open(@ sa) != 0
        return: c.LMX_CALL_NOT_CALLABLE
    if: c.lmx_scratch_open(@ scratch, @ sa, @ cells, 64U) != c.LMX_SCRATCH_OK
        c.lmx_arena_release(@ sa)
        return: c.LMX_CALL_NOT_CALLABLE
    ---
    context\arena: arena
    context\scratch: @ scratch
    context\immutable_roots: c.lmx_walk_program_roots_g
    context\immutable_root_count: c.lmx_walk_program_root_count_g
    st: lmx_walk_run(context, callable, 0, 0U, result)
    c.lmx_scratch_close(@ scratch)
    c.lmx_arena_release(@ sa)
    if: st != c.LMX_WALK_OK
        # Errors abort; a throw is returned as the selected callee's ordinal.
        if: st >= c.LMX_WALK_THROWN
            st: lmx_walk_boundary_status(arena, callable, st)
        return: c.lmx_call_note_walk_fail(st)
    ---
    if: result\present = 0
        return: 0
    if: result\kind = c.LMX_WALK_VALUE_NUMBER && result\type = c.LMX_TYPE_INT
        value[0]: result\number
    return: 0
end: lmx_walk_call0_dispatch

fn: lmx_walk_call_prim_dispatch (@: arena c.LmxArena; @: code c.Lmx; @: data c.Lmx; @@: refs void; size_t: nargs; @: dest void; @@: out void; @: lmx_input_values c.LmxWalkValue; @: lmx_result_context c.LmxWalkValue) int
    c.LmxArena: sa
    c.LmxPool: cells
    c.LmxScratch: scratch
    c.LmxWalkContext: ctx
    c.LmxWalkValue: result
    @: context c.LmxWalkContext @ ctx
    @: got c.LmxWalkValue @ result
    int: st
    int: rty 0
    size_t: wv 0U
    if: out = 0
        return: c.LMX_CALL_NOT_CALLABLE
    out[0]: 0
    if: arena = 0 || code = 0
        return: c.LMX_CALL_NOT_CALLABLE
    c.memset((cast: (@: void) (@ sa)), 0, c.sizeof(c.LmxArena))
    c.memset((cast: (@: void) (@ cells)), 0, c.sizeof(c.LmxPool))
    c.memset((cast: (@: void) (@ scratch)), 0, c.sizeof(c.LmxScratch))
    c.memset((cast: (@: void) (@ ctx)), 0, c.sizeof(c.LmxWalkContext))
    if: c.lmx_arena_open(@ sa) != 0
        return: c.LMX_CALL_NOT_CALLABLE
    if: c.lmx_scratch_open(@ scratch, @ sa, @ cells, 64U) != c.LMX_SCRATCH_OK
        c.lmx_arena_release(@ sa)
        return: c.LMX_CALL_NOT_CALLABLE
    ---
    context\arena: arena
    context\scratch: @ scratch
    context\immutable_roots: c.lmx_walk_program_roots_g
    context\immutable_root_count: c.lmx_walk_program_root_count_g
    # The call site has already selected its data. Identity does not distinguish
    # a unary call from explicit call: code code.
    st: lmx_walk_activate_values(context, code, data, refs, nargs, lmx_input_values, got)
    c.lmx_scratch_close(@ scratch)
    c.lmx_arena_release(@ sa)
    if: st = c.LMX_WALK_STOPPED
        return: 0
    if: st != c.LMX_WALK_OK
        if: st >= c.LMX_WALK_THROWN
            out[0]: got\ref
            st: lmx_walk_boundary_status(arena, code, st)
        ---
        return: c.lmx_call_note_walk_fail(st)
    ---
    # Normal completion forwards the actual Value, including zero/null and
    # absence. Inputs have already been consumed, so an aliased output is safe.
    if: lmx_result_context != 0
        c.memcpy((cast: (@: void) lmx_result_context), (cast: (const: @: void) got), c.sizeof(c.LmxWalkValue))
    if: got\present = 0
        return: 0
    if: got\kind = c.LMX_WALK_VALUE_REFERENCE
        out[0]: got\ref
        return: 0
    if: dest = 0
        return: 0
    if: lmx_walk_value_number(got, @ wv, @ rty) != c.LMX_WALK_OK
        return: c.LMX_CALL_NOT_CALLABLE
    if: lmx_walk_store_numeric_raw(dest, rty, wv) != c.LMX_WALK_OK
        return: c.LMX_CALL_NOT_CALLABLE
    out[0]: dest
    return: 0
end: lmx_walk_call_prim_dispatch

# Same inherited storage, through the existing typed-address write mechanism
# already used by Thread. No getter shim, replacement state graph or new ABI.
sub: lmx_walk_program_bind ()
    @@@: roots_cell c.Lmx (cast: (@@@: c.Lmx) (@ c.lmx_walk_program_roots_g))
    @: count_cell size_t (cast: (@: size_t) (@ c.lmx_walk_program_root_count_g))
    \roots_cell: 0
    \count_cell: 0U
end: lmx_walk_program_bind

sub: lmx_walk_program_qualify (@@: roots c.Lmx; size_t: count)
    @@@: roots_cell c.Lmx (cast: (@@@: c.Lmx) (@ c.lmx_walk_program_roots_g))
    @: count_cell size_t (cast: (@: size_t) (@ c.lmx_walk_program_root_count_g))
    \roots_cell: roots
    \count_cell: count
end: lmx_walk_program_qualify

# ---- The activation chain's resolver (slice 254, design 4.5 B1) ------------------------------------------------------
#
# A free input of the entered activation is resolved once, at its entry, from the chain of activation records
# (lmx_activation_push, lmx_call.lm2): the caller's record first -- its present inputs by the names of its callable's
# args header, then its own working cells (a native frame's registered bindings, a walker frame's work rows) -- then
# the caller's caller, up to the root.  The first binding found is copied: the value is held at the entry (book 12).
# None found: the input stays absent and the callee reads its lexical source as before.  A forwarder forms nothing:
# the name it does not consume is in no record of its own, and the climb goes past it.  Names compare by text, the
# spelling in the arena's name table (lmx_source_name_get on the input or field cell) against the spelling asked for.

# The spelling of input `k` of the callable `code` (a fn-role Structure with an args header), 0 when there is none.
fn: lmx_activation_input_cell (@: arena c.LmxArena; @: code c.Lmx; size_t: k) @@: void
    @: pool c.LmxPool 0
    @: header c.Lmx 0
    if: arena = 0 || code = 0 || c.lmx_range_classify(arena, (cast: (@: void) code)) != c.LMX_KIND_STRUCT
        return: 0
    pool: (cast: (@: c.LmxPool) c.lmx_range_cell_pool(arena, (cast: (@: void) code)))
    if: pool = 0
        return: 0
    @: fields c.VoidArray @ code\array
    # A `fn` is a FN-role Structure of four parts (header, result, vars, body: lm_compiler_fn_parts_on gives the role to `fn`
    # heads); a `sub` is an ordinary (PLAIN) Structure of three (header, vars, body), activated by the walker as its own body
    # (lmx_walk_activate_values).  The args header is part 0 of both.  Slice 258: keyed by the FN role since slice 254, a
    # sub's free input was never resolved from the chain -- it read its lexical source whatever the caller bound (the
    # fixture's `bump` wrote the unit field's copy, then dereferenced a number: INVALID).
    if: pool\role = c.LMX_POOL_ROLE_FN
        if: fields\size != 4U
            return: 0
        ---
    else:
        if: fields\size != 3U
            return: 0
        ---
    ---
    header: c.lmx_graph_ref_struct_in(arena, code, c.lmx_implements_exec_index(arena, code, 0U))
    size_t: width 0U
    if: header = 0 || c.lmx_callable_source_count(arena, header, @ width) != 0 || k >= width
        return: 0
    return: c.lmx_graph_ref_cell_in(arena, header, c.lmx_implements_exec_index(arena, header, k))
end: lmx_activation_input_cell

fn: lmx_activation_input_name (@: arena c.LmxArena; @: code c.Lmx; size_t: k) @: c.VoidArray
    @: input c.VoidArray c.lmx_source_name_get_at(arena, (cast: (@: void) code), k + 1U)
    if: input != 0
        return: input
    @@: cell void lmx_activation_input_cell(arena, code, k)
    if: cell = 0
        return: 0
    return: (cast: (@: c.VoidArray) c.lmx_source_name_get(arena, (cast: (@: void) cell)))
end: lmx_activation_input_name

fn: lmx_activation_name_is (@: name c.VoidArray; @: text void; size_t: len) int
    if: name = 0 || name\data = 0 || text = 0 || name\size != len
        return: 0
    return: (cast: (int) (c.memcmp((cast: (const: @: void) name\data), (cast: (const: @: void) text), len) = 0))
end: lmx_activation_name_is

# A written formal of the callable, told from a free (hidden) input by its args header entry: the emitter gives a
# written formal an entry of four fields (source, current default, receiving record, role -- lmx_walk_current_default
# reads the default of such an entry) and a hidden input an entry of two (the witness alone; lm_compiler_rw_header_parts,
# lm_compiler_rw_signature_witness).  1 a formal, 0 a free input or no entry.
fn: lmx_activation_input_formal (@: arena c.LmxArena; @: code c.Lmx; size_t: k) int
    if: c.lmx_source_name_get_at(arena, (cast: (@: void) code), k + 1U) != 0
        return: 0
    @@: cell void lmx_activation_input_cell(arena, code, k)
    if: cell = 0
        return: 0
    @: entry c.Lmx c.lmx_graph_node_in(arena, cell[0])
    if: entry = 0
        return: 0
    @: fields c.VoidArray @ entry\array
    return: (cast: (int) (fields\size = 4U))
end: lmx_activation_input_formal

# The present inputs of one record by name: its written formals (want_formal 1) or the free inputs it inherited (0).
# 1 found (copied into `out`), 0 not.
fn: lmx_activation_inputs_find (@: arena c.LmxArena; @: record c.LmxActivation; int: want_formal; @: text void; size_t: len; @: out c.LmxWalkValue) int
    @: values c.LmxWalkValue 0
    @: item c.LmxWalkValue 0
    @: name c.VoidArray 0
    @: code c.Lmx 0
    size_t: i 0U
    values: (cast: (@: c.LmxWalkValue) record\values)
    if: values = 0
        return: 0
    code: record\code
    while: i < record\width
        item: values + i
        if: item\present != 0 && lmx_activation_input_formal(arena, code, i) = want_formal
            name: lmx_activation_input_name(arena, code, i)
            if: lmx_activation_name_is(name, text, len) != 0
                c.memcpy((cast: (@: void) out), (cast: (@: void) item), c.sizeof(c.LmxWalkValue))
                return: 1
            ---
        ---
        i: i + 1U
    ---
    return: 0
end: lmx_activation_inputs_find

# One record, in the book's order (:729/:779): the activation's current local bindings first -- its written formals,
# then its own working cells (a native frame's registered bindings; a walker frame's rows, loaded for the fields its
# body uses at the entry, lmx_walk_load_body) -- then the free inputs it inherited.  A field of the data node the
# activation holds no working cell of is no binding.  1 found (copied into `out`), 0 not.
fn: lmx_activation_record_find (@: arena c.LmxArena; @: record c.LmxActivation; @: text void; size_t: len; @: out c.LmxWalkValue) int
    @: name c.VoidArray 0
    @: binding c.LmxActivationBinding 0
    @: bound c.LmxWalkValue 0
    @: storage void 0
    @: frame c.LmxWalkFrame 0
    @: row c.LmxWalkWork 0
    @: work_value c.LmxWalkValue 0
    @: slot_cell void 0
    @@: slot_cells void 0
    size_t: i 0U
    int: type 0
    int: status 0
    if: arena = 0 || record = 0 || out = 0
        return: 0
    if: lmx_activation_inputs_find(arena, record, 1, text, len, out) != 0
        return: 1
    if: record\kind = 2
        while: i < record\nbind
            binding: record\bindings + i
            if: binding\length = len && c.memcmp((cast: (const: @: void) binding\name), (cast: (const: @: void) text), len) = 0
                bound: (cast: (@: c.LmxWalkValue) binding\value)
                if: bound != 0
                    c.memcpy((cast: (@: void) out), (cast: (@: void) bound), c.sizeof(c.LmxWalkValue))
                    return: (cast: (int) (out\present != 0))
                storage: binding\storage
                type: binding\type
                status: lmx_walk_value_load(arena, storage, type, out)
                return: (cast: (int) (status = c.LMX_WALK_OK && out\present != 0))
            ---
            i: i + 1U
        ---
    else:
        frame: (cast: (@: c.LmxWalkFrame) record\frame)
        if: frame != 0
            row: (cast: (@: c.LmxWalkWork) frame\work)
            while: row != 0
                slot_cell: (cast: (@: void) row\slot)
                name: (cast: (@: c.VoidArray) c.lmx_source_name_get(arena, slot_cell))
                # A walked program names the field's value storage (the cell's content), the emitter the cell.
                if: name = 0 && row\slot != 0
                    slot_cells: row\slot
                    name: (cast: (@: c.VoidArray) c.lmx_source_name_get(arena, slot_cells[0]))
                ---
                work_value: @ row\value
                if: lmx_activation_name_is(name, text, len) != 0 && work_value\present != 0
                    c.memcpy((cast: (@: void) out), (cast: (@: void) work_value), c.sizeof(c.LmxWalkValue))
                    return: 1
                ---
                row: (cast: (@: c.LmxWalkWork) row\next)
            ---
        ---
    ---
    return: lmx_activation_inputs_find(arena, record, 0, text, len, out)
end: lmx_activation_record_find

# The chain from `from` upward; 1 found (the value in `out`), 0 none.
fn: lmx_activation_resolve (@: arena c.LmxArena; @: from c.LmxActivation; @: text void; size_t: len; @: out c.LmxWalkValue) int
    @: record c.LmxActivation from
    @: parent c.LmxActivation 0
    if: arena = 0 || text = 0 || len = 0U || out = 0
        return: 0
    lmx_walk_value_clear(out)
    while: record != 0
        if: lmx_activation_record_find(arena, record, text, len, out) != 0
            return: 1
        parent: record\parent
        record: parent
    ---
    return: 0
end: lmx_activation_resolve

# The caller's mark on an input it does not form (slice 254, design 4.5 B1): absent, kind LMX_WALK_VALUE_FREE, to be
# resolved once at the callee's entry (lmx_activation_resolve_input).  The emitters print it at a call site.
fn: lmx_walk_value_free_mark (@: value c.LmxWalkValue) void
    if: value = 0
        return
    lmx_walk_value_clear(value)
    value\kind: c.LMX_WALK_VALUE_FREE
    return
end: lmx_walk_value_free_mark

# The reached held adapter has already selected its callable. Decode its
# actual header coordinate before consuming a numeric capture candidate.
# target remains zero for a completed receive or a nonnumeric capture.
fn: lmx_walk_held_capture (@: arena c.LmxArena; @: code c.Lmx; size_t: k; @: item c.LmxWalkValue; @: target int) int
    @: source void 0
    @: witness void 0
    if: arena = 0 || code = 0 || item = 0 || target = 0
        return: c.LMX_WALK_INVALID
    target[0]: 0
    @: header c.Lmx c.lmx_graph_ref_struct_in(arena, code, c.lmx_implements_exec_index(arena, code, 0U))
    if: header = 0 || c.lmx_callable_source_entry(arena, header, k, @ source, @ witness) != 0
        return: c.LMX_WALK_INVALID
    size_t: slot c.lmx_implements_exec_index(arena, header, k)
    @: entry c.Lmx c.lmx_graph_ref_struct_in(arena, header, slot)
    if: entry = 0
        return: c.LMX_WALK_INVALID
    @: fields c.VoidArray @ entry\array
    if: fields\size != 2U && fields\size != 3U
        return: c.LMX_WALK_OK
    int: ty lmx_walk_numeric_type(arena, witness)
    if: ty = 0 && fields\size = 2U
        return: c.LMX_WALK_OK
    if: item\present = 0 && item\kind = c.LMX_WALK_VALUE_FREE
        @: cell void (cast: (@: void) c.lmx_graph_ref_cell_in(arena, header, slot))
        @: name c.VoidArray (cast: (@: c.VoidArray) c.lmx_source_name_get(arena, cell))
        if: name = 0 || name\data = 0
            return: c.LMX_WALK_INVALID
        @: spelling void name\data
        size_t: len name\size
        if: lmx_activation_resolve(arena, (cast: (@: c.LmxActivation) arena\activation), spelling, len, item) = 0
            item\kind: c.LMX_WALK_VALUE_MISSING
        ---
    ---
    if: item\present = 0
        return: c.LMX_WALK_OK
    if: fields\size = 3U
        @: admission c.Lmx c.lmx_graph_ref_struct_in(arena, entry, 2U)
        @: model c.Lmx 0
        if: admission = 0
            return: c.LMX_WALK_INVALID
        @: record c.Lmx c.lmx_graph_ref_struct_in(arena, admission, 1U)
        @: operand void c.lmx_graph_value_in(arena, admission, 4U)
        int: received lmx_walk_value_receive_graph(arena, item, item)
        if: received != c.LMX_WALK_OK
            return: received
        received: lmx_walk_receiving_model(arena, code, lmx_call_unary_data(arena, code), operand, @ model)
        if: received != c.LMX_WALK_OK
            return: received
        received: lmx_walk_value_admit(arena, item, model, record)
        if: received != c.LMX_WALK_OK
            return: received
        # The admitted graph reference now occupies the selected capture's
        # physical pointer cell. Its model and correspondence travel with it.
        item\type: lmx_walk_witness_type(arena, witness)
        return: c.LMX_WALK_OK
    ---
    if: item\kind != c.LMX_WALK_VALUE_NUMBER
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    int: status lmx_walk_value_receive(item, ty, item)
    if: status = c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
        target[0]: c.lmx_type_base(ty)
        return: c.LMX_WALK_OK
    return: status
end: lmx_walk_held_capture

# The complete input vector is sized by the reached callable's own header.
# The single-row case uses storage provided by this stack frame.
fn: lmx_walk_call_rows (@: arena c.LmxArena; @: code c.Lmx; @@: source_refs void; @: supplied c.LmxWalkValue; size_t: written; @: rows c.LmxCallInputRows) int
    @: source void 0
    @: witness void 0
    size_t: width 0U
    size_t: i 0U
    int: status c.LMX_WALK_OK
    c.memset((cast: (@: void) rows), 0, c.sizeof(c.LmxCallInputRows))
    @: args c.Lmx c.lmx_graph_ref_struct_in(arena, code, c.lmx_implements_exec_index(arena, code, 0U))
    if: args = 0 || c.lmx_callable_source_count(arena, args, @ width) != 0
        return: c.LMX_WALK_INVALID
    if: written > width
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_IMPLEMENTS
    if: written != 0U && source_refs = 0
        return: c.LMX_WALK_INVALID
    @: values c.LmxWalkValue @ rows\first_value
    @@: refs void (cast: (@@: void) (@ rows\first_ref))
    if: width > 1U
        if: width > (cast: (size_t) -1) / c.sizeof(c.LmxWalkValue) || width > (cast: (size_t) -1) / sizeof(@: void)
            return: c.LMX_WALK_NOMEM
        values: (cast: (@: c.LmxWalkValue) c.calloc(width, c.sizeof(c.LmxWalkValue)))
        refs: (cast: (@@: void) c.calloc(width, sizeof(@: void)))
        if: values = 0 || refs = 0
            c.free((cast: (@: void) refs))
            c.free((cast: (@: void) values))
            return: c.LMX_WALK_NOMEM
        ---
    ---
    rows\count: width
    rows\values: values
    rows\refs: refs
    if: supplied != 0
        status: lmx_walk_values_project(supplied, source_refs, written, 0U, values, refs, width)
    ---
    while: status = c.LMX_WALK_OK && i < width
        @: item c.LmxWalkValue (values + i)
        if: lmx_activation_input_formal(arena, code, i) = 0
            if: i < written
                return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_IMPLEMENTS
            lmx_walk_value_free_mark(item)
        else:
            if: i < written && supplied = 0 && source_refs[i] != 0
                if: c.lmx_callable_source_entry(arena, args, i, @ source, @ witness) != 0
                    return: c.LMX_WALK_INVALID
                status: lmx_walk_value_load(arena, source_refs[i], lmx_walk_witness_type(arena, witness), item)
                refs[i]: lmx_walk_value_storage(item)
            ---
        ---
        i: i + 1U
    ---
    return: status
end: lmx_walk_call_rows

sub: lmx_walk_call_rows_close (@: rows c.LmxCallInputRows)
    if: rows\count > 1U
        c.free((cast: (@: void) rows\refs))
        c.free((cast: (@: void) rows\values))
    ---
    return
end: lmx_walk_call_rows_close

# A Structure call has already selected its code and data. Both executors
# admit the same current signature and explicit throws before dispatch.
fn: lmx_call_selected_structure (@: arena c.LmxArena; @: frame c.LmxWalkFrame; @: caller c.Lmx; @: operation c.Lmx; @: code c.Lmx; @: data c.Lmx; @: out c.LmxWalkValue) int
    c.LmxWalkValue: temp
    if: arena = 0 || out = 0
        return: c.LMX_WALK_INVALID
    lmx_walk_value_clear(out)
    if: code = 0 || (data = 0 && operation != 0 && c.lmx_graph_value_in(arena, operation, 1U) != 0)
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER
    if: c.lmx_graph_node_in(arena, (cast: (@: void) code)) = 0 || (data != 0 && c.lmx_graph_node_in(arena, (cast: (@: void) data)) = 0)
        return: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_IMPLEMENTS
    int: status lmx_call_obligation(arena, code, caller, operation)
    if: status != c.LMX_WALK_OK
        return: status
    c.LmxCallInputRows: input_rows
    @: rows c.LmxCallInputRows @ input_rows
    c.memset((cast: (@: void) rows), 0, c.sizeof(c.LmxCallInputRows))
    @: witness void 0
    @: pool c.LmxPool c.lmx_range_cell_pool(arena, (cast: (@: void) code))
    if: pool != 0 && pool\role = c.LMX_POOL_ROLE_FN
        @: args c.Lmx 0
        @: returns c.Lmx 0
        int: answer c.LMX_IMPLEMENTS_UNKNOWN
        status: c.lmx_callable_headers(arena, code, @ args, @ returns, @ answer)
        if: status != c.LMX_WALK_OK
            return: status
        if: answer != c.LMX_IMPLEMENTS_YES
            return: c.LMX_WALK_UNSUPPORTED
        size_t: nr 0U
        @: source void 0
        if: c.lmx_callable_source_count(arena, returns, @ nr) != 0 || nr > 1U
            return: c.LMX_WALK_INVALID
        if: nr = 1U && c.lmx_callable_source_entry(arena, returns, 0U, @ source, @ witness) != 0
            return: c.LMX_WALK_INVALID
        status: lmx_walk_call_rows(arena, code, 0, 0, 0U, rows)
        size_t: i 0U
        while: status = c.LMX_WALK_OK && i < rows\count
            @: item c.LmxWalkValue (rows\values + i)
            if: lmx_activation_input_formal(arena, code, i) != 0
                status: lmx_walk_current_default(arena, args, i, item)
                if: status = c.LMX_WALK_OK && item\present = 0
                    status: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_IMPLEMENTS
                ---
                @: expected void 0
                if: status = c.LMX_WALK_OK && c.lmx_callable_source_entry(arena, args, i, @ source, @ expected) != 0
                    status: c.LMX_WALK_INVALID
                if: status = c.LMX_WALK_OK
                    int: numeric lmx_walk_numeric_type(arena, expected)
                    if: numeric != 0
                        status: lmx_walk_value_receive(item, numeric, item)
                    ---
                ---
                if: status = c.LMX_WALK_OK
                    status: lmx_walk_argument_storage(arena, item, expected, 0, code)
                rows\refs[i]: lmx_walk_value_storage(item)
            ---
            i: i + 1U
        ---
    ---
    c.LmxCallPlaces: place_scope
    int: opened 0
    if: status = c.LMX_WALK_OK
        int: place_answer c.LMX_IMPLEMENTS_UNKNOWN
        status: c.lmx_implements_call_places_open(arena, code, data, @ place_scope, @ place_answer)
        if: status = c.LMX_WALK_OK
            if: place_answer = c.LMX_IMPLEMENTS_YES
                opened: 1
            else:
                status: c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CALL
            ---
        ---
    ---
    if: status = c.LMX_WALK_OK
        @@: refs void (cast: (@@: void) rows\refs)
        @: values c.LmxWalkValue (cast: (@: c.LmxWalkValue) rows\values)
        size_t: count (cast: (size_t) rows\count)
        if: frame != 0
            status: lmx_walk_dispatch_values(frame, operation, code, data, refs, count, values, witness, 1, out)
        else:
            @: raw void 0
            @: dest void lmx_walk_result_dest(arena, witness, @ temp)
            int: said c.lmx_call_prim_values(arena, code, data, refs, count, dest, @ raw, values, 0)
            if: said != 0
                size_t: key 0U
                status: lmx_walk_key_from_ordinal(arena, code, (cast: (size_t) said), @ key)
                if: status = c.LMX_WALK_OK
                    status: c.LMX_WALK_THROWN + (cast: (int) key)
                    lmx_walk_value_ref(out, c.LMX_TYPE_LMX, raw)
                ---
            ---
        ---
    ---
    if: opened != 0
        c.lmx_implements_call_places_close(arena, @ place_scope)
    lmx_walk_call_rows_close(rows)
    if: status = c.LMX_WALK_OK
        lmx_walk_value_clear(out)
    return: status
end: lmx_call_selected_structure

# Invoke the receiver selected by the program's ordinary conversion row.
# The source and result both travel as full Values. A failed conversion
# does not write the argument cell. Only the slow path needs extra rows.
fn: lmx_walk_convert_capture (@: arena c.LmxArena; @: receiver c.Lmx; @: item c.LmxWalkValue; int: target) int
    int: refusal c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CONVERT
    @: source void 0
    @: witness void 0
    @: returned void 0
    c.LmxWalkValue: got
    size_t: width 0U
    if: arena = 0 || item = 0 || item\present = 0
        return: c.LMX_WALK_INVALID
    if: receiver = 0 || c.lmx_call_ready(arena, receiver) != c.LMX_CALL_OK
        return: refusal
    @: args c.Lmx c.lmx_graph_ref_struct_in(arena, receiver, c.lmx_implements_exec_index(arena, receiver, 0U))
    @: returns c.Lmx c.lmx_graph_ref_struct_in(arena, receiver, c.lmx_implements_exec_index(arena, receiver, 1U))
    if: args = 0 || returns = 0 || c.lmx_callable_source_count(arena, args, @ width) != 0 || width = 0U
        return: refusal
    if: c.lmx_callable_source_entry(arena, args, 0U, @ source, @ witness) != 0 || c.lmx_type_base(lmx_walk_numeric_type(arena, witness)) != c.lmx_type_base(item\type)
        return: refusal
    if: lmx_activation_input_formal(arena, receiver, 0U) = 0 || c.lmx_callable_source_entry(arena, returns, 0U, @ source, @ witness) != 0 || c.lmx_type_base(lmx_walk_numeric_type(arena, witness)) != target
        return: refusal
    size_t: k 1U
    while: k < width
        if: lmx_activation_input_formal(arena, receiver, k) != 0
            return: refusal
        k: k + 1U
    ---
    @: ref void lmx_walk_value_storage(item)
    c.LmxCallInputRows: input_rows
    @: rows c.LmxCallInputRows @ input_rows
    int: status lmx_walk_call_rows(arena, receiver, @ ref, item, 1U, rows)
    if: status = c.LMX_WALK_OK
        lmx_walk_value_clear(@ got)
        if: c.lmx_call_prim_values(arena, receiver, c.lmx_call_unary_data(arena, receiver), (cast: (@@: void) rows\refs), (cast: (size_t) rows\count), 0, @ returned, (cast: (@: c.LmxWalkValue) rows\values), @ got) != 0
            status: refusal
        else:
            if: c.lmx_msg_poll_escape() != 0
                status: c.LMX_WALK_STOPPED
            else:
                @: result c.LmxWalkValue @ got
                if: result\present = 0 || result\kind != c.LMX_WALK_VALUE_NUMBER
                    status: refusal
                else:
                    status: lmx_walk_value_receive(result, target, item)
                ---
            ---
        ---
    ---
    lmx_walk_call_rows_close(rows)
    return: status
end: lmx_walk_convert_capture

# A walked held-call primitive uses the same lexical coordinate as its
# native caller. The adapter signature stores only the number of links.
fn: lmx_walk_capture_scope (@: arena c.LmxArena; @: operation c.Lmx) @: c.Lmx
    if: arena = 0 || operation = 0
        return: 0
    @: record c.LmxPrimitive (cast: (@: c.LmxPrimitive) c.lmx_graph_value_in(arena, operation, 1U))
    @: act c.LmxActivation (cast: (@: c.LmxActivation) arena\activation)
    if: record = 0 || act = 0 || act\code != operation || act\parent = 0
        return: 0
    @: parent c.LmxActivation act\parent
    @: scope c.Lmx parent\code
    size_t: depth 0U
    if: lmx_walk_load_numeric(arena, c.lmx_graph_value_in(arena, (cast: (@: c.Lmx) record\signature), 2U), @ depth) != c.LMX_WALK_OK
        return: 0
    while: scope != 0 && depth != 0U
        scope: scope\parent
        depth: depth - 1U
    return: scope
end: lmx_walk_capture_scope

# A held call supplies its written actuals. The selected executable's
# header supplies its own free names, witnesses, and receiving operations.
fn: lmx_walk_call_held_values (@: arena c.LmxArena; @: code c.Lmx; @@: source_refs void; @: supplied c.LmxWalkValue; size_t: written; @: dest void; @@: out void; @: result c.LmxWalkValue; @: scope c.Lmx; @: operation c.Lmx; c.LmxWalkConvertLookup: lookup) int
    c.LmxCallInputRows: input_rows
    @: rows c.LmxCallInputRows @ input_rows
    size_t: i written
    int: said 0
    int: status lmx_walk_call_rows(arena, code, source_refs, supplied, written, rows)
    out[0]: 0
    @: values c.LmxWalkValue (cast: (@: c.LmxWalkValue) rows\values)
    @@: refs void (cast: (@@: void) rows\refs)
    while: status = c.LMX_WALK_OK && i < rows\count
        @: item c.LmxWalkValue (values + i)
        int: target 0
        status: lmx_walk_held_capture(arena, code, i, item, @ target)
        if: status = c.LMX_WALK_OK && target != 0
            if: scope = 0 && operation != 0
                scope: lmx_walk_capture_scope(arena, operation)
            ---
            int: src c.lmx_type_base(item\type)
            @: receiver c.Lmx 0
            if: lookup != 0
                receiver: lookup(scope, src, target)
            status: lmx_walk_convert_capture(arena, receiver, item, target)
        ---
        refs[i]: lmx_walk_value_storage(item)
        i: i + 1U
    ---
    if: status = c.LMX_WALK_OK
        size_t: width rows\count
        said: c.lmx_call_prim_values(arena, code, lmx_call_unary_data(arena, code), refs, width, dest, out, values, result)
    ---
    lmx_walk_call_rows_close(rows)
    if: status = c.LMX_WALK_STOPPED || c.lmx_msg_poll_escape() != 0
        out[0]: 0
        return: 0
    if: status != c.LMX_WALK_OK
        return: c.lmx_call_note_walk_fail(lmx_walk_boundary_status(arena, code, status))
    if: said = 0
        out[0]: dest
    return: said
end: lmx_walk_call_held_values

# Input `k` of the current activation, marked free by its caller (LMX_WALK_VALUE_FREE), resolved from the caller's
# record upward and written into the activation's input records (value and storage); an unresolved one becomes an
# ordinary absent input, which the callee reads by its lexical source as before.  1 resolved, 0 absent.
fn: lmx_activation_resolve_input (@: arena c.LmxArena; size_t: k; @@: refs void; @: values c.LmxWalkValue; size_t: width; @: data c.Lmx) int
    @: record c.LmxActivation 0
    @: parent c.LmxActivation 0
    @: code c.Lmx 0
    @: name c.VoidArray 0
    @: item c.LmxWalkValue 0
    @: text void 0
    size_t: len 0U
    if: arena = 0
        return: 0
    record: (cast: (@: c.LmxActivation) arena\activation)
    if: record = 0
        return: 0
    # The native entry receives into arrays of its own declared width (the generated trampoline wrapper projects the
    # caller's): those are the activation's inputs from here on -- for this resolution and for the callees' lookups.
    if: values != 0
        record\values: (cast: (@: void) values)
        record\refs: refs
        record\width: width
    ---
    if: record\values = 0 || k >= record\width
        return: 0
    values: (cast: (@: c.LmxWalkValue) record\values)
    item: values + k
    if: item\kind != c.LMX_WALK_VALUE_FREE || item\present != 0
        return: (cast: (int) (item\present != 0))
    code: record\code
    name: lmx_activation_input_name(arena, code, k)
    if: name = 0 || name\data = 0
        lmx_walk_value_clear(item)
        return: 0
    text: name\data
    len: name\size
    # The reserved data reference starts in this activation's ordinary
    # local input cell. It is not a lookup of the caller's same-named input
    # or a field of the selected data. Written formals keep their contract.
    if: lmx_activation_input_formal(arena, code, k) = 0 && lmx_activation_name_is(name, (cast: (@: void) "var"), 3U) != 0
        lmx_walk_value_ref(item, c.LMX_TYPE_LMX, (cast: (@: void) data))
    else:
        parent: record\parent
        if: lmx_activation_resolve(arena, parent, text, len, item) = 0
            lmx_walk_value_free_mark(item)
            return: 0
        ---
    ---
    @@: out_refs void (cast: (@@: void) record\refs)
    if: out_refs != 0
        out_refs[k]: lmx_walk_value_storage(item)
    ---
    return: 1
end: lmx_activation_resolve_input
