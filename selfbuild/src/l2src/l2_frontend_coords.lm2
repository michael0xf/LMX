    while: i < rb_n_cell[0]
        if: rb_at_cell[0][i] = stmt
            return: (cast: (int) (rb_meth_cell[0][i]))
        i: i + 1
    ---
    return: (cast: (int) (-1))
end: lm_compiler_rb_meth_of

