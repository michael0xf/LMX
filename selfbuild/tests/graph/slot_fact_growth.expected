    Grid: A A A A A A A A A A A A
    int: j 41
    @: p int (@ j)
    int: i 0
    int: sum 0
    int: last 0
    int: count 0
)
    while: (i < 12) ((:= (Grid [] i) B) (:= i (i + 1)))
    :=: i 0
    while: (i < 12) ((:= (Grid [] i) (@ j)) (:= p (Grid [] i)) (:= (data \ sum) ((data \ sum) + (\ p))) (:= i (i + 1)))
    :=: (Grid [] 11) C
    :=: (data \ last) (length (Grid [] 11))
    :=: (data \ count) (length Grid)
