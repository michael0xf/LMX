+        return: c.LMX_IMPLEMENTS_UNKNOWN
+    if: source_context != 0
+        context: lmx_graph_node_in(arena, (cast: (@: void) source_context))
+        if: context = 0 || context\array.size != 2U
+            return: c.LMX_IMPLEMENTS_UNKNOWN
