# An inline if body creates no separate name scope. Its declaration of x
# selects the same activation's data place, visible after the if when taken.
# A branch not taken performs no assignment. The method's published x
# persists across these two calls: br(3, 1) is 1313 and br(3, 0) is 1300.
fn: br (int: x; int: go) int
    int: inner 0
    if: go != 0
        int: x
        x: x + 10
        inner: x
    return: x * 100 + inner
end: br
int: a 0
int: b 0
a: br(3, 1)
b: br(3, 0)
int: ok 64
if: a = 1313 && b = 1300
    ok: 7
if: a = 313
    ok: 65
if: b = 0
    ok: 66
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
