# Two distinct fields select their actual source cells, not declaration-prefix slots.
Repeated: (int: xFirst 1; int: xLast 7; xLast: 2)
if: Repeated\xFirst != 1 || Repeated\xLast != 7
    sendMessage: exit(exit_code: 91; stdout: ""; stderr: "")
    return
call: Repeated
if: Repeated\xFirst != 1 || Repeated\xLast != 2
    sendMessage: exit(exit_code: 92; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
