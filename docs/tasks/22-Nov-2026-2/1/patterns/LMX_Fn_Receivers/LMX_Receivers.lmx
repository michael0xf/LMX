        private: @: removed FxSeqSlice\slice(target; begin; end)
        # The common replacement path prepares all inserted values before
        # commit, including values = target and other overlapping sources.
        # Failure during preparation leaves target's contents unchanged.
        FxSeqReplaceRange\replaceRange(target; begin; end; values)
        return: removed

FxSeqAppend:
    private:
        @: target
        @: values
    required: target values
    return: @
    append:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceElement
            SequenceSize
        FxSeqInfo\get(target)
        private: int: end length(target)
        return: FxSeqReplaceRange\replaceRange(target; end; end; values)

FxSeqInsert:
    private:
        @: target
        int: position
        @: values
    required: target position values
    return: @
    insert:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceElement
            SequenceSize
        return: FxSeqReplaceRange\replaceRange(target; position; position; values)

FxSeqDeleteAt:
    private:
        @: target
        int: begin
        int: end
    required: target begin end
    return: @
    deleteAt:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceElement
            SequenceSize
        private: @: empty FxSeqAllocate\make(@[]; 0)
        return: FxSeqReplaceRange\replaceRange(target; begin; end; empty)

# SOURCE: src/collections.lmx
# UNIVERSAL SEQUENTIAL COLLECTIONS.
# items/source/rows are direct @ references to any admitted Array: dense T[]
# or the ordinary Structure/@[]. FxSeqRead uses the actual layout, never void**
# reinterpretation. One selected element is one prepared actual, including a
# whole Structure. Callbacks retain their own defaults, required/private and R.
# Calls are ordered in one Message. A callback must not change source slots or
# length. Result construction does not execute code fields or alter parent.

FxMap:
    private:
        @: items
        @: transform
    required: items transform
    return: @
    map:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        FxSeqInfo\get(items)
        private: int: count length(items)
        private: @: result FxSeqAllocate\make(@[]; count)
        private: int: i 0
        while: i < count
            private: @: item FxSeqRead\read(items; i)
            result[i] := FxApply\apply(transform; FxOne\make(item))
            i += 1
        return: result

FxFilter:
    private:
        @: items
        @: accepts
    required: items accepts
    return: @
    filter:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxSeqInfo\get(items)
        private: int: count length(items)
        private: @: result FxSeqAllocate\make(info\arrayType; count)
        private: int: used 0
        private: int: i 0
        while: i < count
            private: @: item FxSeqRead\read(items; i)
            private: @: flagRecord FxApply\apply(accepts; FxOne\make(item))
            # Keep filter's established ordinary int-result admission channel.
            private: int: flag \flagRecord
            if: flag != 0
                FxKernel\arrayWrite(target := result; index := used; value := item)
                used += 1
            i += 1
        sys\resize(result; used)
        return: result

FxFold:
    private:
        @: items
        @: seed
        @: step
    required: items seed step
    return: @
    fold:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
        FxSeqInfo\get(items)
        private: int: count length(items)
        private: @: accumulator seed
        private: int: i 0
        while: i < count
            private: @: item FxSeqRead\read(items; i)
            accumulator := FxApply\apply(step; FxTwo\make(accumulator; item))
            i += 1
        return: accumulator

FxPair:
    @: first 0
    @: second 0

FxZip:
    private:
        @: first
        @: second
    required: first second
    return: @
    zip:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        FxSeqInfo\get(first)
        FxSeqInfo\get(second)
        private: int: count length(first)
        if: length(second) < count
            count := length(second)
        private: @: result FxSeqAllocate\make(@[]; count)
        private: int: i 0
        while: i < count
            private: @: pair (copy(FxPair))
            pair\first := FxSeqRead\read(first; i)
            pair\second := FxSeqRead\read(second; i)
            result[i] := pair
            i += 1
        return: result

FxZipWith:
    private:
        @: first
        @: second
        @: combine
    required: first second combine
    return: @
    zipWith:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        FxSeqInfo\get(first)
        FxSeqInfo\get(second)
        private: int: count length(first)
        if: length(second) < count
            count := length(second)
        private: @: result FxSeqAllocate\make(@[]; count)
        private: int: i 0
        while: i < count
            private: @: leftValue FxSeqRead\read(first; i)
            private: @: rightValue FxSeqRead\read(second; i)
            result[i] := FxApply\apply(combine; FxTwo\make(leftValue; rightValue))
            i += 1
        return: result

FxScan:
    private:
        @: items
        @: seed
        @: step
    required: items seed step
    return: @
    scan:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        FxSeqInfo\get(items)
        private: int: count length(items)
        private: @: result FxSeqAllocate\make(@[]; 0)
        private: @: info FxSeqInfo\get(result)
        private: int: total FxSeqSize\sum(count; 1; info\maxLength)
        sys\resize(result; total)
        private: @: accumulator seed
        result[0] := accumulator
        private: int: i 0
        while: i < count
            private: @: item FxSeqRead\read(items; i)
            accumulator := FxApply\apply(step; FxTwo\make(accumulator; item))
            result[i + 1] := accumulator
            i += 1
        return: result

FxTraverse:
    private:
        @: items
        @: next
    required: items next
    return: @
    traverse:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        FxSeqInfo\get(items)
        private: int: count length(items)
        private: @: result FxSeqAllocate\make(@[]; count)
        private: int: i 0
        while: i < count
            private: @: item FxSeqRead\read(items; i)
            private: @: record FxApply\apply(next; FxOne\make(item))
            private: FxMaybe@: answer record
            if: answer\present = 0
                return: answer
            result[i] := answer\value
            i += 1
        return: FxSome\some(value := result)

# Rectangularity is checked before columns are constructed. Each selected row
# is one sequence value; dense and reference rows can be freely mixed.
FxTranspose:
    private: @: rows
    required: rows
    return: @
    transpose:
        throws:
            FxKernelFailure
            FxShape
            FxTypeToken
            ReceiverIndex
            SequenceSize
        FxSeqInfo\get(rows)
        private: int: height length(rows)
        private: @: result FxSeqAllocate\make(@[]; 0)
        if: height = 0
            return: result
        private: @: first FxSeqRead\read(rows; 0)
        FxSeqInfo\get(first)
        private: int: width length(first)
        private: int: i 0
        while: i < height
            private: @: row FxSeqRead\read(rows; i)
            FxSeqInfo\get(row)
            if: length(row) != width
                throw: FxShape()
            i += 1
        private: @: resultInfo FxSeqInfo\get(result)
        FxSeqSize\sum(0; width; resultInfo\maxLength)
        sys\resize(result; width)
        private: int: j 0
        while: j < width
            private: @: column FxSeqAllocate\make(@[]; height)
            i := 0
            while: i < height
                private: @: row FxSeqRead\read(rows; i)
                column[i] := FxSeqRead\read(row; j)
                i += 1
            result[j] := column
            j += 1
        return: result

FxGroup:
    @: key 0
    @: items 0

FxGroupBy:
    private:
        @: items
        @: keyOf
        @: sameKey
    required: items keyOf sameKey
    return: @
    groupBy:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceElement
            SequenceSize
        FxSeqInfo\get(items)
        private: int: count length(items)
        private: @: result FxSeqAllocate\make(@[]; 0)
        private: int: i 0
        while: i < count
            private: @: item FxSeqRead\read(items; i)
            private: @: key FxApply\apply(keyOf; FxOne\make(item))
            private: @: group 0
            private: int: j 0
            while: j < length(result)
                private: FxGroup@: candidate result[j]
                private: @: flagRecord FxApply\apply(sameKey; FxTwo\make(candidate\key; key))
                private: int: flag \flagRecord
                if: flag != 0
                    group := candidate
                    break
                j += 1
            if: group = 0
                group := (copy(FxGroup))
                group\key := key
                group\items := FxSeqAllocate\make(@[]; 0)
                FxSeqPush\append(result; group)
            FxSeqPush\append(group\items; item)
            i += 1
        return: result

# SOURCE: src/structures.lmx
# UNIVERSAL SELECTION COMPATIBILITY PATHS.
# The previous internal names delegate to the shared dense/Structure algorithms.
# Historical procedural bodies are preserved under reference/pre_sequence_fix/.

RxSelect:
    private:
        @: source
        @: indices
    required: source indices
    return: @
    select:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        return: FxSeqSelect\select(source; indices)

RxOmit:
    private:
        @: source
        @: indices
    required: source indices
    return: @
    omit:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        return: FxSeqOmit\omit(source; indices)

RxReorder:
    private:
        @: source
        @: permutation
    required: source permutation
    return: @
    reorder:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            ReceiverPermutation
            SequenceSize
        return: FxSeqReorder\reorder(source; permutation)

RxProject:
    private:
        @: source
        @: indices
    required: source indices
    return: @
    project:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        return: FxSeqProject\project(source; indices)

# defaults(source; fallback): composition whose fallback defines the model.
# A compatible source field wins, including 0 and uninit:T. This does not fill
# uninit, and output ordering is the model order followed by unmatched fields.
RxDefaults:
    @: source
    @: fallback
    return: @
    defaults:
        return: (merge(fallback; source))

# derive(base; extension): обычная композиция с моделью base.
# Совпавшие поля заменяются в слотах модели; новые добавляются в конце.
# Это именованный ядерный вызов существующего merge, не новое правило.
# Пример: derive((int: x 1); (int: y 2)) создаёт скопированную композицию x,y.
RxDerive:
    @: base
    @: extension
    return: @
    derive:
        return: (merge(base; extension))

# Формат поверхностного diff: снимки массивов ссылок, не глубокие снимки значений.
# oldSize/newSize и before/after нужны для проверки базы и восстановления длины.
# indices/values содержат только изменившиеся либо добавленные позиции.
# Поля прототипа сами не являются исполняемым кодом.
independent: RxSlotPatch:
    int: oldSize 0
    int: newSize 0
    @: before 0
    @: indices 0
    @: values 0

# diff(before; after): точная разница ВЕКТОРОВ ССЫЛОК, включая рост/усечение.
# Сравниваются идентичности ссылок; изменение payload по прежнему адресу не видно.
# indices хранит ссылки на int-записи; это обычная Structure / Array<@>.
# Изменённые значения остаются ссылками на after: глубокая неизменяемость не обещана.
# Пример: after заменяет только поле 2 -> одна запись (2,after[2]).
RxDiff:
    @[]: before
    @[]: after
    return: @
    diff:
        @: patch (copy(RxSlotPatch))
        @: old (copy(()))
        @: positions (copy(()))
        @: replacements (copy(()))
        int: oldSize length(before)
        int: newSize length(after)
        sys\resize(old; oldSize)
        int: i 0
        while: i < oldSize
            old[i] := before[i]
            i += 1
        sys\resize(positions; newSize)
        sys\resize(replacements; newSize)
        int: changed 0
        i := 0
        while: i < newSize
            int: different 1
            if: i < oldSize
                if: before[i] = after[i]
                    different := 0
            ---
            if: different
                @: position (copy((int: value 0)))
                position\value := i
                positions[changed] := position[0]
                replacements[changed] := after[i]
                changed += 1
            i += 1
        sys\resize(positions; changed)
        sys\resize(replacements; changed)
        patch\oldSize := oldSize
        patch\newSize := newSize
        patch\before := old
        patch\indices := positions
        patch\values := replacements
        return: patch

# patch(source; change): применить diff к точно той же последовательности ссылок.
# Возвращается НОВЫЙ массив ссылок, source и change не изменяются.
# Полная проверка размера, базы, индексов, уникальности и покрытия новых позиций
# предшествует построению результата. Подменённая база даёт ReceiverPatchBase.
# Пример: patch(A; diff(A; B)) имеет длину B и те же ссылки по всем позициям.
RxPatch:
    @[]: source
    RxSlotPatch@: change
    return: @
    patch:
        throws:
            ReceiverPatchBase
            ReceiverPatchFormat
        int: oldSize change\oldSize
        int: newSize change\newSize
        @: old change\before
        @: positions change\indices
        @: replacements change\values
        if: oldSize < 0 || newSize < 0
            throw: ReceiverPatchFormat()
        if: length(old) != oldSize
            throw: ReceiverPatchFormat()
        if: length(source) != oldSize
            throw: ReceiverPatchBase()
        int: count length(positions)
        if: length(replacements) != count
            throw: ReceiverPatchFormat()
        int: i 0
        while: i < oldSize
            if: source[i] != old[i]
                throw: ReceiverPatchBase()
            i += 1
        i := 0
        while: i < count
            int: at \positions[i]
            if: at < 0 || at >= newSize
                throw: ReceiverPatchFormat()
            int: j 0
            while: j < i
                if: \positions[j] = at
                    throw: ReceiverPatchFormat()
                j += 1
            i += 1
        i := oldSize
        while: i < newSize
            int: found 0
            int: j 0
            while: j < count
                if: \positions[j] = i
                    found := 1
                    break
                j += 1
            if: found = 0
                throw: ReceiverPatchFormat()
            i += 1
        @: out (copy(()))
        sys\resize(out; newSize)
        i := 0
        while: i < oldSize && i < newSize
            out[i] := source[i]
            i += 1
        i := 0
        while: i < count
            int: at \positions[i]
            out[at] := replacements[i]
            i += 1
        return: out

# composeData(code; overlay): скопировать настоящий DATA и добавить/заменить данные.
# ДОПУСТИМЫЙ ДОМЕН: overlay содержит только декларации данных; не заменяет code
# и другие тела/служебные receiver-структуры. Общего публичного перечислителя
# semantic formal-places пока нет; эта предпосылка не выдаётся за runtime-проверку.
# sys\indexof находит ИДЕНТИЧНОСТЬ выбранного тела в его настоящем parent.
# merge сохраняет позиции модели. Результат — именно скопированное тело из неё.
# parent(result), а не собирающая группа, остаётся его фактическим DATA.
# Пример: composeData(Addition\add; (int: y 5)) даёт callable с default y=5.
RxComposeData:
    @: code
    @: overlay
    return: @
    composeData:
        throws:
            ReceiverParent
        @: data parent(code)
        if: data = 0
            throw: ReceiverParent()
        int: bodyIndex sys\indexof(code; data)
        @: composed (merge(data; overlay))
        return: composed[bodyIndex]

# bindFields(code; values): форма composeData для подготовленных default-полей.
# Это НЕ удаление входных позиций, НЕ обязательный захват и НЕ partial:
# явный аргумент следующего вызова по обычным правилам может заменить default.
# values подчиняется тому же домену, что overlay у composeData.
# Пример: bindFields(Addition\add; (int: y 5)); затем f(1;y:=25) даёт 26.
RxBindFields:
    private: @: operation
    private: @: bindings
    return: @
    bindFields:
        throws:
            ReceiverParent
        return: RxComposeData\composeData(operation; bindings)

# Общий rename находится в reflection_bridges.lmx и использует таблицу имён.

# SOURCE: src/generic_combinators.lmx
# ОБЩИЕ КОМБИНАТОРЫ: АРНОСТЬ И ТИПЫ ИЗ СИГНАТУРЫ, НЕ ИЗ IntBinary.
# The internal engine receives one borrowed ordinary prepared call frame.
# FxWrap строит обычный callable с точными входами и результатом контракта.

FxCompositionState:
    @: outer 0
    @: inner 0

FxCompositionEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
        private: @: middle FxFrameApply\apply(frame)
        return: FxApply\apply(state\outer; FxOne\make(middle))

FxCompose:
    private:
        @: outer
        @: inner
    return: @
    compose:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: a FxKernel\signature(subject := outer)
        private: @: b FxKernel\signature(subject := inner)
        if: length(a\inputTypes) != 1 || b\hasResult = 0
            throw: FxArity()
        private: @: contract FxSignatures\make(b\inputTypes; a\resultType)
        private: @: state (copy(FxCompositionState))
        state\outer := outer
        state\inner := inner
        private: @: failures FxFailures\union(a\throws; b\throws)
        return: FxWrap\make(contract; FxCompositionEngine\run; state; failures; FxFullPolicy\make(inner))

FxPipe:
    private:
        @: first
        @: second
    return: @
    pipe:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        return: FxCompose\compose(outer := second; inner := first)

FxIdentity:
    private: @: typeToken
    return: @
    identity:
        throws:
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: requirement FxKernel\normalizeType(token := typeToken)
        private: @: contract FxSignatures\make(FxOne\make(requirement); requirement)
        private: @: state (copy(()))
        private: @: failures (copy(()))
        return: FxBuild\make(contract; "return: p0\n"; state; failures)

FxPermutationState:
    @: operation 0
    @: permutation 0

FxPermutationEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
        return: FxFrameApply\apply(frame)

FxPermute:
    private:
        @: operation
        @: permutation
    return: @
    permute:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            ReceiverPermutation
            SequenceSize
        private: @: info FxKernel\signature(subject := operation)
        private: @: reordered RxReorder\reorder(info\inputTypes; permutation)
        private: @: state (copy(FxPermutationState))
        state\operation := operation
        state\permutation := FxSeqRecords\make(permutation)
        private: @: contract FxSignatures\make(reordered; info\resultType)
        private: @: empty (copy(()))
        private: @: policy FxSourcePolicy\make(operation; state\permutation; empty; empty; empty)
        return: FxWrap\make(contract; FxPermutationEngine\run; state; info\throws; policy)

FxMemoEntry:
    @: key 0
    @: value 0

FxMemoState:
    @: operation 0
    @: sameKey 0
    @: entries 0

FxMemoEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws:
            FxCallFailure
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: key FxFrameSnapshot\snapshot(frame)
        private: int: i 0
        while: i < length(state\entries)
            private: FxMemoEntry@: entry state\entries[i]
            private: @: equalityArgs FxTwo\make(FxRecords\reference(entry\key); FxRecords\reference(key))
            private: @: flagRecord FxApply\apply(state\sameKey; equalityArgs)
            private: int: flag \flagRecord
            if: flag != 0
                return: entry\value
            i += 1
        private: @: value FxFrameApply\apply(frame)
        private: @: entry (copy(FxMemoEntry))
        entry\key := key
        entry\value := value
        private: int: count length(state\entries)
        sys\resize(state\entries; count + 1)
        state\entries[count] := entry
        return: value

# sameKey receives two complete, accepted key snapshots and returns int.
# Omitted/default/autofill positions are resolved by an explicit key read;
# omission alone never yields a cache hit. Snapshot occurs before body writes.
# Кеш линейный; ключи должны оставаться стабильны для выбранного равенства.
# Ошибка не кешируется. Количество параметров F может быть любым, включая 0.
FxMemo:
    private:
        @: operation
        @: sameKey
    return: @
    memo:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxKernel\signature(subject := operation)
        private: @: equality FxKernel\signature(subject := sameKey)
        private: @: state (copy(FxMemoState))
        state\operation := operation
        state\sameKey := sameKey
        state\entries := (copy(()))
        private: @: contract FxSignatures\make(info\inputTypes; info\resultType)
        private: @: failures FxFailures\union(info\throws; equality\throws)
        return: FxWrap\make(contract; FxMemoEngine\run; state; failures; FxFullPolicy\make(operation))

FxFixState:
    @: operation 0
    @: self 0

FxFixEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws:
            FxCallFailure
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        return: FxFrameApply\apply(frame)

# F(self; T0...Tn)->R превращается в T0...Tn->R.
# Единственный специальный первый вход — self по определению fix.
FxFix:
    private: @: operation
    return: @
    fix:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxKernel\signature(subject := operation)
        if: length(info\inputTypes) = 0
            throw: FxArity()
        private: @: inputs FxSlice\slice(info\inputTypes; 1; length(info\inputTypes) - 1)
        private: @: contract FxSignatures\make(inputs; info\resultType)
        private: @: state (copy(FxFixState))
        state\operation := operation
        private: @: values FxOne\make(FxTypeTokens\reference[0])
        private: @: policy FxSourcePolicy\make(operation; FxIndices\make(1; length(inputs)); FxIndices\make(0; 1); values; (copy(())))
        private: @: result FxWrap\make(contract; FxFixEngine\run; state; info\throws; policy)
        state\self := result
        policy\boundValues[0] := FxRecords\reference(result)
        return: result

FxAdapterState:
    @: operation 0
    @: before 0
    @: after 0

FxAdapterEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
        private: @: mappedRecord FxFrameApply\apply(frame)
        private: @: mapped \mappedRecord
        private: @: result FxApply\apply(state\operation; mapped)
        private: @: info FxKernel\signature(subject := state\operation)
        private: @: afterArgs (copy(()))
        if: info\hasResult != 0
            afterArgs := FxOne\make(result)
        return: FxApply\apply(state\after; afterArgs)

# before принимает входы нового contract и возвращает весь вектор actuals F.
# after принимает единственный результат F, либо 0 входов если F — процедура.
# Явный contract задаёт точный новый внешний интерфейс, без догадок о типах.
FxAdapter:
    private:
        @: operation
        @: before
        @: after
        @: contract
    return: @
    adapter:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: a FxKernel\signature(subject := operation)
        private: @: b FxKernel\signature(subject := before)
        private: @: c FxKernel\signature(subject := after)
        private: @: failures FxFailures\union(a\throws; FxFailures\union(b\throws; c\throws))
        private: @: state (copy(FxAdapterState))
        state\operation := operation
        state\before := before
        state\after := after
        return: FxWrap\make(contract; FxAdapterEngine\run; state; failures; FxFullPolicy\make(before))

FxPredicateState:
    @: operation 0

FxPredicateEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws:
            FxCallFailure
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        private: @: record FxFrameApply\apply(frame)
        private: int: truth \record
        return: ((truth != 0) FxRecordOperands\record)

FxBooleanToken:
    int: value

FxPredicate:
    private: @: operation
    return: @
    predicate:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxKernel\signature(subject := operation)
        private: @: booleanType FxKernel\normalizeType(token := FxBooleanToken[0])
        private: @: contract FxSignatures\make(info\inputTypes; booleanType)
        private: @: state (copy(FxPredicateState))
        state\operation := operation
        return: FxWrap\make(contract; FxPredicateEngine\run; state; info\throws; FxFullPolicy\make(operation))

FxContractState:
    @: operation 0
    @: pre 0
    @: post 0

FxContractEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws:
            FxCallFailure
            FxKernelFailure
            FxPredicate
            FxTypeToken
            ReceiverIndex
            SequenceSize
        if: state\pre != 0
            private: @: flagRecord FxApplyPlaces\apply(state\pre; frame)
            private: int: flag \flagRecord
            if: flag = 0
                throw: FxPredicate()
        ---
        private: @: value FxFrameApply\apply(frame)
        if: state\post != 0
            private: @: info FxKernel\signature(subject := state\operation)
            private: @: postArgs FxFrameEntries\make(frame)
            if: info\hasResult != 0
                postArgs := FxAppend\append(postArgs; FxOne\make(FxReadyEntry\make(length(postArgs); value)))
            private: @: flagRecord FxApplyEntries\apply(state\post; postArgs)
            private: int: flag \flagRecord
            if: flag = 0
                throw: FxPredicate()
        ---
        return: value

FxContract:
    private:
        @: operation
        @: pre
        @: post
    return: @
    contract:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxKernel\signature(subject := operation)
        private: @: failures FxAppend\append(info\throws; ("FxPredicate"))
        if: pre != 0
            private: @: preInfo FxKernel\signature(subject := pre)
            failures := FxFailures\union(failures; preInfo\throws)
        if: post != 0
            private: @: postInfo FxKernel\signature(subject := post)
            failures := FxFailures\union(failures; postInfo\throws)
        private: @: state (copy(FxContractState))
        state\operation := operation
        state\pre := pre
        state\post := post
        private: @: contract FxSignatures\make(info\inputTypes; info\resultType)
        return: FxWrap\make(contract; FxContractEngine\run; state; failures; FxFullPolicy\make(operation))

FxGuard:
    private:
        @: operation
        @: accepts
    return: @
    guard:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        return: FxContract\contract(operation; accepts; 0)

FxOverloadState:
    @: candidates 0
    @: accepts 0

FxOverloadEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws:
            FxAmbiguous
            FxCallFailure
            FxKernelFailure
            FxNoMatch
            FxTypeToken
        private: @: selected 0
        private: int: i 0
        while: i < length(state\candidates)
            private: @: test \state\accepts[i]
            private: @: flagRecord FxApplyPlaces\apply(test; frame)
            private: int: flag \flagRecord
            if: flag != 0
                if: selected != 0
                    throw: FxAmbiguous()
                selected := \state\candidates[i]
            i += 1
        if: selected = 0
            throw: FxNoMatch()
        return: FxApplyPlaces\apply(selected; frame)

# Чистые accepts выбирают ровно одну ветвь. Это явный library dispatch,
# а не замена общего declaration selection или обещание purity type system.
FxOverload:
    private:
        @: candidates
        @: accepts
        @: contract
    return: @
    overload:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        if: length(candidates) != length(accepts)
            throw: FxArity()
        private: @: failures ("FxAmbiguous"; "FxNoMatch")
        private: int: i 0
        while: i < length(candidates)
            private: @: candidate \candidates[i]
            private: @: test \accepts[i]
            private: @: a FxKernel\signature(subject := candidate)
            private: @: b FxKernel\signature(subject := test)
            failures := FxFailures\union(failures; FxFailures\union(a\throws; b\throws))
            i += 1
        private: @: state (copy(FxOverloadState))
        state\candidates := FxSlice\slice(candidates; 0; length(candidates))
        state\accepts := FxSlice\slice(accepts; 0; length(accepts))
        return: FxWrap\make(contract; FxOverloadEngine\run; state; failures; FxOwnPolicy\make(contract))

# SOURCE: src/generic_wrappers.lmx
# ОБЩИЕ ОБЁРТКИ. ЦЕЛЕВОЙ R, ВКЛЮЧАЯ void, НЕ ЗАМЕНЯЕТСЯ НА int/@.
# Состояние принадлежит экземпляру в его Message. Между Thread его не делят.
# Ошибки пользователя сохраняют исходное имя и типизированный payload.
# FxKernel attempt/raise — доступ к обычному catch/throw, не новая VM.

FxLazyState:
    @: operation 0
    int: status 0
    @: value 0

FxLazyEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws:
            FxCallFailure
            FxKernelFailure
            FxLazyCycle
            FxTypeToken
        if: state\status = 2
            return: state\value
        if: state\status = 1
            throw: FxLazyCycle()
        state\status := 1
        private: int: completed 0
        finally:
            if: completed = 0
                state\status := 0
        ---
        private: @: result FxFrameApply\apply(frame)
        state\value := result
        state\status := 2
        completed := 1
        return: result

# once сохраняет первый УСПЕШНЫЙ результат F с произвольным числом входов.
# Повторные actuals проходят обычную подготовку вызова, но F не выполняется.
# Неуспех разрешает следующую попытку; не обещана exactly-once внешняя доставка.
FxOnce:
    private: @: operation
    return: @
    once:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxKernel\signature(subject := operation)
        private: @: contract FxSignatures\make(info\inputTypes; info\resultType)
        private: @: state (copy(FxLazyState))
        state\operation := operation
        private: @: failures FxFailures\union(info\throws; ("FxLazyCycle"))
        return: FxWrap\make(contract; FxLazyEngine\run; state; failures; FxFullPolicy\make(operation))

# lazy получает thunk; partial(F;allArgs) превращает любой F в thunk.
FxLazy:
    private: @: operation
    return: @
    lazy:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxKernel\signature(subject := operation)
        if: length(info\inputTypes) != 0
            throw: FxArity()
        return: FxOnce\once(operation := operation)

FxForce:
    private: @: thunk
    return: @
    force:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
        return: FxApply\apply(thunk; (copy(())))

FxRepeat:
    private:
        @: operation
        int: count
        @: args ()
    return: @
    repeat:
        throws:
            FxArity
            FxCallFailure
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceSize
        if: count < 0
            throw: FxIndex()
        private: @: captured FxArguments\capture(operation; args)
        private: @: result (copy(()))
        sys\resize(result; count)
        private: int: i 0
        while: i < count
            result[i] := FxApply\apply(operation; captured)
            i += 1
        return: result

FxUntil:
    private:
        @: step
        @: finished
        @: initial
    return: @
    runUntil:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
        private: @: current initial
        while: 1
            current := FxApply\apply(step; FxOne\make(current))
            private: @: flagRecord FxApply\apply(finished; FxOne\make(current))
            private: int: flag \flagRecord
            if: flag != 0
                return: current

# attempts — общее число попыток, не число повторов после первой.
# Перехватываются только объявленные recoverable throws вызываемого F.
# Системные ошибки/abort не превращаются автоматически в Result.
FxRetry:
    private:
        @: operation
        int: attempts
        @: args ()
    return: @
    retryCall:
        throws:
            FxArity
            FxCallFailure
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceSize
        if: attempts < 1
            throw: FxIndex()
        private: @: captured FxArguments\capture(operation; args)
        private: @: last 0
        private: int: i 0
        while: i < attempts
            last := FxTry\attempt(operation; captured)
            if: last\ok != 0
                return: last\value
            i += 1
        throw: FxCallFailure(last)

# acquire() -> Resource; release(Resource) -> void;
# action(Resource,T0,...,Tn) -> R; arguments содержит только T0,...,Tn.
# Resource и R могут быть любыми типами. Вокруг не создаётся IntBox.
# acquire с параметрами заранее превращают в thunk через partial.
FxAround:
    private:
        @: acquire
        @: release
        @: action
        @: arguments ()
    return: @
    around:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: empty (copy(()))
        private: @: resource FxApply\apply(acquire; empty)
        private: @: resourceArgs FxOne\make(resource)
        finally:
            FxApply\apply(release; resourceArgs)
        ---
        private: @: actionArgs FxAppend\append(resourceArgs; arguments)
        return: FxApply\apply(action; actionArgs)

FxRecoverState:
    @: operation 0
    @: handler 0

FxRecoverEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws:
            FxCallFailure
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: outcome FxFrameAttempt\attempt(frame)
        if: outcome\ok != 0
            return: outcome\value
        private: @: failureRecord (outcome\failure FxRecordOperands\record)
        private: @: actuals FxTwo\make(failureRecord; outcome\payload)
        actuals := FxAppend\append(actuals; FxOne\make(FxRecords\reference(FxFrameObserve\observe(frame))))
        return: FxApply\apply(state\handler; actuals)

# handler(name:string; payload; originalArgs:@) -> the same R.
# originalArgs is a non-forcing state snapshot, in the same shape as trace.args;
# ready records remain available, omitted/deferred inputs remain distinguished.
# Payload принимается его действительным типом; можно ограничить набор ошибок
# контрактом operation, а несоответствие handler отвергает обычное принятие.
FxRecover:
    private:
        @: operation
        @: handler
    return: @
    recover:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxKernel\signature(subject := operation)
        private: @: handlerInfo FxKernel\signature(subject := handler)
        private: @: contract FxSignatures\make(info\inputTypes; info\resultType)
        private: @: state (copy(FxRecoverState))
        state\operation := operation
        state\handler := handler
        return: FxWrap\make(contract; FxRecoverEngine\run; state; handlerInfo\throws; FxFullPolicy\make(operation))

FxTraceState:
    @: operation 0
    @: sink 0

FxTraceEvent:
    char[]: phase ""
    @: args 0
    @: value 0
    int: hasValue 0

FxTraceEmit:
    private:
        @: sink
        char[]: phase
        @: args
        @: value
        int: hasValue
    emit:
        throws:
            FxCallFailure
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        private: @: event (copy(FxTraceEvent))
        event\phase := phase
        event\args := args
        event\value := value
        event\hasValue := hasValue
        FxApply\apply(sink; FxOne\make(FxRecords\reference(event)))

FxTraceEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws:
            FxCallFailure
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        FxTraceEmit\emit(state\sink; "enter"; FxFrameObserve\observe(frame); 0; 0)
        private: int: succeeded 0
        finally:
            if: succeeded = 0
                FxTraceEmit\emit(state\sink; "leave-without-result"; FxFrameObserve\observe(frame); 0; 0)
        ---
        private: @: value FxFrameApply\apply(frame)
        private: @: info FxKernel\signature(subject := state\operation)
        FxTraceEmit\emit(state\sink; "return"; FxFrameObserve\observe(frame); value; info\hasResult)
        succeeded := 1
        return: value

# sink(event) — обычная функция; её эффекты и возможные ошибки не скрываются.
# Для гарантии неперекрытия исходной ошибки sink должен быть nonthrowing.
FxTrace:
    private:
        @: operation
        @: sink
    return: @
    trace:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxKernel\signature(subject := operation)
        private: @: sinkInfo FxKernel\signature(subject := sink)
        private: @: contract FxSignatures\make(info\inputTypes; info\resultType)
        private: @: failures FxFailures\union(info\throws; sinkInfo\throws)
        private: @: state (copy(FxTraceState))
        state\operation := operation
        state\sink := sink
        return: FxWrap\make(contract; FxTraceEngine\run; state; failures; FxFullPolicy\make(operation))

# SOURCE: src/regex/support.lmx
# REGEX: ordinary callable Structures and explicit matching state.
# Draft source, not a kernel execution report. See REGEX_IMPLEMENTATION.md.
# All pointers below are ordinary references to typed records; no regex layout.
# Internal cursors return the existing Maybe. Public eachMatch uses yield / Stop.

TextView:
    int: profile
    char[]: source

# Explicit per-operation text index. It is ordinary data, never executable
# source or a second graph of the program. view is the original public view.
RxPreparedText:
    TextView@: view 0
    int: profile
    char[]: source
    int[]: units
    int[]: byteOffsets

Span:
    TextView@: source
    int: begin
    int: end
    private: RxPreparedText@: prepared

Match:
    TextView@: source
    int: begin
    int: end
    @: captures
    private: RxPreparedText@: prepared

Pattern :: (RxPreparedText@: source; int: position; @: captures; return: @)

RxPredicate :: (int: unit; return: int)

RxReplacement :: (Match@: matched; return: char[])

PatternArgument:

PatternEncoding:

PatternPosition:

# parent() below is parent(D), D = parent(current CODE), so it selects the
# actual copied owner of Call/Next. It makes no assumption that node equals D.

# Configuration values, not negative limits or machine-count sentinels.
RxUnbounded:
    const: int: upperBoundAbsent 1

const: int: extendFirst 0

const: int: stopFirst 1

const: @: unbounded RxUnbounded

RxCandidate:
    int: position 0
    @: captures 0

RxCandidateMake:
    private:
        int: position
        @: captures
    return: @
    make:
        private: @: out (copy(RxCandidate))
        out\position := position
        out\captures := captures
        return: out

# This persistent singly linked journal is ordinary DATA. A successful capture
# allocates a new link; no already published link or Match is ever rewritten.
RxCaptureEntry:
    @: previous 0
    char[]: name ""
    int: begin 0
    int: end 0

RxCaptureAdd:
    private:
        @: previous
        char[]: name
        int: begin
        int: end
    return: @
    add:
        private: @: out (copy(RxCaptureEntry))
        out\previous := previous
        out\name := name
        out\begin := begin
        out\end := end
        return: out

RxCaptureLatest:
    private:
        @: captures
        char[]: name
    return: @
    find:
        private: @: cursor captures
        while: cursor != 0
            if: FxSameText\same(cursor\name; name) != 0
                return: FxSome\some(value := cursor)
            cursor := cursor\previous
        return: FxNone\none()

# A real owner -> Call DATA -> open CODE. The configuration is an ordinary
# enclosing Structure, not an argument of Pattern or a copied native local.
RxPatternOwner:
    private:
        @: engine 0
        @: config 0
    Call:
        private:
            RxPreparedText@: source
            int: position
            @: captures
        required: source position captures
        return: @
        open:
            private: @: owner parent()
            private: @: engine owner\private\engine
            return: engine(config := owner\private\config; source := source; position := position; captures := captures)

RxPatternFactory:
    private:
        @: engine
        @: config
    return: @
    make:
        private: @: owner (copy(RxPatternOwner))
        owner\private\engine := engine
        owner\private\config := config
        return: owner\Call\open

# Cursor state is owned by a freshly copied object. Calling its nullary next
# advances this cursor only. It yields Maybe<Candidate> internally, so a genuine
# empty match is Some with equal positions and exhaustion alone is None.
RxCursorOwner:
    private:
        @: engine 0
        @: state 0
    Next:
        return: @
        next:
            private: @: owner parent()
            private: @: engine owner\private\engine
            return: engine(state := owner\private\state)

RxCursorFactory:
    private:
        @: engine
        @: state
    return: @
    make:
        private: @: owner (copy(RxCursorOwner))
        owner\private\engine := engine
        owner\private\state := state
        return: owner\Next\next

RxIsPattern:
    private: @: value
    return: int
    test:
        return: satisfies(value; Pattern)

RxNormalize:
    private: @: value
    return: @
    make:
        if: RxIsPattern\test(value := value) != 0
            return: value
        # Ordinary admission performs the rejection for numbers, arbitrary
        # Structures and absent values. It does not turn a number into a char.
        private: char[]: text \value
        return: RxLiteral\literal(text := text)

RxOpen:
    private:
        Pattern@: pattern
        RxPreparedText@: source
        int: position
        @: captures
    return: @
    open:
        throws: PatternPosition
        if: position < 0 || position > length(source\units)
            throw: PatternPosition()
        # The signature-qualified reference applies its ordinary label map.
        return: pattern(source := source; position := position; captures := captures)

RxSpanMake:
    private:
        RxPreparedText@: source
        int: begin
        int: end
    return: @
    make:
        private: @: out (copy(Span))
        out\source := source\view
        out\private\prepared := source
        out\begin := begin
        out\end := end
        return: out

RxMatchMake:
    private:
        RxPreparedText@: source
        int: begin
        @: candidate
    return: @
    make:
        private: @: out (copy(Match))
        out\source := source\view
        out\private\prepared := source
        out\begin := begin
        out\end := candidate\position
        out\captures := candidate\captures
        return: out

# SOURCE: src/regex/text.lmx
# UTF-8 is decoded here in LMX, not by a hidden regex/native text engine.
# profile 0 = Unicode scalar values; profile 1 = individual octets.
# byteOffsets contains units.length + 1 entries, including the final byte end.
# TextView retains the source descriptor; no native backing pointer.
# Public TextView stores profile + source descriptor only. Every public search
# builds one RxPreparedText from CURRENT bytes, retained for the operation or
# iterator. The same TextView may be reused after inter-operation mutation.
# Match/Span.source is the original view; private prepared data retain offsets.
# Source must remain unchanged during search/suspension/result access per TZ.

RxOctet:
    private:
        char[]: source
        int: index
    return: int
    read:
        private: int: value source[index]
        if: value < 0
            value += 256
        return: value

RxTextBuild:
    private:
        char[]: source
        int: profile
    return: @
    make:
        throws:
            PatternArgument
            PatternEncoding
        private: @: info FxSeqInfo\get(source := source)
        if: info\elementBits != 8
            throw: PatternEncoding()
        if: profile != 0 && profile != 1
            throw: PatternArgument()
        private: int[]: units []
        private: int[]: offsets []
        # Exact upper bounds: an octet cannot create more than one scalar.
        private: @: unitInfo FxSeqInfo\get(source := units)
        private: int: unitCapacity FxSeqSize\sum(0; length(source); unitInfo\maxLength)
        private: int: offsetCapacity FxSeqSize\sum(length(source); 1; unitInfo\maxLength)
        sys\resize(units; unitCapacity)
        sys\resize(offsets; offsetCapacity)
        private: int: byteAt 0
        private: int: used 0
        while: byteAt < length(source)
            offsets[used] := byteAt
            private: int: first RxOctet\read(source; byteAt)
            private: int: code first
            private: int: width 1
            private: int: lower 0
            if: profile = 0
                if: first < 128
                    width := 1
                else:
                    if: first >= 194 && first <= 223
                        width := 2
                        code := first - 192
                        lower := 128
                    else:
                        if: first >= 224 && first <= 239
                            width := 3
                            code := first - 224
                            lower := 2048
                        else:
                            if: first >= 240 && first <= 244
                                width := 4
                                code := first - 240
                                lower := 65536
                            else:
                                throw: PatternEncoding()
                ---
                if: width > length(source) - byteAt
                    throw: PatternEncoding()
                private: int: tail 1
                while: tail < width
                    private: int: nextByte RxOctet\read(source; byteAt + tail)
                    if: nextByte < 128 || nextByte > 191
                        throw: PatternEncoding()
                    code := code * 64 + nextByte - 128
                    tail += 1
                if: code < lower || code > 1114111
                    throw: PatternEncoding()
                if: code >= 55296 && code <= 57343
                    throw: PatternEncoding()
            ---
            units[used] := code
            used += 1
            byteAt += width
        offsets[used] := byteAt
        sys\resize(units; used)
        sys\resize(offsets; used + 1)
        private: @: out (copy(RxPreparedText))
        out\profile := profile
        out\source := source
        out\units := units
        out\byteOffsets := offsets
        return: out

# The public profile constructor validates now, but stores no stale index.
# Repeated searches prepare their own current index. No change watcher is used.
RxTextViewMake:
    private:
        char[]: source
        int: profile
    return: @
    make:
        private: @: validated RxTextBuild\make(source := source; profile := profile)
        private: @: out (copy(TextView))
        out\source := source
        out\profile := profile
        return: out

RxPrepare:
    private: TextView@: source
    required: source
    return: @
    make:
        private: @: prepared RxTextBuild\make(source := source\source; profile := source\profile)
        prepared\view := source
        return: prepared

RxUtf8Text:
    private: char[]: source
    required: source
    return: @
    utf8Text:
        return: RxTextViewMake\make(source := source; profile := 0)

RxByteText:
    private: char[]: source
    required: source
    return: @
    byteText:
        return: RxTextViewMake\make(source := source; profile := 1)

RxTextSlice:
    private:
        RxPreparedText@: source
        int: begin
        int: end
    return: char[]
    copyText:
        throws: PatternPosition
        if: begin < 0 || end < begin || end > length(source\units)
            throw: PatternPosition()
        private: int: first source\byteOffsets[begin]
        private: int: last source\byteOffsets[end]
        private: char[]: out []
        sys\resize(out; last - first)
        private: int: i first
        while: i < last
            out[i - first] := source\source[i]
            i += 1
        return: out

RxTextAppend:
    private:
        char[]: target
        char[]: fragment
    append:
        private: int: oldLength length(target)
        private: @: info FxSeqInfo\get(source := target)
        private: int: needed FxSeqSize\sum(oldLength; length(fragment); info\maxLength)
        sys\resize(target; needed)
        private: int: i 0
        while: i < length(fragment)
            target[oldLength + i] := fragment[i]
            i += 1

RxTextAppendSpan:
    private:
        char[]: target
        RxPreparedText@: source
        int: begin
        int: end
    append:
        private: int: first source\byteOffsets[begin]
        private: int: last source\byteOffsets[end]
        private: int: oldLength length(target)
        private: @: info FxSeqInfo\get(source := target)
        private: int: needed FxSeqSize\sum(oldLength; last - first; info\maxLength)
        sys\resize(target; needed)
        private: int: i first
        while: i < last
            target[oldLength + i - first] := source\source[i]
            i += 1

# SOURCE: src/regex/primitives.lmx
# Elementary recognizers: a probe returns its new position or internal -1.
# The integer -1 is never a public Match/Maybe/Span representation.
# A probe is an ordinary selected method, not an opcode or a regex instruction.

RxPrimitiveConfig:
    @: probe 0
    @: payload 0

RxPrimitiveState:
    @: source 0
    int: position 0
    @: captures 0
    @: probe 0
    @: payload 0
    int: finished 0

RxPrimitiveMake:
    private:
        @: probe
        @: payload 0
    return: @
    make:
        private: @: config (copy(RxPrimitiveConfig))
        config\probe := probe
        config\payload := payload
        return: RxPatternFactory\make(RxPrimitiveOpen\open; config)

RxPrimitiveOpen:
    private:
        @: config
        RxPreparedText@: source
        int: position
        @: captures
    return: @
    open:
        private: @: state (copy(RxPrimitiveState))
        state\source := source
        state\position := position
        state\captures := captures
        state\probe := config\probe
        state\payload := config\payload
        return: RxCursorFactory\make(RxPrimitiveStep\step; state)

RxPrimitiveStep:
    private: @: state
    return: @
    step:
        if: state\finished != 0
            return: FxNone\none()
        state\finished := 1
        private: @: probe state\probe
        private: int: end probe(payload := state\payload; source := state\source; position := state\position; captures := state\captures)
        if: end < 0
            return: FxNone\none()
        return: FxSome\some(value := RxCandidateMake\make(end; state\captures))

RxTextConfig:
    char[]: text ""

RxLiteral:
    private: char[]: text
    required: text
    return: @
    literal:
        private: @: payload (copy(RxTextConfig))
        payload\text := text
        return: RxPrimitiveMake\make(RxLiteralProbe\probe; payload)

RxLiteralProbe:
    private:
        @: payload
        RxPreparedText@: source
        int: position
        @: captures
    return: int
    probe:
        private: @: text RxTextBuild\make(payload\text; source\profile)
        if: length(text\units) > length(source\units) - position
            return: -1
        private: int: i 0
        while: i < length(text\units)
            if: source\units[position + i] != text\units[i]
                return: -1
            i += 1
        return: position + length(text\units)

RxClassConfig:
    char[]: text ""
    int: inverted 0

RxChars:
    private: char[]: text
    required: text
    return: @
    oneOf:
        private: @: payload (copy(RxClassConfig))
        payload\text := text
        return: RxPrimitiveMake\make(RxClassProbe\probe; payload)
    noneOf:
        private: @: payload (copy(RxClassConfig))
        payload\text := text
        payload\inverted := 1
        return: RxPrimitiveMake\make(RxClassProbe\probe; payload)

RxClassProbe:
    private:
        @: payload
        RxPreparedText@: source
        int: position
        @: captures
    return: int
    probe:
        # Decode before the end test: invalid pattern text is an error even
        # when this attempted match has no remaining source character.
        private: @: text RxTextBuild\make(payload\text; source\profile)
        if: position = length(source\units)
            return: -1
        private: int: found 0
        private: int: i 0
        while: i < length(text\units)
            if: source\units[position] = text\units[i]
                found := 1
                break
            i += 1
        if: found = payload\inverted
            return: -1
        return: position + 1

RxRangeConfig:
    char[]: first ""
    char[]: last ""

RxRange:
    private:
        char[]: first
        char[]: last
    required: first last
    return: @
    charRange:
        private: @: payload (copy(RxRangeConfig))
        payload\first := first
        payload\last := last
        return: RxPrimitiveMake\make(RxRangeProbe\probe; payload)

RxRangeProbe:
    private:
        @: payload
        RxPreparedText@: source
        int: position
        @: captures
    return: int
    probe:
        throws: PatternArgument
        private: @: first RxTextBuild\make(payload\first; source\profile)
        private: @: last RxTextBuild\make(payload\last; source\profile)
        if: length(first\units) != 1 || length(last\units) != 1
            throw: PatternArgument()
        if: first\units[0] > last\units[0]
            throw: PatternArgument()
        if: position = length(source\units)
            return: -1
        private: int: code source\units[position]
        if: code < first\units[0] || code > last\units[0]
            return: -1
        return: position + 1

RxPredicateConfig:
    @: predicate 0

RxSatisfy:
    private: RxPredicate@: predicate
    required: predicate
    return: @
    satisfy:
        private: @: payload (copy(RxPredicateConfig))
        payload\predicate := predicate
        return: RxPrimitiveMake\make(RxPredicateProbe\probe; payload)

RxPredicateProbe:
    private:
        @: payload
        RxPreparedText@: source
        int: position
        @: captures
    return: int
    probe:
        if: position = length(source\units)
            return: -1
        private: RxPredicate@: predicate payload\predicate
        if: predicate(source\units[position]) = 0
            return: -1
        return: position + 1

RxBoundaryOf:
    private: RxPredicate@: predicate
    required: predicate
    return: @
    boundaryOf:
        private: @: payload (copy(RxPredicateConfig))
        payload\predicate := predicate
        return: RxPrimitiveMake\make(RxBoundaryProbe\probe; payload)

RxBoundaryProbe:
    private:
        @: payload
        RxPreparedText@: source
        int: position
        @: captures
    return: int
    probe:
        private: RxPredicate@: predicate payload\predicate
        private: int: before 0
        private: int: after 0
        if: position > 0
            before := predicate(source\units[position - 1]) != 0
        if: position < length(source\units)
            after := predicate(source\units[position]) != 0
        if: before != after
            return: position
        return: -1

RxNameConfig:
    char[]: name ""

RxSameAs:
    private: char[]: name
    required: name
    return: @
    sameAs:
        private: @: payload (copy(RxNameConfig))
        payload\name := name
        return: RxPrimitiveMake\make(RxSameAsProbe\probe; payload)

RxSameAsProbe:
    private:
        @: payload
        RxPreparedText@: source
        int: position
        @: captures
    return: int
    probe:
        private: @: found RxCaptureLatest\find(captures; payload\name)
        if: found\present = 0
            return: -1
        private: @: capture found\value
        private: int: count capture\end - capture\begin
        if: count > length(source\units) - position
            return: -1
        private: int: i 0
        while: i < count
            if: source\units[position + i] != source\units[capture\begin + i]
                return: -1
            i += 1
        return: position + count

RxEmptyProbe:
    private:
        @: payload
        RxPreparedText@: source
        int: position
        @: captures
    return: int
    probe:
        return: position

RxNeverProbe:
    private:
        @: payload
        RxPreparedText@: source
        int: position
        @: captures
    return: int
    probe:
        return: -1

RxAnyProbe:
    private:
        @: payload
        RxPreparedText@: source
        int: position
        @: captures
    return: int
    probe:
        if: position < length(source\units)
            return: position + 1
        return: -1

RxLineCharProbe:
    private:
        @: payload
        RxPreparedText@: source
        int: position
        @: captures
    return: int
    probe:
        if: position = length(source\units)
            return: -1
        private: int: unit source\units[position]
        if: unit = 13 || unit = 10
            return: -1
        return: position + 1

RxLineBreakProbe:
    private:
        @: payload
        RxPreparedText@: source
        int: position
        @: captures
    return: int
    probe:
        if: position = length(source\units)
            return: -1
        private: int: unit source\units[position]
        if: unit = 13
            if: position + 1 < length(source\units)
                if: source\units[position + 1] = 10
                    return: position + 2
            ---
            return: position + 1
        if: unit = 10
            if: position > 0
                if: source\units[position - 1] = 13
                    return: -1
            ---
            return: position + 1
        return: -1

RxTextStartProbe:
    private:
        @: payload
        RxPreparedText@: source
        int: position
        @: captures
    return: int
    probe:
        if: position = 0
            return: position
        return: -1

RxTextEndProbe:
    private:
        @: payload
        RxPreparedText@: source
        int: position
        @: captures
    return: int
    probe:
        if: position = length(source\units)
            return: position
        return: -1

RxLineStartProbe:
    private:
        @: payload
        RxPreparedText@: source
        int: position
        @: captures
    return: int
    probe:
        if: position = 0
            return: position
        private: int: before source\units[position - 1]
        if: before = 10
            return: position
        if: before = 13
            if: position = length(source\units)
                return: position
            if: source\units[position] != 10
                return: position
        ---
        return: -1

RxLineEndProbe:
    private:
        @: payload
        RxPreparedText@: source
        int: position
        @: captures
    return: int
    probe:
        if: position = length(source\units)
            return: position
        private: int: after source\units[position]
        if: after = 13
            return: position
        if: after = 10
            if: position = 0
                return: position
            if: source\units[position - 1] != 13
                return: position
        ---
        return: -1

RxAsciiDigit:
    private: int: unit
    return: int
    test:
        return: unit >= 48 && unit <= 57

RxAsciiLetter:
    private: int: unit
    return: int
    test:
        return: (unit >= 65 && unit <= 90) || (unit >= 97 && unit <= 122)

RxAsciiWord:
    private: int: unit
    return: int
    test:
        return: RxAsciiLetter\test(unit) || RxAsciiDigit\test(unit) || unit = 95

RxAsciiSpace:
    private: int: unit
    return: int
    test:
        return: unit = 32 || (unit >= 9 && unit <= 13)

# SOURCE: src/regex/values.lmx
# Ready Pattern values; none of these names invokes a nullary method.

RxReadyEmptyPatternConfig:
    @: probe RxEmptyProbe\probe
    @: payload 0

RxReadyEmptyPattern:
    Call:
        private:
            RxPreparedText@: source
            int: position
            @: captures
        required: source position captures
        return: @
        open:
            return: RxPrimitiveOpen\open(config := RxReadyEmptyPatternConfig; source := source; position := position; captures := captures)

const: @: emptyPattern RxReadyEmptyPattern\Call\open

RxReadyNeverPatternConfig:
