# Named fields through a formal of the same Structure: reads, writes and `@`
# reach their own fields under an identity correspondence. Success is 7.
Tri: (size_t: xFirst 10U; size_t: xSecond 20U; size_t: xLast 30U)
fn: rdLast (Tri: v) size_t
return: v\xLast
fn: rdFirst (Tri: v) size_t
return: v\xFirst
fn: rdSecond (Tri: v) size_t
return: v\xSecond
fn: wrLast (Tri: v) int
    v\xLast: 99U
    return: 0
end: wrLast
fn: wrFirst (Tri: v) int
    v\xFirst: 40U
    return: 0
end: wrFirst
fn: pokeFirst (Tri: v) int
    poke(@: v\xFirst)
    return: 0
end: pokeFirst
fn: poke (@: size_t: p) int
    \p: 77U
    return: 0
end: poke
m: merge: Tri
size_t: got 0U
int: ok 7
got: rdLast(m)
if: got != 30U
    ok: 81
got: rdFirst(m)
if: got != 10U
    ok: 82
got: rdSecond(m)
if: got != 20U
    ok: 83
wrLast(m)
got: rdLast(m)
if: got != 99U
    ok: 84
got: rdSecond(m)
if: got != 20U
    ok: 85
wrFirst(m)
got: rdFirst(m)
if: got != 40U
    ok: 86
got: rdLast(m)
if: got != 99U
    ok: 87
pokeFirst(m)
got: rdFirst(m)
if: got != 77U
    ok: 88
got: rdLast(m)
if: got != 99U
    ok: 89
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
