+    current
+end
+function uniqueValues(same, items::AbstractVector)
+    vectorInput(items)
+    result = Vector{eltype(items)}(undef, length(items))
+    used = 0
+    for item in items
+        duplicate = false
+        for j in 1:used
+            if truth(same(result[j], item))
+                duplicate = true
+                break
+            end
+        end
+        if !duplicate
+            used += 1
+            result[used] = item
+        end
+    end
+    resize!(result, used)
+end
+function groupValues(keyOf, sameKey, items::AbstractVector)
+    vectorInput(items)
+    groups = Any[]
+    for item in items
+        key = keyOf(item)
+        found = 0
+        for j in eachindex(groups)
+            if truth(sameKey(groups[j].key, key))
+                found = j
+                break
+            end
+        end
+        if found == 0
+            push!(groups, (key=key, items=Any[]))
+            found = length(groups)
+        end
+        push!(groups[found].items, item)
+    end
+    groups
+end
+end
