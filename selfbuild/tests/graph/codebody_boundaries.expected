---
    Observed:
        int: calls 4
        int: total 4
    end: Observed
---
@: shared (data [] 0)
int: calls 4
sub: tick ()
    :=: (node \ calls) ((node \ calls) + 1)
end: tick
sub: selected ()
    if: 0 ()
    else: (tick)
    if: 0 ()
    else: ((tick))
    if: 0 ()
    else: (((tick)))
    finally: (tick)
    finally: ((tick))
    finally: (((tick)))
end: selected
selected:
int: total (data \ calls)
sub: main ()
    :=: ((shared \ Observed) \ calls) (node \ calls)
    :=: ((shared \ Observed) \ total) total
end: main
main:
