# Point inside an else that is inside a while. The merge scratch must include that declaration.
Point:
    int: x 0
    int: y 0
end: Point
fn: nop () int
    return: 0
fn: test () int
    int: k 0
    int: answer 64
    while: k < 1
        if: 0
            int: unused 1
        else:
            pt: merge Point
            pt\x: 4
        nop()
        if: else\pt\x = 4
            answer: 7
        k: k + 1
    ---
    return: answer
int: r 0
r: test()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
