ProducerMessage:
    []int: items
    @: worker
    @: collector
    Send:
        int: state
        int: value
        return: int
        send:
            post:
                ask:
                    worker\Add\add(value := value)
            ---
            return: state
    ---
    start:
        throws: copy(foldl\throws) copy(record\throws)
        (foldl items (0 record) Send\send)
        post:
            ask:
                worker\Finish\finish()
            answer:
                collector\accept

WorkerMessage:
    int: total 0
    Add:
        int: value
        add:
            @: owner parent(node)
            owner\total += value
    ---
    Finish:
        return: int
        finish:
            @: owner parent(node)
            success := 1
            return: owner\total

CollectorMessage:
    int: value
    int: result 0
    int: completed 0
    accept:
        node\result := value
        node\completed := 1
        success := 1
