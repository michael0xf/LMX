+    "../../KERNEL_REQUIREMENTS.md#interface-probe-ar01"
+  ],
+  "known_outcomes": {
+    "compatible": "1",
+    "incompatible": "0",
+    "unresolved": "FxKernelFailure()",
+    "invalid_requirement": "FxTypeToken()"
+  },
+  "service_payload_profile": "Empty () for these internal service exits; implicit/system diagnostics are not caught or reclassified as false.",
+  "source_files": [
+    {
+      "path": "src/regex/combinators.lmx",
+      "sha256": "bdc3d0db80076d6c03a5c7dd3bbdf9b0f03adff8a107a3d2808b70f278b5aa9e"
