# The selected code changes the required field at one call site.
First:
    int: x
    x: x + 1
end: First
Second:
    int: y
    y: y + 2
end: Second
D:
    int: y 10
    int: pad 5
    int: x 3
end: D
@: target First
fn: invoke () int
    call: target D
    return: 0
end: invoke
int: a invoke()
@: target Second
int: b invoke()
int: result 81
if: D\x = 4 && D\y = 12 && D\pad = 5
    result: 7
send: exit(exit_code: result; stdout: ""; stderr: "")
return
