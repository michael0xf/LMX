# Slice 296 probe: the general rule the book example refers to -- a written named Structure (`x: (int: a 1)`) returned from
# an int fn.  Whatever the implementation answers here is the reference for p296a/p296b.
fn: f () int
    x: (int: a 1)
    return: x
end: f
int: code 7
int: v f()
if: v != 1
    code: v
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
