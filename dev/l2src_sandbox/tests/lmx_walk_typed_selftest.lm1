predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_plan.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# -167: typed numeric cells + same-typed arith (c1+c2). Mutants: 4-byte PUT; mixed ADD accepted.

@: LmxArena ga 0
@: Lmx groles 0
@: Lmx gplan_roles 0
@: LmxWalkContext gctx 0
@: LmxWalkValue gv 0
int: broken 0
int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(ga, groles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(ga, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

sub: ref (@: Lmx code; size_t: slot; @: Lmx target)
    if: code = 0 || target = 0 || lmx_arena_ref_store(code, slot, (cast: (@: void) target)) != 0
        broken: broken + 1
    ---
end: ref

sub: sz (@: Lmx code; size_t: slot; size_t: value)
    if: code = 0 || lmx_walk_store_size(ga, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: sz

fn: mk_m (@: Lmx unit; size_t: slot; size_t: children) @: Lmx
    @: Lmx m pl(unit, slot, children)
    @: LmxCallable info lmx_callable_new_owned(ga)
    if: m = 0 || info = 0 || lmx_arena_ref_store(m, 0U, (cast: (@: void) info)) != 0
        broken: broken + 1
        return: 0
    ---
return: m

fn: go (@: Lmx m) int
    int: st
    if: m = 0 || gctx = 0 || gv = 0
        return: c.LMX_WALK_INVALID
    st: lmx_walk_prepare(gctx, ga, gplan_roles, m)
    if: st != c.LMX_WALK_OK
        return: st
return: lmx_walk_run(gctx, m, 0, 0U, gv)

fn: main () int
    LmxArena: arena
    LmxArena: context_arena
    LmxPool: context_cells
    LmxScratch: store
    LmxWalkContext: context
    @: Lmx unit 0
    @: Lmx m 0
    @: Lmx n 0
    @: Lmx holder 0
    @: Lmx litn 0
    @: void cell 0
    @: void ptr 0
    size_t: got 0U
    int: st 0
    int: ch 0

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        return: 2
    ga: @ arena
    if: lmx_chars_init(ga) != 0
        return: 2
    groles: lmx_walk_roles_open(ga)
    gplan_roles: lmx_plan_roles_open(ga)
    memset((cast: (@: void) (@ context_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxScratch))
    if: lmx_arena_open(@ context_arena) != 0 || lmx_scratch_open(@ store, @ context_arena, @ context_cells, 16U) != c.LMX_SCRATCH_OK
        return: 2
    context.arena: ga
    context.scratch: @ store
    context.roles: groles
    context.plan_roles: gplan_roles
    context.immutable_profile: 0
    context.classified: 0U
    gctx: @ context
    gv: (cast: (@: LmxWalkValue) calloc(1U, c.sizeof(c.LmxWalkValue)))

    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 8U) != 0
        return: 2
    ---
    holder: pl(unit, 1U, 2U)
    cell: lmx_size_new_owned(ga)
    if: holder = 0 || cell = 0
        return: 2
    if: lmx_size_store_known(cell, ((cast: (size_t) 1U) << 32) + 7U) != 0 || lmx_arena_ref_store(holder, 1U, cell) != 0
        return: 2
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_PUT, 4U)
    ref(n, 1U, holder)
    sz(n, 2U, 1U)
    litn: fr(n, 3U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_size(ga, litn, 1U, 99U) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && broken = 0)), "size_t put run")
    got: lmx_size_value_known(lmx_arena_ref_value(holder, 1U))
    check((cast: (int) (got = 99U)), "size_t put full width 99")

    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 8U) != 0
        return: 2
    ---
    holder: pl(unit, 1U, 2U)
    cell: lmx_int_new_owned(ga)
    if: cell = 0 || lmx_int_store_known(cell, 1) != 0 || lmx_arena_ref_store(holder, 1U, cell) != 0
        return: 2
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_PUT, 4U)
    ref(n, 1U, holder)
    sz(n, 2U, 1U)
    litn: fr(n, 3U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 5) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK)), "int put run")
    check((cast: (int) (lmx_int_value_known(lmx_arena_ref_value(holder, 1U)) = 5)), "int put 5")

    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 8U) != 0
        return: 2
    ---
    holder: pl(unit, 1U, 2U)
    cell: lmx_char_cell(ga, 97)
    if: cell = 0 || lmx_arena_ref_store(holder, 1U, cell) != 0
        return: 2
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_PUT, 4U)
    ref(n, 1U, holder)
    sz(n, 2U, 1U)
    litn: fr(n, 3U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_char(ga, litn, 1U, 98) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK)), "char put run")
    ch: lmx_char_value_known(lmx_arena_ref_value(holder, 1U))
    check((cast: (int) (ch = 98)), "char put b")

    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 8U) != 0
        return: 2
    ---
    holder: pl(unit, 1U, 2U)
    ptr: lmx_pointer_new_owned(c.LMX_TYPE_POINTER_BASE + 1, ga)
    if: ptr = 0 || lmx_arena_ref_store(holder, 1U, ptr) != 0
        return: 2
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_PUT, 4U)
    ref(n, 1U, holder)
    sz(n, 2U, 1U)
    litn: fr(n, 3U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 1) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_INVALID)), "put pointer INVALID")

    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 8U) != 0
        return: 2
    ---
    holder: pl(unit, 1U, 2U)
    cell: lmx_size_new_owned(ga)
    if: cell = 0 || lmx_size_store_known(cell, 1U) != 0 || lmx_arena_ref_store(holder, 1U, cell) != 0
        return: 2
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_PUT, 4U)
    ref(n, 1U, holder)
    sz(n, 2U, 1U)
    litn: fr(n, 3U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 99) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_INVALID)), "mixed put INVALID")


    # size_t EQ: lit 99 == own/at field 99 -> 1 via ret
    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 8U) != 0
        return: 2
    ---
    holder: pl(unit, 1U, 2U)
    cell: lmx_size_new_owned(ga)
    if: holder = 0 || cell = 0 || lmx_size_store_known(cell, 99U) != 0 || lmx_arena_ref_store(holder, 1U, cell) != 0
        return: 2
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    @: Lmx eqn fr(n, 1U, c.LMX_WALK_OP_EQ, 3U)
    @: Lmx atn fr(eqn, 1U, c.LMX_WALK_OP_AT, 3U)
    ref(atn, 1U, holder)
    sz(atn, 2U, 1U)
    litn: fr(eqn, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_size(ga, litn, 1U, 99U) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\number = 1)), "size_t EQ 99")

    # mixed ADD int + size_t -> INVALID
    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 8U) != 0
        return: 2
    ---
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    eqn: fr(n, 1U, c.LMX_WALK_OP_ADD, 3U)
    litn: fr(eqn, 1U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 1) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    litn: fr(eqn, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_size(ga, litn, 1U, 1U) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_INVALID)), "mixed ADD INVALID")


    c.printf("lmx_walk_typed_selftest checks=%d failures=%d broken=%d\n", checks, failures, broken)
    if: failures != 0 || broken != 0
        return: 1
return: 0
