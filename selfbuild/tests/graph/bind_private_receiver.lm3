# read видит лексически private x = 7 своей Lib; публичное x = 11 вызывающего его не заменяет: seen 7.
# Норма: книга, #binding-decisions, #private-binding, наблюдение B11.
(
    Lib:
        private: int: x 7
        fn: read () int
            return: x
        end: read
    end: Lib
    Observed:
        int: seen 0
    end: Observed
)
fn: f () int
    @: shared node[0]
    int: x 11
    return: shared\Lib\read()
sub: main ()
    @: shared node[0]
    shared\Observed\seen := f()
main()
