predef: "l2src/lmx_thread.h.lm1"
predef: "l2src/lmx_graph_copy_owned.h.lm1"

# Read-only preflight for linking an existing Thread under new_parent.  It walks the
# actual Message graph of the moved Thread and its descendants.  A foreign sealed
# branch is admissible only while its owner arena remains on the resulting Message
# ancestor chain.  No name, numeric branch key, or permanent dependency record is
# needed; all identities are stable physical addresses.
define: LMX_REPARENT_OK 0
define: LMX_REPARENT_INVALID 1
define: LMX_REPARENT_OWNER 2
define: LMX_REPARENT_NOMEM 3

struct: LmxReparentEdge
    @@: void slot
    @: void value
    @: Lmx source_profile
    @: LmxArena view
end: LmxReparentEdge

struct: LmxReparentEdges
    @: LmxReparentEdge data
    size_t: n
    size_t: room
end: LmxReparentEdges

prototype:
    # Recover the one qualified Structure root of an imported or local profile
    # from its physical typed ranges. Zero for an absent/ambiguous profile.
    # This read-only scan uses no name or redundant root registry.
    fn: lmx_reparent_profile_root (@: LmxArena view; @: Lmx profile) @: Lmx
    # On OWNER, `lost` maps each reached sealed profile address to its owner
    # arena address. On OK it is empty. The caller disposes this operation-local
    # map in either case; other errors leave it empty. No graph metadata is added.
    fn: lmx_reparent_lost_profiles (@: LmxThread moved; @: LmxThread new_parent; @: LmxCopyMap lost) int
    # Same read-only scan can retain the physical input edges needed for a
    # later all-or-nothing redirect. A source_profile identifies an immutable
    # carrier which cannot be edited in place. Both outputs are scratch only.
    fn: lmx_reparent_scan (@: LmxThread moved; @: LmxThread new_parent; @: LmxCopyMap lost; @: LmxReparentEdges edges) int
    fn: lmx_reparent_edges_dispose (@: LmxReparentEdges edges) void
    # Expand a lost-profile set through sealed carriers that themselves point
    # into it. These cannot be rewritten in place, even if their own owner
    # remains visible. The map stays operation-local and uses physical addresses.
    fn: lmx_reparent_expand_carriers (@: LmxCopyMap selected; @: LmxReparentEdges edges) int
    # Derive the exact root of every selected physical profile from its owner
    # arena's typed ranges. The output is an operation-local profile -> root
    # address map, not a persistent root registry or a name lookup.
    fn: lmx_reparent_selected_roots (@: LmxCopyMap selected; @: LmxCopyMap roots) int
    fn: lmx_reparent_preflight (@: LmxThread moved; @: LmxThread new_parent) int
end: prototype
