                    private: @: other MapVector\get(result; at)
                    if: other\position > boundary\position || (other\position = boundary\position && other\item\id > item\id)
                        break
                    at += 1
                MapVector\insert(result; at; boundary)
                role += 1
            i += 1
        return: result

