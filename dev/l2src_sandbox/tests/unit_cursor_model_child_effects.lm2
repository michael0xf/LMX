Leaf: ([]: int samples 3; int: x 11)
Outer: (int: pad 17; Nested: (@: link Leaf))
GoodLeaf: (int: pad 29; int: x 13; []: int samples 3)
GoodLeaf\samples[1]: 7
Outer\Nested\link: GoodLeaf
Indices: (size_t: a 1U; size_t: b 1U)
Source: (int: amount 67)
int: callsA 0
int: callsB 0
fn: pickA (size_t: index) size_t
    node\callsA: node\callsA + 1
return: index
fn: pickB (size_t: index) size_t
    node\callsB: node\callsB + 1
return: index
fn: zero () int
return: 0
fn: check () int
    []: (@: Outer) roots 2
    roots[1]: Outer
    if: roots[pickA(Indices\a)]\Nested\link\samples[pickB(Indices\b)] != 7
        return: 81
    roots[pickA(Indices\a)]\Nested\link\samples[pickB(Indices\b)]: Source\amount + zero()
    if: GoodLeaf\samples[1] != 67 || Source\amount != 67
        return: 82
    @: cell int @roots[pickA(Indices\a)]\Nested\link\samples[pickB(Indices\b)]
    if: \cell != 67
        return: 83
    \cell: 71
    if: roots[pickA(Indices\a)]\Nested\link\samples[pickB(Indices\b)] != 71 || GoodLeaf\samples[1] != 71
        return: 84
    if: node\callsA != 4
        return: 100 + node\callsA
    if: node\callsB != 4
        return: 200 + node\callsB
    if: GoodLeaf\pad != 29 || GoodLeaf\x != 13 || Outer\pad != 17
