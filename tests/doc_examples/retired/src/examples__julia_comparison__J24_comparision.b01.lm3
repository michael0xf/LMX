Example:
    int[]: left
    int[]: right
    return: @
    run:
        throws: copy(FxSeqPush\append\throws) copy(record\throws)
        @[]: out []
        int: i 0
        while: i < length(left)
            int: j 0
            while: j < length(right)
                FxSeqPush\append(out; ((left[i]; right[j]) record))
                j += 1
            i += 1
        return: out
