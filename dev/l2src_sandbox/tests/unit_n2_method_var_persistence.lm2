# N2/N3: the full fn form owns addressable args/return/var/body parts.
# The var initializer runs on first entry. Publication replaces its original
# slot, so the second entry starts from the published value, not another 5.
fn: count () int (x: int: 5)
    x: x + 1
    return: x
end: count
fn: check () int
    if: count() != 6 || count\var\x != 6
        return: 81
    if: count() != 7 || count\var\x != 7
        return: 82
return: 7
sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
