+        if: span\node\kind = c.LM_P0_NODE_ATOM && span\node\as != 0 && l2_text_eq(span\node\as\atom, "@") != 0
+            child_address: 1
+        return: l2_scan_value_span(span\operand, mi, seen, child_address)
+    if: span\values != 0
+        if: span\grammar != 3 && span\node\kind = c.LM_P0_NODE_FRAME
+            child_address: l2_frame_head(span\node, "@")
+        while: k < span\value_n
+            if: l2_scan_value_span(span\values + k, mi, seen, child_address) != 0
+                return: 1
+            k: k + 1
+        ---
+        return: 0
+    if: span\grammar = 3
+        return: l2_error_fatal(l2_src, span\node, "internal: a lexical expression lost its children")
+return: l2_scan_node(span\node, mi, seen)
+
