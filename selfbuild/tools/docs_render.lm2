# Unselected ordinary L2 semantic-body preparation and paired-doc writer.
# The old Python algorithm's chapter/language order, aliases and text joins
# are retained. Source inventory/controller/check_docs integration still pending.

fn: dr_body (@: book char; @: row size_t; int: lang; @: l1 char; @: l1_starts size_t; @: l1_lengths size_t; size_t: l1_lines; @: older char; @: older_starts size_t; @: older_lengths size_t; size_t: older_lines; @@: out char; @: out_count size_t) int
    @: expanded char 0
    @: rewritten char 0
    size_t: expanded_count 0U
    size_t: rewritten_count 0U
    size_t: column 8U + 2U * (cast: (size_t) lang)
    int: failed 0
    out[0]: 0
    out_count[0]: 0U
    failed: docs_semantics_expand(book + row[column], row[column + 1U], l1, l1_starts, l1_lengths, l1_lines, older, older_starts, older_lengths, older_lines, @ expanded, @ expanded_count)
    if: failed != 0
        return: 1
    if: row[1] = 17U && c.memcmp(book + row[0], "admission-recipes", 17U) = 0
        failed: docs_semantics_cases(expanded, expanded_count, @ rewritten, @ rewritten_count)
        c.free(expanded)
        if: failed != 0
            return: 1
        out[0]: rewritten
        out_count[0]: rewritten_count
        return: 0
    ---
    out[0]: expanded
    out_count[0]: expanded_count
    return: 0
end: dr_body

fn: docs_semantics_bodies_free (@@: bodies char; @: lengths size_t; size_t: chapters) int
    size_t: at 0U
    if: bodies != 0
        while: at < 2U * chapters
            c.free(bodies[at])
            at: at + 1U
        ---
    ---
    c.free(bodies)
    c.free(lengths)
    return: 0
end: docs_semantics_bodies_free

# RU then EN then original pair assertions, chapter by chapter, before any doc
# publication. Buffers are cached immutable results of the same pure body_text.
fn: docs_semantics_prepare (@: book char; @: rows size_t; size_t: chapters; @: l1 char; @: l1_starts size_t; @: l1_lengths size_t; size_t: l1_lines; @: older char; @: older_starts size_t; @: older_lengths size_t; size_t: older_lines; @@@: out_bodies char; @@: out_lengths size_t; @: failed_chapter size_t; @: failed_kind int) int
    @@: bodies char 0
    @: lengths size_t 0
    @: row size_t 0
    size_t: at 0U
    size_t: limit (cast: (size_t) -1)
    int: failed 0
    if: book = 0 || rows = 0 || out_bodies = 0 || out_lengths = 0 || failed_chapter = 0 || failed_kind = 0 || chapters = 0U
        return: 1
    out_bodies[0]: 0
    out_lengths[0]: 0
    failed_chapter[0]: chapters
    failed_kind[0]: 0
    if: chapters > limit / 2U / sizeof(@: char) || chapters > limit / 2U / c.sizeof(c.size_t)
        return: 1
    bodies: c.calloc(2U * chapters, sizeof(@: char))
    lengths: c.calloc(2U * chapters, c.sizeof(c.size_t))
    if: bodies = 0 || lengths = 0
        docs_semantics_bodies_free(bodies, lengths, chapters)
        return: 1
    ---
    while: at < chapters && failed = 0
        row: rows + 12U * at
        failed: dr_body(book, row, 0, l1, l1_starts, l1_lengths, l1_lines, older, older_starts, older_lengths, older_lines, bodies + 2U * at, lengths + 2U * at)
        if: failed = 0
            failed: dr_body(book, row, 1, l1, l1_starts, l1_lengths, l1_lines, older, older_starts, older_lengths, older_lines, bodies + 2U * at + 1U, lengths + 2U * at + 1U)
        ---
        if: failed = 0
            failed: docs_semantics_pair_check(bodies[2U * at], lengths[2U * at], bodies[2U * at + 1U], lengths[2U * at + 1U], failed_kind)
        ---
        if: failed != 0
            failed_chapter[0]: at
        at: at + 1U
    ---
    if: failed != 0
        docs_semantics_bodies_free(bodies, lengths, chapters)
        return: 1
    ---
    out_bodies[0]: bodies
    out_lengths[0]: lengths
    return: 0
end: docs_semantics_prepare

fn: dr_alias (@: stream c.FILE; @: book char; @: row size_t) int
    @: id char book + row[0]
    if: row[1] = 6U && c.memcmp(id, "fields", 6U) = 0
        return: dg_literal(stream, "<a id=\"references\"></a>\n")
    if: row[1] = 9U && c.memcmp(id, "callables", 9U) = 0
        return: dg_literal(stream, "<a id=\"execution\"></a>\n")
    if: row[1] = 7U && c.memcmp(id, "dynamic", 7U) = 0
        return: dg_literal(stream, "<a id=\"publication\"></a>\n")
    if: row[1] = 8U && c.memcmp(id, "delivery", 8U) = 0
        return: dg_literal(stream, "<a id=\"addressing\"></a>\n")
    return: 0
end: dr_alias

# Original whole-result anchor uniqueness, including any opening/body anchors.
fn: dr_unique_anchors (@: data char; size_t: count) int
    size_t: scan 0U
    size_t: first 0U
    size_t: last 0U
    size_t: after 0U
    size_t: prior_scan 0U
    size_t: prior_first 0U
    size_t: prior_last 0U
    size_t: prior_after 0U
    int: found 0
    int: prior_found 0
    while: 1
        found: dp_match(data, count, scan, 3, @ first, @ last, @ after)
        if: found < 0
            return: 1
        if: found = 0
            return: 0
        prior_scan: 0U
        while: prior_scan < scan
            prior_found: dp_match(data, count, prior_scan, 3, @ prior_first, @ prior_last, @ prior_after)
            if: prior_found != 1 || prior_after > scan
                return: 1
            if: prior_last - prior_first = last - first && c.memcmp(data + prior_first, data + first, last - first) = 0
                return: 1
            prior_scan: prior_after
        ---
        scan: after
    ---
end: dr_unique_anchors

# One old-language iteration: opening/rstrip, TOC, aliases+chapters, final LF,
# duplicate-anchor assertion, then check or publication. Caller invokes RU then
# EN after docs_semantics_prepare succeeded. Check never publishes user files.
# failed_phase:1read/decode,2render/I/O,3duplicate-anchor,4out-of-sync,5write.
fn: docs_semantics_language (@: path char; @: book char; @: rows size_t; size_t: chapters; @@: bodies char; @: body_lengths size_t; int: lang; int: check_mode; @: failed_phase int) int
    @: raw char 0
    @: text char 0
    @: result char 0
    @: check_raw char 0
    @: check_text char 0
    @: row size_t 0
    @: stream c.FILE 0
    size_t: raw_count 0U
    size_t: text_count 0U
    size_t: result_count 0U
    size_t: check_raw_count 0U
    size_t: check_count 0U
    size_t: cut 0U
    size_t: scope_at 0U
    size_t: trim_begin 0U
    size_t: trim_end 0U
    size_t: title 2U + 2U * (cast: (size_t) lang)
    size_t: at 0U
    int: failed 0
    if: path = 0 || book = 0 || rows = 0 || bodies = 0 || body_lengths = 0 || failed_phase = 0 || (lang != 0 && lang != 1)
        return: 1
    failed_phase[0]: 1
    raw: file_read(path, @ raw_count)
    if: raw = 0
        return: 1
    failed: dt_text(raw, raw_count, 0, @ text, @ text_count)
    c.free(raw)
    if: failed != 0
        return: 1
    cut: dt_find(text, text_count, 0U, "<!-- semantics-toc -->", 22U)
    if: cut = (cast: (size_t) -1)
        cut: text_count
    scope_at: dt_find(text, cut, 0U, "<a id=\"scope\">", 14U)
    if: scope_at != (cast: (size_t) -1)
        cut: scope_at
    failed: dt_trim(text, cut, 0, 1, @ trim_begin, @ trim_end)
    failed_phase[0]: 2
    if: failed = 0
        stream: c.tmpfile()
        if: stream = 0
            failed: 1
        ---
    ---
    if: failed = 0
        failed: dg_bytes(stream, text, trim_end)
    if: failed = 0
        failed: dg_literal(stream, "\n\n<!-- semantics-toc -->\n\n")
    at: 0U
    while: at < chapters && failed = 0
        row: rows + 12U * at
        if: at > 0U && c.fputc(10, stream) < 0
            failed: 1
        if: failed = 0
            if: c.fprintf(stream, "- [%zu. ", at + 1U) < 0 || dg_bytes(stream, book + row[title], row[title + 1U]) != 0 || dg_literal(stream, "](#") != 0 || dg_bytes(stream, book + row[0], row[1]) != 0 || dg_literal(stream, ")") != 0
                failed: 1
            ---
        ---
        at: at + 1U
    ---
    at: 0U
    while: at < chapters && failed = 0
        row: rows + 12U * at
        if: dg_literal(stream, "\n\n") != 0 || dr_alias(stream, book, row) != 0 || dg_literal(stream, "<a id=\"") != 0 || dg_bytes(stream, book + row[0], row[1]) != 0 || dg_literal(stream, "\"></a>\n## ") != 0 || c.fprintf(stream, "%zu. ", at + 1U) < 0 || dg_bytes(stream, book + row[title], row[title + 1U]) != 0 || dg_literal(stream, "\n\n") != 0 || dg_bytes(stream, bodies[2U * at + (cast: (size_t) lang)], body_lengths[2U * at + (cast: (size_t) lang)]) != 0
            failed: 1
        ---
        at: at + 1U
    ---
    if: failed = 0 && c.fputc(10, stream) < 0
        failed: 1
    if: failed = 0
        failed: db_stream_read(stream, @ result, @ result_count)
    if: stream != 0
        if: c.fclose(stream) != 0
            failed: 1
        ---
    ---
    c.free(text)
    if: failed = 0
        failed_phase[0]: 3
        failed: dr_unique_anchors(result, result_count)
    if: failed = 0 && check_mode != 0
        failed_phase[0]: 4
        check_raw: file_read(path, @ check_raw_count)
        if: check_raw = 0
            failed: 1
        else:
            failed: dt_text(check_raw, check_raw_count, 0, @ check_text, @ check_count)
            if: failed = 0 && (check_count != result_count || c.memcmp(check_text, result, result_count) != 0)
                failed: 1
            ---
        ---
    ---
    if: failed = 0 && check_mode = 0
        failed_phase[0]: 5
        failed: file_write(path, result, result_count)
    ---
    c.free(check_raw)
    c.free(check_text)
    c.free(result)
    if: failed = 0
        failed_phase[0]: 0
    return: failed
end: docs_semantics_language
