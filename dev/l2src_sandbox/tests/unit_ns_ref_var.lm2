# R6-2 (4) (Codex NOTE CODEX-REF-INIT-20261011-211822: a compatible reference-valued candidate is not rejected for not being a
# Structure word): `@: Model p q`, q a reference field declared above, is the body's statement -- both are null after the
# merge and bound once h has run, p through q; the read through p is Model's v.  Exit 7; 81 bound before the run, 82 unbound
# after it, 83 the read.
Model:
    int: v 11
end: Model
Holder:
    @: Model q Model
    @: Model p q
    int: k 3
end: Holder
h: merge: Holder
int: code 7
if: h\p != 0 || h\q != 0
    code: 81
h
if: h\q = 0 || h\p = 0
    code: 82
if: code = 7 && h\p\v != 11
    code: 83
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
