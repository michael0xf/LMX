# C ABI: frozen lm_p0_scan_layout_prefix -> L2 l2_layout_m3.
predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>"

extern: @: Lmx l2_layout_unit

prototype:
    fn: l2_layout_boot () int
    fn: l2_layout_m3 (@: Lmx node; const: @(char source); size_t: length; size_t: start; @: size_t out_offset; @: size_t out_indent_column; @: size_t out_dot_level) void
end: prototype

int: l2_layout_prefix_calls 0

fn: l2_layout_ensure () void
    if: l2_layout_unit = 0
        if: c.l2_layout_boot() != 0 || l2_layout_unit = 0
            fputs("l2_layout_boot failed\n", l1_stderr())
---

fn: lm_p0_scan_layout_prefix (const: @(char source); size_t: length; size_t: start; @: size_t out_offset; @: size_t out_indent_column; @: size_t out_dot_level) void
    l2_layout_ensure()
    l2_layout_prefix_calls: l2_layout_prefix_calls + 1
    c.l2_layout_m3(c.lmx_arena_ref_struct(l2_layout_unit, 3U), source, length, start, out_offset, out_indent_column, out_dot_level)
