# A typed reference field of an immutable value at the admission of a formal: its cell's type is the same type under the qualifier's sign.  Native only: the walker does not read
# a reference cell of an immutable value yet, with or without a formal (steps/defects.md, IMMUTABLE-REFERENCE-CELL-WALKED).
Holder:
    @: quote int 0
end: Holder
fn: read (@: h Holder) int
    if: h\quote != 0
        return: 81
    return: 7
end: read
fn: m () int
    b: immutable: merge(Holder)
    return: read(b)
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
