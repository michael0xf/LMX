# A held callable takes the arguments its header declares: two here. One
# argument is refused where the call stands.
fn: make2 (int: n) fn: (int: x; int: y) int
    fn: f2 (int: x; int: y) int
        return: n + x * 10 + y
    return: f2
h2: make2 100
int: r h2(1)
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
