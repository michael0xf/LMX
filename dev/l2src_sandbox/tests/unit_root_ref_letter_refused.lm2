# The walked root's typed reference bound to the letter: `r: @raw` admits raw's Structure to Model before binding --
# implements(raw, Model, Model), the predicate a native admission calls -- and the letter is not a Model: the implicit
# throw `implements` stops R0 (status 2).
Model:
    size_t: value 1U
end: Model

@: Model r
receiveMessage: raw
r: @raw
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
