# A sub needs no return and no closer (the author, Q54 clarification: reaching the end completes it without a
# result; no return node is made): declared, s runs nothing (hits 0); called twice, it runs twice (hits 2).
# Walked (run and s: the Absent pins): 2 -- success 7; any other 64.
int: hits 0
fn: peek () int
    return: node\hits
end: peek
sub: s ()
    node\hits: node\hits + 1
fn: run () int
    int: a 0
    a: peek()
    s()
    s()
    int: b 0
    b: peek()
    return: a * 10 + b
end: run
int: r 64
int: got 0
got: run()
if: got = 2
    r: 7
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
