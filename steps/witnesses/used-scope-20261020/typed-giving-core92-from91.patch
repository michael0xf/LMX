+# Compose TWO coordinate relations, independently of where their evidence
+# came from. Both the declared source and unqualified alternatives use it.
+# No type permission, names or physical-origin inference happens here.
+fn: lmx_implements_project_view (@: LmxArena arena; @: Lmx value; @: Lmx req; @: LmxImplEntry source; @: LmxImplEntry pair; @: LmxImplEntry out) int
+    @: size_t map 0
+    size_t: width
+    size_t: i 0U
+    size_t: middle
+    size_t: slot
+    if: out = 0 || source = 0 || pair = 0 || req = 0 || source\req = 0 || out = source || out = pair
+        return: c.LMX_IMPLEMENTS_UNKNOWN
+    memset((cast: (@: void) out), 0, c.sizeof(c.LmxImplEntry))
+    width: req\array.size
+    if: pair\n != width || width > ((cast: (size_t) -1) / c.sizeof(c.size_t)) / 2U
+        return: c.LMX_IMPLEMENTS_UNKNOWN
+    if: width != 0U
+        map: (cast: (@: size_t) malloc(width * 2U * c.sizeof(c.size_t)))
+        if: map = 0
+            return: c.LMX_IMPLEMENTS_UNKNOWN
+        ---
+    ---
+    while: i < width
+        if: lmx_implements_at(arena, pair, i, @ middle) != 0
+            break
+        slot: middle
+        if: middle != (cast: (size_t) -1) && (middle >= source\req\array.size || lmx_implements_at(arena, source, middle, @ slot) != 0)
+            break
+        map[i]: slot
+        if: lmx_implements_at_last(arena, pair, i, @ middle) != 0
+            break
+        slot: middle
+        if: middle != (cast: (size_t) -1) && (middle >= source\req\array.size || lmx_implements_at_last(arena, source, middle, @ slot) != 0)
+            break
+        map[width + i]: slot
+        i: i + 1U
+    ---
+    if: i = width
+        out\value: value
+        out\req: req
+        out\layout: lmx_implements_layout(arena, value)
+        out\map: map
+        out\n: width
+        if: map != 0
+            out\owned_map: 1
+        return: c.LMX_IMPLEMENTS_YES
+    ---
+    if: map != 0
+        free((cast: (@: void) map))
+return: c.LMX_IMPLEMENTS_UNKNOWN
+
+# A declared namespace is an address of an ordinary current Model, not a
+# layout or a class number. Only evidence for THIS value/Model pair answers.
+# The retained bridge is logical requirement -> logical giving declaration;
