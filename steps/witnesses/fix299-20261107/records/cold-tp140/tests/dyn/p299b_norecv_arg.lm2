# Slice 299 probe (NUMERIC-RECEPTION-MISSING-CONVERTER-PHASE): the program defines no char -> int receiver.  A reached call
# giving a char value to an int formal is the implicit `convert` before the body; the same call in a branch that does not run
# refuses nothing.  Entry 7.
fn: take (int: a) int
    return: a
end: take
fn: arg_reached () int
    char: c 6
    ---
        int: got take(c)
        return: got
        catch: convert ()
            return: 25
    ---
end: arg_reached
fn: arg_skipped (int: k) int
    char: c 6
    if: k = 1
        return: take(c)
    ---
    return: 9
end: arg_skipped
fn: run () int
    if: arg_reached() != 25
        return: 81
    ---
    if: arg_skipped(0) != 9
        return: 82
    ---
    return: 7
end: run
int: code run()
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
