# Slice 299 probe (NUMERIC-RECEPTION-MISSING-CONVERTER-PHASE): the program defines no char -> int receiver.  A reached write
# of a char value into an int place is the implicit `convert` and the place keeps 5; the same write in a branch that does
# not run refuses nothing.  Entry 7.
fn: write_reached () int
    int: z 5
    char: c 6
    ---
        z: c
        return: 1
        catch: convert ()
            return: z
    ---
end: write_reached
fn: write_skipped (int: k) int
    int: z 5
    char: c 6
    if: k = 1
        z: c
    ---
    return: z
end: write_skipped
fn: run () int
    if: write_reached() != 5
        return: 81
    ---
    if: write_skipped(0) != 5
        return: 82
    ---
    return: 7
end: run
int: code run()
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
