Example:
    int[]: left
    int[]: right
    return: @
    Row:
        int: x
        return: @
        Pair:
            int: y
            return: @
            make:
                return: (x; y)
        ---
        expand:
            throws: copy(map\throws)
            return: map(right; Pair\make)
    ---
    run:
        throws: copy(FxListBind\bind\throws) copy(Example\Row\expand\throws)
        return: bind(left; Row\expand)
