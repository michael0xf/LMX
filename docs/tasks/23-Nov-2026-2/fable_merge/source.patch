@@ -0,0 +1,22 @@
+MakeAdder:
+    int: first
+    return: @
+    Add:
+        int: second
+        return: int
+        add:
+            @: owner parent(node)
+            return: owner\first + second
+    ---
+    make:
+        @: owner (copy(node))
+        owner := parent(owner\Add)
+        owner\first := first
+        return: owner\Add\add
+
+Example:
+    int: value
+    return: int
+    run:
+        @: add5 MakeAdder\make(5)
+        return: add5(value)
