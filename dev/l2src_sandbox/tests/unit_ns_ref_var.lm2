# `@: Model q Model` has a known Structure candidate, so q is bound when
# Holder is made. The candidate `q` for p is a reference value, not a direct
# Structure definition: p remains empty until Holder executes its body.
# Exit 7; 81 p bound or q empty before the run, 82 unbound after it, 83 read.
Model:
    int: v 11
end: Model
Holder:
    @: Model q Model
    @: Model p q
    int: k 3
end: Holder
h: merge: Holder
int: code 7
if: h\p != 0 || h\q = 0
    code: 81
h
if: h\q = 0 || h\p = 0
    code: 82
if: code = 7 && h\p\v != 11
    code: 83
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
