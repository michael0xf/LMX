        return: 1
    return: 0
end: decl_walk_engine

# Forward declarations of the SAME inherited objects, not new storage.
# Ordinary-unit extern emission precedes machine bodies; header emission does not.
fn: decl_walk_state_decl (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx_walk.h.lm1\"\nextern: @@: Lmx lmx_walk_program_roots_g\nextern: size_t: lmx_walk_program_root_count_g\n", f) < 0
        return: 1
    return: 0
end: decl_walk_state_decl

fn: decl_thread_state (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx_thread.h.lm1\"\nthread_local: @: LmxThread lmx_thread_current_slot 0\n", f) < 0
        return: 1
    return: 0
end: decl_thread_state

