# Slice 293 (FORMAL-DEFAULT): a literal written as a formal's default that is no value of the formal's type is refused
# where the signature writes it, also when no call omits the formal.
fn: c1 (char: c 300) int
    return: (cast: (int) c)
end: c1
int: code 7
if: c1('a') != 97
    code: 81
---
send: exit(exit_code: code; stdout: ""; stderr: "")
return
