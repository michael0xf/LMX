fn: l2_flow_free () int
    l2_xfree((cast: (@: void) l2_t7_kind))
    l2_t7_kind: 0
    l2_xfree((cast: (@: void) l2_t7_host))
    l2_t7_host: 0
    l2_xfree((cast: (@: void) l2_t7_model))
    l2_t7_model: 0
    l2_xfree((cast: (@: void) l2_t7_ret))
