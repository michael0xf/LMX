                return: (cast: (int) (1))
            if: l2_pkind = 1 && c.lm_compiler_tx_set(l2_pval, "(cast: (char) lmx_char_value_known(l2_pxp[0]))") != 0
                return: (cast: (int) (1))
            if: l2_pkind = 7 && c.lm_compiler_tx_set(l2_pval, "lmx_int_value_known(l2_pxp[0])") != 0
                return: (cast: (int) (1))
            if: l2_pkind = 8 && c.lm_compiler_tx_set(l2_pval, "lmx_unsigned_value_known(l2_pxp[0])") != 0
                return: (cast: (int) (1))
            if: l2_pkind = 9 && c.lm_compiler_tx_set(l2_pval, "lmx_ulong_value_known(l2_pxp[0])") != 0
                return: (cast: (int) (1))
