# LMX: ОБЩИЕ ПРЯМЫЕ РЕСИВЕРЫ И КОНТЕЙНЕРЫ
# Редакция 2026-11-22. Собрано из src/ и явно запускаемых examples/.
# DATA-описания ядра; старые Int-специализации сюда не входят.
# 115 вызовных имён и отдельно готовые Pattern/config/type значения. Каждая Structure — @[].
# FxKernel: 8 исходных границ + 5 фаз обычного вызова + 4 операции доступа к Array.
# Это проект интеграции; реальное ядро и LMX-fixtures здесь не исполнялись.
# Name :: DATA и signatureTypes взаимозаменяемы, кроме сохранённого отношения именованной сигнатуры с call.
# Ни автоматического запуска, ни новой VM, ни автоматической компиляции.
# Загружать сборку ИЛИ отдельные файлы, не оба варианта вместе.

# SOURCE: src/kernel_contracts.lmx
# INTERNAL INTERFACES TO THE EXISTING KERNEL, NOT IMPLEMENTED KERNEL BODIES.
# The high-level algorithms are LMX sources. These declarations state the narrow
# signature/graph/call preparation hooks to bind to the real kernel. No parser,
# callable kind, lazy-array VM or second executable graph is introduced.

FxKernelSignatureAPI :: (@: subject; return: @)

FxKernelNormalizeTypeAPI :: (@: token; return: @)

FxKernelSignatureDataAPI :: (@: inputs; @: result; @: labels; return: @)

FxKernelCallableAPI :: (@: contract; @: labels; @: bodyGraph; @: state; @: failures; @: policy; return: @)

FxKernelAttemptAPI :: (@: operation; @: args; @: failures; return: @)

FxKernelRaiseAPI :: (char[]: name; @: payload)

FxKernelFieldNamesAPI :: (@: source; return: @)

FxKernelRenameFieldsAPI :: (@: target; @: indices; @: labels)

# Five phase hooks for existing ordinary call preparation/execution.
# A borrowed frame is service state of THIS invocation, never persistent graph.
FxKernelCurrentCallAPI :: (@: owner; return: @)

FxKernelFrameSlotAPI :: (@: frame; int: index; int: demand; return: @)

FxKernelPrepareAPI :: (@: operation; @: entries; return: @)

FxKernelEnterAPI :: (@: frame; @: failures; return: @)

FxKernelReleaseCallAPI :: (@: frame)

# signature -> {inputTypes,resultType,hasResult,names,throws,declarations}.
# declarations are references to the selected candidate's real source forms;
# no initializer/body is executed. Names/policy are not signature identity.
# normalizeType reads an initialized int payload as type-id, uninit:T as its
# type with no payload read, and returns an internal @ to a canonical int code
# record. Existing type descriptions preserve full Structure/callable/Array
# models; no new public boxed Type value is introduced.
# T[] and T@ are postfix constructors producing ordinary int type codes.
# []: variable is AnyArray, @[]: variable is the actual Structure/@[] requirement.
# signatureData creates ordinary declarations, without universal required/private.
# callable publishes ordinary owner -> DATA -> CODE with genuine parent links.
# Its policy maps external positions to real source declarations, keeps bound
# records and current-call provenance, and retains private ONLY where applicable.
# The source policy is not copied from an unrelated named signature template.
# Private state and inputPolicy are explicit ordinary graph fields; invocation
# slots are transient service data, not hidden native fields.
# Builder parses nothing per call and never borrows an incompatible native ABI.
#
# attempt consumes a finite ready actual vector; extra optional target formals
# retain their defaults/absence. A Structure element is one whole actual.
# Ready sequence input uses ordinary typed call access and actual dense stride.
# Outcome is {ok,value,failure,payload}; value is the record of TRUE R/void.
# A referenced Structure/Array/callable is not wrapped in another @ box.
# Only declared admitted named failures are caught; implicit failures escape.
# raise preserves the same name/payload within the generated declared exits.
#
# currentCall(owner) is legal in the generated CODE whose activation it names.
# It returns the already selected frame view; getting it evaluates no input.
# The view exposes inputTypes (public positions), failures and source operation.
# The target source namespace keeps captured positions and initializer origins.
# Ordinary binding is selected at the documented adapter call boundary; helper
# locals are private, and no arbitrary caller/factory context can be injected.
#
# frameSlot(frame,index,0) only observes: supplied/ready/declaration/state/
# requirement/ownPlace/transparentPlace and, iff ready, value. It reads no default.
# frameSlot(...,1) makes ONE ordinary place read, including deferred reception.
# Demand retains the original DATA/node and source-place preparation. Ready
# received primitive records remain stable across writes to F's own formal;
# this is input observation, not a writable alias to that working cell.
# Named failures of that demand use FxCallFailure with the original outcome;
# ordinary implicit failure remains an implicit failure. uninit is not @0.
#
# prepare(operation,entries) performs ordinary selection and call preparation.
# ready entries hold a value record; place entries are preserved declaration
# actuals whose initializer reads an existing selected place on demand. Supplied
# source declaration forms keep their form/namespace substitution. An actual
# entry retains the already selected explicit occurrence/form; an omitted input
# cannot be made supplied by this entry. All maps are
# checked before effects; W/E and source expressions are never applied a second time.
# Its ordinary dynamic context is the reached call site, not a saved factory scope.
#
# enter resumes the selected call once using the original source DATA/CODE/node,
# the normal native/interpreter dispatcher, and its already prepared actuals.
# releaseCall ends a frame owned by prepare; ordinary cleanup precedes return and
# outcomes use live arena records. The wrapper-owned currentCall frame is released
# by its ordinary activation exit, including cache hit and exceptional paths.
# A frame reference neither extends lifetime nor authorizes execution twice.
#
# fieldNames and renameFields use the existing owning-field name association.
# An anonymous field is represented by uninit:char[], distinct from empty string.
# Detailed narrow-hook and lifetime contracts: ../KERNEL_REQUIREMENTS.md.

# Common physical Array access used by sequence algorithms and Regex.
FxKernelArrayInfoAPI :: (@: source; return: @)

FxKernelArrayReadAPI :: (@: source; int: index; return: @)

FxKernelArrayAdmitAPI :: (@: target; @: value; return: @)

FxKernelArrayWriteAPI :: (@: target; int: index; @: value)

# arrayInfo -> {arrayType,elementType,elementBits,dense,maxLength}, all int.
# Canonical codes preserve full models and pointer levels; maxLength bounds the
# actual index AND byte-size arithmetic, not currently available free memory.
# arrayRead returns a direct stored @[] value or a stable dense-T record using
# the actual stride. It never executes a saved graph form or preboxes all input.
# arrayAdmit performs the permitted full target-element admission before commit.
# arrayWrite writes an already admitted value without repeating tests/converters.
# Direct reference replacement for @[] is not matching the old slot's type.
# Descriptor identity, parent, ordinary bounds/lifetime and failure channels stay.
# Full contracts: ../SEQUENCES_IMPLEMENTATION.md, section 4.

# SOURCE: src/reflection.lmx
# ФИЗИЧЕСКИЕ ТИПЫ ПОЛЕЙ: сохранены три прежних ядерных варианта.
# types не является семантической сигнатурой callable. Общий анализ сигнатуры получает
# полные требования через явный FxKernel и не восстанавливает их из размеров.
# Статическая подготовка; реальное ядро здесь не запускалось.

RxTypeCodeBox:
    int: value 0

# typesRecords(S) возвращает структуру int-записей, НЕ плотный Array<int>.
# Порядок и число физических полей S сохраняются; служебные header-поля в S
# не входят. S — Structure/Array<@>, не плотный Array<T>. Пример:
# typesRecords(source := (5; 7)) даёт два кода int.
RxPhysicalTypes:
    private: @: source
    return: @
    typesRecords:
        private: @: result (copy(()))
        sys\resize(result; length(source))
        private: int: i 0
        while: i < length(source)
            private: @: box (copy(RxTypeCodeBox))
            box\value := sys\typeof(source[i])
            result[i] := box[0]
            i += 1
        return: result

# types(S): плотный Array<int>, новый массив на каждый вызов.
# int[]: result [] использует обычный конструктор типизированного пустого
# массива; конкретный синтаксис, как и весь этот файл, ещё не прогнан ядром.
# Никакого изменения типа обычной Structure через sys\resize здесь нет.
RxTypes:
    private: @: source
    return: int[]
    types:
        private: int[]: result []
        sys\resize(result; length(source))
        private: int: i 0
        while: i < length(source)
            result[i] := sys\typeof(source[i])
            i += 1
        return: result

# Точная плотная форма результата int[]: с явно переданным готовым буфером.
# types(source := S; output := buffer) изменяет buffer и возвращает тот же
# массив. S также Structure/Array<@>. Новый тип массива не выводится из () .
# Вариант позволяет переиспользовать буфер и не выделять новый при каждом вызове.
RxTypesInto:
    private:
        @: source
        int[]: output
    return: int[]
    types:
        sys\resize(output; length(source))
        private: int: i 0
        while: i < length(source)
            output[i] := sys\typeof(source[i])
            i += 1
        return: output

# SOURCE: src/adapter_frames.lmx
# CALLABLE ADAPTERS: ordinary call preparation, without eager p0... capture.
# Integration source, not a replacement interpreter. The narrow FxKernel calls
# are specified in KERNEL_REQUIREMENTS.md and ADAPTER_IMPLEMENTATION.md.
# Policy is ordinary graph data. A frame is borrowed service state of one call;
# it cannot be kept by an adapter after that call, copied or serialized.

FxInputPolicy:
    @: source 0
    @: positions 0
    @: boundPositions 0
    @: boundValues 0
    @: pendingPositions 0
    int: sourcePolicy 0

FxIndices:
    private:
        int: start
        int: count
    return: @
    make:
        throws:
            FxIndex
        if: start < 0 || count < 0
            throw: FxIndex()
        private: @: out (copy(()))
        sys\resize(out; count)
        private: int: i 0
        while: i < count
            out[i] := start + i
            i += 1
        return: out

# Own policy is used only for a genuinely new interface with no source F.
# Its ordinary declarations keep their own explicitly written policy. Merely
# creating a types-only contract adds neither required nor private nor defaults.
FxOwnPolicy:
    private: @: contract
    return: @
    make:
        throws:
            FxIndex
            FxKernelFailure
            FxTypeToken
        private: @: info FxKernel\signature(contract)
        private: @: out (copy(FxInputPolicy))
        out\source := contract
        out\positions := FxIndices\make(0; length(info\inputTypes))
        out\boundPositions := (copy(()))
        out\boundValues := (copy(()))
        out\pendingPositions := (copy(()))
        return: out

# Each external position maps to one actual source declaration. Captured inputs
# stay in the FULL source namespace, so a residual default can still read them.
# Future curry positions are not missing actuals of an attempted full call:
# the current unary contract selects only its current declaration. Their first
# value demand, if any, still uses the ordinary source declaration/uninit rule.
FxSourcePolicy:
    private:
        @: operation
        @: positions
        @: boundPositions
        @: boundValues
        @: pendingPositions
    return: @
    make:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxKernel\signature(operation)
        private: int: n length(info\inputTypes)
        if: length(boundPositions) != length(boundValues)
            throw: FxArity()
        private: @: covered (copy(()))
        sys\resize(covered; n)
        private: int: i 0
        while: i < n
            covered[i] := 0
            i += 1
        private: @: groups (positions; boundPositions; pendingPositions)
        private: int: group 0
        while: group < length(groups)
            private: @: values groups[group]
            private: int: j 0
            while: j < length(values)
                private: int: at \values[j]
                if: at < 0 || at >= n
                    throw: FxIndex()
                if: \covered[at] != 0
                    throw: FxArity()
                covered[at] := 1
                j += 1
            ---
            group += 1
        i := 0
        while: i < n
            if: \covered[i] = 0
                throw: FxArity()
            i += 1
        private: @: out (copy(FxInputPolicy))
        out\source := operation
        out\positions := FxSlice\slice(positions; 0; length(positions))
        out\boundPositions := FxSlice\slice(boundPositions; 0; length(boundPositions))
        out\boundValues := FxSlice\slice(boundValues; 0; length(boundValues))
        out\pendingPositions := FxSlice\slice(pendingPositions; 0; length(pendingPositions))
        out\sourcePolicy := 1
        return: out

FxFullPolicy:
    private: @: operation
    return: @
    make:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxKernel\signature(operation)
        private: @: empty (copy(()))
        return: FxSourcePolicy\make(operation; FxIndices\make(0; length(info\inputTypes)); empty; empty; empty)

FxPrefixPolicy:
    private:
        @: operation
        @: captured
    return: @
    make:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxKernel\signature(operation)
        private: int: n length(info\inputTypes)
        private: int: k length(captured)
        if: k > n
            throw: FxArity()
        return: FxSourcePolicy\make(operation; FxIndices\make(k; n - k); FxIndices\make(0; k); captured; (copy(())))

# These entries describe existing call transport. They are not user values,
# not a lazy Array type, and never undergo the ordinary single-Structure W/E.
# A place entry is a preserved declaration actual whose initializer reads the
# already selected source place on demand; it is NOT an eagerly evaluated `pN`.
FxTransportKinds:
    const:
        int: ready 0
        int: place 1
        int: actual 2

FxTransportEntry:
    int: position 0
    int: kind 0
    @: value
    @: frame
    int: sourcePosition 0

FxReadyEntry:
    private:
        int: position
        @: value
    return: @
    make:
        private: @: out (copy(FxTransportEntry))
        out\position := position
        out\kind := FxTransportKinds\const\ready
        out\value := value
        return: out

FxPlaceEntry:
    private:
        int: position
        @: frame
        int: sourcePosition
    return: @
    make:
        private: @: out (copy(FxTransportEntry))
        out\position := position
        out\kind := FxTransportKinds\const\place
        out\frame := frame
        out\sourcePosition := sourcePosition
        return: out

# Retain a selected explicit occurrence: ready values are not reevaluated, and
# declaration forms retain source identity/namespace substitution. Unlike place,
# this mode never manufactures an explicit argument from an omitted position.
FxActualEntry:
    private:
        int: position
        @: frame
        int: sourcePosition
    return: @
    make:
        private: @: out FxPlaceEntry\make(position; frame; sourcePosition)
        out\kind := FxTransportKinds\const\actual
        return: out

FxFrameEntries:
    private: @: frame
    return: @
    make:
        private: @: out (copy(()))
        sys\resize(out; length(frame\inputTypes))
        private: int: i 0
        while: i < length(out)
            out[i] := FxPlaceEntry\make(i; frame; i)
            i += 1
        return: out

FxFrameRead:
    private:
        @: frame
        int: index
    return: @
    read:
        throws:
            FxCallFailure
            FxIndex
            FxKernelFailure
            FxTypeToken
        private: @: slot FxKernel\frameSlot(frame; index; demand := 1)
        return: slot\value

FxFrameAttempt:
    private: @: frame
    return: @
    attempt:
        throws:
            FxKernelFailure
            FxTypeToken
        return: FxKernel\enter(frame; frame\failures)

FxFrameApply:
    private: @: frame
    return: @
    apply:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
        private: @: outcome FxFrameAttempt\attempt(frame)
        if: outcome\ok = 0
            throw: FxCallFailure(outcome)
        return: outcome\value

# No factory/global context parameter. This is an ordinary invocation at the
# reached call site. The source-frame link belongs only to an explicit actual;
# additional optional inputs of the callback follow its own normal call chain.
FxInvokeEntries:
    private:
        @: operation
        @: entries
        @: failures
    return: @
    attempt:
        throws:
            FxKernelFailure
            FxTypeToken
        private: @: prepared FxKernel\prepare(operation; entries)
        finally:
            FxKernel\releaseCall(prepared)
        ---
        return: FxKernel\enter(prepared; failures)

FxApplyEntries:
    private:
        @: operation
        @: entries
    return: @
    apply:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
        private: @: info FxKernel\signature(operation)
        private: @: outcome FxInvokeEntries\attempt(operation; entries; info\throws)
        if: outcome\ok = 0
            throw: FxCallFailure(outcome)
        return: outcome\value

FxApplyPlaces:
    private:
        @: operation
        @: frame
    return: @
    apply:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
        return: FxApplyEntries\apply(operation; FxFrameEntries\make(frame))

# Memoization explicitly observes all exposed accepted values, in position order,
# BEFORE comparison/body. This is its documented key policy, never FxWrap policy.
# Primitive capture is by value; reference targets retain identity and lifetime.
FxFrameSnapshot:
    private: @: frame
    return: @
    snapshot:
        throws:
            FxCallFailure
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: out (copy(()))
        sys\resize(out; length(frame\inputTypes))
        private: int: i 0
        while: i < length(out)
            private: @: value FxFrameRead\read(frame; i)
            out[i] := FxCaptureOne\capture(frame\inputTypes[i]; value)
            i += 1
        return: out

FxArgumentObservation:
    int: position 0
    int: supplied 0
    int: ready 0
    int: declaration 0
    int: ownPlace 0
    int: transparentPlace 0
    char[]: state ""
    @: requirement 0
    @: value

# Observation contains NO live frame/cell/context capability. A ready value is
# available; a non-ready value is absent, not represented by an explicit @0.
# This prevents a retained trace event from reading an expired activation.
FxFrameObserve:
    private: @: frame
    return: @
    observe:
        throws:
            FxIndex
            FxKernelFailure
            FxTypeToken
        private: @: out (copy(()))
        sys\resize(out; length(frame\inputTypes))
        private: int: i 0
        while: i < length(out)
            private: @: slot FxKernel\frameSlot(frame; i; demand := 0)
            private: @: observation (copy(FxArgumentObservation))
            observation\position := i
            observation\supplied := slot\supplied
            observation\ready := slot\ready
            observation\declaration := slot\declaration
            observation\ownPlace := slot\ownPlace
            observation\transparentPlace := slot\transparentPlace
            observation\state := slot\state
            observation\requirement := slot\requirement
            if: slot\ready != 0
                observation\value := slot\value
            out[i] := observation
            i += 1
        return: out

FxForwardEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
        return: FxFrameApply\apply(frame)

# SOURCE: src/generic_functions.lmx
# ОБЩИЕ lambda / partial / uncurry / flip.
# Любое конечное число входов, их полные требования типов и исходный результат.
# Это исходники целевой реализации интеграции. FxKernel — явно перечисленный в KERNEL_REQUIREMENTS.md
# адаптер к существующим анализатору сигнатур и строителю графа, не готовый API.
# Операции не компилируют себя автоматически и не переиспользуют native от
# прототипа с другим ABI. Создаются обычные owner -> DATA -> CODE.
# Вызов результата начинает обычную активацию над его настоящим parent.
# Public labels p0,p1,... map to actual source declarations. Their defaults,
# required/private and binding names are retained by the explicit input policy.
# Все захваченные зависимости — явные поля state; private не даёт им становиться
# случайными динамическими входами исходного callable.
#
# prefix is any ready Array: Structure/@[] supplies stored value records;
# dense T[] supplies one actual through its real typed access. It is never
# reinterpreted as a pointer array. Примитивы принимаются
# и сохраняются по значению; ссылочные значения сохраняют цель. copy(prefix)
# для этого НЕ используется, поскольку он глубоко копировал бы цели ссылок.
#
# Схема FxKernel\signature(subject): inputTypes, resultType, hasResult, names,
# throws. subject — callable либо fn-описание. resultType всегда имеет описание,
# в том числе для void. hasResult не заменяет и не кодирует тип числовым нулём.
# FxKernel\callable(contract; labels; bodyGraph; state; failures; policy) формирует
# обычный граф; внутри тела node\private\state даёт именно переданный state.

# Снимок уже принятого значения через существующий prepared operand protocol.
# Ресивер принимает указатель на значение слева; RHS не разворачивает его.
# Для postfix (value record) общий handler передаёт present empty right Array.
# Поддержка lifetime проверяется отдельно в приёмке для четырёх комбинаций executors.
FxRecordOperands:
    copy: sys\OPERANDS_TEMPLATE
    required: left right
    return: @
    record:
        throws:
            FxRecordArity
        if: length(right) != 0
            throw: FxRecordArity()
        return: left

# Неинициализированная запись @ служит TYPE SPEC, а не нулевым значением.
FxTypeTokens:
    reference:
        @: value

# Имена исходов передаются builder как обычные LMX-строки. Builder интернирует
# их при создании throws, но строки не притворяются заранее готовыми name atoms.
FxCaptureFailures:
    return: @
    names:
        private: @: out (copy(()))
        sys\resize(out; 1)
        out[0] := "FxRecordArity"
        return: out

FxStageFailures:
    return: @
    names:
        private: @: out (copy(()))
        sys\resize(out; 5)
        out[0] := "FxIndex"
        out[1] := "FxArity"
        out[2] := "FxRecordArity"
        out[3] := "FxTypeToken"
        out[4] := "FxKernelFailure"
        return: out

# Конкатенация LMX-строк. Вспомогательные процедуры тоже написаны на LMX.
# Binary string concatenation keeps its contract and delegates storage work to
# the single generic concat algorithm; equal char[] parts yield fresh char[].
FxConcat:
    private:
        char[]: first
        char[]: second
    return: char[]
    concat:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: out FxSeqConcat\concat(parts := (first; second))
        return: \out

FxDecimal:
    private: int: number
    return: char[]
    decimal:
        throws:
            FxIndex
        if: number < 0
            throw: FxIndex()
        private: char[]: digits "0123456789"
        private: char[]: reversed []
        private: int: used 0
        private: int: rest number
        while: 1
            sys\resize(reversed; used + 1)
            reversed[used] := digits[rest % 10]
            used += 1
            rest := rest / 10
            if: rest = 0
                break
        ---
        private: char[]: out []
        sys\resize(out; used)
        private: int: i 0
        while: i < used
            out[i] := reversed[used - i - 1]
            i += 1
        return: out

# Для сгенерированных публичных имён используется только ASCII p + digits.
# Отдельное точное имя пригодится клиентам строителя для произвольных labels.
# Его вход — допустимое имя без NUL; это ограничение exact identifier в грамматике.
FxExactIdentifier:
    private: char[]: name
    return: char[]
    quote:
        private: char[]: out []
        private: int: extra 0
        private: int: i 0
        while: i < length(name)
            if: name[i] = '`'
                extra += 1
            i += 1
        sys\resize(out; length(name) + extra + 2)
        out[0] := '`'
        private: int: at 1
        i := 0
        while: i < length(name)
            out[at] := name[i]
            at += 1
            if: name[i] = '`'
                out[at] := '`'
                at += 1
            i += 1
        out[at] := '`'
        return: out

FxLabels:
    private: int: count
    return: @
    labels:
        throws:
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        if: count < 0
            throw: FxIndex()
        private: @: out (copy(()))
        sys\resize(out; count)
        private: int: i 0
        while: i < count
            out[i] := FxConcat\concat("p"; FxDecimal\decimal(i))
            i += 1
        return: out

# Historical helper contract is reference-vector start/count. The public slice
# is generic and uses begin/end. Keep this checked adapter, not a second loop.
FxSlice:
    private:
        @[]: values
        int: start
        int: count
    return: @
    slice:
        throws:
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        if: start < 0 || count < 0 || start > length(values)
            throw: FxIndex()
        if: count > length(values) - start
            throw: FxIndex()
        return: FxSeqSlice\slice(source := values; begin := start; end := start + count)

# Name :: DATA создаёт описание сигнатуры, не исполняемое тело.
# Used by the existing signatureTypes operand and the general factories.
# Normalized @ references point to canonical int type-code records; the current
# type registry retains full models, and no public boxed Type kind is added.
FxSignatures:
    private:
        @: inputs
        @: result
    return: @
    make:
        throws:
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: labels FxLabels\labels(length(inputs))
        private: @: data FxKernel\signatureData(inputs := inputs; result := result; labels := labels)
        Built :: data
        return: Built

FxBuild:
    private:
        @: contract
        char[]: bodyText
        @: state
        @: failures
        @: policy 0
    return: @
    make:
        throws:
            FxIndex
            FxKernelFailure
            FxTypeToken
        private: @: shape FxKernel\signature(subject := contract)
        private: @: bodyGraph sys\fromLmx(bodyText)
        private: @: selectedPolicy policy
        if: selectedPolicy = 0
            selectedPolicy := FxOwnPolicy\make(contract)
        return: FxKernel\callable(contract; shape\names; bodyGraph; state; failures; selectedPolicy)

FxCaptureState:
    @: record 0

# Получатель Ti -> @ использует штатное принятие аргумента, затем возвращает
# запись уже принятого значения. Здесь нет независимого алгоритма conversion.
FxCaptureOne:
    private:
        @: requirement
        @: sourceRecord
    return: @
    capture:
        throws:
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: inputTypes (copy(()))
        sys\resize(inputTypes; 1)
        inputTypes[0] := requirement
        private: @: referenceType FxKernel\normalizeType(token := FxTypeTokens\reference[0])
        private: @: contract FxSignatures\make(inputTypes; referenceType)
        private: @: state (copy(FxCaptureState))
        state\record := FxRecordOperands\record
        private: @: failures FxCaptureFailures\names()
        # FxRecordArity невозможно при написанном пустом RHS, но имя включается
        # в явный контракт тела как объявленный исход используемого операнда.
        private: @: receiver FxBuild\make(contract; "return: (p0 node\\private\\state\\record)\n"; state; failures)
        return: receiver(p0 := \sourceRecord)

FxCapturePrefix:
    private:
        @: inputTypes
        @: prefix
    return: @
    capture:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceSize
        if: length(prefix) > length(inputTypes)
            throw: FxArity()
        private: @: captured (copy(()))
        sys\resize(captured; length(prefix))
        private: int: i 0
        while: i < length(prefix)
            captured[i] := FxCaptureOne\capture(inputTypes[i]; FxSeqRead\read(prefix; i))
            i += 1
        return: captured

# A ready prefix is admitted once at construction. The full source namespace
# remains available on each call, including captured inputs needed by defaults.
# No absent residual position is emitted as a fictitious explicit actual.
FxPartial:
    private:
        @: operation
        @: prefix
    return: @
    partial:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxKernel\signature(subject := operation)
        private: int: n length(info\inputTypes)
        private: int: k length(prefix)
        if: k > n
            throw: FxArity()
        private: @: captured FxCapturePrefix\capture(info\inputTypes; prefix)
        private: @: remaining FxSlice\slice(info\inputTypes; k; n - k)
        private: @: contract FxSignatures\make(remaining; info\resultType)
        private: @: policy FxPrefixPolicy\make(operation; captured)
        return: FxWrap\make(contract; FxForwardEngine\run; (copy(())); info\throws; policy)

FxCurryState:
    @: target 0
    @: info 0
    @: prefix 0
    @: stageBuilder 0

# Finishing a non-final curry stage consumes precisely its current input, as
# required by stagewise capture. Future inputs are not read by the transport.
# Only the resulting ordinary value record survives; no borrowed frame does.
FxLambdaMiddleEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws:
            FxArity
            FxCallFailure
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: int: k length(state\prefix)
        private: @: value FxFrameRead\read(frame; 0)
        private: @: captured FxCaptureOne\capture(state\info\inputTypes[k]; value)
        private: @: next FxAppend\append(state\prefix; FxOne\make(captured))
        return: state\stageBuilder(operation := state\target; info := state\info; prefix := next)

FxLambdaStages:
    private:
        @: operation
        @: info
        @: prefix
    return: @
    build:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: inputs info\inputTypes
        private: int: n length(inputs)
        private: int: k length(prefix)
        if: k > n
            throw: FxArity()
        private: int: count 0
        if: k < n
            count := 1
        private: @: ownInputs FxSlice\slice(inputs; k; count)
        private: @: ownResult info\resultType
        private: @: engine FxForwardEngine\run
        private: @: failures info\throws
        if: k + 1 < n
            ownResult := FxKernel\normalizeType(token := FxTypeTokens\reference[0])
            engine := FxLambdaMiddleEngine\run
            failures := FxFailures\union(failures; FxStageFailures\names())
        private: @: contract FxSignatures\make(ownInputs; ownResult)
        private: @: state (copy(FxCurryState))
        state\target := operation
        state\info := info
        state\prefix := prefix
        state\stageBuilder := FxLambdaStages\build
        private: @: policy FxSourcePolicy\make(operation; FxIndices\make(k; count); FxIndices\make(0; k); prefix; FxIndices\make(k + count; n - k - count))
        return: FxWrap\make(contract; engine; state; failures; policy)

# curry(F) creates ordinary unary stages for any finite input count.
# Its own middle-stage protocol returns a callable reference; uncurry below
# does NOT require external chains to use this same result description.
# N=0 is a delayed nullary call. A callable final R is a final value.
FxLambda:
    private: @: operation
    return: @
    lambda:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxKernel\signature(subject := operation)
        return: FxLambdaStages\build(operation; info; (copy(())))

FxFlip:
    private: @: operation
    return: @
    flip:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            ReceiverPermutation
            SequenceSize
        private: @: info FxKernel\signature(subject := operation)
        private: int: n length(info\inputTypes)
        if: n < 2
            throw: FxArity()
        private: @: positions FxIndices\make(0; n)
        positions[0] := 1
        positions[1] := 0
        return: FxPermute\permute(operation; positions)

FxUncurryState:
    @: operation 0
    @: contract 0
    @: failures 0
    int: count 0
    int: hasResult 0

# A reached actual stage is inspected without calling it; its full native or
# interpreted contract is retained by prepare. Transport @ is only a reference
# to that value record, never a demand that its declared result be @.
FxUncurryEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws:
            FxArity
            FxCallFailure
            FxIndex
            FxKernelFailure
            FxTypeToken
        private: @: current state\operation
        private: int: n state\count
        private: int: i 0
        while: 1
            private: @: stageInfo FxKernel\signature(current)
            private: int: expected 1
            if: n = 0
                expected := 0
            if: length(stageInfo\inputTypes) != expected
                throw: FxArity()
            if: n = 0 || i + 1 = n
                if: stageInfo\hasResult != state\hasResult
                    throw: FxTypeToken()
            ---
            private: @: entries (copy(()))
            if: n != 0
                private: @: supplied FxKernel\frameSlot(frame; i; demand := 0)
                if: supplied\supplied != 0
                    entries := FxOne\make(FxActualEntry\make(0; frame; i))
            ---
            private: @: outcome FxInvokeEntries\attempt(current; entries; state\failures)
            if: outcome\ok = 0
                throw: FxCallFailure(outcome)
            if: n = 0 || i + 1 = n
                return: outcome\value
            if: stageInfo\hasResult = 0
                throw: FxArity()
            current := outcome\value
            i += 1

# The explicit contract defines N and final R. No stage is probed at creation.
# Its type-only outer shape never transfers a named template default to an
# actual stage. Missing outer actuals stay missing on that reached stage call;
# its own default/required policy applies there. Final reception uses normal R.
FxUncurry:
    private:
        @: operation
        @: contract
        @: failures
    return: @
    uncurry:
        throws:
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxKernel\signature(subject := contract)
        private: @: state (copy(FxUncurryState))
        state\operation := operation
        state\contract := contract
        state\failures := failures
        state\count := length(info\inputTypes)
        state\hasResult := info\hasResult
        private: @: flatContract FxSignatures\make(info\inputTypes; info\resultType)
        return: FxWrap\make(flatContract; FxUncurryEngine\run; state; failures; FxOwnPolicy\make(flatContract))

# SOURCE: src/fn_operand.lmx
# SIGNATURETYPES КАК ЯДЕРНЫЙ ОПЕРАНД: left — тип результата; right — типы входов.
# Именованное объявление теперь пишется Name :: Signature. Прежний declaration
# receiver полностью удалён, совместимый alias не сохраняется.
# signatureTypes — обычное ядерное имя type-token конструктора, не отдельный reserved
# declaration head. Его обнаружение идёт по общей структуре OPERANDS_TEMPLATE.
# Созданное описание совместимо с Name :: Signature по общим правилам типов.
#
# copy стоит первым. Готовые PASS_ARGS_AS_IS=0 и PRIORITY унаследованы
# из sys\OPERANDS_TEMPLATE; повторного объявления этих const-полей нет.
# Публичный результат — @ на обычное описание сигнатуры, а не новая функция.
# right подготовлен общим обработчиком по текущим правилам uploaded docs.
# При левом type-токене справа остаётся цепочка написанных операндов.
# Одиночная (T0 T1) не превращается автоматически в список типов: это один
# контейнер-токен. Исключение: написанный anonymous left, right.length=1,
# right[0] — написанная anonymous Structure. Снимается только внешний RHS-уровень;
# left целиком, вложенный RHS повторно не открывается, function result не открывается.
# Обычный make(left := token; right := typeRecords) явно передаёт вектор.
# normalizeType читает ровно переданную запись: int payload как type code,
# uninit:T как T без payload, void либо полное существующее требование.
FxSignatureOperand:
    copy: sys\OPERANDS_TEMPLATE
    required: left right
    return: @
    make:
        throws:
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        if: left = 0
            throw: FxTypeToken()
        private: @: resultType FxKernel\normalizeType(token := left)
        private: @: inputTypes (copy(()))
        sys\resize(inputTypes; length(right))
        private: int: i 0
        while: i < length(right)
            inputTypes[i] := FxKernel\normalizeType(token := right[i])
            i += 1
        return: FxSignatures\make(inputs := inputTypes; result := resultType)

# SOURCE: src/generic_runtime.lmx
# ОБЩИЙ ТИПИЗИРОВАННЫЙ ПРОТОКОЛ ЗНАЧЕНИЙ.
# Ссылка указывает на запись {type,payload}, а не на сам payload.
# Structure / Array<@> хранит такие ссылки. Вектор (5; "x") содержит
# int- и string-записи, а не дополнительные @-обёртки над этими записями.
# Плотный Array<T> остаётся отдельным значением; не reinterpret_cast массива.
# attempt/raise — тонкие границы обычного call/catch, см. KERNEL_REQUIREMENTS.md.
# Они не реализуют map, partial, memo, контейнеры или другие алгоритмы.

FxRecords:
    private: @: value
    return: @
    reference:
        throws:
            FxRecordArity
        return: (value FxRecordOperands\record)

FxOne:
    private: @: value
    return: @
    make:
        private: @: out (copy(()))
        sys\resize(out; 1)
        out[0] := value
        return: out

FxTwo:
    private:
        @: first
        @: second
    return: @
    make:
        private: @: out (copy(()))
        sys\resize(out; 2)
        out[0] := first
        out[1] := second
        return: out

# Fresh reference concatenation is retained, even if a caller supplies dense
# parts. The explicit empty @[] part selects concat's mixed/reference profile;
# this adds no user data element and introduces no second copying algorithm.
FxAppend:
    private:
        @: first
        @: second
    return: @
    append:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: empty (copy(()))
        return: FxSeqConcat\concat(parts := (empty; first; second))

# Snapshot применяет штатное принятие Ti, не глубокую copy целевых графов.
# Semantic types match the supplied formal positions. Only written ready
# actuals are captured; missing positions remain absent on each ordinary call.
FxArguments:
    private:
        @: operation
        @: args
    return: @
    capture:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxKernel\signature(subject := operation)
        if: length(args) > length(info\inputTypes)
            throw: FxArity()
        return: FxCapturePrefix\capture(info\inputTypes; args)

FxApply:
    private:
        @: operation
        @: args
    return: @
    apply:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
        private: @: outcome FxTry\attempt(operation := operation; args := args)
        if: outcome\ok = 0
            throw: FxCallFailure(outcome)
        return: outcome\value

# FxWrap's engine receives the already selected ordinary call frame. Obtaining
# this handle reads neither optional inputs nor computed defaults. The public
# function still has exact T0...Tn -> R; its result is not changed to @.
FxEngineState:
    @: engine 0
    @: payload 0

FxWrap:
    private:
        @: contract
        @: engine
        @: payload
        @: failures
        @: policy 0
    return: @
    make:
        throws:
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxKernel\signature(subject := contract)
        private: @: state (copy(FxEngineState))
        state\engine := engine
        state\payload := payload
        private: char[]: text "private: @: fx_frame FxKernel\\currentCall(node)\nprivate: @: fx_engine node\\private\\state\\engine\nprivate: @: fx_answer fx_engine(state := node\\private\\state\\payload; frame := fx_frame)\n"
        if: info\hasResult != 0
            text := FxConcat\concat(text; "return: \\fx_answer\n")
        else:
            text := FxConcat\concat(text; "return\n")
        text := FxConcat\concat(text; "catch: FxCallFailure (@: outcome)\n    FxKernel\\raise(name := outcome\\failure; payload := outcome\\payload)\n")
        private: @: engineInfo FxKernel\signature(subject := engine)
        private: @: escapingEngine FxFailureFilter\without(engineInfo\throws; "FxCallFailure")
        private: @: allFailures FxFailures\union(failures; FxStageFailures\names())
        allFailures := FxFailures\union(allFailures; escapingEngine)
        return: FxBuild\make(contract; text; state; allFailures; policy)

FxOutcome:
    int: ok 0
    @: value 0
    char[]: failure ""
    @: payload 0

FxTry:
    private:
        @: operation
        @: args
    return: @
    attempt:
        throws:
            FxKernelFailure
            FxTypeToken
        private: @: info FxKernel\signature(subject := operation)
        return: FxKernel\attempt(operation; args; info\throws)

FxFailures:
    private:
        @: first
        @: second
    return: @
    union:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        # Builder интернирует и устраняет повторные имена. Список не фиксирован.
        return: FxAppend\append(first; second)

# Сравнение строк и фильтр имён служат только finite throws bookkeeping.
# Отфильтрована внутренняя ПОЙМАННАЯ оболочка engine; исходные target failures
# добавляются отдельно, поэтому target по-прежнему может сам бросать FxCallFailure.
FxSameText:
    private:
        char[]: first
        char[]: second
    return: int
    same:
        if: length(first) != length(second)
            return: 0
        private: int: i 0
        while: i < length(first)
            if: first[i] != second[i]
                return: 0
            i += 1
        return: 1

FxFailureFilter:
    private:
        @: names
        char[]: excluded
    return: @
    without:
        private: @: out (copy(()))
        sys\resize(out; length(names))
        private: int: used 0
        private: int: i 0
        while: i < length(names)
            private: char[]: name \names[i]
            if: FxSameText\same(name; excluded) = 0
                out[used] := names[i]
                used += 1
            i += 1
        sys\resize(out; used)
        return: out

# SOURCE: src/reflection_bridges.lmx
# СЕМАНТИЧЕСКАЯ СИГНАТУРА И ИМЕНА СУЩЕСТВУЮЩЕГО ЧИСТОГО ГРАФА.
# Имена читаются по owning-field record, не через sys\name(ptr), которое
# означает написанный идентификатор ptr. Не используется замена строк исходника.

RxSignature:
    private: @: operation
    return: @
    signature:
        throws:
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxKernel\signature(subject := operation)
        return: FxSignatures\make(inputs := info\inputTypes; result := info\resultType)

# Один элемент на физическое поле, порядок и повторы сохраняются.
# Именованное поле: готовая LMX-строка; безымянное: uninit:Array<char>, без payload.
# Пустое exact name не совпадает с отсутствием имени; никакого NUL-сентинела.
RxNames:
    private: @: source
    return: @
    names:
        throws:
            FxKernelFailure
            FxTypeToken
        return: FxKernel\fieldNames(source := source)

# Один общий copy сохраняет циклы, общие рёбра и parent-карту.
# Переименовываются выбранные owning fields новой копии; исходник неизменён.
# indices — обычная Structure int-записей; labels — строки/отсутствия имени.
RxRename:
    private:
        @: source
        @: indices
        @: labels
    return: @
    rename:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
        if: length(indices) != length(labels)
            throw: FxArity()
        private: int: i 0
        while: i < length(indices)
            private: int: at \indices[i]
            if: at < 0 || at >= length(source)
                throw: FxIndex()
            private: int: j 0
            while: j < i
                if: \indices[j] = at
                    throw: FxIndex()
                j += 1
            i += 1
        private: @: result (copy(source))
        FxKernel\renameFields(target := result; indices := indices; labels := labels)
        return: result

# SOURCE: src/containers.lmx
# КОНТЕЙНЕРЫ НАД ЗАПИСЬЮ ЛЮБОГО ТИПА.
# value — @ на полноценную type/value запись. Тег не заменяется на int.
# present / ok / done — состояния протокола, а не тип пользовательского value.
# Пустая строка, 0, @0, пустая структура и отсутствующее значение различаются.

FxMaybe:
    int: present 0
    @: value 0

FxSome:
    private: @: value
    return: @
    some:
        private: @: result (copy(FxMaybe))
        result\present := 1
        result\value := value
        return: result

FxNone:
    return: @
    none:
        return: (copy(FxMaybe))

FxBind:
    private:
        FxMaybe@: input
        @: next
    return: @
    bind:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
        if: input\present = 0
            return: input
        private: @: record FxApply\apply(next; FxOne\make(input\value))
        private: FxMaybe@: result record
        return: result

# Result также не фиксирует тип полезного значения или причины неуспеха.
FxResult:
    int: ok 0
    @: value 0
    @: reason 0

FxOk:
    private: @: value
    return: @
    ok:
        private: @: result (copy(FxResult))
        result\ok := 1
        result\value := value
        return: result

FxErr:
    private: @: reason
    return: @
    err:
        private: @: result (copy(FxResult))
        result\reason := reason
        return: result

FxBindResult:
    private:
        FxResult@: input
        @: next
    return: @
    bindResult:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
        if: input\ok = 0
            return: input
        private: @: record FxApply\apply(next; FxOne\make(input\value))
        private: FxResult@: result record
        return: result

# List — последовательность записей, а не неизменяемый связный список.
# Список копируется поверхностно: типы и цели ссылочных значений сохранены.
# Its input is now any admitted Array, including dense values, via one @.
FxList:
    private:
        @: values
    required: values
    return: @
    list:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        return: FxSeqList\list(values)

FxListBind:
    private:
        @: items
        @: next
    required: items next
    return: @
    flatMap:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        return: FxSeqFlatMap\flatMap(items; next)

# Bounce stores either a final value record or an ordinary nullary callable.
# partial(F; allArgs) may construct that thunk for any number of F inputs.
# trampoline stops on done, not merely on whether the value is callable.
FxBounce:
    int: done 0
    @: value 0
    @: next 0

FxDone:
    private: @: value
    return: @
    done:
        private: @: result (copy(FxBounce))
        result\done := 1
        result\value := value
        return: result

FxMore:
    private: @: thunk
    return: @
    more:
        throws:
            FxArity
            FxKernelFailure
            FxTypeToken
        private: @: shape FxKernel\signature(subject := thunk)
        if: length(shape\inputTypes) != 0
            throw: FxArity()
        private: @: result (copy(FxBounce))
        result\next := thunk
        return: result

FxTrampoline:
    private: FxBounce@: current
    return: @
    trampoline:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
        private: @: empty (copy(()))
        while: current\done = 0
            private: @: record FxApply\apply(current\next; empty)
            current := \record
        return: current\value

# SOURCE: src/sequences_core.lmx
# UNIVERSAL ARRAY ACCESS. These are common value/layout helpers, not a new
# Sequence object. A Structure already is @[]; dense T[] keeps its real stride.
# Only arrayInfo/arrayRead/arrayAdmit/arrayWrite are narrow kernel boundaries.
# All sequence algorithms are ordinary LMX in this package.
# No helper executes a selected graph field or applies callable W/E to it.
# arrayInfo returns ordinary metadata: arrayType, elementType, elementBits,
# dense, maxLength. Type codes are int; maxLength bounds length AND byte size.

FxSeqInfo:
    private: @: source
    required: source
    return: @
    get:
        throws:
            FxKernelFailure
            FxTypeToken
        return: FxKernel\arrayInfo(source := source)

FxSeqRead:
    private:
        @: source
        int: index
    required: source index
    return: @
    read:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
        return: FxKernel\arrayRead(source := source; index := index)

# The declaration head is an existing full int type code, resolved by the
# common TYPE-role path. It is not a private sequence type constructor.
FxSeqAllocate:
    private:
        int: arrayType
        int: count
    required: arrayType count
    return: @
    make:
        throws:
            FxKernelFailure
            FxTypeToken
            SequenceSize
        if: count < 0
            throw: SequenceSize()
        private: @: out (arrayType: [])
        private: @: info FxSeqInfo\get(out)
        if: count > info\maxLength
            throw: SequenceSize()
        sys\resize(out; count)
        return: out

FxSeqEmpty:
    private: @: source
    required: source
    return: @
    make:
        throws:
            FxKernelFailure
            FxTypeToken
            SequenceSize
        private: @: info FxSeqInfo\get(source)
        return: FxSeqAllocate\make(info\arrayType; 0)

# Check before adding. The limit is supplied by actual element layout; no
# fixed native word size or fixed upper bound occurs in the algorithms.
FxSeqSize:
    private:
        int: base
        int: extra
        int: limit
    required: base extra limit
    return: int
    sum:
        throws:
            SequenceSize
        if: base < 0 || extra < 0 || base > limit
            throw: SequenceSize()
        if: extra > limit - base
            throw: SequenceSize()
        return: base + extra

FxSeqBounds:
    private:
        @: source
        int: begin
        int: end
    required: source begin end
    return: int
    count:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
        FxSeqInfo\get(source)
        if: begin < 0 || end < begin || end > length(source)
            throw: ReceiverIndex()
        return: end - begin

# Ordinary admission of one value to the actual target's full requirement.
# No hidden user converter or initializer is introduced. Required value checks
# stay in this preparation phase; the later prepared write cannot repeat them.
# @[] accepts the direct value reference, independently of former slot content.
FxSeqAdmit:
    private:
        @: target
        @: value
    required: target value
    return: @
    admit:
        throws:
            FxKernelFailure
            FxTypeToken
            SequenceElement
        return: FxKernel\arrayAdmit(target := target; value := value)

FxSeqStore:
    private:
        @: target
        int: index
        @: value
    required: target index value
    write:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceElement
        private: @: ready FxSeqAdmit\admit(target; value)
        FxKernel\arrayWrite(target := target; index := index; value := ready)

FxSeqPush:
    private:
        @: target
        @: value
    required: target value
    return: @
    append:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceElement
            SequenceSize
        private: @: info FxSeqInfo\get(target)
        private: @: ready FxSeqAdmit\admit(target; value)
        private: int: oldSize length(target)
        private: int: newSize FxSeqSize\sum(oldSize; 1; info\maxLength)
        sys\resize(target; newSize)
        FxKernel\arrayWrite(target := target; index := oldSize; value := ready)
        return: target

# Explicitly requested record vector / call transport. Collections themselves
# read one element at a time and do not prebox the complete dense source.
FxSeqRecords:
    private: @: source
    required: source
    return: @
    make:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        FxSeqInfo\get(source)
        private: int: count length(source)
        private: @: out FxSeqAllocate\make(@[]; count)
        private: int: i 0
        while: i < count
            out[i] := FxSeqRead\read(source; i)
            i += 1
        return: out

# Integer admission for masks/indices is exact: a nonzero machine address is
# not a truth value. uninit:int is a different record and has no payload.
FxSeqInteger:
    private: @: value
    required: value
    return: int
    read:
        throws:
            SequenceElement
        private: int: sample 0
        if: sys\typeof(value) != sys\typeof(@sample)
            throw: SequenceElement()
        return: \value

FxSeqPredicate:
    private: @: value
    required: value
    return: int
    truth:
        throws:
            FxPredicate
        private: int: sample 0
        if: sys\typeof(value) != sys\typeof(@sample)
            throw: FxPredicate()
        private: int: flag \value
        return: flag != 0

# SOURCE: src/sequences_selection.lmx
# Selection and list construction share the universal array access layer.
# The private index vector is only a checked snapshot of explicit indices.
# It is not a second graph, an environment copy, or a user-visible container.

FxSeqIndices:
    private:
        @: source
        @: indices
    required: source indices
    return: @
    check:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        FxSeqInfo\get(source)
        FxSeqInfo\get(indices)
        private: int: total length(source)
        private: int: count length(indices)
        private: @: checked FxSeqAllocate\make(int[]; count)
        private: int: i 0
        while: i < count
            private: @: value FxSeqRead\read(indices; i)
            private: int: at \value
            if: at < 0 || at >= total
                throw: ReceiverIndex()
            checked[i] := at
            i += 1
        return: checked

# positions has already been checked in full. All new slots use the source's
# actual profile; a chosen dense primitive is copied, not exposed as a view.
FxSeqSelection:
    private:
        @: source
        int[]: positions
    required: source positions
    return: @
    copySelected:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxSeqInfo\get(source)
        private: int: count length(positions)
        private: @: out FxSeqAllocate\make(info\arrayType; count)
        private: int: i 0
        while: i < count
            private: @: value FxSeqRead\read(source; positions[i])
            FxKernel\arrayWrite(target := out; index := i; value := value)
            i += 1
        return: out

FxSeqSelect:
    private:
        @: source
        @: indices
    required: source indices
    return: @
    select:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: positions FxSeqIndices\check(source; indices)
        return: FxSeqSelection\copySelected(source; positions)

FxSeqOmit:
    private:
        @: source
        @: indices
    required: source indices
    return: @
    omit:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: positions FxSeqIndices\check(source; indices)
        private: @: info FxSeqInfo\get(source)
        private: int: count length(source)
        private: @: excluded FxSeqAllocate\make(int[]; count)
        private: int: i 0
        while: i < count
            excluded[i] := 0
            i += 1
        i := 0
        while: i < length(positions)
            excluded[positions[i]] := 1
            i += 1
        private: @: out FxSeqAllocate\make(info\arrayType; count)
        private: int: used 0
        i := 0
        while: i < count
            if: excluded[i] = 0
                private: @: value FxSeqRead\read(source; i)
                FxKernel\arrayWrite(target := out; index := used; value := value)
                used += 1
            i += 1
        sys\resize(out; used)
        return: out

FxSeqReorder:
    private:
        @: source
        @: permutation
    required: source permutation
    return: @
    reorder:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            ReceiverPermutation
            SequenceSize
