# Witness: a formal written as an argument of a modifier takes the value supplied for it
# Norm: the book #declaration-selection (its table), #admission; the plan #two-kinds-of-receivers-plan item 1; R65-R68, R71, R76.
# Slice «selection of the declaration by the call» (plan #two-kinds-of-receivers-plan).
(
    Observed:
        int: seen 0
)
@: shared data[0]

fn: twice (const: int: a 1) int
    return: a * 2

sub: main () (
    int: k 0
)
    shared\Observed\seen := twice(21)
main()
