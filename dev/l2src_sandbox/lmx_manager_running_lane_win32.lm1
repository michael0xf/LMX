include: "<windows.h>"
predef: "l2src/lmx_manager_running.h.lm1"

# The look and the pause live here, not in the manager body. That body inlines
# the clock and the turn, so a selftest that already inlined those cannot also
# link it. This file names only the platform call.

fn: lmx_manager_running_lane_ended (@: LmxSchedule slot) int
    if: slot = 0 || slot\lane = 0
        return: 1
    if: c.WaitForSingleObject(slot\lane, 0U) = c.WAIT_OBJECT_0
        return: 1
return: 0

fn: lmx_manager_running_pause_ms (unsigned: ms) int
    c.Sleep((cast: (DWORD) ms))
return: 0

fn: lmx_mgr_work_entry (@: void arg) DWORD
    LmxManagerWork: work
    work: (cast: (LmxManagerWork) arg)
    if: work = 0
        return: 0U
    return: (cast: (DWORD) work(0))

fn: lmx_manager_running_thread_start (LmxManagerWork: work) @: void
return: (cast: (@: void) c.CreateThread(0, 0U, (cast: (LPTHREAD_START_ROUTINE) lmx_mgr_work_entry), (cast: (@: void) work), 0U, 0))

fn: lmx_manager_running_thread_running (@: void handle) int
    if: handle = 0
        return: 0
    if: c.WaitForSingleObject(handle, 0U) = c.WAIT_TIMEOUT
        return: 1
return: 0

fn: lmx_manager_running_thread_join (@: void handle) int
    if: handle = 0
        return: 0
    c.WaitForSingleObject(handle, c.INFINITE)
    c.CloseHandle(handle)
return: 0

fn: lmx_manager_running_thread_id () size_t
return: (cast: (size_t) c.GetCurrentThreadId())
