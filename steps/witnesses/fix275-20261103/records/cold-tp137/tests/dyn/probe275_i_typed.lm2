# Probe 275: a typed statement rebinds a nested slot to another layout from a method.  Entry 7.
Other:
    int: z 9
    int: y 7
end: Other
Box:
    kid:
        int: y 3
    end: kid
end: Box
fn: m () int
    Box\kid: Other
    if: Box\kid\y != 7
        return: 81
    return: 7
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
