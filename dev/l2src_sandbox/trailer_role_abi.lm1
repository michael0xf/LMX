# C ABI: frozen parser trailer-role symbols -> their L2 callables.
predef: "l1src/libc_abi.lm1"
include: "l1src/p0.lm1.h"
predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
include: "<stddef.h>" "<stdio.h>"

extern: @: Lmx l2_trailer_unit

prototype:
    fn: l2_trailer_boot () int
    fn: l2_trailer_m1 (@: Lmx node; const: @(char text); size_t: length; const: @(char name); int: allow_bare) int
    fn: l2_trailer_m2 (@: Lmx node; const: @(char text); size_t: length) LmP0TrailerRole
    fn: l2_trailer_m3 (@: Lmx node; const: @(char payload)) LmP0TrailerRole
    fn: l2_trailer_m4 (@: Lmx node; LmP0TrailerRole: role) @: char
    fn: l2_trailer_m5 (@: Lmx node; LmP0TrailerRole: role) int
    fn: l2_trailer_m6 (@: Lmx node; const: @(char text); size_t: length) LmP0TrailerRole
end: prototype

int: l2_trailer_role_calls 0

fn: l2_trailer_own (size_t: index) @: Lmx
    if: l2_trailer_unit = 0
        if: c.l2_trailer_boot() != 0 || l2_trailer_unit = 0
            fputs("l2_trailer_boot failed\n", l1_stderr())
    ---
    l2_trailer_role_calls: l2_trailer_role_calls + 1
    return: c.lmx_arena_ref_struct(l2_trailer_unit, index)

fn: lm_p0_text_has_prefix_name (const: @(char text); size_t: length; const: @(char name); int: allow_bare) int
    return: c.l2_trailer_m1(l2_trailer_own(1U), text, length, name, allow_bare)

fn: lm_p0_legacy_trailer_role (const: @(char text); size_t: length) LmP0TrailerRole
    return: c.l2_trailer_m2(l2_trailer_own(2U), text, length)

fn: lm_p0_trailer_role_from_payload (const: @(char payload)) LmP0TrailerRole
    return: c.l2_trailer_m3(l2_trailer_own(3U), payload)

fn: lm_p0_trailer_role_payload (LmP0TrailerRole: role) const: @(char)
    return: c.l2_trailer_m4(l2_trailer_own(4U), role)

fn: lm_p0_trailer_role_is_tail_cutter (LmP0TrailerRole: role) int
    return: c.l2_trailer_m5(l2_trailer_own(5U), role)

fn: lm_p0_trailer_role (const: @(char text); size_t: length) LmP0TrailerRole
    return: c.l2_trailer_m6(l2_trailer_own(6U), text, length)
