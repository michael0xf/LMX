# The receiver inside the loop assigns the same prepared m of this activation.
# Its empty second delivery stops the condition after one iteration. The
# explicit bound only protects the test from an unintended nonterminating loop.
int: n 0
receiveMessage: m
while: m != 0 && n < 5
    n: n + 1
    receiveMessage: m
if: n != 1
    sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
