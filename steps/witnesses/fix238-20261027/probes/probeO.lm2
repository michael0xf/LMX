# Probe O: the same reading spelled with an index step, `next[0]\value` (the idiom of the translated components).
include: "<stdio.h>"
predef: "probe_types.h.lm1"
fn: show (@@: next c.PNode) int
    if: \next != 0 && next[0]\value != 0
        return: 1
    return: 0
end: show
fn: run () int
    c.PNode: n
    @: p c.PNode @ n
    n\value: 0
    n\next: 0
    if: show(@ p) != 0
        return: 80
    return: 7
end: run
sendMessage: exit(exit_code: run(); stdout: ""; stderr: "")
return
