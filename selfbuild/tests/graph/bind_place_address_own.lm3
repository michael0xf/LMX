# @x addresses the selected place (#binding-caller-place, B05): for an own place filled by autofill it is the callee's cell --
# the read through it after the write gives 9, the caller keeps 5.
(
    Observed:
        int: seen 0
)
fn: own (int: x) int
    @: p int @x
    x := 9
    return: \p
fn: caller () int
    int: x 5
    int: r own()
    return: x * 100 + r
sub: main ()
    @: shared node[0]
    shared\Observed\seen := caller()
main()
