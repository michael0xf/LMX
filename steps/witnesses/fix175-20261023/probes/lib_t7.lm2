# Probe (175, LIBRARY-EXPORT-HEADER-SPLIT): a library whose method returns a callable merge, so its L1 has the T7
# helper definitions; they must stand before the construction export, not inside its parameter list.
int: count 40
fn: add3 (int: y; int: x; int: z) int
    return: y + x * 10 + z * 100
fn: wrap (int: k) fn: (int: x; int: z) int
    return: merge((add3); y: k)
