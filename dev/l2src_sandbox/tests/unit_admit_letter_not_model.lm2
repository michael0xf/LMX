# A letter's graph has no declared type: `nextMessage:` into a Structure-typed
# own field admits it at run time (the kernel's implements walk against the
# declared type's shape).  The argv letter is not a Model, so the admission
# refuses it: the implicit failure reaches the entry, which has no value.
Model:
    size_t: value 1U
end: Model
Model: fresh
nextMessage: fresh
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
