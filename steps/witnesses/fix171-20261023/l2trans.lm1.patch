+# The bytes of the file at path and a NUL, read whole, on the heap (their count in len[0]); 0 when it cannot be read
+# or held.
+fn: l2_snap_read (const: @(char path); @: size_t len) @: char
+    @: FILE in
+    long: size
+    @: char data
+    size_t: got
+    in: c.fopen(path, "rb")
+    if: in = 0
+        return: 0
+    if: c.fseek(in, 0L, c.SEEK_END) != 0
+        fclose(in)
+        return: 0
+    size: c.ftell(in)
+    if: size < 0L || c.fseek(in, 0L, c.SEEK_SET) != 0
+        fclose(in)
+        return: 0
+    data: (cast: (@: char) l2_xmalloc((cast: (size_t) size) + 1U))
+    if: data = 0
+        fclose(in)
+        return: 0
+    got: c.fread(data, 1U, (cast: (size_t) size), in)
+    fclose(in)
+    if: got != (cast: (size_t) size)
+        l2_xfree((cast: (@: void) data))
+        return: 0
+    data[got]: 0
+    \len: got
+return: data
