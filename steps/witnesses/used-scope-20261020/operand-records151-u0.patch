+    if: status = 3 || selected = 0
+        return: 1
+    if: status != 0 && selected\n > 0 && l2_path_root_raw_c(selected, mi) != 0
+        return: l2_emit_raw_steps(selected, selected\n, mi, ind, dest, context)
+    if: status != 0
+        return: l2_emit_path_refusal(selected, span\node)
+return: l2_path_record_read_context(mi, selected, ind, span\node, dest, context)
