# A computed field read through a path executes its written declaration once (#call-frame-20261115); locals are not published, so before and after are observed by explicit writes.
(
    Observed:
        int: before 0
        int: after 0
)
@: shared data[0]
int: calls 0
fn: factory () int
    node\calls := node\calls + 1
    return: 7
end: factory
@: Box (@: pick factory())
int: before 0
int: after 0
before := 1
int: result Box\pick
after := 2
sub: main ()
    shared\Observed\before := before
    shared\Observed\after := after
main()
