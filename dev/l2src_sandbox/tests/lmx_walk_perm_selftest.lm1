predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_perm.lm1"
predef: "l2src/lmx_gc.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_manager.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# The walk over the PERMANENT STORE (R0): FABLE-R0-SUBJECT-20260920-1935, and T12 of the
# read-only audit LMX-ETERNAL-R0-20260920-44F.  lmx_walk_selftest.lm1 runs everything in
# one ordinary arena; here the pieces live where a runtime keeps them:
#
#   the store (lmx_perm_open)      the subject [7, 35] handed in as args[0], a Structure
#                                  that holds it, the role records of the body and of the
#                                  plan namespace, every shared LmxCallable and its plan,
#                                  and two ETERNAL occurrences, M and body and all;
#   a_main, a_child (bound to it)  two Messages of the runtime: the occurrences with own
#                                  state, their bodies, and the copies of them;
#   a second store and b_main      another runtime in the same process.
#
# What is measured: the subject is never copied -- a field of it, the subject itself, and
# both again through a nested call come back as the store's OWN addresses; the address
# ranges answer STRUCT / PRIMITIVE from every Message of the runtime and NONE from the
# other runtime; no run allocates in the store or writes a byte of it; a body that would
# write into the store is refused when it is prepared; a copy of M in the child Message
# runs unprepared by the plan it shares; a plan of a short-lived home cannot be hung on a
# store descriptor; and two collections over the two Messages leave every byte of the
# store as it was, with an instrument shown first to be able to see a change.
#
# No text and no type code identifies anything here: the subject is an address, the roles
# are addresses, and what an address IS is asked of the arena's ranges.

@: LmxArena gb 0
@: Lmx groles 0
@: LmxWalkValue gv 0
int: broken 0
int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

# ---- construction, in the arena `gb` with the roles `groles` ----------------------------

fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(gb, groles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(gb, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

sub: ref (@: Lmx code; size_t: slot; @: Lmx target)
    if: code = 0 || target = 0 || lmx_arena_ref_store(code, slot, (cast: (@: void) target)) != 0
        broken: broken + 1
    ---
end: ref

sub: sz (@: Lmx code; size_t: slot; size_t: value)
    if: code = 0 || lmx_walk_store_size(gb, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: sz

sub: icell (@: Lmx holder; size_t: slot; int: value)
    if: holder = 0 || lmx_walk_store_int(gb, holder, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: icell

fn: lit (@: Lmx parent; size_t: slot; int: value) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_LIT, 2U)
    if: n != 0 && lmx_walk_store_int(gb, n, 1U, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
return: n

# [own, holder, slot]
fn: own (@: Lmx parent; size_t: slot; @: Lmx holder; size_t: index) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_OWN, 3U)
    ref(n, 1U, holder)
    sz(n, 2U, index)
return: n

fn: argn (@: Lmx parent; size_t: slot; size_t: k) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_ARG, 2U)
    sz(n, 1U, k)
return: n

# [of, input k, slot]: the field `index` of the Structure handed in as input k.
fn: fld (@: Lmx parent; size_t: slot; size_t: k; size_t: index) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_OF, 3U)
    argn(n, 1U, k)
    sz(n, 2U, index)
return: n

# A callable occurrence in `gb` whose LmxCallable lives in `home` -- the store for a
# descriptor known at translation, the Message's own arena for one that is not.
fn: mk_m (@: Lmx unit; size_t: slot; size_t: children; @: LmxArena home) @: Lmx
    @: Lmx m pl(unit, slot, children)
    @: LmxCallable info lmx_callable_new_owned(home)
    if: m = 0 || info = 0 || lmx_arena_ref_store(m, 0U, (cast: (@: void) info)) != 0
        broken: broken + 1
        return: 0
    ---
return: m

# trace (s):  own z 0;  z: 1;  return: s      leaves a trace if it ever runs
sub: mk_trace (@: Lmx m)
    @: Lmx n 0
    icell(m, 1U, 0)
    n: fr(m, 2U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, m, 1U)
    lit(n, 2U, 1)
    n: fr(m, 3U, c.LMX_WALK_OP_RET, 2U)
    argn(n, 1U, 0U)
end: mk_trace

fn: header_of (@: Lmx m) @: Lmx
    @: LmxCallable info (cast: (@: LmxCallable) lmx_arena_ref_value(m, 0U))
    if: info = 0
        return: 0
return: info\header

# ---- instruments -----------------------------------------------------------------------

# Cells every array of the arena has handed out so far: an allocation anywhere moves it.
fn: handed (@: LmxArena a) size_t
    @: LmxPool pool 0
    size_t: n 0U
    if: a = 0
        return: 0U
    pool: a\arrays
    while: pool != 0
        n: n + lmx_pool_count(pool)
        pool: pool\next
    ---
return: n

# Every byte the arena's blocks hold (the instrument of lmx_perm_selftest.lm1): a
# collection that VISITED an arena stamps a chunk's mark, and the stamp is one of these
# bytes; so is every cell, slot array and Structure header a run could write.
fn: bytes (@: LmxArena arena) unsigned
    @: LmxArenaBlock node 0
    @: char p 0
    unsigned: sum 0U
    size_t: i
    if: arena = 0
        return: 0U
    node: arena\blocks
    while: node != 0
        if: node\base != 0 && node\n != 0U
            p: (cast: (@: char) node\base)
            i: 0U
            while: i < node\n
                sum: sum + (cast: (unsigned) p[i])
                i: i + 1U
            ---
        ---
        node: node\next
    ---
return: sum

# A Message just complete enough for lmx_gc_collect to run over its arena, with `graph` as
# its live graph: everything built under it is reachable, and nothing else is.
fn: world (@: LmxArena arena; @: LmxPost mail; @: Lmx graph; @@: LmxThread out_thread) int
    @: LmxMsg message 0
    @: LmxThread thread 0
    @: LmxSchedule slot 0
    message: (cast: (@: LmxMsg) lmx_arena_take(arena, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
    thread: (cast: (@: LmxThread) lmx_arena_take(arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_THREAD, c.LMX_DOMAIN_THREAD))
    slot: (cast: (@: LmxSchedule) lmx_arena_take(arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: message = 0 || thread = 0 || slot = 0 || graph = 0
        return: 0
    message\running: 1
    message\success: 0
    message\handoff_ready: 0
    message\graph: graph
    message\index: 1U
    if: lmx_post_init(arena, mail) != c.LMX_POST_OK
        return: 0
    if: lmx_thread_attach(thread, message, mail, slot) != c.LMX_THREAD_OK
        return: 0
    if: lmx_schedule_init(slot, arena, (cast: (@: void) thread), 8U) != c.LMX_SCHEDULE_OK
        return: 0
    ---
    \out_thread: thread
return: 1

# An execution context of one Message: its arena, and a temporary-frame store in an
# ordinary arena of its own that is attached to nothing.
fn: ctx_open (@: LmxWalkContext x; @: LmxArena arena; @: LmxArena room; @: LmxPool cells; @: LmxScratch s; @: Lmx roles; @: Lmx plan_roles) int
    memset((cast: (@: void) room), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) cells), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) s), 0, c.sizeof(c.LmxScratch))
    if: lmx_arena_open(room) != 0 || lmx_scratch_open(s, room, cells, 16U) != c.LMX_SCRATCH_OK
        return: 0
    ---
    x\arena: arena
    x\scratch: s
    x\roles: roles
    x\plan_roles: plan_roles
    x\classified: 0U
return: 1

# The integer a value refers to, whether it is the record's own cell or a cell of a graph.
fn: number (@: LmxWalkValue v) int
    if: v = 0 || v\present = 0 || v\ref = 0
        return: -1
return: lmx_int_value_known(v\ref)

fn: main () int
    # Runtime A: the store and two Messages bound to it.  Runtime B: another store in the
    # SAME process, and one Message bound to that.
    LmxArena: store_a
    LmxArena: a_main
    LmxArena: a_child
    LmxArena: store_b
    LmxArena: b_main
    LmxArena: room_main
    LmxArena: room_child
    LmxArena: room_b
    LmxPool: cells_main
    LmxPool: cells_child
    LmxPool: cells_b
    LmxScratch: scratch_main
    LmxScratch: scratch_child
    LmxScratch: scratch_b
    LmxWalkContext: context_main
    LmxWalkContext: context_child
    LmxWalkContext: context_b
    LmxPost: mail_main
    LmxPost: mail_child
    @: LmxArena sa 0
    @: LmxArena am 0
    @: LmxArena ac 0
    @: LmxArena sb 0
    @: LmxArena bm 0
    @: LmxScratch psm 0
    @: LmxScratch psc 0
    @: LmxScratch psb 0
    @: LmxWalkContext pcm 0
    @: LmxWalkContext pcc 0
    @: LmxWalkContext pcb 0
    @: LmxThread t_main 0
    @: LmxThread t_child 0
    @: Lmx roles_a 0
    @: Lmx plan_roles_a 0
    @: Lmx roles_b 0
    @: Lmx plan_roles_b 0
    @: Lmx subject 0
    @: Lmx deep 0
    @: Lmx eunit 0
    @: Lmx e_bump 0
    @: Lmx e_set 0
    @: Lmx subject_b 0
    @: Lmx unit 0
    @: Lmx cunit 0
    @: Lmx unit_b 0
    @: Lmx peek 0
    @: Lmx bump 0
    @: Lmx self 0
    @: Lmx relay 0
    @: Lmx dig 0
    @: Lmx tally 0
    @: Lmx poker 0
    @: Lmx look 0
    @: Lmx mixed 0
    @: Lmx orphan 0
    @: Lmx trace 0
    @: Lmx twin 0
    @: Lmx trace_b 0
    @: Lmx tally_c 0
    @: Lmx look_c 0
    @: Lmx orphan_c 0
    @: Lmx copied 0
    @: Lmx n 0
    @: Lmx e 0
    @: Lmx plan 0
    @: void field 0
    @: void outside 0
    @@: void argv 0
    @@: size_t paths 0
    @: size_t lens 0
    @: size_t flat 0
    size_t: store_handed
    size_t: main_handed
    size_t: child_handed
    size_t: asked
    unsigned: store_bytes
    unsigned: own_before
    int: st 0

    memset((cast: (@: void) (@ store_a)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ a_main)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ a_child)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ store_b)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ b_main)), 0, c.sizeof(c.LmxArena))
    sa: @ store_a
    am: @ a_main
    ac: @ a_child
    sb: @ store_b
    bm: @ b_main
    psm: @ scratch_main
    psc: @ scratch_child
    psb: @ scratch_b
    pcm: @ context_main
    pcc: @ context_child
    pcb: @ context_b
    if: lmx_perm_open(sa) != 0 || lmx_perm_open(sb) != 0 || lmx_arena_open(am) != 0 || lmx_arena_open(ac) != 0 || lmx_arena_open(bm) != 0
        fputs("lmx_walk_perm: arenas\n", l1_stdout())
        return: 2
    if: lmx_perm_bind(am, sa) != 0 || lmx_perm_bind(ac, sa) != 0 || lmx_perm_bind(bm, sb) != 0
        fputs("lmx_walk_perm: bind\n", l1_stdout())
        return: 2
    ---
    argv: (cast: (@@: void) calloc(2U, c.sizeof(@: void)))
    gv: (cast: (@: LmxWalkValue) calloc(1U, c.sizeof(c.LmxWalkValue)))
    paths: (cast: (@@: size_t) calloc(1U, c.sizeof(@: void)))
    lens: (cast: (@: size_t) calloc(1U, c.sizeof(size_t)))
    flat: (cast: (@: size_t) calloc(1U, c.sizeof(size_t)))
    if: argv = 0 || gv = 0 || paths = 0 || lens = 0 || flat = 0
        fputs("lmx_walk_perm: heap\n", l1_stdout())
        return: 2
    ---

    # ---- runtime A, the store: what is known at translation and never changes ----------
    gb: sa
    roles_a: lmx_walk_roles_open(sa)
    plan_roles_a: lmx_plan_roles_open(sa)
    groles: roles_a
    # The subject is an independent branch root: no lexical parent.  [ 7, 35 ]
    subject: lmx_node_new_owned(sa)
    deep: lmx_node_new_owned(sa)
    eunit: lmx_node_new_owned(sa)
    if: roles_a = 0 || plan_roles_a = 0 || subject = 0 || deep = 0 || eunit = 0
        fputs("lmx_walk_perm: store\n", l1_stdout())
        return: 2
    if: lmx_arena_refs_open_owned(sa, subject, 2U) != 0 || lmx_arena_refs_open_owned(sa, deep, 1U) != 0 || lmx_arena_refs_open_owned(sa, eunit, 2U) != 0
        fputs("lmx_walk_perm: store slots\n", l1_stdout())
        return: 2
    ---
    icell(subject, 0U, 7)
    icell(subject, 1U, 35)
    # deep: [ subject ]   a Structure of the store whose field is the subject
    ref(deep, 0U, subject)
    # Two ETERNAL occurrences: M, its descriptor and its whole body are of the store.
    e_bump: mk_m(eunit, 0U, 3U, sa)
    e_set: mk_m(eunit, 1U, 3U, sa)
    # e_bump (s):  own k 5;  return: s\0 + k      reads its own field, never assigns it
    icell(e_bump, 1U, 5)
    n: fr(e_bump, 2U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_ADD, 3U)
    fld(e, 1U, 0U, 0U)
    own(e, 2U, e_bump, 1U)
    # e_set ():    own k 0;  k: 1                 would publish into the store at its exit
    icell(e_set, 1U, 0)
    n: fr(e_set, 2U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, e_set, 1U)
    lit(n, 2U, 1)

    # ---- runtime A, the first Message: occurrences, bodies, own state -------------------
    gb: am
    unit: lmx_node_new_owned(am)
    if: unit = 0 || lmx_arena_refs_open_owned(am, unit, 12U) != 0
        fputs("lmx_walk_perm: unit\n", l1_stdout())
        return: 2
    ---
    peek: mk_m(unit, 0U, 2U, sa)
    bump: mk_m(unit, 1U, 2U, sa)
    self: mk_m(unit, 2U, 2U, sa)
    relay: mk_m(unit, 3U, 2U, sa)
    dig: mk_m(unit, 4U, 2U, sa)
    tally: mk_m(unit, 5U, 4U, sa)
    poker: mk_m(unit, 6U, 3U, sa)
    look: mk_m(unit, 7U, 2U, sa)
    # mixed keeps its descriptor in the Message's own arena; only the roles are the store's.
    mixed: mk_m(unit, 8U, 4U, am)
    orphan: mk_m(unit, 9U, 2U, sa)
    trace: mk_m(unit, 10U, 4U, sa)
    # twin: a subject of the same shape in the Message's OWN arena -- the control.
    twin: pl(unit, 11U, 2U)
    icell(twin, 0U, 7)
    icell(twin, 1U, 35)
    # peek (s):   return: s\1
    n: fr(peek, 1U, c.LMX_WALK_OP_RET, 2U)
    fld(n, 1U, 0U, 1U)
    # bump (s):   return: s\0 + 1
    n: fr(bump, 1U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_ADD, 3U)
    fld(e, 1U, 0U, 0U)
    lit(e, 2U, 1)
    # self (s):   return: s
    n: fr(self, 1U, c.LMX_WALK_OP_RET, 2U)
    argn(n, 1U, 0U)
    # relay (s):  return: peek(s)
    n: fr(relay, 1U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_CALL, 3U)
    ref(e, 1U, peek)
    argn(e, 2U, 0U)
    # dig (d):    return: (d\0)\1                 a field of a field: two Structures of the store
    n: fr(dig, 1U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_OF, 3U)
    fld(e, 1U, 0U, 0U)
    sz(e, 2U, 1U)
    # tally (s):  own n 0;  n: n + s\0;  return: n        own state in the Message, read from the store
    icell(tally, 1U, 0)
    n: fr(tally, 2U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, tally, 1U)
    e: fr(n, 2U, c.LMX_WALK_OP_ADD, 3U)
    own(e, 1U, tally, 1U)
    fld(e, 2U, 0U, 0U)
    n: fr(tally, 3U, c.LMX_WALK_OP_RET, 2U)
    own(n, 1U, tally, 1U)
    # poker (s):  put(subject\0, 9);  return: s           a write INTO the store
    n: fr(poker, 1U, c.LMX_WALK_OP_PUT, 4U)
    ref(n, 1U, subject)
    sz(n, 2U, 0U)
    lit(n, 3U, 9)
    n: fr(poker, 2U, c.LMX_WALK_OP_RET, 2U)
    argn(n, 1U, 0U)
    # look ():    return: at(subject\1)                   the body names the store's Structure itself
    n: fr(look, 1U, c.LMX_WALK_OP_RET, 2U)
    e: fr(n, 1U, c.LMX_WALK_OP_AT, 3U)
    ref(e, 1U, subject)
    sz(e, 2U, 1U)
    # mixed ():   own n 0;  n: n + 1;  return: n
    icell(mixed, 1U, 0)
    n: fr(mixed, 2U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, mixed, 1U)
    e: fr(n, 2U, c.LMX_WALK_OP_ADD, 3U)
    own(e, 1U, mixed, 1U)
    lit(e, 2U, 1)
    n: fr(mixed, 3U, c.LMX_WALK_OP_RET, 2U)
    own(n, 1U, mixed, 1U)
    # orphan (s): return: s                               its store descriptor is left unprepared
    n: fr(orphan, 1U, c.LMX_WALK_OP_RET, 2U)
    argn(n, 1U, 0U)
    mk_trace(trace)

    # ---- runtime B ----------------------------------------------------------------------
    gb: sb
    roles_b: lmx_walk_roles_open(sb)
    plan_roles_b: lmx_plan_roles_open(sb)
    groles: roles_b
    subject_b: lmx_node_new_owned(sb)
    if: roles_b = 0 || plan_roles_b = 0 || subject_b = 0 || lmx_arena_refs_open_owned(sb, subject_b, 2U) != 0
        fputs("lmx_walk_perm: store b\n", l1_stdout())
        return: 2
    ---
    icell(subject_b, 0U, 3)
    icell(subject_b, 1U, 4)
    gb: bm
    unit_b: lmx_node_new_owned(bm)
    if: unit_b = 0 || lmx_arena_refs_open_owned(bm, unit_b, 1U) != 0
        fputs("lmx_walk_perm: unit b\n", l1_stdout())
        return: 2
    ---
    trace_b: mk_m(unit_b, 0U, 4U, sb)
    mk_trace(trace_b)
    gb: am
    groles: roles_a

    check(broken = 0, "construction")
    if: broken != 0
        c.printf("lmx_walk_perm: %d construction steps failed\n", broken)
        return: 1
    ---
    if: ctx_open(pcm, am, @ room_main, @ cells_main, psm, roles_a, plan_roles_a) = 0 || ctx_open(pcc, ac, @ room_child, @ cells_child, psc, roles_a, plan_roles_a) = 0 || ctx_open(pcb, bm, @ room_b, @ cells_b, psb, roles_b, plan_roles_b) = 0
        fputs("lmx_walk_perm: contexts\n", l1_stdout())
        return: 2
    ---

    # ---- 1. what the address ranges say ---------------------------------------------------
    field: lmx_arena_ref_value(subject, 1U)
    check(lmx_range_classify(am, (cast: (@: void) subject)) = c.LMX_KIND_STRUCT && lmx_range_classify(ac, (cast: (@: void) subject)) = c.LMX_KIND_STRUCT, "the subject is a Structure from BOTH Messages of its runtime")
    check(lmx_range_classify(ac, field) = c.LMX_KIND_PRIMITIVE && lmx_range_type_of(ac, field) = c.LMX_TYPE_INT, "a field of the subject is a primitive int cell, asked from the child Message")
    check(lmx_range_pool(sa, (cast: (@: void) subject)) != 0 && lmx_range_pool(am, (cast: (@: void) subject)) = 0 && lmx_range_pool(ac, field) = 0, "the store OWNS the subject and its cells; a Message resolves them and owns none")
    check(lmx_range_classify(bm, (cast: (@: void) subject)) = c.LMX_KIND_NONE && lmx_range_classify(bm, field) = c.LMX_KIND_NONE, "the other runtime answers NOTHING about this runtime's subject")
    check(lmx_range_classify(ac, lmx_arena_ref_value(roles_a, (cast: (size_t) c.LMX_WALK_OP_RET))) = c.LMX_DOMAIN_KIND_OP && lmx_range_classify(am, lmx_arena_ref_value(plan_roles_a, (cast: (size_t) c.LMX_PLAN_ROLE_ROOT))) = c.LMX_DOMAIN_KIND_ROLE, "the role records of the store are what they are from any Message")
    check(lmx_range_classify(ac, lmx_arena_ref_value(tally, 0U)) = c.LMX_DOMAIN_KIND_CALLABLE && lmx_range_classify(bm, lmx_arena_ref_value(tally, 0U)) = c.LMX_KIND_NONE, "a store descriptor is a CALLABLE from the child Message and nothing from the other runtime")
    check(lmx_range_classify(am, (cast: (@: void) twin)) = c.LMX_KIND_STRUCT && lmx_range_pool(am, (cast: (@: void) twin)) != 0 && lmx_range_classify(ac, (cast: (@: void) twin)) = c.LMX_KIND_NONE, "the control: a Structure of one Message is its own, and unknown to the sibling Message")
    outside: calloc(1U, 64U)
    check(lmx_plan_home(am, (cast: (@: void) subject)) = sa && lmx_plan_home(ac, field) = sa && lmx_plan_home(sa, (cast: (@: void) subject)) = sa, "home: the subject lives in the store, whoever of the runtime asks")
    check(lmx_plan_home(am, (cast: (@: void) tally)) = am && lmx_plan_home(am, lmx_arena_ref_value(tally, 0U)) = sa, "home: the occurrence lives in its Message, its descriptor in the store")
    check(lmx_plan_home(bm, (cast: (@: void) subject)) = 0 && lmx_plan_home(am, outside) = 0 && lmx_plan_home(am, 0) = 0, "home: none for the other runtime's address, for a malloc block, for null")
    free(outside)

    # ---- 2. preparation: what would write into the store never gets a plan -----------------
    # The descriptor arena given is the RIGHT one (the store), so the refusal below is the
    # refusal of the write, not of a misplaced plan.
    check(lmx_walk_prepare(pcm, sa, plan_roles_a, poker) = c.LMX_WALK_INVALID && header_of(poker) = 0, "a body with a put INTO the store is refused when it is prepared, and gets no plan")
    argv[0]: (cast: (@: void) subject)
    st: lmx_walk_run(pcm, poker, argv, 1U, gv)
    check(st = c.LMX_WALK_UNSUPPORTED && lmx_int_value_known(lmx_arena_ref_value(subject, 0U)) = 7, "so it never runs, and the store's cell still holds 7")
    check(lmx_walk_prepare(pcm, sa, plan_roles_a, e_set) = c.LMX_WALK_INVALID && header_of(e_set) = 0, "an ETERNAL occurrence that assigns its own field is refused: its checkpoint would write the store")
    st: lmx_walk_run(pcm, e_set, 0, 0U, gv)
    check(st = c.LMX_WALK_UNSUPPORTED && lmx_int_value_known(lmx_arena_ref_value(e_set, 1U)) = 0, "and it never runs")
    # One home for a plan and its descriptor -- and a refusal strands nothing: the wrong
    # arena is refused before a plan is built, least of all in a store nobody collects.
    store_handed: handed(sa)
    main_handed: handed(am)
    check(lmx_walk_prepare(pcm, sa, plan_roles_a, mixed) = c.LMX_WALK_INVALID && header_of(mixed) = 0, "a plan in the store is refused for a descriptor of a Message arena")
    check(lmx_walk_prepare(pcm, am, plan_roles_a, tally) = c.LMX_WALK_INVALID && header_of(tally) = 0, "a plan in a Message arena is refused for a store descriptor")
    check(lmx_walk_prepare(pcm, sa, plan_roles_a, poker) = c.LMX_WALK_INVALID && lmx_walk_prepare(pcm, sa, plan_roles_a, e_set) = c.LMX_WALK_INVALID, "the refused writers, once more")
    check(handed(sa) = store_handed && handed(am) = main_handed, "none of the refusals left a cell behind, in the store or in the Message")
    check(lmx_walk_prepare(pcm, am, plan_roles_a, mixed) = c.LMX_WALK_OK && lmx_plan_home(am, (cast: (@: void) header_of(mixed))) = am, "a Message-local descriptor takes a Message-local plan; the ROLES may be the store's")
    check(lmx_walk_prepare(pcm, sa, plan_roles_a, tally) = c.LMX_WALK_OK && lmx_plan_home(am, (cast: (@: void) header_of(tally))) = sa, "a store descriptor takes a plan built in the store, published through a bound Message")
    check(lmx_walk_plan_check(pcm, tally) = c.LMX_WALK_OK && lmx_plan_entry_count(header_of(tally)) = 1U, "and the plan says what the body says: one own field")
    check(lmx_walk_prepare(pcm, sa, plan_roles_a, peek) = c.LMX_WALK_OK && lmx_walk_prepare(pcm, sa, plan_roles_a, bump) = c.LMX_WALK_OK && lmx_walk_prepare(pcm, sa, plan_roles_a, self) = c.LMX_WALK_OK && lmx_walk_prepare(pcm, sa, plan_roles_a, relay) = c.LMX_WALK_OK, "peek, bump, self, relay prepared")
    check(lmx_walk_prepare(pcm, sa, plan_roles_a, dig) = c.LMX_WALK_OK && lmx_walk_prepare(pcm, sa, plan_roles_a, look) = c.LMX_WALK_OK && lmx_walk_prepare(pcm, sa, plan_roles_a, trace) = c.LMX_WALK_OK, "dig, look, trace prepared: READING the store is not refused")
    check(lmx_walk_prepare(pcm, sa, plan_roles_a, e_bump) = c.LMX_WALK_OK && lmx_walk_plan_check(pcc, e_bump) = c.LMX_WALK_OK && lmx_plan_entry_count(header_of(e_bump)) = 1U, "an eternal occurrence that only READS its own field is prepared; the child Message agrees with the plan")
    gb: bm
    groles: roles_b
    check(lmx_walk_prepare(pcb, sb, plan_roles_b, trace_b) = c.LMX_WALK_OK, "runtime B prepared its own program")
    gb: am
    groles: roles_a
    check(psm\used = 0U && psm\top = 0U && psc\used = 0U && psc\top = 0U, "preparation rewound everything it took from the temporary stores")

    # ---- 3. the subject of the store as args[0]: the same addresses, nothing copied ---------
    store_handed: handed(sa)
    store_bytes: bytes(sa)
    main_handed: handed(am)
    argv[0]: (cast: (@: void) subject)
    st: lmx_walk_run(pcm, bump, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\present = 1 && gv\ref = (cast: (@: void) (@ gv\number)) && gv\number = 8, "an integer computed from a field of the store's subject: 7 + 1, in the caller's cell")
    st: lmx_walk_run(pcm, peek, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\present = 1 && gv\ref = field && number(gv) = 35, "a field of the store's subject is returned BY REFERENCE: the store's very cell")
    st: lmx_walk_run(pcm, self, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\present = 1 && gv\ref = (cast: (@: void) subject), "the subject handed in and handed back: the store's own address")
    st: lmx_walk_run(pcm, relay, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\ref = field, "through a nested call and back: the same reference")
    argv[0]: (cast: (@: void) deep)
    st: lmx_walk_run(pcm, dig, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\ref = field, "a field of a field, both Structures of the store: the same cell again")
    st: lmx_walk_run(pcm, look, 0, 0U, gv)
    check(st = c.LMX_WALK_OK && gv\ref = field, "a body that names the store's Structure itself reads the same cell")
    argv[0]: (cast: (@: void) subject)
    st: lmx_walk_run(pcm, tally, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\number = 7, "own state in the Message, read from the store: 0 + 7")
    st: lmx_walk_run(pcm, tally, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\number = 14 && lmx_int_value_known(lmx_arena_ref_value(tally, 1U)) = 14, "and again: 14, published into the Message's own cell")
    st: lmx_walk_run(pcm, e_bump, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\number = 12, "an ETERNAL occurrence runs from a Message of its runtime: 7 + its own 5")
    st: lmx_walk_run(pcm, mixed, 0, 0U, gv)
    check(st = c.LMX_WALK_OK && gv\number = 1, "the Message-local descriptor with the store's roles runs")
    # The price is the same wherever the subject lives.
    pcm\classified: 0U
    st: lmx_walk_run(pcm, peek, argv, 1U, gv)
    asked: pcm\classified
    argv[0]: (cast: (@: void) twin)
    pcm\classified: 0U
    st: lmx_walk_run(pcm, peek, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\ref = lmx_arena_ref_value(twin, 1U) && pcm\classified = asked && asked = 5U, "peek asks five questions for a subject of the store and five for one of the Message: one at the boundary, two on entry, the return, the holder")
    check(handed(sa) = store_handed && bytes(sa) = store_bytes, "none of it allocated in the store or changed a byte of it")
    check(handed(am) = main_handed, "and no invocation allocated in the Message's arena: the subject was never copied")
    check(psm\used = 0U && psm\top = 0U, "every activation rewound what it took")

    # ---- 4. another runtime ------------------------------------------------------------------
    argv[0]: (cast: (@: void) subject)
    st: lmx_walk_run(pcb, trace_b, argv, 1U, gv)
    check(st = c.LMX_WALK_INVALID && gv\present = 0 && lmx_int_value_known(lmx_arena_ref_value(trace_b, 1U)) = 0, "runtime B handed runtime A's subject: INVALID, and nothing ran")
    argv[0]: (cast: (@: void) subject_b)
    st: lmx_walk_run(pcm, trace, argv, 1U, gv)
    check(st = c.LMX_WALK_INVALID && lmx_int_value_known(lmx_arena_ref_value(trace, 1U)) = 0, "runtime A handed runtime B's subject: INVALID, and nothing ran")
    st: lmx_walk_run(pcb, trace, argv, 1U, gv)
    check(st = c.LMX_WALK_INVALID && lmx_int_value_known(lmx_arena_ref_value(trace, 1U)) = 0, "runtime B asked to run runtime A's occurrence: INVALID, and nothing ran")
    st: lmx_walk_run(pcb, trace_b, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) subject_b) && lmx_int_value_known(lmx_arena_ref_value(trace_b, 1U)) = 1, "the control: B runs its own program on its own subject, and leaves its trace")
    argv[0]: (cast: (@: void) subject)
    st: lmx_walk_run(pcm, trace, argv, 1U, gv)
    check(st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) subject) && lmx_int_value_known(lmx_arena_ref_value(trace, 1U)) = 1, "and A runs its own on its own")

    # ---- 5. T12: copies in the child Message run by the plan they share ----------------------
    cunit: lmx_node_new_owned(ac)
    check(cunit != 0 && lmx_arena_refs_open_owned(ac, cunit, 3U) = 0, "the child Message's unit")
    store_handed: handed(sa)
    store_bytes: bytes(sa)
    st: lmx_graph_copy_owned(tally, 0, am, ac, @ tally_c)
    check(st = c.LMX_GRAPH_COPY_OK && tally_c != 0 && tally_c != tally && lmx_range_pool(ac, (cast: (@: void) tally_c)) != 0, "tally copied into the child Message: a new occurrence, owned by the child")
    st: lmx_graph_copy_owned(look, 0, am, ac, @ look_c)
    check(st = c.LMX_GRAPH_COPY_OK && look_c != 0 && look_c != look, "look copied into the child Message")
    st: lmx_graph_copy_owned(orphan, 0, am, ac, @ orphan_c)
    check(st = c.LMX_GRAPH_COPY_OK && orphan_c != 0 && orphan_c != orphan, "orphan copied into the child Message")
    copied: 0
    st: lmx_graph_copy_owned(e_bump, 0, am, ac, @ copied)
    check(st = c.LMX_GRAPH_COPY_OK && copied = e_bump, "an ETERNAL occurrence is not copied: it comes back as itself")
    check(handed(sa) = store_handed && bytes(sa) = store_bytes, "copying allocated nothing in the store and wrote nothing there")
    if: tally_c != 0 && look_c != 0 && orphan_c != 0
        lmx_arena_ref_store(cunit, 0U, (cast: (@: void) tally_c))
        lmx_arena_ref_store(cunit, 1U, (cast: (@: void) look_c))
        lmx_arena_ref_store(cunit, 2U, (cast: (@: void) orphan_c))
        check(lmx_arena_ref_value(tally_c, 0U) = lmx_arena_ref_value(tally, 0U) && header_of(tally_c) = header_of(tally), "the copy shares the store's descriptor, hence the plan")
        check(lmx_arena_ref_value(lmx_arena_ref_struct(tally_c, 3U), 0U) = lmx_arena_ref_value(roles_a, (cast: (size_t) c.LMX_WALK_OP_RET)), "and the store's role records, by address")
        check(lmx_arena_ref_value(tally_c, 1U) != lmx_arena_ref_value(tally, 1U) && lmx_range_pool(ac, lmx_arena_ref_value(tally_c, 1U)) != 0, "its own field is its own cell, in the child's arena")
        check(lmx_plan_slot_known(tally_c, header_of(tally), 0U) = lmx_arena_ref_cell(tally_c, 1U) && lmx_plan_slot_known(tally, header_of(tally), 0U) = lmx_arena_ref_cell(tally, 1U), "one plan in the store, two occurrences in two Messages, two slots")
        child_handed: handed(ac)
        argv[0]: (cast: (@: void) subject)
        pcc\classified: 0U
        st: lmx_walk_run(pcc, tally_c, argv, 1U, gv)
        asked: pcc\classified
        check(st = c.LMX_WALK_OK && gv\number = 21, "the copy was never prepared and runs: it continues from the copied 14")
        check(lmx_int_value_known(lmx_arena_ref_value(tally_c, 1U)) = 21 && lmx_int_value_known(lmx_arena_ref_value(tally, 1U)) = 14, "it published into ITS cell; the original's is untouched")
        pcm\classified: 0U
        st: lmx_walk_run(pcm, tally, argv, 1U, gv)
        check(st = c.LMX_WALK_OK && gv\number = 21 && pcm\classified = asked && asked = 7U, "the copy costs what the original costs: seven questions -- the boundary, two on entry, three fields, the holder")
        st: lmx_walk_run(pcc, look_c, 0, 0U, gv)
        check(st = c.LMX_WALK_OK && gv\ref = field && lmx_arena_ref_value(lmx_arena_ref_struct(lmx_arena_ref_struct(look_c, 1U), 1U), 1U) = (cast: (@: void) subject), "the copied body still names the store's Structure -- it was shared, not cloned -- and reads the same cell")
        st: lmx_walk_run(pcc, e_bump, argv, 1U, gv)
        check(st = c.LMX_WALK_OK && gv\number = 12, "the eternal occurrence runs from the child Message too, at its one address")
        # The original Message cannot run the child's copy, nor the child the original.
        st: lmx_walk_run(pcm, tally_c, argv, 1U, gv)
        check(st = c.LMX_WALK_INVALID && lmx_int_value_known(lmx_arena_ref_value(tally_c, 1U)) = 21, "an occurrence of a sibling Message is not this Message's to run")
        # A plan of the child's short-lived arena never reaches the store's descriptor.
        check(lmx_walk_prepare(pcc, ac, plan_roles_a, orphan_c) = c.LMX_WALK_INVALID && header_of(orphan) = 0, "the child cannot hang a plan of its own arena on the shared store descriptor")
        flat[0]: 1U
        paths[0]: flat
        lens[0]: 1U
        plan: 0
        check(lmx_plan_build_from_paths(ac, plan_roles_a, paths, lens, 0U, @ plan) = c.LMX_PLAN_OK && plan != 0 && lmx_plan_home(ac, (cast: (@: void) plan)) = ac, "a plan built by hand in the child's arena")
        check(lmx_plan_publish(ac, plan_roles_a, orphan_c, plan) = c.LMX_PLAN_INVALID && header_of(orphan_c) = 0, "lmx_plan_publish refuses it directly: the plan's home is not the descriptor's")
        st: lmx_walk_run(pcc, orphan_c, argv, 1U, gv)
        check(st = c.LMX_WALK_UNSUPPORTED, "and the unprepared copy is refused, not run natively")
        check(lmx_walk_prepare(pcc, sa, plan_roles_a, orphan_c) = c.LMX_WALK_OK && header_of(orphan) != 0 && lmx_plan_home(ac, (cast: (@: void) header_of(orphan))) = sa, "prepared with the plan in the store -- through the child -- it serves BOTH occurrences")
        st: lmx_walk_run(pcm, orphan, argv, 1U, gv)
        check(st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) subject), "the original, never prepared itself, runs by it")
        check(psc\used = 0U && psc\top = 0U, "the child's temporary store is empty again")
    ---

    # ---- 6. collections over the Messages never touch the store ------------------------------
    check(world(am, @ mail_main, unit, @ t_main) != 0 && world(ac, @ mail_child, cunit, @ t_child) != 0, "two Messages just complete enough to be collected, their units as the live graphs")
    if: t_main != 0 && t_child != 0 && tally_c != 0
        # THE INSTRUMENT FIRST: an unchanged sum means nothing unless a changed one is
        # possible, so the collected arena's own bytes are measured across its own pass.
        own_before: bytes(ac)
        store_bytes: bytes(sa)
        store_handed: handed(sa)
        check(store_bytes != 0U, "the store holds bytes to compare")
        check(lmx_gc_collect(ac, t_child) = c.LMX_GC_OK, "a collection over the child Message ran")
        check(bytes(ac) != own_before, "the instrument sees a collection: the collected arena's own bytes changed")
        check(bytes(sa) = store_bytes, "and the store's did not")
        own_before: bytes(am)
        check(lmx_gc_collect(am, t_main) = c.LMX_GC_OK && bytes(am) != own_before, "a collection over the first Message ran, and shows in its own bytes")
        check(bytes(sa) = store_bytes && handed(sa) = store_handed, "the store is byte for byte what it was, after both")
        check(lmx_gc_collect(sa, t_main) = c.LMX_GC_OK && bytes(sa) = store_bytes, "a pass asked to collect the store itself is a no-op")
        check(lmx_range_classify(ac, (cast: (@: void) subject)) = c.LMX_KIND_STRUCT && lmx_arena_ref_value(subject, 1U) = field && lmx_int_value_known(field) = 35, "the subject still resolves, and holds what it held")
        # Everything still runs: the plans, the roles and the subject are where they were.
        argv[0]: (cast: (@: void) subject)
        st: lmx_walk_run(pcm, peek, argv, 1U, gv)
        check(st = c.LMX_WALK_OK && gv\ref = field, "after the collections peek returns the same cell of the store")
        st: lmx_walk_run(pcm, tally, argv, 1U, gv)
        check(st = c.LMX_WALK_OK && gv\number = 28, "the original's own state survived its Message's collection: 21 + 7")
        st: lmx_walk_run(pcc, tally_c, argv, 1U, gv)
        check(st = c.LMX_WALK_OK && gv\number = 28, "so did the copy's, in the child Message")
        st: lmx_walk_run(pcc, e_bump, argv, 1U, gv)
        check(st = c.LMX_WALK_OK && gv\number = 12 && bytes(sa) = store_bytes, "the eternal occurrence runs on, and the store is still untouched")
    ---

    # ---- 7. teardown: the Messages first, each store once through its own close ---------------
    check(lmx_scratch_close(psm) = c.LMX_SCRATCH_OK && lmx_scratch_close(psc) = c.LMX_SCRATCH_OK && lmx_scratch_close(psb) = c.LMX_SCRATCH_OK, "the temporary stores closed: no mark was left outstanding")
    check(lmx_arena_release(@ room_main) = 0 && lmx_arena_release(@ room_child) = 0 && lmx_arena_release(@ room_b) = 0, "their arenas released")
    check(lmx_arena_release(ac) = 0 && lmx_arena_release(am) = 0 && lmx_arena_release(bm) = 0, "the Messages released")
    check(lmx_perm_close(sa) = 0 && lmx_perm_close(sb) = 0, "each store closed, once")

    free((cast: (@: void) argv))
    free((cast: (@: void) gv))
    free((cast: (@: void) paths))
    free((cast: (@: void) lens))
    free((cast: (@: void) flat))
    if: failures != 0
        c.printf("lmx_walk_perm: %d failed of %d\n", failures, checks)
        return: 1
    ---
    c.printf("lmx_walk_perm: %d checks\n", checks)
return: 0
