# R6-2 (1), (4): a merge result body's reference field with a value other than the typed null 0 -- `@: Model p Model` -- is
# the body's statement (docs #dynamic), which a merge body does not run until task (5): refused where the item stands.
Model:
    size_t: x 1U
end: Model

R: merge: Model
    @: Model p Model
end: merge
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
