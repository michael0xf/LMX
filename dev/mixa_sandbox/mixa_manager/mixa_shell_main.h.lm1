# Product entry for Mixa\start lives in mixa_shell_main.lm1 (fn: main).
# The divergent MixaShellHost sketch is retired. Canonical owner is
# MixaShellOwner; bind/open/close go through mixa_shell_native_*;
# the start letter is mixa_shell_start.

prototype:
    fn: main (int: argc; @: @(char) argv) int
end: prototype
