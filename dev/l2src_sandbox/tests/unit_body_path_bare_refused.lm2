# The inline for body does not create a second activation or name scope.
# Its j place remains addressable after end: for; the last iteration writes 9.
fn: mytest () int
    int: acc
    acc: 0
    for: int(i, 0) (i < 10) i++
        int: j i
        acc: j
    end: for
    return: j
end: mytest
int: r 0
r: mytest()
if: r = 9
    r: 7
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
