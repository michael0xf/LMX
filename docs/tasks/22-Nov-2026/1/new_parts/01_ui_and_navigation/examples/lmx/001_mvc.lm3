Model:
    int: count 5
    increment:
        node\count += 1

View:
    @: model Model
    return: int
    render:
        return: model\count

Controller:
    @: model Model
    click:
        model\increment()

Demo:
    return: int
    run:
        Model\count := 5
        Controller\click()
        return: View\render()
