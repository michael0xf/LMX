$ErrorActionPreference='Stop'; $taskExe='C:/Nyasha_Planet/LMX/build2/codex_fix235frontend150cold04/boot-quick-01/tool-g2/lmxtool-tool.exe'; if(Test-Path -LiteralPath $taskExe){throw 'G2 EXE already exists before prelink capture'}; & 'C:/Git/usr/bin/sha256sum.exe' --check --strict 'pins/g2-expected2.raw.sha256' > 'pins/g2-expected2-prelink.gnu.log'; $taskResult=$LASTEXITCODE; Write-Output ('G2Expected2PrelinkExit '+$taskResult); if($taskResult -ne 0){exit $taskResult}; $taskLive=@(Get-CimInstance Win32_Process -Filter "Name='gcc.exe' OR Name='cc1.exe'" | Where-Object {$_.CommandLine -like '*codex_fix235frontend150cold04/boot-quick-01/tool-g2/lmxtool.c*'} | Select-Object Name,ProcessId,ParentProcessId,CommandLine); if($taskLive.Count -lt 1){throw 'No live G2 C compiler at capture'}; @{capturedUtc=[DateTime]::UtcNow.ToString('o');G2exeExists=(Test-Path -LiteralPath $taskExe);live=$taskLive;GNUExit=$taskResult;expectedManifest='g2-expected2.raw.sha256'} | ConvertTo-Json -Depth 7
