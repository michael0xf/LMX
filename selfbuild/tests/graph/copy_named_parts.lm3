# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: source 0
        int: copied 0
)
@: shared data[0]
@: Scope (
    fn: (name: name; args: (); return: int; code: (return: 7))
)
int: source Scope\name()
@: duplicate merge(Scope)
int: copied duplicate\name()

sub: main ()
    shared\Observed\source := source
    shared\Observed\copied := copied
main()
