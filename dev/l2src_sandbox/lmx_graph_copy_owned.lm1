predef: "lmx_graph_copy_owned.h.lm1" "lmx_walk.h.lm1" "lmx_arena_refs.h.lm1" "lmx_value_owned.h.lm1" "l2src/lmx_array_owned.lm1" "l2src/lmx_array_ref_owned.lm1" "l2src/lmx_list_owned.lm1" "lmx_pool.h.lm1" "lmx_range.lm1" "lmx_implements.h.lm1"
predef: "l1src/libc_abi.lm1"
predef: "l2src/lmx_source_names.h.lm1"
include: "<stdlib.h>" "<string.h>" "<stdint.h>"

# ---- operation-local map: source address -> destination address -------------


fn: lmx_copy_map_keys_data (@: LmxCopyMap m) @@: void
    @: VoidDynamicArray da
    @: VoidArray base
    if: m = 0
        return: 0
    da: @ m\keys
    base: (cast: (@: VoidArray) da)
return: (cast: (@@: void) base\data)

fn: lmx_copy_map_vals_data (@: LmxCopyMap m) @@: void
    @: VoidDynamicArray da
    @: VoidArray base
    if: m = 0
        return: 0
    da: @ m\vals
    base: (cast: (@: VoidArray) da)
return: (cast: (@@: void) base\data)

fn: lmx_copy_map_keys_cap (@: LmxCopyMap m) size_t
    @: VoidDynamicArray da
    if: m = 0
        return: 0U
    da: @ m\keys
return: da\capacity

fn: lmx_copy_map_set_keys_data (@: LmxCopyMap m; @@: void data) void
    @: VoidDynamicArray da
    @: VoidArray base
    if: m = 0
        return
    da: @ m\keys
    base: (cast: (@: VoidArray) da)
    base\data: (cast: (@: void) data)
return

fn: lmx_copy_map_set_vals_data (@: LmxCopyMap m; @@: void data) void
    @: VoidDynamicArray da
    @: VoidArray base
    if: m = 0
        return
    da: @ m\vals
    base: (cast: (@: VoidArray) da)
    base\data: (cast: (@: void) data)
return

fn: lmx_copy_map_set_keys_cap (@: LmxCopyMap m; size_t: capacity) void
    @: VoidDynamicArray da
    @: VoidArray base
    if: m = 0
        return
    da: @ m\keys
    da\capacity: capacity
    base: (cast: (@: VoidArray) da)
    base\size: capacity
    da: @ m\vals
    da\capacity: capacity
    base: (cast: (@: VoidArray) da)
    base\size: capacity
return

fn: lmx_copy_stack_items_data (@: LmxCopyStack s) @@: Lmx
    @: VoidDynamicArray da
    @: VoidArray base
    if: s = 0
        return: 0
    da: @ s\items
    base: (cast: (@: VoidArray) da)
return: (cast: (@@: Lmx) base\data)

fn: lmx_copy_stack_items_len (@: LmxCopyStack s) size_t
    @: VoidDynamicArray da
    @: VoidArray base
    if: s = 0
        return: 0U
    da: @ s\items
    base: (cast: (@: VoidArray) da)
return: base\size

fn: lmx_copy_stack_items_cap (@: LmxCopyStack s) size_t
    @: VoidDynamicArray da
    if: s = 0
        return: 0U
    da: @ s\items
return: da\capacity

fn: lmx_copy_stack_set_items_data (@: LmxCopyStack s; @@: Lmx data) void
    @: VoidDynamicArray da
    @: VoidArray base
    if: s = 0
        return
    da: @ s\items
    base: (cast: (@: VoidArray) da)
    base\data: (cast: (@: void) data)
return

fn: lmx_copy_stack_set_items_len (@: LmxCopyStack s; size_t: len) void
    @: VoidDynamicArray da
    @: VoidArray base
    if: s = 0
        return
    da: @ s\items
    base: (cast: (@: VoidArray) da)
    base\size: len
return

fn: lmx_copy_stack_set_items_cap (@: LmxCopyStack s; size_t: capacity) void
    @: VoidDynamicArray da
    if: s = 0
        return
    da: @ s\items
    da\capacity: capacity
return


fn: lmx_copy_hash (@: void p; size_t: cap) size_t
    size_t: h (cast: (size_t) (cast: (uintptr_t) p))
    h: (h >> 4) * 2654435761U
    return: h & (cap - 1U)

fn: lmx_copy_map_init (@: LmxCopyMap m) int
    @@: void keys
    @@: void vals
    size_t: i 0U
    if: m = 0
        return: 1
    memset((cast: (@: void) m), 0, c.sizeof(c.LmxCopyMap))
    keys: (cast: (@@: void) malloc(64U * c.sizeof(@: void)))
    if: keys = 0
        return: 1
    vals: (cast: (@@: void) malloc(64U * c.sizeof(@: void)))
    if: vals = 0
        free(keys)
        return: 1
    while: i < 64U
        keys[i]: 0
        vals[i]: 0
        i: i + 1U
    ---
    lmx_copy_map_set_keys_data(m, keys)
    lmx_copy_map_set_vals_data(m, vals)
    lmx_copy_map_set_keys_cap(m, 64U)
    return: 0

sub: lmx_copy_map_dispose (@: LmxCopyMap m)
    if: m = 0
        return
    ---
    if: lmx_copy_map_keys_data(m) != 0
        free(lmx_copy_map_keys_data(m))
    ---
    if: lmx_copy_map_vals_data(m) != 0
        free(lmx_copy_map_vals_data(m))
    ---
    lmx_copy_map_set_keys_data(m, 0)
    lmx_copy_map_set_vals_data(m, 0)
    lmx_copy_map_set_keys_cap(m, 0U)
    m\n: 0U
end: lmx_copy_map_dispose

fn: lmx_copy_map_get (@: LmxCopyMap m; @: void key) @: void
    @@: void keys
    @@: void vals
    size_t: i
    if: m = 0 || key = 0 || lmx_copy_map_keys_data(m) = 0
        return: 0
    keys: lmx_copy_map_keys_data(m)
    vals: lmx_copy_map_vals_data(m)
    i: lmx_copy_hash(key, lmx_copy_map_keys_cap(m))
    while: keys[i] != 0
        if: keys[i] = key
            return: vals[i]
        i: (i + 1U) & (lmx_copy_map_keys_cap(m) - 1U)
    ---
    return: 0

fn: lmx_copy_map_grow (@: LmxCopyMap m) int
    @@: void old_keys lmx_copy_map_keys_data(m)
    @@: void old_vals lmx_copy_map_vals_data(m)
    size_t: old_cap lmx_copy_map_keys_cap(m)
    size_t: cap old_cap * 2U
    size_t: i 0U
    size_t: j
    @@: void keys
    @@: void vals
    if: cap <= old_cap
        return: 1
    keys: (cast: (@@: void) malloc(cap * c.sizeof(@: void)))
    if: keys = 0
        return: 1
    vals: (cast: (@@: void) malloc(cap * c.sizeof(@: void)))
    if: vals = 0
        free(keys)
        return: 1
    while: i < cap
        keys[i]: 0
        vals[i]: 0
        i: i + 1U
    ---
    i: 0U
    while: i < old_cap
        if: old_keys[i] != 0
            j: lmx_copy_hash(old_keys[i], cap)
            while: keys[j] != 0
                j: (j + 1U) & (cap - 1U)
            ---
            keys[j]: old_keys[i]
            vals[j]: old_vals[i]
        ---
        i: i + 1U
    ---
    lmx_copy_map_set_keys_data(m, keys)
    lmx_copy_map_set_vals_data(m, vals)
    lmx_copy_map_set_keys_cap(m, cap)
    lmx_copy_map_set_keys_cap(m, cap)
    lmx_copy_map_set_keys_cap(m, cap)
    free(old_keys)
    free(old_vals)
    return: 0

fn: lmx_copy_map_put (@: LmxCopyMap m; @: void key; @: void value) int
    @@: void keys
    @@: void vals
    size_t: i
    if: m = 0 || key = 0 || value = 0
        return: 1
    if: (m\n + 1U) * 2U > lmx_copy_map_keys_cap(m)
        if: lmx_copy_map_grow(m) != 0
            return: 1
    ---
    keys: lmx_copy_map_keys_data(m)
    vals: lmx_copy_map_vals_data(m)
    i: lmx_copy_hash(key, lmx_copy_map_keys_cap(m))
    while: keys[i] != 0
        if: keys[i] = key
            vals[i]: value
            return: 0
        i: (i + 1U) & (lmx_copy_map_keys_cap(m) - 1U)
    ---
    keys[i]: key
    vals[i]: value
    m\n: m\n + 1U
    return: 0

# ---- work list of source Structures whose edges are still to be copied -----

fn: lmx_copy_stack_push (@: LmxCopyStack s; @: Lmx x) int
    @@: Lmx grown
    @@: Lmx items
    size_t: cap
    if: s = 0 || x = 0
        return: 1
    if: lmx_copy_stack_items_len(s) >= lmx_copy_stack_items_cap(s)
        cap: 16U
        if: lmx_copy_stack_items_cap(s) != 0U
            cap: lmx_copy_stack_items_cap(s) * 2U
        ---
        if: cap <= lmx_copy_stack_items_cap(s)
            return: 1
        grown: (cast: (@@: Lmx) malloc(cap * c.sizeof(@: void)))
        if: grown = 0
            return: 1
        if: lmx_copy_stack_items_len(s) != 0U
            memcpy((cast: (@: void) grown), (cast: (@: void) lmx_copy_stack_items_data(s)), lmx_copy_stack_items_len(s) * c.sizeof(@: void))
        ---
        if: lmx_copy_stack_items_data(s) != 0
            free(lmx_copy_stack_items_data(s))
        ---
        lmx_copy_stack_set_items_data(s, grown)
        lmx_copy_stack_set_items_cap(s, cap)
    ---
    items: lmx_copy_stack_items_data(s)
    items[lmx_copy_stack_items_len(s)]: x
    lmx_copy_stack_set_items_len(s, lmx_copy_stack_items_len(s) + 1U)
    return: 0

fn: lmx_copy_stack_pop (@: LmxCopyStack s) @: Lmx
    @@: Lmx items
    if: s = 0 || lmx_copy_stack_items_len(s) = 0U
        return: 0
    items: lmx_copy_stack_items_data(s)
    lmx_copy_stack_set_items_len(s, lmx_copy_stack_items_len(s) - 1U)
    return: items[lmx_copy_stack_items_len(s)]

sub: lmx_copy_stack_dispose (@: LmxCopyStack s)
    if: s = 0
        return
    ---
    if: lmx_copy_stack_items_data(s) != 0
        free(lmx_copy_stack_items_data(s))
    ---
    lmx_copy_stack_set_items_data(s, 0)
    lmx_copy_stack_set_items_cap(s, 0U)
    lmx_copy_stack_set_items_len(s, 0U)
end: lmx_copy_stack_dispose

# The caller names profiles by their physical graph references.  Validate the complete
# call-bounded span before allocating anything: every profile reference itself must be a
# sealed live Structure, at least one source range must carry it, and every such range must
# be sealed.  Duplicate references are intentionally accepted and need no side table.
fn: lmx_copy_profiles_valid (@: LmxArena src_arena; @@: Lmx retain_profiles; size_t: retain_count) int
    @: Lmx profile
    @: LmxArena home
    @: LmxPool pool
    @: LmxRange entry
    size_t: i 0U
    size_t: j
    int: found
    if: src_arena = 0
        return: 0
    if: retain_count != 0U && retain_profiles = 0
        return: 0
    while: i < retain_count
        profile: retain_profiles[i]
        if: profile = 0 || lmx_range_classify(src_arena, (cast: (@: void) profile)) != c.LMX_KIND_STRUCT
            return: 0
        home: lmx_range_home(src_arena, (cast: (@: void) profile))
        if: home = 0
            return: 0
        pool: lmx_range_pool(home, (cast: (@: void) profile))
        if: pool = 0 || lmx_pool_is_sealed(pool) = 0
            return: 0
        found: 0
        j: 0U
        while: j < lmx_arena_index_len(src_arena)
            entry: lmx_arena_index_data(src_arena) + j
            if: entry\array != 0 && entry\array\profile = profile
                found: 1
                if: lmx_pool_is_sealed(entry\array) = 0
                    return: 0
                ---
            ---
            j: j + 1U
        ---
        if: found = 0
            return: 0
        i: i + 1U
    ---
return: 1

# Exact qualified-profile test.  Profile references are opaque: the kernel only compares
# the address-range profile against the caller's physical-reference span.
fn: lmx_copy_retained_profiles (@: LmxArena src_arena; @: void p; @@: Lmx retain_profiles; size_t: retain_count) int
    @: Lmx profile
    size_t: i 0U
    if: src_arena = 0 || p = 0 || retain_profiles = 0 || retain_count = 0U
        return: 0
    profile: lmx_range_profile(src_arena, p)
    if: profile = 0
        return: 0
    while: i < retain_count
        if: retain_profiles[i] = profile
            return: 1
        i: i + 1U
    ---
return: 0

fn: lmx_copy_is_terminal_profiles (@: LmxArena src_arena; @: void p; @@: Lmx retain_profiles; size_t: retain_count) int
    int: kind
    if: p = 0
        return: 0
    if: lmx_copy_retained_profiles(src_arena, p, retain_profiles, retain_count) != 0
        return: 1
    ---
    kind: lmx_range_classify(src_arena, p)
    # k.4: LmxMethod/LmxCallable are gone.  A callable is a Structure and is copied (Q44);
    # only its implementation, the `native` word, is carried verbatim.
    if: kind = c.LMX_DOMAIN_KIND_OP
        return: 1
    # A role record is an address and nothing else: a copy that duplicated it would
    # make a node of the copy name a role nobody knows (lmx_plan.h.lm1).
    if: kind = c.LMX_DOMAIN_KIND_ROLE
        return: 1
    # D-49: a PRIMITIVE record (kernel act descriptor {fn, signature, owner}) is a
    # shared terminal like METHOD. A copy would name an act nobody registered.
    # Distinct from LMX_KIND_PRIMITIVE cells (char/int), which copy_value still copies.
    if: kind = c.LMX_DOMAIN_KIND_PRIMITIVE
        return: 1
    # D-59 / -181: a Message record (Thread prefix included), in any arena whose
    # range table classifies it, is a terminal. Copying never descends into a
    # Thread/Message; the slot keeps the same LmxMsg address (author Q4 2026-09-22).
    # Mutant: treat as Structure -> merge refuses; copy the record -> address differs.
    if: kind = c.LMX_DOMAIN_KIND_MSG_RECORD
        return: 1
    return: 0

fn: lmx_copy_is_terminal_profiled (@: LmxArena src_arena; @: void p; @: Lmx retain_profile) int
return: lmx_copy_is_terminal_profiles(src_arena, p, @ retain_profile, 1U)

# Compatibility/query helper for an ordinary unqualified copy.  Qualification is never
# inferred here; profiled copying calls the explicit helper above.
fn: lmx_copy_is_terminal (@: LmxArena src_arena; @: void p) int
return: lmx_copy_is_terminal_profiled(src_arena, p, 0)

# §10 qualification checks the already built physical graph before changing
# any pool's seal bit. A method occurrence is a leaf of its enclosing tree;
# an ordinary named Structure (including one with an executable body) is not.
fn: lmx_qualify_method_leaf (@: Lmx p; @@: Lmx leaves; size_t: count) int
    size_t: i 0U
    while: i < count
        if: leaves[i] = p
            return: 1
        i: i + 1U
    ---
return: 0

fn: lmx_qualify_opaque_type (int: type_id; @: int ids; size_t: count) int
    size_t: i 0U
    while: i < count
        if: ids[i] = type_id
            return: 1
        i: i + 1U
    ---
return: 0

# The caller supplies profiles certified by a completed earlier preflight and
# seal. The target pool's seal is a local sanity check, not by itself proof
# that every pool and edge in the earlier tree was qualified. A future dynamic
# RuntimeImmutable caller must carry the same whole-profile certification.
fn: lmx_qualify_prior (@: LmxArena arena; @: void p; @@: Lmx profiles; size_t: count) int
    @: LmxArena home
    @: LmxPool pool
    if: lmx_copy_retained_profiles(arena, p, profiles, count) = 0
        return: 0
    home: lmx_range_home(arena, p)
    if: home = 0
        return: 0
    pool: lmx_range_pool(home, p)
return: (cast: (int) (pool != 0 && lmx_pool_is_sealed(pool) != 0))

# A descriptor's first element being live says nothing about its advertised
# length. Every backing read below must fit one physically issued chunk of the
# expected typed array. lmx_pool_take_n issues precisely such a span.
fn: lmx_qualify_live_span (@: LmxArena arena; @: void start; size_t: count; int: kind; int: type_id; size_t: stride; @: Lmx profile) int
    @: LmxArena home
    @: LmxPool pool
    @: LmxChunk chunk
    size_t: offset
    size_t: used
    if: count = 0U
        return: (cast: (int) (start = 0))
    if: start = 0 || stride = 0U
        return: 0
    home: lmx_range_home(arena, start)
    if: home = 0
        return: 0
    pool: lmx_range_pool(home, start)
    if: pool = 0 || lmx_range_classify(arena, start) != kind || lmx_range_type_of(arena, start) != type_id || lmx_range_stride(arena, start) != stride || lmx_range_profile(arena, start) != profile
        return: 0
    chunk: lmx_pool_chunk_at(pool, start)
    if: chunk = 0
        return: 0
    offset: (cast: (size_t) start) - (cast: (size_t) lmx_chunk_data(chunk))
    if: offset % stride != 0U
        return: 0
    used: lmx_chunk_cells(chunk, stride)
    if: used > lmx_chunk_room(chunk, stride)
        return: 0
    ---
    if: offset / stride > used
        return: 0
return: (cast: (int) (count <= used - offset / stride))

# Transient constructor proof: one interval per reached physical carrier or
# complete backing allocation, never one bookkeeping entry per Array element.
fn: lmx_qualify_span_add (@: LmxArena arena; @: Lmx profile; @: void start; size_t: count; @: LmxQualifySpansDynamicArray spans) int
    @: LmxArena home
    @: LmxPool pool
    @: LmxChunk chunk
    @: LmxQualifySpan grown
    LmxQualifySpan: probe
    size_t: capacity
    size_t: first
    size_t: stride
    if: spans = 0
        return: LMX_QUALIFY_OK
    if: count = 0U
        return: (cast: (int) (start != 0))
    if: start = 0
        return: LMX_QUALIFY_INVALID
    home: lmx_range_home(arena, start)
    pool: lmx_range_pool(arena, start)
    if: home != arena || pool = 0 || pool\profile != profile
        return: LMX_QUALIFY_INVALID
    stride: pool\stride
    if: lmx_qualify_live_span(arena, start, count, pool\kind, pool\type, stride, profile) = 0
        return: LMX_QUALIFY_INVALID
    chunk: lmx_pool_chunk_at(pool, start)
    if: chunk = 0
        return: LMX_QUALIFY_INVALID
    first: ((cast: (size_t) start) - (cast: (size_t) lmx_chunk_data(chunk))) / stride
    if: spans\size = spans\capacity
        capacity: 32U
        if: spans\capacity != 0U
            if: spans\capacity > ((cast: (size_t) -1) / 2U)
                return: LMX_QUALIFY_NOMEM
            capacity: spans\capacity * 2U
        ---
        if: capacity > ((cast: (size_t) -1) / c.sizeof(probe))
            return: LMX_QUALIFY_NOMEM
        grown: (cast: (@: LmxQualifySpan) realloc((cast: (@: void) spans\data), capacity * c.sizeof(probe)))
        if: grown = 0
            return: LMX_QUALIFY_NOMEM
        spans\data: grown
        spans\capacity: capacity
    ---
    @: LmxQualifySpan next spans\data + spans\size
    next\pool: pool
    next\chunk: chunk
    next\first: first
    next\count: count
    spans\size: spans\size + 1U
return: LMX_QUALIFY_OK

fn: lmx_qualify_span_cmp (@: LmxQualifySpan a; @: LmxQualifySpan b) int
    size_t: av (cast: (size_t) a\pool)
    size_t: bv (cast: (size_t) b\pool)
    if: av < bv
        return: -1
    if: av > bv
        return: 1
    av: (cast: (size_t) a\chunk)
    bv: (cast: (size_t) b\chunk)
    if: av < bv
        return: -1
    if: av > bv
        return: 1
    if: a\first < b\first
        return: -1
    if: a\first > b\first
        return: 1
return: 0

# Bottom-up mergesort bounds scratch by the number of reached allocations,
# not by their element counts, and avoids a quadratic profile scan.
fn: lmx_qualify_spans_sort (@: LmxQualifySpansDynamicArray spans) int
    @: LmxQualifySpan temp
    LmxQualifySpan: probe
    size_t: width 1U
    size_t: left
    size_t: mid
    size_t: right
    size_t: i
    size_t: j
    size_t: k
    if: spans\size < 2U
        return: LMX_QUALIFY_OK
    if: spans\size > ((cast: (size_t) -1) / c.sizeof(probe))
        return: LMX_QUALIFY_NOMEM
    temp: (cast: (@: LmxQualifySpan) malloc(spans\size * c.sizeof(probe)))
    if: temp = 0
        return: LMX_QUALIFY_NOMEM
    while: width < spans\size
        left: 0U
        while: left < spans\size
            mid: left + width
            if: width > spans\size - left
                mid: spans\size
            ---
            right: mid + width
            if: width > spans\size - mid
                right: spans\size
            ---
            i: left
            j: mid
            k: left
            while: i < mid && j < right
                if: lmx_qualify_span_cmp(spans\data + i, spans\data + j) <= 0
                    memcpy((cast: (@: void) (temp + k)), (cast: (@: void) (spans\data + i)), c.sizeof(probe))
                    i: i + 1U
                else:
                    memcpy((cast: (@: void) (temp + k)), (cast: (@: void) (spans\data + j)), c.sizeof(probe))
                    j: j + 1U
                ---
                k: k + 1U
            ---
            while: i < mid
                memcpy((cast: (@: void) (temp + k)), (cast: (@: void) (spans\data + i)), c.sizeof(probe))
                i: i + 1U
                k: k + 1U
            ---
            while: j < right
                memcpy((cast: (@: void) (temp + k)), (cast: (@: void) (spans\data + j)), c.sizeof(probe))
                j: j + 1U
                k: k + 1U
            ---
            left: right
        ---
        memcpy((cast: (@: void) spans\data), (cast: (@: void) temp), spans\size * c.sizeof(probe))
        if: width > spans\size / 2U
            break
        width: width * 2U
    ---
    free((cast: (@: void) temp))
return: LMX_QUALIFY_OK

fn: lmx_qualify_spans_complete (@: LmxArena arena; @: Lmx profile; @: LmxQualifySpansDynamicArray spans) int
    @: LmxPool pool
    @: LmxChunk chunk
    LmxQualifySpan: probe
    size_t: lo
    size_t: hi
    size_t: mid
    size_t: at
    size_t: covered
    size_t: used
    int: status lmx_qualify_spans_sort(spans)
    if: status != LMX_QUALIFY_OK
        return: status
    pool: arena\arrays
    while: pool != 0
        if: pool\profile = profile
            if: pool\stride = 0U
                return: LMX_QUALIFY_INVALID
            chunk: lmx_pool_chunk_head(pool)
            while: chunk != 0
                used: lmx_chunk_cells(chunk, pool\stride)
                if: used > lmx_chunk_room(chunk, pool\stride)
                    return: LMX_QUALIFY_INVALID
                probe.pool: pool
                probe.chunk: chunk
                probe.first: 0U
                probe.count: 0U
                lo: 0U
                hi: spans\size
                while: lo < hi
                    mid: lo + (hi - lo) / 2U
                    if: lmx_qualify_span_cmp(spans\data + mid, @ probe) < 0
                        lo: mid + 1U
                    else:
                        hi: mid
                    ---
                ---
                at: lo
                covered: 0U
                while: at < spans\size && (spans\data + at)\pool = pool && (spans\data + at)\chunk = chunk
                    if: (spans\data + at)\first > covered || (spans\data + at)\first > used || (spans\data + at)\count > used - (spans\data + at)\first
                        return: LMX_QUALIFY_INVALID
                    ---
                    if: (spans\data + at)\first + (spans\data + at)\count > covered
                        covered: (spans\data + at)\first + (spans\data + at)\count
                    ---
                    at: at + 1U
                ---
                if: covered != used
                    return: LMX_QUALIFY_INVALID
                chunk: chunk\next
            ---
        ---
        pool: pool\next
    ---
return: LMX_QUALIFY_OK

# Exact-cell classification says NONE for an interior byte and for unissued
# capacity. Neither address is a foreign resource: an unsealed pool can later
# issue that same stable address as a mutable cell without another admission.
fn: lmx_qualify_inside_arena_interval (@: LmxArena arena; @: void p) int
return: (cast: (int) (lmx_range_entry_at(arena, p) != 0))

# Both fixed Array and dynamic List use the same typed backing-cell contract.
# For a List, count is capacity; checking only its current size would let a
# malformed descriptor conceal a mutable or truncated backing allocation.
fn: lmx_qualify_backing (@: LmxArena arena; @: VoidArray array; int: array_type; size_t: count; int: allow_scalar; @: Lmx profile) int
    int: kind c.LMX_KIND_PRIMITIVE
    int: element_type c.LMX_TYPE_NONE
    size_t: stride c.sizeof(@: void)
    ulong: ulong_probe 0U
    if: array_type = c.LMX_TYPE_ARRAY_OF_LMX
        kind: c.LMX_KIND_REF
        element_type: c.LMX_TYPE_LMX
    else:
        if: array_type = c.LMX_TYPE_ARRAY_OF_DESC
            kind: c.LMX_KIND_REF
            element_type: c.LMX_TYPE_DESC
        else:
            if: array_type >= c.LMX_TYPE_ARRAY_OF_POINTER_BASE
                element_type: c.LMX_TYPE_POINTER_BASE + (array_type - c.LMX_TYPE_ARRAY_OF_POINTER_BASE)
            else:
                if: allow_scalar = 0
                    return: 0
                if: array_type = c.LMX_TYPE_ARRAY_OF_CHAR
                    element_type: c.LMX_TYPE_CHAR
                    stride: c.sizeof(c.char)
                else:
                    if: array_type = c.LMX_TYPE_ARRAY_OF_UNSIGNED_CHAR
                        element_type: c.LMX_TYPE_UNSIGNED_CHAR
                        stride: c.sizeof(c.char)
                    else:
                        if: array_type = c.LMX_TYPE_ARRAY_OF_INT
                            element_type: c.LMX_TYPE_INT
                            stride: c.sizeof(c.int)
                        else:
                            if: array_type = c.LMX_TYPE_ARRAY_OF_SIZE_T
                                element_type: c.LMX_TYPE_SIZE_T
                                stride: c.sizeof(c.size_t)
                            else:
                                if: array_type = c.LMX_TYPE_ARRAY_OF_ULONG
                                    element_type: c.LMX_TYPE_ULONG
                                    stride: c.sizeof(ulong_probe)
                                else:
                                    return: 0
                                ---
                            ---
                        ---
                    ---
                ---
            ---
        ---
    ---
return: lmx_qualify_live_span(arena, array\data, count, kind, element_type, stride, profile)

fn: lmx_qualify_struct_header (@: LmxArena arena; @: void p) int
return: (cast: (int) (lmx_range_classify(arena, p) = c.LMX_KIND_STRUCT && lmx_range_type_of(arena, p) = c.LMX_TYPE_STRUCT && lmx_range_stride(arena, p) = c.sizeof(c.Lmx)))

# Admit one graph edge to this selected tree. Exact containment was collected
# first; no edge can enlarge that closure during checking. Non-Structure cells
# have no parent, so their own physical profile is the ownership proof. Every
# admitted internal cell is queued once for its own outgoing references.
fn: lmx_qualify_edge (@: LmxArena arena; @: void p; @: Lmx profile; @@: Lmx prior; size_t: prior_count; @: LmxCopyMap closure; @: LmxCopyMap seen; @: LmxCopyStack todo; int: opaque_unknown) int
    int: kind
    if: p = 0
        return: LMX_QUALIFY_OK
    kind: lmx_range_classify(arena, p)
    if: kind = c.LMX_KIND_NONE
        if: opaque_unknown != 0 && lmx_qualify_inside_arena_interval(arena, p) = 0
            return: LMX_QUALIFY_OK
        return: LMX_QUALIFY_INVALID
    ---
    if: kind = c.LMX_DOMAIN_KIND_OP || kind = c.LMX_DOMAIN_KIND_ROLE || kind = c.LMX_DOMAIN_KIND_PRIMITIVE || kind = c.LMX_DOMAIN_KIND_MSG_RECORD
        return: LMX_QUALIFY_OK
    ---
    if: kind = c.LMX_KIND_STRUCT
        if: lmx_qualify_struct_header(arena, p) = 0
            return: LMX_QUALIFY_INVALID
        ---
        if: lmx_copy_map_get(closure, p) != 0 || lmx_qualify_prior(arena, p, prior, prior_count) != 0
            return: LMX_QUALIFY_OK
        return: LMX_QUALIFY_INVALID
    ---
    if: lmx_qualify_prior(arena, p, prior, prior_count) != 0
        return: LMX_QUALIFY_OK
    ---
    if: lmx_range_profile(arena, p) != profile
        return: LMX_QUALIFY_INVALID
    ---
    # CHILDREN/REF are backing cells, never values. In particular, accepting
    # one as a child and reading only refs[0] could hide later external edges.
    if: kind != c.LMX_KIND_PRIMITIVE && kind != c.LMX_KIND_ARRAY && kind != c.LMX_KIND_LIST && kind != c.LMX_KIND_SOURCE_SYMBOL
        return: LMX_QUALIFY_INVALID
    ---
    if: lmx_copy_map_get(seen, p) = 0
        if: lmx_copy_map_put(seen, p, p) != 0 || lmx_copy_stack_push(todo, (cast: (@: Lmx) p)) != 0
            return: LMX_QUALIFY_NOMEM
        ---
    ---
return: LMX_QUALIFY_OK

# A pointer's declared source category matters only when the address has no
# exact arena cell. A registered address is always checked as a graph edge,
# even if its static type names an opaque C resource. Unknown/void provenance
# is fail-closed; a cast cannot make an unimported graph target immutable.
fn: lmx_qualify_pointer_edge (@: LmxArena arena; @: void p; int: type_id; @: Lmx profile; @@: Lmx prior; size_t: prior_count; @: LmxCopyMap closure; @: LmxCopyMap seen; @: LmxCopyStack todo; @: int opaque_types; size_t: opaque_count) int
return: lmx_qualify_edge(arena, p, profile, prior, prior_count, closure, seen, todo, lmx_qualify_opaque_type(type_id, opaque_types, opaque_count))

# A Frame is identified by the physical role record in its first slot.  An
# arbitrary OP from another program is not one of this program's instructions.
# 0 means ordinary Structure; 1 means Frame; -1 means malformed/unknown Frame.
fn: lmx_qualify_frame_role (@: LmxArena arena; @: Lmx node; @: Lmx roles) int
    @: void head 0
    @: void role_data 0
    @@: void records 0
    size_t: role_count 0U
    size_t: k 1U
    if: node\array.size = 0U
        return: 0
    head: lmx_arena_ref_value(node, 0U)
    if: head = 0 || lmx_range_classify(arena, head) != c.LMX_DOMAIN_KIND_OP
        return: 0
    if: lmx_range_type_of(arena, head) != c.LMX_DOMAIN_OP || lmx_range_stride(arena, head) != c.sizeof(c.LmxOp)
        return: -1
    if: roles = 0 || lmx_qualify_struct_header(arena, (cast: (@: void) roles)) = 0 || roles\array.data = 0 || roles\array.size = 0U
        return: -1
    ---
    role_data: roles\array.data
    role_count: roles\array.size
    if: lmx_qualify_live_span(arena, role_data, role_count, c.LMX_KIND_CHILDREN, c.LMX_TYPE_REFS, c.sizeof(@: void), lmx_range_profile(arena, (cast: (@: void) roles))) = 0
        return: -1
    ---
    records: (cast: (@@: void) roles\array.data)
    while: k < roles\array.size
        if: records[k] = head
            if: (cast: (@: LmxOp) head)\code != (cast: (int) k)
                return: -1
            ---
            return: 1
        k: k + 1U
    ---
return: -1

# A Frame's operands are stored code, not values that the selected Structure
# currently holds. Validate their physical carriers, but do not follow their
# external referents or predict the operation's future result. Contained plain
# Structures remain in the closure and are checked by the ordinary data rule.
fn: lmx_qualify_code_operand (@: LmxArena arena; @: void p; @: Lmx profile) int
    int: kind
    int: vtype
    @: VoidArray array
    @: VoidDynamicArray dynamic
    if: p = 0
        return: LMX_QUALIFY_OK
    kind: lmx_range_classify(arena, p)
    if: kind = c.LMX_KIND_NONE
        return: LMX_QUALIFY_INVALID
    ---
    if: kind = c.LMX_KIND_STRUCT
        if: lmx_qualify_struct_header(arena, p) = 0
            return: LMX_QUALIFY_INVALID
        return: LMX_QUALIFY_OK
    ---
    if: kind = c.LMX_DOMAIN_KIND_OP || kind = c.LMX_DOMAIN_KIND_ROLE || kind = c.LMX_DOMAIN_KIND_PRIMITIVE || kind = c.LMX_DOMAIN_KIND_MSG_RECORD
        return: LMX_QUALIFY_OK
    ---
    if: kind != c.LMX_KIND_PRIMITIVE && kind != c.LMX_KIND_ARRAY && kind != c.LMX_KIND_LIST && kind != c.LMX_KIND_SOURCE_SYMBOL
        return: LMX_QUALIFY_INVALID
    ---
    if: lmx_range_profile(arena, p) != profile
        return: LMX_QUALIFY_OK
    ---
    vtype: lmx_range_type_of(arena, p)
    if: kind = c.LMX_KIND_PRIMITIVE && vtype >= c.LMX_TYPE_POINTER_BASE && vtype < c.LMX_TYPE_ARRAY_OF_POINTER_BASE && lmx_range_stride(arena, p) != c.sizeof(@: void)
        return: LMX_QUALIFY_INVALID
    ---
    if: kind = c.LMX_KIND_ARRAY
        if: lmx_range_stride(arena, p) != c.sizeof(c.VoidArray)
            return: LMX_QUALIFY_INVALID
        ---
        array: (cast: (@: VoidArray) p)
        if: lmx_qualify_backing(arena, array, vtype, array\size, 1, profile) = 0
            return: LMX_QUALIFY_INVALID
        ---
    ---
    if: kind = c.LMX_KIND_LIST
        if: lmx_range_stride(arena, p) != c.sizeof(c.VoidDynamicArray)
            return: LMX_QUALIFY_INVALID
        ---
        dynamic: (cast: (@: VoidDynamicArray) p)
        array: (cast: (@: VoidArray) dynamic)
        if: array\size > dynamic\capacity || lmx_qualify_backing(arena, array, vtype, dynamic\capacity, 0, profile) = 0
            return: LMX_QUALIFY_INVALID
        ---
    ---
return: LMX_QUALIFY_OK

fn: lmx_qualify_tree_preflight (@: LmxArena arena; @: Lmx root; @: Lmx roles; @@: Lmx prior_profiles; size_t: prior_count; @@: Lmx method_leaves; size_t: method_count; @: int opaque_types; size_t: opaque_count) int
    LmxCopyMap: closure_storage
    LmxCopyMap: seen_storage
    LmxCopyStack: todo_storage
    @: LmxCopyMap closure (@ closure_storage)
    @: LmxCopyMap seen (@ seen_storage)
    @: LmxCopyStack todo (@ todo_storage)
    @: Lmx profile 0
    @: Lmx node
    @: void p
    @: void child
    @: VoidArray array
    @: VoidDynamicArray dynamic
    @@: void slots
    @@: void refs
    @@: void keys
    size_t: i
    size_t: j
    size_t: width
    int: kind
    int: vtype
    int: frame_role
    int: status LMX_QUALIFY_OK
    if: arena = 0 || root = 0 || lmx_qualify_struct_header(arena, (cast: (@: void) root)) = 0
        return: LMX_QUALIFY_INVALID
    if: (prior_count != 0U && prior_profiles = 0) || (method_count != 0U && method_leaves = 0) || (opaque_count != 0U && opaque_types = 0)
        return: LMX_QUALIFY_INVALID
    profile: lmx_range_profile(arena, (cast: (@: void) root))
    if: profile = 0
        return: LMX_QUALIFY_INVALID
    # independent requires zero at its own receiver.  Otherwise the root's own parent is a
    # structural lexical link to a node outside the selected tree, not a reference stored as a
    # data value (book #qualification; LMX_blog/q/immutable-root-parent.md, 2026-10-10): it is
    # validated as an ordinary live Structure header and nothing more -- not traversed, not
    # required to lie in a sealed profile.  `immutable` without `independent` seals the value
    # under its ordinary, mutable parent; RuntimeImmutable over an existing tree keeps the same
    # boundary.  A reference stored INSIDE the tree meets the data rule below (lmx_qualify_edge).
    if: root\parent != 0 && lmx_qualify_struct_header(arena, (cast: (@: void) root\parent)) = 0
        return: LMX_QUALIFY_INVALID
    memset((cast: (@: void) closure), 0, c.sizeof(c.LmxCopyMap))
    memset((cast: (@: void) seen), 0, c.sizeof(c.LmxCopyMap))
    memset((cast: (@: void) todo), 0, c.sizeof(c.LmxCopyStack))
    if: lmx_copy_map_init(closure) != 0
        return: LMX_QUALIFY_NOMEM
    if: lmx_copy_map_init(seen) != 0
        lmx_copy_map_dispose(closure)
        return: LMX_QUALIFY_NOMEM
    ---
    if: lmx_copy_map_put(closure, (cast: (@: void) root), (cast: (@: void) root)) != 0 || lmx_copy_stack_push(todo, root) != 0
        status: LMX_QUALIFY_NOMEM
    ---
    # Phase 1: containment is decided only by the child's ordinary parent.
    while: status = LMX_QUALIFY_OK && lmx_copy_stack_items_len(todo) != 0U
        node: lmx_copy_stack_pop(todo)
        if: node != root && lmx_qualify_method_leaf(node, method_leaves, method_count) != 0
            continue
        ---
        if: lmx_qualify_struct_header(arena, (cast: (@: void) node)) = 0 || lmx_range_profile(arena, (cast: (@: void) node)) != profile
            status: LMX_QUALIFY_INVALID
            break
        ---
        p: node\array.data
        width: node\array.size
        if: lmx_qualify_live_span(arena, p, width, c.LMX_KIND_CHILDREN, c.LMX_TYPE_REFS, c.sizeof(@: void), profile) = 0
            status: LMX_QUALIFY_INVALID
            break
        ---
        if: node\array.size = 0U
            continue
        ---
        slots: (cast: (@@: void) node\array.data)
        i: 0U
        while: i < node\array.size
            child: slots[i]
            if: child != 0 && lmx_range_classify(arena, child) = c.LMX_KIND_STRUCT
                if: lmx_qualify_struct_header(arena, child) = 0
                    status: LMX_QUALIFY_INVALID
                    break
                ---
                if: (cast: (@: Lmx) child)\parent = node && lmx_copy_map_get(closure, child) = 0
                    if: lmx_copy_map_put(closure, child, child) != 0 || lmx_copy_stack_push(todo, (cast: (@: Lmx) child)) != 0
                        status: LMX_QUALIFY_NOMEM
                        break
                    ---
                ---
            ---
            i: i + 1U
        ---
    ---
    lmx_copy_stack_dispose(todo)
    if: status = LMX_QUALIFY_OK
        keys: lmx_copy_map_keys_data(closure)
        i: 0U
        while: i < lmx_copy_map_keys_cap(closure)
            node: (cast: (@: Lmx) keys[i])
            if: node != 0 && (node = root || lmx_qualify_method_leaf(node, method_leaves, method_count) = 0)
                if: node != root && lmx_copy_map_get(closure, (cast: (@: void) node\parent)) = 0
                    status: LMX_QUALIFY_INVALID
                    break
                ---
                frame_role: lmx_qualify_frame_role(arena, node, roles)
                if: frame_role < 0
                    status: LMX_QUALIFY_INVALID
                    break
                ---
                slots: (cast: (@@: void) node\array.data)
                j: 0U
                while: j < node\array.size
                    if: frame_role != 0 && j != 0U
                        status: lmx_qualify_code_operand(arena, slots[j], profile)
                    else:
                        # RR2c-2b: a method leaf held in a slot (book #qualification: methods are leaves, not
                        # lexical-tree branches) is neither traversed nor required to hang under the node or to lie in
                        # a sealed profile -- its lexical parent is its own; the caller named it (method_leaves).
                        if: slots[j] != 0 && lmx_range_classify(arena, slots[j]) = c.LMX_KIND_STRUCT && lmx_qualify_method_leaf((cast: (@: Lmx) slots[j]), method_leaves, method_count) != 0
                            status: LMX_QUALIFY_OK
                        else:
                            status: lmx_qualify_edge(arena, slots[j], profile, prior_profiles, prior_count, closure, seen, todo, 0)
                        ---
                    ---
                    if: status != LMX_QUALIFY_OK
                        break
                    ---
                    j: j + 1U
                ---
            ---
            if: status != LMX_QUALIFY_OK
                break
            i: i + 1U
        ---
    ---
    # Phase 2: stored data reached by ordinary fields is scanned recursively;
    # deferred Frame operands were validated as code carriers, not data edges.
    while: status = LMX_QUALIFY_OK && lmx_copy_stack_items_len(todo) != 0U
        p: (cast: (@: void) lmx_copy_stack_pop(todo))
        kind: lmx_range_classify(arena, p)
        vtype: lmx_range_type_of(arena, p)
        if: kind = c.LMX_KIND_PRIMITIVE && vtype >= c.LMX_TYPE_POINTER_BASE && vtype < c.LMX_TYPE_ARRAY_OF_POINTER_BASE
            if: lmx_range_stride(arena, p) != c.sizeof(@: void)
                status: LMX_QUALIFY_INVALID
                break
            ---
            status: lmx_qualify_pointer_edge(arena, lmx_pointer_value_known(p), vtype - c.LMX_TYPE_POINTER_BASE, profile, prior_profiles, prior_count, closure, seen, todo, opaque_types, opaque_count)
        ---
        if: kind = c.LMX_KIND_LIST
            if: lmx_range_stride(arena, p) != c.sizeof(c.VoidDynamicArray)
                status: LMX_QUALIFY_INVALID
                break
            ---
            dynamic: (cast: (@: VoidDynamicArray) p)
            array: (cast: (@: VoidArray) dynamic)
            if: array\size > dynamic\capacity || lmx_range_profile(arena, p) != profile || lmx_qualify_backing(arena, array, vtype, dynamic\capacity, 0, profile) = 0
                status: LMX_QUALIFY_INVALID
            else:
                j: 0U
                while: j < array\size && status = LMX_QUALIFY_OK
                    if: vtype >= c.LMX_TYPE_ARRAY_OF_POINTER_BASE
                        status: lmx_qualify_pointer_edge(arena, lmx_list_value((cast: (@: void) dynamic), j), vtype - c.LMX_TYPE_ARRAY_OF_POINTER_BASE, profile, prior_profiles, prior_count, closure, seen, todo, opaque_types, opaque_count)
                    else:
                        status: lmx_qualify_edge(arena, lmx_list_value((cast: (@: void) dynamic), j), profile, prior_profiles, prior_count, closure, seen, todo, 0)
                    ---
                    j: j + 1U
                ---
            ---
        ---
        if: kind = c.LMX_KIND_ARRAY
            if: lmx_range_stride(arena, p) != c.sizeof(c.VoidArray)
                status: LMX_QUALIFY_INVALID
                break
            ---
            array: (cast: (@: VoidArray) p)
            if: lmx_range_profile(arena, p) != profile || lmx_qualify_backing(arena, array, vtype, array\size, 1, profile) = 0
                status: LMX_QUALIFY_INVALID
            else:
                if: vtype = c.LMX_TYPE_ARRAY_OF_LMX || vtype = c.LMX_TYPE_ARRAY_OF_DESC || vtype >= c.LMX_TYPE_ARRAY_OF_POINTER_BASE
                    refs: (cast: (@@: void) array\data)
                    j: 0U
                    while: j < array\size && status = LMX_QUALIFY_OK
                        if: vtype >= c.LMX_TYPE_ARRAY_OF_POINTER_BASE
                            status: lmx_qualify_pointer_edge(arena, refs[j], vtype - c.LMX_TYPE_ARRAY_OF_POINTER_BASE, profile, prior_profiles, prior_count, closure, seen, todo, opaque_types, opaque_count)
                        else:
                            status: lmx_qualify_edge(arena, refs[j], profile, prior_profiles, prior_count, closure, seen, todo, 0)
                        ---
                        j: j + 1U
                    ---
                ---
            ---
        ---
    ---
    lmx_copy_stack_dispose(todo)
    lmx_copy_map_dispose(seen)
    lmx_copy_map_dispose(closure)
return: status

# A profile-coverage walk has a different purpose from data qualification:
# after the latter succeeds, prove that sealing all arrays bearing this exact
# profile cannot also seal an unexamined, issued cell. Method occurrences have
# their own (unqualified) profile; contained ordinary Structures remain here.
fn: lmx_qualify_cover_enqueue (@: LmxArena arena; @: Lmx profile; @: void p; @: Lmx parent; @: LmxCopyMap seen; @: LmxCopyStack todo) int
    int: kind
    if: p = 0 || lmx_range_profile(arena, p) != profile
        return: LMX_QUALIFY_OK
    kind: lmx_range_classify(arena, p)
    if: kind = c.LMX_KIND_STRUCT
        if: parent = 0 || lmx_qualify_struct_header(arena, p) = 0 || (cast: (@: Lmx) p)\parent != parent
            return: LMX_QUALIFY_OK
        ---
    else:
        if: kind != c.LMX_KIND_PRIMITIVE && kind != c.LMX_KIND_ARRAY && kind != c.LMX_KIND_LIST && kind != c.LMX_KIND_SOURCE_SYMBOL && kind != c.LMX_DOMAIN_KIND_OP && kind != c.LMX_DOMAIN_KIND_ROLE && kind != c.LMX_DOMAIN_KIND_PRIMITIVE && kind != c.LMX_DOMAIN_KIND_MSG_RECORD
            return: LMX_QUALIFY_INVALID
        ---
    ---
    if: lmx_copy_map_get(seen, p) = 0
        if: lmx_copy_map_put(seen, p, p) != 0 || lmx_copy_stack_push(todo, (cast: (@: Lmx) p)) != 0
            return: LMX_QUALIFY_NOMEM
        ---
    ---
return: LMX_QUALIFY_OK

# A saved Frame operand is a physical code carrier, not its future result.
# Record its own selected-profile storage, including descriptor backing, but
# neither follow a pointer payload nor grant containment to its referent.
fn: lmx_qualify_cover_code (@: LmxArena arena; @: Lmx profile; @: void p; @: LmxQualifySpansDynamicArray spans) int
    int: kind
    int: vtype
    int: status
    @: VoidArray array
    @: VoidDynamicArray dynamic
    if: p = 0 || lmx_range_profile(arena, p) != profile
        return: LMX_QUALIFY_OK
    kind: lmx_range_classify(arena, p)
    if: kind = c.LMX_KIND_STRUCT
        return: LMX_QUALIFY_OK
    status: lmx_qualify_span_add(arena, profile, p, 1U, spans)
    if: status != LMX_QUALIFY_OK
        return: status
    vtype: lmx_range_type_of(arena, p)
    if: kind = c.LMX_KIND_ARRAY
        array: (cast: (@: VoidArray) p)
        if: lmx_qualify_backing(arena, array, vtype, array\size, 1, profile) = 0
            return: LMX_QUALIFY_INVALID
        return: lmx_qualify_span_add(arena, profile, array\data, array\size, spans)
    ---
    if: kind = c.LMX_KIND_LIST
        dynamic: (cast: (@: VoidDynamicArray) p)
        array: (cast: (@: VoidArray) dynamic)
        if: array\size > dynamic\capacity || lmx_qualify_backing(arena, array, vtype, dynamic\capacity, 0, profile) = 0
            return: LMX_QUALIFY_INVALID
        return: lmx_qualify_span_add(arena, profile, array\data, dynamic\capacity, spans)
    ---
return: LMX_QUALIFY_OK

fn: lmx_qualify_profile_coverage (@: LmxArena arena; @: Lmx root; @: Lmx roles) int
    LmxCopyMap: seen_storage
    LmxCopyStack: todo_storage
    LmxQualifySpansDynamicArray: spans_storage
    @: LmxCopyMap seen (@ seen_storage)
    @: LmxCopyStack todo (@ todo_storage)
    @: LmxQualifySpansDynamicArray spans (@ spans_storage)
    @: Lmx profile
    @: Lmx node
    @: void p
    @: void child
    @: VoidArray array
    @: VoidDynamicArray dynamic
    @@: void slots
    @@: void refs
    size_t: i
    int: kind
    int: vtype
    int: frame_role
    int: status LMX_QUALIFY_OK
    if: arena = 0 || root = 0 || lmx_qualify_struct_header(arena, (cast: (@: void) root)) = 0
        return: LMX_QUALIFY_INVALID
    profile: lmx_range_profile(arena, (cast: (@: void) root))
    if: profile = 0
        return: LMX_QUALIFY_INVALID
    memset((cast: (@: void) seen), 0, c.sizeof(c.LmxCopyMap))
    memset((cast: (@: void) todo), 0, c.sizeof(c.LmxCopyStack))
    memset((cast: (@: void) spans), 0, c.sizeof(c.LmxQualifySpansDynamicArray))
    if: lmx_copy_map_init(seen) != 0
        return: LMX_QUALIFY_NOMEM
    if: lmx_copy_map_put(seen, (cast: (@: void) root), (cast: (@: void) root)) != 0 || lmx_copy_stack_push(todo, root) != 0
        status: LMX_QUALIFY_NOMEM
    ---
    while: status = LMX_QUALIFY_OK && lmx_copy_stack_items_len(todo) != 0U
        p: (cast: (@: void) lmx_copy_stack_pop(todo))
        kind: lmx_range_classify(arena, p)
        status: lmx_qualify_span_add(arena, profile, p, 1U, spans)
        if: status != LMX_QUALIFY_OK
            break
        ---
        if: kind = c.LMX_KIND_STRUCT
            node: (cast: (@: Lmx) p)
            array: (cast: (@: VoidArray) node)
            status: lmx_qualify_span_add(arena, profile, array\data, array\size, spans)
            if: status != LMX_QUALIFY_OK
                break
            ---
            frame_role: lmx_qualify_frame_role(arena, node, roles)
            if: frame_role < 0
                status: LMX_QUALIFY_INVALID
                break
            ---
            slots: (cast: (@@: void) node\array.data)
            i: 0U
            while: i < node\array.size && status = LMX_QUALIFY_OK
                child: slots[i]
                if: child != 0 && lmx_range_profile(arena, child) = profile && lmx_range_classify(arena, child) = c.LMX_KIND_STRUCT && (cast: (@: Lmx) child)\parent = node
                    status: lmx_qualify_cover_enqueue(arena, profile, child, node, seen, todo)
                else:
                    if: frame_role != 0 && i != 0U
                        status: lmx_qualify_cover_code(arena, profile, child, spans)
                    else:
                        status: lmx_qualify_cover_enqueue(arena, profile, child, 0, seen, todo)
                    ---
                ---
                i: i + 1U
            ---
        else:
            vtype: lmx_range_type_of(arena, p)
            if: kind = c.LMX_KIND_PRIMITIVE && vtype >= c.LMX_TYPE_POINTER_BASE && vtype < c.LMX_TYPE_ARRAY_OF_POINTER_BASE
                status: lmx_qualify_cover_enqueue(arena, profile, lmx_pointer_value_known(p), 0, seen, todo)
            ---
            if: (kind = c.LMX_KIND_ARRAY || kind = c.LMX_KIND_LIST) && status = LMX_QUALIFY_OK
                if: kind = c.LMX_KIND_ARRAY
                    array: (cast: (@: VoidArray) p)
                    status: lmx_qualify_span_add(arena, profile, array\data, array\size, spans)
                else:
                    dynamic: (cast: (@: VoidDynamicArray) p)
                    array: (cast: (@: VoidArray) dynamic)
                    status: lmx_qualify_span_add(arena, profile, array\data, dynamic\capacity, spans)
                ---
                if: status = LMX_QUALIFY_OK && (vtype = c.LMX_TYPE_ARRAY_OF_LMX || vtype = c.LMX_TYPE_ARRAY_OF_DESC || vtype >= c.LMX_TYPE_ARRAY_OF_POINTER_BASE)
                    refs: (cast: (@@: void) array\data)
                    i: 0U
                    while: i < array\size && status = LMX_QUALIFY_OK
                        status: lmx_qualify_cover_enqueue(arena, profile, refs[i], 0, seen, todo)
                        i: i + 1U
                    ---
                ---
            ---
        ---
    ---
    if: status = LMX_QUALIFY_OK
        status: lmx_qualify_spans_complete(arena, profile, spans)
    ---
    free((cast: (@: void) spans\data))
    lmx_copy_stack_dispose(todo)
    lmx_copy_map_dispose(seen)
return: status

fn: lmx_qualify_tree_preflight_full (@: LmxArena arena; @: Lmx root; @: Lmx roles; @@: Lmx prior_profiles; size_t: prior_count; @@: Lmx method_leaves; size_t: method_count; @: int opaque_types; size_t: opaque_count) int
    int: status lmx_qualify_tree_preflight(arena, root, roles, prior_profiles, prior_count, method_leaves, method_count, opaque_types, opaque_count)
    if: status != LMX_QUALIFY_OK
        return: status
return: lmx_qualify_profile_coverage(arena, root, roles)

# Register a destination header for a source Structure before any of its edges
# are followed (ABI 8.2), and queue its edges. Idempotent per source address.
# Never called for a value in the exact retained physical profile: callers test first.
# A copy root, a Structure reached through a slot or an array element, and a structural
# parent queued for the parent fixup are registered alike: since Q44 nothing is shared by
# address for lying outside the copied subtree, so the copier keeps no "inside" set.
fn: lmx_copy_ensure_struct (@: Lmx src; @: LmxCopyMap map; @: LmxCopyMap wholes; @: LmxCopyStack todo; @: LmxArena dst_arena; @: int status; @: Lmx dst_profile) int
    @: Lmx dst
    if: src = 0
        return: 0
    if: lmx_copy_map_get(map, (cast: (@: void) src)) != 0
        # The used copy (`wholes` given): a Structure first demanded in part and now reached as a whole value is
        # upgraded in the same construction -- one destination identity, its remaining slots copied before publication.
        if: wholes != 0 && lmx_copy_map_get(wholes, (cast: (@: void) src)) = 0
            if: lmx_copy_map_put(wholes, (cast: (@: void) src), (cast: (@: void) src)) != 0 || lmx_copy_stack_push(todo, src) != 0
                \status: LMX_GRAPH_COPY_NOMEM
                return: 1
            ---
        ---
        return: 0
    dst: lmx_node_new_profiled(dst_arena, dst_profile)
    if: dst = 0
        \status: LMX_GRAPH_COPY_NOMEM
        return: 1
    if: lmx_copy_map_put(map, (cast: (@: void) src), (cast: (@: void) dst)) != 0
        \status: LMX_GRAPH_COPY_NOMEM
        return: 1
    if: lmx_copy_stack_push(todo, src) != 0
        \status: LMX_GRAPH_COPY_NOMEM
        return: 1
    if: wholes != 0 && lmx_copy_map_put(wholes, (cast: (@: void) src), (cast: (@: void) src)) != 0
        \status: LMX_GRAPH_COPY_NOMEM
        return: 1
    return: 0


# One child value or array element: returns the destination reference for it,
# copying language-owned mutable data exactly once per source address.
fn: lmx_copy_value (@: void v; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: LmxCopyMap map; @: LmxCopyMap wholes; @: LmxCopyStack todo; @: int status; @: Lmx dst_profile; @@: Lmx leaves; size_t: leaf_count) @: void
    int: kind 0
    int: vtype 0
    @: void known
    @: void cell 0
    @: VoidArray src_desc
    @: VoidArray dst_desc 0
    @: VoidArray src_list
    @: VoidArray dst_list 0
    @@: void src_refs
    @@: void dst_refs
    size_t: i 0U
    int: is_ref 0
    int: pointer_element_type 0
    @: void pointee
    if: v = 0
        return: 0
    if: lmx_copy_retained_profiles(src_arena, v, retain_profiles, retain_count) != 0
        # A retained qualified reference must already be visible in the destination's
        # local/imported range index.  Import is an explicit range-table act; copying must
        # neither adopt foreign ownership nor leave an unclassifiable reference behind.
        if: lmx_copy_retained_profiles(dst_arena, v, retain_profiles, retain_count) = 0
            \status: LMX_GRAPH_COPY_INVALID
            return: 0
        ---
        return: v
    if: lmx_copy_is_terminal_profiles(src_arena, v, retain_profiles, retain_count) != 0
        # A shared METHOD/runtime descriptor: a terminal kept by address.
        return: v
    # RR2c-2b: a method leaf of the qualified copy -- a callable occurrence the value holds -- is kept by address: a
    # leaf of the tree, not a branch (book #qualification), its cells stay unprofiled and writable, its lexical parent
    # stays; the caller names the leaves (lmx_graph_copy_qualified_leaves_owned) and gives the preflight the same list.
    if: leaf_count != 0U && lmx_qualify_method_leaf((cast: (@: Lmx) v), leaves, leaf_count) != 0
        return: v
    known: lmx_copy_map_get(map, v)
    if: known != 0
        if: wholes != 0 && lmx_range_classify(src_arena, v) = c.LMX_KIND_STRUCT && lmx_copy_ensure_struct((cast: (@: Lmx) v), map, wholes, todo, dst_arena, status, dst_profile) != 0
            return: 0
        return: known
    kind: lmx_range_classify(src_arena, v)
    if: kind = c.LMX_KIND_NONE
        # Neither language-owned state nor a terminal: a raw/foreign reference.
        # Refuse rather than retain a pointer whose lifetime nobody has admitted.
        \status: LMX_GRAPH_COPY_UNSUPPORTED
        return: 0
    vtype: lmx_range_type_of(src_arena, v)
    if: kind = c.LMX_KIND_STRUCT
        # Every reached Structure is copied through the same map, including an
        # application headed by an OP/ROLE terminal. The terminal and native entry
        # stay shared; the application, operands and lexical parents do not.
        if: lmx_copy_ensure_struct((cast: (@: Lmx) v), map, wholes, todo, dst_arena, status, dst_profile) != 0
            return: 0
        return: lmx_copy_map_get(map, v)
    if: kind = c.LMX_KIND_SOURCE_SYMBOL
        # A source leaf has only occurrence identity; its spelling is external.
        # Unlike a shared OP/ROLE it is copied through the ordinary address map.
        cell: lmx_arena_take_profiled(dst_arena, c.sizeof(c.char), kind, vtype, dst_profile)
        if: cell = 0
            \status: LMX_GRAPH_COPY_NOMEM
            return: 0
        memset(cell, 0, c.sizeof(c.char))
        if: lmx_copy_map_put(map, v, cell) != 0
            \status: LMX_GRAPH_COPY_NOMEM
            return: 0
        return: cell
    if: kind = c.LMX_KIND_PRIMITIVE
        if: vtype = c.LMX_TYPE_CHAR
            cell: lmx_char_new_profiled(dst_arena, dst_profile)
            if: cell = 0
                \status: LMX_GRAPH_COPY_NOMEM
                return: 0
            lmx_char_store_known(cell, lmx_char_value_known(v))
        if: vtype = c.LMX_TYPE_INT
            cell: lmx_int_new_profiled(dst_arena, dst_profile)
            if: cell = 0
                \status: LMX_GRAPH_COPY_NOMEM
                return: 0
            lmx_int_store_known(cell, lmx_int_value_known(v))
        if: vtype = c.LMX_TYPE_SIZE_T
            cell: lmx_size_new_profiled(dst_arena, dst_profile)
            if: cell = 0
                \status: LMX_GRAPH_COPY_NOMEM
                return: 0
            lmx_size_store_known(cell, lmx_size_value_known(v))
        if: vtype = c.LMX_TYPE_UNSIGNED
            cell: lmx_unsigned_new_profiled(dst_arena, dst_profile)
            if: cell = 0
                \status: LMX_GRAPH_COPY_NOMEM
                return: 0
            lmx_unsigned_store_known(cell, lmx_unsigned_value_known(v))
        if: vtype = c.LMX_TYPE_ULONG
            cell: lmx_ulong_new_profiled(dst_arena, dst_profile)
            if: cell = 0
                \status: LMX_GRAPH_COPY_NOMEM
                return: 0
            lmx_ulong_store_known(cell, lmx_ulong_value_known(v))
        if: vtype = c.LMX_TYPE_UNSIGNED_CHAR
            cell: lmx_uchar_new_profiled(dst_arena, dst_profile)
            if: cell = 0
                \status: LMX_GRAPH_COPY_NOMEM
                return: 0
            lmx_uchar_store_known(cell, lmx_uchar_value_known(v))
        if: vtype = c.LMX_TYPE_CHAR_PTR
            cell: lmx_charptr_new_profiled(dst_arena, dst_profile)
            if: cell = 0
                \status: LMX_GRAPH_COPY_NOMEM
                return: 0
            lmx_charptr_store_known(cell, lmx_charptr_value_known(v))
        if: vtype >= c.LMX_TYPE_POINTER_BASE
            # A reference field (@: T) is a pointer cell.  The author (2026-10-10,
            # LMX_blog/2026-10-10.md#full-copy-20261010): copying at a merge is full,
            # retaining by reference only `independent: const: immutable` branches --
            # so the pointee is copied through the same map as every graph value
            # (an alias of a copied value is the one copy; a retained profile or a
            # kernel terminal keeps its address; a cycle ends at the map).  The
            # -186 k3 rule that shared the pointee is withdrawn.  The cell enters the
            # map before its pointee is copied, so a pointee that points back finds it.
            cell: lmx_pointer_new_profiled(vtype, dst_arena, dst_profile)
            if: cell = 0
                \status: LMX_GRAPH_COPY_NOMEM
                return: 0
            if: lmx_copy_map_put(map, v, cell) != 0
                \status: LMX_GRAPH_COPY_NOMEM
                return: 0
            pointee: lmx_pointer_value_known(v)
            if: pointee != 0
                pointee: lmx_copy_value(pointee, src_arena, dst_arena, retain_profiles, retain_count, map, wholes, todo, status, dst_profile, leaves, leaf_count)
                if: \status != LMX_GRAPH_COPY_OK
                    return: 0
            ---
            if: lmx_pointer_store_known(cell, pointee) != 0
                \status: LMX_GRAPH_COPY_INVALID
                return: 0
            return: cell
        if: cell = 0
            \status: LMX_GRAPH_COPY_UNSUPPORTED
            return: 0
        if: lmx_copy_map_put(map, v, cell) != 0
            \status: LMX_GRAPH_COPY_NOMEM
            return: 0
        return: cell
    if: kind = c.LMX_KIND_LIST
        src_list: (cast: (@: VoidArray) v)
        dst_list: lmx_list_new_profiled(vtype, dst_arena, dst_profile)
        if: dst_list = 0
            \status: LMX_GRAPH_COPY_NOMEM
            return: 0
        if: lmx_copy_map_put(map, v, (cast: (@: void) dst_list)) != 0
            \status: LMX_GRAPH_COPY_NOMEM
            return: 0
        i: 0U
        while: i < src_list\size
            if: lmx_list_append_owned(dst_list, lmx_copy_value(lmx_list_value(src_list, i), src_arena, dst_arena, retain_profiles, retain_count, map, wholes, todo, status, dst_profile, leaves, leaf_count), dst_arena) != c.LMX_LIST_OK
                if: \status = LMX_GRAPH_COPY_OK
                    \status: LMX_GRAPH_COPY_NOMEM
                return: 0
            if: \status != LMX_GRAPH_COPY_OK
                return: 0
            i: i + 1U
        ---
        return: (cast: (@: void) dst_list)
    if: kind = c.LMX_KIND_ARRAY
        src_desc: (cast: (@: VoidArray) v)
        if: src_desc\size != 0U && src_desc\data = 0
            \status: LMX_GRAPH_COPY_UNSUPPORTED
            return: 0
        if: src_desc\size = 0U && src_desc\data != 0
            \status: LMX_GRAPH_COPY_UNSUPPORTED
            return: 0
        if: src_desc\size != 0U
            # The backing cells are an array of the source arena like any other:
            # what they are is answered by classification, never by an inventory.
            if: lmx_range_classify(src_arena, src_desc\data) = c.LMX_KIND_NONE
                \status: LMX_GRAPH_COPY_UNSUPPORTED
                return: 0
            ---
        if: vtype = c.LMX_TYPE_ARRAY_OF_CHAR || vtype = c.LMX_TYPE_ARRAY_OF_INT || vtype = c.LMX_TYPE_ARRAY_OF_SIZE_T || vtype = c.LMX_TYPE_ARRAY_OF_UNSIGNED_CHAR || vtype = c.LMX_TYPE_ARRAY_OF_ULONG
            dst_desc: lmx_array_new_profiled(vtype, src_desc\size, dst_arena, dst_profile)
            if: dst_desc = 0
                \status: LMX_GRAPH_COPY_NOMEM
                return: 0
            if: src_desc\size != 0U
                memcpy(dst_desc\data, src_desc\data, src_desc\size * lmx_range_stride(src_arena, src_desc\data))
            ---
        if: vtype = c.LMX_TYPE_ARRAY_OF_LMX || vtype = c.LMX_TYPE_ARRAY_OF_DESC
            is_ref: 1
            dst_desc: lmx_array_ref_new_profiled(vtype, src_desc\size, dst_arena, dst_profile)
            if: dst_desc = 0
                \status: LMX_GRAPH_COPY_NOMEM
                return: 0
            ---
        else:
            if: vtype >= c.LMX_TYPE_ARRAY_OF_POINTER_BASE
                is_ref: 1
                pointer_element_type: c.LMX_TYPE_POINTER_BASE + (vtype - c.LMX_TYPE_ARRAY_OF_POINTER_BASE)
                if: src_desc\size != 0U && (lmx_range_classify(src_arena, src_desc\data) != c.LMX_KIND_PRIMITIVE || lmx_range_type_of(src_arena, src_desc\data) != pointer_element_type || lmx_range_stride(src_arena, src_desc\data) != c.sizeof(@: void))
                    \status: LMX_GRAPH_COPY_UNSUPPORTED
                    return: 0
                ---
                dst_desc: lmx_array_new_profiled(vtype, src_desc\size, dst_arena, dst_profile)
                if: dst_desc = 0
                    \status: LMX_GRAPH_COPY_NOMEM
                    return: 0
                ---
            ---
        ---
        if: dst_desc = 0
            \status: LMX_GRAPH_COPY_UNSUPPORTED
            return: 0
        # Register the record before following reference elements so a cycle
        # through an Array terminates on the same copy.
        if: lmx_copy_map_put(map, v, (cast: (@: void) dst_desc)) != 0
            \status: LMX_GRAPH_COPY_NOMEM
            return: 0
        if: is_ref != 0
            src_refs: (cast: (@@: void) src_desc\data)
            dst_refs: (cast: (@@: void) dst_desc\data)
            while: i < src_desc\size
                dst_refs[i]: lmx_copy_value(src_refs[i], src_arena, dst_arena, retain_profiles, retain_count, map, wholes, todo, status, dst_profile, leaves, leaf_count)
                if: \status != LMX_GRAPH_COPY_OK
                    return: 0
                i: i + 1U
            ---
        ---
        return: (cast: (@: void) dst_desc)
    # CHILDREN slot storage or a REF backing cell is never a valid child value.
    \status: LMX_GRAPH_COPY_INVALID
    return: 0

# The used copy (Q42: merge copies everything the copied code uses, and of a Structure
# reached only for a use, only the fields used -- LMX_blog/2026-09-27.md; Codex
# K03-READ-FIELD-CLOSURE-20261007-28).  A Structure needed in part is registered once,
# at its source width, every slot absent until a use or a link fills it: no primitive
# cell, no default, no reference into the source.  Absent stays absent.
# The walk's operand contract (lmx_walk.h.lm1): operand i of the operation whose record has
# `code` is the holder a place is read or written in -- operand 1 of AT, PUT_REF, OF, OWN_OF,
# PUT_OF, SET_OF, ELEM and ELEMPUT.  Every other operand is a value.  1 or 0.
fn: lmx_copy_holder_operand (int: code; size_t: i) int
    int: op 0
    if: code < 0 || i != 1U
        return: 0
    op: code % c.LMX_WALK_OP_COUNT
    if: op = c.LMX_WALK_OP_AT || op = c.LMX_WALK_OP_PUT_REF || op = c.LMX_WALK_OP_OF || op = c.LMX_WALK_OP_OWN_OF
        return: 1
    if: op = c.LMX_WALK_OP_PUT_OF || op = c.LMX_WALK_OP_SET_OF || op = c.LMX_WALK_OP_ELEM || op = c.LMX_WALK_OP_ELEMPUT
        return: 1
return: 0

# The used copy's execution anchor (Codex K03-READ-FIELD-CLOSURE-20261008-29 point 2): operand i of
# an executable application -- its slot 0 the operation's record (OP) -- that the operation's
# contract makes the HOLDER of a place (lmx_copy_holder_operand) reads one place of that holder in
# place.  When the holder is a place of the application's lexical context -- one of its own
# lexical ancestors, or a data Structure whose parent chain meets one of them before it meets the
# application itself (whose sub-expressions are its code) or a retained-profile Structure (kept
# by identity, nothing below it copied): a program part's root a callee's hidden input is read
# from, a sibling Structure of the unit -- the copy links it in part, the records filling its used
# places.  The same Structure as any other operand -- a value an operation consumes (a merge's
# operand, a stored reference) -- or in a data Structure's slot is an ordinary value and is copied
# whole (lmx_copy_value), the same map entry upgraded whatever the order it is met in.
fn: lmx_copy_up (@: LmxArena src_arena; @: Lmx holder; size_t: i; @: void v; @@: Lmx retain_profiles; size_t: retain_count) int
    @: Lmx up
    @: Lmx w
    @: void head 0
    @: void wh 0
    int: wk 0
    if: holder = 0 || v = 0 || holder\array.size = 0U || holder\array.data = 0
        return: 0
    head: lmx_arena_ref_value(holder, 0U)
    if: head = 0 || lmx_range_classify(src_arena, head) != c.LMX_DOMAIN_KIND_OP
        return: 0
    if: lmx_copy_holder_operand((cast: (@: LmxOp) head)\code, i) = 0
        return: 0
    up: holder\parent
    while: up != 0
        if: (cast: (@: void) up) = v
            return: 1
        up: up\parent
    ---
    if: lmx_range_classify(src_arena, v) != c.LMX_KIND_STRUCT
        return: 0
    w: (cast: (@: Lmx) v)
    if: w\array.size != 0U && w\array.data != 0
        wh: lmx_arena_ref_value(w, 0U)
        if: wh != 0
            wk: lmx_range_classify(src_arena, wh)
        if: wk = c.LMX_DOMAIN_KIND_OP || wk = c.LMX_DOMAIN_KIND_ROLE
            return: 0
    ---
    w: w\parent
    while: w != 0
        if: w = holder || lmx_copy_retained_profiles(src_arena, (cast: (@: void) w), retain_profiles, retain_count) != 0
            return: 0
        up: holder\parent
        while: up != 0
            if: up = w
                return: 1
            up: up\parent
        ---
        w: w\parent
    ---
    return: 0

fn: lmx_copy_part (@: Lmx src; @: LmxArena src_arena; @: LmxArena dst_arena; @: LmxCopyMap map; @: LmxCopyStack links; @: int status; @: Lmx dst_profile) int
    @: Lmx dst
    if: src = 0 || lmx_range_classify(src_arena, (cast: (@: void) src)) != c.LMX_KIND_STRUCT
        \status: LMX_GRAPH_COPY_INVALID
        return: 1
    dst: (cast: (@: Lmx) lmx_copy_map_get(map, (cast: (@: void) src)))
    if: dst = 0
        dst: lmx_node_new_profiled(dst_arena, dst_profile)
        if: dst = 0 || lmx_copy_map_put(map, (cast: (@: void) src), (cast: (@: void) dst)) != 0 || lmx_copy_stack_push(links, src) != 0
            \status: LMX_GRAPH_COPY_NOMEM
            return: 1
        ---
    ---
    if: dst\array.data = 0 && src\array.size != 0U && lmx_arena_refs_open_profiled(dst_arena, dst, (src\array.size), lmx_range_profile(dst_arena, (cast: (@: void) dst))) != 0
        \status: LMX_GRAPH_COPY_NOMEM
        return: 1
    return: 0

# Copies the slots of one queued source Structure into its registered copy and
# queues its structural parent, so the copied tree always reaches parent = 0.  In the
# used copy (`wholes` given) the parent is queued on `links`: it is a lexical
# ancestor the copy needs only in part (lmx_copy_link).  The SUBTREE copy (chain 0,
# RR2c-2b) queues no parent: the copy hangs where the source hangs (the parent fixup
# keeps the source's own parent as an outside structural link).
fn: lmx_copy_process (@: Lmx src; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: LmxCopyMap map; @: LmxCopyMap wholes; @: LmxCopyStack todo; @: LmxCopyStack links; @: int status; @: Lmx dst_profile; int: chain; @@: Lmx leaves; size_t: leaf_count) int
    @: Lmx dst
    @@: void src_slots
    @: void copied
    size_t: i 0U
    dst: (cast: (@: Lmx) lmx_copy_map_get(map, (cast: (@: void) src)))
    if: dst = 0
        \status: LMX_GRAPH_COPY_INVALID
        return: 1
    if: src\parent != 0
        if: lmx_range_classify(src_arena, (cast: (@: void) src\parent)) != c.LMX_KIND_STRUCT
            \status: LMX_GRAPH_COPY_INVALID
            return: 1
        ---
        # An exact retained-profile structural parent keeps its physical identity.  It must
        # never enter the copy map, otherwise the later parent fixup would see a
        # copied parent and could no longer preserve the retained address.
        if: chain != 0 && wholes = 0 && lmx_copy_retained_profiles(src_arena, (cast: (@: void) src\parent), retain_profiles, retain_count) = 0
            if: lmx_copy_ensure_struct(src\parent, map, wholes, todo, dst_arena, status, dst_profile) != 0
                return: 1
            ---
        ---
    ---
    if: chain != 0 && wholes != 0 && lmx_copy_stack_push(links, src) != 0
        \status: LMX_GRAPH_COPY_NOMEM
        return: 1
    if: src\array.size = 0U || src\array.data = 0
        return: 0
    # A Structure's `array.data` IS its child-pointer array, reached through the
    # Structure: finding it needs no lookup, even though the array is an array of
    # the arena and is in the index like every other one. What is classified is
    # every child VALUE read out of it.
    # A Structure demanded in part before (the used copy) already has its slots open.  The children's array is of the
    # node's own profile: a composition's discarded root is outside the destination profile, its children inside.
    if: dst\array.data = 0 && lmx_arena_refs_open_profiled(dst_arena, dst, (src\array.size), lmx_range_profile(dst_arena, (cast: (@: void) dst))) != 0
        \status: LMX_GRAPH_COPY_NOMEM
        return: 1
    src_slots: (cast: (@@: void) src\array.data)
    while: i < src\array.size
        # The used copy: the holder operand of a place operation naming a place of src's lexical
        # context (one of its own lexical ancestors, or a Structure under one: what an executable
        # expression reads in place) is a link to that place, needed in part like src's parent --
        # not a use of its whole value (lmx_copy_up).
        if: wholes != 0 && i != 0U && lmx_copy_up(src_arena, src, i, src_slots[i], retain_profiles, retain_count) != 0
            if: lmx_copy_retained_profiles(src_arena, src_slots[i], retain_profiles, retain_count) != 0
                copied: src_slots[i]
            else:
                if: lmx_copy_part((cast: (@: Lmx) src_slots[i]), src_arena, dst_arena, map, links, status, dst_profile) != 0
                    return: 1
                copied: lmx_copy_map_get(map, src_slots[i])
            ---
            if: lmx_arena_ref_store(dst, i, copied) != 0
                \status: LMX_GRAPH_COPY_INVALID
                return: 1
            i: i + 1U
            continue
        ---
        copied: lmx_copy_value(src_slots[i], src_arena, dst_arena, retain_profiles, retain_count, map, wholes, todo, status, dst_profile, leaves, leaf_count)
        if: \status != LMX_GRAPH_COPY_OK
            return: 1
        if: lmx_arena_ref_store(dst, i, copied) != 0
            \status: LMX_GRAPH_COPY_INVALID
            return: 1
        i: i + 1U
    ---
    return: 0

# Prepare the name of an actual copied place. The private map keeps pending
# rows unpublished until the complete graph and every spelling are ready.
fn: lmx_copy_name_prepare (@: LmxArena src_arena; @: LmxArena dst_arena; @: void source; @: void destination; @: LmxCopyMap pending) int
    @: VoidArray text lmx_source_name_get(src_arena, source)
    @: LmxSourceName row 0
    if: text = 0
        return: LMX_GRAPH_COPY_OK
    if: lmx_copy_map_keys_data(pending) = 0
        if: lmx_copy_map_init(pending) != 0
            return: LMX_GRAPH_COPY_NOMEM
        ---
    ---
    row: (cast: (@: LmxSourceName) lmx_copy_map_get(pending, destination))
    if: row != 0
        if: row\text.size != text\size || (text\size != 0U && memcmp((row\text.data), (text\data), (text\size)) != 0)
            return: LMX_GRAPH_COPY_INVALID
        return: LMX_GRAPH_COPY_OK
    if: lmx_source_name_prepare(dst_arena, destination, (cast: (@: char) text\data), (text\size), @ row) != 0
        return: LMX_GRAPH_COPY_NOMEM
    if: row != 0
        if: lmx_copy_map_put(pending, destination, (cast: (@: void) row)) != 0
            lmx_source_name_cancel(row)
            return: LMX_GRAPH_COPY_NOMEM
        ---
    ---
return: LMX_GRAPH_COPY_OK

fn: lmx_copy_names (@: LmxArena src_arena; @: LmxArena dst_arena; @: LmxCopyMap map; @: LmxCopyMap pending) int
    @@: void keys lmx_copy_map_keys_data(map)
    @@: void vals lmx_copy_map_vals_data(map)
    @: Lmx src
    @: Lmx dst
    size_t: i 0U
    size_t: j
    int: status LMX_GRAPH_COPY_OK
    while: i < lmx_copy_map_keys_cap(map) && status = LMX_GRAPH_COPY_OK
        if: keys[i] != 0
            status: lmx_copy_name_prepare(src_arena, dst_arena, keys[i], vals[i], pending)
            if: status = LMX_GRAPH_COPY_OK && lmx_range_classify(src_arena, keys[i]) = c.LMX_KIND_STRUCT
                src: (cast: (@: Lmx) keys[i])
                dst: (cast: (@: Lmx) vals[i])
                j: 0U
                while: j < src\array.size && status = LMX_GRAPH_COPY_OK
                    status: lmx_copy_name_prepare(src_arena, dst_arena, (cast: (@: void) lmx_arena_ref_cell(src, j)), (cast: (@: void) lmx_arena_ref_cell(dst, j)), pending)
                    j: j + 1U
                ---
            ---
        ---
        i: i + 1U
    ---
return: status

fn: lmx_copy_names_finish (@: LmxCopyMap pending; int: publish) void
    @@: void keys
    @@: void vals
    @: LmxSourceName row
    size_t: i 0U
    # Publication cannot allocate/fail. The OUTERMOST constructor invokes
    # this once; on failure it cancels before retiring any destination range.
    keys: lmx_copy_map_keys_data(pending)
    vals: lmx_copy_map_vals_data(pending)
    while: i < lmx_copy_map_keys_cap(pending)
        if: keys[i] != 0
            row: (cast: (@: LmxSourceName) vals[i])
            if: publish != 0
                lmx_source_name_publish(row, keys[i])
            else:
                lmx_source_name_cancel(row)
            ---
        ---
        i: i + 1U
    ---
    lmx_copy_map_dispose(pending)

# Is `value` the copy of one of the operation's roots that was copied, not retained?  The
# absorb pass's one question (lmx_copy_absorb).
fn: lmx_copy_absorbed (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @@: Lmx retain_profiles; size_t: retain_count; @: LmxCopyMap map; @: void value) int
    size_t: r 0U
    if: value = 0
        return: 0
    while: r < count
        if: lmx_copy_retained_profiles(src_arena, (cast: (@: void) sources[r]), retain_profiles, retain_count) = 0 && lmx_copy_map_get(map, (cast: (@: void) sources[r])) = value
            return: 1
        r: r + 1U
    ---
return: 0

# A composition's absorb pass: the operation's copied roots are absorbed into `absorb`
# (merge's fresh result, or the target a merge-into writes), so every copied Structure's
# child slot that holds a copied root, and every copied Structure's parent that is one,
# names `absorb` -- no link reaches a discarded intermediate root.  The roots' own
# parents stay: the composition places its result by them (lmx_merge_lexical).  A root
# retained by its exact profile is itself and is never absorbed.
fn: lmx_copy_absorb (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @@: Lmx retain_profiles; size_t: retain_count; @: LmxCopyMap map; @: Lmx absorb) int
    @@: void keys
    @@: void vals
    @: void key
    @: Lmx dst 0
    @: void value 0
    size_t: i 0U
    size_t: j 0U
    keys: lmx_copy_map_keys_data(map)
    vals: lmx_copy_map_vals_data(map)
    while: i < lmx_copy_map_keys_cap(map)
        key: keys[i]
        if: key != 0 && lmx_range_classify(src_arena, key) = c.LMX_KIND_STRUCT
            dst: (cast: (@: Lmx) vals[i])
            if: lmx_copy_absorbed(sources, count, src_arena, retain_profiles, retain_count, map, (cast: (@: void) dst)) = 0 && lmx_copy_absorbed(sources, count, src_arena, retain_profiles, retain_count, map, (cast: (@: void) (dst\parent))) != 0
                dst\parent: absorb
            ---
            j: 0U
            while: j < dst\array.size
                value: lmx_arena_ref_value(dst, j)
                if: lmx_copy_absorbed(sources, count, src_arena, retain_profiles, retain_count, map, value) != 0
                    if: lmx_arena_ref_store(dst, j, (cast: (@: void) absorb)) != 0
                        return: LMX_GRAPH_COPY_INVALID
                    ---
                ---
                j: j + 1U
            ---
        ---
        i: i + 1U
    ---
return: LMX_GRAPH_COPY_OK

# A copied Structure's lexical parent, in the used copy: the parent is needed in part --
# the slots that hold the copied child (the chain link), not its other children (Codex
# -28, A: source coordinates kept, unread places absent).  A retained-profile parent
# keeps its identity and is not entered.
fn: lmx_copy_link (@: Lmx child; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: LmxCopyMap map; @: LmxCopyStack links; @: int status; @: Lmx dst_profile; @@: Lmx leaves; size_t: leaf_count) int
    @: Lmx up
    @: Lmx dup
    @@: void slots
    size_t: i 0U
    up: child\parent
    if: up = 0 || lmx_copy_retained_profiles(src_arena, (cast: (@: void) up), retain_profiles, retain_count) != 0
        return: 0
    if: lmx_copy_part(up, src_arena, dst_arena, map, links, status, dst_profile) != 0
        return: 1
    dup: (cast: (@: Lmx) lmx_copy_map_get(map, (cast: (@: void) up)))
    slots: (cast: (@@: void) up\array.data)
    while: slots != 0 && i < up\array.size
        if: slots[i] = (cast: (@: void) child) && lmx_arena_ref_store(dup, i, lmx_copy_map_get(map, (cast: (@: void) child))) != 0
            \status: LMX_GRAPH_COPY_INVALID
            return: 1
        ---
        i: i + 1U
    ---
    return: 0

# One use, a slot path from a source Structure (an anchor: a lexical ancestor of an
# operand, or any reached source Structure): each intermediate Structure is needed in
# part -- only the slot the path takes -- and the last slot's value is copied as a value:
# a cell as a cell, a Structure whole (its full value is what is used).  Two uses of one
# Structure join in its one copy; a later whole use upgrades it (lmx_copy_ensure_struct).
fn: lmx_copy_use (@: Lmx anchor; @: size_t path; size_t: len; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: LmxCopyMap map; @: LmxCopyMap wholes; @: LmxCopyStack todo; @: LmxCopyStack links; @: int status; @: Lmx dst_profile; @@: Lmx leaves; size_t: leaf_count) int
    @: Lmx x
    @: Lmx dx
    @: void v
    @: void copied
    size_t: i 0U
    size_t: s
    x: anchor
    # Every anchor reaching here is a source Structure (lmx_copy_run refused an absent explicit one and never
    # passes an operand-parent selector whose operand has no lexical parent).
    if: x = 0 || path = 0 || len = 0U
        \status: LMX_GRAPH_COPY_INVALID
        return: 1
    while: i < len
        if: lmx_copy_retained_profiles(src_arena, (cast: (@: void) x), retain_profiles, retain_count) != 0
            # A retained branch is itself: the use reaches it, nothing below it is copied.
            return: 0
        if: lmx_copy_part(x, src_arena, dst_arena, map, links, status, dst_profile) != 0
            return: 1
        s: path[i]
        if: s >= x\array.size || x\array.data = 0
            \status: LMX_GRAPH_COPY_INVALID
            return: 1
        v: lmx_arena_ref_value(x, s)
        dx: (cast: (@: Lmx) lmx_copy_map_get(map, (cast: (@: void) x)))
        if: i + 1U < len
            if: v = 0 || lmx_range_classify(src_arena, v) != c.LMX_KIND_STRUCT
                \status: LMX_GRAPH_COPY_INVALID
                return: 1
            ---
            if: lmx_copy_retained_profiles(src_arena, v, retain_profiles, retain_count) != 0
                if: lmx_arena_ref_store(dx, s, v) != 0
                    \status: LMX_GRAPH_COPY_INVALID
                    return: 1
                ---
                return: 0
            ---
            if: lmx_copy_part((cast: (@: Lmx) v), src_arena, dst_arena, map, links, status, dst_profile) != 0
                return: 1
            if: lmx_arena_ref_store(dx, s, lmx_copy_map_get(map, v)) != 0
                \status: LMX_GRAPH_COPY_INVALID
                return: 1
            ---
            x: (cast: (@: Lmx) v)
        else:
            copied: lmx_copy_value(v, src_arena, dst_arena, retain_profiles, retain_count, map, wholes, todo, status, dst_profile, leaves, leaf_count)
            if: \status != LMX_GRAPH_COPY_OK
                return: 1
            if: lmx_arena_ref_store(dx, s, copied) != 0
                \status: LMX_GRAPH_COPY_INVALID
                return: 1
            ---
        ---
        i: i + 1U
    ---
    return: 0

# Whether key is one of the copy's roots.
fn: lmx_copy_is_root (@@: Lmx sources; size_t: count; @: void key) int
    size_t: r 0U
    while: r < count
        if: (cast: (@: void) sources[r]) = key
            return: 1
        r: r + 1U
    ---
return: 0

# The copy that carries records for source Structure p in this run: p's copy when the run copied it and p is no root
# -- a root's own layout is the receiving operation's (lmx_merge_result_layout) -- or the run copies its roots in part
# as lexical contexts (part_roots); else 0.  A retained profile never enters the map.
fn: lmx_copy_carry_target (@: LmxCopyMap map; @@: Lmx sources; size_t: count; @: LmxArena src_arena; @: Lmx p; int: part_roots) @: Lmx
    if: p = 0 || lmx_range_classify(src_arena, (cast: (@: void) p)) != c.LMX_KIND_STRUCT
        return: 0
    if: part_roots = 0 && lmx_copy_is_root(sources, count, (cast: (@: void) p)) != 0
        return: 0
return: (cast: (@: Lmx) lmx_copy_map_get(map, (cast: (@: void) p)))

# The copy's correspondences (Codex -28 review point 3; K03-READ-FIELD-CLOSURE-20261008-31's review of the carry), one
# pass over the source table decided by the copy map:
# - a copied value carries each of its source's records: the requirement and the admitting frame are the run's copies
#   when it copied them -- a mapped ordinary requirement is the copy's own, never the unrelated original -- and stay
#   as they are when it did not (a retained or uncopied requirement, a static map, a layout token: module metadata);
#   with holes where only the used places were copied; a partial copy also has a record with itself with holes;
# - a copied requirement takes every record of the requirement it copies: a value admitted to the original is
#   admitted to its copy by the same correspondence -- the copy keeps its source's coordinates and its unread places
#   are its own holes -- so a candidate a caller binds into the copy's code, admitted before the copy, keeps its
#   record against the requirement that code reads (MERGE-PARENT-MODEL-SOURCE);
# - a record is written only when its value, requirement and admitting frame are live Structures of the destination
#   arena -- what lmx_arena_impl_prune keeps there: across arenas no record names a Structure of the source arena the
#   run did not copy (a retained profile the destination knows stays itself), and a freed address answers for nothing.
# A root carries and takes none unless it is a lexical context copied in part.  Two passes: the first counts and
# takes the room, the second writes, so every record is added or none; the caller drops them with the copy when it
# reverts.  0 or a status.
fn: lmx_copy_carry_records (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @: LmxArena dst_arena; @: LmxCopyMap map; @: LmxCopyMap wholes; int: used; int: part_roots) int
    LmxCopyMap: self_storage
    @: LmxCopyMap selfs (@ self_storage)
    LmxCopyMap: lay_storage
    @: LmxCopyMap lays (@ lay_storage)
    size_t: n 0U
    size_t: i 0U
    size_t: need 0U
    int: pass 0
    int: status LMX_GRAPH_COPY_OK
    @: LmxImplEntry e
    LmxImplEntry: v
    @: Lmx vd
    @: Lmx rd
    @: Lmx fd
    @: Lmx rq
    @: Lmx fr
    @: Lmx key
    @@: void keys
    @@: void vals
    if: src_arena = 0 || dst_arena = 0 || map = 0
        return: LMX_GRAPH_COPY_INVALID
    n: src_arena\impl_len
    memset((cast: (@: void) selfs), 0, c.sizeof(c.LmxCopyMap))
    memset((cast: (@: void) lays), 0, c.sizeof(c.LmxCopyMap))
    if: lmx_copy_map_init(selfs) != 0
        return: LMX_GRAPH_COPY_NOMEM
    if: lmx_copy_map_init(lays) != 0
        lmx_copy_map_dispose(selfs)
        return: LMX_GRAPH_COPY_NOMEM
    ---
    while: pass < 2 && status = LMX_GRAPH_COPY_OK
        i: 0U
        while: i < n && status = LMX_GRAPH_COPY_OK
            # The table moves when it grows: each record is read again by its index.
            e: src_arena\impl + i
            vd: lmx_copy_carry_target(map, sources, count, src_arena, e\value, part_roots)
            rd: lmx_copy_carry_target(map, sources, count, src_arena, e\req, part_roots)
            fd: 0
            if: e\frame != 0
                fd: (cast: (@: Lmx) lmx_copy_map_get(map, (cast: (@: void) e\frame)))
            rq: e\req
            if: rd != 0
                rq: rd
            fr: e\frame
            if: fd != 0
                fr: fd
            # A copied value's own layout evidence, for the record with itself a partial copy gets below.
            if: pass = 0 && vd != 0 && e\layout != 0 && lmx_copy_map_get(lays, (cast: (@: void) e\value)) = 0 && lmx_copy_map_put(lays, (cast: (@: void) e\value), e\layout) != 0
                status: LMX_GRAPH_COPY_NOMEM
            if: status = LMX_GRAPH_COPY_OK && vd != 0 && lmx_range_classify(dst_arena, (cast: (@: void) rq)) = c.LMX_KIND_STRUCT && (fr = 0 || lmx_range_classify(dst_arena, (cast: (@: void) fr)) = c.LMX_KIND_STRUCT)
                if: pass = 0
                    need: need + 1U
                    if: e\req = e\value && lmx_copy_map_put(selfs, (cast: (@: void) e\value), (cast: (@: void) vd)) != 0
                        status: LMX_GRAPH_COPY_NOMEM
                    ---
                else:
                    memcpy((cast: (@: void) (@ v)), (cast: (@: void) e), c.sizeof(c.LmxImplEntry))
                    v.value: vd
                    v.req: rq
                    v.frame: fr
                    if: used != 0 && lmx_copy_map_get(wholes, (cast: (@: void) e\value)) = 0
                        v.holes: 1
                    if: lmx_implements_append(dst_arena, @ v) != 0
                        status: LMX_GRAPH_COPY_NOMEM
                    ---
                ---
            ---
            if: status = LMX_GRAPH_COPY_OK && rd != 0 && lmx_range_classify(dst_arena, (cast: (@: void) e\value)) = c.LMX_KIND_STRUCT && (fr = 0 || lmx_range_classify(dst_arena, (cast: (@: void) fr)) = c.LMX_KIND_STRUCT)
                if: pass = 0
                    need: need + 1U
                else:
                    memcpy((cast: (@: void) (@ v)), (cast: (@: void) (src_arena\impl + i)), c.sizeof(c.LmxImplEntry))
                    v.req: rd
                    v.frame: fr
                    if: lmx_implements_append(dst_arena, @ v) != 0
                        status: LMX_GRAPH_COPY_NOMEM
                    ---
                ---
            ---
            i: i + 1U
        ---
        # A partial copy with no record with itself in its source gets one, with holes: a direct read of a place it
        # holds no object at is refused (lmx_walk_place).
        keys: lmx_copy_map_keys_data(map)
        vals: lmx_copy_map_vals_data(map)
        i: 0U
        while: status = LMX_GRAPH_COPY_OK && used != 0 && i < lmx_copy_map_keys_cap(map)
            key: (cast: (@: Lmx) keys[i])
            if: key != 0 && lmx_copy_carry_target(map, sources, count, src_arena, key, part_roots) != 0 && lmx_copy_map_get(wholes, (cast: (@: void) key)) = 0 && lmx_copy_map_get(selfs, (cast: (@: void) key)) = 0
                if: pass = 0
                    need: need + 1U
                else:
                    memset((cast: (@: void) (@ v)), 0, c.sizeof(c.LmxImplEntry))
                    v.value: (cast: (@: Lmx) vals[i])
                    v.req: v.value
                    v.layout: lmx_copy_map_get(lays, (cast: (@: void) key))
                    v.holes: 1
                    if: lmx_implements_append(dst_arena, @ v) != 0
                        status: LMX_GRAPH_COPY_NOMEM
                    ---
                ---
            ---
            i: i + 1U
        ---
        if: status = LMX_GRAPH_COPY_OK && pass = 0 && need = 0U
            pass: 2
        if: status = LMX_GRAPH_COPY_OK && pass = 0 && lmx_arena_impl_room(dst_arena, dst_arena\impl_len + need) != 0
            status: LMX_GRAPH_COPY_NOMEM
        pass: pass + 1
    ---
    lmx_copy_map_dispose(lays)
    lmx_copy_map_dispose(selfs)
return: status

fn: lmx_copy_run (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: Lmx absorb; int: used; int: part_roots; @@: Lmx use_anchor; @: size_t use_sel; @: size_t use_slot; @: size_t use_len; size_t: use_count; size_t: use_slots; @@: Lmx outs; @: LmxCopyMap pending; @: Lmx dst_profile; int: chain; @@: Lmx leaves; size_t: leaf_count) int
    LmxCopyMap: map_storage
    LmxCopyStack: todo_storage
    LmxCopyMap: wholes_storage
    LmxCopyStack: links_storage
    @: LmxCopyMap map (@ map_storage)
    @: LmxCopyStack todo (@ todo_storage)
    @: LmxCopyMap wholes 0
    @: LmxCopyStack links (@ links_storage)
    size_t: u 0U
    size_t: off 0U
    size_t: impl_mark 0U
    @: LmxArenaBlock mark 0
    @@: void keys
    @@: void vals
    @: Lmx src
    @: Lmx dst 0
    @: void key
    @: Lmx seed_profile dst_profile
    int: root_kind
    int: status LMX_GRAPH_COPY_OK
    size_t: i 0U
    size_t: r 0U
    if: sources = 0 || count = 0U || src_arena = 0 || dst_arena = 0 || outs = 0 || pending = 0
        return: LMX_GRAPH_COPY_INVALID
    # Clear the complete result span before validating any one root, so every early
    # refusal satisfies the all-null output contract.
    while: r < count
        outs[r]: 0
        r: r + 1U
    ---
    if: lmx_copy_profiles_valid(src_arena, retain_profiles, retain_count) = 0
        return: LMX_GRAPH_COPY_INVALID
    if: part_roots != 0 && used = 0
        return: LMX_GRAPH_COPY_INVALID
    if: use_count != 0U && (used = 0 || use_anchor = 0 || use_sel = 0 || use_slot = 0 || use_len = 0)
        return: LMX_GRAPH_COPY_INVALID
    if: use_count = 0U && use_slots != 0U
        return: LMX_GRAPH_COPY_INVALID
    # Each use names its anchor once: an explicit source Structure (selector 0) or the lexical parent of root
    # use_sel[u] - 1.  Its slot path is use_len[u] >= 1 slots; the lengths add up, never wrapping, to use_slots.
    while: u < use_count
        if: use_len[u] = 0U || use_len[u] > use_slots - off
            return: LMX_GRAPH_COPY_INVALID
        off: off + use_len[u]
        if: use_sel[u] = 0U
            if: use_anchor[u] = 0 || lmx_range_classify(src_arena, (cast: (@: void) use_anchor[u])) != c.LMX_KIND_STRUCT
                return: LMX_GRAPH_COPY_INVALID
            ---
        else:
            if: use_anchor[u] != 0 || use_sel[u] > count
                return: LMX_GRAPH_COPY_INVALID
            ---
        ---
        u: u + 1U
    ---
    if: off != use_slots
        return: LMX_GRAPH_COPY_INVALID
    u: 0U
    off: 0U
    r: 0U
    while: r < count
        if: sources[r] = 0
            return: LMX_GRAPH_COPY_INVALID
        root_kind: lmx_range_classify(src_arena, (cast: (@: void) sources[r]))
        # Roots are Structures.  Store-resident Structures are admitted below
        # by address; METHOD/CALLABLE/OP/ROLE/PRIMITIVE-record and every other representation are
        # values, not graph roots, and must never succeed with a null output.
        if: root_kind != c.LMX_KIND_STRUCT
            return: LMX_GRAPH_COPY_INVALID
        ---
        r: r + 1U
    ---
    # From here the destination is all-or-nothing: the mark is the arena's own
    # head, and every refusal below reverts to it.
    mark: lmx_arena_mark(dst_arena)
    impl_mark: dst_arena\impl_len
    memset((cast: (@: void) todo), 0, c.sizeof(c.LmxCopyStack))
    memset((cast: (@: void) links), 0, c.sizeof(c.LmxCopyStack))
    memset((cast: (@: void) map), 0, c.sizeof(c.LmxCopyMap))
    if: lmx_copy_map_init(map) != 0
        lmx_arena_revert(dst_arena, mark)
        return: LMX_GRAPH_COPY_NOMEM
    if: used != 0
        wholes: @ wholes_storage
        memset((cast: (@: void) wholes), 0, c.sizeof(c.LmxCopyMap))
        if: lmx_copy_map_init(wholes) != 0
            lmx_copy_map_dispose(map)
            lmx_arena_revert(dst_arena, mark)
            return: LMX_GRAPH_COPY_NOMEM
        ---
    ---
    # Seed the roots.  lmx_copy_process validates and queues each ordinary
    # structural parent before following it; exact retained-profile parents remain
    # terminals by physical address.  One map serves all roots.
    # A composition (`absorb` given) discards the copied roots: every link to one names `absorb` (lmx_copy_absorb) and
    # the result takes their children.  Such a root is allocated outside the destination profile (RR2c-2a,
    # steps/qualifier-receivers-20261010.md): a qualified branch holds exactly the published tree, so the full
    # preflight's coverage proof (lmx_qualify_profile_coverage) holds for a fresh qualified merge; its children's
    # array follows the root (lmx_copy_part, lmx_copy_process: the array is opened in the node's own profile).
    if: absorb != 0
        seed_profile: 0
    r: 0U
    while: r < count && status = LMX_GRAPH_COPY_OK
        src: sources[r]
        if: lmx_copy_retained_profiles(src_arena, (cast: (@: void) src), retain_profiles, retain_count) != 0
            if: lmx_copy_retained_profiles(dst_arena, (cast: (@: void) src), retain_profiles, retain_count) = 0
                status: LMX_GRAPH_COPY_INVALID
            ---
        else:
            if: lmx_copy_is_terminal_profiles(src_arena, (cast: (@: void) src), retain_profiles, retain_count) = 0
                # A lexical context copied for a callable merge's node is a part: only what a use or a link fills.
                if: part_roots != 0
                    lmx_copy_part(src, src_arena, dst_arena, map, links, @ status, dst_profile)
                else:
                    lmx_copy_ensure_struct(src, map, wholes, todo, dst_arena, @ status, seed_profile)
                ---
            ---
        ---
        r: r + 1U
    ---
    # The used copy's uses: each a slot path from its anchor (lmx_copy_use).
    while: status = LMX_GRAPH_COPY_OK && u < use_count
        if: use_sel[u] = 0U
            lmx_copy_use(use_anchor[u], use_slot + off, use_len[u], src_arena, dst_arena, retain_profiles, retain_count, map, wholes, todo, links, @ status, dst_profile, leaves, leaf_count)
        else:
            # The selected root's own lexical parent.  A root with none has no place above it in the source:
            # the use names nothing that exists, nothing is copied for it, and a reader that reaches for that
            # place finds it absent (Codex K03-READ-FIELD-CLOSURE-20261008-29).
            if: sources[use_sel[u] - 1U]\parent != 0
                lmx_copy_use(sources[use_sel[u] - 1U]\parent, use_slot + off, use_len[u], src_arena, dst_arena, retain_profiles, retain_count, map, wholes, todo, links, @ status, dst_profile, leaves, leaf_count)
            ---
        ---
        off: off + use_len[u]
        u: u + 1U
    ---
    # Copy edges until no Structure remains queued. Processing may queue more; in the
    # used copy a processed or partly needed Structure's parent is linked in part.
    while: status = LMX_GRAPH_COPY_OK && (lmx_copy_stack_items_len(todo) != 0U || lmx_copy_stack_items_len(links) != 0U)
        if: lmx_copy_stack_items_len(todo) != 0U
            src: lmx_copy_stack_pop(todo)
            lmx_copy_process(src, src_arena, dst_arena, retain_profiles, retain_count, map, wholes, todo, links, @ status, dst_profile, chain, leaves, leaf_count)
        else:
            src: lmx_copy_stack_pop(links)
            lmx_copy_link(src, src_arena, dst_arena, retain_profiles, retain_count, map, links, @ status, dst_profile, leaves, leaf_count)
        ---
    ---
# Parent fixup: every copied Structure points at the copy of its structural
    # parent, at an exact retained-profile parent's own address, at its source's own
    # parent when that parent was neither copied nor retained (an outside structural
    # link: the copy hangs where the source hangs -- book #graph, lexical parent and
    # memory ownership are independent; the qualified copy of a merge result that keeps
    # its lexical parent, RR2c-2b, is the case), or at zero.
    if: status = LMX_GRAPH_COPY_OK
        keys: lmx_copy_map_keys_data(map)
        vals: lmx_copy_map_vals_data(map)
        while: i < lmx_copy_map_keys_cap(map)
            key: keys[i]
            if: key != 0
                if: lmx_range_classify(src_arena, key) = c.LMX_KIND_STRUCT
                    src: (cast: (@: Lmx) key)
                    dst: (cast: (@: Lmx) vals[i])
                    dst\parent: 0
                    # k.4: native is a sibling Lmx member, not a graph field -- copied
                    # verbatim like every other non-traversed part of the header, never
                    # remapped (lmx.h.lm1, L2_spec_ru §2/§13).
                    dst\native: src\native
                    if: src\parent != 0
                        # A structural parent is a Structure. Anything else in
                        # parent is a defect of the source, not a terminal.
                        if: lmx_range_classify(src_arena, (cast: (@: void) src\parent)) != c.LMX_KIND_STRUCT
                            status: LMX_GRAPH_COPY_INVALID
                        else:
                            if: lmx_copy_retained_profiles(src_arena, (cast: (@: void) src\parent), retain_profiles, retain_count) != 0
                                if: lmx_copy_retained_profiles(dst_arena, (cast: (@: void) src\parent), retain_profiles, retain_count) = 0
                                    status: LMX_GRAPH_COPY_INVALID
                                else:
                                    dst\parent: src\parent
                                ---
                            else:
                                dst\parent: (cast: (@: Lmx) lmx_copy_map_get(map, (cast: (@: void) src\parent)))
                                if: dst\parent = 0
                                    dst\parent: src\parent
                                ---
                            ---
                        ---
                    ---
                ---
            ---
            i: i + 1U
        ---
    ---
    if: status = LMX_GRAPH_COPY_OK && absorb != 0
        status: lmx_copy_absorb(sources, count, src_arena, retain_profiles, retain_count, map, absorb)
    ---
    if: status = LMX_GRAPH_COPY_OK
        status: lmx_copy_names(src_arena, dst_arena, map, pending)
    ---
    # Correspondences: the copy's records, decided by the copy map (lmx_copy_carry_records).
    if: status = LMX_GRAPH_COPY_OK
        status: lmx_copy_carry_records(sources, count, src_arena, dst_arena, map, wholes, used, part_roots)
    ---
    if: status != LMX_GRAPH_COPY_OK
        lmx_copy_names_finish(pending, 0)
        # Nothing stays: the arena drops every block added since the mark and
        # retires each one's index entry with it, and the table drops the records the copy added. Sources are never
        # written.
        dst_arena\impl_len: impl_mark
        lmx_arena_revert(dst_arena, mark)
    ---
    if: status = LMX_GRAPH_COPY_OK
        r: 0U
        while: r < count
            if: lmx_copy_retained_profiles(src_arena, (cast: (@: void) sources[r]), retain_profiles, retain_count) != 0
                outs[r]: sources[r]
            else:
                outs[r]: (cast: (@: Lmx) lmx_copy_map_get(map, (cast: (@: void) sources[r])))
            ---
            r: r + 1U
        ---
    ---
    lmx_copy_stack_dispose(todo)
    lmx_copy_stack_dispose(links)
    lmx_copy_map_dispose(map)
    if: wholes != 0
        lmx_copy_map_dispose(wholes)
    return: status

fn: lmx_graph_copy_many_profiles_staged (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: Lmx absorb; @@: Lmx outs; @: LmxCopyMap pending) int
    return: lmx_copy_run(sources, count, src_arena, dst_arena, retain_profiles, retain_count, absorb, 0, 0, 0, 0, 0, 0, 0U, 0U, outs, pending, 0, 1, 0, 0U)

# A copy of `source` in part (READ-FIELD-CLOSURE; T7, Codex -29 step 4): the lexical context a callable merge's
# node hangs under -- only the places the node's copied code uses (use_* as lmx_graph_copy_many_used_staged, the
# anchors in source's tree) and the links that reach them, every other place absent; never a whole copy of it.
# Names are published with it; a refusal leaves nothing.  0 or a status.
fn: lmx_graph_copy_part_used_owned (@: Lmx source; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @@: Lmx use_anchor; @: size_t use_sel; @: size_t use_slot; @: size_t use_len; size_t: use_count; size_t: use_slots; @@: Lmx out) int
    LmxCopyMap: pending
    int: status
    memset((cast: (@: void) @ pending), 0, c.sizeof(c.LmxCopyMap))
    status: lmx_copy_run(@ source, 1U, src_arena, dst_arena, retain_profiles, retain_count, 0, 1, 1, use_anchor, use_sel, use_slot, use_len, use_count, use_slots, out, @ pending, 0, 1, 0, 0U)
    lmx_copy_names_finish(@ pending, (cast: (int) (status = LMX_GRAPH_COPY_OK)))
return: status

fn: lmx_graph_copy_many_used_staged (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: Lmx absorb; @@: Lmx use_anchor; @: size_t use_sel; @: size_t use_slot; @: size_t use_len; size_t: use_count; size_t: use_slots; @@: Lmx outs; @: LmxCopyMap pending) int
    return: lmx_copy_run(sources, count, src_arena, dst_arena, retain_profiles, retain_count, absorb, 1, 0, use_anchor, use_sel, use_slot, use_len, use_count, use_slots, outs, pending, 0, 1, 0, 0U)

# The same copy UNDER a profile (critical_qualifier_receivers_bug RR2a, steps/qualifier-receivers-20261010.md): every
# node, cell, children range, array descriptor and backing and list of the copy is a cell of the profile's own pools
# (lmx_arena_take_n_profiled), so the range index classifies the whole result by that profile -- the physical mark a
# value qualified at run time shares with the prologue's static branches.  dst_profile is a Structure of dst_arena, or
# 0 for the ordinary copy.  Nothing here seals or checks: the caller runs lmx_qualify_tree_preflight_full and
# lmx_arena_seal_profile before it publishes the result, as the prologue does for a static branch.
fn: lmx_graph_copy_many_used_profiled_staged (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: Lmx absorb; @@: Lmx use_anchor; @: size_t use_sel; @: size_t use_slot; @: size_t use_len; size_t: use_count; size_t: use_slots; @@: Lmx outs; @: LmxCopyMap pending; @: Lmx dst_profile) int
    return: lmx_copy_run(sources, count, src_arena, dst_arena, retain_profiles, retain_count, absorb, 1, 0, use_anchor, use_sel, use_slot, use_len, use_count, use_slots, outs, pending, dst_profile, 1, 0, 0U)

# One root's SUBTREE copied under a profile, names published; 0 or a status.  No lexical chain is copied (chain 0):
# the copy keeps the source's own parent as an outside structural link -- the value `immutable` without `independent`
# seals under its ordinary parent (RR2c-2b; LMX_blog/q/immutable-root-parent.md); a source freed of its parent gives a
# parentless copy.  The `leaves` are the method occurrences the subtree holds (book #qualification: methods are
# leaves): kept by address, not copied -- their cells stay unprofiled and writable, their lexical parents stay -- and
# the caller gives the preflight the same list.
fn: lmx_graph_copy_qualified_leaves_owned (@: Lmx source; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: Lmx dst_profile; @@: Lmx leaves; size_t: leaf_count; @@: Lmx out) int
    LmxCopyMap: pending
    @: Lmx one_source source
    @: Lmx one_out 0
    int: status
    if: out = 0 || (leaf_count != 0U && leaves = 0)
        return: LMX_GRAPH_COPY_INVALID
    \out: 0
    memset((cast: (@: void) @ pending), 0, c.sizeof(c.LmxCopyMap))
    status: lmx_copy_run(@ one_source, 1U, src_arena, dst_arena, retain_profiles, retain_count, 0, 0, 0, 0, 0, 0, 0, 0U, 0U, @ one_out, @ pending, dst_profile, 0, leaves, leaf_count)
    lmx_copy_names_finish(@ pending, (cast: (int) (status = LMX_GRAPH_COPY_OK)))
    if: status = LMX_GRAPH_COPY_OK
        \out: one_out
    ---
    return: status

# The subtree copy with no method leaves.
fn: lmx_graph_copy_qualified_owned (@: Lmx source; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: Lmx dst_profile; @@: Lmx out) int
return: lmx_graph_copy_qualified_leaves_owned(source, src_arena, dst_arena, retain_profiles, retain_count, dst_profile, 0, 0U, out)

fn: lmx_graph_copy_many_profiles_owned (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @@: Lmx outs) int
    LmxCopyMap: pending
    int: status
    memset((cast: (@: void) @ pending), 0, c.sizeof(c.LmxCopyMap))
    status: lmx_graph_copy_many_profiles_staged(sources, count, src_arena, dst_arena, retain_profiles, retain_count, 0, outs, @ pending)
    lmx_copy_names_finish(@ pending, (cast: (int) (status = LMX_GRAPH_COPY_OK)))
return: status

fn: lmx_graph_copy_many_owned (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx outs) int
return: lmx_graph_copy_many_profiles_owned(sources, count, src_arena, dst_arena, 0, 0U, outs)

fn: lmx_graph_copy_profiles_owned (@: Lmx source; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @@: Lmx out) int
    @: Lmx one_source source
    @: Lmx one_out 0
    int: status
    if: out = 0
        return: LMX_GRAPH_COPY_INVALID
    \out: 0
    status: lmx_graph_copy_many_profiles_owned(@ one_source, 1U, src_arena, dst_arena, retain_profiles, retain_count, @ one_out)
    if: status = LMX_GRAPH_COPY_OK
        \out: one_out
    ---
    return: status

fn: lmx_graph_copy_profiled_owned (@: Lmx source; @: LmxArena src_arena; @: LmxArena dst_arena; @: Lmx retain_profile; @@: Lmx out) int
    if: retain_profile = 0
        return: lmx_graph_copy_profiles_owned(source, src_arena, dst_arena, 0, 0U, out)
return: lmx_graph_copy_profiles_owned(source, src_arena, dst_arena, @ retain_profile, 1U, out)

fn: lmx_graph_copy_owned (@: Lmx source; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx out) int
return: lmx_graph_copy_profiles_owned(source, src_arena, dst_arena, 0, 0U, out)
