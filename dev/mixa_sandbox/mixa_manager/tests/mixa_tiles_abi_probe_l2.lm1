# ABI parity guard — L1 port of mixa_tiles_abi_probe_l2.c (ticket 20260918-082421).
# offsetof is a C macro with no L1 spelling (c. pastes a call, not a preprocessor
# name). Field offsets are computed at run time via pointer arithmetic on a local
# store (same pattern as l2src/lmx_message_selftest.lm1). Output format strings
# are kept byte-identical to the C probe so L2-vs-real parity still diffs stdout.
predef: "mixa_manager/mixa_tiles_l2.h.lm1"
include: "<stdio.h>"

fn: main () int
    MixaCell: store0
    @: MixaCell p0
    p0: @ store0
    MixaTextRect: store1
    @: MixaTextRect p1
    p1: @ store1

    c.printf("MixaCell sizeof=%zu\n", c.sizeof(c.MixaCell))
    c.printf("MixaCell codepoint=%zu\n", (cast: (size_t) @ p0\codepoint) - (cast: (size_t) p0))
    c.printf("MixaCell fg=%zu\n", (cast: (size_t) @ p0\fg) - (cast: (size_t) p0))
    c.printf("MixaCell bg=%zu\n", (cast: (size_t) @ p0\bg) - (cast: (size_t) p0))
    c.printf("MixaCell flags=%zu\n", (cast: (size_t) @ p0\flags) - (cast: (size_t) p0))
    c.printf("MixaCell width=%zu\n", (cast: (size_t) @ p0\width) - (cast: (size_t) p0))
    c.printf("MixaCell alpha=%zu\n", (cast: (size_t) @ p0\alpha) - (cast: (size_t) p0))
    c.printf("MixaTextRect sizeof=%zu\n", c.sizeof(c.MixaTextRect))
    c.printf("MixaTextRect rows=%zu\n", (cast: (size_t) @ p1\rows) - (cast: (size_t) p1))
    c.printf("MixaTextRect cols=%zu\n", (cast: (size_t) @ p1\cols) - (cast: (size_t) p1))
    c.printf("MixaTextRect cells=%zu\n", (cast: (size_t) @ p1\cells) - (cast: (size_t) p1))
    return: 0

