# D-105 native (steps/d105-native.md §4; the author's Q39: "сначала в интерпретаторе и потом нативно"): a write
# through the admitted formal lands on the field of that name: `wr` writes m\a: 99, and `go` reads o\a =
# 99 and o\b = 20 still.  Before: the write went to Other's b.  Success is 7.
Model:
    size_t: a 1U
    size_t: b 2U
end: Model
Other:
    size_t: b 20U
    size_t: a 10U
end: Other
fn: wr (Model: m; size_t: v) size_t
    m\a: v
    return: 0U
fn: go () size_t
    o: merge Other
    size_t: z 0U
    z: wr(o 99U)
    if: o\b != 20U
        return: 3U
    return: o\a
size_t: got 0U
got: go()
int: ok 3
if: got = 99U
    ok: 7
if: got = 10U
    ok: 5
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
