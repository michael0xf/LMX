ProjectionMessage:
    int: total 0
    int: last 0
    int: seq
    int: delta
    return: int
    apply:
        throws: Gap
        if: seq <= node\last
            return: query()
        if: seq != node\last + 1
            throw: Gap()
        node\total += delta
        node\last := seq
        return: query()
    query:
        return: node\total

