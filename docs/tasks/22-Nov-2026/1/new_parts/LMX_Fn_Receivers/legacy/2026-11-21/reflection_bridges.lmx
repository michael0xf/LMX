# СЕМАНТИЧЕСКАЯ СИГНАТУРА.
# FxKernel\signature — публикуемый ТЗ интерфейс уже общего анализа типов.
# Его результат — метаданные; RxSignature\signature превращает их именно
# в обычное fn-описание. Физический types(parent(F)) этого не заменяет.
RxSignature:
    private: @: operation
    return: @
    signature:
        throws:
            FxIndex
            FxTypeToken
            FxKernelFailure
        private: @: info FxKernel\signature(subject := operation)
        return: FxSignatures\make(inputs := info\inputTypes; result := info\resultType)

# names и rename остаются явно незавершёнными до подключения существующей
# таблицы record -> canonical name. Они не удалены из каталога 50 ресиверов.
# Нельзя заменить names вызовом sys\name(ptr): тот получает написанное ptr.
# Нельзя заменить rename строковой подстановкой в sys\toLmx(source).
# Необходимые контракты подробно заданы в KERNEL_REQUIREMENTS.md, раздел 4.
# % исключает заготовку целиком: пустое тело не выдаётся за реализацию.
%RxNames:
    @: source
    return: []: []: char
    names:
        # Для безымянного поля также нужен mask, отличный от пустого exact name.

%RxRename:
    @: source
    @: replacements
    return: @
    rename:
        # Одна общая copy; выбранные записи меняются через штатное interning.

