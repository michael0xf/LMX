                return: (cast: (int) (1))
            ---
        if: lm_compiler_rw_path_value_full(path, prepared, 0, level - 1, raw, @ base) != 0 || c.lm_compiler_rw_put(raw, 1, base) != 0
            return: (cast: (int) (1))
