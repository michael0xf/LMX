# Original: l2src/l2trans.lm1:35977
fn: lm_compiler_d105_catalog_cell (const: (@: plan c.L2D105Plan); int: index; @: out int) int
    @: d105t_n_cell int (cast: (@: int) (@ c.l2_d105t_n))
    const: (@: step c.L2D105Step)
    int: logical
    if: out = 0
        return: (cast: (int) (1))
    \out: -1
    if: plan = 0 || plan\ready = 0 || plan\width < 0 || plan\width > c.INT_MAX / 2 || plan\physical_width < plan\width || plan\physical_width > c.INT_MAX / 2 || index < 0 || index >= plan\physical_width * 2
        return: (cast: (int) (1))
    const: (@: port_steps c.L2D105StepDynamicArray (cast: (const: @: c.L2D105StepDynamicArray) (@ plan\steps)))
    if: port_steps\size != (cast: (size_t) (plan\width * 2))
        return: (cast: (int) (1))
    logical: index
    if: index >= plan\physical_width
        logical: index - plan\physical_width + plan\width
    if: (index < plan\physical_width && index >= plan\width) || (index >= plan\physical_width && index - plan\physical_width >= plan\width)
        return: (cast: (int) (0))
    step: port_steps\data + logical
    if: step\status = 0
        \out: step\slot
    if: step\status = 3 && step\child_pair >= 0
        if: step\child_pair >= d105t_n_cell[0]
            return: (cast: (int) (1))
        \out: step\physical
    return: (cast: (int) (0))
end: lm_compiler_d105_catalog_cell

