# Ordinary L2 state, type and declaration helpers of the L1-to-C translator.
# Aliases address inherited C cells; no state is captured at method entry.
predef: "l1src/p0.h.lm1"
predef: "l1src/l1_backend_scratch.h.lm1"
predef: "l2src/l1_backend_text.h.lm1"
include: "<stddef.h>" "<stdio.h>" "<string.h>" "<stdlib.h>" "<limits.h>"

# Original: l1src/l1trans.lm1:223
fn: l1_is_type_name (const: (@: text c.LmP0Text)) int
    if: c.l1_text_eq(text, "int")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "void")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "char")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "size_t")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "unsigned")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "long")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "short")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "const")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "FILE")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "uchar")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "float")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "double")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "ulong")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "u8")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "u16")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "u32")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "u64")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "i8")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "i16")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "i32")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "i64")
        return: (cast: (int) (1))
    # The stdint family, as the C this project carries actually spells it:
    # uintptr_t in the LMX records, uint_fast8_t for the Message control flags
    # (spec 19.29.7.1), and the fixed-width names beside them.  Added for the
    # conversion of the carried C sources into L1 (Mikhail, 2026-09-16).
    if: c.l1_text_eq(text, "uintptr_t") || c.l1_text_eq(text, "intptr_t")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "uint_fast8_t") || c.l1_text_eq(text, "uint8_t") || c.l1_text_eq(text, "uint16_t")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "uint32_t") || c.l1_text_eq(text, "uint64_t")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "int8_t") || c.l1_text_eq(text, "int16_t") || c.l1_text_eq(text, "int32_t") || c.l1_text_eq(text, "int64_t")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "LmP0NodeKind") || c.l1_text_eq(text, "LmP0TrailerRole") || c.l1_text_eq(text, "LmP0DashFenceStatus")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "LmP0FieldParseFlags") || c.l1_text_eq(text, "LmP0FieldParseLoopContinuation")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "LmP0FrameFlags") || c.l1_text_eq(text, "LmP0NodeFlags") || c.l1_text_eq(text, "LmP0TrailerFlags") || c.l1_text_eq(text, "LmP0StreamEventKind")
        return: (cast: (int) (1))
    if: c.l1_text_eq(text, "LmOwnDestroyFields") || c.l1_text_eq(text, "LmOwnDelete")
        return: (cast: (int) (1))
    if: l1_hdr_type_has(text) != 0
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: l1_is_type_name

# Original: l1src/l1trans.lm1:291
fn: l1_head_is_unknown_type (const: (@: head c.LmP0Text)) int
    size_t: start 0U
    unsigned: ch 0U
    if: head = 0 || head\data = 0 || head\length = 0U
        return: (cast: (int) (0))
    if: c.l1_text_starts(head, "c.") && head\length > 2U
        start: 2U
    ---
    ch: (cast: (unsigned) head\data[start])
    if: ch < 65U || ch > 90U
        return: (cast: (int) (0))
    if: start = 0U && l1_is_type_name(head)
        return: (cast: (int) (0))
    return: (cast: (int) (1))
end: l1_head_is_unknown_type

