# L3 declaration writer; all executable algorithm bodies are ordinary L2.
fn: decl_driver_carrier (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx_root.lm1\"\npredef: \"l2src/lmx_implements.lm1\"\npredef: \"l2src/lmx_chars_owned.lm1\"\npredef: \"l2src/lmx_array_owned.lm1\"\npredef: \"l2src/lmx_array_ref_owned.lm1\"\npredef: \"l2src/lmx_graph_copy_owned.lm1\"\npredef: \"l2src/lmx_source_names.lm1\"\npredef: \"l2src/lmx_merge_owned.lm1\"\npredef: \"l2src/lmx_walk.lm1\"\npredef: \"l2src/lmx_primitive.h.lm1\"\npredef: \"l1src/libc_abi.lm1\"\ninclude: \"<stdio.h>\" \"<stdlib.h>\" \"<string.h>\"\n\n# Inherited test-process observation state; not clean-kernel ambient-state closure.\nint: gargc 0\n@@: char gargv 0\nint: pargc 0\n@@: char pargv 0\nint: launches 0\nint: builds 0\nint: build_rc -1\nint: host_state -1\nint: program_passed 0\nint: walk_thrown -1\nint: r0_stopped -1\nint: checks 0\nint: failures 0\nint: graph_mutation_requested 0\nint: pointer_abi_mutation_requested 0\nint: graph_mutation_baseline_ok 0\nint: graph_mutation_setup_ok 0\nint: graph_mutation_setup_failures 0\nint: graph_mutation_shape_failures 0\nint: graph_mutation_compared 0\nint: post_paths_requested 0\nint: post_paths_seen 0\nint: profile_complete_requested 0\nint: profile_complete_seen 0\n@: LmxArena post_paths_arena 0\n@: Lmx post_paths_graph 0\nint: post_log_requested 0\nint: post_log_n 0\nconst: @: char phase \"\"\nint: merge_calls 0\nint: merge_fail_at 0\nint: merge_facts_expected 0\nint: merge_facts_seen 0\nint: l2_ref_active 0\n@: LmxArena l2_ref_peer_arena 0\n@: LmxMsg l2_ref_peer 0\n@: LmxPost l2_ref_peer_mail 0\n@: void l2_ref_parent_addr 0\nint: l2_ref_reply_to_sender 0\nint: l2_ref_reply_to_parent 0\n@: LmxArena dispatch_arena 0\n@: Lmx dispatch_selected 0\nint: dispatch_calls 0\nsize_t: dispatch_second_cells 0U\nint: dispatch_throws 0\n@: Lmx dispatch_payload 0\n@: Lmx stop_caller 0\n@: Lmx stop_later 0\n@: Lmx stop_receiver 0\n@: void stop_published 0\n@: void stop_received 0\n[]: @(Lmx) stop_extra 4\n[]: LmxPrimitiveEntry stop_saved 2\nint: stop_calls 0\nint: stop_late_calls 0\nint: stop_receiver_calls 0\nint: stop_root_returns 0\nint: stop_walk_caller 0\n\nprototype:\n    fn: l2_generated_main (int: argc; @@: char argv) int\n    fn: l2_program_build (@: LmxArena arena; @: Lmx graph; @: Lmx settings) int\n    fn: l2_program_graph () @: Lmx\n    fn: l2_program_qualified_count () size_t\n    fn: l2_program_qualified_at (size_t: index) @: Lmx\nend: prototype\n\n# import is sequential; predef would hoist bodies before the two array definitions.\nimport: \"l2src/l2_driver.lm1\"\n", f) < 0
        return: 1
    return: 0
end: decl_driver_carrier

# L3 declaration writer; all executable algorithm bodies are ordinary L2.
fn: decl_driver_state (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx_root.h.lm1\"\npredef: \"l2src/lmx_walk.h.lm1\"\npredef: \"l2src/lmx_primitive.h.lm1\"\npredef: \"l1src/libc_abi.lm1\"\n# Forward declarations refer to the same carrier objects, not new storage.\n# The two arrays are defined by the carrier before its sequential body import.\nextern: int: gargc\nextern: @@: char gargv\nextern: int: pargc\nextern: @@: char pargv\nextern: int: launches\nextern: int: builds\nextern: int: build_rc\nextern: int: host_state\nextern: int: program_passed\nextern: int: walk_thrown\nextern: int: r0_stopped\nextern: int: checks\nextern: int: failures\nextern: int: graph_mutation_requested\nextern: int: pointer_abi_mutation_requested\nextern: int: graph_mutation_baseline_ok\nextern: int: graph_mutation_setup_ok\nextern: int: graph_mutation_setup_failures\nextern: int: graph_mutation_shape_failures\nextern: int: graph_mutation_compared\nextern: int: post_paths_requested\nextern: int: post_paths_seen\nextern: int: profile_complete_requested\nextern: int: profile_complete_seen\nextern: @: LmxArena post_paths_arena\nextern: @: Lmx post_paths_graph\nextern: int: post_log_requested\nextern: int: post_log_n\nextern: const: @: char phase\nextern: int: merge_calls\nextern: int: merge_fail_at\nextern: int: merge_facts_expected\nextern: int: merge_facts_seen\nextern: int: l2_ref_active\nextern: @: LmxArena l2_ref_peer_arena\nextern: @: LmxMsg l2_ref_peer\nextern: @: LmxPost l2_ref_peer_mail\nextern: @: void l2_ref_parent_addr\nextern: int: l2_ref_reply_to_sender\nextern: int: l2_ref_reply_to_parent\nextern: @: LmxArena dispatch_arena\nextern: @: Lmx dispatch_selected\nextern: int: dispatch_calls\nextern: size_t: dispatch_second_cells\nextern: int: dispatch_throws\nextern: @: Lmx dispatch_payload\nextern: @: Lmx stop_caller\nextern: @: Lmx stop_later\nextern: @: Lmx stop_receiver\nextern: @: void stop_published\nextern: @: void stop_received\nextern: int: stop_calls\nextern: int: stop_late_calls\nextern: int: stop_receiver_calls\nextern: int: stop_root_returns\nextern: int: stop_walk_caller\n\nprototype:\n    fn: l2_generated_main (int: argc; @@: char argv) int\n    fn: l2_program_build (@: LmxArena arena; @: Lmx graph; @: Lmx settings) int\n    fn: l2_program_graph () @: Lmx\n    fn: l2_program_qualified_count () size_t\n    fn: l2_program_qualified_at (size_t: index) @: Lmx\n    fn: main (int: argc; @@: char argv) int\n    fn: dispatch_probe (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n    fn: stop_first (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n    fn: stop_later_probe (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n    fn: stop_receiver_probe (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n    fn: stop_root_probe (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n", f) < 0
        return: 1
    if: c.fputs("    fn: l2_driver_program (@: LmxArena arena; @: Lmx graph; @: Lmx settings) int\n    fn: l2_driver_before_turn (@: LmxRoot root; @: LmxMsg r0) int\n    fn: l2_driver_service_post (@: LmxService service; @: void address; @: LmxMsg letter; @: LmxArena letter_arena) int\n    fn: l2_driver_root_launch (@: LmxRoot root; int: argc; @@: char argv; LmxRootProgram: program; size_t: fields; LmxRootSettings: settings; ulong: limit; @: void out; @: void err) int\n    fn: l2_driver_merge_owned (@@: Lmx operands; size_t: count; @: Lmx body; @: LmxArena src_arena; @: LmxArena dst_arena; @@: LmxMergePair overrides; size_t: override_count; @@: Lmx out) int\n    fn: l2_driver_merge_profiles_owned (@@: Lmx operands; size_t: count; @: Lmx body; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @@: LmxMergePair overrides; size_t: override_count; @@: Lmx out) int\n    fn: l2_driver_merge_used_owned (@@: Lmx operands; size_t: count; @: Lmx body; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @@: Lmx use_anchor; @: size_t use_sel; @: size_t use_slot; @: size_t use_len; size_t: use_count; size_t: use_slots; @@: LmxMergePair overrides; size_t: override_count; @@: Lmx out) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_driver_state

# Complete launch driver's ordinary L2 ABI and L3-generated declaration carrier.
fn: bld_driver_l2 (@: rec c.FILE; @: stage char; @: base char; @: fe char; @: out char; @: res int) int
    @@: names char c.calloc(13U, sizeof(@: char))
    @: src char txt_path(stage, "src")
    @: state char txt_path(src, "l2src/l2_driver_state_decl.lm1")
    @: carrier char txt_path(src, "l2_eternal_driver.lm1")
    @: f c.FILE 0
    int: status 0
    if: names = 0 || src = 0 || state = 0 || carrier = 0
        return: 1
    os_file_remove(state)
    os_file_remove(carrier)
    os_file_remove(txt_path(src, "l2src/l2_driver.lm1"))
    os_file_remove(txt_path(src, "l2src/l2_driver.h.lm1"))
    os_file_remove(txt_path(stage, "headers/l2src/l2_driver.lm1.h"))
    os_file_remove(txt_path(src, "l2src/l2_driver_shape.lm1"))
    os_file_remove(txt_path(src, "l2src/l2_driver_shape.h.lm1"))
    os_file_remove(txt_path(stage, "headers/l2src/l2_driver_shape.lm1.h"))
    f: os_file_open(state, "wb")
    if: f = 0
        return: 1
    status: decl_driver_state(f)
    if: c.fclose(f) != 0
        status: 1
    if: status != 0
        os_file_remove(state)
        return: 1
    bld_hash_note(rec, state)
    f: os_file_open(carrier, "wb")
    if: f = 0
        return: 1
    status: decl_driver_carrier(f)
    if: c.fclose(f) != 0
        status: 1
    if: status != 0
        os_file_remove(carrier)
        return: 1
    bld_hash_note(rec, carrier)
    names[0]: "main"
    names[1]: "dispatch_probe"
    names[2]: "stop_first"
    names[3]: "stop_later_probe"
    names[4]: "stop_receiver_probe"
    names[5]: "stop_root_probe"
    names[6]: "driver_program"
    names[7]: "driver_before_turn"
    names[8]: "driver_service_post"
    names[9]: "driver_root_launch"
    names[10]: "driver_merge_owned"
    names[11]: "driver_merge_profiles_owned"
    names[12]: "driver_merge_used_owned"
    return: bld_machine_module(rec, fe, src, base, out, res, "l2_driver", names, 13, 1)
end: bld_driver_l2

# The runtime objects of the stage built as stage/label: the kernel's L2 modules translated by the frontend fe
# (bld_kernel_l2), the C headers regenerated from the L1 sources then (bld_headers, label/headers), and the driver
# translated by l1trans, compiled strict -O2 as the production runtime driver.o and with -DLMX_OBSERVE_WALK as the
# observed one driver-observe.o.
fn: bld_runtime (@: repo char; @: stage char; @: base char; @: fe char; @: label char) int
    @@: a char c.calloc(40U, sizeof(@: char))
    @: res int c.calloc(2U, c.sizeof(c.int))
    @: out char txt_path(stage, label)
    @: src char txt_path(stage, "src")
    @: rec c.FILE 0
    @: cfile char 0
    @: backend char bld_bundle_backend(fe)
    int: k 0
    int: n 0
    if: a = 0 || res = 0 || out = 0 || src = 0 || backend = 0
        return: 1
    if: file_exists(backend) = 0
        c.printf("BACKEND companion missing for frontend %s\n", fe)
        return: 1
    if: file_exists(txt_path(out, "record.txt")) != 0
        c.printf("RUNTIME %s exists: a new label for every attempt\n", out)
        return: 1
    dir_make(out)
    rec: os_file_open(txt_path(out, "record.txt"), "wb")
    if: bld_kernel_l2(rec, repo, stage, base, fe, out, res) != 0
        return: 5
    if: bld_driver_l2(rec, stage, base, fe, out, res) != 0
        return: 5
    if: bld_headers(backend, stage, txt_path(out, "headers")) != 0
        return: 6
    cfile: txt_path(out, "driver.c")
    a[0]: backend
    a[1]: txt_path(src, "l2_eternal_driver.lm1")
    a[2]: cfile
    if: bld_step(rec, a, 3, src, txt_path(out, "DRIVER.log"), res) != 0
        return: 2
    while: k < 2
        a[0]: "C:/Qt/Tools/mingw1310_64/bin/gcc.exe"
        n: bld_cflags(a, 1, repo, stage, base, "-O2 -fstrict-aliasing", 0, 0, k)
        if: n < 0
            return: 3
        a[n]: "-c"
        a[n + 1]: cfile
        a[n + 2]: "-o"
        a[n + 3]: txt_path(out, "driver.o")
        if: k = 1
            a[n + 3]: txt_path(out, "driver-observe.o")
        if: k = 0 && bld_step(rec, a, n + 4, src, txt_path(out, "driver.COMPILE.log"), res) != 0
            return: 3
        if: k = 1 && bld_step(rec, a, n + 4, src, txt_path(out, "driver-observe.COMPILE.log"), res) != 0
            return: 4
        k: k + 1
    ---
    bld_hash_note(rec, cfile)
    bld_hash_note(rec, txt_path(out, "driver.o"))
    bld_hash_note(rec, txt_path(out, "driver-observe.o"))
    c.fclose(rec)
    return: 0
end: bld_runtime

# This tool built by the frontend fe from the stage's tools sources as stage/label/lmxtool.exe, linked with the
# runtime object rt (the parts: text, winargs, sha256, replay, build, suite).
# Its grown source gets one hour for L2 translation, not the ordinary fifteen minutes.
fn: bld_self (@: repo char; @: stage char; @: base char; @: fe char; @: rt char; @: label char) int
    @@: tags char c.calloc(1U, sizeof(@: char))
    @@: objs char c.calloc(1U, sizeof(@: char))
    @@: a char c.calloc(41U, sizeof(@: char))
    @: res int c.calloc(2U, c.sizeof(c.int))
    @@: lp char c.calloc(1U, sizeof(@: char))
    @: out char txt_path(stage, label)
    @: tools char txt_path(stage, "tools")
    @: src char txt_path(stage, "src")
    @: backend char bld_bundle_backend(fe)
    @: methods char txt_path(src, "l2src/lmxtool_methods.lm1")
    @: header char txt_path(src, "l2src/lmxtool_methods.h.lm1")
    @: c_header char txt_path(stage, "headers/l2src/lmxtool_methods.lm1.h")
    @: rec c.FILE 0
    int: x 1
    if: tags = 0 || objs = 0 || a = 0 || res = 0 || lp = 0 || out = 0 || tools = 0 || src = 0 || backend = 0 || methods = 0 || header = 0 || c_header = 0
        return: 1
    if: file_exists(txt_path(out, "record.txt")) != 0
        c.printf("SELF %s exists: a new label for every attempt\n", out)
        return: 1
    if: dir_make(out) != 0 || dir_make(txt_path(stage, "headers/l2src")) != 0
        return: 1
    rec: os_file_open(txt_path(out, "record.txt"), "wb")
    if: rec = 0
        return: 1
    tags[0]: "tool"
    objs[0]: rt
    a[0]: fe
    a[1]: "--library"
    a[2]: "--machine"
    a[3]: "tool_main"
    a[4]: "--header"
    a[5]: header
    a[6]: txt_path(tools, "lmxtool_methods.lm2")
    a[7]: txt_path(tools, "text.lm2")
    a[8]: txt_path(tools, "winargs.lm2")
    a[9]: txt_path(tools, "sha256.lm2")
    a[10]: txt_path(tools, "replay.lm2")
    a[11]: txt_path(tools, "build.lm2")
    a[12]: txt_path(tools, "suite.lm2")
    a[13]: txt_path(tools, "os_native_path.lm2")
    a[14]: txt_path(tools, "os_file_open.lm2")
    a[15]: txt_path(tools, "os_filesystem.lm2")
    a[16]: txt_path(tools, "os_paths.lm2")
    a[17]: txt_path(tools, "os_windows_paths.lm2")
    a[18]: txt_path(tools, "unicode_lower.lm2")
    a[19]: txt_path(tools, "docs_json.lm2")
    a[20]: txt_path(tools, "docs_grammar.lm2")
    a[21]: txt_path(tools, "docs_matcher.lm2")
    a[22]: txt_path(tools, "docs_text.lm2")
    a[23]: txt_path(tools, "docs_semantics.lm2")
    a[24]: txt_path(tools, "docs_pairs.lm2")
    a[25]: txt_path(tools, "docs_unicode.lm2")
    a[26]: txt_path(tools, "docs_body.lm2")
    a[27]: txt_path(tools, "docs_render.lm2")
    a[28]: txt_path(tools, "docs_inventory.lm2")
    a[29]: txt_path(tools, "docs_equal.lm2")
    a[30]: txt_path(tools, "docs_control.lm2")
    a[31]: txt_path(tools, "docs_check_grammar.lm2")
    a[32]: txt_path(tools, "docs_check_opening.lm2")
    a[33]: txt_path(tools, "docs_check_fences.lm2")
    a[34]: txt_path(tools, "docs_check_eol.lm2")
    a[35]: txt_path(tools, "docs_check_parser.lm2")
    a[36]: txt_path(tools, "docs_check_links.lm2")
    a[37]: txt_path(tools, "docs_check.lm2")
    a[38]: txt_path(src, "l2src/convert.lm2")
    a[39]: txt_path(src, "l2src/primitive.lm2")
    a[40]: methods
    x: bld_step_t(rec, a, 41, src, txt_path(out, "lmxtool-methods.L2.log"), res, 3600000U)
    if: x = 0
        bld_hash_note(rec, methods)
        bld_hash_note(rec, header)
        a[0]: backend
        a[1]: header
        a[2]: c_header
        x: bld_step(rec, a, 3, src, txt_path(out, "lmxtool-methods-header.L1.log"), res)
        if: x = 0
            bld_hash_note(rec, c_header)
        ---
    ---
    if: x = 0
        x: bld_program_k(repo, stage, base, fe, 0, "-O0", txt_path(tools, "lmxtool.lm2"), 0, out, "lmxtool", tags, objs, 1, "-lshell32,-lbcrypt", rec, res, lp, 3600000U)
    ---
    c.free(a)
    c.free(res)
    c.free(lp)
    if: x = 0
        bld_hash_note(rec, txt_path(out, "lmxtool.lm1"))
        bld_hash_note(rec, txt_path(out, "lmxtool.c"))
        bld_hash_note(rec, txt_path(out, "lmxtool-tool.exe"))
    ---
    c.fclose(rec)
    return: x
end: bld_self

# Source-only L3 declaration writers for the next P0 bootstrap port.
# Append to the existing recipe only after explicit previous-FE routing is wired.
# These strings contain ABI declarations only, never maintained algorithm bodies.
fn: decl_p0 (@: f c.FILE) int
    # These activation-local C records express the original parser's raw
    # scratch arrays and file length. L3 writes declarations, not a second
    # parser or an algorithm hidden in generated source strings.
    if: c.fputs("include: \"<stddef.h>\"\n\ndefine: LM_UNUSED(x) ((void)(x))\nend: define\ndefine: LM_P0_NODE_STRUCTURE 1\ndefine: LM_P0_NODE_FRAME 2\ndefine: LM_P0_NODE_ATOM 3\ndefine: LM_P0_NODE_DISABLED 4\ndefine: LM_P0_FRAME_COLON 1U\ndefine: LM_P0_FRAME_COMPACT 2U\ndefine: LM_P0_FRAME_INLINE_BODY 4U\ndefine: LM_P0_FRAME_SEPARATOR_CLOSED 8U\ndefine: LM_P0_FRAME_DELIMITER_CLOSED 16U\ndefine: LM_P0_NODE_INACTIVE 1U\ndefine: LM_P0_NODE_MIX 2U\ndefine: LM_P0_NODE_POSITIONAL_SKIP 4U\ndefine: LM_P0_TRAILER_TAIL_CUTTER 1U\ndefine: LM_P0_TRAILER_COLON 2U\ndefine: LM_P0_TRAILER_DELIMITER_CLOSED 4U\ndefine: LM_P0_STREAM_EVENT_ITEM 1\ndefine: LM_P0_STREAM_EVENT_DELIM 2\ndefine: LM_P0_STREAM_EVENT_BLOCK_STRING 3\ndefine: LM_P0_STREAM_EVENT_DISABLED_BLOCK 4\ndefine: LM_P0_STREAM_EVENT_MIX 5\ndefine: LM_P0_TRAILER_ROLE_NONE 0\ndefine: LM_P0_TRAILER_ROLE_DASH_CUTTER 1\ndefine: LM_P0_TRAILER_ROLE_END 2\ndefine: LM_P0_TRAILER_ROLE_RETURN 3\ndefine: LM_P0_TRAILER_ROLE_UNTIL 4\ndefine: LM_P0_DASH_FENCE_NONE 0\ndefine: LM_P0_DASH_FENCE_VALID 1\ndefine: LM_P0_DASH_FENCE_TOO_LONG 2\ndefine: LM_P0_DASH_FENCE_TRAILING_TEXT 3\ndefine: LM_P0_FIELD_PARSE_STOP_ON_SEMICOLON 1U\ndefine: LM_P0_FIELD_PARSE_STOP_ON_SOURCE_LEVEL 2U\ndefine: LM_P0_FIELD_PARSE_REQUIRE_BOUNDED_SOURCE_LEVEL 4U\ndefine: LM_P0_FIELD_PARSE_ALLOW_EMPTY_FIELDS 8U\ndefine: LM_P0_FIELD_PARSE_ALLOW_HEADLESS_AFTER_SEPARATOR 16U\ndefine: LM_P0_MAX_FENCE_LENGTH 80U\ndefine: LM_P0_LAYOUT_DELIMITER_STACK_LIMIT 256U\ndefine: LM_P0_FIELD_PARSE_LOOP_HEADLESS_GROUP 0\ndefine: LM_P0_FIELD_PARSE_LOOP_COLON_FRAME_BODY 1\ndefine: LM_P0_FIELD_PARSE_LOOP_BOUNDED_STRUCTURE 2\ndefine: LM_P0_FIELD_PARSE_LOOP_COMPACT_FRAME_BODY 3\ndefine: LM_P0_POSTPROCESS_NODE 1\ndefine: LM_P0_POSTPROCESS_STRUCTURE 2\ndefine: LM_P0_POSTPROCESS_TRAILER 3\ndefine: LM_P0_POSTPROCESS_FRAME_WRAP 4\ndefine: LM_P0_DUMP_NODE 1\ndefine: LM_P0_DUMP_STRUCTURE 2\ndefine: LM_P0_DUMP_TRAILER 3\n\ntype: uchar unsigned char\ntype: LmP0NodeKind int\ntype: LmP0FrameFlags unsigned\ntype: LmP0NodeFlags unsigned\ntype: LmP0TrailerFlags unsigned\ntype: LmP0StreamEventKind int\ntype: LmP0TrailerRole int\ntype: LmP0DashFenceStatus int\ntype: LmP0FieldParseFlags unsigned\ntype: LmP0FieldParseLoopContinuation int\n\n", f) < 0
        return: 1
    if: c.fputs("fnptr: LmOwnDestroyFields (@: void object) void\nfnptr: LmOwnDelete (@: void object) void\n\nstruct: LmOwnPtrStack\n    @@: void items\n    size_t: count\n    size_t: capacity\n    LmOwnDelete: delete_item\nend: LmOwnPtrStack\n\nstruct: LmOwnArena\n    @: LmOwnPtrStack allocations\n    int: frozen\nend: LmOwnArena\n\nstruct: LmP0Text\n    const: @: char data\n    size_t: length\nend: LmP0Text\n\nstruct: LmP0Span\n    size_t: line\n    size_t: column\n    size_t: offset\n    size_t: length\nend: LmP0Span\n\nstruct: LmP0Diagnostic\n    int: code\n    size_t: line\n    size_t: column\n    []: char message 256\nend: LmP0Diagnostic\n\nstruct: LmP0Structure\n    @: LmP0Field first_field\n    @: LmP0Field last_field\n    size_t: field_count\n    @: LmP0Trailer trailer\nend: LmP0Structure\n\nstruct: LmP0Trailer\n    @: LmP0Text spelling\n    unsigned: flags\n    @: LmP0Structure body\nend: LmP0Trailer\n\nstruct: LmP0Frame\n    @: LmP0Text head\n    unsigned: flags\n    @: LmP0Structure body\n    @: LmP0Trailer trailer\nend: LmP0Frame\n\nstruct: LmP0NodeAs\n    @: LmP0Structure structure\n    @: LmP0Frame frame\n    @: LmP0Text atom\nend: LmP0NodeAs\n\nstruct: LmP0Node\n    LmP0NodeKind: kind\n    unsigned: flags\n    @: LmP0Span span\n    @: LmP0NodeAs as\nend: LmP0Node\n\nstruct: LmP0Field\n    @: LmP0Node value\n    @: LmP0Field next\nend: LmP0Field\n\nstruct: LmP0StreamEvent\n    LmP0StreamEventKind: kind\n    unsigned: node_flags\n    size_t: level\n    const: @: char text\n    size_t: text_length\n    size_t: line\n    size_t: column\n    size_t: offset\nend: LmP0StreamEvent\n\nstruct: LmP0Document\n    @: char source\n    size_t: source_length\n    @: LmP0Node root\n    @: LmP0Diagnostic diagnostic\n    @: LmOwnArena source_owner\n    @: LmOwnArena token_arena\n    @: LmOwnArena tree_arena\n    @: LmOwnArena diagnostic_arena\n    int: owners_initialized\n    int: frozen\nend: LmP0Document\n\nstruct: LmP0PendingDelimiter\n    int: active\n    @: LmP0StreamEvent event\nend: LmP0PendingDelimiter\n\nstruct: LmP0PendingMix\n    @: LmP0StreamEvent events\n    size_t: count\n    size_t: capacity\nend: LmP0PendingMix\n\nstruct: LmP0IndentStack\n    @: size_t columns\n    size_t: count\n    size_t: capacity\nend: LmP0IndentStack\n\nstruct: LmP0DisabledState\n    int: body_started\n", f) < 0
        return: 1
    if: c.fputs("    int: pending_item\n    size_t: base_level\n    size_t: top_level\n    size_t: pending_level\nend: LmP0DisabledState\n\nstruct: LmP0Stack\n    @@: LmP0Structure parents\n    @@: LmP0Node owners\n    @: uchar hard\n    size_t: capacity\nend: LmP0Stack\n\nstruct: LmP0Dump\n    @: char data\n    size_t: length\n    size_t: capacity\n    int: failed\nend: LmP0Dump\n\nstruct: LmP0DumpFrame\n    int: phase\n    const: @: LmP0Node node\n    const: @: LmP0Structure structure\n    const: @: LmP0Trailer trailer\n    const: @: LmP0Field field\n    size_t: indent\nend: LmP0DumpFrame\n\nstruct: LmP0FieldParseLoopFrame\n    @: LmP0IndentStack indent_stack\n    @: LmP0Structure structure\n    const: @: char text\n    size_t: length\n    size_t: line\n    size_t: column\n    size_t: offset\n    unsigned: flags\n    size_t: short_source_level\n    size_t: layout_base_level\n    size_t: i\n    size_t: current_source_level\n    int: allow_empty_fields\n    int: expect_field\n    int: headless_group_after_separator\n    int: indent_stack_owned\n    LmP0FieldParseLoopContinuation: continuation\n    @: LmP0Node node\n    size_t: start\n    size_t: close_index\nend: LmP0FieldParseLoopFrame\n\nstruct: LmP0PostprocessFrame\n    int: phase\n    @: LmP0Node node\n    @: LmP0Structure structure\n    @: LmP0Trailer trailer\n    @: LmP0Field field\nend: LmP0PostprocessFrame\n\nprototype:\n    fn: lm_p0_parse_string (const: @(char source); @@: LmP0Document out_document) int\n    fn: lm_p0_parse_bytes (const: @(char source); size_t: source_length; @@: LmP0Document out_document) int\n    fn: lm_p0_parse_file (const: @(char path); @@: LmP0Document out_document) int\n    fn: lm_p0_document_destroy (@: LmP0Document document) void\n    fn: lm_p0_document_root (const: @(LmP0Document document)) const: @: LmP0Node\n    fn: lm_p0_document_mutable_root (@: LmP0Document document) @: LmP0Node\n    fn: lm_p0_document_diagnostic (const: @(LmP0Document document)) const: @: LmP0Diagnostic\n    fn: lm_p0_node_structure (const: @(LmP0Node node)) const: @: LmP0Structure\n    fn: lm_p0_node_frame (const: @(LmP0Node node)) const: @: LmP0Frame\n    fn: lm_p0_node_atom (const: @(LmP0Node node)) const: @: LmP0Text\n", f) < 0
        return: 1
    if: c.fputs("    fn: lm_p0_structure_trailer (const: @(LmP0Structure structure)) const: @: LmP0Trailer\n    fn: lm_p0_frame_head (const: @(LmP0Frame frame)) const: @: LmP0Text\n    fn: lm_p0_frame_body (const: @(LmP0Frame frame)) const: @: LmP0Structure\n    fn: lm_p0_frame_trailer (const: @(LmP0Frame frame)) const: @: LmP0Trailer\n    fn: lm_p0_trailer_spelling (const: @(LmP0Trailer trailer)) const: @: LmP0Text\n    fn: lm_p0_trailer_body (const: @(LmP0Trailer trailer)) const: @: LmP0Structure\n    fn: lm_p0_node_kind_class_name (LmP0NodeKind: kind) const: @: char\n    fn: lm_p0_dump_alloc (const: @(LmP0Document document)) @: char\n    fn: lm_p0_free (@: void ptr) void\nend: prototype\n", f) < 0
        return: 1
    if: c.fputs("struct: LmP0DumpScratch\n    []: char buffer 32\nend: LmP0DumpScratch\n\nstruct: LmP0LayoutScratch\n    []: size_t delimiter_indent_stack c.LM_P0_LAYOUT_DELIMITER_STACK_LIMIT\n    []: size_t delimiter_dot_stack c.LM_P0_LAYOUT_DELIMITER_STACK_LIMIT\n    []: char delimiter_stack c.LM_P0_LAYOUT_DELIMITER_STACK_LIMIT\nend: LmP0LayoutScratch\n\nstruct: LmP0FileScratch\n    long: file_size\nend: LmP0FileScratch\n\n", f) < 0
        return: 1
    return: 0
end: decl_p0

fn: decl_p0_own_state (@: f c.FILE) int
    if: c.fputs("# Inherited fault-injection cells, not an allocator-policy design.\nint: lm_own_alloc_fails 0\nint: lm_own_ok_left -1\nint: lm_own_absorb_fails 0\n", f) < 0
        return: 1
    return: 0
end: decl_p0_own_state

fn: decl_p0_own_forward (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/p0_own.h.lm1\"\n", f) < 0
        return: 1
    return: 0
end: decl_p0_own_forward

