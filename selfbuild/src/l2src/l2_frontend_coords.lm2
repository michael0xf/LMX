        return: (cast: (int) (-1))
    schema: mres_code_schema_cell[0][result]
    while: c.lm_compiler_schema_kind(schema) = 2 && hops < mres_n_cell[0]
        result: c.lm_compiler_schema_index(schema)
        if: result < 0 || result >= mres_n_cell[0]
            return: (cast: (int) (-1))
        schema: mres_code_schema_cell[0][result]
        hops: hops + 1
    ---
    if: c.lm_compiler_schema_kind(schema) = 1 && schema < ns_n_cell[0] && ns_proc_cell[0][schema] >= 0
        return: (cast: (int) (schema))
    return: (cast: (int) (-1))
