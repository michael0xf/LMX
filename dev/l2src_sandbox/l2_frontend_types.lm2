# Ordinary L2 frontend type, contract and predef/snapshot projections.
# The50 inherited compiler cells retain their old owner; local aliases address those same cells.
predef: "l2src/l2_application.h.lm1"
predef: "l2src/l2_frontend_helpers.h.lm1"
predef: "l2src/l2_frontend_alloc.h.lm1"
predef: "l2src/l2_frontend_values.h.lm1"
predef: "l2src/l2_frontend_views.h.lm1"
predef: "l2src/l2_frontend_context.h.lm1"
include: "<stddef.h>" "<stdio.h>" "<stdlib.h>" "<string.h>" "<limits.h>"

fn: lm_compiler_error (const: (@: path char); const: (@: source_node c.LmP0Node); const: (@: msg char)) int
    @: alloc_err_cell int (cast: (@: int) (@ c.l2_alloc_err))
    @: diag_n_cell int (cast: (@: int) (@ c.l2_diag_n))
    @: rw_quiet_cell int (cast: (@: int) (@ c.l2_rw_quiet))
    @@: rw_quiet_msg_cell char (cast: (@@: char) (@ c.l2_rw_quiet_msg))
    @: rw_quiet_line_cell size_t (cast: (@: size_t) (@ c.l2_rw_quiet_line))
    @: rw_quiet_col_cell size_t (cast: (@: size_t) (@ c.l2_rw_quiet_col))
    size_t: line 1U
    size_t: column 1U
    # Failure to construct a query/result is not evidence that its field or
    # type is missing. The first allocation failure owns the diagnostic,
    # including in a speculative walker query; do not allocate a quiet copy
    # or let later semantic fallbacks rename the fatal error.
    if: alloc_err_cell[0] != 0
        if: diag_n_cell[0] != 0
            return: (cast: (int) (1))
        msg: "out of memory"
        if: alloc_err_cell[0] = 2
            msg: "size overflow"
        ---
    # A method's body tried for the walk (l2_rw_quiet, -193 T4a) is refused silently: it only gets
    # no frames.  The first such refusal is kept for a note (l2_rw_methods_count).
    if: rw_quiet_cell[0] != 0 && alloc_err_cell[0] = 0 && rw_quiet_msg_cell[0] = 0
        rw_quiet_msg_cell[0]: c.lm_compiler_msg_copy(msg)
        if: source_node != 0 && source_node\span != 0
            rw_quiet_line_cell[0]: source_node\span\line
            rw_quiet_col_cell[0]: source_node\span\column
        ---
    ---
    if: rw_quiet_cell[0] != 0 && alloc_err_cell[0] = 0
        return: (cast: (int) (1))
    # A node read from a program part is said in that part (§10): the file of a diagnostic is the file its node
    # was read from, whichever pass says it -- one handed the source's path included (l2_node_file).
    path: c.lm_compiler_node_file(path, source_node)
    if: source_node != 0 && source_node\span != 0
        line: source_node\span\line
        column: source_node\span\column
    c.fprintf(c.l1_stderr(), "l2trans error: %s:%zu:%zu: %s\n", path, line, column, msg)
    diag_n_cell[0]: diag_n_cell[0] + 1
    if: source_node != 0 && source_node\kind = c.LM_P0_NODE_ATOM && source_node\as != 0 && source_node\as\atom != 0
        c.fprintf(c.l1_stderr(), "l2trans detail: atom=%.*s\n", (cast: (int) source_node\as\atom\length), source_node\as\atom\data)
    if: source_node != 0 && source_node\kind = c.LM_P0_NODE_FRAME && source_node\as != 0 && source_node\as\frame != 0 && source_node\as\frame\head != 0
        c.fprintf(c.l1_stderr(), "l2trans detail: frame=%.*s\n", (cast: (int) source_node\as\frame\head\length), source_node\as\frame\head\data)
    return: (cast: (int) (1))
end: lm_compiler_error

fn: lm_compiler_slot_off (int: mi; int: si) size_t
    @: slot_cap_cell int (cast: (@: int) (@ c.l2_slot_cap))
    @: m_cap_cell int (cast: (@: int) (@ c.l2_m_cap))
    size_t: base
    if: mi < 0 || si < 0 || si >= slot_cap_cell[0] || m_cap_cell[0] <= 0 || mi >= m_cap_cell[0]
        return: (cast: (size_t) ((cast: (size_t) -1)))
    if: c.lm_compiler_mul_ok((cast: (size_t) mi), (cast: (size_t) slot_cap_cell[0])) = 0
        return: (cast: (size_t) ((cast: (size_t) -1)))
    base: (cast: (size_t) mi) * (cast: (size_t) slot_cap_cell[0])
    if: base + (cast: (size_t) si) < base
        return: (cast: (size_t) ((cast: (size_t) -1)))
    return: (cast: (size_t) (base + (cast: (size_t) si)))
end: lm_compiler_slot_off

fn: lm_compiler_ref_tail_atom (const: (@: fr c.LmP0Frame)) @: c.LmP0Text
    @: f c.LmP0Field
    if: fr = 0 || fr\body = 0 || fr\body\trailer != 0 || c.lm_compiler_count_active(fr\body) != 1
        return: (cast: (@: c.LmP0Text) (0))
    f: c.lm_compiler_next_active(fr\body\first_field)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || f\value\as\atom = 0 || c.lm_compiler_ident(f\value\as\atom) = 0 || lm_compiler_head_word((cast: (const: @: c.LmP0Text) (f\value\as\atom))) != 0
        return: (cast: (@: c.LmP0Text) (0))
    return: (cast: (@: c.LmP0Text) (f\value\as\atom))
end: lm_compiler_ref_tail_atom

fn: lm_compiler_ns_constructed_row (int: mi; const: (@: source_node c.LmP0Node)) int
    @: nsf_n_cell int (cast: (@: int) (@ c.l2_nsf_n))
    @@: nsf_owner_cell int (cast: (@@: int) (@ c.l2_nsf_owner))
    @@@: nsf_source_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_nsf_source))
    @@: nsf_kind_cell int (cast: (@@: int) (@ c.l2_nsf_kind))
    @@@: nsf_fname_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_nsf_fname))
    const: (@@: src_cell char (cast: (const: @@: char) (@ c.l2_src)))
    int: ni c.lm_compiler_m_nsof(mi)
    int: row 0
    int: found -1
    int: match
    @: field c.LmP0Field
    @: body c.LmP0Structure c.lm_compiler_ns_source_body(ni)
    if: body = 0 || source_node = 0 || source_node\as = 0
        return: (cast: (int) (-1))
    field: c.lm_compiler_next_active(body\first_field)
    while: field != 0 && field\value != source_node
        field: c.lm_compiler_next_active(field\next)
    if: field = 0
        return: (cast: (int) (-1))
    while: row < nsf_n_cell[0]
        match: 0
        if: nsf_owner_cell[0][row] = ni && nsf_source_cell[0][row] = source_node
            if: nsf_kind_cell[0][row] = 2 || nsf_kind_cell[0][row] = 4 || nsf_kind_cell[0][row] = 5 || nsf_kind_cell[0][row] = 6 || (nsf_kind_cell[0][row] = 12 && nsf_fname_cell[0][row] = 0)
                match: 1
            ---
        ---
        if: match != 0
            if: found >= 0
                lm_compiler_error(src_cell[0], source_node, "internal: a source child has two constructor rows")
                return: (cast: (int) (-2))
            found: row
        row: row + 1
    ---
    return: (cast: (int) (found))
end: lm_compiler_ns_constructed_row

fn: lm_compiler_ml_value_ty (int: i) int
    @: ml_n_cell int (cast: (@: int) (@ c.l2_ml_n))
    @@: ml_ty_cell int (cast: (@@: int) (@ c.l2_ml_ty))
    @@@: ml_cty_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_ml_cty))
    int: ty -1
    if: i < 0 || i >= ml_n_cell[0] || ml_ty_cell[0] = 0
        return: (cast: (int) (0 - 1))
    if: (ml_ty_cell[0][i] = 40 || ml_ty_cell[0][i] = 41) && ml_cty_cell[0] != 0 && ml_cty_cell[0][i] != 0
        ty: c.lm_compiler_foreign_byvalue(ml_cty_cell[0][i])
    if: ty >= 100
        return: (cast: (int) (ty))
    return: (cast: (int) (ml_ty_cell[0][i]))
end: lm_compiler_ml_value_ty

fn: lm_compiler_predef_has_fnptr (const: (@: name c.LmP0Text)) int
    @: want_fnptr_cell int (cast: (@: int) (@ c.l2_want_fnptr))
    int: r
    want_fnptr_cell[0]: 1
    r: lm_compiler_predef_has_type(name)
    want_fnptr_cell[0]: 0
    if: r = 0
        return: (cast: (int) (0))
    # struct: and fnptr: share the walk, so a name that is a STRUCT is not a
    # function pointer and must not be mistaken for one.
    if: lm_compiler_predef_has_type(name) != 0
        return: (cast: (int) (0))
    return: (cast: (int) (1))
end: lm_compiler_predef_has_fnptr

fn: lm_compiler_head_cfn_type (int: mi; const: (@: head c.LmP0Text)) int
    @@@: foreign_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_foreign_name))
    int: ty
    if: mi < 0 || head = 0 || head\data = 0 || c.lm_compiler_seg_count(head\data, head\length) != 1 || c.lm_compiler_c_stmt_door(head) != 0 || c.lm_compiler_ml_find(head) >= 0
        return: (cast: (int) (-1))
    if: lm_compiler_colon_bound_ty(mi, head, @ ty) != 0 || c.lm_compiler_foreign_value_ft(ty) = 0 || lm_compiler_predef_has_fnptr(foreign_name_cell[0][ty - 100]) = 0
        return: (cast: (int) (-1))
    return: (cast: (int) (ty))
end: lm_compiler_head_cfn_type

fn: lm_compiler_predef_file_has_type (const: (@: name c.LmP0Text); const: (@: quoted c.LmP0Text)) int
    @: want_fnptr_cell int (cast: (@: int) (@ c.l2_want_fnptr))
    size_t: n
    @: path char 0
    @: document c.LmP0Document 0
    const: (@: root c.LmP0Node)
    @: f c.LmP0Field
    @: first c.LmP0Field
    @: item c.LmP0Node
    @: inc c.LmP0Field
    @: q c.LmP0Text
    @: mapped c.LmP0Text 0
    @: mapped_data char 0
    int: found 0
    if: name = 0 || quoted = 0 || quoted\data = 0 || quoted\length < 2U || quoted\data[0] != 34 || quoted\data[quoted\length - 1U] != 34
        return: (cast: (int) (0))
    n: quoted\length - 2U
    path: (cast: (@: char) c.lm_compiler_xmalloc(n + 1U))
    if: path = 0
        return: (cast: (int) (0))
    c.memcpy(path, quoted\data + 1U, n)
    path[n]: 0
    document: lm_compiler_snap_document(path)
    if: document != 0
        root: c.lm_p0_document_root(document)
        if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0
            f: c.lm_compiler_next_active(root\as\structure\first_field)
            while: f != 0 && found = 0
                item: f\value
                if: (c.lm_compiler_frame_head(item, "struct") || (want_fnptr_cell[0] != 0 && c.lm_compiler_frame_head(item, "fnptr"))) && item\as\frame\body != 0
                    first: c.lm_compiler_next_active(item\as\frame\body\first_field)
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && (c.lm_compiler_text_same(first\value\as\atom, name) || (name\length > 2U && name\data[0] = 99 && name\data[1] = 46 && first\value\as\atom\length = name\length - 2U && c.memcmp(first\value\as\atom\data, name\data + 2U, name\length - 2U) = 0))
                        found: 1
                    ---
                ---
                # A predef header may reuse another header's ABI declaration.
                # Follow that declared closure instead of forcing every L2 unit
                # to repeat aggregate layouts. L1 permits several declared paths in one predef Frame.
                if: found = 0 && c.lm_compiler_frame_head(item, "predef") && item\as\frame\body != 0
                    first: c.lm_compiler_next_active(item\as\frame\body\first_field)
                    while: first != 0 && found = 0
                        if: first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM
                            found: lm_compiler_predef_file_has_type(name, (cast: (const: @: c.LmP0Text) (c.lm_compiler_predef_import(first\value\as\atom, path))))
                        first: c.lm_compiler_next_active(first\next)
                    ---
                ---
                # Generated L1 headers use foo.lm1.h while their source header
                # unit is foo.h.lm1. Follow that source edge too; pointer ABI
                # lookup needs no C layout parser and the downstream L1/C
                # compiler remains the final spelling check.
                if: found = 0 && c.lm_compiler_frame_head(item, "include") && item\as\frame\body != 0
                    inc: c.lm_compiler_next_active(item\as\frame\body\first_field)
                    while: inc != 0 && found = 0
                        if: inc\value != 0 && inc\value\kind = c.LM_P0_NODE_ATOM
                            q: inc\value\as\atom
                            if: q != 0 && q\data != 0 && q\length > 8U && q\data[0] = 34 && c.memcmp(q\data + q\length - 7U, ".lm1.h\"", 7U) = 0
                                mapped_data: (cast: (@: char) c.lm_compiler_xmalloc(q\length + 1U))
                                mapped: (cast: (@: c.LmP0Text) c.lm_compiler_xmalloc(c.sizeof(c.LmP0Text)))
                                if: mapped_data != 0 && mapped != 0
                                    c.memcpy(mapped_data, q\data, q\length)
                                    c.memcpy(mapped_data + (cast: (size_t) (q\length)) - 7U, ".h.lm1\"", 7U)
                                    mapped_data[q\length]: 0
                                    mapped\data: mapped_data
                                    mapped\length: q\length
                                    found: lm_compiler_predef_file_has_type(name, (cast: (const: @: c.LmP0Text) (c.lm_compiler_predef_import(mapped, path))))
                                    c.lm_compiler_xfree((cast: (@: void) mapped_data))
                                    c.lm_compiler_xfree((cast: (@: void) mapped))
                                    mapped_data: 0
                                    mapped: 0
                                ---
                                if: mapped_data != 0
                                    c.lm_compiler_xfree((cast: (@: void) mapped_data))
                                if: mapped != 0
                                    c.lm_compiler_xfree((cast: (@: void) mapped))
                                ---
                            ---
                        ---
                        inc: c.lm_compiler_next_active(inc\next)
                    ---
                ---
                f: c.lm_compiler_next_active(f\next)
            ---
        ---
    ---
    c.lm_compiler_xfree((cast: (@: void) path))
    return: (cast: (int) (found))
end: lm_compiler_predef_file_has_type

fn: lm_compiler_predef_has_type (const: (@: name c.LmP0Text)) int
    @: pd_n_cell int (cast: (@: int) (@ c.l2_pd_n))
    @@@: pd_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_pd))
    int: i 0
    if: name = 0
        return: (cast: (int) (0))
    while: i < pd_n_cell[0]
        if: lm_compiler_predef_file_has_type(name, pd_cell[0][i]) != 0
            return: (cast: (int) (1))
        i: i + 1
    ---
    return: (cast: (int) (0))
end: lm_compiler_predef_has_type

fn: lm_compiler_predef_receiver (const: (@: name c.LmP0Text)) int
    @: want_fnptr_cell int (cast: (@: int) (@ c.l2_want_fnptr))
    int: saved want_fnptr_cell[0]
    int: found
    want_fnptr_cell[0]: 1
    found: lm_compiler_predef_has_type(name)
    want_fnptr_cell[0]: saved
    return: (cast: (int) (found))
end: lm_compiler_predef_receiver

fn: lm_compiler_predef_file_define (const: (@: name c.LmP0Text); const: (@: quoted c.LmP0Text); int: any) @: c.LmP0Text
    size_t: n
    @: path char 0
    @: document c.LmP0Document 0
    const: (@: root c.LmP0Node)
    @: f c.LmP0Field
    @: first c.LmP0Field
    @: second c.LmP0Field
    @: item c.LmP0Node
    @: found c.LmP0Text 0
    if: name = 0 || quoted = 0 || quoted\data = 0 || quoted\length < 2U || quoted\data[0] != 34 || quoted\data[quoted\length - 1U] != 34
        return: (cast: (@: c.LmP0Text) (0))
    n: quoted\length - 2U
    path: (cast: (@: char) c.lm_compiler_xmalloc(n + 1U))
    if: path = 0
        return: (cast: (@: c.LmP0Text) (0))
    c.memcpy(path, quoted\data + 1U, n)
    path[n]: 0
    document: lm_compiler_snap_document(path)
    if: document != 0
        root: c.lm_p0_document_root(document)
        if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0
            f: c.lm_compiler_next_active(root\as\structure\first_field)
            while: f != 0 && found = 0
                item: f\value
                if: c.lm_compiler_frame_head(item, "define") && item\as\frame\body != 0 && (c.lm_compiler_count_active(item\as\frame\body) = 2 || (any != 0 && c.lm_compiler_count_active(item\as\frame\body) > 2))
                    first: c.lm_compiler_next_active(item\as\frame\body\first_field)
                    second: 0
                    if: first != 0
                        second: c.lm_compiler_next_active(first\next)
                    ---
                    if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && c.lm_compiler_text_same(first\value\as\atom, name) && second != 0 && second\value != 0 && second\value\kind = c.LM_P0_NODE_ATOM && (any != 0 || c.lm_compiler_array_count_is(second\value\as\atom) != 0)
                        found: c.lm_compiler_cnt_keep(second\value\as\atom)
                    ---
                ---
                if: found = 0 && c.lm_compiler_frame_head(item, "predef") && item\as\frame\body != 0
                    first: c.lm_compiler_next_active(item\as\frame\body\first_field)
                    while: first != 0 && found = 0
                        if: first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM
                            found: lm_compiler_predef_file_define(name, (cast: (const: @: c.LmP0Text) (c.lm_compiler_predef_import(first\value\as\atom, path))), any)
                        first: c.lm_compiler_next_active(first\next)
                    ---
                ---
                f: c.lm_compiler_next_active(f\next)
            ---
        ---
    ---
    c.lm_compiler_xfree((cast: (@: void) path))
    return: (cast: (@: c.LmP0Text) (found))
end: lm_compiler_predef_file_define

fn: lm_compiler_define_count (const: (@: name c.LmP0Text)) @: c.LmP0Text
    @: def_n_cell int (cast: (@: int) (@ c.l2_def_n))
    @@@: def_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_def))
    @: pd_n_cell int (cast: (@: int) (@ c.l2_pd_n))
    @@@: pd_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_pd))
    int: i 0
    @: first c.LmP0Field
    @: second c.LmP0Field
    @: r c.LmP0Text 0
    if: name = 0 || c.lm_compiler_ident(name) = 0
        return: (cast: (@: c.LmP0Text) (0))
    while: i < def_n_cell[0]
        if: def_cell[0][i] != 0 && def_cell[0][i]\as != 0 && def_cell[0][i]\as\frame != 0 && def_cell[0][i]\as\frame\body != 0 && c.lm_compiler_count_active(def_cell[0][i]\as\frame\body) = 2
            first: c.lm_compiler_next_active(def_cell[0][i]\as\frame\body\first_field)
            second: 0
            if: first != 0
                second: c.lm_compiler_next_active(first\next)
            ---
            if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && c.lm_compiler_text_same(first\value\as\atom, name) && second != 0 && second\value != 0 && second\value\kind = c.LM_P0_NODE_ATOM && c.lm_compiler_array_count_is(second\value\as\atom) != 0
                return: (cast: (@: c.LmP0Text) (second\value\as\atom))
            ---
        ---
        i: i + 1
    ---
    i: 0
    while: i < pd_n_cell[0] && r = 0
        r: lm_compiler_predef_file_define(name, pd_cell[0][i], 0)
        i: i + 1
    ---
    return: (cast: (@: c.LmP0Text) (r))
end: lm_compiler_define_count

fn: lm_compiler_define_name (const: (@: name c.LmP0Text)) int
    @: def_n_cell int (cast: (@: int) (@ c.l2_def_n))
    @@@: def_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_def))
    @: pd_n_cell int (cast: (@: int) (@ c.l2_pd_n))
    @@@: pd_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_pd))
    int: i 0
    @: first c.LmP0Field
    if: name = 0 || c.lm_compiler_ident(name) = 0
        return: (cast: (int) (0))
    while: i < def_n_cell[0]
        if: def_cell[0][i] != 0 && def_cell[0][i]\as != 0 && def_cell[0][i]\as\frame != 0 && def_cell[0][i]\as\frame\body != 0 && c.lm_compiler_count_active(def_cell[0][i]\as\frame\body) >= 2
            first: c.lm_compiler_next_active(def_cell[0][i]\as\frame\body\first_field)
            if: first != 0 && first\value != 0 && first\value\kind = c.LM_P0_NODE_ATOM && c.lm_compiler_text_same(first\value\as\atom, name)
                return: (cast: (int) (1))
            ---
        ---
        i: i + 1
    ---
    i: 0
    while: i < pd_n_cell[0]
        if: lm_compiler_predef_file_define(name, pd_cell[0][i], 1) != 0
            return: (cast: (int) (1))
        i: i + 1
    ---
    return: (cast: (int) (0))
end: lm_compiler_define_name

fn: lm_compiler_head_word (const: (@: t c.LmP0Text)) int
    int: ty 0
    if: t = 0 || c.lm_compiler_ident_word(t) = 0
        return: (cast: (int) (0))
    if: c.lm_compiler_receiver_word(t) != 0 || c.lm_compiler_ident(t) = 0 || c.lm_compiler_text_eq(t, "break") || c.lm_compiler_text_eq(t, "continue") || c.lm_compiler_text_eq(t, "sizeof") || c.lm_compiler_text_eq(t, "const")
        return: (cast: (int) (1))
    if: c.lm_compiler_text_eq(t, "immutable") || c.lm_compiler_text_eq(t, "independent") || c.lm_compiler_text_eq(t, "implements") || c.lm_compiler_text_eq(t, "test") || c.lm_compiler_text_eq(t, "post") || c.lm_compiler_text_eq(t, "external")
        return: (cast: (int) (1))
    if: c.lm_compiler_text_eq(t, "short") || c.lm_compiler_text_eq(t, "long") || c.lm_compiler_text_eq(t, "float") || c.lm_compiler_text_eq(t, "double") || c.lm_compiler_text_eq(t, "signed") || c.lm_compiler_text_eq(t, "_Bool")
        return: (cast: (int) (1))
    if: c.lm_compiler_unit_word(t) != 0
        return: (cast: (int) (1))
