include: "<stddef.h>"
predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_message.h.lm1"
predef: "l2src/lmx_service.h.lm1"
# The drain puts the orphan's own record into the ROOT'S schedule (lmx_manager.h.lm1).
predef: "l2src/lmx_manager.h.lm1"

# lmx_orphan.h.lm1 - R0's retention of orphans (model 25 (iv); spec 19.29.8; the last remainder
# of items 3 and 6).
#
# Model 25 (iv), verbatim: "сироты перекореняются под R0, сохраняя политику удержания (19.29.8:
# R0 -- та полоса, которая назначает срок неуспешному сироте и освобождает его; арену сироты
# никто не усыновляет)".
#
# Spec 19.29.8, verbatim on the three cases: a descendant still running at release time is closed
# by the chain and becomes an orphan; a SUCCESSFUL orphan is settled at its end-turn and
# reclaimed, arena and slot, by the settling lane at the root's next maintenance point; a FAILED
# orphan keeps its handoff-safe arena under the separate parent-loss/orphan-retention timeout and
# self-reclaims when it expires.  "An orphan is settled only by that policy, never by its
# supervising root's ordinary settle step" -- which is why the orphan is a case of its own and not
# a child like any other.  "The orphan-retention timeout is a runtime policy value with a default,
# settable per runtime like the liveness deadlines."
#
# So this ledger is R0's own bookkeeping about records whose parent went away: who they are, where
# the root put them, and when their retention began.  The record itself lives in the ROOT'S graph
# from the moment of re-rooting -- "An orphan is re-rooted at the runtime for its drain (a
# top-level Message with no parent, reachable like any root...); stage 5 makes it that root
# Message's child" -- and its ARENA is nobody's but its own until the reclaim releases it.
#
# Re-rooting rewrites the parent link and index, not only a store.  A postman asks a record for its
# `index` and follows its up-link; a record re-rooted under R0 while still carrying the index it
# had at the branch that died would still name the dying branch.  So
# adoption writes both: the index the record now has at R0 (its slot + 1, exactly as a created
# child's), and the up-link to the band that now supervises it.  This is the one place besides
# lmx_child_publish_prepared that writes a record's parent link, and it writes it for the same
# reason: the link is how the family is walked.
#
# The ledger's own memory is the ledger's: entries are the runtime's bookkeeping, not values of any
# arena, so no collection pass of any Message has to know about them (runtime bookkeeping, not arena values).
#
# THE DRAIN is here too.  19.29.8, verbatim: "a child with pending input under a host-mapped stopped
# parent waits until the parent is disposed, when the chain re-roots it under the root Message,
# WHOSE STEP RUNS ITS CLOSING TURN LIKE ANY CHILD'S".  So re-rooting is not only the address: the
# orphan's own scheduler record -- the one its builder created for it, carrying ITS band -- is given
# its wait and joins the ROOT'S schedule, which puts the orphan in the very queue the root's round
# steps its own children from.  From that moment the orphan's turns run like any child's, and each of
# them collects the orphan's arena at its boundary, never the root's.
#
# The drain window is the retention window: one policy value, assigned by the root, which is what
# "R0 -- та полоса, которая назначает срок неуспешному сироте и освобождает его" means.  A waiting
# orphan that never got its turn in that window is closed by the maintenance (without a turn) and,
# its window being the same, reclaimed in the same pass -- so NOTHING is retained forever, which is
# the one thing the retention rules forbid.
define: LMX_ORPHAN_OK 0
define: LMX_ORPHAN_INVALID 1
define: LMX_ORPHAN_FULL 2
# There is no empty child slot left in the root's graph to re-root the orphan into.
define: LMX_ORPHAN_FULL_GRAPH 3

struct: LmxOrphan
    @: LmxMsg message
    # The orphan's OWN arena: nobody adopts it, so it is released whole at the reclaim.
    @: LmxArena arena
    # Its object, when it is an L3 Thread (a plain Message has no turn and no mailbox): the record
    # whose mailbox the maintenance asks about pending input.
    @: LmxThread thread
    # Where the root put it in its own graph, so the reclaim can free the slot as well.
    size_t: slot
    # The retention clock: when the root took over, and how long a FAILED orphan may keep storage.
    ulong: started
    ulong: limit
    @: LmxOrphan next
end: LmxOrphan

struct: LmxOrphanLedger
    @: LmxOrphan head
    size_t: count
    # How many have been reclaimed since the ledger was initialized -- the policy's own evidence.
    size_t: reclaimed
end: LmxOrphanLedger

prototype:
    # Zero the ledger.  A by-value ledger must be cleared before it is initialized.
    fn: lmx_orphan_init (@: LmxOrphanLedger ledger) int
    # Re-root an orphan under this root: the first empty child slot of `graph` receives it, its
    # index and up-link are rewritten to its new place, the retention clock starts at `now` with
    # `limit`, and its arena is left alone (nobody adopts it).  `root` is the band that now
    # supervises it -- the record's parent link -- A record with no object is admitted too: a plain Message
    # has no mailbox, and is closed by the maintenance instead of by a turn.  An object
    # brings its OWN scheduler record (the one its builder created, carrying ITS band): the drain's
    # window starts there and the record joins `manager` -- the root's own schedule -- so the root's
    # step runs the orphan's turns from the next round on.
    fn: lmx_orphan_adopt (@: LmxOrphanLedger ledger; @: Lmx graph; @: LmxMsg orphan; @: LmxArena orphan_arena; @: LmxThread thread; @: LmxThread root; @: LmxService service; @: LmxManager manager; ulong: now; ulong: limit) int
    # THE MAINTENANCE POINT.  One pass over the orphans: a record still running is CLOSED here when
    # its inbox is empty (a child whose inbox is empty is closed by the maintenance without a turn)
    # or when its drain window has passed (it will get no closing turn now, and nothing may be
    # retained forever); one with pending input inside its window is left to its own turns, which
    # the root's step runs.  A settled SUCCESSFUL orphan is reclaimed at once; a settled FAILED one
    # when its retention expires -- the same window, so an orphan whose window passed is closed and
    # reclaimed in one pass.  A reclaim returns the record's whole arena, frees the slot the root
    # gave it, with it.
    fn: lmx_orphan_maintain (@: LmxOrphanLedger ledger; @: Lmx graph; @: LmxService service; @: LmxManager manager; ulong: now) int
    fn: lmx_orphan_count (@: LmxOrphanLedger ledger) size_t
    fn: lmx_orphan_reclaimed (@: LmxOrphanLedger ledger) size_t
    # Reclaim them ALL: every retained orphan's own arena goes back (no adopter will ever take it),
    # then the ledger's own memory.  This is the runtime's teardown, not a maintenance pass.
    fn: lmx_orphan_release (@: LmxOrphanLedger ledger; @: Lmx graph; @: LmxService service; @: LmxManager manager) int
end: prototype
