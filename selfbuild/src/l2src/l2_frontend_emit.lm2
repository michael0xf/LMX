        if: prepared = 0 || level < 1 || level > prepared\n
            return: (cast: (int) (1))
        index_step: prepared\steps + (level - 1)
        frame_op: "LMX_WALK_OP_ELEM"
        if: store != 0
            frame_op: "LMX_WALK_OP_ELEMPUT"
