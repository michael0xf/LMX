# Decimal value0..9, or -1 for a point outside Unicode Nd.
fn: dt_decimal (unsigned: point) int
    if: point >= 48U && point <= 57U
        return: (cast: (int) (point - 48U))
    if: point >= 1632U && point <= 1641U
        return: (cast: (int) (point - 1632U))
    if: point >= 1776U && point <= 1785U
        return: (cast: (int) (point - 1776U))
    if: point >= 1984U && point <= 1993U
        return: (cast: (int) (point - 1984U))
