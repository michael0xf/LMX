Indicator:
    int: command
    int: fault 0
    int: commanded 0
    int: sensed 0
    int: writes 0
    int: reads 0
    int: trace 0
    return: int
    mark:
        node\trace := node\trace * 10 + command
        return: 1
    set:
        node\commanded := command
        node\writes += 1
        mark()
        if: node\fault = 0
            node\sensed := command
        if: node\fault = 1
            node\sensed := 0
        if: node\fault = 2
            node\sensed := 1
        return: 1
    observe:
        node\reads += 1
        mark(2)
        return: node\sensed

Commissioning:
    @: candidate
    int: command
    return: int
    cycle:
        int: ack candidate\set(command := command)
        int: seen candidate\observe()
        return: ack = 1 && seen = command
    check:
        int: on cycle(command := 1)
        int: off cycle(command := 0)
        return: on && off
