Example:
    @: values
    @: next
    return: @
    run:
        throws: copy(sys\resize\throws)
        int: n length(values)
        []int: same []
        sys\resize(same; n)
        int: i n - 1
        while: i > 0
            same[i] := values[i] = values[i - 1]
            values[i] := values[i - 1]
            i -= 1
        if: n > 0
            same[0] := values[0] = next
            values[0] := next
        return: same
