+    args = (1, 8, 2)
+    before = deepcopy(args)
+    value = Base.invokelatest(call, args...)
+    @test observe("J01", value, args) == [1, 3, 5, 7]
+    @test args == before
+    # Случай 1: подготовка и assertions вне сравниваемого кода.
+    args = (5, -2, -2)
+    before = deepcopy(args)
+    value = Base.invokelatest(call, args...)
+    @test observe("J01", value, args) == [5, 3, 1, -1]
+    @test args == before
