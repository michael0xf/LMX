---
    Observed:
        int: seen 3
        int: seen_in_code 3
    end: Observed
---
@: shared (data [] 0)
sub: main () (
    Model: a b
    Model: c d e
    int: in_code 0
)
    :=: (data \ in_code) (length (data \ [1]Model))
end: main
main:
int: seen (length ((main \ data) \ [1]Model))
int: seen_in_code ((main \ data) \ in_code)
sub: observe ()
    :=: ((shared \ Observed) \ seen) seen
    :=: ((shared \ Observed) \ seen_in_code) seen_in_code
end: observe
observe:
