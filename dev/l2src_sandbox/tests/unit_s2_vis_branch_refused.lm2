# The root calls before cfg exists in its forward-only local context. The
# method has no lexical cfg, so the hidden input is unbound at this call site.
fn: read_branch () size_t
return: cfg\e
read_branch()
independent:
    const:
        immutable:
            (): cfg
                size_t: e 7U
            end: cfg
        end: immutable
    end: const
end: independent
return
