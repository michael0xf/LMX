---
    Observed:
        int: seen 7
    end: Observed
---
@: shared (data [] 0)
sub: main () (
    Struct1: Struct2
    Struct2:
        int: v 4
    end: Struct2
)
    :=: ((Struct1 \ Struct2) \ v) 7
end: main
main:
int: seen (((main \ data) \ Struct2) \ v)
sub: observe ()
    :=: ((shared \ Observed) \ seen) seen
end: observe
observe:
