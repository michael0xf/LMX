---
    Observed:
        int: seen 509
    end: Observed
---
fn: free () int
    @: p int (@ x)
    :=: x 9
    return: (\ p)
end: free
fn: relay () int
    return: (free)
end: relay
fn: caller () int
    int: x 5
    int: r (relay)
    return: ((x * 100) + r)
end: caller
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) (caller)
end: main
main:
