MapBoundaryStep:
    @: item
    int: direction
    int: tail 0
    required: item direction
    return: int
    step:
        throws: copy(MapThrows)
        private: int: position MapCursor\position(item\cursor)
        if: tail != 0
            position := MapCursor\position(item\tail)
        if: direction < 0
            if: position = 0
                return: 0
            position -= 1
        ---
        else:
            if: position = MapTree\length(item\document)
                return: 0
            position += 1
        private: int: begin MapCursor\position(item\tag\cursor)
        private: int: end MapCursor\position(item\tag\tail)
        if: tail = 0 && position > end
            return: 0
        if: tail != 0 && position < begin
            return: 0
        MapBoundaryMove\move(item; position; tail)
        return: 1

