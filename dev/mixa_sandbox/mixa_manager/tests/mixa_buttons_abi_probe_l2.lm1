# ABI parity guard — L1 port of mixa_buttons_abi_probe_l2.c (ticket 20260918-082421).
# offsetof is a C macro with no L1 spelling (c. pastes a call, not a preprocessor
# name). Field offsets are computed at run time via pointer arithmetic on a local
# store (same pattern as l2src/lmx_message_selftest.lm1). Output format strings
# are kept byte-identical to the C probe so L2-vs-real parity still diffs stdout.
predef: "mixa_manager/mixa_buttons_l2.h.lm1"
include: "<stdio.h>"

fn: main () int
    MixaButton: store0
    @: MixaButton p0
    p0: @ store0
    MixaButtonLine: store1
    @: MixaButtonLine p1
    p1: @ store1
    MixaButtonPanel: store2
    @: MixaButtonPanel p2
    p2: @ store2

    c.printf("MixaButton sizeof=%zu\n", c.sizeof(c.MixaButton))
    c.printf("MixaButton label=%zu\n", (cast: (size_t) @ p0\label) - (cast: (size_t) p0))
    c.printf("MixaButton row=%zu\n", (cast: (size_t) @ p0\row) - (cast: (size_t) p0))
    c.printf("MixaButton col=%zu\n", (cast: (size_t) @ p0\col) - (cast: (size_t) p0))
    c.printf("MixaButton nrows=%zu\n", (cast: (size_t) @ p0\nrows) - (cast: (size_t) p0))
    c.printf("MixaButton ncols=%zu\n", (cast: (size_t) @ p0\ncols) - (cast: (size_t) p0))
    c.printf("MixaButton fg=%zu\n", (cast: (size_t) @ p0\fg) - (cast: (size_t) p0))
    c.printf("MixaButton bg=%zu\n", (cast: (size_t) @ p0\bg) - (cast: (size_t) p0))
    c.printf("MixaButton alpha=%zu\n", (cast: (size_t) @ p0\alpha) - (cast: (size_t) p0))
    c.printf("MixaButton is_sep=%zu\n", (cast: (size_t) @ p0\is_sep) - (cast: (size_t) p0))
    c.printf("MixaButton enlarge=%zu\n", (cast: (size_t) @ p0\enlarge) - (cast: (size_t) p0))
    c.printf("MixaButtonLine sizeof=%zu\n", c.sizeof(c.MixaButtonLine))
    c.printf("MixaButtonLine items=%zu\n", (cast: (size_t) @ p1\items) - (cast: (size_t) p1))
    c.printf("MixaButtonLine count=%zu\n", (cast: (size_t) @ p1\count) - (cast: (size_t) p1))
    c.printf("MixaButtonLine cap=%zu\n", (cast: (size_t) @ p1\cap) - (cast: (size_t) p1))
    c.printf("MixaButtonPanel sizeof=%zu\n", c.sizeof(c.MixaButtonPanel))
    c.printf("MixaButtonPanel lines=%zu\n", (cast: (size_t) @ p2\lines) - (cast: (size_t) p2))
    c.printf("MixaButtonPanel line_count=%zu\n", (cast: (size_t) @ p2\line_count) - (cast: (size_t) p2))
    c.printf("MixaButtonPanel line_cap=%zu\n", (cast: (size_t) @ p2\line_cap) - (cast: (size_t) p2))
    c.printf("MixaButtonPanel hb=%zu\n", (cast: (size_t) @ p2\hb) - (cast: (size_t) p2))
    c.printf("MixaButtonPanel wb=%zu\n", (cast: (size_t) @ p2\wb) - (cast: (size_t) p2))
    c.printf("MixaButtonPanel margin=%zu\n", (cast: (size_t) @ p2\margin) - (cast: (size_t) p2))
    c.printf("MixaButtonPanel panel_w=%zu\n", (cast: (size_t) @ p2\panel_w) - (cast: (size_t) p2))
    c.printf("MixaButtonPanel panel_h=%zu\n", (cast: (size_t) @ p2\panel_h) - (cast: (size_t) p2))
    c.printf("MixaButtonPanel origin_row=%zu\n", (cast: (size_t) @ p2\origin_row) - (cast: (size_t) p2))
    c.printf("MixaButtonPanel origin_col=%zu\n", (cast: (size_t) @ p2\origin_col) - (cast: (size_t) p2))
    c.printf("MixaButtonPanel view_w=%zu\n", (cast: (size_t) @ p2\view_w) - (cast: (size_t) p2))
    c.printf("MixaButtonPanel scroll_x=%zu\n", (cast: (size_t) @ p2\scroll_x) - (cast: (size_t) p2))
    c.printf("MixaButtonPanel is_open=%zu\n", (cast: (size_t) @ p2\is_open) - (cast: (size_t) p2))
    return: 0

