+      case error: Throwable => primary = error; throw error
+    } finally {
+      try release(resource)
+      catch {
+        case cleanup: Throwable =>
+          if (primary == null) throw cleanup
+          else throw combine(primary, cleanup)
+      }
+    }
   }
