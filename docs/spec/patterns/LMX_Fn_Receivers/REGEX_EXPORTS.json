  "new_regex_specific_kernel_bridges": [],
  "generic_integration_gates": [
    "FxKernel arrayInfo/read/admit/write (shared with sequences)",
    "common actual-signature declared-failure propagation and admission",
    "common operand | branch integration",
    "tree grouping/priority/field-stream plan plus a distinct application adapter; one left actual and current-level right references, with no extra opening pass"
  ],
  "text_view_preparation": {
    "public_view": "profile + original source descriptor",
    "per_operation": "One RxPreparedSource retains actual units, domain and profile; text profile contains its current decoded units/byte offsets",
    "result_identity": "Match.source and Span.source retain original view; generic private prepared metadata retain the chosen index and exact domain",
    "mutation": "Inter-operation reuse allowed; source remains unchanged during matching, suspension and result access under the lifetime contract"
  },
  "boolean_text_predicates": {
    "contains": "any start; a tail may remain",
    "hasPrefix": "start 0; a tail may remain; delegate to matchAt",
    "hasSuffix": "some valid start; end equals source length; enumerate end-filtered candidates at every start on one prepared source",
    "matches": "start 0 and end equals source length; delegate to wholeMatch",
    "result": "int 1 or 0; empty successful matches count as present; failures propagate",
    "text_replacement": "replace returns a fresh value using the selected source slice/append profile; []char for text and actual Array profile for ArrayView"
  }
}
