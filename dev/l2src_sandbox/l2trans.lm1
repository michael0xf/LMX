                return: 1
            if: l2_rw_leave(bsave) != 0
                return: 1
            \made: 1
            if: l2_rw_put(into, slot, node) != 0
                return: 1
            return: 0
        if: stmt\as = 0 || stmt\as\structure = 0
            return: 0
