# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: effects 0
        int: arithmetic 0
        int: called 0
        int: indexed 0
        int: via_whole 0
)
int: effects 0
fn: produce () int
    node\effects := node\effects + 1
    return: 4
fn: add (int: value; int: other 2) int
    return: value + other
int: a 6
int: b 7
int: arithmetic add((a + b))
int: called add((produce()))
@: Any ()
fn: frame_value (@: value Any; int: other 12) int (return: other)
@: Carrier (const: (@: field Any))
int: indexed frame_value(Carrier[0])
# via_whole: the whole-arguments reading (the book #declaration-selection, R89): Pass as written is refused by the model
# Fielded of value (the body reads value\field, Pass has no field), its opened fields resolve the call: 13. The former form
# -- model Any, which Pass itself satisfies, so both readings suit -- is an ambiguity by the norm and lives in
# declsel_both_readings (1 1 3); its old pin held on the silent win of the opened reading (fable, R94).
@: Fielded (int: field 0)
fn: frame_whole (@: value Fielded; int: other 12) int
    return: other + value\field * 0
@: Whole (Holder(int: field 5); Pass(@: value Holder; int: other 13))
int: via_whole frame_whole(Whole\Pass)
fn: qualified (const: (int: value)) int (return: 1)
fn: deep (@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@: value c.FILE) int (return: 1)
fn: array (char([]([](value)))) int (return: 1)
fn: profile (c.uint8_t: value) int (return: 1)
if: 0
    qualified((const: (int: value 9)))
    deep((@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@: value c.FILE))
    array((char([]([](value)))))
    profile((c.uint8_t: value 7))
int: done 1

sub: main ()
    @: shared node[0]
    shared\Observed\effects := node\effects
    shared\Observed\arithmetic := arithmetic
    shared\Observed\called := called
    shared\Observed\indexed := indexed
    shared\Observed\via_whole := via_whole
main()
