# Probe 275 s3.
Far:
    int: z 9
    b:
        int: q 1
        int: y 7
        int: u 4
    end: b
end: Far
Near:
    a:
        b:
            int: u 2
            int: y 3
        end: b
    end: a
end: Near
Other:
    int: z 9
    int: y 7
end: Other
Box:
    kid:
        int: k 1
        int: y 3
    end: kid
end: Box
Third:
    int: y 5
    int: k 6
end: Third
int: quote 11
sub: put_far ()
    quote\a: Far
end: put_far
sub: put_third ()
    quote\kid: Third
end: put_third
Writer:
    var\y: var\y + 1
end: Writer
fn: m () int
    @: quote Box Box
    put_third()
    if: Box\kid\y != 5
        return: 81
    call: Writer Box\kid
    if: Third\y != 6 || Third\k != 6
        return: 82
    if: Box\kid\y != 6
        return: 83
    return: 7
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
