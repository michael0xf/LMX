+return: lmx_pointer_store_context_in(arena, cell, value, 0)
+
+fn: lmx_pointer_cell_context (@: LmxArena arena; @: void cell) @: LmxWalkValue
@@ -246,0 +250,14 @@ fn: lmx_pointer_store_in (@: LmxArena arena; @: void cell; @: void value) int
+    @: LmxChunk chunk
+    size_t: index
+    if: pool = 0
+        return: 0
+    chunk: lmx_pool_chunk_at(pool, cell)
+    if: chunk = 0 || chunk\value_contexts = 0
+        return: 0
+    index: (cast: (size_t) ((cast: (@: char) cell) - (cast: (@: char) lmx_chunk_data(chunk)))) / pool\stride
+return: chunk\value_contexts + index
+
+fn: lmx_pointer_store_context_in (@: LmxArena arena; @: void cell; @: void raw; @: LmxWalkValue context) int
+    @: LmxPool pool lmx_pointer_pool_in(arena, cell)
