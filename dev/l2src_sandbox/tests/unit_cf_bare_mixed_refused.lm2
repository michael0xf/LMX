# A bare callable formal is a reference, not an implicit call. A numeric operand rejects it.
fn: five () int
    return: 5
end: five

fn: apply (op(fn: () int) size_t(k)) size_t
    return: op + k
end: apply

size_t: r 0U
r: apply(five 2U)
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
