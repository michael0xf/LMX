FxAppend:
    private:
        @: first
        @: second
    return: @
    append:
        throws: copy(FxThrows\sequence)
        private: @: empty (copy(()))
        return: FxSeqConcat\concat(parts := (empty; first; second))

FxApply:
    private:
        @: operation
        @: args
    return: @
    apply:
        throws: copy(FxThrows\call)
        private: @: outcome FxTry\attempt(operation := operation; args := args)
        if: outcome\ok = 0
            throw: FxCallFailure(outcome)
        return: outcome\value

FxBuild:
    private:
        @: contract
        char[]: bodyText
        @: state
        @: failures
        @: policy 0
    return: @
    make:
        throws: FxIndex FxKernelFailure FxTypeToken
        private: @: shape FxKernel\signature(subject := contract)
        private: @: bodyGraph sys\fromLmx(bodyText)
        private: @: selectedPolicy policy
        if: selectedPolicy = 0
            selectedPolicy := FxOwnPolicy\make(contract)
        return: FxKernel\callable(contract; shape\names; bodyGraph; state; failures; selectedPolicy)

FxCharIndex:
    private:
        char[]: chars
        char: value
    return: int
    index:
        private: int: i 0
        while: i < length(chars)
            if: chars[i] = value
                return: i
            i += 1
        return: -1

FxConcat:
    private:
        char[]: first
        char[]: second
    return: char[]
    concat:
        throws: copy(FxThrows\sequence)
        private: @: out FxSeqConcat\concat(parts := (first; second))
        return: \out

FxDecimal:
    private: int: number
    return: char[]
    decimal:
        throws: copy(FxThrows\selection)
        if: number < 0
            throw: FxIndex()
        return: FxFormatInt\formatInt(number)

FxFormatInt:
    private:
        bigint: value
        int: base 10
    return: char[]
    formatInt:
        throws: copy(FxThrows\selection)
        if: base < 2 || base > 36
            throw: FxIndex()
        private: char[]: digits "0123456789abcdefghijklmnopqrstuvwxyz"
        private: bigint: magnitude value
        private: int: negative value < 0
        if: negative != 0
            magnitude := -magnitude
        private: char[]: out []
        private: @: info FxSeqInfo\get(out)
        while: 1
            private: int: digit magnitude % base
            private: int: at length(out)
            sys\resize(out; FxSeqSize\sum(at; 1; info\maxLength))
            out[at] := digits[digit]
            magnitude := magnitude / base
            if: magnitude = 0
                break
        ---
        if: negative != 0
            out := \FxSeqConcat\concat((out; "-"))
        return: \FxSeqReverse\reverse(out)

FxIdentity:
    private: @: typeToken
    return: @
    identity:
        throws: copy(FxThrows\selection)
        private: @: requirement FxKernel\normalizeType(token := typeToken)
        private: @: contract FxSignatures\make(FxOne\make(requirement); requirement)
        private: @: state (copy(()))
        private: @: failures (copy(()))
        return: FxBuild\make(contract; "return: p0\n"; state; failures)

FxIndices:
    private:
        int: start
        int: count
    return: @
    make:
        throws: FxIndex
        if: start < 0 || count < 0
            throw: FxIndex()
        private: @: out (copy(()))
        sys\resize(out; count)
        private: int: i 0
        while: i < count
            out[i] := start + i
            i += 1
        return: out

FxInputPolicy:
    @: source 0
    @: positions 0
    @: boundPositions 0
    @: boundValues 0
    @: pendingPositions 0
    int: sourcePolicy 0

FxLabels:
    private: int: count
    return: @
    labels:
        throws: copy(FxThrows\selection)
        if: count < 0
            throw: FxIndex()
        private: @: out (copy(()))
        sys\resize(out; count)
        private: int: i 0
        while: i < count
            out[i] := FxConcat\concat("p"; FxDecimal\decimal(i))
            i += 1
        return: out

FxMaybe:
    int: present 0
    @: value 0

FxNone:
    return: @
    none:
        return: (copy(FxMaybe))

FxOne:
    private: @: value
    return: @
    make:
        private: @: out (copy(()))
        sys\resize(out; 1)
        out[0] := value
        return: out

FxOwnPolicy:
    private: @: contract
    return: @
    make:
        throws: FxIndex FxKernelFailure FxTypeToken
        private: @: info FxKernel\signature(contract)
        private: @: out (copy(FxInputPolicy))
        out\source := contract
        out\positions := FxIndices\make(0; length(info\inputTypes))
        out\boundPositions := (copy(()))
        out\boundValues := (copy(()))
        out\pendingPositions := (copy(()))
        return: out

FxRecordOperands:
    copy: sys\OPERANDS_TEMPLATE
    required: left right
    return: @
    record:
        throws: FxRecordArity
        if: length(right) != 0
            throw: FxRecordArity()
        return: left

FxRecords:
    private: @: value
    return: @
    reference:
        throws: FxRecordArity
        return: (value FxRecordOperands\record)

FxRepeatText:
    private:
        char[]: text
        int: count
    return: char[]
    repeatText:
        throws: copy(FxThrows\sequence)
        if: count < 0
            throw: SequenceSize()
        return: \FxStdCycle\cycle(text; count)

FxSameText:
    private:
        char[]: first
        char[]: second
    return: int
    same:
        if: length(first) != length(second)
            return: 0
        char[]: unitSource first
        char[]: unitPart second
        return: FxUnitRange\equal(0)

FxSeqAdmit:
    private:
        @: target
        @: value
    required: target value
    return: @
    admit:
        throws: FxKernelFailure FxTypeToken SequenceElement
        return: FxKernel\arrayAdmit(target := target; value := value)

FxSeqAllocate:
    private:
        int: arrayType
        int: count
    required: arrayType count
    return: @
    make:
        throws: FxKernelFailure FxTypeToken SequenceSize
        if: count < 0
            throw: SequenceSize()
        private: @: out (arrayType: [])
        private: @: info FxSeqInfo\get(out)
        if: count > info\maxLength
            throw: SequenceSize()
        sys\resize(out; count)
        return: out

FxSeqBounds:
    private:
        @: source
        int: begin
        int: end
    required: source begin end
    return: int
    count:
        throws: FxKernelFailure FxTypeToken ReceiverIndex
        FxSeqInfo\get(source)
        if: begin < 0 || end < begin || end > length(source)
            throw: ReceiverIndex()
        return: end - begin

FxSeqCompress:
    private:
        @: source
        @: mask
    required: source mask
    return: @
    compress:
        throws: FxKernelFailure FxShape FxTypeToken ReceiverIndex SequenceElement SequenceSize
        private: @: info FxSeqInfo\get(source)
        FxSeqInfo\get(mask)
        private: int: count length(source)
        if: length(mask) != count
            throw: FxShape()
        private: @: flags FxSeqAllocate\make(int[]; count)
        private: int: accepted 0
        private: int: i 0
        # Validate every mask value before constructing the selected result.
        while: i < count
            private: @: value FxSeqRead\read(mask; i)
            private: int: flag FxSeqInteger\read(value)
            flags[i] := flag
            if: flag != 0
                accepted += 1
            i += 1
        private: @: out FxSeqAllocate\make(info\arrayType; accepted)
        private: int: written 0
        i := 0
        while: i < count
            if: flags[i] != 0
                private: @: value FxSeqRead\read(source; i)
                FxKernel\arrayWrite(target := out; index := written; value := value)
                written += 1
            i += 1
        return: out

FxSeqConcat:
    private: @: parts
    required: parts
    return: @
    concat:
        throws: copy(FxThrows\sequence)
        FxSeqInfo\get(parts)
        private: int: count length(parts)
        private: int: arrayType @[]
        private: int: elementType 0
        private: int: allDense 1
        private: int: i 0
        # Inspect all parts, including empty dense parts. Comparison uses
        # canonical full element codes from the common type resolver.
        while: i < count
            private: @: part FxSeqRead\read(parts; i)
            private: @: info FxSeqInfo\get(part)
            if: i = 0
                arrayType := info\arrayType
                elementType := info\elementType
            if: info\dense = 0 || info\elementType != elementType
                allDense := 0
            i += 1
        if: count = 0 || allDense = 0
            arrayType := @[]
        private: @: out FxSeqAllocate\make(arrayType; 0)
        private: @: outInfo FxSeqInfo\get(out)
        private: int: total 0
        i := 0
        while: i < count
            private: @: part FxSeqRead\read(parts; i)
            total := FxSeqSize\sum(total; length(part); outInfo\maxLength)
            i += 1
        sys\resize(out; total)
        private: int: at 0
        i := 0
        while: i < count
            private: @: part FxSeqRead\read(parts; i)
            private: int: partSize length(part)
            private: int: j 0
            while: j < partSize
                private: @: value FxSeqRead\read(part; j)
                FxKernel\arrayWrite(target := out; index := at; value := value)
                at += 1
                j += 1
            i += 1
        return: out

FxSeqEmpty:
    private: @: source
    required: source
    return: @
    make:
        throws: FxKernelFailure FxTypeToken SequenceSize
        private: @: info FxSeqInfo\get(source)
        return: FxSeqAllocate\make(info\arrayType; 0)

FxSeqInfo:
    private: @: source
    required: source
    return: @
    get:
        throws: copy(FxThrows\kernel)
        return: FxKernel\arrayInfo(source := source)

FxSeqInteger:
    private: @: value
    required: value
    return: int
    read:
        throws: SequenceElement
        private: int: sample 0
        if: sys\typeof(value) != sys\typeof(@sample)
            throw: SequenceElement()
        return: \value

FxSeqPredicate:
    private: @: value
    required: value
    return: int
    truth:
        throws: FxPredicate
        private: int: sample 0
        if: sys\typeof(value) != sys\typeof(@sample)
            throw: FxPredicate()
        private: int: flag \value
        return: flag != 0

FxSeqPush:
    private:
        @: target
        @: value
    required: target value
    return: @
    append:
        throws: copy(FxThrows\mutation)
        private: @: info FxSeqInfo\get(target)
        private: @: ready FxSeqAdmit\admit(target; value)
        private: int: oldSize length(target)
        private: int: newSize FxSeqSize\sum(oldSize; 1; info\maxLength)
        sys\resize(target; newSize)
        FxKernel\arrayWrite(target := target; index := oldSize; value := ready)
        return: target

FxSeqRead:
    private:
        @: source
        int: index
    required: source index
    return: @
    read:
        throws: FxKernelFailure FxTypeToken ReceiverIndex
        return: FxKernel\arrayRead(source := source; index := index)

FxSeqReverse:
    private: @: source
    required: source
    return: @
    reverse:
        throws: copy(FxThrows\sequence)
        private: @: info FxSeqInfo\get(source)
        private: int: count length(source)
        private: @: out FxSeqAllocate\make(info\arrayType; count)
        private: int: i 0
        while: i < count
            private: @: value FxSeqRead\read(source; count - 1 - i)
            FxKernel\arrayWrite(target := out; index := i; value := value)
            i += 1
        return: out

FxSeqSize:
    private:
        int: base
        int: extra
        int: limit
    required: base extra limit
    return: int
    sum:
        throws: SequenceSize
        if: base < 0 || extra < 0 || base > limit
            throw: SequenceSize()
        if: extra > limit - base
            throw: SequenceSize()
        return: base + extra

FxSeqStore:
    private:
        @: target
        int: index
        @: value
    required: target index value
    write:
        throws: FxKernelFailure FxTypeToken ReceiverIndex SequenceElement
        private: @: ready FxSeqAdmit\admit(target; value)
        FxKernel\arrayWrite(target := target; index := index; value := ready)

FxSignatures:
    private:
        @: inputs
        @: result
    return: @
    make:
        throws: copy(FxThrows\selection)
        private: @: labels FxLabels\labels(length(inputs))
        private: @: data FxKernel\signatureData(inputs := inputs; result := result; labels := labels)
        Built :: data
        return: Built

FxSome:
    private: @: value
    return: @
    some:
        private: @: result (copy(FxMaybe))
        result\present := 1
        result\value := value
        return: result

FxStdCollect:
    private:
        @: next
        int: limit -1
    required: next
    return: @
    collect:
        throws: copy(FxThrows\mutation) FxCallFailure
        if: limit < -1
            throw: SequenceSize()
        private: @: out FxSeqAllocate\make(@[]; 0)
        while: limit = -1 || length(out) < limit
            private: @: outcome FxTry\attempt(next; ())
            if: outcome\ok = 0
                if: FxSameText\same(outcome\failure; sys\name(Stop)) != 0
                    return: out
                throw: FxCallFailure(outcome)
            FxSeqPush\append(out; outcome\value)
        return: out

FxStdCycle:
    private:
        @: items
        int: count
    required: items count
    return: @
    cycle:
        throws: copy(FxThrows\sequence)
        private: @: info FxSeqInfo\get(items)
        if: count <= 0 || length(items) = 0
            return: FxSeqEmpty\make(items)
        if: count > info\maxLength / length(items)
            throw: SequenceSize()
        return: FxSeqConcat\concat(FxStdReplicate\replicate(items; count))

FxStdReplicate:
    private:
        @: value
        int: count
    required: value count
    return: @
    replicate:
        throws: FxKernelFailure FxTypeToken SequenceSize
        private: int: size count
        if: size < 0
            size := 0
        private: @: out FxSeqAllocate\make(@[]; size)
        private: int: i 0
        while: i < size
            out[i] := value
            i += 1
        return: out

FxThrows:
    adapter:
        FxArity
        FxIndex
        FxKernelFailure
        FxTypeToken
        ReceiverIndex
        SequenceSize
    call:
        FxCallFailure
        FxKernelFailure
        FxTypeToken
    capture:
        FxArity
        FxIndex
        FxKernelFailure
        FxRecordArity
        FxTypeToken
        ReceiverIndex
        SequenceSize
    fixture:
        FxArity
        FxIndex
        FxKernelFailure
        FxRecordArity
        FxTypeToken
    kernel:
        FxKernelFailure
        FxTypeToken
    lazyfixture:
        FxArity
        FxIndex
        FxKernelFailure
        FxLazyCycle
        FxRecordArity
        FxTypeToken
    mutation:
        FxKernelFailure
        FxTypeToken
        ReceiverIndex
        SequenceElement
        SequenceSize
    mutationfixture:
        FxArity
        FxIndex
        FxKernelFailure
        FxRecordArity
        FxTypeToken
        ReceiverIndex
        SequenceElement
        SequenceSize
    permutation:
        FxArity
        FxIndex
        FxKernelFailure
        FxTypeToken
        ReceiverIndex
        ReceiverPermutation
        SequenceSize
    predicate:
        FxCallFailure
        FxKernelFailure
        FxPredicate
        FxTypeToken
        ReceiverIndex
    rangefixture:
        FxArity
        FxIndex
        FxKernelFailure
        FxRecordArity
        FxTypeToken
        SequenceSize
        SequenceStep
    recordcall:
        FxCallFailure
        FxKernelFailure
        FxRecordArity
        FxTypeToken
    reorder:
        FxKernelFailure
        FxTypeToken
        ReceiverIndex
        ReceiverPermutation
        SequenceSize
    retry:
        FxArity
        FxCallFailure
        FxIndex
        FxKernelFailure
        FxRecordArity
        FxTypeToken
        ReceiverIndex
        SequenceSize
    selection:
        FxIndex
        FxKernelFailure
        FxTypeToken
        ReceiverIndex
        SequenceSize
    sequence:
        FxKernelFailure
        FxTypeToken
        ReceiverIndex
        SequenceSize
    sequencefixture:
        FxArity
        FxCallFailure
        FxIndex
        FxKernelFailure
        FxPredicate
        FxRecordArity
        FxShape
        FxTypeToken
        ReceiverIndex
        ReceiverPermutation
