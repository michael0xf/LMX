predef: "l2src/lmx_orphan.h.lm1"
predef: "l2src/lmx_service.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l2src/lmx_thread.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdlib.h>"

# lmx_orphan.lm1 - the ledger, the re-rooting and the maintenance point.  See the header for what
# the model and the spec ask; what is worth spelling out here is that a reclaim is ONE act with
# five parts, and that all five belong together: the record leaves its schedule, the slot the
# root gave the orphan goes back, its
# its ARENA goes back whole (nobody adopted it), and the ledger forgets
# it.  Doing any one of those alone would leave a Message that is half there.

fn: lmx_orphan_init (@: LmxOrphanLedger ledger) int
    if: ledger = 0
        return: c.LMX_ORPHAN_INVALID
    ledger\head: 0
    ledger\count: 0U
    ledger\reclaimed: 0U
return: c.LMX_ORPHAN_OK

fn: lmx_orphan_count (@: LmxOrphanLedger ledger) size_t
    if: ledger = 0
        return: 0U
return: ledger\count

fn: lmx_orphan_reclaimed (@: LmxOrphanLedger ledger) size_t
    if: ledger = 0
        return: 0U
return: ledger\reclaimed

# The first child slot of the root's graph that nothing occupies: the orphan is re-rooted THERE,
# which is what makes it reachable "like any root" and what the reclaim gives back.
fn: lmx_orphan_slot (@: Lmx graph) size_t
    size_t: index
    if: graph = 0 || graph\len <= 0
        return: c.LMX_ORPHAN_FULL_GRAPH
    ---
    index: 0U
    while: index < (cast: (size_t) graph\len)
        if: lmx_arena_ref_value(graph, index) = 0
            return: index
        ---
        index: index + 1U
    ---
return: c.LMX_ORPHAN_FULL_GRAPH

fn: lmx_orphan_adopt (@: LmxOrphanLedger ledger; @: Lmx graph; @: LmxMsg orphan; @: LmxArena orphan_arena; @: LmxThread thread; @: LmxThread root; @: LmxService service; @: LmxManager manager; ulong: now; ulong: limit) int
    @: LmxOrphan entry
    @: void saved_parent
    # A VALUE, not an address: `@:` here declared a pointer and the C came out as
    # `unsigned * saved_index = orphan->index;` (grok_bot's reading, 19.09).  It round-trips on this
    # ABI, which is why nothing ever noticed: the gate keeps -Werror on four hard guards only, and
    # int-conversion is not one of them.
    unsigned: saved_index
    @: LmxSchedule sched
    size_t: slot
    int: refused
    int: registered
    if: ledger = 0 || graph = 0 || orphan = 0 || orphan_arena = 0 || limit = 0U
        return: c.LMX_ORPHAN_INVALID
    slot: lmx_orphan_slot(graph)
    if: slot = c.LMX_ORPHAN_FULL_GRAPH
        return: c.LMX_ORPHAN_FULL_GRAPH
    ---
    entry: (cast: (@: LmxOrphan) calloc(1U, c.sizeof(c.LmxOrphan)))
    if: entry = 0
        return: c.LMX_ORPHAN_FULL
    ---
    # What this act will CHANGE is saved before it changes anything: the ADDRESS it is about to
    # rewrite (the index the record answers with and the up-link the walk follows) and nothing else
    # -- the slot it takes from the root was empty by construction.  A refusal must leave the record
    # exactly as it was, or the branch that still holds it would find a record whose address has
    # moved under it.  ONE cleanup block below uses these, whatever refused, so no failure path can
    # forget a part of the act.
    refused: 0
    registered: 0
    saved_index: orphan\index
    if: thread != 0
        saved_parent: thread\parent
    ---
    # The re-rooting itself: ONE store into the root's own graph -- the same kind of publication
    # every other child gets, and the reason the root's slot is what the reclaim gives back.
    if: lmx_arena_ref_store(graph, slot, (cast: (@: void) orphan)) != 0
        refused: c.LMX_ORPHAN_INVALID
    ---
    if: refused = 0
        # ... and the ADDRESS that goes with it: the record's index at the root (its slot + 1, exactly
        # as a created child's), and the up-link the walk follows.  A re-rooted record that still
        # answered with the index it had at the branch that died would be answering with an address
        # nobody owns -- so both are written before anything reads them.
        orphan\index: (cast: (unsigned) slot) + 1U
        if: thread != 0
            thread\parent: (cast: (@: void) root)
            if: service != 0
                if: lmx_service_register(service, thread, orphan_arena) != c.LMX_SERVICE_OK
                    refused: c.LMX_ORPHAN_INVALID
                else:
                    registered: 1
                ---
            ---
            # THE DRAIN: the record its builder created for this object -- the one carrying ITS band
            # -- is given its window and joins the ROOT'S OWN SCHEDULE, so the root's next round steps
            # this orphan exactly like one of its children.  Its turns then collect the orphan's arena
            # at their boundaries, never the root's: the record's band is its own, written by its
            # creator, and a queue never moves a record between bands (lmx_manager.h.lm1).
            sched: thread\slot
            if: refused = 0 && sched != 0 && manager != 0
                if: lmx_schedule_wait(sched, now) != c.LMX_SCHEDULE_OK || lmx_manager_add(manager, sched) != c.LMX_MANAGER_OK
                    refused: c.LMX_ORPHAN_INVALID
                ---
            ---
        ---
    ---
    if: refused != 0
        orphan\index: saved_index
        if: thread != 0
            if: registered != 0 && service != 0
                lmx_service_unregister(service, thread)
            ---
            thread\parent: saved_parent
        ---
        lmx_arena_ref_store(graph, slot, 0)
        free((cast: (@: void) entry))
        return: refused
    ---
    entry\message: orphan
    entry\arena: orphan_arena
    entry\thread: thread
    entry\slot: slot
    entry\started: now
    entry\limit: limit
    entry\next: ledger\head
    ledger\head: entry
    ledger\count: ledger\count + 1U
return: c.LMX_ORPHAN_OK

# One reclaim: the five parts, in the order that keeps the record reachable until the last of them.
fn: lmx_orphan_free (@: LmxOrphanLedger ledger; @: Lmx graph; @: LmxService service; @: LmxManager manager; @: LmxOrphan entry) int
    if: entry = 0
        return: c.LMX_ORPHAN_INVALID
    # (1) the service forgets it first: an entry naming storage that is about to go would be a
    #     route to a Message that no longer exists.
    if: service != 0 && entry\thread != 0
        lmx_service_unregister(service, (cast: (@: LmxThread) entry\thread))
    ---
    # (2) the record leaves the schedule it joined: it is about to lose its storage, and a queue
    #     that kept it would step freed cells on the root's next round.  A record that never joined
    #     (one the adoption could not schedule) is not in the queue, and the removal refuses.
    if: manager != 0 && entry\thread != 0 && entry\thread\slot != 0
        lmx_manager_remove(manager, entry\thread\slot)
    ---
    # (2) the slot the root gave it goes back.
    if: graph != 0 && entry\slot < (cast: (size_t) graph\len)
        lmx_arena_ref_store(graph, entry\slot, 0)
    ---
    # (3) its own arena goes WHOLE: nobody adopted it, so nothing else holds any of it.
    if: entry\arena != 0
        lmx_arena_release(entry\arena)
    ---
    # (4) and the ledger forgets it.
    if: ledger\head = entry
        ledger\head: entry\next
    else:
        @: LmxOrphan walk
        walk: ledger\head
        while: walk != 0
            if: walk\next = entry
                walk\next: entry\next
                walk: 0
            else:
                walk: walk\next
            ---
        ---
    ---
    ledger\count: ledger\count - 1U
    ledger\reclaimed: ledger\reclaimed + 1U
    free((cast: (@: void) entry))
return: c.LMX_ORPHAN_OK

fn: lmx_orphan_maintain (@: LmxOrphanLedger ledger; @: Lmx graph; @: LmxService service; @: LmxManager manager; ulong: now) int
    @: LmxOrphan entry
    @: LmxOrphan next
    @: LmxMsg message
    @: LmxSchedule sched
    int: keep
    if: ledger = 0
        return: c.LMX_ORPHAN_INVALID
    entry: ledger\head
    while: entry != 0
        next: entry\next
        message: entry\message
        if: message = 0
            lmx_orphan_free(ledger, graph, service, manager, entry)
        else:
            if: message\running != 0
                # Still running at the root's maintenance point.  A child whose inbox is EMPTY is
                # closed here without a turn -- the root's band is its parent's band now, so the stop
                # request is the root's write.  One with PENDING input is left to its own turns,
                # which the root's step runs (the drain) -- unless its window has passed, in which
                # case it gets no closing turn and is closed here: nothing may be retained forever.
                keep: 0
                if: entry\thread != 0
                    if: lmx_thread_mail_count(entry\thread, c.LMX_POST_INBOX) != 0U
                        sched: entry\thread\slot
                        if: sched != 0 && now - sched\started < sched\limit
                            keep: 1
                        ---
                    ---
                ---
                if: keep = 0
                    message\running: 0
                    # The close written by a maintaining lane is end-turn bookkeeping, not a turn,
                    # and it leaves the Message stopped AND handoff-safe (19.29.8: "it leaves the
                    # Message stopped and handoff-safe so that its parent's dispose or adopt can
                    # settle it") -- which is what makes a retained failed orphan's arena the
                    # handoff-safe one the retention policy is about.
                    message\handoff_ready: 1
                    # A close the maintenance writes has no turn after it, so nothing settles this
                    # record later: if its window has passed -- and the window that denied it a turn
                    # is the retention window -- it goes NOW, in this same pass.  Otherwise the
                    # retention rule below (the next pass) is what takes it.
                    if: now - entry\started >= entry\limit
                        lmx_orphan_free(ledger, graph, service, manager, entry)
                    ---
                ---
            else:
                if: message\success != 0
                    # A successful orphan is settled at its end-turn and reclaimed HERE, at the
                    # root's next maintenance point -- the one reclaim site (19.29.8: "one reclaim
                    # site, never retained, never adopted").
                    lmx_orphan_free(ledger, graph, service, manager, entry)
                else:
                    if: now - entry\started >= entry\limit
                        # A failed orphan keeps its handoff-safe arena under the retention timeout
                        # and self-reclaims when it expires.
                        lmx_orphan_free(ledger, graph, service, manager, entry)
                    ---
                ---
            ---
        ---
        entry: next
    ---
return: c.LMX_ORPHAN_OK

fn: lmx_orphan_release (@: LmxOrphanLedger ledger; @: Lmx graph; @: LmxService service; @: LmxManager manager) int
    @: LmxOrphan entry
    @: LmxOrphan next
    if: ledger = 0
        return: c.LMX_ORPHAN_INVALID
    entry: ledger\head
    while: entry != 0
        next: entry\next
        lmx_orphan_free(ledger, graph, service, manager, entry)
        entry: next
    ---
    ledger\head: 0
    ledger\count: 0U
return: c.LMX_ORPHAN_OK
