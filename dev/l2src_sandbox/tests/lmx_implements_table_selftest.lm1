predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# D-105 (the author's Q39, 2026-09-27; steps/d105-index-table.md; Codex, 2026-09-28): the `implements`
# table of address correspondences -- a record is a view of its correspondence, never a Structure made
# for it: a static map (the native admission), an admitting frame's own size cells (the walk's
# ADMIT_AS), or the identity (with holes: a capture's copy in the type's own layout).  What this file
# pins:
#
#   * the first admission of a value to a named Structure it is not an instance of is the heavy
#     one: `Other` (b: int, a: size_t) admitted to `Model` (a: size_t, b: int) through the map
#     [1, 0] is recorded, and a field of Model is then read at the value's own slot for it;
#   * a later admission finds the record -- the same correspondence answers YES, another one
#     (the identity) NO: one value, one own type;
#   * a map that does not match the value field by field is refused and records nothing, and so
#     is a map of another width;
#   * a value with no record has no slot for Model -- never "slot j" by default;
#   * the identity (no map) is an instance of Model, read at Model's own slots;
#   * a frame's own size cells are a correspondence read in place: the record keeps the frame
#     and the offset, and answers what the cells hold;
#   * a capture's copy in Model's own layout with holes: a carried field is read at its slot, an
#     empty slot is never readable (item 738);
#   * a record never outlives its value or its frame: a revert takes back the value and its
#     record, and a collection pass that frees the storage drops the record in the same pass,
#     while one that keeps the storage keeps it;
#   * attach carries the donor's records;
#   * a copy -- a merge's graph copy of an admitted value, a clone of the admitting frame, a clone of a capture's copy --
#     brings no record: the copy is admitted where it is used, the original's record stays as it was.

[]: char schema_tokens 6

sub: it_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: it_check

# A Structure of two cells, in the order given: 0 = a size_t cell, 1 = an int cell.
fn: it_pair (@: LmxArena arena; int: first; int: second) @: Lmx
    @: Lmx s
    @: void x
    @: void y
    s: lmx_node_new_owned(arena)
    if: s = 0 || lmx_arena_refs_open_owned(arena, s, 2U) != 0
        return: 0
    ---
    x: lmx_size_new_owned(arena)
    if: first != 0
        x: lmx_int_new_owned(arena)
    ---
    y: lmx_size_new_owned(arena)
    if: second != 0
        y: lmx_int_new_owned(arena)
    ---
    if: x = 0 || y = 0 || lmx_arena_ref_store(s, 0U, x) != 0 || lmx_arena_ref_store(s, 1U, y) != 0
        return: 0
    ---
return: s

# Three fields for a two-step projection whose LAST target differs from its
# ordinal target: size_t, int, size_t.
fn: it_triple (@: LmxArena arena) @: Lmx
    @: Lmx s lmx_node_new_owned(arena)
    if: s = 0 || lmx_arena_refs_open_owned(arena, s, 3U) != 0
        return: 0
    ---
    if: lmx_arena_ref_store(s, 0U, lmx_size_new_owned(arena)) != 0 || lmx_arena_ref_store(s, 1U, lmx_int_new_owned(arena)) != 0 || lmx_arena_ref_store(s, 2U, lmx_size_new_owned(arena)) != 0
        return: 0
    ---
return: s

# A frame of three children: a filler, then two size cells t0 and t1 -- a correspondence at offset 1.
# The admitting frame of a width-2 model: slot 0 a placeholder, then the map's
# 2 * width cells -- the ORDINAL half (t0, t1) then the LAST half (t2, t3), the
# same flat layout the walker's ADMIT_AS carries (K01).
fn: it_frame (@: LmxArena arena; size_t: t0; size_t: t1; size_t: t2; size_t: t3) @: Lmx
    @: Lmx s
    @: void x
    @: void y
    @: void z
    @: void w
    s: lmx_node_new_owned(arena)
    if: s = 0 || lmx_arena_refs_open_owned(arena, s, 5U) != 0
        return: 0
    ---
    x: lmx_size_new_owned(arena)
    y: lmx_size_new_owned(arena)
    z: lmx_size_new_owned(arena)
    w: lmx_size_new_owned(arena)
    if: x = 0 || y = 0 || z = 0 || w = 0 || lmx_size_store_known(x, t0) != 0 || lmx_size_store_known(y, t1) != 0 || lmx_size_store_known(z, t2) != 0 || lmx_size_store_known(w, t3) != 0
        return: 0
    ---
    if: lmx_arena_ref_store(s, 0U, lmx_int_new_owned(arena)) != 0 || lmx_arena_ref_store(s, 1U, x) != 0 || lmx_arena_ref_store(s, 2U, y) != 0 || lmx_arena_ref_store(s, 3U, z) != 0 || lmx_arena_ref_store(s, 4U, w) != 0
        return: 0
    ---
return: s

# N4 `call: code data` (lmx_implements_places): the places of a code's names in the selected data come from a static
# table, its row chosen by the data's own layout token, never by a name and never by row order.  Table A has three
# rows for two names: token 1 -> (1, 0), token 2 -> (0, 1), token 3 -> (0, SIZE_MAX: the layout lacks the second
# name).  Table B maps one name of token 4 to slot 2, past a pair.  Table C has no name.
sub: it_places (@: int counts)
    LmxArena: parena
    @: LmxArena pa 0
    []: size_t ta 11
    []: size_t tb 4
    []: size_t tc 2
    []: size_t got 2
    @: Lmx d1 0
    @: Lmx d2 0
    @: Lmx d3 0
    @: Lmx d4 0
    @: Lmx d5 0
    @: Lmx bare 0
    memset((cast: (@: void) (@ parena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ parena) != 0
        it_check(counts, 0, "the places arena did not open")
        return
    ---
    pa: @ parena
    ta[0]: 2U
    ta[1]: 3U
    ta[2]: 1U
    ta[3]: 1U
    ta[4]: 0U
    ta[5]: 2U
    ta[6]: 0U
    ta[7]: 1U
    ta[8]: 3U
    ta[9]: 0U
    ta[10]: (cast: (size_t) -1)
    tb[0]: 1U
    tb[1]: 1U
    tb[2]: 4U
    tb[3]: 2U
    tc[0]: 0U
    tc[1]: 0U
    d1: it_pair(pa, 0, 1)
    d2: it_pair(pa, 0, 1)
    d3: it_pair(pa, 0, 1)
    d4: it_pair(pa, 0, 1)
    d5: it_pair(pa, 0, 1)
    bare: it_pair(pa, 0, 1)
    it_check(counts, d1 != 0 && d2 != 0 && d3 != 0 && d4 != 0 && d5 != 0 && bare != 0, "the places data could not be made")
    it_check(counts, lmx_implements_register_map(pa, d1, d1, 0, 0U, (cast: (@: void) (schema_tokens + 1))) = c.LMX_IMPLEMENTS_YES && lmx_implements_register_map(pa, d2, d2, 0, 0U, (cast: (@: void) (schema_tokens + 2))) = c.LMX_IMPLEMENTS_YES && lmx_implements_register_map(pa, d3, d3, 0, 0U, (cast: (@: void) (schema_tokens + 3))) = c.LMX_IMPLEMENTS_YES && lmx_implements_register_map(pa, d4, d4, 0, 0U, (cast: (@: void) (schema_tokens + 4))) = c.LMX_IMPLEMENTS_YES && lmx_implements_register_map(pa, d5, d5, 0, 0U, (cast: (@: void) (schema_tokens + 5))) = c.LMX_IMPLEMENTS_YES, "the places data did not record their layouts")
    got[0]: 77U
    got[1]: 77U
    it_check(counts, lmx_implements_places(pa, d1, schema_tokens, ta, got) = c.LMX_IMPLEMENTS_YES && got[0] = 1U && got[1] = 0U, "KP1: the first row's layout did not map its names to (1, 0)")
    got[0]: 77U
    got[1]: 77U
    it_check(counts, lmx_implements_places(pa, d2, schema_tokens, ta, got) = c.LMX_IMPLEMENTS_YES && got[0] = 0U && got[1] = 1U, "KP6: the row was not chosen by the data's own token")
    got[0]: 77U
    got[1]: 77U
    it_check(counts, lmx_implements_places(pa, d3, schema_tokens, ta, got) = c.LMX_IMPLEMENTS_NO && got[0] = 77U && got[1] = 77U, "KP2: a name the layout lacks was given a slot, or out was written")
    got[0]: 77U
    it_check(counts, lmx_implements_places(pa, d4, schema_tokens, tb, got) = c.LMX_IMPLEMENTS_UNKNOWN && got[0] = 77U, "KP3: a slot past the data was given, or taken for a missing place")
    got[0]: 77U
    it_check(counts, lmx_implements_places(pa, bare, schema_tokens, ta, got) = c.LMX_IMPLEMENTS_UNKNOWN && got[0] = 77U, "KP4: data with no layout token was mapped")
    got[0]: 77U
    it_check(counts, lmx_implements_places(pa, d5, schema_tokens, ta, got) = c.LMX_IMPLEMENTS_UNKNOWN && got[0] = 77U, "KP5: a layout with no row was mapped")
    got[0]: 77U
    it_check(counts, lmx_implements_places(pa, bare, schema_tokens, tc, got) = c.LMX_IMPLEMENTS_YES && lmx_implements_places(pa, d1, 0, tc, 0) = c.LMX_IMPLEMENTS_YES && got[0] = 77U, "KP7: a code with no names did not admit any data")
    it_check(counts, lmx_implements_places(pa, 0, schema_tokens, tc, got) = c.LMX_IMPLEMENTS_UNKNOWN && lmx_implements_places(pa, d1, schema_tokens, 0, got) = c.LMX_IMPLEMENTS_UNKNOWN, "KP8: no data or no table was answered")
    it_check(counts, lmx_implements_places(pa, d1, schema_tokens, ta, 0) = c.LMX_IMPLEMENTS_YES, "KP9: the admission alone (out 0) was refused")
    lmx_arena_release(pa)
end: it_places

# A layoutless payload can have a completed, non-positional admission to
# Source. Composing it with Source-to-Target must preserve both K01 halves and
# the hole outside this receiver's coverage; a later Consumer of that hole
# must still refuse. The temporary pair map is not kept as a borrowed pointer.
sub: it_composed_receiving (@: int counts)
    LmxArena: arena
    @: LmxArena at (@ arena)
    @: Lmx source 0
    @: Lmx target 0
    @: Lmx payload 0
    @: Lmx frame 0
    @: void cell 0
    LmxImplEntry: pair_view
    LmxImplUses: use_view
    []: size_t source_map 4
    []: size_t pair_map 6
    []: size_t good 4
    []: size_t bad 4
    size_t: hole (cast: (size_t) -1)
    size_t: slot 99U
    size_t: j 0U
    int: applied 0
    memset((cast: (@: void) at), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(at) != 0
        it_check(counts, 0, "the composition arena did not open")
        return
    ---
    source: it_pair(at, 0, 1)
    target: it_triple(at)
    payload: it_triple(at)
    if: source = 0 || target = 0 || payload = 0
        it_check(counts, 0, "the composition graphs were not made")
        lmx_arena_release(at)
        return
    ---
    source_map[0]: 2U
    source_map[1]: 1U
    source_map[2]: 0U
    source_map[3]: 1U
    pair_map[0]: 0U
    pair_map[1]: 1U
    pair_map[2]: hole
    pair_map[3]: 0U
    pair_map[4]: 1U
    pair_map[5]: hole
    good[0]: 4U
    good[1]: 1U
    good[2]: 3U
    good[3]: 0U
    bad[0]: 4U
    bad[1]: 1U
    bad[2]: 5U
    bad[3]: 0U
    it_check(counts, lmx_implements_register_map(at, source, source, 0, 0U, (cast: (@: void) (schema_tokens + 1))) = c.LMX_IMPLEMENTS_YES, "Source has no layout token")
    it_check(counts, lmx_implements_register_map_owned(at, payload, source, source_map, 2U, 0) = c.LMX_IMPLEMENTS_YES, "the nonidentity payload-to-Source map was not recorded")
    memset((cast: (@: void) (@ pair_view)), 0, c.sizeof(c.LmxImplEntry))
    pair_view.map: pair_map
    pair_view.n: 3U
    memset((cast: (@: void) (@ use_view)), 0, c.sizeof(c.LmxImplUses))
    use_view.map: good
    it_check(counts, lmx_implements_compose_receiving(at, payload, (cast: (@: void) (schema_tokens + 1)), target, @ pair_view, 1, @ use_view, @ applied) = c.LMX_IMPLEMENTS_YES && applied = 1, "a nonidentity source admission was not composed")
    slot: 99U
    it_check(counts, lmx_implements_slot(at, payload, target, 0U, @ slot) = 0 && slot = 2U && lmx_implements_slot(at, payload, target, 3U, @ slot) = 0 && slot = 0U && lmx_implements_slot(at, payload, target, 2U, @ slot) != 0, "composition lost ordinal, LAST, or hole")
    frame: lmx_node_new_owned(at)
    if: frame != 0 && lmx_arena_refs_open_owned(at, frame, 7U) = 0
        while: j < 6U
            cell: lmx_size_new_owned(at)
            if: cell = 0 || lmx_size_store_known(cell, pair_map[j]) != 0 || lmx_arena_ref_store(frame, j + 1U, cell) != 0
                break
            j: j + 1U
        ---
    ---
    it_check(counts, j = 6U, "the frame-backed pair map was not made")
    if: j = 6U
        pair_view.map: 0
        pair_view.frame: frame
        pair_view.at: 1U
        applied: 0
        it_check(counts, lmx_implements_compose_receiving(at, payload, (cast: (@: void) (schema_tokens + 1)), target, @ pair_view, 1, @ use_view, @ applied) = c.LMX_IMPLEMENTS_YES && applied = 1, "a frame-backed source pair did not compose to the same admitted map")
    ---
    pair_map[0]: 1U
    slot: 99U
    it_check(counts, lmx_implements_slot(at, payload, target, 0U, @ slot) = 0 && slot = 2U, "a completed map borrowed its temporary pair")
    use_view.map: bad
    it_check(counts, lmx_implements_receiving_use(at, payload, payload, target, 0, @ use_view) = c.LMX_IMPLEMENTS_NO, "a later Consumer read a composed hole")
    lmx_arena_release(at)
end: it_composed_receiving

# A full reception of a nested value cannot be inherited by a merge copy when
# absorb redirects that value's child to the result and a later operand changes
# the result's required field. The original remains admitted; the copy is a new
# graph and must answer the later Consumer from its own current structure.
sub: it_absorbed_reception (@: int counts)
    LmxArena: arena
    @: LmxArena at (@ arena)
    @: Lmx required_leaf 0
    @: Lmx required_holder 0
    @: Lmx source 0
    @: Lmx holder 0
    @: Lmx override 0
    @: Lmx compatible 0
    @: Lmx result 0
    @: Lmx compatible_result 0
    @: Lmx copied_holder 0
    @: Lmx compatible_holder 0
    @: Lmx mapped_result 0
    @: Lmx mapped_compatible_result 0
    @: Lmx mapped_holder 0
    @: Lmx mapped_compatible_holder 0
    []: @(Lmx) roots 2
    LmxMergePair: pair
    @: LmxMergePair pair_ptr (@ pair)
    int: status
    memset((cast: (@: void) at), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(at) != 0
        it_check(counts, 0, "the absorb-reception arena did not open")
        return
    ---
    required_leaf: lmx_node_new_owned(at)
    required_holder: lmx_node_new_owned(at)
    source: lmx_node_new_owned(at)
    holder: lmx_node_new_owned(at)
    override: lmx_node_new_owned(at)
    compatible: lmx_node_new_owned(at)
    if: required_leaf = 0 || required_holder = 0 || source = 0 || holder = 0 || override = 0 || compatible = 0 || lmx_arena_refs_open_owned(at, required_leaf, 1U) != 0 || lmx_arena_refs_open_owned(at, required_holder, 1U) != 0 || lmx_arena_refs_open_owned(at, source, 2U) != 0 || lmx_arena_refs_open_owned(at, holder, 1U) != 0 || lmx_arena_refs_open_owned(at, override, 1U) != 0 || lmx_arena_refs_open_owned(at, compatible, 1U) != 0
        it_check(counts, 0, "the absorb-reception structures were not made")
        lmx_arena_release(at)
        return
    ---
    it_check(counts, lmx_arena_ref_store(required_leaf, 0U, lmx_int_new_owned(at)) = 0 && lmx_arena_ref_store(required_holder, 0U, (cast: (@: void) required_leaf)) = 0 && lmx_arena_ref_store(source, 0U, lmx_int_new_owned(at)) = 0 && lmx_arena_ref_store(source, 1U, (cast: (@: void) holder)) = 0 && lmx_arena_ref_store(holder, 0U, (cast: (@: void) source)) = 0 && lmx_arena_ref_store(override, 0U, lmx_size_new_owned(at)) = 0 && lmx_arena_ref_store(compatible, 0U, lmx_int_new_owned(at)) = 0, "the absorb-reception graph was not linked")
    holder\parent: source
    roots[0]: source
    roots[1]: override
    pair.model_slot: 0U
    pair.operand: 1U
    pair.field: 0U
    it_check(counts, lmx_implements_register_map(at, holder, required_holder, 0, 0U, 0) = c.LMX_IMPLEMENTS_YES && lmx_implements_find(at, holder, required_holder)\reception_proof = 0, "the original nested value was not admitted by the map")
    status: lmx_merge_owned(roots, 2U, 0, at, at, @ pair_ptr, 1U, @ mapped_result)
    mapped_holder: 0
    if: status = LMX_MERGE_OK && mapped_result != 0
        mapped_holder: lmx_arena_ref_struct(mapped_result, 1U)
    ---
    it_check(counts, status = LMX_MERGE_OK && mapped_holder != 0 && lmx_arena_ref_struct(mapped_holder, 0U) = mapped_result, "the mapped holder was not redirected to the changed result")
    it_check(counts, mapped_holder != 0 && lmx_implements_register_map(at, mapped_holder, required_holder, 0, 0U, 0) = c.LMX_IMPLEMENTS_NO, "the copied holder inherited a stale map proof across a changed merge root")
    roots[1]: compatible
    status: lmx_merge_owned(roots, 2U, 0, at, at, @ pair_ptr, 1U, @ mapped_compatible_result)
    mapped_compatible_holder: 0
    if: status = LMX_MERGE_OK && mapped_compatible_result != 0
        mapped_compatible_holder: lmx_arena_ref_struct(mapped_compatible_result, 1U)
    ---
    it_check(counts, status = LMX_MERGE_OK && mapped_compatible_holder != 0 && lmx_arena_ref_struct(mapped_compatible_holder, 0U) = mapped_compatible_result && lmx_implements_register_map(at, mapped_compatible_holder, required_holder, 0, 0U, 0) = c.LMX_IMPLEMENTS_YES, "a compatible absorb could not reestablish its copied map proof")
    it_check(counts, lmx_implements_register_map(at, holder, required_holder, 0, 0U, 0) = c.LMX_IMPLEMENTS_YES, "merge changed the original holder's map proof")
    roots[1]: override
    it_check(counts, lmx_implements_admit_receiving(at, holder, required_holder, 0, 0) = c.LMX_IMPLEMENTS_YES && lmx_implements_find(at, holder, required_holder)\reception_proof = 2, "the original nested value was not fully admitted")
    status: lmx_merge_owned(roots, 2U, 0, at, at, @ pair_ptr, 1U, @ result)
    copied_holder: 0
    if: status = LMX_MERGE_OK && result != 0
        copied_holder: lmx_arena_ref_struct(result, 1U)
    ---
    it_check(counts, status = LMX_MERGE_OK && copied_holder != 0 && lmx_arena_ref_struct(copied_holder, 0U) = result && lmx_domain_type(at, lmx_arena_ref_value(result, 0U)) = c.LMX_TYPE_SIZE_T, "the copied holder was not redirected to the changed result")
    it_check(counts, copied_holder != 0 && lmx_implements_admit_receiving(at, copied_holder, required_holder, 0, 0) = c.LMX_IMPLEMENTS_NO, "the copied holder inherited a full proof across a changed merge root")
    roots[1]: compatible
    status: lmx_merge_owned(roots, 2U, 0, at, at, @ pair_ptr, 1U, @ compatible_result)
    compatible_holder: 0
    if: status = LMX_MERGE_OK && compatible_result != 0
        compatible_holder: lmx_arena_ref_struct(compatible_result, 1U)
    ---
    it_check(counts, status = LMX_MERGE_OK && compatible_holder != 0 && lmx_arena_ref_struct(compatible_holder, 0U) = compatible_result && lmx_implements_admit_receiving(at, compatible_holder, required_holder, 0, 0) = c.LMX_IMPLEMENTS_YES, "a compatible absorb could not reestablish its copied reception")
    it_check(counts, lmx_implements_admit_receiving(at, holder, required_holder, 0, 0) = c.LMX_IMPLEMENTS_YES, "merge changed the original holder's reception")
    lmx_arena_release(at)
end: it_absorbed_reception

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: arena
    LmxArena: donor
    LmxArena: fresh_arena
    LmxImplEntry: view
    @: LmxImplEntry v 0
    @: LmxArena ea 0
    @: Lmx hmodel 0
    @: Lmx half 0
    @: Lmx fmodel 0
    @: Lmx fvalue 0
    @: Lmx frame 0
    @: Lmx ocopy 0
    @: Lmx cloned 0
    @: Lmx fclone 0
    @: Lmx hclone 0
    @: Lmx filler 0
    @: LmxPool fpool 0
    @: LmxChunk fchunk 0
    int: fill_n 0
    unsigned: egen
    @: LmxArena at 0
    @: LmxArena dn 0
    @: Lmx model 0
    @: Lmx other 0
    @: Lmx other2 0
    @: Lmx own 0
    @: Lmx late 0
    @: Lmx lent 0
    @: Lmx dmodel 0
    @: Lmx idecl 0
    @: Lmx ilong 0
    @: Lmx iletter 0
    @: Lmx inone 0
    @: Lmx iperm 0
    @: Lmx ihole 0
    @: Lmx owned_model 0
    @: Lmx owned_value 0
    @: Lmx composed_value 0
    @: Lmx composed_last 0
    @: Lmx cross_source_copy 0
    @: Lmx cross_result 0
    @: Lmx merged_once 0
    @: Lmx merged_twice 0
    @: Lmx merge_extra 0
    []: @(Lmx) merge_operands 2
    int: merge_status
    @: Lmx owned_wrapper 0
    @: Lmx owned_copy 0
    @: Lmx owned_model_copy 0
    @: Lmx owned_value_copy 0
    @: LmxImplEntry owned_entry 0
    # A correspondence map carries 2 * width cells (K01): the ORDINAL half (the value's
    # field named as the required model's field j), then the LAST half (what a bare name
    # reads).  `wide` stays a map of another width, which registration refuses.
    []: size_t perm 4
    []: size_t wrong 4
    []: size_t wide 3
    []: size_t dmap 4
    []: size_t computed_map 4
    []: size_t last_map 4
    @: LmxArenaBlock mark 0
    size_t: slot 99U
    size_t: kept 0U
    unsigned: gen
    int: failures
    if: counts = 0
        return: 2
    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ donor)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0 || lmx_arena_open(@ donor) != 0
        fputs("lmx_implements_table: the arena did not open\n", l1_stdout())
        free(counts)
        return: 2
    ---
    at: @ arena
    dn: @ donor
    perm[0]: 1U
    perm[1]: 0U
    perm[2]: 1U
    perm[3]: 0U
    wrong[0]: 0U
    wrong[1]: 1U
    wrong[2]: 0U
    wrong[3]: 1U
    wide[0]: 1U
    wide[1]: 0U
    wide[2]: 0U
    dmap[0]: 1U
    dmap[1]: 0U
    dmap[2]: 1U
    dmap[3]: 0U
    # Model (a: size_t, b: int); Other permutes them (b: int, a: size_t).
    model: it_pair(at, 0, 1)
    other: it_pair(at, 1, 0)
    other2: it_pair(at, 1, 0)
    own: it_pair(at, 0, 1)
    if: model = 0 || other = 0 || other2 = 0 || own = 0
        free(counts)
        return: 2
    ---

    # The heavy first admission, then a read through the record.
    it_check(counts, lmx_implements_register_map(at, other, model, perm, 2U, 0) = c.LMX_IMPLEMENTS_YES, "Other through [1, 0] was not admitted to Model")
    it_check(counts, lmx_implements_slot(at, other, model, 0U, @ slot) = 0 && slot = 1U, "Model's field a is not read at Other's slot 1")
    it_check(counts, lmx_implements_slot(at, other, model, 1U, @ slot) = 0 && slot = 0U, "Model's field b is not read at Other's slot 0")
    # The LAST half: edge width + j is the bare-name read of field j (K01).
    it_check(counts, lmx_implements_slot(at, other, model, 2U, @ slot) = 0 && slot = 1U, "Model's field a is not read at Other's slot 1 as its last occurrence")
    it_check(counts, lmx_implements_slot(at, other, model, 3U, @ slot) = 0 && slot = 0U, "Model's field b is not read at Other's slot 0 as its last occurrence")
    it_check(counts, lmx_implements_slot(at, other, model, 4U, @ slot) != 0, "an edge past 2 * Model's width got a slot")
    # A later admission takes the record: the same correspondence answers, another is refused.
    it_check(counts, lmx_implements_register_map(at, other, model, perm, 2U, 0) = c.LMX_IMPLEMENTS_YES, "a later admission with the same correspondence was refused")
    it_check(counts, lmx_implements_register_map(at, other, model, 0, 0U, 0) = c.LMX_IMPLEMENTS_NO, "the same value answered Model through a second correspondence")
    it_check(counts, at\impl_len = 1U, "a later admission added a record")
    it_check(counts, lmx_implements_layout(at, other) = 0, "unknown layout was inferred from the required model or permutation")
    it_check(counts, lmx_implements_register_map(at, other, model, perm, 2U, (cast: (@: void) (schema_tokens + 1))) = c.LMX_IMPLEMENTS_YES && lmx_implements_layout(at, other) = (cast: (@: void) (schema_tokens + 1)), "genuine layout evidence did not enrich the same completed map")
    it_check(counts, lmx_implements_register_map(at, other, model, perm, 2U, 0) = c.LMX_IMPLEMENTS_YES && lmx_implements_layout(at, other) = (cast: (@: void) (schema_tokens + 1)), "unknown evidence erased a known layout")
    it_check(counts, lmx_implements_register_map(at, other, model, perm, 2U, (cast: (@: void) (schema_tokens + 0))) = c.LMX_IMPLEMENTS_NO && lmx_implements_layout(at, other) = (cast: (@: void) (schema_tokens + 1)) && at\impl_len = 1U, "contradictory layout evidence changed a completed proof")
    it_check(counts, lmx_implements_register_map(at, other, other, 0, 0U, (cast: (@: void) (schema_tokens + 0))) = c.LMX_IMPLEMENTS_NO && lmx_implements_find(at, other, other) = 0 && at\impl_len = 1U, "a different required model admitted contradictory schema evidence")
    it_check(counts, lmx_implements_register_map(at, other, other, 0, 0U, (cast: (@: void) (schema_tokens + 1))) = c.LMX_IMPLEMENTS_YES && lmx_implements_layout(at, other) = (cast: (@: void) (schema_tokens + 1)), "a second correspondence lost the held value's schema identity")
    # A map that does not match field by field: refused, nothing recorded.
    it_check(counts, lmx_implements_register_map(at, other2, model, wrong, 2U, 0) = c.LMX_IMPLEMENTS_NO, "a map that reads an int as a size_t was admitted")
    it_check(counts, lmx_implements_find(at, other2, model) = 0, "a refused admission left a record")
    it_check(counts, lmx_implements_register_map(at, other2, model, wide, 3U, 0) = c.LMX_IMPLEMENTS_NO, "a map of another width was admitted")
    # The identity reads Other2 at Model's own slots only if it IS Model -- it is not.
    it_check(counts, lmx_implements_register_map(at, other2, model, 0, 0U, 0) = c.LMX_IMPLEMENTS_NO, "Other admitted to Model as its own type")
    # No record, no slot: never "slot j" by default.
    slot: 99U
    it_check(counts, lmx_implements_slot(at, other2, model, 0U, @ slot) != 0 && slot = 99U, "a value with no record was given a slot")
    # The identity: an instance of Model, read at Model's own slots.
    it_check(counts, lmx_implements_register_map(at, own, model, 0, 0U, (cast: (@: void) (schema_tokens + 2))) = c.LMX_IMPLEMENTS_YES, "an instance of Model was not admitted to Model")
    it_check(counts, lmx_implements_layout(at, own) = (cast: (@: void) (schema_tokens + 2)) && lmx_implements_layout(at, own) != (cast: (@: void) (schema_tokens + 0)), "identity correspondence replaced the true layout with req")
    it_check(counts, lmx_implements_slot(at, own, model, 1U, @ slot) = 0 && slot = 1U, "an instance of Model is not read at Model's slots")
    it_check(counts, lmx_implements_register_map(at, own, model, perm, 2U, 0) = c.LMX_IMPLEMENTS_NO, "an instance of Model answered Model through a permutation")
    it_check(counts, lmx_implements_is_map(at, lmx_implements_find(at, other, model), perm, 2U) != 0 && lmx_implements_is_map(at, lmx_implements_find(at, other, model), 0, 2U) = 0, "a record does not compare with the static map it was made with")

    # A revert takes back the value built after the mark, and its record with it.
    kept: at\impl_len
    mark: lmx_arena_mark(at)
    late: it_pair(at, 1, 0)
    it_check(counts, late != 0 && lmx_implements_register_map(at, late, model, perm, 2U, 0) = c.LMX_IMPLEMENTS_YES, "a value built after the mark was not admitted")
    it_check(counts, at\impl_len = kept + 1U, "the admission after the mark was not recorded")
    lmx_arena_revert(at, mark)
    it_check(counts, lmx_implements_find(at, late, model) = 0, "a record outlived the revert of its value")
    it_check(counts, at\impl_len = kept && lmx_implements_find(at, other, model) != 0 && lmx_implements_find(at, own, model) != 0, "a revert dropped a record of a value it did not take back")

    # Module metadata is not graph-owned: reverting an unrelated descriptor
    # must not classify the token or discard a live value's correspondence.
    mark: lmx_arena_mark(at)
    late: it_pair(at, 1, 0)
    it_check(counts, lmx_implements_register_map(at, other2, model, perm, 2U, (cast: (@: void) (schema_tokens + 1))) = c.LMX_IMPLEMENTS_YES, "token-bearing record was not admitted")
    lmx_arena_revert(at, mark)
    it_check(counts, lmx_implements_find(at, other2, model) != 0 && lmx_implements_layout(at, other2) = (cast: (@: void) (schema_tokens + 1)) && at\impl_len = kept + 1U, "revert classified or freed module schema metadata")

    # Attach carries the donor's records.
    dmodel: it_pair(dn, 0, 1)
    lent: it_pair(dn, 1, 0)
    if: dmodel = 0 || lent = 0
        free(counts)
        return: 2
    ---
    it_check(counts, lmx_implements_register_map(dn, lent, dmodel, 0, 0U, 0) = c.LMX_IMPLEMENTS_NO, "the donor admitted Other to Model as its own type")
    it_check(counts, lmx_implements_register_map(dn, lent, dmodel, dmap, 2U, (cast: (@: void) (schema_tokens + 1))) = c.LMX_IMPLEMENTS_YES, "the donor did not admit Other through [1, 0]")
    kept: at\impl_len
    it_check(counts, lmx_arena_attach(at, dn) = 0, "attach refused")
    it_check(counts, at\impl_len = kept + 1U && dn\impl_len = 0U && dn\impl = 0, "attach did not carry the donor's record")
    it_check(counts, lmx_implements_slot(at, lent, dmodel, 0U, @ slot) = 0 && slot = 1U, "the carried record does not answer in the receiving arena")
    it_check(counts, lmx_implements_layout(at, lent) = (cast: (@: void) (schema_tokens + 1)), "attach lost the exact layout witness")

    # A collection pass that keeps the storage keeps the records ...
    kept: at\impl_len
    gen: lmx_arena_generation_next(at)
    lmx_gc_mark_value(at, (cast: (@: void) model), gen, 0)
    lmx_gc_mark_value(at, (cast: (@: void) other), gen, 0)
    lmx_gc_mark_value(at, (cast: (@: void) other2), gen, 0)
    lmx_gc_mark_value(at, (cast: (@: void) own), gen, 0)
    lmx_gc_mark_value(at, (cast: (@: void) lent), gen, 0)
    lmx_gc_mark_value(at, (cast: (@: void) dmodel), gen, 0)
    it_check(counts, lmx_gc_sweep(at, gen) = c.LMX_GC_OK, "the keeping sweep failed")
    it_check(counts, at\impl_len = kept && lmx_implements_find(at, other, model) != 0, "a record of a kept value left in the sweep")
    it_check(counts, lmx_implements_slot(at, other, model, 0U, @ slot) = 0 && slot = 1U, "a kept record does not read its static map after the sweep")
    # ... and one that frees it drops them in the same pass.
    gen: lmx_arena_generation_next(at)
    it_check(counts, lmx_gc_sweep(at, gen) = c.LMX_GC_OK, "the freeing sweep failed")
    it_check(counts, at\impl_len = 0U, "a record outlived the sweep that freed its value")
    # The table is keyed by address alone: a Structure made later at a freed address must find
    # nothing there -- asked with the freed addresses themselves, which is exactly what such a
    # Structure would ask with (a lookup reads no cell of the value).
    slot: 99U
    it_check(counts, lmx_implements_slot(at, own, model, 1U, @ slot) != 0 && slot = 99U, "a freed address still answers Model as Model's own")
    it_check(counts, lmx_implements_slot(at, other, model, 0U, @ slot) != 0 && slot = 99U, "a freed address still answers Model through the old map")

    # A frame's own size cells, read in place: Other admitted to Model through the cells [1, 0] of a
    # frame at offset 1.  The record keeps the frame: a later change of a cell is what it answers.
    memset((cast: (@: void) (@ fresh_arena)), 0, c.sizeof(c.LmxArena))
    ea: @ fresh_arena
    if: lmx_arena_open(ea) != 0
        free(counts)
        return: 2
    ---
    v: @ view
    fmodel: it_pair(ea, 0, 1)
    fvalue: it_pair(ea, 1, 0)
    # The frame in a chunk of its own, after the value's: fillers close the value's chunk, so a pass that
    # reaches the value and not the frame frees the frame alone.
    fpool: lmx_range_pool(ea, (cast: (@: void) fvalue))
    fchunk: lmx_pool_chunk_at(fpool, (cast: (@: void) fvalue))
    filler: fvalue
    fill_n: 0
    while: fill_n < 100000 && filler != 0 && lmx_pool_chunk_at(fpool, (cast: (@: void) filler)) = fchunk
        filler: lmx_node_new_owned(ea)
        fill_n: fill_n + 1
    ---
    frame: it_frame(ea, 1U, 0U, 1U, 0U)
    if: fmodel = 0 || fvalue = 0 || frame = 0 || filler = 0
        free(counts)
        return: 2
    ---
    it_check(counts, lmx_pool_chunk_at(fpool, (cast: (@: void) frame)) != fchunk, "the frame shares a chunk with its value -- the frame's pass cannot be seen here")
    memset((cast: (@: void) v), 0, c.sizeof(c.LmxImplEntry))
    v\frame: frame
    v\at: 1U
    v\n: 2U
    it_check(counts, lmx_implements_register(ea, fvalue, fmodel, v) = c.LMX_IMPLEMENTS_YES, "Other through a frame's cells [1, 0] was not admitted to Model")
    it_check(counts, lmx_implements_slot(ea, fvalue, fmodel, 0U, @ slot) = 0 && slot = 1U, "Model's field a is not read through the frame's cell")
    it_check(counts, lmx_implements_is_map(ea, lmx_implements_find(ea, fvalue, fmodel), perm, 2U) != 0, "a frame's cells and the equal static map are not one correspondence")
    memset((cast: (@: void) v), 0, c.sizeof(c.LmxImplEntry))
    v\frame: frame
    v\at: 1U
    v\n: 3U
    it_check(counts, lmx_implements_register(ea, it_pair(ea, 1, 0), fmodel, v) = c.LMX_IMPLEMENTS_NO, "a frame view of another width was admitted")
    # A keeping pass keeps the frame's record; a pass that frees the frame drops it with the frame.
    egen: lmx_arena_generation_next(ea)
    lmx_gc_mark_value(ea, (cast: (@: void) fmodel), egen, 0)
    lmx_gc_mark_value(ea, (cast: (@: void) fvalue), egen, 0)
    lmx_gc_mark_value(ea, (cast: (@: void) frame), egen, 0)
    it_check(counts, lmx_gc_sweep(ea, egen) = c.LMX_GC_OK && lmx_implements_find(ea, fvalue, fmodel) != 0, "a record whose value and frame live left in the sweep")
    egen: lmx_arena_generation_next(ea)
    lmx_gc_mark_value(ea, (cast: (@: void) fmodel), egen, 0)
    lmx_gc_mark_value(ea, (cast: (@: void) fvalue), egen, 0)
    it_check(counts, lmx_gc_sweep(ea, egen) = c.LMX_GC_OK && lmx_implements_find(ea, fvalue, fmodel) = 0, "a record outlived the sweep that freed its frame")

    # Item 738: a capture's copy in Model's own layout with holes -- half holds b alone, at Model's
    # slot 1, slot 0 empty.  The heavy check passes; b is read at slot 1; a read of the empty slot a is
    # refused, never taken as present.
    hmodel: it_pair(ea, 0, 1)
    half: lmx_node_new_owned(ea)
    if: hmodel = 0 || half = 0 || lmx_arena_refs_open_owned(ea, half, 2U) != 0 || lmx_arena_ref_store(half, 1U, lmx_int_new_owned(ea)) != 0
        free(counts)
        return: 2
    ---
    memset((cast: (@: void) v), 0, c.sizeof(c.LmxImplEntry))
    v\holes: 1
    v\layout: (cast: (@: void) (schema_tokens + 3))
    it_check(counts, lmx_implements_register(ea, half, hmodel, v) = c.LMX_IMPLEMENTS_YES, "a copy of the read fields alone was not admitted in its type's layout")
    it_check(counts, lmx_implements_layout(ea, half) = (cast: (@: void) (schema_tokens + 3)), "fresh capture did not retain its explicit schema token")
    slot: 99U
    it_check(counts, lmx_implements_slot(ea, half, hmodel, 1U, @ slot) = 0 && slot = 1U, "a carried field is not read at its type's slot")
    slot: 99U
    it_check(counts, lmx_implements_slot(ea, half, hmodel, 0U, @ slot) != 0 && slot = 99U, "an empty slot of a copy was readable")
    it_check(counts, lmx_implements_register_map(ea, half, hmodel, 0, 0U, 0) = c.LMX_IMPLEMENTS_NO, "a copy with holes answered its type as the plain identity")
    it_check(counts, lmx_implements_register(ea, half, half, v) = c.LMX_IMPLEMENTS_YES, "a partial value could not record its own holes")
    slot: 99U
    it_check(counts, lmx_implements_exec_slot(ea, half, 0U, @ slot) != 0 && lmx_implements_exec_slot(ea, half, 2U, @ slot) != 0 && slot = 99U, "an unprojected execution read an absent field through its self-view")
    slot: 99U
    it_check(counts, lmx_implements_exec_slot(ea, half, 1U, @ slot) = 0 && slot = 1U, "an unprojected execution lost a carried field")
    computed_map[0]: 0U
    computed_map[1]: 1U
    computed_map[2]: 0U
    computed_map[3]: 1U
    it_check(counts, lmx_implements_exec_register(ea, half, half, computed_map, 2U) = c.LMX_IMPLEMENTS_YES, "a partial self-body could not keep its own execution map")
    slot: 99U
    it_check(counts, lmx_implements_exec_slot(ea, half, 0U, @ slot) != 0 && lmx_implements_exec_slot(ea, half, 2U, @ slot) != 0 && slot = 99U, "an execution projection made an absent self-field readable")

    # Merge / clone copying: the graph copy of an admitted value is another value -- no record comes with it, so it is
    # never read at "slot j" by default, and its own admission is the heavy one again; the original keeps its record.
    ocopy: it_pair(ea, 1, 0)
    it_check(counts, ocopy != 0 && lmx_implements_register_map(ea, ocopy, fmodel, perm, 2U, (cast: (@: void) (schema_tokens + 1))) = c.LMX_IMPLEMENTS_YES, "the value to copy was not admitted")
    it_check(counts, lmx_graph_copy_owned(ocopy, ea, ea, @ cloned) = 0 && cloned != 0 && cloned != ocopy, "the graph copy of an admitted value failed")
    slot: 99U
    it_check(counts, lmx_implements_find(ea, cloned, fmodel) = 0 && lmx_implements_slot(ea, cloned, fmodel, 0U, @ slot) != 0 && slot = 99U, "a copy of an admitted value carried its record")
    it_check(counts, lmx_implements_layout(ea, cloned) = 0 && lmx_implements_layout(ea, ocopy) = (cast: (@: void) (schema_tokens + 1)), "copy inherited or changed source provenance")
    it_check(counts, lmx_implements_slot(ea, ocopy, fmodel, 0U, @ slot) = 0 && slot = 1U, "copying a value disturbed the original's record")
    it_check(counts, lmx_implements_register_map(ea, cloned, fmodel, perm, 2U, 0) = c.LMX_IMPLEMENTS_YES && lmx_implements_slot(ea, cloned, fmodel, 0U, @ slot) = 0 && slot = 1U, "a copy was not admitted on its own")
    # A clone of the admitting frame.  The sweep above freed the first frame with its record, so Other is admitted
    # again through a new one.  The clone's equal cells are the same correspondence (same_map through the accessor):
    # an admission through them answers.  The record reads the frame it was made with: a different correspondence
    # written into the clone's cell does not reach it.
    frame: it_frame(ea, 1U, 0U, 1U, 0U)
    memset((cast: (@: void) v), 0, c.sizeof(c.LmxImplEntry))
    v\frame: frame
    v\at: 1U
    v\n: 2U
    it_check(counts, frame != 0 && lmx_implements_register(ea, fvalue, fmodel, v) = c.LMX_IMPLEMENTS_YES, "Other was not admitted again through a new frame")
    it_check(counts, lmx_graph_copy_owned(frame, ea, ea, @ fclone) = 0 && fclone != 0 && fclone != frame, "the admitting frame could not be cloned")
    slot: 99U
    it_check(counts, lmx_implements_slot(ea, fvalue, fmodel, 0U, @ slot) = 0 && slot = 1U, "cloning the frame changed the record's reading")
    memset((cast: (@: void) v), 0, c.sizeof(c.LmxImplEntry))
    v\frame: fclone
    v\at: 1U
    v\n: 2U
    it_check(counts, lmx_implements_register(ea, fvalue, fmodel, v) = c.LMX_IMPLEMENTS_YES, "the clone's equal cells were not the same correspondence")
    it_check(counts, lmx_size_store_known(lmx_arena_ref_value(fclone, 1U), 0U) = 0 && lmx_size_store_known(lmx_arena_ref_value(fclone, 2U), 1U) = 0, "the clone's cells could not be written")
    slot: 99U
    it_check(counts, lmx_implements_slot(ea, fvalue, fmodel, 0U, @ slot) = 0 && slot = 1U, "a write into the clone's cell reached the original frame's record")
    it_check(counts, lmx_implements_register(ea, fvalue, fmodel, v) = c.LMX_IMPLEMENTS_NO, "the clone's changed cells were taken as the recorded correspondence")
    # A clone of a capture's copy: no holes record -- its empty slot stays unreadable, and its carried one too until
    # it is admitted itself.
    it_check(counts, lmx_graph_copy_owned(half, ea, ea, @ hclone) = 0 && hclone != 0 && hclone != half, "the capture's copy could not be cloned")
    slot: 99U
    it_check(counts, lmx_implements_slot(ea, hclone, hmodel, 1U, @ slot) != 0 && lmx_implements_slot(ea, hclone, hmodel, 0U, @ slot) != 0 && slot = 99U, "a clone of a capture's copy was readable without an admission")
    memset((cast: (@: void) v), 0, c.sizeof(c.LmxImplEntry))
    v\holes: 1
    it_check(counts, lmx_implements_register(ea, hclone, hmodel, v) = c.LMX_IMPLEMENTS_YES && lmx_implements_slot(ea, hclone, hmodel, 1U, @ slot) = 0 && slot = 1U && lmx_implements_slot(ea, hclone, hmodel, 0U, @ slot) != 0, "the clone admitted with holes does not read as the copy")

    # The record of a reception by position (TYPED-PLACE-LETTER-READMISSION).  D is (a: size_t, b: int) with its
    # own record and token 4; R has the same fields in the other order, token 5.  A value with no layout of its
    # own received into a place of D by position has a record with neither frame nor map: lmx_implements_identity
    # finds it by D's token.  Nothing else answers.
    idecl: it_pair(ea, 0, 1)
    ilong: it_pair(ea, 1, 0)
    iletter: it_pair(ea, 0, 1)
    inone: it_pair(ea, 0, 1)
    iperm: it_pair(ea, 1, 0)
    ihole: it_pair(ea, 0, 1)
    if: idecl = 0 || ilong = 0 || iletter = 0 || inone = 0 || iperm = 0 || ihole = 0
        free(counts)
        return: 2
    ---
    it_check(counts, lmx_implements_register_map(ea, idecl, idecl, 0, 0U, (cast: (@: void) (schema_tokens + 4))) = c.LMX_IMPLEMENTS_YES && lmx_implements_register_map(ea, ilong, ilong, 0, 0U, (cast: (@: void) (schema_tokens + 5))) = c.LMX_IMPLEMENTS_YES, "a declaration did not register its own layout")
    it_check(counts, lmx_implements_identity(ea, iletter, (cast: (@: void) (schema_tokens + 4))) = 0, "a value received nowhere was identical with a declaration")
    it_check(counts, lmx_implements_register_map(ea, iletter, idecl, 0, 0U, 0) = c.LMX_IMPLEMENTS_YES, "a value laid out as D was not received into D by position")
    it_check(counts, lmx_implements_identity(ea, iletter, (cast: (@: void) (schema_tokens + 4))) = 1, "the record of a reception by position was not found by the declaration's token")
    it_check(counts, lmx_implements_layout(ea, iletter) = 0, "asking for the identity gave the value a layout")
    it_check(counts, lmx_implements_identity(ea, iletter, (cast: (@: void) (schema_tokens + 5))) = 0, "identity with D answered for another declaration")
    it_check(counts, lmx_implements_identity(ea, inone, (cast: (@: void) (schema_tokens + 4))) = 0, "a value with no record answered: the declaration's own record certifies no other value")
    it_check(counts, lmx_implements_identity(ea, iletter, 0) = 0 && lmx_implements_identity(ea, 0, (cast: (@: void) (schema_tokens + 4))) = 0, "a null token or a null value answered")
    it_check(counts, lmx_implements_identity(ea, idecl, (cast: (@: void) (schema_tokens + 4))) = 0, "the declaration's own record was taken for its identity with itself")
    # A value admitted through a map is not identical by position; neither is a copy with holes.
    it_check(counts, lmx_implements_register_map(ea, iperm, idecl, perm, 2U, 0) = c.LMX_IMPLEMENTS_YES && lmx_implements_identity(ea, iperm, (cast: (@: void) (schema_tokens + 4))) = 0, "a value admitted through a map was identical by position")
    memset((cast: (@: void) v), 0, c.sizeof(c.LmxImplEntry))
    v\holes: 1
    it_check(counts, lmx_implements_register(ea, ihole, idecl, v) = c.LMX_IMPLEMENTS_YES && lmx_implements_identity(ea, ihole, (cast: (@: void) (schema_tokens + 4))) = 0, "a copy with holes was identical by position")
    # What the admitting text does with it: R's fields through the pair map D -> R, the value's layout unknown as
    # before, and the same admission again answered from the records.
    it_check(counts, lmx_implements_register_map(ea, iletter, ilong, perm, 2U, 0) = c.LMX_IMPLEMENTS_YES, "the value was not admitted to R through D's record and the pair map")
    slot: 99U
    it_check(counts, lmx_implements_slot(ea, iletter, ilong, 0U, @ slot) = 0 && slot = 1U && lmx_implements_slot(ea, iletter, ilong, 1U, @ slot) = 0 && slot = 0U, "R's fields are not read at D's places in the value")
    it_check(counts, lmx_implements_layout(ea, iletter) = 0, "the admission through an identity published a layout")
    it_check(counts, lmx_implements_register_map(ea, iletter, ilong, perm, 2U, 0) = c.LMX_IMPLEMENTS_YES && lmx_implements_identity(ea, iletter, (cast: (@: void) (schema_tokens + 4))) = 1, "a second admission did not answer from the records")

    # A correspondence calculated during merge must not borrow the merge's temporary buffer.
    # Copying both endpoints as nested nodes carries an independent record and map; a copy root
    # deliberately gets no old admission because its receiving operation must admit it anew.
    owned_model: it_pair(ea, 0, 1)
    owned_value: it_pair(ea, 1, 0)
    computed_map[0]: 1U
    computed_map[1]: 0U
    computed_map[2]: 1U
    computed_map[3]: 0U
    it_check(counts, owned_model != 0 && owned_value != 0 && lmx_implements_register_map_owned(ea, owned_value, owned_model, computed_map, 2U, 0) = c.LMX_IMPLEMENTS_YES, "a runtime-computed map was not admitted")
    owned_entry: lmx_implements_find(ea, owned_value, owned_model)
    it_check(counts, owned_entry != 0 && owned_entry\owned_map != 0 && owned_entry\map != computed_map, "a runtime-computed map borrowed its caller's buffer")
    computed_map[0]: 0U
    slot: 99U
    it_check(counts, lmx_implements_slot(ea, owned_value, owned_model, 0U, @ slot) = 0 && slot = 1U, "changing the caller's temporary map changed the recorded address")
    computed_map[0]: 1U
    slot: 99U
    it_check(counts, lmx_implements_exec_slot(at, owned_value, 0U, @ slot) != 0 && slot = 99U, "an occurrence outside the given arena silently got an identity layout")
    slot: 99U
    it_check(counts, lmx_implements_exec_slot(ea, owned_value, 2U, @ slot) = 0 && slot = 0U, "an unprojected self-view lost its LAST identity half")
    it_check(counts, lmx_implements_exec_register(ea, owned_value, owned_model, computed_map, 2U) = c.LMX_IMPLEMENTS_YES, "a selected body's address projection was not proved and stored")
    slot: 99U
    it_check(counts, lmx_implements_exec_slot(ea, owned_value, 0U, @ slot) = 0 && slot = 1U, "selected code's first field did not reach its value's physical slot")
    slot: 99U
    it_check(counts, lmx_implements_exec_slot(ea, owned_value, 2U, @ slot) = 0 && slot = computed_map[2], "selected code's LAST edge did not use the second half of its proof")
    slot: 99U
    it_check(counts, lmx_implements_slot(ea, owned_value, owned_value, 0U, @ slot) = 0 && slot = 0U, "execution projection changed the ordinary self-view")
    computed_map[0]: 0U
    slot: 99U
    it_check(counts, lmx_implements_exec_slot(ea, owned_value, 0U, @ slot) = 0 && slot = 1U, "execution projection borrowed the caller's temporary map")
    computed_map[0]: 1U
    # The source already executes code in a permuted layout. A second admitted
    # value reverses that permutation. The completed code-to-result projection
    # is therefore identity, without requiring a new name lookup or graph.
    composed_value: it_pair(ea, 0, 1)
    it_check(counts, composed_value != 0 && lmx_implements_register_map_owned(ea, composed_value, owned_value, computed_map, 2U, 0) = c.LMX_IMPLEMENTS_YES, "a second merge value was not admitted to its selected source")
    it_check(counts, lmx_implements_exec_compose(ea, composed_value, owned_value) = c.LMX_IMPLEMENTS_YES, "two proved address maps did not compose")
    slot: 99U
    it_check(counts, lmx_implements_code_slot(ea, composed_value, owned_value, 0U, @ slot) = 0 && slot = 0U && lmx_implements_code_index(ea, composed_value, owned_value, 2U) = 0U, "a distinct data value ignored its code's earlier execution projection")
    slot: 99U
    it_check(counts, lmx_implements_exec_slot(ea, composed_value, 0U, @ slot) = 0 && slot = 0U && lmx_implements_exec_slot(ea, composed_value, 1U, @ slot) = 0 && slot = 1U, "composed ordinal edges did not reach result slots")
    slot: 99U
    it_check(counts, lmx_implements_exec_slot(ea, composed_value, 2U, @ slot) = 0 && slot = 0U && lmx_implements_exec_slot(ea, composed_value, 3U, @ slot) = 0 && slot = 1U, "composed LAST edges did not reach result slots")
    it_check(counts, lmx_implements_exec_compose(ea, composed_value, owned_value) = c.LMX_IMPLEMENTS_YES && lmx_implements_exec_compose(at, composed_value, owned_value) != c.LMX_IMPLEMENTS_YES, "a repeated or foreign-arena address composition was mishandled")
    # For the second result, only a bare name should reach the later size_t
    # field. A one-half composition would incorrectly keep slot zero.
    composed_last: it_triple(ea)
    last_map[0]: 1U
    last_map[1]: 0U
    last_map[2]: 1U
    last_map[3]: 2U
    it_check(counts, composed_last != 0 && lmx_implements_register_map_owned(ea, composed_last, owned_value, last_map, 2U, 0) = c.LMX_IMPLEMENTS_YES, "the result with a distinct LAST field was not admitted")
    it_check(counts, lmx_implements_exec_compose(ea, composed_last, owned_value) = c.LMX_IMPLEMENTS_YES, "the distinct LAST address map did not compose")
    it_check(counts, lmx_implements_code_index(ea, composed_last, owned_value, 0U) = 0U && lmx_implements_code_index(ea, composed_last, owned_value, 2U) = 2U, "a distinct code/data call collapsed ordinal and LAST composition")
    slot: 99U
    it_check(counts, lmx_implements_exec_slot(ea, composed_last, 0U, @ slot) = 0 && slot = 0U && lmx_implements_exec_slot(ea, composed_last, 2U, @ slot) = 0 && slot = 2U, "composed code lost the distinction between ordinal and LAST")
    # The graph copier does not hand the new root its old self admission.
    # Compose the original source's proved execution edges through the actual
    # copied root's new admission to a result in another arena.
    it_check(counts, lmx_graph_copy_owned(owned_value, ea, dn, @ cross_source_copy) = 0 && cross_source_copy != 0, "the selected source could not be copied into another arena")
    cross_result: it_triple(dn)
    it_check(counts, cross_result != 0 && lmx_implements_register_map_owned(dn, cross_result, cross_source_copy, last_map, 2U, 0) = c.LMX_IMPLEMENTS_YES, "the cross-arena result was not admitted to its source copy")
    it_check(counts, lmx_implements_exec_compose_copy(ea, owned_value, dn, cross_result, cross_source_copy) = c.LMX_IMPLEMENTS_YES, "source and result address maps did not compose across arenas")
    slot: 99U
    it_check(counts, lmx_implements_exec_slot(dn, cross_result, 0U, @ slot) = 0 && slot = 0U && lmx_implements_exec_slot(dn, cross_result, 2U, @ slot) = 0 && slot = 2U, "cross-arena composition lost ordinal or LAST address")
    it_check(counts, lmx_implements_exec_compose_copy(dn, owned_value, ea, cross_result, cross_source_copy) != c.LMX_IMPLEMENTS_YES, "composition accepted operands in the wrong arenas")
    # The ordinary merge constructor, not a hand-written test registration,
    # must carry a selected model's prior execution coordinates across both
    # a whole copy and a later data-only composition.
    merge_status: lmx_merge_owned(@ owned_value, 1U, 0, ea, dn, 0, 0U, @ merged_once)
    slot: 99U
    it_check(counts, merge_status = c.LMX_MERGE_OK && merged_once != 0 && lmx_implements_exec_slot(dn, merged_once, 0U, @ slot) = 0 && slot = 1U, "a whole merge copy lost the model's prior execution projection")
    merge_extra: it_pair(dn, 0, 1)
    merge_operands[0]: merged_once
    merge_operands[1]: merge_extra
    merge_status: lmx_merge_owned(merge_operands, 2U, 0, dn, ea, 0, 0U, @ merged_twice)
    slot: 99U
    it_check(counts, merge_status = c.LMX_MERGE_OK && merged_twice != 0 && lmx_implements_exec_slot(ea, merged_twice, 0U, @ slot) = 0 && slot = 1U && lmx_implements_exec_slot(ea, merged_twice, 2U, @ slot) = 0 && slot = 1U, "a data-only remerge lost the selected model's ordinal or LAST address")
    owned_wrapper: lmx_node_new_owned(ea)
    it_check(counts, owned_wrapper != 0 && lmx_arena_refs_open_owned(ea, owned_wrapper, 2U) = 0 && lmx_arena_ref_store(owned_wrapper, 0U, (cast: (@: void) owned_model)) = 0 && lmx_arena_ref_store(owned_wrapper, 1U, (cast: (@: void) owned_value)) = 0, "the computed correspondence's enclosing graph could not be made")
    it_check(counts, lmx_graph_copy_owned(owned_wrapper, ea, ea, @ owned_copy) = 0 && owned_copy != 0, "the graph with a computed correspondence could not be copied")
    owned_model_copy: lmx_arena_ref_struct(owned_copy, 0U)
    owned_value_copy: lmx_arena_ref_struct(owned_copy, 1U)
    owned_entry: lmx_implements_find(ea, owned_value_copy, owned_model_copy)
    slot: 99U
    it_check(counts, owned_entry != 0 && owned_entry\owned_map != 0 && owned_entry\map != lmx_implements_find(ea, owned_value, owned_model)\map && lmx_implements_slot(ea, owned_value_copy, owned_model_copy, 0U, @ slot) = 0 && slot = 1U, "the copied correspondence did not own an independent working map")
    slot: 99U
    it_check(counts, lmx_implements_exec_slot(ea, owned_value_copy, 0U, @ slot) = 0 && slot = 1U && lmx_implements_find(ea, owned_value_copy, owned_value_copy)\exec_map != lmx_implements_find(ea, owned_value, owned_value)\exec_map, "graph copy lost or aliased the selected execution projection")
    egen: lmx_arena_generation_next(ea)
    lmx_gc_mark_value(ea, (cast: (@: void) owned_model), egen, 0)
    lmx_gc_mark_value(ea, (cast: (@: void) owned_value), egen, 0)
    lmx_gc_mark_value(ea, (cast: (@: void) owned_wrapper), egen, 0)
    lmx_gc_mark_value(ea, (cast: (@: void) owned_copy), egen, 0)
    slot: 99U
    it_check(counts, lmx_gc_sweep(ea, egen) = c.LMX_GC_OK && lmx_implements_slot(ea, owned_value_copy, owned_model_copy, 0U, @ slot) = 0 && slot = 1U, "collection lost a live copied correspondence")
    egen: lmx_arena_generation_next(ea)
    it_check(counts, lmx_gc_sweep(ea, egen) = c.LMX_GC_OK && ea\impl_len = 0U, "collection retained a dead computed correspondence")
    lmx_arena_release(ea)

    lmx_arena_release(at)
    lmx_arena_release(dn)
    it_check(counts, at\impl = 0 && at\impl_len = 0U && at\impl_cap = 0U, "release left the table")
    it_places(counts)
    it_composed_receiving(counts)
    it_absorbed_reception(counts)
    failures: counts[1]
    c.printf("lmx_implements_table: %d checks, %d failed\n", counts[0], failures)
    free(counts)
    if: failures != 0
        return: 1
return: 0
