---
    Observed:
        int: seen 75
    end: Observed
---
@: shared (data [] 0)
fn: work () int
    int: x 5
    int: inner 0
    if: 1 ((int x) (:= inner x))
    return: ((inner * 10) + x)
end: work
fn: caller () int
    int: x 7
    return: (work)
end: caller
sub: main ()
    :=: ((shared \ Observed) \ seen) (caller)
end: main
main:
