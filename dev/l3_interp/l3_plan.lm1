predef: "l3_interp/l3_recv.h.lm1"
predef: "l2src/lmx_plan.lm1"
predef: "l2src/lmx_call.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l2src/lmx_implements.h.lm1"
include: "<stdlib.h>"

# L3 adapter onto the generic activation plan. Scans this receiver's own ints
# (top-level primitive slots after child[0]) in lexical order, once.

fn: l3_plan_prepare (@: LmxArena arena; @: Lmx node) int
    @: LmxCallable info
    @: Lmx roles
    @: Lmx plan 0
    @: void v
    @: size_t flat 0
    @: size_t lens 0
    @@: size_t paths 0
    size_t: i
    size_t: n 0U
    size_t: k 0U
    int: st
    if: arena = 0 || node = 0
        return: 1
    info: lmx_call_callable(arena, node)
    if: info = 0
        return: 1
    if: info\header != 0
        return: 0
    i: 1U
    while: i < (cast: (size_t) node\len)
        v: lmx_arena_ref_value(node, i)
        if: v != 0 && lmx_domain_kind(arena, v) = c.LMX_KIND_PRIMITIVE
            if: lmx_domain_type(arena, v) = c.LMX_TYPE_INT
                n: n + 1U
            ---
        ---
        i: i + 1U
    ---
    roles: lmx_plan_roles_open(arena)
    if: roles = 0
        return: 1
    if: n = 0U
        st: lmx_plan_build_from_paths(arena, roles, 0, 0, 0U, @ plan)
        if: st != c.LMX_PLAN_OK
            return: 1
        return: lmx_plan_publish(arena, roles, node, plan) != c.LMX_PLAN_OK
    ---
    flat: (cast: (@: size_t) calloc(n, c.sizeof(size_t)))
    lens: (cast: (@: size_t) calloc(n, c.sizeof(size_t)))
    paths: (cast: (@@: size_t) calloc(n, c.sizeof(@: void)))
    if: flat = 0 || lens = 0 || paths = 0
        free((cast: (@: void) flat))
        free((cast: (@: void) lens))
        free((cast: (@: void) paths))
        return: 1
    ---
    i: 1U
    while: i < (cast: (size_t) node\len)
        v: lmx_arena_ref_value(node, i)
        if: v != 0 && lmx_domain_kind(arena, v) = c.LMX_KIND_PRIMITIVE
            if: lmx_domain_type(arena, v) = c.LMX_TYPE_INT
                flat[k]: i
                lens[k]: 1U
                paths[k]: flat + k
                k: k + 1U
            ---
        ---
        i: i + 1U
    ---
    st: lmx_plan_build_from_paths(arena, roles, paths, lens, n, @ plan)
    free((cast: (@: void) flat))
    free((cast: (@: void) lens))
    free((cast: (@: void) paths))
    if: st != c.LMX_PLAN_OK || plan = 0
        return: 1
return: lmx_plan_publish(arena, roles, node, plan) != c.LMX_PLAN_OK
