Addition:
    int: first
    int: second
    return: int
    add:
        return: first + second

ClosureProbe:
    return: int
    run:
        import: Curry
        @: add5 capture(Addition\add; 5)
        @: add100 capture(Addition\add; 100)
        int: saved 1000
        int: first add5(1)
        int: second add100(1)
        int: again add5(1)
        return: first * 1000000 + second * 1000 + again
