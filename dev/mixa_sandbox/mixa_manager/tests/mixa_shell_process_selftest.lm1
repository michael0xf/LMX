predef: "mixa_manager/mixa_process_win32.lm1"
predef: "mixa_manager/mixa_share.lm1"
predef: "mixa_manager/mixa_shell_process.lm1"
include: "<stdio.h>" "<string.h>" "<stdlib.h>"

# A started child is not a spawn refusal. Its output is appended to a
# file. read does not wait. share records a path and does not begin.

fn: probe_ok (const: @(char path)) int
return: MIXA_SHARE_OK

fn: share_begin (@: MixaShareRequest r) int
return: MIXA_SHARE_OK

fn: share_poll (@: MixaShareRequest r; @: int out_event; @: int out_status) int
    if: out_event != 0
        out_event[0]: MIXA_SHARE_EVENT_NONE
    ---
    if: out_status != 0
        out_status[0]: MIXA_SHARE_OK
    ---
return: MIXA_SHARE_OK

fn: share_cancel (@: MixaShareRequest r) int
return: MIXA_SHARE_OK

fn: share_destroy (@: MixaShareRequest r) int
return: MIXA_SHARE_OK

fn: main (int: argc; @: @(char) argv) int
    []: char base 520
    []: char root 1040
    []: char logp 1200
    []: char cmd 400
    []: char chunk 256
    []: (@: void) fh 1
    @: MixaProcess proc
    @: MixaShareRequest share
    @: MixaShareVTable vt
    @@: char paths
    size_t: skipped
    size_t: got
    int: running
    int: code
    int: spins
    int: checks
    int: failures
    int: rc
    int: saw
    checks: 0
    failures: 0
    proc: 0
    if: argc >= 2
        c.snprintf(base, 520U, "%s", argv[1])
    ---
    if: argc < 2
        c.snprintf(base, 520U, "build/mixa/tmp_shell_process")
    ---
    c.snprintf(cmd, 400U, "cmd /c rmdir /s /q \"%s\" 2>nul & mkdir \"%s\" 2>nul", base, base)
    c.system(cmd)
    c.snprintf(root, 1040U, "%s\\root", base)
    c.snprintf(cmd, 400U, "cmd /c mkdir \"%s\" 2>nul", root)
    c.system(cmd)
    rc: mixa_shell_process_launch("echo mixa-shell-proc", "Z:\\no\\such\\mixa_cwd", 0, @ proc)
    checks: checks + 1
    if: rc != MIXA_PROC_ERR_SPAWN || proc != 0
        failures: failures + 1
        c.printf("shell-process: bad cwd returned %d\n", rc)
    ---
    proc: 0
    rc: mixa_shell_process_launch("echo mixa-shell-proc", root, 0, @ proc)
    checks: checks + 1
    if: rc != MIXA_PROC_OK || proc = 0
        failures: failures + 1
        c.printf("shell-process: spawn returned %d\n", rc)
    ---
    c.snprintf(logp, 1200U, "%s\\console.log", root)
    fh[0]: c.fopen(logp, "wb")
    if: fh[0] != 0
        c.fclose(fh[0])
    ---
    saw: 0
    spins: 0
    while: spins < 50 && proc != 0
        got: 0U
        rc: mixa_shell_process_read(proc, chunk, 255U, @ got)
        if: rc = MIXA_PROC_OK && got > 0U
            fh[0]: c.fopen(logp, "ab")
            if: fh[0] != 0
                c.fwrite(chunk, 1U, got, fh[0])
                c.fclose(fh[0])
            ---
            chunk[got]: 0
            if: c.strstr(chunk, "mixa-shell-proc") != 0
                saw: 1
            ---
        ---
        running: 0
        code: 0
        mixa_shell_process_status(proc, @ running, @ code)
        if: running = 0 && (rc = MIXA_PROC_EOF || got = 0U)
            spins: 50
        ---
        spins: spins + 1
        c.Sleep(20U)
    ---
    mixa_shell_process_close(@ proc)
    checks: checks + 1
    if: saw = 0
        failures: failures + 1
        c.printf("shell-process: child text did not arrive\n")
    ---
    vt: (cast: (@: MixaShareVTable) c.calloc(1U, c.sizeof(c.MixaShareVTable)))
    vt\name: "shell"
    vt\caps: 0U
    vt\probe_file: probe_ok
    vt\begin: share_begin
    vt\poll: share_poll
    vt\cancel: share_cancel
    vt\destroy: share_destroy
    paths: (cast: (@@: char) c.malloc(c.sizeof(@: char)))
    paths[0]: logp
    skipped: 0U
    share: 0
    rc: mixa_shell_process_share(vt, paths, 1U, @ share, @ skipped)
    checks: checks + 1
    if: rc != MIXA_SHARE_OK || share = 0 || mixa_share_file_count(share) != 1U
        failures: failures + 1
        c.printf("shell-process: share returned %d\n", rc)
    ---
    if: share != 0
        mixa_share_destroy(share)
    ---
    c.free(vt)
    c.free(paths)
    c.printf("shell-process: %d checks, %d failures\n", checks, failures)
    if: failures != 0
        return: 1
    ---
return: 0
