# steps/named-struct-exec.md §12: a `return` with a value in a block of a named Structure's body is
# refused in the words it has at the top of the body (unit_named_struct_return_value_refused).
Counter:
    size_t: n 0U
    if: n = 0U
        return: 5
    n: n + 1U
return
Counter
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
