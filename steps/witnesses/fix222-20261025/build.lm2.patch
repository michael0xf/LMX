+
+fn: decl_p0_own_state (@: f c.FILE) int
+    if: c.fputs("# Inherited fault-injection cells, not an allocator-policy design.\nint: lm_own_alloc_fails 0\nint: lm_own_ok_left -1\nint: lm_own_absorb_fails 0\n", f) < 0
+        return: 1
