# Проверяемые примеры для будущего прогона реальным LMX-ядром.
# Здесь нет утверждения, что эти проверки уже выполнены интерпретатором.
independent: RxStructureSample:
    int: a 10
    int: b 20
    int: c 30

independent: RxAdditionSample:
    int: x
    int: y
    return: int
    add:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
        return: x + y

RxStructureExamples:
    return: int
    run:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxRecordArity
            FxTypeToken
            ReceiverIndex
            ReceiverParent
            ReceiverPatchBase
            ReceiverPatchFormat
            ReceiverPermutation
            SequenceSize
        @: picked RxSelect\select(RxStructureSample; (2;0;2))
        sys\assert(length(picked) = 3)
        sys\assert(picked[0] = RxStructureSample[2])
        sys\assert(picked[0] = picked[2])
        @: kept RxOmit\omit(RxStructureSample; (1;1))
        sys\assert(length(kept) = 2)
        sys\assert(kept[0] = RxStructureSample[0])
        sys\assert(kept[1] = RxStructureSample[2])
        @: swapped RxReorder\reorder(RxStructureSample; (2;1;0))
        @: change RxDiff\diff(RxStructureSample; swapped)
        @: replay RxPatch\patch(RxStructureSample; change)
        sys\assert(length(change\indices) = 2)
        sys\assert(replay[0] = swapped[0])
        sys\assert(replay[1] = swapped[1])
        sys\assert(replay[2] = swapped[2])
        @: empty (copy(()))
        @: toEmpty RxDiff\diff(RxStructureSample; empty)
        @: cleared RxPatch\patch(RxStructureSample; toEmpty)
        sys\assert(length(cleared) = 0)
        @: fromEmpty RxDiff\diff(empty; RxStructureSample)
        @: restored RxPatch\patch(empty; fromEmpty)
        sys\assert(length(restored) = 3)
        sys\assert(restored[2] = RxStructureSample[2])
        @: copied RxProject\project(RxStructureSample; (2;0;2))
        sys\assert(copied[0] = copied[2])
        sys\assert(copied[0] != RxStructureSample[2])
        sys\assert(\copied[0] = 30)
        @: filled RxDefaults\defaults((int: x 0); (int: x 7; int: y 9))
        sys\assert(filled\x = 0 && filled\y = 9)
        @: extended RxDerive\derive((int: x 1); (int: y 2))
        sys\assert(extended\x = 1 && extended\y = 2)
        @: add5 RxBindFields\bindFields(RxAdditionSample\add; (int: y 5))
        sys\assert(add5(1) = 6)
        sys\assert(add5(1; y := 25) = 26)
        sys\assert(add5(1) = 6)
        return: 1
