predef: "l2src/lmx_reparent.h.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_primitive.h.lm1"
predef: "l2src/lmx_list_owned.lm1"
include: "<string.h>" "<stdlib.h>"

# The moved edge is substituted in the candidate ancestry; the live parent link
# is not touched by this check.  Descendants below moved keep their existing links.
fn: lmx_reparent_profile_root (@: LmxArena view; @: Lmx profile) @: Lmx
    @: LmxRange entry
    @: Lmx node
    @: Lmx root 0
    size_t: i 0U
    size_t: p
    size_t: limit_addr
    size_t: step c.sizeof(c.Lmx)
    if: view = 0 || profile = 0
        return: 0
    ---
    while: i < lmx_arena_index_len(view)
        entry: lmx_arena_index_data(view) + i
        if: entry\array != 0 && entry\array\profile = profile && entry\array\sealed != 0U && entry\array\kind = c.LMX_KIND_STRUCT && entry\array\type = c.LMX_TYPE_STRUCT && entry\array\stride = step
            p: (cast: (size_t) entry\lo)
            limit_addr: (cast: (size_t) entry\hi)
            while: p < limit_addr && limit_addr - p >= step
                if: lmx_range_classify(view, (cast: (@: void) p)) = c.LMX_KIND_STRUCT
                    node: (cast: (@: Lmx) p)
                    if: node\parent = 0 || lmx_range_profile(view, (cast: (@: void) node\parent)) != profile
                        if: root != 0 && root != node
                            return: 0
                        ---
                        root: node
                    ---
                ---
                p: p + step
            ---
        ---
        i: i + 1U
    ---
return: root

# Physical retention has the same boundary as ordinary merge: a sealed
# profile whose root has a lexical parent is not independent. Its contents
# (and needed lexical context) must be copied, not kept by old address.
fn: lmx_reparent_profile_retained (@: LmxArena view; @: Lmx profile) int
    @: Lmx root lmx_reparent_profile_root(view, profile)
    if: root = 0
        return: 0
    ---
return: (cast: (int) (root\parent = 0))

fn: lmx_reparent_owner_visible (@: LmxArena owner; @: LmxThread subject; @: LmxThread moved; @: LmxThread new_parent) int
    @: LmxThread current subject
    while: current != 0
        if: current\slot != 0 && current\slot\arena = owner
            return: 1
        if: current = moved
            current: new_parent
        else:
            current: lmx_thread_parent(current)
        ---
    ---
return: 0

fn: lmx_reparent_enqueue (@: LmxCopyStack todo; @: void value) int
    if: value = 0
        return: LMX_REPARENT_OK
    if: lmx_copy_stack_push(todo, (cast: (@: Lmx) value)) != 0
        return: LMX_REPARENT_NOMEM
return: LMX_REPARENT_OK

sub: lmx_reparent_edges_dispose (@: LmxReparentEdges edges)
    if: edges = 0
        return
    ---
    free((cast: (@: void) edges\data))
    edges\data: 0
    edges\n: 0U
    edges\room: 0U
end: lmx_reparent_edges_dispose

fn: lmx_reparent_record_edge (@: LmxReparentEdges edges; @@: void slot; @: void value; @: Lmx profile; @: LmxArena view) int
    @: LmxReparentEdge grown
    @: LmxReparentEdge at
    size_t: capacity
    if: edges = 0 || slot = 0 || value = 0
        return: LMX_REPARENT_OK
    ---
    if: edges\n = edges\room
        capacity: 64U
        if: edges\room != 0U
            if: edges\room > ((cast: (size_t) -1) / 2U)
                return: LMX_REPARENT_NOMEM
            ---
            capacity: edges\room * 2U
        ---
        if: capacity > ((cast: (size_t) -1) / c.sizeof(c.LmxReparentEdge))
            return: LMX_REPARENT_NOMEM
        ---
        grown: (cast: (@: LmxReparentEdge) realloc((cast: (@: void) edges\data), capacity * c.sizeof(c.LmxReparentEdge)))
        if: grown = 0
            return: LMX_REPARENT_NOMEM
        ---
        edges\data: grown
        edges\room: capacity
    ---
    at: edges\data + edges\n
    at\slot: slot
    at\value: value
    at\source_profile: profile
    at\view: view
    edges\n: edges\n + 1U
return: LMX_REPARENT_OK

fn: lmx_reparent_enqueue_edge (@: LmxCopyStack todo; @: LmxReparentEdges edges; @@: void slot; @: void value; @: Lmx profile; @: LmxArena view) int
    int: status lmx_reparent_record_edge(edges, slot, value, profile, view)
    if: status != LMX_REPARENT_OK
        return: status
    ---
return: lmx_reparent_enqueue(todo, value)

# Traverse graph values, not all imported ranges: an imported but unused profile
# cannot prevent a move.  This is scratch only; the graph and arena are unchanged.
fn: lmx_reparent_graph_preflight (@: LmxArena arena; @: Lmx graph; @: LmxThread subject; @: LmxThread moved; @: LmxThread new_parent; @: LmxCopyMap lost; @: LmxReparentEdges edges) int
    LmxCopyMap: seen
    LmxCopyStack: todo
    @: void value
    @: LmxArena owner
    @: Lmx profile
    @: Lmx carrier_profile
    @: Lmx node
    @: LmxPrimitive primitive
    @: VoidArray descriptor
    @: VoidArray node_array
    @: VoidDynamicArray dynamic
    @: void child_data
    @@: void refs
    size_t: i
    int: kind
    int: vtype
    int: status LMX_REPARENT_OK
    if: arena = 0 || graph = 0
        return: LMX_REPARENT_INVALID
    memset((cast: (@: void) (@ seen)), 0, c.sizeof(c.LmxCopyMap))
    memset((cast: (@: void) (@ todo)), 0, c.sizeof(c.LmxCopyStack))
    if: lmx_copy_map_init(@ seen) != 0
        return: LMX_REPARENT_NOMEM
    status: lmx_reparent_enqueue(@ todo, (cast: (@: void) graph))
    while: status = LMX_REPARENT_OK && lmx_copy_stack_items_len(@ todo) != 0U
        value: (cast: (@: void) lmx_copy_stack_pop(@ todo))
        if: lmx_copy_map_get(@ seen, value) != 0
            continue
        ---
        kind: lmx_range_classify(arena, value)
        if: kind = c.LMX_KIND_NONE
            # An opaque external address is not an imported eternal branch.
            continue
        ---
        if: lmx_copy_map_put(@ seen, value, value) != 0
            status: LMX_REPARENT_NOMEM
            break
        ---
        owner: lmx_range_home(arena, value)
        if: owner = 0
            status: LMX_REPARENT_INVALID
            break
        ---
        if: owner != arena
            profile: lmx_range_sealed_profile(arena, value)
            if: profile != 0
                if: lmx_reparent_owner_visible(owner, subject, moved, new_parent) = 0
                    if: lmx_copy_map_put(lost, (cast: (@: void) profile), (cast: (@: void) owner)) != 0
                        status: LMX_REPARENT_NOMEM
                        break
                    ---
                ---
            else:
                # Other Message records are independently supervised values;
                # a mutable foreign graph edge violates the full-copy rule.
                if: kind != c.LMX_DOMAIN_KIND_MSG_RECORD
                    status: LMX_REPARENT_INVALID
                    break
                ---
            ---
        ---
        vtype: lmx_range_type_of(arena, value)
        if: kind = c.LMX_KIND_STRUCT
            if: vtype != c.LMX_TYPE_STRUCT || lmx_range_stride(arena, value) != c.sizeof(c.Lmx)
                status: LMX_REPARENT_INVALID
                break
            ---
            node: (cast: (@: Lmx) value)
            carrier_profile: lmx_range_sealed_profile(arena, value)
            status: lmx_reparent_enqueue_edge(@ todo, edges, (cast: (@@: void) (@ node\parent)), (cast: (@: void) node\parent), carrier_profile, arena)
            if: status != LMX_REPARENT_OK
                break
            ---
            node_array: (cast: (@: VoidArray) node)
            child_data: node_array\data
            status: lmx_reparent_record_edge(edges, (cast: (@@: void) (@ node_array\data)), child_data, carrier_profile, arena)
            if: status != LMX_REPARENT_OK
                break
            ---
            if: node\array.size != 0U
                if: child_data = 0 || lmx_range_classify(arena, child_data) != c.LMX_KIND_CHILDREN || lmx_range_type_of(arena, child_data) != c.LMX_TYPE_REFS || lmx_range_stride(arena, child_data) != c.sizeof(@: void)
                    status: LMX_REPARENT_INVALID
                    break
                ---
                refs: (cast: (@@: void) child_data)
                carrier_profile: lmx_range_sealed_profile(arena, child_data)
                i: 0U
                while: i < node\array.size && status = LMX_REPARENT_OK
                    status: lmx_reparent_enqueue_edge(@ todo, edges, refs + i, refs[i], carrier_profile, arena)
                    i: i + 1U
                ---
            ---
            continue
        ---
        if: kind = c.LMX_KIND_PRIMITIVE
            if: vtype >= c.LMX_TYPE_POINTER_BASE && vtype < c.LMX_TYPE_ARRAY_OF_POINTER_BASE
                if: lmx_range_stride(arena, value) != c.sizeof(@: void)
                    status: LMX_REPARENT_INVALID
                else:
                    status: lmx_reparent_enqueue_edge(@ todo, edges, (cast: (@@: void) value), lmx_pointer_value_known(value), lmx_range_sealed_profile(arena, value), arena)
                ---
            ---
            continue
        ---
        if: kind = c.LMX_DOMAIN_KIND_PRIMITIVE
            if: vtype != c.LMX_DOMAIN_PRIMITIVE || lmx_range_stride(arena, value) != c.sizeof(c.LmxPrimitive)
                status: LMX_REPARENT_INVALID
                break
            ---
            primitive: (cast: (@: LmxPrimitive) value)
            carrier_profile: lmx_range_sealed_profile(arena, value)
            status: lmx_reparent_enqueue_edge(@ todo, edges, (cast: (@@: void) (@ primitive\signature)), (cast: (@: void) primitive\signature), carrier_profile, arena)
            if: status = LMX_REPARENT_OK && primitive\owner != (cast: (@: Lmx) arena)
                status: lmx_reparent_enqueue_edge(@ todo, edges, (cast: (@@: void) (@ primitive\owner)), (cast: (@: void) primitive\owner), carrier_profile, arena)
            ---
            continue
        ---
        if: kind = c.LMX_KIND_LIST
            if: lmx_range_stride(arena, value) != c.sizeof(c.VoidDynamicArray)
                status: LMX_REPARENT_INVALID
                break
            ---
            dynamic: (cast: (@: VoidDynamicArray) value)
            descriptor: (cast: (@: VoidArray) dynamic)
            if: descriptor\size > dynamic\capacity || (descriptor\size != 0U && descriptor\data = 0)
                status: LMX_REPARENT_INVALID
                break
            ---
            carrier_profile: lmx_range_sealed_profile(arena, value)
            status: lmx_reparent_record_edge(edges, (cast: (@@: void) (@ descriptor\data)), descriptor\data, carrier_profile, arena)
            refs: (cast: (@@: void) lmx_list_data((cast: (@: void) dynamic)))
            carrier_profile: lmx_range_sealed_profile(arena, descriptor\data)
            i: 0U
            while: i < descriptor\size && status = LMX_REPARENT_OK
                status: lmx_reparent_enqueue_edge(@ todo, edges, refs + i, refs[i], carrier_profile, arena)
                i: i + 1U
            ---
            continue
        ---
        if: kind = c.LMX_KIND_ARRAY
            if: lmx_range_stride(arena, value) != c.sizeof(c.VoidArray)
                status: LMX_REPARENT_INVALID
                break
            ---
            descriptor: (cast: (@: VoidArray) value)
            if: descriptor\size != 0U && descriptor\data = 0
                status: LMX_REPARENT_INVALID
                break
            ---
            carrier_profile: lmx_range_sealed_profile(arena, value)
            status: lmx_reparent_record_edge(edges, (cast: (@@: void) (@ descriptor\data)), descriptor\data, carrier_profile, arena)
            if: status != LMX_REPARENT_OK
                break
            ---
            if: vtype = c.LMX_TYPE_ARRAY_OF_LMX || vtype = c.LMX_TYPE_ARRAY_OF_DESC || vtype >= c.LMX_TYPE_ARRAY_OF_POINTER_BASE
                refs: (cast: (@@: void) descriptor\data)
                carrier_profile: lmx_range_sealed_profile(arena, descriptor\data)
                i: 0U
                while: i < descriptor\size && status = LMX_REPARENT_OK
                    status: lmx_reparent_enqueue_edge(@ todo, edges, refs + i, refs[i], carrier_profile, arena)
                    i: i + 1U
                ---
            ---
            continue
        ---
        # Typed OP, source-symbol and ordinary scalar records have no arena
        # references beyond the Structure/descriptor which contains them.
        if: kind != c.LMX_DOMAIN_KIND_OP && kind != c.LMX_KIND_SOURCE_SYMBOL && kind != c.LMX_DOMAIN_KIND_ROLE && kind != c.LMX_DOMAIN_KIND_MSG_RECORD
            status: LMX_REPARENT_INVALID
        ---
    ---
    lmx_copy_stack_dispose(@ todo)
    lmx_copy_map_dispose(@ seen)
return: status

fn: lmx_reparent_scan (@: LmxThread moved; @: LmxThread new_parent; @: LmxCopyMap lost; @: LmxReparentEdges edges) int
    LmxCopyMap: seen
    LmxCopyStack: todo
    @: LmxThread current
    @: LmxThread child
    @: LmxMsg message
    size_t: i
    int: status LMX_REPARENT_OK
    if: lost = 0
        return: LMX_REPARENT_INVALID
    ---
    memset((cast: (@: void) lost), 0, c.sizeof(c.LmxCopyMap))
    if: edges != 0
        memset((cast: (@: void) edges), 0, c.sizeof(c.LmxReparentEdges))
    ---
    if: moved = 0 || new_parent = 0 || moved = new_parent
        return: LMX_REPARENT_INVALID
    ---
    current: new_parent
    while: current != 0
        if: current = moved
            return: LMX_REPARENT_INVALID
        current: lmx_thread_parent(current)
    ---
    memset((cast: (@: void) (@ seen)), 0, c.sizeof(c.LmxCopyMap))
    memset((cast: (@: void) (@ todo)), 0, c.sizeof(c.LmxCopyStack))
    if: lmx_copy_map_init(@ seen) != 0
        return: LMX_REPARENT_NOMEM
    if: lmx_copy_map_init(lost) != 0
        lmx_copy_map_dispose(@ seen)
        return: LMX_REPARENT_NOMEM
    ---
    if: lmx_copy_stack_push(@ todo, (cast: (@: Lmx) moved)) != 0
        status: LMX_REPARENT_NOMEM
    ---
    while: status = LMX_REPARENT_OK && lmx_copy_stack_items_len(@ todo) != 0U
        current: (cast: (@: LmxThread) lmx_copy_stack_pop(@ todo))
        if: lmx_copy_map_get(@ seen, (cast: (@: void) current)) != 0
            continue
        ---
        if: lmx_copy_map_put(@ seen, (cast: (@: void) current), (cast: (@: void) current)) != 0
            status: LMX_REPARENT_NOMEM
            break
        ---
        message: lmx_thread_message(current)
        if: current\slot = 0 || current\slot\arena = 0 || message = 0
            status: LMX_REPARENT_INVALID
            break
        ---
        # Construction may link a Thread before assigning its source graph.
        # With no graph yet there are no used graph edges to retain.
        if: message\graph != 0
            status: lmx_reparent_record_edge(edges, (cast: (@@: void) (@ message\graph)), (cast: (@: void) message\graph), 0, current\slot\arena)
            if: status = LMX_REPARENT_OK
                status: lmx_reparent_graph_preflight(current\slot\arena, message\graph, current, moved, new_parent, lost, edges)
            ---
            if: status != LMX_REPARENT_OK
                break
            ---
        ---
        i: 0U
        while: i < lmx_thread_child_count(current)
            child: lmx_thread_child_at(current, i)
            if: child = 0 || lmx_copy_stack_push(@ todo, (cast: (@: Lmx) child)) != 0
                status: LMX_REPARENT_NOMEM
                break
            ---
            i: i + 1U
        ---
    ---
    lmx_copy_stack_dispose(@ todo)
    lmx_copy_map_dispose(@ seen)
    if: status != LMX_REPARENT_OK
        lmx_copy_map_dispose(lost)
        lmx_reparent_edges_dispose(edges)
        return: status
    ---
    if: lost\n != 0U
        return: LMX_REPARENT_OWNER
    ---
return: status

fn: lmx_reparent_lost_profiles (@: LmxThread moved; @: LmxThread new_parent; @: LmxCopyMap lost) int
return: lmx_reparent_scan(moved, new_parent, lost, 0)

fn: lmx_reparent_expand_carriers (@: LmxCopyMap selected; @: LmxReparentEdges edges) int
    @: LmxReparentEdge edge
    @: Lmx target_profile
    @: Lmx carrier_root
    @: LmxArena owner
    size_t: i
    int: changed 1
    if: selected = 0 || edges = 0 || lmx_copy_map_keys_data(selected) = 0
        return: LMX_REPARENT_INVALID
    ---
    while: changed != 0
        changed: 0
        i: 0U
        while: i < edges\n
            edge: edges\data + i
            if: edge\source_profile != 0 && lmx_copy_map_get(selected, (cast: (@: void) edge\source_profile)) = 0
                target_profile: lmx_range_sealed_profile(edge\view, edge\value)
                if: target_profile != 0 && lmx_copy_map_get(selected, (cast: (@: void) target_profile)) != 0
                    # slot may name a field inside a Structure or descriptor,
                    # not the start of a typed cell. Resolve the carrier by
                    # its sealed profile rather than classifying that interior
                    # field address as a standalone cell.
                    carrier_root: lmx_reparent_profile_root(edge\view, edge\source_profile)
                    owner: lmx_range_home(edge\view, (cast: (@: void) carrier_root))
                    if: owner = 0
                        return: LMX_REPARENT_INVALID
                    ---
                    if: lmx_copy_map_put(selected, (cast: (@: void) edge\source_profile), (cast: (@: void) owner)) != 0
                        return: LMX_REPARENT_NOMEM
                    ---
                    changed: 1
                ---
            ---
            i: i + 1U
        ---
    ---
return: LMX_REPARENT_OK

fn: lmx_reparent_expand_copy_set (@: LmxThread moved; @: LmxThread new_parent; @: LmxCopyMap selected; @: LmxReparentEdges edges) int
    @: LmxReparentEdge edge
    @: Lmx dependency
    @: LmxArena owner
    size_t: before
    size_t: i
    int: status
    if: moved = 0 || new_parent = 0 || selected = 0 || edges = 0 || (edges\n != 0U && edges\data = 0)
        return: LMX_REPARENT_INVALID
    ---
    while: 1
        before: selected\n
        status: lmx_reparent_expand_carriers(selected, edges)
        if: status != LMX_REPARENT_OK
            return: status
        ---
        i: 0U
        while: i < edges\n
            edge: edges\data + i
            if: edge\source_profile != 0 && lmx_copy_map_get(selected, (cast: (@: void) edge\source_profile)) != 0
                dependency: lmx_range_sealed_profile(edge\view, edge\value)
                if: dependency != 0 && lmx_copy_map_get(selected, (cast: (@: void) dependency)) = 0
                    owner: lmx_range_home(edge\view, edge\value)
                    if: owner = 0
                        return: LMX_REPARENT_INVALID
                    ---
                    if: lmx_reparent_profile_retained(edge\view, dependency) = 0 || lmx_reparent_owner_visible(owner, moved, moved, new_parent) = 0
                        if: lmx_copy_map_put(selected, (cast: (@: void) dependency), (cast: (@: void) owner)) != 0
                            return: LMX_REPARENT_NOMEM
                        ---
                    ---
                ---
            ---
            i: i + 1U
        ---
        if: selected\n = before
            break
        ---
    ---
return: LMX_REPARENT_OK

fn: lmx_reparent_selected_roots (@: LmxCopyMap selected; @: LmxCopyMap roots) int
    @@: void keys
    @@: void owners
    @: Lmx profile
    @: Lmx root
    @: LmxArena owner
    size_t: i 0U
    size_t: room
    int: status LMX_REPARENT_OK
    if: selected = 0 || roots = 0 || selected = roots || lmx_copy_map_keys_data(selected) = 0
        return: LMX_REPARENT_INVALID
    ---
    memset((cast: (@: void) roots), 0, c.sizeof(c.LmxCopyMap))
    if: lmx_copy_map_init(roots) != 0
        return: LMX_REPARENT_NOMEM
    ---
    keys: lmx_copy_map_keys_data(selected)
    owners: lmx_copy_map_vals_data(selected)
    room: lmx_copy_map_keys_cap(selected)
    while: i < room
        profile: (cast: (@: Lmx) keys[i])
        if: profile != 0
            owner: (cast: (@: LmxArena) owners[i])
            root: lmx_reparent_profile_root(owner, profile)
            if: owner = 0 || root = 0 || lmx_range_home(owner, (cast: (@: void) root)) != owner || lmx_range_sealed_profile(owner, (cast: (@: void) root)) != profile
                status: LMX_REPARENT_INVALID
                break
            ---
            if: lmx_copy_map_put(roots, (cast: (@: void) profile), (cast: (@: void) root)) != 0
                status: LMX_REPARENT_NOMEM
                break
            ---
        ---
        i: i + 1U
    ---
    if: status != LMX_REPARENT_OK
        lmx_copy_map_dispose(roots)
    ---
return: status

fn: lmx_reparent_import_profiles (@: LmxArena view; @: LmxCopyMap profiles; int: include_context) int
    @@: void keys lmx_copy_map_keys_data(profiles)
    @@: void owners lmx_copy_map_vals_data(profiles)
    @: Lmx profile
    @: Lmx root
    @: LmxArena owner
    size_t: i 0U
    size_t: room lmx_copy_map_keys_cap(profiles)
    if: view = 0 || keys = 0 || owners = 0
        return: LMX_REPARENT_INVALID
    ---
    while: i < room
        profile: (cast: (@: Lmx) keys[i])
        if: profile != 0
            owner: (cast: (@: LmxArena) owners[i])
            root: lmx_reparent_profile_root(owner, profile)
            if: owner = 0 || root = 0
                return: LMX_REPARENT_INVALID
            ---
            if: include_context != 0
                # Discovery must be able to classify a dependency reached
                # through a selected root's copied lexical context, including
                # ranges imported by that context's owner. This is a disposable
                # read-only view, not a copy/retention decision: unrelated
                # visible branches still stay outside `profiles`.
                if: lmx_range_import_source_view(view, owner) != 0
                    return: LMX_REPARENT_INVALID
                ---
            else:
                if: lmx_range_import_profile(view, owner, profile) != 0
                    return: LMX_REPARENT_INVALID
                ---
            ---
        ---
        i: i + 1U
    ---
return: LMX_REPARENT_OK

fn: lmx_reparent_source_view (@: LmxCopyMap selected; @: LmxReparentEdges edges; @: LmxArena view; @: LmxCopyMap retained) int
    @: LmxReparentEdge edge
    @: Lmx profile
    @: LmxArena owner
    size_t: i 0U
    int: status LMX_REPARENT_OK
    int: opened 0
    if: selected = 0 || edges = 0 || view = 0 || retained = 0 || lmx_copy_map_keys_data(selected) = 0 || (edges\n != 0U && edges\data = 0)
        return: LMX_REPARENT_INVALID
    ---
    memset((cast: (@: void) retained), 0, c.sizeof(c.LmxCopyMap))
    if: lmx_copy_map_init(retained) != 0
        return: LMX_REPARENT_NOMEM
    ---
    while: i < edges\n
        edge: edges\data + i
        profile: lmx_range_sealed_profile(edge\view, edge\value)
        if: edge\source_profile != 0 && lmx_copy_map_get(selected, (cast: (@: void) edge\source_profile)) != 0 && profile != 0 && lmx_copy_map_get(selected, (cast: (@: void) profile)) = 0 && lmx_copy_map_get(retained, (cast: (@: void) profile)) = 0
            if: lmx_reparent_profile_retained(edge\view, profile) = 0
                status: LMX_REPARENT_INVALID
                break
            ---
            owner: lmx_range_home(edge\view, edge\value)
            if: owner = 0
                status: LMX_REPARENT_INVALID
                break
            ---
            if: lmx_copy_map_put(retained, (cast: (@: void) profile), (cast: (@: void) owner)) != 0
                status: LMX_REPARENT_NOMEM
                break
            ---
        ---
        i: i + 1U
    ---
    if: status = LMX_REPARENT_OK
        if: lmx_arena_open_source_view(view) != 0
            status: LMX_REPARENT_INVALID
        else:
            opened: 1
        ---
    ---
    if: status = LMX_REPARENT_OK
        status: lmx_reparent_import_profiles(view, selected, 1)
    ---
    if: status = LMX_REPARENT_OK
        status: lmx_reparent_import_profiles(view, retained, 0)
    ---
    if: status != LMX_REPARENT_OK
        if: opened != 0
            lmx_arena_release(view)
        ---
        lmx_copy_map_dispose(retained)
    ---
return: status

# Consume only a profile address actually reported by a failed used-path
# copy. The view may classify many unrelated profiles, but none of those is
# inserted by this function unless the caller supplies its reached address.
fn: lmx_reparent_route_missing_profile (@: LmxThread moved; @: LmxThread new_parent; @: LmxArena view; @: Lmx profile; @: LmxCopyMap selected; @: LmxCopyMap retained) int
    @: Lmx root
    @: LmxArena owner
    if: moved = 0 || new_parent = 0 || view = 0 || view\source_view = 0U || profile = 0 || selected = 0 || retained = 0 || lmx_copy_map_keys_data(selected) = 0 || lmx_copy_map_keys_data(retained) = 0
        return: LMX_REPARENT_INVALID
    ---
    if: lmx_copy_map_get(selected, (cast: (@: void) profile)) != 0 || lmx_copy_map_get(retained, (cast: (@: void) profile)) != 0
        # A repeated report with unchanged maps is not progress.
        return: LMX_REPARENT_INVALID
    ---
    root: lmx_reparent_profile_root(view, profile)
    if: root = 0 || lmx_range_sealed_profile(view, (cast: (@: void) root)) != profile
        return: LMX_REPARENT_INVALID
    ---
    owner: lmx_range_home(view, (cast: (@: void) root))
    if: owner = 0
        return: LMX_REPARENT_INVALID
    ---
    if: lmx_reparent_profile_retained(view, profile) != 0 && lmx_reparent_owner_visible(owner, moved, moved, new_parent) != 0
        if: lmx_copy_map_put(retained, (cast: (@: void) profile), (cast: (@: void) owner)) != 0
            return: LMX_REPARENT_NOMEM
        ---
        return: LMX_REPARENT_OK
    ---
    # The newly selected owner may itself import dependencies not yet in the
    # disposable source view. Read-only import precedes the map update so a
    # failed import cannot leave a selected profile without readable context.
    if: lmx_range_import_source_view(view, owner) != 0
        return: LMX_REPARENT_INVALID
    ---
    if: lmx_copy_map_put(selected, (cast: (@: void) profile), (cast: (@: void) owner)) != 0
        return: LMX_REPARENT_NOMEM
    ---
return: LMX_REPARENT_OK

# The staging arena is an actual future copy, not a second model of the
# program. A dry-run discards it; preparation can prove it before publication.
sub: lmx_reparent_copy_stage_dispose (@: LmxReparentCopyStage stage)
    if: stage = 0
        return
    ---
    lmx_copy_names_finish(@ stage\pending, 0)
    lmx_graph_copy_map_dispose(@ stage\relocated)
    lmx_copy_map_dispose(@ stage\targets)
    lmx_arena_release(@ stage\arena)
    free((cast: (@: void) stage\sources))
    free((cast: (@: void) stage\results))
    free((cast: (@: void) stage\keep))
    memset((cast: (@: void) stage), 0, c.sizeof(c.LmxReparentCopyStage))
end: lmx_reparent_copy_stage_dispose

fn: lmx_reparent_stage_copy_set (@: LmxArena view; @: LmxCopyMap selected; @: LmxCopyMap retained; @: LmxReparentCopyStage stage; @@: Lmx missing) int
    @@: void keys
    @: LmxCopyMap target_ptr
    @: Lmx profile
    @: Lmx root
    @: Lmx marker
    size_t: i 0U
    int: status LMX_REPARENT_OK
    int: copy_status LMX_GRAPH_COPY_INVALID
    if: view = 0 || view\source_view = 0U || selected = 0 || retained = 0 || stage = 0 || missing = 0 || selected\n = 0U || lmx_copy_map_keys_data(selected) = 0 || lmx_copy_map_keys_data(retained) = 0
        return: LMX_REPARENT_INVALID
    ---
    \missing: 0
    if: selected\n > ((cast: (size_t) -1) / c.sizeof(@: Lmx)) || retained\n > ((cast: (size_t) -1) / c.sizeof(@: Lmx))
        return: LMX_REPARENT_INVALID
    ---
    memset((cast: (@: void) stage), 0, c.sizeof(c.LmxReparentCopyStage))
    target_ptr: @ stage\targets
    stage\sources: (cast: (@@: Lmx) calloc(selected\n, c.sizeof(@: Lmx)))
    stage\results: (cast: (@@: Lmx) calloc(selected\n, c.sizeof(@: Lmx)))
    if: retained\n != 0U
        stage\keep: (cast: (@@: Lmx) calloc(retained\n, c.sizeof(@: Lmx)))
    ---
    if: stage\sources = 0 || stage\results = 0 || (retained\n != 0U && stage\keep = 0)
        status: LMX_REPARENT_NOMEM
    ---
    if: status = LMX_REPARENT_OK && lmx_arena_open(@ stage\arena) != 0
        status: LMX_REPARENT_NOMEM
    ---
    if: status = LMX_REPARENT_OK && lmx_copy_map_init(@ stage\targets) != 0
        status: LMX_REPARENT_NOMEM
    ---
    if: status = LMX_REPARENT_OK && lmx_reparent_import_profiles(@ stage\arena, retained, 0) != LMX_REPARENT_OK
        status: LMX_REPARENT_INVALID
    ---
    if: status = LMX_REPARENT_OK
        keys: lmx_copy_map_keys_data(retained)
        i: 0U
        while: i < lmx_copy_map_keys_cap(retained)
            if: keys[i] != 0
                stage\keep[stage\kept]: (cast: (@: Lmx) keys[i])
                stage\kept: stage\kept + 1U
            ---
            i: i + 1U
        ---
        keys: lmx_copy_map_keys_data(selected)
        i: 0U
        while: i < lmx_copy_map_keys_cap(selected) && status = LMX_REPARENT_OK
            profile: (cast: (@: Lmx) keys[i])
            if: profile != 0
                root: lmx_reparent_profile_root(view, profile)
                marker: lmx_node_new_owned(@ stage\arena)
                if: root = 0 || lmx_range_classify(view, (cast: (@: void) root)) != c.LMX_KIND_STRUCT || marker = 0
                    status: LMX_REPARENT_INVALID
                else:
                    stage\sources[stage\n]: root
                    stage\n: stage\n + 1U
                    if: lmx_copy_map_put(@ stage\targets, (cast: (@: void) profile), (cast: (@: void) marker)) != 0
                        status: LMX_REPARENT_NOMEM
                    ---
                ---
            ---
            i: i + 1U
        ---
    ---
    if: status = LMX_REPARENT_OK && (stage\n != selected\n || stage\kept != retained\n)
        status: LMX_REPARENT_INVALID
    ---
    if: status = LMX_REPARENT_OK
        copy_status: lmx_graph_copy_forest_remapped_staged(stage\sources, stage\n, view, @ stage\arena, stage\keep, stage\kept, @ stage\targets, stage\results, @ stage\pending, @ stage\relocated)
        \missing: target_ptr\unmapped
        if: copy_status != LMX_GRAPH_COPY_OK && (copy_status != LMX_GRAPH_COPY_INVALID || \missing = 0)
            status: LMX_REPARENT_INVALID
            if: copy_status = LMX_GRAPH_COPY_NOMEM
                status: LMX_REPARENT_NOMEM
            ---
        ---
    ---
    if: status != LMX_REPARENT_OK || \missing != 0
        lmx_reparent_copy_stage_dispose(stage)
    ---
return: status

# A profile proved earlier in this same stage is the only new prior allowed
# for another profile. Retained profiles were already qualified and sealed by
# their owners. A dependency cycle which cannot be ordered fails closed; it is
# not made valid by naming every unfinished profile as its own prior.
fn: lmx_reparent_qualify_copy_stage (@: LmxReparentCopyStage stage) int
    @@: Lmx prior 0
    @: int done 0
    @: Lmx root
    @: Lmx profile
    size_t: i
    size_t: count
    size_t: proved 0U
    int: progress
    int: qualification
    int: status LMX_REPARENT_OK
    if: stage = 0 || stage\n = 0U || stage\sources = 0 || stage\results = 0 || stage\qualified != 0
        return: LMX_REPARENT_INVALID
    ---
    if: stage\n > (cast: (size_t) -1) - stage\kept || stage\n + stage\kept > (cast: (size_t) -1) / c.sizeof(@: Lmx)
        return: LMX_REPARENT_INVALID
    ---
    prior: (cast: (@@: Lmx) calloc(stage\n + stage\kept, c.sizeof(@: Lmx)))
    done: (cast: (@: int) calloc(stage\n, c.sizeof(int)))
    if: prior = 0 || done = 0
        status: LMX_REPARENT_NOMEM
    else:
        i: 0U
        while: i < stage\kept
            prior[i]: stage\keep[i]
            i: i + 1U
        ---
        count: stage\kept
        while: proved < stage\n && status = LMX_REPARENT_OK
            progress: 0
            i: 0U
            while: i < stage\n
                if: done[i] = 0
                    root: stage\results[i]
                    profile: lmx_range_profile(@ stage\arena, (cast: (@: void) root))
                    if: root = 0 || profile = 0
                        status: LMX_REPARENT_INVALID
                        break
                    ---
                    qualification: lmx_qualify_tree_preflight_full(@ stage\arena, root, 0, prior, count, 0, 0U, 0, 0U)
                    if: qualification = LMX_QUALIFY_OK
                        if: lmx_arena_seal_profile(@ stage\arena, profile) != 0
                            status: LMX_REPARENT_INVALID
                            break
                        ---
                        prior[count]: profile
                        count: count + 1U
                        done[i]: 1
                        proved: proved + 1U
                        progress: 1
                    else:
                        if: qualification = LMX_QUALIFY_NOMEM
                            status: LMX_REPARENT_NOMEM
                            break
                        ---
                    ---
                ---
                i: i + 1U
            ---
            if: progress = 0 && status = LMX_REPARENT_OK
                status: LMX_REPARENT_INVALID
            ---
        ---
    ---
    free((cast: (@: void) prior))
    free((cast: (@: void) done))
    if: status = LMX_REPARENT_OK
        stage\qualified: 1
    ---
return: status

# Exact source slots are recorded by the same graph traversal that discovered
# owner dependencies. Build only the changes still needed *outside* copied
# immutable carriers; their internal edges already follow the forest map.
sub: lmx_reparent_edits_dispose (@: LmxReparentEdits edits)
    if: edits = 0
        return
    ---
    free((cast: (@: void) edits\data))
    edits\data: 0
    edits\n: 0U
end: lmx_reparent_edits_dispose

fn: lmx_reparent_stage_edits (@: LmxReparentEdges edges; @: LmxCopyMap selected; @: LmxReparentCopyStage stage; @: LmxReparentEdits edits) int
    @: LmxReparentEdge edge
    @: LmxReparentEdit edit
    @: LmxRange entry
    @: Lmx target_profile
    @: void after
    @: void cell
    @@: void slot
    size_t: i
    size_t: j
    size_t: offset
    size_t: stride
    int: duplicate
    int: status LMX_REPARENT_OK
    if: edges = 0 || selected = 0 || stage = 0 || edits = 0 || stage\qualified = 0 || lmx_copy_map_keys_data(selected) = 0 || (edges\n != 0U && edges\data = 0)
        return: LMX_REPARENT_INVALID
    ---
    memset((cast: (@: void) edits), 0, c.sizeof(c.LmxReparentEdits))
    if: edges\n > (cast: (size_t) -1) / c.sizeof(c.LmxReparentEdit)
        return: LMX_REPARENT_INVALID
    ---
    if: edges\n != 0U
        edits\data: (cast: (@: LmxReparentEdit) calloc(edges\n, c.sizeof(c.LmxReparentEdit)))
        if: edits\data = 0
            return: LMX_REPARENT_NOMEM
        ---
    ---
    i: 0U
    while: i < edges\n
        edge: edges\data + i
        if: edge\value != 0 && edge\view != 0
            target_profile: lmx_range_sealed_profile(edge\view, edge\value)
            if: target_profile != 0 && lmx_copy_map_get(selected, (cast: (@: void) target_profile)) != 0
                if: edge\source_profile = 0 || lmx_copy_map_get(selected, (cast: (@: void) edge\source_profile)) = 0
                    after: lmx_copy_map_get(@ stage\relocated, edge\value)
                    if: after = 0 || lmx_range_classify(@ stage\arena, after) = c.LMX_KIND_NONE
                        status: LMX_REPARENT_INVALID
                        break
                    ---
                    slot: edge\slot
                    entry: lmx_range_entry_at(edge\view, (cast: (@: void) slot))
                    if: slot = 0 || entry = 0 || entry\owner != edge\view || entry\array = 0 || entry\array\sealed != 0U || entry\array\stride = 0U
                        status: LMX_REPARENT_INVALID
                        break
                    ---
                    stride: entry\array\stride
                    offset: (cast: (size_t) slot) - (cast: (size_t) entry\lo)
                    cell: (cast: (@: void) ((cast: (size_t) entry\lo) + (offset / stride) * stride))
                    if: lmx_range_classify(edge\view, cell) = c.LMX_KIND_NONE || \slot != edge\value
                        status: LMX_REPARENT_INVALID
                        break
                    ---
                    duplicate: 0
                    j: 0U
                    while: j < edits\n
                        edit: edits\data + j
                        if: edit\slot = edge\slot
                            if: edit\before != edge\value || edit\after != after || edit\view != edge\view
                                status: LMX_REPARENT_INVALID
                            ---
                            duplicate: 1
                            break
                        ---
                        j: j + 1U
                    ---
                    if: status != LMX_REPARENT_OK
                        break
                    ---
                    if: duplicate = 0
                        edit: edits\data + edits\n
                        edit\slot: edge\slot
                        edit\before: edge\value
                        edit\after: after
                        edit\view: edge\view
                        edits\n: edits\n + 1U
                    ---
                ---
            ---
        ---
        i: i + 1U
    ---
    if: status != LMX_REPARENT_OK
        lmx_reparent_edits_dispose(edits)
    ---
return: status

# All potentially failing imports happen before attach or a source-slot
# change. The fresh copied profiles cannot have pre-existing imports in any
# Message arena. On a failure, dropping their temporary views is exact.
sub: lmx_reparent_drop_staged_imports (@: LmxArena moved_arena; @: LmxReparentCopyStage stage; @: LmxReparentEdits edits)
    @: LmxReparentEdit edit
    @: Lmx profile
    size_t: i 0U
    size_t: j
    while: i < edits\n
        edit: edits\data + i
        if: edit\view != moved_arena
            j: 0U
            while: j < stage\n
                profile: lmx_range_sealed_profile(@ stage\arena, (cast: (@: void) stage\results[j]))
                if: profile != 0
                    lmx_range_unimport_profile(edit\view, profile)
                ---
                j: j + 1U
            ---
        ---
        i: i + 1U
    ---
end: lmx_reparent_drop_staged_imports

fn: lmx_reparent_publish_copy_stage (@: LmxArena moved_arena; @: LmxReparentCopyStage stage; @: LmxReparentEdits edits) int
    @: LmxReparentEdit edit
    @: LmxRange entry
    @: Lmx profile
    @@: void old_profiles
    @@: void slot
    size_t: i
    size_t: j
    if: moved_arena = 0 || stage = 0 || stage\qualified = 0 || stage\n = 0U || stage\results = 0 || edits = 0 || (edits\n != 0U && edits\data = 0) || moved_arena = (@ stage\arena)
        return: LMX_REPARENT_INVALID
    ---
    i: 0U
    while: i < edits\n
        edit: edits\data + i
        slot: edit\slot
        if: slot = 0 || edit\view = 0 || \slot != edit\before || lmx_range_classify(@ stage\arena, edit\after) = c.LMX_KIND_NONE
            return: LMX_REPARENT_INVALID
        ---
        i: i + 1U
    ---
    i: 0U
    while: i < edits\n
        edit: edits\data + i
        if: edit\view != moved_arena
            j: 0U
            while: j < stage\n
                profile: lmx_range_sealed_profile(@ stage\arena, (cast: (@: void) stage\results[j]))
                if: profile = 0 || lmx_range_import_profile(edit\view, @ stage\arena, profile) != 0
                    lmx_reparent_drop_staged_imports(moved_arena, stage, edits)
                    return: LMX_REPARENT_NOMEM
                ---
                j: j + 1U
            ---
        ---
        i: i + 1U
    ---
    if: lmx_arena_attach(moved_arena, @ stage\arena) != 0
        lmx_reparent_drop_staged_imports(moved_arena, stage, edits)
        return: LMX_REPARENT_NOMEM
    ---
    # Imports still name the live stage object. Attach moved the physical
    # storage without changing its address. Rehome those range rows before
    # the disposable stage goes out of scope; this pass cannot fail.
    i: 0U
    while: i < edits\n
        edit: edits\data + i
        if: edit\view != moved_arena
            j: 0U
            while: j < lmx_arena_index_len(edit\view)
                entry: lmx_arena_index_data(edit\view) + j
                if: entry\owner = (@ stage\arena)
                    entry\owner: moved_arena
                ---
                j: j + 1U
            ---
        ---
        i: i + 1U
    ---
    lmx_copy_names_finish(@ stage\pending, 1)
    i: 0U
    while: i < edits\n
        edit: edits\data + i
        slot: edit\slot
        \slot: edit\after
        i: i + 1U
    ---
    # Selected source profiles are no longer addressed by the moved graph.
    # Locally owned old ranges remain; only foreign imports can be dropped.
    old_profiles: lmx_copy_map_keys_data(@ stage\targets)
    j: 0U
    while: j < lmx_copy_map_keys_cap(@ stage\targets)
        if: old_profiles[j] != 0
            lmx_range_unimport_profile(moved_arena, (cast: (@: Lmx) old_profiles[j]))
        ---
        j: j + 1U
    ---
    i: 0U
    while: i < edits\n
        edit: edits\data + i
        j: 0U
        while: j < lmx_copy_map_keys_cap(@ stage\targets)
            if: old_profiles[j] != 0
                lmx_range_unimport_profile(edit\view, (cast: (@: Lmx) old_profiles[j]))
            ---
            j: j + 1U
        ---
        i: i + 1U
    ---
    lmx_reparent_copy_stage_dispose(stage)
return: LMX_REPARENT_OK

# One dry-run uses the same staging path and discards every copied cell and
# pending name, whether its reached profiles are complete or not.
fn: lmx_reparent_probe_copy_set (@: LmxArena view; @: LmxCopyMap selected; @: LmxCopyMap retained; @@: Lmx missing) int
    LmxReparentCopyStage: stage
    int: status lmx_reparent_stage_copy_set(view, selected, retained, @ stage, missing)
    if: status = LMX_REPARENT_OK && \missing = 0
        lmx_reparent_copy_stage_dispose(@ stage)
    ---
return: status

fn: lmx_reparent_close_copy_set (@: LmxThread moved; @: LmxThread new_parent; @: LmxArena view; @: LmxCopyMap selected; @: LmxCopyMap retained) int
    @: Lmx missing 0
    int: status
    if: moved = 0 || new_parent = 0 || view = 0 || selected = 0 || retained = 0
        return: LMX_REPARENT_INVALID
    ---
    while: 1
        status: lmx_reparent_probe_copy_set(view, selected, retained, @ missing)
        if: status != LMX_REPARENT_OK
            return: status
        ---
        if: missing = 0
            return: LMX_REPARENT_OK
        ---
        status: lmx_reparent_route_missing_profile(moved, new_parent, view, missing, selected, retained)
        if: status != LMX_REPARENT_OK
            return: status
        ---
    ---
return: LMX_REPARENT_INVALID

fn: lmx_reparent_preflight (@: LmxThread moved; @: LmxThread new_parent) int
    LmxCopyMap: lost
    int: status lmx_reparent_lost_profiles(moved, new_parent, @ lost)
    lmx_copy_map_dispose(@ lost)
return: status
