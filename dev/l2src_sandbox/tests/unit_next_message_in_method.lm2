# The receiver is general, not entry-only: a method called during R0's turn
# takes the letter of the current Thread, and the entry then finds none.
fn: take () int
    nextMessage: letter
    if: letter = 0
        return: 1
return: 0

if: take() != 0
    return: 1
nextMessage: after
if: after != 0
    return: 2
return: 0
