include: "l2src/tests/opaque_bound_views_test.h"
Other: (int: x 0; int: y 0)
Model: (int: v 11; int: w 22)
OtherGood: (int: x 17; int: y 19)
box: merge(Model)
int: entered 0
fn: opaque () @: void
return: c.l2_test_opaque_bound(0)
fn: use () int
    node\entered: node\entered + 1
    box\v: 41
    return: 81
end: use
fn: check () int
    @: seeded Other OtherGood
    if: seeded\x != 17
        return: 83
    @: box void opaque()
    int: answer 84
    answer: use()
    catch: implements ()
        answer: 7
    ---
    if: answer != 7 || node\entered != 0
        return: 82
    return: 7
end: check
sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
