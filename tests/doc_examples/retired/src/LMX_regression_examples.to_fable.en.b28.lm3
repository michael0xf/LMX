several_ops:
    int@: left
    int@[]: right
    const: int: PASS_ARGS_AS_IS 0
    const: int: PRIORITY sys\priority("+")
    return: int
    weighted:
        return: \left * 1000 + \right[0] * 100 + \right[1] * 10 + \right[2]

several:
    return: int
    demo:
        import: several_ops
        return: (2 weighted 3 5 7)
