# The letter is an ordinary typed value: a MainLetter formal receives the same
# reference the entry holds, and a typed formal reads its fields -- the formal's
# own argument, not the declaration.
MainLetter:
    char: []: []: mainArgs
end: MainLetter

MainLetter: m
receiveMessage: m

fn: same (MainLetter: letter) int
    if: letter = m
        return: 1
return: 0

fn: first (MainLetter: letter) int
return: letter\mainArgs[0][0]

if: m = 0
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
if: same(m) != 1
    sendMessage: exit(exit_code: 82; stdout: ""; stderr: "")
    return
if: first(m) = 0
    sendMessage: exit(exit_code: 83; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
