# take(h\a\p). The leaf is Rich, not Equatable. take reads equals.
# Rich has equals and an unread extra. Entry 7.

Rich:
    size_t: equals 0U
    size_t: extra 0U
end: Rich

Mid:
    Rich: p
end: Mid

Holder:
    Mid: a
end: Holder

Equatable:
    size_t: equals 0U
end: Equatable

fn: take (Equatable: slot) int
    slot\equals: 1U
return: 4

fn: pass (Holder: h) int
return: take(h\a\p)

fn: go () int
return: pass(Holder)

int: k
k: go()
if: k = 4
    sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
return
