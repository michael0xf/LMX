    int: last
    required: vector first last
    return: int
    eraseRange:
        throws: copy(MapThrows)
        if: last < first
            throw: MapFailure("ordered range")
        int: begin MapOrdered\lowerBound(vector; first)
        int: end MapOrdered\upperBound(vector; last)
        return: MapVector\erase(vector; begin; end)

