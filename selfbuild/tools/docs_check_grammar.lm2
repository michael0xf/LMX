# Unselected ordinary L2 check_docs.py grammar assertions.
# Retains the maintained renderer, source hashes and exact excerpt checks.
# No CLI/recipe replacement or successful execution is claimed yet.

fn: dc_string (@: data char; size_t: count; size_t: object_at; @: key char; @@: out char; @: out_count size_t) int
    size_t: first 0U
    size_t: last 0U
    size_t: after 0U
    out[0]: 0
    out_count[0]: 0U
    if: dj_property(data, count, object_at, key, @ first, @ last) != 1
        return: 1
    if: dj_string(data, count, first, out, out_count, @ after) != 0
        return: 1
    if: after != last
        c.free(out[0])
        out[0]: 0
        out_count[0]: 0U
        return: 1
    return: 0
end: dc_string

fn: dc_nonempty (@: data char; size_t: count; size_t: object_at; @: key char) int
    @: text char 0
    size_t: text_count 0U
    size_t: first 0U
    size_t: last 0U
    int: failed dc_string(data, count, object_at, key, @ text, @ text_count)
    if: failed = 0
        failed: dt_trim(text, text_count, 1, 1, @ first, @ last)
        if: first = last
            failed: 1
        ---
    ---
    c.free(text)
    return: failed
end: dc_nonempty

fn: dc_counter (@: data char; size_t: count; size_t: first; size_t: last; size_t: wanted) int
    @: spelling char c.calloc(32U, 1U)
    size_t: after 0U
    int: kind 0
    int: same 0
    int: written 0
    if: spelling = 0
        return: 0
    written: c.snprintf(spelling, 32U, "%zu", wanted)
    if: written > 0 && written < 32
        kind: dj_span(data, count, first, @ after)
        if: after = last
            same: de_number(spelling, 0U, (cast: (size_t) written), data, first, last, kind)
        ---
    ---
    c.free(spelling)
    return: (cast: (int) (same = 1))
end: dc_counter

# Python's lines[start-1:end] index adjustment. Integers/bools are indexable,
# end=None means the end, but start=None cannot be subtracted. Floats are not
# indexable; huge magnitudes clamp. start=0 means -1 before adjustment.
fn: dc_slice_index (@: data char; size_t: first; size_t: last; size_t: total; int: start; @: out size_t) int
    size_t: pos first
    size_t: value 0U
    size_t: digit 0U
    size_t: after 0U
    size_t: limit (cast: (size_t) -1)
    int: negative 0
    int: overflow 0
    int: kind dj_span(data, last, first, @ after)
    if: kind = 7 && start = 0
        out[0]: total
        return: 0
    if: kind = 5
        value: 1U
        pos: last
    else:
        if: kind = 6
            pos: last
        else:
            if: kind != 4 || after != last
                return: 1
            if: pos < last && data[pos] = (cast: (char) 45)
                negative: 1
                pos: pos + 1U
            while: pos < last
                if: data[pos] < (cast: (char) 48) || data[pos] > (cast: (char) 57)
                    return: 1
                digit: (cast: (size_t) (data[pos] - (cast: (char) 48)))
                if: overflow = 0
                    if: value > (limit - digit) / 10U
                        overflow: 1
                    else:
                        value: value * 10U + digit
                    ---
                ---
                pos: pos + 1U
            ---
        ---
    ---
    if: value = 0U && overflow = 0
        negative: 0
    if: negative != 0
        out[0]: 0U
        if: overflow = 0 && value < total
            out[0]: total - value
            if: start != 0
                out[0]: out[0] - 1U
            ---
        ---
        return: 0
    ---
    if: start != 0
        if: value = 0U && overflow = 0
            out[0]: 0U
            if: total > 0U
                out[0]: total - 1U
            return: 0
        ---
        out[0]: total
        if: overflow = 0 && value <= total
            out[0]: value - 1U
        ---
    else:
        out[0]: total
        if: overflow = 0 && value < total
            out[0]: value
        ---
    ---
    return: 0
end: dc_slice_index

fn: dc_excerpt (@: text char; size_t: count; @: raw char; @: starts size_t; @: lengths size_t; size_t: first; size_t: after) int
    size_t: line first
    size_t: at 0U
    while: line < after
        if: line > first
            if: at >= count || text[at] != (cast: (char) 10)
                return: 1
            at: at + 1U
        ---
        if: lengths[line] > count - at || c.memcmp(text + at, raw + starts[line], lengths[line]) != 0
            return: 1
        at: at + lengths[line]
        line: line + 1U
    ---
    return: (cast: (int) (at != count))
end: dc_excerpt

fn: dc_rendered_file (@: stream c.FILE; @: path char) int
    @: expected char 0
    @: raw char 0
    @: actual char 0
    size_t: expected_count 0U
    size_t: raw_count 0U
    size_t: actual_count 0U
    int: failed db_stream_read(stream, @ expected, @ expected_count)
    if: failed = 0
        raw: file_read(path, @ raw_count)
        if: raw = 0
            failed: 1
        else:
            failed: dt_text(raw, raw_count, 0, @ actual, @ actual_count)
        ---
    ---
    if: failed = 0 && (expected_count != actual_count || c.memcmp(expected, actual, expected_count) != 0)
        failed: 1
    c.free(expected)
    c.free(raw)
    c.free(actual)
    return: failed
end: dc_rendered_file

fn: dc_prior_id (@: data char; size_t: count; size_t: sections_at; size_t: current_at; @: id char; size_t: id_count) int
    @: previous char 0
    size_t: previous_count 0U
    size_t: pos dj_ws(data, count, sections_at + 1U)
    size_t: after 0U
    int: failed 0
    while: pos < current_at
        if: dc_string(data, count, pos, "id", @ previous, @ previous_count) != 0
            return: 1
        failed: (cast: (int) (previous_count = id_count && c.memcmp(previous, id, id_count) = 0))
        c.free(previous)
        previous: 0
        if: failed != 0
            return: 1
        if: dj_span(data, count, pos, @ after) != 2 || dj_array_next(data, count, after, @ pos) != 0
            return: 1
    ---
    return: 0
end: dc_prior_id

fn: dc_ids (@: data char; size_t: count; size_t: sections_at) int
    @: id char 0
    size_t: id_count 0U
    size_t: pos dj_ws(data, count, sections_at + 1U)
    size_t: after 0U
    int: failed 0
    while: data[pos] != (cast: (char) 93) && failed = 0
        failed: dc_string(data, count, pos, "id", @ id, @ id_count)
        if: failed = 0
            failed: dc_prior_id(data, count, sections_at, pos, id, id_count)
        c.free(id)
        id: 0
        if: failed = 0
            if: dj_span(data, count, pos, @ after) != 2 || dj_array_next(data, count, after, @ pos) != 0
                failed: 1
            ---
        ---
    ---
    return: failed
end: dc_ids

fn: dc_sections (@: data char; size_t: count; size_t: sections_at; @: source char; @: starts size_t; @: lengths size_t; size_t: source_lines; @: out_sections size_t; @: out_examples size_t) int
    @: text char 0
    @: lang char "ru"
    size_t: pos dj_ws(data, count, sections_at + 1U)
    size_t: section_after 0U
    size_t: first 0U
    size_t: last 0U
    size_t: after 0U
    size_t: member 0U
    size_t: examples_at 0U
    size_t: example_at 0U
    size_t: example_after 0U
    size_t: text_count 0U
    size_t: trim_first 0U
    size_t: trim_last 0U
    size_t: slice_first 0U
    size_t: slice_last 0U
    size_t: sections 0U
    size_t: excerpts 0U
    int: language 0
    int: found 0
    int: failed 0
    while: pos < count && data[pos] != (cast: (char) 93) && failed = 0
        sections: sections + 1U
        if: dj_span(data, count, pos, @ section_after) != 2 || dj_property(data, count, pos, "number", @ first, @ last) != 1 || dc_counter(data, count, first, last, sections) = 0
            failed: 1
        language: 0
        while: language < 2 && failed = 0
            lang: "ru"
            if: language = 1
                lang: "en"
            if: dj_property(data, count, pos, lang, @ member, @ after) != 1 || member >= count || data[member] != (cast: (char) 123)
                failed: 1
            else:
                if: dc_nonempty(data, count, member, "title") != 0 || dc_nonempty(data, count, member, "text") != 0
                    failed: 1
                ---
            ---
            language: language + 1
        ---
        if: failed = 0
            if: dj_property(data, count, pos, "examples", @ examples_at, @ after) != 1 || data[examples_at] != (cast: (char) 91)
                failed: 1
            ---
        ---
        if: failed = 0
            example_at: dj_ws(data, count, examples_at + 1U)
            while: data[example_at] != (cast: (char) 93) && failed = 0
                if: dj_span(data, count, example_at, @ example_after) != 2 || dc_string(data, count, example_at, "text", @ text, @ text_count) != 0
                    failed: 1
                else:
                    if: dt_trim(text, text_count, 1, 1, @ trim_first, @ trim_last) != 0 || trim_first = trim_last
                        failed: 1
                    if: failed = 0 && dt_find(text, text_count, 0U, "````", 4U) != (cast: (size_t) -1)
                        failed: 1
                    if: failed = 0
                        found: dj_property(data, count, example_at, "start", @ first, @ last)
                        if: found < 0
                            failed: 1
                        if: found = 1
                            excerpts: excerpts + 1U
                            if: source != 0
                                failed: dc_slice_index(data, first, last, source_lines, 1, @ slice_first)
                                if: failed = 0
                                    if: dj_property(data, count, example_at, "end", @ first, @ last) != 1
                                        failed: 1
                                    else:
                                        failed: dc_slice_index(data, first, last, source_lines, 0, @ slice_last)
                                    ---
                                ---
                                if: failed = 0
                                    failed: dc_excerpt(text, text_count, source, starts, lengths, slice_first, slice_last)
                                ---
                            ---
                        ---
                    ---
                ---
                c.free(text)
                text: 0
                if: failed = 0
                    failed: dj_array_next(data, count, example_after, @ example_at)
                ---
            ---
        ---
        if: failed = 0
            failed: dj_array_next(data, count, section_after, @ pos)
        ---
    ---
    c.free(text)
    if: failed = 0
        out_sections[0]: sections
        out_examples[0]: excerpts
    return: failed
end: dc_sections

fn: docs_grammar_check (@: repo char; @: out_sections size_t; @: out_examples size_t) int
    @: input char txt_path(repo, "provenance/grammar.json")
    @: ru_path char txt_path(repo, "docs/LMX_grammar.ru.md")
    @: en_path char txt_path(repo, "docs/LMX_grammar.en.md")
    @: data char 0
    @: source_path char 0
    @: source char 0
    @: digest char 0
    @: expected char 0
    @: starts size_t 0
    @: lengths size_t 0
    @: stream c.FILE 0
    size_t: count 0U
    size_t: root 0U
    size_t: after 0U
    size_t: sections_at 0U
    size_t: source_at 0U
    size_t: source_path_count 0U
    size_t: source_count 0U
    size_t: source_lines 0U
    size_t: expected_count 0U
    size_t: rendered_sections 0U
    size_t: rendered_examples 0U
    size_t: limit (cast: (size_t) -1)
    int: failed 0
    if: input = 0 || ru_path = 0 || en_path = 0 || out_sections = 0 || out_examples = 0
        failed: 1
    if: failed = 0
        data: file_read(input, @ count)
        if: data = 0 || dj_document(data, count, @ root, @ after) != 2
            failed: 1
        ---
    ---
    if: failed = 0
        stream: c.tmpfile()
        if: stream = 0
            failed: 1
        else:
            failed: dg_render(data, count, "ru", stream, @ rendered_sections, @ rendered_examples)
            if: failed = 0
                failed: dc_rendered_file(stream, ru_path)
            if: c.fclose(stream) != 0
                failed: 1
            stream: 0
        ---
    ---
    if: failed = 0
        stream: c.tmpfile()
        if: stream = 0
            failed: 1
        else:
            failed: dg_render(data, count, "en", stream, @ rendered_sections, @ rendered_examples)
            if: failed = 0
                failed: dc_rendered_file(stream, en_path)
            if: c.fclose(stream) != 0
                failed: 1
            stream: 0
        ---
    ---
    if: failed = 0
        if: dj_property(data, count, root, "sections", @ sections_at, @ after) != 1 || data[sections_at] != (cast: (char) 91)
            failed: 1
        else:
            failed: dc_ids(data, count, sections_at)
        ---
    ---
    if: failed = 0
        if: dj_property(data, count, root, "source", @ source_at, @ after) != 1 || dc_string(data, count, source_at, "path", @ source_path, @ source_path_count) != 0
            failed: 1
        ---
    ---
    if: failed = 0 && c.strlen(source_path) = source_path_count && sem_file_kind(source_path) = 1
        source: file_read(source_path, @ source_count)
        digest: c.calloc(65U, 1U)
        if: source = 0 || digest = 0 || dc_string(data, count, source_at, "sha256", @ expected, @ expected_count) != 0
            failed: 1
        else:
            if: sha256_bytes(source, source_count, digest) != 0 || expected_count != 64U || c.memcmp(digest, expected, 64U) != 0
                failed: 1
            ---
        ---
        if: failed = 0
            failed: dt_lines(source, source_count, 1, 0, 0, 0U, @ source_lines)
            if: failed = 0 && source_lines < limit / c.sizeof(c.size_t)
                starts: c.calloc(source_lines + 1U, c.sizeof(c.size_t))
                lengths: c.calloc(source_lines + 1U, c.sizeof(c.size_t))
                if: starts = 0 || lengths = 0
                    failed: 1
                else:
                    failed: dt_lines(source, source_count, 1, starts, lengths, source_lines, @ source_lines)
                ---
            else:
                failed: 1
            ---
        ---
    ---
    if: failed = 0
        failed: dc_sections(data, count, sections_at, source, starts, lengths, source_lines, out_sections, out_examples)
    c.free(input)
    c.free(ru_path)
    c.free(en_path)
    c.free(data)
    c.free(source_path)
    c.free(source)
    c.free(digest)
    c.free(expected)
    c.free(starts)
    c.free(lengths)
    return: failed
end: docs_grammar_check
