# Ordinary L2 frontend name, path, declaration and value resolution.
# Address aliases borrow the existing compiler cells; they do not copy state.
predef: "l1src/p0.h.lm1"
predef: "l2src/l2_application.h.lm1"
predef: "l2src/l2_frontend_types.h.lm1"
predef: "l2src/l2_frontend_helpers.h.lm1"
predef: "l2src/l2_frontend_context.h.lm1"
predef: "l2src/l2_frontend_values.h.lm1"
predef: "l2src/l2_frontend_coords.h.lm1"
predef: "l2src/l2_frontend_alloc.h.lm1"
predef: "l2src/l2_frontend_views.h.lm1"
predef: "l2src/l2_machine_types.h.lm1"
include: "<stddef.h>" "<string.h>" "<stdlib.h>"

# Original: l2src/l2trans.lm1:2543
fn: lm_compiler_error_fatal (const: (@: path char); const: (@: source_node c.LmP0Node); const: (@: msg char)) int
    @: rw_quiet_cell int (cast: (@: int) (@ c.l2_rw_quiet))
    int: previous rw_quiet_cell[0]
    int: answer
    rw_quiet_cell[0]: 0
    answer: c.lm_compiler_error(path, source_node, msg)
    rw_quiet_cell[0]: previous
    return: (cast: (int) (answer))
end: lm_compiler_error_fatal

# Original: l2src/l2trans.lm1:2551
fn: lm_compiler_alloc_or (const: (@: path char); const: (@: at c.LmP0Node); const: (@: fallback char)) int
    @: alloc_err_cell int (cast: (@: int) (@ c.l2_alloc_err))
    if: alloc_err_cell[0] = 2
        return: (cast: (int) (c.lm_compiler_error(path, at, "size overflow")))
    if: alloc_err_cell[0] != 0
        return: (cast: (int) (c.lm_compiler_error(path, at, "out of memory")))
    return: (cast: (int) (c.lm_compiler_error(path, at, fallback)))
end: lm_compiler_alloc_or

# Original: l2src/l2trans.lm1:4039
fn: lm_compiler_head_absent (const: (@: t c.LmP0Text); const: (@: item c.LmP0Node)) int
    const: (@@: cur_unit_cell c.LmP0Structure (cast: (const: @@: c.LmP0Structure) (@ c.l2_cur_unit)))
    @: f c.LmP0Field
    @: got c.LmP0Text
    const: (@: site c.LmP0Node item)
    if: t = 0 || c.lm_compiler_ident(t) = 0 || c.lm_compiler_unit_names_method(t) != 0 || c.lm_compiler_site_method(0 - 1, t) >= 0
        return: (cast: (int) (0))
    # A nested receiver has the source site of its direct unit item.  Both
    # the declaration scan and the later prefix scan must stop there.
    if: site != 0 && cur_unit_cell[0] != 0
        f: c.lm_compiler_next_active((cast: (@: c.LmP0Field) (cur_unit_cell[0]\first_field)))
        while: f != 0
            if: c.lm_compiler_node_in((cast: (const: @: c.LmP0Node) (f\value)), site) != 0
                site: f\value
                break
            f: c.lm_compiler_next_active((cast: (@: c.LmP0Field) (f\next)))
        ---
    ---
    if: lm_compiler_unit_declares(t, site) != 0 || c.lm_compiler_is_known(t) != 0 || c.lm_compiler_predef_receiver(t) != 0 || (c.lm_compiler_prim_type_word(t) != 0 && c.lm_compiler_ns_find(t) < 0) || c.lm_compiler_head_word(t) != 0
        return: (cast: (int) (0))
    if: cur_unit_cell[0] = 0
        return: (cast: (int) (1))
    f: c.lm_compiler_next_active((cast: (@: c.LmP0Field) (cur_unit_cell[0]\first_field)))
    while: f != 0 && f\value != site
        # The receiver `@: t f(a)` of a factory's result above the item declares t (l2_receiver_frame): `t: 3 4`
        # below it applies t.  A method above the receiver has no binding of t (unit_held_call_above_unknown_head).
        if: c.lm_compiler_receiver_frame((cast: (const: @: c.LmP0Node) (f\value)), @ got) != 0 && c.lm_compiler_text_same(got, t) != 0
            return: (cast: (int) (0))
        # An earlier frame headed t binds t, whatever its tail is written as: its definition (the first written
        # occurrence of an unknown head), merge's construction or a reference binding (data).  A definition below
        # makes no head above it known: an ordinary named Structure is visible from its place on
        # (docs/LMX_semantics.en.md#declaration-visibility; the author, 2026-10-07).
        if: f\value != 0 && f\value\kind = c.LM_P0_NODE_FRAME && f\value\as != 0 && f\value\as\frame != 0 && f\value\as\frame\head != 0 && c.lm_compiler_text_same((cast: (const: @: c.LmP0Text) (f\value\as\frame\head)), t) != 0 && c.lm_compiler_retained_body((cast: (const: @: c.LmP0Frame) (f\value\as\frame))) != 0
            return: (cast: (int) (0))
        f: c.lm_compiler_next_active((cast: (@: c.LmP0Field) (f\next)))
    ---
    return: (cast: (int) (1))
end: lm_compiler_head_absent

# Original: l2src/l2trans.lm1:4081
fn: lm_compiler_value_receiver (const: (@: h c.LmP0Text)) int
    if: h = 0 || c.lm_compiler_head_word(h) = 0
        return: (cast: (int) (0))
    return: (cast: (int) ((cast: (int) (c.lm_compiler_text_eq(h, "merge") != 0))))
end: lm_compiler_value_receiver

# Original: l2src/l2trans.lm1:4089
fn: lm_compiler_consumed_type_value (const: (@: source_node c.LmP0Node); @@: out_contract c.L2TypeContract; @@: out_candidate c.LmP0Field; @: out_count int) int
    @: here_mi_cell int (cast: (@: int) (@ c.l2_here_mi))
    @: frame c.LmP0Frame c.lm_compiler_application(source_node)
    @: first c.LmP0Field
    @: inner c.L2TypeContract 0
    @: word c.LmP0Text
    int: count
    int: depth
    int: role
    if: out_contract != 0
        \out_contract: 0
    if: out_candidate != 0
        \out_candidate: 0
    if: out_count != 0
        \out_count: 0
    if: frame = 0 || frame\head = 0 || frame\body = 0 || frame\trailer != 0 || frame\body\trailer != 0
        return: (cast: (int) (0))
    first: c.lm_compiler_next_active((cast: (@: c.LmP0Field) (frame\body\first_field)))
    count: c.lm_compiler_count_active((cast: (const: @: c.LmP0Structure) (frame\body)))
    # The c. door covers raw C names in call and value positions, never a type receiver
    # (provenance/semantics-sources/l1.txt, the c. door: "It does not cover primitive type receivers"): `p: c.f(x)`
    # is the C call with one actual, its result received by p -- not a receiver `c.f` consuming x
    # (tests/cdoor/c_call_one_actual.lm2). A c. word stays a type word where a type is written: a declaration's
    # type field, a cast, an operand of sizeof.
    if: c.lm_compiler_prim_type_word((cast: (const: @: c.LmP0Text) (frame\head))) != 0 && c.lm_compiler_c_stmt_door((cast: (const: @: c.LmP0Text) (frame\head))) = 0
        if: count > 0 && lm_compiler_fields_one_value(first, count) = 0
            return: (cast: (int) (0))
        if: out_contract != 0
            inner: c.lm_compiler_contract_new(0, 0, (cast: (const: @: c.LmP0Text) (frame\head)), 0)
            if: inner = 0
                return: (cast: (int) (0))
            # A named Structure value is a reference to that Structure, not
            # an inline primitive cell. This is the ordinary resolved type
            # role, shared by direct and composed receiving places.
            if: lm_compiler_head_resolve(here_mi_cell[0], (cast: (const: @: c.LmP0Text) (frame\head)), 0, 0) = 5
                \out_contract: c.lm_compiler_contract_new(2, 1, 0, inner)
            else:
                \out_contract: inner
            ---
            if: \out_contract = 0
                return: (cast: (int) (0))
        ---
        if: out_candidate != 0
            \out_candidate: first
        if: out_count != 0
            \out_count: count
        return: (cast: (int) (1))
    ---
    depth: c.lm_compiler_address_depth((cast: (const: @: c.LmP0Text) (frame\head)))
    if: depth = 0
        return: (cast: (int) (0))
    # The empty receiver makes an uninitialised void reference; an explicit
    # zero has the same type but retains its source candidate and its write.
    if: count = 0 || c.lm_compiler_reference_null_literal(first, count) != 0
        if: out_contract != 0
            inner: c.lm_compiler_contract_new(0, 0, lm_compiler_void_text(), 0)
            if: inner = 0
                return: (cast: (int) (0))
            \out_contract: c.lm_compiler_contract_new(2, depth, 0, inner)
            if: \out_contract = 0
                return: (cast: (int) (0))
        ---
        if: out_candidate != 0
            \out_candidate: first
        if: out_count != 0
            \out_count: count
        return: (cast: (int) (1))
    ---
    if: count != 1 || first = 0 || first\value = 0
        return: (cast: (int) (0))
    if: first\value\kind = c.LM_P0_NODE_ATOM && first\value\as != 0
        word: first\value\as\atom
        role: lm_compiler_head_resolve(here_mi_cell[0], word, 0, 0)
        if: role != 5 && role != 2 && c.lm_compiler_prim_type_word(word) = 0
            return: (cast: (int) (0))
        if: out_contract != 0
            inner: c.lm_compiler_contract_new(0, 0, word, 0)
            if: inner = 0
                return: (cast: (int) (0))
            \out_contract: c.lm_compiler_contract_new(2, depth, 0, inner)
            if: \out_contract = 0
                return: (cast: (int) (0))
        ---
        if: (role = 5 || role = 2) && out_candidate != 0
            \out_candidate: first
        if: (role = 5 || role = 2) && out_count != 0
            \out_count: 1
        return: (cast: (int) (1))
    ---
    if: first\value\kind != c.LM_P0_NODE_FRAME
        return: (cast: (int) (0))
    if: out_contract = 0
        return: (cast: (int) (lm_compiler_consumed_type_value((cast: (const: @: c.LmP0Node) (first\value)), 0, 0, 0)))
    if: lm_compiler_consumed_type_value((cast: (const: @: c.LmP0Node) (first\value)), @ inner, out_candidate, out_count) = 0 || inner = 0
        return: (cast: (int) (0))
    # Model: Other already yields a one-level Structure reference. An outer
    # @ expresses that same reference; further explicit levels still add up.
    role: lm_compiler_head_resolve(here_mi_cell[0], (cast: (const: @: c.LmP0Text) (c.lm_compiler_app_head((cast: (const: @: c.LmP0Node) (first\value))))), 0, 0)
    if: role = 5 && inner\kind = 2
        if: depth = 1
            \out_contract: inner
            return: (cast: (int) (1))
        ---
        depth: depth - 1
    ---
    \out_contract: c.lm_compiler_contract_new(2, depth, 0, inner)
    return: (cast: (int) ((cast: (int) (\out_contract != 0))))
end: lm_compiler_consumed_type_value

# Original: l2src/l2trans.lm1:4207
fn: lm_compiler_decl_content_core (const: (@: fr c.LmP0Frame); const: (@: site c.LmP0Node); int: mi; int: me) int
    @: f c.LmP0Field
    @: nested c.L2Declaration
    if: fr = 0 || fr\body = 0
        return: (cast: (int) (0))
    f: c.lm_compiler_next_active((cast: (@: c.LmP0Field) (fr\body\first_field)))
    if: f = 0 || f\value = 0
        return: (cast: (int) (0))
    if: lm_compiler_value_receiver((cast: (const: @: c.LmP0Text) (c.lm_compiler_app_head((cast: (const: @: c.LmP0Node) (f\value)))))) != 0 || lm_compiler_qual_value_app((cast: (const: @: c.LmP0Node) (f\value))) != 0
        return: (cast: (int) (3))
    # The inner descriptor only describes syntax; `int: old` has one even
    # when old already names a value. At the OUTER occurrence an existing
    # name is consumed by this receiver, while an absent name introduces a
    # field of the outer Structure (`Model: int: v 11`).
    if: c.lm_compiler_count_active((cast: (const: @: c.LmP0Structure) (fr\body))) = 1 && lm_compiler_consumed_type_value((cast: (const: @: c.LmP0Node) (f\value)), 0, 0, 0) != 0
        nested: lm_compiler_declaration((cast: (const: @: c.LmP0Node) (f\value)))
        if: nested = 0 || nested\name = 0
            return: (cast: (int) (4))
        if: me >= 0 && lm_compiler_ns_site_known((cast: (const: @: c.LmP0Text) (nested\name)), me) != 0
            return: (cast: (int) (4))
        if: me < 0 && mi >= 0 && lm_compiler_head_resolve(mi, (cast: (const: @: c.LmP0Text) (nested\name)), 0, 0) != 0
            return: (cast: (int) (4))
        if: me < 0 && lm_compiler_head_absent((cast: (const: @: c.LmP0Text) (nested\name)), site) = 0
            return: (cast: (int) (4))
        ---
    ---
    return: (cast: (int) (1))
end: lm_compiler_decl_content_core

# Original: l2src/l2trans.lm1:4238
fn: lm_compiler_decl_content (const: (@: fr c.LmP0Frame); const: (@: site c.LmP0Node); int: mi; int: me) int
    @: here_cell size_t (cast: (@: size_t) (@ c.l2_here))
    @: here_on_cell int (cast: (@: int) (@ c.l2_here_on))
    @: here_mi_cell int (cast: (@: int) (@ c.l2_here_mi))
    @: here_source_mi_cell int (cast: (@: int) (@ c.l2_here_source_mi))
    @@: here_node_cell c.LmP0Node (cast: (@@: c.LmP0Node) (@ c.l2_here_node))
    @: ns_take_mi_cell int (cast: (@: int) (@ c.l2_ns_take_mi))
    size_t: saved_here here_cell[0]
    int: saved_on here_on_cell[0]
