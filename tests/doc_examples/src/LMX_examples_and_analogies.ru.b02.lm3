Arithmetic:
    int: value
    return: int
    twice:
        return: value * 2
    plusOne:
        return: value + 1

ApplyProbe:
    return: int
    run:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
        @: chosen Arithmetic\twice
        @: firstRecord apply(chosen; (7))
        int: first \firstRecord
        chosen := Arithmetic\plusOne
        @: secondRecord apply(chosen; (7))
        int: second \secondRecord
        return: first * 100 + second
