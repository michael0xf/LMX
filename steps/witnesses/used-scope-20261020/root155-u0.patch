+fn: l2_path_root_close (@: L2Path path; int: mi) int
+    if: path = 0
+        return: 1
+    if: path\root_ft != -2
+        return: 0
+    path\root_ft: l2_path_selected_binding_ft(path, mi)
+    path\root_level: l2_path_selected_contract(path, mi)
