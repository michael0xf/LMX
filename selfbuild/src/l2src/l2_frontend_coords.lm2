    while: r < mrs_n_cell[0]
        if: mrs_res_cell[0][r] = res && lm_compiler_mrs_row_root(r) = ni
            return: (cast: (int) (1))
        r: r + 1
    ---
    return: (cast: (int) (0))
end: lm_compiler_mrs_has_root

fn: lm_compiler_mrs_operand_reference (int: res) int
    @: nsf_n_cell int (cast: (@: int) (@ c.l2_nsf_n))
    @@: nsf_kind_cell int (cast: (@@: int) (@ c.l2_nsf_kind))
    @@: nsf_val_cell size_t (cast: (@@: size_t) (@ c.l2_nsf_val))
    @@: nsf_seed_cell int (cast: (@@: int) (@ c.l2_nsf_seed))
    @@: nsf_owner_cell int (cast: (@@: int) (@ c.l2_nsf_owner))
    @@: ns_parent_cell int (cast: (@@: int) (@ c.l2_ns_parent))
    @: ns_n_cell int (cast: (@: int) (@ c.l2_ns_n))
    @@: ns_eternal_cell int (cast: (@@: int) (@ c.l2_ns_eternal))
    int: q 0
    int: e
    int: ref
    while: q < nsf_n_cell[0]
        if: nsf_kind_cell[0][q] = 10 && (nsf_val_cell[0][q] != 0U || nsf_seed_cell[0][q] > 0)
            if: nsf_seed_cell[0][q] > 0
                ref: nsf_seed_cell[0][q] - 1
            else:
                ref: (cast: (int) nsf_val_cell[0][q]) - 1
            ---
            e: nsf_owner_cell[0][q]
            while: e >= 0 && ns_parent_cell[0][e] >= 0
                e: ns_parent_cell[0][e]
            ---
            while: ref >= 0 && ns_parent_cell[0][ref] >= 0
                ref: ns_parent_cell[0][ref]
            ---
            if: ref >= 0 && ref < ns_n_cell[0] && e != ref && ns_eternal_cell[0][ref] < 0 && lm_compiler_mrs_has_root(res, e) != 0 && lm_compiler_mrs_has_root(res, ref) != 0
                return: (cast: (int) (q))
            ---
        q: q + 1
    ---
    return: (cast: (int) (0 - 1))
end: lm_compiler_mrs_operand_reference
