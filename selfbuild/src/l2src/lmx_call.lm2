# Common call and publication, direct machine entries (L2 section20).
# All arenas, code/data, storage and status outputs are explicit. No unit state or installed backend hook.
predef: "l2src/lmx_call.h.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l2src/lmx_implements.h.lm1"
predef: "l2src/lmx_walk.h.lm1"
predef: "l2src/lmx_value_owned.h.lm1"
predef: "l2src/lmx_primitive.h.lm1"
predef: "l2src/lmx_graph.h.lm1"
predef: "l2src/lmx_source_names.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<string.h>"
include: "<stdlib.h>" "<stdint.h>"

# ---- Installed native descriptors ----------------------------------------------------------
# One normative call table belongs to the arena. The same container holds construction-local pending rows.
# Only an installed live code key conditionally retains its descriptor; the bindings never roots its keys.
fn: lmx_native_hash (c.Lmx@: code) size_t
    size_t: word (cast: (size_t) (cast: (c.uintptr_t) code))
    return: (word >> 4U) ^ (word >> 17U)
end: lmx_native_hash

fn: lmx_native_slot (c.LmxNativeTable@: bindings; c.Lmx@: code) size_t
    size_t: slot lmx_native_hash(code) & (bindings\cap - 1U)
    c.LmxNativeBinding@: row bindings\rows + slot
    while: row\code != 0 && row\code != code
        slot := (slot + 1U) & (bindings\cap - 1U)
        row := bindings\rows + slot
    ---
    return: slot
end: lmx_native_slot

# Room was prepared; this insert cannot allocate or fail.
fn: lmx_native_put (c.LmxNativeTable@: bindings; c.Lmx@: code; c.Lmx@: descriptor) void
    size_t: slot lmx_native_slot(bindings, code)
    c.LmxNativeBinding@: row bindings\rows + slot
    if: row\code = 0
        bindings\len := bindings\len + 1U
    ---
    row\code := code
    row\descriptor := descriptor
    return
end: lmx_native_put

fn: lmx_native_reserve (c.LmxNativeTable@: bindings; size_t: need) int
    c.LmxNativeBinding@: old bindings\rows
    c.LmxNativeBinding@: row 0
    size_t: old_cap bindings\cap
    size_t: capacity 32U
    size_t: i 0U
    if: need <= bindings\cap / 2U
        return: 0
    while: capacity / 2U < need
        if: capacity > (cast: (size_t) -1) / 2U
            return: 1
        ---
        capacity := capacity * 2U
    ---
    if: capacity > (cast: (size_t) -1) / c.sizeof(c.LmxNativeBinding)
        return: 1
    row := (cast: (c.LmxNativeBinding@) c.calloc(capacity, c.sizeof(c.LmxNativeBinding)))
    if: row = 0
        return: 1
    bindings\rows := row
    bindings\cap := capacity
    bindings\len := 0U
    while: i < old_cap
        row := old + i
        if: row\code != 0
            lmx_native_put(bindings, (cast: (c.Lmx@) row\code), (cast: (c.Lmx@) row\descriptor))
        ---
        i := i + 1U
    ---
    c.free((cast: (@) old))
    return: 0
end: lmx_native_reserve

fn: lmx_native_remove (c.LmxNativeTable@: bindings; size_t: hole) void
    size_t: mask bindings\cap - 1U
    size_t: scan (hole + 1U) & mask
    size_t: home 0U
    c.LmxNativeBinding@: row bindings\rows + scan
    c.LmxNativeBinding@: target 0
    while: row\code != 0
        home := lmx_native_hash((cast: (c.Lmx@) row\code)) & mask
        if: ((scan - home) & mask) >= ((scan - hole) & mask)
            target := bindings\rows + hole
            target\code := row\code
            target\descriptor := row\descriptor
            hole := scan
        ---
        scan := (scan + 1U) & mask
        row := bindings\rows + scan
    ---
    target := bindings\rows + hole
    target\code := 0
    target\descriptor := 0
    bindings\len := bindings\len - 1U
    return
end: lmx_native_remove

# A pending row may explicitly request removal (descriptor 0). Installed bindings use bind instead.
fn: lmx_native_table_set (c.LmxNativeTable@: bindings; c.Lmx@: code; c.Lmx@: descriptor) int
    c.LmxNativeBinding@: row 0
    size_t: slot 0U
    if: bindings = 0 || code = 0
        return: 1
    if: bindings\len != 0U
        slot := lmx_native_slot(bindings, code)
        row := bindings\rows + slot
        if: row\code != 0
            row\descriptor := descriptor
            return: 0
        ---
    ---
    if: bindings\len = (cast: (size_t) -1) || lmx_native_reserve(bindings, bindings\len + 1U) != 0
        return: 1
    lmx_native_put(bindings, code, descriptor)
    return: 0
end: lmx_native_table_set

fn: lmx_native_table_dispose (c.LmxNativeTable@: bindings) void
    if: bindings = 0
        return
    c.free((cast: (@) bindings\rows))
    bindings\rows := 0
    bindings\len := 0U
    bindings\cap := 0U
    return
end: lmx_native_table_dispose

# Resolve the already registered physical owner. A read constructs and executes nothing.
# The physical owner has already been resolved by either public lookup.
fn: lmx_native_descriptor_owned (c.LmxArena@: owner; c.Lmx@: code) c.Lmx@
    c.LmxNativeTable@: bindings @ owner\native_calls
    c.LmxNativeBinding@: row 0
    if: bindings\len = 0U
        return: 0
    row := bindings\rows + lmx_native_slot(bindings, code)
    return: (cast: (c.Lmx@) row\descriptor)
end: lmx_native_descriptor_owned

fn: lmx_native_descriptor (c.LmxArena@: arena; c.Lmx@: code) c.Lmx@
    c.LmxArena@: owner 0
    if: arena = 0 || code = 0
        return: 0
    owner := c.lmx_range_home(arena, (cast: (@) code))
    if: owner = 0
        return: 0
    return: lmx_native_descriptor_owned(owner, code)
end: lmx_native_descriptor

# Existing callers retain their body/contract selection. One prepared C9 variant is currently emitted.
fn: lmx_native_entry (c.LmxArena@: arena; c.Lmx@: code) c.LmxPrimitiveEntry
    c.Lmx@: descriptor 0
    c.LmxArena@: owner 0
    c.Lmx@: variants 0
    c.Lmx@: variant 0
    @: leaf 0
    c.LmxPrimitive@: primitive 0
    c.LmxPool@: leaf_pool 0
    if: arena = 0 || code = 0
        return: 0
    owner := c.lmx_range_home(arena, (cast: (@) code))
    if: owner = 0
        return: 0
    descriptor := lmx_native_descriptor_owned(owner, code)
    if: descriptor = 0
        return: 0
    variants := (cast: (c.Lmx@) c.lmx_graph_value_in(owner, descriptor, 0U))
    variant := (cast: (c.Lmx@) c.lmx_graph_value_in(owner, variants, 0U))
    leaf := c.lmx_graph_value_in(owner, variant, 1U)
    # Resolve this physical object once; kind, type and stride come from that same pool.
    leaf_pool := (cast: (c.LmxPool@) c.lmx_range_cell_pool(owner, leaf))
    if: leaf_pool = 0 || leaf_pool\kind != c.LMX_DOMAIN_KIND_PRIMITIVE || c.lmx_type_base((cast: (int) leaf_pool\type)) != c.LMX_DOMAIN_PRIMITIVE || leaf_pool\stride != c.sizeof(c.LmxPrimitive)
        return: 0
    primitive := (cast: (c.LmxPrimitive@) leaf)
    return: (cast: (c.LmxPrimitiveEntry) primitive\fn)
end: lmx_native_entry

fn: lmx_native_bind (c.LmxArena@: arena; c.Lmx@: code; c.Lmx@: descriptor) int
    c.LmxArena@: owner 0
    c.LmxNativeTable@: bindings 0
    c.LmxNativeBinding@: row 0
    size_t: slot 0U
    if: arena = 0 || code = 0
        return: 1
    owner := c.lmx_range_home(arena, (cast: (@) code))
    if: owner = 0
        return: 1
    bindings := @ owner\native_calls
    if: descriptor = 0
        if: bindings\len != 0U
            slot := lmx_native_slot(bindings, code)
            row := bindings\rows + slot
            if: row\code != 0
                lmx_native_remove(bindings, slot)
            ---
        ---
        return: 0
    ---
    return: lmx_native_table_set(bindings, code, descriptor)
end: lmx_native_bind

# Construction has finished. Validate and reserve everything before publishing one row.
fn: lmx_native_publish (c.LmxArena@: arena; c.LmxNativeTable@: pending) int
    c.LmxNativeTable@: bindings 0
    c.LmxNativeBinding@: row 0
    c.LmxNativeBinding@: prior 0
    c.LmxArena@: owner 0
    size_t: i 0U
    size_t: need 0U
    size_t: slot 0U
    if: arena = 0 || pending = 0
        return: 1
    if: pending\len = 0U
        return: 0
    bindings := @ arena\native_calls
    if: bindings = pending
        return: 1
    need := bindings\len
    while: i < pending\cap
        row := pending\rows + i
        if: row\code != 0
            owner := c.lmx_range_home(arena, (cast: (@) row\code))
            if: owner != arena
                # An exactly retained occurrence keeps its owner's existing binding.
                if: owner = 0 || lmx_native_descriptor(arena, (cast: (c.Lmx@) row\code)) != row\descriptor
                    return: 1
                ---
            else:
                if: row\descriptor != 0
                    prior := 0
                    if: bindings\len != 0U
                        prior := bindings\rows + lmx_native_slot(bindings, (cast: (c.Lmx@) row\code))
                    ---
                    if: prior = 0 || prior\code = 0
                        if: need = (cast: (size_t) -1)
                            return: 1
                        need := need + 1U
                    ---
                ---
            ---
        ---
        i := i + 1U
    ---
    if: lmx_native_reserve(bindings, need) != 0
        return: 1
    i := 0U
    while: i < pending\cap
        row := pending\rows + i
        if: row\code != 0 && c.lmx_range_home(arena, (cast: (@) row\code)) = arena
            if: row\descriptor != 0
                lmx_native_put(bindings, (cast: (c.Lmx@) row\code), (cast: (c.Lmx@) row\descriptor))
            else:
                if: bindings\len != 0U
                    slot := lmx_native_slot(bindings, (cast: (c.Lmx@) row\code))
                    prior := bindings\rows + slot
                    if: prior\code != 0
                        lmx_native_remove(bindings, slot)
                    ---
                ---
            ---
        ---
        i := i + 1U
    ---
    return: 0
end: lmx_native_publish

fn: lmx_native_attach_prepare (c.LmxArena@: arena; c.LmxArena@: other) int
    c.LmxNativeTable@: target @ arena\native_calls
    c.LmxNativeTable@: source @ other\native_calls
    c.LmxNativeBinding@: row 0
    c.LmxNativeBinding@: prior 0
    size_t: i 0U
    if: source\len = 0U
        return: 0
    while: i < source\cap
        row := source\rows + i
        if: row\code != 0 && target\len != 0U
            prior := target\rows + lmx_native_slot(target, (cast: (c.Lmx@) row\code))
            if: prior\code != 0 && prior\descriptor != row\descriptor
                return: 1
            ---
        ---
        i := i + 1U
    ---
    if: source\len > (cast: (size_t) -1) - target\len
        return: 1
    return: lmx_native_reserve(target, (cast: (size_t) (target\len + source\len)))
end: lmx_native_attach_prepare

fn: lmx_native_attach_move (c.LmxArena@: arena; c.LmxArena@: other) void
    c.LmxNativeTable@: target @ arena\native_calls
    c.LmxNativeTable@: source @ other\native_calls
    c.LmxNativeBinding@: row 0
    size_t: i 0U
    while: i < source\cap
        row := source\rows + i
        if: row\code != 0
            lmx_native_put(target, (cast: (c.Lmx@) row\code), (cast: (c.Lmx@) row\descriptor))
        ---
        i := i + 1U
    ---
    lmx_native_table_dispose(source)
    return
end: lmx_native_attach_move

fn: lmx_native_drop (c.LmxArena@: arena; @: lo; @: hi) void
    c.LmxNativeTable@: bindings @ arena\native_calls
    c.LmxNativeBinding@: row 0
    size_t: i 0U
    while: i < bindings\cap
        row := bindings\rows + i
        if: row\code != 0 && (((cast: (c.uintptr_t) row\code) >= (cast: (c.uintptr_t) lo) && (cast: (c.uintptr_t) row\code) < (cast: (c.uintptr_t) hi)) || ((cast: (c.uintptr_t) row\descriptor) >= (cast: (c.uintptr_t) lo) && (cast: (c.uintptr_t) row\descriptor) < (cast: (c.uintptr_t) hi)))
            lmx_native_remove(bindings, i)
        else:
            i := i + 1U
        ---
    ---
    return
end: lmx_native_drop

# Decode the walk boundary's throw status. Errors remain X1; no remembered/current-call status is written.
fn: lmx_call_note_walk_fail (int: st) int
    if: st >= c.LMX_CALL_WALK_ERR_LO && st <= c.LMX_CALL_WALK_ERR_HI
        if: st = 1
            c.fprintf(c.l1_stderr(), "lmx: walk error: INVALID\n")
        ---
        if: st = 2
            c.fprintf(c.l1_stderr(), "lmx: walk error: NO_GRAPH\n")
        ---
        if: st = 3
            c.fprintf(c.l1_stderr(), "lmx: walk error: NOMEM\n")
        ---
        if: st = 4
            c.fprintf(c.l1_stderr(), "lmx: walk error: CHECKPOINT\n")
        ---
        if: st = 5
            c.fprintf(c.l1_stderr(), "lmx: walk error: UNSUPPORTED\n")
        ---
        if: st = 6
            c.fprintf(c.l1_stderr(), "lmx: walk error: PRIMITIVE\n")
        ---
        if: st = 7
            c.fprintf(c.l1_stderr(), "lmx: walk error: NOT_CALLABLE\n")
        ---
        c.abort()
    ---
    if: st >= c.LMX_CALL_WALK_THROWN
        return: st - c.LMX_CALL_WALK_THROWN
    ---
    c.fprintf(c.l1_stderr(), "lmx: walk error: unknown status %d\n", st)
    c.abort()
    return: 0
end: lmx_call_note_walk_fail

# An executed native access consumes one already installed numeric place.
# Query adapters may return an unavailable sentinel; an actual typed access
# must preserve the operation error before any pointer or null-path use.
fn: lmx_call_index (c.LmxArena@: arena; c.Lmx@: data; c.Lmx@: code; size_t: edge) size_t
    size_t: slot (cast: (size_t) -1)
    int: answer
    int: status c.lmx_implements_code_slot(arena, data, code, edge, @ slot, @ answer)
    if: status != c.LMX_WALK_OK
        lmx_call_note_walk_fail(status)
        c.abort()
        return: (cast: (size_t) -1)
    if: answer = c.LMX_IMPLEMENTS_UNKNOWN
        lmx_call_note_walk_fail(c.LMX_WALK_UNSUPPORTED)
        c.abort()
        return: (cast: (size_t) -1)
    if: answer != c.LMX_IMPLEMENTS_YES
        lmx_call_note_walk_fail(c.LMX_WALK_INVALID)
        c.abort()
        return: (cast: (size_t) -1)
    return: slot
end: lmx_call_index

# This is an actual graph-payload read, not a receiving proof. A non-null
# foreign/unregistered payload has no graph-domain interpretation yet.
# Explicit raw C ABI input/result storage does not use this graph path.
fn: lmx_call_cell (c.LmxArena@: arena; @: cell) @
    if: cell != 0 && c.lmx_domain_kind(arena, cell) = c.LMX_KIND_NONE
        lmx_call_note_walk_fail(c.LMX_WALK_UNSUPPORTED)
        c.abort()
        return: 0
    return: cell
end: lmx_call_cell

fn: lmx_call_ready (c.LmxArena@: arena; c.Lmx@: callable) int
    if: arena = 0 || callable = 0
        return: c.LMX_CALL_NOT_CALLABLE
    if: c.lmx_graph_node_in(arena, (cast: (@) callable)) = 0
        return: c.LMX_CALL_NOT_CALLABLE
    ---
    return: c.LMX_CALL_OK
end: lmx_call_ready

fn: lmx_call_node (c.Lmx@: callable) c.Lmx@
    if: callable = 0
        return: 0
    return: (cast: (c.Lmx@) callable\parent)
end: lmx_call_node

# ---- The activation chain (slice 254, design 4.5 B1) ----------------------------------------------------------------
#
# One record per activation of either executor, kept in the C frame of whoever enters the activation (the walker's
# lmx_walk_activate_parts_values, the native trampolines below and the native branch of lmx_walk_dispatch_values),
# chained through `parent` from the arena's `activation`: one Message, one serial lane, one chain across both
# executors.  A record names the activation's inputs through the callable's args header (`code`, `values`, `refs`,
# `width`) and its own working cells through `bindings` (native frames register them; a walker frame's are its work
# rows).  The resolver of free inputs (lmx_activation_resolve, lmx_walk_values.lm2) climbs this chain once, at the
# callee's entry.  Nothing here is graph storage: no root, no companion graph, no registry; a record is gone with its
# activation.
fn: lmx_activation_push (c.LmxArena@: arena; c.LmxActivation@: record; int: kind; c.Lmx@: code; @@: refs; @: values; size_t: width; @: frame) int
    if: arena = 0 || record = 0
        return: 1
    c.memset((cast: (@) record), 0, c.sizeof(c.LmxActivation))
    record\parent := (cast: (c.LmxActivation@) arena\activation)
    record\kind := kind
    record\code := code
    record\refs := refs
    record\values := values
    record\width := width
    record\frame := frame
    arena\activation := (cast: (@) record)
    return: 0
end: lmx_activation_push

# The record leaves with its activation; its bindings are freed.  The chain goes back to the record's parent whatever
# the current record is: the frame below is gone.
sub: lmx_activation_pop (c.LmxArena@: arena; c.LmxActivation@: record)
    if: arena = 0 || record = 0
        return
    if: record\bindings != 0
        c.free((cast: (@) record\bindings))
    ---
    record\bindings := 0
    record\nbind := 0U
    record\cap := 0U
    if: record\origins_owned != 0
        c.free((cast: (@) record\input_origins))
        c.free((cast: (@) record\input_private))
    ---
    record\input_origins := 0
    record\input_private := 0
    record\origin_count := 0U
    record\origins_owned := 0
    arena\activation := (cast: (@) record\parent)
    return
end: lmx_activation_pop

# A native frame registers one of its own working cells in the current record: `code` (the code of its name,
# IDENTIFIER-CODES; the unit normalized its spelling once at its input boundary) with its `storage` and `type`, or a
# complete LmxWalkValue record (`value`) where the cell holds one.  1 for no code, or when the C heap refuses.
fn: lmx_activation_bind (c.LmxArena@: arena; size_t: code; @: storage; int: type; @: value) int
    return: lmx_activation_bind_origin(arena, code, storage, type, value, 0)
end: lmx_activation_bind

# Slice 412: a binding with an origin and no name -- an actual a launch supplied to an unnamed root of its data -- is
# found only by that origin (lookup mode 2); no name lookup matches code 0 (lmx_activation_name_is).  1 for neither a
# code nor an origin, or when the C heap refuses.
fn: lmx_activation_bind_origin (c.LmxArena@: arena; size_t: code; @: storage; int: type; @: value; @: origin) int
    c.LmxActivation@: record 0
    c.LmxActivationBinding@: grown 0
    c.LmxActivationBinding@: slot 0
    c.LmxSourceName@: metadata 0
    size_t: cap 0U
    if: arena = 0 || (code = 0U && origin = 0)
        return: 1
    record := (cast: (c.LmxActivation@) arena\activation)
    if: record = 0
        return: 1
    if: record\nbind = record\cap
        cap := 8U
        if: record\cap != 0U
            cap := record\cap * 2U
        grown := (cast: (c.LmxActivationBinding@) c.realloc((cast: (@) record\bindings), cap * c.sizeof(c.LmxActivationBinding)))
        if: grown = 0
            return: 1
        record\bindings := grown
        record\cap := cap
    ---
    slot := record\bindings + record\nbind
    slot\code := code
    slot\storage := storage
    slot\type := type
    slot\value := value
    slot\origin := origin
    slot\binding_private := 0
    metadata := c.lmx_source_places(arena, origin)
    if: metadata != 0
        slot\binding_private := metadata\binding_private
    record\nbind := record\nbind + 1U
    return: 0
end: lmx_activation_bind_origin

# A call owns these mutable metadata spans until its activation returns.
# Entry may replace a short borrow with its own padded spans.
fn: lmx_activation_origins (c.LmxArena@: arena; @@: origins; int@: private_flags; size_t: count) int
    c.LmxActivation@: record 0
    if: arena = 0 || (count != 0U && (origins = 0 || private_flags = 0))
        return: 1
    record := (cast: (c.LmxActivation@) arena\activation)
    if: record = 0
        return: 1
    if: record\input_origins = origins && record\input_private = private_flags
        if: count > record\origin_count
            return: 1
        record\origin_count := count
        return: 0
    ---
    if: record\origins_owned != 0
        c.free((cast: (@) record\input_origins))
        c.free((cast: (@) record\input_private))
    ---
    record\input_origins := origins
    record\input_private := private_flags
    record\origin_count := count
    record\origins_owned := 0
    return: 0
end: lmx_activation_origins

# Explicit typed borrows, including operations before the first activation.
# A checkpoint closes an operation, including every nested temporary span.
fn: lmx_execution_roots_mark (c.LmxArena@: arena) c.LmxExecutionRoots@
    if: arena = 0
        return: 0
    return: arena\execution_roots

sub: lmx_execution_roots_push (c.LmxArena@: arena; c.LmxExecutionRoots@: roots; @: values; size_t: value_count; @@: refs; size_t: ref_count; @: held; @: place)
    if: arena = 0 || roots = 0
        return
    roots\prior := arena\execution_roots
    roots\next := 0
    roots\lane := (cast: (@) arena)
    c.LmxExecutionRoots@: prior (cast: (c.LmxExecutionRoots@) roots\prior)
    if: prior != 0
        prior\next := roots
    roots\values := values
    roots\value_count := value_count
    if: values = 0
        roots\value_count := 0U
    roots\refs := refs
    roots\ref_count := ref_count
    if: refs = 0
        roots\ref_count := 0U
    roots\held := held
    roots\place := place
    roots\scratch := 0
    arena\execution_roots := roots
    return

sub: lmx_execution_roots_restore (c.LmxArena@: arena; c.LmxExecutionRoots@: mark)
    if: arena != 0
        arena\execution_roots := mark
        if: mark != 0
            mark\next := 0
    ---
    return

# Remove a helper's local span while younger call-scratch argument spans stay
# alive. Constant-time unlink; there is no lookup on any value access.
sub: lmx_execution_roots_remove (c.LmxArena@: arena; c.LmxExecutionRoots@: roots)
    c.LmxExecutionRoots@: prior 0
    c.LmxExecutionRoots@: next 0
    if: arena = 0 || roots = 0 || roots\lane != (cast: (@) arena)
        return
    prior := (cast: (c.LmxExecutionRoots@) roots\prior)
    next := (cast: (c.LmxExecutionRoots@) roots\next)
    if: next != 0
        next\prior := prior
    else:
        arena\execution_roots := prior
    if: prior != 0
        prior\next := next
    roots\lane := 0
    roots\prior := 0
    roots\next := 0
    return

# Host/root nullary transport: status is the result, activation int travels through value.
# This is not the language unary-call data selection; the host executes its complete program graph over itself.
fn: lmx_call0_mode (c.LmxArena@: arena; c.Lmx@: callable; int@: route; int@: value) int
    @: out void 0
    int: st
    if: route != 0
        \route := c.LMX_CALL_ROUTE_REFUSED
    if: value = 0 || lmx_call_ready(arena, callable) != c.LMX_CALL_OK
        return: c.LMX_CALL_NOT_CALLABLE
    \value := 0
    c.LmxPrimitiveEntry: entry lmx_native_entry(arena, callable)
    if: entry = 0
        if: route != 0
            \route := c.LMX_CALL_ROUTE_WALK
        ---
        return: c.lmx_walk_call0_dispatch(arena, callable, value)
    ---
    if: route != 0
        \route := c.LMX_CALL_ROUTE_NATIVE
    c.LmxActivation: act
    c.LmxExecutionRoots@: roots_mark lmx_execution_roots_mark(arena)
    lmx_activation_push(arena, @ act, 2, callable, 0, 0, 0U, 0)
    st := entry((cast: (@) callable), 0, 0U, (cast: (@) value), @ out, arena, callable, 0, 0)
    lmx_execution_roots_restore(arena, roots_mark)
    lmx_activation_pop(arena, @ act)
    if: c.lmx_msg_poll_escape() != 0
        \value := 0
        return: 0
    return: st
end: lmx_call0_mode

fn: lmx_call0 (c.LmxArena@: arena; c.Lmx@: callable; int@: value) int
    return: lmx_call0_mode(arena, callable, 0, value)
end: lmx_call0

# The ordinary selected code/data ABI: actual declared-width storage and value context, no runtime backend registry.
fn: lmx_call_prim_values (c.LmxArena@: arena; c.Lmx@: code; c.Lmx@: data; @@: refs; size_t: nargs; @: dest; @@: out; c.LmxWalkValue@: lmx_input_values; c.LmxWalkValue@: lmx_result_context) int
    return: lmx_call_prim_values_origins(arena, code, data, refs, nargs, dest, out, lmx_input_values, lmx_result_context, 0, 0, 0U)
end: lmx_call_prim_values

fn: lmx_call_prim_values_origins (c.LmxArena@: arena; c.Lmx@: code; c.Lmx@: data; @@: refs; size_t: nargs; @: dest; @@: out; c.LmxWalkValue@: lmx_input_values; c.LmxWalkValue@: lmx_result_context; @@: origins; int@: private_flags; size_t: origin_count) int
    int: status
    c.LmxWalkValue: result_context
    c.LmxExecutionRoots: result_roots
    c.LmxExecutionRoots: input_roots
    c.LmxExecutionRoots: origin_roots
    c.LmxExecutionRoots@: roots_mark 0
    size_t: input_count 0U
    if: out = 0 || lmx_call_ready(arena, code) != c.LMX_CALL_OK
        c.fprintf(c.l1_stderr(), "lmx: invariant: a dynamic call of a value that is not a Structure\n")
        c.abort()
    ---
    \out := 0
    if: origin_count != 0U && (origins = 0 || private_flags = 0)
        return: lmx_call_note_walk_fail(c.LMX_WALK_INVALID)
    c.memset((cast: (@) (@ result_context)), 0, c.sizeof(c.LmxWalkValue))
    roots_mark := lmx_execution_roots_mark(arena)
    if: lmx_input_values != 0
        input_count := nargs
    lmx_execution_roots_push(arena, @ input_roots, (cast: (@) lmx_input_values), input_count, refs, nargs, (cast: (@) data), 0)
    lmx_execution_roots_push(arena, @ origin_roots, 0, 0U, origins, origin_count, 0, 0)
    lmx_execution_roots_push(arena, @ result_roots, (cast: (@) (@ result_context)), 1U, out, 1U, dest, 0)
    c.LmxPrimitiveEntry: entry lmx_native_entry(arena, code)
    c.LmxActivation: act
    if: entry != 0
        # The native activation's record (slice 254): its inputs are the arrays the entry receives.
        lmx_activation_push(arena, @ act, 2, code, refs, (cast: (@) lmx_input_values), nargs, 0)
        lmx_activation_origins(arena, origins, private_flags, origin_count)
        status := entry((cast: (@) data), refs, nargs, dest, out, arena, code, lmx_input_values, @ result_context)
        # The entry's stack Values have ended. Drop its typed borrows before
        # any other runtime action; caller inputs/result remain below them.
        lmx_execution_roots_restore(arena, @ result_roots)
        lmx_activation_pop(arena, @ act)
    else:
        status := c.lmx_walk_call_prim_dispatch_origins(arena, code, data, refs, nargs, dest, out, lmx_input_values, @ result_context, origins, private_flags, origin_count)
    ---
    if: c.lmx_msg_poll_escape() != 0
        \out := 0
        status := 0
        c.memset((cast: (@) (@ result_context)), 0, c.sizeof(c.LmxWalkValue))
    if: lmx_result_context != 0
        # Do not clear an aliased caller input before the selected entry consumes it.
        c.memset((cast: (@) lmx_result_context), 0, c.sizeof(c.LmxWalkValue))
        if: status = 0
            c.memcpy((cast: (@) lmx_result_context), (cast: (const: @) (@ result_context)), c.sizeof(c.LmxWalkValue))
        ---
    ---
    lmx_execution_roots_restore(arena, roots_mark)
    return: status
end: lmx_call_prim_values_origins

fn: lmx_call_prim (c.LmxArena@: arena; c.Lmx@: code; c.Lmx@: data; @@: refs; size_t: nargs; @: dest; @@: out) int
    return: lmx_call_prim_values(arena, code, data, refs, nargs, dest, out, 0, 0)
end: lmx_call_prim

# A representative (record kind 3; 1 is a walker frame, 2 a native or Graph record): lmx_graph_work_load pushes it
# over the running chain while a computed place of an earlier activation -- its owner -- is computed, so that the
# computation runs by the owner's rule (the book #path-reads-no-execution; Р110 item 4) and the physical chain keeps every activation it
# passes over: the collector marks them, a push takes its parent from the top, a pop goes back to it. It carries the
# owner's code, inputs and frame. A search of names reads the owner for it: the owner of the frame it carries.
fn: lmx_activation_stand (c.LmxActivation@: record) c.LmxActivation@
    c.LmxGraphFrame@: frame 0
    if: record = 0 || record\kind != 3
        return: record
    frame := (cast: (c.LmxGraphFrame@) record\frame)
    return: frame\activation

# The record a search of names reads after record: the parent of the record it stands for, read in turn for the
# record that one stands for. The physical chain is record\parent, as before.
fn: lmx_activation_next (c.LmxActivation@: record) c.LmxActivation@
    c.LmxActivation@: owner lmx_activation_stand(record)
    if: owner = 0
        return: 0
    return: lmx_activation_stand((cast: (c.LmxActivation@) owner\parent))
