predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# -174 c4 / k.4: CALL dest is a fresh typed cell of the type the CALL's rtype operand
# (a reference to the callee's declared result cell) classifies as.
# A size_t trampoline writes 8 bytes; the evaluator int temp is 4. Mutant: pass
# dest (int temp) -> truncated / RED.

@: LmxArena ga 0
@: Lmx groles 0
@: LmxWalkContext gctx 0
@: LmxWalkValue gv 0
int: broken 0
int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(ga, groles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(ga, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

sub: ref (@: Lmx code; size_t: slot; @: Lmx target)
    if: code = 0 || target = 0 || lmx_arena_ref_store(code, slot, (cast: (@: void) target)) != 0
        broken: broken + 1
    ---
end: ref

sub: sz (@: Lmx code; size_t: slot; size_t: value)
    if: code = 0 || lmx_walk_store_size(ga, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: sz

# k.4: a walked/native callable occurrence is just the ordinary body Structure -- no
# descriptor; `native` stays 0 by construction unless set directly.
fn: mk_m (@: Lmx unit; size_t: slot; size_t: children) @: Lmx
return: pl(unit, slot, children)

fn: go (@: Lmx m) int
    if: m = 0 || gctx = 0 || gv = 0
        return: c.LMX_WALK_INVALID
return: lmx_walk_run(gctx, m, 0, 0U, gv)


# Wide size_t that does not fit in 32-bit int (and is not 0 when truncated badly).
fn: g1_wide (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    size_t: w 1U
    if: dest = 0 || out = 0
        return: 1
    ---
    w: w << 32
    w: w + 7U
    if: lmx_size_store_known(dest, w) != 0
        return: 1
    ---
    \out: dest
return: 0

fn: g1_char (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    lmx_char_store_known(dest, 200)
    \out: dest
return: 0

sub: char_cells (@: Lmx unit)
    LmxWalkFrame: frame
    @: void a lmx_char_new_owned(ga)
    @: void b lmx_char_new_owned(ga)
    @: void result 0
    @: void saved 0
    @: void actual 0
    @: void dest 0
    @: void repeated 0
    @: Lmx callee 0
    @: Lmx caller 0
    @: Lmx ret 0
    @: Lmx own 0
    @: Lmx call 0
    @: Lmx copied 0
    size_t: field 0U
    int: spare 0
    int: st 0
    memset(@ frame, 0, c.sizeof(c.LmxWalkFrame))
    frame.arena: ga
    frame.context: gctx
    actual: lmx_char_cell(ga, 65)
    frame.args: @ actual
    frame.nargs: 1U
    if: a = 0 || b = 0 || actual = 0
        c.abort()
    lmx_char_store_known(a, 65)
    saved: a
    check(lmx_walk_store_slot(ga, @ a, 66U) = c.LMX_WALK_OK && a = saved && lmx_char_value_known(a) = 66, "published char mutates existing slot cell")
    check(lmx_walk_store_numeric_into(ga, actual, 66U) = c.LMX_WALK_INVALID && lmx_char_value_known(actual) = 65, "an arbitrary char operand is not a mutable destination")
    st: lmx_walk_arg_write(@ frame, 0U, lmx_char_cell(ga, 66), @ spare, @ result)
    saved: result
    check(st = c.LMX_WALK_OK && result != actual && result != lmx_char_cell(ga, 66) && lmx_char_value_known(actual) = 65, "formal char assignment owns its cell without mutating actual")
    st: lmx_walk_arg_write(@ frame, 0U, lmx_char_cell(ga, 67), @ spare, @ result)
    check(st = c.LMX_WALK_OK && result = saved && lmx_char_value_known(result) = 67 && lmx_char_value_known(lmx_char_cell(ga, 66)) = 66, "repeated char formal assignment preserves local cell")
    st: lmx_walk_arith_out(@ frame, a, c.LMX_TYPE_CHAR, 68U, @ result)
    check(st = c.LMX_WALK_OK && result = lmx_char_cell(ga, 68) && lmx_char_value_known(a) = 66, "char expression temporary is interned, not written into arbitrary destination")
    st: lmx_walk_call_dest(@ frame, actual, c.LMX_TYPE_CHAR, @ dest)
    check(st = c.LMX_WALK_OK && dest != actual && dest != lmx_char_cell(ga, 0), "char call result never borrows an interned destination")
    callee: mk_m(unit, 2U, 2U)
    lmx_arena_ref_store(callee, 0U, a)
    ret: fr(callee, 1U, c.LMX_WALK_OP_RET, 2U)
    own: fr(ret, 1U, c.LMX_WALK_OP_OWN, 3U)
    ref(own, 1U, callee)
    sz(own, 2U, 0U)
    caller: mk_m(unit, 3U, 1U)
    call: fr(caller, 0U, c.LMX_WALK_OP_CALL, 5U)
    ref(call, 1U, callee)
    ref(call, 2U, callee)
    ref(call, 3U, (cast: (@: Lmx) b))
    st: go(caller)
    saved: gv\ref
    check(st = c.LMX_WALK_OK && saved != a && lmx_char_value_known(saved) = 66, "walked own char return is copied to caller result cell")
    lmx_char_store_known(a, 67)
    st: go(caller)
    repeated: gv\ref
    check(st = c.LMX_WALK_OK && repeated != saved && lmx_char_value_known(repeated) = 67 && lmx_char_value_known(saved) = 66, "two walked char results retain independent values")
    callee\native: (cast: (LmxEntry) g1_char)
    st: go(caller)
    check(st = c.LMX_WALK_OK && lmx_char_value_known(gv\ref) = (cast: (int) (cast: (char) 200)) && lmx_char_value_known(lmx_char_cell(ga, 0)) = 0, "native char trampoline receives mutable typed destination")
    copied: lmx_walk_capture(ga, unit, callee, callee, @ field, 1U)
    result: lmx_arena_ref_value(copied, 0U)
    check(copied != 0 && result != a && lmx_char_value_known(result) = 67, "char capture owns independent cell")
    lmx_char_store_known(a, 68)
    check(lmx_char_value_known(result) = 67, "source char mutation leaves capture unchanged")
end: char_cells

fn: main () int
    LmxArena: arena
    LmxArena: context_arena
    LmxPool: context_cells
    LmxScratch: store
    LmxWalkContext: context
    @: Lmx unit 0
    @: Lmx m 0
    @: Lmx n 0
    @: Lmx native 0
    @: Lmx caller 0
    @: void rtype_cell 0
    size_t: got 0U
    size_t: want 1U
    int: st 0

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        return: 2
    ga: @ arena
    groles: lmx_walk_roles_open(ga)
    memset((cast: (@: void) (@ context_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxScratch))
    if: lmx_arena_open(@ context_arena) != 0 || lmx_scratch_open(@ store, @ context_arena, @ context_cells, 16U) != c.LMX_SCRATCH_OK
        return: 2
    context.arena: ga
    context.scratch: @ store
    context.roles: groles
    context.immutable_profile: 0
    context.classified: 0U
    gctx: @ context
    gv: (cast: (@: LmxWalkValue) calloc(1U, c.sizeof(c.LmxWalkValue)))

    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 8U) != 0
        return: 2
    ---
    # k.4: no descriptor, no LmxMethod/LmxCallable -- dispatch is the `native` word
    # directly, and the result type comes from classifying the CALL's rtype operand
    # (a reference to a size_t-typed cell here) rather than a sig mark.
    native: mk_m(unit, 1U, 0U)
    caller: mk_m(unit, 0U, 1U)
    rtype_cell: lmx_size_new_owned(ga)
    if: native = 0 || caller = 0 || rtype_cell = 0
        return: 2
    ---
    native\native: (cast: (LmxEntry) g1_wide)

    n: fr(caller, 0U, c.LMX_WALK_OP_CALL, 5U)
    ref(n, 1U, native)
    ref(n, 2U, native)
    ref(n, 3U, (cast: (@: Lmx) rtype_cell))
    st: go(caller)
    want: 1U
    want: want << 32
    want: want + 7U
    if: st = c.LMX_WALK_OK && gv\ref != 0
        got: lmx_size_value_known(gv\ref)
    ---
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref != 0 && gv\ref != (cast: (@: void) (@ gv\number)))), "CALL dest is not the int temp")
    check((cast: (int) (st = c.LMX_WALK_OK && got = want)), "size_t trampoline dest holds full 2^32+7")
    check((cast: (int) (gv\ref != 0 && lmx_walk_numeric_type(ga, gv\ref) = c.LMX_TYPE_SIZE_T)), "dest cell type is SIZE_T")

    char_cells(unit)
    c.printf("lmx_walk_call_dest_selftest checks=%d failures=%d broken=%d\n", checks, failures, broken)
    if: failures != 0 || broken != 0
        return: 1
return: 0
