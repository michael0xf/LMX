        return: (copy(selected))

FxSeqList:
    private: @: values
    required: values
    return: @
    list:
        throws:
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        return: FxSeqRecords\make(values)

FxSeqFlatMap:
    private:
        @: items
        @: next
    required: items next
    return: @
    flatMap:
        throws:
            FxCallFailure
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
