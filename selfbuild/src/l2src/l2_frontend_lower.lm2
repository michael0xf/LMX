            own_excl_cell[0]: excluded
            if: c.sprintf(merge_keep_n, "l2_mprofile_n%d", msf) < 0 || lm_compiler_emit_keep(ind, "l2_mprofiles", merge_keep_n) != 0
                return: (cast: (int) (1))
