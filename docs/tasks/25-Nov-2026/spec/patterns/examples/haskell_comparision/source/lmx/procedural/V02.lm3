TicketCode:
    char[]: candidate
    return: int
    accepts:
        if: length(candidate) != 5
            return: 0
        int: i 0
        while: i < 5
            if: i != 2
                char: first '0'
                char: last '9'
                if: i < 2
                    first := 'A'
                    last := 'Z'
                if: candidate[i] < first || candidate[i] > last
                    return: 0
                ---
            i += 1
        return: candidate[2] = '-'
