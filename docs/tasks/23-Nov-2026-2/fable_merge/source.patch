+      "foreign": "package PerlComparison::Ranges;\nuse strict;\nuse warnings;\nsub array {\n    ref($_[0]) eq 'ARRAY' or die \"SequenceType\\n\";\n    return $_[0];\n}\nsub checked_index {\n    my ($value) = @_;\n    defined($value) && !ref($value) && $value =~ /\\A[0-9]+\\z/\n        or die \"ReceiverIndex\\n\";\n    return 0 + $value;\n}\nsub select_values {\n    my ($source, $indices) = @_;\n    array($source); array($indices);\n    my @checked;\n    for my $value (@$indices) {\n        my $at = checked_index($value);\n        $at < @$source or die \"ReceiverIndex\\n\";\n        push @checked, $at;\n    }\n    my @out;\n    push @out, $source->[$_] for @checked;\n    return \\@out;\n}\nsub replace_range {\n    my ($target, $begin, $end, $values) = @_;\n    array($target); array($values);\n    $begin = checked_index($begin); $end = checked_index($end);\n    $begin <= $end && $end <= @$target or die \"ReceiverIndex\\n\";\n    my @staged = @$values;\n    my @ready;\n    for (my $i = 0; $i < $begin; ++$i) { push @ready, $target->[$i] }\n    push @ready, @staged;\n    for (my $i = $end; $i < @$target; ++$i) { push @ready, $target->[$i] }\n    @$target = @ready;\n    return $target;\n}\nsub splice_values {\n    my ($target, $begin, $end, $values) = @_;\n    array($target); array($values);\n    $begin = checked_index($begin); $end = checked_index($end);\n    $begin <= $end && $end <= @$target or die \"ReceiverIndex\\n\";\n    my @removed;\n    for (my $i = $begin; $i < $end; ++$i) { push @removed, $target->[$i] }\n    replace_range($target, $begin, $end, $values);\n    return \\@removed;\n}\n1;\n",
+      "contract": "Нулевые индексы, полуоткрытые диапазоны, повторы в select, пустое удаление/вставка. select создаёт новый внешний массив. splice сохраняет идентичность target и возвращает удалённые элементы. Если values совпадает с target, вставляемые значения снимаются до изменения.",
+      "boundary": "Показаны проверка всех индексов, снимок вставки и commit; сравнительная Perl-реализация не вызывает штатный splice. Runtime обеспечивает расширение памяти и обычный тип элементов; LMX сохраняет полный профиль dense/@[] и проверяет допуск до commit.",
