predef: "mixa_manager/mtk_int_enum.h.lm1"

# IntEnum.java is a pure interface: no state, no default methods.
# The fnptr vtable struct in mtk_int_enum.h.lm1 is the L1 contract;
# concrete implementors (e.g. IntArray.Range) supply the fnptr bodies
# in their own .lm1 units. This unit carries no functions.
