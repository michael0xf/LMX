        Struct: (a b c) (a b d) (a b c d)
    return: @
    run:
        return: (length(Square\Struct) length([0]Square\Struct) length([1]Square\Struct) length([2]Square\Struct) [2]Square\Struct\[3] [2]Round\Struct\[3])
