            idx: 0
        l2_rw_loops: l2_rw_loops - 1
        if: l2_rw_leave(bsave) != 0
            return: 1
        if: idx = 0
            return: 1
        \made: k + 1
        if: l2_rw_put(into, slot + k, node) != 0
            return: 1
        return: 0
    if: l2_text_eq(h, "until")
        return: l2_rw_refuse(stmt, "a loop")
    if: l2_text_eq(h, "catch")
        return: l2_rw_catch_stmt(stmt, into, slot, made)
    if: l2_text_eq(h, "throws")
