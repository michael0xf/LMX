# Ordinary code through the same application head uses Self or given data.
# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: self_value 0
        int: given_value 0
        int: kept_value 0
)
sub: main () (
    Table:
        Code:
            data\x := data\x + 1
        Self:
            int: x 1
            data\x := data\x + 2
        Data:
            int: x 10
        `Kept[x]`:
            int: value 3
)
    Table\Self()
    Table\Self()
    Table\Code(Table\Data)
main()
int: self_value main\data\Table\Self\x
int: given_value main\data\Table\Data\x
int: kept_value main\data\Table[3]\value

sub: observe ()
    @: shared node[0]
    shared\Observed\self_value := self_value
    shared\Observed\given_value := given_value
    shared\Observed\kept_value := kept_value
observe()
