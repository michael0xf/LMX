# K03 NS-ROLES-2 (Codex K03-NS-ROLES-2-20261007-20; docs/LMX_semantics.en.md#resolved-head-consumption,
# #declaration-visibility): a named Structure's body takes the common roles of the root and a method.
# A qualified branch's binding to an ordinary (mutable) named Structure would make a reclaimable target reachable
# as a terminal: refused at the referent.
Model:
    int: v 1
end: Model
independent:
    const:
        immutable:
            (): E
                box: Model
                size_t: a 7U
            end: E
        end: immutable
    end: const
end: independent
fn: m () int
    return: 7
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
