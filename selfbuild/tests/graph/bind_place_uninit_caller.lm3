# A write through the transparent place into a caller place without a value initializes it (#binding-caller-place).
(
    Observed:
        int: seen 0
)
fn: callee () int
    x := 9
    return: x
fn: caller () int
    int: x
    int: r callee()
    return: x * 100 + r
sub: main ()
    @: shared node[0]
    shared\Observed\seen := caller()
main()
