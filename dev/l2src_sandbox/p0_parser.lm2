# Original: parser.lm1:4629 lm_p0_dump_stack_delete
sub: lm_p0_dump_stack_delete (@@: stack c.LmOwnPtrStack)
    if: ((stack != 0) && (stack[0] != 0))
        c.lm_own_ptr_stack_destroy(stack[0])
        c.lm_own_delete(stack[0], 0)
        stack[0]: 0
    ---
end: lm_p0_dump_stack_delete

# Original: parser.lm1:4637 lm_p0_dump_run
sub: lm_p0_dump_run (@: dump c.LmP0Dump; @: stack c.LmOwnPtrStack)
    @: frame c.LmP0DumpFrame
    const: (@: p0_node c.LmP0Node)
    const: (@: structure c.LmP0Structure)
    const: (@: trailer c.LmP0Trailer)
    const: (@: structure_name char)
    size_t: indent
    while: ((((dump != 0) && (dump\failed = 0)) && (stack != 0)) && (stack\count != 0U))
        frame: (cast: (@: c.LmP0DumpFrame) c.lm_own_ptr_stack_top(stack))
        if: (frame = 0)
            dump\failed: 1
            return
        if: (frame\phase = c.LM_P0_DUMP_NODE)
            p0_node: frame\node
            indent: frame\indent
            c.lm_own_delete(c.lm_own_ptr_stack_pop(stack), 0)
            if: (p0_node = 0)
                continue
            structure_name: lm_p0_node_kind_class_name(c.LM_P0_NODE_STRUCTURE)
            lm_p0_dump_indent(dump, indent)
            if: ((p0_node\flags & c.LM_P0_NODE_INACTIVE) != 0U)
                lm_p0_dump_append_cstr(dump, "Inactive ")
            ---
            if: ((p0_node\flags & c.LM_P0_NODE_MIX) != 0U)
                lm_p0_dump_append_cstr(dump, "MIX ")
            ---
            if: ((p0_node\flags & c.LM_P0_NODE_POSITIONAL_SKIP) != 0U)
                lm_p0_dump_append_cstr(dump, "PositionalSkip ")
            ---
            if: (p0_node\kind = c.LM_P0_NODE_STRUCTURE)
                lm_p0_dump_append_cstr(dump, lm_p0_node_kind_class_name((cast: (c.LmP0NodeKind) p0_node\kind)))
                lm_p0_dump_append_field_count_line(dump, (cast: (size_t) p0_node\as\structure\field_count))
                if: ((lm_p0_dump_push_trailer(stack, (cast: (const: @: c.LmP0Trailer) p0_node\as\structure\trailer), (indent + 1U)) != 0) || (lm_p0_dump_push_structure(stack, (cast: (const: @: c.LmP0Structure) p0_node\as\structure), (indent + 1U)) != 0))
                    dump\failed: 1
                ---
            else:
                if: (p0_node\kind = c.LM_P0_NODE_FRAME)
                    lm_p0_dump_append_cstr(dump, lm_p0_node_kind_class_name((cast: (c.LmP0NodeKind) p0_node\kind)))
                    lm_p0_dump_append_cstr(dump, " head=")
                    lm_p0_dump_text(dump, (cast: (const: @: c.LmP0Text) p0_node\as\frame\head))
                    lm_p0_dump_append_cstr(dump, " body=")
                    lm_p0_dump_append_cstr(dump, structure_name)
                    lm_p0_dump_append_field_count_line(dump, (cast: (size_t) p0_node\as\frame\body\field_count))
                    if: ((lm_p0_dump_push_trailer(stack, (cast: (const: @: c.LmP0Trailer) p0_node\as\frame\trailer), (indent + 1U)) != 0) || (lm_p0_dump_push_structure(stack, (cast: (const: @: c.LmP0Structure) p0_node\as\frame\body), (indent + 1U)) != 0))
                        dump\failed: 1
                    ---
                else:
                    if: (p0_node\kind = c.LM_P0_NODE_ATOM)
                        lm_p0_dump_append_cstr(dump, lm_p0_node_kind_class_name((cast: (c.LmP0NodeKind) p0_node\kind)))
                        lm_p0_dump_append_cstr(dump, " ")
                        lm_p0_dump_text(dump, (cast: (const: @: c.LmP0Text) p0_node\as\atom))
                        lm_p0_dump_append_cstr(dump, "\n")
                    else:
                        if: (p0_node\kind = c.LM_P0_NODE_DISABLED)
                            lm_p0_dump_append_cstr(dump, lm_p0_node_kind_class_name((cast: (c.LmP0NodeKind) p0_node\kind)))
                            lm_p0_dump_append_cstr(dump, " ")
                            lm_p0_dump_text(dump, (cast: (const: @: c.LmP0Text) p0_node\as\atom))
                            lm_p0_dump_append_cstr(dump, "\n")
                        else:
                            lm_p0_dump_append_cstr(dump, lm_p0_node_kind_class_name((cast: (c.LmP0NodeKind) p0_node\kind)))
                            lm_p0_dump_append_cstr(dump, " kind=")
                            lm_p0_dump_append_size(dump, (cast: (size_t) p0_node\kind))
                            lm_p0_dump_append_cstr(dump, "\n")
                        ---
                    ---
                ---
            continue
        if: (frame\phase = c.LM_P0_DUMP_STRUCTURE)
            while: ((frame\field != 0) && (frame\field\value = 0))
                frame\field: frame\field\next
            ---
            if: (frame\field = 0)
                c.lm_own_delete(c.lm_own_ptr_stack_pop(stack), 0)
                continue
            p0_node: frame\field\value
            frame\field: frame\field\next
            if: (lm_p0_dump_push_node(stack, p0_node, (cast: (size_t) frame\indent)) != 0)
                dump\failed: 1
            ---
            continue
        if: (frame\phase = c.LM_P0_DUMP_TRAILER)
            trailer: frame\trailer
            indent: frame\indent
            if: (trailer != 0)
                structure: trailer\body
            else:
                structure: 0
            ---
            c.lm_own_delete(c.lm_own_ptr_stack_pop(stack), 0)
            if: (trailer = 0)
                continue
            lm_p0_dump_indent(dump, indent)
            if: ((trailer\flags & c.LM_P0_TRAILER_TAIL_CUTTER) != 0U)
                lm_p0_dump_append_cstr(dump, "Tail cutter trailer spelling=")
            else:
                lm_p0_dump_append_cstr(dump, "Trailer spelling=")
            ---
            lm_p0_dump_text(dump, (cast: (const: @: c.LmP0Text) trailer\spelling))
            lm_p0_dump_append_field_count_line(dump, (cast: (size_t) trailer\body\field_count))
            if: (lm_p0_dump_push_structure(stack, structure, (indent + 1U)) != 0)
                dump\failed: 1
            ---
            continue
        dump\failed: 1
    ---
end: lm_p0_dump_run

# Original: parser.lm1:4736 lm_p0_dump_node
sub: lm_p0_dump_node (@: dump c.LmP0Dump; const: (@: p0_node c.LmP0Node); size_t: indent)
    @: stack c.LmOwnPtrStack
    if: (p0_node = 0)
        return
    stack: lm_p0_dump_stack_new()
    if: (stack = 0)
        dump\failed: 1
        return
    if: (lm_p0_dump_push_node(stack, p0_node, indent) != 0)
        dump\failed: 1
    else:
        lm_p0_dump_run(dump, stack)
    ---
    lm_p0_dump_stack_delete(@ stack)
end: lm_p0_dump_node

# Original: parser.lm1:4751 lm_p0_dump_new
fn: lm_p0_dump_new () @: c.LmP0Dump
