fn: lm_compiler_items_defined_fn (const: (@: body c.LmP0Structure); const: (@: self c.LmP0Node); const: (@: name c.LmP0Text)) @: c.LmP0Node
    @: field c.LmP0Field
    @: item c.LmP0Node
    @: found c.LmP0Node
    const: (@: branch c.LmP0Node)
