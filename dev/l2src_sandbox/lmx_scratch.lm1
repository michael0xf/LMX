predef: "l2src/lmx_scratch.h.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"

# lmx_scratch.lm1 - the temporary-frame store.  The contract is in lmx_scratch.h.lm1.
# Everything here is built from the pool's own acts (lmx_pool_open, lmx_pool_take_n,
# lmx_pool_chunk_head, lmx_pool_release) and from reading the chunk records the pool
# keeps; no storage is obtained or released in any other way.

fn: lmx_scratch_open (@: LmxScratch s; @: LmxArena arena; @: LmxPool cells; size_t: chunk_cells) int
    if: s = 0 || arena = 0 || cells = 0 || chunk_cells = 0U
        return: c.LMX_SCRATCH_INVALID
    if: s\cells != 0
        return: c.LMX_SCRATCH_INVALID
    if: lmx_pool_open(arena, cells, c.sizeof(@: void), chunk_cells, c.LMX_DOMAIN_KIND_SCRATCH, c.LMX_DOMAIN_SCRATCH) != 0
        return: c.LMX_SCRATCH_NOMEM
    s\arena: arena
    s\cells: cells
    s\at: lmx_pool_chunk_head(cells)
    s\used: 0U
    s\top: 0U
    s\serial: 0U
    s\step: chunk_cells
return: c.LMX_SCRATCH_OK

fn: lmx_scratch_take (@: LmxScratch s; size_t: bytes; @@: void out) int
    @: LmxChunk chunk 0
    @: void got 0
    @: void expected 0
    size_t: word
    size_t: cells
    size_t: from
    int: seeking 1
    if: out = 0
        return: c.LMX_SCRATCH_INVALID
    \out: 0
    if: s = 0 || s\cells = 0 || bytes = 0U
        return: c.LMX_SCRATCH_INVALID
    word: c.sizeof(@: void)
    # Rounding up to whole cells must not wrap.
    if: bytes > ((cast: (size_t) -1) - (word - 1U))
        return: c.LMX_SCRATCH_INVALID
    cells: (bytes + (word - 1U)) / word
    chunk: s\at
    from: s\used
    while: seeking != 0 && chunk != 0
        # Warm: cells this chunk has already handed out once and nobody is using now.
        if: from <= chunk\count && cells <= chunk\count - from
            s\at: chunk
            s\used: from + cells
            \out: (cast: (@: void) ((cast: (@: char) chunk\base) + from * word))
            return: c.LMX_SCRATCH_OK
        # The tail has the room but has not handed all of it out yet.  The cursor sits at
        # or below the chunk's high-water mark, so what is missing is taken FROM THE POOL:
        # it seats those cells right at the mark, and the mark moves with them.  Bumping
        # the cursor past the mark without telling the pool would let a later take_n hand
        # out cells that are live.
        if: chunk\next = 0 && from <= chunk\count && from <= chunk\capacity && cells <= chunk\capacity - from
            expected: (cast: (@: void) ((cast: (@: char) chunk\base) + chunk\count * word))
            got: lmx_pool_take_n(s\arena, s\cells, (from + cells) - chunk\count)
            if: got = 0
                return: c.LMX_SCRATCH_NOMEM
            if: got = expected
                s\at: chunk
                s\used: from + cells
                \out: (cast: (@: void) ((cast: (@: char) chunk\base) + from * word))
                return: c.LMX_SCRATCH_OK
            # The pool seated them elsewhere (it no longer counts that chunk as its own):
            # they stay taken as a small gap, and the request goes to the cold path.
            seeking: 0
        ---
        if: seeking != 0
            chunk: chunk\next
            from: 0U
        ---
    ---
    # Cold: no chunk seats the request.  The pool grows by one chunk -- of the request's
    # own size when that is larger than the step -- and the cursor moves to its end.
    got: lmx_pool_take_n(s\arena, s\cells, cells)
    if: got = 0
        # The pool raised its chunk size to this request before failing to grow; left
        # like that, every later growth would ask for the same impossible chunk.
        s\cells\chunk_capacity: s\step
        return: c.LMX_SCRATCH_NOMEM
    s\at: s\cells\tail
    s\used: s\at\count
    \out: got
return: c.LMX_SCRATCH_OK

fn: lmx_scratch_mark (@: LmxScratch s; @: LmxScratchMark m) int
    if: s = 0 || s\cells = 0 || m = 0
        return: c.LMX_SCRATCH_INVALID
    s\serial: s\serial + 1U
    m\owner: s
    m\at: s\at
    m\used: s\used
    m\serial: s\serial
    m\below: s\top
    s\top: m\serial
return: c.LMX_SCRATCH_OK

fn: lmx_scratch_rewind (@: LmxScratch s; @: LmxScratchMark m) int
    if: s = 0 || s\cells = 0 || m = 0
        return: c.LMX_SCRATCH_INVALID
    # Only the most recent outstanding mark of THIS store: another store's mark, a mark
    # already rewound and a mark with a younger one still outstanding all fail here.
    if: m\owner != s || m\serial = 0U || m\serial != s\top
        return: c.LMX_SCRATCH_BAD_MARK
    s\at: m\at
    s\used: m\used
    s\top: m\below
    m\owner: 0
    m\serial: 0U
return: c.LMX_SCRATCH_OK

fn: lmx_scratch_close (@: LmxScratch s) int
    if: s = 0 || s\cells = 0
        return: c.LMX_SCRATCH_INVALID
    if: s\top != 0U
        return: c.LMX_SCRATCH_BUSY
    lmx_pool_release(s\arena, s\cells)
    s\arena: 0
    s\cells: 0
    s\at: 0
    s\used: 0U
    s\serial: 0U
    s\step: 0U
return: c.LMX_SCRATCH_OK
