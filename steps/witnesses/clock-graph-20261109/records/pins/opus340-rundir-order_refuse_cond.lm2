# Probe of slice 340: a value kept in the right operand of && would run before its left operand decides: refused.
fn: order_two (int: a; int: b) int
    return: a - b

fn: order_one (int: a) int
    return: a + 1

fn: order_cond (int: x) int
    if: x > 0 && order_two(order_one(x), order_one(x)) > 0
        return: 1
    return: 0
