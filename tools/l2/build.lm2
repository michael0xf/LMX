# Programs built and run by lmxtool (a program part; the program includes <stdio.h>, <stdlib.h>,
# <string.h>). A program is built in a stage S (cwd S/src, its headers in S/headers) of the repository R with
# the saved dependencies in B: the L2 translation (frontend, its flags, the source, the conversion parts), the L1
# translation, the strict -O2 C compile with the driver hooks, and the link with a runtime object and the libc
# object; every step a child process with its own log. A run is the driver's: `exe 0 entry N [walkroot 1]`.

# argv[0 .. n - 1] as one log line `$ a b c` (for the build record).
fn: bld_note (@: log c.FILE; @@: argv char; int: n) int
    int: i 0
    if: log = 0
        return: 0
    c.fputs("$", log)
    while: i < n
        c.fprintf(log, " %s", argv[i])
        i: i + 1
    ---
    c.fputs("\n", log)
    return: 0
end: bld_note

# One step: argv run in cwd with both streams to log_path; its kind and exit in res, the command in the record
# with the evidence of its bytes (refinement 3 of OPUS-CODEX-20261023-SLICE170): `exe <sha>` of the executable
# taken BEFORE the start and the same bytes found after the end (an image that changed or cannot be read fails
# the step as kind 4, not prepared: `exe-changed`); `in <sha> <path>` of every other argument naming a file before
# the start; after the terminal state (the end, or the tree stopped at the timeout), `out <sha> <path>` of every
# argument naming a file that was not there or changed, and `log <sha> <path>`. verify-record re-hashes them. The
# step is stopped with its process tree after timeout_ms; bld_step gives it 900 s.
fn: bld_step_t (@: rec c.FILE; @@: argv char; int: n; @: cwd char; @: log_path char; @: res int; unsigned: timeout_ms) int
    @: detail int c.calloc(1U, c.sizeof(c.int))
    @: before char c.calloc(65U, 1U)
    @: after char c.calloc(65U, 1U)
    @: ins char c.calloc((cast: (size_t) n) * 65U + 1U, 1U)
    int: i 1
    int: had 0
    if: detail = 0 || before = 0 || after = 0 || ins = 0
        return: 1
    bld_note(rec, argv, n)
    had: (cast: (int) (os_sha256_file(argv[0], before) = 0))
    if: rec != 0 && had != 0
        c.fprintf(rec, "  exe %s\n", before)
    while: i < n
        if: argv[i] != 0 && file_exists(argv[i]) != 0 && os_sha256_file(argv[i], ins + (cast: (size_t) i) * 65U) = 0
            if: rec != 0
                c.fprintf(rec, "  in %s %s\n", ins + (cast: (size_t) i) * 65U, argv[i])
            ---
        ---
        i: i + 1
    ---
    res[0]: os_run(argv[0], argv, n, cwd, log_path, log_path, timeout_ms, detail)
    res[1]: detail[0]
    if: had != 0 && (os_sha256_file(argv[0], after) != 0 || c.strcmp(before, after) != 0)
        res[0]: 4
        if: rec != 0
            c.fprintf(rec, "  exe-changed %s\n", argv[0])
        ---
    ---
    if: rec != 0
        c.fprintf(rec, "  kind %d exit %d log %s\n", res[0], res[1], log_path)
    i: 1
    while: i < n
        if: argv[i] != 0 && file_exists(argv[i]) != 0 && os_sha256_file(argv[i], after) = 0 && c.strcmp(after, ins + (cast: (size_t) i) * 65U) != 0
            if: rec != 0
                c.fprintf(rec, "  out %s %s\n", after, argv[i])
            ---
        ---
        i: i + 1
    ---
    if: rec != 0 && os_sha256_file(log_path, after) = 0
        c.fprintf(rec, "  log %s %s\n", after, log_path)
    c.free(detail)
    c.free(before)
    c.free(after)
    c.free(ins)
    if: res[0] = 0 && res[1] = 0
        return: 0
    return: 1
end: bld_step_t

# One step of a build or a check (bld_step_t) within 900 s.
fn: bld_step (@: rec c.FILE; @@: argv char; int: n; @: cwd char; @: log_path char; @: res int) int
    return: bld_step_t(rec, argv, n, cwd, log_path, res, 900000U)
end: bld_step

# The space-separated words of words appended to a[n ..], within the cap entries of a: the new count, or -1 when
# they do not fit (or n is already -1). A word is never cut silently.
fn: argv_words (@@: a char; int: n; int: cap; @: words char) int
    size_t: p 0U
    size_t: q c.strlen(words)
    @: w char 0
    if: n < 0
        return: -1
    while: p < q
        if: words[p] = (cast: (char) 32)
            p: p + 1U
        if: p < q && words[p] != (cast: (char) 32)
            if: n >= cap
                return: -1
            w: txt_until(words + p, " ")
            a[n]: w
            n: n + 1
            p: p + (cast: (size_t) c.strlen(w))
        ---
    ---
    return: n
end: argv_words

# The strict C flags of the stage appended to a[n ..] (the frozen recipes' order): -pipe -std=c99, opt, the
# warnings and errors, the include directories (build2/includes when with_build2), the gcc collector params,
# and the driver hooks when hooks; the new count, or -1 when they do not fit the 64 entries its callers allocate.
fn: bld_cflags (@@: a char; int: n; @: repo char; @: stage char; @: base char; @: opt char; int: with_build2; int: hooks) int
    n: argv_words(a, n, 48, "-pipe -std=c99")
    n: argv_words(a, n, 48, opt)
    n: argv_words(a, n, 48, "-Wall -Wextra -Werror=implicit-function-declaration -Werror=implicit-int -Werror=incompatible-pointer-types -Werror=discarded-qualifiers")
    if: n < 0
        return: -1
    a[n]: "-I"
    a[n + 1]: txt_path(stage, "headers")
    a[n + 2]: "-I"
    a[n + 3]: txt_path(base, "codex_header98_source_control_06/includes")
    n: n + 4
    if: with_build2 != 0
        a[n]: "-I"
        a[n + 1]: txt_path(repo, "build2/includes")
        n: n + 2
    ---
    a[n]: "-I"
    a[n + 1]: repo
    a[n + 2]: "-I"
    a[n + 3]: txt_path(repo, "lm1/build")
    a[n + 4]: "-I"
    a[n + 5]: txt_path(stage, "src")
    n: argv_words(a, n + 6, 60, "--param ggc-min-heapsize=16384 --param ggc-min-expand=20")
    if: hooks != 0
        n: argv_words(a, n, 60, "-Dmain=l2_generated_main -Dlmx_root_launch=l2_driver_root_launch -Dlmx_merge_owned=l2_driver_merge_owned -Dlmx_merge_profiles_owned=l2_driver_merge_profiles_owned -Dlmx_merge_used_owned=l2_driver_merge_used_owned -Dlmx_service_post=l2_driver_service_post")
    return: n
end: bld_cflags

# The program of source (then the comma-separated parts of extra, if any, and convert.lm2 and primitive.lm2 of
# base's saved sandbox) built by the frontend fe
# (flag: 0 or the translator's flags, space-separated words; opt: the C optimization words) as out/stem.{lm1,c,o},
# linked with each runtime object into out/stem-<tag>.exe
# (tags/runtimes: the n_rt pairs). 0 built, else the first failing step (1 L2, 2 L1, 3 compile, 4 link).
fn: bld_program (@: repo char; @: stage char; @: base char; @: fe char; @: flag char; @: opt char; @: source char; @: extra char; @: out char; @: stem char; @@: rt_tag char; @@: rt_obj char; int: n_rt; @: libs char; @: rec c.FILE) int
    @: res int c.calloc(2U, c.sizeof(c.int))
    @@: lp char c.calloc(1U, sizeof(@: char))
    int: x 1
    if: res != 0 && lp != 0
        x: bld_program_k(repo, stage, base, fe, flag, opt, source, extra, out, stem, rt_tag, rt_obj, n_rt, libs, rec, res, lp)
    c.free(res)
    c.free(lp)
    return: x
end: bld_program

# bld_program, and of its failing step the kind and exit in res[0 .. 1] and the log path in lp[0] (a check's
# class and its evidence: cls_build); res is 0 0 and lp[0] is 0 when it built.
fn: bld_program_k (@: repo char; @: stage char; @: base char; @: fe char; @: flag char; @: opt char; @: source char; @: extra char; @: out char; @: stem char; @@: rt_tag char; @@: rt_obj char; int: n_rt; @: libs char; @: rec c.FILE; @: res int; @@: lp char) int
    @@: a char 0
    # The argument words: the fixed flags (bld_cflags) and steps within 64, then one per part and per library --
    # the lists' own counts, no cut.
    int: words 64
    if: extra != 0
        words: words + 1 + txt_count(extra, ",")
    if: libs != 0
        words: words + 1 + txt_count(libs, ",")
    if: flag != 0
        words: words + 1 + txt_count(flag, " ")
    a: c.calloc((cast: (size_t) words), sizeof(@: char))
    @: src char txt_path(stage, "src")
    @: gcc char "C:/Qt/Tools/mingw1310_64/bin/gcc.exe"
    @: l1trans char txt_path(repo, "bin/l1trans.exe")
    @: p1 char txt_path(base, "l2_harness/codex_consumer49_full_01/src/convert.lm2")
    @: p2 char txt_path(base, "l2_harness/codex_consumer49_full_01/src/primitive.lm2")
    @: lm1 char txt_cat3(out, "/", txt_cat(stem, ".lm1"))
    @: cfile char txt_cat3(out, "/", txt_cat(stem, ".c"))
    @: obj char txt_cat3(out, "/", txt_cat(stem, ".o"))
    @: exe char 0
    @: libc char txt_path(base, "l2_harness/codex_impl56_public_focus_01/gen/l2_libc.o")
    int: n 0
    int: k 0
    size_t: ep 0U
    if: a = 0 || res = 0 || lp = 0 || src = 0 || l1trans = 0 || p1 = 0 || p2 = 0 || lm1 = 0 || cfile = 0 || obj = 0 || libc = 0
        return: 1
    res[0]: 0
    res[1]: 0
    a[0]: fe
    n: 1
    if: flag != 0
        n: argv_words(a, n, words - 4, flag)
    ---
    if: n < 0
        return: 1
    a[n]: source
    n: n + 1
    while: extra != 0 && ep < (cast: (size_t) c.strlen(extra))
        a[n]: txt_until(extra + ep, ",")
        ep: ep + (cast: (size_t) c.strlen(a[n])) + 1U
        n: n + 1
    ---
    a[n]: p1
    a[n + 1]: p2
    a[n + 2]: lm1
    lp[0]: txt_cat3(out, "/", txt_cat(stem, ".L2.log"))
    if: bld_step(rec, a, n + 3, src, lp[0], res) != 0
        return: 1
    a[0]: l1trans
    a[1]: lm1
    a[2]: cfile
    lp[0]: txt_cat3(out, "/", txt_cat(stem, ".L1.log"))
    if: bld_step(rec, a, 3, src, lp[0], res) != 0
        return: 2
    a[0]: gcc
    n: bld_cflags(a, 1, repo, stage, base, opt, 1, 1)
    if: n < 0
        return: 3
    a[n]: "-c"
    a[n + 1]: cfile
    a[n + 2]: "-o"
    a[n + 3]: obj
    lp[0]: txt_cat3(out, "/", txt_cat(stem, ".CC.log"))
    if: bld_step(rec, a, n + 4, src, lp[0], res) != 0
        return: 3
    while: k < n_rt
        exe: txt_cat3(out, "/", txt_cat3(stem, "-", txt_cat(rt_tag[k], ".exe")))
        a[0]: gcc
        a[1]: obj
        a[2]: rt_obj[k]
        a[3]: libc
        n: 4
        ep: 0U
        while: libs != 0 && ep < (cast: (size_t) c.strlen(libs))
            a[n]: txt_until(libs + ep, ",")
            ep: ep + (cast: (size_t) c.strlen(a[n])) + 1U
            n: n + 1
        ---
        a[n]: "-Wl,--strip-debug"
        a[n + 1]: "-o"
        a[n + 2]: exe
        lp[0]: txt_cat3(out, "/", txt_cat3(stem, "-", txt_cat(rt_tag[k], ".LD.log")))
        if: bld_step(rec, a, n + 3, src, lp[0], res) != 0
            return: 4
        k: k + 1
    ---
    lp[0]: 0
    return: 0
end: bld_program_k

# A run of exe through its driver: `exe 0 entry N` and `walkroot 1` when walkroot is not 0; both streams to
# log_path. The driver's exit (0: the program's exit is N), or -1 when the run did not end by itself.
fn: bld_run (@: exe char; int: entry; int: walkroot; @: cwd char; @: log_path char; @: rec c.FILE) int
    @@: a char c.calloc(8U, sizeof(@: char))
    @: res int c.calloc(2U, c.sizeof(c.int))
    int: n 4
    if: a = 0 || res = 0
        return: -1
    a[0]: exe
    a[1]: "0"
    a[2]: "entry"
    a[3]: txt_int(entry)
    if: walkroot != 0
        a[4]: "walkroot"
        a[5]: "1"
        n: 6
    ---
    bld_step(rec, a, n, cwd, log_path, res)
    if: res[0] != 0
        return: -1
    return: res[1]
end: bld_run

# How many lines of the file at path are exactly line (LF or CRLF ends).
fn: file_count_line (@: path char; @: line char) int
    @: len size_t c.calloc(1U, c.sizeof(c.size_t))
    @: at size_t c.calloc(1U, c.sizeof(c.size_t))
    @: data char 0
    @: l char 0
    int: n 0
    if: len = 0 || at = 0
        return: -1
    data: file_read(path, len)
    if: data = 0
        return: -1
    l: next_line(data, len[0], at)
    while: l != 0
        if: c.strcmp(l, line) = 0
            n: n + 1
        l: next_line(data, len[0], at)
    ---
    c.free(data)
    c.free(len)
    c.free(at)
    return: n
end: file_count_line

# In the program of the L1 at path (one translation for one target: the os block selected its branch, L2 section
# 20), whether the occurrence of the method `name` binds a native word: 1 yes, 0 no, -1 the method's occurrence was
# not found. The occurrence is the unit slot whose cell is named `name` (a method with header parts), or else the
# slot the occurrence named `name` is stored at (a method without them, a sub).
fn: l1_binds_native (@: path char; @: name char) int
    @: len size_t c.calloc(1U, c.sizeof(c.size_t))
    @: data char 0
    @: win char 0
    @: key char 0
    @: at char 0
    @: slot char 0
    @: head char 0
    @: sec char 0
    @: next char 0
    @: store char 0
    @: last char 0
    char: cut (cast: (char) 0)
    int: r -1
    if: len = 0
        return: -1
    data: file_read(path, len)
    if: data = 0
        return: -1
    win: data
    # the occurrence's cell: `lmx_arena_ref_cell(l2_entry_unit, <slot>U)), "name", ...`
    key: txt_cat3("U)), \"", name, "\", ")
    at: c.strstr(win, "lmx_arena_ref_cell(l2_entry_unit, ")
    while: at != 0 && slot = 0
        at: at + 34
        if: c.strncmp(at + (cast: (size_t) c.strspn(at, "0123456789")), key, (cast: (size_t) c.strlen(key))) = 0
            slot: txt_ndup(at, (cast: (size_t) c.strspn(at, "0123456789")))
        at: c.strstr(at, "lmx_arena_ref_cell(l2_entry_unit, ")
    ---
    # the occurrence named itself: `lmx_arena_ref_store(l2_entry_unit, <slot>U, ...l2_entry_leaf))` before
    # `lmx_source_name_set(..., (cast: (@: void) l2_entry_leaf), "name", ...)`
    if: slot = 0
        key: txt_cat3("(cast: (@: void) l2_entry_leaf), \"", name, "\", ")
        at: c.strstr(win, key)
        if: at != 0
            cut: at[0]
            at[0]: (cast: (char) 0)
            store: c.strstr(win, "lmx_arena_ref_store(l2_entry_unit, ")
            while: store != 0
                last: store
                store: c.strstr(store + 1, "lmx_arena_ref_store(l2_entry_unit, ")
            ---
            at[0]: cut
            if: last != 0
                slot: txt_ndup(last + 35, (cast: (size_t) c.strspn(last + 35, "0123456789")))
        ---
    ---
    if: slot != 0
        head: txt_cat3("l2_entry_leaf: lmx_arena_ref_struct(l2_entry_unit, ", slot, "U)\n")
        r: 0
        sec: c.strstr(win, head)
        while: sec != 0 && r = 0
            next: c.strstr(sec + 1, "l2_entry_leaf: ")
            if: next != 0
                next[0]: (cast: (char) 0)
            if: c.strstr(sec, "l2_entry_leaf\\native:") != 0
                r: 1
            if: next != 0
                next[0]: (cast: (char) 108)
            sec: c.strstr(sec + 1, head)
        ---
    ---
    c.free(data)
    c.free(len)
    return: r
end: l1_binds_native

# The witness that ordinary L2 bodies of an os branch run walked (CODEX-AUTHOR-OS-WALK-BODY-20261023T001133Z):
# source built natively and with --walk-methods by fe, each linked with the production runtime (prod) and the
# observed one (obs, -DLMX_OBSERVE_WALK), run at the root and with walkroot 1. Every run must exit with entry;
# the observed forced runs must say `LMX_OBSERVE WALK_BODY <name>` count times for each name=count of spec, the
# observed native runs never; the forced L1 must bind no native word to those methods' occurrences, the native
# L1 must. The failures, said as FAIL lines (PASS for the rest), each of its class (cls_name) and a line of
# out/failures.tsv: a built failure by its step (cls_build), a native word NATIVE, a run by the driver's exit
# (cls_run), a walked count WALKED.
fn: os_walk_witness (@: repo char; @: stage char; @: base char; @: fe char; @: prod char; @: obs char; @: source char; @: out char; int: entry; @: spec char) int
    @@: tags char c.calloc(2U, sizeof(@: char))
    @@: objs char c.calloc(2U, sizeof(@: char))
    @@: names char c.calloc(16U, sizeof(@: char))
    @: counts int c.calloc(16U, c.sizeof(c.int))
    @: cls int c.calloc(16U, c.sizeof(c.int))
    @: res int c.calloc(2U, c.sizeof(c.int))
    @@: lp char c.calloc(1U, sizeof(@: char))
    @: fl c.FILE 0
    @: rec c.FILE 0
    @: modes char 0
    @: mode char 0
    @: dir char 0
    @: exe char 0
    @: log char 0
    @: want char 0
    @: item char 0
    @: eq char 0
    int: nn 0
    int: f 0
    int: m 0
    int: t 0
    int: root 0
    int: x 0
    int: got 0
    int: i 0
    size_t: p 0U
    size_t: q 0U
    if: tags = 0 || objs = 0 || names = 0 || counts = 0 || cls = 0 || res = 0 || lp = 0
        return: 1
    dir_make(out)
    rec: c.fopen(txt_path(out, "record.txt"), "wb")
    fl: c.fopen(txt_path(out, "failures.tsv"), "wb")
    tags[0]: "prod"
    tags[1]: "obs"
    objs[0]: prod
    objs[1]: obs
    # spec: name=count,name=count
    q: c.strlen(spec)
    while: p < q && nn < 16
        item: txt_until(spec + p, ",")
        p: p + (cast: (size_t) c.strlen(item)) + 1U
        eq: c.strchr(item, 61)
        if: eq != 0
            eq[0]: (cast: (char) 0)
            names[nn]: item
            counts[nn]: c.atoi(eq + 1)
            nn: nn + 1
        ---
    ---
    while: m < 2
        mode: "native"
        if: m = 1
            mode: "forced"
        dir: txt_path(out, mode)
        os_mkdir(dir)
        if: m = 0
            x: bld_program_k(repo, stage, base, fe, 0, "-O2 -fstrict-aliasing", source, 0, dir, "p", tags, objs, 2, "", rec, res, lp)
        if: m = 1
            x: bld_program_k(repo, stage, base, fe, "--walk-methods", "-O2 -fstrict-aliasing", source, 0, dir, "p", tags, objs, 2, "", rec, res, lp)
        f: f + ccheck(x = 0, txt_cat3(mode, ": built", ""), txt_cat3("step ", txt_int(x), txt_cat3(" kind ", txt_int(res[0]), txt_cat(" exit ", txt_int(res[1])))), cls, cls_build(x, res), lp[0], fl)
        if: x = 0
            i: 0
            while: i < nn
                got: l1_binds_native(txt_path(dir, "p.lm1"), names[i])
                if: m = 0
                    f: f + ccheck(got = 1, txt_cat3(mode, ": the L1 binds the native word of ", names[i]), txt_cat("found ", txt_int(got)), cls, 11, txt_path(dir, "p.lm1"), fl)
                if: m = 1
                    f: f + ccheck(got = 0, txt_cat3(mode, ": the L1 binds no native word to ", names[i]), txt_cat("found ", txt_int(got)), cls, 11, txt_path(dir, "p.lm1"), fl)
                i: i + 1
            ---
            t: 0
            while: t < 2
                root: 0
                while: root < 2
                    exe: txt_cat3(dir, "/p-", txt_cat(tags[t], ".exe"))
                    log: txt_cat3(dir, "/run-", txt_cat3(tags[t], "-root", txt_cat(txt_int(root), ".log")))
                    x: bld_run(exe, entry, root, dir, log, rec)
                    f: f + ccheck(x = 0, txt_cat3(mode, txt_cat3(" ", tags[t], " root"), txt_cat(txt_int(root), ": the program's result is the entry")), txt_cat("driver exit ", txt_int(x)), cls, cls_run(x), log, fl)
                    if: t = 1
                        i: 0
                        while: i < nn
                            want: txt_cat("LMX_OBSERVE WALK_BODY ", names[i])
                            got: file_count_line(log, want)
                            if: m = 0
                                f: f + ccheck(got = 0, txt_cat3(mode, txt_cat(" root", txt_int(root)), txt_cat(": no walked body of ", names[i])), txt_cat("walked ", txt_int(got)), cls, 12, log, fl)
                            if: m = 1
                                f: f + ccheck(got = counts[i], txt_cat3(mode, txt_cat(" root", txt_int(root)), txt_cat3(": the body of ", names[i], txt_cat(" walked ", txt_int(counts[i])))), txt_cat("walked ", txt_int(got)), cls, 12, log, fl)
                            i: i + 1
                        ---
                    ---
                    root: root + 1
                ---
                t: t + 1
            ---
        ---
        m: m + 1
    ---
    if: rec != 0
        c.fclose(rec)
    if: fl != 0
        c.fclose(fl)
    c.printf("OSWALK %d failures\n", f)
    return: f
end: os_walk_witness

# The SHA-256 of the file at path written to rec as `<hex>  <path>` (a failure as `HASH-FAIL <path>`): 0, or 1.
fn: bld_hash_note (@: rec c.FILE; @: path char) int
    @: hex char c.calloc(65U, 1U)
    if: hex = 0
        return: 1
    if: os_sha256_file(path, hex) != 0
        c.fprintf(rec, "HASH-FAIL %s\n", path)
        c.printf("HASH-FAIL %s\n", path)
        return: 1
    c.fprintf(rec, "%s  %s\n", hex, path)
    c.printf("%s  %s\n", hex, path)
    c.free(hex)
    return: 0
end: bld_hash_note

# The self-test's child (the stage's tools/lmxchild.lm2 with its part text.lm2, the tools sources bld_self
# reads) built by fe and linked with the production runtime prod as out/lmxchild-prod.exe: 0 built, else the
# first failing step (bld_program).
fn: bld_child (@: repo char; @: stage char; @: base char; @: fe char; @: prod char; @: out char) int
    @@: tags char c.calloc(1U, sizeof(@: char))
    @@: objs char c.calloc(1U, sizeof(@: char))
    @: tools char txt_path(stage, "tools")
    @: rec c.FILE 0
    int: x 0
    if: tags = 0 || objs = 0 || tools = 0
        return: 1
    dir_make(out)
    rec: c.fopen(txt_path(out, "record.txt"), "wb")
    tags[0]: "prod"
    objs[0]: prod
    x: bld_program(repo, stage, base, fe, 0, "-O2 -fstrict-aliasing", txt_path(tools, "lmxchild.lm2"), txt_path(tools, "text.lm2"), out, "lmxchild", tags, objs, 1, "-lshell32", rec)
    if: x = 0
        bld_hash_note(rec, txt_path(out, "lmxchild-prod.exe"))
    if: rec != 0
        c.fclose(rec)
    return: x
end: bld_child

# Whether two PE executables are one image apart from what the linker stamps per link: the COFF header's
# TimeDateStamp (e_lfanew + 8) and the optional header's CheckSum (e_lfanew + 88), four bytes each: 1 yes,
# 0 no, -1 when one cannot be read or the first is no PE image.
fn: exe_same (@: a char; @: b char) int
    @: na size_t c.calloc(2U, c.sizeof(c.size_t))
    @: da char 0
    @: db char 0
    size_t: pe 0U
    size_t: k 0U
    int: r -1
    if: na = 0
        return: -1
    da: file_read(a, na)
    db: file_read(b, na + 1U)
    if: da != 0 && db != 0 && na[0] > 64U && sha_byte(da, 0U) = 77U && sha_byte(da, 1U) = 90U
        pe: (cast: (size_t) (sha_byte(da, 60U) | (sha_byte(da, 61U) << 8) | (sha_byte(da, 62U) << 16) | (sha_byte(da, 63U) << 24)))
        if: pe + 92U <= na[0] && sha_byte(da, pe) = 80U && sha_byte(da, pe + 1U) = 69U
            r: 0
            if: na[0] = na[1]
                while: k < 4U
                    da[pe + 8U + k]: (cast: (char) 0)
                    db[pe + 8U + k]: (cast: (char) 0)
                    da[pe + 88U + k]: (cast: (char) 0)
                    db[pe + 88U + k]: (cast: (char) 0)
                    k: k + 1U
                ---
                if: c.memcmp(da, db, na[0]) = 0
                    r: 1
            ---
        ---
    ---
    c.free(da)
    c.free(db)
    c.free(na)
    return: r
end: exe_same

# The frontend of the stage built as stage/label: the application header regenerated from its source, the
# translator source copied, translated by l1trans and compiled strict -O0 with the libc object (the algorithm
# of the frozen stage recipes, now a step list of this tool). 0 built, else the failing step.
fn: bld_frontend (@: repo char; @: stage char; @: base char; @: label char) int
    @@: a char c.calloc(40U, sizeof(@: char))
    @: res int c.calloc(2U, c.sizeof(c.int))
    @: out char txt_path(stage, label)
    @: src char txt_path(stage, "src")
    @: rec c.FILE 0
    @: source char 0
    @: cfile char 0
    @: exe char 0
    int: n 0
    if: a = 0 || res = 0 || out = 0 || src = 0
        return: 1
    if: file_exists(txt_path(out, "record.txt")) != 0
        c.printf("FRONTEND %s exists: a new label for every attempt\n", out)
        return: 1
    dir_make(out)
    rec: c.fopen(txt_path(out, "record.txt"), "wb")
    source: txt_path(out, "frontend-source.lm1")
    cfile: txt_path(out, "frontend.c")
    exe: txt_path(out, "l2trans.exe")
    a[0]: txt_path(repo, "bin/l1trans.exe")
    a[1]: txt_path(src, "l2src/l2_application.h.lm1")
    a[2]: txt_path(stage, "headers/l2src/l2_application.lm1.h")
    if: bld_step(rec, a, 3, src, txt_path(out, "HEADER.log"), res) != 0
        return: 2
    if: file_copy(txt_path(src, "l2src/l2trans.lm1"), source) != 0
        return: 3
    a[1]: source
    a[2]: cfile
    if: bld_step(rec, a, 3, src, txt_path(out, "L1.log"), res) != 0
        return: 4
    a[0]: "C:/Qt/Tools/mingw1310_64/bin/gcc.exe"
    n: bld_cflags(a, 1, repo, stage, base, "-O0", 1, 0)
    if: n < 0
        return: 5
    a[n]: cfile
    a[n + 1]: txt_path(base, "l2_harness/codex_impl56_public_focus_01/gen/l2_libc.o")
    a[n + 2]: "-o"
    a[n + 3]: exe
    if: bld_step(rec, a, n + 4, src, txt_path(out, "COMPILE.log"), res) != 0
        return: 5
    bld_hash_note(rec, txt_path(stage, "headers/l2src/l2_application.lm1.h"))
    bld_hash_note(rec, source)
    bld_hash_note(rec, cfile)
    bld_hash_note(rec, exe)
    c.fclose(rec)
    return: 0
end: bld_frontend

# The C headers of the stage's L1 sources regenerated in place, as bld_frontend regenerates the application header:
# each stage/headers/<dir>/<name>.lm1.h (dir l1src, l2src) whose source stage/src/<dir>/<name>.h.lm1 exists is that
# source's L1 translation. A program's C reads the kernel's prototypes there, so a header left from older sources
# builds it against another kernel (slice 172: a new kernel function was an implicit declaration). Their steps in
# out/record.txt. 0 regenerated, else 1 when a directory cannot be listed, or 1 + the failing header's count.
fn: bld_headers (@: repo char; @: stage char; @: out char) int
    @@: dirs char c.calloc(2U, sizeof(@: char))
    @@: a char c.calloc(4U, sizeof(@: char))
    @: res int c.calloc(2U, c.sizeof(c.int))
    @: len size_t c.calloc(1U, c.sizeof(c.size_t))
    @: at size_t c.calloc(1U, c.sizeof(c.size_t))
    @: rec c.FILE 0
    @: data char 0
    @: line char 0
    @: list char 0
    @: name char 0
    @: source char 0
    size_t: n 0U
    int: d 0
    int: k 0
    if: dirs = 0 || a = 0 || res = 0 || len = 0 || at = 0
        return: 1
    dirs[0]: "l1src"
    dirs[1]: "l2src"
    dir_make(out)
    rec: c.fopen(txt_path(out, "record.txt"), "wb")
    while: d < 2
        list: txt_path(out, txt_cat3("headers-", dirs[d], ".txt"))
        if: os_list_dir(txt_path(stage, txt_cat("headers/", dirs[d])), list) != 0
            if: rec != 0
                c.fclose(rec)
            return: 1
        ---
        data: file_read(list, len)
        at[0]: 0U
        line: 0
        if: data != 0
            line: next_line(data, len[0], at)
        while: line != 0
            n: c.strlen(line)
            if: n > 6U && c.strcmp(line + n - 6U, ".lm1.h") = 0
                name: txt_ndup(line, n - 6U)
                source: txt_path(txt_path(stage, txt_cat("src/", dirs[d])), txt_cat(name, ".h.lm1"))
                if: file_exists(source) != 0
                    k: k + 1
                    a[0]: txt_path(repo, "bin/l1trans.exe")
                    a[1]: source
                    a[2]: txt_path(txt_path(stage, txt_cat("headers/", dirs[d])), line)
                    if: bld_step(rec, a, 3, txt_path(stage, "src"), txt_path(out, txt_cat3(dirs[d], "-", txt_cat(name, ".log"))), res) != 0
                        if: rec != 0
                            c.fclose(rec)
                        return: 1 + k
                    ---
                ---
            ---
            line: next_line(data, len[0], at)
        ---
        d: d + 1
    ---
    if: rec != 0
        c.fclose(rec)
    c.printf("HEADERS %d regenerated\n", k)
    return: 0
end: bld_headers

# One machine module of the stage's src/l2src: the frontend fe translates l2src/STEM.lm2 as a library of machine
# functions (l2trans --library --machine NAME ...) into l2src/STEM.lm1, in place. With header != 0 the prototypes of
# its exports go to l2src/STEM.h.lm1 (--header FILE); without, the module declares all its functions at its top (an
# L1 header may declare them too). names[0..count) are its exports; the step goes to rec, its log to out/STEM.L2.log.
# 0, or 1 when the translation fails.
fn: bld_machine_module (@: rec c.FILE; @: fe char; @: src char; @: base char; @: out char; @: res int; @: stem char; @@: names char; int: count; int: header) int
    @@: a char c.calloc(2U * (cast: (size_t) count) + 8U, sizeof(@: char))
    int: n 2
    int: k 0
    if: a = 0
        return: 1
    a[0]: fe
    a[1]: "--library"
    while: k < count
        a[n]: "--machine"
        a[n + 1]: names[k]
        n: n + 2
        k: k + 1
    ---
    if: header != 0
        a[n]: "--header"
        a[n + 1]: txt_path(src, txt_cat3("l2src/", stem, ".h.lm1"))
        n: n + 2
    ---
    a[n]: txt_path(src, txt_cat3("l2src/", stem, ".lm2"))
    a[n + 1]: txt_path(base, "l2_harness/codex_consumer49_full_01/src/convert.lm2")
    a[n + 2]: txt_path(base, "l2_harness/codex_consumer49_full_01/src/primitive.lm2")
    a[n + 3]: txt_path(src, txt_cat3("l2src/", stem, ".lm1"))
    if: bld_step(rec, a, n + 4, src, txt_path(out, txt_cat(stem, ".L2.log")), res) != 0
        return: 1
    bld_hash_note(rec, txt_path(src, txt_cat3("l2src/", stem, ".lm2")))
    if: header != 0
        bld_hash_note(rec, txt_path(src, txt_cat3("l2src/", stem, ".h.lm1")))
    bld_hash_note(rec, txt_path(src, txt_cat3("l2src/", stem, ".lm1")))
    return: 0
end: bld_machine_module

# The text of l2src/lmx.h.lm1, the kernel's one Lmx header: the value record and its arrays, the type and kind
# codes, the cells' access callbacks, the operations' record, the rows of the arena's index, the walker's value and
# the typed service arrays (the pools) with their chunks. 0, or 1 when a write fails.
fn: decl_lmx (@: f c.FILE) int
    if: c.fputs("include: \"<stddef.h>\" \"<stdint.h>\"\n\n\n# lmx.h - the one Lmx header and the registered address ranges.\n#\n# Lingvamyxa_spec.txt 2, 6.5, 12.1, 19.20; struct_refactoring_version_2.txt\n# 3.1, 3.3, 3.6, 14.1, 14.2, 14.22.\n#\n# The whole point: a child carries no type tag.  A Structure's data addresses an\n# ordered array of void * child values; the type of a child is whichever registered\n# address range its stored VALUE falls into.  The address of the slot itself\n# identifies nothing.\n#\n# This header used to be hand-written C pulled in with L1 `include:` (\"L1 has no\n# decided spelling for aggregate heads of its own\", L1_spec.txt OPEN 10.4).  It is\n# written in L1 now; the C header lmx.lm1.h is generated from it.\n#\n# The poll-escape hook.  Its body cannot live here: L1 header units declare, an\n# executable body in one is refused (\"executable body\").  The kernel owns it, so\n# the header declares the two calls and the kernel defines them -- the fast path\n# (an ordinary flag load and test, spec 19.29.7.1) is inside lmx_msg_poll_escape.\nprototype:\n    fn: lmx_msg_poll_abort () int\n    fn: lmx_msg_poll_escape () int\n", f) < 0
        return: 1
    if: c.fputs("end: prototype\n\n# K07 implementation migration: Lmx is the common graph header. A graph Array\n# is this same object, allocated from its element-typed Array pool; it is NOT\n# the raw {size,data} C descriptor at the start of a larger Structure.\n#\n#   parent  the immediate structural parent; NULL at a structural root. Merge and new Message\n#         creation copy the used graph with the same traversal, rewriting\n#         destination parent links through the source-to-copy map.  This field is\n#         not the reserved source word / call parameter `node`: that parameter is\n#         the lexical space above the method and stays fixed for its activation.\n#   native  a direct reference to this Structure's native body implementation (the C entry),\n#         or null when there is none -- any Structure can be interpreted, a native form is\n#         never required.  Not a lexical element and not a graph field/child slot: execution\n#         (§10/§11) dispatches on this word alone (non-null -> native entry, null -> the\n#         walker over the body operators) and never writes it; graph copy carries it verbatim,\n#         never descends into it, never remaps it.  Replaces the transitional physical\n#         child[0] LmxCallable/METHOD descriptor and its `sig` word entirely -- a callable's\n#         signature (args/return) is now ordinary lexical fields of the Structure itself.\n#\n#   array   fixed physical storage, AFTER the graph header. Its size is a\n#           size_t element/child count, never bytes or capacity. An ordinary\n#           Structure stores void* child references. A graph Array's actual\n#           typed pool determines its backing T: never reinterpret int[] as\n", f) < 0
        return: 1
    if: c.fputs("#           void*[]. This inline pair is storage, not another graph value.\n#\n# A child VALUE is the address of that child in the typed array/range of its type\n# T: a Structure child points at another Lmx header; a primitive child points\n# directly at its cell (an interned char is &all_chars['!']); an Array child points\n# at its LmxArray graph header. Children are never inline Lmx records. Both\n# Structure and Array values have array/parent/native. A callable is an ordinary\n# Structure M: its own declared fields (args/return/body, in lexical order -- L2_spec_ru\n# §10) are its later slots from 0, no reserved slot.  M.parent\n# is its immediate structural parent.  At method entry the reserved `Lmx *node` argument is\n# M.parent: the lexical space above the method.  It stays fixed while nested bodies execute;\n# their own parent links do not rebind it. `node\\field` starts at that above-method space, while\n# the separate hidden `self` is the activation's data instance.\n#\n# The field count is fixed at construction (ABI 14.22).  Nested code may replace the\n# void * references in the slots; it never adds, moves or removes slots.  Nothing\n# else per node beyond `native` above -- no name, no type tag, no vtable.\n# Raw C fixed-storage view. It is also the prefix of the independent List,\n# not the representation of a language Array. &node.array may be borrowed by\n# physical C helpers, but it is not node's address or a classifiable graph value.\nstruct: VoidArray\n    size_t: size\n    @: void data\nend: VoidArray\n", f) < 0
        return: 1
    if: c.fputs("\nstruct: Lmx\n    @: Lmx parent\n    LmxEntry: native\n    VoidArray: array\nend: Lmx\n\n# Array has exactly the common Lmx graph header, not a second header or a\n# wrapper around a standalone descriptor. Its typed address pool distinguishes\n# element T. The C alias preserves that explicit API type without another object.\ntype: LmxArray struct Lmx\n\n", f) < 0
        return: 1
    if: c.fputs("# What a registered range means.  2 lists the child interpretations; these are the\n# ones this tree registers.\n#\n# 2: \"There is a separate address domain for each element type T; a domain may\n# consist of multiple stable blocks.\"  N typed service arrays, one per TYPE, not per\n# category - 6.5 spells it out for one of them: \"For every used Array type T the\n# implementation provides a typed service pool, schematically all_array_of_T.\"\n#\n# So a range carries a concrete type, and the address gives that type outright.  A\n# descriptor from all_array_of_int and one from all_array_of_char are both array\n# descriptors, and are told apart by which range they land in, with nothing stored\n# on either.\n#\n# The kind below stays as the coarse reading of an entry - how to interpret its\n# shape, which the column 2's table gives.  The type says which one it is.\nenum: LmxType\n    LMX_TYPE_NONE 0\n    # primitive pool, 2's all_chars_array\n    LMX_TYPE_CHAR 1\n    # primitive pool of ints\n    LMX_TYPE_INT 2\n    # mutable primitive pool of size_t\n    LMX_TYPE_SIZE_T 3\n    # k.4 (2026-09-25): LmxMethod is gone (Lmx.native replaces it); number kept reserved\n", f) < 0
        return: 1
    if: c.fputs("    # so no other value moves.\n    LMX_TYPE_RESERVED_4 4\n    # 6.5's all_array_of_T for T = char\n    LMX_TYPE_ARRAY_OF_CHAR 5\n    # the same for T = int\n    LMX_TYPE_ARRAY_OF_INT 6\n    # a Structure's void * child-pointer array: an array of the array's OWNER, the arena\n    # (SPEC 1237: \"Structure's child-pointer array is an array of the arena like every\n    # other\"; \"ЧЕМ МАССИВЫ ОТЛИЧАЮТСЯ ОТ ВСЕГО ОСТАЛЬНОГО? НИЧЕМ!!!\", Mikhail,\n    # 2026-09-17).  A slot ADDRESS classifies as this; the child stored in the slot\n    # is classified on its own value.  The number 7 is unchanged; the name is not\n    # `BRANCH` any more, because the spec uses that word for graph branches and this\n    # representation type is only an array of physical references.\n    LMX_TYPE_REFS 7\n    # Distinct all_array_of_T identifiers.  Not one ARRAY_OF_REF category.  An array\n    # is classified by its descriptor address; backing cells of the same pool reuse\n    # this T.  Graph / Array-descriptor / METHOD referents.\n    # T = graph node (pointer to Lmx)\n    LMX_TYPE_LMX 8\n    # T = graph Array (pointer to LmxArray)\n    LMX_TYPE_DESC 9\n    # all_array_of_T for T = Lmx*\n    LMX_TYPE_ARRAY_OF_LMX 10\n    # all_array_of_T for T = LmxArray*\n", f) < 0
        return: 1
    if: c.fputs("    LMX_TYPE_ARRAY_OF_DESC 11\n    # k.4 (2026-09-25): the LmxMethod pool/array is gone with LmxMethod itself; reserved.\n    LMX_TYPE_RESERVED_12 12\n    # an Lmx header: the Structure domain itself\n    LMX_TYPE_STRUCT 13\n    # SPEC 11.2.1 / ABI 3.3: the L2 form `@: ptr char \"hello\"` stores a child pointer into a\n    # typed array of char * values, each pointing directly at a C string.  No length,\n    # no Array record.  Kind PRIMITIVE, stride sizeof(char *).\n    LMX_TYPE_CHAR_PTR 14\n    # Appended so existing numeric ABI values stay stable.  `unsigned` is a distinct\n    # primitive address domain; it is not SIZE_T even on hosts where their widths\n    # happen to match.\n    LMX_TYPE_UNSIGNED 15\n    # Appended independently of the scalar SIZE_T domain: this identifies Array\n    # descriptors whose backing cells are size_t values.\n    LMX_TYPE_ARRAY_OF_SIZE_T 16\n    # A C typedef of unsigned char remains distinct from plain char.\n    LMX_TYPE_UNSIGNED_CHAR 17\n    LMX_TYPE_ARRAY_OF_UNSIGNED_CHAR 18\n    LMX_TYPE_ULONG 19\n    LMX_TYPE_ARRAY_OF_ULONG 20\n    # Independent source-name service storage; never a graph child/value tag.\n    # 21..34 are the existing LMX_DOMAIN_* values; do not reuse them.\n    LMX_TYPE_SOURCE_NAME 35\n", f) < 0
        return: 1
    if: c.fputs("    # Identity-only source symbol occurrence. Spelling lives in the external\n    # name table, not in this cell; it is not a machine operation record.\n    LMX_TYPE_SOURCE_SYMBOL 36\n    # Scalar pointer variables live in pointer cells.  The concrete source pointer\n    # type is encoded as LMX_TYPE_POINTER_BASE + a closed-unit type id, so @T and @@T\n    # occupy distinct address domains.\n    LMX_TYPE_POINTER_BASE 1024\n    # The Message reference -- a pointer cell holding a Message record's address, a letter's\n    # sender -- is LMX_TYPE_POINTER_BASE + 29 (29 is l2trans's l2_msg_ref_ty()).  Named once here:\n    # the kernel, the driver, the selftests and the cells the translator emits all say\n    # LMX_TYPE_MSG_REF.  (An L1 enum value is one literal; the sum is written out.)\n    LMX_TYPE_MSG_REF 1053\n    # Array<@T> descriptors have their own exact address domain.  For the same\n    # closed-unit T id, backing cells use POINTER_BASE + id and the descriptor uses\n    # ARRAY_OF_POINTER_BASE + id.  Array length is dynamic; these values classify\n    # types, not storage slots or capacity.\n    LMX_TYPE_ARRAY_OF_POINTER_BASE 1048576\nend: LmxType\n\n", f) < 0
        return: 1
    if: c.fputs("enum: LmxKind\n    # not a classifiable high-level value\n    LMX_KIND_NONE 0\n    # primitive pool entry, e.g. all_chars_array\n    LMX_KIND_PRIMITIVE 1\n    # k.4 (2026-09-25): LmxMethod is gone (Lmx.native replaces it); reserved.\n    LMX_KIND_RESERVED_2 2\n    # typed graph Array pool entry (the common Lmx header)\n    LMX_KIND_ARRAY 3\n    # a Structure's void * child-pointer array: a storage location, not a value\n    LMX_KIND_CHILDREN 4\n    # pointer-valued array element; type is T\n    LMX_KIND_REF 5\n    # an ordinary Lmx header {parent, native, array}\n    LMX_KIND_STRUCT 6\n    # independent L1 dynamic container (VoidArray); not an Array.  lmx_range_classify\n    # answers LmxKind and the domain kinds (lmx_implements.h.lm1, 7..20) in ONE number space,\n    # so this value follows the last domain kind: 7 was LMX_DOMAIN_KIND_MSG_RECORD, and a\n    # Thread/Message record classified as a List.\n    LMX_KIND_LIST 21\n    # Weak address-keyed source payloads outside the graph's child arrays.\n    LMX_KIND_SOURCE_NAME 22\n    LMX_KIND_SOURCE_SYMBOL 23\n    # Physical field-address backing. Each void * cell holds the ALREADY\n", f) < 0
        return: 1
    if: c.fputs("    # resolved address of a canonical CHILDREN cell, not its value. This is\n    # storage for noncontiguous aliases, not a model tag or an operation.\n    LMX_KIND_FIELD_ADDRESSES 24\nend: LmxKind\n\n# The generic native-entry function-pointer shape (cast to the real prim ABI,\n# LmxPrimitiveEntry, at the one call site that invokes it -- lmx_call.lm1).  Stored\n# directly as Lmx.native (lmx.h.lm1 above); k.4 (2026-09-25) removed the LmxMethod/\n# LmxCallable boxing this type used to be stored through.  A child pointer to a known\n# native function used to be the address of a shared LmxMethod record; that indirection\n# is gone -- `native` is the address of the entry itself, or null.\nfnptr: LmxEntry () void\n\n", f) < 0
        return: 1
    if: c.fputs("# Physical access to one pointer-value cell in a primitive pool.  The pool,\n# not each cell, carries the C99 access operations for its actual pointer\n# object type.  The compiler supplies these for imported C pointer types;\n# ordinary graph references use the void * operations.  Neither callback\n# is a source name or a graph child.\nfnptr: LmxPointerCellRead (@: void cell) @: void\nfnptr: LmxPointerCellWrite (@: void cell; @: void value) int\n\n# One executable node in the body tree.  Not a name: the arena range says it is an op.\n# Remaining children of the hosting Structure are its operands, in order.\nstruct: LmxOp\n    int: code\nend: LmxOp\n\n", f) < 0
        return: 1
    if: c.fputs("# VoidArray is only the raw physical fixed-storage view. It has no graph\n# identity, parent or native. Graph Arrays use LmxArray above. Independent\n# DynamicArray/List storage may still compose this raw view.\n\n# Dynamic array of void* cells: List public shape; copier map keys/vals.\n# offsetof(array) == 0 so a DynamicArray* may be read as VoidArray* for size/data.\nstruct: VoidDynamicArray\n    VoidArray: array\n    size_t: capacity\nend: VoidDynamicArray\n\n\n", f) < 0
        return: 1
    if: c.fputs("\n# One entry of an arena's address index: the half-open interval [lo, hi) of ONE\n# typed array, the descriptor of that array, and the arena that truly owns its\n# storage.  `owner` equals the indexing arena for a local interval.  An imported\n# sealed interval is a non-owning view in the same sorted index and keeps the\n# original owner; importing never adopts its blocks or array descriptor.\n#\n# The entry carries no stride, kind, type or qualifier code of its own -- exact\n# representation and the optional physical profile are read through `array`.\n# Arrays never move, so it is these ENTRIES that are ordered and bisected, never\n# the arrays.\n\n", f) < 0
        return: 1
    if: c.fputs("# Fixed char-array descriptor `{size_t len; char *data}` (author 2026-09-24: string = this\n# descriptor with exact len, no NUL). One type for the char element: string values and\n# pool chunk cells (`LmxChunk.cells`) share it. `char *` is the LM1 spelling; chunk\n# helpers still count capacity/len in BYTES and convert via lmx_chunk_cells/lmx_chunk_room.\nstruct: LmxCharArray\n    size_t: len\n    @: char data\nend: LmxCharArray\n\n# Compositional DynamicArray: fixed char descriptor + capacity (Q18 / FABLE-134; LmxCharArray).\nstruct: LmxCharDynamicArray\n    LmxCharArray: array\n    size_t: capacity\nend: LmxCharDynamicArray\n\n", f) < 0
        return: 1
    if: c.fputs("struct: LmxRange\n    @: void lo\n    @: void hi\n    @: LmxPool array\n    # Opaque only because LmxArena is defined after this shared ABI record.  Every writer\n    # stores an actual LmxArena physical address and lmx_range_home casts at the boundary.\n    @: void owner\n    # The chunk of array whose storage starts at lo, as the last walk of array's chain found it, and the array's\n    # chain_gen at that walk (RANGE-CELL-POOL-LINEAR).  It stands for the walk while the array's chain_gen is the\n    # same: no chunk has left the chain since, so the chunk is still in it.  Opaque (an LmxChunk) for the same\n    # reason as owner; 0 until the first walk (lmx_range_entry_chunk).\n    @: void chunk\n    size_t: chunk_gen\nend: LmxRange\n\n", f) < 0
        return: 1
    if: c.fputs("\n\n# A typed service array.  2 lists them and 6.5 spells the Array one out: one per\n# primitive C type, one of {addr, sig} method records, one of {size, data} Array\n# descriptors per element type, and one of Lmx headers.\n#\n# This record IS the array's descriptor: the arena's index entry for an address\n# points at it, and every cell of the array answers with this record's kind and\n# type.  An entry names the array, the array says what is in it -- nothing else\n# repeats the type (Mikhail, 2026-09-17).\n#\n# A non-const variable LIVES in the big array of its type, so that array has to grow.\n# It cannot grow by reallocating: live L1/L2 arena entries never relocate, including\n# at end_turn.  A service array full of live cells is the worst possible thing to\n# move.  So it grows by adding a CHUNK, and each chunk joins the arena's index as\n# one more interval of this same array.\n#\n# A typed service array is therefore a set of registered intervals, not one interval.\n# Classification is unaffected - an address falls in exactly one chunk, and every\n# chunk of the array answers with the same type.\n#\n# Two disciplines share this machinery, which is the point.  Interned immutable\n# atoms are laid out once and addressed by value - all_chars_array has its 256 cells\n# from the start and never grows (14.7's settled half).  Mutable variable cells are\n", f) < 0
        return: 1
    if: c.fputs("# handed out one at a time and the array grows to fit them.  What makes an entry a\n# char is the range it sits in, not which discipline produced it.\n# A chunk carries no ownership flag: its storage is NEVER the pool's to free.  It is an\n# arena block -- the constructor's (lmx_pool_make takes a payload block) or a grown chunk's\n# (lmx_pool_add_chunk takes one for the storage and one for this very record) -- or, for\n# lmx_pool_over, storage the caller keeps in its own frame.  lmx_pool_release therefore\n# retires only the interval of each chunk and the array itself; the arena's block list is\n# what frees the storage, at lmx_arena_release.\n# Chunk payload is stride-generic RAW storage (coordinator -134): element type is known\n# only at run time via the pool's stride/kind/type. Static descriptor is LmxCharArray\n# (one char-element type for strings and chunk cells; author 2026-09-24).\n# cells.array.len / cells.capacity are BYTES; cell counts go through lmx_chunk_cells / lmx_chunk_room\n# (the sole cell-arithmetic helper pair). Not a void cast, not a wrapper/union, not per-T families.\n# Fixed array of arena index entries.\nstruct: LmxRangeArray\n    size_t: len\n    @: LmxRange data\nend: LmxRangeArray\n\n", f) < 0
        return: 1
    if: c.fputs("# Compositional DynamicArray over LmxRangeArray (Q18 / FABLE-134 REVIEW).\nstruct: LmxRangeDynamicArray\n    LmxRangeArray: array\n    size_t: capacity\nend: LmxRangeDynamicArray\n\n# Complete current activation/cell Value. The typed pool owns one context\n# companion per physical pointer cell; neither graph fields nor admission\n# history identify that current state. The historic name is backend-neutral.\nstruct: LmxWalkValue\n    int: present\n    int: kind\n    int: type\n    @: void ref\n    int: number\n    size_t: wide\n    unsigned: natural\n    ulong: longnum\n    char: byte\n    @: Lmx model\n    @: Lmx references\n    @: LmxWalkValue referent\nend: LmxWalkValue\n\n", f) < 0
        return: 1
    if: c.fputs("struct: LmxChunk\n    LmxCharDynamicArray: cells\n    # Pointer-cell context companions are trailing storage of THIS chunk's\n    # record allocation. Exact cell ordinal selects its state, not a second\n    # address/Model registry. Caller-owned unaccompanied chunks leave this 0.\n    @: LmxWalkValue value_contexts\n    @: LmxChunk next\n    # The collection pass that last WALKED this chunk (lmx_gc): a chunk whose stamp is the\n    # arena's current generation was reached from a root, so it stays.  A stamp and not a\n    # flag: a new pass needs nothing cleared, and \"did this pass reach it\" is one comparison.\n    # Zero means no pass has walked it.  The granularity is the chunk, because that is the\n    # granularity at which the arena's storage is freed -- a chunk is one block.\n    unsigned: mark\nend: LmxChunk\n\n", f) < 0
        return: 1
    if: c.fputs("define: LMX_POOL_ROLE_PLAIN 0\ndefine: LMX_POOL_ROLE_FN 1\nstruct: LmxPool\n    @: LmxChunk head\n    @: LmxChunk tail\n    size_t: stride\n    size_t: chunk_capacity\n    int: kind\n    int: type\n    # A receiver-produced Structure uses the same Lmx representation in a\n    # distinct arena pool. This is physical classification, not an opcode or\n    # a name stored in the graph. Ordinary data Structures remain role 0.\n    unsigned: role\n    LmxPointerCellRead: pointer_read\n    LmxPointerCellWrite: pointer_write\n    # Optional PHYSICAL receiver-expression/profile identity.  This is the address of an\n    # ordinary graph Structure in its owner's arena, not a wrapper or numeric qualifier.\n    # kind/type continue to say exactly how cells are represented; two arrays may therefore\n    # have identical representation and different profiles.  Qualification is found only\n    # by address -> range -> array -> this physical graph reference.\n    @: Lmx profile\n    # Lifecycle/GC policy only.  A sealed array cannot grow or hand out more cells, and GC\n    # neither marks nor sweeps its chunks.  This bit NEVER means any language qualifier:\n    # sharing/copy decisions compare the explicit physical profile reference instead.\n", f) < 0
        return: 1
    if: c.fputs("    unsigned: sealed\n    # The arena's list of its N arrays, linked through the descriptors themselves:\n    # an array of the arena is exactly this record, so no second node describes it\n    # (Mikhail, 2026-09-17: \"N массивов в арене ... ЧТО ЕЩЁ НАДО?\").\n    @: LmxPool next\n    # Counts the times a chunk left this array's chain (lmx_pool_chunk_drop, lmx_pool_release, an arena drop of the\n    # array's block).  A growing chain leaves it alone.  An index entry's cached chunk is good while this is the\n    # value it was cached at (LmxRange chunk_gen).  Never reset: a new array starts at 0 from its zeroed record.\n    size_t: chain_gen\nend: LmxPool\n", f) < 0
        return: 1
    return: 0
end: decl_lmx

# The text of l2src/lmx_arena_blocks.h.lm1, the arena's block list: its codes, its disposer type, its block record
# and the prototypes of the list's functions (src/l2src/lmx_arena_blocks.lm2). 0, or 1 when a write fails.
fn: decl_arena_blocks (@: f c.FILE) int
    if: c.fputs("include: \"<stddef.h>\"\n\ndefine: LMX_ARENA_BLOCKS_OK 0\ndefine: LMX_ARENA_BLOCKS_INVALID 1\n\nfnptr: LmxArenaBlockDisposer (@: void base; size_t: n) void\n\n# Owner-local storage bookkeeping, not Message lifecycle policy. Node and payload\n# ownership are exclusive. Metadata nodes must be separate free()-compatible\n# allocations. A null disposer means free(base); a custom disposer owns cleanup\n# of base, must return normally and must not mutate/traverse this block list.\n# class is opaque range/type metadata: it is not a per-Lmx field tag.\nstruct: LmxArenaBlock\n    @: void base\n    size_t: n\n    unsigned: class\n    LmxArenaBlockDisposer: dispose\n    @: LmxArenaBlock next\nend: LmxArenaBlock\n\n", f) < 0
        return: 1
    if: c.fputs("prototype:\n    fn: lmx_arena_blocks_push (@@: LmxArenaBlock head; @: LmxArenaBlock node) int\n    fn: lmx_arena_blocks_remove (@@: LmxArenaBlock head; @: LmxArenaBlock node) int\n    fn: lmx_arena_blocks_can_move (@@: LmxArenaBlock dst; @@: LmxArenaBlock src) int\n    fn: lmx_arena_blocks_move_all (@@: LmxArenaBlock dst; @@: LmxArenaBlock src) int\n    fn: lmx_arena_blocks_dispose_all (@@: LmxArenaBlock head) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_arena_blocks

# The text of l2src/lmx_arena.h.lm1, the arena: the records of its `implements` table, its record and the prototypes
# of the manager's and the index's functions (src/l2src/lmx_arena.lm2, src/l2src/lmx_range.lm2). 0, or 1 when a
# write fails.
fn: decl_arena (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx.h.lm1\"\npredef: \"lmx_arena_blocks.h.lm1\"\n\n# The arena of a Message (Lingvamyxa_spec.txt 2, 6.5).  Mikhail, 2026-09-17, verbatim:\n# \"У нас есть арена (там менеджер) она предоставляет N массивов и таблицу\n# адрес->дескриптор содержимого для типизации void *, также может присоединять другую\n# арену. ЧТО ЕЩЁ НАДО?\"\n#\n# So one object holds three things and the manager of the arena is the only writer of\n# each:  what the arena OWNS (its block list), its N arrays (the typed service arrays,\n# each of which IS its descriptor), and the index that answers, for an address, the\n# descriptor of the array containing it.\n#\n# The arrays never move, so the index's ENTRIES are what is ordered and bisected, never\n# the arrays.  An entry carries no type: stride, kind and type belong to the array the\n# entry names.  Nothing outside this module writes the index, and nothing at all gates\n# writing into the cells themselves -- code that holds a reference and has determined\n# its type once writes straight into the cell, because a cell's address never changes.\n# D-105 (the author's Q39, 2026-09-27; steps/d105-index-table.md; Codex, 2026-09-28): one address\n# correspondence of the `implements` table.  `value` was admitted to the named Structure `req`; the entry is a\n# view of where req's field j is in the value (lmx_implements_at) -- never a Structure made for it:\n#   frame, at, n: the size cells frame[at .. at + n) of the admitting walk frame (ADMIT_AS), read in place;\n#   map, n:       the translator's static map of that pair of types (a native admission), compiled metadata;\n#   neither:      positional identity correspondence, not physical-layout evidence;\n", f) < 0
        return: 1
    if: c.fputs("#                 with `holes`, an empty physical slot is not carried (item 738).\n# The frame cells and the map carry TWO targets per required field (K01): the ordinal half at\n# [j] -- the value's field named as req's field j, at its own occurrence -- and the last half at\n# [n + j], which is what a bare `name` reaches (the value's last occurrence of that name,\n# lmx_implements_at_last).  `n` stays the semantic width of req in both halves' indexing.\n# The entry holds `value` weakly: it never keeps the value alive, and it leaves in the pass that frees it\n# (lmx_arena_impl_prune) -- an address that comes back must not inherit another value's correspondence.\n# Immutable, typed dependencies of a receiving contract. These are arena\n# bookkeeping, not executable graph fields or a saved ancestor graph. Values\n# of primitive cells are deliberately absent; names never participate here.\nstruct: LmxImplContractFact\n    @: Lmx owner\n    size_t: field\n    int: kind\n    int: type\n    size_t: extent\n    @: Lmx child\n    @: Lmx reference\n    @: void cell\n    int: executable\nend: LmxImplContractFact\nstruct: LmxImplContractFactArray\n    size_t: len\n    @: LmxImplContractFact data\n", f) < 0
        return: 1
    if: c.fputs("end: LmxImplContractFactArray\nstruct: LmxImplContractFactDynamicArray\n    LmxImplContractFactArray: array\n    size_t: capacity\nend: LmxImplContractFactDynamicArray\nstruct: LmxImplContract\n    LmxImplContractFactDynamicArray: facts\n    size_t: owners\n    int: interface\nend: LmxImplContract\n\nstruct: LmxImplEntry\n    @: Lmx value\n    @: Lmx req\n    # Non-owning module-lifetime schema identity, never dereferenced or classified.\n    # Required models and identity maps do not establish this token; zero is unknown.\n    @: void layout\n    @: Lmx frame\n    size_t: at\n    @: size_t map\n    size_t: n\n    int: holes\n    # 0: address map only; 1: one Consumer's used paths; 2: full receiving\n    # proof. A new Consumer rechecks state 1, while state 2 is stable after\n", f) < 0
        return: 1
    if: c.fputs("    # checked graph mutations. This is not a property of the physical holes.\n    int: reception_proof\n    # Managed immutable typed requirement dependencies. Temporary entry\n    # copies borrow this pointer; only stored arena entries retain it.\n    @: LmxImplContract contract\n    # A computed correspondence owns its copied map outside the graph. Static\n    # module maps and frame-backed views leave this zero.\n    int: owned_map\n    # The code selected for this value may use source ordinals different from\n    # the value's physical slots. Only the self entry carries this proved\n    # execution projection; its ordinary self-view above stays positional.\n    @: size_t exec_map\n    size_t: exec_n\nend: LmxImplEntry\n\n", f) < 0
        return: 1
    if: c.fputs("struct: LmxArena\n    @: LmxArenaBlock blocks\n    @: LmxPool arrays\n    # Sorted address index as one DynamicArray of LmxRange (Q18). len = live entries;\n    # capacity = allocated room. Storage is malloc/realloc, not an arena typed array.\n    LmxRangeDynamicArray: index\n    # The mark generation of the last collection pass (lmx_gc).  The pass bumps it and stamps\n    # every chunk it walks, so \"is this reachable\" is one comparison per chunk and nothing has\n    # to be cleared between passes.  It is the arena's own bookkeeping, like the index: no\n    # caller reads it, and only the collection pass writes it.\n    unsigned: generation\n    # 1 = letter-scale arena (Mikhail 19.09 simplified): same index + array\n    # descriptors + address stability; no GC pass; no multi-chunk growth per array.\n    # Cleared by release / left 0 after attach empties the donor.\n    unsigned: simple\n    # Disposable classification-only union for a graph-copy source. It may\n    # inspect foreign mutable ranges but owns none of their cells; it cannot\n    # allocate, attach, or be attached to a live Message arena.\n    unsigned: source_view\n    # D-105: the `implements` table's address correspondences (LmxImplEntry) -- malloc'd like\n    # the index, `impl_len` live entries of room for `impl_cap`.  Written only by\n    # lmx_implements_register and lmx_arena_impl_prune; attach moves the donor's.\n    @: LmxImplEntry impl\n    size_t: impl_len\n", f) < 0
        return: 1
    if: c.fputs("    size_t: impl_cap\nend: LmxArena\n\nprototype:\n    # Zero the arena.  A by-value arena must be cleared before it is opened; opening a\n    # non-empty one is refused, exactly as a pool refuses to be opened twice.\n    fn: lmx_arena_open (@: LmxArena arena) int\n    # Letter-scale open (POLL 19.29.7.1 / Mikhail 19.09): same LmxArena, primed\n    # small index capacity; GC and multi-chunk growth are refused. Index,\n    # array descriptors and address stability are unchanged.\n    fn: lmx_arena_open_simple (@: LmxArena arena) int\n    fn: lmx_arena_open_source_view (@: LmxArena arena) int\n    # The arena's array of this kind and type, or null when it has none yet.\n    fn: lmx_arena_find (@: LmxArena arena; int: kind; int: type) @: LmxPool\n    # The same lookup with an exact physical receiver-profile identity.  profile=0 is the\n    # ordinary unqualified array and is what lmx_arena_find selects.\n    fn: lmx_arena_find_profiled (@: LmxArena arena; int: kind; int: type; @: Lmx profile) @: LmxPool\n    # A cell (or `count` consecutive cells) of the arena's array of this kind and type:\n    # the array is found among the arena's N arrays, or MADE when the arena has none of\n    # that kind and type yet.  A mutable value is therefore an element of THAT array --\n    # never an array of its own.\n    fn: lmx_arena_take (@: LmxArena arena; size_t: stride; int: kind; int: type) @: void\n    fn: lmx_arena_take_n (@: LmxArena arena; size_t: stride; int: kind; int: type; size_t: count) @: void\n    fn: lmx_arena_take_profiled (@: LmxArena arena; size_t: stride; int: kind; int: type; @: Lmx profile) @: void\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_arena_take_n_profiled (@: LmxArena arena; size_t: stride; int: kind; int: type; @: Lmx profile; size_t: count) @: void\n    # Same Lmx representation, but a distinct typed Structure pool for the\n    # result of a receiver. Ordinary allocation always selects role 0.\n    fn: lmx_arena_take_struct_role (@: LmxArena arena; @: Lmx profile; unsigned: role) @: Lmx\n    # A run of pointer-object cells in the primitive pool of this exact\n    # physical type/profile. Access callbacks belong to the pool, not to\n    # names or individual cells. A mismatched existing pool is refused.\n    fn: lmx_arena_pointer_cells_profiled (@: LmxArena arena; int: type; @: Lmx profile; size_t: stride; LmxPointerCellRead: read; LmxPointerCellWrite: write; size_t: count) @: void\n    fn: lmx_arena_pointer_void_read (@: void cell) @: void\n    fn: lmx_arena_pointer_void_write (@: void cell; @: void value) int\n    # An array joins: the descriptor is linked into the arena's arrays and the block\n    # carrying the descriptor (when there is one) joins the arena's block list.  The\n    # interval is registered by lmx_arena_span, which the same caller does next.\n    fn: lmx_arena_array (@: LmxArena arena; @: LmxPool array; @: LmxArenaBlock record) int\n    # An array leaves the arena's list (it is no longer one of its N arrays).  Its\n    # intervals are retired by lmx_range_drop, one per chunk.\n    fn: lmx_arena_array_drop (@: LmxArena arena; @: LmxPool array) int\n    # One interval [base, base + bytes) of one array joins the arena's index.  This IS\n    # the insertion into the table, and only the arena's manager performs it.\n    fn: lmx_arena_span (@: LmxArena arena; @: LmxPool array; @: void base; size_t: bytes) int\n    # Detach one block: its interval leaves the index first, then the block leaves the\n    # list.  Ownership and typing never disagree -- and the block that CARRIES a\n    # descriptor goes with the array it describes: the array leaves the arena's list of\n    # its N arrays as that block leaves the block list, so the arena never keeps a\n", f) < 0
        return: 1
    if: c.fputs("    # descriptor whose record it gave up.  Every other block drops as a miss on that\n    # walk (the walk only compares addresses and dereferences nothing).\n    fn: lmx_arena_drop (@: LmxArena arena; @: LmxArenaBlock node) int\n    # A restore point: the arena's block list as it stands now (the list is a stack, so\n    # the mark is simply its head).  A construction that must be all-or-nothing takes a\n    # mark first and reverts to it on failure.\n    fn: lmx_arena_mark (@: LmxArena arena) @: LmxArenaBlock\n    # Another arena attaches to this one: its intervals join this index, its arrays join\n    # this arena's N arrays and its blocks join this arena's list, so one arena owns both.\n    # Nothing moves, so every address and every live pointer still answers -- which is the\n    # whole point of attaching rather than copying (Mikhail, 2026-09-17: \"также может\n    # присоединять другую арену\"; \"увеличиваем просто число массивов и не паримся, чтобы\n    # ареса не переезжали\").  The attached arena is left empty.\n    # A primitive record whose owner is exactly the donor arena is rebound to\n    # the receiver arena as part of the transfer. A record owned by a graph\n    # subject keeps that subject's address; a refused attach changes neither.\n    fn: lmx_arena_attach (@: LmxArena arena; @: LmxArena other) int\n    # Drop every block added since the mark, retiring each one's interval.  Blocks the\n    # arena already held before the mark are untouched, and nothing that survived the\n    # mark is disturbed: this is how merge and graph copy keep \"the whole, or nothing\".\n    # The arrays the marked construction added go with those blocks (lmx_arena_drop), so\n    # a revert leaves the list of the N arrays exactly as the mark found it.\n    fn: lmx_arena_revert (@: LmxArena arena; @: LmxArenaBlock mark) int\n    # Release everything the arena owns, retiring every entry it holds.\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_arena_release (@: LmxArena arena) int\n    # The next mark generation for a collection pass.  Never zero: a freshly cleared chunk\n    # holds zero, and the first pass must not read that as its own stamp.\n    fn: lmx_arena_generation_next (@: LmxArena arena) unsigned\n    # D-105: drop every `implements` correspondence whose value, model or table no longer\n    # classifies as a live Structure of this arena -- run where storage leaves (the sweep,\n    # a revert), before any address can be handed out again.\n    fn: lmx_arena_impl_prune (@: LmxArena arena) void\n    # Retire records added after a failed copy/merge, including their owned maps.\n    fn: lmx_arena_impl_truncate (@: LmxArena arena; size_t: keep) void\n    # D-105: room for `need` correspondences in that table.  0 = there is room.\n    fn: lmx_arena_impl_room (@: LmxArena arena; size_t: need) int\n    fn: lmx_arena_impl_contract_retain (@: LmxImplContract contract) void\n    fn: lmx_arena_impl_contract_release (@: LmxImplContract contract) void\n\n", f) < 0
        return: 1
    if: c.fputs("    # The index itself: the arena's index of its arrays, one entry per interval.  An\n    # entry names an array and its interval; the entries are bisected, never walked,\n    # and only the arena's manager inserts or retires one.\n    fn: lmx_range_reserve (@: LmxArena arena; size_t: need) int\n    # Read-only address-interval lookup, including an interior field address.\n    # Unlike classify it does not prove that a cell was handed out; callers\n    # must check the aligned cell start separately before using its storage.\n    fn: lmx_range_entry_at (@: LmxArena arena; @: void p) @: LmxRange\n    fn: lmx_range_add (@: LmxArena arena; @: LmxPool array; @: void lo; @: void hi) int\n    # Insert a range view while preserving its true owner.  Used by arena attach and by\n    # transitive import; ordinary allocation always uses lmx_range_add (owner=arena).\n    fn: lmx_range_add_view (@: LmxArena arena; @: LmxArena owner; @: LmxPool array; @: void lo; @: void hi) int\n    fn: lmx_range_drop (@: LmxArena arena; @: void lo; @: void hi) int\n    # Import every sealed range visible in `source` as non-owning views.  The operation is\n    # idempotent and transitive, preserves each entry's true owner, and never links foreign\n    # arrays into the borrower's local array/ownership lists.\n    fn: lmx_range_import (@: LmxArena arena; @: LmxArena source) int\n    # Narrow form for a profiled copy/merge: import only sealed ranges whose array carries\n    # this exact nonzero physical profile.  Unrelated sealed profiles stay unclassified.\n    fn: lmx_range_import_profile (@: LmxArena arena; @: LmxArena source; @: Lmx profile) int\n    # Scratch copy-source only: classify all typed cells in source, including\n    # mutable lexical context. No ownership or runtime import is transferred.\n    fn: lmx_range_import_source_view (@: LmxArena arena; @: LmxArena source) int\n    # Remove only borrowed index intervals of one physical profile. The true\n", f) < 0
        return: 1
    if: c.fputs("    # owner's local ranges are never retired by this operation. Call while the\n    # foreign owner's ranges are still live, before releasing its arena.\n    fn: lmx_range_unimport_profile (@: LmxArena arena; @: Lmx profile) int\n    # Seal every array carrying this exact nonzero profile (a qualified branch's pools); 0, or 1 when none does.\n    fn: lmx_arena_seal_profile (@: LmxArena arena; @: Lmx profile) int\n    # What the table answers for an EXACT LIVE CELL START: how to read the cell, and\n    # which array it came from. An interior address, an aligned spare-capacity address\n    # and an address in a registered but still empty chunk answer nothing. The range is\n    # bisected first; its lo plus the descriptor's stride identify the cell, and that\n    # range's own chunk count decides whether the cell has been handed out.\n    fn: lmx_range_classify (@: LmxArena arena; @: void p) int\n    fn: lmx_range_type_of (@: LmxArena arena; @: void p) int\n    fn: lmx_range_stride (@: LmxArena arena; @: void p) size_t\n    # Exact live-cell descriptor, including a range imported for read-only\n    # source classification. The local-only lmx_range_pool remains the\n    # allocator/GC ownership query.\n    fn: lmx_range_cell_pool (@: LmxArena arena; @: void p) @: LmxPool\n    # Read an already allocated typed pointer cell through its pool's exact\n    # callback. Classification/read does not depend on allocation helpers.\n    fn: lmx_pointer_pool_in (@: LmxArena arena; @: void cell) @: LmxPool\n    fn: lmx_pointer_value_in (@: LmxArena arena; @: void cell) @: void\n    # The descriptor of the array containing the address: what code casts and writes\n    # through (\"_Получив дескриптор типа код сразу делает приведение типа указателя и\n    # пишет напрямую в ячейку_ _Это обязательно_\"), or null when no array has it.\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_range_pool (@: LmxArena arena; @: void p) @: LmxPool\n    # Allocator-only containing-interval lookup. Unlike lmx_range_pool, this accepts\n    # spare capacity and an empty registered chunk; it exists so lmx_pool_take_n can\n    # verify ownership before handing out the first cell. It is local-only and is not\n    # a type/classification result.\n    fn: lmx_range_interval_pool (@: LmxArena arena; @: void p) @: LmxPool\n    # The true owner and physical receiver-profile identity found through the same range\n    # lookup.  Imported views answer their foreign owner/profile.  lmx_range_pool remains\n    # strictly local so allocator and GC ownership can never adopt an imported range.\n    fn: lmx_range_home (@: LmxArena arena; @: void p) @: LmxArena\n    fn: lmx_range_profile (@: LmxArena arena; @: void p) @: Lmx\n    # The mark of a qualified value read from the index alone: the cell's profile when it is nonzero and the\n    # cell's array is sealed (a static branch after the prologue, a run-time branch after lmx_arena_seal_profile);\n    # 0 for an unprofiled, an unsealed or an absent cell.  Imported views answer as their owner's array does.\n    fn: lmx_range_sealed_profile (@: LmxArena arena; @: void p) @: Lmx\n    # Compare an address's exact type domain to the domains of physical roots.\n    # Neither ownership nor sealing establishes such a match.\n    fn: lmx_range_has_root_profile (@: LmxArena arena; @: void p; @@: Lmx roots; size_t: count) int\n    # Write barrier, not a type query: test every live byte touched by one store,\n    # including interior addresses and explicitly imported range views.  An\n    # overflowing byte span is conservatively rejected. Spare capacity is not live.\n    fn: lmx_range_write_overlaps_profile (@: LmxArena arena; @: void p; size_t: bytes; @: Lmx exact_profile; @@: Lmx roots; size_t: root_count) int\n    # FABLE-134: address of the by-value index DynamicArray / its fixed base (offsetof 0).\n    fn: lmx_arena_index_data (@: LmxArena arena) @: LmxRange\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_arena_index_len (@: LmxArena arena) size_t\n    fn: lmx_arena_index_cap (@: LmxArena arena) size_t\n    fn: lmx_arena_index_set_data (@: LmxArena arena; @: LmxRange data) void\n    fn: lmx_arena_index_set_len (@: LmxArena arena; size_t: len) void\n    fn: lmx_arena_index_set_cap (@: LmxArena arena; size_t: capacity) void\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_arena

# The text of l2src/lmx_scratch.h.lm1, the temporary-frame store: its answers, its record and its marks' record and the
# prototypes of its functions (src/l2src/lmx_scratch.lm2). 0, or 1 when a write fails.
fn: decl_scratch (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx.h.lm1\"\npredef: \"l2src/lmx_arena.h.lm1\"\npredef: \"l2src/lmx_pool.h.lm1\"\npredef: \"l2src/lmx_implements.h.lm1\"\n\n# lmx_scratch.h - a temporary-frame store: last-in first-out storage of an execution\n# context, for whatever a running piece of code needs only until it returns.\n#\n# GENERAL, not the interpreter's: nothing here knows what is stored.  It exists because\n# L2 had no such thing -- \"an array is the owner's storage, not a general allocator:\n# cells are added on demand and never individually returned ... a caller that must reuse\n# cells keeps its own free list over them\" (lmx_pool.h.lm1) -- and because the obvious C\n# answers (an automatic variable-length array, thread-local storage, a private allocator\n# of one unit) do not survive a rewrite of their user in L2.\n#\n# What it is made of.  ONE array of the arena (LmxPool) of pointer-sized cells, domain\n# LMX_DOMAIN_SCRATCH / kind LMX_DOMAIN_KIND_SCRATCH (lmx_implements.h.lm1), in an arena\n# that belongs to the execution context and is NEVER attached to a Message: the store is\n# outside the semantic state of every graph, so no copier, no collection pass and no\n# classification of a graph ever meets it.  That arena is an ORDINARY one\n# (lmx_arena_open), not a letter-scale one: lmx_arena_open_simple refuses every chunk\n# after the first (lmx_pool_add_chunk, `arena\\simple`), which would be a hidden cap.\n# The pool hands cells out once (lmx_pool_take_n: growth adds a chunk, an address handed\n# out never moves, nothing is returned); the store keeps a CURSOR over the pool's own\n", f) < 0
        return: 1
    if: c.fputs("# chunk chain, and a rewind makes the same cells available again.  Hence:\n#   * after warm-up a take is a bump of the cursor: no malloc, no free, no new block;\n#   * a slice taken by a caller stays where it is while its callees take and rewind, and\n#     while the store grows -- pointers into it may be held;\n#   * there is no cap: a request the chunks cannot seat makes the pool add one, and a\n#     request larger than a chunk gets a chunk of its own size (lmx_pool_take_n).  The\n#     pool then KEEPS that size as its growth step, so the step given to\n#     lmx_scratch_open is where growth starts, not what it stays at;\n#   * the pool's `count` of a chunk is the high-water mark of that chunk and the cursor\n#     never runs ahead of it, which is what keeps the pool from handing out cells that\n#     are live.\n#\n# Discipline.  Storage is released only by rewinding to a MARK, and marks nest: the mark\n# rewound must be the most recent one still outstanding of THIS store.  A mark of another\n# store, a mark already rewound and a mark taken before one that is still outstanding are\n# all refused, and a refusal changes nothing.  The mark is a small record in the caller's\n# own frame; the store keeps no list of them.\n#\n# Ownership.  The caller provides the three records (LmxScratch, its LmxPool, the\n# LmxArena) and keeps them for the life of the execution context; lmx_scratch_close\n# gives the cells back to the arena and the owner then releases the arena\n# (lmx_arena_release).  One store serves one thread of execution at a time; two contexts\n# use two stores and never see each other.\n#\n", f) < 0
        return: 1
    if: c.fputs("# Cost.  take: O(1) on the warm path; O(chunks) only while skipping chunks too small for\n# a request; one chunk added on the cold path, at most once per new high-water mark.\n# mark, rewind: O(1).  Contents of a slice are whatever the last user left: the taker\n# initialises what it reads.\n\ndefine: LMX_SCRATCH_OK 0\n# Null or unopened store, zero size, a size whose rounding overflows, a second open.\ndefine: LMX_SCRATCH_INVALID 1\n# The pool could not grow.  The store is unchanged and stays usable: a failed growth\n# leaves the array's growth step as it was (lmx_pool_take_n), so a later, smaller\n# request grows normally.\ndefine: LMX_SCRATCH_NOMEM 2\n# The mark is not the most recent outstanding mark of this store.  Nothing changed.\ndefine: LMX_SCRATCH_BAD_MARK 3\n# Close with marks still outstanding.  Nothing changed.\ndefine: LMX_SCRATCH_BUSY 4\n\n", f) < 0
        return: 1
    if: c.fputs("struct: LmxScratch\n    @: LmxArena arena\n    @: LmxPool cells\n    # The cursor: the chunk it is in and how many cells of that chunk are in use.\n    @: LmxChunk at\n    size_t: used\n    # The most recent outstanding mark (0: none) and the last serial given out.\n    size_t: top\n    size_t: serial\n    # The ordinary growth step, in cells, as given to lmx_scratch_open.\n    size_t: step\nend: LmxScratch\n\n", f) < 0
        return: 1
    if: c.fputs("# Where the cursor stood, which store that was, and which mark was outstanding before\n# this one.  An automatic object of whoever takes it.\nstruct: LmxScratchMark\n    @: LmxScratch owner\n    @: LmxChunk at\n    size_t: used\n    size_t: serial\n    size_t: below\nend: LmxScratchMark\n\nprototype:\n    # Open `s` over the caller's `cells` record in the caller's `arena`.  `chunk_cells` is\n    # the ordinary growth step in cells, not a limit.  `s` and `cells` must be zeroed.\n    fn: lmx_scratch_open (@: LmxScratch s; @: LmxArena arena; @: LmxPool cells; size_t: chunk_cells) int\n    # `bytes` of storage aligned to a pointer-sized cell, through `out`; valid until a\n    # rewind to a mark taken before it.  On any failure `out` gets 0 and nothing changed.\n    fn: lmx_scratch_take (@: LmxScratch s; size_t: bytes; @@: void out) int\n    fn: lmx_scratch_mark (@: LmxScratch s; @: LmxScratchMark m) int\n    fn: lmx_scratch_rewind (@: LmxScratch s; @: LmxScratchMark m) int\n    # Give the cells back to the arena.  Refused while a mark is outstanding.\n    fn: lmx_scratch_close (@: LmxScratch s) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_scratch

# The text of l2src/lmx_source_names.h.lm1, the source names of the graph: the row record LmxSourceName and the
# prototypes of the seven exports of its module (src/l2src/lmx_source_names.lm2). 0, or 1 when a write fails.
fn: decl_source_names (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx_arena.h.lm1\"\n\n# Independent spelling of graph occurrences lives here. The walker now reads\n# the fn occurrence's receiver head from this table. Lowered body operations\n# still dispatch typed OP records until K03 removes that carrier; it is not a\n# second language-level head. Field bindings remain physical address maps.\n# A key is the actual occurrence (Frame/leaf) or an owning child-cell address,\n# not necessarily its referent. Neither Lmx nor an atom receives a name field.\nstruct: LmxSourceName\n    @: void key\n    VoidArray: text\nend: LmxSourceName\n\nprototype:\n    # A stable arena service cell. prepare leaves key zero until publication.\n    fn: lmx_source_name_prepare (@: LmxArena arena; @: void key; const: @(char text); size_t: length; @@: LmxSourceName out) int\n    fn: lmx_source_name_publish (@: LmxSourceName row; @: void key) void\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_source_name_cancel (@: LmxSourceName row) void\n    fn: lmx_source_name_set (@: LmxArena arena; @: void key; const: @(char text); size_t: length) int\n    # Inspection/copy runs with exclusive ownership of the searched source\n    # inventories, including a foreign home. Sealing a key alone does not\n    # make its owner's still-mutable metadata inventory concurrent-readable.\n    fn: lmx_source_name_get (@: LmxArena arena; @: void key) @: VoidArray\n    # Retire before an address can be reused. The range has not been freed yet.\n    fn: lmx_source_names_drop (@: LmxArena arena; @: void lo; @: void hi) void\n    # Run only after a complete ordinary graph mark. Keys are weak: this pass\n    # never marks them; it keeps spelling only for already-live occurrences.\n    fn: lmx_source_names_mark (@: LmxArena arena; unsigned: gen) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_source_names

# The text of l2src/lmx_gc.h.lm1, the collection's: its answers and depth, and the prototypes of the physical mark and
# sweep (src/l2src/lmx_gc_graph.lm2) and of the Thread collector (lmx_gc.lm1). 0, or 1 when a write fails.
fn: decl_gc (@: f c.FILE) int
    if: c.fputs("include: \"<stddef.h>\"\npredef: \"l2src/lmx_arena.h.lm1\"\npredef: \"l2src/lmx_pool.h.lm1\"\npredef: \"l2src/lmx_thread.h.lm1\"\n\n# lmx_gc.h.lm1 - the end-turn collection (Lingvamyxa_spec.txt 19.29.4 and 19.29.4.1, model 24;\n# the gaps note's item 4).\n#\n# The model's contract, and what this module owes it:\n#\n#   * \"Arena membership is not liveness\": a cell stays because something REACHABLE from a root\n#     points at it, never because the arena handed it out once.\n#   * The pass is LOCAL (one Message's arena), NON-MOVING (live cells and their index entries\n#     keep every address) and runs exactly once, at the end-turn boundary, after the outbox has\n#     been published or discarded.\n#   * Roots are the Message's own cells: its record, its object, its mailbox (and the queue\n#     nodes of that mailbox's own array), its record of the schedule, and the live graph.  An\n", f) < 0
        return: 1
    if: c.fputs("#     incoming turn whose message was taken from a queue is still reachable through that queue,\n#     so a letter in flight is never collected out from under its receiver.\n#   * \"Adoption alone does not make every transferred allocation a permanent root\": a graph\n#     that arrived by attach and is retained by nothing is garbage at THIS boundary -- and that\n#     is the acceptance case of 19.29.4, which the selftest pins.\n#   * An error means NO SWEEP: \"Недостаток памяти у рабочего стека mark не даёт права\n#     освободить ещё не посещённый потенциально живой объект.  При ошибке нужен безопасный\n#     отказ/сохранение живого, а не частичный sweep как успех\" (model 24).  A deeper chain\n#     than the tracer's stack allows is exactly such an error, and it answers LMX_GC_PARTIAL.\n#   * A live value's recorded implements correspondence keeps its required Structure\n", f) < 0
        return: 1
    if: c.fputs("#     reachable. It is a dependency of the declared contract, not a new graph field;\n#     marking reaches its ordinary graph edges to a fixed point before sweep. An\n#     admitting frame remains ephemeral: if it dies, its frame-backed record retires.\n#\n# How liveness is remembered: a chunk of one of the arena's arrays is the unit, because a chunk\n# is one arena block and a block is what can be freed without moving anything.  The pass bumps\n# the arena's generation and stamps every chunk it walks; \"was this chunk reached by the\n# current pass\" is one comparison, and nothing has to be cleared between passes.\n#\n# What the tracer follows, per the domain the cell's address falls into (the kernel's own way\n# of asking \"what is this\"):\n#   STRUCT   the header's `node` and its child-slot array -- the slots are then cells of a\n", f) < 0
        return: 1
    if: c.fputs("#            CHILDREN array, and each slot holds a child VALUE, which is followed in turn;\n#   ARRAY    the descriptor's backing, whose own chunk kind decides what happens next;\n#   CHILDREN / REF   each cell is a physical void * slot;\n#   pointer-backed PRIMITIVE   each cell is read by its pool's exact C99 pointer callback;\n#   scalar PRIMITIVE (char, int, size_t, ulong, unsigned)   a VALUE, never a reference: the\n#            model forbids reading a structural parent out of it\n#            (\"Нельзя читать `target->parent` у INT\"),\n#            and nothing inside such a chunk is followed;\n#   METHOD   a terminal: the descriptor lives as long as the process, not as long as a graph;\n#   the kernel's own record domains (Message record, thread, schedule, manager, post link,\n#   reservation)   their fields ARE references, so every pointer-sized word is treated as a\n", f) < 0
        return: 1
    if: c.fputs("#   candidate address.  An address that does not resolve in this arena is not this arena's to\n#   keep or to free, so it is a terminal -- which is what makes a foreign pointer harmless and\n#   a function pointer in a table inert.\n#\n# The one error this rule can make is OVER-retention (a word that happens to look like one of\n# this arena's addresses), and over-retention is the safe direction: the pass may keep a block\n# it could have freed, never free a block something still points at.\ndefine: LMX_GC_OK 0\ndefine: LMX_GC_INVALID 1\n# The walk could not be completed, so NOTHING is swept this pass.\ndefine: LMX_GC_PARTIAL 2\n\n# How deep the tracer follows references.  The bound is on the WORKING STACK, not a claim about\n# the graph: a deeper chain is refused (LMX_GC_PARTIAL) rather than walked on a stack that\n# cannot hold it -- the model's rule that an incomplete mark must not sweep.\n", f) < 0
        return: 1
    if: c.fputs("define: LMX_GC_DEPTH 64\n\nprototype:\n    # Mark from this object's roots.  Returns the generation it stamped, or 0 when the walk\n    # could not be completed -- and then a sweep must NOT run.\n    fn: lmx_gc_mark (@: LmxArena arena; @: LmxThread t) unsigned\n    # Free every block the marked pass did not reach, retiring its interval first.  Nothing\n    # moves, and a block already gone is not seen again (the block list is the authority).\n    fn: lmx_gc_sweep (@: LmxArena arena; unsigned: gen) int\n    # The whole boundary pass: mark, then sweep; a mark that could not be completed sweeps\n    # nothing and says so.\n    fn: lmx_gc_collect (@: LmxArena arena; @: LmxThread t) int\n    # The tracer's own mutual recursion, declared here because L1 needs a name before its use\n    # and these three call each other: a value's chunk, the cells of a chunk, an array's chunks.\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_gc_mark_value (@: LmxArena arena; @: void p; unsigned: gen; int: depth) int\n    fn: lmx_gc_cells (@: LmxArena arena; @: LmxPool pool; @: LmxChunk chunk; unsigned: gen; int: depth) int\n    fn: lmx_gc_mark_pool (@: LmxArena arena; @: LmxPool pool; unsigned: gen) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_gc

# decl_implements: C ABI declarations, written as ordinary L1 output text by L3.
fn: decl_implements (@: f c.FILE) int
    if: c.fputs("include: \"<stddef.h>\"\npredef: \"l2src/lmx.h.lm1\"\npredef: \"l2src/lmx_arena.h.lm1\"\n\n# Operation-local DFS bookkeeping, never a graph value or a completed admission.\nstruct: LmxImplementsFrame\n    @: Lmx varA\n    @: Lmx varB\n    @: Lmx consumer\n    @: Lmx source\n    LmxImplEntry: source_bridge\n    @: LmxImplEntry viewA\n    @: LmxImplEntry viewB\n    # Address views are resolved once, only if this frame consumes a field.\n    int: view_ready\n    size_t: index\n    # Where this frame's level starts in the instruction's coverage (LmxImplUses),\n    # or 0: every field of the consumer at this frame is walked.\n    size_t: level\n    @: LmxImplementsFrame caller\n    @: LmxImplementsFrame seen_next\nend: LmxImplementsFrame\n\n# The coverage of ONE receiving instruction: what the Consumer of the place it\n# binds reads through that place. Non-owning and read only while the instruction\n", f) < 0
        return: 1
    if: c.fputs("# runs: the translator's static cells (map), or the size cells of the walked\n# instruction itself (frame, at). No Structure is made for it and it is never\n# kept with a correspondence: another instruction brings its own.\n#\n# The cells are levels packed flat. Cell 0 is the count of cells; the root level\n# starts at cell 1. A level is [count, then count pairs (edge, below)]:\n#   edge  -- a field of the model at that level, in that model's own index space:\n#            j < width is field j through its ORDINAL half (an explicit `[N]name`\n#            use), width + j the LAST half of field j (a bare `name` use) -- the\n#            numbering of lmx_implements_slot (K01);\n#   below -- 0: the field is consumed and nothing below it (a number, or a\n#            reference that is held and not entered); SIZE_MAX: everything below\n", f) < 0
        return: 1
    if: c.fputs("#            it is consumed, the full interface from there; SIZE_MAX - 1: the\n#            Consumer calls the field, and the value there must take the call its\n#            caller forms (lmx_implements_call_takes); otherwise the cell where the\n#            nested level starts, in the nested model's index space.\n# A root level of count 0 is a Consumer that reads no field: the identity of the\n# reference is all it consumes.\nstruct: LmxImplUses\n    @: size_t map\n    @: Lmx frame\n    size_t: at\nend: LmxImplUses\n\n# A prepared correspondence between two genuine physical schema identities.\n# This is NOT a completed value admission: value/req/proof/ownership fields\n# of correspondence convey no permission. Only its map/frame/at/n/holes\n# are borrowed. The operation binds them to actual current graph addresses.\n# No model constructor is substituted for an unknown candidate layout.\n", f) < 0
        return: 1
    if: c.fputs("struct: LmxImplTemplate\n    @: void source_layout\n    @: void required_layout\n    LmxImplEntry: correspondence\nend: LmxImplTemplate\n\n# The object domains this level knows, and the compatibility primitive\n# `implements(varA, varB, Consumer)`.\n#\n# Spec 2.1 defines `implements(varA varB Consumer)` as an L2 construct: \"iff every\n# path in uses(Consumer varB) is present on varA, and every primitive leaf of those\n# paths is admitted as in 2.2.3, and at every callable path p actually invoked by\n# Consumer: sig(varA.p) == sig(varB.p) == ExpectedSig(Consumer, p)\".  That is a\n# source-level check over a Consumer's known used paths -- L2's business.\n#\n# L1 is the level BETWEEN L2 and C.  What lives here is not that predicate: it is\n# the primitive L2's implements will be emitted onto.  Today it answers the first\n# question 2.1 needs answered -- \"are these two the same kind of thing at all\" --\n", f) < 0
        return: 1
    if: c.fputs("# and it answers it the way everything else in this kernel answers \"what is this\":\n# by the registered address range a value falls into.  Nothing is stored on either\n# operand to say what it is; a child carries no type tag (lmx.h, spec 2, 6.5).\n#\n# The Consumer argument is part of the signature and is reserved: the path walk,\n# the leaf admission and the signature comparison of 2.1 are later stages and will\n# be emitted by L2.  This stage does not read it, and does not pretend to.\n#\n# The arena of the Message is the context of every question here, so it is named\n# explicitly on every call: the index that answers \"what is this address\" belongs to\n# the arena (lmx_arena.h.lm1), and there is no second, module-global table to open.\n# `lmx_domain_table_init` is gone with it: a caller that needs the questions answered\n# opens its own arena with lmx_arena_open.\n\ndefine: LMX_IMPLEMENTS_NO 0\n", f) < 0
        return: 1
    if: c.fputs("define: LMX_IMPLEMENTS_YES 1\n# The third answer of the RUNTIME predicate: the walk met something it cannot inspect, so it\n# certifies neither side (spec 2.1: \"Unavailable information is not invented and is not certified\n# by success\").  A KNOWN mismatch is still NO, and a missing used path is still NO.\ndefine: LMX_IMPLEMENTS_UNKNOWN 2\ndefine: LMX_DOMAIN_REGISTER_OK 0\ndefine: LMX_DOMAIN_REGISTER_FAIL 1\n\n# The object domains, appended after the lmx.h registry (LmxType 0..20 and the two\n# bases).  They are declared here rather than in lmx.h because that header and the\n# Message record are closed: nothing is added to either.  The numbers are one\n# registry -- if the domains are ever moved into lmx.h, these are the values they\n# must keep.\ndefine: LMX_DOMAIN_MSG_RECORD 21\ndefine: LMX_DOMAIN_THREAD 22\ndefine: LMX_DOMAIN_POST_LINK 23\ndefine: LMX_DOMAIN_SCHEDULE 24\ndefine: LMX_DOMAIN_MANAGER 25\n", f) < 0
        return: 1
    if: c.fputs("# A turn's reserved child (lmx_child.h.lm1): the reservation is a mechanism record of the\n# parent's arena, so the parent can drop exactly what it reserved without touching any of the\n# turn's graph writes.  Appended, like the domains before it.\ndefine: LMX_DOMAIN_RESERVATION 26\n# A mailbox record that lives as a cell of the arena (a child's own mailbox does: its queue nodes\n# are storage of the child's arena).  Appended, like the domains before it.\ndefine: LMX_DOMAIN_POST 27\n# Retired ABI value. Live-child membership is the List held by Thread.children; no record is\n# allocated in this domain. Keep the number unavailable so later domain values do not shift.\ndefine: LMX_DOMAIN_RESERVED_28 28\n# Reserved domain number of the former arena-backed fixed inbox ring.  The current mailbox uses\n# a private movable dynamic array whose backing address never enters the graph or the range\n", f) < 0
        return: 1
    if: c.fputs("# classifier.  The number remains reserved so later domain values do not change ABI.\ndefine: LMX_DOMAIN_POST_RING 29\n# k.4 (2026-09-25): LmxCallable is gone (Lmx.native replaces the child[0] descriptor);\n# reserved so later domain values do not change ABI.\ndefine: LMX_DOMAIN_RESERVED_30 30\ndefine: LMX_DOMAIN_OP 31\n# A cell of a temporary-frame store (lmx_scratch.h.lm1): pointer-sized storage of an\n# execution context, in an arena of its own that is never attached to a Message.  It is a\n# domain of its own for the reason POST_RING is: the arena seats cells of one (kind, type)\n# in one array by stride, and no other array has this one's meaning.\ndefine: LMX_DOMAIN_SCRATCH 32\n# A role record (lmx_plan.h.lm1): a cell that exists only to BE an address.  A node names\n# its role by pointing at the shared record of that role; the record's content means\n", f) < 0
        return: 1
    if: c.fputs("# nothing and is never read.  Pointer-sized, because the arena refuses a zero stride.\ndefine: LMX_DOMAIN_ROLE 33\n# A primitive record (lmx_primitive.h.lm1): the physical {fn, physical signature, owner} of one\n# admitted primitive -- the insert an interpreted activation needs where only a native entry could\n# reach a service (the mailbox's count/take today).  Its content IS read (the fn is called), which\n# is exactly why it is NOT seated in LMX_DOMAIN_ROLE above: that domain's documented meaning is\n# \"content means nothing and is never read\", and seating a read record there would be the\n# overload every domain in this file is split to avoid.  Appended, like every domain before it.\ndefine: LMX_DOMAIN_PRIMITIVE 34\n\n# The same domains as KINDS -- what lmx_range_classify answers -- appended after\n# LmxKind 0..6.  Classification has ONE number space: no two answers share a value.\n", f) < 0
        return: 1
    if: c.fputs("# LmxKind's later List=21, SOURCE_NAME=22 and SOURCE_SYMBOL=23 sit after these\n# (lmx.h.lm1); the next free kind value is 24.\ndefine: LMX_DOMAIN_KIND_MSG_RECORD 7\n# Numeric kind 8 remains reserved for ABI stability. Executable Threads use the common\n# LMX_DOMAIN_KIND_MSG_RECORD kind and are distinguished by exact LMX_DOMAIN_THREAD type.\ndefine: LMX_DOMAIN_KIND_RESERVED_8 8\ndefine: LMX_DOMAIN_KIND_POST_LINK 9\ndefine: LMX_DOMAIN_KIND_SCHEDULE 10\ndefine: LMX_DOMAIN_KIND_MANAGER 11\ndefine: LMX_DOMAIN_KIND_RESERVATION 12\ndefine: LMX_DOMAIN_KIND_POST 13\ndefine: LMX_DOMAIN_KIND_RESERVED_14 14\ndefine: LMX_DOMAIN_KIND_POST_RING 15\n# k.4 (2026-09-25): the LmxCallable descriptor type is gone (Lmx.native replaces the\n# child[0] descriptor entirely).  The domain NUMBER stays defined, but nothing reads it\n# (measured 2026-09-27, steps/copier-q42.md): the copier's shared-method test it once served\n", f) < 0
        return: 1
    if: c.fputs("# is gone (Q44 -- a method occurrence is copied like any Structure).  Retiring the number is\n# a separate change.\ndefine: LMX_DOMAIN_KIND_CALLABLE 16\ndefine: LMX_DOMAIN_KIND_OP 17\ndefine: LMX_DOMAIN_KIND_SCRATCH 18\ndefine: LMX_DOMAIN_KIND_ROLE 19\ndefine: LMX_DOMAIN_KIND_PRIMITIVE 20\n\nprototype:\n    # Register one whole domain of the arena's index: count cells of `stride`.\n    fn: lmx_domain_register (@: LmxArena arena; @: LmxPool pool; @: LmxChunk chunk; @: void lo; size_t: count; size_t: stride; int: kind; int: type) int\n    fn: lmx_domain_kind (@: LmxArena arena; @: void p) int\n    fn: lmx_domain_type (@: LmxArena arena; @: void p) int\n    fn: lmx_domain_known (@: LmxArena arena; @: void p) int\n    fn: lmx_implements (@: LmxArena arena; @: void varA; @: void varB; @: void consumer) int\n    # The runtime predicate of 2.1: walk the used tree the Consumer IS (its shape gives the used\n", f) < 0
        return: 1
    if: c.fputs("    # paths -- \"the used tree is the contract\", and names are absent from ordinary execution, so a\n    # path is an index path), and answer over what is AVAILABLE:\n    #   every used path present on varA and varB, every leaf of the same domain and type.  A\n    #   callable's signature (args/return) is ordinary lexical Structure fields (k.4), so the\n    #   same recursion covers it with no separate comparison.\n    # An unset child of the Consumer is not a used path (\"An empty `uses` is true: there is\n    # nothing to use\"), a missing path or a known mismatch is NO, and anything the walk cannot\n    # inspect is UNKNOWN -- never YES.\n    fn: lmx_runtime_implements (@: LmxArena arena; @: Lmx varA; @: Lmx varB; @: Lmx consumer) int\n    # The depth-first used-graph walk keeps operation-local visited triples and frames;\n", f) < 0
        return: 1
    if: c.fputs("    # neither graph depth nor a reference cycle is an admission refusal. A callable's\n    # signature is ordinary lexical Structure fields, checked by this same traversal.\n    fn: lmx_implements_walk (@: LmxArena arena; @: Lmx varA; @: Lmx varB; @: Lmx consumer) int\n    # The common operation walk: pending is not a completed admission. skip_unused is set only\n    # for through(), whose correspondence already proves SIZE_MAX fields unused; the runtime\n    # used-tree predicate instead requires every non-null Consumer child, including mapped ones.\n    fn: lmx_implements_walk_view (@: LmxArena arena; @: Lmx varA; @: Lmx varB; @: Lmx consumer; @: LmxImplEntry pending; int: skip_unused) int\n    # Full declaration reception projects out OP-headed source applications, not\n    # missing fields. The explicit physical Consumer predicate above is unchanged.\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_implements_receiver_view (@: LmxArena arena; @: Lmx varA; @: Lmx varB; @: Lmx model; @: LmxImplEntry pending) int\n    # Reception by the current Consumer's coverage: the model stays the index\n    # space, and only the fields this instruction's coverage names are required --\n    # a field it does not name is neither required nor compared, present or not.\n    # A null coverage is unknown coverage, which is the full reception above and\n    # never an empty one. This predicate itself records nothing. A successful\n    # admit_receiving may retain a full-reception proof; a partial Consumer\n    # retains only its address correspondence and must be checked again for a\n    # different Consumer.\n    # UNKNOWN on a coverage that cannot be read.\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_implements_receiving_use (@: LmxArena arena; @: Lmx varA; @: Lmx varB; @: Lmx model; @: LmxImplEntry pending; @: LmxImplUses uses) int\n    # Validate this receiving instruction's Consumer and retain its physical\n    # correspondence. A partial Consumer never becomes a full identity proof.\n    fn: lmx_implements_admit_receiving (@: LmxArena arena; @: Lmx value; @: Lmx req; @: LmxImplEntry view; @: LmxImplUses uses) int\n    # Cell k of a coverage. 0 and *out, or 1: no such cell, or a cell that is no size.\n    fn: lmx_implements_use_cell (@: LmxArena arena; @: LmxImplUses uses; size_t: k; @: size_t out) int\n    fn: lmx_implements_view (@: LmxArena arena; @: Lmx value; @: Lmx req; @: LmxImplEntry pending) @: LmxImplEntry\n    # Read-only proof with all current resolved pending pairs. No map or\n    # reception permission is published by this operation.\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_implements_receiving_views (@: LmxArena arena; @: Lmx varA; @: Lmx varB; @: Lmx model; @: LmxImplEntry pending; size_t: count; @: LmxImplUses uses) int\n    # Prove this one receiving instruction with all resolved pairs, then\n    # publish the set together. NO/UNKNOWN publishes none; child entries\n    # keep only a used-path proof, not independent whole-model permission.\n    fn: lmx_implements_admit_receiving_views (@: LmxArena arena; @: Lmx value; @: Lmx req; @: LmxImplEntry pending; size_t: count; @: LmxImplUses uses) int\n    # One common analytical walk resolves nested pairs from prepared layout\n    # correspondences, then publishes every discovered pair atomically.\n    # Root and children use the SAME resolver; the caller supplies no guessed\n    # root projection. Template maps stay borrowed. If no graph field is\n", f) < 0
        return: 1
    if: c.fputs("    # consumed, no positional correspondence or full-layout proof is invented.\n    fn: lmx_implements_admit_receiving_templates (@: LmxArena arena; @: Lmx value; @: Lmx req; const: @(LmxImplTemplate templates); size_t: template_count; @: LmxImplUses uses) int\n    # Both coordinate preparation (full_receiver=0, no used coverage) and\n    # receiving proof (1) use the same resolver and atomic publisher.\n    fn: lmx_implements_admit_templates (@: LmxArena arena; @: Lmx value; @: Lmx req; const: @(LmxImplTemplate templates); size_t: template_count; @: LmxImplUses uses; int: full_receiver) int\n    # Representation adapter only: current ordinary frame [row count, then\n    # source-layout/required-layout/width/ordinal-map/LAST-map per row].\n    # Maps retained by a successful operation borrow this current frame.\n    # No source spelling, model constructor or old graph address is read.\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_implements_admit_template_frame (@: LmxArena arena; @: Lmx value; @: Lmx req; @: Lmx frame; @: LmxImplUses uses; int: full_receiver) int\n    # Receiving data [catalog frame,optional coverage frame,mode,required\n    # reference contracts,optional giving context]. The\n    # representation is shared by generated native and walked operations;\n    # mode 0 prepares coordinates, 1 receives fully, 2 uses current coverage.\n    # Selection/proof/publication remain in the one templates resolver.\n    fn: lmx_implements_admit_receiving_frame (@: LmxArena arena; @: Lmx value; @: Lmx req; @: Lmx frame) int\n    # The SAME operation with a value producer's operation-local CURRENT\n    # [giving Model,giving reference contracts] instead of frame child4.\n    # Zero explicitly means no giving context,not recovery from shared data.\n", f) < 0
        return: 1
    if: c.fputs("    # No field of frame is modified;re-entrant callers may share its catalog.\n    fn: lmx_implements_admit_receiving_context (@: LmxArena arena; @: Lmx value; @: Lmx req; @: Lmx frame; @: Lmx source_context) int\n    # A computed reference already owns these two CURRENT components.\n    # Consume them directly through the SAME decoder/proof worker,without\n    # allocating a temporary context graph or editing the receiving frame.\n    # Both zero means explicit absence;one missing component is invalid.\n    fn: lmx_implements_admit_receiving_parts (@: LmxArena arena; @: Lmx value; @: Lmx req; @: Lmx frame; @: Lmx source; @: Lmx source_references) int\n    fn: lmx_implements_admit_templates_contracts (@: LmxArena arena; @: Lmx value; @: Lmx req; const: @(LmxImplTemplate templates); size_t: template_count; @: LmxImplUses uses; int: full_receiver; @: Lmx references) int\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_implements_admit_template_frame_contracts (@: LmxArena arena; @: Lmx value; @: Lmx req; @: Lmx frame; @: LmxImplUses uses; int: full_receiver; @: Lmx references) int\n    fn: lmx_implements_admit_templates_typed (@: LmxArena arena; @: Lmx value; @: Lmx req; const: @(LmxImplTemplate templates); size_t: template_count; @: LmxImplUses uses; int: full_receiver; @: Lmx references; @: Lmx source; @: Lmx source_references) int\n    # D-105 (the author's Q39, 2026-09-27): the `implements` table of address correspondences\n    # (LmxArena.impl, LmxImplEntry).  A value admitted to a named Structure `req` it is not an\n    # instance of carries a view of its correspondence -- slot j is the value's slot of req's field j,\n    # matched by name when the program was translated: the admitting walk frame's own size cells, or\n", f) < 0
        return: 1
    if: c.fputs("    # the translator's static map. An absent explicit map is positional identity,\n    # not evidence that layout=req; holes may describe a capture's physical slots.\n    # No Structure is made for a correspondence.\n    # Register validates the declared interface before recording its physical\n    # correspondence. A later register rechecks a used-only copied view; an\n    # unchanged full receiving proof may answer a later Consumer directly.\n    # Without that proof, the caller establishes its current Consumer through\n    # admit_receiving. A correspondence alone is never universal approval.\n    # YES: recorded, now or before with the same correspondence; NO: a\n    # field does not match through it, or the value already answers req through another one;\n    # UNKNOWN: no room, or nothing to inspect.\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_implements_register (@: LmxArena arena; @: Lmx value; @: Lmx req; @: LmxImplEntry view) int\n    fn: lmx_implements_register_map (@: LmxArena arena; @: Lmx value; @: Lmx req; @: size_t map; size_t: n; @: void layout) int\n    # A computed map is copied into the correspondence record's own storage;\n    # it survives the caller's temporary buffer, graph copy and arena GC.\n    fn: lmx_implements_register_map_owned (@: LmxArena arena; @: Lmx value; @: Lmx req; @: size_t map; size_t: n; @: void layout) int\n    # A selected executable body's source-to-value correspondence, proved by\n    # ordinary implements before publication. It is carried on the value's\n    # existing self entry, not in another Structure or in the ordinary self map.\n    # Save an execution projection already proved by construction/copy. This\n", f) < 0
        return: 1
    if: c.fputs("    # does not establish reception of a requirement or a producer layout.\n    fn: lmx_implements_exec_save (@: LmxArena arena; @: Lmx value; @: size_t map; size_t: n) int\n    fn: lmx_implements_exec_register (@: LmxArena arena; @: Lmx value; @: Lmx code; @: size_t map; size_t: n) int\n    # Compose an already proved code-to-source projection with the admitted\n    # source-to-result address map. No new Consumer test or runtime names.\n    fn: lmx_implements_exec_compose (@: LmxArena arena; @: Lmx result; @: Lmx source) int\n    # Same composition when the selected source was copied into another arena;\n    # copied_source is the graph copier's corresponding root, with the same\n    # physical child indices but no inherited admission.\n    fn: lmx_implements_exec_compose_copy (@: LmxArena source_arena; @: Lmx source; @: LmxArena result_arena; @: Lmx result; @: Lmx copied_source) int\n", f) < 0
        return: 1
    if: c.fputs("    # Resolve one source-code edge for this value; absent execution projection\n    # means the ordinary self-view (or identity when none is recorded). Refuse\n    # a value outside the supplied arena, a hole, or an invalid edge.\n    fn: lmx_implements_exec_slot (@: LmxArena arena; @: Lmx value; size_t: edge; @: size_t out) int\n    fn: lmx_implements_exec_index (@: LmxArena arena; @: Lmx value; size_t: edge) size_t\n    # A distinct admitted data value follows the code occurrence's already\n    # proved execution projection before its own (data, code) admission.\n    fn: lmx_implements_code_slot (@: LmxArena arena; @: Lmx value; @: Lmx code; size_t: edge; @: size_t out) int\n    fn: lmx_implements_code_index (@: LmxArena arena; @: Lmx value; @: Lmx code; size_t: edge) size_t\n    # Opaque non-owning module schema token from this value's completed\n", f) < 0
        return: 1
    if: c.fputs("    # admissions, never inferred from req/map. No map or Consumer proof transfers.\n    fn: lmx_implements_layout (@: LmxArena arena; @: Lmx value) @: void\n    # Recover the declared Structure already registered as its own layout\n    # anchor. This is a lookup in the arena's proof records, not a name table\n    # or an additional graph; a replaced receiving field need not still hold\n    # its original requirement value.\n    fn: lmx_implements_model_for_layout (@: LmxArena arena; @: void layout) @: Lmx\n    # N4 `call: code data`: the data slots of one procedure's names in the selected data, from the translator's\n    # static table [m, k, then k rows (token index, m data slots)], the row chosen by the data's own layout token.\n    # YES (out, when not 0, gets the m slots), NO (the row marks a name SIZE_MAX: missing, ambiguous or unfit),\n", f) < 0
        return: 1
    if: c.fputs("    # UNKNOWN (no proof: no token, no row, or a slot past the data).  m = 0 is YES.  No name is read and nothing is\n    # recorded.\n    fn: lmx_implements_places (@: LmxArena arena; @: Lmx data; @: char tokens; @: size_t table; @: size_t out) int\n    fn: lmx_implements_find (@: LmxArena arena; @: Lmx value; @: Lmx req) @: LmxImplEntry\n    # 1 when a completed reception proved value identical, by position, with the declaration whose own\n    # layout token is `layout` (a record with neither frame nor map and no holes), else 0.  The\n    # declaration's own record certifies no other value; the value's layout stays unknown.  Read only.\n    fn: lmx_implements_identity (@: LmxArena arena; @: Lmx value; @: void layout) int\n    # Compose a completed value-to-source admission with a source-to-target\n    # correspondence. `applied` distinguishes absent source evidence (caller\n", f) < 0
        return: 1
    if: c.fputs("    # may try another route) from a present but refused/ambiguous admission.\n    # Both ordinal and last-occurrence edges are composed; the resulting map\n    # is owned by the arena record, never by the caller's temporary frame.\n    # full_receiver < 0 retains coordinates only (proof 1); 0 checks the\n    # full structural receiver; > 0 checks the receiving Consumer.\n    fn: lmx_implements_compose_receiving (@: LmxArena arena; @: Lmx value; @: void source_layout; @: Lmx req; @: LmxImplEntry pair; int: full_receiver; @: LmxImplUses uses; @: int applied) int\n    # Read-only coordinate preparation for one operation. On YES out owns its\n    # computed map (owned_map=1 when nonempty); no admission/proof is retained.\n    # Caller must transfer it on successful publication or release the map.\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_implements_compose_view (@: LmxArena arena; @: Lmx value; @: void source_layout; @: Lmx req; @: LmxImplEntry pair; @: LmxImplEntry out; @: int applied) int\n    # The value's slot for EDGE j through its record (K01): j < width is req's field j through\n    # the ordinal half, width <= j < 2*width the LAST half of field j - width (a bare name).\n    # 0 and *out, or 1 when no proved address map reaches req. A copied\n    # description may rebase an existing map of its own source layout;\n    # an unadmitted value never falls back to a guessed slot j.\n    fn: lmx_implements_slot (@: LmxArena arena; @: Lmx value; @: Lmx req; size_t: j; @: size_t out) int\n    fn: lmx_implements_resolve_map (@: LmxArena arena; @: Lmx value; @: Lmx req) @: LmxImplEntry\n    # One record appended as given into room the caller took (lmx_arena_impl_room): a copy's carried correspondence\n", f) < 0
        return: 1
    if: c.fputs("    # (lmx_copy_carry_records), proved by the record it carries.  0, or 1 when there is no room.  The caller restores\n    # the table's length where it reverts the copy.\n    fn: lmx_implements_append (@: LmxArena arena; @: LmxImplEntry v) int\n    # 1 when value is a partial copy (its record with itself carries holes): a place it holds no object at is absent.\n    fn: lmx_implements_holes (@: LmxArena arena; @: Lmx value) int\n    # A view's slot SIZE_MAX is \"not carried\": the value holds no such field -- a capture's copy of the\n    # fields its model reads (item 738), or a value admitted by name to a formal whose method never reads\n    # that field (D-105 native, admission by the consumer's uses).  The heavy check skips it; a read\n    # through it is refused.  Invariant: a view with such slots is made only where the translator\n", f) < 0
        return: 1
    if: c.fputs("    # proved no read reaches them -- a capture's fields (steps/capture-738.md) and a formal's uses,\n    # checked for every type that reaches it (steps/d105-native.md).\n    fn: lmx_implements_through (@: LmxArena arena; @: Lmx value; @: Lmx req; @: LmxImplEntry view) int\n    fn: lmx_implements_same_map (@: LmxArena arena; @: LmxImplEntry a; @: LmxImplEntry b; size_t: width) int\n    fn: lmx_implements_is_map (@: LmxArena arena; @: LmxImplEntry e; @: size_t map; size_t: width) int\n    # The two halves of a view's correspondence, one cell pair per required field: at is the\n    # ORDINAL half (the value's field named as req's field j, at its own occurrence), at_last the\n    # half a bare name reads.  An entry with neither frame nor map is positional identity: both\n    # halves are slot j.\n    fn: lmx_implements_at (@: LmxArena arena; @: LmxImplEntry e; size_t: j; @: size_t out) int\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_implements_at_last (@: LmxArena arena; @: LmxImplEntry e; size_t: j; @: size_t out) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_implements

# decl_implements_resolve: C ABI declarations, written as ordinary L1 output text by L3.
fn: decl_implements_resolve (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx_scratch.h.lm1\"\n\n# Stable records belonging to ONE admission operation, outside its graph.\n# Templates borrow coordinates. Only computed temporary maps own storage.\nstruct: LmxImplPreparedView\n    LmxImplEntry: view\n    int: release_map\n    @: LmxImplPreparedView next\nend: LmxImplPreparedView\n\nstruct: LmxImplResolve\n    @: LmxScratch scratch\n    const: @: LmxImplTemplate templates\n    size_t: template_count\n    # Ordinary current data: [count, (required layout, field, pointee model)*].\n    # This is a declared type obligation, never the pointer's current value.\n    @: Lmx references\n    # The CURRENT giving namespace, not the candidate's physical origin.\n    # Its declarations follow the same DFS edges as the receiving contract.\n    @: Lmx source\n    @: Lmx source_references\n    @: LmxImplContract contract\n", f) < 0
        return: 1
    if: c.fputs("    # An explicit coordinate-view API supplies positional identity as its\n    # declared default, with pending views as overrides. A source catalog\n    # supplies NO default; unknown source evidence never enables identity.\n    int: identity_default\n    @: LmxImplPreparedView views\n    size_t: count\nend: LmxImplResolve\n", f) < 0
        return: 1
    return: 0
end: decl_implements_resolve

# The common copier's records and C prototypes: ordinary L1 output of the L3 recipe.
fn: decl_graph_copy (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx.h.lm1\"\ninclude: \"<stddef.h>\"\npredef: \"l2src/lmx_arena.h.lm1\"\n\n# Used-graph copy: the ONE traversal shared by merge and Message creation\n# (SPEC 2.3, ABI 8.2, user decision 2026-09-12).\n#\n# TWO arenas, because the act has two sides.  `src_arena` is the arena the source\n# graph lives in: every classification question -- what is this address, which\n# array of the arena contains it, how wide is one cell of it -- is asked of it,\n# and nothing else answers.  `dst_arena` is the arena the copies are built in:\n# every constructor takes it and it owns everything the operation allocates.\n#\n# Starting from `source`, walk its structural chain to parent = 0 and copy the whole\n# reachable lexical tree: every Structure reached through node or through a\n# child slot, all of its slots, mutable primitive cells, char * cells, Array\n", f) < 0
        return: 1
    if: c.fputs("# records with their backing and reference-valued elements.\n# Pointer cells (@: T): the cell is copied and so is its pointee, through the same map\n# (the author, 2026-10-10: copying at a merge is full, retaining by reference only\n# independent: const: immutable branches; the -186 k3 sharing of the pointee is withdrawn).\n# `independent` bounds the walk because its root already has parent = 0.  A method occurrence\n# is a Structure like any other and is copied; for an unchanged full body its\n# implementation may stay shared: the `native` word is the C entry that receives\n# the graph node. A partial lexical copy clears it (Q44, the\n# author, 2026-09-28: the shared reference is to the native implementation, \"К структурам это\n# отношения не имеет\"). Unqualified char fields are copied through the same\n# allocate-and-map protocol as other primitives; copying needs no character table.\n#\n", f) < 0
        return: 1
    if: c.fputs("# Q38/Q42/Q44 (the author, 2026-09-27/28; steps/copier-q42.md): every Structure the walk\n# reaches is copied, wherever its parent lies -- a method occurrence included.  The former k.4\n# rule (\"a Structure whose parent lies outside the copied operand subtree is a shared\n# reference\") is gone: nothing outside what is copied is visible, and no Structure is shared by\n# address. Applications headed by OP/ROLE records are ordinary Structures: their operands\n# and parents follow the same copy map. Bare typed OP records are copied through that map;\n# only bare address-only ROLE records, exact retained profiles (eternal\n# branches, below) and independently owned runtime services may stay shared\n# by address. A PRIMITIVE record with its signature and graph owner is copied;\n# its callback word denotes native code rather than an arena object.\n#\n", f) < 0
        return: 1
    if: c.fputs("# A branch qualified `independent: immutable` (with optional `const`) is retained only when its\n# address resolves to one of the exact physical profiles supplied by the caller.  The\n# profile belongs to the typed range's array descriptor; kind/type remain its\n# exact representation.  Sealing, foreign ownership and parent=0 are not\n# substitutes.  Imported sealed foreign ranges are visible in the same source\n# arena index, while local ownership queries remain local.  Before a retained reference\n# may enter the destination, its sealed owner range must also have been explicitly imported\n# into the destination; copy refuses rather than publishing an unclassifiable pointer.  The\n# profile address itself is a live Structure identity; its own pool need not be\n# sealed or imported where only the qualified branch is used. The selected profile\n", f) < 0
        return: 1
    if: c.fputs("# set is a caller-provided span of ordinary physical graph references, bounded only\n# by this call. Duplicate references are idempotent; no global, numeric or textual profile\n# identity participates.\n#\n# A value the table does not classify at all (LMX_KIND_NONE) is neither\n# language-owned source state nor a terminal: the copy reports UNSUPPORTED\n# rather than silently retaining a raw pointer. That answer comes from the same\n# table that types every child, not from an inventory the caller supplies.\n#\n# One operation-local source-address -> destination-address map spans the\n# WHOLE operation, across all roots of lmx_graph_copy_many_owned (merge with\n# several operands): an object reachable from two roots is copied once and\n# both copies refer to it. A copy is registered before an object's edges are\n# followed, so shared targets and cycles keep their shape, and every copied\n", f) < 0
        return: 1
    if: c.fputs("# Structure's parent is rewritten to the copy of its immediate structural parent, to an\n# exact retained-profile parent's own address, or to zero.\n#\n# Atomicity is the arena's own act, exactly as it is for one Array: the\n# operation takes `mark: lmx_arena_mark(dst_arena)` before it builds anything\n# and reverts to it on any failure, so the whole destination joins dst_arena or\n# none of it does, and the source graph is never written. There is no private\n# block chain: storage a constructor allocated is already the arena's, and\n# reverting retires its index entries together with it.\n#\n# Value traversal uses no TLS/global registry or name-based resolution. The\n# external source-spelling table follows the completed address map separately.\ndefine: LMX_GRAPH_COPY_OK 0\ndefine: LMX_GRAPH_COPY_INVALID 1\ndefine: LMX_GRAPH_COPY_NOMEM 2\ndefine: LMX_GRAPH_COPY_UNSUPPORTED 3\n\n", f) < 0
        return: 1
    if: c.fputs("# Read-only §10 construction preflight. `prior_profiles` are physical profile\n# roots which completed qualification before this root, not merely allocated\n# or sealed unit storage. `method_leaves` are exact fn/fm/sub occurrences from\n# the translator's source rows. `opaque_types` are numeric pointee type ids\n# which the source type table proves to be foreign C resources; no names or\n# permanent graph metadata enter this call.\ndefine: LMX_QUALIFY_OK 0\ndefine: LMX_QUALIFY_INVALID 1\ndefine: LMX_QUALIFY_NOMEM 2\n\n# Operation-local bookkeeping: open-addressing pointer map and a work list.\n# Their buffers may move on growth; the addresses stored IN them never move.\n# Open-addressing pointer map: two void* DynamicArrays (table size = capacity;\n# occupancy tracked in n). Keys/vals always allocated to capacity slots.\n\n\n\nstruct: LmxCopyMap\n    VoidDynamicArray: keys\n    VoidDynamicArray: vals\n", f) < 0
        return: 1
    if: c.fputs("    size_t: n\n    # Scratch report for a remapped copy: first reached sealed source profile\n    # absent from this map. Not graph metadata, and cleared before each run.\n    @: Lmx unmapped\nend: LmxCopyMap\n\nstruct: LmxCopyStack\n    VoidDynamicArray: items\nend: LmxCopyStack\n\n# Machine scratch for a constructor's selected-profile coverage proof. These\n# intervals are never stored in the language graph or name/address registry.\nstruct: LmxQualifySpan\n    @: LmxPool pool\n    @: LmxChunk chunk\n    size_t: first\n    size_t: count\nend: LmxQualifySpan\n\nstruct: LmxQualifySpansDynamicArray\n    @: LmxQualifySpan data\n    size_t: size\n    size_t: capacity\nend: LmxQualifySpansDynamicArray\n\nprototype:\n    # Shared temporary address-map operations, including the receiving\n    # projection built by an enclosing constructor. No per-node metadata.\n    fn: lmx_copy_map_init (@: LmxCopyMap map) int\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_copy_map_dispose (@: LmxCopyMap map) void\n    fn: lmx_copy_map_get (@: LmxCopyMap map; @: void key) @: void\n    fn: lmx_copy_map_put (@: LmxCopyMap map; @: void key; @: void value) int\n    # A profiled forest copy for relocating several qualified roots as one\n    # operation.  One source-address map spans every root, so aliases and\n    # cross-root cycles are preserved.  On success `relocated` owns the\n    # operation-local map buffers; the caller disposes it after using the\n    # addresses to prepare incoming-edge rewrites.  On failure it is empty.\n    # Root qualification/sealing and publication of incoming edges remain the\n    # caller's separate transaction; this function alone publishes neither.\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_graph_copy_forest_profiled_staged (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: Lmx dst_profile; @@: Lmx outs; @: LmxCopyMap pending; @: LmxCopyMap relocated) int\n    # Address-keyed source-profile -> destination-profile map. Each copied\n    # qualified branch keeps its own profile, but all roots share one address\n    # relocation map; no source graph metadata or runtime name key is added.\n    fn: lmx_graph_copy_forest_remapped_staged (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: LmxCopyMap profile_map; @@: Lmx outs; @: LmxCopyMap pending; @: LmxCopyMap relocated) int\n    fn: lmx_graph_copy_map_dispose (@: LmxCopyMap relocated) void\n    # Complete an existing source->copy map with ONE receiving projection.\n", f) < 0
        return: 1
    if: c.fputs("    # Values already in final physical coordinates are not followed again.\n    # No graph traversal, new address identity, or allocation is performed.\n    fn: lmx_graph_copy_map_project (@: LmxCopyMap relocated; @: LmxCopyMap projection) int\n    fn: lmx_qualify_tree_preflight (@: LmxArena arena; @: Lmx root; @: Lmx roles; @@: Lmx prior_profiles; size_t: prior_count; @@: Lmx method_leaves; size_t: method_count; @: int opaque_types; size_t: opaque_count) int\n    # The constructor additionally proves that every issued cell of the\n    # selected profile belongs to the validated tree or its physical backing\n    # before it seals that profile. Ordinary unit tests of the tree predicate\n    # may use the narrower preflight above on deliberately reused pools.\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_qualify_tree_preflight_full (@: LmxArena arena; @: Lmx root; @: Lmx roles; @@: Lmx prior_profiles; size_t: prior_count; @@: Lmx method_leaves; size_t: method_count; @: int opaque_types; size_t: opaque_count) int\n    # An enclosing constructor (merge) owns this zero-initialized, transient\n    # spelling batch. It finishes the batch exactly once before arena rollback\n    # or result publication. No pending spelling is visible through lookup.\n    fn: lmx_copy_name_prepare (@: LmxArena src_arena; @: LmxArena dst_arena; @: void source; @: void destination; @: LmxCopyMap pending) int\n    fn: lmx_copy_names_finish (@: LmxCopyMap pending; int: publish) void\n    # `absorb`, when nonzero, is a Structure the operation's copied roots compose into\n    # (merge's fresh result, a merge-into's target): every child slot of a copied Structure\n", f) < 0
        return: 1
    if: c.fputs("    # that holds a copied root, and every copied Structure's parent that is one, names\n    # `absorb` instead, so no link reaches a discarded intermediate root; the roots' own\n    # parents stay, and a root retained by its exact profile is never absorbed.\n    fn: lmx_graph_copy_many_profiles_staged (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: Lmx absorb; @@: Lmx outs; @: LmxCopyMap pending) int\n    # The used copy (Q42; Codex K03-READ-FIELD-CLOSURE-20261007-28): the roots are copied\n    # whole; a Structure reached as a copied Structure's lexical parent or along a use is\n    # needed in part, at its source width, holding only the slots a link or a use fills --\n    # every other slot absent.  use_count uses, use k a slot path of use_len[k] >= 1 slots\n", f) < 0
        return: 1
    if: c.fputs("    # (consecutive in use_slot, use_slots in all) from its anchor: source Structure use_anchor[k]\n    # when use_sel[k] is 0, else the lexical parent of root use_sel[k] - 1, and a root with none\n    # gives the use nothing to copy (an explicit anchor is never absent); its last slot's value\n    # is copied as a value (a Structure whole).  One map: a Structure needed in part and\n    # whole is one copy, upgraded before publication.\n    # The lexical context of a callable merge's node, copied in part with the uses of the node's code (T7): the\n    # root itself a part, every place a use or a link does not fill absent.  Names published.  0 or a status.\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_graph_copy_part_used_owned (@: Lmx source; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @@: Lmx use_anchor; @: size_t use_sel; @: size_t use_slot; @: size_t use_len; size_t: use_count; size_t: use_slots; @@: Lmx out) int\n    # The same, with every cell of the copy allocated in the pools of dst_profile (a Structure of dst_arena; 0 =\n    # ordinary): the physical mark of a value qualified at run time (RR2a).  The caller preflights and seals.\n    fn: lmx_graph_copy_many_used_profiled_staged (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: Lmx absorb; @@: Lmx use_anchor; @: size_t use_sel; @: size_t use_slot; @: size_t use_len; size_t: use_count; size_t: use_slots; @@: Lmx outs; @: LmxCopyMap pending; @: Lmx dst_profile) int\n", f) < 0
        return: 1
    if: c.fputs("    # Construction-only receiving projection. Keep the one source-to-copy\n    # map until the final layout is known, then transport physical edges once.\n    # The caller owns arena rollback and disposes relocated before returning.\n    fn: lmx_graph_copy_many_used_relocated_staged (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: Lmx absorb; @@: Lmx use_anchor; @: size_t use_sel; @: size_t use_slot; @: size_t use_len; size_t: use_count; size_t: use_slots; @@: Lmx outs; @: LmxCopyMap pending; @: Lmx dst_profile; @: LmxCopyMap relocated) int\n    fn: lmx_graph_copy_project_mapped (@: LmxArena arena; @: LmxCopyMap footprint; @: LmxCopyMap projection; @: Lmx receiving) int\n    # One root's SUBTREE under dst_profile (RR2c-2b): no lexical chain is copied. A copy may keep its\n", f) < 0
        return: 1
    if: c.fputs("    # live outside parent only when physically owned by the destination; a foreign parent without a copied or qualified counterpart is refused. `leaves` is a legacy\n    # API list of method occurrences, not a copy/qualification exemption. The caller preflights and seals.\n    # The staged caller publishes names only after its own proof and seal.\n    fn: lmx_graph_copy_qualified_leaves_staged (@: Lmx source; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: Lmx dst_profile; @@: Lmx leaves; size_t: leaf_count; @@: Lmx out; @: LmxCopyMap pending) int\n    fn: lmx_graph_copy_qualified_leaves_owned (@: Lmx source; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: Lmx dst_profile; @@: Lmx leaves; size_t: leaf_count; @@: Lmx out) int\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_graph_copy_qualified_owned (@: Lmx source; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: Lmx dst_profile; @@: Lmx out) int\n    fn: lmx_graph_copy_many_used_staged (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @: Lmx absorb; @@: Lmx use_anchor; @: size_t use_sel; @: size_t use_slot; @: size_t use_len; size_t: use_count; size_t: use_slots; @@: Lmx outs; @: LmxCopyMap pending) int\n    # Several roots, one operation, one map. outs[i] receives the copy of\n    # sources[i]; on failure every outs[i] stays null and dst_arena is left as\n    # it was at the mark.\n    fn: lmx_graph_copy_many_owned (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx outs) int\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_graph_copy_many_profiles_owned (@@: Lmx sources; size_t: count; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @@: Lmx outs) int\n    # One root: the same operation with count 1.\n    fn: lmx_graph_copy_owned (@: Lmx source; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx out) int\n    fn: lmx_graph_copy_profiles_owned (@: Lmx source; @: LmxArena src_arena; @: LmxArena dst_arena; @@: Lmx retain_profiles; size_t: retain_count; @@: Lmx out) int\n    fn: lmx_graph_copy_profiled_owned (@: Lmx source; @: LmxArena src_arena; @: LmxArena dst_arena; @: Lmx retain_profile; @@: Lmx out) int\nend: prototype\n", f) < 0
