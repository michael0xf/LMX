# Historical write-only example: no established input k exists in peek.
# Its unknown k:1 defines a literal-bodied Structure; m's local k stays 5.
# The positive exit alone is not evidence of a hidden primitive assignment.
fn: peek () int
    k: 1
    return: 0
fn: m () int
    int: k 5
    int: t 0
    t: peek()
    if: k = 5 && t = 0
        return: 7
    return: 81
int: r 0
r: m()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
