fn: lm_compiler_schema_named_select (int: schema; const: (@: name c.LmP0Text); int: occurrence; @: out c.L2SchemaField; int: project) int
    @@: ns_count_cell int (cast: (@@: int) (@ c.l2_ns_count))
    @: nsf_n_cell int (cast: (@: int) (@ c.l2_nsf_n))
    @@: nsf_owner_cell int (cast: (@@: int) (@ c.l2_nsf_owner))
    @@@: nsf_fname_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_nsf_fname))
    @@@: nsf_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_nsf_name))
    @@: nsf_kind_cell int (cast: (@@: int) (@ c.l2_nsf_kind))
    @@: nsf_ref_cell int (cast: (@@: int) (@ c.l2_nsf_ref))
    c.L2SchemaField: field_storage
    @: field c.L2SchemaField (cast: (@: c.L2SchemaField) (@ field_storage))
    int: slot 0
    int: seen 0
    int: found -1
    int: row 0
    int: width lm_compiler_schema_width(schema)
    int: owner c.lm_compiler_schema_index(schema)
    if: project = 0 && c.lm_compiler_schema_kind(schema) = 1
        width: ns_count_cell[0][owner]
    while: slot < width
        if: project = 0 && c.lm_compiler_schema_kind(schema) = 1
            while: row < nsf_n_cell[0] && nsf_owner_cell[0][row] != owner
                row: row + 1
            if: row >= nsf_n_cell[0]
                return: (cast: (int) (-1))
            field\name: nsf_fname_cell[0][row]
            field\type_word: nsf_name_cell[0][row]
            field\kind: nsf_kind_cell[0][row]
            field\model: nsf_ref_cell[0][row]
            field\pointee: -1
            if: field\kind = 10
                field\pointee: lm_compiler_nsf_pointee(row)
            row: row + 1
        else:
            if: lm_compiler_schema_field(schema, slot, field) != 0
                return: (cast: (int) (-1))
        ---
        if: c.lm_compiler_text_same((field\name), name) != 0
            if: occurrence < 0 || occurrence = seen
                found: slot
                if: out != 0
                    \out: field_storage
                if: occurrence >= 0
                    if: project = 0
                        return: (cast: (int) (found))
                    return: (cast: (int) (lm_compiler_schema_placed(schema, found)))
            ---
            seen: seen + 1
        slot: slot + 1
    ---
    if: project = 0
        return: (cast: (int) (found))
    return: (cast: (int) (lm_compiler_schema_placed(schema, found)))
end: lm_compiler_schema_named_select

fn: lm_compiler_method_field_count (int: mi) int
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
