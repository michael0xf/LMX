Filters:
    int: value
    return: int
    normalize:
        if: value < 0
            return: -value
        return: value
    double:
        return: value * 2
    offset:
        return: value + 1
    pipeline:
        import: PipeLibrary
        return: value pipe normalize double offset
    demo:
        return: pipeline(-3)

