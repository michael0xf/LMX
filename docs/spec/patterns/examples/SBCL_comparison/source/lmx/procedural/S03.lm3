Example:
    int: initial
    []int: costs
    return: @
    run:
        int: remaining initial
        int: accepted 0
        int: rejected 0
        int: i 0
        while: i < length(costs)
            if: costs[i] <= remaining
                remaining -= costs[i]
                accepted += 1
            else:
                rejected += 1
            i += 1
        return: (remaining; accepted; rejected)
