include: "<stddef.h>"
predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_message.h.lm1"
predef: "l2src/lmx_thread.h.lm1"

# lmx_service.h.lm1 - the mail service: a sorted list of PHYSICAL addresses that answers
# membership in bounded time (spec 2 and 19.29.7; the gaps note's item 3, the delivery half).
#
# Mikhail, 2026-09-16, verbatim: "завести почтовый сервис который будет хранить сортированный
# список адресов и давать за конечное время (только не перебором по одному) вхождение?!!!!  Тот
# же самый R0."  And on an address that is not there: an absent address is refused BY THE SERVICE,
# not by any parent, and it is refused without dereferencing it.
#
# The service is not a new entity: every Message is created from the root Message by the chain, so
# the root passes itself as the mail service at merge, and every Message holds its service's
# address from its creation.  The service handed down the chain may be ANY Message, not only the
# root, and what it holds is this: entries ordered by the physical address of a live record.
#
# Ordering is the whole mechanism, and it is the arena's own trick again: the ENTRIES are ordered
# and bisected, while the records they name never move.  So growth may reallocate the entry array
# (the entries move, the targets do not), a lookup is a bisection and never a walk of the list.
# The key of an entry is the physical address of the executable Message prefix. Because it is the
# first by-value member this equals the containing LmxThread address, but Message remains the mail
# identity and Thread remains the exact executor type. It is not a composed hierarchical address.
#
# An entry carries the target's own arena beside the target, because delivery is an admission into
# the target's mailbox and the mailbox's queue nodes are cells of THAT arena.  The arena is the
# context of the act, and this is the act's context -- not a second description of the Message.
define: LMX_SERVICE_OK 0
define: LMX_SERVICE_INVALID 1
# The entry array could not grow.  Nothing is registered and nothing is disturbed.
define: LMX_SERVICE_FULL 2
# This record is already registered under its own physical address.
define: LMX_SERVICE_DUPLICATE 3
# An address no live record has: the refusal of 19.29.7.  The address is never dereferenced.
define: LMX_SERVICE_MISSING 4

# One live record: where it stands, and how to reach it.
#
# The key is the PHYSICAL address of the LmxThread record (the pointer value).  Entries own no
# separate cell array -- nothing is allocated per address beyond the entry itself.
struct: LmxServiceEntry
    # The physical address of the live executable Message prefix (= its containing LmxThread*).
    # Ordering and bisection key.
    @: void address
    # The record itself: the target's L3 Thread (same pointer as `address` at registration).
    @: void target
    # The target's own arena: the mailbox this service delivers into is storage of that arena.
    @: LmxArena arena
    # The service this entry belongs to: a hop that holds an entry holds its route AND its
    # registry, so a postman needs no second reference to find where to hand a letter next.
    @: LmxService service
end: LmxServiceEntry

# Fixed array of service registry entries (declare once; element type LmxServiceEntry).
struct: LmxServiceEntryArray
    size_t: len
    @: LmxServiceEntry data
end: LmxServiceEntryArray

# The service, as data.  Entries are one ordered DynamicArray (Q18).
struct: LmxServiceEntryDynamicArray
    LmxServiceEntryArray: array
    size_t: capacity
end: LmxServiceEntryDynamicArray

struct: LmxService
    LmxServiceEntryDynamicArray: entries
end: LmxService
prototype:
    # Zero the service.  A by-value service must be cleared before it is opened; opening a
    # non-empty one is refused, exactly as a pool refuses to be opened twice.
    fn: lmx_service_open (@: LmxService service) int
    # Register a live record under ITS OWN physical address (the address of the LmxThread
    # record itself).  No hierarchical composition -- the pointer value is the key.
    fn: lmx_service_register (@: LmxService service; @: LmxThread target; @: LmxArena target_arena) int
    # The record at this physical address, or null.  A bisection, not a walk.  A foreign
    # address is refused without dereference.
    fn: lmx_service_find (@: LmxService service; @: void address) @: void
    # DELIVERY: the record at that physical address is found and the letter is admitted into
    # ITS mailbox.  An address no record has is refused by the service and is never
    # dereferenced (19.29.7).  letter_arena is the Message's OWN arena (spec 19.29.2): on
    # LMX_SERVICE_MISSING the service releases that arena (undelivered letter = release the
    # letter's arena). On success the producer publishes {letter, letter_arena}; only the receiver
    # owner attaches that arena immediately before taking/exposing the letter (19.28.R2.5).
    fn: lmx_service_post (@: LmxService service; @: void address; @: LmxMsg letter; @: LmxArena letter_arena) int
    # One record leaves: its physical address is free again and its entry is unlinked.
    fn: lmx_service_unregister (@: LmxService service; @: LmxThread target) int
    # Release the entry array.  The records are not the service's to free.
    fn: lmx_service_release (@: LmxService service) int
    fn: lmx_service_count (@: LmxService service) size_t
    # The i-th record in PHYSICAL-ADDRESS order: what the ordering itself is checked by.
    fn: lmx_service_at (@: LmxService service; size_t: index) @: void
    fn: lmx_service_entries_data (@: LmxService service) @: LmxServiceEntry
    fn: lmx_service_entries_len (@: LmxService service) size_t
    fn: lmx_service_entries_cap (@: LmxService service) size_t
    fn: lmx_service_entries_set_data (@: LmxService service; @: LmxServiceEntry data) void
    fn: lmx_service_entries_set_len (@: LmxService service; size_t: len) void
    fn: lmx_service_entries_set_cap (@: LmxService service; size_t: capacity) void
end: prototype
