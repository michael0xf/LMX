# A same-named unit method cannot replace a selected callable formal.
# Explicit calls use the supplied occurrence. A bare method name passed as an
# actual transports its address; it does not invoke that method.
fn: real () int
    return: 7
end: real

fn: f () int
    return: 23
end: f

fn: invoke (real: f) int
    f()
    return: f()
end: invoke

fn: forward (real: g) int
    return: invoke(g)
end: forward

sendMessage: exit(exit_code: forward(real); stdout: ""; stderr: "")
return
