UninitializedGraph:
    int: novalue
    @: noReference
    int: zero 0
    @: nullReference 0
    return: int
    numberReady:
        return: novalue != nil
    referenceReady:
        return: noReference != nil
    localWrite:
        novalue := 5
        noReference := 0
        return: novalue
    storeGraph:
        node\novalue := 5
        node\noReference := 0
        return: node\novalue
    requireNumber:
        required: novalue
        return: novalue
    checkZero:
        required: zero
        return: zero = 0 && zero != nil
    checkNull:
        required: nullReference
        return: nullReference != nil
