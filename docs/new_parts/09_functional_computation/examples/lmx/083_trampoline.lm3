Steps:
    return: @
    even_step:
        if: remaining = 0
            finished := 1
            answer := 1
            return: 0
        remaining -= 1
        return: odd_step
    odd_step:
        if: remaining = 0
            finished := 1
            answer := 0
            return: 0
        remaining -= 1
        return: even_step

Runner:
    int: remaining
    return: int
    run:
        int: finished 0
        int: answer 0
        @: next Steps\even_step
        while: finished = 0
            next := next()
        return: answer
