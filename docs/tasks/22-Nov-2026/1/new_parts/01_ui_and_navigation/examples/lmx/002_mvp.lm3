Model:
    int: count 5

Screen:
    int: shown 0
    int: value
    show:
        node\shown := value

Presenter:
    @: model Model
    @: view Screen
    int: delta
    click:
        model\count += delta
        view\show(value := model\count)

Demo:
    return: int
    run:
        Model\count := 5
        Presenter\click(delta := 2)
        return: Model\count * 10 + Screen\shown
