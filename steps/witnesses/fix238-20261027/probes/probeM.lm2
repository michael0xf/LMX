# Probe M: an ordinary L2 call with a plain local actual, then a bare deref actual.
include: "<stdio.h>"
fn: add (int: a; int: b) int
    return: a + b
end: add
fn: show (@: out int) int
    int: uslot 5
    int: s add(uslot, \out)
    if: c.printf("%d\n", s) < 0
        return: 1
    return: 0
end: show
fn: run () int
    int: v 7
    if: show(@ v) != 0
        return: 80
    return: 7
end: run
sendMessage: exit(exit_code: run(); stdout: ""; stderr: "")
return
