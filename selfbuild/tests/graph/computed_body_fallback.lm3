# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: k 0
        int: result 0
        int: outside 0
)
@: shared data[0]
int: k 5
fn: local (int: value) int
    return: value + 100
end: local
fn: change () int
    node\k := 8
    return: 1
end: change
fn: outer () int (
    prepared:
        args: (int: value)
        return: int
        code: (return: value * 10)
    int: seeded change()
    int: before 0
)
    int: used seeded
    before := local((k))
    fn: local prepared; return: before * 100 + local((k))
end: outer
int: result outer()
int: outside data\k

sub: main ()
    shared\Observed\k := node\k
    shared\Observed\result := result
    shared\Observed\outside := outside
main()
