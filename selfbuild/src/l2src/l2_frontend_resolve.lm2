# Original: l2src/l2trans.lm1:4340
fn: lm_compiler_rb_declaration (const: (@: source_node c.LmP0Node)) @: c.L2Declaration
    @@: declarations_cell c.L2Declaration (cast: (@@: c.L2Declaration) (@ c.l2_declarations))
    @: result c.L2Declaration declarations_cell[0]
    @: leaf c.L2TypeContract
    @: word c.LmP0Text c.lm_compiler_rb_find(source_node)
    # A binding to a method's occurrence (NS-ROLES-1b) has no model to take: its row is a reference cell
    # (l2_own_decl_ty) and its store the occurrence (l2_emit_stmts, l2_rw_stmt_content).
    if: c.lm_compiler_rb_meth_of(source_node) >= 0
        return: (cast: (@: c.L2Declaration) (0))
    while: result != 0
        if: result\source = source_node && result\contract != 0 && result\contract\kind = 2
            return: (cast: (@: c.L2Declaration) (result))
        result: result\allocated_next
    ---
    if: word = 0 || source_node\as = 0 || source_node\as\frame = 0 || source_node\as\frame\body = 0
        return: (cast: (@: c.L2Declaration) (0))
    leaf: c.lm_compiler_contract_new(0, 0, word, 0)
    if: leaf = 0
        return: (cast: (@: c.L2Declaration) (0))
    result: (cast: (@: c.L2Declaration) c.lm_compiler_xmalloc((cast: (size_t) (c.sizeof(c.L2Declaration)))))
    if: result = 0
        return: (cast: (@: c.L2Declaration) (0))
    c.memset((cast: (@: void) result), 0, (cast: (size_t) (c.sizeof(c.L2Declaration))))
    result\source: (cast: (@: c.LmP0Node) source_node)
    result\contract: c.lm_compiler_contract_new(2, 1, 0, leaf)
    result\name: source_node\as\frame\head
    result\candidate: c.lm_compiler_next_active((cast: (@: c.LmP0Field) (source_node\as\frame\body\first_field)))
    result\candidate_count: 1
    result\extent: 0
    result\allocated_next: declarations_cell[0]
    declarations_cell[0]: result
    if: result\contract = 0
        return: (cast: (@: c.L2Declaration) (0))
    return: (cast: (@: c.L2Declaration) (result))
end: lm_compiler_rb_declaration

# Original: l2src/l2trans.lm1:4388
fn: lm_compiler_unit_value_above (const: (@: a c.LmP0Text); const: (@: item c.LmP0Node)) int
    const: (@@: cur_unit_cell c.LmP0Structure (cast: (const: @@: c.LmP0Structure) (@ c.l2_cur_unit)))
