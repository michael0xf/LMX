# Original: l1src/l1trans.lm1:367
fn: l1_ident_to_buf (@: dst char; size_t: cap; const: (@: text c.LmP0Text)) int
    size_t: start 0U
    size_t: n 0U
    if: dst = 0 || cap < 2U || text = 0 || text\data = 0
        return: (cast: (int) (1))
    n: text\length
    if: n >= 2U && text\data[0] = 96 && text\data[n - 1U] = 96
        start: 1U
        n: n - 2U
    ---
    if: n + 1U >= cap
        return: (cast: (int) (1))
    c.memcpy(dst, text\data + start, n)
    dst[n]: 0
    return: (cast: (int) (0))
end: l1_ident_to_buf

# Original: l1src/l1trans.lm1:416
fn: l1_is_payload_int (const: (@: text c.LmP0Text)) int
    if: l1_text_eq(text, "int") || l1_text_eq(text, "unsigned") || l1_text_eq(text, "long") || l1_text_eq(text, "short") || l1_text_eq(text, "size_t") || l1_text_eq(text, "char")
        return: (cast: (int) (1))
