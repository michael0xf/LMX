# A known Structure candidate initializes the field in its actual occurrence
# when that occurrence is created. Calling Holder retains the written operation
# and can bind it again. A merge copies the referent and redirects the saved
# binding to that copy. Exit 7; 81 absent or original before the call, 82 absent
# or original after it, 83 the field read, 84 copy isolation.
Model:
    int: v 11
end: Model
Holder:
    @: Model p Model
    int: k 3
end: Holder
h: merge: Holder
int: code 7
if: h\p = 0 || h\p = Model
    code: 81
h
if: h\p = 0 || h\p = Model
    code: 82
if: code = 7 && h\p\v != 11
    code: 83
if: code = 7
    h\p\v: 31
    if: Model\v != 11 || h\p\v != 31
        code: 84
end: if
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
