Example:
    int[]: items
    return: @
    run:
        int[]: result []
        int: i 0
        while: i < length(items)
            int: j 0
            while: j < length(result) && result[j] != items[i]
                j += 1
            if: j = length(result)
                sys\resize(result; j + 1)
                result[j] := items[i]
            i += 1
        return: result
