predef: "lmx_arena_refs.lm1"

# Reference-value passing. Lingvamyxa_spec.txt 21.4.
#
# 21.4: "Structure and Array arguments are Java-style reference values. The
# reference is copied into the callee's C activation; the referenced
# graph/storage is not cloned. Rebinding the callee's local reference changes
# only that local reference. An explicit reference\field write or array[index]
# write mutates the shared referent and is visible through every reference/path
# to that same node or Array storage inside the Message."
#
# This unit exists to pin that down where an implementation would most easily
# drift. Nothing here is hard; the risk is that a later change starts cloning
# on the way in, or starts passing a reference to the reference so that a
# callee's rebinding reaches the caller. Both would still pass every other test
# in this tree, so they get their own.
#
# The helpers below are written to DO the tempting wrong thing locally - rebind,
# reassign - so the selftest can show it does not escape.

# Rebinds its own local reference and returns it. The caller's reference must
# not follow. 21.4: "Rebinding the callee's local reference changes only that
# local reference."
fn: lmx_ref_rebind_local (@: LmxArray desc; @: LmxArray other) @: LmxArray
    desc: other
return: desc

# Writes through the reference into the shared backing. 21.4: visible through
# every reference and path to that same Array storage.
fn: lmx_ref_write_through (@: LmxArray desc; size_t: index; int: value) int
    @: int cells
    if: desc = 0
        return: 1
    if: desc\array.data = 0
        return: 1
    if: index >= desc\array.size
        return: 1
    cells: (cast: (@: int) desc\array.data)
    cells[index]: value
return: 0

fn: lmx_ref_read (@: LmxArray desc; size_t: index; @: int out) int
    @: int cells
    if: desc = 0 || out = 0
        return: 1
    if: desc\array.data = 0
        return: 1
    if: index >= desc\array.size
        return: 1
    cells: (cast: (@: int) desc\array.data)
    \out: cells[index]
return: 0

# The same distinction for a Structure occurrence. Repointing a local Lmx
# reference must not move the caller's; writing a field through it must.
fn: lmx_ref_repoint_local (@: Lmx cell; @: Lmx other) @: Lmx
    cell: other
return: cell

# A field write through the reference. 21.4: it mutates the shared referent and
# is visible through every reference and path to that same Structure. Under the
# settled representation the write rebinds one void * child slot; a Structure's
# own `data` is that slot array, never a payload of its own -- and that slot array
# is an array of its arena like every other (lmx_arena_refs), so nothing here
# owns it and nothing here frees it.
fn: lmx_ref_set_field (@: Lmx cell; size_t: index; @: void value) int
return: lmx_arena_ref_store(cell, index, value)

fn: lmx_ref_get_field (@: Lmx cell; size_t: index) @: void
return: lmx_arena_ref_value(cell, index)

# Replace an already proved same-type, same-length backing. Fixed graph
# Arrays do not resize; growable membership is a List. The descriptor keeps
# its identity and every alias observes the backing replacement.
fn: lmx_ref_restore_storage (@: LmxArray desc; size_t: len; @: void data) int
    if: desc = 0 || len != desc\array.size || (len != 0U && data = 0)
        return: 1
    desc\array.data: data
return: 0
