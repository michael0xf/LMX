+fn: driver_before_turn (@: root c.LmxRoot; @: r0 c.LmxMsg) int
+    @: pointer_abi_mutation_requested_cell int (cast: (@: int) (@ c.pointer_abi_mutation_requested))
+    const: @@(phase_cell char (cast: (const: @@(char)) (@ c.phase)))
+    @: failures_cell int (cast: (@: int) (@ c.failures))
+    @: graph_mutation_setup_failures_cell int (cast: (@: int) (@ c.graph_mutation_setup_failures))
+    @: graph_mutation_setup_ok_cell int (cast: (@: int) (@ c.graph_mutation_setup_ok))
+    @: l2_ref_active_cell int (cast: (@: int) (@ c.l2_ref_active))
+    @@: l2_ref_peer_arena_cell c.LmxArena (cast: (@@: c.LmxArena) (@ c.l2_ref_peer_arena))
+    @@: l2_ref_peer_cell c.LmxMsg (cast: (@@: c.LmxMsg) (@ c.l2_ref_peer))
+    @@: l2_ref_peer_mail_cell c.LmxPost (cast: (@@: c.LmxPost) (@ c.l2_ref_peer_mail))
+    @@: l2_ref_parent_addr_cell void (cast: (@@: void) (@ c.l2_ref_parent_addr))
+    @: peer_slot c.LmxSchedule 0
+    @: peer_thread c.LmxThread 0
+    @: peer_graph c.Lmx 0
+    @: letter_arena c.LmxArena 0
+    @: executing c.LmxThread (cast: (@: c.LmxThread) r0)
+    @: membership void c.lmx_thread_children(executing)
+    int: mutation_rc 0
+    int: before 0
+    if: pointer_abi_mutation_requested_cell[0] != 0
+        # Allocate the incompatible cell only after Thread construction. Otherwise its deliberately wrong ABI
+        # is correctly refused by the host's construction check, before the promised entry read is reachable.
+        phase_cell[0]: "graph mutation setup"
+        before: failures_cell[0]
+        mutation_rc: shape_mutate((cast: (@: c.LmxArena) executing\slot\arena), (cast: (@: c.Lmx) r0\graph))
+        graph_mutation_setup_failures_cell[0]: failures_cell[0] - before
+        graph_mutation_setup_ok_cell[0]: mutation_rc != 0 && failures_cell[0] = before
+        if: graph_mutation_setup_ok_cell[0] = 0
+            return: 1
+        ---
+        if: l2_ref_active_cell[0] = 0
+            return: 0
+        ---
+    ---
+    check((cast: (int) (executing != 0 && membership != 0)), "R0 construction completed its record-owned membership List")
+    if: executing != 0 && executing\slot != 0
+        check((cast: (int) (c.lmx_range_classify(executing\slot\arena, membership) = c.LMX_KIND_LIST && c.lmx_range_type_of(executing\slot\arena, membership) = c.LMX_TYPE_ARRAY_OF_POINTER_BASE + c.LMX_DOMAIN_THREAD && c.lmx_range_home(executing\slot\arena, membership) = executing\slot\arena)), "membership has its exact List type and Thread owner arena")
+        check((cast: (int) (membership != (cast: (@: void) c.lmx_thread_children(root\thread)))), "host and R0 do not share a membership set")
+    ---
+    @: letter c.LmxMsg 0
+    @: letter_graph c.Lmx 0
+    @: payload c.Lmx 0
+    @: ncell void 0
+    @: sender_cell void 0
+    int: st
+    if: root = 0 || r0 = 0 || l2_ref_peer_arena_cell[0] = 0
+        return: 1
+    ---
+    c.memset((cast: (@: void) l2_ref_peer_arena_cell[0]), 0, c.sizeof(c.LmxArena))
+    if: c.lmx_arena_open(l2_ref_peer_arena_cell[0]) != 0
+        return: 1
+    ---
+    l2_ref_peer_cell[0]: (cast: (@: c.LmxMsg) c.lmx_arena_take(l2_ref_peer_arena_cell[0], c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD))
+    l2_ref_peer_mail_cell[0]: (cast: (@: c.LmxPost) c.lmx_arena_take(l2_ref_peer_arena_cell[0], c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
+    peer_slot: (cast: (@: c.LmxSchedule) c.lmx_arena_take(l2_ref_peer_arena_cell[0], c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
+    peer_thread: (cast: (@: c.LmxThread) l2_ref_peer_cell[0])
+    if: l2_ref_peer_cell[0] = 0 || l2_ref_peer_mail_cell[0] = 0 || peer_slot = 0
+        return: 1
+    ---
+    peer_graph: c.lmx_node_new_owned(l2_ref_peer_arena_cell[0])
+    if: peer_graph = 0 || c.lmx_arena_refs_open_owned(l2_ref_peer_arena_cell[0], peer_graph, 2U) != 0
+        return: 1
+    ---
+    if: c.lmx_post_init(l2_ref_peer_arena_cell[0], l2_ref_peer_mail_cell[0]) != c.LMX_POST_OK
+        return: 1
+    ---
+    if: c.lmx_schedule_init(peer_slot, l2_ref_peer_arena_cell[0], (cast: (@: void) peer_thread), 120000U) != c.LMX_SCHEDULE_OK
+        return: 1
+    ---
+    if: c.lmx_thread_init(l2_ref_peer_arena_cell[0], peer_thread, peer_graph, l2_ref_peer_mail_cell[0], peer_slot) != c.LMX_THREAD_OK
+        return: 1
+    ---
+    if: c.lmx_service_register(c.lmx_root_service(root), peer_thread, l2_ref_peer_arena_cell[0]) != c.LMX_SERVICE_OK
+        return: 1
+    ---
+    l2_ref_parent_addr_cell[0]: (cast: (@: void) c.lmx_thread_parent((cast: (@: c.LmxThread) r0)))
+    letter_arena: (cast: (@: c.LmxArena) c.calloc(1U, c.sizeof(c.LmxArena)))
+    if: letter_arena = 0 || c.lmx_arena_open(letter_arena) != 0
+        return: 1
+    ---
+    letter: (cast: (@: c.LmxMsg) c.lmx_arena_take(letter_arena, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
+    letter_graph: c.lmx_node_new_owned(letter_arena)
+    payload: c.lmx_node_new_owned(letter_arena)
+    ncell: c.lmx_int_new_owned(letter_arena)
+    if: letter = 0 || letter_graph = 0 || payload = 0 || ncell = 0
+        return: 1
+    ---
+    if: c.lmx_arena_refs_open_owned(letter_arena, letter_graph, 2U) != 0 || c.lmx_arena_refs_open_owned(letter_arena, payload, 1U) != 0
+        return: 1
+    ---
+    if: c.lmx_int_store_known(ncell, 1) != 0 || c.lmx_arena_ref_store(payload, 0U, ncell) != 0
+        return: 1
+    ---
+    # The sender is a pointer cell holding the peer's own address (author's Q26.2 ruling -- the
+    # same shape lmx_root_launch_tapped now builds mainArgs's own sender with).
+    sender_cell: c.lmx_pointer_new_owned(c.LMX_TYPE_MSG_REF, letter_arena)
+    if: sender_cell = 0 || c.lmx_pointer_store_known(sender_cell, (cast: (@: void) l2_ref_peer_cell[0])) != 0
+        return: 1
+    ---
+    if: c.lmx_arena_ref_store(letter_graph, 0U, sender_cell) != 0 || c.lmx_arena_ref_store(letter_graph, 1U, (cast: (@: void) payload)) != 0
+        return: 1
+    ---
+    letter\running: 1
+    letter\success: 0
+    letter\handoff_ready: 0
+    letter\graph: letter_graph
+    st: c.lmx_service_post(c.lmx_root_service(root), (cast: (@: void) r0), letter, letter_arena)
+    return: (cast: (int) (st != c.LMX_SERVICE_OK))
+end: driver_before_turn
+
+sub: post_log (@: arena c.LmxArena; @: letter c.LmxMsg)
+    @: g_fields c.VoidArray 0
+    @: p_fields c.VoidArray 0
+    @: t_fields c.VoidArray 0
+    @: post_log_n_cell int (cast: (@: int) (@ c.post_log_n))
+    @: g c.Lmx 0
+    @: p c.Lmx 0
+    @: v void 0
+    @: t c.LmxArray 0
+    size_t: j 0U
+    post_log_n_cell[0]: post_log_n_cell[0] + 1
+    c.printf("post %d:", post_log_n_cell[0])
+    if: letter != 0
+        g: letter\graph
+        g_fields: 0
+        if: g != 0
+            g_fields: @ g\array
+        ---
+    ---
+    if: g != 0 && g_fields\size >= 2U && c.lmx_range_classify(arena, c.lmx_arena_ref_value(g, 1U)) = c.LMX_KIND_STRUCT
+        p: c.lmx_arena_ref_struct(g, 1U)
+        p_fields: 0
+        if: p != 0
+            p_fields: @ p\array
+        ---
+    ---
+    if: p = 0
+        c.printf(" not a letter")
+    ---
+    while: p != 0 && j < p_fields\size
+        v: c.lmx_arena_ref_value(p, j)
+        if: v != 0 && c.lmx_domain_type(arena, v) = c.LMX_TYPE_INT
+            c.printf(" %d", c.lmx_int_value_known(v))
+        else:
+            if: v != 0 && c.lmx_domain_type(arena, v) = c.LMX_TYPE_ARRAY_OF_CHAR
+                t: (cast: (@: c.LmxArray) v)
+                t_fields: 0
+                if: t != 0
+                    t_fields: @ t\array
+                ---
+                c.printf(" \"%.*s\"", (cast: (int) t_fields\size), (cast: (@: char) t_fields\data))
+            else:
+                c.printf(" ?")
+            ---
+        ---
+        j: j + 1
+    ---
+    c.printf("\n")
+end: post_log
+
+fn: driver_service_post (@: service c.LmxService; @: address void; @: letter c.LmxMsg; @: letter_arena c.LmxArena) int
+    const: @@(phase_cell char (cast: (const: @@(char)) (@ c.phase)))
+    @: post_paths_requested_cell int (cast: (@: int) (@ c.post_paths_requested))
+    @: post_paths_seen_cell int (cast: (@: int) (@ c.post_paths_seen))
+    @@: post_paths_arena_cell c.LmxArena (cast: (@@: c.LmxArena) (@ c.post_paths_arena))
+    @@: post_paths_graph_cell c.Lmx (cast: (@@: c.Lmx) (@ c.post_paths_graph))
+    @@: l2_ref_peer_cell c.LmxMsg (cast: (@@: c.LmxMsg) (@ c.l2_ref_peer))
+    @: l2_ref_reply_to_sender_cell int (cast: (@: int) (@ c.l2_ref_reply_to_sender))
+    @@: l2_ref_parent_addr_cell void (cast: (@@: void) (@ c.l2_ref_parent_addr))
+    @: l2_ref_reply_to_parent_cell int (cast: (@: int) (@ c.l2_ref_reply_to_parent))
+    @: post_log_requested_cell int (cast: (@: int) (@ c.post_log_requested))
+    int: st
+    const: (@: saved_phase char phase_cell[0])
+    if: post_paths_requested_cell[0] != 0 && post_paths_seen_cell[0] = 0
+        post_paths_seen_cell[0]: post_paths_seen_cell[0] + 1
+        phase_cell[0]: "generated program post paths"
+        check((cast: (int) (post_paths_arena_cell[0] != 0 && post_paths_graph_cell[0] != 0)), "postpaths observes the actual completed builder graph before its release")
+        if: post_paths_arena_cell[0] != 0 && post_paths_graph_cell[0] != 0
+            check((cast: (int) (shape_paths_check(post_paths_arena_cell[0], post_paths_graph_cell[0], 1) != 0)), "postpaths completes its selected physical observations")
+        ---
+        phase_cell[0]: saved_phase
+    ---
+    if: l2_ref_peer_cell[0] != 0 && address = (cast: (@: void) l2_ref_peer_cell[0])
+        l2_ref_reply_to_sender_cell[0]: l2_ref_reply_to_sender_cell[0] + 1
+    ---
+    if: l2_ref_parent_addr_cell[0] != 0 && address = l2_ref_parent_addr_cell[0]
+        l2_ref_reply_to_parent_cell[0]: l2_ref_reply_to_parent_cell[0] + 1
+    ---
+    if: post_log_requested_cell[0] != 0
+        post_log(letter_arena, letter)
+    ---
+    st: c.lmx_service_post(service, address, letter, letter_arena)
+    if: st = c.LMX_SERVICE_OK && l2_ref_peer_cell[0] != 0 && address = (cast: (@: void) l2_ref_peer_cell[0])
+        c.lmx_service_unregister(service, (cast: (@: c.LmxThread) l2_ref_peer_cell[0]))
+    ---
+    return: st
