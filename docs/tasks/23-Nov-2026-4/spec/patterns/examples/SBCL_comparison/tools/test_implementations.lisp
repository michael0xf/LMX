(let* ((tools (make-pathname :name nil :type nil :defaults *load-truename*))
       (sources (merge-pathnames "../source/implementations/common-lisp/" tools)))
  (load (merge-pathnames "runtime.lisp" sources))
  (dolist (name '("SI01" "SI02" "SI03" "SI04" "SI05" "SI06"))
    (load (merge-pathnames (concatenate 'string name ".lisp") sources))))

(defpackage #:lmx-sbcl-implementation-tests
  (:use #:cl #:lmx-sbcl-reference))
(in-package #:lmx-sbcl-implementation-tests)
(defvar *checks* 0)

(defmacro check (id form)
  `(progn
     (unless ,form (error "FAILED ~A: ~S" ,id ',form))
     (incf *checks*)
     (format t "PASS ~A~%" ,id)))

(defun raises (thunk &optional (kind 'error))
  (handler-case (progn (funcall thunk) nil)
    (error (condition) (typep condition kind))))

(defun ivector (items &optional (element-type t))
  (make-array (length items) :adjustable t :fill-pointer (length items)
                            :element-type element-type :initial-contents items))

(defun positive (x) (if (plusp x) 1 0))
(defun equal-int (a b) (if (equalp a b) 1 0))
(defun subtract (a b) (- a b))

(check "SI01.01" (equalp (map-values '(1 2 3) (lambda (x) (* x 2))) #(2 4 6)))
(check "SI01.02" (equalp (map-values nil #'identity) #()))
(let ((x (list :shared)))
  (check "SI01.03" (eq (aref (map-values (vector x) #'identity) 0) x)))
(check "SI01.04" (equalp (map-values #(1 2) (lambda (x) (declare (ignore x)) nil)) #(nil nil)))
(check "SI01.05" (equal (filter-values '(-1 0 2 3) #'positive) '(2 3)))
(check "SI01.06" (string= (filter-values "aBc" (lambda (c) (if (lower-case-p c) 1 0))) "ac"))
(check "SI01.07" (equalp (filter-values #*10110 #'identity) #*111))
(check "SI01.08" (null (filter-values nil #'positive)))
(check "SI01.09" (= (fold-values '(1 2 3) 20 #'subtract) 14))
(let ((seed (list :seed)))
  (check "SI01.10" (eq (fold-values #() seed (lambda (&rest x) (declare (ignore x)) (error "unused"))) seed)))
(check "SI01.11" (string= (fold-values '("a" "bc") "" (lambda (a b) (concatenate 'string a b))) "abc"))
(check "SI01.12" (equalp (zip-with-values '(1 2 3) #(10 20) #'+) #(11 22)))
(check "SI01.13" (equalp (zip-with-values nil '(1) #'+) #()))
(let ((calls 0))
  (check "SI01.14" (raises (lambda () (map-values '(1 2 3) (lambda (x) (incf calls) (if (= x 2) (error "stop") x))))))
  (check "SI01.15" (= calls 2)))
(check "SI01.16" (raises (lambda () (filter-values '(1) (lambda (x) (declare (ignore x)) :truth))) 'type-error))
(check "SI01.17" (raises (lambda () (map-values 4 #'identity)) 'type-error))
(let ((trace nil))
  (map-values '(1 2 3) (lambda (x) (push x trace) x))
  (check "SI01.18" (equal (reverse trace) '(1 2 3))))
(check "SI01.19" (equal (compress-values '(3 4 5) '(1 0 -2)) '(3 5)))
(check "SI01.20" (equalp (compress-values #() #()) #()))
(check "SI01.21" (string= (compress-values "abc" #(1 0 1)) "ac"))
(check "SI01.22" (equalp (compress-values #*1101 #(0 1 1 1)) #*101))
(check "SI01.23" (raises (lambda () (compress-values '(1 2) '(1)))))
(check "SI01.24" (raises (lambda () (compress-values '(1) '(1 0)))))
(check "SI01.25" (raises (lambda () (compress-values '(1 2) '(1 :bad))) 'type-error))
(let* ((item (list :shared)) (items (vector item))
       (result (compress-values items #(1))))
  (check "SI01.26" (eq (aref result 0) item))
  (check "SI01.27" (not (eq result items))))

(check "SI02.01" (= (any-value nil #'positive) 0))
(check "SI02.02" (= (all-value nil #'positive) 1))
(check "SI02.03" (= (any-value '(-1 0 2) #'positive) 1))
(check "SI02.04" (= (all-value '(1 2 3) #'positive) 1))
(check "SI02.05" (= (all-value '(1 0 3) #'positive) 0))
(let ((calls 0))
  (any-value '(0 2 3) (lambda (x) (incf calls) x))
  (check "SI02.06" (= calls 2)))
(let ((calls 0))
  (all-value '(1 0 3) (lambda (x) (incf calls) x))
  (check "SI02.07" (= calls 2)))
(check "SI02.08" (equal (multiple-value-list (index-value '(-1 2) (lambda (x) (if (minusp x) 1 0)))) '(0 t)))
(check "SI02.09" (equal (multiple-value-list (index-value '(1 2) (lambda (x) (if (minusp x) 1 0)))) '(nil nil)))
(check "SI02.10" (equal (multiple-value-list (index-value nil #'positive)) '(nil nil)))
(check "SI02.11" (raises (lambda () (any-value '(1) (lambda (x) (declare (ignore x)) t))) 'type-error))
(check "SI02.12" (raises (lambda () (all-value '(1) (lambda (x) (declare (ignore x)) (error "callback"))))))
(let ((x (list :identity)))
  (check "SI02.13" (eq (record-value x) x)))
(check "SI02.14" (null (record-value nil)))

(check "SI03.01" (equal (sort-values '(3 1 2) #'subtract) '(1 2 3)))
(check "SI03.02" (string= (sort-values "cab" (lambda (a b) (- (char-code a) (char-code b)))) "abc"))
(check "SI03.03" (equalp (sort-values #*10101 #'subtract) #*00111))
(let ((rows (list (list 2 :a) (list 1 :b) (list 2 :c) (list 1 :d))))
  (let ((sorted (sort-values rows (lambda (a b) (- (first a) (first b))))))
    (check "SI03.04" (equal (mapcar #'second sorted) '(:b :d :a :c)))
    (check "SI03.05" (equal (mapcar #'second rows) '(:a :b :c :d)))
    (check "SI03.06" (eq (third sorted) (first rows)))))
(let ((calls 0))
  (sort-values nil (lambda (a b) (declare (ignore a b)) (incf calls)))
  (sort-values '(3) (lambda (a b) (declare (ignore a b)) (incf calls)))
  (check "SI03.07" (zerop calls)))
(let ((source (vector 3 2 1)))
  (check "SI03.08" (raises (lambda () (sort-values source (lambda (a b) (declare (ignore a b)) (error "compare"))))))
  (check "SI03.09" (equalp source #(3 2 1))))
(check "SI03.10" (raises (lambda () (sort-values '(2 1) (lambda (a b) (declare (ignore a b)) :bad))) 'type-error))
(check "SI03.11" (equal (unique-values '(2 1 2 3 1) #'equal-int) '(2 1 3)))
(check "SI03.12" (string= (unique-values "abaca" #'equal-int) "abc"))
(check "SI03.13" (equalp (unique-values #*10101 #'equal-int) #*10))
(check "SI03.14" (null (unique-values nil #'equal-int)))
(let* ((first (list 1 :a)) (last (list 1 :b))
       (unique (unique-values (vector first last) (lambda (a b) (if (= (car a) (car b)) 1 0)))))
  (check "SI03.15" (= (length unique) 1))
  (check "SI03.16" (eq (aref unique 0) first)))
(check "SI03.17" (raises (lambda () (unique-values '(1 1) (lambda (a b) (declare (ignore a b)) nil))) 'type-error))

(let ((target (ivector '(1 2 3 4))))
  (check "SI04.01" (eq (replace-range target 1 3 '(8 9)) target))
  (check "SI04.02" (equalp target #(1 8 9 4))))
(let ((target (ivector '(1 2 3))))
  (replace-range target 1 1 '(8 9))
  (check "SI04.03" (equalp target #(1 8 9 2 3))))
(let ((target (ivector '(1 2 3 4))))
  (replace-range target 1 3 nil)
  (check "SI04.04" (equalp target #(1 4))))
(let ((target (ivector nil)))
  (replace-range target 0 0 '(5))
  (check "SI04.05" (equalp target #(5))))
(let ((target (ivector '(1 2))))
  (replace-range target 0 2 nil)
  (check "SI04.06" (zerop (length target))))
(let ((target (ivector '(1 2 3))))
  (replace-range target 1 2 target)
  (check "SI04.07" (equalp target #(1 1 2 3 3))))
(let* ((target (ivector '(1 2 3 4)))
       (view (make-array 2 :displaced-to target :displaced-index-offset 1)))
  (replace-range target 0 2 view)
  (check "SI04.08" (equalp target #(2 3 3 4))))
(let ((target (ivector '(1 2 3) '(unsigned-byte 8))))
  (check "SI04.09" (raises (lambda () (replace-range target 0 1 '(5 :bad))) 'type-error))
  (check "SI04.10" (equalp target #(1 2 3))))
(let ((target (ivector '(1 2))))
  (check "SI04.11" (raises (lambda () (replace-range target -1 1 '(3)))))
  (check "SI04.12" (raises (lambda () (replace-range target 2 1 '(3)))))
  (check "SI04.13" (raises (lambda () (replace-range target 0 3 '(3)))))
  (check "SI04.14" (equalp target #(1 2))))
(check "SI04.15" (raises (lambda () (replace-range #(1 2) 0 1 '(3)))))
(let ((target (ivector '(#\a #\b #\c) 'character)))
  (replace-range target 1 2 '(#\x #\y))
  (check "SI04.16" (string= target "axyc")))
(let ((item (list :x)) (target (ivector nil)))
  (replace-range target 0 0 (list item))
  (check "SI04.17" (eq (aref target 0) item)))

(check "SI05.01" (= (funcall (partial-values #'+ 2 '(5)) 7) 12))
(check "SI05.02" (equal (funcall (partial-values #'list 3 '(a)) 'b 'c) '(a b c)))
(check "SI05.03" (= (funcall (partial-values #'+ 2 nil) 2 3) 5))
(check "SI05.04" (= (funcall (partial-values #'+ 2 '(2 3))) 5))
(check "SI05.05" (equal (multiple-value-list (funcall (partial-values #'floor 2 '(10)) 3)) '(3 1)))
(check "SI05.06" (raises (lambda () (partial-values #'+ 1 '(1 2)))))
(check "SI05.07" (raises (lambda () (funcall (partial-values #'+ 2 '(1))))))
(check "SI05.08" (raises (lambda () (funcall (partial-values #'+ 2 '(1)) 2 3))))
(let* ((prefix (vector 5)) (add5 (partial-values #'+ 2 prefix)))
  (setf (aref prefix 0) 99)
  (check "SI05.09" (= (funcall add5 1) 6)))
(let* ((item (list :value)) (fun (partial-values #'list 1 (list item))))
  (check "SI05.10" (eq (car (funcall fun)) item)))
(let ((calls 0))
  (let ((fun (partial-values (lambda (x) (incf calls) x) 1 '(7))))
    (check "SI05.11" (zerop calls))
    (funcall fun)
    (check "SI05.12" (= calls 1))))
(check "SI05.13" (raises (lambda () (funcall (partial-values (lambda () (error "call")) 0 nil)))))

(let ((calls 0))
  (let ((memo (memoize-values (lambda (x) (incf calls) (* x x)) #'equal-int)))
    (check "SI06.01" (= (funcall memo 3) 9))
    (check "SI06.02" (= (funcall memo 3) 9))
    (check "SI06.03" (= (funcall memo 4) 16))
    (check "SI06.04" (= calls 2))))
(let ((calls 0))
  (let ((memo (memoize-values (lambda () (incf calls) nil) #'equal-int)))
    (check "SI06.05" (null (funcall memo)))
    (check "SI06.06" (null (funcall memo)))
    (check "SI06.07" (= calls 1))))
(let ((calls 0))
  (let ((memo (memoize-values (lambda (x) (incf calls) (if (= calls 1) (error "retry") x)) #'equal-int)))
    (check "SI06.08" (raises (lambda () (funcall memo 7))))
    (check "SI06.09" (= (funcall memo 7) 7))
    (check "SI06.10" (= (funcall memo 7) 7))
    (check "SI06.11" (= calls 2))))
(let* ((item (list :result)) (memo (memoize-values (lambda (x) (declare (ignore x)) item) #'equal-int)))
  (check "SI06.12" (eq (funcall memo 1) item))
  (check "SI06.13" (eq (funcall memo 1) item)))
(let ((memo (memoize-values #'floor #'equal-int)))
  (check "SI06.14" (equal (multiple-value-list (funcall memo 10 3)) '(3 1)))
  (check "SI06.15" (equal (multiple-value-list (funcall memo 10 3)) '(3 1))))
(let ((memo (memoize-values (lambda () (values)) #'equal-int)))
  (check "SI06.16" (null (multiple-value-list (funcall memo))))
  (check "SI06.17" (null (multiple-value-list (funcall memo)))))
(let ((memo (memoize-values #'identity (lambda (a b) (declare (ignore a b)) :bad))))
  (funcall memo 1)
  (check "SI06.18" (raises (lambda () (funcall memo 1)) 'type-error)))
(let ((memo (memoize-values #'identity (lambda (a b) (declare (ignore a b)) (error "key")))))
  (funcall memo 1)
  (check "SI06.19" (raises (lambda () (funcall memo 1)))))
(format t "CHECKS ~D~%" *checks*)
