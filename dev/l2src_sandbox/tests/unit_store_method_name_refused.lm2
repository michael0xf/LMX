# A formal of a number type is stored to, though a method of the unit has its
# name: `p: "text"` is a store into the int p, and its value is checked as any
# store's. Taken for a call of the method p by its name alone, the statement
# escaped the check.
fn: p (int: a) int
    return: a
end: p

fn: stored (int: p; int: x) int
    p: "text"
    return: p
end: stored

sendMessage: exit(exit_code: stored(1 7); stdout: ""; stderr: "")
return
