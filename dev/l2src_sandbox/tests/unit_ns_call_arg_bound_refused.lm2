# `Model: m` declares m when m is bound nowhere before it; bound before -- here by the first `Model: m` -- it is Model's
# call with m (the author's rule, 55c1abc, as Codex decided it: when Model and m both exist, `Model: m` calls Model
# with m), not a second declaration of m.  Not built yet: refused where it stands.  (Before the ticket the second
# `Model: m` declared m again.)
Model:
    size_t: value 1U
fn: g () int
    Model: m
    Model: m
    return: 7
end: g
int: r 0
r: g()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
