            if: digit < (-2147483647 - 1) || digit > 2147483647
                throw: MapFailure("Java IntArray hash requires signed32 cells")
            value := (value * 31 + digit) % 4294967296
            if: value < 0
                value += 4294967296
            i += 1
        if: value >= 2147483648
            value -= 4294967296
        return: value


# Table row mutations always update every column together on the owner lane.
MapTableRemoveAt:
    @: table
    int: at
    required: table at
    return: @
    removeAt:
        throws: copy(MapThrows)
        if: at < 0 || at >= length(table\keys)
            throw: MapFailure("table row")
        @: result table\values[at]
        MapVector\remove(table\keys; at)
        MapVector\remove(table\values; at)
        MapVector\remove(table\values2; at)
        return: result

MapTableErase:
    @: table
    int: begin
    int: end
    required: table begin end
    return: int
    erase:
        throws: copy(MapThrows)
        if: begin < 0 || end < begin || end > length(table\keys)
            throw: MapFailure("table row range")
        MapVector\erase(table\keys; begin; end)
        MapVector\erase(table\values; begin; end)
        MapVector\erase(table\values2; begin; end)
        return: end - begin

MapTablePop:
    @: table
    int: keyResult 0
    required: table
    return: @
    pop:
        throws: copy(MapThrows)
        int: at length(table\keys) - 1
        if: at < 0
            return: MapNil
        @: key table\keys[at]
        @: value MapTable\removeAt(table; at)
        if: keyResult != 0
            return: key
        return: value

MapTableTruncate:
    @: table
    int: size
    required: table size
    return: int
    truncate:
        throws: copy(MapThrows)
        if: size < 0
            throw: MapFailure("table size")
        if: size < length(table\keys)
            MapTable\erase(table; size; length(table\keys))
        return: length(table\keys)

# Snapshot enumeration does not retain a global Java buffer pool. The caller
# chooses create for a live owner-local vector or snapshot for a stable list.
MapIteratorSnapshot:
    @: vector
    int: begin 0
    int: end -1
    int: direction 1
    required: vector
    return: @
    snapshot:
        throws: copy(MapThrows)
        if: end < 0
            end := length(vector)
        @: values MapVector\range(vector; begin; end)
        return: MapIterator\create(values; 0; length(values); direction)

MapIteratorDispose:
    @: iterator
    required: iterator
    return: @
    dispose:
        throws: copy(MapThrows)
        iterator\values := MapNil
        iterator\begin := 0
        iterator\end := 0
        iterator\position := 0
        return: iterator

MapIteratorToFirst:
    @: iterator
    required: iterator
    return: @
    toFirst:
        throws: copy(MapThrows)
        iterator\direction := 1
        iterator\position := iterator\begin
        return: iterator

MapIteratorToLast:
    @: iterator
    required: iterator
    return: @
    toLast:
        throws: copy(MapThrows)
        iterator\direction := -1
        iterator\position := iterator\end
        return: iterator

MapLongIndexOf:
    @: vector
    i64: value
    required: vector value
    return: int
    indexOf:
        throws: copy(MapThrows)
        int: i 0
        while: i < length(vector)
            if: \vector[i] = value
                return: i
            i += 1
        return: -1

MapLongRemove:
    @: vector
    i64: value
    required: vector value
    return: int
    remove:
        throws: copy(MapThrows)
        int: at MapLong\indexOf(vector; value)
        if: at >= 0
            MapVector\remove(vector; at)
        return: at

MapLong:
    @: indexOf MapLongIndexOf\indexOf
    @: remove MapLongRemove\remove

# A live vector contains explicit membership records; values remain ordinary
# shared references. One entry can belong to one vector at a time.
MapLiveEntry:
    @: value
    required: value
    return: @
    entry:
        throws: copy(MapThrows)
        @: result (copy(MapLiveEntryModel))
        result\value := value
        return: result

MapLiveEnumerate:
    @: vector
    int: begin 0
    int: end -1
    required: vector
    return: int
    enumerate:
        throws: copy(MapThrows)
        if: end < 0
            end := length(vector)
        if: begin < 0 || end < begin || end > length(vector)
            throw: MapFailure("live enumeration range")
        int: i begin
        while: i < end
            @: entry vector[i]
            if: entry != MapNil
                entry\vector := vector
                entry\index := i
            i += 1
        return: end - begin

MapLiveNilling:
    @: vector
    int: begin
    int: end
    required: vector begin end
    return: int
    nilling:
        throws: copy(MapThrows)
        if: begin < 0 || end < begin || end > length(vector)
            throw: MapFailure("live detach range")
        int: i begin
        while: i < end
            @: entry vector[i]
            if: entry != MapNil && entry\vector = vector
                entry\vector := MapNil
                entry\index := -1
            i += 1
        return: end - begin

MapLiveInsert:
    @: vector
    int: at
    @: entry
    required: vector at entry
    return: int
    insert:
        throws: copy(MapThrows)
        if: entry != MapNil && entry\vector != MapNil
            throw: MapFailure("entry already belongs to a live vector")
        MapVector\insert(vector; at; entry)
        MapLive\enumerate(vector; at)
        return: at

MapLiveRemove:
    @: vector
    int: at
    required: vector at
    return: @
    remove:
        throws: copy(MapThrows)
        @: entry MapVector\get(vector; at)
        MapLive\nilling(vector; at; at + 1)
        MapVector\remove(vector; at)
        MapLive\enumerate(vector; at)
        return: entry

MapLiveDetach:
    @: entry
    @: expected MapNil
    required: entry
    return: @
    detach:
        throws: copy(MapThrows)
        if: entry\vector = MapNil
            return: entry
        if: expected != MapNil && expected != entry\vector
            return: entry
        return: MapLive\remove(entry\vector; entry\index)

MapLiveSet:
    @: vector
    int: at
    @: entry
    required: vector at entry
    return: @
    set:
        throws: copy(MapThrows)
        @: old MapVector\get(vector; at)
        if: old = entry
            return: old
        if: entry != MapNil && entry\vector != MapNil
            throw: MapFailure("entry already belongs to a live vector")
        MapLive\nilling(vector; at; at + 1)
        vector[at] := entry
        MapLive\enumerate(vector; at; at + 1)
        return: old

MapLiveErase:
    @: vector
    int: begin
    int: end
    required: vector begin end
    return: int
    erase:
        throws: copy(MapThrows)
        MapLive\nilling(vector; begin; end)
        MapVector\erase(vector; begin; end)
        MapLive\enumerate(vector; begin)
        return: end - begin

MapLiveClear:
    @: vector
    required: vector
    return: @
    clear:
        throws: copy(MapThrows)
        MapLive\erase(vector; 0; length(vector))
        return: vector

MapLiveMove:
    @: vector
    int: from
    int: to
    required: vector from to
    return: int
    move:
        throws: copy(MapThrows)
        MapVector\move(vector; from; to)
        int: begin from
        int: end to
        if: begin > end
            begin := to
            end := from
        MapLive\enumerate(vector; begin; end + 1)
        return: to

MapLiveSwap:
    @: vector
    int: left
    int: right
    required: vector left right
    return: int
    swap:
        throws: copy(MapThrows)
        MapVector\swap(vector; left; right)
        MapLive\enumerate(vector; left; left + 1)
        MapLive\enumerate(vector; right; right + 1)
        return: 1

MapLiveCopyFrom:
    @: vector
    @: source
    int: offset
    int: at
    int: count
    required: vector source offset at count
    return: int
    copyFrom:
        throws: copy(MapThrows)
        if: at < 0 || at > length(vector)
            throw: MapFailure("live copy destination")
        @: values MapVector\range(source; offset; MapSize\sum(offset; count))
        @: staged MapVector\create()
        int: i 0
        while: i < length(values)
            @: entry values[i]
            if: entry = MapNil
                MapVector\push(staged; MapNil)
            else:
                MapVector\push(staged; MapLive\entry(entry\value))
            i += 1
        int: end MapSize\sum(at; count)
        MapVector\reserve(vector; end)
        int: replaced end
        if: replaced > length(vector)
            replaced := length(vector)
        MapLive\nilling(vector; at; replaced)
        MapVector\copyFrom(vector; staged; 0; at; count)
        MapLive\enumerate(vector; at)
        return: count

MapLive:
    @: create MapVectorCreate\create
    @: entry MapLiveEntry\entry
    @: enumerate MapLiveEnumerate\enumerate
    @: nilling MapLiveNilling\nilling
    @: insert MapLiveInsert\insert
    @: remove MapLiveRemove\remove
    @: detach MapLiveDetach\detach
    @: set MapLiveSet\set
    @: erase MapLiveErase\erase
    @: clear MapLiveClear\clear
    @: move MapLiveMove\move
    @: swap MapLiveSwap\swap
    @: copyFrom MapLiveCopyFrom\copyFrom

MapVectorOffset:
    return: int
    offset:
        return: 0

# A content comparator is an ordinary CODE reference with parameters left/right
# and int result. It must not mutate the searched collection during this call.
MapVectorIndexBy:
    @: vector
    @: value
    @: equal
    required: vector value equal
    return: int
    indexBy:
        throws: copy(MapThrows)
        int: i 0
        while: i < length(vector)
            if: equal(left := vector[i]; right := value)
                return: i
            i += 1
        return: -1
