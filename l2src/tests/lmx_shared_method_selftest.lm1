predef: "l2src/lmx_merge_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# A method occurrence under merge (Q44, the author, 2026-09-28): the shared reference is
# to the method's NATIVE IMPLEMENTATION -- the C entry that receives the graph node -- not
# to the occurrence: "К структурам это отношения не имеет".  So `A: fn: M` with M's
# parent the unit (outside the operand) is COPIED like any Structure the walk reaches
# (Q42), its `native` word carried verbatim; the source M, its parent and A's field are
# untouched.  Mutant: the former k.4 test ("parent outside -> shared by address") back ->
# the same address -> RED.  A nested callable whose parent is inside the operand is
# copied too, as before.

# A stand-in native entry: never called by this file, only its address is compared.
fn: sample_entry (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
return: 0

sub: sh_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: sh_check

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: arena
    LmxArena: dst
    @: Lmx unit 0
    @: Lmx a 0
    @: Lmx nested 0
    @: Lmx m 0
    @: Lmx nested_m 0
    @: Lmx result 0
    @: void got 0
    @@: Lmx operands 0
    int: status LMX_MERGE_OK
    int: failures
    if: counts = 0
        return: 2
    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ dst)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0 || lmx_arena_open(@ dst) != 0
        fputs("lmx: arena open failed\n", l1_stdout())
        free(counts)
        return: 2
    ---
    operands: (cast: (@@: Lmx) calloc(1U, c.sizeof(@: void)))
    unit: lmx_node_new_owned(@ arena)
    a: lmx_node_new_owned(@ arena)
    nested: lmx_node_new_owned(@ arena)
    m: lmx_node_new_owned(@ arena)
    nested_m: lmx_node_new_owned(@ arena)
    sh_check(counts, operands != 0 && unit != 0 && a != 0 && nested != 0 && m != 0 && nested_m != 0, "structures constructed")
    if: counts[1] != 0
        free(counts)
        return: 2
    ---
    # k.4: native set directly, no descriptor. M and its nested counterpart may point at
    # the same C entry; both occurrences are copied, and the entry is what stays shared.
    m\native: (cast: (LmxEntry) sample_entry)
    nested_m\native: (cast: (LmxEntry) sample_entry)
    # Unit holds the shared method occurrence M (parent = unit).
    sh_check(counts, lmx_arena_refs_open_owned(@ arena, unit, 1U) = 0, "unit opened")
    m\parent: unit
    lmx_arena_ref_store(unit, 0U, (cast: (@: void) m))
    # A references M (A: fn: M) and nests a Structure with its own method.
    sh_check(counts, lmx_arena_refs_open_owned(@ arena, a, 2U) = 0, "A opened")
    sh_check(counts, lmx_arena_refs_open_owned(@ arena, nested, 1U) = 0, "nested opened")
    a\parent: unit
    nested\parent: a
    nested_m\parent: nested
    lmx_arena_ref_store(nested, 0U, (cast: (@: void) nested_m))
    lmx_arena_ref_store(a, 0U, (cast: (@: void) m))
    lmx_arena_ref_store(a, 1U, (cast: (@: void) nested))
    operands[0]: a

    status: lmx_merge_owned(operands, 1U, 0, 0, 0, @ arena, @ dst, 0, 0U, @ result)
    sh_check(counts, status = LMX_MERGE_OK && result != 0, "merge A OK")
    sh_check(counts, (result\array.size) = 2U, "result has two slots")

    # The method occurrence reached through A's field: copied; its implementation shared.
    got: lmx_arena_ref_value(result, 0U)
    sh_check(counts, got != 0 && got != (cast: (@: void) m), "M is copied, not kept by address (mutant: k.4 back -> RED)")
    @: Lmx m_copy (cast: (@: Lmx) got)
    sh_check(counts, got != 0 && m_copy\native = m\native, "the copy of M carries M's native implementation")
    sh_check(counts, got != 0 && m_copy\parent != 0 && m_copy\parent != unit, "the copy of M hangs under the copy of its lexical parent")
    sh_check(counts, m\parent = unit, "M.parent still the unit")
    sh_check(counts, lmx_arena_ref_value(a, 0U) = (cast: (@: void) m), "A's field untouched")

    # Nested callable whose parent is inside A: copied, parent rewritten.
    got: lmx_arena_ref_value(result, 1U)
    sh_check(counts, got != 0 && got != (cast: (@: void) nested), "nested Structure was copied")
    @: Lmx nested_copy (cast: (@: Lmx) got)
    got: lmx_arena_ref_value(nested_copy, 0U)
    sh_check(counts, got != 0 && got != (cast: (@: void) nested_m), "nested method occurrence was copied")
    @: Lmx nested_m_copy (cast: (@: Lmx) got)
    sh_check(counts, nested_m_copy\parent = nested_copy, "nested method parent rewritten to the copy")
    sh_check(counts, nested_m\parent = nested, "source nested method parent untouched")
    sh_check(counts, nested_m_copy\native = nested_m\native, "the copy's native word carried verbatim (k.4)")

    failures: counts[1]
    c.printf("lmx_shared_method_selftest: %d checks, %d failed\n", counts[0], failures)
    free((cast: (@: void) operands))
    free(counts)
    lmx_arena_release(@ arena)
    lmx_arena_release(@ dst)
    if: failures != 0
        return: 1
return: 0
