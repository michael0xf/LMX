include: "<stddef.h>"
predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_arena.h.lm1"

# The object domains this level knows, and the compatibility primitive
# `implements(varA, varB, Consumer)`.
#
# Spec 2.1 defines `implements(varA varB Consumer)` as an L2 construct: "iff every
# path in uses(Consumer varB) is present on varA, and every primitive leaf of those
# paths is admitted as in 2.2.3, and at every callable path p actually invoked by
# Consumer: sig(varA.p) == sig(varB.p) == ExpectedSig(Consumer, p)".  That is a
# source-level check over a Consumer's known used paths -- L2's business.
#
# L1 is the level BETWEEN L2 and C.  What lives here is not that predicate: it is
# the primitive L2's implements will be emitted onto.  Today it answers the first
# question 2.1 needs answered -- "are these two the same kind of thing at all" --
# and it answers it the way everything else in this kernel answers "what is this":
# by the registered address range a value falls into.  Nothing is stored on either
# operand to say what it is; a child carries no type tag (lmx.h, spec 2, 6.5).
#
# The Consumer argument is part of the signature and is reserved: the path walk,
# the leaf admission and the signature comparison of 2.1 are later stages and will
# be emitted by L2.  This stage does not read it, and does not pretend to.
#
# The arena of the Message is the context of every question here, so it is named
# explicitly on every call: the index that answers "what is this address" belongs to
# the arena (lmx_arena.h.lm1), and there is no second, module-global table to open.
# `lmx_domain_table_init` is gone with it: a caller that needs the questions answered
# opens its own arena with lmx_arena_open.

define: LMX_IMPLEMENTS_NO 0
define: LMX_IMPLEMENTS_YES 1
# The third answer of the RUNTIME predicate: the walk met something it cannot inspect, so it
# certifies neither side (spec 2.1: "Unavailable information is not invented and is not certified
# by success").  A KNOWN mismatch is still NO, and a missing used path is still NO.
define: LMX_IMPLEMENTS_UNKNOWN 2
define: LMX_DOMAIN_REGISTER_OK 0
define: LMX_DOMAIN_REGISTER_FAIL 1

# How deep the runtime walk follows a used tree.  A bound on the WORKING loop, not a claim about
# the tree: a deeper path is answered UNKNOWN rather than certified either way.
define: LMX_IMPLEMENTS_DEPTH 32

# The object domains, appended after the lmx.h registry (LmxType 0..20 and the two
# bases).  They are declared here rather than in lmx.h because that header and the
# Message record are closed: nothing is added to either.  The numbers are one
# registry -- if the domains are ever moved into lmx.h, these are the values they
# must keep.
define: LMX_DOMAIN_MSG_RECORD 21
define: LMX_DOMAIN_THREAD 22
define: LMX_DOMAIN_POST_LINK 23
define: LMX_DOMAIN_SCHEDULE 24
define: LMX_DOMAIN_MANAGER 25
# A turn's reserved child (lmx_child.h.lm1): the reservation is a mechanism record of the
# parent's arena, so the parent can drop exactly what it reserved without touching any of the
# turn's graph writes.  Appended, like the domains before it.
define: LMX_DOMAIN_RESERVATION 26
# A mailbox record that lives as a cell of the arena (a child's own mailbox does: its queue nodes
# are storage of the child's arena).  Appended, like the domains before it.
define: LMX_DOMAIN_POST 27
# One live-direct-child link of a parent's chain (lmx_thread.h.lm1, LmxLink).  The node is a cell
# of the PARENT's arena -- that is the point of it -- so it needs a domain of its own there.
define: LMX_DOMAIN_LINK 28
# THE MAILBOX'S INBOX RING (lmx_post.h.lm1): one block per mailbox, holding the addresses of the
# letters admitted and not yet taken.  It is a domain of its own because the arena seats cells of
# one (kind, type) in ONE array by stride -- a ring cell is LMX_POST_INBOX_SLOTS pointers and an
# int cell is eight bytes, and asking for both under one pair is refused by the arena
# ("array\stride != stride"), which is exactly what happened when this block first asked to be
# taken as a plain primitive (measured 20.09: `lmx_gc: the mailbox did not initialize`).
define: LMX_DOMAIN_POST_RING 29
# Descriptor in Structure child[0]: LmxCallable, not the two-field LmxMethod.
define: LMX_DOMAIN_CALLABLE 30

# The same domains as KINDS -- what lmx_range_classify answers -- appended after
# LmxKind 0..6.
define: LMX_DOMAIN_KIND_MSG_RECORD 7
define: LMX_DOMAIN_KIND_THREAD 8
define: LMX_DOMAIN_KIND_POST_LINK 9
define: LMX_DOMAIN_KIND_SCHEDULE 10
define: LMX_DOMAIN_KIND_MANAGER 11
define: LMX_DOMAIN_KIND_RESERVATION 12
define: LMX_DOMAIN_KIND_POST 13
define: LMX_DOMAIN_KIND_LINK 14
define: LMX_DOMAIN_KIND_POST_RING 15
define: LMX_DOMAIN_KIND_CALLABLE 16

prototype:
    # Register one whole domain of the arena's index: count cells of `stride`.
    fn: lmx_domain_register (@: LmxArena arena; @: LmxPool pool; @: LmxChunk chunk; @: void lo; size_t: count; size_t: stride; int: kind; int: type) int
    fn: lmx_domain_kind (@: LmxArena arena; @: void p) int
    fn: lmx_domain_type (@: LmxArena arena; @: void p) int
    fn: lmx_domain_known (@: LmxArena arena; @: void p) int
    fn: lmx_implements (@: LmxArena arena; @: void varA; @: void varB; @: void consumer) int
    # The runtime predicate of 2.1: walk the used tree the Consumer IS (its shape gives the used
    # paths -- "the used tree is the contract", and names are absent from ordinary execution, so a
    # path is an index path), and answer over what is AVAILABLE:
    #   every used path present on varA and varB, every leaf of the same domain and type, and
    #   equal METHOD signatures at a callable on a used path.
    # An unset child of the Consumer is not a used path ("An empty `uses` is true: there is
    # nothing to use"), a missing path or a known mismatch is NO, and anything the walk cannot
    # inspect is UNKNOWN -- never YES.
    fn: lmx_runtime_implements (@: LmxArena arena; @: Lmx varA; @: Lmx varB; @: Lmx consumer) int
    # The walk's own two steps, declared here because the walk is recursive and L1 needs a name
    # before its use: the used-tree walk, and the signature comparison at a callable path.
    fn: lmx_implements_walk (@: LmxArena arena; @: Lmx varA; @: Lmx varB; @: Lmx consumer; int: depth) int
    fn: lmx_implements_signature (@: LmxMethod a; @: LmxMethod b; @: LmxMethod c) int
end: prototype
