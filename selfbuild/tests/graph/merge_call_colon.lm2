# A call in an operand of merge is applied once and its result is the operand -- the model's field f does not
# intercept it --; an int result is no Structure, refused (4). Named for its former spelling `f: 3`: since M6 (slice
# 344, the author 2026-11-09: only f(args) calls) the call is written f(3).
M:
    int: f 1
end: M
fn: f (int: x) int (int: calls 0)
    calls: calls + 1
    return: x
end: f
int: r merge(M; f(3))\f
