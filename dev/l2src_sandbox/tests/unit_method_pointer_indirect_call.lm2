# A declared method and a stored method pointer are both callable directly.
# A stored method pointer follows the same call spelling as a method.
fn: tick () int
    return: 7
end: tick
@: ptr tick
int: direct ptr()
int: code 7
if: direct != 7
    code: 81
end: if
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
