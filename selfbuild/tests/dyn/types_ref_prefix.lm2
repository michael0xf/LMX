# Check the stored address and the arena operations on the typed Array header.
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_array_owned.h.lm1"
predef: "l2src/lmx_types.h.lm1"
predef: "l2src/lmx_gc.h.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l2src/lmx_graph.h.lm1"
predef: "l2src/lmx_graph_copy_owned.h.lm1"
include: "<string.h>"
include: "<stdlib.h>"

fn: type_ref_prefix_check () int
    c.LmxArena: arena
    c.LmxArena: other
    c.memset(@ arena, 0, c.sizeof(c.LmxArena))
    c.memset(@ other, 0, c.sizeof(c.LmxArena))
    if: c.lmx_arena_open(@ arena) != 0 || c.lmx_arena_open(@ other) != 0
        return: 100
    ---
    c.LmxArray@: a c.lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_INT, 2U, @ arena)
    c.LmxArray@: b c.lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_INT, 3U, @ arena)
    c.LmxArray@: empty c.lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_INT, 0U, @ other)
    c.Lmx@: type_ref c.lmx_types_reference(@ arena, c.LMX_TYPE_ARRAY_OF_INT)
    c.Lmx@: int_ref c.lmx_types_reference(@ arena, c.LMX_TYPE_INT)
    if: a = 0 || b = 0 || empty = 0 || type_ref = 0 || int_ref = 0 || type_ref = int_ref
        return: 101
    ---
    char@: bytes (cast: (char@) a)
    c.Lmx@@: prefix (cast: (c.Lmx@@) (bytes - sizeof(@)))
    if: prefix[0] != type_ref || c.lmx_types_record_reference(@ arena, a) != type_ref || c.lmx_types_record_reference(@ arena, b) != type_ref || c.lmx_types_record_reference(@ other, empty) != type_ref
        return: 102
    ---
    if: c.lmx_range_type_of(@ arena, type_ref) != 0 - c.LMX_TYPE_STRUCT || c.lmx_range_stride(@ arena, a) != c.sizeof(c.Lmx) || c.lmx_range_cell_pool(@ arena, prefix) != 0
        return: 103
    ---
    # Both descriptions are ordinary graph nodes. The raw prefix is storage.
    if: c.lmx_graph_node_in(@ arena, type_ref) != type_ref || c.lmx_graph_node_in(@ arena, int_ref) != int_ref || c.lmx_graph_node_in(@ arena, prefix) != 0
        return: 104
    ---
    c.LmxGraph@: graph c.lmx_graph_open(@ arena)
    if: graph = 0 || c.lmx_graph_count(type_ref) != 3U || c.lmx_graph_count(int_ref) != 1U
        return: 113
    ---
    @: spelling void c.lmx_graph_get_in(graph, type_ref, 0U)
    @: element void c.lmx_graph_get_in(graph, type_ref, 1U)
    @: rank_value void c.lmx_graph_get_in(graph, type_ref, 2U)
    int: rank 0
    if: c.lmx_range_type_of(@ arena, spelling) != 0 - c.LMX_TYPE_ARRAY_OF_CHAR || element != int_ref || c.lmx_graph_get_in(graph, int_ref, 0U) = 0
        return: 114
    ---
    if: c.lmx_graph_value_int(graph, rank_value, @ rank) != 0 || rank != 1
        return: 115
    ---
    if: c.lmx_graph_write_slot(graph, type_ref, 1U, 0) = 0 || c.lmx_graph_get_in(graph, type_ref, 1U) != int_ref
        return: 116
    ---
    if: c.lmx_graph_assign_int(graph, type_ref, 2U, 2) = 0 || c.lmx_graph_value_int(graph, rank_value, @ rank) != 0 || rank != 1
        return: 118
    ---
    if: c.lmx_graph_close(graph) != 0
        return: 117
    ---
    c.VoidArray@: dense @ b\array
    int@: data (cast: (int@) dense\data)
    if: dense\size != 3U || data = 0 || c.lmx_range_stride(@ arena, data + 1) != c.sizeof(c.int) || c.lmx_types_record_reference(@ arena, data + 1) != 0
        return: 105
    ---
    data[1] := 37
    unsigned: generation c.lmx_arena_generation_next(@ arena)
    if: generation = 0U || c.lmx_gc_mark_value(@ arena, b, generation, 0) != c.LMX_GC_OK || c.lmx_gc_sweep(@ arena, generation) != c.LMX_GC_OK
        return: 106
    ---
    if: data[1] != 37 || c.lmx_types_record_reference(@ arena, b) != type_ref
        return: 107
    ---
    c.Lmx@: copy 0
    if: c.lmx_graph_copy_owned((cast: (c.Lmx@) b), @ arena, @ other, @ copy) != c.LMX_GRAPH_COPY_OK || copy = 0 || copy = (cast: (c.Lmx@) b)
        return: 111
    ---
    c.VoidArray@: copied @ copy\array
    int@: copied_data (cast: (int@) copied\data)
    if: c.lmx_types_record_reference(@ other, copy) != type_ref || copied\size != 3U || copied_data = 0 || copied_data = data || copied_data[1] != 37
        return: 112
    ---
    if: c.lmx_arena_attach(@ other, @ arena) != 0 || c.lmx_arena_release(@ arena) != 0
        return: 110
    ---
    if: c.lmx_types_reference(@ other, c.LMX_TYPE_ARRAY_OF_INT) != type_ref || c.lmx_types_record_reference(@ other, empty) != type_ref || c.lmx_types_record_reference(@ other, b) != type_ref || data[1] != 37
        return: 108
    ---
    size_t@: axes (cast: (size_t@) c.calloc(2U, c.sizeof(c.size_t)))
    if: axes = 0
        return: 119
    ---
    axes[0] := (cast: (size_t) -1)
    axes[1] := (cast: (size_t) -1)
    c.Lmx@: address_array c.lmx_types_composed_reference(@ other, 3U, axes, 2U)
    if: address_array = 0 || c.lmx_types_composed_reference(@ other, 3U, axes, 2U) != address_array
        return: 119
    ---
    @: absent void c.lmx_types_uninit_array(@ other, address_array)
    if: absent = 0 || c.lmx_types_record_reference(@ other, absent) != address_array || c.lmx_range_stride(@ other, absent) != sizeof(@)
        return: 120
    ---
    axes[0] := 2U
    axes[1] := 3U
    c.Lmx@: matrix_type c.lmx_types_composed_reference(@ other, 0U, axes, 2U)
    c.free((cast: (@) axes))
    size_t@: actual_axes 0
    size_t: dimension_count 0U
    size_t: address_depth 0U
    if: matrix_type = 0 || matrix_type = address_array || matrix_type = type_ref || c.lmx_types_reference_parts(@ other, matrix_type, @ actual_axes, @ dimension_count, @ address_depth) != 1
        return: 121
    ---
    if: dimension_count != 2U || address_depth != 0U || actual_axes = 0 || actual_axes[0] != 2U || actual_axes[1] != 3U
        return: 122
    ---
    c.LmxArray@: matrix c.lmx_array_new_int_with_reference(@ other, 0, matrix_type, 6U)
    if: matrix = 0 || c.lmx_types_record_reference(@ other, matrix) != matrix_type
        return: 123
    ---
    if: c.lmx_graph_node_in(@ other, address_array) != address_array || c.lmx_graph_count(address_array) != 5U
        return: 124
    ---
    graph := c.lmx_graph_open(@ other)
    if: graph = 0 || c.lmx_graph_write_slot(graph, address_array, 1U, 0) = 0 || c.lmx_graph_get_in(graph, address_array, 1U) = 0
        return: 125
    ---
    if: c.lmx_graph_close(graph) != 0
        return: 126
    ---
    if: c.lmx_arena_release(@ other) != 0
        return: 109
    ---
    return: 7
end: type_ref_prefix_check
