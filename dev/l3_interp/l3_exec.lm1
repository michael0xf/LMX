predef: "l3_interp/l3_recv.h.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l2src/lmx_own.h.lm1"
predef: "l2src/lmx_own.lm1"
predef: "l2src/lmx_interp.h.lm1"
predef: "l2src/lmx_implements.h.lm1"
predef: "l2src/lmx_value_owned.h.lm1"
predef: "l3_interp/l3_path.lm1"
include: "<stdlib.h>"

@: Lmx l3_subject 0
int: l3_last_int 0
int: l3_has_ret 0

# L3-02 N4-N8. return: encoded as LmxOp RETURN in the body, not ISA 3-14.
# Never execute METHOD.addr.

define: L3_OWN_CAP 32

prototype:
    fn: l3_exec_stmt (@: LmxArena arena; @: Lmx node; @: void v; @: LmxOwnLocal owns; int: nown) int
    fn: l3_exec_range (@: LmxArena arena; @: Lmx node; size_t: from; @: LmxOwnLocal owns; int: nown) int
    fn: l3_exec_op (@: LmxArena arena; @: Lmx host; @: LmxOp op; @: LmxOwnLocal owns; int: nown) int
    fn: l3_cond_int (@: LmxArena arena; @: void v; @: int out) int
    fn: l3_own_load_ints (@: LmxArena arena; @: Lmx node; @: LmxOwnLocal owns; @: int nown) int
    fn: l3_own_checkpoint_all (@: LmxOwnLocal owns; int: nown) int
end: prototype

fn: l3_own_load_ints (@: LmxArena arena; @: Lmx node; @: LmxOwnLocal owns; @: int nown) int
    size_t: i
    @: void v
    \nown: 0
    if: arena = 0 || node = 0 || owns = 0
        return: 1
    i: 1U
    while: i < (cast: (size_t) node\len) && \nown < c.L3_OWN_CAP
        v: lmx_arena_ref_value(node, i)
        if: v != 0 && lmx_domain_kind(arena, v) = c.LMX_KIND_PRIMITIVE
            if: lmx_domain_type(arena, v) = c.LMX_TYPE_INT
                if: lmx_own_load(@ owns[\nown], node, i) != 0
                    return: 1
                \nown: \nown + 1
            ---
        ---
        i: i + 1U
    ---
return: 0

fn: l3_own_checkpoint_all (@: LmxOwnLocal owns; int: nown) int
    int: i 0
    while: i < nown
        if: lmx_own_checkpoint(@ owns[i]) != 0
            return: 1
        i: i + 1
    ---
return: 0

fn: l3_cond_int (@: LmxArena arena; @: void v; @: int out) int
    if: v = 0
        return: c.L3_ABSENT
    if: lmx_domain_kind(arena, v) != c.LMX_KIND_PRIMITIVE
        return: c.L3_UNSUPPORTED
    if: lmx_domain_type(arena, v) != c.LMX_TYPE_INT
        return: c.L3_UNSUPPORTED
    \out: lmx_int_value_known(v)
return: c.L3_OK

fn: l3_exec_op (@: LmxArena arena; @: Lmx host; @: LmxOp op; @: LmxOwnLocal owns; int: nown) int
    int: code
    int: st
    int: cond 0
    int: n 0
    @: void body
    if: op = 0
        return: c.L3_INVALID
    code: op\code
    if: code = c.L3_NODE_RETURN
        size_t: ai
        @: void arg
        int: rst
        l3_has_ret: 0
        if: host != 0
            ai: 1U
            while: ai < (cast: (size_t) host\len)
                arg: lmx_arena_ref_value(host, ai)
                rst: l3_exec_stmt(arena, host, arg, owns, nown)
                if: rst != c.L3_OK
                    return: rst
                if: arg != 0 && lmx_domain_kind(arena, arg) = c.LMX_KIND_PRIMITIVE
                    if: lmx_domain_type(arena, arg) = c.LMX_TYPE_INT
                        l3_last_int: lmx_int_value_known(arg)
                        l3_has_ret: 1
                    ---
                ---
                ai: ai + 1U
            ---
        ---
        if: l3_own_checkpoint_all(owns, nown) != 0
            return: c.L3_INVALID
        return: c.L3_RETURN
    ---
    if: code = c.L3_NODE_MATCH || code = c.L3_NODE_EACH || code = c.L3_NODE_YIELD || code = c.L3_NODE_FINALLY || code = c.L3_NODE_THROW
        return: c.L3_UNSUPPORTED
    ---
    if: code = c.L3_NODE_EXPECT_INT
        @: void leaf 0
        @: void want
        @: Lmx path
        if: l3_subject = 0
            return: c.L3_UNSUPPORTED
        if: host = 0 || host\len < 3
            return: c.L3_INVALID
        if: lmx_domain_kind(arena, lmx_arena_ref_value(host, 1U)) != c.LMX_KIND_STRUCT
            return: c.L3_UNSUPPORTED
        path: (cast: (@: Lmx) lmx_arena_ref_value(host, 1U))
        st: l3_path_leaf(arena, l3_subject, path, @ leaf)
        if: st != c.L3_OK
            return: st
        want: lmx_arena_ref_value(host, 2U)
        if: leaf = 0 || want = 0
            return: c.L3_ABSENT
        if: lmx_domain_type(arena, leaf) != c.LMX_TYPE_INT
            return: c.L3_ABSENT
        if: lmx_int_value_known(leaf) != lmx_int_value_known(want)
            return: c.L3_ABSENT
        return: c.L3_OK
    ---
    if: host = 0
        return: c.L3_INVALID
    if: code = c.L3_NODE_IF
        if: host\len < 3
            return: c.L3_INVALID
        st: l3_cond_int(arena, lmx_arena_ref_value(host, 1U), @ cond)
        if: st != c.L3_OK
            return: st
        if: cond != 0
            return: l3_exec_stmt(arena, host, lmx_arena_ref_value(host, 2U), owns, nown)
        if: host\len > 3
            return: l3_exec_stmt(arena, host, lmx_arena_ref_value(host, 3U), owns, nown)
        return: c.L3_OK
    ---
    if: code = c.L3_NODE_WHILE
        if: host\len < 3
            return: c.L3_INVALID
        body: lmx_arena_ref_value(host, 2U)
        while: n < c.L3_WHILE_CAP
            st: l3_cond_int(arena, lmx_arena_ref_value(host, 1U), @ cond)
            if: st != c.L3_OK
                return: st
            if: cond = 0
                return: c.L3_OK
            st: l3_exec_stmt(arena, host, body, owns, nown)
            if: st = c.L3_RETURN
                return: c.L3_RETURN
            if: st != c.L3_OK
                return: st
            n: n + 1
        ---
        return: c.L3_UNSUPPORTED
    ---
return: c.L3_UNSUPPORTED

fn: l3_exec_stmt (@: LmxArena arena; @: Lmx node; @: void v; @: LmxOwnLocal owns; int: nown) int
    @: Lmx host
    @: void head
    @: LmxOp op
    int: hk
    int: kind
    if: v = 0
        return: c.L3_ABSENT
    kind: lmx_domain_kind(arena, v)
    if: kind = c.LMX_KIND_PRIMITIVE
        return: c.L3_OK
    if: kind = c.LMX_DOMAIN_KIND_OP
        return: l3_exec_op(arena, 0, (cast: (@: LmxOp) v), owns, nown)
    ---
    if: kind = c.LMX_KIND_STRUCT
        host: (cast: (@: Lmx) v)
        if: host\len < 1
            return: c.L3_OK
        head: lmx_arena_ref_value(host, 0U)
        if: head = 0
            return: c.L3_OK
        hk: lmx_domain_kind(arena, head)
        if: hk = c.LMX_DOMAIN_KIND_OP
            return: l3_exec_op(arena, host, (cast: (@: LmxOp) head), owns, nown)
        if: hk = c.LMX_DOMAIN_KIND_CALLABLE
            return: l3_exec_run(arena, host)
        if: hk = c.LMX_KIND_METHOD
            return: c.L3_UNSUPPORTED
        return: l3_exec_range(arena, host, 0U, owns, nown)
    ---
    if: kind = c.LMX_DOMAIN_KIND_CALLABLE
        return: c.L3_OK
    if: kind = c.LMX_KIND_METHOD
        return: c.L3_UNSUPPORTED
return: c.L3_UNSUPPORTED

fn: l3_exec_range (@: LmxArena arena; @: Lmx node; size_t: from; @: LmxOwnLocal owns; int: nown) int
    size_t: i
    int: st
    if: node = 0
        return: c.L3_INVALID
    i: from
    while: i < (cast: (size_t) node\len)
        st: l3_exec_stmt(arena, node, lmx_arena_ref_value(node, i), owns, nown)
        if: st = c.L3_RETURN
            return: c.L3_RETURN
        if: st != c.L3_OK
            return: st
        i: i + 1U
    ---
return: c.L3_OK

fn: l3_exec_run (@: LmxArena arena; @: Lmx node) int
return: l3_exec_run_on(arena, node, 0)

fn: l3_exec_run_on (@: LmxArena arena; @: Lmx node; @: Lmx subject) int
    @: LmxOwnLocal owns 0
    int: nown 0
    int: st
    @: void head
    int: hk
    @: Lmx prev
    prev: l3_subject
    l3_subject: subject
    l3_has_ret: 0
    owns: (cast: (@: LmxOwnLocal) calloc(32U, c.sizeof(c.LmxOwnLocal)))
    if: arena = 0 || node = 0 || owns = 0
        l3_subject: prev
        if: owns != 0
            free((cast: (@: void) owns))
        ---
        return: c.L3_INVALID
    if: lmx_domain_kind(arena, (cast: (@: void) node)) != c.LMX_KIND_STRUCT
        l3_subject: prev
        free((cast: (@: void) owns))
        return: c.L3_UNSUPPORTED
    if: node\len < 1
        l3_subject: prev
        free((cast: (@: void) owns))
        return: c.L3_UNSUPPORTED
    head: lmx_arena_ref_value(node, 0U)
    if: head = 0
        l3_subject: prev
        free((cast: (@: void) owns))
        return: c.L3_UNSUPPORTED
    hk: lmx_domain_kind(arena, head)
    if: hk = c.LMX_KIND_METHOD
        l3_subject: prev
        free((cast: (@: void) owns))
        return: c.L3_UNSUPPORTED
    if: hk != c.LMX_DOMAIN_KIND_CALLABLE
        l3_subject: prev
        free((cast: (@: void) owns))
        return: c.L3_UNSUPPORTED
    if: l3_own_load_ints(arena, node, owns, @ nown) != 0
        l3_subject: prev
        free((cast: (@: void) owns))
        return: c.L3_INVALID
    st: l3_exec_range(arena, node, 1U, owns, nown)
    l3_subject: prev
    free((cast: (@: void) owns))
    if: st = c.L3_RETURN
        return: c.L3_OK
return: st

fn: l3_returned_int () int
return: l3_last_int

fn: l3_returned_present () int
return: l3_has_ret
