---
    Observed:
        int: result 84
    end: Observed
---
fn: outer () int (
    int: base 1
    int: total 0
)
    L2:
        int: inner 40
        :=: base (inner + 2)
    end: L2
    :=: total (base * 2)
    return: total
end: outer
int: result (outer)
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ result) result
end: main
main:
