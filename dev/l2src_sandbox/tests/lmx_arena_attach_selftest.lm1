predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_thread.h.lm1"
predef: "l2src/lmx_primitive.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# Attaching another arena (Mikhail, 2026-09-17, verbatim: "У нас есть арена (там менеджер)
# ... также может присоединять другую арену"; "Если во время работы к арене присоединяется
# другая -- увеличиваем просто число массивов и не паримся, чтобы ареса не переезжали").
#
# What this file pins, and each one is the reason attaching is an act of its own:
#
#   * nothing moves -- every address that answered before the attach answers after it,
#     with the same kind, the same type and the very same descriptor;
#   * the attaching arena answers for both: its list of its N arrays holds the attached
#     arrays too, and its index names the attached intervals;
#   * the attached arena is left EMPTY: no entries, no arrays, no blocks, no index;
#   * the storage is one arena's after the attach, so releasing the destination releases
#     what the attached arena used to own -- nothing is leaked and nothing is double-freed.

sub: attach_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: attach_check

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: keep
    LmxArena: give
    LmxArena: bounded_keep
    LmxArena: bounded_give
    LmxArena: copy_view
    # A by-value arena is read through a pointer of its own: L1 emits `->` for `\`, and
    # the address of a by-value field is not expressible.
    @: LmxArena keep_at
    @: LmxArena give_at
    @: char table 0
    @: void int_cell 0
    @: Lmx node 0
    @: LmxThread method 0
    @: LmxPrimitive arena_primitive 0
    @: LmxPrimitive subject_primitive 0
    @: LmxPrimitive refused_primitive 0
    @: void slot_base 0
    @: LmxPool pool_before 0
    @: LmxPool pool_after 0
    @@: void kept_cells 0
    @: void given_first 0
    @: void given_second 0
    @: void mutable_cell 0
    size_t: i
    size_t: before_len
    int: failures
    if: counts = 0
        return: 2
    memset((cast: (@: void) (@ keep)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ give)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ bounded_keep)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ bounded_give)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ copy_view)), 0, c.sizeof(c.LmxArena))
    keep_at: @ keep
    give_at: @ give
    if: lmx_arena_open(@ keep) != 0 || lmx_arena_open(@ give) != 0
        fputs("lmx: arena open failed\n", l1_stdout())
        free(counts)
        return: 2
    ---

    # Two arenas, each with its own arrays.  Every address below is asked about again
    # after the attach.
    table: lmx_chars_new_owned(@ keep)
    int_cell: lmx_int_new_owned(@ keep)
    lmx_int_store_known(int_cell, 4242)
    node: lmx_node_new_owned(@ give)
    # k.4: LmxMethod is gone -- any other registered record type is an equally good
    # exemplar for "an attached child of arbitrary shape still classifies"; LmxThread is
    # already used this way in sibling files (lmx_thread_prefix_selftest.lm1 and others).
    method: (cast: (@: LmxThread) lmx_arena_take(@ give, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD))
    arena_primitive: (cast: (@: LmxPrimitive) lmx_arena_take(@ give, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))
    subject_primitive: (cast: (@: LmxPrimitive) lmx_arena_take(@ give, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))
    if: arena_primitive != 0 && subject_primitive != 0
        arena_primitive\owner: (cast: (@: Lmx) (@ give))
        subject_primitive\owner: node
    ---
    attach_check(counts, table != 0 && int_cell != 0 && node != 0 && method != 0 && arena_primitive != 0 && subject_primitive != 0, "both arenas built their own arrays")
    if: lmx_arena_refs_open_owned(@ give, node, 2U) != 0
        fputs("lmx: the structure's child array was not opened\n", l1_stdout())
        free(counts)
        return: 2
    ---
    slot_base: node\array.data
    pool_before: lmx_range_pool(@ give, slot_base)
    attach_check(counts, pool_before != 0, "the child array answers before the attach")
    attach_check(counts, lmx_arena_index_len(keep_at) > 0U && lmx_arena_index_len(give_at) > 0U, "each arena holds entries of its own")

    # The act.
    attach_check(counts, lmx_arena_attach(@ keep, @ give) = 0, "the arena attached")
    attach_check(counts, give_at\blocks = 0 && give_at\arrays = 0, "the attached arena holds no storage and no arrays")
    attach_check(counts, lmx_arena_index_data(give_at) = 0 && lmx_arena_index_len(give_at) = 0U && lmx_arena_index_cap(give_at) = 0U, "the attached arena holds no index and no entries")
    attach_check(counts, lmx_arena_index_len(keep_at) > 0U, "the destination kept the entries")

    # Nothing moved: every address answers through the destination, with the very same
    # kind, type and descriptor.
    attach_check(counts, lmx_range_classify(@ keep, (cast: (@: void) table)) = c.LMX_KIND_PRIMITIVE, "the character table still classifies")
    attach_check(counts, lmx_range_type_of(@ keep, (cast: (@: void) table)) = c.LMX_TYPE_CHAR, "the character table kept its type")
    attach_check(counts, lmx_range_type_of(@ keep, int_cell) = c.LMX_TYPE_INT, "the int cell kept its type")
    attach_check(counts, lmx_range_classify(@ keep, (cast: (@: void) node)) = c.LMX_KIND_STRUCT, "the attached structure still classifies")
    attach_check(counts, lmx_range_classify(@ keep, (cast: (@: void) method)) = c.LMX_DOMAIN_KIND_MSG_RECORD, "the attached generic record still classifies")
    attach_check(counts, arena_primitive\owner = (cast: (@: Lmx) (@ keep)) && subject_primitive\owner = node, "attach rehomes only the donor-arena primitive owner")
    attach_check(counts, lmx_range_classify(@ keep, slot_base) = c.LMX_KIND_CHILDREN, "the attached child array still classifies")
    pool_after: lmx_range_pool(@ keep, slot_base)
    attach_check(counts, pool_after = pool_before, "the entry names the very same descriptor")
    attach_check(counts, lmx_arena_find(@ keep, c.LMX_KIND_CHILDREN, c.LMX_TYPE_REFS) = pool_before, "the destination's array list holds the attached array")

    # Living storage, not just classification: a write through an address taken before
    # the attach still reaches its cell.
    lmx_int_store_known(int_cell, 77)
    attach_check(counts, lmx_int_value_known(int_cell) = 77, "a cell taken before the attach is still writable")
    attach_check(counts, lmx_arena_ref_store(node, 0U, (cast: (@: void) method)) = 0, "the attached structure's slots still accept children")
    attach_check(counts, lmx_arena_ref_value(node, 0U) = (cast: (@: void) method), "the child reads back")

    # One owner: releasing the destination releases what both arenas held.
    attach_check(counts, lmx_arena_release(@ keep) = 0, "the destination released everything")
    attach_check(counts, keep_at\blocks = 0 && keep_at\arrays = 0 && lmx_arena_index_data(keep_at) = 0 && lmx_arena_index_len(keep_at) = 0U, "the destination is empty after release")

    # A simple destination can grow to 32 intervals. Two donor intervals
    # cannot fit after 31 local ones: the refusal must not remove any
    # pre-existing row of the address-sorted destination index.
    kept_cells: (cast: (@@: void) calloc(31U, c.sizeof(@: void)))
    attach_check(counts, kept_cells != 0 && lmx_arena_open(@ bounded_give) = 0 && lmx_arena_open_simple(@ bounded_keep) = 0, "bounded attach arenas open")
    # These synthetic scalar types exercise interval capacity, not pointer
    # representation: keep their IDs below the reserved pointer domain.
    given_first: lmx_arena_take(@ bounded_give, c.sizeof(int), c.LMX_KIND_PRIMITIVE, 500)
    given_second: lmx_arena_take(@ bounded_give, c.sizeof(int), c.LMX_KIND_PRIMITIVE, 501)
    refused_primitive: (cast: (@: LmxPrimitive) lmx_arena_take(@ bounded_give, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))
    if: refused_primitive != 0
        refused_primitive\owner: (cast: (@: Lmx) (@ bounded_give))
    ---
    i: 0U
    while: i < 31U
        kept_cells[i]: lmx_arena_take(@ bounded_keep, c.sizeof(int), c.LMX_KIND_PRIMITIVE, (cast: (int) (600U + i)))
        attach_check(counts, kept_cells[i] != 0, "bounded destination cell allocated")
        i: i + 1U
    ---
    before_len: lmx_arena_index_len(@ bounded_keep)
    attach_check(counts, given_first != 0 && given_second != 0 && refused_primitive != 0 && before_len = 31U && lmx_arena_index_len(@ bounded_give) = 3U, "bounded attach starts from 31 plus three intervals")
    attach_check(counts, lmx_arena_attach(@ bounded_keep, @ bounded_give) != 0 && lmx_arena_index_len(@ bounded_keep) = before_len && lmx_arena_index_len(@ bounded_give) = 3U && refused_primitive\owner = (cast: (@: Lmx) (@ bounded_give)), "capacity refusal preserves the donor's primitive owner and sorted index")
    i: 0U
    while: i < 31U
        attach_check(counts, lmx_range_classify(@ bounded_keep, kept_cells[i]) = c.LMX_KIND_PRIMITIVE, "capacity refusal preserves each old destination interval")
        i: i + 1U
    ---
    attach_check(counts, lmx_range_classify(@ bounded_give, given_first) = c.LMX_KIND_PRIMITIVE && lmx_range_classify(@ bounded_give, given_second) = c.LMX_KIND_PRIMITIVE, "capacity refusal preserves donor ownership")
    attach_check(counts, lmx_arena_release(@ bounded_keep) = 0 && lmx_arena_release(@ bounded_give) = 0, "bounded attach arenas release independently")
    free((cast: (@: void) kept_cells))

    attach_check(counts, lmx_arena_open(@ bounded_keep) = 0 && lmx_arena_open(@ bounded_give) = 0 && lmx_arena_open_source_view(@ copy_view) = 0, "ordinary arenas and scratch copy view open")
    mutable_cell: lmx_arena_take(@ bounded_give, c.sizeof(int), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT)
    attach_check(counts, mutable_cell != 0 && lmx_range_import(@ bounded_keep, @ bounded_give) = 0 && lmx_range_classify(@ bounded_keep, mutable_cell) = c.LMX_KIND_NONE, "ordinary import does not expose mutable foreign cell")
    attach_check(counts, lmx_range_import_source_view(@ bounded_keep, @ bounded_give) != 0 && lmx_range_import_source_view(@ copy_view, @ bounded_give) = 0 && lmx_range_classify(@ copy_view, mutable_cell) = c.LMX_KIND_PRIMITIVE && lmx_range_home(@ copy_view, mutable_cell) = (@ bounded_give), "copy view classifies mutable source without taking ownership")
    attach_check(counts, lmx_arena_take(@ copy_view, c.sizeof(int), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT) = 0 && lmx_arena_attach(@ bounded_keep, @ copy_view) != 0 && lmx_arena_attach(@ copy_view, @ bounded_give) != 0, "copy view cannot allocate or transfer ownership")
    attach_check(counts, lmx_arena_release(@ copy_view) = 0 && lmx_range_classify(@ bounded_give, mutable_cell) = c.LMX_KIND_PRIMITIVE, "releasing copy view leaves true owner intact")
    attach_check(counts, lmx_arena_release(@ bounded_keep) = 0 && lmx_arena_release(@ bounded_give) = 0, "source-view witness arenas release")

    failures: counts[1]
    c.printf("arena attach checks=%d failures=%d\n", counts[0], failures)
    free(counts)
return: failures != 0
