predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/tests/walk_contract_fixture.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_primitive.h.lm1"
predef: "l2src/lmx_merge_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<string.h>"

# A builder role table can disappear. New executable OP records belong to the
# graph's own arena, including source-role changes and qualified construction.
fn: main () int
    LmxArena: source
    LmxArena: source2
    LmxArena: destination
    @: Lmx roles 0
    @: Lmx parent 0
    @: Lmx first 0
    @: Lmx second 0
    @: Lmx executable 0
    @: Lmx literal 0
    @: Lmx data_parent 0
    @: Lmx data_method 0
    @: Lmx data_expr 0
    @: Lmx data_array_at 0
    @: Lmx data_index_at 0
    @: Lmx data_copy 0
    @: VoidArray data_array 0
    @: void data_index 0
    @: void data_unused 0
    LmxCopyMap: copy_pending
    int: copy_status 0
    @: void head 0
    @: void original_head 0
    size_t: ranges_before 0U
    int: checks 0
    int: failures 0
    memset((cast: (@: void) (@ source)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ destination)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ source) != 0 || lmx_arena_open(@ destination) != 0
        return: 2
    roles: lmx_walk_roles_open(@ source)
    parent: lmx_node_new_owned(@ destination)
    if: roles = 0 || parent = 0 || lmx_arena_refs_open_owned(@ destination, parent, 2U) != 0
        return: 2
    first: lmx_walk_frame_profiled(@ destination, roles, parent, c.LMX_WALK_OP_SET, 3U, 0)
    if: first = 0
        return: 2
    head: lmx_arena_ref_value(first, 0U)
    original_head: head
    checks: checks + 1
    if: first = 0 || head = 0 || lmx_walk_code_in(@ destination, head) != c.LMX_WALK_OP_SET || head = lmx_arena_ref_value(roles, (cast: (size_t) c.LMX_WALK_OP_SET))
        failures: failures + 1
        c.printf("FAIL cross-arena OP belongs to the destination\n")
    ---
    if: first = 0 || lmx_arena_ref_store(parent, 0U, (cast: (@: void) first)) != 0
        return: 2
    lmx_arena_release(@ source)
    checks: checks + 1
    if: lmx_walk_source_mark(@ destination, roles, first, c.LMX_WALK_SOURCE_RECEIVING) != 0
        failures: failures + 1
        c.printf("FAIL source role is rewritten without its builder arena\n")
    ---
    head: lmx_arena_ref_value(first, 0U)
    checks: checks + 1
    if: head != original_head || lmx_walk_code_in(@ destination, head) != c.LMX_WALK_SOURCE_RECEIVING * c.LMX_WALK_OP_COUNT + c.LMX_WALK_OP_SET
        failures: failures + 1
        c.printf("FAIL source mark updates the same typed OP in the destination\n")
    ---
    second: lmx_walk_frame_profiled(@ destination, roles, parent, c.LMX_WALK_OP_RET, 2U, 0)
    if: second = 0
        return: 2
    checks: checks + 1
    if: lmx_walk_code_in(@ destination, lmx_arena_ref_value(second, 0U)) != c.LMX_WALK_OP_RET
        failures: failures + 1
        c.printf("FAIL constructor ignores a released role table\n")
    ---
    if: second = 0 || lmx_arena_ref_store(parent, 1U, (cast: (@: void) second)) != 0
        return: 2
    # The only role table was in `source`, which is already released. The
    # callable executes from its own typed OP without rebuilding a vocabulary
    # in the destination arena or consulting the old builder address.
    executable: lmx_node_new_owned(@ destination)
    if: executable = 0 || lmx_arena_refs_open_owned(@ destination, executable, 1U) != 0
        return: 2
    literal: lmx_walk_frame_profiled(@ destination, roles, executable, c.LMX_WALK_OP_LIT, 2U, 0)
    if: literal = 0 || lmx_walk_store_int(@ destination, literal, 1U, 7) != c.LMX_WALK_OK || lmx_arena_ref_store(executable, 0U, (cast: (@: void) literal)) != 0
        return: 2
    lmx_walk_program_bind(0)
    ranges_before: lmx_arena_index_len(@ destination)
    checks: checks + 1
    if: lmx_call0(@ destination, executable) != 7
        failures: failures + 1
        c.printf("FAIL copied code cannot execute after the builder arena is released\n")
    ---
    checks: checks + 1
    if: lmx_arena_index_len(@ destination) != ranges_before
        failures: failures + 1
        c.printf("FAIL dispatch allocated a replacement builder role table\n")
    ---
    # A runtime ELEM index comes from an AT of the lexical parent, not from a
    # constant embedded in ELEM. The saved AT records prove the two parent
    # slots used by this body. Their cells and the array backing must survive
    # the source arena's release; the unrelated parent slot stays absent.
    memset((cast: (@: void) (@ source2)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ copy_pending)), 0, c.sizeof(c.LmxCopyMap))
    if: lmx_arena_open(@ source2) != 0
        return: 2
    ---
    data_parent: lmx_node_new_owned(@ source2)
    data_array: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_INT, 3U, @ source2)
    data_index: lmx_size_new_owned(@ source2)
    data_unused: lmx_int_new_owned(@ source2)
    if: data_parent = 0 || data_array = 0 || data_index = 0 || data_unused = 0 || lmx_arena_refs_open_owned(@ source2, data_parent, 4U) != 0
        return: 2
    ---
    lmx_int_store_known((cast: (@: void) ((cast: (@: char) data_array\data) + c.sizeof(c.int))), 20)
    lmx_size_store_known(data_index, 1U)
    lmx_int_store_known(data_unused, 99)
    data_method: lmx_walk_plain(@ source2, data_parent, 1U)
    data_expr: lmx_walk_frame(@ source2, 0, data_method, c.LMX_WALK_OP_ELEM, 3U)
    data_array_at: lmx_walk_frame(@ source2, 0, data_expr, c.LMX_WALK_OP_AT, 3U)
    data_index_at: lmx_walk_frame(@ source2, 0, data_expr, c.LMX_WALK_OP_AT, 3U)
    if: data_method = 0 || data_expr = 0 || data_array_at = 0 || data_index_at = 0 || lmx_arena_ref_store(data_parent, 0U, (cast: (@: void) data_array)) != 0 || lmx_arena_ref_store(data_parent, 1U, data_index) != 0 || lmx_arena_ref_store(data_parent, 2U, (cast: (@: void) data_method)) != 0 || lmx_arena_ref_store(data_parent, 3U, data_unused) != 0 || lmx_arena_ref_store(data_method, 0U, (cast: (@: void) data_expr)) != 0 || lmx_arena_ref_store(data_expr, 1U, (cast: (@: void) data_array_at)) != 0 || lmx_arena_ref_store(data_expr, 2U, (cast: (@: void) data_index_at)) != 0 || lmx_arena_ref_store(data_array_at, 1U, (cast: (@: void) data_parent)) != 0 || lmx_arena_ref_store(data_index_at, 1U, (cast: (@: void) data_parent)) != 0 || lmx_walk_store_size(@ source2, data_array_at, 2U, 0U) != c.LMX_WALK_OK || lmx_walk_store_size(@ source2, data_index_at, 2U, 1U) != c.LMX_WALK_OK
        return: 2
    ---
    copy_status: lmx_graph_copy_many_used_staged(@ data_method, 1U, @ source2, @ destination, 0, 0U, 0, 0, 0, 0, 0, 0U, 0U, @ data_copy, @ copy_pending)
    checks: checks + 1
    if: copy_status != LMX_GRAPH_COPY_OK || data_copy = 0 || data_copy\parent = 0 || data_copy\parent = data_parent
        failures: failures + 1
        c.printf("FAIL dynamic ELEM body and lexical parent copied\n")
    ---
    if: copy_status = LMX_GRAPH_COPY_OK && data_copy != 0 && data_copy\parent != 0
        checks: checks + 1
        if: lmx_arena_ref_value(data_copy\parent, 0U) = (cast: (@: void) data_array) || lmx_arena_ref_value(data_copy\parent, 1U) = data_index || lmx_arena_ref_value(data_copy\parent, 2U) != (cast: (@: void) data_copy) || lmx_arena_ref_value(data_copy\parent, 3U) != 0
            failures: failures + 1
            c.printf("FAIL dynamic ELEM copied only its two lexical inputs\n")
        ---
    ---
    lmx_copy_names_finish(@ copy_pending, (cast: (int) (copy_status = LMX_GRAPH_COPY_OK)))
    lmx_arena_release(@ source2)
    checks: checks + 1
    if: copy_status != LMX_GRAPH_COPY_OK || lmx_call0(@ destination, data_copy) != 20
        failures: failures + 1
        c.printf("FAIL copied dynamic ELEM executes after source arena release\n")
    ---
    lmx_arena_release(@ destination)
    c.printf("lmx_walk_cross_arena_op: %d checks, %d failures\n", checks, failures)
    if: failures != 0
        return: 1
return: 0
