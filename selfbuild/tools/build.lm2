end: decl_thread

# Declaration-only engine wrapper: algorithms are ordinary L2 bodies.
# The two inherited root-span globals remain explicit debt, not a hidden context.
fn: decl_walk_engine (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx_walk.h.lm1\"\npredef: \"l2src/lmx_walk_state_decl.lm1\"\npredef: \"l2src/lmx_call.h.lm1\"\npredef: \"l2src/lmx_implements.h.lm1\"\npredef: \"l2src/lmx_range.lm1\"\npredef: \"l2src/lmx_arena_refs.lm1\"\npredef: \"l2src/lmx_value_owned.lm1\"\npredef: \"l2src/lmx_array_owned.h.lm1\"\npredef: \"l2src/lmx_chars.lm1\"\n# Inherited program state; declaration generation does NOT remove its ambient-state debt.\n@@: Lmx lmx_walk_program_roots_g 0\nsize_t: lmx_walk_program_root_count_g 0U\npredef: \"l2src/lmx_walk_values.lm1\"\npredef: \"l2src/lmx_scratch.lm1\"\npredef: \"l2src/lmx_primitive.h.lm1\"\npredef: \"l2src/lmx_source_names.h.lm1\"\npredef: \"l1src/libc_abi.lm1\"\ninclude: \"<stdio.h>\" \"<string.h>\" \"<limits.h>\"\n\n", f) < 0
        return: 1
    if: c.fputs("prototype:\n    fn: lmx_walk_call0_dispatch (@: LmxArena arena; @: Lmx callable; @: int value) int\n    fn: lmx_walk_call_prim_dispatch (@: LmxArena arena; @: Lmx code; @: Lmx data; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n    fn: lmx_walk_callable_addr (@: LmxArena arena; @: Lmx node) LmxEntry\n    fn: lmx_walk_empty (@: LmxWalkFrame f; @: Lmx code; @: LmxWalkValue out) int\n    fn: lmx_walk_data_holder (@: LmxWalkFrame f; @: void holder) @: void\n    fn: lmx_walk_body (@: LmxWalkFrame f; @: Lmx body; size_t: first) int\n    fn: lmx_walk_admit_against (@: LmxArena arena; @: Lmx value; @: Lmx model; @@: void out) int\n    fn: lmx_walk_admit_op (@: LmxWalkFrame f; @: Lmx code; @: LmxWalkValue out) int\n    fn: lmx_walk_admit_in (@: LmxWalkFrame f; @: Lmx receiver; @: Lmx code; @: LmxWalkValue out) int\n    fn: lmx_walk_source_of (@: LmxWalkFrame f; @: Lmx code) int\n    fn: lmx_walk_model_operand (@: LmxWalkFrame f; @: void operand; @@: Lmx out) int\n    fn: lmx_walk_admit_resolve (@: LmxArena arena; @: void raw; @@: void out_value) int\n    fn: lmx_walk_immutable (@: LmxWalkFrame f; @: void p) int\n    fn: lmx_walk_array_from (@: LmxWalkFrame f; @: void node; int: write; @@: LmxArray out) int\n    fn: lmx_walk_array_elem_meta (int: type; @: int elem; @: size_t stride) int\n    fn: lmx_walk_index (@: LmxWalkFrame f; @: void node; @: size_t out) int\n    fn: lmx_walk_fault (@: LmxWalkFrame f) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_walk_engine

# Forward declarations of the SAME inherited objects, not new storage.
# Ordinary-unit extern emission precedes machine bodies; header emission does not.
fn: decl_walk_state_decl (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx_walk.h.lm1\"\nextern: @@: Lmx lmx_walk_program_roots_g\nextern: size_t: lmx_walk_program_root_count_g\n", f) < 0
        return: 1
    return: 0
end: decl_walk_state_decl

fn: decl_thread_state (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx_thread.h.lm1\"\nthread_local: @: LmxThread lmx_thread_current_slot 0\n", f) < 0
        return: 1
    return: 0
end: decl_thread_state

# One header written whole at path: kind 0 lmx.h.lm1, 1 lmx_arena_blocks.h.lm1, 2 lmx_arena.h.lm1, 3
# lmx_implements.h.lm1, 4 lmx_scratch.h.lm1, 5 lmx_implements_resolve.h.lm1, 6 lmx_source_names.h.lm1, 7 lmx_post.h.lm1,
# 8 lmx_graph_copy_owned.h.lm1, 9 lmx_merge_owned.h.lm1, 10 lmx_call.h.lm1, 11 lmx_clock.h.lm1,
# 12 lmx_process_deadline.h.lm1, 13 lmx_schedule.h.lm1, 14 lmx_gc.h.lm1, 15 lmx_service.h.lm1,
# 16 lmx_manager.h.lm1, 17 lmx_manager_running.h.lm1, 18 lmx_turn.h.lm1, 19 lmx_settle.h.lm1,
# 20 lmx_child.h.lm1, 21 lmx_orphan.h.lm1, 22 lmx_reparent.h.lm1.
