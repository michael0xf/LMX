Example:
    char[]: text
    return: @
    run:
        throws: copy(sys\resize\throws)
        int: at 0
        while: at < length(text) && Ascii\letter(text[at]) != 0
            at += 1
        if: at = 0 || at = length(text) || text[at] != '='
            return: (0; ""; "")
        int: begin at + 1
        if: begin = length(text)
            return: (0; ""; "")
        char[]: key []
        char[]: value []
        sys\resize(key; at)
        sys\resize(value; length(text) - begin)
        int: i 0
        while: i < at
            key[i] := text[i]
            i += 1
        i := begin
        while: i < length(text)
            if: text[i] < '0' || text[i] > '9'
                return: (0; ""; "")
            value[i - begin] := text[i]
            i += 1
        return: (1; key; value)
