predef: "l2src/lmx_gc.h.lm1"
predef: "l2src/lmx_value_owned.h.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_source_names.h.lm1"
predef: "l2src/lmx_implements.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdlib.h>"

# Physical graph mark/sweep shared by the Thread collector and graph clients.
# Array and ordinary Structure use one Lmx-header traversal. Thread/mail roots
# are selected by lmx_gc.lm1; they do not change this traversal's representation.

# The worse of two statuses: a pass reports the first thing that went wrong, not the last.
fn: lmx_gc_note (int: a; int: b) int
    if: a != c.LMX_GC_OK
        return: a
return: b

# Is this chunk a bag of VALUES rather than of references?  Scalar primitive domains
# are; pointer domains are read through their physical pool contract below.
fn: lmx_gc_scalar (@: LmxPool pool) int
    if: pool = 0
        return: 0
    if: pool\kind != c.LMX_KIND_PRIMITIVE
        return: 0
    if: pool\type = c.LMX_TYPE_CHAR || pool\type = c.LMX_TYPE_UNSIGNED_CHAR
        return: 1
    if: pool\type = c.LMX_TYPE_INT || pool\type = c.LMX_TYPE_UNSIGNED
        return: 1
    if: pool\type = c.LMX_TYPE_SIZE_T || pool\type = c.LMX_TYPE_ULONG
        return: 1
return: 0

# One word of a cell, followed as a candidate address.  A word that resolves in this arena is
# followed; anything else is a terminal.
fn: lmx_gc_word (@: LmxArena arena; @@: void slot; unsigned: gen; int: depth) int
    if: slot = 0
        return: c.LMX_GC_OK
    if: \slot = 0
        return: c.LMX_GC_OK
return: lmx_gc_mark_value(arena, \slot, gen, depth + 1)

# Every cell of one chunk, walked by what the chunk IS (the array's kind and type).
fn: lmx_gc_cells (@: LmxArena arena; @: LmxPool pool; @: LmxChunk chunk; unsigned: gen; int: depth) int
    size_t: index
    size_t: words
    size_t: word
    @: char cell
    @: Lmx header
    int: status
    status: c.LMX_GC_OK
    if: pool = 0 || chunk = 0 || lmx_gc_scalar(pool) != 0
        return: c.LMX_GC_OK
    ---
    if: (pool\kind = c.LMX_KIND_STRUCT || pool\kind = c.LMX_KIND_ARRAY) && pool\stride != c.sizeof(c.Lmx)
        return: c.LMX_GC_INVALID
    ---
    # The external spelling table has weak keys. Neither its key nor its
    # text descriptor is an ordinary graph edge; handle it after graph mark.
    if: pool\kind = c.LMX_KIND_SOURCE_NAME
        return: c.LMX_GC_OK
    ---
    index: 0U
    while: index < lmx_chunk_cells(chunk, pool\stride)
        cell: (cast: (@: char) lmx_chunk_data(chunk)) + (index * pool\stride)
        if: pool\kind = c.LMX_KIND_STRUCT || pool\kind = c.LMX_KIND_ARRAY
            # Structure and Array have the same graph header. Follow their
            # parent and physical backing; neither size nor native is an edge.
            header: (cast: (@: Lmx) cell)
            status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) header\parent), gen, depth + 1))
            status: lmx_gc_note(status, lmx_gc_mark_value(arena, (header\array.data), gen, depth + 1))
        else:
            if: pool\kind = c.LMX_DOMAIN_KIND_POST
                # Post.nodes.next is the arena inventory, not a graph edge.
                # Its live nodes and inbox are explicit roots in lmx_gc_mark.
                status: status
            else:
                if: pool\kind = c.LMX_KIND_PRIMITIVE && pool\pointer_read != 0
                    # A machine T * cell is not a void * object. The pool's
                    # exact C99 read supplies its one held address.
                    status: lmx_gc_note(status, lmx_gc_mark_value(arena, pool\pointer_read((cast: (@: void) cell)), gen, depth + 1))
                else:
                    if: pool\kind = c.LMX_KIND_PRIMITIVE && pool\type = c.LMX_TYPE_CHAR_PTR
                        status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) lmx_charptr_value_known((cast: (@: void) cell))), gen, depth + 1))
                    else:
                        # CHILDREN/REF slots are physically void * objects.
                        # Legacy kernel records still use word scanning here.
                        words: pool\stride / c.sizeof(@: void)
                        word: 0U
                        while: word < words
                            status: lmx_gc_note(status, lmx_gc_word(arena, (cast: (@@: void) (cell + (word * c.sizeof(@: void)))), gen, depth))
                            word: word + 1U
                        ---
                    ---
                ---
            ---
        ---
        index: index + 1U
    ---
return: status

# The value at one address: mark its chunk (once per pass) and walk what the chunk holds.
fn: lmx_gc_mark_value (@: LmxArena arena; @: void p; unsigned: gen; int: depth) int
    @: LmxPool pool
    @: LmxChunk chunk
    if: p = 0
        return: c.LMX_GC_OK
    if: depth > c.LMX_GC_DEPTH
        return: c.LMX_GC_PARTIAL
    ---
    pool: lmx_range_pool(arena, p)
    if: pool = 0
        # An address this arena never handed out: not this arena's to keep or to free.
        return: c.LMX_GC_OK
    ---
    # A sealed typed range is immutable and GC-exempt in its ordinary owner arena. Imported
    # ranges are non-owning views and lmx_range_pool deliberately does not return them here.
    if: lmx_pool_is_sealed(pool) != 0
        return: c.LMX_GC_OK
    ---
    chunk: lmx_pool_chunk_at(pool, p)
    if: chunk = 0
        return: c.LMX_GC_OK
    if: chunk\mark = gen
        # Already reached by this pass: its cells are being walked, or have been.
        return: c.LMX_GC_OK
    ---
    chunk\mark: gen
return: lmx_gc_cells(arena, pool, chunk, gen, depth)

# Every chunk of one array: the mailbox's own node pool is storage of THIS arena, so a
# collection that ignored it would free the nodes of a live mailbox.
fn: lmx_gc_mark_pool (@: LmxArena arena; @: LmxPool pool; unsigned: gen) int
    @: LmxChunk chunk
    int: status
    status: c.LMX_GC_OK
    if: lmx_pool_is_sealed(pool) != 0
        return: c.LMX_GC_OK
    ---
    chunk: lmx_pool_chunk_head(pool)
    while: chunk != 0
        if: chunk\mark != gen
            chunk\mark: gen
            status: lmx_gc_note(status, lmx_gc_cells(arena, pool, chunk, gen, 0))
        ---
        chunk: chunk\next
    ---
return: status

# Is this block one the pass reached?  Three ways to be live: the array's own descriptor block
# (the arena's inventory -- an array lives as long as the arena), the STORAGE of a chunk the
# pass stamped, or the RECORD of such a chunk.
fn: lmx_gc_block_live (@: LmxArena arena; @: LmxArenaBlock node; unsigned: gen) int
    @: LmxPool pool
    @: LmxChunk chunk
    if: node = 0
        return: 0
    if: node\base = 0
        # A block that owns nothing has nothing to free.
        return: 1
    ---
    pool: arena\arrays
    while: pool != 0
        if: (cast: (@: void) pool) = node\base
            return: 1
        ---
        chunk: pool\head
        while: chunk != 0
            if: (cast: (@: void) lmx_chunk_data(chunk)) = node\base || (cast: (@: void) chunk) = node\base
                if: lmx_pool_is_sealed(pool) != 0 || chunk\mark = gen
                    return: 1
                ---
            ---
            chunk: chunk\next
        ---
        pool: pool\next
    ---
return: 0

# A block that is leaving: if it is the storage or the record of a chunk the pass did NOT
# reach, that chunk leaves its array's chain first, so the array never hands out storage that
# is about to be freed.  A block that belongs to no chunk (a descriptor, a marker) needs none.
fn: lmx_gc_block_unlink (@: LmxArena arena; @: LmxArenaBlock node; unsigned: gen) int
    @: LmxPool pool
    @: LmxChunk chunk
    pool: arena\arrays
    while: pool != 0
        if: lmx_pool_is_sealed(pool) = 0
            chunk: pool\head
            while: chunk != 0
                if: chunk\mark != gen
                    if: (cast: (@: void) lmx_chunk_data(chunk)) = node\base || (cast: (@: void) chunk) = node\base
                        return: lmx_pool_chunk_drop(pool, chunk)
                    ---
                ---
                chunk: chunk\next
            ---
        ---
        pool: pool\next
    ---
return: 1

fn: lmx_gc_block_dispose (@: LmxArenaBlock node) void
    if: node != 0
        if: node\dispose != 0
            node\dispose(node\base, node\n)
        else:
            free(node\base)
        ---
        free((cast: (@: void) node))
    ---


# D-43: a pool descriptor embedded in a dying block (LmxPost.nodes) must leave
# arena->arrays before the block is freed. Otherwise a recycled Post at the same
# address finds itself already linked and lmx_post_init / lmx_pool_open fails.
fn: lmx_gc_drop_arrays_in_block (@: LmxArena arena; @: LmxArenaBlock node) void
    @: LmxPool pool
    @: LmxPool next
    @: char lo
    @: char hi
    @: char at
    if: arena = 0 || node = 0 || node\base = 0 || node\n = 0U
        return
    ---
    lo: (cast: (@: char) node\base)
    hi: lo + node\n
    pool: arena\arrays
    while: pool != 0
        next: pool\next
        at: (cast: (@: char) pool)
        if: at >= lo && at < hi
            lmx_arena_array_drop(arena, pool)
            pool\head: 0
            pool\tail: 0
            pool\next: 0
            pool\stride: 0U
            pool\chunk_capacity: 0U
            pool\kind: 0
            pool\type: 0
            pool\profile: 0
            pool\sealed: 0U
        ---
        pool: next
    ---

# A recorded admission is an address relation: while its value is live, the
# required Structure is a live dependency of that value. It is not an extra
# graph child, but sweeping it would erase the declared receiving model after
# a field is replaced. An admitting frame is different: its departure retires
# the frame-backed record. Mark to a fixed point because marking one model can
# make another recorded value reachable through its ordinary graph edges.
fn: lmx_gc_impl_live (@: LmxArena arena; @: Lmx value; unsigned: gen) int
    @: LmxPool pool
    @: LmxChunk chunk
    if: arena = 0 || value = 0
        return: 0
    pool: lmx_range_pool(arena, (cast: (@: void) value))
    if: pool = 0
        return: 0
    if: lmx_pool_is_sealed(pool) != 0
        return: 1
    chunk: lmx_pool_chunk_at(pool, (cast: (@: void) value))
return: (cast: (int) (chunk != 0 && chunk\mark = gen))

fn: lmx_gc_mark_impl (@: LmxArena arena; unsigned: gen) int
    size_t: i
    int: changed 1
    @: LmxImplEntry entry
    while: changed != 0
        changed: 0
        i: 0U
        while: i < arena\impl_len
            entry: arena\impl + i
            if: lmx_gc_impl_live(arena, entry\value, gen) != 0 && (entry\frame = 0 || lmx_gc_impl_live(arena, entry\frame, gen) != 0)
                if: entry\req != 0 && lmx_gc_impl_live(arena, entry\req, gen) = 0
                    if: lmx_gc_mark_value(arena, (cast: (@: void) entry\req), gen, 0) != c.LMX_GC_OK
                        return: c.LMX_GC_PARTIAL
                    if: lmx_gc_impl_live(arena, entry\req, gen) != 0
                        changed: 1
                    ---
                ---
            ---
            i: i + 1U
        ---
    ---
return: c.LMX_GC_OK

fn: lmx_gc_sweep (@: LmxArena arena; unsigned: gen) int
    @: LmxArenaBlock node
    @: LmxArenaBlock next
    if: arena = 0 || gen = 0U
        return: c.LMX_GC_INVALID
    if: lmx_gc_mark_impl(arena, gen) != c.LMX_GC_OK
        return: c.LMX_GC_PARTIAL
    if: lmx_source_names_mark(arena, gen) != c.LMX_GC_OK
        return: c.LMX_GC_INVALID
    node: arena\blocks
    while: node != 0
        next: node\next
        if: lmx_gc_block_live(arena, node, gen) = 0
            # D-43: detach embedded pools (Post.nodes) before unlink/free of this block.
            lmx_gc_drop_arrays_in_block(arena, node)
            lmx_gc_block_unlink(arena, node, gen)
            # The interval leaves the index, the block leaves the list -- and then its storage
            # goes: lmx_arena_drop detaches, it does not free.
            lmx_arena_drop(arena, node)
            lmx_gc_block_dispose(node)
        ---
        node: next
    ---
    # D-105: a correspondence of the `implements` table never outlives its value by one pass --
    # dropped here, after the storage and before anything can be handed out at its address.
    lmx_arena_impl_prune(arena)
return: c.LMX_GC_OK
