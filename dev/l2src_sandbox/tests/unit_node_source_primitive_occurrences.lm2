# Two distinct own rows preserve their source values and positions.
int: hFirst 7
int: hLast 11
Model:
    int: first 0
    int: last 0
    first: node\hFirst
    last: node\hLast
end: Model
Model
int: ok 7
if: Model\first != 7 || Model\last != 11
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
