# Probe 345 (lowering): a named actual whose tail is a written field `y: 6` for the Structure formal p of take
# (the graph gives 62); entry 7, 81 a wrong value.
Point:
    int: x 1
    int: y 2
end: Point
fn: take (Point: p; int: q 2) int
    return: p\y * 10 + q
end: take
int: code 7
if: take(p: y: 6) != 62
    code: 81
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
