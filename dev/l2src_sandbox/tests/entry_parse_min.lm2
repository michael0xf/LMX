predef: "l1src/parser.lm1"
include: "<stdio.h>"

# The P0 parser on a path given as argv[1] (the harness passes this file's own
# path): the argument's C string is `@ m\mainArgs[1][0]`, in graph storage.
MainLetter:
    char: []: []: mainArgs
end: MainLetter

@: c.LmP0Document document
MainLetter: m
nextMessage: m
if: length(m\mainArgs) != 2
    return: 1
if: lm_p0_parse_file(@ m\mainArgs[1][0], @ document) != 0
    lm_p0_document_destroy: document
    return: 2
if: document = 0
    return: 3
lm_p0_document_destroy: document
return: 0
