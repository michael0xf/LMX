# Two explicit merge results retain their complete, different callable bodies.
# Each call uses the copied occurrence: m\v becomes 2, o\w becomes 15.
# Inferring both bodies from the first declared Structure is wrong. Entry 7.
Model:
    size_t: v 1U
    v: v + 1U
return
Other:
    size_t: w 10U
    w: w + 5U
return
m: merge: Model
o: merge: Other
o
m
size_t: a 0U
a: m\v
size_t: b 0U
b: o\w
int: ok 0
if: a = 2U && b = 15U
    ok: 7
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
