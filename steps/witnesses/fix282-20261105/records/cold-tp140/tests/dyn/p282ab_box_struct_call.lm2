# Slice 282 probe: a callable field given a Structure, then called.  Exit 7 refused by implements, 8 by interpreter, 9 by the write, 12 not refused.
Other:
    int: q 3
end: Other
Box:
    fn: f () int
        return: 1
    end: f
end: Box
fn: run () int
    ---
        @: Box\f Other
        catch: implements ()
            return: 9
    ---
    ---
        int: r Box\f()
        return: 12
        catch: implements ()
            return: 7
        catch: interpreter ()
            return: 8
    ---
end: run
int: code run()
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
