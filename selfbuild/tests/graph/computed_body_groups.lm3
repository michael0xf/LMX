# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: k 0
        int: result 0
        int: outside 0
)
@: shared data[0]
int: k 5
@: local ()
fn: change () int
    node\k := 8
    return: 1
end: change
fn: sink (int: value) int
    return: value
end: sink
fn: outer () int (
    prepared:
        name: local
        args: (int: value)
        return: int
        code: (return: value)
    int: seeded change()
)
    int: used seeded
    fn: prepared; return: sink((local((k))))
end: outer
int: result outer()
int: outside data\k

sub: main ()
    shared\Observed\k := node\k
    shared\Observed\result := result
    shared\Observed\outside := outside
main()
