predef: "l2src/lmx_root.lm1"
predef: "l2src/lmx_settle.lm1"
predef: "l2src/lmx_service.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_manager.lm1"
predef: "l2src/lmx_manager_running.h.lm1"
predef: "l2src/lmx_process_deadline.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_gc.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_call.lm1"
predef: "l2src/lmx_clock.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# CLOSE COMPLETES WITH THE WATCHDOG ARMED: THE STEPPED BINDING CANNOT STALL A CLOSE
# (DEEPSEEK-MAIL-CASCADE-FIX-20260921-82; author's ruling via Codex, 2026-09-21).
#
# WHAT CHANGED, AND WHY THIS FILE NO LONGER ABORTS.  It used to expect an abort: B's body looped
# forever and the closer's stack was said to be inside it.  Under the corrected contract a child with
# no active lane and no turn in flight is QUIESCENT, and the closer CLAIMS it and runs its own close
# synchronously -- it is never driven into a body, so a stepped child can no longer stall a close at
# all (measured: the body's spin counter stays 0 and the close returns inside its bound).  Rather than
# keep an assertion that can no longer be true, this file asserts the POSITIVE half of the watchdog
# contract with the watchdog ARMED at 400 ms: the close returns inside its bound and nothing is
# killed.  The abort path stays covered by the running-manager probe, where a LANE can fail to end.
#
# THE OLD HEADER, KEPT SO THE CHANGE OF MEANING IS VISIBLE: the cooperative closure checks can only fire
# where a pass runs.  Here R0 -> A -> B and B's own BODY loops forever, on the STEPPED manager -- so
# the turn that enters B never returns, and the closer's stack is inside it: A's cascade loop cannot
# reach its next pass, R0's loop cannot resume, and lmx_stop_close is never called again.  NOTHING
# COOPERATIVE CAN FIRE HERE.  The only thing that ends this process is lmx_process_deadline's
# watchdog, armed by lmx_root_close from the same deadline every level would have read.
#
# WHAT THE HARNESS MUST SEE (the assertions live in the runner, not in this file):
#   * THE WATCHDOG'S OWN diagnostic -- "...with the close still running..." -- and NOT the
#     cooperative one ("...with children still live at one level..."), because no pass can run:
#     that difference is the whole point of this file and is asserted, not noted;
#   * exit by ABORT (3 on this platform), well inside the harness's timeout;
#   * and NOT the line this file prints if the close ever returns.
#
# THE BOUND IS READ, NOT COMPILED IN: `lmx_root_close_limit_set` arms 400 ms here through the same
# path a production close takes with its 60 s default.  There is no test-only branch.

@: LmxRoot t5_root 0
@: LmxArena t5_arena_a 0
@: LmxArena t5_arena_b 0
@: LmxArena t5_harness 0
@: LmxPost t5_mail_a 0
@: LmxPost t5_mail_b 0
@: LmxThread t5_t_a 0
@: LmxSchedule t5_sched_b 0
@: Lmx t5_source_a 0
size_t: t5_phase 0U
size_t: t5_diag 0U
int: t5_run 1
size_t: t5_b_spins 0U

# B: A BODY THAT NEVER RETURNS.  It yields the CPU (Sleep) so the rest of the process keeps running
# -- the point is not a busy machine, it is a stack that cannot come back.
fn: t5_body_b (@: Lmx node) int
    t5_b_spins: t5_b_spins + 1U
    while: t5_run = 1
        c.Sleep(1U)
    ---
return: 0

# A: build B under itself, give B's slot to A's OWN queue, and stay live.  A's body returns, which is
# what makes the difference visible: it is B's BODY, not A's, that never comes back.
fn: t5_body_a (@: Lmx node) int
    @: LmxThread t
    @: Lmx graph_a
    @: Lmx source_b
    @: LmxMsg child_b
    @: LmxThread t_b
    @: LmxPost mail_b
    @: LmxSchedule sched_b
    @: LmxMethod method
    @: LmxPool methods
    t: lmx_thread_current()
    if: t = 0 || t\message = 0 || t\message\graph = 0
        t5_diag: 1U
        return: 0
    ---
    if: t5_phase != 1U
        return: 0
    ---
    if: t5_arena_a = 0 || t5_arena_b = 0 || t5_mail_b = 0
        t5_diag: 2U
        return: 0
    ---
    graph_a: t\message\graph
    source_b: lmx_node_new_owned(t5_arena_a)
    if: source_b = 0 || lmx_arena_refs_open_owned(t5_arena_a, source_b, 2U) != 0
        t5_diag: 3U
        return: 0
    ---
    child_b: lmx_child_reserve(t, t5_arena_a, t5_arena_b, graph_a, 1U, source_b)
    if: child_b = 0
        t5_diag: 4U
        return: 0
    ---
    methods: lmx_pool_make(t5_arena_b, 2U * c.sizeof(c.LmxMethod), c.sizeof(c.LmxMethod),
                           c.LMX_KIND_METHOD, c.LMX_TYPE_METHOD)
    if: methods = 0
        t5_diag: 5U
        return: 0
    ---
    method: lmx_method_intern(t5_arena_b, methods, (cast: (LmxEntry) t5_body_b), 1U)
    if: method = 0 || child_b\graph = 0
        t5_diag: 6U
        return: 0
    ---
    lmx_arena_ref_store(child_b\graph, 0U, (cast: (@: void) method))
    mail_b: t5_mail_b
    t_b: (cast: (@: LmxThread) lmx_arena_take(t5_arena_b, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_THREAD, c.LMX_DOMAIN_THREAD))
    sched_b: (cast: (@: LmxSchedule) lmx_arena_take(t5_arena_b, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: t_b = 0 || sched_b = 0
        t5_diag: 7U
        return: 0
    ---
    if: lmx_post_init(t5_arena_b, mail_b) != c.LMX_POST_OK
        t5_diag: 8U
        return: 0
    ---
    if: lmx_schedule_init(sched_b, t5_arena_b, (cast: (@: void) t_b), 100000U) != c.LMX_SCHEDULE_OK
        t5_diag: 9U
        return: 0
    ---
    if: lmx_thread_attach(t_b, child_b, mail_b, sched_b) != c.LMX_THREAD_OK
        t5_diag: 10U
        return: 0
    ---
    if: lmx_child_thread(t, child_b, t_b) != c.LMX_CHILD_OK
        t5_diag: 11U
        return: 0
    ---
    if: lmx_manager_add((cast: (@: LmxManager) lmx_thread_manager(t)), sched_b) != c.LMX_MANAGER_OK
        t5_diag: 12U
        return: 0
    ---
    t5_sched_b: sched_b
    t5_phase: 2U
return: 0

fn: t5_root_entry (@: Lmx node) int
    @: LmxMsg child
    @: LmxThread child_t
    @: LmxPost child_mail
    @: LmxSchedule child_sched
    @: LmxMethod method
    @: LmxPool methods
    @: Lmx graph
    if: t5_phase != 0U
        return: 0
    ---
    if: t5_root = 0 || t5_arena_a = 0 || t5_source_a = 0 || t5_mail_a = 0
        t5_diag: 13U
        return: 0
    ---
    child: lmx_root_create(t5_root, t5_arena_a, 0U, t5_source_a)
    if: child = 0
        t5_diag: 14U
        return: 0
    ---
    graph: child\graph
    methods: lmx_pool_make(t5_arena_a, 2U * c.sizeof(c.LmxMethod), c.sizeof(c.LmxMethod),
                           c.LMX_KIND_METHOD, c.LMX_TYPE_METHOD)
    if: graph = 0 || methods = 0
        t5_diag: 15U
        return: 0
    ---
    method: lmx_method_intern(t5_arena_a, methods, (cast: (LmxEntry) t5_body_a), 1U)
    if: method = 0
        t5_diag: 16U
        return: 0
    ---
    lmx_arena_ref_store(graph, 0U, (cast: (@: void) method))
    child_mail: t5_mail_a
    child_t: (cast: (@: LmxThread) lmx_arena_take(t5_arena_a, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_THREAD, c.LMX_DOMAIN_THREAD))
    child_sched: (cast: (@: LmxSchedule) lmx_arena_take(t5_arena_a, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: child_t = 0 || child_sched = 0
        t5_diag: 17U
        return: 0
    ---
    if: lmx_post_init(t5_arena_a, child_mail) != c.LMX_POST_OK
        t5_diag: 18U
        return: 0
    ---
    if: lmx_schedule_init(child_sched, t5_arena_a, (cast: (@: void) child_t), 100000U) != c.LMX_SCHEDULE_OK
        t5_diag: 19U
        return: 0
    ---
    if: lmx_thread_attach(child_t, child, child_mail, child_sched) != c.LMX_THREAD_OK
        t5_diag: 20U
        return: 0
    ---
    if: lmx_thread_scheduler_open(child_t, t5_harness) != c.LMX_THREAD_OK
        t5_diag: 21U
        return: 0
    ---
    if: lmx_child_thread(lmx_root_thread(t5_root), child, child_t) != c.LMX_CHILD_OK
        t5_diag: 22U
        return: 0
    ---
    if: lmx_manager_add(lmx_root_manager(t5_root), child_sched) != c.LMX_MANAGER_OK
        t5_diag: 23U
        return: 0
    ---
    t5_t_a: child_t
    t5_phase: 1U
return: 0

fn: main () int
    @: int counts (cast: (@: int) calloc(5U, c.sizeof(int)))
    LmxRoot: root
    LmxArena: arena_a
    LmxArena: arena_b
    LmxArena: harness
    LmxPost: mail_a
    LmxPost: mail_b
    @: LmxArena root_arena 0
    @: Lmx live_graph 0
    @: Lmx source 0
    @: LmxMsg message 0
    int: code 0
    if: counts = 0
        return: 2
    ---
    memset((cast: (@: void) (@ root)), 0, c.sizeof(c.LmxRoot))
    memset((cast: (@: void) (@ arena_a)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ arena_b)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ harness)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ mail_a)), 0, c.sizeof(c.LmxPost))
    memset((cast: (@: void) (@ mail_b)), 0, c.sizeof(c.LmxPost))
    t5_root: @ root
    t5_mail_a: @ mail_a
    t5_mail_b: @ mail_b
    t5_arena_a: @ arena_a
    t5_arena_b: @ arena_b
    t5_harness: @ harness
    if: lmx_arena_open(@ arena_a) != 0 || lmx_arena_open(@ arena_b) != 0 || lmx_arena_open(@ harness) != 0
        c.printf("PROBE-STEPPED an arena did not open\n")
        c.fflush(0)
        return: 2
    ---
    t5_phase: 0U
    t5_diag: 0U
    t5_run: 1
    if: lmx_root_open(@ root, t5_root_entry, 120000U, 0U, 0U) != c.LMX_ROOT_OK
        c.printf("PROBE-STEPPED the root did not open\n")
        c.fflush(0)
        return: 2
    ---
    root_arena: lmx_root_arena(@ root)
    message: lmx_root_message(@ root)
    if: root_arena = 0 || message = 0
        c.printf("PROBE-STEPPED the root is missing pieces\n")
        c.fflush(0)
        return: 2
    ---
    live_graph: message\graph
    source: lmx_node_new_owned(root_arena)
    if: source = 0 || lmx_arena_refs_open_owned(root_arena, source, 4U) != 0
        c.printf("PROBE-STEPPED the template was not built\n")
        c.fflush(0)
        return: 2
    ---
    lmx_arena_ref_store(live_graph, 3U, (cast: (@: void) source))
    t5_source_a: source
    if: lmx_root_cycle(@ root, 1U) != c.LMX_ROOT_OK || t5_phase = 0U
        c.printf("PROBE-STEPPED A was not wired, diag=%u\n", (cast: (unsigned) t5_diag))
        c.fflush(0)
        return: 2
    ---
    if: t5_phase != 2U
        if: lmx_root_cycle(@ root, 1U) != c.LMX_ROOT_OK || t5_phase != 2U
            c.printf("PROBE-STEPPED B was not wired by A's turn, diag=%u\n", (cast: (unsigned) t5_diag))
            c.fflush(0)
            return: 2
        ---
    ---
    if: lmx_root_close_limit_set(@ root, 400U) != c.LMX_ROOT_OK
        c.printf("PROBE-STEPPED the close limit was not set\n")
        c.fflush(0)
        return: 2
    ---
    # ONE TURN OF B IS DRIVEN BY HAND BEFORE THE CLOSE, so that the infinite body is ALREADY inside
    # a turn when the close begins: the closer's stack then cannot reach any pass at all.
    c.printf("PROBE-STEPPED armed: R0 -> A -> B, B's body never returns, close limit 400 ms\n")
    c.fflush(0)
    code: lmx_root_close(@ root)
    # THIS LINE IS NOW THE EXPECTED OUTCOME, NOT A FAILURE (see the header): under the corrected
    # semantics a quiescent child is CLAIMED and closed synchronously, so no stepped child can stall a
    # close -- and the armed watchdog must therefore NOT fire.  The harness asserts this exit 0 and
    # this line, which is the "no late watchdog fire" half of the watchdog contract.
    c.printf("PROBE-STEPPED the close returned code=%d inside its bound, with the watchdog armed and disarmed\n", code)
    c.fflush(0)
return: 0
