---
    Observed:
        int: arithmetic 33
        int: negative 28
        int: boundary 72
        int: unary -20
        int: nested 33
        int: through_path 3
        int: call_parentheses 36
        int: call_colon 36
        int: candidate_inner_len 1
    end: Observed
---
fn: numeric (int: x; int: y) int
    return: ((x * 10) + y)
end: numeric
fn: a (int: x) int
    return: (x + 1)
end: a
fn: mytest (int: a) int
    return: (a + 30)
end: mytest
sub: main () (
    Point:
        Inner:
            int: y 0
            int: x 0
        end: Inner
    end: Point
    Candidate:
        Inner:
            int: y 3
        end: Inner
    end: Candidate
    Flat:
        int: y 0
    end: Flat
    int: arithmetic 0
    int: negative 0
    int: nested 0
    int: through_path 0
)
    fn: take (@: p Point; int: q) int
        return: ((((p \ Inner) \ y) * 10) + q)
    end: take
    fn: choose (@: p Point) int
        return: (take p ((1 + 2)))
    end: choose
    fn: access (@: value Flat) int
        return: (value \ y)
    end: access
    :=: (data \ arithmetic) (take Candidate (1 + 2))
    :=: (data \ negative) (take Candidate -2)
    :=: (data \ nested) (choose Candidate)
    :=: (data \ through_path) (access (Candidate \ Inner))
end: main
main:
int: arithmetic ((main \ data) \ arithmetic)
int: negative ((main \ data) \ negative)
int: boundary (numeric (8 - 2) (3 * 4))
int: unary ((- (2 + 3)) * 4)
int: nested ((main \ data) \ nested)
int: through_path ((main \ data) \ through_path)
int: call_parentheses (mytest (a 5))
int: call_colon (mytest (a 5))
int: candidate_inner_len (length (((main \ data) \ Candidate) \ Inner))
sub: observe ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ arithmetic) arithmetic
    :=: ((shared \ Observed) \ negative) negative
    :=: ((shared \ Observed) \ boundary) boundary
    :=: ((shared \ Observed) \ unary) unary
    :=: ((shared \ Observed) \ nested) nested
    :=: ((shared \ Observed) \ through_path) through_path
    :=: ((shared \ Observed) \ call_parentheses) call_parentheses
    :=: ((shared \ Observed) \ call_colon) call_colon
    :=: ((shared \ Observed) \ candidate_inner_len) candidate_inner_len
end: observe
observe:
