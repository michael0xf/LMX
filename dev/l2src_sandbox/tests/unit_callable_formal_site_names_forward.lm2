# The names a site is asked for follow the callable through formals handed
# on and through a callee that is itself a formal's value. far hands its
# formal to mid, mid to run; apply calls its formal h with its formal q. g1
# reads other; fz reads zz, which the unit does not declare. The root has no
# zz and gives g1 by the three routes: 10 each. withzz has zz 30 and gives
# fz by the three: 32 each. outer has its own other, 40: 41 each. Entry 7.
int: other 9

fn: g1 () int
    return: other + 1
end: g1

fn: fz () int
    return: zz + 2
end: fz

fn: run (g1: q) int
    return: q()
end: run

fn: mid (g1: q2) int
    return: run(q2)
end: mid

fn: far (g1: q3) int
    return: mid(q3)
end: far

fn: apply (run: h; g1: q) int
    return: h(q)
end: apply

fn: withzz () int
    int: zz 30
    return: far(fz) * 10000 + mid(fz) * 100 + apply(run, fz)
end: withzz

fn: outer (int: other) int
    return: far(g1) * 10000 + mid(g1) * 100 + apply(run, g1)
end: outer

int: a mid(g1)
int: b apply(run, g1)
int: e far(g1)
int: c withzz()
int: d outer(40)
int: ok 7
if: a != 10 || b != 10 || e != 10 || c != 323232 || d != 414141
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
