# Original: l2src/l2trans.lm1:17058
fn: lm_compiler_check_word_value (const: (@: source_node c.LmP0Node); const: (@: w c.LmP0Text); int: mi; const: (@: path char)) int
    int: na c.lm_compiler_count_active(c.lm_compiler_app_actuals(source_node))
    if: c.lm_compiler_text_eq(w, "merge")
        if: na = 0
            return: (cast: (int) (c.lm_compiler_error(path, source_node, "merge needs at least one operand")))
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "merge expression is not lowered in this receiving context")))
    if: c.lm_compiler_text_eq(w, "cast") || c.lm_compiler_text_eq(w, "sizeof") || c.lm_compiler_text_eq(w, "length")
        if: na != 0
            return: (cast: (int) (2))
        if: c.lm_compiler_text_eq(w, "cast")
            return: (cast: (int) (c.lm_compiler_error(path, source_node, "unsupported cast")))
        if: c.lm_compiler_text_eq(w, "sizeof")
            return: (cast: (int) (c.lm_compiler_error(path, source_node, "sizeof: requires one operand")))
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "length requires one known primitive own array")))
    if: c.lm_compiler_text_eq(w, "while") || c.lm_compiler_text_eq(w, "for") || c.lm_compiler_text_eq(w, "continue") || c.lm_compiler_text_eq(w, "break")
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "unsupported loop")))
    if: c.lm_compiler_text_eq(w, "if") || c.lm_compiler_text_eq(w, "else") || c.lm_compiler_text_eq(w, "return") || c.lm_compiler_text_eq(w, "fn") || c.lm_compiler_text_eq(w, "node")
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "unsupported body")))
    # implements has its value (§7): with operands its branch checks them (l2_check_implements); applied to nothing it
    # has none of its three.
    if: c.lm_compiler_text_eq(w, "implements")
        if: na != 0
            return: (cast: (int) (2))
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "implements expects candidate, required, consumer")))
    # The receivers the translator does not build (l2_check_word_stmt) and the unit instructions, as in a statement.
    if: c.lm_compiler_text_eq(w, "fm") || c.lm_compiler_text_eq(w, "synchronized") || c.lm_compiler_text_eq(w, "test") || c.lm_compiler_text_eq(w, "post") || c.lm_compiler_text_eq(w, "external")
        return: (cast: (int) (c.lm_compiler_error_name(path, source_node, "", (cast: (const: @: char) (w\data)), (cast: (size_t) (w\length)), " is not supported yet")))
    if: c.lm_compiler_unit_word(w) != 0
        return: (cast: (int) (c.lm_compiler_error_name(path, source_node, "", (cast: (const: @: char) (w\data)), (cast: (size_t) (w\length)), " is a unit instruction: it stands at the root of the unit")))
    return: (cast: (int) (c.lm_compiler_error_name(path, source_node, "", (cast: (const: @: char) (w\data)), (cast: (size_t) (w\length)), " has no value")))
end: lm_compiler_check_word_value

# Original: l2src/l2trans.lm1:17299
fn: lm_compiler_actual_ns (int: mi; @: a0 c.LmP0Field; int: span; const: (@: path char); const: (@: at c.LmP0Node); @: out_ni int) int
    @: alloc_err_cell int (cast: (@: int) (@ c.l2_alloc_err))
    c.L2ValueSpan: value
    int: status
    # Remaining raw return entry. It prepares one complete value at its
    # boundary;argument consumers already own that value and never enter here.
    status: c.lm_compiler_value_span_prepare(a0, span, @ value)
    if: status != span
        c.lm_compiler_value_span_release(@ value)
        if: alloc_err_cell[0] != 0
            return: (cast: (int) (c.lm_compiler_alloc_or(path, at, "cannot prepare a candidate value")))
        return: (cast: (int) (2))
    status: lm_compiler_value_model(@ value, mi, path, at, out_ni, 0)
    c.lm_compiler_value_span_release(@ value)
    return: (cast: (int) (status))
end: lm_compiler_actual_ns

# Original: l2src/l2trans.lm1:17319
fn: lm_compiler_value_model (@: value c.L2ValueSpan; int: mi; const: (@: path char); const: (@: at c.LmP0Node); @: model int; @: exact_type int) int
    @: alloc_err_cell int (cast: (@: int) (@ c.l2_alloc_err))
    @@: m_ret_cell int (cast: (@@: int) (@ c.l2_m_ret))
    @: selected c.L2Path
    @: application c.L2ApplicationSite
    c.L2Address: address
    int: status
    int: type
    if: model = 0
        return: (cast: (int) (c.lm_compiler_error_fatal(path, at, "internal: a candidate query has no result")))
    \model: -1
    if: exact_type != 0
        \exact_type: -1
    if: alloc_err_cell[0] != 0
        return: (cast: (int) (c.lm_compiler_alloc_or(path, at, "cannot project a candidate value")))
    if: value = 0 || value\node = 0 || value\count < 1 || value\grammar = 0
        return: (cast: (int) (2))
    if: value\values != 0 && value\value_n = 1 && (value\grammar = 3 || value\node\kind = c.LM_P0_NODE_STRUCTURE)
        return: (cast: (int) (lm_compiler_value_model((cast: (@: c.L2ValueSpan) (value\values)), mi, path, at, model, exact_type)))
    status: c.lm_compiler_value_span_path(value, mi, @ selected)
    if: status = 3
        return: (cast: (int) (c.lm_compiler_alloc_or(path, at, "cannot project a candidate path")))
    if: selected != 0
        if: status != 0 || selected\fail_why != 0
            return: (cast: (int) (c.lm_compiler_path_seg_refusal_at(path, (cast: (const: @: c.LmP0Node) (c.lm_compiler_path_fail_node(selected, (cast: (@: c.LmP0Field) (value\first))))), (cast: (int) ((selected\fail_why))))))
        if: exact_type != 0
            \exact_type: c.lm_compiler_path_rec_leaf_ft(selected)
        if: selected\array_leaf != 0
            return: (cast: (int) (2))
        \model: selected\leaf_model
        if: \model = -1 && selected\n = 0 && selected\res >= 0
            \model: c.lm_compiler_schema_merge((cast: (int) ((selected\res))))
        if: \model != -1
            return: (cast: (int) (0))
        if: selected\n > 0
            return: (cast: (int) (c.lm_compiler_error(path, (cast: (const: @: c.LmP0Node) (c.lm_compiler_path_leaf_node(selected, (cast: (@: c.LmP0Field) (value\first))))), "a field path must end at a Structure")))
        return: (cast: (int) (2))
    ---
    status: c.lm_compiler_address_value_span(value, mi, @ address)
    if: status = 3 || alloc_err_cell[0] != 0
        return: (cast: (int) (c.lm_compiler_alloc_or(path, at, "cannot project a candidate address")))
    if: status = 1
        return: (cast: (int) (c.lm_compiler_error(path, (cast: (const: @: c.LmP0Node) (value\node)), "unresolved addressable name")))
    if: status = 0
        status: 2
        type: address\type
        if: exact_type != 0
            \exact_type: type
        if: address\immutable != 0
            status: c.lm_compiler_error(path, (cast: (const: @: c.LmP0Node) (value\node)), "the address of an eternal branch field cannot be taken")
