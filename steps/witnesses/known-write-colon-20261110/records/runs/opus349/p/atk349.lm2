# Probe 349/M6 4b: tests/dyn/assign_typed_known.lm2 with left: right for every := (x: int: 5 on a known x).
fn: run () int
    int: x 1
    x: int: 5
    if: x != 5
        return: 81
    x: int: 6
    if: x != 6
        return: 82
    size_t: s 1U
    s: size_t: 3U
    if: s != 3U
        return: 83
    return: 7
end: run
int: y 2
y: int: 9
int: code run()
if: code = 7 && y != 9
    code: 84
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
