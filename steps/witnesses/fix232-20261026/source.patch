+    n: merged_fields\size
+    check((cast: (int) (n = 1U)), "merge keeps the one nested field")
+    # The result's parent is the copy's own: the copy of outer's lexical parent, not the place running the merge
+    # and not outer's source parent (the author, LMX_blog/2026-10-05.md#merge-parent).
+    @: merged_parent_fields c.VoidArray 0
