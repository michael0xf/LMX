# The two used reference/Array fields both move: Middle.ref 1->2,
# Leaf.samples 0->2. A dynamic index must be evaluated exactly once per
# read, write or taken address; neighbors and model defaults stay intact.
Leaf: ([]: int samples 3; int: x 11)
Middle: (int: pad 17; @: ref Leaf)
Holder: (@: ref Middle)
ActualLeaf: (int: pad 29; int: x 13; []: int samples 3)
ActualMiddle: (int: before 19; int: pad 17; @: ref Leaf)
ActualLeaf\samples[1]: 43
ActualMiddle\ref: ActualLeaf
Holder\ref: ActualMiddle
int: calls 0
fn: pick () size_t
    node\calls: node\calls + 1
return: 1U
fn: check () int
    if: Holder\ref\ref\samples[pick()] != 43 || @Holder\ref\ref\samples[pick()] != @ActualLeaf\samples[1]
        return: 81
    Holder\ref\ref\samples[pick()]: 67
    if: ActualLeaf\samples[1] != 67 || ActualLeaf\x != 13 || ActualLeaf\pad != 29 || ActualMiddle\pad != 17 || ActualMiddle\before != 19
        return: 82
    @: cell int @Holder\ref\ref\samples[pick()]
    \cell: 71
    if: ActualLeaf\samples[1] != 71 || Holder\ref\ref\samples[1] != 71 || \cell != 71
        return: 83
    if: Leaf\x != 11 || Leaf\samples[1] != 0 || Middle\pad != 17
        return: 84
    if: node\calls != 4
        return: 85
return: 7
sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
