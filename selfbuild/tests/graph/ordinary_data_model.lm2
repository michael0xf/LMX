# M11 5v: a child's spelling does not supply an ordinary code's data model.
# The same C runs over different D through both existing launch forms.
sub: main () (
    From(int: x 6)
    FromParts(int: x 16)
    To(int: x 0)
    Change(
        x := x + 1
        return:
        data(To)
    )
    int: short_result 0
    int: parts_result 0
)
    call(From Change)
    call(args := (); data := FromParts; code := Change)
    short_result := From\x
    parts_result := FromParts\x
main()
int: short_result main\data\short_result
int: parts_result main\data\parts_result
