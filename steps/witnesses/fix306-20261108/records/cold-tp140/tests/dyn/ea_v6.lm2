# Probe-only variant v6 (slice 306 review, Codex item 1): a call of a bodyless description -- Box\cb (Point: p; int: q) is
# a callable field with no body, written at run time with g -- by its bare name from a sibling method of Box and through the
# place from outside, each followed by touch(); the free name quote bound to a Shape (29, touch run once) and to a Slim (the
# implicit implements, touch not run).  Entry 7.
Point:
    int: y 0
    int: x 0
end: Point
Shape:
    int: y 2
    int: x 1
end: Shape
Slim:
    int: pad 5
end: Slim
Thin:
    int: pad 0
end: Thin
Trace:
    int: t 0
end: Trace
int: quote 11
fn: touch () int
    Trace\t: Trace\t * 10 + 9
    return: 9
end: touch
fn: g (Point: p; int: q) int
    return: p\y * 10 + q
end: g
Box:
    fn: cb (Point: p; int: q) int
    fn: go () int
        return: cb(quote, touch())
    end: go
end: Box
int: Hw 0
fn: write_place () int
    ---
        @: Box\cb Hw
        return: 1
        catch: implements ()
            return: 24
    ---
end: write_place
fn: pass_in () int
    return: Box\go()
end: pass_in
fn: pass_out () int
    return: Box\cb(quote, touch())
end: pass_out
fn: c_in () int
    ---
        return: pass_in()
        catch: implements ()
            return: 90
    ---
end: c_in
fn: c_out () int
    ---
        return: pass_out()
        catch: implements ()
            return: 90
    ---
end: c_out
fn: outer (Point: p) int
    @: quote Point p
    Trace\t: 0
    if: c_in() != 29
        return: 81
    if: Trace\t != 9
        return: 82
    Trace\t: 0
    if: c_out() != 29
        return: 83
    if: Trace\t != 9
        return: 84
    return: 0
end: outer
fn: outer_slim (Thin: t) int
    @: quote Thin t
    Trace\t: 0
    if: c_in() != 90
        return: 121
    if: Trace\t != 0
        return: 122
    Trace\t: 0
    if: c_out() != 90
        return: 123
    if: Trace\t != 0
        return: 124
    return: 0
end: outer_slim
fn: run () int
    @: Hw g g
    if: write_place() != 1
        return: 80
    int: r outer(Shape)
    if: r != 0
        return: r
    r: outer_slim(Slim)
    if: r != 0
        return: r
    return: 7
end: run
int: code run()
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
