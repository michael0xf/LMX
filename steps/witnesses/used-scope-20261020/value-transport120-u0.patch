+    fn: lmx_walk_value_ref_parts (@: LmxWalkValue out; int: ty; @: void ref; @: Lmx model; @: Lmx references) int
+    # Consume a reference already evaluated by native or walker. No path
+    # expression,source graph wrapper or shared-frame mutation is involved.
+    fn: lmx_walk_value_admit (@: LmxArena arena; @: LmxWalkValue value; @: Lmx model; @: Lmx record) int
