predef: "l2src/lmx_settle.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_manager.lm1"
predef: "l2src/lmx_service.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# The settling of a finished direct child -- spec 19.29.8 -- which is what pins the act:
#
#   "After final successful completion, reclaim the Message's own execution history by
#   default"; "After final non-successful completion, transfer its logical arena to its
#   direct parent's available lifecycle endpoint without copying.  The parent adopts the
#   blocks/ranges and retains the failed root"; "Each closing Message settles only its
#   direct children"; "Native addresses stay unchanged and P retains the failure root."
#
# What is pinned here, one check per sentence:
#   1. a settled SUCCESSFUL child is reclaimed -- slot cleared, its arena released;
#   2. a settled FAILED child is adopted -- its blocks answer in the PARENT's index, at the
#      SAME addresses, and its slot still points at the failure root;
#   3. a child that still RUNS is not touched at all (its stop is a different act, spec 32);
#   4. both settled children leave the parent's live-children list, the schedule and the
#      service -- the route goes before the storage does.
sub: st_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: st_check

fn: st_message (@: LmxArena arena; unsigned: index; size_t: slots) @: LmxMsg
    @: LmxMsg message
    @: Lmx graph
    message: (cast: (@: LmxMsg) lmx_arena_take(arena, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
    graph: lmx_node_new_owned(arena)
    if: message = 0 || graph = 0
        return: 0
    ---
    if: slots = 0U || lmx_arena_refs_open_owned(arena, graph, slots) != 0
        return: 0
    ---
    message\running: 1
    message\success: 0
    message\handoff_ready: 0
    message\graph: graph
    message\index: index
return: message

fn: st_object (@: LmxArena arena; @: LmxMsg message; @: LmxSchedule sched) @: LmxThread
    @: LmxThread t
    @: LmxPost mail
    t: (cast: (@: LmxThread) lmx_arena_take(arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_THREAD, c.LMX_DOMAIN_THREAD))
    mail: (cast: (@: LmxPost) lmx_arena_take(arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    if: t = 0 || mail = 0
        return: 0
    ---
    if: lmx_post_init(arena, mail) != c.LMX_POST_OK || lmx_thread_attach(t, message, mail, sched) != c.LMX_THREAD_OK
        return: 0
    ---
return: t

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: parent_arena
    LmxArena: kid_arena
    LmxArena: fail_arena
    LmxArena: live_arena
    LmxSchedule: parent_sched
    LmxSchedule: kid_sched
    LmxSchedule: fail_sched
    LmxSchedule: live_sched
    LmxManager: manager
    LmxService: service
    @: LmxMsg parent_msg 0
    @: LmxMsg kid_msg 0
    @: LmxMsg fail_msg 0
    @: LmxMsg live_msg 0
    @: LmxThread parent_t 0
    @: LmxThread kid_t 0
    @: LmxThread fail_t 0
    @: LmxThread live_t 0
    @: Lmx parent_graph 0
    @: void kid_cell 0
    @: void fail_cell 0
    @: void live_cell 0
    ulong: base 0U
    int: failures
    if: counts = 0
        return: 2
    ---
    memset((cast: (@: void) (@ parent_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ kid_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ fail_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ live_arena)), 0, c.sizeof(c.LmxArena))
    # By-value records are cleared before they are opened, exactly as an arena is: the service
    # refuses a handle that already holds entries, and a stack local holds garbage.
    # THE FOUR SCHEDULE RECORDS ARE POISONED, AND THAT IS DELIBERATE RATHER THAN A CLEAR (poisoned
    # 2026-09-21; a static inventory found them passed to `st_object` uninitialised).  They arrive at
    # `lmx_thread_attach` holding 0xAA and are `lmx_schedule_init`-ed only AFTER the attach, two lines
    # later: the kernel's own contract is that attach must NOT read `slot\arena` ("a record may be
    # attached with a schedule that is not initialized yet, so reading slot\arena inside attach is
    # reading garbage" -- measured 20260919), and a ZEROED record could not tell us whether attach
    # peeked.  The poison keeps that contract under test where a clear would silently delete it; the
    # value is deterministic, so a run that depends on the record's contents can no longer depend on
    # the stack instead.
    memset((cast: (@: void) (@ parent_sched)), 170, c.sizeof(c.LmxSchedule))
    memset((cast: (@: void) (@ kid_sched)), 170, c.sizeof(c.LmxSchedule))
    memset((cast: (@: void) (@ fail_sched)), 170, c.sizeof(c.LmxSchedule))
    memset((cast: (@: void) (@ live_sched)), 170, c.sizeof(c.LmxSchedule))
    memset((cast: (@: void) (@ manager)), 0, c.sizeof(c.LmxManager))
    memset((cast: (@: void) (@ service)), 0, c.sizeof(c.LmxService))
    if: lmx_arena_open(@ parent_arena) != 0 || lmx_arena_open(@ kid_arena) != 0 || lmx_arena_open(@ fail_arena) != 0 || lmx_arena_open(@ live_arena) != 0
        fputs("lmx_settle: an arena did not open\n", l1_stdout())
        free(counts)
        return: 2
    ---
    if: lmx_manager_init(@ manager) != c.LMX_MANAGER_OK || lmx_service_open(@ service) != c.LMX_SERVICE_OK
        fputs("lmx_settle: the schedule or the service did not open\n", l1_stdout())
        free(counts)
        return: 2
    ---

    # The parent: index 1, a graph with four slots (two children live in slots 0 and 1).
    parent_msg: st_message(@ parent_arena, 1U, 4U)
    if: parent_msg = 0
        fputs("lmx_settle: the parent did not build\n", l1_stdout())
        free(counts)
        return: 2
    ---
    parent_graph: parent_msg\graph
    parent_t: st_object(@ parent_arena, parent_msg, @ parent_sched)
    if: parent_t = 0 || lmx_schedule_init(@ parent_sched, @ parent_arena, (cast: (@: void) parent_t), 8U) != c.LMX_SCHEDULE_OK
        fputs("lmx_settle: the parent's object did not build\n", l1_stdout())
        free(counts)
        return: 2
    ---

    # Three children, each in its OWN arena (which is also its own schedule band).
    #   kid  -- finished successfully: must be reclaimed;
    #   fail -- finished unsuccessfully: must be adopted, its root retained;
    #   live -- still running: must not be touched.
    kid_msg: st_message(@ kid_arena, 1U, 1U)
    kid_cell: lmx_arena_take(@ kid_arena, 1U, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT)
    kid_t: st_object(@ kid_arena, kid_msg, @ kid_sched)
    if: kid_msg = 0 || kid_cell = 0 || kid_t = 0 || lmx_schedule_init(@ kid_sched, @ kid_arena, (cast: (@: void) kid_t), 8U) != c.LMX_SCHEDULE_OK
        fputs("lmx_settle: the successful child did not build\n", l1_stdout())
        free(counts)
        return: 2
    ---
    kid_msg\running: 0
    kid_msg\success: 1
    kid_msg\handoff_ready: 1

    fail_msg: st_message(@ fail_arena, 2U, 1U)
    fail_cell: lmx_arena_take(@ fail_arena, 1U, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT)
    fail_t: st_object(@ fail_arena, fail_msg, @ fail_sched)
    if: fail_msg = 0 || fail_cell = 0 || fail_t = 0 || lmx_schedule_init(@ fail_sched, @ fail_arena, (cast: (@: void) fail_t), 8U) != c.LMX_SCHEDULE_OK
        fputs("lmx_settle: the failed child did not build\n", l1_stdout())
        free(counts)
        return: 2
    ---
    fail_msg\running: 0
    fail_msg\success: 0
    fail_msg\handoff_ready: 1

    live_msg: st_message(@ live_arena, 3U, 1U)
    live_cell: lmx_arena_take(@ live_arena, 1U, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT)
    live_t: st_object(@ live_arena, live_msg, @ live_sched)
    if: live_msg = 0 || live_cell = 0 || live_t = 0 || lmx_schedule_init(@ live_sched, @ live_arena, (cast: (@: void) live_t), 8U) != c.LMX_SCHEDULE_OK
        fputs("lmx_settle: the running child did not build\n", l1_stdout())
        free(counts)
        return: 2
    ---

    # The family: the two finished children are the parent's own children, published in its
    # graph (index 1 -> slot 0, index 2 -> slot 1), in its schedule and in its service.
    lmx_arena_ref_store(parent_graph, 0U, (cast: (@: void) kid_msg))
    lmx_arena_ref_store(parent_graph, 1U, (cast: (@: void) fail_msg))
    if: lmx_thread_child_add(parent_t, kid_t, @ parent_arena) != c.LMX_THREAD_OK || lmx_thread_child_add(parent_t, fail_t, @ parent_arena) != c.LMX_THREAD_OK || lmx_thread_child_add(parent_t, live_t, @ parent_arena) != c.LMX_THREAD_OK
        fputs("lmx_settle: the children did not join the parent\n", l1_stdout())
        free(counts)
        return: 2
    ---
    if: lmx_manager_add(@ manager, @ kid_sched) != c.LMX_MANAGER_OK || lmx_manager_add(@ manager, @ fail_sched) != c.LMX_MANAGER_OK || lmx_manager_add(@ manager, @ live_sched) != c.LMX_MANAGER_OK
        fputs("lmx_settle: the records did not join the schedule\n", l1_stdout())
        free(counts)
        return: 2
    ---
    if: lmx_service_register(@ service, kid_t, @ kid_arena) != 0 || lmx_service_register(@ service, fail_t, @ fail_arena) != 0 || lmx_service_register(@ service, live_t, @ live_arena) != 0
        fputs("lmx_settle: the records did not join the service\n", l1_stdout())
        free(counts)
        return: 2
    ---

    # BEFORE: the parent's index knows nothing of either child's own cells -- each answer is
    # the child's OWN arena's until the settling decides otherwise.
    st_check(counts, lmx_range_classify(@ parent_arena, kid_cell) = c.LMX_KIND_NONE, "the parent's index answered for a child's cell before the settle")
    st_check(counts, lmx_range_classify(@ parent_arena, fail_cell) = c.LMX_KIND_NONE, "the parent's index answered for a failed child's cell before the settle")
    st_check(counts, lmx_manager_count(@ manager) = 3U, "the schedule did not hold the three records")
    st_check(counts, lmx_service_count(@ service) = 3U, "the service did not hold the three records")

    st_check(counts, lmx_settle_children(parent_t, @ parent_arena, @ service, @ manager, lmx_clock_ticks()) = c.LMX_SETTLE_OK, "the settle refused")

    # (1) SUCCESS: reclaimed -- its slot in the parent's graph is clear and its arena is gone.
    st_check(counts, lmx_thread_child_is(parent_t, kid_t) = 0, "a settled successful child stayed a live direct child")
    st_check(counts, lmx_arena_ref_value(parent_graph, 0U) = 0, "the successful child's slot was not cleared")
    st_check(counts, lmx_range_classify(@ kid_arena, kid_cell) = c.LMX_KIND_NONE, "the successful child's arena was not released")

    # (2) FAILURE: adopted WITHOUT a copy -- the parent's index answers for the child's cell
    #     at the SAME address, and the slot still points at the failure root.
    st_check(counts, lmx_range_classify(@ parent_arena, fail_cell) != c.LMX_KIND_NONE, "the failed child's blocks did not join the parent")
    # ... at the SAME address, and with the child's own arena left empty: that pair is what
    # "transfer without copying" means here (lmx_arena_attach: "The attached arena is left
    # empty"), and it is why no address had to move.
    st_check(counts, lmx_range_classify(@ fail_arena, fail_cell) = c.LMX_KIND_NONE, "the adopted child's arena was not left empty: the transfer was a copy, not an attach")
    st_check(counts, lmx_arena_ref_value(parent_graph, 1U) = (cast: (@: void) fail_msg), "the parent did not retain the failure root")
    st_check(counts, lmx_thread_child_is(parent_t, fail_t) = 0, "a settled failed child stayed a live direct child")

    # (3) STILL RUNNING: untouched -- not stopped, not unlinked, storage where it was.
    st_check(counts, lmx_thread_child_is(parent_t, live_t) != 0, "a running child was unlinked")
    st_check(counts, live_msg\running != 0, "a running child was stopped")
    st_check(counts, live_msg\handoff_ready = 0, "a running child was marked handoff-safe")
    st_check(counts, lmx_range_classify(@ live_arena, live_cell) != c.LMX_KIND_NONE, "a running child's arena was touched")

    # (4) The route goes with the storage: the two settled children left the schedule and the
    #     service; the running one is still in both.
    st_check(counts, lmx_manager_count(@ manager) = 1U, "the settled children did not leave the schedule")
    st_check(counts, lmx_service_count(@ service) = 1U, "the settled children did not leave the service")

    # (5) THE STOP IS A REQUEST, AND THE WINDOW IS WHAT CLOSES IT (spec 32 -> 19.29.8, model of
    #     19.09).  The parent asks its child to close -- `running=0`, and the moment of the ask goes
    #     into the parent's own node.  The child has reached no boundary of its own and nobody runs
    #     it, so the wait is what ends it, by ITS OWN band's window (8U in this file): before the
    #     window nothing is closed -- `handoff_ready` stays 0 and the settle takes nothing -- and at
    #     the window the maintenance rule closes it WITHOUT a turn (stopped AND handoff-safe, and
    #     the inbox is not the test: a stopped Message does not wait for letters).  The ordinary
    #     settle then takes it like any other finished child.
    #     WHY THE BOX IS NOT THE TEST: measured on tests\lmx_app_reroot_forbidden_selftest.lm1
    #     (run 3), where the old empty-box rule wrote the mark onto a child that was INSIDE its turn
    #     and the next boundary attached and freed its arena under it.
    base: lmx_clock_ticks()
    st_check(counts, lmx_stop_children(parent_t, base, 0U) = c.LMX_SETTLE_OK, "the stop request refused")
    st_check(counts, live_msg\running = 0, "the stop request did not reach the child")
    st_check(counts, live_msg\handoff_ready = 0, "the stop closed a child it had not waited for")
    st_check(counts, lmx_settle_ready(live_msg) = 0, "a child asked to close reads settlable at once")
    st_check(counts, lmx_settle_children(parent_t, @ parent_arena, @ service, @ manager, base) = c.LMX_SETTLE_OK, "the settle at the request refused")
    st_check(counts, lmx_thread_child_is(parent_t, live_t) != 0, "the asked child was settled before its window")
    st_check(counts, lmx_stop_children(parent_t, base + 9U, 0U) = c.LMX_SETTLE_OK, "the same request one window later refused")
    st_check(counts, live_msg\handoff_ready != 0, "a child that reached no boundary within its window was not closed")
    st_check(counts, lmx_settle_ready(live_msg) != 0, "the closed child did not become settlable")
    st_check(counts, lmx_settle_children(parent_t, @ parent_arena, @ service, @ manager, base + 9U) = c.LMX_SETTLE_OK, "the settle after the window refused")
    st_check(counts, lmx_thread_child_is(parent_t, live_t) = 0, "the closed child was not settled")
    st_check(counts, lmx_range_classify(@ parent_arena, live_cell) != c.LMX_KIND_NONE, "the stopped failed child's blocks did not join the parent")
    st_check(counts, lmx_manager_count(@ manager) = 0U, "the schedule was not empty after the stop and the settle")
    st_check(counts, lmx_service_count(@ service) = 0U, "the service was not empty after the stop and the settle")

    failures: counts[1]
    if: failures = 0
        c.printf("lmx_settle_selftest: %d checks, 0 failures\n", counts[0])
    else:
        c.printf("lmx_settle_selftest: %d checks, %d failures\n", counts[0], failures)
    ---
    free(counts)
    if: failures != 0
        return: 1
    ---
return: 0
