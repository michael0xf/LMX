FxAppend:
    private:
        @: first
        @: second
    return: @
    append:
        throws: copy(FxThrows\sequence)
        private: @: empty (copy(()))
        return: FxSeqConcat\concat(parts := (empty; first; second))

FxApply:
    private:
        @: operation
        @: args
    return: @
    apply:
        throws: copy(FxThrows\call)
        private: @: outcome FxTry\attempt(operation := operation; args := args)
        if: outcome\ok = 0
            throw: FxCallFailure(outcome)
        return: outcome\value

FxBuild:
    private:
        @: contract
        []char: bodyText
        @: state
        @: failures
        @: policy 0
    return: @
    make:
        throws: FxIndex FxKernelFailure FxTypeToken
        private: @: shape FxKernel\signature(subject := contract)
        private: @: bodyGraph sys\fromLmx(bodyText)
        private: @: selectedPolicy policy
        if: selectedPolicy = 0
            selectedPolicy := FxOwnPolicy\make(contract)
        return: FxKernel\callable(contract; shape\names; bodyGraph; state; failures; selectedPolicy)

FxCaptureFailures:
    return: @
    names:
        private: @: out (copy(()))
        sys\resize(out; 1)
        out[0] := "FxRecordArity"
        return: out

FxCaptureOne:
    private:
        @: requirement
        @: sourceRecord
    return: @
    capture:
        throws: copy(FxThrows\selection) FxRecordArity
        private: @: receiver FxRecordAdapter\make(requirement)
        return: receiver(p0 := \sourceRecord)

FxCapturePrefix:
    private:
        @: inputTypes
        @: prefix
    return: @
    capture:
        throws: copy(FxThrows\capture)
        if: length(prefix) > length(inputTypes)
            throw: FxArity()
        private: @: captured (copy(()))
        sys\resize(captured; length(prefix))
        private: int: i 0
        while: i < length(prefix)
            captured[i] := FxCaptureOne\capture(inputTypes[i]; FxSeqRead\read(prefix; i))
            i += 1
        return: captured

FxConcat:
    private:
        []char: first
        []char: second
    return: []char
    concat:
        throws: copy(FxThrows\sequence)
        private: @: out FxSeqConcat\concat(parts := (first; second))
        return: \out

FxDecimal:
    private: int: number
    return: []char
    decimal:
        throws: copy(FxThrows\selection)
        if: number < 0
            throw: FxIndex()
        return: FxFormat\format(number)

FxEngineState:
    @: engine 0
    @: payload 0

FxEqualFields:
    private:
        @: first
        @: second
        @: same 0
    required: first second
    return: int
    equalFields:
        throws: copy(FxThrows\predicate)
        FxSeqInfo\get(first)
        FxSeqInfo\get(second)
        if: length(first) != length(second)
            return: 0
        return: FxSequenceDifference\find(
            first := first;
            second := second;
            same := same;
            count := length(first)
        ) < 0

FxEqualityTypes:
    array:
        []: value

FxFailureFilter:
    private:
        @: names
        []char: excluded
    return: @
    without:
        private: @: out (copy(()))
        sys\resize(out; length(names))
        private: int: used 0
        private: int: i 0
        while: i < length(names)
            private: []char: name \names[i]
            if: FxEqualFields\equalFields(name; excluded) = 0
                out[used] := names[i]
                used += 1
            i += 1
        sys\resize(out; used)
        return: out

FxFailures:
    private:
        @: first
        @: second
    return: @
    union:
        throws: copy(FxThrows\sequence)
        # Builder интернирует и устраняет повторные имена. Список не фиксирован.
        return: FxAppend\append(first; second)

FxFormat:
    private:
        bigint: value
        int: base 10
    return: []char
    format:
        throws: copy(FxThrows\selection)
        if: base < 2 || base > 36
            throw: FxIndex()
        private: []char: digits "0123456789abcdefghijklmnopqrstuvwxyz"
        private: bigint: magnitude value
        private: int: negative value < 0
        if: negative != 0
            magnitude := -magnitude
        private: []char: out []
        private: @: info FxSeqInfo\get(out)
        while: 1
            private: int: digit magnitude % base
            private: int: at length(out)
            sys\resize(out; FxSeqSize\sum(at; 1; info\maxLength))
            out[at] := digits[digit]
            magnitude := magnitude / base
            if: magnitude = 0
                break
        ---
        if: negative != 0
            out := \FxSeqConcat\concat((out; "-"))
        return: \FxSeqReverse\reverse(out)

FxForwardEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws: copy(FxThrows\call)
        return: FxFrameApply\apply(frame)

FxFrameApply:
    private: @: frame
    return: @
    apply:
        throws: copy(FxThrows\call)
        private: @: outcome FxFrameAttempt\attempt(frame)
        if: outcome\ok = 0
            throw: FxCallFailure(outcome)
        return: outcome\value

FxFrameAttempt:
    private: @: frame
    return: @
    attempt:
        throws: copy(FxThrows\kernel)
        return: FxKernel\enter(frame; frame\failures)

FxFrameRead:
    private:
        @: frame
        int: index
    return: @
    read:
        throws: FxCallFailure FxIndex FxKernelFailure FxTypeToken
        private: @: slot FxKernel\frameSlot(frame; index; demand := 1)
        return: slot\value

FxFrameSnapshot:
    private: @: frame
    return: @
    snapshot:
        throws: copy(FxThrows\snapshot)
        private: @: out (copy(()))
        sys\resize(out; length(frame\inputTypes))
        private: int: i 0
        while: i < length(out)
            private: @: value FxFrameRead\read(frame; i)
            out[i] := FxCaptureOne\capture(frame\inputTypes[i]; value)
            i += 1
        return: out

FxFullPolicy:
    private: @: operation
    return: @
    make:
        throws: copy(FxThrows\adapter)
        private: @: info FxKernel\signature(operation)
        private: @: empty (copy(()))
        return: FxSourcePolicy\make(operation; FxIndices\make(0; length(info\inputTypes)); empty; empty; empty)

FxIndices:
    private:
        int: start
        int: count
    return: @
    make:
        throws: FxIndex
        if: start < 0 || count < 0
            throw: FxIndex()
        private: @: out (copy(()))
        sys\resize(out; count)
        private: int: i 0
        while: i < count
            out[i] := start + i
            i += 1
        return: out

FxInputPolicy:
    @: source 0
    @: positions 0
    @: boundPositions 0
    @: boundValues 0
    @: pendingPositions 0
    int: sourcePolicy 0

FxLabels:
    private: int: count
    return: @
    labels:
        throws: copy(FxThrows\selection)
        if: count < 0
            throw: FxIndex()
        private: @: out (copy(()))
        sys\resize(out; count)
        private: int: i 0
        while: i < count
            out[i] := FxConcat\concat("p"; FxDecimal\decimal(i))
            i += 1
        return: out

FxOne:
    private: @: value
    return: @
    make:
        private: @: out (copy(()))
        sys\resize(out; 1)
        out[0] := value
        return: out

FxOwnPolicy:
    private: @: contract
    return: @
    make:
        throws: FxIndex FxKernelFailure FxTypeToken
        private: @: info FxKernel\signature(contract)
        private: @: out (copy(FxInputPolicy))
        out\source := contract
        out\positions := FxIndices\make(0; length(info\inputTypes))
        out\boundPositions := (copy(()))
        out\boundValues := (copy(()))
        out\pendingPositions := (copy(()))
        return: out

FxPrefixPolicy:
    private:
        @: operation
        @: captured
    return: @
    make:
        throws: copy(FxThrows\adapter)
        private: @: info FxKernel\signature(operation)
        private: int: n length(info\inputTypes)
        private: int: k length(captured)
        if: k > n
            throw: FxArity()
        return: FxSourcePolicy\make(operation; FxIndices\make(k; n - k); FxIndices\make(0; k); captured; (copy(())))

FxPreparedOperands:
    private:
        @: left
        int: depth
        []@: right
    const: int: PASS_ARGS_AS_IS 0

FxRecordAdapter:
    private:
        @: typeToken
        @FxRecordConstructor: constructor 0
    required: typeToken
    return: @
    make:
        throws: copy(FxThrows\selection)
        private: @: inputType FxKernel\normalizeType(typeToken)
        private: @: noResult FxKernel\normalizeType(void)
        private: @: inputs FxKernel\signatureData(
            FxOne\make(inputType);
            noResult;
            FxLabels\labels(1)
        )
        private: @: state (copy(FxRecordAdapterState))
        state\record := FxRecordOperands\record
        private: @: resultType FxKernel\normalizeType(FxTypeTokens\reference[0])
        private: @: failures FxCaptureFailures\names()
        private: []char: body "return: (p0 node\\private\\state\\record)\n"
        if: constructor != 0
            state\constructor := constructor
            private: @: shape FxKernel\signature(constructor)
            resultType := shape\resultType
            failures := FxFailures\union(failures; shape\throws)
            body := "return: node\\private\\state\\constructor((p0 node\\private\\state\\record))\n"
        private: @: outputs FxKernel\signatureData((); resultType; ())
        Captured :: (
            private: copy(inputs)
            required: p0
            copy(outputs)
        )
        return: FxBuild\make(Captured; body; state; failures)

FxRecordAdapterState:
    @: record 0
    @FxRecordConstructor: constructor

FxSeqAdmit:
    private:
        @: target
        @: value
    required: target value
    return: @
    admit:
        throws: FxKernelFailure FxTypeToken SequenceElement
        return: FxKernel\arrayAdmit(target := target; value := value)

FxSeqAllocate:
    private:
        @: arrayType
        int: count
    required: arrayType count
    return: @
    make:
        throws: FxKernelFailure FxTypeToken SequenceSize
        if: count < 0
            throw: SequenceSize()
        private: @: out (arrayType: [])
        private: @: info FxSeqInfo\get(out)
        if: count > info\maxLength
            throw: SequenceSize()
        sys\resize(out; count)
        return: out

FxSeqBounds:
    private:
        @: source
        int: begin
        int: end
    required: source begin end
    return: int
    count:
        throws: FxKernelFailure FxTypeToken ReceiverIndex
        FxSeqInfo\get(source)
        if: begin < 0 || end < begin || end > length(source)
            throw: ReceiverIndex()
        return: end - begin

FxSeqConcat:
    private: @: parts
    required: parts
    return: @
    concat:
        throws: copy(FxThrows\sequence)
        FxSeqInfo\get(parts)
        private: int: count length(parts)
        private: @: arrayType []@
        private: @: elementType
        private: int: allDense 1
        private: int: i 0
        # Inspect all parts, including empty dense parts. Comparison uses
        # canonical full element TypeRef references from the common type resolver.
        while: i < count
            private: @: part FxSeqRead\read(parts; i)
            private: @: info FxSeqInfo\get(part)
            if: i = 0
                arrayType := info\arrayType
                elementType := info\elementType
            if: info\dense = 0 || info\elementType != elementType
                allDense := 0
            i += 1
        if: count = 0 || allDense = 0
            arrayType := []@
        private: @: out FxSeqAllocate\make(arrayType; 0)
        private: @: outInfo FxSeqInfo\get(out)
        private: int: total 0
        i := 0
        while: i < count
            private: @: part FxSeqRead\read(parts; i)
            total := FxSeqSize\sum(total; length(part); outInfo\maxLength)
            i += 1
        sys\resize(out; total)
        private: int: at 0
        i := 0
        while: i < count
            private: @: part FxSeqRead\read(parts; i)
            private: int: partSize length(part)
            private: int: j 0
            while: j < partSize
                private: @: value FxSeqRead\read(part; j)
                FxKernel\arrayWrite(target := out; index := at; value := value)
                at += 1
                j += 1
            i += 1
        return: out

FxSeqInfo:
    private: @: source
    required: source
    return: @
    get:
        throws: copy(FxThrows\kernel)
        return: FxKernel\arrayInfo(source := source)

FxSeqInteger:
    private: @: value
    required: value
    return: int
    read:
        throws: SequenceElement
        private: int: sample 0
        if: sys\typeof(value) != sys\typeof(@sample)
            throw: SequenceElement()
        return: \value

FxSeqPredicate:
    private: @: value
    required: value
    return: int
    truth:
        throws: FxPredicate
        private: int: sample 0
        if: sys\typeof(value) != sys\typeof(@sample)
            throw: FxPredicate()
        private: int: flag \value
        return: flag != 0

FxSeqRead:
    private:
        @: source
        int: index
    required: source index
    return: @
    read:
        throws: FxKernelFailure FxTypeToken ReceiverIndex
        return: FxKernel\arrayRead(source := source; index := index)

FxSeqReverse:
    private: @: source
    required: source
    return: @
    reverse:
        throws: copy(FxThrows\sequence)
        private: @: info FxSeqInfo\get(source)
        private: int: count length(source)
        private: @: out FxSeqAllocate\make(info\arrayType; count)
        private: int: i 0
        while: i < count
            private: @: value FxSeqRead\read(source; count - 1 - i)
            FxKernel\arrayWrite(target := out; index := i; value := value)
            i += 1
        return: out

FxSeqSize:
    private:
        int: base
        int: extra
        int: limit
    required: base extra limit
    return: int
    sum:
        throws: SequenceSize
        if: base < 0 || extra < 0 || base > limit
            throw: SequenceSize()
        if: extra > limit - base
            throw: SequenceSize()
        return: base + extra

FxSeqSlice:
    private:
        @: source
        int: begin
        int: end
    required: source begin end
    return: @
    slice:
        throws: copy(FxThrows\sequence)
        private: int: count FxSeqBounds\count(source; begin; end)
        private: @: info FxSeqInfo\get(source)
        private: @: out FxSeqAllocate\make(info\arrayType; count)
        private: int: i 0
        while: i < count
            private: @: value FxSeqRead\read(source; begin + i)
            FxKernel\arrayWrite(target := out; index := i; value := value)
            i += 1
        return: out

FxSeqStore:
    private:
        @: target
        int: index
        @: value
    required: target index value
    write:
        throws: FxKernelFailure FxTypeToken ReceiverIndex SequenceElement
        private: @: ready FxSeqAdmit\admit(target; value)
        FxKernel\arrayWrite(target := target; index := index; value := ready)

FxSequenceDifference:
    private:
        @: first
        @: second
        @: same 0
        int: firstStart 0
        int: count
        int: secondStart 0
    required: first second count
    return: int
    find:
        throws: copy(FxThrows\predicate)
        FxSeqInfo\get(first)
        FxSeqInfo\get(second)
        if: firstStart < 0 || secondStart < 0 || count < 0
            throw: ReceiverIndex()
        if: firstStart > length(first) || secondStart > length(second)
            throw: ReceiverIndex()
        if: count > length(first) - firstStart || count > length(second) - secondStart
            throw: ReceiverIndex()
        private: int: i 0
        while: i < count
            if: FxValueSame\test(
                FxSeqRead\read(first; firstStart + i);
                FxSeqRead\read(second; secondStart + i);
                same
            ) = 0
                return: i
            i += 1
        return: -1

FxSignatures:
    private:
        @: inputs
        @: result
    return: @
    make:
        throws: copy(FxThrows\selection)
        private: @: labels FxLabels\labels(length(inputs))
        private: @: data FxKernel\signatureData(inputs := inputs; result := result; labels := labels)
        Built :: data
        return: Built

FxSlice:
    private:
        []@: values
        int: start
        int: count
    return: @
    slice:
        throws: copy(FxThrows\selection)
        if: start < 0 || count < 0 || start > length(values)
            throw: FxIndex()
        if: count > length(values) - start
            throw: FxIndex()
        return: FxSeqSlice\slice(source := values; begin := start; end := start + count)

FxSourcePolicy:
    private:
        @: operation
        @: positions
        @: boundPositions
        @: boundValues
        @: pendingPositions
    return: @
    make:
        throws: copy(FxThrows\adapter)
        private: @: info FxKernel\signature(operation)
        private: int: n length(info\inputTypes)
        if: length(boundPositions) != length(boundValues)
            throw: FxArity()
        private: @: covered (copy(()))
        sys\resize(covered; n)
        private: int: i 0
        while: i < n
            covered[i] := 0
            i += 1
        private: @: groups (positions; boundPositions; pendingPositions)
        private: int: group 0
        while: group < length(groups)
            private: @: values groups[group]
            private: int: j 0
            while: j < length(values)
                private: int: at \values[j]
                if: at < 0 || at >= n
                    throw: FxIndex()
                if: \covered[at] != 0
                    throw: FxArity()
                covered[at] := 1
                j += 1
            group += 1
        i := 0
        while: i < n
            if: \covered[i] = 0
                throw: FxArity()
            i += 1
        private: @: out (copy(FxInputPolicy))
        out\source := operation
        out\positions := FxSlice\slice(positions; 0; length(positions))
        out\boundPositions := FxSlice\slice(boundPositions; 0; length(boundPositions))
        out\boundValues := FxSlice\slice(boundValues; 0; length(boundValues))
        out\pendingPositions := FxSlice\slice(pendingPositions; 0; length(pendingPositions))
        out\sourcePolicy := 1
        return: out

FxStageFailures:
    return: @
    names:
        private: @: out (copy(()))
        sys\resize(out; 5)
        out[0] := "FxIndex"
        out[1] := "FxArity"
        out[2] := "FxRecordArity"
        out[3] := "FxTypeToken"
        out[4] := "FxKernelFailure"
        return: out

