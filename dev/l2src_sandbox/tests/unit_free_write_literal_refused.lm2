# No visible/formal/hidden k exists in peek. Its k:1U defines a Structure
# containing unsigned1; m's unrelated local k does not change that role.
# Established hidden-input writes are tested separately with an outer binding.
fn: peek () int
    k: 1U
    return: 0
fn: m () int
    int: k 5
    int: t 0
    t: peek()
    return: t
int: r 0
r: m()
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
