fn: repeat () int
    int: i 0
    ---
        i: i + 1
    until: i = 3
    return: i
end: repeat
Repeat:
    x: x + 1
until: x = 2
Data:
    int: x 0
end: Data
int: result repeat()
int: before_call Data\x
call: Repeat Data
int: after_call Data\x
fn: condition () int (int: calls 0)
    calls: calls + 1
    return: calls >= 2
end: condition
fn: transitions () int
    int: attempt 0
    ---
        attempt: attempt + 1
        if: attempt = 1
            redo()
        end: if
        if: attempt = 2
            continue()
        end: if
    until: condition()
    return: attempt
end: transitions
fn: leave () int
    int: n 0
    ---
        n: n + 1
        break()
    until: condition()
    return: n
end: leave
fn: early () int
    ---
        return: 9
    until: condition()
end: early
fn: body_fields () int
    late: 4
    ---
        int: late
    until: late = 4
    return: late
end: body_fields
int: transitioned transitions()
int: left leave()
int: early_result early()
int: from_body body_fields()
int: condition_calls condition\var\calls
int: root_value 0
---
    root_value: root_value + 1
    continue()
until: root_value = 2
RepeatOwn:
    var:
        int: x 0
    end: var
    x: x + 1
until: x = 2
int: own_before RepeatOwn\var\x
call: RepeatOwn
int: own_after RepeatOwn\var\x
Self:
    int: x 0
    x: x + 1
until: x = 2
call: Self Self
int: same_data Self\x
fn: bare_body () int
    int: i 1
    ---
        i
    until: 1
    return: i
end: bare_body
int: bare_result bare_body()
