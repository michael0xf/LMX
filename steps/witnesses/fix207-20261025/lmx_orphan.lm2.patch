--- /dev/null
+++ b/src/l2src/lmx_orphan.lm2
@@ -0,0 +1,185 @@
+predef: "l2src/lmx_orphan.h.lm1"
+predef: "l2src/lmx_thread.h.lm1"
+predef: "l2src/lmx_post.h.lm1"
+predef: "l2src/lmx_reparent.h.lm1"
+
+# Retention is policy over the owner's sole children Array, not a second list.
+fn: lmx_orphan_init (@: ledger c.LmxOrphanLedger; @: owner c.LmxThread) int
+    if: ledger = 0 || owner = 0 || c.lmx_thread_children(owner) = 0
+        return: c.LMX_ORPHAN_INVALID
+    ledger\owner: owner
+    ledger\reclaimed: 0U
+    return: c.LMX_ORPHAN_OK
+
+fn: lmx_orphan_count (@: ledger c.LmxOrphanLedger) size_t
+    size_t: index 0U
+    size_t: count 0U
+    @: child c.LmxThread
+    @: owner c.LmxThread
+    if: ledger = 0 || ledger\owner = 0
+        return: 0U
+    owner: ledger\owner
+    while: index < c.lmx_thread_child_count(owner)
+        child: c.lmx_thread_child_at(owner, index)
+        if: child != 0 && child\orphaned != 0
+            count: count + 1U
+        ---
+        index: index + 1U
+    ---
+    return: count
+
+fn: lmx_orphan_reclaimed (@: ledger c.LmxOrphanLedger) size_t
+    if: ledger = 0
+        return: 0U
+    return: (cast: (size_t) ledger\reclaimed)
+
+fn: lmx_orphan_adopt (@: ledger c.LmxOrphanLedger; @: orphan c.LmxMsg; @: orphan_arena c.LmxArena; @: thread c.LmxThread; @: service c.LmxService; @: manager c.LmxManager; ulong: now; ulong: limit) int
+    @: old_parent c.LmxThread
+    @: owner c.LmxThread
+    @: old_parent_arena c.LmxArena
+    @: owner_slot c.LmxSchedule
+    @: old_slot c.LmxSchedule
+    @: slot c.LmxSchedule
+    @: owner_arena c.LmxArena
+    int: registered 0
+    int: owner_status
+    if: ledger = 0 || ledger\owner = 0 || orphan = 0 || orphan_arena = 0 || thread = 0 || limit = 0U
+        return: c.LMX_ORPHAN_INVALID
+    slot: thread\slot
+    if: c.lmx_thread_message(thread) != orphan || slot = 0 || slot\arena != orphan_arena || thread\orphaned != 0
+        return: c.LMX_ORPHAN_INVALID
+    owner: ledger\owner
+    old_parent: c.lmx_thread_parent(thread)
+    if: old_parent = owner || old_parent = 0
+        return: c.LMX_ORPHAN_INVALID
+    owner_status: c.lmx_reparent_preflight(thread, owner)
+    if: owner_status = c.LMX_REPARENT_OWNER
+        return: c.LMX_ORPHAN_OWNER_REFUSED
+    if: owner_status != c.LMX_REPARENT_OK
+        return: c.LMX_ORPHAN_INVALID
+    old_parent_arena: 0
+    old_slot: old_parent\slot
+    if: old_slot != 0
+        old_parent_arena: old_slot\arena
+    ---
+    if: old_parent_arena = 0 || c.lmx_thread_child_remove(old_parent, thread) != c.LMX_THREAD_OK
+        return: c.LMX_ORPHAN_INVALID
+    owner_slot: owner\slot
+    owner_arena: owner_slot\arena
+    if: c.lmx_thread_child_add(owner, thread, owner_arena) != c.LMX_THREAD_OK
+        c.lmx_thread_child_add(old_parent, thread, old_parent_arena)
+        return: c.LMX_ORPHAN_FULL
+    if: service != 0 && c.lmx_thread_service(thread) = 0
+        if: c.lmx_service_register(service, thread, orphan_arena) != c.LMX_SERVICE_OK
+            c.lmx_thread_child_remove(owner, thread)
+            c.lmx_thread_child_add(old_parent, thread, old_parent_arena)
+            return: c.LMX_ORPHAN_INVALID
+        ---
+        registered: 1
+    ---
+    if: c.lmx_schedule_wait(slot, now) != c.LMX_SCHEDULE_OK
+        if: registered != 0
+            c.lmx_service_unregister(service, thread)
+        ---
+        c.lmx_thread_child_remove(owner, thread)
+        c.lmx_thread_child_add(old_parent, thread, old_parent_arena)
+        return: c.LMX_ORPHAN_INVALID
+    if: manager != 0 && c.lmx_manager_add(manager, slot) != c.LMX_MANAGER_OK
+        if: registered != 0
+            c.lmx_service_unregister(service, thread)
+        ---
+        c.lmx_thread_child_remove(owner, thread)
+        c.lmx_thread_child_add(old_parent, thread, old_parent_arena)
+        return: c.LMX_ORPHAN_INVALID
+    thread\orphaned: 1
+    thread\orphan_started: now
+    thread\orphan_limit: limit
+    return: c.LMX_ORPHAN_OK
+
+# Mailbox close MUST precede unregister/remove/release, and each refusal is kept.
+fn: lmx_orphan_reclaim (@: ledger c.LmxOrphanLedger; @: service c.LmxService; @: child c.LmxThread) int
+    @: arena c.LmxArena
+    @: owner c.LmxThread
+    @: slot c.LmxSchedule
+    if: ledger = 0 || ledger\owner = 0 || child = 0 || child\orphaned = 0 || child\slot = 0
+        return: c.LMX_ORPHAN_INVALID
+    slot: child\slot
+    arena: slot\arena
+    if: arena = 0
+        return: c.LMX_ORPHAN_INVALID
+    if: c.lmx_thread_mail_close(arena, child) != c.LMX_POST_OK
+        return: c.LMX_ORPHAN_INVALID
+    if: service != 0
+        if: c.lmx_service_unregister(service, child) != c.LMX_SERVICE_OK
+            return: c.LMX_ORPHAN_INVALID
+        ---
+    ---
+    owner: ledger\owner
+    if: c.lmx_thread_child_remove(owner, child) != c.LMX_THREAD_OK
+        return: c.LMX_ORPHAN_INVALID
+    child\orphaned: 0
+    child\orphan_started: 0U
+    child\orphan_limit: 0U
+    c.lmx_arena_release(arena)
+    ledger\reclaimed: ledger\reclaimed + 1U
+    return: c.LMX_ORPHAN_OK
+
+fn: lmx_orphan_maintain (@: ledger c.LmxOrphanLedger; @: service c.LmxService; @: manager c.LmxManager; ulong: now) int
+    size_t: index 0U
+    @: child c.LmxThread
+    @: owner c.LmxThread
+    @: message c.LmxMsg
+    int: reclaim
+    if: ledger = 0 || ledger\owner = 0
+        return: c.LMX_ORPHAN_INVALID
+    owner: ledger\owner
+    while: index < c.lmx_thread_child_count(owner)
+        child: c.lmx_thread_child_at(owner, index)
+        if: child = 0
+            return: c.LMX_ORPHAN_INVALID
+        if: child\orphaned = 0
+            index: index + 1U
+        else:
+            message: c.lmx_thread_message(child)
+            if: message = 0 || child\orphan_limit = 0U
+                return: c.LMX_ORPHAN_INVALID
+            reclaim: 0
+            if: message\running = 0 && message\handoff_ready != 0
+                if: message\success != 0 || now - child\orphan_started >= child\orphan_limit
+                    reclaim: 1
+                ---
+            else:
+                if: now - child\orphan_started >= child\orphan_limit
+                    if: c.lmx_stop_request(child, now, 0U) != c.LMX_THREAD_OK || c.lmx_stop_close(child, now) != c.LMX_THREAD_OK
+                        return: c.LMX_ORPHAN_INVALID
+                    ---
+                ---
+            ---
+            if: reclaim != 0
+                if: lmx_orphan_reclaim(ledger, service, child) != c.LMX_ORPHAN_OK
+                    return: c.LMX_ORPHAN_INVALID
+                ---
+            else:
+                index: index + 1U
+            ---
+        ---
+    ---
+    return: c.LMX_ORPHAN_OK
+
+fn: lmx_orphan_release (@: ledger c.LmxOrphanLedger; @: service c.LmxService; @: manager c.LmxManager) int
+    size_t: index 0U
+    @: child c.LmxThread
+    @: owner c.LmxThread
+    if: ledger = 0 || ledger\owner = 0
+        return: c.LMX_ORPHAN_INVALID
+    owner: ledger\owner
+    while: index < c.lmx_thread_child_count(owner)
+        child: c.lmx_thread_child_at(owner, index)
+        if: child = 0
+            return: c.LMX_ORPHAN_INVALID
+        child\orphaned: 0
+        child\orphan_started: 0U
+        child\orphan_limit: 0U
+        index: index + 1U
+    ---
+    return: c.LMX_ORPHAN_OK
