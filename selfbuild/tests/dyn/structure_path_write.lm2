# Slice 277 (N4-U U3; the book, "Композиция места и значения"; LMX_blog/2026-11-03.md).  A Structure written through a path is assigned to the place the path reaches,
# after the admission, and nothing that stood there is called.  `Outer\Model()` and `Outer\Model: ()` give the place one empty Structure; a bare `Outer\Model` reads the
# reference; `call: Outer\Model` runs it.  A refusal keeps the old value.  Entry 7; 81.. name the failing check.
Other:
    int: z 9
    int: y 7
end: Other
Bad:
    int: nothing 1
end: Bad
Box:
    kid:
        int: y 3
    end: kid
end: Box
BoxFn:
    kid:
        int: y 3
    end: kid
end: BoxFn
BoxFormal:
    kid:
        int: y 3
    end: kid
end: BoxFormal
BoxRefused:
    kid:
        int: y 3
    end: kid
end: BoxRefused
kid:
    int: y 3
end: kid
Second:
    int: v 7
end: Second
D:
    int: y 3
    int: y 7
end: D
Outer:
    int: ran 0
    Model:
        int: v 1
    end: Model
    Empty:
    end: Empty
    Runs:
        node\ran := node\ran + 1
    end: Runs
end: Outer
Taken: (int: x 1)
Empty: ()
A()
B: ()
fn: write_fn () int
    BoxFn\kid := Other
    return: BoxFn\kid\y
end: write_fn
fn: write_formal (@: h BoxFormal) int
    h\kid := Other
    return: h\kid\y
end: write_formal
fn: write_node () int
    node\kid := Other
    return: node\kid\y
end: write_node
fn: read_occurrence () int
    @: held Second D\[1]y
    return: held\v
end: read_occurrence
fn: write_refused () int
    int: caught 0
    ---
        BoxRefused\kid := Bad
        catch: implements ()
            caught := 1
    ---
    return: caught
end: write_refused
fn: empty_refused () int
    int: caught 0
    ---
        Outer\Model()
        catch: implements ()
            caught := 1
    ---
    return: caught
end: empty_refused
fn: taken_refused () int
    int: caught 0
    ---
        Taken()
        catch: implements ()
            caught := 1
    ---
    return: caught
end: taken_refused
fn: count (@: p Empty) int
    return: 1
end: count
Box\kid := Other
D\[1]y := Second
Outer\Empty()
Outer\Empty: ()
int: code 7
if: Box\kid\y != 7
    code := 81
---
if: code = 7 && write_fn() != 7
    code := 82
---
if: code = 7 && (write_formal(BoxFormal) != 7 || BoxFormal\kid\y != 7)
    code := 83
---
if: code = 7 && write_node() != 7
    code := 84
---
if: code = 7 && read_occurrence() != 7
    code := 85
---
if: code = 7 && (write_refused() != 1 || BoxRefused\kid\y != 3)
    code := 86
---
if: code = 7 && (empty_refused() != 1 || Outer\Model\v != 1)
    code := 87
---
if: code = 7 && (taken_refused() != 1 || Taken\x != 1)
    code := 88
---
if: code = 7 && (count(Outer\Runs) != 1 || Outer\ran != 0)
    code := 89
---
call: Outer\Runs
if: code = 7 && Outer\ran != 1
    code := 90
---
if: code = 7 && (count(A) != 1 || count(B) != 1)
    code := 91
---
send: exit(exit_code: code; stdout: ""; stderr: "")
return
