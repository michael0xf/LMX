predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/tests/walk_contract_fixture.lm1"
predef: "l2src/lmx_primitive.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# THE PRIMITIVE INSERT, on graphs built by hand (DEEPSEEK-L2-PRIMITIVE-KERNEL-IMPLEMENT-20260921-27).
# What this file pins, and each line of it is a requirement of the ticket:
#
#   * RECOGNITION IS PHYSICAL: a node names its record by address and the walk admits it by
#     CLASSIFYING that address (LMX_DOMAIN_KIND_PRIMITIVE).  A record that is not a primitive --
#     a plain Structure, a record with no fn -- is refused whatever its shape.
#   * k.4 (next_core_tasks.md §3 item 9; no cached plan, no separate prepare pass -- lmx_walk_prepare
#     is gone with lmx_plan): every check that used to run once "at preparation" now runs every
#     time the PRIM node is actually reached and evaluated, in lmx_walk_prim itself, not before.  A
#     violation inside a branch that is never taken is therefore never caught -- there is nothing
#     left that scans the whole body ahead of running it.  THE IMMUTABLE-PROFILE OWNER REFUSAL:
#     a primitive whose owner lives in the exact immutable profile is refused when its PRIM step
#     actually runs (lmx_walk_immutable, asked unconditionally now, not gated by a counting pass).
#   * STATUS IS NOT VALUE: a primitive that returns VALUE 0 with status OK is NOT a failure (the
#     value is absence of a value, reported as such); a nonzero status leaves as
#     LMX_WALK_PRIMITIVE, a status that collides with none of the four readings it must stay
#     distinct from.
#   * NO ROLLBACK, AND NONE PRETENDED: what a failing primitive wrote before it failed STANDS.
#   * A FAILED PRIMITIVE LEAVES NOTHING BEHIND: the scratch slice it was given is rewound, and the
#     next activation runs normally.
#   * THE REGISTRY IS MECHANISM ONLY: open, admit into a slot, look up.  Which primitives exist is
#     registration's act and is not tested here.
#   * A PRIMITIVE record in ordinary graph storage is copied with its signature
#     and owner. Only an explicitly retained qualified profile keeps its address.
#
# FIXED (steps/native-word-191.md): lmx_walk_prim used to read `record\fn` through whatever
# operand it was handed WITHOUT first classifying it as LMX_DOMAIN_KIND_PRIMITIVE -- the
# classification guard that used to live in the deleted counting pass was not carried over to
# the always-run path when the immutable check was.  It now classifies the operand
# unconditionally before the cast, the same way lmx_walk_slot does for OWN/SET/PUT holders.
# m_peer below (a Structure where a primitive record is expected) exercises that guard directly.

@: LmxArena ga 0
@: Lmx groles 0
@: LmxWalkContext gctx 0
@: LmxWalkValue gv 0
size_t: pv_calls 0U
int: broken 0
int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

# ---- the primitives themselves: three C functions and the status they report -----------------

fn: pv_ok (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code) int
    pv_calls: pv_calls + 1U
    if: dest = 0
        return: c.LMX_PRIMITIVE_FAIL
    ---
    lmx_int_store_known(dest, 7)
    \out: dest
return: c.LMX_PRIMITIVE_OK

# Source-backed actuals are evaluated once from their borrowed addresses.
fn: pv_sum (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code) int
    pv_calls: pv_calls + 1U
    if: dest = 0 || refs = 0 || nargs != 2U || refs[0] = 0 || refs[1] = 0
        return: c.LMX_PRIMITIVE_FAIL
    ---
    lmx_int_store_known(dest, lmx_int_value_known(refs[0]) + lmx_int_value_known(refs[1]))
    \out: dest
return: c.LMX_PRIMITIVE_OK

# Status OK, and NOTHING written: the caller must read this as no value, not as failure.
fn: pv_zero (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code) int
    pv_calls: pv_calls + 1U
    \out: 0
return: c.LMX_PRIMITIVE_OK

# Fails -- after writing into the first reference it was handed: the write STANDS, because there
# is no rollback engine and this kernel does not pretend to have one.
fn: pv_fail (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code) int
    pv_calls: pv_calls + 1U
    if: nargs > 0U && refs != 0 && refs[0] != 0
        lmx_int_store_known(lmx_pointer_value_known(refs[0]), 99)
    ---
    \out: 0
return: c.LMX_PRIMITIVE_FAIL

# ---- construction helpers (the same shapes the walk's own selftest uses) ----------------------

fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(ga, groles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(ga, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

sub: ref (@: Lmx code; size_t: slot; @: Lmx target)
    if: code = 0 || target = 0 || lmx_arena_ref_store(code, slot, (cast: (@: void) target)) != 0
        broken: broken + 1
    ---
end: ref

sub: sz (@: Lmx code; size_t: slot; size_t: value)
    if: code = 0 || lmx_walk_store_size(ga, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: sz

fn: lit (@: Lmx parent; size_t: slot; int: value) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_LIT, 2U)
    if: n != 0 && lmx_walk_store_int(ga, n, 1U, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
return: n

fn: icell (@: Lmx holder; size_t: slot; int: value) @: void
    if: holder = 0 || lmx_walk_store_int(ga, holder, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
        return: 0
    ---
return: lmx_arena_ref_value(holder, slot)

# k.4: an occurrence is an ordinary Structure with `native = 0` (the default lmx_node_new_owned
# already gives it) -- no descriptor, own fields/body steps start at slot 0.
fn: mk_m (@: Lmx unit; size_t: slot; size_t: children) @: Lmx
    @: Lmx m pl(unit, slot, children)
    if: m = 0
        broken: broken + 1
        return: 0
    ---
return: m

fn: record_new (@: LmxArena arena; LmxPrimitiveEntry: fn; @: Lmx owner; size_t: arity; int: input_type; int: result_type) @: Lmx
    @: LmxPrimitive r (cast: (@: LmxPrimitive) lmx_arena_take(arena, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))
    if: r = 0
        broken: broken + 1
        return: 0
    ---
    r\fn: fn
    r\signature: wt_contract_same(arena, arity, input_type, result_type)
    r\owner: owner
return: (cast: (@: Lmx) r)

fn: record_new_profiled (@: LmxArena arena; @: Lmx profile; LmxPrimitiveEntry: fn; @: Lmx owner; size_t: arity; int: input_type; int: result_type) @: Lmx
    @: LmxPrimitive r (cast: (@: LmxPrimitive) lmx_arena_take_profiled(arena, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE, profile))
    if: r = 0
        broken: broken + 1
        return: 0
    ---
    r\fn: fn
    r\signature: wt_contract_same(arena, arity, input_type, result_type)
    r\owner: owner
return: (cast: (@: Lmx) r)

# One direct call: the value comes back as a reference; an int result is read through it.
fn: go (@: Lmx m; @@: void args; size_t: nargs; @: int v) int
    int: st
    st: lmx_walk_run(gctx, m, args, nargs, gv)
    \v: gv\present
return: st

fn: main () int
    LmxArena: arena
    LmxArena: copied_arena
    LmxArena: context_arena
    LmxPool: context_cells
    LmxScratch: scratch
    LmxWalkContext: context
    @: LmxArena pca 0
    @: LmxArena ca 0
    @: LmxScratch ps 0
    @: LmxWalkContext pc 0
    @: Lmx registry 0
    @: Lmx admitted 0
    @: Lmx record 0
    @: Lmx reference 0
    @: LmxPrimitive bare 0
    @: Lmx rec_ok 0
    @: Lmx rec_null 0
    @: Lmx m_null 0
    @: Lmx rec_zero 0
    @: Lmx rec_fail 0
    @: Lmx rec_nofn 0
    @: Lmx rec_bound 0
    @: Lmx immutable_profile 0
    @: Lmx immutable_owner 0
    @: LmxPool immutable_structs 0
    @: LmxPool immutable_primitives 0
    @: Lmx unit 0
    @: Lmx subject 0
    @: Lmx peer 0
    @: Lmx m_ok 0
    @: Lmx m_zero 0
    @: Lmx m_fail 0
    @: Lmx m_nofn 0
    @: Lmx m_peer 0
    @: Lmx m_absent 0
    @: Lmx m_immutable 0
    @: Lmx m_hidden 0
    @: Lmx m_source 0
    @: Lmx source_prim 0
    @: Lmx source_body 0
    @: Lmx source_exit 0
    @: Lmx source_fields 0
    @: Lmx source_named0 0
    @: Lmx source_named1 0
    @: Lmx source_own 0
    @: Lmx source_arg 0
    @: Lmx source_subject 0
    @: Lmx external_actual 0
    @: Lmx m_inert 0
    @: Lmx inert_prim 0
    @: Lmx inert_body 0
    @: Lmx inert_actual 0
    @: Lmx m_direct 0
    @: Lmx direct_prim 0
    @: Lmx direct_fields 0
    @: Lmx direct_value 0
    @: Lmx direct_named 0
    @: Lmx copy_unit 0
    @: Lmx copy_m 0
    @: Lmx copy_m_arena 0
    @: Lmx copy_step 0
    @: Lmx copy_prim_step 0
    @: Lmx copy_record 0
    @: Lmx copy_record_arena 0
    @: Lmx copy_m_source 0
    @: Lmx copy_source_prim 0
    @: Lmx copy_source_body 0
    @: Lmx copy_source_exit 0
    @: Lmx copy_source_fields 0
    @: Lmx copy_named0 0
    @: Lmx copy_named1 0
    @: Lmx copy_subject 0
    @: Lmx copied_unit 0
    @: Lmx copied_m 0
    @: Lmx copied_m_arena 0
    @: Lmx copied_m_source 0
    @: LmxPrimitive copied_record 0
    @: void cell0 0
    int: st 0
    int: v 0
    int: input 4
    @: void input_ref (cast: (@: void) (@ input))
    size_t: calls_before 0U

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        fputs("lmx_primitive: arena\n", l1_stdout())
        return: 2
    ---
    pca: @ context_arena
    ps: @ scratch
    pc: @ context
    ga: @ arena
    groles: lmx_walk_roles_open(ga)
    memset((cast: (@: void) (@ context_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ scratch)), 0, c.sizeof(c.LmxScratch))
    if: lmx_arena_open(pca) != 0 || lmx_scratch_open(ps, pca, @ context_cells, 16U) != c.LMX_SCRATCH_OK
        fputs("lmx_primitive: context\n", l1_stdout())
        return: 2
    ---
    pc\arena: ga
    pc\scratch: ps
    pc\roles: groles
    pc\classified: 0U
    gctx: pc
    gv: (cast: (@: LmxWalkValue) calloc(1U, c.sizeof(c.LmxWalkValue)))
    unit: lmx_node_new_owned(ga)
    if: groles = 0 || gv = 0 || unit = 0 || lmx_arena_refs_open_owned(ga, unit, 14U) != 0
        fputs("lmx_primitive: unit\n", l1_stdout())
        return: 2
    ---

    # ---- the registry's mechanism and an exact immutable physical profile ---------------------
    check(lmx_primitive_registry_open(ga, 4U, @ registry) = c.LMX_PRIMITIVE_REG_OK && registry != 0, "the registry was not opened in its owner arena")
    if: registry = 0
        c.printf("lmx_primitive: no registry\n")
        return: 2
    ---
    check(lmx_primitive_record(registry, 0U) = 0 && lmx_primitive_record(registry, 3U) = 0, "a fresh registry already answers with records")
    check(lmx_primitive_register(ga, registry, 4U, pv_ok, 0, 0, @ record) = c.LMX_PRIMITIVE_REG_REFUSED, "a slot past the registry was admitted")
    # An OWNERLESS primitive is admitted: a pure function has nothing to act on, and requiring an
    # owner would be policy this unit does not own.  The design's motivating case (the mailbox)
    # does have one, and the immutable-profile rule below is what makes that case safe.
    check(lmx_primitive_register(ga, registry, 1U, pv_ok, 0, 0, @ record) = c.LMX_PRIMITIVE_REG_OK && record != 0, "an ownerless primitive was refused")
    immutable_profile: lmx_node_new_owned(ga)
    immutable_owner: lmx_node_new_profiled(ga, immutable_profile)
    admitted: record_new_profiled(ga, immutable_profile, pv_fail, immutable_owner, 0U, c.LMX_TYPE_INT, 0)
    check(immutable_profile != 0 && immutable_owner != 0 && admitted != 0, "the immutable profiled primitive was not built")
    if: immutable_profile != 0 && immutable_owner != 0 && admitted != 0
        lmx_arena_ref_store(registry, 0U, (cast: (@: void) admitted))
    ---
    check(lmx_primitive_record(registry, 0U) = admitted, "the registry does not answer with the record it admitted")
    check(lmx_range_classify(ga, admitted) = c.LMX_DOMAIN_KIND_PRIMITIVE && lmx_range_profile(ga, admitted) = immutable_profile, "the admitted record has no exact primitive profile")
    check(lmx_range_profile(ga, (cast: (@: void) immutable_owner)) = immutable_profile, "the primitive owner has no exact immutable profile")
    check(lmx_copy_is_terminal_profiled(ga, admitted, immutable_profile) = 1 && lmx_copy_is_terminal(ga, admitted) = 0, "only an explicit qualified profile retains a primitive record")
    immutable_structs: lmx_arena_find_profiled(ga, c.LMX_KIND_STRUCT, c.LMX_TYPE_STRUCT, immutable_profile)
    immutable_primitives: lmx_arena_find_profiled(ga, c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE, immutable_profile)
    check(immutable_structs != 0 && immutable_primitives != 0 && lmx_pool_seal(immutable_structs) = 0 && lmx_pool_seal(immutable_primitives) = 0, "immutable profile ranges did not seal")

    # The ordinary placement, for the bodies that must RUN: records of the graph's own arena.
    subject: pl(unit, 0U, 2U)
    cell0: icell(subject, 0U, 5)
    icell(subject, 1U, 35)
    peer: pl(unit, 1U, 2U)
    rec_ok: record_new(ga, pv_ok, peer, 0U, c.LMX_TYPE_INT, c.LMX_TYPE_INT)
    rec_null: record_new(ga, pv_zero, peer, 0U, c.LMX_TYPE_INT, c.LMX_TYPE_LMX)
    rec_zero: record_new(ga, pv_zero, peer, 0U, c.LMX_TYPE_INT, 0)
    rec_fail: record_new(ga, pv_fail, peer, 1U, c.LMX_TYPE_POINTER_BASE + 1, 0)
    # A record with NO fn: admitted to the arena as a cell of the domain, refused by the walk.
    rec_nofn: record_new(ga, pv_ok, peer, 0U, c.LMX_TYPE_INT, c.LMX_TYPE_INT)
    bare: (cast: (@: LmxPrimitive) rec_nofn)
    if: bare != 0
        bare\fn: 0
    ---
    rec_bound: admitted
    check(rec_ok != 0 && rec_zero != 0 && rec_fail != 0 && rec_nofn != 0, "a primitive record was not made")
    check(lmx_copy_is_terminal(ga, rec_ok) = 0, "ordinary primitive record is copied with its graph")

    # ---- the bodies: k.4 -- one slot each (no descriptor slot), the body step at 0 -------------
    # prim_ok:      return: prim(rec_ok)
    m_ok: mk_m(unit, 2U, 1U)
    record: fr(m_ok, 0U, c.LMX_WALK_OP_RET, 2U)
    reference: fr(record, 1U, c.LMX_WALK_OP_PRIM, 3U)
    ref(reference, 1U, rec_ok)
    # prim_zero:    return: prim(rec_zero)
    m_zero: mk_m(unit, 3U, 1U)
    record: fr(m_zero, 0U, c.LMX_WALK_OP_RET, 2U)
    reference: fr(record, 1U, c.LMX_WALK_OP_PRIM, 3U)
    ref(reference, 1U, rec_zero)
    m_null: mk_m(unit, 10U, 1U)
    record: fr(m_null, 0U, c.LMX_WALK_OP_RET, 2U)
    reference: fr(record, 1U, c.LMX_WALK_OP_PRIM, 3U)
    ref(reference, 1U, rec_null)
    # prim_fail:    return: prim(rec_fail, @subject\0)
    m_fail: mk_m(unit, 4U, 1U)
    record: fr(m_fail, 0U, c.LMX_WALK_OP_RET, 2U)
    reference: fr(record, 1U, c.LMX_WALK_OP_PRIM, 4U)
    ref(reference, 1U, rec_fail)
    record: fr(reference, 3U, c.LMX_WALK_OP_ADDRESS, 3U)
    lmx_arena_ref_store(record, 2U, wt_witness(ga, c.LMX_TYPE_POINTER_BASE + 1))
    record: fr(record, 1U, c.LMX_WALK_OP_AT, 3U)
    ref(record, 1U, subject)
    sz(record, 2U, 0U)
    # prim_nofn:    return: prim(rec_nofn)
    m_nofn: mk_m(unit, 5U, 1U)
    record: fr(m_nofn, 0U, c.LMX_WALK_OP_RET, 2U)
    reference: fr(record, 1U, c.LMX_WALK_OP_PRIM, 3U)
    ref(reference, 1U, rec_nofn)
    # prim_peer:    return: prim(peer)          -- a Structure is not a primitive record.
    # KNOWN GAP (see header): lmx_walk_prim does not classify this operand before reading it as
    # an LmxPrimitive, so this fixture is built for the record but deliberately NEVER RUN below.
    m_peer: mk_m(unit, 6U, 1U)
    record: fr(m_peer, 0U, c.LMX_WALK_OP_RET, 2U)
    reference: fr(record, 1U, c.LMX_WALK_OP_PRIM, 3U)
    ref(reference, 1U, peer)
    # prim_absent:  return: prim()              -- no record operand at all
    m_absent: mk_m(unit, 7U, 1U)
    record: fr(m_absent, 0U, c.LMX_WALK_OP_RET, 2U)
    reference: fr(record, 1U, c.LMX_WALK_OP_PRIM, 3U)
    # prim_immutable: return: prim(rec_bound)   -- record and owner use the immutable profile;
    # this PRIM step is reached directly, so k.4's always-run immutable check refuses it.
    m_immutable: mk_m(unit, 8U, 1U)
    record: fr(m_immutable, 0U, c.LMX_WALK_OP_RET, 2U)
    reference: fr(record, 1U, c.LMX_WALK_OP_PRIM, 3U)
    ref(reference, 1U, rec_bound)
    # prim_hidden:  if: 0 { prim(rec_bound) } else { }   -- k.4: the SAME immutable violation,
    # but inside a branch that is never taken.  There is no separate prepare pass to scan an
    # untaken branch any more, so this one is NOT refused -- it simply never runs.
    m_hidden: mk_m(unit, 9U, 2U)
    record: fr(m_hidden, 0U, c.LMX_WALK_OP_IF, 4U)
    lit(record, 1U, 0)
    reference: pl(record, 2U, 1U)
    @: Lmx hidden_else fr(m_hidden, 1U, c.LMX_WALK_OP_ELSE, 2U)
    pl(hidden_else, 1U, 0U)
    ref(record, 3U, hidden_else)
    record: fr(reference, 0U, c.LMX_WALK_OP_PRIM, 3U)
    ref(record, 1U, rec_bound)

    # PRIM slot 2 owns a plain source body. Slots 3 and 4 borrow its distinct
    # NAMED fields, whose payloads are physically nested OWN and ARG nodes.
    m_source: mk_m(unit, 11U, 2U)
    source_subject: pl(m_source, 1U, 2U)
    icell(source_subject, 1U, 35)
    record: fr(m_source, 0U, c.LMX_WALK_OP_RET, 2U)
    source_prim: fr(record, 1U, c.LMX_WALK_OP_PRIM, 5U)
    ref(source_prim, 1U, record_new(ga, pv_sum, peer, 2U, c.LMX_TYPE_INT, c.LMX_TYPE_INT))
    source_body: pl(source_prim, 2U, 1U)
    source_exit: fr(source_body, 0U, c.LMX_WALK_OP_SOURCE_INERT, 2U)
    source_fields: pl(source_exit, 1U, 2U)
    source_named0: fr(source_fields, 0U, c.LMX_WALK_OP_NAMED, 3U)
    sz(source_named0, 1U, 0U)
    source_own: fr(source_named0, 2U, c.LMX_WALK_OP_OWN, 3U)
    ref(source_own, 1U, source_subject)
    sz(source_own, 2U, 1U)
    source_named1: fr(source_fields, 1U, c.LMX_WALK_OP_NAMED, 3U)
    sz(source_named1, 1U, 1U)
    source_arg: fr(source_named1, 2U, c.LMX_WALK_OP_ARG, 4U)
    sz(source_arg, 1U, 0U)
    lit(source_arg, 2U, 0)
    ref(source_arg, 3U, wt_witness(ga, c.LMX_TYPE_INT))
    if: lmx_walk_source_mark(ga, groles, source_arg, c.LMX_WALK_SOURCE_ARG_ENTRY) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    ref(source_prim, 3U, source_named0)
    ref(source_prim, 4U, source_named1)

    # A borrowed SOURCE_INERT actual contributes no value and does not enter
    # its nested ARG_ENTRY; that ARG is deliberately out of range for the call.
    m_inert: mk_m(unit, 12U, 1U)
    record: fr(m_inert, 0U, c.LMX_WALK_OP_RET, 2U)
    inert_prim: fr(record, 1U, c.LMX_WALK_OP_PRIM, 4U)
    ref(inert_prim, 1U, record_new(ga, pv_ok, peer, 1U, c.LMX_TYPE_INT, c.LMX_TYPE_INT))
    inert_body: pl(inert_prim, 2U, 1U)
    inert_actual: fr(inert_body, 0U, c.LMX_WALK_OP_SOURCE_INERT, 2U)
    reference: fr(inert_actual, 1U, c.LMX_WALK_OP_ARG, 4U)
    sz(reference, 1U, 1U)
    lit(reference, 2U, 0)
    ref(reference, 3U, wt_witness(ga, c.LMX_TYPE_INT))
    if: lmx_walk_source_mark(ga, groles, reference, c.LMX_WALK_SOURCE_ARG_ENTRY) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    ref(inert_prim, 3U, inert_actual)

    # A borrowed slot may name a source frame directly or a NAMED whose
    # payload it owns. Each evaluated address is a distinct source-owned one.
    m_direct: mk_m(unit, 13U, 1U)
    record: fr(m_direct, 0U, c.LMX_WALK_OP_RET, 2U)
    direct_prim: fr(record, 1U, c.LMX_WALK_OP_PRIM, 5U)
    ref(direct_prim, 1U, record_new(ga, pv_sum, peer, 2U, c.LMX_TYPE_INT, c.LMX_TYPE_INT))
    reference: pl(direct_prim, 2U, 1U)
    reference: fr(reference, 0U, c.LMX_WALK_OP_SOURCE_INERT, 2U)
    direct_fields: pl(reference, 1U, 2U)
    direct_value: lit(direct_fields, 0U, 12)
    direct_named: fr(direct_fields, 1U, c.LMX_WALK_OP_NAMED, 3U)
    sz(direct_named, 1U, 1U)
    lit(direct_named, 2U, 30)
    ref(direct_prim, 3U, direct_value)
    ref(direct_prim, 4U, direct_named)

    check(broken = 0, "construction")
    if: broken != 0
        c.printf("lmx_primitive: %d construction steps failed\n", broken)
        return: 2
    ---
    record: 0

    # ---- boundary refusals: k.4 -- checked when the PRIM step actually runs, not before ---------
    # (lmx_walk_prepare/lmx_plan are gone; there is no separate whole-body scan any more.)
    pc\immutable_profile: immutable_profile
    v: -1
    st: go(m_nofn, 0, 0U, @ v)
    check(st = c.LMX_WALK_INVALID, "a primitive record with no fn was admitted")
    check(ps\used = 0U && ps\top = 0U, "a refused run left scratch occupied (m_nofn)")
    v: -1
    # k.4: a Structure where a primitive record is expected is refused by classification,
    # never read as an LmxPrimitive by a bare cast (the lmx_walk_prim fix this file exists
    # to pin). Mutant: drop the classification guard -> undefined read / RED here.
    st: go(m_peer, 0, 0U, @ v)
    check(st = c.LMX_WALK_INVALID, "a Structure in a PRIM node's record position was admitted")
    check(ps\used = 0U && ps\top = 0U, "a refused run left scratch occupied (m_peer)")
    v: -1
    st: go(m_absent, 0, 0U, @ v)
    check(st = c.LMX_WALK_INVALID, "a prim node with no record operand was admitted")
    check(ps\used = 0U && ps\top = 0U, "a refused run left scratch occupied (m_absent)")
    v: -1
    st: go(m_immutable, 0, 0U, @ v)
    check(st = c.LMX_WALK_INVALID, "a primitive whose owner is in the immutable profile was admitted: that is the escape hole")
    check(ps\used = 0U && ps\top = 0U, "a refused run left scratch occupied (m_immutable)")
    # k.4: the SAME immutable violation, but inside a branch that is never taken, is NOT refused
    # -- nothing scans the whole body ahead of running it any more, so an untaken branch's
    # violation is simply never reached.  This is the behaviour this fixture now pins; it is the
    # opposite of what the pre-k.4 "preparation" pass used to guarantee, and that is the point.
    v: -1
    st: go(m_hidden, 0, 0U, @ v)
    check(st = c.LMX_WALK_OK && v = 0, "an immutable-profile primitive in a never-taken branch was refused (k.4: it should simply not run)")
    check(ps\used = 0U && ps\top = 0U, "a run left scratch occupied (m_hidden)")

    # ---- running: the value, the status, and what a failure leaves behind ----------------------
    pv_calls: 0U
    v: -1
    st: go(m_ok, 0, 0U, @ v)
    check(st = c.LMX_WALK_OK && v = 1 && gv\type = c.LMX_TYPE_INT && gv\number = 7, "the primitive did not run flat and land its integer in the caller's own cell")
    check(pv_calls = 1U, "the primitive was called a number of times other than once")
    # STATUS OK WITH THE VALUE ZERO IS NOT FAILURE.
    reference: lmx_arena_ref_struct(lmx_arena_ref_struct(m_zero, 0U), 1U)
    icell(reference, 2U, 42)
    st: go(m_zero, 0, 0U, @ v)
    check(st = c.LMX_WALK_INVALID, "zero-arity primitive accepted a present non-Structure source")
    lmx_arena_ref_store(reference, 2U, 0)
    st: go(m_zero, 0, 0U, @ v)
    check(st = c.LMX_WALK_OK && v = 0 && gv\present = 0 && gv\ref = 0, "a primitive reporting status OK with no value was read as a failure")
    st: go(m_null, 0, 0U, @ v)
    check(st = c.LMX_WALK_OK && v = 1 && gv\kind = c.LMX_WALK_VALUE_REFERENCE && gv\type = c.LMX_TYPE_LMX && gv\ref = 0, "declared reference result is present even when its payload is null")
    # A nonzero status is its OWN reading, and it collides with none of the four.
    st: go(m_fail, 0, 0U, @ v)
    check(st = c.LMX_WALK_PRIMITIVE, "a failing primitive did not report LMX_WALK_PRIMITIVE")
    check(st != c.LMX_WALK_OK && st != c.LMX_WALK_INVALID && st != c.LMX_WALK_UNSUPPORTED && st != c.LMX_WALK_NO_GRAPH, "the primitive failure collided with a reading it must stay distinct from")
    check(lmx_int_value_known(cell0) = 99, "what the failing primitive wrote before it failed did not stand: there is no rollback engine")
    check(ps\used = 0U && ps\top = 0U, "a failed primitive left its scratch slice behind")
    # The next activation runs, and the failure is repeatable: the second failure is not a
    # side effect of the first.
    st: go(m_ok, 0, 0U, @ v)
    check(st = c.LMX_WALK_OK && gv\number = 7, "the activation AFTER a primitive failure did not run")
    st: go(m_fail, 0, 0U, @ v)
    check(st = c.LMX_WALK_PRIMITIVE, "the same failure did not repeat")
    check(ps\used = 0U && ps\top = 0U, "scratch is not empty after the second failure")

    # Borrowed actuals are entry-prepared without executing the inert source
    # frame. Every invalid provenance case is refused before pv_sum runs.
    pv_calls: 0U
    st: go(m_source, @ input_ref, 1U, @ v)
    check(st = c.LMX_WALK_OK && v = 1 && gv\number = 39 && pv_calls = 1U, "source-backed PRIM did not read nested NAMED OWN/ARG and call once")
    calls_before: pv_calls
    lmx_arena_ref_store(source_prim, 4U, (cast: (@: void) source_named0))
    st: go(m_source, @ input_ref, 1U, @ v)
    check(st = c.LMX_WALK_INVALID && pv_calls = calls_before, "duplicate borrowed actual was evaluated")
    lmx_arena_ref_store(source_prim, 4U, (cast: (@: void) source_own))
    st: go(m_source, @ input_ref, 1U, @ v)
    check(st = c.LMX_WALK_INVALID && pv_calls = calls_before, "overlapping borrowed actual was evaluated")
    external_actual: lit(peer, 0U, 10)
    lmx_arena_ref_store(source_prim, 4U, (cast: (@: void) external_actual))
    st: go(m_source, @ input_ref, 1U, @ v)
    check(st = c.LMX_WALK_INVALID && pv_calls = calls_before, "external borrowed actual was evaluated")
    lmx_arena_ref_store(source_prim, 4U, (cast: (@: void) source_named1))
    source_named1\parent: source_exit
    st: go(m_source, @ input_ref, 1U, @ v)
    check(st = c.LMX_WALK_INVALID && pv_calls = calls_before, "malformed source ownership was admitted")
    source_named1\parent: source_fields
    lmx_arena_ref_store(source_prim, 2U, wt_witness(ga, c.LMX_TYPE_INT))
    st: go(m_source, @ input_ref, 1U, @ v)
    check(st = c.LMX_WALK_INVALID && pv_calls = calls_before, "nonnull non-Structure source body was admitted")
    lmx_arena_ref_store(source_prim, 2U, (cast: (@: void) source_body))
    # The address a NAMED actual evaluates is its payload. Linked from outside
    # the source, or from another borrowed slot's subtree, it is refused before
    # pv_sum runs, exactly as the bare external or overlapping actual is.
    lmx_arena_ref_store(source_named0, 2U, (cast: (@: void) external_actual))
    st: go(m_source, @ input_ref, 1U, @ v)
    check(st = c.LMX_WALK_INVALID && pv_calls = calls_before, "external NAMED payload was evaluated")
    lmx_arena_ref_store(source_named0, 2U, (cast: (@: void) source_arg))
    st: go(m_source, @ input_ref, 1U, @ v)
    check(st = c.LMX_WALK_INVALID && pv_calls = calls_before, "NAMED payload linked into another borrowed slot was evaluated")
    lmx_arena_ref_store(source_named0, 2U, (cast: (@: void) source_own))
    st: go(m_source, @ input_ref, 1U, @ v)
    check(st = c.LMX_WALK_OK && gv\number = 39 && pv_calls = calls_before + 1U, "valid source-backed PRIM did not recover after refused graphs")
    calls_before: pv_calls
    st: go(m_inert, @ input_ref, 1U, @ v)
    check(st = c.LMX_WALK_OK && gv\number = 7 && pv_calls = calls_before + 1U, "inert borrowed actual entered its hidden ARG_ENTRY")
    calls_before: pv_calls
    st: go(m_direct, 0, 0U, @ v)
    check(st = c.LMX_WALK_OK && v = 1 && gv\number = 42 && pv_calls = calls_before + 1U, "direct source frame and owned NAMED payload were not each evaluated once")

    # Copy an executable PRIM graph into another arena, release its source,
    # then run the copy without the source's builder role table. A record kept
    # by address would dangle; its signature and owner must be copied too.
    copy_unit: lmx_node_new_owned(ga)
    if: copy_unit != 0 && lmx_arena_refs_open_owned(ga, copy_unit, 3U) = 0
        copy_m: mk_m(copy_unit, 0U, 1U)
        copy_step: fr(copy_m, 0U, c.LMX_WALK_OP_RET, 2U)
        copy_prim_step: fr(copy_step, 1U, c.LMX_WALK_OP_PRIM, 3U)
        copy_record: record_new(ga, pv_ok, copy_unit, 0U, c.LMX_TYPE_INT, c.LMX_TYPE_INT)
        ref(copy_prim_step, 1U, copy_record)
        copy_m_arena: mk_m(copy_unit, 1U, 1U)
        copy_step: fr(copy_m_arena, 0U, c.LMX_WALK_OP_RET, 2U)
        copy_prim_step: fr(copy_step, 1U, c.LMX_WALK_OP_PRIM, 3U)
        copy_record_arena: record_new(ga, pv_ok, (cast: (@: Lmx) ga), 0U, c.LMX_TYPE_INT, c.LMX_TYPE_INT)
        ref(copy_prim_step, 1U, copy_record_arena)
        copy_m_source: mk_m(copy_unit, 2U, 2U)
        copy_subject: pl(copy_m_source, 1U, 2U)
        icell(copy_subject, 1U, 35)
        copy_step: fr(copy_m_source, 0U, c.LMX_WALK_OP_RET, 2U)
        copy_source_prim: fr(copy_step, 1U, c.LMX_WALK_OP_PRIM, 5U)
        ref(copy_source_prim, 1U, record_new(ga, pv_sum, copy_unit, 2U, c.LMX_TYPE_INT, c.LMX_TYPE_INT))
        copy_source_body: pl(copy_source_prim, 2U, 1U)
        copy_source_exit: fr(copy_source_body, 0U, c.LMX_WALK_OP_SOURCE_INERT, 2U)
        copy_source_fields: pl(copy_source_exit, 1U, 2U)
        copy_named0: fr(copy_source_fields, 0U, c.LMX_WALK_OP_NAMED, 3U)
        sz(copy_named0, 1U, 0U)
        reference: fr(copy_named0, 2U, c.LMX_WALK_OP_OWN, 3U)
        ref(reference, 1U, copy_subject)
        sz(reference, 2U, 1U)
        copy_named1: fr(copy_source_fields, 1U, c.LMX_WALK_OP_NAMED, 3U)
        sz(copy_named1, 1U, 1U)
        reference: fr(copy_named1, 2U, c.LMX_WALK_OP_ARG, 4U)
        sz(reference, 1U, 0U)
        lit(reference, 2U, 0)
        ref(reference, 3U, wt_witness(ga, c.LMX_TYPE_INT))
        if: lmx_walk_source_mark(ga, groles, reference, c.LMX_WALK_SOURCE_ARG_ENTRY) != c.LMX_WALK_OK
            broken: broken + 1
        ---
        ref(copy_source_prim, 3U, copy_named0)
        ref(copy_source_prim, 4U, copy_named1)
    ---
    check(copy_unit != 0 && copy_m != 0 && copy_m_arena != 0 && copy_m_source != 0 && copy_source_prim != 0 && copy_source_body != 0 && copy_named0 != 0 && copy_named1 != 0 && copy_subject != 0 && copy_step != 0 && copy_prim_step != 0 && copy_record != 0 && copy_record_arena != 0 && broken = 0, "cross-arena primitive copy fixtures")
    memset((cast: (@: void) (@ copied_arena)), 0, c.sizeof(c.LmxArena))
    ca: @ copied_arena
    check(lmx_arena_open(ca) = 0, "destination arena for primitive copy")
    check(lmx_graph_copy_owned(copy_unit, ga, ca, @ copied_unit) = c.LMX_GRAPH_COPY_OK && copied_unit != 0, "primitive graph copied across arenas")
    if: copied_unit != 0
        copied_m: lmx_arena_ref_struct(copied_unit, 0U)
        copied_record: (cast: (@: LmxPrimitive) lmx_arena_ref_value(lmx_arena_ref_struct(lmx_arena_ref_struct(copied_m, 0U), 1U), 1U))
        check(copied_record != 0 && (cast: (@: void) copied_record) != (cast: (@: void) copy_record) && lmx_range_home(ca, (cast: (@: void) copied_record)) = ca, "copied primitive record has destination ownership")
        if: copied_record != 0
            check(copied_record\owner = copied_unit && copied_record\signature != 0 && lmx_range_home(ca, (cast: (@: void) copied_record\signature)) = ca, "copied primitive owner and signature are local")
        ---
        copied_m_arena: lmx_arena_ref_struct(copied_unit, 1U)
        copied_record: (cast: (@: LmxPrimitive) lmx_arena_ref_value(lmx_arena_ref_struct(lmx_arena_ref_struct(copied_m_arena, 0U), 1U), 1U))
        check(copied_record != 0 && (cast: (@: void) copied_record) != (cast: (@: void) copy_record_arena) && copied_record\owner = (cast: (@: Lmx) ca), "primitive arena owner is rebound to the destination")
        copied_m_source: lmx_arena_ref_struct(copied_unit, 2U)
        copy_source_prim: lmx_arena_ref_struct(lmx_arena_ref_struct(copied_m_source, 0U), 1U)
        copy_source_body: lmx_arena_ref_struct(copy_source_prim, 2U)
        copy_source_exit: lmx_arena_ref_struct(copy_source_body, 0U)
        copy_source_fields: lmx_arena_ref_struct(copy_source_exit, 1U)
        check(lmx_arena_ref_value(copy_source_prim, 3U) = lmx_arena_ref_value(copy_source_fields, 0U) && lmx_arena_ref_value(copy_source_prim, 4U) = lmx_arena_ref_value(copy_source_fields, 1U) && lmx_arena_ref_value(copy_source_prim, 3U) != (cast: (@: void) copy_named0) && lmx_arena_ref_value(copy_source_prim, 4U) != (cast: (@: void) copy_named1) && lmx_range_home(ca, lmx_arena_ref_value(copy_source_prim, 3U)) = ca && lmx_range_home(ca, lmx_arena_ref_value(copy_source_prim, 4U)) = ca, "source-backed primitive aliases were not remapped to owned destination nodes")
    ---
    check(lmx_arena_release(ga) = 0, "release primitive graph source before execution")
    pc\arena: ca
    pc\roles: 0
    pc\immutable_profile: 0
    pv_calls: 0U
    v: -1
    st: go(copied_m, 0, 0U, @ v)
    check(st = c.LMX_WALK_OK && v = 1 && gv\number = 7 && pv_calls = 1U, "copied primitive graph executes after source release")
    st: go(copied_m_arena, 0, 0U, @ v)
    check(st = c.LMX_WALK_OK && v = 1 && gv\number = 7 && pv_calls = 2U, "copied arena-owned primitive executes after source release")
    st: go(copied_m_source, @ input_ref, 1U, @ v)
    check(st = c.LMX_WALK_OK && v = 1 && gv\number = 39 && pv_calls = 3U, "copied source-backed primitive executes after source release")
    check(lmx_arena_release(ca) = 0, "release destination primitive arena")

    free((cast: (@: void) gv))
    if: failures != 0
        c.printf("lmx_primitive: %d failed of %d\n", failures, checks)
        return: 1
    ---
    c.printf("lmx_primitive: %d checks\n", checks)
return: 0
