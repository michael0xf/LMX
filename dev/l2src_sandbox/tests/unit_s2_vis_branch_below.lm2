# A method defined above cfg reads that free name. The root call below cfg
# supplies its local source through m, which only forwards the hidden input.
fn: read_branch () size_t
return: cfg\e
independent:
    const:
        immutable:
            (): cfg
                size_t: e 7U
            end: cfg
        end: immutable
    end: const
end: independent
fn: m () int
    if: read_branch() != 7U
        return: 81
    return: 7
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
