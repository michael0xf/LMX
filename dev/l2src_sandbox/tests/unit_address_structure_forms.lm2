# Both address spellings name the containing slot; a bare name supplies its Structure value.
Model:
    int: value 7
end: Model

fn: read (Model: item) int
return: item\value

fn: check () int
    int: plain read(Model)
    if: @ Model != (@: Model)
        return: 0
    if: plain != 7
        return: 0
return: 7

sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
