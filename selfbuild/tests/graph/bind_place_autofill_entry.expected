---
    Observed:
        int: ticks 1
        int: seen 1
    end: Observed
---
fn: tick () int
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ ticks) (((shared \ Observed) \ ticks) + 1)
    return: 40
end: tick
fn: callee (int: x) int
    return: 1
end: callee
fn: caller (int: x) int
    return: (callee)
end: caller
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) (caller)
end: main
main:
