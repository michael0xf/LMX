BfsProcedural:
    return: int
    run:
        throws: copy(BfsDiscover\run\throws)
        while: head < tail
            int: vertex queue[head]
            head += 1
            nextDistance := distance[vertex] + 1
            @: row graph[vertex]
            int: i 0
            while: i < length(row)
                tail := BfsDiscover\run(tail; row[i])
                i += 1
        ---
        return: 0
