# Original: l2src/l2trans.lm1:10457
fn: lm_compiler_scan_actuals_value (const: (@: port_call c.LmP0Node); @: value c.L2ValueSpan; int: mi; @: seen int) int
    const: (@@: src_cell char (cast: (const: @@: char) (@ c.l2_src)))
    @: e_cell int (cast: (@: int) (@ c.l2_e))
    @: site c.L2ApplicationSite
    @: values c.L2ValueSpan
    @: plan c.L2ApplicationActuals
    @: actual c.L2ApplicationActual
    @: argument c.L2ValueSpan
    int: value_n
    int: k 0
    int: status
    int: idx
    int: held -1
    int: fi 0
    if: c.lm_compiler_application_site_get(port_call, mi, value, src_cell[0], @ site) != 0
        return: (cast: (int) (1))
    values: c.lm_compiler_primary_values((cast: (@: c.L2ValueSpan) (@ site\value)), @ value_n)
    if: value_n < 0
        return: (cast: (int) (c.lm_compiler_error_fatal(src_cell[0], port_call, "internal: a call lost its prepared actuals")))
    idx: c.lm_compiler_call_head_method(mi, (cast: (const: @: c.LmP0Text) (port_call\as\frame\head)), @ fi)
    if: idx = e_cell[0]
        idx: -1
    if: idx < 0
        held: c.lm_compiler_call_head_held(mi, (cast: (const: @: c.LmP0Text) (port_call\as\frame\head)))
    if: lm_compiler_application_site_bind(site, idx, held, src_cell[0]) != 0
        return: (cast: (int) (1))
    if: site\bound = 0
        # No signature has selected named roles yet. This is the written
        # grammar,not a retry after a refused argument binding.
        return: (cast: (int) (lm_compiler_scan_value_list(values, value_n, mi, seen, 0)))
    plan: @ site\arguments
    while: k < plan\written_count
        actual: c.lm_compiler_value_actual_written(plan, k)
        if: actual = 0
            return: (cast: (int) (c.lm_compiler_error_fatal(src_cell[0], port_call, "internal: an application lost its written order")))
        argument: @ actual\value
        if: actual\structured != 0
            status: lm_compiler_scan_value_list((cast: (@: c.L2ValueSpan) (argument\values)), (cast: (int) (argument\value_n)), mi, seen, 0)
        else:
            status: lm_compiler_scan_value_span(argument, mi, seen, 0)
