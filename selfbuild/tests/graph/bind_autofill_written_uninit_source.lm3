# Entry Main: Main's x is declared without a value and written later. C's `int: x`, reached with no value of its
# own, takes the current value of the same-named place of the immediate caller, Main's 9, into its own cell
# (#binding-autofill). out 9.
int: out 0
C:
    int: x
    node\out := x
Main:
    int: x
    x := 9
    C()
