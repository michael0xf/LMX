# An unused computed field of the data is not computed (M14: no pass of defaults before the body); the body's
# first statement writes the graph by an explicit path (calls 99), then the read of the unknown name refuses 3.
int: calls 0
fn: tick () int
    node\calls := node\calls + 1
    return: 1
fn: missing () int (
    prepared:
        name: local
        args: ()
        return: int
        code: (return: 7)
    fn: prepared
    int: seeded tick()
)
    node\calls := 99
    return: absent
int: result missing()
