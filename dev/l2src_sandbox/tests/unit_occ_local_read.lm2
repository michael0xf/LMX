# D-27: a non-parameter local has one cell. Bare stores are not declarations.
# x reads that cell (20). The bare x on its own line is an expression,
# not the tail of the assignment above it.
fn: mytest () int
    int: x
    x: 10
    x: 20
    x
    if: x != 20
        return: 1
    return: 7
end: mytest
sendMessage: exit(exit_code: mytest(); stdout: ""; stderr: "")
return
