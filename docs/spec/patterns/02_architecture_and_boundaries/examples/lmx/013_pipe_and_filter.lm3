Filters:
    int: value
    return: int
    normalize:
        if: value < 0
            return: -value
        return: value
    double:
        return: value * 2
    offset:
        return: value + 1
    pipeline:
        throws: copy(FxThrows\adapter)
        @: stages pipe(pipe(normalize; double); offset)
        return: stages(value)
    demo:
        throws: copy(FxThrows\adapter)
        return: pipeline(-3)
