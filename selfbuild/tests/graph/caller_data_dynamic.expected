---
    Observed:
        int: seen 3
    end: Observed
---
@: shared (data [] 0)
sub: main () (
    Point: a b
    int: seen 0
)
    fn: inner () int
        return: (length Point)
    end: inner
    fn: outer () int (
        Point: a b c
    )
        return: (inner)
    end: outer
    :=: (data \ seen) (outer)
end: main
main:
int: seen ((main \ data) \ seen)
sub: observe ()
    :=: ((shared \ Observed) \ seen) seen
end: observe
observe:
