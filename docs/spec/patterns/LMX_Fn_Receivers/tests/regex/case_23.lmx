# Source acceptance fixture, NOT an executed test report.
# Expected: 1; left/right/name/captures do not autofill the operand/capture internals
Caller:
    @: left literal("noise")
    []@: right [literal("noise")]
    []char: name "caller"
    @: captures 0
    return: int
    run:
        return: matches(utf8Text("ab"); (then "a" "b"))

Caller\run()
