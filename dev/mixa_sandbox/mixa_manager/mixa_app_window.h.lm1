include: "<stddef.h>"
predef: "mixa_manager/mixa_core.h.lm1"
predef: "mixa_manager/mixa_buttons.h.lm1"
predef: "mixa_manager/mixa_palette.h.lm1"

# Nested same-app missing-function window (ticket 20260911-153700).
# An unimplemented action opens a nested, reduced instance of this app:
# a framed region on the shared cell surface showing the literal message
# ("нет функции") and one dismiss button. Events route to the TOP window's
# button panel only; dismissing restores the saved parent cells verbatim.
# Windows stack dynamically (no depth cap); each level owns its saved cells
# and one MixaButtonPanel (single dismiss button).

define: MIXA_APP_WINDOW_OK 0
define: MIXA_APP_WINDOW_ERR 1

# Render policy: text glyphs opaque; alpha on backgrounds only.
# ЦВЕТА ОКНА -- ПАРЫ ПАЛИТРЫ (20.09).  UI_MODEL 5.4 называет пары для КНОПОК; цвет самого
# окна-подтверждения документ не называет (в ClearShell такие окна -- системные
# AlertDialog'и, их красок в ClearShell.java нет).  Поэтому старые индексы VGA переведены в
# пары ПО ИМЕНИ, чтобы картинка сохранила смысл: тело окна было синим (VGA 9) -- стало парой
# Blue; текст сообщения был белым (15) -- стал парой Black, у которой текст бел
# (cBlack = argb(240,255,255,255)); кнопка была зелёной (10) -- стала парой Green.  Это
# МОЙ перевод, а не цитата дока, и он назван здесь именно так.
define: MIXA_APP_WINDOW_WIN_BG MIXA_PAL_BLUE
define: MIXA_APP_WINDOW_WIN_ALPHA 200
define: MIXA_APP_WINDOW_FRAME_FG MIXA_PAL_GRAY
define: MIXA_APP_WINDOW_MSG_FG MIXA_PAL_BLACK
define: MIXA_APP_WINDOW_BTN_FG MIXA_PAL_BLACK
define: MIXA_APP_WINDOW_BTN_BG MIXA_PAL_GREEN
define: MIXA_APP_WINDOW_BTN_ALPHA 96
define: MIXA_APP_WINDOW_BTN_LABEL "OK"
define: MIXA_APP_WINDOW_BTN_CANCEL_LABEL "Cancel"

struct: MixaAppWindow
    @: MixaCell saved
    size_t: saved_count
    @: MixaButtonPanel panel
    size_t: msg_row
    size_t: msg_col
    size_t: origin_row
    size_t: origin_col
    size_t: nrows
    size_t: ncols
    size_t: hb
    int: is_open
end: MixaAppWindow

struct: MixaAppWindowStack
    @: MixaAppWindow windows
    size_t: count
    size_t: cap
    int: is_open
end: MixaAppWindowStack

prototype:
    fn: mixa_app_window_stack_init (@: MixaAppWindowStack stack) int
    fn: mixa_app_window_stack_release (@: MixaAppWindowStack stack) void
    fn: mixa_app_window_open (@: MixaAppWindowStack stack; @: MixaTextRect rect; size_t: window_row; size_t: window_col; size_t: nrows; size_t: ncols; size_t: hb; const: @(char message)) int
    fn: mixa_app_window_dismiss (@: MixaAppWindowStack stack; @: MixaTextRect rect) int
    fn: mixa_app_window_hit (@: MixaAppWindowStack stack; @: MixaTextRect rect; size_t: cell_row; size_t: cell_col) int
    fn: mixa_app_window_top (@: MixaAppWindowStack stack) @: MixaAppWindow
    fn: mixa_app_window_count (const: @(MixaAppWindowStack stack)) size_t
    # Two-button variant (ticket 20260913-023700): the same framed window,
    # save/restore, and layout discipline as open()/hit()/dismiss() above,
    # generalized to TWO buttons in add-order (label_a first, label_b
    # second -- e.g. "Cancel" then "OK", matching FSync.java's own
    # negative-then-positive AlertDialog.Builder call order) instead of
    # one hardcoded "OK". Purely additive: open()/hit()/dismiss() above
    # are unchanged and still serve every existing single-dismiss-button
    # caller exactly as before.
    #
    # hit2 deliberately does NOT dismiss automatically (unlike hit()):
    # a caller of a two-button confirmation needs to run a real action
    # for one of the two outcomes (e.g. Cancel just dismisses; OK also
    # deletes) before deciding whether/when to dismiss, so the decision
    # of WHEN to dismiss has to stay with that caller. Returns 1 with
    # out_btn_idx set to 0 (label_a) or 1 (label_b) on a real hit; 0
    # (out_btn_idx untouched) on a miss or any argument error.
    fn: mixa_app_window_open2 (@: MixaAppWindowStack stack; @: MixaTextRect rect; size_t: window_row; size_t: window_col; size_t: nrows; size_t: ncols; size_t: hb; const: @(char message); const: @(char label_a); const: @(char label_b)) int
    fn: mixa_app_window_hit2 (@: MixaAppWindowStack stack; @: MixaTextRect rect; size_t: cell_row; size_t: cell_col; @: int out_btn_idx) int
end: prototype