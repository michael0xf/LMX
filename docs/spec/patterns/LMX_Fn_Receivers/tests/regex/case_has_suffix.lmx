# Source acceptance fixture, NOT an executed test report.
# Expected: (1, 1, 1, 0, 1, 1, 1, 1, 0, 0, 1, 1).
# The first case must reject local "a" and revisit the "ab" alternative.
# The second must see overlapping "aba" at [2,5), after [0,3).
@: ab utf8Text("ab")
@: abc utf8Text("abc")
@: alternatives (literal("a") | literal("ab"))
int: alternativeEndsHere hasSuffix(ab; alternatives)
int: overlapEndsHere hasSuffix(utf8Text("ababa"); "aba")
int: unmatchedBeginning hasSuffix(utf8Text("zab"); "ab")
int: wrongEnd hasSuffix(abc; "ab")
int: presentEarlier contains(abc; "ab")
int: emptyLiteral hasSuffix(abc; "")
int: emptyPatternSuffix hasSuffix(abc; emptyPattern)
int: emptyInput hasSuffix(utf8Text(""); "")
int: emptyInputMiss hasSuffix(utf8Text(""); "a")
int: absent hasSuffix(ab; neverPattern)
int: fullInput hasSuffix(ab; "ab")
int: literalPunctuation hasSuffix(utf8Text("za.b"); "a.b")
(alternativeEndsHere; overlapEndsHere; unmatchedBeginning; wrongEnd; presentEarlier; emptyLiteral; emptyPatternSuffix; emptyInput; emptyInputMiss; absent; fullInput; literalPunctuation)
