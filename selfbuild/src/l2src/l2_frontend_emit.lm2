    @: f c.LmP0Field
    int: ni c.lm_compiler_ns_find(h)
    int: oi 0
    int: prim
    int: vs
    int: contract
    int: inputs
    int: admission
    c.L2ReferenceSource: source
    # Empty candidate construction/assignment is handled by the common graph
    # receiving path; this helper handles only nonempty definitions.
    if: stmt\as\frame\body = 0 || c.lm_compiler_count_active((cast: (const: @: c.LmP0Structure) (stmt\as\frame\body))) = 0
        return: (cast: (int) (c.lm_compiler_rw_refuse(stmt, "this call")))
    f: c.lm_compiler_next_active((cast: (@: c.LmP0Field) (stmt\as\frame\body\first_field)))
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || c.lm_compiler_next_active((cast: (@: c.LmP0Field) (f\next))) != 0
        return: (cast: (int) (c.lm_compiler_rw_refuse(stmt, "this declaration")))
