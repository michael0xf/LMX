fn: decl_post (@: f c.FILE) int
    if: c.fputs("include: \"<stddef.h>\"\npredef: \"l2src/lmx.h.lm1\"\npredef: \"l2src/lmx_arena.h.lm1\"\n\ndefine: LMX_POST_OK 0\ndefine: LMX_POST_INVALID 1\ndefine: LMX_POST_REFUSED 2\ndefine: LMX_POST_FULL 3\n\ndefine: LMX_POST_INBOX 0\n# An outgoing target: what the turn is preparing.  Accepting here STAGES it (see below).\ndefine: LMX_POST_OUTBOX 1\n# What the current turn has PREPARED and not yet published (spec 19.29.4.1: \"publish\n# successful FIFO outbox OR discard failed staged outbox\"; model 28: \"Текущий turn готовит\n# исходящие сообщения в своём outbox\").  A staged target is not outgoing yet: nothing takes\n# it, and only the end-turn boundary moves it into the outbox (lmx_post_publish) or takes it\n# apart (lmx_post_discard).  Its own lane has its own name so the owner can loo", f) < 0
        return: 1
    if: c.fputs("k at what it\n# prepared without any of it becoming visible.\ndefine: LMX_POST_STAGED 2\n\n# Queue nodes come from the mailbox's own typed pool, one chunk at a time.\ndefine: LMX_POST_NODE_CHUNK 32\n\n# The inbox starts with the smallest useful ring.  When it fills, lmx_post grows the private\n# backing by approximately 3/2 while holding the mailbox monitor.  This is an implementation\n# starting point, not a public capacity limit.\ndefine: LMX_POST_INBOX_MIN_CAPACITY 2\n\n# The mailbox's own API, as one table.  A caller holds the interface, not a pile of\n# function names, and the thread composes this into its own mail API rather than\n# merging the two (lmx_thread.h.lm1).\n#\n# The arena is named where the mailbox has to ask a question of it -- a node comes\n# from the node pool (accept) and the pool goe", f) < 0
        return: 1
    if: c.fputs("s back to the arena (close) -- and is\n# left out where it is not asked (take, count).  The mailbox keeps no arena of its\n# own: the arena is the context of the act, so the caller of the act supplies it.\n#\n# LmxPost is named here before it is defined so these function-pointer types can\n# point at it; the struct: below completes the same tag.\ntype: LmxPost struct LmxPost\n\nfnptr: LmxPostAccept (@: LmxArena arena; @: LmxPost box; @: void target; int: lane) int\nfnptr: LmxPostTake (@: LmxPost box; int: lane) @: void\nfnptr: LmxPostCount (@: LmxPost box; int: lane) size_t\nfnptr: LmxPostClose (@: LmxArena arena; @: LmxPost box) int\n\nstruct: LmxPostApi\n    LmxPostAccept: accept\n    LmxPostTake: take\n    LmxPostCount: count\n    LmxPostClose: close\nend: LmxPostApi\n\n# One node of a mailbox queue.  It i", f) < 0
        return: 1
    if: c.fputs("s LOW-LEVEL LINKAGE, not an envelope.\n#\n# The envelope IS the Message: the record of lmx_message.h.lm1 -- running, success,\n# handoff_ready, graph, index -- is the letter's envelope (Mikhail, 2026-09-17:\n# \"то что мы сейчас описали lmx_message -- и есть конверт\").  What travels is the\n# LMX structure created by merge, and wrapping it in a second entity is exactly the\n# mistake to avoid; no language-level code does it.  This type wraps nothing: it\n# carries the target's ADDRESS and the next link, and it exists so that a mailbox\n# can hold a queue at all -- low level the translator emits, not a model entity.\n#\n# No kind/tag is stored here either: the target's domain is re-derived from its\n# address through the registered range table on every read (lmx_post_adm", f) < 0
        return: 1
    if: c.fputs("its asks\n# lmx_domain_kind), so nothing on this node can fall out of step with what the\n# address currently is (spec 2.1, 6.5: no per-child type tag).\nstruct: LmxPostLink\n    @: void target\n    @: LmxPostLink next\nend: LmxPostLink\n\n# One mailbox: what arrived, what goes out, and what this turn has prepared.\n#\n# The queue is FIFO, and that is spec, not convenience: \"publish successful FIFO outbox\"\n# (19.29.4.1), and model 27 -- \"FIFO задаётся порядком admission у конкретного получателя\".\n# Admission order is what a reader sees, so an item is APPENDED at the tail and taken from\n# the head.  A tail link per lane is what makes appending cost no walk: this is the one\n# collection the design lets be synchronized, and it must not degenerate into a list scan.\n", f) < 0
        return: 1
    if: c.fputs("#\n# The three lanes: `inbox` is what was admitted and not yet taken; `outbox` is what a\n# successful end-turn has PUBLISHED (an older turn's committed outgoing, in front of a newer\n# one's); `staged` is what the CURRENT turn has prepared and nothing else may see.  Publication\n# moves the whole staged queue to the tail of the outbox in one step, so the order across\n# turns is admission order and stays that way.\n#\n# This is the only synchronized collection the design allows (model 30): one small,\n# reentrant monitor belongs to the mailbox and serializes only its cross-lane inbox.\n# There is no wait/notify protocol and no lock is spread into the service, scheduler,\n# graph, arena or turn modules.  Outbox and staged remain owner-local.\n#\n# Queue-node storage is the mailbox's own typed pool (lm", f) < 0
        return: 1
    if: c.fputs("x_pool.h.lm1).  The pool\n# adds chunks of LmxPostLink nodes and registers every chunk as one more range of\n# the POST_LINK domain, so a node is classified by the address it lands in and\n# nothing is malloc'd -- neither per node nor per mailbox.  A pool never takes a\n# node back, so a node released by lmx_post_take goes on this mailbox's free list\n# and is handed out again; without that list a long-running mailbox would grow the\n# pool without end.\n#\n# The mailbox belongs to what owns it -- an L3 Thread, which is a Message -- and its\n# storage lives there rather than on a foreign heap (model 22, 25).  Hence\n# lmx_post_init needs the arena open already: opening the pool registers the first\n# chunk, and every node the pool hands out is a cell of one of the arena's arrays.\n\n# Inbox slot pair +", f) < 0
        return: 1
    if: c.fputs(" DynamicArray types for the post inbox ring.\n\nstruct: LmxPostInboxSlot\n    @: void target\n    @: LmxArena source_arena\nend: LmxPostInboxSlot\n\n\n# Fixed array of inbox slot pairs.\nstruct: LmxPostInboxSlotArray\n    size_t: len\n    @: LmxPostInboxSlot data\nend: LmxPostInboxSlotArray\n\n# Compositional DynamicArray over LmxPostInboxSlotArray (Q18 / FABLE-134 REVIEW).\nstruct: LmxPostInboxSlotDynamicArray\n    LmxPostInboxSlotArray: array\n    size_t: capacity\nend: LmxPostInboxSlotDynamicArray\n\n# -177 c2: selective-receive iterator over the inbox in admission order (mail-wrappers K1).\n# open positions before the first letter; next advances and returns the letter under the\n# cursor; take removes that letter (others keep order); close ends the walk.\nstruct: LmxPostCursor\n    @: LmxPost box\n    size_t: ", f) < 0
        return: 1
    if: c.fputs("index\n    int: has_current\n    int: open\nend: LmxPostCursor\n\nstruct: LmxPost\n    # THE INBOX IS THE ONE CROSS-LANE STRUCTURE AND IT IS A RING, NOT A LINKED LIST (20.09).\n    #\n    # WHY (measured): with two REAL lanes -- an accepting sender and the taking owner -- the old\n    # linked list corrupted itself.  Its free list was popped by the sender and pushed by the\n    # owner, both with plain read-modify-write, so the same node could be handed out twice and\n    # linked into the inbox twice; a cyclic inbox then made the owner's drain loop spin forever\n    # and its lane stopped turning: turns_a=2001 and turns_b=56 in the same 31 seconds, the lane\n    # still alive with its state WAITING.  The node also came from a pool in the RECEIVING arena\n    # (lmx_post_new_node(arena, box)), so a send", f) < 0
        return: 1
    if: c.fputs("er allocated inside an arena the owner was\n    # collecting at the same time.\n    #\n    # A ring has neither allocation/free-list problem, and the mailbox monitor makes its\n    # reservation/publication one operation for EVERY producer.  This deliberately favours the\n    # simple Java-style synchronized rule: enter/leave are reentrant for the same OS thread,\n    # but there is no wait/notify state.  A lock-free MPSC ring belongs to a separate future\n    # mail implementation, not to this collection.\n    #\n    # The slots are private mailbox metadata, not graph values and not an address-classified LMX\n    # type.  They form an ordinary movable dynamic array: growth happens only while holding the\n    # monitor, copies unread target/source pairs in FIFO order, and never exposes the backing ad", f) < 0
        return: 1
    if: c.fputs("dress.\n    # Private flat ring pairs `[target, source_arena]`. Producers publish both words under this\n    # mailbox's monitor and never mutate the receiver arena. A null source means same-arena.\n    # Private ring of pair records as one DynamicArray + head/tail (Q18).\n    # capacity = ring slots; array.len unused as occupancy (inbox_count + head/tail).\n    LmxPostInboxSlotDynamicArray: inbox\n    # The counters and slots are ordinary mailbox state protected by inbox_monitor.  Tail is\n    # advanced by every sender, head only by the owner, and count is what lmx_post_count reports.\n    ulong: inbox_head\n    ulong: inbox_tail\n    # The monitor is implemented and used only by lmx_post.lm2. `owner` is this live OS thread's\n    # nonzero ID from the existing platform service; depth gives reentry", f) < 0
        return: 1
    if: c.fputs(", held is the one atomic gate.\n    size_t: inbox_monitor_owner\n    size_t: inbox_monitor_depth\n    int: inbox_monitor_held\n    @: LmxPostLink outbox\n    @: LmxPostLink outbox_tail\n    @: LmxPostLink staged\n    @: LmxPostLink staged_tail\n    @: LmxPostLink free_nodes\n    size_t: inbox_count\n    size_t: outbox_count\n    size_t: staged_count\n    LmxPool: nodes\n    LmxPostApi: api\nend: LmxPost\n\nprototype:\n    # THE LIFECYCLE PRECONDITION (L2 §9, mailbox; mirrored in L1).  `init` and `close` require\n    # QUIESCENCE: no OS thread is in accept/take/count or starts one before the operation\n    # completes.  Publication begins only after a successful init -- until then nothing accepts\n    # and nothing publishes -- and the owner that opened the mailbox is the one that coordinates\n    # the quiet ", f) < 0
        return: 1
    if: c.fputs("before closing it.  That coordination cannot be moved inside this module: a lock\n    # held inside close cannot make object lifetime safe against new entrants, because destroying\n    # a monitor cannot exclude anyone.  Outbox and staged stay owner-local throughout (the\n    # struct's note above); only the inbox is cross-lane, and the monitor protects that alone.\n    fn: lmx_post_init (@: LmxArena arena; @: LmxPost box) int\n    fn: lmx_post_api (@: LmxPost box) @: LmxPostApi\n    fn: lmx_post_admits (@: LmxArena arena; @: void target) int\n    fn: lmx_post_accept (@: LmxArena arena; @: LmxPost box; @: void target; int: lane) int\n    # Transactional cross-arena inbox publication. The producer only reserves/grows and publishes\n    # {target, source_arena} under the mailbox monitor; it never mut", f) < 0
        return: 1
    if: c.fputs("ates the receiver arena.\n    fn: lmx_post_accept_transfer (@: LmxArena arena; @: LmxPost box; @: void target; @: LmxArena source_arena) int\n    # Receiver-owner take. Before exposing an imported inbox target, claim its source arena into\n    # the receiver arena. Refusal leaves the pair queued and owned by the source arena.\n    fn: lmx_post_take_owned (@: LmxArena arena; @: LmxPost box; int: lane) @: void\n    fn: lmx_post_take (@: LmxPost box; int: lane) @: void\n    fn: lmx_post_count (@: LmxPost box; int: lane) size_t\n    # The end-turn boundary's first act (19.29.4.1), one call per outcome: publish moves\n    # everything staged into the outbox, in order, where a transport (a later stage) finds\n    # it; discard takes it apart and puts its nodes back on the free list, because a turn\n    # ", f) < 0
        return: 1
    if: c.fputs("that failed publishes nothing.  Neither asks the arena anything, so a lane can perform\n    # them without holding one.\n    fn: lmx_post_publish (@: LmxPost box) int\n    fn: lmx_post_discard (@: LmxPost box) int\n    fn: lmx_post_close (@: LmxArena arena; @: LmxPost box) int\n    fn: lmx_post_inbox_data (@: LmxPost box) @: LmxPostInboxSlot\n    fn: lmx_post_inbox_cap (@: LmxPost box) size_t\n    fn: lmx_post_inbox_set_data (@: LmxPost box; @: LmxPostInboxSlot data) void\n    fn: lmx_post_inbox_set_len (@: LmxPost box; size_t: len) void\n    fn: lmx_post_inbox_set_cap (@: LmxPost box; size_t: capacity) void\n    # -177 c2: inbox cursor (admission order). Mutant: take removes wrong slot -> RED.\n    fn: lmx_post_cursor_open (@: LmxPost box; @: LmxPostCursor cur) int\n    fn: lmx_post_cursor_next (@: L", f) < 0
        return: 1
    if: c.fputs("mxPostCursor cur) @: void\n    fn: lmx_post_cursor_take (@: LmxArena arena; @: LmxPostCursor cur) @: void\n    fn: lmx_post_cursor_close (@: LmxPostCursor cur) void\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_post

fn: decl_call (@: f c.FILE) int
    if: c.fputs("include: \"<stddef.h>\"\npredef: \"l2src/lmx.h.lm1\"\npredef: \"l2src/lmx_value.h.lm1\"\npredef: \"l2src/lmx_arena.h.lm1\"\n\n# Common selected-Structure call boundary. The chosen native word alone selects native versus walk.\n# No installed backend registry or mutable module/current-call state is used.\n# Declared-width argument/result storage and explicit value context use the same physical ABI in both routes.\n# Admission and ordinary physical maps belong to the Consumer; dispatch does not search for providers or infer types.\n# node is the selected code occurrence's lexical parent, data is its explicitly selected owner/self.\n#\n# The host's nullary transport is separate from language unary-call data selection: a direct root executes its complete\n# program graph over itself. Return is status; an activation int is an explicit output, never a turn verdict.\n# The caller receives the ac", f) < 0
        return: 1
    if: c.fputs("tual selected route even if the called body changes its native word.\nfnptr: LmxCallEntry (@: Lmx node) int\n\ndefine: LMX_CALL_OK 0\ndefine: LMX_CALL_INVALID 1\ndefine: LMX_CALL_NOT_CALLABLE 2\ndefine: LMX_CALL_ROUTE_NATIVE 0\ndefine: LMX_CALL_ROUTE_WALK 1\ndefine: LMX_CALL_ROUTE_REFUSED 2\ndefine: LMX_CALL_WALK_ERR_LO 1\ndefine: LMX_CALL_WALK_ERR_HI 7\ndefine: LMX_CALL_WALK_THROWN 8\n\nprototype:\n    # The arena's domain question only: no separate callable shape.\n    fn: lmx_call_ready (@: LmxArena arena; @: Lmx callable) int\n    fn: lmx_call_node (@: Lmx callable) @: Lmx\n    # Pure status conversion. Errors1..7 and malformed statuses abort (X1).\n    # An encoded walked throw returns its selected-callee ordinal. Nothing is remembered.\n    fn: lmx_call_note_walk_fail (int: st) int\n    # value is a required int output; a nonzero status promises no activation result.\n    fn: lmx_ca", f) < 0
        return: 1
    if: c.fputs("ll0_mode (@: LmxArena arena; @: Lmx callable; @: int route; @: int value) int\n    fn: lmx_call0 (@: LmxArena arena; @: Lmx callable; @: int value) int\n    # The ordinary explicit code/data transport. refs[k] is declared-width value storage; null storage means absent.\n    # A pointer's present-null value is not absence. Status and value are separate.\n    # Stop returns status0 with out absent; the caller must unwind on poll_escape before consuming result storage.\n    fn: lmx_call_prim (@: LmxArena arena; @: Lmx code; @: Lmx data; @@: void refs; size_t: nargs; @: void dest; @@: void out) int\n    fn: lmx_call_prim_values (@: LmxArena arena; @: Lmx code; @: Lmx data; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n    # The two statically linked ordinary walker entries. No installation/reg", f) < 0
        return: 1
    if: c.fputs("istration or callback-identity lookup.\n    fn: lmx_walk_call0_dispatch (@: LmxArena arena; @: Lmx callable; @: int value) int\n    fn: lmx_walk_call_prim_dispatch (@: LmxArena arena; @: Lmx code; @: Lmx data; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n    # Publish an already-computed dirty value through its admitted physical place.\n    # The write guard rejects a qualified/sealed place; failed stores abort as the caller's broken promise.\n    # No re-evaluation, repeated admission or module-local data graph is performed here.\n    fn: lmx_publish_int (@: int dirty; @: LmxArena arena; @: void cell; int: value; int: k; int: guard; @@: Lmx roots; size_t: count) void\n    fn: lmx_publish_char (@: int dirty; @: LmxArena arena; @: void cell; int: value; int: k; int: guard; @@: Lmx roots; s", f) < 0
        return: 1
    if: c.fputs("ize_t: count) void\n    fn: lmx_publish_size (@: int dirty; @: LmxArena arena; @: void cell; size_t: value; int: k; int: guard; @@: Lmx roots; size_t: count) void\n    fn: lmx_publish_unsigned (@: int dirty; @: LmxArena arena; @: void cell; unsigned: value; int: k; int: guard; @@: Lmx roots; size_t: count) void\n    fn: lmx_publish_ulong (@: int dirty; @: LmxArena arena; @: void cell; ulong: value; int: k; int: guard; @@: Lmx roots; size_t: count) void\n    fn: lmx_publish_pointer (@: int dirty; @: LmxArena arena; @: void cell; @: void raw; @: LmxWalkValue context; int: k; int: guard; @@: Lmx roots; size_t: count) void\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_call

fn: decl_clock (@: f c.FILE) int
    if: c.fputs("include: \"<stdint.h>\"\npredef: \"l2src/lmx.h.lm1\"\n\n# The clock of the R0 cycle (model 33), and the only place in the kernel that asks the\n# platform for the time.\n#\n# A CYCLE owns the clock and hands the reading down to whatever must age: a scheduler\n# record never asks the platform itself, which is why every lmx_schedule call that ages a\n# wait takes its `now` as an argument.  That is the whole reason this module is separate\n# from lmx_schedule -- the arithmetic of a wait (record) and the source of time (cycle)\n# are different owners.\n#\n# Milliseconds since the platform started, monotonic and non-decreasing, so a wait is\n# bounded in REAL time and not in loop iterations.  It is not wall time and nothing here\n# pretends it is: what bounds a wait is the cycle's own count, not a calendar.\n#\n# The reading is a portable 64-bit count. A record may keep a 32-bit reading, where\n", f) < 0
        return: 1
    if: c.fputs("# `now - started` stays correct across a wrap because the arithmetic is modulo 2^32 and a\n# limit is small. The platform body casts its own clock into this width.\nprototype:\n    fn: lmx_clock_now () uint64_t\n    # The same reading as the 32-bit count a scheduler record keeps.\n    fn: lmx_clock_ticks () ulong\n    # THE PLATFORM WORD'S READING OF THE SAME CLOCK, and the width a stored close deadline lives in.\n    # The body reads the full clock into this word.  Routing it through lmx_clock_ticks() is a\n    # silent defect where `ulong` is narrower than `size_t`: the truncation is zero-extended into\n    # the wider word, and a modular deadline test at the wider width then answers \"not yet\" for a\n    # long time after the narrow wrap.  No short test can reach that wrap, so the wide read is the\n    # whole defence (lmx_uds, 2026-09-21).\n    fn: lmx_clock_word () size_t\n", f) < 0
        return: 1
    if: c.fputs("    # HALF THE WORD RANGE: the width a modular deadline comparison is sound below, and therefore the\n    # largest close limit the setter accepts (lmx_root_close_limit_set refuses at or above it).\n    fn: lmx_clock_half () size_t\n    # HAS THE DEADLINE PASSED -- wrap-safe modular arithmetic, and the ONLY way a stored deadline is\n    # read.  `now - deadline` is modular: a small difference means now is at or past the deadline, a\n    # difference at or above half the range means it is still ahead.  This is the FIRST\n    # STORED-DEADLINE COMPARISON IN THIS KERNEL -- the seven existing timeout sites are all elapsed\n    # subtraction (lmx_orphan 224/235, lmx_root 267, lmx_schedule 50, lmx_thread 545/650,\n    # lmx_turn 111) -- and it is sound where those had to subtract because the value is a platform\n    # word AND a limit may never reach half its range, so one window cannot span a wrap.\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_deadline_passed (size_t: deadline; size_t: now) int\n    # HOW LONG UNTIL THE DEADLINE, and ZERO when it has already passed: an expired deadline must arm\n    # a ZERO wait, never underflow into a word-sized eternity.  Same guard shape as lmx_clock_since,\n    # which saturates at zero rather than wrapping.\n    fn: lmx_deadline_wait (size_t: deadline; size_t: now) size_t\n    # How long since a reading.  A reading from the future saturates at zero instead of\n    # wrapping into a huge wait.\n    fn: lmx_clock_since (uint64_t: start) uint64_t\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_clock

fn: decl_process_deadline (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx.h.lm1\"\n\n# THE PROCESS DEADLINE: ONE COARSE, ONE-SHOT, INDEPENDENT WATCHDOG FOR ONE SYNCHRONOUS OPERATION\n# (author's ruling of 2026-09-21, via Codex: the upper frame's close may not depend on the operation\n# returning in order to be bounded).\n#\n# WHAT IT IS FOR, in one sentence: the cooperative closure checks can only fire where a pass runs, so\n# a child body that never returns -- or a lane that never comes back -- cannot be ended by them, and\n# a bound that lives on the operation's own stack cannot fire while that stack is stuck.  This module\n# owns the bound instead: ONE OS thread waiting ONCE on a completion event shared with the caller.\n#\n# WHY THE WAIT CAN BE DISARMED WITHOUT POLLING.  The body waits once on one completion signal for\n# the computed milliseconds: the caller signals that the operation SUCCEEDED, so a successful\n", f) < 0
        return: 1
    if: c.fputs("# operation cannot be killed later, and the timeout branch is the failure branch.  Nothing is\n# sampled in a loop, there is no polling sleep and no second timestamp -- the wait comes from the\n# operation's ONE deadline through the modular helpers, so an already-expired deadline arms a ZERO\n# wait instead of underflowing into a word-sized eternity.\n#\n# WHAT THIS MODULE MAY NOT DO: it is not a Message, Thread, mailbox or graph mechanism; it touches\n# none of those and is not reachable from them.  The completion event is synchronisation between ONE\n# caller and ONE watchdog of the same operation, nothing else.\n#\n# WIDTHS, stated because a mistake here is invisible to every test this build can run: the deadline\n# is a size_t PLATFORM WORD (lmx_clock_word reads the full clock -- see lmx_clock.h.lm1) and\n", f) < 0
        return: 1
    if: c.fputs("# the platform's wait parameter is a 32-bit millisecond count, so the wait is clamped, not truncated.\n# Precision is NOT a claim of this module: minute-scale tolerance was accepted, and the value is used\n# coarsely.\n\nstruct: LmxProcessDeadline\n    @: void event\n    @: void thread\n    unsigned: wait_ms\n    int: armed\nend: LmxProcessDeadline\n\nprototype:\n    # Arm one watchdog for ONE operation with the ONE deadline that bounds it; zero is refused as \"no\n    # bound at all\".  Setup failure is reported to the caller and leaves no partially armed\n    # resource behind; only expiry of a successfully armed bound is fatal to the process.\n    fn: lmx_process_deadline_arm (@: LmxProcessDeadline d; size_t: deadline) int\n    # Disarm and join: signal the event, wait for the watchdog to leave its wait, close both handles.\n    fn: lmx_process_deadline_disarm (@: LmxProcessDeadline d) int\n", f) < 0
        return: 1
    if: c.fputs("end: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_process_deadline

fn: decl_schedule (@: f c.FILE) int
    if: c.fputs("include: \"<stddef.h>\"\npredef: \"l2src/lmx_arena.h.lm1\"\n\ndefine: LMX_SCHEDULE_OK 0\ndefine: LMX_SCHEDULE_INVALID 1\ndefine: LMX_SCHEDULE_IDLE 0\ndefine: LMX_SCHEDULE_WAITING 1\ndefine: LMX_SCHEDULE_OVERDUE 2\n\n# The scheduler's own record for one executable object: how long it may wait and\n# how long it has waited. Membership belongs only to the parent's graph Array.\n#\n# This is one of the cells that used to be piled into the record.  It is the\n# scheduler's data; the letter stays the\n# four fields it is, the base Structure stays three, and neither is extended to\n# carry it (LmxMsg and Lmx are closed; see the notes in those two headers).\n#\n# `owner` is an address, not a typed field: what it points at is answered by the\n# registered range the address falls into (lmx_implements), never by a tag stored\n# here.  A record whose owner is not an executable object is refused by the\n", f) < 0
        return: 1
    if: c.fputs("# scheduler rather than trusted.\n#\n# The limit is what makes a wait bounded.  Model 33 and Mikhail's rule that a\n# program may crash but cannot hang: every parent has a timeout on its child and\n# every child on its parent, so no wait is longer than the timeout.  The limit and the\n# start are readings of the CYCLE's clock (lmx_clock): the record does not own time, it\n# only remembers when it started and how long it may last, and every call that ages a\n# wait is handed the reading by the cycle.\nstruct: LmxSchedule\n    @: void owner\n    # The record's OWN band: the arena it was CREATED in, written once by lmx_schedule_init and\n    # never moved.  The end-turn collection runs on the band that holds the turn (model 24) -- the\n    # object's own storage is what is collected, and only that band may collect it -- so the record\n", f) < 0
        return: 1
    if: c.fputs("    # carries its band from the moment it exists and a queue never has to know it: a record created\n    # in one Message's arena stays that arena's even while a root's round steps it.  Zero is the\n    # creator naming none: that turn's boundary collects nothing (lmx_turn_end), which is a\n    # legitimate state for a world whose values are held outside any arena.\n    @: LmxArena arena\n    # The wait's own arithmetic, in the cycle's milliseconds.  A 32-bit reading is\n    # enough: `now - started` stays correct across a wrap because the arithmetic is\n    # modulo 2^32 and a limit is small.\n    ulong: started\n    ulong: limit\n    int: state\n    # The OS thread running this lane, when the manager in use is the RUNNING one\n    # (lmx_manager_running.lm1).  Zero means this lane has no thread of its own --\n    # which is the normal state under the stepped manager.  The field is the\n", f) < 0
        return: 1
    if: c.fputs("    # scheduler's bookkeeping, never a cell of the letter or of the object.\n    @: void lane\nend: LmxSchedule\n\nprototype:\n    # The record's creation act: its owner, the band it will be collected on, and how long a wait it\n    # may have.  A record with no band is refused (see the field above).\n    fn: lmx_schedule_init (@: LmxSchedule slot; @: LmxArena arena; @: void owner; ulong: limit) int\n    # `now` is the cycle's reading: the wait starts there, and the caller owns the clock.\n    fn: lmx_schedule_wait (@: LmxSchedule slot; ulong: now) int\n    fn: lmx_schedule_tick (@: LmxSchedule slot; ulong: now) int\n    fn: lmx_schedule_state (@: LmxSchedule slot) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_schedule

fn: decl_turn (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx_thread.h.lm1\"\n\n# lmx_turn.h.lm1 - the end-turn boundary (spec 19.29.4.1, model 27 and 28).\n#\n# 19.29.4.1 fixes exactly one local boundary at end-turn, and it has three acts:\n#\n#     determine turn outcome\n#         -> publish successful FIFO outbox OR discard failed staged outbox\n#         -> release completed inbox/turn roots\n#         -> collect the owning Message arena\n#\n# This module is the first act, the outcome it turns on, and -- since the collection exists\n# (lmx_gc) -- the two acts after it: the turn's temporary roots are gone by the time the\n# outgoing is published or discarded, and the owning arena is collected right after, on the\n# band that held the turn (the arena is the record's own band, lmx_schedule_init wrote it).\n# The whole boundary of 19.29.4.1 is therefore here, in this order, for both bindings and for\n# the root's own turn.\n#\n", f) < 0
        return: 1
    if: c.fputs("# The outcome is read from the Message's own two flags and needs no third meaning:\n#\n#   stopped without completing (running=0, success=0) -> the turn FAILED: what it prepared was\n#       never published, so the staged outbox is discarded and the turn's reserved children are\n#       dropped (model 26: \"при неуспехе ... неопубликованные резервации ... убираются\").\n#   anything else -- the work is still running, or it completed -> the turn SUCCEEDED: the\n#       staged outbox is published in FIFO order and the reserved children are published, one\n#       store each (model 28: \"При успехе публикуются исходящие и подготовленные дети\").\n#\n# A failure here is NOT a rollback: the turn's graph writes stand (spec 19.29.4.1: \"This does\n# not roll back earlier graph mutations\"), and what an EARLIER successful turn published stands\n# too (\"failure discards its staged outbox, but not already published graph/own-field writes\").\n# What goes is exactly what this turn prepared and never exposed.\n#\n# Neither act here asks the arena anything, so a lane performs the boundary without holding\n# one -- which is what lets the running binding call it from its own loop (lmx_manager_running).\n# The collection does need the arena, and it is found on the record, not handed in.\n\n", f) < 0
        return: 1
    if: c.fputs("define: LMX_TURN_OK 0\ndefine: LMX_TURN_INVALID 1\ndefine: LMX_TURN_SUCCESS 0\ndefine: LMX_TURN_FAILED 1\n# The BODY's own status, as a turn hands it to the boundary: 0 when the body succeeded, any other\n# value when it failed.  Not a Thread status and not a walk status -- the body's own report, which\n# the boundary turns into the turn's outcome (lmx_turn.lm1, lmx_turn_end_status).\ndefine: LMX_TURN_BODY_OK 0\n\nprototype:\n    # What this turn's outcome is, from the Message's own flags (see above).\n    fn: lmx_turn_outcome (@: LmxThread t) int\n    # The boundary: publish or discard, and publish or drop the reservations.  Called once per\n    # turn, after the turn has been left (lmx_thread_leave), by whichever binding ran it.\n    fn: lmx_turn_end (@: LmxThread t; ulong: now) int\n    # THE SAME BOUNDARY, WITH THE BODY'S OWN STATUS CARRIED IN.  A turn whose body reported a\n    # nonzero status is a FAILED turn even when the Message's flags say the work continues, so its\n    # staged outbox and its reservations are discarded exactly as a stopped turn's are -- while\n", f) < 0
        return: 1
    if: c.fputs("    # the turn's graph and own writes stand, as they always did.  The Thread calls THIS form\n    # (lmx_thread.lm1); lmx_turn_end above stays the flags-only form its other callers use.\n    fn: lmx_turn_end_status (@: LmxThread t; ulong: now; int: body_status) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_turn

fn: decl_settle (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx_arena.h.lm1\"\npredef: \"l2src/lmx_message.h.lm1\"\npredef: \"l2src/lmx_thread.h.lm1\"\npredef: \"l2src/lmx_schedule.h.lm1\"\npredef: \"l2src/lmx_service.h.lm1\"\npredef: \"l2src/lmx_manager.h.lm1\"\n\n# lmx_settle.h.lm1 - the settling of a finished direct child (spec 19.29.8; the last open\n# item of the core, OPEN_NOW.md item 5).\n#\n# Spec 19.29.8, verbatim: \"After final successful completion, reclaim the Message's own\n# execution history by default\"; \"After final non-successful completion, transfer its logical\n# arena to its direct parent's available lifecycle endpoint without copying.  The parent\n# adopts the blocks/ranges and retains the failed root at its own end-turn or equivalent\n# serialized owner-only lifecycle boundary\"; \"Each closing Message settles only its direct\n# children: successful own histories can be reclaimed; failed arenas are adopted before its\n# own failed arena moves upward\"; \"A stopped parent may still accept handoffs while settling\n# its children; running=0 does not mean that its lifecycle endpoint has disappeared\"; \"in\n", f) < 0
        return: 1
    if: c.fputs("# P -> C -> G, with C and G failed, G's blocks first join C, then C's blocks join P.  Native\n# addresses stay unchanged and P retains the failure root.  There is no ancestor scan of\n# grandchildren, global crash manager or graph clone.\"\n#\n# Nothing here is new machinery: the transfer without copying is lmx_arena_attach, reached\n# through lmx_child_handoff, which already refuses while the child is not handoff-safe; the\n# record leaves the schedule through lmx_manager_remove, whose own header names this act\n# (\"its storage released by the settle that reclaimed it\"); the child leaves the parent's\n# list of live direct children through lmx_thread_child_remove.  What was missing is the\n# SETTLER itself -- the act that decides, per child, which of the two endings applies.\n#\n# The readiness of a child is read as ONE predicate over its two flags, from the settling\n# side (lmx_message.h.lm1 says exactly why: \"the decision 'not running and handoff-safe'\n# reads the two in ONE predicate, and it is read from the settling side\").\n#\n# An orphan (a record whose parent went away) is NOT this act's case: 19.29.8 gives it its\n# own policy under R0 (lmx_orphan.h.lm1), and \"an orphan is settled only by that policy,\n# never by its supervising root's ordinary settle step\".\n", f) < 0
        return: 1
    if: c.fputs("define: LMX_SETTLE_OK 0\ndefine: LMX_SETTLE_INVALID 1\n# The child is closed, but something under it is still ALIVE, and nothing is freed while that is\n# so (Mikhail, 19.09: \"не освобождать ничего, что ещё живо\").  Its own live children are given the\n# stop request and the reap is POSTPONED to a later boundary -- the child stays where it is, in the\n# parent's list, in the service and in the schedule, with its arena untouched.  Without this, the\n# success path reclaims an arena that a live grandchild's own record still answers in.\n#\n# THE POSTPONEMENT IS A WAIT, AND A WAIT ENDS (19.09, evening): the child under it was ASKED to\n# close, and the moment of that ask is in the parent's own node.  A child that reaches no boundary\n# of its own within its own band's window is closed by the maintenance rule -- without a turn --\n# so this deferral is never forever, and the parent is never retained for good\n# (`RF NO_CLOSING_TURN` / `RF WINDOW_CLOSED`, tests\\lmx_app_reroot_forbidden_selftest.lm1).\ndefine: LMX_SETTLE_DEFERRED 2\n# At least one DIRECT CHILD was CLOSED IN PLACE rather than ENDED: its terminal close ran (its\n# subtree, then its own mailbox) but nothing of it was taken -- record, route and arena stay with\n# their owner -- so the caller must not release its own route, service or arena either.\ndefine: LMX_SETTLE_CLOSED 3\n", f) < 0
        return: 1
    if: c.fputs("# A DIRECT CHILD IS STILL LIVE AND COULD NOT BE CLOSED: it keeps its place in the parent's chain and\n# the level must WAIT for it (its own lane ends it, or the closure's deadline kills the process).\n# Nothing is unlinked and nothing is claimed when this is returned.\ndefine: LMX_SETTLE_LIVED 4\n\nprototype:\n    # Not running AND handoff-safe -- the one predicate the settling side reads.  A child\n    # that still runs is not this act's business: its stop is a write to `running`, and the\n    # closing that follows is the family-closure step (spec 32), not this one.\n    fn: lmx_settle_ready (@: LmxMsg message) int\n    # Settle every settled direct child of `t`.  `parent_arena` is the parent's own arena --\n    # a thread stores no arena of its own (\"the arena is the context of the act, so the caller\n    # supplies it\") -- and is where a FAILED child's blocks go.  `service` and `manager` are\n    # the parent's, so that a settled child stops being a route and stops being stepped.\n    # A child that is not settled is left exactly as it is -- but the walk does ONE thing to it\n    # before the gate is asked: a child that was ASKED to close and has reached no boundary of its\n    # own within its own band's window is closed here, without a turn (lmx_stop_close; the\n    # maintenance rule of 19.29.8).  Only the CLOSE, never the request: a settle passes working\n", f) < 0
        return: 1
    if: c.fputs("    # children by, and stopping them is the cascade's business.  For a DIRECT child of the root\n    # this walk is the only boundary there is (the root is never settled), which is why the rule\n    # sits here and in the stop act both.\n    fn: lmx_settle_children (@: LmxThread t; @: LmxArena parent_arena; @: LmxService service; @: LmxManager manager; ulong: now) int\n    # The close's own one level: asks each direct child to stop, and CLAIMS the quiescent ones --\n    # running the child's own terminal close for it rather than waiting out its window.  Returns\n    # LMX_SETTLE_CLOSED when any child had to be closed that way.  Service and manager are UNTYPED\n    # here on purpose: this header is predef'd by the thread unit, which cannot name their types\n    # without a cycle.\n    fn: lmx_settle_close_one_level (@: LmxThread t; @: LmxArena arena; @: void service; @: void manager; size_t: deadline) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_settle

fn: decl_manager (@: f c.FILE) int
    if: c.fputs("include: \"<stddef.h>\"\npredef: \"l2src/lmx_schedule.h.lm1\"\npredef: \"l2src/lmx_thread.h.lm1\"\npredef: \"l2src/lmx_arena.h.lm1\"\n\ndefine: LMX_MANAGER_OK 0\ndefine: LMX_MANAGER_INVALID 1\ndefine: LMX_MANAGER_EMPTY 2\n\n# The scheduler's interface.  ONE API, TWO IMPLEMENTATIONS -- stepped and running --\n# and the manager carries whichever implementation it was bound to in `api`\n# (Mikhail, 2026-09-17: \"если lmx_manager сейчас сам шагает по детям значит надо\n# сделать второй с тем же API -- иначе работать будет невозможно\").\n#\n#   stepped  (lmx_manager.lm1)      -- the scheduler walks the objects itself, one\n#                                      turn at a time.  This is the binding that\n#                                      `lmx_manager_init` makes.\n#   running  (lmx_manager_running.lm1) -- every record gets a lane of its own: an OS\n", f) < 0
        return: 1
    if: c.fputs("#                                      thread that loops over that one object's turns.\n#                                      Bound by `lmx_manager_running_init`.\n#\n# A caller holds the manager and calls through `api`; which implementation runs is\n# decided once, at binding, and nothing else in the caller changes.  LmxManager is\n# named before it is defined so the function-pointer types can point at it; the\n# struct: below completes the same tag.\n#\n# The arena of the Message is NOT named on these operations.  Every record carries its own band from\n# creation (lmx_schedule.h.lm1: `arena`), and that is the arena the domain question is asked of and\n# the arena the record's turn boundary collects -- so a queue needs no arena of its own and a caller\n# supplies none: one round can step records of several bands (a root's own children and a re-rooted\n# orphan) without ever being told which band it runs on.  The manager stores no arena of its own.\n#\n# The reading `now` arrives the same way and for the same reason.  Time belongs to the cycle\n# that runs the schedule (model 25 (iii), 33; lmx_clock is the only place that asks the\n# platform), so every operation that ages a wait is GIVEN the reading: one cycle, one\n# reading, and every record in it ages against that one number.\n", f) < 0
        return: 1
    if: c.fputs("type: LmxManager struct LmxManager\n\nfnptr: LmxManagerAdd (@: LmxManager m; @: LmxSchedule slot) int\nfnptr: LmxManagerRemove (@: LmxManager m; @: LmxSchedule slot) int\nfnptr: LmxManagerTake (@: LmxManager m) @: LmxSchedule\nfnptr: LmxManagerCount (@: LmxManager m) size_t\nfnptr: LmxManagerStep (@: LmxManager m; ulong: now) int\n\nfnptr: LmxManagerInit (@: LmxManager m) int\nfnptr: LmxManagerRound (@: LmxManager m; unsigned: ticks; ulong: now) int\n\nstruct: LmxManagerApi\n    LmxManagerInit: init\n    LmxManagerAdd: add\n    LmxManagerRemove: remove\n    LmxManagerTake: take\n    LmxManagerCount: count\n    LmxManagerStep: step\n", f) < 0
        return: 1
    if: c.fputs("    LmxManagerRound: round\nend: LmxManagerApi\n\n# The scheduler, as data.  It does NOT start OS threads by itself: the stepped\n# binding runs over the objects one turn at a time, and the running binding gives\n# each record a lane.  Model 29 and Mikhail on 2026-09-15: \"реализация L3 Thread\n# планировщика который не запускает потоков детей а бегает по ним сам\".\n#\n# The manager owns no membership queue. It traverses the one ordinary Array<@LmxThread> in its\n# owner Thread's graph and keeps only a transient round-robin cursor. A schedule record remains the\n# timing state of one Thread; it is not a membership record.\n#\n# There is no lock here and none is wanted: a lane is serial, and the only\n# synchronized collection the design allows is the mailbox (model 30).\nstruct: LmxManager\n    @: LmxThread owner\n    size_t: cursor\n    LmxManagerApi: api\n", f) < 0
        return: 1
    if: c.fputs("end: LmxManager\n\nprototype:\n    fn: lmx_manager_init (@: LmxManager m) int\n    fn: lmx_manager_bind (@: LmxManager m; @: LmxThread owner) int\n    fn: lmx_manager_api (@: LmxManager m) @: LmxManagerApi\n    fn: lmx_manager_add (@: LmxManager m; @: LmxSchedule slot) int\n    # Compatibility validation before the serialized parent removes the physical Thread from its\n    # graph Array. The manager stores no separate membership. A lane ends by itself\n    # (lmx_manager_running.h.lm1).\n    fn: lmx_manager_remove (@: LmxManager m; @: LmxSchedule slot) int\n    fn: lmx_manager_take (@: LmxManager m) @: LmxSchedule\n    fn: lmx_manager_count (@: LmxManager m) size_t\n    fn: lmx_manager_step (@: LmxManager m; ulong: now) int\n    fn: lmx_manager_round (@: LmxManager m; unsigned: ticks; ulong: now) int\n    # The running binding's operations are declared in lmx_manager_running.h.lm1: its\n    # thread entry has a platform type, and the platform stays out of this header.\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_manager

fn: decl_service (@: f c.FILE) int
    if: c.fputs("include: \"<stddef.h>\"\npredef: \"l2src/lmx.h.lm1\"\npredef: \"l2src/lmx_arena.h.lm1\"\npredef: \"l2src/lmx_message.h.lm1\"\npredef: \"l2src/lmx_thread.h.lm1\"\n\n# lmx_service.h.lm1 - the mail service: a sorted list of PHYSICAL addresses that answers\n# membership in bounded time (spec 2 and 19.29.7; the gaps note's item 3, the delivery half).\n#\n# Mikhail, 2026-09-16, verbatim: \"завести почтовый сервис который будет хранить сортированный\n# список адресов и давать за конечное время (только не перебором по одному) вхождение?!!!!  Тот\n# же самый R0.\"  And on an address that is not there: an absent address is refused BY THE SERVICE,\n# not by any parent, and it is refused without dereferencing it.\n#\n# The service is not a new entity: every Message is created from the root Message by the chain, so\n# the root passes itself as the mail service at merge, and every Message holds its service's\n# address from its creation.  The service handed down the chain may be ANY Message, not only the\n# root, and what it holds is this: entries ordered by the physical address of a live record.\n", f) < 0
        return: 1
    if: c.fputs("#\n# Ordering is the whole mechanism, and it is the arena's own trick again: the ENTRIES are ordered\n# and bisected, while the records they name never move.  So growth may reallocate the entry array\n# (the entries move, the targets do not), a lookup is a bisection and never a walk of the list.\n# The key of an entry is the physical address of the executable Message prefix. Because it is the\n# first by-value member this equals the containing LmxThread address, but Message remains the mail\n# identity and Thread remains the exact executor type. It is not a composed hierarchical address.\n#\n# An entry carries the target's own arena beside the target, because delivery is an admission into\n# the target's mailbox and the mailbox's queue nodes are cells of THAT arena.  The arena is the\n# context of the act, and this is the act's context -- not a second description of the Message.\ndefine: LMX_SERVICE_OK 0\ndefine: LMX_SERVICE_INVALID 1\n# The entry array could not grow.  Nothing is registered and nothing is disturbed.\ndefine: LMX_SERVICE_FULL 2\n# This record is already registered under its own physical address.\ndefine: LMX_SERVICE_DUPLICATE 3\n# An address no live record has: the refusal of 19.29.7.  The address is never dereferenced.\n", f) < 0
        return: 1
    if: c.fputs("define: LMX_SERVICE_MISSING 4\n\n# One live record: where it stands, and how to reach it.\n#\n# The key is the PHYSICAL address of the LmxThread record (the pointer value).  Entries own no\n# separate cell array -- nothing is allocated per address beyond the entry itself.\nstruct: LmxServiceEntry\n    # The physical address of the live executable Message prefix (= its containing LmxThread*).\n    # Ordering and bisection key.\n    @: void address\n    # The record itself: the target's L3 Thread (same pointer as `address` at registration).\n    @: void target\n    # The target's own arena: the mailbox this service delivers into is storage of that arena.\n    @: LmxArena arena\n    # The service this entry belongs to: a hop that holds an entry holds its route AND its\n    # registry, so a postman needs no second reference to find where to hand a letter next.\n    @: LmxService service\nend: LmxServiceEntry\n", f) < 0
        return: 1
    if: c.fputs("\n# Fixed array of service registry entries (declare once; element type LmxServiceEntry).\nstruct: LmxServiceEntryArray\n    size_t: len\n    @: LmxServiceEntry data\nend: LmxServiceEntryArray\n\n# The service, as data.  Entries are one ordered DynamicArray (Q18).\nstruct: LmxServiceEntryDynamicArray\n    LmxServiceEntryArray: array\n    size_t: capacity\nend: LmxServiceEntryDynamicArray\n\nstruct: LmxService\n    LmxServiceEntryDynamicArray: entries\nend: LmxService\nprototype:\n    # Zero the service.  A by-value service must be cleared before it is opened; opening a\n", f) < 0
        return: 1
    if: c.fputs("    # non-empty one is refused, exactly as a pool refuses to be opened twice.\n    fn: lmx_service_open (@: LmxService service) int\n    # Register a live record under ITS OWN physical address (the address of the LmxThread\n    # record itself).  No hierarchical composition -- the pointer value is the key.\n    fn: lmx_service_register (@: LmxService service; @: LmxThread target; @: LmxArena target_arena) int\n    # The record at this physical address, or null.  A bisection, not a walk.  A foreign\n    # address is refused without dereference.\n    fn: lmx_service_find (@: LmxService service; @: void address) @: void\n    # DELIVERY: the record at that physical address is found and the letter is admitted into\n    # ITS mailbox.  An address no record has is refused by the service and is never\n    # dereferenced (19.29.7).  letter_arena is the Message's OWN arena (spec 19.29.2): on\n    # LMX_SERVICE_MISSING the service releases that arena (undelivered letter = release the\n    # letter's arena). On success the producer publishes {letter, letter_arena}; only the receiver\n    # owner attaches that arena immediately before taking/exposing the letter (19.28.R2.5).\n    fn: lmx_service_post (@: LmxService service; @: void address; @: LmxMsg letter; @: LmxArena letter_arena) int\n    # One record leaves: its physical address is free again and its entry is unlinked.\n    fn: lmx_service_unregister (@: LmxService service; @: LmxThread target) int\n    # Release the entry array.  The records are not the service's to free.\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_service_release (@: LmxService service) int\n    fn: lmx_service_count (@: LmxService service) size_t\n    # The i-th record in PHYSICAL-ADDRESS order: what the ordering itself is checked by.\n    fn: lmx_service_at (@: LmxService service; size_t: index) @: void\n    fn: lmx_service_entries_data (@: LmxService service) @: LmxServiceEntry\n    fn: lmx_service_entries_len (@: LmxService service) size_t\n    fn: lmx_service_entries_cap (@: LmxService service) size_t\n    fn: lmx_service_entries_set_data (@: LmxService service; @: LmxServiceEntry data) void\n    fn: lmx_service_entries_set_len (@: LmxService service; size_t: len) void\n    fn: lmx_service_entries_set_cap (@: LmxService service; size_t: capacity) void\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_service

fn: decl_manager_running (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx_manager.h.lm1\"\n\nfnptr: LmxManagerWork (@: void arg) int\n\n# The running manager's header.  It is separate from lmx_manager.h.lm1 on purpose:\n# the manager's INTERFACE is portable and lives there.  The thread entry a platform\n# hands to the OS, and that platform's types, live in the body this header's consumers\n# predef under the neutral name.\n\nprototype:\n    fn: lmx_manager_running_init (@: LmxManager m) int\n    # The arena of the Message: admitting a record asks the domain question, and the\n    # index that answers it belongs to the arena.  step and round carry the arena\n    # because they fill the SAME api slots as the stepped binding's (one interface,\n    # one signature); a lane's start and reap ask the table nothing, so the arena is\n    # carried through them, not read.  take, count and close are not api slots and\n    # ask nothing of the table, so they name no arena.\n    #\n", f) < 0
        return: 1
    if: c.fputs("    # The reading `now` is carried for exactly the same reason -- it is in the slot's\n    # signature -- and it is not read here either: a LANE is a cycle, so the lane's own\n    # loop reads the clock and ages its record itself (lmx_manager_running_body).  The\n    # stopped path of this file therefore never touches the parameter, and neither does\n    # the started one: there is nothing for it to age from here.\n    fn: lmx_manager_running_add (@: LmxManager m; @: LmxSchedule slot) int\n    # The same removal as the stepped binding's: the owner removes the Thread from its sole\n    # graph Array; a lane, if this record had one, ends by itself.\n    fn: lmx_manager_running_remove (@: LmxManager m; @: LmxSchedule slot) int\n    fn: lmx_manager_running_take (@: LmxManager m) @: LmxSchedule\n    fn: lmx_manager_running_count (@: LmxManager m) size_t\n    fn: lmx_manager_running_step (@: LmxManager m; ulong: now) int\n    fn: lmx_manager_running_round (@: LmxManager m; unsigned: ticks; ulong: now) int\n    fn: lmx_manager_running_close (@: LmxManager m) int\n    # Has this record's lane already ended? No lane means yes: nothing else is\n    # still inside its storage. The body looks; a later reap still owns the join.\n    fn: lmx_manager_running_lane_ended (@: LmxSchedule slot) int\n    # Let other threads run for about this many milliseconds. Zero yields once.\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_manager_running_pause_ms (unsigned: ms) int\n    # A selftest's own thread: start it, ask whether it is still running, then join and release it.\n    fn: lmx_manager_running_thread_start (LmxManagerWork: work) @: void\n    fn: lmx_manager_running_thread_running (@: void handle) int\n    fn: lmx_manager_running_thread_join (@: void handle) int\n    # The calling thread's id, as a number. Zero is not a promise.\n    fn: lmx_manager_running_thread_id () size_t\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_manager_running

fn: decl_orphan (@: f c.FILE) int
    if: c.fputs("include: \"<stddef.h>\"\npredef: \"l2src/lmx_arena.h.lm1\"\npredef: \"l2src/lmx_message.h.lm1\"\npredef: \"l2src/lmx_service.h.lm1\"\npredef: \"l2src/lmx_manager.h.lm1\"\n\n# Orphan retention is a policy over ordinary children of R0. There is no orphan\n# membership list: the sole membership source remains R0's graph Array<@LmxThread>.\n# Per-child clocks live in the same Thread; this handle keeps only the Array owner\n# and an aggregate evidence counter.\ndefine: LMX_ORPHAN_OK 0\ndefine: LMX_ORPHAN_INVALID 1\ndefine: LMX_ORPHAN_FULL 2\ndefine: LMX_ORPHAN_FULL_GRAPH 3\ndefine: LMX_ORPHAN_OWNER_REFUSED 4\n\nstruct: LmxOrphanLedger\n    @: LmxThread owner\n", f) < 0
        return: 1
    if: c.fputs("    size_t: reclaimed\nend: LmxOrphanLedger\n\nprototype:\n    fn: lmx_orphan_init (@: LmxOrphanLedger ledger; @: LmxThread owner) int\n    fn: lmx_orphan_adopt (@: LmxOrphanLedger ledger; @: LmxMsg orphan; @: LmxArena orphan_arena; @: LmxThread thread; @: LmxService service; @: LmxManager manager; ulong: now; ulong: limit) int\n    fn: lmx_orphan_maintain (@: LmxOrphanLedger ledger; @: LmxService service; @: LmxManager manager; ulong: now) int\n    fn: lmx_orphan_count (@: LmxOrphanLedger ledger) size_t\n    fn: lmx_orphan_reclaimed (@: LmxOrphanLedger ledger) size_t\n    # Teardown only disarms retention. The ordinary synchronous cascade removes each physical\n    # child reference and then releases or attaches its arena.\n    fn: lmx_orphan_release (@: LmxOrphanLedger ledger; @: LmxService service; @: LmxManager manager) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_orphan

fn: decl_child (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx_arena.h.lm1\"\npredef: \"l2src/lmx_message.h.lm1\"\npredef: \"l2src/lmx_thread.h.lm1\"\npredef: \"l2src/lmx_service.h.lm1\"\n\n# Creating a child Message (model 17 step 6, 26 step 6; the gaps note's items 1 and 3).  A\n# child has its OWN arena, the used graph is copied into that arena, and its record is made\n# there. At the END OF THE PARENT'S TURN, publication appends the child's physical Thread to the\n# parent's sole Thread.children List and may also write the Message address to an optional\n# ordinary application result cell. No numeric child position participates in this act:\n#\n#   model 26: \"Родитель в своём turn РЕЗЕРВИРУЕТ дочерний Message, его идентичность и\n#   отдельную arena\"; \"До успешной публикации родительского turn ребёнок не становится\n#   доступным для обычного исполнения входящих.  При неуспехе родителя неопубликованные\n#   резервации/подготовленное владение убираются.\"\n#   model 28: \"При успехе публикуются исходящие и подготовленные дети.  При неуспехе\n#   неопубликованный outbox отбрасывается.\"\n#\n", f) < 0
        return: 1
    if: c.fputs("# So a reservation is the turn's own bookkeeping: the child's address exists (its identity is\n# reserved), but nothing points at it yet, and the reservation is what the boundary either\n# publishes or drops.  The parent can read its own reserved child -- it holds the address --\n# and nothing else can, which is exactly the availability rule of 26.\n#\n# A failure is NOT a rollback of the turn's graph writes (spec 19.29.4.1: \"This does not roll\n# back earlier graph mutations\"), so the drop is specific: the child's own arena is released\n# and the optional result cell is left untouched -- it was never written.\n#\n# The reservation lives in the PARENT's arena, under its own registered domain, like the\n# mailbox's own queue nodes: it is a mechanism record of the turn, not a value of the\n# language.  The list belongs to the turn's owner -- the L3 Thread whose turn it is -- which\n# is what \"состояние ... пишется только на полосе этого Message\" asks for.\n#\n# A child's arena attaches to the parent's only when the child is handoff-safe (model\n# 19.29.7, and that is lmx_arena_attach) -- attaching is not part of creation and not part of\n# publication either.\ndefine: LMX_CHILD_OK 0\n", f) < 0
        return: 1
    if: c.fputs("define: LMX_CHILD_INVALID 1\n\n# One reserved child: its optional physical result cell, Message, arena and Thread binding.\n# `arena` is here so that dropping a reservation releases exactly the storage the reservation\n# created -- there is no second list of them anywhere.\nstruct: LmxReservation\n    # Optional ordinary application-graph field that receives the Message at publication.  A\n    # top-level runtime child may have no such result field; live membership is independently the\n    # parent's one Array<@LmxThread>.  The cell is physical, never reconstructed from an index.\n    @@: void result\n    @: LmxMsg message\n    @: LmxArena arena\n    # The child's own L3 Thread, when the child is one (a plain letter has none, and then no\n    # up-link is written -- the address walk is between L3 Threads, which is what a postman is).\n    # It is here because the PARENT's publication writes the child's up-link on the parent's\n    # lane (spec 19.29.6), and the parent's lane is exactly this act.\n    @: LmxThread thread\n    @: LmxReservation next\n", f) < 0
        return: 1
    if: c.fputs("end: LmxReservation\n\nprototype:\n    # The source graph is classified by `src_arena` (where its addresses answer) and the\n    # child is built in `child_arena`. `result` is either null or the exact physical ordinary\n    # application-graph cell that receives the Message at publication; it must belong to\n    # `src_arena`. Primitive fields, including char, are copied into the child's\n    # typed arena cells; the destination character constructor bootstraps literals.\n    #\n    # This is the bare constructor: it builds the child and publishes NOTHING.  A turn\n    # reserves through lmx_child_reserve, which remembers what the boundary must publish.\n    fn: lmx_child_create (@: LmxArena src_arena; @: LmxArena child_arena; @@: void result; @: Lmx source) @: LmxMsg\n    fn: lmx_child_create_profiled (@: LmxArena src_arena; @: LmxArena child_arena; @@: void result; @: Lmx source; @: Lmx retain_profile) @: LmxMsg\n    # Create the child AND register the reservation in the turn's own list (`t` is the L3\n    # Thread whose turn it is).  Refused when the child cannot be built, and then nothing is\n    # remembered and nothing is published.\n    fn: lmx_child_reserve (@: LmxThread t; @: LmxArena src_arena; @: LmxArena child_arena; @@: void result; @: Lmx source) @: LmxMsg\n    fn: lmx_child_reserve_profiled (@: LmxThread t; @: LmxArena src_arena; @: LmxArena child_arena; @@: void result; @: Lmx source; @: Lmx retain_profile) @: LmxMsg\n", f) < 0
        return: 1
    if: c.fputs("    # The child's own L3 Thread joins the reservation, so that the publication writes the child's\n    # parent up-link (spec 19.29.6) on the parent's lane.  The turn that reserves a\n    # child is the code that gives it an object, so this is the second half of one act; a child\n    # that stays a plain letter is simply never named here, and no parent link is written for it.\n    fn: lmx_child_thread (@: LmxThread t; @: LmxMsg child; @: LmxThread child_thread) int\n    # The end-turn boundary's second act: one publication per reservation, in reservation order,\n    # then the list is empty. A publication that fails drops that\n    # reservation -- its child was never published, so its arena goes -- and the answer says\n    # so while the rest are still published.\n    # The service a record's parent handed it, read from the record's OWN entry: the child is\n    # registered in the service its parent was registered in, and the entry is what a postman\n    # reads.  Null when the record was never registered.\n    fn: lmx_child_service (@: LmxThread t) @: LmxService\n    # `arena` is the PARENT's own arena: it owns the sole children Array backing that\n    # lmx_thread_child_add mutates, and the arena is the context of the act.\n    fn: lmx_child_publish_prepared (@: LmxThread t; @: LmxArena arena) int\n    # The end-turn boundary's failure act: nothing was published, so each reserved child's\n    # own arena is released and the list is empty. The optional result cells are untouched: they\n", f) < 0
        return: 1
    if: c.fputs("    # were never written.\n    fn: lmx_child_drop_prepared (@: LmxThread t) int\n    # Handing a finished child over: its arena attaches to the parent's, so the parent's\n    # address-range table answers for the child's cells too and nothing is copied (model 19.29.7, and\n    # the attach is lmx_arena_attach).  Refused while the child is not handoff-safe --\n    # that mark is written by the child itself when it leaves its last turn (model 32),\n    # and attaching an arena whose Message still runs would hand over storage in use.\n    fn: lmx_child_handoff (@: LmxArena parent_arena; @: LmxArena child_arena; @: LmxMsg message) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_child

fn: decl_reparent (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx_thread.h.lm1\"\npredef: \"l2src/lmx_graph_copy_owned.h.lm1\"\n\n# Read-only preflight for linking an existing Thread under new_parent.  It walks the\n# actual Message graph of the moved Thread and its descendants.  A foreign sealed\n# branch is admissible only while its owner arena remains on the resulting Message\n# ancestor chain.  No name, numeric branch key, or permanent dependency record is\n# needed; all identities are stable physical addresses.\ndefine: LMX_REPARENT_OK 0\ndefine: LMX_REPARENT_INVALID 1\ndefine: LMX_REPARENT_OWNER 2\ndefine: LMX_REPARENT_NOMEM 3\n\nstruct: LmxReparentEdge\n    # Exact physical C pointer-object access, retained for this transaction\n    # only. Header Lmx * members and primitive T * cells are not void * cells.\n    @: void slot\n    LmxPointerCellRead: read\n    LmxPointerCellWrite: write\n    @: void value\n    @: Lmx source_profile\n    @: LmxArena view\nend: LmxReparentEdge\n\nstruct: LmxReparentEdges\n    @: LmxReparentEdge data\n    size_t: n\n    size_t: room\nend: LmxReparentEdges\n\n# Operation-local copy transaction, never part of the LMX graph. A su", f) < 0
        return: 1
    if: c.fputs("ccessful\n# stage owns its arena and physical source->copy map until the caller either\n# proves and publishes the result or discards the entire stage.\nstruct: LmxReparentCopyStage\n    LmxArena: arena\n    LmxCopyMap: targets\n    LmxCopyMap: pending\n    LmxCopyMap: relocated\n    @@: Lmx sources\n    @@: Lmx results\n    @@: Lmx keep\n    size_t: n\n    size_t: kept\n    int: qualified\nend: LmxReparentCopyStage\n\nstruct: LmxReparentEdit\n    @: void slot\n    LmxPointerCellRead: read\n    LmxPointerCellWrite: write\n    @: void before\n    @: void after\n    @: LmxArena view\nend: LmxReparentEdit\n\nstruct: LmxReparentEdits\n    @: LmxReparentEdit data\n    size_t: n\nend: LmxReparentEdits\n\nprototype:\n    # Recover the one qualified graph root of an imported or local profile\n    # from its physical typed ranges. Zero for an absent/ambiguous profile.\n    # This read-only scan uses no name or redundant root registry.\n    fn: lmx_reparent_profile_root (@: LmxArena view; @: Lmx profile) @: Lmx\n    # On OWNER, `lost` maps each reached sealed profile address to its owner\n    # arena address. On OK it is empty. ", f) < 0
        return: 1
    if: c.fputs("The caller disposes this operation-local\n    # map in either case; other errors leave it empty. No graph metadata is added.\n    fn: lmx_reparent_lost_profiles (@: LmxThread moved; @: LmxThread new_parent; @: LmxCopyMap lost) int\n    # Same read-only scan can retain the physical input edges needed for a\n    # later all-or-nothing redirect. A source_profile identifies an immutable\n    # carrier which cannot be edited in place. Both outputs are scratch only.\n    fn: lmx_reparent_scan (@: LmxThread moved; @: LmxThread new_parent; @: LmxCopyMap lost; @: LmxReparentEdges edges) int\n    fn: lmx_reparent_edges_dispose (@: LmxReparentEdges edges) void\n    # Expand a lost-profile set through sealed carriers that themselves point\n    # into it. These cannot be rewritten in place, even if their own owner\n    # remains visible. The map stays operation-local and uses physical addresses.\n    fn: lmx_reparent_expand_carriers (@: LmxCopyMap selected; @: LmxReparentEdges edges) int\n    # Fixed point in both directions: immutable carriers of selected values\n    # must be copied; a selected carrier's se", f) < 0
        return: 1
    if: c.fputs("aled dependency must also be\n    # copied only if its owner is not visible from the moved Message's new\n    # ancestry, where the copy will live. This remains scratch selection.\n    fn: lmx_reparent_expand_copy_set (@: LmxThread moved; @: LmxThread new_parent; @: LmxCopyMap selected; @: LmxReparentEdges edges) int\n    # Derive the exact root of every selected physical profile from its owner\n    # arena's typed ranges. The output is an operation-local profile -> root\n    # address map, not a persistent root registry or a name lookup.\n    fn: lmx_reparent_selected_roots (@: LmxCopyMap selected; @: LmxCopyMap roots) int\n    # Construct a disposable read-only source view of selected owners' visible\n    # typed indices. Classification here is not a copy or retention decision:\n    # `retained` maps only the exact qualified dependencies already established\n    # by reached edges. Both outputs start empty and are released by the caller;\n    # view must be zero-initialized. No imported interval owns source storage.\n    fn: lmx_reparent_source_view (@: LmxCopyMap selected; @: LmxReparentEdges ", f) < 0
        return: 1
    if: c.fputs("edges; @: LmxArena view; @: LmxCopyMap retained) int\n    # After the common copier reports a *reached* missing sealed profile,\n    # route its physical address to copying or retained-by-address according\n    # to the same ownership/independence rule as merge. This function does not\n    # discover reachability, publish copies, or mutate a Message graph.\n    fn: lmx_reparent_route_missing_profile (@: LmxThread moved; @: LmxThread new_parent; @: LmxArena view; @: Lmx profile; @: LmxCopyMap selected; @: LmxCopyMap retained) int\n    # One common remapped forest copy. On success, stage owns the uncommitted\n    # arena, exact address map and pending names. On a reached missing profile,\n    # `missing` names it but no staged storage survives. No live graph changes.\n    fn: lmx_reparent_stage_copy_set (@: LmxArena view; @: LmxCopyMap selected; @: LmxCopyMap retained; @: LmxReparentCopyStage stage; @@: Lmx missing) int\n    # Prove every selected profile in dependency order against already sealed\n    # retained/copied profiles. A failure still leaves the stage unpublished.\n    fn: lmx_reparent_", f) < 0
        return: 1
    if: c.fputs("qualify_copy_stage (@: LmxReparentCopyStage stage) int\n    # Read-only publication plan: only mutable incoming slots outside the\n    # copied profiles are listed. Immutable carriers were copied and remapped\n    # internally. The exact old value must still be present at each slot.\n    fn: lmx_reparent_stage_edits (@: LmxReparentEdges edges; @: LmxCopyMap selected; @: LmxReparentCopyStage stage; @: LmxReparentEdits edits) int\n    fn: lmx_reparent_edits_dispose (@: LmxReparentEdits edits) void\n    # Pre-import the sealed copies into every affected descendant view while\n    # stage still owns them. On refusal, remove those imports and leave all\n    # graph slots unchanged. On success attach stage to moved_arena, rehome\n    # the imports' owner, publish prepared names, redirect exact slots, and\n    # retire obsolete borrowed views. A successful call consumes stage.\n    fn: lmx_reparent_publish_copy_stage (@: LmxArena moved_arena; @: LmxReparentCopyStage stage; @: LmxReparentEdits edits) int\n    # Kernel implementation of explicit preparation for one proposed move.\n    # No parent link cha", f) < 0
        return: 1
    if: c.fputs("nges. If nothing is lost, it is a no-op; otherwise\n    # every selected branch is copied, proved and published as one operation.\n    fn: lmx_reparent_prepare (@: LmxThread moved; @: LmxThread new_parent) int\n    fn: lmx_reparent_copy_stage_dispose (@: LmxReparentCopyStage stage) void\n    # Probe the shared copier in a disposable arena until every sealed profile\n    # on its reached used paths is either selected or retained. Only the two\n    # scratch maps and the source view change; no Message graph is published.\n    fn: lmx_reparent_close_copy_set (@: LmxThread moved; @: LmxThread new_parent; @: LmxArena view; @: LmxCopyMap selected; @: LmxCopyMap retained) int\n    fn: lmx_reparent_preflight (@: LmxThread moved; @: LmxThread new_parent) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_reparent

fn: decl_thread (@: f c.FILE) int
    if: c.fputs("include: \"<stddef.h>\"\npredef: \"l2src/lmx_message.h.lm1\"\npredef: \"l2src/lmx_post.h.lm1\"\npredef: \"l2src/lmx_schedule.h.lm1\"\npredef: \"l2src/lmx_arena.h.lm1\"\n# LmxCallEntry: one turn takes the handler the caller already holds (lmx_call.h.lm1).\npredef: \"l2src/lmx_call.h.lm1\"\n\ndefine: LMX_THREAD_OK 0\ndefine: LMX_THREAD_INVALID 1\ndefine: LMX_THREAD_STOPPED 2\ndefine: LMX_THREAD_OWNER_REFUSED 3\ndefine: LMX_THREAD_IDLE 0\ndefine: LMX_THREAD_TURN 1\ndefine: LMX_THREAD_DONE 2\n\n# The object's interfaces, each its own table.  An L3 Thread supports all of them\n# and hands them out SEPARATELY -- a thread API and a mail API, composed, never\n# merged into one heap of functions (Mikhail, 2026-09-17: \"сделайте нормальной\n# композицией чтобы он возвращал все свои API по отдельности а не сваливайте в\n# кучу\").  LmxThread is named before it is defined so the function-pointer types can\n# point at it; the struct: below completes the same tag.\ntype: LmxThread struct LmxThread\n\nfnptr: LmxThreadEnter (@: LmxThread t) int\nfnptr: LmxThreadLeave (@: LmxThread t) int\nfnptr: LmxThreadRunning (@: LmxThread t) int\nfnptr", f) < 0
        return: 1
    if: c.fputs(": LmxThreadCurrent () @: LmxThread\n# The interpreter is a replaceable L2 boundary until the L3 interpreter has a stable ABI.\n# It receives only the Thread.  In particular it cannot receive or accidentally call the native\n# entry: the ABI itself makes the two paths mutually exclusive.\nfnptr: LmxThreadMailAccept (@: LmxArena arena; @: LmxThread t; @: void target; int: lane) int\nfnptr: LmxThreadMailTake (@: LmxThread t; int: lane) @: void\nfnptr: LmxThreadMailCount (@: LmxThread t; int: lane) size_t\nfnptr: LmxThreadMailClose (@: LmxArena arena; @: LmxThread t) int\n\n\n# A child remains a live physical Thread until its serialized parent removes that exact address\n# from the List held by parent.children and then releases or attaches the child's arena.  No\n# parallel family-link record or hidden source field is needed: membership is that single List.\n# The liveness stamp and close request state live on the child Thread they describe.  They do not\n# form another collection and cannot answer membership independently of the Array.\n\nstruct: LmxThreadApi\n    LmxThreadEnter: enter\n    LmxThreadLeav", f) < 0
        return: 1
    if: c.fputs("e: leave\n    LmxThreadRunning: running\n    LmxThreadCurrent: current\nend: LmxThreadApi\n\n# The thread's mail API -- every L3 Thread has one, because the mailbox is what makes\n# a Message an L3 Thread.  Today each method delegates to the mailbox module\n# (lmx_post).  The interface a caller holds does not change.  It is a\n# separate table from LmxThreadApi on purpose -- two APIs, returned separately.\n#\n# The arena appears on exactly the two methods whose delegate needs it (accept takes\n# a queue node from the node pool and asks the target's domain, close hands the pool\n# back to the arena), and is left off the two that need neither.  The thread stores\n# no arena of its own: the arena is the context of the act, so the caller supplies it.\nstruct: LmxThreadMailApi\n    LmxThreadMailAccept: accept\n    LmxThreadMailTake: take\n    LmxThreadMailCount: count\n    LmxThreadMailClose: close\nend: LmxThreadMailApi\n\n# The execution state of an L3 Thread.\n#\n# Model 25, Mikhail on 2026-09-14, verbatim: \"L3 Thread -- Message, который может\n# присоединять и/или исполнять любой Message.  Каждый L3 Thread -", f) < 0
        return: 1
    if: c.fputs("- Message, но не\n# каждый Message -- L3 Thread (у шаблона и у письма нет turn, у запущенного\n# ребёнка есть).  Почта и задел под turn есть только у L3 Thread ...  Планировщик\n# есть только у разновидностей L3 Thread\".\n#\n# So an L3 Thread has a Message as its exact physical prefix. `LmxMsg message` is the first\n# by-value member, hence `@thread == @thread\\message`; a plain letter remains a standalone\n# LmxMsg. Mail, schedule, routing and supervision remain Thread-only fields after that\n# closed four-field prefix and are never added to LmxMsg.\n#\n# It is an object and not a mechanism: \"Полоса на экране не может не быть L3\n# Thread. Message без L3 Thread это просто письмо. Полоса же это полноценный\n# объект\" (Mikhail, 2026-09-15).\n#\n# How it is implemented is open by design: the object carries its interfaces, and an\n# implementation may run a thread of its own or be stepped by its parent -- \"lmx_thread\n# имеет API и реализации могут быть разными, в том числе бегающая и небегающая\"\n# (Mikhail, 2026-09-17).  Nothing in this header promises an OS thread.\n#\n# The two poll hooks of lmx.h are ", f) < 0
        return: 1
    if: c.fputs("NOT redeclared here: lmx.h declares them and says\n# the kernel owns the bodies; this unit is the kernel side of that, and a second\n# declaration would only be a second place to keep in step.\nstruct: LmxThread\n    LmxMsg: message\n    @: LmxPost mail\n    @: LmxSchedule slot\n    unsigned: turn\n    int: state\n    # The completed turn body's status, owned by this Thread, not the source graph or a shared call module.\n    # The activation value is never stored here. The launch may copy this result before teardown.\n    int: body_status\n    # Execution is a property of the Thread, never an inference from entry, METHOD, graph body,\n    # a previous result or a failure.  A request made before or during a turn is committed only\n    # by that turn's end boundary and therefore selects the following turn.\n    # This turn's reserved children (lmx_child.h.lm1): the head of the list the end-turn\n    # boundary publishes or drops (model 26, 28 -- \"при успехе публикуются ... подготовленные\n    # дети\").  It is UNTYPED, like every other reference in this kernel: what a node is follows\n    # from the arra", f) < 0
        return: 1
    if: c.fputs("y its address falls into (LMX_DOMAIN_RESERVATION), never from a typed field\n    # here -- and the type would otherwise be a header cycle, since the child module names this\n    # thread.  The list belongs to the turn's owner, which is this object.\n    @: void prepared\n    # The parent Message's L3 Thread -- for R0 this is the structural upper frame, not null.  It is\n    # the UP-LINK used by the postman's physical-address step (lmx_deliver): a child knows its\n    # parent and a parent knows its children through its sole children List. The cell belongs to the\n    # PARENT and is written on the PARENT's lane\n    # at publication (spec 19.29.6).\n    @: void parent\n    # THE STABLE ROUTE BACK TO THIS RECORD'S SERVICE (lmx_service): registration stores it and\n    # unregister clears it, so a record can ask which registry owns it without going near the\n    # service's entries vector.  It must NOT be a pointer INTO that vector: the vector is compacted\n    # by memmove on a removal and moved by realloc on growth, so a stored row pointer is stale\n    # after either act -- measured 2026-09-21, ", f) < 0
        return: 1
    if: c.fputs("single-threaded, no timing involved.  Untyped like\n    # every other reference here; zero for a record no service has registered.\n    @: void service\n    # The sole direct-child membership collection, owned by this Thread record\n    # in its arena, not inserted into the executable source graph. Untyped here\n    # so L3 thread TUs do not import VoidArray. There is no link chain or\n    # scheduler queue containing another membership set.\n    @: void children\n    # Per-child supervision state.  These cells do not establish membership; only the parent's\n    # children list does.  `alive` is stamped by the child's lane and answered by its parent.\n    # `close_deadline` is the one relaxed atomic platform word inherited by a close cascade.\n    size_t: alive\n    ulong: stopped\n    size_t: close_deadline\n    # Orphan retention is supervision state of this same child record, never a second\n    # membership list.  `orphaned` selects the R0 retention policy while the physical Thread\n    # remains an element of R0's one children list.\n    int: orphaned\n    ulong: orphan_started\n    ulong: orphan_", f) < 0
        return: 1
    if: c.fputs("limit\n    # Optional ordinary application-graph field that published this child Message.  It is a\n    # physical cell address, never a numeric slot: success clears it, failure leaves the graph\n    # reference as the retained result.  It is not child-membership; the children list is.\n    @@: void result\n    # THIS object's OWN scheduler (Mikhail, 19.09: \"У каждого Thread своя арена и свой\n    # планировщик!\", \"менеджер у каждого ребёнка свой\"): it traverses this Thread's one\n    # children list. Untyped, like every other reference here -- the manager module names this one, so\n    # the type in this header would be an import cycle (measured: l1trans refuses it).\n    # Opened by lmx_thread_scheduler_open, which takes the arena from its CALLER rather than\n    # inferring ownership from another mechanism record.\n    @: void manager\n    LmxThreadApi: api\n    LmxThreadMailApi: mail_api\nend: LmxThread\n\nprototype:\n    # Canonical construction of an executable Message. The embedded prefix is initialized in\n    # place; no arbitrary external Message can be attached or rebound later.\n    fn: lmx", f) < 0
        return: 1
    if: c.fputs("_thread_init (@: LmxArena arena; @: LmxThread t; @: Lmx graph; @: LmxPost mail; @: LmxSchedule slot) int\n    fn: lmx_thread_enter (@: LmxThread t) int\n    fn: lmx_thread_leave (@: LmxThread t) int\n    # ONE TURN, whole: the boundary, the body, the boundary.  `entry` is\n    # a handler GIVEN FROM OUTSIDE -- the host's for R0 (25 (ii): \"the entry program is R0's\n    # handler\"), which is not a graph callable and has no METHOD record of its own; zero means the\n    # native body is what its OWN GRAPH names when entry is 0: lmx_call0.  A\n    # translated Message's body is a callable occurrence, because \"all executable bodies are part\n    # of the graph\" (model 8); lmx_call0 passes the selected occurrence M's immediate M.parent as\n    # reserved `Lmx *node`. A non-null external `entry` is only the synthetic R0/host adapter and\n    # analogously receives graph.parent, which is 0: the graph hanging in a Thread is independent\n    # (parent = 0), so nothing lexical lies above it. Control bodies inside that invocation never rebind node. A\n    # graph that names no callable is a legitimate state", f) < 0
        return: 1
    if: c.fputs(": the turn is then pure boundary work.\n    # The body runs INSIDE the turn (lm.current is this object while it runs), its status is its own\n    # report and never a stop (model 31), and the boundary follows on the turn's own outcome\n    # (19.29.4.1).  Answers LMX_THREAD_STOPPED when the boundary refuses the turn -- a close is\n    # never resurrected -- and LMX_THREAD_INVALID when the boundary's work failed.\n    fn: lmx_thread_turn (@: LmxThread t; LmxCallEntry: entry; ulong: now) int\n    fn: lmx_thread_running (@: LmxThread t) int\n    fn: lmx_thread_current () @: LmxThread\n    fn: lmx_thread_api (@: LmxThread t) @: LmxThreadApi\n    fn: lmx_thread_mail_api (@: LmxThread t) @: LmxThreadMailApi\n    # The embedded closed Message prefix. Its address is exactly the Thread address.\n    fn: lmx_thread_message (@: LmxThread t) @: LmxMsg\n    # The parent Message's L3 Thread: the up-link the postman follows.  R0 points to its ordinary\n    # structural parent stub; only that stub and a Message not yet linked have null here.\n    fn: lmx_thread_parent (@: LmxThread t) @: LmxThread\n    # This reco", f) < 0
        return: 1
    if: c.fputs("rd's own service entry, or null (lmx_service writes it at registration).\n    fn: lmx_thread_service (@: LmxThread t) @: void\n    # Bind the one children List supplied by this Thread's constructor. The\n    # descriptor and its backing must belong to `arena`; a second binding is refused.\n    fn: lmx_thread_children_bind (@: LmxThread t; @: void children; @: LmxArena arena) int\n    # Construct and bind the sole children List in the record's owner arena.\n    # Source graph size/order/parent are unchanged.\n    fn: lmx_thread_children_open (@: LmxThread t; @: LmxArena arena) int\n    # Construct an explicitly requested application field holding a typed List.\n    # `field` is chosen by the graph producer; it is not a runtime ABI slot.\n    fn: lmx_thread_children_field_new (@: LmxArena arena; @: Lmx graph; size_t: field) @: void\n    fn: lmx_thread_children (@: LmxThread t) @: void\n    fn: lmx_thread_child_count (@: LmxThread parent) size_t\n    fn: lmx_thread_child_at (@: LmxThread parent; size_t: index) @: LmxThread\n    # Live direct children: append, remove, membership, and ordered iteration", f) < 0
        return: 1
    if: c.fputs(" over that list.\n    # The address of this Thread's handshake word -- the child-owned cell the child stamps and\n    # its parent answers (19.29.7.1). Membership comes only from Thread.children.\n    # This object's own scheduler, or null while none was opened.  Untyped: a caller casts.\n    fn: lmx_thread_manager (@: LmxThread t) @: void\n    # Open this object's own scheduler as a record of `arena` (the caller names it).  Refused\n    # when it already has one.  Initialized as the STEPPED manager: a lane is a later choice.\n    fn: lmx_thread_scheduler_open (@: LmxThread t; @: LmxArena arena) int\n    fn: lmx_thread_alive_cell (@: LmxThread t) @: size_t\n    # The driver's terminal hook publishes no ownership change.  The serialized parent removes\n    # the exact physical child reference first, then releases or attaches the child's arena.\n    fn: lmx_thread_finish (@: LmxThread t) int\n    # The Array backing is owned by the parent's arena, named explicitly by the caller.  Addition\n    # preserves insertion order; removal compacts the Array and changes no other ownership state.\n    fn: lmx_", f) < 0
        return: 1
    if: c.fputs("thread_child_add (@: LmxThread parent; @: LmxThread child; @: LmxArena arena) int\n    fn: lmx_thread_child_remove (@: LmxThread parent; @: LmxThread child) int\n    # Explicit Message reparenting.  Its owner preflight precedes any membership\n    # mutation; a failed append or removal leaves the original parent unchanged.\n    fn: lmx_thread_adopt (@: LmxThread child; @: LmxThread new_parent) int\n    fn: lmx_thread_child_is (@: LmxThread parent; @: LmxThread child) int\n    fn: lmx_thread_child_first (@: LmxThread parent) @: LmxThread\n    fn: lmx_thread_child_next (@: LmxThread child) @: LmxThread\n    # Parent half of 19.29.7.1: zero children's fresh stamps (answer); emergency-close stale.\n    fn: lmx_poll_answer_children (@: LmxThread t; ulong: now) int\n    # Spec 32, verbatim: \"a stopped Message has no lane, so nothing runs its children's turns from\n    # it; ITS STOP REQUESTS THEIR CLOSE; a child whose inbox is empty is closed by the maintenance\n    # without a turn, and a child on its own context runs its closing turn there\".  Model 31 names\n    # the parent as the one cross-lane wri", f) < 0
        return: 1
    if: c.fputs("ter of `running`, so this write is the sanctioned one.\n    #\n    # WHAT IS THE REQUEST AND WHAT IS THE CLOSE (read this before touching the act).  The request\n    # is `running = 0`, and it is NOT the close:\n    #   * a child on its own context closes ITSELF -- its lane reaches its boundary, leaves the\n    #     turn and writes the handoff mark there (lmx_thread_leave).  That is the ordinary way, and\n    #     it is the only writer of the mark that cannot be wrong;\n    #   * a child NOBODY RUNS reaches no boundary of its own, so the maintenance closes it -- and\n    #     the wait that ends there is counted from the FIRST request, held in this node's `stopped`.\n    #     When the child's own window (`slot\\limit`, the same number lmx_turn_end's stamp and\n    #     lmx_orphan_maintain age against) has passed, it is closed WITHOUT a turn: stopped AND\n    #     handoff-safe, mail or no mail -- a stopped Message does not wait for letters (Mikhail,\n    #     19.09: \"с какой радости закрытое приложение должно на последнем издыхании ловить\n    #     какие-то письма\").  This act is where that ", f) < 0
        return: 1
    if: c.fputs("window is evaluated, and it is called at every\n    #     settle boundary of the parent and at the parent's own closing boundary, so the cascade\n    #     gets its window level by level.\n    #\n    # WHY THE INBOX IS NOT THE TEST ANY MORE.  This act used to close a child whose inbox was EMPTY\n    # at once, reading \"no letter waiting\" as \"no turn coming, so it has ended\".  That reading is\n    # false for a child that is INSIDE its turn -- and inside its turn its box IS empty, because its\n    # body took the letter at the start of the turn.  Measured (tests\\lmx_app_reroot_forbidden_selftest.lm1,\n    # run 3): the mark went onto a child whose own boundary had not run, and the very next settle\n    # attached its arena to the parent's and released the parent -- under a turn still in flight\n    # (`b_count 7->0 a_count 9->0`).  Handoff-safe means \"I have LEFT my last turn\", and only the\n    # child's own boundary, or a window that says it is not working, can establish that.\n    fn: lmx_stop_children (@: LmxThread t; ulong: now; size_t: deadline) int\n    # The two halves of that act, each re", f) < 0
        return: 1
    if: c.fputs("achable on its own: the request for one child, and the\n    # close of one child whose ask has outlived its own band's window.  `lmx_settle_children` calls\n    # the CLOSE for a child it cannot reap yet (and only the close: a settle must never ask a\n    # running child to stop).  The REQUEST carries the closure's ONE deadline down into the child's\n    # node -- zero for a stop that is not a closure, so a closure beginning later still publishes.\n    fn: lmx_stop_request (@: LmxThread child; ulong: now; size_t: deadline) int\n    fn: lmx_stop_close (@: LmxThread child; ulong: now) int\n    # The closure deadline as the node holds it: one relaxed atomic load of one self-contained word\n    # The one inherited close deadline carried by this child Thread itself.\n    fn: lmx_thread_close_deadline (@: LmxThread child) size_t\n    fn: lmx_thread_close_deadline_publish (@: LmxThread child; size_t: deadline) int\n    # Whether this record's own lane has ended: the stronger boundary the close publishes from, and\n    # the one the STOPPED hook asks before it speaks for a record whose lane may still be", f) < 0
        return: 1
    if: c.fputs(" unwinding.\n    # A record with no lane answers YES (the stepped manager's normal state).\n    fn: lmx_thread_lane_ended (@: LmxThread t) int\n    fn: lmx_thread_mail_accept (@: LmxArena arena; @: LmxThread t; @: void target; int: lane) int\n    fn: lmx_thread_mail_take (@: LmxThread t; int: lane) @: void\n    fn: lmx_thread_mail_count (@: LmxThread t; int: lane) size_t\n    fn: lmx_thread_mail_close (@: LmxArena arena; @: LmxThread t) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_thread

# Declaration-only engine wrapper: algorithms are ordinary L2 bodies.
# The two inherited root-span globals remain explicit debt, not a hidden context.
fn: decl_walk_engine (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx_walk.h.lm1\"\npredef: \"l2src/lmx_walk_state_decl.lm1\"\npredef: \"l2src/lmx_call.h.lm1\"\npredef: \"l2src/lmx_implements.h.lm1\"\npredef: \"l2src/lmx_range.lm1\"\npredef: \"l2src/lmx_arena_refs.lm1\"\npredef: \"l2src/lmx_value_owned.lm1\"\npredef: \"l2src/lmx_array_owned.h.lm1\"\npredef: \"l2src/lmx_chars.lm1\"\n# Inherited program state; declaration generation does NOT remove its ambient-state debt.\n@@: Lmx lmx_walk_program_roots_g 0\nsize_t: lmx_walk_program_root_count_g 0U\npredef: \"l2src/lmx_walk_values.lm1\"\npredef: \"l2src/lmx_scratch.lm1\"\npredef: \"l2src/lmx_primitive.h.lm1\"\npredef: \"l2src/lmx_source_names.h.lm1\"\npredef: \"l1src/libc_abi.lm1\"\ninclude: \"<stdio.h>\" \"<string.h>\" \"<limits.h>\"\n\n", f) < 0
        return: 1
