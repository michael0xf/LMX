Resource:
    int: value 42

Trace:
    int: mode 0
    int: events 0
    eval:
        Trace\events := events * 10 + x
    code:
        throws: ResourceFailure
        eval()
        if: Trace\mode = mode
            throw: ResourceFailure()
    end: code
    Acquire:
        return: @
        open:
            throws: ResourceFailure
            int: x 1
            code(2)
        return: Resource
    Action:
        @: resource
        return: int
        use:
            throws: ResourceFailure
            int: x 2
            code(1)
        return: resource\value
    Release:
        @: resource
        close:
            int: x 3
            eval()
        end: close
    Example:
        int: mode
        return: int
        run:
            throws: copy(FxThrows\sequence)
            Trace\mode := mode
            Trace\events := 0
            int: value \bracket(Acquire\open; Release\close; Action\use)
            return: value * 1000 + Trace\events
            catch: FxCallFailure (@: error)
                return: -Trace\events
