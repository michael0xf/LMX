---
    Observed:
        int: seen 509
    end: Observed
---
@: shared (data [] 0)
fn: own (int: x) int
    @: p int (@ x)
    :=: x 9
    return: (\ p)
end: own
fn: caller () int
    int: x 5
    int: r (own)
    return: ((x * 100) + r)
end: caller
sub: main ()
    :=: ((shared \ Observed) \ seen) (caller)
end: main
main:
