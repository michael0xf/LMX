@: Trace (int: calls 0; int: before 9; int: same 0; int: fixed 0; int: untyped 9; int: arraySame 0)
@: Provider (return: int; Make(Trace\calls := Trace\calls + 1; return: 2))
@: getDepth Provider\Make
Trace\before := Trace\calls
@(getDepth())int: pointer
@@int: repeated
Trace\same := typeof(pointer) = sys\descriptor(@@int)
Trace\fixed := typeof(repeated) = sys\descriptor(@(1 + 1)int)
Trace\untyped := sys\descriptor(@@int) = sys\descriptor(@@)
Trace\arraySame := sys\descriptor([3]@(1 + 1)int) = sys\descriptor([3]@@int)
