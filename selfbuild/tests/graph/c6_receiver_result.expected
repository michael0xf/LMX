---
    Observed:
        int: seen 0
        int: r 2
    end: Observed
---
@: shared (data [] 0)
sub: main ((Made (int a 1) (int b 2)))
    fn: f (int: a) int
        :=: ((shared \ Observed) \ r) a
        return: a
    end: f
    fn: f (@: s) int
        return: 2
    end: f
    f: (length Made)
end: main
main:
