# A ready place of that name at the caller does not shadow the prepared declaration of the callable's own data.
@: D (
    int: here 0
)
fn: caller () int
    int: local 77
    return: outer()
fn: outer () int (
    prepared:
        args: (int: a)
        return: int
        code: (return: a * 3)
    fn: local prepared
    int: r 0
)
    r := local(a := 3)
    node\D\here := r
    return: r
caller()
