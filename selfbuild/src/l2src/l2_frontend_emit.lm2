    @@: msrc_res_cell int (cast: (@@: int) (@ c.l2_msrc_res))
    @@: msrc_pair_cell int (cast: (@@: int) (@ c.l2_msrc_pair))
    @: rw_mi_cell int (cast: (@: int) (@ c.l2_rw_mi))
    @: source_plan_ready_cell int (cast: (@: int) (@ c.l2_source_plan_ready))
    @: mur_n_cell int (cast: (@: int) (@ c.l2_mur_n))
    @: mur_slots_cell int (cast: (@: int) (@ c.l2_mur_slots))
    @: ebr_n_cell int (cast: (@: int) (@ c.l2_ebr_n))
    @: rw_emit_cell int (cast: (@: int) (@ c.l2_rw_emit))
    @@: out_cell c.FILE (cast: (@@: c.FILE) (@ c.l2_out))
    @@: mur_sel_cell int (cast: (@@: int) (@ c.l2_mur_sel))
    @@: mur_len_cell int (cast: (@@: int) (@ c.l2_mur_len))
    @@: mur_sbuf_cell int (cast: (@@: int) (@ c.l2_mur_sbuf))
    @@: mur_off_cell int (cast: (@@: int) (@ c.l2_mur_off))
    @@: mres_code_schema_cell int (cast: (@@: int) (@ c.l2_mres_code_schema))
    @@: own_ty_cell int (cast: (@@: int) (@ c.l2_own_ty))
    @@: mres_body_ns_cell int (cast: (@@: int) (@ c.l2_mres_body_ns))
    @: held_n_cell int (cast: (@: int) (@ c.l2_held_n))
    @@: msrc_slot_cell int (cast: (@@: int) (@ c.l2_msrc_slot))
    @@: msrc_op_cell int (cast: (@@: int) (@ c.l2_msrc_op))
    @@: msrc_fld_cell int (cast: (@@: int) (@ c.l2_msrc_fld))
    @: source c.L2ReferenceSource @ mres_source_cell[0][res]
    int: qual c.lm_compiler_merge_qualifiers(stmt)
    int: qx 0
    const: (@: rec char "lmx_walk_merge_map")
    @: mf c.LmP0Node c.lm_compiler_merge_frame(stmt)
    @: bd c.LmP0Structure c.lm_compiler_merge_body(stmt)
    @: last c.LmP0Field
    c.L2FrontendScratchChar32: bnode_storage
    @: bnode char (cast: (@: char) bnode_storage\buffer)
    int: n c.lm_compiler_merge_arity(mf)
    int: np 0
    int: prim
    int: port_local_node
    int: k 0
    int: oi
    int: ni
    int: sl
    int: fi
    int: q 0
    int: contract
    int: inputs
    int: ci
    int: own mres_own_cell[0][res]
    int: excluded own_excl_cell[0]
    int: form
    int: span 0
    int: nt 0
    int: nrec 0
    int: ur
    int: uj
    int: uslot
    int: selfn 0
    int: uform
    int: uspan 0
    int: selected (cast: (int) (mres_code_k_cell[0][res] > 0))
    int: selected_base
    int: selected_pair
    c.L2FrontendScratchChar64: selected_map_storage
    @: selected_map char (cast: (@: char) selected_map_storage\buffer)
    @: ufirst c.LmP0Field
    if: n < 1
        return: (cast: (int) (c.lm_compiler_error(src_cell[0], stmt, "merge needs at least one operand")))
    # RR2d: a merge qualified by a chain walks through its own PRIM entry; the trailer's width is the result's leaf
    # count, the program's opaque type count and three sizes.
    if: qual != 0
        qx: 3 + c.lm_compiler_mqleaves_count(res) + c.lm_compiler_mqopaque_count()
        rec: "lmx_walk_merge_qualified_map"
    if: selected != 0 && qual = 0
        rec: "lmx_walk_merge_selected_map"
    if: selected != 0 && qual != 0
        rec: "lmx_walk_merge_selected_qualified_map"
    while: q < msrc_n_cell[0]
        if: msrc_res_cell[0][q] = res && msrc_pair_cell[0][q] != 0
            np: np + 1
        q: q + 1
    ---
    # §7b: merge copies graph state -- PRIM_PUB publishes after its operands, before it runs.
    # The pair count, the qualified-branch count, the use-cell count and the two boxed producer tokens precede the
    # operands; the qualified branch roots follow the pair cells, and their exact profiles are retained as the
    # operands' are, so the copied lexical chain keeps each independent: const: immutable branch itself (docs
    # #composition), as a callable merge's copy does (l2_t7_emit_lex_copy).  No input names a parent: the result's is
    # the copy's own (lmx_merge_profiles_owned; LMX_blog/2026-10-05.md#merge-parent), wherever the merge is reached.
    # All map cells remain inline in this existing instruction, not a helper graph.
    # READ-FIELD-CLOSURE: each operand's model, then the uses of the operands' copied code -- the native merge's own
    # records (l2_mu_collect) -- carried as T use cells after the qualified roots: nt = 3 * records + their slots.
