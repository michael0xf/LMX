# Slice 282: a callable place through a path takes what a named method reference takes: a Structure with no callable part is refused.
Other:
    int: q 3
end: Other
Holder:
    fn: f () int
        return: 1
    end: f
end: Holder
@: Holder\f Other
send: exit(exit_code: 7; stdout: ""; stderr: "")
return
