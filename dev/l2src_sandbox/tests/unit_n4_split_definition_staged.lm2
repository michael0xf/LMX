# N4: reaching the original T of S assigns that admitted Structure value to
# the T place of D. S keeps its source T; D observes the new value. Entry 7.
S:
    T:
        int: v 1
    end: T
end: S
D:
    T:
        int: v 2
    end: T
end: D
call: S D
int: r 81
if: D\T\v = 1 && S\T\v = 1
    r: 7
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
