# Reentry shares the declared graph; each activation keeps its working value.
# Outer x2 is not reloaded after inner publication9. The final outer write3
# publishes normally, so the observable result remains23.
fn: M (int: n) int
    int: x 1
    if: n = 0
        x: 9
        return: 0
    x: 2
    M(0)
    int: seen 0
    seen: x
    x: x + 1
    return: seen
end: M

fn: check () int
    return: M\x
end: check

int: v 0
v: M(1)
int: w 0
w: check()
sendMessage: exit(exit_code: v * 10 + w; stdout: ""; stderr: "")
return
