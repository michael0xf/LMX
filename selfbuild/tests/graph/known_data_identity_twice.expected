---
    Observed:
        int: bare1 1
        int: held1 3
        int: bare2 2
        int: held2 4
    end: Observed
---
fn: f () int (
    int: n 0
)
    :=: (data \ n) ((data \ n) + 1)
    return: (data \ n)
end: f
Hold:
    @: p f
    @: q f
end: Hold
int: bare1 0
int: held1 0
int: bare2 0
int: held2 0
:=: bare1 (f)
:=: held1 Hold\p()
:=: bare2 (f)
:=: held2 Hold\q()
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ bare1) bare1
    :=: ((shared \ Observed) \ held1) held1
    :=: ((shared \ Observed) \ bare2) bare2
    :=: ((shared \ Observed) \ held2) held2
end: main
main:
