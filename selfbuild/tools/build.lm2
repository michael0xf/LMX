    if: c.fputs("@: LmP0Text l2_payload_name_cache 0\nconst: @: LmP0Node l2_os_node 0\nint: l2_os_select 0\nint: l2_os_mask 0\n@@: char l2_snap_path 0\n@@: char l2_snap_data 0\n@: size_t l2_snap_len 0\n@@: LmP0Document l2_snap_doc 0\nint: l2_snap_n 0\nint: l2_snap_cap 0\nint: l2_snap_touch 0\nconst: @: LmP0Structure l2_cur_unit 0\n@@: LmP0Text l2_m_name 0\n@@: LmP0Text l2_m_f0 0\n@@: LmP0Text l2_m_f1 0\n@@: LmP0Node l2_m_node 0\n@@: LmP0Node l2_m_body 0\n@: unsigned l2_m_sig 0\n@: int l2_m_arity 0\n@: int l2_m_dyn 0\n@: int l2_m_ret 0\n@: int l2_m_value_used 0\n@: int l2_m_own 0\n@: int l2_m_uses 0\n@: int l2_m_alias 0\n@: int l2_m_pre 0\n@@: void l2_m_dn 0\n@@: int l2_m_dt 0\n@: int l2_m_hcap 0\n@: int l2_own_bseq 0\nint: l2_bseq_n 0\n@@: LmP0Text l2_own_name 0\n", f) < 0
        return: 1
    if: c.fputs("@@: LmP0Text l2_own_count 0\n@: int l2_own_ty 0\n@: int l2_own_mi 0\n@@: LmP0Node l2_own_host 0\n@@: LmP0Node l2_own_decl 0\n@: int l2_own_fid 0\n@: int l2_own_fchild 0\n@: int l2_own_uchild 0\nint: l2_profile_runtime 0\n@: int l2_m_sn 0\n@@: LmP0Text l2_sn 0\n@: int l2_st 0\n@@: void l2_m_fn 0\n@@: int l2_m_ft 0\n@: int l2_m_fcap 0\nint: l2_fail_left 0\nint: l2_alloc_err 0\nint: l2_alloc_n 0\nint: l2_free_n 0\nint: l2_alloc_live 0\nint: l2_alloc_fail_at 0\nint: l2_alloc_fail_kind 0\nint: l2_alloc_kind 0\n@@: char l2_ltx 0\n@: FILE l2_alloc_trace 0\nconst: @: char l2_room_tag 0\nint: l2_ltx_n 0\nint: l2_ltx_cap 0\n@: int l2_m_edge 0\n@: int l2_it_ar 0\n@: int l2_it_dyn 0\n@: int l2_it_ret 0\n", f) < 0
        return: 1
    if: c.fputs("@: int l2_it_throws 0\n@: int l2_it_tmi 0\n[]: int l2_lpk_own 64\n[]: int l2_lpp_own 64\n@: int l2_lpk 0\n@: int l2_lpp 0\nint: l2_lp_cap 0\nint: l2_lp_n 0\n[]: @(LmP0Structure) l2_padb_own 64\n[]: int l2_padi_own 64\n@@: LmP0Structure l2_padb 0\n@: int l2_padi 0\nint: l2_pad_cap 0\nint: l2_pad_n 0\nint: l2_pad_seq 0\n[]: @(LmP0Node) l2_rw_pcf_own 64\n[]: int l2_rw_pid_own 64\n@@: LmP0Node l2_rw_pcf 0\n@: int l2_rw_pid 0\nint: l2_rw_pcap 0\nint: l2_rw_pn 0\n@@: LmP0Text l2_tk_name 0\nint: l2_tk_cap 0\nint: l2_tk_n 0\n@@: char l2_it_n 0\n@@: size_t l2_it_nl 0\n@@: int l2_it_ty 0\n@@: char l2_it_hn 0\n@@: size_t l2_it_hnl 0\n@@: int l2_it_hty 0\n[]: char l2_tok_own 1024\n@: L2Tx l2_tok 0\n", f) < 0
