# The machine path of the frontend over the clean Lmx graph (route 331, step 2: Codex, CODEX-OPUS-331-ROUTE-REPLY;
# docs/kernel-implementation.ru.md, EN beside it, §1a, §7, §11 item 3; L2 section 20). The frontend reads the unit's
# clean graph instead of the P0 tree: the source is built by the common builder (src/l2src/l2_graph_build.lm2) in an
# arena of this translation, the traversal of its root opens the translation's own namespace (lmx_graph_space_open:
# each written `fn:` declaration creates its Structure there, with its args, return and body parts), and the machine
# module is written from that Structure and the statements of its body -- names resolved here, by the addresses of
# their spellings (§3.5), in tables of this translation only, released with it (§5.2). No P0 tree is read after the
# construction and no Lmx is turned back into one.
#
# The output is the frontend's own form of a machine module, as the P0 path writes it (lm_compiler_emit_machine_module):
# the mark, the preamble of the unit's C door declarations (`include: "<stddef.h>"`, its predefs, its includes), one
# prototype block of all its functions -- the module has no header of its own --, then each function with C parameters
# named l2_p<function>_<formal>_<name> and its own places named l2_q<place>_<name> (numbered through the module),
# declared at its entry and written where they are written: the var of a function is visible from its first line. A
# machine function has no unit and no graph (L2 section 20): its names are its formals, its own places, the functions
# of its module, the C door `c.X` and numbers; its formals, places and result are numbers or references.
#
# The forms translated are those the migrated modules are written with -- lmx_schedule (slice 338), lmx_clock (slice
# 340): written `fn:` declarations with a result (a C scalar word: int, char, size_t, unsigned, ulong, or a C door type
# `c.T`), formals `@: name T`, `T: name` and `int: name`; places `T: name [value]` (T a C scalar word) and `@: name T
# [value]`; the statements `if:` (with the `else:` that follows it), `return: value`, the write of a field through a
# path head (`owner\field: value`, §3.3, slice 337), the write of a formal or a place (`name: value`) and a call; the
# expressions: names, numbers, the operations = != < <= > >= + - * / % && ||, paths [owner, \, field] from a reference,
# `cast:` to a scalar or reference type, and calls of the C door (`c.f(...)`) and of the module's own functions (with
# as many actuals as formals). The actuals of a call and the operands of an operation are evaluated once each, in
# lexical order: a value read before a later call is kept first in a local of its type (the order of calls, below). Any
# other form is refused where it stands (`l2trans error: SOURCE: WHERE: WHY`): there is no fallback to the P0 path for a
# module the recipe translates from its graph. The parts given after the source (the language's units of every machine
# translation) are not read: no name of a machine function reaches them.
#
# A machine module of the frontend hosted by the runtime (tools/l2trans.lm2 dispatches to lm_compiler_graph_main when
# its first word is --graph): built by `lmxtool build-frontend-host` (bld_frontend_objects, tools/build.lm2) with its own
# header l2src/l2_frontend_graph.h.lm1, after the builder's module; it reads the graph through the kernel of the runtime
# the hosted frontend is linked with.
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_graph.h.lm1"
predef: "l2src/lmx_graph_run.h.lm1"
predef: "l2src/l2_graph_build.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>"
include: "<stdlib.h>"
include: "<string.h>"

# ---- Refusals: where and why, as the translator says them ------------------------------------------------------------

# A refusal of the unit: `l2trans error: SOURCE: WHY`. 1.
fn: lm_compiler_graph_refuse (const: (@: src char); const: (@: why char)) int
    c.fprintf(c.stderr, "l2trans error: %s: %s\n", src, why)
    return: 1
end: lm_compiler_graph_refuse

# A refusal at a field of the unit's root (counted from 1). 1.
fn: lm_compiler_graph_refuse_root (const: (@: src char); size_t: field; const: (@: why char)) int
    c.fprintf(c.stderr, "l2trans error: %s: root field %zu: %s\n", src, field + 1U, why)
    return: 1
end: lm_compiler_graph_refuse_root

# A refusal at a statement of a machine function (statements counted from 1 in written order, nested ones included). 1.
fn: lm_compiler_graph_refuse_at (const: (@: src char); @: fname char; int: at; const: (@: why char)) int
    c.fprintf(c.stderr, "l2trans error: %s: fn %s, statement %d: %s\n", src, fname, at, why)
    return: 1
end: lm_compiler_graph_refuse_at

# A refusal naming a word at a statement of a machine function. 1.
fn: lm_compiler_graph_refuse_word (const: (@: src char); @: fname char; int: at; @: word char; const: (@: why char)) int
    c.fprintf(c.stderr, "l2trans error: %s: fn %s, statement %d: %s %s\n", src, fname, at, word, why)
    return: 1
end: lm_compiler_graph_refuse_word

# ---- Spellings ---------------------------------------------------------------------------------------------------------

# The C spelling of a written type word: the door name `c.T` is T, any other word as written.
sub: lm_compiler_graph_type (@: f c.FILE; @: text char)
    if: text[0] = 99 && text[1] = 46 && text[2] != 0
        c.fputs(text + 2, f)
    else:
        c.fputs(text, f)
    ---
    return
end: lm_compiler_graph_type

# The C name of formal j of function mi: l2_p<mi>_<j>_<name>, as the P0 path names it.
sub: lm_compiler_graph_formal_cname (@: f c.FILE; int: mi; size_t: j; @: name char)
    c.fprintf(f, "l2_p%d_%zu_%s", mi, j, name)
    return
end: lm_compiler_graph_formal_cname

# The C name of the own place k of the module (numbered through its functions): l2_q<k>_<name>, as the P0 path names it.
sub: lm_compiler_graph_place_cname (@: f c.FILE; int: k; @: name char)
    c.fprintf(f, "l2_q%d_%s", k, name)
    return
end: lm_compiler_graph_place_cname

# Four spaces a level.
sub: lm_compiler_graph_indent (@: f c.FILE; int: level)
    int: k 0
    while: k < level
        c.fputs("    ", f)
        k: k + 1
    ---
    return
end: lm_compiler_graph_indent

# Is word, a canonical spelling, a C scalar a formal, a place or a result of a machine function may be written with (L2
# section 20: numbers and references)? int, char, size_t, unsigned and ulong, by the addresses of their spellings. 1 or 0.
fn: lm_compiler_graph_scalar (@: word char) int
    if: word = 0
        return: 0
    if: word = c.lmx_graph_intern("int", 3U) || word = c.lmx_graph_intern("char", 4U) || word = c.lmx_graph_intern("size_t", 6U)
        return: 1
    if: word = c.lmx_graph_intern("unsigned", 8U) || word = c.lmx_graph_intern("ulong", 5U)
        return: 1
    return: 0
end: lm_compiler_graph_scalar

# Is word a name of the C door, `c.X` with X not empty (its written form: the door is a word of the source)? 1 or 0.
fn: lm_compiler_graph_door_word (@: word char) int
    if: word = 0
        return: 0
    if: word[0] = 99 && word[1] = 46 && word[2] != 0
        return: 1
    return: 0
end: lm_compiler_graph_door_word

# Is word a type a formal or a result of a machine function is written with: a C scalar word or a type of the C door
# (`c.uint64_t`)? 1 or 0.
fn: lm_compiler_graph_number (@: word char) int
    if: lm_compiler_graph_scalar(word) != 0 || lm_compiler_graph_door_word(word) != 0
        return: 1
    return: 0
end: lm_compiler_graph_number

# Is the value an operator word of a binary operation a machine function computes (§3.3: [left, operator, right])? The
# comparisons, the arithmetic and the short logical operations. 1 or 0.
fn: lm_compiler_graph_operator (@: op char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    if: state = 0 || op = 0
        return: 0
    if: op = state\w_eq || op = state\w_ne || op = state\w_lt || op = state\w_le || op = state\w_gt || op = state\w_ge
        return: 1
    if: op = state\w_plus || op = state\w_minus || op = state\w_star || op = state\w_slash || op = state\w_percent
        return: 1
    if: op = state\w_and || op = state\w_or
        return: 1
    return: 0
end: lm_compiler_graph_operator

# ---- The signature: the Structure the traversal made from the declaration ----------------------------------------------

# The type of formal j of args as a C parameter or a local declaration begins with it: `@: T ` for a reference `@: name
# T`, `T: ` for a number `T: name` (T a C scalar word or a C door type), `int: ` for a place `int: name` without a
# value. 0, or 1 for a formal of another form (a default value, a Structure, a callable).
fn: lm_compiler_graph_formal_type (@: g c.LmxGraph; @: f c.FILE; @: args c.Lmx; size_t: j) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: value void c.lmx_graph_get(args, j)
    @: decl c.Lmx 0
    @: head char 0
    int: kind c.lmx_graph_kind(g, value)
    if: state = 0
        return: 1
    if: kind = 3
        c.fputs("int: ", f)
        return: 0
    if: kind != 4
        return: 1
    decl: (cast: (@: c.Lmx) value)
    head: c.lmx_graph_name_of(g, value)
    if: head = state\w_at && c.lmx_graph_count(decl) = 2U && c.lmx_graph_kind(g, c.lmx_graph_get(decl, 1U)) = 2
        c.fputs("@: ", f)
        lm_compiler_graph_type(f, c.lmx_graph_word_text(g, c.lmx_graph_get(decl, 1U)))
        c.fputs(" ", f)
        return: 0
    if: head != state\w_int && lm_compiler_graph_number(head) != 0 && c.lmx_graph_count(decl) = 1U
        lm_compiler_graph_type(f, head)
        c.fputs(": ", f)
        return: 0
    return: 1
end: lm_compiler_graph_formal_type

# Formal j of args in the signature: its type (lm_compiler_graph_formal_type) and its C name l2_p<mi>_<j>_<name>, the
# name the binder takes (lmx_graph_formal_name). 0, or 1 for a formal of another form.
fn: lm_compiler_graph_formal (@: g c.LmxGraph; @: f c.FILE; @: args c.Lmx; int: mi; size_t: j) int
    @: name char c.lmx_graph_formal_name(g, args, j)
    if: name = 0
        return: 1
    if: lm_compiler_graph_formal_type(g, f, args, j) != 0
        return: 1
    lm_compiler_graph_formal_cname(f, mi, j, name)
    return: 0
end: lm_compiler_graph_formal

# The signature of the machine function made (the Structure the traversal created, named name, function mi of the
# module): `fn: name (formals) T`. 0; 1 for a formal of another form; 2 for a result that is no C scalar or door type.
fn: lm_compiler_graph_sig (@: g c.LmxGraph; @: f c.FILE; @: made c.Lmx; @: name char; int: mi) int
    @: args c.Lmx c.lmx_graph_method_args(g, made)
    @: rtext char c.lmx_graph_word_text(g, c.lmx_graph_method_return(g, made))
    size_t: j 0U
    if: args = 0
        return: 1
    if: rtext = 0 || lm_compiler_graph_number(rtext) = 0
        return: 2
    c.fprintf(f, "fn: %s (", name)
    while: j < c.lmx_graph_count(args)
        if: j > 0U
            c.fputs("; ", f)
        if: lm_compiler_graph_formal(g, f, args, mi, j) != 0
            return: 1
        j: j + 1U
    ---
    c.fputs(") ", f)
    lm_compiler_graph_type(f, rtext)
    return: 0
end: lm_compiler_graph_sig

# ---- The own places of a function --------------------------------------------------------------------------------------

# The index of the own place named word (a canonical spelling, compared by address) among names[0..n), or n.
fn: lm_compiler_graph_place_at (@@: names char; size_t: n; @: word char) size_t
    size_t: i 0U
    while: i < n
        if: names[i] = word
            return: i
        i: i + 1U
    ---
    return: n
end: lm_compiler_graph_place_at

# Is the field i of block a declaration of an own place, and of which form? 1 an int place without a value (`int:
# name`), 2 an int place holding a literal (`int: name 5`), 3 a place `T: name [value]` (T a C scalar word, int with a
# computed value included), 4 a reference `@: name T [value]`, 5 a place of a C door type (`c.T: name`, not translated
# yet), 0 none. Its name in name_out[0], its type word in type_out[0] (the type T of a reference).
fn: lm_compiler_graph_declaration (@: g c.LmxGraph; @: block c.Lmx; size_t: i; @@: name_out char; @@: type_out char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: value void c.lmx_graph_get(block, i)
    @: decl c.Lmx 0
    @: head char 0
    int: kind c.lmx_graph_kind(g, value)
    size_t: n 0U
    name_out[0]: 0
    type_out[0]: 0
    if: state = 0
        return: 0
    if: kind = 3 || (kind = 1 && c.lmx_graph_slot_name(g, block, i) != 0)
        name_out[0]: c.lmx_graph_slot_name(g, block, i)
        type_out[0]: (cast: (@: char) state\w_int)
        if: kind = 3
            return: 1
        return: 2
    if: kind != 4
        return: 0
    decl: (cast: (@: c.Lmx) value)
    head: c.lmx_graph_name_of(g, value)
    n: c.lmx_graph_count(decl)
    if: head = 0 || n = 0U || c.lmx_graph_kind(g, c.lmx_graph_get(decl, 0U)) != 2
        return: 0
    if: head = state\w_at && (n = 2U || n = 3U) && c.lmx_graph_kind(g, c.lmx_graph_get(decl, 1U)) = 2
        name_out[0]: c.lmx_graph_word_text(g, c.lmx_graph_get(decl, 0U))
        type_out[0]: c.lmx_graph_word_text(g, c.lmx_graph_get(decl, 1U))
        return: 4
    if: lm_compiler_graph_scalar(head) != 0 && n <= 2U
        name_out[0]: c.lmx_graph_word_text(g, c.lmx_graph_get(decl, 0U))
        type_out[0]: head
        return: 3
    if: lm_compiler_graph_door_word(head) != 0 && n <= 2U
        name_out[0]: c.lmx_graph_word_text(g, c.lmx_graph_get(decl, 0U))
        type_out[0]: head
        return: 5
    return: 0
end: lm_compiler_graph_declaration

# How many statements block and the bodies of its if and else hold: the room of the own places of a function.
fn: lm_compiler_graph_count_tree (@: g c.LmxGraph; @: block c.Lmx) size_t
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: value void 0
    @: head char 0
    size_t: n c.lmx_graph_count(block)
    size_t: total c.lmx_graph_count(block)
    size_t: i 0U
    while: i < n
        value: c.lmx_graph_get(block, i)
        head: c.lmx_graph_name_of(g, value)
        if: c.lmx_graph_kind(g, value) = 4 && head = state\w_if && c.lmx_graph_count((cast: (@: c.Lmx) value)) = 2U && c.lmx_graph_kind(g, c.lmx_graph_get((cast: (@: c.Lmx) value), 1U)) = 4
            total: total + lm_compiler_graph_count_tree(g, (cast: (@: c.Lmx) c.lmx_graph_get((cast: (@: c.Lmx) value), 1U)))
        ---
        if: c.lmx_graph_kind(g, value) = 4 && head = state\w_else
            total: total + lm_compiler_graph_count_tree(g, (cast: (@: c.Lmx) value))
        ---
        i: i + 1U
    ---
    return: total
end: lm_compiler_graph_count_tree

# The own places of a function declared in block and the bodies of its if and else, in written order: names[count..],
# their type words, ptr 1 for a reference. A name that is a formal or a place already is refused, so is a place of a C
# door type. 0, or the refusal.
fn: lm_compiler_graph_collect (@: g c.LmxGraph; @: args c.Lmx; @: block c.Lmx; @@: names char; @@: types char; @: ptr int; @: count size_t; const: (@: src char); @: fname char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: value void 0
    @: head char 0
    @: name char 0
    @: type char 0
    size_t: n c.lmx_graph_count(block)
    size_t: i 0U
    int: form 0
    int: status 0
    while: i < n && status = 0
        value: c.lmx_graph_get(block, i)
        form: lm_compiler_graph_declaration(g, block, i, @ name, @ type)
        if: form = 5
            c.fprintf(c.stderr, "l2trans error: %s: fn %s: the place %s of the C door type %s: the graph path does not know yet whether it is a number\n", src, fname, name, type)
            return: 1
        ---
        if: form != 0
            if: name = 0 || c.lmx_graph_formal(g, args, name) < c.lmx_graph_count(args) || lm_compiler_graph_place_at(names, count[0], name) < count[0]
                c.fprintf(c.stderr, "l2trans error: %s: fn %s: the name %s is declared twice\n", src, fname, name)
                return: 1
            ---
            names[count[0]]: name
            types[count[0]]: type
            ptr[count[0]]: (cast: (int) (form = 4))
            count[0]: count[0] + 1U
        ---
        head: c.lmx_graph_name_of(g, value)
        if: c.lmx_graph_kind(g, value) = 4 && head = state\w_if && c.lmx_graph_count((cast: (@: c.Lmx) value)) = 2U && c.lmx_graph_kind(g, c.lmx_graph_get((cast: (@: c.Lmx) value), 1U)) = 4
            status: lm_compiler_graph_collect(g, args, (cast: (@: c.Lmx) c.lmx_graph_get((cast: (@: c.Lmx) value), 1U)), names, types, ptr, count, src, fname)
        ---
        if: status = 0 && c.lmx_graph_kind(g, value) = 4 && head = state\w_else
            status: lm_compiler_graph_collect(g, args, (cast: (@: c.Lmx) value), names, types, ptr, count, src, fname)
        ---
        i: i + 1U
    ---
    return: status
end: lm_compiler_graph_collect

# ---- The order of calls: values kept before a later call ---------------------------------------------------------------
#
# The language evaluates the actuals of a call once each, in lexical order (L2 spec: "L2 arguments are evaluated once
# in the ordinary lexical order"), and so the operands of an operation; C leaves both orders open (only && and || order
# their operands). A value read before a later call of the same call or operation is therefore kept first in a local
# of its own -- `T: l2_t<k> (value)` before the statement, k numbered through the function -- when the order could show:
# neither value is stable and one of them runs a call. A stable value has no call in it and reads no field through a
# path: numbers, door names, the function's formals and places (the graph path writes no address of them, so no call
# changes them) and the operations and casts of those. The local of an actual of a function of the module has the
# type of the callee's formal (C converts the actual to it at the call either way); any other kept value has its own
# type, which the graph path knows for a formal or a place, a cast, a call of a function of the module, a comparison
# or a short logical operation (int) and an arithmetic one led by one of those (as the P0 path types a value by its
# leading name). A call of the C door and a field read through a path have no C type in the graph: kept, they are
# refused, as the P0 path refuses such an actual of a C call.

# Does the expression run a call -- of the C door or of the module -- anywhere in it (an actual, an operand, the value
# of a cast, the owner of a path, a field in parentheses)? 1 or 0.
fn: lm_compiler_graph_calls (@: g c.LmxGraph; @: value void) int
    @: expression c.Lmx 0
    @: head char 0
    size_t: j 0U
    if: c.lmx_graph_kind(g, value) != 4
        return: 0
    expression: (cast: (@: c.Lmx) value)
    head: c.lmx_graph_name_of(g, value)
    if: head = c.lmx_graph_intern("cast", 4U)
        if: c.lmx_graph_count(expression) = 2U
            return: lm_compiler_graph_calls(g, c.lmx_graph_get(expression, 1U))
        return: 0
    if: head != 0
        return: 1
    while: j < c.lmx_graph_count(expression)
        if: lm_compiler_graph_calls(g, c.lmx_graph_get(expression, j)) != 0
            return: 1
        j: j + 1U
    ---
    return: 0
end: lm_compiler_graph_calls

# Does the expression read a field through a path [owner, \, field] -- a place a call may change -- anywhere in it? 1
# or 0.
fn: lm_compiler_graph_reads (@: g c.LmxGraph; @: value void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: expression c.Lmx 0
    @: head char 0
    size_t: j 0U
    if: state = 0 || c.lmx_graph_kind(g, value) != 4
        return: 0
    expression: (cast: (@: c.Lmx) value)
    head: c.lmx_graph_name_of(g, value)
    if: head = c.lmx_graph_intern("cast", 4U)
        if: c.lmx_graph_count(expression) = 2U
            return: lm_compiler_graph_reads(g, c.lmx_graph_get(expression, 1U))
        return: 0
    if: head = 0 && c.lmx_graph_count(expression) = 3U && c.lmx_graph_kind(g, c.lmx_graph_get(expression, 1U)) = 2
        if: c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 1U)) = state\w_deref
            return: 1
        ---
    while: j < c.lmx_graph_count(expression)
        if: lm_compiler_graph_reads(g, c.lmx_graph_get(expression, j)) != 0
            return: 1
        j: j + 1U
    ---
    return: 0
end: lm_compiler_graph_reads

# Must the value a, written before b in one call or operation, be kept before the statement so that it is evaluated
# first: neither is stable (each runs a call or reads a field through a path) and one of them runs a call? 1 or 0.
fn: lm_compiler_graph_before (@: g c.LmxGraph; @: a void; @: b void) int
    if: lm_compiler_graph_calls(g, a) = 0 && lm_compiler_graph_reads(g, a) = 0
        return: 0
    if: lm_compiler_graph_calls(g, b) = 0 && lm_compiler_graph_reads(g, b) = 0
        return: 0
    if: lm_compiler_graph_calls(g, a) != 0 || lm_compiler_graph_calls(g, b) != 0
        return: 1
    return: 0
end: lm_compiler_graph_before

# How many Lmx the value holds, itself included, down through its fields: the room of the values a function keeps.
fn: lm_compiler_graph_count_nodes (@: g c.LmxGraph; @: value void) size_t
    size_t: total 1U
    size_t: j 0U
    if: c.lmx_graph_kind(g, value) != 4
        return: 0U
    while: j < c.lmx_graph_count((cast: (@: c.Lmx) value))
        total: total + lm_compiler_graph_count_nodes(g, c.lmx_graph_get((cast: (@: c.Lmx) value), j))
        j: j + 1U
    ---
    return: total
end: lm_compiler_graph_count_nodes

# The own type of a kept value, as a local declaration begins with it (`T: ` or `@: T `): a formal's or a place's, a
# cast's, the result of a function of the module, int for a comparison or a short logical operation, the left
# operand's for an arithmetic one. 0, or 1 when the graph path knows no C type of it (a call of the C door, a field read
# through a path, a number leading an operation, a door name); nothing is written then.
fn: lm_compiler_graph_own_type (@: g c.LmxGraph; @: f c.FILE; @: root c.Lmx; @: args c.Lmx; @@: names char; @@: types char; @: ptr int; size_t: n; @: value void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: expression c.Lmx 0
    @: typed c.Lmx 0
    @: kind_type void 0
    @: made c.Lmx 0
    @: head char 0
    @: text char 0
    @: op char 0
    size_t: j 0U
    int: kind c.lmx_graph_kind(g, value)
    if: state = 0
        return: 1
    if: kind = 2
        text: c.lmx_graph_word_text(g, value)
        j: c.lmx_graph_formal(g, args, text)
        if: j < c.lmx_graph_count(args)
            return: lm_compiler_graph_formal_type(g, f, args, j)
        j: lm_compiler_graph_place_at(names, n, text)
        if: j >= n
            return: 1
        if: ptr[j] != 0
            c.fputs("@: ", f)
            lm_compiler_graph_type(f, types[j])
            c.fputs(" ", f)
        else:
            lm_compiler_graph_type(f, types[j])
            c.fputs(": ", f)
        ---
        return: 0
    if: kind != 4
        return: 1
    expression: (cast: (@: c.Lmx) value)
    head: c.lmx_graph_name_of(g, value)
    if: head = c.lmx_graph_intern("cast", 4U)
        if: c.lmx_graph_count(expression) != 2U || c.lmx_graph_kind(g, c.lmx_graph_get(expression, 0U)) != 4
            return: 1
        typed: (cast: (@: c.Lmx) c.lmx_graph_get(expression, 0U))
        if: c.lmx_graph_count(typed) != 1U
            return: 1
        kind_type: c.lmx_graph_get(typed, 0U)
        if: c.lmx_graph_kind(g, kind_type) = 2 && lm_compiler_graph_number(c.lmx_graph_word_text(g, kind_type)) != 0
            lm_compiler_graph_type(f, c.lmx_graph_word_text(g, kind_type))
            c.fputs(": ", f)
            return: 0
        if: c.lmx_graph_kind(g, kind_type) != 4 || c.lmx_graph_name_of(g, kind_type) != state\w_at || c.lmx_graph_count((cast: (@: c.Lmx) kind_type)) != 1U
            return: 1
        if: c.lmx_graph_kind(g, c.lmx_graph_get((cast: (@: c.Lmx) kind_type), 0U)) != 2
            return: 1
        c.fputs("@: ", f)
        lm_compiler_graph_type(f, c.lmx_graph_word_text(g, c.lmx_graph_get((cast: (@: c.Lmx) kind_type), 0U)))
        c.fputs(" ", f)
        return: 0
    if: head != 0
        if: lm_compiler_graph_callee(g, root, value) != 2
            return: 1
        made: (cast: (@: c.Lmx) c.lmx_graph_space_find(root, head))
        lm_compiler_graph_type(f, c.lmx_graph_word_text(g, c.lmx_graph_method_return(g, made)))
        c.fputs(": ", f)
        return: 0
    if: c.lmx_graph_count(expression) = 1U
        return: lm_compiler_graph_own_type(g, f, root, args, names, types, ptr, n, c.lmx_graph_get(expression, 0U))
    if: c.lmx_graph_count(expression) != 3U || c.lmx_graph_kind(g, c.lmx_graph_get(expression, 1U)) != 2
        return: 1
    op: c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 1U))
    if: op = state\w_eq || op = state\w_ne || op = state\w_lt || op = state\w_le || op = state\w_gt || op = state\w_ge || op = state\w_and || op = state\w_or
        c.fputs("int: ", f)
        return: 0
    if: op = state\w_plus || op = state\w_minus || op = state\w_star || op = state\w_slash || op = state\w_percent
        return: lm_compiler_graph_own_type(g, f, root, args, names, types, ptr, n, c.lmx_graph_get(expression, 0U))
    return: 1
end: lm_compiler_graph_own_type

# Keep value in the next local of the function at level -- `T: l2_t<k> (value)`, k = kn[0], kept[k] = value --, T the
# type of formal j of cargs (an actual of a function of the module) or, cargs 0, the value's own. A value inside the
# right operand of && or || (cond 1) runs only when the left lets it, and is not kept before the statement. 0, or the
# refusal.
fn: lm_compiler_graph_hold (@: g c.LmxGraph; @: f c.FILE; @: root c.Lmx; @: args c.Lmx; int: mi; @@: names char; @@: types char; @: ptr int; size_t: n; int: k0; @@: kept c.Lmx; @: kn size_t; @: value void; @: cargs c.Lmx; size_t: j; int: level; int: cond; const: (@: src char); @: fname char; int: at) int
    int: status 0
    if: cond != 0
        return: lm_compiler_graph_refuse_at(src, fname, at, "a value in the right operand of && or || would be kept before the statement, before its left operand decides whether it runs: the graph path keeps no value there yet")
    lm_compiler_graph_indent(f, level)
    if: cargs != 0
        status: lm_compiler_graph_formal_type(g, f, cargs, j)
    else:
        status: lm_compiler_graph_own_type(g, f, root, args, names, types, ptr, n, value)
    ---
    if: status != 0
        return: lm_compiler_graph_refuse_at(src, fname, at, "a value evaluated before a later call is kept in a local of its C type, and this one -- a call of the C door, a field read through a path, an operation led by a number -- has none the graph path knows (as the P0 path refuses such an actual of a C call)")
    c.fprintf(f, "l2_t%zu (", kn[0])
    status: lm_compiler_graph_expr(g, f, root, args, mi, names, ptr, n, k0, kept, kn[0], value, 1, src, fname, at)
    c.fputs(")\n", f)
    kept[kn[0]]: (cast: (@: c.Lmx) value)
    kn[0]: kn[0] + 1U
    return: status
end: lm_compiler_graph_hold

# The values of the expression value kept before its statement, at level, in lexical order: in a call of the C door or
# of the module, an actual that must be evaluated before a later one (lm_compiler_graph_before); in an operation, its
# left operand so; inside each actual or operand first, the values it keeps itself. The right operand of && or || is
# read with cond 1. 0, or the refusal.
fn: lm_compiler_graph_keep (@: g c.LmxGraph; @: f c.FILE; @: root c.Lmx; @: args c.Lmx; int: mi; @@: names char; @@: types char; @: ptr int; size_t: n; int: k0; @@: kept c.Lmx; @: kn size_t; @: value void; int: level; int: cond; const: (@: src char); @: fname char; int: at) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: expression c.Lmx 0
    @: head char 0
    @: op char 0
    @: cargs c.Lmx 0
    size_t: count 0U
    size_t: i 0U
    size_t: j 0U
    int: callee 0
    int: before 0
    int: status 0
    if: state = 0
        return: 1
    if: c.lmx_graph_kind(g, value) != 4
        return: 0
    expression: (cast: (@: c.Lmx) value)
    head: c.lmx_graph_name_of(g, value)
    count: c.lmx_graph_count(expression)
    if: head = c.lmx_graph_intern("cast", 4U)
        if: count != 2U
            return: 0
        return: lm_compiler_graph_keep(g, f, root, args, mi, names, types, ptr, n, k0, kept, kn, c.lmx_graph_get(expression, 1U), level, cond, src, fname, at)
    if: head != 0
        callee: lm_compiler_graph_callee(g, root, value)
        if: callee != 1 && callee != 2
            return: 0
        if: callee = 2
            cargs: c.lmx_graph_method_args(g, (cast: (@: c.Lmx) c.lmx_graph_space_find(root, head)))
        while: i < count
            status: lm_compiler_graph_keep(g, f, root, args, mi, names, types, ptr, n, k0, kept, kn, c.lmx_graph_get(expression, i), level, cond, src, fname, at)
            if: status != 0
                return: status
            before: 0
            j: i + 1U
            while: j < count && before = 0
                before: lm_compiler_graph_before(g, c.lmx_graph_get(expression, i), c.lmx_graph_get(expression, j))
                j: j + 1U
            ---
            if: before != 0
                status: lm_compiler_graph_hold(g, f, root, args, mi, names, types, ptr, n, k0, kept, kn, c.lmx_graph_get(expression, i), cargs, i, level, cond, src, fname, at)
                if: status != 0
                    return: status
                ---
            i: i + 1U
        ---
        return: 0
    if: count = 1U
        return: lm_compiler_graph_keep(g, f, root, args, mi, names, types, ptr, n, k0, kept, kn, c.lmx_graph_get(expression, 0U), level, cond, src, fname, at)
    if: count != 3U || c.lmx_graph_kind(g, c.lmx_graph_get(expression, 1U)) != 2
        return: 0
    op: c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 1U))
    status: lm_compiler_graph_keep(g, f, root, args, mi, names, types, ptr, n, k0, kept, kn, c.lmx_graph_get(expression, 0U), level, cond, src, fname, at)
    if: status != 0 || op = state\w_deref
        return: status
    if: op = state\w_and || op = state\w_or
        return: lm_compiler_graph_keep(g, f, root, args, mi, names, types, ptr, n, k0, kept, kn, c.lmx_graph_get(expression, 2U), level, 1, src, fname, at)
    if: lm_compiler_graph_before(g, c.lmx_graph_get(expression, 0U), c.lmx_graph_get(expression, 2U)) != 0
        status: lm_compiler_graph_hold(g, f, root, args, mi, names, types, ptr, n, k0, kept, kn, c.lmx_graph_get(expression, 0U), 0, 0U, level, cond, src, fname, at)
        if: status != 0
            return: status
        ---
    return: lm_compiler_graph_keep(g, f, root, args, mi, names, types, ptr, n, k0, kept, kn, c.lmx_graph_get(expression, 2U), level, cond, src, fname, at)
end: lm_compiler_graph_keep

# ---- The body: statements and expressions of the graph ------------------------------------------------------------------

# The C name of the formal or own place named word, written to f: 1 when word names one, else 0.
fn: lm_compiler_graph_name (@: g c.LmxGraph; @: f c.FILE; @: args c.Lmx; int: mi; @@: names char; size_t: n; int: k0; @: word char) int
    size_t: j c.lmx_graph_formal(g, args, word)
    if: j < c.lmx_graph_count(args)
        lm_compiler_graph_formal_cname(f, mi, j, word)
        return: 1
    j: lm_compiler_graph_place_at(names, n, word)
    if: j < n
        lm_compiler_graph_place_cname(f, k0 + (cast: (int) j), word)
        return: 1
    return: 0
end: lm_compiler_graph_name

# Is word a reference -- a formal `@: name T` or an own place `@: name T` -- the start of a path? 1 or 0.
fn: lm_compiler_graph_reference (@: g c.LmxGraph; @: args c.Lmx; @@: names char; @: ptr int; size_t: n; @: word char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    size_t: j c.lmx_graph_formal(g, args, word)
    if: state = 0
        return: 0
    if: j < c.lmx_graph_count(args)
        if: c.lmx_graph_kind(g, c.lmx_graph_get(args, j)) = 4 && c.lmx_graph_name_of(g, c.lmx_graph_get(args, j)) = state\w_at
            return: 1
        return: 0
    j: lm_compiler_graph_place_at(names, n, word)
    if: j < n && ptr[j] != 0
        return: 1
    return: 0
end: lm_compiler_graph_reference

# The callable a Frame of a machine function applies, by its head: 1 a function of the C door (`c.f`), 2 a function of
# the module (the Structure the traversal made in the root's namespace, with as many formals as the Frame has actuals),
# 3 a function of the module given other actuals, 0 none.
fn: lm_compiler_graph_callee (@: g c.LmxGraph; @: root c.Lmx; @: value void) int
    @: head char c.lmx_graph_name_of(g, value)
    @: made c.Lmx 0
    if: head = 0 || c.lmx_graph_kind(g, value) != 4
        return: 0
    if: lm_compiler_graph_door_word(head) != 0
        return: 1
    made: (cast: (@: c.Lmx) c.lmx_graph_space_find(root, head))
    if: made = 0 || c.lmx_graph_method(g, made) = 0
        return: 0
    if: c.lmx_graph_count(c.lmx_graph_method_args(g, made)) != c.lmx_graph_count((cast: (@: c.Lmx) value))
        return: 3
    return: 2
end: lm_compiler_graph_callee

# The L1 of an expression of a machine function, read from the graph (§3.3) of function mi with formals args and own
# places names[0..n) (the first numbered k0): a formal or a place by its C name -- resolved here, by the address of its
# spelling --, a door name `c.X` and a number written with a suffix (a word such as `0U`) as written, an int primitive
# by its value, an operation [left, operator, right] in parentheses unless it is the whole expression, a path [owner,
# \, field] as owner\field (the owner a reference or a path), `cast:` to a type, a call of the C door or of a function
# of the module; a value kept before the statement, kept[0..kn), by its local l2_t<k>. 0, or the refusal (at: the
# statement).
fn: lm_compiler_graph_expr (@: g c.LmxGraph; @: f c.FILE; @: root c.Lmx; @: args c.Lmx; int: mi; @@: names char; @: ptr int; size_t: n; int: k0; @@: kept c.Lmx; size_t: kn; @: value void; int: whole; const: (@: src char); @: fname char; int: at) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: text char 0
    @: op char 0
    @: owner void 0
    @: head char 0
    @: kind_type void 0
    @: expression c.Lmx 0
    @: typed c.Lmx 0
    size_t: j 0U
    int: kind c.lmx_graph_kind(g, value)
    int: number 0
    int: status 0
    if: state = 0
        return: 1
    # A value kept before the statement (lm_compiler_graph_keep) is read from its local.
    while: kind = 4 && j < kn
        if: kept[j] = (cast: (@: c.Lmx) value)
            c.fprintf(f, "l2_t%zu", j)
            return: 0
        j: j + 1U
    ---
    j: 0U
    if: kind = 1
        if: c.lmx_graph_value_int(g, value, @ number) != 0
            return: lm_compiler_graph_refuse_at(src, fname, at, "an int of the expression has no value")
        c.fprintf(f, "%d", number)
        return: 0
    if: kind = 2
        text: c.lmx_graph_word_text(g, value)
        if: text = 0
            return: lm_compiler_graph_refuse_at(src, fname, at, "a word of the expression has no spelling")
        if: lm_compiler_graph_name(g, f, args, mi, names, n, k0, text) != 0
            return: 0
        if: lm_compiler_graph_door_word(text) != 0 || (text[0] >= 48 && text[0] <= 57)
            c.fputs(text, f)
            return: 0
        return: lm_compiler_graph_refuse_word(src, fname, at, text, "is no formal or place of the machine function, no door name c.X and no number: a machine function has no unit")
    if: kind != 4
        return: lm_compiler_graph_refuse_at(src, fname, at, "the graph path of a machine function translates names, numbers, operations, paths, casts and calls: no other expression yet")
    expression: (cast: (@: c.Lmx) value)
    head: c.lmx_graph_name_of(g, value)
    if: head != 0
        # `cast: (T) value`: the type Structure holds a word (a C scalar or door type) or a reference `@: T`.
        if: head = c.lmx_graph_intern("cast", 4U) && c.lmx_graph_count(expression) = 2U && c.lmx_graph_kind(g, c.lmx_graph_get(expression, 0U)) = 4
            typed: (cast: (@: c.Lmx) c.lmx_graph_get(expression, 0U))
            if: c.lmx_graph_name_of(g, (cast: (@: void) typed)) != 0 || c.lmx_graph_count(typed) != 1U
                return: lm_compiler_graph_refuse_at(src, fname, at, "a cast of a machine function names one type")
            kind_type: c.lmx_graph_get(typed, 0U)
            c.fputs("(cast: (", f)
            if: c.lmx_graph_kind(g, kind_type) = 2 && lm_compiler_graph_number(c.lmx_graph_word_text(g, kind_type)) != 0
                lm_compiler_graph_type(f, c.lmx_graph_word_text(g, kind_type))
            else:
                if: c.lmx_graph_kind(g, kind_type) != 4 || c.lmx_graph_name_of(g, kind_type) != state\w_at || c.lmx_graph_count((cast: (@: c.Lmx) kind_type)) != 1U || c.lmx_graph_kind(g, c.lmx_graph_get((cast: (@: c.Lmx) kind_type), 0U)) != 2
                    return: lm_compiler_graph_refuse_at(src, fname, at, "a cast of a machine function is to a C scalar or door type or to a reference `@: T`")
                c.fputs("@: ", f)
                lm_compiler_graph_type(f, c.lmx_graph_word_text(g, c.lmx_graph_get((cast: (@: c.Lmx) kind_type), 0U)))
            ---
            c.fputs(") ", f)
            status: lm_compiler_graph_expr(g, f, root, args, mi, names, ptr, n, k0, kept, kn, c.lmx_graph_get(expression, 1U), 0, src, fname, at)
            c.fputs(")", f)
            return: status
        ---
        status: lm_compiler_graph_callee(g, root, value)
        if: status = 3
            return: lm_compiler_graph_refuse_word(src, fname, at, head, "is called with another number of actuals than its formals")
        if: status = 0
            return: lm_compiler_graph_refuse_word(src, fname, at, head, "is no function of the module and no function of the C door: the graph path of a machine function calls no other")
        c.fputs(head, f)
        c.fputs("(", f)
        j: 0U
        status: 0
        while: j < c.lmx_graph_count(expression) && status = 0
            if: j > 0U
                c.fputs(", ", f)
            status: lm_compiler_graph_expr(g, f, root, args, mi, names, ptr, n, k0, kept, kn, c.lmx_graph_get(expression, j), 0, src, fname, at)
            j: j + 1U
        ---
        c.fputs(")", f)
        return: status
    ---
    # An expression written in parentheses is the unnamed Lmx of its one field, read as that field (as the kernel
    # evaluates an operand, lmx_graph_eval_value).
    if: c.lmx_graph_count(expression) = 1U
        return: lm_compiler_graph_expr(g, f, root, args, mi, names, ptr, n, k0, kept, kn, c.lmx_graph_get(expression, 0U), whole, src, fname, at)
    if: c.lmx_graph_count(expression) != 3U || c.lmx_graph_kind(g, c.lmx_graph_get(expression, 1U)) != 2
        return: lm_compiler_graph_refuse_at(src, fname, at, "the graph path of a machine function translates binary operations and paths: no other operation yet")
    op: c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 1U))
    if: op = state\w_deref
        owner: c.lmx_graph_get(expression, 0U)
        if: c.lmx_graph_kind(g, c.lmx_graph_get(expression, 2U)) != 2
            return: lm_compiler_graph_refuse_at(src, fname, at, "a path of a machine function names a field by a word")
        if: c.lmx_graph_kind(g, owner) = 2
            if: lm_compiler_graph_reference(g, args, names, ptr, n, c.lmx_graph_word_text(g, owner)) = 0
                return: lm_compiler_graph_refuse_at(src, fname, at, "a path of a machine function starts at a reference `@: name T`, a formal or a place")
            ---
        status: lm_compiler_graph_expr(g, f, root, args, mi, names, ptr, n, k0, kept, kn, owner, 0, src, fname, at)
        if: status != 0
            return: status
        c.fputc(92, f)
        c.fputs(c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 2U)), f)
        return: 0
    if: lm_compiler_graph_operator(op) = 0
        return: lm_compiler_graph_refuse_at(src, fname, at, "the graph path of a machine function translates = != < <= > >= + - * / % && || and paths: no other operator yet")
    if: whole = 0
        c.fputs("(", f)
    status: lm_compiler_graph_expr(g, f, root, args, mi, names, ptr, n, k0, kept, kn, c.lmx_graph_get(expression, 0U), 0, src, fname, at)
    if: status != 0
        return: status
    c.fprintf(f, " %s ", op)
    status: lm_compiler_graph_expr(g, f, root, args, mi, names, ptr, n, k0, kept, kn, c.lmx_graph_get(expression, 2U), 0, src, fname, at)
    if: status != 0
        return: status
    if: whole = 0
        c.fputs(")", f)
    return: 0
end: lm_compiler_graph_expr

# The statements of block -- the body of a machine function, of an if or of an else --, each at level (four spaces a
# level): `if: condition` with its body and the `else:` that follows it, each body closed by its tail cutter `---`;
# `return: value`; the write of a field through a path head, `owner\field: value` (the unnamed Lmx [path, value],
# lmx_graph_path_head); a declaration of an own place -- declared at the function's entry, written here when it is
# written with a value --; the write of a formal or a place, `name: value`; a call. at counts the statements read. 0,
# or the refusal.
fn: lm_compiler_graph_block (@: g c.LmxGraph; @: f c.FILE; @: root c.Lmx; @: args c.Lmx; int: mi; @@: names char; @@: types char; @: ptr int; size_t: n; int: k0; @@: kept c.Lmx; @: kn size_t; @: block c.Lmx; int: level; const: (@: src char); @: fname char; @: at int) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void 0
    @: statement c.Lmx 0
    @: head char 0
    @: path void 0
    @: next void 0
    @: name char 0
    @: type char 0
    size_t: count c.lmx_graph_count(block)
    size_t: i 0U
    size_t: k 0U
    int: form 0
    int: number 0
    int: status 0
    if: state = 0
        return: 1
    while: i < count && status = 0
        raw: c.lmx_graph_get(block, i)
        at[0]: at[0] + 1
        form: lm_compiler_graph_declaration(g, block, i, @ name, @ type)
        if: form = 1
            i: i + 1U
            continue
        if: form = 2
            k: lm_compiler_graph_place_at(names, n, name)
            if: c.lmx_graph_value_int(g, raw, @ number) != 0
                return: lm_compiler_graph_refuse_at(src, fname, at[0], "an int place has no value")
            lm_compiler_graph_indent(f, level)
            lm_compiler_graph_place_cname(f, k0 + (cast: (int) k), name)
            c.fprintf(f, ": %d\n", number)
            i: i + 1U
            continue
        if: form = 3 || form = 4
            statement: (cast: (@: c.Lmx) raw)
            k: lm_compiler_graph_place_at(names, n, name)
            if: (form = 3 && c.lmx_graph_count(statement) = 2U) || (form = 4 && c.lmx_graph_count(statement) = 3U)
                status: lm_compiler_graph_keep(g, f, root, args, mi, names, types, ptr, n, k0, kept, kn, c.lmx_graph_get(statement, c.lmx_graph_count(statement) - 1U), level, 0, src, fname, at[0])
                if: status != 0
                    return: status
                lm_compiler_graph_indent(f, level)
                lm_compiler_graph_place_cname(f, k0 + (cast: (int) k), name)
                c.fputs(": ", f)
                status: lm_compiler_graph_expr(g, f, root, args, mi, names, ptr, n, k0, kept, kn[0], c.lmx_graph_get(statement, c.lmx_graph_count(statement) - 1U), 1, src, fname, at[0])
                c.fputs("\n", f)
            ---
            i: i + 1U
            continue
        if: c.lmx_graph_kind(g, raw) != 4
            return: lm_compiler_graph_refuse_at(src, fname, at[0], "the graph path of a machine function translates if, else, return, declarations, writes and calls: no other statement yet")
        statement: (cast: (@: c.Lmx) raw)
        head: c.lmx_graph_name_of(g, raw)
        path: 0
        if: head = 0
            path: c.lmx_graph_path_head(g, raw)
        if: head = state\w_return && c.lmx_graph_count(statement) = 1U
            status: lm_compiler_graph_keep(g, f, root, args, mi, names, types, ptr, n, k0, kept, kn, c.lmx_graph_get(statement, 0U), level, 0, src, fname, at[0])
            if: status != 0
                return: status
            lm_compiler_graph_indent(f, level)
            c.fputs("return: ", f)
            status: lm_compiler_graph_expr(g, f, root, args, mi, names, ptr, n, k0, kept, kn[0], c.lmx_graph_get(statement, 0U), 1, src, fname, at[0])
            c.fputs("\n", f)
            i: i + 1U
            continue
        if: head = state\w_if && c.lmx_graph_count(statement) = 2U && c.lmx_graph_kind(g, c.lmx_graph_get(statement, 1U)) = 4
            status: lm_compiler_graph_keep(g, f, root, args, mi, names, types, ptr, n, k0, kept, kn, c.lmx_graph_get(statement, 0U), level, 0, src, fname, at[0])
            if: status != 0
                return: status
            lm_compiler_graph_indent(f, level)
            c.fputs("if: ", f)
            status: lm_compiler_graph_expr(g, f, root, args, mi, names, ptr, n, k0, kept, kn[0], c.lmx_graph_get(statement, 0U), 1, src, fname, at[0])
            c.fputs("\n", f)
            if: status = 0
                status: lm_compiler_graph_block(g, f, root, args, mi, names, types, ptr, n, k0, kept, kn, (cast: (@: c.Lmx) c.lmx_graph_get(statement, 1U)), level + 1, src, fname, at)
            lm_compiler_graph_indent(f, level + 1)
            c.fputs("---\n", f)
            next: 0
            if: i + 1U < count
                next: c.lmx_graph_get(block, i + 1U)
            if: status = 0 && next != 0 && c.lmx_graph_kind(g, next) = 4 && c.lmx_graph_name_of(g, next) = state\w_else
                i: i + 1U
                lm_compiler_graph_indent(f, level)
                c.fputs("else:\n", f)
                status: lm_compiler_graph_block(g, f, root, args, mi, names, types, ptr, n, k0, kept, kn, (cast: (@: c.Lmx) next), level + 1, src, fname, at)
                lm_compiler_graph_indent(f, level + 1)
                c.fputs("---\n", f)
            ---
            i: i + 1U
            continue
        if: path != 0 && c.lmx_graph_count(statement) = 2U
            # The head's owner is read before the value, in lexical order, as an operation's left operand is.
            status: lm_compiler_graph_keep(g, f, root, args, mi, names, types, ptr, n, k0, kept, kn, path, level, 0, src, fname, at[0])
            if: status = 0 && c.lmx_graph_kind(g, path) = 4 && c.lmx_graph_count((cast: (@: c.Lmx) path)) = 3U
                if: lm_compiler_graph_before(g, c.lmx_graph_get((cast: (@: c.Lmx) path), 0U), c.lmx_graph_get(statement, 1U)) != 0
                    status: lm_compiler_graph_hold(g, f, root, args, mi, names, types, ptr, n, k0, kept, kn, c.lmx_graph_get((cast: (@: c.Lmx) path), 0U), 0, 0U, level, 0, src, fname, at[0])
                ---
            if: status = 0
                status: lm_compiler_graph_keep(g, f, root, args, mi, names, types, ptr, n, k0, kept, kn, c.lmx_graph_get(statement, 1U), level, 0, src, fname, at[0])
            if: status != 0
                return: status
            lm_compiler_graph_indent(f, level)
            status: lm_compiler_graph_expr(g, f, root, args, mi, names, ptr, n, k0, kept, kn[0], path, 1, src, fname, at[0])
            if: status = 0
                c.fputs(": ", f)
                status: lm_compiler_graph_expr(g, f, root, args, mi, names, ptr, n, k0, kept, kn[0], c.lmx_graph_get(statement, 1U), 1, src, fname, at[0])
                c.fputs("\n", f)
            ---
            i: i + 1U
            continue
        if: head != 0 && c.lmx_graph_count(statement) = 1U && (c.lmx_graph_formal(g, args, head) < c.lmx_graph_count(args) || lm_compiler_graph_place_at(names, n, head) < n)
            status: lm_compiler_graph_keep(g, f, root, args, mi, names, types, ptr, n, k0, kept, kn, c.lmx_graph_get(statement, 0U), level, 0, src, fname, at[0])
            if: status != 0
                return: status
            lm_compiler_graph_indent(f, level)
            lm_compiler_graph_name(g, f, args, mi, names, n, k0, head)
            c.fputs(": ", f)
            status: lm_compiler_graph_expr(g, f, root, args, mi, names, ptr, n, k0, kept, kn[0], c.lmx_graph_get(statement, 0U), 1, src, fname, at[0])
            c.fputs("\n", f)
            i: i + 1U
            continue
        if: head != 0 && lm_compiler_graph_callee(g, root, raw) != 0
            status: lm_compiler_graph_keep(g, f, root, args, mi, names, types, ptr, n, k0, kept, kn, raw, level, 0, src, fname, at[0])
            if: status != 0
                return: status
            lm_compiler_graph_indent(f, level)
            status: lm_compiler_graph_expr(g, f, root, args, mi, names, ptr, n, k0, kept, kn[0], raw, 1, src, fname, at[0])
            c.fputs("\n", f)
            i: i + 1U
            continue
        return: lm_compiler_graph_refuse_at(src, fname, at[0], "the graph path of a machine function translates if, else, return, declarations, writes and calls: no other statement yet")
    ---
    return: status
end: lm_compiler_graph_block

# ---- The module ------------------------------------------------------------------------------------------------------

# The words of the root's statements named head (predef or include), each as written, after prefix, one line each
# (each = 1) or one line of all (each = 0). 0, or 1 for a field that is no word.
fn: lm_compiler_graph_door (@: g c.LmxGraph; @: f c.FILE; @: root c.Lmx; @: head char; const: (@: prefix char); int: each) int
    @: value void 0
    @: words c.Lmx 0
    size_t: i 0U
    size_t: k 0U
    int: seen 0
    while: i < c.lmx_graph_count(root)
        value: c.lmx_graph_get(root, i)
        if: c.lmx_graph_kind(g, value) = 4 && c.lmx_graph_name_of(g, value) = head
            words: (cast: (@: c.Lmx) value)
            k: 0U
            while: k < c.lmx_graph_count(words)
                if: c.lmx_graph_kind(g, c.lmx_graph_get(words, k)) != 2
                    return: 1
                if: each != 0 || seen = 0
                    c.fputs(prefix, f)
                c.fputs(" ", f)
                c.fputs(c.lmx_graph_word_text(g, c.lmx_graph_get(words, k)), f)
                if: each != 0
                    c.fputs("\n", f)
                seen: 1
                k: k + 1U
            ---
        ---
        i: i + 1U
    ---
    if: each = 0 && seen != 0
        c.fputs("\n", f)
    return: 0
end: lm_compiler_graph_door

# One function of the module: its signature, its own places declared at its entry (numbered from k0), its body, its end.
# The count of its own places in places[0], 0; or the refusal.
fn: lm_compiler_graph_function (@: g c.LmxGraph; @: f c.FILE; @: root c.Lmx; @: made c.Lmx; @: name char; int: mi; int: k0; @: places size_t; const: (@: src char)) int
    @: args c.Lmx c.lmx_graph_method_args(g, made)
    @: body c.Lmx c.lmx_graph_method_body(g, made)
    size_t: room 0U
    @@: names char 0
    @@: types char 0
    @: ptr int 0
    @@: kept c.Lmx 0
    size_t: n 0U
    size_t: kn 0U
    size_t: i 0U
    int: at 0
    int: status 0
    places[0]: 0U
    if: args = 0 || body = 0
        return: lm_compiler_graph_refuse(src, "a machine function has args and a body")
    room: lm_compiler_graph_count_tree(g, body) + 1U
    names: (cast: (@@: char) c.calloc(room, sizeof(@: char)))
    types: (cast: (@@: char) c.calloc(room, sizeof(@: char)))
    ptr: (cast: (@: int) c.calloc(room, c.sizeof(c.int)))
    # The values the function keeps before their statements: at most one per Lmx of its body.
    kept: (cast: (@@: c.Lmx) c.calloc(lm_compiler_graph_count_nodes(g, (cast: (@: void) body)) + 1U, sizeof(@: void)))
    if: names = 0 || types = 0 || ptr = 0 || kept = 0
        return: lm_compiler_graph_refuse(src, "out of memory")
    status: lm_compiler_graph_collect(g, args, body, names, types, ptr, @ n, src, name)
    if: status != 0
        return: status
    if: lm_compiler_graph_sig(g, f, made, name, mi) != 0
        return: 1
    c.fputs("\n", f)
    while: i < n
        lm_compiler_graph_indent(f, 1)
        if: ptr[i] != 0
            c.fputs("@: ", f)
            lm_compiler_graph_type(f, types[i])
            c.fputs(" ", f)
        else:
            lm_compiler_graph_type(f, types[i])
            c.fputs(": ", f)
        ---
        lm_compiler_graph_place_cname(f, k0 + (cast: (int) i), names[i])
        c.fputs(" 0\n", f)
        i: i + 1U
    ---
    status: lm_compiler_graph_block(g, f, root, args, mi, names, types, ptr, n, k0, kept, @ kn, body, 1, src, name, @ at)
    if: status != 0
        return: status
    c.fprintf(f, "end: %s\n\n", name)
    c.free((cast: (@: void) names))
    c.free((cast: (@: void) types))
    c.free((cast: (@: void) ptr))
    c.free((cast: (@: void) kept))
    places[0]: n
    return: 0
end: lm_compiler_graph_function

# The machine module of the clean graph root, in the namespace of this translation's traversal, into f: the mark, the
# preamble, one prototype block of all its functions, each function (L2 section 20). names[0..count) are the exports
# --machine names; each names a function with a body at the root (compared by the addresses of the spellings). 0, or
# the refusal.
fn: lm_compiler_graph_module (@: g c.LmxGraph; @: f c.FILE; @: root c.Lmx; const: (@: src char); @@: names char; int: count) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    size_t: n c.lmx_graph_count(root)
    @@: made_list c.Lmx (cast: (@@: c.Lmx) c.calloc(n + 1U, sizeof(@: void)))
    @@: name_list char (cast: (@@: char) c.calloc(n + 1U, sizeof(@: char)))
    @: value void 0
    @: decl c.Lmx 0
    @: made c.Lmx 0
    @: head char 0
    @: name char 0
    @: wanted char 0
    @: base char 0
    size_t: i 0U
    size_t: p 0U
    size_t: places 0U
    int: fcount 0
    int: k 0
    int: x 0
    int: k0 0
    int: found 0
    int: status 0
    if: state = 0 || made_list = 0 || name_list = 0
        return: lm_compiler_graph_refuse(src, "out of memory")
    # The root of a machine module holds its functions and the declarations of its C door, nothing to run.
    while: i < n
        value: c.lmx_graph_get(root, i)
        head: c.lmx_graph_name_of(g, value)
        if: c.lmx_graph_kind(g, value) != 4 || head = 0
            return: lm_compiler_graph_refuse_root(src, i, "the root of a machine module holds its functions and its predef and include declarations: it has no entry to run a statement or a graph to hold a value")
        if: head = state\w_fn
            decl: (cast: (@: c.Lmx) value)
            name: c.lmx_graph_fn_decl_name(g, decl)
            made: 0
            if: name != 0
                made: (cast: (@: c.Lmx) c.lmx_graph_space_find(root, name))
            if: name = 0 || c.lmx_graph_fn_written(g, decl) = 0 || made = 0 || c.lmx_graph_method(g, made) = 0 || made\parent != decl || c.lmx_graph_has_result(g, made) = 0
                return: lm_compiler_graph_refuse_root(src, i, "a function of a machine module is declared with written arguments, a result and a body")
            if: name[0] = 108 && name[1] = 50 && name[2] = 95
                return: lm_compiler_graph_refuse_root(src, i, "a machine function's C name is not l2_, the translator's own")
            made_list[fcount]: made
            name_list[fcount]: name
            fcount: fcount + 1
        else:
            if: head != state\w_predef && head != state\w_include
                return: lm_compiler_graph_refuse_root(src, i, "the root of a machine module holds its functions (fn: the graph path translates no sub yet) and its predef and include declarations: it has no entry to run a statement or a graph to hold a Structure")
            ---
        ---
        i: i + 1U
    ---
    # Every export names a function with a body at the root.
    while: k < count
        wanted: c.lmx_graph_intern(names[k], c.strlen(names[k]))
        found: 0
        x: 0
        while: x < fcount
            if: name_list[x] = wanted
                found: 1
            x: x + 1
        ---
        if: found = 0
            c.fprintf(c.stderr, "l2trans error: %s: --machine %s names no function with a body at the unit's root\n", src, names[k])
            return: 1
        k: k + 1
    ---
    # The mark names the source by its file, as the P0 path's does, and the input it was read from.
    base: (cast: (@: char) src)
    p: 0U
    while: src[p] != 0
        if: src[p] = 47 || src[p] = 92
            base: (cast: (@: char) (src + p + 1U))
        p: p + 1U
    ---
    c.fprintf(f, "# Generated by l2trans from the clean graph of %s, a machine module (L2 section 20): edit that source, not this file.\n", base)
    c.fputs("include: \"<stddef.h>\"\n", f)
    if: lm_compiler_graph_door(g, f, root, (cast: (@: char) state\w_predef), "predef:", 1) != 0 || lm_compiler_graph_door(g, f, root, (cast: (@: char) state\w_include), "include:", 0) != 0
        return: lm_compiler_graph_refuse(src, "a predef or include declaration of a machine module names its files by words")
    c.fputs("\nprototype:\n", f)
    x: 0
    while: x < fcount
        c.fputs("    ", f)
        status: lm_compiler_graph_sig(g, f, made_list[x], name_list[x], x)
        if: status = 1
            c.fprintf(c.stderr, "l2trans error: %s: fn %s: a formal of a machine function is a number `T: name` or a reference `@: name T`\n", src, name_list[x])
            return: 1
        if: status != 0
            c.fprintf(c.stderr, "l2trans error: %s: fn %s: the result of a machine function is a C scalar word (int, char, size_t, unsigned, ulong) or a C door type\n", src, name_list[x])
            return: 1
        c.fputs("\n", f)
        x: x + 1
    ---
    c.fputs("end: prototype\n\n", f)
    x: 0
    while: x < fcount
        status: lm_compiler_graph_function(g, f, root, made_list[x], name_list[x], x, k0, @ places, src)
        if: status != 0
            return: status
        k0: k0 + (cast: (int) places)
        x: x + 1
    ---
    c.free((cast: (@: void) made_list))
    c.free((cast: (@: void) name_list))
    return: 0
end: lm_compiler_graph_module

# The translation of the machine module at src from its clean graph into the L1 file out: the graph built in an arena
# of this translation (lm_graph_build_file; the parse tree destroyed with the construction), the traversal's namespace
# opened (lmx_graph_space_open) and closed, the arena released; the L1 written to out.tmp and published at out only
# when the whole module is written. 0, or 1 for a refusal (said on stderr).
fn: lm_compiler_graph_translate (const: (@: src char); const: (@: out char); @@: names char; int: count) int
    @: arena c.LmxArena (cast: (@: c.LmxArena) c.calloc(1U, c.sizeof(c.LmxArena)))
    @: tmp char (cast: (@: char) c.malloc(c.strlen(out) + 5U))
    @: g c.LmxGraph 0
    @: root c.Lmx 0
    @: f c.FILE 0
    int: opened 0
    int: status 0
    if: arena = 0 || tmp = 0
        return: lm_compiler_graph_refuse(src, "out of memory")
    c.sprintf(tmp, "%s.tmp", out)
    if: c.lmx_arena_open(arena) != 0
        return: lm_compiler_graph_refuse(src, "the translation's arena does not open")
    g: c.lmx_graph_open(arena)
    if: g = 0
        return: lm_compiler_graph_refuse(src, "the translation's graph does not open")
    status: c.lm_graph_build_file(g, src, @ root)
    if: status != 0
        c.fprintf(c.stderr, "l2trans error: %s: the clean graph of the unit is not built (the builder answered %d)\n", src, status)
        return: 1
    status: c.lmx_graph_space_open(g, root, @ opened)
    if: status != 0
        c.fprintf(c.stderr, "l2trans error: %s: the traversal of the unit's root does not open (answer %d)\n", src, status)
        return: 1
    f: c.fopen(tmp, "wb")
    if: f = 0
        c.lmx_graph_space_close(opened)
        c.fprintf(c.stderr, "l2trans error: cannot open %s\n", tmp)
        return: 1
    status: lm_compiler_graph_module(g, f, root, src, names, count)
    if: c.fclose(f) != 0 && status = 0
        status: lm_compiler_graph_refuse(src, "the machine module is not written")
    c.lmx_graph_space_close(opened)
    c.lmx_graph_close(g)
    c.lmx_arena_release(arena)
    c.free((cast: (@: void) arena))
    if: status != 0
        c.remove(tmp)
        c.free((cast: (@: void) tmp))
        return: 1
    c.remove(out)
    if: c.rename(tmp, out) != 0
        c.remove(tmp)
        c.free((cast: (@: void) tmp))
        return: lm_compiler_graph_refuse(src, "the machine module cannot be published at its output path")
    c.free((cast: (@: void) tmp))
    return: 0
end: lm_compiler_graph_translate

# The command line of the frontend's clean-graph input: `--graph --library --machine NAME ... SOURCE [PART ...] OUTPUT`
# -- the words of the frontend's machine module (lm_compiler_cli_main) after the selector --graph, which the hosted
# frontend tools/l2trans.lm2 reads first. The recipe names the modules translated from their graph; there is no
# fallback to the P0 path for them. 0, or 1 for a refusal.
fn: lm_compiler_graph_main (int: argc; @@: argv char) int
    @@: names char 0
    int: count 0
    int: a 2
    int: k 0
    int: j 0
    if: argc < 2 || c.strcmp(argv[1], "--graph") != 0
        c.fputs("usage: l2trans --graph --library --machine NAME ... <source.lm2> [<part.lm2> ...] <output.lm1>\n", c.stderr)
        return: 1
    if: argc < a + 3 || c.strcmp(argv[a], "--library") != 0
        c.fputs("l2trans error: --graph translates a machine module: --library --machine NAME ... <source.lm2> [<part.lm2> ...] <output.lm1>\n", c.stderr)
        return: 1
    a: a + 1
    names: (cast: (@@: char) c.calloc((cast: (size_t) argc), sizeof(@: char)))
    if: names = 0
        c.fputs("l2trans error: out of memory\n", c.stderr)
        return: 1
    while: argc >= a + 4 && c.strcmp(argv[a], "--machine") = 0
        names[count]: argv[a + 1]
        count: count + 1
        a: a + 2
    ---
    if: count = 0
        c.fputs("l2trans error: --graph translates a machine module: --machine NAME ... names its exports\n", c.stderr)
        return: 1
    if: argc < a + 2
        c.fputs("usage: l2trans --graph --library --machine NAME ... <source.lm2> [<part.lm2> ...] <output.lm1>\n", c.stderr)
        return: 1
    if: argv[a][0] = 45 && argv[a][1] = 45
        c.fprintf(c.stderr, "l2trans error: --graph: %s is not translated from the clean graph yet (a machine module without a header of its own)\n", argv[a])
        return: 1
    while: k < count
        if: c.strncmp(names[k], "l2_", 3U) = 0
            c.fprintf(c.stderr, "l2trans error: --machine %s: a machine function's C name is not l2_, the translator's own\n", names[k])
            return: 1
        j: 0
        while: j < k
            if: c.strcmp(names[j], names[k]) = 0
                c.fprintf(c.stderr, "l2trans error: --machine %s is given twice\n", names[k])
                return: 1
            j: j + 1
        ---
        k: k + 1
    ---
    return: lm_compiler_graph_translate(argv[a], argv[argc - 1], names, count)
end: lm_compiler_graph_main
