# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
# Admission constructs all physical places before the ordered data traversal.
# The initializer can inspect the index/header of a later declaration.
(
    Observed:
        int: early 0
        int: late 0
        int: seen 0
)
sub: build () (
    int: early typeof(D[0])
    D:
        @: p int
    end: D
    C:
        @: p int
    end: C
    int: i 7
    int: late 0
    int: seen 0
)
    D\p := @(data\i)
    call(D; C)
    data\late := typeof(D[0])
    data\seen := \(D\p)
build()
int: early build\data\early
int: late build\data\late
int: seen build\data\seen

sub: main ()
    @: sink node[0]
    sink\Observed\early := node\early
    sink\Observed\late := node\late
    sink\Observed\seen := node\seen
main()
