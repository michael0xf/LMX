Model:
    size_t: value 1U
end: Model

# FABLE-SONNET-ARRAY-WRITE-DISPATCH-20260923-119: an out-of-range literal
# index on a node-prefixed array write (buf has length 3) must refuse
# with l2_own_index_head's own bounds check, unchanged -- node keeps
# today's prefix meaning (fable's correction, point 2), so this is the
# same diagnostic a plain buf[5] already gave before this ticket. A
# general own-field root (fresh\buf[5]) no longer reaches this bounds
# check at all: it refuses earlier, as "unknown field path segment", per
# unit_array_write_general_root_no_field.lm2 -- this fixture is about the
# node/for route staying exactly as it was.
fn: broken () int
    []: int buf 3
    node\buf[5]: 1
    return: 0
end: broken

return: broken()
