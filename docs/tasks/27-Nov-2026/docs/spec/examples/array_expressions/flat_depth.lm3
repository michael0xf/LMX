FlatDepth:
    return: @
    run:
        throws: copy(`[*]`\throws) copy(`*`\throws)
        [2][2]int: a [1 2; 3 4]
        [2][2]int: b [[5 6] [7 8]]
        return: (a [*] b; a .(1)[*] b; a * b)

FlatDepthFusion:
    return: @
    run:
        throws: copy(fuse\throws) copy(`*`\throws) copy(`+`\throws)
        [2][2]int: a [1 2; 3 4]
        [2][2]int: b [[5 6] [7 8]]
        return: fuse(a * b + 1)
