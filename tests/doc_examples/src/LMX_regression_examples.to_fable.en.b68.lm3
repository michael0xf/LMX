Operands:
    copy: sys\OPERANDS_TEMPLATE
    return: int
    add:
        return: \left + \right[0]
    Calculation:
        int: n
        return: int
        calculate:
            return: (n add 4) add n
        demo:
            int: zero calculate(0)
            int: negative calculate(-3)
            int: positive calculate(8)
            int: repeated calculate(8)
            if: positive != repeated
                return: -999
            return: zero + negative + positive
