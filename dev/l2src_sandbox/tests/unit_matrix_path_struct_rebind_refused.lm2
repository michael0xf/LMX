# FABLE-GROKBOT-MATRIX-20260924-143 cell: path target x Structure reference.
# Terminal Structure-field rebind through a path stays located REFUSAL.
Model:
    size_t: value 1U
end: Model

Outer:
    Model: inner
end: Outer

Outer: o
Model: a
o\inner: a
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
