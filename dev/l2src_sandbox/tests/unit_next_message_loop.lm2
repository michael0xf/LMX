# Q53: the receiver inside the loop declares a different lexical occurrence.
# The condition keeps reading the outer m, so the explicit bound stops at 5.
# Root and method bodies have the same declaration/visibility rules.
int: n 0
receiveMessage: m
while: m != 0 && n < 5
    n: n + 1
    receiveMessage: m
if: n != 5
    sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
