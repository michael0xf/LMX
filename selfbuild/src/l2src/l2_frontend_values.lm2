fn: lm_compiler_ret_cell_ty (int: mi) int
    int@: foreign_n_cell (cast: (int@) (@ c.l2_foreign_n))
    int@@: foreign_depth_cell (cast: (int@@) (@ c.l2_foreign_depth))
    int: rt lm_compiler_sig_ret(mi)
    int: cls lm_compiler_tramp_class(mi)
    int: fi rt - 100
    if: cls = 6 && lm_compiler_scalar_type_row(rt) >= 0
        return: (cast: (int) c.lm_compiler_oc_scalar(rt))
    if: rt = 1
        return: (cast: (int) (1))
    if: cls = 1
        return: (cast: (int) (0))
    if: cls = 2
        return: (cast: (int) (2))
    if: cls = 3
        return: (cast: (int) (3))
    if: cls = 4
        return: (cast: (int) (36))
    if: rt = 3
        return: (cast: (int) (c.lm_compiler_oc_pointer(12)))
    if: rt = 16
        return: (cast: (int) (c.lm_compiler_oc_pointer(16)))
    if: rt = 35
        return: (cast: (int) (c.lm_compiler_oc_pointer(3)))
    if: rt = 32
        return: (cast: (int) (c.lm_compiler_oc_pointer(17)))
    if: rt >= 100 && fi < foreign_n_cell[0] && foreign_depth_cell[0][fi] > 0
        return: (cast: (int) (c.lm_compiler_oc_pointer(lm_compiler_result_value_ty(rt))))
    return: (cast: (int) (0 - 1))
end: lm_compiler_ret_cell_ty

fn: lm_compiler_snap_read_ready (c.FILE@: in; size_t@: len; c.long: size) char@
    char@: data
    size_t: got
    if: size < (cast: (c.long) 0) || c.fseek(in, (cast: (c.long) 0), c.SEEK_SET) != 0
        c.fclose(in)
        return: (cast: (char@) (0))
    data := (cast: (char@) c.lm_compiler_xmalloc((cast: (size_t) size) + 1U))
    if: data = 0
        c.fclose(in)
        return: (cast: (char@) (0))
    got := c.fread(data, 1U, (cast: (size_t) size), in)
    c.fclose(in)
    if: got != (cast: (size_t) size)
        c.lm_compiler_xfree((cast: (@) data))
        return: (cast: (char@) (0))
    data[got] := 0
    \len := got
    return: (cast: (char@) (data))
end: lm_compiler_snap_read_ready

fn: lm_compiler_snap_read (const: (char@: path); size_t@: len) char@
    c.FILE@: in
    in := c.fopen(path, "rb")
    if: in = 0
        return: (cast: (char@) (0))
    if: c.fseek(in, (cast: (c.long) 0), c.SEEK_END) != 0
        c.fclose(in)
        return: (cast: (char@) (0))
    return: lm_compiler_snap_read_ready(in, len, (cast: (c.long) c.ftell(in)))
end: lm_compiler_snap_read

# tp113: the method-name index -- the l2_m_name rows bucketed by the name's bytes (FNV), each bucket a chain in row
# order (bucket/tail/next), built incrementally up to l2_m_n and valid for one method table: l2_m_gen is bumped where
# l2_m_n is reset (lm_compiler_meth_free in core, the per-unit reset of translate_unit in emit). A row with a null name
# is in no chain; text_same never admits it. The chain of a name holds every row text_same could admit, in row order, so
# a reader that keeps its filters sees the rows the scan of every row saw. The same five helpers, under the prefix
# lm_compiler_mix_, serve lm_compiler_site_method in l2_frontend_context (internal helpers are per module; the state
# cells are one).
fn: lm_compiler_vmix_hash (const: (c.LmP0Text@: t)) unsigned
    unsigned: h 2166136261U
    size_t: i 0U
    if: t = 0 || t\data = 0
        return: (cast: (unsigned) (0U))
    while: i < t\length
        h := h * 16777619U + (cast: (unsigned) (cast: (uchar) t\data[i]))
        i := i + 1U
    ---
    return: (cast: (unsigned) (h))
end: lm_compiler_vmix_hash

fn: lm_compiler_vmix_insert (int: r) int
    c.LmP0Text@@@: m_name_cell (cast: (c.LmP0Text@@@) (@ c.l2_m_name))
    int@: cap_cell (cast: (int@) (@ c.l2_mix_cap))
    int@@: bucket_cell (cast: (int@@) (@ c.l2_mix_bucket))
    int@@: tail_cell (cast: (int@@) (@ c.l2_mix_tail))
    int@@: next_cell (cast: (int@@) (@ c.l2_mix_next))
    int: b
    next_cell[0][r] := -1
    if: m_name_cell[0][r] = 0
        return: (cast: (int) (0))
    b := (cast: (int) (lm_compiler_vmix_hash(m_name_cell[0][r]) % (cast: (unsigned) cap_cell[0])))
    if: bucket_cell[0][b] < 0
        bucket_cell[0][b] := r
    else:
        next_cell[0][tail_cell[0][b]] := r
    ---
    tail_cell[0][b] := r
    return: (cast: (int) (0))
end: lm_compiler_vmix_insert

fn: lm_compiler_vmix_sync () int
    int@: m_n_cell (cast: (int@) (@ c.l2_m_n))
    int@: m_gen_cell (cast: (int@) (@ c.l2_m_gen))
    int@: n_cell (cast: (int@) (@ c.l2_mix_n))
    int@: cap_cell (cast: (int@) (@ c.l2_mix_cap))
    int@: rows_cell (cast: (int@) (@ c.l2_mix_rows))
    int@: gen_cell (cast: (int@) (@ c.l2_mix_gen))
    int@@: bucket_cell (cast: (int@@) (@ c.l2_mix_bucket))
    int@@: tail_cell (cast: (int@@) (@ c.l2_mix_tail))
    int@@: next_cell (cast: (int@@) (@ c.l2_mix_next))
    int: cap
    if: gen_cell[0] != m_gen_cell[0] || n_cell[0] > m_n_cell[0]
        if: bucket_cell[0] != 0 && cap_cell[0] > 0
            c.memset((cast: (@) bucket_cell[0]), 255, (cast: (size_t) cap_cell[0]) * c.sizeof(c.int))
            c.memset((cast: (@) tail_cell[0]), 255, (cast: (size_t) cap_cell[0]) * c.sizeof(c.int))
        ---
        n_cell[0] := 0
        gen_cell[0] := m_gen_cell[0]
    ---
    if: m_n_cell[0] <= n_cell[0]
        return: (cast: (int) (0))
    if: bucket_cell[0] = 0 || m_n_cell[0] * 2 > cap_cell[0] || m_n_cell[0] > rows_cell[0]
        cap := 1024
        while: cap < m_n_cell[0] * 4
            cap := cap * 2
        if: bucket_cell[0] != 0
            c.lm_compiler_xfree((cast: (@) bucket_cell[0]))
        if: tail_cell[0] != 0
            c.lm_compiler_xfree((cast: (@) tail_cell[0]))
        if: next_cell[0] != 0
            c.lm_compiler_xfree((cast: (@) next_cell[0]))
        bucket_cell[0] := (cast: (int@) c.lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        tail_cell[0] := (cast: (int@) c.lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        next_cell[0] := (cast: (int@) c.lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        if: bucket_cell[0] = 0 || tail_cell[0] = 0 || next_cell[0] = 0
            cap_cell[0] := 0
            rows_cell[0] := 0
            n_cell[0] := 0
            return: (cast: (int) (1))
        ---
        c.memset((cast: (@) bucket_cell[0]), 255, (cast: (size_t) cap) * c.sizeof(c.int))
        c.memset((cast: (@) tail_cell[0]), 255, (cast: (size_t) cap) * c.sizeof(c.int))
        cap_cell[0] := cap
        rows_cell[0] := cap
        n_cell[0] := 0
    ---
    while: n_cell[0] < m_n_cell[0]
        lm_compiler_vmix_insert(n_cell[0])
        n_cell[0] := n_cell[0] + 1
    ---
    return: (cast: (int) (0))
end: lm_compiler_vmix_sync

fn: lm_compiler_vmix_first (const: (c.LmP0Text@: t)) int
    int@: m_n_cell (cast: (int@) (@ c.l2_m_n))
    int@: cap_cell (cast: (int@) (@ c.l2_mix_cap))
    int@@: bucket_cell (cast: (int@@) (@ c.l2_mix_bucket))
    int: b
    if: t = 0 || m_n_cell[0] = 0
        return: (cast: (int) (-1))
    if: lm_compiler_vmix_sync() != 0 || bucket_cell[0] = 0 || cap_cell[0] <= 0
        return: (cast: (int) (-2))
    b := (cast: (int) (lm_compiler_vmix_hash(t) % (cast: (unsigned) cap_cell[0])))
    return: (cast: (int) (bucket_cell[0][b]))
end: lm_compiler_vmix_first

fn: lm_compiler_vmix_step (int: r; int: linear) int
    int@: n_cell (cast: (int@) (@ c.l2_mix_n))
    int@@: next_cell (cast: (int@@) (@ c.l2_mix_next))
    if: linear != 0
        return: (cast: (int) (r + 1))
    if: r < 0 || r >= n_cell[0] || next_cell[0] = 0
        return: (cast: (int) (-1))
    return: (cast: (int) (next_cell[0][r]))
end: lm_compiler_vmix_step

# tp114: every document destroy of this module goes through here and bumps l2_doc_gen: a destroyed document's node
# addresses may be reused by the next parse, so the memos keyed by node addresses (l2_omemo_* in l2_frontend_context)
# forget everything by this generation at their next use instead of re-checking a remembered node against its tree.
fn: lm_compiler_values_doc_destroy (c.LmP0Document@: document) int
    int@: doc_gen_cell (cast: (int@) (@ c.l2_doc_gen))
    doc_gen_cell[0] := doc_gen_cell[0] + 1
    c.lm_p0_document_destroy(document)
    return: (cast: (int) (0))
end: lm_compiler_values_doc_destroy

# tp114: the fact index -- the L2PathFact records of l2_path_facts (appended at the tail by l2_frontend_resolve, freed whole
# by lm_compiler_bound_free, which bumps l2_pf_gen) as rows in list order, bucketed by (method, source node), each bucket a
# chain in row order (bucket/tail/next). Built incrementally: the rows after the last indexed fact are added at the next
# use; a generation change empties it. lm_compiler_use_fact_find walks one chain instead of the list and keeps its
# predicate, so it meets the same facts; the order of a chain is the list's.
fn: lm_compiler_pfi_hash (int: mi; const: (c.LmP0Node@: source)) unsigned
    size_t: k (cast: (size_t) source)
    unsigned: h (cast: (unsigned) (k / 8U + k / 4096U))
    return: (cast: (unsigned) (h * 16777619U + (cast: (unsigned) mi)))
end: lm_compiler_pfi_hash

fn: lm_compiler_pfi_insert (int: r) int
    c.L2PathFact@@@: fact_cell (cast: (c.L2PathFact@@@) (@ c.l2_pfi_fact))
    int@: cap_cell (cast: (int@) (@ c.l2_pfi_cap))
    int@@: bucket_cell (cast: (int@@) (@ c.l2_pfi_bucket))
    int@@: tail_cell (cast: (int@@) (@ c.l2_pfi_tail))
    int@@: next_cell (cast: (int@@) (@ c.l2_pfi_next))
    c.L2PathFact@: fact fact_cell[0][r]
    int: b
    next_cell[0][r] := -1
    b := (cast: (int) (lm_compiler_pfi_hash((cast: (int) (fact\method)), (cast: (const: c.LmP0Node@) (fact\source))) % (cast: (unsigned) cap_cell[0])))
    if: bucket_cell[0][b] < 0
        bucket_cell[0][b] := r
    else:
        next_cell[0][tail_cell[0][b]] := r
    ---
    tail_cell[0][b] := r
    return: (cast: (int) (0))
end: lm_compiler_pfi_insert

fn: lm_compiler_pfi_sync () int
    c.L2PathFact@@: path_facts_cell (cast: (c.L2PathFact@@) (@ c.l2_path_facts))
    int@: pf_gen_cell (cast: (int@) (@ c.l2_pf_gen))
    int@: n_cell (cast: (int@) (@ c.l2_pfi_n))
    int@: cap_cell (cast: (int@) (@ c.l2_pfi_cap))
    int@: rows_cell (cast: (int@) (@ c.l2_pfi_rows))
    int@: gen_cell (cast: (int@) (@ c.l2_pfi_gen))
    int@@: bucket_cell (cast: (int@@) (@ c.l2_pfi_bucket))
    int@@: tail_cell (cast: (int@@) (@ c.l2_pfi_tail))
    int@@: next_cell (cast: (int@@) (@ c.l2_pfi_next))
    c.L2PathFact@@@: fact_cell (cast: (c.L2PathFact@@@) (@ c.l2_pfi_fact))
    c.L2PathFact@@: last_cell (cast: (c.L2PathFact@@) (@ c.l2_pfi_last))
    c.L2PathFact@: f 0
    int: fresh 0
    int: total
    int: cap
    if: gen_cell[0] != pf_gen_cell[0] || (path_facts_cell[0] = 0 && n_cell[0] != 0)
        if: bucket_cell[0] != 0 && cap_cell[0] > 0
            c.memset((cast: (@) bucket_cell[0]), 255, (cast: (size_t) cap_cell[0]) * c.sizeof(c.int))
            c.memset((cast: (@) tail_cell[0]), 255, (cast: (size_t) cap_cell[0]) * c.sizeof(c.int))
        ---
        n_cell[0] := 0
        last_cell[0] := 0
        gen_cell[0] := pf_gen_cell[0]
    ---
    # the facts after the last indexed one (all of them when none is indexed)
    f := path_facts_cell[0]
    if: last_cell[0] != 0
        f := last_cell[0]\next
    while: f != 0
        fresh := fresh + 1
        f := f\next
    ---
    if: fresh = 0
        return: (cast: (int) (0))
    total := n_cell[0] + fresh
    if: bucket_cell[0] = 0 || total * 2 > cap_cell[0] || total > rows_cell[0]
        cap := 1024
        while: cap < total * 4
            cap := cap * 2
        if: bucket_cell[0] != 0
            c.lm_compiler_xfree((cast: (@) bucket_cell[0]))
        if: tail_cell[0] != 0
            c.lm_compiler_xfree((cast: (@) tail_cell[0]))
        if: next_cell[0] != 0
            c.lm_compiler_xfree((cast: (@) next_cell[0]))
        if: fact_cell[0] != 0
            c.lm_compiler_xfree((cast: (@) fact_cell[0]))
        bucket_cell[0] := (cast: (int@) c.lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        tail_cell[0] := (cast: (int@) c.lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        next_cell[0] := (cast: (int@) c.lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        fact_cell[0] := (cast: (c.L2PathFact@@) c.lm_compiler_xmalloc((cast: (size_t) cap) * sizeof(@)))
        if: bucket_cell[0] = 0 || tail_cell[0] = 0 || next_cell[0] = 0 || fact_cell[0] = 0
            cap_cell[0] := 0
            rows_cell[0] := 0
            n_cell[0] := 0
            last_cell[0] := 0
            return: (cast: (int) (1))
        ---
        c.memset((cast: (@) bucket_cell[0]), 255, (cast: (size_t) cap) * c.sizeof(c.int))
        c.memset((cast: (@) tail_cell[0]), 255, (cast: (size_t) cap) * c.sizeof(c.int))
        cap_cell[0] := cap
        rows_cell[0] := cap
        n_cell[0] := 0
        last_cell[0] := 0
    ---
    f := path_facts_cell[0]
    if: last_cell[0] != 0
        f := last_cell[0]\next
    while: f != 0
        fact_cell[0][n_cell[0]] := f
        lm_compiler_pfi_insert(n_cell[0])
        n_cell[0] := n_cell[0] + 1
        last_cell[0] := f
        f := f\next
    ---
    return: (cast: (int) (0))
end: lm_compiler_pfi_sync

fn: lm_compiler_pfi_first (int: mi; const: (c.LmP0Node@: source)) int
    int@: n_cell (cast: (int@) (@ c.l2_pfi_n))
    int@: cap_cell (cast: (int@) (@ c.l2_pfi_cap))
    int@@: bucket_cell (cast: (int@@) (@ c.l2_pfi_bucket))
    int: b
    if: source = 0
        return: (cast: (int) (-1))
    if: lm_compiler_pfi_sync() != 0
        return: (cast: (int) (-2))
    if: n_cell[0] = 0 || bucket_cell[0] = 0 || cap_cell[0] <= 0
        return: (cast: (int) (-1))
    b := (cast: (int) (lm_compiler_pfi_hash(mi, source) % (cast: (unsigned) cap_cell[0])))
    return: (cast: (int) (bucket_cell[0][b]))
end: lm_compiler_pfi_first

# The next fact of the walk: the list's next in the linear mode, the chain's next row otherwise (r is the current row).
fn: lm_compiler_pfi_advance (c.L2PathFact@: fact; int: linear; int@: r) c.L2PathFact@
    int@: n_cell (cast: (int@) (@ c.l2_pfi_n))
    int@@: next_cell (cast: (int@@) (@ c.l2_pfi_next))
    c.L2PathFact@@@: fact_cell (cast: (c.L2PathFact@@@) (@ c.l2_pfi_fact))
    if: linear != 0
        if: fact = 0
            return: (cast: (c.L2PathFact@) (0))
        return: (cast: (c.L2PathFact@) (fact\next))
    ---
    if: \r < 0 || \r >= n_cell[0] || next_cell[0] = 0
        \r := -1
        return: (cast: (c.L2PathFact@) (0))
    ---
    \r := next_cell[0][\r]
    if: \r < 0
        return: (cast: (c.L2PathFact@) (0))
    return: (cast: (c.L2PathFact@) (fact_cell[0][\r]))
end: lm_compiler_pfi_advance

# The physical slot of a part of a method with parts (lm_compiler_fn_parts_on).  `part` is the part as the contract names it: 0
# args, 1 return, 2 var, 3 body -- the number every part record of the translator keeps.  A `fn` holds the four in that order; a
# `sub` returns no value and has no result part, so its var and body stand one slot lower (the book, #method-parts: the return
# "there where it is").  -1 for a part the method does not have, and for a method with no parts.
fn: lm_compiler_part_slot (int: mi; int: part) int
    c.LmP0Node@@@: m_node_cell (cast: (c.LmP0Node@@@) (@ c.l2_m_node))
    if: part < 0 || part > 3 || lm_compiler_fn_parts_on(mi) = 0
        return: (cast: (int) (-1))
    if: c.lm_compiler_frame_head(m_node_cell[0][mi], "fn") != 0
        return: (cast: (int) (part))
    if: part = 1
        return: (cast: (int) (-1))
    if: part = 0
        return: (cast: (int) (0))
    return: (cast: (int) (part - 1))
end: lm_compiler_part_slot

# IDENTIFIER-CODES (the author's decision of 2026-11-07, LMX_blog/2026-11-07.md; the book, names and paths): the
# emitted unit names an identifier only by its code. Each place of the emission that names one takes the next index K
# of the unit's table (lm_compiler_unit_id) and writes `l2_ids[KU]`, a code of the process's tables (lmx_ids). The
# unit's load l2_ids_load (lm_compiler_emit_unit_ids, written after every other part of the unit, called first by its
# builder) turns each written spelling into its code once, at the unit's input boundary; no executed operation consults
# the tables. The translator keeps the unit's spellings only to write that load and compares none of them: the same
# spelling written at two places takes two indices of one code.
fn: lm_compiler_unit_id (const: (char@: data); size_t: nb) int
    char@@@: text_cell (cast: (char@@@) (@ c.l2_uid_text))
    size_t@@: len_cell (cast: (size_t@@) (@ c.l2_uid_len))
    int@: n_cell (cast: (int@) (@ c.l2_uid_n))
    int@: cap_cell (cast: (int@) (@ c.l2_uid_cap))
    int@: alloc_err_cell (cast: (int@) (@ c.l2_alloc_err))
    @: grown void 0
    char@: copy 0
    int: k n_cell[0]
    int: want 0
    if: data = 0 || nb = 0U
        return: (cast: (int) (0 - 1))
    # An exact identifier and its bare spelling are one name (the grammar, exact identifiers; Codex's review of 303):
    # the code is the payload's -- `` `a` `` written as a named argument reaches the formal a by one code.
    if: nb >= 3U && data[0] = 96 && data[nb - 1U] = 96
        data := data + 1U
        nb := nb - 2U
    ---
    if: k >= cap_cell[0]
        want := c.lm_compiler_cap_next(cap_cell[0], k + 1)
        if: want < 0
            alloc_err_cell[0] := 2
            return: (cast: (int) (0 - 1))
        grown := c.lm_compiler_vec_grow((cast: (@) text_cell[0]), k, want, sizeof(char@))
        if: grown = 0
            return: (cast: (int) (0 - 1))
        text_cell[0] := (cast: (char@@) grown)
        grown := c.lm_compiler_vec_grow((cast: (@) len_cell[0]), k, want, c.sizeof(c.size_t))
        if: grown = 0
            return: (cast: (int) (0 - 1))
        len_cell[0] := (cast: (size_t@) grown)
        cap_cell[0] := want
    ---
    copy := (cast: (char@) c.lm_compiler_xmalloc(nb))
    if: copy = 0
        return: (cast: (int) (0 - 1))
    c.memcpy((cast: (@) copy), (cast: (@) data), nb)
    text_cell[0][k] := copy
    len_cell[0][k] := nb
    n_cell[0] := k + 1
    return: k
end: lm_compiler_unit_id

# The code of a spelling as the emitted unit reads it: `l2_ids[KU]`, K the spelling's index in the unit's table. 0, or 1
# for no spelling, without memory or when the output fails.
fn: lm_compiler_emit_unit_id (const: (char@: data); size_t: nb) int
    c.FILE@@: out_cell (cast: (c.FILE@@) (@ c.l2_out))
    int: k lm_compiler_unit_id(data, nb)
    if: k < 0
        return: (cast: (int) (1))
    return: (cast: (int) (c.fprintf(out_cell[0], "l2_ids[%dU]", k) < 0))
end: lm_compiler_emit_unit_id

fn: lm_compiler_emit_unit_id_text (const: (c.LmP0Text@: t)) int
    if: t = 0 || t\data = 0
        return: (cast: (int) (1))
    return: (cast: (int) (lm_compiler_emit_unit_id((cast: (const: char@) (t\data)), t\length)))
end: lm_compiler_emit_unit_id_text

# The unit's table of codes and its load, declared with the unit's other module cells (a library unit's under its own
# hashed names, as its other tables): `@: size_t l2_ids 0` and the prototype of l2_ids_load, which the builder calls
# before the definition at the end of the unit. The unit's table of spellings starts empty with the unit's emission
# (lm_compiler_emit_unit).
fn: lm_compiler_emit_unit_ids_declare () int
    int@: library_mode (cast: (int@) (@ c.l2_library_mode))
    unsigned@: hash_a (cast: (unsigned@) (@ c.l2_module_hash_a))
    unsigned@: hash_b (cast: (unsigned@) (@ c.l2_module_hash_b))
    c.FILE@@: output (cast: (c.FILE@@) (@ c.l2_out))
    if: library_mode[0] != 0 && c.fprintf(output[0], "define: l2_ids l2_u%08X%08X_ids\ndefine: l2_ids_load l2_u%08X%08X_ids_load\n", hash_a[0], hash_b[0], hash_a[0], hash_b[0]) < 0
        return: (cast: (int) (1))
    return: (cast: (int) (c.fputs("@: size_t l2_ids 0\n\nprototype:\n    fn: l2_ids_load () int\nend: prototype\n\n", output[0]) < 0))
end: lm_compiler_emit_unit_ids_declare

# The load of the unit's identifiers, after every other part of the unit: l2_ids_load turns each spelling the unit
# names into its code once (lmx_ids_code, the input boundary of the unit) and publishes the table of codes in the cell
# l2_ids (lmx_ids_unit_publish: once per process; a load that lost the race frees its own table). 0, or 1 when a
# spelling got no code; a published table is loaded and is not read again.
fn: lm_compiler_emit_unit_ids () int
    c.FILE@@: out_cell (cast: (c.FILE@@) (@ c.l2_out))
    char@@@: text_cell (cast: (char@@@) (@ c.l2_uid_text))
    size_t@@: len_cell (cast: (size_t@@) (@ c.l2_uid_len))
    int@: n_cell (cast: (int@) (@ c.l2_uid_n))
    c.LmP0Text: t
    int: k 0
    if: c.fprintf(out_cell[0], "\nfn: l2_ids_load () int\n    @: size_t l2_ids_table 0\n    if: lmx_ids_unit_loaded((@ l2_ids)) != 0\n        return: 0\n    l2_ids_table: (cast: (@: size_t) c.calloc(%dU, c.sizeof(c.size_t)))\n    if: l2_ids_table = 0\n        return: 1\n", n_cell[0] + 1) < 0
        return: (cast: (int) (1))
    while: k < n_cell[0]
        t\data := text_cell[0][k]
        t\length := len_cell[0][k]
        if: c.fprintf(out_cell[0], "    l2_ids_table[%dU]: lmx_ids_code(", k) < 0 || lm_compiler_emit_cstr(@ t) != 0 || c.fprintf(out_cell[0], ", %zuU)\n", len_cell[0][k]) < 0
            return: (cast: (int) (1))
        k := k + 1
    ---
    return: (cast: (int) (c.fprintf(out_cell[0], "    return: lmx_ids_unit_publish((@ l2_ids), l2_ids_table, %dU)\nend: l2_ids_load\n", n_cell[0]) < 0))
end: lm_compiler_emit_unit_ids

# The selector of a named step of a path as the reached operation takes it (IDENTIFIER-CODES; lmx_walk_value_field_place,
# lmx_walk_store_selector): the step's name (its spelling, to be written as its code), the occurrence its written
# `[N]` selects or SIZE_MAX for none, and whether the step is the first name after a callable field (the `[]` the
# selector text used to carry). Read from the written step at translation; nothing parses it at run time; a `[` not
# closed after its digits stays part of the name, as the text selector read it. 0, or 1 for a step without a name.
fn: lm_compiler_path_selector_parts (const: (c.L2Path@: path); int: k; char@@: name; size_t@: name_len; size_t@: selected; int@: prefix) int
    c.L2PathStep@: step 0
    char@: text 0
    size_t: n 0U
    size_t: i 1U
    size_t: v 0U
    if: path = 0 || k < 0 || k >= path\n || name = 0 || name_len = 0 || selected = 0 || prefix = 0
        return: (cast: (int) (1))
    step := path\steps + k
    prefix[0] := (cast: (int) (k > 0 && lm_compiler_path_named_tail(path) = k))
    text := (cast: (char@) (path\text + step\off))
    n := step\len
    selected[0] := (cast: (size_t) -1)
    if: n > 0U && text[0] = 91
        while: i < n && text[i] >= 48 && text[i] <= 57 && v <= ((cast: (size_t) -1) - 9U) / 10U
            v := v * 10U + (cast: (size_t) (text[i] - 48))
            i := i + 1U
        ---
        if: i > 1U && i < n && text[i] = 93
            selected[0] := v
            text := text + i + 1U
            n := n - i - 1U
        ---
    ---
    if: n = 0U
        return: (cast: (int) (1))
    name[0] := text
    name_len[0] := n
    return: (cast: (int) (0))
end: lm_compiler_path_selector_parts

# The statement that stores a named step's selector at the third cell of its OF/PUT_OF frame l2_rw<frame>: the code of
# the name from the unit's table, the selected occurrence, the prefix flag. 0, or 1.
fn: lm_compiler_emit_path_selector (const: (c.L2Path@: path); int: k; int: frame) int
    c.FILE@@: out_cell (cast: (c.FILE@@) (@ c.l2_out))
    char@: name 0
    size_t: name_len 0U
    size_t: selected 0U
    int: prefix 0
    if: lm_compiler_path_selector_parts(path, k, @ name, @ name_len, @ selected, @ prefix) != 0
        return: (cast: (int) (1))
    if: c.fprintf(out_cell[0], "        if: lmx_walk_store_selector(l2_program_arena, l2_rw%d, 2U, ", frame) < 0 || lm_compiler_emit_unit_id((cast: (const: char@) name), name_len) != 0
        return: (cast: (int) (1))
    if: selected = (cast: (size_t) -1)
        return: (cast: (int) (c.fprintf(out_cell[0], ", (cast: (size_t) -1), %d) != c.LMX_WALK_OK\n            return: 1\n", prefix) < 0))
    return: (cast: (int) (c.fprintf(out_cell[0], ", %zuU, %d) != c.LMX_WALK_OK\n            return: 1\n", selected, prefix) < 0))
end: lm_compiler_emit_path_selector

# The three selector arguments of a native field or named place (lmx_walk_value_field_place,
# lmx_walk_value_named_place) for step k of path: `CODE, SELECTED, PREFIX`, the code from the unit's table. 0, or 1.
fn: lm_compiler_emit_selector_args (const: (c.L2Path@: path); int: k) int
    c.FILE@@: out_cell (cast: (c.FILE@@) (@ c.l2_out))
    char@: name 0
    size_t: name_len 0U
    size_t: selected 0U
    int: prefix 0
    if: lm_compiler_path_selector_parts(path, k, @ name, @ name_len, @ selected, @ prefix) != 0 || lm_compiler_emit_unit_id((cast: (const: char@) name), name_len) != 0
        return: (cast: (int) (1))
    if: selected = (cast: (size_t) -1)
        return: (cast: (int) (c.fprintf(out_cell[0], ", (cast: (size_t) -1), %d", prefix) < 0))
    return: (cast: (int) (c.fprintf(out_cell[0], ", %zuU, %d", selected, prefix) < 0))
end: lm_compiler_emit_selector_args

# Static native lifetimes use the runtime's typed borrow list. Raw machine
# functions keep their existing C ABI and consume no extra temporary ids.
fn: lm_compiler_roots_enabled (int: mi) int
    return: (cast: (int) (mi >= 0 && c.lm_compiler_m_machine(mi) = 0))

fn: lm_compiler_roots_name (const: (char@: prefix); int: id; char@: name) int
    int: n
    if: id < 0
        n := c.snprintf(name, 96U, "%s", prefix)
    else:
        n := c.snprintf(name, 96U, "%s%d", prefix, id)
    return: (cast: (int) (n < 0 || n >= 96))

fn: lm_compiler_emit_roots_mark_named (int: mi; const: (char@: ind); const: (char@: arena); const: (char@: prefix); int: id) int
    c.FILE@@: out_cell (cast: (c.FILE@@) (@ c.l2_out))
    c.L2FrontendScratchChar96: storage
    char@: name (cast: (char@) storage\buffer)
    if: lm_compiler_roots_enabled(mi) = 0
        return: 0
    if: lm_compiler_roots_name(prefix, id, name) != 0
        return: 1
    return: (cast: (int) (c.fprintf(out_cell[0], "%s@: LmxExecutionRoots %s lmx_execution_roots_mark(%s)\n", ind, name, arena) < 0))

fn: lm_compiler_emit_roots_restore_named (int: mi; const: (char@: ind); const: (char@: arena); const: (char@: prefix); int: id) int
    c.FILE@@: out_cell (cast: (c.FILE@@) (@ c.l2_out))
    c.L2FrontendScratchChar96: storage
    char@: name (cast: (char@) storage\buffer)
    if: lm_compiler_roots_enabled(mi) = 0
        return: 0
    if: lm_compiler_roots_name(prefix, id, name) != 0
        return: 1
    return: (cast: (int) (c.fprintf(out_cell[0], "%slmx_execution_roots_restore(%s, %s)\n", ind, arena, name) < 0))

fn: lm_compiler_emit_roots_mark (int: mi; const: (char@: ind); const: (char@: arena); int@: id) int
    int@: tn_cell (cast: (int@) (@ c.l2_tn))
    if: id = 0
        return: 1
    \id := -1
    if: lm_compiler_roots_enabled(mi) = 0
        return: 0
    \id := tn_cell[0]
    tn_cell[0] := tn_cell[0] + 1
    return: lm_compiler_emit_roots_mark_named(mi, ind, arena, "l2_gr_mark", \id)

fn: lm_compiler_emit_roots_restore (int: mi; const: (char@: ind); const: (char@: arena); int: id) int
    if: id < 0
        return: 0
    return: lm_compiler_emit_roots_restore_named(mi, ind, arena, "l2_gr_mark", id)

# prefix/id denotes the already declared Value or Value array. Clear before
# attaching an unfilled producer; filled snapshots pass clear=0 instead.
fn: lm_compiler_emit_roots_values (int: mi; const: (char@: ind); const: (char@: arena); const: (char@: prefix); int: id; int: count; int: array; int: clear) int
    c.FILE@@: out_cell (cast: (c.FILE@@) (@ c.l2_out))
    c.L2FrontendScratchChar96: storage
    char@: name (cast: (char@) storage\buffer)
    if: lm_compiler_roots_enabled(mi) = 0 || count <= 0
        return: 0
    if: lm_compiler_roots_name(prefix, id, name) != 0
        return: 1
    if: clear != 0
        if: array != 0
            if: c.fprintf(out_cell[0], "%sc.memset((cast: (@: void) %s), 0, %dU * c.sizeof(c.LmxWalkValue))\n", ind, name, count) < 0
                return: 1
            ---
        else:
            if: c.fprintf(out_cell[0], "%slmx_walk_value_clear(@ %s)\n", ind, name) < 0
                return: 1
        ---
    ---
    if: c.fprintf(out_cell[0], "%sLmxExecutionRoots: l2_gr_%s\n%slmx_execution_roots_push(%s, @ l2_gr_%s, (cast: (@: void) ", ind, name, ind, arena, name) < 0
        return: 1
    if: array = 0 && c.fputs("(@ ", out_cell[0]) < 0
        return: 1
    if: c.fputs(name, out_cell[0]) < 0
        return: 1
    if: array = 0 && c.fputs(")", out_cell[0]) < 0
        return: 1
    return: (cast: (int) (c.fprintf(out_cell[0], "), %dU, 0, 0U, 0, 0)\n", count) < 0))

fn: lm_compiler_emit_roots_held (int: mi; const: (char@: ind); const: (char@: arena); const: (char@: prefix); int: id) int
    c.FILE@@: out_cell (cast: (c.FILE@@) (@ c.l2_out))
    c.L2FrontendScratchChar96: storage
    char@: name (cast: (char@) storage\buffer)
    if: lm_compiler_roots_enabled(mi) = 0
        return: 0
    if: lm_compiler_roots_name(prefix, id, name) != 0
        return: 1
    return: (cast: (int) (c.fprintf(out_cell[0], "%sLmxExecutionRoots: l2_gh_%s\n%slmx_execution_roots_push(%s, @ l2_gh_%s, 0, 0U, 0, 0U, (cast: (@: void) %s), 0)\n", ind, name, ind, arena, name, name) < 0))

fn: lm_compiler_lp_control_index () int
    int@: count_cell (cast: (int@) (@ c.l2_lp_n))
    int@@: kinds (cast: (int@@) (@ c.l2_lpk))
    int: i count_cell[0] - 1
    while: i >= 0
        if: kinds[0][i] != 2
            return: i
        i := i - 1
    return: -1
end: lm_compiler_lp_control_index

# Lexical scopes borrow a suffix of the existing activation binding vector.
# Truncation never restores a larger count after a nonlocal exit.
fn: lm_compiler_emit_bindings_mark (int: mi; const: (char@: ind); int@: id) int
    int@: tn_cell (cast: (int@) (@ c.l2_tn))
    c.FILE@@: output (cast: (c.FILE@@) (@ c.l2_out))
    id[0] := -1
    if: lm_compiler_roots_enabled(mi) = 0
        return: 0
    id[0] := tn_cell[0]
    tn_cell[0] := tn_cell[0] + 1
    return: (cast: (int) (c.fprintf(output[0], "%s@: LmxActivation l2_binding_act%d (cast: (@: LmxActivation) l2_call_arena\\activation)\n%ssize_t: l2_binding_count%d 0U\n%sif: l2_binding_act%d != 0\n%s    l2_binding_count%d: l2_binding_act%d\\nbind\n%s---\n", ind, id[0], ind, id[0], ind, id[0], ind, id[0], id[0], ind) < 0))
end: lm_compiler_emit_bindings_mark

fn: lm_compiler_emit_bindings_restore (int: mi; const: (char@: ind); int: id) int
    c.FILE@@: output (cast: (c.FILE@@) (@ c.l2_out))
    if: id < 0 || lm_compiler_roots_enabled(mi) = 0
        return: 0
    return: (cast: (int) (c.fprintf(output[0], "%sif: l2_binding_act%d != 0 && l2_binding_act%d\\nbind > l2_binding_count%d\n%s    l2_binding_act%d\\nbind: l2_binding_count%d\n%s---\n", ind, id, id, id, ind, id, id, ind) < 0))
end: lm_compiler_emit_bindings_restore

fn: lm_compiler_emit_bindings_exit (int: mi; const: (char@: ind); int: kind; int: id) int
    int@: count_cell (cast: (int@) (@ c.l2_lp_n))
    int@@: kinds (cast: (int@@) (@ c.l2_lpk))
    int@@: places (cast: (int@@) (@ c.l2_lpp))
    int: i count_cell[0] - 1
    int: target -1
    while: i >= 0 && target < 0
        if: kinds[0][i] = kind && places[0][i] = id
            target := i
        i := i - 1
    ---
    if: target < 0
        return: 0
    i := target + 1
    while: i < count_cell[0]
        if: kinds[0][i] = 2
            return: lm_compiler_emit_bindings_restore(mi, ind, places[0][i])
        i := i + 1
    return: 0
end: lm_compiler_emit_bindings_exit

fn: lm_compiler_emit_roots_loop_restore (int: mi; const: (char@: ind); int: kind; int: id) int
    if: id < 0
        return: 0
    if: lm_compiler_emit_bindings_exit(mi, ind, kind, id) != 0
        return: 1
    if: kind = 1
        return: lm_compiler_emit_roots_restore_named(mi, ind, "l2_call_arena", "l2_pad_roots", id)
    return: lm_compiler_emit_roots_restore(mi, ind, "l2_call_arena", id)

# Most expression producers belong to the current typed method. Keep the
# machine gate in the common helper, including producers without a mi input.
fn: lm_compiler_emit_roots_current_value (const: (char@: ind); const: (char@: prefix); int: id) int
    int@: mi_cell (cast: (int@) (@ c.l2_cur_mi))
    return: lm_compiler_emit_roots_values(mi_cell[0], ind, "l2_call_arena", prefix, id, 1, 0, 0)

fn: lm_compiler_emit_roots_place (int: mi; const: (char@: ind); const: (char@: prefix); int: id) int
    c.FILE@@: out_cell (cast: (c.FILE@@) (@ c.l2_out))
    c.L2FrontendScratchChar96: storage
    char@: name (cast: (char@) storage\buffer)
    if: lm_compiler_roots_enabled(mi) = 0
        return: 0
    if: lm_compiler_roots_name(prefix, id, name) != 0
        return: 1
    return: (cast: (int) (c.fprintf(out_cell[0], "%sLmxExecutionRoots: l2_gp_%s\n%slmx_execution_roots_push(l2_call_arena, @ l2_gp_%s, 0, 0U, 0, 0U, 0, (cast: (@: void) (@ %s)))\n", ind, name, ind, name, name) < 0))
