predef: "l3_interp/l3_exec.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_own.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# N4-N8 smoke. Not admission.

sub: fail (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: fail

fn: mk_return (@: LmxArena a) @: Lmx
    @: Lmx stmt
    @: LmxOp op
    stmt: lmx_node_new_owned(a)
    op: lmx_op_new_owned(a, c.LMX_OP_RETURN)
    if: stmt = 0 || op = 0
        return: 0
    if: lmx_arena_refs_open_owned(a, stmt, 1U) != 0
        return: 0
    lmx_arena_ref_store(stmt, 0U, (cast: (@: void) op))
return: stmt

fn: mk_return_int (@: LmxArena a; int: n) @: Lmx
    @: Lmx stmt
    @: LmxOp op
    @: void cell
    stmt: lmx_node_new_owned(a)
    op: lmx_op_new_owned(a, c.L3_NODE_RETURN)
    cell: lmx_int_new_owned(a)
    if: stmt = 0 || op = 0 || cell = 0
        return: 0
    if: lmx_arena_refs_open_owned(a, stmt, 2U) != 0
        return: 0
    lmx_int_store_known(cell, n)
    lmx_arena_ref_store(stmt, 0U, (cast: (@: void) op))
    lmx_arena_ref_store(stmt, 1U, cell)
return: stmt

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: arena
    @: LmxArena a 0
    @: Lmx m 0
    @: Lmx inner 0
    @: Lmx stmt 0
    @: LmxCallable info 0
    @: LmxCallable info2 0
    @: LmxMethod meth 0
    @: void cell 0
    @: void cell2 0
    L3Result: rr
    @: L3Result prr
    size_t: i 0U
    if: counts = 0
        return: 2
    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        fputs("l3_02: arena\n", l1_stdout())
        free(counts)
        return: 2
    ---
    a: @ arena
    prr: @ rr
    meth: lmx_method_new_owned(a)
    fail(counts, meth != 0, "native METHOD cell")

    # METHOD in slot 0 is not L3 (N4).
    m: lmx_node_new_owned(a)
    if: m = 0 || lmx_arena_refs_open_owned(a, m, 1U) != 0
        free(counts)
        return: 2
    ---
    lmx_arena_ref_store(m, 0U, (cast: (@: void) meth))
    fail(counts, l3_exec_run(a, m) = c.L3_UNSUPPORTED, "N4 METHOD.addr is not L3")

    # Callable + return in body (N4 N5 N6).
    info: lmx_callable_new_owned(a)
    stmt: mk_return(a)
    m: lmx_node_new_owned(a)
    if: info = 0 || stmt = 0 || m = 0 || lmx_arena_refs_open_owned(a, m, 2U) != 0
        free(counts)
        return: 2
    ---
    info\method: meth
    lmx_arena_ref_store(m, 0U, (cast: (@: void) info))
    lmx_arena_ref_store(m, 1U, (cast: (@: void) stmt))
    memset((cast: (@: void) (@ rr)), 0, c.sizeof(c.L3Result))
    fail(counts, l3_exec_run_on(a, m, 0, prr) = c.L3_OK, "N5/N6 return: in body after slot 0")
    fail(counts, prr\present = 0, "void return has no value")

    info: lmx_callable_new_owned(a)
    m: lmx_node_new_owned(a)
    if: info = 0 || m = 0 || lmx_arena_refs_open_owned(a, m, 2U) != 0
        free(counts)
        return: 2
    ---
    info\method: meth
    lmx_arena_ref_store(m, 0U, (cast: (@: void) info))
    lmx_arena_ref_store(m, 1U, (cast: (@: void) mk_return_int(a, 7)))
    memset((cast: (@: void) (@ rr)), 0, c.sizeof(c.L3Result))
    fail(counts, l3_exec_run_on(a, m, 0, prr) = c.L3_OK, "N6 return argument is read")
    fail(counts, prr\present != 0 && prr\value = 7, "N6 returned int 7")

    # Nested call then return (N7).
    info2: lmx_callable_new_owned(a)
    inner: lmx_node_new_owned(a)
    if: info2 = 0 || inner = 0 || lmx_arena_refs_open_owned(a, inner, 2U) != 0
        free(counts)
        return: 2
    ---
    info2\method: meth
    lmx_arena_ref_store(inner, 0U, (cast: (@: void) info2))
    lmx_arena_ref_store(inner, 1U, (cast: (@: void) mk_return(a)))
    m: lmx_node_new_owned(a)
    if: m = 0 || lmx_arena_refs_open_owned(a, m, 3U) != 0
        free(counts)
        return: 2
    ---
    lmx_arena_ref_store(m, 0U, (cast: (@: void) info))
    lmx_arena_ref_store(m, 1U, (cast: (@: void) inner))
    lmx_arena_ref_store(m, 2U, (cast: (@: void) mk_return(a)))
    fail(counts, l3_exec_run(a, m) = c.L3_OK, "N7 nested callable then return")

    # Dirty-only (N8): write publishes; clean does not restore.
    cell: lmx_int_new_owned(a)
    cell2: lmx_int_new_owned(a)
    info: lmx_callable_new_owned(a)
    m: lmx_node_new_owned(a)
    if: cell = 0 || cell2 = 0 || info = 0 || m = 0 || lmx_arena_refs_open_owned(a, m, 3U) != 0
        free(counts)
        return: 2
    ---
    lmx_int_store_known(cell, 1)
    lmx_int_store_known(cell2, 99)
    info\method: meth
    lmx_arena_ref_store(m, 0U, (cast: (@: void) info))
    lmx_arena_ref_store(m, 1U, cell)
    lmx_arena_ref_store(m, 2U, (cast: (@: void) mk_return(a)))
    fail(counts, l3_exec_run(a, m) = c.L3_OK, "N8 run with own int")
    fail(counts, lmx_int_value_known(cell) = 1, "N8 clean own not flushed over")

    # Dirty assign publishes. Data Structure with a nested return is not a body.
    info: lmx_callable_new_owned(a)
    m: lmx_node_new_owned(a)
    cell: lmx_int_new_owned(a)
    cell2: lmx_int_new_owned(a)
    stmt: lmx_node_new_owned(a)
    if: info = 0 || m = 0 || cell = 0 || cell2 = 0 || stmt = 0
        free(counts)
        return: 2
    ---
    if: lmx_arena_refs_open_owned(a, m, 4U) != 0 || lmx_arena_refs_open_owned(a, stmt, 3U) != 0
        free(counts)
        return: 2
    ---
    lmx_int_store_known(cell, 1)
    lmx_int_store_known(cell2, 99)
    info\method: meth
    lmx_arena_ref_store(stmt, 0U, (cast: (@: void) lmx_op_new_owned(a, c.L3_NODE_ASSIGN)))
    lmx_arena_ref_store(stmt, 1U, lmx_int_new_owned(a))
    lmx_int_store_known(lmx_arena_ref_value(stmt, 1U), 1)
    lmx_arena_ref_store(stmt, 2U, cell2)
    lmx_arena_ref_store(m, 0U, (cast: (@: void) info))
    lmx_arena_ref_store(m, 1U, cell)
    lmx_arena_ref_store(m, 2U, (cast: (@: void) stmt))
    lmx_arena_ref_store(m, 3U, (cast: (@: void) mk_return(a)))
    fail(counts, l3_exec_run(a, m) = c.L3_OK, "N8 assign")
    fail(counts, lmx_int_value_known(lmx_arena_ref_value(m, 1U)) = 99, "N8 dirty own published")

    inner: lmx_node_new_owned(a)
    info: lmx_callable_new_owned(a)
    m: lmx_node_new_owned(a)
    if: inner = 0 || info = 0 || m = 0
        free(counts)
        return: 2
    ---
    if: lmx_arena_refs_open_owned(a, inner, 1U) != 0 || lmx_arena_refs_open_owned(a, m, 3U) != 0
        free(counts)
        return: 2
    ---
    lmx_arena_ref_store(inner, 0U, (cast: (@: void) mk_return(a)))
    info\method: meth
    lmx_arena_ref_store(m, 0U, (cast: (@: void) info))
    lmx_arena_ref_store(m, 1U, (cast: (@: void) inner))
    lmx_arena_ref_store(m, 2U, (cast: (@: void) mk_return_int(a, 3)))
    memset((cast: (@: void) (@ rr)), 0, c.sizeof(c.L3Result))
    fail(counts, l3_exec_run_on(a, m, 0, prr) = c.L3_OK && prr\value = 3, "data Structure is not a body")

    # Child returns 3, parent returns 7: parent result must survive.
    info2: lmx_callable_new_owned(a)
    inner: lmx_node_new_owned(a)
    info: lmx_callable_new_owned(a)
    m: lmx_node_new_owned(a)
    if: info2 = 0 || inner = 0 || info = 0 || m = 0
        free(counts)
        return: 2
    ---
    if: lmx_arena_refs_open_owned(a, inner, 2U) != 0 || lmx_arena_refs_open_owned(a, m, 3U) != 0
        free(counts)
        return: 2
    ---
    info2\method: meth
    info\method: meth
    lmx_arena_ref_store(inner, 0U, (cast: (@: void) info2))
    lmx_arena_ref_store(inner, 1U, (cast: (@: void) mk_return_int(a, 3)))
    lmx_arena_ref_store(m, 0U, (cast: (@: void) info))
    lmx_arena_ref_store(m, 1U, (cast: (@: void) inner))
    lmx_arena_ref_store(m, 2U, (cast: (@: void) mk_return_int(a, 7)))
    memset((cast: (@: void) (@ rr)), 0, c.sizeof(c.L3Result))
    fail(counts, l3_exec_run_on(a, m, 0, prr) = c.L3_OK && prr\present != 0 && prr\value = 7, "parent return survives child")

    stmt: lmx_node_new_owned(a)
    info: lmx_callable_new_owned(a)
    m: lmx_node_new_owned(a)
    if: stmt = 0 || info = 0 || m = 0
        free(counts)
        return: 2
    ---
    if: lmx_arena_refs_open_owned(a, stmt, 3U) != 0 || lmx_arena_refs_open_owned(a, m, 2U) != 0
        free(counts)
        return: 2
    ---
    lmx_arena_ref_store(stmt, 0U, (cast: (@: void) lmx_op_new_owned(a, c.L3_NODE_RETURN)))
    cell: lmx_int_new_owned(a)
    cell2: lmx_int_new_owned(a)
    if: cell = 0 || cell2 = 0
        free(counts)
        return: 2
    ---
    lmx_int_store_known(cell, 1)
    lmx_int_store_known(cell2, 2)
    lmx_arena_ref_store(stmt, 1U, cell)
    lmx_arena_ref_store(stmt, 2U, cell2)
    info\method: meth
    lmx_arena_ref_store(m, 0U, (cast: (@: void) info))
    lmx_arena_ref_store(m, 1U, (cast: (@: void) stmt))
    fail(counts, l3_exec_run(a, m) = c.L3_UNSUPPORTED, "return arity more than one fails")

    # GROK-L3-FRAME-32: 65 own ints, exact scratch slice, dirty last field.
    info: lmx_callable_new_owned(a)
    m: lmx_node_new_owned(a)
    stmt: lmx_node_new_owned(a)
    if: info = 0 || m = 0 || stmt = 0
        free(counts)
        return: 2
    ---
    if: lmx_arena_refs_open_owned(a, m, 68U) != 0 || lmx_arena_refs_open_owned(a, stmt, 3U) != 0
        free(counts)
        return: 2
    ---
    info\method: meth
    lmx_arena_ref_store(m, 0U, (cast: (@: void) info))
    i: 1U
    while: i < 66U
        cell: lmx_int_new_owned(a)
        if: cell = 0
            free(counts)
            return: 2
        ---
        lmx_int_store_known(cell, 0)
        lmx_arena_ref_store(m, i, cell)
        i: i + 1U
    ---
    cell2: lmx_int_new_owned(a)
    if: cell2 = 0
        free(counts)
        return: 2
    ---
    lmx_int_store_known(cell2, 99)
    lmx_arena_ref_store(stmt, 0U, (cast: (@: void) lmx_op_new_owned(a, c.L3_NODE_ASSIGN)))
    lmx_arena_ref_store(stmt, 1U, lmx_int_new_owned(a))
    lmx_int_store_known(lmx_arena_ref_value(stmt, 1U), 65)
    lmx_arena_ref_store(stmt, 2U, cell2)
    lmx_arena_ref_store(m, 66U, (cast: (@: void) stmt))
    lmx_arena_ref_store(m, 67U, (cast: (@: void) mk_return(a)))
    fail(counts, l3_exec_run(a, m) = c.L3_OK, "65 own ints run")
    fail(counts, lmx_int_value_known(lmx_arena_ref_value(m, 1U)) = 0, "65: clean own 1 unpublished")
    fail(counts, lmx_int_value_known(lmx_arena_ref_value(m, 65U)) = 99, "65: dirty own 65 published")

    # Child scratch rewind must leave parent owns writable.
    info2: lmx_callable_new_owned(a)
    inner: lmx_node_new_owned(a)
    info: lmx_callable_new_owned(a)
    m: lmx_node_new_owned(a)
    stmt: lmx_node_new_owned(a)
    if: info2 = 0 || inner = 0 || info = 0 || m = 0 || stmt = 0
        free(counts)
        return: 2
    ---
    if: lmx_arena_refs_open_owned(a, inner, 42U) != 0 || lmx_arena_refs_open_owned(a, m, 5U) != 0 || lmx_arena_refs_open_owned(a, stmt, 3U) != 0
        free(counts)
        return: 2
    ---
    info2\method: meth
    lmx_arena_ref_store(inner, 0U, (cast: (@: void) info2))
    i: 1U
    while: i < 41U
        cell: lmx_int_new_owned(a)
        if: cell = 0
            free(counts)
            return: 2
        ---
        lmx_int_store_known(cell, 4)
        lmx_arena_ref_store(inner, i, cell)
        i: i + 1U
    ---
    lmx_arena_ref_store(inner, 41U, (cast: (@: void) mk_return(a)))
    info\method: meth
    cell: lmx_int_new_owned(a)
    cell2: lmx_int_new_owned(a)
    if: cell = 0 || cell2 = 0
        free(counts)
        return: 2
    ---
    lmx_int_store_known(cell, 1)
    lmx_int_store_known(cell2, 77)
    lmx_arena_ref_store(m, 0U, (cast: (@: void) info))
    lmx_arena_ref_store(m, 1U, cell)
    lmx_arena_ref_store(m, 2U, (cast: (@: void) inner))
    lmx_arena_ref_store(stmt, 0U, (cast: (@: void) lmx_op_new_owned(a, c.L3_NODE_ASSIGN)))
    lmx_arena_ref_store(stmt, 1U, lmx_int_new_owned(a))
    lmx_int_store_known(lmx_arena_ref_value(stmt, 1U), 1)
    lmx_arena_ref_store(stmt, 2U, cell2)
    lmx_arena_ref_store(m, 3U, (cast: (@: void) stmt))
    lmx_arena_ref_store(m, 4U, (cast: (@: void) mk_return(a)))
    fail(counts, l3_exec_run(a, m) = c.L3_OK, "parent owns after child rewind")
    fail(counts, lmx_int_value_known(lmx_arena_ref_value(m, 1U)) = 77, "parent dirty own published after child rewind")

    if: counts[1] != 0
        c.printf("%d failed of %d\n", counts[1], counts[0])
        free(counts)
        return: 1
    ---
    c.printf("l3_02: %d checks\n", counts[0])
    free(counts)
return: 0
