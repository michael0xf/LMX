fn: lm_compiler_intern_prove (const: (@: path char); const: (@: source_node c.LmP0Node)) int
    @: cell_m_n int (cast: (@: int) (@ c.l2_m_n))
    @@: cell_m_sig unsigned (cast: (@@: unsigned) (@ c.l2_m_sig))
    @: cell_intern_again unsigned (cast: (@: unsigned) (@ c.l2_intern_again))
    @: cell_alloc_err int (cast: (@: int) (@ c.l2_alloc_err))
    @: cell_intern_swap unsigned (cast: (@: unsigned) (@ c.l2_intern_swap))
    @@: cell_m_arity int (cast: (@@: int) (@ c.l2_m_arity))
    @@@: cell_m_f0 c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_m_f0))
    @@@: cell_m_f1 c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_m_f1))
    @: cell_intern_probe unsigned (cast: (@: unsigned) (@ c.l2_intern_probe))
    @: cell_sigv unsigned (cast: (@: unsigned) (@ c.l2_sigv))
    unsigned: id
    int: two
    if: c.lm_compiler_mul3_ok(2U, 3U, 4U) = 0
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "intern broken")))
    if: c.lm_compiler_mul3_ok((cast: (size_t) -1), 2U, 1U) != 0
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "intern broken")))
