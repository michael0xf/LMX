# Pending source fixture: Parts is DATA and uses ready Pattern references.
# Expected: all predicates are 1; all inputs denote the same Parts container.
Parts:
    asciiLetter
    asciiDigit

[]: arrayParts Parts
@: referenceParts Parts
(matches(utf8Text("a5"); sequence(patterns := Parts)); matches(utf8Text("5"); choice(patterns := arrayParts)); matches(utf8Text("a"); choice(patterns := referenceParts)))
