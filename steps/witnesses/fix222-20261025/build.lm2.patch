  fn: lm_p0_node_structure (const: @(LmP0Node node)) const: @: LmP0Structure\n    fn: lm_p0_node_frame (const: @(LmP0Node node)) const: @: LmP0Frame\n    fn: lm_p0_node_atom (const: @(LmP0Node node)) const: @: LmP0Text\n", f) < 0
+        return: 1
+    if: c.fputs("    fn: lm_p0_structure_trailer (const: @(LmP0Structure structure)) const: @: LmP0Trailer\n    fn: lm_p0_frame_head (const: @(LmP0Frame frame)) const: @: LmP0Text\n    fn: lm_p0_frame_body (const: @(LmP0Frame frame)) const: @: LmP0Structure\n    fn: lm_p0_frame_trailer (const: @(LmP0Frame frame)) const: @: LmP0Trailer\n    fn: lm_p0_trailer_spelling (const: @(LmP0Trailer trailer)) const: @: LmP0Text\n    fn: lm_p0_trailer_body (const: @(LmP0Trailer trailer)) const: @: LmP0Structure\n    fn: lm_p0_node_kind_class_name (LmP0NodeKind: kind) const: @: char\n    fn: lm_p0_dump_alloc (const: @(LmP0Document document)) @: char\n    fn: lm_p0_free (@: void ptr) void\nend: prototype\n", f) < 0
