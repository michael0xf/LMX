-    @: void actual 0
-    size_t: count 0U
-    size_t: ordinal 0U
-    size_t: first 0U
-    size_t: last 0U
-    size_t: n 0U
-    size_t: i 0U
-    size_t: j 0U
-    size_t: previous 0U
-    int: moving 0
-    int: status
-    if: f = 0 || code = 0 || firsts = 0 || order = 0 || code\array.size < 3U
