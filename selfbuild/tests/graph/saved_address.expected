---
    Observed:
        int: first 5
        int: second 7
    end: Observed
---
int: i
@: p int (@ i)
:=: i 5
int: first (\ p)
:=: i 7
int: second (\ p)
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ first) first
    :=: ((shared \ Observed) \ second) second
end: main
main:
