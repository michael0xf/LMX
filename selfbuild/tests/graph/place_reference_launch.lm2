# M11 5v: p/q are initialized in own data and launch the same ordinary
# Structures from main and its nested function. The results remain 320/3/20.
sub: main () (
    Model:
        int: v 1
        v := v + 1
    Add:
        v := v + 10
    D:
        int: v 0
    @: p Model
    @: q Add
    int: seen 0
    int: model_v 0
    int: d_v 0
)
    p()
    q(D)
    fn: f () int
        p()
        q(data := D)
        return: Model\v * 100 + D\v
    seen := f()
    model_v := Model\v
    d_v := D\v
main()
int: seen main\data\seen
int: model_v main\data\model_v
int: d_v main\data\d_v
@: observed_p main\data\p
@: observed_q main\data\q
