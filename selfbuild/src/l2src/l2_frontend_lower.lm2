        ---
        if: lm_compiler_scan_head(source_node, mi, seen) != 0
            return: (cast: (int) (1))
        # A call of a callable formal arrives here: its actuals are its projection too.
        return: (cast: (int) (lm_compiler_scan_actuals_value(source_node, value, mi, seen)))
    return: (cast: (int) (0))
end: lm_compiler_scan_node_value

