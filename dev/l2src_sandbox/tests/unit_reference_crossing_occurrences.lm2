Model: (int: x 11; int: x 12)
Holder: (@: Model ref)
Candidate: (int: pad 19; int: x 20; int: x 30)
Holder\ref: Candidate
fn: check () int
    if: Holder\ref\x != 30 || Holder\ref\[0]x != 20 || Holder\ref\[1]x != 30
        return: 81
    if: @Holder\ref\[0]x != @Candidate\[0]x || @Holder\ref\x != @Candidate\x
        return: 82
    Holder\ref\[0]x: 41
    Holder\ref\x: 61
    if: Candidate\[0]x != 41 || Candidate\x != 61 || Candidate\pad != 19
        return: 83
    if: Model\[0]x != 11 || Model\x != 12
        return: 84
return: 7
sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
