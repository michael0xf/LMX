fn: read () int
    Outer:
        int: pad 17
        Inner:
            int: x 11
        end: Inner
        @: Inner ref
    end: Outer
    Candidate:
        int: pad 99
        int: x 20
    end: Candidate
    Outer\ref: Candidate
    if: Outer\ref != Candidate
        return: 81
    if: @Outer\ref\x != @Candidate\x
        return: 81
    Outer\ref\x: 31
    if: Candidate\x != 31 || Candidate\pad != 99 || Outer\Inner\x != 11 || Outer\pad != 17
        return: 81
    return: Candidate\x
end: read
int: ok 7
if: read() != 31
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
