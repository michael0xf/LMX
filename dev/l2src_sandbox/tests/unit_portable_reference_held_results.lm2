# Same held scalar widths and independent CHAR result lifetimes, using source
# literals supported by the retained graph (no machine cast interpretation).
fn: makeS (size_t: n) fn: (size_t: x) size_t
    fn: addS (size_t: x) size_t
        return: x + n
    return: addS

fn: makeU (unsigned: n) fn: (unsigned: x) unsigned
    fn: addU (unsigned: x) unsigned
        return: x + n
    return: addU

fn: makeL (ulong: n) fn: (ulong: x) ulong
    fn: addL (ulong: x) ulong
        return: x + n
    return: addL

fn: makeC (char: n) fn: (char: x) char
    fn: pickC (char: x) char
        if: x = 'a'
            return: n
        return: x
    return: pickC

s5: makeS 4294967296U
u5: makeU 5U
l5: makeL 5U
char: expectedChar 'A'
pc: makeC expectedChar
size_t: a (s5: 1U)
unsigned: b (u5: 4000000000U)
ulong: c (l5: 1U)
char: d (pc: 'a')
char: e (pc: 'b')
int: ok 0
if: a = 4294967297U && b = 4000000005U && c = 6U && d = expectedChar && e = 'b'
    ok: 7
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
