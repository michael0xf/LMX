# Correct the derivative-filter feedback sign in a separate generated build view.
# Vendor PID.c remains byte-for-byte at its pinned upstream commit.
set(_pid_source "${LMX_CONTROL_VENDOR}/pid/PID.c")
file(SHA256 "${_pid_source}" _pid_source_hash)
if(NOT _pid_source_hash STREQUAL "19a7b4c1f721489fc3cc8718c2487633ac75e9c3dbaec30400cec43e568b3f85")
    message(FATAL_ERROR "PID.c differs from the reviewed snapshot; re-review the derivative fix")
endif()
file(READ "${_pid_source}" _pid_source_text)
set(_pid_old "+ (2.0f * pid->tau - pid->T) * pid->differentiator)")
set(_pid_new "- (2.0f * pid->tau - pid->T) * pid->differentiator)")
string(FIND "${_pid_source_text}" "${_pid_old}" _pid_match)
if(_pid_match EQUAL -1)
    message(FATAL_ERROR "PID derivative replacement anchor not found")
endif()
string(REPLACE "${_pid_old}" "${_pid_new}" _pid_build_text "${_pid_source_text}")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated/pid")
set(LMX_PID_BUILD_SOURCE "${CMAKE_CURRENT_BINARY_DIR}/generated/pid/PID.c")
file(WRITE "${LMX_PID_BUILD_SOURCE}" "${_pid_build_text}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_pid_source}")
