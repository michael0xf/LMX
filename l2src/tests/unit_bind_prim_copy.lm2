# OPUS-TYPED-BINDING-20260930-20, next_core_tasks.md §3 item 207: the primitive control: `int: j i` copies i -- a later write to j
# leaves i 5.  Entry 7.
fn: m () int
    int: out 0
    int: i 5
    int: j i
    j: 7
    if: i = 5
        out: j
    return: out
end: m

sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
