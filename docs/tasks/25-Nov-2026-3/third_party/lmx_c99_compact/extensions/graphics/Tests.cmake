foreach(_gfx_test IN ITEMS image_roundtrips jpeg_decoders gui_commands sokol_headless)
    add_executable(lmx_graphics_test_${_gfx_test} "${_gfx_root}/tests/${_gfx_test}.c")
    lmx_c99_target(lmx_graphics_test_${_gfx_test})
    if(_gfx_test STREQUAL "sokol_headless")
        # DUMMY is private test code, never a public library/archive or aggregate.
        target_sources(lmx_graphics_test_${_gfx_test} PRIVATE "${_gfx_root}/src/sokol_core.c" "${_gfx_root}/src/sokol_util.c")
        _gfx_sokol_common(lmx_graphics_test_${_gfx_test} DUMMY_BACKEND)
    else()
        target_link_libraries(lmx_graphics_test_${_gfx_test} PRIVATE LMX::graphics)
    endif()
    target_compile_definitions(lmx_graphics_test_${_gfx_test} PRIVATE
        LMX_GRAPHICS_FIXTURES="${_gfx_root}/tests/fixtures")
    add_test(NAME graphics.${_gfx_test} COMMAND lmx_graphics_test_${_gfx_test})
endforeach()
if(TARGET LMX::stb)
    target_link_libraries(lmx_graphics_test_image_roundtrips PRIVATE LMX::stb)
    target_compile_definitions(lmx_graphics_test_image_roundtrips PRIVATE LMX_GRAPHICS_HAVE_STB_IMAGE=1)
endif()
add_executable(lmx_graphics_test_sokol_renderer "${_gfx_root}/tests/sokol_renderer_link.c")
lmx_c99_target(lmx_graphics_test_sokol_renderer)
target_link_libraries(lmx_graphics_test_sokol_renderer PRIVATE LMX::sokol)
add_test(NAME graphics.sokol_renderer_link COMMAND lmx_graphics_test_sokol_renderer)
