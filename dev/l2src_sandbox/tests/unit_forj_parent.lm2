# Body may assign parent field acc directly; last assigned 9. Not an L1 C-block claim.
fn: mytest () int
    int: acc 0
    for: int(i, 0) (i < 10) i++
        int: j i
        acc: j
    end: for
    c.printf: "%d\n" acc
    return: 0
end: mytest
sendMessage: exit(exit_code: mytest(); stdout: ""; stderr: "")
return
