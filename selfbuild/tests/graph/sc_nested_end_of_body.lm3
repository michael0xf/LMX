# Entry Main: the end of the body of a Structure creates no `return` (the book #return-in-data). D describes a
# block of two places; C writes node\seen and ends. The call answers 5 where its value is consumed and the effect
# stands: D\seen 1, result 0.
@: result 0
D:
    int: seen 0
    return:
        int: first
        int: second
    end: return
    C:
        node\seen := 1
    end: C
end: D
---
Main:
    node\result := D\C()
