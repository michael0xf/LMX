# Autofill fills the callee's own place (§6.1): it reads 5, writes 9 into its own cell; the caller keeps 5.
(
    Observed:
        int: seen 0
)
@: shared data[0]
fn: callee (int: x) int
    int: before x
    x := 9
    return: before * 10 + x
fn: caller () int
    int: x 5
    int: r callee()
    return: x * 100 + r
sub: main ()
    shared\Observed\seen := caller()
main()
