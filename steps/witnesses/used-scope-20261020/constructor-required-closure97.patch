+# Constructor reception needs the same required-type closure as an executed
+# reception, even when candidate and requirement are identical. Prepare it
+# before sealing, through the common catalog, without inventing an identity
+# candidate row or permitting a late field/name search in either backend.
+fn: l2_reference_seed_plan (int: req; int: target) int
+    L2D105Catalog: catalog
+    if: req < 0 || target < 0
+        return: 0
+    memset((cast: (@: void) @ catalog), 0, c.sizeof(c.L2D105Catalog))
+    if: l2_d105_catalog_add(@ catalog, target, req) != 0
+        return: 1
+return: l2_d105_catalog_close(@ catalog)
+
