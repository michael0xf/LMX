# Typed language operands must use the same pre-operation checks as free operands.
fn: left (unsigned: value; int: count) unsigned
    return: value << count
end: left
fn: right (unsigned: value; int: count) unsigned
    return: value >> count
end: right
fn: signed_left (int: value; int: count) int
    return: value << count
end: signed_left
fn: wide_left (size_t: value; int: count) size_t
    return: value << count
end: wide_left
fn: nested (unsigned: value; int: count) unsigned
    return: 1U | value << count
end: nested
fn: run () int
    unsigned: got 0U
    int: signed_got 0
    size_t: wide 0U
    size_t: wide_value 1U
    if: left(3U, 2) != 12U || right(12U, 2) != 3U
        return: 80
    ---
        got: left(1U, 32)
        catch: interpreter ()
            got: 99U
    ---
    if: got != 99U
        return: 81
    got: 0U
    ---
        got: right(1U, 0 - 1)
        catch: interpreter ()
            got: 99U
    ---
    if: got != 99U
        return: 82
    ---
        signed_got: signed_left(1073741824, 1)
        catch: interpreter ()
            signed_got: 99
    ---
    if: signed_got != 99
        return: 83
    signed_got: 0
    ---
        signed_got: signed_left(0 - 1, 1)
        catch: interpreter ()
            signed_got: 99
    ---
    if: signed_got != 99
        return: 84
    wide: wide_left(wide_value, 40)
    if: wide != 1099511627776U
        return: 85
    ---
        wide: wide_left(wide_value, 64)
        catch: interpreter ()
            wide: 99U
    ---
    if: wide != 99U
        return: 86
    if: nested(3U, 2) != 13U
        return: 87
    got: 0U
    ---
        got: nested(1U, 32)
        catch: interpreter ()
            got: 99U
    ---
    if: got != 99U
        return: 88
    return: 7
end: run
sendMessage: exit(exit_code: run(); stdout: ""; stderr: "")
return
