# A composite holding a path takes the conversion edge of its type: `v: P\v + 1U` gives a size_t to an int v -- a
# conversion, whose receiver this program has no row for.  Before, the composite was untyped and C converted.
P:
    size_t: v 6U
fn: m () int
    int: v 0
    v: P\v + 1U
    return: v

sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
