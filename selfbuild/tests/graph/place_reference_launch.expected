sub: main () (
    Model:
        int: v 1
        :=: v (v + 1)
    end: Model
    Add: (:= v (v + 10))
    D:
        int: v 0
    end: D
    @: p Model
    @: q Add
    int: seen 0
    int: model_v 0
    int: d_v 0
)
    p:
    q: D
    fn: f () int
        p:
        q: (:= data D)
        return: (((Model \ v) * 100) + (D \ v))
    end: f
    :=: seen ((f))
    :=: model_v (Model \ v)
    :=: d_v (D \ v)
end: main
main:
int: seen 320
int: model_v 3
int: d_v 20
@: observed_p Model
@: observed_q Add
