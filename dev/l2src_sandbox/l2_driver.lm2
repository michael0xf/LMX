            chunk: chunk\next
        ---
        pool: pool\next
    ---
    return: total
end: shape_arena_cells

# Explicit owner of the former four argv-bounded C VLAs. The original matcher
# returns through this one cleanup; successful-path assertions stay in the body.
fn: shape_check (@: arena c.LmxArena; @: graph c.Lmx; @: settings c.Lmx) int
    @: gargc_cell int (cast: (@: int) (@ c.gargc))
    size_t: capacity (cast: (size_t) gargc_cell[0])
    @@: stack_box c.Lmx 0
    @: stack_at size_t 0
    @: stack_lim size_t 0
    @@: seen_node void 0
    int: status 0
    if: gargc_cell[0] <= 0 || capacity > c.SIZE_MAX / sizeof(@: c.Lmx) || capacity > c.SIZE_MAX / c.sizeof(c.size_t) || capacity > c.SIZE_MAX / sizeof(@: void)
        check((cast: (int) (0)), "shape observation capacity cannot be allocated")
        c.abort()
    ---
    stack_box: (cast: (@@: c.Lmx) c.malloc(capacity * sizeof(@: c.Lmx)))
    stack_at: (cast: (@: size_t) c.malloc(capacity * c.sizeof(c.size_t)))
    stack_lim: (cast: (@: size_t) c.malloc(capacity * c.sizeof(c.size_t)))
    seen_node: (cast: (@@: void) c.malloc(capacity * sizeof(@: void)))
    if: stack_box = 0 || stack_at = 0 || stack_lim = 0 || seen_node = 0
        c.free(stack_box)
        c.free(stack_at)
        c.free(stack_lim)
        c.free(seen_node)
        check((cast: (int) (0)), "shape observation storage allocation failed")
        c.abort()
    ---
    status: shape_check_body(arena, graph, settings, capacity, stack_box, stack_at, stack_lim, seen_node)
    c.free(stack_box)
    c.free(stack_at)
    c.free(stack_lim)
    c.free(seen_node)
    return: status
end: shape_check

sub: check (int: ok; const: (@: label char))
