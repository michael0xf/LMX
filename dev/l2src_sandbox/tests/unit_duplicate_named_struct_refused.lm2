# A second `Model:` + fields meets the binding Model the first declared: by general resolution (book §9 :559-:561;
# the author, Q54: a closer such as `end: Model` declares nothing) it is the assignment of that Structure to Model
# with admission, by name (Q39, D-105) -- and Model's field value has no field of that name in it: refused by
# admission (OPUS-Q54-CONTINUE-20260929-14; was "duplicate named Structure", then "assignment target must be...").
Model:
    size_t: value 1U
end: Model

Model:
    size_t: other 2U
end: Model

return: 0
