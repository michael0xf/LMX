# Literal and dynamic writes resolve the same data place as reads, length,
# whole-descriptor address and element address. The inline if has no shadow
# place: replacing its Array descriptor remains visible after the body.
fn: check () int
    []: int values 3
    size_t: i 1U
    values[0]: 11
    values[i]: 17
    @: outer void values
    if: 1
        []: int values 4
        values[0]: 23
        values[i]: 29
        if: length(values) != 4U || values[0] != 23 || values[1] != 29
            return: 81
        @: first int @values[0]
        if: values = outer || \first != 23
            return: 82
    ---
    if: length(values) != 4U || values[0] != 23 || values[1] != 29 || values = outer
        return: 83
return: 7
sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
