# K03 (Codex K03-NS-ROLES-NEXT-20261007-09, -07 Q2): a qualified branch's root is a named callable definition of
# the unit, visible throughout the unit both ways -- for every reader of it (a merge operand, a reference binding),
# not only a field path.
# A method above the branch merges it: R\e is 7.  Exit 7; 81 otherwise.
fn: m () size_t
    R: merge: cfg
    return: R\e
independent:
    const:
        immutable:
            (): cfg
                size_t: e 7U
            end: cfg
        end: immutable
    end: const
end: independent
fn: go () int
    if: m() != 7U
        return: 81
    return: 7
end: go
sendMessage: exit(exit_code: go(); stdout: ""; stderr: "")
return
