+fn: numeric_holds (@: cell void; int: ty; int: want) int
+    if: ty = c.LMX_TYPE_SIZE_T && c.lmx_size_value_known(cell) = (cast: (size_t) want)
+        return: 1
+    if: ty = c.LMX_TYPE_INT && c.lmx_int_value_known(cell) = want
+        return: 1
+    if: ty = c.LMX_TYPE_UNSIGNED && c.lmx_unsigned_value_known(cell) = (cast: (unsigned) want)
+        return: 1
+    if: ty = c.LMX_TYPE_ULONG && c.lmx_ulong_value_known(cell) = (cast: (ulong) want)
+        return: 1
+    return: 0
+end: numeric_holds
