# Probe 345: a named actual whose tail is a vertical block of two written fields (y: 7, unused: 1) for the Structure
# formal p of take, then the named q: 72 + 3 = 73 is the norm of the structural tail.
Point:
    int: y 0
    int: unused 0
end: Point
fn: take (Point: p; int: q 2) int
    return: p\y * 10 + q
end: take
int: r take(
    p:
        y: 7
        unused: 1
    end: p
    q: 3
)
