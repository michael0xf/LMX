Example:
    int[]: items
    int: start
    int: end
    int[]: replacement
    return: @
    run:
        int[]: result []
        sys\resize(result; length(items))
        int: i 0
        while: i < length(items)
            if: i >= start && i < end
                result[i] := replacement[i - start]
            else:
                result[i] := items[i]
            i += 1
        return: result
