Leaf:
    int: value
    return: int
    total:
        return: value

Pair:
    @: left
    @: right
    return: int
    total:
        return: left\total() + right\total()
    demo:
        @: a derive(Leaf; (int: value 2))
        @: b derive(Leaf; (int: value 3))
        @: c derive(Leaf; (int: value 5))
        @: inner derive(Pair; (@: left b; @: right c))
        @: tree derive(Pair; (@: left a; @: right inner))
        return: tree\total()
