predef: "lmx_ref.lm1"
predef: "lmx_pool.lm1"
predef: "lmx_arena.lm1"
predef: "lmx_array_owned.lm1"
predef: "lmx_value_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

fn: main () int
    @: LmxArray first
    @: LmxArray second
    @: LmxArray alias
    @: LmxArray handed_back
    @: int backing_a
    @: int backing_b
    @: Lmx node
    @: Lmx other
    @: Lmx returned
    @: int got
    int: failures
    LmxArena: arena
    failures: 0

    got: (cast: (@: int) calloc(1U, c.sizeof(got[0])))
    if: got = 0
        fputs("lmx: allocation failed\n", l1_stdout())
        return: 1
    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        fputs("lmx: arena open failed\n", l1_stdout())
        return: 1
    node: lmx_node_new_owned(@ arena)
    other: lmx_node_new_owned(@ arena)
    first: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_INT, 3U, @ arena)
    second: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_INT, 3U, @ arena)
    if: node = 0 || other = 0 || first = 0 || second = 0
        fputs("lmx: descriptor handout failed\n", l1_stdout())
        return: 1
    backing_a: (cast: (@: int) first\array.data)
    backing_b: (cast: (@: int) second\array.data)
    backing_a[0]: 10
    backing_a[1]: 20
    backing_a[2]: 30
    backing_b[0]: 70
    backing_b[1]: 80
    backing_b[2]: 90

    # Passing copies the reference, not the referent. The callee sees the very
    # same descriptor, so no clone happened on the way in.
    handed_back: lmx_ref_rebind_local(first, first)
    if: handed_back != first
        fputs("lmx: passing a descriptor cloned it\n", l1_stdout())
        failures: failures + 1

    # Rebinding the callee's local reference does not reach the caller.
    handed_back: lmx_ref_rebind_local(first, second)
    if: handed_back != second
        fputs("lmx: callee could not rebind its own reference\n", l1_stdout())
        failures: failures + 1
    if: first = second
        fputs("lmx: callee rebinding moved the caller's reference\n", l1_stdout())
        failures: failures + 1
    if: first\array.data != (cast: (@: void) backing_a)
        fputs("lmx: callee rebinding changed the caller's referent\n", l1_stdout())
        failures: failures + 1

    # A write through the reference reaches the shared referent, and is visible
    # through every other reference to the same storage.
    alias: first
    if: lmx_ref_write_through(first, 1U, 99) != 0
        fputs("lmx: write through the reference failed\n", l1_stdout())
        failures: failures + 1
    if: lmx_ref_read(alias, 1U, got) != 0 || got[0] != 99
        fputs("lmx: write not visible through a second reference\n", l1_stdout())
        failures: failures + 1
    if: backing_a[1] != 99
        fputs("lmx: write did not reach the actual element storage\n", l1_stdout())
        failures: failures + 1
    if: backing_b[1] != 80
        fputs("lmx: write reached the wrong array\n", l1_stdout())
        failures: failures + 1

    # Bounds are refused rather than wrapped or clamped.
    if: lmx_ref_write_through(first, 3U, 1) = 0
        fputs("lmx: out of range write accepted\n", l1_stdout())
        failures: failures + 1

    # An operation that replaces the descriptor's own storage mutates the
    # REFERENT, so it is visible through every holder - the opposite case to
    # rebinding a local reference.
    if: lmx_ref_restore_storage(first, 3U, (cast: (@: void) backing_b)) != 0
        fputs("lmx: storage replacement failed\n", l1_stdout())
        failures: failures + 1
    if: alias\array.data != (cast: (@: void) backing_b)
        fputs("lmx: referent mutation not seen through the alias\n", l1_stdout())
        failures: failures + 1
    if: lmx_ref_restore_storage(first, 3U, (cast: (@: void) backing_a)) != 0
        fputs("lmx: storage restore failed\n", l1_stdout())
        failures: failures + 1
    if: lmx_ref_restore_storage(first, 2U, (cast: (@: void) backing_b)) = 0 || first\array.size != 3U || first\array.data != (cast: (@: void) backing_a)
        fputs("lmx: fixed Array replacement changed its length or accepted a resize\n", l1_stdout())
        failures: failures + 1

    # The same two rules for a Structure occurrence. Each Structure gets its
    # own one-slot child array -- an array of the arena like every other -- and the
    # Array reference is the value stored in the slot, not a payload hanging off the
    # header (SPEC 2, ABI 3.3).
    if: lmx_arena_refs_open_owned(@ arena, node, 1U) != 0 || lmx_arena_refs_open_owned(@ arena, other, 1U) != 0
        fputs("lmx: structure slots failed\n", l1_stdout())
        return: 1
    if: lmx_arena_ref_store(node, 0U, (cast: (@: void) first)) != 0 || lmx_arena_ref_store(other, 0U, (cast: (@: void) second)) != 0
        fputs("lmx: structure child store failed\n", l1_stdout())
        return: 1
    returned: lmx_ref_repoint_local(node, other)
    if: returned != other
        fputs("lmx: callee could not repoint its own node reference\n", l1_stdout())
        failures: failures + 1
    if: node = other
        fputs("lmx: callee repointing moved the caller's node reference\n", l1_stdout())
        failures: failures + 1
    if: lmx_ref_get_field(node, 0U) != (cast: (@: void) first)
        fputs("lmx: callee repointing changed the caller's node field\n", l1_stdout())
        failures: failures + 1

    if: lmx_ref_set_field(node, 0U, (cast: (@: void) second)) != 0
        fputs("lmx: field write through the reference failed\n", l1_stdout())
        return: 1
    if: lmx_ref_get_field(node, 0U) != (cast: (@: void) second)
        fputs("lmx: field write through the reference did not reach the node\n", l1_stdout())
        failures: failures + 1
    if: lmx_range_classify(@ arena, lmx_ref_get_field(node, 0U)) != c.LMX_KIND_ARRAY
        fputs("lmx: rebound child lost its classification\n", l1_stdout())
        failures: failures + 1
    # A slot address is STORAGE, not a value: it classifies as the slot array's own storage
    # (KIND_CHILDREN) and never as the Array child stored in it, which is classified on its
    # own value above.  This is the settled reading now that the slot array is an array of
    # the arena like every other ("ЧЕМ МАССИВЫ ОТЛИЧАЮТСЯ ОТ ВСЕГО ОСТАЛЬНОГО? НИЧЕМ!!!",
    # Mikhail, 2026-09-17): the legacy variant's slot array was in no arena, so its address
    # classified as nothing at all and the check below read NONE.
    if: lmx_range_classify(@ arena, cast: (@: void) lmx_arena_ref_cell(node, 0U)) != c.LMX_KIND_CHILDREN
        fputs("lmx: a slot address is not classified as slot storage\n", l1_stdout())
        failures: failures + 1
    if: node\array.size != 1U
        fputs("lmx: rebinding a child changed the field count\n", l1_stdout())
        failures: failures + 1

    # Headers, backing and field slots all belong to the actual arena. No
    # raw C descriptor or unregistered heap node stands in for a graph value.
    free(got)
    lmx_arena_release(@ arena)

    if: failures != 0
        c.printf("lmx ref selftest FAILED checks=%d\n", failures)
        return: 1
    fputs("lmx ref selftest ok\n", l1_stdout())
    return: 0
