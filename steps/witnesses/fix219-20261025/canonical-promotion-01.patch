+    @: LmP0Structure children 0
+    int: count
+    if: span = 0 || span\node = 0 || span\node\as = 0
+        return: 1
+    if: span\node\kind = c.LM_P0_NODE_STRUCTURE
+        children: span\node\as\structure
+    if: span\node\kind = c.LM_P0_NODE_FRAME && span\node\as\frame != 0 && (l2_prefix_frame(span\node) != 0 || l2_frame_head(span\node, "@") != 0)
+        children: span\node\as\frame\body
+    ---
+    count: l2_count_active(children)
+    if: count > 0
+        span\values: l2_value_fields(children\first_field, count, @ span\value_n)
+        if: span\values = 0
+            return: 1
+        ---
+    ---
+return: l2_primary_prepare(span)
