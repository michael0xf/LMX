int: calls 0
fn: touch () int
    :=: (node \ calls) ((node \ calls) + 1)
    return: 0
end: touch
sub: Writer () (
    @: p int (data [] (touch))
    int: seen 0
)
    @: p int (data [] 1)
    :=: seen (\ p)
end: Writer
