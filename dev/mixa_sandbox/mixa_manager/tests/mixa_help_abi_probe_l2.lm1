# ABI parity guard — L1 port of mixa_help_abi_probe_l2.c (ticket 20260918-082421).
# offsetof is a C macro with no L1 spelling (c. pastes a call, not a preprocessor
# name). Field offsets are computed at run time via pointer arithmetic on a local
# store (same pattern as l2src/lmx_message_selftest.lm1). Output format strings
# are kept byte-identical to the C probe so L2-vs-real parity still diffs stdout.
predef: "mixa_manager/mixa_help_l2.h.lm1"
include: "<stdio.h>"

fn: main () int
    MixaHelpCtx: store0
    @: MixaHelpCtx p0
    p0: @ store0

    c.printf("MixaHelpCtx sizeof=%zu\n", c.sizeof(c.MixaHelpCtx))
    c.printf("MixaHelpCtx console_file=%zu\n", (cast: (size_t) @ p0\console_file) - (cast: (size_t) p0))
    c.printf("MixaHelpCtx last_status=%zu\n", (cast: (size_t) @ p0\last_status) - (cast: (size_t) p0))
    return: 0

