# An end trailer closes two levels inside a method's multi-line data argument.
# The same fields must survive construction, interpreted execution and both emitted modes.
fn: main () int (
    Outer:
        Inner:
            int: x 4
    end: Outer
    int: y 2
    int: result 0
)
    result := Outer\Inner\x + y
    return: result
int: result main()
int: stored main\data\result
