fn: lm_compiler_d105_catalog (int: req; @: source c.L2ReferenceSource; int: tmi; int: tk; int: full_receiver; @: catalog c.L2D105Catalog) int
    @: d105s_n_cell int (cast: (@: int) (@ c.l2_d105s_n))
    @@: d105s_mi_cell int (cast: (@@: int) (@ c.l2_d105s_mi))
    @@: d105s_k_cell int (cast: (@@: int) (@ c.l2_d105s_k))
    @@: d105s_ty_cell int (cast: (@@: int) (@ c.l2_d105s_ty))
    @@: ide_ty_cell int (cast: (@@: int) (@ c.l2_ide_ty))
    @: d105t_n_cell int (cast: (@: int) (@ c.l2_d105t_n))
    @@: d105t_req_cell int (cast: (@@: int) (@ c.l2_d105t_req))
    int: i 0
    int: first 0
    int: count 0
    @: row c.L2D105CatalogRow
    @: plan c.L2D105Plan
    @: step c.L2D105Step
    int: target
    if: catalog = 0 || source = 0 || req = -1
        return: (cast: (int) (1))
    c.memset((cast: (@: void) catalog), 0, c.sizeof(c.L2D105Catalog))
    if: lm_compiler_d105_catalog_require(catalog, req) != 0
        return: (cast: (int) (1))
    if: source\schema != -1 && lm_compiler_d105_catalog_add(catalog, (cast: (int) (source\schema)), req) != 0
        return: (cast: (int) (1))
    while: i < d105s_n_cell[0]
        if: source\method >= 0 && d105s_mi_cell[0][i] = source\method && d105s_k_cell[0][i] = source\place && lm_compiler_d105_refused(tmi, tk, d105s_ty_cell[0][i]) = 0
            if: lm_compiler_d105_catalog_add(catalog, d105s_ty_cell[0][i], req) != 0
                return: (cast: (int) (1))
            ---
        ---
        i: i + 1
    ---
    if: lm_compiler_identity_list(req, source, tmi, tk, full_receiver, @ first, @ count) != 0
        return: (cast: (int) (1))
    i: 0
    while: i < count
        if: lm_compiler_d105_catalog_add(catalog, ide_ty_cell[0][first + i], req) != 0
            return: (cast: (int) (1))
        i: i + 1
    ---
    # A completed reception is runtime evidence even across an opaque door.
    # Retain possible bridges from every receiving schema already present in
    # the program's finite pair inventory. These rows authorize no value:
    # the common resolver may use one only after finding an actual bound
    # correspondence. Pair planning retains the same typed field projection.
    if: lm_compiler_d105_dynamic(source) != 0
        i: 0
        while: i < d105t_n_cell[0]
            target: d105t_req_cell[0][i]
            i: i + 1
            if: c.lm_compiler_schema_kind(target) = 1 || c.lm_compiler_schema_kind(target) = 2
                if: lm_compiler_d105_catalog_add(catalog, target, req) != 0
                    return: (cast: (int) (1))
                ---
            ---
        ---
    ---
    if: lm_compiler_d105_catalog_close(catalog) != 0
        return: (cast: (int) (1))
    # A retained declaration is also an ordinary graph-copy dependency.
    # Note it in every source planning phase, not only while filling bytes.
    row: catalog\required_first
    while: row != 0
        plan: row\plan
        i: 0
        while: i < plan\width
            const: (@: port_steps c.L2D105StepDynamicArray (cast: (const: @: c.L2D105StepDynamicArray) (@ plan\steps)))
            step: port_steps\data + i
            const: (@: port_requirement c.L2SchemaField (cast: (const: @: c.L2SchemaField) (@ step\requirement)))
            target: port_requirement\pointee
            if: port_requirement\kind = 10 && target >= 0 && lm_compiler_use_model_role(target, 2) != 0
                return: (cast: (int) (1))
            i: i + 1
        ---
        row: row\next
    ---
    return: (cast: (int) (0))
