# ARRAY / INDEXED EXPRESSION ALGORITHMS, tensor contract v0.4, 2026-11-27.
# Preparation supplies ordinary LMX structures, real method references and
# original contexts. It consumes the parsed graph; this is not a new parser.
# These are source algorithms over checked contexts, not an implemented host
# binder or C import. Production parser/translator/runtime execution: NOT_RUN.
# Ordinary operators are elementwise. [op] chooses its whole contract; explicit
# [op rules] chooses the shared indexed plan. The kernel and reducer differ.
# Explicit depth 0 selects all logical axes, positive d selects d outer axes.
# Positive d above the actual Array rank is invalid. The selected base entry
# receives each cell without restarting automatic Array mapping.
# An absent depth remains absent. Structure/[]@ and text use their actual types;
# typed-record access never implies blind recursive pointer dereferencing.
# Invalid axes/shape/depth/fuse plans are translator/interpreter diagnostics.
# Reached numerical, callback and admission failures retain ordinary throws.

# One output loop for ordinary maps, explicit-depth maps, indexed maps/reductions,
# and the supported fresh-result fuse plan. count counts output applications.
FxArrayExpressionFill:
    private:
        @: context
        @: target
        @: cell
        int: count
        int: store 1
        @: writer FxSeqStore\write
        int: validate 1
    required: context target cell count
    return: @
    fill:
        throws: copy(FxThrows\sequencefixture)
        if: store != 0 && validate != 0
            FxSeqInfo\get(target)
        private: int: i 0
        while: i < count
            private: @: value FxApply\apply(cell; FxTwo\make(context; (i record)))
            if: store != 0
                FxApply\apply(operation := writer; args := (target; (i record); value))
            i += 1
        return: target

# Allocation is the existing full-type Array/Structure construction boundary.
# It constructs valid backing directly for the complete prepared TypeRef; it
# must not allocate an invalid empty shaped Array and resize/retag it later.
# layout describes actual result storage, never an invented row-object tree.
# allocate is a real method in the ordinary context, not a runtime name lookup.
FxArrayResultTree:
    private:
        @: context
        @: layout
    required: context layout
    return: @
    make:
        throws: copy(FxThrows\sequencefixture)
        return: FxApply\apply(operation := context\allocate; args := (context; layout))

FxArrayBuild:
    private:
        @: context
        @: cell
    required: context cell
    return: @
    build:
        throws: copy(FxArrayResultTree\make\throws)
        private: @: out FxArrayResultTree\make(context; context\layout)
        return: FxArrayExpressionFill\fill(context := context; target := out; cell := cell; count := context\count; writer := context\write; validate := 0)

# Each input describes iterated Array access or one original scalar/held value.
# A held Array is passed whole; it does not join frame matching. read(map,index)
# obtains a scalar or cell through actual storage/context without row copies.
FxArrayInputsAt:
    private:
        @: context
        int: index
        @: reader FxSeqRead\read
    required: context index
    return: @
    at:
        throws: copy(FxThrows\sequencefixture)
        private: @: values FxSeqAllocate\make([]@; length(context\inputs))
        private: int: j 0
        while: j < length(context\inputs)
            private: @: input context\inputs[j]
            private: @: value input\value
            if: input\iterate != 0
                value := FxApply\apply(reader; FxTwo\make(input\value; (index record)))
            values[j] := value
            j += 1
        return: values

FxArrayElementCell:
    private:
        @: context
        int: index
    required: context index
    return: @
    at:
        throws: copy(FxArrayInputsAt\at\throws)
        return: FxApply\apply(context\kernel; FxArrayInputsAt\at(context; index; reader := context\read))

FxArrayElementwise:
    private: @: context
    required: context
    return: @
    apply:
        throws: copy(FxArrayElementCell\at\throws)
        if: context\singleResult != 0
            return: FxArrayElementCell\at(context; 0)
        return: FxArrayBuild\build(context; FxArrayElementCell\at)

# The context selects the actual base entry, not its automatic Array wrapper.
# Zero means maximum traversal, not whole argument. Positive d traverses exactly
# d outer axes and preserves the remaining cell. Its base contract must admit
# that cell: an unsupported row does not fall back to another implicit Map.
# This affects this selected invocation; explicit calls inside the method retain
# their own ordinary contracts. Whole [op] without a modifier remains whole.
FxArrayDepthBase:
    private:
        @: context
        @: inputs
    required: context inputs
    return: @
    apply:
        throws: copy(FxThrows\sequencefixture)
        if: context\hasResult = 0
            FxApply\apply(context\base; inputs)
            return: context
        return: FxApply\apply(context\base; inputs)

FxArrayDepthCell:
    private:
        @: context
        int: index
    required: context index
    return: @
    at:
        throws: copy(FxThrows\sequencefixture)
        private: @: inputs FxArrayInputsAt\at(context; index; reader := context\read)
        return: FxArrayDepthBase\apply(context\root; inputs)

FxArrayDepth:
    private:
        @: context
        int: depth
        @: inputs
    required: context depth inputs
    return: @
    apply:
        throws: copy(FxThrows\sequencefixture)
        private: @: frame FxApply\apply(operation := context\frame; args := (context; (depth record); inputs))
        if: frame\singleResult != 0
            return: FxArrayDepthBase\apply(context; FxArrayInputsAt\at(frame; 0; reader := frame\read))
        frame\root := context
        if: context\hasResult = 0
            return: FxArrayExpressionFill\fill(frame; context; FxArrayDepthCell\at; frame\count; 0)
        return: FxArrayBuild\build(frame; FxArrayDepthCell\at)

# One indexed executor for every [op rules], not an implementation per symbol.
# term(context,output,reduction) follows the common prepared coordinate map:
# binary => kernel over mapped actuals; unary reduction => one reached value.
# The ordinary context holds real term/reduce/start/mapToState/finish methods.
# Frame and reduction axes are linearized in the declared lexicographic order.
# i:j contracts; i=j matches without summing; i*j combines independent axes.
# A missing axisRules chooses a whole profile; present empty rules are outer.
# No reduced axes means one term and no reducer, seed or fake one-element fold.
FxArrayFoldState:
    int: present 0
    @: value

FxArrayIndexedCell:
    private:
        @: context
        int: index
    required: context index
    return: @
    at:
        throws: copy(FxThrows\sequencefixture)
        if: context\hasReduction = 0
            return: FxApply\apply(operation := context\term; args := (context; (index record); (0 record)))
        private: @: state FxApply\apply(operation := context\start; args := (context; (index record)))
        private: int: k 0
        while: k < context\reductionCount
            if: context\hasStop != 0
                private: @: stopped FxApply\apply(context\stop; FxOne\make(state))
                if: \stopped != 0
                    break
            ---
            private: @: term FxApply\apply(operation := context\term; args := (context; (index record); (k record)))
            if: state\present = 0
                state\value := FxApply\apply(context\mapToState; FxOne\make(term))
                state\present := 1
            else:
                state\value := FxApply\apply(context\reduce; FxTwo\make(state\value; term))
            k += 1
        if: state\present = 0
            return: FxApply\apply(context\empty; FxOne\make(state))
        return: FxApply\apply(context\finish; FxOne\make(state\value))

FxArrayIndexed:
    private: @: context
    required: context
    return: @
    apply:
        throws: copy(FxArrayIndexedCell\at\throws)
        if: context\singleResult != 0
            return: FxArrayIndexedCell\at(context; 0)
        return: FxArrayBuild\build(context; FxArrayIndexedCell\at)

# Whole matmul prepares its automatic axis rules and then reuses this executor.
# No hidden conjugation, singleton-axis broadcast, min/max or GF(2) inference.
FxArrayProduct:
    private: @: context
    required: context
    return: @
    multiply:
        throws: copy(FxArrayIndexed\apply\throws)
        return: FxArrayIndexed\apply(context)

# Initializers are shared methods. context.cloneInitial creates independent
# mutable state when needed; initial is obtained once per source occurrence.
# first starts absent and uses mapToState/admission Z->S on the first term.
# identity/seed/factory all finish S->R even for an empty reduction domain.
FxArrayFirstStart:
    private:
        @: context
        int: index
    required: context index
    return: @
    make:
        return: (copy(FxArrayFoldState))

FxArrayInitialStart:
    private:
        @: context
        int: index
    required: context index
    return: @
    make:
        throws: copy(FxThrows\sequencefixture)
        private: @: state (copy(FxArrayFoldState))
        state\value := FxApply\apply(context\cloneInitial; FxOne\make(context\initial))
        state\present := 1
        return: state

# Ordinary declarations copied into operation contexts; names are library DATA,
# not new primitives or string-dispatched operators. Concrete contexts select
# their start/empty/finish/numeric laws and retain source owner/dynamic binding.
FxArrayIndexDefaults:
    int: hasReduction 0
    int: hasStop 0
    numeric:
        int: reassociate 0
        int: contractFma 0
        int: changePrecision 0
    effects:
        int: repeatEvaluation 0
        int: skipEvaluation 0

FxArrayProductProfile:
    copy(FxArrayIndexDefaults)
    @: start FxArrayInitialStart\make
    @: kernel `*`
    @: reduce `+`

FxArrayMinPlusProfile:
    copy(FxArrayIndexDefaults)
    @: start FxArrayFirstStart\make
    @: kernel `+`
    @: reduce min

FxArrayBooleanProductProfile:
    copy(FxArrayIndexDefaults)
    @: start FxArrayInitialStart\make
    @: kernel `&`
    @: reduce `|`

FxArrayGf2ProductProfile:
    copy(FxArrayIndexDefaults)
    @: start FxArrayInitialStart\make
    @: kernel `&`
    @: reduce `^`

# Capture values, not aliases to changing primitive places. Reference values
# preserve targets. A prepared RHS occurrence is not reevaluated per target.
FxArraySnapshot:
    private: @: source
    required: source
    return: @
    capture:
        throws: copy(FxThrows\sequencefixture)
        FxSeqInfo\get(source)
        private: @: out FxSeqAllocate\make([]@; length(source))
        private: int: i 0
        while: i < length(source)
            private: @: value FxSeqRead\read(source; i)
            out[i] := FxCaptureOne\capture((sys\typeof(value) record); value)
            i += 1
        return: out

# The SAME snapshot/admission/write algorithm serves := and slice .:.
# := requires matching iterated shapes (or an original scalar RHS).
# .: prepares right-aligned broadcast to the already fixed slice shape.
# context.readRhs maps repetition explicitly; all values and admissions finish
# before the first store. Aliases/permutations use this snapshot contract.
# target places are real graph/binding/Array places, never copied variable values.
FxArrayAssignPrepared:
    private:
        @: context
        @: source
    required: context source
    return: @
    assign:
        throws: copy(FxArraySnapshot\capture\throws)
        private: @: captured FxArraySnapshot\capture(source)
        private: @: accepted FxSeqAllocate\make([]@; context\count)
        private: int: i 0
        while: i < context\count
            private: @: value FxApply\apply(operation := context\readRhs; args := (context; captured; (i record)))
            accepted[i] := FxApply\apply(operation := context\admit; args := (context; (i record); value))
            i += 1
        i := 0
        while: i < context\count
            FxApply\apply(operation := context\write; args := (context; (i record); accepted[i]))
            i += 1
        return: context\target

# Minimal fuse accepts only a confirmed Scalar/Map plan with a fresh result.
# The RAW graph retains original demand, errors, types and operation order.
# It has no intermediate Array results; the final result and compact access
# contexts are allowed. The prepared context supplies singleResult and cell;
# FxArrayBuild also consumes layout, allocate, count and write. These fields
# describe the admitted execution, not a promise of all optimizations.
# Reduce, contraction, effects, callbacks and in-place stores require separately
# implemented capabilities. No implicit streaming/partial-write entry exists.
FxFusePrepared:
    private: @: context
    required: context
    return: @
    run:
        throws: copy(FxThrows\sequencefixture)
        if: context\singleResult != 0
            return: FxApply\apply(context\cell; FxTwo\make(context; (0 record)))
        return: FxArrayBuild\build(context; context\cell)

# destination := fuse(expr) and slice .: fuse(expr) obtain the final fresh value
# first, then use FxArrayAssignPrepared. Combining the external store with fuse
# is NOT part of the initial profile and must never change late-error behavior.

# Shared integer matrix power after ordinary square/type/exponent admission.
# The provider is one ordinary context with real identity/copyValue/solve/
# multiply method references; no operation lookup by string is performed.
# Every provider call receives context first, keeps input values unchanged and
# returns a fresh VALUE with the admitted result type and numerical profile.
# identity(context,A), copyValue(context,A), solve(context,A,I),
# multiply(context,left,right) are integration contracts, not hidden helpers.
# They reuse admitted matrix operations; this source does not implement their
# numerical backends. FxApply retains their ordinary callable failure boundary.
# C99-profile int / 2 truncates toward zero, including negative odd values.
# q is never negated and abs(MIN_INT) is never evaluated.
FxMatrixPower:
    private:
        @: context
        @: matrix
        int: exponent
    required: context matrix exponent
    return: @
    power:
        throws: copy(FxApply\apply\throws)
        if: exponent = 0
            return: FxApply\apply(operation := context\identity; args := (context; matrix))
        if: exponent = 1
            return: FxApply\apply(operation := context\copyValue; args := (context; matrix))
        private: @: base matrix
        if: exponent < 0
            private: @: unit FxApply\apply(operation := context\identity; args := (context; matrix))
            base := FxApply\apply(operation := context\solve; args := (context; matrix; unit))
        private: int: q exponent
        private: int: present 0
        private: @: result
        while: q != 0
            if: q % 2 != 0
                if: present = 0
                    result := base
                    present := 1
                else:
                    result := FxApply\apply(operation := context\multiply; args := (context; result; base))
            ---
            q := q / 2
            if: q != 0
                base := FxApply\apply(operation := context\multiply; args := (context; base; base))
        ---
        return: result
