+# One source projection of a selected root OR terminal. This does not adapt
+# syntax,select a name or repeat the step walk. A requirement declaration
+# (root_contract_own) is deliberately NOT a source of the current value:
+# fi/oi retain the actual activation/field identity. 1 is unknown evidence,
+# not permission to invoke a different path resolver.
+fn: l2_reference_record_source (const: @(L2Path path); int: mi; @: L2ReferenceSource out) int
+    int: projected
+    if: out = 0
+        return: 1
+    out\schema: -1
+    out\layout: -1
+    out\method: -1
+    out\place: -1
+    out\path: 0
+    out\origin: 0
+    out\origin_count: 0
+    out\origin_method: -1
+    if: path = 0 || path\fail_why != 0 || path\n < 0
+        return: 1
+    if: path\n > 0
+        projected: l2_reference_path_projection(path, out)
+        # Existing directly selected Structure/payload category,only after
+        # the selected reference/input coordinate had its ordinary priority.
+        if: projected != 0 && (path\leaf_kind = 2 || path\leaf_kind = 3) && path\leaf_model >= 0
+            out\schema: path\leaf_model
+            out\layout: out\schema
+            return: 0
+        return: projected
+    ---
+    if: path\oi >= 0
+        out\schema: l2_own_schema((path\oi))
+        if: l2_source_definition_ns((path\oi)) >= 0
+            out\layout: l2_own_layout((path\oi))
+        out\method: l2_own_mi[path\oi]
+        out\place: l2_d105_own_key((path\oi))
+        return: 0
+    if: path\fi >= 0
+        out\schema: path\ni
+        if: path\res >= 0
+            out\schema: l2_schema_merge((path\res))
+        out\method: mi
+        out\place: path\fi
+        return: 0
+    # Only an original constructor denotes that physical layout. A method,
+    # node or control value is not its return type or a guessed own schema.
+    if: path\root_kind = 0 && path\ni >= 0 && path\res < 0
+        out\schema: path\ni
+        out\layout: path\ni
+        return: 0
+    if: path\res >= 0
+        out\schema: l2_schema_merge((path\res))
+        return: 0
+return: 1
