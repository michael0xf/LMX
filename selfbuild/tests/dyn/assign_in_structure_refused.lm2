# The := slice (the author's correction of 2026-11-07; the book, assign-known): `zz := 5` written in the body of a named
# Structure where no place zz is known declares no field -- it is a statement of the body's procedure, and that write of
# no known place is the refusal at translation (`zz: 5` there would define the field zz).
Holder:
    int: k 1
    zz := 5
end: Holder
int: code 7
if: Holder\k != 1
    code: 81
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
