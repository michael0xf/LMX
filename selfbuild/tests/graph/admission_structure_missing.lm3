# Missing used field refuses admission before entering the callee.
@: Model (int: v 0)
@: Candidate (int: extra 99)
int: calls 0
int: before 0
int: after 0
fn: read (@: value Model) int
    node\calls := node\calls + 1
    return: value\v
end: read
before := 1
int: result read(Candidate)
after := 2
