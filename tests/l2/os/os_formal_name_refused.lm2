# The same formal types under other names: the formal names are part of the method's contract.
os:
    win:
        fn: os_id (int: n) int
            return: n
        end: os_id
    default:
        fn: os_id (int: m) int
            return: m
        end: os_id
end: os
sendMessage: exit(exit_code: os_id(7); stdout: ""; stderr: "")
return
