---
    Observed:
        int: result 6
        int: stored 6
    end: Observed
---
@: shared (data [] 0)
fn: main () int (
    Outer:
        Inner:
            int: x 4
        end: Inner
    end: Outer
    int: y 2
    int: result 0
)
    :=: (data \ result) (((Outer \ Inner) \ x) + y)
    return: (data \ result)
end: main
int: result (main)
int: stored ((main \ data) \ result)
sub: observe ()
    :=: ((shared \ Observed) \ result) result
    :=: ((shared \ Observed) \ stored) stored
end: observe
observe:
