# The same formals in another order: the formal order is part of the method's contract.
os:
    win:
        fn: os_pair (int: n; size_t: k) int
            return: n
        end: os_pair
    default:
        fn: os_pair (size_t: k; int: n) int
            return: n
        end: os_pair
end: os
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
