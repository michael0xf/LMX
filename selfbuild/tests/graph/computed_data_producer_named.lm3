# A written name given a prepared Structure in own data: the bare call reaches the declaration and applies it.
@: D (
    int: here 0
)
fn: outer () int (
    prepared:
        args:
            int: a 2
        return: int
        code: (return: a * 3)
    fn: local prepared
    int: r 0
)
    r := local(a := 3)
    node\D\here := r
    return: r
outer()
