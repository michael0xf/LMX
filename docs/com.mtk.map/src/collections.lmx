MapIteratorCreate:
    @: vector
    int: begin 0
    int: end -1
    int: direction 1
    required: vector
    return: @
    create:
        throws: copy(MapThrows)
        if: end < 0
            end := length(vector)
        if: begin < 0 || end < begin || end > length(vector) || (direction != 1 && direction != -1)
            throw: MapFailure("iterator range")
        @: iterator (copy(MapIteratorModel))
        iterator\values := vector
        iterator\begin := begin
        iterator\end := end
        iterator\direction := direction
        iterator\position := begin
        if: direction < 0
            iterator\position := end
        return: iterator

MapIteratorHasNext:
    @: iterator
    required: iterator
    return: int
    hasNext:
        throws: copy(MapThrows)
        if: iterator\direction > 0
            return: iterator\position < iterator\end
        return: iterator\position > iterator\begin

MapIteratorNext:
    @: iterator
    required: iterator
    return: @
    next:
        throws: copy(MapThrows)
        if: MapIterator\hasNext(iterator) = 0
            return: MapNil
        if: iterator\direction > 0
            @: value MapVector\get(iterator\values; iterator\position)
            iterator\position += 1
            return: value
        iterator\position -= 1
        return: MapVector\get(iterator\values; iterator\position)

MapIteratorReset:
    @: iterator
    required: iterator
    return: @
    reset:
        throws: copy(MapThrows)
        iterator\position := iterator\begin
        if: iterator\direction < 0
            iterator\position := iterator\end
        return: iterator

MapIteratorPrevious:
    @: iterator
    required: iterator
    return: @
    previous:
        throws: copy(MapThrows)
        if: iterator\direction > 0
            if: iterator\position <= iterator\begin
                return: MapNil
            iterator\position -= 1
            return: MapVector\get(iterator\values; iterator\position)
        if: iterator\position >= iterator\end
            return: MapNil
        @: value MapVector\get(iterator\values; iterator\position)
        iterator\position += 1
        return: value

