# the receiver `table` (steps/table-receiver.md §5): unit_s7_prim_cross over its own convert.lm2 whose first
# source table is another one, `other.table` (tests/unit_s7_tbl_named_table.lm2): the conversion asks for the
# table `primitive.convert` by its name, so the second table serves it: Entry 7.

fn: go () int
    int: a 1
    size_t: b 2U
    a: b
    return: a

int: k
k: go()
if: k = 2
    sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
return
