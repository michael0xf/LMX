fn: lm_compiler_contract_formal_here (@: contract c.L2TypeContract; @: out_ty int) int
    @@: foreign_raw_c_cell int (cast: (@@: int) (@ c.l2_foreign_raw_c))
    @: here_mi_cell int (cast: (@: int) (@ c.l2_here_mi))
    int: depth
    int: qualified
    int: resolved_depth
    int: resolved_qualified
    c.LmP0Text: resolved_word
    @: word c.LmP0Text c.lm_compiler_contract_leaf(contract, @ depth, @ qualified)
