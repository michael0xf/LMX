predef: "l2src/lmx_interp.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# lmx_interp_run is the L3 entry: lmx_walk_run over a Structure (k.4: no prepare, no plan,
# no descriptor -- next_core_tasks.md §3 item 9, "nothing beyond the Structure itself").

int: checks 0
int: failures 0
@: Lmx copy_seen_self 0
@: Lmx copy_seen_parent 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

# A callable occurrence under `unit` at `slot` whose body is `return: <value>` (RET over LIT).
fn: mk_int_entry (@: LmxArena ga; @: Lmx roles; @: Lmx unit; size_t: slot; int: value) @: Lmx
    @: Lmx m
    @: Lmx ret
    @: Lmx lit
    m: lmx_walk_plain(ga, unit, 1U)
    if: m = 0 || lmx_arena_ref_store(unit, slot, (cast: (@: void) m)) != 0
        return: 0
    ret: lmx_walk_frame(ga, roles, m, c.LMX_WALK_OP_RET, 2U)
    if: ret = 0 || lmx_arena_ref_store(m, 0U, (cast: (@: void) ret)) != 0
        return: 0
    lit: lmx_walk_frame(ga, roles, ret, c.LMX_WALK_OP_LIT, 2U)
    if: lit = 0 || lmx_arena_ref_store(ret, 1U, (cast: (@: void) lit)) != 0 || lmx_walk_store_int(ga, lit, 1U, value) != c.LMX_WALK_OK
        return: 0
return: m

# A real native entry uses only its selected occurrence and copied lexical tree.
# The two globals observe the call boundary, not any persistent graph metadata.
fn: copied_native_entry (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    @: Lmx self (cast: (@: Lmx) owner)
    @: Lmx lexical_holder lmx_call_node(self)
    @: Lmx target lmx_arena_ref_struct(lexical_holder, 0U)
    copy_seen_self: self
    copy_seen_parent: lexical_holder
    lmx_int_store_known(dest, lmx_int_value_known(lmx_arena_ref_value(target, 0U)) + lmx_int_value_known(lmx_arena_ref_value(self, 0U)))
    \out: dest
return: 0

# Copy a used tree across arenas: applications, cells, lexical parents and repeated
# edges must belong to the destination. Only program-lifetime roles/native entries
# are borrowed. Closing the source must not invalidate the copied execution tree.
fn: check_copy_closed_source (@: LmxArena role_owner; @: Lmx roles; @: LmxWalkContext parent_context) int
    LmxArena: source_arena
    LmxArena: destination_arena
    LmxWalkContext: context
    LmxWalkValue: value
    @: LmxArena source @ source_arena
    @: LmxArena destination @ destination_arena
    @: LmxPool role_pool 0
    @: Lmx unit 0
    @: Lmx target 0
    @: Lmx runner 0
    @: Lmx native_entry 0
    @: Lmx put 0
    @: Lmx put_at 0
    @: Lmx put_lit 0
    @: Lmx ret 0
    @: Lmx add 0
    @: Lmx ret_at 0
    @: Lmx ret_lit 0
    @: Lmx copied 0
    @: Lmx copied_unit 0
    @: Lmx copied_target 0
    @: Lmx copied_native 0
    @: Lmx copied_put 0
    @: Lmx copied_put_at 0
    @: Lmx copied_put_lit 0
    @: Lmx copied_ret 0
    @: Lmx copied_add 0
    @: Lmx copied_ret_at 0
    @: Lmx copied_ret_lit 0
    int: status 0
    int: result 0
    int: isolation_failures
    memset((cast: (@: void) source), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) destination), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context)), 0, c.sizeof(c.LmxWalkContext))
    if: lmx_arena_open(source) != 0 || lmx_arena_open(destination) != 0
        check(0, "cross-arena copy owners open")
        lmx_arena_release(source)
        lmx_arena_release(destination)
        return: 2
    ---
    # The independent program role pool stays alive while the source closes.
    role_pool: lmx_range_pool(role_owner, lmx_arena_ref_value(roles, (cast: (size_t) c.LMX_WALK_OP_RET)))
    if: role_pool = 0 || lmx_pool_seal(role_pool) != 0 || lmx_range_import(source, role_owner) != 0 || lmx_range_import(destination, role_owner) != 0
        check(0, "program roles are sealed and visible to both owners")
        lmx_arena_release(source)
        lmx_arena_release(destination)
        return: 2
    ---
    context.arena: destination
    context.scratch: parent_context\scratch
    context.roles: roles
    unit: lmx_node_new_owned(source)
    if: unit = 0 || lmx_arena_refs_open_owned(source, unit, 4U) != 0
        check(0, "cross-arena source root is built")
        lmx_arena_release(source)
        lmx_arena_release(destination)
        return: 2
    ---
    target: lmx_walk_plain(source, unit, 1U)
    runner: lmx_walk_plain(source, unit, 2U)
    native_entry: lmx_walk_plain(source, unit, 1U)
    put: lmx_walk_frame(source, roles, runner, c.LMX_WALK_OP_PUT, 3U)
    put_at: lmx_walk_frame(source, roles, put, c.LMX_WALK_OP_AT, 3U)
    put_lit: lmx_walk_frame(source, roles, put, c.LMX_WALK_OP_LIT, 2U)
    ret: lmx_walk_frame(source, roles, runner, c.LMX_WALK_OP_RET, 2U)
    add: lmx_walk_frame(source, roles, ret, c.LMX_WALK_OP_ADD, 3U)
    ret_at: lmx_walk_frame(source, roles, add, c.LMX_WALK_OP_AT, 3U)
    ret_lit: lmx_walk_frame(source, roles, add, c.LMX_WALK_OP_LIT, 2U)
    if: target = 0 || runner = 0 || native_entry = 0 || put = 0 || put_at = 0 || put_lit = 0 || ret = 0 || add = 0 || ret_at = 0 || ret_lit = 0
        check(0, "cross-arena source applications are built")
        lmx_arena_release(source)
        lmx_arena_release(destination)
        return: 2
    ---
    native_entry\native: (cast: (LmxEntry) copied_native_entry)
    if: lmx_arena_ref_store(unit, 0U, (cast: (@: void) target)) != 0 || lmx_arena_ref_store(unit, 1U, (cast: (@: void) runner)) != 0 || lmx_arena_ref_store(unit, 2U, (cast: (@: void) target)) != 0 || lmx_arena_ref_store(unit, 3U, (cast: (@: void) native_entry)) != 0 || lmx_walk_store_int(source, target, 0U, 17) != c.LMX_WALK_OK || lmx_walk_store_int(source, native_entry, 0U, 2) != c.LMX_WALK_OK
        check(0, "cross-arena source alias and native state are stored")
        lmx_arena_release(source)
        lmx_arena_release(destination)
        return: 2
    ---
    if: lmx_arena_ref_store(runner, 0U, (cast: (@: void) put)) != 0 || lmx_arena_ref_store(put, 1U, (cast: (@: void) put_at)) != 0 || lmx_arena_ref_store(put, 2U, (cast: (@: void) put_lit)) != 0 || lmx_arena_ref_store(put_at, 1U, (cast: (@: void) target)) != 0 || lmx_walk_store_size(source, put_at, 2U, 0U) != c.LMX_WALK_OK || lmx_walk_store_int(source, put_lit, 1U, 42) != c.LMX_WALK_OK
        check(0, "cross-arena explicit-holder PUT is stored")
        lmx_arena_release(source)
        lmx_arena_release(destination)
        return: 2
    ---
    if: lmx_arena_ref_store(runner, 1U, (cast: (@: void) ret)) != 0 || lmx_arena_ref_store(ret, 1U, (cast: (@: void) add)) != 0 || lmx_arena_ref_store(add, 1U, (cast: (@: void) ret_at)) != 0 || lmx_arena_ref_store(add, 2U, (cast: (@: void) ret_lit)) != 0 || lmx_arena_ref_store(ret_at, 1U, (cast: (@: void) target)) != 0 || lmx_walk_store_size(source, ret_at, 2U, 0U) != c.LMX_WALK_OK || lmx_walk_store_int(source, ret_lit, 1U, 1) != c.LMX_WALK_OK
        check(0, "cross-arena RET over typed operands is stored")
        lmx_arena_release(source)
        lmx_arena_release(destination)
        return: 2
    ---
    status: lmx_graph_copy_owned(runner, source, destination, @ copied)
    check(status = c.LMX_GRAPH_COPY_OK && copied != 0 && copied != runner, "cross-arena runner is copied")
    if: status != c.LMX_GRAPH_COPY_OK || copied = 0
        lmx_arena_release(source)
        lmx_arena_release(destination)
        return: 2
    ---
    copied_unit: copied\parent
    copied_target: lmx_arena_ref_struct(copied_unit, 0U)
    copied_native: lmx_arena_ref_struct(copied_unit, 3U)
    copied_put: lmx_arena_ref_struct(copied, 0U)
    copied_put_at: lmx_arena_ref_struct(copied_put, 1U)
    copied_put_lit: lmx_arena_ref_struct(copied_put, 2U)
    copied_ret: lmx_arena_ref_struct(copied, 1U)
    copied_add: lmx_arena_ref_struct(copied_ret, 1U)
    copied_ret_at: lmx_arena_ref_struct(copied_add, 1U)
    copied_ret_lit: lmx_arena_ref_struct(copied_add, 2U)
    if: copied_unit = 0 || copied_target = 0 || copied_native = 0 || copied_put = 0 || copied_put_at = 0 || copied_put_lit = 0 || copied_ret = 0 || copied_add = 0 || copied_ret_at = 0 || copied_ret_lit = 0
        check(0, "copied applications and lexical tree exist")
        lmx_arena_release(source)
        lmx_arena_release(destination)
        return: 2
    ---
    isolation_failures: failures
    check(copied_unit != unit && (copied_unit\parent) = 0 && lmx_arena_ref_struct(copied_unit, 1U) = copied, "copy owns the complete lexical root")
    check(copied_target != target && (copied_target\parent) = copied_unit && lmx_arena_ref_struct(copied_unit, 2U) = copied_target, "both root aliases name one copied target")
    check(lmx_arena_ref_struct(copied_put_at, 1U) = copied_target && lmx_arena_ref_struct(copied_ret_at, 1U) = copied_target, "both explicit-holder edges name that same copied target")
    check(copied_put != put && copied_put_at != put_at && copied_put_lit != put_lit && copied_ret != ret && copied_add != add && copied_ret_at != ret_at && copied_ret_lit != ret_lit, "all reached application Structures have fresh addresses")
    check((copied_put\parent) = copied && (copied_ret\parent) = copied && (copied_put_at\parent) = copied_put && (copied_put_lit\parent) = copied_put && (copied_add\parent) = copied_ret && (copied_ret_at\parent) = copied_add && (copied_ret_lit\parent) = copied_add, "all copied operand parents are restored")
    check(lmx_arena_ref_value(copied_put, 0U) = lmx_arena_ref_value(put, 0U) && lmx_arena_ref_value(copied_put_at, 0U) = lmx_arena_ref_value(put_at, 0U) && lmx_arena_ref_value(copied_put_lit, 0U) = lmx_arena_ref_value(put_lit, 0U) && lmx_arena_ref_value(copied_ret, 0U) = lmx_arena_ref_value(ret, 0U) && lmx_arena_ref_value(copied_add, 0U) = lmx_arena_ref_value(add, 0U) && lmx_arena_ref_value(copied_ret_at, 0U) = lmx_arena_ref_value(ret_at, 0U) && lmx_arena_ref_value(copied_ret_lit, 0U) = lmx_arena_ref_value(ret_lit, 0U), "all copied applications retain their bare role addresses")
    check(lmx_arena_ref_value(copied_target, 0U) != lmx_arena_ref_value(target, 0U) && lmx_arena_ref_value(copied_put_at, 2U) != lmx_arena_ref_value(put_at, 2U) && lmx_arena_ref_value(copied_ret_at, 2U) != lmx_arena_ref_value(ret_at, 2U) && lmx_arena_ref_value(copied_put_lit, 1U) != lmx_arena_ref_value(put_lit, 1U) && lmx_arena_ref_value(copied_ret_lit, 1U) != lmx_arena_ref_value(ret_lit, 1U), "typed field, index and literal cells are distinct copies")
    check(lmx_arena_ref_value(copied_put_at, 2U) != lmx_arena_ref_value(copied_ret_at, 2U), "two distinct equal index cells do not collapse into one")
    check(lmx_range_home(destination, (cast: (@: void) copied_ret)) = destination && lmx_range_home(destination, (cast: (@: void) copied_put_at)) = destination && lmx_range_home(destination, lmx_arena_ref_value(copied_target, 0U)) = destination, "copied operations and data have destination ownership")
    check(copied_native != native_entry && (copied_native\parent) = copied_unit && (copied_native\native) != 0 && (copied_native\native) = (native_entry\native) && lmx_arena_ref_value(copied_native, 0U) != lmx_arena_ref_value(native_entry, 0U), "native occurrence and state copy while its real implementation stays shared")
    # A broken copy is a failed test setup, not permission to execute dangling
    # source frames. In particular the old sharing mutant must stop here.
    if: failures != isolation_failures
        lmx_arena_release(source)
        lmx_arena_release(destination)
        return: 2
    ---
    status: lmx_interp_apply_value(@ context, copied, 0, 0U, @ value)
    check(status = c.LMX_INTERP_OK && (value.present) != 0 && (value.type) = c.LMX_TYPE_INT && (value.number) = 43, "copied explicit-holder write and RET execute before source release")
    check(lmx_int_value_known(lmx_arena_ref_value(copied_target, 0U)) = 42 && lmx_int_value_known(lmx_arena_ref_value(target, 0U)) = 17, "copied execution changes only its copied target")
    result: lmx_call0(destination, copied_native)
    check(result = 44 && copy_seen_self = copied_native && copy_seen_parent = copied_unit, "real native entry receives copied self and copied lexical parent")
    lmx_int_store_known(lmx_arena_ref_value(copied_target, 0U), 17)
    check(lmx_arena_release(source) = 0, "source owner is released before copied re-execution")
    # No source address is dereferenced or inspected after its owner is released.
    status: lmx_interp_apply_value(@ context, copied, 0, 0U, @ value)
    check(status = c.LMX_INTERP_OK && (value.present) != 0 && (value.type) = c.LMX_TYPE_INT && (value.number) = 43, "copied graph executes after its source owner is released")
    check(lmx_int_value_known(lmx_arena_ref_value(lmx_arena_ref_struct(copied_unit, 2U), 0U)) = 42, "copied alias still observes the explicit-holder write after source release")
    result: lmx_call0(destination, copied_native)
    check(result = 44 && copy_seen_self = copied_native && copy_seen_parent = copied_unit, "real native entry still uses copied self and parent after source release")
    lmx_arena_release(destination)
    copy_seen_self: 0
    copy_seen_parent: 0
return: 0

# A zero-operand application owns a Structure just like an application with
# operands. Its role must not become the first direct child of a plain body.
sub: check_ret_holder (@: LmxArena ga; @: Lmx roles; @: Lmx unit; @: LmxWalkContext context)
    @: Lmx holder lmx_walk_plain(ga, unit, 2U)
    @: Lmx ret 0
    @: Lmx copied 0
    @: Lmx reader 0
    @: Lmx result 0
    @: Lmx read 0
    @: Lmx copied_ret 0
    LmxWalkValue: value
    int: status
    check(holder != 0, "return holder exists")
    if: holder = 0
        return
    ret: lmx_walk_frame(ga, roles, holder, c.LMX_WALK_OP_RET, 1U)
    if: ret = 0 || lmx_arena_ref_store(unit, 3U, (cast: (@: void) holder)) != 0 || lmx_arena_ref_store(holder, 0U, (cast: (@: void) ret)) != 0 || lmx_walk_store_int(ga, holder, 1U, 73) != c.LMX_WALK_OK
        check(0, "return holder is built")
        return
    ---
    status: lmx_graph_copy_owned(holder, ga, ga, @ copied)
    check(status = c.LMX_GRAPH_COPY_OK && copied != 0 && copied != holder, "plain return-first body is copied, not mistaken for code")
    if: copied != 0
        copied_ret: lmx_arena_ref_struct(copied, 0U)
        check(copied_ret != 0 && (copied_ret\array.size) = 1U && lmx_arena_ref_value(copied_ret, 0U) = lmx_arena_ref_value(ret, 0U), "copy retains the owned return application's shape and role")
        check(copied_ret != ret && (copied_ret\parent) = copied, "copy owns its zero-operand return application and parent")
        check(lmx_arena_ref_value(copied, 1U) != lmx_arena_ref_value(holder, 1U) && lmx_int_value_known(lmx_arena_ref_value(copied, 1U)) = 73, "copy retains a distinct typed cell after return")
    ---
    reader: lmx_walk_plain(ga, unit, 1U)
    result: lmx_walk_frame(ga, roles, reader, c.LMX_WALK_OP_RET, 2U)
    read: lmx_walk_frame(ga, roles, result, c.LMX_WALK_OP_AT, 3U)
    if: reader = 0 || result = 0 || read = 0 || lmx_arena_ref_store(unit, 4U, (cast: (@: void) reader)) != 0 || lmx_arena_ref_store(reader, 0U, (cast: (@: void) result)) != 0 || lmx_arena_ref_store(result, 1U, (cast: (@: void) read)) != 0 || lmx_arena_ref_store(read, 1U, (cast: (@: void) holder)) != 0 || lmx_walk_store_size(ga, read, 2U, 1U) != c.LMX_WALK_OK
        check(0, "return-first body read is built")
        return
    ---
    status: lmx_interp_apply_value(context, reader, 0, 0U, @ value)
    check(status = c.LMX_INTERP_OK && (value.present) != 0 && (value.type) = c.LMX_TYPE_INT && (value.number) = 73, "a plain body remains an addressable holder after return")
    # A real graph-side negative control recreates the former generated shape.
    lmx_arena_ref_store(holder, 0U, lmx_arena_ref_value(roles, (cast: (size_t) c.LMX_WALK_OP_RET)))
    status: lmx_interp_apply_value(context, reader, 0, 0U, @ value)
    check(status = c.LMX_INTERP_INVALID, "bare role mutation is rejected as a holder")
    lmx_arena_ref_store(holder, 0U, (cast: (@: void) ret))
end: check_ret_holder

fn: main () int
    LmxArena: arena
    LmxArena: context_arena
    LmxPool: context_cells
    LmxScratch: store
    LmxWalkContext: context
    @: LmxArena ga 0
    @: Lmx roles 0
    @: Lmx unit 0
    @: Lmx m 0
    @: Lmx ret 0
    @: Lmx m7 0
    @: Lmx m0 0
    LmxWalkValue: value
    @: void got 0
    int: present 0
    int: status 0
    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxScratch))
    memset((cast: (@: void) (@ context)), 0, c.sizeof(c.LmxWalkContext))
    if: lmx_arena_open(@ arena) != 0
        fputs("lmx_interp_walk: arena\n", l1_stdout())
        return: 2
    ---
    ga: @ arena
    roles: lmx_walk_roles_open(ga)
    if: lmx_arena_open(@ context_arena) != 0 || lmx_scratch_open(@ store, @ context_arena, @ context_cells, 16U) != c.LMX_SCRATCH_OK
        fputs("lmx_interp_walk: context\n", l1_stdout())
        return: 2
    ---
    context.arena: ga
    context.scratch: @ store
    context.roles: roles
    unit: lmx_node_new_owned(ga)
    if: roles = 0 || unit = 0 || lmx_arena_refs_open_owned(ga, unit, 5U) != 0
        fputs("lmx_interp_walk: unit\n", l1_stdout())
        return: 2
    ---
    m: lmx_walk_plain(ga, unit, 1U)
    if: m = 0 || lmx_arena_ref_store(unit, 0U, (cast: (@: void) m)) != 0
        return: 2
    ---
    ret: lmx_walk_frame(ga, roles, m, c.LMX_WALK_OP_RET, 1U)
    if: ret = 0 || lmx_arena_ref_store(m, 0U, (cast: (@: void) ret)) != 0
        return: 2
    ---
    check(lmx_interp_run(0, m) = c.LMX_INTERP_INVALID, "no context")
    check(lmx_interp_run(@ context, m) = c.LMX_INTERP_OK, "void return through walk")
    # The entry's own result reaches the host through lmx_interp_apply_value: `return: 7` is
    # observed as 7 and `return: 0` as 0; the void return above carries no value.
    m7: mk_int_entry(ga, roles, unit, 1U, 7)
    m0: mk_int_entry(ga, roles, unit, 2U, 0)
    check(m7 != 0 && m0 != 0, "two int entries are built")
    memset((cast: (@: void) (@ value)), 0, c.sizeof(c.LmxWalkValue))
    status: lmx_interp_apply_value(@ context, m7, 0, 0U, @ value)
    got: (value.ref)
    present: (value.present)
    check(status = c.LMX_INTERP_OK && present != 0 && (value.type) = c.LMX_TYPE_INT && (value.number) = 7, "an entry returning 7 is observed as 7")
    status: lmx_interp_apply_value(@ context, m0, 0, 0U, @ value)
    got: (value.ref)
    present: (value.present)
    check(status = c.LMX_INTERP_OK && present != 0 && (value.type) = c.LMX_TYPE_INT && (value.number) = 0, "an entry returning 0 is observed as 0")
    status: lmx_interp_apply_value(@ context, m, 0, 0U, @ value)
    present: (value.present)
    check(status = c.LMX_INTERP_OK && present = 0, "a void return carries no value")
    status: lmx_interp_apply_value(0, m7, 0, 0U, @ value)
    got: (value.ref)
    present: (value.present)
    check(status = c.LMX_INTERP_INVALID && present = 0 && got = 0, "a refusal leaves the value empty")
    check_ret_holder(ga, roles, unit, @ context)
    check(check_copy_closed_source(ga, roles, @ context) = 0, "cross-arena copy and closed-source witness completes")
    if: failures != 0
        c.printf("%d failed of %d\n", failures, checks)
        return: 1
    ---
    c.printf("lmx_interp_walk: %d checks\n", checks)
return: 0
