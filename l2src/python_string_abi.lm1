# C ABI: frozen parser Python-string symbols -> their L2 callables.
predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stddef.h>" "<stdio.h>"

extern: @: Lmx l2_pystr_unit

prototype:
    fn: l2_pystr_boot () int
    fn: l2_pystr_m1 (@: Lmx node; const: @(char text); size_t: length; size_t: start; @: size_t out_end) int
    fn: l2_pystr_m2 (@: Lmx node; const: @(char text); size_t: length; size_t: start) size_t
end: prototype

int: l2_pystr_calls 0

fn: l2_pystr_ensure () void
    if: l2_pystr_unit = 0
        if: c.l2_pystr_boot() != 0 || l2_pystr_unit = 0
            fputs("l2_pystr_boot failed\n", l1_stderr())
---

fn: lm_p0_find_python_string_end (const: @(char text); size_t: length; size_t: start; @: size_t out_end) int
    l2_pystr_ensure()
    l2_pystr_calls: l2_pystr_calls + 1
    return: c.l2_pystr_m1(c.lmx_arena_ref_struct(l2_pystr_unit, 1U), text, length, start, out_end)

fn: lm_p0_skip_python_string_unchecked (const: @(char text); size_t: length; size_t: start) size_t
    l2_pystr_ensure()
    l2_pystr_calls: l2_pystr_calls + 1
    return: c.l2_pystr_m2(c.lmx_arena_ref_struct(l2_pystr_unit, 2U), text, length, start)
