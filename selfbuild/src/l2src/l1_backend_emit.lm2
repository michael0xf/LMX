fn: l1_hdr_register_path (const: (@: in_path char); int: depth) int
    @@: imp_act_cell c.LmP0Text (cast: (@@: c.LmP0Text) (@ c.l1_imp_act))
    @@: imp_done_cell c.LmP0Text (cast: (@@: c.LmP0Text) (@ c.l1_imp_done))
