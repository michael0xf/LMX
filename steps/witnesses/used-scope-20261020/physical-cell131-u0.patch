-return: pool\pointer_write(cell, value)
+    # Save before the physical write: the caller may use this very companion
+    # as its input context. Only a successful store publishes the saved state.
+    lmx_value_context_copy(@ saved, context)
+    status: pool\pointer_write(cell, raw)
+    if: status = 0
+        lmx_value_context_copy(lmx_pointer_cell_context(arena, cell), @ saved)
+    ---
+return: status
diff --git src/l2src/lmx.h.lm1 src/l2src/lmx.h.lm1
