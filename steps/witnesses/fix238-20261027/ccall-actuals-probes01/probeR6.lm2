# Probe R6 (machine module): the emit:5299 shape, a bare L2 call result before a later actual that runs a door call.
predef: "probe_calls.h.lm1"
fn: inner (int: a) int
    return: a + 1
end: inner
fn: show (int: oi) int
    if: c.take(oi, inner(oi), c.pick(oi)) != 0
        return: 1
    return: 0
end: show
