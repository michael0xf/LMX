            return: (cast: (int) (c.lm_compiler_rw_refuse(source_node, "a literal out of its type's range")))
        if: neg != 0 && mag > 0U
            v: 0 - (cast: (int) (mag - 1U)) - 1
        else:
            v: (cast: (int) mag)
        ---
        status: c.lm_compiler_rw_lit(parent, v, out)
        return: (cast: (int) (c.lm_compiler_expr_leaf_note(source_node, 0, status, out)))
    if: ty = 1
        if: (neg = 0 && mag > (cast: (size_t) c.CHAR_MAX)) || (neg != 0 && mag > (cast: (size_t) (0 - c.CHAR_MIN)))
            return: (cast: (int) (c.lm_compiler_rw_refuse(source_node, "a literal out of its type's range")))
        v: (cast: (int) mag)
        if: neg != 0
            v: 0 - v
        ---
        status: c.lm_compiler_rw_clit(parent, v & 255, out)
        return: (cast: (int) (c.lm_compiler_expr_leaf_note(source_node, 1, status, out)))
    if: (ty = 3 || ty = 36) && mag > 4294967295U
        return: (cast: (int) (c.lm_compiler_rw_refuse(source_node, "a literal out of its type's range")))
    if: c.lm_compiler_rw_frame(parent, "LMX_WALK_OP_LIT", 2, out) != 0
        return: (cast: (int) (1))
    if: rw_emit_cell[0] = 0
        return: (cast: (int) (c.lm_compiler_expr_leaf_note(source_node, ty, 0, out)))
    if: ty = 2 && c.fprintf(out_cell[0], "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, 1U, %zuU) != c.LMX_WALK_OK\n            return: 1\n", \out, mag) < 0
        return: (cast: (int) (1))
    if: ty = 3 && c.fprintf(out_cell[0], "        if: lmx_walk_store_unsigned(l2_program_arena, l2_rw%d, 1U, %uU) != c.LMX_WALK_OK\n            return: 1\n", \out, (cast: (unsigned) mag)) < 0
        return: (cast: (int) (1))
    if: ty = 36 && c.fprintf(out_cell[0], "        if: lmx_walk_store_ulong(l2_program_arena, l2_rw%d, 1U, %uU) != c.LMX_WALK_OK\n            return: 1\n", \out, (cast: (unsigned) mag)) < 0
        return: (cast: (int) (1))
