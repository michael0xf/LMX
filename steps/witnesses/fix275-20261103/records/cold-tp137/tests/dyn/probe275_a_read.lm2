# Probe 275: a typed read through a slot rebound to another layout.  Entry 7.
Other:
    int: z 9
    int: y 7
end: Other
Box:
    kid:
        int: y 3
    end: kid
end: Box
int: quote 11
sub: put_kid ()
    quote\kid: Other
end: put_kid
fn: read_typed () int
    return: Box\kid\y
end: read_typed
fn: m () int
    @: quote Box Box
    put_kid()
    if: Box\kid\y != 7
        return: 81
    if: read_typed() != 7
        return: 82
    return: 7
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
