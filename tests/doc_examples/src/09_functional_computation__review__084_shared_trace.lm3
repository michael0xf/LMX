Around:
    @: acquire
    @: release
    @: action
    return: int
    use:
        throws: ResourceFailure
        @: resource acquire()
        finally:
            release(resource := resource)
        return: action(resource := resource)

Resource:
    int: value 42

Trace:
    int: mode 0
    int: events 0
    eval:
        Trace\events := Trace\events * 10 + x
    code:
        throws: ResourceFailure
        eval()
        if: Trace\mode = mode
            throw: ResourceFailure()
    end: code
    Acquire:
        return: @
        int: x 1
        int: mode 2
        open:
            throws: ResourceFailure
            code(mode)
        return: Resource
    Action:
        @: resource
        int: x 2
        int: mode 1
        return: int
        use:
            throws: ResourceFailure
            code(mode)
        return: resource\value
    Release:
        @: resource
        int: x 3
        close:
            eval()
        end: close
    Example:
        int: mode
        return: int
        run:
            Trace\mode := mode
            Trace\events := 0
            int: value Around\use(Acquire\open; Release\close; Action\use)
            return: value * 1000 + Trace\events
            catch: ResourceFailure ()
                return: -Trace\events
