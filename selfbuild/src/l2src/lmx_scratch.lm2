# The temporary-frame store.  The contract is in lmx_scratch.h.lm1.
# Everything here is built from the pool's own acts (lmx_pool_open, lmx_pool_take_n,
# lmx_pool_chunk_head, lmx_pool_release) and from reading the chunk records the pool
# keeps; no storage is obtained or released in any other way.
#
# A machine module (L2 section 20): each function has a direct C-compatible entry, and the kernel's code calls it with
# its explicit arguments. It declares its functions itself; the store's answers (LMX_SCRATCH_*), its record
# (LmxScratch), its marks' record (LmxScratchMark) and the prototypes the kernel calls are in lmx_scratch.h.lm1, which
# L3 code of the recipe writes as L1 text (decls_write_all, tools/l2/build.lm2). The pool's acts (lmx_pool_*,
# lmx_chunk_*) are the kernel's C functions, called through the C door; the pool's and the arena's modules come before
# the store in the kernel's translation unit.
predef: "l2src/lmx_scratch.h.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"

fn: lmx_scratch_open (@: s c.LmxScratch; @: arena c.LmxArena; @: cells c.LmxPool; size_t: chunk_cells) int
    if: s = 0 || arena = 0 || cells = 0 || chunk_cells = 0U
        return: c.LMX_SCRATCH_INVALID
    if: s\cells != 0
        return: c.LMX_SCRATCH_INVALID
    if: c.lmx_pool_open(arena, cells, sizeof(@: void), chunk_cells, c.LMX_DOMAIN_KIND_SCRATCH, c.LMX_DOMAIN_SCRATCH) != 0
        return: c.LMX_SCRATCH_NOMEM
    s\arena: arena
    s\cells: cells
    s\at: (cast: (@: LmxChunk) c.lmx_pool_chunk_head(cells))
    s\used: 0U
    s\top: 0U
    s\serial: 0U
    s\step: chunk_cells
    return: c.LMX_SCRATCH_OK
end: lmx_scratch_open

fn: lmx_scratch_take (@: s c.LmxScratch; size_t: bytes; @@: out void) int
    @: chunk c.LmxChunk 0
    @: got void 0
    @: expected void 0
    size_t: word 0U
    size_t: cells 0U
    size_t: from 0U
    size_t: issued 0U
    int: seeking 1
    if: out = 0
        return: c.LMX_SCRATCH_INVALID
    \out: 0
    if: s = 0 || s\cells = 0 || bytes = 0U
        return: c.LMX_SCRATCH_INVALID
    word: sizeof(@: void)
    # Rounding up to whole cells must not wrap.
    if: bytes > ((cast: (size_t) -1) - (word - 1U))
        return: c.LMX_SCRATCH_INVALID
    cells: (bytes + (word - 1U)) / word
    chunk: (cast: (@: LmxChunk) s\at)
    from: (cast: (size_t) s\used)
    while: seeking != 0 && chunk != 0
        # Warm: cells this chunk has already handed out once and nobody is using now.
        if: from <= (cast: (size_t) c.lmx_chunk_cells(chunk, (cast: (size_t) s\cells\stride))) && cells <= (cast: (size_t) c.lmx_chunk_cells(chunk, (cast: (size_t) s\cells\stride))) - from
            s\at: chunk
            s\used: from + cells
            \out: (cast: (@: void) ((cast: (@: char) c.lmx_chunk_data(chunk)) + from * word))
            return: c.LMX_SCRATCH_OK
        # The tail has the room but has not handed all of it out yet.  The cursor sits at
        # or below the chunk's high-water mark, so what is missing is taken FROM THE POOL:
        # it seats those cells right at the mark, and the mark moves with them.  Bumping
        # the cursor past the mark without telling the pool would let a later take_n hand
        # out cells that are live.
        if: chunk\next = 0 && from <= (cast: (size_t) c.lmx_chunk_cells(chunk, (cast: (size_t) s\cells\stride))) && from <= (cast: (size_t) c.lmx_chunk_room(chunk, (cast: (size_t) s\cells\stride))) && cells <= (cast: (size_t) c.lmx_chunk_room(chunk, (cast: (size_t) s\cells\stride))) - from
            expected: (cast: (@: void) ((cast: (@: char) c.lmx_chunk_data(chunk)) + (cast: (size_t) c.lmx_chunk_cells(chunk, (cast: (size_t) s\cells\stride))) * word))
            issued: (cast: (size_t) c.lmx_chunk_cells(chunk, (cast: (size_t) s\cells\stride)))
            got: (cast: (@: void) c.lmx_pool_take_n(s\arena, s\cells, (from + cells) - issued))
            if: got = 0
                return: c.LMX_SCRATCH_NOMEM
            if: got = expected
                s\at: chunk
                s\used: from + cells
                \out: (cast: (@: void) ((cast: (@: char) c.lmx_chunk_data(chunk)) + from * word))
                return: c.LMX_SCRATCH_OK
            # The pool seated them elsewhere (it no longer counts that chunk as its own):
            # they stay taken as a small gap, and the request goes to the cold path.
            seeking: 0
        ---
        if: seeking != 0
            chunk: (cast: (@: LmxChunk) chunk\next)
            from: 0U
        ---
    ---
    # Cold: no chunk seats the request.  The pool grows by one chunk -- of the request's
    # own size when that is larger than the step -- and the cursor moves to its end.
    got: (cast: (@: void) c.lmx_pool_take_n(s\arena, s\cells, cells))
    if: got = 0
        return: c.LMX_SCRATCH_NOMEM
    s\at: s\cells\tail
    s\used: (cast: (size_t) c.lmx_chunk_cells(s\at, (cast: (size_t) s\cells\stride)))
    \out: got
    return: c.LMX_SCRATCH_OK
end: lmx_scratch_take

fn: lmx_scratch_mark (@: s c.LmxScratch; @: m c.LmxScratchMark) int
    if: s = 0 || s\cells = 0 || m = 0
        return: c.LMX_SCRATCH_INVALID
    s\serial: s\serial + 1U
    m\owner: s
    m\at: s\at
    m\used: s\used
    m\serial: s\serial
    m\below: s\top
    s\top: m\serial
    return: c.LMX_SCRATCH_OK
end: lmx_scratch_mark

fn: lmx_scratch_rewind (@: s c.LmxScratch; @: m c.LmxScratchMark) int
    if: s = 0 || s\cells = 0 || m = 0
        return: c.LMX_SCRATCH_INVALID
    # Only the most recent outstanding mark of THIS store: another store's mark, a mark
    # already rewound and a mark with a younger one still outstanding all fail here.
    if: m\owner != s || m\serial = 0U || m\serial != s\top
        return: c.LMX_SCRATCH_BAD_MARK
    s\at: m\at
    s\used: m\used
    s\top: m\below
    m\owner: 0
    m\serial: 0U
    return: c.LMX_SCRATCH_OK
end: lmx_scratch_rewind

fn: lmx_scratch_close (@: s c.LmxScratch) int
    if: s = 0 || s\cells = 0
        return: c.LMX_SCRATCH_INVALID
    if: s\top != 0U
        return: c.LMX_SCRATCH_BUSY
    c.lmx_pool_release(s\arena, s\cells)
    s\arena: 0
    s\cells: 0
    s\at: 0
    s\used: 0U
    s\serial: 0U
    s\step: 0U
    return: c.LMX_SCRATCH_OK
end: lmx_scratch_close
