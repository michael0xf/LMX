---
    Observed:
        int: r1 17
        int: r2 8
        int: calls 2
        int: n 0
    end: Observed
---
@: shared (data [] 0)
int: k 2
fn: bump () int
    :=: ((shared \ Observed) \ n) (((shared \ Observed) \ n) + 1)
    return: 1
end: bump
sub: main () (
    prepared:
        name: triple
        args:
            int: a
        end: args
        return: int
        data:
            int: calls 0
        end: data
        code: ((:= (data \ calls) ((data \ calls) + 1)) (int last a) (return ((last * 3) + k)))
    end: prepared
    fn: prepared
    fn:
        unread
        merge: prepared ((int tick (bump)))
    end: fn
    int: r1 0
    int: r2 0
)
    :=: r1 (triple 5)
    :=: r2 (triple 2)
    :=: ((shared \ Observed) \ r1) r1
    :=: ((shared \ Observed) \ r2) r2
    :=: ((shared \ Observed) \ calls) ((triple \ data) \ calls)
end: main
main:
