# Existing collection examples; production libraries remain unchanged.
add_custom_target(lmx_usage_examples)
function(lmx_usage name file)
  add_executable(lmx_example_${name} "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/${file}")
  set_target_properties(lmx_example_${name} PROPERTIES C_STANDARD 99 C_STANDARD_REQUIRED YES C_EXTENSIONS NO RUNTIME_OUTPUT_DIRECTORY "${LMX_EXAMPLE_BINARY_DIR}/bin")
  if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(lmx_example_${name} PRIVATE -pedantic-errors)
  endif()
  target_link_libraries(lmx_example_${name} PRIVATE ${ARGN})
  if(COMMAND lmx_copy_runtime)
    lmx_copy_runtime(lmx_example_${name})
  endif()
  add_dependencies(lmx_usage_examples lmx_example_${name})
endfunction()

