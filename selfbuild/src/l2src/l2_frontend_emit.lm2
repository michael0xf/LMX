        status: lm_compiler_check_value_span(@ operand, mi, path, (cast: (const: @: c.LmP0Node) (value\node)))
        check_unevaluated_cell[0]: saved
        return: (cast: (int) (status))
    if: role = 5
        saved: check_unevaluated_cell[0]
        check_unevaluated_cell[0]: 1
        status: lm_compiler_check_machine_actuals(value, mi, path)
        check_unevaluated_cell[0]: saved
