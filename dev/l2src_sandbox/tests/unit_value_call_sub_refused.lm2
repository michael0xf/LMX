# A sub occurrence may be transported as a callable reference, but that reference is not an int
# result and cannot satisfy g's int formal.  This pins actual/formal compatibility, not a blanket
# ban on passing non-returning callables by reference.
int: y 0

sub: s ()
    y: 3
end: s

fn: g (int: x) int
    return: x
end: g

g(s)
return
