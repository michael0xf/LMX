            return: (cast: (int) (1))
        if: rw_emit_cell[0] != 0 && c.fprintf(out_cell[0], "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %dU) != c.LMX_WALK_OK || lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %dU) != c.LMX_WALK_OK\n            return: 1\n", prim, uslot + 1, mur_sel_cell[0][ur], prim, uslot + 2, mur_len_cell[0][ur]) < 0
            return: (cast: (int) (1))
        uj: 0
        while: uj < mur_len_cell[0][ur]
            if: rw_emit_cell[0] != 0 && c.fprintf(out_cell[0], "        if: lmx_walk_store_size(l2_program_arena, l2_rw%d, %dU, %dU) != c.LMX_WALK_OK\n            return: 1\n", prim, uslot + 3 + uj, mur_sbuf_cell[0][mur_off_cell[0][ur] + uj]) < 0
                return: (cast: (int) (1))
            uj: uj + 1
        ---
        uslot: uslot + 3 + mur_len_cell[0][ur]
        ur: ur + 1
    ---
    if: selected != 0 && rw_emit_cell[0] != 0
        if: c.snprintf(selected_map, 64U, "l2_mexec%d", res) < 0
