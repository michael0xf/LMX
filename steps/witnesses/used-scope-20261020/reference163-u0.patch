+    l2_reference_record_source(0, mi, out)
+    if: value = 0 || value\count < 1 || value\node = 0
+        return: 0
+    # A transparent sole Structure denotes its existing child. Its source
+    # construction is the child too,not an invented wrapper operation.
+    if: value\values != 0 && value\value_n = 1 && (value\grammar = 3 || value\node\kind = c.LM_P0_NODE_STRUCTURE)
+        return: l2_reference_source_value(value\values, mi, out)
+    status: l2_value_span_path(value, mi, @ selected)
