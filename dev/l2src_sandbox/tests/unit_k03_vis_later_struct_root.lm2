# K03 (Codex -07 Q2): a statement of the root above Later's definition reads Later's field: the definition is
# visible from the whole unit, as a method is.  Exit 7 when the read gives 4.
int: got 0
if: Later\v = 4U
    got: 7
Later:
    size_t: v 4U
end: Later
fn: m () int
    return: got
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
