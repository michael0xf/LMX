---
    Observed:
        int: seen 509
    end: Observed
---
fn: outer () int
    int: x 5
    fn: inner () int
        :=: x 9
        return: x
    end: inner
    fn: relay () int
        return: (inner)
    end: relay
    int: r (relay)
    return: ((x * 100) + r)
end: outer
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) (outer)
end: main
main:
