# Контроль the book, #inline-declaration-control: новое `int: x` без правой части во вложенном блоке — своё место без значения; чтение отказывает
# ответом 5, seen 0. Норма: книга, #inline-declaration-control; чтение исполнителя Р106.
(
    Observed:
        int: seen 0
)
fn: f () int
    int: x 5
    int: inner 0
    if: 1
        int: x
        inner := x
    return: inner
sub: main ()
    @: shared node[0]
    shared\Observed\seen := f()
main()
