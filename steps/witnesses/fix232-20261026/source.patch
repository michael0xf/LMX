+                                    if: src >= 0 && (cast: (size_t) src) < copied_fields\size && (cast: (size_t) src) < source_fields\size
+                                        value: c.lmx_arena_ref_value(copied, (cast: (size_t) src))
+                                        original: c.lmx_arena_ref_value(source, (cast: (size_t) src))
