predef: "l3_interp/l3_recv.h.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l2src/lmx_own.h.lm1"
predef: "l2src/lmx_own.lm1"
predef: "l2src/lmx_scratch.lm1"
predef: "l2src/lmx_interp.h.lm1"
predef: "l2src/lmx_implements.h.lm1"
predef: "l2src/lmx_value_owned.h.lm1"
predef: "l3_interp/l3_path.lm1"
predef: "l3_interp/l3_plan.lm1"
include: "<string.h>"

prototype:
    fn: l3_exec_stmt (@: LmxArena arena; @: L3Frame f; @: void v) int
    fn: l3_exec_range (@: LmxArena arena; @: L3Frame f; @: Lmx node; size_t: from) int
    fn: l3_exec_op (@: LmxArena arena; @: L3Frame f; @: Lmx host; @: LmxOp op) int
    fn: l3_cond_int (@: LmxArena arena; @: void v; @: int out) int
    fn: l3_own_load_ints (@: LmxArena arena; @: L3Frame f; @: Lmx node) int
    fn: l3_own_checkpoint_all (@: L3Frame f) int
    fn: l3_exec_frame (@: LmxArena arena; @: L3Frame f; @: Lmx node) int
end: prototype

fn: l3_own_load_ints (@: LmxArena arena; @: L3Frame f; @: Lmx node) int
    @: LmxCallable info
    @: Lmx plan
    @: void slice 0
    @@: void slot
    @: LmxOwnLocal loc
    size_t: n
    size_t: i
    f\nown: 0
    f\owns: 0
    if: arena = 0 || f = 0 || node = 0 || f\scratch = 0
        return: 1
    if: l3_plan_prepare(arena, node) != 0
        return: 1
    info: lmx_call_callable(arena, node)
    if: info = 0
        return: 1
    plan: info\header
    n: lmx_plan_entry_count(plan)
    if: n = 0U
        return: 0
    if: lmx_scratch_take(f\scratch, n * c.sizeof(c.LmxOwnLocal), @ slice) != c.LMX_SCRATCH_OK
        return: 1
    f\owns: (cast: (@: LmxOwnLocal) slice)
    i: 0U
    while: i < n
        slot: lmx_plan_slot_known(node, plan, i)
        if: slot = 0
            return: 1
        loc: f\owns + i
        loc\from: slot
        loc\value: slot[0]
        loc\dirty: 0
        i: i + 1U
    ---
    f\nown: (cast: (int) n)
return: 0

fn: l3_own_checkpoint_all (@: L3Frame f) int
    int: i 0
    if: f = 0
        return: 1
    while: i < f\nown
        if: lmx_own_checkpoint(@ f\owns[i]) != 0
            return: 1
        i: i + 1
    ---
return: 0

fn: l3_cond_int (@: LmxArena arena; @: void v; @: int out) int
    if: v = 0
        return: c.L3_ABSENT
    if: lmx_domain_kind(arena, v) != c.LMX_KIND_PRIMITIVE
        return: c.L3_UNSUPPORTED
    if: lmx_domain_type(arena, v) != c.LMX_TYPE_INT
        return: c.L3_UNSUPPORTED
    \out: lmx_int_value_known(v)
return: c.L3_OK

fn: l3_exec_op (@: LmxArena arena; @: L3Frame f; @: Lmx host; @: LmxOp op) int
    int: code
    int: st
    int: cond 0
    int: n 0
    int: idx
    int: k
    @: void body
    @: void arg
    @: void leaf 0
    @: void want
    @: Lmx path
    if: op = 0 || f = 0
        return: c.L3_INVALID
    code: op\code
    if: code = c.L3_NODE_RETURN
        f\has_ret: 0
        if: host = 0 || host\len < 2
            if: l3_own_checkpoint_all(f) != 0
                return: c.L3_INVALID
            return: c.L3_RETURN
        ---
        if: host\len > 2
            return: c.L3_UNSUPPORTED
        arg: lmx_arena_ref_value(host, 1U)
        if: arg = 0
            return: c.L3_ABSENT
        if: lmx_domain_kind(arena, arg) != c.LMX_KIND_PRIMITIVE
            return: c.L3_UNSUPPORTED
        if: lmx_domain_type(arena, arg) != c.LMX_TYPE_INT
            return: c.L3_UNSUPPORTED
        f\last_int: lmx_int_value_known(arg)
        f\has_ret: 1
        if: l3_own_checkpoint_all(f) != 0
            return: c.L3_INVALID
        return: c.L3_RETURN
    ---
    if: code = c.L3_NODE_MATCH || code = c.L3_NODE_EACH || code = c.L3_NODE_YIELD || code = c.L3_NODE_FINALLY || code = c.L3_NODE_THROW
        return: c.L3_UNSUPPORTED
    ---
    if: code = c.L3_NODE_EXPECT_INT
        if: f\subject = 0
            return: c.L3_UNSUPPORTED
        if: host = 0 || host\len < 3
            return: c.L3_INVALID
        if: lmx_domain_kind(arena, lmx_arena_ref_value(host, 1U)) != c.LMX_KIND_STRUCT
            return: c.L3_UNSUPPORTED
        path: (cast: (@: Lmx) lmx_arena_ref_value(host, 1U))
        st: l3_path_leaf(arena, f\subject, path, @ leaf)
        if: st != c.L3_OK
            return: st
        want: lmx_arena_ref_value(host, 2U)
        if: leaf = 0 || want = 0
            return: c.L3_ABSENT
        if: lmx_domain_type(arena, leaf) != c.LMX_TYPE_INT
            return: c.L3_ABSENT
        if: lmx_int_value_known(leaf) != lmx_int_value_known(want)
            return: c.L3_ABSENT
        return: c.L3_OK
    ---
    if: host = 0
        return: c.L3_INVALID
    if: code = c.L3_NODE_ASSIGN
        if: host\len < 3 || f\self = 0
            return: c.L3_INVALID
        st: l3_cond_int(arena, lmx_arena_ref_value(host, 1U), @ idx)
        if: st != c.L3_OK
            return: st
        arg: lmx_arena_ref_value(host, 2U)
        k: 0
        while: k < f\nown
            if: f\owns[k].from = lmx_arena_ref_cell(f\self, (cast: (size_t) idx))
                lmx_own_write(@ f\owns[k], arg)
                return: c.L3_OK
            ---
            k: k + 1
        ---
        return: c.L3_UNSUPPORTED
    ---
    if: code = c.L3_NODE_IF
        if: host\len < 3
            return: c.L3_INVALID
        st: l3_cond_int(arena, lmx_arena_ref_value(host, 1U), @ cond)
        if: st != c.L3_OK
            return: st
        if: cond != 0
            return: l3_exec_stmt(arena, f, lmx_arena_ref_value(host, 2U))
        if: host\len > 3
            return: l3_exec_stmt(arena, f, lmx_arena_ref_value(host, 3U))
        return: c.L3_OK
    ---
    if: code = c.L3_NODE_WHILE
        if: host\len < 3
            return: c.L3_INVALID
        body: lmx_arena_ref_value(host, 2U)
        while: n < c.L3_WHILE_CAP
            st: l3_cond_int(arena, lmx_arena_ref_value(host, 1U), @ cond)
            if: st != c.L3_OK
                return: st
            if: cond = 0
                return: c.L3_OK
            st: l3_exec_stmt(arena, f, body)
            if: st = c.L3_RETURN
                return: c.L3_RETURN
            if: st != c.L3_OK
                return: st
            n: n + 1
        ---
        return: c.L3_UNSUPPORTED
    ---
return: c.L3_UNSUPPORTED

fn: l3_exec_stmt (@: LmxArena arena; @: L3Frame f; @: void v) int
    @: Lmx host
    @: void head
    @: L3Frame child
    @: void slice 0
    int: hk
    int: kind
    LmxScratchMark: mark
    int: st
    if: v = 0
        return: c.L3_ABSENT
    kind: lmx_domain_kind(arena, v)
    if: kind = c.LMX_KIND_PRIMITIVE
        return: c.L3_OK
    if: kind = c.LMX_DOMAIN_KIND_OP
        return: l3_exec_op(arena, f, 0, (cast: (@: LmxOp) v))
    ---
    if: kind = c.LMX_KIND_STRUCT
        host: (cast: (@: Lmx) v)
        if: host\len < 1
            return: c.L3_OK
        head: lmx_arena_ref_value(host, 0U)
        if: head = 0
            return: c.L3_OK
        hk: lmx_domain_kind(arena, head)
        if: hk = c.LMX_DOMAIN_KIND_OP
            return: l3_exec_op(arena, f, host, (cast: (@: LmxOp) head))
        if: hk = c.LMX_DOMAIN_KIND_CALLABLE
            if: l3_own_checkpoint_all(f) != 0
                return: c.L3_INVALID
            if: f\scratch = 0
                return: c.L3_INVALID
            if: lmx_scratch_mark(f\scratch, @ mark) != c.LMX_SCRATCH_OK
                return: c.L3_INVALID
            if: lmx_scratch_take(f\scratch, c.sizeof(c.L3Frame), @ slice) != c.LMX_SCRATCH_OK
                lmx_scratch_rewind(f\scratch, @ mark)
                return: c.L3_INVALID
            ---
            child: (cast: (@: L3Frame) slice)
            memset((cast: (@: void) child), 0, c.sizeof(c.L3Frame))
            child\scratch: f\scratch
            child\subject: f\subject
            st: l3_exec_frame(arena, child, host)
            lmx_scratch_rewind(f\scratch, @ mark)
            return: st
        ---
        if: hk = c.LMX_KIND_METHOD
            return: c.L3_UNSUPPORTED
        return: c.L3_OK
    ---
    if: kind = c.LMX_DOMAIN_KIND_CALLABLE
        return: c.L3_OK
    if: kind = c.LMX_KIND_METHOD
        return: c.L3_UNSUPPORTED
return: c.L3_UNSUPPORTED

fn: l3_exec_range (@: LmxArena arena; @: L3Frame f; @: Lmx node; size_t: from) int
    size_t: i
    int: st
    if: node = 0
        return: c.L3_INVALID
    i: from
    while: i < (cast: (size_t) node\len)
        st: l3_exec_stmt(arena, f, lmx_arena_ref_value(node, i))
        if: st = c.L3_RETURN
            return: c.L3_RETURN
        if: st != c.L3_OK
            return: st
        i: i + 1U
    ---
return: c.L3_OK

fn: l3_exec_frame (@: LmxArena arena; @: L3Frame f; @: Lmx node) int
    @: void head
    int: hk
    int: st
    @: Lmx saved_self
    if: arena = 0 || f = 0 || node = 0
        return: c.L3_INVALID
    if: lmx_domain_kind(arena, (cast: (@: void) node)) != c.LMX_KIND_STRUCT
        return: c.L3_UNSUPPORTED
    if: node\len < 1
        return: c.L3_UNSUPPORTED
    head: lmx_arena_ref_value(node, 0U)
    if: head = 0
        return: c.L3_UNSUPPORTED
    hk: lmx_domain_kind(arena, head)
    if: hk = c.LMX_KIND_METHOD
        return: c.L3_UNSUPPORTED
    if: hk != c.LMX_DOMAIN_KIND_CALLABLE
        return: c.L3_UNSUPPORTED
    saved_self: f\self
    f\self: node
    if: l3_own_load_ints(arena, f, node) != 0
        f\self: saved_self
        return: c.L3_INVALID
    st: l3_exec_range(arena, f, node, 1U)
    if: st != c.L3_RETURN
        l3_own_checkpoint_all(f)
    ---
    f\self: saved_self
    if: st = c.L3_RETURN
        return: c.L3_OK
return: st

fn: l3_exec_run (@: LmxArena arena; @: Lmx node) int
return: l3_exec_run_on(arena, node, 0, 0)

fn: l3_exec_run_on (@: LmxArena arena; @: Lmx node; @: Lmx subject; @: L3Result out) int
    LmxArena: sa
    LmxPool: cells
    LmxScratch: scratch
    L3Frame: frame
    int: st
    memset((cast: (@: void) (@ sa)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ scratch)), 0, c.sizeof(c.LmxScratch))
    memset((cast: (@: void) (@ frame)), 0, c.sizeof(c.L3Frame))
    if: lmx_arena_open(@ sa) != 0
        return: c.L3_INVALID
    if: lmx_scratch_open(@ scratch, @ sa, @ cells, 64U) != c.LMX_SCRATCH_OK
        lmx_arena_release(@ sa)
        return: c.L3_INVALID
    ---
    frame.scratch: @ scratch
    frame.subject: subject
    st: l3_exec_frame(arena, @ frame, node)
    if: out != 0
        out\present: frame.has_ret
        out\value: frame.last_int
    ---
    lmx_scratch_close(@ scratch)
    lmx_arena_release(@ sa)
return: st
