predef: "l2src/lmx_root.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_merge_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# The producer publishes its completed program unit as the current Message graph and exports
# count/root_at accessors over a translation-sized C array of exact qualified root references.
# The array is observation state only. Lifetime and classification come from the ordinary graph
# path plus the roots' exact sealed owner-arena profiles; no Root slot or private store exists.

int: gargc 0
@@: char gargv 0
int: hooked 0
int: checks 0
int: failures 0
const: @: char phase ""
@@: void saved 0
@@: void saved_profiles 0
int: entry_opened 0
int: entry_calls 0
int: entry_rc 0

prototype:
    fn: l2_generated_main () int
    fn: l2_program_entry (@: Lmx node) int
    fn: l2_program_graph () @: Lmx
    fn: l2_program_qualified_count () size_t
    fn: l2_program_qualified_at (size_t: index) @: Lmx
end: prototype

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL [%s] %s\n", phase, label)
    ---
end: check

fn: arg (int: at) int
    if: at < 0 || at >= gargc
        return: -1
return: atoi(gargv[at])

fn: root_profile (@: LmxArena arena; @: Lmx root) @: Lmx
    if: arena = 0 || root = 0
        return: 0
return: lmx_range_profile(arena, (cast: (@: void) root))

fn: sealed_here (@: LmxArena arena; @: void value) int
    @: LmxPool pool lmx_range_pool(arena, value)
    if: pool = 0
        return: 0
return: lmx_pool_is_sealed(pool)

fn: inspect (@: LmxRoot root) int
    @: LmxArena arena lmx_root_arena(root)
    @: LmxMsg message lmx_root_message(root)
    @: LmxThread thread lmx_root_thread(root)
    @: LmxArrayDesc children (cast: (@: LmxArrayDesc) lmx_thread_children(thread))
    @: Lmx value 0
    @: Lmx other 0
    @: Lmx member 0
    @: Lmx profile 0
    @: void cell 0
    size_t: produced l2_program_qualified_count()
    int: expected arg(1)
    int: i 0
    int: j
    int: at 2
    int: missing 0
    int: duplicate 0
    int: shared_profile 0
    int: children_seen 0
    check(message != 0 && l2_program_graph() != 0 && message\graph = l2_program_graph(), "program unit is the current Message graph")
    # The parent frame above R0 is Message supervision, not a lexical `node` link (LMX_semantics
    # §23), so the published program unit is a lexical root.  A parent here lets graph copy climb
    # out of this Message into the supervising Message's graph.
    check(l2_program_graph() != 0 && l2_program_graph()\parent = 0, "program unit is a lexical root: its parent Message is supervision, not a lexical node")
    check(lmx_domain_kind(arena, (cast: (@: void) l2_program_graph())) = c.LMX_KIND_STRUCT && lmx_domain_type(arena, (cast: (@: void) l2_program_graph())) = c.LMX_TYPE_STRUCT, "program unit remains a live owner-arena Structure")
    i: 0
    while: message != 0 && message\graph != 0 && i < message\graph\len
        if: lmx_arena_ref_value(message\graph, (cast: (size_t) i)) = (cast: (@: void) children)
            children_seen: children_seen + 1
        ---
        i: i + 1
    ---
    check(children != 0 && children_seen = 1 && lmx_domain_kind(arena, (cast: (@: void) children)) = c.LMX_KIND_LIST && lmx_domain_type(arena, (cast: (@: void) children)) = c.LMX_TYPE_ARRAY_OF_POINTER_BASE + c.LMX_DOMAIN_THREAD, "program unit preserves the one exact children list")
    i: 0
    check(expected >= 0 && produced = (cast: (size_t) expected), "producer count is the translation-known number of qualified roots")
    if: expected < 0 || produced != (cast: (size_t) expected)
        return: 0
    ---
    if: expected = 0
        check(l2_program_qualified_at(0U) = 0, "zero-root accessor refuses every index")
        return: 1
    ---
    while: i < expected
        value: l2_program_qualified_at((cast: (size_t) i))
        if: value = 0
            missing: missing + 1
        else:
            profile: root_profile(arena, value)
            check(value\parent = 0, "qualified root remains parentless")
            check(lmx_domain_kind(arena, (cast: (@: void) value)) = c.LMX_KIND_STRUCT && lmx_domain_type(arena, (cast: (@: void) value)) = c.LMX_TYPE_STRUCT, "qualified root is an exact Structure range value")
            check(profile != 0 && sealed_here(arena, (cast: (@: void) value)) != 0, "qualified root has a nonzero exact profile in a sealed owner range")
            check(sealed_here(arena, (cast: (@: void) profile)) != 0 && lmx_domain_kind(arena, (cast: (@: void) profile)) = c.LMX_KIND_STRUCT, "receiver-expression profile is itself a sealed physical Structure")
            j: 0
            while: j < i
                if: l2_program_qualified_at((cast: (size_t) j)) = value
                    duplicate: duplicate + 1
                ---
                if: root_profile(arena, l2_program_qualified_at((cast: (size_t) j))) = profile
                    shared_profile: shared_profile + 1
                ---
                j: j + 1
            ---
        ---
        i: i + 1
    ---
    check(missing = 0, "every exported entry is an exact physical root reference")
    check(duplicate = 0, "no physical root reference is duplicated")
    check(shared_profile = 0, "distinct qualified roots have distinct exact physical profiles")
    if: missing != 0
        return: 0
    ---
    while: at < gargc
        if: c.strcmp(gargv[at], "size") = 0 && at + 3 < gargc
            value: l2_program_qualified_at((cast: (size_t) arg(at + 1)))
            profile: root_profile(arena, value)
            cell: lmx_arena_ref_value(value, (cast: (size_t) arg(at + 2)))
            check(cell != 0 && lmx_domain_kind(arena, cell) = c.LMX_KIND_PRIMITIVE && lmx_domain_type(arena, cell) = c.LMX_TYPE_SIZE_T, "size field has the declared primitive type")
            check(cell != 0 && lmx_range_profile(arena, cell) = profile && sealed_here(arena, cell) != 0, "size field belongs to the same exact sealed profile")
            if: cell != 0
                check(lmx_size_value_known(cell) = (cast: (size_t) arg(at + 3)), "size field holds the declared value")
            ---
            at: at + 4
        else:
            if: c.strcmp(gargv[at], "same") = 0 && at + 3 < gargc
                value: l2_program_qualified_at((cast: (size_t) arg(at + 1)))
                other: l2_program_qualified_at((cast: (size_t) arg(at + 3)))
                check(other != 0 && lmx_arena_ref_value(value, (cast: (size_t) arg(at + 2))) = (cast: (@: void) other), "same field retains the other root's exact physical reference")
                at: at + 4
            else:
                if: c.strcmp(gargv[at], "slot") = 0 && at + 4 < gargc
                    value: l2_program_qualified_at((cast: (size_t) arg(at + 1)))
                    other: l2_program_qualified_at((cast: (size_t) arg(at + 3)))
                    cell: lmx_arena_ref_value(other, (cast: (size_t) arg(at + 4)))
                    check(cell != 0 && lmx_arena_ref_value(value, (cast: (size_t) arg(at + 2))) = cell, "slot field retains the other branch member's exact physical reference")
                    member: (cast: (@: Lmx) cell)
                    check(member != 0 && member\parent = other && lmx_range_profile(arena, cell) = root_profile(arena, other) && sealed_here(arena, cell) != 0, "slot member keeps its lexical parent and exact sealed profile")
                    at: at + 5
                else:
                    check(0, "all driver fact arguments are recognized")
                    at: gargc
                ---
            ---
        ---
    ---
return: 1

fn: l2_driver_root_close (@: LmxRoot root) int
    @: LmxArena arena 0
    size_t: n
    size_t: i 0U
    hooked: hooked + 1
    phase: "after generated turn"
    check(root != 0 && lmx_root_state(root) = c.LMX_ROOT_OPEN, "generated root is open at close hook")
    if: root = 0
        return: 1
    ---
    inspect(root)
    arena: lmx_root_arena(root)
    n: l2_program_qualified_count()
    if: n != 0U
        saved: (cast: (@@: void) calloc(n, c.sizeof(@: void)))
        saved_profiles: (cast: (@@: void) calloc(n, c.sizeof(@: void)))
        check(saved != 0 && saved_profiles != 0, "comparison storage opened")
        if: saved != 0 && saved_profiles != 0
            while: i < n
                saved[i]: (cast: (@: void) l2_program_qualified_at(i))
                saved_profiles[i]: (cast: (@: void) root_profile(arena, l2_program_qualified_at(i)))
                i: i + 1U
            ---
        ---
    ---
    phase: "after explicit collection"
    check(lmx_gc_collect(arena, lmx_root_thread(root)) = c.LMX_GC_OK, "owner-arena collection completes")
    check(l2_program_qualified_count() = n, "producer count is unchanged by collection")
    i: 0U
    while: saved != 0 && saved_profiles != 0 && i < n
        check((cast: (@: void) l2_program_qualified_at(i)) = saved[i], "qualified root physical address is unchanged by collection")
        check((cast: (@: void) root_profile(arena, l2_program_qualified_at(i))) = saved_profiles[i], "qualified root exact profile is unchanged by collection")
        i: i + 1U
    ---
    inspect(root)
    if: saved != 0
        free((cast: (@: void) saved))
        saved: 0
    ---
    if: saved_profiles != 0
        free((cast: (@: void) saved_profiles))
        saved_profiles: 0
    ---
return: lmx_root_close(root)

# THE ENTRY'S OWN RESULT.  lmx_thread_dispatch_native calls the generated entry adapter and
# discards its int, so the generated C main's exit status says only that the root turn ran.  The
# generated C is compiled with -Dlmx_root_open=l2_driver_root_open (tools/l2_harness.ps1), so R0 is
# opened with this tap in place of the adapter.  The tap calls the adapter once, exactly as the
# kernel would, keeps its int, and hands the same int back to the kernel: the driver observes, it
# does not change what the kernel does with the result.
fn: l2_driver_entry_tap (@: Lmx node) int
    int: rc
    rc: l2_program_entry(node)
    entry_calls: entry_calls + 1
    entry_rc: rc
return: rc

fn: l2_driver_root_open (@: LmxRoot root; LmxCallEntry: entry; ulong: limit) int
    if: entry = l2_program_entry
        entry_opened: entry_opened + 1
    ---
return: lmx_root_open(root, l2_driver_entry_tap, limit)

fn: main (int: argc; @@: char argv) int
    int: status
    gargc: argc
    gargv: argv
    if: argc < 2
        fputs("l2_eternal_driver: expected number of roots missing\n", l1_stdout())
        return: 2
    ---
    phase: "generated program"
    status: l2_generated_main()
    check(status = 0, "generated main returned 0")
    check(hooked = 1, "generated main closed exactly one root")
    phase: "generated entry"
    check(entry_opened = 1, "generated main opened its root with the generated entry adapter")
    check(entry_calls = 1, "generated entry ran exactly once")
    check(entry_rc = 0, "generated entry returned 0")
    if: entry_rc != 0
        c.printf("l2_eternal_driver: entry returned %d\n", entry_rc)
    ---
    if: failures != 0
        c.printf("l2_eternal_driver: %d failed of %d\n", failures, checks)
        return: 1
    ---
    c.printf("l2_eternal_driver: %d checks, %d roots\n", checks, arg(1))
return: 0
