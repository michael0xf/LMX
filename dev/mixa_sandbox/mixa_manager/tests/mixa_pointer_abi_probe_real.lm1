# ABI parity guard — L1 port of mixa_pointer_abi_probe_real.c (ticket 20260918-082421).
# offsetof is a C macro with no L1 spelling (c. pastes a call, not a preprocessor
# name). Field offsets are computed at run time via pointer arithmetic on a local
# store (same pattern as l2src/lmx_message_selftest.lm1). Output format strings
# are kept byte-identical to the C probe so L2-vs-real parity still diffs stdout.
predef: "mixa_manager/mixa_pointer.h.lm1"
include: "<stdio.h>"

fn: main () int
    MixaPointer: store0
    @: MixaPointer p0
    p0: @ store0

    c.printf("MixaPointer sizeof=%zu\n", c.sizeof(c.MixaPointer))
    c.printf("MixaPointer is_open=%zu\n", (cast: (size_t) @ p0\is_open) - (cast: (size_t) p0))
    c.printf("MixaPointer octant=%zu\n", (cast: (size_t) @ p0\octant) - (cast: (size_t) p0))
    c.printf("MixaPointer row=%zu\n", (cast: (size_t) @ p0\row) - (cast: (size_t) p0))
    c.printf("MixaPointer col=%zu\n", (cast: (size_t) @ p0\col) - (cast: (size_t) p0))
    return: 0

