 predef: "l1src/libc_abi.lm1"
-include: "<stdlib.h>"
+include: "<stdlib.h>" "<stdint.h>"

 # The manager of the arena. Lingvamyxa_spec.txt 2, 6.5; Mikhail, 2026-09-17: "У нас есть
 # арена (там менеджер)".
@@ -202,9 +202,60 @@ return: lmx_range_add(arena, array, base, (cast: (@: void) ((cast: (@: char) bas
 # it did before.  A miss is not a failure here: the block's own removal is what this call
 # reports, and that is the same answer either way.
 fn: lmx_arena_drop (@: LmxArena arena; @: LmxArenaBlock node) int
+    @: LmxPool pool
+    @: LmxPool next_pool
+    @: LmxChunk chunk
+    @: LmxChunk next_chunk
+    @: LmxArenaBlock member
+    @: LmxArenaBlock tail
+    uintptr_t: lo
+    uintptr_t: hi
+    uintptr_t: at
     if: arena = 0 || node = 0
         return: 1
-    lmx_arena_array_drop(arena, (cast: (@: LmxPool) node\base))
+    if: lmx_arena_blocks_tail(arena\blocks, @ tail) != c.LMX_ARENA_BLOCKS_OK
+        return: 1
+    member: arena\blocks
+    while: member != 0 && member != node
+        member: member\next
+    ---
+    if: member = 0
+        return: 1
+    lo: (cast: (uintptr_t) node\base)
+    hi: lo + node\n
+    if: hi < lo
+        return: 1
+    # All owners detach through this operation, before any disposer runs.
+    # A chunk's record and payload are separate blocks. Either one leaving
+    # unlinks that chunk, so an old pool never keeps a freed head/tail.
+    # An embedded pool follows the containing block, not just an equal base.
+    pool: arena\arrays
+    while: pool != 0
+        next_pool: pool\next
+        at: (cast: (uintptr_t) pool)
+        if: node\base != 0 && node\n != 0U && at >= lo && at < hi
+            lmx_arena_array_drop(arena, pool)
+            pool\head: 0
+            pool\tail: 0
+            pool\next: 0
+            pool\stride: 0U
+            pool\chunk_capacity: 0U
+            pool\kind: 0
+            pool\type: 0
+            pool\profile: 0
+            pool\sealed: 0U
+        else:
+            chunk: pool\head
+            while: chunk != 0
+                next_chunk: chunk\next
+                if: (cast: (@: void) lmx_chunk_data(chunk)) = node\base || (cast: (@: void) chunk) = node\base
+                    lmx_pool_chunk_drop(pool, chunk)
+                ---
+                chunk: next_chunk
+            ---
+        ---
+        pool: next_pool
+    ---
     if: node\base != 0 && node\n != 0U
         lmx_range_drop(arena, node\base, (cast: (@: void) ((cast: (@: char) node\base) + node\n)))
     ---
@@ -223,10 +274,17 @@ return: arena\blocks
 # no half-made array behind and disturbs nothing that was already there -- "the whole, or
 # nothing", exactly as merge and graph copy require.
 fn: lmx_arena_revert (@: LmxArena arena; @: LmxArenaBlock mark) int
+    @: LmxArenaBlock node
     if: arena = 0
         return: 1
     while: arena\blocks != 0 && arena\blocks != mark
-        lmx_arena_drop(arena, arena\blocks)
+        node: arena\blocks
+        if: lmx_arena_drop(arena, node) != 0
+            return: 1
+        # drop is detach-only, also used by GC. Dispose this now unlinked
+        # singleton with the same ownership/disposer contract as release.
+        if: lmx_arena_blocks_dispose_all(@ node) != c.LMX_ARENA_BLOCKS_OK
+            return: 1
     ---
     # D-105: a correspondence of a value the revert took back leaves with it.
     lmx_arena_impl_prune(arena)
