# FABLE-SONNET-NAME-SPECIALS-20260924-155: lm_own_delete used to resolve
# through l2_is_known's hard-coded adapter list; this predef is the
# general mechanism's own declaration for it (a prototype-only header,
# matching every other predef target in this corpus -- l2_predef_file_has_
# function only recognizes names inside a prototype: block or a chained
# predef:, never a plain top-level fn:/sub: body like l1src/own.lm1 itself).
predef: "l1src/own.h.lm1"
sub: d (@: LmP0Text t)
    lm_own_delete(t, 0)
end: d
fn: m (int: z) int
    return: d(0)
end: m
return: 0
