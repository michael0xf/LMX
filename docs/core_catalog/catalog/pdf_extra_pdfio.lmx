    Lists:
        @: l0 (("ifndef PDFIO_H");();("LMX::pdfio");("ifndef PDFIO_CONTENT_H");("Variadic API requires a fixed typed adapter; do not forward L3 values through C varargs.");("Known failing encrypted CreationDate regression is retained in extensions/pdf_extra/KNOWN_LIMITATIONS.md; ordinary/encrypted date behavior must not be conflated.");("Callback typedef parameter(s): pdfio_dict_cb_t. Use an actor-owned trampoline/lifetime contract.");("Callback typedef parameter(s): pdfio_error_cb_t. Use an actor-owned trampoline/lifetime contract.");("Callback typedef parameter(s): pdfio_error_cb_t, pdfio_output_cb_t. Use an actor-owned trampoline/lifetime contract.");("Callback typedef parameter(s): pdfio_error_cb_t, pdfio_password_cb_t. Use an actor-owned trampoline/lifetime contract.");("Callback type/slot, not an exported callable.");("ifndef TTF_H");("Callback typedef parameter(s): ttf_err_cb_t. Use an actor-owned trampoline/lifetime contract."))
