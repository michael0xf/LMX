            field: field\next
            if: nnode = 0 || nnode\kind != c.LM_P0_NODE_ATOM || vnode = 0 || vnode\kind != c.LM_P0_NODE_ATOM
                return: (cast: (int) (l1_error(path, nnode, "enum enumerator expects name and value atoms")))
            if: first = 0
                if: l1_write_cstr(out, ",\n") != 0
                    return: (cast: (int) (1))
                ---
            ---
            first: 0
            if: l1_write_cstr(out, "    ") != 0
                return: (cast: (int) (1))
            if: l1_write_ident(out, (cast: (const: @: c.LmP0Text) nnode\as\atom), path, nnode) != 0
                return: (cast: (int) (1))
            if: l1_write_cstr(out, " = ") != 0
                return: (cast: (int) (1))
            if: l1_write_text(out, (cast: (const: @: c.LmP0Text) vnode\as\atom)) != 0
                return: (cast: (int) (1))
        ---
    ---
    if: l1_write_cstr(out, "\n} ") != 0
        return: (cast: (int) (1))
    if: l1_write_ident(out, name, path, source_node) != 0
        return: (cast: (int) (1))
    return: (cast: (int) (l1_write_cstr(out, ";\n\n")))
end: l1_emit_hdr_enum

