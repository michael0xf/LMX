# Codex (OPUS-CODEX-20261005-01): a dead tail is checked, not executed.  The root gives g, so its call of
# Counter is admissible; the tail after the bare `return` holds `n\nosuch`, a path through a number, which no
# execution could make valid: refused where it stands.
Counter:
    size_t: n 0U
    return
    n: n\nosuch + g
return
size_t: g 2U
Counter
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
