# A number field of a message receives the result of a held callable named
# bare, as it receives that of `p7()`: the exit code is 7, what p7 gives, and
# not the callable's occurrence. Entry 7.
fn: make0 (int: n) fn: () int
    fn: f0 () int
        return: n
    return: f0

p7: make0 7
sendMessage: exit(exit_code: p7; stdout: ""; stderr: "")
return
