Leaf: (int: x 11)
Holder: (int: pad 17; @: Leaf ref)
Candidate: (int: pad 29; int: x 13)
Holder\ref: Candidate
fn: check (Holder: value) int
    if: value\ref\x != 13 || @value\ref\x != @Candidate\x
        return: 81
    value\ref\x: 31
    if: Candidate\x != 31 || Candidate\pad != 29 || Leaf\x != 11
        return: 82
return: 7
sendMessage: exit(exit_code: check(Holder); stdout: ""; stderr: "")
return
