Observed:
    int: self_seen 41
    int: given_seen 13
    int: structure_seen 30
    int: callable_seen 23
    int: calls 0
    int: touches 1
end: Observed
fn: touch () int
    :=: (Observed \ touches) ((Observed \ touches) + 1)
    return: 0
end: touch
Self:
    int: x 40
    int: y 41
    @: p int (Self [] 0)
    :=: p (Self [] 1)
    int: seen 41
    :=: (Self \ seen) (\ p)
end: Self
D:
    int: x 11
    int: y 13
    Target:
        int: n 30
    end: Target
    @: p int (data [] (touch))
    @: s Missing
    int: seen 13
    int: sseen 30
    Code:
        @: p int (data [] 1)
        @: s Target
        :=: (data \ seen) (\ p)
        :=: (data \ sseen) (s \ n)
    end: Code
end: D
D2:
    int: x 21
    int: y 23
    @: p int (data [] (touch))
    int: seen 23
    Writer: (@ p int (data [] 1)) (:= (data \ seen) (\ p))
end: D2
Main:
    call: Self
    D\Code()
    D2\Writer()
    :=: (Observed \ self_seen) (Self \ seen)
    :=: (Observed \ given_seen) (D \ seen)
    :=: (Observed \ structure_seen) (D \ sseen)
    :=: (Observed \ callable_seen) (D2 \ seen)
    :=: (Observed \ calls) (Observed \ touches)
    int: control (touch)
end: Main
