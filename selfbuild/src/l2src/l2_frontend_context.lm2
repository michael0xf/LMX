# Ordinary L2 frontend context, visibility and source identity helpers.
# The67 inherited compiler cells remain in the existing frontend; aliases address those same cells.
predef: "l2src/l2_application.h.lm1"
predef: "l2src/l2_frontend_helpers.h.lm1"
predef: "l2src/l2_frontend_alloc.h.lm1"
predef: "l2src/l2_frontend_values.h.lm1"
predef: "l2src/l2_frontend_views.h.lm1"
include: "<stddef.h>" "<stdio.h>" "<stdlib.h>" "<string.h>" "<limits.h>"

fn: lm_compiler_node_file (const: (@: path char); const: (@: source_node c.LmP0Node)) const: @: char
    @@@: part_doc_cell c.LmP0Document (cast: (@@@: c.LmP0Document) (@ c.l2_part_doc))
    @: part_n_cell int (cast: (@: int) (@ c.l2_part_n))
    @@@: part_path_cell char (cast: (@@@: char) (@ c.l2_part_path))
    int: k 0
    const: (@: owner c.LmP0Node c.lm_compiler_head_source_node(source_node))
    while: owner != 0 && part_doc_cell[0] != 0 && k < part_n_cell[0]
        if: part_doc_cell[0][k] != 0 && c.lm_compiler_node_in(c.lm_p0_document_root(part_doc_cell[0][k]), owner) != 0
            path: part_path_cell[0][k]
        k: k + 1
    ---
    if: path = 0
        path: ""
    return: (cast: (const: @: char) (path))
end: lm_compiler_node_file

fn: lm_compiler_vis_ok (const: (@: at c.LmP0Node)) int
    @: vis_at_cell size_t (cast: (@: size_t) (@ c.l2_vis_at))
    @: vis_on_cell int (cast: (@: int) (@ c.l2_vis_on))
    if: vis_on_cell[0] = 0 || at = 0 || at\span = 0
        return: (cast: (int) (1))
    # A method of a program part reads another unit (§8): places of two files do not compare, and nothing the
    # source declares is visible from it by its place.
    if: vis_on_cell[0] = 2
        return: (cast: (int) (0))
    return: (cast: (int) (at\span\offset <= vis_at_cell[0]))
end: lm_compiler_vis_ok

fn: lm_compiler_vis_from (const: (@: at c.LmP0Node)) int
    @: vis_at_cell size_t (cast: (@: size_t) (@ c.l2_vis_at))
    @: vis_on_cell int (cast: (@: int) (@ c.l2_vis_on))
    vis_on_cell[0]: 0
    if: at != 0 && at\span != 0
        vis_on_cell[0]: 1
        vis_at_cell[0]: at\span\offset
    ---
    return: (cast: (int) (0))
end: lm_compiler_vis_from

fn: lm_compiler_vis_method (int: mi) int
    @: e_cell int (cast: (@: int) (@ c.l2_e))
    @: here_source_mi_cell int (cast: (@: int) (@ c.l2_here_source_mi))
    @: m_n_cell int (cast: (@: int) (@ c.l2_m_n))
    @@@: m_node_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_m_node))
    @@@: ns_at_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_ns_at))
    @: vis_on_cell int (cast: (@: int) (@ c.l2_vis_on))
    int: ns
    lm_compiler_here_at_method(mi, 0)
    here_source_mi_cell[0]: mi
    vis_on_cell[0]: 0
    if: mi >= 0 && mi != e_cell[0] && mi < m_n_cell[0] && m_node_cell[0][mi] != 0
        lm_compiler_vis_from(m_node_cell[0][mi])
    ---
    # A named Structure's code reads the unit from the Structure's declaration, as a method's from its header: an
    # ordinary declaration is visible forward and down from where it stands, a later one is not (docs
    # #declaration-visibility) -- a name the code reads that only a later declaration spells is a free name.
    if: mi >= 0 && mi != e_cell[0] && mi < m_n_cell[0] && m_node_cell[0][mi] = 0
        ns: c.lm_compiler_m_nsof(mi)
        if: ns >= 0 && ns_at_cell[0][ns] != 0
            lm_compiler_vis_from(ns_at_cell[0][ns])
        ---
    ---
    # Code of a program part -- a method a part gave (§8), its root's procedure (§10): nothing of the source is
    # visible from it by its place (l2_vis_ok).
    if: lm_compiler_m_code_file(mi) >= 0
        vis_on_cell[0]: 2
    return: (cast: (int) (0))
end: lm_compiler_vis_method

fn: lm_compiler_vis_stmt (int: mi; const: (@: stmt c.LmP0Node)) int
    @: e_cell int (cast: (@: int) (@ c.l2_e))
    lm_compiler_here_at_method(mi, stmt)
    if: mi >= 0 && mi = e_cell[0]
        lm_compiler_vis_from(stmt)
    ---
    return: (cast: (int) (0))
end: lm_compiler_vis_stmt

fn: lm_compiler_own_unit_seen (int: oi; int: mi) int
    @: e_cell int (cast: (@: int) (@ c.l2_e))
    @@: ns_proc_cell int (cast: (@@: int) (@ c.l2_ns_proc))
    @@@: own_decl_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_own_decl))
    @@@: own_host_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_own_host))
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@: part_ns_cell int (cast: (@@: int) (@ c.l2_part_ns))
    int: k
    @: source c.LmP0Node
    if: oi < 0 || oi >= own_n_cell[0] || own_host_cell[0][oi] != 0
        return: (cast: (int) (0))
    if: own_mi_cell[0][oi] = mi
        return: (cast: (int) (0))
    # §10: a method of a program part sees its part's root's fields -- own fields of that root's procedure, in
    # the root's slots -- declared above it in the part, as a method of the source sees the unit's fields.
    k: lm_compiler_m_code_file(mi)
    if: k >= 0 && part_ns_cell[0][k] >= 0 && ns_proc_cell[0][part_ns_cell[0][k]] >= 0 && own_mi_cell[0][oi] = ns_proc_cell[0][part_ns_cell[0][k]]
        if: c.lm_compiler_source_definition_method(oi) >= 0
            return: (cast: (int) (1))
        source: lm_compiler_callable_source_node(mi)
        if: own_decl_cell[0][oi] = 0 || own_decl_cell[0][oi]\span = 0 || source = 0 || source\span = 0
            return: (cast: (int) (1))
        return: (cast: (int) ((cast: (int) (own_decl_cell[0][oi]\span\offset <= source\span\offset))))
    if: e_cell[0] < 0 || own_mi_cell[0][oi] != e_cell[0] || mi = e_cell[0]
        return: (cast: (int) (0))
    # Code of a program part -- a method a part gave, its root's procedure -- is another unit's (§8, §10): the
    # source's fields are not in its scope -- a name it reads that it does not declare is a free name, bound
    # by its callers or unresolved.
    if: k >= 0
        return: (cast: (int) (0))
    if: c.lm_compiler_source_definition_method(oi) >= 0
        return: (cast: (int) (1))
    return: (cast: (int) (lm_compiler_vis_ok(own_decl_cell[0][oi])))
end: lm_compiler_own_unit_seen

fn: lm_compiler_occ_n () int
    @: e_cell int (cast: (@: int) (@ c.l2_e))
    @: m_n_cell int (cast: (@: int) (@ c.l2_m_n))
    if: e_cell[0] >= 0
        return: (cast: (int) (e_cell[0]))
    return: (cast: (int) (m_n_cell[0]))
end: lm_compiler_occ_n

fn: lm_compiler_hidden_reserve (int: mi; int: need) int
    @: alloc_err_cell int (cast: (@: int) (@ c.l2_alloc_err))
    @: alloc_kind_cell int (cast: (@: int) (@ c.l2_alloc_kind))
    @@@: m_dn_cell void (cast: (@@@: void) (@ c.l2_m_dn))
    @@@: m_dt_cell int (cast: (@@@: int) (@ c.l2_m_dt))
    @@: m_dyn_cell int (cast: (@@: int) (@ c.l2_m_dyn))
    @@: m_hcap_cell int (cast: (@@: int) (@ c.l2_m_hcap))
    size_t: cap
    size_t: need_u
    int: i
    size_t: nb
    size_t: ni
    size_t: psz
    @@: nn c.LmP0Text 0
    @: nt int 0
    @@: on c.LmP0Text
    @: ot int
    if: mi < 0 || need < 0
        return: (cast: (int) (1))
    if: need <= m_hcap_cell[0][mi]
        return: (cast: (int) (0))
    need_u: (cast: (size_t) need)
    cap: (cast: (size_t) m_hcap_cell[0][mi])
    if: cap < 1U
        cap: 4U
    while: cap < need_u
        if: cap > ((cast: (size_t) -1) / 2U)
            alloc_err_cell[0]: 2
            return: (cast: (int) (1))
        cap: cap * 2U
    if: cap > (cast: (size_t) c.INT_MAX) && need_u > (cast: (size_t) c.INT_MAX)
        alloc_err_cell[0]: 2
        return: (cast: (int) (1))
    if: cap > (cast: (size_t) c.INT_MAX)
        cap: need_u
        ---
    psz: c.sizeof((cast: (@: char) 0))
    if: c.lm_compiler_mul_ok((cast: (size_t) cap), psz) = 0
        alloc_err_cell[0]: 2
        return: (cast: (int) (1))
    if: c.lm_compiler_mul_ok((cast: (size_t) cap), c.sizeof(c.int)) = 0
        alloc_err_cell[0]: 2
        return: (cast: (int) (1))
    nb: cap * psz
    ni: cap * c.sizeof(c.int)
    alloc_kind_cell[0]: 2
    nn: (cast: (@@: c.LmP0Text) c.lm_compiler_xmalloc(nb))
    nt: (cast: (@: int) c.lm_compiler_xmalloc(ni))
    if: nn = 0 || nt = 0
        if: nn != 0
            c.lm_compiler_xfree((cast: (@: void) nn))
        if: nt != 0
            c.lm_compiler_xfree((cast: (@: void) nt))
        return: (cast: (int) (1))
    c.memset((cast: (@: void) nn), 0, nb)
    c.memset((cast: (@: void) nt), 0, ni)
    on: (cast: (@@: c.LmP0Text) m_dn_cell[0][mi])
    ot: m_dt_cell[0][mi]
    i: 0
    while: i < m_dyn_cell[0][mi]
        nn[i]: on[i]
        nt[i]: ot[i]
        i: i + 1
    if: on != 0
        c.lm_compiler_xfree((cast: (@: void) on))
    if: ot != 0
        c.lm_compiler_xfree((cast: (@: void) ot))
    m_dn_cell[0][mi]: nn
    m_dt_cell[0][mi]: nt
    m_hcap_cell[0][mi]: (cast: (int) cap)
    return: (cast: (int) (0))
end: lm_compiler_hidden_reserve

fn: lm_compiler_method_source_scope (const: (@: source_node c.LmP0Node)) @: c.LmP0Structure
    const: (@@: cur_unit_cell c.LmP0Structure (cast: (const: @@: c.LmP0Structure) (@ c.l2_cur_unit)))
    @@@: part_doc_cell c.LmP0Document (cast: (@@@: c.LmP0Document) (@ c.l2_part_doc))
    @: part_n_cell int (cast: (@: int) (@ c.l2_part_n))
    const: (@@: ruse_unit_cell c.LmP0Structure (cast: (const: @@: c.LmP0Structure) (@ c.l2_ruse_unit)))
    @: scope c.LmP0Structure c.lm_compiler_source_parent_body(ruse_unit_cell[0], source_node)
    const: (@: root c.LmP0Node)
    int: part 0
    if: scope = 0 && cur_unit_cell[0] != ruse_unit_cell[0]
        scope: c.lm_compiler_source_parent_body(cur_unit_cell[0], source_node)
    while: scope = 0 && part_doc_cell[0] != 0 && part < part_n_cell[0]
        root: c.lm_p0_document_root(part_doc_cell[0][part])
        if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0
            scope: c.lm_compiler_source_parent_body(root\as\structure, source_node)
        part: part + 1
    ---
    return: (cast: (@: c.LmP0Structure) (scope))
end: lm_compiler_method_source_scope

fn: lm_compiler_method_duplicate (const: (@: source_node c.LmP0Node); const: (@: name c.LmP0Text); int: host) int
    @: m_n_cell int (cast: (@: int) (@ c.l2_m_n))
    @@@: m_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_m_name))
    @@@: m_node_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_m_node))
    @: scope c.LmP0Structure lm_compiler_method_source_scope(source_node)
    int: mi 0
    while: mi < m_n_cell[0]
        if: c.lm_compiler_text_same(m_name_cell[0][mi], name) != 0 && c.lm_compiler_mad_host_of(mi) = host
            if: host < 0 || lm_compiler_method_source_scope(m_node_cell[0][mi]) = scope
                return: (cast: (int) (mi))
            ---
        ---
        mi: mi + 1
    return: (cast: (int) (-1))
end: lm_compiler_method_duplicate

fn: lm_compiler_method_source_own (int: mi) int
    @: e_cell int (cast: (@: int) (@ c.l2_e))
    @: m_n_cell int (cast: (@: int) (@ c.l2_m_n))
    @@@: m_node_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_m_node))
    @@@: own_decl_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_own_decl))
    @@@: own_host_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_own_host))
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    int: own 0
    if: mi < 0 || mi >= m_n_cell[0] || m_node_cell[0][mi] = 0
        return: (cast: (int) (-1))
    while: own < own_n_cell[0]
        if: own_decl_cell[0][own] = m_node_cell[0][mi]
            if: own_mi_cell[0][own] = e_cell[0] && own_host_cell[0][own] = 0
                return: (cast: (int) (-1))
            return: (cast: (int) (own))
        own: own + 1
    return: (cast: (int) (-1))
end: lm_compiler_method_source_own

fn: lm_compiler_unit_names_method (const: (@: name c.LmP0Text)) int
    const: (@@: cur_unit_cell c.LmP0Structure (cast: (const: @@: c.LmP0Structure) (@ c.l2_cur_unit)))
    @@@: part_doc_cell c.LmP0Document (cast: (@@@: c.LmP0Document) (@ c.l2_part_doc))
    @: part_n_cell int (cast: (@: int) (@ c.l2_part_n))
    const: (@@: ruse_unit_cell c.LmP0Structure (cast: (const: @@: c.LmP0Structure) (@ c.l2_ruse_unit)))
    int: k 0
    const: (@: source_node c.LmP0Node)
    const: (@: root c.LmP0Structure)
    if: name = 0
        return: (cast: (int) (0))
    if: c.lm_compiler_root_names_method(cur_unit_cell[0], name) != 0
        return: (cast: (int) (1))
    if: ruse_unit_cell[0] != cur_unit_cell[0] && c.lm_compiler_root_names_method(ruse_unit_cell[0], name) != 0
        return: (cast: (int) (1))
    while: part_doc_cell[0] != 0 && k < part_n_cell[0]
        source_node: c.lm_p0_document_root(part_doc_cell[0][k])
        if: source_node != 0 && source_node\kind = c.LM_P0_NODE_STRUCTURE && source_node\as != 0
            root: source_node\as\structure
            if: root != cur_unit_cell[0] && root != ruse_unit_cell[0] && c.lm_compiler_root_names_method(root, name) != 0
                return: (cast: (int) (1))
            ---
        ---
        k: k + 1
    ---
    return: (cast: (int) (0))
end: lm_compiler_unit_names_method

fn: lm_compiler_unit_item (const: (@: item c.LmP0Node)) int
    const: (@@: cur_unit_cell c.LmP0Structure (cast: (const: @@: c.LmP0Structure) (@ c.l2_cur_unit)))
    @: f c.LmP0Field
    if: cur_unit_cell[0] = 0 || item = 0
        return: (cast: (int) (0))
    f: c.lm_compiler_next_active(cur_unit_cell[0]\first_field)
    while: f != 0
        if: f\value = item
            return: (cast: (int) (1))
        f: c.lm_compiler_next_active(f\next)
    ---
    return: (cast: (int) (0))
end: lm_compiler_unit_item

fn: lm_compiler_unit_defines_branch (const: (@: t c.LmP0Text); const: (@: stop c.LmP0Node)) int
    const: (@@: cur_unit_cell c.LmP0Structure (cast: (const: @@: c.LmP0Structure) (@ c.l2_cur_unit)))
    @: f c.LmP0Field
    if: cur_unit_cell[0] = 0 || t = 0
        return: (cast: (int) (0))
    f: c.lm_compiler_next_active(cur_unit_cell[0]\first_field)
    while: f != 0 && f\value != stop
        if: c.lm_compiler_frame_head(f\value, "independent") != 0 && c.lm_compiler_tree_branch_root(f\value, t) != 0
            return: (cast: (int) (1))
        f: c.lm_compiler_next_active(f\next)
    ---
    return: (cast: (int) (0))
end: lm_compiler_unit_defines_branch

fn: lm_compiler_ns_procs_free () int
    @@@: m_body_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_m_body))
    @: ns_n_cell int (cast: (@: int) (@ c.l2_ns_n))
    @@: ns_proc_cell int (cast: (@@: int) (@ c.l2_ns_proc))
    int: ni 0
    int: mi
    while: ni < ns_n_cell[0]
        mi: ns_proc_cell[0][ni]
        if: mi >= 0
            c.lm_compiler_ns_proc_body_free(ni, m_body_cell[0][mi])
            m_body_cell[0][mi]: 0
            ns_proc_cell[0][ni]: -1
        ---
        ni: ni + 1
    ---
    return: (cast: (int) (0))
end: lm_compiler_ns_procs_free

fn: lm_compiler_ns_source_body (int: ni) @: c.LmP0Structure
    @@@: m_body_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_m_body))
    @@: ns_proc_cell int (cast: (@@: int) (@ c.l2_ns_proc))
    int: mi
    @: body c.LmP0Structure c.lm_compiler_ns_original_body(ni)
    if: body = 0
        return: (cast: (@: c.LmP0Structure) (0))
    mi: ns_proc_cell[0][ni]
    if: mi < 0 || m_body_cell[0][mi] = 0 || m_body_cell[0][mi]\as = 0 || m_body_cell[0][mi]\as\structure != body
        return: (cast: (@: c.LmP0Structure) (0))
    return: (cast: (@: c.LmP0Structure) (body))
end: lm_compiler_ns_source_body

fn: lm_compiler_m_file (int: mi) int
    int: k
    k: lm_compiler_m_part(mi)
    if: k < 0
        k: c.lm_compiler_ns_part(c.lm_compiler_m_nsof(mi))
    return: (cast: (int) (k))
end: lm_compiler_m_file

fn: lm_compiler_m_code_file (int: mi) int
    @: m_n_cell int (cast: (@: int) (@ c.l2_m_n))
    @@: ns_local_cell int (cast: (@@: int) (@ c.l2_ns_local))
    int: k
    int: ni
    int: steps 0
    while: mi >= 0 && mi < m_n_cell[0] && steps <= m_n_cell[0]
        k: lm_compiler_m_file(mi)
        if: k >= 0
            return: (cast: (int) (k))
        ni: c.lm_compiler_m_nsof(mi)
        if: ni >= 0
            ni: c.lm_compiler_ns_top(ni)
            k: c.lm_compiler_ns_part(ni)
            if: k >= 0
                return: (cast: (int) (k))
            mi: ns_local_cell[0][ni]
            ---
        else:
            mi: c.lm_compiler_mad_host_of(mi)
            ---
        steps: steps + 1
    return: (cast: (int) (-1))
end: lm_compiler_m_code_file

fn: lm_compiler_own_find (int: mi; const: (@: t c.LmP0Text)) int
    @@@: own_host_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_own_host))
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@@: own_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_own_name))
    int: i 0
    if: t = 0
        return: (cast: (int) (-1))
    while: i < own_n_cell[0]
        if: own_mi_cell[0][i] = mi && c.lm_compiler_text_same(own_name_cell[0][i], t) && own_host_cell[0][i] = 0
            return: (cast: (int) (i))
        if: own_mi_cell[0][i] = mi && c.lm_compiler_text_same(own_name_cell[0][i], t) && lm_compiler_scope_has(own_host_cell[0][i])
            return: (cast: (int) (i))
        i: i + 1
    ---
    # A unit field is an own field of the entry E, whose occurrence is the unit:
    # visible through the callable's node chain from below its declaration.
    # Prefer a method/body occurrence above; only then fall back to it.
    i: 0
    while: i < own_n_cell[0]
        # The cheap name compare first, the unit-visibility walk (m_code_file, source_definition_method, callable_source_node, vis_ok --
        # reads only) after it: the same rows satisfy both, so the result is the same; own_unit_seen runs for same-name rows only
        # (prof02 gdb snapshots 1, 2 sat in this walk under own_at). The same order in own_find_last, own_at and own_lexical below.
        if: c.lm_compiler_text_same(own_name_cell[0][i], t) && lm_compiler_own_unit_seen(i, mi) != 0
            return: (cast: (int) (i))
        i: i + 1
    return: (cast: (int) (-1))
end: lm_compiler_own_find

fn: lm_compiler_own_binding_after (int: row; int: previous) int
    @@@: own_host_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_own_host))
    @@@: scope_at_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_scope_at))
    @: scope_n_cell int (cast: (@: int) (@ c.l2_scope_n))
    int: i 0
    int: row_depth 0
    int: previous_depth 0
    if: previous < 0
        return: (cast: (int) (1))
    while: i < scope_n_cell[0]
        if: own_host_cell[0][row] = scope_at_cell[0][i]
            row_depth: i + 1
        if: own_host_cell[0][previous] = scope_at_cell[0][i]
            previous_depth: i + 1
        i: i + 1
    if: row_depth != previous_depth
        return: (cast: (int) (row_depth > previous_depth))
