DeliveryQuote:
    int: quantity
    int: price
    int: weight
    int: zone
    return: int
    subtotal:
        return: quantity * price
    fee:
        return: weight * 2 + zone * 5
    quote:
        return: subtotal() + fee()
    demo:
        int: first quote(2; 7; 4; 2)
        return: first + quote(0; 7; 4; 2)
