        return: (cast: (int) (1))
    if: lm_compiler_rw_contract(prim, 1 + nc, 0, 1, @ contract, @ inputs) != 0 || lm_compiler_rw_signature_witness(inputs, 0, 0, 1) != 0
        return: (cast: (int) (1))
    k: 0
    ci: 1
    while: k < mcap_n_cell[0]
        if: c.lm_compiler_mad_cap_staged(mi, k) != 0
            if: lm_compiler_rw_signature_witness(inputs, ci, mcap_ty_cell[0][k], (cast: (int) ((cast: (int) (c.lm_compiler_schema_kind(mcap_ns_cell[0][k]) != 0))))) != 0
