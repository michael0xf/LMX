---
    Observed:
        int: seen 0
    end: Observed
---
Model:
    int: a 0
    int: b 0
end: Model
fn: f (@: s Model) int
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) 1
    return: 1
end: f
fn: f (int: a; int: b) int
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) 2
    return: 2
end: f
sub: main () (
    S:
        int: a 1
        int: b 2
    end: S
)
    f: S
end: main
main:
