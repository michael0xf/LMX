# Missing named data place refuses the call before any body statement. The
# retained code's later structural write must not create a new data field.
S:
    int: flag 1
    T:
        int: v 1
end: S
D:
    int: flag 0
end: D
int: caught 0
---
    call: S D
    catch: call ()
        caught: 1
---
int: code 7
if: caught != 1 || D\flag != 0
    code: 95
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
