# Each positional call evaluates a once, including when its name matches the formal.
# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: first 0
        int: after_first 0
        int: second 0
        int: after_second 0
        int: altered 0
        int: preserved 0
)
fn: a (int: x) int (int: calls 0)
    data\calls := data\calls + 1
    return: x + 1
end: a
fn: mytest (int: a) int
    return: a + 30
end: mytest
fn: alter (int: x) int
    x := x + 2
    return: x
end: alter
int: first mytest(a(5))
int: after_first a\data\calls
int: second mytest(a: 5)
int: after_second a\data\calls
int: original 5
int: altered alter(original)
int: preserved original

sub: main ()
    @: shared node[0]
    shared\Observed\first := first
    shared\Observed\after_first := after_first
    shared\Observed\second := second
    shared\Observed\after_second := after_second
    shared\Observed\altered := altered
    shared\Observed\preserved := preserved
main()
