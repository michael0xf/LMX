# Original: l2src/l2trans.lm1:10396
fn: lm_compiler_expr_sites_dump (const: (@: path char)) int
    @@: expr_sites_cell c.L2ExpressionSite (cast: (@@: c.L2ExpressionSite) (@ c.l2_expr_sites))
    @: e_cell int (cast: (@: int) (@ c.l2_e))
    @: out c.FILE
    @: site c.L2ExpressionSite expr_sites_cell[0]
    int: bad 0
    if: path = 0 || path[0] = 0
        return: (cast: (int) (0))
    out: c.fopen(path, "wb")
    if: out = 0
        return: (cast: (int) (1))
    if: c.fprintf(out, "expr-places 1 entry=%d\n", e_cell[0]) < 0
        bad: 1
    # The existing oracle records whole source field runs. Literal leaves use
    # the same private map for native lowering but are not extra source runs.
    while: site != 0 && site\role != 0
        site: site\allocated_next
    while: site != 0
        if: c.fprintf(out, "site view=%d:%d method=%d span=", site\view_kind, site\view_index, site\method) < 0
            bad: 1
        if: site\node\span != 0
            if: c.fprintf(out, "%zu:%zu+%zu:%zu", site\node\span\line, site\node\span\column, site\node\span\offset, site\node\span\length) < 0
                bad: 1
            ---
        else:
            if: c.fprintf(out, "-") < 0
                bad: 1
            ---
        ---
        if: c.fprintf(out, " count=%d temp=%d state=", site\count, site\temp) < 0
            bad: 1
        if: site\state = 1
            if: c.fprintf(out, "bound place=%zu place_method=%d path=", site\place\id, site\place\method) < 0
                bad: 1
            c.lm_compiler_expr_place_path_print(out, (cast: (@: c.L2GraphPlace) (site\place)))
        else:
            if: site\state = 2
                if: c.fprintf(out, "unbound") < 0
                    bad: 1
                ---
            else:
                if: site\state = 3
                    if: c.fprintf(out, "ambiguous") < 0
                        bad: 1
                    ---
                else:
                    if: c.fprintf(out, "pending") < 0
                        bad: 1
                    ---
                ---
            ---
        ---
        if: c.fprintf(out, "\n") < 0
            bad: 1
        site: site\allocated_next
        while: site != 0 && site\role != 0
            site: site\allocated_next
    ---
    if: c.fprintf(out, "end-expr-places\n") < 0
        bad: 1
    if: c.fclose(out) != 0
        bad: 1
    return: (cast: (int) (bad))
end: lm_compiler_expr_sites_dump

