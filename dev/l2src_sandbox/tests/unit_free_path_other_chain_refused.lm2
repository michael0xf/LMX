# The same through a method that only hands the name on: has's Model and
# bad's Other reach r's box through mid, and the Other is refused when the
# program runs, where mid forms r's input (RECEPTION-EDGE-DEBTS (d)).
Other:
    int: w 1
end: Other

Model:
    int: v 4
end: Model

fn: r () int
    return: box\v + 1
end: r

fn: mid () int
    return: r()
end: mid

fn: has () int
    box: merge Model
    box\v: 30
    return: mid()
end: has

fn: bad () int
    box: merge Other
    return: mid()
end: bad

int: a has()
int: b bad()
sendMessage: exit(exit_code: a + b; stdout: ""; stderr: "")
return
