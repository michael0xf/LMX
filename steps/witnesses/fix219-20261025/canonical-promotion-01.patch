+    if: l2_rw_source_node(l2_span_node(values, 0), body, "LMX_WALK_OP_SOURCE_INERT", @ child) != 0 || l2_rw_put(body, 0, child) != 0 || l2_rw_machine_value(@ operand, body, @ child) != 0
+        return: 1
+return: l2_rw_put(body, 1, child)
