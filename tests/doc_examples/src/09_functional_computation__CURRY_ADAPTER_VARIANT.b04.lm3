FxLambda:
    private: @: operation
    return: @
    lambda:
        throws:
            FxArity
            FxIndex
            FxKernelFailure
            FxTypeToken
            ReceiverIndex
            SequenceSize
        private: @: info FxKernel\signature(subject := operation)
        return: FxLambdaStages\build(operation; info; (copy(())))
