predef: "l1src/parser.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<string.h>" "<limits.h>" "<stdlib.h>"

# L2 -> L1 frontend. The file is a Structure, the unit, and its root body is walked (plan §3;
# FABLE-OPUS-ROOT-WALK-TRANSLATOR-20260924-159): the root's statements are checked as the METHOD
# row E, whose occurrence is the unit, and built as walker nodes after the unit's fields.  The
# generated main is the launch (lmx_root_launch): the host reserves R0 and calls the unit's builder
# in R0's own arena, R0's one turn walks the unit, and the exit is the host's -- R0's exit letter
# (`sendMessage: exit(...)`), else the mapping of R0's success.  Methods are native, reached by their
# symbol or, dynamically, through their prim-ABI trampolines.

int: l2_library_mode 0
# Which predef declaration kind l2_predef_has_type is currently looking for:
# 0 = struct: only, 1 = fnptr: too. Set around one call and cleared after.
int: l2_want_fnptr 0
unsigned: l2_module_hash_a 2166136261U
unsigned: l2_module_hash_b 5381U
unsigned: l2_sigv 0U
unsigned: l2_intern_n 0U
