# `m: merge: Model` declares m; with Model and m both existing `Model: m` is Model's call with m (the author's rule,
# 55c1abc, as Codex decided it), not a second declaration of m -- an ordinary named Structure takes no argument:
# refused where it stands.  (Before the ticket the second `Model: m` declared m again; before K03 NS-ROLES-3 the first
# line was the old declaration `Model: m`.)
Model:
    size_t: value 1U
fn: g () int
    m: merge: Model
    Model: m
    return: 7
end: g
int: r 0
r: g()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
