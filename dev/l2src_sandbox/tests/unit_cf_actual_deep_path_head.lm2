# A two-step bare path transports Inner's tick, not Inner. An explicit call of the same occurrence produces its
# integer result independently of the receiving context. Both the call result and the selected counter are read.
Holder:
    Inner:
        int: n 0
        fn: tick () int
            Holder\Inner\n: Holder\Inner\n + 1
        return: Holder\Inner\n
    end: Inner
end: Holder
fn: proto () int
    return: 0
end: proto
fn: invoke (proto: f) int
    f()
    return: f()
end: invoke
fn: identity (int: value) int
    return: value
end: identity
int: got invoke(Holder\Inner\tick)
if: got != 2 || Holder\Inner\n != 2
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
int: value identity(Holder\Inner\tick())
if: value != 3 || Holder\Inner\n != 3
    sendMessage: exit(exit_code: 82; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
