# The same with a `node` path: `v: (cast: (size_t) node\k)` in a method reads the unit's k through the graph and casts
# it (was refused as an unknown type).  Entry 7.
int: k 5
fn: m () size_t
    size_t: v 0U
    v: (cast: (size_t) node\k)
    return: v
end: m
size_t: r 0U
r: m()
int: code 0
if: r = 5U
    code: 7
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
