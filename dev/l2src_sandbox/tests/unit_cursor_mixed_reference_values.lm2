Inner: (int: v 11)
Leaf: ([]: (@: Inner) items 2; int: x 13)
Middle: (int: pad 17; @: ref Leaf)
GoodInner: (int: pad 29; int: v 7)
GoodLeaf: (int: pad 31; int: x 13; []: (@: Inner) items 2)
GoodMiddle: (int: before 19; int: pad 17; @: ref Leaf)
GoodLeaf\items[1]: GoodInner
GoodMiddle\ref: GoodLeaf
Indices: (size_t: a 1U; size_t: b 1U)
Source: (int: amount 67)
int: callsA 0
int: callsB 0
fn: pickA (size_t: index) size_t
    node\callsA: node\callsA + 1
return: index
fn: pickB (size_t: index) size_t
    node\callsB: node\callsB + 1
return: index
fn: zero () int
return: 0
fn: check () int
    []: (@: Middle) roots 2
    roots[1]: GoodMiddle
    if: roots[pickA(Indices\a)]\ref\items[pickB(Indices\b)]\v != 7
        return: 81
    # Preparing this RHS reads a different path after resolving the LHS.
    roots[pickA(Indices\a)]\ref\items[pickB(Indices\b)]\v: Source\amount + zero()
    if: GoodInner\v != 67 || Source\amount != 67
        return: 82
    @: cell int @roots[pickA(Indices\a)]\ref\items[pickB(Indices\b)]\v
    if: \cell != 67
        return: 83
    \cell: 71
    if: roots[pickA(Indices\a)]\ref\items[pickB(Indices\b)]\v != 71 || GoodInner\v != 71
        return: 84
    if: node\callsA != 4 || node\callsB != 4 || GoodInner\pad != 29 || GoodLeaf\pad != 31 || GoodLeaf\x != 13 || GoodMiddle\before != 19 || GoodMiddle\pad != 17
        return: 85
    if: Inner\v != 11 || Leaf\x != 13 || Middle\pad != 17 || Indices\a != 1U || Indices\b != 1U
        return: 86
return: 7
sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
