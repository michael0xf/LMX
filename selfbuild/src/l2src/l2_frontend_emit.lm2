    n: c.lm_compiler_count_active(body)
    if: body\trailer != 0
        return: (cast: (int) (c.lm_compiler_error(path, at, "unsupported trailer")))
    if: m_ret_cell[0][mi] = 8 && n != 0
        return: (cast: (int) (c.lm_compiler_error(path, at, "unsupported body")))
    if: m_ret_cell[0][mi] != 8 && n = 0
        return: (cast: (int) (c.lm_compiler_error(path, at, "unsupported body")))
