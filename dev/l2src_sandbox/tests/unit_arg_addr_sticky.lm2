# FABLE-L2-ARG-ADDRESS-DIRTY-20260921-67.  The author's sticky rule, and its negatives.
#
#   sticky  <=>  x is a parameter and `@: x` was EVALUATED in this activation, before or after
#               the first executed binding. The selector is the publication target, not storage.
#   A binding line is an executed own declaration or an executed assignment-declaration of the
#   same name (docs/L2_spec); whichever runs first decides.  From it to the end of the activation
#   every checkpoint publishes the current local value and none of them clears the state.
#
# Every method names its field differently (na .. ne): under FABLE-SONNET-NODE-ROOT-20260923-121
# an explicit write is spelled through the method's OWN name (`before_bind\na: v`, not `node\x: v`
# -- node is now M.parent, not self), so the old cross-method-collision defect this comment used
# to report is now structurally impossible: there is no shared alias to scan multiple methods'
# fields through, only the current method's own resolved name.
#
# Each line printed is "<case> <local> <graph field>".
#
# HOW STICKINESS IS SEEN WITH LEGAL L2 ONLY.  `M\x: v` (M the enclosing method) writes the graph
# cell and not the activation's value.  A later checkpoint of a STICKY field publishes the local over it; a
# checkpoint of an ordinary field, whose dirty an earlier checkpoint cleared, leaves it alone.
# That is also what tells sticky from "raise dirty again after the call returns": the A2 and A4
# checkpoints follow no address-taking call at all.
#
# WORKAROUND, NAMED (GROK-FABLE-20260923-120 x FABLE-SONNET-NODE-ROOT-20260923-121): `M\x` read
# directly inside a compound expression (a printf argument list, here) lands in Grok Bot's -120
# c-member-access dispatch and emits a wrong raw C member access (`lmx_arena_ref_struct(node, N)
# ->x`) instead of a typed load -- a defect in that dispatcher's root test, handed to him as a
# separate ticket. Every read below is routed through a freshly assigned `<x>_g` local first
# (exactly unit_occ_root_field.lm2's pattern) and only the local is ever printed.
fn: poke5 (@: int p) int
    \p: 5
    return: 0
end: poke5
fn: poke9 (@: int p) int
    \p: 9
    return: 0
end: poke9
fn: nop () int
    return: 0
end: nop

# A. `@: na` BEFORE the first binding line, then the binding: sticky to the end.
#    One checkpoint before the address-taking call (nop) and five after the binding.
fn: before_bind (int: na) int
    int: na_g
    nop()
    poke5(@: na)
    int: na
    na: na + 1
    nop()
    na_g: before_bind\na
    c.printf: "A1 %d %d\n" na na_g
    before_bind\na: 100
    nop()
    na_g: before_bind\na
    c.printf: "A2 %d %d\n" na na_g
    poke9(@: na)
    na_g: before_bind\na
    c.printf: "A3 %d %d\n" na na_g
    before_bind\na: 200
    nop()
    nop()
    na_g: before_bind\na
    c.printf: "A4 %d %d\n" na na_g
    return: 0
end: before_bind

# B. NEVER BOUND, and now SEEN (FABLE-L2-ARG-ADDRESS-PROOF-20260921-84).  The declaration stays at
#    METHOD level, so `never_bound\nb` can read the field -- a field declared inside an `if` body lives in
#    that body's Structure and no path reaches it -- and an early `return` skips it, so with go = 0
#    its line never executes.  The first line is printed by BOTH activations, before the binding
#    line: nothing a parameter holds before that line is ever published, so the graph keeps the
#    100 written just above through two checkpoints while the local already holds the callee's 5.
#    "Taking the address makes the input publish from then on" prints B 5 5 here.  With go = 1 the
#    binding line then runs with the address already taken: sticky, B+ 6 6.  The third call is a
#    never-bound activation AFTER a sticky one: the state belongs to the activation, not the method.
fn: never_bound (int: nb; int: go) int
    int: nb_g
    poke5(@: nb)
    never_bound\nb: 100
    nop()
    nop()
    nb_g: never_bound\nb
    c.printf: "B %d %d\n" nb nb_g
    if: go = 0
        return: 0
    int: nb
    nb: nb + 1
    never_bound\nb: 200
    nop()
    nb_g: never_bound\nb
    c.printf: "B+ %d %d\n" nb nb_g
    return: 0
end: never_bound

# C. The binding FIRST, `@: nc` after it: now sticky too.  C2 is before the next checkpoint
#    so the graph still holds the published binding; C3 republishes the pointer write.
fn: after_bind (int: nc) int
    int: nc_g
    int: nc
    nc: nc + 1
    nop()
    nc_g: after_bind\nc
    c.printf: "C1 %d %d\n" nc nc_g
    poke9(@: nc)
    nc_g: after_bind\nc
    c.printf: "C2 %d %d\n" nc nc_g
    after_bind\nc: 100
    nop()
    nc_g: after_bind\nc
    c.printf: "C3 %d %d\n" nc nc_g
    return: 0
end: after_bind

# D. One method, both orders: the condition decides at RUN time whether the address comes before
#    the binding.  A translator that decides stickiness from the text alone fails one of the two.
fn: either (int: nd; int: early) int
    int: nd_g
    if: early != 0
        poke5(@: nd)
    int: nd
    nd: nd + 1
    if: early = 0
        poke5(@: nd)
    nop()
    either\nd: 100
    nop()
    nd_g: either\nd
    c.printf: "D%d %d %d\n" early nd nd_g
    return: 0
end: either

# E. The DECLARATION is a binding line too: declared first, address after, assignment last --
#    @ after binding is still sticky.
fn: decl_binds (int: ne) int
    int: ne_g
    int: ne
    poke5(@: ne)
    ne: ne + 1
    nop()
    decl_binds\ne: 100
    nop()
    ne_g: decl_binds\ne
    c.printf: "E %d %d\n" ne ne_g
    return: 0
end: decl_binds

before_bind(3)
never_bound(3, 0)
never_bound(3, 1)
never_bound(3, 0)
after_bind(3)
either(3, 1)
either(3, 0)
decl_binds(3)
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
