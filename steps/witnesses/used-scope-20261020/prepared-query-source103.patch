+# An early common-adapter query can precede source-use collection. Select
+# its exact borrowed P0 run in its current source environment, not a name,
+# a matching text or an incidental result from another scope. It remains
+# compiler query0, not a source/Consumer use. 0 absent,1 unique,2 ambiguous.
+fn: l2_query_fact_find (@: LmP0Field first; int: n; int: mi; @@: L2PathFact out) int
+    @: L2PathFact fact l2_path_facts
+    @: L2PathFact found 0
+    if: out = 0
+        return: 2
+    \out: 0
+    l2_reference_fields(@ first, @ n)
+    if: first = 0 || n < 1 || mi < 0 || mi >= l2_m_n
+        return: 0
+    while: fact != 0
+        if: fact\source_use = 0 && fact\stage = 1 && fact\method = mi && fact\source_method = l2_here_source_mi && fact\source = l2_here_node && fact\resolved.source_first = first && fact\resolved.run_count = n && fact\use_site != 0
+            if: found != 0
+                return: 2
+            found: fact
+        ---
+        fact: fact\next
+    ---
+    \out: found
+return: (cast: (int) (found != 0))
