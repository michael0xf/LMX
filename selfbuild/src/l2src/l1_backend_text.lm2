                    else:
                        return: (cast: (int) (1))
        ---
        field: field\next
    if: name_out[0] = 0 || params_out[0] = 0 || ret_out[0] = 0
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: l1_hdr_fnptr_parts

# Original: l1src/l1trans.lm1:6464
fn: l1_emit_hdr_type_alias (@: out c.FILE; const: (@: frame c.LmP0Frame); const: (@: path char); const: (@: source_node c.LmP0Node)) int
    @: field c.LmP0Field
    const: (@: name c.LmP0Text)
    const: (@: tnode c.LmP0Node)
    if: frame = 0 || frame\body = 0
        return: (cast: (int) (l1_error(path, source_node, "type alias missing name")))
    field: frame\body\first_field
    while: field != 0 && l1_node_ignored((cast: (const: @: c.LmP0Node) field\value))
        field: field\next
    if: field = 0 || field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
        return: (cast: (int) (l1_error(path, source_node, "type alias missing name")))
    name: field\value\as\atom
    if: l1_write_cstr(out, "typedef") != 0
        return: (cast: (int) (1))
    field: field\next
    while: field != 0
        if: l1_node_ignored((cast: (const: @: c.LmP0Node) field\value)) = 0
            tnode: field\value
            if: tnode = 0 || tnode\kind != c.LM_P0_NODE_ATOM
                return: (cast: (int) (l1_error(path, tnode, "type alias expects type name atoms")))
            if: l1_write_cstr(out, " ") != 0
                return: (cast: (int) (1))
            if: l1_write_type_spelling(out, (cast: (const: @: c.LmP0Text) tnode\as\atom), path, tnode) != 0
                return: (cast: (int) (1))
            ---
        ---
        field: field\next
    ---
    if: l1_write_cstr(out, " ") != 0
        return: (cast: (int) (1))
    if: l1_write_ident(out, name, path, source_node) != 0
        return: (cast: (int) (1))
    if: l1_write_cstr(out, ";\n") != 0
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: l1_emit_hdr_type_alias
