+++ src/l2src/lmx.h.lm1
@@ -323,0 +324,18 @@ end: LmxRangeDynamicArray
+# Complete current activation/cell Value. The typed pool owns one context
+# companion per physical pointer cell; neither graph fields nor admission
+# history identify that current state. The historic name is backend-neutral.
+struct: LmxWalkValue
+    int: present
+    int: kind
+    int: type
+    @: void ref
+    int: number
+    size_t: wide
+    unsigned: natural
+    ulong: longnum
+    char: byte
+    @: Lmx model
+    @: Lmx references
+    @: LmxWalkValue referent
+end: LmxWalkValue
+
@@ -325,0 +344,4 @@ struct: LmxChunk
+    # Pointer-cell context companions are trailing storage of THIS chunk's
+    # record allocation. Exact cell ordinal selects its state, not a second
+    # address/Model registry. Caller-owned unaccompanied chunks leave this 0.
+    @: LmxWalkValue value_contexts
