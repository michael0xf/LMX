# The letter as receiveMessage gives it is a graph with no declared type: a path
# through it has no fields to walk, so its first name resolves to nothing (R5-3b: the
# step list reads the base as any path does; before, the two-literal-index route said
# "an indexed field path needs a root of a declared Structure type").  A program
# declares `@: MainLetter m` first.
receiveMessage: m
if: m\mainArgs[1][0] != 0
    return: 1
return: 0
