--- /dev/null
+++ b/dev/l2src_sandbox/l2_machine_types.lm2
@@ -0,0 +1,22 @@
+# Common C99 machine-expression result contracts. These functions use the
+# existing compiler type interner through its ordinary C ABI; they do not
+# resolve source names or manufacture graph numeric cells.
+predef: "l1src/p0.h.lm1"
+predef: "l2src/l2_machine_types_abi.h.lm1"
+include: "<stddef.h>"
+
+fn: lm_compiler_ptrdiff_type () int
+    c.LmP0Text: name
+    name\data: "ptrdiff_t"
+    name\length: 9U
+    return: (cast: (int) c.l2_foreign_intern_parts(@ name, 0, 0, 1))
+end: lm_compiler_ptrdiff_type
+
+fn: lm_compiler_pointer_difference (int: left; int: right) int
+    # Both source operands must already be resolved machine object pointers.
+    # Foreign typedef compatibility and completeness remain checked by C on
+    # the original subtraction, as for the existing pointer-offset C door.
+    if: c.l2_value_offset_pointer(left) = 0 || c.l2_value_offset_pointer(right) = 0
+        return: -1
+    return: lm_compiler_ptrdiff_type()
+end: lm_compiler_pointer_difference
