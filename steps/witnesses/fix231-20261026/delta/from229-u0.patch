+fn: shape_lit_int (@: arena c.LmxArena; @: item void; int: want) int
+    @: cell void 0
+    @: holder c.Lmx 0
+    if: shape_node_op(item, arena) != c.LMX_WALK_OP_LIT || c.lmx_domain_kind(arena, item) != c.LMX_KIND_STRUCT
+        return: 0
+    holder: (cast: (@: c.Lmx) item)
+    @: holder_fields c.VoidArray @ holder\array
+    if: holder_fields\size < 2U
+        return: 0
+    cell: c.lmx_arena_ref_value(holder, 1U)
+    if: cell != 0 && c.lmx_domain_kind(arena, cell) = c.LMX_KIND_PRIMITIVE && c.lmx_domain_type(arena, cell) = c.LMX_TYPE_INT && c.lmx_int_value_known(cell) = want
+        return: 1
+    return: 0
+end: shape_lit_int
+
+fn: shape_body (@: arena c.LmxArena; @: item void) @: void
+    int: op
+    size_t: n 0U
+    @: holder c.Lmx 0
+    if: item = 0 || c.lmx_domain_kind(arena, item) != c.LMX_KIND_STRUCT
+        return: 0
+    op: shape_node_op(item, arena)
+    if: op != c.LMX_WALK_OP_IF && op != c.LMX_WALK_OP_WHILE && op != c.LMX_WALK_OP_FOR && op != c.LMX_WALK_OP_ELSE
+        return: 0
+    holder: (cast: (@: c.Lmx) item)
+    @: holder_fields c.VoidArray @ holder\array
+    n: holder_fields\size
+    if: op = c.LMX_WALK_OP_ELSE
+        if: n < 2U
+            return: 0
+        return: c.lmx_arena_ref_value(holder, 1U)
+    ---
+    if: n < 3U
+        return: 0
+    return: c.lmx_arena_ref_value(holder, 2U)
+end: shape_body
+
+fn: shape_swap_values (@: arena c.LmxArena; @: holder c.Lmx) int
+    size_t: i 0U
+    size_t: first 0U
+    int: found 0
+    @: child void 0
+    @: previous void 0
+    @: nested c.Lmx 0
+    @: holder_fields c.VoidArray @ holder\array
+    while: i < holder_fields\size
+        child: c.lmx_arena_ref_value(holder, i)
+        if: child != 0 && c.lmx_domain_kind(arena, child) = c.LMX_KIND_PRIMITIVE && c.lmx_domain_type(arena, child) = c.LMX_TYPE_INT
+            if: found = 0
+                first: i
+                found: 1
+            else:
+                previous: c.lmx_arena_ref_value(holder, first)
+                c.lmx_arena_ref_store(holder, first, child)
+                c.lmx_arena_ref_store(holder, i, previous)
+                return: 1
+            ---
+        ---
+        i: i + 1U
+    ---
+    i: 0U
+    while: i < holder_fields\size
+        child: c.lmx_arena_ref_value(holder, i)
+        if: child != 0 && c.lmx_domain_kind(arena, child) = c.LMX_KIND_STRUCT
+            nested: (cast: (@: c.Lmx) child)
+            if: nested\parent = holder && shape_swap_values(arena, nested) != 0
+                return: 1
+            ---
+        ---
+        i: i + 1U
+    ---
+    return: 0
+end: shape_swap_values
+
+fn: shape_add_owner (@: arena c.LmxArena; @: holder c.Lmx; int: left; int: right; @@: selected c.Lmx) int
+    size_t: i 0U
+    int: found 0
+    @: child void 0
+    @: nested c.Lmx 0
+    if: holder = 0
+        return: 0
+    @: holder_fields c.VoidArray @ holder\array
+    while: i < holder_fields\size
+        child: c.lmx_arena_ref_value(holder, i)
+        if: child != 0 && c.lmx_domain_kind(arena, child) = c.LMX_KIND_STRUCT
+            nested: (cast: (@: c.Lmx) child)
+            @: nested_fields c.VoidArray @ nested\array
+            if: nested\parent = holder
+                if: shape_node_op(holder, arena) < 0 && shape_node_op(child, arena) = c.LMX_WALK_OP_ADD && nested_fields\size = 3U
+                    if: shape_lit_int(arena, c.lmx_arena_ref_value(nested, 1U), left) != 0 && shape_lit_int(arena, c.lmx_arena_ref_value(nested, 2U), right) != 0
+                        \selected: holder
+                        found: found + 1
+                    ---
+                ---
+                found: found + shape_add_owner(arena, nested, left, right, selected)
+            ---
+        ---
+        i: i + 1U
+    ---
+    return: found
+end: shape_add_owner
+
+fn: shape_has_spell (@: arena c.LmxArena; @: item void; const: (@: word char)) int
+    size_t: i 0U
+    @: cell void 0
+    @: text c.VoidArray 0
+    @: chars c.LmxArray 0
+    @: holder c.Lmx 0
+    size_t: text_length
+    if: item = 0 || word = 0
+        return: 0
+    text_length: c.strlen(word)
+    text: c.lmx_source_name_get(arena, item)
+    if: text != 0 && text\size = text_length && (text_length = 0U || c.memcmp((text\data), (cast: (@: void) word), text_length) = 0)
+        return: 1
+    if: c.lmx_domain_kind(arena, item) = c.LMX_KIND_ARRAY && c.lmx_domain_type(arena, item) = c.LMX_TYPE_ARRAY_OF_CHAR
+        chars: (cast: (@: c.LmxArray) item)
+        @: chars_fields c.VoidArray @ chars\array
+        return: (cast: (int) (chars_fields\size = text_length && (text_length = 0U || c.memcmp((chars_fields\data), (cast: (@: void) word), text_length) = 0)))
+    if: c.lmx_domain_kind(arena, item) != c.LMX_KIND_STRUCT
+        return: 0
+    holder: (cast: (@: c.Lmx) item)
+    @: holder_fields c.VoidArray @ holder\array
+    while: i < holder_fields\size
+        cell: c.lmx_arena_ref_value(holder, i)
+        if: cell != 0
+            text: c.lmx_source_name_get(arena, cell)
+            if: text != 0 && text\size = text_length && (text_length = 0U || c.memcmp((text\data), (cast: (@: void) word), text_length) = 0)
+                return: 1
+            ---
+        ---
+        i: i + 1U
+    ---
+    return: 0
+end: shape_has_spell
+
+fn: shape_int_declaration (@: arena c.LmxArena; @: box c.Lmx; size_t: at; int: want) int
+    @: cell void
+    @: init c.Lmx
+    @: own c.Lmx
+    @: lit c.Lmx
+    @: index void
+    cell: c.lmx_arena_ref_value(box, at)
+    if: cell = 0 || c.lmx_domain_kind(arena, cell) != c.LMX_KIND_PRIMITIVE || c.lmx_domain_type(arena, cell) != c.LMX_TYPE_INT
+        return: 0
+    if: c.lmx_int_value_known(cell) != want
+        return: 0
+    init: (cast: (@: c.Lmx) c.lmx_arena_ref_value(box, at + 1U))
+    if: init = 0 || c.lmx_domain_kind(arena, init) != c.LMX_KIND_STRUCT
+        return: 0
+    @: init_fields c.VoidArray @ init\array
+    if: init\parent != box || init_fields\size != 3U || shape_node_op(init, arena) != c.LMX_WALK_OP_SET || shape_source_role(init, arena) != c.LMX_WALK_SOURCE_INITIALIZER
+        return: 0
+    own: (cast: (@: c.Lmx) c.lmx_arena_ref_value(init, 1U))
+    lit: (cast: (@: c.Lmx) c.lmx_arena_ref_value(init, 2U))
+    if: own = 0 || lit = 0 || c.lmx_domain_kind(arena, own) != c.LMX_KIND_STRUCT || c.lmx_domain_kind(arena, lit) != c.LMX_KIND_STRUCT
+        return: 0
+    @: own_fields c.VoidArray @ own\array
+    @: lit_fields c.VoidArray @ lit\array
+    if: own\parent != init || own_fields\size != 3U || shape_node_op(own, arena) != c.LMX_WALK_OP_OWN || shape_source_role(own, arena) != c.LMX_WALK_SOURCE_ORDINARY || c.lmx_arena_ref_value(own, 1U) != 0
+        return: 0
+    index: c.lmx_arena_ref_value(own, 2U)
+    if: index = 0 || c.lmx_domain_kind(arena, index) != c.LMX_KIND_PRIMITIVE || c.lmx_domain_type(arena, index) != c.LMX_TYPE_SIZE_T || c.lmx_size_value_known(index) != at
+        return: 0
+    if: lit\parent != init || lit_fields\size != 2U || shape_source_role(lit, arena) != c.LMX_WALK_SOURCE_ORDINARY || shape_lit_int(arena, lit, want) = 0
+        return: 0
+    return: 1
+end: shape_int_declaration
+
+fn: shape_one_int (@: arena c.LmxArena; @: item void) int
+    @: box c.Lmx
+    if: item = 0 || c.lmx_domain_kind(arena, item) != c.LMX_KIND_STRUCT
+        return: 0
+    box: (cast: (@: c.Lmx) item)
+    @: box_fields c.VoidArray @ box\array
+    if: box_fields\size != 2U
+        return: 0
+    return: shape_int_declaration(arena, box, 0U, 1)
+end: shape_one_int
+
+fn: shape_two_ints (@: arena c.LmxArena; @: item void) int
+    @: box c.Lmx
+    if: item = 0 || c.lmx_domain_kind(arena, item) != c.LMX_KIND_STRUCT
+        return: 0
+    box: (cast: (@: c.Lmx) item)
+    @: box_fields c.VoidArray @ box\array
+    if: box_fields\size != 4U
+        return: 0
+    return: shape_int_declaration(arena, box, 0U, 1) != 0 && shape_int_declaration(arena, box, 2U, 3) != 0
+end: shape_two_ints
+
+fn: shape_find_holder (@: arena c.LmxArena; @: graph c.Lmx) @: c.Lmx
+    size_t: i 0U
+    @: child void
+    @: box c.Lmx
+    @: found c.Lmx
+    if: graph = 0
+        return: 0
+    @: graph_fields c.VoidArray @ graph\array
+    if: shape_two_ints(arena, graph) != 0
+        return: graph
+    while: i < graph_fields\size
+        child: c.lmx_arena_ref_value(graph, i)
+        if: child != 0 && c.lmx_domain_kind(arena, child) = c.LMX_KIND_STRUCT
+            box: (cast: (@: c.Lmx) child)
+            if: box\parent = graph
+                found: shape_find_holder(arena, box)
+                if: found != 0
+                    return: found
+            ---
+        i: i + 1U
+    return: 0
+end: shape_find_holder
+
+fn: shape_find_nest (@: arena c.LmxArena; @: graph c.Lmx) @: c.Lmx
+    size_t: i 0U
+    @: child void 0
+    @: box c.Lmx
+    @: mid void
+    if: graph = 0
+        return: 0
+    @: graph_fields c.VoidArray @ graph\array
+    while: i < graph_fields\size
+        child: c.lmx_arena_ref_value(graph, i)
+        if: child != 0 && c.lmx_domain_kind(arena, child) = c.LMX_KIND_STRUCT
+            box: (cast: (@: c.Lmx) child)
+            @: box_fields c.VoidArray @ box\array
+            if: box_fields\size = 1U
+                mid: c.lmx_arena_ref_value(box, 0U)
+                if: shape_one_int(arena, mid) != 0
+                    return: box
+            ---
+        i: i + 1U
+    return: 0
+end: shape_find_nest
+
+fn: shape_arena_cells (@: arena c.LmxArena) size_t
+    @: pool c.LmxPool arena\arrays
+    @: chunk c.LmxChunk 0
+    size_t: total 0U
+    while: pool != 0
+        chunk: pool\head
+        while: chunk != 0
+            total: total + c.lmx_chunk_cells(chunk, pool\stride)
+            chunk: chunk\next
+        ---
+        pool: pool\next
+    ---
+    return: total
+end: shape_arena_cells
