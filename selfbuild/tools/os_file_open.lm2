# Unselected shared binary file opener/remover of the ordinary L2 tools.
# os_native is provided by os_native_path.lm2 in BOTH tool and child closures.
# Only the pathname is UTF-16 on Windows; no ccs= contents conversion.
include: "<stdio.h>" "<stdlib.h>"
os:
    win:
        include: "<windows.h>"
        fn: os_file_open (@: path char; @: mode char) @: c.FILE
            @: wpath c.void 0
            @: wmode c.void 0
            @: stream c.FILE 0
            if: path = 0 || mode = 0 || path[0] = (cast: (char) 0) || mode[0] = (cast: (char) 0)
                return: 0
            wpath: os_native(path)
            wmode: os_native(mode)
            if: wpath != 0 && wmode != 0
                stream: c._wfopen(wpath, wmode)
            c.free(wpath)
            c.free(wmode)
            return: stream
        end: os_file_open

        # A private binary scratch stream in the caller's fresh working
        # directory. MSVCRT tmpfile chooses the drive root instead. The OS
        # creates the unique empty file; D keeps delete-on-last-close.
        fn: os_file_temporary () @: c.FILE
            size_t: path_units (cast: (size_t) c.MAX_PATH)
            @: path c.WCHAR c.calloc(path_units, c.sizeof(c.WCHAR))
            @: directory c.void os_native(".")
            @: prefix c.void os_native("lmx")
            @: mode c.void os_native("w+bD")
            @: stream c.FILE 0
            if: path != 0 && directory != 0 && prefix != 0 && mode != 0
                if: c.GetTempFileNameW(directory, prefix, 0U, path) != 0U
                    stream: c._wfopen(path, mode)
                    if: stream = 0
                        c.DeleteFileW(path)
                    ---
                ---
            ---
            c.free(path)
            c.free(directory)
            c.free(prefix)
            c.free(mode)
            return: stream
        end: os_file_temporary

        # Remove the named entry itself, without resolving/following it first.
        # Preserve the ordinary CRT return value; no missing-file exemption.
        fn: os_file_remove (@: path char) int
            @: wide c.void 0
            int: result -1
            if: path = 0
                return: -1
            wide: os_native(path)
            if: wide = 0
                return: -1
            result: c._wremove(wide)
            c.free(wide)
            return: result
        end: os_file_remove
    default:
        fn: os_file_temporary () @: c.FILE
            return: (cast: (@: c.FILE) c.tmpfile())
        end: os_file_temporary

        fn: os_file_open (@: path char; @: mode char) @: c.FILE
            if: path = 0 || mode = 0 || path[0] = (cast: (char) 0) || mode[0] = (cast: (char) 0)
                return: 0
            return: (cast: (@: c.FILE) c.fopen(path, mode))
        end: os_file_open

        fn: os_file_remove (@: path char) int
            if: path = 0
                return: -1
            return: (cast: (int) c.remove(path))
        end: os_file_remove
end: os
