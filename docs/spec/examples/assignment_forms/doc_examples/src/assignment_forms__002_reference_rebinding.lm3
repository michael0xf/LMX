ReferenceRebinding:
    return: @
    run:
        throws: copy(`:=`\throws) ReceiverIndex
        []int: source [1 2 3]
        []int: other [7 8 9]
        @: selected source
        @: original selected
        selected := other
        selected[0] := 70
        return: (original[0] source[0] other[0] selected[0])
