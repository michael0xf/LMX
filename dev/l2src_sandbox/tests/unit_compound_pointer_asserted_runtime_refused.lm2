# The nested Model receiver must admit an opaque candidate in full even when
# the receiving cell itself is void. The callable runs once to produce Other.
Model:
    size_t: value 1U
end: Model
Other:
    int: a 1
    int: b 2
end: Other
fn: raw () @: void
return: (cast: (@: void) Other)
fn: check () int
    @: p 0
    @: p Model: raw()
return: 7
sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
