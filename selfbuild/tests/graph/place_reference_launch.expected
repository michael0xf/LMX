sub: main () (
    Model:
        int: v 1
        :=: v (v + 1)
    end: Model
    Add: (:= v (v + 10))
    D:
        int: v 0
    end: D
)
    return
end: main
main:
@: p Model
@: q Add
p:
q: ((main \ data) \ D)
fn: f () int
    p:
    q: (:= data ((main \ data) \ D))
    return: (((((main \ data) \ Model) \ v) * 100) + (((main \ data) \ D) \ v))
end: f
