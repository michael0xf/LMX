Model:
    size_t: x 1U
end: Model

B:
    size_t: z 2U
end: B

C:
    size_t: z 3U
end: C

# FABLE-OPUS-MERGE-PARTS-20260926-193 T1 (the author's merge rule, plan §4): merge makes no repeated
# names, so C's z belongs INTO the slot B added.  A pair into a slot an earlier operand added is the
# kernel's next step (-193 K1); until then the merge is refused, located, rather than giving R two z.
fn: m () int
    R: merge: Model B C
    return: 0
end: m

sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
