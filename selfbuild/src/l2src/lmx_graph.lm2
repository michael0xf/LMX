# The clean graph of the kernel implementation specification (docs/kernel-implementation.ru.md, EN beside it; the
# author's decisions of 2026-11-08, LMX_blog/2026-11-08.md): the common low-level constructor of the graph that the
# builder, the generated initialization of an emitted unit and fromLmx use alike (§1a), the primitives (§3.2), the word
# primitives (§3.3), the address -> name table of an arena (§5.1), the interned spellings of the process (§4) and the
# toLmx-like print of a graph (§8). Slice 309 is the vertical slice of §11 item 0: this module is the kernel side of
# the new path, built beside the old pipeline, which it does not touch.
#
# Representation (the spec's §2.2 regions on today's typed pools; stage 4 of the plan replaces the pools):
#   - an int place is an `int` cell of the arena's INT pool (lmx_int_new_profiled);
#   - a place without a value: its `int` cell, not yet written, and a pointer primitive of the UNINIT_INT pool pointing
#     at it (the author's same-cell clarification); every assignment writes into that cell (lmx_graph_assign_int).
#     The slot, pointer primitive, target address and physical types remain unchanged. This representation records
#     the declaration without an initializer, not a changing runtime initialized flag;
#   - a word primitive: a cell of the WORD pool holding the canonical address of its spelling (the author, 18:18Z:
#     service operators and receivers have no codes -- the same string addresses);
#   - an Lmx: the common Lmx header with `count` slots (lmx_node_new_owned / lmx_struct_new_profiled and
#     lmx_arena_refs_open_owned); a slot holds the address of a primitive or an Lmx (§3.1);
#   - the address -> name table of an arena: rows {address, name} kept by the arena's LmxGraph record (an index of
#     arena state, §5.1; not a graph value); the name is the canonical address of the spelling;
#   - the interned spellings: one process table (§4); the bytes of a spelling are a NUL-terminated run of cells of the
#     `text` region of the state's own arena (the owner of the string state), which never move or go away; comparing
#     identifiers is comparing these addresses (the author, 18:02Z). The index of the search by bytes (texts, sizes) is
#     heap state of the process, not a graph value.
# Service tables belong to the executor's whole traversal (§5.2). The common
# Space helpers here allocate/release the traversal namespace.
#
# A machine module (L2 section 20): each function has a direct C-compatible entry; the build writes its header,
# lmx_graph.h.lm1, from the exports named in bld_kernel_l2 (tools/build.lm2). Its records (LmxName, LmxGraph,
# LmxGraphState) are in lmx_arena.h.lm1 after LmxArena (decl_arena), the type codes LMX_TYPE_WORD, LMX_TYPE_NAME,
# LMX_TYPE_TEXT and LMX_TYPE_UNINIT_INT in lmx.h.lm1 (decl_lmx), both written by L3 code of the recipe; the process
# anchor lmx_graph_anchor is the generated state unit l2src/lmx_graph_state.lm1 (decl_graph_state), which only this
# module predefs.
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_pool.h.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l2src/lmx_checks.h.lm1"
predef: "l2src/lmx_value_owned.h.lm1"
predef: "l2src/lmx_walk.h.lm1"
predef: "l2src/lmx_source_names.h.lm1"
predef: "l2src/lmx_graph_state.lm1"
predef: "l2src/lmx_primitive_profile.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdlib.h>"
include: "<string.h>"
include: "<stdio.h>"
include: "<limits.h>"
include: "<float.h>"

# ---- The process state: the interned spellings and the graph records ---------------------------------------------

# The canonical copy of a spelling held by the state, or 0: the one search of bytes, at the input boundary (§4).
fn: lmx_graph_intern_find (@: state c.LmxGraphState; const: (@: text char); size_t: nb) @: char
    size_t: i 0U
    while: i < state\count
        if: state\sizes[i] = nb && (nb = 0U || c.memcmp((cast: (@: void) state\texts[i]), (cast: (@: void) text), nb) = 0)
            return: state\texts[i]
        ---
        i := i + 1U
    ---
    return: 0
end: lmx_graph_intern_find

# Room for one more spelling in the state's tables. 0, or 1 without memory.
fn: lmx_graph_intern_room (@: state c.LmxGraphState) int
    size_t: cap 0U
    @@: texts char 0
    @: sizes size_t 0
    if: state\count + 1U <= state\cap
        return: 0
    cap := 64U
    if: state\cap != 0U
        cap := state\cap * 2U
    texts := (cast: (@@: char) c.realloc((cast: (@: void) state\texts), cap * sizeof(@: char)))
    if: texts = 0
        return: 1
    state\texts := texts
    sizes := (cast: (@: size_t) c.realloc((cast: (@: void) state\sizes), cap * c.sizeof(c.size_t)))
    if: sizes = 0
        return: 1
    state\sizes := sizes
    state\cap := cap
    return: 0
end: lmx_graph_intern_room

# The canonical address of a spelling in this state: the one it holds, or a new NUL-terminated copy in the `text` region
# of the state's arena, which never moves or goes away. 0 without memory.
fn: lmx_graph_intern_in (@: state c.LmxGraphState; const: (@: text char); size_t: nb) @: char
    @: found char lmx_graph_intern_find(state, text, nb)
    @: copy char 0
    if: found != 0
        return: found
    if: lmx_graph_intern_room(state) != 0
        return: 0
    copy := (cast: (@: char) c.lmx_arena_take_n(state\spellings, 1U, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_TEXT, nb + 1U))
    if: copy = 0
        return: 0
    if: nb != 0U
        c.memcpy((cast: (@: void) copy), (cast: (@: void) text), nb)
    ---
    copy[nb] := (cast: (char) 0)
    state\texts[state\count] := copy
    state\sizes[state\count] := nb
    state\count := state\count + 1U
    return: copy
end: lmx_graph_intern_in

# The words of the language -- receivers, declaration words, the type words of the C door -- interned into
# state\receivers once, with the state: the one list the builder's input boundary (lm_graph_data_head) and the root's
# reading consult by canonical address (§6.2, lmx_graph_language_receiver). 0, or 1 without
# memory.
fn: lmx_graph_receivers_in (@: state c.LmxGraphState) int
    @: words char "fn sub fm if else while for do until finally return break continue redo switch case catch throw throws synchronized call fncall merge table args code data const immutable independent implements test post external send receive adopt length typeof cast sizeof enum struct include import predef prototype end L2"
    const: (@: primitive_names char c.lmx_primitive_profile_names)
    const: (@: c_names char c.lmx_primitive_profile_c_names)
    size_t: primitive_count c.lmx_primitive_profile_count
    @@: list char 0
    size_t: at 0U
    size_t: start 0U
    size_t: count 0U
    size_t: row 0U
    while: words[at] != 0
        if: words[at] != 32 && (at = 0U || words[at - 1U] = 32)
            count := count + 1U
        at := at + 1U
    ---
    if: primitive_count > ((cast: (size_t) -1) - count - 1U) / 2U
        return: 1
    list := (cast: (@@: char) c.calloc(count + primitive_count * 2U + 1U, sizeof(@: char)))
    if: list = 0
        return: 1
    at := 0U
    count := 0U
    while: words[at] != 0
        start := at
        while: words[at] != 0 && words[at] != 32
            at := at + 1U
        ---
        list[count] := lmx_graph_intern_in(state, (cast: (const: @: char) (words + start)), at - start)
        if: list[count] = 0
            c.free((cast: (@: void) list))
            return: 1
        count := count + 1U
        if: words[at] != 0
            at := at + 1U
        ---
    ---
    at := 0U
    while: row < primitive_count
        start := at
        while: c_names[at] != 0
            at := at + 1U
        if: at != start
            list[count] := lmx_graph_intern_in(state, c_names + start, at - start)
            if: list[count] = 0
                c.free((cast: (@: void) list))
                return: 1
            count := count + 1U
        row := row + 1U
        at := at + 1U
    at := 0U
    row := 0U
    while: row < primitive_count
        start := at
        while: primitive_names[at] != 0
            at := at + 1U
        ---
        list[count] := lmx_graph_intern_in(state, primitive_names + start, at - start)
        if: list[count] = 0
            c.free((cast: (@: void) list))
            return: 1
        count := count + 1U
        row := row + 1U
        at := at + 1U
    ---
    state\receivers := list
    state\receivers_count := count
    return: 0
end: lmx_graph_receivers_in

# The process's state, made on its first use: its own arena with the `text` region of the spellings (one array of 4096-byte
# chunks; a chunk is never moved or released before the process), the index of the spellings, the graph records and the
# words of the language the executors compare against (their canonical addresses, interned first). 0 without memory.
fn: lmx_graph_state () @: c.LmxGraphState
    @@: anchor c.LmxGraphState (cast: (@@: c.LmxGraphState) (@ c.lmx_graph_anchor))
    @: state c.LmxGraphState 0
    if: \anchor != 0
        return: \anchor
    state := (cast: (@: c.LmxGraphState) c.calloc(1U, c.sizeof(c.LmxGraphState)))
    if: state = 0
        return: 0
    state\spellings := (cast: (@: c.LmxArena) c.calloc(1U, c.sizeof(c.LmxArena)))
    if: state\spellings = 0 || c.lmx_arena_open(state\spellings) != 0
        return: 0
    if: c.lmx_pool_make_profiled(state\spellings, 4096U, 1U, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_TEXT, 0) = 0
        return: 0
    state\w_int := lmx_graph_intern_in(state, "int", 3U)
    state\w_plus := lmx_graph_intern_in(state, "+", 1U)
    state\w_minus := lmx_graph_intern_in(state, "-", 1U)
    state\w_star := lmx_graph_intern_in(state, "*", 1U)
    state\w_slash := lmx_graph_intern_in(state, "/", 1U)
    state\w_percent := lmx_graph_intern_in(state, "%", 1U)
    state\w_at := lmx_graph_intern_in(state, "@", 1U)
    state\w_deref := lmx_graph_intern_in(state, "\\", 1U)
    state\w_fn := lmx_graph_intern_in(state, "fn", 2U)
    state\w_sub := lmx_graph_intern_in(state, "sub", 3U)
    state\w_assign := lmx_graph_intern_in(state, ":=", 2U)
    state\w_return := lmx_graph_intern_in(state, "return", 6U)
    state\w_call := lmx_graph_intern_in(state, "call", 4U)
    # The special name of the data of a launch and the part of a callable of that name (the book, data-code-roles; the
    # author 2026-11-11: formerly `var`).
    state\w_data := lmx_graph_intern_in(state, "data", 4U)
    state\w_eq := lmx_graph_intern_in(state, "=", 1U)
    state\w_ne := lmx_graph_intern_in(state, "!=", 2U)
    state\w_lt := lmx_graph_intern_in(state, "<", 1U)
    state\w_le := lmx_graph_intern_in(state, "<=", 2U)
    state\w_gt := lmx_graph_intern_in(state, ">", 1U)
    state\w_ge := lmx_graph_intern_in(state, ">=", 2U)
    state\w_and := lmx_graph_intern_in(state, "&&", 2U)
    state\w_or := lmx_graph_intern_in(state, "||", 2U)
    state\w_not := lmx_graph_intern_in(state, "!", 1U)
    state\w_if := lmx_graph_intern_in(state, "if", 2U)
    state\w_else := lmx_graph_intern_in(state, "else", 4U)
    state\w_while := lmx_graph_intern_in(state, "while", 5U)
    state\w_for := lmx_graph_intern_in(state, "for", 3U)
    state\w_break := lmx_graph_intern_in(state, "break", 5U)
    state\w_continue := lmx_graph_intern_in(state, "continue", 8U)
    state\w_redo := lmx_graph_intern_in(state, "redo", 4U)
    state\w_until := lmx_graph_intern_in(state, "until", 5U)
    state\w_finally := lmx_graph_intern_in(state, "finally", 7U)
    state\w_merge := lmx_graph_intern_in(state, "merge", 5U)
    # The C door's declarations of a unit (L2: include, predef): they stand in the root, read by the translation.
    state\w_include := lmx_graph_intern_in(state, "include", 7U)
    state\w_predef := lmx_graph_intern_in(state, "predef", 6U)
    # The parts of a Structure that the receivers fn and sub create (args, return, data, code; the part code was
    # called `body` until the author's decision of 2026-11-11) and the names of the arguments of their contract (name,
    # ...); fm is a receiver of the language this slice does not implement.
    state\w_args := lmx_graph_intern_in(state, "args", 4U)
    state\w_code := lmx_graph_intern_in(state, "code", 4U)
    state\w_name := lmx_graph_intern_in(state, "name", 4U)
    state\w_fm := lmx_graph_intern_in(state, "fm", 2U)
    # The receiver of the type of an address (the book, get-type; lmx_graph_address_type).
    state\w_typeof := lmx_graph_intern_in(state, "typeof", 6U)
    if: state\w_typeof = 0
        return: 0
    # The index of a Structure (the book, structure-index): the operator word of the expression [base, [], index] the
    # builder makes of an attached `base[index]`, and the receiver of the number of its fields.
    state\w_index := lmx_graph_intern_in(state, "[]", 2U)
    state\w_apply := lmx_graph_intern_in(state, "()", 2U)
    state\w_length := lmx_graph_intern_in(state, "length", 6U)
    if: state\w_index = 0 || state\w_apply = 0 || state\w_length = 0
        return: 0
    # The receiver of a launch that returns a result (the book, call-receivers; lmx_graph_launch); `call` is its twin
    # without a result.
    state\w_fncall := lmx_graph_intern_in(state, "fncall", 6U)
    if: state\w_fncall = 0
        return: 0
    # The receiver of a letter (the book, send): `send: Message(field: value; ...)`, optionally after the Ref of the thread it goes to.
    state\w_send := lmx_graph_intern_in(state, "send", 4U)
    if: state\w_send = 0
        return: 0
    # The receiver of the level of code (the book #scope: «Код L2 пишется под ресивером `L2:`»): its record holds code of L2,
    # and an .lm2 file is wrapped in it (lmx_graph_file_code).
    state\w_l2 := lmx_graph_intern_in(state, "L2", 2U)
    if: state\w_l2 = 0
        return: 0
    # The reserved word node (the book, node): the space above the code a launch runs, never a place or a binding
    # (lmx_graph_node_space; plan M11 5b part 2).
    state\w_node := lmx_graph_intern_in(state, "node", 4U)
    if: state\w_node = 0
        return: 0
    if: state\w_until = 0 || state\w_finally = 0 || state\w_merge = 0 || state\w_include = 0 || state\w_predef = 0
        return: 0
    if: state\w_args = 0 || state\w_code = 0 || state\w_name = 0 || state\w_fm = 0
        return: 0
    if: state\w_eq = 0 || state\w_ne = 0 || state\w_lt = 0 || state\w_le = 0 || state\w_gt = 0 || state\w_ge = 0 || state\w_and = 0 || state\w_or = 0 || state\w_not = 0 || state\w_if = 0 || state\w_else = 0 || state\w_while = 0 || state\w_for = 0 || state\w_break = 0 || state\w_continue = 0 || state\w_redo = 0
        return: 0
    if: state\w_call = 0 || state\w_data = 0
        return: 0
    if: state\w_int = 0 || state\w_plus = 0 || state\w_minus = 0 || state\w_star = 0 || state\w_slash = 0 || state\w_percent = 0 || state\w_at = 0 || state\w_deref = 0 || state\w_fn = 0 || state\w_sub = 0 || state\w_assign = 0 || state\w_return = 0
        return: 0
    if: lmx_graph_receivers_in(state) != 0
        return: 0
    \anchor := state
    return: state
end: lmx_graph_state

# The canonical address of a spelling of nb bytes (§4): interning, the only operation that compares bytes. 0 without
# memory.
fn: lmx_graph_intern (const: (@: text char); size_t: nb) @: char
    @: state c.LmxGraphState lmx_graph_state()
    if: state = 0 || text = 0
        return: 0
    return: lmx_graph_intern_in(state, text, nb)
end: lmx_graph_intern

# 1 when address is a canonical spelling: a cell of the `text` region of the state's arena (§4, the address invariant);
# 0 for any other address, a heap string or a cell of a graph's arena included.
fn: lmx_graph_intern_owned (@: address char) int
    @: state c.LmxGraphState lmx_graph_state()
    if: state = 0 || address = 0
        return: 0
    if: c.lmx_range_classify(state\spellings, (cast: (@: void) address)) != c.LMX_KIND_PRIMITIVE
        return: 0
    if: c.lmx_range_type_of(state\spellings, (cast: (@: void) address)) != c.LMX_TYPE_TEXT
        return: 0
    return: 1
end: lmx_graph_intern_owned

# The graph record of an arena, or 0 when it has none (lmx_graph_open makes it).
fn: lmx_graph_find (@: arena c.LmxArena) @: c.LmxGraph
    @: state c.LmxGraphState lmx_graph_state()
    @: g c.LmxGraph 0
    if: state = 0 || arena = 0
        return: 0
    g := state\graphs
    while: g != 0
        if: g\arena = arena
            return: g
        ---
        g := g\next
    ---
    return: 0
end: lmx_graph_find

# The graph record of an arena: the address -> name table of that arena. One per arena; opening an arena twice answers
# the record it has. 0 without memory.
fn: lmx_graph_open (@: arena c.LmxArena) @: c.LmxGraph
    @: state c.LmxGraphState lmx_graph_state()
    @: g c.LmxGraph lmx_graph_find(arena)
    if: state = 0 || arena = 0
        return: 0
    if: g != 0
        return: g
    g := (cast: (@: c.LmxGraph) c.calloc(1U, c.sizeof(c.LmxGraph)))
    if: g = 0
        return: 0
    g\arena := arena
    g\next := state\graphs
    state\graphs := g
    return: g
end: lmx_graph_open

# The record leaves the process state and its name table is freed; the cells of the arena are the arena's.
fn: lmx_graph_close (@: g c.LmxGraph) int
    @: state c.LmxGraphState lmx_graph_state()
    @: at c.LmxGraph 0
    @: before c.LmxGraph 0
    if: state = 0 || g = 0
        return: 1
    at := state\graphs
    while: at != 0 && at != g
        before := at
        at := at\next
    ---
    if: at = 0
        return: 1
    if: before = 0
        state\graphs := g\next
    else:
        before\next := g\next
    ---
    c.free((cast: (@: void) g\names))
    c.free((cast: (@: void) g\names_index))
    c.free((cast: (@: void) g))
    return: 0
end: lmx_graph_close

# ---- Primitives and Lmx -------------------------------------------------------------------------------------------

# A word primitive: a cell of the WORD pool holding the canonical address of the spelling of nb bytes (§3.3). 0 without
# memory.
fn: lmx_graph_word (@: g c.LmxGraph; const: (@: text char); size_t: nb) @: void
    @: canon char lmx_graph_intern(text, nb)
    @: cell void 0
    @@: wc char 0
    if: g = 0 || canon = 0
        return: 0
    cell := c.lmx_arena_take(g\arena, sizeof(@: void), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_WORD)
    if: cell = 0
        return: 0
    wc := (cast: (@@: char) cell)
    \wc := canon
    return: cell
end: lmx_graph_word

# The canonical spelling a word primitive holds, or 0 when the address is no word cell of this arena.
fn: lmx_graph_word_text (@: g c.LmxGraph; @: cell void) @: char
    @@: wc char 0
    if: g = 0 || cell = 0
        return: 0
    if: c.lmx_range_classify(g\arena, cell) != c.LMX_KIND_PRIMITIVE || c.lmx_range_type_of(g\arena, cell) != c.LMX_TYPE_WORD
        return: 0
    wc := (cast: (@@: char) cell)
    return: \wc
end: lmx_graph_word_text

# An int primitive holding value (§3.2). 0 without memory.
fn: lmx_graph_int (@: g c.LmxGraph; int: value) @: void
    @: cell void 0
    if: g = 0
        return: 0
    cell := c.lmx_int_new_profiled(g\arena, 0)
    if: cell = 0
        return: 0
    if: c.lmx_int_store_known(cell, value) != 0
        return: 0
    return: cell
end: lmx_graph_int

# A place without a value (§3.2, the author 18:00Z and 19:02Z): its int cell, not yet written, and the pointer
# primitive "int without initialization" pointing at it; the slot keeps that pointer cell after assignments too.
# Construction and taking its address do not read the int cell's bytes. No initial value is promised. 0 without memory.
fn: lmx_graph_uninit_int (@: g c.LmxGraph) @: void
    @: cell void 0
    @: pointer void 0
    if: g = 0
        return: 0
    cell := c.lmx_int_new_profiled(g\arena, 0)
    if: cell = 0
        return: 0
    pointer := c.lmx_arena_pointer_cells_profiled(g\arena, c.LMX_TYPE_UNINIT_INT, 0, sizeof(@: void), c.lmx_arena_pointer_void_read, c.lmx_arena_pointer_void_write, 1U)
    if: pointer = 0
        return: 0
    if: c.lmx_arena_pointer_void_write(pointer, cell) != 0
        return: 0
    return: pointer
end: lmx_graph_uninit_int

# An initialized int-reference primitive. Its referent is the actual int cell, including a cell obtained by @ before
# its first assignment. This operation stores an address; it never reads that cell's uninitialized bytes.
fn: lmx_graph_ref_int (@: g c.LmxGraph; @: cell void) @: void
    @: pointer void 0
    if: g = 0 || lmx_graph_kind(g, cell) != 1
        return: 0
    pointer := c.lmx_arena_pointer_cells_profiled(g\arena, c.LMX_TYPE_GRAPH_INT_REF, 0, sizeof(@: void), c.lmx_arena_pointer_void_read, c.lmx_arena_pointer_void_write, 1U)
    if: pointer = 0 || c.lmx_arena_pointer_void_write(pointer, cell) != 0
        return: 0
    return: pointer
end: lmx_graph_ref_int

# An Lmx of count slots under parent (0: a root of the arena), its slots empty (§3.1). 0 without memory.
fn: lmx_graph_lmx (@: g c.LmxGraph; @: parent c.Lmx; size_t: count) @: c.Lmx
    @: value c.Lmx 0
    if: g = 0
        return: 0
    if: parent = 0
        value := c.lmx_node_new_owned(g\arena)
    else:
        value := c.lmx_struct_new_profiled(parent, g\arena, 0)
    ---
    if: value = 0
        return: 0
    if: count != 0U && c.lmx_arena_refs_open_owned(g\arena, value, count) != 0
        return: 0
    return: value
end: lmx_graph_lmx

# The number of slots of an Lmx.
fn: lmx_graph_count (@: lmx c.Lmx) size_t
    @: va c.VoidArray 0
    if: lmx = 0
        return: 0U
    va := @ lmx\array
    return: (cast: (size_t) va\size)
end: lmx_graph_count

# The content of slot index of lmx: the address of a primitive or an Lmx, or 0.
fn: lmx_graph_get (@: lmx c.Lmx; size_t: index) @: void
    @@: slot void (cast: (@@: void) c.lmx_arena_ref_cell(lmx, index))
    if: slot = 0
        return: 0
    return: \slot
end: lmx_graph_get

# The write of slot index of lmx at construction: the constructor is the slot's only writer here (the executors' writes
# of places go through lmx_graph_assign_int). 0, or 1 when there is no such slot.
fn: lmx_graph_put (@: lmx c.Lmx; size_t: index; @: value void) int
    @@: slot void (cast: (@@: void) c.lmx_arena_ref_cell(lmx, index))
    if: slot = 0
        return: 1
    \slot := value
    return: 0
end: lmx_graph_put

# Managed graph access resolves the actual field cell, including shared and
# noncontiguous backing. Callers supply their existing graph context.
fn: lmx_graph_get_in (@: g c.LmxGraph; @: lmx c.Lmx; size_t: index) @: void
    if: g = 0
        return: 0
    return: c.lmx_graph_value_in((cast: (@: c.LmxArena) g\arena), lmx, index)
end: lmx_graph_get_in

# Constructor fill only; ordinary stores retain their admission/barriers.
fn: lmx_graph_put_in (@: g c.LmxGraph; @: lmx c.Lmx; size_t: index; @: value void) int
    if: g = 0
        return: 1
    return: c.lmx_graph_ref_fill_in((cast: (@: c.LmxArena) g\arena), lmx, index, value)
end: lmx_graph_put_in

# What an address is in this arena: 0 nothing of the graph, 1 an int primitive, 2 a word primitive, 3 the pointer
# primitive of a place without a value, 4 an Lmx, 5 an int reference, 6 a reference to an Lmx -- a Structure or a
# callable --, 7 an untyped reference, the value the index of a Structure reads (§2.2: the type is the region of the
# address). The types are those of L3, kept by the module of checks (lmx_l3_type).
fn: lmx_graph_kind (@: g c.LmxGraph; @: address void) int
    if: g = 0
        return: 0
    return: c.lmx_l3_type(g\arena, address)

# ---- The index of the address -> name rows (§5.1) -----------------------------------------------------------------
# Every Frame of a graph is named by its head (the author 2026-11-09: a declaration is a named structure of its
# receiver), so the rows are many; the name of an address is found through an open-addressed index of row numbers by
# address -- arena state like the rows, rebuilt when it grows, never a table of a traversal.

# The first probe position of address in an index of cap entries.
fn: lmx_graph_name_hash (@: address void; size_t: cap) size_t
    size_t: h (cast: (size_t) address)
    h := (h / 16U) * 40503U + (h / 4096U)
    return: h % cap
end: lmx_graph_name_hash

# The row of address, or names_len when it has none.
fn: lmx_graph_name_row (@: g c.LmxGraph; @: address void) size_t
    @: row c.LmxName 0
    size_t: at 0U
    size_t: probes 0U
    size_t: entry 0U
    if: g = 0 || address = 0 || g\index_cap = 0U
        return: g\names_len
    at := lmx_graph_name_hash(address, (cast: (size_t) g\index_cap))
    while: probes < g\index_cap
        entry := g\names_index[at]
        if: entry = 0U
            return: g\names_len
        row := g\names + (entry - 1U)
        if: row\address = address
            return: entry - 1U
        at := at + 1U
        if: at = g\index_cap
            at := 0U
        probes := probes + 1U
    ---
    return: g\names_len
end: lmx_graph_name_row

# Enter row number k into the index (its capacity is kept above twice the rows by lmx_graph_name_index_room).
sub: lmx_graph_name_index_put (@: g c.LmxGraph; size_t: k)
    @: row c.LmxName 0
    size_t: at 0U
    if: g\index_cap = 0U
        return
    row := g\names + k
    at := lmx_graph_name_hash((cast: (@: void) row\address), (cast: (size_t) g\index_cap))
    while: g\names_index[at] != 0U
        at := at + 1U
        if: at = g\index_cap
            at := 0U
    ---
    g\names_index[at] := k + 1U
    return
end: lmx_graph_name_index_put

# Room in the index for one more row: a new index of at least four times the rows when it would be over half full,
# with every row entered again. 0, or 1 without memory.
fn: lmx_graph_name_index_room (@: g c.LmxGraph) int
    @: index size_t 0
    size_t: cap 0U
    size_t: k 0U
    if: (g\names_len + 1U) * 2U <= g\index_cap
        return: 0
    cap := (g\names_len + 1U) * 4U
    if: cap < 64U
        cap := 64U
    index := (cast: (@: size_t) c.calloc(cap, c.sizeof(c.size_t)))
    if: index = 0
        return: 1
    c.free((cast: (@: void) g\names_index))
    g\names_index := index
    g\index_cap := cap
    while: k < g\names_len
        lmx_graph_name_index_put(g, k)
        k := k + 1U
    ---
    return: 0
end: lmx_graph_name_index_room

# Address names are weak metadata. Retire only this arena's freed interval;
# names of external addresses remain valid. Never initialize process state
# or allocate while an existing range is being retired.
sub: lmx_graph_names_drop (@: arena c.LmxArena; @: lo void; @: hi void)
    @@: anchor c.LmxGraphState (cast: (@@: c.LmxGraphState) (@ c.lmx_graph_anchor))
    @: state c.LmxGraphState 0
    @: g c.LmxGraph 0
    @: row c.LmxName 0
    @: kept c.LmxName 0
    size_t: low (cast: (size_t) lo)
    size_t: high (cast: (size_t) hi)
    size_t: address 0U
    size_t: i 0U
    size_t: used 0U
    if: arena = 0 || high <= low
        return
    state := \anchor
    if: state = 0
        return
    g := state\graphs
    while: g != 0
        if: g\arena = arena
            i := 0U
            used := 0U
            while: i < g\names_len
                row := g\names + i
                address := (cast: (size_t) row\address)
                if: address < low || address >= high
                    if: used != i
                        kept := g\names + used
                        kept\address := row\address
                        kept\name := row\name
                    used := used + 1U
                ---
                i := i + 1U
            ---
            if: used != g\names_len
                g\names_len := used
                if: g\index_cap != 0U
                    c.memset((cast: (@: void) g\names_index), 0, g\index_cap * c.sizeof(c.size_t))
                    i := 0U
                    while: i < used
                        lmx_graph_name_index_put(g, i)
                        i := i + 1U
                    ---
                ---
            ---
        ---
        g := g\next
    ---
end: lmx_graph_names_drop

# ---- The address -> name table of the arena (§5.1) ----------------------------------------------------------------

# A row for address: its name is the canonical address of the spelling of nb bytes. 0, or 1 without memory.
fn: lmx_graph_name (@: g c.LmxGraph; @: address void; const: (@: text char); size_t: nb) int
    @: canon char lmx_graph_intern(text, nb)
    return: lmx_graph_name_address(g, address, canon)
end: lmx_graph_name

# Register a name already read from the graph. Runtime publication does not re-intern or compare spelling bytes.
# Renaming an existing address needs its own graph mutation contract; registration never silently renames one.
fn: lmx_graph_name_address (@: g c.LmxGraph; @: address void; @: canon char) int
    @: state c.LmxGraphState lmx_graph_state()
    @: rows c.LmxName 0
    @: row c.LmxName 0
    size_t: cap 0U
    size_t: i 0U
    if: g = 0 || address = 0 || canon = 0 || state = 0
        return: 1
    while: i < state\count && state\texts[i] != canon
        i := i + 1U
    if: i = state\count
        return: 1
    i := lmx_graph_name_row(g, address)
    if: i < g\names_len
        row := g\names + i
        return: (cast: (int) (row\name != canon))
    if: lmx_graph_name_index_room(g) != 0
        return: 1
    if: g\names_len + 1U > g\names_cap
        cap := 32U
        if: g\names_cap != 0U
            cap := g\names_cap * 2U
        rows := (cast: (@: c.LmxName) c.realloc((cast: (@: void) g\names), cap * c.sizeof(c.LmxName)))
        if: rows = 0
            return: 1
        g\names := rows
        g\names_cap := cap
    ---
    row := g\names + g\names_len
    row\address := address
    row\name := canon
    lmx_graph_name_index_put(g, (cast: (size_t) g\names_len))
    g\names_len := g\names_len + 1U
    return: 0
end: lmx_graph_name_address

# The name of an address (the canonical spelling), or 0 when the table has no row for it.
fn: lmx_graph_name_of (@: g c.LmxGraph; @: address void) @: char
    @: row c.LmxName 0
    size_t: i 0U
    if: g = 0 || address = 0
        return: 0
    i := lmx_graph_name_row(g, address)
    if: i >= g\names_len
        return: 0
    row := g\names + i
    return: row\name
end: lmx_graph_name_of

# The int cell of the place at slot index of lmx: the cell itself, or the cell behind the pointer of a place without a
# value; 0 when the slot holds neither.
fn: lmx_graph_place_cell (@: g c.LmxGraph; @: lmx c.Lmx; size_t: index) @: void
    @: value void lmx_graph_get_in(g, lmx, index)
    int: kind lmx_graph_kind(g, value)
    value := lmx_graph_binding_leaf(g, value)
    kind := lmx_graph_kind(g, value)
    if: kind = 1
        return: value
    if: kind = 3
        return: c.lmx_arena_pointer_void_read(value)
    return: 0
end: lmx_graph_place_cell

# The name the place at slot index answers to: the name of its int cell (a place without a value is named at its
# cell, §3.2), of its Lmx, or of the primitive itself; 0 when nothing is named.
fn: lmx_graph_slot_name (@: g c.LmxGraph; @: lmx c.Lmx; size_t: index) @: char
    @: value void lmx_graph_get_in(g, lmx, index)
    @: cell void 0
    @: declared char 0
    value := lmx_graph_binding_leaf(g, value)
    if: value = 0
        return: 0
    if: lmx_graph_kind(g, value) = 3 || lmx_graph_kind(g, value) = 8 || lmx_graph_kind(g, value) = 9
        cell := c.lmx_arena_pointer_void_read(value)
        return: lmx_graph_name_of(g, cell)
    declared := lmx_graph_declaration_place_name(g, value)
    if: declared != 0
        return: declared
    return: lmx_graph_name_of(g, value)
end: lmx_graph_slot_name

# The slot of lmx whose content is named name (a canonical address: pointers are compared, §5.1), or the count of
# slots when none is.
fn: lmx_graph_named (@: g c.LmxGraph; @: lmx c.Lmx; @: name char) size_t
    size_t: n lmx_graph_count(lmx)
    size_t: i 0U
    if: g = 0 || name = 0
        return: n
    while: i < n
        if: lmx_graph_slot_name(g, lmx, i) = name
            return: i
        ---
        i := i + 1U
    ---
    return: n
end: lmx_graph_named

# ---- Reading and writing a place (§3.2) ---------------------------------------------------------------------------

# ---- The Structure a receiver fn/sub creates (§3.4; the author 2026-11-09) -----------------------------------------
# The graph keeps the declaration as written: the Frame of the receiver fn (an Lmx named fn) with its arguments name,
# args, return, data, code. A traversal applies the receiver and creates, in its own namespace, the Structure named by
# the value of the name argument with the parts args, return, data, code (sub: args, data, code) -- an Lmx of the FN pool
# role (§2.2 lmx:result, L2 §2.1: only a Structure created by the execution of fn, not data with similar parts).

# 1 when value is a Structure created by the receiver fn or sub (its address is in the FN pool), else 0.
fn: lmx_graph_fn_result (@: g c.LmxGraph; @: value void) int
    @: pool c.LmxPool 0
    if: g = 0 || lmx_graph_kind(g, value) != 4
        return: 0
    pool := (cast: (@: c.LmxPool) c.lmx_range_cell_pool(g\arena, value))
    return: (cast: (int) (pool != 0 && pool\role = c.LMX_POOL_ROLE_FN))
end: lmx_graph_fn_result

# The part named word of a Structure: the value of its field of that name, the target when it is a reference to an Lmx;
# 0 when it has none.
fn: lmx_graph_part (@: g c.LmxGraph; @: value void; @: word char) @: void
    @: inner c.Lmx 0
    size_t: slot 0U
    if: g = 0 || word = 0 || lmx_graph_kind(g, value) != 4
        return: 0
    inner := (cast: (@: c.Lmx) value)
    slot := lmx_graph_named(g, inner, word)
    if: slot >= lmx_graph_count(inner)
        return: 0
    return: lmx_graph_target(g, lmx_graph_get_in(g, inner, slot))
end: lmx_graph_part

# A callable: a Structure created by fn or sub with its data and code parts; the interface descriptor (fn without a
# body) is none (the book :691).
fn: lmx_graph_method (@: g c.LmxGraph; @: code c.Lmx) int
    @: state c.LmxGraphState lmx_graph_state()
    if: state = 0 || lmx_graph_fn_result(g, (cast: (@: void) code)) = 0
        return: 0
    return: (cast: (int) (lmx_graph_kind(g, lmx_graph_part(g, (cast: (@: void) code), (cast: (@: char) state\w_data))) = 4 && lmx_graph_kind(g, lmx_graph_part(g, (cast: (@: void) code), (cast: (@: char) state\w_code))) = 4))
end: lmx_graph_method

# A callable with a result: the one created by fn, which has the part return (sub has none).
fn: lmx_graph_has_result (@: g c.LmxGraph; @: code c.Lmx) int
    @: state c.LmxGraphState lmx_graph_state()
    return: (cast: (int) (lmx_graph_method(g, code) != 0 && lmx_graph_part(g, (cast: (@: void) code), (cast: (@: char) state\w_return)) != 0))
end: lmx_graph_has_result

fn: lmx_graph_method_data (@: g c.LmxGraph; @: code c.Lmx) @: c.Lmx
    @: state c.LmxGraphState lmx_graph_state()
    return: (cast: (@: c.Lmx) lmx_graph_part(g, (cast: (@: void) code), (cast: (@: char) state\w_data)))
end: lmx_graph_method_data

fn: lmx_graph_method_code (@: g c.LmxGraph; @: code c.Lmx) @: c.Lmx
    @: state c.LmxGraphState lmx_graph_state()
    return: (cast: (@: c.Lmx) lmx_graph_part(g, (cast: (@: void) code), (cast: (@: char) state\w_code)))
end: lmx_graph_method_code

# The result requirement of a callable as written (a word such as int, or a Structure), 0 for sub.
fn: lmx_graph_method_return (@: g c.LmxGraph; @: code c.Lmx) @: void
    @: state c.LmxGraphState lmx_graph_state()
    return: lmx_graph_part(g, (cast: (@: void) code), (cast: (@: char) state\w_return))
end: lmx_graph_method_return

# A primitive declaring receiver of the active source profile, compared by canonical name addresses. The generated
# cell flags distinguish None/void from places; no machine-backend whitelist or runtime table parser is involved.
fn: lmx_graph_primitive_receiver (@: word char) int
    @: state c.LmxGraphState lmx_graph_state()
    const: (@: cells char c.lmx_primitive_profile_cells)
    size_t: count c.lmx_primitive_profile_count
    size_t: first 0U
    size_t: i 0U
    if: state = 0 || word = 0 || count > state\receivers_count
        return: 0
    first := state\receivers_count - count
    while: i < count
        if: state\receivers[first + i] = word
            return: (cast: (int) (cells[i] != 0))
        i := i + 1U
    ---
    # Only C type spellings projected from the source table are proved types.
    # The prefix precedes the unchanged primitive-row suffix in receivers.
    if: word[0] != 99 || word[1] != 46
        return: 0
    i := 0U
    while: i < first
        if: state\receivers[i] = word
            return: 1
        i := i + 1U
    return: 0
end: lmx_graph_primitive_receiver

# The physical kernel code proved by the same frontend projection as this
# exact ABI. Shared spellings share access, never SOURCE identity or admission.
fn: lmx_graph_scalar_type (const: (@: abi c.LmxScalarABI)) int
    size_t: i 0U
    int: ty c.LMX_TYPE_NONE
    if: abi = 0
        return: c.LMX_TYPE_NONE
    while: i < c.lmx_primitive_profile_count
        if: c.lmx_primitive_profile_scalar(i) = abi
            ty := c.lmx_primitive_profile_scalar_type(i)
            if: ty != c.LMX_TYPE_NONE && ty != c.LMX_TYPE_FOREIGN
                return: ty
            ---
        ---
        i := i + 1U
    return: c.LMX_TYPE_FOREIGN
end: lmx_graph_scalar_type

# An ABI-proved inline number uses the same physical scalar capture for an
# address request and for delivery into an ABI cell. Admission stays at the
# receiving writer; the caller chooses whether to retain the boxed record.
fn: lmx_graph_scalar_box (@: arena c.LmxArena; @: value c.LmxWalkValue; @: out c.LmxWalkValue) int
    @: storage void 0
    int: ty c.LMX_TYPE_FOREIGN
    int: physical_type c.LMX_TYPE_NONE
    if: arena = 0 || value = 0 || out = 0 || value\present = 0 || value\kind != c.LMX_WALK_VALUE_NUMBER || value\scalar_abi = 0
        return: c.LMX_WALK_INVALID
    physical_type := lmx_graph_scalar_type((cast: (const: @: c.LmxScalarABI) value\scalar_abi))
    if: physical_type = c.LMX_TYPE_NONE || physical_type = c.LMX_TYPE_FOREIGN || physical_type != c.lmx_type_base(value\type)
        return: c.LMX_WALK_INVALID
    if: value\type < 0
        ty := c.lmx_type_immutable(ty)
    storage := c.lmx_walk_value_storage(value)
    return: c.lmx_walk_value_foreign_capture(arena, storage, ty, (cast: (const: @: c.LmxScalarABI) value\scalar_abi), (cast: (@: c.Lmx) value\physical_profile), value, out)
end: lmx_graph_scalar_box

# Borrowed identity of the complete literal source description. The C door
# has its own canonical spelling identity; it never selects an arbitrary
# language row sharing that spelling (Boolean/i8/int8 are distinct).
fn: lmx_graph_primitive_description (@: word char) @: void
    @: state c.LmxGraphState lmx_graph_state()
    const: (@: cells char c.lmx_primitive_profile_cells)
    size_t: count c.lmx_primitive_profile_count
    size_t: first 0U
    size_t: i 0U
    if: state = 0 || word = 0 || count > state\receivers_count
        return: (cast: (@: void) 0)
    first := state\receivers_count - count
    while: i < count
        if: state\receivers[first + i] = word && cells[i] != 0
            return: (cast: (@: void) c.lmx_primitive_profile_row(i))
        i := i + 1U
    if: word[0] = 99 && word[1] = 46 && lmx_graph_primitive_receiver(word) != 0
        return: (cast: (@: void) word)
    return: (cast: (@: void) 0)

# The source description and its C access contract are distinct outputs. C
# spellings select a physical binding, never a language row sharing that spelling.
fn: lmx_graph_scalar_binding (@: word char; @@: description void) const: @: c.LmxScalarABI
    @: state c.LmxGraphState lmx_graph_state()
    const: (@: c_names char c.lmx_primitive_profile_c_names)
    const: (@: abi c.LmxScalarABI 0)
    size_t: count c.lmx_primitive_profile_count
    size_t: first 0U
    size_t: i 0U
    size_t: at 0U
    size_t: n 0U
    size_t: column 0U
    size_t: spelling c.lmx_primitive_profile_columns
    size_t: payload_at 0U
    const: (@: columns char c.lmx_primitive_profile_column_names)
    const: (@: payload char 0)
    const: (@: spelling_bytes char 0)
    size_t: spelling_size 0U
    @: physical char 0
    if: description = 0
        return: (cast: (const: @: c.LmxScalarABI) 0)
    description[0] := 0
    if: state = 0 || word = 0 || count > state\receivers_count
        return: (cast: (const: @: c.LmxScalarABI) 0)
    first := state\receivers_count - count
    while: i < count
        if: state\receivers[first + i] = word
            description[0] := (cast: (@: void) c.lmx_primitive_profile_row(i))
            return: c.lmx_primitive_profile_scalar(i)
        i := i + 1U
    if: word[0] != 99 || word[1] != 46
        return: (cast: (const: @: c.LmxScalarABI) 0)
    i := 0U
    while: i < count
        n := c.strlen(c_names + at)
        abi := c.lmx_primitive_profile_scalar(i)
        if: n != 0U && abi != 0 && lmx_graph_intern(c_names + at, n) = word
            description[0] := (cast: (@: void) word)
            return: abi
        at := at + n + 1U
        i := i + 1U
    # A physical C spelling may contain spaces (long double, unsigned long
    # long). It is queried here as literal source data, not as a receiver.
    # The public row selected above remains a separate semantic output.
    at := 0U
    while: column < c.lmx_primitive_profile_columns
        n := c.strlen(columns + at)
        if: lmx_graph_intern(columns + at, n) = lmx_graph_intern("spelling", 8U)
            spelling := column
            break
        at := at + n + 1U
        column := column + 1U
    if: spelling = c.lmx_primitive_profile_columns
        return: (cast: (const: @: c.LmxScalarABI) 0)
    physical := lmx_graph_intern(word + 2U, c.strlen(word + 2U))
    i := 0U
    while: i < count
        abi := c.lmx_primitive_profile_scalar(i)
        payload := c.lmx_primitive_profile_row(i)
        if: abi != 0 && payload != 0
            column := 0U
            payload_at := 0U
            while: column < spelling
                payload_at := payload_at + c.strlen(payload + payload_at) + 1U
                column := column + 1U
            spelling_bytes := payload + payload_at
            spelling_size := c.strlen(spelling_bytes)
            if: spelling_size >= 2U && ((spelling_bytes[0] = 34 && spelling_bytes[spelling_size - 1U] = 34) || (spelling_bytes[0] = 96 && spelling_bytes[spelling_size - 1U] = 96))
                spelling_bytes := spelling_bytes + 1U
                spelling_size := spelling_size - 2U
            ---
            if: lmx_graph_intern(spelling_bytes, spelling_size) = physical
                description[0] := (cast: (@: void) word)
                return: abi
            ---
        ---
        i := i + 1U
    return: (cast: (const: @: c.LmxScalarABI) 0)

# ---- Typed numbers (G2.1; the grammar :77 «Формы целых и вещественных литералов следуют ANSI C/C99»; M15 value record) --

# The catalog row whose ABI record is abi -- every row has its own record (lmx_primitive_profile_scalar) --, or the
# row count.
fn: lmx_graph_scalar_row (const: (@: abi c.LmxScalarABI)) size_t
    size_t: i 0U
    while: abi != 0 && i < c.lmx_primitive_profile_count
        if: c.lmx_primitive_profile_scalar(i) = abi
            return: i
        i := i + 1U
    return: c.lmx_primitive_profile_count

# The literal kind of a catalog row: 2 unsigned, 3 long, 4 ulong, 5 llong, 6 ullong, 7 float, 8 double, 9 flong -- the
# C99 types a number constant other than an int has --, 0 for any other row.  By the row's name, read from the catalog.
fn: lmx_graph_number_kind (size_t: row) int
    const: (@: names char c.lmx_primitive_profile_names)
    size_t: at 0U
    size_t: i 0U
    if: row >= c.lmx_primitive_profile_count
        return: 0
    while: i < row
        at := at + c.strlen(names + at) + 1U
        i := i + 1U
    if: c.strcmp(names + at, "unsigned") = 0
        return: 2
    if: c.strcmp(names + at, "long") = 0
        return: 3
    if: c.strcmp(names + at, "ulong") = 0
        return: 4
    if: c.strcmp(names + at, "llong") = 0
        return: 5
    if: c.strcmp(names + at, "ullong") = 0
        return: 6
    if: c.strcmp(names + at, "float") = 0
        return: 7
    if: c.strcmp(names + at, "double") = 0
        return: 8
    if: c.strcmp(names + at, "flong") = 0
        return: 9
    return: 0

# A value cell of the catalog's row for the type word (§3.2; the value record of M15): a cell of a LMX_TYPE_FOREIGN pool
# with that row's scalar ABI, holding the abi\size bytes at bytes, its source the row's description -- the cell
# lmx_graph_scalar_pool proves and the interpreter reads.  The cell, or 0 for a word the catalog has no row of, or
# without memory.
fn: lmx_graph_scalar_cell (@: g c.LmxGraph; const: (@: type char); @: bytes void) @: void
    @: source void 0
    const: (@: abi c.LmxScalarABI 0)
    c.LmxWalkValue: context
    c.LmxWalkValue: value
    if: g = 0 || type = 0 || bytes = 0
        return: 0
    abi := lmx_graph_scalar_binding(lmx_graph_intern(type, c.strlen(type)), @ source)
    if: abi = 0
        return: 0
    c.lmx_walk_value_clear(@ context)
    c.lmx_walk_value_clear(@ value)
    context\source_type := source
    if: c.lmx_walk_value_foreign_capture(g\arena, bytes, c.LMX_TYPE_FOREIGN, abi, 0, @ context, @ value) != c.LMX_WALK_OK
        return: 0
    return: value\ref

# Is the byte b a digit of base (8, 10 or 16)?  Its value, or -1.
fn: lmx_graph_number_digit (int: b; int: base) int
    int: d 0 - 1
    if: b >= 48 && b <= 57
        d := b - 48
    if: b >= 97 && b <= 102
        d := b - 87
    if: b >= 65 && b <= 70
        d := b - 55
    if: d >= base
        return: 0 - 1
    return: d

# A C99 number spelling (the grammar :77): an integer constant -- decimal, octal `0...`, hex `0x...`, with a suffix of
# u/U and l/L or ll/LL in either order -- or a floating constant (digits with `.` and/or an exponent e/E, a hex
# mantissa with p/P; one suffix f/F or l/L), after one leading minus as the builder's int literal takes it.  Its C99
# type: unsuffixed decimal int, long, llong; unsuffixed octal/hex int, unsigned, long, ulong, llong, ullong; U unsigned,
# ulong, ullong; L long, llong (decimal) or long, ulong, llong, ullong; UL ulong, ullong; LL llong (decimal) or llong,
# ullong; ULL ullong -- the first that holds the magnitude; floating double, F float, L flong.  The minus negates the
# value in that type.  The one reader of number spellings: the builder (l2_graph_build) and the image of an emitted
# program (l2_graph_tool) call it, so what lmx_graph_scalar_text writes reads back to the same type and value.
# 0 when the bytes are no such spelling; 1 and the value in as_int when its type is int; 2 and the value cell
# (lmx_graph_scalar_cell) in out; 3 without memory, or for a constant no type of its list holds.
fn: lmx_graph_number (@: g c.LmxGraph; const: (@: bytes char); size_t: n; @@: out void; @: as_int int) int
    @: buf char 0
    @: rest char 0
    @: cell void 0
    size_t: i 0U
    size_t: body 0U
    size_t: stop 0U
    int: neg 0
    int: base 10
    int: dots 0
    int: exponent 0
    int: digits 0
    int: d 0
    int: u 0
    int: l 0
    int: fs 0
    int: kind 0
    ullong: v (cast: (ullong) 0)
    unsigned: uv 0U
    long: lv (cast: (long) 0)
    ulong: ulv (cast: (ulong) 0)
    llong: llv (cast: (llong) 0)
    float: fv (cast: (float) 0)
    double: dv (cast: (double) 0)
    flong: ev (cast: (flong) 0)
    if: g = 0 || bytes = 0 || out = 0 || as_int = 0 || n = 0U
        return: 0
    out[0] := 0
    if: bytes[0] = 45
        neg := 1
        i := 1U
    body := i
    if: i + 1U < n && bytes[i] = 48 && (bytes[i + 1U] = 120 || bytes[i + 1U] = 88)
        base := 16
        i := i + 2U
    while: i < n && (lmx_graph_number_digit((cast: (int) bytes[i]), base) >= 0 || bytes[i] = 46)
        dots := dots + (cast: (int) (bytes[i] = 46))
        digits := digits + (cast: (int) (bytes[i] != 46))
        i := i + 1U
    if: digits = 0 || dots > 1
        return: 0
    if: i < n && ((base = 10 && (bytes[i] = 101 || bytes[i] = 69)) || (base = 16 && (bytes[i] = 112 || bytes[i] = 80)))
        exponent := 1
        i := i + 1U
        if: i < n && (bytes[i] = 43 || bytes[i] = 45)
            i := i + 1U
        if: i >= n || bytes[i] < 48 || bytes[i] > 57
            return: 0
        while: i < n && bytes[i] >= 48 && bytes[i] <= 57
            i := i + 1U
    ---
    if: base = 16 && dots != 0 && exponent = 0
        return: 0
    stop := i
    if: dots != 0 || exponent != 0
        if: i < n && (bytes[i] = 102 || bytes[i] = 70)
            fs := 1
            i := i + 1U
        if: fs = 0 && i < n && (bytes[i] = 108 || bytes[i] = 76)
            l := 1
            i := i + 1U
    ---
    while: dots = 0 && exponent = 0 && i < n
        if: (bytes[i] = 117 || bytes[i] = 85) && u = 0
            u := 1
            i := i + 1U
            continue
        if: (bytes[i] = 108 || bytes[i] = 76) && l = 0
            l := 1
            if: i + 1U < n && bytes[i + 1U] = bytes[i]
                l := 2
                i := i + 1U
            i := i + 1U
            continue
        return: 0
    if: i != n
        return: 0
    # A decimal int the builder's int literal takes never reaches here with base 10, no suffix and a fitting value; an
    # octal spelling is a decimal-looking one with a leading 0 and more digits.
    if: dots = 0 && exponent = 0 && base = 10 && stop - body > 1U && bytes[body] = 48
        base := 8
    if: dots = 0 && exponent = 0
        i := body
        if: base = 16
            i := body + 2U
        while: i < stop
            d := lmx_graph_number_digit((cast: (int) bytes[i]), base)
            if: d < 0 || v > ((cast: (ullong) c.ULLONG_MAX) - (cast: (ullong) d)) / (cast: (ullong) base)
                return: 3
            v := v * (cast: (ullong) base) + (cast: (ullong) d)
            i := i + 1U
        if: u = 0 && l = 0 && v <= (cast: (ullong) c.INT_MAX)
            as_int[0] := (cast: (int) v)
            if: neg != 0
                as_int[0] := 0 - as_int[0]
            return: 1
        if: u = 0 && l = 0 && base != 10 && v <= (cast: (ullong) c.UINT_MAX)
            kind := 2
        if: kind = 0 && u != 0 && l = 0 && v <= (cast: (ullong) c.UINT_MAX)
            kind := 2
        if: kind = 0 && u = 0 && l <= 1 && v <= (cast: (ullong) c.LONG_MAX)
            kind := 3
        if: kind = 0 && (u != 0 || base != 10) && l <= 1 && v <= (cast: (ullong) c.ULONG_MAX)
            kind := 4
        if: kind = 0 && u = 0 && v <= (cast: (ullong) c.LLONG_MAX)
            kind := 5
        if: kind = 0 && (u != 0 || base != 10)
            kind := 6
        if: kind = 0
            return: 3
        if: kind = 2
            uv := (cast: (unsigned) v)
            if: neg != 0
                uv := 0U - uv
            cell := lmx_graph_scalar_cell(g, "unsigned", (cast: (@: void) (@ uv)))
        if: kind = 3
            lv := (cast: (long) v)
            if: neg != 0
                lv := (cast: (long) 0) - lv
            cell := lmx_graph_scalar_cell(g, "long", (cast: (@: void) (@ lv)))
        if: kind = 4
            ulv := (cast: (ulong) v)
            if: neg != 0
                ulv := (cast: (ulong) 0) - ulv
            cell := lmx_graph_scalar_cell(g, "ulong", (cast: (@: void) (@ ulv)))
        if: kind = 5
            llv := (cast: (llong) v)
            if: neg != 0
                llv := (cast: (llong) 0) - llv
            cell := lmx_graph_scalar_cell(g, "llong", (cast: (@: void) (@ llv)))
        if: kind = 6
            if: neg != 0
                v := (cast: (ullong) 0) - v
            cell := lmx_graph_scalar_cell(g, "ullong", (cast: (@: void) (@ v)))
        if: cell = 0
            return: 3
        out[0] := cell
        return: 2
    buf := (cast: (@: char) c.calloc(stop - body + 1U, 1U))
    if: buf = 0
        return: 3
    c.memcpy((cast: (@: void) buf), (cast: (const: @: void) (bytes + body)), stop - body)
    if: fs != 0
        fv := c.strtof(buf, @ rest)
        if: neg != 0
            fv := (cast: (float) 0) - fv
        if: rest = buf + (stop - body) && fv <= (cast: (float) c.FLT_MAX) && fv >= (cast: (float) 0) - (cast: (float) c.FLT_MAX)
            cell := lmx_graph_scalar_cell(g, "float", (cast: (@: void) (@ fv)))
        ---
    if: fs = 0 && l != 0
        ev := c.strtold(buf, @ rest)
        if: neg != 0
            ev := (cast: (flong) 0) - ev
        if: rest = buf + (stop - body) && ev <= (cast: (flong) c.LDBL_MAX) && ev >= (cast: (flong) 0) - (cast: (flong) c.LDBL_MAX)
            cell := lmx_graph_scalar_cell(g, "flong", (cast: (@: void) (@ ev)))
        ---
    if: fs = 0 && l = 0
        dv := c.strtod(buf, @ rest)
        if: neg != 0
            dv := (cast: (double) 0) - dv
        if: rest = buf + (stop - body) && dv <= (cast: (double) c.DBL_MAX) && dv >= (cast: (double) 0) - (cast: (double) c.DBL_MAX)
            cell := lmx_graph_scalar_cell(g, "double", (cast: (@: void) (@ dv)))
        ---
    c.free((cast: (@: void) buf))
    if: cell = 0
        return: 3
    out[0] := cell
    return: 2

# The text of a value cell of a literal row (lmx_graph_number_kind) in the canonical C99 form lmx_graph_number reads
# back to the same type and value (the author: «Примитив мы можем точно восстановить только по самому значению»):
# unsigned NU, long NL, ulong NUL, llong NLL, ullong NULL; double the shortest %.*g that strtod reads back to the same
# value, with `.0` when the text has no `.`, `e`, `n` or `i`; float the same with strtof and an f; flong with strtold and
# an L.  0 and the NUL-ended text in out (cap bytes); 1 for a cell that is no value cell of these rows, or no room.
fn: lmx_graph_scalar_text (@: g c.LmxGraph; @: cell void; @: out char; size_t: cap) int
    @: context c.LmxWalkValue 0
    @: rest char 0
    const: (@: abi c.LmxScalarABI 0)
    size_t: i 0U
    int: kind 0
    int: digits 1
    int: written 0 - 1
    unsigned: uv 0U
    long: lv (cast: (long) 0)
    ulong: ulv (cast: (ulong) 0)
    llong: llv (cast: (llong) 0)
    ullong: v (cast: (ullong) 0)
    float: fv (cast: (float) 0)
    double: dv (cast: (double) 0)
    flong: ev (cast: (flong) 0)
    float: fcheck (cast: (float) 0)
    double: dcheck (cast: (double) 0)
    flong: echeck (cast: (flong) 0)
    if: g = 0 || cell = 0 || out = 0 || cap < 8U
        return: 1
    context := c.lmx_value_cell_context(g\arena, cell)
    if: context = 0 || context\present = 0 || context\ref != cell || context\scalar_abi = 0
        return: 1
    abi := (cast: (const: @: c.LmxScalarABI) context\scalar_abi)
    kind := lmx_graph_number_kind(lmx_graph_scalar_row(abi))
    if: kind = 2
        c.memcpy((cast: (@: void) (@ uv)), (cast: (const: @: void) cell), abi\size)
        written := c.snprintf(out, cap, "%uU", uv)
    if: kind = 3
        c.memcpy((cast: (@: void) (@ lv)), (cast: (const: @: void) cell), abi\size)
        written := c.snprintf(out, cap, "%ldL", lv)
    if: kind = 4
        c.memcpy((cast: (@: void) (@ ulv)), (cast: (const: @: void) cell), abi\size)
        written := c.snprintf(out, cap, "%luUL", ulv)
    if: kind = 5
        c.memcpy((cast: (@: void) (@ llv)), (cast: (const: @: void) cell), abi\size)
        written := c.snprintf(out, cap, "%lldLL", llv)
    if: kind = 6
        c.memcpy((cast: (@: void) (@ v)), (cast: (const: @: void) cell), abi\size)
        written := c.snprintf(out, cap, "%lluULL", v)
    if: kind = 7
        c.memcpy((cast: (@: void) (@ fv)), (cast: (const: @: void) cell), abi\size)
        written := c.snprintf(out, cap, "%.*g", digits, (cast: (double) fv))
        fcheck := c.strtof(out, @ rest)
        while: digits < 9 && fcheck != fv
            digits := digits + 1
            written := c.snprintf(out, cap, "%.*g", digits, (cast: (double) fv))
            fcheck := c.strtof(out, @ rest)
    ---
    if: kind = 8
        c.memcpy((cast: (@: void) (@ dv)), (cast: (const: @: void) cell), abi\size)
        written := c.snprintf(out, cap, "%.*g", digits, dv)
        dcheck := c.strtod(out, @ rest)
        while: digits < 17 && dcheck != dv
            digits := digits + 1
            written := c.snprintf(out, cap, "%.*g", digits, dv)
            dcheck := c.strtod(out, @ rest)
    ---
    if: kind = 9
        c.memcpy((cast: (@: void) (@ ev)), (cast: (const: @: void) cell), abi\size)
        written := c.snprintf(out, cap, "%.*Lg", digits, ev)
        echeck := c.strtold(out, @ rest)
        while: digits < 21 && echeck != ev
            digits := digits + 1
            written := c.snprintf(out, cap, "%.*Lg", digits, ev)
            echeck := c.strtold(out, @ rest)
    ---
    if: written < 0 || (cast: (size_t) written) + 3U >= cap
        return: 1
    while: out[i] != 0 && out[i] != 46 && out[i] != 101 && out[i] != 110 && out[i] != 105
        i := i + 1U
    if: kind >= 7 && out[i] = 0
        c.strcat(out, ".0")
    if: kind = 7
        c.strcat(out, "f")
    if: kind = 9
        c.strcat(out, "L")
    return: 0

# Counted descriptions share the existing immutable TEXT interner. Prove an
# exact stored start and length before reading a retained description.
fn: lmx_graph_intern_exact_size (@: address void; @: out size_t) int
    @: state c.LmxGraphState lmx_graph_state()
    size_t: i 0U
    if: out = 0
        return: 0
    out[0] := 0U
    if: state = 0 || address = 0
        return: 0
    while: i < state\count
        if: (cast: (@: void) state\texts[i]) = address
            out[0] := state\sizes[i]
            return: 1
        i := i + 1U
    ---
    return: 0

fn: lmx_graph_source_end (const: (@: bytes char); size_t: nb; size_t: at) size_t
    while: at < nb && bytes[at] != 0
        at := at + 1U
    return: at

fn: lmx_graph_source_payload (const: (@: bytes char); size_t: start; size_t: limit; @: at size_t; @: nb size_t) int
    at[0] := start
    nb[0] := limit - start
    if: nb[0] >= 2U && ((bytes[start] = 34 && bytes[limit - 1U] = 34) || (bytes[start] = 96 && bytes[limit - 1U] = 96))
        at[0] := start + 1U
        nb[0] := nb[0] - 2U
    return: 0

fn: lmx_graph_source_key (const: (@: bytes char); size_t: start; size_t: limit; const: (@: key char)) int
    size_t: n c.strlen(key)
    return: (cast: (int) (limit - start = n && c.memcmp(bytes + start, key, n) = 0))

# Input-boundary validation of sorted schema/literal-token pairs. Original
# tokens remain part of identity; only eligibility/spelling reads unquote.
fn: lmx_graph_scalar_record (const: (@: bytes char); size_t: nb; @: spelling_at size_t; @: spelling_size size_t; @: columns size_t) int
    size_t: at c.strlen("primitive.description")
    size_t: key 0U
    size_t: key_end 0U
    size_t: val 0U
    size_t: val_end 0U
    size_t: previous 0U
    size_t: previous_size 0U
    size_t: n 0U
    size_t: common 0U
    size_t: payload 0U
    size_t: payload_size 0U
    int: cmp 0
    int: required 0
    spelling_at[0] := 0U
    spelling_size[0] := 0U
    columns[0] := 0U
    if: bytes = 0 || nb <= at || bytes[at] != 0 || c.memcmp(bytes, "primitive.description", at) != 0
        return: 0
    at := at + 1U
    while: at < nb
        key := at
        key_end := lmx_graph_source_end(bytes, nb, key)
        if: key_end = nb || key_end = key
            return: 0
        val := key_end + 1U
        val_end := lmx_graph_source_end(bytes, nb, val)
        if: val_end = nb || val_end = val
            return: 0
        n := key_end - key
        if: columns[0] != 0U
            common := n
            if: previous_size < common
                common := previous_size
            cmp := c.memcmp(bytes + previous, bytes + key, common)
            if: cmp > 0 || (cmp = 0 && previous_size >= n)
                return: 0
            ---
        ---
        previous := key
        previous_size := n
        lmx_graph_source_payload(bytes, val, val_end, @ payload, @ payload_size)
        if: lmx_graph_source_key(bytes, key, key_end, "class") != 0
            if: payload_size = 0U
                return: 0
            required := required + 1
        if: lmx_graph_source_key(bytes, key, key_end, "cell") != 0
            if: payload_size != 1U || bytes[payload] != 49
                return: 0
            required := required + 1
        if: lmx_graph_source_key(bytes, key, key_end, "reference") != 0 || lmx_graph_source_key(bytes, key, key_end, "opaque") != 0 || lmx_graph_source_key(bytes, key, key_end, "callable") != 0 || lmx_graph_source_key(bytes, key, key_end, "descriptor") != 0
            if: payload_size != 1U || bytes[payload] != 48
                return: 0
            required := required + 1
        if: lmx_graph_source_key(bytes, key, key_end, "spelling") != 0
            if: payload_size = 0U
                return: 0
            spelling_at[0] := payload
            spelling_size[0] := payload_size
            required := required + 1
        columns[0] := columns[0] + 1U
        at := val_end + 1U
    ---
    return: (cast: (int) (at = nb && required = 7))

# The generated profile is trusted NUL-delimited source data.
fn: lmx_graph_source_pair_token (size_t: row; const: (@: key char); @: token_size size_t) const: @: char
    const: (@: names char c.lmx_primitive_profile_column_names)
    const: (@: values char c.lmx_primitive_profile_row(row))
    size_t: column 0U
    size_t: ni 0U
    size_t: vi 0U
    token_size[0] := 0U
    if: values = 0
        return: 0
    while: column < c.lmx_primitive_profile_columns
        if: c.strcmp(names + ni, key) = 0
            token_size[0] := c.strlen(values + vi)
            return: values + vi
        ni := ni + c.strlen(names + ni) + 1U
        vi := vi + c.strlen(values + vi) + 1U
        column := column + 1U
    ---
    return: 0

# Physical proof only; no language alias is selected by this query.
fn: lmx_graph_scalar_record_abi (const: (@: abi c.LmxScalarABI); const: (@: bytes char); size_t: spelling_at; size_t: spelling_size) int
    const: (@: token char 0)
    size_t: i 0U
    size_t: n 0U
    size_t: lo 0U
    size_t: count 0U
    while: i < c.lmx_primitive_profile_count
        if: c.lmx_primitive_profile_scalar(i) = abi
            token := lmx_graph_source_pair_token(i, "spelling", @ n)
            if: token != 0
                lmx_graph_source_payload(token, 0U, n, @ lo, @ count)
                if: count = spelling_size && c.memcmp(token + lo, bytes + spelling_at, count) = 0
                    return: 1
                ---
            ---
        ---
        i := i + 1U
    ---
    return: 0

# Full raw source equality, called only after bounded record validation.
fn: lmx_graph_scalar_record_row (const: (@: bytes char); size_t: nb; size_t: columns; size_t: row) int
    const: (@: token char 0)
    size_t: at c.strlen("primitive.description") + 1U
    size_t: key_end 0U
    size_t: val 0U
    size_t: val_end 0U
    size_t: n 0U
    if: columns != c.lmx_primitive_profile_columns
        return: 0
    while: at < nb
        key_end := lmx_graph_source_end(bytes, nb, at)
        val := key_end + 1U
        val_end := lmx_graph_source_end(bytes, nb, val)
        token := lmx_graph_source_pair_token(row, bytes + at, @ n)
        if: token = 0 || n != val_end - val || c.memcmp(token, bytes + val, n) != 0
            return: 0
        at := val_end + 1U
    ---
    return: 1

fn: lmx_graph_scalar_description (const: (@: abi c.LmxScalarABI); const: (@: bytes char); size_t: nb; @@: out void) int
    size_t: spelling_at 0U
    size_t: spelling_size 0U
    size_t: columns 0U
    size_t: row 0U
    @: identity char 0
    if: out = 0
        return: c.LMX_WALK_INVALID
    out[0] := 0
    if: abi = 0 || lmx_graph_scalar_record(bytes, nb, @ spelling_at, @ spelling_size, @ columns) = 0
        return: c.LMX_WALK_OK
    if: lmx_graph_scalar_record_abi(abi, bytes, spelling_at, spelling_size) = 0
        return: c.LMX_WALK_OK
    while: row < c.lmx_primitive_profile_count
        if: c.lmx_primitive_profile_scalar(row) = abi && lmx_graph_scalar_record_row(bytes, nb, columns, row) != 0
            out[0] := (cast: (@: void) c.lmx_primitive_profile_row(row))
            return: c.LMX_WALK_OK
        row := row + 1U
    ---
    identity := lmx_graph_intern(bytes, nb)
    if: identity = 0
        return: c.LMX_WALK_NOMEM
    out[0] := (cast: (@: void) identity)
    return: c.LMX_WALK_OK

fn: lmx_graph_scalar_source (const: (@: abi c.LmxScalarABI); @: description void) int
    const: (@: bytes char (cast: (const: @: char) description))
    size_t: i 0U
    size_t: nb 0U
    size_t: spelling_at 0U
    size_t: spelling_size 0U
    size_t: columns 0U
    @: selected void 0
    if: abi = 0 || description = 0
        return: 0
    while: i < c.lmx_primitive_profile_count
        if: (cast: (@: void) c.lmx_primitive_profile_row(i)) = description && c.lmx_primitive_profile_scalar(i) = abi
            return: 1
        i := i + 1U
    ---
    if: lmx_graph_intern_exact_size(description, @ nb) = 0
        return: 0
    if: nb >= 3U && bytes[0] = 99 && bytes[1] = 46 && lmx_graph_source_end(bytes, nb, 0U) = nb
        return: (cast: (int) (lmx_graph_scalar_binding((cast: (@: char) description), @ selected) = abi && selected = description))
    if: lmx_graph_scalar_record(bytes, nb, @ spelling_at, @ spelling_size, @ columns) = 0
        return: 0
    return: lmx_graph_scalar_record_abi(abi, bytes, spelling_at, spelling_size)

# Local families of declaring contracts, not receiver opcodes: primitive/C type, reference, qualification, Array.
# Pointer depth and rectangular Array rank are read from the complete canonical head, with no fixed ceiling.
fn: lmx_graph_declaration_receiver (@: head char) int
    size_t: i 0U
    if: head = 0 || head[0] = 0
        return: 0
    if: head = lmx_graph_intern("const", 5U) || head = lmx_graph_intern("immutable", 9U) || head = lmx_graph_intern("independent", 11U) || head = lmx_graph_intern("private", 7U) || head = lmx_graph_intern("required", 8U)
        return: 3
    if: head[0] = 64
        while: head[i] = 64
            i := i + 1U
        return: (cast: (int) (head[i] = 0)) * 2
    if: head[0] = 91
        while: head[i] = 91 && head[i + 1U] = 93
            i := i + 2U
        return: (cast: (int) (i != 0U && head[i] = 0)) * 4
    if: head[0] = 99 && head[1] = 46 && head[2] != 0
        return: 1
    return: lmx_graph_primitive_receiver(head)
end: lmx_graph_declaration_receiver

# A borrowed receiving view never rewrites its source or qualifier spine.
# Only a known qualifier consumes a single written operand and its one group;
# a named Structure/callable and an arbitrary singleton Structure stay whole.
fn: lmx_graph_receiving_view (@: g c.LmxGraph; @: raw void; @@: leaf void; @: binding_private int) int
    @: current void raw
    @: checkpoint void raw
    @: child void 0
    @: head char 0
    size_t: power 1U
    size_t: span 0U
    if: g = 0 || leaf = 0 || binding_private = 0
        return: 2
    leaf[0] := 0
    binding_private[0] := 0
    while: lmx_graph_kind(g, current) = 4
        head := lmx_graph_name_of(g, current)
        if: lmx_graph_declaration_receiver(head) != 3
            break
        if: lmx_graph_count((cast: (@: c.Lmx) current)) != 1U
            return: 2
        if: head = lmx_graph_intern("private", 7U)
            binding_private[0] := 1
        child := lmx_graph_get_in(g, (cast: (@: c.Lmx) current), 0U)
        if: lmx_graph_kind(g, child) = 4 && lmx_graph_name_of(g, child) = 0 && lmx_graph_count((cast: (@: c.Lmx) child)) = 1U
            child := lmx_graph_get_in(g, (cast: (@: c.Lmx) child), 0U)
        if: child = checkpoint
            return: 2
        span := span + 1U
        if: span = power
            checkpoint := child
            span := 0U
            if: power <= (cast: (size_t) -1) / 2U
                power := power * 2U
            ---
        ---
        current := child
    ---
    leaf[0] := current
    return: 0
end: lmx_graph_receiving_view

# Existing qualified receiving contracts stay whole until their physical
# lowering is available. Private alone changes binding, never value admission.
fn: lmx_graph_binding_leaf (@: g c.LmxGraph; @: raw void) @: void
    @: leaf void 0
    @: current void raw
    int: flag 0
    if: lmx_graph_receiving_view(g, raw, @ leaf, @ flag) != 0
        return: raw
    if: flag = 0
        return: raw
    while: current != leaf
        if: lmx_graph_name_of(g, current) != lmx_graph_intern("private", 7U)
            return: raw
        current := lmx_graph_get_in(g, (cast: (@: c.Lmx) current), 0U)
        if: lmx_graph_kind(g, current) = 4 && lmx_graph_name_of(g, current) = 0 && lmx_graph_count((cast: (@: c.Lmx) current)) = 1U
            current := lmx_graph_get_in(g, (cast: (@: c.Lmx) current), 0U)
    ---
    return: leaf
end: lmx_graph_binding_leaf

# Borrowed receiving parts: the caller retains raw, including every qualifier/Array receiver.
# Only that chain is read, never model/default contents or mutable payloads. A two-field reference
# remains ambiguous here; its operand is still available through leaf. C-door syntax alone is no type proof.
fn: lmx_graph_declaration_parts (@: g c.LmxGraph; @: raw void; @@: leaf void; @@: model void; @@: candidate void; @: default_presence int; @: receiver_known int) @: char
    @: current void raw
    @: checkpoint void raw
    @: child void 0
    @: head char 0
    @: name char 0
    size_t: n 0U
    size_t: power 1U
    size_t: span 0U
    int: kind 0
    int: family 0
    int: binding_private 0
    leaf[0] := 0
    model[0] := 0
    candidate[0] := 0
    default_presence[0] := 0 - 1
    receiver_known[0] := 1
    if: g = 0 || raw = 0
        return: 0
    while: current != 0
        kind := lmx_graph_kind(g, current)
        if: kind != 4
            if: c.lmx_range_classify(g\arena, current) != c.LMX_KIND_PRIMITIVE
                return: 0
            leaf[0] := current
            if: kind = 1 || kind = 2 || kind = 5 || kind = 6
                default_presence[0] := 1
            if: kind = 3 || kind = 8 || kind = 9
                default_presence[0] := 0
                current := c.lmx_arena_pointer_void_read(current)
            return: lmx_graph_name_of(g, current)
        head := lmx_graph_name_of(g, current)
        family := lmx_graph_declaration_receiver(head)
        if: family = 3
            if: lmx_graph_receiving_view(g, current, @ child, @ binding_private) != 0
                return: 0
            current := child
            continue
        if: family = 1 && lmx_graph_primitive_receiver(head) = 0
            receiver_known[0] := 0
        n := lmx_graph_count((cast: (@: c.Lmx) current))
        if: family = 0 || n = 0U
            return: 0
        child := lmx_graph_get_in(g, (cast: (@: c.Lmx) current), 0U)
        name := lmx_graph_word_text(g, child)
        if: name != 0
            if: (family = 1 && n > 2U) || (family = 2 && n > 3U)
                return: 0
            leaf[0] := current
            if: family = 1
                default_presence[0] := (cast: (int) (n = 2U))
            if: family = 1 && n = 2U
                candidate[0] := lmx_graph_get_in(g, (cast: (@: c.Lmx) current), 1U)
            if: family = 2
                default_presence[0] := (cast: (int) (n = 3U))
            if: family = 2 && n = 2U
                default_presence[0] := 0 - 1
            if: family = 2 && n = 3U
                model[0] := lmx_graph_get_in(g, (cast: (@: c.Lmx) current), 1U)
                candidate[0] := lmx_graph_get_in(g, (cast: (@: c.Lmx) current), 2U)
            return: name
        if: n != 1U
            return: 0
        # The direct primitive/reference contracts require an atom in their name position. A primitive may
        # prefix the Array type chain; this does not license old `int: @: p` or `@: int: x` declarations.
        if: family = 2
            return: 0
        if: (family = 1 || family = 4) && (lmx_graph_kind(g, child) != 4 || lmx_graph_declaration_receiver(lmx_graph_name_of(g, child)) != 4)
            return: 0
        if: child = checkpoint
            return: 0
        span := span + 1U
        if: span = power
            checkpoint := child
            span := 0U
        if: span = 0U && power <= (cast: (size_t) -1) / 2U
            power := power * 2U
        current := child
    return: 0

# Signature presence retains the receiving contract of a direct @ operand.
# This interpretation does not turn the same two-field DATA operand into a model or a value.
fn: lmx_graph_declaration_view (@: g c.LmxGraph; @: raw void; @: default_presence int) @: char
    @: leaf void 0
    @: model void 0
    @: candidate void 0
    @: name char 0
    @: operand void 0
    int: known 0
    name := lmx_graph_declaration_parts(g, raw, @ leaf, @ model, @ candidate, default_presence, @ known)
    if: name = 0 || lmx_graph_kind(g, leaf) != 4 || lmx_graph_declaration_receiver(lmx_graph_name_of(g, leaf)) != 2 || lmx_graph_count((cast: (@: c.Lmx) leaf)) != 2U
        return: name
    operand := lmx_graph_get_in(g, (cast: (@: c.Lmx) leaf), 1U)
    if: lmx_graph_word_text(g, operand) != 0
        default_presence[0] := 0
    if: lmx_graph_kind(g, operand) = 1 && c.lmx_int_value_known(operand) = 0
        default_presence[0] := 1
    return: name

# DATA/CODE names require a proved declaring contract, unlike provisional C types in a signature.
fn: lmx_graph_declaration_place_name (@: g c.LmxGraph; @: raw void) @: char
    @: leaf void 0
    @: model void 0
    @: candidate void 0
    @: name char 0
    int: presence 0 - 1
    int: known 0
    name := lmx_graph_declaration_parts(g, raw, @ leaf, @ model, @ candidate, @ presence, @ known)
    if: known = 0
        return: 0
    return: name

fn: lmx_graph_declaration_name (@: g c.LmxGraph; @: raw void) @: char
    int: presence 0 - 1
    return: lmx_graph_declaration_view(g, raw, @ presence)
end: lmx_graph_declaration_name

# Default presence, not its value or evaluation: 0 absent, 1 present, -1 not yet known by this declaration view.
# In particular an Array composition must not become a required formal merely because its lowering is pending.
fn: lmx_graph_declaration_default (@: g c.LmxGraph; @: raw void) int
    int: presence 0 - 1
    if: lmx_graph_declaration_view(g, raw, @ presence) = 0
        return: 0 - 1
    return: presence
end: lmx_graph_declaration_default

# The name the field index of a declaration Structure (args, data) answers to: a place by the name of its cell, a
# declaration Frame `T: name` or `@: name T` -- an Lmx named by its receiver (§3.3) -- by its first argument, an empty
# named Lmx -- a Structure formal of a receiver's contract, with no written model -- by its own name.
fn: lmx_graph_formal_name (@: g c.LmxGraph; @: lmx c.Lmx; size_t: index) @: char
    @: value void lmx_graph_get_in(g, lmx, index)
    @: inner c.Lmx 0
    @: name char 0
    if: lmx_graph_kind(g, value) = 4
        inner := (cast: (@: c.Lmx) value)
        if: lmx_graph_count(inner) = 0U
            return: lmx_graph_name_of(g, value)
        if: lmx_graph_name_of(g, value) = 0
            return: 0
        if: lmx_graph_declaration_receiver(lmx_graph_name_of(g, value)) = 0
            return: lmx_graph_name_of(g, value)
        name := lmx_graph_word_text(g, lmx_graph_get_in(g, inner, 0U))
        if: name != 0
            return: name
        return: lmx_graph_declaration_name(g, value)
    return: lmx_graph_slot_name(g, lmx, index)
end: lmx_graph_formal_name

# The field of a declaration Structure whose formal name is name, or the count of its fields.
fn: lmx_graph_formal (@: g c.LmxGraph; @: lmx c.Lmx; @: name char) size_t
    size_t: n lmx_graph_count(lmx)
    size_t: i 0U
    if: g = 0 || name = 0
        return: n
    while: i < n
        if: lmx_graph_formal_name(g, lmx, i) = name
            return: i
        i := i + 1U
    ---
    return: n
end: lmx_graph_formal

# The model named by a direct reference declaration: name, model and an optional default. Other primitive,
# qualification and Array descriptions are not implicitly Structure models; their lowering is separate.
fn: lmx_graph_formal_model (@: g c.LmxGraph; @: declaration c.Lmx) @: char
    @: state c.LmxGraphState lmx_graph_state()
    @: head char lmx_graph_name_of(g, (cast: (@: void) declaration))
    size_t: n lmx_graph_count(declaration)
    if: state = 0 || head = 0
        return: 0
    if: head = state\w_at
        if: n < 2U || n > 3U
            return: 0
        return: lmx_graph_word_text(g, lmx_graph_get_in(g, declaration, 1U))
    # Other accepted declaration descriptions (primitives, qualified/reference/Array compositions) do not become
    # Structure models merely because they have a head. Their backend support is separate from this projection.
    return: 0
end: lmx_graph_formal_model

# Shared address-typed reads for graph fields and activation arguments.
fn: lmx_graph_value_int (@: g c.LmxGraph; @: value void; @: out int) int
    int: kind lmx_graph_kind(g, value)
    @: pool c.LmxPool 0
    @: context c.LmxWalkValue 0
    if: g = 0 || out = 0
        return: 1
    if: kind = 3
        value := c.lmx_arena_pointer_void_read(value)
        kind := lmx_graph_kind(g, value)
    # An addressable result can retain its full scalar context in an ordinary
    # ABI cell. Read it numerically only when the frontend proved this exact
    # C access contract to be INT; physical kind/profile stay unchanged.
    if: kind = 0
        pool := c.lmx_range_cell_pool(g\arena, value)
        if: pool = 0 || pool\kind != c.LMX_KIND_PRIMITIVE || c.lmx_type_base(pool\type) != c.LMX_TYPE_FOREIGN || pool\scalar_abi = 0 || pool\stride != pool\scalar_abi\size || lmx_graph_scalar_type((cast: (const: @: c.LmxScalarABI) pool\scalar_abi)) != c.LMX_TYPE_INT
            return: 1
        context := c.lmx_value_cell_context(g\arena, value)
        if: context = 0 || context\present = 0 || context\kind != c.LMX_WALK_VALUE_FOREIGN || context\ref != value || context\type != pool\type || context\scalar_abi != pool\scalar_abi || context\physical_profile != pool\profile
            return: 1
        kind := 1
    ---
    if: kind != 1
        return: 1
    out[0] := c.lmx_int_value_known(value)
    return: 0
end: lmx_graph_value_int

# The field name of a Structure; a path step through a reference to a Structure reads the field of its target, the
# same instance (the book :441). 0 when there is no such field.
fn: lmx_graph_field (@: g c.LmxGraph; @: value void; @: name char) @: void
    @: base void lmx_graph_target(g, value)
    @: inner c.Lmx 0
    size_t: slot 0U
    if: lmx_graph_kind(g, base) != 4 || name = 0
        return: 0
    inner := (cast: (@: c.Lmx) base)
    slot := lmx_graph_named(g, inner, name)
    if: slot >= lmx_graph_count(inner)
        return: 0
    return: lmx_graph_get_in(g, inner, slot)
end: lmx_graph_field

# Compatibility query: 1 for an address-typed int place, direct or indirect; -1 otherwise. It does not track writes.
fn: lmx_graph_place_ready (@: g c.LmxGraph; @: lmx c.Lmx; size_t: index) int
    if: lmx_graph_kind(g, lmx_graph_place_cell(g, lmx, index)) = 1
        return: 1
    return: -1
end: lmx_graph_place_ready

# The value of an int place: direct and indirect places use the same cell operation. 2 for an invalid place.
# A declaration without an initializer promises no value before a write; no initialized state is stored or inferred.
fn: lmx_graph_read_int (@: g c.LmxGraph; @: lmx c.Lmx; size_t: index; @: out int) int
    if: lmx_graph_value_int(g, lmx_graph_get_in(g, lmx, index), out) != 0
        return: 2
    return: 0
end: lmx_graph_read_int

# Follow an int-reference place. The reference and its target are both classified by their arena addresses.
fn: lmx_graph_deref_int (@: g c.LmxGraph; @: lmx c.Lmx; size_t: index; @: out int) int
    @: pointer void lmx_graph_get_in(g, lmx, index)
    @: cell void 0
    pointer := lmx_graph_reference_cell(g, pointer)
    if: out = 0 || lmx_graph_kind(g, pointer) != 5
        return: 2
    cell := c.lmx_arena_pointer_void_read(pointer)
    if: lmx_graph_kind(g, cell) != 1
        return: 2
    out[0] := c.lmx_int_value_known(cell)
    return: 0
end: lmx_graph_deref_int

# Every write uses the same int cell. Neither the slot nor its optional pointer primitive is rebound or retyped.
# 0, or 1 when the slot holds no int place. This operation never changes the signature/default declaration shape.
fn: lmx_graph_assign_int (@: g c.LmxGraph; @: scope c.Lmx; @: lmx c.Lmx; size_t: index; int: value) int
    @: held void lmx_graph_binding_leaf(g, lmx_graph_get_in(g, lmx, index))
    @: cell void 0
    int: kind lmx_graph_kind(g, held)
    if: kind != 1 && kind != 3
        return: 1
    cell := held
    if: kind = 3
        cell := c.lmx_arena_pointer_void_read(held)
    if: lmx_graph_kind(g, cell) != 1 || lmx_graph_invalidate(g, scope, 0, cell, cell) != 0
        return: 1
    return: c.lmx_int_store_known(cell, value)
end: lmx_graph_assign_int

# A reference declaration's stable typed cell, through its service indirection.
# No payload is read, so this also selects a place without an initial address.
fn: lmx_graph_reference_cell (@: g c.LmxGraph; @: value void) @: void
    int: kind lmx_graph_kind(g, value)
    value := lmx_graph_binding_leaf(g, value)
    kind := lmx_graph_kind(g, value)
    int: expected 0
    if: kind = 5 || kind = 6
        return: value
    if: kind != 8 && kind != 9
        return: (cast: (@: void) 0)
    expected := kind - 3
    value := c.lmx_arena_pointer_void_read(value)
    if: lmx_graph_kind(g, value) != expected
        return: (cast: (@: void) 0)
return: value

# Allocate a real uninit:T declaration, or wrap an existing copied T cell.
# The typed cell and the wrapper keep their addresses after every write.
fn: lmx_graph_uninit_reference (@: g c.LmxGraph; int: kind; @: cell void) @: void
    @: wrapper void 0
    int: type 0
    int: uninit 0
    if: g = 0 || (kind != 5 && kind != 6)
        return: (cast: (@: void) 0)
    type := c.LMX_TYPE_GRAPH_INT_REF
    uninit := c.LMX_TYPE_UNINIT_GRAPH_INT_REF
    if: kind = 6
        type := c.LMX_TYPE_GRAPH_LMX_REF
        uninit := c.LMX_TYPE_UNINIT_GRAPH_LMX_REF
    if: cell = 0
        cell := c.lmx_arena_pointer_cells_profiled(g\arena, type, 0, sizeof(@: void), c.lmx_arena_pointer_void_read, c.lmx_arena_pointer_void_write, 1U)
    if: lmx_graph_kind(g, cell) != kind
        return: (cast: (@: void) 0)
    wrapper := c.lmx_arena_pointer_cells_profiled(g\arena, uninit, 0, sizeof(@: void), c.lmx_arena_pointer_void_read, c.lmx_arena_pointer_void_write, 1U)
    if: wrapper = 0 || c.lmx_arena_pointer_void_write(wrapper, cell) != 0
        return: (cast: (@: void) 0)
return: wrapper

# Admit a reference value without reading its referent's bytes or allocating.
fn: lmx_graph_reference_payload (@: g c.LmxGraph; int: kind; @: value void; @@: out void) int
    @: target void 0
    int: given lmx_graph_kind(g, value)
    int: status 0
    if: given = 8 || given = 9
        value := lmx_graph_reference_cell(g, value)
        given := lmx_graph_kind(g, value)
    if: out = 0
        return: 4
    # The number zero is the null address (`@: ptr 0`): the pointer is nulled (lmx_check_nulled).
    if: given = 1 && c.lmx_int_value_known(value) = 0
        status := c.lmx_check_nulled(kind)
        if: status != 0
            return: status
        out[0] := 0
        return: 0
    # The referent -- the int cell a pointer cell holds, or the Lmx the value stands for -- and its type checked by the
    # module of checks (lmx_check_reference).
    if: kind = 5 && (given = 5 || given = 7)
        target := c.lmx_arena_pointer_void_read(value)
        if: given = 7 && lmx_graph_kind(g, target) = 3
            target := c.lmx_arena_pointer_void_read(target)
        ---
    if: kind = 6
        target := lmx_graph_target(g, value)
    status := c.lmx_check_reference(kind, lmx_graph_kind(g, target))
    if: status != 0
        return: status
    out[0] := target
    return: 0

# Publish into the existing physical reference cell; a declaration slot and
# its service pointer are never rebound by a reference assignment.
fn: lmx_graph_assign_reference (@: g c.LmxGraph; @: scope c.Lmx; @: cell void; @: value void) int
    @: target void 0
    cell := lmx_graph_reference_cell(g, cell)
    if: cell = 0 || lmx_graph_reference_payload(g, lmx_graph_kind(g, cell), value, @ target) != 0
        return: 4
    if: lmx_graph_invalidate(g, scope, 0, cell, cell) != 0
        return: 4
return: c.lmx_arena_pointer_void_write(cell, target)

# A traversal-local set/queue. It contains addresses only, starts empty and is freed by its caller.
fn: lmx_graph_scan_add (@@@: items c.Lmx; @: count size_t; @: cap size_t; @: value c.Lmx) int
    @@: grown c.Lmx 0
    size_t: at 0U
    size_t: next 0U
    if: value = 0
        return: 0
    while: at < count[0]
        if: items[0][at] = value
            return: 0
        at := at + 1U
    ---
    if: count[0] = cap[0]
        next := 16U
        if: cap[0] != 0U
            if: cap[0] > ((cast: (size_t) -1) / 2U) / sizeof(@: void)
                return: 1
            next := cap[0] * 2U
        ---
        grown := (cast: (@@: c.Lmx) c.realloc((cast: (@: void) items[0]), next * sizeof(@: void)))
        if: grown = 0
            return: 1
        items[0] := grown
        cap[0] := next
    ---
    items[0][count[0]] := value
    count[0] := count[0] + 1U
    return: 0
end: lmx_graph_scan_add

# A written Frame of the graph: an Lmx named by its head (§3.3) -- a statement, a declaration or a named Structure;
# their roles are told by the consumers' resolution, not here. A Structure created by a receiver is a value, no Frame.
fn: lmx_graph_statement (@: g c.LmxGraph; @: value void) int
    if: lmx_graph_kind(g, value) != 4 || lmx_graph_name_of(g, value) = 0
        return: 0
    return: (cast: (int) (lmx_graph_fn_result(g, value) = 0))
end: lmx_graph_statement

# Is value, a field of code, code too -- an expression, an anonymous body, a Frame -- rather than a named Structure the
# namespace of the live traversal holds as data of that block, or a Structure a receiver created? 1 or 0. Without a live
# traversal every named field counts as code (the conservative reading).
fn: lmx_graph_field_pointer_value (@: g c.LmxGraph; @: holder c.Lmx; size_t: index) @: void
    @: cell void c.lmx_graph_cell_in((cast: (@: c.LmxArena) g\arena), holder, index)
    c.LmxPointerCellRead: read 0
    c.LmxPointerCellWrite: write 0
    if: cell != 0 && c.lmx_value_cell_access((cast: (@: c.LmxArena) g\arena), cell, @ read, @ write) = 0 && read != 0
        return: read(cell)
return: lmx_graph_get_in(g, holder, index)

fn: lmx_graph_code_child (@: g c.LmxGraph; @: code c.Lmx; @: value void) int
    @: name char 0
    if: c.lmx_graph_node_in((cast: (@: c.LmxArena) g\arena), value) = 0 || lmx_graph_fn_result(g, value) != 0
        return: 0
    name := lmx_graph_name_of(g, value)
    if: name != 0 && lmx_graph_space_find(code, name) = value
        return: 0
    return: 1
end: lmx_graph_code_child

# Does this executable Structure contain the written slot or primitive cell as code? Data places are not followed
# through the words that read them. A shared literal cell is nevertheless the same physical code place through any alias.
# Return 1 found, 0 absent, -1 allocation failure; every temporary address set is discarded.
fn: lmx_graph_code_uses (@: g c.LmxGraph; @: code c.Lmx; @: slot void; @: cell void; @: replacement void) int
    @@: queue c.Lmx 0
    size_t: count 0U
    size_t: cap 0U
    size_t: at 0U
    size_t: i 0U
    @: value void 0
    @: inner c.Lmx 0
    @: state c.LmxGraphState lmx_graph_state()
    int: result 0
    if: lmx_graph_method(g, code) != 0
        # A callable's slots and its executable parts -- args, return, code, reached through their references -- are
        # code; its own part data is data.
        i := 0U
        while: i < lmx_graph_count(code) && result = 0
            if: lmx_graph_slot_name(g, code, i) != state\w_data
                if: (slot != 0 && c.lmx_graph_cell_in((cast: (@: c.LmxArena) g\arena), code, i) = slot) || (cell != 0 && c.lmx_graph_cell_in((cast: (@: c.LmxArena) g\arena), code, i) = cell)
                    result := 1
                value := lmx_graph_target(g, lmx_graph_field_pointer_value(g, code, i))
                if: result = 0 && c.lmx_graph_node_in((cast: (@: c.LmxArena) g\arena), value) != 0
                    if: lmx_graph_scan_add(@ queue, @ count, @ cap, (cast: (@: c.Lmx) value)) != 0
                        result := -1
                    ---
                ---
            ---
            i := i + 1U
        ---
    else:
        i := 0U
        while: i < lmx_graph_count(code) && result = 0
            value := lmx_graph_field_pointer_value(g, code, i)
            if: ((slot != 0 && c.lmx_graph_cell_in((cast: (@: c.LmxArena) g\arena), code, i) = slot) || (cell != 0 && c.lmx_graph_cell_in((cast: (@: c.LmxArena) g\arena), code, i) = cell)) && (lmx_graph_code_child(g, code, value) != 0 || lmx_graph_code_child(g, code, replacement) != 0)
                result := 1
            if: result = 0 && lmx_graph_code_child(g, code, value) != 0
                if: lmx_graph_scan_add(@ queue, @ count, @ cap, (cast: (@: c.Lmx) value)) != 0
                    result := -1
                ---
            ---
            i := i + 1U
        ---
    ---
    while: at < count && result = 0
        inner := queue[at]
        at := at + 1U
        i := 0U
        while: i < lmx_graph_count(inner) && result = 0
            value := lmx_graph_field_pointer_value(g, inner, i)
            if: (slot != 0 && c.lmx_graph_cell_in((cast: (@: c.LmxArena) g\arena), inner, i) = slot) || (cell != 0 && (value = cell || c.lmx_graph_cell_in((cast: (@: c.LmxArena) g\arena), inner, i) = cell))
                result := 1
            if: result = 0 && c.lmx_graph_node_in((cast: (@: c.LmxArena) g\arena), value) != 0 && lmx_graph_fn_result(g, value) = 0
                if: lmx_graph_scan_add(@ queue, @ count, @ cap, (cast: (@: c.Lmx) value)) != 0
                    result := -1
                ---
            ---
            i := i + 1U
        ---
    ---
    c.free((cast: (@: void) queue))
    return: result
end: lmx_graph_code_uses

# Fresh scan from the supplied traversal scope and its lexical parents, including shared Lmx children. First prepare
# every affected entry; only then clear them, before the caller publishes the write. No reverse code index is retained.
# Message/activation/mail root-set integration follows with those consumers; this slice supplies its complete root.
fn: lmx_graph_invalidate_prepare (@: g c.LmxGraph; @: scope c.Lmx; @: slot void; @: cell void; @: replacement void; @@@: out c.Lmx; @: width size_t) int
    @@: nodes c.Lmx 0
    @@: affected c.Lmx 0
    size_t: count 0U
    size_t: cap 0U
    size_t: n_affected 0U
    size_t: affected_cap 0U
    size_t: at 0U
    size_t: i 0U
    @: current c.Lmx 0
    @: value void 0
    @: space c.LmxGraphSpace lmx_graph_space()
    @: row c.LmxGraphSpaceRow 0
    int: failed 0
    int: used 0
    if: g = 0 || out = 0 || width = 0 || c.lmx_graph_node_in((cast: (@: c.LmxArena) g\arena), (cast: (@: void) scope)) = 0
        return: 1
    out[0] := 0
    width[0] := 0U
    failed := lmx_graph_scan_add(@ nodes, @ count, @ cap, scope)
    # The Structures the receivers created in the live traversal are no fields of the graph: their native entries are
    # checked too, so a written body or signature is never run by a stale entry.
    if: space != 0
        while: i < space\count && failed = 0
            row := space\rows + i
            if: lmx_graph_fn_result(g, (cast: (@: void) row\value)) != 0
                failed := lmx_graph_scan_add(@ nodes, @ count, @ cap, (cast: (@: c.Lmx) row\value))
            i := i + 1U
        ---
        i := 0U
    ---
    while: at < count && failed = 0
        current := nodes[at]
        at := at + 1U
        if: current\native != 0
            used := lmx_graph_code_uses(g, current, slot, cell, replacement)
            if: used < 0
                failed := 1
            if: used > 0
                failed := lmx_graph_scan_add(@ affected, @ n_affected, @ affected_cap, current)
            ---
        ---
        if: failed = 0 && c.lmx_graph_node_in((cast: (@: c.LmxArena) g\arena), (cast: (@: void) current\parent)) != 0
            failed := lmx_graph_scan_add(@ nodes, @ count, @ cap, (cast: (@: c.Lmx) current\parent))
        i := 0U
        while: i < lmx_graph_count(current) && failed = 0
            value := lmx_graph_field_pointer_value(g, current, i)
            if: c.lmx_graph_node_in((cast: (@: c.LmxArena) g\arena), value) != 0
                failed := lmx_graph_scan_add(@ nodes, @ count, @ cap, (cast: (@: c.Lmx) value))
            i := i + 1U
        ---
    ---
    c.free((cast: (@: void) nodes))
    if: failed != 0
        c.free((cast: (@: void) affected))
        return: failed
    out[0] := affected
    width[0] := n_affected
return: 0

sub: lmx_graph_invalidate_finish (@@: affected c.Lmx; size_t: count)
    size_t: i 0U
    @: current c.Lmx 0
    while: i < count
        current := affected[i]
        current\native := 0
        i := i + 1U
    c.free((cast: (@: void) affected))
return

fn: lmx_graph_invalidate (@: g c.LmxGraph; @: scope c.Lmx; @: slot void; @: cell void; @: replacement void) int
    @@: affected c.Lmx 0
    size_t: count 0U
    int: status lmx_graph_invalidate_prepare(g, scope, slot, cell, replacement, @ affected, @ count)
    if: status = 0
        lmx_graph_invalidate_finish(affected, count)
return: status

# Runtime replacement, separate from the constructor's raw put. The physical slot is the write target.
fn: lmx_graph_write_slot (@: g c.LmxGraph; @: scope c.Lmx; @: holder c.Lmx; size_t: index; @: value void) int
    @: arena c.LmxArena 0
    @: cell void 0
    c.LmxPointerCellRead: read 0
    c.LmxPointerCellWrite: write 0
    @@: affected c.Lmx 0
    size_t: count 0U
    int: status 0
    if: g = 0
        return: 1
    arena := (cast: (@: c.LmxArena) g\arena)
    if: c.lmx_graph_node_in(arena, (cast: (@: void) holder)) = 0
        return: 1
    cell := c.lmx_graph_cell_in(arena, holder, index)
    if: cell = 0 || c.lmx_value_cell_access(arena, cell, @ read, @ write) != 0 || write = 0 || c.lmx_range_write_exact_blocked(arena, cell, 0, 0, 0U) != 0
        return: 1
    status := lmx_graph_invalidate_prepare(g, scope, cell, 0, value, @ affected, @ count)
    if: status != 0
        return: status
    status := c.lmx_value_cell_store(arena, cell, 0, value, 0, write)
    if: status = 0
        lmx_graph_invalidate_finish(affected, count)
    else:
        c.free((cast: (@: void) affected))
return: status

# The innermost place of the receiver chain of the field index of owner: the field (the qualifier record, or its single anonymous group, and 0) that holds the
# declaration under the known qualifiers const/immutable/independent/private; the field itself when no qualifier stands in it. The walk of lmx_graph_receiving_view,
# keeping where the leaf stands. 0, or 2 for a qualifier that does not hold one operand.
fn: lmx_graph_receiving_place (@: g c.LmxGraph; @: owner c.Lmx; size_t: index; @@: inner c.Lmx; @: at size_t) int
    @: current void lmx_graph_get_in(g, owner, index)
    @: holder c.Lmx owner
    @: child void 0
    size_t: place index
    while: lmx_graph_kind(g, current) = 4 && lmx_graph_declaration_receiver(lmx_graph_name_of(g, current)) = 3
        if: lmx_graph_count((cast: (@: c.Lmx) current)) != 1U
            return: 2
        holder := (cast: (@: c.Lmx) current)
        place := 0U
        child := lmx_graph_get_in(g, holder, 0U)
        if: lmx_graph_kind(g, child) = 4 && lmx_graph_name_of(g, child) = 0 && lmx_graph_count((cast: (@: c.Lmx) child)) = 1U
            holder := (cast: (@: c.Lmx) child)
            child := lmx_graph_get_in(g, holder, 0U)
        current := child
    inner[0] := holder
    at[0] := place
    return: 0

# ---- The declarations under the modifiers (the author 2026-11-18: #marking-receivers-execute, #two-kinds-of-receivers,
# #arguments-by-number-and-form; the book #data-root-declaration-execution, #qualification) -------------------------
# The modifiers private, required, const, immutable and independent take their arguments as data: the arguments of a
# modifier are its written fields, whatever form its record was written in (short, compact, block); an argument that is
# itself a Structure stays a Structure. These read the record as written each time and store nothing about it.

# The declarations under the field index of holder, depth first in written order: a field that is no modifier is one
# declaration, itself; a modifier gives the declarations under each of its arguments, its written fields. At the
# declaration of ordinal want (counted in seen) the Lmx that holds it and its position go to inner and at. path holds the
# modifiers entered. 0; 2 for a modifier without an argument or one met again on its own path.
fn: lmx_graph_declared_walk (@: g c.LmxGraph; @: holder c.Lmx; size_t: index; size_t: want; @: seen size_t; @@: inner c.Lmx; @: at size_t; @@: path void) int
    @: current void lmx_graph_get_in(g, holder, index)
    @@: link void 0
    size_t: n 0U
    size_t: k 0U
    int: status 0
    if: lmx_graph_kind(g, current) != 4 || lmx_graph_declaration_receiver(lmx_graph_name_of(g, current)) != 3
        if: seen[0] = want
            inner[0] := holder
            at[0] := index
        seen[0] := seen[0] + 1U
        return: 0
    n := lmx_graph_count((cast: (@: c.Lmx) current))
    if: n = 0U || lmx_graph_dump_on_path(path, current) != 0
        return: 2
    link := lmx_graph_dump_enter(path, current)
    if: link = 0
        return: 2
    while: k < n && status = 0
        status := lmx_graph_declared_walk(g, (cast: (@: c.Lmx) current), k, want, seen, inner, at, link)
        k := k + 1U
    c.free((cast: (@: void) link))
    return: status

# The number of declarations the field index of holder gives to its modifiers: 1 for a field that is no modifier; 0 for a
# modifier without an argument.
fn: lmx_graph_declared_count (@: g c.LmxGraph; @: holder c.Lmx; size_t: index) size_t
    @: inner c.Lmx 0
    size_t: at 0U
    size_t: seen 0U
    if: lmx_graph_declared_walk(g, holder, index, (cast: (size_t) -1), @ seen, @ inner, @ at, 0) != 0
        return: 0U
    return: seen

# Where the j-th declaration of the field index of holder stands, in written order: the Lmx that holds it and its position
# there (the declaration is lmx_graph_get_in(g, inner, at)). 0; 2 for no j-th.
fn: lmx_graph_declared_at (@: g c.LmxGraph; @: holder c.Lmx; size_t: index; size_t: j; @@: inner c.Lmx; @: at size_t) int
    size_t: seen 0U
    inner[0] := 0
    if: lmx_graph_declared_walk(g, holder, index, j, @ seen, inner, at, 0) != 0 || inner[0] = 0
        return: 2
    return: 0

# Does a modifier named mark stand above the declaration of name in the record raw, a field as written? above says whether
# one stood above raw already; path holds the modifiers entered. 1 or 0; 0 for a record that declares no name, or a modifier
# met again on its own path.
fn: lmx_graph_record_mark_at (@: g c.LmxGraph; @: raw void; @: name char; @: mark char; int: above; @@: path void) int
    @@: link void 0
    size_t: k 0U
    int: found 0
    if: lmx_graph_kind(g, raw) != 4 || lmx_graph_declaration_receiver(lmx_graph_name_of(g, raw)) != 3
        if: name != 0 && (lmx_graph_name_of(g, raw) = name || lmx_graph_declaration_place_name(g, raw) = name)
            return: above
        return: 0
    if: lmx_graph_dump_on_path(path, raw) != 0
        return: 0
    link := lmx_graph_dump_enter(path, raw)
    if: link = 0
        return: 0
    if: lmx_graph_name_of(g, raw) = mark
        above := 1
    while: k < lmx_graph_count((cast: (@: c.Lmx) raw)) && found = 0
        found := lmx_graph_record_mark_at(g, lmx_graph_get_in(g, (cast: (@: c.Lmx) raw), k), name, mark, above, link)
        k := k + 1U
    c.free((cast: (@: void) link))
    return: found

fn: lmx_graph_record_mark (@: g c.LmxGraph; @: raw void; @: name char; @: mark char) int
    if: g = 0 || raw = 0 || mark = 0
        return: 0
    return: lmx_graph_record_mark_at(g, raw, name, mark, 0, 0)

# Publish a computed declaration through the same runtime write, naming it with the canonical word in that declaration:
# the declaration Frame `int: name expression` (an Lmx named int, §3.3) has the name as its first argument. The new
# place stands in the slot of the declaration, where the registry of the block reads it (plan M11 5a), and answers the
# name in the namespace of the live traversal too.
fn: lmx_graph_publish (@: g c.LmxGraph; @: root c.Lmx; size_t: index; @: value void) int
    @: statement void lmx_graph_binding_leaf(g, lmx_graph_get_in(g, root, index))
    @: name char 0
    @: inner c.Lmx 0
    size_t: at 0U
    if: lmx_graph_statement(g, statement) = 0
        return: 1
    name := lmx_graph_declaration_place_name(g, statement)
    if: name = 0 || lmx_graph_name_address(g, value, name) != 0
        return: 1
    if: lmx_graph_receiving_place(g, root, index, @ inner, @ at) != 0 || lmx_graph_write_slot(g, root, inner, at, value) != 0
        return: 1
    return: lmx_graph_space_put(root, name, value)
end: lmx_graph_publish

# ---- The namespace of a traversal (§5.2; the author 2026-11-09) ----------------------------------------------------
# The rows of the live traversal: each traversal begins with an empty table (lmx_graph_space_push) and frees it at its
# end (lmx_graph_space_pop); a traversal entered inside another (a data's initializers, an explicit call of a Structure)
# shares the live one. Nothing of a table is kept in the graph, beside it or for the next traversal.

# The live table, or 0 outside every traversal.
fn: lmx_graph_space () @: c.LmxGraphSpace
    @@: top c.LmxGraphSpace (cast: (@@: c.LmxGraphSpace) (@ c.lmx_graph_space_top))
    return: top[0]
end: lmx_graph_space

# Begin the table of a traversal of root: 1 when a new empty table is live, 0 when a traversal is live already (then it
# goes on with that one), -1 without memory.
fn: lmx_graph_space_push (@: root c.Lmx) int
    @@: top c.LmxGraphSpace (cast: (@@: c.LmxGraphSpace) (@ c.lmx_graph_space_top))
    if: top[0] != 0
        return: 0
    return: lmx_graph_space_push_fresh(root)
end: lmx_graph_space_push

# An independent construction owns its table even inside another live walk.
# The existing prior link restores that walk on every constructor exit.
fn: lmx_graph_space_push_fresh (@: root c.Lmx) int
    @@: top c.LmxGraphSpace (cast: (@@: c.LmxGraphSpace) (@ c.lmx_graph_space_top))
    @: space c.LmxGraphSpace 0
    space := (cast: (@: c.LmxGraphSpace) c.calloc(1U, c.sizeof(c.LmxGraphSpace)))
    if: space = 0
        return: -1
    space\root := root
    space\prior := top[0]
    top[0] := space
    return: 1
end: lmx_graph_space_push_fresh

# End the live table (opened is the answer of its lmx_graph_space_push: only 1 ends it).
sub: lmx_graph_space_pop (int: opened)
    @@: top c.LmxGraphSpace (cast: (@@: c.LmxGraphSpace) (@ c.lmx_graph_space_top))
    @: space c.LmxGraphSpace 0
    space := top[0]
    if: opened != 1 || space = 0
        return
    top[0] := space\prior
    c.free((cast: (@: void) space\rows))
    c.free((cast: (@: void) space))
    return
end: lmx_graph_space_pop

# What name answers in the lexical block scope of the live traversal: the latest row, or 0.
fn: lmx_graph_space_find (@: scope c.Lmx; @: name char) @: void
    @: space c.LmxGraphSpace lmx_graph_space()
    @: row c.LmxGraphSpaceRow 0
    size_t: i 0U
    if: space = 0 || scope = 0 || name = 0
        return: 0
    i := space\count
    while: i > 0U
        i := i - 1U
        row := space\rows + i
        if: row\scope = scope && row\name = name
            return: row\value
    ---
    return: 0
end: lmx_graph_space_find

# The rows of name in the lexical block scope of the live traversal, in the order they were put: how many, and the k-th.
# Each declaration of fn or sub of one name in one block is a row (lmx_graph_space_declare), and every one of them is a
# candidate of a call of that name (the book #declaration-selection); lmx_graph_space_find answers only the latest.
fn: lmx_graph_space_count (@: scope c.Lmx; @: name char) size_t
    @: space c.LmxGraphSpace lmx_graph_space()
    @: row c.LmxGraphSpaceRow 0
    size_t: i 0U
    size_t: n 0U
    if: space = 0 || scope = 0 || name = 0
        return: 0U
    while: i < space\count
        row := space\rows + i
        if: row\scope = scope && row\name = name
            n := n + 1U
        i := i + 1U
    return: n

fn: lmx_graph_space_nth (@: scope c.Lmx; @: name char; size_t: k) @: void
    @: space c.LmxGraphSpace lmx_graph_space()
    @: row c.LmxGraphSpaceRow 0
    size_t: i 0U
    size_t: n 0U
    if: space = 0 || scope = 0 || name = 0
        return: 0
    while: i < space\count
        row := space\rows + i
        if: row\scope = scope && row\name = name
            if: n = k
                return: row\value
            n := n + 1U
        i := i + 1U
    return: 0

# A row of the live traversal: from now on name answers value in the block scope. 0 (also outside every traversal,
# where nothing is recorded), 1 without memory.
fn: lmx_graph_space_put (@: scope c.Lmx; @: name char; @: value void) int
    @: space c.LmxGraphSpace lmx_graph_space()
    @: rows c.LmxGraphSpaceRow 0
    @: row c.LmxGraphSpaceRow 0
    size_t: cap 0U
    if: space = 0
        return: 0
    if: scope = 0 || name = 0 || value = 0
        return: 1
    if: space\count = space\cap
        cap := space\cap * 2U + 16U
        rows := (cast: (@: c.LmxGraphSpaceRow) c.realloc((cast: (@: void) space\rows), cap * c.sizeof(c.LmxGraphSpaceRow)))
        if: rows = 0
            return: 1
        space\rows := rows
        space\cap := cap
    ---
    row := space\rows + space\count
    row\scope := scope
    row\name := name
    row\value := value
    space\count := space\count + 1U
    return: 0
end: lmx_graph_space_put

# ---- toLmx-like print (§8) ----------------------------------------------------------------------------------------

sub: lmx_graph_dump_indent (@: f c.FILE; int: depth)
    int: i 0
    while: i < depth
        c.fputs("    ", f)
        i := i + 1
    ---
    return
end: lmx_graph_dump_indent

# The path of a print (plan M11 5a): the chain of the Structures whose fields are being printed, innermost first, each
# link a pair [Structure, the link before]. A write can close a cycle -- `A[0] := B`, `B[0] := A` hold each Structure
# inside the other, one instance each --, and a Structure met again on the path is printed by its name, not entered:
# the print ends. lmx_graph_dump_enter makes the link of value on path (0 without memory); lmx_graph_dump_on_path
# answers whether value is on path (1 or 0).
fn: lmx_graph_dump_enter (@@: path void; @: value void) @@: void
    @@: link void (cast: (@@: void) c.calloc(2U, sizeof(@: void)))
    if: link = 0
        return: 0
    link[0] := value
    link[1] := (cast: (@: void) path)
    return: link
end: lmx_graph_dump_enter

fn: lmx_graph_dump_on_path (@@: path void; @: value void) int
    @@: link void path
    while: link != 0
        if: link[0] = value
            return: 1
        link := (cast: (@@: void) link[1])
    ---
    return: 0
end: lmx_graph_dump_on_path

# A Structure met again on the path of a print (a cycle): its name, or `...` for an unnamed one.
sub: lmx_graph_dump_again (@: g c.LmxGraph; @: value void; @: f c.FILE)
    @: name char lmx_graph_name_of(g, value)
    if: name = 0
        c.fputs("...", f)
    else:
        c.fputs(name, f)
    ---
    return
end: lmx_graph_dump_again

# A path's occurrence step is an anonymous pair of WORDs: decimal ordinal and canonical name.
# A WORD itself is always a literal name. No text opcode, evaluation, unwrap or allocation is involved.
fn: lmx_graph_occurrence (@: g c.LmxGraph; @: raw void; @: index_out size_t; @@: name_out char) int
    @: step c.Lmx (cast: (@: c.Lmx) raw)
    @: digits char 0
    @: name char 0
    size_t: i 0U
    size_t: index 0U
    size_t: digit 0U
    size_t: limit (cast: (size_t) -1)
    if: index_out = 0 || name_out = 0 || lmx_graph_kind(g, raw) != 4 || lmx_graph_name_of(g, raw) != 0
        return: 0
    if: lmx_graph_count(step) != 2U
        return: 0
    digits := lmx_graph_word_text(g, lmx_graph_get_in(g, step, 0U))
    name := lmx_graph_word_text(g, lmx_graph_get_in(g, step, 1U))
    if: digits = 0 || digits[0] = (cast: (char) 0) || name = 0
        return: 0
    while: digits[i] != (cast: (char) 0)
        if: digits[i] < 48 || digits[i] > 57
            return: 0
        digit := (cast: (size_t) (digits[i] - 48))
        if: index > (limit - digit) / 10U
            return: 0
        index := index * 10U + digit
        i := i + 1U
    ---
    index_out[0] := index
    name_out[0] := name
    return: 1
end: lmx_graph_occurrence

# Protect a selector component's exact boundary in the textual graph view.
fn: lmx_graph_dump_selector_name (@: text char; @: f c.FILE) int
    size_t: i 0U
    int: quoted 0
    int: b 0
    if: text = 0
        return: 1
    if: text[0] = (cast: (char) 0) || (text[0] >= 48 && text[0] <= 57)
        quoted := 1
    while: text[i] != (cast: (char) 0)
        b := (cast: (int) text[i])
        if: ((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b = 95 || b = 46) = 0
            quoted := 1
        i := i + 1U
    ---
    if: quoted != 0
        c.fputc(96, f)
    i := 0U
    while: text[i] != (cast: (char) 0)
        c.fputc((cast: (int) text[i]), f)
        if: text[i] = 96
            c.fputc(96, f)
        i := i + 1U
    ---
    if: quoted != 0
        c.fputc(96, f)
    return: 0
end: lmx_graph_dump_selector_name

fn: lmx_graph_dump_selector (@: g c.LmxGraph; @: raw void; @: f c.FILE; @@: path void) int
    @: name char lmx_graph_word_text(g, raw)
    size_t: index 0U
    if: name != 0
        return: lmx_graph_dump_selector_name(name, f)
    if: lmx_graph_occurrence(g, raw, @ index, @ name) != 0
        c.fprintf(f, "[%zu]", index)
        return: lmx_graph_dump_selector_name(name, f)
    return: lmx_graph_dump_token(g, raw, f, path)
end: lmx_graph_dump_selector

# One field in the line form: a word by its spelling, an int by its value; a place as `(int name value)` or
# `(int name)` and a reference place as `(@ name target)`; an Lmx in parentheses -- a Frame (an Lmx named by its head,
# §3.3) as `(head arguments)`, an anonymous Structure or an expression as `(fields)` -- or by its name when it is on the
# path of the print already (lmx_graph_dump_on_path). 0, or 1 when a cell is none of the graph's or without memory.
fn: lmx_graph_dump_token (@: g c.LmxGraph; @: value void; @: f c.FILE; @@: path void) int
    @: state c.LmxGraphState lmx_graph_state()
    int: kind lmx_graph_kind(g, value)
    @: text char 0
    @: name char 0
    @: inner c.Lmx 0
    @@: link void 0
    size_t: i 0U
    size_t: n 0U
    int: printed 0
    int: status 0
    if: kind = 2
        text := lmx_graph_word_text(g, value)
        if: text = 0
            return: 1
        c.fputs(text, f)
        return: 0
    if: kind = 1
        name := lmx_graph_name_of(g, value)
        if: name != 0
            c.fprintf(f, "(int %s %d)", name, c.lmx_int_value_known(value))
        else:
            c.fprintf(f, "%d", c.lmx_int_value_known(value))
        ---
        return: 0
    if: kind = 8 || kind = 9
        text := lmx_graph_name_of(g, c.lmx_arena_pointer_void_read(value))
        if: text = 0
            return: 1
        if: kind = 8
            c.fprintf(f, "(@ %s int)", text)
        if: kind = 9
            c.fprintf(f, "(@ %s)", text)
        return: 0
    if: kind = 3
        text := lmx_graph_name_of(g, c.lmx_arena_pointer_void_read(value))
        if: text = 0
            return: 1
        c.fprintf(f, "(int %s)", text)
        return: 0
    if: kind = 5 || kind = 6
        name := lmx_graph_name_of(g, value)
        text := lmx_graph_name_of(g, lmx_graph_target(g, value))
        if: kind = 5
            text := lmx_graph_name_of(g, c.lmx_arena_pointer_void_read(value))
        if: name = 0 || text = 0
            return: 1
        if: kind = 5
            c.fprintf(f, "(@ %s int @%s)", name, text)
        else:
            c.fprintf(f, "(@ %s %s)", name, text)
        ---
        return: 0
    # A typed number (G2.1): a value cell of a literal row, written back as its canonical C99 spelling
    # (lmx_graph_scalar_text) -- reading that text again gives the same type and value.
    if: kind = 0
        text := (cast: (@: char) c.calloc(64U, 1U))
        status := 1
        if: text != 0
            status := lmx_graph_scalar_text(g, value, text, 64U)
        if: status = 0
            c.fputs(text, f)
        c.free((cast: (@: void) text))
        return: status
    if: kind != 4
        return: 1
    if: lmx_graph_dump_on_path(path, value) != 0
        lmx_graph_dump_again(g, value, f)
        return: 0
    link := lmx_graph_dump_enter(path, value)
    if: link = 0
        return: 1
    text := lmx_graph_name_of(g, value)
    inner := (cast: (@: c.Lmx) value)
    n := lmx_graph_count(inner)
    printed := lmx_graph_dump_application(g, inner, f, link)
    if: printed >= 0
        c.free((cast: (@: void) link))
        return: printed
    printed := 0
    c.fputs("(", f)
    if: text != 0
        c.fputs(text, f)
        printed := 1
    # An empty slot prints nothing (lmx_graph_dump_at); a separator goes before every printed field but the first.
    while: i < n && status = 0
        if: lmx_graph_get_in(g, inner, i) != 0
            if: printed != 0
                c.fputs(" ", f)
            printed := 1
            if: state != 0 && text = 0 && n = 3U && i = 0U && lmx_graph_word_text(g, lmx_graph_get_in(g, inner, i)) != 0 && (lmx_graph_word_text(g, lmx_graph_get_in(g, inner, 1U)) = state\w_deref || lmx_graph_word_text(g, lmx_graph_get_in(g, inner, 1U)) = state\w_index)
                status := lmx_graph_dump_selector_name(lmx_graph_word_text(g, lmx_graph_get_in(g, inner, i)), f)
            else:
                if: state != 0 && text = 0 && n = 3U && i = 2U && lmx_graph_word_text(g, lmx_graph_get_in(g, inner, 1U)) = state\w_deref
                    status := lmx_graph_dump_selector(g, lmx_graph_get_in(g, inner, i), f, link)
                else:
                    status := lmx_graph_dump_token(g, lmx_graph_get_in(g, inner, i), f, link)
                ---
            ---
        ---
        i := i + 1U
    ---
    c.free((cast: (@: void) link))
    if: status != 0
        return: 1
    c.fputs(")", f)
    return: 0
end: lmx_graph_dump_token

# The fields of inner from index from in the line form, a space before each; an empty slot prints nothing. path is the
# path of the print with inner on it. 0, or 1 when a cell is none of the graph's.
fn: lmx_graph_dump_fields (@: g c.LmxGraph; @: inner c.Lmx; size_t: from; @: f c.FILE; @@: path void) int
    size_t: k from
    size_t: m lmx_graph_count(inner)
    while: k < m
        if: lmx_graph_get_in(g, inner, k) != 0
            c.fputs(" ", f)
            if: lmx_graph_dump_token(g, lmx_graph_get_in(g, inner, k), f, path) != 0
                return: 1
            ---
        ---
        k := k + 1U
    ---
    return: 0
end: lmx_graph_dump_fields

# One formal of a declaration's args in its written form: `int: name`, `int: name value`, `T: name`, `@: name T`. path
# is the path of the print with args on it.
fn: lmx_graph_dump_formal (@: g c.LmxGraph; @: args c.Lmx; size_t: index; @: f c.FILE; @@: path void) int
    @: state c.LmxGraphState lmx_graph_state()
    @: formal void lmx_graph_get_in(g, args, index)
    @: declaration c.Lmx 0
    @: head char 0
    int: kind lmx_graph_kind(g, formal)
    if: kind = 1 || kind = 3
        c.fprintf(f, "int: %s", lmx_graph_slot_name(g, args, index))
        if: kind = 1
            c.fprintf(f, " %d", c.lmx_int_value_known(formal))
        return: 0
    if: kind = 8
        c.fprintf(f, "@: %s int", lmx_graph_slot_name(g, args, index))
        return: 0
    if: kind = 9
        c.fprintf(f, "@: %s", lmx_graph_slot_name(g, args, index))
        return: 0
    if: kind = 6 && c.lmx_arena_pointer_void_read(formal) = 0
        c.fprintf(f, "@: %s 0", lmx_graph_slot_name(g, args, index))
        return: 0
    if: kind != 4
        return: lmx_graph_dump_token(g, formal, f, path)
    declaration := (cast: (@: c.Lmx) formal)
    head := lmx_graph_name_of(g, formal)
    if: head = 0 || lmx_graph_count(declaration) = 0U || lmx_graph_word_text(g, lmx_graph_get_in(g, declaration, 0U)) = 0
        return: lmx_graph_dump_token(g, formal, f, path)
    c.fprintf(f, "%s: %s", head, lmx_graph_word_text(g, lmx_graph_get_in(g, declaration, 0U)))
    if: head = state\w_at && lmx_graph_count(declaration) = 2U
        c.fputs(" ", f)
        return: lmx_graph_dump_token(g, lmx_graph_get_in(g, declaration, 1U), f, path)
    return: 0
end: lmx_graph_dump_formal

# The written form of a declaration Frame of the receiver fn or sub -- `fn: name (args) return`, its data part when
# written, its body lines and `end: name` -- in the positions of its arguments: fn [name, args, return], [name, args,
# return, code] or [name, args, return, data, code]; sub [name, args, code] or [name, args, data, code]. 1 when the Lmx is
# such a Frame and was printed, 0 when it is not (the caller prints it as any Frame), -1 when a cell is none of the
# graph's or without memory. path is the path of the print with value on it.
fn: lmx_graph_dump_declaration (@: g c.LmxGraph; @: value void; @: f c.FILE; int: depth; @@: path void) int
    @: state c.LmxGraphState lmx_graph_state()
    @: decl c.Lmx 0
    @: head char lmx_graph_name_of(g, value)
    @: name char 0
    @: args c.Lmx 0
    @: vars c.Lmx 0
    @: body c.Lmx 0
    @: result void 0
    @@: link void 0
    size_t: n 0U
    size_t: i 0U
    int: status 0
    if: state = 0 || lmx_graph_kind(g, value) != 4 || (head != state\w_fn && head != state\w_sub)
        return: 0
    decl := (cast: (@: c.Lmx) value)
    n := lmx_graph_count(decl)
    name := lmx_graph_word_text(g, lmx_graph_get_in(g, decl, 0U))
    if: name = 0 || n < 3U || lmx_graph_kind(g, lmx_graph_get_in(g, decl, 1U)) != 4 || lmx_graph_name_of(g, lmx_graph_get_in(g, decl, 1U)) != 0
        return: 0
    args := (cast: (@: c.Lmx) lmx_graph_get_in(g, decl, 1U))
    if: head = state\w_fn
        result := lmx_graph_get_in(g, decl, 2U)
        if: n = 4U
            body := (cast: (@: c.Lmx) lmx_graph_get_in(g, decl, 3U))
        if: n = 5U
            vars := (cast: (@: c.Lmx) lmx_graph_get_in(g, decl, 3U))
            body := (cast: (@: c.Lmx) lmx_graph_get_in(g, decl, 4U))
        ---
        if: n > 5U
            return: 0
        ---
    else:
        if: n = 3U
            body := (cast: (@: c.Lmx) lmx_graph_get_in(g, decl, 2U))
        if: n = 4U
            vars := (cast: (@: c.Lmx) lmx_graph_get_in(g, decl, 2U))
            body := (cast: (@: c.Lmx) lmx_graph_get_in(g, decl, 3U))
        ---
        if: n > 4U
            return: 0
    ---
    if: (body != 0 && (lmx_graph_kind(g, (cast: (@: void) body)) != 4 || lmx_graph_name_of(g, (cast: (@: void) body)) != 0)) || (vars != 0 && (lmx_graph_kind(g, (cast: (@: void) vars)) != 4 || lmx_graph_name_of(g, (cast: (@: void) vars)) != 0))
        return: 0
    c.fprintf(f, "%s: %s (", head, name)
    link := lmx_graph_dump_enter(path, (cast: (@: void) args))
    if: link = 0
        return: -1
    while: i < lmx_graph_count(args) && status = 0
        if: i != 0U
            c.fputs("; ", f)
        status := lmx_graph_dump_formal(g, args, i, f, link)
        i := i + 1U
    ---
    c.free((cast: (@: void) link))
    if: status != 0
        return: -1
    c.fputs(")", f)
    if: head = state\w_fn
        c.fputs(" ", f)
        if: lmx_graph_dump_token(g, result, f, path) != 0
            return: -1
        ---
    ---
    if: vars != 0 && lmx_graph_count(vars) != 0U
        c.fputs(" (\n", f)
        if: lmx_graph_dump_child(g, vars, f, depth + 1, path) != 0
            return: -1
        lmx_graph_dump_indent(f, depth)
        c.fputs(")", f)
    ---
    c.fputs("\n", f)
    if: body = 0
        return: 1
    if: lmx_graph_dump_child(g, body, f, depth + 1, path) != 0
        return: -1
    lmx_graph_dump_indent(f, depth)
    c.fprintf(f, "end: %s\n", name)
    return: 1
end: lmx_graph_dump_declaration

# Is word a statement word of the language (its Frame prints in one line, as written: `if: cond (body)`)? 1 or 0.
fn: lmx_graph_dump_statement_word (@: word char) int
    @: state c.LmxGraphState lmx_graph_state()
    if: state = 0 || word = 0
        return: 0
    return: (cast: (int) (word = state\w_if || word = state\w_else || word = state\w_while || word = state\w_for || word = state\w_until || word = state\w_finally || word = state\w_return || word = state\w_call || word = state\w_break || word = state\w_continue || word = state\w_redo || word = state\w_merge))
end: lmx_graph_dump_statement_word

# Whether the named Frame inner prints as its block `head:` ... `end: head`: it is no statement of the language, and a
# field of it is a place or a statement of the language, two of its fields are Frames, or its Frame field prints as a
# block itself (a data block holding another, `Holder:` `Inner:`) -- a Frame on the path of the print (path, with inner
# on it) prints by its name, as no block. 1 or 0; -1 without memory.
fn: lmx_graph_dump_block (@: g c.LmxGraph; @: inner c.Lmx; @@: path void) int
    size_t: m lmx_graph_count(inner)
    size_t: k 0U
    size_t: frames 0U
    @: field void 0
    @@: link void 0
    int: kind 0
    int: block 0
    if: lmx_graph_dump_statement_word(lmx_graph_name_of(g, (cast: (@: void) inner))) != 0
        return: 0
    while: k < m
        field := lmx_graph_get_in(g, inner, k)
        kind := lmx_graph_kind(g, field)
        if: kind = 3 || kind = 5 || kind = 6 || kind = 8 || kind = 9 || (kind = 1 && lmx_graph_name_of(g, field) != 0)
            return: 1
        if: kind = 4 && lmx_graph_name_of(g, field) != 0
            if: lmx_graph_dump_statement_word(lmx_graph_name_of(g, field)) != 0
                return: 1
            frames := frames + 1U
            if: frames >= 2U
                return: 1
            if: lmx_graph_dump_on_path(path, field) = 0
                link := lmx_graph_dump_enter(path, field)
                if: link = 0
                    return: -1
                block := lmx_graph_dump_block(g, (cast: (@: c.Lmx) field), link)
                c.free((cast: (@: void) link))
                if: block != 0
                    return: block
                ---
            ---
        ---
        k := k + 1U
    ---
    return: 0
end: lmx_graph_dump_block

# Borrow the parts of a formed application without allocating or flattening
# its actuals. Named Frames retain their existing representation.
fn: lmx_graph_application_parts (@: g c.LmxGraph; @: value void; @@: head_name char; @@: head_expr void; @@: args c.Lmx) int
    @: state c.LmxGraphState lmx_graph_state()
    @: statement c.Lmx 0
    @: name char 0
    @: actuals void 0
    if: head_name != 0
        head_name[0] := 0
    if: head_expr != 0
        head_expr[0] := 0
    if: args != 0
        args[0] := 0
    if: state = 0 || lmx_graph_kind(g, value) != 4 || lmx_graph_fn_result(g, value) != 0
        return: 0
    statement := (cast: (@: c.Lmx) value)
    name := lmx_graph_name_of(g, value)
    if: name != 0
        if: head_name != 0
            head_name[0] := name
        if: args != 0
            args[0] := statement
        return: 1
    if: lmx_graph_count(statement) != 3U || lmx_graph_word_text(g, lmx_graph_get_in(g, statement, 1U)) != state\w_apply
        return: 0
    actuals := lmx_graph_get_in(g, statement, 2U)
    if: lmx_graph_kind(g, actuals) != 4
        return: 0
    if: head_expr != 0
        head_expr[0] := lmx_graph_get_in(g, statement, 0U)
    if: args != 0
        args[0] := (cast: (@: c.Lmx) actuals)
    return: 1
end: lmx_graph_application_parts

# A selector head keeps its visible path/index spelling. Other expression
# heads use the ordinary token printer.
fn: lmx_graph_dump_head (@: g c.LmxGraph; @: value void; @: f c.FILE; @@: path void) int
    @: state c.LmxGraphState lmx_graph_state()
    @: text char lmx_graph_word_text(g, value)
    @: op char 0
    @: step void 0
    @: link c.Lmx (cast: (@: c.Lmx) value)
    if: text != 0
        return: lmx_graph_dump_selector_name(text, f)
    if: state != 0 && lmx_graph_kind(g, value) = 4 && lmx_graph_count(link) = 3U
        op := lmx_graph_word_text(g, lmx_graph_get_in(g, link, 1U))
        step := lmx_graph_get_in(g, link, 2U)
        if: op = state\w_index || op = state\w_deref
            if: lmx_graph_dump_head(g, lmx_graph_get_in(g, link, 0U), f, path) != 0
                return: 1
            if: op = state\w_deref
                c.fputs("\\", f)
                return: lmx_graph_dump_selector(g, step, f, path)
            c.fputs("[", f)
            if: lmx_graph_dump_token(g, lmx_graph_get_in(g, link, 2U), f, path) != 0
                return: 1
            c.fputs("]", f)
            return: 0
        ---
    ---
    return: lmx_graph_dump_token(g, value, f, path)
end: lmx_graph_dump_head

# -1 for another value; otherwise print explicit application, including empty
# actuals, without consuming any outer written-group wrapper.
fn: lmx_graph_dump_application (@: g c.LmxGraph; @: value c.Lmx; @: f c.FILE; @@: path void) int
    @: name char 0
    @: head void 0
    @: args c.Lmx 0
    size_t: i 0U
    if: lmx_graph_application_parts(g, (cast: (@: void) value), @ name, @ head, @ args) = 0 || name != 0
        return: -1
    if: lmx_graph_dump_head(g, head, f, path) != 0
        return: 1
    c.fputs("(", f)
    while: i < lmx_graph_count(args)
        if: i != 0U
            c.fputs("; ", f)
        if: lmx_graph_dump_token(g, lmx_graph_get_in(g, args, i), f, path) != 0
            return: 1
        i := i + 1U
    c.fputs(")", f)
    return: 0
end: lmx_graph_dump_application

# The fields of lmx, one per line at depth: an int place as `int: name value`, a place without a value as `int: name`,
# a reference place as `@: name ...`, a word as itself, a declaration Frame of fn or sub in its written form, another
# Frame as `head: arguments` -- or as its block `head:` ... `end: head` (lmx_graph_dump_block) --, an unnamed Lmx whose
# first field is a word (an operator form such as `:=`) as `word: fields`, an expression-head application
# with its explicit argument parentheses, and an anonymous sequential body between --- delimiters
# (lmx_graph_dump_frame); a Frame or a Structure met again on the path of the print (path, with lmx on it) by its name
# alone. 0, or 1 when a cell is none of the graph's or without memory.
fn: lmx_graph_dump_at (@: g c.LmxGraph; @: lmx c.Lmx; @: f c.FILE; int: depth; @@: path void) int
    size_t: n lmx_graph_count(lmx)
    size_t: i 0U
    @: value void 0
    @: name char 0
    @: head char 0
    @@: link void 0
    int: kind 0
    int: status 0
    while: i < n
        value := lmx_graph_get_in(g, lmx, i)
        # An empty slot is no field: nothing is printed for it.
        if: value = 0
            i := i + 1U
            continue
        kind := lmx_graph_kind(g, value)
        lmx_graph_dump_indent(f, depth)
        if: kind = 4
            if: lmx_graph_dump_on_path(path, value) != 0
                lmx_graph_dump_again(g, value, f)
                c.fputs("\n", f)
            else:
                link := lmx_graph_dump_enter(path, value)
                if: link = 0
                    return: 1
                status := lmx_graph_dump_frame(g, (cast: (@: c.Lmx) value), f, depth, link)
                c.free((cast: (@: void) link))
                if: status != 0
                    return: 1
            ---
            i := i + 1U
            continue
        ---
        if: kind = 8 || kind = 9
            name := lmx_graph_name_of(g, c.lmx_arena_pointer_void_read(value))
            if: name = 0
                return: 1
            if: kind = 8
                c.fprintf(f, "@: %s int\n", name)
            if: kind = 9
                c.fprintf(f, "@: %s\n", name)
            i := i + 1U
            continue
        if: kind = 5
            name := lmx_graph_name_of(g, value)
            head := lmx_graph_name_of(g, c.lmx_arena_pointer_void_read(value))
            if: name = 0 || head = 0
                return: 1
            c.fprintf(f, "@: %s int @%s\n", name, head)
            i := i + 1U
            continue
        # A reference to a Structure or a callable: `@: name target`, the target by its own name (the book :441). A
        # reference to an unnamed Structure (the part args or code of a merge copy) has no name to print: it prints as
        # the block of that Structure under the reference's name, the text a prepared Structure has (`args:` ...).
        if: kind = 6
            name := lmx_graph_name_of(g, value)
            if: name != 0 && c.lmx_arena_pointer_void_read(value) = 0
                c.fprintf(f, "@: %s 0\n", name)
                i := i + 1U
                continue
            head := lmx_graph_name_of(g, lmx_graph_target(g, value))
            if: name = 0
                return: 1
            if: head = 0
                if: lmx_graph_kind(g, lmx_graph_target(g, value)) != 4 || depth > 64 || lmx_graph_dump_on_path(path, lmx_graph_target(g, value)) != 0
                    return: 1
                c.fprintf(f, "%s:\n", name)
                if: lmx_graph_dump_child(g, (cast: (@: c.Lmx) lmx_graph_target(g, value)), f, depth + 1, path) != 0
                    return: 1
                lmx_graph_dump_indent(f, depth)
                c.fprintf(f, "end: %s\n", name)
                i := i + 1U
                continue
            ---
            c.fprintf(f, "@: %s %s\n", name, head)
            i := i + 1U
            continue
        if: kind = 1
            name := lmx_graph_name_of(g, value)
            if: name != 0
                c.fprintf(f, "int: %s %d\n", name, c.lmx_int_value_known(value))
            else:
                c.fprintf(f, "int: %d\n", c.lmx_int_value_known(value))
            ---
        else:
            if: kind = 3
                name := lmx_graph_name_of(g, c.lmx_arena_pointer_void_read(value))
                if: name = 0
                    return: 1
                c.fprintf(f, "int: %s\n", name)
            else:
                # A word; a named word place (the part return of a merge copy) as `name: word`.
                if: kind != 2
                    return: 1
                name := lmx_graph_name_of(g, value)
                if: name != 0
                    c.fprintf(f, "%s: %s\n", name, lmx_graph_word_text(g, value))
                else:
                    c.fprintf(f, "%s\n", lmx_graph_word_text(g, value))
                ---
            ---
        ---
        i := i + 1U
    ---
    return: 0
end: lmx_graph_dump_at

# The fields of lmx printed at depth with lmx put on the path of the print (lmx_graph_dump_at). 0, or 1 when a cell is
# none of the graph's or without memory.
fn: lmx_graph_dump_child (@: g c.LmxGraph; @: lmx c.Lmx; @: f c.FILE; int: depth; @@: path void) int
    @@: link void lmx_graph_dump_enter(path, (cast: (@: void) lmx))
    int: status 1
    if: link != 0
        status := lmx_graph_dump_at(g, lmx, f, depth, link)
        c.free((cast: (@: void) link))
    ---
    return: status
end: lmx_graph_dump_child

# One Frame or Structure inner at depth, on the path of the print (path, with inner on it): a declaration of fn or sub
# in its written form (lmx_graph_dump_declaration), a named Frame as `head: arguments` or as its block `head:` ...
# `end: head` (lmx_graph_dump_block), a statement on a path head as `owner\field: actuals`, an anonymous body between
# --- delimiters, an operator form as `word: fields`. 0, or 1 when a cell is none of the graph's or without memory.
fn: lmx_graph_dump_frame (@: g c.LmxGraph; @: inner c.Lmx; @: f c.FILE; int: depth; @@: path void) int
    @: value void (cast: (@: void) inner)
    @: name char lmx_graph_name_of(g, value)
    @: head char 0
    int: printed lmx_graph_dump_declaration(g, value, f, depth, path)
    int: block 0
    if: printed < 0
        return: 1
    if: printed > 0
        return: 0
    if: name != 0
        block := lmx_graph_dump_block(g, inner, path)
        if: block < 0
            return: 1
        if: block != 0
            c.fprintf(f, "%s:\n", name)
            if: lmx_graph_dump_at(g, inner, f, depth + 1, path) != 0
                return: 1
            lmx_graph_dump_indent(f, depth)
            c.fprintf(f, "end: %s\n", name)
            return: 0
        ---
        c.fprintf(f, "%s:", name)
        if: lmx_graph_dump_fields(g, inner, 0U, f, path) != 0
            return: 1
        c.fputs("\n", f)
        return: 0
    ---
    if: lmx_graph_count(inner) != 0U
        head := lmx_graph_word_text(g, lmx_graph_get_in(g, inner, 0U))
    printed := lmx_graph_dump_application(g, inner, f, path)
    if: printed >= 0
        c.fputs("\n", f)
        return: printed
    if: head = 0
        c.fputs("---\n", f)
        if: lmx_graph_dump_at(g, inner, f, depth + 1, path) != 0
            return: 1
        lmx_graph_dump_indent(f, depth)
        c.fputs("---\n", f)
        return: 0
    c.fprintf(f, "%s:", head)
    if: lmx_graph_dump_fields(g, inner, 1U, f, path) != 0
        return: 1
    c.fputs("\n", f)
    return: 0
end: lmx_graph_dump_frame

# The toLmx-like text of the fields of lmx (a root) to f. 0, or 1 when a cell is none of the graph's.
fn: lmx_graph_dump (@: g c.LmxGraph; @: lmx c.Lmx; @: f c.FILE) int
    if: g = 0 || lmx = 0 || f = 0
        return: 1
    return: lmx_graph_dump_child(g, lmx, f, 0, 0)
end: lmx_graph_dump

# The same text between the lines `GRAPH-<mark>-BEGIN` and `GRAPH-<mark>-END`: what a check reads from a run's log.
fn: lmx_graph_dump_marked (@: g c.LmxGraph; @: lmx c.Lmx; @: f c.FILE; const: (@: mark char)) int
    int: r 0
    if: f = 0 || mark = 0
        return: 1
    c.fprintf(f, "GRAPH-%s-BEGIN\n", mark)
    r := lmx_graph_dump(g, lmx, f)
    c.fprintf(f, "GRAPH-%s-END\n", mark)
    c.fflush(f)
    return: r
end: lmx_graph_dump_marked

# ---- Copy primitive of merge (kernel §6.4) -----------------------------------------------------------------------

# The pointer primitive of a place without a value pointing at an existing int cell: the copy of such a place is its
# copied cell and a new pointer of the same type to it (§6.4: the form is kept, not replaced by a direct cell). Taking
# the cell's address reads none of its bytes. 0 without memory or when cell is no int primitive of this arena.
fn: lmx_graph_uninit_int_at (@: g c.LmxGraph; @: cell void) @: void
    @: pointer void 0
    if: g = 0 || lmx_graph_kind(g, cell) != 1
        return: 0
    pointer := c.lmx_arena_pointer_cells_profiled(g\arena, c.LMX_TYPE_UNINIT_INT, 0, sizeof(@: void), c.lmx_arena_pointer_void_read, c.lmx_arena_pointer_void_write, 1U)
    if: pointer = 0 || c.lmx_arena_pointer_void_write(pointer, cell) != 0
        return: 0
    return: pointer
end: lmx_graph_uninit_int_at

# ---- Interface descriptor ------------------------------------------------------------------------------------------

# The interface descriptor (the book :691): the Structure that fn creates from `fn: name args return` without a body --
# its args and return parts and the addressable empty data the fn contract creates for an omitted data. No body is
# synthesized, so it is no callable (lmx_graph_method). 1 or 0.
fn: lmx_graph_descriptor (@: g c.LmxGraph; @: code c.Lmx) int
    @: state c.LmxGraphState lmx_graph_state()
    if: state = 0 || lmx_graph_fn_result(g, (cast: (@: void) code)) = 0
        return: 0
    return: (cast: (int) (lmx_graph_part(g, (cast: (@: void) code), (cast: (@: char) state\w_code)) = 0 && lmx_graph_part(g, (cast: (@: void) code), (cast: (@: char) state\w_return)) != 0))
end: lmx_graph_descriptor

# The copy of a word primitive (kernel §6.4): a new cell of the WORD pool holding the same canonical address -- no search
# of bytes, the spelling is already interned. 0 without memory.
fn: lmx_graph_word_of (@: g c.LmxGraph; @: canon char) @: void
    @: cell void 0
    @@: wc char 0
    if: g = 0 || canon = 0
        return: 0
    cell := c.lmx_arena_take(g\arena, sizeof(@: void), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_WORD)
    if: cell = 0
        return: 0
    wc := (cast: (@@: char) cell)
    \wc := canon
    return: cell
end: lmx_graph_word_of

# A reference to an Lmx -- a Structure or a callable (the book :441, :454, :1237): a pointer primitive of the
# LMX_TYPE_GRAPH_LMX_REF pool holding the target's address. A new named place for a Structure that already has a name is
# such a reference; the reference has its own address and name, the target keeps its own. 0 for a target that is no Lmx
# or without memory.
fn: lmx_graph_ref_lmx (@: g c.LmxGraph; @: target c.Lmx) @: void
    @: pointer void 0
    if: g = 0 || lmx_graph_kind(g, (cast: (@: void) target)) != 4
        return: 0
    pointer := c.lmx_arena_pointer_cells_profiled(g\arena, c.LMX_TYPE_GRAPH_LMX_REF, 0, sizeof(@: void), c.lmx_arena_pointer_void_read, c.lmx_arena_pointer_void_write, 1U)
    if: pointer = 0 || c.lmx_arena_pointer_void_write(pointer, (cast: (@: void) target)) != 0
        return: 0
    return: pointer
end: lmx_graph_ref_lmx

# What a value stands for where a Structure is consumed -- a call head, a path step, a merge operand, a whole argument
# structure, the base of an index: the target of a reference to an Lmx; any other value is itself. The address of the
# reference stays the value of its place (`@name` is the address of the stored reference, the book :1237). An untyped
# reference (the index of a Structure) stands for the Lmx its slot holds, directly or through the reference place of
# that slot.
fn: lmx_graph_target (@: g c.LmxGraph; @: value void) @: void
    @: held void 0
    int: kind lmx_graph_kind(g, value)
    if: kind = 8 || kind = 9
        value := lmx_graph_reference_cell(g, value)
        kind := lmx_graph_kind(g, value)
    if: kind = 6
        return: c.lmx_arena_pointer_void_read(value)
    if: kind = 7
        held := c.lmx_arena_pointer_void_read(value)
        if: lmx_graph_kind(g, held) = 8 || lmx_graph_kind(g, held) = 9
            held := lmx_graph_reference_cell(g, held)
        if: lmx_graph_kind(g, held) = 6
            held := c.lmx_arena_pointer_void_read(held)
        if: lmx_graph_kind(g, held) = 4
            return: held
        ---
    return: value
end: lmx_graph_target

# Is word (a canonical spelling, §4) a word of the language -- a receiver, a declaration word, a type word of the C door?
# Its Frame is a statement of the language, never a named Structure: one the consumers do not execute (table, external,
# receive) fails there explicitly instead of standing as inert data. The words were interned with the state
# (lmx_graph_receivers_in); the canonical addresses are compared, as for every other word of the language (§6.2). 1 or 0.
fn: lmx_graph_language_receiver (@: word char) int
    @: state c.LmxGraphState lmx_graph_state()
    size_t: i 0U
    size_t: first 0U
    const: (@: cells char c.lmx_primitive_profile_cells)
    if: state = 0 || word = 0
        return: 0
    first := state\receivers_count - c.lmx_primitive_profile_count
    while: i < state\receivers_count
        if: state\receivers[i] = word && (i < first || cells[i - first] != 0)
            return: 1
        i := i + 1U
    ---
    return: 0
end: lmx_graph_language_receiver

# The code of a file (the book #scope, docs/LMX_semantics :65: «Код L2 пишется под ресивером `L2:`; его запись лежит в графе
# как записана, и по ней транслятор и интерпретатор узнают уровень кода. Файл `.lm2` сам по себе как обёрнут в этот
# ресивер»): a Structure whose only field is the record `L2` -- an .lm2 file, which the builder wraps, or a file written
# under an explicit `L2:` -- runs as the content of that record, and of a record nested alone in it; any other Structure
# is its own code.  The executors pass through the record (plan #one-graph-plan, L1); the record's native is step L2.
fn: lmx_graph_file_code (@: g c.LmxGraph; @: file c.Lmx) @: c.Lmx
    @: state c.LmxGraphState lmx_graph_state()
    @: code c.Lmx file
    @: inner void 0
    while: g != 0 && state != 0 && code != 0 && lmx_graph_count(code) = 1U
        inner := lmx_graph_get_in(g, code, 0U)
        if: lmx_graph_kind(g, inner) != 4 || lmx_graph_name_of(g, inner) != state\w_l2
            return: code
        code := (cast: (@: c.Lmx) inner)
    return: code

# The address a value stands for (§2.1): a Structure is the address of its own header; a reference -- to an int cell, to
# an Lmx, an untyped one -- stands for the address it holds; any other value -- an int, a word -- is no address. 0 and
# the address in out; 5 for a value that is no address.
fn: lmx_graph_address_of (@: g c.LmxGraph; @: value void; @@: out void) int
    @: pool c.LmxPool 0
    int: kind lmx_graph_kind(g, value)
    if: g = 0 || out = 0
        return: 5
    if: kind = 8 || kind = 9
        value := lmx_graph_reference_cell(g, value)
        kind := lmx_graph_kind(g, value)
    if: c.lmx_graph_node_in((cast: (@: c.LmxArena) g\arena), value) != 0
        out[0] := value
        return: 0
    pool := c.lmx_pointer_pool_in((cast: (@: c.LmxArena) g\arena), value)
    # UNINIT_INT is a service pointer for an int place, not a pointer value.
    if: pool != 0 && c.lmx_type_base((cast: (int) pool\type)) != c.LMX_TYPE_UNINIT_INT
        out[0] := (cast: (@: void) pool\pointer_read(value))
        return: 0
return: 5

# The type of the region of the arena that holds the address a value stands for (§2.1; the book, get-type; the
# receiver typeof of both executors; lmx_graph_address_of). 0 and the type in out, LMX_TYPE_NONE for an address no
# region of this arena holds (a null reference); 5 for a value that is no address.
fn: lmx_graph_address_type (@: g c.LmxGraph; @: value void; @: out int) int
    @: address void 0
    if: out = 0 || lmx_graph_address_of(g, value, @ address) != 0
        return: 5
    out[0] := c.lmx_range_type_of(g\arena, address)
    return: 0
end: lmx_graph_address_type

# ---- The index of a Structure (the book, structure-index; the author 2026-11-10) -----------------------------------
# A Structure is addressed as an array of untyped references: `S[i]` reads what slot i holds -- an immediate field in
# the written order, from zero --, `S[i] := p` gives the slot another address, `length(S)` is the number of the slots.
# One kernel operation each, called by the interpreter and by the code the translator emits.

# An untyped reference: a pointer primitive of the LMX_TYPE_GRAPH_REF pool holding an address of the arena (or none).
# It is the value of an evaluation, never a field of the graph: a place takes it by its own requirement
# (lmx_graph_int_ref_of), a slot takes the address it holds (lmx_graph_index_write). 0 without memory.
fn: lmx_graph_ref (@: g c.LmxGraph; @: address void) @: void
    @: pointer void 0
    if: g = 0
        return: 0
    pointer := c.lmx_arena_pointer_cells_profiled(g\arena, c.LMX_TYPE_GRAPH_REF, 0, sizeof(@: void), c.lmx_arena_pointer_void_read, c.lmx_arena_pointer_void_write, 1U)
    if: pointer = 0 || c.lmx_arena_pointer_void_write(pointer, address) != 0
        return: 0
    return: pointer
end: lmx_graph_ref

# Is left the index the builder makes of an attached `base[index]`: the unnamed expression [base, [], index]? 1 or 0.
fn: lmx_graph_index_form (@: g c.LmxGraph; @: left void) int
    @: state c.LmxGraphState lmx_graph_state()
    @: expression c.Lmx (cast: (@: c.Lmx) left)
    if: state = 0 || lmx_graph_kind(g, left) != 4 || lmx_graph_name_of(g, left) != 0 || lmx_graph_count(expression) != 3U
        return: 0
    return: (cast: (int) (lmx_graph_word_text(g, lmx_graph_get_in(g, expression, 1U)) = state\w_index))
end: lmx_graph_index_form

fn: lmx_graph_index_node (@: g c.LmxGraph; @: value void) @: c.Lmx
    @: current c.Lmx 0
    @: address void 0
    if: g = 0
        return: 0
    current := c.lmx_graph_node_in((cast: (@: c.LmxArena) g\arena), lmx_graph_target(g, value))
    if: current != 0
        return: current
    if: lmx_graph_address_of(g, value, @ address) != 0
        return: 0
return: c.lmx_graph_node_in((cast: (@: c.LmxArena) g\arena), address)

# `S[i]`: an untyped reference to what slot index of the Structure value stands for holds -- the cell of an int field,
# the pointer of a field without a value, a nested Structure, a word, a reference place. 0 and the reference in out; 4
# for a value that stands for no Structure, or without memory; 7 for an index outside its fields.
fn: lmx_graph_index (@: g c.LmxGraph; @: value void; int: index; @@: out void) int
    @: inner c.Lmx lmx_graph_index_node(g, value)
    @: cell void 0
    c.LmxPointerCellRead: read 0
    c.LmxPointerCellWrite: write 0
    int: status 0
    if: out = 0 || inner = 0
        return: 4
    # The access to the element is checked against the current length (lmx_check_index).
    status := c.lmx_check_index(inner, index)
    if: status != 0
        return: status
    cell := c.lmx_graph_cell_in((cast: (@: c.LmxArena) g\arena), inner, (cast: (size_t) index))
    if: cell = 0 || c.lmx_value_cell_access((cast: (@: c.LmxArena) g\arena), cell, @ read, @ write) != 0 || read = 0
        return: 4
    out[0] := lmx_graph_ref(g, read(cell))
    if: out[0] = 0
        return: 4
    return: 0
end: lmx_graph_index

# Store one pointer in the actual reference slot. Its former value imposes
# no receiving requirement; interpretation reads the resulting current graph.
fn: lmx_graph_index_write (@: g c.LmxGraph; @: scope c.Lmx; @: value void; int: index; @: source void) int
    @: inner c.Lmx lmx_graph_index_node(g, value)
    @: address void 0
    int: status 0
    if: inner = 0
        return: 4
    # The write into the array is checked against the current length (lmx_check_index); the former content imposes nothing.
    status := c.lmx_check_index(inner, index)
    if: status != 0
        return: status
    if: lmx_graph_address_of(g, source, @ address) != 0
        return: 4
    if: lmx_graph_write_slot(g, scope, inner, (cast: (size_t) index), address) != 0
        return: 4
    return: 0
end: lmx_graph_index_write

# `length(S)`: the number of the fields of the Structure value stands for. 0 and the number in out; 4 for a value that
# stands for no Structure.
fn: lmx_graph_length (@: g c.LmxGraph; @: value void; @: out int) int
    @: base void lmx_graph_target(g, value)
    if: out = 0 || lmx_graph_kind(g, base) != 4
        return: 4
    out[0] := (cast: (int) lmx_graph_count((cast: (@: c.Lmx) base)))
    return: 0
end: lmx_graph_length

# The value a reference place of an int takes (`@: p int value`): its own int-reference cell; an untyped reference whose
# address is an int cell -- or the pointer of a place without a value, whose cell it stands for -- as a new int
# reference to that cell (the admission by the region of the address, §2.2). 0 for any other value, or without memory.
fn: lmx_graph_int_ref_of (@: g c.LmxGraph; @: value void) @: void
    @: held void 0
    int: kind lmx_graph_kind(g, value)
    if: kind = 8
        value := lmx_graph_reference_cell(g, value)
        kind := lmx_graph_kind(g, value)
    if: kind = 5
        return: lmx_graph_ref_int(g, c.lmx_arena_pointer_void_read(value))
    if: kind != 7
        return: 0
    held := c.lmx_arena_pointer_void_read(value)
    if: lmx_graph_kind(g, held) = 3
        held := c.lmx_arena_pointer_void_read(held)
    return: lmx_graph_ref_int(g, held)
end: lmx_graph_int_ref_of

# The value a reference place of a Structure or a callable takes (`@: name value`, the book, receiver-args-only): a new
# reference to the Lmx the value stands for (lmx_graph_target) -- a Structure or a callable itself, the target of a
# reference to one, the Lmx a slot read by an index holds. The place has its own address and name; the target keeps its
# own. 0 for a value that stands for no Lmx, or without memory.
fn: lmx_graph_lmx_ref_of (@: g c.LmxGraph; @: value void) @: void
    @: target void lmx_graph_target(g, value)
    if: lmx_graph_kind(g, target) != 4
        return: 0
    return: lmx_graph_ref_lmx(g, (cast: (@: c.Lmx) target))
end: lmx_graph_lmx_ref_of
