# A binding of the site hides the root's held callable of its name; where
# there is none the name is the held callable. h2 is held by the root. In
# formal a formal of a number type named h2 is stored to and read as that
# number. In local a local of that name is stored to and read. In call, with
# no binding of its own, the method calls the held callable, as the root
# does. Entry 7.
fn: make2 (int: n) fn: (int: x; int: y) int
    fn: f2 (int: x; int: y) int
        return: n + x * 10 + y
    return: f2

h2: make2 100

fn: formal (int: h2) int
    h2: h2 + 1
    return: h2
end: formal

fn: local () int
    int: h2 5
    h2: h2 + 2
    return: h2
end: local

fn: call () int
    return: h2(1 2)
end: call

int: r1 formal(6)
int: r2 local()
int: r3 call()
int: r4 h2(2 1)
int: ok 7
if: r1 != 7
    ok: 81
if: r2 != 7
    ok: 82
if: r3 != 112
    ok: 83
if: r4 != 121
    ok: 84
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
