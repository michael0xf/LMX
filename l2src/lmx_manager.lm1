predef: "l2src/lmx_manager.h.lm1"
predef: "l2src/lmx_implements.h.lm1"
predef: "l2src/lmx_turn.lm1"

# The stepped scheduler traverses its owner's sole graph Array. `cursor` is only transient order;
# it is never another statement of membership.

fn: lmx_manager_init (@: LmxManager m) int
    if: m = 0
        return: c.LMX_MANAGER_INVALID
    m\owner: 0
    m\cursor: 0U
    m\api.init: lmx_manager_init
    m\api.add: lmx_manager_add
    m\api.remove: lmx_manager_remove
    m\api.take: lmx_manager_take
    m\api.count: lmx_manager_count
    m\api.step: lmx_manager_step
    m\api.round: lmx_manager_round
return: c.LMX_MANAGER_OK

fn: lmx_manager_bind (@: LmxManager m; @: LmxThread owner) int
    if: m = 0 || owner = 0
        return: c.LMX_MANAGER_INVALID
    if: m\owner != 0 && m\owner != owner
        return: c.LMX_MANAGER_INVALID
    m\owner: owner
    if: m\cursor > lmx_thread_child_count(owner)
        m\cursor: 0U
    ---
return: c.LMX_MANAGER_OK

fn: lmx_manager_api (@: LmxManager m) @: LmxManagerApi
    if: m = 0
        return: 0
return: @ m\api

# Compatibility admission validates that the schedule belongs to an element already present in
# the owner's Array. It never enqueues or duplicates that membership.
fn: lmx_manager_add (@: LmxManager m; @: LmxSchedule slot) int
    @: LmxThread child
    @: LmxThread parent
    if: m = 0 || slot = 0 || slot\owner = 0
        return: c.LMX_MANAGER_INVALID
    child: (cast: (@: LmxThread) slot\owner)
    if: lmx_domain_type(slot\arena, slot\owner) != c.LMX_DOMAIN_THREAD
        return: c.LMX_MANAGER_INVALID
    parent: lmx_thread_parent(child)
    if: parent = 0
        return: c.LMX_MANAGER_INVALID
    if: lmx_manager_bind(m, parent) != c.LMX_MANAGER_OK
        return: c.LMX_MANAGER_INVALID
    if: lmx_thread_child_is(parent, child) = 0
        return: c.LMX_MANAGER_INVALID
return: c.LMX_MANAGER_OK

fn: lmx_manager_remove (@: LmxManager m; @: LmxSchedule slot) int
    @: LmxThread child
    if: m = 0 || m\owner = 0 || slot = 0 || slot\owner = 0
        return: c.LMX_MANAGER_INVALID
    child: (cast: (@: LmxThread) slot\owner)
    if: lmx_thread_parent(child) != m\owner || lmx_thread_child_is(m\owner, child) = 0
        return: c.LMX_MANAGER_INVALID
    # Membership removal belongs to lmx_thread_child_remove at the serialized parent boundary.
return: c.LMX_MANAGER_OK

fn: lmx_manager_take (@: LmxManager m) @: LmxSchedule
    @: LmxThread child
    size_t: count
    if: m = 0 || m\owner = 0
        return: 0
    count: lmx_thread_child_count(m\owner)
    if: count = 0U
        m\cursor: 0U
        return: 0
    if: m\cursor >= count
        m\cursor: 0U
    child: lmx_thread_child_at(m\owner, m\cursor)
    m\cursor: m\cursor + 1U
    if: child = 0
        return: 0
return: child\slot

fn: lmx_manager_count (@: LmxManager m) size_t
    if: m = 0 || m\owner = 0
        return: 0U
return: lmx_thread_child_count(m\owner)

fn: lmx_manager_step (@: LmxManager m; ulong: now) int
    @: LmxSchedule slot
    @: LmxThread t
    if: m = 0
        return: c.LMX_MANAGER_INVALID
    slot: lmx_manager_take(m)
    if: slot = 0
        return: c.LMX_MANAGER_EMPTY
    t: (cast: (@: LmxThread) slot\owner)
    if: t = 0
        return: c.LMX_MANAGER_INVALID
    lmx_thread_turn(t, 0, now)
    lmx_schedule_tick(slot, now)
    if: lmx_thread_running(t) = 0
        lmx_thread_finish(t)
    ---
return: c.LMX_MANAGER_OK

fn: lmx_manager_round (@: LmxManager m; unsigned: ticks; ulong: now) int
    unsigned: i
    int: code
    if: m = 0 || ticks = 0U
        return: c.LMX_MANAGER_INVALID
    i: 0U
    while: i < ticks
        code: lmx_manager_step(m, now)
        if: code = c.LMX_MANAGER_EMPTY
            return: c.LMX_MANAGER_OK
        if: code != c.LMX_MANAGER_OK
            return: code
        i: i + 1U
    ---
return: c.LMX_MANAGER_OK
