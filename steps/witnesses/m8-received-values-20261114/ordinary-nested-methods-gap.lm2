# OPEN M11: ordinary State must prepare its written methods in its namespace.
@: State (
    int: k 5
    int: out 0
    @: held ()
    int: calls 0
    fn: change () int
        node\k := 8
        node\calls := node\calls + 1
        return: 1
    fn: leaf () int
        return: k
    fn: number () int (int: prepared change())
        node\out := (k)
        return: node\out
    fn: literal () int (int: prepared change())
        node\held := (k)
        return: leaf()
)
call(State)
@: Number State\number
@: Literal State\literal
int: numeric Number()
State\k := 5
int: structural Literal()
int: held_n length(State\held)
int: outside State\k
int: changes State\calls
