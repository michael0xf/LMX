# Slice 289 (INDEX-NUMERIC-RECEPTION): an int index of the L3 INDEX of a machine pointer an own field or a formal holds is
# received into size_t by the ordinary numeric reception -- the program's receiver of that conversion
# (lm_stg_convert_int_size_t, a row of l2src/convert.lm2) is called, in native and walked code alike: a read, a write, an
# address, through the root's own pointer, a formal and a method's own pointer. A negative int is refused by the receiver
# (`range`), which its caller sees as the implicit `convert`: no place is selected and the value of a write is not
# evaluated (seen[0U] counts value()), so nothing is written. An int past the interval is received and then is the
# implicit `interpreter`. Under a false guard the index is not received at all. The first failure stays.
fn: lm_stg_convert_int_size_t (int: n) size_t
    throws: range
    if: n < 0
        throw: range
    return: (cast: (size_t) n)
end: lm_stg_convert_int_size_t
[]: int cells 3
cells[0U] := 5
cells[1U] := 17
cells[2U] := 7
[]: int seen 1
seen[0U] := 0
@: pc int @ cells[0U]
@: ps int @ seen[0U]
fn: touch () int
    return: 0
end: touch
fn: value (@: k int) int
    k[0U] := k[0U] + 1
    return: 40
end: value
fn: get (@: p int; int: at) int
    return: p[at]
end: get
sub: put (@: p int; int: at; int: v)
    p[at] := v
end: put
fn: own_get (int: at) int
    []: int slots 2
    slots[1U] := 9
    @: q int @ slots[0U]
    return: q[at]
end: own_get
fn: address_of (@: p int; int: at) int
    @: pz int @ p[at]
    return: \pz
end: address_of
int: code 7
int: t touch()
int: one 1
int: two 2
int: neg 0 - 1
int: far 2147483647
int: guard 0
if: pc[one] != 17
    code := 11
pc[two] := value(ps)
if: code = 7 && cells[2U] != 40
    code := 12
if: code = 7 && seen[0U] != 1
    code := 12
if: code = 7 && get(pc, one) != 17
    code := 13
put(pc, one, 23)
if: code = 7 && cells[1U] != 23
    code := 14
if: code = 7 && own_get(one) != 9
    code := 15
if: code = 7 && address_of(pc, two) != 40
    code := 16
int: caught 0
---
    caught := pc[neg]
    catch: convert ()
        caught := 90
---
if: code = 7 && caught != 90
    code := 17
caught := 0
---
    pc[neg] := value(ps)
    catch: convert ()
        caught := 90
---
if: code = 7 && caught != 90
    code := 18
if: code = 7 && seen[0U] != 1
    code := 18
caught := 0
---
    caught := get(pc, neg)
    catch: convert ()
        caught := 90
---
if: code = 7 && caught != 90
    code := 19
caught := 0
---
    put(pc, neg, 1)
    catch: convert ()
        caught := 90
---
if: code = 7 && caught != 90
    code := 20
caught := 0
---
    caught := address_of(pc, neg)
    catch: convert ()
        caught := 90
---
if: code = 7 && caught != 90
    code := 21
caught := 0
---
    caught := pc[far]
    catch: interpreter ()
        caught := 90
---
if: code = 7 && caught != 90
    code := 22
caught := 0
---
    pc[far] := value(ps)
    catch: interpreter ()
        caught := 90
---
if: code = 7 && caught != 90
    code := 23
if: code = 7 && seen[0U] != 1
    code := 23
if: guard != 0 && pc[neg] = 5
    code := 24
if: code = 7 && cells[0U] != 5
    code := 25
if: code = 7 && cells[1U] != 23
    code := 25
if: code = 7 && cells[2U] != 40
    code := 25
send: exit(exit_code: code; stdout: ""; stderr: "")
return
