# A local of a number type is stored to, though a method of the unit has its
# name: the value of `p: "text"` is checked as any store's.
fn: p (int: a) int
    return: a
end: p

fn: local (int: x) int
    int: p 1
    p: "text"
    return: p
end: local

sendMessage: exit(exit_code: local(7); stdout: ""; stderr: "")
return
