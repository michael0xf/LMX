fn: lm_compiler_snap_read_ready (@: in c.FILE; @: len size_t; c.long: size) @: char
    @: data char
    size_t: got
    if: size < (cast: (c.long) 0) || c.fseek(in, (cast: (c.long) 0), c.SEEK_SET) != 0
        c.fclose(in)
        return: (cast: (@: char) (0))
    data: (cast: (@: char) c.lm_compiler_xmalloc((cast: (size_t) size) + 1U))
    if: data = 0
        c.fclose(in)
        return: (cast: (@: char) (0))
    got: c.fread(data, 1U, (cast: (size_t) size), in)
    c.fclose(in)
    if: got != (cast: (size_t) size)
        c.lm_compiler_xfree((cast: (@: void) data))
        return: (cast: (@: char) (0))
    data[got]: 0
    \len: got
    return: (cast: (@: char) (data))
end: lm_compiler_snap_read_ready

fn: lm_compiler_snap_read (const: (@: path char); @: len size_t) @: char
    @: in c.FILE
