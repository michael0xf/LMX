# A candidate-free declaration carries a formal by the declared name,
# independent of whether that name is inside or outside the type receiver.
fn: keep (int: n) int
    n: int()
    n: n + 1
return: n
int: result 81
if: keep(6) = 7
    result: 7
sendMessage: exit(exit_code: result; stdout: ""; stderr: "")
return
