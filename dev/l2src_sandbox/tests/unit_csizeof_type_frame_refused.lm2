# FABLE-OPUS-GATE-TRANSLATOR-20260924-151 commit 2: `c.*` is the raw door, with no c.sizeof-specific
# semantics.  Its non-c.* operand is an ordinary L2 expression, and `@: void` is not one: the size
# of a pointer is the sizeof: receiver's type frame, `sizeof(@: void)` (unit_sizeof_type_frame).
fn: bytes (size_t: cap) size_t
    return: cap * c.sizeof(@: void)
end: bytes

return: 0
