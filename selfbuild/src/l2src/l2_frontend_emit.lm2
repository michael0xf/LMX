                ---
            ---
            if: actual_span = 1 && a0\value != 0 && a0\value\kind = c.LM_P0_NODE_ATOM
                if: c.lm_compiler_check_literal_kind((cast: (const: @: c.LmP0Text) (a0\value\as\atom)), c.lm_compiler_lit_kind_from_ft(c.lm_compiler_ft(idx, actual_i)), path, source_node) != 0
                    return: (cast: (int) (1))
