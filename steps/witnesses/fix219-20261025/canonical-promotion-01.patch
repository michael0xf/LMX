+    t: l2_tn
+    l2_tn: l2_tn + 1
+    if: c.fprintf(l2_out, "%s@: LmxArray l2_ad%d %s\n%sif: l2_ad%d = 0\n", ind, t, result\data, ind, t) < 0 || l2_emit_null_use(mi, ind) != 0
