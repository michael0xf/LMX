# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: first 0
        int: second 0
        int: count 0
)
@: shared data[0]
@: Scope (
    fn: leaf () int (int: count 0)
        data\count := data\count + 1
        return: data\count
    fn: main () int
        return: leaf()
)
int: first Scope\main()
int: second Scope\main()
int: count Scope\leaf\data\count

sub: observe ()
    shared\Observed\first := first
    shared\Observed\second := second
    shared\Observed\count := count
observe()
