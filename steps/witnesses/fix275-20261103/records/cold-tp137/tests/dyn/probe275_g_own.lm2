# Probe 275: an own named Structure rebound to another layout inside its activation, read and written through its path.  Entry 7.
Other:
    int: z 9
    int: y 7
end: Other
fn: m () int
    T:
        int: y 3
    end: T
    T: Other
    if: T\y != 7
        return: 81
    T\y: 5
    if: Other\y != 5 || Other\z != 9
        return: 82
    return: 7
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
