# Prefix/group, typed/free operands and actual named refusal use one unary kernel.
int: quote 11
fn: invert (unsigned: value) unsigned
    return: ~value
end: invert
fn: grouped (unsigned: value) unsigned
    return: ~(value | 1U)
end: grouped
fn: signed_invert (int: value) int
    return: ~ value
end: signed_invert
fn: wide_invert (size_t: value) size_t
    return: ~value
end: wide_invert
fn: char_invert (char: value) int
    return: ~value
end: char_invert
fn: free_invert () int
    return: ~quote
end: free_invert
fn: free_unsigned () unsigned
    return: ~quote
end: free_unsigned
fn: free_local_catch () int
    int: result 0
    ---
        result: ~quote
        catch: convert ()
            result: 99
    ---
    return: result
end: free_local_catch
fn: free_group_catch () int
    int: result 0
    ---
        result: ~(quote)
        catch: convert ()
            result: 99
    ---
    return: result
end: free_group_catch
fn: outer_unsigned () int
    unsigned: quote 15U
    if: free_unsigned() != 0xFFFFFFF0U
        return: 91
    return: 0
end: outer_unsigned
fn: outer_ref () int
    int: target 5
    @: quote int @target
    int: result 0
    ---
        result: free_invert()
        catch: convert ()
            result: 99
    ---
    if: result != 99
        return: 92
    if: free_local_catch() != 99
        return: 93
    if: free_group_catch() != 99
        return: 97
    return: 0
end: outer_ref
fn: once (@: count int) unsigned
    \count: \count + 1
    return: 15U
end: once
fn: run () int
    size_t: wide 15U
    unsigned: a 15U
    int: count 0
    unsigned: got 0U
    if: invert(a) != 0xFFFFFFF0U
        return: 81
    if: grouped(14U) != 0xFFFFFFF0U
        return: 82
    if: signed_invert(15) != 0 - 16 || signed_invert(0 - 1) != 0
        return: 83
    if: wide_invert(wide) != 18446744073709551600U
        return: 84
    if: char_invert('a') != 0 - 98
        return: 85
    if: ~(~a) != a || (~a & 0xFFU) != 0xF0U
        return: 86
    got: ~once(@count)
    if: got != 0xFFFFFFF0U || \(@count) != 1
        return: 87
    got: ~ once(@count)
    if: got != 0xFFFFFFF0U || \(@count) != 2
        return: 94
    got: 1U+once(@count)
    if: got != 16U || \(@count) != 3
        return: 95
    got: +once(@count)
    if: got != 15U || \(@count) != 4
        return: 96
    if: free_invert() != 0 - 12
        return: 88
    if: outer_unsigned() != 0 || outer_ref() != 0
        return: 89
    if: ~0 != 0 - 1 || ~0U != 0xFFFFFFFFU
        return: 90
    return: 7
end: run
sendMessage: exit(exit_code: run(); stdout: ""; stderr: "")
return
