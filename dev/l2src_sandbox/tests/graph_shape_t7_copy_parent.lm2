# The node a callable merge builds hangs under the copy of its model's lexical tree (the author, 2026-10-05;
# T7-NODE-LEXICAL-LINKS); the post paths walk to it from the receiver's cell (`deref`, then `up`).  The node's
# parent is a distinct copy of the unit that holds what add reads through it: other, a distinct cell holding 9.
# m reaches add by its caller's binding, its model from the program's unit, and no copied code reads Model or the
# qualified branch E: the copy holds none of them.  add reads other + m\v: w() gives 13.  Entry 7.
independent:
    const:
        immutable:
            (): E
                size_t: e 7U
            end: E
        end: immutable
    end: const
end: independent
Model:
    int: v 4
end: Model
m: merge: Model
int: other 9

fn: add () int
    return: other + m\v

fn: make () fn: () int
    return: merge(add)

@: w make()
int: got (w())
int: ok 80
if: got = 13
    ok: 7
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
