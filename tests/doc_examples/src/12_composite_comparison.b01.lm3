Leaf:
    int: value
    return: int
    total:
        return: value

Pair:
    @: left
    @: right
    return: int
    total:
        return: left\total() + right\total()
    demo:
        @: a (merge(Leaf; (int: value 2)))
        @: b (merge(Leaf; (int: value 3)))
        @: c (merge(Leaf; (int: value 5)))
        @: inner (merge(Pair; (@: left b; @: right c)))
        @: tree (merge(Pair; (@: left a; @: right inner)))
        return: tree\total()
