# The copied body needs the free name z. Neither the caller nor the copy's
# lexical parent has it: the call is inadmissible, a missing required input,
# refused where the call stands. Nothing invents a zero.
A:
    int: last 0
    last: z
ra: merge: A
ra
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
