@@ -61290,18 +61290,22 @@ fn: l2_fields_path_effects (@: LmP0Field first; int: count; int: mi; @: LmP0Node
                 status: l2_path_resolve_run(f, left, path)
                 l2_cur_mi: saved
                 if: status != 2
