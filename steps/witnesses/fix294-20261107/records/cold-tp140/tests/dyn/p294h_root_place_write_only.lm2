# Slice 294 probe: p294g's write into the unit fn's place alone, no call of it.  Entry 7 (24 implements, 23
# interpreter, 22 call).
fn: f0 (int: x; int: y) int
    return: x * 10 + y
end: f0
fn: g (int: y; int: x) int
    return: x * 10 + y
end: g
int: Hw 0
fn: write_root () int
    ---
        @: node\f0 Hw
        return: 1
        catch: implements ()
            return: 24
        catch: interpreter ()
            return: 23
        catch: call ()
            return: 22
    ---
end: write_root
fn: run () int
    int: v 0
    @: Hw g g
    v: write_root()
    if: v != 1
        return: v
    ---
    return: 7
end: run
int: code run()
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
