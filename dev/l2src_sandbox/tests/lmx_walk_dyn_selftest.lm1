predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# A dynamic input is a signature argument of the same activation frame.
# The args-part width counts it with the declared formals. The body reads
# it by ARG index. n must match that width: one extra is INVALID (D-04),
# one missing is INVALID. There is no third graph.
# Mutant: drop the n != arity check. The extra-argument check goes OK.

int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

fn: fr (@: LmxArena arena; @: Lmx roles; @: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(arena, roles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        return: 0
return: n

fn: lit (@: LmxArena arena; @: Lmx roles; @: Lmx parent; size_t: slot; int: value) int
    @: Lmx n fr(arena, roles, parent, slot, c.LMX_WALK_OP_LIT, 2U)
    if: n = 0 || lmx_walk_store_int(arena, n, 1U, value) != c.LMX_WALK_OK
        return: 1
return: 0

fn: main () int
    LmxArena: arena
    LmxScratch: scratch
    LmxPool: cells
    LmxWalkContext: ctx
    @: Lmx roles 0
    @: Lmx sig 0
    @: Lmx caller 0
    @: Lmx call 0
    @: void rtype 0
    int: got 0
    @: void outv 0
    int: present 0
    int: st 0

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ scratch)), 0, c.sizeof(c.LmxScratch))
    memset((cast: (@: void) (@ cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ ctx)), 0, c.sizeof(c.LmxWalkContext))
    if: lmx_arena_open(@ arena) != 0
        return: 2
    if: lmx_scratch_open(@ scratch, @ arena, @ cells, 64U) != c.LMX_SCRATCH_OK
        lmx_arena_release(@ arena)
        return: 2
    ---
    roles: lmx_walk_roles_open(@ arena)
    if: roles = 0
        return: 2
    ctx.arena: @ arena
    ctx.scratch: @ scratch
    ctx.roles: roles
    rtype: (cast: (@: void) lmx_int_new_owned(@ arena))
    if: rtype = 0
        return: 2

    # Signature width 2: declared formal at 0, dynamic input at 1.
    # Body reads ARG 1. Call passes 1 and 4.
    sig: lmx_node_new_owned(@ arena)
    if: sig = 0 || lmx_arena_refs_open_owned(@ arena, sig, 2U) != 0
        return: 2
    lmx_arena_ref_store(sig, 0U, (cast: (@: void) lmx_walk_plain(@ arena, sig, 2U)))
    if: fr(@ arena, roles, sig, 1U, c.LMX_WALK_OP_ARG, 2U) = 0 || lmx_walk_store_size(@ arena, lmx_arena_ref_struct(sig, 1U), 1U, 1U) != c.LMX_WALK_OK
        return: 2
    caller: lmx_node_new_owned(@ arena)
    if: caller = 0 || lmx_arena_refs_open_owned(@ arena, caller, 1U) != 0
        return: 2
    call: fr(@ arena, roles, caller, 0U, c.LMX_WALK_OP_CALL, 7U)
    if: call = 0
        return: 2
    lmx_arena_ref_store(call, 1U, (cast: (@: void) sig))
    lmx_arena_ref_store(call, 2U, (cast: (@: void) sig))
    lmx_arena_ref_store(call, 3U, rtype)
    if: lit(@ arena, roles, call, 5U, 1) != 0 || lit(@ arena, roles, call, 6U, 4) != 0
        return: 2
    got: 0
    st: lmx_walk_activate(@ ctx, caller, caller, 0, 0U, (cast: (@: void) (@ got)), @ outv, @ present)
    check(st = c.LMX_WALK_OK && got = 4, "signature width 2, dynamic ARG 1 is 4")

    # One extra argument. Same refusal as D-04.
    caller: lmx_node_new_owned(@ arena)
    if: caller = 0 || lmx_arena_refs_open_owned(@ arena, caller, 1U) != 0
        return: 2
    call: fr(@ arena, roles, caller, 0U, c.LMX_WALK_OP_CALL, 8U)
    if: call = 0
        return: 2
    lmx_arena_ref_store(call, 1U, (cast: (@: void) sig))
    lmx_arena_ref_store(call, 2U, (cast: (@: void) sig))
    lmx_arena_ref_store(call, 3U, rtype)
    if: lit(@ arena, roles, call, 5U, 1) != 0 || lit(@ arena, roles, call, 6U, 4) != 0 || lit(@ arena, roles, call, 7U, 9) != 0
        return: 2
    got: 0
    st: lmx_walk_activate(@ ctx, caller, caller, 0, 0U, (cast: (@: void) (@ got)), @ outv, @ present)
    check(st = c.LMX_WALK_INVALID, "one extra argument is INVALID")

    # The dynamic input omitted: n = 1, width = 2.
    caller: lmx_node_new_owned(@ arena)
    if: caller = 0 || lmx_arena_refs_open_owned(@ arena, caller, 1U) != 0
        return: 2
    call: fr(@ arena, roles, caller, 0U, c.LMX_WALK_OP_CALL, 6U)
    if: call = 0
        return: 2
    lmx_arena_ref_store(call, 1U, (cast: (@: void) sig))
    lmx_arena_ref_store(call, 2U, (cast: (@: void) sig))
    lmx_arena_ref_store(call, 3U, rtype)
    if: lit(@ arena, roles, call, 5U, 1) != 0
        return: 2
    got: 0
    st: lmx_walk_activate(@ ctx, caller, caller, 0, 0U, (cast: (@: void) (@ got)), @ outv, @ present)
    check(st = c.LMX_WALK_INVALID, "dynamic input omitted is INVALID")

    c.printf("lmx_walk_dyn_selftest checks=%d failures=%d\n", checks, failures)
    lmx_scratch_close(@ scratch)
    lmx_arena_release(@ arena)
    if: failures != 0
        return: 1
return: 0
