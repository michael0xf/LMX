# §9.8: W and E both fit one declaration: two candidates, ambiguity (TZ §9.2, §9.5); nothing runs.
(
    Observed:
        int: seen 0
)
@: Model ()
fn: f (@: s Model; @: t Model) int
    @: shared node[0]
    shared\Observed\seen := 1
    return: 1
sub: main () (
    A(int: x 1)
    B(int: y 2)
    S(@: s A; @: t B)
)
    f(S)
main()
