# These existing source-unit directives carry no runtime DATA/code slot.
# This predicate is used only at an actual unit root, not for named fields.
fn: lm_compiler_unit_directive (const: (@: item c.LmP0Node)) int
    @: head c.LmP0Text lm_compiler_app_head(item)
    return: (cast: (int) (lm_compiler_text_eq(head, "include") != 0 || lm_compiler_text_eq(head, "define") != 0 || lm_compiler_text_eq(head, "predef") != 0))
end: lm_compiler_unit_directive

fn: lm_compiler_os_selected_branch (const: (@: item c.LmP0Node)) const: @: c.LmP0Node
    @: b c.LmP0Field
    int: wins 0
    int: defaults 0
    int: selected 0
    if: item = 0 || item\kind != c.LM_P0_NODE_FRAME || item\as = 0 || item\as\frame = 0 || item\as\frame\body = 0
        return: (cast: (const: @: c.LmP0Node) (0))
    # The branch belongs to this actual source Frame, not the main file's
    # cached selector. A default-only source still has the ordinary fallback.
    b: lm_compiler_next_active((cast: (@: c.LmP0Field) item\as\frame\body\first_field))
    while: b != 0
        if: lm_compiler_frame_head((cast: (const: @: c.LmP0Node) b\value), "win") != 0
            wins: 1
        if: lm_compiler_frame_head((cast: (const: @: c.LmP0Node) b\value), "default") != 0
            defaults: 2
        b: lm_compiler_next_active((cast: (@: c.LmP0Field) b\next))
    selected: lm_compiler_os_branch_for(wins + defaults, lm_compiler_os_target())
    b: lm_compiler_next_active((cast: (@: c.LmP0Field) item\as\frame\body\first_field))
    while: b != 0
        if: selected = 1 && lm_compiler_frame_head((cast: (const: @: c.LmP0Node) b\value), "win") != 0
            return: (cast: (const: @: c.LmP0Node) (b\value))
        if: selected = 2 && lm_compiler_frame_head((cast: (const: @: c.LmP0Node) b\value), "default") != 0
            return: (cast: (const: @: c.LmP0Node) (b\value))
        b: lm_compiler_next_active((cast: (@: c.LmP0Field) b\next))
    return: (cast: (const: @: c.LmP0Node) (0))
end: lm_compiler_os_selected_branch

# One borrowed return pointer visits the selected source branch without
# relinking P0 fields. check_os rejects nested OS Frames at the unit level.
fn: lm_compiler_unit_cursor_field_until (@: field c.LmP0Field; @@: resume c.LmP0Field; @: stop c.LmP0Field) @: c.LmP0Field
    const: (@: branch c.LmP0Node)
    while: field != 0 || resume[0] != 0
        if: field = 0
            field: resume[0]
            resume[0]: 0
        if: stop != 0 && field = stop
            return: field
        if: lm_compiler_frame_head((cast: (const: @: c.LmP0Node) field\value), "os") != 0
            resume[0]: lm_compiler_next_active((cast: (@: c.LmP0Field) field\next))
            branch: lm_compiler_os_selected_branch((cast: (const: @: c.LmP0Node) field\value))
            field: 0
            if: branch != 0
                field: lm_compiler_next_active((cast: (@: c.LmP0Field) branch\as\frame\body\first_field))
            continue
        if: lm_compiler_unit_directive((cast: (const: @: c.LmP0Node) field\value)) != 0
            field: lm_compiler_next_active((cast: (@: c.LmP0Field) field\next))
            continue
        return: field
    ---
    return: 0
end: lm_compiler_unit_cursor_field_until

fn: lm_compiler_unit_cursor_field (@: field c.LmP0Field; @@: resume c.LmP0Field) @: c.LmP0Field
    return: lm_compiler_unit_cursor_field_until(field, resume, 0)
end: lm_compiler_unit_cursor_field

fn: lm_compiler_part_source_body (const: (@: body c.LmP0Structure)) int
    @: part_loaded_cell int (cast: (@: int) (@ c.l2_part_loaded))
    @@@: part_doc_cell c.LmP0Document (cast: (@@@: c.LmP0Document) (@ c.l2_part_doc))
    const: (@: root c.LmP0Node)
    int: at 0
    if: body = 0
        return: 0
    while: at < part_loaded_cell[0]
        root: c.lm_p0_document_root((cast: (const: @: c.LmP0Document) part_doc_cell[0][at]))
        if: root != 0 && root\kind = c.LM_P0_NODE_STRUCTURE && root\as != 0 && root\as\structure = body
            return: 1
        at: at + 1
    return: 0
end: lm_compiler_part_source_body

# Each span stays a contiguous range of original fields. A directive or OS
# Frame ends that range; the cursor resumes at the next selected range.
fn: lm_compiler_unit_span_count (@: first c.LmP0Field) int
    @: field c.LmP0Field lm_compiler_next_active(first)
    int: count 0
    while: field != 0 && lm_compiler_unit_directive((cast: (const: @: c.LmP0Node) field\value)) = 0 && lm_compiler_frame_head((cast: (const: @: c.LmP0Node) field\value), "os") = 0
        count: count + 1
        field: lm_compiler_next_active((cast: (@: c.LmP0Field) field\next))
    return: count
end: lm_compiler_unit_span_count

# Membership and later body passes borrow the same selected physical fields.
# Only retained part roots are units; nested DATA retains its normal members.
fn: lm_compiler_body_has_source (const: (@: body c.LmP0Structure); const: (@: source_node c.LmP0Node)) int
    @: field c.LmP0Field
    @: resume c.LmP0Field 0
    int: unit_body
    if: body = 0 || source_node = 0
        return: 0
    unit_body: lm_compiler_part_source_body(body)
    field: lm_compiler_next_active((cast: (@: c.LmP0Field) body\first_field))
    while: field != 0 || resume != 0
        if: unit_body != 0
            field: lm_compiler_unit_cursor_field(field, @ resume)
            if: field = 0
                break
        ---
        if: field\value = source_node
            return: 1
        field: lm_compiler_next_active((cast: (@: c.LmP0Field) field\next))
    return: 0
end: lm_compiler_body_has_source

# An OS-only part makes the output target-dependent even when the main unit
# has no OS Frame. Inspect retained actual roots, without borrowing one as
# the main unit's os_node or combining branch masks from unrelated units.
fn: lm_compiler_program_has_os () int
    const: (@@: os_node_cell c.LmP0Node (cast: (const: @@: c.LmP0Node) (@ c.l2_os_node)))
    @: part_loaded_cell int (cast: (@: int) (@ c.l2_part_loaded))
    @@@: part_doc_cell c.LmP0Document (cast: (@@@: c.LmP0Document) (@ c.l2_part_doc))
    const: (@: root c.LmP0Node)
    int: at 0
    if: os_node_cell[0] != 0
        return: 1
    while: at < part_loaded_cell[0]
        root: c.lm_p0_document_root((cast: (const: @: c.LmP0Document) part_doc_cell[0][at]))
        if: lm_compiler_os_root_branches(root) != 0
            return: 1
        at: at + 1
    return: 0
end: lm_compiler_program_has_os

