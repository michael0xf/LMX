# A computed Point output is retained at its own place inside the else body.
Point:
    int: x 0
    int: y 0
end: Point
fn: nop () int
    return: 0
fn: test () int
    int: answer 64
    if: 0
        int: unused 1
    else:
        pt: merge: Point
        pt\x: 4
        nop()
        if: else\pt\x = 4
            answer: 7
    ---
    return: answer
int: r 0
r: test()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
