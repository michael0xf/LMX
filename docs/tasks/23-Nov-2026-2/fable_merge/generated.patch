diff --git a/patterns/examples/perl_comparison/validation/lmx_acceptance_cases.json b/patterns/examples/perl_comparison/validation/lmx_acceptance_cases.json
new file mode 100644
index 0000000000000000000000000000000000000000..5f77cc2119579ceec2733660c3f8e9f821afb148
--- /dev/null
+++ b/patterns/examples/perl_comparison/validation/lmx_acceptance_cases.json
@@ -0,0 +1,113 @@
+{
+  "status": "NOT_RUN",
+  "scope": "Explicit LMX runtime acceptance requirements for current core reuse and generic source; not an execution report.",
+  "cases": [
+    {
+      "id": "S01",
+      "input": "empty dense int[]",
+      "expected": "fresh int[] with length zero; comparator is not called"
+    },
+    {
+      "id": "S02",
+      "input": "singleton @[] containing a structure reference",
+      "expected": "fresh outer array, same element reference, no comparator call"
+    },
+    {
+      "id": "S03",
+      "input": "records with equal priority and distinct width/id fields",
+      "expected": "stable ordering, every field preserved, source slots unchanged"
+    },
+    {
+      "id": "S04",
+      "input": "char[] and an ordering comparator over char",
+      "expected": "fresh char[] preserving the complete character profile"
+    },
+    {
+      "id": "S05",
+      "input": "comparator throws after its second comparison",
+      "expected": "FxCallFailure retains declared name/payload; source is unchanged; no result publication"
+    },
+    {
+      "id": "S06",
+      "input": "comparator returns a non-int record",
+      "expected": "SequenceElement; source unchanged"
+    },
+    {
+      "id": "S07",
+      "input": "length near admitted profile maximum",
+      "expected": "no width/end addition before safe difference check; no fixed word-width constants"
+    },
+    {
+      "id": "U01",
+      "input": "empty array and singleton reference array",
+      "expected": "fresh same-profile array; same is not called"
+    },
+    {
+      "id": "U02",
+      "input": "different records equal under user-supplied same",
+      "expected": "first original record reference retained; output group order stable"
+    },
+    {
+      "id": "U03",
+      "input": "same throws on a later candidate",
+      "expected": "FxCallFailure; input unchanged and no partial result"
+    },
+    {
+      "id": "U04",
+      "input": "same returns non-int",
+      "expected": "FxPredicate"
+    },
+    {
+      "id": "U05",
+      "input": "initialized, uninitialized and void records with a callback comparing explicit type codes only",
+      "expected": "values remain whole typed records; there is no mandatory numeric payload read in unique"
+    },
+    {
+      "id": "M01",
+      "input": "post owning method that performs sort/unique/bracket",
+      "expected": "whole operation remains inside owning Message arena; ordinary completion/failure delivered; no shared mutable pointer across arenas"
+    },
+    {
+      "id": "P05_DYNAMIC_THRESHOLD",
+      "input": "Call the same Below method through any then all; threshold changes from 0 to 10 in one Example activation.",
+      "expected": "Observe separate short-circuit traversals with the current threshold; no saved factory scope and no duplicated predicate body.",
+      "runtime_status": "NOT_RUN"
+    },
+    {
+      "id": "P10_TYPED_GROUP_MAP",
+      "input": "Group integer codes including 0, then map Frequency over actual FxGroup records.",
+      "expected": "Keep the direct compound result reference; output key/count pairs preserve integer zero without an extra @ box.",
+      "runtime_status": "NOT_RUN"
+    },
+    {
+      "id": "P11_REFERENCE_FIELDS",
+      "input": "Group records containing kind, width and a nested mutable reference, then map GroupRow.",
+      "expected": "Keep every original record and nested reference; change only the outer group-observation shape.",
+      "runtime_status": "NOT_RUN"
+    },
+    {
+      "id": "P17_DIRECT_MATCH_TEXT",
+      "input": "collect eachMatch over empty/nonempty ASCII text, then map matchedText.",
+      "expected": "Stop terminates only the producer; direct Match and char[] results are retained as complete records with valid arena lifetime.",
+      "runtime_status": "NOT_RUN"
+    },
+    {
+      "id": "P22_MERGED_OWNER",
+      "input": "Create two counters via merge with initial values 10 and 100; caller also has a variable value=999.",
+      "expected": "The explicit copied owner contains the supplied value; independent calls yield [11,14,102,12], with no mutation of caller or original model.",
+      "runtime_status": "NOT_RUN"
+    },
+    {
+      "id": "P23_ZERO_AND_LIFETIME",
+      "input": "Create two copied Squares sources with different limits, consume their next methods through collect, retain arrays after completion.",
+      "expected": "Zero is kept; source state and limit are independent, records outlive the completed call within the owning Message, no finished stack activation is captured.",
+      "runtime_status": "NOT_RUN"
+    },
+    {
+      "id": "P24_SHARED_TRACE",
+      "input": "Invoke Example run for modes 0/1/2 using the shared eval/code helpers; compare complete generic and local approaches.",
+      "expected": "Results [50,123], [0,123], [0,1]; acquire failure skips release, action failure still releases once; named end cutters retain their ordinary grammar meaning.",
+      "runtime_status": "NOT_RUN"
+    }
+  ]
+}
