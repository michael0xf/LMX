+# The same prepared body accessor for groups,unary syntax and general Frame
+# arguments. Ownership differs,not the field grammar or source identity.
+fn: l2_primary_values (@: L2ValueSpan value; @: int n) @: L2ValueSpan
+    \n: 0
+    if: value = 0
+        return: 0
+    if: value\values != 0
+        \n: value\value_n
+        return: value\values
+    if: value\primary != 0
+        \n: value\primary\body_n
+        return: value\primary\body
+    if: value\node != 0 && value\node\kind = c.LM_P0_NODE_FRAME && value\node\as != 0 && value\node\as\frame != 0 && l2_count_active(value\node\as\frame\body) > 0
+        \n: -1
+return: 0
+
+# Raw callers enter at an explicit ownership boundary. An existing site is
+# borrowed; it is never reparsed after an admitted/failed child projection.
+fn: l2_primary_use (const: @(LmP0Node node); int: mi; @: L2ValueSpan temporary; @@: L2ValueSpan out) int
+    @: L2ApplicationSite site l2_application_site_find(node, mi)
+    l2_value_span_ref(temporary, 0, 0)
+    if: site != 0
+        \out: @ site\value
+        return: 0
+    temporary\node: (cast: (@: LmP0Node) node)
+    temporary\count: 1
+    temporary\grammar: 2
+    \out: temporary
+return: l2_value_source_children(temporary)
+
+# These are receiver contracts, not another argument grammar. A selected
+# L2 application keeps its signature even if its name is an intrinsic word.
+# C's `sizeof` (L2 section 20) is a C99 keyword OPERATOR, not a foreign
+# symbol: it is classified after the common preparation like any receiver,
+# and its operand keeps C's unevaluated contract (role 5, C99 6.5.3.4p2).
+# This is not a C-name registry; every other c.* head keeps the uniform door
+# (Codex OPUS-CODEX-20261022-CDOOR-01).
+fn: l2_primary_role (@: L2ValueSpan value; int: mi) int
+    if: value = 0
+        return: 0
+return: l2_node_role(value\node, mi)
+
+# The role of a written Frame from its node alone: a consumer that walks
+# source nodes (the M2 summaries) reads the SAME classification as CHECK,
+# native, retained and type consumers of the prepared value.
+fn: l2_node_role (const: @(LmP0Node node); int: mi) int
+    @: LmP0Text head
+    @: L2ApplicationSite site
+    int: formal
+    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
+        return: 0
+    head: node\as\frame\head
+    site: l2_application_site_find(node, mi)
+    if: site != 0 && (site\signature >= 0 || site\held >= 0)
+        return: 0
+    if: l2_text_eq(head, "cast") != 0
+        return: 1
+    if: l2_text_eq(head, "length") != 0 && l2_call_head_method(mi, head, @ formal) < 0
+        return: 2
+    if: l2_text_eq(head, "sizeof") != 0
+        return: 4
+    if: l2_text_eq(head, "c.sizeof") != 0
+        return: 5
+    if: l2_external_head(head, mi) != 0
+        return: 3
+return: 0
+
+# An operator whose operand runs nothing: bare sizeof and C's sizeof. Only
+# their heads can have roles 4/5, so other Frames skip the role query.
+fn: l2_node_unevaluated (const: @(LmP0Node node); int: mi) int
+    int: role
+    if: node = 0 || node\kind != c.LM_P0_NODE_FRAME || node\as = 0 || node\as\frame = 0
+        return: 0
+    if: l2_text_eq(node\as\frame\head, "sizeof") = 0 && l2_text_eq(node\as\frame\head, "c.sizeof") = 0
+        return: 0
+    role: l2_node_role(node, mi)
+return: (cast: (int) (role = 4 || role = 5))
+
+# A borrowed range of the SAME prepared body, also used by signature actuals.
+# width=-1 selects the complete tail. No field or index is decoded here.
+fn: l2_primary_slice (@: L2ValueSpan value; int: start; int: width; @: L2ValueSpan out) int
+    int: n
+    @: L2ValueSpan values l2_primary_values(value, @ n)
+    if: n < 0 || start < 0 || start > n
+        return: 1
+    if: width < 0
+        width: n - start
+    if: width > n - start
+        return: 1
+    if: width = 0
+        return: l2_value_argument_ref(0, 0, value\node, out)
+return: l2_value_argument_ref(values + start, width, value\node, out)
+
+fn: l2_primary_cast_value (@: L2ValueSpan value; @: int type; @: L2Tx text; @: L2ValueSpan operand) int
+    @: LmP0Frame frame value\node\as\frame
+    int: n
+    @: L2ValueSpan values l2_primary_values(value, @ n)
+    if: frame\body = 0 || frame\trailer != 0 || frame\body\trailer != 0 || n < 2 || values = 0 || values[0].count != 1
+        return: 1
+    if: l2_cast_resolve(l2_span_node(values, 0), type, text) != 0 || l2_primary_slice(value, 1, -1, operand) != 0
+        return: 1
+    if: operand\grammar = 3 && l2_value_spans_expression(operand\values, operand\value_n) = 0
+        return: 1
+return: 0
+
+fn: l2_primary_array_value (@: L2ValueSpan value; int: mi; @: L2ValueSpan operand) int
+    @: LmP0Frame frame value\node\as\frame
+    int: type -1
+    int: kind
+    if: frame\body = 0 || frame\trailer != 0 || frame\body\trailer != 0 || l2_primary_slice(value, 0, -1, operand) != 0 || operand\count < 1
+        return: 1
+    if: operand\grammar = 3 && l2_value_spans_expression(operand\values, operand\value_n) = 0
+        return: 1
+    kind: l2_value_span_type(operand, mi, @ type)
+    # A failed source contract is final. Never compare its sentinel with
+    # another failed query (including allocation failure in type interning).
+    if: type < 0
+        return: 1
+return: (cast: (int) (type != l2_array_desc_ty()))
+
+# Interpret a TYPE operand from the same prepared children. The shared
+# declaration/cast contract reader still owns machine type syntax; a name
+# that is not a written type remains an ordinary value, not a guessed typedef.
+fn: l2_value_type_operand (@: L2ValueSpan value; @: int type; @: L2Tx text) int
+    @: L2ValueSpan values
+    @: LmP0Text word
+    int: n
+    int: k 0
+    int: child_type
+    int: status
+    if: value = 0 || value\node = 0 || value\node\as = 0
+        return: 2
+    if: value\values != 0 && value\value_n = 1 && (value\grammar = 3 || value\node\kind = c.LM_P0_NODE_STRUCTURE)
+        return: l2_value_type_operand(value\values, type, text)
+    if: value\count != 1
+        return: 2
+    if: value\node\kind = c.LM_P0_NODE_ATOM
+        word: value\node\as\atom
+        if: l2_prim_type_word(word) != 0
+            return: l2_cast_resolve(value\node, type, text)
+        if: l2_c_stmt_door(word) != 0
+            \type: -12
+            if: text != 0
+                return: l2_tok_tx(text, word)
+            return: 0
+        return: 2
+    values: l2_primary_values(value, @ n)
+    if: n < 0
+        return: 1
+    if: value\node\kind = c.LM_P0_NODE_FRAME && l2_address_depth(value\node\as\frame\head) > 0 && n = 1
+        status: l2_value_type_operand(values, @ child_type, 0)
+        if: status != 0
+            return: status
+        return: l2_cast_resolve(value\node, type, text)
+    if: value\node\kind = c.LM_P0_NODE_STRUCTURE && n > 0
+        while: k < n
+            if: values[k].count != 1 || l2_span_node(values, k)\kind != c.LM_P0_NODE_ATOM || l2_ctype_word(l2_span_node(values, k)\as\atom) = 0
+                return: 2
+            k: k + 1
+        ---
+        return: l2_cast_resolve(value\node, type, text)
+    ---
+return: 2
+
+# A typed,UNEVALUATED machine witness goes through the same L1 declaration
+# formatter as every other native type. A language alias is not a raw C type
+# name. No binding is resolved,no operand or null pointer is ever evaluated.
+fn: l2_value_type_size (int: type; @: L2Tx text) int
+    LmP0Text: word
+    int: depth
+    int: qualified
+    []: char pointer_own 1024
+    L2Tx: pointer_tx
+    @: L2Tx pointer_text l2_tx_local(@ pointer_tx, pointer_own, 1024U)
+    if: type < 0 || l2_type_parts(type, @ word, @ depth, @ qualified) != 0
+        return: 1
+    if: text = 0
+        return: 0
+    if: l2_pointer_decl_text(type, 1, 0, pointer_text) != 0
+        return: 1
+return: l2_tx_join(text, "c.sizeof(\\ (cast: (", pointer_text\data, ") 0))", 0, 0)
+
+# A declaration's backing extent is storage metadata of the selected place,
+# not a search by that place's name. A reference/returned Array without such
+# storage is its descriptor-reference ABI, not its ancestor Array's extent.
+fn: l2_value_storage_extent (@: L2ValueSpan value; int: mi; @@: LmP0Text extent; @: int element) int
+    @: L2Path selected
+    @: L2PathStep step
+    @: L2Declaration declaration 0
+    @: LmP0Node source 0
+    int: status
+    int: own -1
+    int: row -1
+    \extent: 0
+    \element: -1
+    if: value\values != 0 && value\value_n = 1 && (value\grammar = 3 || value\node\kind = c.LM_P0_NODE_STRUCTURE)
+        return: l2_value_storage_extent(value\values, mi, extent, element)
+    status: l2_value_span_path(value, mi, @ selected)
+    if: status != 0
+        if: status = 1
+            return: 2
+        return: 1
+    if: selected\n = 0
+        own: selected\root_contract_own
+        if: own < 0
+            own: selected\root_own
+        ---
+    else:
+        step: selected\steps + selected\n - 1
+        if: step\locus = 7
+            return: 2
+        if: step\locus = 3 || step\locus = 6
+            own: step\own
+        row: step\nsrow
+        if: row < 0 && step\locus = 1
+            row: step\row
+        ---
+    ---
+    if: own >= 0 && own < l2_own_n
+        source: l2_own_decl[own]
+    if: source = 0 && row >= 0 && row < l2_nsf_n
+        source: l2_nsf_source[row]
+    if: source = 0
+        return: 2
+    declaration: l2_declaration(source)
+    if: declaration = 0 || declaration\contract = 0 || declaration\contract\kind != 1 || declaration\extent = 0
+        return: 2
+    if: l2_contract_formal(declaration\contract\operand, element) != 0 || \element < 0
+        return: 1
+    \extent: declaration\extent
+return: 0
+
+# The storage query is a type/place projection, never a native evaluation of
+# its operand. All path kinds use the same completed record, including INDEX
+# children and references. Type syntax is interpreted only after preparation.
+fn: l2_value_storage_size (@: L2ValueSpan value; int: mi; @: L2Tx text) int
+    int: type -1
+    int: element -1
+    int: kind
+    int: status
+    @: LmP0Text extent 0
+    []: char type_own 1024
+    L2Tx: type_tx
+    @: L2Tx type_text l2_tx_local(@ type_tx, type_own, 1024U)
+    status: l2_value_type_operand(value, @ type, type_text)
+    if: status = 0
+        if: type >= 0
+            return: l2_value_type_size(type, text)
+        if: text = 0
+            return: 0
+        return: l2_tx_join(text, "c.sizeof(", type_text\data, ")", 0, 0)
+    if: status != 2
+        return: 1
+    kind: l2_value_span_type(value, mi, @ type)
+    if: type = -10
+        type: 0
+        if: kind = -2
+            type: 34
+        ---
+    ---
+    if: type < 0
+        return: 1
+    status: l2_value_storage_extent(value, mi, @ extent, @ element)
+    if: status = 1
+        return: 1
+    if: status = 0
+        if: l2_value_type_size(element, type_text) != 0
+            return: 1
+        if: text = 0
+            return: 0
+        if: l2_tx_wrapn(text, "(", extent\data, extent\length, " * ") != 0 || l2_tx_cat(text, type_text\data) != 0 || l2_tx_cat(text, ")") != 0
+            return: 1
+        return: 0
+return: l2_value_type_size(type, text)
+
+fn: l2_primary_sizeof_value (@: L2ValueSpan value; int: mi; @: L2ValueSpan operand; @: L2Tx text) int
+    @: LmP0Frame frame value\node\as\frame
+    int: type
+    int: status
+    if: frame\body = 0 || frame\trailer != 0 || frame\body\trailer != 0 || l2_primary_slice(value, 0, -1, operand) != 0 || operand\count < 1
+        return: 1
+    status: l2_value_type_operand(operand, @ type, 0)
+    if: status != 0 && operand\grammar = 3 && l2_value_spans_expression(operand\values, operand\value_n) = 0
+        return: 1
+return: l2_value_storage_size(operand, mi, text)
+
+fn: l2_primary_sizeof_type (@: L2ValueSpan value) int
+    L2ValueSpan: operand
+    int: type
+    if: value = 0 || l2_frame_head(value\node, "sizeof") = 0 || l2_primary_slice(value, 0, -1, @ operand) != 0
+        return: 0
+return: (cast: (int) (l2_value_type_operand(@ operand, @ type, 0) = 0))
+
+fn: l2_primary_value_type (@: L2ValueSpan value; int: mi; @: int type) int
+    L2ValueSpan: operand
+    int: role l2_primary_role(value, mi)
+    if: role = 0
+        return: 2
+    if: role = 1
+        return: l2_primary_cast_value(value, type, 0, @ operand)
+    # length and both sizeof operators have C's size_t (C99 6.5.3.4p4); any other C door value is opaque, C's to type.
+    if: role = 2 || role = 4 || role = 5
+        \type: 2
+    else:
+        \type: -12
+    ---
+return: 0
+
+# CHECK/native/COUNT/EMIT project those same receiver operands. 2 means a
+# different receiver role, never a failed projection followed by raw retry.
+fn: l2_check_primary_value (@: L2ValueSpan value; int: mi; const: @(char path)) int
+    L2ValueSpan: operand
+    int: type
+    int: saved
+    int: status
+    int: role l2_primary_role(value, mi)
+    if: role = 0
+        return: 2
+    if: role = 1
+        if: l2_primary_cast_value(value, @ type, 0, @ operand) != 0
+            return: l2_error(path, value\node, "unsupported cast contract")
+        return: l2_check_value_span(@ operand, mi, path, value\node)
+    if: role = 2
+        if: l2_primary_array_value(value, mi, @ operand) != 0
+            return: l2_error(path, value\node, "length requires one Array value")
+        return: l2_check_value_span(@ operand, mi, path, value\node)
+    # An unevaluated operand is checked as a value -- names, paths, INDEX,
+    # operators and calls must be valid -- but a call in it never runs.
+    if: role = 4
+        if: l2_primary_sizeof_value(value, mi, @ operand, 0) != 0
+            return: l2_error(path, value\node, "sizeof: no known storage contract for this operand")
+        if: l2_primary_sizeof_type(value) != 0
+            return: 0
+        saved: l2_check_unevaluated
+        l2_check_unevaluated: 1
+        status: l2_check_value_span(@ operand, mi, path, value\node)
+        l2_check_unevaluated: saved
+        return: status
+    if: role = 5
+        saved: l2_check_unevaluated
+        l2_check_unevaluated: 1
+        status: l2_check_machine_actuals(value, mi, path)
+        l2_check_unevaluated: saved
+        return: status
+return: l2_check_machine_actuals(value, mi, path)
+
+# Every machine actual of the SAME prepared body is CHECKed as a value; the
+# C callee, its prototype and the C operator are judged by C.
+fn: l2_check_machine_actuals (@: L2ValueSpan value; int: mi; const: @(char path)) int
+    L2ValueSpan: operand
+    @: L2ValueSpan values
+    int: n
+    int: k 0
+    int: width
+    values: l2_primary_values(value, @ n)
+    if: n < 0
+        return: l2_error_fatal(path, value\node, "internal: a machine call lost its prepared body")
+    while: k < n
+        width: l2_value_argument_extent(values, n, k)
+        if: width < 1 || l2_primary_slice(value, k, width, @ operand) != 0
+            return: l2_error(path, value\node, "incomplete machine argument expression")
+        if: l2_check_value_span(@ operand, mi, path, value\node) != 0
+            return: 1
+        k: k + width
+    ---
+return: 0
