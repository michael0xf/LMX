include: "<windows.h>"
predef: "l2src/lmx.h.lm1"

# The clock of the R0 cycle (model 33), and the only place in the kernel that asks the
# platform for the time.
#
# A CYCLE owns the clock and hands the reading down to whatever must age: a scheduler
# record never asks the platform itself, which is why every lmx_schedule call that ages a
# wait takes its `now` as an argument.  That is the whole reason this module is separate
# from lmx_schedule -- the arithmetic of a wait (record) and the source of time (cycle)
# are different owners.
#
# Milliseconds since the platform started, monotonic and non-decreasing, so a wait is
# bounded in REAL time and not in loop iterations.  It is not wall time and nothing here
# pretends it is: what bounds a wait is the cycle's own count, not a calendar.
#
# ULONGLONG is the platform's 64-bit unsigned; a record may keep a 32-bit reading, where
# `now - started` stays correct across a wrap because the arithmetic is modulo 2^32 and a
# limit is small.
foreign: ULONGLONG

prototype:
    fn: lmx_clock_now () ULONGLONG
    # The same reading as the 32-bit count a scheduler record keeps.
    fn: lmx_clock_ticks () ulong
    # THE PLATFORM WORD'S READING OF THE SAME CLOCK, and the width a stored close deadline lives in.
    # IT MUST CAST GetTickCount64 DIRECTLY.  Routing it through lmx_clock_ticks() is a silent defect
    # on this platform: `ulong` emits as C `unsigned long`, which is 32 BITS on Windows x64 while
    # size_t is 64, so the truncation would be zero-extended into the wider word -- and a modular
    # deadline test running at the wider width over values that really wrap at 2^32 would answer
    # "not yet reached" for the ~49.7 days after the wrap.  No short test can reach that wrap, so
    # the cast is the whole defence (lmx_uds, 2026-09-21).
    fn: lmx_clock_word () size_t
    # HALF THE WORD RANGE: the width a modular deadline comparison is sound below, and therefore the
    # largest close limit the setter accepts (lmx_root_close_limit_set refuses at or above it).
    fn: lmx_clock_half () size_t
    # HAS THE DEADLINE PASSED -- wrap-safe modular arithmetic, and the ONLY way a stored deadline is
    # read.  `now - deadline` is modular: a small difference means now is at or past the deadline, a
    # difference at or above half the range means it is still ahead.  This is the FIRST
    # STORED-DEADLINE COMPARISON IN THIS KERNEL -- the seven existing timeout sites are all elapsed
    # subtraction (lmx_orphan 224/235, lmx_root 267, lmx_schedule 50, lmx_thread 545/650,
    # lmx_turn 111) -- and it is sound where those had to subtract because the value is a platform
    # word AND a limit may never reach half its range, so one window cannot span a wrap.
    fn: lmx_deadline_passed (size_t: deadline; size_t: now) int
    # HOW LONG UNTIL THE DEADLINE, and ZERO when it has already passed: an expired deadline must arm
    # a ZERO wait, never underflow into a word-sized eternity.  Same guard shape as lmx_clock_since,
    # which saturates at zero rather than wrapping.
    fn: lmx_deadline_wait (size_t: deadline; size_t: now) size_t
    # How long since a reading.  A reading from the future saturates at zero instead of
    # wrapping into a huge wait.
    fn: lmx_clock_since (ULONGLONG: start) ULONGLONG
end: prototype
