# Micro-probe of a CODE-local Array: store with a constant index, read with a variable index in the walker. Expected 7.
fn: probe_e2_var_index () int
    []: int quote 3
    quote[1U] := 4
    size_t: at 1U
    return: quote[at] + 3
end: probe_e2_var_index

send: exit(exit_code: probe_e2_var_index(); stdout: ""; stderr: "")
return
