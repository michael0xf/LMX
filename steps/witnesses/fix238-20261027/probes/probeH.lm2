# Probe H: deref-prefixed actuals in the first and third positions of a C door call, a plain local between them.
include: "<stdio.h>"
fn: show (@: out int) int
    int: uslot 5
    if: c.printf("%d %d %d\n", \out, uslot, \out) < 0
        return: 1
    return: 0
end: show
fn: run () int
    int: v 7
    if: show(@ v) != 0
        return: 80
    return: 7
end: run
sendMessage: exit(exit_code: run(); stdout: ""; stderr: "")
return
