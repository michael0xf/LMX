# A text is no number: in a comparison or arithmetic it is refused where it stands.  `x: "x" + 1` went out as C
# adding to the text's pointer (the walk does not take a text there at all).
Box:
    int: v 0
end: Box
fn: take (int: x) int
    return: x
end: take
fn: peek () int
    int: x 0
    x: "x" + 1
    return: x
end: peek
int: r 0
r: peek()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
