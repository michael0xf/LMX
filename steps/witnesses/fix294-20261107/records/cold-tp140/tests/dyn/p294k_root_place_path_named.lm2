# Slice 294 probe: p294g's write into the unit fn's place, then only the path call with named actuals
# `node\f0(x: 3; y: 4)`: g's x = 3, y = 4 give 34.  Entry 7; a wrong value leaves as the exit code.
fn: f0 (int: x; int: y) int
    return: x * 10 + y
end: f0
fn: g (int: y; int: x) int
    return: x * 10 + y
end: g
int: Hw 0
fn: write_root () int
    ---
        @: node\f0 Hw
        return: 1
        catch: implements ()
            return: 24
    ---
end: write_root
fn: call_path () int
    ---
        int: got node\f0(x: 3; y: 4)
        return: got
        catch: call ()
            return: 52
    ---
end: call_path
fn: run () int
    int: v 0
    @: Hw g g
    v: write_root()
    if: v != 1
        return: v
    ---
    v: call_path()
    if: v != 34
        return: v
    ---
    return: 7
end: run
int: code run()
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
