        c.printf("FAIL [%s] %s\n", phase_cell[0], label)
    ---
end: check

fn: dispatch_probe (@: owner void; @@: refs void; size_t: nargs; @: dest void; @@: out void; @: lmx_call_arena c.LmxArena; @: lmx_call_code c.Lmx; @: lmx_input_values c.LmxWalkValue; @: lmx_result_context c.LmxWalkValue) int
    @@: dispatch_arena_cell c.LmxArena (cast: (@@: c.LmxArena) (@ c.dispatch_arena))
    @: dispatch_calls_cell int (cast: (@: int) (@ c.dispatch_calls))
    @@: dispatch_selected_cell c.Lmx (cast: (@@: c.Lmx) (@ c.dispatch_selected))
    @: dispatch_throws_cell int (cast: (@: int) (@ c.dispatch_throws))
    @@: dispatch_payload_cell c.Lmx (cast: (@@: c.Lmx) (@ c.dispatch_payload))
    @: dispatch_second_cells_cell size_t (cast: (@: size_t) (@ c.dispatch_second_cells))
    @: pool c.LmxPool dispatch_arena_cell[0]\arrays
    size_t: occupied 0U
    size_t: expected_wide 4294967303U
    @: pointer void 0
    dispatch_calls_cell[0]: dispatch_calls_cell[0] + 1
    # The selected copied occurrence determines unary call data by its arena
    # role: an fn uses its var; an ordinary Structure uses itself.
    check((cast: (int) (owner = (cast: (@: void) c.lmx_call_unary_data(dispatch_arena_cell[0], dispatch_selected_cell[0])))), "dispatch uses the selected copied occurrence's data as owner")
    check((cast: (int) (nargs = 5U && refs != 0 && dest != 0 && out != 0)), "dispatch passes the complete typed signature")
    if: nargs != 5U || refs = 0 || dest = 0 || out = 0
        return: 1
    check((cast: (int) (c.lmx_int_value_known(refs[0]) = 23)), "first explicit actual is evaluated once and in position")
    check((cast: (int) (c.lmx_char_value_known(refs[1]) = 81)), "char actual uses char-width value storage")
    check((cast: (int) (c.lmx_size_value_known(refs[2]) = expected_wide)), "wide actual retains its exact width")
    pointer: c.lmx_pointer_value_known(refs[3])
    check((cast: (int) (pointer != 0 && pointer != refs[3] && c.lmx_int_value_known(pointer) = 41)), "reference actual is held in a canonical pointer box")
    check((cast: (int) (c.lmx_int_value_known(refs[4]) = 17)), "hidden input follows the explicit actuals")
    if: dispatch_throws_cell[0] != 0
        # A result-looking destination must not become the successful value
        # when status selects the separately allocated throw payload.
        c.lmx_int_store_known(dest, 999)
        out[0]: (cast: (@: void) dispatch_payload_cell[0])
        return: 1
    while: pool != 0
        occupied: occupied + c.lmx_pool_count(pool)
        pool: pool\next
    ---
    if: dispatch_calls_cell[0] = 2
        dispatch_second_cells_cell[0]: occupied
    if: dispatch_calls_cell[0] = 3
        check((cast: (int) (occupied = dispatch_second_cells_cell[0])), "repeated calls allocate no arena transport cells")
    c.lmx_int_store_known(dest, 700 + dispatch_calls_cell[0])
    out[0]: dest
    return: 0
end: dispatch_probe

fn: dispatch_rewrite_return (@: arena c.LmxArena; @: frame c.Lmx) int
    @: frame_fields c.VoidArray 0
    @: child_fields c.VoidArray 0
    frame_fields: 0
