# Both calls execute the same declared occurrence. A declaration skipped by the
# second call does not replace or reinitialize the physical field.
# - keep(1) reaches `int: v 7`: keep\v is 7 (h).
# - keep(0) returns before the declaration, so keep\v is still keep(1)'s 7.
# h * 10 + keep\v is77; resetting the skipped field would incorrectly produce70.
fn: keep (int: go) int
    if: go = 0
        return: 0
    int: v 7
    return: 0
end: keep

fn: probe () int
    int: h 0
    int: g 0
    keep(1)
    h: keep\v
    keep(0)
    g: h * 10 + keep\v
    return: g
end: probe

sendMessage: exit(exit_code: probe(); stdout: ""; stderr: "")
return
