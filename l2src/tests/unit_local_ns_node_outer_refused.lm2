# S declared in an `if:` body: its `node` is that body's Structure (slice 2c-4), and k -- a field of the method, not of
# the body -- is no field of it.  Unresolved where it stands; S's body reads k as a hidden input by its bare name.
fn: m () int
    int: k 1
    int: r 0
    if: r = 0
        S:
            int: v 0
            v: node\k
        S()
        r: r + 0
    int: out r
    return: out
end: m
int: r 0
r: m()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
