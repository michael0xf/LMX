    c.printf("MixaAppController help_btn_col=%zu\n", (cast: (size_t) @ p0\help_btn_col) - (cast: (size_t) p0))
    c.printf("MixaAppController help_btn_nrows=%zu\n", (cast: (size_t) @ p0\help_btn_nrows) - (cast: (size_t) p0))
    c.printf("MixaAppController help_btn_ncols=%zu\n", (cast: (size_t) @ p0\help_btn_ncols) - (cast: (size_t) p0))
    c.printf("MixaAppController cmdline=%zu\n", (cast: (size_t) @ p0\cmdline) - (cast: (size_t) p0))
