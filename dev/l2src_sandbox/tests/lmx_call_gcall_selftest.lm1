predef: "l2src/lmx_call.lm1"
predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_scratch.lm1"
predef: "l2src/lmx_fresh.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_primitive.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# -194 к.4 (G-call): lmx_call_prim's addr=0 branch must carry a REAL argument and a typed
# dest through to a walked (native = 0) callee, not just the nullary/int-only shape
# lmx_call0's own hook still has. M(x) = x + 1, called with a live reference the way a
# native/prim-ABI caller would, exercising exactly what the old lmx_call_walk_fn hook
# could not (nargs != 0U aborted it outright).

sub: gc_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: gc_check

# A frame node under `parent`, stored into parent[slot].
fn: gc_fr (@: LmxArena arena; @: Lmx roles; @: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(arena, roles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        return: 0
return: n

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: arena
    @: Lmx roles 0
    @: Lmx m 0
    @: Lmx add_e 0
    @: Lmx arg_e 0
    @: Lmx lit_e 0
    @@: void refs 0
    int: x_value 5
    int: result 0
    @: void out 0
    int: st
    int: failures
    if: counts = 0
        return: 2
    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        fputs("lmx: arena open failed\n", l1_stdout())
        free(counts)
        return: 2
    ---
    roles: lmx_walk_roles_open(@ arena)
    gc_check(counts, roles != 0, "roles opened")
    lmx_walk_program_bind(roles)

    # M(x) = x + 1: one body step, RET (ARG 0 + LIT 1).
    m: lmx_node_new_owned(@ arena)
    gc_check(counts, m != 0 && lmx_arena_refs_open_owned(@ arena, m, 1U) = 0, "M opened, one body slot")
    add_e: gc_fr(@ arena, roles, m, 0U, c.LMX_WALK_OP_RET, 2U)
    gc_check(counts, add_e != 0, "RET frame")
    add_e: gc_fr(@ arena, roles, add_e, 1U, c.LMX_WALK_OP_ADD, 3U)
    gc_check(counts, add_e != 0, "ADD frame under RET")
    arg_e: gc_fr(@ arena, roles, add_e, 1U, c.LMX_WALK_OP_ARG, 2U)
    gc_check(counts, arg_e != 0 && lmx_walk_store_size(@ arena, arg_e, 1U, 0U) = c.LMX_WALK_OK, "ARG 0 operand")
    lit_e: gc_fr(@ arena, roles, add_e, 2U, c.LMX_WALK_OP_LIT, 2U)
    gc_check(counts, lit_e != 0 && lmx_walk_store_int(@ arena, lit_e, 1U, 1) = c.LMX_WALK_OK, "LIT 1 operand")

    # A native/prim-ABI caller's own reference array: refs[0] is the live x argument,
    # exactly the shape lmx_walk_call's own inputs loop builds -- an unclassified raw
    # int, read back the same way any own-field's caller-supplied value is (D-53's own
    # kind = NONE door).
    refs: (cast: (@@: void) calloc(1U, c.sizeof(@: void)))
    gc_check(counts, refs != 0, "refs array allocated")
    refs[0]: (cast: (@: void) (@ x_value))
    st: lmx_call_prim(@ arena, m, m, refs, 1U, (cast: (@: void) (@ result)), @ out)
    gc_check(counts, st = 0, "lmx_call_prim carried a real argument to a walked callee (mutant: old nullary hook -> abort, RED)")
    gc_check(counts, result = 6, "M(5) = 5 + 1 = 6, the argument actually reached the body")
    gc_check(counts, out = (cast: (@: void) (@ result)), "the value came back through dest/out, the native path's own contract")

    # A second call with a different x proves the argument is read live, not baked in.
    x_value: 41
    result: 0
    out: 0
    st: lmx_call_prim(@ arena, m, m, refs, 1U, (cast: (@: void) (@ result)), @ out)
    gc_check(counts, st = 0 && result = 42, "M(41) = 42, same body, a different live argument")

    failures: counts[1]
    c.printf("lmx_call_gcall_selftest: %d checks, %d failed\n", counts[0], failures)
    free((cast: (@: void) refs))
    free(counts)
    lmx_arena_release(@ arena)
    if: failures != 0
        return: 1
return: 0
