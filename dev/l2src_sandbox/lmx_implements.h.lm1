include: "<stddef.h>"
predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_arena.h.lm1"

# Operation-local DFS bookkeeping, never a graph value or a completed admission.
struct: LmxImplementsFrame
    @: Lmx varA
    @: Lmx varB
    @: Lmx consumer
    @: LmxImplEntry viewA
    @: LmxImplEntry viewB
    size_t: index
    # Where this frame's level starts in the instruction's coverage (LmxImplUses),
    # or 0: every field of the consumer at this frame is walked.
    size_t: level
    @: LmxImplementsFrame caller
    @: LmxImplementsFrame seen_next
end: LmxImplementsFrame

# The coverage of ONE receiving instruction: what the Consumer of the place it
# binds reads through that place. Non-owning and read only while the instruction
# runs: the translator's static cells (map), or the size cells of the walked
# instruction itself (frame, at). No Structure is made for it and it is never
# kept with a correspondence: another instruction brings its own.
#
# The cells are levels packed flat. Cell 0 is the count of cells; the root level
# starts at cell 1. A level is [count, then count pairs (edge, below)]:
#   edge  -- a field of the model at that level, in that model's own index space:
#            j < width is field j through its ORDINAL half (an explicit `[N]name`
#            use), width + j the LAST half of field j (a bare `name` use) -- the
#            numbering of lmx_implements_slot (K01);
#   below -- 0: the field is consumed and nothing below it (a number, or a
#            reference that is held and not entered); SIZE_MAX: everything below
#            it is consumed, the full interface from there; otherwise the cell
#            where the nested level starts, in the nested model's index space.
# A root level of count 0 is a Consumer that reads no field: the identity of the
# reference is all it consumes.
struct: LmxImplUses
    @: size_t map
    @: Lmx frame
    size_t: at
end: LmxImplUses

# The object domains this level knows, and the compatibility primitive
# `implements(varA, varB, Consumer)`.
#
# Spec 2.1 defines `implements(varA varB Consumer)` as an L2 construct: "iff every
# path in uses(Consumer varB) is present on varA, and every primitive leaf of those
# paths is admitted as in 2.2.3, and at every callable path p actually invoked by
# Consumer: sig(varA.p) == sig(varB.p) == ExpectedSig(Consumer, p)".  That is a
# source-level check over a Consumer's known used paths -- L2's business.
#
# L1 is the level BETWEEN L2 and C.  What lives here is not that predicate: it is
# the primitive L2's implements will be emitted onto.  Today it answers the first
# question 2.1 needs answered -- "are these two the same kind of thing at all" --
# and it answers it the way everything else in this kernel answers "what is this":
# by the registered address range a value falls into.  Nothing is stored on either
# operand to say what it is; a child carries no type tag (lmx.h, spec 2, 6.5).
#
# The Consumer argument is part of the signature and is reserved: the path walk,
# the leaf admission and the signature comparison of 2.1 are later stages and will
# be emitted by L2.  This stage does not read it, and does not pretend to.
#
# The arena of the Message is the context of every question here, so it is named
# explicitly on every call: the index that answers "what is this address" belongs to
# the arena (lmx_arena.h.lm1), and there is no second, module-global table to open.
# `lmx_domain_table_init` is gone with it: a caller that needs the questions answered
# opens its own arena with lmx_arena_open.

define: LMX_IMPLEMENTS_NO 0
define: LMX_IMPLEMENTS_YES 1
# The third answer of the RUNTIME predicate: the walk met something it cannot inspect, so it
# certifies neither side (spec 2.1: "Unavailable information is not invented and is not certified
# by success").  A KNOWN mismatch is still NO, and a missing used path is still NO.
define: LMX_IMPLEMENTS_UNKNOWN 2
define: LMX_DOMAIN_REGISTER_OK 0
define: LMX_DOMAIN_REGISTER_FAIL 1

# The object domains, appended after the lmx.h registry (LmxType 0..20 and the two
# bases).  They are declared here rather than in lmx.h because that header and the
# Message record are closed: nothing is added to either.  The numbers are one
# registry -- if the domains are ever moved into lmx.h, these are the values they
# must keep.
define: LMX_DOMAIN_MSG_RECORD 21
define: LMX_DOMAIN_THREAD 22
define: LMX_DOMAIN_POST_LINK 23
define: LMX_DOMAIN_SCHEDULE 24
define: LMX_DOMAIN_MANAGER 25
# A turn's reserved child (lmx_child.h.lm1): the reservation is a mechanism record of the
# parent's arena, so the parent can drop exactly what it reserved without touching any of the
# turn's graph writes.  Appended, like the domains before it.
define: LMX_DOMAIN_RESERVATION 26
# A mailbox record that lives as a cell of the arena (a child's own mailbox does: its queue nodes
# are storage of the child's arena).  Appended, like the domains before it.
define: LMX_DOMAIN_POST 27
# Retired ABI value. Live-child membership is the List held by Thread.children; no record is
# allocated in this domain. Keep the number unavailable so later domain values do not shift.
define: LMX_DOMAIN_RESERVED_28 28
# Reserved domain number of the former arena-backed fixed inbox ring.  The current mailbox uses
# a private movable dynamic array whose backing address never enters the graph or the range
# classifier.  The number remains reserved so later domain values do not change ABI.
define: LMX_DOMAIN_POST_RING 29
# k.4 (2026-09-25): LmxCallable is gone (Lmx.native replaces the child[0] descriptor);
# reserved so later domain values do not change ABI.
define: LMX_DOMAIN_RESERVED_30 30
define: LMX_DOMAIN_OP 31
# A cell of a temporary-frame store (lmx_scratch.h.lm1): pointer-sized storage of an
# execution context, in an arena of its own that is never attached to a Message.  It is a
# domain of its own for the reason POST_RING is: the arena seats cells of one (kind, type)
# in one array by stride, and no other array has this one's meaning.
define: LMX_DOMAIN_SCRATCH 32
# A role record (lmx_plan.h.lm1): a cell that exists only to BE an address.  A node names
# its role by pointing at the shared record of that role; the record's content means
# nothing and is never read.  Pointer-sized, because the arena refuses a zero stride.
define: LMX_DOMAIN_ROLE 33
# A primitive record (lmx_primitive.h.lm1): the physical {fn, physical signature, owner} of one
# admitted primitive -- the insert an interpreted activation needs where only a native entry could
# reach a service (the mailbox's count/take today).  Its content IS read (the fn is called), which
# is exactly why it is NOT seated in LMX_DOMAIN_ROLE above: that domain's documented meaning is
# "content means nothing and is never read", and seating a read record there would be the
# overload every domain in this file is split to avoid.  Appended, like every domain before it.
define: LMX_DOMAIN_PRIMITIVE 34

# The same domains as KINDS -- what lmx_range_classify answers -- appended after
# LmxKind 0..6.  Classification has ONE number space: no two answers share a value.
# LmxKind's later List=21, SOURCE_NAME=22 and SOURCE_SYMBOL=23 sit after these
# (lmx.h.lm1); the next free kind value is 24.
define: LMX_DOMAIN_KIND_MSG_RECORD 7
# Numeric kind 8 remains reserved for ABI stability. Executable Threads use the common
# LMX_DOMAIN_KIND_MSG_RECORD kind and are distinguished by exact LMX_DOMAIN_THREAD type.
define: LMX_DOMAIN_KIND_RESERVED_8 8
define: LMX_DOMAIN_KIND_POST_LINK 9
define: LMX_DOMAIN_KIND_SCHEDULE 10
define: LMX_DOMAIN_KIND_MANAGER 11
define: LMX_DOMAIN_KIND_RESERVATION 12
define: LMX_DOMAIN_KIND_POST 13
define: LMX_DOMAIN_KIND_RESERVED_14 14
define: LMX_DOMAIN_KIND_POST_RING 15
# k.4 (2026-09-25): the LmxCallable descriptor type is gone (Lmx.native replaces the
# child[0] descriptor entirely).  The domain NUMBER stays defined, but nothing reads it
# (measured 2026-09-27, steps/copier-q42.md): the copier's shared-method test it once served
# is gone (Q44 -- a method occurrence is copied like any Structure).  Retiring the number is
# a separate change.
define: LMX_DOMAIN_KIND_CALLABLE 16
define: LMX_DOMAIN_KIND_OP 17
define: LMX_DOMAIN_KIND_SCRATCH 18
define: LMX_DOMAIN_KIND_ROLE 19
define: LMX_DOMAIN_KIND_PRIMITIVE 20

prototype:
    # Register one whole domain of the arena's index: count cells of `stride`.
    fn: lmx_domain_register (@: LmxArena arena; @: LmxPool pool; @: LmxChunk chunk; @: void lo; size_t: count; size_t: stride; int: kind; int: type) int
    fn: lmx_domain_kind (@: LmxArena arena; @: void p) int
    fn: lmx_domain_type (@: LmxArena arena; @: void p) int
    fn: lmx_domain_known (@: LmxArena arena; @: void p) int
    fn: lmx_implements (@: LmxArena arena; @: void varA; @: void varB; @: void consumer) int
    # The runtime predicate of 2.1: walk the used tree the Consumer IS (its shape gives the used
    # paths -- "the used tree is the contract", and names are absent from ordinary execution, so a
    # path is an index path), and answer over what is AVAILABLE:
    #   every used path present on varA and varB, every leaf of the same domain and type.  A
    #   callable's signature (args/return) is ordinary lexical Structure fields (k.4), so the
    #   same recursion covers it with no separate comparison.
    # An unset child of the Consumer is not a used path ("An empty `uses` is true: there is
    # nothing to use"), a missing path or a known mismatch is NO, and anything the walk cannot
    # inspect is UNKNOWN -- never YES.
    fn: lmx_runtime_implements (@: LmxArena arena; @: Lmx varA; @: Lmx varB; @: Lmx consumer) int
    # The depth-first used-graph walk keeps operation-local visited triples and frames;
    # neither graph depth nor a reference cycle is an admission refusal. A callable's
    # signature is ordinary lexical Structure fields, checked by this same traversal.
    fn: lmx_implements_walk (@: LmxArena arena; @: Lmx varA; @: Lmx varB; @: Lmx consumer) int
    # The common operation walk: pending is not a completed admission. skip_unused is set only
    # for through(), whose correspondence already proves SIZE_MAX fields unused; the runtime
    # used-tree predicate instead requires every non-null Consumer child, including mapped ones.
    fn: lmx_implements_walk_view (@: LmxArena arena; @: Lmx varA; @: Lmx varB; @: Lmx consumer; @: LmxImplEntry pending; int: skip_unused) int
    # Full declaration reception projects out OP-headed source applications, not
    # missing fields. The explicit physical Consumer predicate above is unchanged.
    fn: lmx_implements_receiver_view (@: LmxArena arena; @: Lmx varA; @: Lmx varB; @: Lmx model; @: LmxImplEntry pending) int
    # Reception by the current Consumer's coverage: the model stays the index
    # space, and only the fields this instruction's coverage names are required --
    # a field it does not name is neither required nor compared, present or not.
    # A null coverage is unknown coverage, which is the full reception above and
    # never an empty one. The answer is this instruction's alone: nothing of it is
    # kept with the pair, whose record holds physical places only.
    # UNKNOWN on a coverage that cannot be read.
    fn: lmx_implements_receiving_use (@: LmxArena arena; @: Lmx varA; @: Lmx varB; @: Lmx model; @: LmxImplEntry pending; @: LmxImplUses uses) int
    # Cell k of a coverage. 0 and *out, or 1: no such cell, or a cell that is no size.
    fn: lmx_implements_use_cell (@: LmxArena arena; @: LmxImplUses uses; size_t: k; @: size_t out) int
    fn: lmx_implements_view (@: LmxArena arena; @: Lmx value; @: Lmx req; @: LmxImplEntry pending) @: LmxImplEntry
    # D-105 (the author's Q39, 2026-09-27): the `implements` table of address correspondences
    # (LmxArena.impl, LmxImplEntry).  A value admitted to a named Structure `req` it is not an
    # instance of carries a view of its correspondence -- slot j is the value's slot of req's field j,
    # matched by name when the program was translated: the admitting walk frame's own size cells, or
    # the translator's static map. An absent explicit map is positional identity,
    # not evidence that layout=req; holes may describe a capture's physical slots.
    # No Structure is made for a correspondence.
    # Register: the first admission is the heavy one -- each field of req is checked through the
    # table (present, same domain and type, a Structure field by the ordinary walk) -- and later
    # ones find the record. A caller must separately establish the current
    # Consumer requirement; this table never caches approval for every Consumer.
    # YES: recorded, now or before with the same correspondence; NO: a
    # field does not match through it, or the value already answers req through another one;
    # UNKNOWN: no room, or nothing to inspect.
    fn: lmx_implements_register (@: LmxArena arena; @: Lmx value; @: Lmx req; @: LmxImplEntry view) int
    fn: lmx_implements_register_map (@: LmxArena arena; @: Lmx value; @: Lmx req; @: size_t map; size_t: n; @: void layout) int
    # Opaque non-owning module schema token from this value's completed
    # admissions, never inferred from req/map. No map or Consumer proof transfers.
    fn: lmx_implements_layout (@: LmxArena arena; @: Lmx value) @: void
    fn: lmx_implements_find (@: LmxArena arena; @: Lmx value; @: Lmx req) @: LmxImplEntry
    # The value's slot for EDGE j through its record (K01): j < width is req's field j through
    # the ordinal half, width <= j < 2*width the LAST half of field j - width (a bare name).
    # 0 and *out, or 1 when the value has no record for req -- a value that reached a place of
    # type req unadmitted is an invariant break, never a read of slot j.
    fn: lmx_implements_slot (@: LmxArena arena; @: Lmx value; @: Lmx req; size_t: j; @: size_t out) int
    # A view's slot SIZE_MAX is "not carried": the value holds no such field -- a capture's copy of the
    # fields its model reads (item 738), or a value admitted by name to a formal whose method never reads
    # that field (D-105 native, admission by the consumer's uses).  The heavy check skips it; a read
    # through it is refused.  Invariant: a view with such slots is made only where the translator
    # proved no read reaches them -- a capture's fields (steps/capture-738.md) and a formal's uses,
    # checked for every type that reaches it (steps/d105-native.md).
    fn: lmx_implements_through (@: LmxArena arena; @: Lmx value; @: Lmx req; @: LmxImplEntry view) int
    fn: lmx_implements_same_map (@: LmxArena arena; @: LmxImplEntry a; @: LmxImplEntry b; size_t: width) int
    fn: lmx_implements_is_map (@: LmxArena arena; @: LmxImplEntry e; @: size_t map; size_t: width) int
    # The two halves of a view's correspondence, one cell pair per required field: at is the
    # ORDINAL half (the value's field named as req's field j, at its own occurrence), at_last the
    # half a bare name reads.  An entry with neither frame nor map is positional identity: both
    # halves are slot j.
    fn: lmx_implements_at (@: LmxArena arena; @: LmxImplEntry e; size_t: j; @: size_t out) int
    fn: lmx_implements_at_last (@: LmxArena arena; @: LmxImplEntry e; size_t: j; @: size_t out) int
end: prototype
