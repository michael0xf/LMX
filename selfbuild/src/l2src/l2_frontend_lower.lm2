            if: lm_compiler_emit_path_resolved(l2_ppath, mi, ind, stmt, @ l2_pkind, 0, 0) != 0
                c.lm_compiler_path_release(l2_ppath)
                return: (cast: (int) (1))
            ---
            c.lm_compiler_path_release(l2_ppath)
            # The destination is an OWN field, stored into its cell like any
            # other own-field assignment. Nothing here is a new category.
