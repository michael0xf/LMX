            # producer. Inside an actual body, this source child is constructed
            # here and contributes one field regardless of execution effects.
            if: l2_source_global(stmt\as\structure) != 0
                return: 0
            if: l2_rw_inert(stmt\as\structure, into, @ node) != 0 || l2_rw_put(into, slot, node) != 0
                return: 1
            \made: 1
            return: 0
        if: l2_rw_frame(into, "LMX_WALK_OP_IF", 3, @ node) != 0 || l2_rw_source_facet(node, "LMX_WALK_SOURCE_ANONYMOUS") != 0 || l2_rw_lit(node, 1, @ t) != 0 || l2_rw_put(node, 1, t) != 0
            return: 1
        if: l2_rw_enter(stmt, @ bsave) != 0
            return: 1
        if: l2_rw_body(stmt\as\structure, node, 2) != 0
            l2_rw_leave(bsave)
            return: 1
        if: l2_rw_leave(bsave) != 0
            return: 1
        \made: 1
        if: l2_rw_put(into, slot, node) != 0
            return: 1
        return: 0
    if: stmt\kind != c.LM_P0_NODE_FRAME || stmt\as = 0 || stmt\as\frame = 0
        return: l2_rw_refuse(stmt, "this statement")
    h: stmt\as\frame\head
    # The receiver of a factory's result, `@: h f(a)` (l2_mad_declaring): the call, its node put into h's place.
    # Read here, before a head that begins with `@` is taken for a machine source below.
    if: l2_mad_declaring(stmt, l2_rw_mi) != 0
        if: l2_rw_mad_store(stmt, into, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_put(into, slot, node) != 0
            return: 1
        return: 0
    if: l2_text_eq(h, "return")
        if: stmt\as\frame\body != 0 && l2_count_active(stmt\as\frame\body) != 0
            if: l2_rw_mi = l2_e
                return: l2_error(l2_src, stmt, "return with a value at the root")
            # A method keeps its value returns (-193 T4a): [ret, V].
            if: l2_rw_ret(stmt\as\frame\body\first_field, l2_count_active(stmt\as\frame\body), into, @ node) != 0
                return: 1
            \made: 1
            if: l2_rw_put(into, slot, node) != 0
                return: 1
            return: 0
        # A `return` with no value is the step above, for both spellings.
        return: l2_rw_refuse(stmt, "this return")
    if: l2_rw_external_head(h) != 0
        if: l2_rw_machine_application(stmt, into, @ node) != 0 || l2_rw_put(into, slot, node) != 0
            return: 1
        \made: 1
        return: 0
    # An imported C function-pointer or by-value record local is declared in
    # machine activation storage; the same classification as the native
    # emitter's, and its source is retained here.
    if: (l2_fnptr_local(stmt, @ machine_name) = 0 || l2_struct_local(stmt, @ machine_name) = 0) && l2_ml_find(machine_name) >= 0
        if: l2_rw_machine_declaration(stmt, machine_name, into, @ node) != 0 || l2_rw_put(into, slot, node) != 0
            return: 1
        \made: 1
        return: 0
    # K03 NS-ROLES-1b: a binding `b: tick` writes tick's occurrence into b's cell -- the callable actual's resolution
    # (l2_rw_callable_actual), as a callable formal receives it; tick runs not.
    if: l2_rb_meth_of(stmt) >= 0
        oi: l2_own_ref_decl(stmt, l2_rw_mi)
        if: oi < 0
            return: l2_error(l2_src, stmt, "internal: a reference binding to a method has no cell")
        if: l2_rw_write(into, oi, l2_rw_bind_op(oi), @ node, @ k) != 0 || l2_rw_callable_actual(l2_next_active(stmt\as\frame\body\first_field), 1, node, @ t) != 0 || l2_rw_put(node, k, t) != 0
            return: 1
        \made: 1
        if: l2_rw_put(into, slot, node) != 0
            return: 1
        return: 0
    # A reached reference declaration writes its admitted candidate (default
