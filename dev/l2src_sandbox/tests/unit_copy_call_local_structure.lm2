# A valid program: a method defines a Structure, copies it and calls the copy.
# OPEN positive: a copy whose source is a method's own Structure row has no
# proved contract yet. Entry 7.
fn: g () int
    A:
        int: last 0
        last: 17
    x: merge A
    x
    return: x\last
int: k g()
int: result 81
if: k = 17
    result: 7
sendMessage: exit(exit_code: result; stdout: ""; stderr: "")
return
