---
    Observed:
        int: seen 12
    end: Observed
---
sub: main ((S (int a 1) (int b 2)))
    @: shared (node [] 0)
    fn: f (int: a; (required (int b))) int
        return: ((a * 10) + b)
    end: f
    fn: f (int: a; (required (int b) (required (int c)))) int
        return: (((a * 100) + (b * 10)) + c)
    end: f
    :=: ((shared \ Observed) \ seen) (f S)
end: main
main:
