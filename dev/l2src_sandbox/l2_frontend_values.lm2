fn: lm_compiler_emit_call_result_value (int: mi; int: idx; int: t; const: (@: ind char); int: context) int
    @@: out_cell c.FILE (cast: (@@: c.FILE) (@ c.l2_out))
    @@: m_ret_cell int (cast: (@@: int) (@ c.l2_m_ret))
    int: prty
    # One activation-local output,declared before any callable-class arm.
    if: context >= 0 && c.fprintf(out_cell[0], "%sLmxWalkValue: l2_cv%d\n%slmx_walk_value_clear(@ l2_cv%d)\n", ind, context, ind, context) < 0
        return: (cast: (int) (1))
    # A named-Structure return holds the graph code, spelled `Lmx *` (l2_formal_raw), as l2_emit_formal/l2_emit_sig
    # spell it -- a discarded or captured call to a Structure-returning method must not reach l2_emit_foreign_temp
    # with a code of another space (FABLE-SONNET-DECL-PREPASS-20260923-137 part 2).
    prty: lm_compiler_formal_raw(m_ret_cell[0][idx])
    if: prty = 1 && c.fprintf(out_cell[0], "%schar: l2_t%d\n", ind, t) < 0
        return: (cast: (int) (1))
    if: prty = 2 && c.fprintf(out_cell[0], "%ssize_t: l2_t%d\n", ind, t) < 0
        return: (cast: (int) (1))
    if: prty = 33 && c.fprintf(out_cell[0], "%sunsigned: l2_t%d\n", ind, t) < 0
        return: (cast: (int) (1))
    if: prty = 36 && c.fprintf(out_cell[0], "%sulong: l2_t%d\n", ind, t) < 0
        return: (cast: (int) (1))
    if: prty = 3 && c.fprintf(out_cell[0], "%s@: char l2_t%d\n", ind, t) < 0
        return: (cast: (int) (1))
    if: prty = 16 && c.fprintf(out_cell[0], "%s@: void l2_t%d\n", ind, t) < 0
        return: (cast: (int) (1))
    if: prty = 35 && c.fprintf(out_cell[0], "%sconst: @(char l2_t%d)\n", ind, t) < 0
        return: (cast: (int) (1))
    if: prty = 32 && c.fprintf(out_cell[0], "%s@@: char l2_t%d\n", ind, t) < 0
        return: (cast: (int) (1))
    if: prty >= 100 && lm_compiler_emit_foreign_temp(out_cell[0], prty, ind, t) != 0
        return: (cast: (int) (1))
    if: lm_compiler_ret_uns(idx) = 0 && prty != 1 && prty != 3 && prty != 8 && prty != 16 && prty != 32 && prty != 35 && prty < 100 && c.fprintf(out_cell[0], "%sint: l2_t%d\n", ind, t) < 0
        return: (cast: (int) (1))
    if: lm_compiler_call_status(mi, idx) != 0 && c.fprintf(out_cell[0], "%sint: l2_ts%d 0\n%s@: Lmx l2_te%d 0\n", ind, t, ind, t) < 0
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: lm_compiler_emit_call_result_value

