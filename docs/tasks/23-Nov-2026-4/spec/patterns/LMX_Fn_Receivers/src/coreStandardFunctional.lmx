# FINITE STANDARD COLLECTION OPERATIONS.
# Ordinary LMX, using the existing Array/typed-record/call contracts only.
# Returned outer Arrays are fresh; reference-valued elements retain targets.
# adjoin returns the original Array when its value is already present.
# Callbacks must not mutate source slots/length while traversal is active.
# Callback failures use the existing FxCallFailure contract. collect accepts
# the producer's Stop as exhaustion and retains other failures in that envelope.

FxStdPair:
    private:
        @: first
        @: second
    required: first second
    return: @
    make:
        private: @: pair (copy(FxPair))
        pair\first := first
        pair\second := second
        return: pair

FxStdCutIndex:
    private:
        @: items
        int: count
    required: items count
    return: int
    get:
        throws: copy(FxThrows\kernel)
        FxSeqInfo\get(items)
        if: count < 0
            return: 0
        if: count > length(items)
            return: length(items)
        return: count

FxStdCut:
    private:
        @: items
        int: count
    required: items count
    return: @
    take:
        throws: copy(FxThrows\sequence)
        return: FxSeqSlice\slice(items; 0; FxStdCutIndex\get(items; count))
    drop:
        throws: copy(FxThrows\sequence)
        return: FxSeqSlice\slice(items; FxStdCutIndex\get(items; count); length(items))
    splitAt:
        throws: copy(FxThrows\sequence)
        return: FxStdPair\make(take(items; count); drop(items; count))

# One ordered prefix scan; the first rejected item is tested exactly once.
FxStdPrefixIndex:
    private:
        @: items
        @: accepts
    required: items accepts
    return: int
    get:
        throws: copy(FxThrows\predicate)
        FxSeqInfo\get(items)
        private: int: i 0
        while: i < length(items)
            private: @: value FxSeqRead\read(items; i)
            private: @: flag FxApply\apply(accepts; FxOne\make(value))
            if: FxSeqPredicate\truth(flag) = 0
                break
            i += 1
        return: i

FxStdPrefix:
    private:
        @: items
        @: accepts
    required: items accepts
    return: @
    takeWhile:
        throws: copy(FxThrows\predicate) SequenceSize
        return: FxStdCut\take(items; FxStdPrefixIndex\get(items; accepts))
    dropWhile:
        throws: copy(FxThrows\predicate) SequenceSize
        return: FxStdCut\drop(items; FxStdPrefixIndex\get(items; accepts))
    span:
        throws: copy(FxThrows\predicate) SequenceSize
        return: FxStdCut\splitAt(items; FxStdPrefixIndex\get(items; accepts))

FxStdPartition:
    private:
        @: items
        @: accepts
    required: items accepts
    return: @
    partition:
        throws: copy(FxThrows\sequencefixture)
        private: @: yes FxSeqEmpty\make(items)
        private: @: no FxSeqEmpty\make(items)
        private: int: i 0
        while: i < length(items)
            private: @: value FxSeqRead\read(items; i)
            private: @: flag FxApply\apply(accepts; FxOne\make(value))
            private: @: selected no
            if: FxSeqPredicate\truth(flag) != 0
                selected := yes
            FxSeqPush\append(selected; value)
            i += 1
        return: FxStdPair\make(yes; no)

FxStdEnumerate:
    private:
        @: items
        int: start 0
    required: items
    return: @
    enumerate:
        throws: copy(FxThrows\sequencefixture)
        FxSeqInfo\get(items)
        private: @: out FxSeqAllocate\make(@[]; length(items))
        private: bigint: cursor start
        private: int: i 0
        while: i < length(items)
            # Ordinary checked numeric admission; never wrap an int index.
            private: int: index cursor
            out[i] := FxStdPair\make((index FxRecordOperands\record); FxSeqRead\read(items; i))
            i += 1
            if: i < length(items)
                cursor += 1
        ---
        return: out

# Shared slicer: full windows by default; partial permits one final short
# window. Once a produced window reaches the end, no redundant suffix follows.
FxStdWindows:
    private:
        @: items
        int: width 2
        int: step 1
        int: partial 0
    required: items
    return: @
    windows:
        throws: copy(FxThrows\mutation) SequenceStep
        FxSeqInfo\get(items)
        if: width <= 0 || step <= 0
            throw: SequenceStep()
        private: @: out FxSeqAllocate\make(@[]; 0)
        private: int: at 0
        while: at < length(items)
            private: int: remaining length(items) - at
            private: int: count width
            if: count > remaining
                if: partial = 0
                    break
                count := remaining
            private: @: part FxSeqSlice\slice(items; at; at + count)
            FxSeqPush\append(out; part)
            if: count = remaining || step >= remaining
                break
            at += step
        return: out

FxStdChunks:
    private:
        @: items
        int: size
        int: strict 0
    required: items size
    return: @
    chunks:
        throws: copy(FxThrows\mutation) SequenceStep FxShape
        FxSeqInfo\get(items)
        if: size <= 0
            throw: SequenceStep()
        if: strict != 0 && length(items) % size != 0
            throw: FxShape()
        return: FxStdWindows\windows(items; size; size; 1)

FxStdIntersperse:
    private:
        @: items
        @: separator
    required: items separator
    return: @
    intersperse:
        throws: copy(FxThrows\mutation)
        private: @: info FxSeqInfo\get(items)
        private: int: count length(items)
        private: @: out FxSeqAllocate\make(info\arrayType; 0)
        if: count = 0
            return: out
        if: count = 1
            return: FxSeqSlice\slice(items; 0; 1)
        private: int: total FxSeqSize\sum(count; count - 1; info\maxLength)
        private: @: ready FxSeqAdmit\admit(out; separator)
        sys\resize(out; total)
        private: int: i 0
        private: int: at 0
        while: i < count
            if: i != 0
                FxKernel\arrayWrite(target := out; index := at; value := ready)
                at += 1
            FxKernel\arrayWrite(target := out; index := at; value := FxSeqRead\read(items; i))
            at += 1
            i += 1
        return: out

FxStdJoin:
    private:
        @: parts
        @: separator
    required: parts separator
    return: @
    join:
        throws: copy(FxThrows\mutation)
        FxSeqInfo\get(parts)
        FxSeqInfo\get(separator)
        if: length(parts) = 0
            return: FxSeqEmpty\make(separator)
        return: FxSeqConcat\concat(FxStdIntersperse\intersperse(FxSeqRecords\make(parts); separator))

# Pair protocol is exactly FxZip's first/second typed-record fields.
FxStdUnzip:
    private: @: pairs
    required: pairs
    return: @
    unzip:
        throws: copy(FxThrows\sequence)
        FxSeqInfo\get(pairs)
        private: @: first FxSeqAllocate\make(@[]; length(pairs))
        private: @: second FxSeqAllocate\make(@[]; length(pairs))
        private: int: i 0
        while: i < length(pairs)
            private: FxPair@: pair FxSeqRead\read(pairs; i)
            first[i] := pair\first
            second[i] := pair\second
            i += 1
        return: FxStdPair\make(first; second)

# Strict finite right folds: callback order is right-to-left. Reuse the
# existing fold/scan engine; flipping affects the two explicit argument slots.
FxStdRightFold:
    private:
        @: items
        @: seed
        @: step
    required: items seed step
    return: @
    foldr:
        throws: copy(FxThrows\sequencefixture)
        return: FxFold\fold(FxSeqReverse\reverse(items); seed; FxFlip\flip(step))
    scanr:
        throws: copy(FxThrows\sequencefixture)
        return: FxSeqReverse\reverse(FxScan\scan(FxSeqReverse\reverse(items); seed; FxFlip\flip(step)))

# All Maybe-mapping policies share this loop. The existing call bridge
# returns a compound result directly as its real typed value reference.
# No extra @ layer is invented or unconditionally dereferenced.
FxStdMaybeMapEngine:
    private:
        @: items
        @: transform
        int: stopOnNone
        int: firstOnly
    required: items transform stopOnNone firstOnly
    return: @
    run:
        throws: copy(FxThrows\traversal) SequenceElement
        FxSeqInfo\get(items)
        private: @: out FxSeqAllocate\make(@[]; 0)
        private: int: i 0
        while: i < length(items)
            private: @: packed FxApply\apply(transform; FxOne\make(FxSeqRead\read(items; i)))
            private: FxMaybe@: answer packed
            if: answer\present != 0
                if: firstOnly != 0
                    return: answer
                FxSeqPush\append(out; answer\value)
            else:
                if: stopOnNone != 0
                    break
            ---
            i += 1
        if: firstOnly != 0
            return: FxNone\none()
        return: out

FxStdMaybeMap:
    private:
        @: items
        @: transform
    required: items transform
    return: @
    filterMap:
        throws: copy(FxThrows\traversal) SequenceElement
        return: FxStdMaybeMapEngine\run(items; transform; 0; 0)
    mapWhile:
        throws: copy(FxThrows\traversal) SequenceElement
        return: FxStdMaybeMapEngine\run(items; transform; 1; 0)
    findMap:
        throws: copy(FxThrows\traversal) SequenceElement
        return: FxStdMaybeMapEngine\run(items; transform; 0; 1)

# Stateful map: the callback returns FxPair(next-state record, output record).
# Both directions share one loop and write outputs at the original positions.
FxStdMapAccumEngine:
    private:
        @: items
        @: seed
        @: step
        int: fromRight
    required: items seed step fromRight
    return: @
    run:
        throws: copy(FxThrows\traversal)
        FxSeqInfo\get(items)
        private: int: count length(items)
        private: @: out FxSeqAllocate\make(@[]; count)
        private: @: accumulator seed
        private: int: i 0
        while: i < count
            private: int: at i
            if: fromRight != 0
                at := count - 1 - i
            private: @: packed FxApply\apply(step; FxTwo\make(accumulator; FxSeqRead\read(items; at)))
            private: FxPair@: answer packed
            accumulator := answer\first
            out[at] := answer\second
            i += 1
        return: FxStdPair\make(accumulator; out)

FxStdMapAccum:
    private:
        @: items
        @: seed
        @: step
    required: items seed step
    return: @
    mapAccumL:
        throws: copy(FxThrows\traversal)
        return: FxStdMapAccumEngine\run(items; seed; step; 0)
    mapAccumR:
        throws: copy(FxThrows\traversal)
        return: FxStdMapAccumEngine\run(items; seed; step; 1)

# Consecutive groups are different from global FxGroupBy buckets. keyOf runs
# exactly once per item; sameKey compares each adjacent key pair once.
FxStdGroupAdjacent:
    private:
        @: items
        @: keyOf 0
        @: sameKey 0
    required: items
    return: @
    groupAdjacent:
        throws: copy(FxThrows\sequencefixture)
        FxSeqInfo\get(items)
        private: @: out FxSeqAllocate\make(@[]; 0)
        private: @: previous 0
        private: @: group 0
        private: int: begin 0
        private: int: i 0
        while: i < length(items)
            private: @: key FxProjectValue\get(FxSeqRead\read(items; i); keyOf)
            private: int: starts i = 0
            if: starts = 0
                starts := FxValueSame\test(previous; key; sameKey) = 0
            if: starts != 0
                if: i != 0
                    group\items := FxSeqSlice\slice(items; begin; i)
                group := (copy(FxGroup))
                group\key := key
                FxSeqPush\append(out; group)
                begin := i
            previous := key
            i += 1
        if: i != 0
            group\items := FxSeqSlice\slice(items; begin; i)
        return: out

FxStdReplicate:
    private:
        @: value
        int: count
    required: value count
    return: @
    replicate:
        throws: FxKernelFailure FxTypeToken SequenceSize
        private: int: size count
        if: size < 0
            size := 0
        private: @: out FxSeqAllocate\make(@[]; size)
        private: int: i 0
        while: i < size
            out[i] := value
            i += 1
        return: out

FxStdCycle:
    private:
        @: items
        int: count
        int: rejectNegative 0
    required: items count
    return: @
    cycle:
        throws: copy(FxThrows\sequence)
        if: rejectNegative != 0 && count < 0
            throw: SequenceSize()
        private: @: info FxSeqInfo\get(items)
        if: count <= 0 || length(items) = 0
            return: FxSeqEmpty\make(items)
        if: count > info\maxLength / length(items)
            throw: SequenceSize()
        return: FxSeqConcat\concat(FxStdReplicate\replicate(items; count))

FxStdStarMap:
    private:
        @: rows
        @: operation
    required: rows operation
    return: @
    starmap:
        throws: copy(FxThrows\traversal)
        FxSeqInfo\get(rows)
        private: @: out FxSeqAllocate\make(@[]; length(rows))
        private: int: i 0
        while: i < length(rows)
            private: @: row FxSeqRead\read(rows; i)
            out[i] := FxApply\apply(operation; FxSeqRecords\make(row))
            i += 1
        return: out

FxStdZipLongest:
    private:
        @: first
        @: second
        @: fill
    required: first second fill
    return: @
    zipLongest:
        throws: copy(FxThrows\sequence)
        FxSeqInfo\get(first)
        FxSeqInfo\get(second)
        private: int: count length(first)
        if: length(second) > count
            count := length(second)
        private: @: out FxSeqAllocate\make(@[]; count)
        private: int: i 0
        while: i < count
            private: @: a fill
            private: @: b fill
            if: i < length(first)
                a := FxSeqRead\read(first; i)
            if: i < length(second)
                b := FxSeqRead\read(second; i)
            out[i] := FxStdPair\make(a; b)
            i += 1
        return: out

# Nullary producer, finite prefix or termination by its declared Stop().
# The ordinary call bridge returns the real typed value record. Only that
# producer outcome is inspected; append failures are never exhaustion.
FxStdCollect:
    private:
        @: next
        int: limit -1
    required: next
    return: @
    collect:
        throws: copy(FxThrows\mutation) FxCallFailure
        if: limit < -1
            throw: SequenceSize()
        private: @: out FxSeqAllocate\make(@[]; 0)
        while: limit = -1 || length(out) < limit
            private: @: outcome FxTry\attempt(next; ())
            if: outcome\ok = 0
                if: FxEqualFields\equalFields(outcome\failure; sys\name(Stop)) != 0
                    return: out
                throw: FxCallFailure(outcome)
            FxSeqPush\append(out; outcome\value)
        return: out

# Membership and sets use an explicit pure equivalence predicate. There is
# no implicit hashing, ordering, numeric coercion or graph deep comparison.
FxStdMembership:
    private:
        @: items
        @: value
        @: same 0
    required: items value
    return: int
    includes:
        throws: copy(FxThrows\predicate) FxShape
        return: FxKeyIndex\find(items; value; same) >= 0

FxStdAdjoin:
    private:
        @: items
        @: value
        @: same 0
    required: items value 
    return: @
    adjoin:
        throws: copy(FxThrows\sequencefixture)
        if: FxStdMembership\includes(items; value; same) != 0
            return: items
        private: @: out FxSeqSlice\slice(items; 0; length(items))
        FxSeqInsert\insert(out; 0; FxOne\make(value))
        return: out

FxStdSetSelect:
    private:
        @: items
        @: other
        @: same 0
        int: keepPresent
    required: items other  keepPresent
    return: @
    select:
        throws: copy(FxThrows\sequencefixture)
        FxSeqInfo\get(other)
        private: @: values FxUnique\unique(items; same)
        private: @: out FxSeqEmpty\make(items)
        private: int: i 0
        while: i < length(values)
            private: @: value FxSeqRead\read(values; i)
            if: FxStdMembership\includes(other; value; same) = keepPresent
                FxSeqPush\append(out; value)
            i += 1
        return: out

FxStdSets:
    private:
        @: first
        @: second
        @: same 0
    required: first second 
    return: @
    union:
        throws: copy(FxThrows\sequencefixture)
        return: FxUnique\unique(FxSeqConcat\concat((first; second)); same)
    intersection:
        throws: copy(FxThrows\sequencefixture)
        return: FxStdSetSelect\select(first; second; same; 1)
    difference:
        throws: copy(FxThrows\sequencefixture)
        return: FxStdSetSelect\select(first; second; same; 0)
    symmetricDifference:
        throws: copy(FxThrows\sequencefixture)
        return: FxSeqConcat\concat((difference(first; second; same); difference(second; first; same)))

FxStdSubset:
    private:
        @: first
        @: second
        @: same 0
    required: first second 
    return: int
    isSubset:
        throws: copy(FxThrows\sequencefixture)
        private: @: missing FxStdSets\difference(first; second; same)
        return: length(missing) = 0
