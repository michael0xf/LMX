Pricing:
    int: amount
    @: operation twice
    return: int
    twice:
        return: amount * 2
    thrice:
        return: amount * 3
    apply:
        return: operation()
    demo:
        @: operation thrice
        int: ordinary apply(4)
        int: explicit apply(4; operation)
        int: ordinary_again apply(4)
        return: ordinary * 100 + explicit * 10 + ordinary_again
