predef: "l2src/lmx_perm.h.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
# The closure must be COMPLETE, or Resolve-Link pulls a unit object that defines the same
# symbols this one already does (lmx_child_selftest.lm1 says the same).  lmx_child.lm1 brings
# lmx_child_thread with it, so the Thread side is part of this closure even though no check
# below takes a turn.
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# lmx_perm_child_selftest.lm1 -- a child created from a STORE-BOUND source, and what releasing
# the pieces afterwards is allowed to do (LMX-ETERNAL-R0-44D).
#
# Why this file exists.  Two properties met for the first time in 44D and no test asked either
# of them directly; both were found the hard way, through lmx_close_chain_selftest.
#
#   CREATION.  lmx_child_create binds the child's arena to the SOURCE's store before it marks
#   anything, so a child of a bound parent is itself bound.  Nothing measured that the bind
#   actually happens, and nothing measured that creation still succeeds when it does.
#
#   RELEASE, in both directions, which is the pair that matters:
#     - releasing the STORE-BOUND CHILD is permitted.  Its `permanent` is 0, so it is an
#       ordinary arena; the link to the store is non-owning, so the release clears its own
#       link and touches nothing of the store's.
#     - releasing the STORE ITSELF through lmx_arena_release is REFUSED.  Process-lifetime
#       storage leaves exactly once, through lmx_perm_close.
#
#   AND THE HOLE THE PAIR LEAVES, which is the real subject of the last two checks: there is no
#   unbind anywhere, and lmx_perm_close cannot walk its binders because a store deliberately
#   does not know them.  So a closed store's address survives in every arena still bound to it.
#   The link is therefore made to answer for itself -- lmx_perm_store_of and the three range
#   observers follow it only while the target still carries the role -- and a still-live child
#   that outlives its runtime's store sees no store rather than a released one.
#
# That last check has been SEEN TO FAIL, which is the only reason to trust it: relinking this
# same object against an lmx_perm unit whose store_of lacks the role test gives 20 checks and
# exactly one failure, the closed-store one, with the other nineteen unchanged.  The three
# range fallbacks are held to the same rule for consistency, but they are NOT measured here:
# a released store answers nothing anyway, because its own index is gone.

sub: pc_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: pc_check

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: store
    LmxArena: src
    LmxArena: kid
    @: Lmx parent 0
    @: Lmx tmpl 0
    @: LmxMsg child 0
    int: failures
    if: counts = 0
        return: 2
    ---
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ src)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ kid)), 0, c.sizeof(c.LmxArena))

    # 1. A store, and a source arena bound to it -- the shape R0 has after lmx_root_open.
    pc_check(counts, lmx_perm_open(@ store) = 0, "the store did not open")
    pc_check(counts, lmx_perm_is_store(@ store) != 0, "the store does not say it is one")
    pc_check(counts, lmx_arena_open(@ src) = 0, "the source arena did not open")
    pc_check(counts, lmx_perm_bind(@ src, @ store) = 0, "the source did not bind to the store")
    pc_check(counts, lmx_perm_store_of(@ src) = (@ store), "the source does not name its store")

    # 2. The parent graph and the template, BOTH in the source arena -- the contract of the copy
    #    is that src_arena is the arena the source lives in, and nothing else answers for it.
    parent: lmx_node_new_owned(@ src)
    tmpl: lmx_node_new_owned(@ src)
    pc_check(counts, parent != 0 && lmx_arena_refs_open_owned(@ src, parent, 1U) = 0, "the parent graph was not built")
    pc_check(counts, tmpl != 0 && lmx_arena_refs_open_owned(@ src, tmpl, 1U) = 0, "the template was not built")
    if: parent = 0 || tmpl = 0
        free(counts)
        return: 2
    ---

    # 3. CREATION from a store-bound source.  This is what 44D made newly possible to get wrong:
    #    the bind happens before the mark, so a failure here is a failure of the bind, not of the
    #    copy -- and lmx_child_reserve would have flattened the difference to a null.
    pc_check(counts, lmx_arena_open(@ kid) = 0, "the child arena did not open")
    child: lmx_child_create(@ src, @ kid, parent, 0U, tmpl)
    pc_check(counts, child != 0, "A CHILD OF A STORE-BOUND SOURCE WAS NOT CREATED")
    pc_check(counts, lmx_perm_store_of(@ kid) = (@ store), "the child arena did not inherit the source's store")

    # 4. RELEASE, both directions.
    pc_check(counts, lmx_arena_release(@ store) != 0, "lmx_arena_release did NOT refuse the store itself")
    pc_check(counts, lmx_perm_is_store(@ store) != 0, "the refused release damaged the store's role")
    pc_check(counts, lmx_arena_release(@ kid) = 0, "RELEASE OF A STORE-BOUND ARENA WAS REFUSED")
    pc_check(counts, lmx_perm_store_of(@ kid) = 0, "the released child kept its link to the store")
    pc_check(counts, lmx_perm_store_of(@ src) = (@ store), "the child's release disturbed the source's bind")
    pc_check(counts, lmx_perm_is_store(@ store) != 0, "the child's release disturbed the store")

    # 5. THE HOLE: close the store while `src` is still bound to it, and ask `src` again.  There
    #    is no unbind and no walk of binders, so src\perm still HOLDS the store's address; the
    #    answer must nevertheless be "no store", because the store no longer carries the role.
    pc_check(counts, lmx_perm_close(@ store) = 0, "the store did not close")
    pc_check(counts, lmx_perm_store_of(@ src) = 0, "A CLOSED STORE IS STILL FOLLOWED BY AN ARENA BOUND TO IT")
    pc_check(counts, lmx_range_classify(@ src, (cast: (@: void) parent)) = c.LMX_KIND_STRUCT, "the source stopped answering for its own cell after the store closed")

    pc_check(counts, lmx_arena_release(@ src) = 0, "the source arena did not release")
    failures: counts[1]
    c.printf("lmx_perm_child checks=%d failures=%d\n", counts[0], failures)
    free(counts)
return: failures
