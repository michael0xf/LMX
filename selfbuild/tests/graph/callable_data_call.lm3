# call with one argument in a callable's code runs that Structure over itself (plan M11 5b; R20: the one-argument call
# is general, with no case of its own for a method's data): Point of the callable's data counts its own n.
# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: seen 0
)
@: shared data[0]
fn: f () int (
    Point(int: n 0; data\n := data\n + 1)
)
    call: Point
    call: Point
    return: Point\n
end: f
int: seen f()

sub: main ()
    shared\Observed\seen := seen
main()
