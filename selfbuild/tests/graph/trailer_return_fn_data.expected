---
    Observed:
        int: seen 8
    end: Observed
---
fn: counter () int (
    int: value 7
)
    :=: (data \ value) ((data \ value) + 1)
    return: (data \ value)
end: counter
int: seen (counter)
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) seen
end: main
main:
