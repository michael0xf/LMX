+fn: l2_rw_primary_value (@: L2ValueSpan value; int: parent; @: int out) int
+    L2ValueSpan: operand
+    int: type
+    int: body
+    int: child
+    int: role l2_primary_role(value, l2_rw_mi)
+    int: n
+    @: L2ValueSpan values
+    if: role = 0
+        return: 2
+    if: role = 3 || role = 5
+        return: l2_rw_machine_values(value, parent, out)
