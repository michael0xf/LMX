+# Whether the unit's predef i names a header source (name.h.lm1). A header holds only such predefs (l1trans refuses a
+# header that predefs a code module), so a machine module's header takes these and the module itself the others.
+fn: l2_pd_is_header (int: i) int
+    const: @(LmP0Text t) 0
+    size_t: n 0U
+    t: l2_pd[i]
+    if: t = 0 || t\data = 0
+        return: 0
+    n: t\length
+    if: n > 0U && t\data[n - 1U] = 34
+        n: n - 1U
+    if: n < 6U
+        return: 0
+return: (cast: (int) (memcmp(t\data + (n - 6U), ".h.lm1", 6U) = 0))
+
