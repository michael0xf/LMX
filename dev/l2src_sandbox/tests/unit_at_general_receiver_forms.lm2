# The outer @ receiver consumes the complete argument model. Name precedes
# requirement and explicit initial value in the flat three-field form;
# a nested primitive receiver is the same general application mechanism.
Model:
    int: v 7
end: Model
@: box Model 0
@: int: p
int: code 81
if: box = 0
    code: 7
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
