# int assigned from size_t. The leaf admits the pair. The assignment
# edge inserts lm_stg_convert_size_t_int from convert.lm2 (kind sign).
# Value 2 fits, so the entry is still 7. Mutant: the cross-leaf success
# stores 0. This file then refuses "assignment value has incompatible type".
# unit_s7_prim_same still translates: same-name returns earlier.

fn: go () int
    int: a 1
    size_t: b 2U
    a: b
    return: a

int: k
k: go()
if: k = 2
    sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
return
