Measurement:
    int: gain
    @: read
    return: int
    sample:
        return: read() * gain
    biased:
        return: sample() + 1
    readsTwice:
        int: discarded read()
        return: sample()

SamplingCheck:
    @: candidate
    int: calls 0
    return: int
    fixedRead:
        node\calls += 1
        return: 7
    check:
        node\calls := 0
        @: read fixedRead
        int: result candidate(gain := 4)
        return: result = 28 && node\calls = 1
