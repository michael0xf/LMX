# FABLE-GROKBOT-INCLUDE-AND-SIZEOF-20260923-123 part1:
# Same shape as unit_p0_with_include but WITHOUT include/predef for p0.
# Translator must NOT silently add p0.lm1.h from the LmP0 prefix.
# l1trans/gcc must refuse (LmP0Text unknown without the unit declaration).
# Mutant: restore LmP0-prefix l2_need_p0 in l2_foreign_intern -> this links again (RED).
fn: len (@: c.LmP0Text t) size_t
return: t\length

fn: p0_without_include () int
    @: c.LmP0Text x
    x: (cast: (@: LmP0Text) c.calloc(1U, c.sizeof(c.LmP0Text)))
    if: x = 0
        return: 1
    x\length: 2U
    if: len(x) != 2U
        c.free(x)
        return: 2
    c.free(x)
    return: 0
end: p0_without_include

return: p0_without_include()
