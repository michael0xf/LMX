# A char field declared in a control body of a method's own named Structure (slice 2c-3): its cell needs the process's
# character table, which only the unit build holds -- not built at S's statement yet.  Refused where it stands.
fn: m () int
    S:
        size_t: v 4U
        if: v = 4U
            char: c 'a'
            v: 5U
        v: v + 0U
    S()
    return: 7
end: m
int: r 0
r: m()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
