# Core helpers extracted from the root comparison examples.
# All state stays in the owning Message. To run an entire loop asynchronously,
# post its owner method; existing post supplies transport, ordering and reply.
# No mutable declaration, callback or namespace is shared across Message arenas.

FxBetween:
    copy: FxPreparedOperands
    const: int: PRIORITY sys\priority("<=")
    return: int
    between:
        throws: RangeArity
        if: length(right) != 2
            throw: RangeArity()
        return: \right[0] <= \left && \left <= \right[1]

# Explicit bridge contract: see CORE_EXAMPLE_HELPERS.md. This is a required
# kernel provider, not an implemented ordinary LMX function hidden in a comment.
FxKernelAttemptAcceptedAPI :: (@: form; return: @)

# The declaration and its body share this receiving execution's live places.
# Only source Stop terminates; a body Stop is preserved as FxCallFailure.
FxIterateUntilStop:
    @: iteration
    @: body
    iterateUntilStop:
        throws: copy(FxThrows\call)
        while: 1
            private: @: step FxKernel\attemptAccepted(iteration)
            if: step\ok = 0
                if: FxEqualFields\equalFields(step\failure; "Stop")
                    break
                throw: FxCallFailure(step)
            private: @: result FxKernel\attemptAccepted(body)
            if: result\ok = 0
                throw: FxCallFailure(result)
