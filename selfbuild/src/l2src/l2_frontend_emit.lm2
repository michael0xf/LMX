            c.fprintf(af, "n=%d free=%d live=%d fail_at=%d fail_kind=%d err=%d\n", alloc_n_cell[0], free_n_cell[0], alloc_live_cell[0], alloc_fail_at_cell[0], alloc_fail_kind_cell[0], alloc_err_cell[0])
