# FACTORY (the author, 2026-10-05): `@: h f(a)` receives a factory's result; this row wrote `h: f a` until then.
# Historical P47 row: a full field-path initializer is one expression.
# The returned callable's local q must contain the captured value, not zero.
# This exercises the existing held/walked callable route, not native attachment.
Model:
    int: other 5
    int: value 7
end: Model

fn: makeCounter (Model: m) fn: (int: x) int
    fn: bump (int: x) int
        int: q m\value
        return: q + x
    return: bump

@: c makeCounter(Model)
int: a (c: 1)
int: b (c: 2)
if: a != 8 || b != 9
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
