predef: "lmx_settle.h.lm1"
predef: "l2src/lmx_child.h.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l2src/lmx_post.h.lm1"

# The readiness predicate: one reading of the two flags, from the settling side (19.29.8:
# "Transfer or reclamation requires the handoff-safe boundary in 19.29.7.1, not merely a stop
# request or elapsed timeout").
fn: lmx_settle_ready (@: LmxMsg message) int
    if: message = 0
        return: 0
    if: message\running != 0
        return: 0
    if: message\handoff_ready != 0
        return: 1
return: 0

# THE CHAIN, IN THE MODEL'S OWN TERMS (Mikhail, 19.09 -- rewritten after the cascade was measured
# wrong twice):
#
#   * a Thread owns its arena, its scheduler and its thread, and works on that thread; nobody frees
#     its storage from another thread while it is still on it;
#   * a STOPPED child has not ended: the stop asks, and the child's own end-turn does the rest;
#   * NOTHING IS FREED WHILE SOMETHING UNDER IT IS ALIVE.
#
# So settling a subtree is: DOWN FIRST (a recursive settle of the child's own children -- their
# records and links answer in the arena above them), then the child itself if nothing live is left
# under it -- reaped whole on success, attached to its parent on failure.  If something under it IS
# still alive, the reap is postponed (LMX_SETTLE_DEFERRED) and the live ones get the stop request.
#
# Spec 9's "chain reaction" is what this recursion is; what it is NOT is a free-from-here: the
# version that released a live child's arena outright was measured releasing an arena whose own
# lane was still running (tests\lmx_app_running_lane_selftest.lm1) and was removed.
#
# `graph` is always the graph of the parent whose slots these are: a slot that outlived its record
# would name freed storage.
# `node` is the PARENT's own chain cell for this child, handed down by the walk that found it
# (lmx_settle_children): the parent's arena owns the chain, so the node is the one place this act
# may read a child's addresses from once the child's own arena is back.
fn: lmx_settle_one (@: LmxThread t; @: LmxArena parent_arena; @: LmxService service; @: LmxManager manager; @: Lmx graph; @: LmxThread child; @: LmxMsg child_message; @: LmxLink node; ulong: now) int
    @: LmxSchedule child_slot
    @: LmxArena child_arena
    size_t: slot
    unsigned: index
    int: outcome
    int: gone
    if: t = 0 || child = 0 || child_message = 0
        return: c.LMX_SETTLE_INVALID
    # The child's own schedule record, read from the PARENT's node and not from the child's
    # record: the node carries the child's addresses (lmx_thread.h.lm1, LmxLink), so everything
    # this act needs is in the arena that owns the chain.  That is the point of the link -- a
    # child may be gone, hung or mid-cleanup and the parent still acts on it by reading its own
    # storage only (Mikhail, 19.09: the parent owns the parent link at link, unlink and
    # supervision handoff).  The pointer VALUE is what the service and the schedule are keyed
    # by; dereferencing it is a different matter and belongs to whoever owns that record.
    # `node` ARRIVES from the walk (19.09, evening): this act used to fetch it from the child
    # (`lmx_thread_link(child)`), which for a gone child is a read of returned storage.
    gone: 0
    if: node != 0
        gone: node\gone
    ---
    # `gone` is the end of the reading: a successful child returned its own arena at the end of
    # its own turn (lmx_thread_finish), so from that moment NOTHING of its record may be touched
    # -- not its schedule word, not its message.  Everything this act still needs is in the
    # parent's node.
    child_slot: 0
    child_arena: 0
    if: gone = 0
        if: node != 0
            child_slot: (cast: (@: LmxSchedule) node\slot)
        ---
        if: child_slot != 0
            child_arena: child_slot\arena
        ---
    ---
    # (0) DOWN FIRST: the child's own children, and this is a RECURSION, not a walk of one level --
    #     a subtree is settled from its leaves up, because a level's links answer in the arena the
    #     level above it is about to return.  A level that is itself closed and whose own children
    #     have ended gets reaped (success) or attached (failure) here, exactly as the top level does;
    #     a grandchild that fails attaches its arena to ITS parent's arena -- this child's -- and that
    #     arena then goes whole, one line further down, which is the failure chain of point (4).
    #     `now` is passed down unchanged: one reading, one boundary (lmx_manager.h.lm1).
    if: gone = 0
        if: lmx_thread_child_first(child) != 0
            lmx_settle_children(child, child_arena, service, manager, now)
        # ... and if something under it is STILL ALIVE, nothing of this child's is freed (Mikhail,
        #     19.09): a running grandchild may be inside storage this act would return -- and a child
        #     that was just stopped has not ended yet either, its own thread is still on its way out.
        #     So the live ones get the stop request (the stop is the whole act) and the reap is
        #     POSTPONED: the child keeps its place in the parent's list, in the service and in the
        #     schedule, and a later boundary settles it again -- by then its children have ended and
        #     their endings are done, and this act reaps it the ordinary way.
        #     Measured on lmx_app_chain_settle_selftest: without it, R0's settle of A returned A's
        #     arena while A's child B was still live and still answering there.
            if: lmx_thread_child_first(child) != 0
                # The reading is the boundary's own and is handed down unchanged (lmx_manager.h.lm1):
                # the stop uses it to start the window, and to END it for a child that has not
                # reached a boundary of its own (lmx_thread.h.lm1, lmx_stop_children).
                lmx_stop_children(child, now)
                return: c.LMX_SETTLE_DEFERRED
            ---
        ---
    ---
    # (1) the service forgets it first: an entry naming a Message that is about to lose its
    #     storage would be a route to something that no longer exists.
    if: service != 0
        lmx_service_unregister(service, child)
    ---
    # (2) it leaves the schedule: a settled Message has no lane, and a queue that kept its
    #     record would step freed cells on the next round.
    #     NOT for a child whose arena is already gone: that record is returned storage, and a
    #     removal walks it (lmx_manager_remove zeroes the link it unlinks).  Nothing is lost --
    #     the driver TOOK the record out of the queue before it ran the ending turn and put it
    #     back only while the object continues (`lmx_manager_step`: take, run, re-add if running),
    #     so a record of a gone child is not in any queue to begin with.  And per the model the
    #     scheduler is the object's OWN anyway (Mikhail, 19.09: "менеджер у каждого ребёнка
    #     свой"), so a parent's settle has no business in a scheduler at all.
    if: gone = 0 && manager != 0 && child_slot != 0
        lmx_manager_remove(manager, child_slot)
    ---
    # (3) it leaves the parent's list of LIVE direct children -- and this happens BEFORE any
    #     storage goes: the unlink walks the list and reads the child's own sibling link, so a
    #     released child would be read as freed cells.  A settled child has no mailbox to be
    #     addressed in, so it must leave the list delivery and supervision walk.
    lmx_thread_child_remove(t, child)
    # (4) the storage, and only now.  Both endings are reachable only from here, past (0): a child
    #     with live children of its own was postponed above, so what stands here has none.
    # The outcome is read from the PARENT's node when the child has one: a successful child frees
    # its own arena at the end of its own turn, so by the time this act runs the child's record may
    # already be gone and the node is the only place the answer survives (lmx_thread.h.lm1,
    # LmxLink.success).  Without a node -- a record nobody linked -- the message is all there is.
    outcome: 0
    index: 0U
    if: gone != 0
        # The child ended successfully and its arena is already back: what is left is the
        # parent's own slot, and the index for it comes from the node.
        outcome: 1
        index: (cast: (unsigned) node\index)
    else:
        # The child's record is still there (it did not return its arena), so IT is the truth.
        # The node's copy is written by the child's own end-turn and is read only above, when the
        # record is gone -- a copy must not outvote the original while the original exists
        # (measured 20260919: a hand-wired child that never took a turn left the copy at 0 and the
        # settle took the failure path for a successful child).
        outcome: child_message\success
        index: child_message\index
    ---
    if: outcome != 0
        # SUCCESS: "reclaim the Message's own execution history by default".  Its slot in the
        # parent's graph goes first -- the index the record answers with is its slot + 1 (the
        # counter starts at 1) -- and then its arena WHOLE, since nothing else holds any of it.
        if: index >= 1U
            slot: (cast: (size_t) index) - 1U
            if: graph != 0 && slot < (cast: (size_t) graph\len)
                lmx_arena_ref_store(graph, slot, 0)
            ---
        ---
        if: gone = 0 && child_arena != 0
            lmx_arena_release(child_arena)
        ---
    else:
        # FAILURE: "transfer its logical arena to its direct parent's available lifecycle
        # endpoint without copying" -- the attach is lmx_child_handoff, and it refuses while
        # the child is not handoff-safe, which the readiness predicate has just established.
        # The slot KEEPS pointing at the child: "P retains the failure root", and the child's
        # cells now answer in the parent's index because the arena joined it.
        if: parent_arena != 0 && child_arena != 0
            lmx_child_handoff(parent_arena, child_arena, child_message)
        ---
    ---
return: c.LMX_SETTLE_OK

fn: lmx_settle_children (@: LmxThread t; @: LmxArena parent_arena; @: LmxService service; @: LmxManager manager; ulong: now) int
    @: LmxMsg parent_message
    @: Lmx graph
    @: LmxLink node
    @: LmxLink next
    @: LmxThread child
    @: LmxMsg child_message
    int: ready
    if: t = 0 || parent_arena = 0
        return: c.LMX_SETTLE_INVALID
    parent_message: lmx_thread_message(t)
    if: parent_message = 0
        return: c.LMX_SETTLE_INVALID
    graph: parent_message\graph
    # Parent-liveness answer (20260919-113000): zero fresh stamps; emergency-close stale (self-closed orphans reclaim).
    lmx_poll_answer_children(t, now)
    # THE WALK IS OVER THE PARENT'S OWN NODES (19.09, evening): the node carries everything this act
    # decides by -- thread, message, gone, slot, index -- and it is a cell of the arena that OWNS
    # the chain, so it stays valid after a child's own arena is back (lmx_thread_finish released it
    # whole).  Reading `next` or the record from the CHILD is what left a gone child unsettled --
    # and, through the poll above, dereferenced a zero handshake cell -- the moment its block
    # answered something else (tests\lmx_settle_reads_node_selftest.lm1, gdb: SIGSEGV in
    # lmx_poll_answer_children, called from here).
    node: lmx_thread_child_link(t)
    while: node != 0
        # The next node is read BEFORE the child is unlinked: the walk must survive the removal it
        # is about to perform -- and it is a cell of the PARENT's chain, never the child's.
        next: (cast: (@: LmxLink) node\next)
        child: (cast: (@: LmxThread) node\thread)
        child_message: (cast: (@: LmxMsg) node\message)
        ready: 0
        # A child whose arena is already back (gone) answers from the PARENT's node alone: its own
        # message must not be read, and it is already ended.  For everyone else the readiness
        # predicate is the gate, after the wait below has had its say.
        if: node\gone != 0
            ready: 1
        else:
            # THE WAIT ENDS BEFORE THE GATE IS ASKED (19.09): a child that was asked to close and
            # has not reached a boundary of its own within its own band's window is closed here,
            # without a turn -- so the gate below sees it as ended and THIS boundary reaps it.  Only
            # the close is called, never the request: this walk passes running children by, and
            # stopping them is the cascade's business (lmx_thread.h.lm1).
            lmx_stop_close(child, now)
            if: child_message != 0
                ready: lmx_settle_ready(child_message)
            ---
        ---
        if: ready != 0
            lmx_settle_one(t, parent_arena, service, manager, graph, child, child_message, node, now)
        ---
        node: next
    ---
return: c.LMX_SETTLE_OK
