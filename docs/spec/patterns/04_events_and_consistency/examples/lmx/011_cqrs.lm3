WriteMessage:
    int: balance 0
    int: amount
    @: transport
    add:
        throws: Amount
        if: amount < 0
            throw: Amount()
        node\balance += amount
        node\transport\publish(node\balance)

ReadMessage:
    int: visible 0
    int: snapshot
    return: int
    apply:
        node\visible := snapshot
        return: node\visible
    query:
        return: node\visible
