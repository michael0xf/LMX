Mask:
    char[]: target
    int: begin
    int: end
    apply:
        int: i begin
        while: i < end
            target[i] := '*'
            i += 1


Example:
    char[]: text
    return: char[]
    run:
        throws: copy(sys\resize\throws)
        char[]: out []
        sys\resize(out; length(text))
        int: i 0
        while: i < length(text)
            out[i] := text[i]
            i += 1
        i := 0
        while: i < length(text)
            if: text[i] >= '0' && text[i] <= '9'
                int: begin i
                while: i < length(text) && text[i] >= '0' && text[i] <= '9'
                    i += 1
                Mask\apply(out; begin; i)
            else:
                i += 1
        ---
        return: out
