FxTranslate:
    private:
        @: text
        @: from
        @: to
        @: same 0
    required: text from to
    return: @
    translate:
        throws: copy(FxThrows\predicate) FxShape SequenceElement SequenceSize
        FxSeqInfo\get(text)
        FxSeqInfo\get(from)
        FxSeqInfo\get(to)
        if: length(from) != length(to)
            throw: SequenceSize()
        private: @: out FxSeqSlice\slice(text; 0; length(text))
        private: int: i 0
        while: i < length(text)
            private: int: found FxKeyIndex\find(from; FxSeqRead\read(text; i); same)
            if: found >= 0
                FxSeqStore\write(out; i; FxSeqRead\read(to; found))
            i += 1
        return: out

FxTry:
    private:
        @: operation
        @: args
    return: @
    attempt:
        throws: copy(FxThrows\kernel)
        private: @: info FxKernel\signature(subject := operation)
        return: FxKernel\attempt(operation; args; info\throws)

FxTwo:
    private:
        @: first
        @: second
    return: @
    make:
        private: @: out (copy(()))
        sys\resize(out; 2)
        out[0] := first
        out[1] := second
        return: out

FxValueSame:
    private:
        @: first
        @: second
        @: same 0
    required: first second
    return: int
    test:
        throws: copy(FxThrows\predicate)
        if: same != 0
            return: FxSeqPredicate\truth(FxApply\apply(same; FxTwo\make(first; second)))
        private: int: firstArray FxKernel\acceptsRequirement(
            candidate := first;
            requirement := FxEqualityTypes\array[0]
        )
        private: int: secondArray FxKernel\acceptsRequirement(
            candidate := second;
            requirement := FxEqualityTypes\array[0]
        )
        if: firstArray != secondArray
            return: 0
        if: firstArray != 0
            return: FxEqualFields\equalFields(first; second)
        return: \first = \second

RxCandidate:
    int: position 0
    @: captures 0

RxCandidateMake:
    private:
        int: position
        @: captures
    return: @
    make:
        private: @: out (copy(RxCandidate))
        out\position := position
        out\captures := captures
        return: out

RxCaptureAdd:
    private:
        @: previous
        []char: name
        int: begin
        int: end
    return: @
    add:
        private: @: out (copy(RxCaptureEntry))
        out\previous := previous
        out\name := name
        out\begin := begin
        out\end := end
        return: out

RxCaptureEntry:
    @: previous 0
    []char: name ""
    int: begin 0
    int: end 0

RxCaptureLatest:
    private:
        @: captures
        []char: name
    return: @
    find:
        private: @: cursor captures
        while: cursor != 0
            if: FxEqualFields\equalFields(cursor\name; name) != 0
                return: FxSome\some(value := cursor)
            cursor := cursor\previous
        return: FxNone\none()

RxCaptureOpen:
    private:
        @: config
        @RxPreparedSource: source
        int: position
        @: captures
    return: @
    open:
        private: @: state (copy(RxCaptureState))
        state\name := config\name
        state\begin := position
        state\cursor := RxOpen\open(config\pattern; source; position; captures)
        return: RxCursorFactory\make(RxCaptureStep\step; state)

RxCaptureState:
    []char: name ""
    int: begin 0
    @: cursor 0

RxCaptureStep:
    private: @: state
    return: @
    step:
        private: @: cursor state\cursor
        private: @: next cursor()
        if: next\present = 0
            return: next
        private: @: candidate next\value
        private: @: captures RxCaptureAdd\add(candidate\captures; state\name; state\begin; candidate\position)
        return: FxSome\some(value := RxCandidateMake\make(candidate\position; captures))

RxCursorFactory:
    private:
        @: engine
        @: state
    return: @
    make:
        private: @: owner (copy(RxCursorOwner))
        owner\private\engine := engine
        owner\private\state := state
        return: owner\Next\next

RxCursorOwner:
    private:
        @: engine 0
        @: state 0
    Next:
        return: @
        next:
            private: @: owner parent()
            private: @: engine owner\private\engine
            return: engine(state := owner\private\state)

RxIsPattern:
    private: @: value
    return: int
    test:
        throws: copy(FxThrows\pattern)
        # Read the existing directed interface check without trial execution.
        # Unresolved compatibility is a service failure, never a false result.
        return: FxKernel\acceptsRequirement(candidate := value; requirement := Pattern)

RxLiteralProbe:
    private:
        @: payload
        @RxPreparedSource: source
        int: position
        @: captures
    return: int
    probe:
        throws: copy(FxThrows\pattern)
        private: @: prepare source\domain\literalUnits
        private: @: part prepare(value := payload; profile := source\profile)
        private: int: count length(part)
        if: count > length(source\units) - position
            return: -1
        if: FxSequenceDifference\find(source\units; part; 0; position; count) >= 0
            return: -1
        return: position + count

RxMatchMake:
    private:
        @RxPreparedSource: source
        int: begin
        @: candidate
    return: @
    make:
        private: @: out (copy(Match))
        out\source := source\view
        out\private\prepared := source
        out\begin := begin
        out\end := candidate\position
        out\captures := candidate\captures
        return: out

RxNameConfig:
    []char: name ""

RxNormalize:
    private: @: value
    required: value
    return: @
    make:
        throws: copy(FxThrows\pattern)
        if: RxIsPattern\test(value := value) != 0
            return: value
        return: RxLiteral\literal(value := value)

RxOctet:
    private:
        []char: source
        int: index
    return: int
    read:
        private: int: value source[index]
        if: value < 0
            value += 256
        return: value

RxOpen:
    private:
        @Pattern: pattern
        @RxPreparedSource: source
        int: position
        @: captures
    return: @
    open:
        throws: copy(FxThrows\pattern)
        if: position < 0 || position > length(source\units)
            throw: PatternPosition()
        # The signature-qualified reference applies its ordinary label map.
        return: pattern(source := source; position := position; captures := captures)

RxPatternFactory:
    private:
        @: engine
        @: config
    return: @
    make:
        private: @: owner (copy(RxPatternOwner))
        owner\private\engine := engine
        owner\private\config := config
        return: owner\Call\open

RxPatternOwner:
    private:
        @: engine 0
        @: config 0
    Call:
        private:
            @RxPreparedSource: source
            int: position
            @: captures
        required: source position captures
        return: @
        open:
            private: @: owner parent()
            private: @: engine owner\private\engine
            return: engine(config := owner\private\config; source := source; position := position; captures := captures)

RxPrepareSource:
    private: @: source
    required: source
    return: @
    make:
        throws: copy(FxThrows\pattern)
        private: @: prepare source\prepare
        return: prepare(source := source)

RxPreparedSource:
    @: view 0
    @: units 0
    @RxSourceDomain: domain 0
    @: profile 0

RxPreparedText:
    @TextView: view 0
    int: profile
    []char: source
    []int: units
    []int: byteOffsets

RxPrimitiveMake:
    private:
        @: probe
        @: payload 0
    return: @
    make:
        private: @: config (copy(RxPrimitiveConfig))
        config\probe := probe
        config\payload := payload
        return: RxPatternFactory\make(RxPrimitiveOpen\open; config)

RxPrimitiveOpen:
    private:
        @: config
        @RxPreparedSource: source
        int: position
        @: captures
    return: @
    open:
        private: @: state (copy(RxPrimitiveState))
        state\source := source
        state\position := position
        state\captures := captures
        state\probe := config\probe
        state\payload := config\payload
        return: RxCursorFactory\make(RxPrimitiveStep\step; state)

RxPrimitiveState:
    @: source 0
    int: position 0
    @: captures 0
    @: probe 0
    @: payload 0
    int: finished 0

RxPrimitiveStep:
    private: @: state
    return: @
    step:
        if: state\finished != 0
            return: FxNone\none()
        state\finished := 1
        private: @: probe state\probe
        private: int: end probe(payload := state\payload; source := state\source; position := state\position; captures := state\captures)
        if: end < 0
            return: FxNone\none()
        return: FxSome\some(value := RxCandidateMake\make(end; state\captures))

RxRepeatFrame:
    @: previous 0
    @: candidate 0
    int: count 0
    int: lastWasEmpty 0
    int: stopReturned 0
    int: extendFinished 0
    @: cursor 0

RxRepeatFrameMake:
    private:
        @: previous
        @: candidate
        int: count
        int: lastWasEmpty
    return: @
    make:
        private: @: frame (copy(RxRepeatFrame))
        frame\previous := previous
        frame\candidate := candidate
        frame\count := count
        frame\lastWasEmpty := lastWasEmpty
        return: frame

RxRepeatOpen:
    private:
        @: config
        @RxPreparedSource: source
        int: position
        @: captures
    return: @
    open:
        private: @: state (copy(RxRepeatState))
        state\source := source
        state\config := config
        state\top := RxRepeatFrameMake\make(0; RxCandidateMake\make(position; captures); 0; 0)
        return: RxCursorFactory\make(RxRepeatStep\step; state)

RxRepeatState:
    @: source 0
    @: config 0
    @: top 0

RxRepeatStep:
    private: @: state
    return: @
    step:
        private: @: config state\config
        while: state\top != 0
            private: @: frame state\top
            private: int: mayStop frame\count >= config\minimum
            if: config\order = stopFirst && mayStop && frame\stopReturned = 0
                frame\stopReturned := 1
                return: FxSome\some(value := frame\candidate)
            private: int: mayExtend frame\extendFinished = 0
            if: config\bounded != 0 && frame\count >= config\maximum
                mayExtend := 0
            # A nonprogressing iteration may only be followed by still
            # mandatory iterations. Alternative candidates remain on cursor.
            if: frame\lastWasEmpty != 0 && mayStop
                mayExtend := 0
            if: mayExtend != 0
                if: frame\cursor = 0
                    frame\cursor := RxOpen\open(config\pattern; state\source; frame\candidate\position; frame\candidate\captures)
                private: @: cursor frame\cursor
                private: @: next cursor()
                if: next\present != 0
                    private: @: child next\value
                    private: int: didNotMove child\position = frame\candidate\position
                    state\top := RxRepeatFrameMake\make(frame; child; frame\count + 1; didNotMove)
                    continue
                frame\extendFinished := 1
            if: config\order = extendFirst && mayStop && frame\stopReturned = 0
                frame\stopReturned := 1
                return: FxSome\some(value := frame\candidate)
            state\top := frame\previous
        return: FxNone\none()

RxSameAsProbe:
    private:
        @RxNameConfig: payload
        @RxPreparedSource: source
        int: position
        @: captures
    return: int
    probe:
        throws: copy(FxThrows\pattern)
        private: @: found RxCaptureLatest\find(captures; payload\name)
        if: found\present = 0
            return: -1
        private: @: capture found\value
        private: int: count capture\end - capture\begin
        if: count > length(source\units) - position
            return: -1
        if: FxSequenceDifference\find(source\units; source\units; 0; position; count; capture\begin) >= 0
            return: -1
        return: position + count

RxSelect:
    private:
        @: source
        @: indices
    required: source indices
    return: @
    select:
        throws: copy(FxThrows\sequence)
        return: FxSeqSelect\select(source; indices)

RxSequenceFrame:
    @: previous 0
    int: index 0
    @: cursor 0

RxSequenceFrameMake:
    private:
        @RxPreparedSource: source
        @: parts
        int: index
        @: candidate
        @: previous
    return: @
    make:
        private: @: frame (copy(RxSequenceFrame))
        frame\previous := previous
        frame\index := index
        frame\cursor := RxOpen\open(parts[index]; source; candidate\position; candidate\captures)
        return: frame

RxSequenceOpen:
    private:
        @: config
        @RxPreparedSource: source
        int: position
        @: captures
    return: @
    open:
        private: @: state (copy(RxSequenceState))
        state\source := source
        state\parts := config\parts
        state\top := RxSequenceFrameMake\make(source; config\parts; 0; RxCandidateMake\make(position; captures); 0)
        return: RxCursorFactory\make(RxSequenceStep\step; state)

RxSequenceState:
    @: source 0
    @: parts 0
    @: top 0

RxSequenceStep:
    private: @: state
    return: @
    step:
        while: state\top != 0
            private: @: frame state\top
            private: @: cursor frame\cursor
            private: @: next cursor()
            if: next\present = 0
                state\top := frame\previous
            else:
                private: @: candidate next\value
                if: frame\index + 1 = length(state\parts)
                    return: next
                state\top := RxSequenceFrameMake\make(state\source; state\parts; frame\index + 1; candidate; frame)
        ---
        return: FxNone\none()

RxSourceAppend:
    private:
        @: target
        @: fragment
        @RxPreparedSource: source
    required: target fragment source
    append:
        throws: copy(FxThrows\pattern)
        private: @: validate source\domain\literalUnits
        validate(value := fragment; profile := source\profile)
        FxSeqAppend\append(target; fragment)

RxSourceAppendSpan:
    private:
        @: target
        @RxPreparedSource: source
        int: begin
        int: end
    required: target source begin end
    append:
        throws: copy(FxThrows\pattern)
        FxSeqAppend\append(target; RxSourceSlice\copyValue(source; begin; end))

RxSourceDomain:
    @: literalUnits 0
    @: rangeUnit 0
    @: slice 0

RxSourceSlice:
    private:
        @RxPreparedSource: source
        int: begin
        int: end
    required: source begin end
    return: @
    copyValue:
        throws: copy(FxThrows\pattern)
        private: @: slice source\domain\slice
        return: slice(source := source; begin := begin; end := end)

RxSpanMake:
    private:
        @RxPreparedSource: source
        int: begin
        int: end
    return: @
    make:
        private: @: out (copy(Span))
        out\source := source\view
        out\private\prepared := source
        out\begin := begin
        out\end := end
        return: out

RxTextBuild:
    private:
        []char: source
        int: profile
    return: @
    make:
        throws: copy(FxThrows\pattern)
        private: @: info FxSeqInfo\get(source := source)
        if: info\elementBits != 8
            throw: PatternEncoding()
        if: profile != 0 && profile != 1
            throw: PatternArgument()
        private: []int: units []
        private: []int: offsets []
        # Exact upper bounds: an octet cannot create more than one scalar.
        private: @: unitInfo FxSeqInfo\get(source := units)
        private: int: unitCapacity FxSeqSize\sum(0; length(source); unitInfo\maxLength)
        private: int: offsetCapacity FxSeqSize\sum(length(source); 1; unitInfo\maxLength)
        sys\resize(units; unitCapacity)
        sys\resize(offsets; offsetCapacity)
        private: int: byteAt 0
        private: int: used 0
        while: byteAt < length(source)
            offsets[used] := byteAt
            private: int: first RxOctet\read(source; byteAt)
            private: int: code first
            private: int: width 1
            private: int: lower 0
            if: profile = 0
                if: first < 128
                    width := 1
                else:
                    if: first >= 194 && first <= 223
                        width := 2
                        code := first - 192
                        lower := 128
                    else:
                        if: first >= 224 && first <= 239
                            width := 3
                            code := first - 224
                            lower := 2048
                        else:
                            if: first >= 240 && first <= 244
                                width := 4
                                code := first - 240
                                lower := 65536
                            else:
                                throw: PatternEncoding()
                ---
                if: width > length(source) - byteAt
                    throw: PatternEncoding()
                private: int: tail 1
                while: tail < width
                    private: int: nextByte RxOctet\read(source; byteAt + tail)
                    if: nextByte < 128 || nextByte > 191
                        throw: PatternEncoding()
                    code := code * 64 + nextByte - 128
                    tail += 1
                if: code < lower || code > 1114111
                    throw: PatternEncoding()
                if: code >= 55296 && code <= 57343
                    throw: PatternEncoding()
            ---
            units[used] := code
            used += 1
            byteAt += width
        offsets[used] := byteAt
        sys\resize(units; used)
        sys\resize(offsets; used + 1)
        private: @: out (copy(RxPreparedText))
        out\profile := profile
        out\source := source
        out\units := units
        out\byteOffsets := offsets
        return: out

RxUnbounded:
    const: int: upperBoundAbsent 1
