# Вложенная ссылка `@: x int @y` при внешнем `int: x 5` — своё место, а не запись во внешнюю ячейку: seen 5.
# Норма: книга, #shadowing-levels, наблюдение B24.
(
    Observed:
        int: seen 0
)
fn: f () int
    int: y 7
    int: x 5
    if: 1
        @: x int @y
    return: x
sub: main ()
    @: shared node[0]
    shared\Observed\seen := f()
main()
