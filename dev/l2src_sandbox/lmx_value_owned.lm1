predef: "lmx_value_owned.h.lm1"
predef: "lmx_implements.h.lm1"
predef: "lmx_arena_refs.h.lm1"
predef: "l2src/lmx_chars.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdlib.h>" "<stdio.h>"

# A cell of one of the arena's arrays (Lingvamyxa_spec.txt 2, 6.5): the arena hands it out
# from its array of that kind and type -- the array is made on the first request and grows
# by adding chunks, so a cell's address never moves.  What a constructor gets back is the
# address of the cell inside that array; stride, kind and type belong to the array, and the
# arena's index answers them for any address in it.  There is no owner-local list and no
# per-value array: the array is the arena's and the type is the array's.
fn: lmx_value_allocate_owned (@: LmxArena arena; size_t: stride; int: kind; int: type) @: void
    if: arena = 0 || stride = 0U
        return: 0
    ---
return: lmx_arena_take(arena, stride, kind, type)

# Initial root construction, not reparenting of an existing occurrence. The
# header lives in the STRUCT domain (SPEC 2: only a Structure target has
# array/parent/native); its child-pointer array is a separate CHILDREN range opened
# later by lmx_arena_refs_open_owned.
fn: lmx_node_new_owned (@: LmxArena arena) @: Lmx
return: lmx_node_new_profiled(arena, 0)

fn: lmx_node_new_profiled (@: LmxArena arena; @: Lmx profile) @: Lmx
return: lmx_node_new_role_profiled(arena, profile, c.LMX_POOL_ROLE_PLAIN)

fn: lmx_node_new_role_profiled (@: LmxArena arena; @: Lmx profile; unsigned: role) @: Lmx
    @: Lmx value lmx_arena_take_struct_role(arena, profile, role)
    if: value != 0
        value\parent: 0
        value\array.size: 0U
        value\array.data: 0
        value\native: 0
    ---
    return: value

fn: lmx_struct_new_owned (@: Lmx parent; @: LmxArena arena) @: Lmx
return: lmx_struct_new_profiled(parent, arena, 0)

fn: lmx_struct_new_profiled (@: Lmx parent; @: LmxArena arena; @: Lmx profile) @: Lmx
return: lmx_struct_new_role_profiled(parent, arena, profile, c.LMX_POOL_ROLE_PLAIN)

fn: lmx_struct_new_role_profiled (@: Lmx parent; @: LmxArena arena; @: Lmx profile; unsigned: role) @: Lmx
    @: Lmx value
    if: parent = 0
        return: 0
    value: lmx_node_new_role_profiled(arena, profile, role)
    if: value != 0
        value\parent: parent
    ---
    return: value

fn: lmx_field_place_new (@: LmxArena arena; @: Lmx owner; size_t: field) @: Lmx
    @@: void cell lmx_graph_ref_cell_in(arena, owner, field)
    @: Lmx place
    if: cell = 0
        return: 0
    place: lmx_struct_new_profiled(owner, arena, lmx_range_profile(arena, (cast: (@: void) cell)))
    if: place = 0
        return: 0
    place\array.size: 1U
    place\array.data: (cast: (@: void) cell)
return: place

fn: lmx_op_new_owned (@: LmxArena arena; int: code) @: LmxOp
return: lmx_op_new_profiled(arena, code, 0)

fn: lmx_op_new_profiled (@: LmxArena arena; int: code; @: Lmx profile) @: LmxOp
    @: LmxOp value (cast: (@: LmxOp) lmx_arena_take_profiled(arena, c.sizeof(c.LmxOp), c.LMX_DOMAIN_KIND_OP, c.LMX_DOMAIN_OP, profile))
    if: value != 0
        value\code: code
    ---
    return: value

fn: lmx_int_new_owned (@: LmxArena arena) @: void
return: lmx_int_new_profiled(arena, 0)

fn: lmx_int_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    int: zero 0
    @: int value (cast: (@: int) lmx_arena_take_profiled(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT, profile))
    if: value != 0
        \value: 0
    ---
    return: (cast: (@: void) value)

# The first CHAR interval remains the immutable literal table. Mutable cells
# follow it in the same typed arena pool and have independent stable addresses.
fn: lmx_char_new_owned (@: LmxArena arena) @: void
return: lmx_char_new_profiled(arena, 0)

fn: lmx_char_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    @: char value
    if: profile = 0 && lmx_chars_init(arena) != 0 && lmx_arena_find(arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR) = 0
        return: 0
    value: (cast: (@: char) lmx_arena_take_profiled(arena, c.sizeof(c.char), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR, profile))
    if: value != 0
        \value: 0
    ---
return: (cast: (@: void) value)

fn: lmx_char_store_known (@: void cell; int: value) int
    @: char p
    if: cell = 0
        return: 1
    p: (cast: (@: char) cell)
    \p: (cast: (char) value)
return: 0

fn: lmx_size_new_owned (@: LmxArena arena) @: void
return: lmx_size_new_profiled(arena, 0)

fn: lmx_size_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    size_t: zero 0U
    @: size_t value (cast: (@: size_t) lmx_arena_take_profiled(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_SIZE_T, profile))
    if: value != 0
        \value: 0U
    ---
    return: (cast: (@: void) value)

fn: lmx_unsigned_new_owned (@: LmxArena arena) @: void
return: lmx_unsigned_new_profiled(arena, 0)

fn: lmx_unsigned_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    unsigned: zero 0U
    @: unsigned value (cast: (@: unsigned) lmx_arena_take_profiled(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_UNSIGNED, profile))
    if: value != 0
        \value: 0U
    ---
    return: (cast: (@: void) value)

fn: lmx_ulong_new_owned (@: LmxArena arena) @: void
return: lmx_ulong_new_profiled(arena, 0)

fn: lmx_ulong_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    ulong: zero 0U
    @: ulong value (cast: (@: ulong) lmx_arena_take_profiled(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_ULONG, profile))
    if: value != 0
        \value: 0U
    ---
    return: (cast: (@: void) value)

fn: lmx_uchar_new_owned (@: LmxArena arena) @: void
return: lmx_uchar_new_profiled(arena, 0)

fn: lmx_uchar_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    char: zero '\0'
    @: char value (cast: (@: char) lmx_arena_take_profiled(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_UNSIGNED_CHAR, profile))
    if: value != 0
        \value: '\0'
    ---
    return: (cast: (@: void) value)

fn: lmx_charptr_new_owned (@: LmxArena arena) @: void
return: lmx_charptr_new_profiled(arena, 0)

fn: lmx_charptr_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    @: char zero 0
    @@: char value (cast: (@@: char) lmx_arena_take_profiled(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR_PTR, profile))
    if: value != 0
        \value: 0
    ---
    return: (cast: (@: void) value)

fn: lmx_charptr_value_known (@: void cell) @: char
    @@: char p
    if: cell = 0
        return: 0
    p: (cast: (@@: char) cell)
    return: \p

fn: lmx_charptr_store_known (@: void cell; @: char value) int
    @@: char p
    if: cell = 0
        return: 1
    p: (cast: (@@: char) cell)
    \p: value
    return: 0

fn: lmx_pointer_new_owned (int: type; @: LmxArena arena) @: void
return: lmx_pointer_new_profiled(type, arena, 0)

fn: lmx_pointer_new_profiled (int: type; @: LmxArena arena; @: Lmx profile) @: void
return: lmx_pointer_new_typed_profiled(type, arena, profile, c.sizeof(@: void), lmx_arena_pointer_void_read, lmx_arena_pointer_void_write)

fn: lmx_pointer_new_typed_profiled (int: type; @: LmxArena arena; @: Lmx profile; size_t: stride; LmxPointerCellRead: read; LmxPointerCellWrite: write) @: void
return: lmx_arena_pointer_cells_profiled(arena, type, profile, stride, read, write, 1U)

fn: lmx_pointer_pool_in (@: LmxArena arena; @: void cell) @: LmxPool
    @: LmxPool pool lmx_range_cell_pool(arena, cell)
    if: pool = 0 || pool\kind != c.LMX_KIND_PRIMITIVE || pool\type < c.LMX_TYPE_POINTER_BASE || pool\type >= c.LMX_TYPE_ARRAY_OF_POINTER_BASE || pool\stride = 0U || pool\pointer_read = 0 || pool\pointer_write = 0
        return: 0
return: pool

fn: lmx_pointer_value_in (@: LmxArena arena; @: void cell) @: void
    @: LmxPool pool lmx_pointer_pool_in(arena, cell)
    if: pool = 0
        return: 0
return: pool\pointer_read(cell)

# The exact ABI of an L2 graph reference cell, independent of the pool/profile that owns this particular address.
# Foreign C99 pointer pools can share its numeric type; those remain valid for their own consumers, not for a graph
# reference whose declaration was built with lmx_pointer_new_profiled.
fn: lmx_pointer_cell_canonical (@: LmxArena arena; @: void cell) int
    @: LmxPool pool lmx_pointer_pool_in(arena, cell)
    if: pool = 0
        return: 0
return: (cast: (int) (pool\stride = c.sizeof(@: void) && pool\pointer_read = lmx_arena_pointer_void_read && pool\pointer_write = lmx_arena_pointer_void_write))

# The value of a pointer cell the construction PROMISED at this slot (a reference declaration `@: T x`, a reference
# field, a dynamic input of reference type), of the storage type `type` the construction gave it (POINTER_BASE + the
# closed type id, the pool's type -- the translator spells it at the read from the declaration, l2_ptr_cell_type): the
# one read of every native consumer of such a cell -- the working value loaded at entry, a field path's step through
# a reference field, a hidden input's cell.  A slot holding no pointer cell of this arena -- nothing, or something
# that is not a pointer cell -- or a pointer cell of another type or physical ABI (a present cell of another pool, physically put
# there) is a broken promise, said and stopped here as the generated program says its other invariants (an absent
# number's place, a missing own cell), never answered as 0: 0 is what a PRESENT pointer cell of that type holding
# nothing answers, the valid nothing whose use is the implicit `interpreter` throw at the reader.  The expected type
# comes from the reader, never from the cell found in the slot.  Generated L2 cells have the canonical void-pointer
# stride and accessors of lmx_pointer_new_profiled.  An imported sealed cell with that same ABI can be read through
# this arena's range index; no local owner is required.  lmx_pointer_value_in keeps its 0-for-either
# contract for callers that classify the cell themselves (the copier, the walker).
fn: lmx_pointer_value_promised (@: LmxArena arena; @: void cell; int: type) @: void
    @: LmxPool pool lmx_pointer_pool_in(arena, cell)
    if: pool = 0
        c.fprintf(l1_stderr(), "lmx: invariant: a reference slot holds no pointer cell\n")
        c.abort()
    ---
    if: pool\type != type
        c.fprintf(l1_stderr(), "lmx: invariant: a reference slot holds a pointer cell of another type\n")
        c.abort()
    ---
    if: lmx_pointer_cell_canonical(arena, cell) = 0
        c.fprintf(l1_stderr(), "lmx: invariant: a reference slot holds a pointer cell of another ABI\n")
        c.abort()
    ---
return: pool\pointer_read(cell)

fn: lmx_pointer_store_in (@: LmxArena arena; @: void cell; @: void value) int
    @: LmxPool pool lmx_pointer_pool_in(arena, cell)
    if: pool = 0
        return: 1
return: pool\pointer_write(cell, value)

fn: lmx_pointer_value_known (@: void cell) @: void
    @@: void p
    if: cell = 0
        return: 0
    p: (cast: (@@: void) cell)
    return: \p

fn: lmx_pointer_store_known (@: void cell; @: void value) int
    @@: void p
    if: cell = 0
        return: 1
    p: (cast: (@@: void) cell)
    \p: value
    return: 0

# Closed-unit type proof supplies the type, not a process-global catalog.
# Explicit raw/unknown addresses are outside these helper preconditions.
fn: lmx_char_value_known (@: void cell) int
    @: char p
    if: cell = 0
        return: -1
    p: (cast: (@: char) cell)
    # Numeric value follows C char promotion; byte-table indices are a storage detail.
    return: (cast: (int) \p)

fn: lmx_ulong_value_known (@: void cell) ulong
    @: ulong p
    if: cell = 0
        return: 0U
    p: (cast: (@: ulong) cell)
    return: \p

fn: lmx_ulong_store_known (@: void cell; ulong: value) int
    @: ulong p
    if: cell = 0
        return: 1
    p: (cast: (@: ulong) cell)
    \p: value
    return: 0

fn: lmx_uchar_value_known (@: void cell) unsigned
    @: char p
    if: cell = 0
        return: 0U
    p: (cast: (@: char) cell)
    return: (cast: (unsigned) ((cast: (int) \p) & 255))

fn: lmx_uchar_store_known (@: void cell; unsigned: value) int
    @: char p
    if: cell = 0
        return: 1
    p: (cast: (@: char) cell)
    \p: (cast: (char) (value & 255U))
    return: 0

fn: lmx_int_value_known (@: void cell) int
    @: int p
    if: cell = 0
        return: 0
    p: (cast: (@: int) cell)
    return: \p

fn: lmx_int_store_known (@: void cell; int: value) int
    @: int p
    if: cell = 0
        return: 1
    p: (cast: (@: int) cell)
    \p: value
    return: 0

fn: lmx_size_value_known (@: void cell) size_t
    @: size_t p
    if: cell = 0
        return: 0U
    p: (cast: (@: size_t) cell)
    return: \p

fn: lmx_size_store_known (@: void cell; size_t: value) int
    @: size_t p
    if: cell = 0
        return: 1
    p: (cast: (@: size_t) cell)
    \p: value
    return: 0

fn: lmx_unsigned_value_known (@: void cell) unsigned
    @: unsigned p
    if: cell = 0
        return: 0U
    p: (cast: (@: unsigned) cell)
    return: \p

fn: lmx_unsigned_store_known (@: void cell; unsigned: value) int
    @: unsigned p
    if: cell = 0
        return: 1
    p: (cast: (@: unsigned) cell)
    \p: value
    return: 0
