(require :sb-concurrency)
(defpackage #:sbcl-comparison-tests (:use #:cl))
(in-package #:sbcl-comparison-tests)
(defparameter *root* (merge-pathnames "../" *load-truename*))
(defparameter *passed* 0)
(defparameter *failed* 0)
(defparameter *cases* '(("S01" ("(equalp (apply #'example '((-2 0 3) 3 2)) '((-4 2 11) 9))" "(equalp (apply #'example '(() 3 2)) '(() 0))" "(equalp (apply #'example '((7) -2 1)) '((-13) -13))" "(equalp (apply #'example '((1 1 2) 0 5)) '((5 5 5) 15))" "(let* ((args (copy-tree '((-2 0 3) 3 2))) (before (copy-tree args))) (apply #'example args) (equalp args before))")) ("S02" ("(equalp (apply #'example '((-2 0 3 1 8 3) 3)) '((3 1 3) 7 3))" "(equalp (apply #'example '(() 5)) '(() 0 0))" "(equalp (apply #'example '((1 2) 0)) '(() 0 2))" "(equalp (apply #'example '((4 4) 4)) '((4 4) 8 0))" "(let* ((args (copy-tree '((-2 0 3 1 8 3) 3))) (before (copy-tree args))) (apply #'example args) (equalp args before))")) ("S03" ("(equalp (apply #'example '(20 (2 30 3 15 0))) '(0 4 1))" "(equalp (apply #'example '(20 ())) '(20 0 0))" "(equalp (apply #'example '(0 (0 1 0))) '(0 2 1))" "(equalp (apply #'example '(5 (4 2 1))) '(0 2 1))" "(equalp (apply #'example '(5 (2 4 1))) '(2 2 1))" "(let* ((args (copy-tree '(20 (2 30 3 15 0)))) (before (copy-tree args))) (apply #'example args) (equalp args before))")) ("S04" ("(equalp (apply #'example '((2 3 4) (10 5))) '((20 15) 35 1 0))" "(equalp (apply #'example '((2) (10 5 7))) '((20) 20 0 2))" "(equalp (apply #'example '(() (4))) '(() 0 0 1))" "(equalp (apply #'example '(() ())) '(() 0 0 0))" "(equalp (apply #'example '((0 2) (9 6))) '((0 12) 12 0 0))" "(let* ((args (copy-tree '((2 3 4) (10 5)))) (before (copy-tree args))) (apply #'example args) (equalp args before))")) ("S05" ("(equalp (apply #'example '((-1 2 3))) '(1 2 0 1))" "(equalp (apply #'example '(())) '(0 0 1 0))" "(equalp (apply #'example '((1 2))) '(1 1 1 2))" "(equalp (apply #'example '((-1 0))) '(0 2 0 1))")) ("S06" ("(equalp (apply #'example '((2 0 3 -1 9))) '((2 0 3) 5 3))" "(equalp (apply #'example '((-2 4))) '(() 0 0))" "(equalp (apply #'example '((1 2 0))) '((1 2 0) 3 -1))" "(equalp (apply #'example '(())) '(() 0 -1))" "(let* ((args (copy-tree '((2 0 3 -1 9)))) (before (copy-tree args))) (apply #'example args) (equalp args before))")) ("S07" ("(equalp (apply #'example '(((2 \"a\") (1 \"b\") (2 \"c\") (1 \"d\")) 3)) '(((1 \"b\") (1 \"d\") (2 \"a\")) 1))" "(equalp (apply #'example '(() 2)) '(() 0))" "(equalp (apply #'example '(((3 \"x\")) 0)) '(() 1))" "(equalp (apply #'example '(((3 \"x\")) 9)) '(((3 \"x\")) 0))" "(equalp (apply #'example '(((1 \"a\") (1 \"b\") (1 \"c\")) 2)) '(((1 \"a\") (1 \"b\")) 1))" "(let* ((args (copy-tree '(((2 \"a\") (1 \"b\") (2 \"c\") (1 \"d\")) 3))) (before (copy-tree args))) (apply #'example args) (equalp args before))" "(let* ((a (list 2 \"a\")) (b (list 1 \"b\")) (result (first (example (list a b) 1)))) (eq (first result) b))")) ("S08" ("(equalp (apply #'example '((3 1 3 2 1 4) (2 2 9))) '((3 1 4) 2 1))" "(equalp (apply #'example '(() (1))) '(() 0 0))" "(equalp (apply #'example '((5 5 5) (5))) '(() 2 1))" "(equalp (apply #'example '((3 2 3 1) ())) '((3 2 1) 1 0))" "(let* ((args (copy-tree '((3 1 3 2 1 4) (2 2 9)))) (before (copy-tree args))) (apply #'example args) (equalp args before))")) ("S09" ("(equalp (apply #'example '((4 5 6 7) 1 3 (5 9))) '((4 5 9 7) 1 3))" "(equalp (apply #'example '((1 2) 1 1 ())) '((1 2) 0 0))" "(equalp (apply #'example '(() 0 0 ())) '(() 0 0))" "(equalp (apply #'example '((5 8) 0 2 (1 2))) '((1 2) 2 -10))" "(let* ((args (copy-tree '((4 5 6 7) 1 3 (5 9)))) (before (copy-tree args))) (apply #'example args) (equalp args before))")) ("S10" ("(equalp (apply #'example '(3)) '8)" "(equalp (apply #'example '(0)) '5)" "(equalp (apply #'example '(-5)) '0)" "(equalp (apply #'example '(12)) '17)" "(= 10 (funcall (make-adder 7) 3))" "(let ((a (make-adder 2)) (b (make-adder 8))) (equal (list (funcall a 3) (funcall b 3)) (list 5 11)))")) ("S11" ("(equalp (apply #'example '(100 (20 5) (10 7))) '(25 17 108))" "(equalp (apply #'example '(0 () ())) '(0 0 0))" "(equalp (apply #'example '(-5 () (2))) '(0 2 -7))" "(equalp (apply #'example '(0 (2 2) (1))) '(4 1 3))" "(let* ((args (copy-tree '(100 (20 5) (10 7)))) (before (copy-tree args))) (apply #'example args) (equalp args before))")) ("S12" ("(equalp (apply #'example '(4 3)) '(12 4))" "(equalp (apply #'example '(0 3)) '(0 0))" "(equalp (apply #'example '(2 0)) '(0 2))" "(= 1 (area))")) ("S13" ("(equalp (apply #'example '(3 5)) '(15 6))" "(equalp (apply #'example '(0 9)) '(0 0))" "(equalp (apply #'example '(-2 4)) '(-8 -4))" "(progn (example 7 11) (= *scale* 2))")) ("S14" ("(equalp (apply #'example '(5)) '120)" "(equalp (apply #'example '(0)) '1)" "(equalp (apply #'example '(1)) '1)" "(equalp (apply #'example '(12)) '479001600)")) ("S15" ("(equalp (apply #'example '(17 5)) '(3 2 4 3))" "(equalp (apply #'example '(0 7)) '(0 0 0 0))" "(equalp (apply #'example '(12 3)) '(4 0 4 0))" "(equalp (apply #'example '(2 5)) '(0 2 1 3))" "(equalp (apply #'example '(1 1)) '(1 0 1 0))" "(let* ((args (copy-tree '(17 5))) (before (copy-tree args))) (apply #'example args) (equalp args before))")) ("S16" ("(equalp (apply #'example '((2 (3 4)))) '14)" "(equalp (apply #'example '((0 (0 8)))) '0)" "(equalp (apply #'example '((-1 (2 -3)))) '-7)")) ("S17" ("(equalp (apply #'example '((1 2 3 4))) '10)" "(equalp (apply #'example '(())) '0)" "(equalp (apply #'example '((-3 -2 0 5))) '34)")) ("S18" ("(equalp (apply #'example '(4 3 5)) '(12 25))" "(equalp (apply #'example '(0 3 0)) '(0 0))" "(equalp (apply #'example '(2 7 3)) '(14 9))")) ("S19" ("(equalp (apply #'example '(4 3 7)) '(7 3 21))" "(equalp (apply #'example '(5 0 2)) '(2 0 0))" "(equalp (apply #'example '(1 8 0)) '(0 8 0))")) ("S20" ("(equalp (apply #'example '(7)) '(14 1))" "(equalp (apply #'example '(0)) '(0 1))" "(equalp (apply #'example '(-3)) '(-6 1))")) ("S21" ("(equalp (apply #'example '(4)) '8)" "(equalp (apply #'example '(0)) '0)" "(equalp (apply #'example '(-1)) '99)")) ("S22" ("(equalp (apply #'example '(0)) '(50 123))" "(equalp (apply #'example '(1)) '(-2 123))" "(equalp (apply #'example '(2)) '(-1 1))" "(equalp (apply #'example '(3)) '(-3 123))" "(equalp (apply #'example '(4)) '(-3 123))")) ("S23" ("(equalp (apply #'example '((2 0 2 0 3))) '((4 0 4 0 9) 3))" "(equalp (apply #'example '(())) '(() 0))" "(equalp (apply #'example '((-2 2 -2))) '((4 4 4) 2))")) ("S24" ("(equalp (apply #'example '((1 2 3))) '6)" "(equalp (apply #'example '(())) '0)" "(equalp (apply #'example '((-2 0 5))) '3)"))))

(format t "RUNTIME ~A ~A~%" (lisp-implementation-type) (lisp-implementation-version))
(dolist (entry *cases*)
  (destructuring-bind (id checks) entry
    (let* ((name (concatenate 'string "SBCL-COMPARISON-" id))
           (package (or (find-package name) (make-package name :use '(#:cl)))))
      (let ((*package* package))
        (load (merge-pathnames (format nil "source/common-lisp/~A.lisp" id) *root*)
              :verbose nil :print nil)
        (when (string= id "S24")
          (load (merge-pathnames "source/common-lisp/S24_host.lisp" *root*)
                :verbose nil :print nil))
        (loop for expression in checks for index from 1
              do (handler-case
                     (if (eval (read-from-string expression))
                         (progn (incf *passed*) (format t "PASS ~A.~D~%" id index))
                         (progn (incf *failed*) (format t "FAIL ~A.~D ~A~%" id index expression)))
                   (error (condition)
                     (incf *failed*)
                     (format t "ERROR ~A.~D ~A~%" id index condition))))))))
(format t "RESULT passed=~D failed=~D~%" *passed* *failed*)
(sb-ext:exit :code (if (zerop *failed*) 0 1))
