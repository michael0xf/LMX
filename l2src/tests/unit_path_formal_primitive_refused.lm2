# D-97. A path off a formal that is a pointer to a primitive: no Structure type, no c.* door.
# Refused, located. Before, `p\length` was emitted as the C member access `l2_p0_0\length`
# and only gcc caught it.
fn: f (@: size_t p) size_t
    return: p\length

sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
