# The machine functions of lmx_clock entered through the C door (route 331, slice 340): the runtime translates
# src/l2src/lmx_clock.lm2 from its clean graph once its frontend reads the module's forms (C door types, casts, calls of
# the door and of the module's own functions, a typed place); the answers are the module's either way. Half of the
# size_t range is SIZE_MAX / 2 + 1; a deadline has passed when now - deadline is below that half (100 at 100 and 150,
# not at 99; 0 not at the half itself, at one below it); the wait left is deadline - now before it passes, then 0; a
# reading of the clock does not go back, and the time since now is small. Exit 7; 80.. name the failing check.
predef: "l2src/lmx_clock.h.lm1"
include: "<stdint.h>"
fn: run () int
    size_t: top c.SIZE_MAX
    size_t: half c.lmx_clock_half()
    size_t: w0 c.lmx_clock_word()
    size_t: s0 0U
    if: half != top / 2U + 1U
        return: 80
    if: c.lmx_deadline_passed(100U, 100U) != 1 || c.lmx_deadline_passed(100U, 150U) != 1 || c.lmx_deadline_passed(100U, 99U) != 0
        return: 81
    if: c.lmx_deadline_passed(0U, half) != 0 || c.lmx_deadline_passed(0U, half - 1U) != 1
        return: 82
    if: c.lmx_deadline_wait(100U, 90U) != 10U || c.lmx_deadline_wait(100U, 100U) != 0U || c.lmx_deadline_wait(100U, 150U) != 0U
        return: 83
    s0: (cast: (size_t) c.lmx_clock_since(c.lmx_clock_now()))
    if: s0 > 60000U
        return: 84
    if: c.lmx_clock_word() < w0 || (cast: (size_t) c.lmx_clock_now()) < w0
        return: 85
    if: c.lmx_clock_ticks() = 0U
        return: 86
    return: 7
end: run
sendMessage: exit(exit_code: run(); stdout: ""; stderr: "")
return
