# Original: parser.lm1:4521 lm_p0_dump_reserve
fn: lm_p0_dump_reserve (@: dump c.LmP0Dump; size_t: extra) int
    @: data char
    size_t: new_capacity
    if: dump\failed
        return: 0
    if: (((dump\length + extra) + 1U) <= dump\capacity)
        return: 1
    if: (dump\capacity = 0U)
        new_capacity: 256U
    else:
        new_capacity: dump\capacity
    ---
    while: (new_capacity < ((dump\length + extra) + 1U))
        new_capacity: new_capacity * 2U
    ---
    data: (cast: (@: char) c.lm_own_resize(dump\data, new_capacity))
    if: (data = 0)
        dump\failed: 1
        return: 0
    dump\data: data
    dump\capacity: new_capacity
    return: 1
end: lm_p0_dump_reserve

# Original: parser.lm1:4543 lm_p0_dump_append
sub: lm_p0_dump_append (@: dump c.LmP0Dump; const: (@: text char); size_t: byte_count)
    if: (lm_p0_dump_reserve(dump, byte_count) = 0)
        return
    c.memcpy(((cast: (@: char) dump\data) + (cast: (size_t) dump\length)), text, byte_count)
    dump\length: dump\length + byte_count
    dump\data[dump\length]: '\0'
end: lm_p0_dump_append

# Original: parser.lm1:4551 lm_p0_dump_append_cstr
sub: lm_p0_dump_append_cstr (@: dump c.LmP0Dump; const: (@: text char))
