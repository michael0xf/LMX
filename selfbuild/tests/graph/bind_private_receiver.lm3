# read видит лексически private x = 7 своей Lib; публичное x = 11 вызывающего его не заменяет: seen 7.
# Норма: ТЗ 2026-11-19, R05, §5.1 п. 2, строка приёмки B11.
(
    Lib:
        private: int: x 7
        fn: read () int
            return: x
        end: read
    end: Lib
    Observed:
        int: seen 0
    end: Observed
)
@: shared data[0]
fn: f () int
    int: x 11
    return: shared\Lib\read()
sub: main ()
    shared\Observed\seen := f()
main()
