        throws: copy(MapThrows)
        if: length(index\keys) != length(index\values)
            throw: MapFailure("index columns differ")
        int: i 1
        while: i < length(index\keys)
            if: \index\keys[i - 1] > \index\keys[i]
                throw: MapFailure("index order")
            i += 1
        return: 1

