Observed:
    int: before 1
    int: after 1
    int: p_after 3
    int: s_after 7
end: Observed
Build:
    int: i 3
    A:
        int: v 7
    end: A
    @: p int (@ i)
    @: s A
    Types:
        @: p int
        @: s A
    end: Types
end: Build
Main: (:= (Observed \ before) 1) Build\Types() (:= (Observed \ after) 1) (:= (Observed \ p_after) (\ (Build \ p))) (:= (Observed \ s_after) ((Build \ s) \ v))
