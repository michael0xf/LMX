BreakerMessage:
    int: now
    @: request
    int: failures 0
    int: until 0
    return: int
    invoke:
        if: now < node\until
            return: -1
        int: ok request()
        if: ok = 1
            node\failures := 0
            node\until := 0
            return: 1
        node\failures += 1
        if: node\failures >= 2
            node\until := now + 5
        return: 0
