(
    # The field marker must survive the ordinary GraphTool image. Its value is readable lexically and explicitly;
    # no dynamic source takes it, and where a method sees it lexically no dynamic source replaces it (book #binding-decisions).
    Library:
        private: (int: x 10)
        fn: read () int
            return: x
    end: Library
    Observed:
        int: private_result 0
        int: public_result 0
        int: library_source 0
        int: header_result 0
)
fn: CodePrivate () int
    @: shared node[0]
    private: (int: x 20)
    x := 21
    return: x * 100 + shared\Library\read()
fn: CodePublic () int
    @: shared node[0]
    int: x 20
    x := 21
    return: x * 100 + shared\Library\read()
fn: DataPrivate (private: (int: x 20)) int
    @: shared node[0]
    x := 21
    return: x * 100 + shared\Library\read()
sub: main ()
    @: shared node[0]
    shared\Observed\private_result := CodePrivate()
    shared\Observed\public_result := CodePublic()
    shared\Observed\library_source := shared\Library\x
    shared\Observed\header_result := DataPrivate()
main()
