        return: (cast: (int) (c.lm_compiler_error(path, source_node, "intern failed memcmp of equal names")))
    if: two != 0 && lm_compiler_intern_eq_mi(cell_intern_probe[0] - 1U, 0) = 0 && cell_intern_probe[0] = id
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "intern false-equal distinct contracts")))
    cell_sigv[0]: id
    return: (cast: (int) (0))
end: lm_compiler_intern_prove
