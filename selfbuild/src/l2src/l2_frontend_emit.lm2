fn: lm_compiler_check_word_stmt (const: (@: stmt c.LmP0Node); const: (@: w c.LmP0Text); const: (@: body c.LmP0Structure); int: mi; const: (@: path char); int: depth) int
    @: loop_depth_cell int (cast: (@: int) (@ c.l2_loop_depth))
    @: m_n_cell int (cast: (@: int) (@ c.l2_m_n))
    @@@: m_node_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_m_node))
    @@@: m_body_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_m_body))
    @: e_cell int (cast: (@: int) (@ c.l2_e))
    @@: m_ret_cell int (cast: (@@: int) (@ c.l2_m_ret))
    int: na c.lm_compiler_count_active(c.lm_compiler_app_actuals(stmt))
    c.L2StructCallPlan: call_plan
    int: msk 0
    int: msni 0
    @: first c.LmP0Field 0
    @: rnm c.LmP0Text 0
    if: c.lm_compiler_text_eq(w, "call")
        # N4 (LMX_semantics.ru.md #method-parts): a code and at most one data Structure, each refused where it stands.
        if: c.lm_compiler_struct_call_plan(stmt, mi, @ call_plan) != 0
            if: call_plan\shape = 3
                return: (cast: (int) (c.lm_compiler_error(path, (cast: (const: @: c.LmP0Node) ((call_plan\extra\value))), "call takes a code and one data operand: a third operand")))
