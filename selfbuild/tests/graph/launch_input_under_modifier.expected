---
    Observed:
        int: seen_y 9
        int: seen_z 5
    end: Observed
---
sub: main () (
    D:
        required:
            int: y
            int: z
        end: required
        int: seen_y 0
        int: seen_z 0
    end: D
    Change: (:= (data \ seen_y) y) (:= (data \ seen_z) z)
    int: result_y 0
    int: result_z 0
)
    call: (:= args ((int y 9) (int z 5))) (:= data D) (:= code Change)
    :=: (data \ result_y) (D \ seen_y)
    :=: (data \ result_z) (D \ seen_z)
end: main
main:
int: result_y ((main \ data) \ result_y)
int: result_z ((main \ data) \ result_z)
sub: observe ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen_y) result_y
    :=: ((shared \ Observed) \ seen_z) result_z
end: observe
observe:
