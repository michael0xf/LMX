# M1: bare callable references, including transparent grouping, are transported without execution.
# An explicit call is a different expression and runs once; it is not another reference spelling.
# Three transports leave hits at0; the explicit task() then increments it to1. Success7.
int: hits 0

sub: task ()
    node\hits: node\hits + 1
end: task

fn: count () int
    return: node\hits
end: count

fn: recv (task: f) int
    return: count()
end: recv

int: a recv(task)
int: b recv((task))
int: c recv(((task)))
int: after count()
if: a != 0 || b != 0 || c != 0
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
if: after != 0
    sendMessage: exit(exit_code: 82; stdout: ""; stderr: "")
    return

task()
int: once count()
if: once != 1
    sendMessage: exit(exit_code: 83; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
