# FABLE-SONNET-CALLABLE-PRIORITY-20260923-130 (closes plan :181/:182/:212/
# :214-priority/:216). Universal priority by resolved binding: a callable
# head is ALWAYS a call, in every surface form -- colon, paren, vertical --
# never assignment or declaration, and not a special case per form. `foo`
# is callable and takes one argument; each call form must run foo's own
# body (observed via its own-field side effects), not silently do nothing
# or misresolve as some other operation.
int: hits 0
int: last 0

fn: foo (int: n) int
    hits: hits + 1
    last: n
    return: 0
end: foo

foo: 5
if: hits != 1
    sendMessage: exit(exit_code: 90; stdout: ""; stderr: "")
    return
if: last != 5
    sendMessage: exit(exit_code: 91; stdout: ""; stderr: "")
    return

foo(6)
if: hits != 2
    sendMessage: exit(exit_code: 92; stdout: ""; stderr: "")
    return
if: last != 6
    sendMessage: exit(exit_code: 93; stdout: ""; stderr: "")
    return

foo:
    7
if: hits != 3
    sendMessage: exit(exit_code: 94; stdout: ""; stderr: "")
    return
if: last != 7
    sendMessage: exit(exit_code: 95; stdout: ""; stderr: "")
    return

sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
