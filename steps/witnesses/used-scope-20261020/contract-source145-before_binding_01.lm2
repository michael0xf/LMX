Need: (int: x; int: sentinel)
Have: (int: sentinel; int: x)
fn: work () int
    Have\sentinel: 17
    @: Need Need Have
    Need\x: 19
    @: address int @ Need\x
    \address: 43
    if: Need\x != 43 || Have\x != 43 || Have\sentinel != 17 || \address != 43
        return: 81
    return: 7
end: work
sendMessage: exit(exit_code: work(); stdout: ""; stderr: "")
return
