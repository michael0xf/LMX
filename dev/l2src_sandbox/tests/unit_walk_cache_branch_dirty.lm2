# §7b witness (book §12: dirty follows an executed write, not the presence of a possible assignment): x is published
# 1 by the call to nop and stays clean because the branch that assigns it is not taken; poke then writes mytest\x: 7,
# and mytest's exit writes nothing back: check reads 7.  The program exits 7; with dirty marked by the assignment's
# presence 1.
fn: nop () int
    return: 0
end: nop

fn: poke () int
    mytest\x: 7
    return: 0
end: poke

fn: mytest (int: n) int
    int: x 1
    nop()
    if: n = 1
        x: 5
    poke()
    return: 0
end: mytest

fn: check () int
    return: mytest\x
end: check

int: v 0
v: mytest(0)
int: w 0
w: check()
sendMessage: exit(exit_code: w + v; stdout: ""; stderr: "")
return
