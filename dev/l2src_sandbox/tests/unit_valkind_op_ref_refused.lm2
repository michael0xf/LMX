# A Structure is a reference: in arithmetic it is refused where it stands, as the walk refuses it (its rule -179:
# a reference stands only where its own type is asked).  `x: b + 1` went out as C adding to the Box's pointer.
Box:
    int: v 0
end: Box
fn: take (int: x) int
    return: x
end: take
fn: peek () int
    b: merge: Box
    int: x 0
    x: b + 1
    return: x
end: peek
int: r 0
r: peek()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
