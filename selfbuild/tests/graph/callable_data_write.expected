---
    Observed:
        int: first 2
        int: second 3
        int: outside 3
    end: Observed
---
fn: f () int (
    Point:
        int: x 1
    end: Point
)
    :=: (Point \ x) ((Point \ x) + 1)
    return: (Point \ x)
end: f
int: first (f)
int: second (f)
int: outside (((f \ data) \ Point) \ x)
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ first) first
    :=: ((shared \ Observed) \ second) second
    :=: ((shared \ Observed) \ outside) outside
end: main
main:
