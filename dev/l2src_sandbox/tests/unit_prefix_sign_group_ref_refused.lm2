# A prefix sign applied to a group asks a number of the group. A group that is
# a reference is refused where the reference stands, not the statement as a
# value of an unknown type. The group holds the reference alone, so the
# refusal is the sign's and not that of an operation inside the group.
Box:
    int: v 0
end: Box
fn: peek () int
    Box: b
    int: x 0
    x: -(b)
    return: x
end: peek
int: r 0
r: peek()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
