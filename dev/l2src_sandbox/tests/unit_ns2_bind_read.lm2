# K03 NS-ROLES-2 (Codex K03-NS-ROLES-2-20261007-20; docs/LMX_semantics.en.md#resolved-head-consumption,
# #declaration-visibility): a named Structure's body takes the common roles of the root and a method.
# box holds Model from the construction on -- `Host\box\v` reads Model's v before anything runs Host -- and Host's
# execution assigns it again, as a reference cell's initializer does.  Exit 7; 81 if box were empty or another
# Structure, 82 after Host runs.
Model:
    int: v 4
end: Model
Host:
    box: Model
end: Host
fn: m () int
    if: Host\box\v != 4
        return: 81
    Host()
    Model\v: 9
    if: Host\box\v != 9
        return: 82
    return: 7
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
