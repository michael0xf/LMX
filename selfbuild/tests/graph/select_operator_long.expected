---
    Observed:
        int: seen 0
        int: r 0
    end: Observed
---
fn: tick () int
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) (((shared \ Observed) \ seen) + 1)
    return: 3
end: tick
fn: f (long: a) int
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ r) 2
    return: 2
end: f
sub: main ()
    f: (1 + (tick))
end: main
main:
