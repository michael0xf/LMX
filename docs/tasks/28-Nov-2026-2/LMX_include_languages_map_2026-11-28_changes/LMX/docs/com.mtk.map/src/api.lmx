    required: value
    return: []char
    format:
        throws: copy(MapThrows)
        if: value < 0
            throw: MapFailure("nonnegative decimal value")
        private: @: digits MapVector\create()
        if: value = 0
            MapVector\push(digits; (48 record))
        while: value > 0
            private: int: digit value % 10 + 48
            MapVector\push(digits; (digit record))
            value := value / 10
        private: @: result ([]char: [])
        sys\resize(result; MapVector\size(digits))
        private: int: i 0
        while: i < length(result)
            private: @: digit MapVector\get(digits; length(result) - i - 1)
            result[i] := \digit
            i += 1
        return: result

