# Distinct MAIN declaration: the part's own h ordering requires no decision
# about a MAIN/part collision with an exported method of the same name.
mainOnly:
    int: p 900
end: mainOnly
int: v getPart()
int: ok 7
if: v != 3 || mainOnly\p != 900
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
