# Code launched over data it was given reads a Structure of that data by reference (plan M11 5b): Inner is found in the
# registry of the launch's data, with no row of its own.
Code:
    int: y
    y := Inner\x
end: Code
D:
    Inner:
        int: x 4
    end: Inner
    int: y 0
end: D
call: D Code
int: seen D\y
