# Original: l2src/l2trans.lm1:4423
fn: lm_compiler_urm_add (const: (@: item c.LmP0Node)) int
    @: urm_n_cell int (cast: (@: int) (@ c.l2_urm_n))
    @: urm_cap_cell int (cast: (@: int) (@ c.l2_urm_cap))
    @@@: urm_at_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_urm_at))
    @@: urm_val_cell int (cast: (@@: int) (@ c.l2_urm_val))
