    return: (cast: (int) (status))
end: lm_compiler_path_walk_bound

# Original: l2src/l2trans.lm1:25520
fn: lm_compiler_path_selected_contract (const: (@: path c.L2Path); int: mi) @: c.L2TypeContract
    @@@: own_decl_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_own_decl))
    if: path\root_contract_own >= 0
        return: (cast: (@: c.L2TypeContract) (lm_compiler_decl_contract((cast: (const: @: c.LmP0Node) (own_decl_cell[0][path\root_contract_own])))))
    if: path\fi >= 0 && mi >= 0
