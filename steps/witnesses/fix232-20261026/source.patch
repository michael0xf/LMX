+fn: shape_spell_is (const: (@: text char); const: (@: word char)) int
+    int: n 0
+    int: i 0
+    if: text = 0 || word = 0
+        return: 0
+    if: c.strcmp(text, word) = 0
+        return: 1
+    if: text[0] != 34
+        return: 0
+    while: text[n] != 0
+        n: n + 1
+    if: n < 2 || text[n - 1] != 34
+        return: 0
+    while: word[i] != 0 && i + 1 < n && text[i + 1] = word[i]
+        i: i + 1
+    if: word[i] = 0 && i + 2 = n
+        return: 1
+    return: 0
+end: shape_spell_is
