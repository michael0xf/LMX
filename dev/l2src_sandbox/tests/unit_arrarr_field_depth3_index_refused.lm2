# A three-level field: two indices select an inner Array, a value (R5-3a) the walked path reader does not build
# yet through a typed root -- the step list's (R5-3b/R5-4); said at the read, never emitted.
Holder:
    int: []: []: []: deep
end: Holder
h: merge: Holder
if: h\deep[0][1] != 0
    sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
