# unit_empty_self_admit_method under --walk-methods (OPUS-Q54-CONTINUE-20260929-14): the method stays native.  Its
# `f()` is an admission site, which puts it on the throw channel, and the walk takes no method that throws
# (l2_rw_may) -- as for every admitting method -- so the knob does not change how the Frame resolves: r 7 (an
# admission to S's type would give 64).  Pinned native.
S:
    size_t: v 4U
fn: m () int
    int: r 7
    f()
    f()
    f: ()
    catch: implements ()
        r: 64
    int: out r
    return: out
end: m
int: r 0
r: m()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
