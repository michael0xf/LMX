        ---
    \out_ty: ty
    if: dest = 0
        return: (cast: (int) (0))
    if: c.lm_compiler_pointer_depth(ty) > 0
        return: (cast: (int) (c.lm_compiler_pointer_decl_text(ty, 0, 0, dest)))
    if: ty >= 100
        return: (cast: (int) (c.lm_compiler_tok_tx(dest, foreign_name_cell[0][ty - 100])))
    if: c.lm_compiler_prim_code_name(ty) = 0
        return: (cast: (int) (1))
    return: (cast: (int) (c.lm_compiler_tx_set(dest, c.lm_compiler_prim_code_name(ty))))
end: lm_compiler_cast_resolve

fn: lm_compiler_cast_type (const: (@: source_node c.LmP0Node); @: dest c.L2Tx) int
    int: ty
    return: (cast: (int) (lm_compiler_cast_resolve(source_node, @ ty, dest)))
end: lm_compiler_cast_type

fn: lm_compiler_value_type_operand (@: value c.L2ValueSpan; @: type int; @: text c.L2Tx) int
    @: values c.L2ValueSpan
    @: word c.LmP0Text
    int: n
    int: k 0
    int: child_type
    int: status
    if: value = 0 || value\node = 0 || value\node\as = 0
        return: (cast: (int) (2))
    if: value\values != 0 && value\value_n = 1 && (value\grammar = 3 || value\node\kind = c.LM_P0_NODE_STRUCTURE)
        return: (cast: (int) (lm_compiler_value_type_operand((cast: (@: c.L2ValueSpan) (value\values)), type, text)))
    if: value\count != 1
        return: (cast: (int) (2))
    if: value\node\kind = c.LM_P0_NODE_ATOM
        word: value\node\as\atom
        if: lm_compiler_prim_type_word(word) != 0
            return: (cast: (int) (lm_compiler_cast_resolve((cast: (const: @: c.LmP0Node) (value\node)), type, text)))
        if: c.lm_compiler_c_stmt_door(word) != 0
            \type: -12
            if: text != 0
                return: (cast: (int) (c.lm_compiler_tok_tx(text, word)))
            return: (cast: (int) (0))
        return: (cast: (int) (2))
    values: c.lm_compiler_primary_values(value, @ n)
    if: n < 0
        return: (cast: (int) (1))
    if: value\node\kind = c.LM_P0_NODE_FRAME && c.lm_compiler_address_depth(value\node\as\frame\head) > 0 && n = 1
        status: lm_compiler_value_type_operand(values, @ child_type, 0)
        if: status != 0
            return: (cast: (int) (status))
        return: (cast: (int) (lm_compiler_cast_resolve((cast: (const: @: c.LmP0Node) (value\node)), type, text)))
    if: value\node\kind = c.LM_P0_NODE_STRUCTURE && n > 0
        while: k < n
            @: item_view c.L2ValueSpan (cast: (@: c.L2ValueSpan) (@ values[k]))
            if: item_view\count != 1
                return: (cast: (int) (2))
            @: item_node c.LmP0Node (cast: (@: c.LmP0Node) c.lm_compiler_span_node(values, k))
            if: item_node\kind != c.LM_P0_NODE_ATOM
                return: (cast: (int) (2))
            @: item_node_again c.LmP0Node (cast: (@: c.LmP0Node) c.lm_compiler_span_node(values, k))
            if: c.lm_compiler_ctype_word(item_node_again\as\atom) = 0
                return: (cast: (int) (2))
            k: k + 1
        ---
        return: (cast: (int) (lm_compiler_cast_resolve((cast: (const: @: c.LmP0Node) (value\node)), type, text)))
    ---
    return: (cast: (int) (2))
end: lm_compiler_value_type_operand

fn: lm_compiler_primary_sizeof_type (@: value c.L2ValueSpan) int
    c.L2ValueSpan: operand
    int: type
    if: value = 0 || c.lm_compiler_frame_head(value\node, "sizeof") = 0 || c.lm_compiler_primary_slice(value, 0, -1, @ operand) != 0
        return: (cast: (int) (0))
    return: (cast: (int) ((cast: (int) (lm_compiler_value_type_operand(@ operand, @ type, 0) = 0))))
end: lm_compiler_primary_sizeof_type

fn: lm_compiler_snap_bytes (const: (@: path char); @: len size_t) const: @: char
    @: snap_n_cell int (cast: (@: int) (@ c.l2_snap_n))
    @@@: snap_path_cell char (cast: (@@@: char) (@ c.l2_snap_path))
    @@: snap_len_cell size_t (cast: (@@: size_t) (@ c.l2_snap_len))
    @@@: snap_data_cell char (cast: (@@@: char) (@ c.l2_snap_data))
    @: snap_cap_cell int (cast: (@: int) (@ c.l2_snap_cap))
    @@@: snap_doc_cell c.LmP0Document (cast: (@@@: c.LmP0Document) (@ c.l2_snap_doc))
    int: i 0
    int: cap
    size_t: n
    @: data char
    @: name char
    @@: np char
    @@: nd char
    @: nl size_t
    @@: nv c.LmP0Document
    if: path = 0 || len = 0
        return: (cast: (const: @: char) (0))
    while: i < snap_n_cell[0]
        if: c.strcmp(snap_path_cell[0][i], path) = 0
            \len: snap_len_cell[0][i]
            return: (cast: (const: @: char) (snap_data_cell[0][i]))
        i: i + 1
    ---
    if: snap_n_cell[0] >= snap_cap_cell[0]
        cap: snap_cap_cell[0]
        if: cap < 1
            cap: 8
        while: cap <= snap_n_cell[0]
            if: cap > c.INT_MAX / 2
                return: (cast: (const: @: char) (0))
            cap: cap * 2
        ---
        np: (cast: (@@: char) c.lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof((cast: (@: char) 0))))
        nd: (cast: (@@: char) c.lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof((cast: (@: char) 0))))
        nl: (cast: (@: size_t) c.lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(c.size_t)))
        nv: (cast: (@@: c.LmP0Document) c.lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof((cast: (@: c.LmP0Document) 0))))
        if: np = 0 || nd = 0 || nl = 0 || nv = 0
            if: np != 0
                c.lm_compiler_xfree((cast: (@: void) np))
            if: nd != 0
                c.lm_compiler_xfree((cast: (@: void) nd))
            if: nl != 0
                c.lm_compiler_xfree((cast: (@: void) nl))
            if: nv != 0
                c.lm_compiler_xfree((cast: (@: void) nv))
            return: (cast: (const: @: char) (0))
        ---
        i: 0
        while: i < snap_n_cell[0]
            np[i]: snap_path_cell[0][i]
            nd[i]: snap_data_cell[0][i]
            nl[i]: snap_len_cell[0][i]
            nv[i]: snap_doc_cell[0][i]
            i: i + 1
        ---
        if: snap_path_cell[0] != 0
            c.lm_compiler_xfree((cast: (@: void) snap_path_cell[0]))
        if: snap_data_cell[0] != 0
            c.lm_compiler_xfree((cast: (@: void) snap_data_cell[0]))
        if: snap_len_cell[0] != 0
            c.lm_compiler_xfree((cast: (@: void) snap_len_cell[0]))
        if: snap_doc_cell[0] != 0
            c.lm_compiler_xfree((cast: (@: void) snap_doc_cell[0]))
        snap_path_cell[0]: np
        snap_data_cell[0]: nd
        snap_len_cell[0]: nl
        snap_doc_cell[0]: nv
        snap_cap_cell[0]: cap
    ---
    data: c.lm_compiler_snap_read(path, len)
    if: data = 0
        return: (cast: (const: @: char) (0))
    n: c.strlen(path)
    name: (cast: (@: char) c.lm_compiler_xmalloc(n + 1U))
    if: name = 0
        c.lm_compiler_xfree((cast: (@: void) data))
        return: (cast: (const: @: char) (0))
    c.memcpy(name, path, n + 1U)
    snap_path_cell[0][snap_n_cell[0]]: name
    snap_data_cell[0][snap_n_cell[0]]: data
    snap_len_cell[0][snap_n_cell[0]]: \len
    snap_doc_cell[0][snap_n_cell[0]]: 0
    snap_n_cell[0]: snap_n_cell[0] + 1
    return: (cast: (const: @: char) (data))
end: lm_compiler_snap_bytes

fn: lm_compiler_snap_document (const: (@: path char)) @: c.LmP0Document
    @: snap_n_cell int (cast: (@: int) (@ c.l2_snap_n))
    @@@: snap_data_cell char (cast: (@@@: char) (@ c.l2_snap_data))
    @@@: snap_doc_cell c.LmP0Document (cast: (@@@: c.LmP0Document) (@ c.l2_snap_doc))
    int: i 0
    size_t: n 0U
    const: (@: data char)
    @: document c.LmP0Document 0
    data: lm_compiler_snap_bytes(path, @ n)
    if: data = 0
        return: (cast: (@: c.LmP0Document) (0))
    while: i < snap_n_cell[0] && snap_data_cell[0][i] != data
        i: i + 1
    if: i >= snap_n_cell[0]
        return: (cast: (@: c.LmP0Document) (0))
    if: snap_doc_cell[0][i] = 0
        if: c.lm_p0_parse_bytes(data, n, @ document) != 0 || document = 0
            if: document != 0
                c.lm_p0_document_destroy(document)
            return: (cast: (@: c.LmP0Document) (0))
        ---
        snap_doc_cell[0][i]: document
    ---
    return: (cast: (@: c.LmP0Document) (snap_doc_cell[0][i]))
end: lm_compiler_snap_document
