predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_plan.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# -174 c2: PUT Structure into pointer cell (type-checked); Own SET writes pointer cell immediately (-188).
# Mutant: PUT/SET without STRUCT kind check -> wrong-type RED.

@: LmxArena ga 0
@: Lmx groles 0
@: Lmx gplan_roles 0
@: LmxWalkContext gctx 0
@: LmxWalkValue gv 0
int: broken 0
int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(ga, groles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(ga, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

sub: ref (@: Lmx code; size_t: slot; @: Lmx target)
    if: code = 0 || target = 0 || lmx_arena_ref_store(code, slot, (cast: (@: void) target)) != 0
        broken: broken + 1
    ---
end: ref

sub: sz (@: Lmx code; size_t: slot; size_t: value)
    if: code = 0 || lmx_walk_store_size(ga, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: sz

fn: mk_m (@: Lmx unit; size_t: slot; size_t: children) @: Lmx
    @: Lmx m pl(unit, slot, children)
    @: LmxCallable info lmx_callable_new_owned(ga)
    if: m = 0 || info = 0 || lmx_arena_ref_store(m, 0U, (cast: (@: void) info)) != 0
        broken: broken + 1
        return: 0
    ---
return: m

fn: go (@: Lmx m) int
    int: st
    if: m = 0 || gctx = 0 || gv = 0
        return: c.LMX_WALK_INVALID
    st: lmx_walk_prepare(gctx, ga, gplan_roles, m)
    if: st != c.LMX_WALK_OK
        return: st
return: lmx_walk_run(gctx, m, 0, 0U, gv)

fn: main () int
    LmxArena: arena
    LmxArena: context_arena
    LmxPool: context_cells
    LmxScratch: store
    LmxWalkContext: context
    @: Lmx unit 0
    @: Lmx m 0
    @: Lmx n 0
    @: Lmx holder 0
    @: Lmx model 0
    @: Lmx model2 0
    @: Lmx putn 0
    @: Lmx atn 0
    @: Lmx ownn 0
    @: void pcell 0
    int: st 0
    int: pty c.LMX_TYPE_POINTER_BASE + 7

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        return: 2
    ga: @ arena
    groles: lmx_walk_roles_open(ga)
    gplan_roles: lmx_plan_roles_open(ga)
    memset((cast: (@: void) (@ context_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxScratch))
    if: lmx_arena_open(@ context_arena) != 0 || lmx_scratch_open(@ store, @ context_arena, @ context_cells, 16U) != c.LMX_SCRATCH_OK
        return: 2
    context.arena: ga
    context.scratch: @ store
    context.roles: groles
    context.plan_roles: gplan_roles
    context.immutable_profile: 0
    context.classified: 0U
    gctx: @ context
    gv: (cast: (@: LmxWalkValue) calloc(1U, c.sizeof(c.LmxWalkValue)))

    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 8U) != 0
        return: 2
    ---
    holder: pl(unit, 1U, 2U)
    model: pl(unit, 2U, 2U)
    model2: pl(unit, 3U, 2U)
    if: holder = 0 || model = 0 || model2 = 0 || lmx_walk_store_int(ga, model, 1U, 42) != c.LMX_WALK_OK || lmx_walk_store_int(ga, model2, 1U, 99) != c.LMX_WALK_OK
        return: 2
    pcell: lmx_pointer_new_owned(pty, ga)
    if: pcell = 0 || lmx_arena_ref_store(holder, 1U, pcell) != 0
        return: 2

    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_PUT, 4U)
    ref(n, 1U, holder)
    sz(n, 2U, 1U)
    ref(n, 3U, model)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && lmx_pointer_value_known(pcell) = (cast: (@: void) model))), "put Structure into pointer")

    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_PUT, 4U)
    ref(n, 1U, holder)
    sz(n, 2U, 1U)
    atn: fr(n, 3U, c.LMX_WALK_OP_LIT, 2U)
    if: atn != 0 && lmx_walk_store_int(ga, atn, 1U, 7) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_INVALID)), "put int into pointer INVALID")

    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_PUT, 4U)
    ref(n, 1U, holder)
    sz(n, 2U, 1U)
    ref(n, 3U, model2)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && lmx_pointer_value_known(pcell) = (cast: (@: void) model2))), "put model2")

    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    putn: fr(n, 1U, c.LMX_WALK_OP_OF, 3U)
    atn: fr(putn, 1U, c.LMX_WALK_OP_DEREF, 2U)
    ownn: fr(atn, 1U, c.LMX_WALK_OP_AT, 3U)
    ref(ownn, 1U, holder)
    sz(ownn, 2U, 1U)
    sz(putn, 2U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref != 0 && lmx_int_value_known(gv\ref) = 99)), "read after put model2")

    # Own: pointer cell field of M; SET own := model; RET own; cell holds model (-188).
    m: mk_m(unit, 0U, 4U)
    pcell: lmx_pointer_new_owned(pty, ga)
    if: pcell = 0 || lmx_arena_ref_store(m, 1U, pcell) != 0
        return: 2
    ---
    n: fr(m, 2U, c.LMX_WALK_OP_SET, 3U)
    ownn: fr(n, 1U, c.LMX_WALK_OP_OWN, 3U)
    ref(ownn, 1U, m)
    sz(ownn, 2U, 1U)
    ref(n, 2U, model)
    n: fr(m, 3U, c.LMX_WALK_OP_RET, 2U)
    ownn: fr(n, 1U, c.LMX_WALK_OP_OWN, 3U)
    ref(ownn, 1U, m)
    sz(ownn, 2U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) model) && lmx_pointer_value_known(pcell) = (cast: (@: void) model))), "Own SET pointer cell immediate")

    # Own.ref wrong type: SET int into pointer own -> INVALID
    m: mk_m(unit, 0U, 3U)
    pcell: lmx_pointer_new_owned(pty, ga)
    if: pcell = 0 || lmx_arena_ref_store(m, 1U, pcell) != 0
        return: 2
    ---
    n: fr(m, 2U, c.LMX_WALK_OP_SET, 3U)
    ownn: fr(n, 1U, c.LMX_WALK_OP_OWN, 3U)
    ref(ownn, 1U, m)
    sz(ownn, 2U, 1U)
    atn: fr(n, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: atn != 0 && lmx_walk_store_int(ga, atn, 1U, 3) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_INVALID)), "Own.ref set int INVALID")

    c.printf("lmx_walk_ref_put_selftest checks=%d failures=%d broken=%d\n", checks, failures, broken)
    if: failures != 0 || broken != 0
        return: 1
return: 0
