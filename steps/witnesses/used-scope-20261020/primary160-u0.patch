+# A primary's arguments are the ordinary field preparations,not an admitted
+# arithmetic expression. P0 and the shared head cache retain source topology;
+# only the compilation owns that cache. The value owns body/trailer children.
+fn: l2_primary_prepare (@: L2ValueSpan span) int
+    @: LmP0Frame frame
+    @: L2PrimaryBody primary
+    @: L2HeadExpression head
+    int: status
+    int: count
+    if: span = 0 || span\node = 0 || span\node\kind != c.LM_P0_NODE_FRAME || span\node\as = 0 || span\node\as\frame = 0
+        return: 0
+    primary: (cast: (@: L2PrimaryBody) l2_xmalloc(c.sizeof(c.L2PrimaryBody)))
+    if: primary = 0
+        return: 1
+    memset(primary, 0, c.sizeof(c.L2PrimaryBody))
+    span\primary: primary
+    primary\source: span\node
+    frame: span\node\as\frame
+    count: l2_count_active(frame\body)
+    if: count > 0 && span\values = 0 && span\prepared = 0
+        primary\body: l2_value_fields(frame\body\first_field, count, @ primary\body_n)
+        if: primary\body = 0
+            return: 1
+        ---
+    ---
+    if: frame\trailer != 0 && frame\trailer\body != 0
+        count: l2_count_active(frame\trailer\body)
+        if: count > 0
+            primary\trailer: l2_value_fields(frame\trailer\body\first_field, count, @ primary\trailer_n)
+            if: primary\trailer = 0
+                return: 1
+            ---
+        ---
+    ---
+    head: l2_head_expression(span\node, @ status)
+    if: status = 2
+        return: 1
+return: 0
