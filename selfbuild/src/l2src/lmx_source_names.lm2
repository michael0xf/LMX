# The binding of graph occurrences to the codes of their spellings (IDENTIFIER-CODES: the author's decision of
# 2026-11-07; the spellings themselves are only in the two tables of lmx_ids). The walker reads the receiver head of a
# fn occurrence from this table by its code. A key is the actual occurrence (Frame/leaf) or an owning child-cell
# address, not necessarily its referent; neither Lmx nor an atom receives a name field. A row is a service cell of the
# arena's source-name array; it holds the code, never the spelling's bytes, so a copy carries the code and nothing reads
# a spelling to bind, compare or copy an occurrence.
#
# A machine module (L2 section 20): each function has a direct C-compatible entry, and the kernel's code calls it with
# its explicit arguments. Its header, lmx_source_names.h.lm1 -- the row record LmxSourceName and the prototypes of its
# exports -- is written by L3 code of the recipe (decl_source_names, tools/build.lm2); lmx_source_name_local and
# lmx_source_name_row_at are the module's own. The records it reads and writes (LmxArena, LmxPool, LmxChunk) are in the
# kernel's headers; the arena's acts (lmx_arena_take, lmx_range_*), the pools' (lmx_chunk_data, lmx_chunk_cells,
# lmx_pool_is_sealed, lmx_pool_chunk_at) and the C library's are the kernel's C functions, called through the C door.
predef: "l2src/lmx_source_names.h.lm1"
predef: "l2src/lmx_pool.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<string.h>"

# Attach can join several pools of the same service type. Lookup/retirement
# visits their ordinary inventory; there is no owner-global shadow registry.
fn: lmx_source_name_local (@: arena c.LmxArena; @: key void; size_t: port) @: c.LmxSourceName
    @: pool c.LmxPool 0
    @: chunk c.LmxChunk 0
    @: rows c.LmxSourceName 0
    @: row c.LmxSourceName 0
    size_t: i 0U
    size_t: n 0U
    pool: (cast: (@: LmxPool) arena\arrays)
    while: pool != 0
        if: pool\kind = c.LMX_KIND_SOURCE_NAME && pool\type = c.LMX_TYPE_SOURCE_NAME
            chunk: (cast: (@: LmxChunk) pool\head)
            while: chunk != 0
                # Revert may retire storage without removing the chunk record.
                # Only its still-registered local interval belongs to this table.
                if: (cast: (@: LmxPool) c.lmx_range_interval_pool(arena, (cast: (@: void) c.lmx_chunk_data(chunk)))) = pool
                    rows: (cast: (@: LmxSourceName) c.lmx_chunk_data(chunk))
                    n: (cast: (size_t) c.lmx_chunk_cells(chunk, (cast: (size_t) pool\stride)))
                    i: 0U
                    while: i < n
                        row: rows + i
                        if: row\key = key && row\port = port
                            return: row
                        i: i + 1U
                    ---
                ---
                chunk: (cast: (@: LmxChunk) chunk\next)
            ---
        ---
        pool: (cast: (@: LmxPool) pool\next)
    ---
    return: 0
end: lmx_source_name_local

# The row of a key's port: this arena's, or else the one of the key's true home. Inspection/copy runs with exclusive
# ownership of the searched source inventories, including a foreign home. Sealing a key alone does not make its owner's
# still-mutable metadata inventory concurrent-readable.
fn: lmx_source_name_row_at (@: arena c.LmxArena; @: key void; size_t: port) @: c.LmxSourceName
    @: row c.LmxSourceName 0
    @: home c.LmxArena 0
    if: arena = 0 || key = 0
        return: 0
    row: lmx_source_name_local(arena, key, port)
    if: row != 0
        return: row
    home: (cast: (@: LmxArena) c.lmx_range_home(arena, key))
    if: home != 0 && home != arena
        return: lmx_source_name_local(home, key, port)
    return: 0
end: lmx_source_name_row_at

fn: lmx_source_name_get (@: arena c.LmxArena; @: key void) size_t
    return: lmx_source_name_get_at(arena, key, 0U)
end: lmx_source_name_get

# Port zero names the physical occurrence. Positive ports name the ordinary Structure's own free inputs in declaration
# order. The code of the port's spelling, 0 for none.
fn: lmx_source_name_get_at (@: arena c.LmxArena; @: key void; size_t: port) size_t
    @: row c.LmxSourceName lmx_source_name_row_at(arena, key, port)
    if: row = 0
        return: 0U
    return: row\code
end: lmx_source_name_get_at

# A separate port records the physical occurrence's compiled data interface.
# Its spec has exactly the lifetime of the compiled word.
fn: lmx_source_places (@: arena c.LmxArena; @: key void) @: c.LmxSourceName
    if: arena = 0 || key = 0
        return: 0
    return: lmx_source_name_row_at(arena, key, (cast: (size_t) -1))
end: lmx_source_places

# Store the written receiver's layout on its physical slot. The current
# value of that slot can change after construction.
fn: lmx_source_place_model_set (@: arena c.LmxArena; @: slot void; @: layout void) int
    if: slot = 0 || layout = 0
        return: 1
    @: row c.LmxSourceName lmx_source_places(arena, slot)
    if: row != 0
        return: (cast: (int) (row\model_layout != layout))
    if: lmx_source_name_prepare_at(arena, slot, (cast: (size_t) -1), 0U, @ row) != 0 || row = 0
        return: 1
    row\model_layout: layout
    lmx_source_name_publish(row, slot)
    return: 0
end: lmx_source_place_model_set

# What the known Consumers of this place use of the value standing there (the translator's static cells, LmxImplUses): the requirement of the place.  No row of it says nothing is
# known of them, which is no requirement.  It is of this physical place: a copy's place has its own Consumers, so a copy does not carry it.
fn: lmx_source_place_uses_set (@: arena c.LmxArena; @: slot void; @: cells size_t) int
    if: slot = 0 || cells = 0
        return: 1
    @: row c.LmxSourceName lmx_source_places(arena, slot)
    if: row = 0
        return: 1
    row\place_uses: cells
    return: 0
end: lmx_source_place_uses_set

# The compiled data interface of an occurrence: its spec (m, SIZE_MAX, then a pair of the name's code and the required
# type per name), the generated word's static table.
fn: lmx_source_places_set (@: arena c.LmxArena; @: key void; @: spec size_t) int
    if: spec = 0
        return: 1
    @: row c.LmxSourceName lmx_source_places(arena, key)
    if: row != 0
        return: (cast: (int) (row\place_spec != spec))
    if: lmx_source_name_prepare_at(arena, key, (cast: (size_t) -1), 0U, @ row) != 0 || row = 0
        return: 1
    row\place_spec: spec
    lmx_source_name_publish(row, key)
    return: 0
end: lmx_source_places_set

# A stable arena service cell. prepare leaves key zero until publication.
fn: lmx_source_name_prepare (@: arena c.LmxArena; @: key void; size_t: code; @@: out c.LmxSourceName) int
    return: lmx_source_name_prepare_at(arena, key, 0U, code, out)
end: lmx_source_name_prepare

fn: lmx_source_name_prepare_at (@: arena c.LmxArena; @: key void; size_t: port; size_t: code; @@: out c.LmxSourceName) int
    @: known c.LmxSourceName 0
    @: row c.LmxSourceName 0
    if: out = 0
        return: 1
    out[0]: 0
    if: arena = 0 || key = 0
        return: 1
    known: lmx_source_name_row_at(arena, key, port)
    if: known != 0
        # One actual occurrence has one spelling, so one code. Aliases use distinct source
        # places; they do not silently overwrite the referent's name.
        return: (cast: (int) (known\code != code))
    # New rows belong to actual local source places. An imported occurrence
    # consults its existing true owner's table; a borrower cannot invent a
    # second owner for the name of a foreign/raw key.
    if: (cast: (@: LmxPool) c.lmx_range_pool(arena, key)) = 0
        return: 1
    # Append one real service cell. key=0 is unpublished, not a reusable slot:
    # several pending rows must have distinct places.
    row: (cast: (@: LmxSourceName) c.lmx_arena_take(arena, c.sizeof(c.LmxSourceName), c.LMX_KIND_SOURCE_NAME, c.LMX_TYPE_SOURCE_NAME))
    if: row = 0
        return: 1
    row\key: 0
    row\port: port
    row\code: code
    row\place_spec: 0
    row\model_layout: 0
    row\place_uses: 0
    row\place_callable: 0
    row\pending_next: 0
    out[0]: row
    return: 0
end: lmx_source_name_prepare_at

sub: lmx_source_name_publish (@: row c.LmxSourceName; @: key void)
    if: row != 0
        row\pending_next: 0
        row\key: key
    ---
end: lmx_source_name_publish

sub: lmx_source_name_cancel (@: row c.LmxSourceName)
    if: row != 0
        row\key: 0
        row\pending_next: 0
        row\code: 0U
    ---
end: lmx_source_name_cancel

fn: lmx_source_name_set (@: arena c.LmxArena; @: key void; size_t: code) int
    return: lmx_source_name_set_at(arena, key, 0U, code)
end: lmx_source_name_set

fn: lmx_source_name_set_at (@: arena c.LmxArena; @: key void; size_t: port; size_t: code) int
    @: row c.LmxSourceName 0
    if: lmx_source_name_prepare_at(arena, key, port, code, @ row) != 0
        return: 1
    lmx_source_name_publish(row, key)
    return: 0
end: lmx_source_name_set_at

# Retire before an address can be reused. The range has not been freed yet. The addresses are compared as integers
# held by size_t, as the arena's module does (a system header's typedef names no L2 local).
sub: lmx_source_names_drop (@: arena c.LmxArena; @: lo void; @: hi void)
    @: pool c.LmxPool 0
    @: chunk c.LmxChunk 0
    @: rows c.LmxSourceName 0
    @: row c.LmxSourceName 0
    size_t: i 0U
    size_t: n 0U
    size_t: low (cast: (size_t) lo)
    size_t: high (cast: (size_t) hi)
    size_t: key 0U
    size_t: place 0U
    size_t: declared 0U
    pool: (cast: (@: LmxPool) arena\arrays)
    while: pool != 0
        if: pool\kind = c.LMX_KIND_SOURCE_NAME && pool\type = c.LMX_TYPE_SOURCE_NAME
            chunk: (cast: (@: LmxChunk) pool\head)
            while: chunk != 0
                if: (cast: (@: LmxPool) c.lmx_range_interval_pool(arena, (cast: (@: void) c.lmx_chunk_data(chunk)))) = pool
                    rows: (cast: (@: LmxSourceName) c.lmx_chunk_data(chunk))
                    n: (cast: (size_t) c.lmx_chunk_cells(chunk, (cast: (size_t) pool\stride)))
                    i: 0U
                    while: i < n
                        row: rows + i
                        key: (cast: (size_t) row\key)
                        place: (cast: (size_t) row)
                        # Retire the row of a retired key, and a row whose own cell retires.
                        if: (key >= low && key < high) || (place >= low && place < high)
                            lmx_source_name_cancel(row)
                        # A declared callable that leaves takes its declaration along (lmx_source_place_callable_set).
                        declared: (cast: (size_t) row\place_callable)
                        if: declared >= low && declared < high
                            row\place_callable: 0
                        i: i + 1U
                    ---
                ---
                chunk: (cast: (@: LmxChunk) chunk\next)
            ---
        ---
        pool: (cast: (@: LmxPool) pool\next)
    ---
end: lmx_source_names_drop

# Run only after a complete ordinary graph mark. Keys are weak: this pass never marks them; it cancels the rows of dead
# occurrences and marks the service chunks of the live ones. A row holds a code, no spelling storage, so nothing else
# is marked: the spellings live in the process's tables (lmx_ids), outside every arena.
fn: lmx_source_names_mark (@: arena c.LmxArena; unsigned: gen) int
    @: pool c.LmxPool 0
    @: owner c.LmxPool 0
    @: chunk c.LmxChunk 0
    @: held c.LmxChunk 0
    @: rows c.LmxSourceName 0
    @: row c.LmxSourceName 0
    size_t: i 0U
    size_t: n 0U
    int: live 0
    int: pass 0
    # Decide every weak key against the completed ordinary mark FIRST, then mark the chunks of the rows kept, so a
    # stamped row chunk never turns a previously dead occurrence into a live one.
    while: pass < 2
        pool: (cast: (@: LmxPool) arena\arrays)
        while: pool != 0
            if: pool\kind = c.LMX_KIND_SOURCE_NAME && pool\type = c.LMX_TYPE_SOURCE_NAME
                chunk: (cast: (@: LmxChunk) pool\head)
                while: chunk != 0
                    if: (cast: (@: LmxPool) c.lmx_range_interval_pool(arena, (cast: (@: void) c.lmx_chunk_data(chunk)))) = pool
                        rows: (cast: (@: LmxSourceName) c.lmx_chunk_data(chunk))
                        n: (cast: (size_t) c.lmx_chunk_cells(chunk, (cast: (size_t) pool\stride)))
                        i: 0U
                        while: i < n
                            row: rows + i
                            if: row\key != 0
                                if: pass = 0
                                    live: 0
                                    owner: (cast: (@: LmxPool) c.lmx_range_pool(arena, row\key))
                                    if: owner != 0
                                        if: c.lmx_pool_is_sealed(owner) != 0
                                            live: 1
                                        else:
                                            held: (cast: (@: LmxChunk) c.lmx_pool_chunk_at(owner, row\key))
                                            if: held != 0 && held\mark = gen
                                                live: 1
                                            ---
                                        ---
                                    ---
                                    if: live = 0
                                        lmx_source_name_cancel(row)
                                    ---
                                else:
                                    chunk\mark: gen
                                ---
                            ---
                            i: i + 1U
                        ---
                    ---
                    chunk: (cast: (@: LmxChunk) chunk\next)
                ---
            ---
            pool: (cast: (@: LmxPool) pool\next)
        ---
        pass: pass + 1
    ---
    return: 0
end: lmx_source_names_mark

# Slice 286 (CALLABLE-PLACE-FREE-SIGNATURE; Codex, 285 norm answers item 3): the callable a callable field's definition put in
# its physical slot.  The slot's declaration, as a Structure field's model is (lmx_source_place_model_set): it survives later
# assignments there, and every later write there is admitted against it (lmx_implements_receive_cell).  The declared callable
# is a live dependency of its slot (lmx_gc_mark_impl).
fn: lmx_source_place_callable_set (@: arena c.LmxArena; @: slot void; @: declared void) int
    if: slot = 0 || declared = 0
        return: 1
    @: row c.LmxSourceName lmx_source_places(arena, slot)
    if: row != 0
        if: row\place_callable = 0
            row\place_callable: declared
        return: (cast: (int) (row\place_callable != declared))
    if: lmx_source_name_prepare_at(arena, slot, (cast: (size_t) -1), 0U, @ row) != 0 || row = 0
        return: 1
    row\place_callable: declared
    lmx_source_name_publish(row, slot)
    return: 0
end: lmx_source_place_callable_set
