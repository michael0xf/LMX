int: k 4
sub: main () (
    prepared:
        name: triple
        args:
            int: a
        end: args
        return: int
        data:
            int: calls 0
        end: data
        code: ((:= calls (calls + 1)) (int last a) (return ((last * 3) + k)))
    end: prepared
    fn: prepared
    fn: other prepared
    int: r1 0
    int: r2 0
    int: c1 0
    int: c2 0
    int: r3 0
    int: c3 0
    int: c4 0
)
    :=: r1 ((triple 5))
    :=: r2 ((triple 2))
    :=: c1 ((triple \ data) \ calls)
    :=: c2 ((triple \ data) \ last)
    :=: r3 ((other 3))
    :=: c3 ((other \ data) \ calls)
    :=: c4 ((other \ data) \ last)
end: main
:=: k 4
