    fn: lm_graph_check_root (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena arena; @: Lmx code; @: LmxWalkValue input; @: LmxWalkValue result) int
        @: LmxGraph g lmx_graph_find(arena)
        @: Lmx unit (cast: (@: Lmx) lmx_graph_get(code, 0U))
        int: status 0
        int: count 0
        if: g = 0 || unit = 0 || lmx_graph_dump_marked(g, unit, c.stdout, "BEFORE") != 0
            return: 1
        while: count < 1
            status: lmx_graph_call(g, unit)
            if: status != 0
                return: status
            count: count + 1
        ---
        if: lmx_graph_dump_marked(g, unit, c.stdout, "AFTER") != 0
            return: 1
        @: LmxThread thread lmx_thread_current()
        @: LmxMsg message lmx_thread_message(thread)
        if: message = 0
            return: 1
        message\success: (cast: (LmxFlag) 1)
        return: 0
    end: lm_graph_check_root
end: external

