predef: "l3_interp/l3_thread.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_manager.lm1"
predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_call.lm1"
predef: "l2src/lmx_plan.lm1"
predef: "l2src/lmx_scratch.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_gc.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_clock.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# EXPECT_INT witness: LMX_WALK_OP_EXPECT_INT (17).
# Subject is args[0]; path is child[1]; want is child[2].
# No R9.5 (args[0], not f\self).  No R8.2 (traversal, not own-field write).
# Positive: subject has 42, want=42 -> 1 -> IF takes then -> SET m[1]=42
# Negative: subject has 7, want=42 -> 0 -> IF skips -> m[1] stays 0
#
# THE WALKER'S OUTCOMES, ASSERTED AS THEY ARE (lmx_walk.lm1, the EXPECT_INT op).  The op splits
# malformations in two: some are SILENT ZEROS (the frame answers 0 and the walk goes on, so the
# IF skips and the own field stays 0) and some are HARD ERRORS (LMX_WALK_INVALID, surfaced by
# lmx_interp_apply as LMX_INTERP_INVALID).  This file names one case of each kind that the two
# cases above cannot observe:
#   non-INT leaf   -- the final leaf is a PRIMITIVE whose type is not INT, or is a STRUCT:
#                     silent 0, the interp result is OK.
#   malformed path -- child[1] is not a STRUCT, an index is out of range or negative, or the
#                     subject's cell at the path was never stored: LMX_WALK_INVALID.
# The non-INT leaf deliberately holds the same raw bytes as `want` (a size_t 42 against an int
# 42): only the TYPE guard separates a mismatch from a match there, so a walker that stops
# checking the type is caught by this case, not only by the positive one.

@: LmxArena gb 0
@: Lmx groles 0
int: broken 0
int: native_hits 0

sub: fail (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: fail

fn: native_noop (@: Lmx node) int
    native_hits: native_hits + 1
return: 0

fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(gb, groles, parent, op, children)
    if: n != 0 && parent != 0 && lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(gb, parent, children)
    if: n != 0 && parent != 0 && lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

sub: icell (@: Lmx holder; size_t: slot; int: value)
    if: holder != 0 && lmx_walk_store_int(gb, holder, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: icell

fn: field (@: Lmx m; size_t: slot) int
    @: void cell lmx_arena_ref_value(m, slot)
    if: cell = 0
        return: -999
return: lmx_int_value_known(cell)

fn: mk_int (@: LmxArena a; int: n) @: void
    @: void cell lmx_int_new_owned(a)
    if: cell = 0
        return: 0
    lmx_int_store_known(cell, n)
return: cell

fn: lit (@: Lmx parent; size_t: slot; int: value) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_LIT, 2U)
    if: n != 0 && lmx_walk_store_int(gb, n, 1U, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
return: n

fn: mk_dummy (@: LmxArena a) @: Lmx
    @: Lmx m lmx_node_new_owned(a)
    @: LmxCallable info lmx_callable_new_owned(a)
    if: m = 0 || info = 0 || lmx_arena_refs_open_owned(a, m, 1U) != 0
        return: 0
    lmx_arena_ref_store(m, 0U, (cast: (@: void) info))
return: m

fn: mk_thread (@: LmxArena arena; @: Lmx graph; @@: LmxThread out_t) int
    @: LmxThread t
    @: LmxPost mail
    @: LmxSchedule sched
    \out_t: 0
    t: (cast: (@: LmxThread) lmx_arena_take(arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD))
    mail: (cast: (@: LmxPost) lmx_arena_take(arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    sched: (cast: (@: LmxSchedule) lmx_arena_take(arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: t = 0 || mail = 0 || sched = 0
        return: 0
    if: lmx_post_init(arena, mail) != c.LMX_POST_OK || lmx_schedule_init(sched, arena, (cast: (@: void) t), 1000U) != c.LMX_SCHEDULE_OK
        return: 0
    if: lmx_thread_init(arena, t, graph, mail, sched) != c.LMX_THREAD_OK
        return: 0
    \out_t: t
return: 1

# Build: IF[expect_int(path, want), then: SET m[1]=42]
# subject's field at `path_index` is checked against want_value; if match, SET writes 42.
# `path_kind` 0 = the ordinary path Structure [path_index]; 1 = a MALFORMED path: child[1] is
# an int cell, not a Structure.
fn: mk_graph (int: want_value; int: path_index; int: path_kind) @: Lmx
    @: Lmx m
    @: LmxCallable info
    @: Lmx ifn
    @: Lmx ei
    @: Lmx path
    @: void bad_path
    @: Lmx want
    @: Lmx then_body
    @: Lmx setn
    @: Lmx own_node

    m: lmx_node_new_owned(gb)
    if: m = 0 || lmx_arena_refs_open_owned(gb, m, 3U) != 0
        broken: broken + 1
        return: 0
    ---
    info: lmx_callable_new_owned(gb)
    if: info = 0
        return: 0
    ---
    lmx_arena_ref_store(m, 0U, (cast: (@: void) info))
    icell(m, 1U, 0)  # own field starts at 0

    ifn: fr(m, 2U, c.LMX_WALK_OP_IF, 3U)
    if: ifn = 0
        return: 0

    ei: fr(ifn, 1U, c.LMX_WALK_OP_EXPECT_INT, 3U)
    if: ei = 0
        return: 0

    if: path_kind = 0
        path: lmx_node_new_owned(gb)
        if: path = 0 || lmx_arena_refs_open_owned(gb, path, 1U) != 0
            return: 0
        ---
        icell(path, 0U, path_index)  # path[0] = index into the subject
        lmx_arena_ref_store(ei, 1U, (cast: (@: void) path))
    else:
        bad_path: mk_int(gb, path_index)
        if: bad_path = 0
            return: 0
        ---
        lmx_arena_ref_store(ei, 1U, bad_path)
    ---

    want: mk_int(gb, want_value)
    if: want = 0
        return: 0
    ---
    lmx_arena_ref_store(ei, 2U, (cast: (@: void) want))

    then_body: pl(ifn, 2U, 1U)
    if: then_body = 0
        return: 0
    ---
    setn: fr(then_body, 0U, c.LMX_WALK_OP_SET, 3U)
    if: setn = 0
        return: 0
    ---
    own_node: fr(setn, 1U, c.LMX_WALK_OP_OWN, 3U)
    if: own_node = 0
        return: 0
    ---
    lmx_arena_ref_store(own_node, 1U, (cast: (@: void) m))
    icell(own_node, 2U, 1)

    lit(setn, 2U, 42)
return: m

fn: mk_expect_int_graph (int: want_value) @: Lmx
return: mk_graph(want_value, 1, 0)

# A subject with two fields; field 1 is left UNSTORED (null) by this constructor.
fn: mk_subject () @: Lmx
    @: Lmx subject lmx_node_new_owned(gb)
    if: subject = 0 || lmx_arena_refs_open_owned(gb, subject, 2U) != 0
        return: 0
    ---
return: subject

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: arena
    LmxArena: context_arena
    LmxPool: context_cells
    LmxScratch: store
    LmxWalkContext: context
    @: Lmx dummy 0
    @: LmxCallable info 0
    @: LmxThread t 0
    @: Lmx m 0
    @: Lmx subject 0
    @: Lmx inner 0
    @: void size_cell 0
    @: void subject_void 0
    @@: void args
    int: st

    if: counts = 0
        return: 2
    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxScratch))
    memset((cast: (@: void) (@ context)), 0, c.sizeof(c.LmxWalkContext))
    if: lmx_arena_open(@ arena) != 0
        free(counts)
        return: 2
    ---
    if: lmx_arena_open(@ context_arena) != 0 || lmx_scratch_open(@ store, @ context_arena, @ context_cells, 16U) != c.LMX_SCRATCH_OK
        free(counts)
        return: 2
    ---
    gb: @ arena
    dummy: mk_dummy(gb)
    if: dummy = 0 || mk_thread(gb, dummy, @ t) = 0
        free(counts)
        return: 2
    ---
    fail(counts, lmx_thread_turn(t, native_noop, 1U) = c.LMX_THREAD_OK, "commit mode on native turn")
    fail(counts, l3_thread_bind(gb, t) = c.LMX_THREAD_OK, "bind walk dispatch")
    groles: l3_thread_roles(t)
    fail(counts, groles != 0 && l3_thread_plan_roles(t) != 0, "shared walk/plan roles")

    context.arena: gb
    context.scratch: @ store
    context.roles: groles
    context.plan_roles: l3_thread_plan_roles(t)
    context.classified: 0U

    # --- Positive: subject field 0 = 42, want = 42 -> match -> SET 42
    subject: lmx_node_new_owned(gb)
    if: subject = 0 || lmx_arena_refs_open_owned(gb, subject, 2U) != 0
        free(counts)
        return: 2
    ---
    icell(subject, 1U, 42)
    context.arena: gb
    context.scratch: @ store
    context.roles: groles
    context.plan_roles: l3_thread_plan_roles(t)
    context.classified: 0U
    m: mk_expect_int_graph(42)
    fail(counts, broken = 0 && m != 0 && lmx_arena_ref_value(m, 0U) != 0, "expect-int match graph + callable")
    info: lmx_call_callable(gb, m)
    fail(counts, info != 0, "call_ready gives info")
    fail(counts, info\header = 0, "callable has no prior plan")
    fail(counts, lmx_plan_home(gb, info) = gb, "plan_home is gb")
    st: lmx_walk_prepare(@ context, gb, l3_thread_plan_roles(t), m)
    fail(counts, st = c.LMX_WALK_OK, "prepare OK")
    subject_void: (cast: (@: void) subject)
    args: @ subject_void
    fail(counts, lmx_interp_apply(@ context, m, args, 1U) = c.LMX_INTERP_OK, "expect-int match interp_apply")
    fail(counts, field(m, 1U) = 42, "expect-int match: SET wrote 42")

    # --- Negative: subject field 0 = 7, want = 42 -> mismatch -> own stays 0
    broken: 0
    subject: lmx_node_new_owned(gb)
    if: subject = 0 || lmx_arena_refs_open_owned(gb, subject, 2U) != 0
        free(counts)
        return: 2
    ---
    icell(subject, 1U, 7)
    m: mk_expect_int_graph(42)
    fail(counts, broken = 0 && m != 0, "expect-int mismatch graph built")
    subject_void: (cast: (@: void) subject)
    args: @ subject_void
    fail(counts, lmx_interp_apply(@ context, m, args, 1U) = c.LMX_INTERP_OK, "expect-int mismatch interp_apply")
    fail(counts, field(m, 1U) = 0, "expect-int mismatch: own field stays 0")

    # --- Non-INT leaf, PRIMITIVE of another type: a size_t 42 at the path, want = 42.
    #     Same raw bytes as the int 42; the type guard alone answers 0 -> IF skips.
    broken: 0
    subject: mk_subject()
    size_cell: lmx_size_new_owned(gb)
    fail(counts, subject != 0 && size_cell != 0 && lmx_size_store_known(size_cell, 42U) = 0 && lmx_arena_ref_store(subject, 1U, size_cell) = 0, "non-INT leaf: size_t subject built")
    fail(counts, lmx_domain_kind(gb, size_cell) = c.LMX_KIND_PRIMITIVE && lmx_domain_type(gb, size_cell) = c.LMX_TYPE_SIZE_T, "non-INT leaf: the cell is a PRIMITIVE of type SIZE_T")
    m: mk_expect_int_graph(42)
    fail(counts, broken = 0 && m != 0, "non-INT leaf graph built")
    subject_void: (cast: (@: void) subject)
    args: @ subject_void
    fail(counts, lmx_interp_apply(@ context, m, args, 1U) = c.LMX_INTERP_OK, "non-INT leaf (size_t): silent 0, interp_apply OK")
    fail(counts, field(m, 1U) = 0, "non-INT leaf (size_t): own field stays 0")

    # --- Non-INT leaf, a STRUCT at the end of the path: the walk descends into it, the path
    #     is exhausted, the final leaf is not PRIMITIVE -> silent 0.
    broken: 0
    subject: mk_subject()
    inner: lmx_node_new_owned(gb)
    fail(counts, subject != 0 && inner != 0 && lmx_arena_refs_open_owned(gb, inner, 1U) = 0 && lmx_arena_ref_store(subject, 1U, (cast: (@: void) inner)) = 0, "non-INT leaf: STRUCT subject built")
    m: mk_expect_int_graph(42)
    fail(counts, broken = 0 && m != 0, "non-INT leaf (STRUCT) graph built")
    subject_void: (cast: (@: void) subject)
    args: @ subject_void
    fail(counts, lmx_interp_apply(@ context, m, args, 1U) = c.LMX_INTERP_OK, "non-INT leaf (STRUCT): silent 0, interp_apply OK")
    fail(counts, field(m, 1U) = 0, "non-INT leaf (STRUCT): own field stays 0")

    # --- Malformed path: child[1] is an int cell, not a STRUCT -> LMX_WALK_INVALID.
    #     Asserted by the interp RESULT (lmx_interp_map: WALK_INVALID -> INTERP_INVALID), and
    #     attributed to the run: prepare is asked first and its answer is named too.
    broken: 0
    subject: mk_subject()
    icell(subject, 1U, 42)
    m: mk_graph(42, 1, 1)
    fail(counts, broken = 0 && m != 0 && subject != 0, "malformed path graph built")
    st: lmx_walk_prepare(@ context, gb, l3_thread_plan_roles(t), m)
    fail(counts, st = c.LMX_WALK_OK, "malformed path: prepare accepts the graph (the path is data to the scan)")
    subject_void: (cast: (@: void) subject)
    args: @ subject_void
    fail(counts, lmx_interp_apply(@ context, m, args, 1U) = c.LMX_INTERP_INVALID, "malformed path (non-STRUCT): interp_apply answers LMX_INTERP_INVALID")
    fail(counts, field(m, 1U) = 0, "malformed path (non-STRUCT): own field untouched")

    # --- Out-of-range index: path[0] = 5 on a subject of len 2 -> LMX_WALK_INVALID.
    broken: 0
    subject: mk_subject()
    icell(subject, 1U, 42)
    m: mk_graph(42, 5, 0)
    fail(counts, broken = 0 && m != 0 && subject != 0, "out-of-range path graph built")
    subject_void: (cast: (@: void) subject)
    args: @ subject_void
    fail(counts, lmx_interp_apply(@ context, m, args, 1U) = c.LMX_INTERP_INVALID, "out-of-range index: interp_apply answers LMX_INTERP_INVALID")
    fail(counts, field(m, 1U) = 0, "out-of-range index: own field untouched")

    # --- Negative index: path[0] = -1 -> LMX_WALK_INVALID.
    broken: 0
    subject: mk_subject()
    icell(subject, 1U, 42)
    m: mk_graph(42, -1, 0)
    fail(counts, broken = 0 && m != 0 && subject != 0, "negative index graph built")
    subject_void: (cast: (@: void) subject)
    args: @ subject_void
    fail(counts, lmx_interp_apply(@ context, m, args, 1U) = c.LMX_INTERP_INVALID, "negative index: interp_apply answers LMX_INTERP_INVALID")
    fail(counts, field(m, 1U) = 0, "negative index: own field untouched")

    # --- Unavailable value: the subject's cell at the path was never stored (null) -> the
    #     walker's LMX_WALK_INVALID.  This is the only "value unavailable" state the public
    #     constructors can make: an int cell always holds an int (lmx_int_new_owned zeroes it,
    #     lmx_int_value_known reads it, and a null cell reads as 0), so "unknown int" has no
    #     representation of its own -- only absence, and absence is a hard error here.
    broken: 0
    subject: mk_subject()
    fail(counts, subject != 0 && lmx_arena_ref_value(subject, 1U) = 0, "unset leaf: subject field 1 is null")
    m: mk_expect_int_graph(42)
    fail(counts, broken = 0 && m != 0, "unset leaf graph built")
    subject_void: (cast: (@: void) subject)
    args: @ subject_void
    fail(counts, lmx_interp_apply(@ context, m, args, 1U) = c.LMX_INTERP_INVALID, "unset leaf (null cell): interp_apply answers LMX_INTERP_INVALID")
    fail(counts, field(m, 1U) = 0, "unset leaf (null cell): own field untouched")

    if: counts[1] != 0
        c.printf("expect_int checks=%d failures=%d\n", counts[0], counts[1])
        free(counts)
        return: 1
    ---
    c.printf("expect_int checks=%d failures=0\n", counts[0])
    free(counts)
return: 0
