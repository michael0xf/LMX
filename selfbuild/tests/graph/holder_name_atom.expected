---
    Observed:
        int: seen 3
        int: seen_in_code 3
    end: Observed
---
@: shared (data [] 0)
sub: main () (
    A:
        int: v 3
        A
    end: A
    int: in_code 0
)
    :=: (data \ in_code) (((A \ A) \ A) \ v)
end: main
main:
int: seen (((((main \ data) \ A) \ A) \ A) \ v)
int: seen_in_code ((main \ data) \ in_code)
sub: observe ()
    :=: ((shared \ Observed) \ seen) seen
    :=: ((shared \ Observed) \ seen_in_code) seen_in_code
end: observe
observe:
