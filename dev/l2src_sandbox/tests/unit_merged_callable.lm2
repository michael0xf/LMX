B:
    size_t: y 42U
end: B

A:
    fn: M
    size_t: tag 1U
end: A

fn: M () int
    size_t: hits
    size_t: seen
    hits: hits + 1U
    seen: B\y
    if: seen != 42U
        return: 0
    return: hits
end: M
size_t: a1
size_t: a2
size_t: r1
size_t: r2
size_t: a3
R: merge: A
# Q22 = II: A: fn: M is a shared occurrence; hits accumulate across A and R.
a1: A\M()
a2: A\M()
r1: R\M()
a3: A\M()
r2: R\M()
if: a1 != 1U
    return: 81
if: a2 != 2U
    return: 82
if: r1 != 3U
    return: 83
if: a3 != 4U
    return: 84
if: r2 != 5U
    return: 85
return: 0
