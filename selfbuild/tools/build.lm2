# One explicit compiler bundle: no repository-bin or missing-output fallback.
# The initial historical backend is an explicitly prepared seed companion.
fn: bld_bundle_backend (@: fe char) @: char
    @: directory char 0
    @: backend char 0
    if: fe = 0
        return: 0
    if: fe[0] = 0
        return: 0
    directory: suite_dir_of(fe)
    if: directory != 0
        backend: txt_path(directory, "l1trans.exe")
    c.free(directory)
    return: backend
end: bld_bundle_backend

# Declaration-only L3 output, not algorithm bodies or a new L2 array syntax.
fn: decl_l1_backend_scratch (@: f c.FILE) int
    if: c.fputs("struct: LmL1NestedScratch\n    []: int qmark 64\nend: LmL1NestedScratch\n\nstruct: LmL1StringScratch\n    []: char oct 5\nend: LmL1StringScratch\n\nstruct: LmL1GuardScratch\n    []: char hex 8\nend: LmL1GuardScratch\n", f) < 0
        return: 1
    if: c.fputs("struct: LmL1TextScratch64\n    []: char buffer 64\nend: LmL1TextScratch64\n\nstruct: LmL1TextScratch256\n    []: char buffer 256\nend: LmL1TextScratch256\n", f) < 0
        return: 1
    return: 0
end: decl_l1_backend_scratch

# The existing machine producer and L1-to-C recipe build B1 from maintained
# backend sources plus generated P0. All later bundle consumers select B1.
# Backend algorithms are ordinary L2; L3 generates only the import/entry scaffold.
fn: bld_backend (@: rec c.FILE; @: stage char; @: base char; @: previous_fe char; @: previous_backend char; @: out char; @: res int) int
    @@: names char c.calloc(75U, sizeof(@: char))
    @@: headers char c.calloc(11U, sizeof(@: char))
    @@: a char c.calloc(32U, sizeof(@: char))
    @: src char txt_path(stage, "src")
    @: headers_root char txt_path(stage, "headers")
    @: scratch char 0
    @: state char 0
    @: source char txt_path(out, "backend-source.lm1")
    @: cfile char txt_path(out, "backend.c")
    @: exe char txt_path(out, "l1trans.exe")
    int: k 0
    if: src != 0
        scratch: txt_path(src, "l1src/l1_backend_scratch.h.lm1")
        state: txt_path(src, "l1src/l1_backend_state.lm1")
    if: names = 0 || headers = 0 || a = 0 || src = 0 || headers_root = 0 || scratch = 0 || state = 0 || source = 0 || cfile = 0 || exe = 0 || previous_backend = 0 || rec = 0 || res = 0
        return: 1
    if: file_exists(previous_backend) = 0
        return: 1
    os_file_remove(scratch)
    os_file_remove(state)
    os_file_remove(txt_path(src, "l2src/l1_backend_text.lm1"))
    os_file_remove(txt_path(src, "l2src/l1_backend_text.h.lm1"))
    os_file_remove(txt_path(stage, "headers/l1src/l1_backend_scratch.lm1.h"))
    os_file_remove(txt_path(stage, "headers/l2src/l1_backend_text.lm1.h"))
    os_file_remove(txt_path(src, "l2src/l1_backend_state_helpers.lm1"))
    os_file_remove(txt_path(src, "l2src/l1_backend_state_helpers.h.lm1"))
    os_file_remove(txt_path(stage, "headers/l2src/l1_backend_state_helpers.lm1.h"))
    os_file_remove(txt_path(src, "l2src/l1_backend_emit.lm1"))
    os_file_remove(txt_path(src, "l2src/l1_backend_emit.h.lm1"))
    os_file_remove(txt_path(stage, "headers/l2src/l1_backend_emit.lm1.h"))
    os_file_remove(txt_path(src, "l2src/l1_backend_platform_win.lm1"))
    os_file_remove(txt_path(src, "l2src/l1_backend_platform_win.h.lm1"))
    os_file_remove(txt_path(stage, "headers/l2src/l1_backend_platform_win.lm1.h"))
    os_file_remove(txt_path(src, "l2src/l1_backend_platform_posix.lm1"))
    os_file_remove(txt_path(src, "l2src/l1_backend_platform_posix.h.lm1"))
    os_file_remove(txt_path(stage, "headers/l2src/l1_backend_platform_posix.lm1.h"))
    os_file_remove(source)
    os_file_remove(exe)
    if: decl_write(scratch, 52) != 0
        os_file_remove(scratch)
        return: 1
    if: bld_hash_note(rec, scratch) != 0
        return: 1
    if: decl_write(state, 53) != 0
        os_file_remove(state)
        return: 1
    if: bld_hash_note(rec, state) != 0
        return: 1
    names[0]: "l1_replace_file"
    names[1]: "l1_getcwd"
    names[2]: "l1_path_is_absolute"
    if: bld_machine_module(rec, previous_fe, src, base, out, res, "l1_backend_platform_win", names, 3, 1) != 0
        return: 1
    if: bld_machine_module(rec, previous_fe, src, base, out, res, "l1_backend_platform_posix", names, 3, 1) != 0
        return: 1
    names[0]: "l1_text_eq"
