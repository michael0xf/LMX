function(lmx_knowledge_formats)
    # libtiff's upstream CMake requires a C++ compiler even with tiff-cxx=OFF.
    # A private build view changes only that project-language declaration.
    file(REAL_PATH "${_knowledge_vendor}/libtiff" _tiff)
    set(_tiff_view "${CMAKE_CURRENT_BINARY_DIR}/tiff_c99_source")
    file(COPY "${_tiff}/" DESTINATION "${_tiff_view}")
    file(SHA256 "${_tiff}/CMakeLists.txt" _tiff_hash)
    if(NOT _tiff_hash STREQUAL "d9f329087a02ee9d89420658ffcb123815008fd02cb1c36e75cb9c69c76b43d5")
        message(FATAL_ERROR "libtiff CMake input changed; review the C99 build view")
    endif()
    file(READ "${_tiff}/CMakeLists.txt" _tiff_cmake)
    if(NOT _tiff_cmake MATCHES "LANGUAGES C CXX")
        message(FATAL_ERROR "Unexpected libtiff project languages; review C99 build view")
    endif()
    string(REPLACE "LANGUAGES C CXX" "LANGUAGES C" _tiff_cmake "${_tiff_cmake}")
    file(WRITE "${_tiff_view}/CMakeLists.txt" "${_tiff_cmake}")
    set(BUILD_SHARED_LIBS OFF)
    set(tiff-static ON CACHE BOOL "Compact C99 archive" FORCE)
    foreach(_option IN ITEMS tiff-cxx tiff-tools tiff-tests tiff-contrib tiff-docs
            tiff-install tiff-opengl cxx-compat-mode jpeg old-jpeg jpeg12 jbig lerc
            lzma zstd webp libdeflate pixarlog)
        set(${_option} OFF CACHE BOOL "Compact C99 archive" FORCE)
    endforeach()
    # Deflate TIFF is useful interchange coverage and reuses the collection's
    # existing ZLIB::ZLIB target (system zlib only for standalone group builds).
    set(zlib ON CACHE BOOL "TIFF Deflate with the existing zlib" FORCE)
    add_subdirectory("${_tiff_view}" "${CMAKE_CURRENT_BINARY_DIR}/tiff")
    add_library(LMX::tiff ALIAS tiff)
    lmx_c99_target(tiff)
    get_target_property(_port_type tiff_port TYPE)
    if(_port_type STREQUAL "STATIC_LIBRARY")
        lmx_c99_target(tiff_port)
        set_target_properties(tiff_port PROPERTIES EXCLUDE_FROM_ALL TRUE)
    endif()

    set(_xls "${_knowledge_vendor}/libxls")
    set(_xls_config "${CMAKE_CURRENT_BINARY_DIR}/xls_config")
    file(MAKE_DIRECTORY "${_xls_config}")
    # Use upstream's UTF-8 locale conversion; no external iconv dependency.
    file(WRITE "${_xls_config}/config.h"
        "#define PACKAGE_VERSION \"1.6.4\"\n#define HAVE_WCHAR_H 1\n")
    add_library(lmx_xls STATIC "${_xls}/src/xls.c" "${_xls}/src/xlstool.c"
        "${_xls}/src/ole.c" "${_xls}/src/endian.c" "${_xls}/src/locale.c")
    add_library(LMX::xls ALIAS lmx_xls)
    target_include_directories(lmx_xls PUBLIC "${_xls}/include" PRIVATE "${_xls_config}")
    if(NOT WIN32)
        target_compile_definitions(lmx_xls PRIVATE _POSIX_C_SOURCE=200809L)
    endif()
    lmx_c99_target(lmx_xls)

    # Matio's C implementation and upstream configuration checks, without its
    # C++/Fortran tools, Conan, HDF5, optional online providers or test datasets.
    set(_matio "${_knowledge_vendor}/matio")
    set(PROJECT_SOURCE_DIR "${_matio}")
    set(matio_VERSION "1.6.0")
    set(matio_VERSION_MAJOR 1)
    set(matio_VERSION_MINOR 6)
    set(matio_VERSION_PATCH 0)
    set(matio_PLATFORM "${CMAKE_SYSTEM_PROCESSOR}-pc-${CMAKE_SYSTEM_NAME}")
    set(matio_PACKAGE "matio")
    set(matio_PACKAGE_NAME "MATIO")
    set(matio_PACKAGE_STRING "MATIO 1.6.0")
    set(matio_PACKAGE_TARNAME "matio")
    set(matio_PACKAGE_URL "https://github.com/tbeu/matio")
    set(matio_PACKAGE_BUGREPORT "https://github.com/tbeu/matio/issues")
    set(MAT_FT_DEFAULT MAT_FT_MAT5)
    set(EXTENDED_SPARSE 1)
    set(MCOS 1)
    set(MAT73 0)
    set(HAVE_HDF5 0)
    set(HAVE_ZLIB 1)
    set(_FILE_OFFSET_BITS 64)
    if(NOT WIN32)
        set(CMAKE_REQUIRED_DEFINITIONS -D_POSIX_C_SOURCE=200809L -D_FILE_OFFSET_BITS=64)
    endif()
    include("${_matio}/cmake/compilerOptions.cmake")
    set(_matio_config "${CMAKE_CURRENT_BINARY_DIR}/matio_config")
    file(MAKE_DIRECTORY "${_matio_config}")
    configure_file("${_matio}/cmake/matio_pubconf.cmake.in" "${_matio_config}/matio_pubconf.h" @ONLY)
    configure_file("${_matio}/cmake/matioConfig.cmake.in" "${_matio_config}/matioConfig.h" @ONLY)
    file(GLOB _matio_sources CONFIGURE_DEPENDS "${_matio}/src/*.c")
    add_library(lmx_matio STATIC ${_matio_sources} "${_matio}/snprintf/snprintf.c")
    add_library(LMX::matio ALIAS lmx_matio)
    # The baseline NNOM library also exports Add. This is an internal matio
    # checked-size helper; leave every public Mat_* function unchanged.
    target_compile_definitions(lmx_matio PRIVATE Add=lmx_matio_Add)
    target_include_directories(lmx_matio PUBLIC "${_matio}/src" "${_matio_config}")
    if(NOT WIN32)
        target_compile_definitions(lmx_matio PRIVATE _POSIX_C_SOURCE=200809L _FILE_OFFSET_BITS=64)
    endif()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        # Upstream's endianness detection expects glibc's endian constants to
        # be visible through sys/types.h before matio_private.h is parsed.
        target_compile_definitions(lmx_matio PRIVATE _DEFAULT_SOURCE=1)
    endif()
    if(TARGET LMX::zlib)
        target_link_libraries(lmx_matio PUBLIC LMX::zlib)
    else()
        find_package(ZLIB REQUIRED)
        target_link_libraries(lmx_matio PUBLIC ZLIB::ZLIB)
    endif()
    if(UNIX)
        target_link_libraries(lmx_matio PUBLIC m)
    endif()
    lmx_c99_target(lmx_matio)
endfunction()
