# A merge whose model reads a reference among its free names, held and
# called. addv reads m\v; m is a field of the unit made from Model, with v
# 4. w holds merge(y: 5; addv): the root's m is the value the node
# receives, at its place after the formal the merge leaves unbound:
# 5 + 1 + 4. Entry 7.
Model:
    int: v 4
end: Model

m: merge Model

fn: addv (int: y; int: x) int
    return: y + x + m\v

fn: wrap (int: k) fn: (int: x) int
    return: merge(y: k; addv)

w: wrap 5
int: a (w: 1)
int: ok 7
if: a != 10
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
