# local and local_reference write the free x; their immediate caller is the root, so they write the root's x
# (the book, #binding-caller-place; B02): unchanged 7, then x := 20 and local() make it 22 -- x 22, outside 22, next_relay
# 22. base 5, local_value 7, own_value 9 (own's own x), formal_value 12, local_address 7, next_local 22 stay. Until step
# 21.4 the row pinned the local copy of 2026-11-18 (x 20, unchanged 5, outside 20, next_relay 20).
# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: x 0
        int: base 0
        int: local_value 0
        int: own_value 0
        int: formal_value 0
        int: local_address 0
        int: unchanged 0
        int: next_local 0
        int: outside 0
        int: next_relay 0
)
int: x 5
fn: leaf () int
    return: x
end: leaf
fn: relay () int
    return: leaf()
end: relay
fn: local () int
    x := x + 2
    return: relay()
end: local
fn: own () int (int: x 8)
    x := x + 1
    return: relay()
end: own
fn: formal (int: x) int
    return: child()
    fn: child () int
        return: relay()
    end: child
    fn: unused () int
        return: absent
    end: unused
end: formal
fn: local_reference () int
    x := 7
    return: \(@x)
end: local_reference
int: base leaf()
int: local_value local()
int: own_value own()
int: formal_value formal(12)
int: local_address local_reference()
int: unchanged x
x := 20
int: next_local local()
int: outside x
int: next_relay relay()

sub: main ()
    @: shared node[0]
    shared\Observed\x := x
    shared\Observed\base := base
    shared\Observed\local_value := local_value
    shared\Observed\own_value := own_value
    shared\Observed\formal_value := formal_value
    shared\Observed\local_address := local_address
    shared\Observed\unchanged := unchanged
    shared\Observed\next_local := next_local
    shared\Observed\outside := outside
    shared\Observed\next_relay := next_relay
main()
