---
    Observed:
        int: seen 0
        int: ticks 0
    end: Observed
---
@: shared (data [] 0)
fn: tick () int
    :=: ((shared \ Observed) \ ticks) (((shared \ Observed) \ ticks) + 1)
    return: ((shared \ Observed) \ ticks)
end: tick
sub: main () (
    int: seen 5
)
    :=: seen (0 && (tick))
    :=: ((shared \ Observed) \ seen) seen
end: main
main:
