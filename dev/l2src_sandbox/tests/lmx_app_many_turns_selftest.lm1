predef: "l2src/lmx_root.lm1"
predef: "l2src/lmx_settle.lm1"
predef: "l2src/lmx_service.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_manager.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_gc.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_call.lm1"
predef: "l2src/lmx_clock.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# lmx_app_many_turns_selftest.lm1 -- ticket 20260919-110000
# Child lives N turns; each turn drains inbox and stores taken letters + turn
# counter IN THE CHILD GRAPH (not test globals). Parent posts one letter per
# cycle so GC runs between turns. On turn N body sets success=1 only.
# Graph layout (source refs = 3+N):
#   0 method | 1 turns (size_t cell) | 2 accepted (size_t cell) | 3..3+N-1 letters

@: LmxRoot mt_root 0
@: LmxArena mt_child_arena 0
@: Lmx mt_source 0
@: LmxMsg mt_child_msg 0
@: LmxThread mt_child_t 0
@: LmxSchedule mt_child_sched 0
size_t: mt_phase 0U
size_t: mt_entry_diag 0U
size_t: mt_n 5U

fn: mt_child_body (@: Lmx node) int
    @: LmxThread t
    @: Lmx graph
    @: void turns_cell
    @: void accepted_cell
    @: void letter
    size_t: turns
    size_t: accepted
    t: lmx_thread_current()
    if: t = 0 || t\message = 0 || t\message\graph = 0
        return: 0
    ---
    graph: t\message\graph
    turns_cell: lmx_arena_ref_value(graph, 1U)
    accepted_cell: lmx_arena_ref_value(graph, 2U)
    if: turns_cell = 0 || accepted_cell = 0
        return: 0
    ---
    turns: lmx_size_value_known(turns_cell) + 1U
    lmx_size_store_known(turns_cell, turns)
    while: lmx_thread_mail_count(t, c.LMX_POST_INBOX) > 0U
        letter: lmx_thread_mail_take(t, c.LMX_POST_INBOX)
        if: letter != 0
            accepted: lmx_size_value_known(accepted_cell)
            if: accepted < mt_n
                lmx_arena_ref_store(graph, 3U + accepted, letter)
                lmx_size_store_known(accepted_cell, accepted + 1U)
            ---
        ---
    ---
    if: turns = mt_n
        t\message\success: 1
    ---
return: 0

fn: mt_root_entry (@: Lmx node) int
    @: LmxMsg child
    @: LmxThread child_t
    @: LmxPost child_mail
    @: LmxSchedule child_sched
    @: LmxMethod method
    @: LmxPool methods
    @: Lmx graph
    @: void turns_cell
    @: void accepted_cell
    if: mt_phase != 0U || mt_root = 0 || mt_child_arena = 0 || mt_source = 0
        mt_entry_diag: 1U
        return: 0
    ---
    child: lmx_root_create(mt_root, mt_child_arena, 0U, mt_source)
    if: child = 0
        mt_entry_diag: 2U
        return: 0
    ---
    mt_child_msg: child
    methods: lmx_pool_make(mt_child_arena, 2U * c.sizeof(c.LmxMethod), c.sizeof(c.LmxMethod),
                           c.LMX_KIND_METHOD, c.LMX_TYPE_METHOD)
    if: methods = 0
        mt_entry_diag: 3U
        return: 0
    ---
    method: lmx_method_intern(mt_child_arena, methods, (cast: (LmxEntry) mt_child_body), 1U)
    graph: child\graph
    if: method = 0 || graph = 0
        mt_entry_diag: 4U
        return: 0
    ---
    lmx_arena_ref_store(graph, 0U, (cast: (@: void) method))
    turns_cell: lmx_size_new_owned(mt_child_arena)
    accepted_cell: lmx_size_new_owned(mt_child_arena)
    if: turns_cell = 0 || accepted_cell = 0
        mt_entry_diag: 5U
        return: 0
    ---
    if: lmx_arena_ref_store(graph, 1U, turns_cell) != 0 || lmx_arena_ref_store(graph, 2U, accepted_cell) != 0
        mt_entry_diag: 6U
        return: 0
    ---
    child_mail: (cast: (@: LmxPost) lmx_arena_take(mt_child_arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    child_t: (cast: (@: LmxThread) lmx_arena_take(mt_child_arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_THREAD, c.LMX_DOMAIN_THREAD))
    child_sched: (cast: (@: LmxSchedule) lmx_arena_take(mt_child_arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: child_mail = 0 || child_t = 0 || child_sched = 0
        mt_entry_diag: 7U
        return: 0
    ---
    if: lmx_post_init(mt_child_arena, child_mail) != c.LMX_POST_OK
        mt_entry_diag: 8U
        return: 0
    ---
    if: lmx_schedule_init(child_sched, mt_child_arena, (cast: (@: void) child_t), 100000U) != c.LMX_SCHEDULE_OK
        mt_entry_diag: 9U
        return: 0
    ---
    if: lmx_thread_attach(child_t, child, child_mail, child_sched) != c.LMX_THREAD_OK
        mt_entry_diag: 10U
        return: 0
    ---
    if: lmx_child_thread(lmx_root_thread(mt_root), child, child_t) != c.LMX_CHILD_OK
        mt_entry_diag: 11U
        return: 0
    ---
    mt_child_t: child_t
    mt_child_sched: child_sched
    mt_phase: 1U
    mt_entry_diag: 12U
return: 0

sub: mt_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
    c.fflush(0)
end: mt_check

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    int: failures
    LmxRoot: root
    LmxArena: child_arena
    LmxArena: letter_arena
    @: LmxArena child_at 0
    @: LmxArena letter_at 0
    @: LmxArena root_arena 0
    @: LmxMsg message 0
    @: LmxThread r0 0
    @: Lmx graph 0
    @: Lmx source 0
    @: LmxMsg letter 0
    @: LmxMsg child_msg 0
    @: LmxLink mt_node 0
    @: LmxThread child_t 0
    @: LmxService service 0
    @: LmxManager manager 0
    @: Lmx child_graph 0
    @: void turns_cell 0
    @: void accepted_cell 0
    @: void letter_slot 0
    size_t: i 0U
    size_t: turns_from_graph 0U
    size_t: accepted_from_graph 0U
    size_t: graph_slots 0U
    if: counts = 0
        return: 2
    ---
    memset((cast: (@: void) (@ root)), 0, c.sizeof(c.LmxRoot))
    memset((cast: (@: void) (@ child_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ letter_arena)), 0, c.sizeof(c.LmxArena))
    mt_root: @ root
    child_at: @ child_arena
    letter_at: @ letter_arena
    mt_phase: 0U
    mt_child_msg: 0
    mt_child_t: 0
    mt_child_sched: 0
    mt_entry_diag: 0U
    mt_n: 5U
    graph_slots: 3U + mt_n
    mt_check(counts, lmx_root_open(@ root, mt_root_entry, 120000U, 0U, 0U) = c.LMX_ROOT_OK, "R0 did not open")
    message: lmx_root_message(@ root)
    r0: lmx_root_thread(@ root)
    root_arena: lmx_root_arena(@ root)
    graph: message\graph
    service: lmx_root_service(@ root)
    manager: lmx_root_manager(@ root)
    mt_check(counts, message != 0 && r0 != 0 && root_arena != 0 && service != 0 && manager != 0, "R0 missing pieces")
    if: message = 0 || r0 = 0
        failures: counts[1]
        c.printf("lmx_app_many_turns checks=%d failures=%d entry_diag=%u (abort)\n", counts[0], failures, (cast: (unsigned) mt_entry_diag))
        c.fflush(0)
        free(counts)
        return: failures
    ---
    source: lmx_node_new_owned(root_arena)
    mt_check(counts, source != 0 && lmx_arena_refs_open_owned(root_arena, source, graph_slots) = 0, "template not built")
    if: source = 0
        failures: counts[1]
        c.printf("lmx_app_many_turns checks=%d failures=%d entry_diag=%u (abort)\n", counts[0], failures, (cast: (unsigned) mt_entry_diag))
        c.fflush(0)
        free(counts)
        return: failures
    ---
    lmx_arena_ref_store(graph, 3U, (cast: (@: void) source))
    mt_source: source
    mt_check(counts, lmx_arena_open(@ child_arena) = 0, "child arena did not open")
    mt_child_arena: @ child_arena
    mt_check(counts, lmx_root_cycle(@ root, 4U) = c.LMX_ROOT_OK, "create cycle did not run")
    mt_check(counts, mt_phase = 1U && mt_child_msg != 0 && mt_child_t != 0, "child was not wired")
    if: mt_child_msg = 0 || mt_child_t = 0
        failures: counts[1]
        c.printf("lmx_app_many_turns checks=%d failures=%d entry_diag=%u (abort wire)\n", counts[0], failures, (cast: (unsigned) mt_entry_diag))
        c.fflush(0)
        free(counts)
        return: failures
    ---
    child_msg: mt_child_msg
    child_t: mt_child_t
    child_graph: child_msg\graph
    mt_check(counts, lmx_arena_ref_value(graph, 0U) = (cast: (@: void) child_msg), "child not published")
    mt_check(counts, lmx_range_classify(@ child_arena, (cast: (@: void) child_msg)) = c.LMX_DOMAIN_KIND_MSG_RECORD, "child not in own arena")
    mt_check(counts, lmx_thread_child_is(r0, child_t) != 0, "child not live after publish")
    mt_check(counts, lmx_schedule_wait(mt_child_sched, lmx_root_clock(@ root)) = c.LMX_SCHEDULE_OK, "schedule wait failed")
    mt_check(counts, lmx_manager_add(manager, mt_child_sched) = c.LMX_MANAGER_OK, "child not in manager")
    mt_check(counts, lmx_service_find(service, (cast: (@: void) child_t)) = (cast: (@: void) child_t), "child not in service")
    mt_check(counts, child_graph != 0, "child graph missing")
    mt_check(counts, lmx_arena_ref_value(child_graph, 1U) != 0 && lmx_arena_ref_value(child_graph, 2U) != 0, "graph counters not rooted")

    i: 0U
    # N-1 turns here, and the LAST one below: the last turn ends the incarnation, and a successful
    # child returns its own arena at that point (lmx_thread_finish) -- from then on the graph it
    # built is not readable, and what the application reads is the parent's node.
    while: i + 1U < mt_n
        mt_check(counts, lmx_arena_open_simple(@ letter_arena) = 0, "letter arena did not open")
        letter: (cast: (@: LmxMsg) lmx_arena_take(@ letter_arena, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
        mt_check(counts, letter != 0, "letter missing")
        letter\running: 1
        letter\success: 0
        letter\handoff_ready: 0
        letter\graph: 0
        letter\index: 0U
        mt_check(counts, lmx_service_post(service, (cast: (@: void) child_t), letter, @ letter_arena) = c.LMX_SERVICE_OK, "post refused")
        mt_check(counts, letter_at\count = 0U, "letter arena not attached")
        mt_check(counts, lmx_range_classify(@ child_arena, (cast: (@: void) letter)) = c.LMX_DOMAIN_KIND_MSG_RECORD, "letter not in recipient index")
        mt_check(counts, lmx_thread_mail_count(child_t, c.LMX_POST_INBOX) = 1U, "inbox empty after post")
        mt_check(counts, lmx_manager_round(manager, 1U, lmx_root_clock(@ root)) = c.LMX_MANAGER_OK, "manager round did not run")
        turns_from_graph: lmx_size_value_known(lmx_arena_ref_value(child_graph, 1U))
        accepted_from_graph: lmx_size_value_known(lmx_arena_ref_value(child_graph, 2U))
        mt_check(counts, turns_from_graph = i + 1U, "turns from graph wrong after round")
        mt_check(counts, accepted_from_graph = i + 1U, "accepted from graph wrong after round")
        mt_check(counts, lmx_thread_mail_count(child_t, c.LMX_POST_INBOX) = 0U, "inbox not emptied after take")
        mt_check(counts, child_msg\success = 0 && child_msg\running = 1, "child finished early")
        i: i + 1U
    ---

    turns_from_graph: lmx_size_value_known(lmx_arena_ref_value(child_graph, 1U))
    accepted_from_graph: lmx_size_value_known(lmx_arena_ref_value(child_graph, 2U))
    mt_check(counts, turns_from_graph = mt_n - 1U, "turns from graph != N-1 before the last turn")
    mt_check(counts, accepted_from_graph = mt_n - 1U, "accepted from graph != N-1 before the last turn")
    # The cells the child accumulated, asked of the CHILD while it is still alive: after its last
    # turn there is no arena of its to ask (it returns its own), and that is the model, not a gap.
    i: 0U
    while: i < mt_n - 1U
        letter_slot: lmx_arena_ref_value(child_graph, 3U + i)
        mt_check(counts, letter_slot != 0, "accumulator slot empty after N-1 GC passes")
        mt_check(counts, lmx_range_classify(@ child_arena, letter_slot) = c.LMX_DOMAIN_KIND_MSG_RECORD, "accumulator cell not in child arena index")
        i: i + 1U
    ---

    # THE LAST TURN.  Taken by hand so that everything above was read while the child was alive;
    # the node is taken first, because after this turn the child's own address is returned
    # storage (the successful child returns its arena -- lmx_thread.lm1, lmx_thread_finish).
    mt_node: lmx_thread_child_link(r0)
    mt_check(counts, lmx_arena_open_simple(@ letter_arena) = 0, "last letter arena did not open")
    letter: (cast: (@: LmxMsg) lmx_arena_take(@ letter_arena, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
    mt_check(counts, letter != 0, "last letter missing")
    letter\running: 1
    letter\success: 0
    letter\handoff_ready: 0
    letter\graph: 0
    letter\index: 0U
    mt_check(counts, lmx_service_post(service, (cast: (@: void) child_t), letter, @ letter_arena) = c.LMX_SERVICE_OK, "last post refused")
    mt_check(counts, lmx_manager_round(manager, 1U, lmx_root_clock(@ root)) = c.LMX_MANAGER_OK, "last round did not run")
    # The child's own record is returned storage by now, so the outcome is read from the PARENT's
    # node -- the cell the child wrote before it let its arena go.
    mt_check(counts, mt_node != 0, "the child had no node in R0's chain")
    mt_check(counts, mt_node\success != 0, "the child did not leave a success in the parent's node")
    mt_check(counts, mt_node\gone != 0, "the successful child did not return its own arena")
    mt_check(counts, lmx_thread_child_is(r0, child_t) != 0, "child not live before settle")
    mt_check(counts, lmx_root_cycle(@ root, 1U) = c.LMX_ROOT_OK, "settle cycle did not run")
    mt_check(counts, lmx_thread_child_is(r0, child_t) = 0, "child stayed live after settle")
    mt_check(counts, lmx_arena_ref_value(graph, 0U) = 0, "slot not cleared")
    mt_check(counts, child_at\blocks = 0 && child_at\count = 0U, "arena not released")
    mt_check(counts, lmx_manager_count(manager) = 0U, "manager not empty after settle")
    mt_check(counts, lmx_service_count(service) = 1U, "service should hold only R0 after settle")
    mt_check(counts, lmx_root_close(@ root) = c.LMX_ROOT_OK, "R0 did not close")
    mt_check(counts, lmx_root_state(@ root) = c.LMX_ROOT_CLOSED, "closed root not closed")

    failures: counts[1]
    c.printf("lmx_app_many_turns checks=%d failures=%d N=%u turns=%u accepted=%u entry_diag=%u\n",
             counts[0], failures, (cast: (unsigned) mt_n), (cast: (unsigned) turns_from_graph),
             (cast: (unsigned) accepted_from_graph), (cast: (unsigned) mt_entry_diag))
    c.fflush(0)
    free(counts)
return: failures