predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_arena.h.lm1"

# Independent L1 dynamic container. Not an Array. Public shape is LmxArrayDynamicArray; capacity is on that DynamicArray, never on LmxArrayDesc or a backing prefix.
# Public operations: create, indexed read, append, remove. Reserve is internal only.
define: LMX_LIST_OK 0
define: LMX_LIST_INVALID 1
define: LMX_LIST_NOMEM 2
define: LMX_LIST_OVERFLOW 3
define: LMX_LIST_BOUNDS 4
define: LMX_LIST_MIN_CAP 2

prototype:
    fn: lmx_list_new_owned (int: type; @: LmxArena arena) @: void
    fn: lmx_list_append_owned (@: void list; @: void value; @: LmxArena arena) int
    fn: lmx_list_remove_owned (@: void list; size_t: index; @@: void removed; @: LmxArena arena) int
    fn: lmx_list_value (@: void list; size_t: index) @: void
    fn: lmx_list_len (@: void list) size_t
    fn: lmx_list_cap (@: void list) size_t
    fn: lmx_list_data (@: void list) @: void
end: prototype
