# Official SQLite amalgamation: exactly sqlite3.c + sqlite3.h, no build-time fetch.
# Keep the normal upstream feature profile and explicitly retain serialized mode.
set(_lmx_sqlite_root "${CMAKE_CURRENT_LIST_DIR}/..")
add_library(lmx_sqlite3 STATIC "${_lmx_sqlite_root}/vendor/sqlite3/sqlite3.c")
add_library(LMX::sqlite3 ALIAS lmx_sqlite3)
target_include_directories(lmx_sqlite3 PUBLIC "${_lmx_sqlite_root}/vendor/sqlite3")
target_compile_definitions(lmx_sqlite3 PRIVATE SQLITE_THREADSAFE=1)
lmx_c99_target(lmx_sqlite3)
if(UNIX)
    find_package(Threads REQUIRED)
    target_link_libraries(lmx_sqlite3 PUBLIC Threads::Threads m ${CMAKE_DL_LIBS})
endif()

if(BUILD_TESTING)
    add_executable(lmx_sqlite3_smoke "${_lmx_sqlite_root}/tests/sqlite3_smoke.c")
    target_link_libraries(lmx_sqlite3_smoke PRIVATE LMX::sqlite3)
    lmx_c99_target(lmx_sqlite3_smoke)
    add_test(NAME sqlite3.memory_prepared_rollback COMMAND lmx_sqlite3_smoke)
endif()
if(LMX_BUILD_EXAMPLES)
    add_executable(lmx_sqlite3_example "${_lmx_sqlite_root}/examples/sqlite3_example.c")
    target_link_libraries(lmx_sqlite3_example PRIVATE LMX::sqlite3)
    lmx_c99_target(lmx_sqlite3_example)
endif()
unset(_lmx_sqlite_root)
