# Probe R7 (machine module): the emit:16961 shape, an index chain whose index runs a door call,
# `part_ns[0][c.pick(i)]`, before a later actual that runs a door call.
predef: "probe_calls.h.lm1"
fn: show (@@: part_ns int; int: i) int
    if: c.take(part_ns[0][c.pick(i)], c.pick(i), i) != 0
        return: 1
    return: 0
end: show
