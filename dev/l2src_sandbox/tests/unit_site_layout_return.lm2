# Body and trailer returns preserve the actual layout across a narrower declared
# result, then ordinary init/rebind and hidden forwarding. Each producer runs once.
A: (int: x 1)
B: (int: y 2)
C: (int: x 11; int: y 22; int: pad 33)
D: (int: x 11; int: pad 55; int: y 44)
Stats: (int: calls 0)
fn: make (int: which) A
    Stats\calls: Stats\calls + 1
    if: which = 0
        return: @C
return: @D
@: B shared @B
fn: observe () int
return: shared\y
fn: caller () int
    @: A shared make(0)
    int: first observe()
    shared: make(1)
    int: second observe()
    if: first != 22 || second != 44 || Stats\calls != 2
        return: 81
return: 7
sendMessage: exit(exit_code: caller(); stdout: ""; stderr: "")
return
