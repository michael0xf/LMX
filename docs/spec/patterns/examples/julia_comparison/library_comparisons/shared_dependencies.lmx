        FxTypeToken
        ReceiverIndex
        SequenceSize

FxTry:
    private:
        @: operation
        @: args
    return: @
    attempt:
        throws: copy(FxThrows\kernel)
        private: @: info FxKernel\signature(subject := operation)
        return: FxKernel\attempt(operation; args; info\throws)

FxTwo:
    private:
        @: first
        @: second
    return: @
    make:
        private: @: out (copy(()))
        sys\resize(out; 2)
        out[0] := first
        out[1] := second
        return: out
