# Slice 297 probe (CALLABLE-PLACE-NAMED-RECEPTION; Codex 294 review): the place's formals are int x, char y; the fn
# written into it has int y, char x.  A literal named actual takes its context from the selected formal of its name:
# `y: 300` is no char of the declared signature but an int of g -- 5 * 10 + 300 = 350 -- never a refusal or a convert
# by the declared signature.  Entry 7; 22/25 from the catches; 40 for another value; a refusal at translation shows the
# declared signature typing the literal.
fn: g (int: y; char: x) int
    return: (cast: (int) x) * 10 + y
end: g
Places:
    fn: f (int: x; char: y) int
        return: x * 10 + (cast: (int) y)
    end: f
end: Places
int: Hw 0
fn: write_place () int
    ---
        @: Places\f Hw
        return: 1
        catch: implements ()
            return: 24
    ---
end: write_place
fn: call_wide_y () int
    ---
        int: got Places\f(x: 5; y: 300)
        return: got
        catch: call ()
            return: 22
        catch: convert ()
            return: 25
    ---
end: call_wide_y
fn: run () int
    int: v 0
    @: Hw g g
    if: write_place() != 1
        return: 34
    ---
    v: call_wide_y()
    if: v = 22 || v = 25
        return: v
    ---
    if: v != 350
        return: 40
    ---
    return: 7
end: run
int: code run()
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
