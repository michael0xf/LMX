# A method's own named Structure declared in a nested body (OPUS-Q54-CONTINUE-20260929-14 2b): the `if:` body's field
# S, built at its statement and read there -- 7.
fn: m () int
    int: r 0
    if: r = 0
        S:
            int: v 4
        if: S\v = 4
            r: 7
        r: r + 0
    int: out r
    return: out
end: m
int: r 0
r: m()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
