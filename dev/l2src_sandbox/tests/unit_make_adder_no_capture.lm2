# T6b. A model that names nothing of the host's activation: the node has no captured field
# (args, return, then the frames). z is never named, so it is not carried. inc: 1 is 7.
fn: makeInc (int: z) fn: (int: x) int
    fn: inc (int: x) int
        return: x + 6
    return: inc

inc7: makeInc 5
int: a (inc7: 1)
int: ok 0
if: a = 7
    ok: 7
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
