# steps/named-struct-exec.md, slice 1 (plan §3 :245 (a)): a named Structure closed by a column-0 bare
# `return` -- Q19.1: a return trailer closes any callable Structure, the named one included.  Today
# the translator reads it as a statement of the entry with a trailer, refused.  Slice 1 flips this
# row: it translates, and Counter\n reads the initializer.
Counter:
    size_t: n 0U
    n: n + 1U
return
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
