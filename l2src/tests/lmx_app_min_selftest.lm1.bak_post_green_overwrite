# lmx_app_min_selftest.lm1 -- 083000 pool_make + 082000 SUCCESS/FAIL
# Two separate R0 sessions (same-R0 second create returns 0 / entry_diag=2).
# handoff_ready = kernel only. success=1 + running=0 = Message body only.

@: LmxRoot app_root 0
@: LmxArena app_child_arena 0
@: Lmx app_source 0
@: LmxMsg app_child_msg 0
@: LmxThread app_child_t 0
@: LmxSchedule app_child_sched 0
@: LmxMsg app_letter 0
size_t: app_phase 0U
size_t: app_letters_taken 0U
size_t: app_child_turns 0U
size_t: app_mode 0U
size_t: app_success_turns 0U

fn: app_child_body (@: Lmx node) int
    @: LmxThread t
    @: void letter
    app_child_turns: app_child_turns + 1U
    t: lmx_thread_current()
    if: t = 0 || t\message = 0
        return: 0
    ---
    if: lmx_thread_mail_count(t, c.LMX_POST_INBOX) > 0U
        letter: lmx_thread_mail_take(t, c.LMX_POST_INBOX)
        if: letter != 0
            app_letters_taken: app_letters_taken + 1U
            app_letter: (cast: (@: LmxMsg) letter)
            if: app_mode = 1U
                app_success_turns: app_child_turns
                t\message\success: 1
                t\message\running: 0
            ---
        ---
    ---
return: 0

fn: app_root_entry (@: Lmx node) int
    @: LmxMsg child
    @: LmxThread child_t
    @: LmxPost child_mail
    @: LmxSchedule child_sched
    @: LmxMethod method
    @: LmxPool methods
    @: Lmx graph
    if: app_phase != 0U || app_root = 0 || app_child_arena = 0 || app_source = 0
        return: 0
    ---
    child: lmx_root_create(app_root, app_child_arena, 0U, app_source)
    if: child = 0
        return: 0
    ---
    app_child_msg: child
    methods: lmx_pool_make(app_child_arena, 2U * c.sizeof(c.LmxMethod), c.sizeof(c.LmxMethod),
                           c.LMX_KIND_METHOD, c.LMX_TYPE_METHOD)
    if: methods = 0
        return: 0
    ---
    method: lmx_method_intern(app_child_arena, methods, (cast: (LmxEntry) app_child_body), 1U)
    graph: child\graph
    if: method = 0 || graph = 0
        return: 0
    ---
    lmx_arena_ref_store(graph, 0U, (cast: (@: void) method))
    child_mail: (cast: (@: LmxPost) lmx_arena_take(app_child_arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    child_t: (cast: (@: LmxThread) lmx_arena_take(app_child_arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_THREAD, c.LMX_DOMAIN_THREAD))
    child_sched: (cast: (@: LmxSchedule) lmx_arena_take(app_child_arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: child_mail = 0 || child_t = 0 || child_sched = 0
        return: 0
    ---
    if: lmx_post_init(app_child_arena, child_mail) != c.LMX_POST_OK
        return: 0
    ---
    if: lmx_schedule_init(child_sched, app_child_arena, (cast: (@: void) child_t), 100000U) != c.LMX_SCHEDULE_OK
        return: 0
    ---
    if: lmx_thread_attach(child_t, child, child_mail, child_sched) != c.LMX_THREAD_OK
        return: 0
    ---
    if: lmx_child_thread(lmx_root_thread(app_root), child, child_t) != c.LMX_CHILD_OK
        return: 0
    ---
    app_child_t: child_t
    app_child_sched: child_sched
    app_phase: 1U
return: 0

sub: app_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
        c.fflush(c.stdout)
    ---
end: app_check

fn: app_session (@: int counts; size_t: mode) int
    LmxRoot: root
    LmxArena: child_arena
    LmxArena: letter_arena
    @: LmxArena letter_at 0
    @: LmxArena root_arena 0
    @: LmxMsg message 0
    @: LmxThread r0 0
    @: Lmx graph 0
    @: Lmx source 0
    @: LmxMsg letter 0
    @: void witness 0
    @: LmxService service 0
    @: LmxManager manager 0
    memset((cast: (@: void) (@ root)), 0, c.sizeof(c.LmxRoot))
    memset((cast: (@: void) (@ child_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ letter_arena)), 0, c.sizeof(c.LmxArena))
    app_root: @ root
    letter_at: @ letter_arena
    app_phase: 0U
    app_mode: mode
    app_child_msg: 0
    app_child_t: 0
    app_child_sched: 0
    app_letters_taken: 0U
    app_child_turns: 0U
    app_check(counts, lmx_root_open(@ root, app_root_entry, 120000U, 0U, 0U) = c.LMX_ROOT_OK, "R0 did not open")
    message: lmx_root_message(@ root)
    r0: lmx_root_thread(@ root)
    root_arena: lmx_root_arena(@ root)
    graph: message\graph
    service: lmx_root_service(@ root)
    manager: lmx_root_manager(@ root)
    app_check(counts, message != 0 && r0 != 0 && root_arena != 0, "R0 missing pieces")
    if: message = 0 || r0 = 0
        return: 1
    ---
    source: lmx_node_new_owned(root_arena)
    app_check(counts, source != 0 && lmx_arena_refs_open_owned(root_arena, source, 2U) = 0, "template not built")
    if: source = 0
        return: 1
    ---
    lmx_arena_ref_store(graph, 7U, (cast: (@: void) source))
    app_source: source
    app_check(counts, lmx_arena_open(@ child_arena) = 0, "child arena did not open")
    app_child_arena: @ child_arena
    app_check(counts, lmx_root_cycle(@ root, 4U) = c.LMX_ROOT_OK, "create cycle did not run")
    app_check(counts, app_phase = 1U && app_child_msg != 0 && app_child_t != 0, "child was not wired")
    app_check(counts, lmx_arena_ref_value(graph, 0U) = (cast: (@: void) app_child_msg), "child not published")
    app_check(counts, lmx_range_classify(@ child_arena, (cast: (@: void) app_child_msg)) = c.LMX_DOMAIN_KIND_MSG_RECORD, "child not in own arena")
    app_check(counts, lmx_thread_child_is(r0, app_child_t) != 0, "child not live after publish")
    app_check(counts, lmx_schedule_wait(app_child_sched, lmx_root_clock(@ root)) = c.LMX_SCHEDULE_OK, "schedule wait failed")
    app_check(counts, lmx_manager_add(manager, app_child_sched) = c.LMX_MANAGER_OK, "child not in manager")
    app_check(counts, lmx_service_find(service, (cast: (@: void) app_child_t)) = (cast: (@: void) app_child_t), "child not in service")
    witness: lmx_arena_take(@ child_arena, 1U, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT)
    app_check(counts, witness != 0 && lmx_arena_ref_store(app_child_msg\graph, 1U, witness) = 0, "witness not rooted")
    app_check(counts, lmx_arena_open_simple(@ letter_arena) = 0, "letter arena did not open")
    letter: (cast: (@: LmxMsg) lmx_arena_take(@ letter_arena, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
    app_check(counts, letter != 0, "letter missing")
    letter\running: 1
    letter\success: 0
    letter\handoff_ready: 0
    letter\graph: 0
    letter\index: 0U
    app_check(counts, lmx_service_post(service, (cast: (@: void) app_child_t), letter, @ letter_arena) = c.LMX_SERVICE_OK, "post refused")
    app_check(counts, letter_at\count = 0U, "letter arena not attached")
    app_check(counts, lmx_range_classify(@ child_arena, (cast: (@: void) letter)) = c.LMX_DOMAIN_KIND_MSG_RECORD, "letter not in recipient index")
    app_check(counts, lmx_thread_mail_count(app_child_t, c.LMX_POST_INBOX) = 1U, "inbox empty after post")
    app_check(counts, lmx_root_cycle(@ root, 4U) = c.LMX_ROOT_OK, "turn cycle did not run")
    app_check(counts, app_child_turns >= 1U && app_letters_taken = 1U, "child did not take letter")
    app_check(counts, app_letter = letter, "taken letter mismatch")
    if: mode = 1U
        if: lmx_thread_child_is(r0, app_child_t) != 0
            app_check(counts, lmx_root_cycle(@ root, 1U) = c.LMX_ROOT_OK, "success-settle cycle did not run")
        ---
        app_check(counts, lmx_thread_child_is(r0, app_child_t) = 0, "success child stayed live")
        app_check(counts, lmx_arena_ref_value(graph, 0U) = 0, "success slot not cleared")
        app_check(counts, lmx_range_classify(@ child_arena, witness) = c.LMX_KIND_NONE, "success arena not released")
        app_check(counts, lmx_manager_count(manager) = 0U, "manager not empty after success")
        app_check(counts, lmx_service_count(service) = 1U, "service should hold only R0 after success")
    else:
        app_check(counts, app_child_msg\running = 1 && app_child_msg\success = 0, "fail child completed itself")
        app_check(counts, lmx_stop_children(r0) = c.LMX_SETTLE_OK, "stop_children refused")
        app_check(counts, app_child_msg\running = 0, "stop did not clear running")
        app_check(counts, app_child_msg\handoff_ready != 0, "stop did not set handoff_ready")
        app_check(counts, lmx_root_cycle(@ root, 1U) = c.LMX_ROOT_OK, "fail-settle cycle did not run")
        app_check(counts, lmx_thread_child_is(r0, app_child_t) = 0, "fail child stayed live")
        app_check(counts, lmx_arena_ref_value(graph, 0U) = (cast: (@: void) app_child_msg), "failure root not retained")
        app_check(counts, lmx_range_classify(root_arena, witness) != c.LMX_KIND_NONE, "failed blocks did not join parent")
        app_check(counts, lmx_range_classify(@ child_arena, witness) = c.LMX_KIND_NONE, "fail arena not emptied")
        app_check(counts, lmx_manager_count(manager) = 0U, "manager not empty after fail")
        app_check(counts, lmx_service_count(service) = 1U, "service should hold only R0")
    ---
    app_check(counts, lmx_root_close(@ root) = c.LMX_ROOT_OK, "R0 did not close")
    app_check(counts, lmx_root_state(@ root) = c.LMX_ROOT_CLOSED, "closed root not closed")
return: 0

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    int: failures
    if: counts = 0
        return: 2
    ---
    app_session(counts, 1U)
    app_session(counts, 2U)
    failures: counts[1]
    c.printf("lmx_app_min checks=%d failures=%d success_turns=%d\n", counts[0], failures, app_success_turns)
    free(counts)
return: failures