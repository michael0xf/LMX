Example:
    char[]: text
    return: @
    run:
        throws: copy(sys\resize\throws) copy(FxSeqPush\append\throws) copy(FxRecordOperands\record\throws)
        @[]: out []
        int: begin 0
        int: i 0
        while: 1
            if: i = length(text) || text[i] = ','
                char[]: part []
                sys\resize(part; i - begin)
                int: j 0
                while: j < length(part)
                    part[j] := text[begin + j]
                    j += 1
                FxSeqPush\append(out; (part record))
                if: i = length(text)
                    return: out
                begin := i + 1
            i += 1
