    r := (cast: (c.LmP0Text@) c.lm_compiler_xmalloc(c.sizeof(c.LmP0Text)))
    buf := (cast: (char@) c.lm_compiler_xmalloc(32U))
    if: r = 0 || buf = 0
        return: (cast: (c.LmP0Text@) (0))
    if: c.sprintf(buf, " merge body %d", res) < 0
        return: (cast: (c.LmP0Text@) (0))
    r\data := buf
    r\length := c.strlen(buf)
    return: (cast: (c.LmP0Text@) (r))
