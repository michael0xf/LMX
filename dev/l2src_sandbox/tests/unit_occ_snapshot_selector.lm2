# GROK-COLON-OCCURRENCE-20260922-02. Split out of unit_occ_sticky_selector.lm2
# (FABLE-SONNET-NODE-ROOT-20260923-121): these two cases use the `\[N]x` selector.
#
# bafca4c (the author, 2026-09-28: assignment is not a declaration; an argument is its parameter): the rows
# used the arguments bt and al, one cell each under Q29, whose "snapshot" \[0] read -- an argument has no
# place of declaration now (`\[0]arg` is refused, unit_occ_arg_slots.lm2).  bt and al are declared here.
# In between, bt's `2` is published by the nop() after it: \[0]bt and the bare bt are 2, and so is the place
# of declaration, between\bt.  In after_last, al's 2 is published before poke9's call; poke9 writes 9 through
# @: al -- the place of declaration (the author, 2026-09-28: @x of a declared field is its typed data in the
# arena) -- and al, clean since, is not written back over it (book §12): the bare al keeps its working value
# 2 -- `LAST 2`, not reloaded after the call -- while the place of declaration, after_last\al, holds 9.
fn: poke7 (@: int p) int
    \p: 7
    return: 0
end: poke7
fn: poke9 (@: int p) int
    \p: 9
    return: 0
end: poke9
fn: nop () int
    return: 0
end: nop

fn: between () int
    int: bt 0
    bt: 1
    nop()
    poke7(@: bt)
    nop()
    bt: 2
    nop()
    if: \[0]bt != 2
        return: 1
    c.printf: "BETWEEN %d\n" bt
    return: 0
end: between

fn: after_last () int
    int: al 0
    al: 1
    al: 2
    poke9(@: al)
    nop()
    c.printf: "LAST %d\n" al
    return: 0
end: after_last

between()
after_last()
int: seen 0
seen: between\bt
if: seen != 2
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
seen: after_last\al
if: seen != 9
    sendMessage: exit(exit_code: 82; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
