# FACTORY (the author, 2026-10-05): `@: h f(a)` receives a factory's result; this row wrote `h: f a` until then.
# LIMIT PROBE, not a rule. A definition inside a method reached through a
# copy of the method, `c: merge make` and `c\read()`. This implementation
# refuses a method as a merge operand, and the coverage analysis relies on
# that: a definition inside a method counts as unconsumed when its method
# neither calls it nor returns it, because no other route to it is accepted
# (unit_recv_use_nested_dormant). If this copy is ever accepted, the row goes
# red and that analysis must model the route before the row is changed.
Model:
    size_t: value 1U
end: Model

Other:
    int: p 1
    int: q 2
end: Other

fn: make () fn: () size_t
    o: merge Other
    @: Model b o
    fn: read () size_t
        return: b\value
    fn: plain () size_t
        return: 7U
    return: plain
end: make

@: r make()
size_t: got r()
c: merge make
size_t: z c\read()
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
