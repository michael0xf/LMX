# The source-owned named definition S is dormant at its declaration (§9).
# Re-entering m neither copies nor calls S (§12, Q19.2). Its same v cell,
# explicitly written9 by the first m call, remains9 during the second:99.
fn: m (int: k) int
    S:
        int: v 4
    if: k = 1
        S\v: 9
    int: out 0
    out: S\v
    return: out
end: m
int: a (m: 1)
int: b (m: 0)
int: r (a * 10 + b)
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
