# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: seen 0
)
sub: main () (
    int: hits 4
    Bump:
        node\hits := hits + 1
)
    call: Bump
main()
int: seen main\data\hits

sub: observe ()
    @: shared node[0]
    shared\Observed\seen := seen
observe()
