# Two written receiver acts retain distinct source identities, but repeated
# m assigns one prepared output place. Runtime alone cannot prove both facts:
# the gate also inspects the acts and their shared physical write place.
receiveMessage: m
int: code 7
if: m = 0
    code: 81
receiveMessage: m
if: m != 0
    code: 82
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
