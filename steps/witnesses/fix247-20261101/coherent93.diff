+# A raw dereference whose every step is a walker input value, in a method that
+# is not a machine function, is the graph's DEREF: a null holder raises
+# `interpreter` (LMX_semantics #exceptions). Lower takes the checked walker route
+# only for such a dereference (lm_compiler_emit_indirect_span_full, when its
+# operand also has a full value); the throw-channel analysis marks every one, so
+# every method that may raise there has the status channel.
+fn: lm_compiler_indirect_managed (int: levels; int: source_type; int: mi) int
+    c.L2FrontendScratchChar96: type_storage
+    @: type char (cast: (@: char) type_storage\buffer)
+    int: step_type source_type
+    int: i 0
+    if: mi < 0 || levels < 1 || c.lm_compiler_m_machine(mi) != 0
+        return: 0
+    while: i < levels
+        step_type: c.lm_compiler_indirect_type(step_type)
+        if: step_type < 0 || c.lm_compiler_foreign_value_ft(c.lm_compiler_formal_raw(step_type)) != 0 || c.lm_compiler_emit_input_value_type(step_type, 0, type) != 0
+            return: 0
+        i: i + 1
+    ---
+    return: 1
+end: lm_compiler_indirect_managed
