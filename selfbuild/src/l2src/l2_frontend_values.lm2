# Ordinary L2 frontend value, ownership and representation helpers.
# The26 inherited C cells stay owned by the existing frontend; aliases address the same cells.
predef: "l2src/l2_application.h.lm1"
predef: "l2src/l2_frontend_helpers.h.lm1"
predef: "l2src/l2_frontend_alloc.h.lm1"
include: "<stddef.h>" "<stdio.h>" "<stdlib.h>" "<string.h>" "<limits.h>"

fn: lm_compiler_fn (int: mi; int: k) c.LmP0Text@
    @@@: m_fn_cell void (cast: (@@@) (@ c.l2_m_fn))
    c.LmP0Text@@: row
    if: mi < 0 || k < 0 || m_fn_cell[0][mi] = 0
        return: (cast: (c.LmP0Text@) (0))
    row := (cast: (c.LmP0Text@@) m_fn_cell[0][mi])
    return: (cast: (c.LmP0Text@) (row[k]))
end: lm_compiler_fn

fn: lm_compiler_ft (int: mi; int: k) int
    int@@@: m_ft_cell (cast: (int@@@) (@ c.l2_m_ft))
    int@: row
    if: mi < 0 || k < 0 || m_ft_cell[0][mi] = 0
        return: (cast: (int) (0))
    row := m_ft_cell[0][mi]
    return: (cast: (int) (row[k]))
end: lm_compiler_ft

fn: lm_compiler_fn_set (int: mi; int: k; c.LmP0Text@: v) int
    @@@: m_fn_cell void (cast: (@@@) (@ c.l2_m_fn))
    c.LmP0Text@@: row
    if: mi < 0 || k < 0 || m_fn_cell[0][mi] = 0
        return: (cast: (int) (1))
    row := (cast: (c.LmP0Text@@) m_fn_cell[0][mi])
    row[k] := v
    return: (cast: (int) (0))
end: lm_compiler_fn_set

fn: lm_compiler_ft_set (int: mi; int: k; int: v) int
    int@@@: m_ft_cell (cast: (int@@@) (@ c.l2_m_ft))
    int@: row
    if: mi < 0 || k < 0 || m_ft_cell[0][mi] = 0
        return: (cast: (int) (1))
    row := m_ft_cell[0][mi]
    row[k] := v
    return: (cast: (int) (0))
end: lm_compiler_ft_set

fn: lm_compiler_emit_empty_return (int: mi; const: (char@: ind)) int
    int@@: m_throws_cell (cast: (int@@) (@ c.l2_m_throws))
    c.FILE@@: out_cell (cast: (c.FILE@@) (@ c.l2_out))
    if: c.lm_compiler_m_machine(mi) = 0 || (m_throws_cell[0] != 0 && m_throws_cell[0][mi] != 0)
        return: (cast: (int) ((cast: (int) (c.fprintf(out_cell[0], "%sreturn: 0\n", ind) < 0))))
    return: (cast: (int) ((cast: (int) (c.fprintf(out_cell[0], "%sreturn\n", ind) < 0))))
end: lm_compiler_emit_empty_return

fn: lm_compiler_method_by_source (const: (c.LmP0Node@: source_node)) int
    int@: m_n_cell (cast: (int@) (@ c.l2_m_n))
    c.LmP0Node@@@: m_node_cell (cast: (c.LmP0Node@@@) (@ c.l2_m_node))
    int: mi 0
    if: source_node = 0
        return: (cast: (int) (-1))
    while: mi < m_n_cell[0]
        if: m_node_cell[0][mi] = source_node
            return: (cast: (int) (mi))
        mi := mi + 1
    return: (cast: (int) (-1))
end: lm_compiler_method_by_source

fn: lm_compiler_root_names_method (const: (c.LmP0Structure@: root); const: (c.LmP0Text@: name)) int
    c.LmP0Field@: field
    c.LmP0Node@: item
    c.LmP0Text@: nm
    if: root = 0 || name = 0
        return: (cast: (int) (0))
    field := c.lm_compiler_next_active(root\first_field)
    while: field != 0
        item := field\value
        if: c.lm_compiler_root_method_head(c.lm_compiler_app_head(item)) != 0
            nm := c.lm_compiler_os_fn_name(item)
            if: nm != 0 && c.lm_compiler_text_same(nm, name) != 0
                return: (cast: (int) (1))
            ---
        ---
        if: c.lm_compiler_text_eq(c.lm_compiler_app_head(item), "os") != 0 && c.lm_compiler_os_branch_method(c.lm_compiler_os_selected_branch(item), name) != 0
            return: (cast: (int) (1))
        field := c.lm_compiler_next_active(field\next)
    ---
    return: (cast: (int) (0))
end: lm_compiler_root_names_method

fn: lm_compiler_find_method (const: (c.LmP0Text@: name)) int
    int@: m_n_cell (cast: (int@) (@ c.l2_m_n))
    c.LmP0Text@@@: m_name_cell (cast: (c.LmP0Text@@@) (@ c.l2_m_name))
    int: i 0
    int: linear 0
    # tp113: the rows of name's bucket in row order (lm_compiler_vmix_*, module end -- the values copy of the method-name
    # index helpers of l2_frontend_context) instead of every row; the first row text_same admits is the scan's. Without
    # the index (allocation failure, -2) the scan runs over every row as before.
    i := lm_compiler_vmix_first(name)
    if: i = -2
        linear := 1
        i := 0
    ---
    while: i >= 0 && (linear = 0 || i < m_n_cell[0])
        if: c.lm_compiler_text_same(m_name_cell[0][i], name)
            return: (cast: (int) (i))
        i := lm_compiler_vmix_step(i, linear)
    ---
    return: (cast: (int) (-1))
end: lm_compiler_find_method

fn: lm_compiler_occ_head (const: (c.LmP0Text@: t); int@: out_occ; c.LmP0Text@@: out_name) int
    c.LmP0Text@: result_text
    size_t: i 0U
    size_t: n
    unsigned: ch
    int: occ 0
    if: t = 0 || t\data = 0 || out_occ = 0 || out_name = 0
        return: (cast: (int) (1))
    n := t\length
    if: n < 5U || t\data[0] != 92 || t\data[1] != 91
        return: (cast: (int) (1))
    i := 2U
    if: i >= n || t\data[i] < 48 || t\data[i] > 57
        return: (cast: (int) (2))
    while: i < n && t\data[i] >= 48 && t\data[i] <= 57
        ch := (cast: (unsigned) t\data[i]) - 48U
        if: occ > (c.INT_MAX / 10) - (cast: (int) ch)
            return: (cast: (int) (2))
        occ := occ * 10 + (cast: (int) ch)
        i := i + 1U
    if: i >= n || t\data[i] != 93
        return: (cast: (int) (2))
    i := i + 1U
    if: i >= n
        return: (cast: (int) (2))
    \out_name := (cast: (c.LmP0Text@) c.lm_compiler_xmalloc(c.sizeof(c.LmP0Text)))
    if: \out_name = 0
        return: (cast: (int) (2))
    result_text := (cast: (c.LmP0Text@) (\out_name))
    result_text\data := t\data + i
    result_text\length := n - i
    \out_occ := occ
    return: (cast: (int) (0))
end: lm_compiler_occ_head

fn: lm_compiler_predef_import (const: (c.LmP0Text@: quoted); const: (char@: source_path)) const: c.LmP0Text@
    int@: alloc_err_cell (cast: (int@) (@ c.l2_alloc_err))
    size_t: n
    size_t: i 0U
    size_t: text_length
    size_t: slash 0U
    size_t: maximum (cast: (size_t) -1)
    char@: data
    c.LmP0Text: joined
    c.LmP0Text@: kept
    if: quoted = 0 || quoted\data = 0 || quoted\length < 2U
        return: (cast: (const: c.LmP0Text@) (quoted))
    if: quoted\data[0] != 34 || quoted\data[quoted\length - 1U] != 34 || source_path = 0
        return: (cast: (const: c.LmP0Text@) (quoted))
    n := quoted\length - 2U
    if: n = 0U || (n >= 2U && quoted\data[2] = 58)
        return: (cast: (const: c.LmP0Text@) (quoted))
    i := 1U
    while: i <= n
        if: quoted\data[i] = 47 || quoted\data[i] = 92
            return: (cast: (const: c.LmP0Text@) (quoted))
        i := i + 1U
    ---
    text_length := c.strlen(source_path)
    i := 0U
    while: i < text_length
        if: source_path[i] = 47 || source_path[i] = 92
            slash := i + 1U
        i := i + 1U
    ---
    if: slash = 0U && text_length >= 2U && source_path[1] = 58
        slash := 2U
    if: slash = 0U
        return: (cast: (const: c.LmP0Text@) (quoted))
    if: quoted\length = maximum || slash > maximum - quoted\length - 1U
        alloc_err_cell[0] := 2
        return: (cast: (const: c.LmP0Text@) (0))
    data := (cast: (char@) c.lm_compiler_xmalloc(quoted\length + slash + 1U))
    if: data = 0
        return: (cast: (const: c.LmP0Text@) (0))
    data[0] := 34
    c.memcpy(data + 1U, source_path, slash)
    c.memcpy(data + 1U + slash, quoted\data + 1U, quoted\length - 1U)
    data[quoted\length + slash] := 0
    joined\data := data
    joined\length := quoted\length + slash
    kept := c.lm_compiler_cnt_keep(@ joined)
    c.lm_compiler_xfree((cast: (@) data))
    if: kept = 0 && alloc_err_cell[0] = 0
        alloc_err_cell[0] := 1
    return: (cast: (const: c.LmP0Text@) (kept))
end: lm_compiler_predef_import

fn: lm_compiler_foreign_truncate (int: count) int
    int@: foreign_n_cell (cast: (int@) (@ c.l2_foreign_n))
    c.LmP0Text@@@: foreign_name_cell (cast: (c.LmP0Text@@@) (@ c.l2_foreign_name))
    int: i count
    while: i < foreign_n_cell[0]
        c.lm_compiler_xfree((cast: (@) foreign_name_cell[0][i]))
        foreign_name_cell[0][i] := 0
        i := i + 1
    foreign_n_cell[0] := count
    return: (cast: (int) (0))
end: lm_compiler_foreign_truncate

fn: lm_compiler_foreign_free () int
    c.LmP0Text@@@: foreign_name_cell (cast: (c.LmP0Text@@@) (@ c.l2_foreign_name))
    int@@: foreign_depth_cell (cast: (int@@) (@ c.l2_foreign_depth))
    int@@: foreign_const_cell (cast: (int@@) (@ c.l2_foreign_const))
    int@@: foreign_raw_c_cell (cast: (int@@) (@ c.l2_foreign_raw_c))
    int@: foreign_n_cell (cast: (int@) (@ c.l2_foreign_n))
    int@: foreign_cap_cell (cast: (int@) (@ c.l2_foreign_cap))
    lm_compiler_foreign_truncate(0)
    if: foreign_name_cell[0] != 0
        c.lm_compiler_xfree((cast: (@) foreign_name_cell[0]))
    if: foreign_depth_cell[0] != 0
        c.lm_compiler_xfree((cast: (@) foreign_depth_cell[0]))
    if: foreign_const_cell[0] != 0
        c.lm_compiler_xfree((cast: (@) foreign_const_cell[0]))
    if: foreign_raw_c_cell[0] != 0
        c.lm_compiler_xfree((cast: (@) foreign_raw_c_cell[0]))
    foreign_name_cell[0] := 0
    foreign_depth_cell[0] := 0
    foreign_const_cell[0] := 0
    foreign_raw_c_cell[0] := 0
    foreign_n_cell[0] := 0
    foreign_cap_cell[0] := 0
    return: (cast: (int) (0))
end: lm_compiler_foreign_free

fn: lm_compiler_ret_code_of_formal (int: ft; int@: out_ty) int
    int: depth
    int: qualified
    c.LmP0Text: word
    ft := lm_compiler_formal_raw(ft)
    \out_ty := ft
    if: ft = 34
        \out_ty := 33
    if: ft = 12
        \out_ty := 3
    if: ft = 3
        \out_ty := 35
    if: ft = 17
        \out_ty := 32
    # Preserve the established return-code adapters; all other pointer types
    # use the same stable closed type interner as declarations and addresses.
    if: ft != 3 && ft != 12 && ft != 16 && ft != 17 && ft < 100 && lm_compiler_pointer_depth(ft) > 0
        if: lm_compiler_type_parts(ft, @ word, @ depth, @ qualified) != 0
            return: (cast: (int) (1))
        \out_ty := lm_compiler_foreign_intern(@ word, depth, qualified)
        if: \out_ty < 100
            return: (cast: (int) (1))
        ---
    ---
    return: (cast: (int) (0))
end: lm_compiler_ret_code_of_formal

fn: lm_compiler_foreign_intern (const: (c.LmP0Text@: name); int: depth; int: is_const) int
    int: raw_c 0
    c.LmP0Text: raw
    if: c.lm_compiler_c_stmt_door(name) != 0
        raw\data := name\data + 2U
        raw\length := name\length - 2U
        name := @ raw
        raw_c := 1
    ---
    return: (cast: (int) (lm_compiler_foreign_intern_parts(name, depth, is_const, raw_c)))
end: lm_compiler_foreign_intern

# Literal table payload, borrowed from the selected source document.
fn: lm_compiler_profile_payload (const: (c.LmP0Text@: text); c.LmP0Text@: out) int
    const: (char@: bytes text\data)
    size_t: n text\length
    if: n >= 2U && ((bytes[0] = 96 && bytes[n - 1U] = 96) || (bytes[0] = 34 && bytes[n - 1U] = 34))
        bytes := bytes + 1U
        n := n - 2U
    out\data := bytes
    out\length := n
    return: (cast: (int) (n != 0U))

# The same eligibility as the physical scalar exporter, from the ACTIVE table.
# A spelling never selects a semantic row: aliases keep their own source names.
fn: lm_compiler_primitive_scalar_spelling (int: row; c.LmP0Text@: out) int
    int@: pr_table (cast: (int@) (@ c.l2_pr_t))
    int@@: rows (cast: (int@@) (@ c.l2_tb_nrow))
    int@@: widths (cast: (int@@) (@ c.l2_tb_ncol))
    int@@: first (cast: (int@@) (@ c.l2_tb_cell0))
    char@@@: names (cast: (char@@@) (@ c.l2_tbx_name))
    c.LmP0Node@@@: nodes (cast: (c.LmP0Node@@@) (@ c.l2_tbx_arg))
    const: (char@: key "cell")
    c.LmP0Node@: entry_node 0
    int: col 0
    int: index 0
    int: flag 0
    if: out = 0 || c.lm_compiler_prim_load() != 0 || row < 0 || row >= rows[0][pr_table[0]]
        return: 0
    while: flag < 5
        if: flag = 1
            key := "reference"
        if: flag = 2
            key := "opaque"
        if: flag = 3
            key := "callable"
        if: flag = 4
            key := "descriptor"
        col := c.lm_compiler_table_col(pr_table[0], key)
        if: col < 0
            return: 0
        index := first[0][pr_table[0]] + row * widths[0][pr_table[0]] + col
        entry_node := nodes[0][index]
        if: names[0][index] = 0 || entry_node = 0 || entry_node\kind != c.LM_P0_NODE_ATOM || entry_node\as = 0
            return: 0
        if: (flag = 0 && c.lm_compiler_payload_eq((cast: (const: c.LmP0Text@) entry_node\as\atom), "1") = 0) || (flag != 0 && c.lm_compiler_payload_eq((cast: (const: c.LmP0Text@) entry_node\as\atom), "0") = 0)
            return: 0
        flag := flag + 1
    col := c.lm_compiler_table_col(pr_table[0], "spelling")
    if: col < 0
        return: 0
    index := first[0][pr_table[0]] + row * widths[0][pr_table[0]] + col
    entry_node := nodes[0][index]
    if: names[0][index] = 0 || entry_node = 0 || entry_node\kind != c.LM_P0_NODE_ATOM || entry_node\as = 0
        return: 0
    return: lm_compiler_profile_payload((cast: (const: c.LmP0Text@) entry_node\as\atom), out)

fn: lm_compiler_primitive_scalar_row (const: (c.LmP0Text@: name)) int
    c.LmP0Text: spelling
    int: row -1
    # Type probing also occurs while source parts/predefs are being indexed.
    # Absence at that phase is not a failed completed primitive-table load.
    if: name = 0 || c.lm_compiler_table_find("primitive.description") < 0
        return: -1
    if: c.lm_compiler_prim_load() != 0
        return: -1
    row := c.lm_compiler_prim_row(name, 0)
    if: lm_compiler_primitive_scalar_spelling(row, @ spelling) = 0
        return: -1
    return: row

# Existing unit identity plus a reversible spelling, not a runtime row number.
# Escaping non-alphanumeric bytes also distinguishes spaces from underscores.
fn: lm_compiler_scalar_alias_name (const: (c.LmP0Text@: spelling); c.L2Tx@: dest) int
    unsigned@: hash_a (cast: (unsigned@) (@ c.l2_module_hash_a))
    unsigned@: hash_b (cast: (unsigned@) (@ c.l2_module_hash_b))
    const: (char@: digits "0123456789abcdef")
    c.L2FrontendScratchChar64: prefix
    char@: text (cast: (char@) prefix\buffer)
    size_t: i 0U
    int: ch 0
    if: c.snprintf(text, 64U, "L2S%08X%08X_", hash_a[0], hash_b[0]) < 0 || c.lm_compiler_tx_set(dest, text) != 0
        return: 1
    while: i < spelling\length
        ch := (cast: (int) spelling\data[i])
        if: ch < 0
            ch := ch + 256
        if: (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57)
            if: c.lm_compiler_tx_catn(dest, spelling\data + i, 1U) != 0
                return: 1
            ---
        else:
            if: c.lm_compiler_tx_cat(dest, "_") != 0 || c.lm_compiler_tx_catn(dest, digits + ch / 16, 1U) != 0 || c.lm_compiler_tx_catn(dest, digits + ch % 16, 1U) != 0
                return: 1
            ---
        i := i + 1U
    return: 0

# Native spelling is a projection only. type_parts still returns the source word.
fn: lm_compiler_native_type_text (int: raw; c.L2Tx@: dest) int
    int@: count (cast: (int@) (@ c.l2_foreign_n))
    int@@: raw_c (cast: (int@@) (@ c.l2_foreign_raw_c))
    c.LmP0Text: word_storage
    c.LmP0Text@: word @ word_storage
    c.LmP0Text: spelling
    int: depth 0
    int: qualified 0
    int: row -1
    int: i raw - 100
    if: dest = 0 || lm_compiler_type_parts(raw, word, @ depth, @ qualified) != 0
        return: 1
    if: raw >= 100 && i < count[0]
        if: lm_compiler_foreign_native_void(i) != 0
            return: c.lm_compiler_tx_set(dest, "void")
        if: raw_c[0][i] = 0
            row := lm_compiler_primitive_scalar_row(word)
            if: row >= 0 && lm_compiler_primitive_scalar_spelling(row, @ spelling) != 0
                return: lm_compiler_scalar_alias_name(@ spelling, dest)
            ---
        ---
    ---
    return: c.lm_compiler_tx_wrapn(dest, 0, word\data, word\length, 0)

fn: lm_compiler_emit_native_type (c.FILE@: out; int: raw) int
    c.L2FrontendScratchChar160: storage
    c.L2Tx: value
    c.L2Tx@: text c.lm_compiler_tx_local(@ value, (cast: (char@) storage\buffer), 160U)
    if: text = 0 || lm_compiler_native_type_text(raw, text) != 0
        return: 1
    return: (cast: (int) (c.fwrite(text\data, 1U, text\len, out) != text\len))

fn: lm_compiler_emit_scalar_aliases (c.FILE@: out) int
    int@: count (cast: (int@) (@ c.l2_foreign_n))
    int@@: raw_c (cast: (int@@) (@ c.l2_foreign_raw_c))
    c.LmP0Text@@@: words (cast: (c.LmP0Text@@@) (@ c.l2_foreign_name))
    c.LmP0Text: spelling_storage
    c.LmP0Text@: spelling @ spelling_storage
    c.LmP0Text: earlier
    c.L2FrontendScratchChar160: storage
    c.L2Tx: value
    c.L2Tx@: text c.lm_compiler_tx_local(@ value, (cast: (char@) storage\buffer), 160U)
    int: i 0
    int: prior 0
    int: row -1
    int: old -1
    int: started 0
    int@: alloc_err_cell (cast: (int@) (@ c.l2_alloc_err))
    c.LmP0Text: wide_storage
    c.LmP0Text@: wide @ wide_storage
    # The widest unsigned scalar, which the generated numeric views name for the magnitude of a contextual
    # literal, is a foreign scalar of this unit like any other: it is interned here, before the aliases are
    # written, so that its alias is among them. A profile without that row (or no primitive table) interns
    # nothing, and then no generated text names it.
    wide\data := "ullong"
    wide\length := 6U
    if: lm_compiler_foreign_byvalue(wide) < 0 && alloc_err_cell[0] != 0
        return: 1
    while: i < count[0]
        row := -1
        if: raw_c[0][i] = 0
            row := lm_compiler_primitive_scalar_row(words[0][i])
        if: row < 0 || lm_compiler_primitive_scalar_spelling(row, spelling) = 0
            i := i + 1
            continue
        prior := 0
        while: prior < i
            old := -1
            if: raw_c[0][prior] = 0
                old := lm_compiler_primitive_scalar_row(words[0][prior])
            if: old >= 0 && lm_compiler_primitive_scalar_spelling(old, @ earlier) != 0 && c.lm_compiler_text_same(spelling, @ earlier) != 0
                break
            prior := prior + 1
        if: prior = i
            if: started = 0 && c.fputs("include: \"<stdint.h>\"\n", out) < 0
                return: 1
            started := 1
            if: text = 0 || lm_compiler_scalar_alias_name(spelling, text) != 0 || c.fprintf(out, "type: %s ", text\data) < 0 || c.fwrite(spelling\data, 1U, spelling\length, out) != spelling\length || c.fputs("\n", out) < 0
                return: 1
            ---
        ---
        i := i + 1
    return: 0

# Canonicalize literal SOURCE pairs only at the compiler input boundary.
# The runtime identity contains every column and original literal token.
fn: lm_compiler_scalar_column_compare (const: (c.LmP0Text@: a); const: (c.LmP0Text@: b)) int
    c.LmP0Text: left_storage
    c.LmP0Text: right_storage
    c.LmP0Text@: left @ left_storage
    c.LmP0Text@: right @ right_storage
    size_t: common 0U
    int: order 0
    if: lm_compiler_profile_payload(a, left) = 0 || lm_compiler_profile_payload(b, right) = 0
        return: 0
    common := left\length
    if: right\length < common
        common := right\length
    order := c.memcmp(left\data, right\data, common)
    if: order != 0
        return: order
    if: left\length < right\length
        return: -1
    return: (cast: (int) (left\length > right\length))

# 0 complete, 2 unavailable/nonliteral, 1 allocation/output failure.
fn: lm_compiler_scalar_source_blob (int: row; c.L2Tx@: out) int
    int@: primitive_table (cast: (int@) (@ c.l2_pr_t))
    int@@: rows (cast: (int@@) (@ c.l2_tb_nrow))
    int@@: widths (cast: (int@@) (@ c.l2_tb_ncol))
    int@@: first (cast: (int@@) (@ c.l2_tb_cell0))
    int@@: column_first (cast: (int@@) (@ c.l2_tb_col0))
    c.LmP0Text@@@: columns (cast: (c.LmP0Text@@@) (@ c.l2_tbc_name))
    char@@@: values (cast: (char@@@) (@ c.l2_tbx_name))
    c.LmP0Text@: key 0
    c.LmP0Text@: prior 0
    c.LmP0Text: payload_storage
    c.LmP0Text@: payload @ payload_storage
    const: (char@: raw 0)
    int: width 0
    int: slot 0
    int: rank 0
    int: column 0
    int: previous -1
    int: best -1
    if: out = 0 || c.lm_compiler_prim_load() != 0 || row < 0 || row >= rows[0][primitive_table[0]]
        return: 1
    width := widths[0][primitive_table[0]]
    slot := first[0][primitive_table[0]] + row * width
    while: column < width
        key := columns[0][column_first[0][primitive_table[0]] + column]
        if: key = 0 || lm_compiler_profile_payload(key, payload) = 0 || values[0][slot + column] = 0
            c.lm_compiler_tx_clear(out)
            return: 2
        column := column + 1
    if: c.lm_compiler_tx_set(out, "primitive.description") != 0 || c.lm_compiler_tx_catn(out, "", 1U) != 0
        return: 1
    while: rank < width
        best := -1
        column := 0
        while: column < width
            key := columns[0][column_first[0][primitive_table[0]] + column]
            if: previous >= 0
                prior := columns[0][column_first[0][primitive_table[0]] + previous]
                if: lm_compiler_scalar_column_compare(key, prior) <= 0
                    column := column + 1
                    continue
                ---
            if: best < 0 || lm_compiler_scalar_column_compare(key, columns[0][column_first[0][primitive_table[0]] + best]) < 0
                best := column
            column := column + 1
        ---
        if: best < 0
            c.lm_compiler_tx_clear(out)
            return: 2
        key := columns[0][column_first[0][primitive_table[0]] + best]
        raw := values[0][slot + best]
        if: lm_compiler_profile_payload(key, payload) = 0 || c.lm_compiler_tx_catn(out, payload\data, payload\length) != 0 || c.lm_compiler_tx_catn(out, "", 1U) != 0 || c.lm_compiler_tx_catn(out, raw, c.strlen(raw)) != 0 || c.lm_compiler_tx_catn(out, "", 1U) != 0
            return: 1
        previous := best
        rank := rank + 1
    ---
    return: 0

# Emit one physical ABI and a separately validated complete ACTIVE SOURCE.
# The caller consumes status through its existing failure/throw boundary.
fn: lm_compiler_emit_scalar_contract (int: ft; const: (char@: ind); c.L2Tx@: abi; c.L2Tx@: source; c.L2Tx@: status; int: with_source) int
    c.FILE@@: out (cast: (c.FILE@@) (@ c.l2_out))
    int@: next (cast: (int@) (@ c.l2_tn))
    c.L2FrontendScratchChar64: name_storage
    char@: name (cast: (char@) name_storage\buffer)
    c.L2FrontendScratchChar160: physical_storage
    c.L2Tx: physical_tx
    c.L2Tx@: physical c.lm_compiler_tx_local(@ physical_tx, (cast: (char@) physical_storage\buffer), 160U)
    c.L2FrontendScratchChar1024: blob_storage
    c.L2Tx: blob_tx
    c.L2Tx@: blob c.lm_compiler_tx_local(@ blob_tx, (cast: (char@) blob_storage\buffer), 1024U)
    c.LmP0Text: spelling_storage
    c.LmP0Text: printed_storage
    c.LmP0Text@: spelling @ spelling_storage
    c.LmP0Text@: printed @ printed_storage
    int: row lm_compiler_scalar_type_row(ft)
    int: id next[0]
    int: complete 0
    int: failed 0
    next[0] := next[0] + 1
    if: row < 0 || ind = 0 || abi = 0 || source = 0 || status = 0 || physical = 0 || blob = 0 || lm_compiler_primitive_scalar_spelling(row, spelling) = 0
        return: 1
    if: c.snprintf(name, 64U, "l2_sabi%d", id) < 0 || c.lm_compiler_tx_set(abi, name) != 0 || c.snprintf(name, 64U, "l2_ssource%d", id) < 0 || c.lm_compiler_tx_set(source, name) != 0 || c.snprintf(name, 64U, "l2_sstatus%d", id) < 0 || c.lm_compiler_tx_set(status, name) != 0
        return: 1
    if: c.lm_compiler_tx_set(physical, "c.") != 0 || c.lm_compiler_tx_catn(physical, spelling\data, spelling\length) != 0
        return: 1
    printed\data := physical\data
    printed\length := physical\len
    if: c.fprintf(out[0], "%s@: void l2_physical%d 0\n%sconst: @(LmxScalarABI %s) lmx_graph_scalar_binding(lmx_graph_intern(", ind, id, ind, abi\data) < 0 || lm_compiler_emit_cstr(printed) != 0 || c.fprintf(out[0], ", %zuU), @ l2_physical%d)\n%s@: void %s 0\n%sint: %s c.LMX_WALK_OK\n%sif: %s = 0\n%s    %s: c.LMX_WALK_INVALID\n%s---\n", physical\len, id, ind, source\data, ind, status\data, ind, abi\data, ind, status\data, ind) < 0
        failed := 1
    complete := 2
    if: with_source != 0
        complete := lm_compiler_scalar_source_blob(row, blob)
    if: complete = 1
        failed := 1
    if: complete = 0 && failed = 0
        printed\data := blob\data
        printed\length := blob\len
        if: c.fprintf(out[0], "%sif: %s != 0\n%s    %s: lmx_graph_scalar_description(%s, ", ind, abi\data, ind, status\data, abi\data) < 0 || lm_compiler_emit_cstr(printed) != 0 || c.fprintf(out[0], ", %zuU, @ %s)\n%s---\n", blob\len, source\data, ind) < 0
            failed := 1
        ---
    ---
    return: failed

# Material C storage becomes an owned exact Value once. A supplied complete
# Value is forwarded by the caller instead of entering this adapter again.
fn: lm_compiler_emit_scalar_capture (int: ft; const: (char@: arena); const: (char@: storage); const: (char@: seed); const: (char@: ind); const: (char@: dest); const: (char@: fail); int: declared_source) int
    c.FILE@@: out (cast: (c.FILE@@) (@ c.l2_out))
    int@: next (cast: (int@) (@ c.l2_tn))
    c.L2FrontendScratchChar64: abi_storage
    c.L2FrontendScratchChar64: source_storage
    c.L2FrontendScratchChar64: status_storage
    c.L2Tx: abi_tx
    c.L2Tx: source_tx
    c.L2Tx: status_tx
    c.L2Tx@: abi c.lm_compiler_tx_local(@ abi_tx, (cast: (char@) abi_storage\buffer), 64U)
    c.L2Tx@: source c.lm_compiler_tx_local(@ source_tx, (cast: (char@) source_storage\buffer), 64U)
    c.L2Tx@: status c.lm_compiler_tx_local(@ status_tx, (cast: (char@) status_storage\buffer), 64U)
    int: id next[0]
    next[0] := next[0] + 1
    if: arena = 0 || storage = 0 || ind = 0 || dest = 0 || fail = 0 || abi = 0 || source = 0 || status = 0 || lm_compiler_emit_scalar_contract(ft, ind, abi, source, status, declared_source) != 0
        return: 1
    if: c.fprintf(out[0], "%sLmxWalkValue: l2_scontext%d\n%slmx_walk_value_clear(@ l2_scontext%d)\n", ind, id, ind, id) < 0
        return: 1
    if: seed != 0 && c.fprintf(out[0], "%smemcpy((cast: (@: void) (@ l2_scontext%d)), (cast: (const: @: void) (%s)), c.sizeof(c.LmxWalkValue))\n", ind, id, seed) < 0
        return: 1
    # Raw C transport has no producer SOURCE. Its expected formal must not
    # invent a language alias; a supplied full context remains authoritative.
    if: declared_source != 0 && c.fprintf(out[0], "%sif: l2_scontext%d.source_type = 0\n%s    l2_scontext%d.source_type: %s\n%s---\n", ind, id, ind, id, source\data, ind) < 0
        return: 1
    if: c.fprintf(out[0], "%s@: Lmx l2_sprofile%d lmx_range_profile(%s, %s)\n%sif: l2_scontext%d.physical_profile != 0\n%s    l2_sprofile%d: l2_scontext%d.physical_profile\n%s---\n", ind, id, arena, storage, ind, id, ind, id, id, ind) < 0
        return: 1
    if: c.fprintf(out[0], "%s@: LmxPool l2_spool%d lmx_range_cell_pool(%s, %s)\n%sint: l2_stype%d c.LMX_TYPE_FOREIGN\n%sint: l2_sdirect%d 0\n%sif: l2_spool%d != 0\n%s    if: l2_spool%d\\kind != c.LMX_KIND_PRIMITIVE || lmx_type_base(l2_spool%d\\type) != c.LMX_TYPE_FOREIGN || l2_spool%d\\scalar_abi != %s\n%s        %s: c.LMX_WALK_INVALID\n%s    ---\n%s    l2_stype%d: l2_spool%d\\type\n%s    l2_sprofile%d: l2_spool%d\\profile\n", ind, id, arena, storage, ind, id, ind, id, ind, id, ind, id, id, id, abi\data, ind, status\data, ind, ind, id, id, ind, id, id) < 0
        return: 1
    # A real raw graph cell supplies its own complete context and absence;
    # loading it does not read an unfilled C object or replace its SOURCE.
    if: seed = 0 && c.fprintf(out[0], "%s    if: %s = c.LMX_WALK_OK\n%s        %s: lmx_walk_value_load(%s, %s, l2_stype%d, %s)\n%s        l2_sdirect%d: 1\n%s    ---\n", ind, status\data, ind, status\data, arena, storage, id, dest, ind, id, ind) < 0
        return: 1
    if: c.fprintf(out[0], "%selse:\n%s    if: lmx_range_entry_at(%s, %s) != 0\n%s        %s: c.LMX_WALK_INVALID\n%s    ---\n%s---\n", ind, ind, arena, storage, ind, status\data, ind, ind) < 0
        return: 1
    if: c.fprintf(out[0], "%sif: %s = c.LMX_WALK_OK && l2_sdirect%d = 0\n%s    %s: lmx_walk_value_foreign_capture(%s, %s, l2_stype%d, %s, l2_sprofile%d, @ l2_scontext%d, %s)\n%s---\n%sif: %s != c.LMX_WALK_OK\n%s    lmx_call_note_walk_fail(%s)\n%s    %s\n%s---\n", ind, status\data, id, ind, status\data, arena, storage, id, abi\data, id, id, dest, ind, ind, status\data, ind, status\data, ind, fail, ind) < 0
        return: 1
    return: 0

fn: lm_compiler_foreign_intern_parts (const: (c.LmP0Text@: name); int: depth; int: is_const; int: raw_c) int
    int@: foreign_n_cell (cast: (int@) (@ c.l2_foreign_n))
    int@@: foreign_depth_cell (cast: (int@@) (@ c.l2_foreign_depth))
    int@@: foreign_const_cell (cast: (int@@) (@ c.l2_foreign_const))
    int@@: foreign_raw_c_cell (cast: (int@@) (@ c.l2_foreign_raw_c))
    c.LmP0Text@@@: foreign_name_cell (cast: (c.LmP0Text@@@) (@ c.l2_foreign_name))
    int@: alloc_err_cell (cast: (int@) (@ c.l2_alloc_err))
    int@: foreign_cap_cell (cast: (int@) (@ c.l2_foreign_cap))
    int: i 0
    int: cap
    size_t: nb
    c.LmP0Text@: saved
    c.LmP0Text@@: nn 0
    int@: nd 0
    int@: nc 0
    int@: nr 0
    if: name = 0 || c.lm_compiler_ident_word(name) = 0 || depth < 0
        return: (cast: (int) (0 - 1))
    # A foreign type is spelled as written (Stage B, Mikhail 2026-09-14): no
    # header is read to admit it, and the C compiler checks the spelling.
    while: i < foreign_n_cell[0]
        if: foreign_depth_cell[0][i] = depth && foreign_const_cell[0][i] = is_const && foreign_raw_c_cell[0][i] = raw_c && c.lm_compiler_text_same(foreign_name_cell[0][i], name)
            return: (cast: (int) (100 + i))
        i := i + 1
    if: foreign_n_cell[0] = c.INT_MAX - 100
        alloc_err_cell[0] := 2
        return: (cast: (int) (0 - 1))
    if: foreign_n_cell[0] >= foreign_cap_cell[0]
        cap := foreign_cap_cell[0]
        if: cap < 1
            cap := 4
        while: cap <= foreign_n_cell[0]
            if: cap > c.INT_MAX / 2
                cap := foreign_n_cell[0] + 1
            else:
                cap := cap * 2
            ---
        ---
        if: c.lm_compiler_mul_ok((cast: (size_t) cap), c.sizeof((cast: (char@) 0))) = 0 || c.lm_compiler_mul_ok((cast: (size_t) cap), c.sizeof(c.int)) = 0
            alloc_err_cell[0] := 2
            return: (cast: (int) (0 - 1))
        nb := (cast: (size_t) cap) * c.sizeof((cast: (char@) 0))
        nn := (cast: (c.LmP0Text@@) c.lm_compiler_xmalloc(nb))
        nd := (cast: (int@) c.lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        nc := (cast: (int@) c.lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        nr := (cast: (int@) c.lm_compiler_xmalloc((cast: (size_t) cap) * c.sizeof(c.int)))
        if: nn = 0 || nd = 0 || nc = 0 || nr = 0
            if: nn != 0
                c.lm_compiler_xfree((cast: (@) nn))
            if: nd != 0
                c.lm_compiler_xfree((cast: (@) nd))
            if: nc != 0
                c.lm_compiler_xfree((cast: (@) nc))
            if: nr != 0
                c.lm_compiler_xfree((cast: (@) nr))
            return: (cast: (int) (0 - 1))
        if: foreign_n_cell[0] > 0
            c.memcpy((cast: (@) nn), (cast: (@) foreign_name_cell[0]), (cast: (size_t) foreign_n_cell[0]) * c.sizeof((cast: (char@) 0)))
            c.memcpy((cast: (@) nd), (cast: (@) foreign_depth_cell[0]), (cast: (size_t) foreign_n_cell[0]) * c.sizeof(c.int))
            c.memcpy((cast: (@) nc), (cast: (@) foreign_const_cell[0]), (cast: (size_t) foreign_n_cell[0]) * c.sizeof(c.int))
            c.memcpy((cast: (@) nr), (cast: (@) foreign_raw_c_cell[0]), (cast: (size_t) foreign_n_cell[0]) * c.sizeof(c.int))
        ---
        if: foreign_name_cell[0] != 0
            c.lm_compiler_xfree((cast: (@) foreign_name_cell[0]))
        if: foreign_depth_cell[0] != 0
            c.lm_compiler_xfree((cast: (@) foreign_depth_cell[0]))
        if: foreign_const_cell[0] != 0
            c.lm_compiler_xfree((cast: (@) foreign_const_cell[0]))
        if: foreign_raw_c_cell[0] != 0
            c.lm_compiler_xfree((cast: (@) foreign_raw_c_cell[0]))
        foreign_name_cell[0] := nn
        foreign_depth_cell[0] := nd
        foreign_const_cell[0] := nc
        foreign_raw_c_cell[0] := nr
        foreign_cap_cell[0] := cap
    ---
    # A new interned contract owns its text, including bytes from a predef
    # document that may be destroyed before this contract is emitted.
    saved := c.lm_compiler_text_clone(name)
    if: saved = 0
        return: (cast: (int) (-1))
    foreign_name_cell[0][foreign_n_cell[0]] := saved
    foreign_depth_cell[0][foreign_n_cell[0]] := depth
    foreign_const_cell[0][foreign_n_cell[0]] := is_const
    foreign_raw_c_cell[0][foreign_n_cell[0]] := raw_c
    i := foreign_n_cell[0]
    foreign_n_cell[0] := foreign_n_cell[0] + 1
    # Source-driven predef/include: the unit declares what runtime headers it needs.
    # Name/prefix triggers (LmP0*, c.lm_p0_set_diagnostic, per-name stdlib/string) are gone.
    return: (cast: (int) (100 + i))
end: lm_compiler_foreign_intern_parts

fn: lm_compiler_foreign_byvalue (const: (c.LmP0Text@: t)) int
    if: t = 0 || t\data = 0
        return: (cast: (int) (0 - 1))
    if: t\length > 2U && t\data[0] = 99 && t\data[1] = 46
        return: (cast: (int) (lm_compiler_foreign_intern(t, 0, 0)))
    ---
    if: lm_compiler_primitive_scalar_row(t) >= 0
        return: lm_compiler_foreign_intern_parts(t, 0, 0, 0)
    # Bare foreign by-value names are refused (type-position rule, ticket 106 PART2).
    return: (cast: (int) (0 - 1))
end: lm_compiler_foreign_byvalue

fn: lm_compiler_foreign_native_void (int: i) int
    int@: foreign_n_cell (cast: (int@) (@ c.l2_foreign_n))
    int@@: foreign_raw_c_cell (cast: (int@@) (@ c.l2_foreign_raw_c))
    int@@: foreign_depth_cell (cast: (int@@) (@ c.l2_foreign_depth))
    c.LmP0Text@@@: foreign_name_cell (cast: (c.LmP0Text@@@) (@ c.l2_foreign_name))
    if: i < 0 || i >= foreign_n_cell[0] || foreign_raw_c_cell[0][i] != 0 || foreign_depth_cell[0][i] < 1
        return: (cast: (int) (0))
    return: (cast: (int) (c.lm_compiler_text_eq(foreign_name_cell[0][i], "Lmx") || c.lm_compiler_text_eq(foreign_name_cell[0][i], "LmxArray")))
end: lm_compiler_foreign_native_void

fn: lm_compiler_write_foreign_native (c.FILE@: out; int: i) int
    c.LmP0Text@@@: foreign_name_cell (cast: (c.LmP0Text@@@) (@ c.l2_foreign_name))
    if: lm_compiler_foreign_native_void(i) != 0
        return: (cast: (int) ((cast: (int) (c.fputs("void", out) < 0))))
    return: lm_compiler_emit_native_type(out, 100 + i)
end: lm_compiler_write_foreign_native

fn: lm_compiler_emit_foreign_named (c.FILE@: out; int: ty; const: (char@: prefix); const: (c.LmP0Text@: name)) int
    int@: foreign_n_cell (cast: (int@) (@ c.l2_foreign_n))
    int@@: foreign_depth_cell (cast: (int@@) (@ c.l2_foreign_depth))
    c.LmP0Text@@@: foreign_name_cell (cast: (c.LmP0Text@@@) (@ c.l2_foreign_name))
    int@@: foreign_const_cell (cast: (int@@) (@ c.l2_foreign_const))
    int: i ty - 100
    if: out = 0 || i < 0 || i >= foreign_n_cell[0]
        return: (cast: (int) (1))
    if: prefix != 0 && c.fputs(prefix, out) < 0
        return: (cast: (int) (1))
    if: foreign_depth_cell[0][i] = 0
        if: lm_compiler_emit_native_type(out, ty) != 0 || c.fputs(": ", out) < 0 || c.lm_compiler_write_text(out, name) != 0
            return: (cast: (int) (1))
        return: (cast: (int) (0))
    if: foreign_const_cell[0][i] != 0 && c.fputs("const: ", out) < 0
        return: (cast: (int) (1))
    if: c.lm_compiler_emit_address_marks(out, foreign_depth_cell[0][i]) != 0
        return: (cast: (int) (1))
    if: foreign_const_cell[0][i] != 0
        if: c.fputs("(", out) < 0
            return: (cast: (int) (1))
        ---
    else:
        if: c.fputs(": ", out) < 0
            return: (cast: (int) (1))
    ---
    if: lm_compiler_write_foreign_native(out, i) != 0
        return: (cast: (int) (1))
    if: c.fputs(" ", out) < 0 || c.lm_compiler_write_text(out, name) != 0
        return: (cast: (int) (1))
    if: foreign_const_cell[0][i] != 0 && c.fputs(")", out) < 0
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: lm_compiler_emit_foreign_named

fn: lm_compiler_emit_foreign_temp (c.FILE@: out; int: ty; const: (char@: ind); int: temp) int
    int@: foreign_n_cell (cast: (int@) (@ c.l2_foreign_n))
    int@@: foreign_const_cell (cast: (int@@) (@ c.l2_foreign_const))
    int@@: foreign_depth_cell (cast: (int@@) (@ c.l2_foreign_depth))
    c.LmP0Text@@@: foreign_name_cell (cast: (c.LmP0Text@@@) (@ c.l2_foreign_name))
    int: i ty - 100
    if: out = 0 || i < 0 || i >= foreign_n_cell[0]
        return: (cast: (int) (1))
    if: c.fputs(ind, out) < 0
        return: (cast: (int) (1))
    # A const foreign pointer keeps its qualifier: `const: @(T l2_tN)`.
    if: foreign_const_cell[0][i] != 0
        if: foreign_depth_cell[0][i] < 1 || c.fputs("const: ", out) < 0 || c.lm_compiler_emit_address_marks(out, foreign_depth_cell[0][i]) != 0 || c.fputs("(", out) < 0 || lm_compiler_write_foreign_native(out, i) != 0 || c.fprintf(out, " l2_t%d)\n", temp) < 0
            return: (cast: (int) (1))
        return: (cast: (int) (0))
    if: foreign_depth_cell[0][i] = 0
        if: lm_compiler_emit_native_type(out, ty) != 0 || c.fprintf(out, ": l2_t%d\n", temp) < 0
            return: (cast: (int) (1))
        return: (cast: (int) (0))
    if: c.lm_compiler_emit_address_marks(out, foreign_depth_cell[0][i]) != 0 || c.fputs(": ", out) < 0
        return: (cast: (int) (1))
    if: lm_compiler_write_foreign_native(out, i) != 0
        return: (cast: (int) (1))
    if: c.fprintf(out, " l2_t%d\n", temp) < 0
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: lm_compiler_emit_foreign_temp

fn: lm_compiler_emit_foreign_return (c.FILE@: out; int: ty) int
    int@: foreign_n_cell (cast: (int@) (@ c.l2_foreign_n))
    int@@: foreign_const_cell (cast: (int@@) (@ c.l2_foreign_const))
    int@@: foreign_depth_cell (cast: (int@@) (@ c.l2_foreign_depth))
    int: i ty - 100
    if: out = 0 || i < 0 || i >= foreign_n_cell[0]
        return: (cast: (int) (1))
    # A const foreign pointer return: `) const: @(T)`.
    if: foreign_const_cell[0][i] != 0
        if: foreign_depth_cell[0][i] < 1 || c.fputs(") const: ", out) < 0 || c.lm_compiler_emit_address_marks(out, foreign_depth_cell[0][i]) != 0 || c.fputs("(", out) < 0 || lm_compiler_write_foreign_native(out, i) != 0 || c.fputs(")", out) < 0
            return: (cast: (int) (1))
        return: (cast: (int) (0))
    if: foreign_depth_cell[0][i] = 0
        if: c.fputs(") ", out) < 0
            return: (cast: (int) (1))
        return: (cast: (int) (lm_compiler_write_foreign_native(out, i)))
    if: c.fputs(") ", out) < 0 || c.lm_compiler_emit_address_marks(out, foreign_depth_cell[0][i]) != 0 || c.fputs(": ", out) < 0
        return: (cast: (int) (1))
    return: (cast: (int) (lm_compiler_write_foreign_native(out, i)))
end: lm_compiler_emit_foreign_return

fn: lm_compiler_lmx_text () c.LmP0Text@
    c.LmP0Text@@: lmx_name_cache_cell (cast: (c.LmP0Text@@) (@ c.l2_lmx_name_cache))
    c.LmP0Text@: cached_text
    if: lmx_name_cache_cell[0] = 0
        lmx_name_cache_cell[0] := (cast: (c.LmP0Text@) c.lm_compiler_xmalloc(c.sizeof(c.LmP0Text)))
        if: lmx_name_cache_cell[0] = 0
            return: (cast: (c.LmP0Text@) (0))
        cached_text := lmx_name_cache_cell[0]
        cached_text\data := "Lmx"
        cached_text\length := 3U
    ---
