# N4 (Codex OPUS-CODEX-20261015-19; LMX_semantics.ru.md #method-parts): every place the code declares is required at
# the admission, also one in a branch that would not run: y is declared only under x = 2, D has no y, and the call
# is refused before x: 1 runs. D\x keeps 10. Entry 7.
S:
    int: x 0
    x: 1
    if: x = 2
        int: y 5
end: S
D:
    int: x 10
end: D
fn: run () int
    int: r 82
    call: S D
    catch: call ()
        r: 83
        if: D\x = 10
            r: 7
    ---
return: r
int: got run()
sendMessage: exit(exit_code: got; stdout: ""; stderr: "")
return
