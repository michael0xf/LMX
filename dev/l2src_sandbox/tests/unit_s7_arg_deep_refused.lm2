# take(h\a\p). The leaf is Plain. take reads equals. Plain has none.

Plain:
    size_t: toString 0U
end: Plain

Mid:
    Plain: p
end: Mid

Holder:
    Mid: a
end: Holder

Equatable:
    size_t: equals 0U
end: Equatable

fn: take (Equatable: slot) int
    slot\equals: 1U
return: 4

fn: pass (Holder: h) int
return: take(h\a\p)
