# OPEN positive. An operand of arithmetic, of an ordering and of an equality
# is a place where a result is received: the bare name of a held callable
# that returns a value is executed there, as a method named bare is. p0 gives
# 100 and z0 gives 0; each notes 1 at a call. z0's occurrence is not null, so
# `z0 = 0` tells the result from the occurrence: it calls z0 once and is true.
# A short-circuit does not execute the operand it skips. An opaque reference
# that received the name compares the occurrence and calls nothing. This
# implementation refuses the arithmetic and the ordering, and compares the
# occurrence in the equalities. Entry 7.
int: trace 0

fn: note (int: v) int
    node\trace: node\trace + v
    return: 0
end: note

fn: seen () int
    return: node\trace
end: seen

fn: make0 (int: n) fn: () int
    fn: f0 () int
        return: n + note(1)
    return: f0

p0: make0 100
z0: make0 0

fn: inner () int
    int: a p0 + 1
    if: a != 101 || seen() != 1
        return: 81
    int: b 0
    if: p0 < 500
        b: 1
    if: b != 1 || seen() != 2
        return: 82
    int: c 0
    if: z0 = 0
        c: 1
    if: c != 1 || seen() != 3
        return: 83
    int: d 0
    if: z0 != 0
        d: 1
    if: d != 0 || seen() != 4
        return: 84
    int: e 0
    if: p0 = 0
        e: 1
    if: e != 0 || seen() != 5
        return: 85
    int: f 0
    if: z0 != 0 && p0 = 100
        f: 1
    if: f != 0 || seen() != 6
        return: 86
    int: g 0
    if: p0 = 100 || z0 = 0
        g: 1
    if: g != 1 || seen() != 7
        return: 87
    @: void k z0
    int: h 0
    if: k = 0
        h: 1
    if: h != 0 || seen() != 7
        return: 88
    return: 7
end: inner

int: ok inner()
int: ra z0 + 3
if: ra != 3 || seen() != 8
    ok: 89
int: rb 0
if: z0 = 0
    rb: 1
if: rb != 1 || seen() != 9
    ok: 90
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
