# REGEX: ordinary callable Structures and explicit matching state.
# Draft source, not a kernel execution report. See REGEX_IMPLEMENTATION.md.
# All pointers below are ordinary references to typed records; no regex layout.
# Internal cursors return the existing Maybe. Public eachMatch uses yield / Stop.

TextView:
    @: prepare RxTextPrepareSource\make
    int: profile
    []char: source

# Explicit per-operation text index. It is ordinary data, never executable
# source or a second graph of the program. view is the original public view.
RxPreparedText:
    @TextView: view 0
    int: profile
    []char: source
    []int: units
    []int: byteOffsets

Span:
    @: source
    int: begin
    int: end
    private: @RxPreparedSource: prepared

Match:
    @: source
    int: begin
    int: end
    @: captures
    private: @RxPreparedSource: prepared

Pattern :: (@RxPreparedSource: source; int: position; @: captures; return: @)

RxPredicate :: (int: unit; return: int)

RxReplacementArgument :: (@Match: matched)

# The actual replacement callable supplies its own exact result requirement.

PatternArgument:

PatternEncoding:

PatternPosition:

# parent() below is parent(D), D = parent(current CODE), so it selects the
# actual copied owner of Call/Next. It makes no assumption that node equals D.

# Configuration values, not negative limits or machine-count sentinels.
RxUnbounded:
    const: int: upperBoundAbsent 1

const: int: extendFirst 0

const: int: stopFirst 1

const: @: unbounded RxUnbounded

RxCandidate:
    int: position 0
    @: captures 0

RxCandidateMake:
    private:
        int: position
        @: captures
    return: @
    make:
        private: @: out (copy(RxCandidate))
        out\position := position
        out\captures := captures
        return: out

# This persistent singly linked journal is ordinary DATA. A successful capture
# allocates a new link; no already published link or Match is ever rewritten.
RxCaptureEntry:
    @: previous 0
    []char: name ""
    int: begin 0
    int: end 0

RxCaptureAdd:
    private:
        @: previous
        []char: name
        int: begin
        int: end
    return: @
    add:
        private: @: out (copy(RxCaptureEntry))
        out\previous := previous
        out\name := name
        out\begin := begin
        out\end := end
        return: out

RxCaptureLatest:
    private:
        @: captures
        []char: name
    return: @
    find:
        private: @: cursor captures
        while: cursor != 0
            if: FxEqualFields\equalFields(cursor\name; name) != 0
                return: FxSome\some(value := cursor)
            cursor := cursor\previous
        return: FxNone\none()

# A real owner -> Call DATA -> open CODE. The configuration is an ordinary
# enclosing Structure, not an argument of Pattern or a copied native local.
RxPatternOwner:
    private:
        @: engine 0
        @: config 0
    Call:
        private:
            @RxPreparedSource: source
            int: position
            @: captures
        required: source position captures
        return: @
        open:
            private: @: owner parent()
            private: @: engine owner\private\engine
            return: engine(config := owner\private\config; source := source; position := position; captures := captures)

RxPatternFactory:
    private:
        @: engine
        @: config
    return: @
    make:
        private: @: owner (copy(RxPatternOwner))
        owner\private\engine := engine
        owner\private\config := config
        return: owner\Call\open

# Cursor state is owned by a freshly copied object. Calling its nullary next
# advances this cursor only. It yields Maybe<Candidate> internally, so a genuine
# empty match is Some with equal positions and exhaustion alone is None.
RxCursorOwner:
    private:
        @: engine 0
        @: state 0
    Next:
        return: @
        next:
            private: @: owner parent()
            private: @: engine owner\private\engine
            return: engine(state := owner\private\state)

RxCursorFactory:
    private:
        @: engine
        @: state
    return: @
    make:
        private: @: owner (copy(RxCursorOwner))
        owner\private\engine := engine
        owner\private\state := state
        return: owner\Next\next

RxIsPattern:
    private: @: value
    return: int
    test:
        throws: copy(FxThrows\pattern)
        # Read the existing directed interface check without trial execution.
        # Unresolved compatibility is a service failure, never a false result.
        return: FxKernel\acceptsRequirement(candidate := value; requirement := Pattern)

RxNormalize:
    private: @: value
    required: value
    return: @
    make:
        throws: copy(FxThrows\pattern)
        if: RxIsPattern\test(value := value) != 0
            return: value
        return: RxLiteral\literal(value := value)

RxOpen:
    private:
        @Pattern: pattern
        @RxPreparedSource: source
        int: position
        @: captures
    return: @
    open:
        throws: copy(FxThrows\pattern)
        if: position < 0 || position > length(source\units)
            throw: PatternPosition()
        # The signature-qualified reference applies its ordinary label map.
        return: pattern(source := source; position := position; captures := captures)

RxSpanMake:
    private:
        @RxPreparedSource: source
        int: begin
        int: end
    return: @
    make:
        private: @: out (copy(Span))
        out\source := source\view
        out\private\prepared := source
        out\begin := begin
        out\end := end
        return: out

RxMatchMake:
    private:
        @RxPreparedSource: source
        int: begin
        @: candidate
    return: @
    make:
        private: @: out (copy(Match))
        out\source := source\view
        out\private\prepared := source
        out\begin := begin
        out\end := candidate\position
        out\captures := candidate\captures
        return: out
