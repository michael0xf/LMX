# An opaque reference is admitted by the required named field. Candidate has
# that field at another physical position; the use must follow its map.
Model:
    int: x 1
end: Model
Candidate:
    char: padding 'z'
    int: x 7
end: Candidate
fn: choose () @: void
return: (cast: (@: void) Candidate)
fn: read (Model: ref) int
return: ref\x
fn: check () int
    @: field Model Model
    field: choose()
    if: read(field) != 7 || Model\x != 1
        return: 81
return: 7
sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
