Counter:
    int: value 0
    Add:
        int: delta
        return: int
        add:
            @: owner parent(node)
            owner\value += delta
            return: owner\value

Example:
    int: initial
    return: @
    run:
        @: first (copy(Counter))
        first := parent(first\Add)
        @: second (copy(Counter))
        second := parent(second\Add)
        first\value := initial
        second\value := 100
        int: a first\Add\add(1)
        int: b first\Add\add(3)
        int: c second\Add\add(2)
        int: d first\Add\add(-2)
        return: (a; b; c; d)
