            # m`, takes the letter's payload, admitted to its type (D-57; q25 (ii): the field holds
            # what its declaration says).  The two-name form `receiveMessage: m T` (-172 c2) types m
            # with the synthesized letter model, and m holds the whole letter.
            if: l2_own_nsty_get(oi) >= 0 && lm_compiler_count_active(stmt\as\frame\body) = 1 && c.fprintf(l2_out, "%sl2_ngraph: (cast: (@: Lmx) lmx_arena_ref_value(l2_ngraph, 1U))\n", ind) < 0
                return: 1
            if: l2_own_nsty_get(oi) >= 0 && l2_emit_admit(mi, l2_own_nsty_get(oi), "l2_ngraph", ind) != 0
                return: 1
            if: l2_own_store(mi, oi, ind, "l2_ngraph") != 0
                return: 1
            field: lm_compiler_next_active(field\next)
            continue
        # `f()`/`f: ()`/closed empty vertical, name absent (FABLE-SONNET-
        # EMPTY-STRUCT-20260923-132): the row l2_check_body already
        # registered gets a fresh, genuinely empty Lmx node every
        # activation -- the same lmx_node_new_owned the unit root and a
        # merge result body use, but with NO lmx_arena_refs_open_owned
        # call: that refuses a 0-children count outright (lmx_arena_refs
        # .lm1), and a 0-field structural type has none to open. No
        # lmx_merge_owned either -- there is no model to merge a
        # declaration from, so nothing here can fail on admission the way
        # `Model: fresh` can; only allocation, the same class the unit
        # root's own construction already leaves as a bare propagated
        # failure, not a caught throw.
        # All original named definitions are retained at their exact source
        # fields before execution. Reaching one does not execute or replace it.
        if: l2_local_ns_shape(stmt, mi) != 0 || l2_empty_struct_decl_shape(stmt, mi) != 0
            oi: l2_own_find_decl(mi, stmt\as\frame\head, stmt)
            if: oi < 0 || l2_source_definition_ns(oi) < 0
                return: l2_error(l2_src, stmt, "internal: a source definition has no owning producer")
            if: l2_m_is_split(mi) != 0 && l2_split_data_row(oi) != 0 && l2_emit_split_source_definition(mi, oi, ind) != 0
                return: 1
            field: lm_compiler_next_active(field\next)
            continue
        # FABLE-SONNET-RECEIVE-RENAME-20260924-166 commit 3 (D-48): l2_own_find (first match)
        # was safe here only because a repeated TYPED declaration was refused (pre-Q24) -- at
        # most one row ever existed per name reaching this branch. Q24 = A lifts that refusal,
        # so this line now needs the EXACT statement's own row, not the first same-named one
        # (measured: without this, "int: arg 1" then "int: arg 2" both wrote occurrence 0).
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0
            oi: l2_own_find_decl(mi, l2_own_decl_name(stmt), stmt)
        declaration: l2_declaration(stmt)
        # FABLE-SONNET-OWN-LOOKUP-AUDIT-20260923-131 (a): was two hand-inlined
        # copies of l2_emit_own_from's own formula, missing its cache guard
        # (if: l2_q_from = 0) -- unconditionally recomputed/reassigned
        # l2_q{oi}_from every time this declaration line's branch fired,
        # instead of reusing an already-resolved reference. Same physical
        # cell either way (the formula is identical), so no behavior change
        # for any existing fixture -- generated C differs only in gaining
        # the guard around the two lines this branch already emitted.
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && l2_m_alias[l2_own_off(mi, oi)] >= 0 && (l2_own_ty[oi] = 1 || l2_own_ty[oi] = 2 || l2_own_ty[oi] = 3 || l2_own_ty[oi] = 36) && l2_emit_own_from(mi, oi, ind) != 0
            return: 1
        # A first declaration is invisible to its own initializer; a repeated
        # receiver may read and then update the same physical field.
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && declaration\candidate_count > 0 && l2_own_decl[oi] = stmt
            l2_own_excl: oi
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && declaration\candidate_count > 0
            pret: l2_emit_init_convert(stmt, declaration\candidate, mi, ind, l2_tok)
            if: pret = 1
                l2_own_excl: -1
                return: 1
            if: pret = 2 && l2_eval_fields(declaration\candidate, declaration\candidate_count, mi, ind, l2_tok) != 0
                l2_own_excl: -1
                return: 1
            ---
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && declaration\candidate_count > 0
            l2_own_excl: -1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && declaration\candidate_count > 0 && l2_own_store(mi, oi, ind, l2_tok\data) != 0
            return: 1
        # Carry (-189 c3b-2): a declaration binding a formal's field without an initializer stores the
        # name's value as it reads just before the line -- the argument, or an enclosing bound field.
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && l2_own_decl[oi] = stmt && declaration\candidate_count = 0 && l2_m_uses[l2_own_off(mi, oi)] != 0 && l2_own_direct(mi, oi) != 0 && l2_own_formal(mi, oi) >= 0 && l2_split_data_row(oi) = 0
            l2_own_excl: oi
            nxt: lm_compiler_declaration_carry(declaration)
            if: nxt = 0
                return: 1
            pret: l2_emit_value_convert_field(stmt, nxt, 1, lm_compiler_ft_of_own(l2_own_ty[oi]), mi, ind, l2_tok)
            if: pret = 2
                pret: l2_eval_fields(nxt, 1, mi, ind, l2_tok)
            l2_own_excl: -1
            if: pret != 0 || l2_own_store(mi, oi, ind, l2_tok\data) != 0
                return: 1
        ---
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt)
            field: lm_compiler_next_active(field\next)
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && (stmt = 0 || stmt\as = 0 || stmt\as\frame = 0)
            return: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0
            fr: stmt\as\frame
        # §7b: a return is an exit -- what is marked is published before it (book §14), after its value.  A `return` with
        # no value is emitted above, for both spellings; one with a value in a callable that returns nothing was refused.
        # `return: v` evaluates v as every value is evaluated -- a callable named there is called
