---
    Observed:
        int: result 23
    end: Observed
---
@: shared (data [] 0)
fn: gate () int (
    int: calls 0
)
    :=: (data \ calls) ((data \ calls) + 1)
    return: ((data \ calls) < 3)
end: gate
fn: outer () int (
    int: steps 0
)
    while: (gate) ((fn gate () int ((return 0))) (:= steps (steps + 1)) (continue))
    return: ((steps * 10) + ((gate \ data) \ calls))
end: outer
int: result (outer)
sub: main ()
    :=: ((shared \ Observed) \ result) result
end: main
main:
