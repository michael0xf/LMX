---
    Observed:
        int: seen 0
        int: r 0
    end: Observed
---
fn: tick () int
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) (((shared \ Observed) \ seen) + 1)
    return: 3
end: tick
fn: f (int: a) int
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ r) a
    return: a
end: f
fn: f (u8: a) int
    return: 2
end: f
sub: main ()
    f:
        int: a 5
    end: f
end: main
main:
