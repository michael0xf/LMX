# Source-only whole remaining P0 port from frozen224; not compiled or integrated.
# All 204 ordinary bodies; no retained handwritten L1/C body fallback.
# The existing L3 ABI writer must provide the three activation scratch records.
predef: "l1src/p0.h.lm1"
predef: "l2src/p0_own.h.lm1"
predef: "l2src/p0_text.h.lm1"
predef: "l2src/p0_scan.h.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>" "<ctype.h>" "<limits.h>"

# Original: parser.lm1:216 lm_p0_document_init_owners
fn: lm_p0_document_init_owners (@: document c.LmP0Document) int
    if: document = 0
        return: 1
    if: document\owners_initialized != 0
        return: 0
    document\source_owner: c.lm_own_new_zero(c.sizeof(c.LmOwnArena))
    document\token_arena: c.lm_own_new_zero(c.sizeof(c.LmOwnArena))
    document\tree_arena: c.lm_own_new_zero(c.sizeof(c.LmOwnArena))
    document\diagnostic_arena: c.lm_own_new_zero(c.sizeof(c.LmOwnArena))
    if: document\source_owner = 0 || document\token_arena = 0 || document\tree_arena = 0 || document\diagnostic_arena = 0
        c.lm_own_delete(document\diagnostic_arena, 0)
        c.lm_own_delete(document\tree_arena, 0)
        c.lm_own_delete(document\token_arena, 0)
        c.lm_own_delete(document\source_owner, 0)
        document\diagnostic_arena: 0
        document\tree_arena: 0
        document\token_arena: 0
        document\source_owner: 0
        return: 1
    document\owners_initialized: 1
    if: c.lm_own_arena_init(document\source_owner) != 0 || c.lm_own_arena_init(document\token_arena) != 0 || c.lm_own_arena_init(document\tree_arena) != 0 || c.lm_own_arena_init(document\diagnostic_arena) != 0
        lm_p0_document_destroy_owners(document)
        return: 1
    document\diagnostic: c.lm_own_arena_new_zero(document\diagnostic_arena, c.sizeof(c.LmP0Diagnostic))
    if: document\diagnostic = 0
        lm_p0_document_destroy_owners(document)
        return: 1
    return: 0
end: lm_p0_document_init_owners

# Original: parser.lm1:245 lm_p0_document_owners_belong_to_actor
fn: lm_p0_document_owners_belong_to_actor (const: (@: document c.LmP0Document)) int
    return: 1
end: lm_p0_document_owners_belong_to_actor

# Original: parser.lm1:248 lm_p0_document_destroy_owners
sub: lm_p0_document_destroy_owners (@: document c.LmP0Document)
    if: document != 0 && document\owners_initialized != 0
        c.lm_own_arena_destroy(document\diagnostic_arena)
        c.lm_own_delete(document\diagnostic_arena, 0)
        c.lm_own_arena_destroy(document\tree_arena)
        c.lm_own_delete(document\tree_arena, 0)
        c.lm_own_arena_destroy(document\token_arena)
        c.lm_own_delete(document\token_arena, 0)
        c.lm_own_arena_destroy(document\source_owner)
        c.lm_own_delete(document\source_owner, 0)
        document\diagnostic_arena: 0
        document\tree_arena: 0
        document\token_arena: 0
        document\source_owner: 0
        document\diagnostic: 0
        document\owners_initialized: 0
        document\frozen: 0
    ---
end: lm_p0_document_destroy_owners

# Original: parser.lm1:268 lm_p0_document_freeze_tree
sub: lm_p0_document_freeze_tree (@: document c.LmP0Document)
    if: document != 0 && document\owners_initialized != 0
        c.lm_own_arena_freeze(document\tree_arena)
        c.lm_own_arena_freeze(document\source_owner)
        document\frozen: 1
    ---
end: lm_p0_document_freeze_tree

# Original: parser.lm1:276 lm_p0_trailer_role
fn: lm_p0_trailer_role (const: (@: text char); size_t: byte_count) c.LmP0TrailerRole
    if: lm_p0_dash_fence_status_after_comment_trim(text, byte_count, 0) = c.LM_P0_DASH_FENCE_VALID
        return: c.LM_P0_TRAILER_ROLE_DASH_CUTTER
    return: lm_p0_legacy_trailer_role(text, byte_count)
end: lm_p0_trailer_role

# Original: parser.lm1:281 lm_p0_node_kind_class_name
fn: lm_p0_node_kind_class_name (c.LmP0NodeKind: kind) const: @: char
    if: kind = c.LM_P0_NODE_STRUCTURE
        return: "structure"
    if: kind = c.LM_P0_NODE_FRAME
        return: "frame"
    if: kind = c.LM_P0_NODE_ATOM
        return: "atom"
    if: kind = c.LM_P0_NODE_DISABLED
        return: "disabled"
    return: "unknown"
end: lm_p0_node_kind_class_name

# Original: parser.lm1:292 lm_p0_indent_stack_free
sub: lm_p0_indent_stack_free (@: stack c.LmP0IndentStack)
    c.lm_own_delete(stack\columns, 0)
    stack\columns: 0
    stack\count: 0U
    stack\capacity: 0U
end: lm_p0_indent_stack_free

# Original: parser.lm1:299 lm_p0_indent_stack_free_any
sub: lm_p0_indent_stack_free_any (@: object void)
    @: stack c.LmP0IndentStack

    stack: object
    lm_p0_indent_stack_free(stack)
end: lm_p0_indent_stack_free_any

# Original: parser.lm1:306 lm_p0_indent_stack_push
fn: lm_p0_indent_stack_push (@: document c.LmP0Document; @: stack c.LmP0IndentStack; size_t: column; size_t: line; size_t: source_column) int
    size_t: new_capacity
    @: columns size_t

    if: stack\count = stack\capacity
        if: stack\capacity = 0U
            new_capacity: 8U
        ---
        if: stack\capacity != 0U
            new_capacity: stack\capacity * 2U
        ---
        columns: c.lm_own_resize(stack\columns, new_capacity * c.sizeof(columns[0]))
        if: columns = 0
            lm_p0_set_diagnostic(document, 1, line, source_column, "out of memory while storing indentation levels")
            return: 0
        stack\columns: columns
        stack\capacity: new_capacity

    ---
    stack\columns[stack\count]: column
    stack\count: stack\count + 1U
    return: 1
end: lm_p0_indent_stack_push

# Original: parser.lm1:326 lm_p0_indent_stack_init
fn: lm_p0_indent_stack_init (@: document c.LmP0Document; @: stack c.LmP0IndentStack) int
    c.memset(stack, 0, c.sizeof(stack[0]))
    return: lm_p0_indent_stack_push(document, stack, 0U, 0U, 0U)
end: lm_p0_indent_stack_init

# Original: parser.lm1:330 lm_p0_indent_stack_new_empty
fn: lm_p0_indent_stack_new_empty () @: c.LmP0IndentStack
    return: c.lm_own_new_zero(1U * c.sizeof(c.LmP0IndentStack))
end: lm_p0_indent_stack_new_empty

# Original: parser.lm1:333 lm_p0_indent_stack_new
fn: lm_p0_indent_stack_new (@: document c.LmP0Document) @: c.LmP0IndentStack
    @: stack c.LmP0IndentStack

    stack: lm_p0_indent_stack_new_empty()
    if: stack = 0
        lm_p0_set_diagnostic(document, 1, 0U, 0U, "out of memory while creating indentation stack")
        return: 0
    if: lm_p0_indent_stack_init(document, stack) = 0
        c.lm_own_delete(stack, c.lm_p0_indent_stack_free_any)
        return: 0
    return: stack
end: lm_p0_indent_stack_new

# Original: parser.lm1:345 lm_p0_indent_stack_delete
sub: lm_p0_indent_stack_delete (@: stack c.LmP0IndentStack)
    c.lm_own_delete(stack, c.lm_p0_indent_stack_free_any)
end: lm_p0_indent_stack_delete

# Original: parser.lm1:349 lm_p0_indent_stack_copy
fn: lm_p0_indent_stack_copy (@: document c.LmP0Document; @: target c.LmP0IndentStack; const: (@: source c.LmP0IndentStack); size_t: line; size_t: column) int
    size_t: capacity

    c.memset(target, 0, c.sizeof(target[0]))
    if: source\capacity > source\count
        capacity: source\capacity
    ---
    if: source\capacity <= source\count
        capacity: source\count
    ---
    if: capacity = 0U
        return: 1

    target\columns: c.lm_own_new_zero(capacity * c.sizeof(c.size_t))
    if: target\columns = 0
        lm_p0_set_diagnostic(document, 1, line, column, "out of memory while copying indentation levels")
        return: 0
    c.memcpy(target\columns, source\columns, source\count * c.sizeof(c.size_t))
    target\count: source\count
    target\capacity: capacity
    return: 1
end: lm_p0_indent_stack_copy

# Original: parser.lm1:369 lm_p0_indent_stack_clone
fn: lm_p0_indent_stack_clone (@: document c.LmP0Document; const: (@: source c.LmP0IndentStack); size_t: line; size_t: column) @: c.LmP0IndentStack
    @: target c.LmP0IndentStack

    target: lm_p0_indent_stack_new_empty()
    if: target = 0
        lm_p0_set_diagnostic(document, 1, line, column, "out of memory while copying indentation levels")
        return: 0
    if: lm_p0_indent_stack_copy(document, target, source, line, column) = 0
        lm_p0_indent_stack_delete(target)
        return: 0
    return: target
end: lm_p0_indent_stack_clone

# Original: parser.lm1:381 lm_p0_indent_tab_column
fn: lm_p0_indent_tab_column (size_t: column) size_t
    return: ((column / 8U) + 1U) * 8U
end: lm_p0_indent_tab_column

# Original: parser.lm1:384 lm_p0_scan_indent_column
sub: lm_p0_scan_indent_column (const: (@: source char); size_t: start; size_t: limit_index; @: out_offset size_t; @: out_column size_t)
    size_t: p
    size_t: column

    p: start
    column: 0U
    while: p < limit_index && c.lm_p0_is_horizontal_space(source[p])
        if: source[p] = '\t'
            column: lm_p0_indent_tab_column(column)
        ---
        if: source[p] != '\t'
            column: column + 1U
        ---
        p: p + 1U

    ---
    out_offset[0]: p
    out_column[0]: column
end: lm_p0_scan_indent_column

# Original: parser.lm1:401 lm_p0_visual_column_between
fn: lm_p0_visual_column_between (const: (@: source char); size_t: start; size_t: limit_index) size_t
    size_t: p
    size_t: column

    p: start
    column: 0U
    while: p < limit_index
        if: source[p] = '\r' && p + 1U < limit_index && source[p + 1U] = '\n'
            p: p + 1U
        ---
        if: source[p] = '\r'
            column: 0U
            p: p + 1U
            continue
        if: source[p] = '\n'
            column: 0U
            p: p + 1U
            continue
        if: source[p] = '\t'
            column: lm_p0_indent_tab_column(column)
            p: p + 1U
            continue
        column: column + 1U
        p: p + 1U

    ---
    return: column
end: lm_p0_visual_column_between

# Original: parser.lm1:427 lm_p0_count_line_breaks
fn: lm_p0_count_line_breaks (const: (@: source char); size_t: start; size_t: limit_index) size_t
    size_t: count
    size_t: i
    size_t: width

    count: 0U
    i: start
    while: i < limit_index
        width: c.lm_p0_line_break_width_at(source, limit_index, i)
        if: width != 0U
            count: count + 1U
            i: i + width
            continue
        i: i + 1U
    ---

    return: count
end: lm_p0_count_line_breaks

# Original: parser.lm1:445 lm_p0_position_in_slice
sub: lm_p0_position_in_slice (const: (@: text char); size_t: byte_count; size_t: index; size_t: base_line; size_t: base_column; @: out_line size_t; @: out_column size_t)
    size_t: i
    size_t: line
    size_t: column
    size_t: width

    line: base_line
    column: base_column
    if: index > byte_count
        index: byte_count

    ---
    i: 0U
    while: i < index
        width: c.lm_p0_line_break_width_at(text, index, i)
        if: width != 0U
            line: line + 1U
            column: 1U
            i: i + width
            continue
        column: column + 1U
        i: i + 1U

    ---
    out_line[0]: line
    out_column[0]: column
end: lm_p0_position_in_slice

# Original: parser.lm1:471 lm_p0_advance_layout_line
sub: lm_p0_advance_layout_line (const: (@: source char); size_t: byte_count; size_t: line_start; size_t: line_end; @: offset size_t; @: line size_t)
    size_t: next_offset
    size_t: line_breaks
    size_t: width

    next_offset: line_end
    line_breaks: lm_p0_count_line_breaks(source, line_start, line_end)
    width: c.lm_p0_line_break_width_at(source, byte_count, next_offset)
    if: width != 0U
        line_breaks: line_breaks + 1U
        next_offset: next_offset + width

    ---
    offset[0]: next_offset
    line[0]: line[0] + line_breaks
end: lm_p0_advance_layout_line

# Original: parser.lm1:487 lm_p0_index_is_line_start
fn: lm_p0_index_is_line_start (const: (@: text char); size_t: index) int
    if: index = 0U
        return: 1
    return: text[index - 1U] = '\n' || text[index - 1U] = '\r'
end: lm_p0_index_is_line_start

# Original: parser.lm1:492 lm_p0_line_rest_is_horizontal_space
fn: lm_p0_line_rest_is_horizontal_space (const: (@: source char); size_t: start; size_t: limit_index) int
    size_t: i

    i: start
    while: i < limit_index
        if: c.lm_p0_is_horizontal_space(source[i]) = 0
            return: 0
        i: i + 1U
    ---

    return: 1
end: lm_p0_line_rest_is_horizontal_space

# Original: parser.lm1:504 lm_p0_find_physical_line_end
fn: lm_p0_find_physical_line_end (const: (@: source char); size_t: byte_count; size_t: start) size_t
    size_t: i

    i: start
    while: i < byte_count && c.lm_p0_is_line_break(source[i]) = 0
        i: i + 1U
    ---

    return: i
end: lm_p0_find_physical_line_end

# Original: parser.lm1:514 lm_p0_text_has_prefix_name
fn: lm_p0_text_has_prefix_name (const: (@: text char); size_t: byte_count; const: (@: name char); int: allow_bare) int
    size_t: name_length

    name_length: c.strlen(name)
    if: byte_count < name_length
        return: 0
    if: c.memcmp(text, name, name_length) != 0
        return: 0
    if: byte_count = name_length
        return: allow_bare
    if: allow_bare != 0 && (c.lm_p0_is_horizontal_space(text[name_length]) != 0 || text[name_length] = '#')
        return: 1
    return: text[name_length] = ':'
end: lm_p0_text_has_prefix_name

# Original: parser.lm1:528 lm_p0_legacy_trailer_role
fn: lm_p0_legacy_trailer_role (const: (@: text char); size_t: byte_count) c.LmP0TrailerRole
    if: lm_p0_text_has_prefix_name(text, byte_count, "end", 0) != 0
        return: c.LM_P0_TRAILER_ROLE_END
    if: lm_p0_text_has_prefix_name(text, byte_count, "return", 1) != 0
        return: c.LM_P0_TRAILER_ROLE_RETURN
    if: lm_p0_text_has_prefix_name(text, byte_count, "until", 0) != 0
        return: c.LM_P0_TRAILER_ROLE_UNTIL
    return: c.LM_P0_TRAILER_ROLE_NONE
end: lm_p0_legacy_trailer_role

# Original: parser.lm1:537 lm_p0_trailer_role_is_tail_cutter
fn: lm_p0_trailer_role_is_tail_cutter (c.LmP0TrailerRole: role) int
    return: role != c.LM_P0_TRAILER_ROLE_NONE
end: lm_p0_trailer_role_is_tail_cutter

# Original: parser.lm1:540 lm_p0_node_head_is
fn: lm_p0_node_head_is (const: (@: p0_node c.LmP0Node); const: (@: name char)) int
    size_t: name_length

    if: p0_node = 0 || p0_node\kind != c.LM_P0_NODE_FRAME
        return: 0

    name_length: c.strlen(name)
    return: p0_node\as\frame\head\length = name_length && c.memcmp(p0_node\as\frame\head\data, name, name_length) = 0

# A `return` trailer line with no value: the word alone, or followed by a space or a comment --
# not `return:` (lm_p0_legacy_trailer_role gives both spellings the RETURN role).
end: lm_p0_node_head_is

# Original: parser.lm1:551 lm_p0_trailer_text_is_bare
fn: lm_p0_trailer_text_is_bare (const: (@: text char); size_t: byte_count) int
    return: ((lm_p0_text_has_prefix_name(text, byte_count, "return", 1) != 0) && (lm_p0_text_has_prefix_name(text, byte_count, "return", 0) = 0))

# The Frames a bare `return` closes besides an fn (author 2026-09-24, Q19.1/Q19.3): a callable
# Structure without a result -- a sub or an fm head, or a named Structure, a colon Frame with no
# inline tail and a vertical body -- and never a Frame whose head is a control word (A1: if,
# else, while, for, until, catch, throws).
end: lm_p0_trailer_text_is_bare

# Original: parser.lm1:558 lm_p0_return_closes_bare
fn: lm_p0_return_closes_bare (const: (@: target c.LmP0Node)) int
    if: ((target = 0) || (target\kind != c.LM_P0_NODE_FRAME))
        return: 0
    if: (lm_p0_node_head_is(target, "sub") || lm_p0_node_head_is(target, "fm"))
        return: 1
    if: (lm_p0_node_head_is(target, "if") || lm_p0_node_head_is(target, "else") || lm_p0_node_head_is(target, "while") || lm_p0_node_head_is(target, "for") || lm_p0_node_head_is(target, "until") || lm_p0_node_head_is(target, "catch") || lm_p0_node_head_is(target, "throws"))
        return: 0
    if: ((target\as\frame\flags & c.LM_P0_FRAME_INLINE_BODY) != 0U)
        return: 0
    return: ((target\as\frame\body != 0) && (target\as\frame\body\field_count > 0U))
end: lm_p0_return_closes_bare

# Original: parser.lm1:569 lm_p0_trailer_role_accepts_target
fn: lm_p0_trailer_role_accepts_target (c.LmP0TrailerRole: role; const: (@: target c.LmP0Node); int: bare) int
    # end: already filled this frame/structure trailer; it is not a trailer target.
    if: target = 0
        return: 0
    if: ((target\kind = c.LM_P0_NODE_FRAME) && (target\as\frame\trailer != 0))
        return: 0
    if: ((target\kind = c.LM_P0_NODE_STRUCTURE) && (target\as\structure\trailer != 0))
        return: 0

    # `return` closes a callable Frame (author 2026-09-24, Q19.1/Q19.3): `return: value` an fn
    # only, a bare `return` also a callable without a result (lm_p0_return_closes_bare).  Every
    # other trailer word closes any Frame.  The rule is written here; the trailer.target lookup it
    # replaced always answered nothing (the P0 registry was stubs returning 0; D-16 removed it).
    if: role = c.LM_P0_TRAILER_ROLE_RETURN
        if: lm_p0_node_head_is(target, "fn")
            return: 1
        if: bare != 0
            return: lm_p0_return_closes_bare(target)
        return: 0
    return: lm_p0_trailer_role_is_tail_cutter(role)
end: lm_p0_trailer_role_accepts_target

# Original: parser.lm1:591 lm_p0_node_structure
fn: lm_p0_node_structure (const: (@: p0_node c.LmP0Node)) const: @: c.LmP0Structure
    if: p0_node = 0 || p0_node\kind != c.LM_P0_NODE_STRUCTURE
        return: 0
    return: (cast: (const: @: c.LmP0Structure) p0_node\as\structure)
end: lm_p0_node_structure

# Original: parser.lm1:598 lm_p0_node_frame
fn: lm_p0_node_frame (const: (@: p0_node c.LmP0Node)) const: @: c.LmP0Frame
    if: p0_node = 0 || p0_node\kind != c.LM_P0_NODE_FRAME
        return: 0
    return: (cast: (const: @: c.LmP0Frame) p0_node\as\frame)
end: lm_p0_node_frame

# Original: parser.lm1:605 lm_p0_node_atom
fn: lm_p0_node_atom (const: (@: p0_node c.LmP0Node)) const: @: c.LmP0Text
    if: p0_node = 0 || (p0_node\kind != c.LM_P0_NODE_ATOM && p0_node\kind != c.LM_P0_NODE_DISABLED)
        return: 0
    return: (cast: (const: @: c.LmP0Text) p0_node\as\atom)
end: lm_p0_node_atom

# Original: parser.lm1:612 lm_p0_structure_trailer
fn: lm_p0_structure_trailer (const: (@: structure c.LmP0Structure)) const: @: c.LmP0Trailer
    if: structure = 0
        return: 0
    return: (cast: (const: @: c.LmP0Trailer) structure\trailer)
end: lm_p0_structure_trailer

# Original: parser.lm1:619 lm_p0_frame_head
fn: lm_p0_frame_head (const: (@: frame c.LmP0Frame)) const: @: c.LmP0Text
    if: frame = 0
        return: 0
    return: (cast: (const: @: c.LmP0Text) frame\head)
end: lm_p0_frame_head

# Original: parser.lm1:626 lm_p0_frame_body
fn: lm_p0_frame_body (const: (@: frame c.LmP0Frame)) const: @: c.LmP0Structure
    if: frame = 0
        return: 0
    return: (cast: (const: @: c.LmP0Structure) frame\body)
end: lm_p0_frame_body

# Original: parser.lm1:633 lm_p0_frame_trailer
fn: lm_p0_frame_trailer (const: (@: frame c.LmP0Frame)) const: @: c.LmP0Trailer
    if: frame = 0
        return: 0
    return: (cast: (const: @: c.LmP0Trailer) frame\trailer)
end: lm_p0_frame_trailer

# Original: parser.lm1:640 lm_p0_trailer_spelling
fn: lm_p0_trailer_spelling (const: (@: trailer c.LmP0Trailer)) const: @: c.LmP0Text
    if: trailer = 0
        return: 0
    return: (cast: (const: @: c.LmP0Text) trailer\spelling)
end: lm_p0_trailer_spelling

# Original: parser.lm1:647 lm_p0_trailer_body
fn: lm_p0_trailer_body (const: (@: trailer c.LmP0Trailer)) const: @: c.LmP0Structure
    if: trailer = 0
        return: 0
    return: (cast: (const: @: c.LmP0Structure) trailer\body)
end: lm_p0_trailer_body

# Original: parser.lm1:653 lm_p0_stream_event_is_tail_cutter
fn: lm_p0_stream_event_is_tail_cutter (const: (@: event c.LmP0StreamEvent)) int
