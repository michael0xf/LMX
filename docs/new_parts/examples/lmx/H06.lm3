Functions:
    int: x
    return: int
    twice:
        return: x * 2
    next:
        return: x + 1

CompositionProbe:
    return: int
    run:
        import: PipeLibrary
        int: a (4 pipe Functions\twice Functions\next)
        int: b (4 pipe Functions\next Functions\twice)
        return: a * 100 + b
