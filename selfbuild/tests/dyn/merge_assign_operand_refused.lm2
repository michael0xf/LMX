# The := slice, Codex's review of 303, item 2: a merge operand written `(zz := int: 5)` is not the typed field the form
# `(int: zz 5)` is -- `:=` declares nothing, so the operand is no definition of a field zz; the translation refuses the
# operand form, located at the operand.
Args:
    int: c 3
    int: a 0
end: Args
fn: f () int
    pack: merge(Args; (zz := int: 5))
    return: pack\c
end: f
int: code 7
if: f() != 3
    code := 81
---
send: exit(exit_code: code; stdout: ""; stderr: "")
return
