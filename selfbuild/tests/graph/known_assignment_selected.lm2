# M6 4b (slice 350): Code run on the passed data Data writes x and y; Data has no y, and ordinary passed data is not
# filled in (CODEX-OPUS-AUTHOR-CODE-DATA-SCOPE-20261110T074510Z-01: var is autofilled) -- the write of y is refused (3).
Code:
    var:
        int: x 1
        int: y 2
    end: var
    x: x + 1
    y: x * 2
end: Code
Data:
    int: x 10
end: Data
call: Code Data
