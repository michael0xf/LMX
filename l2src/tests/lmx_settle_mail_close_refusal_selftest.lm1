predef: "l2src/lmx_settle.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_service.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# A mailbox close can refuse before destroying the mailbox (for example, while a pending imported
# letter's donor arena cannot be released). Settling must make that refusal its first terminal gate:
# the physical child membership, route and arena are the only durable retry/diagnostic handles.

sub: sr_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: sr_check

fn: sr_thread (@: LmxArena arena; size_t: children_field) @: LmxThread
    @: LmxThread t
    @: Lmx graph
    @: LmxPost mail
    @: LmxSchedule slot
    t: (cast: (@: LmxThread) lmx_arena_take(arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD))
    graph: lmx_node_new_owned(arena)
    mail: (cast: (@: LmxPost) lmx_arena_take(arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    slot: (cast: (@: LmxSchedule) lmx_arena_take(arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: t = 0 || graph = 0 || mail = 0 || slot = 0
        return: 0
    ---
    if: lmx_arena_refs_open_owned(arena, graph, children_field + 1U) != 0 || lmx_thread_children_field_new(arena, graph, children_field) = 0
        return: 0
    ---
    if: lmx_post_init(arena, mail) != c.LMX_POST_OK || lmx_schedule_init(slot, arena, (cast: (@: void) t), 8U) != c.LMX_SCHEDULE_OK
        return: 0
    ---
    if: lmx_thread_init(arena, t, graph, mail, slot) != c.LMX_THREAD_OK || lmx_thread_children_bind_graph(t, arena) != c.LMX_THREAD_OK
        return: 0
    ---
return: t

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: parent_arena
    LmxArena: success_arena
    LmxArena: failure_arena
    LmxService: service
    @: LmxThread parent 0
    @: LmxThread success 0
    @: LmxThread failure 0
    @: LmxMsg success_message 0
    @: LmxMsg failure_message 0
    @: LmxPost success_mail 0
    @: LmxPost failure_mail 0
    @: Lmx parent_graph 0
    @: void success_cell 0
    @: void failure_cell 0
    size_t: success_capacity 0U
    size_t: failure_capacity 0U
    int: failures
    if: counts = 0
        return: 2
    ---
    memset((cast: (@: void) (@ parent_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ success_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ failure_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ service)), 0, c.sizeof(c.LmxService))
    if: lmx_arena_open(@ parent_arena) != 0 || lmx_arena_open(@ success_arena) != 0 || lmx_arena_open(@ failure_arena) != 0 || lmx_service_open(@ service) != c.LMX_SERVICE_OK
        free(counts)
        return: 2
    ---

    parent: sr_thread(@ parent_arena, 2U)
    success: sr_thread(@ success_arena, 0U)
    failure: sr_thread(@ failure_arena, 0U)
    success_cell: lmx_arena_take(@ success_arena, c.sizeof(int), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT)
    failure_cell: lmx_arena_take(@ failure_arena, c.sizeof(int), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT)
    if: parent = 0 || success = 0 || failure = 0 || success_cell = 0 || failure_cell = 0
        free(counts)
        return: 2
    ---
    parent_graph: lmx_thread_message(parent)\graph
    success_message: lmx_thread_message(success)
    failure_message: lmx_thread_message(failure)
    success_mail: success\mail
    failure_mail: failure\mail
    lmx_arena_ref_store(parent_graph, 0U, (cast: (@: void) success))
    lmx_arena_ref_store(parent_graph, 1U, (cast: (@: void) failure))
    success\result: lmx_arena_ref_cell(parent_graph, 0U)
    failure\result: lmx_arena_ref_cell(parent_graph, 1U)
    if: lmx_thread_child_add(parent, success, @ parent_arena) != c.LMX_THREAD_OK || lmx_thread_child_add(parent, failure, @ parent_arena) != c.LMX_THREAD_OK
        free(counts)
        return: 2
    ---
    if: lmx_service_register(@ service, success, @ success_arena) != c.LMX_SERVICE_OK || lmx_service_register(@ service, failure, @ failure_arena) != c.LMX_SERVICE_OK
        free(counts)
        return: 2
    ---
    success_message\running: 0
    success_message\success: 1
    success_message\handoff_ready: 1
    failure_message\running: 0
    failure_message\success: 0
    failure_message\handoff_ready: 1

    # A legal, deterministic close refusal: a nonempty inbox with zero capacity is malformed, and
    # lmx_post_close refuses before consuming or freeing anything. Preserve the real capacity so the
    # fixture can restore and clean up after proving the transactional boundary.
    success_capacity: lmx_post_inbox_cap(success_mail)
    success_mail\inbox_count: 1U
    lmx_post_inbox_set_cap(success_mail, 0U)
    sr_check(counts, lmx_settle_one(parent, @ parent_arena, @ service, success, 1U) = c.LMX_SETTLE_INVALID, "successful child settle did not report mail-close refusal")
    sr_check(counts, lmx_thread_child_is(parent, success) != 0, "successful child membership was lost before refused mail close")
    sr_check(counts, lmx_service_find(@ service, (cast: (@: void) success)) = (cast: (@: void) success), "successful child route was lost before refused mail close")
    sr_check(counts, success\mail = success_mail, "successful child mailbox handle was cleared on refused close")
    sr_check(counts, lmx_range_home(@ success_arena, success_cell) = @ success_arena, "successful child arena was released on refused close")
    sr_check(counts, lmx_range_classify(@ parent_arena, success_cell) = c.LMX_KIND_NONE, "successful child arena was attached on refused close")
    sr_check(counts, lmx_arena_ref_value(parent_graph, 0U) = (cast: (@: void) success), "successful child result was cleared on refused close")

    failure_capacity: lmx_post_inbox_cap(failure_mail)
    failure_mail\inbox_count: 1U
    lmx_post_inbox_set_cap(failure_mail, 0U)
    sr_check(counts, lmx_settle_one(parent, @ parent_arena, @ service, failure, 1U) = c.LMX_SETTLE_INVALID, "failed child settle did not report mail-close refusal")
    sr_check(counts, lmx_thread_child_is(parent, failure) != 0, "failed child membership was lost before refused mail close")
    sr_check(counts, lmx_service_find(@ service, (cast: (@: void) failure)) = (cast: (@: void) failure), "failed child route was lost before refused mail close")
    sr_check(counts, failure\mail = failure_mail, "failed child mailbox handle was cleared on refused close")
    sr_check(counts, lmx_range_home(@ failure_arena, failure_cell) = @ failure_arena, "failed child arena ownership was lost on refused close")
    sr_check(counts, lmx_range_classify(@ parent_arena, failure_cell) = c.LMX_KIND_NONE, "failed child arena attached before refused mail close")
    sr_check(counts, lmx_arena_ref_value(parent_graph, 1U) = (cast: (@: void) failure), "failed child result was cleared on refused close")
    sr_check(counts, lmx_service_count(@ service) = 2U, "service membership changed across refused closes")
    sr_check(counts, lmx_thread_child_count(parent) = 2U, "parent membership changed across refused closes")

    # Restore only the deliberate malformed words, then release through the ordinary owner order.
    success_mail\inbox_count: 0U
    lmx_post_inbox_set_cap(success_mail, success_capacity)
    failure_mail\inbox_count: 0U
    lmx_post_inbox_set_cap(failure_mail, failure_capacity)
    lmx_service_unregister(@ service, success)
    lmx_service_unregister(@ service, failure)
    lmx_thread_child_remove(parent, success)
    lmx_thread_child_remove(parent, failure)
    lmx_thread_mail_close(@ success_arena, success)
    lmx_thread_mail_close(@ failure_arena, failure)
    lmx_thread_mail_close(@ parent_arena, parent)
    lmx_arena_release(@ success_arena)
    lmx_arena_release(@ failure_arena)
    lmx_arena_release(@ parent_arena)
    lmx_service_release(@ service)

    failures: counts[1]
    c.printf("lmx_settle_mail_close_refusal checks=%d failures=%d\n", counts[0], failures)
    free(counts)
return: failures
