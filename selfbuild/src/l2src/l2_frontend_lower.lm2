            # result-to-source admission uses the existing D-105 ordinal/LAST
            # table; the composed self projection lets native and walked OWN
            # address the completed result, not the operand's former slots.
            if: mres_code_k_cell[0][msf] > 0
                if: c.snprintf(merge_code_map_name, 64U, "l2_mexec%d", msf) < 0
                    return: (cast: (int) (c.lm_compiler_error(src_cell[0], stmt, "internal: a selected merge body has no address table")))
                if: mres_code_k_cell[0][msf] = n
                    c.strcpy(merge_code_source_name, "l2_mbody")
                else:
                    if: c.snprintf(merge_code_source_name, 64U, "l2_mops[%dU]", mres_code_k_cell[0][msf]) < 0
                        return: (cast: (int) (1))
                ---
                if: c.fprintf(out_cell[0], "%sif: lmx_implements_register_map(l2_program_arena, l2_mresult, %s, %s, %dU, 0) != c.LMX_IMPLEMENTS_YES || lmx_implements_exec_compose_copy(l2_program_arena, %s, l2_program_arena, l2_mresult, %s) != c.LMX_IMPLEMENTS_YES\n", ind, merge_code_source_name, merge_code_map_name, c.lm_compiler_d105_width(mres_code_schema_cell[0][msf]), merge_code_source_name, merge_code_source_name) < 0
                    return: (cast: (int) (1))
                if: (qual & 4) != 0 && c.fprintf(out_cell[0], "%s    lmx_copy_names_finish(@ l2_mqpending, 0)\n", ind) < 0
                    return: (cast: (int) (1))
                if: c.lm_compiler_emit_implicit_throw(mi, "merge", ind) != 0
                    return: (cast: (int) (1))
                if: c.fprintf(out_cell[0], "%sl2_mresult\\native: %s\\native\n", ind, merge_code_source_name) < 0
                    return: (cast: (int) (1))
            ---
            if: (qual & 4) != 0 && lm_compiler_emit_qualify_result(msf, merge_own, ind) != 0
                return: (cast: (int) (1))
            if: lm_compiler_own_store(mi, merge_own, ind, "l2_mresult") != 0
                return: (cast: (int) (1))
