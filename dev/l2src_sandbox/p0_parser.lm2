end: lm_p0_document_mutable_root

# Original: parser.lm1:4508 lm_p0_document_diagnostic
fn: lm_p0_document_diagnostic (const: (@: document c.LmP0Document)) const: @: c.LmP0Diagnostic
    if: (((document = 0) || (document\diagnostic = 0)) || (document\diagnostic\code = 0))
