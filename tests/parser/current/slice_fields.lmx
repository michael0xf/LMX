omitted: values[::2]
negative: values[5:1:-1]
emptyGroups: values[():()]
bound: values[flag ? 1 : 2:6]
grouped: values[(flag ? 1 : 2):6]
stop: values[1:flag ? 5 : 6]
nested: values[a[::2]:6]
signature: values[(a :: T):]
outer: flag ? values[1:3] : values[2:6]
calls: values[f(x):g(y):step(z)]
protected: values[`a::b`:"c:d"]
index: values[-1]
zeroStep: values[::0]
