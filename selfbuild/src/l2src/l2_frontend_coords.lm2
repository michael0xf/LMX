# Ordinary L2 source-coordinate, namespace and schema helpers.
# The121 inherited cells remain in the frontend; local aliases address the same C storage.
predef: "l2src/l2_application.h.lm1"
predef: "l2src/l2_frontend_helpers.h.lm1"
predef: "l2src/l2_frontend_alloc.h.lm1"
predef: "l2src/l2_frontend_values.h.lm1"
predef: "l2src/l2_frontend_views.h.lm1"
predef: "l2src/l2_frontend_context.h.lm1"
predef: "l2src/l2_frontend_types.h.lm1"
include: "<stddef.h>" "<stdio.h>" "<stdlib.h>" "<string.h>" "<limits.h>"

fn: lm_compiler_ns_rank (int: ni) int
    @@: ns_parent_cell int (cast: (@@: int) (@ c.l2_ns_parent))
    @@: ns_eternal_cell int (cast: (@@: int) (@ c.l2_ns_eternal))
    @@: ns_local_cell int (cast: (@@: int) (@ c.l2_ns_local))
    int: i 0
    int: r 0
    while: i < ni
        if: ns_parent_cell[0][i] < 0 && ns_eternal_cell[0][i] < 0 && ns_local_cell[0][i] < 0 && c.lm_compiler_ns_merge_body(i) < 0
            r: r + 1
        i: i + 1
    ---
    return: (cast: (int) (r))
end: lm_compiler_ns_rank

fn: lm_compiler_ns_top_count () int
    @: ns_n_cell int (cast: (@: int) (@ c.l2_ns_n))
    @@: ns_parent_cell int (cast: (@@: int) (@ c.l2_ns_parent))
    @@: ns_eternal_cell int (cast: (@@: int) (@ c.l2_ns_eternal))
    @@: ns_local_cell int (cast: (@@: int) (@ c.l2_ns_local))
    int: i 0
    int: r 0
    while: i < ns_n_cell[0]
        if: ns_parent_cell[0][i] < 0 && ns_eternal_cell[0][i] < 0 && ns_local_cell[0][i] < 0 && c.lm_compiler_ns_merge_body(i) < 0
            r: r + 1
        i: i + 1
    ---
    return: (cast: (int) (r))
end: lm_compiler_ns_top_count

fn: lm_compiler_ns_field_in_parent (int: ni) int
    @@: ns_parent_cell int (cast: (@@: int) (@ c.l2_ns_parent))
    @: nsf_n_cell int (cast: (@: int) (@ c.l2_nsf_n))
    @@: nsf_owner_cell int (cast: (@@: int) (@ c.l2_nsf_owner))
    @@: nsf_kind_cell int (cast: (@@: int) (@ c.l2_nsf_kind))
    @@: nsf_ref_cell int (cast: (@@: int) (@ c.l2_nsf_ref))
    int: par
    int: k 0
    int: slotix 0
    par: ns_parent_cell[0][ni]
    if: par < 0
        return: (cast: (int) (0 - 1))
    # Fields of one Structure are not contiguous: a nested body pushes its own
    # fields in between. Walk the whole table and count only this owner.
    slotix: 0
    while: k < nsf_n_cell[0]
        if: nsf_owner_cell[0][k] = par
            if: nsf_kind_cell[0][k] = 2 && nsf_ref_cell[0][k] = ni
                return: (cast: (int) (lm_compiler_nsf_slot(k)))
            ---
            slotix: slotix + 1
        ---
        k: k + 1
    ---
    return: (cast: (int) (0 - 1))
end: lm_compiler_ns_field_in_parent

fn: lm_compiler_own_off (int: mi; int: oi) size_t
    @: own_cap_cell int (cast: (@: int) (@ c.l2_own_cap))
    @: m_cap_cell int (cast: (@: int) (@ c.l2_m_cap))
    size_t: base
    size_t: cap
    size_t: idx
    if: mi < 0 || oi < 0 || own_cap_cell[0] <= 0 || m_cap_cell[0] <= 0 || mi >= m_cap_cell[0] || oi >= own_cap_cell[0]
        return: (cast: (size_t) ((cast: (size_t) -1)))
    cap: (cast: (size_t) own_cap_cell[0])
    if: c.lm_compiler_mul_ok((cast: (size_t) mi), cap) = 0
        return: (cast: (size_t) ((cast: (size_t) -1)))
    base: (cast: (size_t) mi) * cap
    idx: (cast: (size_t) oi)
    if: base + idx < base
        return: (cast: (size_t) ((cast: (size_t) -1)))
    return: (cast: (size_t) (base + idx))
end: lm_compiler_own_off

fn: lm_compiler_rb_find (const: (@: stmt c.LmP0Node)) @: c.LmP0Text
    @: rb_n_cell int (cast: (@: int) (@ c.l2_rb_n))
    @@@: rb_at_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_rb_at))
    @@@: rb_model_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_rb_model))
    int: i 0
    if: stmt = 0
        return: (cast: (@: c.LmP0Text) (0))
    while: i < rb_n_cell[0]
        if: rb_at_cell[0][i] = stmt
            return: (cast: (@: c.LmP0Text) (rb_model_cell[0][i]))
        i: i + 1
    ---
    return: (cast: (@: c.LmP0Text) (0))
end: lm_compiler_rb_find

