predef: "l3_interp/l3_thread.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_call.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_manager.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_gc.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_clock.lm1"
predef: "l2src/lmx_scratch.lm1"
predef: "l2src/lmx_walk.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# Interpreted turn: l3_thread_dispatch -> lmx_interp_apply -> lmx_walk_run.
# Native entry unused. Graph/Message/method not copied.

sub: fail (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: fail

int: native_hits 0

fn: native_noop (@: Lmx node) int
    native_hits: native_hits + 1
return: 0

# k.4 (c.3): a plain occurrence, slot 0 reserved/unused, same convention as the L2
# kernel selftests (dispatch is \native, 0 = walked).
fn: mk_dummy (@: LmxArena a) @: Lmx
    @: Lmx m
    m: lmx_node_new_owned(a)
    if: m = 0 || lmx_arena_refs_open_owned(a, m, 1U) != 0
        return: 0
return: m

fn: mk_walk_void (@: LmxArena a; @: Lmx roles) @: Lmx
    @: Lmx unit
    @: Lmx m
    @: Lmx ret
    unit: lmx_node_new_owned(a)
    if: unit = 0 || lmx_arena_refs_open_owned(a, unit, 1U) != 0
        return: 0
    m: lmx_walk_plain(a, unit, 2U)
    if: m = 0 || roles = 0
        return: 0
    if: lmx_arena_ref_store(unit, 0U, (cast: (@: void) m)) != 0
        return: 0
    ret: lmx_walk_frame(a, roles, m, c.LMX_WALK_OP_RET, 1U)
    if: ret = 0 || lmx_arena_ref_store(m, 1U, (cast: (@: void) ret)) != 0
        return: 0
return: m

# An entry whose body is `return: <value>` (RET over LIT), as mk_walk_void builds `return`.
fn: mk_walk_int (@: LmxArena a; @: Lmx roles; int: value) @: Lmx
    @: Lmx m
    @: Lmx ret
    @: Lmx lit
    m: mk_walk_void(a, roles)
    if: m = 0
        return: 0
    ret: lmx_walk_frame(a, roles, m, c.LMX_WALK_OP_RET, 2U)
    if: ret = 0 || lmx_arena_ref_store(m, 1U, (cast: (@: void) ret)) != 0
        return: 0
    lit: lmx_walk_frame(a, roles, ret, c.LMX_WALK_OP_LIT, 2U)
    if: lit = 0 || lmx_arena_ref_store(ret, 1U, (cast: (@: void) lit)) != 0 || lmx_walk_store_int(a, lit, 1U, value) != c.LMX_WALK_OK
        return: 0
return: m

fn: mk_thread (@: LmxArena arena; @: Lmx graph; @@: LmxThread out_t) int
    @: LmxThread t
    @: LmxPost mail
    @: LmxSchedule sched
    \out_t: 0
    t: (cast: (@: LmxThread) lmx_arena_take(arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD))
    mail: (cast: (@: LmxPost) lmx_arena_take(arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    sched: (cast: (@: LmxSchedule) lmx_arena_take(arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: t = 0 || mail = 0 || sched = 0
        return: 0
    if: lmx_post_init(arena, mail) != c.LMX_POST_OK || lmx_schedule_init(sched, arena, (cast: (@: void) t), 1000U) != c.LMX_SCHEDULE_OK
        return: 0
    if: lmx_thread_init(arena, t, graph, mail, sched) != c.LMX_THREAD_OK
        return: 0
    \out_t: t
return: 1

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: arena
    LmxArena: unbound_arena
    LmxArena: other_arena
    @: LmxArena a 0
    @: Lmx dummy 0
    @: Lmx graph 0
    @: LmxThread t 0
    @: LmxThread unbound_t 0
    @: LmxThread other_t 0
    @: LmxThread forged_t 0
    @: LmxMsg plain_message 0
    @: LmxMsg msg 0
    @: Lmx roles 0
    @: Lmx profile 0
    @: LmxPool profile_pool 0
    @: LmxPool roles_pool 0
    @: LmxPool refs_pool 0
    @: void ret_record 0
    int: result 0
    if: counts = 0
        return: 2
    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ unbound_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ other_arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0 || lmx_arena_open(@ unbound_arena) != 0 || lmx_arena_open(@ other_arena) != 0
        fputs("l3_thread_bind: arena\n", l1_stdout())
        free(counts)
        return: 2
    ---
    a: @ arena
    dummy: mk_dummy(a)
    if: dummy = 0 || mk_thread(a, dummy, @ t) = 0
        free(counts)
        return: 2
    ---
    if: mk_thread(@ unbound_arena, mk_dummy(@ unbound_arena), @ unbound_t) = 0 || mk_thread(@ other_arena, mk_dummy(@ other_arena), @ other_t) = 0
        free(counts)
        return: 2
    ---
    # A deliberately wide standalone Message range gives the negative test safe
    # backing bytes for a poisoned would-be tail.  Its exact type remains MSG_RECORD,
    # never THREAD.  An implementation that reads `slot` before proving that type
    # would accept this forged value; the exact-range gate must refuse it first.
    plain_message: (cast: (@: LmxMsg) lmx_arena_take(@ unbound_arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
    if: plain_message = 0
        free(counts)
        return: 2
    ---
    forged_t: (cast: (@: LmxThread) plain_message)
    forged_t\slot: unbound_t\slot
    # Without a bound walker, a host entry still runs (single turn shape, no mode).
    fail(counts, lmx_thread_turn(t, native_noop, 1U) = c.LMX_THREAD_OK, "host entry runs when no walker is bound")
    fail(counts, native_hits = 1, "native handler ran once before bind")
    fail(counts, lmx_thread_turn(t, 0, 2U) = c.LMX_THREAD_OK, "call0 with no walker and no entry is a quiet empty body")
    fail(counts, l3_thread_bind(a, 0) = c.LMX_THREAD_INVALID && l3_thread_bind(0, t) = c.LMX_THREAD_INVALID, "null bind input is refused before assignment")
    fail(counts, l3_thread_bind(@ unbound_arena, forged_t) = c.LMX_THREAD_INVALID && l3_thread_roles(forged_t) = 0, "a standalone Message cast upward cannot bind as a Thread")
    fail(counts, l3_thread_roles(unbound_t) = 0, "before bind no other Thread owns tables")
    fail(counts, l3_thread_bind(a, t) = c.LMX_THREAD_OK, "bind walk dispatch")
    roles: l3_thread_roles(t)
    profile: lmx_range_profile(a, (cast: (@: void) roles))
    profile_pool: lmx_range_pool(a, (cast: (@: void) profile))
    roles_pool: lmx_range_pool(a, (cast: (@: void) roles))
    refs_pool: lmx_range_pool(a, (cast: (@: void) lmx_arena_ref_cell(roles, 0U)))
    fail(counts, roles != 0 && profile != 0, "standard walk roles have one physical profile")
    fail(counts, lmx_range_home(a, (cast: (@: void) roles)) = a && roles_pool != 0 && lmx_pool_is_sealed(roles_pool) != 0, "role table is a sealed owner-arena range")
    fail(counts, lmx_range_home(a, (cast: (@: void) profile)) = a && profile_pool != 0 && lmx_pool_is_sealed(profile_pool) != 0, "profile is an ordinary sealed owner-arena graph value")
    fail(counts, refs_pool != 0 && lmx_range_profile(a, (cast: (@: void) lmx_arena_ref_cell(roles, 0U))) = profile && lmx_pool_is_sealed(refs_pool) != 0, "role reference storage has the same sealed profile")
    ret_record: lmx_arena_ref_value(roles, (cast: (size_t) c.LMX_WALK_OP_RET))
    fail(counts, ret_record != 0 && lmx_range_home(a, ret_record) = a && lmx_range_profile(a, ret_record) = profile && lmx_pool_is_sealed(lmx_range_pool(a, ret_record)) != 0, "role record is sealed in the exact physical profile")
    fail(counts, lmx_range_import_profile(@ other_arena, a, profile) = 0 && lmx_range_home(@ other_arena, ret_record) = a && lmx_range_pool(@ other_arena, ret_record) = 0, "another arena imports an owner-preserving exact-profile view")
    # Sharing physical records does not transfer the singleton dispatch owner.
    fail(counts, l3_thread_bind(@ other_arena, other_t) = c.LMX_THREAD_INVALID, "a second Thread is refused")
    fail(counts, l3_thread_roles(other_t) = 0 && l3_thread_roles(t) = roles, "the refused bind left the bound thread and its tables alone")
    fail(counts, l3_thread_bind(@ unbound_arena, unbound_t) = c.LMX_THREAD_INVALID && l3_thread_roles(t) = roles, "another refused bind unbinds nothing")
    # The sealed tables are opened once for this binding.
    fail(counts, l3_thread_bind(a, t) = c.LMX_THREAD_OK && l3_thread_roles(t) = roles, "a repeated bind hands out the same tables")
    fail(counts, lmx_arena_ref_value(l3_thread_roles(t), (cast: (size_t) c.LMX_WALK_OP_RET)) = ret_record, "and the same RET record")
    graph: mk_walk_void(a, l3_thread_roles(t))
    msg: lmx_thread_message(t)
    fail(counts, graph != 0 && msg != 0, "walk body")
    msg\graph: graph
    fail(counts, msg\graph = graph, "graph pointer installed, not copied")
    fail(counts, lmx_thread_turn(t, 0, 3U) = c.LMX_THREAD_OK, "interpreted turn via lmx_walk")
    fail(counts, native_hits = 1, "native handler not used on interpreted turn")
    fail(counts, lmx_thread_turn(t, 0, 4U) = c.LMX_THREAD_OK, "second interpreted turn")
    fail(counts, native_hits = 1, "still no native fallback")
    # Two turn boundaries have collected the arena. Sealed owner ranges survive unchanged.
    fail(counts, l3_thread_roles(t) = roles, "two turns later the table is the same table")
    fail(counts, lmx_range_classify(a, (cast: (@: void) roles)) = c.LMX_KIND_STRUCT, "and still a Structure by the arena's ranges")
    fail(counts, lmx_arena_ref_value(roles, (cast: (size_t) c.LMX_WALK_OP_RET)) = ret_record && lmx_range_classify(a, ret_record) = c.LMX_DOMAIN_KIND_OP, "and RET is the same live OP record")
    # E1: the int the interpreted entry returns is the host's exit value, and it is a VALUE --
    # a nonzero one does not fail the turn.  The void entry above returned none.
    result: 99
    fail(counts, l3_thread_result(t, @ result) = 0 && result = 99, "a void entry leaves no exit value")
    graph: mk_walk_int(a, l3_thread_roles(t), 7)
    fail(counts, graph != 0, "entry returning 7")
    msg\graph: graph
    fail(counts, lmx_thread_turn(t, 0, 5U) = c.LMX_THREAD_OK, "an entry returning 7 is an ordinary successful turn")
    fail(counts, l3_thread_result(t, @ result) = 1 && result = 7, "the entry's 7 is observed as the host's exit value")
    graph: mk_walk_int(a, l3_thread_roles(t), 0)
    fail(counts, graph != 0, "entry returning 0")
    msg\graph: graph
    fail(counts, lmx_thread_turn(t, 0, 6U) = c.LMX_THREAD_OK, "an entry returning 0 is an ordinary successful turn")
    fail(counts, l3_thread_result(t, @ result) = 1 && result = 0, "the entry's 0 is observed as 0")
    fail(counts, l3_thread_result(other_t, @ result) = 0, "an unbound Thread has no exit value")

    if: counts[1] != 0
        c.printf("%d failed of %d\n", counts[1], counts[0])
        free(counts)
        return: 1
    ---
    c.printf("l3_thread_bind: %d checks\n", counts[0])
    free(counts)
return: 0
