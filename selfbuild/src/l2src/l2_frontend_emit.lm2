                return: (cast: (int) (1))
            return: (cast: (int) (c.lm_compiler_path_seg_refusal_at(path, (cast: (const: @: c.LmP0Node) (c.lm_compiler_path_fail_node(selected, (cast: (@: c.LmP0Field) (span\first))))), (cast: (int) (selected\fail_why)))))
        if: selected\n > 0 && c.lm_compiler_path_rec_leaf_ft(selected) < 0 && c.lm_compiler_path_callee_rec(selected) < 0
            return: (cast: (int) (c.lm_compiler_error(path, (cast: (const: @: c.LmP0Node) (c.lm_compiler_path_leaf_node(selected, (cast: (@: c.LmP0Field) (span\first))))), "a field path must end at a primitive field")))
