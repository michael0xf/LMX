# A bare `Counter` at the root is only a reference. `call: Counter` executes its
# body. Construction ran none of the body: Counter\n reads 0 before the first
# call, 1 after it and 1 after the second because each call starts from the
# published field's declared state. Entry 7.
Counter:
    size_t: n 0U
    n: n + 1U
return
size_t: before 9U
before: Counter\n
Counter
call: Counter
size_t: once 9U
once: Counter\n
call: Counter
size_t: twice 9U
twice: Counter\n
int: ok 0
if: before = 0U && once = 1U && twice = 1U
    ok: 7
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
