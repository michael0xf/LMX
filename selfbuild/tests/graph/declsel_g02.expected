---
    Observed:
        int: seen 0
    end: Observed
---
sub: main ((S ((int p 1)) ((int q 2))))
    @: shared (node [] 0)
    fn: g (@: a) int
        return: (length a)
    end: g
    fn: g (@: a; (required (@ b))) int
        return: 100
    end: g
    :=: ((shared \ Observed) \ seen) (g S)
end: main
main:
