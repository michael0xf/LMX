# DRAFT. Supplied release lock contains actual artifact URLs/hashes and ABI.
# Nothing here invents a release version, target availability or download digest.
PythonPrivateExample:
    @PythonGateContext: context
    @PythonInstallPlan: plan
    required: context plan
    return: i64
    run:
        throws: copy(PythonBridgeThrows)
        private: @PythonInstallation: installed installPython(context := context; plan := plan)
        private: @PythonOpenRequest: request (copy(PythonOpenRequest))
        request\mode := 1
        request\installation := installed
        private: @PythonSession: session openPython(context := context; request := request)
        finally:
            closePython(context := context; session := session)
        return: PythonMathDemo\run(context; session)

