# The interpreter of the clean graph (docs/kernel-implementation.ru.md §6; slice 309, the vertical slice of §11 item 0):
# it walks the statements of a root in field order and recognizes everything by addresses -- a word by the canonical
# address of its spelling (the words of the language are the state's, §6.2), a place by the region of the address a slot
# holds (§2.2), a name by the address -> name table of the arena (§5.1). Written names resolve against this traversal's
# activation and current lexical slots (§3.5, §5.2); no binding survives the traversal. Each expression operation is an
# ordinary Lmx of operand/operator/operand, or prefix/operand, nested by construction (§3.3). This consumer performs no
# precedence parsing and keeps no prepared expression representation. A write of a place is the
# kernel's one write (lmx_graph_assign_int): every assignment writes into the same cell, through the address-typed
# internal indirection when present. That indirection does not make the language place a reference.
#
# Statements of this slice: `name: expression` (a write of the int place named name) and `int: name expression` (a
# declaration with a computed initializer: the published value replaces the statement in its slot, §3.4).
# An omitted initializer promises no initial value; the kernel does not maintain a changing initialized state.
#
# A machine module (L2 section 20); the build writes its header, lmx_graph_run.h.lm1, from the exports named in
# bld_kernel_l2 (tools/build.lm2).
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_graph.h.lm1"
predef: "l2src/lmx_call.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdlib.h>"
include: "<stdio.h>"
include: "<string.h>"

# The working cache belongs to one active traversal. Its rows refer to real own cells; numbers and dirty marks
# disappear on return. No cache or binding is stored in the Lmx graph.
fn: lmx_graph_work_row (@: frame c.LmxGraphFrame; @: name char) @: c.LmxGraphWork
    size_t: i 0U
    @: rows c.LmxGraphWork 0
    @: row c.LmxGraphWork 0
    if: frame = 0 || name = 0
        return: 0
    rows: frame\rows
    while: i < frame\count
        row: rows + i
        if: row\name = name
            return: row
        i: i + 1U
    ---
    return: 0
end: lmx_graph_work_row

fn: lmx_graph_work_load (@: g c.LmxGraph; @: row c.LmxGraphWork) int
    if: row = 0
        return: 3
    if: row\slot = (cast: (size_t) -1)
        return: 0
    if: (row\loaded & 1) = 0
        if: c.lmx_graph_value_int(g, row\cell, @ row\number) != 0
            return: 4
        row\loaded: row\loaded | 1
    return: 0
end: lmx_graph_work_load

# Capture a directly consumed free input at entry. An int gets its own argument cell; a Structure/reference keeps
# its language reference value. The row lives only in this activation and does not become a field of var.
fn: lmx_graph_work_capture (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: name char) int
    @: args c.Lmx 0
    @: value void 0
    @: rows c.LmxGraphWork 0
    @: row c.LmxGraphWork 0
    size_t: capacity 0U
    int: kind 0
    int: number 0
    int: status 0
    size_t: slot 0U
    if: c.lmx_graph_method(g, (cast: (@: c.Lmx) frame\code)) != 0
        args: (cast: (@: c.Lmx) c.lmx_graph_get(frame\code, 1U))
    if: name = 0 || c.lmx_graph_named(g, args, name) < c.lmx_graph_count(args)
        return: 0
    row: lmx_graph_work_row(frame, name)
    if: row != 0
        if: row\cell = 0 && frame\data != c.lmx_graph_method_var(frame\code)
            return: 3
        return: 0
    # An ordinary code/data call admits only directly used data fields, independent of their physical order.
    if: args = 0
        slot: c.lmx_graph_named(g, frame\data, name)
        if: slot < c.lmx_graph_count(frame\data)
            return: lmx_graph_work_require(g, frame, name)
        ---
    ---
    value: lmx_graph_resolve(g, (cast: (@: c.Lmx) frame\code), name)
    if: value = 0
        return: 3
    kind: c.lmx_graph_kind(g, value)
    if: kind = 1 || kind = 3
        status: lmx_graph_named_int(g, (cast: (@: c.Lmx) frame\code), name, @ number)
        if: status != 0
            return: status
        value: c.lmx_graph_int(g, number)
        if: value = 0
            return: 4
        ---
    ---
    if: frame\count = frame\capacity
        capacity: (cast: (size_t) frame\capacity) * 2U + 8U
        rows: (cast: (@: c.LmxGraphWork) c.realloc((cast: (@: void) frame\rows), capacity * c.sizeof(c.LmxGraphWork)))
        if: rows = 0
            return: 4
        frame\rows: rows
        frame\capacity: capacity
    ---
    rows: frame\rows
    row: rows + (cast: (size_t) frame\count)
    c.memset((cast: (@: void) row), 0, c.sizeof(c.LmxGraphWork))
    row\name: name
    row\cell: value
    row\slot: (cast: (size_t) -1)
    frame\count: frame\count + 1U
    return: 0
end: lmx_graph_work_capture

# Bind a required int place to its actual data slot, by canonical name. No data is allocated or extended.
# Duplicate bare names are inadmissible. This map belongs only to the current activation.
fn: lmx_graph_work_require (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: name char) int
    @: rows c.LmxGraphWork frame\rows
    @: row c.LmxGraphWork lmx_graph_work_row(frame, name)
    size_t: slot c.lmx_graph_named(g, frame\data, name)
    size_t: i slot + 1U
    size_t: capacity 0U
    @: cell void 0
    if: name = 0
        return: 3
    if: row != 0
        if: row\slot = (cast: (size_t) -1)
            return: 3
        if: row\cell != 0 || frame\data = c.lmx_graph_method_var(frame\code)
            return: 0
        return: 3
    if: slot >= c.lmx_graph_count(frame\data)
        return: 3
    while: i < c.lmx_graph_count(frame\data)
        if: c.lmx_graph_slot_name(g, frame\data, i) = name
            return: 3
        i: i + 1U
    ---
    cell: c.lmx_graph_place_cell(g, frame\data, slot)
    if: c.lmx_graph_kind(g, cell) != 1
        return: 4
    if: frame\count = frame\capacity
        capacity: (cast: (size_t) frame\capacity) * 2U + 8U
        rows: (cast: (@: c.LmxGraphWork) c.realloc((cast: (@: void) rows), capacity * c.sizeof(c.LmxGraphWork)))
        if: rows = 0
            return: 4
        frame\rows: rows
        frame\capacity: capacity
    ---
    row: rows + (cast: (size_t) frame\count)
    c.memset((cast: (@: void) row), 0, c.sizeof(c.LmxGraphWork))
    row\name: name
    row\slot: slot
    row\cell: cell
    frame\count: frame\count + 1U
    return: 0
end: lmx_graph_work_require

# One body traversal captures free inputs and records needed own loads. After var, loading iterates only rows,
# never the body again. Nested methods are not scanned, and a selector is not an input; no transitive interface.
fn: lmx_graph_work_scan (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: body c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @@: queue c.Lmx 0
    size_t: count 0U
    size_t: cap 0U
    size_t: at 0U
    size_t: i 0U
    size_t: n 0U
    @: current c.Lmx 0
    @: raw void 0
    @: word char 0
    @: op char 0
    @: row c.LmxGraphWork 0
    int: status c.lmx_graph_scan_add(@ queue, @ count, @ cap, body)
    while: at < count && status = 0
        current: queue[at]
        at: at + 1U
        if: c.lmx_graph_method(g, current) != 0 || (current != body && c.lmx_graph_name_of(g, (cast: (@: void) current)) != 0)
            continue
        n: c.lmx_graph_count(current)
        word: c.lmx_graph_word_text(g, c.lmx_graph_get(current, 0U))
        op: c.lmx_graph_word_text(g, c.lmx_graph_get(current, 1U))
        if: n = 2U && word = state\w_at
            raw: c.lmx_graph_get(current, 1U)
            while: c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_count((cast: (@: c.Lmx) raw)) = 1U
                raw: c.lmx_graph_get((cast: (@: c.Lmx) raw), 0U)
            word: c.lmx_graph_word_text(g, raw)
            if: word != 0
                status: lmx_graph_work_capture(g, frame, word)
                continue
            ---
        ---
        i: 0U
        if: word = state\w_int
            word: c.lmx_graph_word_text(g, c.lmx_graph_get(current, 1U))
            if: c.lmx_graph_method(g, (cast: (@: c.Lmx) frame\code)) = 0
                status: lmx_graph_work_require(g, frame, word)
            else:
                status: lmx_graph_work_capture(g, frame, word)
            ---
            i: 2U
        while: i < n && status = 0
            if: n = 3U && op = state\w_deref && i = 2U
                i: i + 1U
                continue
            raw: c.lmx_graph_get(current, i)
            if: current = body && c.lmx_graph_method(g, (cast: (@: c.Lmx) frame\code)) = 0 && (c.lmx_graph_kind(g, raw) = 1 || c.lmx_graph_kind(g, raw) = 3)
                word: c.lmx_graph_slot_name(g, current, i)
                if: word != 0
                    status: lmx_graph_work_require(g, frame, word)
                    i: i + 1U
                    continue
                ---
            ---
            if: c.lmx_graph_kind(g, raw) = 4
                status: c.lmx_graph_scan_add(@ queue, @ count, @ cap, (cast: (@: c.Lmx) raw))
            else:
                word: c.lmx_graph_word_text(g, raw)
                if: word != 0 && word != state\w_call && word != state\w_return && word != state\w_int && word != state\w_at && word != state\w_plus && word != state\w_minus && word != state\w_star && word != state\w_slash && word != state\w_percent && word != state\w_deref && word != state\w_eq && word != state\w_ne && word != state\w_lt && word != state\w_le && word != state\w_gt && word != state\w_ge && word != state\w_and && word != state\w_or && word != state\w_not && word != state\w_if && word != state\w_else && word != state\w_while && word != state\w_for && word != state\w_break && word != state\w_continue && word != state\w_redo && word != state\w_until && word != state\w_finally && word != state\w_assign
                    status: lmx_graph_work_capture(g, frame, word)
                    if: status = 0
                        row: lmx_graph_work_row(frame, word)
                        if: row != 0 && row\slot != (cast: (size_t) -1) && (i != 1U || c.lmx_graph_word_text(g, c.lmx_graph_get(current, 0U)) != state\w_assign) && (i != 0U || n = 1U || op = state\w_plus || op = state\w_minus || op = state\w_star || op = state\w_slash || op = state\w_percent || op = state\w_deref || op = state\w_eq || op = state\w_ne || op = state\w_lt || op = state\w_le || op = state\w_gt || op = state\w_ge || op = state\w_and || op = state\w_or)
                            row\loaded: row\loaded | 2
                        ---
                    ---
                ---
            ---
            i: i + 1U
        ---
    ---
    c.free((cast: (@: void) queue))
    return: status
end: lmx_graph_work_scan

fn: lmx_graph_work_flush (@: g c.LmxGraph) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: frame c.LmxGraphFrame 0
    @: rows c.LmxGraphWork 0
    @: row c.LmxGraphWork 0
    size_t: i 0U
    if: active = 0 || active\frame = 0
        return: 0
    frame: (cast: (@: c.LmxGraphFrame) active\frame)
    rows: frame\rows
    while: i < frame\count
        row: rows + i
        if: row\dirty != 0 && row\slot != (cast: (size_t) -1)
            if: c.lmx_graph_assign_int(g, frame\code, frame\data, row\slot, row\number) != 0
                return: 4
            row\dirty: 0
        ---
        i: i + 1U
    ---
    return: 0
end: lmx_graph_work_flush

fn: lmx_graph_work_finish (@: g c.LmxGraph; @: frame c.LmxGraphFrame; int: status) int
    int: published lmx_graph_work_flush(g)
    if: frame\activation != 0
        frame\activation\frame: frame\prior
    c.free((cast: (@: void) frame\rows))
    frame\rows: 0
    frame\count: 0U
    if: published != 0
        return: published
    return: status
end: lmx_graph_work_finish

# Open either a method's own var or an explicit code/data pair. The same rows cache and publish both.
fn: lmx_graph_work_open_data (@: g c.LmxGraph; @: code c.Lmx; @: data c.Lmx; @: frame c.LmxGraphFrame) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: model c.Lmx 0
    @: body c.Lmx code
    @: declaration c.Lmx 0
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: rows c.LmxGraphWork 0
    @: row c.LmxGraphWork 0
    size_t: i 0U
    size_t: j 0U
    size_t: slot 0U
    int: status 0
    if: frame = 0 || active = 0 || active\code != code
        return: 5
    if: c.lmx_graph_method(g, code) != 0
        model: (cast: (@: c.Lmx) c.lmx_graph_method_var(code))
        body: (cast: (@: c.Lmx) c.lmx_graph_method_body(code))
    else:
        model: (cast: (@: c.Lmx) c.lmx_graph_field(g, (cast: (@: void) code), state\w_var))
    ---
    c.memset((cast: (@: void) frame), 0, c.sizeof(c.LmxGraphFrame))
    frame\code: code
    frame\data: data
    frame\count: c.lmx_graph_count(model)
    frame\capacity: frame\count + 8U
    frame\rows: (cast: (@: c.LmxGraphWork) c.calloc(frame\capacity, c.sizeof(c.LmxGraphWork)))
    if: frame\rows = 0
        return: 4
    frame\activation: active
    frame\prior: active\frame
    active\frame: frame
    rows: frame\rows
    while: i < frame\count && status = 0
        row: rows + i
        row\name: c.lmx_graph_slot_name(g, model, i)
        if: row\name = 0 && c.lmx_graph_kind(g, c.lmx_graph_get(model, i)) = 4
            declaration: (cast: (@: c.Lmx) c.lmx_graph_get(model, i))
            if: c.lmx_graph_word_text(g, c.lmx_graph_get(declaration, 0U)) = state\w_int
                row\name: c.lmx_graph_word_text(g, c.lmx_graph_get(declaration, 1U))
            ---
        ---
        slot: i
        if: data != model
            slot: c.lmx_graph_named(g, data, row\name)
            j: slot + 1U
            while: j < c.lmx_graph_count(data)
                if: c.lmx_graph_slot_name(g, data, j) = row\name
                    status: 3
                j: j + 1U
            ---
        ---
        row\slot: slot
        row\cell: c.lmx_graph_place_cell(g, data, slot)
        if: row\name = 0
            status: 5
        i: i + 1U
    ---
    if: status = 0
        status: lmx_graph_work_scan(g, frame, body)
    # Only the actual method var executes its retained initializers; arbitrary data is never filled by call.
    if: status = 0 && model != 0 && data = model && c.lmx_graph_method(g, code) != 0
        status: lmx_graph_call(g, data)
    rows: frame\rows
    i: 0U
    while: i < frame\count && status = 0
        row: rows + i
        if: row\slot != (cast: (size_t) -1)
            row\cell: c.lmx_graph_place_cell(g, data, row\slot)
            row\loaded: row\loaded & 2
            if: row\loaded != 0
                status: lmx_graph_work_load(g, row)
            ---
        ---
        i: i + 1U
    ---
    if: status != 0
        return: lmx_graph_work_finish(g, frame, status)
    return: 0
end: lmx_graph_work_open_data

fn: lmx_graph_work_open (@: g c.LmxGraph; @: code c.Lmx; @: frame c.LmxGraphFrame) int
    return: lmx_graph_work_open_data(g, code, (cast: (@: c.Lmx) c.lmx_graph_method_var(code)), frame)
end: lmx_graph_work_open

# A bare int name reads the current working value before caller bindings and lexical graph data. Explicit paths
# still read published cells. Argument operands snapshot this value before the caller publishes at the call boundary.
fn: lmx_graph_named_int (@: g c.LmxGraph; @: scope c.Lmx; @: name char; @: out int) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: args c.Lmx 0
    @: row c.LmxGraphWork 0
    size_t: slot 0U
    int: status 0
    while: active != 0
        if: active\frame != 0 || c.lmx_graph_method(g, active\code) != 0
            if: active\frame != 0
                row: lmx_graph_work_row((cast: (@: c.LmxGraphFrame) active\frame), name)
                if: row != 0
                    if: row\slot = (cast: (size_t) -1)
                        return: c.lmx_graph_value_int(g, row\cell, out)
                    status: lmx_graph_work_load(g, row)
                    if: status = 0
                        out[0]: row\number
                    return: status
                ---
            ---
            if: c.lmx_graph_method(g, active\code) != 0
                args: (cast: (@: c.Lmx) c.lmx_graph_get(active\code, 1U))
                slot: c.lmx_graph_named(g, args, name)
                if: slot < active\width && active\refs != 0
                    return: c.lmx_graph_value_int(g, active\refs[slot], out)
                ---
            ---
        ---
        active: active\parent
    ---
    return: c.lmx_graph_value_int(g, lmx_graph_resolve(g, scope, name), out)
end: lmx_graph_named_int

fn: lmx_graph_operand_name (@: g c.LmxGraph; @: scope c.Lmx; @: name char) @: void
    @: value void lmx_graph_resolve(g, scope, name)
    int: kind c.lmx_graph_kind(g, value)
    int: number 0
    if: kind = 1 || kind = 3
        if: lmx_graph_named_int(g, scope, name, @ number) != 0
            return: 0
        return: c.lmx_graph_int(g, number)
    return: value
end: lmx_graph_operand_name

# A typed declaration without a candidate verifies its already allocated local place; it reads no value and
# resets nothing. Own fields were collected by construction, formals were admitted by the call.
fn: lmx_graph_local_int (@: g c.LmxGraph; @: code c.Lmx; @: name char) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: row c.LmxGraphWork 0
    @: args c.Lmx 0
    size_t: slot 0U
    if: active = 0 || active\code != code
        return: 5
    if: active\frame != 0
        row: lmx_graph_work_row((cast: (@: c.LmxGraphFrame) active\frame), name)
        if: row != 0
            return: (cast: (int) (c.lmx_graph_kind(g, row\cell) != 1))
        ---
    ---
    if: c.lmx_graph_method(g, code) = 0
        return: 3
    args: (cast: (@: c.Lmx) c.lmx_graph_get(code, 1U))
    slot: c.lmx_graph_named(g, args, name)
    if: active\refs != 0 && slot < active\width
        return: (cast: (int) (c.lmx_graph_kind(g, active\refs[slot]) != 1))
    return: 3
end: lmx_graph_local_int

# Check a known int destination without reading it or evaluating the RHS. No field is introduced here.
fn: lmx_graph_known_int (@: g c.LmxGraph; @: code c.Lmx; @: name char; int: mode) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: row c.LmxGraphWork 0
    @: args c.Lmx 0
    @: value void 0
    size_t: slot 0U
    if: name = 0
        return: 3
    if: mode != 0
        slot: c.lmx_graph_named(g, code, name)
        if: slot >= c.lmx_graph_count(code)
            return: 3
        value: c.lmx_graph_place_cell(g, code, slot)
    else:
        if: active = 0 || active\code != code
            return: 5
        if: active\frame != 0
            row: lmx_graph_work_row((cast: (@: c.LmxGraphFrame) active\frame), name)
        if: row != 0
            value: row\cell
        else:
            if: c.lmx_graph_method(g, code) != 0
                args: (cast: (@: c.Lmx) c.lmx_graph_get(code, 1U))
                slot: c.lmx_graph_named(g, args, name)
                if: active\refs != 0 && slot < active\width
                    value: active\refs[slot]
                ---
            ---
            if: value = 0
                return: 3
            ---
        ---
    ---
    if: c.lmx_graph_kind(g, value) != 1
        return: 4
    return: 0
end: lmx_graph_known_int

# Explicit paths write the graph, even when they address this activation's data. They neither publish nor refresh
# bare working values (semantics, working-state); only a later bare write marks that working place dirty.
fn: lmx_graph_store_field (@: g c.LmxGraph; @: code c.Lmx; @: owner c.Lmx; size_t: slot; int: number) int
    if: c.lmx_graph_kind(g, (cast: (@: void) owner)) != 4
        return: 4
    return: c.lmx_graph_assign_int(g, code, owner, slot, number)
end: lmx_graph_store_field

fn: lmx_graph_eval_assignment (@: g c.LmxGraph; @: code c.Lmx; @: statement c.Lmx; int: mode) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: left void c.lmx_graph_get(statement, 1U)
    @: name char c.lmx_graph_word_text(g, left)
    @: path c.Lmx (cast: (@: c.Lmx) left)
    @: value void 0
    @: owner c.Lmx code
    size_t: slot 0U
    int: number 0
    int: status 0
    if: c.lmx_graph_count(statement) != 3U
        return: 2
    if: name != 0
        status: lmx_graph_known_int(g, code, name, mode)
        slot: c.lmx_graph_named(g, code, name)
    else:
        if: c.lmx_graph_kind(g, left) != 4 || c.lmx_graph_count(path) != 3U || c.lmx_graph_word_text(g, c.lmx_graph_get(path, 1U)) != state\w_deref
            return: 2
        status: lmx_graph_eval_value(g, code, c.lmx_graph_get(path, 0U), @ value)
        if: status != 0
            return: status
        if: c.lmx_graph_kind(g, value) != 4
            return: 4
        owner: (cast: (@: c.Lmx) value)
        slot: c.lmx_graph_named(g, owner, c.lmx_graph_word_text(g, c.lmx_graph_get(path, 2U)))
        if: slot >= c.lmx_graph_count(owner)
            return: 3
        if: c.lmx_graph_place_cell(g, owner, slot) = 0
            return: 4
        ---
    ---
    if: status != 0
        return: status
    status: lmx_graph_eval_number(g, code, c.lmx_graph_get(statement, 2U), @ number)
    if: status != 0
        return: status
    if: name != 0 && mode = 0
        return: lmx_graph_store_name(g, code, name, number)
    return: lmx_graph_store_field(g, code, owner, slot, number)
end: lmx_graph_eval_assignment

fn: lmx_graph_store_name (@: g c.LmxGraph; @: code c.Lmx; @: name char; int: number) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: row c.LmxGraphWork 0
    @: args c.Lmx 0
    size_t: slot 0U
    if: active = 0 || active\code != code
        return: 5
    if: active\frame != 0
        row: lmx_graph_work_row((cast: (@: c.LmxGraphFrame) active\frame), name)
        if: row != 0
            if: row\slot = (cast: (size_t) -1)
                if: c.lmx_graph_kind(g, row\cell) != 1
                    return: 4
                return: c.lmx_int_store_known(row\cell, number)
            row\number: number
            row\loaded: 1
            row\dirty: 1
            return: 0
        ---
    ---
    if: c.lmx_graph_method(g, code) = 0
        return: 3
    args: (cast: (@: c.Lmx) c.lmx_graph_get(code, 1U))
    slot: c.lmx_graph_named(g, args, name)
    if: active\refs != 0 && slot < active\width && c.lmx_graph_kind(g, active\refs[slot]) = 1
        return: c.lmx_int_store_known(active\refs[slot], number)
    # An unbound name is not created by assignment; never write an outer lexical source by a bare assignment.
    return: 3
end: lmx_graph_store_name

# The answers of the interpreter: 0 done; 1 an address has no int representation where an int is needed; 2 a malformed
# expression (an operator without an operand, two operands in a row, an unknown token); 3 an unknown name; 4 a write
# refused (a slot that holds no int place); 5 a statement this slice does not execute; 6 division by zero.

# Resolve the current activation's formals, inherited inputs, then lexical graph fields. Each lookup consumes the
# current graph and the live activation chain; no binding is saved in the graph or reused by the next traversal.
fn: lmx_graph_resolve (@: g c.LmxGraph; @: scope c.Lmx; @: name char) @: void
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: activation c.LmxActivation 0
    @: active_frame c.LmxGraphFrame 0
    @: args c.Lmx 0
    @: row c.LmxGraphWork 0
    @: current c.Lmx scope
    @: part c.Lmx 0
    @: value void 0
    size_t: slot 0U
    if: g = 0 || name = 0
        return: 0
    activation: (cast: (@: c.LmxActivation) g\arena\activation)
    while: activation != 0
        if: activation\frame != 0
            row: lmx_graph_work_row((cast: (@: c.LmxGraphFrame) activation\frame), name)
            if: row != 0
                return: row\cell
            ---
            if: activation = g\arena\activation && name = state\w_var
                active_frame: (cast: (@: c.LmxGraphFrame) activation\frame)
                return: (cast: (@: void) active_frame\data)
            ---
        ---
        if: c.lmx_graph_method(g, activation\code) != 0 && activation\refs != 0
            args: (cast: (@: c.Lmx) c.lmx_graph_get(activation\code, 1U))
            slot: c.lmx_graph_named(g, args, name)
            if: slot < activation\width
                return: activation\refs[slot]
            ---
        ---
        activation: activation\parent
    ---
    while: c.lmx_graph_kind(g, (cast: (@: void) current)) = 4
        if: c.lmx_graph_method(g, current) != 0
            part: (cast: (@: c.Lmx) c.lmx_graph_method_body(current))
            slot: c.lmx_graph_named(g, part, name)
            value: c.lmx_graph_get(part, slot)
            if: c.lmx_graph_method(g, (cast: (@: c.Lmx) value)) != 0
                return: value
            part: (cast: (@: c.Lmx) c.lmx_graph_method_var(current))
            slot: c.lmx_graph_named(g, part, name)
            if: slot < c.lmx_graph_count(part)
                return: c.lmx_graph_get(part, slot)
            ---
        ---
        slot: c.lmx_graph_named(g, current, name)
        if: slot < c.lmx_graph_count(current)
            return: c.lmx_graph_get(current, slot)
        current: (cast: (@: c.Lmx) current\parent)
    ---
    return: 0
end: lmx_graph_resolve

# Shape/default preflight precedes evaluation of any actual. This migration executes int-returning fn bodies;
# explicit int own fields use the shared working-cache/publication mechanism. Other receiver/result forms refuse.
fn: lmx_graph_call_shape (@: g c.LmxGraph; @: code c.Lmx; size_t: actuals) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: args c.Lmx 0
    @: result c.Lmx 0
    size_t: i actuals
    if: c.lmx_graph_method(g, code) = 0
        return: 5
    args: (cast: (@: c.Lmx) c.lmx_graph_get(code, 1U))
    result: (cast: (@: c.Lmx) c.lmx_graph_get(code, 2U))
    if: actuals > c.lmx_graph_count(args)
        return: 5
    if: c.lmx_graph_has_result(g, code) != 0
        if: c.lmx_graph_count(result) != 1U || c.lmx_graph_word_text(g, c.lmx_graph_get(result, 0U)) != state\w_int
            return: 5
        ---
    ---
    while: i < c.lmx_graph_count(args)
        if: c.lmx_graph_kind(g, c.lmx_graph_get(args, i)) != 1
            return: 5
        i: i + 1U
    ---
    return: 0
end: lmx_graph_call_shape

# The first structural receiving pass for the field-reading subset: compare the paths actually used from this
# formal against the written model and the candidate, by canonical names and address types. The temporary queue
# belongs only to this admission. It neither checks unused model fields nor depends on their positions.
# Follow a nested path rooted at this formal. 0 unrelated, 1 matched, -1 a required field/type is absent.
fn: lmx_graph_admit_path (@: g c.LmxGraph; @: expression void; @: name char; @: model void; @: candidate void; @@: wanted void; @@: found void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: path c.Lmx 0
    @: field char 0
    int: status 0
    int: kind 0
    if: c.lmx_graph_word_text(g, expression) = name
        wanted[0]: model
        found[0]: candidate
        return: 1
    if: c.lmx_graph_kind(g, expression) != 4
        return: 0
    path: (cast: (@: c.Lmx) expression)
    if: c.lmx_graph_count(path) != 3U || c.lmx_graph_word_text(g, c.lmx_graph_get(path, 1U)) != state\w_deref
        return: 0
    status: lmx_graph_admit_path(g, c.lmx_graph_get(path, 0U), name, model, candidate, wanted, found)
    if: status != 1
        return: status
    field: c.lmx_graph_word_text(g, c.lmx_graph_get(path, 2U))
    wanted[0]: c.lmx_graph_field(g, wanted[0], field)
    found[0]: c.lmx_graph_field(g, found[0], field)
    kind: c.lmx_graph_kind(g, wanted[0])
    if: kind = 3
        kind: 1
    if: c.lmx_graph_kind(g, found[0]) = 3
        found[0]: c.lmx_arena_pointer_void_read(found[0])
    if: kind = 0 || kind != c.lmx_graph_kind(g, found[0])
        return: -1
    return: 1
end: lmx_graph_admit_path

fn: lmx_graph_admit_paths (@: g c.LmxGraph; @: code c.Lmx; @: name char; @: model void; @: candidate void) int
    @@: queue c.Lmx 0
    size_t: count 0U
    size_t: cap 0U
    size_t: at 0U
    size_t: i 0U
    @: current c.Lmx 0
    @: value void 0
    @: wanted void 0
    @: found void 0
    int: status 0
    if: c.lmx_graph_kind(g, model) != 4 || c.lmx_graph_kind(g, candidate) != 4
        return: 4
    status: c.lmx_graph_scan_add(@ queue, @ count, @ cap, (cast: (@: c.Lmx) c.lmx_graph_method_body(code)))
    while: at < count && status = 0
        current: queue[at]
        at: at + 1U
        if: lmx_graph_admit_path(g, (cast: (@: void) current), name, model, candidate, @ wanted, @ found) < 0
            status: 4
        i: 0U
        while: i < c.lmx_graph_count(current) && status = 0
            value: c.lmx_graph_get(current, i)
            if: c.lmx_graph_kind(g, value) = 4
                status: c.lmx_graph_scan_add(@ queue, @ count, @ cap, (cast: (@: c.Lmx) value))
            i: i + 1U
        ---
    ---
    c.free((cast: (@: void) queue))
    return: status
end: lmx_graph_admit_paths

# Admit each already evaluated argument immediately, before evaluating the next. Int arguments receive independent
# cells; a Structure is checked using its field names. The caller's transient refs array carries the admitted values.
fn: lmx_graph_admit (@: g c.LmxGraph; @: code c.Lmx; size_t: index; @: actual void; @@: out void) int
    @: args c.Lmx (cast: (@: c.Lmx) c.lmx_graph_get(code, 1U))
    @: formal void c.lmx_graph_get(args, index)
    @: model void 0
    @: declaration c.Lmx 0
    int: kind (cast: (int) c.lmx_graph_kind(g, formal))
    int: status 0
    int: number 0
    if: out = 0
        return: 4
    if: kind = 1 || kind = 3
        if: c.lmx_graph_value_int(g, actual, @ number) != 0
            return: 4
        out[0]: c.lmx_graph_int(g, number)
        if: out[0] = 0
            return: 4
        return: 0
    if: kind != 4
        return: 5
    declaration: (cast: (@: c.Lmx) formal)
    if: c.lmx_graph_count(declaration) != 2U
        return: 5
    model: lmx_graph_resolve(g, (cast: (@: c.Lmx) code\parent), c.lmx_graph_word_text(g, c.lmx_graph_get(declaration, 0U)))
    status: lmx_graph_admit_paths(g, code, c.lmx_graph_slot_name(g, args, index), model, actual)
    if: status = 0
        out[0]: actual
    return: status
end: lmx_graph_admit

# Sequential statements over the current method activation. Bodies stay in the graph on every call.
# A control body is consumed in the same activation. Flow is the canonical word address, never an opcode or
# retained plan. mode 0 uses activation places; mode 1 is construction-root execution; mode 2 is its inline body.
fn: lmx_graph_block (@: g c.LmxGraph; @: code c.Lmx; @: body c.Lmx; size_t: from; size_t: to; int: mode; @: out int; @@: flow char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: statement c.Lmx 0
    @: nested c.Lmx 0
    @: header c.Lmx 0
    @: head char 0
    @: target void 0
    @: raw void 0
    size_t: i from
    size_t: n 0U
    size_t: slot 0U
    int: number 0
    int: status 0
    int: nested_mode mode
    int: cleanup_status 0
    int: pending_result 0
    @: pending_flow char 0
    if: mode = 1
        nested_mode: 2
    while: i < to && status = 0 && flow[0] = 0
        raw: c.lmx_graph_get(body, i)
        if: c.lmx_graph_name_of(g, raw) != 0 || c.lmx_graph_kind(g, raw) = 3
            i: i + 1U
            continue
        head: c.lmx_graph_word_text(g, raw)
        if: head = state\w_return
            if: c.lmx_graph_has_result(g, code) != 0
                return: 5
            flow[0]: head
            return: 0
        if: head = state\w_break || head = state\w_continue || head = state\w_redo
            flow[0]: head
            return: 0
        if: c.lmx_graph_kind(g, raw) != 4
            if: mode = 0
                status: lmx_graph_eval_number(g, code, raw, @ number)
            i: i + 1U
            continue
        statement: (cast: (@: c.Lmx) raw)
        if: c.lmx_graph_method(g, statement) != 0
            i: i + 1U
            continue
        n: c.lmx_graph_count(statement)
        head: c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 0U))
        if: head = state\w_assign
            status: lmx_graph_eval_assignment(g, code, statement, mode)
            i: i + 1U
            continue
        if: head = state\w_finally
            # Reaching this field registers its body in this scope. Recursing over the remaining statements makes
            # multiple registrations unwind in reverse order, without a persistent plan or a second graph.
            status: lmx_graph_block(g, code, body, i + 1U, to, mode, out, flow)
            pending_flow: flow[0]
            if: pending_flow = state\w_return
                pending_result: out[0]
            if: status != 0 || pending_flow = state\w_return
                cleanup_status: lmx_graph_work_flush(g)
                if: cleanup_status != 0
                    status: cleanup_status
                ---
            ---
            flow[0]: 0
            cleanup_status: lmx_graph_block(g, code, statement, 1U, n, nested_mode, out, flow)
            if: cleanup_status != 0
                return: cleanup_status
            if: flow[0] = 0
                flow[0]: pending_flow
                if: pending_flow = state\w_return
                    out[0]: pending_result
                ---
            ---
            return: status
        if: head = state\w_if
            if: n != 3U || c.lmx_graph_kind(g, c.lmx_graph_get(statement, 2U)) != 4
                return: 2
            status: lmx_graph_eval_number(g, code, c.lmx_graph_get(statement, 1U), @ number)
            if: status != 0
                return: status
            if: number != 0
                nested: (cast: (@: c.Lmx) c.lmx_graph_get(statement, 2U))
                status: lmx_graph_block(g, code, nested, 0U, c.lmx_graph_count(nested), nested_mode, out, flow)
            i: i + 1U
            if: i < to && c.lmx_graph_kind(g, c.lmx_graph_get(body, i)) = 4
                statement: (cast: (@: c.Lmx) c.lmx_graph_get(body, i))
                if: c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 0U)) = state\w_else
                    if: number = 0 && status = 0
                        status: lmx_graph_block(g, code, statement, 1U, c.lmx_graph_count(statement), nested_mode, out, flow)
                    i: i + 1U
                ---
            ---
            continue
        if: head = state\w_else
            return: 2
        if: head = state\w_while || head = state\w_for || head = state\w_until
            if: n != 3U || c.lmx_graph_kind(g, c.lmx_graph_get(statement, 2U)) != 4
                return: 2
            nested: (cast: (@: c.Lmx) c.lmx_graph_get(statement, 2U))
            header: (cast: (@: c.Lmx) c.lmx_graph_get(statement, 1U))
            if: head = state\w_for
                if: c.lmx_graph_kind(g, (cast: (@: void) header)) != 4 || c.lmx_graph_count(header) != 3U
                    return: 2
                status: lmx_graph_block(g, code, header, 0U, 1U, nested_mode, out, flow)
            while: status = 0 && flow[0] = 0
                number: 1
                if: head != state\w_until
                    if: head = state\w_for
                        status: lmx_graph_eval_number(g, code, c.lmx_graph_get(header, 1U), @ number)
                    else:
                        status: lmx_graph_eval_number(g, code, c.lmx_graph_get(statement, 1U), @ number)
                    ---
                ---
                if: status != 0 || number = 0
                    break
                while: status = 0
                    flow[0]: 0
                    status: lmx_graph_block(g, code, nested, 0U, c.lmx_graph_count(nested), nested_mode, out, flow)
                    if: flow[0] != state\w_redo
                        break
                ---
                if: status != 0 || flow[0] = state\w_return
                    break
                if: flow[0] = state\w_break
                    flow[0]: 0
                    break
                if: flow[0] = state\w_continue
                    flow[0]: 0
                if: head = state\w_for && flow[0] = 0
                    status: lmx_graph_block(g, code, header, 2U, 3U, nested_mode, out, flow)
                ---
                if: status = 0 && head = state\w_until && flow[0] = 0
                    status: lmx_graph_eval_number(g, code, c.lmx_graph_get(statement, 1U), @ number)
                    if: status != 0 || number != 0
                        break
                    ---
                ---
            ---
            i: i + 1U
            continue
        if: head = state\w_break || head = state\w_continue || head = state\w_redo
            if: n != 1U
                return: 5
            flow[0]: head
            return: 0
        if: head = state\w_return
            if: n = 1U
                if: c.lmx_graph_has_result(g, code) != 0
                    return: 5
                ---
            else:
                if: c.lmx_graph_has_result(g, code) = 0
                    return: 5
                status: lmx_graph_eval(g, code, statement, 1U, n, out)
            ---
            flow[0]: state\w_return
            return: status
        if: head = 0
            status: lmx_graph_block(g, code, statement, 0U, n, nested_mode, out, flow)
            i: i + 1U
            continue
        if: mode = 1
            status: lmx_graph_exec_statement(g, code, i)
            i: i + 1U
            continue
        if: head = state\w_call
            status: lmx_graph_eval_explicit_call(g, code, statement)
            i: i + 1U
            continue
        if: head = state\w_at
            return: 5
        if: head = state\w_int
            head: c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 1U))
            if: mode = 0
                status: lmx_graph_local_int(g, code, head)
            else:
                slot: c.lmx_graph_named(g, code, head)
                if: slot = c.lmx_graph_count(code)
                    return: 3
            ---
            if: status != 0 || n = 2U
                i: i + 1U
                continue
            status: lmx_graph_eval(g, code, statement, 2U, n, @ number)
        else:
            target: lmx_graph_resolve(g, code, head)
            if: c.lmx_graph_method(g, (cast: (@: c.Lmx) target)) != 0
                status: lmx_graph_eval_call(g, code, statement, (cast: (@: c.Lmx) target), @ number)
                i: i + 1U
                continue
            status: lmx_graph_eval(g, code, statement, 1U, n, @ number)
        ---
        if: status = 0
            if: mode = 0
                status: lmx_graph_store_name(g, code, head, number)
            else:
                slot: c.lmx_graph_named(g, code, head)
                if: slot = c.lmx_graph_count(code)
                    return: 3
                status: c.lmx_graph_assign_int(g, code, code, slot, number)
            ---
        ---
        i: i + 1U
    ---
    return: status
end: lmx_graph_block

fn: lmx_graph_method_run (@: g c.LmxGraph; @: code c.Lmx; @: out int) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: body c.Lmx code
    @: flow char 0
    int: status 0
    if: c.lmx_graph_method(g, code) != 0
        body: (cast: (@: c.Lmx) c.lmx_graph_method_body(code))
    status: lmx_graph_block(g, code, body, 0U, c.lmx_graph_count(body), 0, out, @ flow)
    if: status != 0
        return: status
    if: flow != 0 && flow != state\w_return
        return: 5
    if: c.lmx_graph_has_result(g, code) != 0 && flow != state\w_return
        return: 5
    return: 0
end: lmx_graph_method_run

# Invoke with arguments that have already passed admission. Missing literal defaults are copied into this call's
# private places. Native and interpretation share the ordinary activation ABI; the signature graph remains intact.
fn: lmx_graph_invoke_data (@: g c.LmxGraph; @: code c.Lmx; @: data c.Lmx; @@: actuals void; size_t: count; @: out int) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: args c.Lmx 0
    @: body c.Lmx 0
    @: statement c.Lmx 0
    @@: refs void 0
    @: returned void 0
    c.LmxActivation: activation
    c.LmxGraphFrame: frame
    size_t: width 0U
    size_t: i 0U
    int: status lmx_graph_call_shape(g, code, count)
    if: status != 0 || out = 0
        return: 5
    args: (cast: (@: c.Lmx) c.lmx_graph_get(code, 1U))
    width: c.lmx_graph_count(args)
    refs: (cast: (@@: void) c.calloc(width + 1U, sizeof(@: void)))
    if: refs = 0
        return: 4
    while: i < width && status = 0
        if: i < count
            refs[i]: actuals[i]
        else:
            status: lmx_graph_admit(g, code, i, c.lmx_graph_get(args, i), @ refs[i])
        ---
        i: i + 1U
    ---
    if: status = 0
        status: lmx_graph_work_flush(g)
    if: status = 0
        if: code\native != 0
            status: c.lmx_call_prim(g\arena, code, data, refs, width, (cast: (@: void) out), @ returned)
        else:
            status: c.lmx_activation_push(g\arena, @ activation, 2, code, refs, 0, width, 0)
            if: status = 0
                status: lmx_graph_work_open_data(g, code, data, @ frame)
                if: status = 0
                    status: lmx_graph_method_run(g, code, out)
                    status: lmx_graph_work_finish(g, @ frame, status)
                ---
                c.lmx_activation_pop(g\arena, @ activation)
            ---
        ---
    ---
    c.free((cast: (@: void) refs))
    return: status
end: lmx_graph_invoke_data

fn: lmx_graph_invoke (@: g c.LmxGraph; @: code c.Lmx; @@: actuals void; size_t: count; @: out int) int
    return: lmx_graph_invoke_data(g, code, (cast: (@: c.Lmx) c.lmx_graph_method_var(code)), actuals, count, out)
end: lmx_graph_invoke

fn: lmx_graph_eval_call (@: g c.LmxGraph; @: scope c.Lmx; @: expression c.Lmx; @: code c.Lmx; @: out int) int
    size_t: count (cast: (size_t) (c.lmx_graph_count(expression) - 1U))
    size_t: i 0U
    @@: values void 0
    @: actual void 0
    int: status lmx_graph_call_shape(g, code, count)
    if: status != 0
        return: status
    values: (cast: (@@: void) c.calloc(count + 1U, sizeof(@: void)))
    if: values = 0
        return: 4
    while: i < count && status = 0
        status: lmx_graph_eval_value(g, scope, c.lmx_graph_get(expression, i + 1U), @ actual)
        if: status = 0
            status: lmx_graph_admit(g, code, i, actual, @ values[i])
        i: i + 1U
    ---
    if: status = 0
        status: lmx_graph_invoke(g, code, values, count, out)
    c.free((cast: (@: void) values))
    return: status
end: lmx_graph_eval_call

# Evaluate an address-valued operand. A path returns the actual current field cell/Structure; arithmetic and a call
# create a result cell only where a receiving boundary needs an address. Arithmetic's intermediate ints stay local.
fn: lmx_graph_eval_value (@: g c.LmxGraph; @: scope c.Lmx; @: raw void; @@: out void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: expression c.Lmx 0
    @: value void raw
    @: word char 0
    size_t: count 0U
    int: kind (cast: (int) c.lmx_graph_kind(g, raw))
    int: number 0
    int: status 0
    if: out = 0 || kind = 0
        return: 2
    if: kind = 2
        value: lmx_graph_operand_name(g, scope, c.lmx_graph_word_text(g, raw))
        if: value = 0
            return: 3
        ---
    else:
        if: kind = 4 && c.lmx_graph_name_of(g, raw) = 0
            expression: (cast: (@: c.Lmx) raw)
            count: c.lmx_graph_count(expression)
            word: c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 1U))
            if: count = 3U && word = state\w_deref
                status: lmx_graph_eval_value(g, scope, c.lmx_graph_get(expression, 0U), @ value)
                if: status != 0
                    return: status
                value: c.lmx_graph_field(g, value, c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 2U)))
                if: value = 0
                    return: 3
                ---
            else:
                word: c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 0U))
                if: count = 2U && word = state\w_at
                    value: c.lmx_graph_get(expression, 1U)
                    if: c.lmx_graph_kind(g, value) = 2
                        value: lmx_graph_resolve(g, scope, c.lmx_graph_word_text(g, value))
                        status: 0
                        if: value = 0
                            status: 3
                        ---
                    else:
                        status: lmx_graph_eval_value(g, scope, value, @ value)
                    ---
                    if: status != 0
                        return: status
                    if: c.lmx_graph_kind(g, value) = 3
                        value: c.lmx_arena_pointer_void_read(value)
                    value: c.lmx_graph_ref_int(g, value)
                    if: value = 0
                        return: 4
                    ---
                else:
                    if: count = 1U && c.lmx_graph_method(g, (cast: (@: c.Lmx) lmx_graph_resolve(g, scope, word))) = 0
                        return: lmx_graph_eval_value(g, scope, c.lmx_graph_get(expression, 0U), out)
                    status: lmx_graph_eval_number(g, scope, raw, @ number)
                    if: status != 0
                        return: status
                    value: c.lmx_graph_int(g, number)
                    if: value = 0
                        return: 4
                    ---
                ---
            ---
        ---
    ---
    out[0]: value
    return: 0
end: lmx_graph_eval_value

# Consume the nested expression itself. No precedence parser or saved expression plan exists in either consumer.
fn: lmx_graph_eval_number (@: g c.LmxGraph; @: scope c.Lmx; @: raw void; @: out int) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: expression c.Lmx 0
    @: value void raw
    @: word char 0
    size_t: count 0U
    size_t: slot 0U
    int: kind (cast: (int) c.lmx_graph_kind(g, raw))
    int: left 0
    int: right 0
    int: status 0
    if: kind = 2
        return: lmx_graph_named_int(g, scope, c.lmx_graph_word_text(g, raw), out)
    if: kind != 4
        return: c.lmx_graph_value_int(g, value, out)
    expression: (cast: (@: c.Lmx) raw)
    count: c.lmx_graph_count(expression)
    word: c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 1U))
    if: count = 3U && word = state\w_deref
        status: lmx_graph_eval_value(g, scope, raw, @ value)
        if: status != 0
            return: status
        return: c.lmx_graph_value_int(g, value, out)
    if: count = 3U && (word = state\w_plus || word = state\w_minus || word = state\w_star || word = state\w_slash || word = state\w_percent || word = state\w_eq || word = state\w_ne || word = state\w_lt || word = state\w_le || word = state\w_gt || word = state\w_ge || word = state\w_and || word = state\w_or)
        status: lmx_graph_eval_number(g, scope, c.lmx_graph_get(expression, 0U), @ left)
        if: status != 0
            return: status
        if: (word = state\w_and && left = 0) || (word = state\w_or && left != 0)
            out[0]: (cast: (int) (left != 0))
            return: 0
        status: lmx_graph_eval_number(g, scope, c.lmx_graph_get(expression, 2U), @ right)
        if: status != 0
            return: status
        if: word = state\w_plus
            left: left + right
        if: word = state\w_minus
            left: left - right
        if: word = state\w_star
            left: left * right
        if: word = state\w_slash || word = state\w_percent
            if: right = 0
                return: 6
            if: word = state\w_slash
                left: left / right
            else:
                left: left % right
            ---
        ---
        if: word = state\w_eq
            left: (cast: (int) (left = right))
        if: word = state\w_ne
            left: (cast: (int) (left != right))
        if: word = state\w_lt
            left: (cast: (int) (left < right))
        if: word = state\w_le
            left: (cast: (int) (left <= right))
        if: word = state\w_gt
            left: (cast: (int) (left > right))
        if: word = state\w_ge
            left: (cast: (int) (left >= right))
        if: word = state\w_and
            left: (cast: (int) (left && right))
        if: word = state\w_or
            left: (cast: (int) (left || right))
        out[0]: left
        return: 0
    word: c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 0U))
    if: count = 2U && (word = state\w_plus || word = state\w_minus || word = state\w_not)
        status: lmx_graph_eval_number(g, scope, c.lmx_graph_get(expression, 1U), out)
        if: status = 0 && word = state\w_minus
            out[0]: 0 - out[0]
        if: status = 0 && word = state\w_not
            out[0]: (cast: (int) (out[0] = 0))
        return: status
    if: count = 2U && word = state\w_deref
        status: lmx_graph_eval_value(g, scope, c.lmx_graph_get(expression, 1U), @ value)
        if: status != 0
            return: status
        if: c.lmx_graph_kind(g, value) != 5
            return: 2
        return: c.lmx_graph_value_int(g, c.lmx_arena_pointer_void_read(value), out)
    value: lmx_graph_resolve(g, scope, word)
    if: c.lmx_graph_method(g, (cast: (@: c.Lmx) value)) != 0
        if: c.lmx_graph_has_result(g, (cast: (@: c.Lmx) value)) = 0
            return: 5
        return: lmx_graph_eval_call(g, scope, expression, (cast: (@: c.Lmx) value), out)
    if: count = 1U
        return: lmx_graph_eval_number(g, scope, c.lmx_graph_get(expression, 0U), out)
    return: 2
end: lmx_graph_eval_number

# A receiving expression occupies one field: the builder has already put every operation into its ordinary Lmx.
fn: lmx_graph_eval (@: g c.LmxGraph; @: scope c.Lmx; @: expr c.Lmx; size_t: from; size_t: to; @: out int) int
    if: g = 0 || scope = 0 || expr = 0 || out = 0 || to != from + 1U
        return: 2
    return: lmx_graph_eval_number(g, scope, c.lmx_graph_get(expr, from), out)
end: lmx_graph_eval

# One statement: the Lmx at slot index of root, whose field 0 is a word. `int: name expression` publishes the value in a
# new int cell named name in that slot; `name: expression` writes the int place named name.
fn: lmx_graph_exec_statement (@: g c.LmxGraph; @: root c.Lmx; size_t: index) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: statement c.Lmx (cast: (@: c.Lmx) c.lmx_graph_get(root, index))
    @: head char 0
    @: name char 0
    @: cell void 0
    size_t: n 0U
    size_t: k 0U
    int: value 0
    int: r 0
    if: state = 0 || statement = 0
        return: 5
    n: c.lmx_graph_count(statement)
    head: c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 0U))
    if: head = state\w_call
        return: lmx_graph_eval_explicit_call(g, root, statement)
    cell: lmx_graph_resolve(g, root, head)
    if: c.lmx_graph_method(g, (cast: (@: c.Lmx) cell)) != 0
        return: lmx_graph_eval_call(g, root, statement, (cast: (@: c.Lmx) cell), @ value)
    if: n < 2U || head = 0
        return: 5
    if: head = state\w_at
        # The initialized reference form of this int-only slice: @: p int @i. The words stay in the source graph;
        # resolving i belongs to this traversal, and the resulting p is an ordinary primitive pointer value.
        if: n != 4U || c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 2U)) != state\w_int
            return: 5
        name: c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 1U))
        if: name = 0
            return: 5
        r: lmx_graph_eval_value(g, root, c.lmx_graph_get(statement, 3U), @ cell)
        if: r != 0
            return: r
        if: c.lmx_graph_kind(g, cell) != 5
            return: 4
        return: c.lmx_graph_publish(g, root, index, cell)
    if: head = state\w_int
        name: c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 1U))
        if: n < 3U || name = 0
            return: 5
        r: lmx_graph_eval(g, root, statement, 2U, n, @ value)
        if: r != 0
            return: r
        cell: c.lmx_graph_int(g, value)
        if: cell = 0
            return: 4
        return: c.lmx_graph_publish(g, root, index, cell)
    k: c.lmx_graph_named(g, root, head)
    if: k >= c.lmx_graph_count(root)
        return: 3
    r: lmx_graph_eval(g, root, statement, 1U, n, @ value)
    if: r != 0
        return: r
    if: c.lmx_graph_assign_int(g, root, root, k, value) != 0
        return: 4
    return: 0
end: lmx_graph_exec_statement

# The execution of a root: its fields in order; a field holding a primitive is a value and stands; a field holding an
# unnamed Lmx whose field 0 is a word is a statement and runs; a named Lmx (a data Structure) stands. 0, or the first
# statement's answer.
fn: lmx_graph_run (@: g c.LmxGraph; @: root c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: flow char 0
    int: number 0
    int: status 0
    if: g = 0 || root = 0
        return: 5
    status: lmx_graph_block(g, root, root, 0U, c.lmx_graph_count(root), 1, @ number, @ flow)
    if: status = 0 && flow != 0 && flow != state\w_return
        return: 5
    return: status
end: lmx_graph_run

# Dispatch the current clean graph. Native uses the existing common nullary call boundary; with no entry the clean
# interpreter gets a fresh activation frame, discarded on return. No previous traversal's bindings are retained.
fn: lmx_graph_call (@: g c.LmxGraph; @: root c.Lmx) int
    c.LmxActivation: activation
    int: value 0
    int: status 0
    if: g = 0 || c.lmx_graph_kind(g, (cast: (@: void) root)) != 4
        return: 5
    if: root\native != 0
        return: c.lmx_call0(g\arena, root, @ value)
    if: c.lmx_activation_push(g\arena, @ activation, 2, root, 0, 0, 0U, 0) != 0
        return: 5
    status: lmx_graph_run(g, root)
    c.lmx_activation_pop(g\arena, @ activation)
    return: status
end: lmx_graph_call



# Explicit call selects actual code and data at runtime. A missing shorthand var is null, never code or a new Lmx.
fn: lmx_graph_eval_explicit_call (@: g c.LmxGraph; @: scope c.Lmx; @: expression c.Lmx) int
    @: code void 0
    @: data void 0
    size_t: count c.lmx_graph_count(expression)
    int: status 0
    if: count < 2U || count > 3U
        return: 5
    status: lmx_graph_eval_value(g, scope, c.lmx_graph_get(expression, 1U), @ code)
    if: status = 0 && count = 3U
        status: lmx_graph_eval_value(g, scope, c.lmx_graph_get(expression, 2U), @ data)
    if: status != 0
        return: status
    return: lmx_graph_call_data(g, (cast: (@: c.Lmx) code), (cast: (@: c.Lmx) data), (cast: (int) (count = 2U)))
end: lmx_graph_eval_explicit_call

fn: lmx_graph_call_data (@: g c.LmxGraph; @: code c.Lmx; @: data c.Lmx; int: shorthand) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    c.LmxActivation: activation
    c.LmxGraphFrame: frame
    @: returned void 0
    size_t: slot 0U
    size_t: i 0U
    int: number 0
    int: status 0
    if: c.lmx_graph_kind(g, (cast: (@: void) code)) != 4
        return: 5
    if: shorthand != 0
        if: c.lmx_graph_method(g, code) != 0
            data: (cast: (@: c.Lmx) c.lmx_graph_method_var(code))
        else:
            slot: c.lmx_graph_named(g, code, state\w_var)
            data: (cast: (@: c.Lmx) c.lmx_graph_get(code, slot))
            i: slot + 1U
            while: i < c.lmx_graph_count(code)
                if: c.lmx_graph_slot_name(g, code, i) = state\w_var
                    return: 3
                i: i + 1U
            ---
        ---
    ---
    if: (data != 0 || shorthand = 0) && c.lmx_graph_kind(g, (cast: (@: void) data)) != 4
        return: 5
    # Callable arguments retain their own contract; this explicit nullary form has no actual arguments.
    if: c.lmx_graph_method(g, code) != 0
        return: lmx_graph_invoke_data(g, code, data, 0, 0U, @ number)
    status: lmx_graph_work_flush(g)
    if: status != 0
        return: status
    if: code\native != 0
        return: c.lmx_call_prim(g\arena, code, data, 0, 0U, (cast: (@: void) @ number), @ returned)
    status: c.lmx_activation_push(g\arena, @ activation, 2, code, 0, 0, 0U, 0)
    if: status = 0
        status: lmx_graph_work_open_data(g, code, data, @ frame)
        if: status = 0
            status: lmx_graph_method_run(g, code, @ number)
            status: lmx_graph_work_finish(g, @ frame, status)
        ---
        c.lmx_activation_pop(g\arena, @ activation)
    ---
    return: status
end: lmx_graph_call_data
