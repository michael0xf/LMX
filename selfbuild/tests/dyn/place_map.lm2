# Slice 275 (P1-PLACE-MAP of the N4-U plan; the book, "Проверка используемого интерфейса"; L2 86: equal ordinal positions are not
# assumed).  A named root and a nested field declare a layout on their slot.  A Structure of another layout admitted there stands in
# that slot, and read, write, address and publication reach its fields through the map of the admitted pair, at any depth.  Own
# references and formals keep their own route and agree.  Entry 7; 81.. name the failing check.
Other:
    int: z 9
    int: y 7
end: Other
Third:
    int: p 1
    int: q 2
    int: y 9
end: Third
Box:
    kid:
        int: y 3
    end: kid
end: Box
Far:
    int: z 9
    b:
        int: q 1
        int: y 7
        int: u 4
    end: b
    []: int items 2
end: Far
Near:
    a:
        b:
            int: u 2
            int: y 3
        end: b
        []: int items 3
    end: a
end: Near
First:
    int: a 1
    int: x 3
end: First
Second:
    int: w 9
    int: x 5
    int: a 2
end: Second
Bad:
    int: nothing 1
end: Bad
Req:
    int: y 0
end: Req
S1:
    T:
        int: extra 7
        int: v 1
    end: T
end: S1
D:
    T:
        int: v 0
    end: T
end: D
Holder:
    T:
        int: v 3
    end: T
end: Holder
Standing:
    int: w 9
    T:
        int: v 5
    end: T
end: Standing
T:
    int: v 11
end: T
Writer:
    var\y: var\y + 1
end: Writer
int: quote 11
sub: put_kid ()
    quote\kid: Other
end: put_kid
sub: put_far ()
    quote\a: Far
end: put_far
sub: put_bad ()
    quote\kid: Bad
end: put_bad
sub: put_null ()
    quote\kid: 0
end: put_null
sub: put_third ()
    quote\kid: Third
end: put_third
fn: read_typed () int
    return: Box\kid\y
end: read_typed
fn: follow_kid () int
    ---
        return: Box\kid\y
        catch: interpreter ()
            return: 0 - 1
    ---
end: follow_kid
fn: take_req (@: p Req) int
    return: p\y
end: take_req
# A nested slot: a read, a write and an address of the field through the map.  A refused value changes nothing; a present null
# is followed to the implicit interpreter in both executors; a second rebinding reuses the slot's cell for the new pair.  The value
# read from the slot is admitted further, and it is the data of a split call by its own names.
fn: nested () int
    @: quote Box Box
    int: caught 0
    ---
        put_bad()
        catch: implements ()
            caught: 1
    ---
    if: caught != 1 || Box\kid\y != 3
        return: 81
    put_null()
    if: follow_kid() != 0 - 1
        return: 100
    put_third()
    if: follow_kid() != 9
        return: 101
    Box\kid\y: 2
    if: Third\y != 2 || Third\p != 1 || Third\q != 2
        return: 102
    put_kid()
    if: Box\kid\y != 7 || read_typed() != 7
        return: 82
    Box\kid\y: 5
    if: Other\y != 5 || Other\z != 9
        return: 83
    @: p int @ (Box\kid\y)
    \p: 6
    if: Other\y != 6 || Other\z != 9
        return: 84
    if: take_req(Box\kid) != 6
        return: 103
    @: r Req Box\kid
    if: r\y != 6
        return: 104
    call: Writer Box\kid
    if: Other\y != 7 || Box\kid\y != 7
        return: 105
    Box\kid\y: 6
    return: 0
end: nested
fn: through (@: p Near) int
    return: p\a\b\y
end: through
# Two levels: the field below a mapped holder is declared by the model's own field; an Array field keeps its own length.
fn: deep () int
    @: quote Near Near
    put_far()
    if: Near\a\b\y != 7 || Near\a\b\u != 4 || through(Near) != 7
        return: 85
    Near\a\b\y: 8
    if: Far\b\y != 8 || Far\b\q != 1 || Far\b\u != 4
        return: 86
    if: length(Near\a\items) != 2U
        return: 87
    Near\a\items[1U]: 4
    if: Far\items[1U] != 4
        return: 88
    return: 0
end: deep
fn: take (@: p First) int
    return: p\x
end: take
# A named root rebound by the root's statement: a typed path, a formal, an own reference and an address use the same field.
fn: rooted () int
    if: First\x != 5 || take(First) != 5
        return: 89
    @: q First First
    if: q\x != 5
        return: 90
    First\x: 6
    if: Second\x != 6 || Second\w != 9 || Second\a != 2 || take(First) != 6
        return: 91
    @: p int @ (First\x)
    \p: 8
    if: Second\x != 8 || Second\w != 9 || Second\a != 2 || q\x != 8
        return: 106
    return: 0
end: rooted
fn: read_root_t () int
    return: T\v
end: read_root_t
fn: read_node_t () int
    return: node\T\v
end: read_node_t
# A split call publishes its own Structure into its data's slot: nested data, then the unit itself.
fn: split () int
    call: S1 D
    if: D\T\v != 1
        return: 92
    call: S1 node
    if: T\v != 1 || read_root_t() != 1 || read_node_t() != 1
        return: 93
    return: 0
end: split
# The data of a split call is itself a rebound root: its place is found in what stands there, and the third layout lands through both maps.
fn: split_rebound () int
    call: S1 Holder
    if: Holder\T\v != 1
        return: 94
    if: Standing\T\v != 1 || Standing\w != 9
        return: 95
    return: 0
end: split_rebound
int: code 7
int: refused 0
---
    First: Bad
    catch: implements ()
        refused: 1
---
if: refused != 1 || First\x != 3
    code: 96
First: Second
if: code = 7 && First\x != 5
    code: 97
Holder: Standing
int: step 0
if: code = 7
    step: nested()
    if: step = 0
        step: deep()
    ---
    if: step = 0
        step: rooted()
    ---
    if: step = 0
        step: split()
    ---
    if: step = 0
        step: split_rebound()
    ---
    if: step != 0
        code: step
    ---
---
# A merge copy of a holder whose slot stands by another layout reads and writes the copy through the copied pair, at two levels.
Copy: merge: Box
if: code = 7 && Copy\kid\y != 6
    code: 98
if: code = 7
    Copy\kid\y: 4
    if: Copy\kid\y != 4 || Box\kid\y != 6
        code: 99
    ---
---
CopyNear: merge: Near
if: code = 7 && CopyNear\a\b\y != 8
    code: 107
if: code = 7
    CopyNear\a\b\y: 5
    if: CopyNear\a\b\y != 5 || CopyNear\a\b\u != 4 || Near\a\b\y != 8
        code: 108
    ---
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
