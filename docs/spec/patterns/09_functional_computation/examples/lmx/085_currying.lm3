Addition:
    int: first
    int: second
    return: int
    apply:
        return: first + second

Demo:
    return: int
    run:
        throws: copy(curry\throws) FxRecordArity
        @: add curry(Addition\apply)
        @: add5 add(5)
        return: add5(1) * 1000000 + add(100)(1) * 1000 + add5(1)
