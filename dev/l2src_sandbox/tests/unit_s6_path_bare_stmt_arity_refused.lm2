# An explicit empty call through a path with a required formal is refused for the missing argument.
Holder:
    fn: viaPath
end: Holder
fn: viaPath (int: n) int
    return: n + 1
end: viaPath
fn: run () int
    Holder\viaPath()
    return: 7
end: run
sendMessage: exit(exit_code: run(); stdout: ""; stderr: "")
return
