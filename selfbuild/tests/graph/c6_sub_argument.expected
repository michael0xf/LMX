---
    Observed:
        int: seen 0
        int: r 0
    end: Observed
---
@: shared (data [] 0)
sub: s ()
    :=: ((shared \ Observed) \ seen) (((shared \ Observed) \ seen) + 1)
end: s
fn: f (int: a) int
    :=: ((shared \ Observed) \ r) a
    return: a
end: f
fn: f (u8: a) int
    return: 2
end: f
sub: main ()
    f: (s)
end: main
main:
