        status: c.lm_compiler_raw_index_path(selected, rw_mi_cell[0], @ raw)
        if: status != 0
            return: (cast: (int) (c.lm_compiler_rw_refuse((cast: (const: @: c.LmP0Node) (span\node)), "an incomplete machine path verdict")))
        status: lm_compiler_rw_raw_index_value(@ raw, parent, out)
        c.lm_compiler_address_release(@ raw)
        return: (cast: (int) (status))
    if: status != 0 && selected\n > 0 && c.lm_compiler_path_root_raw_c(selected, rw_mi_cell[0]) != 0
        word\data: (cast: (@: char) selected\text)
        word\length: selected\length
