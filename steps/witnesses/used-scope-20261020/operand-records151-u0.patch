+# Current result of THIS expression use,not an arena/global binding cache.
+# 4 means an older plain borrowed span with no retained preparation;1 a
+# held non-path;2 semantic refusal;3 allocation failure;0 held verdict.
+fn: l2_value_span_path (@: L2ValueSpan span; int: mi; @@: L2Path out) int
+    int: previous
+    int: status
+    int: owned
+    L2Path: current
+    @: L2Path value
+    \out: 0
+    if: span = 0 || span\grammar = 0
+        return: 4
+    if: span\grammar = 2
+        return: 1
+    if: span\prepared = 0
+        return: 2
+    value: span\prepared
+    \out: value
+    # All borrowed span copies share this record's readiness/context. A
+    # new semantic use starts with fresh verdict fields but keeps its exact
+    # grammar/text; no parse and no stale root/type/map can survive it.
+    if: value\value_status = 0 || value\value_method != mi
+        status: l2_path_prepared_view(value, @ current)
+        if: status != 0
+            value\value_status: -1
+            value\value_method: mi
+            return: 3
+        owned: value\owned
+        value\owned: 0
+        l2_path_release(value)
+        memcpy(value, @ current, c.sizeof(c.L2Path))
+        value\owned: owned
+        previous: l2_cur_mi
+        l2_cur_mi: mi
+        status: l2_path_walk(value)
+        l2_cur_mi: previous
+        value\value_method: mi
+        value\value_status: -1
+        if: status = 0
+            value\value_status: 1
+    ---
+    if: l2_alloc_err != 0
+        return: 3
+    if: value\value_status != 1
+        return: 2
+return: 0
