fn: lm_compiler_os_branch_method (const: (@: branch c.LmP0Node); const: (@: name c.LmP0Text)) const: @: c.LmP0Node
    @: f c.LmP0Field
    if: branch = 0 || name = 0 || branch\as = 0 || branch\as\frame = 0 || branch\as\frame\body = 0
        return: (cast: (const: @: c.LmP0Node) (0))
