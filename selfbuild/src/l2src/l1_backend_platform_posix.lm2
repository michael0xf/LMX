# Ordinary L2 default-platform bodies; native getcwd conversion stays with the target header.
include: "<stddef.h>" "<stdio.h>" "<unistd.h>"

fn: l1_replace_file (const: (char@: tmp); const: (char@: out_path)) int
    if: c.rename(tmp, out_path) != 0
        return: (cast: (int) 1)
    return: (cast: (int) 0)
end: l1_replace_file

fn: l1_getcwd (char@: buffer; size_t: size) char@
    return: (cast: (char@) c.getcwd(buffer, size))
end: l1_getcwd

fn: l1_path_is_absolute (const: (char@: path)) int
    if: path = 0 || path[0] = 0
        return: (cast: (int) 0)
    return: (cast: (int) (path[0] = 47))
end: l1_path_is_absolute
