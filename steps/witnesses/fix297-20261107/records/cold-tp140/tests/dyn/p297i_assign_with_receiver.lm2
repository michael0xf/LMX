# Slice 297 probe (REPEATED-DECL-TYPED-RECEPTION, the ordinary reception it reuses): `z: char: 6` with the char -> int
# receiver defined by the program; the receiver adds 1 (7 = received through it).  Exit: z's value; 25 for the implicit
# convert.
fn: lm_stg_convert_char_int (char: c) int
    return: (cast: (int) c) + 1
end: lm_stg_convert_char_int
fn: run () int
    ---
        int: z 5
        z: char: 6
        return: z
        catch: convert ()
            return: 25
    ---
end: run
int: code run()
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
