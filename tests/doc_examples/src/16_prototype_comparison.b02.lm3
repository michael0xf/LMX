Point:
    int: x 3
    int: y 4
    return: int
    score:
        return: x * 10 + y
    demo:
        @: original (copy(Point))
        original := parent(original\score)
        original\x := 7
        @: replica (copy(original))
        replica := parent(replica\score)
        replica\y := 9
        return: original\score() + replica\score()
