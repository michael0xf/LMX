# A frame place of a machine scalar type: the input d of set, a double, is a place of its activation; `d := 2.5`
# writes that place, and the path write puts its value into the graph field r: r 2.5.
(
    Values:
        double: r 0.0
)
sub: set (double: d 0.5)
    @: shared node[0]
    d := 2.5
    shared\Values\r := d
set()
