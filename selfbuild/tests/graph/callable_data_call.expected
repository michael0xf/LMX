---
    Observed:
        int: seen 2
    end: Observed
---
@: shared (data [] 0)
fn: f () int (
    Point:
        int: n 0
        :=: (data \ n) ((data \ n) + 1)
    end: Point
)
    call: Point
    call: Point
    return: (Point \ n)
end: f
int: seen (f)
sub: main ()
    :=: ((shared \ Observed) \ seen) seen
end: main
main:
