+  base(sh,`LMX / ${language}`,`${rows.length} сценария · 23 ноября 2026 · размер кода, не скорость`,
+    ['ID','Сценарий','LMX\nсимволы',`${language}\nсимволы`,'Контроль /\nLMX','LMX\nстроки',`${language}\nстроки`,'Граница'],[10,56,14,15,16,13,14,20]);
