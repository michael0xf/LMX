+          "width": 8
+        },
+        {
+          "kind": 2,
+          "text": "c",
+          "width": 12
+        }
+      ]
+    ],
+    [
+      1,
+      [
+        {
+          "kind": 1,
+          "text": "b",
+          "width": 4
+        }
+      ]
+    ]
+  ]
+}
