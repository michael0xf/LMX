---
    Observed:
        int: hits 9
        int: after_bare 5
        int: after_put 9
    end: Observed
---
int: hits 9
sub: bare (int: v)
    :=: hits v
end: bare
sub: put (int: v)
    :=: (node \ hits) v
end: put
bare: 5
int: after_bare hits
put: 9
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ hits) (node \ hits)
    :=: ((shared \ Observed) \ after_bare) after_bare
    :=: ((shared \ Observed) \ after_put) (node \ hits)
end: main
main:
