# Explicit Frame calls on a path can appear in each operand of `+`, `*`, and comparison.
# Holder's field `fn: tick` refers to the unit's tick. Selecting tick runs nothing of Holder.
# v is 1 + 10, w 2 * 2, the
# third call gives 3: tick runs three times, Holder never: exit 7; 81 Holder ran, 82 a wrong count, 83 a wrong value.
int: hits 0
int: seen 0
fn: tick () int
    node\hits: node\hits + 1
    return: node\hits
end: tick
fn: bump () int
    node\seen: node\seen + 1
    return: 0
end: bump
fn: count () int
    return: node\hits
end: count
fn: saw () int
    return: node\seen
end: saw
Holder:
    fn: tick
    bump()
end: Holder
fn: run () int
    int: v Holder\tick() + 10
    int: w 0
    w: Holder\tick() * 2
    int: z 0
    if: Holder\tick() = 3
        z: 1
    if: saw() != 0
        return: 81
    if: count() != 3
        return: 82
    if: v != 11 || w != 4 || z != 1
        return: 83
    return: 7
end: run
sendMessage: exit(exit_code: run(); stdout: ""; stderr: "")
return
