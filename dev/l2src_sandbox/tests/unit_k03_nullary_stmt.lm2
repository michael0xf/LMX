# K03 (the author, 2026-10-06; docs/LMX_semantics.en.md#resolved-head-consumption): a bare resolved head and its empty
# application are one application -- `break` and `break()`, `continue` and `continue()`, a callable's call bare and as
# `tick()`, a named Structure run bare and as `Model()`, `return` and `return()` in a sub -- through one consumer,
# natively and walked.  The ticks: 1 + 1 + 10 + 10 + 100 + 100; the loops: 1 + 3 + 5, then 3.  Entry 7.
int: ticks 0
Model:
    size_t: x 1U
end: Model
fn: tick () int
    node\ticks: node\ticks + 1
    return: 1
end: tick
sub: quit ()
    node\ticks: node\ticks + 10
    return
end: quit
sub: quit2 ()
    node\ticks: node\ticks + 100
    return()
end: quit2
fn: loops () int
    int: i 0
    int: s 0
    while: i < 10
        i: i + 1
        if: i = 2
            continue()
        if: i = 4
            continue
        if: i = 6
            break()
        s: s + i
    ---
    int: j 0
    while: j < 10
        j: j + 1
        if: j = 3
            break
    ---
    return: s + j
end: loops
fn: check () int
    int: r 0
    tick
    tick()
    Model
    Model()
    quit
    quit()
    quit2
    quit2()
    r: loops()
    if: node\ticks != 222
        return: 81
    if: r != 12
        return: 82
    return: 7
end: check
sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
