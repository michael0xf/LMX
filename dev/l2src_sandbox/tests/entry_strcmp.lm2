# An argument compared through the c.* door. The letter holds "ok" at exact
# len 2, no NUL. c.strcmp still wants a C string; this row stays root-pending
# because that call is outside a method (Q7). The door copy is not this slice.
MainLetter:
    char: []: []: mainArgs
end: MainLetter

MainLetter: m
receiveMessage: m
if: length(m\mainArgs) != 2
    sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
    return
if: length(m\mainArgs[1]) != 2
    sendMessage: exit(exit_code: 2; stdout: ""; stderr: "")
    return
if: m\mainArgs[1][0] != 111 || m\mainArgs[1][1] != 107
    sendMessage: exit(exit_code: 3; stdout: ""; stderr: "")
    return
if: c.strcmp(@ m\mainArgs[1][0], "ok") != 0
    sendMessage: exit(exit_code: 4; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
