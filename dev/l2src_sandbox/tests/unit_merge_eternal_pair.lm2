# FABLE-OPUS-MERGE-PARTS-20260926-193 T1: the author's merge rule (plan §4) on qualified (eternal)
# operands. FrozenA and FrozenB share the typed `value` slot; the later value
# replaces the earlier one by address. The later operand supplies the selected
# executable body, so R has two slots: the coalesced value and that body's
# operation. The model's overwritten cell is not the selected value. Success is 2.
independent:
    const:
        immutable:
            (): FrozenA
                size_t: value 1U
            end: FrozenA
        end: immutable
    end: const
end: independent

independent:
    const:
        immutable:
            (): FrozenB
                size_t: value 2U
            end: FrozenB
        end: immutable
    end: const
end: independent

fn: m () int
    size_t: v
    R: merge: FrozenA FrozenB
    v: R\value
    return: (cast: (int) v)
end: m

sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
