predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_clock.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_gc.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# Ticket 20260919-113000: parent-liveness handshake on ONE size_t alive TIME stamp.
# Scenarios: (1) parent answered -> child continues and writes a new stamp;
# (2) parent silent -> child closes itself. Optional: parent emergency on stale stamp.

sub: ps_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: ps_check

# Minimal Thread: Message + Post + Schedule.  The schedule names the same arena and exact owner
# as the Thread; each probe Thread therefore gets its own arena so its end-turn collection cannot
# sweep another probe's records.
fn: ps_make (@: LmxArena arena; @@: LmxThread out_t; @@: LmxMsg out_m; @@: LmxSchedule out_s; ulong: limit) int
    @: LmxThread t
    @: LmxMsg message
    @: Lmx graph
    @: LmxArrayDesc children
    @: LmxPost mail
    @: LmxSchedule slot
    \out_t: 0
    \out_m: 0
    \out_s: 0
    graph: lmx_node_new_owned(arena)
    children: lmx_array_grow_ref_new_owned(c.LMX_TYPE_ARRAY_OF_POINTER_BASE + c.LMX_DOMAIN_THREAD, arena)
    t: (cast: (@: LmxThread) lmx_arena_take(arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD))
    message: (cast: (@: LmxMsg) t)
    mail: (cast: (@: LmxPost) lmx_arena_take(arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    slot: (cast: (@: LmxSchedule) lmx_arena_take(arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: graph = 0 || children = 0 || t = 0 || mail = 0 || slot = 0
        return: 0
    ---
    if: lmx_arena_refs_open_owned(arena, graph, 1U) != 0 || lmx_arena_ref_store(graph, 0U, (cast: (@: void) children)) != 0 || lmx_post_init(arena, mail) != c.LMX_POST_OK
        return: 0
    ---
    if: lmx_schedule_init(slot, arena, (cast: (@: void) t), limit) != c.LMX_SCHEDULE_OK
        return: 0
    ---
    if: lmx_thread_init(arena, t, graph, mail, slot) != c.LMX_THREAD_OK || lmx_thread_children_bind(t, children, arena) != c.LMX_THREAD_OK
        return: 0
    ---
    \out_t: t
    \out_m: message
    \out_s: slot
return: 1

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    # The physical child references are cells of the PARENT's graph Array.  Each Thread's own
    # record, mailbox and schedule stay in that Thread's arena.
    LmxArena: parent_arena
    LmxArena: child_arena
    LmxArena: silent_arena
    @: LmxThread parent 0
    @: LmxThread child 0
    @: LmxThread silent 0
    @: LmxMsg parent_m 0
    @: LmxMsg child_m 0
    @: LmxMsg silent_m 0
    @: LmxSchedule parent_s 0
    @: LmxSchedule child_s 0
    @: LmxSchedule silent_s 0
    size_t: mark
    size_t: mark2
    ulong: planted
    ulong: asked
    int: failures
    if: counts = 0
        return: 2
    ---
    memset((cast: (@: void) (@ parent_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ child_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ silent_arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ parent_arena) != 0 || lmx_arena_open(@ child_arena) != 0 || lmx_arena_open(@ silent_arena) != 0
        free(counts)
        return: 2
    ---

    # --- 1. parent answered -> child continues and writes new stamp ---
    ps_check(counts, ps_make(@ parent_arena, @ parent, @ parent_m, @ parent_s, 3600000U) != 0, "make parent")
    ps_check(counts, ps_make(@ child_arena, @ child, @ child_m, @ child_s, 3600000U) != 0, "make child")
    # THE LINK COMES FIRST, and that is the model, not bookkeeping: the handshake word lives in the
    # PARENT's arena (a Thread's own record carries no such cell), so a child that is nobody's
    # child yet has no word to stamp.  Linking is what gives it one (Mikhail, 19.09).
    ps_check(counts, lmx_thread_child_add(parent, child, @ parent_arena) = c.LMX_THREAD_OK, "link child")
    ps_check(counts, c.__atomic_load_n(lmx_thread_alive_cell(child), c.__ATOMIC_RELAXED) = 0U, "alive starts at 0")
    ps_check(counts, lmx_turn_end(child, lmx_clock_ticks()) = c.LMX_TURN_OK, "child turn_end writes stamp")
    mark: c.__atomic_load_n(lmx_thread_alive_cell(child), c.__ATOMIC_RELAXED)
    ps_check(counts, mark != 0U, "child wrote non-zero time stamp")
    ps_check(counts, child_m\running = 1, "child still running after first stamp")

    ps_check(counts, lmx_poll_answer_children(parent, lmx_clock_ticks()) = c.LMX_THREAD_OK, "parent answer (zero)")
    mark: c.__atomic_load_n(lmx_thread_alive_cell(child), c.__ATOMIC_RELAXED)
    ps_check(counts, mark = 0U, "parent zeroed alive (ANSWER)")
    ps_check(counts, child_m\running = 1, "answered child not closed")

    ps_check(counts, lmx_turn_end(child, lmx_clock_ticks()) = c.LMX_TURN_OK, "child turn_end after answer")
    mark2: c.__atomic_load_n(lmx_thread_alive_cell(child), c.__ATOMIC_RELAXED)
    ps_check(counts, mark2 != 0U, "child wrote new stamp after parent answer")
    ps_check(counts, child_m\running = 1, "child continues after answered handshake")

    # --- 2. parent silent -> child closes itself ---
    # Plant a stale stamp (now - 100) with limit=1 so (now - stamp) >= limit.
    child_s\limit: 1U
    planted: lmx_clock_ticks() - 100U
    if: planted = 0U
        planted: 1U
    ---
    c.__atomic_store_n(lmx_thread_alive_cell(child), (cast: (size_t) planted), c.__ATOMIC_RELAXED)
    child_m\running: 1
    child_m\handoff_ready: 0
    ps_check(counts, lmx_turn_end(child, lmx_clock_ticks()) = c.LMX_TURN_OK, "child turn_end self-close")
    ps_check(counts, child_m\running = 0, "child self-closed running (parent silent)")
    ps_check(counts, child_m\handoff_ready = 1, "child self-closed handoff_ready")

    # --- 3. parent emergency: stale stamp -> parent closes (not zero-kill) ---
    ps_check(counts, ps_make(@ silent_arena, @ silent, @ silent_m, @ silent_s, 1U) != 0, "make silent child")
    ps_check(counts, lmx_thread_child_add(parent, silent, @ parent_arena) = c.LMX_THREAD_OK, "link silent")
    planted: lmx_clock_ticks() - 100U
    if: planted = 0U
        planted: 1U
    ---
    c.__atomic_store_n(lmx_thread_alive_cell(silent), (cast: (size_t) planted), c.__ATOMIC_RELAXED)
    silent_s\limit: 1U
    asked: lmx_clock_ticks()
    ps_check(counts, lmx_poll_answer_children(parent, asked) = c.LMX_THREAD_OK, "parent emergency pass")
    ps_check(counts, silent_m\running = 0, "stale child closed by parent emergency")
    # THE ASK, NOT THE CLOSE (19.09): the stale branch is a REQUESTER like the cascade -- it writes
    # `running=0` and the moment of the first ask into the parent's node, and the mark comes when
    # that ask has outlived the child's own window (1U here).  The inbox is not the test any more:
    # a stopped Message does not wait for letters, and the box was measured deciding a lifecycle
    # (tests\lmx_app_poll_stale_selftest.lm1, run 1 vs run 2).
    ps_check(counts, silent_m\handoff_ready = 0, "the emergency pass wrote the mark instead of asking")
    ps_check(counts, lmx_poll_answer_children(parent, asked + 2U) = c.LMX_THREAD_OK, "the pass a window later refused")
    ps_check(counts, silent_m\running = 0 && silent_m\handoff_ready != 0, "a child that reached no boundary within its window was not closed")

    failures: counts[1]
    c.printf("lmx_poll_selftest: checks=%d failures=%d\n", counts[0], failures)
    free(counts)
    if: failures != 0
        return: 1
    ---
return: 0
