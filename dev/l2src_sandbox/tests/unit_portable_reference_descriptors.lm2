# Both descriptive signature spellings receive the same Structure reference.
# Addressing the formal selects its own callee place, not the caller's slot or
# the transient ABI transport box. A unary @ on the actual would add a level.
Model:
    int: value 7
end: Model
fn: first (Model: item) int
    @: void flat @item
    @: void frame (@: item)
    if: flat = 0 || frame != flat || flat = @Model || item\value != 7
        return: 81
return: 7
fn: second (@: Model item) int
    if: @item = 0 || @item = @Model || (@: item) != @item || item\value != 7
        return: 82
return: 7
int: result first(Model)
if: result = 7
    result: second(Model)
end: if
sendMessage: exit(exit_code: result; stdout: ""; stderr: "")
return
