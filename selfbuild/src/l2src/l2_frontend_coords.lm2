    if: nsf_val_cell[0][row] != 0U
        if: nsf_val_cell[0][row] > (cast: (size_t) ns_n_cell[0])
            return: (cast: (int) (-1))
        return: (cast: (int) ((cast: (int) nsf_val_cell[0][row]) - 1))
    if: nsf_owner_cell[0] = 0 || ns_proc_cell[0] = 0
        return: (cast: (int) (-1))
    owner: ns_proc_cell[0][nsf_owner_cell[0][row]]
    # A source-owned field already resolved its declared model at its own
    # declaration. A later caller's visibility cannot reinterpret that name.
    if: c.lm_compiler_ns_source_body(nsf_owner_cell[0][row]) != 0
        while: own < own_n_cell[0]
            if: own_mi_cell[0][own] = owner && own_decl_cell[0][own] = nsf_source_cell[0][row]
                return: (cast: (int) (c.lm_compiler_own_nsty_get(own)))
            own: own + 1
        ---
        return: (cast: (int) (-1))
    ---
    if: nsf_name_cell[0] = 0 || nsf_name_cell[0][row] = 0 || ns_name_cell[0] = 0
        return: (cast: (int) (-1))
    return: (cast: (int) (c.lm_compiler_ns_find(nsf_name_cell[0][row])))
end: lm_compiler_nsf_pointee

fn: lm_compiler_ns_ref_pointee (int: ni; const: (@: pd char); size_t: off; size_t: len) int
    return: (cast: (int) (lm_compiler_nsf_pointee(lm_compiler_ns_named_row(ni, pd, off, len, 0, 0))))
end: lm_compiler_ns_ref_pointee

fn: lm_compiler_field_pointee (int: ns; int: own; const: (@: pd char); size_t: off; size_t: len) int
    if: own >= 0
        return: (cast: (int) (c.lm_compiler_own_nsty_get(own)))
    return: (cast: (int) (lm_compiler_ns_ref_pointee(ns, pd, off, len)))
end: lm_compiler_field_pointee

fn: lm_compiler_mrs_slot_named (int: res; const: (@: pd char); size_t: off; size_t: len; @: out_kind int; @: out_ent int) int
    @: mrs_n_cell int (cast: (@: int) (@ c.l2_mrs_n))
    @@: mrs_res_cell int (cast: (@@: int) (@ c.l2_mrs_res))
    @@@: mrs_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_mrs_name))
    @@: mrs_kind_cell int (cast: (@@: int) (@ c.l2_mrs_kind))
    @@: mrs_ent_cell int (cast: (@@: int) (@ c.l2_mrs_ent))
    int: k 0
    int: slotix 0
    int: hit 0 - 1
    int: occurrence 0 - 1
    int: seen 0
    size_t: noff off
    size_t: nlen len
    if: c.lm_compiler_seg_split(pd, off, len, @ occurrence, @ noff, @ nlen) != 0
        return: (cast: (int) (0 - 1))
    while: k < mrs_n_cell[0]
        if: mrs_res_cell[0][k] = res && c.lm_compiler_name_is_seg(mrs_name_cell[0][k], pd, noff, nlen) != 0
            if: occurrence < 0
                hit: slotix
                \out_kind: mrs_kind_cell[0][k]
                \out_ent: mrs_ent_cell[0][k]
            else:
                if: seen = occurrence
                    \out_kind: mrs_kind_cell[0][k]
                    \out_ent: mrs_ent_cell[0][k]
                    return: (cast: (int) (slotix))
                seen: seen + 1
            ---
        ---
        if: mrs_res_cell[0][k] = res
            slotix: slotix + 1
        k: k + 1
    ---
    return: (cast: (int) (hit))
end: lm_compiler_mrs_slot_named

fn: lm_compiler_mrs_slot_row (int: res; int: slot) int
    @: mrs_n_cell int (cast: (@: int) (@ c.l2_mrs_n))
    @@: mrs_res_cell int (cast: (@@: int) (@ c.l2_mrs_res))
    @@: mrs_row_cell int (cast: (@@: int) (@ c.l2_mrs_row))
    int: k 0
    int: slotix 0
    if: res < 0 || slot < 0
        return: (cast: (int) (-1))
    while: k < mrs_n_cell[0]
        if: mrs_res_cell[0][k] = res
            if: slotix = slot
                return: (cast: (int) (mrs_row_cell[0][k]))
            slotix: slotix + 1
        ---
        k: k + 1
    ---
    return: (cast: (int) (-1))
end: lm_compiler_mrs_slot_row

fn: lm_compiler_mrs_ref_pointee (int: res; int: slot) int
    return: (cast: (int) (lm_compiler_nsf_pointee(lm_compiler_mrs_slot_row(res, slot))))
end: lm_compiler_mrs_ref_pointee

fn: lm_compiler_mrs_slot_nth (int: res; const: (@: name c.LmP0Text); int: occ; @: out_kind int; @: out_ent int) int
    @: mrs_n_cell int (cast: (@: int) (@ c.l2_mrs_n))
    @@: mrs_res_cell int (cast: (@@: int) (@ c.l2_mrs_res))
    @@@: mrs_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_mrs_name))
    @@: mrs_kind_cell int (cast: (@@: int) (@ c.l2_mrs_kind))
    @@: mrs_ent_cell int (cast: (@@: int) (@ c.l2_mrs_ent))
    int: k 0
    int: slotix 0
    int: seen 0
    if: name = 0 || out_kind = 0 || out_ent = 0 || occ < 0
        return: (cast: (int) (0 - 1))
    while: k < mrs_n_cell[0]
        if: mrs_res_cell[0][k] = res && c.lm_compiler_name_is_seg(mrs_name_cell[0][k], name\data, 0U, name\length) != 0 && seen = occ
            \out_kind: mrs_kind_cell[0][k]
            \out_ent: mrs_ent_cell[0][k]
            return: (cast: (int) (slotix))
        if: mrs_res_cell[0][k] = res && c.lm_compiler_name_is_seg(mrs_name_cell[0][k], name\data, 0U, name\length) != 0
            seen: seen + 1
        if: mrs_res_cell[0][k] = res
            slotix: slotix + 1
        k: k + 1
    ---
    return: (cast: (int) (0 - 1))
end: lm_compiler_mrs_slot_nth

fn: lm_compiler_path_selected_binding_ft (const: (@: path c.L2Path); int: mi) int
    @: m_n_cell int (cast: (@: int) (@ c.l2_m_n))
    @@: own_ty_cell int (cast: (@@: int) (@ c.l2_own_ty))
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@: m_arity_cell int (cast: (@@: int) (@ c.l2_m_arity))
    @@: m_dyn_cell int (cast: (@@: int) (@ c.l2_m_dyn))
    @@@: m_ft_cell int (cast: (@@@: int) (@ c.l2_m_ft))
    @: ml_n_cell int (cast: (@: int) (@ c.l2_ml_n))
    @@: ml_ty_cell int (cast: (@@: int) (@ c.l2_ml_ty))
    @@: m_sn_cell int (cast: (@@: int) (@ c.l2_m_sn))
    @@: st_cell int (cast: (@@: int) (@ c.l2_st))
    if: path = 0 || mi < 0 || mi >= m_n_cell[0]
        return: (cast: (int) (-1))
    if: path\oi >= 0
        if: own_ty_cell[0] = 0 || path\oi >= own_n_cell[0]
            return: (cast: (int) (-1))
        return: (cast: (int) (c.lm_compiler_value_ft_of_own(own_ty_cell[0][path\oi])))
    if: path\fi >= 0 && path\fi < m_arity_cell[0][mi] + m_dyn_cell[0][mi]
        # A schema-only binding can have no primitive FT row. Unknown
        # stays unknown;its declared schema still proves field steps.
        if: path\fi < m_arity_cell[0][mi] && (m_ft_cell[0] = 0 || m_ft_cell[0][mi] = 0)
            return: (cast: (int) (-1))
        if: path\fi >= m_arity_cell[0][mi] && c.lm_compiler_dt(mi, path\fi - m_arity_cell[0][mi]) = 0
            return: (cast: (int) (-1))
        return: (cast: (int) (c.lm_compiler_input_ft(mi, path\fi)))
    ---
    if: path\root_kind = 4 && path\root >= 0 && path\root < ml_n_cell[0] && ml_ty_cell[0] != 0
        return: (cast: (int) (c.lm_compiler_ml_value_ty(path\root)))
    if: path\root_kind = 5 && path\root >= 0 && m_sn_cell[0] != 0 && path\root < m_sn_cell[0][mi] && st_cell[0] != 0
        return: (cast: (int) (st_cell[0][c.lm_compiler_slot_off(mi, path\root)]))
    return: (cast: (int) (-1))
end: lm_compiler_path_selected_binding_ft

fn: lm_compiler_source_field_project (int: mi; const: (@: scope c.LmP0Node); int: own; int: ns; int: ordinal) int
    @: construct_phase_cell int (cast: (@: int) (@ c.l2_construct_phase))
    @: e_cell int (cast: (@: int) (@ c.l2_e))
    @@@: ns_at_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_ns_at))
    @@: ns_parent_cell int (cast: (@@: int) (@ c.l2_ns_parent))
    int: parent c.lm_compiler_m_nsof(mi)
    if: own >= 0
        return: (cast: (int) (lm_compiler_graph_field_child(own)))
    if: ns < 0
        return: (cast: (int) (0 - 1))
    if: construct_phase_cell[0] = 0
        return: (cast: (int) (ordinal))
    if: mi = e_cell[0] && scope = 0
        return: (cast: (int) (lm_compiler_source_unit_slot(ns_at_cell[0][ns])))
    if: parent < 0 || ns_parent_cell[0][ns] != parent
        return: (cast: (int) (0 - 1))
    return: (cast: (int) (lm_compiler_ns_field_in_parent(ns)))
end: lm_compiler_source_field_project

fn: lm_compiler_method_in_eternal (int: mi) int
    @@: ns_eternal_cell int (cast: (@@: int) (@ c.l2_ns_eternal))
    int: ni
    int: links
    while: mi >= 0
        ni: c.lm_compiler_m_nsof(mi)
        # A saved method's own cells are part of the qualified graph as well.
        # Follow the same lexical occurrence chain as every other declaration;
        # a method boundary does not exempt its future writes from immutable.
        if: ni >= 0 && ns_eternal_cell[0][ni] >= 0
            return: (cast: (int) (1))
        mi: lm_compiler_lex_parent(mi, @ links)
    ---
    return: (cast: (int) (0))
end: lm_compiler_method_in_eternal

fn: lm_compiler_own_in_eternal (int: own) int
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    if: own < 0 || own >= own_n_cell[0]
        return: (cast: (int) (0))
    return: (cast: (int) (lm_compiler_method_in_eternal(own_mi_cell[0][own])))
end: lm_compiler_own_in_eternal

fn: lm_compiler_path_step_slot (const: (@: step c.L2PathStep)) int
    if: step = 0
        return: (cast: (int) (0 - 1))
    if: step\locus = 1
        return: (cast: (int) (lm_compiler_nsf_slot((cast: (int) (step\row)))))
    if: step\locus = 2 || step\locus = 5
        return: (cast: (int) (step\row))
    if: step\locus = 3
        return: (cast: (int) (lm_compiler_graph_field_child((cast: (int) (step\own)))))
    if: step\locus = 4
        return: (cast: (int) (0))
    if: step\locus = 6
        if: step\own < 0 && step\ns < 0 && step\formal >= 0
            return: (cast: (int) (lm_compiler_madc_formal_slot((cast: (int) (step\node_host)), (cast: (int) (step\formal)))))
        return: (cast: (int) (lm_compiler_source_field_project((cast: (int) (step\node_host)), (cast: (const: @: c.LmP0Node) (step\node_scope)), (cast: (int) (step\own)), (cast: (int) (step\ns)), (cast: (int) (step\row)))))
    ---
    return: (cast: (int) (0 - 1))
end: lm_compiler_path_step_slot

fn: lm_compiler_path_callee_rec (const: (@: path c.L2Path)) int
    @: ns_n_cell int (cast: (@: int) (@ c.l2_ns_n))
    @@: ns_proc_cell int (cast: (@@: int) (@ c.l2_ns_proc))
    @: e_cell int (cast: (@: int) (@ c.l2_e))
    @: step c.L2PathStep
    int: k 0 - 1
    if: path = 0 || path\n < 1 || path\fail_why != 0
        return: (cast: (int) (0 - 1))
    # A selected input is the value admitted to that place, just as a root
    # input is. Its receiving Structure is not a callable source. Read the
    # same callable-input contract as the root classifier, never ns_proc of
    # the Model used only to type the place.
    step: path\steps + (path\n - 1)
    if: step\formal >= 0 && step\node_host >= 0
        return: (cast: (int) (lm_compiler_cf_get((cast: (int) (step\node_host)), (cast: (int) (step\formal)))))
    if: path\leaf_kind = 4
        k: path\leaf_mi
    if: (path\leaf_kind = 2 || path\leaf_kind = 3) && path\leaf_model >= 0 && path\leaf_model < ns_n_cell[0]
        k: ns_proc_cell[0][path\leaf_model]
    if: k < 0 || k = e_cell[0]
        return: (cast: (int) (0 - 1))
    return: (cast: (int) (k))
end: lm_compiler_path_callee_rec

fn: lm_compiler_path_callable_value_rec (const: (@: path c.L2Path)) int
    const: (@: step c.L2PathStep)
    if: path = 0 || path\n < 1 || path\steps = 0 || path\fail_why != 0
        return: (cast: (int) (-1))
    step: path\steps + (path\n - 1)
    if: path\leaf_kind != 4 && (step\formal < 0 || step\node_host < 0)
        return: (cast: (int) (-1))
    return: (cast: (int) (lm_compiler_path_callee_rec(path)))
end: lm_compiler_path_callable_value_rec

fn: lm_compiler_split_rep (int: k) int
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    @@@: own_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_own_name))
    int: j 0
    int: best k
    if: lm_compiler_split_data_row(k) = 0
        return: (cast: (int) (k))
    while: j < own_n_cell[0]
        if: j != best && own_mi_cell[0][j] = own_mi_cell[0][k] && c.lm_compiler_text_same(own_name_cell[0][j], own_name_cell[0][k]) != 0 && lm_compiler_split_data_row(j) != 0 && c.lm_compiler_own_source_after(best, j) != 0
            best: j
        j: j + 1
    ---
    return: (cast: (int) (best))
end: lm_compiler_split_rep

fn: lm_compiler_split_name_ix (int: k) int
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    int: r lm_compiler_split_rep(k)
    int: j 0
    int: ix 0
    if: lm_compiler_split_data_row(k) = 0
        return: (cast: (int) (0 - 1))
    while: j < own_n_cell[0]
        if: j != r && own_mi_cell[0][j] = own_mi_cell[0][r] && lm_compiler_split_data_row(j) != 0 && lm_compiler_split_rep(j) = j && c.lm_compiler_own_source_after(r, j) != 0
            ix: ix + 1
        j: j + 1
    ---
    return: (cast: (int) (ix))
end: lm_compiler_split_name_ix

fn: lm_compiler_m_is_place (int: mi) int
    @: m_split_n_cell int (cast: (@: int) (@ c.l2_m_split_n))
    @@: m_place_cell int (cast: (@@: int) (@ c.l2_m_place))
    if: mi < 0 || mi >= m_split_n_cell[0] || m_place_cell[0] = 0
        return: (cast: (int) (0))
    return: (cast: (int) (m_place_cell[0][mi]))
end: lm_compiler_m_is_place

fn: lm_compiler_anc_row (int: m; const: (@: nm c.LmP0Text)) int
    @: anc_n_cell int (cast: (@: int) (@ c.l2_anc_n))
    @@: anc_m_cell int (cast: (@@: int) (@ c.l2_anc_m))
    @@@: anc_nm_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_anc_nm))
    int: r 0
    if: nm = 0
        return: (cast: (int) (0 - 1))
    while: r < anc_n_cell[0]
        if: anc_m_cell[0][r] = m && c.lm_compiler_text_same(anc_nm_cell[0][r], nm) != 0
            return: (cast: (int) (r))
        r: r + 1
    ---
    return: (cast: (int) (0 - 1))
end: lm_compiler_anc_row

fn: lm_compiler_anchor_of (int: m; const: (@: nm c.LmP0Text)) int
    @: anc_on_cell int (cast: (@: int) (@ c.l2_anc_on))
    @@: anc_ns_cell int (cast: (@@: int) (@ c.l2_anc_ns))
    int: r
    if: anc_on_cell[0] = 0
        return: (cast: (int) (0 - 1))
    r: lm_compiler_anc_row(m, nm)
    if: r < 0 || anc_ns_cell[0][r] < 0
        return: (cast: (int) (0 - 1))
    return: (cast: (int) (anc_ns_cell[0][r]))
end: lm_compiler_anchor_of

fn: lm_compiler_lex_parent (int: mi; @: links int) int
    @: m_n_cell int (cast: (@: int) (@ c.l2_m_n))
    @: e_cell int (cast: (@: int) (@ c.l2_e))
    @@@: m_node_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_m_node))
    @@: ns_local_cell int (cast: (@@: int) (@ c.l2_ns_local))
    @@: ns_parent_cell int (cast: (@@: int) (@ c.l2_ns_parent))
    @@: ns_proc_cell int (cast: (@@: int) (@ c.l2_ns_proc))
    @@: ns_eternal_cell int (cast: (@@: int) (@ c.l2_ns_eternal))
    @@: part_ns_cell int (cast: (@@: int) (@ c.l2_part_ns))
    int: ni
    int: part
    @: owner c.L2SourceContainer 0
    @: field c.L2SourceField
    @: place c.L2GraphPlace
    \links: 1
    if: mi < 0 || mi >= m_n_cell[0] || mi = e_cell[0]
        return: (cast: (int) (-1))
    ni: c.lm_compiler_m_nsof(mi)
    if: ni < 0 && c.lm_compiler_method_source_own(mi) >= 0
        field: lm_compiler_source_definition_node_field(m_node_cell[0][mi], 0, -1, @ owner)
        if: field = 0 || owner = 0
            # The declared enclosing callable is already an exact lexical
            # owner. A missing source-field projection cannot erase it.
            if: c.lm_compiler_mad_host_of(mi) >= 0
                return: (cast: (int) (c.lm_compiler_mad_host_of(mi)))
            ---
            return: (cast: (int) (-2))
        place: owner\place
        while: place != 0
            if: \links = c.INT_MAX
                return: (cast: (int) (-2))
            \links: \links + 1
            place: place\parent
        ---
        return: (cast: (int) (owner\source_mi))
    ---
    if: ni >= 0
        if: ns_local_cell[0][ni] >= 0
            field: lm_compiler_source_definition_field(ni, 0, -1, @ owner)
            if: field = 0 || owner = 0
                return: (cast: (int) (-2))
            place: owner\place
            while: place != 0
                if: \links = c.INT_MAX
                    return: (cast: (int) (-2))
                \links: \links + 1
                place: place\parent
            ---
            return: (cast: (int) (owner\source_mi))
        ---
        if: ns_parent_cell[0][ni] >= 0
            return: (cast: (int) (ns_proc_cell[0][ns_parent_cell[0][ni]]))
        if: ns_eternal_cell[0][ni] >= 0
            return: (cast: (int) (-1))
        return: (cast: (int) (e_cell[0]))
    ---
    if: c.lm_compiler_mad_host_of(mi) >= 0
        return: (cast: (int) (c.lm_compiler_mad_host_of(mi)))
    part: c.lm_compiler_m_part(mi)
    if: part >= 0 && part_ns_cell[0][part] >= 0
        return: (cast: (int) (ns_proc_cell[0][part_ns_cell[0][part]]))
    return: (cast: (int) (e_cell[0]))
end: lm_compiler_lex_parent

fn: lm_compiler_lex_depth_at (int: mi; int: ancestor; int: committed) int
    @: m_n_cell int (cast: (@: int) (@ c.l2_m_n))
    @@: ns_local_cell int (cast: (@@: int) (@ c.l2_ns_local))
    int: depth 0
    int: links
    int: steps 0
    while: mi >= 0 && mi < m_n_cell[0] && steps <= m_n_cell[0]
        if: mi = ancestor
            return: (cast: (int) (depth))
        # Local source-container links do not exist before PLACE. They are
        # deferred, never silently counted as one link or a global unit.
        if: committed = 0 && ((c.lm_compiler_m_nsof(mi) >= 0 && ns_local_cell[0][c.lm_compiler_m_nsof(mi)] >= 0) || c.lm_compiler_method_source_own(mi) >= 0)
            return: (cast: (int) (-2))
        mi: lm_compiler_lex_parent(mi, @ links)
        if: depth > c.INT_MAX - links
            return: (cast: (int) (-2))
        depth: depth + links
        steps: steps + 1
    ---
    if: mi = -1
        return: (cast: (int) (-1))
    return: (cast: (int) (-2))
end: lm_compiler_lex_depth_at

fn: lm_compiler_lex_depth (int: mi; int: ancestor) int
    return: (cast: (int) (lm_compiler_lex_depth_at(mi, ancestor, 1)))
end: lm_compiler_lex_depth

fn: lm_compiler_cf_get (int: omi; int: fk) int
    @: cf_n_cell int (cast: (@: int) (@ c.l2_cf_n))
    @@: cf_omi_cell int (cast: (@@: int) (@ c.l2_cf_omi))
    @@: cf_fk_cell int (cast: (@@: int) (@ c.l2_cf_fk))
    @@: cf_req_cell int (cast: (@@: int) (@ c.l2_cf_req))
    int: i 0
    if: omi < 0 || fk < 0
        return: (cast: (int) (0 - 1))
    while: i < cf_n_cell[0]
        if: cf_omi_cell[0][i] = omi && cf_fk_cell[0][i] = fk
            return: (cast: (int) (cf_req_cell[0][i]))
        i: i + 1
    ---
    return: (cast: (int) (0 - 1))
end: lm_compiler_cf_get

fn: lm_compiler_m_machine (int: i) int
    @: m_n_cell int (cast: (@: int) (@ c.l2_m_n))
    @: e_cell int (cast: (@: int) (@ c.l2_e))
    @@@: m_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_m_name))
    @@@: m_node_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_m_node))
    @@@: m_body_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_m_body))
    const: (@: unit c.LmP0Structure)
    @: f c.LmP0Field 0
    int: root 0
    if: i < 0 || i >= m_n_cell[0] || i = e_cell[0] || lm_compiler_machine_module() = 0 || m_name_cell[0][i] = 0 || m_node_cell[0][i] = 0 || m_body_cell[0][i] = 0 || c.lm_compiler_m_nsof(i) >= 0 || c.lm_compiler_mad_host_of(i) >= 0
        return: (cast: (int) (0))
    unit: lm_compiler_method_source_unit(i)
    if: unit = 0
        return: 0
    # The already selected root os branch contributes methods to the same unit.
    # Use its existing identity projection, not a new name/ABI/platform exception.
    if: lm_compiler_method_in_os(i) != 0
        return: (cast: (int) (1))
    f: c.lm_compiler_next_active((cast: (@: c.LmP0Field) unit\first_field))
    while: f != 0 && root = 0
        if: f\value = m_node_cell[0][i]
            root: 1
        f: c.lm_compiler_next_active(f\next)
    ---
    return: (cast: (int) (root))
end: lm_compiler_m_machine

fn: lm_compiler_machine_module () int
    @: library_mode_cell int (cast: (@: int) (@ c.l2_library_mode))
    @: machine_n_cell int (cast: (@: int) (@ c.l2_machine_n))
    const: (@@: construct_name_cell char (cast: (const: @@: char) (@ c.l2_construct_name)))
    return: (cast: (int) ((cast: (int) (library_mode_cell[0] != 0 && machine_n_cell[0] > 0 && construct_name_cell[0] = 0))))
