# A parenthesized group of one type beside other operands is a value of that type: `(k + j) * 1U` over two size_t
# fields is 7, and a cast inside a group makes it one type: `((cast: (size_t) i) + j) * 1U` with an int i is 7.  Entry 7.
fn: m () size_t
    size_t: k 5U
    size_t: j 2U
    return: (k + j) * 1U
end: m
fn: n () size_t
    int: i 5
    size_t: j 2U
    return: ((cast: (size_t) i) + j) * 1U
end: n
size_t: a 0U
size_t: b 0U
a: m()
b: n()
int: code 0
if: a = 7U && b = 7U
    code: 7
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
