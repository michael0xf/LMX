FxTry:
    private:
        @: operation
        @: args
    return: @
    attempt:
        throws: copy(FxThrows\kernel)
        private: @: info FxKernel\signature(subject := operation)
        return: FxKernel\attempt(operation; args; info\throws)

FxTwo:
    private:
        @: first
        @: second
    return: @
    make:
        private: @: out (copy(()))
        sys\resize(out; 2)
        out[0] := first
        out[1] := second
        return: out

FxValueSame:
    private:
        @: first
        @: second
        @: same 0
    required: first second
    return: int
    test:
        throws: copy(FxThrows\predicate)
        if: same != 0
            return: FxSeqPredicate\truth(FxApply\apply(same; FxTwo\make(first; second)))
        private: int: firstArray FxKernel\acceptsRequirement(
            candidate := first;
            requirement := FxEqualityTypes\array[0]
        )
        private: int: secondArray FxKernel\acceptsRequirement(
            candidate := second;
            requirement := FxEqualityTypes\array[0]
        )
        if: firstArray != secondArray
            return: 0
        if: firstArray != 0
            return: FxEqualFields\equalFields(first; second)
        return: \first = \second
