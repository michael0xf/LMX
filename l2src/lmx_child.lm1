predef: "l2src/lmx_child.h.lm1"
predef: "l2src/lmx_service.lm1"
predef: "lmx_graph_copy_owned.lm1"
predef: "lmx_arena_refs.h.lm1"
predef: "lmx_implements.h.lm1"
predef: "l2src/lmx_pool.h.lm1"
include: "<stdlib.h>"

# Creating a child Message.  See the header for the contract; what is worth spelling out
# here is the ORDER, because the order is the whole guarantee:
#
#   mark the child's arena -> copy the used graph -> make the record.
#
# Every step can be taken back (the arena reverts to the mark), and the PUBLICATION is not
# here at all: it is the end-turn boundary's act (model 26, 28), so a child that a failing
# turn reserved is never seen by anyone.
#
# The gap note's item 3 is exactly this: before it, creation published immediately, and "до
# успешной публикации turn'а родителя ребёнок недоступен" was not true of the code.

fn: lmx_child_create (@: LmxArena src_arena; @: LmxArena child_arena; @: Lmx parent; size_t: slot; @: Lmx source) @: LmxMsg
    @: LmxArenaBlock mark
    @: Lmx graph 0
    @: LmxMsg message
    int: status
    if: src_arena = 0 || child_arena = 0 || parent = 0 || source = 0
        return: 0
    if: parent\data = 0 || parent\len <= 0
        return: 0
    if: slot >= (cast: (size_t) parent\len)
        return: 0
    ---
    mark: lmx_arena_mark(child_arena)
    # The used graph, into the CHILD's arena, classified by the source's.  The copier is
    # all-or-nothing over its own mark, and its blocks are the child arena's.
    status: lmx_graph_copy_owned(source, 0, src_arena, child_arena, @ graph)
    if: status != c.LMX_GRAPH_COPY_OK || graph = 0
        lmx_arena_revert(child_arena, mark)
        return: 0
    ---
    # The record itself is a cell of the child's arena, registered as a Message record --
    # a Message is found by its address, never by a tag on it.
    message: (cast: (@: LmxMsg) lmx_arena_take(child_arena, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
    if: message = 0
        lmx_arena_revert(child_arena, mark)
        return: 0
    ---
    # The five fields, and nothing else (the record is closed).  A child starts running
    # with success cleared, and it is NOT handoff-safe yet: its arena may not be attached
    # until it has left its last turn (model 32).
    message\running: 1
    message\success: 0
    message\handoff_ready: 0
    message\graph: graph
    # Its index at the parent: the counter starts at 1, so the child in slot 0 is index 1.
    message\index: (cast: (unsigned) slot) + 1U
    # NOTHING is published here, and the slot was checked above rather than written: the
    # parent's slot receives the child at the successful END of this turn
    # (lmx_child_publish_prepared).  Until then the child is reachable from the reservation
    # alone -- which is what "ребёнок не становится доступным до успешной публикации
    # родительского turn" means mechanically (model 26).
return: message

# Reserve a child in the turn that owns it: build it, then remember it in the turn's own list
# so the boundary can publish it or drop it.  The reservation node is a mechanism record of
# the parent's arena (under its own domain), and it carries the child's arena so that a drop
# releases exactly what the reservation created.
fn: lmx_child_reserve (@: LmxThread t; @: LmxArena src_arena; @: LmxArena child_arena; @: Lmx parent; size_t: slot; @: Lmx source) @: LmxMsg
    @: LmxReservation node
    @: LmxMsg message
    if: t = 0 || src_arena = 0 || child_arena = 0
        return: 0
    # A parent reserves IN ITS OWN TURN and nowhere else (model 26: "Родитель в своём turn
    # резервирует дочерний Message").  Off a turn there is no boundary that would ever
    # publish or drop the reservation, so the act is refused rather than left hanging -- and
    # that is also why a program outside the runtime (25 (i)) reaches it through the mail of
    # R0 and not by creating Messages.
    if: t\state != c.LMX_THREAD_TURN
        return: 0
    ---
    message: lmx_child_create(src_arena, child_arena, parent, slot, source)
    if: message = 0
        return: 0
    ---
    node: (cast: (@: LmxReservation) lmx_arena_take(src_arena, c.sizeof(c.LmxReservation), c.LMX_DOMAIN_KIND_RESERVATION, c.LMX_DOMAIN_RESERVATION))
    if: node = 0
        lmx_arena_release(child_arena)
        return: 0
    ---
    node\parent: parent
    node\slot: slot
    node\message: message
    node\arena: child_arena
    node\thread: 0
    node\next: (cast: (@: LmxReservation) t\prepared)
    t\prepared: (cast: (@: void) node)
return: message

# The child's own L3 Thread joins the turn's reservation for it, so the publication below writes
# the up-link.  A child whose reservation is not in THIS turn's list is refused: the list is the
# turn's own, and a Message from another turn is another turn's business.
fn: lmx_child_thread (@: LmxThread t; @: LmxMsg child; @: LmxThread child_thread) int
    @: LmxReservation node
    if: t = 0 || child = 0 || child_thread = 0
        return: c.LMX_CHILD_INVALID
    node: (cast: (@: LmxReservation) t\prepared)
    while: node != 0
        if: node\message = child
            node\thread: child_thread
            return: c.LMX_CHILD_OK
        ---
        node: node\next
    ---
return: c.LMX_CHILD_INVALID

# Publish what this turn reserved: one store per reservation, in reservation order -- the
# store IS the publication, and it is the only thing that makes a child reachable.  The list
# is emptied as it is walked, so a boundary that runs twice publishes once.
#
# A store that fails drops that reservation instead (its child was never published, so its
# arena is nobody's storage) and the answer reports it: the rest of the list is still
# published, because leaving a reservation in a list that is being emptied is worse than
# telling the caller what happened.

fn: lmx_child_service (@: LmxThread t) @: LmxService
    @: LmxServiceEntry entry
    if: t = 0 || t\entry = 0
        return: 0
    entry: (cast: (@: LmxServiceEntry) t\entry)
return: entry\service
fn: lmx_child_publish_prepared (@: LmxThread t; @: LmxArena arena) int
    @: LmxReservation node
    @: LmxReservation next
    @: LmxService service
    int: answer
    if: t = 0
        return: c.LMX_CHILD_INVALID
    answer: c.LMX_CHILD_OK
    node: (cast: (@: LmxReservation) t\prepared)
    t\prepared: 0
    while: node != 0
        next: node\next
        if: lmx_arena_ref_store(node\parent, node\slot, (cast: (@: void) node\message)) != 0
            lmx_arena_release(node\arena)
            answer: c.LMX_CHILD_INVALID
        else:
            # The publication IS the link, so the parent up-link is written here
            # and nowhere else -- on the parent's lane, which is this band (spec 19.29.6: "the
            # parent owns ... the parent link at link, unlink and supervision handoff").
            if: node\thread != 0
                node\thread\parent: (cast: (@: void) t)
                # ... and the same act seen from the other side: the child joins the parent's
                # list of LIVE DIRECT CHILDREN.  Spec 19.29.6 gives the parent "the parent link
                # at LINK, unlink and supervision handoff", and link is here and nowhere else --
                # until this store the child was nobody's.  Without it the kernel's own
                # supervision never sees a child the application created: settling (19.29.8)
                # walks this list, and so do the stop request (32) and the liveness handshake
                # (19.29.7.1); the settling side unlinks with lmx_thread_child_remove, so the
                # two halves must name the same list.  (Found by the end-to-end run of
                # 20260919: every test had wired this by hand, so no kernel path did it.)
                lmx_thread_child_add(t, node\thread, arena)
                # The parent registers the child in the service the parent itself was registered
                # in; registration writes the child's own entry (physical-address key).
                service: lmx_child_service(t)
                if: service != 0 && lmx_service_register(service, (cast: (@: LmxThread) node\thread), node\arena) != c.LMX_SERVICE_OK
                    answer: c.LMX_CHILD_INVALID
                ---
            ---
        ---
        node: next
    ---
return: answer

# Drop what this turn reserved: nothing was published, so each reserved child's arena is
# released -- the child's identity, its graph and its record go together, and no slot needs
# clearing because no slot was ever written.  This is NOT a rollback of the turn's graph
# writes; only the reservations are undone (spec 19.29.4.1).
fn: lmx_child_drop_prepared (@: LmxThread t) int
    @: LmxReservation node
    @: LmxReservation next
    if: t = 0
        return: c.LMX_CHILD_INVALID
    node: (cast: (@: LmxReservation) t\prepared)
    t\prepared: 0
    while: node != 0
        next: node\next
        lmx_arena_release(node\arena)
        node: next
    ---
return: c.LMX_CHILD_OK

# Handing a finished child over (model 19.29.7): the child's arena attaches to the
# parent's, so from here on ONE index answers for both and nothing was copied -- the
# child's cells keep every address they had, which is the whole point of attaching rather
# than transferring a copy.
#
# The precondition is the child's own mark: `handoff_ready` is written when it leaves its
# LAST turn (model 32).  Attaching before that would hand the parent storage a running
# Message is still using; the refusal is the mark's whole reason to exist.
fn: lmx_child_handoff (@: LmxArena parent_arena; @: LmxArena child_arena; @: LmxMsg message) int
    if: parent_arena = 0 || child_arena = 0 || message = 0
        return: c.LMX_CHILD_INVALID
    if: message\handoff_ready = 0
        return: c.LMX_CHILD_INVALID
    ---
return: lmx_arena_attach(parent_arena, child_arena)
