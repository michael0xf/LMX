# The control of assign_quoted_head_limit: the colon form `x`: 5 with an exact identifier as the head meets the same
# limit of the translator before and after the := slice -- "unsupported body": no statement route classifies a head
# written as an exact identifier (lm_compiler_ident accepts no backticks).
fn: f () int
    int: x 1
    `x`: 5
    return: x
end: f
int: code 7
if: f() != 5
    code: 81
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
