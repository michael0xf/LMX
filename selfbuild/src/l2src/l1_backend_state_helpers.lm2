        if: l1_fn_grow() != 0
            return: (cast: (int) (-1))
        ---
    ---
    c.strcpy(fn_names_cell[0] + fnn_cell[0] * 64, (cast: (const: @: char) buf_scratch\buffer))
    fn_thn_cell[0][fnn_cell[0]]: 0
    fn_ar_cell[0][fnn_cell[0]]: -1
