fn: fd_merge_check () int
    c.LmxArena: arena
    c.memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: c.lmx_arena_open(@ arena) != 0
        return: 131
    @: g c.LmxGraph c.lmx_graph_open(@ arena)
    @: root c.Lmx 0
    @: file c.FILE c.fopen("graph_merge_typed_code.lm2", "wb")
    @: m c.Lmx c.lmx_graph_lmx(g, 0, 2U)
    @: n c.Lmx c.lmx_graph_lmx(g, 0, 3U)
    @: bad c.Lmx c.lmx_graph_lmx(g, 0, 1U)
    @: source void 0
    @: alias_source void 0
    @: bad_source void 0
    const: (@: abi c.LmxScalarABI fd_binding("double", @ source))
    const: (@: alias_abi c.LmxScalarABI fd_binding("f64", @ alias_source))
    const: (@: bad_abi c.LmxScalarABI fd_binding("float", @ bad_source))
    double: zero (cast: (double) 0)
    double: precise (cast: (double) 1) + c.DBL_EPSILON
    float: bad_value (cast: (float) 1)
    @: x void fd_cell(g, "x", abi, source, m, 0, @ zero)
    @: late void fd_cell(g, "x", alias_abi, alias_source, n, 0, @ precise)
    @: mismatch void fd_cell(g, "x", bad_abi, bad_source, bad, 0, @ bad_value)
    @: only_m void c.lmx_graph_int(g, 8)
    @: cell_pointer void 0
    @: slot_pointer void c.lmx_pointer_new_profiled(c.LMX_TYPE_CELL_POINTER, @ arena, 0)
    c.LmxWalkPlace: place
    c.LmxWalkValue: address
    @: verify c.Lmx 0
    @: work c.Lmx 0
    @: bad_work c.Lmx 0
    @: bad_data c.Lmx 0
    @: prior void 0
    size_t: bad_slot 0U
    int: opened 0
    int: checked 0
    int: status 0
    if: g = 0 || file = 0 || m = 0 || n = 0 || bad = 0 || abi = 0 || alias_abi != abi || bad_abi = 0 || bad_abi = abi || x = 0 || late = 0 || mismatch = 0 || only_m = 0 || slot_pointer = 0
        return: 132
    if: c.lmx_walk_cell_place(@ arena, late, 0, @ place) != c.LMX_WALK_OK || c.lmx_walk_place_address(@ arena, @ place, @ address) != c.LMX_WALK_OK || c.lmx_walk_value_materialize(@ arena, @ address, @ cell_pointer) != c.LMX_WALK_OK
        return: 133
    if: c.lmx_graph_name(g, only_m, "onlyM", 5U) != 0 || c.lmx_graph_name(g, cell_pointer, "cellAlias", 9U) != 0 || c.lmx_graph_name(g, slot_pointer, "slotAlias", 9U) != 0 || c.lmx_graph_put_in(g, m, 0U, x) != 0 || c.lmx_graph_put_in(g, m, 1U, only_m) != 0 || c.lmx_graph_put_in(g, n, 0U, cell_pointer) != 0 || c.lmx_graph_put_in(g, n, 1U, slot_pointer) != 0 || c.lmx_graph_put_in(g, n, 2U, late) != 0 || c.lmx_graph_put_in(g, bad, 0U, mismatch) != 0 || c.lmx_pointer_store_in(@ arena, slot_pointer, c.lmx_graph_ref_cell_in(@ arena, n, 2U)) != 0
        return: 134
    if: c.fputs("int: merge_checks 0\nVerifyMerge:\nend: VerifyMerge\nsub: MergeWork () ()\n    @: merged merge(M; N)\n    call: merged VerifyMerge\n    @: merged merge(M; N; M)\n    call: merged VerifyMerge\nend: MergeWork\nsub: BadMergeWork () ()\n    @: merged merge(M; Bad)\n    call: merged VerifyMerge\nend: BadMergeWork\n", file) < 0 || c.fclose(file) != 0
        return: 135
    status := c.lm_graph_build_file(g, "graph_merge_typed_code.lm2", @ root)
    c.remove("graph_merge_typed_code.lm2")
    if: status != 0 || root = 0 || c.lmx_graph_space_open(g, root, @ opened) != 0 || c.lmx_graph_space_put(root, c.lmx_graph_intern("M", 1U), m) != 0 || c.lmx_graph_space_put(root, c.lmx_graph_intern("N", 1U), n) != 0 || c.lmx_graph_space_put(root, c.lmx_graph_intern("Bad", 3U), bad) != 0
        return: 136
    m\parent := root
    n\parent := root
    bad\parent := root
    verify := (cast: (@: c.Lmx) fd_named(g, root, "VerifyMerge"))
    verify\native := (cast: (c.LmxEntry) c.fd_merge_callback)
    work := (cast: (@: c.Lmx) c.lmx_graph_space_find(root, c.lmx_graph_intern("MergeWork", 9U)))
    bad_work := (cast: (@: c.Lmx) c.lmx_graph_space_find(root, c.lmx_graph_intern("BadMergeWork", 12U)))
    bad_data := c.lmx_graph_method_data(g, bad_work)
    bad_slot := c.lmx_graph_named(g, bad_data, c.lmx_graph_intern("merged", 6U))
    prior := c.lmx_graph_reference_cell(g, c.lmx_graph_get_in(g, bad_data, bad_slot))
    status := c.lmx_graph_call_data(g, 0, work, 1)
    if: status != 0
        c.fprintf(c.stderr, "merge work status %d\n", status)
        return: 137
    if: c.lmx_graph_value_int(g, fd_named(g, root, "merge_checks"), @ checked) != 0 || checked != 2
        return: 138
    status := fd_merge_siblings(g)
    if: status = 0
        status := fd_merge_word_aliases(g)
    if: status = 0
        status := fd_merge_singleton_alias(g)
    if: status = 0
        status := fd_merge_physical_aliases(g)
    if: status != 0
        return: status
    status := c.lmx_graph_call_data(g, 0, bad_work, 1)
    if: status != 4 || prior = 0 || c.lmx_graph_reference_cell(g, c.lmx_graph_get_in(g, bad_data, bad_slot)) != prior || c.lmx_pointer_value_in(@ arena, prior) != 0 || c.lmx_graph_value_int(g, fd_named(g, root, "merge_checks"), @ checked) != 0 || checked != 2 || fd_expect(@ arena, x, abi, source, m, 0, @ zero) != 0
        return: 139
    c.lmx_graph_space_close(opened)
    c.lmx_graph_close(g)
    c.lmx_arena_release(@ arena)
    return: 0
end: fd_merge_check

fn: fd_mapped_check () int
    c.LmxArena: arena
    c.memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: c.lmx_arena_open(@ arena) != 0
        return: 80
    @: g c.LmxGraph c.lmx_graph_open(@ arena)
    @: root c.Lmx 0
    @: file c.FILE c.fopen("graph_fn_data_typed_code.lm2", "wb")
    @: source void 0
    @: alias_source void 0
    const: (@: abi c.LmxScalarABI fd_binding("double", @ source))
    const: (@: alias_abi c.LmxScalarABI fd_binding("f64", @ alias_source))
    double: zero (cast: (double) 0)
    double: precise (cast: (double) 1) + c.DBL_EPSILON
    double: replacement c.strtod("3.5", 0)
    @: physical c.Lmx c.lmx_node_new_owned(@ arena)
    @: data c.Lmx c.lmx_graph_lmx(g, 0, 10U)
    @: x void fd_cell(g, "x", abi, source, data, physical, @ zero)
    @: y void fd_cell(g, "y", abi, alias_source, data, physical, @ precise)
    @: z void fd_cell(g, "z", abi, source, data, physical, @ replacement)
    @: saved void fd_cell(g, "saved", abi, source, data, physical, @ zero)
    @: empty void fd_cell(g, "empty", abi, alias_source, data, physical, 0)
    @: word_a void c.lmx_scalar_new_physical_profiled(@ arena, c.LMX_TYPE_WORD, physical)
    @: word_b void c.lmx_scalar_new_physical_profiled(@ arena, c.LMX_TYPE_WORD, physical)
    @: self void c.lmx_graph_ref_lmx(g, data)
    @: held_ref void 0
    @: held c.Lmx 0
    @: make c.Lmx 0
    @: before c.Lmx 0
    @: verify c.Lmx 0
    int: opened 0
    int: status 0
    int: checked 0
    int: warm 0
    if: g = 0 || file = 0 || abi = 0 || abi != alias_abi || source = alias_source || physical = 0 || data = 0 || x = 0 || y = 0 || z = 0 || saved = 0 || empty = 0 || word_a = 0 || word_b = 0 || self = 0
        return: 81
    c.lmx_charptr_store_known(word_a, c.lmx_graph_intern("token", 5U))
    c.lmx_charptr_store_known(word_b, c.lmx_graph_intern("token", 5U))
    c.memset(empty, 165, abi\size)
    if: c.fputs("int: checked 0\nfn: Held () int (int: count 0)\n    count := count + 1\n    return: count\nend: Held\nBefore:\nend: Before\nVerify:\nend: Verify\nTransfer:\n    int: touched 7\n    x := y\n    y := z\n    saved := x\nend: Transfer\nMake:\n    sub: F () D Transfer\n    call: F\\data Before\n    F()\n    fn: Again F\\data\\held\n    Again()\n    call: F\\data Verify\nend: Make\n", file) < 0 || c.fclose(file) != 0
        return: 82
    status := c.lm_graph_build_file(g, "graph_fn_data_typed_code.lm2", @ root)
    c.remove("graph_fn_data_typed_code.lm2")
    if: status != 0 || root = 0 || c.lmx_graph_space_open(g, root, @ opened) != 0
        return: 83
    data\parent := root
    if: c.lmx_graph_name(g, (cast: (@: void) data), "OriginalD", 9U) != 0 || c.lmx_graph_space_put(root, c.lmx_graph_intern("D", 1U), data) != 0
        return: 84
    held := (cast: (@: c.Lmx) c.lmx_graph_space_find(root, c.lmx_graph_intern("Held", 4U)))
    while: warm < 3
        if: c.lmx_graph_call_data(g, 0, held, 1) != 0
            return: 85
        warm := warm + 1
    ---
    held_ref := c.lmx_graph_ref_lmx(g, held)
    if: held_ref = 0 || c.lmx_graph_name(g, held_ref, "held", 4U) != 0 || c.lmx_graph_name(g, self, "self", 4U) != 0 || c.lmx_graph_put_in(g, data, 0U, x) != 0 || c.lmx_graph_put_in(g, data, 1U, y) != 0 || c.lmx_graph_put_in(g, data, 2U, z) != 0 || c.lmx_graph_put_in(g, data, 3U, saved) != 0 || c.lmx_graph_put_in(g, data, 4U, empty) != 0 || c.lmx_graph_put_in(g, data, 5U, word_a) != 0 || c.lmx_graph_put_in(g, data, 6U, word_a) != 0 || c.lmx_graph_put_in(g, data, 7U, word_b) != 0 || c.lmx_graph_put_in(g, data, 8U, self) != 0 || c.lmx_graph_put_in(g, data, 9U, held_ref) != 0
        return: 86
    make := (cast: (@: c.Lmx) fd_named(g, root, "Make"))
    before := (cast: (@: c.Lmx) fd_named(g, root, "Before"))
    verify := (cast: (@: c.Lmx) fd_named(g, root, "Verify"))
    before\native := (cast: (c.LmxEntry) c.fd_callback)
    verify\native := (cast: (c.LmxEntry) c.fd_callback)
    status := c.lmx_graph_call_data(g, data, make, 0)
    if: status != 0
        c.fprintf(c.stderr, "fn_data Make status %d\n", status)
        return: 87
    if: c.lmx_graph_value_int(g, fd_named(g, root, "checked"), @ checked) != 0 || checked != 2 || fd_word_cross() != 0
        return: 88
    c.lmx_graph_space_close(opened)
    c.lmx_graph_close(g)
    c.lmx_arena_release(@ arena)
    status := fd_merge_check()
    if: status != 0
        c.fprintf(c.stderr, "merge checks status %d\n", status)
        return: status
    return: 7
