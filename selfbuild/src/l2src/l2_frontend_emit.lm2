# A prepared choice constructs exactly one ordinary operand, or none.
# This does not re-run the outer choice. The selected operand's
# existing producer retains its ordinary witnesses, fallback and diagnostics.
fn: lm_compiler_rw_dyn_arg_emit (const: (@: source_node c.LmP0Node); int: idx; int: k; int: parent; int: kind; int: chosen; @: out int) int
    @: nm c.LmP0Text
    if: kind = 0
        \out: -1
        return: 0
    ---
    if: kind = 1
        return: lm_compiler_rw_arg(parent, chosen, out)
    if: kind = 2
        nm: c.lm_compiler_dn(idx, k)
        return: lm_compiler_rw_mad_host_struct(parent, chosen, nm, out)
    if: kind = 3
        return: lm_compiler_rw_own(parent, chosen, out)
    if: kind = 4
        return: lm_compiler_rw_arg_lex(source_node, parent, chosen, idx, k, out)
    if: kind = 5
        return: lm_compiler_rw_arg_fb(parent, chosen, out)
    if: kind = 6
        return: lm_compiler_rw_lex_operand(source_node, idx, k, parent, out)
    return: 1
end: lm_compiler_rw_dyn_arg_emit

# Existing public entry: select once, then emit once in the same caller scope.
# Moving the prepared membership before fixed CALL allocation is a separate,
# connected change with compact SOURCE coordinates and common value transport.
fn: lm_compiler_rw_dyn_arg (const: (@: source_node c.LmP0Node); int: idx; int: k; int: parent; @: out int) int
    int: kind 0
    int: chosen -1
    int: status lm_compiler_rw_dyn_arg_choice(source_node, idx, k, @ kind, @ chosen)
    if: status != 0
        return: status
    return: lm_compiler_rw_dyn_arg_emit(source_node, idx, k, parent, kind, chosen, out)
end: lm_compiler_rw_dyn_arg

