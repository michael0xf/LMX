RecordModel:
    int: width 2
    int: height 3

RecordPatch:
    int: height 5
    int: depth 7

MergeProbe:
    return: int
    run:
        @: result derive(RecordModel; RecordPatch)
        return: result\width * 100 + result\height * 10 + result\depth

