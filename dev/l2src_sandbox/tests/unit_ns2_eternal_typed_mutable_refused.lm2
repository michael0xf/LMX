# A qualified branch cannot retain a direct, construction-time reference to
# mutable storage, whether declared by b: A or by the typed @ receiver.
Model:
    int: v 1
end: Model
independent:
    const:
        immutable:
            (): E
                @: Model box Model
                size_t: a 7U
            end: E
        end: immutable
    end: const
end: independent
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
