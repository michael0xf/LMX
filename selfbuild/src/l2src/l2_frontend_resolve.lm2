                next_index: 1
            ---
        ---
        if: step\locus = 7
            # INDEX resolves from the value contract before THIS step. An
            # Array consumes its declared level; a machine pointer consumes
            # its exact closed pointer type. The native/retained consumers
            # receive that decision and never repeat the type fold.
