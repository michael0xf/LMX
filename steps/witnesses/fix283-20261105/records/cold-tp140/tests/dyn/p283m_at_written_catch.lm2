# Slice 283 probe: which throw the `@` form with a written Structure raises.  Entry 7.
Box:
    k:
        int: q 1
    end: k
end: Box
fn: write () int
    ---
        @: Box\k (int: q 8)
        return: Box\k\q
        catch: implements ()
            return: 31
        catch: interpreter ()
            return: 32
        catch: convert ()
            return: 33
    ---
end: write
int: code write()
if: code = 8
    code: 7
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
