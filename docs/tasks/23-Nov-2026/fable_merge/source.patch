+        "priority": 1,
+        "id": "b",
+        "width": 4
+      },
+      {
+        "priority": 2,
+        "id": "c",
+        "width": 12
+      }
+    ]
+  ],
+  "result": [
+    {
+      "priority": 1,
+      "id": "b",
+      "width": 4
+    },
+    {
+      "priority": 2,
+      "id": "a",
+      "width": 8
+    },
+    {
+      "priority": 2,
+      "id": "c",
+      "width": 12
+    }
+  ]
+}
