predef: "lmx_array_owned.h.lm1"
predef: "l2src/lmx_pool.h.lm1"
include: "<stdlib.h>"

# An Array of one element type: TWO arrays of the arena.  The descriptor is a cell of the
# array of Array descriptors for that type (6.5's all_array_of_T), and the backing is the
# array of element cells it points at.  The arena allocates both and owns both, each has
# its own descriptor in the index, and a refusal anywhere reverts the arena to the mark
# taken before the first one -- an Array never survives half made.
fn: lmx_array_new_owned (int: type; size_t: count; @: LmxArena arena) @: LmxArrayDesc
    size_t: stride
    int: element_type
    @: LmxArrayDesc desc
    @: void backing
    ulong: ulong_probe 0U
    if: arena = 0
        return: 0
    if: type = c.LMX_TYPE_ARRAY_OF_CHAR
        stride: c.sizeof(c.char)
        element_type: c.LMX_TYPE_CHAR
    else:
        if: type = c.LMX_TYPE_ARRAY_OF_UNSIGNED_CHAR
            stride: c.sizeof(c.char)
            element_type: c.LMX_TYPE_UNSIGNED_CHAR
        else:
            if: type = c.LMX_TYPE_ARRAY_OF_INT
                stride: c.sizeof(c.int)
                element_type: c.LMX_TYPE_INT
            else:
                if: type = c.LMX_TYPE_ARRAY_OF_SIZE_T
                    stride: c.sizeof(c.size_t)
                    element_type: c.LMX_TYPE_SIZE_T
                else:
                    if: type = c.LMX_TYPE_ARRAY_OF_ULONG
                        stride: c.sizeof(ulong_probe)
                        element_type: c.LMX_TYPE_ULONG
                    ---
                    if: type != c.LMX_TYPE_ARRAY_OF_ULONG && type < c.LMX_TYPE_ARRAY_OF_POINTER_BASE
                        return: 0
                    # Exact parallel domains: descriptor Array<@T> and each
                    # backing @T cell carry the same closed-unit T id.
                    if: type >= c.LMX_TYPE_ARRAY_OF_POINTER_BASE
                        stride: c.sizeof(@: void)
                        element_type: c.LMX_TYPE_POINTER_BASE + (type - c.LMX_TYPE_ARRAY_OF_POINTER_BASE)
                    ---
                ---
            ---
        ---
    ---
    if: count != 0U && count > ((cast: (size_t) -1) / stride)
        return: 0
    ---
    # The descriptor is one cell of the array of Array descriptors of this type; the
    # backing is `count` consecutive cells of the array of that element type.  Both are
    # the arena's arrays: found if the arena has them, made here if it does not.
    desc: (cast: (@: LmxArrayDesc) lmx_arena_take(arena, c.sizeof(c.LmxArrayDesc), c.LMX_KIND_ARRAY, type))
    if: desc = 0
        return: 0
    ---
    desc\len: count
    desc\capacity: count
    desc\data: 0
    if: count != 0U
        backing: lmx_arena_take_n(arena, stride, c.LMX_KIND_PRIMITIVE, element_type, count)
        if: backing = 0
            return: 0
        ---
        desc\data: backing
    ---
return: desc

fn: lmx_array_new_positive_owned (int: type; size_t: count; @: LmxArena arena) @: LmxArrayDesc
    if: count = 0U
        return: 0
    return: lmx_array_new_owned(type, count, arena)
