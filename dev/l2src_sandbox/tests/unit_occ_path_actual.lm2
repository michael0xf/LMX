# Row 6. Holder\other selects other's occurrence, not the unit method task.
# Each transport leaves the call to the formal. other adds 10, task adds 1.
# Two transports, then the formal's one call each, leave hits at 20. Entry 7.
# The walker is not this witness.
int: hits 0

sub: task ()
    node\hits: node\hits + 1
end: task

sub: other ()
    node\hits: node\hits + 10
end: other

Holder:
    fn: other
end: Holder

fn: recv (task: f) int
    f()
    return: 0
end: recv

fn: check () int
    recv(Holder\other)
    if: node\hits != 10
        return: 1
    recv(Holder\other())
    if: node\hits != 20
        return: 2
    return: 7
end: check

sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
