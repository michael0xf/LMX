# Slice 415 (haiku, FABLE-H-415-B): the reserved data reference is `data`; the child block `var` of D and of TD is an ordinary name; T's block moved to TD, the data T runs over; values unchanged.
# Two written cells stay distinct even though their names agree.
D:
    int: x 10
    var:
        int: x 2
    end: var
end: D
# The reserved reference is local; ordinary assignment changes that cell.
S:
    if: data != D
        send: exit(exit_code: 84; stdout: ""; stderr: "")
        return
    ---
    data := D\var
    if: data != D\var
        send: exit(exit_code: 85; stdout: ""; stderr: "")
        return
    ---
    return
end: S
TD:
    var:
        int: x 17
---
T:
    if: data != TD
        send: exit(exit_code: 86; stdout: ""; stderr: "")
        return
    ---
    if: var != TD\var
        send: exit(exit_code: 87; stdout: ""; stderr: "")
        return
    ---
    return
end: T
@: held S
call(D held)
call(TD T)
int: answer 83
if: D\x = 10 && D\var\x = 2 && TD\var\x = 17
    answer := 7
send: exit(exit_code: answer; stdout: ""; stderr: "")
return
