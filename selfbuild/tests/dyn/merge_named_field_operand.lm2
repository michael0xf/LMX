# The := slice (MERGE-OPERAND-FORMS; the book, composition), rewritten by plan M9 (the author, 2026-11-10: a place is
# declared only by `receiver: arguments`): a merge operand that is a typed field is written by its receiver -- in
# parentheses, `(int: a 5)`, a Structure with the one field a of type int and value 5, and bare, `int: a 7`.  It writes
# the model's slot of its name (a), the other fields stay (c), the model is not written.  The field written name first
# is withdrawn with the composed form: merge_named_field_refused.  Over an ordinary Structure Args (int: c 3; int: a 0).
# Entry 7; 81-92 the failing check.
Args:
    int: c 3
    int: a 0
end: Args
fn: parens () int
    pack: merge(Args; (int: a 5))
    if: pack\a != 5
        return: 81
    if: pack\c != 3
        return: 82
    if: Args\a != 0
        return: 83
    return: 7
end: parens
fn: bare () int
    pack: merge(Args; int: a 7)
    if: pack\a != 7
        return: 84
    if: pack\c != 3
        return: 85
    if: Args\a != 0
        return: 86
    return: 7
end: bare
fn: control () int
    pack: merge(Args; (int: a 9))
    if: pack\a != 9
        return: 87
    if: pack\c != 3
        return: 88
    if: Args\a != 0
        return: 89
    return: 7
end: control
fn: two_fields () int
    pack: merge(Args; (int: a 4); (int: c 2))
    if: pack\a != 4
        return: 90
    if: pack\c != 2
        return: 91
    if: Args\c != 3
        return: 92
    return: 7
end: two_fields
int: code parens()
if: code = 7
    code := bare()
---
if: code = 7
    code := control()
---
if: code = 7
    code := two_fields()
---
send: exit(exit_code: code; stdout: ""; stderr: "")
return
