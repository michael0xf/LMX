        throws: copy(MapThrows)
        if: count < 0
            throw: MapFailure("byte count")
        @: units MapVector\create()
        int: i 0
        while: i < count
            MapVector\push(units; (0 record))
            i += 1
        return: MapBytes\view(units; 0; count; utf16)

