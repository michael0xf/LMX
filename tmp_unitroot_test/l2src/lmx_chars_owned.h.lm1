predef: "l2src/lmx_arena.h.lm1"

# Fresh complete byte table in exclusively held Message storage. The caller
# chooses its canonical table and retains it through actual graph roots.
# Published bytes are immutable. Creation does not choose a Message or a root.
# The table is one array of the arena: the arena allocates it, owns it and
# classifies it; no owner-local range list exists.
prototype:
    fn: lmx_chars_new_owned (@: LmxArena arena) @: char
    # table is null or the live base returned by construction, not a validator.
    fn: lmx_char_cell_known (@: char table; int: value) @: void
    # cell must belong to a live complete immutable table from new_owned.
    # Rebind within that SAME table; a generic live char pointer is insufficient.
    fn: lmx_char_rebind_known (@: void cell; int: value) @: void
end: prototype
