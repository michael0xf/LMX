# An argument compared through the c.* door: its bytes and length come from the
# letter exactly as C passed them ("ok" and its NUL: three elements).
MainLetter:
    char: []: []: mainArgs
end: MainLetter

MainLetter: m
nextMessage: m
if: length(m\mainArgs) != 2
    return: 1
if: length(m\mainArgs[1]) != 3
    return: 2
if: m\mainArgs[1][0] != 111 || m\mainArgs[1][2] != 0
    return: 3
if: c.strcmp(@ m\mainArgs[1][0], "ok") != 0
    return: 4
return: 0
