# Admission reads the selected body, including declarations in inline branches.
S:
    int: x 0
    x := 1
    if: x = 2
        int: y 5
end: S
D:
    int: x 10
end: D
Good:
    int: y 33
    int: padding 27
    int: x 11
end: Good
@: chosen S
fn: run () int
    int: r 82
    call: chosen D
    catch: call ()
        r := 83
        if: D\x = 10
            r := 7
    ---
return: r
int: got run()
call: chosen Good
if: Good\x != 1 || Good\y != 33 || Good\padding != 27
    got := 84
Node:
    int: value 8
end: Node
LinkCode:
    int: marker 13
    @: next Node 0
end: LinkCode
LinkData:
    @: next Node 0
    int: marker 21
end: LinkData
NumberData:
    int: marker 31
    int: next 0
end: NumberData
@: held_link LinkCode
fn: incompatible_link () int
    int: result 85
    call: held_link NumberData
    catch: call ()
        if: NumberData\marker = 31
            result := 7
    ---
    return: result
end: incompatible_link
call: held_link LinkData
int: rejected incompatible_link()
if: LinkData\marker != 13 || rejected != 7
    got := 86
send: exit(exit_code: got; stdout: ""; stderr: "")
return
