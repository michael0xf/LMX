FlatRowPlaces:
    return: @
    run:
        throws: copy(`:=`\throws) copy(`+=`\throws) copy(slice\throws) ReceiverIndex
        [2][2]int: values [1 2; 3 4]
        @: alias values
        [2][2]int: swapped [values[2] values[3]; values[0] values[1]]
        values := swapped
        values += 10
        return: (values; alias)
