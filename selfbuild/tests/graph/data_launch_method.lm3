# HG2-B (ROOT5V, data(D)): D is a Structure of the data part of main. `data(D)` runs f's data record (int: n 5) over D;
# the declaration assigns D's n as the call's local (#call-frame-20261115: no write-back), so D\n stays 1 and the
# observed seen is 1 (values-changed; the pin 5 was the published value).
(
    Observed:
        int: r 0
        int: seen 0
)
fn: f () int (int: n 5)
    data(D)
    return: 1
sub: main () (
    D(int: n 1)
    int: r 0
    int: seen 0
)
    @: shared node[0]
    data\r := f()
    data\seen := D\n
    shared\Observed\r := data\r
    shared\Observed\seen := data\seen
main()
