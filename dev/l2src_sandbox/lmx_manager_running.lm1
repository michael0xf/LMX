predef: "l2src/lmx_manager.h.lm1"
predef: "l2src/lmx_manager_running.h.lm1"
predef: "l2src/lmx_implements.h.lm1"
# A lane IS a cycle: its own loop reads the clock and ages its record, so this unit names the
# clock itself -- the stepped binding does not, because its reading is handed down.
predef: "l2src/lmx_clock.lm1"
predef: "l2src/lmx_turn.lm1"

# lmx_manager_running.lm1 - the SECOND implementation of the manager interface: it
# gives every record a lane of its own, an OS thread that loops over that one object's
# turns.  Same six operations, same signatures, same LmxManager; only the binding
# differs -- `lmx_manager_running_init` instead of `lmx_manager_init`
# (Mikhail, 2026-09-17: "если lmx_manager сейчас сам шагает по детям значит надо
# сделать второй с тем же API -- иначе работать будет невозможно").
#
# The platform is reached ONLY through the c. door (CreateThread, WaitForSingleObject,
# CloseHandle, Sleep), so another platform implements the same interface with its own
# four calls and nothing above this file changes.
#
# A lane runs while its record is WAITING and its letter is running, and it ends by
# itself -- by the letter's success or stop, or by the record's own limit going
# overdue.  Nothing kills a lane; a close joins the ones that are still there.
#
# More than one lane may be in flight: the current object of the poll hook is now a
# PER-THREAD cell (lmx_thread.lm1 `thread_local:`), so a lane's turns touch only its own
# thread's cell and two lanes cannot fight over one.  That cell was the whole of the
# one-lane limit, and the domain selftest proves the separation the direct way: a lane
# runs its own turns while THIS thread's current object stays exactly what this thread
# put there.  What the kernel still does not promise is that a lane exists at all -- a
# runtime may step its objects on one OS thread, and the stepped binding does exactly
# that, with no such question to ask.

# The lane's own loop.  It is the thread entry, so its shape is the platform's: one
# address in, the platform's own return type out (LmxULong is Win32's DWORD).
fn: lmx_manager_running_body (@: void arg) DWORD
    @: LmxSchedule slot
    @: LmxThread t
    slot: (cast: (@: LmxSchedule) arg)
    if: slot = 0 || slot\owner = 0
        return: 0U
    t: (cast: (@: LmxThread) slot\owner)
    # ONE reading per lane turn: a lane IS a cycle, so the lane reads the clock once and gives
    # that reading to everything that ages against it below.
    ulong: lane_now 0U
    while: lmx_thread_running(t) != 0 && lmx_schedule_state(slot) = c.LMX_SCHEDULE_WAITING
        lane_now: lmx_clock_ticks()
        # ONE turn, the same act the stepped binding uses: the boundary, the body the object's own
        # graph names, the boundary.  The lane names no handler and no arena -- the object's record
        # carries its own band, and a lane is handed nothing but its record.
        lmx_thread_turn(t, 0, lane_now)
        lmx_schedule_tick(slot, lane_now)
        c.Sleep(1U)
    ---
    # The lane ends when its object does, and the last act is the object's own: a successful
    # incarnation returns its arena (lmx_thread.lm1, lmx_thread_finish).  Nothing of `t` is
    # touched after it.
    lmx_thread_finish(t)
return: 0U

fn: lmx_manager_running_init (@: LmxManager m) int
    if: m = 0
        return: c.LMX_MANAGER_INVALID
    m\head: 0
    m\tail: 0
    m\count: 0U
    m\api.init: lmx_manager_running_init
    m\api.add: lmx_manager_running_add
    m\api.remove: lmx_manager_running_remove
    m\api.take: lmx_manager_running_take
    m\api.count: lmx_manager_running_count
    m\api.step: lmx_manager_running_step
    m\api.round: lmx_manager_running_round
return: c.LMX_MANAGER_OK

# The same admission rules as the stepped binding: a record joins once (its `next` is
# the queue link), and its owner must be an executable object by the index of the RECORD'S OWN BAND
# -- the domain question, asked of the address rather than assumed from the caller.
fn: lmx_manager_running_add (@: LmxManager m; @: LmxSchedule slot) int
    if: m = 0 || slot = 0 || slot\next != 0
        return: c.LMX_MANAGER_INVALID
    if: lmx_domain_kind(slot\arena, slot\owner) != c.LMX_DOMAIN_KIND_THREAD
        return: c.LMX_MANAGER_INVALID
    ---
    if: m\tail = 0
        m\head: slot
    else:
        m\tail\next: slot
    m\tail: slot
    m\count: m\count + 1U
return: c.LMX_MANAGER_OK

fn: lmx_manager_running_take (@: LmxManager m) @: LmxSchedule
    @: LmxSchedule slot
    if: m = 0 || m\head = 0
        return: 0
    slot: m\head
    m\head: slot\next
    if: m\head = 0
        m\tail: 0
    slot\next: 0
    m\count: m\count - 1U
return: slot

# The same walk as the stepped binding's removal -- one queue, one set of rules -- and the lane is
# left alone on purpose: a record leaves because its object is gone, and a lane of a gone object
# ends by itself (the close of this unit joins the lanes that are still there).
fn: lmx_manager_running_remove (@: LmxManager m; @: LmxSchedule slot) int
    @: LmxSchedule walk
    @: LmxSchedule before
    if: m = 0 || slot = 0
        return: c.LMX_MANAGER_INVALID
    if: m\head = slot
        m\head: slot\next
        if: m\head = 0
            m\tail: 0
        ---
        slot\next: 0
        m\count: m\count - 1U
        return: c.LMX_MANAGER_OK
    ---
    before: m\head
    walk: m\head
    while: walk != 0
        if: walk = slot
            before\next: slot\next
            if: m\tail = slot
                m\tail: before
            ---
            slot\next: 0
            m\count: m\count - 1U
            return: c.LMX_MANAGER_OK
        ---
        before: walk
        walk: walk\next
    ---
return: c.LMX_MANAGER_INVALID

fn: lmx_manager_running_count (@: LmxManager m) size_t
    if: m = 0
        return: 0U
return: m\count

# A record that has no lane yet gets one, if its letter is still running.  A record
# whose letter has stopped keeps no lane: there is nothing left to run.
fn: lmx_manager_running_lane_start (@: LmxSchedule slot) int
    @: LmxThread t
    if: slot = 0 || slot\owner = 0
        return: c.LMX_MANAGER_INVALID
    if: slot\lane != 0
        return: c.LMX_MANAGER_OK
    t: (cast: (@: LmxThread) slot\owner)
    if: lmx_thread_running(t) = 0
        return: c.LMX_MANAGER_OK
    slot\lane: c.CreateThread(0, 0, (cast: (LPTHREAD_START_ROUTINE) lmx_manager_running_body), (cast: (@: void) slot), 0, 0)
    if: slot\lane = 0
        return: c.LMX_MANAGER_INVALID
return: c.LMX_MANAGER_OK

# Reap, do not wait: a zero timeout asks whether the lane has already ended.  A lane
# that needs longer simply stays running into the next tick.
fn: lmx_manager_running_lane_reap (@: LmxSchedule slot) int
    if: slot = 0 || slot\lane = 0
        return: c.LMX_MANAGER_OK
    if: c.WaitForSingleObject(slot\lane, 0U) != c.WAIT_OBJECT_0
        return: c.LMX_MANAGER_OK
    c.CloseHandle(slot\lane)
    slot\lane: 0
return: c.LMX_MANAGER_OK

fn: lmx_manager_running_step (@: LmxManager m; ulong: now) int
    @: LmxSchedule slot
    if: m = 0
        return: c.LMX_MANAGER_INVALID
    slot: m\head
    while: slot != 0
        if: lmx_manager_running_lane_start(slot) != c.LMX_MANAGER_OK
            return: c.LMX_MANAGER_INVALID
        if: lmx_manager_running_lane_reap(slot) != c.LMX_MANAGER_OK
            return: c.LMX_MANAGER_INVALID
        slot: slot\next
    ---
return: c.LMX_MANAGER_OK

# A bounded pass: start what is due and reap what has ended, `ticks` times.  It never
# blocks -- a lane of its own runs on the OS scheduler, not on this caller.
fn: lmx_manager_running_round (@: LmxManager m; unsigned: ticks; ulong: now) int
    unsigned: i
    int: code
    if: m = 0 || ticks = 0U
        return: c.LMX_MANAGER_INVALID
    i: 0U
    while: i < ticks
        code: lmx_manager_running_step(m, now)
        if: code != c.LMX_MANAGER_OK
            return: code
        i: i + 1U
    ---
return: c.LMX_MANAGER_OK

# Join and release lanes after their owning parent cascade has requested stop and every
# lane has reached its safe boundary.  This manager does not infer child ownership and
# does not initiate the Message close cascade.
fn: lmx_manager_running_close (@: LmxManager m) int
    @: LmxSchedule slot
    if: m = 0
        return: c.LMX_MANAGER_INVALID
    slot: m\head
    while: slot != 0
        if: slot\lane != 0
            c.WaitForSingleObject(slot\lane, c.INFINITE)
            c.CloseHandle(slot\lane)
            slot\lane: 0
        ---
        slot: slot\next
    ---
    m\head: 0
    m\tail: 0
    m\count: 0U
return: c.LMX_MANAGER_OK
