int: l2_pr_ready 0
int: l2_pr_failed 0
int: l2_pr_t 0
[]: int l2_pr_c 3
# 1 once a primitive table cell a row needs was said at its cause (l2_prim_kind): the primitive decision
# is then malformed (l2_primitive_leaf_implements 1), and no site that asked adds a line.
int: l2_pr_said 0
# The receiver `table` (Q41, Q43; steps/table-receiver.md §5): the source tables of this translation.
# Table t: its name (the one atom of its `name:` argument, or 0), its `columns:` argument, its first
# column and number of columns in l2_tbc_name, its first cell and number of rows in l2_tbx_*.
# As many tables, columns and cells as the program's tables have (FIXED-BLOCKS-AUDIT): the unit's places, beyond
# them memory of the size needed (l2_tb_room, l2_tbc_room, l2_tbx_room).
int: l2_tb_n 0
int: l2_tb_cap 0
