# return: h\a\p. The leaf is a nested Structure two fields deep, with an
# unread extra before its equals. take writes through the admitted reference;
# the write is seen in Holder's own leaf and extra keeps its value. Entry 7.

Equatable:
    size_t: equals 0U
end: Equatable

Holder:
    a:
        p:
            size_t: extra 5U
            size_t: equals 0U
end: Holder

fn: pick (Holder: h) Equatable
return: h\a\p

fn: take (Equatable: slot) size_t
    slot\equals: 9U
return: slot\equals

fn: go () size_t
return: take(pick(Holder))

size_t: k
k: go()
if: k = 9U && Holder\a\p\equals = 9U && Holder\a\p\extra = 5U
    sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
return
