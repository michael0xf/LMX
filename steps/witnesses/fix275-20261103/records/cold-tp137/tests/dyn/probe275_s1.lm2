# Probe 275 s1.
Far:
    int: z 9
    b:
        int: q 1
        int: y 7
        int: u 4
    end: b
end: Far
Near:
    a:
        b:
            int: u 2
            int: y 3
        end: b
    end: a
end: Near
Other:
    int: z 9
    int: y 7
end: Other
Box:
    kid:
        int: k 1
        int: y 3
    end: kid
end: Box
Third:
    int: y 5
    int: k 6
end: Third
int: quote 11
sub: put_far ()
    quote\a: Far
end: put_far
sub: put_third ()
    quote\kid: Third
end: put_third
fn: through (@: p Near) int
    return: p\a\b\y
end: through
fn: m () int
    @: quote Near Near
    put_far()
    int: t through(Near)
    if: t != 7
        return: 100 + t
    if: Near\a\b\u != 4
        return: 82
    return: 7
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
