# The argument count reaches a method as an ordinary value: argv[0] alone is one.
fn: plus_one (int: x) int
return: x + 1

MainLetter:
    char: []: []: mainArgs
end: MainLetter

MainLetter: m
receiveMessage: m
if: m = 0
    sendMessage: exit(exit_code: 99; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: plus_one(length(m\mainArgs)); stdout: ""; stderr: "")
return
