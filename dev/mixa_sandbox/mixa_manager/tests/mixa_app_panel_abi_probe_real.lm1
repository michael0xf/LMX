# ABI parity guard — L1 port of mixa_app_panel_abi_probe_real.c (ticket 20260918-082421).
# offsetof is a C macro with no L1 spelling (c. pastes a call, not a preprocessor
# name). Field offsets are computed at run time via pointer arithmetic on a local
# store (same pattern as l2src/lmx_message_selftest.lm1). Output format strings
# are kept byte-identical to the C probe so L2-vs-real parity still diffs stdout.
predef: "mixa_manager/mixa_app_panel.h.lm1"
include: "<stdio.h>"

fn: main () int
    MixaAppPanel: store0
    @: MixaAppPanel p0
    p0: @ store0
    MixaAppPanelEntry: store1
    @: MixaAppPanelEntry p1
    p1: @ store1

    c.printf("MixaAppPanelEntry sizeof=%zu\n", c.sizeof(c.MixaAppPanelEntry))
    c.printf("MixaAppPanelEntry kind=%zu\n", (cast: (size_t) @ p1\kind) - (cast: (size_t) p1))
    c.printf("MixaAppPanelEntry label=%zu\n", (cast: (size_t) @ p1\label) - (cast: (size_t) p1))
    c.printf("MixaAppPanelEntry launch_ref=%zu\n", (cast: (size_t) @ p1\launch_ref) - (cast: (size_t) p1))
    c.printf("MixaAppPanelEntry path=%zu\n", (cast: (size_t) @ p1\path) - (cast: (size_t) p1))
    c.printf("MixaAppPanel sizeof=%zu\n", c.sizeof(c.MixaAppPanel))
    c.printf("MixaAppPanel entries=%zu\n", (cast: (size_t) @ p0\entries) - (cast: (size_t) p0))
    c.printf("MixaAppPanel entry_count=%zu\n", (cast: (size_t) @ p0\entry_count) - (cast: (size_t) p0))
    c.printf("MixaAppPanel entry_cap=%zu\n", (cast: (size_t) @ p0\entry_cap) - (cast: (size_t) p0))
    c.printf("MixaAppPanel panel=%zu\n", (cast: (size_t) @ p0\panel) - (cast: (size_t) p0))
    c.printf("MixaAppPanel is_open=%zu\n", (cast: (size_t) @ p0\is_open) - (cast: (size_t) p0))
    return: 0

