---
    Observed:
        int: r 2510
    end: Observed
---
int: x 10
fn: probe () int
    return: ((x * 100) + (node \ x))
end: probe
fn: caller () int
    int: x 25
    return: (probe)
end: caller
int: r (caller)
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ r) r
end: main
main:
