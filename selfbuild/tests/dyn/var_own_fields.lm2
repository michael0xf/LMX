# Slice 292 (VAR-PATH-OF-SHORT-FN): an own field a method's body declares is a field of its var part -- the book, #method-parts
# (the own fields found in the body join the written var's as its fields; the place is physically in var, the body's statement
# reaches it and makes no second cell).  Its statement and initializer stay in the body and run when reached; laying it out
# opens no name before its declaration.  Under explicit data the body's uses of var's fields are requirements on the selected
# data (#ordinary-call), in native and walked code alike.  On the tuple of 291 every `\var\` path to a body's own field was
# refused at translation (unknown field path segment), and `call: t D` left D's field as it was.  Entry 7; 81.. name the check.
int: log 0
int: seen 0
int: code 7
fn: read_log () int
    return: node\log
end: read_log
fn: read_seen () int
    return: node\seen
end: read_seen
sub: note (int: v)
    node\log: node\log * 10 + v
end: note
fn: m () int
    int: a 5
    a: a + 1
    return: a
end: m
sub: s ()
    int: w 6
    w: w + 1
    node\seen: w
end: s
fn: early () int
    int: got a
    int: a 5
    return: got * 10 + a
end: early
fn: caller () int
    int: a 4
    return: early()
end: caller
fn: early_v () int (int: k 1)
    int: got a
    int: a 5
    return: got * 10 + a + k
end: early_v
fn: caller_v () int
    int: a 4
    return: early_v()
end: caller_v
fn: two () int
    note(2)
    return: 2
end: two
fn: ordered () int
    note(1)
    int: b two()
    return: b
end: ordered
fn: fact (int: n) int
    int: acc 1
    if: n > 1
        acc: n * fact(n - 1)
    ---
    return: acc
end: fact
fn: both () int (int: k 1)
    int: c k + 4
    c: c + 1
    return: c
end: both
D:
    int: a 0
end: D
sub: t ()
    int: a 5
    a: a + 1
end: t
E:
    int: k 10
end: E
fn: wv () int (int: k 1)
    k: k + 5
    return: k
end: wv
# A fn: its own field through var after the call, written there, and without the part.
if: m() != 6
    code: 81
---
if: code = 7 && m\var\a != 6
    code: 82
---
m\var\a: 40
if: code = 7 && m\var\a != 40
    code: 83
---
# The body's initializer runs when its line is reached: the next call sets the field again.
if: code = 7 && m() != 6
    code: 84
---
if: code = 7 && m\a != 6
    code: 85
---
# A sub, as a fn; its var given as the explicit data.
s()
if: code = 7 && read_seen() != 7
    code: 86
---
if: code = 7 && s\var\w != 7
    code: 87
---
call: s s\var
if: code = 7 && read_seen() != 7
    code: 88
---
# A read before the declaration is the hidden input, the caller's binding first; after it the own field.
if: code = 7 && caller() != 45
    code: 89
---
# With a written var part as well: the entry binds the written var's fields, not the body's own fields.
if: code = 7 && caller_v() != 46
    code: 97
---
# The effects in source order: the initializer runs at its line, not at the entry.
if: code = 7 && ordered() != 2
    code: 90
---
if: code = 7 && read_log() != 12
    code: 91
---
# One place, a working value per activation.
if: code = 7 && fact(5) != 120
    code: 92
---
# The written var's field and the body's: both fields of var.
if: code = 7 && both() != 6
    code: 93
---
if: code = 7 && (both\var\k != 1 || both\var\c != 6)
    code: 94
---
# Explicit data: the body's own field and a written var's field reach the selected data's fields of their names.
call: t D
if: code = 7 && D\a != 6
    code: 95
---
call: wv E
if: code = 7 && E\k != 15
    code: 96
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
