        receiving: lm_compiler_decl_contract(own_decl_cell[0][oi])
        if: receiving != 0 && receiving\kind = 2
            view_model: c.lm_compiler_own_nsty_get(oi)
            ni: view_model
            res: -1
            out\ni: ni
            out\res: res
        ---
    ---
    if: out\n = 0
        out\in_eternal: protected
        out\leaf_kind: 13
        out\leaf_model: ni
