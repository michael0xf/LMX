sub: main () (
    int: x 40
    int: y 41
    @: q int (@ (data \ x))
    int: seen 0
    int: published 0
    int: rseen 0
)
    @: r int (@ (data \ x))
    :=: q (@ (data \ y))
    :=: r (@ (data \ y))
    :=: seen (\ q)
    :=: published (\ (data \ q))
    :=: rseen (\ r)
end: main
main:
int: seen 41
int: published 40
int: rseen 41
int: q 41
int: r 41
