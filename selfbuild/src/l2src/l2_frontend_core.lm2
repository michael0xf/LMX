                return: (cast: (int) (1))
            if: n\as\frame\trailer != 0 && lm_compiler_tables_in_mode((cast: (const: @: c.LmP0Structure) (n\as\frame\trailer\body)), path, 0) != 0
                return: (cast: (int) (1))
