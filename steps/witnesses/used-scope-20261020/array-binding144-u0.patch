+    L2Path: value
+    int: saved l2_cur_mi
+    int: status
@@ -16048,12 +16051,8 @@ fn: l2_ab_collect (const: @(LmP0Node stmt); int: mi; const: @(char path)) int
-    if: declaration\candidate_count = 1 && declaration\candidate\value != 0 && declaration\candidate\value\kind = c.LM_P0_NODE_ATOM
-        own: l2_resolved_own(mi, declaration\candidate\value\as\atom)
-        if: own >= 0 && l2_own_is_array(l2_array_code(own)) != 0
-            contract: l2_binding_contract(mi, declaration\candidate\value\as\atom)
-    ---
-    if: contract = 0 && l2_indexed_operand(declaration\candidate, declaration\candidate_count, mi, indexed) = 0 && indexed\after = 0 && indexed\address = 0 && indexed\own >= 0
-        contract: l2_binding_contract(mi, l2_own_name[indexed\own])
-        if: contract != 0 && contract\kind = 1
-            contract: contract\operand
-        else:
-            contract: 0
-        ---
+    l2_cur_mi: mi
+    status: l2_path_resolve_value(declaration\candidate, declaration\candidate_count, @ value)
+    l2_cur_mi: saved
+    if: status = 0 && value.run_count = declaration\candidate_count && value.array_leaf != 0 && value.flat = 0
+        contract: value.leaf_level
+    l2_path_release(@ value)
+    if: l2_alloc_err != 0
+        return: l2_alloc_or(path, stmt, "cannot resolve an Array binding value")
@@ -30564,0 +30564,5 @@ fn: l2_path_steps_run (@: LmP0Field first; int: count; @: L2Path out) int
+return: l2_path_steps_operand(first, count, out, 0)
+
+# The same adapter also prepares a root value with zero steps. Requiring a
+# step is an interface of path-only callers, not another expression parser.
+fn: l2_path_steps_operand (@: LmP0Field first; int: count; @: L2Path out; int: allow_root) int
@@ -30585 +30589 @@ fn: l2_path_steps_run (@: LmP0Field first; int: count; @: L2Path out) int
-    if: count < 2 || f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || f\value\as\atom = 0 || f\value\as\atom\data = 0 || l2_ident_word(f\value\as\atom) = 0
+    if: count < 1 || f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_ATOM || f\value\as = 0 || f\value\as\atom = 0 || f\value\as\atom\data = 0 || l2_ident_word(f\value\as\atom) = 0
@@ -30586,0 +30591,9 @@ fn: l2_path_steps_run (@: LmP0Field first; int: count; @: L2Path out) int
+    if: count = 1
+        if: allow_root = 0
+            return: 2
+        out\text: f\value\as\atom\data
+        out\length: f\value\as\atom\length
+        out\source_first: f
+        out\run_count: 1
+        out\names_run: 1
+        return: 0
