Example:
    int[]: xs
    return: @
    run:
        throws: copy(FxSeqPush\append\throws) copy(record\throws)
        @[]: out []
        int: i 0
        while: i < length(xs)
            int: offset -1
            while: offset <= 1
                int: value xs[i] + offset
                if: value >= 0
                    int: j 0
                    while: j < length(out) && \out[j] != value
                        j += 1
                    if: j = length(out)
                        FxSeqPush\append(out; (value record))
                ---
                offset += 1
            ---
            i += 1
        return: out
