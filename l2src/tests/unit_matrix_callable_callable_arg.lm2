# FABLE-GROKBOT-MATRIX-20260924-143 cell: existing callable x callable arg
# (descriptor formal). CALL; result is the descriptor value itself.
fn: seven () int
    return: 7
end: seven

fn: apply (seven: g) int
    return: g
end: apply

int: r
r: apply(seven)
if: r != 7
    sendMessage: exit(exit_code: 11; stdout: ""; stderr: "")
    return
r: apply: seven
if: r != 7
    sendMessage: exit(exit_code: 12; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
