# A copy of a copy is called. Both copies hold the complete body of A; calling
# rb runs it over rb alone. The body rb holds is proved through the two
# declarations: rb is a whole copy of the row ra, ra a whole copy of A.
# Entry 7.
A:
    int: last 0
    last: 17
ra: merge: A
rb: merge: ra
rb
int: result 81
if: rb\last = 17 && ra\last = 0 && A\last = 0
    result: 7
sendMessage: exit(exit_code: result; stdout: ""; stderr: "")
return
