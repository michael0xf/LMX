predef: "l2src/lmx_settle.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_manager.lm1"
predef: "l2src/lmx_service.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

sub: rn_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: rn_check

fn: rn_child (@: LmxArena arena; @@: LmxMsg out_message) @: LmxThread
    @: Lmx graph lmx_node_new_owned(arena)
    @: LmxMsg message
    @: LmxPost mail
    @: LmxThread thread
    @: LmxSchedule slot
    \out_message: 0
    mail: (cast: (@: LmxPost) lmx_arena_take(arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    thread: (cast: (@: LmxThread) lmx_arena_take(arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD))
    slot: (cast: (@: LmxSchedule) lmx_arena_take(arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: graph = 0 || mail = 0 || thread = 0 || slot = 0
        return: 0
    ---
    message: lmx_thread_message(thread)
    if: lmx_post_init(arena, mail) != c.LMX_POST_OK || lmx_thread_init(arena, thread, graph, mail, slot) != c.LMX_THREAD_OK || lmx_schedule_init(slot, arena, (cast: (@: void) thread), 1000U) != c.LMX_SCHEDULE_OK
        return: 0
    ---
    message\running: 0
    message\success: 1
    message\handoff_ready: 1
    \out_message: message
return: thread

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: parent_arena
    LmxArena: arena_a
    LmxArena: arena_b
    @: Lmx graph
    @: LmxListDesc children
    @: LmxMsg parent_message
    @: LmxPost parent_mail
    @: LmxThread parent
    @: LmxSchedule parent_slot
    @: LmxThread a
    @: LmxThread b
    @: LmxMsg message
    int: failures
    memset((cast: (@: void) (@ parent_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ arena_a)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ arena_b)), 0, c.sizeof(c.LmxArena))
    rn_check(counts, lmx_arena_open(@ parent_arena) = 0 && lmx_arena_open(@ arena_a) = 0 && lmx_arena_open(@ arena_b) = 0, "arenas")
    graph: lmx_node_new_owned(@ parent_arena)
    children: lmx_list_new_owned(c.LMX_TYPE_ARRAY_OF_POINTER_BASE + c.LMX_DOMAIN_THREAD, @ parent_arena)
    parent_mail: (cast: (@: LmxPost) lmx_arena_take(@ parent_arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    parent: (cast: (@: LmxThread) lmx_arena_take(@ parent_arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD))
    parent_slot: (cast: (@: LmxSchedule) lmx_arena_take(@ parent_arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    parent_message: lmx_thread_message(parent)
    rn_check(counts, graph != 0 && children != 0 && lmx_arena_refs_open_owned(@ parent_arena, graph, 1U) = 0 && lmx_arena_ref_store(graph, 0U, (cast: (@: void) children)) = 0, "parent graph")
    rn_check(counts, lmx_post_init(@ parent_arena, parent_mail) = c.LMX_POST_OK && lmx_thread_init(@ parent_arena, parent, graph, parent_mail, parent_slot) = c.LMX_THREAD_OK && lmx_schedule_init(parent_slot, @ parent_arena, (cast: (@: void) parent), 1000U) = c.LMX_SCHEDULE_OK && lmx_thread_children_bind(parent, children, @ parent_arena) = c.LMX_THREAD_OK, "parent init")
    a: rn_child(@ arena_a, @ message)
    b: rn_child(@ arena_b, @ message)
    rn_check(counts, a != 0 && b != 0 && lmx_thread_child_add(parent, a, @ parent_arena) = c.LMX_THREAD_OK && lmx_thread_child_add(parent, b, @ parent_arena) = c.LMX_THREAD_OK, "two children")
    rn_check(counts, lmx_thread_child_count(parent) = 2U && children\len = 2U, "single membership array")
    rn_check(counts, lmx_settle_children(parent, @ parent_arena, 0, 0, 1U) = c.LMX_SETTLE_OK, "settle compacted array")
    rn_check(counts, lmx_thread_child_count(parent) = 0U && children\len = 0U, "both removed before release")
    rn_check(counts, lmx_arena_release(@ parent_arena) = 0, "parent release")
    failures: counts[1]
    c.printf("lmx_settle_reads_node: %d checks, %d failures\n", counts[0], failures)
    free(counts)
return: failures
