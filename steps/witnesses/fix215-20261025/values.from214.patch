+fn: lmx_walk_prim_source_check (@: f c.LmxWalkFrame; @: code c.Lmx) int
+    c.LmxScratchMark: mark
+    @: pm c.LmxScratchMark 0
+    @: source c.Lmx 0
+    @: owner c.Lmx 0
+    @: home c.LmxArena 0
+    @: room void 0
+    @: first_room void 0
+    @: last_room void 0
+    size_t: count 0U
+    size_t: ordinal 0U
+    size_t: first 0U
+    size_t: last 0U
+    size_t: n 0U
+    int: status 0
+    if: f = 0 || code = 0
+        return: c.LMX_WALK_INVALID
+    @: fields c.VoidArray @ code\array
+    if: fields\size < 3U
+        return: c.LMX_WALK_INVALID
+    source: (cast: (@: c.Lmx) c.lmx_graph_value_in(f\arena, code, 2U))
+    if: source = 0
+        return: c.LMX_WALK_OK
+    home: (cast: (@: c.LmxArena) c.lmx_range_home(f\arena, (cast: (@: void) code)))
+    if: home = 0 || c.lmx_graph_node_in(f\arena, (cast: (@: void) source)) = 0 || lmx_walk_kind(f, (cast: (@: void) source)) != c.LMX_KIND_STRUCT || c.lmx_range_home(f\arena, (cast: (@: void) source)) != home || source\parent != code || lmx_walk_node(f, (cast: (@: void) source)) != c.LMX_WALK_OP_NONE
+        return: c.LMX_WALK_INVALID
+    status: lmx_walk_source_find(f, source, 0, home, @ owner, @ count, @ ordinal, @ first, @ last)
+    if: status != c.LMX_WALK_OK
+        return: status
+    n: fields\size - 3U
+    if: n = 0U
+        return: c.LMX_WALK_OK
+    @: context c.LmxWalkContext (cast: (@: c.LmxWalkContext) f\context)
+    if: context = 0
+        return: c.LMX_WALK_INVALID
+    @: scratch c.LmxScratch (cast: (@: c.LmxScratch) context\scratch)
+    if: scratch = 0 || n > (cast: (size_t) -1) / c.sizeof(owner) || n > (cast: (size_t) -1) / c.sizeof(n)
+        return: c.LMX_WALK_INVALID
+    pm: @ mark
+    if: c.lmx_scratch_mark(scratch, pm) != c.LMX_SCRATCH_OK
+        return: c.LMX_WALK_INVALID
+    if: c.lmx_scratch_take(scratch, n * c.sizeof(owner), @ room) != c.LMX_SCRATCH_OK || room = 0
+        status: c.LMX_WALK_NOMEM
+    else:
+        c.memset(room, 0, n * c.sizeof(owner))
+        if: c.lmx_scratch_take(scratch, n * c.sizeof(n), @ first_room) != c.LMX_SCRATCH_OK || first_room = 0 || c.lmx_scratch_take(scratch, n * c.sizeof(n), @ last_room) != c.LMX_SCRATCH_OK || last_room = 0
+            status: c.LMX_WALK_NOMEM
+        else:
+            status: lmx_walk_prim_source_actuals(f, code, source, home, (cast: (@@: c.Lmx) room), (cast: (@: size_t) first_room), (cast: (@: size_t) last_room))
+        ---
+    ---
+    if: c.lmx_scratch_rewind(scratch, pm) != c.LMX_SCRATCH_OK && status = c.LMX_WALK_OK
+        status: c.LMX_WALK_INVALID
+    return: status
+end: lmx_walk_prim_source_check
+
+# Stable written-source order, independent of the PRIM ABI input-slot order.
+# Validation/sorting never executes actuals; absent actuals retain ordinal0.
+fn: lmx_walk_prim_source_order (@: f c.LmxWalkFrame; @: code c.Lmx; @: firsts size_t; @: order size_t) int
+    @: source c.Lmx 0
+    @: owner c.Lmx 0
+    @: home c.LmxArena 0
+    @: actual void 0
+    size_t: count 0U
+    size_t: ordinal 0U
+    size_t: first 0U
+    size_t: last 0U
+    size_t: n 0U
+    size_t: i 0U
+    size_t: j 0U
+    size_t: previous 0U
+    int: moving 0
+    int: status 0
+    if: f = 0 || code = 0 || firsts = 0 || order = 0
+        return: c.LMX_WALK_INVALID
+    @: fields c.VoidArray @ code\array
+    if: fields\size < 3U
+        return: c.LMX_WALK_INVALID
+    source: (cast: (@: c.Lmx) c.lmx_graph_ref_struct_in(f\arena, code, 2U))
+    home: (cast: (@: c.LmxArena) c.lmx_range_home(f\arena, (cast: (@: void) code)))
+    if: source = 0 || home = 0
+        return: c.LMX_WALK_INVALID
+    n: fields\size - 3U
+    while: i < n
+        actual: (cast: (@: void) c.lmx_graph_value_in(f\arena, code, 3U + i))
+        first: 0U
+        if: actual != 0
+            owner: 0
+            count: 0U
+            ordinal: 0U
+            last: 0U
+            status: lmx_walk_source_find(f, source, actual, home, @ owner, @ count, @ ordinal, @ first, @ last)
+            if: status != c.LMX_WALK_OK || count != 1U || owner = 0 || first = 0U
+                return: c.LMX_WALK_INVALID
+        ---
+        firsts[i]: first
+        j: i
+        moving: 1
+        while: j > 0U && moving != 0
+            previous: order[j - 1U]
+            if: firsts[previous] > first
+                order[j]: previous
+                j: j - 1U
+            else:
+                moving: 0
+            ---
+        ---
+        order[j]: i
+        i: i + 1U
+    ---
+    return: c.LMX_WALK_OK
+end: lmx_walk_prim_source_order
