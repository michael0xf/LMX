predef: "lmx_arena_blocks.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdlib.h>"

# All list access requires exclusive ownership supplied by the caller. Detect
# cycles before mutation; no allocator, global registry or synchronization here.
#
# This module owns storage and nothing else: it holds no type and reads no table.
# The arena decides what an entry means -- it retires the index entry of a block
# before the block leaves its list (lmx_arena_drop) -- so ownership and typing stay
# in step without this module knowing either.
fn: lmx_arena_blocks_tail (@: LmxArenaBlock head; @@: LmxArenaBlock tail) int
    @: LmxArenaBlock slow
    @: LmxArenaBlock fast
    slow: head
    fast: head
    \tail: 0
    while: fast != 0
        fast: fast\next
        if: fast = 0
            break
        fast: fast\next
        slow: slow\next
        if: fast = slow
            return: LMX_ARENA_BLOCKS_INVALID
    ---
    while: head != 0
        \tail: head
        head: head\next
    ---
    return: LMX_ARENA_BLOCKS_OK

# Prepend one already allocated, detached node. Reject malformed/duplicate
# attachment without changing either the list or the caller's node.
fn: lmx_arena_blocks_push (@@: LmxArenaBlock head; @: LmxArenaBlock node) int
    @: LmxArenaBlock tail
    if: head = 0 || node = 0
        return: LMX_ARENA_BLOCKS_INVALID
    if: node\next != 0 || head = @ node\next
        return: LMX_ARENA_BLOCKS_INVALID
    if: node\base = 0 && node\n != 0U
        return: LMX_ARENA_BLOCKS_INVALID
    if: lmx_arena_blocks_tail(\head, @ tail) != LMX_ARENA_BLOCKS_OK
        return: LMX_ARENA_BLOCKS_INVALID
    if: tail = node
        return: LMX_ARENA_BLOCKS_INVALID
    node\next: \head
    \head: node
    return: LMX_ARENA_BLOCKS_OK

# Detach one exact member; keep its allocation and graph payload untouched.
# The caller decides reachability; the arena retires the entry before calling this.
fn: lmx_arena_blocks_remove (@@: LmxArenaBlock head; @: LmxArenaBlock node) int
    @: LmxArenaBlock tail
    @: LmxArenaBlock entry
    @@: LmxArenaBlock slot head
    if: head = 0 || node = 0
        return: LMX_ARENA_BLOCKS_INVALID
    if: lmx_arena_blocks_tail(\head, @ tail) != LMX_ARENA_BLOCKS_OK
        return: LMX_ARENA_BLOCKS_INVALID
    entry: \slot
    while: entry != 0
        if: entry = node
            \slot: entry\next
            entry\next: 0
            return: LMX_ARENA_BLOCKS_OK
        ---
        slot: @ entry\next
        entry: \slot
    ---
    return: LMX_ARENA_BLOCKS_INVALID

# Read-only preflight, also usable before attaching a separately prepared block.
# Valid acyclic lists intersect iff their non-null tails are identical.
fn: lmx_arena_blocks_can_move (@@: LmxArenaBlock dst; @@: LmxArenaBlock src) int
    @: LmxArenaBlock src_tail
    @: LmxArenaBlock dst_tail
    if: dst = 0 || src = 0 || dst = src
        return: LMX_ARENA_BLOCKS_INVALID
    if: lmx_arena_blocks_tail(\src, @ src_tail) != LMX_ARENA_BLOCKS_OK
        return: LMX_ARENA_BLOCKS_INVALID
    if: lmx_arena_blocks_tail(\dst, @ dst_tail) != LMX_ARENA_BLOCKS_OK
        return: LMX_ARENA_BLOCKS_INVALID
    if: src_tail = 0
        return: LMX_ARENA_BLOCKS_OK
    if: src_tail = dst_tail
        return: LMX_ARENA_BLOCKS_INVALID
    return: LMX_ARENA_BLOCKS_OK

# Preserve each list's order, put src before dst, and clear the source owner.
# Checking metadata is linear; transfer itself changes three pointers only.
fn: lmx_arena_blocks_move_all (@@: LmxArenaBlock dst; @@: LmxArenaBlock src) int
    @: LmxArenaBlock src_tail
    if: lmx_arena_blocks_can_move(dst, src) != LMX_ARENA_BLOCKS_OK
        return: LMX_ARENA_BLOCKS_INVALID
    lmx_arena_blocks_tail(\src, @ src_tail)
    if: src_tail = 0
        return: LMX_ARENA_BLOCKS_OK
    src_tail\next: \dst
    \dst: \src
    \src: 0
    return: LMX_ARENA_BLOCKS_OK

# Detach the owner's whole list before invoking any disposer. Repeating cleanup
# (including reentry using this same head) sees an empty list, never freed nodes.
# Payload aliases/OS users must already be settled by the Message lifecycle.
fn: lmx_arena_blocks_dispose_all (@@: LmxArenaBlock head) int
    @: LmxArenaBlock node
    @: LmxArenaBlock next
    @: LmxArenaBlock tail
    LmxArenaBlockDisposer: disposer
    if: head = 0
        return: LMX_ARENA_BLOCKS_INVALID
    if: lmx_arena_blocks_tail(\head, @ tail) != LMX_ARENA_BLOCKS_OK
        return: LMX_ARENA_BLOCKS_INVALID
    node: \head
    \head: 0
    while: node != 0
        next: node\next
        disposer: node\dispose
        if: disposer != 0
            disposer(node\base, node\n)
        else:
            free(node\base)
        ---
        free(node)
        node: next
    ---
    return: LMX_ARENA_BLOCKS_OK
