# K03 NS-ROLES-1 (Codex K03-S5-MIGRATION-20261007-06 (b), K03-S5-ALIAS-VISIBILITY-20261007-07; docs/LMX_semantics.en.md
# :666, :834, L2_spec_en.md:206): for absent b, `b: A` with A an existing Structure introduces b as a reference to A --
# no copy, no reparent: a write through b is a write of A.
# A reference binding's value is a Structure: b: a references what a references (Model); a formal of Model too.
# Exit 7; 81 if b missed Model, 82 if p's binding missed the caller's Model.
Model:
    int: v 1
end: Model
fn: put (Model: p) int
    q: p
    q\v: 8
    return: 0
end: put
fn: m () int
    a: Model
    b: a
    b\v: 6
    if: Model\v != 6
        return: 81
    put(Model)
    if: Model\v != 8
        return: 82
    return: 7
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
