B:
    size_t: y 42U
end: B

A:
    fn: M
    size_t: tag 7U
end: A

size_t: tag 3U

fn: M () size_t
    size_t: v
    v: node\tag
    return: v
end: M

# q20-next.md §2 (Q22 = II): `A\M()`, `R\M()` and `Q\M()` all read the file's tag, 3.  In Q the
# callable is in the SECOND operand, after B's field: merge keeps the occurrence's address there too.
# The merges are in a method: at the walked root a merge statement is root-pending
# (FABLE-OPUS-MERGE-PARTS-20260926-193 T1).  Success is 5.
fn: probe () int
    size_t: t0
    size_t: t1
    size_t: t2
    R: merge: A
    t0: A\M()
    Q: merge: B A
    t1: R\M()
    t2: Q\M()
    if: t0 != 3U
        return: 80
    if: t1 != 3U
        return: 81
    if: t2 != 3U
        return: 82
    return: 5
end: probe

sendMessage: exit(exit_code: probe(); stdout: ""; stderr: "")
return
