include: "<stddef.h>"
predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_arena.h.lm1"

# lmx_call.h.lm1 - calling a Structure in head position (spec 7.1, 21.2, 21.8 and 21.13.4;
# k.4, next_core_tasks.md §3 item 8: the `Lmx.native` word).
#
# The graph callable itself is an ordinary Structure: `Lmx.native` is a direct reference to
# its native body implementation (the C entry), or null when there is none -- any Structure
# can be interpreted, a native form is never required.  It is not a lexical element and not
# a graph field/child slot (lmx.h.lm1); a callable's own declared fields (args/return/body,
# in lexical order) are its later slots from 0, `M.parent` is its immediate structural
# parent, and there is no reserved slot and no separate descriptor to classify.
#
# There is no separate "is this callable" question any more: dispatch is the word alone,
# and a refusal is the translator's business (§3 item 8, "отказ — дело транслятора"), not a
# domain check here.
#
# The selected occurrence's native word names its uniform ABI adapter. The adapter
# receives owner=self, ordered declared-width value storage, and dest/out for the
# result; its return is status. It invokes the implementation's typed body with
# reserved node=self.parent, self, and the declared/dynamic values.
#
# The ORDER of the arguments is settled, not open: spec 518 -- the signature "begins with
# reserved `Lmx *node` and lists declared/dynamic values in DETERMINISTIC ORDER"; the CALLER
# (the translator) knows its own argument order, because it wrote the signature.
#
# The translator resolves source compatibility and structural admission. The walker
# uses the call's physical args/return contract for exact-width ABI marshalling;
# this dispatcher does not infer types from payload addresses or callback identity.
# Host/root entries that are not graph callables may still use the one-node shape below.
fnptr: LmxCallEntry (@: Lmx node) int
# Optional walker for native == 0 (installed by lmx_walk / program bind).
fnptr: LmxCallWalkFn (@: LmxArena arena; @: Lmx callable) int
# -194 к.4 (G-call): the dynamic-call counterpart of LmxCallWalkFn, for lmx_call_prim's
# own addr=0 branch alone -- lmx_call0's two call sites keep the narrow nullary hook
# above; a native-0 callee reached THROUGH a dynamic call carries real data/args/a typed
# dest, which LmxCallWalkFn's shape has no room for.  Same signature as lmx_call_prim
# itself.
fnptr: LmxCallPrimWalkFn (@: LmxArena arena; @: Lmx code; @: Lmx data; @@: void refs; size_t: nargs; @: void dest; @@: void out) int

define: LMX_CALL_OK 0
define: LMX_CALL_INVALID 1
# k.4: not a Structure.  There is no separate "callable" shape any more -- any Structure
# in head position executes (Lmx.native non-null -> native, null -> walk).
define: LMX_CALL_NOT_CALLABLE 2
# D-37: must match lmx_walk.h.lm1 -- walker error codes 1..7 are X1 at
# lmx_call_note_walk_fail; throws arrive as LMX_CALL_WALK_THROWN + k.
define: LMX_CALL_WALK_ERR_LO 1
define: LMX_CALL_WALK_ERR_HI 7
define: LMX_CALL_WALK_THROWN 8

prototype:
    # k.4: is this value a Structure at all -- the only question left, asked of the arena's
    # index.  There is no separate "callable" shape to distinguish any more.
    fn: lmx_call_ready (@: LmxArena arena; @: Lmx callable) int
    # The reserved source `node` of a call on this callable: the lexical space above the method.
    # For the selected method occurrence M this is M.parent; nested bodies inside M have their
    # own structural parent chain and do not change the activation's reserved `node`.
    fn: lmx_call_node (@: Lmx callable) @: Lmx
    # The call, for the zero-source-argument shape.  Dispatch is by Lmx.native alone:
    # non-null is the method's trampoline, through a local dest; a nonzero status is its
    # throw status, noted like a walk's.  Null walks the occurrence body
    # (lmx_walk_run_occurrence); the result is the last evaluated expression.
    fn: lmx_call_install_walk (LmxCallWalkFn: fn) void
    fn: lmx_call_walk_ready () int
    # Nonzero when the installed walk reports turn-body status (L3), not an activation int (L2).
    fn: lmx_call_walk_returns_status () int
    fn: lmx_call_install_walk_status (LmxCallWalkFn: fn) void
    # G2: last call0 walk_run failure status (0 if success / not walked). Set by walk dispatch.
    fn: lmx_call_walk_fail_status () int
    fn: lmx_call_note_walk_fail (int: st) void
    fn: lmx_call_clear_walk_fail () void
    fn: lmx_call0 (@: LmxArena arena; @: Lmx callable) int
    # Dispatch the selected complete occurrence: nonzero native invokes its adapter;
    # zero native invokes the installed walk hook on the same occurrence. Ordinary
    # callers pass the same Structure as code and data; no separate data graph is built.
    # Return is success or the callee's throw status; values travel through dest/out.
    # A stopped Message returns status zero with out absent. The caller must unwind
    # on poll_escape before consuming result storage; no stopped value is fabricated.
    # refs[k] is value storage, not a held pointer; null storage is absent and
    # a pointer payload of zero is present-null. A code that is not a callable
    # occurrence is the caller's broken promise (X1).
    fn: lmx_call_prim (@: LmxArena arena; @: Lmx code; @: Lmx data; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    fn: lmx_call_install_prim_walk (LmxCallPrimWalkFn: fn) void
end: prototype
