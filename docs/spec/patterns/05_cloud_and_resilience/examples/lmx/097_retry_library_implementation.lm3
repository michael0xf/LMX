RetryLibrary:
    copy: sys\OPERANDS_TEMPLATE
    return: int
    retry:
        throws: Attempts
        if: length(right) < 1 || length(right) > 2
            throw: Attempts()
        int: limit \right[0]
        if: limit < 1 || limit > 31
            throw: Attempts()
        @: request \left
        int: attempt 0
        int: pause 1
        while: attempt < limit
            int: status request()
            if: status != 503
                return: status
            attempt += 1
            if: attempt < limit && length(right) = 2
                @: wait \right[1]
                wait(pause)
                pause *= 2
        ---
        return: 503
