Model:
    size_t: value 1U
end: Model

# Each explicit merge executes at its source statement. Both calls start
# from Model's value 1, mutate their own copy to 2, and leave Model unchanged.
# Reusing the previous result fails the next call's initial-value check.
fn: build () int
    fresh_branch_xyz: merge Model
    if: fresh_branch_xyz\value != 1U
        return: 81
    fresh_branch_xyz\value: fresh_branch_xyz\value + 1U
    if: fresh_branch_xyz\value != 2U
        return: 82
    return: 7
end: build

int: got1
int: got2
got1: build()
if: got1 != 7
    sendMessage: exit(exit_code: 95; stdout: ""; stderr: "")
    return
got2: build()
if: got2 != 7
    sendMessage: exit(exit_code: 96; stdout: ""; stderr: "")
    return
if: Model\value != 1U
    sendMessage: exit(exit_code: 97; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
