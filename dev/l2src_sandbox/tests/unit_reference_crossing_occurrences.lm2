Model: (int: xFirst 11; int: xLast 12)
Holder: (@: ref Model)
Candidate: (int: pad 19; int: xFirst 20; int: xLast 30)
Holder\ref: Candidate
fn: check () int
    if: Holder\ref\xLast != 30 || Holder\ref\xFirst != 20
        return: 81
    if: @Holder\ref\xFirst != @Candidate\xFirst || @Holder\ref\xLast != @Candidate\xLast
        return: 82
    Holder\ref\xFirst: 41
    Holder\ref\xLast: 61
    if: Candidate\xFirst != 41 || Candidate\xLast != 61 || Candidate\pad != 19
        return: 83
    if: Model\xFirst != 11 || Model\xLast != 12
        return: 84
return: 7
sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
