predef: "l3_interp/l3_thread.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_perm.lm1"
predef: "l2src/lmx_call.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_manager.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_gc.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_clock.lm1"
predef: "l2src/lmx_plan.lm1"
predef: "l2src/lmx_scratch.lm1"
predef: "l2src/lmx_walk.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# Interpreted turn: l3_thread_dispatch -> lmx_interp_apply -> lmx_walk_run.
# Native entry unused. Graph/Message/method not copied.

sub: fail (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: fail

int: native_hits 0

fn: native_noop (@: Lmx node) int
    native_hits: native_hits + 1
return: 0

fn: mk_dummy (@: LmxArena a) @: Lmx
    @: Lmx m
    @: LmxCallable info
    m: lmx_node_new_owned(a)
    info: lmx_callable_new_owned(a)
    if: m = 0 || info = 0 || lmx_arena_refs_open_owned(a, m, 1U) != 0
        return: 0
    lmx_arena_ref_store(m, 0U, (cast: (@: void) info))
return: m

fn: mk_walk_void (@: LmxArena a; @: Lmx roles) @: Lmx
    @: Lmx unit
    @: Lmx m
    @: LmxCallable info
    @: Lmx ret
    unit: lmx_node_new_owned(a)
    if: unit = 0 || lmx_arena_refs_open_owned(a, unit, 1U) != 0
        return: 0
    m: lmx_walk_plain(a, unit, 2U)
    info: lmx_callable_new_owned(a)
    if: m = 0 || info = 0 || roles = 0
        return: 0
    if: lmx_arena_ref_store(unit, 0U, (cast: (@: void) m)) != 0
        return: 0
    if: lmx_arena_ref_store(m, 0U, (cast: (@: void) info)) != 0
        return: 0
    ret: lmx_walk_frame(a, roles, m, c.LMX_WALK_OP_RET, 1U)
    if: ret = 0 || lmx_arena_ref_store(m, 1U, (cast: (@: void) ret)) != 0
        return: 0
return: m

fn: mk_thread (@: LmxArena arena; @: Lmx graph; @@: LmxThread out_t) int
    @: LmxMsg message
    @: LmxThread t
    @: LmxPost mail
    @: LmxSchedule sched
    \out_t: 0
    message: (cast: (@: LmxMsg) lmx_arena_take(arena, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
    t: (cast: (@: LmxThread) lmx_arena_take(arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_THREAD, c.LMX_DOMAIN_THREAD))
    mail: (cast: (@: LmxPost) lmx_arena_take(arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    sched: (cast: (@: LmxSchedule) lmx_arena_take(arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: message = 0 || t = 0 || mail = 0 || sched = 0
        return: 0
    message\running: 1
    message\success: 0
    message\handoff_ready: 0
    message\graph: graph
    message\index: 1U
    if: lmx_post_init(arena, mail) != c.LMX_POST_OK || lmx_thread_attach(t, message, mail, sched) != c.LMX_THREAD_OK
        return: 0
    if: lmx_schedule_init(sched, arena, (cast: (@: void) t), 1000U) != c.LMX_SCHEDULE_OK
        return: 0
    \out_t: t
return: 1

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: arena
    LmxArena: store
    LmxArena: unbound_arena
    LmxArena: other_arena
    LmxArena: other_store
    @: LmxArena a 0
    @: Lmx dummy 0
    @: Lmx graph 0
    @: LmxThread t 0
    @: LmxThread unbound_t 0
    @: LmxThread other_t 0
    @: LmxMsg msg 0
    @: Lmx roles 0
    @: Lmx plan_roles 0
    @: void ret_record 0
    if: counts = 0
        return: 2
    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ unbound_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ other_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ other_store)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0 || lmx_arena_open(@ unbound_arena) != 0 || lmx_arena_open(@ other_arena) != 0
        fputs("l3_thread_bind: arena\n", l1_stdout())
        free(counts)
        return: 2
    ---
    # The Message arena is bound to a permanent store, as every arena of a root is; a second
    # arena has none and a third is bound to ANOTHER runtime's store.
    if: lmx_perm_open(@ store) != 0 || lmx_perm_open(@ other_store) != 0 || lmx_perm_bind(@ arena, @ store) != 0 || lmx_perm_bind(@ other_arena, @ other_store) != 0
        fputs("l3_thread_bind: store\n", l1_stdout())
        free(counts)
        return: 2
    ---
    a: @ arena
    dummy: mk_dummy(a)
    if: dummy = 0 || mk_thread(a, dummy, @ t) = 0
        free(counts)
        return: 2
    ---
    if: mk_thread(@ unbound_arena, mk_dummy(@ unbound_arena), @ unbound_t) = 0 || mk_thread(@ other_arena, mk_dummy(@ other_arena), @ other_t) = 0
        free(counts)
        return: 2
    ---
    fail(counts, lmx_thread_request_mode(t, c.LMX_THREAD_MODE_INTERPRETED) = c.LMX_THREAD_OK, "request interpreted")
    fail(counts, lmx_thread_turn(t, native_noop, 1U) = c.LMX_THREAD_OK, "first turn is still native until endturn")
    fail(counts, native_hits = 1, "native handler ran once to commit the request")
    fail(counts, lmx_thread_mode(t) = c.LMX_THREAD_MODE_INTERPRETED, "endturn committed interpreted")
    fail(counts, lmx_thread_turn(t, 0, 2U) = c.LMX_THREAD_INVALID, "interpreted without bind is not native fallback")
    # An arena with no store is refused BEFORE anything is assigned: nothing is bound yet, and
    # nothing is after it.
    fail(counts, l3_thread_bind(unbound_t) = c.LMX_THREAD_INVALID, "bind on an arena with no permanent store is refused")
    fail(counts, l3_thread_roles(unbound_t) = 0 && l3_thread_plan_roles(unbound_t) = 0, "the refused bind assigned nothing")
    fail(counts, l3_thread_bind(t) = c.LMX_THREAD_OK, "bind walk dispatch")
    roles: l3_thread_roles(t)
    plan_roles: l3_thread_plan_roles(t)
    fail(counts, roles != 0 && plan_roles != 0, "standard walk roles, in the bound store")
    # The roles' home is the store, by ADDRESS RANGE: no flag is read for it.
    fail(counts, lmx_range_home(a, (cast: (@: void) roles)) = @ store && lmx_range_pool(a, (cast: (@: void) roles)) = 0, "the role table's home is the store, not the arena's pool")
    fail(counts, lmx_range_home(a, (cast: (@: void) plan_roles)) = @ store && lmx_range_pool(a, (cast: (@: void) plan_roles)) = 0, "the plan-role table's home is the store, not the arena's pool")
    ret_record: lmx_arena_ref_value(roles, (cast: (size_t) c.LMX_WALK_OP_RET))
    fail(counts, ret_record != 0 && lmx_range_home(a, ret_record) = @ store && lmx_range_pool(a, ret_record) = 0, "a role RECORD's home is the store too")
    # Another runtime's store holds other records.  Refused, and the thread that IS bound keeps
    # its binding and its records: the refusal comes before any assignment.
    fail(counts, l3_thread_bind(other_t) = c.LMX_THREAD_INVALID, "bind on an arena of a different store is refused")
    fail(counts, l3_thread_roles(other_t) = 0 && l3_thread_roles(t) = roles && l3_thread_plan_roles(t) = plan_roles, "the refused bind left the bound thread and its tables alone")
    fail(counts, l3_thread_bind(unbound_t) = c.LMX_THREAD_INVALID && l3_thread_roles(t) = roles, "a storeless bind after a good one is still refused and unbinds nothing")
    # The store is never collected, so the tables are opened ONCE per store.
    fail(counts, l3_thread_bind(t) = c.LMX_THREAD_OK && l3_thread_roles(t) = roles && l3_thread_plan_roles(t) = plan_roles, "a repeated bind hands out the same tables")
    fail(counts, lmx_arena_ref_value(l3_thread_roles(t), (cast: (size_t) c.LMX_WALK_OP_RET)) = ret_record, "and the same RET record")
    graph: mk_walk_void(a, l3_thread_roles(t))
    msg: t\message
    fail(counts, graph != 0 && msg != 0, "walk body")
    msg\graph: graph
    fail(counts, t\message\graph = graph, "graph pointer installed, not copied")
    fail(counts, lmx_thread_turn(t, native_noop, 3U) = c.LMX_THREAD_OK, "interpreted turn via lmx_walk")
    fail(counts, native_hits = 1, "native handler not used on interpreted turn")
    fail(counts, lmx_thread_mode(t) = c.LMX_THREAD_MODE_INTERPRETED, "one mode for the turn")
    fail(counts, lmx_thread_turn(t, native_noop, 4U) = c.LMX_THREAD_OK, "second interpreted turn")
    fail(counts, native_hits = 1, "still no native fallback")
    # Two turn boundaries have collected the arena.  The tables are not the arena's to collect.
    fail(counts, l3_thread_roles(t) = roles && l3_thread_plan_roles(t) = plan_roles, "two turns later the tables are the same tables")
    fail(counts, lmx_range_classify(a, (cast: (@: void) roles)) = c.LMX_KIND_STRUCT && lmx_range_classify(a, (cast: (@: void) plan_roles)) = c.LMX_KIND_STRUCT, "and still Structures by the arena's ranges")
    fail(counts, lmx_arena_ref_value(roles, (cast: (size_t) c.LMX_WALK_OP_RET)) = ret_record && lmx_range_classify(a, ret_record) = c.LMX_DOMAIN_KIND_OP, "and RET is the same live OP record")
    fail(counts, lmx_perm_close(@ store) = 0 && lmx_perm_close(@ other_store) = 0, "both stores closed once")

    if: counts[1] != 0
        c.printf("%d failed of %d\n", counts[1], counts[0])
        free(counts)
        return: 1
    ---
    c.printf("l3_thread_bind: %d checks\n", counts[0])
    free(counts)
return: 0
