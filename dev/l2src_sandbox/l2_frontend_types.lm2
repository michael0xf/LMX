    return: (cast: (int) (0))
end: lm_compiler_contract_formal_here

fn: lm_compiler_contract_own (@: contract c.L2TypeContract) int
    int: ty
    int: depth
    int: qualified
    @: word c.LmP0Text
    if: contract = 0
        return: (cast: (int) (0))
    if: contract\kind = 1
        if: contract\operand = 0
            return: (cast: (int) (0))
        if: contract\operand\kind = 2
            if: lm_compiler_contract_formal((cast: (@: c.L2TypeContract) (contract\operand)), @ ty) != 0
                return: (cast: (int) (0))
            return: (cast: (int) (c.lm_compiler_oc_parray(ty)))
        ---
        # R5-3a: `[]` over `[]` -- an own Array of descriptors, its levels and leaf the contract's.
        if: contract\operand\kind = 1
            return: (cast: (int) (c.lm_compiler_oc_darray()))
        if: contract\operand\kind != 0
            return: (cast: (int) (0))
        word: contract\operand\word
        if: c.lm_compiler_text_eq(word, "int") != 0
            return: (cast: (int) (4))
        if: c.lm_compiler_text_eq(word, "char") != 0
            return: (cast: (int) (5))
        if: c.lm_compiler_text_eq(word, "size_t") != 0
            return: (cast: (int) (7))
        if: c.lm_compiler_text_eq(word, "ulong") != 0
            return: (cast: (int) (37))
        return: (cast: (int) (0))
    ---
    word: c.lm_compiler_contract_leaf(contract, @ depth, @ qualified)
    if: word = 0
        return: (cast: (int) (0))
    if: depth > 0
        if: lm_compiler_contract_formal(contract, @ ty) != 0
            return: (cast: (int) (0))
        return: (cast: (int) (c.lm_compiler_own_ty_of_param(ty)))
    if: qualified != 0
        return: (cast: (int) (0))
    if: c.lm_compiler_text_eq(word, "int") != 0
        return: (cast: (int) (3))
    if: c.lm_compiler_text_eq(word, "char") != 0
        return: (cast: (int) (1))
    if: c.lm_compiler_text_eq(word, "size_t") != 0
        return: (cast: (int) (2))
    if: c.lm_compiler_text_eq(word, "unsigned") != 0
        return: (cast: (int) (6))
    if: c.lm_compiler_text_eq(word, "ulong") != 0
        return: (cast: (int) (36))
    return: (cast: (int) (0))
end: lm_compiler_contract_own

fn: lm_compiler_colon_bound_ty (int: mi; const: (@: name c.LmP0Text); @: out_ty int) int
    @@: own_ty_cell int (cast: (@@: int) (@ c.l2_own_ty))
    @@: st_cell int (cast: (@@: int) (@ c.l2_st))
    int: i
    if: name = 0 || out_ty = 0
        return: (cast: (int) (1))
    i: c.lm_compiler_resolved_own(mi, name)
    if: i >= 0
        \out_ty: c.lm_compiler_value_ft_of_own(own_ty_cell[0][i])
        return: (cast: (int) (0))
    i: c.lm_compiler_formal_find(mi, name)
    if: i >= 0
        \out_ty: c.lm_compiler_ft(mi, i)
        return: (cast: (int) (0))
    if: c.lm_compiler_mad_host_of(mi) >= 0
        i: c.lm_compiler_formal_find(c.lm_compiler_mad_host_of(mi), name)
        if: i >= 0
            \out_ty: c.lm_compiler_ft(c.lm_compiler_mad_host_of(mi), i)
            return: (cast: (int) (0))
        # T6b: a field the host declares at method level is its activation too.
        i: c.lm_compiler_mad_host_own(c.lm_compiler_mad_host_of(mi), name)
        if: i >= 0
            \out_ty: c.lm_compiler_value_ft_of_own(own_ty_cell[0][i])
            return: (cast: (int) (0))
        ---
    i: c.lm_compiler_dyn_find(mi, name)
    if: i >= 0 && c.lm_compiler_dt(mi, i) != 0
        \out_ty: c.lm_compiler_ft_of_own(c.lm_compiler_own_of_dt(c.lm_compiler_dt(mi, i)))
        return: (cast: (int) (0))
    if: i >= 0
        return: (cast: (int) (1))
    i: c.lm_compiler_own_visible(mi, name)
    if: i >= 0
        \out_ty: c.lm_compiler_value_ft_of_own(own_ty_cell[0][i])
        return: (cast: (int) (0))
    i: lm_compiler_slot_find(mi, name)
    if: i >= 0
        \out_ty: st_cell[0][lm_compiler_slot_off(mi, i)]
        return: (cast: (int) (0))
    i: c.lm_compiler_ml_find(name)
    if: i >= 0
        \out_ty: lm_compiler_ml_value_ty(i)
        return: (cast: (int) (0))
    ---
    return: (cast: (int) (1))
end: lm_compiler_colon_bound_ty

fn: lm_compiler_own_layout (int: own) int
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@: ns_local_cell int (cast: (@@: int) (@ c.l2_ns_local))
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    @@@: own_decl_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_own_decl))
    @@: nsf_kind_cell int (cast: (@@: int) (@ c.l2_nsf_kind))
    @@: nsf_ref_cell int (cast: (@@: int) (@ c.l2_nsf_ref))
    @@@: nsf_fname_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_nsf_fname))
    @@@: own_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_own_name))
    int: model
    int: row
    if: own < 0 || own >= own_n_cell[0]
        return: (cast: (int) (-1))
    model: c.lm_compiler_own_nsty_get(own)
    if: model >= 0 && c.lm_compiler_source_definition_ns(own) = model
        return: (cast: (int) (model))
    if: model >= 0 && ns_local_cell[0][model] >= 0 && c.lm_compiler_own_of_local_ns(own_mi_cell[0][own], model) = own
        return: (cast: (int) (model))
    row: lm_compiler_ns_constructed_row(own_mi_cell[0][own], own_decl_cell[0][own])
    if: row >= 0 && nsf_kind_cell[0][row] = 2 && nsf_ref_cell[0][row] = model && nsf_fname_cell[0][row] = own_name_cell[0][own]
        return: (cast: (int) (model))
    return: (cast: (int) (-1))
end: lm_compiler_own_layout

fn: lm_compiler_node_of_text (const: (@: s c.LmP0Structure); const: (@: t c.LmP0Text)) @: c.LmP0Node
    @@: head_expressions_cell c.L2HeadExpression (cast: (@@: c.L2HeadExpression) (@ c.l2_head_expressions))
    @: f c.LmP0Field
    @: n c.LmP0Node
    @: r c.LmP0Node 0
    @: expression c.L2HeadExpression
    if: s = 0 || t = 0
        return: (cast: (@: c.LmP0Node) (0))
    # A call's actuals: the Frame that names an actual spells a formal of the
    # callee, never the free name looked for.
    f: c.lm_compiler_call_actuals(s)
    while: f != 0 && r = 0
        n: f\value
        if: n != 0 && n\as != 0 && n\kind = c.LM_P0_NODE_ATOM && c.lm_compiler_source_text(n\as\atom, t) != 0
            r: n
        if: r = 0 && n != 0 && n\as != 0 && n\kind = c.LM_P0_NODE_FRAME && n\as\frame != 0
            if: c.lm_compiler_source_text(n\as\frame\head, t) != 0
                r: n
            if: r = 0
                r: lm_compiler_node_of_text((cast: (const: @: c.LmP0Structure) (n\as\frame\body)), t)
            if: r = 0 && n\as\frame\trailer != 0
                r: lm_compiler_node_of_text((cast: (const: @: c.LmP0Structure) (n\as\frame\trailer\body)), t)
            # A compact head's expression belongs to this original Frame,
            # although P0 parsed its bytes into a separately owned document.
            # Every source-use query sees that same retained tree. Otherwise
            # a real read in an index looks like a forward-only hidden input.
            expression: head_expressions_cell[0]
            while: r = 0 && expression != 0
                if: expression\source = n
                    r: lm_compiler_node_of_text((cast: (const: @: c.LmP0Structure) (expression\body)), t)
                expression: expression\allocated_next
            ---
            ---
        if: r = 0 && n != 0 && n\as != 0 && n\kind = c.LM_P0_NODE_STRUCTURE
            r: lm_compiler_node_of_text((cast: (const: @: c.LmP0Structure) (n\as\structure)), t)
        f: f\next
    if: r = 0 && s\trailer != 0
        r: lm_compiler_node_of_text((cast: (const: @: c.LmP0Structure) (s\trailer\body)), t)
    return: (cast: (@: c.LmP0Node) (r))
end: lm_compiler_node_of_text

fn: lm_compiler_foreign_record_pointer (int: ty) int
    c.LmP0Text: word_value
    @: word c.LmP0Text @ word_value
    int: depth
    int: qualified
    int: result
    int: raw c.lm_compiler_formal_raw(ty)
    if: raw < 100 || c.lm_compiler_type_parts(raw, word, @ depth, @ qualified) != 0 || depth != 1
        return: (cast: (int) (0))
    if: c.lm_compiler_text_eq(word, "Lmx") != 0 || lm_compiler_ret_type_word(word, 0, 0, @ result) = 0
        return: (cast: (int) (0))
    return: (cast: (int) (1))
end: lm_compiler_foreign_record_pointer

fn: lm_compiler_address_type (int: ty) int
    @: foreign_n_cell int (cast: (@: int) (@ c.l2_foreign_n))
    @@: foreign_raw_c_cell int (cast: (@@: int) (@ c.l2_foreign_raw_c))
    c.LmP0Text: word_value
    @: word c.LmP0Text @ word_value
    int: depth
    int: qualified
    int: result
    int: raw_c 0
    ty: c.lm_compiler_formal_raw(ty)
    if: ty >= 100 && ty - 100 < foreign_n_cell[0]
        raw_c: foreign_raw_c_cell[0][ty - 100]
    if: c.lm_compiler_type_parts(ty, word, @ depth, @ qualified) != 0
        return: (cast: (int) (0 - 1))
    if: raw_c = 0 && qualified = 0 && lm_compiler_ptr_type_word(word, depth + 1, @ result) = 0
        return: (cast: (int) (result))
    return: (cast: (int) (c.lm_compiler_foreign_intern_parts(word, depth + 1, qualified, raw_c)))
end: lm_compiler_address_type

fn: lm_compiler_indirect_type (int: ty) int
    @: foreign_n_cell int (cast: (@: int) (@ c.l2_foreign_n))
    @@: foreign_raw_c_cell int (cast: (@@: int) (@ c.l2_foreign_raw_c))
    c.LmP0Text: word_value
    @: word c.LmP0Text @ word_value
    int: depth
    int: qualified
    int: result
    int: raw_c 0
    ty: c.lm_compiler_formal_raw(ty)
    if: ty >= 100 && ty - 100 < foreign_n_cell[0]
        raw_c: foreign_raw_c_cell[0][ty - 100]
    if: c.lm_compiler_type_parts(ty, word, @ depth, @ qualified) != 0 || depth < 1
        return: (cast: (int) (-1))
    if: depth = 1
        if: raw_c != 0
            return: (cast: (int) (c.lm_compiler_foreign_intern_parts(word, 0, 0, 1)))
        if: lm_compiler_ret_type_word(word, 0, 0, @ result) != 0 || result = 8
            return: (cast: (int) (-1))
        if: result = 33
            result: 34
        return: (cast: (int) (result))
    if: raw_c = 0 && qualified = 0 && lm_compiler_ptr_type_word(word, depth - 1, @ result) = 0
        return: (cast: (int) (result))
    return: (cast: (int) (c.lm_compiler_foreign_intern_parts(word, depth - 1, qualified, raw_c)))
end: lm_compiler_indirect_type

fn: lm_compiler_slot_find (int: mi; const: (@: t c.LmP0Text)) int
    @@: m_sn_cell int (cast: (@@: int) (@ c.l2_m_sn))
    @@@: sn_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_sn))
    int: i 0
    if: mi < 0 || t = 0
        return: (cast: (int) (-1))
    while: i < m_sn_cell[0][mi]
        if: c.lm_compiler_text_same(sn_cell[0][lm_compiler_slot_off(mi, i)], t)
            return: (cast: (int) (i))
        i: i + 1
    return: (cast: (int) (-1))
end: lm_compiler_slot_find

fn: lm_compiler_is_known (const: (@: t c.LmP0Text)) int
    if: t = 0 || t\data = 0
        return: (cast: (int) (0))
    # Includes for runtime headers come from the source unit's own predef:/include:
    # (plus the profile prelude). Name-driven need_stdlib/need_string/need_p0/need_own
    # (FABLE-SONNET-NAME-SPECIALS-20260924-155 commit 3, :18296) are gone. Emitter-set
    # need_query remains where the translator emits its own helper.
    # c.* is the raw door; a leading c.array: local declarator is gone too
    # (FABLE-SONNET-NAME-SPECIALS-20260924-155 commit 4, :5029) -- it is
    # just an ordinary c.* frame now, matched here like any other.
    if: t\length > 2U && t\data[0] = 99 && t\data[1] = 46
        return: (cast: (int) (1))
    # FABLE-SONNET-NAME-SPECIALS-20260924-155 commit 2 (steps/name-specials-
    # inventory.md): the translator's own adapter families are LMX functions
    # implemented in L1 (l1src/parser.lm1, l1src/own.lm1, l2src/*.h.lm1) --
    # visible ONLY through the source unit's own predef: declarations, like
    # any other adapter, never through a name whitelist (plan §7a norm).
    # This dropped a hard-coded 11-name list that used to answer for a
    # handful of names before ever asking l2_predef_has_function; measured
    # which fixtures actually relied on it (none of them redundant with the
    # general mechanism) and gave each the predef:/prototype line it lacked
    # instead of keeping the special case.
    if: lm_compiler_predef_has_function(t) != 0
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: lm_compiler_is_known

fn: lm_compiler_prim_type_word (const: (@: t c.LmP0Text)) int
    @: here_mi_cell int (cast: (@: int) (@ c.l2_here_mi))
    int: dummy_ty 0
    # A callable may be a pointer's requirement, but its name is never a
    # declaration/sizeof type word.  Keep that distinction before reusing the
    # pointer matcher, whose accepted words are intentionally broader.
    if: c.lm_compiler_site_method(here_mi_cell[0], t) >= 0
        return: (cast: (int) (0))
    return: (cast: (int) (lm_compiler_ptr_type_word(t, 1, @ dummy_ty) = 0))
end: lm_compiler_prim_type_word

fn: lm_compiler_ns_source_site (const: (@: t c.LmP0Text)) const: @: c.LmP0Node
    const: (@@: ruse_unit_cell c.LmP0Structure (cast: (const: @@: c.LmP0Structure) (@ c.l2_ruse_unit)))
    @@: head_expressions_cell c.L2HeadExpression (cast: (@@: c.L2HeadExpression) (@ c.l2_head_expressions))
    @@@: part_doc_cell c.LmP0Document (cast: (@@@: c.LmP0Document) (@ c.l2_part_doc))
    @: part_n_cell int (cast: (@: int) (@ c.l2_part_n))
    @@: here_node_cell c.LmP0Node (cast: (@@: c.LmP0Node) (@ c.l2_here_node))
