---
    Observed:
        int: r 1
        int: s 5
        int: m_a 1
        int: n_a 5
    end: Observed
---
@: shared (data [] 0)
sub: main () (
    M:
        int: a 1
    end: M
    N:
        int: a 5
    end: N
    int: r 0
    int: s 0
    int: m_a 0
    int: n_a 0
)
    :=: (data \ r) ((merge M N M) \ a)
    :=: (data \ s) ((merge N M N) \ a)
    :=: (data \ m_a) (M \ a)
    :=: (data \ n_a) (N \ a)
end: main
main:
int: r ((main \ data) \ r)
int: s ((main \ data) \ s)
int: m_a ((main \ data) \ m_a)
int: n_a ((main \ data) \ n_a)
sub: observe ()
    :=: ((shared \ Observed) \ r) r
    :=: ((shared \ Observed) \ s) s
    :=: ((shared \ Observed) \ m_a) m_a
    :=: ((shared \ Observed) \ n_a) n_a
end: observe
observe:
