+# One owned operand preparation. Prefixes retain their recursively prepared
+# operand; a name/path retains the SAME common adapter result that selected
+# its extent. No caller re-enters a parser after a held grammar miss.
+# Return the consumed field count,or0 for malformed/failed preparation.
+fn: l2_value_span_prepare (@: LmP0Field first; int: count; @: L2ValueSpan span) int
+    @: LmP0Field f l2_next_active(first)
+    L2Path: prepared
+    int: status
+    int: run
+    l2_value_span_ref(span, f, 1)
+    span\grammar: 2
+    if: count < 1 || f = 0 || f\value = 0
+        return: 0
+    if: count >= 5 && l2_occ_run(f) = 5
+        span\count: 5
+        return: 5
+    if: f\value\kind = c.LM_P0_NODE_ATOM && f\value\as != 0 && (l2_prefix_sign(f\value\as\atom) != 0 || l2_text_eq(f\value\as\atom, "@") != 0 || l2_is_slash(f\value\as\atom) != 0)
+        if: count < 2
+            return: 0
+        span\operand: (cast: (@: L2ValueSpan) l2_xmalloc(c.sizeof(c.L2ValueSpan)))
+        if: span\operand = 0
+            return: 0
+        run: l2_value_span_prepare(l2_next_active(f\next), count - 1, span\operand)
+        if: run < 1
+            return: 0
+        span\count: run + 1
+        return: span\count
+    ---
+    l2_path_init(0, 0U, @ prepared)
+    status: l2_path_steps_operand(f, count, @ prepared, 1)
+    if: status = 2
+        return: 1
+    if: status != 0
+        l2_path_release(@ prepared)
+        return: 0
+    span\prepared: (cast: (@: L2Path) l2_xmalloc(c.sizeof(c.L2Path)))
+    if: span\prepared = 0
+        l2_path_release(@ prepared)
+        return: 0
+    memcpy(span\prepared, @ prepared, c.sizeof(c.L2Path))
+    span\grammar: 1
+    span\count: prepared.run_count
+return: span\count
