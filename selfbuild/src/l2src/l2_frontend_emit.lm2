    @: for_n_cell int (cast: (@: int) (@ c.l2_for_n))
    @@: mres_own_cell int (cast: (@@: int) (@ c.l2_mres_own))
    int: model_frame
    int: port_local_node
    int: raw
    int: base
    int: kind
    int: uslot
    int: source_own
    int: cell_ft
    int: place_width
    int: witness_slot
    @: stop c.L2GraphPlace
    @: place c.L2GraphPlace
    @: field c.L2GraphField
    int: req 0 - 1
    int: formal_holder 0
    int: model_slot 3 + store
    int: model_level 0
    const: (@: frame_op char "LMX_WALK_OP_OF")
    @: index_step c.L2PathStep
    if: level = path[2] && c.lm_compiler_use_path(path) != 0
        return: (cast: (int) (1))
    # A reference binding path follows its working value; a directly written
    # Structure/method occurrence reads its physical graph field.
    if: level = 0 && path[0] = 1
        if: c.lm_compiler_own_path_uses_work(path[1]) != 0
            return: (cast: (int) (lm_compiler_rw_own(parent, path[1], out)))
        return: (cast: (int) (lm_compiler_rw_physical_own(parent, path[1], out)))
    # A Structure formal is already the Structure the caller passed (ARG), not a cell to open.  A hidden
    # input of a definition its method returns may be absent: its lexical source then (l2_rw_arg_fb).
