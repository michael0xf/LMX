fn: lm_compiler_t7_from_actual (int: mi; int: callee; int: fi; const: (@: source_node c.LmP0Node); const: (@: path char)) int
    int: req
    if: mi < 0
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "incompatible entry signature")))
    req: c.lm_compiler_cf_get(callee, fi)
    if: req < 0
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "incompatible entry signature")))
    # One merge is one site, however often its call is checked.
    if: c.lm_compiler_t7_actual_model(mi, source_node) >= 0
        return: (cast: (int) (0))
    if: lm_compiler_t7_fill(source_node, mi, 2, req, path) != 0
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: lm_compiler_t7_from_actual

