# A Structure Model admits -- its field value, a size_t, by name -- assigned to Model (book §9 :561): the assignment
# is not rebound yet (OPUS-Q54-CONTINUE-20260929-14).  Model's field reads would have to go through the
# correspondence of the admitted value (D-105), which a named Structure's reads do not do -- a located gap, not the
# claim that Model is no assignable binding.
Model:
    size_t: value 1U
Model:
    size_t: value 5U
return
