---
    Observed:
        int: seen 12345678
    end: Observed
---
sub: main () (
    const:
        int: a 1
        int: b 2
    end: const
    const:
        int: c 3
        int: d 4
    end: const
    const:
        int: e 5
        int: f 6
    end: const
    const:
        int: g 7
    end: const
    const:
        int: h 8
    end: const
)
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) ((((((((a * 10000000) + (b * 1000000)) + (c * 100000)) + (d * 10000)) + (e * 1000)) + (f * 100)) + (g * 10)) + h)
end: main
main:
