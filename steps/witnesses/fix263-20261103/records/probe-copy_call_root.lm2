# Only the copied Inner is executed; it resolves the caller's free input.
int: ticket 13
Holder:
    Inner:
        int: seen 0
        seen: ticket
    end: Inner
end: Holder
Copy: merge: Holder
call: Copy\Inner
int: answer 81
if: Copy\Inner\seen = 13 && Holder\Inner\seen = 0
    answer: 7
sendMessage: exit(exit_code: answer; stdout: ""; stderr: "")
return
