-    home: lmx_range_home(f\arena, (cast: (@: void) code))
-    if: source = 0 || home = 0
-        return: c.LMX_WALK_INVALID
-    n: code\array.size - 3U
-    # Insertion by ordinal: slot i moves left past every placed slot whose
-    # borrowed node stands later in the source. Equal ordinals (absent
-    # slots) keep their slot order.
-    while: i < n
-        actual: lmx_graph_value_in(f\arena, code, 3U + i)
-        first: 0U
-        if: actual != 0
-            owner: 0
-            count: 0U
-            ordinal: 0U
