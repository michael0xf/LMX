# implements-port slice 1 (steps/implements-port-plan.md, A1): a callable formal called with
# arguments.  Each actual goes into a local of its formal's type and refs[k] is that local's
# address (l2_emit_call, sel 2); lmx_call_prim gets l2_cfr<t> and nargs (l2_emit_dyn_tail); the
# callee's trampoline reads each one with lmx_*_value_known.  Before the slice this call was
# refused, "incompatible entry signature".  Two arguments of two types pin the order; each of the
# five numeric formal types is passed once.
fn: intToInt (int: x) int
end: intToInt
fn: inc (int: x) int
    return: x + 1
end: inc
fn: apply (intToInt: op; int: value) int
    return: op(value)
end: apply

fn: mix (int: a; size_t: b) int
end: mix
fn: pick (int: a; size_t: b) int
    if: b = 3
        return: a - 1
    return: 0
end: pick
fn: apply2 (mix: op; int: a; size_t: b) int
    return: op(a, b)
end: apply2

fn: charTo (char: ch) int
end: charTo
fn: isA (char: ch) int
    if: ch = 'a'
        return: 1
    return: 0
end: isA
fn: applyC (charTo: op) int
    return: op('a')
end: applyC

fn: wideTo (unsigned: u; ulong: w) int
end: wideTo
fn: both (unsigned: u; ulong: w) int
    if: u = 4 && w = 9
        return: 1
    return: 0
end: both
fn: applyW (wideTo: op; unsigned: u; ulong: w) int
    return: op(u, w)
end: applyW

int: ri (apply(inc, 10))
int: rs (apply2(pick, 5, 3))
int: rc (applyC(isA))
int: rw (applyW(both, 4, 9))
int: ok 0
if: ri = 11 && rs = 4 && rc = 1 && rw = 1
    ok: 7
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
