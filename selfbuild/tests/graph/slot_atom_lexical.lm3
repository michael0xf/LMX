# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: seen 0
)
sub: main () (
    A(int: value 1)
    B(int: value 7)
    Slots(A)
    int: seen 0
)
    fn: patch (int: A) int
        Slots[0] := B
        return: Slots[0]\value
    data\seen := patch(9)
main()
int: seen main\data\seen

sub: observe ()
    @: shared node[0]
    shared\Observed\seen := seen
observe()
