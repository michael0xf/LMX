+# The exact written occurrence's bound grammar, not another parser. Missing
+# pointee information stays unknown at this analysis phase; invalid inventory
+# and allocation failure are not silently replaced by a spelling lookup.
+# Store even a refused current verdict, never an earlier successful route.
+fn: l2_reference_bound_path_source (@: L2PathFact fact; @: L2ReferenceSource out) int
+    L2Path: value
+    @: L2Path path @ value
+    int: status l2_source_use_resolve(fact, path)
+    int: projected
+    if: status = 2 || status = 3
+        l2_path_release(path)
+        if: status = 3
+            return: l2_alloc_or(l2_src, fact\source, "cannot resolve the retained source route")
+        return: l2_error(l2_src, fact\source, "internal: the source route has invalid binding inventory")
+    ---
+    if: l2_path_fact_store(fact, path) != 0
+        l2_path_release(path)
+        return: l2_error(l2_src, fact\source, "internal: the source route changed its prepared geometry")
+    ---
+    if: status = 0
+        projected: l2_reference_path_projection(path, out)
+        # Preserve the existing direct Structure-leaf category, after the
+        # selected own/formal reference source has had its ordinary priority.
+        if: projected != 0 && (path\leaf_kind = 2 || path\leaf_kind = 3) && path\leaf_model >= 0
+            out\schema: path\leaf_model
+            out\layout: out\schema
+        ---
+    ---
+    out\path: fact
+    l2_path_release(path)
+    if: l2_alloc_err != 0
+        return: l2_alloc_or(l2_src, fact\source, "cannot project the retained source route")
+return: 0
+
 # The source of an already selected input, independent of how it was
 # addressed. Root operands and formal fields use this same producer. A
