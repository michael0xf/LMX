    return: (cast: (@: c.L2TypeContract) (0))
end: lm_compiler_path_selected_contract

# Original: l2src/l2trans.lm1:25545
fn: lm_compiler_path_resolve (const: (@: pd char); size_t: pn; @: out c.L2Path) int
    if: out = 0
        return: (cast: (int) (0 - 1))
    c.lm_compiler_path_init(pd, pn, out)
    if: c.lm_compiler_path_steps_text(out) != 0
        return: (cast: (int) (0 - 1))
    return: (cast: (int) (lm_compiler_path_walk(out)))
end: lm_compiler_path_resolve

# Original: l2src/l2trans.lm1:25570
fn: lm_compiler_path_resolve_value (@: first c.LmP0Field; int: count; @: out c.L2Path) int
    int: status
    c.lm_compiler_path_init(0, 0U, out)
    status: lm_compiler_path_steps_operand(first, count, out, 1)
    if: status != 0
        return: (cast: (int) (status))
    if: out\run_count != count
        c.lm_compiler_path_release(out)
        return: (cast: (int) (2))
    return: (cast: (int) (lm_compiler_path_walk(out)))
end: lm_compiler_path_resolve_value

# Original: l2src/l2trans.lm1:25585
fn: lm_compiler_path_value_type (@: span c.L2ValueSpan; int: mi; @: out_ty int) int
    @: cur_mi_cell int (cast: (@: int) (@ c.l2_cur_mi))
    @: alloc_err_cell int (cast: (@: int) (@ c.l2_alloc_err))
    c.L2Path: value
    @: held c.L2Path
    int: previous cur_mi_cell[0]
    int: status
    status: lm_compiler_value_span_path(span, mi, @ held)
    if: status != 4
        if: status != 0
            return: (cast: (int) (status))
        \out_ty: c.lm_compiler_path_rec_leaf_ft(held)
        if: \out_ty < 0 && c.lm_compiler_path_callee_rec(held) >= 0
            \out_ty: c.lm_compiler_graph_ft()
        if: \out_ty < 0
            return: (cast: (int) (2))
        return: (cast: (int) (0))
    if: span = 0 || span\count < 1 || span\first = 0 || span\node = 0 || span\node\kind != c.LM_P0_NODE_ATOM || span\node\as = 0 || c.lm_compiler_ident_word((cast: (const: @: c.LmP0Text) (span\node\as\atom))) = 0
        return: (cast: (int) (1))
    cur_mi_cell[0]: mi
    status: lm_compiler_path_resolve_value((cast: (@: c.LmP0Field) (span\first)), (cast: (int) (span\count)), @ value)
    cur_mi_cell[0]: previous
    \out_ty: -1
    if: status = 2
        return: (cast: (int) (1))
    if: status = 0
        \out_ty: c.lm_compiler_path_rec_leaf_ft(@ value)
        if: \out_ty < 0 && c.lm_compiler_path_callee_rec(@ value) >= 0
            \out_ty: c.lm_compiler_graph_ft()
    ---
    c.lm_compiler_path_release(@ value)
    if: alloc_err_cell[0] != 0
        return: (cast: (int) (3))
    if: status != 0 || \out_ty < 0
        return: (cast: (int) (2))
    return: (cast: (int) (0))
end: lm_compiler_path_value_type

