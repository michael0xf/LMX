+# Effects use the held operand grammar but intentionally make a fresh
+# semantic view in the current analysis environment. This cannot mutate a
+# completed CHECK/native operand or recover an old binding after refusal.
+fn: l2_value_path_effects (@: L2ValueSpan span; int: mi) int
+    L2Path: path
+    int: saved
+    int: status
+    int: k 0
+    int: scoped 0
+    if: span = 0 || span\node = 0
+        return: 1
+    if: span\grammar = 0
+        if: span\count = 1 && span\node\kind = c.LM_P0_NODE_ATOM && span\node\as != 0 && l2_rw_prec(span\node\as\atom) != 0
+            return: 0
+        return: l2_error_fatal(l2_src, span\node, "internal: an effects operand has no prepared grammar")
+    if: span\prepared != 0
+        if: l2_path_prepared_view(span\prepared, @ path) != 0
+            return: 1
+        saved: l2_cur_mi
+        l2_cur_mi: mi
+        status: l2_path_walk(@ path)
+        l2_cur_mi: saved
+        if: status != 3 && l2_path_index_effects(@ path, mi) != 0
+            l2_path_release(@ path)
+            return: 1
+        return: l2_path_outcome_raises(status, @ path, mi, 0)
+    if: span\operand != 0
+        return: l2_value_path_effects(span\operand, mi)
+    if: span\values != 0
+        if: span\grammar != 3 && span\node\kind = c.LM_P0_NODE_STRUCTURE
+            if: l2_scope_push(span\node) != 0
+                return: 1
+            scoped: 1
+        if: span\grammar != 3 && span\node\kind = c.LM_P0_NODE_FRAME
+            l2_vis_stmt(mi, span\node)
+        ---
+        status: 0
+        while: k < span\value_n
+            if: l2_value_path_effects(span\values + k, mi) != 0
+                status: 1
+                break
+            k: k + 1
+        ---
+        if: scoped != 0
+            l2_scope_pop()
+        if: status = 0 && span\grammar != 3 && span\node\kind = c.LM_P0_NODE_FRAME && span\node\as\frame\trailer != 0 && span\node\as\frame\trailer\body != 0
+            status: l2_fields_path_effects(span\node\as\frame\trailer\body\first_field, l2_count_active(span\node\as\frame\trailer\body), mi, 0, 0)
+        return: status
+    if: span\grammar = 3
+        return: l2_error_fatal(l2_src, span\node, "internal: an effects expression lost its children")
+return: l2_node_path_effects(span\node, mi, 0)
+
