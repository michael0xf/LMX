---
    Observed:
        int: before 7
        int: after 9
        int: nested 70
    end: Observed
---
S:
    int: a\b 9
    a:
        int: b 70
    end: a
end: S
int: before (S \ `a\b`)
:=: (S \ `a\b`) 9
int: after (S \ `a\b`)
int: nested ((S \ a) \ b)
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ before) before
    :=: ((shared \ Observed) \ after) after
    :=: ((shared \ Observed) \ nested) nested
end: main
main:
