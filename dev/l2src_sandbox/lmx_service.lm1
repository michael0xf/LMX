predef: "l2src/lmx_service.h.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdlib.h>" "<string.h>" "<stdint.h>"

# lmx_service.lm1 - the sorted registry by PHYSICAL address.  MEMBERSHIP is a bisection
# (bounded comparisons); the key is the LmxThread pointer value.  No lmx_address.

fn: lmx_service_compare (@: void a; @: void b) int
    uintptr_t: aa
    uintptr_t: bb
    if: a = b
        return: 0
    ---
    aa: (cast: (uintptr_t) a)
    bb: (cast: (uintptr_t) b)
    if: aa < bb
        return: -1
    ---
return: 1

fn: lmx_service_reserve (@: LmxService service; size_t: need) int
    size_t: capacity
    @: LmxServiceEntry moved
    if: service = 0
        return: c.LMX_SERVICE_INVALID
    if: need <= service\capacity
        return: c.LMX_SERVICE_OK
    ---
    capacity: service\capacity
    if: capacity = 0U
        capacity: 4U
    ---
    while: capacity < need
        capacity: capacity * 2U
    ---
    # The ENTRIES move, the records never do: that is the whole reason a service may grow at all.
    moved: (cast: (@: LmxServiceEntry) realloc((cast: (@: void) service\entries), capacity * c.sizeof(c.LmxServiceEntry)))
    if: moved = 0
        return: c.LMX_SERVICE_FULL
    ---
    service\entries: moved
    service\capacity: capacity
return: c.LMX_SERVICE_OK

fn: lmx_service_open (@: LmxService service) int
    if: service = 0
        return: c.LMX_SERVICE_INVALID
    if: service\entries != 0 || service\count != 0U || service\capacity != 0U
        return: c.LMX_SERVICE_INVALID
    ---
return: c.LMX_SERVICE_OK

fn: lmx_service_count (@: LmxService service) size_t
    if: service = 0
        return: 0U
return: service\count

fn: lmx_service_at (@: LmxService service; size_t: index) @: void
    @: LmxServiceEntry entry
    if: service = 0 || index >= service\count
        return: 0
    ---
    entry: service\entries + index
return: entry\target

# Where this physical address belongs in the order: the first entry that does not sort before it.
fn: lmx_service_point (@: LmxService service; @: void address) size_t
    @: LmxServiceEntry entry
    size_t: low
    size_t: high
    size_t: middle
    int: order
    low: 0U
    high: service\count
    while: low < high
        middle: (low + high) / 2U
        entry: service\entries + middle
        order: lmx_service_compare(entry\address, address)
        if: order < 0
            low: middle + 1U
        else:
            high: middle
        ---
    ---
return: low

fn: lmx_service_open_room (@: LmxService service; size_t: at) int
    @: LmxServiceEntry entry
    if: at > service\count
        return: c.LMX_SERVICE_INVALID
    if: service\count = at
        return: c.LMX_SERVICE_OK
    ---
    entry: service\entries + at
    memmove((cast: (@: void) (entry + 1U)), (cast: (@: void) entry), (service\count - at) * c.sizeof(c.LmxServiceEntry))
return: c.LMX_SERVICE_OK

fn: lmx_service_close_gap (@: LmxService service; size_t: at) int
    @: LmxServiceEntry entry
    if: at >= service\count
        return: c.LMX_SERVICE_INVALID
    entry: service\entries + at
    if: at + 1U < service\count
        memmove((cast: (@: void) entry), (cast: (@: void) (entry + 1U)), (service\count - at - 1U) * c.sizeof(c.LmxServiceEntry))
    ---
    service\count: service\count - 1U
return: c.LMX_SERVICE_OK

fn: lmx_service_register (@: LmxService service; @: LmxThread target; @: LmxArena target_arena) int
    @: LmxServiceEntry entry
    @: void key
    size_t: point
    if: service = 0 || target = 0 || target_arena = 0
        return: c.LMX_SERVICE_INVALID
    ---
    if: lmx_service_reserve(service, service\count + 1U) != c.LMX_SERVICE_OK
        return: c.LMX_SERVICE_FULL
    ---
    # The key is the physical address of the LmxThread record itself.
    key: (cast: (@: void) target)
    point: lmx_service_point(service, key)
    if: point < service\count
        entry: service\entries + point
        if: lmx_service_compare(entry\address, key) = 0
            return: c.LMX_SERVICE_DUPLICATE
        ---
    ---
    if: lmx_service_open_room(service, point) != c.LMX_SERVICE_OK
        return: c.LMX_SERVICE_INVALID
    ---
    entry: service\entries + point
    entry\address: key
    entry\target: key
    entry\arena: target_arena
    entry\service: service
    service\count: service\count + 1U
    # The record knows its own entry from here on.
    target\service: (cast: (@: void) service)
return: c.LMX_SERVICE_OK

fn: lmx_service_find (@: LmxService service; @: void address) @: void
    @: LmxServiceEntry entry
    size_t: point
    if: service = 0 || address = 0
        return: 0
    point: lmx_service_point(service, address)
    if: point >= service\count
        return: 0
    ---
    entry: service\entries + point
    if: lmx_service_compare(entry\address, address) != 0
        return: 0
    ---
return: entry\target

# DELIVERY.  The record is found by its physical address and the letter joins ITS inbox.
# An unknown address answers MISSING and is never dereferenced.  letter_arena is the
# letter Message's OWN arena (19.29.2): on MISSING the service releases it -- undelivered
# letter means release that arena, not an LmxPostLink (no queue node was made).
fn: lmx_service_post (@: LmxService service; @: void address; @: LmxMsg letter; @: LmxArena letter_arena) int
    @: LmxServiceEntry entry
    @: LmxThread target_thread
    size_t: point
    if: service = 0 || address = 0 || letter = 0
        return: c.LMX_SERVICE_INVALID
    point: lmx_service_point(service, address)
    if: point >= service\count
        if: letter_arena != 0
            lmx_arena_release(letter_arena)
        ---
        return: c.LMX_SERVICE_MISSING
    ---
    entry: service\entries + point
    if: lmx_service_compare(entry\address, address) != 0
        if: letter_arena != 0
            lmx_arena_release(letter_arena)
        ---
        return: c.LMX_SERVICE_MISSING
    if: entry\target = 0 || entry\arena = 0
        if: letter_arena != 0
            lmx_arena_release(letter_arena)
        ---
        return: c.LMX_SERVICE_MISSING
    ---
    target_thread: (cast: (@: LmxThread) entry\target)
    if: target_thread\mail = 0
        if: letter_arena != 0
            lmx_arena_release(letter_arena)
        ---
        return: c.LMX_SERVICE_MISSING
    ---
    # Ordinary delivery (19.28.R2.5 / 6096): attach the letter's OWN arena onto the
    # receiver's one logical arena FIRST (ownership transfer, no copy), then admit into
    # the inbox.  Admit classifies the letter through the RECEIVER arena (lmx_post_admits),
    # so the index must already hold the letter's intervals.  letter_arena may be 0 or
    # the same as entry\arena (already one).
    if: letter_arena != 0 && letter_arena != entry\arena
        if: lmx_arena_attach(entry\arena, letter_arena) != 0
            return: c.LMX_SERVICE_INVALID
        ---
    ---
    if: lmx_post_accept(entry\arena, target_thread\mail, (cast: (@: void) letter), c.LMX_POST_INBOX) != c.LMX_POST_OK
        return: c.LMX_SERVICE_INVALID
    ---
return: c.LMX_SERVICE_OK

fn: lmx_service_unregister (@: LmxService service; @: LmxThread target) int
    @: LmxServiceEntry entry
    @: void key
    size_t: point
    if: service = 0 || target = 0
        return: c.LMX_SERVICE_INVALID
    key: (cast: (@: void) target)
    point: lmx_service_point(service, key)
    if: point >= service\count
        return: c.LMX_SERVICE_MISSING
    ---
    entry: service\entries + point
    if: lmx_service_compare(entry\address, key) != 0
        return: c.LMX_SERVICE_MISSING
    ---
    target\service: 0
return: lmx_service_close_gap(service, point)

fn: lmx_service_release (@: LmxService service) int
    if: service = 0
        return: c.LMX_SERVICE_INVALID
    if: service\entries != 0
        free((cast: (@: void) service\entries))
    ---
    service\entries: 0
    service\count: 0U
    service\capacity: 0U
return: c.LMX_SERVICE_OK
