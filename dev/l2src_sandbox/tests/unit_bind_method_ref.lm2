# Explicit reference binding in a method: b points to c's descriptor,
# without copying c; a write through b is read through c. Entry 7.
Model:
    size_t: value 1U
end: Model

Other:
    int: p 1
    int: q 2
end: Other

fn: m () int
    int: out 0
    c: merge Model
    c\value: 5U
    @: Model b c
    b\value: 9U
    if: c\value = 9U
        out: 7
    return: out
end: m

sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
