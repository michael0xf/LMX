# lmxtool: the maintained L2 tool of the LMX builds and checks (the author, 2026-10-22: tests and scripts in
# L2/L3). Slice 170: the platform adapter -- one os block (L2 section 20), each method one contract with a body
# per platform -- hashing and the adapter's self-tests. Commands: selftest, sha256 FILE, and the child
# commands the self-tests run (echo-args, exit-with, streams, cwd, sleep-ms, sleep-touch).
# Parts: text.lm2, winargs.lm2, sha256.lm2. Link: -lshell32 -lbcrypt on Windows.
include: "<stdio.h>"
include: "<stdlib.h>"
include: "<string.h>"

os:
    win:
        include: "<windows.h>"
        include: "<bcrypt.h>"
        # UTF-8 text as the platform's API text (UTF-16 here) on the heap, or 0 (no memory, not UTF-8).
        fn: os_native (@: s char) @: c.void
            int: n c.MultiByteToWideChar(c.CP_UTF8, c.MB_ERR_INVALID_CHARS, s, -1, 0, 0)
            @: w c.WCHAR 0
            if: n <= 0
                return: 0
            w: c.calloc((cast: (size_t) n), c.sizeof(c.WCHAR))
            if: w = 0
                return: 0
            if: c.MultiByteToWideChar(c.CP_UTF8, c.MB_ERR_INVALID_CHARS, s, -1, w, n) != n
                c.free(w)
                return: 0
            return: (cast: (@: void) w)
        end: os_native
        # The platform's API text as UTF-8 on the heap, or 0.
        fn: os_from_native (@: p c.void) @: char
            @: w c.WCHAR (cast: (@: c.WCHAR) p)
            int: n c.WideCharToMultiByte(c.CP_UTF8, 0, w, -1, 0, 0, 0, 0)
            @: s char 0
            if: n <= 0
                return: 0
            s: (cast: (@: char) c.malloc((cast: (size_t) n)))
            if: s = 0
                return: 0
            if: c.WideCharToMultiByte(c.CP_UTF8, 0, w, -1, s, n, 0, 0) != n
                c.free(s)
                return: 0
            return: s
        end: os_from_native
        # The process contract: exe (a path, no search) runs with argv[0 .. argc - 1] (argv[0] the name the
        # child sees), no shell, in cwd (0: this process's), stdin from the null device, stdout and stderr to
        # the files out_path and err_path (0: the null device; one path for both: one file), within timeout_ms
        # (0: none). The kind: 0 exited (detail[0] its exit code), 1 not started (detail[0] the OS error),
        # 2 stopped at the timeout with its whole process tree (detail[0] the timeout), 3 lost while waiting
        # (detail[0] the OS error; the tree is stopped), 4 not prepared (detail[0] the OS error or 0). The
        # child's handles and its job are this call's own and closed before it returns.
        fn: os_run (@: exe char; @@: argv char; int: argc; @: cwd char; @: out_path char; @: err_path char; unsigned: timeout_ms; @: detail int) int
            @: sa c.SECURITY_ATTRIBUTES c.calloc(1U, c.sizeof(c.SECURITY_ATTRIBUTES))
            @: si c.STARTUPINFOW c.calloc(1U, c.sizeof(c.STARTUPINFOW))
            @: pi c.PROCESS_INFORMATION c.calloc(1U, c.sizeof(c.PROCESS_INFORMATION))
            @: code unsigned c.calloc(1U, c.sizeof(c.unsigned))
            @: cmd char win_cmdline(argv, argc)
            @: wexe c.void os_native(exe)
            @: wnul c.void os_native("NUL")
            @: wcmd c.void 0
            @: wcwd c.void 0
            @: wout c.void 0
            @: werr c.void 0
            @: hin c.void c.INVALID_HANDLE_VALUE
            @: hout c.void c.INVALID_HANDLE_VALUE
            @: herr c.void c.INVALID_HANDLE_VALUE
            @: job c.void 0
            int: kind -1
            int: shared 0
            int: started 0
            unsigned: limit c.INFINITE
            unsigned: w 0U
            detail[0]: 0
            if: cmd != 0
                wcmd: os_native(cmd)
            if: cwd != 0
                wcwd: os_native(cwd)
            if: out_path != 0
                wout: os_native(out_path)
            if: err_path != 0 && out_path != 0 && c.strcmp(out_path, err_path) = 0
                shared: 1
            if: err_path != 0 && shared = 0
                werr: os_native(err_path)
            if: sa = 0 || si = 0 || pi = 0 || code = 0 || cmd = 0 || wexe = 0 || wnul = 0 || wcmd = 0
                kind: 4
            if: kind < 0 && ((cwd != 0 && wcwd = 0) || (out_path != 0 && wout = 0) || (err_path != 0 && shared = 0 && werr = 0))
                kind: 4
            if: kind < 0
                sa\nLength: c.sizeof(c.SECURITY_ATTRIBUTES)
                sa\bInheritHandle: c.TRUE
                hin: c.CreateFileW(wnul, c.GENERIC_READ, c.FILE_SHARE_READ | c.FILE_SHARE_WRITE, sa, c.OPEN_EXISTING, 0, 0)
                if: out_path = 0
                    hout: c.CreateFileW(wnul, c.GENERIC_WRITE, c.FILE_SHARE_READ | c.FILE_SHARE_WRITE, sa, c.OPEN_EXISTING, 0, 0)
                if: out_path != 0
                    hout: c.CreateFileW(wout, c.GENERIC_WRITE, c.FILE_SHARE_READ, sa, c.CREATE_ALWAYS, c.FILE_ATTRIBUTE_NORMAL, 0)
                if: shared != 0
                    herr: hout
                if: shared = 0 && err_path = 0
                    herr: c.CreateFileW(wnul, c.GENERIC_WRITE, c.FILE_SHARE_READ | c.FILE_SHARE_WRITE, sa, c.OPEN_EXISTING, 0, 0)
                if: shared = 0 && err_path != 0
                    herr: c.CreateFileW(werr, c.GENERIC_WRITE, c.FILE_SHARE_READ, sa, c.CREATE_ALWAYS, c.FILE_ATTRIBUTE_NORMAL, 0)
                if: hin = c.INVALID_HANDLE_VALUE || hout = c.INVALID_HANDLE_VALUE || herr = c.INVALID_HANDLE_VALUE
                    detail[0]: (cast: (int) c.GetLastError())
                    kind: 4
            ---
            if: kind < 0
                job: c.CreateJobObjectW(0, 0)
                if: job = 0
                    detail[0]: (cast: (int) c.GetLastError())
                    kind: 4
            ---
            if: kind < 0
                si\cb: c.sizeof(c.STARTUPINFOW)
                si\dwFlags: c.STARTF_USESTDHANDLES
                si\hStdInput: hin
                si\hStdOutput: hout
                si\hStdError: herr
                if: c.CreateProcessW(wexe, wcmd, 0, 0, c.TRUE, c.CREATE_NO_WINDOW | c.CREATE_SUSPENDED, 0, wcwd, si, pi) = 0
                    detail[0]: (cast: (int) c.GetLastError())
                    kind: 1
                ---
                if: kind < 0
                    started: 1
            ---
            # The child holds its own ends now; this process keeps none of them.
            if: hin != c.INVALID_HANDLE_VALUE
                c.CloseHandle(hin)
            if: hout != c.INVALID_HANDLE_VALUE
                c.CloseHandle(hout)
            if: shared = 0 && herr != c.INVALID_HANDLE_VALUE
                c.CloseHandle(herr)
            if: kind < 0 && (c.AssignProcessToJobObject(job, pi\hProcess) = 0 || c.ResumeThread(pi\hThread) = 0xffffffffU)
                detail[0]: (cast: (int) c.GetLastError())
                c.TerminateProcess(pi\hProcess, 1U)
                c.WaitForSingleObject(pi\hProcess, c.INFINITE)
                kind: 3
            if: kind < 0
                if: timeout_ms != 0U
                    limit: timeout_ms
                w: c.WaitForSingleObject(pi\hProcess, limit)
                if: w = c.WAIT_OBJECT_0
                    kind: 0
                    if: c.GetExitCodeProcess(pi\hProcess, (cast: (@: void) code) ) = 0
                        detail[0]: (cast: (int) c.GetLastError())
                        kind: 3
                    ---
                    if: kind = 0
                        detail[0]: (cast: (int) code[0])
                ---
                if: w = c.WAIT_TIMEOUT
                    c.TerminateJobObject(job, 1U)
                    c.WaitForSingleObject(pi\hProcess, c.INFINITE)
                    detail[0]: (cast: (int) timeout_ms)
                    kind: 2
                if: kind < 0
                    detail[0]: (cast: (int) c.GetLastError())
                    c.TerminateJobObject(job, 1U)
                    c.WaitForSingleObject(pi\hProcess, c.INFINITE)
                    kind: 3
            ---
            if: started != 0
                c.CloseHandle(pi\hThread)
                c.CloseHandle(pi\hProcess)
            if: job != 0
                c.CloseHandle(job)
            c.free(sa)
            c.free(si)
            c.free(pi)
            c.free(code)
            c.free(cmd)
            c.free(wexe)
            c.free(wnul)
            c.free(wcmd)
            c.free(wcwd)
            c.free(wout)
            c.free(werr)
            return: kind
        end: os_run
        # The directory at path made: 0 made or already a directory, else the OS error.
        fn: os_mkdir (@: path char) int
            @: w c.void os_native(path)
            int: r 0
            unsigned: e 0U
            if: w = 0
                return: -1
            if: c.CreateDirectoryW(w, 0) = 0
                e: c.GetLastError()
                r: (cast: (int) e)
                if: e = c.ERROR_ALREADY_EXISTS
                    r: 0
            ---
            c.free(w)
            return: r
        end: os_mkdir
        # Milliseconds of a monotonic clock (its steps are the system timer's).
        fn: os_now_ms () size_t
            return: (cast: (size_t) c.GetTickCount64())
        end: os_now_ms
        fn: os_sleep_ms (unsigned: ms) int
            c.Sleep(ms)
            return: 0
        end: os_sleep_ms
        # This process's working directory as UTF-8 on the heap, or 0.
        fn: os_cwd () @: char
            unsigned: n c.GetCurrentDirectoryW(0U, 0)
            @: w c.WCHAR 0
            @: s char 0
            if: n = 0U
                return: 0
            w: c.calloc((cast: (size_t) n), c.sizeof(c.WCHAR))
            if: w = 0
                return: 0
            if: c.GetCurrentDirectoryW(n, w) = 0U
                c.free(w)
                return: 0
            s: os_from_native((cast: (@: void) w))
            c.free(w)
            return: s
        end: os_cwd
        # This program's executable path as UTF-8 on the heap, or 0.
        fn: os_self () @: char
            unsigned: cap 260U
            unsigned: n 0U
            @: w c.WCHAR 0
            @: s char 0
            while: cap < 65536U
                w: c.calloc((cast: (size_t) cap), c.sizeof(c.WCHAR))
                if: w = 0
                    return: 0
                n: c.GetModuleFileNameW(0, w, cap)
                if: n > 0U && n < cap
                    s: os_from_native((cast: (@: void) w))
                    c.free(w)
                    return: s
                ---
                c.free(w)
                if: n = 0U
                    return: 0
                cap: 2U * cap
            return: 0
        end: os_self
        # The arguments this process was given after `--`, as the platform parses its command line: a line
        # `ARGC n` and a line `ARG i <hex of its UTF-8 bytes>` for each. 0 printed, 1 not.
        fn: os_args_print () int
            @: count int c.calloc(1U, c.sizeof(c.int))
            @@: list c.WCHAR 0
            @: s char 0
            @: hex char 0
            int: i 0
            int: at -1
            if: count = 0
                return: 1
            list: c.CommandLineToArgvW(c.GetCommandLineW(), count)
            if: list = 0
                c.free(count)
                return: 1
            while: i < count[0] && at < 0
                s: os_from_native((cast: (@: void) list[i]))
                if: s != 0 && c.strcmp(s, "--") = 0
                    at: i + 1
                c.free(s)
                i: i + 1
            ---
            if: at < 0
                at: count[0]
            c.printf("ARGC %d\n", count[0] - at)
            i: at
            while: i < count[0]
                s: os_from_native((cast: (@: void) list[i]))
                if: s = 0
                    c.LocalFree(list)
                    c.free(count)
                    return: 1
                hex: txt_hex(s, c.strlen(s))
                c.printf("ARG %d %s\n", i - at, hex)
                c.free(hex)
                c.free(s)
                i: i + 1
            ---
            c.LocalFree(list)
            c.free(count)
            return: 0
        end: os_args_print
        # The names of the files (not directories) in the directory dir, one per line in the file out_path, in
        # the platform's order. 0 listed, else the OS error.
        fn: os_list_dir (@: dir char; @: out_path char) int
            @: pattern char txt_cat(dir, "/*")
            @: wpat c.void 0
            @: fd c.WIN32_FIND_DATAW c.calloc(1U, c.sizeof(c.WIN32_FIND_DATAW))
            @: h c.void c.INVALID_HANDLE_VALUE
            @: out c.FILE 0
            @: name char 0
            unsigned: attrs 0U
            unsigned: e 0U
            int: r 0
            if: pattern = 0 || fd = 0
                return: -1
            wpat: os_native(pattern)
            out: c.fopen(out_path, "wb")
            if: wpat = 0 || out = 0
                r: -1
            if: r = 0
                h: c.FindFirstFileW(wpat, fd)
                if: h = c.INVALID_HANDLE_VALUE
                    r: (cast: (int) c.GetLastError())
            ---
            while: r = 0 && h != c.INVALID_HANDLE_VALUE
                attrs: (cast: (unsigned) fd\dwFileAttributes)
                if: (attrs & (cast: (unsigned) c.FILE_ATTRIBUTE_DIRECTORY)) = 0U
                    name: os_from_native((cast: (@: void) fd\cFileName))
                    if: name != 0
                        c.fprintf(out, "%s\n", name)
                    c.free(name)
                ---
                if: c.FindNextFileW(h, fd) = 0
                    e: c.GetLastError()
                    if: e != c.ERROR_NO_MORE_FILES
                        r: (cast: (int) e)
                    c.FindClose(h)
                    h: c.INVALID_HANDLE_VALUE
            ---
            if: out != 0 && c.fclose(out) != 0 && r = 0
                r: -1
            c.free(pattern)
            c.free(wpat)
            c.free(fd)
            return: r
        end: os_list_dir
        # The SHA-256 of the file at path as 64 lowercase hex digits and a NUL in out[0 .. 64] (the platform's
        # hash: CNG). 0 written, 1 not.
        fn: os_sha256_file (@: path char; @: out char) int
            @: len size_t c.calloc(1U, c.sizeof(c.size_t))
            @: data char 0
            @@: alg c.void c.calloc(1U, sizeof(@: void))
            @: digest char c.calloc(32U, 1U)
            @: hex char 0
            int: r 1
            if: len = 0 || alg = 0 || digest = 0
                return: 1
            data: file_read(path, len)
            if: data != 0 && c.BCryptOpenAlgorithmProvider(alg, c.BCRYPT_SHA256_ALGORITHM, 0, 0U) = 0
                if: c.BCryptHash(alg[0], 0, 0U, (cast: (@: void) data), (cast: (unsigned) len[0]), (cast: (@: void) digest), 32U) = 0
                    hex: txt_hex(digest, 32U)
                    if: hex != 0
                        c.memcpy(out, hex, 65U)
                        r: 0
                    ---
                    c.free(hex)
                ---
                c.BCryptCloseAlgorithmProvider(alg[0], 0U)
            ---
            c.free(data)
            c.free(len)
            c.free(alg)
            c.free(digest)
            return: r
        end: os_sha256_file
    default:
        include: "<unistd.h>"
        include: "<sys/types.h>"
        include: "<sys/wait.h>"
        include: "<sys/stat.h>"
        include: "<fcntl.h>"
        include: "<signal.h>"
        include: "<errno.h>"
        include: "<time.h>"
        # UTF-8 is the API text of this platform: a heap copy, or 0.
        fn: os_native (@: s char) @: c.void
            return: (cast: (@: void) txt_dup(s))
        end: os_native
        fn: os_from_native (@: p c.void) @: char
            return: txt_dup((cast: (@: char) p))
        end: os_from_native
        # The process contract of the win branch, by fork and execv: the child joins a process group of its
        # own (the whole tree is stopped at the timeout) and reports a failed start through a close-on-exec
        # pipe, so a start that failed is kind 1, not an exit code.
        fn: os_run (@: exe char; @@: argv char; int: argc; @: cwd char; @: out_path char; @: err_path char; unsigned: timeout_ms; @: detail int) int
            @@: list char c.calloc((cast: (size_t) (argc + 1)), sizeof(@: char))
            @: fds int c.calloc(2U, c.sizeof(c.int))
            @: status int c.calloc(1U, c.sizeof(c.int))
            @: err int c.calloc(1U, c.sizeof(c.int))
            int: pid 0
            int: fd 0
            int: i 0
            int: kind -1
            int: got 0
            unsigned: waited 0U
            detail[0]: 0
            if: list = 0 || fds = 0 || status = 0 || err = 0
                kind: 4
            if: kind < 0 && c.pipe(fds) != 0
                detail[0]: c.errno
                kind: 4
            if: kind < 0
                while: i < argc
                    list[i]: argv[i]
                    i: i + 1
                ---
                c.fcntl(fds[1], c.F_SETFD, c.FD_CLOEXEC)
                pid: c.fork()
                if: pid < 0
                    detail[0]: c.errno
                    kind: 1
                ---
                if: pid = 0
                    c.close(fds[0])
                    c.setpgid(0, 0)
                    if: cwd != 0 && c.chdir(cwd) != 0
                        err[0]: c.errno
                        c.write(fds[1], err, c.sizeof(c.int))
                        c._exit(127)
                    fd: c.open("/dev/null", c.O_RDONLY)
                    if: fd >= 0
                        c.dup2(fd, 0)
                    if: out_path != 0
                        fd: c.open(out_path, c.O_WRONLY | c.O_CREAT | c.O_TRUNC, 420)
                    if: out_path = 0
                        fd: c.open("/dev/null", c.O_WRONLY)
                    if: fd >= 0
                        c.dup2(fd, 1)
                    if: err_path != 0 && out_path != 0 && c.strcmp(out_path, err_path) = 0
                        c.dup2(1, 2)
                    if: err_path != 0 && (out_path = 0 || c.strcmp(out_path, err_path) != 0)
                        fd: c.open(err_path, c.O_WRONLY | c.O_CREAT | c.O_TRUNC, 420)
                        if: fd >= 0
                            c.dup2(fd, 2)
                    ---
                    if: err_path = 0
                        fd: c.open("/dev/null", c.O_WRONLY)
                        if: fd >= 0
                            c.dup2(fd, 2)
                    ---
                    c.execv(exe, list)
                    err[0]: c.errno
                    c.write(fds[1], err, c.sizeof(c.int))
                    c._exit(127)
            ---
            if: fds != 0
                c.close(fds[1])
            if: kind < 0 && pid > 0
                got: (cast: (int) c.read(fds[0], err, c.sizeof(c.int)))
                if: got = (cast: (int) c.sizeof(c.int))
                    c.waitpid(pid, status, 0)
                    detail[0]: err[0]
                    kind: 1
            ---
            while: kind < 0 && pid > 0
                got: c.waitpid(pid, status, c.WNOHANG)
                if: got = pid
                    kind: 0
                    detail[0]: 128 + (cast: (int) c.WTERMSIG(status[0]))
                    if: c.WIFEXITED(status[0])
                        detail[0]: c.WEXITSTATUS(status[0])
                ---
                if: got < 0
                    detail[0]: c.errno
                    c.kill(0 - pid, c.SIGKILL)
                    kind: 3
                ---
                if: kind < 0 && timeout_ms != 0U && waited >= timeout_ms
                    c.kill(0 - pid, c.SIGKILL)
                    c.waitpid(pid, status, 0)
                    detail[0]: (cast: (int) timeout_ms)
                    kind: 2
                ---
                if: kind < 0
                    c.usleep(10000U)
                    waited: waited + 10U
            ---
            if: fds != 0
                c.close(fds[0])
            c.free(list)
            c.free(fds)
            c.free(status)
            c.free(err)
            return: kind
        end: os_run
        fn: os_mkdir (@: path char) int
            if: c.mkdir(path, 511) = 0 || c.errno = c.EEXIST
                return: 0
            return: c.errno
        end: os_mkdir
        # Milliseconds of the calendar clock: OPEN on this platform -- the monotonic clock needs struct
        # timespec, which the C door cannot spell yet; the timeout loop counts its own steps.
        fn: os_now_ms () size_t
            return: (cast: (size_t) c.time(0)) * 1000U
        end: os_now_ms
        fn: os_sleep_ms (unsigned: ms) int
            unsigned: left ms
            while: left > 0U
                if: left >= 1000U
                    c.usleep(999000U)
                    left: left - 999U
                if: left < 1000U && left > 0U
                    c.usleep(left * 1000U)
                    left: 0U
            ---
            return: 0
        end: os_sleep_ms
        fn: os_cwd () @: char
            size_t: cap 256U
            @: s char 0
            while: cap < 1048576U
                s: (cast: (@: char) c.malloc(cap))
                if: s = 0
                    return: 0
                if: c.getcwd(s, cap) != 0
                    return: s
                c.free(s)
                cap: 2U * cap
            return: 0
        end: os_cwd
        # This program's executable path (Linux: /proc/self/exe; other systems OPEN), or 0.
        fn: os_self () @: char
            size_t: cap 256U
            @: s char 0
            int: n 0
            while: cap < 1048576U
                s: (cast: (@: char) c.malloc(cap))
                if: s = 0
                    return: 0
                n: (cast: (int) c.readlink("/proc/self/exe", s, cap))
                if: n > 0 && (cast: (size_t) n) < cap
                    s[n]: (cast: (char) 0)
                    return: s
                ---
                c.free(s)
                if: n <= 0
                    return: 0
                cap: 2U * cap
            return: 0
        end: os_self
        # This platform hands main its arguments unparsed: they are printed from the program's own argv (the
        # root's), so this branch reports that it has no other view of them.
        fn: os_args_print () int
            return: 1
        end: os_args_print
        # OPEN on this platform: a directory entry is a `struct dirent`, which the C door cannot spell yet.
        fn: os_list_dir (@: dir char; @: out_path char) int
            return: -1
        end: os_list_dir
        fn: os_sha256_file (@: path char; @: out char) int
            @: len size_t c.calloc(1U, c.sizeof(c.size_t))
            @: data char 0
            int: r 1
            if: len = 0
                return: 1
            data: file_read(path, len)
            if: data != 0 && sha256_bytes(data, len[0], out) = 0
                r: 0
            c.free(data)
            c.free(len)
            return: r
        end: os_sha256_file
end: os

# The self-test's report: one line per check; a check answers 1 when it failed, and every test answers the
# sum of its checks (a unit field written by a callee is not reloaded by its caller: book sections 12, 14).
fn: check (int: ok; @: name char; @: why char) int
    if: ok != 0
        c.printf("PASS %s\n", name)
        return: 0
    c.printf("FAIL %s: %s\n", name, why)
    return: 1
end: check

# Whether the file at path holds the line `line`: at its start or after a newline, and ending the file or
# followed by LF or CRLF (a child's text-mode stdout ends its lines with CRLF on Windows).
fn: file_has_line (@: path char; @: line char) int
    @: len size_t c.calloc(1U, c.sizeof(c.size_t))
    @: data char 0
    size_t: n c.strlen(line)
    size_t: total 0U
    size_t: i 0U
    size_t: e 0U
    int: r 0
    if: len = 0
        return: 0
    data: file_read(path, len)
    if: data = 0
        c.free(len)
        return: 0
    total: len[0]
    while: r = 0 && i <= total
        e: i + n
        if: e <= total && c.strncmp(data + i, line, n) = 0
            if: e = total || data[e] = (cast: (char) 10) || (data[e] = (cast: (char) 13) && e + 1U < total && data[e + 1U] = (cast: (char) 10))
                r: 1
        ---
        while: i < total && data[i] != (cast: (char) 10)
            i: i + 1U
        i: i + 1U
    ---
    c.free(data)
    c.free(len)
    return: r
end: file_has_line

# Whether the file at path holds the text want anywhere.
fn: file_has (@: path char; @: want char) int
    @: len size_t c.calloc(1U, c.sizeof(c.size_t))
    @: data char 0
    int: r 0
    if: len = 0
        return: 0
    data: file_read(path, len)
    if: data != 0 && c.strstr(data, want) != 0
        r: 1
    c.free(data)
    c.free(len)
    return: r
end: file_has

# This program run as a child through the driver: `self 0 entry 0 -- command args...`.
fn: run_self (@: self char; @@: words char; int: nwords; @: cwd char; @: out char; @: err char; unsigned: timeout_ms; @: detail int) int
    @@: argv char c.calloc((cast: (size_t) (nwords + 5)), sizeof(@: char))
    int: i 0
    int: kind 0
    if: argv = 0
        return: 4
    argv[0]: self
    argv[1]: "0"
    argv[2]: "entry"
    argv[3]: "0"
    argv[4]: "--"
    while: i < nwords
        argv[5 + i]: words[i]
        i: i + 1
    kind: os_run(self, argv, nwords + 5, cwd, out, err, timeout_ms, detail)
    c.free(argv)
    return: kind
end: run_self

# The child's view of its arguments, through the platform's own parser of the command line the adapter
# wrote: spaces, an empty argument, shell metacharacters, quotes, non-ASCII text and backslashes before a
# quote and at the end.
fn: test_args (@: self char; @: dir char) int
    @@: words char c.calloc(8U, sizeof(@: char))
    @: detail int c.calloc(1U, c.sizeof(c.int))
    @: out char txt_path(dir, "args.out")
    @: err char txt_path(dir, "args.err")
    @: line char 0
    @: hex char 0
    size_t: hn 0U
    int: kind 0
    int: i 0
    int: f 0
    if: words = 0 || detail = 0 || out = 0 || err = 0
        return: check(0, "args", "no memory")
    words[0]: "echo-args"
    words[1]: "a b"
    words[2]: ""
    words[3]: "x&y|z<>^%!"
    words[4]: "q\"t"
    words[5]: "юникод ✓"
    words[6]: "tail\\"
    words[7]: "mid\\\"q"
    kind: run_self(self, words, 8, 0, out, err, 60000U, detail)
    f: f + check(kind = 0 && detail[0] = 0, "args: the child ran and exited 0", "kind or exit code")
    f: f + check(file_has_line(out, "ARGC 8"), "args: eight arguments after --", "ARGC")
    while: i < 8
        hex: txt_hex(words[i], c.strlen(words[i]))
        hn: c.strlen(hex)
        line: (cast: (@: char) c.malloc(hn + 32U))
        c.snprintf(line, hn + 32U, "ARG %d %s", i, hex)
        f: f + check(file_has_line(out, line), line, "the child saw another argument")
        c.free(line)
        c.free(hex)
        i: i + 1
    ---
    c.free(words)
    c.free(detail)
    c.free(out)
    c.free(err)
    return: f
end: test_args

fn: test_exits (@: self char; @: dir char) int
    @@: words char c.calloc(2U, sizeof(@: char))
    @@: bare char c.calloc(1U, sizeof(@: char))
    @: detail int c.calloc(1U, c.sizeof(c.int))
    @: out char txt_path(dir, "exit.out")
    int: kind 0
    int: f 0
    if: words = 0 || bare = 0 || detail = 0 || out = 0
        return: check(0, "exits", "no memory")
    words[0]: "exit-with"
    words[1]: "3"
    kind: run_self(self, words, 2, 0, out, 0, 60000U, detail)
    f: f + check(kind = 0 && detail[0] = 1, "exit: a program exit 3 against `entry 0` is the driver's exit 1", "kind or exit code")
    f: f + check(file_has(out, "exit 3, expected 0"), "exit: the driver names the program's exit 3", "driver text")
    bare[0]: self
    kind: os_run(self, bare, 1, 0, out, 0, 60000U, detail)
    f: f + check(kind = 0 && detail[0] = 2, "exit: the driver without arguments exits 2", "kind or exit code")
    c.free(words)
    c.free(bare)
    c.free(detail)
    c.free(out)
    return: f
end: test_exits

fn: test_streams (@: self char; @: dir char) int
    @@: words char c.calloc(1U, sizeof(@: char))
    @: detail int c.calloc(1U, c.sizeof(c.int))
    @: out char txt_path(dir, "streams.out")
    @: err char txt_path(dir, "streams.err")
    @: both char txt_path(dir, "streams.both")
    int: kind 0
    int: f 0
    if: words = 0 || detail = 0 || out = 0 || err = 0 || both = 0
        return: check(0, "streams", "no memory")
    words[0]: "streams"
    kind: run_self(self, words, 1, 0, out, err, 60000U, detail)
    f: f + check(kind = 0 && detail[0] = 0, "streams: the child exited 0", "kind or exit code")
    f: f + check(file_has_line(out, "OUT-LINE") && file_has(out, "ERR-LINE") = 0, "streams: stdout holds the stdout line only", "stdout")
    f: f + check(file_has_line(err, "ERR-LINE") && file_has(err, "OUT-LINE") = 0, "streams: stderr holds the stderr line only", "stderr")
    kind: run_self(self, words, 1, 0, both, both, 60000U, detail)
    f: f + check(kind = 0 && file_has_line(both, "OUT-LINE") && file_has_line(both, "ERR-LINE"), "streams: one file takes both", "shared file")
    c.free(words)
    c.free(detail)
    c.free(out)
    c.free(err)
    c.free(both)
    return: f
end: test_streams

fn: test_cwd (@: self char; @: dir char) int
    @@: words char c.calloc(1U, sizeof(@: char))
    @: detail int c.calloc(1U, c.sizeof(c.int))
    @: place char txt_path(dir, "cwd dir")
    @: out char txt_path(dir, "cwd.out")
    @: here char 0
    @: want char 0
    int: kind 0
    int: f 0
    if: words = 0 || detail = 0 || place = 0 || out = 0
        return: check(0, "cwd", "no memory")
    f: f + check(os_mkdir(place) = 0, "cwd: a directory with a space made", "mkdir")
    words[0]: "cwd"
    kind: run_self(self, words, 1, place, out, 0, 60000U, detail)
    f: f + check(kind = 0 && detail[0] = 0, "cwd: the child exited 0", "kind or exit code")
    f: f + check(file_has(out, "cwd dir\r\n") || file_has(out, "cwd dir\n"), "cwd: the child ran in that directory", "child cwd")
    here: os_cwd()
    want: txt_cat("CWD ", here)
    f: f + check(file_has_line(out, want) = 0, "cwd: not in this process's directory", "child cwd")
    c.free(here)
    c.free(want)
    c.free(words)
    c.free(detail)
    c.free(place)
    c.free(out)
    return: f
end: test_cwd

fn: test_timeout (@: self char; @: dir char) int
    @@: words char c.calloc(3U, sizeof(@: char))
    @: detail int c.calloc(1U, c.sizeof(c.int))
    @: mark char txt_path(dir, "late.mark")
    size_t: t0 0U
    size_t: t1 0U
    int: kind 0
    int: f 0
    if: words = 0 || detail = 0 || mark = 0
        return: check(0, "timeout", "no memory")
    c.remove(mark)
    words[0]: "sleep-touch"
    words[1]: "3000"
    words[2]: mark
    t0: os_now_ms()
    kind: run_self(self, words, 3, 0, 0, 0, 500U, detail)
    t1: os_now_ms()
    f: f + check(kind = 2 && detail[0] = 500, "timeout: kind 2 at 500 ms", "kind")
    f: f + check(t1 - t0 < 2500U, "timeout: returned before the child's 3000 ms", "too late")
    os_sleep_ms(4000U)
    f: f + check(file_exists(mark) = 0, "timeout: the stopped child never wrote its mark", "the child lived on")
    c.free(words)
    c.free(detail)
    c.free(mark)
    return: f
end: test_timeout

fn: test_spawn_failure (@: dir char) int
    @@: argv char c.calloc(1U, sizeof(@: char))
    @: detail int c.calloc(1U, c.sizeof(c.int))
    @: missing char txt_path(dir, "no such program.exe")
    int: kind 0
    int: f 0
    if: argv = 0 || detail = 0 || missing = 0
        return: check(0, "spawn failure", "no memory")
    argv[0]: missing
    kind: os_run(missing, argv, 1, 0, 0, 0, 60000U, detail)
    f: f + check(kind = 1 && detail[0] != 0, "spawn failure: kind 1 with the OS error", "kind")
    c.free(argv)
    c.free(detail)
    c.free(missing)
    return: f
end: test_spawn_failure

# The platform's file hash against the FIPS vectors and the L2 SHA-256.
fn: test_hash (@: dir char) int
    @: path char txt_path(dir, "hash.bin")
    @: got char c.calloc(65U, 1U)
    @: mine char c.calloc(65U, 1U)
    @: data char c.malloc(1000U)
    int: i 0
    int: f 0
    if: path = 0 || got = 0 || mine = 0 || data = 0
        return: check(0, "hash", "no memory")
    file_write(path, data, 0U)
    f: f + check(os_sha256_file(path, got) = 0 && c.strcmp(got, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") = 0, "hash: empty file", got)
    file_write(path, "abc", 3U)
    f: f + check(os_sha256_file(path, got) = 0 && c.strcmp(got, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") = 0, "hash: abc", got)
    while: i < 1000
        data[i]: (cast: (char) (i * 7 + 3))
        i: i + 1
    file_write(path, data, 1000U)
    sha256_bytes(data, 1000U, mine)
    f: f + check(os_sha256_file(path, got) = 0 && c.strcmp(got, mine) = 0, "hash: 1000 bytes, the platform's hash equals the L2 one", got)
    c.free(path)
    c.free(got)
    c.free(mine)
    c.free(data)
    return: f
end: test_hash

# The evidence commands: a manifest and its verification (all equal, a changed file, a missing one), the
# executables a run record started (none a script host, a script host and a script), and byte and image
# identity (the image itself, another link time and checksum, another byte, no image).
fn: test_evidence (@: self char; @: dir char) int
    @: ev char txt_path(dir, "evidence")
    @: list char 0
    @: man char 0
    @: rec char 0
    @: copy char 0
    @: text char 0
    @: img char 0
    @: len size_t c.calloc(1U, c.sizeof(c.size_t))
    size_t: pe 0U
    int: f 0
    if: ev = 0 || len = 0
        return: check(0, "evidence", "no memory")
    os_mkdir(ev)
    list: txt_path(ev, "list.txt")
    man: txt_path(ev, "list.sha256")
    rec: txt_path(ev, "record.txt")
    copy: txt_path(ev, "copy.exe")
    file_write(txt_path(ev, "a.txt"), "alpha\n", 6U)
    file_write(txt_path(ev, "b.txt"), "beta\n", 5U)
    text: "# two files\na.txt\n\nb.txt\n"
    file_write(list, text, c.strlen(text))
    f: f + check(manifest_write(list, ev, man) = 0 && file_has_line(man, "b6a98d9ce9a2d9149288fa3df42d377c3e42737afdcdaf714e33c0a100b51060  a.txt") != 0 && file_has_line(man, "f2c82decdd7181cf98945929a62598db7e6b477e11f6e0eb0ae97020eff151ad  b.txt") != 0, "evidence: manifest of two files", man)
    f: f + check(manifest_verify(man, ev) = 0, "evidence: verify, all files equal", man)
    file_write(txt_path(ev, "b.txt"), "BETA\n", 5U)
    f: f + check(manifest_verify(man, ev) = 1, "evidence: verify, a changed file", man)
    c.remove(txt_path(ev, "a.txt"))
    f: f + check(manifest_verify(man, ev) = 2, "evidence: verify, a changed file and a missing one", man)
    f: f + check(manifest_write(list, ev, txt_path(ev, "again.sha256")) = 1, "evidence: manifest, a missing file", list)
    text: "$ C:/t/gcc.exe -c a.c -o a.o\n  kind 0 exit 0 log a.log\n$ C:/t/gcc.exe a.o -o a.exe\n$ C:/t/l1trans.exe a.lm1 a.c\n"
    file_write(rec, text, c.strlen(text))
    f: f + check(record_exes(rec) = 0, "evidence: deps, no script host started", rec)
    text: "$ C:/t/gcc.exe -c a.c\n$ C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -File t.ps1\n$ C:/t/run.py x\n"
    file_write(rec, text, c.strlen(text))
    f: f + check(record_exes(rec) = 2, "evidence: deps, a script host and a script", rec)
    f: f + check(dir_make(txt_path(ev, "deep/er/dir")) = 0 && file_write(txt_path(ev, "deep/er/dir/f.txt"), "x", 1U) = 0, "evidence: dir_make, a chain of new directories", ev)
    f: f + check(file_same(self, self) = 1, "evidence: same, a file and itself", self)
    f: f + check(file_same(txt_path(ev, "b.txt"), list) = 0, "evidence: same, two different files", list)
    f: f + check(exe_same(self, self) = 1, "evidence: exe-same, an image and itself", self)
    f: f + check(exe_same(list, self) = -1, "evidence: exe-same, no image", list)
    img: file_read(self, len)
    f: f + check(img != 0 && len[0] > 64U, "evidence: the image is read", self)
    if: img != 0 && len[0] > 64U
        pe: (cast: (size_t) (sha_byte(img, 60U) | (sha_byte(img, 61U) << 8) | (sha_byte(img, 62U) << 16) | (sha_byte(img, 63U) << 24)))
        img[pe + 8U]: (cast: (char) (img[pe + 8U] + 1))
        img[pe + 88U]: (cast: (char) (img[pe + 88U] + 1))
        file_write(copy, img, len[0])
        f: f + check(exe_same(self, copy) = 1 && file_same(self, copy) = 0, "evidence: exe-same, another link time and checksum", copy)
        img[len[0] - 1U]: (cast: (char) (img[len[0] - 1U] + 1))
        file_write(copy, img, len[0])
        f: f + check(exe_same(self, copy) = 0, "evidence: exe-same, another byte of the image", copy)
    ---
    c.free(img)
    c.free(len)
    return: f
end: test_evidence

# The self-test in dir: the process contract with child (tools/l2/lmxchild.lm2 built, `build-child`; 0: this
# program, which waits for its own start -- tens of seconds at -O0), hashing and the evidence commands.
fn: selftest (@: dir char; @: child char) int
    @: self char os_self()
    @: run char child
    int: f 0
    if: self = 0
        return: check(0, "selftest", "no executable path")
    if: run = 0
        run: self
    if: dir_make(dir) != 0
        return: check(0, "selftest", "cannot make the work directory")
    f: f + test_args(run, dir)
    f: f + test_exits(run, dir)
    f: f + test_streams(run, dir)
    f: f + test_cwd(run, dir)
    f: f + test_timeout(run, dir)
    f: f + test_spawn_failure(dir)
    f: f + test_hash(dir)
    f: f + test_evidence(self, dir)
    c.printf("SELFTEST %d failures\n", f)
    c.free(self)
    return: f
end: selftest

# The commands a self-test runs this program as.
fn: child (@@: args char; int: n) int
    @: here char 0
    @: f c.FILE 0
    if: n >= 2 && c.strcmp(args[1], "echo-args") = 0
        return: os_args_print()
    if: n >= 3 && c.strcmp(args[1], "exit-with") = 0
        return: c.atoi(args[2])
    if: n >= 2 && c.strcmp(args[1], "streams") = 0
        c.fputs("OUT-LINE\n", c.stdout)
        c.fputs("ERR-LINE\n", c.stderr)
        return: 0
    if: n >= 2 && c.strcmp(args[1], "cwd") = 0
        here: os_cwd()
        if: here = 0
            return: 1
        c.printf("CWD %s\n", here)
        c.free(here)
        return: 0
    if: n >= 3 && c.strcmp(args[1], "sleep-ms") = 0
        return: os_sleep_ms((cast: (unsigned) c.atoi(args[2])))
    if: n >= 4 && c.strcmp(args[1], "sleep-touch") = 0
        os_sleep_ms((cast: (unsigned) c.atoi(args[2])))
        f: c.fopen(args[3], "wb")
        if: f != 0
            c.fclose(f)
        return: 0
    return: -1
end: child

fn: tool_main (@@: args char; int: n) int
    @: hex char c.calloc(65U, 1U)
    int: r 0
    if: hex = 0
        return: 2
    if: n >= 4 && c.strcmp(args[1], "selftest") = 0
        return: selftest(args[2], args[3])
    if: n >= 3 && c.strcmp(args[1], "selftest") = 0
        return: selftest(args[2], 0)
    if: n >= 8 && c.strcmp(args[1], "build-child") = 0
        if: bld_child(args[2], args[3], args[4], args[5], args[6], args[7]) != 0
            return: 1
        return: 0
    if: n >= 3 && c.strcmp(args[1], "sha256") = 0
        if: os_sha256_file(args[2], hex) != 0
            c.fprintf(c.stderr, "lmxtool: cannot hash %s\n", args[2])
            return: 1
        c.printf("%s  %s\n", hex, args[2])
        return: 0
    if: n >= 4 && c.strcmp(args[1], "rows") = 0
        r: rows_extract(args[2], args[3])
        c.printf("ROWS %d\n", r)
        if: r < 0
            return: 1
        return: 0
    if: n >= 5 && c.strcmp(args[1], "stage-copy") = 0
        if: stage_copy(args[2], args[3], args[4]) != 0
            return: 1
        return: 0
    if: n >= 5 && c.strcmp(args[1], "manifest") = 0
        if: manifest_write(args[2], args[3], args[4]) != 0
            return: 1
        return: 0
    if: n >= 4 && c.strcmp(args[1], "verify") = 0
        if: manifest_verify(args[2], args[3]) != 0
            return: 1
        return: 0
    if: n >= 3 && c.strcmp(args[1], "deps") = 0
        if: record_exes(args[2]) != 0
            return: 1
        return: 0
    if: n >= 13 && c.strcmp(args[1], "gate") = 0
        r: gate(args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11], args[12])
        if: r != 0
            return: 1
        return: 0
    if: n >= 4 && c.strcmp(args[1], "same") = 0
        r: file_same(args[2], args[3])
        c.printf("SAME %d %s %s\n", r, args[2], args[3])
        if: r != 1
            return: 1
        return: 0
    if: n >= 4 && c.strcmp(args[1], "exe-same") = 0
        r: exe_same(args[2], args[3])
        c.printf("EXE-SAME %d %s %s\n", r, args[2], args[3])
        if: r != 1
            return: 1
        return: 0
    if: n >= 6 && c.strcmp(args[1], "build-frontend") = 0
        if: bld_frontend(args[2], args[3], args[4], args[5]) != 0
            return: 1
        return: 0
    if: n >= 6 && c.strcmp(args[1], "build-runtime") = 0
        if: bld_runtime(args[2], args[3], args[4], args[5]) != 0
            return: 1
        return: 0
    if: n >= 8 && c.strcmp(args[1], "build-self") = 0
        if: bld_self(args[2], args[3], args[4], args[5], args[6], args[7]) != 0
            return: 1
        return: 0
    if: n >= 9 && c.strcmp(args[1], "suite") = 0
        if: n >= 10
            r: fixture_suite(args[2], args[3], args[4], args[5], args[6], args[7], args[9], args[8])
        if: n < 10
            r: fixture_suite(args[2], args[3], args[4], args[5], args[6], args[7], 0, args[8])
        if: r != 0
            return: 1
        return: 0
    if: n >= 12 && c.strcmp(args[1], "os-walk-witness") = 0
        r: os_walk_witness(args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], c.atoi(args[10]), args[11])
        if: r != 0
            return: 1
        return: 0
    if: n >= 10 && c.strcmp(args[1], "replay") = 0
        r: replay(args[2], args[3], args[4], args[5], args[6], args[7], c.atoi(args[8]), c.atoi(args[9]))
        if: r != 0
            return: 1
        return: 0
    r: child(args, n)
    if: r >= 0
        return: r
    c.fprintf(c.stderr, "lmxtool: usage: selftest DIR [CHILD] | build-child REPO STAGE BASE FRONTEND RUNTIME OUT | sha256 FILE | rows PS1 OUT | stage-copy MANIFEST FROM TO | manifest LIST ROOT OUT | verify MANIFEST ROOT | deps RECORD | same A B | exe-same A B | gate REPO STAGE BASE FRONTEND CENSUS-FRONTEND MUTANT-FRONTEND RUNTIME OBSERVED LIST CENSUS-LIST OUT | replay ROWS SANDBOX WORK FRONTEND-A FRONTEND-B OUT FIRST COUNT | suite LIST REPO STAGE BASE FRONTEND RUNTIME OUT [OBSERVED] | os-walk-witness REPO STAGE BASE FRONTEND PROD OBS SOURCE OUT ENTRY SPEC | build-frontend REPO STAGE BASE LABEL | build-runtime REPO STAGE BASE LABEL | build-self REPO STAGE BASE FRONTEND RUNTIME LABEL\n")
    return: 2
end: tool_main

MainLetter:
    char: []: []: mainArgs
end: MainLetter

MainLetter: m
receiveMessage: m
size_t: n length(m\mainArgs)
size_t: i 0U
size_t: j 0U
size_t: len 0U
@@: args char c.calloc(n + 1U, sizeof(@: char))
@: buf char 0
int: rc 2
while: i < n && args != 0
    len: length(m\mainArgs[i])
    buf: (cast: (@: char) c.malloc(len + 1U))
    j: 0U
    while: buf != 0 && j < len
        buf[j]: m\mainArgs[i][j]
        j: j + 1U
    if: buf != 0
        buf[len]: (cast: (char) 0)
    args[i]: buf
    i: i + 1U
if: args != 0
    rc: tool_main(args, (cast: (int) n))
sendMessage: exit(exit_code: rc; stdout: ""; stderr: "")
return
