fn: lm_compiler_rw_prepared_value (@: span c.L2ValueSpan; int: parent; @: out int) int
    @: rw_mi_cell int (cast: (@: int) (@ c.l2_rw_mi))
    @: selected c.L2Path
    c.L2Address: raw
