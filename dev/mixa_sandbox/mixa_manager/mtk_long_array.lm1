predef: "mixa_manager/mtk_long_array.h.lm1"
include: "<stdlib.h>" "<string.h>"

fn: mtk_long_array_init (@: MtkLongArray a) int
    if: a = 0
        return: 1
    a\amount: 0
    a\arr: 0
return: 0

sub: mtk_long_array_destroy (@: MtkLongArray a)
    if: a != 0
        if: a\arr != 0
            c.free(a\arr)
        a\arr: 0
        a\amount: 0
    ---
end: mtk_long_array_destroy

fn: mtk_long_array_size (const: @(MtkLongArray a)) int
    if: a = 0
        return: 0
return: a\amount

fn: mtk_long_array_element_at (const: @(MtkLongArray a); int: i) long
    if: a = 0 || i >= a\amount || i < 0
        return: (cast: (long) MTK_CONST_NIL)
    return: a\arr[i]

fn: mtk_long_array_first_element (const: @(MtkLongArray a)) long
    if: a = 0 || a\amount = 0
        return: (cast: (long) MTK_CONST_NIL)
    return: a\arr[0]

fn: mtk_long_array_last_element (const: @(MtkLongArray a)) long
    if: a = 0 || a\amount = 0
        return: (cast: (long) MTK_CONST_NIL)
    return: a\arr[a\amount - 1]

fn: mtk_long_array_grow (@: MtkLongArray a; size_t: new_size) void
    size_t: new_cap
    @: long new_arr
    if: a = 0
        return
    if: a\arr != 0 && new_size <= (cast: (size_t) a\amount)
        return
    new_cap: (cast: (size_t) a\amount) << 1
    if: new_cap < 2U
        new_cap: 2U
    if: new_cap < new_size
        new_cap: new_size
    new_arr: (cast: (@: long) c.calloc(new_cap, c.sizeof(long)))
    if: new_arr = 0
        return
    if: a\arr != 0 && a\amount > 0
        c.memcpy(new_arr, a\arr, (cast: (size_t) a\amount) * c.sizeof(long))
        c.free(a\arr)
    a\arr: new_arr
    return

fn: mtk_long_array_add_element (@: MtkLongArray a; long: obj) int
    int: new_amount
    if: a = 0
        return: MTK_CONST_NIL
    new_amount: a\amount + 1
    mtk_long_array_grow(a, (cast: (size_t) new_amount))
    if: a\arr = 0
        return: MTK_CONST_NIL
    a\arr[a\amount]: obj
    a\amount: new_amount
return: a\amount - 1

fn: mtk_long_array_insert_element_at (@: MtkLongArray a; long: obj; int: index) int
    int: i
    if: a = 0 || index < 0
        return: MTK_CONST_NIL
    if: a\amount = 0
        mtk_long_array_add_element(a, obj)
        return: 0
    ---
    mtk_long_array_grow(a, (cast: (size_t) a\amount + 2U))
    if: a\arr = 0
        return: MTK_CONST_NIL
    if: index >= a\amount
        a\arr[a\amount]: obj
        a\amount: a\amount + 1
        return: a\amount - 1
    ---
    i: a\amount
    while: i > index
        a\arr[i]: a\arr[i - 1]
        i: i - 1
    ---
    a\arr[index]: obj
    a\amount: a\amount + 1
return: index

fn: mtk_long_array_remove_element_at (@: MtkLongArray a; int: index) long
    long: ret
    int: i
    if: a = 0 || index < 0 || index >= a\amount
        return: (cast: (long) MTK_CONST_NIL)
    ret: a\arr[index]
    i: index
    while: i < a\amount - 1
        a\arr[i]: a\arr[i + 1]
        i: i + 1
    ---
    a\amount: a\amount - 1
    if: a\amount >= 0
        a\arr[a\amount]: 0
    return: ret

fn: mtk_long_array_set_elementAt (@: MtkLongArray a; long: obj; int: index) long
    long: ret
    if: a = 0 || index < 0
        return: MTK_CONST_NIL
    mtk_long_array_grow(a, (cast: (size_t) index + 1U))
    if: a\arr = 0
        return: MTK_CONST_NIL
    if: index >= a\amount
        ret: MTK_CONST_NIL
        a\amount: index + 1
    else:
        ret: a\arr[index]
    ---
    a\arr[index]: obj
return: ret

fn: mtk_long_array_remove_element (@: MtkLongArray a; long: obj) int
    int: i
    int: n
    i: 0
    n: a\amount
    while: i < n
        if: a\arr[i] = obj
            mtk_long_array_remove_element_at(a, i)
            return: i
        ---
        i: i + 1
    ---
return: MTK_CONST_NIL

fn: mtk_long_array_pop (@: MtkLongArray a) long
    if: a = 0 || a\amount <= 0
        return: (cast: (long) MTK_CONST_NIL)
    a\amount: a\amount - 1
return: a\arr[a\amount]

fn: mtk_long_array_clear (@: MtkLongArray a) void
    if: a != 0
        a\amount: 0
    ---
end: mtk_long_array_clear

fn: mtk_long_array_remove_all_elements (@: MtkLongArray a) void
    mtk_long_array_clear(a)
end: mtk_long_array_remove_all_elements

fn: mtk_long_array_remove_elements_from (@: MtkLongArray a; int: index; int: len) void
    int: i
    if: a = 0 || index < 0 || index >= a\amount
        return
    if: index + len > a\amount
        len: a\amount - index
    ---
    i: index
    while: i < a\amount - len
        a\arr[i]: a\arr[i + len]
        i: i + 1
    ---
    a\amount: a\amount - len
    return
end: mtk_long_array_remove_elements_from

fn: mtk_long_array_reverse (@: MtkLongArray a; int: index; int: newindex) void
    long: obj
    int: i
    if: a = 0 || index < 0 || index >= a\amount || newindex < 0 || newindex >= a\amount
        return
    ---
    if: newindex < index
        obj: a\arr[index]
        i: index
        while: i > newindex
            a\arr[i]: a\arr[i - 1]
            i: i - 1
        ---
        a\arr[newindex]: obj
    else if: index < newindex
        obj: a\arr[index]
        i: index
        while: i < newindex
            a\arr[i]: a\arr[i + 1]
            i: i + 1
        ---
        a\arr[newindex]: obj
    ---
    return
end: mtk_long_array_reverse
