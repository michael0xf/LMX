# B uses A's reference variable only by reading through it; C retargets it by its bare name: through B's
# transparent place the write reaches A (§6.4: any use of the name in B, not only an int read).
(
    Observed:
        int: seen 0
    First:
        int: marker 4
    Second:
        int: marker 9
)
@: shared data[0]
fn: c () int
    selected := shared\Second
    return: selected\marker
fn: b () int
    int: before selected\marker
    int: r c()
    return: before * 100 + r
fn: a () int
    @: selected shared\First
    int: rb b()
    return: selected\marker * 10000 + rb
sub: main ()
    shared\Observed\seen := a()
main()
