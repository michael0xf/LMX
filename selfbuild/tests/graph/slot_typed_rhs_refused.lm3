# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: calls 0
        int: before 0
        int: after 0
)
int: calls 0
int: before 0
int: after 0
@: Holder (A(int: value 1); @: p A; Target(int: value 7))
fn: rhs () int
    node\calls := node\calls + 1
    return: 1
before := 1
Holder\Target[0] := Holder[rhs()]
after := 1

sub: main ()
    @: shared node[0]
    shared\Observed\calls := node\calls
    shared\Observed\before := before
    shared\Observed\after := after
main()
