+# The current input's requirement is a child of this selected fn's args,
+# not of its candidate value. Whole bindings and field paths retain this
+# SAME anchor after input insertion; hidden transported inputs have none.
+# This only projects the existing contract, with no parse or allocation.
+fn: l2_path_root_model_input (int: mi; int: input) int
+    if: mi < 0 || mi >= l2_m_n || input < 0 || input >= l2_m_arity[mi] + l2_m_dyn[mi]
+        return: -1
+    if: l2_input_schema(mi, input) >= 0 && l2_fn_parts_on(mi) != 0 && l2_input_is_descriptor(mi, input) != 0 && l2_input_model(mi, input) >= 0
+        return: input
+return: -1
+
 # One canonical root projection for whole bindings AND written paths.
 # Row identity survives hidden-input insertion; equal spelling is not a
 # substitute row. This only refreshes the existing binding coordinates.
@@ -24519,6 +24531,7 @@ fn: l2_source_use_binding (const: @(L2PathFact fact); @: L2Path out) int
     ---
     if: out\oi >= 0
         out\res: l2_own_res(out\oi)
+    out\model_input: l2_path_root_model_input((fact\method), input)
 return: 0

