Indicator:
    int: command
    int: fault 0
    int: commanded 0
    int: sensed 0
    int: writes 0
    int: reads 0
    int: trace 0
    return: int
    set:
        node\commanded := command
        node\writes += 1
        node\trace := node\trace * 10 + command
        if: node\fault = 0
            node\sensed := command
        if: node\fault = 1
            node\sensed := 0
        if: node\fault = 2
            node\sensed := 1
        return: 1
    observe:
        node\reads += 1
        node\trace := node\trace * 10 + 2
        return: node\sensed

Commissioning:
    @: candidate
    return: int
    check:
        int: onAck candidate\set(command := 1)
        int: onSeen candidate\observe()
        int: offAck candidate\set(command := 0)
        int: offSeen candidate\observe()
        return: onAck = 1 && onSeen = 1 && offAck = 1 && offSeen = 0
