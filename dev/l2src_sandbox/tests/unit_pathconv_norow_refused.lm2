# A pair with no conversion row through a path is refused as an assignment's: `b\z: q` with q an unsigned and z a
# size_t -- "mixed numeric types (a conversion)" (it was stored by C's own conversion).
Box:
    size_t: z 0U
end: Box
fn: peek () int
    Box: b
    unsigned: q 3U
    b\z: q
    return: 7
end: peek
sendMessage: exit(exit_code: peek(); stdout: ""; stderr: "")
return
