fn: lm_compiler_d105_receiving_flow (int: cand; int: mi; int: key) int
    c.L2SchemaField: needed
    c.L2SchemaField: actual
    c.L2SchemaField: previous
    int: own c.lm_compiler_d105_key_own(key)
    int: req c.lm_compiler_input_schema(mi, key)
    int: width
    int: slot 0
    int: prior
    int: occurrence
    int: known
    int: half
    if: own < 0 || req = -1 || cand = req || c.lm_compiler_schema_kind(cand) = 0
        return: (cast: (int) (1))
    # A place of known coverage requires the fields its coverage names at the root, each by
    # the half it names, and looks at no other field: a candidate that lacks one of them is
    # refused where the place receives it and reaches no later Consumer.  A place of unknown
    # coverage receives in full and requires every field.
