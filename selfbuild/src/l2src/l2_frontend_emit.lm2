        if: level > 1 && path[7 + 6 * (level - 2)] = 15
            stop: c.lm_compiler_graph_body_place(path[6 + 6 * (level - 2)])
        if: level > 1 && path[7 + 6 * (level - 2)] = 12
            stop: c.lm_compiler_source_part_place(path[10 + 6 * (level - 2)], path[6 + 6 * (level - 2)])
            if: stop = 0
                return: (cast: (int) (1))
