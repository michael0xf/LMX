Observed:
    int: before 1
    int: after 0
    int: calls 0
end: Observed
int: calls 0
fn: touch () int
    :=: calls (calls + 1)
    return: 0
end: touch
Bad:
    int: p 99
    A:
        int: v 7
    end: A
    @: s Missing
    Types:
        @: p int
        @: s A
    end: Types
end: Bad
Main: (:= (Observed \ before) 1) Bad\Types() (:= (Observed \ after) 1) (:= (Observed \ calls) calls)
