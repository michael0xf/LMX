            # node/for write block had (FABLE-L2-ARG-ADDRESS-DIRTY-20260921-67's
            # `node\x: hi` case), lost when FABLE-SONNET-NODE-ROOT-20260923-121
            # folded node/for writes into this general path-write branch (which
            # only ever parsed a literal), restored here rather than left a
            # silent narrowing of what a path write accepts.
            if: lm_compiler_path_rhs_range((cast: (const: @: c.LmP0Structure) (stmt\as\frame\body)), l2_pkind, stmt) != 0
                return: (cast: (int) (1))
