# Entry Main: a tail with fewer items than the described fields is refused before any item is evaluated: 5. Three
# fields are described, the tail has two, and its first item is a call that writes E\seen. The call answers 5 and
# E\seen stays 0.
@: result 0
E:
    int: seen 0
    return: int
    A:
        node\seen := node\seen * 10 + 1
        return: 1
    end: A
    B:
        node\seen := node\seen * 10 + 2
        return: 2
    end: B
end: E
D:
    return:
        int: x
        int: y
        int: z
    end: return
    C:
        return: E\A() 9
    end: C
end: D
---
Main:
    node\result := D\C()
