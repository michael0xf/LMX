# An untyped graph -- the letter as nextMessage gives it -- passed to a
# MainLetter formal, and then rebound to a MainLetter own field: both are
# admitted at run time by the same walk.
MainLetter:
    char: []: []: mainArgs
end: MainLetter

fn: present (MainLetter: letter) int
return: 1

nextMessage: raw
if: raw = 0
    return: 1
if: present(raw) != 1
    return: 2
MainLetter: m
m: raw
if: m = 0
    return: 3
return: 0
