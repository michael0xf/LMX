TypeSample:
    int: value 0

Candidate:
    int: b
    int: a
    return: int
    encode:
        return: b * 10 + a

SignatureProbe:
    return: int
    run:
        throws:
            FxIndex
            FxTypeToken
            FxKernelFailure
            SequenceSize
            ReceiverIndex
        int: typeCode sys\typeof(TypeSample[0])
        @: PairOperation (typeCode signatureTypes typeCode typeCode)
        PairOperation@: selected Candidate\encode
        return: selected(p0 := 2; p1 := 7) * 100 + Candidate\encode(a := 2; b := 7)
