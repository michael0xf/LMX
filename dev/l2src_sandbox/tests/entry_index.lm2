# An argument read by index: m\mainArgs[1] is argv[1]'s own char Array, NUL
# included, so `@ m\mainArgs[1][0]` is its C string in graph storage.
MainLetter:
    char: []: []: mainArgs
end: MainLetter

MainLetter: m
nextMessage: m
if: length(m\mainArgs) != 2
    sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
    return
c.puts: @ m\mainArgs[1][0]
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
