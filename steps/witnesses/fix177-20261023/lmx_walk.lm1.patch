+# THE ENTRY RECEPTION (lmx_walk.h, LMX_WALK_SOURCE_RECEPTION): every step of the selected body whose source role is
+# RECEPTION is a formal's receiving act. It runs here, once and in body order, after the inputs are open and before the
+# entry load and the body, outside every pad of the body: a refusal is THROWN + IMPLEMENTS out of this activation, the
+# call's `implements`, and no step of the body has run.
+fn: lmx_walk_receive (@: LmxWalkFrame f; @: Lmx body) int
+    LmxWalkValue: dropped
+    @: void child 0
+    size_t: i 0U
+    int: status
+    if: f = 0 || lmx_graph_node_in(f\arena, (cast: (@: void) body)) = 0
+        return: c.LMX_WALK_INVALID
+    while: i < body\array.size
+        if: lmx_graph_cell_in(f\arena, body, i) = 0
+            return: c.LMX_WALK_INVALID
+        child: lmx_graph_value_in(f\arena, body, i)
+        if: lmx_graph_node_in(f\arena, child) != 0 && lmx_walk_op(f, child) = c.LMX_WALK_OP_SET_ARG && lmx_walk_source_of(f, (cast: (@: Lmx) child)) = c.LMX_WALK_SOURCE_RECEPTION
+            status: lmx_walk_eval(f, child, @ dropped)
+            if: status != c.LMX_WALK_OK
+                return: status
+            ---
+        ---
+        i: i + 1U
+    ---
+return: c.LMX_WALK_OK
+
