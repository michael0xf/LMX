# OPEN positive. A merge given as the actual of a callable formal, whose
# model reads a reference among its free names. fivev reads m\v; m is a
# field of the unit made from Model, with v 4. passed gives take
# merge(y: 5; fivev): 9. inner has its own m, with v 40: 45. This
# implementation builds a merge's node by a constructor of its own, which
# cannot yet reach the Structure the unit holds for m where the reference
# is admitted: the merge is refused where it stands, as a limit and no
# rule. Entry 7.
Model:
    int: v 4
end: Model

m: merge Model

fn: fivev (int: y) int
    return: y + m\v

fn: bin () int
    return: 0

fn: take (bin: op) int
    return: op()

fn: passed () int
    return: take: merge(y: 5; fivev)

fn: inner () int
    m: merge Model
    m\v: 40
    return: passed()
end: inner

int: b passed()
int: c inner()
int: ok 7
if: b != 9 || c != 45
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
