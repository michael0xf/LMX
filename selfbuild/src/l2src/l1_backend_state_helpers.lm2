            field: field\next
        if: field = 0
            return: (cast: (int) (c.l1_error(path, source_node, "type alias missing type")))
        while: field != 0
            if: c.l1_node_ignored(field\value) = 0
                if: field\value = 0 || field\value\kind != c.LM_P0_NODE_ATOM
                    return: (cast: (int) (c.l1_error(path, field\value, "type alias expects type name atoms")))
                # A foreign C type can be spelled with its tag keyword: decNumber's
                # rounding is `enum rounding`, and `type: Rounding enum rounding` is
                # the L1 way to name it; `type: L2TestOpaque struct L2TestOpaque`
                # names an incomplete handle.  The keyword is accepted only here, in
                # an alias's spelling, and the tag after it may be a name this header
                # is introducing right now -- an unknown atom is exactly what
                # `typedef struct X X;` declares.
                if: alias_after_tag != 0
                    alias_after_tag: 0
                else:
                    if: c.l1_text_eq(field\value\as\atom, "enum") != 0 || c.l1_text_eq(field\value\as\atom, "struct") != 0 || c.l1_text_eq(field\value\as\atom, "union") != 0
                        alias_after_tag: 1
                    else:
                        if: l1_is_type_name((cast: (const: @: c.LmP0Text) field\value\as\atom)) = 0
                            return: (cast: (int) (c.l1_error(path, field\value, "type alias expects type name atoms")))
                        ---
                    ---
                ---
            ---
            field: field\next
        ---
        return: (cast: (int) (l1_hdr_type_add(name, path, source_node, 97)))
    if: c.l1_text_eq(frame\head, "fn") || c.l1_text_eq(frame\head, "sub")
        field: 0
        if: frame\body != 0
            field: frame\body\first_field
        ---
        while: field != 0
            if: c.l1_node_ignored(field\value) = 0 && field\value != 0 && field\value\kind = c.LM_P0_NODE_STRUCTURE
                return: (cast: (int) (c.l1_error(path, source_node, "executable body")))
            ---
            field: field\next
        return: (cast: (int) (0))
    if: c.l1_text_eq(frame\head, "if") || c.l1_text_eq(frame\head, "while") || c.l1_text_eq(frame\head, "for") || c.l1_text_eq(frame\head, "switch") || c.l1_text_eq(frame\head, "goto") || c.l1_text_eq(frame\head, "throw") || c.l1_text_eq(frame\head, "return")
        return: (cast: (int) (c.l1_error(path, source_node, "executable body")))
    if: c.l1_text_eq(frame\head, "predef")
        return: (cast: (int) (0))
    if: c.l1_text_eq(frame\head, "external") || c.l1_text_eq(frame\head, "import") || c.l1_text_eq(frame\head, "os") || c.l1_text_eq(frame\head, "ifdef")
        return: (cast: (int) (c.l1_error(path, source_node, "executable body")))
    return: (cast: (int) (c.l1_error(path, source_node, "unsupported header unit form")))
end: l1_hdr_check_item
