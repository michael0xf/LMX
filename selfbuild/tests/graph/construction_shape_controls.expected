int: effects 0
fn: touch () int
    :=: (node \ effects) ((node \ effects) + 1)
    return: 1
end: touch
fn: take (int: value; int: other 2) int
    return: (value + other)
end: take
fn: deferred (int: value) int
    return: value
end: deferred
fn: opaque () c.FILE
    return: 0
end: opaque
---
    take: (:= unknown (touch))
---
if: 0 ((deferred) (opaque))
int: positional 7
int: named 7
int: whole 9
int: done 1
