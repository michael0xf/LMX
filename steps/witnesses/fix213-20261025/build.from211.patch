+    if: c.fputs("define: LMX_WALK_OK 0\n# Malformed body tree, not a callable, a field reference that selects nothing, an own\n# field that is not lexically inside M, a missing input.\ndefine: LMX_WALK_INVALID 1\n# A callable with no body node: nothing to walk.\ndefine: LMX_WALK_NO_GRAPH 2\ndefine: LMX_WALK_NOMEM 3\n# An unknown reached executable role or an unsupported reached operation.\ndefine: LMX_WALK_UNSUPPORTED 5\n# THE PRIMITIVE REPORTED A FAILURE: the nonzero ABI status of its own fn (lmx_primitive.h.lm1).\n# A status of its own ON PURPOSE, and each of the four collisions is refused deliberately: it is\n# not business zero (a primitive may return the VALUE 0 with status OK -- that is success, and\n# the value rides in `out`/`dest`, never in the status), not LMX_WALK_INVALID (the graph is well\n# formed and the record was admitted), not LMX_WALK_UNSUPPORTED (this slice DOES read the node)\n# and not LMX_WALK_NO_GRAPH.  It travels up unchanged to whoever mapped the activation; the\n# Thread reports it through the Thread ABI's own existing failure status (lmx_thread.lm1).\ndefine: LMX_WALK_PRIMITIVE 6\n# Reserved distinct dispatch refusal status; not an empty-body or missing-plan rule.\ndefine: LMX_WALK_NOT_CALLABLE 7\n# D-37: an explicit method throw or a recoverable valid-graph operation fault\n# rides as LMX_WALK_THROWN + key, where key is the program's identity of the\n# thrown NAME (below): the walker never renumbers a status between activations\n# and never resolves a spelling.  The per-callee ABI ordinal (declared names\n# 1..d in `throws:` order, implicit names d + g) exists only at the native\n# boundary: lmx_walk_key_from_ordinal / lmx_walk_ordinal_from_key translate\n# through the callee's retained THROWS node.  Malformed-graph and kernel errors\n# stay 1..7 and become X1 at note_walk_fail.\ndefine: LMX_WALK_THROWN 8\n# THE KEY OF A THROW NAME.  The implicit names have the language's fixed\n# keys, in the order of their implicit statuses (g); every