---
    Observed:
        int: seen 909
    end: Observed
---
fn: callee () int
    :=: x 9
    return: x
end: callee
fn: caller () int
    int: x
    int: r (callee)
    return: ((x * 100) + r)
end: caller
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) (caller)
end: main
main:
