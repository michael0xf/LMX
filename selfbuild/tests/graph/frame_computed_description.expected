Observed:
    int: ticks 1
    int: first 80
    int: second 18
    int: source 9
end: Observed
fn: tick () int
    :=: (Observed \ ticks) ((Observed \ ticks) + 1)
    return: 40
end: tick
Inputs:
    int: x 9
    @: observed Observed
    Code:
        :=: (data \ x) 9
        int: total (x + x)
        if: ((observed \ first) = 0) ((:= (observed \ first) total))
        else: (:= (observed \ second) total)
    end: Code
end: Inputs
Main:
    @: body Code
    call: (:= code body)
    call: (:= code body)
    :=: (Observed \ source) (Inputs \ x)
end: Main
