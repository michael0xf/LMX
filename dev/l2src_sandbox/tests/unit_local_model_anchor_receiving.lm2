fn: read () int
    Outer:
        Inner:
            int: x 11
        end: Inner
        fn: take (Inner: v) int
            return: v\x
        end: take
    end: Outer
    Candidate:
        int: pad 99
        int: x 20
    end: Candidate
    copy: merge: Outer
    if: copy\Inner = Outer\Inner
        return: 81
    copy\Inner\x: 17
    if: copy\take(Candidate) != 20 || Outer\take(Candidate) != 20
        return: 81
    if: copy\Inner\x != 17 || Outer\Inner\x != 11 || Candidate\pad != 99
        return: 81
    return: Candidate\x
end: read
int: ok 7
if: read() != 20
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
