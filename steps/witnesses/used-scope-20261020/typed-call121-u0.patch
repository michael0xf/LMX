@@ -281,0 +283,48 @@ return: c.LMX_IMPLEMENTS_UNKNOWN
+# Exact physical-template projection to an EXPLICIT logical declaration. This
+# does not choose a giving Model or search old admissions. Both unqualified
+# resolution and a typed value with no retained map consume this same result.
+# Empty coverage need not have materialized that map before its first use.
+fn: lmx_implements_direct_view (@: LmxArena arena; @: Lmx value; @: Lmx req; @: LmxImplResolve resolver; @: LmxImplEntry out; @: int applied) int
+    const: @: LmxImplTemplate item
+    LmxImplEntry: candidate
+    @: void physical lmx_implements_layout(arena, value)
+    @: void required lmx_implements_layout(arena, req)
+    size_t: i 0U
+    int: owned 0
+    int: answer c.LMX_IMPLEMENTS_YES
+    memset((cast: (@: void) out), 0, c.sizeof(c.LmxImplEntry))
+    \applied: 0
+    if: physical = 0 || required = 0
+        return: c.LMX_IMPLEMENTS_YES
+    while: i < resolver\template_count
+        item: resolver\templates + i
+        i: i + 1U
+        if: item\source_layout != physical || item\required_layout != required
+            continue
+        memset((cast: (@: void) (@ candidate)), 0, c.sizeof(c.LmxImplEntry))
+        candidate.value: value
+        candidate.req: req
+        candidate.layout: physical
+        candidate.map: item\correspondence.map
+        candidate.frame: item\correspondence.frame
+        candidate.at: item\correspondence.at
+        candidate.n: item\correspondence.n
+        candidate.holes: item\correspondence.holes
+        if: candidate.n != req\array.size
+            answer: c.LMX_IMPLEMENTS_UNKNOWN
+            break
+        answer: lmx_implements_accumulate_view(arena, out, @ owned, applied, @ candidate, 0, (req\array.size))
+        if: answer != c.LMX_IMPLEMENTS_YES
+            break
+    ---
+    if: answer != c.LMX_IMPLEMENTS_YES
+        if: owned != 0 && out\map != 0
+            free((cast: (@: void) out\map))
+        memset((cast: (@: void) out), 0, c.sizeof(c.LmxImplEntry))
+        \applied: 0
+        # Conflicting coordinates are UNKNOWN,not a proved bad used leaf.
+        # The analytical Consumer walk alone reports the latter as NO.
+        answer: c.LMX_IMPLEMENTS_UNKNOWN
+    ---
+return: answer
+
