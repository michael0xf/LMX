predef: "l2src/lmx_orphan.h.lm1"
predef: "l2src/lmx_thread.h.lm1"
predef: "l2src/lmx_post.lm1"

# Retention walks R0's sole children Array. `orphaned` is policy state, never membership.

fn: lmx_orphan_init (@: LmxOrphanLedger ledger; @: LmxThread owner) int
    if: ledger = 0 || owner = 0 || lmx_thread_children(owner) = 0
        return: c.LMX_ORPHAN_INVALID
    ledger\owner: owner
    ledger\reclaimed: 0U
return: c.LMX_ORPHAN_OK

fn: lmx_orphan_count (@: LmxOrphanLedger ledger) size_t
    size_t: index
    size_t: count
    @: LmxThread child
    if: ledger = 0 || ledger\owner = 0
        return: 0U
    index: 0U
    count: 0U
    while: index < lmx_thread_child_count(ledger\owner)
        child: lmx_thread_child_at(ledger\owner, index)
        if: child != 0 && child\orphaned != 0
            count: count + 1U
        ---
        index: index + 1U
    ---
return: count

fn: lmx_orphan_reclaimed (@: LmxOrphanLedger ledger) size_t
    if: ledger = 0
        return: 0U
return: ledger\reclaimed

fn: lmx_orphan_adopt (@: LmxOrphanLedger ledger; @: LmxMsg orphan; @: LmxArena orphan_arena; @: LmxThread thread; @: LmxService service; @: LmxManager manager; ulong: now; ulong: limit) int
    @: LmxThread old_parent
    @: LmxArena old_parent_arena
    int: registered
    if: ledger = 0 || ledger\owner = 0 || orphan = 0 || orphan_arena = 0 || thread = 0 || limit = 0U
        return: c.LMX_ORPHAN_INVALID
    if: lmx_thread_message(thread) != orphan || thread\slot = 0 || thread\slot\arena != orphan_arena || thread\orphaned != 0
        return: c.LMX_ORPHAN_INVALID
    old_parent: lmx_thread_parent(thread)
    if: old_parent = ledger\owner || old_parent = 0
        return: c.LMX_ORPHAN_INVALID
    old_parent_arena: 0
    if: old_parent\slot != 0
        old_parent_arena: old_parent\slot\arena
    ---
    if: old_parent_arena = 0 || lmx_thread_child_remove(old_parent, thread) != c.LMX_THREAD_OK
        return: c.LMX_ORPHAN_INVALID
    ---
    if: lmx_thread_child_add(ledger\owner, thread, ledger\owner\slot\arena) != c.LMX_THREAD_OK
        lmx_thread_child_add(old_parent, thread, old_parent_arena)
        return: c.LMX_ORPHAN_FULL
    ---
    registered: 0
    if: service != 0 && lmx_thread_service(thread) = 0
        if: lmx_service_register(service, thread, orphan_arena) != c.LMX_SERVICE_OK
            lmx_thread_child_remove(ledger\owner, thread)
            lmx_thread_child_add(old_parent, thread, old_parent_arena)
            return: c.LMX_ORPHAN_INVALID
        ---
        registered: 1
    ---
    if: lmx_schedule_wait(thread\slot, now) != c.LMX_SCHEDULE_OK
        if: registered != 0
            lmx_service_unregister(service, thread)
        ---
        lmx_thread_child_remove(ledger\owner, thread)
        lmx_thread_child_add(old_parent, thread, old_parent_arena)
        return: c.LMX_ORPHAN_INVALID
    ---
    # No queue is created: this call only validates the schedule against the same owner Array.
    if: manager != 0 && lmx_manager_add(manager, thread\slot) != c.LMX_MANAGER_OK
        if: registered != 0
            lmx_service_unregister(service, thread)
        ---
        lmx_thread_child_remove(ledger\owner, thread)
        lmx_thread_child_add(old_parent, thread, old_parent_arena)
        return: c.LMX_ORPHAN_INVALID
    ---
    thread\orphaned: 1
    thread\orphan_started: now
    thread\orphan_limit: limit
return: c.LMX_ORPHAN_OK

fn: lmx_orphan_reclaim (@: LmxOrphanLedger ledger; @: LmxService service; @: LmxThread child) int
    @: LmxArena arena
    if: ledger = 0 || ledger\owner = 0 || child = 0 || child\orphaned = 0 || child\slot = 0
        return: c.LMX_ORPHAN_INVALID
    arena: child\slot\arena
    if: arena = 0
        return: c.LMX_ORPHAN_INVALID
    if: service != 0 && lmx_thread_service(child) != 0
        lmx_service_unregister(service, child)
    ---
    if: lmx_thread_child_remove(ledger\owner, child) != c.LMX_THREAD_OK
        return: c.LMX_ORPHAN_INVALID
    child\orphaned: 0
    child\orphan_started: 0U
    child\orphan_limit: 0U
    lmx_thread_mail_close(arena, child)
    lmx_arena_release(arena)
    ledger\reclaimed: ledger\reclaimed + 1U
return: c.LMX_ORPHAN_OK

fn: lmx_orphan_maintain (@: LmxOrphanLedger ledger; @: LmxService service; @: LmxManager manager; ulong: now) int
    size_t: index
    @: LmxThread child
    @: LmxMsg message
    int: reclaim
    if: ledger = 0 || ledger\owner = 0
        return: c.LMX_ORPHAN_INVALID
    index: 0U
    while: index < lmx_thread_child_count(ledger\owner)
        child: lmx_thread_child_at(ledger\owner, index)
        if: child = 0
            return: c.LMX_ORPHAN_INVALID
        if: child\orphaned = 0
            index: index + 1U
        else:
            message: lmx_thread_message(child)
            if: message = 0 || child\orphan_limit = 0U
                return: c.LMX_ORPHAN_INVALID
            reclaim: 0
            if: message\running = 0 && message\handoff_ready != 0
                if: message\success != 0 || now - child\orphan_started >= child\orphan_limit
                    reclaim: 1
                ---
            else:
                if: now - child\orphan_started >= child\orphan_limit
                    if: lmx_stop_request(child, now, 0U) != c.LMX_THREAD_OK || lmx_stop_close(child, now) != c.LMX_THREAD_OK
                        return: c.LMX_ORPHAN_INVALID
                    ---
                ---
            ---
            if: reclaim != 0
                if: lmx_orphan_reclaim(ledger, service, child) != c.LMX_ORPHAN_OK
                    return: c.LMX_ORPHAN_INVALID
                ---
            else:
                index: index + 1U
            ---
        ---
    ---
return: c.LMX_ORPHAN_OK

fn: lmx_orphan_release (@: LmxOrphanLedger ledger; @: LmxService service; @: LmxManager manager) int
    size_t: index
    @: LmxThread child
    if: ledger = 0 || ledger\owner = 0
        return: c.LMX_ORPHAN_INVALID
    index: 0U
    while: index < lmx_thread_child_count(ledger\owner)
        child: lmx_thread_child_at(ledger\owner, index)
        if: child = 0
            return: c.LMX_ORPHAN_INVALID
        child\orphaned: 0
        child\orphan_started: 0U
        child\orphan_limit: 0U
        index: index + 1U
    ---
return: c.LMX_ORPHAN_OK
