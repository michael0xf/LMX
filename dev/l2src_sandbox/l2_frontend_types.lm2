        return: (cast: (int) (2))
    if: c.lm_compiler_c_stmt_door(atom) != 0
        \out_ty: c.lm_compiler_foreign_intern(atom, depth, is_const)
        if: \out_ty >= 100
            return: (cast: (int) (0))
        return: (cast: (int) (2))
    return: (cast: (int) (2))
end: lm_compiler_resolve_type_atom

fn: lm_compiler_fnptr_local (const: (@: stmt c.LmP0Node); @@: out_name c.LmP0Text) int
