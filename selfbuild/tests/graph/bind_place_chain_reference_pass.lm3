# B uses A's reference variable only as an actual of another call; C retargets it by its bare name: the write
# reaches A through B's transparent place (the book, #binding-chain; an actual is taken when the call evaluates its operands).
(
    Observed:
        int: seen 0
    First:
        int: marker 4
    Second:
        int: marker 9
)
@: Mark (int: marker 0)
fn: look (@: s Mark) int
    return: s\marker
fn: c () int
    @: shared node[0]
    selected := shared\Second
    return: selected\marker
fn: b () int
    int: before look(selected)
    int: r c()
    return: before * 100 + r
fn: a () int
    @: shared node[0]
    @: selected shared\First
    int: rb b()
    return: selected\marker * 10000 + rb
sub: main ()
    @: shared node[0]
    shared\Observed\seen := a()
main()
