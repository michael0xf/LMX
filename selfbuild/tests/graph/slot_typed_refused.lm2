# Successive raw slot writes are independent of the former field's requirement.
# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: stage 0
)
@: shared data[0]
int: stage 0
int: j 41
@: State (Typed((int: value 1)); B(int: value 7))
State\Typed[0] := State\B
stage := 1
State\Typed[0] := @j
stage := 2

sub: main ()
    shared\Observed\stage := stage
main()
