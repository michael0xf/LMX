# COPIED-METHOD-DECLARED-FORMAL, a completed pair reused: b1\getr(w) twice, the root writing w\x between; the second
# admission meets the pair (w, the copy's Other) the first completed and reads through its map: 40, then 80.
# Exit 7; 81 otherwise.
Wide:
    int: pad 9
    int: x 4
end: Wide
Other:
    int: x 5
end: Other
fn: getr (Other: q) int
    return: q\x * 10
end: getr
Box:
    int: v 0
    fn: getr
end: Box
b1: merge: Box
w: merge: Wide
int: r b1\getr(w)
w\x: 8
int: s b1\getr(w)
int: ok 7
if: r != 40 || s != 80
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
