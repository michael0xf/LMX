# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: result 0
)
fn: outer () int (
    prepared:
        args: (int: a 2)
        return: int
        code: (return: a * 3)
)
    fn: local prepared; return: local(a := 3)
end: outer
int: result outer()
sub: main ()
    @: shared node[0]
    shared\Observed\result := result
main()
