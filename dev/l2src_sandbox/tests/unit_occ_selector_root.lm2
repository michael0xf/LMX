# Three uniquely named fields retain their identity through merge; reads,
# writes and @ select their exact source cells. Success is 7.
Tri: (size_t: xFirst 10U; size_t: xMiddle 20U; size_t: xLast 30U)
fn: poke (@: size_t: p) int
    \p: 77U
    return: 0
end: poke
r: merge: Tri
size_t: got 0U
int: ok 7
got: r\xLast
if: got != 30U
    ok: 81
got: r\xFirst
if: got != 10U
    ok: 82
got: r\xMiddle
if: got != 20U
    ok: 83
got: r\xLast
if: got != 30U
    ok: 84
r\xLast: 99U
got: r\xLast
if: got != 99U
    ok: 85
got: r\xMiddle
if: got != 20U
    ok: 86
got: r\xLast
if: got != 99U
    ok: 87
r\xFirst: 40U
got: r\xFirst
if: got != 40U
    ok: 88
got: r\xLast
if: got != 99U
    ok: 89
poke(@: r\xFirst)
got: r\xFirst
if: got != 77U
    ok: 90
got: r\xLast
if: got != 99U
    ok: 91
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
