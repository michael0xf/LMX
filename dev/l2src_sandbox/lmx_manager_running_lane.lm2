predef: "l2src/lmx_win32_api.h.lm1"
predef: "l2src/lmx_manager_running.h.lm1"

# Native OS door only; the caller explicitly owns each returned handle.
fn: lmx_manager_running_lane_ended (@: slot c.LmxSchedule) int
    if: slot = 0 || slot\lane = 0
        return: 1
    if: c.WaitForSingleObject(slot\lane, 0U) = c.WAIT_OBJECT_0
        return: 1
    return: 0

fn: lmx_manager_running_pause_ms (unsigned: ms) int
    c.Sleep((cast: (ulong) ms))
    return: 0

fn: lmx_mgr_work_entry (@: arg void) ulong
    c.LmxManagerWork: work 0
    @: work_cell c.LmxManagerWork @ work
    \work_cell: (cast: (c.LmxManagerWork) arg)
    if: work = 0
        return: 0U
    return: (cast: (ulong) work(0))

fn: lmx_manager_running_thread_start (c.LmxManagerWork: work) @: void
    return: (cast: (@: void) c.CreateThread(0, 0U, (cast: (c.LmxWin32ThreadStart) c.lmx_mgr_work_entry), (cast: (@: void) work), 0U, 0))

fn: lmx_manager_running_thread_running (@: handle void) int
    if: handle = 0
        return: 0
    if: c.WaitForSingleObject(handle, 0U) = c.WAIT_TIMEOUT
        return: 1
    return: 0

fn: lmx_manager_running_thread_join (@: handle void) int
    if: handle = 0
        return: 0
    c.WaitForSingleObject(handle, c.INFINITE)
    c.CloseHandle(handle)
    return: 0

fn: lmx_manager_running_thread_id () size_t
    return: (cast: (size_t) c.GetCurrentThreadId())
