# A write through the transparent place is seen at once by a nested call and by the caller; no copy-out (§6.2).
(
    Observed:
        int: seen 0
)
fn: probe () int
    return: x
fn: callee () int
    x := 9
    int: inside probe()
    return: inside
fn: caller () int
    int: x 5
    int: r callee()
    return: x * 100 + r
sub: main ()
    @: shared node[0]
    shared\Observed\seen := caller()
main()
