            if: frame != 0 && c.lmx_domain_kind(arena, frame) = c.LMX_KIND_STRUCT
                holder: (cast: (@: c.Lmx) frame)
                holder_fields: 0
                if: holder != 0
                    holder_fields: @ holder\array
                ---
                if: holder_fields\size >= 3U
                    c.lmx_arena_ref_store(holder, 1U, 0)
                    c.lmx_arena_ref_store(holder, 2U, 0)
                    found_int: 1
                ---
            ---
            i: i + 1U
        ---
        check((cast: (int) (found_int != 0)), "erase-add requires an actual ADD")
        return: found_int
    if: c.strcmp(gargv_cell[0][at + 1], "empty-body") = 0
        while: i < graph_fields\size
            child: c.lmx_arena_ref_value(graph, i)
            frame: shape_body(arena, child)
            if: frame != 0 && c.lmx_domain_kind(arena, frame) = c.LMX_KIND_STRUCT
                holder: (cast: (@: c.Lmx) frame)
                holder_fields: 0
                if: holder != 0
                    holder_fields: @ holder\array
                ---
                if: holder_fields\size != 0U
                    while: k < holder_fields\size
                        c.lmx_arena_ref_store(holder, k, 0)
                        k: k + 1U
                    ---
                    return: 1
                ---
            i: i + 1U
        ---
        check((cast: (int) (0)), "empty-body requires a nonempty actual body")
        return: 0
    if: c.strcmp(gargv_cell[0][at + 1], "collapse") = 0
        while: i < graph_fields\size
            child: c.lmx_arena_ref_value(graph, i)
            if: outer = 0 && shape_node_op(child, arena) = c.LMX_WALK_OP_SET
                outer: child
            if: body = 0
                frame: shape_body(arena, child)
                if: frame != 0
                    body: frame
                ---
            ---
            i: i + 1U
        ---
        if: outer != 0 && body != 0 && c.lmx_domain_kind(arena, body) = c.LMX_KIND_STRUCT
            holder: (cast: (@: c.Lmx) body)
            holder_fields: 0
            if: holder != 0
                holder_fields: @ holder\array
            ---
            while: k < holder_fields\size
                child: c.lmx_arena_ref_value(holder, k)
                if: shape_node_op(child, arena) = c.LMX_WALK_OP_SET
                    c.lmx_arena_ref_store(holder, k, outer)
                    found_int: 1
                    k: holder_fields\size
                ---
                k: k + 1U
            ---
        ---
        check((cast: (int) (found_int != 0)), "collapse requires two actual assignment occurrences")
        return: found_int
    check((cast: (int) (0)), "the requested graph mutation is defined")
    return: 0
end: shape_mutate

fn: shape_take (@: arena c.LmxArena; @: item void; int: at) int
    @: holder_fields c.VoidArray 0
    @: gargc_cell int (cast: (@: int) (@ c.gargc))
    @@@: gargv_cell char (cast: (@@@: char) (@ c.gargv))
    int: code
    int: got
    @: frame void 0
    @: holder c.Lmx 0
    @: text char 0
    if: at < 0 || at >= gargc_cell[0]
        return: 0
    if: c.strcmp(gargv_cell[0][at], "null") = 0
        return: (cast: (int) (item = 0))
    if: item = 0
        return: 0
    if: c.strcmp(gargv_cell[0][at], "role") = 0 && at + 2 < gargc_cell[0]
        if: c.lmx_domain_kind(arena, item) = c.LMX_DOMAIN_KIND_OP && shape_node_op(item, arena) = arg(at + 1)
            @: typed_item c.LmxOp (cast: (@: c.LmxOp) item)
            if: typed_item\code / c.LMX_WALK_OP_COUNT = arg(at + 2)
                return: 3
            ---
        return: 0
    if: c.strcmp(gargv_cell[0][at], "sizevalue") = 0 && at + 1 < gargc_cell[0]
        if: c.lmx_domain_kind(arena, item) = c.LMX_KIND_PRIMITIVE && c.lmx_domain_type(arena, item) = c.LMX_TYPE_SIZE_T && c.lmx_size_value_known(item) = (cast: (size_t) arg(at + 1))
            return: 2
        return: 0
    if: c.strcmp(gargv_cell[0][at], "primitive") = 0
        return: (cast: (int) (c.lmx_domain_kind(arena, item) = c.LMX_DOMAIN_KIND_PRIMITIVE && c.lmx_domain_type(arena, item) = c.LMX_DOMAIN_PRIMITIVE))
    if: (c.strcmp(gargv_cell[0][at], "init") = 0 || c.strcmp(gargv_cell[0][at], "implicit") = 0 || c.strcmp(gargv_cell[0][at], "assign") = 0) && at + 1 < gargc_cell[0]
        if: c.lmx_domain_kind(arena, item) != c.LMX_KIND_STRUCT
            return: 0
        code: c.LMX_WALK_SOURCE_ORDINARY
        if: c.strcmp(gargv_cell[0][at], "init") = 0
            code: c.LMX_WALK_SOURCE_INITIALIZER
        if: c.strcmp(gargv_cell[0][at], "implicit") = 0
            code: c.LMX_WALK_SOURCE_IMPLICIT
        if: shape_source_role((cast: (@: c.Lmx) item), arena) = code && shape_node_op(item, arena) = shape_op_code(gargv_cell[0][at + 1])
            return: 2
        return: 0
    if: c.strcmp(gargv_cell[0][at], "intvalue") = 0 && at + 1 < gargc_cell[0]
        if: c.lmx_domain_kind(arena, item) = c.LMX_KIND_PRIMITIVE && c.lmx_domain_type(arena, item) = c.LMX_TYPE_INT && c.lmx_int_value_known(item) = arg(at + 1)
            return: 2
        return: 0
    # Generic exact typed numeric fact, not a new storage or shape category.
    if: c.strcmp(gargv_cell[0][at], "numvalue") = 0 && at + 2 < gargc_cell[0]
        code: numeric_type(gargv_cell[0][at + 1])
        if: code != 0 && c.lmx_domain_kind(arena, item) = c.LMX_KIND_PRIMITIVE && c.lmx_domain_type(arena, item) = code && numeric_holds(item, code, arg(at + 2)) != 0
            return: 3
        return: 0
    if: numeric_type(gargv_cell[0][at]) != 0
        if: c.lmx_domain_kind(arena, item) = c.LMX_KIND_PRIMITIVE && c.lmx_domain_type(arena, item) = numeric_type(gargv_cell[0][at])
            return: 1
        return: 0
    if: c.strcmp(gargv_cell[0][at], "spell") = 0 && at + 1 < gargc_cell[0]
        if: shape_has_spell(arena, item, gargv_cell[0][at + 1]) != 0
            return: 2
        if: c.lmx_domain_kind(arena, item) = c.LMX_KIND_PRIMITIVE && c.lmx_domain_type(arena, item) = c.LMX_TYPE_CHAR_PTR
            text: c.lmx_charptr_value_known((cast: (@: void) item))
            if: shape_spell_is(text, gargv_cell[0][at + 1]) != 0
                return: 2
            ---
        return: 0
    if: c.strcmp(gargv_cell[0][at], "ptr") = 0
        if: c.lmx_domain_kind(arena, item) = c.LMX_KIND_PRIMITIVE && c.lmx_domain_type(arena, item) >= c.LMX_TYPE_POINTER_BASE
            return: 1
        return: 0
    if: c.strcmp(gargv_cell[0][at], "descs") = 0
        if: c.lmx_domain_kind(arena, item) = c.LMX_KIND_ARRAY && c.lmx_domain_type(arena, item) = c.LMX_TYPE_ARRAY_OF_DESC
            return: 1
        return: 0
    if: c.strcmp(gargv_cell[0][at], "array") = 0
        if: c.lmx_domain_kind(arena, item) = c.LMX_KIND_ARRAY
            return: 1
        return: 0
    if: c.strcmp(gargv_cell[0][at], "struct") = 0
        if: c.lmx_domain_kind(arena, item) = c.LMX_KIND_STRUCT && shape_node_op(item, arena) < 0
            return: 1
        return: 0
    if: c.strcmp(gargv_cell[0][at], "add") = 0 && at + 2 < gargc_cell[0]
        frame: shape_find_op(arena, item, c.LMX_WALK_OP_ADD)
        if: frame = 0 || c.lmx_domain_kind(arena, frame) != c.LMX_KIND_STRUCT
            return: 0
        holder: (cast: (@: c.Lmx) frame)
        holder_fields: 0
        if: holder != 0
            holder_fields: @ holder\array
        ---
        if: holder_fields\size < 3U
            return: 0
        if: shape_lit_int(arena, c.lmx_arena_ref_value(holder, 1U), arg(at + 1)) = 0
            return: 0
        if: shape_lit_int(arena, c.lmx_arena_ref_value(holder, 2U), arg(at + 2)) = 0
            return: 0
        return: 3
    code: shape_op_code(gargv_cell[0][at])
    if: code < 0
        return: 0
    got: shape_node_op(item, arena)
    if: got = code
        return: 1
    return: 0
end: shape_take

fn: shape_check_body (@: arena c.LmxArena; @: graph c.Lmx; @: settings c.Lmx; size_t: capacity; @@: stack_box c.Lmx; @: stack_at size_t; @: stack_lim size_t; @@: seen_node void) int
    @: graph_fields c.VoidArray 0
    @: box_fields c.VoidArray 0
    graph_fields: 0
    if: graph != 0
        graph_fields: @ graph\array
    ---
    @: gargc_cell int (cast: (@: int) (@ c.gargc))
    @@@: gargv_cell char (cast: (@@@: char) (@ c.gargv))
    int: at 2
    int: stop 0
    int: tok 0
    size_t: i 0U
    int: used 0
    @: child void 0
    int: saw 0
    int: opened 0
    @: box c.Lmx graph
    box_fields: 0
    if: box != 0
        box_fields: @ box\array
    ---
    size_t: lim 0U
    size_t: depth 0U
    # Each opening/occurrence consumes at least one expectation token. The
    # expectation length therefore bounds this test's storage, not the language.
    int: seen_n 0
    int: seen_i 0
    int: call_open 0
    int: pub_open 0
    int: method_open 0
    int: nest_open 0
    int: skip 0
    int: exact 0
    int: owned 0
    @: owned_child c.Lmx 0
    @: last void 0
    if: graph = 0
        return: 0
    if: shape_paths_check(arena, graph, 0) = 0
        return: 0
    lim: graph_fields\size
    while: at < gargc_cell[0] && c.strcmp(gargv_cell[0][at], "shape") != 0
        at: at + 1
    ---
    if: at >= gargc_cell[0]
        return: 1
    stop: at + 1
    while: stop < gargc_cell[0] && c.strcmp(gargv_cell[0][stop], "endshape") != 0
        stop: stop + 1
    ---
    check((cast: (int) (stop < gargc_cell[0])), "shape names a closed role list")
    if: stop >= gargc_cell[0]
        return: 0
    tok: at + 1
    # Legacy shape rows are coarse projections. Exact rows never search ahead
    # inside a method/call: each graph child must be consumed at its position.
    if: tok < stop && c.strcmp(gargv_cell[0][tok], "exact") = 0
        exact: 1
        tok: tok + 1
    while: tok < stop
        opened: 0
        if: c.strcmp(gargv_cell[0][tok], "owned") = 0
            check((cast: (int) (exact != 0 && owned = 0 && tok + 1 < stop)), "owned prefixes one Structure match in exact mode")
            if: exact = 0 || owned != 0 || tok + 1 >= stop
                return: 0
            owned: 1
            tok: tok + 1
        ---
        skip: 1
        while: exact = 0 && (call_open > 0 || pub_open > 0 || method_open > 0 || nest_open > 0) && i < lim && skip != 0
            child: c.lmx_arena_ref_value(box, i)
            if: child != 0 && c.strcmp(gargv_cell[0][tok], "call") = 0 && shape_node_op(child, arena) = c.LMX_WALK_OP_CALL
                skip: 0
            if: child != 0 && c.strcmp(gargv_cell[0][tok], "pub") = 0 && shape_node_op(child, arena) = c.LMX_WALK_OP_PRIM_PUB
                skip: 0
            if: child != 0 && (c.strcmp(gargv_cell[0][tok], "method") = 0 || c.strcmp(gargv_cell[0][tok], "nest") = 0) && c.lmx_domain_kind(arena, child) = c.LMX_KIND_STRUCT && shape_node_op(child, arena) < 0
                skip: 0
            # `body` opens the operator already matched. `fields` opens the Structure
            # already matched. Do not skip the children that follow either word.
            if: c.strcmp(gargv_cell[0][tok], "body") = 0 || c.strcmp(gargv_cell[0][tok], "fields") = 0 || c.strcmp(gargv_cell[0][tok], "endfields") = 0 || c.strcmp(gargv_cell[0][tok], "same") = 0
                skip: 0
            if: skip != 0 && child != 0 && shape_take(arena, child, tok) > 0
                skip: 0
            if: skip != 0
                i: i + 1U
        ---
        if: c.strcmp(gargv_cell[0][tok], "body") = 0
            child: shape_body(arena, last)
            check((cast: (int) (child != 0 && depth < capacity && c.lmx_domain_kind(arena, child) = c.LMX_KIND_STRUCT)), "body opens the operator's own body")
            if: child = 0 || depth >= capacity || c.lmx_domain_kind(arena, child) != c.LMX_KIND_STRUCT
                return: 0
            stack_box[depth]: box
            stack_at[depth]: i
            stack_lim[depth]: lim
            depth: depth + 1U
            box: (cast: (@: c.Lmx) child)
            box_fields: 0
            if: box != 0
                box_fields: @ box\array
            ---
            i: 0U
            lim: box_fields\size
            tok: tok + 1
            opened: 1
        ---
        if: opened = 0 && c.strcmp(gargv_cell[0][tok], "endbody") = 0
            check((cast: (int) (i = lim && depth > 0U)), "endbody closes a body that was fully read")
            if: i != lim || depth = 0U
                return: 0
            depth: depth - 1U
            box: stack_box[depth]
            box_fields: 0
            if: box != 0
                box_fields: @ box\array
            ---
            i: stack_at[depth]
            lim: stack_lim[depth]
            tok: tok + 1
            opened: 1
        ---
        if: opened = 0 && c.strcmp(gargv_cell[0][tok], "fields") = 0
            check((cast: (int) (last != 0 && depth < capacity && c.lmx_domain_kind(arena, last) = c.LMX_KIND_STRUCT)), "fields opens the named Structure just matched")
            if: last = 0 || depth >= capacity || c.lmx_domain_kind(arena, last) != c.LMX_KIND_STRUCT
                return: 0
            stack_box[depth]: box
            stack_at[depth]: i
            stack_lim[depth]: lim
            depth: depth + 1U
            box: (cast: (@: c.Lmx) last)
            box_fields: 0
            if: box != 0
                box_fields: @ box\array
            ---
            i: 0U
            lim: box_fields\size
            tok: tok + 1
            opened: 1
        ---
        if: opened = 0 && c.strcmp(gargv_cell[0][tok], "endfields") = 0
            check((cast: (int) (i = lim && depth > 0U)), "endfields closes a Structure that was fully read")
            if: i != lim || depth = 0U
                return: 0
            depth: depth - 1U
            box: stack_box[depth]
            box_fields: 0
            if: box != 0
                box_fields: @ box\array
            ---
            i: stack_at[depth]
            lim: stack_lim[depth]
            tok: tok + 1
            opened: 1
        ---
        if: opened = 0 && c.strcmp(gargv_cell[0][tok], "pub") = 0
            check((cast: (int) (i < lim && depth < capacity)), "pub opens a publish node")
            if: i >= lim || depth >= capacity
                return: 0
            child: c.lmx_arena_ref_value(box, i)
            check((cast: (int) (shape_node_op(child, arena) = c.LMX_WALK_OP_PRIM_PUB)), "pub opens a PRIM_PUB")
            if: shape_node_op(child, arena) != c.LMX_WALK_OP_PRIM_PUB
                return: 0
            stack_box[depth]: box
            stack_at[depth]: i + 1U
            stack_lim[depth]: lim
            depth: depth + 1U
            box: (cast: (@: c.Lmx) child)
            box_fields: 0
            if: box != 0
                box_fields: @ box\array
            ---
            i: 0U
            lim: box_fields\size
            pub_open: pub_open + 1
            tok: tok + 1
            opened: 1
        ---
        if: opened = 0 && c.strcmp(gargv_cell[0][tok], "endpub") = 0
            check((cast: (int) (i = lim && depth > 0U && pub_open > 0)), "endpub closes a publish that was fully read")
            if: i != lim || depth = 0U || pub_open = 0
                return: 0
            pub_open: pub_open - 1
            depth: depth - 1U
            box: stack_box[depth]
            box_fields: 0
            if: box != 0
                box_fields: @ box\array
            ---
            i: stack_at[depth]
            lim: stack_lim[depth]
            tok: tok + 1
            opened: 1
        ---
        if: opened = 0 && c.strcmp(gargv_cell[0][tok], "call") = 0
            check((cast: (int) (i < lim && depth < capacity)), "call opens a call node")
            if: i >= lim || depth >= capacity
                return: 0
            child: c.lmx_arena_ref_value(box, i)
            check((cast: (int) (shape_node_op(child, arena) = c.LMX_WALK_OP_CALL)), "call opens a CALL")
            if: shape_node_op(child, arena) != c.LMX_WALK_OP_CALL
                return: 0
            stack_box[depth]: box
            stack_at[depth]: i + 1U
            stack_lim[depth]: lim
            depth: depth + 1U
            box: (cast: (@: c.Lmx) child)
            box_fields: 0
            if: box != 0
                box_fields: @ box\array
            ---
            i: 0U
            lim: box_fields\size
            call_open: call_open + 1
            tok: tok + 1
            opened: 1
        ---
        if: opened = 0 && c.strcmp(gargv_cell[0][tok], "endcall") = 0
            check((cast: (int) (i = lim && depth > 0U && call_open > 0)), "endcall closes a call that was fully read")
            if: i != lim || depth = 0U || call_open = 0
                return: 0
            call_open: call_open - 1
            depth: depth - 1U
            box: stack_box[depth]
            box_fields: 0
            if: box != 0
                box_fields: @ box\array
            ---
            i: stack_at[depth]
            lim: stack_lim[depth]
            tok: tok + 1
            opened: 1
        ---
        if: opened = 0 && (c.strcmp(gargv_cell[0][tok], "method") = 0 || c.strcmp(gargv_cell[0][tok], "nest") = 0)
            check((cast: (int) (i < lim && depth < capacity)), "method or nest opens a retained structure")
            if: i >= lim || depth >= capacity
                return: 0
            child: c.lmx_arena_ref_value(box, i)
            check((cast: (int) (child != 0 && c.lmx_domain_kind(arena, child) = c.LMX_KIND_STRUCT && shape_node_op(child, arena) < 0)), "method or nest opens a structure that is not an operator")
            if: child = 0 || c.lmx_domain_kind(arena, child) != c.LMX_KIND_STRUCT || shape_node_op(child, arena) >= 0
                return: 0
            stack_box[depth]: box
            stack_at[depth]: i + 1U
            stack_lim[depth]: lim
            depth: depth + 1U
            box: (cast: (@: c.Lmx) child)
            box_fields: 0
            if: box != 0
                box_fields: @ box\array
            ---
            i: 0U
            lim: box_fields\size
            if: c.strcmp(gargv_cell[0][tok], "method") = 0
                method_open: method_open + 1
            else:
                nest_open: nest_open + 1
            ---
            tok: tok + 1
            opened: 1
        ---
        if: opened = 0 && c.strcmp(gargv_cell[0][tok], "endmethod") = 0
            check((cast: (int) (i = lim && depth > 0U && method_open > 0)), "endmethod closes a method that was fully read")
            if: i != lim || depth = 0U || method_open = 0
                return: 0
            method_open: method_open - 1
            depth: depth - 1U
            box: stack_box[depth]
            box_fields: 0
            if: box != 0
                box_fields: @ box\array
            ---
            i: stack_at[depth]
            lim: stack_lim[depth]
            tok: tok + 1
            opened: 1
        ---
        if: opened = 0 && c.strcmp(gargv_cell[0][tok], "endnest") = 0
            check((cast: (int) (i = lim && depth > 0U && nest_open > 0)), "endnest closes a nested structure that was fully read")
            if: i != lim || depth = 0U || nest_open = 0
                return: 0
            nest_open: nest_open - 1
            depth: depth - 1U
            box: stack_box[depth]
            box_fields: 0
            if: box != 0
                box_fields: @ box\array
            ---
            i: stack_at[depth]
            lim: stack_lim[depth]
            tok: tok + 1
            opened: 1
        ---
        if: opened = 0 && c.strcmp(gargv_cell[0][tok], "same") = 0
            check((cast: (int) (i < lim)), "same still has a graph child")
            if: i >= lim
                return: 0
            child: c.lmx_arena_ref_value(box, i)
            seen_i: 0
            used: 0
            while: seen_i < seen_n
                if: seen_node[seen_i] = child
                    used: 1
                seen_i: seen_i + 1
            ---
            check((cast: (int) (used != 0)), "same is a structure already read")
            if: used = 0
                return: 0
            i: i + 1U
            tok: tok + 1
            opened: 1
        ---
        if: owned != 0 && opened != 0
            check((cast: (int) (0)), "owned cannot qualify a traversal control or shared reference")
            return: 0
        if: opened = 0
            check((cast: (int) (i < lim)), "the shape still has a graph child")
            if: i >= lim
                return: 0
            child: c.lmx_arena_ref_value(box, i)
            used: 0
            if: used = 0
                used: shape_take(arena, child, tok)
                if: used = 0
                    c.printf("shape mismatch: depth=%u slot=%u token=%s\n", (cast: (unsigned) depth), (cast: (unsigned) i), gargv_cell[0][tok])
                ---
                check((cast: (int) (used != 0)), "graph child matches the next shape word")
                if: used = 0
                    return: 0
                if: owned != 0
                    check((cast: (int) (child != 0 && c.lmx_domain_kind(arena, child) = c.LMX_KIND_STRUCT)), "owned matches an actual Structure")
                    if: child = 0 || c.lmx_domain_kind(arena, child) != c.LMX_KIND_STRUCT
                        return: 0
                    owned_child: (cast: (@: c.Lmx) child)
                    check((cast: (int) (owned_child\parent = box)), "owned Structure has its actual containing parent")
                    if: owned_child\parent != box
                        return: 0
                    owned: 0
                ---
                if: c.lmx_domain_kind(arena, child) = c.LMX_KIND_STRUCT
                    seen_i: 0
                    while: seen_i < seen_n
                        check((cast: (int) (seen_node[seen_i] != child)), "collapsed occurrences")
                        if: seen_node[seen_i] = child
                            return: 0
                        seen_i: seen_i + 1
                    ---
                    seen_node[seen_n]: child
                    seen_n: seen_n + 1
                ---
                last: child
                tok: tok + used
                saw: saw + 1
            ---
            i: i + 1U
        ---
    ---
    check((cast: (int) (depth = 0U && owned = 0)), "every body and ownership expectation was closed")
    if: depth != 0U || owned != 0
        return: 0
    lim: graph_fields\size
    check((cast: (int) (i = lim)), "the graph has no child past the exact source shape")
    if: i != graph_fields\size
        return: 0
    check((cast: (int) (tok = stop && saw > 0)), "the shape accounts for every graph child")
    return: 1
end: shape_check_body

sub: stop_probe_adapter (@: method c.Lmx; @: arena c.LmxArena)
    @: dest void c.malloc(128U)
    @: before void c.malloc(128U)
    @: result void 0
    int: status
    check((cast: (int) (method != 0 && method\native != 0 && dest != 0 && before != 0)), "stopped adapter retains an actual typed native body")
    if: method = 0 || method\native = 0 || dest = 0 || before = 0
        c.abort()
    c.memset(dest, 165, 128U)
    c.memset(before, 165, 128U)
    c.LmxPrimitiveEntry: entry (cast: (c.LmxPrimitiveEntry) method\native)
    status: entry((cast: (@: void) method), 0, 0U, dest, @ result, arena, method, 0, 0)
    check((cast: (int) (status = 0 && result = 0)), "stopped typed adapter has no result or throw")
    check((cast: (int) (c.memcmp(dest, before, 128U) = 0)), "stopped typed adapter leaves destination untouched")
    c.free(dest)
    c.free(before)
end: stop_probe_adapter

fn: stop_first (@: owner void; @@: refs void; size_t: nargs; @: dest void; @@: out void; @: lmx_call_arena c.LmxArena; @: lmx_call_code c.Lmx; @: lmx_input_values c.LmxWalkValue; @: lmx_result_context c.LmxWalkValue) int
    @@: stop_published_cell void (cast: (@@: void) (@ c.stop_published))
    @@: stop_received_cell void (cast: (@@: void) (@ c.stop_received))
    @: stop_calls_cell int (cast: (@: int) (@ c.stop_calls))
    @: stop_saved_view c.LmxPrimitiveEntry (cast: (@: c.LmxPrimitiveEntry) (@ c.stop_saved))
    @@: stop_extra_view c.Lmx (cast: (@@: c.Lmx) (@ c.stop_extra))
    int: status
    int: k 0
    @: current c.LmxThread c.lmx_thread_current()
    @: published void stop_published_cell[0]
    @: receiver void stop_received_cell[0]
    stop_calls_cell[0]: stop_calls_cell[0] + 1
    check((cast: (int) (current != 0 && c.lmx_msg_poll_escape() = 0)), "stop is requested in a genuinely running Message")
    check((cast: (int) (nargs = 0U && dest != 0 && out != 0)), "first actual has its declared scalar result storage")
    check((cast: (int) (published != 0 && c.lmx_int_value_known(published) = 73)), "first actual sees caller dirty value published before call")
    check((cast: (int) (receiver != 0 && c.lmx_int_value_known(receiver) = 99)), "receiving place has its old published value")
    check((cast: (int) (c.lmx_stop_request(current, 1U, 0U) = c.LMX_THREAD_OK && c.lmx_msg_poll_escape() != 0)), "actual stop request clears current Message running")
    c.lmx_int_store_known(dest, 31415)
    out[0]: 0
    c.LmxPrimitiveEntry: entry stop_saved_view[0]
    status: entry(owner, refs, nargs, dest, out, lmx_call_arena, lmx_call_code, lmx_input_values, lmx_result_context)
    check((cast: (int) (status = 0 && out[0] = 0)), "saved native adapter exposes no result after typed body entry stop")
    check((cast: (int) (c.lmx_int_value_known(dest) = 31415)), "saved scalar adapter does not store an absent stopped result")
    while: k < 4
        stop_probe_adapter(stop_extra_view[k], lmx_call_arena)
        k: k + 1
    ---
    return: status
end: stop_first

fn: stop_later_probe (@: owner void; @@: refs void; size_t: nargs; @: dest void; @@: out void; @: lmx_call_arena c.LmxArena; @: lmx_call_code c.Lmx; @: lmx_input_values c.LmxWalkValue; @: lmx_result_context c.LmxWalkValue) int
