# M6 4c, a boundary (slices 345, 348): the named actual `p: y: 6` is a written Structure whose field y is itself a
# Structure (y: 6 defines one, slice 346); since 348 the lowering lays out a tail of typed int literal fields
# (tests/dyn/named_tail_lowered.lm2), not this one yet -- a limit of the implementation, refused where the form is
# recognized, not a rule of the language (the graph's executors read it by role: tests/graph/named_tail.lm2 gives 62).
Point:
    int: x 1
    int: y 2
end: Point
fn: take (Point: p; int: q 2) int
    return: p\y * 10 + q
end: take
int: code 7
if: take(p: y: 6) != 62
    code: 81
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
