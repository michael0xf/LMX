# FABLE-GROKBOT-MATRIX-20260924-143 cell: path target x primitive.
# Physical operation = ASSIGNMENT through the path; read-back confirms.
Model:
    size_t: value 1U
end: Model

Model: m
m\value: 42U
if: m\value != 42U
    sendMessage: exit(exit_code: 11; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
