predef: "l2src/lmx_gc.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_manager.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# The receiving-use contract (Codex, FABLE-CODEX-20261003-01 and -20261004-01): a
# receiving instruction checks what the Consumer of its place reads through that
# place, and the model stays the index space. lmx_implements_receiving_use takes
# the coverage of the instruction being run (LmxImplUses). What this file pins:
#
#   * a coverage that names no field admits a candidate that carries none of the
#     model's fields; null coverage is unknown and stays the full reception;
#   * a field the coverage does not name is not required when it is missing and
#     not compared when it is present with another type;
#   * a field the coverage names is required: missing or of another type is NO;
#   * the answer is the instruction's alone -- a candidate admitted thin and
#     recorded is refused by a later coverage that names the omitted field, and
#     admitted by a fuller coverage of fields it carries, with the same record;
#   * an edge selects its own half of the correspondence: a bare name's LAST
#     half and an explicit occurrence's ORDINAL half are different places;
#   * a nested level is read in the nested model's index space, through the
#     nested pair's own correspondence; a reference held and not entered asks
#     only for its presence, one consumed whole asks for all of it;
#   * the coverage is read from the translator's cells or from the size cells of
#     a walked instruction, with the same answers;
#   * a coverage that cannot be read, or that names an empty place of the
#     model, is UNKNOWN, never YES.
#
# The model: [0] value size_t, [1] extra int, [2] in Inner, [3] a int, [4] a int.
# Inner: [0] x size_t, [1] y int. Width 5: an edge below 5 is a field through its
# ORDINAL half, 5 + j the LAST half of field j.

sub: iu_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: iu_check

# A Structure of n children (at most 5), given as they stand; a null child is an empty slot.
fn: iu_node (@: LmxArena arena; size_t: n; @: void c0; @: void c1; @: void c2; @: void c3; @: void c4) @: Lmx
    @: Lmx s
    s: lmx_node_new_owned(arena)
    if: s = 0 || n > 5U || lmx_arena_refs_open_owned(arena, s, n) != 0
        return: 0
    ---
    if: n > 0U && c0 != 0 && lmx_arena_ref_store(s, 0U, c0) != 0
        return: 0
    if: n > 1U && c1 != 0 && lmx_arena_ref_store(s, 1U, c1) != 0
        return: 0
    if: n > 2U && c2 != 0 && lmx_arena_ref_store(s, 2U, c2) != 0
        return: 0
    if: n > 3U && c3 != 0 && lmx_arena_ref_store(s, 3U, c3) != 0
        return: 0
    if: n > 4U && c4 != 0 && lmx_arena_ref_store(s, 4U, c4) != 0
        return: 0
return: s

sub: iu_fill (@: size_t cells; size_t: n; size_t: v)
    size_t: i 0U
    while: i < n
        cells[i]: v
        i: i + 1U
    ---
end: iu_fill

# A walked instruction's cells: a filler child, then n size cells holding cells[0..n).
fn: iu_frame (@: LmxArena arena; @: size_t cells; size_t: n) @: Lmx
    @: Lmx s
    @: void x
    size_t: i 0U
    s: lmx_node_new_owned(arena)
    if: s = 0 || lmx_arena_refs_open_owned(arena, s, n + 1U) != 0 || lmx_arena_ref_store(s, 0U, lmx_int_new_owned(arena)) != 0
        return: 0
    ---
    while: i < n
        x: lmx_size_new_owned(arena)
        if: x = 0 || lmx_size_store_known(x, cells[i]) != 0 || lmx_arena_ref_store(s, i + 1U, x) != 0
            return: 0
        i: i + 1U
    ---
return: s

# The answer of one reception: the candidate through `map` (pending, null: its
# record or its own places), by the coverage `cells` (null: unknown coverage).
fn: iu_ask (@: LmxArena arena; @: Lmx value; @: Lmx model; @: size_t map; @: size_t cells) int
    LmxImplEntry: view
    LmxImplUses: cover
    @: LmxImplEntry v 0
    @: LmxImplUses u 0
    if: map != 0
        v: @ view
        memset((cast: (@: void) v), 0, c.sizeof(c.LmxImplEntry))
        v\value: value
        v\req: model
        v\map: map
        v\n: model\array.size
    ---
    if: cells != 0
        u: @ cover
        memset((cast: (@: void) u), 0, c.sizeof(c.LmxImplUses))
        u\map: cells
    ---
return: lmx_implements_receiving_use(arena, value, model, model, v, u)

# The same reception with the coverage borne by a walked instruction's cells.
fn: iu_ask_frame (@: LmxArena arena; @: Lmx value; @: Lmx model; @: size_t map; @: Lmx frame; size_t: at) int
    LmxImplEntry: view
    LmxImplUses: cover
    @: LmxImplEntry v 0
    @: LmxImplUses u (@ cover)
    if: map != 0
        v: @ view
        memset((cast: (@: void) v), 0, c.sizeof(c.LmxImplEntry))
        v\value: value
        v\req: model
        v\map: map
        v\n: model\array.size
    ---
    memset((cast: (@: void) u), 0, c.sizeof(c.LmxImplUses))
    u\frame: frame
    u\at: at
return: lmx_implements_receiving_use(arena, value, model, model, v, u)

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: arena
    @: LmxArena at 0
    @: Lmx inner 0
    @: Lmx model 0
    @: Lmx none 0
    @: Lmx brief 0
    @: Lmx typed 0
    @: Lmx turned 0
    @: Lmx cin 0
    @: Lmx nested 0
    @: Lmx cthin 0
    @: Lmx nthin 0
    @: Lmx frame 0
    @: Lmx bad 0
    @: Lmx gapped 0
    size_t: hole (cast: (size_t) -1)
    size_t: records 0U
    size_t: slot 99U
    []: size_t m_none 10
    []: size_t m_short 10
    []: size_t m_kept 10
    []: size_t m_typed 10
    []: size_t m_turned 10
    []: size_t m_nested 10
    []: size_t m_nthin 10
    []: size_t m_cin 4
    []: size_t m_cthin 4
    []: size_t u_empty 2
    []: size_t u_value 4
    []: size_t u_both 6
    []: size_t u_extra 4
    []: size_t u_last 4
    []: size_t u_occ1 4
    []: size_t u_occ0 4
    []: size_t u_path 9
    []: size_t u_whole 4
    []: size_t u_held 4
    []: size_t u_short 1
    []: size_t u_count 6
    []: size_t u_edge 4
    []: size_t u_level 4
    int: failures
    if: counts = 0
        return: 2
    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        fputs("lmx_implements_use: the arena did not open\n", l1_stdout())
        free(counts)
        return: 2
    ---
    at: @ arena
    inner: iu_node(at, 2U, lmx_size_new_owned(at), lmx_int_new_owned(at), 0, 0, 0)
    model: iu_node(at, 5U, lmx_size_new_owned(at), lmx_int_new_owned(at), (cast: (@: void) inner), lmx_int_new_owned(at), lmx_int_new_owned(at))
    # none: two ints the model does not name. brief: value alone. typed: value, then an
    # extra of another type. turned: extra then value. nested: its own inner (y, x), one a.
    none: iu_node(at, 2U, lmx_int_new_owned(at), lmx_int_new_owned(at), 0, 0, 0)
    brief: iu_node(at, 1U, lmx_size_new_owned(at), 0, 0, 0, 0)
    typed: iu_node(at, 2U, lmx_size_new_owned(at), lmx_size_new_owned(at), 0, 0, 0)
    turned: iu_node(at, 2U, lmx_int_new_owned(at), lmx_size_new_owned(at), 0, 0, 0)
    cin: iu_node(at, 2U, lmx_int_new_owned(at), lmx_size_new_owned(at), 0, 0, 0)
    nested: iu_node(at, 2U, (cast: (@: void) cin), lmx_int_new_owned(at), 0, 0, 0)
    cthin: iu_node(at, 1U, lmx_size_new_owned(at), 0, 0, 0, 0)
    nthin: iu_node(at, 1U, (cast: (@: void) cthin), 0, 0, 0, 0)
    if: inner = 0 || model = 0 || none = 0 || brief = 0 || typed = 0 || turned = 0 || cin = 0 || nested = 0 || cthin = 0 || nthin = 0
        free(counts)
        return: 2
    ---
    iu_fill(m_none, 10U, hole)
    iu_fill(m_short, 10U, hole)
    m_short[0]: 0U
    m_short[5]: 0U
    # typed, with the place of its extra kept, and as the translator's pair map gives
    # it: a field of another type is not carried as the model's field.
    iu_fill(m_kept, 10U, hole)
    m_kept[0]: 0U
    m_kept[1]: 1U
    m_kept[5]: 0U
    m_kept[6]: 1U
    iu_fill(m_typed, 10U, hole)
    m_typed[0]: 0U
    m_typed[5]: 0U
    iu_fill(m_turned, 10U, hole)
    m_turned[0]: 1U
    m_turned[1]: 0U
    m_turned[5]: 1U
    m_turned[6]: 0U
    # nested: in at 0; its one `a` is occurrence 0 and the last occurrence, so the
    # ORDINAL half of the model's second `a` is not carried and its LAST half is.
    iu_fill(m_nested, 10U, hole)
    m_nested[2]: 0U
    m_nested[3]: 1U
    m_nested[7]: 0U
    m_nested[8]: 1U
    m_nested[9]: 1U
    iu_fill(m_nthin, 10U, hole)
    m_nthin[2]: 0U
    m_nthin[7]: 0U
    # The nested pair's own correspondence: x at 1, y at 0; and one that carries x alone.
    m_cin[0]: 1U
    m_cin[1]: 0U
    m_cin[2]: 1U
    m_cin[3]: 0U
    m_cthin[0]: 0U
    m_cthin[1]: hole
    m_cthin[2]: 0U
    m_cthin[3]: hole
    # Coverages. Cell 0 is the count of cells, the root level starts at cell 1.
    u_empty[0]: 2U
    u_empty[1]: 0U
    u_value[0]: 4U
    u_value[1]: 1U
    u_value[2]: 5U
    u_value[3]: 0U
    u_both[0]: 6U
    u_both[1]: 2U
    u_both[2]: 5U
    u_both[3]: 0U
    u_both[4]: 6U
    u_both[5]: 0U
    u_extra[0]: 4U
    u_extra[1]: 1U
    u_extra[2]: 6U
    u_extra[3]: 0U
    # bare `a`: the model's last `a` (field 4) through its LAST half. `[1]a`: field 4
    # through its ORDINAL half. `[0]a`: field 3 through its ORDINAL half.
    u_last[0]: 4U
    u_last[1]: 1U
    u_last[2]: 9U
    u_last[3]: 0U
    u_occ1[0]: 4U
    u_occ1[1]: 1U
    u_occ1[2]: 4U
    u_occ1[3]: 0U
    u_occ0[0]: 4U
    u_occ0[1]: 1U
    u_occ0[2]: 3U
    u_occ0[3]: 0U
    # `in\x` and bare `a`: the root level names `in` (LAST half, edge 7) with its nested
    # level at cell 6, and `a`; the nested level names x by Inner's own edge 2.
    u_path[0]: 9U
    u_path[1]: 2U
    u_path[2]: 7U
    u_path[3]: 6U
    u_path[4]: 9U
    u_path[5]: 0U
    u_path[6]: 1U
    u_path[7]: 2U
    u_path[8]: 0U
    u_whole[0]: 4U
    u_whole[1]: 1U
    u_whole[2]: 7U
    u_whole[3]: hole
    u_held[0]: 4U
    u_held[1]: 1U
    u_held[2]: 7U
    u_held[3]: 0U
    u_short[0]: 1U
    # A level that claims two pairs in a coverage of four cells; two more cells
    # stand behind it that are not the coverage's.
    u_count[0]: 4U
    u_count[1]: 2U
    u_count[2]: 5U
    u_count[3]: 0U
    u_count[4]: 5U
    u_count[5]: 0U
    u_edge[0]: 4U
    u_edge[1]: 1U
    u_edge[2]: 10U
    u_edge[3]: 0U
    u_level[0]: 4U
    u_level[1]: 1U
    u_level[2]: 7U
    u_level[3]: 4U

    # A coverage that names no field: the identity of the reference is all it consumes.
    iu_check(counts, iu_ask(at, none, model, m_none, u_empty) = c.LMX_IMPLEMENTS_YES, "a candidate was refused by a coverage that names no field")
    iu_check(counts, iu_ask(at, none, model, m_none, 0) = c.LMX_IMPLEMENTS_NO, "unknown coverage admitted a candidate that carries no field of the model")
    iu_check(counts, iu_ask(at, none, model, m_none, u_value) = c.LMX_IMPLEMENTS_NO, "a field the coverage names was not required")
    iu_check(counts, at\impl_len = 0U, "a reception recorded something by itself")
    # A missing field the coverage does not name.
    iu_check(counts, iu_ask(at, brief, model, m_short, u_value) = c.LMX_IMPLEMENTS_YES, "a missing field outside the coverage refused the candidate")
    iu_check(counts, iu_ask(at, brief, model, m_short, u_both) = c.LMX_IMPLEMENTS_NO, "a missing field the coverage names was passed over")
    iu_check(counts, iu_ask(at, brief, model, m_short, 0) = c.LMX_IMPLEMENTS_NO, "unknown coverage passed over a missing field")
    # A present field of another type the coverage does not name is not compared.
    iu_check(counts, iu_ask(at, typed, model, m_kept, u_value) = c.LMX_IMPLEMENTS_YES, "a present field of another type outside the coverage was compared")
    iu_check(counts, iu_ask(at, typed, model, m_kept, u_both) = c.LMX_IMPLEMENTS_NO, "a present field of another type the coverage names was admitted")
    iu_check(counts, iu_ask(at, typed, model, m_kept, u_extra) = c.LMX_IMPLEMENTS_NO, "the field of another type alone was admitted")
    iu_check(counts, iu_ask(at, typed, model, m_typed, u_value) = c.LMX_IMPLEMENTS_YES, "the pair map's hole outside the coverage refused the candidate")
    # Admitted thin and recorded; then each later instruction answers by its own coverage.
    iu_check(counts, iu_ask(at, brief, model, m_short, u_empty) = c.LMX_IMPLEMENTS_YES && lmx_implements_register_map(at, brief, model, m_short, 5U, 0) = c.LMX_IMPLEMENTS_YES, "a thin admission was not recorded")
    records: at\impl_len
    iu_check(counts, records = 1U, "a thin admission did not leave one record")
    iu_check(counts, iu_ask(at, brief, model, 0, u_extra) = c.LMX_IMPLEMENTS_NO, "a recorded thin admission waived a field a later coverage names")
    iu_check(counts, iu_ask(at, brief, model, 0, 0) = c.LMX_IMPLEMENTS_NO, "a recorded thin admission waived the full reception")
    iu_check(counts, iu_ask(at, brief, model, 0, u_value) = c.LMX_IMPLEMENTS_YES, "a recorded candidate was refused a field it carries")
    iu_check(counts, at\impl_len = records, "a later reception changed the table")
    iu_check(counts, lmx_implements_slot(at, brief, model, 5U, @ slot) = 0 && slot = 0U, "the recorded place of value is not read")
    iu_check(counts, lmx_implements_slot(at, brief, model, 6U, @ slot) != 0, "a field the candidate does not carry got a place")
    # Admitted thin with fields it carries, then consumed more fully: the same record answers.
    iu_check(counts, iu_ask(at, turned, model, m_turned, u_empty) = c.LMX_IMPLEMENTS_YES && lmx_implements_register_map(at, turned, model, m_turned, 5U, 0) = c.LMX_IMPLEMENTS_YES, "the turned candidate was not admitted thin")
    records: at\impl_len
    iu_check(counts, iu_ask(at, turned, model, 0, u_both) = c.LMX_IMPLEMENTS_YES, "a fuller coverage refused fields the recorded candidate carries")
    iu_check(counts, iu_ask(at, turned, model, m_turned, u_both) = c.LMX_IMPLEMENTS_YES && lmx_implements_register_map(at, turned, model, m_turned, 5U, 0) = c.LMX_IMPLEMENTS_YES && at\impl_len = records, "a fuller reception of the same candidate conflicted with its record")
    slot: 99U
    iu_check(counts, lmx_implements_slot(at, turned, model, 5U, @ slot) = 0 && slot = 1U && lmx_implements_slot(at, turned, model, 6U, @ slot) = 0 && slot = 0U, "the turned candidate's places are not the recorded ones")
    # ORDINAL and LAST are different places of one required field.
    iu_check(counts, iu_ask(at, nested, model, m_nested, u_last) = c.LMX_IMPLEMENTS_YES, "a bare name did not reach the candidate's last occurrence")
    iu_check(counts, iu_ask(at, nested, model, m_nested, u_occ1) = c.LMX_IMPLEMENTS_NO, "an explicit second occurrence the candidate lacks was admitted")
    iu_check(counts, iu_ask(at, nested, model, m_nested, u_occ0) = c.LMX_IMPLEMENTS_YES, "an explicit first occurrence the candidate carries was refused")
    # A nested level, in the nested model's index space, through the nested pair's record.
    iu_check(counts, lmx_implements_register_map(at, cin, inner, m_cin, 2U, 0) = c.LMX_IMPLEMENTS_YES, "the nested pair was not admitted")
    iu_check(counts, iu_ask(at, nested, model, m_nested, u_path) = c.LMX_IMPLEMENTS_YES, "a nested partial path was refused")
    iu_check(counts, iu_ask(at, nested, model, m_nested, u_whole) = c.LMX_IMPLEMENTS_YES, "a nested Structure consumed whole was refused though it carries every field")
    iu_check(counts, lmx_implements_register_map(at, cthin, inner, m_cthin, 2U, 0) = c.LMX_IMPLEMENTS_YES, "the thin nested pair was not admitted")
    iu_check(counts, iu_ask(at, nthin, model, m_nthin, u_whole) = c.LMX_IMPLEMENTS_NO, "a nested Structure consumed whole passed over a field it lacks")
    iu_check(counts, iu_ask(at, nthin, model, m_nthin, u_held) = c.LMX_IMPLEMENTS_YES, "a nested Structure held and not entered was entered")
    u_path[7]: 2U
    u_path[1]: 1U
    iu_check(counts, iu_ask(at, nthin, model, m_nthin, u_path) = c.LMX_IMPLEMENTS_YES, "a nested path to a carried field was refused")
    u_path[7]: 3U
    iu_check(counts, iu_ask(at, nthin, model, m_nthin, u_path) = c.LMX_IMPLEMENTS_NO, "a nested path to a field the nested candidate lacks was admitted")
    iu_check(counts, iu_ask(at, nested, model, m_nested, u_path) = c.LMX_IMPLEMENTS_YES, "a nested path was not read through the nested pair's own correspondence")
    u_path[7]: 2U
    u_path[1]: 2U
    # The same coverage borne by a walked instruction's own size cells.
    frame: iu_frame(at, u_path, 9U)
    iu_check(counts, frame != 0 && iu_ask_frame(at, nested, model, m_nested, frame, 1U) = c.LMX_IMPLEMENTS_YES, "a coverage in an instruction's cells was not read")
    frame: iu_frame(at, u_occ1, 4U)
    iu_check(counts, frame != 0 && iu_ask_frame(at, nested, model, m_nested, frame, 1U) = c.LMX_IMPLEMENTS_NO, "a coverage in an instruction's cells did not require its field")
    frame: iu_frame(at, u_empty, 2U)
    iu_check(counts, frame != 0 && iu_ask_frame(at, none, model, m_none, frame, 1U) = c.LMX_IMPLEMENTS_YES, "an empty coverage in an instruction's cells refused the candidate")
    # A coverage that cannot be read certifies nothing.
    iu_check(counts, iu_ask(at, none, model, m_none, u_short) = c.LMX_IMPLEMENTS_UNKNOWN, "a coverage with no root level was read as empty")
    iu_check(counts, iu_ask(at, brief, model, m_short, u_count) = c.LMX_IMPLEMENTS_UNKNOWN, "a level longer than its cells was read")
    frame: iu_frame(at, u_count, 6U)
    iu_check(counts, frame != 0 && iu_ask_frame(at, brief, model, m_short, frame, 1U) = c.LMX_IMPLEMENTS_UNKNOWN, "a level longer than its coverage was read from an instruction's cells")
    iu_check(counts, iu_ask(at, brief, model, m_short, u_edge) = c.LMX_IMPLEMENTS_UNKNOWN, "an edge past both halves of the model was read")
    iu_check(counts, iu_ask(at, nested, model, m_nested, u_level) = c.LMX_IMPLEMENTS_UNKNOWN, "a nested level past the cells was read")
    bad: iu_node(at, 3U, lmx_int_new_owned(at), lmx_int_new_owned(at), lmx_int_new_owned(at), 0, 0)
    iu_check(counts, bad != 0 && iu_ask_frame(at, none, model, m_none, bad, 1U) = c.LMX_IMPLEMENTS_UNKNOWN, "cells that are no sizes were read as a coverage")
    iu_check(counts, iu_ask_frame(at, none, model, m_none, frame, 9U) = c.LMX_IMPLEMENTS_UNKNOWN, "a coverage past the instruction's cells was read")
    # A model with an empty place where the coverage's edge lands: the full walk
    # passes over the place, a coverage that names it certifies nothing.
    gapped: iu_node(at, 5U, lmx_size_new_owned(at), 0, (cast: (@: void) inner), lmx_int_new_owned(at), lmx_int_new_owned(at))
    iu_check(counts, gapped != 0 && iu_ask(at, turned, gapped, m_turned, u_value) = c.LMX_IMPLEMENTS_YES, "a field beside an empty place of the model was refused")
    iu_check(counts, gapped != 0 && iu_ask(at, turned, gapped, m_turned, u_both) = c.LMX_IMPLEMENTS_UNKNOWN, "an edge on an empty place of the model was passed over")

    lmx_arena_release(at)
    failures: counts[1]
    c.printf("lmx_implements_use: %d checks, %d failed\n", counts[0], failures)
    free(counts)
    if: failures != 0
        return: 1
return: 0
