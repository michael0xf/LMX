fn: repeat () int
    int: i 0
    until: (i = 3) ((:= i (i + 1)))
    return: i
end: repeat
fn: condition () int (
    int: calls 0
)
    :=: calls (calls + 1)
    return: (calls >= 2)
end: condition
fn: transitions () int
    int: attempt 0
    until: (condition) ((:= attempt (attempt + 1)) (if (attempt = 1) ((redo))) (if (attempt = 2) ((continue))))
    return: attempt
end: transitions
fn: leave () int
    int: n 0
    until: (condition) ((:= n (n + 1)) (break))
    return: n
end: leave
fn: early () int
    until: (condition) ((return 9))
end: early
fn: body_fields () int
    :=: late 4
    until: (late = 4) ((int late))
    return: late
end: body_fields
fn: bare_body () int
    int: i 1
    until: 1 (i)
    return: i
end: bare_body
sub: main () (
    Repeat:
        until: (x = 2) ((:= x (x + 1)))
    end: Repeat
    Data:
        int: x 0
    end: Data
    RepeatOwn:
        data:
            int: x 0
        end: data
        until: (x = 2) ((:= x (x + 1)))
    end: RepeatOwn
    Self:
        int: x 0
        until: (x = 2) ((int x 0) (:= x (x + 2)))
    end: Self
    int: result 0
    int: before_call 0
    int: after_call 0
    int: transitioned 0
    int: left 0
    int: early_result 0
    int: from_body 0
    int: condition_calls 0
    int: root_value 0
    int: own_before 0
    int: own_after 0
    int: same_data 0
    int: bare_result 0
)
    :=: result ((repeat))
    :=: before_call (Data \ x)
    call: Data Repeat
    :=: after_call (Data \ x)
    :=: transitioned ((transitions))
    :=: left ((leave))
    :=: early_result ((early))
    :=: from_body ((body_fields))
    :=: condition_calls ((condition \ data) \ calls)
    until: (root_value = 2) ((:= root_value (root_value + 1)) (continue))
    :=: own_before ((RepeatOwn \ data) \ x)
    call: (RepeatOwn \ data) RepeatOwn
    :=: own_after ((RepeatOwn \ data) \ x)
    call: Self Self
    :=: same_data (Self \ x)
    :=: bare_result ((bare_body))
end: main
main:
int: result 3
int: before_call 0
int: after_call 2
int: transitioned 3
int: left 1
int: early_result 9
int: from_body 4
int: condition_calls 2
int: root_value 2
int: own_before 0
int: own_after 2
int: same_data 2
int: bare_result 1
