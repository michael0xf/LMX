# Slice 333: `fn: g merge(f1)` creates the function g from the copy of the parts of f1. The call of f1 by its name in
# the copied body resolves from g, created at the root: the function f1 there. r1 = g(3) = 3 + f1(2) = 6 with one call
# of g and three of f1 (c1 3, c2 1); then r2 = f1(2) = 3 (c3 6, c4 1).
# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: r1 0
        int: c1 0
        int: c2 0
        int: r2 0
        int: c3 0
        int: c4 0
)
fn: f1 (int: a) int (int: calls 0)
    data\calls := data\calls + 1
    if: a = 0
        return: 0
    end: if
    return: a + f1(a - 1)
end: f1
fn: g merge(f1)
int: r1 g(3)
int: c1 f1\data\calls
int: c2 g\data\calls
int: r2 f1(2)
int: c3 f1\data\calls
int: c4 g\data\calls

sub: main ()
    @: shared node[0]
    shared\Observed\r1 := r1
    shared\Observed\c1 := c1
    shared\Observed\c2 := c2
    shared\Observed\r2 := r2
    shared\Observed\c3 := c3
    shared\Observed\c4 := c4
main()
