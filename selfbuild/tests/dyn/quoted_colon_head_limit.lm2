# The colon form of assign_operator_quoted_refused (P0 refuses `x` := 5): `x`: 5 with an exact identifier as the head
# meets a limit of the translator -- "unsupported body": no statement route classifies a head
# written as an exact identifier (lm_compiler_ident accepts no backticks).
fn: f () int
    int: x 1
    `x`: 5
    return: x
end: f
int: code 7
if: f() != 5
    code: 81
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
