# General finite typed sources for the single Pattern engine.

RxSourceDomain:
    @: literalUnits 0
    @: rangeUnit 0
    @: slice 0

RxPreparedSource:
    @: view 0
    @: units 0
    @RxSourceDomain: domain 0
    @: profile 0

ArrayView:
    @: items 0
    @: prepare RxArrayPrepare\make

RxArrayProfile:

RxArrayView:
    private: @: items
    required: items
    return: @
    arrayView:
        throws: copy(FxThrows\pattern)
        FxSeqInfo\get(items)
        private: @: view (copy(ArrayView))
        view\items := items
        return: view

RxSourceMake:
    private:
        @: view
        @: units
        @RxSourceDomain: domain
        @: profile
    required: view units domain profile
    return: @
    make:
        private: @: source (copy(RxPreparedSource))
        source\view := view
        source\units := units
        source\domain := domain
        source\profile := profile
        return: source

RxArrayLiteralUnits:
    private:
        @: value
        @: profile
    required: value profile
    return: @
    make:
        throws: copy(FxThrows\pattern)
        FxSeqInfo\get(value)
        return: value

RxTextLiteralUnits:
    private:
        @: value
        @RxPreparedText: profile
    required: value profile
    return: @
    make:
        throws: copy(FxThrows\pattern)
        private: []char: text \value
        private: @: prepared RxTextBuild\make(text; profile\profile)
        return: prepared\units

RxArrayDomain:
    @: literalUnits RxArrayLiteralUnits\make
    @: rangeUnit RxArrayRangeUnit\get
    @: slice RxArraySourceSlice\copyValue

RxTextDomain:
    @: literalUnits RxTextLiteralUnits\make
    @: rangeUnit RxTextRangeUnit\get
    @: slice RxTextSourceSlice\copyValue

RxArrayPrepare:
    private: @ArrayView: source
    required: source
    return: @
    make:
        throws: copy(FxThrows\pattern)
        FxSeqInfo\get(source\items)
        return: RxSourceMake\make(
            source;
            source\items;
            RxArrayDomain;
            RxArrayProfile
        )

RxTextPrepareSource:
    private: @TextView: source
    required: source
    return: @
    make:
        throws: copy(FxThrows\pattern)
        private: @: text RxPrepare\make(source)
        return: RxSourceMake\make(source; text\units; RxTextDomain; text)

# Public views explicitly carry their preparing operation. No classification by
# guessed field contents and no global source-domain registry is used.
RxPrepareSource:
    private: @: source
    required: source
    return: @
    make:
        throws: copy(FxThrows\pattern)
        private: @: prepare source\prepare
        return: prepare(source := source)

RxArrayRangeUnit:
    private:
        @: value
        @: profile
    required: value profile
    return: @
    get:
        return: value

RxTextRangeUnit:
    private:
        @: value
        @RxPreparedText: profile
    required: value profile
    return: @
    get:
        throws: copy(FxThrows\pattern)
        private: @: units RxTextLiteralUnits\make(value; profile)
        if: length(units) != 1
            throw: PatternArgument()
        return: FxSeqRead\read(units; 0)

RxArraySourceSlice:
    private:
        @RxPreparedSource: source
        int: begin
        int: end
    required: source begin end
    return: @
    copyValue:
        throws: copy(FxThrows\pattern)
        return: FxSeqSlice\slice(source\units; begin; end)

RxTextSourceSlice:
    private:
        @RxPreparedSource: source
        int: begin
        int: end
    required: source begin end
    return: @
    copyValue:
        throws: copy(FxThrows\pattern)
        private: @RxPreparedText: text source\profile
        if: begin < 0 || end < begin || end > length(text\units)
            throw: PatternPosition()
        return: FxSeqSlice\slice(text\source; text\byteOffsets[begin]; text\byteOffsets[end])

RxSourceSlice:
    private:
        @RxPreparedSource: source
        int: begin
        int: end
    required: source begin end
    return: @
    copyValue:
        throws: copy(FxThrows\pattern)
        private: @: slice source\domain\slice
        return: slice(source := source; begin := begin; end := end)

RxSourceAppend:
    private:
        @: target
        @: fragment
        @RxPreparedSource: source
    required: target fragment source
    append:
        throws: copy(FxThrows\pattern)
        private: @: validate source\domain\literalUnits
        validate(value := fragment; profile := source\profile)
        FxSeqAppend\append(target; fragment)

RxSourceAppendSpan:
    private:
        @: target
        @RxPreparedSource: source
        int: begin
        int: end
    required: target source begin end
    append:
        throws: copy(FxThrows\pattern)
        FxSeqAppend\append(target; RxSourceSlice\copyValue(source; begin; end))

# A public replacement is accepted in the chosen literal/callable role before
# matching. These two adapters are ordinary actor-context entries.
RxReplacementInput:
    @: literal 0
    @: operation 0

RxReplacementLiteral:
    private: @: value
    required: value
    return: @
    accept:
        throws: copy(FxThrows\pattern)
        FxSeqInfo\get(value)
        private: @: result (copy(RxReplacementInput))
        result\literal := value
        return: result

RxReplacementCallable:
    private: @: operation
    required: operation
    return: @
    accept:
        throws: copy(FxThrows\pattern)
        private: @: shape FxKernel\signature(operation)
        if: length(shape\inputTypes) != 1 || shape\hasResult = 0
            throw: FxArity()
        private: @: result (copy(RxReplacementInput))
        result\operation := operation
        return: result

RxReplacementValue:
    private:
        @RxReplacementInput: replacement
        @Match: matched
    required: replacement matched
    return: @
    make:
        throws: copy(FxThrows\pattern)
        private: @: result replacement\literal
        if: replacement\operation != 0
            result := FxApply\apply(replacement\operation; FxOne\make(matched))
        private: @RxPreparedSource: source matched\private\prepared
        private: @: validate source\domain\literalUnits
        validate(value := result; profile := source\profile)
        return: result
