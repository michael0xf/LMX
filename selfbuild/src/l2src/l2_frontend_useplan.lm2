        required_token: c.lm_compiler_schema_token_slot((cast: (int) (plan\requirement)))
        if: source_token < 0 || required_token < 0
            return: (cast: (int) (c.lm_compiler_error(src_cell[0], here_node_cell[0], "internal: a prepared catalog has no physical layout token")))
        if: c.fprintf(out_cell[0], "%sif: lmx_walk_store_charptr(l2_program_arena, %s, %zuU, l2_layout_tokens + %d) != c.LMX_WALK_OK || lmx_walk_store_charptr(l2_program_arena, %s, %zuU, l2_layout_tokens + %d) != c.LMX_WALK_OK || lmx_walk_store_size(l2_program_arena, %s, %zuU, %dU) != c.LMX_WALK_OK\n%s    %s\n", ind, frame, at, source_token, frame, at + 1U, required_token, frame, at + 2U, plan\physical_width, ind, failure) < 0
            return: (cast: (int) (1))
        at: at + 3U
        j: 0
        while: j < plan\physical_width * 2
            if: lm_compiler_d105_catalog_cell(plan, j, @ cell) != 0
                return: (cast: (int) (c.lm_compiler_error(src_cell[0], here_node_cell[0], "internal: a catalog cell has no prepared physical coordinate")))
            if: c.fprintf(out_cell[0], "%sif: lmx_walk_store_size(l2_program_arena, %s, %zuU, (cast: (size_t) %d)) != c.LMX_WALK_OK\n%s    %s\n", ind, frame, at, cell, ind, failure) < 0
                return: (cast: (int) (1))
            at: at + 1U
            j: j + 1
        ---
        count: count + 1U
        row: row\next
    ---
    if: count != catalog\count || at != catalog\extent
        return: (cast: (int) (c.lm_compiler_error(src_cell[0], here_node_cell[0], "internal: catalog extent/count disagree with its prepared rows")))
    return: (cast: (int) (0))
end: lm_compiler_emit_catalog_cells

