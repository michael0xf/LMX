# Ordinary L2 writer, text and path helpers for the L1-to-C translator.
# P0 and three automatic raw-buffer records are declaration-only L3 output.
predef: "l1src/p0.h.lm1"
predef: "l1src/l1_backend_scratch.h.lm1"
include: "<stddef.h>" "<stdio.h>" "<string.h>" "<stdlib.h>"

# Original: l1src/l1trans.lm1:173
fn: l1_text_eq (const: (@: text c.LmP0Text); const: (@: s char)) int
    size_t: n
    if: text = 0 || s = 0
        return: (cast: (int) (0))
    n: c.strlen(s)
    if: text\data = 0
        return: (cast: (int) (n = 0U))
    return: (cast: (int) (text\length = n && c.memcmp(text\data, s, n) = 0))
end: l1_text_eq

# Original: l1src/l1trans.lm1:182
fn: l1_head_is (const: (@: text c.LmP0Text); const: (@: s char)) int
    size_t: start 0U
    size_t: n 0U
    size_t: sn 0U
    if: text = 0 || text\data = 0 || s = 0
        return: (cast: (int) (0))
    n: text\length
    if: n >= 2U && text\data[0] = 96 && text\data[n - 1U] = 96
        start: 1U
        n: n - 2U
    ---
    sn: c.strlen(s)
    if: n != sn
        return: (cast: (int) (0))
    if: n = 0U
        return: (cast: (int) (1))
    return: (cast: (int) (c.memcmp(text\data + start, s, n) = 0))
end: l1_head_is

# Original: l1src/l1trans.lm1:200
fn: l1_ident_is_reserved (const: (@: text c.LmP0Text)) int
    if: l1_head_is(text, "C") || l1_head_is(text, "L1") || l1_head_is(text, "L2") || l1_head_is(text, "L3")
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: l1_ident_is_reserved

# Original: l1src/l1trans.lm1:205
fn: l1_span_is_reserved (const: (@: data char); size_t: start; size_t: n) int
    if: data = 0
        return: (cast: (int) (0))
    if: n = 1U && data[start] = 67
        return: (cast: (int) (1))
    if: n = 2U && data[start] = 76 && (data[start + 1U] = 49 || data[start + 1U] = 50 || data[start + 1U] = 51)
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: l1_span_is_reserved

# Original: l1src/l1trans.lm1:214
fn: l1_text_starts (const: (@: text c.LmP0Text); const: (@: s char)) int
    size_t: n
    if: text = 0 || text\data = 0 || s = 0
        return: (cast: (int) (0))
    n: c.strlen(s)
    if: text\length < n
        return: (cast: (int) (0))
    return: (cast: (int) (c.memcmp(text\data, s, n) = 0))
end: l1_text_starts

