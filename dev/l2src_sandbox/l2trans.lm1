        # (l2_own_excl above) -- "int: x (x + 2)" after "int: x 1" must read the first x.
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && declaration\candidate_count > 0
            l2_own_excl: oi
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && declaration\candidate_count > 0
            pret: l2_emit_init_convert(stmt, declaration\candidate, mi, ind, l2_tok)
            if: pret = 1
                l2_own_excl: -1
                return: 1
            if: pret = 2 && l2_eval_fields(declaration\candidate, declaration\candidate_count, mi, ind, l2_tok) != 0
                l2_own_excl: -1
                return: 1
            ---
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && declaration\candidate_count > 0
            l2_own_excl: -1
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && declaration\candidate_count > 0 && l2_own_store(mi, oi, ind, l2_tok\data) != 0
            return: 1
        # Carry (-189 c3b-2): a declaration binding a formal's field without an initializer stores the
        # name's value as it reads just before the line -- the argument, or an enclosing bound field.
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && declaration\candidate_count = 0 && l2_m_uses[l2_own_off(mi, oi)] != 0 && l2_own_direct(mi, oi) != 0 && l2_own_formal(mi, oi) >= 0
            l2_own_excl: oi
            nxt: l2_next_active(stmt\as\frame\body\first_field)
            pret: l2_emit_value_convert_field(stmt, nxt, 1, l2_ft_of_own(l2_own_ty[oi]), mi, ind, l2_tok)
            if: pret = 2
                pret: l2_eval_fields(nxt, 1, mi, ind, l2_tok)
            l2_own_excl: -1
            if: pret != 0 || l2_own_store(mi, oi, ind, l2_tok\data) != 0
                return: 1
        ---
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt)
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && (stmt = 0 || stmt\as = 0 || stmt\as\frame = 0)
            return: 1
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0
            fr: stmt\as\frame
        # §7b: a return is an exit -- what is marked is published before it (book §14), after its value.  A `return` with
        # no value is emitted above, for both spellings; one with a value in a callable that returns nothing was refused.
        # `return: v` evaluates v as every value is evaluated -- a callable named there is called
        # (l2_prep), in a body and in a trailer (l2_emit_ret_tr) alike.
