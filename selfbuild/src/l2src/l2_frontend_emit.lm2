    @@@: provider_names_cell char (cast: (@@@: char) (@ c.l2_provider_names))
    @: provider_n_cell int (cast: (@: int) (@ c.l2_provider_n))
    @@@: machine_names_cell char (cast: (@@@: char) (@ c.l2_machine_names))
    @: machine_n_cell int (cast: (@: int) (@ c.l2_machine_n))
    const: (@@: header_path_cell char (cast: (const: @@: char) (@ c.l2_header_path)))
    @: snap_touch_cell int (cast: (@: int) (@ c.l2_snap_touch))
    @@@: part_path_cell char (cast: (@@@: char) (@ c.l2_part_path))
    @: part_n_cell int (cast: (@: int) (@ c.l2_part_n))
    const: (@@: rt_root_cell char (cast: (const: @@: char) (@ c.l2_rt_root)))
    @: fail_left_cell int (cast: (@: int) (@ c.l2_fail_left))
    @@: alloc_trace_cell c.FILE (cast: (@@: c.FILE) (@ c.l2_alloc_trace))
    @: diag_n_cell int (cast: (@: int) (@ c.l2_diag_n))
    @: alloc_n_cell int (cast: (@: int) (@ c.l2_alloc_n))
    @: free_n_cell int (cast: (@: int) (@ c.l2_free_n))
    @: alloc_live_cell int (cast: (@: int) (@ c.l2_alloc_live))
    @: alloc_fail_at_cell int (cast: (@: int) (@ c.l2_alloc_fail_at))
    @: alloc_fail_kind_cell int (cast: (@: int) (@ c.l2_alloc_fail_kind))
    @: alloc_err_cell int (cast: (@: int) (@ c.l2_alloc_err))
    int: r
    int: a 1
    @: af c.FILE
    const: (@: lg char)
    const: (@: rt char)
    c.setvbuf(c.l1_stdout(), 0, c._IONBF, 0)
    c.setvbuf(c.l1_stderr(), 0, c._IONBF, 0)
    # The test knob `--walk-methods` (-193 T4a): a method with frames gets native 0.
    if: argc >= a + 3 && c.strcmp(argv[a], "--walk-methods") = 0
        walk_methods_cell[0]: 1
        a: a + 1
    ---
    # The library profile is selected here, never inferred from the unit.
    if: argc >= a + 3 && c.strcmp(argv[a], "--library") = 0
        library_flag_cell[0]: 1
        a: a + 1
    ---
    # A library's construction export is named by the build, never derived from the unit or its path.
    if: library_flag_cell[0] != 0 && argc >= a + 4 && c.strcmp(argv[a], "--construct") = 0
        construct_name_cell[0]: argv[a + 1]
        a: a + 2
    ---
    # The constructions the build links into this program, each by its export's exact name.
    while: argc >= a + 4 && c.strcmp(argv[a], "--provider") = 0
        if: provider_names_cell[0] = 0
            provider_names_cell[0]: (cast: (@@: char) c.calloc((cast: (size_t) argc), sizeof(@: char)))
        if: provider_names_cell[0] = 0
            c.fputs("l2trans error: out of memory\n", c.l1_stderr())
            return: (cast: (int) (1))
        provider_names_cell[0][provider_n_cell[0]]: argv[a + 1]
        provider_n_cell[0]: provider_n_cell[0] + 1
        a: a + 2
    ---
    # The machine functions a library exports with a direct C-compatible entry (S8.2, L2 section 20), each by its
    # exact name, and the header its machine module writes.
    while: argc >= a + 4 && c.strcmp(argv[a], "--machine") = 0
        if: machine_names_cell[0] = 0
            machine_names_cell[0]: (cast: (@@: char) c.calloc((cast: (size_t) argc), sizeof(@: char)))
        if: machine_names_cell[0] = 0
            c.fputs("l2trans error: out of memory\n", c.l1_stderr())
            return: (cast: (int) (1))
        machine_names_cell[0][machine_n_cell[0]]: argv[a + 1]
        machine_n_cell[0]: machine_n_cell[0] + 1
        a: a + 2
    ---
    if: argc >= a + 4 && c.strcmp(argv[a], "--header") = 0
        header_path_cell[0]: argv[a + 1]
        a: a + 2
    ---
    # The snapshot's test flag (l2_snap_touch): `--snap-touch FILE`.
    if: argc >= a + 4 && c.strcmp(argv[a], "--snap-touch") = 0
        snap_touch_cell[0]: c.atoi(argv[a + 1])
        a: a + 2
    ---
    if: argc < a + 2
        c.fputs("usage: l2trans.exe [--walk-methods] [--library (--construct NAME | --machine NAME ... [--header FILE])] [--provider NAME ...] [--snap-touch FILE] <source.lm2> [<part.lm2> ...] <output.lm1>\n", c.l1_stderr())
        return: (cast: (int) (1))
    if: library_flag_cell[0] != 0 && machine_n_cell[0] = 0 && lm_compiler_construct_name_ok(construct_name_cell[0]) = 0
        c.fputs("l2trans error: a library translation needs --construct NAME: a C name, not l2_ or lmx_, of its construction export\n", c.l1_stderr())
        return: (cast: (int) (1))
    # A machine module (S8.2) is a library with no construction: a unit whose functions are entered by C alone.
    if: machine_n_cell[0] > 0 && (library_flag_cell[0] = 0 || construct_name_cell[0] != 0)
        c.fputs("l2trans error: --machine NAME is a machine module's: a library translation with no --construct\n", c.l1_stderr())
        return: (cast: (int) (1))
    if: header_path_cell[0] != 0 && machine_n_cell[0] = 0
        c.fputs("l2trans error: --header FILE is a machine module's: it needs --machine NAME\n", c.l1_stderr())
        return: (cast: (int) (1))
    int: mk 0
    int: mj 0
    while: mk < machine_n_cell[0]
        if: c.strncmp(machine_names_cell[0][mk], "l2_", 3U) = 0
            c.fprintf(c.l1_stderr(), "l2trans error: --machine %s: a machine function's C name is not l2_, the translator's own\n", machine_names_cell[0][mk])
            return: (cast: (int) (1))
        mj: 0
        while: mj < mk
            if: c.strcmp(machine_names_cell[0][mj], machine_names_cell[0][mk]) = 0
                c.fprintf(c.l1_stderr(), "l2trans error: --machine %s is given twice\n", machine_names_cell[0][mk])
                return: (cast: (int) (1))
            mj: mj + 1
        ---
        mk: mk + 1
    ---
    int: pk 0
    int: pj 0
    while: pk < provider_n_cell[0]
        if: lm_compiler_construct_name_ok(provider_names_cell[0][pk]) = 0
            c.fprintf(c.l1_stderr(), "l2trans error: --provider %s: a provider is a construction export's C name, not l2_ or lmx_\n", provider_names_cell[0][pk])
            return: (cast: (int) (1))
        pj: 0
        while: pj < pk
            if: c.strcmp(provider_names_cell[0][pj], provider_names_cell[0][pk]) = 0
                c.fprintf(c.l1_stderr(), "l2trans error: --provider %s is given twice\n", provider_names_cell[0][pk])
                return: (cast: (int) (1))
            pj: pj + 1
        ---
        pk: pk + 1
    ---
    # The program (steps/table-receiver.md §8, Q46): the source, the files named after it -- its parts --
    # and the output last.
    part_path_cell[0]: argv + a + 1
    part_n_cell[0]: argc - a - 2
    rt: c.getenv("L2_RUNTIME_ROOT")
    if: rt != 0 && rt[0] != 0
        rt_root_cell[0]: rt
    if: c.getenv("L2_FAIL_MALLOC") != 0
        fail_left_cell[0]: c.atoi(c.getenv("L2_FAIL_MALLOC"))
    if: c.getenv("L2_ALLOC_TRACE") != 0
        alloc_trace_cell[0]: c.fopen(c.getenv("L2_ALLOC_TRACE"), "wb")
    r: lm_compiler_translate_program(argv[a], argv[argc - 1])
    # A failure that printed no located diagnostic is still a failure the
    # user must see; a silent exit 1 names nothing to fix.  It is an invariant break of the
    # translator (D-112): every refusal says where and why -- this line names the step that did
    # not, and exits 3, apart from a refusal's 1.
    if: r != 0 && diag_n_cell[0] = 0
        c.fprintf(c.l1_stderr(), "l2trans error: %s: internal: a refusal said nothing (a step failed without a located diagnostic)\n", argv[a])
        r: 3
