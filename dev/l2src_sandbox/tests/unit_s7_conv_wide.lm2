# implements-port slice 11 (B2; REVIEW f2a1578: the needs-a-name message also covered overflow):
# unit_s7_prim_cross over its own convert.lm2 with 33 columns (tests/unit_s7_conv_wide_table.lm2), 27 of
# other names, held in each row and not read.  FIXED-BLOCKS-AUDIT: a positive since the translation keeps as
# many columns as a table has; it was refused at the 33rd column, "a table has too many columns".

fn: go () int
    int: a 1
    size_t: b 2U
    a: b
    return: a

int: k
k: go()
if: k = 2
    sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
return
