MapVectorErase:
    @: vector
    int: begin
    int: end
    required: vector begin end
    return: int
    erase:
        throws: copy(MapThrows)
        if: begin < 0 || end < begin || end > length(vector)
            throw: MapFailure("erase range")
        int: removed end - begin
        int: count length(vector)
        int: i end
        while: i < count
            vector[i - removed] := vector[i]
            i += 1
        sys\resize(vector; count - removed)
        return: removed

MapVectorCopyFrom:
    @: vector
    @: source
    int: offset
    int: at
    int: count
    required: vector source offset at count
    return: int
    copyFrom:
        throws: copy(MapThrows)
        if: offset < 0 || count < 0 || offset > length(source) || count > length(source) - offset || at < 0
            throw: MapFailure("copy range")
        if: count = 0
            return: 0
        @: staged MapVector\range(source; offset; offset + count)
        int: end MapSize\sum(at; count)
        int: oldSize length(vector)
        if: end > oldSize
            sys\resize(vector; end)
        int: i oldSize
        while: i < at
            vector[i] := MapNil
            i += 1
        i := 0
        while: i < count
            vector[at + i] := staged[i]
            i += 1
        return: count

MapVectorInsertArray:
    @: vector
    @: source
    int: offset
    int: at
    int: count
    required: vector source offset at count
    return: int
    insertArray:
        throws: copy(MapThrows)
        if: offset < 0 || count < 0 || offset > length(source) || count > length(source) - offset || at < 0 || at > length(vector)
