fn: ping (int: n) int
    if: n = 0
        return: f259()
    return: pong(n - 1)
end: ping

fn: pong (int: n) int
    return: ping(n)
end: pong

fn: has () int
    @: Model box @Model
    box\v: 30
    return: ping(3)
end: has

fn: wide () int
    @: Wide box @Wide
    box\v: 40
    return: ping(3)
end: wide

int: a has()
int: b wide()
int: ok 7
if: a != 31
    ok: 81
if: b != 41
    ok: 82
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
