MapOrderedLowerBound:
    @: vector
    int: value
    required: vector value
    return: int
    lowerBound:
        throws: copy(MapThrows)
        int: low 0
        int: high length(vector)
        while: low < high
            int: middle low + (high - low) / 2
            if: \vector[middle] < value
                low := middle + 1
            else:
                high := middle
        return: low

MapOrderedUpperBound:
    @: vector
    int: value
    required: vector value
    return: int
    upperBound:
        throws: copy(MapThrows)
        int: low 0
        int: high length(vector)
        while: low < high
            int: middle low + (high - low) / 2
            if: \vector[middle] <= value
                low := middle + 1
            else:
                high := middle
        return: low

MapOrderedIndexOf:
    @: vector
    int: value
    required: vector value
    return: int
    indexOf:
        throws: copy(MapThrows)
        int: at MapOrdered\lowerBound(vector; value)
