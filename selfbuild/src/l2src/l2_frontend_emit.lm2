    # through its native word): the declarations initialize this instance's own fields. Nothing else of the unit runs, and
    # no Message, Thread or module cell learns of the unit: the owner holds it through the export's result.
    if: library_mode_cell[0] != 0 && c.fputs("        l2_entry_unit\\parent: 0\n        l2_construct_status: lmx_call_prim(l2_program_arena, l2_entry_unit, l2_entry_unit, 0, 0U, 0, @ l2_construct_out)\n        if: l2_construct_status != 0\n            \\out: l2_construct_out\n            return: l2_construct_status\n        if: lmx_msg_poll_escape() != 0\n            return: 0\n        \\out: (cast: (@: void) l2_entry_unit)\n", out_cell[0]) < 0
        c.fclose(out_cell[0])
        return: (cast: (int) (1))
