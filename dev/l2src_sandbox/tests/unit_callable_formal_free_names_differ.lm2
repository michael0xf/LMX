# One callable formal may receive callables with different free names; each
# call forms the inputs of the callable it has. run receives g1, which reads
# other, and f0, which reads base. From the root: 10 and 5. From outer,
# whose formal other is 40: g1 gives 41 and f0 gives 5. From under, whose
# formal base is 77: g1 gives 10 and f0 gives 77. Entry 7.
int: base 5
int: other 9

fn: f0 () int
    return: base
end: f0

fn: g1 () int
    return: other + 1
end: g1

fn: run (f0: q) int
    return: q()
end: run

fn: outer (int: other) int
    return: run(g1) * 100 + run(f0)
end: outer

fn: under (int: base) int
    return: run(g1) * 100 + run(f0)
end: under

int: a run(g1)
int: b run(f0)
int: c outer(40)
int: d under(77)
int: ok 7
if: a != 10 || b != 5 || c != 4105 || d != 1077
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
