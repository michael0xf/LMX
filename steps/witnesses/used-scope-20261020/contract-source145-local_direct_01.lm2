fn: work () int
    Model: (int: x 0; int: sentinel 0)
    Candidate: (int: sentinel 17; int: x 5)
    Shelf: ([]: (@: Model) values 2)
    Shelf\values[1]: Candidate
    Shelf\values[1]\x: 19
    @: address int @ Shelf\values[1]\x
    \address: 43
    if: Shelf\values[1]\x != 43 || Candidate\x != 43 || Candidate\sentinel != 17 || \address != 43
        return: 81
    return: 7
end: work
sendMessage: exit(exit_code: work(); stdout: ""; stderr: "")
return
