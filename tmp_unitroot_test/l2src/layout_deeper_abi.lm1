# C ABI: frozen parser layout comparison -> its L2 callable.
predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stddef.h>" "<stdio.h>"

extern: @: Lmx l2_deeper_unit

prototype:
    fn: l2_deeper_boot () int
    fn: l2_deeper_m0 (@: Lmx node; size_t: indent_column; size_t: dot_level; size_t: base_indent_column; size_t: base_dot_level) int
end: prototype

int: l2_layout_deeper_calls 0

fn: lm_p0_layout_prefix_is_deeper (size_t: indent_column; size_t: dot_level; size_t: base_indent_column; size_t: base_dot_level) int
    if: l2_deeper_unit = 0
        if: c.l2_deeper_boot() != 0 || l2_deeper_unit = 0
            fputs("l2_deeper_boot failed\n", l1_stderr())
    ---
    l2_layout_deeper_calls: l2_layout_deeper_calls + 1
    return: c.l2_deeper_m0(c.lmx_arena_ref_struct(l2_deeper_unit, 0U), indent_column, dot_level, base_indent_column, base_dot_level)
