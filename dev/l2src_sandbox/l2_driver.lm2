                    c.lmx_int_store_known(value, 73)
                    return: 1
            ---
        ---
    ---
    while: i < frame_fields\size
        value: c.lmx_arena_ref_value(frame, i)
        if: value != 0 && c.lmx_domain_kind(arena, value) = c.LMX_KIND_STRUCT
            child: (cast: (@: c.Lmx) value)
            child_fields: 0
            if: child != 0
                child_fields: @ child\array
            ---
            if: child\parent = frame
                found: found + dispatch_rewrite_return(arena, child)
        ---
        i: i + 1U
    ---
    return: found
end: dispatch_rewrite_return

fn: dispatch_install (@: arena c.LmxArena; @: graph c.Lmx; int: original_slot; int: walked_slot; int: caller_slot) int
    @: graph_fields c.VoidArray 0
    graph_fields: 0
    if: graph != 0
        graph_fields: @ graph\array
    ---
    @@: dispatch_selected_cell c.Lmx (cast: (@@: c.Lmx) (@ c.dispatch_selected))
    @@: dispatch_arena_cell c.LmxArena (cast: (@@: c.LmxArena) (@ c.dispatch_arena))
    @: dispatch_throws_cell int (cast: (@: int) (@ c.dispatch_throws))
    @@: dispatch_payload_cell c.Lmx (cast: (@@: c.Lmx) (@ c.dispatch_payload))
    @: original c.Lmx c.lmx_arena_ref_struct(graph, (cast: (size_t) original_slot))
    @: walked c.Lmx c.lmx_arena_ref_struct(graph, (cast: (size_t) walked_slot))
    @: caller c.Lmx c.lmx_arena_ref_struct(graph, (cast: (size_t) caller_slot))
    @: holder c.Lmx 0
    @: copy c.Lmx 0
    @: value void 0
    size_t: i 0U
    int: paths 0
    check((cast: (int) (graph\native != 0 && caller != 0 && caller\native != 0)), "dispatch probe keeps root and caller native")
    check((cast: (int) (original != 0 && original\native != 0 && walked != 0 && walked\native != 0)), "dispatch probe starts from two native callees")
    if: original = 0 || walked = 0 || caller = 0
        return: 1
    c.LmxEntry: saved_native original\native
    # Exactly one immediate physical Holder field names this method.
    while: i < graph_fields\size
        value: c.lmx_arena_ref_value(graph, i)
        if: value != 0 && c.lmx_domain_kind(arena, value) = c.LMX_KIND_STRUCT
            holder: (cast: (@: c.Lmx) value)
            if: c.lmx_arena_ref_value(holder, 0U) = (cast: (@: void) original)
                paths: paths + 1
                if: c.lmx_graph_copy_owned(original, arena, arena, @ copy) != c.LMX_GRAPH_COPY_OK || copy = 0
                    return: 1
                copy\parent: holder
                copy\native: (cast: (c.LmxEntry) c.dispatch_probe)
                if: c.lmx_arena_ref_store(holder, 0U, (cast: (@: void) copy)) != 0
                    return: 1
                dispatch_selected_cell[0]: copy
            ---
        ---
        i: i + 1U
    ---
    check((cast: (int) (paths = 1 && dispatch_selected_cell[0] != original)), "one physical path selects a distinct copied occurrence")
    check((cast: (int) (original\native = saved_native)), "the original declaration native word remains unchanged")
    check((cast: (int) (dispatch_rewrite_return(arena, walked) = 1)), "exactly one retained return literal is changed")
    walked\native: 0
    dispatch_arena_cell[0]: arena
    if: dispatch_throws_cell[0] != 0
        dispatch_payload_cell[0]: c.lmx_walk_plain(arena, graph, 1U)
        value: c.lmx_int_new_owned(arena)
        if: dispatch_payload_cell[0] = 0 || value = 0
            return: 1
        if: c.lmx_int_store_known(value, 91) != 0 || c.lmx_arena_ref_store(dispatch_payload_cell[0], 0U, value) != 0
            return: 1
        ---
    ---
    return: 0
end: dispatch_install

