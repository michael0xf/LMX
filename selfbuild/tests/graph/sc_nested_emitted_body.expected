@: result Box
int: r 7
D:
    Box:
        int: first 7
        int: second 11
    end: Box
    return: (int first) (int second)
    C:
        return: (node \ Box)
    end: C
end: D
fn: Bridge () int
    :=: (node \ result) D\C()
    :=: ((node \ result) \ second) 11
    return: 7
end: Bridge
Main: (:= (node \ r) (Bridge))
