            int: digit MapBytes\getSigned(bytes; i)
            value := (value * 31 + digit) % 4294967296
            if: value < 0
                value += 4294967296
            i += 1
        if: value >= 2147483648
            value -= 4294967296
        return: value

MapBytesAppendScalar:
    @: bytes
    int: code
    required: bytes code
    return: @
    appendScalar:
        throws: copy(MapThrows)
        if: code < 0 || code > 1114111 || (code >= 55296 && code <= 57343)
            throw: MapFailure("invalid Unicode scalar")
        if: code < 128
            MapBytes\append(bytes; code)
        else:
            if: code < 2048
                MapBytes\append(bytes; 192 + code / 64)
                MapBytes\append(bytes; 128 + code % 64)
            else:
                if: code < 65536
                    MapBytes\append(bytes; 224 + code / 4096)
                    MapBytes\append(bytes; 128 + (code / 64) % 64)
                    MapBytes\append(bytes; 128 + code % 64)
                else:
                    MapBytes\append(bytes; 240 + code / 262144)
                    MapBytes\append(bytes; 128 + (code / 4096) % 64)
                    MapBytes\append(bytes; 128 + (code / 64) % 64)
                    MapBytes\append(bytes; 128 + code % 64)
        return: bytes

