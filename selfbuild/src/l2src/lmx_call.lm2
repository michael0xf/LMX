# Common call and publication, direct machine entries (L2 section20).
# All arenas, code/data, storage and status outputs are explicit. No unit state or installed backend hook.
predef: "l2src/lmx_call.h.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l2src/lmx_implements.h.lm1"
predef: "l2src/lmx_walk.h.lm1"
predef: "l2src/lmx_value_owned.h.lm1"
predef: "l2src/lmx_primitive.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<string.h>"

# Decode the walk boundary's throw status. Errors remain X1; no remembered/current-call status is written.
fn: lmx_call_note_walk_fail (int: st) int
    if: st >= c.LMX_CALL_WALK_ERR_LO && st <= c.LMX_CALL_WALK_ERR_HI
        if: st = 1
            c.fprintf(c.l1_stderr(), "lmx: walk error: INVALID\n")
        ---
        if: st = 2
            c.fprintf(c.l1_stderr(), "lmx: walk error: NO_GRAPH\n")
        ---
        if: st = 3
            c.fprintf(c.l1_stderr(), "lmx: walk error: NOMEM\n")
        ---
        if: st = 4
            c.fprintf(c.l1_stderr(), "lmx: walk error: CHECKPOINT\n")
        ---
        if: st = 5
            c.fprintf(c.l1_stderr(), "lmx: walk error: UNSUPPORTED\n")
        ---
        if: st = 6
            c.fprintf(c.l1_stderr(), "lmx: walk error: PRIMITIVE\n")
        ---
        if: st = 7
            c.fprintf(c.l1_stderr(), "lmx: walk error: NOT_CALLABLE\n")
        ---
        c.abort()
    ---
    if: st >= c.LMX_CALL_WALK_THROWN
        return: st - c.LMX_CALL_WALK_THROWN
    ---
    c.fprintf(c.l1_stderr(), "lmx: walk error: unknown status %d\n", st)
    c.abort()
    return: 0
end: lmx_call_note_walk_fail

# An executed native access consumes one already installed numeric place.
# Query adapters may return an unavailable sentinel; an actual typed access
# must preserve the operation error before any pointer or null-path use.
fn: lmx_call_index (@: arena c.LmxArena; @: data c.Lmx; @: code c.Lmx; size_t: edge) size_t
    size_t: slot (cast: (size_t) -1)
    int: answer
    int: status c.lmx_implements_code_slot(arena, data, code, edge, @ slot, @ answer)
    if: status != c.LMX_WALK_OK
        lmx_call_note_walk_fail(status)
        c.abort()
        return: (cast: (size_t) -1)
    if: answer = c.LMX_IMPLEMENTS_UNKNOWN
        lmx_call_note_walk_fail(c.LMX_WALK_UNSUPPORTED)
        c.abort()
        return: (cast: (size_t) -1)
    if: answer != c.LMX_IMPLEMENTS_YES
        lmx_call_note_walk_fail(c.LMX_WALK_INVALID)
        c.abort()
        return: (cast: (size_t) -1)
    return: slot
end: lmx_call_index

# This is an actual graph-payload read, not a receiving proof. A non-null
# foreign/unregistered payload has no graph-domain interpretation yet.
# Explicit raw C ABI input/result storage does not use this graph path.
fn: lmx_call_cell (@: arena c.LmxArena; @: cell void) @: void
    if: cell != 0 && c.lmx_domain_kind(arena, cell) = c.LMX_KIND_NONE
        lmx_call_note_walk_fail(c.LMX_WALK_UNSUPPORTED)
        c.abort()
        return: 0
    return: cell
end: lmx_call_cell

sub: lmx_publish_guard (@: arena c.LmxArena; @: cell void; int: guard; @@: roots c.Lmx; size_t: count)
    if: guard != 0 && (c.lmx_range_has_root_profile(arena, cell, roots, count) != 0 || c.lmx_range_sealed_profile(arena, cell) != 0)
        lmx_call_note_walk_fail(c.LMX_CALL_WALK_ERR_LO)
    ---
    return
end: lmx_publish_guard

sub: lmx_publish_failed (int: k)
    c.fprintf(c.l1_stderr(), "lmx: invariant: own field %d store failed\n", k)
    c.abort()
    return
end: lmx_publish_failed

sub: lmx_publish_int (@: dirty int; @: arena c.LmxArena; @: cell void; int: value; int: k; int: guard; @@: roots c.Lmx; size_t: count)
    if: dirty = 0 || \dirty = 0
        return
    lmx_publish_guard(arena, cell, guard, roots, count)
    if: c.lmx_int_store_known(cell, value) != 0
        lmx_publish_failed(k)
    else:
        c.lmx_code_changed_cell(arena, cell)
    ---
    \dirty: 0
    return
end: lmx_publish_int

sub: lmx_publish_char (@: dirty int; @: arena c.LmxArena; @: cell void; int: value; int: k; int: guard; @@: roots c.Lmx; size_t: count)
    if: dirty = 0 || \dirty = 0
        return
    lmx_publish_guard(arena, cell, guard, roots, count)
    if: c.lmx_char_store_known(cell, value) != 0
        lmx_publish_failed(k)
    else:
        c.lmx_code_changed_cell(arena, cell)
    ---
    \dirty: 0
    return
end: lmx_publish_char

sub: lmx_publish_size (@: dirty int; @: arena c.LmxArena; @: cell void; size_t: value; int: k; int: guard; @@: roots c.Lmx; size_t: count)
    if: dirty = 0 || \dirty = 0
        return
    lmx_publish_guard(arena, cell, guard, roots, count)
    if: c.lmx_size_store_known(cell, value) != 0
        lmx_publish_failed(k)
    else:
        c.lmx_code_changed_cell(arena, cell)
    ---
    \dirty: 0
    return
end: lmx_publish_size

sub: lmx_publish_unsigned (@: dirty int; @: arena c.LmxArena; @: cell void; unsigned: value; int: k; int: guard; @@: roots c.Lmx; size_t: count)
    if: dirty = 0 || \dirty = 0
        return
    lmx_publish_guard(arena, cell, guard, roots, count)
    if: c.lmx_unsigned_store_known(cell, value) != 0
        lmx_publish_failed(k)
    else:
        c.lmx_code_changed_cell(arena, cell)
    ---
    \dirty: 0
    return
end: lmx_publish_unsigned

sub: lmx_publish_ulong (@: dirty int; @: arena c.LmxArena; @: cell void; ulong: value; int: k; int: guard; @@: roots c.Lmx; size_t: count)
    if: dirty = 0 || \dirty = 0
        return
    lmx_publish_guard(arena, cell, guard, roots, count)
    if: c.lmx_ulong_store_known(cell, value) != 0
        lmx_publish_failed(k)
    else:
        c.lmx_code_changed_cell(arena, cell)
    ---
    \dirty: 0
    return
end: lmx_publish_ulong

sub: lmx_publish_pointer (@: dirty int; @: arena c.LmxArena; @: cell void; @: raw void; @: context c.LmxWalkValue; int: k; int: guard; @@: roots c.Lmx; size_t: count)
    if: dirty = 0 || \dirty = 0
        return
    lmx_publish_guard(arena, cell, guard, roots, count)
    if: c.lmx_pointer_store_context_in(arena, cell, raw, context) != 0
        lmx_publish_failed(k)
    \dirty: 0
    return
end: lmx_publish_pointer

fn: lmx_call_ready (@: arena c.LmxArena; @: callable c.Lmx) int
    if: arena = 0 || callable = 0
        return: c.LMX_CALL_NOT_CALLABLE
    if: c.lmx_graph_node_in(arena, (cast: (@: void) callable)) = 0
        return: c.LMX_CALL_NOT_CALLABLE
    ---
    return: c.LMX_CALL_OK
end: lmx_call_ready

fn: lmx_call_node (@: callable c.Lmx) @: c.Lmx
    if: callable = 0
        return: 0
    return: (cast: (@: c.Lmx) callable\parent)
end: lmx_call_node

# ---- The activation chain (slice 254, design 4.5 B1) ----------------------------------------------------------------
#
# One record per activation of either executor, kept in the C frame of whoever enters the activation (the walker's
# lmx_walk_activate_parts_values, the native trampolines below and the native branch of lmx_walk_dispatch_values),
# chained through `parent` from the arena's `activation`: one Message, one serial lane, one chain across both
# executors.  A record names the activation's inputs through the callable's args header (`code`, `values`, `refs`,
# `width`) and its own working cells through `bindings` (native frames register them; a walker frame's are its work
# rows).  The resolver of free inputs (lmx_activation_resolve, lmx_walk_values.lm2) climbs this chain once, at the
# callee's entry.  Nothing here is graph storage: no root, no companion graph, no registry; a record is gone with its
# activation.
fn: lmx_activation_push (@: arena c.LmxArena; @: record c.LmxActivation; int: kind; @: code c.Lmx; @@: refs void; @: values void; size_t: width; @: frame void) int
    if: arena = 0 || record = 0
        return: 1
    c.memset((cast: (@: void) record), 0, c.sizeof(c.LmxActivation))
    record\parent: (cast: (@: c.LmxActivation) arena\activation)
    record\kind: kind
    record\code: code
    record\refs: refs
    record\values: values
    record\width: width
    record\frame: frame
    arena\activation: (cast: (@: void) record)
    return: 0
end: lmx_activation_push

# The record leaves with its activation; its bindings are freed.  The chain goes back to the record's parent whatever
# the current record is: the frame below is gone.
sub: lmx_activation_pop (@: arena c.LmxArena; @: record c.LmxActivation)
    if: arena = 0 || record = 0
        return
    if: record\bindings != 0
        c.free((cast: (@: void) record\bindings))
    ---
    record\bindings: 0
    record\nbind: 0U
    record\cap: 0U
    arena\activation: (cast: (@: void) record\parent)
    return
end: lmx_activation_pop

# A native frame registers one of its own working cells in the current record: `name` (the generated program's
# literal, not copied) with its `storage` and `type`, or a complete LmxWalkValue record (`value`) where the cell holds
# one.  1 only when the C heap refuses.
fn: lmx_activation_bind (@: arena c.LmxArena; @: name void; size_t: len; @: storage void; int: type; @: value void) int
    @: record c.LmxActivation 0
    @: grown c.LmxActivationBinding 0
    @: slot c.LmxActivationBinding 0
    size_t: cap 0U
    if: arena = 0 || name = 0 || len = 0U
        return: 1
    record: (cast: (@: c.LmxActivation) arena\activation)
    if: record = 0
        return: 1
    if: record\nbind = record\cap
        cap: 8U
        if: record\cap != 0U
            cap: record\cap * 2U
        grown: (cast: (@: c.LmxActivationBinding) c.realloc((cast: (@: void) record\bindings), cap * c.sizeof(c.LmxActivationBinding)))
        if: grown = 0
            return: 1
        record\bindings: grown
        record\cap: cap
    ---
    slot: record\bindings + record\nbind
    slot\name: name
    slot\length: len
    slot\storage: storage
    slot\type: type
    slot\value: value
    record\nbind: record\nbind + 1U
    return: 0
end: lmx_activation_bind

# Host/root nullary transport: status is the result, activation int travels through value.
# This is not the language unary-call data selection; the host executes its complete program graph over itself.
fn: lmx_call0_mode (@: arena c.LmxArena; @: callable c.Lmx; @: route int; @: value int) int
    @: out void 0
    int: st
    if: route != 0
        \route: c.LMX_CALL_ROUTE_REFUSED
    if: value = 0 || lmx_call_ready(arena, callable) != c.LMX_CALL_OK
        return: c.LMX_CALL_NOT_CALLABLE
    \value: 0
    c.LmxEntry: addr (cast: (c.LmxEntry) callable\native)
    if: addr = 0
        if: route != 0
            \route: c.LMX_CALL_ROUTE_WALK
        ---
        return: c.lmx_walk_call0_dispatch(arena, callable, value)
    ---
    if: route != 0
        \route: c.LMX_CALL_ROUTE_NATIVE
    c.LmxPrimitiveEntry: entry (cast: (c.LmxPrimitiveEntry) addr)
    c.LmxActivation: act
    lmx_activation_push(arena, @ act, 2, callable, 0, 0, 0U, 0)
    st: entry((cast: (@: void) callable), 0, 0U, (cast: (@: void) value), @ out, arena, callable, 0, 0)
    lmx_activation_pop(arena, @ act)
    if: c.lmx_msg_poll_escape() != 0
        \value: 0
        return: 0
    return: st
end: lmx_call0_mode

fn: lmx_call0 (@: arena c.LmxArena; @: callable c.Lmx; @: value int) int
    return: lmx_call0_mode(arena, callable, 0, value)
end: lmx_call0

# The ordinary selected code/data ABI: actual declared-width storage and value context, no runtime backend registry.
fn: lmx_call_prim_values (@: arena c.LmxArena; @: code c.Lmx; @: data c.Lmx; @@: refs void; size_t: nargs; @: dest void; @@: out void; @: lmx_input_values c.LmxWalkValue; @: lmx_result_context c.LmxWalkValue) int
    int: status
    c.LmxWalkValue: result_context
    if: out = 0 || data = 0 || lmx_call_ready(arena, code) != c.LMX_CALL_OK
        c.fprintf(c.l1_stderr(), "lmx: invariant: a dynamic call of a value that is not a Structure\n")
        c.abort()
    ---
    \out: 0
    c.memset((cast: (@: void) (@ result_context)), 0, c.sizeof(c.LmxWalkValue))
    c.LmxEntry: addr (cast: (c.LmxEntry) code\native)
    c.LmxActivation: act
    if: addr != 0
        c.LmxPrimitiveEntry: entry (cast: (c.LmxPrimitiveEntry) addr)
        # The native activation's record (slice 254): its inputs are the arrays the entry receives.
        lmx_activation_push(arena, @ act, 2, code, refs, (cast: (@: void) lmx_input_values), nargs, 0)
        status: entry((cast: (@: void) data), refs, nargs, dest, out, arena, code, lmx_input_values, @ result_context)
        lmx_activation_pop(arena, @ act)
    else:
        status: c.lmx_walk_call_prim_dispatch(arena, code, data, refs, nargs, dest, out, lmx_input_values, @ result_context)
    ---
    if: c.lmx_msg_poll_escape() != 0
        \out: 0
        status: 0
        c.memset((cast: (@: void) (@ result_context)), 0, c.sizeof(c.LmxWalkValue))
    if: lmx_result_context != 0
        # Do not clear an aliased caller input before the selected entry consumes it.
        c.memset((cast: (@: void) lmx_result_context), 0, c.sizeof(c.LmxWalkValue))
        if: status = 0
            c.memcpy((cast: (@: void) lmx_result_context), (cast: (const: @: void) (@ result_context)), c.sizeof(c.LmxWalkValue))
        ---
    ---
    return: status
end: lmx_call_prim_values

fn: lmx_call_prim (@: arena c.LmxArena; @: code c.Lmx; @: data c.Lmx; @@: refs void; size_t: nargs; @: dest void; @@: out void) int
    return: lmx_call_prim_values(arena, code, data, refs, nargs, dest, out, 0, 0)
end: lmx_call_prim
