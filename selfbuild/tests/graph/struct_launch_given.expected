---
    Observed:
        int: seen 21
        int: twice 2
    end: Observed
---
@: shared (data [] 0)
sub: main () (
    Code:
        Step: Inner
        Step: (:= data Inner)
        Twice:
    end: Code
    D:
        Inner:
            int: x 1
        end: Inner
        Step: (:= (data \ x) ((data \ x) + 10))
        Twice:
            int: k 0
            :=: (data \ k) ((data \ k) + 2)
        end: Twice
    end: D
)
    call: D Code
end: main
main:
int: seen ((((main \ data) \ D) \ Inner) \ x)
int: twice ((((main \ data) \ D) \ Twice) \ k)
sub: observe ()
    :=: ((shared \ Observed) \ seen) seen
    :=: ((shared \ Observed) \ twice) twice
end: observe
observe:
