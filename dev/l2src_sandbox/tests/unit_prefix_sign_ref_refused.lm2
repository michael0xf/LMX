# A prefix sign asks a number of its operand. A Structure is a reference: under
# the sign it is refused where it stands, by the same kind rule as in any other
# operation. `x: -b` would go out as C negating the Box's pointer.
Box:
    int: v 0
end: Box
fn: peek () int
    Box: b
    int: x 0
    x: -b
    return: x
end: peek
int: r 0
r: peek()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
