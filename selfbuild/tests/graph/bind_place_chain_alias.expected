---
    Observed:
        int: seen 90909
    end: Observed
---
fn: c () int
    :=: x 9
    return: x
end: c
fn: b () int
    int: before (x + 0)
    int: r (c)
    return: ((x * 100) + r)
end: b
fn: a () int
    int: x 5
    int: rb (b)
    return: ((x * 10000) + rb)
end: a
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) (a)
end: main
main:
