# Entry Main: the record of `return: @` kept in code refuses only where it is reached (the grammar #close; the book
# #return-in-data). The body of the condition 0 holds that return; the call does not reach it and returns 5 from its
# last line. r 5, D\seen 1.
int: r 0
D:
    int: seen 0
    return: int
    C:
        node\seen := 1
        if: 0
            return: @
        end: if
        return: 5
    end: C
end: D
---
Main:
    node\r := D\C()
