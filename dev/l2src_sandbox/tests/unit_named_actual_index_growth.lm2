    r: r + f(b: x; a: 12)
    r: r + f(b: x; a: 13)
    r: r + f(b: x; a: 14)
    r: r + f(b: x; a: 15)
    r: r + f(b: x; a: 16)
    r: r + f(b: x; a: 17)
    r: r + f(b: x; a: 18)
    r: r + f(b: x; a: 19)
    r: r + f(b: x; a: 20)
    r: r + f(b: x; a: 21)
    r: r + f(b: x; a: 22)
    r: r + f(b: x; a: 23)
    r: r + f(b: x; a: 24)
    r: r + f(b: x; a: 25)
    r: r + f(b: x; a: 26)
    r: r + f(b: x; a: 27)
    r: r + f(b: x; a: 28)
    r: r + f(b: x; a: 29)
    r: r + f(b: x; a: 30)
    return: r
end: m1

