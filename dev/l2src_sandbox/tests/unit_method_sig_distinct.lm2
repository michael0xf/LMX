# Two methods with one result type and different inputs retain distinct callable occurrences.
# The graph CALLs reference their own native-bound descriptors and physical return cells, with
# arities 1 and 0; no packed signature mark is used. Native a(5) + b() is 3: Entry 3.
fn: a (int: x) size_t
return: 1U

fn: b () size_t
return: 2U

size_t: s
s: a(5) + b()
int: r 0
if: s = 3U
    r: 3
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
