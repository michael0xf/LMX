# Slice 301 probe (a bound call that does not run): the int -> char receiver counts its calls.  `Places\f(x: n; y: 7)` in a
# branch not taken neither receives nor raises anything: skipped(0) is 5 and the receiver was not called.  The same call
# reached (skipped(1)) is 67 with one receiver call.  Exit 7; 81-84 name the failing check.
Calls:
    int: n 0
end: Calls
fn: lm_stg_convert_int_char (int: n) char
    Calls\n: Calls\n + 1
    return: (cast: (char) (n + 1))
end: lm_stg_convert_int_char
fn: g (int: y; char: x) int
    return: (cast: (int) x) * 10 + y
end: g
Places:
    fn: f (int: x; char: y) int
        return: x * 10 + (cast: (int) y)
    end: f
end: Places
int: Hw 0
fn: write_place () int
    ---
        @: Places\f Hw
        return: 1
        catch: implements ()
            return: 24
    ---
end: write_place
fn: skipped (int: k) int
    int: n 5
    ---
        if: k = 1
            return: Places\f(x: n; y: 7)
        ---
        return: 5
        catch: convert ()
            return: 25
    ---
end: skipped
fn: run () int
    @: Hw g g
    if: write_place() != 1
        return: 80
    ---
    if: skipped(0) != 5
        return: 81
    ---
    if: Calls\n != 0
        return: 82
    ---
    if: skipped(1) != 67
        return: 83
    ---
    if: Calls\n != 1
        return: 84
    ---
    return: 7
end: run
int: code run()
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
