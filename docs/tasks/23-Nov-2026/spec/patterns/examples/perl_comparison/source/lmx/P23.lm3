Squares:
    int: limit 0
    Next:
        return: int
        next:
            throws: Stop
            @: owner parent(node)
            int: i 0
            while: i < owner\limit
                yield: i * i
                i += 1
            throw: Stop()

Example:
    int: limit
    return: @
    run:
        @: source (copy(Squares))
        source := parent(source\Next)
        source\limit := limit
        @: next source\Next\next
        int[]: result []
        while: 1
            int: value next()
            catch: Stop ()
                break
            int: at length(result)
            sys\resize(result; at + 1)
            result[at] := value
        return: result
