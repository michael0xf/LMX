InlineChain:
    return: @
    run:
        throws: copy(`+`\throws)
        int: a 1
        int: b 2
        int: d 4
        return: a + b + [10 20] + d

WholeChildChain:
    return: @
    run:
        throws: copy(`+`\throws)
        @: arr0 [[1 2]]
        @: arr1 [[10 20]]
        @: arr2 [100 200]
        return: arr0 .+ arr1 .+ [arr2]
