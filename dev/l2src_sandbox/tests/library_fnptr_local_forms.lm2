predef: "l2src/tests/fnptr_local_forms.h.lm1"

# BATCHC-76: fnptr value init only via typed declaration initializer.
# Later "f: value" on a ty40 binding is a call, not assignment.
fn: fnptr_expr_call (const: @(c.L2TestAllocVTable av); size_t: n) @: void
    L2TestAllocFn: f av\alloc
    if: f = 0
        return: 0
return: f(n)
