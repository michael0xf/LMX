# A bare path to a callable reads its reference; only `Holder\tick()` calls it.
# Selecting tick runs nothing of Holder: its own statement `bump()` would count a run.
# tick runs once, Holder never: exit 7; 81 if Holder ran, 82 for a wrong tick count.
int: hits 0
int: seen 0
fn: tick () int
    node\hits: node\hits + 1
    return: node\hits
end: tick
fn: bump () int
    node\seen: node\seen + 1
    return: 0
end: bump
fn: count () int
    return: node\hits
end: count
fn: saw () int
    return: node\seen
end: saw
Holder:
    fn: tick
    bump()
end: Holder
fn: run () int
    Holder\tick
    Holder\tick()
    if: saw() != 0
        return: 81
    if: count() != 1
        return: 82
    return: 7
end: run
sendMessage: exit(exit_code: run(); stdout: ""; stderr: "")
return
