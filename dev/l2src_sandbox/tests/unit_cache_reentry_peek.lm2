# Reentry uses one declared occurrence and independent working values.
# Inner x9 is published; outer bare x stays2. External peek reads graph9,
# then the final outer write publishes3: observable result293.
fn: M (int: n) int
    int: x 1
    if: n = 0
        x: 9
        return: 0
    x: 2
    M(0)
    int: seen 0
    seen: x
    int: peeked 0
    peeked: peek()
    x: x + 1
    return: seen * 10 + peeked
end: M

fn: peek () int
    return: M\x
end: peek

fn: check () int
    return: M\x
end: check

int: v 0
v: M(1)
int: w 0
w: check()
sendMessage: exit(exit_code: v * 10 + w; stdout: ""; stderr: "")
return
