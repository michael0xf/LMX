# Probe 275 h2.
First:
    int: x 3
end: First
Second:
    int: w 9
    int: x 5
end: Second
S1:
    x: 6
end: S1
fn: take (@: p First) int
    return: p\x
end: take
fn: m () int
    ---
        @: q First First
        if: q\x != 5
            return: 82
        return: 7
        catch: implements ()
            return: 91
        catch: convert ()
            return: 92
        catch: interpreter ()
            return: 93
    ---
end: m
int: code 7
First: Second
code: m()
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
