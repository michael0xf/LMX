# A size_t call result above 2^32 at the walked root (FABLE-OPUS-ROOT-STRUCTS-20260925-178 commit
# 1; -174 c4).  wide's record carries the result mark, so the walk's CALL hands its trampoline a
# size_t cell, not the evaluator's int temp.  wide() is 2^32 + 7, so r is 1: Entry 1.
fn: wide () size_t
return: 4294967303U

size_t: got
got: wide()
int: r 0
if: got = 4294967303U
    r: 1
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
