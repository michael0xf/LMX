predef: "l2src/lmx_dirty.h.lm1"
predef: "l1src/libc_abi.lm1"
predef: "l2src/lmx_range.lm1"
include: "<string.h>"

# lmx_dirty.lm1 - binding, marking and the checkpoint.  The whole unit is four small acts and one
# store, because the mechanism IS small: what makes it correct is that the store happens ONLY for
# the entries the body wrote, at the stride the arena answers for the cell.

fn: lmx_dirty_bind (@: LmxArena arena; @: LmxDirty entry; @: void cell; @: void value) int
    size_t: stride
    if: arena = 0 || entry = 0 || cell = 0 || value = 0
        return: c.LMX_DIRTY_INVALID
    stride: lmx_range_stride(arena, cell)
    if: stride = 0U
        return: c.LMX_DIRTY_INVALID
    ---
    entry\cell: cell
    entry\value: value
    entry\stride: stride
    entry\dirty: 0
    entry\next: 0
return: c.LMX_DIRTY_OK

# One entry follows another.  A chain is the body's own list of its used own fields, so the two
# ways a list can be malformed are refused here rather than walked into later: an entry cannot
# follow itself, and an entry that already has a successor is already in a chain.
fn: lmx_dirty_link (@: LmxDirty head; @: LmxDirty next) int
    if: head = 0 || next = 0 || head = next
        return: c.LMX_DIRTY_INVALID
    if: head\next != 0
        return: c.LMX_DIRTY_INVALID
    ---
    head\next: next
return: c.LMX_DIRTY_OK

fn: lmx_dirty_mark (@: LmxDirty entry) int
    if: entry = 0
        return: c.LMX_DIRTY_INVALID
    entry\dirty: 1
return: c.LMX_DIRTY_OK

fn: lmx_dirty_pending (@: LmxDirty head) int
    @: LmxDirty entry
    entry: head
    while: entry != 0
        if: entry\dirty != 0
            return: 1
        ---
        entry: entry\next
    ---
return: 0

fn: lmx_dirty_checkpoint (@: LmxDirty head) int
    @: LmxDirty entry
    int: status
    if: head = 0
        return: c.LMX_DIRTY_OK
    status: c.LMX_DIRTY_OK
    entry: head
    while: entry != 0
        if: entry\dirty != 0
            if: entry\cell = 0 || entry\value = 0 || entry\stride = 0U
                # An entry that lost its binding cannot publish: the chain is reported and NOT
                # cleared for it, so the next checkpoint still knows there is something to carry.
                status: c.LMX_DIRTY_INVALID
            else:
                memcpy(entry\cell, entry\value, entry\stride)
                entry\dirty: 0
            ---
        ---
        entry: entry\next
    ---
return: status
