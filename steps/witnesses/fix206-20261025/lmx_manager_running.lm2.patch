--- /dev/null
+++ b/src/l2src/lmx_manager_running.lm2
@@ -0,0 +1,147 @@
+predef: "l2src/lmx_win32_api.h.lm1"
+predef: "l2src/lmx_manager.h.lm1"
+predef: "l2src/lmx_manager_running.h.lm1"
+predef: "l2src/lmx_implements.h.lm1"
+predef: "l2src/lmx_clock.h.lm1"
+predef: "l2src/lmx_turn.h.lm1"
+
+# Same manager API and sole owner children Array as the stepped binding.
+# Each lane receives its own schedule record; no manager/module arena or graph.
+fn: lmx_manager_running_body (@: arg void) ulong
+    @: slot c.LmxSchedule (cast: (@: c.LmxSchedule) arg)
+    @: t c.LmxThread
+    ulong: lane_now 0U
+    if: slot = 0 || slot\owner = 0
+        return: 0U
+    t: (cast: (@: c.LmxThread) slot\owner)
+    while: c.lmx_thread_running(t) != 0 && c.lmx_schedule_state(slot) = c.LMX_SCHEDULE_WAITING
+        lane_now: c.lmx_clock_ticks()
+        c.lmx_thread_turn(t, 0, lane_now)
+        c.lmx_schedule_tick(slot, lane_now)
+        c.Sleep(1U)
+    ---
+    c.lmx_thread_finish(t)
+    return: 0U
+
+fn: lmx_manager_running_init (@: m c.LmxManager) int
+    @: api c.LmxManagerApi
+    if: m = 0
+        return: c.LMX_MANAGER_INVALID
+    m\owner: 0
+    m\cursor: 0U
+    api: @ m\api
+    api\init: (cast: (c.LmxManagerInit) c.lmx_manager_running_init)
+    api\add: (cast: (c.LmxManagerAdd) c.lmx_manager_running_add)
+    api\remove: (cast: (c.LmxManagerRemove) c.lmx_manager_running_remove)
+    api\take: (cast: (c.LmxManagerTake) c.lmx_manager_running_take)
+    api\count: (cast: (c.LmxManagerCount) c.lmx_manager_running_count)
+    api\step: (cast: (c.LmxManagerStep) c.lmx_manager_running_step)
+    api\round: (cast: (c.LmxManagerRound) c.lmx_manager_running_round)
+    return: c.LMX_MANAGER_OK
+
+fn: lmx_manager_running_add (@: m c.LmxManager; @: slot c.LmxSchedule) int
+    @: child c.LmxThread
+    @: parent c.LmxThread
+    if: m = 0 || slot = 0 || slot\owner = 0
+        return: c.LMX_MANAGER_INVALID
+    if: c.lmx_domain_type(slot\arena, slot\owner) != c.LMX_DOMAIN_THREAD
+        return: c.LMX_MANAGER_INVALID
+    child: (cast: (@: c.LmxThread) slot\owner)
+    parent: c.lmx_thread_parent(child)
+    if: parent = 0 || c.lmx_manager_bind(m, parent) != c.LMX_MANAGER_OK
+        return: c.LMX_MANAGER_INVALID
+    if: c.lmx_thread_child_is(parent, child) = 0
+        return: c.LMX_MANAGER_INVALID
+    return: c.LMX_MANAGER_OK
+
+fn: lmx_manager_running_take (@: m c.LmxManager) @: c.LmxSchedule
+    return: (cast: (@: c.LmxSchedule) c.lmx_manager_take(m))
+
+fn: lmx_manager_running_remove (@: m c.LmxManager; @: slot c.LmxSchedule) int
+    return: c.lmx_manager_remove(m, slot)
+
+fn: lmx_manager_running_count (@: m c.LmxManager) size_t
+    return: c.lmx_manager_count(m)
+
+fn: lmx_manager_running_lane_start (@: slot c.LmxSchedule) int
+    @: t c.LmxThread
+    if: slot = 0 || slot\owner = 0
+        return: c.LMX_MANAGER_INVALID
+    if: slot\lane != 0
+        return: c.LMX_MANAGER_OK
+    t: (cast: (@: c.LmxThread) slot\owner)
+    if: c.lmx_thread_running(t) = 0
+        return: c.LMX_MANAGER_OK
+    slot\lane: c.CreateThread(0, 0, (cast: (c.LmxWin32ThreadStart) c.lmx_manager_running_body), (cast: (@: void) slot), 0, 0)
+    if: slot\lane = 0
+        return: c.LMX_MANAGER_INVALID
+    return: c.LMX_MANAGER_OK
+
+fn: lmx_manager_running_lane_reap (@: slot c.LmxSchedule) int
+    if: slot = 0 || slot\lane = 0
+        return: c.LMX_MANAGER_OK
+    if: c.WaitForSingleObject(slot\lane, 0U) != c.WAIT_OBJECT_0
+        return: c.LMX_MANAGER_OK
+    c.CloseHandle(slot\lane)
+    slot\lane: 0
+    return: c.LMX_MANAGER_OK
+
+fn: lmx_manager_running_step (@: m c.LmxManager; ulong: now) int
+    @: slot c.LmxSchedule
+    @: child c.LmxThread
+    @: owner c.LmxThread
+    size_t: index 0U
+    if: m = 0
+        return: c.LMX_MANAGER_INVALID
+    owner: m\owner
+    if: owner = 0
+        return: c.LMX_MANAGER_OK
+    while: index < c.lmx_thread_child_count(owner)
+        child: c.lmx_thread_child_at(owner, index)
+        if: child = 0
+            return: c.LMX_MANAGER_INVALID
+        slot: child\slot
+        if: lmx_manager_running_lane_start(slot) != c.LMX_MANAGER_OK
+            return: c.LMX_MANAGER_INVALID
+        if: lmx_manager_running_lane_reap(slot) != c.LMX_MANAGER_OK
+            return: c.LMX_MANAGER_INVALID
+        index: index + 1U
+    ---
+    return: c.LMX_MANAGER_OK
+
+fn: lmx_manager_running_round (@: m c.LmxManager; unsigned: ticks; ulong: now) int
+    unsigned: i 0U
+    int: code
+    if: m = 0 || ticks = 0U
+        return: c.LMX_MANAGER_INVALID
+    while: i < ticks
+        code: lmx_manager_running_step(m, now)
+        if: code != c.LMX_MANAGER_OK
+            return: code
+        i: i + 1U
+    ---
+    return: c.LMX_MANAGER_OK
+
+# Parent requests stop first. This act only joins and releases the owned handles.
+fn: lmx_manager_running_close (@: m c.LmxManager) int
+    @: slot c.LmxSchedule
+    @: child c.LmxThread
+    @: owner c.LmxThread
+    size_t: index 0U
+    if: m = 0
+        return: c.LMX_MANAGER_INVALID
+    owner: m\owner
+    while: owner != 0 && index < c.lmx_thread_child_count(owner)
+        child: c.lmx_thread_child_at(owner, index)
+        if: child = 0
+            return: c.LMX_MANAGER_INVALID
+        slot: child\slot
+        if: slot\lane != 0
+            c.WaitForSingleObject(slot\lane, c.INFINITE)
+            c.CloseHandle(slot\lane)
+            slot\lane: 0
+        ---
+        index: index + 1U
+    ---
+    m\cursor: 0U
+    return: c.LMX_MANAGER_OK
