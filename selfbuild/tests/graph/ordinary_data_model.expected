---
    Observed:
        int: short_result 6
        int: parts_result 16
    end: Observed
---
@: shared (data [] 0)
sub: main () (
    From:
        int: x 6
    end: From
    FromParts:
        int: x 16
    end: FromParts
    To:
        int: x 0
    end: To
    Change:
        :=: x (x + 1)
        return:
        data: To
    end: Change
    int: short_result 0
    int: parts_result 0
)
    call: From Change
    call: (:= args ()) (:= data FromParts) (:= code Change)
    :=: (data \ short_result) (From \ x)
    :=: (data \ parts_result) (FromParts \ x)
end: main
main:
int: short_result ((main \ data) \ short_result)
int: parts_result ((main \ data) \ parts_result)
sub: observe ()
    :=: ((shared \ Observed) \ short_result) short_result
    :=: ((shared \ Observed) \ parts_result) parts_result
end: observe
observe:
