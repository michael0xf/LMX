+            private: @: job parent(node)
+            job\private\pending -= 1
+            job\Completion\finish("delayUndelivered"; 0)
+        elapsed:
+            private: @: job parent(node)
+            job\private\pending -= 1
+            if: job\private\completed != 0
+                return
+            if: acknowledgement != 1
+                job\Completion\finish("delayFailure"; 0)
+                return
+            job\dispatch()
+
+# request is an addressed nullary Message method returning an FxOutcome.
+# retryOn(outcome)->int decides explicitly which completed results/failures to
+# repeat. A timeout or undelivered request is terminal, so the library never
+# silently repeats an operation with an unknown completion state.
+# delay(ms)->int is the addressed timer worker acknowledgement, not a void call.
+# complete(result)->void is an addressed completion consumer; no ACK is invented.
+# Clock waiting belongs to the existing host delay port (MESSAGE_HTTP_PROFILE).
+# The complete LMX worker below adapts that port into ordinary Message replies.
+FxRetryPost:
+    private:
+        @: request
+        @: retryOn
+        int: attempts
+        @: delay
+        int: firstDelay
+        int: maxDelay
+        int: timeoutMs
+        @: complete
+    required: request retryOn attempts delay firstDelay maxDelay timeoutMs complete
+    return: @
+    retryPost:
+        throws: FxIndex
+        if: attempts < 1 || firstDelay < 0 || maxDelay < firstDelay || timeoutMs <= maxDelay
+            throw: FxIndex()
+        private: @: job (copy(FxRetryPostJob))
+        job\private\request := request
+        job\private\retryOn := retryOn
+        job\private\limit := attempts
+        job\private\delay := delay
+        job\private\pause := firstDelay
+        job\private\maxPause := maxDelay
+        job\private\timeoutMs := timeoutMs
+        job\private\complete := complete
+        job\dispatch()
+        return: job
+
+# These are explicit Message templates. The existing host/lifecycle launches
+# them as Threads with their own arenas; copying a Structure alone does not.
+# The worker and its operation are owned by the SAME receiving Message. Passing
+# a remote raw operation pointer here never makes a legal cross-owner call.
+FxRetryOperationMessage:
+    @: operation
+    @: arguments ()
+    return: @
+    run:
+        throws: copy(FxThrows\kernel)
+        return: FxTry\attempt(operation; arguments)
+
+FxRetryDelayMessage:
+    @: wait
+    int: duration
+    return: int
+    elapsed:
+        wait(duration)
+        return: 1
+
+# RESTORED COMPACT PATTERN HELPERS — original finite contracts (22-Nov).
+# Named groups are explicitly imported by the compact examples. They do not
+# replace the generalized public functions above. Each body is measured in
+# its dedicated implementation comparison, not once per client.
+
+PipeLibrary:
+    copy: sys\OPERANDS_TEMPLATE
+    return: int
+    pipe:
+        int: value \left
+        int: i 0
+        while: i < length(right)
+            @: stage \right[i]
+            value := stage(value)
+            i += 1
+        return: value
+
+FindLibrary:
+    copy: sys\OPERANDS_TEMPLATE
+    return: @
+    findById:
+        throws: OperandArity
+        if: length(right) != 1
+            throw: OperandArity()
+        @: rows \left
+        int: id \right[0]
+        int: i 0
+        while: i < length(rows)
+            @: row rows[i]
+            if: row\id = id
+                return: row
+            i += 1
+        @: missing 0
+        return: missing
+
+SpecificationLibrary:
+    independent: AndData:
+        @: first 0
+        @: second 0
+        inputs:
+            int: value
+            return: int
+            accepts:
+                return: node\first(value) && node\second(value)
+    ---
+    Operators:
+        copy: sys\OPERANDS_TEMPLATE
+        return: @
+        both:
+            throws: OperandArity
+            if: length(right) != 1
+                throw: OperandArity()
+            @: instance (merge(AndData; (@: first \left; @: second \right[0])))
+            return: instance\inputs\accepts
+
+MoneyLibrary:
+    immutable: Money:
+        int: cents 100
+        int: currency 840
+    Equality:
+        copy: sys\OPERANDS_TEMPLATE
+        return: int
+        equals:
+            throws: OperandArity
+            if: length(right) != 1
+                throw: OperandArity()
+            @: a \left
+            @: b \right[0]
+            return: a\cents = b\cents && a\currency = b\currency
+
+RetryLibrary:
+    copy: sys\OPERANDS_TEMPLATE
+    return: int
+    retry:
+        throws: Attempts
+        if: length(right) < 1 || length(right) > 2
+            throw: Attempts()
+        int: limit \right[0]
+        if: limit < 1 || limit > 31
+            throw: Attempts()
+        @: request \left
+        int: attempt 0
+        int: pause 1
+        while: attempt < limit
+            int: status request()
+            if: status != 503
+                return: status
+            attempt += 1
+            if: attempt < limit && length(right) = 2
+                @: wait \right[1]
+                wait(pause)
+                pause *= 2
+        ---
+        return: 503
diff --git a/patterns/LMX_Fn_Receivers/src/corePerlExamples.lmx b/patterns/LMX_Fn_Receivers/src/corePerlExamples.lmx
new file mode 100644
index 0000000000000000000000000000000000000000..80f55dd6b5f4b2200965bf5db6de067869758973
--- /dev/null
+++ b/patterns/LMX_Fn_Receivers/src/corePerlExamples.lmx
@@ -0,0 +1,111 @@
+# Generic ordered operations shared by the Perl and Julia comparison suites.
+# Every Structure is already an @[] sequence. Dense Arrays keep their real
+# profile through the common array helpers; there is no int-only element path.
+# Callbacks execute in one Message and must not mutate the source sequence or
+# the ordering/equality keys during traversal. External callback effects are
+# not rolled back. A failed comparison never publishes a partial result.
+
+# Stable, non-mutating bottom-up merge sort. compare(a,b) returns an int whose
+# sign orders a and b; zero preserves their original order. No subtraction of
+# user values is performed here, so ordering does not introduce value overflow.
+FxSort:
+    private:
+        @: items
+        @: compare
+    required: items compare
+    return: @
+    sort:
+        throws: FxCallFailure FxKernelFailure FxTypeToken ReceiverIndex SequenceElement SequenceSize
+        private: @: info FxSeqInfo\get(items)
+        private: int: count length(items)
+        private: @: current FxSeqSlice\slice(items; 0; count)
+        if: count < 2
+            return: current
+        private: @: scratch FxSeqAllocate\make(info\arrayType; count)
+        private: int: width 1
+        while: width < count
+            private: int: start 0
+            while: start < count
+                private: int: middle count
+                if: width < count - start
+                    middle := start + width
+                private: int: end count
+                if: width < count - middle
+                    end := middle + width
+                private: int: left start
+                private: int: right middle
+                private: int: at start
+                while: at < end
+                    private: int: takeLeft 0
+                    if: right = end
+                        takeLeft := 1
+                    else:
+                        if: left < middle
+                            private: @: a FxSeqRead\read(current; left)
+                            private: @: b FxSeqRead\read(current; right)
+                            private: @: answer FxApply\apply(compare; FxTwo\make(a; b))
+                            private: int: order FxSeqInteger\read(answer)
+                            takeLeft := order <= 0
+                    ---
+                    private: @: selected 0
+                    if: takeLeft != 0
+                        selected := FxSeqRead\read(current; left)
+                        left += 1
+                    else:
+                        selected := FxSeqRead\read(current; right)
+                        right += 1
+                    ---
+                    FxSeqStore\write(scratch; at; selected)
+                    at += 1
+                start := end
+            private: @: previous current
+            current := scratch
+            scratch := previous
+            # Guard before doubling: count bounds the array length and bytes.
+            if: width > count - width
+                width := count
+            else:
+                width += width
+        ---
+        return: current
+
+# First occurrence wins. The explicit equality callback supports arbitrary
+# typed values and references without assuming a hash/string representation.
+# The generic algorithm is quadratic in the number of distinct retained values.
+FxUnique:
+    private:
+        @: items
+        @: same
+    required: items same
+    return: @
+    unique:
+        throws:
+            FxCallFailure
+            FxKernelFailure
+            FxPredicate
+            FxTypeToken
+            ReceiverIndex
+            SequenceElement
+            SequenceSize
+        private: @: info FxSeqInfo\get(items)
+        private: int: count length(items)
+        private: @: result FxSeqAllocate\make(info\arrayType; count)
+        private: int: used 0
+        private: int: i 0
+        while: i < count
+            private: @: item FxSeqRead\read(items; i)
+            private: int: duplicate 0
+            private: int: j 0
+            while: j < used
+                private: @: previous FxSeqRead\read(result; j)
+                private: @: answer FxApply\apply(same; FxTwo\make(previous; item))
+                if: FxSeqPredicate\truth(answer) != 0
+                    duplicate := 1
+                    break
+                j += 1
+            if: duplicate = 0
+                FxSeqStore\write(result; used; item)
+                used += 1
+            i += 1
+        sys\resize(result; used)
+        return: result
diff --git a/patterns/LMX_Fn_Receivers/src/coreStandardFunctional.lmx b/patterns/LMX_Fn_Receivers/src/coreStandardFunctional.lmx
new file mode 100644
index 0000000000000000000000000000000000000000..42948ee39f6d866ffb94b8d2354895462991869c
--- /dev/null
+++ b/patterns/LMX_Fn_Receivers/src/coreStandardFunctional.lmx
@@ -0,0 +1,566 @@
+# FINITE STANDARD COLLECTION OPERATIONS.
+# Ordinary LMX, using the existing Array/typed-record/call contracts only.
+# Returned outer Arrays are fresh; reference-valued elements retain targets.
+# adjoin returns the original Array when its value is already present.
+# Callbacks must not mutate source slots/length while traversal is active.
+# Callback failures use the existing FxCallFailure contract. collect accepts
+# the producer's Stop as exhaustion and retains other failures in that envelope.
+
+FxStdPair:
+    private:
+        @: first
+        @: second
+    required: first second
+    return: @
+    make:
+        private: @: pair (copy(FxPair))
+        pair\first := first
+        pair\second := second
+        return: pair
+
+FxStdCutIndex:
+    private:
+        @: items
+        int: count
+    required: items count
+    return: int
+    get:
+        throws: copy(FxThrows\kernel)
+        FxSeqInfo\get(items)
+        if: count < 0
+            return: 0
+        if: count > length(items)
+            return: length(items)
+        return: count
+
+FxStdCut:
+    private:
+        @: items
+        int: count
+    required: items count
+    return: @
+    take:
+        throws: copy(FxThrows\sequence)
+        return: FxSeqSlice\slice(items; 0; FxStdCutIndex\get(items; count))
+    drop:
+        throws: copy(FxThrows\sequence)
+        return: FxSeqSlice\slice(items; FxStdCutIndex\get(items; count); length(items))
+    splitAt:
+        throws: copy(FxThrows\sequence)
+        return: FxStdPair\make(take(items; count); drop(items; count))
+
+# One ordered prefix scan; the first rejected item is tested exactly once.
+FxStdPrefixIndex:
+    private:
+        @: items
+        @: accepts
+    required: items accepts
+    return: int
+    get:
+        throws: copy(FxThrows\predicate)
+        FxSeqInfo\get(items)
+        private: int: i 0
+        while: i < length(items)
+            private: @: value FxSeqRead\read(items; i)
+            private: @: flag FxApply\apply(accepts; FxOne\make(value))
+            if: FxSeqPredicate\truth(flag) = 0
+                break
+            i += 1
+        return: i
+
+FxStdPrefix:
+    private:
+        @: items
+        @: accepts
+    required: items accepts
+    return: @
+    takeWhile:
+        throws: copy(FxThrows\predicate) SequenceSize
+        return: FxStdCut\take(items; FxStdPrefixIndex\get(items; accepts))
+    dropWhile:
+        throws: copy(FxThrows\predicate) SequenceSize
+        return: FxStdCut\drop(items; FxStdPrefixIndex\get(items; accepts))
+    span:
+        throws: copy(FxThrows\predicate) SequenceSize
+        return: FxStdCut\splitAt(items; FxStdPrefixIndex\get(items; accepts))
+
+FxStdPartition:
+    private:
+        @: items
+        @: accepts
+    required: items accepts
+    return: @
+    partition:
+        throws: copy(FxThrows\sequencefixture)
+        private: @: yes FxSeqEmpty\make(items)
+        private: @: no FxSeqEmpty\make(items)
+        private: int: i 0
+        while: i < length(items)
+            private: @: value FxSeqRead\read(items; i)
+            private: @: flag FxApply\apply(accepts; FxOne\make(value))
+            private: @: selected no
+            if: FxSeqPredicate\truth(flag) != 0
+                selected := yes
+            FxSeqPush\append(selected; value)
+            i += 1
+        return: FxStdPair\make(yes; no)
+
+FxStdEnumerate:
+    private:
+        @: items
+        int: start 0
+    required: items
+    return: @
+    enumerate:
+        throws: copy(FxThrows\sequencefixture)
+        FxSeqInfo\get(items)
+        private: @: out FxSeqAllocate\make(@[]; length(items))
+        private: bigint: cursor start
+        private: int: i 0
+        while: i < length(items)
+            # Ordinary checked numeric admission; never wrap an int index.
+            private: int: index cursor
+            out[i] := FxStdPair\make((index FxRecordOperands\record); FxSeqRead\read(items; i))
+            i += 1
+            if: i < length(items)
+                cursor += 1
+        ---
+        return: out
+
+# Shared slicer: full windows by default; partial permits one final short
+# window. Once a produced window reaches the end, no redundant suffix follows.
+FxStdWindows:
+    private:
+        @: items
+        int: width 2
+        int: step 1
+        int: partial 0
+    required: items
+    return: @
+    windows:
+        throws: copy(FxThrows\mutation) SequenceStep
+        FxSeqInfo\get(items)
+        if: width <= 0 || step <= 0
+            throw: SequenceStep()
+        private: @: out FxSeqAllocate\make(@[]; 0)
+        private: int: at 0
+        while: at < length(items)
+            private: int: remaining length(items) - at
+            private: int: count width
+            if: count > remaining
+                if: partial = 0
+                    break
+                count := remaining
+            private: @: part FxSeqSlice\slice(items; at; at + count)
+            FxSeqPush\append(out; part)
+            if: count = remaining || step >= remaining
+                break
+            at += step
+        return: out
+
+FxStdChunks:
+    private:
+        @: items
+        int: size
+        int: strict 0
+    required: items size
+    return: @
+    chunks:
+        throws: copy(FxThrows\mutation) SequenceStep FxShape
+        FxSeqInfo\get(items)
+        if: size <= 0
+            throw: SequenceStep()
+        if: strict != 0 && length(items) % size != 0
+            throw: FxShape()
+        return: FxStdWindows\windows(items; size; size; 1)
+
+FxStdIntersperse:
+    private:
+        @: items
+        @: separator
+    required: items separator
+    return: @
+    intersperse:
+        throws: copy(FxThrows\mutation)
+        private: @: info FxSeqInfo\get(items)
+        private: int: count length(items)
+        private: @: out FxSeqAllocate\make(info\arrayType; 0)
+        if: count = 0
+            return: out
+        if: count = 1
+            return: FxSeqSlice\slice(items; 0; 1)
+        private: int: total FxSeqSize\sum(count; count - 1; info\maxLength)
+        private: @: ready FxSeqAdmit\admit(out; separator)
+        sys\resize(out; total)
+        private: int: i 0
+        private: int: at 0
+        while: i < count
+            if: i != 0
+                FxKernel\arrayWrite(target := out; index := at; value := ready)
+                at += 1
+            FxKernel\arrayWrite(target := out; index := at; value := FxSeqRead\read(items; i))
+            at += 1
+            i += 1
+        return: out
+
+FxStdIntercalate:
+    private:
+        @: parts
+        @: separator
+    required: parts separator
+    return: @
+    intercalate:
+        throws: copy(FxThrows\mutation)
+        FxSeqInfo\get(parts)
+        FxSeqInfo\get(separator)
+        if: length(parts) = 0
+            return: FxSeqEmpty\make(separator)
+        return: FxSeqConcat\concat(FxStdIntersperse\intersperse(FxSeqRecords\make(parts); separator))
+
+# Pair protocol is exactly FxZip's first/second typed-record fields.
+FxStdUnzip:
+    private: @: pairs
+    required: pairs
+    return: @
+    unzip:
+        throws: copy(FxThrows\sequence)
+        FxSeqInfo\get(pairs)
+        private: @: first FxSeqAllocate\make(@[]; length(pairs))
+        private: @: second FxSeqAllocate\make(@[]; length(pairs))
+        private: int: i 0
+        while: i < length(pairs)
+            private: FxPair@: pair FxSeqRead\read(pairs; i)
+            first[i] := pair\first
+            second[i] := pair\second
+            i += 1
+        return: FxStdPair\make(first; second)
+
+# Strict finite right folds: callback order is right-to-left. Reuse the
+# existing fold/scan engine; flipping affects the two explicit argument slots.
+FxStdRightFold:
+    private:
+        @: items
+        @: seed
+        @: step
+    required: items seed step
+    return: @
+    foldr:
+        throws: copy(FxThrows\sequencefixture)
+        return: FxFold\fold(FxSeqReverse\reverse(items); seed; FxFlip\flip(step))
+    scanr:
+        throws: copy(FxThrows\sequencefixture)
+        return: FxSeqReverse\reverse(FxScan\scan(FxSeqReverse\reverse(items); seed; FxFlip\flip(step)))
+
+# All Maybe-mapping policies share this loop. The existing call bridge
+# returns a compound result directly as its real typed value reference.
+# No extra @ layer is invented or unconditionally dereferenced.
+FxStdMaybeMapEngine:
+    private:
+        @: items
+        @: transform
+        int: stopOnNone
+        int: firstOnly
+    required: items transform stopOnNone firstOnly
+    return: @
+    run:
+        throws: copy(FxThrows\traversal) SequenceElement
+        FxSeqInfo\get(items)
+        private: @: out FxSeqAllocate\make(@[]; 0)
+        private: int: i 0
+        while: i < length(items)
+            private: @: packed FxApply\apply(transform; FxOne\make(FxSeqRead\read(items; i)))
+            private: FxMaybe@: answer packed
+            if: answer\present != 0
+                if: firstOnly != 0
+                    return: answer
+                FxSeqPush\append(out; answer\value)
+            else:
+                if: stopOnNone != 0
+                    break
+            ---
+            i += 1
+        if: firstOnly != 0
+            return: FxNone\none()
+        return: out
+
+FxStdMaybeMap:
+    private:
+        @: items
+        @: transform
+    required: items transform
+    return: @
+    filterMap:
+        throws: copy(FxThrows\traversal) SequenceElement
+        return: FxStdMaybeMapEngine\run(items; transform; 0; 0)
+    mapWhile:
+        throws: copy(FxThrows\traversal) SequenceElement
+        return: FxStdMaybeMapEngine\run(items; transform; 1; 0)
+    findMap:
+        throws: copy(FxThrows\traversal) SequenceElement
+        return: FxStdMaybeMapEngine\run(items; transform; 0; 1)
+
+# Stateful map: the callback returns FxPair(next-state record, output record).
+# Both directions share one loop and write outputs at the original positions.
+FxStdMapAccumEngine:
+    private:
+        @: items
+        @: seed
+        @: step
+        int: fromRight
+    required: items seed step fromRight
+    return: @
+    run:
+        throws: copy(FxThrows\traversal)
+        FxSeqInfo\get(items)
+        private: int: count length(items)
+        private: @: out FxSeqAllocate\make(@[]; count)
+        private: @: accumulator seed
+        private: int: i 0
+        while: i < count
+            private: int: at i
+            if: fromRight != 0
+                at := count - 1 - i
+            private: @: packed FxApply\apply(step; FxTwo\make(accumulator; FxSeqRead\read(items; at)))
+            private: FxPair@: answer packed
+            accumulator := answer\first
+            out[at] := answer\second
+            i += 1
+        return: FxStdPair\make(accumulator; out)
+
+FxStdMapAccum:
+    private:
+        @: items
+        @: seed
+        @: step
+    required: items seed step
+    return: @
+    mapAccumL:
+        throws: copy(FxThrows\traversal)
+        return: FxStdMapAccumEngine\run(items; seed; step; 0)
+    mapAccumR:
+        throws: copy(FxThrows\traversal)
+        return: FxStdMapAccumEngine\run(items; seed; step; 1)
+
+# Consecutive groups are different from global FxGroupBy buckets. keyOf runs
+# exactly once per item; sameKey compares each adjacent key pair once.
+FxStdGroupAdjacent:
+    private:
+        @: items
+        @: keyOf
+        @: sameKey
+    required: items keyOf sameKey
+    return: @
+    groupAdjacent:
+        throws: copy(FxThrows\sequencefixture)
+        FxSeqInfo\get(items)
+        private: @: out FxSeqAllocate\make(@[]; 0)
+        private: @: previous 0
+        private: @: group 0
+        private: int: begin 0
+        private: int: i 0
+        while: i < length(items)
+            private: @: key FxApply\apply(keyOf; FxOne\make(FxSeqRead\read(items; i)))
+            private: int: starts i = 0
+            if: starts = 0
+                private: @: flag FxApply\apply(sameKey; FxTwo\make(previous; key))
+                starts := FxSeqPredicate\truth(flag) = 0
+            if: starts != 0
+                if: i != 0
+                    group\items := FxSeqSlice\slice(items; begin; i)
+                group := (copy(FxGroup))
+                group\key := key
+                FxSeqPush\append(out; group)
+                begin := i
+            previous := key
+            i += 1
+        if: i != 0
+            group\items := FxSeqSlice\slice(items; begin; i)
+        return: out
+
+FxStdReplicate:
+    private:
+        @: value
+        int: count
+    required: value count
+    return: @
+    replicate:
+        throws: FxKernelFailure FxTypeToken SequenceSize
+        private: int: size count
+        if: size < 0
+            size := 0
+        private: @: out FxSeqAllocate\make(@[]; size)
+        private: int: i 0
+        while: i < size
+            out[i] := value
+            i += 1
+        return: out
+
+FxStdCycle:
+    private:
+        @: items
+        int: count
+    required: items count
+    return: @
+    cycle:
+        throws: copy(FxThrows\sequence)
+        private: @: info FxSeqInfo\get(items)
+        if: count <= 0 || length(items) = 0
+            return: FxSeqEmpty\make(items)
+        if: count > info\maxLength / length(items)
+            throw: SequenceSize()
+        return: FxSeqConcat\concat(FxStdReplicate\replicate(items; count))
+
+FxStdStarMap:
+    private:
+        @: rows
+        @: operation
+    required: rows operation
+    return: @
+    starmap:
+        throws: copy(FxThrows\traversal)
+        FxSeqInfo\get(rows)
+        private: @: out FxSeqAllocate\make(@[]; length(rows))
+        private: int: i 0
+        while: i < length(rows)
+            private: @: row FxSeqRead\read(rows; i)
+            out[i] := FxApply\apply(operation; FxSeqRecords\make(row))
+            i += 1
+        return: out
+
+FxStdZipLongest:
+    private:
+        @: first
+        @: second
+        @: fill
+    required: first second fill
+    return: @
+    zipLongest:
+        throws: copy(FxThrows\sequence)
+        FxSeqInfo\get(first)
+        FxSeqInfo\get(second)
+        private: int: count length(first)
+        if: length(second) > count
+            count := length(second)
+        private: @: out FxSeqAllocate\make(@[]; count)
+        private: int: i 0
+        while: i < count
+            private: @: a fill
+            private: @: b fill
+            if: i < length(first)
+                a := FxSeqRead\read(first; i)
+            if: i < length(second)
+                b := FxSeqRead\read(second; i)
+            out[i] := FxStdPair\make(a; b)
+            i += 1
+        return: out
+
+# Nullary producer, finite prefix or termination by its declared Stop().
+# The ordinary call bridge returns the real typed value record. Only that
+# producer outcome is inspected; append failures are never exhaustion.
+FxStdCollect:
+    private:
+        @: next
+        int: limit -1
+    required: next
+    return: @
+    collect:
+        throws: copy(FxThrows\mutation) FxCallFailure
+        if: limit < -1
+            throw: SequenceSize()
+        private: @: out FxSeqAllocate\make(@[]; 0)
+        while: limit = -1 || length(out) < limit
+            private: @: outcome FxTry\attempt(next; ())
+            if: outcome\ok = 0
+                if: FxSameText\same(outcome\failure; sys\name(Stop)) != 0
+                    return: out
+                throw: FxCallFailure(outcome)
+            FxSeqPush\append(out; outcome\value)
+        return: out
+
+# Membership and sets use an explicit pure equivalence predicate. There is
+# no implicit hashing, ordering, numeric coercion or graph deep comparison.
+FxStdMembership:
+    private:
+        @: items
+        @: value
+        @: same
+    required: items value same
+    return: int
+    includes:
+        throws: copy(FxThrows\predicate)
+        FxSeqInfo\get(items)
+        private: int: i 0
+        while: i < length(items)
+            private: @: flag FxApply\apply(same; FxTwo\make(FxSeqRead\read(items; i); value))
+            if: FxSeqPredicate\truth(flag) != 0
+                return: 1
+            i += 1
+        return: 0
+
+FxStdAdjoin:
+    private:
+        @: items
+        @: value
+        @: same
+    required: items value same
+    return: @
+    adjoin:
+        throws: copy(FxThrows\sequencefixture)
+        if: FxStdMembership\includes(items; value; same) != 0
+            return: items
+        private: @: out FxSeqSlice\slice(items; 0; length(items))
+        FxSeqInsert\insert(out; 0; FxOne\make(value))
+        return: out
+
+FxStdSetSelect:
+    private:
+        @: items
+        @: other
+        @: same
+        int: keepPresent
+    required: items other same keepPresent
+    return: @
+    select:
+        throws: copy(FxThrows\sequencefixture)
+        FxSeqInfo\get(other)
+        private: @: values FxUnique\unique(items; same)
+        private: @: out FxSeqEmpty\make(items)
+        private: int: i 0
+        while: i < length(values)
+            private: @: value FxSeqRead\read(values; i)
+            if: FxStdMembership\includes(other; value; same) = keepPresent
+                FxSeqPush\append(out; value)
+            i += 1
+        return: out
+
+FxStdSets:
+    private:
+        @: first
+        @: second
+        @: same
+    required: first second same
+    return: @
+    union:
+        throws: copy(FxThrows\sequencefixture)
+        return: FxUnique\unique(FxSeqConcat\concat((first; second)); same)
+    intersection:
+        throws: copy(FxThrows\sequencefixture)
+        return: FxStdSetSelect\select(first; second; same; 1)
+    difference:
+        throws: copy(FxThrows\sequencefixture)
+        return: FxStdSetSelect\select(first; second; same; 0)
+    symmetricDifference:
+        throws: copy(FxThrows\sequencefixture)
+        return: FxSeqConcat\concat((difference(first; second; same); difference(second; first; same)))
+
+FxStdSubset:
+    private:
+        @: first
+        @: second
+        @: same
+    required: first second same
+    return: int
+    isSubset:
+        throws: copy(FxThrows\sequencefixture)
+        private: @: missing FxStdSets\difference(first; second; same)
+        return: length(missing) = 0
diff --git a/patterns/LMX_Fn_Receivers/src/coreStandardLisp.lmx b/patterns/LMX_Fn_Receivers/src/coreStandardLisp.lmx
new file mode 100644
index 0000000000000000000000000000000000000000..ca58642773e5baa4860abe532538d89566902839
--- /dev/null
+++ b/patterns/LMX_Fn_Receivers/src/coreStandardLisp.lmx
@@ -0,0 +1,300 @@
+# ASSOCIATION / PROPERTY LISTS OVER ORDINARY LMX ARRAYS.
+# One search visits keys; assoc, get/set/removeProperty and getProperties reuse
+# it. Complete typed records and referenced objects retain their identity.
+# Equality is explicit, must be an equivalence relation, and must not mutate
+# a traversed input. These are Array contracts, not emulated Lisp cons cells.
+
+FxValueSame:
+    private:
+        @: first
+        @: second
+        @: same
+    required: first second same
+    return: int
+    test:
+        throws: copy(FxThrows\predicate)
+        return: FxSeqPredicate\truth(FxApply\apply(same; FxTwo\make(first; second)))
+
+FxKeyShape:
+    private:
+        @: source
+        int: stride 1
+    required: source
+    return: int
+    count:
+        throws: FxKernelFailure FxShape FxTypeToken
+        FxSeqInfo\get(source)
+        if: stride < 1
+            throw: FxShape()
+        private: int: size length(source)
+        if: size % stride != 0
+            throw: FxShape()
+        return: size
+
+# field=-1 selects a flat key; field>=0 selects that field of a row.
+# Empty rows are skipped. A nonempty short row gets ordinary ReceiverIndex.
+FxKeyIndex:
+    private:
+        @: source
+        @: key
+        @: same
+        int: stride 1
+        int: field -1
+    required: source key same
+    return: int
+    find:
+        throws: copy(FxThrows\predicate) FxShape
+        private: int: size FxKeyShape\count(source; stride)
+        private: int: i 0
+        while: i < size
+            private: @: candidate FxSeqRead\read(source; i)
+            private: int: usable 1
+            if: field >= 0
+                FxSeqInfo\get(candidate)
+                if: length(candidate) = 0
+                    usable := 0
+                else:
+                    candidate := FxSeqRead\read(candidate; field)
+            ---
+            if: usable != 0
+                if: FxValueSame\test(key; candidate; same)
+                    return: i
+            ---
+            i += stride
+        return: -1
+
+FxAssoc:
+    private:
+        @: rows
+        @: key
+        @: same
+        int: keyIndex 0
+    required: rows key same
+    return: @
+    assoc:
+        throws: copy(FxThrows\predicate) FxShape
+        if: keyIndex < 0
+            throw: ReceiverIndex()
+        private: int: i FxKeyIndex\find(rows; key; same; field := keyIndex)
+        if: i < 0
+            return: FxNone\none()
+        return: FxSome\some(value := FxSeqRead\read(rows; i))
+
+FxPairlis:
+    private:
+        @: keys
+        @: values
+        @: tail ()
+    required: keys values
+    return: @
+    pairlis:
+        throws: copy(FxThrows\sequence) FxShape
+        private: int: count FxKeyShape\count(keys)
+        if: FxKeyShape\count(values) != count
+            throw: FxShape()
+        private: @: pairs FxZip\zip(keys; values)
+        return: FxSeqConcat\concat(parts := (pairs; tail))
+
+FxGetProperty:
+    private:
+        @: properties
+        @: key
+        @: same
+    required: properties key same
+    return: @
+    getProperty:
+        throws: copy(FxThrows\predicate) FxShape
+        private: int: i FxKeyIndex\find(properties; key; same; stride := 2)
+        if: i < 0
+            return: FxNone\none()
+        return: FxSome\some(value := FxSeqRead\read(properties; i + 1))
+
+FxSetProperty:
+    private:
+        @: properties
+        @: key
+        @: value
+        @: same
+    required: properties key value same
+    return: @
+    setProperty:
+        throws: copy(FxThrows\predicate) FxShape SequenceElement SequenceSize
+        private: int: i FxKeyIndex\find(properties; key; same; stride := 2)
+        if: i < 0
+            private: int: end length(properties)
+            return: FxSeqReplaceRange\replaceRange(properties; end; end; FxTwo\make(key; value))
+        return: FxSeqReplaceRange\replaceRange(properties; i + 1; i + 2; FxOne\make(value))
+
+FxRemoveProperty:
+    private:
+        @: properties
+        @: key
+        @: same
+    required: properties key same
+    return: int
+    removeProperty:
+        throws: copy(FxThrows\predicate) FxShape SequenceElement SequenceSize
+        private: int: i FxKeyIndex\find(properties; key; same; stride := 2)
+        if: i < 0
+            return: 0
+        FxSeqReplaceRange\replaceRange(properties; i; i + 2; ())
+        return: 1
+
+FxPropertyMatch:
+    @: key
+    @: value
+    int: index 0
+
+FxGetProperties:
+    private:
+        @: properties
+        @: indicators
+        @: same
+    required: properties indicators same
+    return: @
+    getProperties:
+        throws: copy(FxThrows\predicate) FxShape
+        private: int: size FxKeyShape\count(properties; 2)
+        FxSeqInfo\get(indicators)
+        private: int: i 0
+        while: i < size
+            private: @: key FxSeqRead\read(properties; i)
+            if: FxKeyIndex\find(indicators; key; same) >= 0
+                private: @: match (copy(FxPropertyMatch))
+                match\key := key
+                match\value := FxSeqRead\read(properties; i + 1)
+                match\index := i
+                return: FxSome\some(value := match)
+            i += 2
+        return: FxNone\none()
+
+# The public callers validate source profiles and select a common valid span.
+# The only element comparison loop also serves every search candidate.
+FxSequenceDifference:
+    private:
+        @: first
+        @: second
+        @: same
+        int: firstStart
+        int: count
+    required: first second same firstStart count
+    return: int
+    find:
+        throws: copy(FxThrows\predicate)
+        private: int: i 0
+        while: i < count
+            if: FxValueSame\test(FxSeqRead\read(first; firstStart + i); FxSeqRead\read(second; i); same) = 0
+                return: i
+            i += 1
+        return: -1
+
+FxMismatch:
+    private:
+        @: first
+        @: second
+        @: same
+    required: first second same
+    return: @
+    mismatch:
+        throws: copy(FxThrows\predicate) FxRecordArity
+        FxSeqInfo\get(first)
+        FxSeqInfo\get(second)
+        private: int: count length(first)
+        if: length(second) < count
+            count := length(second)
+        private: int: i FxSequenceDifference\find(first; second; same; 0; count)
+        if: i < 0 && length(first) != length(second)
+            i := count
+        if: i < 0
+            return: FxNone\none()
+        return: FxSome\some(value := (i FxRecordOperands\record))
+
+FxSearchSequence:
+    private:
+        @: items
+        @: pattern
+        @: same
+        int: start 0
+    required: items pattern same
+    return: @
+    searchSequence:
+        throws: copy(FxThrows\predicate) FxRecordArity
+        FxSeqInfo\get(items)
+        FxSeqInfo\get(pattern)
+        private: int: size length(items)
+        if: start < 0 || start > size
+            throw: ReceiverIndex()
+        private: int: count length(pattern)
+        if: count > size - start
+            return: FxNone\none()
+        private: int: i start
+        while: i <= size - count
+            if: FxSequenceDifference\find(items; pattern; same; i; count) < 0
+                return: FxSome\some(value := (i FxRecordOperands\record))
+            if: i = size - count
+                break
+            i += 1
+        return: FxNone\none()
+
+FxSubstitute:
+    private:
+        @: items
+        @: oldValue
+        @: newValue
+        @: same
+    required: items oldValue newValue same
+    return: @
+    substitute:
+        throws: copy(FxThrows\predicate) SequenceElement SequenceSize
+        private: @: info FxSeqInfo\get(items)
+        private: int: count length(items)
+        private: @: result FxSeqAllocate\make(info\arrayType; count)
+        private: int: i 0
+        while: i < count
+            private: @: value FxSeqRead\read(items; i)
+            if: FxValueSame\test(oldValue; value; same)
+                value := newValue
+            FxSeqStore\write(result; i; value)
+            i += 1
+        return: result
+
+# A callable becomes one ordinary prepared-value operand. The SAME instance
+# admits (op a b) and (a op b): absent left is not replaced or dynamically
+# filled. RxLogicalArguments is the already shared left/right collector.
+# Full result requirements come from signatureData, not numeric type text.
+# Only constant PRIORITY is printed once into an ordinary parsed DATA fragment.
+# FxBuild preserves that DATA and its ordinary own policy, including the
+# structural operand properties; it adds no operand registry or parser mode.
+FxOperandInputTypes:
+    @: left
+    @[]: right
+
+FxAsOperand:
+    private:
+        @: operation
+        int: priority
+    required: operation priority
+    return: @
+    asOperand:
+        throws: copy(FxThrows\selection)
+        private: @: source FxKernel\signature(operation)
+        private: @: inputTypes FxTwo\make(FxKernel\normalizeType(FxOperandInputTypes[0]); FxKernel\normalizeType(FxOperandInputTypes[1]))
+        private: @: noResult FxKernel\normalizeType(void)
+        private: @: inputs FxKernel\signatureData(inputTypes; noResult; ("left"; "right"))
+        private: @: output FxKernel\signatureData((); source\resultType; ())
+        private: char[]: properties FxConcat\concat("const: int: PASS_ARGS_AS_IS 0\nconst: int: PRIORITY "; FxFormatInt\formatInt(priority))
+        private: @: readyProperties sys\fromLmx(properties)
+        private: @: data (
+            private: copy(inputs)
+            required: right
+            copy(output)
+            copy(readyProperties)
+        )
+        Operand :: data
+        private: char[]: body "private: @: args RxLogicalArguments\\collect(left := left; right := right)\nprivate: @: outcome FxTry\\attempt(node\\private\\state; args)\nif: outcome\\ok = 0\n    FxKernel\\raise(name := outcome\\failure; payload := outcome\\payload)\n"
+        if: source\hasResult != 0
+            body := FxConcat\concat(body; "return: \\outcome\\value\n")
+        else:
+            body := FxConcat\concat(body; "return\n")
+        private: @: failures FxFailures\union(source\throws; ("FxKernelFailure"; "FxTypeToken"))
+        return: FxBuild\make(Operand; body; operation; failures)
diff --git a/patterns/LMX_Fn_Receivers/src/coreStandardNumeric.lmx b/patterns/LMX_Fn_Receivers/src/coreStandardNumeric.lmx
new file mode 100644
index 0000000000000000000000000000000000000000..07038e0f86257eaa72656b55ba34acebdda56323
--- /dev/null
+++ b/patterns/LMX_Fn_Receivers/src/coreStandardNumeric.lmx
@@ -0,0 +1,190 @@
+# Numeric conveniences use the selected scalar arithmetic/comparison profile.
+# Numeric values travel as ordinary type/value records, never as int payloads
+# disguised as pointers. Reduction uses the common Expression, with one shared extremum loop.
+# Default sum/product seeds are int zero/one; supply the profile's own record
+# when a different neutral value or non-default numeric context is required.
+
+# Explicit copy opens the caller's ready sequence into the common Expression
+# argument stream. Empty arrays still contribute the neutral initial value.
+FxSum:
+    private:
+        @: items
+        @: initial (0 record)
+    return: @
+    sum:
+        throws: FxRecordArity
+        return: ((+ \initial copy(items)) record)
+
+FxProduct:
+    private:
+        @: items
+        @: initial (1 record)
+    return: @
+    product:
+        throws: FxRecordArity
+        return: ((* \initial copy(items)) record)
+
+FxNumericExtreme:
+    private:
+        @: items
+        int: greatest
+    return: @
+    find:
+        throws: copy(FxThrows\sequence) FxRecordArity
+        FxSeqInfo\get(items)
+        if: length(items) = 0
+            throw: SequenceSize()
+        private: @: value FxSeqRead\read(items; 0)
+        private: int: at 0
+        private: int: i 1
+        while: i < length(items)
+            private: @: candidate FxSeqRead\read(items; i)
+            private: @: selected FxNumericPair\choose(value; candidate; greatest)
+            if: selected != value
+                value := selected
+                at := i
+            i += 1
+        return: FxTwo\make(value; (at record))
+
+FxMinimum:
+    private: @: items
+    return: @
+    minimum:
+        throws: copy(FxThrows\sequence) FxRecordArity
+        private: @: result FxNumericExtreme\find(items; 0)
+        return: result[0]
+
+FxMaximum:
+    private: @: items
+    return: @
+    maximum:
+        throws: copy(FxThrows\sequence) FxRecordArity
+        private: @: result FxNumericExtreme\find(items; 1)
+        return: result[0]
+
+FxArgMin:
+    private: @: items
+    return: int
+    argMin:
+        throws: copy(FxThrows\sequence) FxRecordArity
+        private: @: result FxNumericExtreme\find(items; 0)
+        return: \result[1]
+
+FxArgMax:
+    private: @: items
+    return: int
+    argMax:
+        throws: copy(FxThrows\sequence) FxRecordArity
+        private: @: result FxNumericExtreme\find(items; 1)
+        return: \result[1]
+
+FxExtrema:
+    private: @: items
+    return: @
+    extrema:
+        throws: copy(FxThrows\sequence) FxRecordArity
+        return: FxTwo\make(FxMinimum\minimum(items); FxMaximum\maximum(items))
+
+FxNumericPair:
+    private:
+        @: first
+        @: second
+        int: greatest
+    return: @
+    choose:
+        private: int: order (\second > \first) - (\second < \first)
+        if: (greatest = 0 && order < 0) || (greatest != 0 && order > 0)
+            return: second
+        return: first
+
+FxMin:
+    private:
+        @: first
+        @: second
+    return: @
+    min:
+        return: FxNumericPair\choose(first; second; 0)
+
+FxMax:
+    private:
+        @: first
+        @: second
+    return: @
+    max:
+        return: FxNumericPair\choose(first; second; 1)
+
+FxMinMax:
+    private:
+        @: first
+        @: second
+    return: @
+    minMax:
+        if: \second < \first
+            return: FxTwo\make(second; first)
+        return: FxTwo\make(first; second)
+
+FxClamp:
+    private:
+        @: value
+        @: lower
+        @: upper
+    return: @
+    clamp:
+        throws: NumericDomain
+        if: \upper < \lower
+            throw: NumericDomain()
+        return: FxMin\min(FxMax\max(value; lower); upper)
+
+FxSign:
+    private: @: value
+    return: int
+    sign:
+        return: (\value > 0) - (\value < 0)
+
+# Exact integer helpers select bigint explicitly, avoiding MIN_INT negation
+# and intermediate machine overflow. Machine narrowing is a caller conversion.
+FxGcd:
+    private:
+        bigint: first
+        bigint: second
+    return: bigint
+    gcd:
+        if: first < 0
+            first := -first
+        if: second < 0
+            second := -second
+        while: second != 0
+            private: bigint: rest first % second
+            first := second
+            second := rest
+        return: first
+
+FxLcm:
+    private:
+        bigint: first
+        bigint: second
+    return: bigint
+    lcm:
+        if: first = 0 || second = 0
+            return: 0
+        private: bigint: result (first / FxGcd\gcd(first; second)) * second
+        if: result < 0
+            result := -result
+        return: result
+
+# Floor quotient, unlike the target C99 truncating division for negative input.
+FxDivMod:
+    private:
+        bigint: dividend
+        bigint: divisor
+    return: @
+    divMod:
+        throws: NumericDomain
+        if: divisor = 0
+            throw: NumericDomain()
+        private: bigint: quotient dividend / divisor
+        private: bigint: remainder dividend % divisor
+        if: remainder != 0 && ((remainder < 0) != (divisor < 0))
+            quotient -= 1
+            remainder += divisor
+        return: (quotient; remainder)
diff --git a/patterns/LMX_Fn_Receivers/src/coreStandardObjects.lmx b/patterns/LMX_Fn_Receivers/src/coreStandardObjects.lmx
new file mode 100644
index 0000000000000000000000000000000000000000..a6e527318a0ad2bebec5a037c6405110c988cf54
--- /dev/null
+++ b/patterns/LMX_Fn_Receivers/src/coreStandardObjects.lmx
@@ -0,0 +1,239 @@
+# STANDARD OPTION / RESULT OPERATIONS OVER THE EXISTING TYPED RECORDS.
+# Payloads and fallbacks below are references to type/value records, not int
+# placeholders and not boxed copies of an arbitrary referenced object.
+# Unselected callbacks are not invoked. A present null/zero/empty value is
+# still present. Direct callback failures retain the ordinary FxCallFailure.
+
+FxMapOption:
+    private:
+        FxMaybe@: input
+        @: transform
+    required: input transform
+    return: @
+    mapOption:
+        throws: copy(FxThrows\call)
+        if: input\present = 0
+            return: input
+        private: @: value FxApply\apply(transform; FxOne\make(input\value))
+        return: FxSome\some(value := value)
+
+FxFilterOption:
+    private:
+        FxMaybe@: input
+        @: accepts
+    required: input accepts
+    return: @
+    filterOption:
+        throws: copy(FxThrows\predicate)
+        if: input\present = 0
+            return: input
+        private: @: accepted FxApply\apply(accepts; FxOne\make(input\value))
+        if: FxSeqPredicate\truth(accepted) = 0
+            return: FxNone\none()
+        return: input
+
+# Java Optional.orElse: the fallback is already evaluated. The result is the
+# chosen payload record, not another Maybe. orElseGet is the lazy counterpart.
+FxOrElse:
+    private:
+        FxMaybe@: input
+        @: fallback
+    required: input fallback
+    return: @
+    orElse:
+        if: input\present != 0
+            return: input\value
+        return: fallback
+
+FxOrElseGet:
+    private:
+        FxMaybe@: input
+        @: fallback
+    required: input fallback
+    return: @
+    orElseGet:
+        throws: copy(FxThrows\call)
+        if: input\present != 0
+            return: input\value
+        return: FxApply\apply(fallback; ())
+
+# C++/Rust/Scala optional fallback returns another container. Keep that contract
+# distinct from Java's payload-returning orElse/orElseGet.
+FxOrElseOption:
+    private:
+        FxMaybe@: input
+        @: fallback
+    required: input fallback
+    return: @
+    orElseOption:
+        throws: copy(FxThrows\call)
+        if: input\present != 0
+            return: input
+        private: @: record FxApply\apply(fallback; ())
+        private: FxMaybe@: result record
+        return: result
+
+# Both branches reuse the two operations above; no second optional dispatch
+# algorithm is embedded in this eliminator.
+FxFoldOption:
+    private:
+        FxMaybe@: input
+        @: whenEmpty
+        @: whenPresent
