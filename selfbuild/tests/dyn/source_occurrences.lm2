# Slice 276 (N4-U U1, U2; the book, "Карта data"; the author 2026-10-15; CODEX-OPUS-OCC-VALUE-20261103T220837Z-01).  The root heads of a
# Structure are counted one by one, whatever receiver wrote them; `if:` is one head, and a head inside a body is that body's.  A repeated
# head makes no second field: the bare name selects nothing, `s\[N]name` selects the head and reads what stands in its slot now, the
# first declaration's one place or a later head's stored operator.  Entry 7; 81.. name the failing check.
D:
    int: y 3
    int: y 7
end: D
Assigned:
    int: y 3
    y := 7
end: Assigned
One:
    int: y 0
end: One
Other:
    int: v 7
end: Other
Writer:
    int: y 5
end: Writer
Twice:
    int: y 3
    y := 7
end: Twice
Nest:
    T:
        int: y 1
    end: T
    int: y 2
end: Nest
sub: note (int: v)
    return
end: note
Note1:
    note: 3
end: Note1
Note2:
    note: 3
    note: 4
end: Note2
Branch:
    if: 1 = 1
        int: k 3
    ---
    int: z 2
end: Branch
M:
    int: y 0
    y := 1
end: M
W:
    int: z 9
    int: y 5
    y := 6
end: W
Copied: merge: D
Empty: ()
int: hits 1
hits := 2
hits_writer:
    int: hits 5
end: hits_writer
int: quote 0
fn: read_stored () int
    return: quote\[1]y
end: read_stored
fn: read_bare () int
    return: quote\y
end: read_bare
fn: read_far () int
    return: quote\[5]y
end: read_far
fn: read_first () int
    return: quote\[0]y
end: read_first
fn: read_replaced () int
    return: quote\[1]y\v
end: read_replaced
sub: replace ()
    quote\[1]y := Other
end: replace
fn: read_note () int
    if: quote\note = 0
        return: 0
    return: 1
end: read_note
fn: read_if () int
    if: quote\if = 0
        return: 0
    return: 1
end: read_if
fn: read_inner () int
    return: quote\k
end: read_inner
fn: take_first (@: p M) int
    return: p\[0]y
end: take_first
N:
    int: y 0
end: N
fn: take_bare (@: p N) int
    return: p\y
end: take_bare
# A root rebound to a Structure of another layout with one head: the index reads through the pair's map, and the head the value
# does not have is the negative answer of that one reached edge.
Two:
    int: y 1
    y := 2
end: Two
Lone:
    int: w 9
    int: y 5
end: Lone
Two := Lone
fn: read_second_of_two () int
    @: held Empty Two\[1]y
    if: held = 0
        return: 0
    return: 1
end: read_second_of_two
fn: pass_quote () int
    return: take_bare(quote)
end: pass_quote
# A repeated `@:` is a second head of its place.
HeldTwo:
    @: y Empty Empty
    @: y Other
end: HeldTwo
fn: read_held_bare () int
    @: r Empty quote\y
    return: 1
end: read_held_bare
fn: free_held_bare () int
    @: quote HeldTwo HeldTwo
    return: read_held_bare()
end: free_held_bare
fn: copy_first () int
    return: Copied\[0]y
end: copy_first
fn: copy_second () int
    @: held Empty Copied\[1]y
    if: held = 0
        return: 0
    return: 1
end: copy_second
# D's second head now holds Other, which fits this model: no contract refuses here, only the rule of the bare half does.
ReqNested:
    y:
        int: v 0
    end: y
end: ReqNested
fn: take_nested (@: p ReqNested) int
    return: p\y\v
end: take_nested
fn: pass_nested () int
    return: take_nested(quote)
end: pass_nested
fn: free_nested () int
    @: quote D D
    return: pass_nested()
end: free_nested
# The return trailer stands after its body's handlers: what it raises leaves the method and the caller takes it.
fn: trailer_bare (@: p N) int
    int: r 1
    r := r + 1
    catch: implements ()
        r := 30
    ---
return: p\y + r
fn: pass_trailer () int
    return: trailer_bare(quote)
end: pass_trailer
fn: free_trailer () int
    @: quote D D
    return: pass_trailer()
end: free_trailer
fn: free_two_heads () int
    @: quote D D
    return: pass_quote()
end: free_two_heads
fn: refuses_call (int: which) int
    ---
        if: which = 0
            call: Writer D
        ---
        if: which = 1
            call: Writer Assigned
        ---
        if: which = 2
            call: D D
        ---
        if: which = 3
            call: Writer Copied
        ---
        if: which = 4
            call: hits_writer node
        ---
        catch: call ()
            return: 1
    ---
    return: 0
end: refuses_call
# The first declaration's one place: read, written, its address, through a typed reference.
fn: places () int
    if: D\[0]y != 3
        return: 81
    D\[0]y := 9
    if: D\[0]y != 9
        return: 82
    @: p int @ (D\[0]y)
    \p := 8
    if: D\[0]y != 8
        return: 83
    D\[0]y := 3
    @: h D D
    if: h\[0]y != 3
        return: 84
    return: 0
end: places
# A later head's slot holds its operator: a number's receiver refuses it, a bare name or a head past the last refuses at the reached
# operation, the first head is the place.
fn: stored () int
    @: quote D D
    int: caught 0
    ---
        int: k read_stored()
        catch: convert ()
            caught := 1
    ---
    if: caught != 1
        return: 85
    caught := 0
    ---
        int: k read_bare()
        catch: implements ()
            caught := 1
    ---
    if: caught != 1
        return: 86
    caught := 0
    ---
        int: k read_far()
        catch: implements ()
            caught := 1
    ---
    if: caught != 1
        return: 87
    if: read_first() != 3
        return: 88
    @: held Empty D\[1]y
    if: held = 0
        return: 89
    return: 0
end: stored
# A write replaces what stands in the slot; the coordinate of the head stays, and the running code no longer has that operator.
fn: replaced () int
    call: D One
    if: One\y != 7
        return: 90
    @: quote D D
    replace()
    if: read_replaced() != 7
        return: 91
    D\[0]y := 4
    if: read_replaced() != 7 || D\[0]y != 4
        return: 92
    One\y := 0
    call: D One
    if: One\y != 3
        return: 93
    return: 0
end: replaced
# The role of data: two heads refuse the bare name a code requires, a code's own two heads land in the one place, a nested head is not
# a head of the root, a copy keeps its heads.
fn: data_role () int
    if: refuses_call(0) != 1
        return: 94
    if: refuses_call(1) != 1
        return: 95
    if: refuses_call(2) != 1
        return: 96
    One\y := 0
    call: Twice One
    if: One\y != 7
        return: 97
    call: Writer Nest
    if: Nest\y != 5 || Nest\T\y != 1
        return: 98
    if: refuses_call(3) != 1
        return: 99
    return: 0
end: data_role
fn: heads () int
    int: caught 0
    if: note_one() != 1
        return: 100
    ---
        int: k note_two()
        catch: implements ()
            caught := 1
    ---
    if: caught != 1
        return: 101
    if: branch_if() != 1
        return: 102
    caught := 0
    ---
        int: k branch_inner()
        catch: implements ()
            caught := 1
    ---
    if: caught != 1
        return: 103
    return: 0
end: heads
fn: note_one () int
    @: quote Note1 Note1
    return: read_note()
end: note_one
fn: note_two () int
    @: quote Note2 Note2
    return: read_note()
end: note_two
fn: branch_if () int
    @: quote Branch Branch
    return: read_if()
end: branch_if
fn: branch_inner () int
    @: quote Branch Branch
    return: read_inner()
end: branch_inner
# node is an ordinary Structure: its two heads of hits need an index, the bare name is the binding, and as data it refuses.
fn: over_node () int
    if: node\[0]hits != 2
        return: 104
    @: held Empty node\[1]hits
    if: held = 0
        return: 105
    if: hits != 2
        return: 106
    if: refuses_call(4) != 1
        return: 107
    return: 0
end: over_node
# Through an admitted reference the index takes the same-numbered head of the candidate; a bare use against two heads is refused where
# the candidate is received at run time.
fn: through_map () int
    if: take_first(W) != 5
        return: 108
    int: caught 0
    ---
        int: k free_two_heads()
        catch: implements ()
            caught := 1
    ---
    if: caught != 1
        return: 109
    if: Two\[0]y != 5
        return: 110
    caught := 0
    ---
        int: m read_second_of_two()
        catch: implements ()
            caught := 1
    ---
    if: caught != 1
        return: 111
    caught := 0
    ---
        int: t free_trailer()
        catch: implements ()
            caught := 1
    ---
    if: caught != 1
        return: 112
    caught := 0
    ---
        int: h free_nested()
        catch: implements ()
            caught := 1
    ---
    if: caught != 1
        return: 113
    caught := 0
    ---
        int: e free_held_bare()
        catch: implements ()
            caught := 1
    ---
    if: caught != 1
        return: 114
    if: copy_first() != 3 || copy_second() != 1
        return: 115
    return: 0
end: through_map
int: code places()
if: code = 0
    code := stored()
---
if: code = 0
    code := replaced()
---
if: code = 0
    code := data_role()
---
if: code = 0
    code := heads()
---
if: code = 0
    code := over_node()
---
if: code = 0
    code := through_map()
---
if: code = 0
    code := 7
---
send: exit(exit_code: code; stdout: ""; stderr: "")
return
