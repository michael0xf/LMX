L2:
    int: effects 0
    int: before 0
    int: after 0
    fn: touch () int
        :=: (node \ effects) ((node \ effects) + 1)
        return: 7
    end: touch
    fn: opaque (int: value) c.FILE
        return: 0
    end: opaque
    @: held opaque
    :=: before 1
    held: (touch)
    :=: after 2
end: L2
