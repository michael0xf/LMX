# M6 4b (slice 350): a merge operand written `(zz := int: 5)` is refused by P0 -- the operator `:=` is removed; the
# typed field written name first is `(zz: int: 5)` (merge_named_field_operand), the declaration form `(int: zz 5)`.
# (Before 350 the translation refused the operand form, located at the operand.)
Args:
    int: c 3
    int: a 0
end: Args
fn: f () int
    pack: merge(Args; (zz := int: 5))
    return: pack\c
end: f
int: code 7
if: f() != 3
    code: 81
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
