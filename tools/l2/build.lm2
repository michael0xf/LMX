# The runtime objects of the stage built as stage/label: the kernel's L2 modules translated by the frontend fe
# (bld_kernel_l2), the C headers regenerated from the L1 sources then (bld_headers, label/headers), and the driver
# translated by l1trans, compiled strict -O2 as the production runtime driver.o and with -DLMX_OBSERVE_WALK as the
# observed one driver-observe.o.
fn: bld_runtime (@: repo char; @: stage char; @: base char; @: fe char; @: label char) int
    @@: a char c.calloc(40U, sizeof(@: char))
    @: res int c.calloc(2U, c.sizeof(c.int))
    @: out char txt_path(stage, label)
    @: src char txt_path(stage, "src")
    @: rec c.FILE 0
    @: cfile char 0
    int: k 0
    int: n 0
    if: a = 0 || res = 0 || out = 0 || src = 0
        return: 1
    if: file_exists(txt_path(out, "record.txt")) != 0
        c.printf("RUNTIME %s exists: a new label for every attempt\n", out)
        return: 1
    dir_make(out)
    rec: c.fopen(txt_path(out, "record.txt"), "wb")
    if: bld_kernel_l2(rec, repo, stage, base, fe, out, res) != 0
        return: 5
    if: bld_headers(repo, stage, txt_path(out, "headers")) != 0
        return: 6
    cfile: txt_path(out, "driver.c")
    a[0]: txt_path(repo, "bin/l1trans.exe")
    a[1]: txt_path(src, "l2_eternal_driver.lm1")
    a[2]: cfile
    if: bld_step(rec, a, 3, src, txt_path(out, "DRIVER.log"), res) != 0
        return: 2
    while: k < 2
        a[0]: "C:/Qt/Tools/mingw1310_64/bin/gcc.exe"
        n: bld_cflags(a, 1, repo, stage, base, "-O2 -fstrict-aliasing", 0, 0)
        if: n < 0
            return: 3
        if: k = 1
            a[n]: "-DLMX_OBSERVE_WALK"
            n: n + 1
        ---
        a[n]: "-c"
        a[n + 1]: cfile
        a[n + 2]: "-o"
        a[n + 3]: txt_path(out, "driver.o")
        if: k = 1
            a[n + 3]: txt_path(out, "driver-observe.o")
        if: k = 0 && bld_step(rec, a, n + 4, src, txt_path(out, "driver.COMPILE.log"), res) != 0
            return: 3
        if: k = 1 && bld_step(rec, a, n + 4, src, txt_path(out, "driver-observe.COMPILE.log"), res) != 0
            return: 4
        k: k + 1
    ---
    bld_hash_note(rec, cfile)
    bld_hash_note(rec, txt_path(out, "driver.o"))
    bld_hash_note(rec, txt_path(out, "driver-observe.o"))
    c.fclose(rec)
    return: 0
end: bld_runtime

# This tool built by the frontend fe from the stage's tools sources as stage/label/lmxtool.exe, linked with the
# runtime object rt (the parts: text, winargs, sha256, replay, build, suite).
fn: bld_self (@: repo char; @: stage char; @: base char; @: fe char; @: rt char; @: label char) int
    @@: tags char c.calloc(1U, sizeof(@: char))
    @@: objs char c.calloc(1U, sizeof(@: char))
    @: out char txt_path(stage, label)
    @: tools char txt_path(stage, "tools")
    @: parts char 0
    @: rec c.FILE 0
    int: x 0
    if: tags = 0 || objs = 0 || out = 0 || tools = 0
        return: 1
    if: file_exists(txt_path(out, "record.txt")) != 0
        c.printf("SELF %s exists: a new label for every attempt\n", out)
        return: 1
    dir_make(out)
    rec: c.fopen(txt_path(out, "record.txt"), "wb")
    tags[0]: "tool"
    objs[0]: rt
    parts: txt_cat3(txt_path(tools, "text.lm2"), ",", txt_path(tools, "winargs.lm2"))
    parts: txt_cat3(parts, ",", txt_path(tools, "sha256.lm2"))
    parts: txt_cat3(parts, ",", txt_path(tools, "replay.lm2"))
    parts: txt_cat3(parts, ",", txt_path(tools, "build.lm2"))
    parts: txt_cat3(parts, ",", txt_path(tools, "suite.lm2"))
    x: bld_program(repo, stage, base, fe, 0, "-O0", txt_path(tools, "lmxtool.lm2"), parts, out, "lmxtool", tags, objs, 1, "-lshell32,-lbcrypt", rec)
    if: x = 0
        bld_hash_note(rec, txt_path(out, "lmxtool.lm1"))
        bld_hash_note(rec, txt_path(out, "lmxtool.c"))
        bld_hash_note(rec, txt_path(out, "lmxtool-tool.exe"))
    ---
    c.fclose(rec)
    return: x
end: bld_self
