# `catch: implements ()`: the argv letter is not a Model, so its admission to get's Model formal is
# refused -- the implicit throw implements -- and the handler after the call takes it: 42.
Model:
    size_t: value 1U
end: Model

fn: get (Model: x) int
return: 5

int: r 0
nextMessage: m
r: get(m)
catch: implements ()
    r: 42
return: r
