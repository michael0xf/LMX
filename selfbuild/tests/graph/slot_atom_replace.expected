sub: main () (
    A:
        int: value 1
    end: A
    B:
        int: value 7
    end: B
    C:
        int: value 9
    end: C
    Slots: A
    int: j 41
    int: first 0
    int: second 0
    int: third 0
)
    :=: (Slots [] 0) B
    :=: first ((Slots [] 0) \ value)
    :=: (Slots [] 0) (@ j)
    :=: second (Slots \ j)
    :=: (Slots [] 0) C
    :=: third ((Slots [] 0) \ value)
end: main
main:
int: first 7
int: second 41
int: third 9
