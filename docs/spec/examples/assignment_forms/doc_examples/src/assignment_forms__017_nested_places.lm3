NestedPlaces:
    return: @
    run:
        throws: copy(`:=`\throws) ReceiverIndex
        []@: values [(1 2) (3 4)]
        @: first values[0]
        @: second values[1]
        values .(2): (second first)
        @: selected first
        selected .(0): second
        return: (values; selected; first)
