# N4 (LMX_semantics.ru.md #method-parts: the data map counts the root heads of the data): the y inside D\T belongs
# to the initializer of T. The bare y of the code writes the root y of D although D\T\y comes first: D\y becomes 2
# and D\T\y keeps 5. Entry 7.
S:
    int: y 2
end: S
D:
    T:
        int: y 5
    end: T
    int: y 9
end: D
call: S D
int: r 81
if: D\y = 2 && D\T\y = 5
    r: 7
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
