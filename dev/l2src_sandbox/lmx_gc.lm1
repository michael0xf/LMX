predef: "l2src/lmx_gc.h.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_implements.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdlib.h>"

# lmx_gc.lm1 - the mark and the sweep.  See the header for what the model asks; what is worth
# spelling out here is the two directions of the pass:
#
#   the MARK never frees and never moves: it stamps chunks and follows words;
#   the SWEEP never guesses: a block stays unless the block list says the pass did not reach
#   it, and a block that leaves the list has its interval retired BEFORE its storage goes.
#
# A chunk's storage and its record are two blocks of the arena's list, so a chunk that the pass
# did not reach is released twice over: first it leaves its array's chain (so the array never
# hands out storage that is about to be freed), then its two blocks are dropped and disposed.
# lmx_arena_drop detaches a block WITHOUT freeing its payload (that is the block module's
# contract: disposal is dispose_all's act), so the sweep disposes it here -- a collection that
# detached without freeing would be a leak wearing the name of a collection.

# The worse of two statuses: a pass reports the first thing that went wrong, not the last.
fn: lmx_gc_note (int: a; int: b) int
    if: a != c.LMX_GC_OK
        return: a
return: b

# Is this chunk a bag of VALUES rather than of references?  Only the scalar primitive domains
# are: everything else that lives in a primitive array (a pointer element, an Lmx header, a
# descriptor) is a word that may be an address.
fn: lmx_gc_scalar (@: LmxPool pool) int
    if: pool = 0
        return: 0
    if: pool\kind != c.LMX_KIND_PRIMITIVE
        return: 0
    if: pool\type = c.LMX_TYPE_CHAR || pool\type = c.LMX_TYPE_UNSIGNED_CHAR
        return: 1
    if: pool\type = c.LMX_TYPE_INT || pool\type = c.LMX_TYPE_UNSIGNED
        return: 1
    if: pool\type = c.LMX_TYPE_SIZE_T || pool\type = c.LMX_TYPE_ULONG
        return: 1
return: 0

# One word of a cell, followed as a candidate address.  A word that resolves in this arena is
# followed; anything else is a terminal.
fn: lmx_gc_word (@: LmxArena arena; @@: void slot; unsigned: gen; int: depth) int
    if: slot = 0
        return: c.LMX_GC_OK
    if: \slot = 0
        return: c.LMX_GC_OK
return: lmx_gc_mark_value(arena, \slot, gen, depth + 1)

# Every cell of one chunk, walked by what the chunk IS (the array's kind and type).
fn: lmx_gc_cells (@: LmxArena arena; @: LmxPool pool; @: LmxChunk chunk; unsigned: gen; int: depth) int
    size_t: index
    size_t: words
    size_t: word
    @: char cell
    @: Lmx header
    @: LmxArrayDesc desc
    int: status
    status: c.LMX_GC_OK
    if: pool = 0 || chunk = 0 || lmx_gc_scalar(pool) != 0
        return: c.LMX_GC_OK
    ---
    index: 0U
    while: index < chunk\count
        cell: (cast: (@: char) chunk\base) + (index * pool\stride)
        if: pool\kind = c.LMX_KIND_STRUCT
            # A header is {node, len, data}: `len` is a count and is never read as an address.
            header: (cast: (@: Lmx) cell)
            status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) header\node), gen, depth + 1))
            status: lmx_gc_note(status, lmx_gc_mark_value(arena, header\data, gen, depth + 1))
        else:
            if: pool\kind = c.LMX_KIND_ARRAY
                # A descriptor is {len, data}: the backing is what holds the elements.
                desc: (cast: (@: LmxArrayDesc) cell)
                status: lmx_gc_note(status, lmx_gc_mark_value(arena, desc\data, gen, depth + 1))
            else:
                # A child slot, a reference cell, or one of the kernel's own records: every
                # pointer-sized word is a candidate address.  Over-retention is the only error
                # this rule can make, and it is the safe direction.
                words: pool\stride / c.sizeof(@: void)
                word: 0U
                while: word < words
                    status: lmx_gc_note(status, lmx_gc_word(arena, (cast: (@@: void) (cell + (word * c.sizeof(@: void)))), gen, depth))
                    word: word + 1U
                ---
            ---
        ---
        index: index + 1U
    ---
return: status

# The value at one address: mark its chunk (once per pass) and walk what the chunk holds.
fn: lmx_gc_mark_value (@: LmxArena arena; @: void p; unsigned: gen; int: depth) int
    @: LmxPool pool
    @: LmxChunk chunk
    if: p = 0
        return: c.LMX_GC_OK
    if: depth > c.LMX_GC_DEPTH
        return: c.LMX_GC_PARTIAL
    ---
    pool: lmx_range_pool(arena, p)
    if: pool = 0
        # An address this arena never handed out: not this arena's to keep or to free.
        return: c.LMX_GC_OK
    ---
    chunk: lmx_pool_chunk_at(pool, p)
    if: chunk = 0
        return: c.LMX_GC_OK
    if: chunk\mark = gen
        # Already reached by this pass: its cells are being walked, or have been.
        return: c.LMX_GC_OK
    ---
    chunk\mark: gen
return: lmx_gc_cells(arena, pool, chunk, gen, depth)

# Every chunk of one array: the mailbox's own node pool is storage of THIS arena, so a
# collection that ignored it would free the nodes of a live mailbox.
fn: lmx_gc_mark_pool (@: LmxArena arena; @: LmxPool pool; unsigned: gen) int
    @: LmxChunk chunk
    int: status
    status: c.LMX_GC_OK
    chunk: lmx_pool_chunk_head(pool)
    while: chunk != 0
        if: chunk\mark != gen
            chunk\mark: gen
            status: lmx_gc_note(status, lmx_gc_cells(arena, pool, chunk, gen, 0))
        ---
        chunk: chunk\next
    ---
return: status

fn: lmx_gc_mark (@: LmxArena arena; @: LmxThread t) unsigned
    @: LmxMsg message
    @: LmxLink node
    unsigned: gen
    int: status
    if: arena = 0 || t = 0
        return: 0U
    gen: lmx_arena_generation_next(arena)
    if: gen = 0U
        return: 0U
    ---
    # The Message's own cells.  A cell that is not in this arena (a runtime may keep its own
    # records in its frame) marks nothing and is not an error.
    status: c.LMX_GC_OK
    message: t\message
    status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) t), gen, 0))
    status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) message), gen, 0))
    status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) t\mail), gen, 0))
    status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) t\slot), gen, 0))
    if: message != 0
        # The live graph: the one root a turn's work is all about.
        status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) message\graph), gen, 0))
    ---
    if: t\mail != 0
        # The mailbox's queue nodes are cells of one of this arena's arrays.  The queued targets
        # follow from the nodes themselves (target and next are pointer words of the kernel's
        # own domain), so a letter waiting for its receiver stays.  The OUTBOX and STAGED lanes
        # are the lanes that still hold nodes.
        status: lmx_gc_note(status, lmx_gc_mark_pool(arena, @ t\mail\nodes, gen))
        # THE INBOX RING IS STORAGE OF THIS ARENA TOO (20.09): slots hold the addresses of the
        # letters admitted and not yet taken.  Marking the block walks its words as candidate
        # addresses -- over-retention is the only error that rule can make and it is the safe
        # direction -- so a letter waiting in a live mailbox survives a collection.  Without this
        # the collection freed the mailbox's own storage (measured: `lmx_gc: the collection freed
        # the mail of a live mailbox`).
        status: lmx_gc_note(status, lmx_gc_mark_value(arena, t\mail\inbox_slots, gen, 0))
    ---
    # The parent's own chain of live direct children (lmx_thread.h.lm1, LmxLink).  Its nodes are
    # cells of THIS arena, and nothing else reaches them: a live child is found only through its
    # parent's chain, so the chain is a root for the same reason the mailbox's queue is.  The record
    # words a node carries (the child's Thread, its Message, its schedule record) come along.
    node: lmx_thread_child_link(t)
    while: node != 0
        status: lmx_gc_note(status, lmx_gc_mark_value(arena, (cast: (@: void) node), gen, 0))
        status: lmx_gc_note(status, lmx_gc_mark_value(arena, node\thread, gen, 0))
        status: lmx_gc_note(status, lmx_gc_mark_value(arena, node\message, gen, 0))
        status: lmx_gc_note(status, lmx_gc_mark_value(arena, node\slot, gen, 0))
        node: (cast: (@: LmxLink) node\next)
    ---
    if: status != c.LMX_GC_OK
        return: 0U
    ---
return: gen

# Is this block one the pass reached?  Three ways to be live: the array's own descriptor block
# (the arena's inventory -- an array lives as long as the arena), the STORAGE of a chunk the
# pass stamped, or the RECORD of such a chunk.
fn: lmx_gc_block_live (@: LmxArena arena; @: LmxArenaBlock node; unsigned: gen) int
    @: LmxPool pool
    @: LmxChunk chunk
    if: node = 0
        return: 0
    if: node\base = 0
        # A block that owns nothing has nothing to free.
        return: 1
    ---
    pool: arena\arrays
    while: pool != 0
        if: (cast: (@: void) pool) = node\base
            return: 1
        ---
        chunk: pool\head
        while: chunk != 0
            if: chunk\mark = gen && (chunk\base = node\base || (cast: (@: void) chunk) = node\base)
                return: 1
            ---
            chunk: chunk\next
        ---
        pool: pool\next
    ---
return: 0

# A block that is leaving: if it is the storage or the record of a chunk the pass did NOT
# reach, that chunk leaves its array's chain first, so the array never hands out storage that
# is about to be freed.  A block that belongs to no chunk (a descriptor, a marker) needs none.
fn: lmx_gc_block_unlink (@: LmxArena arena; @: LmxArenaBlock node; unsigned: gen) int
    @: LmxPool pool
    @: LmxChunk chunk
    pool: arena\arrays
    while: pool != 0
        chunk: pool\head
        while: chunk != 0
            if: chunk\mark != gen
                if: chunk\base = node\base || (cast: (@: void) chunk) = node\base
                    return: lmx_pool_chunk_drop(pool, chunk)
                ---
            ---
            chunk: chunk\next
        ---
        pool: pool\next
    ---
return: 1

fn: lmx_gc_block_dispose (@: LmxArenaBlock node) void
    if: node != 0
        if: node\dispose != 0
            node\dispose(node\base, node\n)
        else:
            free(node\base)
        ---
        free((cast: (@: void) node))
    ---

fn: lmx_gc_sweep (@: LmxArena arena; unsigned: gen) int
    @: LmxArenaBlock node
    @: LmxArenaBlock next
    if: arena = 0 || gen = 0U
        return: c.LMX_GC_INVALID
    node: arena\blocks
    while: node != 0
        next: node\next
        if: lmx_gc_block_live(arena, node, gen) = 0
            lmx_gc_block_unlink(arena, node, gen)
            # The interval leaves the index, the block leaves the list -- and then its storage
            # goes: lmx_arena_drop detaches, it does not free.
            lmx_arena_drop(arena, node)
            lmx_gc_block_dispose(node)
        ---
        node: next
    ---
return: c.LMX_GC_OK

fn: lmx_gc_collect (@: LmxArena arena; @: LmxThread t) int
    unsigned: gen
    if: arena = 0 || t = 0
        return: c.LMX_GC_INVALID
    # Letter-scale arenas skip the GC pass (simplified: no generation / sweep).
    if: arena\simple != 0U
        return: c.LMX_GC_OK
    ---
    # THE PERMANENT STORE IS NEVER COLLECTED -- and, unlike the old survival-as-a-root shape,
    # never VISITED either (LMX-ETERNAL-R0-44D, lmx_perm.h.lm1).  Nothing else is needed to
    # keep a collection pass off the store: its addresses are in no Message's index, so
    # lmx_gc_mark_value's existing early return (lmx_range_pool = 0, "an address this arena
    # never handed out") already answers "not mine to walk", with no per-edge cost.  This
    # short-circuit covers the other direction -- a pass asked to collect the store itself.
    if: arena\permanent != 0U
        return: c.LMX_GC_OK
    ---
    gen: lmx_gc_mark(arena, t)
    if: gen = 0U
        # The walk could not be completed: an object it never reached might be live, and a
        # partial sweep that reports success is worse than no sweep at all (model 24).
        return: c.LMX_GC_PARTIAL
    ---
    if: lmx_gc_sweep(arena, gen) != c.LMX_GC_OK
        return: c.LMX_GC_INVALID
    ---
return: c.LMX_GC_OK
