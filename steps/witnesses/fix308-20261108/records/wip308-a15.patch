-include: "<string.h>"
+predef: "l2src/lmx_ids.h.lm1"
+include: "<string.h>" "<stdio.h>" "<stdlib.h>"
+
+# IDENTIFIER-CODES (slice 308): which spellings get a code at the text boundary -- every spelling that can name
+# something or be a word the translator recognizes by its spelling: identifiers, dotted C-door names, exact
+# identifiers in backquotes, the punctuation words of the language (`[]`, `@`, `+`, ...). Not a number (a digit first),
+# not a quoted string, not an empty text; block strings and disabled text never reach this (the parser skips them).
+fn: lm_p0_text_codable (const: (@: data char); size_t: n) int
+    if: data = 0 || n = 0U
+        return: 0
+    # an exact identifier (the grammar, exact identifiers): its value is the content between the backticks
+    if: n >= 3U && data[0] = 96 && data[n - 1U] = 96
+        return: 1
+    if: (data[0] >= 48 && data[0] <= 57) || data[0] = 34 || data[0] = 39
+        return: 0
+    return: 1
+end: lm_p0_text_codable
+
+# The code of a spelling from the one name -> code table of the process (lmx_ids), 0 for a text that gets none. The
+# only place the translator turns bytes into a code: the parser calls it for every atom and head it builds, the
+# frontend for every text it constructs from a source slice or a spelling of its own.
+fn: lm_p0_text_code (const: (@: data char); size_t: n) size_t
+    size_t: code 0U
+    if: lm_p0_text_codable(data, n) = 0
+        return: 0U
+    # an exact identifier and its bare spelling are one name: the code is the value's (the grammar, exact identifiers;
+    # the kernel registers the walker's names the same way, slice 303)
+    if: n >= 3U && data[0] = 96 && data[n - 1U] = 96
+        code: c.lmx_ids_code(data + 1U, n - 2U)
+    else:
+        code: c.lmx_ids_code(data, n)
+    ---
+    if: code = 0U
+        c.fprintf(c.stderr, "l2trans: invariant: the identifier service gave no code to a spelling: %.*s (ids %zu)\n", (cast: (int) n), data, c.lmx_ids_count())
+        c.exit(3)
+    return: code
+end: lm_p0_text_code
 
