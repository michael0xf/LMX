    ---
    return: frame
end: lm_p0_dump_frame_new

# Original: parser.lm1:4580 lm_p0_dump_push_frame
fn: lm_p0_dump_push_frame (@: stack c.LmOwnPtrStack; @: frame c.LmP0DumpFrame) int
    if: ((stack = 0) || (frame = 0))
        c.lm_own_delete(frame, 0)
        return: 1
    if: (c.lm_own_ptr_stack_push(stack, frame) != 0)
        c.lm_own_delete(frame, 0)
        return: 1
    return: 0
end: lm_p0_dump_push_frame

# Original: parser.lm1:4590 lm_p0_dump_push_node
fn: lm_p0_dump_push_node (@: stack c.LmOwnPtrStack; const: (@: p0_node c.LmP0Node); size_t: indent) int
    @: frame c.LmP0DumpFrame
    if: (p0_node = 0)
