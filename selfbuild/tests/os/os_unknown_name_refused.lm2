# The selected branch names a method that is declared nowhere: the ordinary unknown-name refusal of its body (the
# same in an unselected branch is never read: os_unselected_invalid.lm2).
os:
    win:
        fn: os_one () int
            return: os_helper()
        end: os_one
    default:
        fn: os_one () int
            return: 1
        end: os_one
end: os
sendMessage: exit(exit_code: os_one(); stdout: ""; stderr: "")
return
