# The index of a Structure (the book, structure-index): `S[i]` reads what slot i holds -- an untyped reference to the
# cell of an int field, to the pointer of a field without a value, to a nested Structure --, `S[i] := p` gives the slot
# another address after the field's admission, `length(S)` is the number of the fields.
int: j 40
S:
    int: a 1
    int: u
    N:
        int: x 7
    end: N
end: S
int: n length(S)
int: t_cell getType(S[0])
int: t_uninit getType(S[1])
int: t_nested getType(S[2])
@: p int S[0]
int: v_first \p
S\a := 5
int: v_same \p
int: x_nested S[2]\x
int: n_nested length(S[2])
int: k 1
int: t_computed getType(S[k + 1])
fn: kind_of (int: i) int
    return: getType(S[i])
end: kind_of
int: t_method kind_of(2)
S[0] := @j
@: q int S[0]
