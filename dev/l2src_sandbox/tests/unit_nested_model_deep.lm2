Outer:
    int: pad 17
    Middle:
        int: prefix 29
        Inner:
            int: x 11
        end: Inner
        @: Inner ref
    end: Middle
end: Outer
Inner:
    int: y 99
end: Inner
fn: read () int
    return: Outer\Middle\ref\x
end: read
Outer\Middle\ref: Outer\Middle\Inner
Outer\Middle\ref\x: 13
int: ok 7
if: read() != 13 || Outer\Middle\Inner\x != 13 || Inner\y != 99
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
