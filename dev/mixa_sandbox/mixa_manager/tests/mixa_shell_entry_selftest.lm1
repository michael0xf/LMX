predef: "mixa_manager/mixa_selection.lm1"
predef: "mixa_manager/mixa_dir_win32.lm1"
predef: "mixa_manager/mixa_fileio_win32.lm1"
predef: "mixa_manager/mixa_file_manager.lm1"
predef: "mixa_manager/mixa_event_fifo.lm1"
predef: "mixa_manager/mixa_pump.lm1"
predef: "mixa_manager/mixa_backend_headless.lm1"
predef: "mixa_manager/mixa_backend_table.lm1"
predef: "mixa_manager/mixa_shell_main.lm1"
include: "<stdio.h>" "<string.h>" "<stdlib.h>"

# One entry. native is the headless table. start lists a real directory.
# One turn returns no events. The backend table is not walked as mail.

fn: mixa_backend_ctors_count () size_t
return: 1U

fn: mixa_backend_ctors_get (size_t: i) const: @(MixaBackendVTable)
    if: i = 0U
        return: mixa_backend_headless_table()
    ---
return: 0

int: g_alloc_live

fn: t_alloc (size_t: n) @: void
    @: void p
    p: c.malloc(n)
    if: p != 0
        g_alloc_live: g_alloc_live + 1
    ---
return: p

sub: t_free (@: void p)
    if: p = 0
        return
    ---
    g_alloc_live: g_alloc_live - 1
    c.free(p)
end: t_free

fn: main (int: argc; @: @(char) argv) int
    []: char base 520
    []: char root 1040
    []: char file 1200
    []: char cmd 2400
    []: (@: void) fh 1
    @: MixaCellMetrics metrics
    @: MixaFmAllocVTable av
    @: MixaShellHost host
    MixaFm: fm
    @: MixaFmEntry rows
    size_t: count
    int: events
    int: checks
    int: failures
    int: rc
    checks: 0
    failures: 0
    g_alloc_live: 0
    rows: 0
    count: 0U
    events: -1
    if: argc >= 2
        c.snprintf(base, 520U, "%s", argv[1])
    ---
    if: argc < 2
        c.snprintf(base, 520U, "build/mixa/tmp_shell_entry")
    ---
    c.snprintf(cmd, 2400U, "cmd /c rmdir /s /q \"%s\" 2>nul & mkdir \"%s\" 2>nul", base, base)
    c.system(cmd)
    c.snprintf(root, 1040U, "%s\\root", base)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", root)
    c.system(cmd)
    c.snprintf(file, 1200U, "%s\\a.txt", root)
    fh[0]: c.fopen(file, "wb")
    if: fh[0] != 0
        c.fputs("x", fh[0])
        c.fclose(fh[0])
    ---
    metrics: (cast: (@: MixaCellMetrics) c.calloc(1U, c.sizeof(c.MixaCellMetrics)))
    metrics\text_cell_width: 8U
    metrics\text_cell_height: 8U
    metrics\upper_cell_width: 8U
    metrics\upper_cell_height: 8U
    metrics\pointer_cell_width: 8U
    metrics\pointer_cell_height: 8U
    av: (cast: (@: MixaFmAllocVTable) c.calloc(1U, c.sizeof(c.MixaFmAllocVTable)))
    av\alloc: t_alloc
    av\free: t_free
    rc: mixa_fm_init(@ fm, root, 0, av)
    checks: checks + 1
    if: rc != MIXA_FM_OK
        failures: failures + 1
        c.printf("shell-entry: init %d\n", rc)
    ---
    host: (cast: (@: MixaShellHost) c.calloc(1U, c.sizeof(c.MixaShellHost)))
    rc: mixa_shell_run(host, metrics, @ fm, root, @ rows, @ count, @ events)
    checks: checks + 1
    if: rc != 0 || events != 0 || rows = 0 || count = 0U || mixa_fm_count(@ fm) != 0U
        failures: failures + 1
        c.printf("shell-entry: run %d events %d\n", rc, events)
    ---
    checks: checks + 1
    if: host\native = 0 || host\native != mixa_backend_headless_table()
        failures: failures + 1
        c.printf("shell-entry: native is not the headless table\n")
    ---
    checks: checks + 1
    if: host\backend != 0
        failures: failures + 1
        c.printf("shell-entry: backend left open\n")
    ---
    mixa_shell_files_release(@ fm, rows, count)
    mixa_fm_release(@ fm)
    c.free(host)
    c.free(av)
    c.free(metrics)
    checks: checks + 1
    if: g_alloc_live != 0
        failures: failures + 1
        c.printf("shell-entry: %d allocations still live\n", g_alloc_live)
    ---
    c.printf("shell-entry: %d checks, %d failures\n", checks, failures)
    if: failures != 0
        return: 1
    ---
return: 0
