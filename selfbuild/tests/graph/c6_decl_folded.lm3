# Witness c6_decl_folded -- f(int: a 5) with f(int: a) and f(u8: a): the folded declaration gives the int pair:
# r 5, seen 0 (tick is not called)
# Norm: fable R102/R103; step C6 (PLAN §17)
(
    Observed:
        int: seen 0
        int: r 0
)
@: shared data[0]
fn: tick () int
    shared\Observed\seen := shared\Observed\seen + 1
    return: 3
fn: f (int: a) int
    shared\Observed\r := a
    return: a
fn: f (u8: a) int
    return: 2
sub: main ()
    f(int: a 5)
main()
