    Lists:
        @: l0 (("ifndef H_PNETCDF";"ifndef _NETCDF_");("Function-like macro has no independent C symbol; role: runtime_operation.";"Parallel-netCDF CDF-1/CDF-2/netCDF-5(CDF-5) calls require the same MPI ABI at build and runtime. Collective ordering, file mode, MPI_Offset/count width and outstanding request buffer lifetime need explicit owner-side admission.");("LMX::pnetcdf");("ifndef H_PNETCDF");("Parallel-netCDF CDF-1/CDF-2/netCDF-5(CDF-5) calls require the same MPI ABI at build and runtime. Collective ordering, file mode, MPI_Offset/count width and outstanding request buffer lifetime need explicit owner-side admission.";"C integer file/group IDs are owner-bound resources at the LMX boundary. Validate child variable/dimension/type IDs against that file/group; do not expose a process-global ncid as an unrestricted scalar capability."))
