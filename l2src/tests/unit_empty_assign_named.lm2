# A declared named Structure binds an ordinary Structure as well: `S()` assigns the empty
# Structure to S with admission to S's own type, which () (no v) does not pass -- implements,
# caught (7); S keeps v 4U: 74.
S:
    size_t: v 4U
end: S

int: r 0
S()
catch: implements ()
    r: 7
if: S\v = 4U
    r: r * 10 + 4
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
