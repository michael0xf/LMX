# A method defines a Structure, copies it and calls the copy. The body the
# copy holds is proved through the declaration: a whole copy of the row that
# defines A in the same method. Entry 7.
fn: g () int
    A:
        int: last 0
        last: 17
    x: merge A
    x
    return: x\last
int: k g()
int: result 81
if: k = 17
    result: 7
sendMessage: exit(exit_code: result; stdout: ""; stderr: "")
return
