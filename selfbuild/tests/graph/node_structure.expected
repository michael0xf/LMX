---
    Observed:
        int: seen 5
    end: Observed
---
sub: main () (
    int: hits 4
    Bump: (:= (node \ hits) (hits + 1))
)
    call: Bump
end: main
main:
int: seen ((main \ data) \ hits)
sub: observe ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) seen
end: observe
observe:
