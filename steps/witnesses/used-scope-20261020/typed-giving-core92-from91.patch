+    int: source_owned 0
+    int: found 0
+    int: owns 0
+    int: answer c.LMX_IMPLEMENTS_YES
+    if: applied = 0 || bridge = 0 || out = 0 || resolver = 0 || lmx_graph_node_in(arena, (cast: (@: void) source)) = 0
+        return: c.LMX_IMPLEMENTS_UNKNOWN
+    \applied: 0
+    memset((cast: (@: void) out), 0, c.sizeof(c.LmxImplEntry))
+    memset((cast: (@: void) bridge), 0, c.sizeof(c.LmxImplEntry))
+    source_layout: lmx_implements_layout(arena, source)
+    required_layout: lmx_implements_layout(arena, req)
+    stored: lmx_implements_find(arena, value, source)
+    if: stored != 0
+        answer: lmx_implements_rebase_view(arena, stored, (source\array.size), @ normalized, @ source_owned)
+        if: answer != c.LMX_IMPLEMENTS_YES
+            return: answer
+        ---
+    else:
+        if: value != source && (source_layout = 0 || source_layout != lmx_implements_layout(arena, value))
+            return: c.LMX_IMPLEMENTS_YES
+        memset((cast: (@: void) (@ normalized)), 0, c.sizeof(c.LmxImplEntry))
+        normalized.value: value
+        normalized.req: source
+        normalized.n: source\array.size
+    ---
+    while: i < resolver\template_count || (i = 0U && source = req)
+        memset((cast: (@: void) (@ pair)), 0, c.sizeof(c.LmxImplEntry))
+        pair.value: source
+        pair.req: req
+        pair.n: width
+        if: source != req
