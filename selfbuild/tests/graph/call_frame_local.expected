---
    Counter:
        int: calls 5
    end: Counter
    Observed:
        int: ordinary 8
        int: once 12
        int: unused 42
        int: local_result 21
        int: local_source 10
        int: snapshot_result 10
        int: snapshot_source 99
        int: supplied 10
        int: lazy 12
        int: own 5
        int: separate 2
        int: explicit 8
        int: count 5
        int: original 1
    end: Observed
---
@: shared (data [] 0)
fn: bump () int
    :=: ((shared \ Counter) \ calls) (((shared \ Counter) \ calls) + 1)
    return: 9
end: bump
fn: f (int: a) int (
    int: b 2
)
    int: t (a + b)
    :=: t (t + 1)
    return: t
end: f
fn: ignore (int: a) int
    return: 42
end: ignore
fn: local () int (
    int: x 10
)
    :=: x 21
    return: x
end: local
fn: snapshot () int (
    int: x 10
)
    :=: (data \ x) 99
    return: x
end: snapshot
sub: main () (
    D:
        int: a 1
    end: D
    A:
        int: a 7
    end: A
    Add:
        return: (a + 1)
    end: Add
    Self:
        int: n 3
        :=: n (n + 2)
        return: n
    end: Self
    Step:
        int: t 3
        :=: t (t + 1)
        :=: ((shared \ Counter) \ calls) (((shared \ Counter) \ calls) + 1)
    end: Step
)
    :=: ((shared \ Observed) \ ordinary) (f 5)
    :=: ((shared \ Observed) \ once) (f (bump))
    :=: ((shared \ Observed) \ unused) (ignore)
    :=: ((shared \ Observed) \ local_result) (local)
    :=: ((shared \ Observed) \ local_source) ((local \ data) \ x)
    :=: ((shared \ Observed) \ snapshot_result) (snapshot)
    :=: ((shared \ Observed) \ snapshot_source) ((snapshot \ data) \ x)
    :=: ((shared \ Observed) \ supplied) (fncall A (f \ data) int (f \ code))
    :=: ((shared \ Observed) \ lazy) (fncall (f \ data) int (f \ code))
    :=: ((shared \ Observed) \ own) (fncall int Self)
    :=: ((shared \ Observed) \ separate) (fncall D int Add)
    :=: ((shared \ Observed) \ explicit) (fncall A D int Add)
    call: Step
    call: D Step
    call: A D Step
    :=: ((shared \ Observed) \ count) ((shared \ Counter) \ calls)
    :=: ((shared \ Observed) \ original) (D \ a)
end: main
main:
