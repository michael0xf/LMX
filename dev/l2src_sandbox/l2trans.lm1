        # name's value as it reads just before the line -- the argument, or an enclosing bound field.
        if: l2_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && oi >= 0 && l2_count_active(stmt\as\frame\body) = 1 && l2_m_uses[l2_own_off(mi, oi)] != 0 && l2_own_direct(mi, oi) != 0 && l2_own_formal(mi, oi) >= 0
            if: l2_tok_formal(mi, l2_own_formal(mi, oi), l2_tok) != 0 || l2_own_store(mi, oi, ind, l2_tok) != 0
                return: 1
        ---
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt)
            field: l2_next_active(field\next)
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && (stmt = 0 || stmt\as = 0 || stmt\as\frame = 0)
            return: 1
