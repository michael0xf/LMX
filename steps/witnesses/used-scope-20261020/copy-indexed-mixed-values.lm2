# Positive7: the same producer handles reference->index->reference->index,
# retaining each reordered contract. Neither effectful index may run again.
E: (int: w 7; int: v 9)
Wide: (int: v 9; int: extra 19; int: w 7)
Holder: ([]: (@: E) values 1; int: marker 23)
WideHolder: (int: extra 31; int: marker 23; []: (@: E) values 1)
Root: (int: pad 29; @: ref Holder)
WideRoot: (@: ref Holder; int: extra 37; int: pad 29)
Counter: (int: calls 0)
fn: pick () size_t
    Counter\calls: Counter\calls + 1
    return: 0U
end: pick
fn: check () int
    WideHolder\values[0]: Wide
    WideRoot\ref: WideHolder
    []: (@: Root) roots 1
    roots[0]: WideRoot
    copy: merge(roots[pick()]\ref\values[pick()])
    if: Counter\calls != 2 || copy\v != 9 || copy\w != 7
        return: 81
    copy\v: 41
    @: cell int @copy\v
    \cell: 43
    if: Counter\calls != 2 || copy\v != 43 || copy\w != 7
        return: 82
    if: roots[0]\ref\values[0]\v != 9 || roots[0]\ref\values[0]\w != 7
        return: 83
    if: Wide\extra != 19 || WideHolder\extra != 31 || WideRoot\extra != 37
        return: 84
    return: 7
end: check
sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
