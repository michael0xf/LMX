# Witness c6_no_effect_ambiguous -- f(tick()) with two admitted signatures: refusal 3, seen 0
# Norm: fable R102 (выбор ничего не исполняет; автор 2026-11-07 «Имена и форму вызова проверять до вычисления
# аргументов»; книга #named-actuals «Вызываемое выбирается один раз, до аргументов»)
(
    Observed:
        int: seen 0
        int: r 0
)
@: shared data[0]
fn: tick () int
    shared\Observed\seen := shared\Observed\seen + 1
    return: 3
fn: f (int: a) int
    shared\Observed\r := a
    return: a
fn: f (int: a; int: b) int
    shared\Observed\r := a * 10 + b
    return: a
sub: main ()
    f(tick())
main()
