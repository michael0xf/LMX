predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_pool.h.lm1"
predef: "l2src/lmx_primitive.h.lm1"
predef: "lmx_arena_blocks.lm1"
predef: "lmx_range.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdlib.h>"

# The manager of the arena. Lingvamyxa_spec.txt 2, 6.5; Mikhail, 2026-09-17: "У нас есть
# арена (там менеджер)".
#
# It is the only writer of the index (through lmx_range_add / lmx_range_drop), the only
# holder of the arena's arrays (the descriptors linked through LmxPool.next) and the only
# owner of the arena's storage (the block list of lmx_arena_blocks).  Ownership and typing
# move together: a block's storage IS the interval it registered, so a block never leaves
# the list with its entry still in the index, and no entry ever names storage no arena
# holds -- and every array the list holds is live as well, because the block that carries
# an array's descriptor record goes with the array (lmx_arena_drop takes the array off
# the list as that block leaves).
#
# A by-value arena must be cleared before it is opened; opening a non-empty one is
# refused, exactly as a pool refuses to be opened twice.


fn: lmx_arena_index_data (@: LmxArena arena) @: LmxRange
    @: LmxRangeDynamicArray da
    @: LmxRangeArray base
    if: arena = 0
        return: 0
    da: @ arena\index
    base: (cast: (@: LmxRangeArray) da)
return: base\data

fn: lmx_arena_index_len (@: LmxArena arena) size_t
    @: LmxRangeDynamicArray da
    @: LmxRangeArray base
    if: arena = 0
        return: 0U
    da: @ arena\index
    base: (cast: (@: LmxRangeArray) da)
return: base\len

fn: lmx_arena_index_cap (@: LmxArena arena) size_t
    @: LmxRangeDynamicArray da
    if: arena = 0
        return: 0U
    da: @ arena\index
return: da\capacity

fn: lmx_arena_index_set_data (@: LmxArena arena; @: LmxRange data) void
    @: LmxRangeDynamicArray da
    @: LmxRangeArray base
    if: arena = 0
        return
    da: @ arena\index
    base: (cast: (@: LmxRangeArray) da)
    base\data: data
return

fn: lmx_arena_index_set_len (@: LmxArena arena; size_t: len) void
    @: LmxRangeDynamicArray da
    @: LmxRangeArray base
    if: arena = 0
        return
    da: @ arena\index
    base: (cast: (@: LmxRangeArray) da)
    base\len: len
return

fn: lmx_arena_index_set_cap (@: LmxArena arena; size_t: capacity) void
    @: LmxRangeDynamicArray da
    if: arena = 0
        return
    da: @ arena\index
    da\capacity: capacity
return

fn: lmx_arena_open (@: LmxArena arena) int
    if: arena = 0
        return: 1
    if: arena\blocks != 0 || arena\arrays != 0 || lmx_arena_index_data(arena) != 0
        return: 1
    ---
    if: lmx_arena_index_len(arena) != 0U || lmx_arena_index_cap(arena) != 0U
        return: 1
    ---
    if: arena\impl != 0 || arena\impl_len != 0U || arena\impl_cap != 0U
        return: 1
    ---
    arena\generation: 0U
    arena\simple: 0U
    arena\source_view: 0U
return: 0

# This arena is a disposable read-only classification union for graph copy.
# Unlike a live Message arena it can inspect unsealed foreign lexical context;
# no allocation or ownership transfer may target it.
fn: lmx_arena_open_source_view (@: LmxArena arena) int
    if: lmx_arena_open(arena) != 0
        return: 1
    ---
    arena\source_view: 1U
return: 0

# Letter-scale arena: open, mark simple, pre-reserve a small fixed index so a
# short letter does not pay full GC / unbounded growth. The address->descriptor
# index, array descriptors and address stability are the same acts as a full arena.
fn: lmx_arena_open_simple (@: LmxArena arena) int
    if: lmx_arena_open(arena) != 0
        return: 1
    ---
    arena\simple: 1U
    # Eight intervals cover a typical letter (Message + a few arrays); further
    # growth is still allowed up to a small cap in lmx_range_reserve for simple.
    if: lmx_range_reserve(arena, 8U) != 0
        arena\simple: 0U
        return: 1
    ---
return: 0

# The arena's ordinary array of this kind and type, or null when it has none yet.
# Pointer-domain cells have physical access contracts: this lookup selects only
# the canonical void * representation, never a typed T * pool with the same
# unit-local numeric type.
fn: lmx_arena_find (@: LmxArena arena; int: kind; int: type) @: LmxPool
return: lmx_arena_find_profiled(arena, kind, type, 0)

fn: lmx_arena_find_profiled (@: LmxArena arena; int: kind; int: type; @: Lmx profile) @: LmxPool
    @: LmxPool pool
    if: arena = 0
        return: 0
    pool: arena\arrays
    while: pool != 0
        if: pool\kind = kind && pool\type = type && pool\profile = profile && (kind != c.LMX_KIND_PRIMITIVE || type < c.LMX_TYPE_POINTER_BASE || type >= c.LMX_TYPE_ARRAY_OF_POINTER_BASE || (pool\stride = c.sizeof(@: void) && pool\pointer_read = lmx_arena_pointer_void_read && pool\pointer_write = lmx_arena_pointer_void_write))
            return: pool
        ---
        pool: pool\next
    ---
return: 0

# An array joins the arena: its descriptor is linked into the arena's list of its N arrays,
# and the block that carries the descriptor -- when the array has one of its own -- joins
# the arena's block list, so the arena owns what describes it.  The descriptor is in no
# list: lmx_pool_make_profiled has just made it, lmx_pool_open_profiled takes only an
# array with no chunk (one never opened, or released, which unlinks it), and the sweep
# unlinks every array of a block it frees (D-43).  Constant time: the list is not walked.
fn: lmx_arena_array (@: LmxArena arena; @: LmxPool array; @: LmxArenaBlock record) int
    if: arena = 0 || array = 0 || arena\source_view != 0U
        return: 1
    if: record != 0
        if: lmx_arena_blocks_push(@ arena\blocks, record) != c.LMX_ARENA_BLOCKS_OK
            return: 1
        ---
    ---
    array\next: arena\arrays
    arena\arrays: array
return: 0

# An array leaves the arena's list: it is no longer one of the arena's N arrays.  Its
# intervals are retired one by one by the caller (a chunk at a time), because only the
# caller knows which chunk is going.
fn: lmx_arena_array_drop (@: LmxArena arena; @: LmxPool array) int
    @@: LmxPool slot
    @: LmxPool pool
    if: arena = 0 || array = 0
        return: 1
    slot: @ arena\arrays
    pool: \slot
    while: pool != 0
        if: pool = array
            \slot: pool\next
            pool\next: 0
            return: 0
        ---
        slot: @ pool\next
        pool: \slot
    ---
return: 1

# One interval [base, base + bytes) of one array joins the arena's index.  This is the
# insertion into the table -- the manager's act, and the only one.
fn: lmx_arena_span (@: LmxArena arena; @: LmxPool array; @: void base; size_t: bytes) int
    if: arena = 0 || array = 0 || base = 0 || bytes = 0U || arena\source_view != 0U
        return: 1
    if: bytes % array\stride != 0U
        return: 1
    ---
return: lmx_range_add(arena, array, base, (cast: (@: void) ((cast: (@: char) base) + bytes)))

# One block leaves the arena: its interval leaves the index FIRST, then the block leaves
# the list.  The interval is exactly [base, base + n), because a block of the arena holds
# the very storage it registered; a block that registered nothing (the record carrying an
# array's descriptor) drops as a miss and nothing else happens.
#
# The block that CARRIES a descriptor goes with its array: as the block leaves, the array
# it describes leaves the arena's list of its N arrays too, so the arena never keeps a
# descriptor whose record it has given up -- whether the block is dropped by a revert or
# by a release.  Every other block drops as a MISS on that walk: a payload block's base is
# storage and not a descriptor, and the walk only compares addresses (it never
# dereferences what it compares), so a block that carries no descriptor leaves exactly as
# it did before.  A miss is not a failure here: the block's own removal is what this call
# reports, and that is the same answer either way.
fn: lmx_arena_drop (@: LmxArena arena; @: LmxArenaBlock node) int
    if: arena = 0 || node = 0
        return: 1
    lmx_arena_array_drop(arena, (cast: (@: LmxPool) node\base))
    if: node\base != 0 && node\n != 0U
        lmx_range_drop(arena, node\base, (cast: (@: void) ((cast: (@: char) node\base) + node\n)))
    ---
return: lmx_arena_blocks_remove(@ arena\blocks, node)

# A restore point: the arena's block list as it stands now.  The list is a stack, so the
# mark is simply its head.
fn: lmx_arena_mark (@: LmxArena arena) @: LmxArenaBlock
    if: arena = 0
        return: 0
    ---
return: arena\blocks

# Drop every block added since the mark, retiring each one's interval first.  Blocks the
# arena already held before the mark are untouched, so a construction that fails leaves
# no half-made array behind and disturbs nothing that was already there -- "the whole, or
# nothing", exactly as merge and graph copy require.
fn: lmx_arena_revert (@: LmxArena arena; @: LmxArenaBlock mark) int
    if: arena = 0
        return: 1
    while: arena\blocks != 0 && arena\blocks != mark
        lmx_arena_drop(arena, arena\blocks)
    ---
    # D-105: a correspondence of a value the revert took back leaves with it.
    lmx_arena_impl_prune(arena)
return: 0

# A cell of the arena's ordinary array of this kind and type.  The array is the arena's own: it is
# found among the arena's N arrays, or MADE when the arena has none of that kind and type
# yet.  So a mutable value is an element of the big array of its type (Mikhail,
# 2026-09-17: "N массивов где лежат дескрипторы или примитивные значения") and never an
# array of its own -- which is what keeps the index one line per array instead of one per
# value.
fn: lmx_arena_take_n (@: LmxArena arena; size_t: stride; int: kind; int: type; size_t: count) @: void
return: lmx_arena_take_n_profiled(arena, stride, kind, type, 0, count)

fn: lmx_arena_take_n_profiled (@: LmxArena arena; size_t: stride; int: kind; int: type; @: Lmx profile; size_t: count) @: void
    @: LmxPool array
    if: arena = 0 || stride = 0U || count = 0U || arena\source_view != 0U
        return: 0
    if: profile != 0 && lmx_range_classify(arena, (cast: (@: void) profile)) != c.LMX_KIND_STRUCT
        return: 0
    if: count > ((cast: (size_t) -1) / stride)
        return: 0
    ---
    # A generic request for a pointer-domain cell is physically a void * cell.
    # Typed T * cells have their own access contract and may share only the
    # numeric type, not the C representation. Both routes use the same
    # full physical pool selection below.
    if: kind = c.LMX_KIND_PRIMITIVE && type >= c.LMX_TYPE_POINTER_BASE && type < c.LMX_TYPE_ARRAY_OF_POINTER_BASE
        if: stride != c.sizeof(@: void)
            return: 0
        ---
        return: lmx_arena_pointer_cells_profiled(arena, type, profile, stride, lmx_arena_pointer_void_read, lmx_arena_pointer_void_write, count)
    ---
    array: lmx_arena_find_profiled(arena, kind, type, profile)
    if: array = 0
        # The first request of that kind and type creates the array with exactly the room
        # it asks for; every later request of the same kind and type is seated there.
        array: lmx_pool_make_profiled(arena, count * stride, stride, kind, type, profile)
        if: array = 0
            return: 0
        ---
        return: (cast: (@: void) lmx_chunk_data(array\head))
    ---
    if: array\stride != stride
        return: 0
    ---
return: lmx_pool_take_n(arena, array, count)

fn: lmx_arena_take (@: LmxArena arena; size_t: stride; int: kind; int: type) @: void
return: lmx_arena_take_n(arena, stride, kind, type, 1U)

# Seal every array of this arena that carries the exact nonzero profile -- a qualified branch's own pools -- so
# no cell of them is handed out again (lmx_pool_take_n refuses a sealed array); the index and every address are
# unchanged, and arrays of any other profile, the unprofiled ones included, are untouched.  The prologue of a
# generated program seals a static branch this way through the index; a value qualified at run time (RR2a,
# steps/qualifier-receivers-20261010.md) seals here, after lmx_qualify_tree_preflight_full and before publication.
# 0 when at least one array carried the profile; 1 for a null arena or profile, or when no array carries it.
fn: lmx_arena_seal_profile (@: LmxArena arena; @: Lmx profile) int
    @: LmxPool pool
    int: found 0
    if: arena = 0 || profile = 0
        return: 1
    pool: arena\arrays
    while: pool != 0
        if: pool\profile = profile
            if: lmx_pool_seal(pool) != 0
                return: 1
            found: 1
        ---
        pool: pool\next
    ---
    if: found = 0
        return: 1
return: 0

fn: lmx_arena_take_profiled (@: LmxArena arena; size_t: stride; int: kind; int: type; @: Lmx profile) @: void
return: lmx_arena_take_n_profiled(arena, stride, kind, type, profile, 1U)

fn: lmx_arena_pointer_void_read (@: void cell) @: void
    @@: void p
    if: cell = 0
        return: 0
    p: (cast: (@@: void) cell)
return: \p

fn: lmx_arena_pointer_void_write (@: void cell; @: void value) int
    @@: void p
    if: cell = 0
        return: 1
    p: (cast: (@@: void) cell)
    \p: value
return: 0

fn: lmx_arena_pointer_cells_profiled (@: LmxArena arena; int: type; @: Lmx profile; size_t: stride; LmxPointerCellRead: read; LmxPointerCellWrite: write; size_t: count) @: void
    @: LmxPool pool
    @: void cell
    size_t: i 0U
    if: arena = 0 || arena\source_view != 0U || type < c.LMX_TYPE_POINTER_BASE || type >= c.LMX_TYPE_ARRAY_OF_POINTER_BASE || stride = 0U || read = 0 || write = 0 || count = 0U || count > ((cast: (size_t) -1) / stride)
        return: 0
    if: profile != 0 && lmx_range_classify(arena, (cast: (@: void) profile)) != c.LMX_KIND_STRUCT
        return: 0
    ---
    # The numeric type is unit-local. Two C99 pointer types (or two distinct
    # access contracts) may use the same number in one arena after import.
    # Keep their cells in separate arrays; the address index identifies the
    # physical pool for every later read, copy, walk and collection.
    pool: arena\arrays
    while: pool != 0
        if: pool\kind = c.LMX_KIND_PRIMITIVE && pool\type = type && pool\profile = profile && pool\stride = stride && pool\pointer_read = read && pool\pointer_write = write
            break
        ---
        pool: pool\next
    ---
    if: pool = 0
        pool: lmx_pool_make_profiled(arena, count * stride, stride, c.LMX_KIND_PRIMITIVE, type, profile)
        if: pool = 0
            return: 0
        ---
        cell: (cast: (@: void) lmx_chunk_data(pool\head))
        pool\pointer_read: read
        pool\pointer_write: write
    else:
        cell: lmx_pool_take_n(arena, pool, count)
        if: cell = 0
            return: 0
        ---
    ---
    while: i < count
        if: write((cast: (@: void) ((cast: (@: char) cell) + i * stride)), 0) != 0
            return: 0
        i: i + 1U
    ---
return: cell

# An arena-local primitive owner is the arena object, not a cell in one of its
# arrays. Attaching the arrays transfers that ownership too. This is a
# representation fixup after a successful transfer, not a graph edge or a
# reason to copy the primitive's signature/subject.
sub: lmx_arena_rehome_primitive_owners (@: LmxArena arena; @: LmxArena other)
    @: LmxPool pool other\arrays
    @: LmxChunk chunk
    @: LmxPrimitive records
    @: LmxPrimitive record
    size_t: i
    size_t: n
    while: pool != 0
        if: pool\kind = c.LMX_DOMAIN_KIND_PRIMITIVE && pool\type = c.LMX_DOMAIN_PRIMITIVE && pool\stride = c.sizeof(c.LmxPrimitive)
            chunk: lmx_pool_chunk_head(pool)
            while: chunk != 0
                records: (cast: (@: LmxPrimitive) lmx_chunk_data(chunk))
                n: lmx_chunk_cells(chunk, pool\stride)
                i: 0U
                while: i < n
                    record: records + i
                    if: record\owner = (cast: (@: Lmx) other)
                        record\owner: (cast: (@: Lmx) arena)
                    ---
                    i: i + 1U
                ---
                chunk: chunk\next
            ---
        ---
        pool: pool\next
    ---
end: lmx_arena_rehome_primitive_owners

# Another arena attaches to this one.  The whole act is "increase the number of arrays and
# do not worry about the addresses": the attached arena's intervals join this index (their
# addresses are unchanged, so every entry still names the very same interval and the very
# same descriptor -- only the table that holds it changes), its arrays join this arena's
# list of its N arrays, and its blocks join this arena's block list, so ONE arena owns
# both and after this call the attached arena is empty.  Nothing is copied and nothing
# moves, which is what attaching exists for.  A refusal part-way takes back exactly the
# entries this call added and disturbs nothing else.
fn: lmx_arena_attach (@: LmxArena arena; @: LmxArena other) int
    @: LmxRange entry
    @: LmxRange present
    @: LmxRange inserted 0
    @: LmxPool pool
    @: LmxPool next
    @: LmxArena new_owner
    size_t: index 0U
    size_t: scan 0U
    size_t: needed 0U
    size_t: added 0U
    int: exact 0
    if: arena = 0 || other = 0 || arena\source_view != 0U || other\source_view != 0U
        return: 1
    if: arena = other
        return: 1
    if: lmx_arena_index_len(other) = 0U && other\arrays = 0 && other\blocks = 0
        return: 0
    ---
    # The final ownership-list splice is fallible on malformed/intersecting lists. Preflight it
    # before adding one range, relinking one Array or clearing one donor field; after this succeeds
    # the same owner-exclusive lists cannot change until the final constant-time splice.
    if: lmx_arena_blocks_can_move(@ arena\blocks, @ other\blocks) != c.LMX_ARENA_BLOCKS_OK
        return: 1
    ---
    # D-105: the donor's `implements` correspondences name its values, whose addresses do not
    # change -- they join this arena's table.  Room first, so a refusal disturbs nothing.
    if: other\impl_len != 0U && lmx_arena_impl_room(arena, arena\impl_len + other\impl_len) != 0
        return: 1
    ---
    # The index is sorted by address, not insertion order. Validate all of
    # the donor's intervals and reserve their room before changing one row;
    # length alone cannot identify which rows an attempted attach inserted.
    index: 0U
    while: index < lmx_arena_index_len(other)
        entry: lmx_arena_index_data(other) + index
        if: entry\array = 0 || entry\owner = 0 || entry\lo = 0 || entry\hi <= entry\lo
            return: 1
        ---
        new_owner: entry\owner
        if: new_owner = other
            new_owner: arena
        ---
        if: new_owner != arena && entry\array\sealed = 0U
            return: 1
        ---
        exact: 0
        scan: 0U
        while: scan < lmx_arena_index_len(arena)
            present: lmx_arena_index_data(arena) + scan
            if: entry\lo < present\hi && entry\hi > present\lo
                if: entry\lo = present\lo && entry\hi = present\hi && entry\array = present\array && new_owner = present\owner
                    exact: 1
                else:
                    return: 1
                ---
                break
            ---
            scan: scan + 1U
        ---
        if: exact = 0
            if: needed = (cast: (size_t) -1)
                return: 1
            ---
            needed: needed + 1U
        ---
        index: index + 1U
    ---
    if: needed > (cast: (size_t) -1) - lmx_arena_index_len(arena) || needed > (cast: (size_t) -1) / c.sizeof(c.LmxRange)
        return: 1
    ---
    if: needed != 0U
        inserted: (cast: (@: LmxRange) calloc(needed, c.sizeof(c.LmxRange)))
        if: inserted = 0 || lmx_range_reserve(arena, lmx_arena_index_len(arena) + needed) != 0
            free((cast: (@: void) inserted))
            return: 1
        ---
    ---
    index: 0U
    while: index < lmx_arena_index_len(other)
        entry: lmx_arena_index_data(other) + index
        # Ownership of local arrays transfers; borrowed views keep their
        # original owner. Exact pre-existing destination rows are untouched.
        new_owner: entry\owner
        if: new_owner = other
            new_owner: arena
        ---
        present: lmx_range_entry_at(arena, entry\lo)
        exact: (cast: (int) (present != 0 && entry\lo = present\lo && entry\hi = present\hi && entry\array = present\array && new_owner = present\owner))
        if: exact = 0
            if: lmx_range_add_view(arena, new_owner, entry\array, entry\lo, entry\hi) != 0
                while: added != 0U
                    added: added - 1U
                    present: inserted + added
                    lmx_range_drop(arena, present\lo, present\hi)
                ---
                free((cast: (@: void) inserted))
                return: 1
            ---
            present: inserted + added
            present\lo: entry\lo
            present\hi: entry\hi
            added: added + 1U
        ---
        index: index + 1U
    ---
    free((cast: (@: void) inserted))
    # The arrays follow the entries, and the storage follows the arrays: after this the
    # attached arena holds nothing at all.
    lmx_arena_rehome_primitive_owners(arena, other)
    pool: other\arrays
    while: pool != 0
        next: pool\next
        pool\next: arena\arrays
        arena\arrays: pool
        pool: next
    ---
    other\arrays: 0
    lmx_arena_index_set_len(other, 0U)
    if: lmx_arena_index_data(other) != 0
        free((cast: (@: void) lmx_arena_index_data(other)))
    ---
    lmx_arena_index_set_data(other, 0)
    lmx_arena_index_set_cap(other, 0U)
    other\generation: 0U
    other\simple: 0U
    other\source_view: 0U
    index: 0U
    while: index < other\impl_len
        arena\impl[arena\impl_len]: other\impl[index]
        arena\impl_len: arena\impl_len + 1U
        index: index + 1U
    ---
    if: other\impl != 0
        free((cast: (@: void) other\impl))
    ---
    other\impl: 0
    other\impl_len: 0U
    other\impl_cap: 0U
return: lmx_arena_blocks_move_all(@ arena\blocks, @ other\blocks)

# Release everything the arena owns: every entry it holds is retired, then the storage
# goes.  The arrays themselves live inside those blocks, so nothing else is freed.
fn: lmx_arena_release (@: LmxArena arena) int
    @: LmxArenaBlock node
    @: LmxArenaBlock next
    int: status 0
    if: arena = 0
        return: 1
    node: arena\blocks
    while: node != 0
        next: node\next
        if: node\base != 0 && node\n != 0U
            lmx_range_drop(arena, node\base, (cast: (@: void) ((cast: (@: char) node\base) + node\n)))
        ---
        node: next
    ---
    status: lmx_arena_blocks_dispose_all(@ arena\blocks)
    arena\arrays: 0
    if: lmx_arena_index_data(arena) != 0
        free((cast: (@: void) lmx_arena_index_data(arena)))
    ---
    lmx_arena_index_set_data(arena, 0)
    lmx_arena_index_set_len(arena, 0U)
    lmx_arena_index_set_cap(arena, 0U)
    lmx_arena_impl_truncate(arena, 0U)
    if: arena\impl != 0
        free((cast: (@: void) arena\impl))
    ---
    arena\impl: 0
    arena\impl_len: 0U
    arena\impl_cap: 0U
    arena\generation: 0U
    arena\simple: 0U
    arena\source_view: 0U
return: status

# The next mark generation for a collection pass.  Bumping is the whole act: a chunk's stamp
# is compared with this value, so a pass never clears anything and never walks a chunk twice.
# Zero is never returned -- a freshly cleared chunk holds zero and must not match the first
# pass's stamp.
fn: lmx_arena_generation_next (@: LmxArena arena) unsigned
    if: arena = 0
        return: 0U
    # Letter-scale arenas have no GC pass (Mikhail 19.09 simplified).
    if: arena\simple != 0U
        return: 0U
    ---
    arena\generation: arena\generation + 1U
    if: arena\generation = 0U
        arena\generation: 1U
    ---
return: arena\generation

# D-105: room for `need` correspondences in the arena's `implements` table (malloc'd, grown by
# doubling like the index).  0 = there is room.
fn: lmx_arena_impl_room (@: LmxArena arena; size_t: need) int
    LmxImplEntry: probe
    size_t: capacity
    @: LmxImplEntry grown
    if: arena = 0
        return: 1
    if: need <= arena\impl_cap
        return: 0
    capacity: arena\impl_cap
    if: capacity = 0U
        capacity: 8U
    ---
    while: capacity < need
        if: capacity > ((cast: (size_t) -1) / 2U)
            return: 1
        ---
        capacity: capacity * 2U
    ---
    if: capacity > ((cast: (size_t) -1) / c.sizeof(probe))
        return: 1
    grown: (cast: (@: LmxImplEntry) realloc((cast: (@: void) arena\impl), capacity * c.sizeof(probe)))
    if: grown = 0
        return: 1
    ---
    arena\impl: grown
    arena\impl_cap: capacity
return: 0

# D-105: drop every correspondence whose value, model or admitting frame no longer classifies as a live
# Structure of this arena. Before a GC sweep, lmx_gc_mark_impl keeps a live value's
# required model; an unretained admitting frame still retires its own record. A static map is the program's, outside the arena; a computed
# map belongs to its entry and is freed at retirement. Run where storage leaves -- the sweep, after its blocks are gone, and
# a revert -- so an entry never outlives its value by one pass: the next Structure at that address
# starts with no correspondence.  Order is kept (lookups scan the table).
fn: lmx_arena_impl_truncate (@: LmxArena arena; size_t: keep) void
    size_t: i
    @: LmxImplEntry e
    if: arena = 0 || keep >= arena\impl_len
        return
    ---
    i: keep
    while: i < arena\impl_len
        e: arena\impl + i
        if: e\owned_map != 0 && e\map != 0
            free((cast: (@: void) e\map))
        ---
        if: e\exec_map != 0
            free((cast: (@: void) e\exec_map))
        ---
        i: i + 1U
    ---
    arena\impl_len: keep

fn: lmx_arena_impl_prune (@: LmxArena arena) void
    size_t: i 0U
    size_t: kept 0U
    @: LmxImplEntry e
    if: arena = 0 || arena\impl = 0
        return
    ---
    while: i < arena\impl_len
        e: arena\impl + i
        if: lmx_range_classify(arena, (cast: (@: void) e\value)) = c.LMX_KIND_STRUCT && lmx_range_classify(arena, (cast: (@: void) e\req)) = c.LMX_KIND_STRUCT && (e\frame = 0 || lmx_range_classify(arena, (cast: (@: void) e\frame)) = c.LMX_KIND_STRUCT)
            if: kept != i
                arena\impl[kept]: arena\impl[i]
            ---
            kept: kept + 1U
        else:
            if: e\owned_map != 0 && e\map != 0
                free((cast: (@: void) e\map))
            ---
            if: e\exec_map != 0
                free((cast: (@: void) e\exec_map))
            ---
        ---
        i: i + 1U
    ---
    arena\impl_len: kept
