fn: lm_compiler_input_schema (int: mi; int: k) int
    @: m_n_cell int (cast: (@: int) (@ c.l2_m_n))
    @@: m_arity_cell int (cast: (@@: int) (@ c.l2_m_arity))
    @@: m_dyn_cell int (cast: (@@: int) (@ c.l2_m_dyn))
    int: own c.lm_compiler_d105_key_own(k)
    int: field c.lm_compiler_d105_key_field(k)
    int: model
    if: field >= 0
        return: (cast: (int) (lm_compiler_nsf_pointee(field)))
    if: own >= 0
        return: (cast: (int) (lm_compiler_own_schema(own)))
    if: mi < 0 || mi >= m_n_cell[0] || k < m_arity_cell[0][mi] || k >= m_arity_cell[0][mi] + m_dyn_cell[0][mi]
        return: (cast: (int) (c.lm_compiler_input_model(mi, k)))
    model: c.lm_compiler_cap_arg_ns(mi, k)
    if: c.lm_compiler_schema_kind(model) != 0
        return: (cast: (int) (model))
    own: c.lm_compiler_own_lexical(mi, c.lm_compiler_input_name(mi, k))
    if: own >= 0
        return: (cast: (int) (lm_compiler_own_schema(own)))
