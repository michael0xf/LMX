Observed:
    int: copied 0
    int: own 1
    int: echo_local 1
    int: mark_local 2
end: Observed
To:
    int: x 0
    Echo: (:= x (x + 1)) (:= (Observed \ echo_local) x)
end: To
From:
    int: x 7
    Copy: To\Echo()
end: From
Self:
    int: x 1
    Mark: (:= x (x + 1)) (:= (Observed \ mark_local) x)
    Apply: Self\Mark()
end: Self
Main: From\Copy() Self\Apply() (:= (Observed \ copied) (To \ x)) (:= (Observed \ own) (Self \ x))
