    if: cell_intern_again[0] = 0U && cell_alloc_err[0] = 2
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "size overflow")))
    if: cell_intern_again[0] = 0U && cell_alloc_err[0] != 0
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "out of memory")))
    if: id = 0U || cell_intern_again[0] != id
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "intern broken")))
    cell_intern_swap[0]: 0U
    two: 0
    if: cell_m_arity[0][0] = 2 && cell_m_f0[0][0] != 0 && cell_m_f1[0][0] != 0
        two: 1
    if: two != 0 && c.lm_compiler_text_same(cell_m_f0[0][0], cell_m_f1[0][0]) = 0
        cell_intern_swap[0]: lm_compiler_intern_pair((cast: (const: @: char) (cell_m_f1[0][0]\data)), (cast: (size_t) (cell_m_f1[0][0]\length)), (cast: (const: @: char) (cell_m_f0[0][0]\data)), (cast: (size_t) (cell_m_f0[0][0]\length)))
    if: two != 0 && cell_intern_swap[0] = 0U && cell_alloc_err[0] = 2
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "size overflow")))
    if: two != 0 && cell_intern_swap[0] = 0U && cell_alloc_err[0] != 0
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "out of memory")))
    if: two != 0 && c.lm_compiler_text_same(cell_m_f0[0][0], cell_m_f1[0][0]) = 0 && (cell_intern_swap[0] = 0U || cell_intern_swap[0] = id)
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "intern failed to distinguish swapped formals")))
    cell_intern_probe[0]: lm_compiler_intern_pair("a", 1U, "b", 1U)
    if: cell_intern_probe[0] = 0U && cell_alloc_err[0] = 2
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "size overflow")))
    if: cell_intern_probe[0] = 0U && cell_alloc_err[0] != 0
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "out of memory")))
    if: cell_intern_probe[0] = 0U
        return: (cast: (int) (c.lm_compiler_error(path, source_node, "intern broken")))
    # D-107 (REVIEW 59c74b3, fable_pc): the probe is the contract of two int inputs `a`, `b` and an
    # int result; whether the unit's first method IS that contract is the interner's own equality
    # (l2_intern_eq_mi: arity, input types, result, throws, names) -- not a look at two names and one
    # type, which took `fn: zz (int: a; int: b) size_t` for the probe's and refused the unit.
