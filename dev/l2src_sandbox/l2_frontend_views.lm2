    if: fn_node\as\frame\body = 0
        return: (cast: (int) (0))
    field: c.lm_compiler_next_active(fn_node\as\frame\body\first_field)
    if: field = 0
        return: (cast: (int) (0))
    field: c.lm_compiler_next_active(field\next)
    if: field = 0
        return: (cast: (int) (0))
    if: is_sub = 0
        field: c.lm_compiler_next_active(field\next)
        if: field = 0
            return: (cast: (int) (0))
        ---
    field: c.lm_compiler_next_active(field\next)
    if: field = 0 || field\value = 0
        return: (cast: (int) (0))
    if: field\value\kind != c.LM_P0_NODE_STRUCTURE || field\value\as = 0
        return: (cast: (int) (0))
    return: (cast: (int) (1))
