include: "<stddef.h>"
predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_arena.h.lm1"

define: LMX_POST_OK 0
define: LMX_POST_INVALID 1
define: LMX_POST_REFUSED 2
define: LMX_POST_FULL 3

define: LMX_POST_INBOX 0
# An outgoing target: what the turn is preparing.  Accepting here STAGES it (see below).
define: LMX_POST_OUTBOX 1
# What the current turn has PREPARED and not yet published (spec 19.29.4.1: "publish
# successful FIFO outbox OR discard failed staged outbox"; model 28: "Текущий turn готовит
# исходящие сообщения в своём outbox").  A staged target is not outgoing yet: nothing takes
# it, and only the end-turn boundary moves it into the outbox (lmx_post_publish) or takes it
# apart (lmx_post_discard).  Its own lane has its own name so the owner can look at what it
# prepared without any of it becoming visible.
define: LMX_POST_STAGED 2

# Queue nodes come from the mailbox's own typed pool, one chunk at a time.
define: LMX_POST_NODE_CHUNK 32

# The inbox starts with the smallest useful ring.  When it fills, lmx_post grows the private
# backing by approximately 3/2 while holding the mailbox monitor.  This is an implementation
# starting point, not a public capacity limit.
define: LMX_POST_INBOX_MIN_CAPACITY 2

# The mailbox's own API, as one table.  A caller holds the interface, not a pile of
# function names, and the thread composes this into its own mail API rather than
# merging the two (lmx_thread.h.lm1).
#
# The arena is named where the mailbox has to ask a question of it -- a node comes
# from the node pool (accept) and the pool goes back to the arena (close) -- and is
# left out where it is not asked (take, count).  The mailbox keeps no arena of its
# own: the arena is the context of the act, so the caller of the act supplies it.
#
# LmxPost is named here before it is defined so these function-pointer types can
# point at it; the struct: below completes the same tag.
type: LmxPost struct LmxPost

fnptr: LmxPostAccept (@: LmxArena arena; @: LmxPost box; @: void target; int: lane) int
fnptr: LmxPostTake (@: LmxPost box; int: lane) @: void
fnptr: LmxPostCount (@: LmxPost box; int: lane) size_t
fnptr: LmxPostClose (@: LmxArena arena; @: LmxPost box) int

struct: LmxPostApi
    LmxPostAccept: accept
    LmxPostTake: take
    LmxPostCount: count
    LmxPostClose: close
end: LmxPostApi

# One node of a mailbox queue.  It is LOW-LEVEL LINKAGE, not an envelope.
#
# The envelope IS the Message: the record of lmx_message.h.lm1 -- running, success,
# handoff_ready, graph, index -- is the letter's envelope (Mikhail, 2026-09-17:
# "то что мы сейчас описали lmx_message -- и есть конверт").  What travels is the
# LMX structure created by merge, and wrapping it in a second entity is exactly the
# mistake to avoid; no language-level code does it.  This type wraps nothing: it
# carries the target's ADDRESS and the next link, and it exists so that a mailbox
# can hold a queue at all -- low level the translator emits, not a model entity.
#
# No kind/tag is stored here either: the target's domain is re-derived from its
# address through the registered range table on every read (lmx_post_admits asks
# lmx_domain_kind), so nothing on this node can fall out of step with what the
# address currently is (spec 2.1, 6.5: no per-child type tag).
struct: LmxPostLink
    @: void target
    @: LmxPostLink next
end: LmxPostLink

# One mailbox: what arrived, what goes out, and what this turn has prepared.
#
# The queue is FIFO, and that is spec, not convenience: "publish successful FIFO outbox"
# (19.29.4.1), and model 27 -- "FIFO задаётся порядком admission у конкретного получателя".
# Admission order is what a reader sees, so an item is APPENDED at the tail and taken from
# the head.  A tail link per lane is what makes appending cost no walk: this is the one
# collection the design lets be synchronized, and it must not degenerate into a list scan.
#
# The three lanes: `inbox` is what was admitted and not yet taken; `outbox` is what a
# successful end-turn has PUBLISHED (an older turn's committed outgoing, in front of a newer
# one's); `staged` is what the CURRENT turn has prepared and nothing else may see.  Publication
# moves the whole staged queue to the tail of the outbox in one step, so the order across
# turns is admission order and stays that way.
#
# This is the only synchronized collection the design allows (model 30): one small,
# reentrant monitor belongs to the mailbox and serializes only its cross-lane inbox.
# There is no wait/notify protocol and no lock is spread into the service, scheduler,
# graph, arena or turn modules.  Outbox and staged remain owner-local.
#
# Queue-node storage is the mailbox's own typed pool (lmx_pool.h.lm1).  The pool
# adds chunks of LmxPostLink nodes and registers every chunk as one more range of
# the POST_LINK domain, so a node is classified by the address it lands in and
# nothing is malloc'd -- neither per node nor per mailbox.  A pool never takes a
# node back, so a node released by lmx_post_take goes on this mailbox's free list
# and is handed out again; without that list a long-running mailbox would grow the
# pool without end.
#
# The mailbox belongs to what owns it -- an L3 Thread, which is a Message -- and its
# storage lives there rather than on a foreign heap (model 22, 25).  Hence
# lmx_post_init needs the arena open already: opening the pool registers the first
# chunk, and every node the pool hands out is a cell of one of the arena's arrays.

# Inbox slot pair + DynamicArray types for the post inbox ring.

struct: LmxPostInboxSlot
    @: void target
    @: LmxArena source_arena
end: LmxPostInboxSlot


# Fixed array of inbox slot pairs.
struct: LmxPostInboxSlotArray
    size_t: len
    @: LmxPostInboxSlot data
end: LmxPostInboxSlotArray

# Compositional DynamicArray over LmxPostInboxSlotArray (Q18 / FABLE-134 REVIEW).
struct: LmxPostInboxSlotDynamicArray
    LmxPostInboxSlotArray: array
    size_t: capacity
end: LmxPostInboxSlotDynamicArray

struct: LmxPost
    # THE INBOX IS THE ONE CROSS-LANE STRUCTURE AND IT IS A RING, NOT A LINKED LIST (20.09).
    #
    # WHY (measured): with two REAL lanes -- an accepting sender and the taking owner -- the old
    # linked list corrupted itself.  Its free list was popped by the sender and pushed by the
    # owner, both with plain read-modify-write, so the same node could be handed out twice and
    # linked into the inbox twice; a cyclic inbox then made the owner's drain loop spin forever
    # and its lane stopped turning: turns_a=2001 and turns_b=56 in the same 31 seconds, the lane
    # still alive with its state WAITING.  The node also came from a pool in the RECEIVING arena
    # (lmx_post_new_node(arena, box)), so a sender allocated inside an arena the owner was
    # collecting at the same time.
    #
    # A ring has neither allocation/free-list problem, and the mailbox monitor makes its
    # reservation/publication one operation for EVERY producer.  This deliberately favours the
    # simple Java-style synchronized rule: enter/leave are reentrant for the same OS thread,
    # but there is no wait/notify state.  A lock-free MPSC ring belongs to a separate future
    # mail implementation, not to this collection.
    #
    # The slots are private mailbox metadata, not graph values and not an address-classified LMX
    # type.  They form an ordinary movable dynamic array: growth happens only while holding the
    # monitor, copies unread target/source pairs in FIFO order, and never exposes the backing address.
    # Private flat ring pairs `[target, source_arena]`. Producers publish both words under this
    # mailbox's monitor and never mutate the receiver arena. A null source means same-arena.
    # Private ring of pair records as one DynamicArray + head/tail (Q18).
    # capacity = ring slots; array.len unused as occupancy (inbox_count + head/tail).
    LmxPostInboxSlotDynamicArray: inbox
    # The counters and slots are ordinary mailbox state protected by inbox_monitor.  Tail is
    # advanced by every sender, head only by the owner, and count is what lmx_post_count reports.
    ulong: inbox_head
    ulong: inbox_tail
    # The monitor is implemented and used only by lmx_post.lm1.  `owner` is the address of that
    # OS thread's TLS token, depth gives Java-style reentry, and held is the one atomic gate.
    size_t: inbox_monitor_owner
    size_t: inbox_monitor_depth
    int: inbox_monitor_held
    @: LmxPostLink outbox
    @: LmxPostLink outbox_tail
    @: LmxPostLink staged
    @: LmxPostLink staged_tail
    @: LmxPostLink free_nodes
    size_t: inbox_count
    size_t: outbox_count
    size_t: staged_count
    LmxPool: nodes
    LmxPostApi: api
end: LmxPost

prototype:
    # THE LIFECYCLE PRECONDITION (L2 §9, mailbox; mirrored in L1).  `init` and `close` require
    # QUIESCENCE: no OS thread is in accept/take/count or starts one before the operation
    # completes.  Publication begins only after a successful init -- until then nothing accepts
    # and nothing publishes -- and the owner that opened the mailbox is the one that coordinates
    # the quiet before closing it.  That coordination cannot be moved inside this module: a lock
    # held inside close cannot make object lifetime safe against new entrants, because destroying
    # a monitor cannot exclude anyone.  Outbox and staged stay owner-local throughout (the
    # struct's note above); only the inbox is cross-lane, and the monitor protects that alone.
    fn: lmx_post_init (@: LmxArena arena; @: LmxPost box) int
    fn: lmx_post_api (@: LmxPost box) @: LmxPostApi
    fn: lmx_post_admits (@: LmxArena arena; @: void target) int
    fn: lmx_post_accept (@: LmxArena arena; @: LmxPost box; @: void target; int: lane) int
    # Transactional cross-arena inbox publication. The producer only reserves/grows and publishes
    # {target, source_arena} under the mailbox monitor; it never mutates the receiver arena.
    fn: lmx_post_accept_transfer (@: LmxArena arena; @: LmxPost box; @: void target; @: LmxArena source_arena) int
    # Receiver-owner take. Before exposing an imported inbox target, claim its source arena into
    # the receiver arena. Refusal leaves the pair queued and owned by the source arena.
    fn: lmx_post_take_owned (@: LmxArena arena; @: LmxPost box; int: lane) @: void
    fn: lmx_post_take (@: LmxPost box; int: lane) @: void
    fn: lmx_post_count (@: LmxPost box; int: lane) size_t
    # The end-turn boundary's first act (19.29.4.1), one call per outcome: publish moves
    # everything staged into the outbox, in order, where a transport (a later stage) finds
    # it; discard takes it apart and puts its nodes back on the free list, because a turn
    # that failed publishes nothing.  Neither asks the arena anything, so a lane can perform
    # them without holding one.
    fn: lmx_post_publish (@: LmxPost box) int
    fn: lmx_post_discard (@: LmxPost box) int
    fn: lmx_post_close (@: LmxArena arena; @: LmxPost box) int
    fn: lmx_post_inbox_data (@: LmxPost box) @: LmxPostInboxSlot
    fn: lmx_post_inbox_len (@: LmxPost box) size_t
    fn: lmx_post_inbox_cap (@: LmxPost box) size_t
    fn: lmx_post_inbox_set_data (@: LmxPost box; @: LmxPostInboxSlot data) void
    fn: lmx_post_inbox_set_len (@: LmxPost box; size_t: len) void
    fn: lmx_post_inbox_set_cap (@: LmxPost box; size_t: capacity) void
end: prototype
