diff --git src/l2src/lmx_walk.lm1 src/l2src/lmx_walk.lm1
index ed35e25d..85b2f146 100644
--- src/l2src/lmx_walk.lm1
+++ src/l2src/lmx_walk.lm1
@@ -432,0 +433,2 @@ fn: lmx_walk_value_storage (@: LmxWalkValue value) @: void
+    if: value\kind = c.LMX_WALK_VALUE_FOREIGN
+        return: value\ref
@@ -446,0 +449,13 @@ return: 0
+# The same common storage projection carries native foreign aggregates.
+# Their C-typed producer owns the automatic object until this call returns.
+# Interpretation may forward/ignore the opaque transport; it must not treat
+# it as a reference or invent a mutable/numeric place without a contract.
+fn: lmx_walk_value_foreign (@: LmxWalkValue value; @: void storage) int
+    if: value = 0 || storage = 0
+        return: c.LMX_WALK_INVALID
+    lmx_walk_value_clear(value)
+    value\present: 1
+    value\kind: c.LMX_WALK_VALUE_FOREIGN
+    value\ref: storage
+return: c.LMX_WALK_OK
+
