@@ -31143 +31156 @@ fn: l2_path_walk_bound (@: L2Path out) int
-    if: out\n < 1 || out\steps = 0
+    if: out\n < 0 || (out\n > 0 && out\steps = 0)
@@ -31171,4 +31184,2 @@ fn: l2_path_walk_bound (@: L2Path out) int
-    if: oi >= 0 && out\steps\locus = 7
-        value: l2_decl_contract(l2_own_decl[oi])
-    if: oi < 0 && fi >= 0 && out\steps\locus = 7 && l2_cur_mi >= 0
-        value: l2_decl_contract(l2_formal_decl_at(l2_cur_mi, fi))
+    if: out\n = 0 || out\steps\locus = 7
+        value: l2_path_root_contract(out)
@@ -31202,0 +31214,7 @@ fn: l2_path_walk_bound (@: L2Path out) int
+    if: out\n = 0
+        out\in_eternal: protected
+        if: value != 0 && value\kind = 1
+            out\array_leaf: 1
+            out\leaf_level: value
+        ---
+        return: 0
@@ -31205,0 +31224,9 @@ return: status
+# The contract of the root already selected by the common dispatcher. This
+# never looks up its spelling again, including a carried Array binding.
+fn: l2_path_root_contract (const: @(L2Path path)) @: L2TypeContract
+    if: path\oi >= 0
+        return: l2_decl_contract(l2_own_decl[path\oi])
+    if: path\fi >= 0 && l2_cur_mi >= 0
+        return: l2_decl_contract(l2_formal_decl_at(l2_cur_mi, path\fi))
+return: 0
+
@@ -31274,0 +31302,11 @@ return: l2_path_walk(out)
+# A complete value uses the same adapter/root/step walk, with a bare root
+# represented by zero steps. The selected leaf owns its contract; releasing
+# the temporary path does not shorten or reconstruct that contract.
+fn: l2_path_resolve_value (@: LmP0Field first; int: count; @: L2Path out) int
+    int: status
+    l2_path_init(0, 0U, out)
+    status: l2_path_steps_operand(first, count, out, 1)
+    if: status != 0
+        return: status
+return: l2_path_walk(out)
+
