# A repeated receiveMessage: m in an inline if writes the same selected data
# place as the earlier receive, not a shadow field. The first receive gets
# the entry letter and the second gets the empty inbox, leaving m null;
# a becomes 1 and b remains 0.
Out:
    int: a 0
    int: b 0
end: Out
Host:
    receiveMessage: m
    if: m != 0
        receiveMessage: m
        if: m = 0
            Out\a: 1
    ---
    if: m != 0
        Out\b: 1
end: Host
fn: probe () int
    call: Host
    if: Out\a != 1 || Out\b != 0
        return: 81
    return: 7
end: probe
sendMessage: exit(exit_code: probe(); stdout: ""; stderr: "")
return
