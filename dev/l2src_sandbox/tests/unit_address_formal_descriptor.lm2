# A nonprimitive formal carries a descriptor value in its own storage place.
Model:
    int: value 7
end: Model

fn: read (Model: item) int
return: item\value

fn: first (Model: item) int
    if: item != Model || (@: item) = (@: Model)
        return: 0
    int: readValue read(item)
    if: readValue != 7
        return: 0
return: 7

fn: second (@: item Model) int
    if: item != Model || @ item = @ Model
        return: 0
    int: readValue read(item)
    if: readValue != 7
        return: 0
return: 7

fn: check () int
    int: a first(Model)
    int: b second(Model)
    if: a != 7 || b != 7
        return: 0
return: 7

sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
