fn: throws_into_throws () int
    int: refused 0
    ---
        @: Risky\f Hb2
        catch: implements ()
            refused: 1
    ---
    if: refused != 0
        return: 39
    int: got 0
    ---
        int: v Risky\f()
        got: v
        catch: Bad (int: value)
            got: 100 + value
    ---
    if: got != 106
        return: 59
    return: 0
end: throws_into_throws
fn: call_missing () int
    ---
        call: Hw
        return: 1
        catch: call ()
            return: 22
        catch: implements ()
            return: 24
    ---
end: call_missing
fn: call_fitting () int
    ---
        call: Hh
        return: 1
        catch: call ()
            return: 22
        catch: implements ()
            return: 24
    ---
end: call_fitting
fn: run () int
    @: Hw g g
    @: Hq Places Places
    @: Hs s s
    @: Hh h h
    @: Hu u u
    @: Hb bad bad
    @: Hb2 bad2 bad2
    int: r static_path()
    if: r != 0
        return: r
    r: free_root()
    if: r != 0
        return: r
    r: unit_place()
    if: r != 0
        return: r
    r: sub_into_fn()
    if: r != 0
        return: r
    r: fitting()
    if: r != 0
        return: r
    r: fn_into_sub()
    if: r != 0
        return: r
    r: sub_into_sub()
    if: r != 0
        return: r
    r: throws_into_plain()
    if: r != 0
        return: r
    r: throws_into_throws()
    if: r != 0
        return: r
    r: call_fitting()
    if: r != 1
        return: 40 + r
    r: call_missing()
    if: r != 22
        return: 60 + r
    return: 0
end: run
int: code 7
int: got run()
if: got != 0
    code: got
---
send: exit(exit_code: code; stdout: ""; stderr: "")
return
