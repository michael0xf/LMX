# m is an explicit merge result, not an implicit Model: m construction.
# m() and m: () are nullary calls of its current callable occurrence. Its own
# declaration resets v to 1 and the following statement writes 2, independently
# of Model. Neither spelling assigns an empty Structure to m. Entry 7.
Model:
    size_t: v 1U
    v: v + 1U
return
m: merge Model
size_t: d 9U
d: m\v
m\v: 7U
m()
size_t: a 9U
a: m\v
m\v: 7U
m: ()
size_t: b 9U
b: m\v
size_t: o 9U
o: Model\v
int: ok 0
if: d = 1U && a = 2U && b = 2U && o = 1U
    ok: 7
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
