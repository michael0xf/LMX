# §9.8: the whole S fits, its fields do not: W, S stays whole (TZ §9.6; §14.2 C09).
(
    Observed:
        int: seen 0
)
@: shared data[0]
@: Model (int: a 0; int: b 0)
fn: f (@: s Model) int
    return: s\a * 10 + s\b
sub: main () (
    S(int: a 1; int: b 2)
)
    shared\Observed\seen := f(S)
main()
