include: "<windows.h>" "<tlhelp32.h>" "<stdio.h>" "<stdlib.h>" "<string.h>"

# mixa_win32_smoke_harness.lm1 — L1 port of mixa_win32_smoke_harness.c
# External smoke test for mixa_app_main.exe (ticket 20260913-013609).
# CreateProcess -> FindWindow -> PostMessage(WM_CHAR/WM_CLOSE) -> poll console log.

define: WM_CLOSE 16
define: WM_CHAR 258
define: WM_KEYDOWN 256

int: g_checks 0
int: g_failures 0

fn: check (int: cond; const: @(char what)) void
    g_checks: g_checks + 1
    if: cond = 0
        g_failures: g_failures + 1
        c.fprintf(c.stderr, "FAIL: %s", what)
    ---
    ---
    c.printf("ok: %s", what)

fn: count_occurrences (const: @(char hay); const: @(char needle)) int
    int: count
    size_t: hlen
    size_t: nlen
    size_t: i
    if: hay = 0 || needle = 0
        return: 0
    ---
    hlen: c.strlen(hay)
    nlen: c.strlen(needle)
    if: nlen = 0U || nlen > hlen
        return: 0
    ---
    count: 0
    i: 0U
    while: i + nlen <= hlen
        if: c.memcmp(hay + i, needle, nlen) = 0
            count: count + 1
            i: i + nlen
        else:
            i: i + 1
        ---
    ---
    return: count

fn: wait_file_text (const: @(char path); const: @(char needle); int: want; unsigned: timeout_ms) int
    unsigned: start
    int: count
    @: size_t len
    @: char bufptr
    start: c.GetTickCount()
    while: 1
        bufptr: (cast: (@: char) c.malloc(65536U))
        if: bufptr != 0
            c.fread(bufptr, 1U, 65535U, c.fopen(path, "rb"))
            count: count_occurrences(bufptr, needle)
            c.free(bufptr)
            if: count >= want
                return: 1
            ---
        ---
        if: (c.GetTickCount() - start) >= timeout_ms
            return: 0
        ---
        c.Sleep(50U)
    ---

fn: type_ascii (@: void hwnd; const: @(char s)) void
    if: hwnd = 0 || s = 0
        return: 0
    ---
    while: s[0] != 0
        c.PostMessageA(hwnd, WM_CHAR, (cast: (@: void) (cast: (unsigned) s[0])), 0)
        s: s + 1
    ---
    return: 0

fn: main (int: argc; @: @(char) argv) int
    @: void si
    @: void pi
    @: void hwnd
    const: @(char cmdline)
    const: @(char console_path)
    int: ok

    g_checks: 0
    g_failures: 0
    if: argc < 2
        c.fprintf(c.stderr, "usage: sm")
        return: 1
    ---

    cmdline: argv[1]
    console_path: argv[2]

    si: (cast: (@: void) c.malloc(c.sizeof(c.STARTUPINFOW)))
    pi: (cast: (@: void) c.malloc(c.sizeof(c.PROCESS_INFORMATION)))
    c.memset(si, 0, c.sizeof(c.STARTUPINFOW))
    c.memset(pi, 0, c.sizeof(c.PROCESS_INFORMATION))

    ok: c.CreateProcessW(0, (cast: (@: void) cmdline), 0, 0, 0, 0U, 0, 0, si, pi)
    check(ok != 0, "CreateProcess")
    if: ok = 0
        c.free(si)
        c.free(pi)
        return: g_failures
    ---

    c.Sleep(500U)
    hwnd: c.FindWindowA(0, 0)
    check(hwnd != 0, "FindWindow")

    if: console_path != 0
        ok: wait_file_text(console_path, "ok:", 1, 5000U)
        check(ok != 0, "console output")
    ---

    type_ascii(hwnd, "hello\n")
    c.PostMessageA(hwnd, WM_CLOSE, 0, 0)
    c.WaitForSingleObject((cast: (@: void) pi), 10000U)

    c.free(si)
    c.free(pi)
    c.printf("smoke_harness: done")
    return: g_failures
