# Two callables with one free name whose lexical declarations differ may
# reach one callable formal. The unit declares v twice; a1 stands before the
# second declaration, a2 after it. run has no v, so each reads the root's
# binding where the root calls run: the last v, 2, for both. Entry 7.
int: v 1

fn: a1 () int
    return: v
end: a1

int: v 2

fn: a2 () int
    return: v
end: a2

fn: run (a1: q) int
    return: q()
end: run

int: x run(a1)
int: y run(a2)
int: ok 7
if: x != 2 || y != 2
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
