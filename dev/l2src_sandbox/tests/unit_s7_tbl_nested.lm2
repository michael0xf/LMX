# the receiver `table`: unit_s7_prim_cross over its own convert.lm2 whose source table stands inside another
# frame, `group:` (tests/unit_s7_tbl_nested_table.lm2): the source tables are those at the root of the
# translation input, nothing below it is looked into (the tree walk it replaces found `columns:` and `rows:`
# at any depth): "convert.lm2 has no source table `primitive.convert`".

fn: go () int
    int: a 1
    size_t: b 2U
    a: b
    return: a

int: k
k: go()
if: k = 2
    sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
return
