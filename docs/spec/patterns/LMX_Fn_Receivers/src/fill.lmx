FxArrayFill:
    private:
        @: target
        @: value
    required: target value
    return: @
    fill:
        throws: copy(FxSeqInfo\get\throws) copy(FxSeqStore\write\throws)
        FxSeqInfo\get(target)
        int: i 0
        while: i < length(target)
            FxSeqStore\write(target; i; value)
            i += 1
        return: target
