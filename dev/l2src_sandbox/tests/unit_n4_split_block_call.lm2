# N4 (LMX_semantics.ru.md #method-parts; LMX_grammar.ru.md section 17): a call written as a block is the same call;
# end: call only closes its Frame. S runs over D, so D\x becomes 5. Entry 7.
S:
    int: x
    x: x + 1
end: S
D:
    int: x 4
end: D
call:
    S D
end: call
int: r 81
if: D\x = 5
    r: 7
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
