end: lm_p0_dump_take_data

# Original: parser.lm1:4766 lm_p0_dump_delete
sub: lm_p0_dump_delete (@: dump c.LmP0Dump)
    if: (dump != 0)
        c.lm_own_delete(dump\data, 0)
        c.lm_own_delete(dump, 0)
    ---
end: lm_p0_dump_delete

# Original: parser.lm1:4774 lm_p0_dump_alloc
fn: lm_p0_dump_alloc (const: (@: document c.LmP0Document)) @: char
    @: dump c.LmP0Dump
    @: data char
    dump: lm_p0_dump_new()
    if: (dump = 0)
        return: 0
    if: ((document = 0) || (document\root = 0))
        lm_p0_dump_append_cstr(dump, "")
        data: lm_p0_dump_take_data(dump)
        lm_p0_dump_delete(dump)
        return: data
    lm_p0_dump_node(dump, (cast: (const: @: c.LmP0Node) document\root), 0U)
    if: dump\failed
        lm_p0_dump_delete(dump)
        return: 0
    data: lm_p0_dump_take_data(dump)
    lm_p0_dump_delete(dump)
    return: data
end: lm_p0_dump_alloc
