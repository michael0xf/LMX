# A copied method's formal admits a candidate with shifted xFirst/xLast fields.
# Both named reads use the model-to-candidate map. Result 19; exit 7.
Model:
    int: xFirst 0
    int: xLast 0
end: Model
Cand:
    int: pad 5
    int: xFirst 1
    int: xLast 9
end: Cand
fn: getm (Model: q) int
    int: a 0
    int: b 0
    a: q\xFirst
    b: q\xLast
    return: a * 10 + b
end: getm
Box:
    int: v 0
    fn: getm
end: Box
b1: merge: Box
c: merge: Cand
int: r b1\getm(c)
int: ok 7
if: r != 19
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
