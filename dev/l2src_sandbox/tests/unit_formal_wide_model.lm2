fn: rd (Model: m) int
    return: m\f00 * 1000000 + m\f35 * 1000 + m\f69
end: rd

fn: own () int
    @: Model x @Model
    return: rd(x)
end: own

fn: other () int
    @: Wide x @Wide
    return: rd(x)
end: other

int: a own()
int: b other()
int: ok 7
if: a != 35069
    ok: 81
if: b != 100135169
    ok: 82
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
