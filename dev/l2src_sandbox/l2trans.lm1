            if: l2_rw_enter(els\value, @ bsave) != 0
                return: 1
            l2_rw_shell_fid: -1
            fid: l2_for_find(els\value)
            if: fid >= 0 && l2_for_uchild[fid] = 0 - 3
                l2_rw_shell_fid: fid
            if: l2_rw_body(els\value\as\frame\body, else_node, 1) != 0
