# A copied User reads two model-named fields through captured a3; the candidate
# has a different physical layout. Exit 7; 81 otherwise.
Model:
    int: xFirst 0
    int: xLast 0
end: Model
Cand:
    int: pad 5
    int: xFirst 1
    int: xLast 9
end: Cand
User:
    int: y 0
    int: z 0
    y: a3\xFirst
    z: a3\xLast
end: User
u1: merge: User
c: merge: Cand
@: a3 Model c
u1
int: ok 7
if: u1\y != 1 || u1\z != 9
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
