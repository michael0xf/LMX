Observed:
    int: before 1
    int: after 0
    int: calls 0
end: Observed
int: calls 0
fn: side () int
    :=: calls (calls + 1)
    return: 2
end: side
Args:
    int: x 7
end: Args
D:
    int: seen 0
    Code: (:= seen 1) (int x (side))
end: D
Main:
    :=: (Observed \ before) 1
    call: (:= args Args) (:= code (D \ Code))
    :=: (Observed \ after) 1
    :=: (Observed \ calls) calls
end: Main
