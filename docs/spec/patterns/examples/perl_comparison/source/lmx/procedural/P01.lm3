Example:
    []int: items
    return: @
    run:
        throws: copy(sys\resize\throws)
        []int: out []
        sys\resize(out; length(items))
        int: total 0
        int: i 0
        while: i < length(items)
            out[i] := items[i] * 3
            total += out[i]
            i += 1
        return: (out; total)
