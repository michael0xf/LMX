predef: "lmx_value_owned.h.lm1"
predef: "lmx_implements.h.lm1"
predef: "l2src/lmx_chars.lm1"
include: "<stdlib.h>"

# A cell of one of the arena's arrays (Lingvamyxa_spec.txt 2, 6.5): the arena hands it out
# from its array of that kind and type -- the array is made on the first request and grows
# by adding chunks, so a cell's address never moves.  What a constructor gets back is the
# address of the cell inside that array; stride, kind and type belong to the array, and the
# arena's index answers them for any address in it.  There is no owner-local list and no
# per-value array: the array is the arena's and the type is the array's.
fn: lmx_value_allocate_owned (@: LmxArena arena; size_t: stride; int: kind; int: type) @: void
    if: arena = 0 || stride = 0U
        return: 0
    ---
return: lmx_arena_take(arena, stride, kind, type)

# Initial root construction, not reparenting of an existing occurrence. The
# header lives in the STRUCT domain (SPEC 2: only a Structure target has
# array/parent/native); its child-pointer array is a separate CHILDREN range opened
# later by lmx_arena_refs_open_owned.
fn: lmx_node_new_owned (@: LmxArena arena) @: Lmx
return: lmx_node_new_profiled(arena, 0)

fn: lmx_node_new_profiled (@: LmxArena arena; @: Lmx profile) @: Lmx
    @: Lmx value (cast: (@: Lmx) lmx_arena_take_profiled(arena, c.sizeof(c.Lmx), c.LMX_KIND_STRUCT, c.LMX_TYPE_STRUCT, profile))
    if: value != 0
        value\parent: 0
        value\array.size: 0U
        value\array.data: 0
        value\native: 0
    ---
    return: value

fn: lmx_struct_new_owned (@: Lmx parent; @: LmxArena arena) @: Lmx
return: lmx_struct_new_profiled(parent, arena, 0)

fn: lmx_struct_new_profiled (@: Lmx parent; @: LmxArena arena; @: Lmx profile) @: Lmx
    @: Lmx value
    if: parent = 0
        return: 0
    value: lmx_node_new_profiled(arena, profile)
    if: value != 0
        value\parent: parent
    ---
    return: value

fn: lmx_op_new_owned (@: LmxArena arena; int: code) @: LmxOp
return: lmx_op_new_profiled(arena, code, 0)

fn: lmx_op_new_profiled (@: LmxArena arena; int: code; @: Lmx profile) @: LmxOp
    @: LmxOp value (cast: (@: LmxOp) lmx_arena_take_profiled(arena, c.sizeof(c.LmxOp), c.LMX_DOMAIN_KIND_OP, c.LMX_DOMAIN_OP, profile))
    if: value != 0
        value\code: code
    ---
    return: value

fn: lmx_int_new_owned (@: LmxArena arena) @: void
return: lmx_int_new_profiled(arena, 0)

fn: lmx_int_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    int: zero 0
    @: int value (cast: (@: int) lmx_arena_take_profiled(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT, profile))
    if: value != 0
        \value: 0
    ---
    return: (cast: (@: void) value)

# The first CHAR interval remains the immutable literal table. Mutable cells
# follow it in the same typed arena pool and have independent stable addresses.
fn: lmx_char_new_owned (@: LmxArena arena) @: void
return: lmx_char_new_profiled(arena, 0)

fn: lmx_char_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    @: char value
    if: profile = 0 && lmx_chars_init(arena) != 0 && lmx_arena_find(arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR) = 0
        return: 0
    value: (cast: (@: char) lmx_arena_take_profiled(arena, c.sizeof(c.char), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR, profile))
    if: value != 0
        \value: 0
    ---
return: (cast: (@: void) value)

fn: lmx_char_store_known (@: void cell; int: value) int
    @: char p
    if: cell = 0
        return: 1
    p: (cast: (@: char) cell)
    \p: (cast: (char) value)
return: 0

fn: lmx_size_new_owned (@: LmxArena arena) @: void
return: lmx_size_new_profiled(arena, 0)

fn: lmx_size_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    size_t: zero 0U
    @: size_t value (cast: (@: size_t) lmx_arena_take_profiled(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_SIZE_T, profile))
    if: value != 0
        \value: 0U
    ---
    return: (cast: (@: void) value)

fn: lmx_unsigned_new_owned (@: LmxArena arena) @: void
return: lmx_unsigned_new_profiled(arena, 0)

fn: lmx_unsigned_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    unsigned: zero 0U
    @: unsigned value (cast: (@: unsigned) lmx_arena_take_profiled(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_UNSIGNED, profile))
    if: value != 0
        \value: 0U
    ---
    return: (cast: (@: void) value)

fn: lmx_ulong_new_owned (@: LmxArena arena) @: void
return: lmx_ulong_new_profiled(arena, 0)

fn: lmx_ulong_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    ulong: zero 0U
    @: ulong value (cast: (@: ulong) lmx_arena_take_profiled(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_ULONG, profile))
    if: value != 0
        \value: 0U
    ---
    return: (cast: (@: void) value)

fn: lmx_uchar_new_owned (@: LmxArena arena) @: void
return: lmx_uchar_new_profiled(arena, 0)

fn: lmx_uchar_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    char: zero '\0'
    @: char value (cast: (@: char) lmx_arena_take_profiled(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_UNSIGNED_CHAR, profile))
    if: value != 0
        \value: '\0'
    ---
    return: (cast: (@: void) value)

fn: lmx_charptr_new_owned (@: LmxArena arena) @: void
return: lmx_charptr_new_profiled(arena, 0)

fn: lmx_charptr_new_profiled (@: LmxArena arena; @: Lmx profile) @: void
    @: char zero 0
    @@: char value (cast: (@@: char) lmx_arena_take_profiled(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR_PTR, profile))
    if: value != 0
        \value: 0
    ---
    return: (cast: (@: void) value)

fn: lmx_charptr_value_known (@: void cell) @: char
    @@: char p
    if: cell = 0
        return: 0
    p: (cast: (@@: char) cell)
    return: \p

fn: lmx_charptr_store_known (@: void cell; @: char value) int
    @@: char p
    if: cell = 0
        return: 1
    p: (cast: (@@: char) cell)
    \p: value
    return: 0

fn: lmx_pointer_new_owned (int: type; @: LmxArena arena) @: void
return: lmx_pointer_new_profiled(type, arena, 0)

fn: lmx_pointer_new_profiled (int: type; @: LmxArena arena; @: Lmx profile) @: void
    @: void zero 0
    @@: void value
    if: type < c.LMX_TYPE_POINTER_BASE
        return: 0
    value: (cast: (@@: void) lmx_arena_take_profiled(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, type, profile))
    if: value != 0
        \value: 0
    ---
    return: (cast: (@: void) value)

fn: lmx_pointer_value_known (@: void cell) @: void
    @@: void p
    if: cell = 0
        return: 0
    p: (cast: (@@: void) cell)
    return: \p

fn: lmx_pointer_store_known (@: void cell; @: void value) int
    @@: void p
    if: cell = 0
        return: 1
    p: (cast: (@@: void) cell)
    \p: value
    return: 0

# Closed-unit type proof supplies the type, not a process-global catalog.
# Explicit raw/unknown addresses are outside these helper preconditions.
fn: lmx_char_value_known (@: void cell) int
    @: char p
    if: cell = 0
        return: -1
    p: (cast: (@: char) cell)
    # Numeric value follows C char promotion; byte-table indices are a storage detail.
    return: (cast: (int) \p)

fn: lmx_ulong_value_known (@: void cell) ulong
    @: ulong p
    if: cell = 0
        return: 0U
    p: (cast: (@: ulong) cell)
    return: \p

fn: lmx_ulong_store_known (@: void cell; ulong: value) int
    @: ulong p
    if: cell = 0
        return: 1
    p: (cast: (@: ulong) cell)
    \p: value
    return: 0

fn: lmx_uchar_value_known (@: void cell) unsigned
    @: char p
    if: cell = 0
        return: 0U
    p: (cast: (@: char) cell)
    return: (cast: (unsigned) ((cast: (int) \p) & 255))

fn: lmx_uchar_store_known (@: void cell; unsigned: value) int
    @: char p
    if: cell = 0
        return: 1
    p: (cast: (@: char) cell)
    \p: (cast: (char) (value & 255U))
    return: 0

fn: lmx_int_value_known (@: void cell) int
    @: int p
    if: cell = 0
        return: 0
    p: (cast: (@: int) cell)
    return: \p

fn: lmx_int_store_known (@: void cell; int: value) int
    @: int p
    if: cell = 0
        return: 1
    p: (cast: (@: int) cell)
    \p: value
    return: 0

fn: lmx_size_value_known (@: void cell) size_t
    @: size_t p
    if: cell = 0
        return: 0U
    p: (cast: (@: size_t) cell)
    return: \p

fn: lmx_size_store_known (@: void cell; size_t: value) int
    @: size_t p
    if: cell = 0
        return: 1
    p: (cast: (@: size_t) cell)
    \p: value
    return: 0

fn: lmx_unsigned_value_known (@: void cell) unsigned
    @: unsigned p
    if: cell = 0
        return: 0U
    p: (cast: (@: unsigned) cell)
    return: \p

fn: lmx_unsigned_store_known (@: void cell; unsigned: value) int
    @: unsigned p
    if: cell = 0
        return: 1
    p: (cast: (@: unsigned) cell)
    \p: value
    return: 0
