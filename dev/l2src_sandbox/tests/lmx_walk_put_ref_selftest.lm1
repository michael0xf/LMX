predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_plan.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# -186: PUT_REF binds/replaces a direct Structure own slot (lmx_arena_ref_store).
# Read via AT/OF -- no DEREF. Mutant: PUT into a direct slot (no pointer cell) -> RED.
# -186 c4: empty AT -> null; EQ/NE Structure or empty slot by address. Mutant: empty AT INVALID -> RED.

@: LmxArena ga 0
@: Lmx groles 0
@: Lmx gplan_roles 0
@: LmxWalkContext gctx 0
@: LmxWalkValue gv 0
int: broken 0
int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(ga, groles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(ga, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

sub: ref (@: Lmx code; size_t: slot; @: Lmx target)
    if: code = 0 || target = 0 || lmx_arena_ref_store(code, slot, (cast: (@: void) target)) != 0
        broken: broken + 1
    ---
end: ref

sub: sz (@: Lmx code; size_t: slot; size_t: value)
    if: code = 0 || lmx_walk_store_size(ga, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: sz

fn: mk_m (@: Lmx unit; size_t: slot; size_t: children) @: Lmx
    @: Lmx m pl(unit, slot, children)
    @: LmxCallable info lmx_callable_new_owned(ga)
    if: m = 0 || info = 0 || lmx_arena_ref_store(m, 0U, (cast: (@: void) info)) != 0
        broken: broken + 1
        return: 0
    ---
return: m

fn: go (@: Lmx m) int
    int: st
    if: m = 0 || gctx = 0 || gv = 0
        return: c.LMX_WALK_INVALID
    st: lmx_walk_prepare(gctx, ga, gplan_roles, m)
    if: st != c.LMX_WALK_OK
        return: st
return: lmx_walk_run(gctx, m, 0, 0U, gv)

fn: main () int
    LmxArena: arena
    LmxArena: context_arena
    LmxPool: context_cells
    LmxScratch: store
    LmxWalkContext: context
    @: Lmx unit 0
    @: Lmx m 0
    @: Lmx n 0
    @: Lmx holder 0
    @: Lmx model 0
    @: Lmx model2 0
    @: Lmx ofn 0
    @: Lmx atn 0
    @: Lmx atn2 0
    @: Lmx eqn 0
    @: Lmx litn 0
    @: Lmx lit1 0
    @: Lmx subn 0
    @: void got 0
    int: st 0

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        return: 2
    ga: @ arena
    groles: lmx_walk_roles_open(ga)
    gplan_roles: lmx_plan_roles_open(ga)
    memset((cast: (@: void) (@ context_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxScratch))
    if: lmx_arena_open(@ context_arena) != 0 || lmx_scratch_open(@ store, @ context_arena, @ context_cells, 16U) != c.LMX_SCRATCH_OK
        return: 2
    ---
    lmx_walk_program_bind(groles, gplan_roles)
    context.arena: ga
    context.scratch: @ store
    context.roles: groles
    context.plan_roles: gplan_roles
    context.immutable_profile: 0
    context.classified: 0U
    gctx: @ context
    gv: (cast: (@: LmxWalkValue) calloc(1U, c.sizeof(c.LmxWalkValue)))
    if: gv = 0 || groles = 0 || gplan_roles = 0
        return: 2
    ---

    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 8U) != 0
        return: 2
    ---
    # holder slot 1 starts empty (direct own Structure slot, not a pointer cell).
    holder: pl(unit, 1U, 2U)
    model: pl(unit, 2U, 2U)
    model2: pl(unit, 3U, 2U)
    if: holder = 0 || model = 0 || model2 = 0 || lmx_walk_store_int(ga, model, 1U, 42) != c.LMX_WALK_OK || lmx_walk_store_int(ga, model2, 1U, 99) != c.LMX_WALK_OK
        return: 2
    ---
    check((cast: (int) (lmx_arena_ref_value(holder, 1U) = 0)), "holder slot 1 empty direct")

    # Bind: PUT_REF holder[1] = model
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_PUT_REF, 4U)
    ref(n, 1U, holder)
    sz(n, 2U, 1U)
    ref(n, 3U, model)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && lmx_arena_ref_value(holder, 1U) = (cast: (@: void) model))), "PUT_REF bind model")

    # Read via AT (no DEREF): AT(holder,1) is the Structure; OF ...,1 -> 42
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    ofn: fr(n, 1U, c.LMX_WALK_OP_OF, 3U)
    atn: fr(ofn, 1U, c.LMX_WALK_OP_AT, 3U)
    ref(atn, 1U, holder)
    sz(atn, 2U, 1U)
    sz(ofn, 2U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref != 0 && lmx_int_value_known(gv\ref) = 42)), "read via AT/OF no DEREF after bind")

    # Replace: PUT_REF holder[1] = model2
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_PUT_REF, 4U)
    ref(n, 1U, holder)
    sz(n, 2U, 1U)
    ref(n, 3U, model2)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && lmx_arena_ref_value(holder, 1U) = (cast: (@: void) model2))), "PUT_REF replace model2")

    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    ofn: fr(n, 1U, c.LMX_WALK_OP_OF, 3U)
    atn: fr(ofn, 1U, c.LMX_WALK_OP_AT, 3U)
    ref(atn, 1U, holder)
    sz(atn, 2U, 1U)
    sz(ofn, 2U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref != 0 && lmx_int_value_known(gv\ref) = 99)), "read via slot after replace")

    # Mutant: PUT into a direct slot (no pointer cell) -> INVALID / RED
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_PUT, 4U)
    ref(n, 1U, holder)
    sz(n, 2U, 1U)
    ref(n, 3U, model)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_INVALID)), "mutant PUT into direct slot -> RED")
    got: lmx_arena_ref_value(holder, 1U)
    check((cast: (int) (got = (cast: (@: void) model2))), "mutant PUT left slot unchanged")

    # -186 c4: empty direct Structure slot -- AT yields null (no value), not INVALID.
    # Mutant: reject slot[0]=0 in OP_AT -> RED on empty AT.
    if: lmx_arena_ref_store(holder, 1U, 0) != 0
        broken: broken + 1
    ---
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    atn: fr(n, 1U, c.LMX_WALK_OP_AT, 3U)
    ref(atn, 1U, holder)
    sz(atn, 2U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref = 0)), "empty AT -> null (not INVALID)")

    # EQ empty AT vs LIT 0 -> true (address compare). Mutant: load_operand on 0 -> RED.
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    eqn: fr(n, 1U, c.LMX_WALK_OP_EQ, 3U)
    atn: fr(eqn, 1U, c.LMX_WALK_OP_AT, 3U)
    ref(atn, 1U, holder)
    sz(atn, 2U, 1U)
    litn: fr(eqn, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 0) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref != 0 && lmx_int_value_known(gv\ref) = 1)), "EQ empty AT vs 0 -> true")

    # NE empty vs 0 is 1-(EQ) -> false (covers source != via walked NE).
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    subn: fr(n, 1U, c.LMX_WALK_OP_SUB, 3U)
    lit1: fr(subn, 1U, c.LMX_WALK_OP_LIT, 2U)
    if: lit1 != 0 && lmx_walk_store_int(ga, lit1, 1U, 1) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    eqn: fr(subn, 2U, c.LMX_WALK_OP_EQ, 3U)
    atn: fr(eqn, 1U, c.LMX_WALK_OP_AT, 3U)
    ref(atn, 1U, holder)
    sz(atn, 2U, 1U)
    litn: fr(eqn, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 0) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref != 0 && lmx_int_value_known(gv\ref) = 0)), "NE empty AT vs 0 -> false")

    # Bind model; EQ AT vs 0 -> false; EQ AT vs struct address (same model via AT twice) -> true.
    if: lmx_arena_ref_store(holder, 1U, (cast: (@: void) model)) != 0
        broken: broken + 1
    ---
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    eqn: fr(n, 1U, c.LMX_WALK_OP_EQ, 3U)
    atn: fr(eqn, 1U, c.LMX_WALK_OP_AT, 3U)
    ref(atn, 1U, holder)
    sz(atn, 2U, 1U)
    litn: fr(eqn, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 0) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref != 0 && lmx_int_value_known(gv\ref) = 0)), "EQ struct AT vs 0 -> false")

    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    eqn: fr(n, 1U, c.LMX_WALK_OP_EQ, 3U)
    atn: fr(eqn, 1U, c.LMX_WALK_OP_AT, 3U)
    ref(atn, 1U, holder)
    sz(atn, 2U, 1U)
    atn2: fr(eqn, 2U, c.LMX_WALK_OP_AT, 3U)
    ref(atn2, 1U, holder)
    sz(atn2, 2U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref != 0 && lmx_int_value_known(gv\ref) = 1)), "EQ struct AT vs same AT -> true")

    if: broken != 0
        c.printf("broken fixture %d\n", broken)
        return: 2
    ---
    if: failures != 0
        c.printf("lmx_walk_put_ref_selftest %d/%d FAILED\n", failures, checks)
        return: 1
    ---
    c.printf("OK %d checks\n", checks)
return: 0