# More formals are admitted by name than any table of the translator once
# held. Seventy methods g00 to g69 each have a formal of Model and read its
# v. go gives each of them a reference to Wide's Structure, which has v at
# another position: every one of the seventy formals is filled with
# another declaration than its own. Each gives v and its number: the sum
# is seventy times 40 and 0 to 69. Entry 7.
Model:
    int: v 4
end: Model

Wide:
    int: pad 1
    int: v 40
end: Wide

fn: g00 (Model: m) int
    return: m\v + 0
end: g00

fn: g01 (Model: m) int
    return: m\v + 1
end: g01

