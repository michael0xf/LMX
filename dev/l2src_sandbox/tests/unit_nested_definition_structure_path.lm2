# A definition a method returns reads a Structure of the unit by a path. The
# caller names no m: the definition reads its lexical source, the unit's m, at
# the call. 5 + 4 from a method and from the root; after m\v: 30 the next call
# gives 35. Entry 7.
Model:
    int: v 4
end: Model

m: merge Model

fn: makeUse (int: k) fn: () int
    fn: g0 () int
        return: k + m\v
    return: g0

u0: makeUse 5

fn: inner () int
    return: u0()
end: inner

int: a inner()
int: b u0()
m\v: 30
int: c inner()
int: d u0()
int: ok 7
if: a != 9 || b != 9 || c != 35 || d != 35
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
