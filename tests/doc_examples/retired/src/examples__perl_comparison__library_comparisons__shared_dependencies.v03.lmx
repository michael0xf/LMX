FxAppend:
    private:
        @: first
        @: second
    return: @
    append:
        throws: copy(FxThrows\sequence)
        private: @: empty (copy(()))
        return: FxSeqConcat\concat(parts := (empty; first; second))

FxApply:
    private:
        @: operation
        @: args
    return: @
    apply:
        throws: copy(FxThrows\call)
        private: @: outcome FxTry\attempt(operation := operation; args := args)
        if: outcome\ok = 0
            throw: FxCallFailure(outcome)
        return: outcome\value

FxEqualFields:
    private:
        @: first
        @: second
        @: same 0
    required: first second
    return: int
    equalFields:
        throws: copy(FxThrows\predicate)
        FxSeqInfo\get(first)
        FxSeqInfo\get(second)
        if: length(first) != length(second)
            return: 0
        return: FxSequenceDifference\find(
            first := first;
            second := second;
            same := same;
            count := length(first)
        ) < 0

FxEqualityTypes:
    array:
        []: value

FxKeyIndex:
    private:
        @: source
        @: key
        @: same 0
        int: stride 1
        int: field -1
    required: source key
    return: int
    find:
        throws: copy(FxThrows\predicate) FxShape
        private: int: size FxKeyShape\count(source; stride)
        private: int: i 0
        while: i < size
            private: @: candidate FxSeqRead\read(source; i)
            private: int: usable 1
            if: field >= 0
                FxSeqInfo\get(candidate)
                if: length(candidate) = 0
                    usable := 0
                else:
                    candidate := FxSeqRead\read(candidate; field)
            ---
            if: usable != 0
                if: FxValueSame\test(key; candidate; same) != 0
                    return: i
            ---
            i += stride
        return: -1

FxKeyShape:
    private:
        @: source
        int: stride 1
    required: source
    return: int
    count:
        throws: FxKernelFailure FxShape FxTypeToken
        FxSeqInfo\get(source)
        if: stride < 1
            throw: FxShape()
        private: int: size length(source)
        if: size % stride != 0
            throw: FxShape()
        return: size

FxMaybe:
    int: present 0
    @: value 0

FxNone:
    return: @FxMaybe
    none:
        return: (copy(FxMaybe))

FxOne:
    private: @: value
    return: @
    make:
        private: @: out (copy(()))
        sys\resize(out; 1)
        out[0] := value
        return: out

FxPair:
    @: first 0
    @: second 0

FxProjectValue:
    private:
        @: value
        @: projection 0
    required: value
    return: @
    get:
        throws: copy(FxThrows\call)
        if: projection = 0
            return: value
        return: FxApply\apply(projection; FxOne\make(value))

FxSeqAdmit:
    private:
        @: target
        @: value
    required: target value
    return: @
    admit:
        throws: FxKernelFailure FxTypeToken SequenceElement
        return: FxKernel\arrayAdmit(target := target; value := value)

FxSeqAllocate:
    private:
        int: arrayType
        int: count
    required: arrayType count
    return: @
    make:
        throws: FxKernelFailure FxTypeToken SequenceSize
        if: count < 0
            throw: SequenceSize()
        private: @: out (arrayType: [])
        private: @: info FxSeqInfo\get(out)
        if: count > info\maxLength
            throw: SequenceSize()
        sys\resize(out; count)
        return: out

FxSeqAppend:
    private:
        @: target
        @: values
    required: target values
    return: @
    append:
        throws: copy(FxThrows\mutation)
        FxSeqInfo\get(target)
        private: int: end length(target)
        return: FxSeqReplaceRange\replaceRange(target; end; end; values)

FxSeqBounds:
    private:
        @: source
        int: begin
        int: end
    required: source begin end
    return: int
    count:
        throws: FxKernelFailure FxTypeToken ReceiverIndex
        FxSeqInfo\get(source)
        if: begin < 0 || end < begin || end > length(source)
            throw: ReceiverIndex()
        return: end - begin

FxSeqCompress:
    private:
        @: source
        @: mask
    required: source mask
    return: @
    compress:
        throws: FxKernelFailure FxShape FxTypeToken ReceiverIndex SequenceElement SequenceSize
        private: @: info FxSeqInfo\get(source)
        FxSeqInfo\get(mask)
        private: int: count length(source)
        if: length(mask) != count
            throw: FxShape()
        private: @: flags FxSeqAllocate\make([]int; count)
        private: int: accepted 0
        private: int: i 0
        # Validate every mask value before constructing the selected result.
        while: i < count
            private: @: value FxSeqRead\read(mask; i)
            private: int: flag FxSeqInteger\read(value)
            flags[i] := flag
            if: flag != 0
                accepted += 1
            i += 1
        private: @: out FxSeqAllocate\make(info\arrayType; accepted)
        private: int: written 0
        i := 0
        while: i < count
            if: flags[i] != 0
                private: @: value FxSeqRead\read(source; i)
                FxKernel\arrayWrite(target := out; index := written; value := value)
                written += 1
            i += 1
        return: out

FxSeqConcat:
    private: @: parts
    required: parts
    return: @
    concat:
        throws: copy(FxThrows\sequence)
        FxSeqInfo\get(parts)
        private: int: count length(parts)
        private: int: arrayType []@
        private: int: elementType 0
        private: int: allDense 1
        private: int: i 0
        # Inspect all parts, including empty dense parts. Comparison uses
        # canonical full element codes from the common type resolver.
        while: i < count
            private: @: part FxSeqRead\read(parts; i)
            private: @: info FxSeqInfo\get(part)
            if: i = 0
                arrayType := info\arrayType
                elementType := info\elementType
            if: info\dense = 0 || info\elementType != elementType
                allDense := 0
            i += 1
        if: count = 0 || allDense = 0
            arrayType := []@
        private: @: out FxSeqAllocate\make(arrayType; 0)
        private: @: outInfo FxSeqInfo\get(out)
        private: int: total 0
        i := 0
        while: i < count
            private: @: part FxSeqRead\read(parts; i)
            total := FxSeqSize\sum(total; length(part); outInfo\maxLength)
            i += 1
        sys\resize(out; total)
        private: int: at 0
        i := 0
        while: i < count
            private: @: part FxSeqRead\read(parts; i)
            private: int: partSize length(part)
            private: int: j 0
            while: j < partSize
                private: @: value FxSeqRead\read(part; j)
                FxKernel\arrayWrite(target := out; index := at; value := value)
                at += 1
                j += 1
            i += 1
        return: out

FxSeqCount:
    private:
        @: items
        @: accepts
    required: items accepts
    return: int
    count:
        throws: copy(FxThrows\predicate)
        FxSeqInfo\get(items)
        private: int: count length(items)
        private: int: matched 0
        private: int: i 0
        while: i < count
            private: @: item FxSeqRead\read(items; i)
            private: @: value FxApply\apply(accepts; FxOne\make(item))
            if: FxSeqPredicate\truth(value) != 0
                matched += 1
            i += 1
        return: matched

FxSeqEmpty:
    private: @: source
    required: source
    return: @
    make:
        throws: FxKernelFailure FxTypeToken SequenceSize
        private: @: info FxSeqInfo\get(source)
        return: FxSeqAllocate\make(info\arrayType; 0)

FxSeqInfo:
    private: @: source
    required: source
    return: @
    get:
        throws: copy(FxThrows\kernel)
        return: FxKernel\arrayInfo(source := source)

FxSeqInteger:
    private: @: value
    required: value
    return: int
    read:
        throws: SequenceElement
        private: int: sample 0
        if: sys\typeof(value) != sys\typeof(@sample)
            throw: SequenceElement()
        return: \value

FxSeqPredicate:
    private: @: value
    required: value
    return: int
    truth:
        throws: FxPredicate
        private: int: sample 0
        if: sys\typeof(value) != sys\typeof(@sample)
            throw: FxPredicate()
        private: int: flag \value
        return: flag != 0

FxSeqPush:
    private:
        @: target
        @: value
    required: target value
    return: @
    append:
        throws: copy(FxThrows\mutation)
        private: @: info FxSeqInfo\get(target)
        private: @: ready FxSeqAdmit\admit(target; value)
        private: int: oldSize length(target)
        private: int: newSize FxSeqSize\sum(oldSize; 1; info\maxLength)
        sys\resize(target; newSize)
        FxKernel\arrayWrite(target := target; index := oldSize; value := ready)
        return: target

FxSeqRead:
    private:
        @: source
        int: index
    required: source index
    return: @
    read:
        throws: FxKernelFailure FxTypeToken ReceiverIndex
        return: FxKernel\arrayRead(source := source; index := index)

FxSeqReverse:
    private: @: source
    required: source
    return: @
    reverse:
        throws: copy(FxThrows\sequence)
        private: @: info FxSeqInfo\get(source)
        private: int: count length(source)
        private: @: out FxSeqAllocate\make(info\arrayType; count)
        private: int: i 0
        while: i < count
            private: @: value FxSeqRead\read(source; count - 1 - i)
            FxKernel\arrayWrite(target := out; index := i; value := value)
            i += 1
        return: out

FxSeqSize:
    private:
        int: base
        int: extra
        int: limit
    required: base extra limit
    return: int
    sum:
        throws: SequenceSize
        if: base < 0 || extra < 0 || base > limit
            throw: SequenceSize()
        if: extra > limit - base
            throw: SequenceSize()
        return: base + extra

FxSeqStore:
    private:
        @: target
        int: index
        @: value
    required: target index value
    write:
        throws: FxKernelFailure FxTypeToken ReceiverIndex SequenceElement
        private: @: ready FxSeqAdmit\admit(target; value)
        FxKernel\arrayWrite(target := target; index := index; value := ready)

FxSequenceDifference:
    private:
        @: first
        @: second
        @: same 0
        int: firstStart 0
        int: count
        int: secondStart 0
    required: first second count
    return: int
    find:
        throws: copy(FxThrows\predicate)
        FxSeqInfo\get(first)
        FxSeqInfo\get(second)
        if: firstStart < 0 || secondStart < 0 || count < 0
            throw: ReceiverIndex()
        if: firstStart > length(first) || secondStart > length(second)
            throw: ReceiverIndex()
        if: count > length(first) - firstStart || count > length(second) - secondStart
            throw: ReceiverIndex()
        private: int: i 0
        while: i < count
            if: FxValueSame\test(
                FxSeqRead\read(first; firstStart + i);
                FxSeqRead\read(second; secondStart + i);
                same
            ) = 0
                return: i
            i += 1
        return: -1

FxSome:
    private: @: value
    required: value
    return: @FxMaybe
    some:
        private: @: result (copy(FxMaybe))
        result\present := 1
        result\value := value
        return: result

FxStdCollect:
    private:
        @: next
        int: limit -1
    required: next
    return: @
    collect:
        throws: copy(FxThrows\mutation) FxCallFailure
        if: limit < -1
            throw: SequenceSize()
        private: @: out FxSeqAllocate\make([]@; 0)
        while: limit = -1 || length(out) < limit
            private: @: outcome FxTry\attempt(next; ())
            if: outcome\ok = 0
                if: FxEqualFields\equalFields(outcome\failure; sys\name(Stop)) != 0
                    return: out
                throw: FxCallFailure(outcome)
            FxSeqPush\append(out; outcome\value)
        return: out

FxStdCut:
    private:
        @: items
        int: count
    required: items count
    return: @
    take:
        throws: copy(FxThrows\sequence)
        return: FxSeqSlice\slice(items; 0; FxStdCutIndex\get(items; count))
    drop:
        throws: copy(FxThrows\sequence)
        return: FxSeqSlice\slice(items; FxStdCutIndex\get(items; count); length(items))
    splitAt:
        throws: copy(FxThrows\sequence)
        return: FxStdPair\make(take(items; count); drop(items; count))

FxStdCutIndex:
    private:
        @: items
        int: count
    required: items count
    return: int
    get:
        throws: copy(FxThrows\kernel)
        FxSeqInfo\get(items)
        if: count < 0
            return: 0
        if: count > length(items)
            return: length(items)
        return: count

FxStdCycle:
    private:
        @: items
        int: count
        int: rejectNegative 0
    required: items count
    return: @
    cycle:
        throws: copy(FxThrows\sequence)
        if: rejectNegative != 0 && count < 0
            throw: SequenceSize()
        private: @: info FxSeqInfo\get(items)
        if: count <= 0 || length(items) = 0
            return: FxSeqEmpty\make(items)
        if: count > info\maxLength / length(items)
            throw: SequenceSize()
        return: FxSeqConcat\concat(FxStdReplicate\replicate(items; count))

FxStdMaybeMap:
    private:
        @: items
        @: transform
    required: items transform
    return: @
    filterMap:
        throws: copy(FxThrows\traversal) SequenceElement
        return: FxStdMaybeMapEngine\run(items; transform; 0; 0)
    mapWhile:
        throws: copy(FxThrows\traversal) SequenceElement
        return: FxStdMaybeMapEngine\run(items; transform; 1; 0)
    findMap:
        throws: copy(FxThrows\traversal) SequenceElement
        return: FxStdMaybeMapEngine\run(items; transform; 0; 1)

FxStdMaybeMapEngine:
    private:
        @: items
        @: transform
        int: stopOnNone
        int: firstOnly
    required: items transform stopOnNone firstOnly
    return: @
    run:
        throws: copy(FxThrows\traversal) SequenceElement
        FxSeqInfo\get(items)
        private: @: out FxSeqAllocate\make([]@; 0)
        private: int: i 0
        while: i < length(items)
            private: @: packed FxApply\apply(transform; FxOne\make(FxSeqRead\read(items; i)))
            private: @FxMaybe: answer packed
            if: answer\present != 0
                if: firstOnly != 0
                    return: answer
                FxSeqPush\append(out; answer\value)
            else:
                if: stopOnNone != 0
                    break
            ---
            i += 1
        if: firstOnly != 0
            return: FxNone\none()
        return: out

FxStdPair:
    private:
        @: first
        @: second
    required: first second
    return: @
    make:
        private: @: pair (copy(FxPair))
        pair\first := first
        pair\second := second
        return: pair

FxStdReplicate:
    private:
        @: value
        int: count
    required: value count
    return: @
    replicate:
        throws: FxKernelFailure FxTypeToken SequenceSize
        private: int: size count
        if: size < 0
            size := 0
        private: @: out FxSeqAllocate\make([]@; size)
        private: int: i 0
        while: i < size
            out[i] := value
            i += 1
        return: out

FxSum:
    private:
        @: items
        @: initial (0 record)
    return: @
    sum:
        throws: FxRecordArity
        return: ((+ \initial copy(items)) record)

FxTextCycle:
    private:
        []char: items
        int: count
        int: rejectNegative 0
    required: items count
    return: []char
    cycle:
        throws: copy(FxThrows\sequence)
        return: \FxStdCycle\cycle(items; count; rejectNegative)

