    while: i < l2_mres_n
        if: l2_mres_body_ns[i] >= 0 && c.fprintf(l2_out, "    fn: l2_merge_body_build_%d (@: Lmx target; @: Lmx l2_entry_unit; @: LmxArena l2_program_arena) int\n", i) < 0
            fclose(l2_out)
            return: 1
