    # a numeric value that happens to be zero is never reclassified at runtime.
    if: c.lm_compiler_oc_is_ref(ty) != 0
        if: mag != 0U
            return: (cast: (int) (c.lm_compiler_rw_refuse(source_node, "a reference compared with a number other than 0")))
        return: (cast: (int) (lm_compiler_rw_reference_value(0, 0, ty, parent, out)))
    ---
    if: usuf != 0 && (ty = 0 || ty = 1)
        return: (cast: (int) (c.lm_compiler_rw_refuse(source_node, "a U literal in a signed type")))
    if: neg != 0 && (ty = 2 || ty = 3 || ty = 36)
        return: (cast: (int) (c.lm_compiler_rw_refuse(source_node, "a literal out of its type's range")))
    if: ty = 0
