fn: lm_compiler_cast_resolve (const: (@: source_node c.LmP0Node); @: out_ty int; @: dest c.L2Tx) int
    @@@: foreign_name_cell c.LmP0Text (cast: (@@@: c.LmP0Text) (@ c.l2_foreign_name))
