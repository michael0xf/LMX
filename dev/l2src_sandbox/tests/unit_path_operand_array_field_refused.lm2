# The path resolves to an ordinary Array reference. It is valid as a value,
# but adding a number to that reference is not. Refusal belongs to the
# numeric receiving operation, not an artificial restriction on path leaves.
# The positive Array-field value witnesses check the complementary case.
Model:
    []: int buf 4
    int: value 0
end: Model
fn: f (Model: m) int
    return: m\buf + 1
end: f
m: merge: Model
sendMessage: exit(exit_code: f(m); stdout: ""; stderr: "")
return
