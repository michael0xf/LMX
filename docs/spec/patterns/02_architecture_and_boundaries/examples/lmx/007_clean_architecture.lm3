Policy:
    int: income
    int: expense
    return: int
    eligible:
        if: income - expense >= 30
            return: 1
        return: 0

Presenter:
    int: decision
    return: int
    render:
        if: decision != 0
            return: 200
        return: 422

UseCase:
    int: income
    int: expense
    @: output
    return: int
    execute:
        return: output(decision := Policy\eligible(income := income; expense := expense))
    demo:
        return: execute(income := 100; expense := 60; output := Presenter\render)
