        if: l2_rw_take(stmt, into, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_put(into, slot, node) != 0
            return: 1
        return: 0
    if: l2_text_eq(h, "sendMessage")
        if: l2_rw_send(stmt, into, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_put(into, slot, node) != 0
            return: 1
        return: 0
