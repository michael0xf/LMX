# N4 slice 1, staged (LMX_semantics.ru.md #method-parts, #dynamic): the places of a split call are found by the layout of
# its data. A formal can hold data of any layout, and rows for layouts known only at run time are not built yet:
# refused at the data operand.
S:
    int: x
    x: x + 1
end: S
D:
    int: x 1
end: D
fn: bump (D: d) int
    call: S d
    return: 0
end: bump
int: a bump(D)
return
