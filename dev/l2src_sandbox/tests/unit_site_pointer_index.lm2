# Native pointer indexing: both the base and index use the same activation's
# selected places across the inline if. Its repeated i and p declarations
# assign those places; there is no restoration of shadow bindings afterward.
fn: write (@: p int; @: other int) int
    int: i 0
    p[i]: 11
    if: 1 = 1
        p[i]: 12
        int: i 1
        p[i]: 22
        @: p int other
        p[i]: 44
    end: if
    p[i]: 11
return: 7
[]: int first 2
[]: int second 2
first[0]: 1
first[1]: 2
second[0]: 3
second[1]: 4
int: result write(@first[0], @second[0])
if: result != 7 || first[0] != 12 || first[1] != 22 || second[0] != 3 || second[1] != 11
    result: 81
sendMessage: exit(exit_code: result; stdout: ""; stderr: "")
return
