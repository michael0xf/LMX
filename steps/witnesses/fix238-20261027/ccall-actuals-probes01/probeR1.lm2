# Probe R1 (machine module, --library --machine show): the emit:12899 shape, a literal-led arithmetic actual
# `0 - 1` before a later actual that runs a prototyped door call.
predef: "probe_calls.h.lm1"
fn: show (int: oi) int
    if: c.take(oi, 0 - 1, c.pick(oi)) != 0
        return: 1
    return: 0
end: show
