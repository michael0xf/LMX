predef: "lmx_value_owned.h.lm1"
predef: "lmx_implements.h.lm1"
include: "<stdlib.h>"

# A cell of one of the arena's arrays (Lingvamyxa_spec.txt 2, 6.5): the arena hands it out
# from its array of that kind and type -- the array is made on the first request and grows
# by adding chunks, so a cell's address never moves.  What a constructor gets back is the
# address of the cell inside that array; stride, kind and type belong to the array, and the
# arena's index answers them for any address in it.  There is no owner-local list and no
# per-value array: the array is the arena's and the type is the array's.
fn: lmx_value_allocate_owned (@: LmxArena arena; size_t: stride; int: kind; int: type) @: void
    if: arena = 0 || stride = 0U
        return: 0
    ---
return: lmx_arena_take(arena, stride, kind, type)

# Initial root construction, not reparenting of an existing occurrence. The
# header lives in the STRUCT domain (SPEC 2: only a Structure target has
# node/len/data); its child-pointer array is a separate CHILDREN range opened
# later by lmx_arena_refs_open_owned.
fn: lmx_node_new_owned (@: LmxArena arena) @: Lmx
    @: Lmx value (cast: (@: Lmx) lmx_value_allocate_owned(arena, c.sizeof(c.Lmx), c.LMX_KIND_STRUCT, c.LMX_TYPE_STRUCT))
    if: value != 0
        value\node: 0
        value\len: 0
        value\data: 0
    ---
    return: value

fn: lmx_struct_new_owned (@: Lmx parent; @: LmxArena arena) @: Lmx
    @: Lmx value
    if: parent = 0
        return: 0
    value: lmx_node_new_owned(arena)
    if: value != 0
        value\node: parent
    ---
    return: value

# The caller fills addr/sig before publishing this fresh entry into the graph.
# Existing callable records are not mutable through this construction API.
fn: lmx_method_new_owned (@: LmxArena arena) @: LmxMethod
    @: LmxMethod value (cast: (@: LmxMethod) lmx_value_allocate_owned(arena, c.sizeof(c.LmxMethod), c.LMX_KIND_METHOD, c.LMX_TYPE_METHOD))
    if: value != 0
        value\addr: 0
        value\sig: 0U
    ---
    return: value

fn: lmx_callable_new_owned (@: LmxArena arena) @: LmxCallable
    @: LmxCallable value (cast: (@: LmxCallable) lmx_value_allocate_owned(arena, c.sizeof(c.LmxCallable), c.LMX_DOMAIN_KIND_CALLABLE, c.LMX_DOMAIN_CALLABLE))
    if: value != 0
        value\method\addr: 0
        value\method\sig: 0U
        value\header: 0
        value\body: 0
        value\return_arg: 0
    ---
    return: value

fn: lmx_int_new_owned (@: LmxArena arena) @: void
    int: zero 0
    @: int value (cast: (@: int) lmx_value_allocate_owned(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT))
    if: value != 0
        \value: 0
    ---
    return: (cast: (@: void) value)

fn: lmx_size_new_owned (@: LmxArena arena) @: void
    size_t: zero 0U
    @: size_t value (cast: (@: size_t) lmx_value_allocate_owned(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_SIZE_T))
    if: value != 0
        \value: 0U
    ---
    return: (cast: (@: void) value)

fn: lmx_unsigned_new_owned (@: LmxArena arena) @: void
    unsigned: zero 0U
    @: unsigned value (cast: (@: unsigned) lmx_value_allocate_owned(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_UNSIGNED))
    if: value != 0
        \value: 0U
    ---
    return: (cast: (@: void) value)

fn: lmx_ulong_new_owned (@: LmxArena arena) @: void
    ulong: zero 0U
    @: ulong value (cast: (@: ulong) lmx_value_allocate_owned(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_ULONG))
    if: value != 0
        \value: 0U
    ---
    return: (cast: (@: void) value)

fn: lmx_uchar_new_owned (@: LmxArena arena) @: void
    char: zero '\0'
    @: char value (cast: (@: char) lmx_value_allocate_owned(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_UNSIGNED_CHAR))
    if: value != 0
        \value: '\0'
    ---
    return: (cast: (@: void) value)

fn: lmx_charptr_new_owned (@: LmxArena arena) @: void
    @: char zero 0
    @@: char value (cast: (@@: char) lmx_value_allocate_owned(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR_PTR))
    if: value != 0
        \value: 0
    ---
    return: (cast: (@: void) value)

fn: lmx_charptr_value_known (@: void cell) @: char
    @@: char p
    if: cell = 0
        return: 0
    p: (cast: (@@: char) cell)
    return: \p

fn: lmx_charptr_store_known (@: void cell; @: char value) int
    @@: char p
    if: cell = 0
        return: 1
    p: (cast: (@@: char) cell)
    \p: value
    return: 0

fn: lmx_pointer_new_owned (int: type; @: LmxArena arena) @: void
    @: void zero 0
    @@: void value
    if: type < c.LMX_TYPE_POINTER_BASE
        return: 0
    value: (cast: (@@: void) lmx_value_allocate_owned(arena, c.sizeof(zero), c.LMX_KIND_PRIMITIVE, type))
    if: value != 0
        \value: 0
    ---
    return: (cast: (@: void) value)

fn: lmx_pointer_value_known (@: void cell) @: void
    @@: void p
    if: cell = 0
        return: 0
    p: (cast: (@@: void) cell)
    return: \p

fn: lmx_pointer_store_known (@: void cell; @: void value) int
    @@: void p
    if: cell = 0
        return: 1
    p: (cast: (@@: void) cell)
    \p: value
    return: 0

# Closed-unit type proof supplies the type, not a process-global catalog.
# Explicit raw/unknown addresses are outside these helper preconditions.
fn: lmx_char_value_known (@: void cell) int
    @: char p
    if: cell = 0
        return: -1
    p: (cast: (@: char) cell)
    # Preserve unsigned-byte semantics even when the host char is signed.
    return: ((cast: (int) \p) & 255)

fn: lmx_ulong_value_known (@: void cell) ulong
    @: ulong p
    if: cell = 0
        return: 0U
    p: (cast: (@: ulong) cell)
    return: \p

fn: lmx_ulong_store_known (@: void cell; ulong: value) int
    @: ulong p
    if: cell = 0
        return: 1
    p: (cast: (@: ulong) cell)
    \p: value
    return: 0

fn: lmx_uchar_value_known (@: void cell) unsigned
    @: char p
    if: cell = 0
        return: 0U
    p: (cast: (@: char) cell)
    return: (cast: (unsigned) ((cast: (int) \p) & 255))

fn: lmx_uchar_store_known (@: void cell; unsigned: value) int
    @: char p
    if: cell = 0
        return: 1
    p: (cast: (@: char) cell)
    \p: (cast: (char) (value & 255U))
    return: 0

fn: lmx_int_value_known (@: void cell) int
    @: int p
    if: cell = 0
        return: 0
    p: (cast: (@: int) cell)
    return: \p

fn: lmx_int_store_known (@: void cell; int: value) int
    @: int p
    if: cell = 0
        return: 1
    p: (cast: (@: int) cell)
    \p: value
    return: 0

fn: lmx_size_value_known (@: void cell) size_t
    @: size_t p
    if: cell = 0
        return: 0U
    p: (cast: (@: size_t) cell)
    return: \p

fn: lmx_size_store_known (@: void cell; size_t: value) int
    @: size_t p
    if: cell = 0
        return: 1
    p: (cast: (@: size_t) cell)
    \p: value
    return: 0

fn: lmx_unsigned_value_known (@: void cell) unsigned
    @: unsigned p
    if: cell = 0
        return: 0U
    p: (cast: (@: unsigned) cell)
    return: \p

fn: lmx_unsigned_store_known (@: void cell; unsigned: value) int
    @: unsigned p
    if: cell = 0
        return: 1
    p: (cast: (@: unsigned) cell)
    \p: value
    return: 0
