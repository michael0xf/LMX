+# Both contracts use the same ordinary args/return topology. The declared
+# witness is filled separately, without allocating a pointer cell and then
+# replacing it by its Model or a fabricated unit/default pointee.
+fn: l2_rw_contract_parts (int: parent; int: n; int: nr; @: int out; @: int inputs; @: int returns) int
+    if: n < 0 || nr < 0 || nr > 1
+        return: 1
+return: (cast: (int) (l2_rw_plain(parent, 2, out) != 0 || l2_rw_plain(\out, n, inputs) != 0 || l2_rw_put(\out, 0, \inputs) != 0 || l2_rw_plain(\out, nr, returns) != 0 || l2_rw_put(\out, 1, \returns) != 0))
+
+# A declared input AND a declared result preserve their actual named Model
+# as ordinary graph data. The result index is -1, as in the existing type
+# inventory. Hidden transported inputs keep their closed value witness.
+# COUNT notes the same copy dependency which either FILL representation uses.
+fn: l2_declared_graph_witness (const: @(char holder); int: slot; int: mi; int: input; const: @(char models); int: emit; @: int handled) int
+    int: model
+    int: callable
+    if: handled = 0
+        return: 1
+    \handled: 0
+    if: mi < 0 || mi >= l2_m_n || input < -1 || input >= l2_m_arity[mi]
+        return: 0
+    model: l2_input_model(mi, input)
+    callable: l2_cf_get(mi, input)
+    if: model < 0 && callable < 0
+        return: 0
+    \handled: 1
+    if: model >= 0 && l2_use_model(model) != 0
+        return: 1
+    if: emit = 0
+        return: 0
+    if: holder = 0 || models = 0 || slot < 0
+        return: 1
+    if: callable >= 0
+        if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) ", holder, slot) < 0 || l2_emit_build_occ(callable) != 0
+            return: 1
+        return: (cast: (int) (fputs(")) != 0\n            return: 1\n", l2_out) < 0))
+    ---
+return: (cast: (int) (c.fprintf(l2_out, "        if: lmx_arena_ref_store(%s, %dU, (cast: (@: void) %s[%d])) != 0\n            return: 1\n", holder, slot, models, model) < 0))
+
