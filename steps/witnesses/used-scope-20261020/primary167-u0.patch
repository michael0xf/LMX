+        return: l2_emit_ccall_value(value, mi, ind, 0)
+    if: role = 1
+        if: l2_primary_cast_value(value, @ type, text, @ operand) != 0 || l2_emit_native_span(@ operand, mi, ind, result, 0) != 0
+            return: 1
+        return: l2_tx_join(dest, "(cast: (", text\data, ") ", result\data, ")")
+    if: l2_primary_array_value(value, mi, @ operand) != 0 || l2_emit_native_span(@ operand, mi, ind, result, 0) != 0
+        return: 1
+    t: l2_tn
+    l2_tn: l2_tn + 1
+    if: c.fprintf(l2_out, "%s@: LmxArray l2_ad%d %s\n%sif: l2_ad%d = 0\n", ind, t, result\data, ind, t) < 0 || l2_emit_null_use(mi, ind) != 0
+        return: 1
+    if: c.fprintf(l2_out, "%ssize_t: l2_t%d l2_ad%d\\array.size\n", ind, t, t) < 0
+        return: 1
+return: l2_tx_temp(dest, t)
