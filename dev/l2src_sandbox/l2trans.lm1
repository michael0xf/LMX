        # already refuses an unresolvable assignment target with a location
        # ("assignment target must be a declared typed mutable value") before
        # emission runs at all -- undeclared and declared-below both measured
        # refused there (FABLE-SONNET-UNIT-FIELD-WRITE-20260923-129). This was
        # a SILENT return: 1 regardless, reachable the moment check-time and
        # emit-time own-field lookup ever disagree (exactly what happened
        # here: l2_own_find_last lacked the same unit-field fallback
        # l2_own_find already had, so a name check_body accepted -- a
        # backward-visible unit field -- still fell all the way through
        # emission unresolved). Translation must never fail without a
        # located diagnostic; this is the same one check_body already gives,
        # as a backstop, not a new rule.
        if: l2_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_frame_head(stmt, "return") = 0 && oi < 0 && si < 0 && fi < 0 && l2_head_is_call(fr\head, fr\body, fr\flags, mi) = 0 && l2_is_known(fr\head) = 0 && raw != 0
            return: l2_error(l2_src, stmt, "assignment target must be a declared typed mutable value")
        ---
    # A body ending in an if/else can leave the last emitted line multiple
    # levels deeper than its caller's next statement. Source cutters need
    # not be frame trailers, so close this body explicitly before returning
    # to the caller. This is L1 structure only; no loop action.
    if: need_cut != 0 && c.fprintf(l2_out, "%s---\n", ind) < 0
        return: 1
    if: empty_body != 0
        return: l2_emit_empty_body(emitted_from, ind)
return: 0

# A fresh typed cell for own row oi into `<slot>[0]`, at indent `ind`: the builder's cells.
# Every primitive gets an independent cell, checked, with `fail` (and `fail2`) when it could not be made. A type with
# no cell emits nothing, as the builder never did.
# A fresh typed cell of own storage type ty into `slot`[0] (an Array of n elements), with `fail`
# (and `fail2`) when it cannot be made: the one typed-cell emission, for an own field and a header
# part alike.
fn: l2_emit_cell_new_ty (int: ty; size_t: n; const: @(char ind); const: @(char slot); const: @(char fail); const: @(char fail2)) int
    []: char pty 96
    if: ty = 1 && c.fprintf(l2_out, "%s%s[0]: lmx_char_new_owned(l2_program_arena)\n", ind, slot) < 0
        return: 1
    if: ty = 2 && c.fprintf(l2_out, "%s%s[0]: lmx_size_new_owned(l2_program_arena)\n", ind, slot) < 0
        return: 1
    if: ty = 0 && c.fprintf(l2_out, "%s%s[0]: lmx_int_new_owned(l2_program_arena)\n", ind, slot) < 0
        return: 1
    if: ty = 3 && c.fprintf(l2_out, "%s%s[0]: lmx_unsigned_new_owned(l2_program_arena)\n", ind, slot) < 0
        return: 1
    if: ty = 36 && c.fprintf(l2_out, "%s%s[0]: lmx_ulong_new_owned(l2_program_arena)\n", ind, slot) < 0
        return: 1
    if: l2_own_is_pointer(ty) != 0 && (l2_ptr_cell_type(l2_oc_ft(ty), pty) != 0 || c.fprintf(l2_out, "%s%s[0]: lmx_pointer_new_owned(%s, l2_program_arena)\n", ind, slot, pty) < 0)
        return: 1
    if: ty = 4 && c.fprintf(l2_out, "%s%s[0]: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_INT, %zuU, l2_program_arena)\n", ind, slot, n) < 0
        return: 1
    if: ty = 5 && c.fprintf(l2_out, "%s%s[0]: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_CHAR, %zuU, l2_program_arena)\n", ind, slot, n) < 0
        return: 1
    if: ty = 7 && c.fprintf(l2_out, "%s%s[0]: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_SIZE_T, %zuU, l2_program_arena)\n", ind, slot, n) < 0
        return: 1
    if: ty = 37 && c.fprintf(l2_out, "%s%s[0]: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_ULONG, %zuU, l2_program_arena)\n", ind, slot, n) < 0
        return: 1
    if: ty = 8 && c.fprintf(l2_out, "%s%s[0]: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_UNSIGNED_CHAR, %zuU, l2_program_arena)\n", ind, slot, n) < 0
        return: 1
    if: l2_oc_is_parray(ty) != 0 && c.fprintf(l2_out, "%s%s[0]: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_POINTER_BASE + %d, %zuU, l2_program_arena)\n", ind, slot, l2_oc_ft(ty), n) < 0
        return: 1
    if: ty != 0 && ty != 1 && ty != 2 && ty != 3 && ty != 36 && l2_own_is_pointer(ty) = 0 && l2_own_is_array(ty) = 0
        return: 0
    if: c.fprintf(l2_out, "%sif: %s[0] = 0\n%s    %s\n", ind, slot, ind, fail) < 0
        return: 1
    if: fail2 != 0 && c.fprintf(l2_out, "%s    %s\n", ind, fail2) < 0
        return: 1
return: 0

# Own field oi's cell: an own Structure field is a direct slot, empty until it is bound (-189
# c3b-3): no cell; an Array has its declared length.
fn: l2_emit_cell_new (int: oi; const: @(char ind); const: @(char slot); const: @(char fail); const: @(char fail2)) int
    size_t: n 0U
    []: char key 128
    if: l2_own_is_slot(oi) != 0
        return: 0
    if: l2_own_is_array(l2_own_ty[oi]) != 0
        n: l2_literal_value(l2_own_count[oi])
    if: l2_emit_cell_new_ty(l2_own_ty[oi], n, ind, slot, fail, fail2) != 0
        return: 1
    if: c.sprintf(key, "%s[0]", slot) < 0
        return: 1
return: l2_emit_source_name(key, l2_own_name[oi], ind, fail, fail2)

# The own storage type of method mi's result cell in its `return` part, or -1 for no cell: a
# number by the trampoline's class, a pointer by its return code (the table of l2_emit_sig).
fn: l2_ret_cell_ty (int: mi) int
    int: rt l2_sig_ret(mi)
    int: cls l2_tramp_class(mi)
    int: fi rt - 100
    if: rt = 1
        return: 1
    if: cls = 1
        return: 0
    if: cls = 2
        return: 2
    if: cls = 3
        return: 3
    if: cls = 4
        return: 36
    if: rt = 3
        return: l2_oc_pointer(12)
    if: rt = 16
        return: l2_oc_pointer(16)
    if: rt = 35
        return: l2_oc_pointer(3)
    if: rt = 32
        return: l2_oc_pointer(17)
    if: rt >= 100 && fi < l2_foreign_n && l2_foreign_depth[fi] > 0
        return: l2_oc_pointer(rt)
return: 0 - 1

# THE HEADER PARTS OF METHOD i (-189 c4; form A): its signature is an ordinary graph field.
# - args, slot 0: one child per declared formal, in order -- a typed cell of the formal's type
#   (the prototype's 0), a callable formal's contract occurrence, a Structure formal's named
#   Structure (its type); a type with no cell leaves its slot empty.
# - return, slot 1: no child for a `sub`, else one -- the result's typed cell, or empty when the
#   result type has no cell.  The walked root's CALL refers to that cell (l2_rw_call).
# Then `native`: the trampoline for a method with a native body, 0 otherwise.
# Does a method's header part hold a char cell -- a char formal in `args`, a char result in
# `return` (l2_emit_parts)? These cells are owned; the literal table is used only
# to transport a char actual's immutable value to the callable ABI.
fn: l2_parts_have_char () int
    int: i 0
    int: j
    while: i < l2_m_n
        j: 0
        while: i != l2_e && j < l2_m_arity[i]
            if: l2_cf_get(i, j) < 0 && l2_nsty_get(i, j) < 0 && l2_own_ty_of_param(l2_ft(i, j)) = 1
                return: 1
            j: j + 1
        ---
        j: 0
        while: i != l2_e && j < l2_m_dyn[i]
            if: l2_own_of_dt(l2_dt(i, j)) = 1
                return: 1
            j: j + 1
        ---
        if: i != l2_e && l2_m_ret[i] != 8 && l2_ret_cell_ty(i) = 1
            return: 1
        i: i + 1
    ---
return: 0

fn: l2_emit_parts (int: i) int
    int: j 0
    int: ty
    []: char place 96
    if: fputs("        l2_entry_leaf: ", l2_out) < 0 || l2_emit_build_occ(i) != 0 || fputs("\n        if: l2_entry_leaf = 0\n            return: 1\n", l2_out) < 0
        return: 1
    # R9: a named Structure's procedure declares no formals and no result -- no parts; its native word goes on the
    # Structure, its occurrence.
    if: i = l2_e || l2_m_nsof(i) >= 0
        return: l2_emit_native_word(i)
    if: fputs("        l2_fkid: lmx_struct_new_owned(l2_entry_leaf, l2_program_arena)\n        if: l2_fkid = 0 || lmx_arena_ref_store(l2_entry_leaf, 0U, (cast: (@: void) l2_fkid)) != 0\n            return: 1\n", l2_out) < 0
        return: 1
    if: l2_m_arity[i] + l2_m_dyn[i] > 0 && c.fprintf(l2_out, "        if: lmx_arena_refs_open_owned(l2_program_arena, l2_fkid, %uU) != 0\n            return: 1\n", (cast: (unsigned) (l2_m_arity[i] + l2_m_dyn[i]))) < 0
        return: 1
    while: j < l2_m_arity[i]
        ty: l2_own_ty_of_param(l2_ft(i, j))
        if: l2_cf_get(i, j) >= 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_fkid, %uU, (cast: (@: void) lmx_arena_ref_struct(l2_entry_unit, %uU))) != 0\n            return: 1\n", (cast: (unsigned) j), (cast: (unsigned) (l2_occ_slot(l2_cf_get(i, j))))) < 0
            return: 1
        if: l2_cf_get(i, j) < 0 && l2_nsty_get(i, j) >= 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_fkid, %uU, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n", (cast: (unsigned) j), l2_nsty_get(i, j)) < 0
            return: 1
        if: l2_cf_get(i, j) < 0 && l2_nsty_get(i, j) < 0 && ty >= 0
            if: c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_fkid, %uU)\n        if: l2_entry_slot = 0\n            return: 1\n", (cast: (unsigned) j)) < 0 || l2_emit_cell_new_ty(ty, 0U, "        ", "l2_entry_slot", "return: 1", 0) != 0
                return: 1
        ---
        if: c.sprintf(place, "lmx_arena_ref_cell(l2_fkid, %uU)", (cast: (unsigned) j)) < 0 || l2_emit_source_name(place, l2_fn(i, j), "        ", "return: 1", 0) != 0
            return: 1
        j: j + 1
    ---
    # The dynamic inputs after the declared formals: through-names are part of the signature (book :1182), a cell of
    # each one's type.
    j: 0
    while: j < l2_m_dyn[i]
        ty: l2_own_of_dt(l2_dt(i, j))
        if: ty >= 0
            if: c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_fkid, %uU)\n        if: l2_entry_slot = 0\n            return: 1\n", (cast: (unsigned) (l2_m_arity[i] + j))) < 0 || l2_emit_cell_new_ty(ty, 0U, "        ", "l2_entry_slot", "return: 1", 0) != 0
                return: 1
        ---
        if: c.sprintf(place, "lmx_arena_ref_cell(l2_fkid, %uU)", (cast: (unsigned) (l2_m_arity[i] + j))) < 0 || l2_emit_source_name(place, l2_dn(i, j), "        ", "return: 1", 0) != 0
            return: 1
        j: j + 1
    ---
    if: fputs("        l2_fkid: lmx_struct_new_owned(l2_entry_leaf, l2_program_arena)\n        if: l2_fkid = 0 || lmx_arena_ref_store(l2_entry_leaf, 1U, (cast: (@: void) l2_fkid)) != 0\n            return: 1\n", l2_out) < 0
        return: 1
    if: l2_m_ret[i] != 8 && fputs("        if: lmx_arena_refs_open_owned(l2_program_arena, l2_fkid, 1U) != 0\n            return: 1\n", l2_out) < 0
        return: 1
    if: l2_m_ret[i] != 8 && l2_ret_cell_ty(i) >= 0
        if: fputs("        l2_entry_slot: lmx_arena_ref_cell(l2_fkid, 0U)\n        if: l2_entry_slot = 0\n            return: 1\n", l2_out) < 0 || l2_emit_cell_new_ty(l2_ret_cell_ty(i), 0U, "        ", "l2_entry_slot", "return: 1", 0) != 0
            return: 1
    ---
return: l2_emit_native_word(i)

# One native completion criterion for prototype, definition and publication.
# Descriptor-only contracts have no body. PAP body compilation is a separate
# existing implementation debt, not a hosted-method or language exception.
fn: l2_native_entry_ready (int: i) int
return: (cast: (int) ((l2_m_native(i) != 0 || l2_mad_on(i) != 0) && l2_pap_on(i) = 0))

# The native word of method i's occurrence, l2_entry_leaf: its trampoline, unless the method is walked.
fn: l2_emit_native_word (int: i) int
    # A T7 host's return is the signature frame's trailer, so the method body is
    # empty, but the native function still builds the node. It is not walked.
    if: l2_native_entry_ready(i) = 0
        return: 0
    ---
    # The test knob `--walk-methods` selects a completed portable source body,
    # including a zero-width body; -1 still means no completed lowering.
    if: i != l2_e && l2_walk_methods != 0 && l2_m_steps != 0 && l2_m_steps[i] >= 0 && l2_m_walkable[i] != 0
        return: 0
    if: fputs("        l2_entry_leaf\\native: (cast: (LmxEntry) ", l2_out) < 0 || l2_write_sym(l2_out, i) != 0 || fputs("_tr)\n", l2_out) < 0
        return: 1
return: 0

fn: l2_emit_unit (const: @(char out_path)) int
    int: i 0
    int: k
    int: oi
    []: char sx_own 192
    L2Tx: sx_tx
    @: L2Tx sx l2_tx_local(@ sx_tx, sx_own, 192U)
    []: char sx_name 48
    []: char pty 96
    unsigned: kids
    int: fx
    size_t: bseq
    @: FILE chk
    int: had 0
    int: nref 0
    if: out_path = 0 || l2_m_n = 0 || (l2_library_mode = 0 && l2_e < 0)
        return: 1
    # Merge sites are scanned before output so locals and result slots have
    # their final sizes. Throw/Message dependency closure was computed during
    # analysis, before METHOD.sig interning.
    # The widest merge across methods (the entry is one) must be known before
    # the preamble and any callable-local operand array are written.
    l2_merge_max: 0
    i: 0
    while: i < l2_m_n
        l2_vis_method(i)
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0
            if: l2_merge_scan(l2_m_body[i]\as\structure, i) != 0
                return: 1
            ---
        ---
        i: i + 1
    ---
    l2_vis_on: 0
    i: 0
    # Namespace references were resolved before semantic checking; emission
    # only sizes construction scratch for their already fixed operands.
    fx: 0
    l2_merge_build: 0
    l2_ns_payload_pass: 0
    while: fx < l2_nsf_n
        if: l2_nsf_kind[fx] = 3 && l2_nsf_ref[fx] >= 0 && l2_ns_eternal[l2_nsf_ref[fx]] < 0
            l2_merge_build: 1
            if: 1 > l2_merge_max
                l2_merge_max: 1
            ---
        ---
        fx: fx + 1
    ---
    if: l2_layout_owns() != 0
        return: 1
    if: l2_graph_places_seed() != 0
        return: 1
    # Validate the completed capture contracts before quiet graph counting can
    # replace a located field error with a generic unwalkable-body diagnostic.
    fx: 0
    while: fx < l2_mcap_n
        if: l2_mcap_ns[fx] >= 0
            if: l2_cap_fields(l2_mcap_model[fx], l2_mcap_name[fx], l2_mcap_ns[fx], 0, 0) < 0
                return: 1
            ---
        ---
        fx: fx + 1
    ---
    # Native compilation does not erase the executable graph. All occurrences,
    # including the unit, use the common count/emission passes.
    l2_rw_emit: 0
    l2_rw_t: 0
    l2_rw_pn: 0
    l2_d105_n: 0
    l2_rw_mi: l2_e
    # The methods' frames are counted too (-193 T4a), before the occurrences' widths are written.
    if: l2_rw_methods_count() != 0
        return: 1
    # Accepted source producers are committed before final prefix/base sizes.
    # PLACE records actual constructor edges without emitting a second graph.
    if: l2_graph_places_seed() != 0 || l2_source_ownership_commit() != 0 || l2_rw_methods_emit(1) != 0 || l2_source_places_bind() != 0
        return: 1
    if: l2_cfl_receiving_validate() != 0
        return: 1
    l2_unit_base: l2_m_width(l2_e)
    # R9: now a Structure with a procedure has its whole width -- its steps too -- and a merge copies all of it: the
    # merge results' rows again.
    if: l2_mrs_rebuild_all() != 0
        return: 1
    # And the named Structures' bodies (steps/named-struct-exec.md, slice 2).
    # D-105 native (steps/d105-native.md): the formals admitted by name and the unit's pair tables,
    # final before any layout and before any statement is written.
    if: l2_d105_close() != 0
        return: 1
    # The reserved unit-child bases must be known BEFORE any method body is
    # written: a field path inside a method addresses these same children
    # through the unit reference, and the entry is emitted last. They used to be
    # computed with the entry's child count, which left every in-method path
    # resolving to child 0.
    l2_ns_base: l2_unit_base + l2_occ_tail_rank(l2_m_n) + l2_ebr_tail_rank(l2_ebr_n)
    l2_nso_n: 0
    l2_pub_free()
    if: l2_pub_prepare(out_path) != 0
        return: l2_alloc_or(out_path, 0, "cannot prepare output path")
    l2_out: c.fopen(l2_pub_tmp, "wb")
    if: l2_out = 0
        c.fprintf(l1_stderr(), "l2trans error: cannot open %s\n", out_path)
        return: 1
    if: (l2_has_own_ty(4) != 0 || l2_has_own_ty(5) != 0 || l2_has_own_ty(7) != 0 || l2_has_own_ty(8) != 0 || l2_has_own_ty(37) != 0 || l2_has_pointer_array() != 0 || l2_ns_has_array != 0 || l2_library_mode = 0) && c.fprintf(l2_out, "predef: \"%slmx_array_owned.h.lm1\"\n", l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    if: (l2_has_own_ty(1) != 0 || l2_ns_has_char != 0 || l2_parts_have_char() != 0) && c.fprintf(l2_out, "predef: \"%slmx_chars_owned.h.lm1\"\n", l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    # WHAT STOOD HERE AND IS GONE (FABLE-SONNET-NAME-SPECIALS-20260924-155
    # commit 3): a literal prototype: block for the four lm_own_* names,
    # auto-injected by NAME (l2_need_own, set by l2_text_eq against each of
    # them) whenever any of the four was called, regardless of whether the
    # source unit predef'd them itself. That was a second, narrower name
    # special sitting right next to the one commit 2 deleted from
    # l2_is_known -- and since commit 2, admitting the call at all already
    # REQUIRES l2_predef_has_function(call\head) to be true (l2_check_fields
    # :13061 gates on l2_is_known, which for a non-c.* name is exactly that
    # check), so any unit whose code reaches this emitter for one of these
    # calls already carries a working predef chain for it. Measured
    # (unit_bad_sizeof.lm2, predef: "l1src/own.h.lm1"): the generated L1 had
    # BOTH this injected block and the unit's own predef line, declaring the
    # same four signatures twice: l1trans accepted the duplication (exit 0),
    # which is exactly the redundancy this deletion removes, not a
    # regression it introduces.
    # The root descriptor array is emitted unconditionally, so its constructor
    # is always needed.
    #
    # WHAT STOOD HERE AND IS GONE (48U): a second predef, lmx_owned_ranges.h.lm1,
    # emitted whenever l2_ebr_n was non-zero, justified as "the admitted eternal
    # set IS a range list".  That unit does not exist and never did in this
    # repository -- git knows the path at no commit, and
    # tests/lmx_merge_selftest.lm1:36 records absorbing the coverage of its
    # deleted selftest -- while this emitter went on naming it.  The effect was
    # that EVERY program with an eternal branch emitted L1 no translator could
    # read, which is why the gap was never measured rather than never hit.
    # Nothing generated here calls a symbol of it: qualification is answered by
    # the owner arena's exact profiled ranges, never by a per-program range list.
    if: c.fprintf(l2_out, "predef: \"%slmx_array_ref_owned.h.lm1\"\n", l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    if: c.fprintf(l2_out, "predef: \"%slmx_source_names.h.lm1\" \"%slmx_array_owned.h.lm1\" \"%slmx_chars.h.lm1\"\n", l2_rt_root, l2_rt_root, l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    # The executable profile's C main builds the argv letter: a Message record (S3).
    if: (l2_library_mode = 0 || l2_need_admit != 0) && c.fprintf(l2_out, "predef: \"%slmx_implements.h.lm1\"\n", l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    if: (l2_merge_max != 0 || l2_t7_n > 0) && c.fprintf(l2_out, "predef: \"%slmx_merge_owned.h.lm1\"\n", l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    # Qualified immutable storage uses the ordinary owner arena's profiled pools.
    # The pool header supplies sealing; no permanent-store/root-slot API participates.
    if: l2_ebr_n != 0 && c.fprintf(l2_out, "predef: \"%slmx_pool.h.lm1\"\n", l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    i: 0
    while: i < l2_pd_n
        if: fputs("predef: ", l2_out) < 0 || l2_write_text(l2_out, l2_pd[i]) != 0 || fputs("\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        i: i + 1
    ---
    # The walked root (l2_rw_*): the program's graph builder makes walker nodes.
    if: l2_library_mode = 0 && l2_e >= 0 && c.fprintf(l2_out, "predef: \"%slmx_walk.h.lm1\" \"%slmx_primitive.h.lm1\" \"%slmx_child.h.lm1\" \"%slmx_list_owned.h.lm1\"\n", l2_rt_root, l2_rt_root, l2_rt_root, l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    # The C headers of the program's OWN mechanics, which the translator emits (GATE §7a, -197 (b)):
    # <stdio.h> and <stdlib.h> for every program -- an X1 invariant is `c.fprintf(c.stderr, ...)` then
    # `c.abort()`, the launch hands the host root `c.stdout`/`c.stderr`, a send's arena is calloc'd --
    # and <string.h>, for every program too since 6ea06df8: one common header of the preamble, not named where a
    # use is found -- the program's own emission uses it in common places (the program's builder copies a text
    # literal's bytes into its source leaf and clears a symbolic leaf, l2_emit_source_atom; a send copies a text
    # field).  What the SOURCE uses through `c.*` comes with its own `include:` / `predef:` (the unit's list,
    # written next).
    if: c.fprintf(l2_out, "predef: \"%slmx_arena_refs.h.lm1\" \"%slmx_value_owned.h.lm1\" \"%slmx.h.lm1\" \"%slmx_message.h.lm1\" \"%slmx_root.h.lm1\" \"%slmx_call.h.lm1\" \"%slmx_clock.h.lm1\"\ninclude: \"<stdio.h>\" \"<stdlib.h>\"", l2_rt_root, l2_rt_root, l2_rt_root, l2_rt_root, l2_rt_root, l2_rt_root, l2_rt_root) < 0
        fclose(l2_out)
        return: 1
    if: fputs(" \"<string.h>\"", l2_out) < 0
        fclose(l2_out)
        return: 1
    i: 0
    while: i < l2_inc_n
        if: fputs(" ", l2_out) < 0 || l2_write_text(l2_out, l2_inc[i]) != 0
            fclose(l2_out)
            return: 1
        i: i + 1
    ---
    if: fputs("\n\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_write_defines(l2_out) != 0
        fclose(l2_out)
        return: 1
    # The two module cells of a LIBRARY unit are per-unit state, so their names are unit-hashed like the five below them.
    # These two renames stand BEFORE the definition of the arena: a define after a definition renames the later uses and
    # not the definition.  Two library units in one link collided on exactly these two names (link exit 1).
    if: l2_library_mode != 0 && c.fprintf(l2_out, "define: l2_program_arena l2_u%08X%08X_arena\ndefine: l2_program_unit l2_u%08X%08X_program_unit\ndefine: l2_program_graph l2_u%08X%08X_program_graph\ndefine: l2_program_qualified_roots l2_u%08X%08X_qualified_roots\ndefine: l2_program_qualified_count l2_u%08X%08X_qualified_count\ndefine: l2_program_qualified_at l2_u%08X%08X_qualified_at\ndefine: l2_library_opened l2_u%08X%08X_opened\n", l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b) < 0
        fclose(l2_out)
        return: 1
    if: fputs("@: LmxArena l2_program_arena 0\n@: Lmx l2_program_unit 0\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    # Immutable char actuals use the literal table; declared fields, captures and
    # result destinations instead allocate their own typed cells.
    if: l2_parts_have_char() != 0 && fputs("@: char l2_program_chars 0\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    # E1: the program's value is the int the entry returns. The adapter stores
    # it when the entry completes; a program whose entry did not complete has
    # no value and exits 1 (Q-S2-1 (a)).
    if: l2_e >= 0 && fputs("int: l2_program_result 0\nint: l2_program_done 0\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_d105_declare_maps() != 0
        fclose(l2_out)
        return: 1
    if: fputs("\nfn: l2_program_graph () @: Lmx\nreturn: l2_program_unit\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    # Whether the entry completed (E1): an observation for the host, like the two
    # accessors below; a failed entry leaves the program without a value.
    if: l2_library_mode = 0 && l2_e >= 0 && fputs("\nfn: l2_program_completed () int\nreturn: l2_program_done\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_ebr_n != 0 && c.fprintf(l2_out, "[]: @(Lmx) l2_program_qualified_roots %d\n", l2_ebr_n) < 0
        fclose(l2_out)
        return: 1
    if: c.fprintf(l2_out, "\nfn: l2_program_qualified_count () size_t\nreturn: %uU\n\nfn: l2_program_qualified_at (size_t: index) @: Lmx\n", (cast: (unsigned) l2_ebr_n)) < 0
        fclose(l2_out)
        return: 1
    if: l2_ebr_n = 0 && fputs("return: 0\n\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_ebr_n != 0 && c.fprintf(l2_out, "    if: index >= %uU\n        return: 0\nreturn: l2_program_qualified_roots[index]\n\n", (cast: (unsigned) l2_ebr_n)) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode != 0 && c.fprintf(l2_out, "define: l2_program_entry l2_u%08X%08X_entry\ndefine: l2_library_open l2_u%08X%08X_open\ndefine: l2_library_root l2_u%08X%08X_root\ndefine: l2_library_message l2_u%08X%08X_message\ndefine: l2_library_unit l2_u%08X%08X_unit\n\n", l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b, l2_module_hash_a, l2_module_hash_b) < 0
        fclose(l2_out)
        return: 1
    if: l2_emit_os(l2_out) != 0
        fclose(l2_out)
        return: 1
    if: l2_e >= 0 && c.fprintf(l2_out, "# entry statements: %d\n", l2_e_n) < 0
        fclose(l2_out)
        return: 1
    if: fputs("# interned contract: rec.sig is translator intern id of the full canonical contract.\n# L2_SIG_V0 schema plus return type, declared throw/Message ABI, arity and exact ordered source formal names/types (int, char, size_t, const char*, const LmP0Text* const-pointee, LmP0Text* mutable pointee, size_t* mutable out-param). No varargs. Method name is not interned.\n# Hidden DynRequired names, when present, are interned after declared formals, sorted by source-name bytes then type; declared arity is unchanged. Empty DynRequired keeps the declared-only intern.\n# Mapping: id 1 := first interned contract of this unit. The comment-only l2_sig_f0/f1 diagnostics are method 0's first two source names (empty if arity is below that).\n# Linked-program intern only, not inter-module canonicalization. One intern table for the unit, not reset per method.\n# Runtime: no memcmp; closed-unit devirtualization. Formal names are the intern entry for rec.sig. const pointee forbids stores through the pointee; mutable pointee stores address the referent fields, not a cache.\n# Diagnostic evidence only; no runtime storage or global table.\n# const: @(char l2_sig_f0) \"", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_m_f0[0] != 0 && l2_write_text(l2_out, l2_m_f0[0]) != 0
        fclose(l2_out)
        return: 1
    if: fputs("\"\n# const: @(char l2_sig_f1) \"", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_m_f1[0] != 0 && l2_write_text(l2_out, l2_m_f1[0]) != 0
        fclose(l2_out)
        return: 1
    if: c.fprintf(l2_out, "\"\n# unsigned: l2_intern_id %uU\n# unsigned: l2_intern_again %uU\n# unsigned: l2_intern_swap %uU\n# unsigned: l2_intern_probe %uU\n", l2_sigv, l2_intern_again, l2_intern_swap, l2_intern_probe) < 0
        fclose(l2_out)
        return: 1
    k: 0
    while: k < l2_own_n
        if: c.fprintf(l2_out, "# const: @(char l2_own%d) \"", k) < 0
            fclose(l2_out)
            return: 1
        if: l2_write_text(l2_out, l2_own_name[k]) != 0
            fclose(l2_out)
            return: 1
        if: fputs("\"\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        k: k + 1
    ---
    # Every native method, including the entry, has a prototype.
    k: l2_m_n + l2_msend_n
    if: k > 0 && fputs("\nprototype:\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    i: 0
    while: i < l2_m_n
        if: l2_m_ret[i] = 8 && l2_m_throws[i] = 0 && fputs("    sub: ", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: (l2_m_ret[i] != 8 || l2_m_throws[i] != 0) && fputs("    fn: ", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: l2_write_sym(l2_out, i) != 0
            fclose(l2_out)
            return: 1
        if: l2_emit_sig(i) != 0
            fclose(l2_out)
            return: 1
        if: fputs("\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        i: i + 1
    # Each native method's trampoline (l2_emit_trampoline): its native word.
    i: 0
    while: i < l2_m_n
        if: l2_native_entry_ready(i) != 0 && l2_emit_trampoline(i, 1) != 0
            fclose(l2_out)
            return: 1
        i: i + 1
    # FABLE-SONNET-SEND-IN-METHODS-20260925-168 commit 2: a method body's own send primitives,
    # a separate k-space (l2_msend_*) so they cannot collide with the root's (l2_rw_send_*).
    i: 0
    while: i < l2_msend_n
        if: l2_emit_send(i, 1, "l2_msend", l2_msend_count, l2_msend_off, l2_msend_kind, l2_msend_text, l2_msend_has_ref) != 0
            fclose(l2_out)
            return: 1
        i: i + 1
    # Source method names can be used as ordinary C callback values inside an
    # earlier body. Their public wrappers are emitted after all graph-callable
    # bodies, so declare those wrapper signatures here as well.
    i: 0
    while: i < l2_m_n
        if: l2_library_mode = 0 && (l2_m_value_used = 0 || l2_m_value_used[i] = 0)
            i: i + 1
            continue
        if: l2_m_ret[i] = 8 && fputs("    sub: ", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: l2_m_ret[i] != 8 && fputs("    fn: ", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: l2_write_text(l2_out, l2_m_name[i]) != 0 || l2_emit_public_sig(i) != 0 || fputs("\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        i: i + 1
    # The held-call helpers a method calls (l2_prep_held_call) are defined after the bodies (l2_emit_mad_call).
    if: k > 0 && l2_emit_mad_call_protos() != 0
        fclose(l2_out)
        return: 1
    i: 0
    while: i < l2_t7_n
        if: c.fprintf(l2_out, "    fn: l2_view_build_%d (@: Lmx l2_entry_unit; @: Lmx target) int\n    ", i) < 0 || l2_t7_make_sig(i) != 0
            fclose(l2_out)
            return: 1
        i: i + 1
    ---
    if: k > 0 && fputs("end: prototype\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: fputs("\n# Backend method symbols are l2_m{i}; intern and find_method keep source names. c.malloc stays the foreign door.\n# Publication: write tmp; if dest.bak exists pick dest.bak.N; rename dest to that bak; rename tmp to dest; on fail restore bak or report its path. Not atomic. No recursive FS. Foreign bak is not deleted.\n# A method's own field used by a bare name has a working value l2_qN, loaded at entry from its cell in the selected occurrence `self` (slot handle l2_qN_from); a write changes l2_qN and sets l2_qN_dirty; a call, a c.* call, a copying receiver, sendMessage and every exit first publish the marked fields in field order and unmark them; a clean one is not written back and nothing is reloaded after a call (book section 12, 14; Lingvamyxa spec 21.5, 21.6). An explicit path and @x of an own field are its cell. Source-visible `node` is the fixed lexical space above the method for the whole activation; explicit node\\name reads and writes that graph. Every mutable numeric field, including char, has a distinct owned cell of its declared C type (no interned shared size_t, no int narrowing).\n# Lmx structural access stays child-index. Foreign C is spelled c.name and emitted as written; the C compiler checks it. A bare name is an L2 call resolved against unit methods and parsed prototype: declarations. Body reference declarations designate real typed pointer-value cells. Pointer results pass their stored reference; sub: is void. Native @ of a Structure or nonprimitive formal forwards its descriptor; @ of an explicit pointer binding addresses its typed pointer-value cell. Primitive formals address their local parameter cells, not graph fields. Nonprimitive signature descriptions never address the hidden machine parameter transporting the descriptor. A declaration of a formal's name without an initializer takes the argument into its cell. Executable if/else/while/for bodies are graph Structures; their own fields are cells of their exact host. &&/|| use guarded evaluation through the common expression path; skipped RHS neither prepares actuals nor reads fields or Array elements.\n\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    i: 0
    while: i < l2_m_n
        # Platform variants already emitted their graph-callable l2_mN bodies
        # inside the L1 os block above. Keep the common prototype and METHOD
        # descriptor, but never emit a second non-platform implementation.
        if: l2_method_is_os(i)
            i: i + 1
            continue
        k: 0
        while: k < l2_own_n
            if: l2_own_mi[k] = i && l2_expr_own(k) != 0 && l2_emit_expr_keep(k) != 0
                fclose(l2_out)
                return: 1
            k: k + 1
        ---
        if: l2_m_ret[i] = 8 && l2_m_throws[i] = 0 && fputs("sub: ", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: (l2_m_ret[i] != 8 || l2_m_throws[i] != 0) && fputs("fn: ", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: l2_write_sym(l2_out, i) != 0
            fclose(l2_out)
            return: 1
        if: l2_emit_sig(i) != 0
            fclose(l2_out)
            return: 1
        # A method entered without its occurrence is its caller's broken promise (D-05): X1, not
        # a return of 0 -- which was a silent success, whatever the method's return shape.
        if: fputs("\n    if: self = 0\n        c.fprintf(c.stderr, \"lmx: invariant: a method was entered without its occurrence\\n\")\n        c.abort()\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: l2_m_throws[i] != 0 && c.fprintf(l2_out, "    []: @(Lmx) l2_mops %d\n    []: @(Lmx) l2_mprofiles %d\n    int: l2_mstatus 0\n    @: Lmx l2_mresult 0\n    @: Lmx l2_mbody 0\n    @@: void l2_mxp 0\n", l2_merge_max, l2_merge_max + l2_ebr_n) < 0
            fclose(l2_out)
            return: 1
        if: l2_m_throws[i] != 0 && l2_merge_pmax > 0 && c.fprintf(l2_out, "    []: LmxMergePair l2_mpv %d\n    []: @(LmxMergePair) l2_mpp %d\n", l2_merge_pmax, l2_merge_pmax) < 0
            fclose(l2_out)
            return: 1
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_body_receives(l2_m_body[i]\as\structure) != 0 && fputs("    @: LmxMsg l2_nmsg 0\n    @: Lmx l2_ngraph 0\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: l2_emit_poll(i, "    ") != 0
            fclose(l2_out)
            return: 1
        l2_unit_ref: l2_m_unit_ref(i)
        l2_cur_mi: i
        l2_vis_method(i)
        if: l2_emit_lex_spaces(i) != 0
            fclose(l2_out)
            return: 1
        ---
        if: l2_emit_graph_places(i) != 0
            fclose(l2_out)
            return: 1
        ---
        k: 0
        while: k < l2_own_n
            if: l2_own_is_array(l2_own_ty[k]) != 0
                k: k + 1
                continue
            # -189 c3b: every own field but an array is direct: its slot handle, an address, not a value.
            if: l2_m_uses[l2_own_off(i, k)] != 0 && l2_own_direct(i, k) != 0 && c.fprintf(l2_out, "    @@: void l2_q%d_from 0\n", k) < 0
                fclose(l2_out)
                return: 1
            if: l2_m_uses[l2_own_off(i, k)] != 0 && l2_own_direct(i, k) != 0
                if: l2_own_from_expr(k, sx) != 0 || c.fprintf(l2_out, "    l2_q%d_from: %s\n    if: l2_q%d_from = 0\n        c.fprintf(c.stderr, \"lmx: invariant: own field %d has no cell\\n\")\n        c.abort()\n", k, sx\data, k, k) < 0
                    fclose(l2_out)
                    return: 1
                ---
            k: k + 1
        ---
        # §7b: the working values, loaded from their cells at entry (Lingvamyxa spec 21.5), clean.
        k: 0
        while: k < l2_own_n
            if: l2_own_cached(i, k) != 0 && l2_emit_work_decl(k) != 0
                fclose(l2_out)
                return: 1
            k: k + 1
        ---
        l2_work_mi: i
        k: 0
        while: k < l2_m_sn[i]
            c.snprintf(sx_name, 48U, "l2_s%d_%d", i, k)
            if: l2_pointer_decl_text(l2_st[l2_slot_off(i, k)], 0, sx_name, l2_tok) != 0 || c.fprintf(l2_out, "    %s 0\n", l2_tok\data) < 0
                fclose(l2_out)
                return: 1
            k: k + 1
        ---
        # D-102: a field path through a formal reads its cell into l2_xp (l2_xp: l2_pxp), so l2_xp is
        # declared wherever the path temps below are -- a unit with no own field included.
        if: (l2_own_n != 0 || l2_m_dyn[i] != 0 || l2_for_n != 0 || l2_ns_n != 0 || l2_mres_n != 0 || l2_uses_node_for_root != 0) && fputs("    @@: void l2_xp 0\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        # The field-path temps. A unit with no declaration and no bound
        # result can hold no path, so they are only declared where one is
        # possible -- or where a reference binding is: a binding's call (`b: tick`) selects its occurrence through
        # l2_pst too (l2_emit_alias_self).
        if: (l2_ns_n != 0 || l2_mres_n != 0 || l2_uses_node_for_root != 0 || l2_rb_n != 0) && fputs("    @: Lmx l2_pst 0\n    @@: void l2_pxp 0\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        # D-105 native: a place admitted by name reads its fields at the slot its value's record gives.  The
        # place need not be this method's: a path rooted at another method's name goes through that method's
        # own reference, so every method of a program with such a place has the slot temporary.
        if: l2_d105_n != 0 && fputs("    size_t: l2_dslot 0U\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        l2_tn: 0
        l2_call_node: "self"
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_ml_rebuild(l2_m_body[i]\as\structure, i, l2_src) != 0
            fclose(l2_out)
            return: 1
        if: l2_m_body[i] != 0 && l2_m_body[i]\as != 0 && l2_emit_body(l2_m_body[i]\as\structure, i, "    ", 0) != 0
            fclose(l2_out)
            return: 1
        # T7: `return: merge` is the signature frame's trailer, so the host body is empty.
        if: l2_m_body[i] = 0 && l2_mad_on(i) != 0 && l2_mad_emit(i, "    ") != 0
            fclose(l2_out)
            return: 1
        # Descriptor-only rows emit no native body (catalog addr stays 0).
        if: l2_emit_ret_tr(i, "    ", l2_ret_tr(l2_callable_source_frame(i))) != 0
            fclose(l2_out)
            return: 1
        # §7b: running off the end of the body is an exit (book §14): what is marked is published.
        if: l2_emit_publish("    ") != 0
            fclose(l2_out)
            return: 1
        if: l2_m_ret[i] = 8 && l2_emit_empty_return(i, "    ") != 0
            fclose(l2_out)
            return: 1
        if: fputs("end: ", l2_out) < 0
            fclose(l2_out)
            return: 1
        if: l2_write_sym(l2_out, i) != 0
            fclose(l2_out)
            return: 1
        if: fputs("\n\n", l2_out) < 0
            fclose(l2_out)
            return: 1
        l2_work_mi: 0 - 1
        i: i + 1
    l2_vis_on: 0
    l2_cur_mi: 0 - 1
    l2_work_mi: 0 - 1
    # Each native method's trampoline, after every body it calls (l2_emit_trampoline).
    i: 0
    while: i < l2_m_n
        if: l2_native_entry_ready(i) != 0 && l2_emit_trampoline(i, 0) != 0
            fclose(l2_out)
            return: 1
        i: i + 1
    if: l2_msend_n > 0 && fputs("sub: l2_send_fail ()\n    c.fprintf(c.stderr, \"lmx: invariant: sendMessage failed\\n\")\n    c.abort()\nend: l2_send_fail\n\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    i: 0
    while: i < l2_msend_n
        if: l2_emit_send(i, 0, "l2_msend", l2_msend_count, l2_msend_off, l2_msend_kind, l2_msend_text, l2_msend_has_ref) != 0
            fclose(l2_out)
            return: 1
        i: i + 1
    kids: (cast: (unsigned) l2_occ_tail_rank(l2_m_n)) + (cast: (unsigned) l2_unit_base)
    # Each qualified branch has one ordinary declaration-site child reference.
    # Sealed profiled pools provide lifetime; there is no retention/root array.
    if: l2_ebr_n != 0
        kids: kids + (cast: (unsigned) l2_ebr_tail_rank(l2_ebr_n))
    # One unit child per ordinary named Structure, in source order.
    l2_ns_base: l2_unit_base + l2_occ_tail_rank(l2_m_n) + l2_ebr_tail_rank(l2_ebr_n)
    kids: kids + (cast: (unsigned) l2_ns_tail_rank(l2_ns_n))
    # (A named Structure's execution had a code node here, slices 2-3; §12: it is its procedure's occurrence.  The
    # D-105 pair tables were unit children here: they are the program's static maps now, outside the graph.)
    # Source width contains only source places. Thread.children belongs to
    # the runtime record, and launch settings stay in the explicit host stub.
    # The entry's executable statements are native, not a second tail of walker steps.
    # Qualified immutable storage stays in this owner arena. Its pool profile is
    # the exact physical receiver-expression object, and sealing is its lifetime
    # policy; no second arena, root slot or numeric qualifier exists.
    if: l2_library_mode != 0 && fputs("external:\n    # Synthetic entry adapter, not a source method or an arena-owner argument.\n    fn: l2_program_entry (@: Lmx node", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_emit_mad_call() != 0
        fclose(l2_out)
        return: 1
    if: l2_emit_mad_constructs() != 0
        fclose(l2_out)
        return: 1
    if: l2_t7_emit_makes() != 0
        fclose(l2_out)
        return: 1
    if: l2_t7_emit_builders() != 0
        fclose(l2_out)
        return: 1
    # A program's builder is R0's program (LmxRootProgram, lmx_root_launch): the host calls it right
    # after it reserved R0, with R0's own arena and graph and the host's settings, and R0's one turn
    # walks the unit it builds there (the root is walked).
    if: l2_library_mode = 0 && fputs("external:\n    # R0's program: the host calls it right after it reserved R0; R0's turn walks the unit.\n    fn: l2_program_build (@: LmxArena arena; @: Lmx graph; @: Lmx settings", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: fputs(") int\n        @: Lmx l2_entry_unit 0\n        @: Lmx l2_entry_leaf 0\n        @@: void l2_entry_slot 0\n        @: Lmx l2_ebr 0\n        @: Lmx l2_fkid 0\n        @: Lmx l2_pst 0\n        @@: void l2_pxp 0\n        @: LmxThread l2_current 0\n        @: LmxMsg l2_message 0\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_ebr_n != 0 && fputs("        @: LmxPool l2_profile_pool 0\n        @: void l2_profile_refs 0\n        @: VoidArray l2_profile_array 0\n        @: char l2_profile_char 0\n        ulong: l2_ulong_probe 0U\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    # Construction-time handles preserve the exact parent of every executable
    # body. They are ordinary generated locals; graph identity remains the
    # allocated Structure and its node link.
    k: 0
    while: k < l2_for_n
        if: l2_for_transferred != 0 && l2_for_transferred[k] != 0 && l2_source_materialized(k) = 0
            k: k + 1
            continue
        if: l2_source_materialized(k) = 0 && l2_for_uchild[k] < 0 && l2_for_uchild[k] != 0 - 2 && l2_for_uchild[k] != 0 - 3
            k: k + 1
            continue
        if: c.fprintf(l2_out, "        @: Lmx l2_b%d 0\n", k) < 0
            fclose(l2_out)
            return: 1
        k: k + 1
    ---
    # Merge locals: one operand array sized to the widest merge in this unit,
    # the status, the result and the declared-throw carrier. Emitted only when
    # the unit actually merges, so nothing else changes shape.
    # One named alias per qualified branch, so a merge operand can name it.
    k: 0
    while: k < l2_ebr_n
        if: c.fprintf(l2_out, "        @: Lmx l2_ebr%u 0\n        @: Lmx l2_eprofile%u 0\n", (cast: (unsigned) k), (cast: (unsigned) k)) < 0
            fclose(l2_out)
            return: 1
        k: k + 1
    ---
    if: l2_ns_n != 0 && c.fprintf(l2_out, "        []: @(Lmx) l2_nsp %d\n", l2_ns_n) < 0
        fclose(l2_out)
        return: 1
    # The build's merges (l2_merge_build) have one operand and no pairs; a merge statement of the
    # root is a step of R0's turn (-193 T3), so it has no locals here.
    if: l2_merge_build != 0 && c.fprintf(l2_out, "        []: @(Lmx) l2_mops 1\n        []: @(Lmx) l2_mkeep %d\n        size_t: l2_mkn 0U\n        int: l2_mstatus 0\n        @: Lmx l2_mresult 0\n        @: Lmx l2_mbody 0\n", l2_ebr_n + 1) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode = 0 && fputs("        l2_program_arena: arena\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: (l2_parts_have_char() != 0) && fputs("        @: char process_chars lmx_chars_new_owned(l2_program_arena)\n        if: process_chars = 0\n            return: 1\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_parts_have_char() != 0 && fputs("        l2_program_chars: process_chars\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode = 0 && c.fprintf(l2_out, "        l2_entry_unit: graph\n        if: l2_program_arena = 0 || l2_entry_unit = 0 || l2_entry_unit\\array.size != %uU\n            return: 1\n", kids) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode != 0 && c.fprintf(l2_out, "        l2_entry_unit: lmx_node_new_owned(l2_program_arena)\n        if: l2_entry_unit = 0\n            return: 1\n        if: %uU != 0U && lmx_arena_refs_open_owned(l2_program_arena, l2_entry_unit, %uU) != 0\n            return: 1\n", kids, kids) < 0
        fclose(l2_out)
        return: 1
    if: fputs("        # DEBT: message set-graph act removed; graph is arena-owned via l2_program_arena.\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    # Materialize one ordinary physical receiver-expression object per full
    # qualifier occurrence.  They share representation, never identity.  Their
    # own pool is profiled by the already-rooted unit and sealed immediately
    # after the complete set is built, so these identity addresses stay stable.
    k: 0
    while: k < l2_ebr_n
        if: c.fprintf(l2_out, "        l2_eprofile%u: lmx_node_new_profiled(l2_program_arena, l2_entry_unit)\n        if: l2_eprofile%u = 0\n            return: 1\n        if: lmx_range_profile(l2_program_arena, (cast: (@: void) l2_eprofile%u)) != l2_entry_unit\n            return: 1\n", (cast: (unsigned) k), (cast: (unsigned) k), (cast: (unsigned) k)) < 0
            fclose(l2_out)
            return: 1
        if: k > 0 && c.fprintf(l2_out, "        if: l2_eprofile%u = l2_eprofile%u\n            return: 1\n", (cast: (unsigned) (k - 1)), (cast: (unsigned) k)) < 0
            fclose(l2_out)
            return: 1
        k: k + 1
    ---
    if: l2_ebr_n != 0 && fputs("        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_STRUCT, c.LMX_TYPE_STRUCT, l2_entry_unit)\n        if: l2_profile_pool = 0 || lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    # One ordinary Structure per callable occurrence, created before any own
    # cell so a method's own fields can be placed inside it. Lexical parent is
    # the unit; slots 0 and 1 take the header parts (l2_emit_parts, below, once
    # every occurrence exists); the remaining children are own fields and bodies.
    i: 0
    while: i < l2_m_n
        if: i = l2_e
            i: i + 1
            continue
        # R9: a named Structure's procedure has no occurrence of its own -- the Structure is it (built below).
        if: l2_m_nsof(i) >= 0
            i: i + 1
            continue
        if: c.fprintf(l2_out, "        l2_entry_leaf: lmx_struct_new_owned(l2_entry_unit, l2_program_arena)\n        if: l2_entry_leaf = 0\n            return: 1\n        if: lmx_arena_refs_open_owned(l2_program_arena, l2_entry_leaf, %uU) != 0\n            return: 1\n        if: lmx_arena_ref_store(l2_entry_unit, %uU, (cast: (@: void) l2_entry_leaf)) != 0\n            return: 1\n", (cast: (unsigned) l2_m_width(i)), (cast: (unsigned) (l2_occ_slot(i)))) < 0
            fclose(l2_out)
            return: 1
        if: l2_emit_source_name("l2_entry_leaf", l2_m_name[i], "        ", "return: 1", 0) != 0
            fclose(l2_out)
            return: 1
        i: i + 1
    ---
    k: 0
    while: k < l2_own_n
        if: l2_source_owns(k) != 0
            k: k + 1
            continue
        # A named Structure's procedure (§12) keeps no own cell: its own fields are the Structure's.
        if: l2_own_fid[k] < 0 && l2_m_nsof(l2_own_mi[k]) >= 0
            k: k + 1
            continue
        # Atom/expression values, like field Structures, need their actual
        # allocated holder. Their constructors run after all source aliases.
        if: l2_atom_value_stmt(l2_own_decl[k], l2_own_mi[k]) != 0
            k: k + 1
            continue
        # Field Structures are built after their physical body holders exist.
        if: l2_own_fid[k] < 0 && l2_own_uchild[k] >= 0 && l2_own_mi[k] != l2_e && l2_own_mi[k] >= 0 && l2_own_mi[k] < l2_m_n && l2_field_own_stmt(l2_own_decl[k], l2_own_mi[k]) != 0
            k: k + 1
            continue
        if: l2_own_fid[k] < 0 && l2_own_uchild[k] >= 0 && l2_own_mi[k] = l2_e && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_entry_unit, %uU)\n        if: l2_entry_slot = 0\n            return: 1\n", (cast: (unsigned) l2_own_uchild[k])) < 0
            fclose(l2_out)
            return: 1
        if: l2_own_fid[k] < 0 && l2_own_uchild[k] >= 0 && l2_own_mi[k] != l2_e && c.fprintf(l2_out, "        l2_entry_leaf: lmx_arena_ref_struct(l2_entry_unit, %uU)\n        if: l2_entry_leaf = 0\n            return: 1\n        l2_entry_slot: lmx_arena_ref_cell(l2_entry_leaf, %uU)\n        if: l2_entry_slot = 0\n            return: 1\n", (cast: (unsigned) (l2_occ_slot(l2_own_mi[k]))), (cast: (unsigned) l2_own_uchild[k])) < 0
            fclose(l2_out)
            return: 1
        if: l2_own_fid[k] < 0 && l2_own_uchild[k] >= 0 && l2_emit_cell_new(k, "        ", "l2_entry_slot", "return: 1", 0) != 0
            fclose(l2_out)
            return: 1
        if: l2_own_fid[k] < 0 && l2_own_uchild[k] >= 0 && l2_pap_store(k) != 0
            fclose(l2_out)
            return: 1
        k: k + 1
    ---
    # Qualified roots keep parent=0 and are referenced physically from their
    # ordinary declaration-site unit children. Their sealed exact-profile pools,
    # not a retention array or root slot, provide immutable lifetime.
    # Ordinary named Structures. Entries are created in table order, which puts
    # every parent before its nested entries. A unit-level entry is a child of
    # the unit; a nested one is built in place as a child of its parent, whose
    # pointer is already in l2_nsp, and its structural parent is that owner.
    # Leaf fields
    # are filled as they are met; references are wired in a second pass, so a
    # reference can only name an EARLIER unit-level declaration, which the
    # collector already guarantees.  A method's own named Structure is none of them (l2_ns_local).
    k: 0
    while: k < l2_ns_n
        if: l2_ns_local[k] >= 0
            k: k + 1
            continue
        if: l2_ns_parent[k] < 0 && l2_ns_eternal[k] < 0 && c.fprintf(l2_out, "        l2_nsp[%d]: lmx_struct_new_owned(l2_entry_unit, l2_program_arena)\n        if: l2_nsp[%d] != 0 && lmx_range_profile(l2_program_arena, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n", k, k, k) < 0
            fclose(l2_out)
            return: 1
        # A qualified root has NO structural parent: that is what independent
        # means. The generated program checks it before and after the
        # declaration-site store.
        if: l2_ns_parent[k] < 0 && l2_ns_eternal[k] >= 0 && c.fprintf(l2_out, "        l2_nsp[%d]: lmx_node_new_profiled(l2_program_arena, l2_eprofile%u)\n        if: l2_nsp[%d] = 0\n            return: 1\n        if: l2_nsp[%d]\\parent != 0 || lmx_range_profile(l2_program_arena, (cast: (@: void) l2_nsp[%d])) != l2_eprofile%u\n            return: 1\n", k, (cast: (unsigned) l2_ns_eternal[k]), k, k, k, (cast: (unsigned) l2_ns_eternal[k])) < 0
            fclose(l2_out)
            return: 1
        if: l2_ns_parent[k] < 0 && l2_ns_eternal[k] >= 0 && c.fprintf(l2_out, "        l2_program_qualified_roots[%uU]: l2_nsp[%d]\n", (cast: (unsigned) l2_ns_eternal[k]), k) < 0
            fclose(l2_out)
            return: 1
        if: l2_ns_parent[k] >= 0 && l2_ns_eternal[k] < 0 && c.fprintf(l2_out, "        l2_nsp[%d]: lmx_struct_new_owned(l2_nsp[%d], l2_program_arena)\n", k, l2_ns_parent[k]) < 0
            fclose(l2_out)
            return: 1
        if: l2_ns_parent[k] >= 0 && l2_ns_eternal[k] >= 0 && c.fprintf(l2_out, "        l2_nsp[%d]: lmx_node_new_profiled(l2_program_arena, l2_eprofile%u)\n        if: l2_nsp[%d] != 0\n            l2_nsp[%d]\\parent: l2_nsp[%d]\n", k, (cast: (unsigned) l2_ns_eternal[k]), k, k, l2_ns_parent[k]) < 0
            fclose(l2_out)
            return: 1
        # Its single occurrence uses the completed source width, not a second code tail.
        if: l2_ns_eternal[k] < 0 && l2_ns_width(k) > 0 && c.fprintf(l2_out, "        if: l2_nsp[%d] = 0\n            return: 1\n        if: lmx_arena_refs_open_owned(l2_program_arena, l2_nsp[%d], %uU) != 0\n            return: 1\n", k, k, (cast: (unsigned) l2_ns_width(k))) < 0
            fclose(l2_out)
            return: 1
        if: l2_ns_eternal[k] < 0 && l2_ns_width(k) = 0 && c.fprintf(l2_out, "        if: l2_nsp[%d] = 0\n            return: 1\n", k) < 0
            fclose(l2_out)
            return: 1
        if: l2_ns_eternal[k] >= 0 && l2_ns_count[k] > 0 && c.fprintf(l2_out, "        if: l2_nsp[%d] = 0\n            return: 1\n        l2_profile_refs: lmx_arena_take_n_profiled(l2_program_arena, c.sizeof(@: void), c.LMX_KIND_CHILDREN, c.LMX_TYPE_REFS, l2_eprofile%u, %uU)\n        if: l2_profile_refs = 0\n            return: 1\n        l2_nsp[%d]\\array.data: l2_profile_refs\n        l2_nsp[%d]\\array.size: %dU\n", k, (cast: (unsigned) l2_ns_eternal[k]), (cast: (unsigned) l2_ns_count[k]), k, k, l2_ns_count[k]) < 0
            fclose(l2_out)
            return: 1
        if: l2_ns_eternal[k] >= 0 && l2_ns_count[k] = 0 && c.fprintf(l2_out, "        if: l2_nsp[%d] = 0\n            return: 1\n", k) < 0
            fclose(l2_out)
            return: 1
        if: c.snprintf(sx_name, 48U, "l2_nsp[%d]", k) < 0 || l2_emit_source_name(sx_name, l2_ns_name[k], "        ", "return: 1", 0) != 0
            fclose(l2_out)
            return: 1
        # Every owned typed range reachable inside a qualified branch is
        # admitted through the Message classifier. No per-node flag, no
        # name, no registry: the admitted RANGE is the metadata.
        if: l2_ns_parent[k] < 0 && l2_ns_eternal[k] < 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_entry_unit, %uU, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n", (cast: (unsigned) (l2_ns_unit_slot(k))), k) < 0
            fclose(l2_out)
            return: 1
        # One ordinary physical reference publishes the qualified root; the root
        # remains independent and its exact profile is recoverable from its address.
        if: l2_ns_parent[k] < 0 && l2_ns_eternal[k] >= 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_entry_unit, %uU, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n        if: l2_nsp[%d]\\parent != 0\n            return: 1\n        l2_ebr%u: l2_nsp[%d]\n", (cast: (unsigned) (l2_ebr_unit_slot(l2_ns_eternal[k]))), k, k, (cast: (unsigned) l2_ns_eternal[k]), k) < 0
            fclose(l2_out)
            return: 1
        if: l2_ns_parent[k] >= 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_nsp[%d], %uU, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n        if: l2_nsp[%d]\\parent != l2_nsp[%d]\n            return: 1\n", l2_ns_parent[k], (cast: (unsigned) l2_ns_field_in_parent(k)), k, k, l2_ns_parent[k]) < 0
            fclose(l2_out)
            return: 1
        if: l2_emit_ns_cells(k) != 0
            fclose(l2_out)
            return: 1
        k: k + 1
    ---
    # R9: the control bodies, now that every named Structure exists -- a procedure's go into its Structure.
    if: l2_source_cells_emit(0, -1, 0) != 0
        fclose(l2_out)
        return: 1
    k: 0
    while: k < l2_for_n
        if: l2_for_transferred != 0 && l2_for_transferred[k] != 0
            k: k + 1
            continue
        # A method's own named Structure's procedure (slice 2c-3): its bodies are built with S, at S's statement in the
        # method (l2_emit_local_bodies).
        if: l2_m_nsof(l2_for_owner(k)) >= 0 && l2_ns_local[l2_m_nsof(l2_for_owner(k))] >= 0
            k: k + 1
            continue
        # A placed body with no locals keeps its statements inside the operator. Its shell is not a child.
        if: l2_for_uchild[k] < 0 && l2_for_uchild[k] != 0 - 2 && l2_for_uchild[k] != 0 - 3
            k: k + 1
            continue
        # Every executable control body is a graph Structure, including an
        # empty body. Top-level bodies use their callable/unit parent; nested
        # bodies use the already-created containing body (preorder invariant).
        if: l2_for_parent[k] >= 0 && c.fprintf(l2_out, "        l2_entry_leaf: l2_b%d\n", l2_for_parent[k]) < 0
            fclose(l2_out)
            return: 1
        if: l2_for_parent[k] < 0
            if: fputs("        l2_entry_leaf: ", l2_out) < 0 || l2_emit_build_occ(l2_for_owner(k)) != 0 || fputs("\n        if: l2_entry_leaf = 0\n            return: 1\n", l2_out) < 0
                fclose(l2_out)
                return: 1
            ---
        if: c.fprintf(l2_out, "        l2_fkid: lmx_struct_new_owned(l2_entry_leaf, l2_program_arena)\n        if: l2_fkid = 0\n            return: 1\n        l2_b%d: l2_fkid\n", k) < 0
            fclose(l2_out)
            return: 1
        if: l2_for_nkid[k] > 0 && c.fprintf(l2_out, "        if: lmx_arena_refs_open_owned(l2_program_arena, l2_fkid, %uU) != 0\n            return: 1\n", (cast: (unsigned) l2_for_nkid[k])) < 0
            fclose(l2_out)
            return: 1
        if: l2_for_uchild[k] >= 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_entry_leaf, %uU, (cast: (@: void) l2_fkid)) != 0\n            return: 1\n", (cast: (unsigned) l2_for_uchild[k])) < 0
            fclose(l2_out)
            return: 1
        if: c.fprintf(l2_out, "        l2_entry_leaf: l2_fkid\n") < 0
            fclose(l2_out)
            return: 1
        oi: 0
        while: oi < l2_own_n
            if: l2_own_fid[oi] = k && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_entry_leaf, %uU)\n        if: l2_entry_slot = 0\n            return: 1\n", (cast: (unsigned) l2_own_fchild[oi])) < 0
                fclose(l2_out)
                return: 1
            if: l2_own_fid[oi] = k && l2_emit_cell_new(oi, "        ", "l2_entry_slot", "return: 1", 0) != 0
                fclose(l2_out)
                return: 1
            oi: oi + 1
        ---
        k: k + 1
    ---
    # §10: the occurrence of a method of a program part whose root is built is that root's child -- the `node`
    # the method runs under (lmx_call_node) -- once the root exists.
    i: 0
    while: i < l2_m_n
        if: i != l2_e && l2_m_part(i) >= 0 && l2_part_ns[l2_m_part(i)] >= 0 && c.fprintf(l2_out, "        l2_entry_leaf: lmx_arena_ref_struct(l2_entry_unit, %uU)\n        if: l2_entry_leaf = 0 || l2_nsp[%d] = 0\n            return: 1\n        l2_entry_leaf\\parent: l2_nsp[%d]\n", (cast: (unsigned) (l2_occ_slot(i))), l2_part_ns[l2_m_part(i)], l2_part_ns[l2_m_part(i)]) < 0
            fclose(l2_out)
            return: 1
        i: i + 1
    ---
    # Book §3 (Codex, 2026-09-28): every callable occurrence keeps the immediately enclosing Structure as its
    # `parent` -- a nested method's is its host's occurrence, the `node` it runs under, capturing or not; a
    # file-level method's stays the unit.
    i: 0
    while: i < l2_m_n
        if: l2_mad_host_of(i) >= 0 && c.fprintf(l2_out, "        l2_entry_leaf: lmx_arena_ref_struct(l2_entry_unit, %uU)\n        if: l2_entry_leaf = 0 || lmx_arena_ref_struct(l2_entry_unit, %uU) = 0\n            return: 1\n        l2_entry_leaf\\parent: lmx_arena_ref_struct(l2_entry_unit, %uU)\n", (cast: (unsigned) (l2_occ_slot(i))), (cast: (unsigned) (l2_occ_slot(l2_mad_host_of(i)))), (cast: (unsigned) (l2_occ_slot(l2_mad_host_of(i))))) < 0
            fclose(l2_out)
            return: 1
        i: i + 1
    ---
    if: l2_d105_emit_tables() != 0
        fclose(l2_out)
        return: 1
    # Fill the already allocated namespace reference places through the same
    # producer used by projected local source occurrences.  The letters' payload
    # copies wait for the end of construction (l2_ns_payload_pass).
    l2_ns_payload_pass: 1
    k: 0
    while: k < l2_ns_n
        if: l2_emit_ns_refs(k) != 0
            fclose(l2_out)
            return: 1
        k: k + 1
    ---
    l2_ns_payload_pass: 0
    if: l2_source_fields_emit(0, -1) != 0
        fclose(l2_out)
        return: 1
    # All physical holders and unit reference fields now exist. Fill a local
    # field Structure through its completed GraphField, including hosted
    # declarations. Original local procedures have already been allocated by
    # the same source producer, so their fields must not be constructed again.
    k: 0
    while: k < l2_own_n
        i: l2_own_mi[k]
        oi: l2_m_nsof(i)
        if: oi >= 0 && l2_ns_local[oi] >= 0
            k: k + 1
            continue
        if: l2_source_owns(k) = 0 && l2_atom_value_stmt(l2_own_decl[k], i) != 0 && l2_emit_method_atom(k) != 0
            fclose(l2_out)
            return: 1
        if: l2_source_owns(k) = 0 && l2_field_own_stmt(l2_own_decl[k], i) != 0 && l2_emit_method_fields(k) != 0
            fclose(l2_out)
            return: 1
        k: k + 1
    ---
    # Construction is now complete for every qualified branch. Seal every
    # exact-profile pool that exists. STRUCT is required; the other domains are
    # conditional on the branch's actual shape. Sealing is owner-GC policy and
    # never changes physical references or representation.
    k: 0
    while: k < l2_ebr_n
        if: c.fprintf(l2_out, "        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_STRUCT, c.LMX_TYPE_STRUCT, l2_eprofile%u)\n        if: l2_profile_pool = 0 || lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n", (cast: (unsigned) k)) < 0
            fclose(l2_out)
            return: 1
        if: c.fprintf(l2_out, "        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_CHILDREN, c.LMX_TYPE_REFS, l2_eprofile%u)\n        if: l2_profile_pool != 0 && lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n", (cast: (unsigned) k)) < 0
            fclose(l2_out)
            return: 1
        if: c.fprintf(l2_out, "        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_SIZE_T, l2_eprofile%u)\n        if: l2_profile_pool != 0 && lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR, l2_eprofile%u)\n        if: l2_profile_pool != 0 && lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT, l2_eprofile%u)\n        if: l2_profile_pool != 0 && lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n", (cast: (unsigned) k), (cast: (unsigned) k), (cast: (unsigned) k)) < 0
            fclose(l2_out)
            return: 1
        if: c.fprintf(l2_out, "        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_UNSIGNED, l2_eprofile%u)\n        if: l2_profile_pool != 0 && lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_ULONG, l2_eprofile%u)\n        if: l2_profile_pool != 0 && lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n", (cast: (unsigned) k), (cast: (unsigned) k)) < 0
            fclose(l2_out)
            return: 1
        if: c.fprintf(l2_out, "        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_ARRAY, c.LMX_TYPE_ARRAY_OF_INT, l2_eprofile%u)\n        if: l2_profile_pool != 0 && lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_ARRAY, c.LMX_TYPE_ARRAY_OF_CHAR, l2_eprofile%u)\n        if: l2_profile_pool != 0 && lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n", (cast: (unsigned) k), (cast: (unsigned) k)) < 0
            fclose(l2_out)
            return: 1
        k: k + 1
    ---
    # Every method occurrence gets its header parts and its `native` word (-189 c4): args at slot 0,
    # return at slot 1 (l2_emit_parts), once every occurrence and named Structure exists. E keeps
    # `native` 0 -- the unit is walked.
    i: 0
    while: i < l2_m_n
        if: l2_emit_parts(i) != 0
            fclose(l2_out)
            return: 1
        i: i + 1
    # The synthesized letters' payload copies (kind 3), made once construction is complete and the qualified
    # branches are sealed: each copies its model and the lexical chain the copy hangs under, which keeps every
    # qualified branch itself (l2_emit_keep; the copier retains only sealed exact profiles).
    l2_ns_payload_pass: 2
    k: 0
    while: k < l2_ns_n
        if: l2_emit_ns_refs(k) != 0
            fclose(l2_out)
            return: 1
        k: k + 1
    ---
    l2_ns_payload_pass: 0
    if: c.fprintf(l2_out, "        if: %uU != %uU\n            return: 1\n", l2_intern_again, l2_sigv) < 0
        fclose(l2_out)
        return: 1
    # Publishing source never appends runtime fields. The host constructs the
    # Thread separately; a library replaces only Message.graph, not membership.
    if: l2_library_mode = 0 && fputs("        l2_entry_unit\\parent: 0\n        l2_program_unit: l2_entry_unit\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode != 0 && fputs("        l2_current: lmx_thread_current()\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode != 0 && fputs("        l2_message: lmx_thread_message(l2_current)\n        if: l2_current = 0 || l2_message = 0\n            return: 1\n        l2_entry_unit\\parent: 0\n        l2_message\\graph: l2_entry_unit\n        l2_program_unit: l2_entry_unit\n        if: l2_message\\graph != l2_entry_unit || l2_program_unit != l2_entry_unit\n            return: 1\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_m_arity[0] != 0 && c.fprintf(l2_out, "        if: %zuU = 0U\n            return: 1\n", l2_m_f0[0]\length) < 0
        fclose(l2_out)
        return: 1
    if: fputs("        # Closed-unit devirtualization: translator-bound child indices, no graph mutations after construction. Runtime does not memcmp formals. Evaluation order of actuals is materialized into temps before each call boundary. Hidden through-args, when present, follow declared formals in intern name order.\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode != 0 && fputs("        return: 0\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    # Walk roles are still used by methods that have no native implementation.
    if: l2_library_mode = 0 && fputs("        @: Lmx l2_rw_roles lmx_walk_roles_open(l2_program_arena)\n        if: l2_rw_roles = 0\n            return: 1\n        lmx_walk_program_bind(l2_rw_roles)\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    # Then each walkable method's frames, into its occurrence (-193 T4a).
    if: l2_library_mode = 0 && l2_rw_methods_emit(2) != 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode = 0 && l2_source_layouts_emit(0, -1) != 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode = 0 && l2_emit_shell_anchor() != 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode = 0 && fputs("        return: 0\n    end: l2_program_build\nend: external\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode != 0 && fputs("    end: l2_program_entry\nend: external\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode != 0
        if: l2_emit_library_wrappers() != 0
            fclose(l2_out)
            return: 1
        ---
    else:
        # main is the launch (lmx_root_launch): the host reserves R0 with this unit's field count, the
        # builder installs the unit in R0's own arena and graph, and the exit is R0's exit letter or
        # the mapping of its success.
        if: c.fprintf(l2_out, "external:\n    fn: main (int: argc; @@: char argv) int\n        LmxRoot: l2_program_root\n        return: lmx_root_launch(@ l2_program_root, argc, argv, l2_program_build, %uU, lmx_root_settings, 5000U, (cast: (@: void) c.stdout), (cast: (@: void) c.stderr))\n    end: main\nend: external\n", kids) < 0
            fclose(l2_out)
            return: 1
    ---
    if: fclose(l2_out) != 0
        c.remove(l2_pub_tmp)
        return: 1
    bseq: 0U
    chk: c.fopen(l2_pub_bak, "rb")
    while: chk != 0
        fclose(chk)
        if: bseq = (cast: (size_t) -1)
            c.remove(l2_pub_tmp)
            return: 1
        bseq: bseq + 1U
        if: c.snprintf(l2_pub_bak, l2_pub_bak_cap, "%s.bak.%zu", out_path, bseq) < 0
            c.remove(l2_pub_tmp)
            return: 1
        chk: c.fopen(l2_pub_bak, "rb")
    ---
    chk: c.fopen(out_path, "rb")
    if: chk != 0
        had: 1
        fclose(chk)
    if: had != 0 && c.rename(out_path, l2_pub_bak) != 0
        c.remove(l2_pub_tmp)
        return: 1
    if: c.rename(l2_pub_tmp, out_path) != 0
        if: had != 0 && c.rename(l2_pub_bak, out_path) != 0
            c.fprintf(l1_stderr(), "l2trans error: publication failed; dest unrestored; backup at %s\n", l2_pub_bak)
            return: 1
        return: 1
    if: had != 0
        c.remove(l2_pub_bak)
return: 0

external:
    fn: main (int: argc; @@: char argv) int
        int: r
        int: a 1
        @: FILE af
        const: @: char lg
        const: @: char rt
        c.setvbuf(l1_stdout(), 0, c._IONBF, 0)
        c.setvbuf(l1_stderr(), 0, c._IONBF, 0)
        # The test knob `--walk-methods` (-193 T4a): a method with frames gets native 0.
        if: argc >= a + 3 && c.strcmp(argv[a], "--walk-methods") = 0
            l2_walk_methods: 1
            a: a + 1
        ---
        # The library profile is selected here, never inferred from the unit.
        if: argc >= a + 3 && c.strcmp(argv[a], "--library") = 0
            l2_library_flag: 1
            a: a + 1
        ---
        if: argc < a + 2
            fputs("usage: l2trans.exe [--walk-methods] [--library] <source.lm2> [<part.lm2> ...] <output.lm1>\n", l1_stderr())
            return: 1
        # The program (steps/table-receiver.md §8, Q46): the source, the files named after it -- its parts --
        # and the output last.
        l2_part_path: argv + a + 1
        l2_part_n: argc - a - 2
        rt: c.getenv("L2_RUNTIME_ROOT")
        if: rt != 0 && rt[0] != 0
            l2_rt_root: rt
        if: c.getenv("L2_FAIL_MALLOC") != 0
            l2_fail_left: c.atoi(c.getenv("L2_FAIL_MALLOC"))
        if: c.getenv("L2_ALLOC_TRACE") != 0
            l2_alloc_trace: c.fopen(c.getenv("L2_ALLOC_TRACE"), "wb")
        r: l2_translate(argv[a], argv[argc - 1])
        # A failure that printed no located diagnostic is still a failure the
        # user must see; a silent exit 1 names nothing to fix.  It is an invariant break of the
        # translator (D-112): every refusal says where and why -- this line names the step that did
        # not, and exits 3, apart from a refusal's 1.
        if: r != 0 && l2_diag_n = 0
            c.fprintf(l1_stderr(), "l2trans error: %s: internal: a refusal said nothing (a step failed without a located diagnostic)\n", argv[a])
            r: 3
        # The other half of that invariant (slice 2 of the receiver `table`, REVIEW of its CHECK): what says an
        # error refuses.  A translation that said one and still succeeded would leave an "l2trans error:" line
        # with an L1 file behind it -- a place that said why it cannot answer and let the translation go on.
        # No place does that today; this names the step that would, removes its output and exits 3.
        if: r = 0 && l2_diag_n != 0
            c.fprintf(l1_stderr(), "l2trans error: %s: internal: a diagnostic was said and the translation went on\n", argv[a])
            c.remove(argv[argc - 1])
            r: 3
        l2_release()
        if: l2_alloc_trace != 0
            fclose(l2_alloc_trace)
            l2_alloc_trace: 0
        lg: c.getenv("L2_ALLOC_LOG")
        if: lg != 0
            af: c.fopen(lg, "wb")
            if: af != 0
                c.fprintf(af, "n=%d free=%d live=%d fail_at=%d fail_kind=%d err=%d\n", l2_alloc_n, l2_free_n, l2_alloc_live, l2_alloc_fail_at, l2_alloc_fail_kind, l2_alloc_err)
                fclose(af)
            ---
        ---
    return: r
end: external
