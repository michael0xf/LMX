# Repeated mixed-pointer writes and copied layouts, without per-slot fact state.
# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: sum 0
        int: last 0
        int: count 0
)
@: shared data[0]
sub: main () (
    A(int: value 1)
    B(int: value 7)
    C(int: value 9; int: extra 2)
    Grid(A; A; A; A; A; A; A; A; A; A; A; A)
    int: j 41
    @: p int @j
    int: i 0
    int: sum 0
    int: last 0
    int: count 0
)
    while: i < 12
        Grid[i] := B
        i := i + 1
    i := 0
    while: i < 12
        Grid[i] := @j
        p := Grid[i]
        data\sum := data\sum + \p
        i := i + 1
    Grid[11] := C
    data\last := length(Grid[11])
    data\count := length(Grid)
main()
int: sum main\data\sum
int: last main\data\last
int: count main\data\count

sub: observe ()
    shared\Observed\sum := sum
    shared\Observed\last := last
    shared\Observed\count := count
observe()
