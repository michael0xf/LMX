# Ordinary core text predicates. Source example, not an executed test report.
# Expected result: (1, 1, 1, 0, 1).
# hasPrefix accepts a tail; hasSuffix accepts an unmatched beginning.
# matches requires the whole input, and contains searches at any position.
@: view utf8Text("abc")
int: prefix hasPrefix(view; "ab")
int: suffix hasSuffix(view; "bc")
int: whole matches(view; "abc")
int: partialAsWhole matches(view; "ab")
int: anywhere contains(view; "b")
(prefix; suffix; whole; partialAsWhole; anywhere)
