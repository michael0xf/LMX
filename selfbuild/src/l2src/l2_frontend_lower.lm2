            if: l2_pown >= 0 && l2_pkind = 1 && own_ty_cell[0][l2_pown] != 1
                return: (cast: (int) (c.lm_compiler_error(src_cell[0], stmt, "a char field needs a char local")))
            if: l2_pown >= 0 && l2_pkind = 7 && own_ty_cell[0][l2_pown] != 0
                return: (cast: (int) (c.lm_compiler_error(src_cell[0], stmt, "an int field needs an int local")))
            if: l2_pown >= 0 && l2_pkind = 8 && own_ty_cell[0][l2_pown] != 3
                return: (cast: (int) (c.lm_compiler_error(src_cell[0], stmt, "an unsigned field needs an unsigned local")))
            if: l2_pown >= 0 && l2_pkind = 9 && own_ty_cell[0][l2_pown] != 36
                return: (cast: (int) (c.lm_compiler_error(src_cell[0], stmt, "a ulong field needs a ulong local")))
