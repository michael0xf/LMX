predef: "mixa_manager/mixa_selection.lm1"
predef: "mixa_manager/mixa_dir_win32.lm1"
predef: "mixa_manager/mixa_file_manager.h.lm1"
predef: "mixa_manager/mixa_file_manager.lm1"
predef: "mixa_manager/mixa_shell_files.lm1"
include: "<stdio.h>" "<string.h>" "<stdlib.h>"

# Witness for Files\list, Files\up and Files\refresh.
# The snapshot leaves MixaFm. A refused path does not replace it.
# This unit pastes the file-manager body once. It is not the joint binary.

int: g_alloc_live

fn: t_alloc (size_t: n) @: void
    @: void p
    p: c.malloc(n)
    if: p != 0
        g_alloc_live: g_alloc_live + 1
    ---
return: p

sub: t_free (@: void p)
    if: p = 0
        return
    ---
    g_alloc_live: g_alloc_live - 1
    c.free(p)
end: t_free

fn: t_has (@: MixaFmEntry rows; size_t: count; const: @(char name)) int
    size_t: i
    i: 0U
    while: i < count
        if: (rows + i)\name != 0
            if: c.strcmp((rows + i)\name, name) = 0
                return: 1
            ---
        ---
        i: i + 1U
    ---
return: 0

fn: main (int: argc; @: @(char) argv) int
    []: char base 520
    []: char root 1040
    []: char file 1200
    []: char cmd 2400
    []: (@: void) fh 1
    MixaFm: fm
    @: MixaFmAllocVTable av
    @: MixaFmEntry rows
    @: MixaFmEntry kept
    const: @(char dir_before)
    size_t: count
    size_t: kept_count
    int: checks
    int: failures
    int: rc
    checks: 0
    failures: 0
    g_alloc_live: 0
    rows: 0
    count: 0U
    if: argc >= 2
        c.snprintf(base, 520U, "%s", argv[1])
    ---
    if: argc < 2
        c.snprintf(base, 520U, "build/mixa/tmp_shell_files")
    ---
    c.snprintf(cmd, 2400U, "cmd /c rmdir /s /q \"%s\" 2>nul & mkdir \"%s\" 2>nul", base, base)
    c.system(cmd)
    c.snprintf(root, 1040U, "%s\\root", base)
    c.snprintf(cmd, 2400U, "cmd /c mkdir \"%s\" 2>nul", root)
    c.system(cmd)
    c.snprintf(file, 1200U, "%s\\a.txt", root)
    fh[0]: c.fopen(file, "wb")
    if: fh[0] != 0
        c.fputs("x", fh[0])
        c.fclose(fh[0])
    ---
    av: (cast: (@: MixaFmAllocVTable) c.calloc(1U, c.sizeof(c.MixaFmAllocVTable)))
    av\alloc: t_alloc
    av\free: t_free
    rc: mixa_fm_init(@ fm, root, 0, av)
    checks: checks + 1
    if: rc != MIXA_FM_OK
        failures: failures + 1
        c.printf("shell-files: init %d\n", rc)
    ---
    dir_before: mixa_fm_cur_dir(@ fm)
    rc: mixa_shell_files_list(@ fm, "Z:\\no\\such\\mixa_shell_files", @ rows, @ count)
    checks: checks + 1
    if: rc = MIXA_FM_OK || rows != 0 || count != 0U || mixa_fm_count(@ fm) = 0U || mixa_fm_cur_dir(@ fm) != dir_before
        failures: failures + 1
        c.printf("shell-files: missing path changed the directory\n")
    ---
    rc: mixa_shell_files_list(@ fm, root, @ rows, @ count)
    checks: checks + 1
    if: rc != MIXA_FM_OK || rows = 0 || count = 0U || mixa_fm_count(@ fm) != 0U
        failures: failures + 1
        c.printf("shell-files: list did not move the snapshot out\n")
    ---
    checks: checks + 1
    if: t_has(rows, count, "a.txt") = 0
        failures: failures + 1
        c.printf("shell-files: a.txt missing from the moved snapshot\n")
    ---
    kept: rows
    kept_count: count
    dir_before: mixa_fm_cur_dir(@ fm)
    rc: mixa_shell_files_list(@ fm, "Z:\\no\\such\\mixa_shell_files", @ rows, @ count)
    checks: checks + 1
    if: rc = MIXA_FM_OK || rows != kept || count != kept_count || mixa_fm_cur_dir(@ fm) != dir_before
        failures: failures + 1
        c.printf("shell-files: refused list replaced the snapshot\n")
    ---
    rc: mixa_shell_files_up(@ fm, @ rows, @ count)
    checks: checks + 1
    if: rc != MIXA_FM_ERR_ROOT || rows != kept
        failures: failures + 1
        c.printf("shell-files: up at root returned %d\n", rc)
    ---
    mixa_shell_files_release(@ fm, kept, kept_count)
    rows: 0
    count: 0U
    rc: mixa_shell_files_refresh(@ fm, @ rows, @ count)
    checks: checks + 1
    if: rc != MIXA_FM_OK || rows = 0 || t_has(rows, count, "a.txt") = 0 || mixa_fm_count(@ fm) != 0U
        failures: failures + 1
        c.printf("shell-files: refresh did not move a fresh snapshot\n")
    ---
    mixa_shell_files_release(@ fm, rows, count)
    mixa_fm_release(@ fm)
    c.free(av)
    checks: checks + 1
    if: g_alloc_live != 0
        failures: failures + 1
        c.printf("shell-files: %d allocations still live\n", g_alloc_live)
    ---
    c.printf("shell-files: %d checks, %d failures\n", checks, failures)
    if: failures != 0
        return: 1
    ---
return: 0
