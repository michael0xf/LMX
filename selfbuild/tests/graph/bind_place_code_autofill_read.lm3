# A declaration reached in code with no value makes an own place filled by autofill (the book, #binding-autofill
# item 3, the book, #inline-declaration-control; Р114): x of work takes the caller's 5.
(
    Observed:
        int: seen 0
)
fn: work () int
    int: x
    return: x
fn: caller () int
    int: x 5
    return: work()
sub: main ()
    @: shared node[0]
    shared\Observed\seen := caller()
main()
