# This non-mail producer is collected after explicit declarations too.
# Reads must follow source order, never the append order of compiler rows.
Source: (int: tag 1)
b: merge: Source
int: code 7
if: b\tag != 1
    code: 81
@: Source b 0
if: b != 0
    code: 82
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
