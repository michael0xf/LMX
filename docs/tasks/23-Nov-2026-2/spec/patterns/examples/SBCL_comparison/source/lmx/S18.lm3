Rectangle:
    int: width 0
    int: height 0
    return: int
    area:
        return: width * height

Square:
    int: side 0
    return: int
    area:
        return: side * side

Example:
    int: width
    int: height
    int: side
    return: @
    run:
        @: rectangle (copy(Rectangle))
        rectangle := parent(rectangle\area)
        @: square (copy(Square))
        square := parent(square\area)
        rectangle\width := width
        rectangle\height := height
        square\side := side
        return: (rectangle\area(); square\area())
