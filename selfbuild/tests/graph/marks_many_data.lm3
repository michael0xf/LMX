# Witness: one modifier with twenty arguments in the data of a method: each is a root variable (seen 210 = 1 + 2 + ... + 20).
# Norm: the book #data-root-declaration-execution; the author 2026-11-18 #marking-receivers-execute, #arguments-by-number-and-form.
# Slice M1 (plan #one-graph-plan): the declarations of a field under its modifiers.
(
    Observed:
        int: seen 0
)
@: shared data[0]
sub: main () (
    const:
        int: n1 1
        int: n2 2
        int: n3 3
        int: n4 4
        int: n5 5
        int: n6 6
        int: n7 7
        int: n8 8
        int: n9 9
        int: n10 10
        int: n11 11
        int: n12 12
        int: n13 13
        int: n14 14
        int: n15 15
        int: n16 16
        int: n17 17
        int: n18 18
        int: n19 19
        int: n20 20
)
    shared\Observed\seen := n1 + n2 + n3 + n4 + n5 + n6 + n7 + n8 + n9 + n10 + n11 + n12 + n13 + n14 + n15 + n16 + n17 + n18 + n19 + n20
