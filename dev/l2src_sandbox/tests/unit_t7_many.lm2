# The merges of a unit are not counted against a fixed size. Seventeen
# merges are given as actuals and nine are held: twenty-six merges, as many
# bindings, and eighteen entries of declared headers. p1 to p17 give 1 to
# 17: 153. h1 to h9 hold merge(y: k; add3) with k 1 to 9, each called with
# 1 and 2: 9 * 210 + 45. Entry 7.
fn: five (int: y) int
    return: y

fn: add3 (int: y; int: x; int: z) int
    return: y + x * 10 + z * 100

fn: bin () int
    return: 0

fn: take (bin: op) int
    return: op()

fn: p1 () int
    return: take: merge(y: 1; five)

fn: p2 () int
    return: take: merge(y: 2; five)

fn: p3 () int
    return: take: merge(y: 3; five)

fn: p4 () int
    return: take: merge(y: 4; five)

fn: p5 () int
    return: take: merge(y: 5; five)

fn: p6 () int
    return: take: merge(y: 6; five)

fn: p7 () int
    return: take: merge(y: 7; five)

fn: p8 () int
    return: take: merge(y: 8; five)

fn: p9 () int
    return: take: merge(y: 9; five)

fn: p10 () int
    return: take: merge(y: 10; five)

fn: p11 () int
    return: take: merge(y: 11; five)

fn: p12 () int
    return: take: merge(y: 12; five)

fn: p13 () int
    return: take: merge(y: 13; five)

fn: p14 () int
    return: take: merge(y: 14; five)

fn: p15 () int
    return: take: merge(y: 15; five)

fn: p16 () int
    return: take: merge(y: 16; five)

fn: p17 () int
    return: take: merge(y: 17; five)

fn: w1 (int: k) fn: (int: x; int: z) int
    return: merge(y: k; add3)

fn: w2 (int: k) fn: (int: x; int: z) int
    return: merge(y: k; add3)

fn: w3 (int: k) fn: (int: x; int: z) int
    return: merge(y: k; add3)

fn: w4 (int: k) fn: (int: x; int: z) int
    return: merge(y: k; add3)

fn: w5 (int: k) fn: (int: x; int: z) int
    return: merge(y: k; add3)

fn: w6 (int: k) fn: (int: x; int: z) int
    return: merge(y: k; add3)

fn: w7 (int: k) fn: (int: x; int: z) int
    return: merge(y: k; add3)

fn: w8 (int: k) fn: (int: x; int: z) int
    return: merge(y: k; add3)

fn: w9 (int: k) fn: (int: x; int: z) int
    return: merge(y: k; add3)

h1: w1 1
h2: w2 2
h3: w3 3
h4: w4 4
h5: w5 5
h6: w6 6
h7: w7 7
h8: w8 8
h9: w9 9
int: s p1() + p2() + p3() + p4() + p5() + p6() + p7() + p8() + p9() + p10() + p11() + p12() + p13() + p14() + p15() + p16() + p17()
int: t (h1: 1 2) + (h2: 1 2) + (h3: 1 2) + (h4: 1 2) + (h5: 1 2) + (h6: 1 2) + (h7: 1 2) + (h8: 1 2) + (h9: 1 2)
int: ok 7
if: s != 153 || t != 1935
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
