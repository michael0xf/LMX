# Standalone written groups are values. Only the explicitly supplied Body
# and consumed numeric/operator expressions execute their fields/operands.
# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: calls 0
        int: quiet_fields 0
        int: after_body 0
        int: after_ast 0
        int: math 0
        int: after_math 0
        int: arithmetic 0
        int: body_x 0
)
@: shared data[0]
int: calls 0
fn: tick () int
    node\calls := node\calls + 1
    return: 4
sub: quiet () ()
    (tick())
    (tick() + 1)
    (int: phantom 7)
    (missing_a missing_b missing_c)
quiet()
int: quiet_fields length(quiet\data)
(tick())
@: Body (
    int: x 1
    (tick())
    (missing_a missing_b missing_c)
    data\x := data\x + 2
)
call(Body)
int: after_body data\calls
+(tick() + 1)
int: after_ast data\calls
int: math tick() + 1
int: after_math data\calls
int: arithmetic 2 + 3 * 4
int: body_x Body\x

sub: main ()
    shared\Observed\calls := node\calls
    shared\Observed\quiet_fields := quiet_fields
    shared\Observed\after_body := after_body
    shared\Observed\after_ast := after_ast
    shared\Observed\math := math
    shared\Observed\after_math := after_math
    shared\Observed\arithmetic := arithmetic
    shared\Observed\body_x := body_x
main()
