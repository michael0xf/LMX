# Deliberately selected test data, not an additional language catalog.
# The translator's existing six low-level words remain available; ProbeReal
# proves that C spelling is read from this active source, not a runtime row id.
table:
    source
    name: `primitive.description`
    columns: (class: class) (categoryFlag: cell) (class: semantic) (categoryFlag: numeric) (categoryFlag: integer) (categoryFlag: floating) (categoryFlag: reference) (categoryFlag: opaque) (categoryFlag: callable) (categoryFlag: descriptor) (categoryFlag: signed) (class: width) (class: range) (class: spelling) (class: convert)
    rows:
        ProbeReal 1 float   1 0 1 0 0 0 0 0 profile "C99-double(profile)" double          keyed
        ulong     1 count   1 1 0 0 0 0 0 0 profile "0..ULONG_MAX(profile)" "unsigned long" keyed
        unsigned  1 integer 1 1 0 0 0 0 0 0 profile "C99-unsigned-int(profile)" unsigned keyed
        size_t    1 count   1 1 0 0 0 0 0 0 profile "0..SIZE_MAX(profile)" size_t        keyed
        char      1 integer 1 1 0 0 0 0 0 1 profile "C99-char(profile)" char           keyed
        int       1 integer 1 1 0 0 0 0 0 1 profile "C99-int(profile)" int             keyed
        void      0 none    0 0 0 0 0 0 0 0 None    None                  void            forbidden
