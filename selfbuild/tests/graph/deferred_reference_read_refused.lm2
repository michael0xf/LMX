# A retained initializer is not a Structure value. Its first read refuses5 at
# the reached statement; the earlier working write still publishes on exit.
int: calls 0
fn: touch () int
    node\calls := node\calls + 1
    return: 0
@: D (
    int: x 40
    @: p int data[touch()]
    @: held Missing
    int: before 0
)
@: Code (
    before := 1
    @: held p
    before := 2
)
call(D; Code)
