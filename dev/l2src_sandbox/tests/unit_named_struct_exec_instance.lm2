# Explicit merge copies the complete Model occurrence without executing it.
# Calling fresh executes that occurrence's body: its own declaration resets v
# to 1, then its assignment writes 2. Model and other remain unchanged.
# Repeating the call from an anonymous block has the same result. Entry 7.
Model:
    size_t: v 1U
    v: v + 1U
return
fresh: merge: Model
other: merge: Model
fresh\v: 7U
other\v: 5U
fresh
size_t: a 9U
a: fresh\v
fresh\v: 7U
---
    fresh
size_t: b 9U
b: fresh\v
size_t: m 9U
m: Model\v
size_t: o 9U
o: other\v
int: ok 0
if: a = 2U && b = 2U && m = 1U && o = 5U
    ok: 7
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
