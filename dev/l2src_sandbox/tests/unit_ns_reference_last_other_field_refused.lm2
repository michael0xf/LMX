# LAST selects Last, which has no left field. Do not fall back to First's
# model merely because that occurrence has the requested spelling.
First: (size_t: left 1U)
Last: (size_t: right 7U)
Holder: (@: First ref; @: Last ref)
fn: readLast () size_t
return: Holder\ref\left
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
