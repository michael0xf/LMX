# OPUS-ROOT-CALL-20260930-17, a declaration beside the calls: with Model and Other declared, `fresh: merge: Model`
# declares fresh by the full merge (K03 NS-ROLES-3; it was the old `Model: fresh`), next to typed primitive
# declarations; a path through it reads 7.  Entry 7.
Model:
    size_t: value 1U
end: Model

Other:
    size_t: p 2U
end: Other

int: k 1
size_t: z 2U
fresh: merge: Model
o: merge: Other
fresh\value: 7U
int: out 0
if: fresh\value = 7U
    out: 7
sendMessage: exit(exit_code: out; stdout: ""; stderr: "")
return
