+    if: c.fputs("include: \"<pthread.h>\" \"<time.h>\" \"<errno.h>\"\n\n# Names the POSIX bodies need and the shared headers must not grow.\n# Only those bodies predef this unit. The Windows body does not, so the L3\n# type budget on Windows stays the count from slice (a). foreign: emits no C;\n# the structs below are the heap records stored in the portable void* slots\n# (LmxProcessDeadline.event / LmxSchedule.lane). pthread_t is not a pointer,\n# so it lives in the record, not in the slot.\n\nforeign: pthread_mutex_t\nforeign: pthread_cond_t\nforeign: pthread_condattr_t\nforeign: pthread_t\n# The C type is `struct timespec`, not a typedef. The alias is the L1 name.\ntype: LmxPosixTimespec struct timespec\n\n# One manual-reset wait: the flag remembers a signal that arrived before the\n# waiter, which a bare condvar does not. The condvar clock is CLOCK_MONOTONIC.\nstruct: LmxPosixDeadline\n    pthread_mutex_t: mu\n    pthread_cond_t: cv\n    int: signaled\n    pthread_t: thread\nend: LmxPosixDeadline\n\n# One lane. `finished` is set by the lane as its last act. Reap reads it and\n# joins only when it is already set, so a still-running lane is not waited on.\n# `slot` is the schedule record the lane was started for.\nstruct: LmxPosixLane\n    pthread_mutex_t: mu\n    int: finished\n    pthread_t: thread\n    @: void slot\nend: LmxPosixLane\n\n# A selftest thread. `work` is LmxManagerWork stored as void so this header\n# does not predef the manager header. The lane body casts it back.\nstruct: LmxManagerThread\n    pthread_t: thread\n    pthread_mutex_t: mu\n    int: finished\n    @: void work\nend: LmxManagerThread\n\nfnptr: LmxPosixStart (@: void arg) @: void\n", f) < 0
