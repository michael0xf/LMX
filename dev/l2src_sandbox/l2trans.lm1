        pret: 2
        return_context: -1
        if: lm_compiler_frame_head(stmt, "return") && l2_m_ret[mi] != 8 && l2_input_model(mi, -1) >= 0
            if: l2_reference_source(fr\body\first_field, lm_compiler_count_active(fr\body), mi, @ return_source) != 0
                return: 1
            ---
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") && l2_m_ret[mi] != 8 && l2_nsty_get(mi, 0 - 1) >= 0
            pret: l2_emit_return_path(mi, fr\body\first_field, lm_compiler_count_active(fr\body), ind, stmt)
            if: pret = 1
                return: 1
            ---
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") && l2_m_ret[mi] != 8 && pret = 2
            pret: l2_emit_ret_convert(mi, fr\body, stmt, ind, l2_tok)
            if: pret = 1
                return: 1
            ---
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") && l2_m_ret[mi] != 8 && pret = 2 && l2_eval_fields_context(fr\body\first_field, lm_compiler_count_active(fr\body), mi, ind, l2_tok, @ return_context) != 0
            return: 1
