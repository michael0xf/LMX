        fclose(l2_out)
        return: 1
    if: fputs("\"\n# const: @(char l2_sig_f1) \"", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_m_f1[0] != 0 && lm_compiler_write_text(l2_out, l2_m_f1[0]) != 0
