PoolMessage:
    int: job
    int: next 0
    @: worker0
    @: worker1
    submit:
        @: selected worker0
        if: node\next = 1
            selected := worker1
        node\next := 1 - node\next
        post:
            ask:
                selected\work(job := job)

WorkerMessage:
    int: job
    @: collector
    work:
        post:
            ask:
                collector\accept(value := job * job)
