# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: result 0
)
@: shared data[0]
@: Empty ()
fn: bad (int: value) int
    return: value
end: bad
@: Holder (fn: keep (@: value Empty) int (return: 7))
call(Holder)
int: result Holder\keep((bad(unknown := 1)))

sub: main ()
    shared\Observed\result := result
main()
