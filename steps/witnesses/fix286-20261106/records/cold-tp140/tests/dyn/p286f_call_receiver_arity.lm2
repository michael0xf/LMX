# Slice 286 probe: the `call` receiver over a free holder that holds a fn with one input and no default: `call: Hw`
# forms no input of it (the book :439; Codex, 285 norm answers item 3: the implicit `call` before the body).  Entry 7.
fn: g (int: a) int
    return: a
end: g
fn: h () int
    return: 1
end: h
int: Hw 0
fn: call_free () int
    ---
        call: Hw
        return: 1
        catch: call ()
            return: 22
        catch: interpreter ()
            return: 23
        catch: implements ()
            return: 24
        catch: convert ()
            return: 25
    ---
end: call_free
fn: run () int
    @: Hw g g
    return: call_free()
end: run
fn: control () int
    @: Hw h h
    return: call_free()
end: control
int: code 7
if: control() != 1
    code: 81
---
int: got 0
if: code = 7
    got: run()
---
if: code = 7 && got != 22
    code: got
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
