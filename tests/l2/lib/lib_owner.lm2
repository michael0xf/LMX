# S8.1 witness, the owner: two instances of library A and one of library B, constructed in the owner's arena by the
# constructions the build selects (`--provider lib_a_new --provider lib_b_new --provider lib_c_new`), each admitted
# by its model, then called interleaved through the instances' own callables. Each instance keeps its own count:
# read after the calls, and written once through A1's admitted map, which A1's own method then reads and A2's does
# not.
# Library C's method takes an input the owner's model of it does not describe. try_c's written call
# `c1\lib_c_next()` cannot be formed for that method, so the admission of C's instance to LibC is refused where
# try_c binds it: try_c's implicit `implements`, which its handler takes (30).
# Success is 7; 11..16 name the call that saw another value, 17 a count, 18 two instances that are one, 19 the write
# A1's method did not see, 20 a write that reached A2, 21 a C instance that was not refused.
include: "<stdio.h>"
LibA:
    int: count 0
    fn: lib_a_next () int
end: LibA
LibB:
    int: count 0
    fn: lib_b_next () int
end: LibB
LibC:
    int: count 0
    fn: lib_c_next () int
end: LibC
fn: lib_a_new () LibA
fn: lib_b_new () LibB
fn: lib_c_new () LibC
fn: try_c () int
    int: r 0
    @: c1 LibC lib_c_new()
    r: c1\lib_c_next()
    catch: implements ()
        r: 30
    ---
return: r
fn: run () int
    @: a1 LibA lib_a_new()
    @: a2 LibA lib_a_new()
    @: b1 LibB lib_b_new()
    int: v1 a1\lib_a_next()
    int: v2 a2\lib_a_next()
    int: v3 b1\lib_b_next()
    int: v4 a1\lib_a_next()
    int: v5 b1\lib_b_next()
    int: v6 a2\lib_a_next()
    int: c1 a1\count
    int: c2 a2\count
    int: c3 b1\count
    c.printf("S81 calls A1=%d A2=%d B1=%d A1=%d B1=%d A2=%d\n", v1, v2, v3, v4, v5, v6)
    c.printf("S81 counts A1=%d A2=%d B1=%d\n", c1, c2, c3)
    if: v1 != 41
        return: 11
    if: v2 != 41
        return: 12
    if: v3 != 42
        return: 13
    if: v4 != 42
        return: 14
    if: v5 != 43
        return: 15
    if: v6 != 42
        return: 16
    if: c1 != 42 || c2 != 42 || c3 != 43
        return: 17
    if: a1 = a2
        return: 18
    a1\count: 100
    int: v7 a1\lib_a_next()
    int: v8 a2\lib_a_next()
    c.printf("S81 after A1 count 100: A1=%d A2=%d\n", v7, v8)
    if: v7 != 101
        return: 19
    if: v8 != 43
        return: 20
    int: vc try_c()
    c.printf("S81 C refused at its binding: %d\n", vc)
    if: vc != 30
        return: 21
    return: 7
int: ok run()
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
