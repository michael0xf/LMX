---
    Observed:
        int: n 3
        int: m 3
    end: Observed
---
@: shared (data [] 0)
fn: f () int (
    Alias: code
)
    int: a 1
    int: b 2
    return: 1
end: f
int: n (length (f \ code))
int: m (length (((f \ data) \ Alias) \ code))
sub: main ()
    :=: ((shared \ Observed) \ n) n
    :=: ((shared \ Observed) \ m) m
end: main
main:
