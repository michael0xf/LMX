# `T: []: []: x` (author, Q15): two levels of independent one-dimensional
# Arrays -- the outer one holds references to the inner T Arrays.  Declared in
# a Structure, the outer Array is constructed empty; merge copies it as a new
# empty Array (checked by the generated program), and the fields after it keep
# their slots.
Holder:
    int: []: []: rows
    char: []: []: words
    size_t: n 3U
end: Holder

R: merge: Holder
Holder: h
size_t: q
q: Holder\n
if: q != 3U
    return: 1
q: h\n
if: q != 3U
    return: 2
return: 0
