# M11.5e: declaration recognition is wider than machine lowering. These unused
# functions preserve their written args without evaluating defaults or models.
int: default_calls 0
fn: seed () int
    node\default_calls := node\default_calls + 1
    return: 9
end: seed
fn: profile (char: a01; schar: a02; short: a03; int: a04; long: a05; llong: a06; float: a07; double: a08; flong: a09; signed: a10; uchar: a11; ushort: a12; unsigned: a13; uint: a14; ulong: a15; ullong: a16; size_t: a17; Boolean: a18; bool: a19; _Bool: a20; u8: a21; uint8: a22; u16: a23; u32: a24; u64: a25; i8: a26; int8: a27; i16: a28; i32: a29; i64: a30; f32: a31; f64: a32; FILE: a33; c.FILE: a34) int
fn: qualified (const: (@: p int); immutable: (int: fixed); independent: (@: handle c.FILE)) int
fn: chain (char([]([](grid)))) int
fn: rectangular ([][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][]: rectangle) int
fn: deep (@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@: link c.FILE) int
fn: deferred (int: value seed()) int
fn: model (@: value (ordinary: nested)) int
int: profile_arity length(profile\args)
int: qualified_arity length(qualified\args)
int: chain_arity length(chain\args)
int: rectangular_arity length(rectangular\args)
int: deep_arity length(deep\args)
int: deferred_arity length(deferred\args)
int: model_arity length(model\args)
int: deferred_data length(deferred\data)
