---
    Observed:
        int: calls 2
        int: before_effect 0
        int: after_effect 1
        int: after_call 2
    end: Observed
---
@: shared (data [] 0)
int: calls 2
fn: effect () int
    :=: (node \ calls) ((node \ calls) + 1)
    return: 4
end: effect
sub: quiet ()
    :=: (node \ calls) ((node \ calls) + 1)
end: quiet
sub: hold ()
    unknown_inside
    quiet
    return
    break
end: hold
unknown_outside
quiet
return
break
Bag:
    missing_a
    quiet
end: Bag
Bag
@: (data \ calls)
hold:
int: before_effect (data \ calls)
+: ((effect) + 1)
int: after_effect (data \ calls)
quiet:
int: after_call (data \ calls)
sub: main ()
    :=: ((shared \ Observed) \ calls) (node \ calls)
    :=: ((shared \ Observed) \ before_effect) before_effect
    :=: ((shared \ Observed) \ after_effect) after_effect
    :=: ((shared \ Observed) \ after_call) after_call
end: main
main:
