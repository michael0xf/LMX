# Autofill of a nested code place takes the immediate caller of the activation, never an enclosing level of
# the same activation (the book, #inline-declaration-control, Р114): the inner x gets 7, the outer x stays 5.
(
    Observed:
        int: seen 0
)
fn: work () int
    int: x 5
    int: inner 0
    if: 1
        int: x
        inner := x
    return: inner * 10 + x
fn: caller () int
    int: x 7
    return: work()
sub: main ()
    @: shared node[0]
    shared\Observed\seen := caller()
main()
