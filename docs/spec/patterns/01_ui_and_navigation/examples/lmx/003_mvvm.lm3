Screen:
    int: shown 0
    int: value
    show:
        node\shown := value

ViewModel:
    int: count 0
    int: value
    @: changed Screen\show
    set:
        node\count := value
        changed(value := node\count * 2)

Demo:
    return: int
    run:
        ViewModel\set(value := 6)
        return: Screen\shown
