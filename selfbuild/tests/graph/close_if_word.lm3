# A control receiver is closed by its own word (grammar §17; the working frontend's `end: if`): `end: if` at the level of
# the outer if closes it across the open inner if -- hits is 5.
# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: hits 0
)
@: shared data[0]
int: hits 0
if: 1
    if: 1
        hits := 5
end: if
int: after 1

sub: main ()
    shared\Observed\hits := hits
main()
