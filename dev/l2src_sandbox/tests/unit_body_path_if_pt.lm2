# Point inside the then arm. return at the fn column is the trailer. if\pt\x is 4.
Point:
    int: x 0
    int: y 0
end: Point
fn: nop () int
    return: 0
fn: mytest () int
    int: answer 64
    if: 1
        pt: merge: Point
        pt\x: 4
        nop()
        if: if\pt\x = 4
            answer: 7
return: answer
int: r 0
r: mytest()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
