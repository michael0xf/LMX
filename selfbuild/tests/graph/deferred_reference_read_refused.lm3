# A retained initializer is not a Structure value. Its first read runs it (calls 1) and refuses 5 at the reached
# statement; the earlier bare write is a local of the launch and changes nothing in the graph.
int: calls 0
fn: touch () int
    node\calls := node\calls + 1
    return: 0
@: D (
    int: x 40
    @: p int data[touch()]
    @: held Missing
    int: before 0
)
@: Code (
    before := 1
    @: held p
    before := 2
)
call(D; Code)
