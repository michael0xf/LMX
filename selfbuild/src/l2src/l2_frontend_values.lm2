fn: lm_compiler_path_fail (c.L2Path@: out; int: seg; int: why) int
    int@: alloc_err_cell (cast: (int@) (@ c.l2_alloc_err))
    int@: cur_mi_cell (cast: (int@) (@ c.l2_cur_mi))
    int@: path_fail_seg_cell (cast: (int@) (@ c.l2_path_fail_seg))
    int@: path_fail_why_cell (cast: (int@) (@ c.l2_path_fail_why))
    c.L2ValueSource@: source_value_view (cast: (c.L2ValueSource@) (@ out\source_value))
    source_value_view\status := 0
    # An unavailable record is fatal, not a semantic miss for a caller to
    # retry with another candidate. Keep grammar/spans for the diagnostic,
    # but no leaf contract or mapped value may survive allocation failure.
    if: alloc_err_cell[0] != 0
        why := 7
        out\leaf_kind := -1
        out\leaf_mi := -1
        out\leaf_model := -1
        out\leaf_ty := -1
        out\leaf_level := 0
        out\array_leaf := 0
    out\fail_seg := seg
    out\fail_why := why
    out\value_status := -1
    out\value_method := cur_mi_cell[0]
    path_fail_seg_cell[0] := seg
    path_fail_why_cell[0] := why
    return: (cast: (int) (0 - 1))
end: lm_compiler_path_fail

fn: lm_compiler_path_fact_store (c.L2PathFact@: fact; const: (c.L2Path@: path)) int
    c.L2Path: shadow
    const: (c.L2Path@: from path)
    c.L2Path@: target
    char@: text
    c.L2PathStep@: steps
    int: capacity
    int: k 0
    int: cloned 0
    c.L2PathStep@: step
    if: fact = 0 || path = 0 || path\n < 0
        return: (cast: (int) (1))
    target := @ fact\resolved
    if: path\n > target\cap || c.lm_compiler_path_same_grammar(target, path) = 0
        return: (cast: (int) (1))
    if: target = path
        fact\stage := 1
        return: (cast: (int) (0))
    while: k < path\n
        step := path\steps + k
        const: (c.L2ValueSpan@: index_view (cast: (const: c.L2ValueSpan@) (@ step\index)))
        if: index_view\prepared != 0 || index_view\operand != 0 || index_view\values != 0 || index_view\primary != 0
            cloned := 1
        k := k + 1
    ---
    # Clone before publishing: a refused allocation leaves the old fact's
    # grammar,child ownership and verdict intact. Arena storage stays put.
    # A metadata-only record has no heap child owners to duplicate.
    if: cloned != 0
        if: lm_compiler_path_record_view(path, @ shadow) != 0
            return: (cast: (int) (1))
        from := @ shadow
    ---
    text := (cast: (char@) target\text)
    steps := target\steps
    capacity := target\cap
    lm_compiler_path_children_release(target)
    c.memmove((cast: (@) target), (cast: (@) from), c.sizeof(c.L2Path))
    target\text := text
    target\steps := steps
    target\owned := 0
    target\cap := capacity
    if: from\n > 0
        c.memmove((cast: (@) steps), (cast: (@) from\steps), (cast: (size_t) from\n) * c.sizeof(c.L2PathStep))
    if: cloned != 0
        k := 0
        while: k < shadow\n
            step := shadow\steps + k
            c.lm_compiler_value_span_ref(@ step\index, 0, 0)
            k := k + 1
        ---
        lm_compiler_path_release(@ shadow)
    ---
    fact\stage := 1
    return: (cast: (int) (0))
end: lm_compiler_path_fact_store

fn: lm_compiler_use_fact_at (c.LmP0Field@: first; int: n; int: mi) c.L2PathFact@
    c.L2PathFact@: found 0
    lm_compiler_use_fact_find(first, n, mi, @ found)
    return: (cast: (c.L2PathFact@) (found))
end: lm_compiler_use_fact_at

fn: lm_compiler_use_fact_find (c.LmP0Field@: first; int: n; int: mi; c.L2PathFact@@: out) int
    c.L2PathFact@@: path_facts_cell (cast: (c.L2PathFact@@) (@ c.l2_path_facts))
    int@: m_n_cell (cast: (int@) (@ c.l2_m_n))
    c.L2PathFact@@@: pfi_fact_cell (cast: (c.L2PathFact@@@) (@ c.l2_pfi_fact))
    c.L2PathFact@: fact path_facts_cell[0]
    c.L2PathFact@: found 0
    int: matches
    int: r -1
    int: linear 0
    if: out = 0
        return: (cast: (int) (2))
    \out := 0
    c.lm_compiler_reference_fields(@ first, @ n)
    if: first = 0 || first\value = 0 || n < 1 || mi < 0 || mi >= m_n_cell[0]
        return: (cast: (int) (0))
    # tp114: the facts of (mi, first\value) from the fact index (lm_compiler_pfi_*, module end: incremental over the
    # appended list, valid per l2_pf_gen) instead of every fact; the predicate and the two-matches rule below are the
    # scan's. Without the index (allocation failure, -2) the walk over every fact runs as before.
    r := lm_compiler_pfi_first(mi, (cast: (const: c.LmP0Node@) (first\value)))
    if: r = -2
        linear := 1
    else:
        fact := 0
        if: r >= 0
            fact := pfi_fact_cell[0][r]
        ---
    ---
    while: fact != 0
        if: fact\method = mi && fact\source = first\value && fact\source_use != 0
            const: (c.L2Path@: resolved (cast: (const: c.L2Path@) (@ fact\resolved)))
            matches := 0
            if: fact\source_use = 2 && n = 1
                matches := 1
            if: fact\source_use = 1 && resolved\run_count = n
                matches := 1
            if: matches != 0
                if: found != 0
                    return: (cast: (int) (2))
                found := fact
            ---
        ---
        fact := lm_compiler_pfi_advance(fact, linear, @ r)
    ---
    \out := found
    return: (cast: (int) ((cast: (int) (found != 0))))
end: lm_compiler_use_fact_find

fn: lm_compiler_use_identity (c.LmP0Field@: first; int: n; int: mi) int
    c.L2PathFact@: fact lm_compiler_use_fact_at(first, n, mi)
    if: fact != 0
        fact\use_roles := fact\use_roles | 1
    return: (cast: (int) (0))
end: lm_compiler_use_identity

fn: lm_compiler_path_clone (const: (c.L2Path@: source); c.L2Path@: out; int: keep; int: own_text) int
    int: k 0
    int: capacity
    c.L2PathStep@: steps
    c.L2PathStep@: before
    c.L2PathStep@: step
    char@: text
    if: out = 0 || source = out
        return: (cast: (int) (2))
    lm_compiler_path_init(0, 0U, out)
    if: source = 0 || source\text = 0 || source\length + 1U = 0U || source\n < 0 || (source\n > 0 && source\steps = 0) || source\n > source\cap || source\names < 0 || source\names > source\n || source\indexed < 0 || source\indexed > source\n - source\names || source\run_count < 0 || source\names_run < 0 || source\names_run > source\run_count
        return: (cast: (int) (2))
    if: source\n > 0 && lm_compiler_path_steps_room(out, (cast: (int) (source\n))) != 0
        return: (cast: (int) (3))
    steps := out\steps
    capacity := out\cap
    if: keep != 0
        c.memcpy(out, source, c.sizeof(c.L2Path))
        out\steps := steps
        out\cap := capacity
        out\owned := 0
    else:
        out\text := source\text
        out\length := source\length
        out\n := source\n
        out\names := source\names
        out\indexed := source\indexed
        out\run_count := source\run_count
        out\names_run := source\names_run
        out\source_first := source\source_first
        out\flat := source\flat
    ---
    while: k < source\n
        before := source\steps + k
        step := out\steps + k
        if: keep != 0
            c.memcpy(step, before, c.sizeof(c.L2PathStep))
            c.lm_compiler_value_span_ref(@ step\index, 0, 0)
        else:
            c.lm_compiler_path_step_clear(step)
            step\off := before\off
            step\len := before\len
            step\node := before\node
        ---
        if: before\locus = 7
            step\locus := 7
            # Copies never construct executable grammar. A schema-only
            # record's borrowed coordinates remain unprepared; ordinary
            # operand consumers will refuse them rather than parse again.
            if: lm_compiler_value_span_clone((cast: (const: c.L2ValueSpan@) (@ before\index)), (cast: (c.L2ValueSpan@) (@ step\index)), keep) != 0
                lm_compiler_path_release(out)
                return: (cast: (int) (3))
            ---
        ---
        k := k + 1
    ---
    if: own_text != 0
        text := (cast: (char@) c.lm_compiler_xmalloc(source\length + 1U))
        if: text = 0
            lm_compiler_path_release(out)
            return: (cast: (int) (3))
        c.memcpy(text, source\text, source\length)
        text[source\length] := 0
        out\text := text
        out\owned := 1
    ---
    return: (cast: (int) (0))
end: lm_compiler_path_clone

fn: lm_compiler_path_prepared_view (const: (c.L2Path@: source); c.L2Path@: out) int
    return: (cast: (int) (lm_compiler_path_clone(source, out, 0, 0)))
end: lm_compiler_path_prepared_view

fn: lm_compiler_path_record_view (const: (c.L2Path@: source); c.L2Path@: out) int
    return: (cast: (int) (lm_compiler_path_clone(source, out, 1, 0)))
end: lm_compiler_path_record_view

fn: lm_compiler_path_record_copy (const: (c.L2Path@: source); c.L2Path@: out) int
    return: (cast: (int) (lm_compiler_path_clone(source, out, 1, 1)))
end: lm_compiler_path_record_copy

fn: lm_compiler_path_steps_text (c.L2Path@: out) int
    const: (char@: pd out\text)
    size_t: pn out\length
    size_t: j 0U
    size_t: start 0U
    int: segs
    int: k 0
    c.L2PathStep@: step
    segs := lm_compiler_seg_count(pd, pn)
    if: segs < 2
        return: (cast: (int) (lm_compiler_path_fail(out, 0, 1)))
    if: lm_compiler_path_steps_room(out, segs - 1) != 0
        return: (cast: (int) (lm_compiler_path_fail(out, 0, 4)))
    while: j <= pn
        if: j = pn || pd[j] = 92
            if: k > 0 && k < segs
                step := out\steps + (k - 1)
                c.lm_compiler_path_step_clear(step)
                step\off := start
                step\len := j - start
            ---
            k := k + 1
            start := j + 1U
        ---
        j := j + 1U
    ---
    out\n := segs - 1
    out\names := segs - 1
    return: (cast: (int) (0))
end: lm_compiler_path_steps_text

fn: lm_compiler_path_steps_all (c.L2Path@: out) int
    const: (char@: pd out\text)
    size_t: pn out\length
    size_t: j 0U
    size_t: start 0U
    int: segs
    int: k 0
    c.L2PathStep@: step
    segs := lm_compiler_seg_count(pd, pn)
    if: segs < 1
        return: (cast: (int) (lm_compiler_path_fail(out, 0, 1)))
    if: lm_compiler_path_steps_room(out, segs) != 0
        return: (cast: (int) (lm_compiler_path_fail(out, 0, 4)))
    while: j <= pn
        if: j = pn || pd[j] = 92
            if: k < segs
                step := out\steps + k
                c.lm_compiler_path_step_clear(step)
                step\off := start
                step\len := j - start
            ---
            k := k + 1
            start := j + 1U
        ---
        j := j + 1U
    ---
    out\n := segs
    out\names := segs
    return: (cast: (int) (0))
end: lm_compiler_path_steps_all

# The first step of a path read by name after steps typed by their declarations, or -1 (lm_compiler_path_walk_steps_from).  A runtime-typed root reads all of its names so and has no typed part.
fn: lm_compiler_path_named_tail (const: (c.L2Path@: path)) int
    int: k 0
    int: typed 0
    if: path = 0 || path\steps = 0
        return: -1
    while: k < path\n
        c.L2PathStep@: step path\steps + k
        if: step\locus = 8
            if: typed = 0
                return: -1
            return: k
        ---
        if: step\locus != 7
            typed := 1
        k := k + 1
    ---
    return: -1
end: lm_compiler_path_named_tail

# The written selector of a named step, as the reached operation takes it (lmx_walk_value_field_place).  The first name after a callable field says it is one with `[]`.  The caller frees the text.
fn: lm_compiler_path_selector_text (const: (c.L2Path@: path); int: k; size_t@: out_size) char@
    c.L2PathStep@: step 0
    char@: text 0
    size_t: mark 0U
    if: path = 0 || k < 0 || k >= path\n || out_size = 0
        return: 0
    step := path\steps + k
    if: k > 0 && lm_compiler_path_named_tail(path) = k
        mark := 2U
    ---
    text := (cast: (char@) c.malloc(step\len + mark + 1U))
    if: text = 0
        return: 0
    if: mark != 0U
        text[0] := 91
        text[1] := 93
    ---
    c.memcpy((cast: (@) (text + mark)), (cast: (@) (path\text + step\off)), step\len)
    text[step\len + mark] := 0
    out_size[0] := step\len + mark
    return: text
end: lm_compiler_path_selector_text

# The typed part of such a path, a view over its steps with no ownership: its last step, the callable field, is its leaf.
fn: lm_compiler_path_typed_prefix (const: (c.L2Path@: path); int: n; c.L2Path@: out) int
    c.L2PathStep@: step 0
    int: k 0
    int: indexed 0
    if: path = 0 || out = 0 || n < 1 || n > path\n
        return: 1
    c.memcpy((cast: (@) out), (cast: (@) path), c.sizeof(c.L2Path))
    while: k < n
        step := path\steps + k
        if: step\locus = 7
            indexed := indexed + 1
        k := k + 1
    ---
    step := path\steps + (n - 1)
    out\n := n
    out\names := n - indexed
    out\indexed := indexed
    out\owned := 0
    out\leaf_kind := step\kind
    out\leaf_mi := step\ent
    out\leaf_ty := -1
    out\leaf_model := -1
    out\array_leaf := 0
    out\leaf_level := 0
    return: 0
end: lm_compiler_path_typed_prefix

# A successful path whose leaf is a Structure descriptor: a Structure place or branch, or a method part. One category for
# the readers of the leaf (lm_compiler_path_rec_leaf_ft) and the writer of a Structure through a path
# (lm_compiler_rw_path_write_rec). It supplies no model/admission verdict.
fn: lm_compiler_path_leaf_descriptor (const: (c.L2Path@: path)) int
    const: (c.L2PathStep@: last 0)
    if: path = 0 || path\fail_why != 0
        return: (cast: (int) (0))
    if: path\leaf_kind = 2 || path\leaf_kind = 3 || path\leaf_kind = 4
        return: (cast: (int) (1))
    if: path\leaf_kind != 12 || path\n < 1 || path\steps = 0
        return: (cast: (int) (0))
    last := path\steps + (path\n - 1)
    # Kind 12 also represents retained data atoms. Only an actual method-part step proves a descriptor here.
    return: (cast: (int) (last\locus = 5))

fn: lm_compiler_path_rec_leaf_ft (const: (c.L2Path@: path)) int
    int: ft
    if: path = 0 || path\fail_why != 0
        return: (cast: (int) (0 - 1))
    # A whole Array's semantic contract is already closed. Its descriptor
    # ABI is a representation projection, not another source/type lookup.
    if: path\array_leaf != 0
        return: (cast: (int) (lm_compiler_array_desc_ty()))
    if: lm_compiler_path_leaf_descriptor(path) != 0
        return: lm_compiler_graph_ft()
    ft := c.lm_compiler_path_kind_ft(path\leaf_kind)
    if: path\leaf_kind = 10 || path\leaf_kind = 11
        ft := path\leaf_mi
    if: path\leaf_kind = 5 || path\leaf_kind = 6
        ft := lm_compiler_array_desc_ty()
    if: path\leaf_kind = 13
        ft := path\leaf_ty
    return: (cast: (int) (ft))

fn: lm_compiler_formal_decl (int: mi; const: (c.LmP0Text@: t)) c.LmP0Node@
    return: (cast: (c.LmP0Node@) (lm_compiler_formal_decl_at(mi, lm_compiler_formal_find(mi, t))))
end: lm_compiler_formal_decl

fn: lm_compiler_formal_decl_at (int: mi; int: k) c.LmP0Node@
    int@: m_n_cell (cast: (int@) (@ c.l2_m_n))
    int@@: m_arity_cell (cast: (int@@) (@ c.l2_m_arity))
    c.LmP0Node@@@: m_node_cell (cast: (c.LmP0Node@@@) (@ c.l2_m_node))
    c.LmP0Field@: f
    int: j 0
    if: mi < 0 || mi >= m_n_cell[0] || k < 0 || k >= m_arity_cell[0][mi] || m_node_cell[0] = 0 || m_node_cell[0][mi] = 0 || m_node_cell[0][mi]\as = 0 || m_node_cell[0][mi]\as\frame = 0 || m_node_cell[0][mi]\as\frame\body = 0
        return: (cast: (c.LmP0Node@) (0))
    f := c.lm_compiler_next_active(m_node_cell[0][mi]\as\frame\body\first_field)
    # A named method's header starts with its name; an anonymous header's first field is its inputs.
    if: f != 0 && f\value != 0 && f\value\kind = c.LM_P0_NODE_ATOM
        f := c.lm_compiler_next_active(f\next)
    if: f = 0 || f\value = 0 || f\value\kind != c.LM_P0_NODE_STRUCTURE || f\value\as = 0 || f\value\as\structure = 0
        return: (cast: (c.LmP0Node@) (0))
    f := c.lm_compiler_next_active(f\value\as\structure\first_field)
    while: f != 0 && j < k
        f := c.lm_compiler_next_active(f\next)
        j := j + 1
    ---
    if: f = 0
        return: (cast: (c.LmP0Node@) (0))
    return: (cast: (c.LmP0Node@) (f\value))
end: lm_compiler_formal_decl_at

fn: lm_compiler_anon_cf_name (const: (c.LmP0Text@: host); const: (c.LmP0Text@: formal)) c.LmP0Text@
    char@: bytes 0
    c.LmP0Text@: t 0
    size_t: n
    if: host = 0 || formal = 0 || host\data = 0 || formal\data = 0
        return: (cast: (c.LmP0Text@) (0))
    n := host\length + formal\length + 2U
    bytes := (cast: (char@) c.lm_compiler_xmalloc(n + 1U))
    t := (cast: (c.LmP0Text@) c.lm_compiler_xmalloc(c.sizeof(c.LmP0Text)))
    if: bytes = 0 || t = 0
        if: bytes != 0
            c.lm_compiler_xfree((cast: (@) bytes))
        ---
        if: t != 0
            c.lm_compiler_xfree((cast: (@) t))
        ---
        return: (cast: (c.LmP0Text@) (0))
    ---
    c.memcpy(bytes, host\data, host\length)
    bytes[host\length] := 40
    c.memcpy(bytes + (cast: (size_t) host\length) + 1U, formal\data, formal\length)
    bytes[n - 1U] := 41
    bytes[n] := 0
    t\data := bytes
    t\length := n
    return: (cast: (c.LmP0Text@) (t))
end: lm_compiler_anon_cf_name

fn: lm_compiler_collected_row (int: first; const: (c.LmP0Node@: source_node)) int
    int@: m_n_cell (cast: (int@) (@ c.l2_m_n))
    c.LmP0Node@@@: m_node_cell (cast: (c.LmP0Node@@@) (@ c.l2_m_node))
    if: first < 0 || first > m_n_cell[0]
        return: (cast: (int) (0 - 2))
    if: first = m_n_cell[0]
        return: (cast: (int) (0 - 1))
    if: m_node_cell[0][first] != source_node
        return: (cast: (int) (0 - 2))
    return: (cast: (int) (first))
end: lm_compiler_collected_row

fn: lm_compiler_array_desc_ty () int
    c.LmP0Text: word
    word\data := "LmxArray"
    word\length := 8U
    return: (cast: (int) (lm_compiler_foreign_intern(@ word, 1, 0)))
end: lm_compiler_array_desc_ty

fn: lm_compiler_address_release (c.L2Address@: address) int
    if: address = 0 || address\resolved = 0
        return: (cast: (int) (0))
    lm_compiler_path_release((cast: (c.L2Path@) (@ address\path)))
    address\resolved := 0
    return: (cast: (int) (0))
end: lm_compiler_address_release

fn: lm_compiler_head_expression_dispose (c.L2HeadExpression@: expression) int
    int@: hmemo_n_cell (cast: (int@) (@ c.l2_hmemo_n))
    int@: hmemo_cap_cell (cast: (int@) (@ c.l2_hmemo_cap))
    c.LmP0Node@@@: hmemo_key_cell (cast: (c.LmP0Node@@@) (@ c.l2_hmemo_key))
    int@: omemo_n_cell (cast: (int@) (@ c.l2_omemo_n))
    int@: omemo_cap_cell (cast: (int@) (@ c.l2_omemo_cap))
    c.LmP0Node@@@: omemo_key_cell (cast: (c.LmP0Node@@@) (@ c.l2_omemo_key))
    if: expression != 0
        lm_compiler_value_spans_release((cast: (c.L2ValueSpan@) (expression\values)), (cast: (int) (expression\value_n)))
        lm_compiler_path_release((cast: (c.L2Path@) (@ expression\prepared)))
        lm_compiler_values_doc_destroy((cast: (c.LmP0Document@) (expression\document)))
        c.lm_compiler_xfree((cast: (@) expression))
        # tp111: the document's node addresses may be reused -- the memos keyed by node address (the head-source
        # memo of l2_frontend_views, the owner memo of l2_frontend_context) forget everything here.
        if: hmemo_n_cell[0] != 0 && hmemo_key_cell[0] != 0 && hmemo_cap_cell[0] > 0
            c.memset((cast: (@) hmemo_key_cell[0]), 0, (cast: (size_t) hmemo_cap_cell[0]) * sizeof(@))
        hmemo_n_cell[0] := 0
        if: omemo_n_cell[0] != 0 && omemo_key_cell[0] != 0 && omemo_cap_cell[0] > 0
            c.memset((cast: (@) omemo_key_cell[0]), 0, (cast: (size_t) omemo_cap_cell[0]) * sizeof(@))
        omemo_n_cell[0] := 0
    ---
    return: (cast: (int) (0))
end: lm_compiler_head_expression_dispose

fn: lm_compiler_array_place_release (c.L2ArrayPlace@: place) int
    if: place = 0
        return: (cast: (int) (0))
    lm_compiler_path_release((cast: (c.L2Path@) (@ place\path)))
    c.LmP0Text@: base_view (cast: (c.LmP0Text@) (@ place\base))
    base_view\data := 0
    base_view\length := 0U
    return: (cast: (int) (0))
end: lm_compiler_array_place_release

# One physical type projection for both L2 expressions and generated L1.
# Pointer codes are formatted separately; these names have no c. prefix.
fn: lm_compiler_input_value_type_name (int: ft; int: descriptor) const: char@
    ft := lm_compiler_formal_raw(ft)
    if: descriptor != 0
        return: "LMX_TYPE_LMX"
    if: ft = lm_compiler_array_desc_ty()
        return: "LMX_TYPE_DESC"
    if: lm_compiler_pointer_depth(ft) > 0
        return: 0
    if: lm_compiler_scalar_type_row(ft) >= 0
        return: "LMX_TYPE_FOREIGN"
