# R178-1 witness (slice 179): a machine function's call binds its actuals by the call's common binding and evaluates
# them in their written order. main, an export, is the program's entry and returns 0 when every check holds, else the
# number of the first that fails; next is the module's own function, defined after its first use.
fn: pack (size_t: a; size_t: b) size_t
    return: a * 10U + b
end: pack

fn: main () int
    size_t: counter 0U
    size_t: r 0U
    int: k 5
    r: pack(next(@ counter), next(@ counter))
    if: r != 12U || counter != 2U
        return: 1
    counter: 0U
    r: pack(b: next(@ counter); a: next(@ counter))
    if: r != 21U || counter != 2U
        return: 2
    r: pack(b: 4U; a: 3U)
    if: r != 34U
        return: 3
    k: k * 2 + 1
    if: k != 11
        return: 4
    return: 0
end: main

fn: next (@: counter size_t) size_t
    \counter: \counter + 1U
    return: \counter
end: next
