include: "l2src/tests/array_value_observer.h"
fn: check () int
    int: number 41
    @: pointer int @number
    []: (@: int) values 2
    values[0]: pointer
    values[1]: 0
    # Retain the typed graph-header reference, not the old VoidArray layout.
    @: descriptor c.LmxArray values
    if: observe(descriptor, pointer) = 0
        return: 81
    @: readback int values[0]
    if: readback != pointer || values[1] != 0 || length(values) != 2U || \readback != 41
        return: 82
    @@: element int @values[0]
    if: \element != pointer
        return: 85
    \element: 0
    if: values[0] != 0
        return: 86
    \element: pointer
    \readback: 53
    if: \pointer != 53 || values != descriptor
        return: 83
    if: observed() = 0
        return: 84
return: 7
fn: observe (@: descriptor c.LmxArray; @: first int) int
return: c.l2_test_pointer_array_owner(c.l2_program_arena, descriptor, first, 2U)
fn: observed () int
return: c.l2_test_array_address_count(1)
sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
