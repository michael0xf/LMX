include: "l2src/tests/opaque_bound_views_test.h"
A: (int: v 0; int: w 0)
B: (int: v 0; int: pad 0; int: w 0)
Model: (int: v 11; int: w 22)
SeedA: (int: v 1; int: w 2)
SeedB: (int: v 1; int: pad 2; int: w 3)
box: merge(Model)
fn: opaque () @: void
return: c.l2_test_opaque_bound(1)
fn: use () int
    if: box\v != 7
        return: 81
    box\v: 41
    @: cell int @box\v
    \cell: 43
    if: box\v != 43
        return: 82
    return: 7
end: use
fn: check () int
    @: a A SeedA
    @: b B SeedB
    if: a\v != 1 || b\v != 1
        return: 83
    @: all B opaque()
    @: box void opaque()
    if: use() != 7
        return: 84
    if: all\pad != 9 || all\w != 29
        return: 85
    return: 7
end: check
sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
