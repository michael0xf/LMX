 include: "<stddef.h>" "<stdio.h>" "<stdlib.h>" "<string.h>" "<limits.h>"
 
+# IDENTIFIER-CODES (slice 308): the frontend's side of the text boundary. Every text the frontend constructs -- a
+# slice of a parsed atom or path, a spelling of its own (`l2_lift_...`, ` merge body N`, "Lmx") -- gets its code at
+# its construction through the parser's lm_p0_text_code (the one name -> code table of the process); the passes then
+# compare codes: lm_compiler_text_same, lm_compiler_text_word (a word of the translator's table), lm_compiler_text_implicit
+# (an implicit throw's name, whose code is its walker number). The spellings the translator itself compares against
+# are the table l2_words, filled once at the start (lm_compiler_words_init): the first LMX_ID_WORDS of them are the
+# kernel's seeded words, whose codes are their constants.
+fn: lm_compiler_text_code (@: t c.LmP0Text) int
+    if: t = 0
+        return: (cast: (int) (1))
+    t\code: c.lm_p0_text_code((cast: (const: @: char) (t\data)), (cast: (size_t) (t\length)))
+    return: (cast: (int) (0))
+end: lm_compiler_text_code
+
+fn: lm_compiler_text_init (@: t c.LmP0Text; const: (@: data char); size_t: n) int
+    if: t = 0
+        return: (cast: (int) (1))
+    t\data: data
+    t\length: n
+    t\code: c.lm_p0_text_code(data, n)
+    return: (cast: (int) (0))
+end: lm_compiler_text_init
+
+# A defect of the translator at a comparison (a spelling without a code, a spelling compared by its bytes): said on
+# stderr with the spelling and aborted. Not a refusal of the program.
+fn: lm_compiler_text_invariant (const: (@: what char); const: (@: t c.LmP0Text)) int
+    if: t != 0 && t\data != 0
+        size_t: ids c.lmx_ids_count()
+        c.fprintf(c.l1_stderr(), "l2trans: invariant: %s: %.*s (code %zu, length %zu, text %p, ids %zu)\n", what, (cast: (int) (t\length)), (cast: (const: @: char) (t\data)), (cast: (size_t) (t\code)), (cast: (size_t) (t\length)), (cast: (const: @: void) (t\data)), ids)
+    else:
+        c.fprintf(c.l1_stderr(), "l2trans: invariant: %s\n", what)
+    ---
+    c.exit(3)
+    return: (cast: (int) (0))
