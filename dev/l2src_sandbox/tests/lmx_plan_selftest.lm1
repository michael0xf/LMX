predef: "l2src/lmx_plan.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# The generic activation plan, with NO walk unit anywhere in this build: acceptance test A
# of steps/l3-activation-plan.md is that this file translates, links and passes.
#
# The occurrence is built by hand and has no body nodes at all -- the plan unit must not
# care what a body is:
#     M = [ descriptor, a, B, b ]        B = [ t, u ]   (a Structure lexically inside M)
# so the fields, in lexical order, are a = [1], t = [2,0], u = [2,1], b = [3].

int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

fn: int_field (@: LmxArena a; @: Lmx holder; size_t: slot; int: value) int
    @: void cell lmx_int_new_owned(a)
    if: cell = 0 || lmx_int_store_known(cell, value) != 0 || lmx_arena_ref_store(holder, slot, cell) != 0
        return: 1
return: 0

# A plan of `count` entries whose paths lie one after another in `flat`, lens in `lens`.
fn: build (@: LmxArena a; @: Lmx roles; @: size_t flat; @: size_t lens; size_t: count; @@: Lmx out) int
    @@: size_t paths 0
    size_t: i 0U
    size_t: at 0U
    int: status
    paths: (cast: (@@: size_t) calloc(count + 1U, c.sizeof(@: void)))
    if: paths = 0
        return: c.LMX_PLAN_NOMEM
    while: i < count
        paths[i]: flat + at
        at: at + lens[i]
        i: i + 1U
    ---
    status: lmx_plan_build_from_paths(a, roles, paths, lens, count, out)
    free((cast: (@: void) paths))
return: status

fn: main () int
    LmxArena: arena
    LmxArena: other_arena
    @: LmxArena a 0
    @: LmxArena b 0
    @: LmxRange saved_index 0
    @: Lmx roles 0
    @: Lmx other_roles 0
    @: Lmx m 0
    @: Lmx body 0
    @: Lmx bare 0
    @: Lmx copy 0
    @: Lmx copy_body 0
    @: Lmx plan 0
    @: Lmx bad 0
    @: Lmx empty 0
    @: Lmx entry 0
    @: Lmx holder 0
    @: LmxCallable info 0
    @: LmxCallable fresh 0
    @: LmxCallable copy_info 0
    @: LmxMethod method 0
    @: size_t flat 0
    @: size_t lens 0
    @@: void s0 0
    @@: void s1 0
    @@: void s2 0
    @@: void s3 0
    size_t: saved_count

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ other_arena)), 0, c.sizeof(c.LmxArena))
    a: @ arena
    b: @ other_arena
    flat: (cast: (@: size_t) calloc(32U, c.sizeof(size_t)))
    lens: (cast: (@: size_t) calloc(8U, c.sizeof(size_t)))
    if: flat = 0 || lens = 0 || lmx_arena_open(a) != 0 || lmx_arena_open(b) != 0
        fputs("lmx_plan: setup\n", l1_stdout())
        return: 2
    ---

    # ---- the occurrence ----
    m: lmx_node_new_owned(a)
    info: lmx_callable_new_owned(a)
    if: m = 0 || info = 0 || lmx_arena_refs_open_owned(a, m, 4U) != 0
        return: 2
    body: lmx_struct_new_owned(m, a)
    if: body = 0 || lmx_arena_refs_open_owned(a, body, 2U) != 0
        return: 2
    lmx_arena_ref_store(m, 0U, (cast: (@: void) info))
    lmx_arena_ref_store(m, 2U, (cast: (@: void) body))
    if: int_field(a, m, 1U, 10) != 0 || int_field(a, body, 0U, 20) != 0 || int_field(a, body, 1U, 30) != 0 || int_field(a, m, 3U, 40) != 0
        return: 2
    ---

    # ---- role records ----
    roles: lmx_plan_roles_open(a)
    other_roles: lmx_plan_roles_open(a)
    check(roles != 0 && roles\len = c.LMX_PLAN_ROLE_COUNT, "roles opened")
    check(lmx_arena_ref_value(roles, 0U) != 0 && lmx_arena_ref_value(roles, 0U) != lmx_arena_ref_value(roles, 1U), "two distinct role records")
    check(lmx_range_classify(a, lmx_arena_ref_value(roles, 0U)) = c.LMX_DOMAIN_KIND_ROLE && lmx_range_classify(a, lmx_arena_ref_value(roles, 1U)) = c.LMX_DOMAIN_KIND_ROLE, "role records are the role domain of the arena")
    check(other_roles != 0 && lmx_arena_ref_value(other_roles, 1U) != lmx_arena_ref_value(roles, 1U), "another table has records of its own")

    # ---- build: a [1], t [2,0], u [2,1], b [3] ----
    flat[0]: 1U
    flat[1]: 2U
    flat[2]: 0U
    flat[3]: 2U
    flat[4]: 1U
    flat[5]: 3U
    lens[0]: 1U
    lens[1]: 2U
    lens[2]: 2U
    lens[3]: 1U
    check(build(a, roles, flat, lens, 4U, @ plan) = c.LMX_PLAN_OK && plan != 0, "plan built from four paths")
    check(lmx_plan_entry_count(plan) = 4U && lmx_plan_entry_count(0) = 0U, "entry count")
    check(lmx_arena_ref_value(plan, 0U) = lmx_arena_ref_value(roles, 0U), "the root names its role by address")
    entry: lmx_arena_ref_struct(plan, 2U)
    check(entry != 0 && entry\len = 3 && lmx_arena_ref_value(entry, 0U) = lmx_arena_ref_value(roles, 1U), "an entry is its role plus its path, nothing else")
    check(lmx_size_value_known(lmx_arena_ref_value(entry, 1U)) = 2U && lmx_size_value_known(lmx_arena_ref_value(entry, 2U)) = 0U, "path of t is 2, 0")
    check(lmx_plan_validate_shape(a, roles, m, plan) = c.LMX_PLAN_OK, "the plan is valid on M")

    # ---- resolve: the ADDRESS OF THE SLOT, entry by entry, in the given order ----
    s0: lmx_plan_slot_known(m, plan, 0U)
    s1: lmx_plan_slot_known(m, plan, 1U)
    s2: lmx_plan_slot_known(m, plan, 2U)
    s3: lmx_plan_slot_known(m, plan, 3U)
    check(s0 = lmx_arena_ref_cell(m, 1U) && s3 = lmx_arena_ref_cell(m, 3U), "fields of M resolve to their slots")
    check(s1 = lmx_arena_ref_cell(body, 0U) && s2 = lmx_arena_ref_cell(body, 1U), "fields of the inner Structure resolve to its slots")
    check(lmx_int_value_known(s1[0]) = 20 && lmx_int_value_known(s3[0]) = 40, "what the slots hold is reachable through them")
    check(lmx_plan_slot_known(m, plan, 4U) = 0 && lmx_plan_slot_known(m, 0, 0U) = 0 && lmx_plan_slot_known(0, plan, 0U) = 0, "past the end, no plan, no occurrence: 0")
    # Nothing is asked of the arena while resolving: with the arena's index hidden every
    # classification answers NONE, and the resolver still returns the same slots.
    saved_index: lmx_arena_index_data(a)
    saved_count: lmx_arena_index_len(a)
    lmx_arena_index_set_len(a, 0U)
    check(lmx_range_classify(a, (cast: (@: void) m)) = c.LMX_KIND_NONE, "the index is hidden: M itself classifies as nothing")
    check(lmx_plan_slot_known(m, plan, 1U) = s1 && lmx_plan_slot_known(m, plan, 3U) = s3 && lmx_plan_entry_count(plan) = 4U, "resolving asks the arena nothing")
    check(lmx_plan_validate_shape(a, roles, m, plan) = c.LMX_PLAN_INVALID, "whereas validation DOES ask, and refuses")
    lmx_arena_index_set_data(a, saved_index)
    lmx_arena_index_set_len(a, saved_count)
    check(lmx_plan_validate_shape(a, roles, m, plan) = c.LMX_PLAN_OK, "index restored")

    # ---- publish ----
    check(info\header = 0, "no plan yet")
    check(lmx_plan_publish(a, roles, m, plan) = c.LMX_PLAN_OK && info\header = plan, "published into the descriptor of M")

    # ---- D: refusals of publish; the header stays what it was ----
    check(lmx_plan_publish(b, roles, m, plan) = c.LMX_PLAN_INVALID && info\header = plan, "an arena that does not hold the descriptor may not publish")
    # The home of an address is the arena that owns its local range, or none.  Imported sealed
    # views preserve their foreign owner; that case belongs to lmx_qualified_range_selftest.
    check(lmx_plan_home(a, (cast: (@: void) plan)) = a && lmx_plan_home(a, (cast: (@: void) info)) = a && lmx_plan_home(a, lmx_arena_ref_value(roles, 0U)) = a, "home: the plan, the descriptor and the roles live in this arena")
    check(lmx_plan_home(b, (cast: (@: void) plan)) = 0 && lmx_plan_home(a, 0) = 0 && lmx_plan_home(0, (cast: (@: void) plan)) = 0, "home: none from an arena that does not hold it, for null, from no arena")
    bare: lmx_node_new_owned(a)
    method: lmx_method_new_owned(a)
    if: bare = 0 || method = 0 || lmx_arena_refs_open_owned(a, bare, 2U) != 0 || int_field(a, bare, 1U, 5) != 0
        return: 2
    lmx_arena_ref_store(bare, 0U, (cast: (@: void) method))
    lens[0]: 1U
    flat[0]: 1U
    check(build(a, roles, flat, lens, 1U, @ bad) = c.LMX_PLAN_OK, "a plan for the bare occurrence")
    check(lmx_plan_publish(a, roles, bare, bad) = c.LMX_PLAN_INVALID, "a bare METHOD in child[0] has no header to publish into")
    flat[0]: 9U
    check(build(a, roles, flat, lens, 1U, @ bad) = c.LMX_PLAN_OK && lmx_plan_validate_shape(a, roles, m, bad) = c.LMX_PLAN_INVALID, "a slot M does not have")
    check(lmx_plan_publish(a, roles, m, bad) = c.LMX_PLAN_INVALID && info\header = plan, "publish refuses it and leaves the header alone")
    flat[0]: 1U
    flat[1]: 0U
    lens[0]: 2U
    check(build(a, roles, flat, lens, 1U, @ bad) = c.LMX_PLAN_OK && lmx_plan_validate_shape(a, roles, m, bad) = c.LMX_PLAN_INVALID, "a step through a cell, not a Structure")
    flat[0]: 0U
    lens[0]: 1U
    check(build(a, roles, flat, lens, 1U, @ bad) = c.LMX_PLAN_OK && lmx_plan_validate_shape(a, roles, m, bad) = c.LMX_PLAN_INVALID, "child[0] of M is never a field")
    flat[0]: 1U
    flat[1]: 1U
    lens[0]: 1U
    lens[1]: 1U
    check(build(a, roles, flat, lens, 2U, @ bad) = c.LMX_PLAN_OK && lmx_plan_validate_shape(a, roles, m, bad) = c.LMX_PLAN_INVALID, "two entries naming one slot")
    # The impostor rule: a plan whose roles are the records of ANOTHER table.
    lens[0]: 1U
    check(build(a, other_roles, flat, lens, 1U, @ bad) = c.LMX_PLAN_OK && lmx_plan_validate_shape(a, other_roles, m, bad) = c.LMX_PLAN_OK, "valid under its own roles")
    check(lmx_plan_validate_shape(a, roles, m, bad) = c.LMX_PLAN_INVALID, "and not a plan at all under these: the role is the record's address")

    # ---- refusals of build ----
    lens[0]: 0U
    check(build(a, roles, flat, lens, 1U, @ bad) = c.LMX_PLAN_INVALID && bad = 0, "an empty path is refused")
    lens[0]: 1U
    check(lmx_plan_build_from_paths(a, roles, 0, lens, 1U, @ bad) = c.LMX_PLAN_INVALID, "no paths for a non-empty plan")
    check(lmx_plan_build_from_paths(a, roles, 0, 0, 0U, 0) = c.LMX_PLAN_INVALID, "nowhere to put the plan")

    # ---- N = 0: prepared, and uses no own field ----
    check(lmx_plan_build_from_paths(a, roles, 0, 0, 0U, @ empty) = c.LMX_PLAN_OK && empty != 0 && lmx_plan_entry_count(empty) = 0U, "an empty plan is a plan")
    check(lmx_plan_validate_shape(a, roles, m, empty) = c.LMX_PLAN_OK && empty != plan, "and is valid")

    # ---- C: a copy shares the plan and resolves to its OWN slots ----
    check(lmx_graph_copy_owned(m, 0, a, a, @ copy) = c.LMX_GRAPH_COPY_OK && copy != 0 && copy != m, "M copied")
    if: copy != 0
        check(lmx_arena_ref_value(copy, 0U) = (cast: (@: void) info), "the copy shares the descriptor, hence the plan")
        copy_body: lmx_arena_ref_struct(copy, 2U)
        check(copy_body != 0 && copy_body != body, "the inner Structure was copied")
        check(lmx_plan_slot_known(copy, plan, 0U) = lmx_arena_ref_cell(copy, 1U) && lmx_plan_slot_known(copy, plan, 0U) != s0, "same path, the copy's own slot of a")
        check(lmx_plan_slot_known(copy, plan, 2U) = lmx_arena_ref_cell(copy_body, 1U) && lmx_plan_slot_known(copy, plan, 2U) != s2, "same path, the copy's own slot of u")
        check(lmx_plan_validate_shape(a, roles, copy, plan) = c.LMX_PLAN_OK, "the shared plan is valid on the copy: it is isomorphic")
        # ---- E: invalidating ONE occurrence ----
        fresh: lmx_callable_new_owned(a)
        check(fresh != 0 && lmx_arena_ref_store(copy, 0U, (cast: (@: void) fresh)) = 0, "a fresh descriptor in the copy's child[0]")
        if: fresh != 0
            check(fresh\header = 0 && info\header = plan, "the copy is unprepared; the shared descriptor keeps its plan")
        ---
    ---

    # ---- F: data writes do not touch the plan ----
    lmx_int_store_known(s1[0], 21)
    holder: m
    check(int_field(a, holder, 3U, 41) = 0, "a field slot rebound to another cell")
    check(info\header = plan && lmx_plan_slot_known(m, plan, 3U) = s3 && lmx_int_value_known(s3[0]) = 41, "same plan, same slot, the new value")

    # ---- a role record is a copy terminal ----
    holder: lmx_node_new_owned(a)
    if: holder = 0 || lmx_arena_refs_open_owned(a, holder, 1U) != 0
        return: 2
    lmx_arena_ref_store(holder, 0U, lmx_arena_ref_value(roles, 1U))
    copy: 0
    check(lmx_graph_copy_owned(holder, 0, a, a, @ copy) = c.LMX_GRAPH_COPY_OK && copy != 0, "a Structure holding a role record copies")
    if: copy != 0
        check(lmx_arena_ref_value(copy, 0U) = lmx_arena_ref_value(roles, 1U), "and the record is kept by address, not duplicated")
    ---

    free((cast: (@: void) flat))
    free((cast: (@: void) lens))
    if: failures != 0
        c.printf("lmx_plan: %d failed of %d\n", failures, checks)
        return: 1
    ---
    c.printf("lmx_plan: %d checks\n", checks)
return: 0
