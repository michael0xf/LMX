predef: "mixa_manager/mixa_file_manager.h.lm1"
predef: "mixa_manager/mixa_fileio.h.lm1"
include: "<stdlib.h>"

# Files owner, same-owner calls only. One header: the real
# mixa_file_manager.h.lm1, not the *_l2 mirror.
#
# list / up / refresh call mixa_fm_goto / mixa_fm_parent / mixa_fm_refresh.
# On success the new snapshot is moved out of MixaFm. Files keeps the
# directory strings and does not keep a second copy of the rows. The caller
# receives the row storage itself, not a pointer at the MixaFm object.
# On failure the caller's outs are left untouched and the previous directory
# stays, which is mixa_fm_goto's own rule.
# mixa_fm_select is not called here. Selection belongs to Shell.

sub: mixa_shell_files_free (@: MixaFm fm; @: void p)
    const: @(MixaFmAllocVTable av)
    MixaFmFreeFn: f
    if: p = 0
        return
    ---
    f: 0
    if: fm != 0
        av: fm\av
        if: av != 0
            f: av\free
        ---
    ---
    if: f != 0
        f(p)
        return
    ---
    c.free(p)
end: mixa_shell_files_free

fn: mixa_shell_files_release (@: MixaFm fm; @: MixaFmEntry rows; size_t: count) int
    size_t: i
    @: MixaFmEntry cur
    if: rows = 0
        return: MIXA_FM_OK
    i: 0U
    while: i < count
        cur: rows + i
        mixa_shell_files_free(fm, (cast: (@: void) cur\name))
        mixa_shell_files_free(fm, (cast: (@: void) cur\path))
        i: i + 1U
    ---
    mixa_shell_files_free(fm, (cast: (@: void) rows))
return: MIXA_FM_OK

fn: mixa_shell_files_take (@: MixaFm fm; @@: MixaFmEntry out_rows; @: size_t out_count) int
    if: fm = 0 || out_rows = 0 || out_count = 0
        return: MIXA_FM_ERR_ARG
    \out_rows: fm\entries
    \out_count: fm\count
    fm\entries: 0
    fm\count: 0U
return: MIXA_FM_OK

fn: mixa_shell_files_list (@: MixaFm fm; const: @(char path); @@: MixaFmEntry out_rows; @: size_t out_count) int
    int: rc
    if: fm = 0 || path = 0 || out_rows = 0 || out_count = 0
        return: MIXA_FM_ERR_ARG
    rc: mixa_fm_goto(fm, path)
    if: rc != MIXA_FM_OK
        return: rc
    ---
    return: mixa_shell_files_take(fm, out_rows, out_count)

fn: mixa_shell_files_up (@: MixaFm fm; @@: MixaFmEntry out_rows; @: size_t out_count) int
    int: rc
    if: fm = 0 || out_rows = 0 || out_count = 0
        return: MIXA_FM_ERR_ARG
    rc: mixa_fm_parent(fm)
    if: rc != MIXA_FM_OK
        return: rc
    ---
    return: mixa_shell_files_take(fm, out_rows, out_count)

fn: mixa_shell_files_refresh (@: MixaFm fm; @@: MixaFmEntry out_rows; @: size_t out_count) int
    int: rc
    if: fm = 0 || out_rows = 0 || out_count = 0
        return: MIXA_FM_ERR_ARG
    rc: mixa_fm_refresh(fm)
    if: rc != MIXA_FM_OK
        return: rc
    ---
    return: mixa_shell_files_take(fm, out_rows, out_count)

# Whole file, one buffer. read_text and read_bytes are this transfer:
# the console is the file, and audio takes the same bytes. No second
# decoded copy is made. Files does not keep the buffer. A refusal leaves
# the caller's outs untouched. len is the file size; the byte after it is 0
# so the same storage can be drawn as text.
fn: mixa_shell_files_read (const: @(char path); @@: char out_bytes; @: size_t out_len) int
    []: (@: MixaFio) slot 1
    @: MixaFio f
    @: char buf
    @: char fresh
    size_t: cap
    size_t: len
    size_t: n
    size_t: room
    int: st
    int: more
    if: path = 0 || out_bytes = 0 || out_len = 0
        return: MIXA_FIO_ERR_ARG
    slot[0]: 0
    st: mixa_fio_open_read(slot, path)
    if: st != MIXA_FIO_OK
        return: st
    ---
    f: slot[0]
    cap: 64U
    buf: (cast: (@: char) c.malloc(cap + 1U))
    if: buf = 0
        mixa_fio_close(f)
        return: MIXA_FIO_ERR_NOMEM
    ---
    len: 0U
    more: 1
    while: more != 0
        room: cap - len
        n: 0U
        st: mixa_fio_read(f, buf + len, room, @ n, 0, len)
        if: st != MIXA_FIO_OK
            c.free(buf)
            mixa_fio_close(f)
            return: st
        ---
        if: n = 0U
            more: 0
        ---
        if: n != 0U
            len: len + n
            if: len = cap
                if: cap > (((size_t) -1) / 2U)
                    c.free(buf)
                    mixa_fio_close(f)
                    return: MIXA_FIO_ERR_NOMEM
                ---
                fresh: (cast: (@: char) c.realloc(buf, (cap * 2U) + 1U))
                if: fresh = 0
                    c.free(buf)
                    mixa_fio_close(f)
                    return: MIXA_FIO_ERR_NOMEM
                ---
                buf: fresh
                cap: cap * 2U
            ---
        ---
    ---
    buf[len]: 0
    mixa_fio_close(f)
    \out_bytes: buf
    \out_len: len
return: MIXA_FIO_OK

fn: mixa_shell_files_read_text (const: @(char path); @@: char out_bytes; @: size_t out_len) int
return: mixa_shell_files_read(path, out_bytes, out_len)

fn: mixa_shell_files_read_bytes (const: @(char path); @@: char out_bytes; @: size_t out_len) int
return: mixa_shell_files_read(path, out_bytes, out_len)

sub: mixa_shell_files_release_bytes (@: char bytes)
    c.free(bytes)
end: mixa_shell_files_release_bytes
