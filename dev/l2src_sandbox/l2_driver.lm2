sub: inspect_merge (@@: operands c.Lmx; size_t: count; @: result c.Lmx; @: src_arena c.LmxArena; @: dst_arena c.LmxArena)
    @: result_fields c.VoidArray 0
    @: copied_fields c.VoidArray 0
    @: source_fields c.VoidArray 0
    @: copied_array_fields c.VoidArray 0
    @: source_array_fields c.VoidArray 0
    result_fields: 0
    if: result != 0
        result_fields: @ result\array
    ---
    @: gargc_cell int (cast: (@: int) (@ c.gargc))
    @@@: gargv_cell char (cast: (@@@: char) (@ c.gargv))
    @: merge_calls_cell int (cast: (@: int) (@ c.merge_calls))
    @: merge_facts_seen_cell int (cast: (@: int) (@ c.merge_facts_seen))
    int: at 2
    int: width
    int: slot
    int: op
    int: src
    int: ty
    @: value void 0
    @: original void 0
    @: copied c.Lmx 0
    @: source c.Lmx 0
    @: copied_array c.LmxArray 0
    @: source_array c.LmxArray 0
    while: at < gargc_cell[0]
        width: merge_fact_width(gargv_cell[0][at])
        if: width != 0 && at + width <= gargc_cell[0]
            if: arg(at + 1) = merge_calls_cell[0]
                merge_facts_seen_cell[0]: merge_facts_seen_cell[0] + 1
                check((cast: (int) (result != 0)), "observed merge returned a result")
                if: c.strcmp(gargv_cell[0][at], "merge_width") = 0
                    check((cast: (int) ((result != 0 && result_fields\size = (cast: (size_t) arg(at + 2))))), "merge result has the observed width")
                else:
                    slot: arg(at + 2)
                    value: 0
                    if: result != 0 && slot >= 0 && (cast: (size_t) slot) < result_fields\size
                        value: c.lmx_arena_ref_value(result, (cast: (size_t) slot))
                    check((cast: (int) (value != 0)), "observed merge result slot exists")
                    if: c.strcmp(gargv_cell[0][at], "merge_value") = 0
                        ty: numeric_type(gargv_cell[0][at + 3])
                        check((cast: (int) (ty != 0 && value != 0 && c.lmx_domain_type(dst_arena, value) = ty)), "merge result cell has the observed type")
                        if: ty != 0 && value != 0 && c.lmx_domain_type(dst_arena, value) = ty
                            check((cast: (int) (numeric_holds(value, ty, arg(at + 4)))), "merge result contains the current expected value")
                        ---
                    else:
                        op: arg(at + 3)
                        src: arg(at + 4)
                        original: 0
                        if: op >= 0 && (cast: (size_t) op) < count && operands[op] != 0 && src >= 0
                            @: operand c.Lmx operands[op]
                            @: operand_fields c.VoidArray @ operand\array
                            if: (cast: (size_t) src) < operand_fields\size
                                original: c.lmx_arena_ref_value(operands[op], (cast: (size_t) src))
                            ---
                        check((cast: (int) (original != 0)), "observed merge source slot exists")
                        if: c.strcmp(gargv_cell[0][at], "merge_same") = 0
                            check((cast: (int) (value != 0 && value = original)), "qualified merge retains the exact winning source cell")
                        if: c.strcmp(gargv_cell[0][at], "merge_fresh") = 0
                            check((cast: (int) (value != 0 && original != 0 && value != original)), "mutable merge allocates a distinct cell")
                        if: c.strcmp(gargv_cell[0][at], "merge_native") = 0 || c.strcmp(gargv_cell[0][at], "merge_child") = 0
                            check((cast: (int) (value != 0 && original != 0 && c.lmx_domain_kind(dst_arena, value) = c.LMX_KIND_STRUCT && c.lmx_domain_kind(src_arena, original) = c.LMX_KIND_STRUCT)), "observed callable pair has Structure descriptors")
                            if: value != 0 && original != 0 && c.lmx_domain_kind(dst_arena, value) = c.LMX_KIND_STRUCT && c.lmx_domain_kind(src_arena, original) = c.LMX_KIND_STRUCT
                                copied: (cast: (@: c.Lmx) value)
                                copied_fields: 0
                                if: copied != 0
                                    copied_fields: @ copied\array
                                ---
                                source: (cast: (@: c.Lmx) original)
                                source_fields: 0
                                if: source != 0
                                    source_fields: @ source\array
                                ---
                                check((cast: (int) (copied != source)), "merge copies the callable occurrence")
                                if: c.strcmp(gargv_cell[0][at], "merge_native") = 0
                                    check((cast: (int) (source\native != 0 && copied\native = source\native)), "copied callable shares its compiled native implementation")
                                else:
                                    src: arg(at + 5)
                                    check((cast: (int) ((src >= 0 && (cast: (size_t) src) < copied_fields\size && (cast: (size_t) src) < source_fields\size))), "observed callable child is in both occurrences")
                                    if: src >= 0 && (cast: (size_t) src) < copied_fields\size && (cast: (size_t) src) < source_fields\size
                                        value: c.lmx_arena_ref_value(copied, (cast: (size_t) src))
                                        original: c.lmx_arena_ref_value(source, (cast: (size_t) src))
                                        check((cast: (int) (value != 0 && original != 0 && value != original)), "copied callable has independent mutable own storage")
                        ---
                        if: c.strcmp(gargv_cell[0][at], "merge_array") = 0
                            check((cast: (int) (value != 0 && original != 0 && c.lmx_domain_kind(dst_arena, value) = c.LMX_KIND_ARRAY && c.lmx_domain_kind(src_arena, original) = c.LMX_KIND_ARRAY)), "observed pair has Array descriptors")
                            if: value != 0 && original != 0 && c.lmx_domain_kind(dst_arena, value) = c.LMX_KIND_ARRAY && c.lmx_domain_kind(src_arena, original) = c.LMX_KIND_ARRAY
                                copied_array: (cast: (@: c.LmxArray) value)
                                copied_array_fields: 0
                                if: copied_array != 0
                                    copied_array_fields: @ copied_array\array
                                ---
                                source_array: (cast: (@: c.LmxArray) original)
                                source_array_fields: 0
                                if: source_array != 0
                                    source_array_fields: @ source_array\array
                                ---
                                check((cast: (int) (copied_array != source_array && (copied_array_fields\size) = (source_array_fields\size))), "merge copies Array descriptor at the live length")
                                if: source_array_fields\size != 0U
                                    check((cast: (int) ((copied_array_fields\data) != 0 && (copied_array_fields\data) != (source_array_fields\data))), "nonempty copied Array has independent backing")
                                else:
                                    check((cast: (int) ((copied_array_fields\data) = 0 && (source_array_fields\data) = 0)), "empty Arrays have no backing")
                ---
            ---
            at: at + width
        else:
            at: at + 1
    ---
end: inspect_merge

fn: inspect (@: arena c.LmxArena; @: graph c.Lmx) int
    @: gargc_cell int (cast: (@: int) (@ c.gargc))
    @@@: gargv_cell char (cast: (@@@: char) (@ c.gargv))
    @: value c.Lmx 0
    @: other c.Lmx 0
    @: member c.Lmx 0
    @: physical_profile c.Lmx 0
    @: cell void 0
    @: field void 0
    size_t: produced c.l2_program_qualified_count()
    int: expected arg(1)
    int: i 0
    int: j
    int: at 2
    int: missing 0
    int: duplicate 0
    int: shared_profile 0
    check((cast: (int) (graph != 0 && c.l2_program_graph() = graph)), "the builder built the program unit in R0's own graph")
    # R0's graph is independent: the host above it is Message supervision, not a lexical space.
    check((cast: (int) (graph != 0 && graph\parent = 0)), "program unit is a lexical root: its parent Message is supervision, not a lexical node")
    check((cast: (int) (c.lmx_domain_kind(arena, (cast: (@: void) graph)) = c.LMX_KIND_STRUCT && c.lmx_domain_type(arena, (cast: (@: void) graph)) = c.LMX_TYPE_STRUCT)), "program unit is a live Structure of R0's arena")
    check((cast: (int) (expected >= 0 && produced = (cast: (size_t) expected))), "producer count is the translation-known number of qualified roots")
    if: expected < 0 || produced != (cast: (size_t) expected)
        return: 0
    ---
    if: expected = 0
        check((cast: (int) (c.l2_program_qualified_at(0U) = 0)), "zero-root accessor refuses every index")
        return: 1
    ---
    while: i < expected
        value: c.l2_program_qualified_at((cast: (size_t) i))
        if: value = 0
            missing: missing + 1
        else:
            physical_profile: root_profile(arena, value)
            check((cast: (int) (value\parent = 0)), "qualified root remains parentless")
            check((cast: (int) (c.lmx_domain_kind(arena, (cast: (@: void) value)) = c.LMX_KIND_STRUCT && c.lmx_domain_type(arena, (cast: (@: void) value)) = c.LMX_TYPE_STRUCT)), "qualified root is an exact Structure range value")
            check((cast: (int) (physical_profile != 0 && sealed_here(arena, (cast: (@: void) value)) != 0)), "qualified root has a nonzero exact profile in a sealed owner range")
            check((cast: (int) (sealed_here(arena, (cast: (@: void) physical_profile)) != 0 && c.lmx_domain_kind(arena, (cast: (@: void) physical_profile)) = c.LMX_KIND_STRUCT)), "receiver-expression profile is itself a sealed physical Structure")
            j: 0
            while: j < i
                if: c.l2_program_qualified_at((cast: (size_t) j)) = value
                    duplicate: duplicate + 1
                ---
                if: root_profile(arena, c.l2_program_qualified_at((cast: (size_t) j))) = physical_profile
                    shared_profile: shared_profile + 1
                ---
                j: j + 1
            ---
        ---
        i: i + 1
    ---
    check((cast: (int) (missing = 0)), "every exported entry is an exact physical root reference")
    check((cast: (int) (duplicate = 0)), "no physical root reference is duplicated")
    check((cast: (int) (shared_profile = 0)), "distinct qualified roots have distinct exact physical profiles")
    if: missing != 0
        return: 0
    ---
    while: at < gargc_cell[0]
        if: c.strcmp(gargv_cell[0][at], "profilecomplete") = 0
            check((cast: (int) (inspect_profile_ranges(arena) != 0)), "the requested complete physical profile observation passes")
            at: at + 1
            continue
        if: (c.strcmp(gargv_cell[0][at], "dispatch") = 0 || c.strcmp(gargv_cell[0][at], "dispatchthrow") = 0) && at + 3 < gargc_cell[0]
            at: at + 4
            continue
        if: c.strcmp(gargv_cell[0][at], "shape") = 0
            at: at + 1
            while: at < gargc_cell[0] && c.strcmp(gargv_cell[0][at], "endshape") != 0
                at: at + 1
            ---
            if: at < gargc_cell[0]
                at: at + 1
            continue
        if: c.strcmp(gargv_cell[0][at], "mutate") = 0 && at + 1 < gargc_cell[0]
            at: at + 2
            continue
        ---
        if: merge_fact_width(gargv_cell[0][at]) != 0
            at: at + merge_fact_width(gargv_cell[0][at])
            continue
        ---
        # `size|int|unsigned|ulong R F V`: field F of root R is a cell of that primitive type in
        # R's exact sealed profile, holding V.
        if: numeric_type(gargv_cell[0][at]) != 0 && at + 3 < gargc_cell[0]
            value: c.l2_program_qualified_at((cast: (size_t) arg(at + 1)))
            physical_profile: root_profile(arena, value)
            cell: c.lmx_arena_ref_value(value, (cast: (size_t) arg(at + 2)))
            check((cast: (int) (cell != 0 && c.lmx_domain_kind(arena, cell) = c.LMX_KIND_PRIMITIVE && c.lmx_domain_type(arena, cell) = numeric_type(gargv_cell[0][at]))), "numeric field has the declared primitive type")
            check((cast: (int) (cell != 0 && c.lmx_range_profile(arena, cell) = physical_profile && sealed_here(arena, cell) != 0)), "numeric field belongs to the same exact sealed profile")
            if: cell != 0
                check((cast: (int) (numeric_holds(cell, numeric_type(gargv_cell[0][at]), arg(at + 3)))), "numeric field holds the declared value")
            ---
            at: at + 4
        else:
            if: c.strcmp(gargv_cell[0][at], "same") = 0 && at + 3 < gargc_cell[0]
                value: c.l2_program_qualified_at((cast: (size_t) arg(at + 1)))
                other: c.l2_program_qualified_at((cast: (size_t) arg(at + 3)))
                check((cast: (int) (other != 0 && c.lmx_arena_ref_value(value, (cast: (size_t) arg(at + 2))) = (cast: (@: void) other))), "same field retains the other root's exact physical reference")
                at: at + 4
            else:
                if: c.strcmp(gargv_cell[0][at], "slot") = 0 && at + 4 < gargc_cell[0]
                    value: c.l2_program_qualified_at((cast: (size_t) arg(at + 1)))
                    other: c.l2_program_qualified_at((cast: (size_t) arg(at + 3)))
                    cell: c.lmx_arena_ref_value(other, (cast: (size_t) arg(at + 4)))
                    check((cast: (int) (cell != 0 && c.lmx_arena_ref_value(value, (cast: (size_t) arg(at + 2))) = cell)), "slot field retains the other branch member's exact physical reference")
                    member: (cast: (@: c.Lmx) cell)
                    check((cast: (int) (member != 0 && member\parent = other && c.lmx_range_profile(arena, cell) = root_profile(arena, other) && sealed_here(arena, cell) != 0)), "slot member keeps its lexical parent and exact sealed profile")
                    at: at + 5
                else:
                    # `entry N`, `letters N`, `fails N`, `mergefail N`, `stopped N`, `thrown N`, `ref N` and
                    # `postlog N` are read by main, not root facts.
                    if: (c.strcmp(gargv_cell[0][at], "entry") = 0 || c.strcmp(gargv_cell[0][at], "letters") = 0 || c.strcmp(gargv_cell[0][at], "fails") = 0 || c.strcmp(gargv_cell[0][at], "mergefail") = 0 || c.strcmp(gargv_cell[0][at], "stopped") = 0 || c.strcmp(gargv_cell[0][at], "thrown") = 0 || c.strcmp(gargv_cell[0][at], "ref") = 0 || c.strcmp(gargv_cell[0][at], "walkroot") = 0 || c.strcmp(gargv_cell[0][at], "postlog") = 0) && at + 1 < gargc_cell[0]
                        at: at + 2
                    else:
                        # `postpaths ... endpostpaths` are the service post's (shape_paths_check), not root facts.
                        if: c.strcmp(gargv_cell[0][at], "postpaths") = 0
                            while: at < gargc_cell[0] && c.strcmp(gargv_cell[0][at], "endpostpaths") != 0
                                at: at + 1
                            ---
                            at: at + 1
                        else:
                            check((cast: (int) (0)), "all driver fact arguments are recognized")
                            at: gargc_cell[0]
                        ---
                    ---
                ---
            ---
        ---
    ---
    return: 1
end: inspect

fn: shape_path (@: arena c.LmxArena; @: graph c.Lmx; @: at int; int: omit_last) @: void
    @: holder_fields c.VoidArray 0
    @: gargc_cell int (cast: (@: int) (@ c.gargc))
    @@@: gargv_cell char (cast: (@@@: char) (@ c.gargv))
    int: n arg(\at)
    int: j 0
    int: limit n - omit_last
    int: index
    int: ty
    @: value void (cast: (@: void) graph)
    @: holder c.Lmx
    check((cast: (int) (\at >= 0 && \at < gargc_cell[0] && n >= 0 && limit >= 0 && n <= gargc_cell[0] - \at - 1)), "physical path supplies its complete nonnegative depth")
    if: \at < 0 || \at >= gargc_cell[0] || n < 0 || limit < 0 || n > gargc_cell[0] - \at - 1
        return: 0
    while: j < limit
        if: c.strcmp(gargv_cell[0][\at + j + 1], "deref") = 0
            ty: 0 - 1
            if: value != 0 && c.lmx_domain_kind(arena, value) = c.LMX_KIND_PRIMITIVE
                ty: c.lmx_domain_type(arena, value)
            check((cast: (int) (ty >= c.LMX_TYPE_POINTER_BASE && ty < c.LMX_TYPE_ARRAY_OF_POINTER_BASE)), "physical path crosses the reference of an actual pointer cell")
            if: ty < c.LMX_TYPE_POINTER_BASE || ty >= c.LMX_TYPE_ARRAY_OF_POINTER_BASE
                return: 0
            value: c.lmx_pointer_value_known(value)
            j: j + 1
            continue
        if: c.strcmp(gargv_cell[0][\at + j + 1], "up") = 0
            check((cast: (int) (value != 0 && c.lmx_domain_kind(arena, value) = c.LMX_KIND_STRUCT)), "physical path climbs from an actual Structure")
            if: value = 0 || c.lmx_domain_kind(arena, value) != c.LMX_KIND_STRUCT
                return: 0
            holder: (cast: (@: c.Lmx) value)
            holder_fields: 0
            if: holder != 0
                holder_fields: @ holder\array
            ---
            value: (cast: (@: void) holder\parent)
            j: j + 1
            continue
        check((cast: (int) (value != 0 && c.lmx_domain_kind(arena, value) = c.LMX_KIND_STRUCT)), "physical path crosses an actual Structure")
        if: value = 0 || c.lmx_domain_kind(arena, value) != c.LMX_KIND_STRUCT
            return: 0
        holder: (cast: (@: c.Lmx) value)
        holder_fields: 0
        if: holder != 0
            holder_fields: @ holder\array
        ---
        index: arg(\at + j + 1)
        check((cast: (int) (index >= 0 && (cast: (size_t) index) < (holder_fields\size))), "physical path selects an existing child ordinal")
        if: index < 0 || (cast: (size_t) index) >= holder_fields\size
            return: 0
        value: c.lmx_arena_ref_value(holder, (cast: (size_t) index))
        j: j + 1
    ---
    \at: \at + n + 1
    return: value
end: shape_path

fn: shape_paths_check (@: arena c.LmxArena; @: graph c.Lmx; int: late) int
    @: holder_fields c.VoidArray 0
    @: failures_cell int (cast: (@: int) (@ c.failures))
    @: gargc_cell int (cast: (@: int) (@ c.gargc))
    @@@: gargv_cell char (cast: (@@@: char) (@ c.gargv))
    int: at 2
    int: before failures_cell[0]
    int: mode
    @: value void
    @: other void
    @: holder c.Lmx
    @: text c.VoidArray
    @: pool c.LmxPool
    size_t: text_length
    int: selected
    int: active (cast: (int) (late = 0))
    while: at < gargc_cell[0]
        if: c.strcmp(gargv_cell[0][at], "postpaths") = 0
            if: late = 0
                return: 1
            active: 1
            at: at + 1
            continue
        if: c.strcmp(gargv_cell[0][at], "endpostpaths") = 0
            return: 1
        if: active = 0
            at: at + 1
            continue
        mode: 0
        if: c.strcmp(gargv_cell[0][at], "samepath") = 0
            mode: 1
        if: c.strcmp(gargv_cell[0][at], "parentpath") = 0
            mode: 2
        if: c.strcmp(gargv_cell[0][at], "intpath") = 0
            mode: 3
        if: c.strcmp(gargv_cell[0][at], "widthpath") = 0
            mode: 4
        if: c.strcmp(gargv_cell[0][at], "namepath") = 0
            mode: 5
        if: c.strcmp(gargv_cell[0][at], "placenamepath") = 0
            mode: 6
        if: c.strcmp(gargv_cell[0][at], "cellpath") = 0
            mode: 7
        if: c.strcmp(gargv_cell[0][at], "rolepath") = 0
            mode: 8
        if: c.strcmp(gargv_cell[0][at], "sizepath") = 0
            mode: 9
        if: c.strcmp(gargv_cell[0][at], "differentpath") = 0
            mode: 10
        if: c.strcmp(gargv_cell[0][at], "nativepath") = 0
            mode: 11
        if: c.strcmp(gargv_cell[0][at], "nullpath") = 0
            mode: 12
        if: c.strcmp(gargv_cell[0][at], "typepath") = 0
            mode: 13
        if: c.strcmp(gargv_cell[0][at], "nullrefpath") = 0
            mode: 14
        if: c.strcmp(gargv_cell[0][at], "poolpath") = 0
            mode: 15
        if: mode = 0
            at: at + 1
            continue
        at: at + 1
        value: shape_path(arena, graph, @ at, (cast: (int) (mode = 6 || mode = 12)))
        # An empty place is a fact about its holder: the path stops at the
        # holder, and its last ordinal names the place that holds no object.
        if: mode = 12
            check((cast: (int) (value != 0 && c.lmx_domain_kind(arena, value) = c.LMX_KIND_STRUCT)), "nullpath selects an actual holder Structure")
            if: value = 0 || c.lmx_domain_kind(arena, value) != c.LMX_KIND_STRUCT
                return: 0
            holder: (cast: (@: c.Lmx) value)
            holder_fields: 0
            if: holder != 0
                holder_fields: @ holder\array
            ---
            selected: arg(at - 1)
            check((cast: (int) (selected >= 0 && (cast: (size_t) selected) < (holder_fields\size))), "empty place is an existing child ordinal")
            if: selected < 0 || (cast: (size_t) selected) >= (holder_fields\size)
                return: 0
            if: c.lmx_arena_ref_value(holder, (cast: (size_t) selected)) != 0
                c.printf("nullpath nonempty: child=%d argv-index=%d\n", selected, at)
            check((cast: (int) (c.lmx_arena_ref_value(holder, (cast: (size_t) selected)) = 0)), "selected place holds no object")
            continue
        if: mode = 6 && value != 0
            check((cast: (int) (c.lmx_domain_kind(arena, value) = c.LMX_KIND_STRUCT)), "name place belongs to an actual Structure")
            if: c.lmx_domain_kind(arena, value) != c.LMX_KIND_STRUCT
                return: 0
            holder: (cast: (@: c.Lmx) value)
            holder_fields: 0
            if: holder != 0
                holder_fields: @ holder\array
            ---
            selected: arg(at - 1)
            check((cast: (int) (selected >= 0 && (cast: (size_t) selected) < (holder_fields\size))), "name place is an existing owning child cell")
            if: selected < 0 || (cast: (size_t) selected) >= (holder_fields\size)
                return: 0
            value: (cast: (@: void) c.lmx_arena_ref_cell(holder, (cast: (size_t) selected)))
        ---
        if: value = 0
            check((cast: (int) (0)), "physical path reaches its selected nonnull object")
            return: 0
        if: mode = 1 || mode = 2 || mode = 10 || mode = 13
            other: shape_path(arena, graph, @ at, 0)
            check((cast: (int) (other != 0)), "comparison path reaches its actual object")
            if: mode = 1
                check((cast: (int) (other != 0 && value = other)), "two physical paths retain the exact same object")
            # The type an address has is the arena's answer for it, read of each cell: an expected type comes from
            # another actual cell, never from a number the row supplies.
            if: mode = 13
                check((cast: (int) (other != 0 && c.lmx_domain_kind(arena, value) = c.lmx_domain_kind(arena, other) && c.lmx_domain_type(arena, value) = c.lmx_domain_type(arena, other))), "two physical paths select addresses of one exact typed arena domain")
            if: mode = 10
                check((cast: (int) (other != 0 && value != other)), "two physical paths name distinct occurrence storage")
            if: mode = 2
                check((cast: (int) (c.lmx_domain_kind(arena, value) = c.LMX_KIND_STRUCT)), "parentpath selects an actual Structure")
                if: c.lmx_domain_kind(arena, value) = c.LMX_KIND_STRUCT
                    holder: (cast: (@: c.Lmx) value)
                    holder_fields: 0
                    if: holder != 0
                        holder_fields: @ holder\array
                    ---
                    check((cast: (int) (other != 0 && (cast: (@: void) holder\parent) = other)), "selected Structure has its actual containing parent")
                ---
            ---
        if: mode = 3 || mode = 4
            check((cast: (int) (at < gargc_cell[0])), "physical value assertion supplies its expected value")
            if: at >= gargc_cell[0]
                return: 0
            if: mode = 3
                check((cast: (int) (c.lmx_domain_kind(arena, value) = c.LMX_KIND_PRIMITIVE && c.lmx_domain_type(arena, value) = c.LMX_TYPE_INT)), "intpath selects a real typed int cell")
                if: c.lmx_domain_kind(arena, value) = c.LMX_KIND_PRIMITIVE && c.lmx_domain_type(arena, value) = c.LMX_TYPE_INT
                    check((cast: (int) (c.lmx_int_value_known(value) = arg(at))), "selected int cell holds its source initializer")
                ---
            else:
                check((cast: (int) (c.lmx_domain_kind(arena, value) = c.LMX_KIND_STRUCT)), "widthpath selects an actual Structure")
                if: c.lmx_domain_kind(arena, value) = c.LMX_KIND_STRUCT
                    holder: (cast: (@: c.Lmx) value)
                    holder_fields: 0
                    if: holder != 0
                        holder_fields: @ holder\array
                    ---
                    check((cast: (int) (arg(at) >= 0 && (holder_fields\size) = (cast: (size_t) arg(at)))), "selected Structure has its exact field count")
                ---
            ---
            at: at + 1
        ---
        if: mode = 11
            check((cast: (int) (at < gargc_cell[0] && (arg(at) = 0 || arg(at) = 1))), "nativepath supplies its expected dispatch capability")
            if: at >= gargc_cell[0]
                return: 0
            check((cast: (int) (c.lmx_domain_kind(arena, value) = c.LMX_KIND_STRUCT)), "nativepath selects an actual Structure")
            if: c.lmx_domain_kind(arena, value) = c.LMX_KIND_STRUCT
                holder: (cast: (@: c.Lmx) value)
                holder_fields: 0
                if: holder != 0
                    holder_fields: @ holder\array
                ---
                check((cast: (int) (holder\native != 0)) = arg(at), "selected Structure has its actual requested native word")
            ---
            at: at + 1
        ---
        if: mode = 15
            check((cast: (int) (at + 1 < gargc_cell[0] && (arg(at) = 0 || arg(at) = 1) && (arg(at + 1) = 0 || arg(at + 1) = 1))), "poolpath supplies sealing and profile-presence expectations")
            if: at + 1 >= gargc_cell[0]
                return: 0
            pool: c.lmx_range_pool(arena, value)
            check((cast: (int) (pool != 0)), "poolpath selects an actual occupied typed owner range")
            if: pool != 0
                check((cast: (int) (c.lmx_pool_is_sealed(pool) = arg(at))), "selected owner range has exactly the requested sealing state")
                check((cast: (int) (pool\profile != 0)) = arg(at + 1), "selected owner range has exactly the requested profile presence")
            ---
            at: at + 2
        ---
        if: mode = 5 || mode = 6
            check((cast: (int) (at < gargc_cell[0])), "exact external name assertion supplies its expected spelling")
            if: at >= gargc_cell[0]
                return: 0
            text_length: c.strlen(gargv_cell[0][at])
            text: c.lmx_source_name_get(arena, value)
            check((cast: (int) (text != 0)), "selected address has its own external source name")
            if: text != 0
                check((cast: (int) (text\size = text_length && (text_length = 0U || c.memcmp((text\data), (cast: (@: void) gargv_cell[0][at]), text_length) = 0))), "selected address has exactly its own source spelling")
            at: at + 1
        ---
        if: mode = 7
            check((cast: (int) (at + 1 < gargc_cell[0])), "physical cell assertion supplies its kind and type")
            if: at + 1 >= gargc_cell[0]
                return: 0
            check((cast: (int) (c.lmx_domain_kind(arena, value) = arg(at) && c.lmx_domain_type(arena, value) = arg(at + 1))), "selected address belongs to the exact typed arena domain")
            at: at + 2
        ---
        if: mode = 8
            check((cast: (int) (at + 1 < gargc_cell[0])), "source role assertion supplies opcode and source facet")
            if: at + 1 >= gargc_cell[0]
                return: 0
            check((cast: (int) (c.lmx_domain_kind(arena, value) = c.LMX_KIND_STRUCT)), "source role assertion selects an actual application")
            if: c.lmx_domain_kind(arena, value) = c.LMX_KIND_STRUCT
                holder: (cast: (@: c.Lmx) value)
                holder_fields: 0
                if: holder != 0
                    holder_fields: @ holder\array
                ---
                other: c.lmx_arena_ref_value(holder, 0U)
                check((cast: (int) (other != 0 && c.lmx_domain_kind(arena, other) = c.LMX_DOMAIN_KIND_OP)), "application head is a typed operation record")
                if: other != 0 && c.lmx_domain_kind(arena, other) = c.LMX_DOMAIN_KIND_OP
                    @: typed_other c.LmxOp (cast: (@: c.LmxOp) other)
                    check((cast: (int) (typed_other\code % c.LMX_WALK_OP_COUNT = arg(at) && typed_other\code / c.LMX_WALK_OP_COUNT = arg(at + 1))), "application retains its exact execution opcode and source boundary")
                ---
            ---
            at: at + 2
        ---
        # The cell itself is present (the path reached it); what it holds is the null reference.
        if: mode = 14
            check((cast: (int) (c.lmx_domain_kind(arena, value) = c.LMX_KIND_PRIMITIVE && c.lmx_domain_type(arena, value) >= c.LMX_TYPE_POINTER_BASE && c.lmx_domain_type(arena, value) < c.LMX_TYPE_ARRAY_OF_POINTER_BASE)), "nullrefpath selects an actual pointer cell")
            if: c.lmx_domain_kind(arena, value) = c.LMX_KIND_PRIMITIVE && c.lmx_domain_type(arena, value) >= c.LMX_TYPE_POINTER_BASE && c.lmx_domain_type(arena, value) < c.LMX_TYPE_ARRAY_OF_POINTER_BASE
                check((cast: (int) (c.lmx_pointer_value_known(value) = 0)), "selected pointer cell holds the null reference")
            ---
        ---
        if: mode = 9
            check((cast: (int) (at < gargc_cell[0] && arg(at) >= 0)), "physical size_t assertion supplies its nonnegative expected value")
            if: at >= gargc_cell[0] || arg(at) < 0
                return: 0
            check((cast: (int) (c.lmx_domain_kind(arena, value) = c.LMX_KIND_PRIMITIVE && c.lmx_domain_type(arena, value) = c.LMX_TYPE_SIZE_T)), "sizepath selects a real typed size_t cell")
            if: c.lmx_domain_kind(arena, value) = c.LMX_KIND_PRIMITIVE && c.lmx_domain_type(arena, value) = c.LMX_TYPE_SIZE_T
                check((cast: (int) (c.lmx_size_value_known(value) = (cast: (size_t) arg(at)))), "selected size_t cell holds its exact expected value")
            ---
            at: at + 1
        ---
    ---
    return: failures_cell[0] = before
end: shape_paths_check

fn: shape_mutate (@: arena c.LmxArena; @: graph c.Lmx) int
    @: holder_fields c.VoidArray 0
    @: graph_fields c.VoidArray 0
    graph_fields: 0
    if: graph != 0
        graph_fields: @ graph\array
    ---
    @: gargc_cell int (cast: (@: int) (@ c.gargc))
    @@@: gargv_cell char (cast: (@@@: char) (@ c.gargv))
    int: found_int 0
    int: code 0
    int: at 2
    size_t: i 0U
    size_t: k 0U
    size_t: width 0U
    @: child void 0
    @: typed_op c.LmxOp 0
    @: frame void 0
    @: outer void 0
    @: body void 0
    @: holder c.Lmx 0
    int: path_at
    int: last_at
    int: parsed 0
    int: replacement 0
    @@: place void
    @: extended c.LmxPool 0
    @@: original void 0
    if: graph = 0
        return: 0
    while: at + 1 < gargc_cell[0] && c.strcmp(gargv_cell[0][at], "mutate") != 0
        at: at + 1
    ---
    if: at + 1 >= gargc_cell[0]
        return: 1
