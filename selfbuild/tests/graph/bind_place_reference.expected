---
    Observed:
        int: seen 49
    end: Observed
    First:
        int: marker 4
    end: First
    Second:
        int: marker 9
    end: Second
---
fn: replace () int
    @: shared (node [] 0)
    :=: selected (shared \ Second)
    return: 0
end: replace
fn: keep (@: selected) int
    @: shared (node [] 0)
    :=: selected (shared \ Second)
    return: 0
end: keep
fn: caller () int
    @: shared (node [] 0)
    @: selected (shared \ First)
    int: k (keep)
    int: first (selected \ marker)
    int: r (replace)
    return: ((first * 10) + (selected \ marker))
end: caller
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) (caller)
end: main
main:
