Example:
    char[]: text
    return: char[]
    run:
        char[]: source "ACGT"
        char[]: target "TGCA"
        char[]: result [copy(text)]
        int: i 0
        while: i < length(text)
            int: j 0
            while: j < length(source)
                if: text[i] = source[j]
                    result[i] := target[j]
                    break
                j += 1
            i += 1
        return: result
