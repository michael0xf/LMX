    int: source_match
    c.L2ValueSpan: operand
    @: source_use c.L2PathFact
    out\schema: -1
    out\path: 0
    out\layout: -1
    out\method: -1
    out\place: -1
    out\origin: 0
    out\origin_count: 0
    out\origin_method: -1
    c.lm_compiler_reference_fields(@ first, @ n)
    if: n < 1 || first = 0 || first\value = 0 || first\value\as = 0
        return: (cast: (int) (0))
    # Pointer casts preserve the operand's possible physical sources, never
    # replace them by the cast target. Check its immediate contract: an integer cast
    # or arithmetic cannot acquire provenance merely by casting back.
    if: n = 1 && c.lm_compiler_frame_head((cast: (const: @: c.LmP0Node) (first\value)), "cast") != 0
        cast_frame: first\value\as\frame
        operand_count: c.lm_compiler_count_active((cast: (const: @: c.LmP0Structure) (cast_frame\body))) - 1
        if: operand_count < 1
            return: (cast: (int) (0))
        type_field: c.lm_compiler_next_active((cast: (@: c.LmP0Field) (cast_frame\body\first_field)))
        operand_field: c.lm_compiler_next_active((cast: (@: c.LmP0Field) (type_field\next)))
        if: c.lm_compiler_cast_resolve((cast: (const: @: c.LmP0Node) (type_field\value)), @ cast_type, 0) != 0 || c.lm_compiler_pointer_depth(cast_type) = 0
            return: (cast: (int) (0))
        c.lm_compiler_reference_fields(@ operand_field, @ operand_count)
        if: operand_count < 1 || c.lm_compiler_operand_run(operand_field, operand_count) != operand_count
            return: (cast: (int) (0))
        if: lm_compiler_reference_descriptor(operand_field, operand_count, mi, address) = 0
            pointer_operand: 1
        if: pointer_operand = 0 && operand_count = 1 && c.lm_compiler_colon_value_ty(operand_field, mi, @ operand_type) = 0 && c.lm_compiler_pointer_depth(operand_type) > 0
            pointer_operand: 1
