+fn: shape_node_op (@: item void; @: arena c.LmxArena) int
+    @: head void item
+    int: code
+    if: item = 0
+        return: 0 - 1
+    if: c.lmx_domain_kind(arena, item) = c.LMX_KIND_STRUCT
+        head: c.lmx_arena_ref_value((cast: (@: c.Lmx) item), 0U)
+    if: head = 0 || c.lmx_domain_kind(arena, head) != c.LMX_DOMAIN_KIND_OP || c.lmx_domain_type(arena, head) != c.LMX_DOMAIN_OP || c.lmx_range_stride(arena, head) != c.sizeof(c.LmxOp)
+        return: 0 - 1
+    @: typed_head c.LmxOp (cast: (@: c.LmxOp) head)
+    code: typed_head\code
+    if: code < 0 || code >= c.LMX_WALK_OP_COUNT * c.LMX_WALK_SOURCE_COUNT
+        return: 0 - 1
+    return: code % c.LMX_WALK_OP_COUNT
+end: shape_node_op
+
+fn: shape_source_role (@: item c.Lmx; @: arena c.LmxArena) int
+    @: head void c.lmx_arena_ref_value(item, 0U)
+    int: code
+    if: shape_node_op(head, arena) < 0
+        return: 0 - 1
+    @: typed_head c.LmxOp (cast: (@: c.LmxOp) head)
+    code: typed_head\code
+    return: code / c.LMX_WALK_OP_COUNT
+end: shape_source_role
