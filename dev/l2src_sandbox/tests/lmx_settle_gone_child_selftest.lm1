predef: "l2src/lmx_settle.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_manager.lm1"
predef: "l2src/lmx_service.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

sub: sg_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: sg_check

fn: sg_thread (@: LmxArena arena; int: parent; @@: LmxMsg out_message) @: LmxThread
    @: Lmx graph lmx_node_new_owned(arena)
    @: LmxListDesc children 0
    @: LmxMsg message
    @: LmxPost mail
    @: LmxThread thread
    @: LmxSchedule slot
    \out_message: 0
    if: graph = 0
        return: 0
    ---
    if: parent != 0
        children: lmx_list_new_owned(c.LMX_TYPE_ARRAY_OF_POINTER_BASE + c.LMX_DOMAIN_THREAD, arena)
        if: children = 0 || lmx_arena_refs_open_owned(arena, graph, 1U) != 0 || lmx_arena_ref_store(graph, 0U, (cast: (@: void) children)) != 0
            return: 0
        ---
    ---
    mail: (cast: (@: LmxPost) lmx_arena_take(arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    thread: (cast: (@: LmxThread) lmx_arena_take(arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD))
    slot: (cast: (@: LmxSchedule) lmx_arena_take(arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: mail = 0 || thread = 0 || slot = 0
        return: 0
    ---
    message: lmx_thread_message(thread)
    if: lmx_post_init(arena, mail) != c.LMX_POST_OK || lmx_thread_init(arena, thread, graph, mail, slot) != c.LMX_THREAD_OK || lmx_schedule_init(slot, arena, (cast: (@: void) thread), 1000U) != c.LMX_SCHEDULE_OK
        return: 0
    ---
    if: parent != 0 && lmx_thread_children_bind(thread, children, arena) != c.LMX_THREAD_OK
        return: 0
    ---
    \out_message: message
return: thread

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: parent_arena
    LmxArena: child_arena
    @: LmxThread parent
    @: LmxThread child
    @: LmxMsg message
    int: failures
    memset((cast: (@: void) (@ parent_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ child_arena)), 0, c.sizeof(c.LmxArena))
    sg_check(counts, lmx_arena_open(@ parent_arena) = 0 && lmx_arena_open(@ child_arena) = 0, "arenas")
    parent: sg_thread(@ parent_arena, 1, @ message)
    child: sg_thread(@ child_arena, 0, @ message)
    sg_check(counts, parent != 0 && child != 0 && lmx_thread_child_add(parent, child, @ parent_arena) = c.LMX_THREAD_OK, "membership")
    message\success: 1
    message\running: 0
    message\handoff_ready: 1
    sg_check(counts, lmx_thread_finish(child) = c.LMX_THREAD_OK && lmx_thread_child_is(parent, child) != 0, "finish kept child membership")
    sg_check(counts, lmx_settle_children(parent, @ parent_arena, 0, 0, 1U) = c.LMX_SETTLE_OK, "settle")
    sg_check(counts, lmx_thread_child_count(parent) = 0U, "remove preceded release")
    sg_check(counts, lmx_arena_release(@ parent_arena) = 0, "parent release")
    failures: counts[1]
    c.printf("lmx_settle_gone_child: %d checks, %d failures\n", counts[0], failures)
    free(counts)
return: failures
