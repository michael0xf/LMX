---
    Observed:
        int: last 1
        int: pair 23
    end: Observed
---
@: shared (data [] 0)
fn: mark () int (
    int: calls 0
)
    :=: (data \ calls) ((data \ calls) + 1)
    return: (data \ calls)
end: mark
fn: twice () int
    int: first (mark)
    int: second (mark)
    return: ((first * 10) + second)
end: twice
int: last 0
int: pair 0
:=: last (mark)
:=: pair (twice)
sub: main ()
    :=: ((shared \ Observed) \ last) last
    :=: ((shared \ Observed) \ pair) pair
end: main
main:
