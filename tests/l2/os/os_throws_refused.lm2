# The same signature, but only the win branch may throw: the throw exits are part of the method's contract.
os:
    win:
        fn: os_check (int: n) int
            throws: Bad
            if: n < 0
                throw: Bad(n)
            return: n
        end: os_check
    default:
        fn: os_check (int: n) int
            return: n
        end: os_check
end: os
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
