---
    Observed:
        int: seen 2
    end: Observed
---
sub: main () (
    A:
        int: v 1
        B
    end: A
    B:
        int: v 2
        A
    end: B
)
end: main
int: seen ((((((main \ data) \ A) \ B) \ A) \ B) \ v)
sub: observe ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) seen
end: observe
observe:
