# FACTORY (the author, 2026-10-05): `@: h f(a)` receives a factory's result; this row wrote `h: f a` until then.
# A bare held callable remains a reference even where a number is expected.
# Explicit p0() supplies 100 by a store, an int actual and a return, then a
# fourth explicit call supplies u. Each call notes 1 in the copied lexical
# root, observed as 1111 by the harness; the source trace stays 0. Entry 7.
int: trace 0

fn: note (int: v) int
    node\trace: node\trace * 10 + v
    return: 0
end: note

fn: seen () int
    return: node\trace
end: seen

fn: make0 (int: n) fn: () int
    fn: f0 () int
        return: n + note(1)
    return: f0

fn: id (int: a) int
    return: a
end: id

@: p0 make0(100)
p0
int: r 0
r: p0()
int: s id(p0())

fn: use () int
    return: p0()
end: use

int: t use()
int: u p0()
int: ok 7
if: r != 100
    ok: 81
if: s != 100
    ok: 82
if: t != 100
    ok: 83
if: u != 100
    ok: 84
if: seen() != 0
    ok: 85
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
