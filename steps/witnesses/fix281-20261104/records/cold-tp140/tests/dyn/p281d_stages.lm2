# Slice 281 probe: each stage of a declared reference field, each under its own catch.  Entry 7.
RefBox:
    int: q 1
    int: a 2
end: RefBox
RefHolder:
    @: p RefBox RefBox
end: RefHolder
RefOnlyQ:
    int: q 5
end: RefOnlyQ
RefOtherQ:
    int: q 6
end: RefOtherQ
RefNoQ:
    int: a 7
end: RefNoQ
fn: read_ref_q () int
    return: RefHolder\p\q
end: read_ref_q
fn: ref_local_put () int
    @: ref_local RefHolder RefHolder
    ref_local\p: RefOtherQ
    return: read_ref_q()
end: ref_local_put
fn: ref_local_refused () int
    @: ref_local RefHolder RefHolder
    ---
        ref_local\p: RefNoQ
        return: 99
        catch: implements ()
            return: read_ref_q()
    ---
end: ref_local_refused
fn: ref_formal_refused (@: h RefHolder) int
