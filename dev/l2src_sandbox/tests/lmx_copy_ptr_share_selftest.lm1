predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# -186 k3: copier copies a pointer cell but SHARES the pointee (reference @: T).
# Mutant: restore lmx_copy_value(pointee) descent -> pointee addresses differ RED.

int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

sub: char_identity ()
    LmxArena: src
    LmxArena: dst
    @: Lmx source 0
    @: Lmx copy 0
    @: VoidArray array 0
    @: void a 0
    @: void b 0
    @: void ca 0
    @: void cb 0
    @: char bytes 0
    int: i 0
    memset(@ src, 0, c.sizeof(c.LmxArena))
    memset(@ dst, 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ src) != 0 || lmx_arena_open(@ dst) != 0
        c.abort()
    # Constructor-first: this must bootstrap the literal table before taking
    # any mutable CHAR cell from its pool.
    a: lmx_char_new_owned(@ src)
    b: lmx_char_new_owned(@ src)
    check(a != 0 && b != 0 && a != b, "equal zero char declarations have distinct cells")
    if: a = 0 || b = 0
        c.abort()
    lmx_char_store_known(a, 200)
    lmx_char_store_known(b, 200)
    while: i < 256
        check(lmx_char_cell(@ src, i) != a && lmx_char_cell(@ src, i) != b && lmx_char_value_known(lmx_char_cell(@ src, i)) = (cast: (int) (cast: (char) i)), "constructor-first preserves each literal byte")
        i: i + 1
    array: lmx_array_new_owned(c.LMX_TYPE_ARRAY_OF_CHAR, 2U, @ src)
    if: array = 0
        c.abort()
    bytes: (cast: (@: char) array\data)
    bytes[0]: 7
    check(lmx_char_value_known(a) = (cast: (int) (cast: (char) 200)) && lmx_char_value_known(lmx_char_cell(@ src, 7)) = 7, "char array is independent of owned cells and literals")
    source: lmx_node_new_owned(@ src)
    if: source = 0 || lmx_arena_refs_open_owned(@ src, source, 3U) != 0
        c.abort()
    lmx_arena_ref_store(source, 0U, a)
    lmx_arena_ref_store(source, 1U, b)
    lmx_arena_ref_store(source, 2U, a)
    check(lmx_graph_copy_owned(source, @ src, @ dst, @ copy) = c.LMX_GRAPH_COPY_OK && copy != 0, "char copy into initially empty destination arena")
    if: copy = 0
        c.abort()
    ca: lmx_arena_ref_value(copy, 0U)
    cb: lmx_arena_ref_value(copy, 1U)
    check(ca != a && cb != b && ca != cb, "copy does not collapse equal distinct char cells")
    check(ca = lmx_arena_ref_value(copy, 2U), "copy map preserves repeated char reference identity")
    check(lmx_range_type_of(@ dst, ca) = c.LMX_TYPE_CHAR && lmx_char_value_known(ca) = (cast: (int) (cast: (char) 200)), "copied char has target C99 value and domain")
    lmx_char_store_known(ca, 65)
    check(lmx_char_value_known(cb) = (cast: (int) (cast: (char) 200)) && lmx_char_value_known(a) = (cast: (int) (cast: (char) 200)), "copy mutation does not affect distinct cell or source")
    check(lmx_char_value_known(lmx_arena_ref_value(copy, 2U)) = 65 && lmx_char_value_known(lmx_char_cell(@ dst, 65)) = 65 && ca != lmx_char_cell(@ dst, 65), "alias mutation preserves destination literal table")
    lmx_arena_release(@ src)
    lmx_arena_release(@ dst)
end: char_identity

fn: main () int
    LmxArena: src_arena
    LmxArena: dst_arena
    @: Lmx unit 0
    @: Lmx holder 0
    @: Lmx pointee 0
    @: Lmx copied 0
    @: void pcell 0
    @: void pcopy 0
    @: void shared 0
    @: void icell 0
    @: void icopy 0
    int: status 0
    int: pty c.LMX_TYPE_POINTER_BASE + 7

    memset((cast: (@: void) (@ src_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ dst_arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ src_arena) != 0 || lmx_arena_open(@ dst_arena) != 0
        return: 2
    ---

    unit: lmx_node_new_owned(@ src_arena)
    if: unit = 0 || lmx_arena_refs_open_owned(@ src_arena, unit, 4U) != 0
        return: 2
    ---

    pointee: lmx_node_new_owned(@ src_arena)
    if: pointee = 0 || lmx_arena_refs_open_owned(@ src_arena, pointee, 2U) != 0
        return: 2
    ---
    pointee\parent: unit
    icell: lmx_int_new_owned(@ src_arena)
    if: icell = 0 || lmx_int_store_known(icell, 77) != 0 || lmx_arena_ref_store(pointee, 1U, icell) != 0
        return: 2
    ---

    holder: lmx_node_new_owned(@ src_arena)
    if: holder = 0 || lmx_arena_refs_open_owned(@ src_arena, holder, 2U) != 0
        return: 2
    ---
    holder\parent: unit
    pcell: lmx_pointer_new_owned(pty, @ src_arena)
    if: pcell = 0 || lmx_pointer_store_known(pcell, (cast: (@: void) pointee)) != 0 || lmx_arena_ref_store(holder, 1U, pcell) != 0
        return: 2
    ---

    status: lmx_graph_copy_owned(holder, @ src_arena, @ dst_arena, @ copied)
    check((cast: (int) (status = LMX_GRAPH_COPY_OK && copied != 0 && copied != holder)), "copy holder OK")

    pcopy: lmx_arena_ref_value(copied, 1U)
    check((cast: (int) (pcopy != 0 && pcopy != pcell)), "pointer cell is a new cell in dst")
    check((cast: (int) (lmx_range_classify(@ dst_arena, pcopy) = c.LMX_KIND_PRIMITIVE && lmx_range_type_of(@ dst_arena, pcopy) >= c.LMX_TYPE_POINTER_BASE)), "dst slot is a pointer cell")

    shared: lmx_pointer_value_known(pcopy)
    check((cast: (int) (shared = (cast: (@: void) pointee))), "copy shares pointee by address")
    # Mutant restored descent: shared would be a new Structure in dst_arena, address differs.
    check((cast: (int) (shared != 0 && lmx_range_classify(@ src_arena, shared) = c.LMX_KIND_STRUCT)), "shared pointee still classified in src")
    icopy: lmx_arena_ref_value((cast: (@: Lmx) shared), 1U)
    check((cast: (int) (icopy = icell && lmx_int_value_known(icopy) = 77)), "shared pointee int cell unchanged (mutant deep copy -> new cell RED)")

    char_identity()
    if: failures != 0
        c.printf("lmx_copy_ptr_share_selftest %d/%d FAILED\n", failures, checks)
        return: 1
    ---
    c.printf("OK %d checks\n", checks)
return: 0
