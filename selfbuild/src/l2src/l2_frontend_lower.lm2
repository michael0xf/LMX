                # merge runs; unprofiled, it supplies no profile to keep.
                if: form = 3
                    if: lm_compiler_emit_merge_typed_operand((cast: (const: @: c.LmP0Node) (c.lm_compiler_merge_typed_decl(last, 1))), k, mi, ind, l2_bind_tok) != 0
