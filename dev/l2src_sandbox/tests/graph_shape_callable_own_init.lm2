# A declaration excludes its own row throughout the initializer. The nested
# named actual must bind against the actual callable formal's signature.
fn: real (int: x) int
    return: x
end: real

fn: choose (real: f) int
    int: f f(x: 3)
    return: f
end: choose

sendMessage: exit(exit_code: choose(real); stdout: ""; stderr: "")
return
