            # emission's l2_emit_admit): the site puts the method on the throw channel.
            if: l2_ml_ns[l2_ml_find(stmt\as\frame\head)] >= 0 && l2_admit_site(mi) != 0
                return: 1
            field: lm_compiler_next_active(field\next)
            continue
        if: lm_compiler_frame_head(stmt, "if") = 0 && lm_compiler_unimpl_numeric(stmt) != 0
            return: l2_error(path, stmt, lm_compiler_unimpl_numeric(stmt))
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0 && depth > 0 && l2_scope_n = 0
            return: l2_error(path, stmt, "unsupported own declaration")
        declaration: l2_declaration(stmt)
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_own_decl_ty(stmt) != 0
            if: l2_check_decl_candidate(stmt, mi, path) != 0
                return: 1
            ---
        ---
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt)
            field: lm_compiler_next_active(field\next)
        raw: 1
        ix: 1
        pd: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0
            pd: l2_check_indirect_write(stmt, mi, path)
            if: pd = 1
                return: 1
            if: pd = 0
                field: lm_compiler_next_active(field\next)
                continue
            pd: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && stmt\as != 0 && stmt\as\frame != 0 && stmt\as\frame\head != 0
            ix: l2_index_head(stmt, mi)
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && (ix = 2 || ix = 3)
            return: l2_error(path, stmt, "unsupported index")
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && stmt\as != 0 && stmt\as\frame != 0
            raw: l2_raw_head(stmt\as\frame\head, mi)
            # Prefix writes were consumed through the retained head plan.
            pd: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && pd = 2
            return: l2_error(path, stmt, "invalid raw dereference")
        # `f()`/`f: ()`/closed empty vertical, name absent (FABLE-SONNET-
        # EMPTY-STRUCT-20260923-132): the empty Structure-body supplies its
        # own structural type -- declare f as a new, empty structural own
        # field through the ordinary declaration path, exactly like
        # `Model: fresh` two cases above minus a named model to record (no
        # l2_own_nsty_set: there is no name to look up, and an opaque,
        # no-namespace own field is exactly what a 0-field type has to be).
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_empty_struct_decl_shape(stmt, mi) != 0
            if: l2_local_ns_declare(stmt, mi, path) != 0
                return: 1
            field: lm_compiler_next_active(field\next)
            continue
        # A method's own named Structure, `S:` + number fields (l2_local_ns_shape, l2_local_ns_declare).
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_local_ns_shape(stmt, mi) != 0
            if: l2_local_ns_declare(stmt, mi, path) != 0
                return: 1
            field: lm_compiler_next_active(field\next)
            continue
        cj: l2_empty_pointer_assignment(stmt, mi)
        if: cj >= 0
            if: (l2_own_qualified(cj) & 2) != 0
                return: l2_error(path, stmt, "a const binding cannot be assigned")
            if: l2_own_method_requirement(cj) >= 0
                return: l2_error(path, stmt, "cannot assign a Structure to a method pointer")
            if: l2_own_nsty_get(cj) >= 0 && l2_admit_site(mi) != 0
                return: 1
            field: lm_compiler_next_active(field\next)
            continue
        # Known ordinary Structure heads receive an assignment candidate;
        # they do not acquire callable formals from the Frame syntax.
        # A bare colon frame whose head is not a call is an update only when
        # that head already has a typed mutable binding.  In particular,
        # `arg: 7` must not silently invent arg; the graph-construction role was
        # normalized to an explicit merge before reaching this check.
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_is_asgn(stmt, mi) != 0 && stmt\as\frame\head != 0 && lm_compiler_ident(stmt\as\frame\head) != 0 && l2_param_find(mi, stmt\as\frame\head) < 0 && l2_own_visible(mi, stmt\as\frame\head) < 0 && l2_slot_find(mi, stmt\as\frame\head) < 0 && l2_ml_find(stmt\as\frame\head) < 0
            return: l2_error(path, stmt, "assignment target must be a declared typed mutable value")
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_colon_check_assignment(stmt, mi, path) != 0
            return: 1
        # A nonprimitive formal -- `(@: T v)` or `(T: v)`, ONE reference transport in a signature (the book, "A signature
        # is not executed"; K03) -- is a reference binding in the body, rebound after the admission of its value to T, as
        # a typed reference local is (the ml branch above): the emission's l2_emit_admit before the formal's store; the
        # site puts the method on the throw channel.  The condition keys on the formal's model, the same for both
        # spellings; `v: w` is not v's call (a reference binding does not auto-call its referent).
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_is_asgn(stmt, mi) != 0 && lm_compiler_formal_find(mi, stmt\as\frame\head) >= 0 && l2_input_model(mi, lm_compiler_formal_find(mi, stmt\as\frame\head)) >= 0 && l2_admit_site(mi) != 0
            return: 1
        if: l2_is_asgn(stmt, mi) != 0
            cj: l2_own_visible(mi, stmt\as\frame\head)
            if: cj >= 0 && l2_own_is_slot(cj) = 0 && l2_own_nsty_get(cj) >= 0 && l2_admit_site(mi) != 0
                return: 1
            ---
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && l2_check_path_write(stmt, mi, path) != 0
            return: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0 && ix != 0 && pd != 0 && (stmt\as = 0 || stmt\as\frame = 0 || stmt\as\frame\head = 0 || (l2_own_visible(mi, stmt\as\frame\head) < 0 && l2_slot_find(mi, stmt\as\frame\head) < 0 && lm_compiler_find_method(stmt\as\frame\head) < 0 && l2_param_find(mi, stmt\as\frame\head) < 0 && raw != 0 && l2_is_known(stmt\as\frame\head) = 0 && l2_is_path_head(stmt\as\frame\head, mi) = 0 && l2_cap_path_head(mi, stmt\as\frame\head) = 0))
            if: stmt\as\frame\head != 0 && stmt\as\frame\head\data != 0 && lm_compiler_seg_count(stmt\as\frame\head\data, stmt\as\frame\head\length) > 1
                return: l2_error(path, stmt, "unknown field path root")
