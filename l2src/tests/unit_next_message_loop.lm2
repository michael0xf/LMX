# "receiveMessage: until 0" (author, Q10): take letters until the inbox is
# empty. R0 holds exactly the argv letter, so the loop runs once; the bound
# only keeps a receiver that never reaches 0 from looping forever.
int: n 0
receiveMessage: m
while: m != 0 && n < 5
    n: n + 1
    receiveMessage: m
if: n != 1
    sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
