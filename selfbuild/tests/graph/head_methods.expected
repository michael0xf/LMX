---
    Observed:
        int: quiet 0
        int: first 5
        int: empty 2
        int: named 10
        int: calls 3
    end: Observed
---
@: shared (data [] 0)
Holder:
    fn: calc (int: value 0) int (
        int: calls 0
    )
        :=: (data \ calls) ((data \ calls) + 1)
        return: (value + (data \ calls))
    end: calc
end: Holder
call: Holder
---
    Holder: \ calc
---
---
    Holder\calc()
---
int: quiet (((Holder \ calc) \ data) \ calls)
int: first Holder\calc(4)
int: empty Holder\calc()
int: named Holder\calc((:= value 7))
int: calls (((Holder \ calc) \ data) \ calls)
sub: main ()
    :=: ((shared \ Observed) \ quiet) quiet
    :=: ((shared \ Observed) \ first) first
    :=: ((shared \ Observed) \ empty) empty
    :=: ((shared \ Observed) \ named) named
    :=: ((shared \ Observed) \ calls) calls
end: main
main:
