# OPEN positive. A returned definition that itself reads a name nothing
# declares takes it from the caller, as a method of the unit does. g0
# reads k, which its method took, and n, which nothing declares. same has
# n 40 and calls the held u0: 5 + 40. This implementation refuses the
# definition with the words of a merge's binding.
fn: makeUse (int: k) fn: () int
    fn: g0 () int
        return: k + n
    return: g0

u0: makeUse 5

fn: same () int
    int: n 40
    return: u0()
end: same

int: b same()
int: ok 7
if: b != 45
    ok: 82
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
