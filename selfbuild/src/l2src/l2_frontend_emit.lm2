        if: base < 0
            return: (cast: (int) (1))
        \out: base
        return: (cast: (int) (0))
    if: place = 0
        return: (cast: (int) (1))
    if: place\parent = stop
        if: base = 0 - 2 && root_path != 0
            code_edge: c.lm_compiler_rw_path_code_root(root_path, root_level)
        if: base >= 0
            code_edge: code_base
