# Entry Main. The value of the two-argument form: `call(A C)` read as a value gives the result described by the
# data of C (`return: int` in `Sum2`): the body returns a * 10 + b with the fields of A supplied, 73; r 73.
# Norm: the book #structural-call (the same data describe the result by the `return` field), #return-in-data.
Sum2:
    return: int
    int: a 1
    int: b 2
    add:
        return: a * 10 + b
    end: add
end: Sum2
Args2:
    int: a 7
    int: b 3
end: Args2
int: r 0
Main:
    node\r := call(Args2 Sum2\add)
