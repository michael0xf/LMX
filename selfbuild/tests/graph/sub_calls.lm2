fn: wrapper () int (int: total 4)
    capture()
    sub: capture () (int: seen 0)
        seen := total
        total := total + 1
    end: capture
    return: capture\data\seen * 10 + total
end: wrapper
int: nested_value wrapper()
sub: outer () (int: trace 0)
    finally:
        trace := trace + 1
    end: finally
    finally:
        return()
    end: finally
    trace := 2
end: outer
outer()
int: outer_trace outer\data\trace
