Example:
    char[]: text
    return: char[]
    run:
        throws: copy(FxSeqPush\append\throws) copy(FxRecordOperands\record\throws)
        char[]: out []
        int: i 0
        while: i < length(text)
            if: text[i] >= '0' && text[i] <= '9'
                FxSeqPush\append(out; (text[i] record))
            i += 1
        return: out
