predef: "l2src/lmx.h.lm1"

# Historical translator boundary, not a language restriction: this implementation
# recognizes only primitive words in sizeof type frames. Preserve the located
# refusal here rather than letting unsupported lowering reach the C compiler.
fn: arena_ptr_bytes () size_t
    return: sizeof(@: LmxArena)
end: arena_ptr_bytes

arena_ptr_bytes()
return
