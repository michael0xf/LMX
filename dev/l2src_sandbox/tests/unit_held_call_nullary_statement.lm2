# FACTORY (the author, 2026-10-05): `@: h f(a)` receives a factory's result; this row wrote `h: f a` until then.
# Explicit p0() calls note 1 four times in the copied lexical root. Full
# merge copies note and its trace; the harness observes 1111 there while
# the source root remains 0. Entry 7.
int: trace 0

fn: note (int: v) int
    node\trace: node\trace * 10 + v
    return: 0
end: note

fn: seen () int
    return: node\trace
end: seen

fn: make0 (int: n) fn: () int
    fn: f0 () int
        return: n + note(1)
    return: f0

@: p0 make0(100)
p0()
int: a p0()

fn: use () int
    p0()
    return: p0()
end: use

int: b use()
int: ok 7
if: a != 100 || b != 100
    ok: 81
if: seen() != 0
    ok: 82
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
