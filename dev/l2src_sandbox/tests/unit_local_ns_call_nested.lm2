# A method's own named Structure declared in an `if:` body is explicitly
# executed there and from an anonymous block. Its fields are S's fields, not
# fields of either inline body. S\v, written 9, reads 4 after each call. Entry 7.
fn: m () int
    int: r 0
    if: r = 0
        S:
            size_t: v 4U
        S\v: 9U
        call: S
        ---
            if: S\v = 4U
                S\v: 9U
                call: S
            r: r + 0
        if: S\v = 4U
            r: 7
        r: r + 0
    int: out r
    return: out
end: m
int: r 0
r: m()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
