fn: method (int: step 3) int (
    int: x 1
)
    :=: x (x + step)
    return: x
end: method
int: x 40
sub: main () (
    Code: (:= x (x + 1)) (:= y (x * 2))
    CodeData:
        int: x 1
        int: y 2
    end: CodeData
    Data:
        int: extra 99
        int: y 30
        int: x 10
    end: Data
    Self:
        int: x 4
        :=: x (x + 2)
    end: Self
    Free: (:= x (x + 1))
    ReadSelected:
        int: x
        :=: x ((data \ x) + 1)
    end: ReadSelected
    int: explicit_x 0
    int: explicit_y 0
    int: own_unchanged 0
    int: method_data 0
    int: nested_call 0
)
    call: Data Code
    :=: explicit_x (Data \ x)
    :=: explicit_y (Data \ y)
    :=: own_unchanged (CodeData \ x)
    call: CodeData Code
    call: Self Self
    call: Data method
    :=: method_data (Data \ x)
    fn: nested () int
        call: Data Code
        return: (Data \ x)
    end: nested
    :=: nested_call ((nested))
    call: Free
    call: Data ReadSelected
end: main
