predef: "l2src/lmx_root.lm1"
predef: "l2src/lmx_list_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# R0 is an ordinary L3 Thread under one structural parent frame. Both graphs contain an ordinary
# physical reference to their one growable Array<@LmxThread>; no index or fixed root slot is ABI.

sub: root_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: root_check

fn: root_thread () @: LmxThread
return: (cast: (@: LmxThread) calloc(1U, c.sizeof(c.LmxThread)))

fn: main () int
    LmxRoot: root
    LmxRoot: rejected
    @: LmxRoot root_p
    LmxArena: child_arena
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    @: LmxThread r0
    @: LmxThread upper
    @: LmxListDesc children
    @: LmxListDesc upper_children
    @: Lmx graph
    @: Lmx upper_graph
    @: LmxMsg upper_message
    @: Lmx source
    @: LmxThread a
    @: LmxThread b
    @: LmxThread c0
    @: LmxThread d
    @: LmxThread e
    @: LmxThread f
    @: LmxThread g
    @: LmxThread h
    @: LmxThread i
    int: failures
    if: counts = 0
        return: 2
    ---
    memset((cast: (@: void) (@ root)), 0, c.sizeof(c.LmxRoot))
    memset((cast: (@: void) (@ rejected)), 0, c.sizeof(c.LmxRoot))
    memset((cast: (@: void) (@ child_arena)), 0, c.sizeof(c.LmxArena))

    root_p: @ root
    root_check(counts, lmx_root_open(root_p, 0, 1000U) = c.LMX_ROOT_OK, "root open failed")
    r0: lmx_root_thread(@ root)
    upper: root_p\parent
    children: lmx_thread_children(r0)
    upper_children: lmx_thread_children(upper)
    graph: lmx_root_message(@ root)\graph
    upper_message: lmx_thread_message(root_p\parent)
    upper_graph: upper_message\graph
    root_check(counts, r0 != 0 && upper != 0 && lmx_thread_parent(r0) = upper, "R0 is not an ordinary child of its structural parent")
    root_check(counts, lmx_thread_parent(upper) = 0, "structural upper frame unexpectedly has a parent")
    root_check(counts, lmx_thread_child_count(upper) = 1U && lmx_thread_child_at(upper, 0U) = r0, "upper frame does not own R0 through its sole Array")
    root_check(counts, children != 0 && upper_children != 0 && children\cap = 2U && upper_children\cap = 2U, "ordinary child Arrays do not start at capacity two")
    root_check(counts, lmx_arena_ref_value(graph, 0U) = (cast: (@: void) children) && lmx_arena_ref_value(upper_graph, 0U) = (cast: (@: void) upper_children), "Thread caches differ from graph physical references")
    root_check(counts, c.sizeof(c.LmxMsg) = 16U, "Message retained numeric address storage")
    root_check(counts, lmx_thread_children(r0) = children, "R0 did not cache its ordinary physical children descriptor")

    # The R0 child collection itself has no eight-child ceiling.
    a: root_thread()
    b: root_thread()
    c0: root_thread()
    d: root_thread()
    e: root_thread()
    f: root_thread()
    g: root_thread()
    h: root_thread()
    i: root_thread()
    root_check(counts, a != 0 && b != 0 && c0 != 0 && d != 0 && e != 0 && f != 0 && g != 0 && h != 0 && i != 0, "child probe allocation failed")
    root_check(counts, lmx_thread_child_add(r0, a, lmx_root_arena(@ root)) = c.LMX_THREAD_OK && lmx_thread_child_add(r0, b, lmx_root_arena(@ root)) = c.LMX_THREAD_OK && lmx_thread_child_add(r0, c0, lmx_root_arena(@ root)) = c.LMX_THREAD_OK && lmx_thread_child_add(r0, d, lmx_root_arena(@ root)) = c.LMX_THREAD_OK && lmx_thread_child_add(r0, e, lmx_root_arena(@ root)) = c.LMX_THREAD_OK && lmx_thread_child_add(r0, f, lmx_root_arena(@ root)) = c.LMX_THREAD_OK && lmx_thread_child_add(r0, g, lmx_root_arena(@ root)) = c.LMX_THREAD_OK && lmx_thread_child_add(r0, h, lmx_root_arena(@ root)) = c.LMX_THREAD_OK && lmx_thread_child_add(r0, i, lmx_root_arena(@ root)) = c.LMX_THREAD_OK, "R0 rejected dynamic children")
    root_check(counts, lmx_thread_child_count(r0) = 9U && children\cap = 9U, "R0 retained an eight-child limit")
    root_check(counts, lmx_thread_child_remove(r0, a) = c.LMX_THREAD_OK && lmx_thread_child_remove(r0, b) = c.LMX_THREAD_OK && lmx_thread_child_remove(r0, c0) = c.LMX_THREAD_OK && lmx_thread_child_remove(r0, d) = c.LMX_THREAD_OK && lmx_thread_child_remove(r0, e) = c.LMX_THREAD_OK && lmx_thread_child_remove(r0, f) = c.LMX_THREAD_OK && lmx_thread_child_remove(r0, g) = c.LMX_THREAD_OK && lmx_thread_child_remove(r0, h) = c.LMX_THREAD_OK && lmx_thread_child_remove(r0, i) = c.LMX_THREAD_OK, "R0 child removal failed")
    root_check(counts, lmx_thread_child_count(r0) = 0U, "R0 child Array did not empty")

    root_check(counts, lmx_arena_open(@ child_arena) = 0, "child arena open failed")
    source: lmx_node_new_owned(lmx_root_arena(@ root))
    root_check(counts, source != 0 && lmx_root_create(@ root, @ child_arena, source) = 0, "creation outside R0 turn was accepted")
    lmx_arena_release(@ child_arena)
    root_check(counts, lmx_root_close(@ root) = c.LMX_ROOT_OK && lmx_root_state(@ root) = c.LMX_ROOT_CLOSED, "ordinary empty root cascade did not close")

    failures: counts[1]
    c.printf("lmx_root_selftest: %d checks, %d failures\n", counts[0], failures)
    free(a)
    free(b)
    free(c0)
    free(d)
    free(e)
    free(f)
    free(g)
    free(h)
    free(i)
    free(counts)
return: failures != 0
