+            return: l2_alloc_or(l2_src, node, "out of memory")
+        first: 0
+        k: k + span
+    ---
+    if: l2_tx_cat(dest, ")") != 0
+        return: l2_alloc_or(l2_src, node, "out of memory")
+return: 0
+
+# One operand of an unevaluated operator as C text, dispatched like
+# l2_emit_native_span over the SAME prepared operand. C-spellable parts stay
+# in place, so C still judges the operand. opaque != 0 inside a nested C
+# call: a macro there may evaluate a part (a VM bound, C99 6.7.5.2), so a part
+# with no C spelling is refused as OPEN instead of replaced by a witness.
+fn: l2_emit_unevaluated_span (@: L2ValueSpan span; int: mi; int: opaque; @: L2Tx dest) int
+    @: L2Path selected
+    @: LmP0Node name 0
+    @: LmP0Node op
+    @: LmP0Text text
+    @: LmP0Node leaf
+    L2Address: address
+    L2ValueSpan: child
+    int: status
+    int: role
+    int: own
+    int: levels
+    int: source_type
+    int: result_type
+    int: type
+    int: k 0
+    int: neg
+    int: uns
+    int: ch
+    size_t: magnitude
+    []: char piece_own 1024
+    []: char type_own 1024
+    L2Tx: piece_tx
+    L2Tx: type_tx
+    @: L2Tx piece l2_tx_local(@ piece_tx, piece_own, 1024U)
+    @: L2Tx type_text l2_tx_local(@ type_tx, type_own, 1024U)
+    if: span = 0 || span\grammar = 0 || dest = 0 || piece = 0 || type_text = 0 || l2_tx_clear(dest) != 0
+        return: 1
+    # An operand list, group or prefix Frame: the SAME operators, in place. A
+    # number in an arithmetic list has the list's L2 type, as when it is
+    # evaluated (a literal is typed by its context), not the type C gives the
+    # bare constant; a comparison or logical list is an int either way.
+    if: span\values != 0 && (span\grammar = 3 || l2_frame_head(span\node, "@") = 0)
+        if: l2_value_spans_expression(span\values, span\value_n) = 0
+            return: l2_error(l2_src, span\node, "a native value requires one complete expression")
+        type: -1
+        if: span\value_n > 1
+            op: l2_span_node(span\values, l2_rw_split(span\values, 0, span\value_n - 1))
+            if: op != 0 && op\as != 0 && l2_rw_prec(op\as\atom) >= 5
+                l2_value_span_type(span, mi, @ type)
+            ---
+        ---
+        while: k < span\value_n
+            if: k > 0
+                op: l2_span_node(span\values, k - 1)
+                if: l2_tx_cat(dest, " ") != 0 || l2_tok_tx(piece, op\as\atom) != 0 || l2_tx_cat(dest, piece\data) != 0 || l2_tx_cat(dest, " ") != 0
+                    return: 1
+            ---
+            if: l2_emit_unevaluated_span(span\values + k, mi, opaque, piece) != 0
+                return: 1
+            leaf: l2_span_node(span\values, k)
+            if: type != 8 && l2_prim_code_name(type) != 0 && leaf != 0 && leaf\kind = c.LM_P0_NODE_ATOM && leaf\as != 0 && (l2_rw_num_lit(leaf\as\atom, @ neg, @ magnitude, @ uns) != 0 || l2_rw_char_lit(leaf\as\atom, @ ch) != 0)
+                if: l2_tx_join(type_text, "(cast: (", l2_prim_code_name(type), ") ", piece\data, ")") != 0 || l2_tx_set(piece, type_text\data) != 0
+                    return: 1
+            ---
+            if: l2_tx_cat(dest, piece\data) != 0
+                return: 1
+            k: k + 2
+        ---
+        if: l2_tx_set(piece, dest\data) != 0
+            return: 1
+        if: span\grammar != 3 && l2_prefix_frame(span\node) = 1
+            return: l2_tx_join(dest, "(- (", piece\data, "))", 0, 0)
+        if: span\grammar != 3 && l2_prefix_frame(span\node) = 2
+            return: l2_tx_join(dest, "(+ (", piece\data, "))", 0, 0)
+        return: l2_tx_join(dest, "(", piece\data, ")", 0, 0)
+    # A held path verdict: a binding or a machine/opaque C path in place, a
+    # graph path's typed witness. A refused path stays refused.
+    status: l2_value_span_path(span, mi, @ selected)
+    if: status = 3
+        return: 1
+    if: status = 0 || status = 2
+        if: selected = 0
+            return: 1
+        if: status = 0 && selected\n = 0 && selected\array_leaf = 0
+            return: l2_emit_binding_value(selected, mi, "", dest, 0)
+        if: (status != 0 && selected\n > 0 && l2_path_root_raw_c(selected, mi) != 0) || (status = 0 && l2_path_machine_index(selected) != 0)
+            return: l2_emit_unevaluated_steps(selected, mi, opaque, dest, span\node)
+        if: status != 0
+            return: l2_emit_path_refusal(selected, span\node)
+        return: l2_emit_unevaluated_witness(span, mi, opaque, dest)
+    ---
+    status: l2_address_value_span(span, mi, @ address)
+    if: status = 0
+        status: l2_emit_unevaluated_address(@ address, span, mi, opaque, dest)
+        l2_address_release(@ address)
+        return: status
+    ---
+    if: status != 2
+        return: l2_alloc_or(l2_src, span\node, "the address target has no addressable place")
+    if: l2_prefix_rest(span, @ child) = 0
+        if: l2_emit_unevaluated_span(@ child, mi, opaque, piece) != 0
+            return: 1
+        if: l2_prefix_sign(span\node\as\atom) = 1
+            return: l2_tx_join(dest, "(- (", piece\data, "))", 0, 0)
+        return: l2_tx_join(dest, "(+ (", piece\data, "))", 0, 0)
+    # A source-occurrence selector reads an own field: its typed witness.
+    own: l2_operand_occurrence(span\first, span\count, mi, @ name)
+    if: own != -2
+        if: own < 0
+            return: l2_error(l2_src, name, "no such occurrence")
+        return: l2_emit_unevaluated_witness(span, mi, opaque, dest)
+    # A prefix dereference keeps its operand's C spelling.
+    if: span\operand != 0 && l2_is_slash(span\node\as\atom) != 0
+        if: l2_indirect_span(span, mi, @ child, @ levels, @ source_type, @ result_type) != 0
+            return: l2_error(l2_src, span\node, "the dereference operand has no pointer contract")
+        if: l2_emit_unevaluated_span(@ child, mi, opaque, piece) != 0
+            return: 1
+        while: k < levels
+            if: l2_tx_join(dest, "(\\ (", piece\data, "))", 0, 0) != 0 || l2_tx_set(piece, dest\data) != 0
+                return: 1
+            k: k + 1
+        ---
+        return: l2_tx_set(dest, piece\data)
+    if: span\count != 1
+        return: l2_error(l2_src, span\node, "an unsupported non-path value expression")
+    role: l2_primary_role(span, mi)
+    if: role = 1
+        if: l2_primary_cast_value(span, @ type, type_text, @ child) != 0 || l2_emit_unevaluated_span(@ child, mi, opaque, piece) != 0
+            return: 1
+        return: l2_tx_join(dest, "(cast: (", type_text\data, ") ", piece\data, ")")
+    if: role = 4
+        return: l2_primary_sizeof_value(span, mi, @ child, dest)
+    if: role = 5
+        return: l2_emit_unevaluated_operator(span, mi, dest)
+    if: role = 3
+        return: l2_emit_unevaluated_ccall(span, mi, dest)
+    # A literal, a C door word or a define keeps its own C spelling.
+    if: span\node != 0 && span\node\kind = c.LM_P0_NODE_ATOM && span\node\as != 0
+        text: span\node\as\atom
+        if: l2_c_stmt_door(text) != 0 || l2_quoted(text) != 0 || l2_rw_num_lit(text, @ neg, @ magnitude, @ uns) != 0 || l2_rw_char_lit(text, @ ch) != 0 || l2_define_name(text) != 0
+            return: l2_tok_tx(dest, text)
+        ---
+    ---
+return: l2_emit_unevaluated_witness(span, mi, opaque, dest)
+
+# An L2 part with no C spelling of its own (a call, a graph path, an Array
+# INDEX, length) is the UNEVALUATED typed witness of its prepared type,
+# `\ (cast: (@: T) 0)`, through the common L1 type formatter. No primitive
+# type is invented and no 0 or void* stands in for an unknown C type. Inside
+# a nested C call a macro may evaluate the part: refused there as OPEN.
+fn: l2_emit_unevaluated_witness (@: L2ValueSpan span; int: mi; int: opaque; @: L2Tx dest) int
+    int: type -1
+    []: char pointer_own 1024
+    L2Tx: pointer_tx
+    @: L2Tx pointer l2_tx_local(@ pointer_tx, pointer_own, 1024U)
+    if: span = 0 || dest = 0 || pointer = 0
+        return: 1
+    if: opaque != 0
+        return: l2_error(l2_src, span\node, "c.sizeof: an L2 value with no C spelling inside a C call operand is not supported yet (OPEN: a C macro may evaluate it)")
+    if: l2_frame_void_call(span\node, mi) != 0
+        return: l2_error(l2_src, span\node, "a callable without a result has no value")
+    l2_value_span_type(span, mi, @ type)
+    if: type < 0 || l2_pointer_decl_text(type, 1, 0, pointer) != 0
+        return: l2_error(l2_src, span\node, "c.sizeof: this operand has no C type to stay unevaluated")
+return: l2_tx_join(dest, "(\\ (cast: (", pointer\data, ") 0))", 0, 0)
+
+# A machine-pointer INDEX chain or an opaque C member path keeps its C
+# spelling, so C judges every subscript and member; each INDEX expression is
+# itself an unevaluated operand. The same steps as l2_emit_raw_steps, except
+# that a by-value root's first member goes through the root's address.
+fn: l2_emit_unevaluated_steps (const: @(L2Path path); int: mi; int: opaque; @: L2Tx dest; const: @(LmP0Node at)) int
+    int: k 0
+    int: root_type
+    @: L2PathStep step
+    []: char index_own 1024
+    L2Tx: index_tx
+    @: L2Tx index l2_tx_local(@ index_tx, index_own, 1024U)
+    if: path = 0 || dest = 0 || index = 0
+        return: 1
+    root_type: l2_path_root_binding_ft(path, mi)
+    if: root_type < 0 || l2_emit_binding_value(path, mi, "", dest, 0) != 0
+        return: l2_error(l2_src, at, "c.sizeof: this path has no C spelling to stay unevaluated")
+    while: k < path\n
+        step: path\steps + k
+        if: step\locus = 7
+            if: l2_emit_unevaluated_span(@ step\index, mi, opaque, index) != 0 || l2_tx_cat(dest, "[") != 0 || l2_tx_cat(dest, index\data) != 0 || l2_tx_cat(dest, "]") != 0
+                return: 1
+            ---
+        else:
+            if: l2_ty_raw_c_members(root_type) = 0
+                return: l2_error(l2_src, at, "c.sizeof: a member step outside an opaque C path")
+            # A by-value root's member is spelled through the root's address:
+            # L1 splits a dotted path in a call argument, even in parentheses,
+            # and `(&x)->m` is the same C member of the same lvalue as `x.m`.
+            if: k = 0 && l2_pointer_depth(l2_formal_raw(root_type)) = 0
+                if: l2_tx_set(index, dest\data) != 0 || l2_tx_join(dest, "(@ (", index\data, "))", 0, 0) != 0
+                    return: 1
+            ---
+            if: l2_tx_cat(dest, "\\") != 0 || l2_tx_catn(dest, path\text + step\off, step\len) != 0
+                return: 1
+            ---
+        ---
+        k: k + 1
+    ---
+return: 0
+
+# An address keeps the real cell's C spelling: a binding's, an opaque C
+# member's or a machine element's -- never a temporary's. A graph-path address
+# has no C spelling: outside a C call it is the typed witness of its type.
+fn: l2_emit_unevaluated_address (const: @(L2Address address); @: L2ValueSpan span; int: mi; int: opaque; @: L2Tx dest) int
+    []: char steps_own 1024
+    []: char pointer_own 1024
+    L2Tx: steps_tx
+    L2Tx: pointer_tx
+    @: L2Tx steps l2_tx_local(@ steps_tx, steps_own, 1024U)
+    @: L2Tx pointer l2_tx_local(@ pointer_tx, pointer_own, 1024U)
+    if: address = 0 || span = 0 || dest = 0 || steps = 0 || pointer = 0
+        return: 1
+    if: address\kind >= 1 && address\kind <= 5
+        return: l2_emit_address_context(mi, address, "", dest, 0)
+    if: address\kind = 8 || (address\kind = 6 && address\descriptor != 0)
+        if: l2_emit_unevaluated_steps(@ address\path, mi, opaque, steps, span\node) != 0
+            return: 1
+        return: l2_tx_join(dest, "(@ (", steps\data, "))", 0, 0)
+    if: opaque != 0
+        return: l2_error(l2_src, span\node, "c.sizeof: an L2 address with no C spelling inside a C call operand is not supported yet (OPEN: a C macro may evaluate it)")
+    if: address\type < 0 || l2_pointer_decl_text(address\type, 1, 0, pointer) != 0
+        return: l2_error(l2_src, span\node, "c.sizeof: this address has no C type to stay unevaluated")
+return: l2_tx_join(dest, "(\\ (cast: (", pointer\data, ") 0))", 0, 0)
+
diff --git a/src/l2src/l2_application.h.lm1 b/src/l2src/l2_application.h.lm1
index b68aca22..c95bf74b 100644
--- a/src/l2src/l2_application.h.lm1
+++ b/src/l2src/l2_application.h.lm1
@@ -633,0 +634,2 @@ end: L2ArrayPlace
