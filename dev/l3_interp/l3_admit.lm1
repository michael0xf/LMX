predef: "l3_interp/l3_recv.h.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l3_interp/l3_path.lm1"
predef: "l3_interp/l3_exec.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l2src/lmx_value_owned.h.lm1"
predef: "l2src/lmx_implements.h.lm1"

# L3-04 N10. Analytic used paths are resolved index sequences in the binary
# graph (not a name table, not zip of physical slots of A vs B).
# Receiver: [0] paths Structure, [1] tests Structure of callables.
# Empty used-path set is OK analytically; tests are still required.
# lmx_runtime_implements is not this predicate.

fn: l3_implements_paths (@: LmxArena arena; @: Lmx candidate; @: Lmx paths) int
    size_t: i
    @: void item
    @: Lmx path
    int: st
    if: arena = 0 || candidate = 0 || paths = 0
        return: c.L3_INVALID
    if: lmx_domain_kind(arena, (cast: (@: void) paths)) != c.LMX_KIND_STRUCT
        return: c.L3_UNSUPPORTED
    i: 0U
    while: i < (cast: (size_t) paths\len)
        item: lmx_arena_ref_value(paths, i)
        if: item = 0
            return: c.L3_ABSENT
        if: lmx_domain_kind(arena, item) != c.LMX_KIND_STRUCT
            return: c.L3_UNSUPPORTED
        path: (cast: (@: Lmx) item)
        st: l3_follow_path(arena, candidate, path)
        if: st != c.L3_OK
            return: st
        i: i + 1U
    ---
return: c.L3_OK

# k.4 (c.3): a test occurrence is any Structure -- no descriptor to classify, l3_exec_run_on
# itself refuses anything that does not classify as a Structure (l3_exec_frame's own check).
fn: l3_run_tests (@: LmxArena arena; @: Lmx tests; @: Lmx candidate) int
    size_t: i
    @: void item
    @: Lmx m
    int: st
    if: tests = 0
        return: c.L3_INVALID
    if: lmx_domain_kind(arena, (cast: (@: void) tests)) != c.LMX_KIND_STRUCT
        return: c.L3_UNSUPPORTED
    if: tests\len < 1
        return: c.L3_UNSUPPORTED
    i: 0U
    while: i < (cast: (size_t) tests\len)
        item: lmx_arena_ref_value(tests, i)
        if: item = 0
            return: c.L3_ABSENT
        if: lmx_domain_kind(arena, item) != c.LMX_KIND_STRUCT
            return: c.L3_UNSUPPORTED
        m: (cast: (@: Lmx) item)
        st: l3_exec_run_on(arena, m, candidate, 0)
        if: st != c.L3_OK
            return: st
        i: i + 1U
    ---
return: c.L3_OK

fn: l3_admit (@: LmxArena arena; @: Lmx candidate; @: Lmx receiver) int
    @: Lmx paths
    @: Lmx tests
    @: void p0
    @: void p1
    int: st
    if: arena = 0 || candidate = 0 || receiver = 0
        return: c.L3_INVALID
    if: lmx_domain_kind(arena, (cast: (@: void) receiver)) != c.LMX_KIND_STRUCT
        return: c.L3_UNSUPPORTED
    if: receiver\len < 2
        return: c.L3_INVALID
    p0: lmx_arena_ref_value(receiver, 0U)
    p1: lmx_arena_ref_value(receiver, 1U)
    if: p0 = 0 || p1 = 0
        return: c.L3_ABSENT
    if: lmx_domain_kind(arena, p0) != c.LMX_KIND_STRUCT
        return: c.L3_UNSUPPORTED
    if: lmx_domain_kind(arena, p1) != c.LMX_KIND_STRUCT
        return: c.L3_UNSUPPORTED
    paths: (cast: (@: Lmx) p0)
    tests: (cast: (@: Lmx) p1)
    st: l3_implements_paths(arena, candidate, paths)
    if: st != c.L3_OK
        return: st
return: l3_run_tests(arena, tests, candidate)
