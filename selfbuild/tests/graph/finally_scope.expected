fn: ordered () int (
    int: trace 0
)
    finally: (:= trace ((trace * 10) + 1))
    finally: (:= trace ((trace * 10) + 2))
    return: 9
end: ordered
fn: held () int (
    int: x 0
    int: seen 0
)
    finally: (:= seen ((held \ data) \ x)) (:= x (x + 1))
    :=: x 5
    return: x
end: held
fn: scoped () int
    int: trace 0
    if: 0 ((finally (:= trace 99)))
    ---
        finally: (:= trace ((trace * 10) + 1))
        :=: trace 2
    ---
    return: trace
end: scoped
fn: jumps () int
    int: i 0
    int: trace 0
    while: (i < 4) ((finally (:= trace ((trace * 10) + i))) (:= i (i + 1)) (if (i = 1) ((continue))) (if (i = 2) ((redo))) (if (i = 4) ((break))))
    return: trace
end: jumps
fn: replacement () int (
    int: trace 0
)
    finally: (:= trace (trace + 1))
    finally: (return 7)
    return: 3
end: replacement
fn: nested () int (
    int: trace 0
)
    finally: (finally (:= trace ((trace * 10) + 3))) (:= trace ((trace * 10) + 2))
    :=: trace 1
    return: trace
end: nested
fn: cleanup_field () int
    :=: late 4
    finally: (int late) (:= late (late + 1))
    return: late
end: cleanup_field
fn: cleanup_jump () int
    int: i 0
    int: trace 0
    while: (i < 3) ((finally (:= trace ((trace * 10) + i)) (if (i < 3) ((continue)))) (:= i (i + 1)) (break))
    return: trace
end: cleanup_jump
