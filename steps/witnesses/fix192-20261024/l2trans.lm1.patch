+# The C name of input fi of method mi (a formal, then a hidden input) in a family of prefix `prefix`.
+fn: l2_tx_input_cname (@: L2Tx t; const: @(char prefix); int: mi; int: fi; const: @(char tail)) int
+    const: @(LmP0Text name) 0
+    if: mi >= 0 && mi < l2_m_n && fi >= 0 && fi < l2_m_arity[mi]
