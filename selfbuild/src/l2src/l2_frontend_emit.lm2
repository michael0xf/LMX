        return: (cast: (int) (c.lm_compiler_error(path, source_node, "internal: admission outside a method")))
    if: check_unevaluated_cell[0] = 0 && c.lm_compiler_check_throws_handled(mi, idx, path, source_node) != 0
        return: (cast: (int) (1))
    # A call through callable formal fi is noted as such (its count is fi + 1): in the fixed point of
    # dynamic inputs the methods that reach the formal stand in the place of its declaring method
    # (l2_dyn_site).
    if: check_unevaluated_cell[0] = 0 && fi < 0 && c.lm_compiler_note_call(mi, idx, source_node, path) != 0
        return: (cast: (int) (1))
