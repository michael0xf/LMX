# M6 4b (slice 350; the book, assign-known, RU:424: the former operator := is removed, a write is `left: right`): P0
# refuses `:=` wherever it stands, before any consumer reads the document -- here a statement of a method on a known
# place, `x := 5` (dyn/assign_known.lm2 writes it `x: 5`).
fn: f () int
    int: x 1
    x := 5
    return: x
end: f
int: code 7
if: f() != 5
    code: 81
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
