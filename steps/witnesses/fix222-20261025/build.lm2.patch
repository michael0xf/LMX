+    own_names[14]: "lm_own_ptr_stack_top"
+    own_names[15]: "lm_own_ptr_stack_truncate"
+    own_names[16]: "lm_own_arena_init"
+    own_names[17]: "lm_own_arena_destroy"
+    own_names[18]: "lm_own_arena_freeze"
+    own_names[19]: "lm_own_arena_new_zero"
+    own_names[20]: "lm_own_arena_copy_bytes"
+    own_names[21]: "lm_own_arena_add_lazy_edge"
+    own_names[22]: "lm_own_tree_cut"
+    own_names[23]: "lm_own_arena_absorb"
+    text_names[0]: "lm_p0_text_equals"
+    text_names[1]: "lm_p0_identifier_payload"
+    text_names[2]: "lm_p0_is_horizontal_space"
+    text_names[3]: "lm_p0_is_line_break"
+    text_names[4]: "lm_p0_line_break_width_at"
+    text_names[5]: "lm_p0_is_field_space"
+    text_names[6]: "lm_p0_is_field_separator"
+    text_names[7]: "lm_p0_is_short_form_separator"
+    text_names[8]: "lm_p0_is_quoted_token_boundary"
+    text_names[9]: "lm_p0_starts_python_string"
+    text_names[10]: "lm_p0_is_decimal_digit"
+    text_names[11]: "lm_p0_copy_bytes"
+    text_names[12]: "lm_p0_text_view_new_cstr"
+    text_names[13]: "lm_p0_text_view_delete"
+    text_names[14]: "lm_p0_text_from_cstr"
+    generated[0]: "src/l1src/p0.h.lm1"
+    generated[1]: "src/l1src/p0_own_state.lm1"
+    generated[2]: "src/l1src/own.h.lm1"
+    generated[3]: "src/l2src/p0_own.lm1"
+    generated[4]: "src/l2src/p0_text.lm1"
+    generated[5]: "src/l2src/p0_own.h.lm1"
+    generated[6]: "src/l2src/p0_text.h.lm1"
+    generated[7]: "headers/l1src/p0.lm1.h"
+    generated[8]: "headers/l1src/own.lm1.h"
+    generated[9]: "headers/l2src/p0_own.lm1.h"
+    generated[10]: "headers/l2src/p0_text.lm1.h"
+    while: k < 11
+        c.remove(txt_path(stage, generated[k]))
+        k: k + 1
+    ---
+    if: decl_write(txt_path(src, "l1src/p0.h.lm1"), 39) != 0
+        c.remove(txt_path(src, "l1src/p0.h.lm1"))
+        return: 1
+    bld_hash_note(rec, txt_path(src, "l1src/p0.h.lm1"))
+    if: decl_write(txt_path(src, "l1src/p0_own_state.lm1"), 40) != 0
