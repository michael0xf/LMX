ProducerMessage:
    []int: items
    @: worker
    @: collector
    start:
        int: i 0
        while: i < length(items)
            post:
                ask:
                    worker\Add\add(value := items[i])
            ---
            i += 1
        post:
            ask:
                worker\Finish\finish()
            answer:
                collector\accept

WorkerMessage:
    int: total 0
    Add:
        int: value
        add:
            @: owner parent(node)
            owner\total += value
    ---
    Finish:
        return: int
        finish:
            @: owner parent(node)
            success := 1
            return: owner\total

CollectorMessage:
    int: value
    int: result 0
    int: completed 0
    accept:
        node\result := value
        node\completed := 1
        success := 1
