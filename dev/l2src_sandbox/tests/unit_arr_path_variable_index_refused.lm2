# An index is an ordinary size_t value received at the step (R5-3b/R5-4): an int index has the
# conversion edge every received value of another number type has -- the program's conversion
# receiver, which this program lacks (as entry_dyn_array_index_int_refused pins for an own Array).
# Before: "an indexed field path needs decimal literal indices" (the two-literal-index route, gone).
MainLetter:
    char: []: []: mainArgs
end: MainLetter

@: MainLetter m
int: k 1
receiveMessage: m
if: m\mainArgs[k][0] != 0
    sendMessage: exit(exit_code: 1; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
