predef: "lmx_chars.lm1"
predef: "lmx_pool.lm1"
predef: "lmx_arena.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<string.h>"

# A char array of this test's own, in no array of the arena: it is what a direct
# character read is measured against.
[]: char unregistered 2 65 66

# Carries 2's worked example verbatim: assigning a primitive field changes its
# reference and does not mutate the shared immutable cell. The interned char
# table is 256 cells TAKEN from the test's own arena (lmx_chars_init), so it is
# one of that arena's N arrays -- there is no module-level pool to open, and a
# second arena has a table of its own or none at all.

fn: main () int
    @: void first
    @: void second
    @: void bang
    @: void bang_again
    @: void query
    @: void other_bang
    int: failures
    LmxArena: arena
    LmxArena: other
    @: LmxArena other_at
    failures: 0

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ other)), 0, c.sizeof(c.LmxArena))
    other_at: @ other
    if: lmx_arena_open(@ arena) != 0 || lmx_arena_open(@ other) != 0
        fputs("lmx: arena open failed\n", l1_stdout())
        return: 1
    if: lmx_chars_init(@ arena) != 0
        fputs("lmx: char table init failed\n", l1_stdout())
        return: 1
    if: lmx_chars_init(@ arena) = 0
        fputs("lmx: char table initialised twice\n", l1_stdout())
        failures: failures + 1
    # The table is one of THIS arena's N arrays -- found through the arena, the way
    # every other array of the arena is found.
    if: lmx_arena_find(@ arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR) = 0
        fputs("lmx: the char table is not one of the arena's arrays\n", l1_stdout())
        failures: failures + 1

    bang: lmx_char_cell(@ arena, 33)
    bang_again: lmx_char_cell(@ arena, 33)
    query: lmx_char_cell(@ arena, 63)
    if: bang = 0 || query = 0
        fputs("lmx: char cell missing\n", l1_stdout())
        return: 1

    # Interned: the same character is the same cell, always.
    if: bang != bang_again
        fputs("lmx: same character gave two cells\n", l1_stdout())
        failures: failures + 1
    if: bang = query
        fputs("lmx: different characters share one cell\n", l1_stdout())
        failures: failures + 1
    if: lmx_range_classify(@ arena, bang) != c.LMX_KIND_PRIMITIVE
        fputs("lmx: char cell not classified as primitive\n", l1_stdout())
        failures: failures + 1
    if: lmx_char_value(bang) != 33
        fputs("lmx: char cell does not read back as its own value\n", l1_stdout())
        failures: failures + 1
    if: lmx_char_value(query) != 63
        fputs("lmx: second char cell does not read back\n", l1_stdout())
        failures: failures + 1

    # Out of range yields nothing, not a neighbouring cell.
    if: lmx_char_cell(@ arena, -1) != 0
        fputs("lmx: negative character produced a cell\n", l1_stdout())
        failures: failures + 1
    if: lmx_char_cell(@ arena, 256) != 0
        fputs("lmx: out of range character produced a cell\n", l1_stdout())
        failures: failures + 1

    # A character read is DIRECT: the arena's table is not consulted, so a cell no
    # array of the arena contains still reads back its own byte (the type is known
    # statically, and the table answers only about an untyped void *).  The refusal
    # that used to stand here went with the re-check it belonged to.
    if: lmx_range_classify(@ arena, cast: (@: void) unregistered) != c.LMX_KIND_NONE
        fputs("lmx: the char array of this test is registered after all\n", l1_stdout())
        failures: failures + 1
    if: lmx_char_value(cast: (@: void) (unregistered + 1)) != 66
        fputs("lmx: a direct character read refused instead of reading its byte\n", l1_stdout())
        failures: failures + 1

    # The worked example. Two fields hold the same character, so they hold the
    # same address. Reassigning one changes only that field's reference.
    first: bang
    second: bang
    if: first != second
        fputs("lmx: two fields of one character do not share the cell\n", l1_stdout())
        failures: failures + 1

    first: query
    if: first = second
        fputs("lmx: reassigning one field moved the other\n", l1_stdout())
        failures: failures + 1
    if: lmx_char_value(second) != 33
        fputs("lmx: reassigning a field mutated the shared cell\n", l1_stdout())
        failures: failures + 1
    if: lmx_char_value(bang) != 33
        fputs("lmx: the shared cell itself was mutated\n", l1_stdout())
        failures: failures + 1
    if: lmx_range_classify(@ arena, first) != c.LMX_KIND_PRIMITIVE
        fputs("lmx: reassigned field lost its classification\n", l1_stdout())
        failures: failures + 1

    # The table belongs to its ARENA, not to the process.  A second arena that never
    # laid one out has no character cell at all -- a module-level pool would have
    # answered with the first arena's table here, and two Messages would have shared
    # one table (Mikhail, 2026-09-17: "N массивов в арене").  Laid out in the second
    # arena, the table is that arena's own storage, and the two tables are separate
    # cells; releasing the second arena leaves the first arena's table alone.
    if: lmx_char_cell(@ other, 33) != 0
        fputs("lmx: a second arena answered with a character cell it never laid out\n", l1_stdout())
        failures: failures + 1
    if: lmx_chars_init(@ other) != 0
        fputs("lmx: char table init failed in the second arena\n", l1_stdout())
        failures: failures + 1
    other_bang: lmx_char_cell(@ other, 33)
    if: other_bang = 0 || other_bang = bang
        fputs("lmx: the second arena's table is not its own array\n", l1_stdout())
        failures: failures + 1
    if: lmx_char_value(other_bang) != 33
        fputs("lmx: the second arena's cell does not read back\n", l1_stdout())
        failures: failures + 1
    if: lmx_arena_release(@ other) != 0
        fputs("lmx: second arena release failed\n", l1_stdout())
        failures: failures + 1
    if: lmx_char_value(bang) != 33 || lmx_range_classify(@ arena, bang) != c.LMX_KIND_PRIMITIVE
        fputs("lmx: releasing another arena disturbed this arena's table\n", l1_stdout())
        failures: failures + 1

    lmx_arena_release(@ arena)

    if: failures != 0
        c.printf("lmx chars selftest FAILED checks=%d\n", failures)
        return: 1
    fputs("lmx chars selftest ok\n", l1_stdout())
    return: 0
