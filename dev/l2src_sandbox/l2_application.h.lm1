predef: "l1src/p0.h.lm1"

# Translation-owned contracts. These records are not runtime graph objects.
# A constructor has one ordinary operand contract; no Array rank/depth table.
struct: L2TypeContract
    int: kind
    int: depth
    @: LmP0Text word
    @: L2TypeContract operand
    @: L2TypeContract allocated_next
end: L2TypeContract

# A receiver may derive this contract from an application. Name visibility is
# resolved at the source position, never cached from allocated storage.
struct: L2Declaration
    @: LmP0Node source
    @: L2TypeContract contract
    @: LmP0Text name
    @: LmP0Field candidate
    int: candidate_count
    @: LmP0Text extent
    @: L2Declaration allocated_next
end: L2Declaration

# A resolved source location, not another binding table. kind selects the
# existing own/argument/local-slot/machine-local/namespace entry; descriptor
# distinguishes the actual Structure from a cell holding a reference to it.
struct: L2Address
    int: kind
    int: index
    int: descriptor
    int: model
    int: type
    @: LmP0Field target
    int: target_count
    int: immutable
end: L2Address

# A field projected from either existing named or composed compiler metadata.
# This record has no runtime representation and contains no binding identity.
struct: L2SchemaField
    @: LmP0Text name
    @: LmP0Text type_word
    int: kind
    int: model
end: L2SchemaField

# Translation-only source projection, made before candidate evaluation. schema
# names complete candidate metadata, not the required receiving model. layout
# is absent unless a real descriptor producer establishes that schema. A held
# own/input/result uses the existing D105 source place. Tagged schema handles
# are decoded only by the shared schema helpers; -1 alone means absent. A handle
# at or below -1500000000 is one method occurrence's own fields, not a merge tag.
struct: L2ReferenceSource
    int: schema
    int: layout
    int: method
    int: place
end: L2ReferenceSource

# A bounded source operand view. All source pointers are borrowed; no AST or
# runtime graph is copied. The index is either a literal, an existing joined
# own-name projection, or the original P0 index expression.
struct: L2IndexedOperand
    int: own
    int: type
    int: count
    int: address
    int: dynamic
    size_t: literal
    @: LmP0Node index
    @: LmP0Field after
end: L2IndexedOperand

# One borrowed operand or operator in a bounded expression. No joined text or
# replacement P0 node is retained: consumers resolve the original source span.
struct: L2ValueSpan
    @: LmP0Field first
    int: count
    @: LmP0Node node
end: L2ValueSpan

# A borrowed source environment for deferred checks and actual call sites.
# Names still resolve through the existing own/formal rows; this is not a
# binding table. source_method records the source owner separately when a
# partial callable borrows its model's body; unrelated offsets are not compared.
struct: L2SourceSite
    int: kind
    int: method
    int: current_method
    int: source_method
    int: count
    int: target
    int: scope_count
    @@: LmP0Node scopes
    int: excluded
    int: visibility
    size_t: visible_at
    @: void site
    @: LmP0Node source
end: L2SourceSite
