# Adapted from lingvamyxa_prev/tests/trans_invalid_implements_used_field.lm2.
# takeEq field-follows e\equals; Plain lacks equals. Fat nonempty uses refuse.

Plain:
    size_t: toString 0U
end: Plain

Equatable:
    size_t: equals 0U
end: Equatable

fn: takeEq (Equatable: e) int
    e\equals: 1U
    return: 0
end: takeEq

return: takeEq(Plain)
