Functions:
    int: x
    return: int
    twice:
        return: x * 2
    next:
        return: x + 1

CompositionProbe:
    return: int
    run:
        int: first Functions\twice(4)
        first := Functions\next(first)
        int: second Functions\next(4)
        second := Functions\twice(second)
        return: first * 100 + second
