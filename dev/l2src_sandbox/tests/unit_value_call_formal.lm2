# A callable formal named where a value is consumed gives its callable's result too: f holds
# mytest's occurrence (a reference -- passing it runs nothing) and f + f runs it twice: 2.
fn: mytest () int
    return: 1
end: mytest

fn: twice (mytest: f) int
    return: f + f
end: twice

sendMessage: exit(exit_code: twice(mytest); stdout: ""; stderr: "")
return
