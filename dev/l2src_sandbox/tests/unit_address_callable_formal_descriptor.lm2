# Address acquisition names each formal's own storage cell; it does not
# invoke the held method. The actual method is invoked only below.
fn: target () int
return: 1

fn: other () int
return: 1

fn: same (target: left; target: right) int
    if: @ left = @ right
        return: 0
    if: left() != 1 || right() != 1
        return: 0
return: 7

fn: check () int
    int: equal same(target, target)
    int: different same(target, other)
    if: equal != 7 || different != 7
        return: 0
return: 7

sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
