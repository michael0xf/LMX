# The inner MainLetter check extracts the entry letter's payload. The old
# Long place uses only mainArgs; its unused size field is not a requirement.
MainLetter:
    char: []: []: mainArgs
end: MainLetter
Long:
    char: []: []: mainArgs
    size_t: size 0U
end: Long
fn: take () int
    receiveMessage: raw
    @: p Long 0
    @: p MainLetter: @raw
    if: length(p\mainArgs) > 0U
        return: 7
return: 1
sendMessage: exit(exit_code: take(); stdout: ""; stderr: "")
return
