+# A raw dereference write head `\p: v` raises `interpreter` on a null holder
+# where Lower checks it: the shared classification of the whole DEREF. A head
+# that is no dereference raises nothing here.
+fn: lm_compiler_indirect_head_raises (const: (@: stmt c.LmP0Node); int: mi) int
+    c.L2Address: place
+    int: raises 0
+    if: c.lm_compiler_indirect_head(stmt, @ place) != 0
+        return: 0
+    if: c.lm_compiler_indirect_resolve(mi, @ place) = 0
+        raises: c.lm_compiler_indirect_managed((cast: (int) (place\levels)), (cast: (int) (place\source_type)), mi)
+    c.lm_compiler_address_release(@ place)
+    return: raises
+end: lm_compiler_indirect_head_raises
