# Slice 286 probe: the `call` receiver over a free holder holding a fn whose input has a written default (the book
# :381); the call forms no input, so the default is taken (Codex, 285 norm answers item 3: "с учётом допустимых
# умолчаний").  Entry 7.
fn: g (int: a 5) int
    return: a
end: g
int: Hw 0
int: seen 0
fn: put (int: v) int
    node\seen: v
    return: v
end: put
fn: gd (int: a 5) int
    int: r put(a)
    return: r
end: gd
fn: call_free () int
    ---
        call: Hw
        return: node\seen
        catch: call ()
            return: 22
        catch: implements ()
            return: 24
    ---
end: call_free
fn: run () int
    @: Hw gd gd
    return: call_free()
end: run
int: code 7
int: got run()
if: got != 5
    code: got
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
