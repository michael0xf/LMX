---
    Observed:
        int: k 8
        int: result 5
        int: outside 8
    end: Observed
---
@: shared (data [] 0)
int: k 8
local:
end: local
fn: change () int
    :=: (node \ k) 8
    return: 1
end: change
fn: sink (int: value) int
    return: value
end: sink
fn: outer () int (
    prepared:
        name: local
        args: ((int value))
        return: int
        code: ((return value))
    end: prepared
    int: seeded (change)
)
    int: used seeded
    fn: prepared
    return: (sink ((local (k))))
end: outer
int: result (outer)
int: outside (data \ k)
sub: main ()
    :=: ((shared \ Observed) \ k) (node \ k)
    :=: ((shared \ Observed) \ result) result
    :=: ((shared \ Observed) \ outside) outside
end: main
