---
    Observed:
        int: first 790
        int: second 790
    end: Observed
---
@: shared (data [] 0)
fn: leaf () int
    return: 90
end: leaf
fn: outer () int (
    int: inside 0
    int: outside 0
)
    if: 1 ((fn leaf () int ((return 7))) (:= inside (leaf)))
    if: 1 ((:= outside (leaf)))
    return: ((inside * 100) + outside)
end: outer
int: first (outer)
int: second (outer)
sub: main ()
    :=: ((shared \ Observed) \ first) first
    :=: ((shared \ Observed) \ second) second
end: main
main:
