# A reached explicit merge copies the completed local source and callable state.
# Borrowing M rather than copying its actual occurrence gives 1/2/3/4.
fn: M () size_t
    size_t: hits
    M\hits: M\hits + 1U
return: M\hits

sub: check ()
    Local:
        fn: M
    end: Local
    M\hits: 0U
    R: merge: Local
    size_t: a1 Local\M()
    size_t: r1 R\M()
    size_t: a2 Local\M()
    size_t: r2 R\M()
    if: a1 != 1U || a2 != 2U || r1 != 1U || r2 != 2U
        sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
        return
    sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return

check
return
