fn: lm_compiler_emit_public_sig (int: mi) int
    @@: out_cell c.FILE (cast: (@@: c.FILE) (@ c.l2_out))
    @@: m_arity_cell int (cast: (@@: int) (@ c.l2_m_arity))
    int: j 0
    int: ty
    int: oty
    int: rt lm_compiler_sig_ret(mi)
    const: (@: sep char "")
    if: c.fputs(" (", out_cell[0]) < 0
        return: (cast: (int) (1))
    while: j < m_arity_cell[0][mi]
        ty: lm_compiler_ft(mi, j)
        # D-101: a declared graph formal holds the graph code, spelled as l2_emit_formal spells it
        # (l2_formal_raw); read raw, l2_emit_foreign_named got an index past its table
        # and the translation failed with no located diagnostic.  The result goes through
        # l2_sig_ret for the same reason (-137 part 2).
        ty: lm_compiler_formal_raw(ty)
        if: j != 0
            sep: "; "
        if: ty = 0 && c.fprintf(out_cell[0], "%sint: ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 1 && c.fprintf(out_cell[0], "%schar: ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 2 && c.fprintf(out_cell[0], "%ssize_t: ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 34 && c.fprintf(out_cell[0], "%sunsigned: ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 36 && c.fprintf(out_cell[0], "%sulong: ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 3 && c.fprintf(out_cell[0], "%sconst: @(char ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 9 && c.fprintf(out_cell[0], "%s@: size_t ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 11 && c.fprintf(out_cell[0], "%s@: int ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 12 && c.fprintf(out_cell[0], "%s@: char ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 16 && c.fprintf(out_cell[0], "%s@: void ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 17 && c.fprintf(out_cell[0], "%s@@: char ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 18 && c.fprintf(out_cell[0], "%s@@: void ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 19 && c.fprintf(out_cell[0], "%s@@: int ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 20 && c.fprintf(out_cell[0], "%s@@: size_t ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 24 && c.fprintf(out_cell[0], "%s@@: unsigned ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 39 && c.fprintf(out_cell[0], "%s@@: ulong ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 25 && c.fprintf(out_cell[0], "%s@: unsigned ", sep) < 0
            return: (cast: (int) (1))
        if: ty = 38 && c.fprintf(out_cell[0], "%s@: ulong ", sep) < 0
            return: (cast: (int) (1))
        if: ty >= 100
            if: lm_compiler_emit_foreign_named(out_cell[0], ty, sep, lm_compiler_fn(mi, j)) != 0
                return: (cast: (int) (1))
            ---
        else:
            if: ty != 0 && ty != 1 && ty != 2 && ty != 3 && ty != 9 && ty != 11 && ty != 12 && ty != 16 && ty != 17 && ty != 18 && ty != 19 && ty != 20 && ty != 24 && ty != 25 && ty != 34 && ty != 36 && ty != 38 && ty != 39
                c.fprintf(c.l1_stderr(), "l2trans: a library signature cannot spell formal type %d\n", ty)
                return: (cast: (int) (1))
            if: c.lm_compiler_write_text(out_cell[0], lm_compiler_fn(mi, j)) != 0
                return: (cast: (int) (1))
            if: ty = 3 && c.fputs(")", out_cell[0]) < 0
                return: (cast: (int) (1))
        ---
        j: j + 1
    ---
    if: rt = 2 && c.fputs(") size_t", out_cell[0]) < 0
        return: (cast: (int) (1))
    if: rt = 33 && c.fputs(") unsigned", out_cell[0]) < 0
        return: (cast: (int) (1))
    if: rt = 36 && c.fputs(") ulong", out_cell[0]) < 0
        return: (cast: (int) (1))
    if: rt = 3 && c.fputs(") @: char", out_cell[0]) < 0
        return: (cast: (int) (1))
    if: rt = 16 && c.fputs(") @: void", out_cell[0]) < 0
        return: (cast: (int) (1))
    if: rt = 35 && c.fputs(") const: @(char)", out_cell[0]) < 0
        return: (cast: (int) (1))
    if: rt = 32 && c.fputs(") @@: char", out_cell[0]) < 0
        return: (cast: (int) (1))
    if: rt >= 100 && lm_compiler_emit_foreign_return(out_cell[0], rt) != 0
        return: (cast: (int) (1))
    if: rt = 8 && c.fputs(")", out_cell[0]) < 0
        return: (cast: (int) (1))
    if: lm_compiler_ret_uns(mi) = 0 && rt != 3 && rt != 8 && rt != 16 && rt != 32 && rt != 35 && rt < 100 && c.fputs(") int", out_cell[0]) < 0
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: lm_compiler_emit_public_sig

