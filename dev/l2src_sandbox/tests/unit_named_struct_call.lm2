# `call: Counter` executes the selected ordinary Structure from both the
# root and bump. `Counter()` and `Counter: ()` instead supply an empty
# structural value, so they are not calls. Each execution writes the declared
# initializer and then increments n: Counter\n reads 1 despite an earlier 5.
# Entry 7.
Counter:
    size_t: n 0U
    n: n + 1U
return
fn: bump () size_t
    call: Counter
    size_t: v 9U
    v: Counter\n
return: v
Counter\n: 5U
call: Counter
size_t: a 9U
a: Counter\n
Counter\n: 5U
call: Counter
size_t: b 9U
b: Counter\n
Counter\n: 5U
size_t: c 9U
c: bump()
int: ok 0
if: a = 1U && b = 1U && c = 1U
    ok: 7
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
