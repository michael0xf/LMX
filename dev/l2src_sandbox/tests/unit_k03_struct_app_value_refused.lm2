# K03 S4, migrated to the explicit-call rule: an ordinary named Structure is
# executed only by `call:`.  `Model()` instead supplies an empty structural
# value.  That value cannot be assigned to the declared int `w`.
Model:
    size_t: x 1U
end: Model
fn: take (int: v) int
    return: v
end: take
fn: m () int
    int: w 5
    w: Model()
    return: w
end: m
sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
