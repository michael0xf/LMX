                fclose(l2_out)
                return: 1
            if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 6 && l2_ns_eternal[k] >= 0 && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_profile_array: (cast: (@: LmxArrayDesc) lmx_arena_take_profiled(l2_program_arena, c.sizeof(c.LmxArrayDesc), c.LMX_KIND_ARRAY, c.LMX_TYPE_ARRAY_OF_DESC, l2_eprofile%u))\n        if: l2_profile_array = 0\n            return: 1\n        l2_profile_array\\len: 0U\n        l2_profile_array\\data: 0\n        l2_entry_slot[0]: (cast: (@: void) l2_profile_array)\n", k, (cast: (unsigned) oi), (cast: (unsigned) l2_ns_eternal[k])) < 0
                fclose(l2_out)
                return: 1
            if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 5 && l2_ns_eternal[k] >= 0
                if: l2_nsf_ref[fx] = 0 && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_profile_array: (cast: (@: LmxArrayDesc) lmx_arena_take_profiled(l2_program_arena, c.sizeof(c.LmxArrayDesc), c.LMX_KIND_ARRAY, c.LMX_TYPE_ARRAY_OF_INT, l2_eprofile%u))\n        if: l2_profile_array = 0\n            return: 1\n        l2_profile_array\\len: %zuU\n        l2_profile_array\\data: 0\n", k, (cast: (unsigned) oi), (cast: (unsigned) l2_ns_eternal[k]), l2_nsf_val[fx]) < 0
                    fclose(l2_out)
                    return: 1
                if: l2_nsf_ref[fx] = 0 && l2_nsf_val[fx] != 0U && c.fprintf(l2_out, "        l2_profile_array\\data: lmx_arena_take_n_profiled(l2_program_arena, c.sizeof(c.int), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT, l2_eprofile%u, %zuU)\n        if: l2_profile_array\\data = 0\n            return: 1\n", (cast: (unsigned) l2_ns_eternal[k]), l2_nsf_val[fx]) < 0
                    fclose(l2_out)
                    return: 1
                if: l2_nsf_ref[fx] = 1 && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_profile_array: (cast: (@: LmxArrayDesc) lmx_arena_take_profiled(l2_program_arena, c.sizeof(c.LmxArrayDesc), c.LMX_KIND_ARRAY, c.LMX_TYPE_ARRAY_OF_CHAR, l2_eprofile%u))\n        if: l2_profile_array = 0\n            return: 1\n        l2_profile_array\\len: %zuU\n        l2_profile_array\\data: 0\n", k, (cast: (unsigned) oi), (cast: (unsigned) l2_ns_eternal[k]), l2_nsf_val[fx]) < 0
                    fclose(l2_out)
                    return: 1
                if: l2_nsf_ref[fx] = 1 && l2_nsf_val[fx] != 0U && c.fprintf(l2_out, "        l2_profile_array\\data: lmx_arena_take_n_profiled(l2_program_arena, c.sizeof(c.char), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR, l2_eprofile%u, %zuU)\n        if: l2_profile_array\\data = 0\n            return: 1\n", (cast: (unsigned) l2_ns_eternal[k]), l2_nsf_val[fx]) < 0
                    fclose(l2_out)
                    return: 1
                if: fputs("        l2_entry_slot[0]: (cast: (@: void) l2_profile_array)\n", l2_out) < 0
                    fclose(l2_out)
                    return: 1
                ---
            # A reference field (kind 10/11, FABLE-SONNET-SEND-REF-20260925-172
            # commit 1, RESTORED in commit 4 per the author's Q26.2 ruling: a
            # slot holding a Structure's address directly makes it a CHILD of
            # the holder (the copier descends, admission sees a Structure);
            # `@: T name` is a reference TO a reference, so the prototype
            # needs its own pointer CELL here, the same allocator the walked
            # root's own graph-typed own fields and a formal's/local's own
            # pointer locals already use (D-56's now-reverted direct-slot
            # shortcut assumed the slot held the pointee itself; the letter's
            # OWN sender slot -- built with the raw address, not a cell --
            # was the actual mismatch, fixed at the letter builders instead,
            # not here; see steps/send-ref-172.md commit 4).
            if: l2_nsf_owner[fx] = k && (l2_nsf_kind[fx] = 10 || l2_nsf_kind[fx] = 11) && l2_ns_eternal[k] < 0 && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: lmx_pointer_new_owned(c.LMX_TYPE_POINTER_BASE + %d, l2_program_arena)\n        if: l2_entry_slot[0] = 0\n            return: 1\n", k, (cast: (unsigned) oi), l2_nsf_ref[fx]) < 0
                fclose(l2_out)
                return: 1
            if: l2_nsf_owner[fx] = k && (l2_nsf_kind[fx] = 10 || l2_nsf_kind[fx] = 11) && l2_ns_eternal[k] >= 0 && c.fprintf(l2_out, "        l2_entry_slot: lmx_arena_ref_cell(l2_nsp[%d], %uU)\n        if: l2_entry_slot = 0\n            return: 1\n        l2_entry_slot[0]: lmx_arena_take_profiled(l2_program_arena, c.sizeof(@: void), c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_POINTER_BASE + %d, l2_eprofile%u)\n        if: l2_entry_slot[0] = 0\n            return: 1\n", k, (cast: (unsigned) oi), l2_nsf_ref[fx], (cast: (unsigned) l2_ns_eternal[k])) < 0
                fclose(l2_out)
                return: 1
            if: l2_nsf_owner[fx] = k
                oi: oi + 1
            ---
            fx: fx + 1
        ---
        k: k + 1
    ---
    # Second phase of construction: every entry already exists. A Structure-
    # typed field (Name: field) of an ordinary model is materialized as a real
    # typed occurrence owned by that model -- merge(Type, empty) with the owner
    # as container -- so merge(Model, empty) later deep-copies nested Structure
    # fields instead of leaving them null. Qualified/eternal references stay
    # shared by address (no reparent); their parent checks keep today's meaning.
    k: 0
    while: k < l2_ns_n
        oi: 0
        fx: 0
        while: fx < l2_nsf_n
            # Ordinary Structure-typed field: typed occurrence merge copies.
            if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 3 && l2_ns_eternal[l2_nsf_ref[fx]] < 0 && c.fprintf(l2_out, "        l2_mops[0U]: l2_nsp[%d]\n        l2_mbody: 0\n        l2_mstatus: lmx_merge_owned(l2_mops, 1U, l2_mbody, l2_nsp[%d], 0, l2_program_arena, l2_program_arena, 0, 0U, @ l2_mresult)\n        if: l2_mstatus != 0 || l2_mresult = 0\n            return: 1\n        if: lmx_arena_ref_store(l2_nsp[%d], %uU, (cast: (@: void) l2_mresult)) != 0\n            return: 1\n        if: l2_mresult\\parent != l2_nsp[%d]\n            return: 1\n", l2_nsf_ref[fx], k, k, (cast: (unsigned) oi), k) < 0
                fclose(l2_out)
                return: 1
            # Eternal/qualified Structure reference: share by address, no reparent.
            if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 3 && l2_ns_eternal[l2_nsf_ref[fx]] >= 0 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_nsp[%d], %uU, (cast: (@: void) l2_nsp[%d])) != 0\n            return: 1\n", k, (cast: (unsigned) oi), l2_nsf_ref[fx]) < 0
                fclose(l2_out)
                return: 1
            if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 3 && l2_ns_eternal[l2_nsf_ref[fx]] >= 0 && l2_ns_parent[l2_nsf_ref[fx]] < 0 && c.fprintf(l2_out, "        if: l2_nsp[%d]\\parent != 0\n            return: 1\n", l2_nsf_ref[fx]) < 0
                fclose(l2_out)
                return: 1
            if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 3 && l2_ns_eternal[l2_nsf_ref[fx]] >= 0 && l2_ns_parent[l2_nsf_ref[fx]] >= 0 && c.fprintf(l2_out, "        if: l2_nsp[%d]\\parent != l2_nsp[%d]\n            return: 1\n", l2_nsf_ref[fx], l2_ns_parent[l2_nsf_ref[fx]]) < 0
                fclose(l2_out)
                return: 1
            # A CALLABLE field stores that method own Structure, the unit child
            # at l2_unit_base + mi. Storing it does not reparent it either, so
            # its node is checked the same way. merge then deep-copies it like
            # any other Structure, sharing only the descriptor at slot 0.
            if: l2_nsf_owner[fx] = k && l2_nsf_kind[fx] = 4 && c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_nsp[%d], %uU, (cast: (@: void) lmx_arena_ref_struct(l2_entry_unit, %uU))) != 0\n            return: 1\n        if: lmx_arena_ref_struct(l2_entry_unit, %uU)\\parent != l2_entry_unit\n            return: 1\n", k, (cast: (unsigned) oi), (cast: (unsigned) (l2_unit_base + l2_nsf_ref[fx])), (cast: (unsigned) (l2_unit_base + l2_nsf_ref[fx]))) < 0
                fclose(l2_out)
                return: 1
            if: l2_nsf_owner[fx] = k
                oi: oi + 1
            ---
            fx: fx + 1
        ---
        k: k + 1
    ---
    # Construction is now complete for every qualified branch. Seal every
    # exact-profile pool that exists. STRUCT is required; the other domains are
    # conditional on the branch's actual shape. Sealing is owner-GC policy and
    # never changes physical references or representation.
    k: 0
    while: k < l2_ebr_n
        if: c.fprintf(l2_out, "        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_STRUCT, c.LMX_TYPE_STRUCT, l2_eprofile%u)\n        if: l2_profile_pool = 0 || lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n", (cast: (unsigned) k)) < 0
            fclose(l2_out)
            return: 1
        if: c.fprintf(l2_out, "        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_CHILDREN, c.LMX_TYPE_REFS, l2_eprofile%u)\n        if: l2_profile_pool != 0 && lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n", (cast: (unsigned) k)) < 0
            fclose(l2_out)
            return: 1
        if: c.fprintf(l2_out, "        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_SIZE_T, l2_eprofile%u)\n        if: l2_profile_pool != 0 && lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR, l2_eprofile%u)\n        if: l2_profile_pool != 0 && lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_INT, l2_eprofile%u)\n        if: l2_profile_pool != 0 && lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n", (cast: (unsigned) k), (cast: (unsigned) k), (cast: (unsigned) k)) < 0
            fclose(l2_out)
            return: 1
        if: c.fprintf(l2_out, "        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_UNSIGNED, l2_eprofile%u)\n        if: l2_profile_pool != 0 && lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_ULONG, l2_eprofile%u)\n        if: l2_profile_pool != 0 && lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n", (cast: (unsigned) k), (cast: (unsigned) k)) < 0
            fclose(l2_out)
            return: 1
        if: c.fprintf(l2_out, "        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_ARRAY, c.LMX_TYPE_ARRAY_OF_INT, l2_eprofile%u)\n        if: l2_profile_pool != 0 && lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n        l2_profile_pool: lmx_arena_find_profiled(l2_program_arena, c.LMX_KIND_ARRAY, c.LMX_TYPE_ARRAY_OF_CHAR, l2_eprofile%u)\n        if: l2_profile_pool != 0 && lmx_pool_seal(l2_profile_pool) != 0\n            return: 1\n", (cast: (unsigned) k), (cast: (unsigned) k)) < 0
            fclose(l2_out)
            return: 1
        k: k + 1
    ---
    # Every method occurrence gets its header parts and its `native` word (-189 c4): args at slot 0,
    # return at slot 1 (l2_emit_parts), once every occurrence and named Structure exists.  E keeps
    # `native` 0 -- the unit is walked.
    i: 0
    while: i < l2_m_n
        if: i != l2_e && l2_emit_parts(i) != 0
            fclose(l2_out)
            return: 1
        i: i + 1
    if: c.fprintf(l2_out, "        if: %uU != %uU\n            return: 1\n", l2_intern_again, l2_sigv) < 0
        fclose(l2_out)
        return: 1
    # A program's builder installs R0's children list and the host's settings in R0's own graph; R0's
    # Thread is made by the host after it (lmx_root_host_make).  A library's entry runs inside a turn
    # and publishes its unit as the current Message's graph.
    if: l2_library_mode = 0 && c.fprintf(l2_out, "        l2_children: lmx_list_new_owned(c.LMX_TYPE_ARRAY_OF_POINTER_BASE + c.LMX_DOMAIN_THREAD, l2_program_arena)\n        if: l2_children = 0\n            return: 1\n        l2_entry_unit\\parent: 0\n        if: lmx_arena_ref_store(l2_entry_unit, %uU, (cast: (@: void) l2_children)) != 0 || lmx_arena_ref_store(l2_entry_unit, %uU, (cast: (@: void) settings)) != 0\n            return: 1\n        l2_program_unit: l2_entry_unit\n", l2_children_field, (cast: (unsigned) l2_settings_field)) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode != 0 && fputs("        l2_current: lmx_thread_current()\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode != 0 && c.fprintf(l2_out, "        l2_message: lmx_thread_message(l2_current)\n        l2_children: lmx_thread_children(l2_current)\n        if: l2_current = 0 || l2_message = 0 || l2_children = 0\n            return: 1\n        l2_entry_unit\\parent: 0\n        if: lmx_arena_ref_store(l2_entry_unit, %uU, (cast: (@: void) l2_children)) != 0\n            return: 1\n        l2_message\\graph: l2_entry_unit\n        l2_program_unit: l2_entry_unit\n        if: l2_message\\graph != l2_entry_unit || l2_program_unit != l2_entry_unit\n            return: 1\n", l2_children_field) < 0
        fclose(l2_out)
        return: 1
    if: l2_m_arity[0] != 0 && c.fprintf(l2_out, "        if: %zuU = 0U\n            return: 1\n", l2_m_f0[0]\length) < 0
        fclose(l2_out)
        return: 1
    if: fputs("        # Closed-unit devirtualization: translator-bound child indices, no graph mutations after construction. Runtime does not memcmp formals. Evaluation order of actuals is materialized into temps before each call boundary. Hidden through-args, when present, follow declared formals in intern name order.\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode != 0 && fputs("        return: 0\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    # The program's root is walked (l2_rw_*): the roles its nodes refer to, bound for the turn's
    # walk, then its steps after every field of the unit.  Nothing runs here: R0's turn walks the
    # unit, and an uncaught throw stops the Message there (-158 G2).  There are no plan roles: a
    # plan is the prototype's layout (Sonnet -191).
    if: l2_library_mode = 0 && fputs("        @: Lmx l2_rw_roles lmx_walk_roles_open(l2_program_arena)\n        if: l2_rw_roles = 0\n            return: 1\n        lmx_walk_program_bind(l2_rw_roles)\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    l2_rw_emit: 1
    l2_rw_t: 0
    l2_rw_pn: 0
    l2_rw_send_i: 0
    l2_rw_mi: l2_e
    k: 0
    if: l2_library_mode = 0 && l2_e_n > 0 && l2_rw_stmts(l2_e_fields, 0 - 1, l2_rw_base, @ k) != 0
        l2_rw_emit: 0
        fclose(l2_out)
        return: 1
    l2_rw_emit: 0
    if: l2_library_mode = 0 && k = 0 && l2_rw_steps = 1
        if: c.fprintf(l2_out, "        if: lmx_arena_ref_store(l2_entry_unit, %dU, lmx_arena_ref_value(l2_rw_roles, (cast: (size_t) c.LMX_WALK_OP_RET))) != 0\n            return: 1\n", l2_rw_base) < 0
            fclose(l2_out)
            return: 1
        k: 1
    ---
    if: l2_library_mode = 0 && k != l2_rw_steps
        fclose(l2_out)
        return: l2_error(l2_src, 0, "internal: the root's steps changed between the passes")
    # Then each walkable method's frames, into its occurrence (-193 T4a).
    if: l2_library_mode = 0 && l2_rw_methods_emit() != 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode = 0 && fputs("        return: 0\n    end: l2_program_build\nend: external\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode != 0 && fputs("    end: l2_program_entry\nend: external\n", l2_out) < 0
        fclose(l2_out)
        return: 1
    if: l2_library_mode != 0
        if: l2_emit_library_wrappers() != 0
            fclose(l2_out)
            return: 1
        ---
    else:
        # main is the launch (lmx_root_launch): the host reserves R0 with this unit's field count, the
        # builder installs the unit in R0's own arena and graph, and the exit is R0's exit letter or
        # the mapping of its success.
        if: c.fprintf(l2_out, "external:\n    fn: main (int: argc; @@: char argv) int\n        LmxRoot: l2_program_root\n        return: lmx_root_launch(@ l2_program_root, argc, argv, l2_program_build, %uU, lmx_root_settings, 5000U, (cast: (@: void) c.stdout), (cast: (@: void) c.stderr))\n    end: main\nend: external\n", kids) < 0
            fclose(l2_out)
            return: 1
    ---
    if: fclose(l2_out) != 0
        c.remove(l2_pub_tmp)
        return: 1
    bseq: 0U
    chk: c.fopen(l2_pub_bak, "rb")
    while: chk != 0
        fclose(chk)
        if: bseq = (cast: (size_t) -1)
            c.remove(l2_pub_tmp)
            return: 1
        bseq: bseq + 1U
        if: c.snprintf(l2_pub_bak, l2_pub_bak_cap, "%s.bak.%zu", out_path, bseq) < 0
            c.remove(l2_pub_tmp)
            return: 1
        chk: c.fopen(l2_pub_bak, "rb")
    ---
    chk: c.fopen(out_path, "rb")
    if: chk != 0
        had: 1
        fclose(chk)
    if: had != 0 && c.rename(out_path, l2_pub_bak) != 0
        c.remove(l2_pub_tmp)
        return: 1
    if: c.rename(l2_pub_tmp, out_path) != 0
        if: had != 0 && c.rename(l2_pub_bak, out_path) != 0
            c.fprintf(l1_stderr(), "l2trans error: publication failed; dest unrestored; backup at %s\n", l2_pub_bak)
            return: 1
        return: 1
    if: had != 0
        c.remove(l2_pub_bak)
return: 0

external:
    fn: main (int: argc; @@: char argv) int
        int: r
        int: a 1
        @: FILE af
        const: @: char lg
        const: @: char rt
        c.setvbuf(l1_stdout(), 0, c._IONBF, 0)
        c.setvbuf(l1_stderr(), 0, c._IONBF, 0)
        # The test knob `--walk-methods` (-193 T4a): a method with frames gets native 0.
        if: argc >= a + 3 && c.strcmp(argv[a], "--walk-methods") = 0
            l2_walk_methods: 1
            a: a + 1
        ---
        # The library profile is selected here, never inferred from the unit.
        if: argc >= a + 3 && c.strcmp(argv[a], "--library") = 0
            l2_library_flag: 1
            a: a + 1
        ---
        if: argc != a + 2
            fputs("usage: l2trans.exe [--walk-methods] [--library] <source.lm2> <output.lm1>\n", l1_stderr())
            return: 1
        rt: c.getenv("L2_RUNTIME_ROOT")
        if: rt != 0 && rt[0] != 0
            l2_rt_root: rt
        if: c.getenv("L2_FAIL_MALLOC") != 0
            l2_fail_left: c.atoi(c.getenv("L2_FAIL_MALLOC"))
        r: l2_translate(argv[a], argv[a + 1])
        # A failure that printed no located diagnostic is still a failure the
        # user must see; a silent exit 1 names nothing to fix.
        if: r != 0 && l2_diag_n = 0
            c.fprintf(l1_stderr(), "l2trans error: %s: translation failed with no located diagnostic\n", argv[a])
        l2_release()
        lg: c.getenv("L2_ALLOC_LOG")
        if: lg != 0
            af: c.fopen(lg, "wb")
            if: af != 0
                c.fprintf(af, "n=%d free=%d live=%d fail_at=%d fail_kind=%d err=%d\n", l2_alloc_n, l2_free_n, l2_alloc_live, l2_alloc_fail_at, l2_alloc_fail_kind, l2_alloc_err)
                fclose(af)
            ---
        ---
    return: r
end: external
