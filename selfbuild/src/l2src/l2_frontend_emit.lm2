# Original: l2src/l2trans.lm1:17834
fn: lm_compiler_check_value_span (@: span c.L2ValueSpan; int: mi; const: (@: path char); const: (@: at c.LmP0Node)) int
    @: selected c.L2Path
    @: where c.LmP0Node
    c.L2Address: address
    int: status
    int: own
    if: span = 0 || span\first = 0 || span\node = 0
        return: (cast: (int) (c.lm_compiler_error(path, at, "unsupported body")))
    where: span\node
