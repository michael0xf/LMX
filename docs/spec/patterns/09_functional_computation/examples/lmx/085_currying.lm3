Addition:
    int: first
    int: second
    return: int
    apply:
        return: first + second

Demo:
    return: int
    run:
        throws: copy(FxPartial\partial\throws) FxCallFailure
        @: add curry(Addition\apply)
        @: add5 add(5)
        @: add100 add(100)
        int: saved 1000
        return: add5(1) * 1000000 + add100(1) * 1000 + add5(1)
