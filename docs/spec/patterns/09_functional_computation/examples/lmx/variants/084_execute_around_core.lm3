Resource:
    int: value 42

Trace:
    int: mode 0
    int: events 0

Acquire:
    return: @
    open:
        throws:
            ResourceFailure
        Trace\events := Trace\events * 10 + 1
        if: Trace\mode = 2
            throw: ResourceFailure()
        return: Resource

Action:
    @: resource
    return: int
    use:
        throws:
            ResourceFailure
        Trace\events := Trace\events * 10 + 2
        if: Trace\mode = 1
            throw: ResourceFailure()
        return: resource\value

Release:
    @: resource
    close:
        Trace\events := Trace\events * 10 + 3

Example:
    int: mode
    return: int
    run:
        throws:
            FxIndex
            FxArity
            FxRecordArity
            FxTypeToken
            FxKernelFailure
            FxCallFailure
            ReceiverIndex
            SequenceSize
        Trace\mode := mode
        Trace\events := 0
        int: value \bracket(Acquire\open; Release\close; Action\use)
        return: value * 1000 + Trace\events
        catch: FxCallFailure (@: outcome)
            char[]: actual outcome\failure
            char[]: expected sys\name(ResourceFailure)
            sys\assert(length(actual) = length(expected))
            int: i 0
            while: i < length(actual)
                sys\assert(actual[i] = expected[i])
                i += 1
            return: -Trace\events
