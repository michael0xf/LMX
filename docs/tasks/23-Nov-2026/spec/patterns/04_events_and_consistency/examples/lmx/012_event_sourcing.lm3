EventMessage:
    @: store
    int: expected
    int: delta
    return: int
    balance:
        @: events node\store\read()
        int: result 0
        int: i 0
        while: i < length(events)
            result += events[i]
            i += 1
        return: result
    append:
        throws: Conflict
        if: !node\store\append(expected; delta)
            throw: Conflict()
        return: balance()
