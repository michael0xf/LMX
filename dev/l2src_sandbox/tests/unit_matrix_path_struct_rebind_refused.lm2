# PATH-STRUCTURE-LEAF: nonempty application of an ordinary named body is
# a located call refusal, not an assignment/rebinding operation.
Model:
    size_t: value 1U
end: Model

Outer:
    inner:
        size_t: value 1U
end: Outer

o: merge: Outer
a: merge: Model
o\inner: a
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
