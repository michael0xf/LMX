# Receiving type and candidate precede binding the same-named pointer cell.
fn: check () int
    Model: (int: value 1)
    Other: (int: spare 22; int: value 11)
    @: Model Model @Other
    if: Model\value != 11 || Model != @Other
        return: 81
    Model\value: 19
    if: Other\value != 19 || Other\spare != 22
        return: 82
return: 7
sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
