+    size_t: destination_before 0U
+    int: result 0
+    c.memset((cast: (@: void) (@ destination)), 0, c.sizeof(c.LmxArena))
+    if: c.lmx_arena_open(@ destination) != 0
+        check((cast: (int) (0)), "cross-arena native call opens its destination arena")
+        return
+    ---
+    if: c.lmx_graph_copy_owned(graph, source, @ destination, @ copied) != c.LMX_GRAPH_COPY_OK || copied = 0
+        check((cast: (int) (0)), "cross-arena native call copies its complete unit")
+        c.lmx_arena_release(@ destination)
+        return
+    ---
+    method: c.lmx_arena_ref_struct(copied, slot)
+    original: c.lmx_arena_ref_struct(graph, slot)
+    if: method = 0 || method\native = 0
+        check((cast: (int) (0)), "cross-arena native call selects a copied compiled method")
+        c.lmx_arena_release(@ destination)
+        return
+    ---
+    source_head: c.lmx_source_name_get(source, (cast: (@: void) original))
+    copied_head: c.lmx_source_name_get(@ destination, (cast: (@: void) method))
+    check((cast: (int) ((source_head = 0 && copied_head = 0) || (source_head != 0 && copied_head != 0 && source_head\size = copied_head\size && (source_head\size = 0U || c.memcmp(source_head\data, copied_head\data, source_head\size) = 0)))), "copied method keeps its external receiver-head name")
+    source_field: c.lmx_source_name_get(source, (cast: (@: void) c.lmx_arena_ref_cell(graph, slot)))
+    copied_field: c.lmx_source_name_get(@ destination, (cast: (@: void) c.lmx_arena_ref_cell(copied, slot)))
+    check((cast: (int) ((source_field = 0 && copied_field = 0) || (source_field != 0 && copied_field != 0 && source_field\size = copied_field\size && (source_field\size = 0U || c.memcmp(source_field\data, copied_field\data, source_field\size) = 0)))), "copied method keeps its external owning-field name")
+    source_before: shape_arena_cells(source)
+    destination_before: shape_arena_cells(@ destination)
+    check((cast: (int) (c.lmx_call0(@ destination, method, @ result) = 0)), "copied native method returns status separately from value")
+    check((cast: (int) (result = expected)), "copied native method returns the expected result")
+    check((cast: (int) (shape_arena_cells(source) = source_before)), "copied native method leaves its source arena untouched")
+    check((cast: (int) (shape_arena_cells(@ destination) > destination_before)), "copied native method allocates its merge in the destination arena")
+    c.lmx_arena_release(@ destination)
+    return
+end: shape_copy_native_call
