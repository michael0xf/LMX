# N4 (LMX_semantics.ru.md #method-parts): a head nested in the initializer of D\T is not a field of D. D has y only
# inside T, so the place S needs is missing at the root of D: the implicit call throw at the admission. Entry 7.
S:
    int: y 2
end: S
D:
    T:
        int: y 5
    end: T
end: D
fn: run () int
    int: r 82
    call: S D
    catch: call ()
        r: 83
        if: D\T\y = 5
            r: 7
    ---
return: r
int: got run()
sendMessage: exit(exit_code: got; stdout: ""; stderr: "")
return
