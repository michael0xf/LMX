# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: first 0
        int: second 0
        int: literal 0
)
@: Calls (
    Box(fn: pick (int: x) int (return: x + 1))
    Box(fn: pick (int: x) int (return: x + 2))
    `[0]Box`(fn: pick (int: x) int (return: x + 3))
)
int: first Calls\[0]Box\pick(10)
int: second Calls\[1]Box\pick(10)
int: literal Calls\`[0]Box`\pick(10)

sub: main ()
    @: shared node[0]
    shared\Observed\first := first
    shared\Observed\second := second
    shared\Observed\literal := literal
main()
