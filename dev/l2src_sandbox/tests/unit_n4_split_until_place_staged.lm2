# A data Structure with an until body keeps its physical fields. Constructing
# D does not run the dormant give() statement; the split call writes D.y.
int: n 0
fn: give () int
    node\n: node\n + 1
    return: 40
end: give
S:
    int: y
    y: y + 2
end: S
D:
    int: x 1
    int: y give()
until: n > 0
call: S D
int: result 81
if: n = 0 && D\x = 1 && D\y = 2
    result: 7
sendMessage: exit(exit_code: result; stdout: ""; stderr: "")
return
