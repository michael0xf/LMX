            if: lm_compiler_merge_uses_native(ind, msf, n, @ mq, @ mslots) != 0
                return: (cast: (int) (1))
            # independent refuses executable lexical reads, not dependencies
            # carrying a declared receiving contract. Both stay in the same
            # used-copy plan; duplicate roles are joined by the L2 inventory.
            # The merge itself is ordinary; immutable qualifies its COMPLETED result below
            # (l2_emit_qualify_copy, l2_emit_qualify_result); const is the binding's contract (l2_colon_check_assignment).
            if: (qual & 1) != 0 && c.lm_compiler_has_lexical(mur_role_cell[0], mur_n_cell[0]) != 0
                return: (cast: (int) (c.lm_compiler_error(src_cell[0], stmt, "an independent merge result cannot read its lexical context")))
            if: mq > 0 && mnp = 0 && c.fprintf(out_cell[0], "%sl2_mstatus: lmx_merge_used_owned(l2_mops, %dU, l2_mbody, l2_program_arena, l2_program_arena, l2_mprofiles, l2_mprofile_n%d, l2_mua%d, l2_muk%d, l2_mus%d, l2_mul%d, %dU, %dU, 0, 0U, @ l2_mresult)\n", ind, n, msf, msf, msf, msf, msf, mq, mslots) < 0
                return: (cast: (int) (1))
            if: mq > 0 && mnp > 0 && c.fprintf(out_cell[0], "%sl2_mstatus: lmx_merge_used_owned(l2_mops, %dU, l2_mbody, l2_program_arena, l2_program_arena, l2_mprofiles, l2_mprofile_n%d, l2_mua%d, l2_muk%d, l2_mus%d, l2_mul%d, %dU, %dU, l2_mpp, %dU, @ l2_mresult)\n", ind, n, msf, msf, msf, msf, msf, mq, mslots, mnp) < 0
                return: (cast: (int) (1))
            if: mq = 0 && mnp = 0 && c.fprintf(out_cell[0], "%sl2_mstatus: lmx_merge_profiles_owned(l2_mops, %dU, l2_mbody, l2_program_arena, l2_program_arena, l2_mprofiles, l2_mprofile_n%d, 0, 0U, @ l2_mresult)\n", ind, n, msf) < 0
                return: (cast: (int) (1))
            if: mq = 0 && mnp > 0 && c.fprintf(out_cell[0], "%sl2_mstatus: lmx_merge_profiles_owned(l2_mops, %dU, l2_mbody, l2_program_arena, l2_program_arena, l2_mprofiles, l2_mprofile_n%d, l2_mpp, %dU, @ l2_mresult)\n", ind, n, msf, mnp) < 0
