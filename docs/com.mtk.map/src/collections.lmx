# DRAFT: shared LMX collection algorithms. No Java reflection or host ports.
# Scalar collections box actual scalar records; object collections compare references.

MapSizeSum:
    int: left
    int: right
    int: limit 2147483647
    required: left right
    return: int
    sum:
        throws: copy(MapThrows)
        if: left < 0 || right < 0 || left > limit || right > limit - left
            throw: MapFailure("size overflow")
        return: left + right

