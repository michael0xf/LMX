    int: saved_cur cur_mi_cell[0]
    int: made
    int: one
    int: bad
    int: model
    int: base
    int: steps
    int: nb
    int: width
    int: j
    @: source c.L2SourceContainer
    while: s < t7_n_cell[0]
        model: t7_model_cell[0][s]
