# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: result 0
)
@: shared data[0]
fn: take (int: value; int: other 2) int
    return: value + other
end: take
fn: holder () int
    if: 0
        take()
    return: 7
end: holder
int: result holder()

sub: main ()
    shared\Observed\result := result
main()
