# Shared metadata models and policy; no runtime registration.
C99Schema:
    int: version 2
    char[]: inventorySha256 "e47a6bd1fb7e29481c2c2f4ff7bd00d3c6cd1f4b755a1c846af2fc3eff41c6f7"
