Counts:
    size_t: s 3U
    int: i 4
    unsigned: u 5U
    ulong: l 6U
end: Counts

# FABLE-OPUS-DISCARD-20260924-147 (D-15 reopened): every numeric field of a
# named Structure -- size_t, int, unsigned, ulong -- has its own cell holding
# its literal, in the Structure and in a merge copy, and a write to the copy
# leaves the original alone.  Success is 7.
size_t: vs
int: vi
unsigned: vu
ulong: vl
vs: Counts\s
vi: Counts\i
vu: Counts\u
vl: Counts\l
if: vs != 3U
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
if: vi != 4
    sendMessage: exit(exit_code: 82; stdout: ""; stderr: "")
    return
if: vu != 5U
    sendMessage: exit(exit_code: 83; stdout: ""; stderr: "")
    return
if: vl != 6U
    sendMessage: exit(exit_code: 84; stdout: ""; stderr: "")
    return

c: merge: Counts
c\s: 30U
c\i: 40
c\u: 50U
c\l: 60U
vs: c\s
vi: c\i
vu: c\u
vl: c\l
if: vs != 30U
    sendMessage: exit(exit_code: 85; stdout: ""; stderr: "")
    return
if: vi != 40
    sendMessage: exit(exit_code: 86; stdout: ""; stderr: "")
    return
if: vu != 50U
    sendMessage: exit(exit_code: 87; stdout: ""; stderr: "")
    return
if: vl != 60U
    sendMessage: exit(exit_code: 88; stdout: ""; stderr: "")
    return

vs: Counts\s
vi: Counts\i
vu: Counts\u
vl: Counts\l
if: vs != 3U || vi != 4 || vu != 5U || vl != 6U
    sendMessage: exit(exit_code: 89; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
