# implements-port B3: size_t initialising an unsigned own -- convert.lm2 has no such row, so the
# declaration is refused, located, with the phrase a store uses.  Mutant: no initializer check --
# l2trans accepts (and the emitter's own guard refuses "internal: a conversion site was not
# checked", not this phrase).
fn: go () int
    size_t: b 2U
    unsigned: u b
    return: 7
end: go
sendMessage: exit(exit_code: go(); stdout: ""; stderr: "")
return
