# The suite's ENTRY is the program's LMX result, a C int, not a process exit status of 0 .. 255 (R170-2,
# refinement 1 of OPUS-CODEX-20261023-SLICE170): this program's result is 1011, computed.
fn: run () int
    int: a 1000
    int: b 11
    return: a + b
end: run
sendMessage: exit(exit_code: run(); stdout: ""; stderr: "")
return
