predef: "l2src/lmx_manager_running.h.lm1"
predef: "l2src/lmx_posix_abi.h.lm1"

# The look and the pause live here, not in the manager body. That body inlines
# the clock and the turn, so a selftest that already inlined those cannot also
# link it. Reap still joins; this look only reads the flag the lane set last.

fn: lmx_manager_running_lane_ended (@: LmxSchedule slot) int
    @: LmxPosixLane lane
    int: done
    if: slot = 0 || slot\lane = 0
        return: 1
    lane: (cast: (@: LmxPosixLane) slot\lane)
    c.pthread_mutex_lock(@ lane\mu)
    done: lane\finished
    c.pthread_mutex_unlock(@ lane\mu)
return: done

fn: lmx_manager_running_pause_ms (unsigned: ms) int
    LmxPosixTimespec: pause
    unsigned: whole 0U
    whole: ms / 1000U
    c.pause.tv_sec: (cast: (long) whole)
    c.pause.tv_nsec: (cast: (long) ((ms % 1000U) * 1000000U))
    c.nanosleep(@ pause, (cast: (@: LmxPosixTimespec) 0))
return: 0

struct: LmxManagerThread
    pthread_t: thread
    pthread_mutex_t: mu
    int: finished
    LmxManagerWork: work
end: LmxManagerThread

fn: lmx_mgr_work_entry (@: void arg) @: void
    @: LmxManagerThread box
    box: (cast: (@: LmxManagerThread) arg)
    if: box != 0 && box\work != 0
        box\work(0)
    if: box != 0
        c.pthread_mutex_lock(@ box\mu)
        box\finished: 1
        c.pthread_mutex_unlock(@ box\mu)
    return: 0

fn: lmx_manager_running_thread_start (LmxManagerWork: work) @: void
    @: LmxManagerThread box
    box: (cast: (@: LmxManagerThread) calloc(1U, c.sizeof(c.LmxManagerThread)))
    if: box = 0
        return: 0
    if: c.pthread_mutex_init(@ box\mu, 0) != 0
        free((cast: (@: void) box))
        return: 0
    box\work: work
    box\finished: 0
    if: c.pthread_create(@ box\thread, 0, (cast: (LmxPosixStart) lmx_mgr_work_entry), (cast: (@: void) box)) != 0
        c.pthread_mutex_destroy(@ box\mu)
        free((cast: (@: void) box))
        return: 0
    return: (cast: (@: void) box)

fn: lmx_manager_running_thread_running (@: void handle) int
    @: LmxManagerThread box
    int: done
    if: handle = 0
        return: 0
    box: (cast: (@: LmxManagerThread) handle)
    c.pthread_mutex_lock(@ box\mu)
    done: box\finished
    c.pthread_mutex_unlock(@ box\mu)
    if: done = 0
        return: 1
return: 0

fn: lmx_manager_running_thread_join (@: void handle) int
    @: LmxManagerThread box
    if: handle = 0
        return: 0
    box: (cast: (@: LmxManagerThread) handle)
    c.pthread_join(box\thread, (cast: (@@: void) 0))
    c.pthread_mutex_destroy(@ box\mu)
    free((cast: (@: void) box))
return: 0

fn: lmx_manager_running_thread_id () size_t
return: (cast: (size_t) c.pthread_self())
