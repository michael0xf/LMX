# Inside a method body bare callable names are value reads too. w discards m
# and f, then explicitly calls both. f holds m's callable occurrence. m runs
# twice -- `m 1`, `m 1` -- and w returns 5. The unit's hits stays 0.
int: hits 0

fn: m () int
    hits: hits + 1
    c.printf: "m %d\n" hits
    return: 7
end: m

fn: w (m: f) int
    m
    f
    m()
    f()
    return: 5
end: w

int: r 0
r: w(m)
sendMessage: exit(exit_code: hits * 10 + r; stdout: ""; stderr: "")
return
