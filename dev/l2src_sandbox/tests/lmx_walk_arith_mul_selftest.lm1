predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_plan.lm1"
predef: "l2src/lmx_primitive.h.lm1"
predef: "l2src/lmx_merge_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# -170 c1 / D-58: MUL/DIV/MOD via lmx_walk_arith_out (same shape as ADD/SUB).
# DIV/MOD by zero: walker returns LMX_WALK_INVALID (X1 class of D-37/D-44) — not a throw
# and not INVALID-as-value. Status chosen because the graph is well-formed but the
# operation is refused (same ERROR class as other walk refusals); walk stops.
# Mutants RED: MUL computed as ADD; DIV by zero admitted (status OK / value produced).

@: LmxArena ga 0
@: Lmx groles 0
@: Lmx gplan_roles 0
@: LmxWalkContext gctx 0
@: LmxWalkValue gv 0
int: broken 0
int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(ga, groles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(ga, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

sub: ref (@: Lmx code; size_t: slot; @: Lmx target)
    if: code = 0 || target = 0 || lmx_arena_ref_store(code, slot, (cast: (@: void) target)) != 0
        broken: broken + 1
    ---
end: ref

sub: sz (@: Lmx code; size_t: slot; size_t: value)
    if: code = 0 || lmx_walk_store_size(ga, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: sz

fn: mk_m (@: Lmx unit; size_t: slot; size_t: children) @: Lmx
    @: Lmx m pl(unit, slot, children)
    @: LmxCallable info lmx_callable_new_owned(ga)
    if: m = 0 || info = 0 || lmx_arena_ref_store(m, 0U, (cast: (@: void) info)) != 0
        broken: broken + 1
        return: 0
    ---
return: m

fn: go (@: Lmx m) int
    int: st
    if: m = 0 || gctx = 0 || gv = 0
        return: c.LMX_WALK_INVALID
    st: lmx_walk_prepare(gctx, ga, gplan_roles, m)
    if: st != c.LMX_WALK_OK
        return: st
return: lmx_walk_run(gctx, m, 0, 0U, gv)

fn: main () int
    LmxArena: arena
    LmxArena: context_arena
    LmxPool: context_cells
    LmxScratch: store
    LmxWalkContext: context
    @: Lmx unit 0
    @: Lmx m 0
    @: Lmx n 0
    @: Lmx eqn 0
    @: Lmx litn 0
    @: Lmx divn 0
    int: st 0

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        return: 2
    ga: @ arena
    if: lmx_chars_init(ga) != 0
        return: 2
    groles: lmx_walk_roles_open(ga)
    gplan_roles: lmx_plan_roles_open(ga)
    if: groles = 0 || gplan_roles = 0
        return: 2
    memset((cast: (@: void) (@ context_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxScratch))
    if: lmx_arena_open(@ context_arena) != 0 || lmx_scratch_open(@ store, @ context_arena, @ context_cells, 16U) != c.LMX_SCRATCH_OK
        return: 2
    memset((cast: (@: void) (@ context)), 0, c.sizeof(c.LmxWalkContext))
    context.arena: ga
    context.scratch: @ store
    context.roles: groles
    context.plan_roles: gplan_roles
    context.immutable_profile: 0
    context.classified: 0U
    gctx: @ context
    gv: (cast: (@: LmxWalkValue) calloc(1U, c.sizeof(c.LmxWalkValue)))
    if: gv = 0
        return: 2

    # int 6*7 = 42
    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 4U) != 0
        return: 2
    ---
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    eqn: fr(n, 1U, c.LMX_WALK_OP_MUL, 3U)
    litn: fr(eqn, 1U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 6) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    litn: fr(eqn, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 7) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\number = 42)), "int 6*7=42")

    # int 7/2 = 3
    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 4U) != 0
        return: 2
    ---
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    eqn: fr(n, 1U, c.LMX_WALK_OP_DIV, 3U)
    litn: fr(eqn, 1U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 7) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    litn: fr(eqn, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 2) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\number = 3)), "int 7/2=3")

    # int 7%2 = 1
    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 4U) != 0
        return: 2
    ---
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    eqn: fr(n, 1U, c.LMX_WALK_OP_MOD, 3U)
    litn: fr(eqn, 1U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 7) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    litn: fr(eqn, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 2) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\number = 1)), "int 7%2=1")

    # int -7/2 = -3 (C toward zero)
    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 4U) != 0
        return: 2
    ---
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    eqn: fr(n, 1U, c.LMX_WALK_OP_DIV, 3U)
    litn: fr(eqn, 1U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 0 - 7) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    litn: fr(eqn, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 2) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\number = (0 - 3))), "int -7/2=-3 toward zero")

    # int -7%2 = -1 (C toward zero)
    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 4U) != 0
        return: 2
    ---
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    eqn: fr(n, 1U, c.LMX_WALK_OP_MOD, 3U)
    litn: fr(eqn, 1U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 0 - 7) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    litn: fr(eqn, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 2) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\number = (0 - 1))), "int -7%2=-1 toward zero")

    # size_t 10/3 = 3 via EQ (arith_out yields a size cell, not WalkValue.number)
    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 4U) != 0
        return: 2
    ---
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    eqn: fr(n, 1U, c.LMX_WALK_OP_EQ, 3U)
    divn: fr(eqn, 1U, c.LMX_WALK_OP_DIV, 3U)
    litn: fr(divn, 1U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_size(ga, litn, 1U, 10U) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    litn: fr(divn, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_size(ga, litn, 1U, 3U) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    litn: fr(eqn, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_size(ga, litn, 1U, 3U) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\number = 1)), "size_t 10/3=3")

    # mixed int * size_t -> INVALID
    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 4U) != 0
        return: 2
    ---
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    eqn: fr(n, 1U, c.LMX_WALK_OP_MUL, 3U)
    litn: fr(eqn, 1U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 1) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    litn: fr(eqn, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_size(ga, litn, 1U, 1U) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_INVALID)), "mixed int*size_t INVALID")

    # 1/0 stops the walk: LMX_WALK_INVALID (documented above)
    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 4U) != 0
        return: 2
    ---
    m: mk_m(unit, 0U, 2U)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    eqn: fr(n, 1U, c.LMX_WALK_OP_DIV, 3U)
    litn: fr(eqn, 1U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 1) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    litn: fr(eqn, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 0) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_INVALID)), "1/0 stops walk INVALID")

    c.printf("lmx_walk_arith_mul_selftest checks=%d failures=%d broken=%d\n", checks, failures, broken)
    if: failures != 0 || broken != 0
        return: 1
return: 0
