# OPUS-ROOT-CALL-20260930-17: at the root, with Model and Other declared above, `Model: Other` is Model's call with
# Other -- the named Structure Other resolves, so nothing is declared (the method's rule, l2_colon_bound_before) --
# refused where it stands, at its own line, until a named Structure's call with an argument is built.  The unit
# classifier read it as declaring a field Other (l2_unit_declares scanned the whole unit), so `Other:` above was no
# named Structure and the refusal fell on that block.
Model:
    size_t: value 1U
end: Model

Other:
    size_t: p 2U
end: Other

Model: Other
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
