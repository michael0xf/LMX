# FABLE-GROKBOT-MATRIX-20260924-143 cell: existing callable x callable arg
# (descriptor formal). CALL; result is the descriptor value itself.
fn: seven () int
    return: 7
end: seven

fn: apply (seven: g) int
    return: g
end: apply

int: r
r: apply(seven)
if: r != 7
    return: 11
r: apply: seven
if: r != 7
    return: 12
return: 0
