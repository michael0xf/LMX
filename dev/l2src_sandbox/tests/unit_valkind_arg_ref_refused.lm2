# A Structure given to a number formal is a reference where a number is asked (the walk's words): `take(b)` went out
# as C passing the Box's pointer as the int.
Box:
    int: v 0
end: Box
fn: take (int: x) int
    return: x
end: take
fn: peek () int
    b: merge: Box
    return: take(b)
end: peek
int: r 0
r: peek()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
