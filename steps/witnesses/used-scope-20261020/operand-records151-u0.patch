+# Only the owning token list calls this release. Prefix/record projections
+# borrow their pointers,including copied span views held by address plans.
+fn: l2_value_span_release (@: L2ValueSpan span) int
+    if: span = 0
+        return: 0
+    if: span\operand != 0
+        l2_value_span_release(span\operand)
+        l2_xfree((cast: (@: void) span\operand))
+    if: span\prepared != 0
+        l2_path_release(span\prepared)
+        l2_xfree((cast: (@: void) span\prepared))
+    span\operand: 0
+    span\prepared: 0
+    span\grammar: 0
+return: 0
+
+fn: l2_value_spans_release (@: L2ValueSpan spans; int: count) int
+    int: k 0
+    if: spans = 0
+        return: 0
+    while: k < count
+        l2_value_span_release(spans + k)
+        k: k + 1
+    l2_xfree((cast: (@: void) spans))
+return: 0
