Counter:
    int: steps 0
end: Counter
Sum:
    int: a 1
    int: b 2
    add: (:= (Counter \ steps) (((Counter \ steps) + (a * 10)) + b))
end: Sum
Args:
    int: a 7
    int: b 3
end: Args
D:
    int: z 1
end: D
int: before 1
int: after 0
Main:
    :=: (node \ before) 1
    call: (:= args Args) (:= data D) (:= code (Sum \ add))
    :=: (node \ after) 2
end: Main
