# A body as a later segment is visible where the path stands as a root body is (7b-3, Q51: forward and down): inside
# N's if body, before its while statement, `if\while\j` names no body yet -- refused where it stands.  (After the
# while, or after the if's `end`, the same path reads j's place: unit_body_seg_method.)
fn: N () int
    int: r 0
    if: 1 = 1
        r: if\while\j
        int: k 0
        while: k < 3
            int: j 0
            j: k * 10 + 1
            k: k + 1
        ---
    return: r
end: N
int: d 0
d: N()
sendMessage: exit(exit_code: d; stdout: ""; stderr: "")
return
