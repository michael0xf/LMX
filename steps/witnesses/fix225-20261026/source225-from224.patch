diff --git a/tests/l2/rr2/unit_rr2_qualified_merge_callable.lm2 b/tests/l2/rr2/unit_rr2_qualified_merge_callable.lm2
new file mode 100644
index 0000000000000000000000000000000000000000..fe6013650af5234bf1930c5032a19ad040343a9b
--- /dev/null
+++ b/tests/l2/rr2/unit_rr2_qualified_merge_callable.lm2
@@ -0,0 +1,26 @@
+# RR2c-2b (critical_qualifier_receivers_bug; steps/qualifier-receivers-20261010.md): a qualified merge result holding a
+# callable -- Box has the callable field `use`, a copy of the method's occurrence made by the merge -- is proved and
+# sealed as any: a callable is a Structure and is copied, its native word a terminal of the preflight.  The data field
+# is read and the callable is called through the sealed value.  Exit 7; 81..82 name the failing read.
+Wide:
+    int: x 2
+end: Wide
+fn: use (Wide: q) int
+    return: q\x * 10 + q\x
+end: use
+Box:
+    int: v 0
+    fn: use
+end: Box
+fn: m () int
+    h: independent: const: immutable: merge(Box  int: v 5)
+    if: h\v != 5
+        return: 81
+    w: merge(Wide)
+    w\x: 4
+    if: h\use(w) != 44
+        return: 82
+    return: 7
+end: m
+sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
+return
diff --git a/tests/l2/rr2/unit_rr2_qualified_merge_immutable.lm2 b/tests/l2/rr2/unit_rr2_qualified_merge_immutable.lm2
new file mode 100644
index 0000000000000000000000000000000000000000..1b49152676bf1be681edb2fe08732ab70f6ce50e
--- /dev/null
+++ b/tests/l2/rr2/unit_rr2_qualified_merge_immutable.lm2
@@ -0,0 +1,31 @@
+# RR2c-2b (critical_qualifier_receivers_bug; steps/qualifier-receivers-20261010.md; LMX_blog/q/immutable-root-parent.md):
+# `immutable` over a merge WITHOUT `independent`, in a method -- the value is built under its own profile, proved and
+# sealed before publication, its root keeping its ordinary lexical parent (the copy of the lexical chain), which the
+# qualification neither freezes nor requires to be immutable (docs #qualification).  Its fields read as any merge
+# result's; a later merge over it COPIES it (retention by reference is the parentless branch's): the copy is written,
+# the immutable value stays.  `const: immutable:` is the same value under a protected binding.  Exit 7; 81..84 name
+# the failing read.
+Integer:
+    int: value 0
+end: Integer
+Extra:
+    int: more 2
+end: Extra
+fn: m () int
+    b: immutable: merge(Integer  int: value 7)
+    if: b\value != 7
+        return: 81
+    c: merge(b; Extra)
+    c\value: 8
+    if: c\value * 10 + c\more != 82 || b\value != 7
+        return: 82
+    d: immutable: merge(Integer; (int: value 9))
+    if: d\value != 9
+        return: 83
+    e: const: immutable: merge(Integer  int: value 4)
+    if: e\value != 4
+        return: 84
+    return: 7
+end: m
+sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
+return
diff --git a/tests/l2/rr2/unit_rr2_qualified_merge_root.lm2 b/tests/l2/rr2/unit_rr2_qualified_merge_root.lm2
new file mode 100644
index 0000000000000000000000000000000000000000..4adde85b35118c02d69c211a567e12907dcb5438
--- /dev/null
+++ b/tests/l2/rr2/unit_rr2_qualified_merge_root.lm2
@@ -0,0 +1,29 @@
+# RR2d (critical_qualifier_receivers_bug; steps/qualifier-receivers-20261010.md): the qualifier chain over a merge AT THE
+# ROOT, whose retained graph a WalkRoot row runs: the walk's merge PRIM for a qualified merge is its own entry
+# (lmx_walk_merge_qualified_map), carrying the qualifier bits, the result's leaf slots, the opaque types and the roles --
+# the native emission's steps at run time; the full chain, `immutable` alone (under the root's lexical parent) and
+# `const` alone, each read; a later merge over the independent branch retains it, over the parented one copies it.
+# (A typed operand at the root is still a located limit, unit_rr2_merge_op_typed_root_limit.)  Exit 7; 81..84 name
+# the failing read.
+Integer:
+    int: value 7
+end: Integer
+Extra:
+    int: more 2
+end: Extra
+a: independent: const: immutable: merge(Integer)
+b: immutable: merge(Integer; Extra)
+c: const: merge(Extra)
+d: merge(a; Extra)
+e: merge(b; Extra)
+int: code 7
+if: a\value != 7
+    code: 81
+if: b\value * 10 + b\more != 72 || c\more != 2
+    code: 82
+if: d\value * 10 + d\more != 72
+    code: 83
+if: e\value * 10 + e\more != 72
+    code: 84
+sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
+return
