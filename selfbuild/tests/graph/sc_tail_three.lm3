# Entry Main: three fields, three items: the tail `1 2 3` of the book supplies x, y, z in that order. observed
# 123.
@: result 0
int: observed 0
D:
    return:
        int: x
        int: y
        int: z
    end: return
    C:
        return: 1 2 3
    end: C
end: D
---
Main:
    node\result := D\C()
    node\observed := node\result\x * 100 + node\result\y * 10 + node\result\z
