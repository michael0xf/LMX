# FABLE-L2-R0-WRITE-GUARD-DESIGN-20260921-111, step M0.  THE CONTROL, AND A RECORDED GAP.
#
# The same shape on an ORDINARY, MUTABLE named Structure is NOT refused: the rule is about the
# permanent store, not about named Structures.  What happens instead is a gap of its own, recorded
# here as debt: the translator has no lowering for a named Structure's path inside `@` and writes
# `@ A\e` into the generated L1 as raw text, which the C compiler then rejects ('A' undeclared).
# THE DAY THAT LOWERING IS WRITTEN this row goes red -- on purpose: whoever writes it must look at
# the rule above first, because the same lowering would hand out a writable address into R0.
A:
    size_t: e 7U
end: A

fn: pokez (@: size_t p) int
    \p: 9U
    return: 0
end: pokez
fn: main () int
    pokez(@: A\e)
    return: 0
end: main
