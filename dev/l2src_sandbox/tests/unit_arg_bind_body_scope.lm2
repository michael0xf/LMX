# D-79 (author): a bare assignment does not create a field of the body it sits in -- nor of any body (bafca4c: an
# assignment is not a declaration); only a declaration makes a field.  CORE.md §3.
# - scoped(3, 1): `x: 7` inside `if` writes the argument's own value, the parameter -- no field.  inner is 7, and
#   after the body x is still that parameter: 7.  77.
# - nested(3): `int: y` is the declaration that makes y a field: it takes the argument's 3 into y's working value
#   (7b-2), and `y: y + 1` makes it 4.  Inside the if `y: y + 10` writes that same field, so in2 is 14 and y after
#   the body is 14.  1414.
# Success is 7 when both hold.
fn: scoped (int: x; int: c) int
    int: inner 0
    if: c != 0
        x: 7
        inner: x
    return: inner * 10 + x
end: scoped

fn: nested (int: y) int
    int: in2 0
    int: y
    y: y + 1
    if: y > 0
        y: y + 10
        in2: y
    return: in2 * 100 + y
end: nested

fn: probe () int
    int: a 0
    int: b 0
    int: r 0
    a: scoped(3, 1)
    b: nested(3)
    if: a = 77
        r: r + 3
    if: b = 1414
        r: r + 4
    return: r
end: probe

sendMessage: exit(exit_code: probe(); stdout: ""; stderr: "")
return
