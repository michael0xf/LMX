@: S (int: x 7; int: x 9; int: `[0]x` 11)
@: Alias S
int: literal S \ `[0]x`
int: first S\[0]x
int: second S\[1]x
S\`[0]x` := 31
S\[1]x := 29
int: literal_after Alias\`[0]x`
int: first_after Alias\[0]x
int: second_after Alias\[1]x
@: Weird (int: `a\b` 4; int: `a\b` 6; int: `[0]a\b` 8)
int: quoted_first Weird\[0]`a\b`
int: quoted_second Weird\[1]`a\b`
int: quoted_literal Weird\`[0]a\b`
Weird\[1]`a\b`:=16
int: quoted_after Weird\[1]`a\b`
