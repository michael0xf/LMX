Need: (int: x; int: sentinel)
Have: (int: sentinel; int: x)
Box: ([]: (@: Need) values 2)
fn: work () int
    int: Need 91
    if: 1 = 1
        Have\sentinel: 17
        Box\values[1]: Have
        []: selected Box\values
        selected[1]\x: 19
        @: address int @ selected[1]\x
        \address: 43
        if: selected[1]\x != 43 || Have\x != 43 || Have\sentinel != 17 || \address != 43 || Need != 91
            return: 81
        end: if
    end: if
    return: 7
end: work
sendMessage: exit(exit_code: work(); stdout: ""; stderr: "")
return
