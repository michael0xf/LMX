# Each traversal applies the receiver fn anew in its own initially clean namespace (the author 2026-11-09): the graph
# keeps the declaration as written, and the Structure named mark -- with its own data copied from the written one --
# exists only in the traversal that created it. Run twice, the second run's mark counts from the written 0 again.
# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: last 0
        int: pair 0
)
@: shared data[0]
fn: mark () int (int: calls 0)
    data\calls := data\calls + 1
    return: data\calls
end: mark
fn: twice () int
    int: first mark()
    int: second mark()
    return: first * 10 + second
end: twice
int: last 0
int: pair 0
last := mark()
pair := twice()

sub: main ()
    shared\Observed\last := last
    shared\Observed\pair := pair
main()
