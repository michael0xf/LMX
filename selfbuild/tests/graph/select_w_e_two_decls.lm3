# book #selection-examples: W fits one declaration, E another: ambiguity without priority (the book, #declaration-selection).
(
    Observed:
        int: seen 0
)
@: Model (int: a 0; int: b 0)
fn: f (@: s Model) int
    @: shared node[0]
    shared\Observed\seen := 1
    return: 1
fn: f (int: a; int: b) int
    @: shared node[0]
    shared\Observed\seen := 2
    return: 2
sub: main () (
    S(int: a 1; int: b 2)
)
    f(S)
main()
