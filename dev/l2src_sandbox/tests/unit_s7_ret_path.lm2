# return: h\p is a trailer of three fields, not a Structure name.
# A named Structure return stays a name. This path is refused located.

Plain:
    size_t: toString 0U
end: Plain

Equatable:
    size_t: equals 0U
end: Equatable

Holder:
    Plain: p
end: Holder

fn: pick (Holder: h) Equatable
return: h\p

fn: go (Holder: h) int
return: 4
