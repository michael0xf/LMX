        @: l0 (("ifdef CUTE_SOUND_IMPLEMENTATION";"ifndef CUTE_SOUND_IMPLEMENTATION_ONCE");("Function-like macro has no independent C symbol; role: runtime_operation.";"Cute sound uses a process-global current mixer context. Owner serialization and audio callback lifetime are required; sharing immutable package definitions does not create independent native mixer state.";"No public declaration outside implementation/disabled-example region was found.");("LMX::cute_sound");("Function-like macro has no independent C symbol; role: declaration_annotation.";"Cute sound uses a process-global current mixer context. Owner serialization and audio callback lifetime are required; sharing immutable package definitions does not create independent native mixer state.";"No public declaration outside implementation/disabled-example region was found.");("ifdef CUTE_SOUND_IMPLEMENTATION";"ifndef CUTE_SOUND_IMPLEMENTATION_ONCE";"if !defined(CUTE_SOUND_ALLOC)");("ifdef CUTE_SOUND_IMPLEMENTATION";"ifndef CUTE_SOUND_IMPLEMENTATION_ONCE";"if !defined(CUTE_SOUND_FREE)");("ifdef CUTE_SOUND_IMPLEMENTATION";"ifndef CUTE_SOUND_IMPLEMENTATION_ONCE";"else // Scalar mode as fallback.");("Static function in implementation portion, not a linked export.";"Cute sound uses a process-global current mixer context. Owner serialization and audio callback lifetime are required; sharing immutable package definitions does not create independent native mixer state.";"No public declaration outside implementation/disabled-example region was found.");("if !defined(CUTE_SOUND_H)");("Cute sound uses a process-global current mixer context. Owner serialization and audio callback lifetime are required; sharing immutable package definitions does not create independent native mixer state.");("Cute sound uses a process-global current mixer context. Owner serialization and audio callback lifetime are required; sharing immutable package definitions does not create independent native mixer state.";"No public declaration outside implementation/disabled-example region was found.");("Static function in implementation portion, not a linked export.";"Cute sound uses a process-global current mixer context. Owner serialization and audio callback lifetime are required; sharing immutable package definitions does not create independent native mixer state.");("if !defined(CUTE_SOUND_H)";"ifdef STB_VORBIS_INCLUDE_STB_VORBIS_H");("The selected scalar WAV + SDL3 mixer profile has no stb_vorbis OGG implementation and no SDL2 RWops adapter. The source declarations remain separate optional contracts.";"Cute sound uses a process-global current mixer context. Owner serialization and audio callback lifetime are required; sharing immutable package definitions does not create independent native mixer state.");("ifdef CUTE_SOUND_IMPLEMENTATION";"ifndef CUTE_SOUND_IMPLEMENTATION_ONCE";"ifdef STB_VORBIS_INCLUDE_STB_VORBIS_H");("if !defined(CUTE_SOUND_H)";"if defined(SDL_rwops_h_) && defined(CUTE_SOUND_SDL_RWOPS)";"ifdef STB_VORBIS_INCLUDE_STB_VORBIS_H");("ifdef CUTE_SOUND_IMPLEMENTATION";"ifndef CUTE_SOUND_IMPLEMENTATION_ONCE";"ifdef STB_VORBIS_INCLUDE_STB_VORBIS_H";"if defined(SDL_rwops_h_) && defined(CUTE_SOUND_SDL_RWOPS)");("if !defined(CUTE_SOUND_H)";"if defined(SDL_rwops_h_) && defined(CUTE_SOUND_SDL_RWOPS)");("ifdef CUTE_SOUND_IMPLEMENTATION";"ifndef CUTE_SOUND_IMPLEMENTATION_ONCE";"if defined(SDL_rwops_h_) && defined(CUTE_SOUND_SDL_RWOPS)");("ifdef CUTE_SOUND_IMPLEMENTATION";"ifndef CUTE_SOUND_IMPLEMENTATION_ONCE";"if !defined(CUTE_SOUND_SCALAR_MODE) && defined(__ARM_NEON) || defined(__ARM_NEON__)");("Cute sound uses a process-global current mixer context. Owner serialization and audio callback lifetime are required; sharing immutable package definitions does not create independent native mixer state.";"Callback parameter needs actor-owned trampoline/lifetime and exception translation.");("Callback type/slot, not an exported callable.";"Cute sound uses a process-global current mixer context. Owner serialization and audio callback lifetime are required; sharing immutable package definitions does not create independent native mixer state."))
