# CODEX-AUTHOR-OS-COMMON-PIPELINE-20261023T013324Z: a root vertical call above the declaration. `os_bump:` with
# its argument below calls the selected os branch's os_bump, as root_vertical_above_unit.lm2 calls the unit's.
# Entry count() + 4: 7 for win, 8 for default.
int: hits 0
os_bump:
    3
os:
    win:
        fn: os_bump (int: v) int
            node\hits: node\hits + v
            return: 0
        end: os_bump
    default:
        fn: os_bump (int: v) int
            node\hits: node\hits + v + 1
            return: 0
        end: os_bump
end: os
fn: count () int
    return: node\hits
end: count
sendMessage: exit(exit_code: count() + 4; stdout: ""; stderr: "")
return
