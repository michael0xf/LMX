--- a/src/l2src/l2trans.lm1
+++ b/src/l2src/l2trans.lm1
@@ -39819,0 +39820,31 @@
+    @: LmP0Text symbol
+    LmP0Text: cplace
+    # The ordinary C door also names physical C storage. Keep that location
+    # opaque: a C symbol is not an invented L2 local, int or void* cell. The
+    # C compiler remains responsible for an undeclared/non-lvalue macro or
+    # the actual external type; no header/name allowlist admits the symbol.
+    if: out = 0
+        return: 2
+    if: span != 0 && span\values != 0 && span\node != 0 && span\node\kind = c.LM_P0_NODE_STRUCTURE
+        if: span\value_n != 1
+            return: 2
+        return: l2_address_span(span\values, mi, out)
+    if: span != 0 && span\count = 1 && span\node != 0 && span\node\kind = c.LM_P0_NODE_ATOM && span\node\as != 0
+        symbol: span\node\as\atom
+        if: l2_c_stmt_door(symbol) != 0
+            cplace.data: symbol\data + 2U
+            cplace.length: symbol\length - 2U
+            if: l2_ident_word(@ cplace) = 0
+                return: 1
+            # A known callable is a value, not a reference-holding C object.
+            if: l2_predef_has_function(@ cplace) != 0
+                return: 1
+            memset(out, 0, c.sizeof(c.L2Address))
+            out\kind: 9
+            out\index: -1
+            out\type: -1
+            out\model: -1
+            out\target: span\first
+            out\target_count: 1
+            return: 0
+    ---
@@ -41010,0 +41042,2 @@
+    @: LmP0Field cplace
+    @: LmP0Text symbol
@@ -41014,0 +41048,10 @@
+    if: address\kind = 9
+        cplace: l2_next_active(address\target)
+        if: cplace = 0 || cplace\value = 0 || cplace\value\as = 0
+            return: 1
+        symbol: cplace\value\as\atom
+        if: symbol = 0 || symbol\length < 3U
+            return: 1
+        # This is the selected physical C symbol, not a value temporary.
+        # Its type stays opaque until the ordinary explicit C ABI boundary.
+        return: l2_tx_wrapn(dest, "(@ ", symbol\data + 2U, symbol\length - 2U, ")")
