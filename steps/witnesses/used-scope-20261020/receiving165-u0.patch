+# Project the receiving role of the selected place,not its spelling. Grouping
+# and an explicit address borrow their already prepared operand. The complete
+# path verdict selects a terminal own row at arbitrary depth; a refused path
+# is never retried as a bare name. This declaration fact does not claim that
+# aliases or arbitrary opaque results have a statically known mail envelope.
+fn: l2_value_letter_span (@: L2ValueSpan value; int: mi; @@: L2ValueSpan letter) int
+    @: L2Path selected
+    @: L2PathStep step
+    int: status
+    int: candidate -1
+    if: letter = 0 || value = 0 || value\grammar = 0
+        return: l2_error_fatal(l2_src, l2_here_node, "internal: a letter query has no prepared value")
+    \letter: 0
+    if: value\node = 0 || value\count < 1
+        return: 0
+    if: value\values != 0 && value\value_n = 1 && (value\grammar = 3 || value\node\kind = c.LM_P0_NODE_STRUCTURE)
+        return: l2_value_letter_span(value\values, mi, letter)
+    if: value\operand != 0 && value\node\kind = c.LM_P0_NODE_ATOM && value\node\as != 0 && l2_text_eq(value\node\as\atom, "@") != 0
+        return: l2_value_letter_span(value\operand, mi, letter)
+    if: l2_frame_head(value\node, "@") != 0 && value\values != 0 && value\value_n = 1
+        return: l2_value_letter_span(value\values, mi, letter)
+    status: l2_value_span_path(value, mi, @ selected)
+    if: status = 3
+        return: l2_alloc_or(l2_src, value\node, "cannot project a letter place")
+    if: selected = 0
+        return: 0
+    if: status != 0 || selected\fail_why != 0
+        return: l2_path_seg_refusal_at(l2_src, l2_path_fail_node(selected, value\first), (selected\fail_why))
+    candidate: selected\oi
+    if: selected\n > 0
+        step: selected\steps + (selected\n - 1)
+        candidate: step\own
+    if: l2_own_is_letter(candidate) != 0
+        \letter: value
+return: 0
+
+# Pointer reception recognises zero on the same owned leaf as typing and
+# evaluation. It never peels raw fields or reinterprets an expression's head.
+fn: l2_value_null_literal (@: L2ValueSpan value) int
+    int: negative
+    int: unsigned_literal
+    size_t: magnitude
+    if: value = 0 || value\grammar = 0 || value\node = 0 || value\count < 1
+        return: 0
+    if: value\values != 0 && value\value_n = 1 && (value\grammar = 3 || value\node\kind = c.LM_P0_NODE_STRUCTURE)
+        return: l2_value_null_literal(value\values)
+    if: value\count != 1 || value\node\kind != c.LM_P0_NODE_ATOM || value\node\as = 0
+        return: 0
+return: (cast: (int) (l2_rw_num_lit(value\node\as\atom, @ negative, @ magnitude, @ unsigned_literal) != 0 && magnitude = 0U))
+
