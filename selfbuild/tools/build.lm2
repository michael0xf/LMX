# Source environments are ordinary compiler metadata. The L2 producer owns
# the occurrence/lifetime algorithm; these are its existing allocator hooks.
fn: decl_l2_consumer_uses (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/l2_application.h.lm1\"\n\nprototype:\n    fn: lm_compiler_source_save (@: L2SourceSite saved) int\n    fn: lm_compiler_bound_alloc (size_t: count; size_t: width) @: void\n    fn: lm_compiler_xfree (@: void memory) int\n    fn: lm_compiler_tx_cat (@: L2Tx out; const: @(char text)) int\n    fn: lm_compiler_source_plan_numbers (@: L2Tx out; const: @(char tag); int: a; int: b; int: d; int: e; int: f; int: g) int\n    fn: lm_compiler_use_scope_level_at (const: @(L2UseScope scope); int: level) int\n    fn: lm_compiler_tx_local (@: L2Tx out; @: char data; size_t: capacity) @: L2Tx\n    fn: lm_compiler_occ_expr (int: method; const: @(char unit); @: L2Tx out) int\n    fn: lm_compiler_emit_graph_holder (@: L2GraphPlace place; const: @(char cursor); const: @(char indent)) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_l2_consumer_uses

# Compiler-owned declarations, printed as ordinary L1 text by L3.
# No source file is copied or read by the generator at execution time.
fn: decl_l2_application (@: f c.FILE) int
    if: c.fputs("predef: \"l1src/p0.h.lm1\"\n\n# Translation-owned contracts. These records are not runtime graph objects.\n# A constructor has one ordinary operand contract; no Array rank/depth table.\nstruct: L2TypeContract\n    int: kind\n    int: depth\n    @: LmP0Text word\n    @: L2TypeContract operand\n    @: L2TypeContract allocated_next\nend: L2TypeContract\n\n# A receiver may derive this contract from an application. Name visibility is\n# resolved at the source position, never cached from allocated storage.\nstruct: L2Declaration\n    @: LmP0Node source\n    @: L2TypeContract contract\n    @: LmP0Text name\n    @: LmP0Field candidate\n    int: candidate_count\n    # An explicit type/value receiver nested in a repeated reference write\n    # validates its value before the original place contract does.\n    @: L2TypeContract asserted_contract\n    @: LmP0Text extent\n    # Translator-only atom view of the receiving name. Candidate-free carry\n    # reads the prior binding by name, independent of receiver spelling.\n    LmP0NodeAs: carry_as\n    LmP0Node: carry_node\n    LmP0Field: carry_field\n    @: L2Declaration allocated_next\nend: L2Declaration\n\n# A later source operation may write an already declared field. This is a\n# translator-only association: the runtime graph retains the source operation,\n# while the field still has exactly one physical cell.\nstruct: L2OwnReuse\n    @: LmP0Node source\n    int: method\n    int: own\n    @: L2OwnReuse allocated_next\nend: L2OwnReuse\n\n# A field projected from either existing named or composed compiler metadata.\n# This record has no runtime representation and contains no binding identity.\nstruct: L2SchemaField\n    @: LmP0Text name\n    @: LmP0Text type_word\n    int: kind\n    int: model\n", f) < 0
        return: 1
    if: c.fputs("    # A reference's declared structural pointee, independent of model's\n    # machine pointer ABI and of the current/null cell value. Source-owned\n    # declaration metadata resolves this once; sealed consumers only read it.\n    int: pointee\nend: L2SchemaField\n\n# Translation-only resolved correspondence. The physical field and its two\n# contracts survive the source planning fixed point. No runtime permission\n# or guessed constructor is represented by one of these records.\nstruct: L2D105Step\n    L2SchemaField: requirement\n    L2SchemaField: actual\n    int: selector\n    int: physical\n    int: slot\n    int: status\n    int: child_pair\nend: L2D105Step\n\nstruct: L2D105StepDynamicArray\n    size_t: size\n    size_t: capacity\n    @: L2D105Step data\nend: L2D105StepDynamicArray\n\nstruct: L2D105Plan\n    int: candidate\n    int: requirement\n    int: width\n    int: physical_width\n    int: source_width\n    int: ready\n    L2D105StepDynamicArray: steps\n    @: L2D105Plan next\nend: L2D105Plan\n\n# One operation's reachable PAIRS, not another source/value graph. Rows\n# borrow the already resolved typed plans. Both backend representations\n# consume this same closure; no backend selects child models by name.\nstruct: L2D105CatalogRow\n    @: L2D105Plan plan\n    @: L2D105CatalogRow next\nend: L2D105CatalogRow\n\nstruct: L2D105Catalog\n    size_t: count\n    size_t: extent\n    int: ready\n    @: L2D105CatalogRow first\n    @: L2D105CatalogRow last\n    # Declared requirement closure also includes equal-layout references.\n    # These rows borrow identity plans, not candidate-layout evidence.\n    @: L2D105CatalogRow required_first\n    @: L2D105CatalogRow required_last\n    size_t: reference_count\nend: L2D105Catalog\n\n", f) < 0
        return: 1
    if: c.fputs("# Translation-only source projection, made before candidate evaluation. schema\n# names complete candidate metadata, not the required receiving model. layout\n# is absent unless a real descriptor producer establishes that schema. A held\n# own/input/result uses the existing D105 source place. Tagged schema handles\n# are decoded only by the shared schema helpers; -1 alone means absent. A handle\n# at or below -1500000000 is one method occurrence's own fields, not a merge tag.\nstruct: L2ReferenceSource\n    int: schema\n    int: layout\n    int: method\n    int: place\n    # Identity of the CURRENT source operand run, independent of the helper\n    # that last changed the diagnostic/visibility cursor. Compiler-only;\n    # neither a source graph copy nor runtime provenance is stored here.\n    const: @: LmP0Node origin\n    int: origin_count\n    int: origin_method\n    # Borrow the existing current resolver fact, never a temporary path or\n    # an ancestor verdict. The fact's bound allocation lives to translation\n    # close and retains the whole selected namespace/contract route.\n    # A whole binding may borrow its zero-step source_use2 fact here too;\n    # that fact remains stage0 and is never an empty field-path proof.\n    const: @: L2PathFact path\nend: L2ReferenceSource\n\n# One translation-owned source verdict,embedded in the existing grammar\n# owner. Borrowed spans/arguments share it,not a copied mutable cache flag.\n# Nothing here becomes a program graph field or runtime binding record.\nstruct: L2ValueSource\n    L2ReferenceSource: result\n    # 0 not queried,1 complete(including unknown),-1 failed.\n    int: status\n    int: method\n    size_t: revision\n    size_t: source_revision\n    int: signature\n    int: held\n    int: bound\n", f) < 0
        return: 1
    if: c.fputs("end: L2ValueSource\n\n# The text the emitter builds (FIXED-BLOCKS-AUDIT, the expression text): `data` holds `len` bytes and a NUL in\n# `cap` bytes -- its owner's buffer while that suffices, then storage of the translation (l2trans.lm1, l2_tx_*).\nstruct: L2Tx\n    @: char data\n    size_t: len\n    size_t: cap\nend: L2Tx\n\n# A bounded source operand view. All source pointers are borrowed; no AST or\n# runtime graph is copied. The index is either a literal, an existing joined\n# own-name projection, or the original P0 index expression.\n# One borrowed operand or operator in a bounded expression. No joined text or\n# replacement P0 node is retained: consumers resolve the original source span.\nstruct: L2ValueSpan\n    @: LmP0Field first\n    int: count\n    @: LmP0Node node\n    # Expression-owned preparation. Borrowed span copies retain these\n    # pointers but never release them independently. One recursive release\n    # of the root token list owns the grammar and prefix operand.\n    @: L2Path prepared\n    @: L2ValueSpan operand\n    # An embedded value expression owns its ordinary operand list,too.\n    # Direct CHECK/type/native/retained expression consumers borrow it.\n    # Receiving/conversion call plans remain a separate migration debt.\n    @: L2ValueSpan values\n    int: value_n\n    # A general primary keeps its complete written body without making it\n    # a numeric expression. The head's contract selects its roles later.\n    @: L2PrimaryBody primary\n    # 0 borrowed/unprepared,1 held path grammar,2 authoritative primary,\n    # 3 owned expression-list view (e.g.an INDEX operand). Its first node\n    # does not turn the entire expression into that node's unary role.\n    int: grammar\nend: L2ValueSpan\n\nstruct: L2PrimaryBody\n", f) < 0
        return: 1
    if: c.fputs("    @: LmP0Node source\n    @: L2ValueSpan body\n    int: body_n\n    # A container's own trailer is distinct from the Frame's trailer.\n    # Anonymous Structures and Frame bodies retain it without inventing\n    # another P0 node or suppressing its fields after a head-role choice.\n    @: L2ValueSpan body_trailer\n    int: body_trailer_n\n    @: L2ValueSpan trailer\n    int: trailer_n\n    L2ValueSource: source_value\nend: L2PrimaryBody\n\n# A formal-ordered borrowing projection of one written actual. The value\n# keeps the already owned grammar and nested path verdicts; the record owns\n# no P0 fields and no value children. written selects lexical evaluation\n# order,independent of formal coordinate. structured keeps a named body\n# which is not one expression as its written structural value.\nstruct: L2ApplicationActual\n    L2ValueSpan: value\n    @: L2ValueSpan written\n    @: LmP0Node wrapper\n    int: rank\n    int: structured\nend: L2ApplicationActual\n\n# This short-lived semantic projection borrows its complete source owner.\n# Releasing it frees only actuals,never the owner's recursive grammar.\nstruct: L2ApplicationActuals\n    @: L2ApplicationActual actuals\n    int: count\n    int: written_count\nend: L2ApplicationActuals\n\n# Persistent translation owner for one source occurrence in one method's\n# namespace. Descendant call sites own grammar copies,not borrowed pointers\n# into path INDEX lists which a semantic view can replace. All copies use\n# the ordinary grammar clone;no site reparses after a held failure.\nstruct: L2ApplicationSite\n    const: @: LmP0Node source\n    # -1 owns grammar before a method namespace exists. It never stands\n    # in for a resolved method or supplies a semantic binding fallback.\n    int: method\n", f) < 0
        return: 1
    if: c.fputs("    L2ValueSpan: value\n    L2ApplicationActuals: arguments\n    int: signature\n    int: held\n    int: bound\n    @: L2ApplicationSite allocated_next\nend: L2ApplicationSite\n\n# Compiler-only receiving result. The expression and its complete path\n# verdicts stay with their ordinary owner; all projections borrow them.\n# converter selects a signature/current occurrence,not a frozen code value.\nstruct: L2NumericReceive\n    @: L2ValueSpan value\n    @: LmP0Node literal\n    int: kind\n    int: source_ft\n    int: target_ft\n    int: converter\nend: L2NumericReceive\n\n# One transient decision for a written `call:` operand. The current supported\n# static route is recorded without claiming that it proves a mutable binding's\n# future body; that provenance remains an M2 gate. `ni` selects the procedure\n# and hidden-input contract; `target_ns` selects a unit slot, or `oi` an own\n# place. A compatible layout or field type alone is not body identity. No\n# source text is joined and this record is never part of a runtime Lmx graph.\nstruct: L2StructCallPlan\n    L2ValueSpan: operand\n    # N4 (LMX_semantics.ru.md #method-parts): the data operand of `call: code data` (count 0 for the one-operand\n    # call), the operand shape l2_struct_call_operands gives, and the field a refused shape names.\n    L2ValueSpan: data\n    int: shape\n    @: LmP0Field extra\n    # The executable body and the place holding the current value are\n    # independent. A named unit slot may later hold another body.\n    int: ni\n    int: target_ns\n    int: oi\n    int: result\n    int: inert\nend: L2StructCallPlan\n\n# A CHECK-time source-site certificate for a written call. It is translator\n# metadata, not a runtime graph field: body selects the executable occurrence,\n", f) < 0
        return: 1
    if: c.fputs("# while target_ns/oi select the physical slot whose current value is called.\nstruct: L2CallBodySite\n    @: LmP0Node source\n    int: method\n    int: body\n    int: target_ns\n    int: oi\n    int: inert\n    # N4 `call: code data`: split is 1 and data_node is the data operand. data_place is its analysis place\n    # (l2_m2_root_own), data_target_ns or data_oi the unit slot or own place holding it, and data_layout the named\n    # Structure whose layout it keeps (l2_m2_fixed). prow is the place row the kind-9 check reserves, and can_fail is\n    # 1 when that row can refuse the call at run time.\n    int: split\n    @: LmP0Node data_node\n    int: data_place\n    int: data_target_ns\n    int: data_oi\n    int: data_layout\n    int: prow\n    int: can_fail\nend: L2CallBodySite\n\n# One step of a resolved written path (the author, 2026-10-18: one general algorithm for every path -- the check,\n# native emission and the walker, references and indices included).  The resolver (l2_path_resolve) records the\n# semantic coordinates of the field a segment selects in the host the previous step reached; a backend derives the\n# physical address from them (l2_nsf_slot, l2_graph_field_child, the graph places) and never chooses a field, a\n# type or an admission map again.  Translation-only; no runtime representation.\nstruct: L2PathStep\n    # 1 a field of a Structure (row: its NSF row); 2 a slot of a merge result (row: the slot, nsrow: the contributing\n    # NSF row or -1); 3 an own-declared field of a method, a control body or a part (own); 4 a control body (row: the\n    # body index); 5 a part of a four-part fn (row: the part, ent: the method); 6 a field of the lexical space `node`\n", f) < 0
        return: 1
    if: c.fputs("    # names (row: its ordinal there; own or ns the selected declaration, formal the host formal's index)\n    int: locus\n    # the selected field's value kind as the segment resolvers give it (0 size_t, 1 char, 2 nested Structure,\n    # 3 Structure reference, 4 callable, 5/6 Array, 7 int, 8 unsigned, 9 ulong, 10 reference field, 11); 2 for a\n    # body, 12 for a part\n    int: kind\n    int: row\n    int: nsrow\n    int: own\n    int: ns\n    int: formal\n    # locus 6: the host method and the scope the selected declaration was read in (l2_node_seg_resolve), for the\n    # backend's projection of its slot (l2_source_field_project, a host formal's l2_madc_formal_slot)\n    int: node_host\n    @: LmP0Node node_scope\n    # the segment resolver's ent: the Structure of kind 2/3, the method of kind 4/12, the pointer code of kind 10\n    int: ent\n    # kind 10 continued: the pointee the next segment is resolved in (a schema handle), else -1\n    int: pointee\n    # the host the segment was resolved in -- the Structure, the merge result, the method's own level, the control\n    # body, the part scope -- as the walk had them before this step\n    int: host_ns\n    int: host_res\n    int: host_bm\n    int: host_bh\n    int: host_part\n    # the admission map in force when this step is read (D-105): a schema handle or -1; the context of the receiving\n    # model (l2_reference_model_context; -2 for the map a host formal named after `node` carries)\n    int: view_model\n    int: model_context\n    # The prepared step whose declaration supplied the current contract;\n    # -1 is the selected root. Indexing carries that origin, not the parent\n    # of the candidate element. Translation metadata, never a graph field.\n    int: model_step\n", f) < 0
        return: 1
    if: c.fputs("    # The selected source host's args child is the outgoing requirement.\n    # -1 denotes no header anchor. The current lexical context's parent is\n    # that actual host code, also when this context was copied by a factory.\n    int: model_input\n    # kind 10: the pointer code of the reference cell (POINTER_BASE + code is its storage type)\n    int: cell_ft\n    # A typed machine INDEX's exact address contract BEFORE the step,\n    # including C qualification. -1 means no machine-address verdict.\n    # Its value after the step remains elem_ty. Compiler metadata only.\n    int: address_ft\n    # Write qualification of that selected machine cell. Obtaining a\n    # qualified address remains legal; this is not graph eternity.\n    int: cell_const\n    # an occurrence selector `[N]name` written at this segment, -1 for none (K01: refused before declarations)\n    int: segocc\n    # the segment's text in the path text, and its atom when the path was written as atoms (a located refusal)\n    size_t: off\n    size_t: len\n    @: LmP0Node node\n    # locus 7, an INDEX step (R5-3b): the index expression, kept as its span (never flattened into text); the Array\n    # contract the step consumes (its level: the value before it); the element's type code and model\n    L2ValueSpan: index\n    @: L2TypeContract level\n    int: elem_ty\n    int: elem_model\nend: L2PathStep\n\n# A resolved written path: its selected root and its steps. Filled by l2_path_resolve from the\n# path text (borrowed for the record's life) or by the run adapter from the atoms (a text of its own); read by every\n# consumer -- the check pass, admission and qualification, initializer typing, the address route, the native emitter\n", f) < 0
        return: 1
    if: c.fputs("# and the walker -- none of which splits the text or resolves a segment again.  Translation-only; the steps are\n# released by l2_path_release.\n#\n# THE RECORD'S CONTRACT (the author, 2026-10-19: counters, types and maps stay consistent after every operation on the\n# record).  Two sets of fields.  The VIEW -- text, length, owned, steps, cap, n, names, indexed, run_count, names_run,\n# flat -- is written as one by an adapter (l2_path_steps_text, l2_path_steps_run, l2_path_steps_all), cut as one by\n# l2_path_names_only (the steps before the first index step; n, names, indexed, run_count, the text length, flat\n# together) and cleared as one by l2_path_release; no count of the view is stored twice (the native emitter walks the\n# name steps, names, and the place emitter the index steps after them, both from the record).  The VERDICT -- the root (ni, res, oi, root, fi), each step's resolution (kind, ent, locus, row,\n# the hosts, the maps view_model/model_context, the pointee and cell_ft of a reference crossed, an index step's level\n# and element), the leaf (leaf_kind, leaf_mi, leaf_model, leaf_ty, array_leaf, leaf_level), ref_follow, in_eternal and\n# a refusal's fail_seg/fail_why -- is written by ONE walk (l2_path_walk, l2_path_walk_steps) of the view as it stands\n# then: a view is cut before its walk, never after (every caller prepares, cuts, walks, reads, releases, in that order),\n# and no consumer derives any of it again from the text (the Array place is a view of this record, l2_array_place_view).\nstruct: L2Path\n    const: @: char text\n    size_t: length\n    # the text is the record's own (the run adapter joins the names of a path written as atoms)\n    int: owned\n", f) < 0
        return: 1
    if: c.fputs("    # the steps of the record (the resolver walks exactly these, l2_path_walk_steps; the native emitter reads exactly\n    # these, l2_emit_path_resolved): one count for every reader -- a view that cuts the record (l2_path_names_only)\n    # cuts it here, and no second count of segments is stored beside it (R3)\n    int: n\n    # the name steps before the first index step; the index steps; the fields of the written run the atoms adapter\n    # consumed. Adjacent groups are also retained steps;flat marks the FIRST\n    # adjacency so a receiving Array contract can distinguish that shape.\n    int: names\n    int: indexed\n    int: run_count\n    # the fields of the run before its first index step (the root and the name steps): what the operand grammar's\n    # names-only mode returns (l2_rw_path_run_mode reads run_count and this; nothing else re-decides where a run ends)\n    int: names_run\n    # Original run anchor, borrowed from P0. Together with run_count this\n    # identifies the adapter's exact operand without reparsing its spelling.\n    # Text-only/synthetic views have no run anchor. It travels with every\n    # prepared view and fact; it does not mark a query as source consumption.\n    @: LmP0Field source_first\n    @: LmP0Field flat\n    int: ni\n    int: res\n    int: oi\n    # The selected binding's physical place remains valid when its VALUE\n    # is projected to an original namespace/method occurrence (oi becomes\n    # -1 in that value view). Address projection consumes this coordinate,\n    # never reconstructing the binding from the value's name or parent.\n    int: root_own\n    # Declared requirement source of this binding,closed with root_ft and\n    # root_level. A hidden input may borrow its lexical declaration's\n", f) < 0
        return: 1
    if: c.fputs("    # contract even when it only forwards the value and needs no physical\n    # lexical fallback. It never replaces fi/oi or the runtime input value.\n    # -1 means no own declaration (e.g.an explicit formal or namespace).\n    int: root_contract_own\n    # Exact selected binding type,closed with root_level at the common\n    # selection boundary. -2 is not closed;-1 is closed with no L2 cell\n    # type (e.g.a namespace/method/declared C constant). Never a fallback\n    # invitation to consult a changed source type table in a backend.\n    int: root_ft\n    # Root selection is a kind plus an index, not disjoint numeric ranges of one int.\n    # 0: ni/res/oi/fi select an ordinary namespace or binding; 1: node;\n    # 2: root indexes a control body; 3: a method occurrence; 4: a machine local;\n    # 5: an activation-local slot; 6: a declared external constant with no\n    # L2 storage cell. All binding roots retain their selected index.\n    # These are compiler decisions only, never opcodes stored in an Lmx graph.\n    int: root_kind\n    int: root\n    int: fi\n    # The resolver selected this fn args child as the root's required model.\n    # -1 means another already resolved origin. Backends never rediscover it\n    # from formal/type spelling or candidate flow. Translation metadata only.\n    int: model_input\n    # the leaf: the last step's kind; its Structure (kind 2/3) or pointee (kind 10/11) as the model; its method\n    # (kind 4) or pointer code (kind 10/11) as mi -- what l2_path_kind and l2_path_contract answer\n    int: leaf_kind\n    int: leaf_mi\n    int: leaf_model\n    # the leaf's value is an Array (leaf_level its contract): a name whose declaration is one, an element that is one;\n", f) < 0
        return: 1
    if: c.fputs("    # leaf_ty: the value type code of an element leaf (kind 13)\n    int: array_leaf\n    @: L2TypeContract leaf_level\n    int: leaf_ty\n    int: ref_follow\n    # the destination is a cell of a qualified immutable graph (l2_path_in_eternal)\n    int: in_eternal\n    # a refused walk: the segment and why (1 the root, 2 a segment the host has not, 3 a slot with no Structure to go\n    # on through, 4 a malformed segment, 5 an index on a value that is no Array, 6 an element with no value contract)\n    # -- l2_path_seg_refusal / l2_path_seg_refusal_at say it\n    int: fail_seg\n    int: fail_why\n    # Expression-owned value preparation carries its readiness WITH this\n    # shared record,not in copied span views. 0 not walked,1 success,-1\n    # refused. The method identifies this use's explicit source context;\n    # this is transient compiler metadata,not a global binding cache.\n    int: value_status\n    int: value_method\n    # Compiler source-plan revision,not a runtime graph generation. Planning\n    # may change MRS/field maps after CHECK. The next shared projection then\n    # recloses this SAME owned grammar once for the new complete plan.\n    size_t: value_revision\n    L2ValueSource: source_value\n    # The selected root's carried requirement,closed by the same dispatcher.\n    # A language Array contract is not opaque C storage merely because its\n    # physical descriptor has a foreign C spelling.\n    @: L2TypeContract root_level\n    @: L2PathStep steps\n    int: cap\nend: L2Path\n\n# A CHECK-resolved receiving contract of one source value occurrence. This\n# borrows existing method/input/site identities; it is not a prediction of\n# the selected implementation's body or the candidate's physical layout.\n", f) < 0
        return: 1
    if: c.fputs("# A dynamic callable selector belongs to the source fact's method and must\n# later use the existing callable-class closure, never the prototype's body.\nstruct: L2UseReceiver\n    int: method\n    int: key\n    @: LmP0Text input_symbol\n    @: LmP0Text selector_symbol\n    const: @: LmP0Node site\n    @: L2UseReceiver next\nend: L2UseReceiver\n\n# One concrete written call and its actual CHECK environment. This is\n# binding-owned compiler metadata; it borrows the original source occurrence\n# and never substitutes a descriptor body or an ABI witness for that call.\n# The saved site's scopes are released before the binding allocations.\nstruct: L2ConsumerCallUse\n    int: method\n    int: source_method\n    const: @: LmP0Node source\n    int: signature\n    int: formal\n    @: L2SourceSite use_site\n    @: L2ConsumerCallUse next\nend: L2ConsumerCallUse\n\n# One observed result of the common resolver in its actual source context.\n# This is compiler metadata, not a second value graph or a complete Consumer.\n# Receiving roles and propagation are separate consumers of these facts.\nstruct: L2PathFact\n    int: method\n    int: source_method\n    @: LmP0Node source\n    # Canonical input-row address, not its provisional sorted position. Hidden\n    # input insertion may move fi without changing this binding. No character\n    # comparison or source reparse is needed to select its current Consumer.\n    @: LmP0Text input_symbol\n    # A source consumption is recorded by the existing namespace/capture\n    # traversal, not inferred from a later compiler typing query. The saved\n    # source environment borrows the original P0; it is not a binding table.\n    # 0 compiler query,1 written path,2 independently written whole binding\n", f) < 0
        return: 1
    if: c.fputs("    # read. A path's root contributes only its path observation. A whole read\n    # has a resolved root and zero steps; it is NOT a prepared path view or\n    # proof that all fields of its Model are consumed. Receiving roles and\n    # forwarding must propagate actual downstream requirements explicitly.\n    int: source_use\n    # CHECK evidence only: bit 0 compares the reference itself; bit 1\n    # forwards the value to receivers below; bit 2 (value 4): a written call\n    # takes the path as its head (l2_use_invoked). Zero is UNCLASSIFIED, not an\n    # empty Consumer. Bound Consumer equations read this CHECK evidence;\n    # incidental compiler queries never classify an original source use.\n    int: use_roles\n    @: L2UseReceiver receivers\n    @: L2ConsumerCallUse calls\n    # 0: grammar and resolved root only; 1: the common semantic step walk ran.\n    # A root-only record must never be mistaken for an empty successful use.\n    int: stage\n    @: L2SourceSite use_site\n    L2Path: resolved\n    @: L2PathFact next\nend: L2PathFact\n\n# A finite Consumer equation over existing bound ports. These are temporary\n# compiler demands, not another value/source graph or runtime binding table.\n# Aliases union demands without merging their child scopes: repeated edges\n# may check the same place under different nested Consumers independently.\nstruct: L2UsePlanEdge\n    L2PathStep: step\n    int: schema\n    int: whole\n    # The Consumer calls the field this edge selects (a written call's head,\n    # fact use_roles bit 2): its coverage cell asks the value there to take the\n    # call (below SIZE_MAX - 1), not to be entered whole.\n    int: called\n    # Borrowed concrete occurrences from the selected source fact, not a\n", f) < 0
        return: 1
    if: c.fputs("    # reconstructed invocation of the field's declared signature.\n    @: L2ConsumerCallUse calls\n    @: L2UsePlanLevel below\n    @: L2UsePlanEdge next\nend: L2UsePlanEdge\n\nstruct: L2UsePlanLink\n    @: L2UsePlanLevel target\n    @: L2UsePlanLink next\nend: L2UsePlanLink\n\nstruct: L2UsePlanLevel\n    int: method\n    int: key\n    int: schema\n    int: id\n    int: full\n    int: seen\n    @: L2UsePlanEdge edges\n    @: L2UsePlanLink links\n    @: L2UsePlanLevel next\nend: L2UsePlanLevel\n\n# Prepared Consumer scope for one bound port and required schema. Own,\n# formal and hidden inputs share the same equations and physical-cell fold.\nstruct: L2UseScope\n    int: method\n    int: key\n    int: schema\n    int: state\n    int: first\n    int: count\n    int: levels\n    @: L2UseScope next\nend: L2UseScope\n\n# A compact head's original P0 expression and the common adapter's prepared\n# path. Both are translation-owned; deferred checks and both backends borrow\n# them. A use takes an independent grammar view, then resolves that view in\n# its source environment. It never reparses the retained expression to decide\n# its path shape again. No binding or runtime graph object is retained here.\nstruct: L2HeadExpression\n    @: LmP0Node source\n    @: LmP0Document document\n    @: LmP0Structure body\n    # The common adapter's grammar verdict (2 means no path run). Retain it\n    # too: a computed/non-path head must not be parsed again after a miss.\n    int: path_status\n    L2Path: prepared\n    # A non-path head still owns its complete written expression grammar.\n    # A grammar miss is not permission to rebuild it in a later consumer.\n    @: L2ValueSpan values\n    int: value_n\n    @: L2HeadExpression allocated_next\nend: L2HeadExpression\n\n", f) < 0
        return: 1
    if: c.fputs("# A resolved source location, not another binding table. kind selects the\n# existing own/argument/local-slot/machine-local/namespace entry; descriptor\n# distinguishes the actual Structure from a cell holding a reference to it.\n# Kind 6 -- the target as one path -- carries the path's resolved record (`path`; `resolved` = 1): l2_address_target\n# resolves it once, the emitters (l2_emit_address, l2_rw_address) read it, and the consumer that was answered 0 releases\n# the address (l2_address_release) when it is done with it; the scalars stay readable after the release (U7 D4).\n# Declared after L2Path: the record is a member.\nstruct: L2Address\n    # Kind9: an opaque physical C-symbol location borrowed from the prepared\n    # operand. No language value cell or default numeric/pointer type is made.\n    int: kind\n    int: index\n    int: descriptor\n    int: model\n    int: type\n    @: LmP0Field target\n    int: target_count\n    int: immutable\n    L2Path: path\n    int: resolved\n    # Kind8: raw-pointer indexing;path retains every prepared index span and\n    # its consumed type. descriptor marks opaque C member storage. Kind7:\n    # an explicit pointer-cell location. Borrow the complete parsed\n    # receiver,not a cut root/suffix. index is the leaf value type,type the\n    # address type;path retains a resolved receiver path when one was used.\n    L2ValueSpan: operand\n    int: levels\n    int: source_type\nend: L2Address\n\n# One Array place (R5-3b): the Array-place VIEW of a resolved path (l2_array_place_view).  The record's name prefix\n# is the base (`base` its text; `own` the own binding when the base is one name), its index steps the place's steps\n", f) < 0
        return: 1
    if: c.fputs("# (`steps` their number; step k's expression span is read from the record, l2_place_step), its leaf the result --\n# the last level's element type and model, or the Array value itself (the descriptor reference) with no step.\n# `count` is the number of fields of the written run the place consumed.  `said` is the node of a located refusal\n# (an index on no Array, a field after an index, the flat `[i][j]` form).  `expression` is the statement head's\n# parsed tree when the place is a head.  Released by l2_array_place_release.\nstruct: L2ArrayPlace\n    int: own\n    LmP0Text: base\n    int: type\n    int: model\n    @: L2HeadExpression expression\n    int: count\n    int: steps\n    @: LmP0Node said\n    L2Path: path\nend: L2ArrayPlace\n\n# A borrowed source environment for deferred checks and actual call sites.\n# Names still resolve through the existing own/formal rows; this is not a\n# binding table. source_method records the source owner separately when a\n# partial callable borrows its model's body; unrelated offsets are not compared.\n# unevaluated: the site is inside an UNEVALUATED operand (sizeof, C's sizeof),\n# so a check replayed there records no obligation of a call.\nstruct: L2SourceSite\n    int: kind\n    int: method\n    int: current_method\n    int: source_method\n    int: count\n    int: target\n    int: scope_count\n    @@: LmP0Node scopes\n    int: excluded\n    int: visibility\n    size_t: visible_at\n    int: unevaluated\n    @: void site\n    @: LmP0Node source\nend: L2SourceSite\n\n# Translation-only physical child edges, in parent-before-child allocation order.\n# A null parent starts at the selected callable occurrence, never its lexical node.\n# These rows name existing graph places; they allocate no runtime graph objects.\n", f) < 0
        return: 1
    if: c.fputs("struct: L2GraphPlace\n    size_t: id\n    int: method\n    size_t: child\n    @: L2GraphPlace parent\n    @: L2GraphPlace allocated_next\nend: L2GraphPlace\n\n# A field's physical slot, independent of the lexical scope that resolves it.\n# A null holder means the field owner's selected occurrence itself.\nstruct: L2GraphField\n    @: L2GraphPlace holder\n    size_t: child\nend: L2GraphField\n\n# A source container's committed producer, in one construction view. These\n# records borrow P0 identity and disappear with the translation; they are not\n# graph fields, source leaves, primitive wrappers or runtime binding metadata.\nstruct: L2SourceContainer\n    size_t: id\n    int: view_kind\n    int: view_index\n    # Actual callable owner, distinct from a projection site's view index.\n    int: source_mi\n    # Translator-only identity of a part of that occurrence: 0 is the\n    # existing producer, 1 is var, 2 is body. It is not a runtime field.\n    int: part\n    @: LmP0Structure body\n    int: fid\n    int: inert\n    int: root\n    int: width\n    int: temp\n    int: fills\n    int: shell_state\n    @: L2GraphPlace place\n    @: L2SourceField fields\n    @: L2SourceContainer allocated_next\nend: L2SourceContainer\n\n# Original declaration cells of this actual source body, in its construction\n# view. Only compiler planning owns these records; the graph keeps real cells.\nstruct: L2SourceField\n    int: own\n    int: slot\n    # PLACE handle of the existing computed-output operand, preallocated\n    # before any borrow; -1 for a separately written typed declaration cell.\n    int: storage_temp\n    L2GraphField: place\n    @: L2SourceField next\nend: L2SourceField\n\n# PLACE records actual constructor/attachment edges. Temp numbers are private\n", f) < 0
        return: 1
    if: c.fputs("# emission handles; only the resulting ordinary GraphPlace reaches backends.\nstruct: L2ConstructionTemp\n    int: view_kind\n    int: view_index\n    int: index\n    int: parent\n    int: slot\n    int: root\n    @: L2GraphPlace place\n    @: L2ConstructionTemp allocated_next\nend: L2ConstructionTemp\n\n# Exact compiler-state history for source-plan convergence. Never allocated\n# in a program arena or represented by additional fields of an Lmx value.\nstruct: L2SourcePlanState\n    @: char data\n    size_t: length\n    @: L2SourcePlanState next\nend: L2SourcePlanState\n\n# A source expression site's construction in one view (G1): the first written\n# node of its field run and the run's count identify the exact P0 occurrence;\n# the construction view and the selecting method keep each walk of that node\n# apart (a T7 projection, a merge result's body). `temp` is the expression's\n# root node in PLACE and resolves to an ordinary GraphPlace after bind. Only\n# the translator reads these records; the graph keeps no site, name or P0.\n# The receiving operation's compiler-owned contract. Only expression-site\n# role3 owns one; ordinary numeric/expression sites pay no payload cost.\n# Runtime graph operands are the representation, never this record.\nstruct: L2AdmissionPlan\n    int: requirement\n    int: mode\n    int: own\n    int: target_method\n    int: target_key\n    @: LmP0Text target_symbol\n    L2ReferenceSource: source\n    L2D105Catalog: catalog\n    @: L2UseScope scope\nend: L2AdmissionPlan\n\nstruct: L2ExpressionSite\n    int: view_kind\n    int: view_index\n    int: method\n    const: @: LmP0Node node\n    int: count\n    # 0 = complete field run; 1 = source numeric LIT leaf; 2 = numeric binary\n", f) < 0
        return: 1
    if: c.fputs("    # source node. Role 2 uses value_type as the graph-lowering layout:\n    # bit 0 swaps source operands in physical child order, bit 1 means the\n    # root is SUB(LIT 1, inner OP). This is translation-only, not graph data.\n    # A conversion may wrap a leaf in another run.\n    # 3 = exact receiving operation; admission retains its common catalog\n    # and canonical receiving port. No opcode or origin enters the graph.\n    # 4 = exact written CALL/EXEC, not an outer expression or a converter.\n    # Its existing owning GraphPlace is the call-use payload; no new call\n    # graph or runtime source address is introduced by the compiler row.\n    int: role\n    int: value_type\n    @: L2AdmissionPlan admission\n    int: temp\n    # 0 noted; 1 bound to `place`; 2 no owning attachment in its view; 3 two\n    # sibling constructions of one run in one view (refused, never chosen).\n    int: state\n    @: L2GraphPlace place\n    @: L2ExpressionSite allocated_next\nend: L2ExpressionSite\n", f) < 0
        return: 1
    if: c.fputs("\nstruct: L2FrontendScratchChar32\n    []: char buffer 32\nend: L2FrontendScratchChar32\n\nstruct: L2FrontendScratchChar48\n    []: char buffer 48\nend: L2FrontendScratchChar48\n\nstruct: L2FrontendScratchChar64\n    []: char buffer 64\nend: L2FrontendScratchChar64\n\nstruct: L2FrontendScratchChar96\n    []: char buffer 96\nend: L2FrontendScratchChar96\n\nstruct: L2FrontendScratchChar128\n    []: char buffer 128\nend: L2FrontendScratchChar128\n\nstruct: L2FrontendScratchChar160\n    []: char buffer 160\nend: L2FrontendScratchChar160\n\nstruct: L2FrontendScratchChar256\n    []: char buffer 256\nend: L2FrontendScratchChar256\n\nstruct: L2FrontendScratchChar320\n    []: char buffer 320\nend: L2FrontendScratchChar320\n\nstruct: L2FrontendScratchInt1\n    []: int buffer 1\nend: L2FrontendScratchInt1\n", f) < 0
        return: 1
    if: c.fputs("\nstruct: L2FrontendScratchChar192\n    []: char buffer 192\nend: L2FrontendScratchChar192\n\nstruct: L2FrontendScratchChar1024\n    []: char buffer 1024\nend: L2FrontendScratchChar1024\n\nstruct: L2FrontendScratchChar1100\n    []: char buffer 1100\nend: L2FrontendScratchChar1100\n", f) < 0
        return: 1
    if: c.fputs("\nstruct: L2FrontendScratchChar240\n    []: char buffer 240\nend: L2FrontendScratchChar240\n\nstruct: L2FrontendScratchP0FieldPtr4\n    []: @(LmP0Field) buffer 4\nend: L2FrontendScratchP0FieldPtr4\n\nstruct: L2FrontendScratchInt4\n    []: int buffer 4\nend: L2FrontendScratchInt4\n\nstruct: L2FrontendScratchInt42\n    []: int buffer 42\nend: L2FrontendScratchInt42\n\nstruct: L2FrontendScratchP0NodePtr8\n    []: @(LmP0Node) buffer 8\nend: L2FrontendScratchP0NodePtr8\n\nstruct: L2FrontendScratchInt8\n    []: int buffer 8\nend: L2FrontendScratchInt8\n\nstruct: L2FrontendScratchInt2\n    []: int buffer 2\nend: L2FrontendScratchInt2\n\nstruct: L2FrontendScratchChar8\n    []: char buffer 8\nend: L2FrontendScratchChar8\n\nstruct: L2FrontendScratchChar4096\n    []: char buffer 4096\nend: L2FrontendScratchChar4096\n" , f) < 0
        return: 1
    return: 0
end: decl_l2_application

# One native compiler storage owner, printed as ordinary L1 declarations.
# Relative declaration order and literal initializers are preserved; algorithms live in L2.
fn: decl_l2_frontend_state (@: f c.FILE) int
