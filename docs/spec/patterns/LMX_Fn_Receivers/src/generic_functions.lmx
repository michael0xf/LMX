# ОБЩИЕ lambda / partial / uncurry / flip.
# Любое конечное число входов, их полные требования типов и исходный результат.
# Это исходники целевой реализации интеграции. FxKernel — явно перечисленный в KERNEL_REQUIREMENTS.md
# адаптер к существующим анализатору сигнатур и строителю графа, не готовый API.
# Операции не компилируют себя автоматически и не переиспользуют native от
# прототипа с другим ABI. Создаются обычные owner -> DATA -> CODE.
# Вызов результата начинает обычную активацию над его настоящим parent.
# Public labels p0,p1,... map to actual source declarations. Their defaults,
# required/private and binding names are retained by the explicit input policy.
# Все захваченные зависимости — явные поля state; private не даёт им становиться
# случайными динамическими входами исходного callable.
#
# prefix is any ready Array: Structure/@[] supplies stored value records;
# dense T[] supplies one actual through its real typed access. It is never
# reinterpreted as a pointer array. Примитивы принимаются
# и сохраняются по значению; ссылочные значения сохраняют цель. copy(prefix)
# для этого НЕ используется, поскольку он глубоко копировал бы цели ссылок.
#
# Схема FxKernel\signature(subject): inputTypes, resultType, hasResult, names,
# throws. subject — callable либо fn-описание. resultType всегда имеет описание,
# в том числе для void. hasResult не заменяет и не кодирует тип числовым нулём.
# FxKernel\callable(contract; labels; bodyGraph; state; failures; policy) формирует
# обычный граф; внутри тела node\private\state даёт именно переданный state.

# Ordinary shared DATA fragment for prepared-value operands. Copying it supplies
# the real fields; structural operand checking supplies nothing implicitly.
# Each consumer adds its own ready PRIORITY and required/result contract.
# The private transport inputs cannot autofill from a helper's local variables.
FxPreparedOperands:
    private:
        @: left
        @[]: right
    const: int: PASS_ARGS_AS_IS 0

# Снимок уже принятого значения через существующий prepared operand protocol.
# Ресивер принимает указатель на значение слева; RHS не разворачивает его.
# Для postfix (value record) общий handler передаёт present empty right Array.
# Поддержка lifetime проверяется отдельно в приёмке для четырёх комбинаций executors.
FxRecordOperands:
    copy: FxPreparedOperands
    const: int: PRIORITY sys\priority("+")
    required: left right
    return: @
    record:
        throws: FxRecordArity
        if: length(right) != 0
            throw: FxRecordArity()
        return: left

# Неинициализированная запись @ служит TYPE SPEC, а не нулевым значением.
FxTypeTokens:
    reference:
        @: value

# Имена исходов передаются builder как обычные LMX-строки. Builder интернирует
# их при создании throws, но строки не притворяются заранее готовыми name atoms.
FxCaptureFailures:
    return: @
    names:
        private: @: out (copy(()))
        sys\resize(out; 1)
        out[0] := "FxRecordArity"
        return: out

FxStageFailures:
    return: @
    names:
        private: @: out (copy(()))
        sys\resize(out; 5)
        out[0] := "FxIndex"
        out[1] := "FxArity"
        out[2] := "FxRecordArity"
        out[3] := "FxTypeToken"
        out[4] := "FxKernelFailure"
        return: out

# Конкатенация LMX-строк. Вспомогательные процедуры тоже написаны на LMX.
# Binary string concatenation keeps its contract and delegates storage work to
# the single generic concat algorithm; equal char[] parts yield fresh char[].
FxConcat:
    private:
        char[]: first
        char[]: second
    return: char[]
    concat:
        throws: copy(FxThrows\sequence)
        private: @: out FxSeqConcat\concat(parts := (first; second))
        return: \out

FxDecimal:
    private: int: number
    return: char[]
    decimal:
        throws: copy(FxThrows\selection)
        if: number < 0
            throw: FxIndex()
        return: FxFormat\format(number)

# Для сгенерированных публичных имён используется только ASCII p + digits.
# Отдельное точное имя пригодится клиентам строителя для произвольных labels.
# Его вход — допустимое имя без NUL; это ограничение exact identifier в грамматике.
FxExactIdentifier:
    private: char[]: name
    return: char[]
    quote:
        private: char[]: out []
        private: int: extra 0
        private: int: i 0
        while: i < length(name)
            if: name[i] = '`'
                extra += 1
            i += 1
        sys\resize(out; length(name) + extra + 2)
        out[0] := '`'
        private: int: at 1
        i := 0
        while: i < length(name)
            out[at] := name[i]
            at += 1
            if: name[i] = '`'
                out[at] := '`'
                at += 1
            i += 1
        out[at] := '`'
        return: out

FxLabels:
    private: int: count
    return: @
    labels:
        throws: copy(FxThrows\selection)
        if: count < 0
            throw: FxIndex()
        private: @: out (copy(()))
        sys\resize(out; count)
        private: int: i 0
        while: i < count
            out[i] := FxConcat\concat("p"; FxDecimal\decimal(i))
            i += 1
        return: out

# Historical helper contract is reference-vector start/count. The public slice
# is generic and uses begin/end. Keep this checked adapter, not a second loop.
FxSlice:
    private:
        @[]: values
        int: start
        int: count
    return: @
    slice:
        throws: copy(FxThrows\selection)
        if: start < 0 || count < 0 || start > length(values)
            throw: FxIndex()
        if: count > length(values) - start
            throw: FxIndex()
        return: FxSeqSlice\slice(source := values; begin := start; end := start + count)

# Name :: DATA создаёт описание сигнатуры, не исполняемое тело.
# Used by the existing -> operand and the general factories.
# Normalized @ references point to canonical int type-code records; the current
# type registry retains full models, and no public boxed Type kind is added.
FxSignatures:
    private:
        @: inputs
        @: result
    return: @
    make:
        throws: copy(FxThrows\selection)
        private: @: labels FxLabels\labels(length(inputs))
        private: @: data FxKernel\signatureData(inputs := inputs; result := result; labels := labels)
        Built :: data
        return: Built

FxBuild:
    private:
        @: contract
        char[]: bodyText
        @: state
        @: failures
        @: policy 0
    return: @
    make:
        throws: FxIndex FxKernelFailure FxTypeToken
        private: @: shape FxKernel\signature(subject := contract)
        private: @: bodyGraph sys\fromLmx(bodyText)
        private: @: selectedPolicy policy
        if: selectedPolicy = 0
            selectedPolicy := FxOwnPolicy\make(contract)
        return: FxKernel\callable(contract; shape\names; bodyGraph; state; failures; selectedPolicy)

# Получатель Ti -> @ использует штатное принятие аргумента, затем возвращает
# запись уже принятого значения. Здесь нет независимого алгоритма conversion.
FxRecordConstructor :: (@: value; return: @)

FxRecordAdapterState:
    @: record 0
    FxRecordConstructor@: constructor

FxRecordAdapter:
    private:
        @: typeToken
        FxRecordConstructor@: constructor 0
    required: typeToken
    return: @
    make:
        throws: copy(FxThrows\selection)
        private: @: inputType FxKernel\normalizeType(typeToken)
        private: @: noResult FxKernel\normalizeType(void)
        private: @: inputs FxKernel\signatureData(
            FxOne\make(inputType);
            noResult;
            FxLabels\labels(1)
        )
        private: @: state (copy(FxRecordAdapterState))
        state\record := FxRecordOperands\record
        private: @: resultType FxKernel\normalizeType(FxTypeTokens\reference[0])
        private: @: failures FxCaptureFailures\names()
        private: char[]: body "return: (p0 node\\private\\state\\record)\n"
        if: constructor != 0
            state\constructor := constructor
            private: @: shape FxKernel\signature(constructor)
            resultType := shape\resultType
            failures := FxFailures\union(failures; shape\throws)
            body := "return: node\\private\\state\\constructor((p0 node\\private\\state\\record))\n"
        private: @: outputs FxKernel\signatureData((); resultType; ())
        Captured :: (
            private: copy(inputs)
            required: p0
            copy(outputs)
        )
        return: FxBuild\make(Captured; body; state; failures)

FxCaptureOne:
    private:
        @: requirement
        @: sourceRecord
    return: @
    capture:
        throws: copy(FxThrows\selection) FxRecordArity
        private: @: receiver FxRecordAdapter\make(requirement)
        return: receiver(p0 := \sourceRecord)

FxCapturePrefix:
    private:
        @: inputTypes
        @: prefix
    return: @
    capture:
        throws: copy(FxThrows\capture)
        if: length(prefix) > length(inputTypes)
            throw: FxArity()
        private: @: captured (copy(()))
        sys\resize(captured; length(prefix))
        private: int: i 0
        while: i < length(prefix)
            captured[i] := FxCaptureOne\capture(inputTypes[i]; FxSeqRead\read(prefix; i))
            i += 1
        return: captured

# A ready prefix is admitted once at construction. The full source namespace
# remains available on each call, including captured inputs needed by defaults.
# No absent residual position is emitted as a fictitious explicit actual.
FxPartial:
    private:
        @: operation
        @: prefix
    return: @
    partial:
        throws: copy(FxThrows\capture)
        private: @: info FxKernel\signature(subject := operation)
        private: int: n length(info\inputTypes)
        private: int: k length(prefix)
        if: k > n
            throw: FxArity()
        private: @: captured FxCapturePrefix\capture(info\inputTypes; prefix)
        private: @: remaining FxSlice\slice(info\inputTypes; k; n - k)
        private: @: contract FxSignatures\make(remaining; info\resultType)
        private: @: policy FxPrefixPolicy\make(operation; captured)
        return: FxWrap\make(contract; FxForwardEngine\run; (copy(())); info\throws; policy)

FxCurryState:
    @: target 0
    @: info 0
    @: prefix 0
    @: stageBuilder 0

# Finishing a non-final curry stage consumes precisely its current input, as
# required by stagewise capture. Future inputs are not read by the transport.
# Only the resulting ordinary value record survives; no borrowed frame does.
FxLambdaMiddleEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws: copy(FxThrows\retry)
        private: int: k length(state\prefix)
        private: @: value FxFrameRead\read(frame; 0)
        private: @: captured FxCaptureOne\capture(state\info\inputTypes[k]; value)
        private: @: next FxAppend\append(state\prefix; FxOne\make(captured))
        return: state\stageBuilder(operation := state\target; info := state\info; prefix := next)

FxLambdaStages:
    private:
        @: operation
        @: info
        @: prefix
    return: @
    build:
        throws: copy(FxThrows\adapter)
        private: @: inputs info\inputTypes
        private: int: n length(inputs)
        private: int: k length(prefix)
        if: k > n
            throw: FxArity()
        private: int: count 0
        if: k < n
            count := 1
        private: @: ownInputs FxSlice\slice(inputs; k; count)
        private: @: ownResult info\resultType
        private: @: engine FxForwardEngine\run
        private: @: failures info\throws
        if: k + 1 < n
            ownResult := FxKernel\normalizeType(token := FxTypeTokens\reference[0])
            engine := FxLambdaMiddleEngine\run
            failures := FxFailures\union(failures; FxStageFailures\names())
        private: @: contract FxSignatures\make(ownInputs; ownResult)
        private: @: state (copy(FxCurryState))
        state\target := operation
        state\info := info
        state\prefix := prefix
        state\stageBuilder := FxLambdaStages\build
        private: @: policy FxSourcePolicy\make(operation; FxIndices\make(k; count); FxIndices\make(0; k); prefix; FxIndices\make(k + count; n - k - count))
        return: FxWrap\make(contract; engine; state; failures; policy)

# curry(F) creates ordinary unary stages for any finite input count.
# Its own middle-stage protocol returns a callable reference; uncurry below
# does NOT require external chains to use this same result description.
# N=0 is a delayed nullary call. A callable final R is a final value.
FxLambda:
    private: @: operation
    return: @
    lambda:
        throws: copy(FxThrows\adapter)
        private: @: info FxKernel\signature(subject := operation)
        return: FxLambdaStages\build(operation; info; (copy(())))

FxFlip:
    private: @: operation
    return: @
    flip:
        throws: copy(FxThrows\permutation)
        private: @: info FxKernel\signature(subject := operation)
        private: int: n length(info\inputTypes)
        if: n < 2
            throw: FxArity()
        private: @: positions FxIndices\make(0; n)
        positions[0] := 1
        positions[1] := 0
        return: FxPermute\permute(operation; positions)

FxUncurryState:
    @: operation 0
    @: contract 0
    @: failures 0
    int: count 0
    int: hasResult 0

# A reached actual stage is inspected without calling it; its full native or
# interpreted contract is retained by prepare. Transport @ is only a reference
# to that value record, never a demand that its declared result be @.
FxUncurryEngine:
    private:
        @: state
        @: frame
    return: @
    run:
        throws: FxArity FxCallFailure FxIndex FxKernelFailure FxTypeToken
        private: @: current state\operation
        private: int: n state\count
        private: int: i 0
        while: 1
            private: @: stageInfo FxKernel\signature(current)
            private: int: expected 1
            if: n = 0
                expected := 0
            if: length(stageInfo\inputTypes) != expected
                throw: FxArity()
            if: n = 0 || i + 1 = n
                if: stageInfo\hasResult != state\hasResult
                    throw: FxTypeToken()
            ---
            private: @: entries (copy(()))
            if: n != 0
                private: @: supplied FxKernel\frameSlot(frame; i; demand := 0)
                if: supplied\supplied != 0
                    entries := FxOne\make(FxActualEntry\make(0; frame; i))
            ---
            private: @: outcome FxInvokeEntries\attempt(current; entries; state\failures)
            if: outcome\ok = 0
                throw: FxCallFailure(outcome)
            if: n = 0 || i + 1 = n
                return: outcome\value
            if: stageInfo\hasResult = 0
                throw: FxArity()
            current := outcome\value
            i += 1

# The explicit contract defines N and final R. No stage is probed at creation.
# Its type-only outer shape never transfers a named template default to an
# actual stage. Missing outer actuals stay missing on that reached stage call;
# its own default/required policy applies there. Final reception uses normal R.
FxUncurry:
    private:
        @: operation
        @: contract
        @: failures
    return: @
    uncurry:
        throws: copy(FxThrows\selection)
        private: @: info FxKernel\signature(subject := contract)
        private: @: state (copy(FxUncurryState))
        state\operation := operation
        state\contract := contract
        state\failures := failures
        state\count := length(info\inputTypes)
        state\hasResult := info\hasResult
        private: @: flatContract FxSignatures\make(info\inputTypes; info\resultType)
        return: FxWrap\make(flatContract; FxUncurryEngine\run; state; failures; FxOwnPolicy\make(flatContract))
