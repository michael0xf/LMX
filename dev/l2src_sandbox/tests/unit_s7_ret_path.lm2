# return: h\p. Its Structure, Holder's own p, has toString only (K03 NS-ROLES-2: it was `Plain: p`, now Plain's
# call). Equatable requires equals. The Consumer of a return is the required descriptor.

Equatable:
    size_t: equals 0U
end: Equatable

Holder:
    p:
        size_t: toString 0U
end: Holder

fn: pick (Holder: h) Equatable
return: h\p

fn: go (Holder: h) int
return: 4
