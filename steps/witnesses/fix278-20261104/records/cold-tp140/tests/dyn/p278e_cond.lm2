# One place for one name in a callable: a rebinding not reached leaves the written value, reached it replaces it.
Swapped:
    int: y 7
    int: a 5
end: Swapped
fn: m (int: k) int
    T:
        int: a 1
        int: y 3
    end: T
    if: k = 1
        T: Swapped
    ---
    return: T\y
end: m
int: first m(0)
int: second m(1)
int: third m(0)
sendMessage: exit(exit_code: first * 100 + second * 10 + third; stdout: ""; stderr: "")
return
