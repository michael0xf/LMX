Model:
    int: value 1
end: Model
Other:
    int: value 7
end: Other
fn: make () Other
return: @ Other
fn: read (Model: ref) int
return: ref\value
fn: check () int
    @: Model first make
    @: Model second make()
    @: Model third
    third: make
    @: Model fourth
    fourth: make()
    if: first != @ Other || second != @ Other || third != @ Other || fourth != @ Other
        return: 81
    if: read(first) != 7 || read(second) != 7 || read(third) != 7 || read(fourth) != 7
        return: 82
return: 7
sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
