fn: tst (int: c 3; int: a 2) int
    return: ((c * 10) + a)
end: tst
fn: mytest (int: c 3; int: a) int
    return: ((c * 10) + a)
end: mytest
sub: main () (
    Pack:
        int: c 4
        int: a 7
    end: Pack
    Only:
        int: a 5
    end: Only
    Holder:
        Inner:
            int: c 6
            int: a 1
        end: Inner
    end: Holder
    Q:
        int: z 0
    end: Q
    s:
        int: z 5
        q:
            int: z 1
        end: q
    end: s
    Extra:
        int: a 1
        int: z 9
    end: Extra
    int: whole_both 0
    int: whole_one 0
    int: whole_required 0
    int: whole_path 0
    int: qz 0
    int: qz_named 0
    int: positional 0
    int: number 0
    int: plain_int 0
)
    fn: k (Q: q; int: z 0) int
        return: (((q \ z) * 10) + z)
    end: k
    fn: first (Extra: e; int: q 2) int
        return: (((e \ a) * 10) + q)
    end: first
    :=: whole_both ((tst Pack))
    :=: whole_one ((tst Only))
    :=: whole_required ((mytest Only))
    :=: whole_path ((tst (Holder \ Inner)))
    :=: qz ((k s))
    :=: qz_named ((k (:= q s)))
    :=: positional ((first Extra))
    :=: number ((tst 5))
    :=: plain_int ((tst whole_both))
end: main
main:
int: whole_both 47
int: whole_one 35
int: whole_required 35
int: whole_path 61
int: qz 15
int: qz_named 50
int: positional 12
int: number 52
int: plain_int 472
int: only_fields 1
int: extra_fields 2
