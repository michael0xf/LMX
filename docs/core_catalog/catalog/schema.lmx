    @: modelColumns ("lmxType"; "converter"; "requirement")
    @: statuses ("METADATA_ONLY";"DIRECT_SCALAR_PROTOTYPE_NOT_RUN";"TYPED_SHIM_REVIEW_REQUIRED";"UNIMPLEMENTED_DECLARATION_REVIEW_REQUIRED";"PROFILE_REVIEW_REQUIRED")
    char[]: publication "proposal_only"
    char[]: runtimeAcceptance "NOT_RUN"
    char[]: ownership "review every argument/result; pin borrowed storage for full call interval"
    char[]: actorTransfer "copy values; resources through owner messages; callbacks explicit"
    char[]: errors "preserve native status then map explicitly"
    Models:
        @: m0 ("@";"typed_native_value";"resolve_typedef_enum_or_by_value_record")
        @: m1 ("BridgeData\\Callback@";"callback_trampoline";"callback_contract_required")
        @: m2 ("BridgeData\\Resource@";"typed_resource";"review_owner_native_type_generation_and_close")
        @: m3 ("size_t";"exact_scalar";"c_width_preserved")
        @: m4 ("BridgeData\\Buffer@";"checked_span";"review_element_type_shape_direction_and_lifetime")
        @: m5 ("char[]";"text_or_bytes";"review_length_encoding_nul_and_retention")
        @: m6 ("@[]";"finite_typed_varargs";"specialize_before_publication")
        @: m7 ("double";"exact_scalar";"c_width_preserved")
        @: m8 ("float";"exact_scalar";"c_width_preserved")
        @: m9 ("BridgeData\\Complex@";"complex_components";"no_implicit_abi_equivalence")
        @: m10 ("BridgeData\\ComplexBuffer@";"complex_buffer";"explicit_interleaved_or_planar_layout")
        @: m11 ("unsigned";"exact_scalar";"c_width_preserved")
        @: m12 ("@";"checked_integer";"resolve_native_width_then_choose_existing_integer")
        @: m13 ("char";"exact_scalar";"c_width_preserved")
        @: m14 ("BridgeData\\Buffer@";"checked_span";"zlib_byte_storage_not_opaque_resource")
        @: m15 ("@";"decimal_backend";"one_decimal_semantic_type_explicit_context")
        @: m16 ("@";"bigint_backend";"one_bigint_semantic_type")
        @: m17 ("@";"checked_integer";"resolve_zlib_native_width_then_choose_existing_integer")
        @: m18 ("BridgeData\\ScalarCell@";"checked_scalar_output";"zlib_inout_count_copy_back_only_after_success")
        @: m19 ("BridgeData\\Complex@";"complex_components";"no_double_or_struct_pointer_cast")
        @: m20 ("@";"real_backend";"one_real_semantic_type_explicit_binary_precision")
        @: m21 ("@";"decimal_backend";"convert_to_canonical_decimal_no_second_decimal_type")
        @: m22 ("BridgeData\\Buffer@";"checked_span";"unicode_code_unit_width_and_output_length_required")

