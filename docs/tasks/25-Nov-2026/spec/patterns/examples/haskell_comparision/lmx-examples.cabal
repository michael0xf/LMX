cabal-version: 2.4
name: lmx-analogy-clients
version: 0.1.0.0
build-type: Simple

executable lmx-analogy-clients
  main-is: Analogies.hs
  hs-source-dirs: .
  build-depends: base >=4.18 && <5, array, monad-loops ==0.4.3
  default-language: Haskell2010
  ghc-options: -Wall

test-suite haskell-comparisons
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: validation, source/haskell
  other-modules:
    H01, H02, H03, H04, H05, H06, H07, H08, H09
    R01, R02, R03, R04, R06a, R06b, R07, R09, A01
    V02, V03, V04, V05, M01, M05, GraphCopy
  build-depends: base >=4.9 && <5, containers >=0.5 && <0.9
  default-language: Haskell2010
  ghc-options: -Wall
