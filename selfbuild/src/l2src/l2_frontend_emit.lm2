        c.fclose(out_cell[0])
        return: (cast: (int) (1))
    if: library_mode_cell[0] != 0 && c.fputs("        return: 0\n", out_cell[0]) < 0
        c.fclose(out_cell[0])
        return: (cast: (int) (1))
    if: library_mode_cell[0] = 0 && c.fputs("        return: 0\n    end: l2_program_build\nend: external\n", out_cell[0]) < 0
