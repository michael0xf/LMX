---
    Observed:
        int: calls 1
        int: result 71109
    end: Observed
---
@: shared (data [] 0)
Model:
    int: x 0
    int: x 0
    int: [0]x 0
end: Model
Candidate:
    int: extra 99
    int: [0]x 11
    int: x 7
    int: x 9
end: Candidate
int: calls 1
fn: read (@: value Model) int
    :=: (node \ calls) ((node \ calls) + 1)
    return: ((((value \ [0]x) * 10000) + ((value \ `[0]x`) * 100)) + (value \ [1]x))
end: read
int: result (read Candidate)
sub: main ()
    :=: ((shared \ Observed) \ calls) (node \ calls)
    :=: ((shared \ Observed) \ result) result
end: main
main:
