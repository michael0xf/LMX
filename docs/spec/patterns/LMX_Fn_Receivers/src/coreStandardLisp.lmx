# ASSOCIATION / PROPERTY LISTS OVER ORDINARY LMX ARRAYS.
# One search visits keys; assoc, get/set/removeProperty and getProperties reuse
# it. Complete typed records and referenced objects retain their identity.
# Equality defaults to the shared ordinary/deep Array policy. An explicit
# comparator must be an equivalence relation and must not mutate traversed input. These are Array contracts, not emulated Lisp cons cells.

FxKeyShape:
    private:
        @: source
        int: stride 1
    required: source
    return: int
    count:
        throws: FxKernelFailure FxShape FxTypeToken
        FxSeqInfo\get(source)
        if: stride < 1
            throw: FxShape()
        private: int: size length(source)
        if: size % stride != 0
            throw: FxShape()
        return: size

# field=-1 selects a flat key; field>=0 selects that field of a row.
# Empty rows are skipped. A nonempty short row gets ordinary ReceiverIndex.
FxKeyIndex:
    private:
        @: source
        @: key
        @: same 0
        int: stride 1
        int: field -1
    required: source key
    return: int
    find:
        throws: copy(FxThrows\predicate) FxShape
        private: int: size FxKeyShape\count(source; stride)
        private: int: i 0
        while: i < size
            private: @: candidate FxSeqRead\read(source; i)
            private: int: usable 1
            if: field >= 0
                FxSeqInfo\get(candidate)
                if: length(candidate) = 0
                    usable := 0
                else:
                    candidate := FxSeqRead\read(candidate; field)
            ---
            if: usable != 0
                if: FxValueSame\test(key; candidate; same) != 0
                    return: i
            ---
            i += stride
        return: -1

FxAssoc:
    private:
        @: rows
        @: key
        @: same 0
        int: keyIndex 0
    required: rows key 
    return: @
    assoc:
        throws: copy(FxThrows\predicate) FxShape
        if: keyIndex < 0
            throw: ReceiverIndex()
        private: int: i FxKeyIndex\find(rows; key; same; field := keyIndex)
        if: i < 0
            return: FxNone\none()
        return: FxSome\some(value := FxSeqRead\read(rows; i))

FxPairlis:
    private:
        @: keys
        @: values
        @: tail ()
    required: keys values
    return: @
    pairlis:
        throws: copy(FxThrows\sequence) FxShape
        private: int: count FxKeyShape\count(keys)
        if: FxKeyShape\count(values) != count
            throw: FxShape()
        private: @: pairs FxZip\zip(keys; values)
        return: FxSeqConcat\concat(parts := (pairs; tail))

FxGetProperty:
    private:
        @: properties
        @: key
        @: same 0
    required: properties key 
    return: @
    getProperty:
        throws: copy(FxThrows\predicate) FxShape
        private: int: i FxKeyIndex\find(properties; key; same; stride := 2)
        if: i < 0
            return: FxNone\none()
        return: FxSome\some(value := FxSeqRead\read(properties; i + 1))

FxSetProperty:
    private:
        @: properties
        @: key
        @: value
        @: same 0
    required: properties key value 
    return: @
    setProperty:
        throws: copy(FxThrows\predicate) FxShape SequenceElement SequenceSize
        private: int: i FxKeyIndex\find(properties; key; same; stride := 2)
        if: i < 0
            private: int: end length(properties)
            return: FxSeqReplaceRange\replaceRange(properties; end; end; FxTwo\make(key; value))
        return: FxSeqReplaceRange\replaceRange(properties; i + 1; i + 2; FxOne\make(value))

FxRemoveProperty:
    private:
        @: properties
        @: key
        @: same 0
    required: properties key 
    return: int
    removeProperty:
        throws: copy(FxThrows\predicate) FxShape SequenceElement SequenceSize
        private: int: i FxKeyIndex\find(properties; key; same; stride := 2)
        if: i < 0
            return: 0
        FxSeqReplaceRange\replaceRange(properties; i; i + 2; ())
        return: 1

FxPropertyMatch:
    @: key
    @: value
    int: index 0

FxGetProperties:
    private:
        @: properties
        @: indicators
        @: same 0
    required: properties indicators 
    return: @
    getProperties:
        throws: copy(FxThrows\predicate) FxShape
        private: int: size FxKeyShape\count(properties; 2)
        FxSeqInfo\get(indicators)
        private: int: i 0
        while: i < size
            private: @: key FxSeqRead\read(properties; i)
            if: FxKeyIndex\find(indicators; key; same) >= 0
                private: @: match (copy(FxPropertyMatch))
                match\key := key
                match\value := FxSeqRead\read(properties; i + 1)
                match\index := i
                return: FxSome\some(value := match)
            i += 2
        return: FxNone\none()

# The public callers validate source profiles and select a common valid span.
# The only element comparison loop also serves every search candidate.
FxSequenceDifference:
    private:
        @: first
        @: second
        @: same 0
        int: firstStart 0
        int: count
        int: secondStart 0
    required: first second count
    return: int
    find:
        throws: copy(FxThrows\predicate)
        FxSeqInfo\get(first)
        FxSeqInfo\get(second)
        if: firstStart < 0 || secondStart < 0 || count < 0
            throw: ReceiverIndex()
        if: firstStart > length(first) || secondStart > length(second)
            throw: ReceiverIndex()
        if: count > length(first) - firstStart || count > length(second) - secondStart
            throw: ReceiverIndex()
        private: int: i 0
        while: i < count
            if: FxValueSame\test(
                FxSeqRead\read(first; firstStart + i);
                FxSeqRead\read(second; secondStart + i);
                same
            ) = 0
                return: i
            i += 1
        return: -1

FxMismatch:
    private:
        @: first
        @: second
        @: same 0
    required: first second 
    return: @
    mismatch:
        throws: copy(FxThrows\predicate) FxRecordArity
        FxSeqInfo\get(first)
        FxSeqInfo\get(second)
        private: int: count length(first)
        if: length(second) < count
            count := length(second)
        private: int: i FxSequenceDifference\find(first; second; same; 0; count)
        if: i < 0 && length(first) != length(second)
            i := count
        if: i < 0
            return: FxNone\none()
        return: FxSome\some(value := (i FxRecordOperands\record))

FxSearchSequence:
    private:
        @: items
        @: pattern
        @: same 0
        int: start 0
    required: items pattern
    return: @
    searchSequence:
        throws: copy(FxThrows\predicate) FxRecordArity
        FxSeqInfo\get(items)
        private: int: size length(items)
        if: start < 0 || start > size
            throw: ReceiverIndex()
        private: int: i FxSequenceSearch\search(items; pattern; start; 0; same)
        if: i < 0
            return: FxNone\none()
        return: FxSome\some(value := (i FxRecordOperands\record))

FxSubstitute:
    private:
        @: items
        @: oldValue
        @: newValue
        @: same 0
    required: items oldValue newValue 
    return: @
    substitute:
        throws: copy(FxThrows\predicate) SequenceElement SequenceSize
        private: @: info FxSeqInfo\get(items)
        private: int: count length(items)
        private: @: result FxSeqAllocate\make(info\arrayType; count)
        private: int: i 0
        while: i < count
            private: @: value FxSeqRead\read(items; i)
            if: FxValueSame\test(oldValue; value; same)
                value := newValue
            FxSeqStore\write(result; i; value)
            i += 1
        return: result

# A callable becomes one ordinary prepared-value operand. The SAME instance
# admits (op a b) and (a op b). Its ABI is left, depth, right; the ordinary
# source callable receives only collected logical arguments, never depth.
# The own policy adds operandDepthSource for dependent result preparation.
# FxKernel\operandDepthContext is the explicit PD01 integration boundary;
# it selects the full result requirement and common Array context, not a loop.
# FxWrap projects the resulting actual R/void; internal @ is record transport.
# This source is NOT evidence that PD01 is implemented by the host kernel.
FxOperandInputTypes:
    @: left
    int: depth
    @[]: right

FxOperandValueEngine:
    private:
        @: state
        @: frame
    required: state frame
    return: @
    run:
        throws: copy(FxThrows\sequencefixture)
        private: @: left
        private: @: slot FxKernel\frameSlot(frame; 0; demand := 0)
        if: slot\supplied != 0
            left := \FxFrameRead\read(frame; 0)
        private: int: depth \FxFrameRead\read(frame; 1)
        private: @: right FxFrameRead\read(frame; 2)
        private: @: args RxLogicalArguments\collect(left := left; right := \right)
        if: depth = 0
            return: FxApply\apply(state; args)
        private: @: context FxKernel\operandDepthContext(frame; args)
        return: FxArrayDepth\apply(context; depth; args)

FxAsOperand:
    private:
        @: operation
        int: priority
    required: operation priority
    return: @
    asOperand:
        throws: copy(FxThrows\selection)
        private: @: source FxKernel\signature(operation)
        private: @: inputTypes (
            FxKernel\normalizeType(FxOperandInputTypes[0]);
            FxKernel\normalizeType(FxOperandInputTypes[1]);
            FxKernel\normalizeType(FxOperandInputTypes[2])
        )
        private: @: noResult FxKernel\normalizeType(void)
        private: @: inputs FxKernel\signatureData(inputTypes; noResult; ("left"; "depth"; "right"))
        private: @: output FxKernel\signatureData((); source\resultType; ())
        private: char[]: properties FxConcat\concat("const: int: PASS_ARGS_AS_IS 0\nconst: int: PRIORITY "; FxFormat\format(priority))
        private: @: readyProperties sys\fromLmx(properties)
        private: @: data (
            private: copy(inputs)
            required: depth right
            copy(output)
            copy(readyProperties)
        )
        Operand :: data
        private: @: policy merge(FxOwnPolicy\make(Operand); (@: operandDepthSource operation))
        return: FxWrap\make(Operand; FxOperandValueEngine\run; operation; source\throws; policy)
