# The Consumer reads named fields, not all of Model. Cand provides aFirst at
# another physical slot, so reads admits it; second also needs aSecond, which
# Cand lacks, and catches the reception refusal. Entry 7.
Model:
    int: aFirst 1
    int: aSecond 2
    size_t: tail 9U
end: Model

Cand:
    size_t: other 3U
    int: aFirst 5
end: Cand

fn: reads () int
    o: merge: Cand
    @: b Model o
    int: last b\aFirst
    int: first b\aFirst
    if: last != 5
        return: 81
    if: first != 5
        return: 82
    if: b != o
        return: 83
    return: 0
end: reads

fn: second () int
    o: merge: Cand
    int: caught 0
    @: b Model o
    catch: implements ()
        caught: caught + 1
    ---
    if: caught != 1
        return: 84
    if: b != 0
        return: 85
    if: b != 0 && b\aSecond = 5
        return: 86
    return: 7
end: second

int: got reads()
if: got != 0
    sendMessage: exit(exit_code: got; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: second(); stdout: ""; stderr: "")
return
