include: "<stddef.h>"
predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_call.h.lm1"
predef: "l2src/lmx_service.h.lm1"
predef: "l2src/lmx_orphan.h.lm1"
predef: "l2src/lmx_message.h.lm1"
predef: "l2src/lmx_thread.h.lm1"
predef: "l2src/lmx_post.h.lm1"
predef: "l2src/lmx_schedule.h.lm1"
predef: "l2src/lmx_manager.h.lm1"
predef: "l2src/lmx_arena.h.lm1"

# lmx_root.h.lm1 - the root Message R0, and the cycle of turns that is all that is left
# of the "host" (L2_CORE_AND_MESSAGE_MODEL_20260912.md 25 (i)-(v), gaps item 6).
#
# (i)   A runtime without a root does not exist.  Creating the runtime creates R0: the
#       ordinary Message whose parent is the structural upper frame.  The frame is the one object
#       with no parent; R0 itself uses the same parent/child contract as every Thread.  Embedded use is no exception:
#       an embedding program sits outside LMX and reaches the runtime only through R0's
#       mail admission.
# (ii)  The process entry point (spec 1.7) runs INSIDE R0's turns: the Message of the
#       first thread of execution is R0, and the entry program is R0's handler -- not a
#       child spawned for it (9.1.4: the translator spawns no Messages implicitly).  That
#       is why the entry is called from lmx_root_turn and from nowhere else.
# (iii) Nothing of the "host" is left outside a turn.  Everything the L1 bootstrap gave
#       the host -- ingress, drive, the UI band's step, the parent's step over top-level
#       Messages, the logical clock, teardown -- belongs to R0's cycle here.  The clock is
#       read ONCE per cycle and handed down (lmx_clock is the only place that asks the
#       platform for the time), so everything that ages in one cycle ages against the same
#       reading.
# (iv)  The top level is single: a Message created without a parent is created THROUGH R0
#       (lmx_root_create), so the parent capability is R0's and there is no second top
#       level.
# (v)   Handing supervision to the virtual grandparent World Wide Mix: the call site is fixed
#       (lmx_root_supervise_world) and so is what fills that place today -- a LOCAL STUB PARENT,
#       the same place lingvamyxa kept for it: the stub holds a stamp cell that the root watches,
#       and the root's own window becomes a hang detector for it (19.09, lmx_root.lm1).  19.28.10
#       and the transport of 35 do not exist yet, and until they do the stub stands here: the old
#       "supervision is NOT handed over" refusal (LMX_ROOT_NO_WORLD) is gone with them, because a
#       status no act returns is a rule without a door.
#
# The record is the runtime's own handle, and each field is a mechanism a root has. R0 and its
# structural parent are each ONE Thread cell in R0's arena; the closed Message is the first
# by-value prefix of that same cell, not a second record. Their scheduler records are separate arena
# cells under the schedule domain. The two mailbox values are handle-owned mechanism storage; no
# address-range question is asked of those by-value fields.
#
# NOTHING is added to LmxMsg or Lmx.  Both are closed, and every cell here belongs to an
# object of its own.
#
# Orphan retention (iv) is a policy over ordinary children of R0. Re-rooting removes the physical
# Thread reference from its old parent's children Array and appends it to R0's same dynamic Array.
# Per-child retention clocks live on that Thread; the ledger holds no entries or membership list.
# R0's manager traverses the Array directly and each Thread keeps its own arena in its schedule.

# R0 has no fixed child capacity, reserved child positions, root index or magic graph slots.  Its
# direct children are the same growable Array<@LmxThread> used by every other L3 Thread.

define: LMX_ROOT_CLOSED 0
define: LMX_ROOT_OPEN 1

# The orphan-retention timeout's default (19.29.8: "a runtime policy value with a default, settable
# per runtime like the liveness deadlines"), in the same unit as the root's own limit -- the
# cycle's milliseconds.  It is R0's answer to "how long may a FAILED orphan keep its handoff-safe
# arena": a successful one is reclaimed at the next maintenance point instead, and a zero policy is
# refused, because a policy that can never be reached is not a policy.
define: LMX_ROOT_ORPHAN_RETENTION 60000U
# THE OVERALL CLOSE DEADLINE, and it is deliberately NOT any child's slot limit and not the liveness
# limit: it bounds the WHOLE synchronous cascade from the top (author, 2026-09-21).  The value is this
# runtime's house policy value, the same 60000 as the retention default beside it -- deliberately
# equal, not coincidentally.
define: LMX_ROOT_CLOSE_LIMIT 60000U

define: LMX_ROOT_OK 0
define: LMX_ROOT_INVALID 1
# R0's own work ended: its entry reported completion, a stop was requested, R0's own
# deadline passed, or the world it watches went silent (19.09).  A cycle that answers this has
# nothing left to drive; what follows is teardown, and that is the caller's act
# (lmx_root_close).
define: LMX_ROOT_DONE 2

struct: LmxRoot
    # R0's own arena: the runtime's storage and the address-range table that classifies it.
    LmxArena: arena
    # The structural parent frame above R0. It is an ordinary Thread mechanism with its own graph
    # and the same dynamic child Array; only this top frame has no parent.
    @: LmxThread parent
    @: LmxPost parent_mail
    @: LmxSchedule parent_slot
    @: void parent_children
    # R0 is one L3 Thread allocation. Its ordinary Message identity is the by-value first-member
    # prefix reached by lmx_thread_message(thread), never a second cached/rebindable pointer.
    # It has a mailbox and a turn, which is what makes it one. A
    # cell of the arena: it is the address the scheduler's domain question is asked about.
    @: LmxThread thread
    # R0's mailbox: the only door in from outside (25 (i)).  It is the same exact arena-owned POST
    # mechanism record used by every other Thread; R0 has no by-value/unclassified exception.
    @: LmxPost mail
    # R0's own scheduler record: how long the runtime itself may run.  A cell of the arena
    # under the SCHEDULE domain, like a child's record.
    @: LmxSchedule slot
    # R0's ordinary per-Thread scheduler, allocated in the same arena and cached by Thread.
    @: LmxManager manager
    # R0's mail service (lmx_service): "Тот же самый R0" -- the runtime's root IS the service.
    # Entries are ordered by the physical address of a live record.
    LmxService: service
    # Orphan policy view: owner is R0's Thread and count is derived by traversing its one children
    # Array. The handle stores no child collection of its own.
    LmxOrphanLedger: orphans
    # The orphan-retention policy value (19.29.8): how long a FAILED orphan may keep its
    # handoff-safe arena before the maintenance reclaims it.  Zero is refused by the setter; this
    # field starts at the default.
    ulong: retention
    # The upper frame's OWN overall close bound -- not a child's slot limit and not the liveness
    # limit (author, 2026-09-21): it bounds the whole synchronous cascade from the top.
    ulong: close_limit
    # The entry program (1.7), run inside R0's turns and nowhere else.  Its shape is the typed
    # entry's (lmx_call.h.lm1): the reserved node first, the status out. This is the synthetic
    # root adapter, so it receives graph.parent -- 0, since R0's graph is independent (parent = 0;
    # the stub above R0 is supervision, not a lexical space); ordinary methods receive their selected callable
    # occurrence M.parent through lmx_call0. Zero means R0 has no handler: its turns are pure boundary
    # work, which is a legitimate state.  R0's handler is NOT a callable occurrence (it has no
    # METHOD record), so the cycle calls it directly rather than through lmx_call.
    LmxCallEntry: entry
    # THE WORLD'S STAMP CELL, AND THE ROOT POLLS IT (19.09, Mikhail: "заглушка не зависла
    # которую опрашивает root").  The world -- the stub above the root, the place lingvamyxa
    # kept for WorldWideMix -- owns that cell (`lmx_root_supervise_world` hands it over) and
    # writes its reading there while it lives.  R0 watches it at every boundary and STOPS ITSELF
    # when the world has been silent longer than R0's own limit: a child whose parent went silent
    # ends, it does not outlive it.  Untyped, like every other reference in this kernel: the cell
    # is the caller's own storage, and the kernel only stores its address.
    @: void world
    # The reading of the CURRENT cycle: the logical clock (25 (iii)).  Everything that
    # ages in one cycle ages against this one number.
    ulong: now
    # How long R0 itself may run, in the cycle's milliseconds.  Zero is refused: every wait
    # has a limit (model 33), the runtime's own included.
    ulong: limit
    # OPEN or CLOSED.
    int: state
end: LmxRoot

prototype:
    # Create the runtime: R0, its arena, its mailbox and its schedule, with `entry` as its
    # handler and `limit` as its own deadline. Qualified sealed Arrays are ordinary typed ranges
    # allocated in this owner arena and reached through ordinary physical graph fields; Root has
    # no size parameters, reserved descriptors or magic storage for them. A handle that already holds a root must be cleared by the caller -- or
    # simply be the storage this call clears itself, which is what it does with every field of
    # LmxRoot and of its arena before anything is opened on them.
    fn: lmx_root_open (@: LmxRoot root; LmxCallEntry: entry; ulong: limit) int
    # One turn of R0: enter its boundary, run the entry program, leave.  The entry runs
    # INSIDE the turn, so lm.current is R0's thread while it runs and 0 outside.
    fn: lmx_root_turn (@: LmxRoot root; ulong: now) int
    # The cycle, with the reading this cycle ages against supplied by the caller -- the seamy
    # side of the logical clock, and the one a test can drive deterministically.
    fn: lmx_root_cycle_at (@: LmxRoot root; unsigned: ticks; ulong: now) int
    # The cycle: read the clock ONCE, then R0's turn, R0's keep-alive, and a bounded pass
    # over the top level.  This is what "the host" became -- there is no other driver.
    fn: lmx_root_cycle (@: LmxRoot root; unsigned: ticks) int
    # (iv): a top-level Message is created through R0 and joins R0's sole dynamic children Array
    # when its Thread is published. Null when the root is not open or creation is refused; refusal
    # publishes nothing (lmx_child_create).
    #
    # `source` MUST LIVE IN R0'S OWN ARENA.  There is no parameter for the source's arena
    # because there is no choice to make: this passes @ root\arena as the copy's src_arena,
    # and by lmx_graph_copy_owned.h.lm1 the source arena is the only thing that answers what
    # an address is.  A graph built anywhere else is foreign to the arena asked about it, so
    # the copy refuses a root it cannot type and this returns null -- it is not copied and
    # not diagnosed further.  The one exception is the exception everywhere: a store-resident
    # source is classifiable from a bound arena and is kept by address, not copied.
    fn: lmx_root_create (@: LmxRoot root; @: LmxArena child_arena; @: Lmx source) @: LmxMsg
    # Canonical profiled form. `retain_profile` is the exact physical receiver expression for
    # independent:const:immutable; zero explicitly requests an ordinary full copy.
    fn: lmx_root_create_profiled (@: LmxRoot root; @: LmxArena child_arena; @: Lmx source; @: Lmx retain_profile) @: LmxMsg
    # (v): hand the world's place its stamp cell -- the LOCAL STUB PARENT, still standing in for
    # World Wide Mix (lmx_root.lm1).  `world` is the caller's `size_t` cell: the stub writes its
    # reading there while it lives, R0 watches it at every boundary and ends when that world has
    # been silent longer than R0's own limit.  Refused with LMX_ROOT_INVALID when the root is not
    # open, when the address is not one, and when the cell has never been written (a zero would
    # age as "silent since the beginning of time" and end the root at once).
    fn: lmx_root_supervise_world (@: LmxRoot root; @: void world) int
    # (iv), 19.29.8: move an executable orphan's physical Thread reference from its old parent's
    # dynamic children Array to R0's Array. Its ordinary parent up-link follows that move; there is
    # no Message index, graph slot, scheduler queue or parallel orphan-membership chain. R0's
    # retention policy supplies the per-child clock. A plain Message is refused because the sole
    # membership Array is Array<@LmxThread>.
    # THE STUB PARENT'S TWO HALVES (Mikhail, 19.09 -- the WorldWideMix stub's place, see
    # lmx_root.lm1). R0 has the ordinary structural parent stub; its own wait is its liveness record:
    # stub RINGS with `lmx_root_keepalive` (the start of the wait is the last time the root was
    # seen) and POLLS with `lmx_root_hung` (has it been silent longer than its own window?).
    # A stub that rings every cycle turns the root's limit from a death timer into a hang
    # detector; the stub itself lives as long as the process, and that is its "forever".
    fn: lmx_root_keepalive (@: LmxRoot root; ulong: now) int
    fn: lmx_root_hung (@: LmxRoot root; ulong: now) int
    fn: lmx_root_orphan_adopt (@: LmxRoot root; @: LmxMsg orphan; @: LmxArena orphan_arena; @: LmxThread thread; ulong: now) int
    # The retention policy value, settable per runtime (19.29.8).  Zero is refused.
    fn: lmx_root_retention_set (@: LmxRoot root; ulong: limit) int
    fn: lmx_root_close_limit_set (@: LmxRoot root; ulong: limit) int
    # THE MAINTENANCE POINT: one pass over R0's same children Array. A successful handoff-safe
    # orphan is removed then reclaimed at once; a failed one is removed then reclaimed after its
    # retention window. Running records are only asked to stop and remain valid Array elements
    # until they publish a safe boundary.
    fn: lmx_root_orphan_maintain (@: LmxRoot root; ulong: now) int
    fn: lmx_root_orphans (@: LmxRoot root) @: LmxOrphanLedger
    # Teardown: stop R0, close its mailbox, release its arena -- everything the runtime owns,
    # attached children included. Synchronous linear close from OPEN; local deadline only.
    fn: lmx_root_close (@: LmxRoot root) int
    # The reads a caller outside needs; a by-value LmxRoot has no other way in (L1 follows a
    # field of a by-value record through a pointer, not through the value).
    fn: lmx_root_message (@: LmxRoot root) @: LmxMsg
    fn: lmx_root_thread (@: LmxRoot root) @: LmxThread
    # R0's own arena: the address-range table that answers for runtime addresses, and what a caller
    # building R0's initial graph (the settings and the input of 25 (ii)) takes its cells
    # from -- a graph is a value of the arena it belongs to.
    fn: lmx_root_arena (@: LmxRoot root) @: LmxArena
    # R0's stepped scheduler traverses the same children Array; it owns no membership queue.
    fn: lmx_root_service (@: LmxRoot root) @: LmxService
    fn: lmx_root_manager (@: LmxRoot root) @: LmxManager
    fn: lmx_root_clock (@: LmxRoot root) ulong
    fn: lmx_root_state (@: LmxRoot root) int
end: prototype
