    # Count and emit both report one step, so the two passes stay equal.
    if: n = 1 && stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && stmt\as != 0 && l2_quoted(stmt\as\atom) != 0
        \made: 1
        return: l2_rw_spell(pn, slot, stmt\as\atom)
    # steps/named-struct-exec.md, slices 2 and 4, and book §9 after 55c1abc: the nullary call of a Structure the check
    # pass took (l2_check_struct_call) -- by the bare atom, or by `f()` on the existing binding
    # (l2_empty_struct_assign_shape) -- is one step (l2_rw_struct_call), or none when the Structure's type is empty.
    # A held callable named alone is its call with no actuals, the walk of `p0()`.
    if: n = 1 && stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && stmt\as != 0 && l2_call_head_held(l2_rw_mi, stmt\as\atom) >= 0
        \next: l2_skip_span(field, n)
        if: l2_rw_mad_call(stmt, l2_call_head_held(l2_rw_mi, stmt\as\atom), into, @ node) != 0
            return: 1
        \made: 1
        return: l2_rw_put(into, slot, node)
    if: n = 1 && stmt != 0 && stmt\kind = c.LM_P0_NODE_ATOM && stmt\as != 0 && l2_rw_struct_callee(stmt\as\atom) != 0
        \next: l2_skip_span(field, n)
        return: l2_rw_struct_call(stmt, stmt\as\atom, into, slot, made)
    if: n = 0 && stmt != 0 && stmt\kind = c.LM_P0_NODE_FRAME && l2_empty_struct_assign_shape(stmt, l2_rw_mi) != 0
        return: l2_rw_struct_call(stmt, stmt\as\frame\head, into, slot, made)
    if: n > 0
        \next: l2_skip_span(field, n)
        idx: l2_path_run_callee(field, n, l2_rw_mi, @ selected_path)
        if: idx >= 0
            selected_head.data: selected_path
            selected_head.length: strlen(selected_path)
            idx: l2_rw_call_at(stmt, @ selected_head, idx, -1, 0, into, @ t)
            l2_xfree((cast: (@: void) selected_path))
            if: idx != 0
                return: 1
            \made: 1
            return: l2_rw_put(into, slot, t)
        if: l2_rw_expr(field, n, into, @ t) != 0
            return: 1
        \made: 1
        if: l2_rw_put(into, slot, t) != 0
            return: 1
        return: 0
    # K03: `return`, `break` and `continue` with no written argument -- the bare word or its empty Frame, one application
    # (l2_stmt_word_head) -- are one step each, one consumer for both spellings.
    h: l2_stmt_word_head(stmt, l2_rw_mi)
    if: h != 0 && l2_count_active(l2_app_actuals(stmt)) = 0 && (l2_text_eq(h, "return") || l2_text_eq(h, "break") || l2_text_eq(h, "continue"))
        if: l2_text_eq(h, "return")
            \made: 1
            if: l2_rw_frame(into, "LMX_WALK_OP_RET", 1, @ node) != 0
                return: 1
            return: l2_rw_put(into, slot, node)
        if: l2_rw_loops = 0
            return: l2_rw_refuse(stmt, "break and continue")
        if: l2_text_eq(h, "break") && l2_rw_frame(into, "LMX_WALK_OP_BREAK", 1, @ node) != 0
            return: 1
        if: l2_text_eq(h, "continue") && l2_rw_frame(into, "LMX_WALK_OP_CONTINUE", 1, @ node) != 0
            return: 1
        \made: 1
        if: l2_rw_put(into, slot, node) != 0
            return: 1
        return: 0
    if: stmt\kind = c.LM_P0_NODE_ATOM && stmt\as != 0
        return: l2_rw_refuse(stmt, "this statement")
    # An anonymous block (`---`, `( ... )`) is a nested executable body, as natively (§14, Q14 K;
    # l2_emit_stmts): a step IF(LIT 1, body), the if role running a plain body.  One with nothing
    # to run (l2_body_inert) makes no step.
    if: stmt\kind = c.LM_P0_NODE_STRUCTURE
        # One closed by `until` (l2_block_until) is the walker's UNTIL: the body first, then the condition, in the block's
        # scope; its body may break and continue.
        if: l2_block_until(stmt) != 0
            if: l2_rw_frame(into, "LMX_WALK_OP_UNTIL", 3, @ node) != 0 || l2_rw_source_facet(node, "LMX_WALK_SOURCE_ANONYMOUS") != 0 || l2_rw_enter(stmt, @ bsave) != 0
                return: 1
            l2_rw_loops: l2_rw_loops + 1
            if: l2_rw_body(stmt\as\structure, node, 2) != 0
                l2_rw_loops: l2_rw_loops - 1
                l2_rw_leave(bsave)
                return: 1
            l2_rw_loops: l2_rw_loops - 1
            if: l2_rw_expr(l2_block_until(stmt)\first_field, l2_count_active(l2_block_until(stmt)), node, @ t) != 0 || l2_rw_put(node, 1, t) != 0
