# The interpreter of the clean graph (docs/kernel-implementation.ru.md §6; slice 309, the vertical slice of §11 item 0):
# it walks the statements of a root in field order and recognizes everything by addresses -- a word by the canonical
# address of its spelling (the words of the language are the state's, §6.2), a place by the region of the address a slot
# holds (§2.2), a name by the address -> name table of the arena (§5.1). Written names resolve against this traversal's
# activation and current lexical slots (§3.5, §5.2); no binding survives the traversal. Each expression operation is an
# ordinary Lmx of operand/operator/operand, or prefix/operand, nested by construction (§3.3). This consumer performs no
# precedence parsing and keeps no prepared expression representation. A write of a place is the
# kernel's one write (lmx_graph_assign_int): every assignment writes into the same cell, through the address-typed
# internal indirection when present. That indirection does not make the language place a reference.
#
# Statements of this slice: `name: expression` (a write of the int place named name) and `int: name expression` (a
# declaration with a computed initializer: its result goes to the activation's local place). A Frame is
# the Lmx of its arguments named by its head (§3.3; the author 2026-11-09): its head is the name of that Lmx, its
# arguments are its fields from the first. A declaration of fn or sub stays in the graph as written; each traversal
# applies the receiver and creates, in its own initially clean namespace, the Structure named by the declaration's name
# argument with unified data, optional return and code (lmx_graph_space_open, lmx_graph_fn_make).
# An omitted initializer promises no initial value; the kernel does not maintain a changing initialized state.
#
# A machine module (L2 section 20); the build writes its header, lmx_graph_run.h.lm1, from the exports named in
# bld_kernel_l2 (tools/build.lm2).
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_graph.h.lm1"
predef: "l2src/lmx_checks.h.lm1"
predef: "l2src/lmx_call.h.lm1"
predef: "l2src/lmx_graph_copy_owned.h.lm1"
predef: "l2src/lmx_implements.h.lm1"
predef: "l2src/lmx_implements_resolve.h.lm1"
predef: "l2src/lmx_scratch.h.lm1"
predef: "l2src/lmx_pool.h.lm1"
predef: "l2src/lmx_arena_refs.h.lm1"
predef: "l2src/lmx_source_names.h.lm1"
predef: "l2src/lmx_value_owned.h.lm1"
predef: "l2src/lmx_array_owned.h.lm1"
predef: "l2src/lmx_message.h.lm1"
predef: "l2src/lmx_thread.h.lm1"
predef: "l2src/lmx_child.h.lm1"
predef: "l2src/lmx_service.h.lm1"
predef: "l2src/lmx_walk_values.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdlib.h>"
include: "<stdio.h>"
include: "<string.h>"

# A physical scalar is proved by its owning pool and companion, not a graph kind.
fn: lmx_graph_scalar_pool (@: g c.LmxGraph; @: cell void) @: c.LmxPool
    @: pool c.LmxPool 0
    @: context c.LmxWalkValue 0
    if: g = 0 || cell = 0
        return: 0
    pool := c.lmx_range_cell_pool(g\arena, cell)
    if: pool = 0 || pool\kind != c.LMX_KIND_PRIMITIVE || c.lmx_type_base(pool\type) != c.LMX_TYPE_FOREIGN || pool\scalar_abi = 0 || pool\scalar_abi\size = 0U || pool\stride != pool\scalar_abi\size || pool\scalar_abi\init = 0 || pool\scalar_abi\copy = 0
        return: 0
    context := c.lmx_value_cell_context(g\arena, cell)
    if: context = 0 || context\kind != c.LMX_WALK_VALUE_FOREIGN || context\ref != cell || context\type != pool\type || context\scalar_abi != pool\scalar_abi || context\physical_profile != pool\profile
        return: 0
    return: pool
end: lmx_graph_scalar_pool

# Load once, then materialize the existing Value producer's exact snapshot.
# An unfilled cell supplies metadata without reading or initializing payload.
fn: lmx_graph_scalar_snapshot (@: g c.LmxGraph; @: cell void; @: out c.LmxWalkValue) int
    c.LmxWalkValue: value
    @: value_p c.LmxWalkValue @ value
    @: context c.LmxWalkValue 0
    @: snapshot void 0
    if: lmx_graph_scalar_pool(g, cell) = 0 || out = 0
        return: 4
    context := c.lmx_value_cell_context(g\arena, cell)
    if: context\present = 0
        c.memcpy((cast: (@: void) out), (cast: (const: @: void) context), c.sizeof(c.LmxWalkValue))
        return: 0
    if: c.lmx_walk_value_cell(g\arena, cell, value_p) != c.LMX_WALK_OK
        return: 4
    if: value_p\present != 0
        if: c.lmx_walk_value_materialize(g\arena, value_p, @ snapshot) != c.LMX_WALK_OK || snapshot = 0 || c.lmx_walk_value_cell(g\arena, snapshot, value_p) != c.LMX_WALK_OK
            return: 4
        ---
    ---
    c.memcpy((cast: (@: void) out), (cast: (const: @: void) value_p), c.sizeof(c.LmxWalkValue))
    return: 0
end: lmx_graph_scalar_snapshot

fn: lmx_graph_scalar_operand (@: g c.LmxGraph; @: cell void; @@: out void) int
    c.LmxWalkValue: value
    @: value_p c.LmxWalkValue @ value
    int: status lmx_graph_scalar_snapshot(g, cell, value_p)
    if: status != 0
        return: status
    if: value_p\present = 0
        return: 5
    out[0] := value_p\ref
    return: 0
end: lmx_graph_scalar_operand

# Before its first load the existing Value can carry an absent model witness.
# A loaded current Value retains that same proven physical ABI.
fn: lmx_graph_work_scalar_contract (@: g c.LmxGraph; @: row c.LmxGraphWork) int
    @: expected c.LmxWalkValue 0
    @: actual c.LmxPool 0
    if: row = 0
        return: 3
    expected := (cast: (@: c.LmxWalkValue) (@ row\value))
    if: expected\scalar_abi = 0
        return: 0
    # Inline numerical records can retain the ABI that received their value.
    # Their Graph working cell is the ordinary numeric pool, not FOREIGN.
    if: expected\kind = c.LMX_WALK_VALUE_NUMBER && c.lmx_graph_scalar_type((cast: (const: @: c.LmxScalarABI) expected\scalar_abi)) = c.lmx_type_base(expected\type)
        return: 0
    actual := lmx_graph_scalar_pool(g, (cast: (@: void) row\cell))
    if: actual = 0 || actual\scalar_abi != expected\scalar_abi
        return: 4
    return: 0
end: lmx_graph_work_scalar_contract

# One activation owns its DATA snapshots, reached CODE locals and inherited inputs.
# Only a visible local in the current CodeBody chain can hide a DATA or FREE row.
fn: lmx_graph_work_row_scope (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: name char; @: start c.Lmx; int: dynamic) @: c.LmxGraphWork
    size_t: i 0U
    @: rows c.LmxGraphWork 0
    @: row c.LmxGraphWork 0
    @: found c.LmxGraphWork 0
    @: scope c.Lmx 0
    if: frame = 0 || name = 0
        return: 0
    rows := frame\rows
    scope := start
    while: scope != 0
        i := 0U
        found := 0
        while: i < frame\count
            row := rows + i
            if: row\scope = scope && row\name = name && (row\loaded & 16) != 0 && (dynamic = 0 || lmx_graph_row_private(g, row) = 0)
                if: found != 0
                    return: 0
                found := row
            ---
            i := i + 1U
        ---
        if: found != 0
            return: found
        if: scope = frame\body
            break
        scope := lmx_graph_code_parent(g, scope)
    ---
    i := 0U
    while: i < frame\count
        row := rows + i
        if: row\scope = 0 && row\slot != (cast: (size_t) -1) && row\name = name && (dynamic = 0 || lmx_graph_row_private(g, row) = 0)
            if: found != 0
                return: 0
            found := row
        i := i + 1U
    ---
    if: found != 0
        return: found
    i := 0U
    while: i < frame\count
        row := rows + i
        if: row\scope = 0 && row\slot = (cast: (size_t) -1) && row\name = name && (dynamic = 0 || lmx_graph_row_private(g, row) = 0)
            if: found != 0
                return: 0
            found := row
        i := i + 1U
    ---
    return: found
end: lmx_graph_work_row_scope

fn: lmx_graph_work_row (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: name char) @: c.LmxGraphWork
    if: frame = 0
        return: 0
    return: lmx_graph_work_row_scope(g, frame, name, (cast: (@: c.Lmx) frame\lexical_scope), 0)

# Is the binding declared by the receiver `private:`? The record it was declared by says so (the book, private-binding): the view of its qualifier chain.
# A binding with no record is not.
fn: lmx_graph_record_private (@: g c.LmxGraph; @: declared void) int
    @: leaf void 0
    int: flag 0
    if: declared = 0 || c.lmx_graph_receiving_view(g, declared, @ leaf, @ flag) != 0
        return: 0
    return: flag

# The field index of owner is declared by the receiver `private:` (the record stands in the field; an int write goes through it to the cell).
fn: lmx_graph_field_private (@: g c.LmxGraph; @: owner c.Lmx; size_t: index) int
    return: lmx_graph_record_private(g, c.lmx_graph_get_in(g, owner, index))

# Is the binding of this working row declared by the receiver private? The record it was made from says so.
fn: lmx_graph_row_private (@: g c.LmxGraph; @: row c.LmxGraphWork) int
    @: declared void row\declared
    return: lmx_graph_record_private(g, declared)

# Namespace callables retain their exact written declaration as parent.
# Use that origin only; a same-spelled, unrelated field owns no attribute here.
fn: lmx_graph_binding_declared (@: g c.LmxGraph; @: owner c.Lmx; @: value void) @: void
    @: raw void 0
    @: leaf void 0
    @: declaration c.Lmx 0
    int: flag 0
    size_t: i 0U
    if: c.lmx_graph_kind(g, value) = 4
        declaration := (cast: (@: c.Lmx) value)
        declaration := (cast: (@: c.Lmx) declaration\parent)
    while: i < c.lmx_graph_count(owner)
        raw := c.lmx_graph_get_in(g, owner, i)
        if: c.lmx_graph_receiving_view(g, raw, @ leaf, @ flag) != 0
            return: 0
        if: raw = value || leaf = value || (declaration != 0 && leaf = (cast: (@: void) declaration))
            return: raw
        i := i + 1U
    return: 0

# A supported computed declaring receiver. The source Frame is an unreadable
# place until its reached initializer or an assignment supplies a value (R12).
# This is not uninit:T storage: that has its real typed cell and wrapper.


fn: lmx_graph_deferred_kind (@: g c.LmxGraph; @: value void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: declaration c.Lmx (cast: (@: c.Lmx) value)
    @: head char 0
    size_t: n 0U
    value := c.lmx_graph_binding_leaf(g, value)
    declaration := (cast: (@: c.Lmx) value)
    if: state = 0 || c.lmx_graph_kind(g, value) != 4 || c.lmx_graph_fn_result(g, value) != 0
        return: 0
    head := c.lmx_graph_name_of(g, value)
    n := c.lmx_graph_count(declaration)
    if: head = state\w_int && n >= 2U
        return: 1
    if: head != state\w_at
        return: 0
    if: n = 3U && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, declaration, 1U)) = state\w_int
        return: 5
    if: n = 2U && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, declaration, 1U)) != state\w_int
        return: 6
    return: 0

# Snapshot an initialized reference value into its own activation/operand cell.
fn: lmx_graph_reference_value (@: g c.LmxGraph; @: value void) @: void
    @: copy void 0
    int: type 0
    value := c.lmx_graph_reference_cell(g, value)
    if: value = 0
        return: (cast: (@: void) 0)
    type := c.lmx_range_type_of(g\arena, value)
    copy := c.lmx_arena_pointer_cells_profiled(g\arena, type, 0, sizeof(@: void), c.lmx_arena_pointer_void_read, c.lmx_arena_pointer_void_write, 1U)
    if: copy = 0 || c.lmx_arena_pointer_void_write(copy, c.lmx_arena_pointer_void_read(value)) != 0
        return: (cast: (@: void) 0)
return: copy

# Snapshot only a computed declaration's written structure. Pointer values
# and Model/context edges retain their targets; no lexical graph is copied.
fn: lmx_graph_description_snapshot (@: g c.LmxGraph; @: raw void; @@: out void) int
    return: lmx_graph_copy_with_names(g, raw, 8, out)

# A copy of the Structure source with the names of the addresses it copies (the book, names: "Graph copying transfers names for copied addresses, interning
# spellings at the receiving boundary"). The arena-level door lmx_graph_copy_owned knows no table of names and leaves a copied Frame without its head; this copy
# keeps the map of what it copied and gives it to lmx_graph_copy_metadata, the one mechanism that carries the parents and the names.
fn: lmx_graph_copy_value (@: g c.LmxGraph; @: source void; @@: out void) int
    return: lmx_graph_copy_with_names(g, source, 0, out)

# The common copier over a map, then the parents and the names of the copied addresses; value_policy as the caller asks.
fn: lmx_graph_copy_with_names (@: g c.LmxGraph; @: raw void; int: policy; @@: out void) int
    c.LmxCopyMap: map
    c.LmxCopyStack: todo
    size_t: name_count (cast: (size_t) g\names_len)
    int: status 0
    c.memset((cast: (@: void) (@ map)), 0, c.sizeof(c.LmxCopyMap))
    c.memset((cast: (@: void) (@ todo)), 0, c.sizeof(c.LmxCopyStack))
    if: c.lmx_copy_map_init(@ map) != 0
        return: 4
    map\value_policy := policy
    status := c.lmx_graph_copy_value_mapped_staged(g\arena, raw, @ map, @ todo, out)
    if: status = 0
        status := c.lmx_graph_copy_drain_mapped(g\arena, @ map, @ todo, 0)
    if: status = 0
        status := lmx_graph_copy_metadata(g, @ map, 0, name_count, 0)
    c.lmx_copy_stack_dispose(@ todo)
    c.lmx_copy_map_dispose(@ map)
    if: status != 0
        return: 4
    return: 0

# Bind a value or written computation into its independent local place.
fn: lmx_graph_work_snapshot (@: g c.LmxGraph; @: row c.LmxGraphWork; @: raw void) int
    @: pool c.LmxPool lmx_graph_scalar_pool(g, raw)
    @: value c.LmxWalkValue (cast: (@: c.LmxWalkValue) (@ row\value))
    @: context c.LmxWalkValue 0
    @: copy void 0
    int: kind c.lmx_graph_kind(g, raw)
    raw := c.lmx_graph_binding_leaf(g, raw)
    pool := lmx_graph_scalar_pool(g, raw)
    kind := c.lmx_graph_kind(g, raw)
    row\cell := raw
    row\expected_kind := lmx_graph_own_kind(g, raw)
    row\loaded := row\loaded & -2
    c.lmx_walk_value_clear(value)
    if: pool != 0
        if: lmx_graph_scalar_snapshot(g, raw, value) != 0
            return: 4
        copy := value\ref
        if: value\present = 0
            copy := c.lmx_arena_scalar_cells_profiled(g\arena, pool\type, pool\profile, pool\scalar_abi, 1U)
            context := c.lmx_value_cell_context(g\arena, copy)
            if: copy = 0 || context = 0
                return: 4
            c.memcpy((cast: (@: void) context), (cast: (const: @: void) value), c.sizeof(c.LmxWalkValue))
            context\ref := copy
            value\ref := copy
        ---
        row\cell := copy
        row\loaded := row\loaded | 1
        return: 0
    if: lmx_graph_deferred_kind(g, raw) != 0
        return: lmx_graph_description_snapshot(g, raw, (cast: (@@: void) (@ row\cell)))
    if: kind = 1 || kind = 2 || kind = 5 || kind = 6 || (kind = 4 && c.lmx_graph_declaration_place_name(g, raw) = 0)
        if: c.lmx_walk_value_cell(g\arena, raw, value) != c.LMX_WALK_OK
            return: 4
        return: lmx_graph_work_snapshot_selected(g, row, raw, value)
    if: kind = 3
        row\cell := c.lmx_graph_uninit_int(g)
        if: row\cell = 0
            return: 4
        return: 0
    if: kind = 8 || kind = 9
        row\cell := c.lmx_graph_uninit_reference(g, kind - 3, 0)
        if: row\cell = 0
            return: 4
        return: 0
    if: row\cell = 0
        return: 4
    row\loaded := row\loaded | 1
    return: 0
end: lmx_graph_work_snapshot

# An already received Value is authoritative. Snapshot its payload through
# the existing scalar/cell producers without reloading semantic context from
# a physical companion or mistaking native ABI storage for a Graph cell.
fn: lmx_graph_work_snapshot_value (@: g c.LmxGraph; @: row c.LmxGraphWork; @: given c.LmxWalkValue) int
    @: value c.LmxWalkValue (cast: (@: c.LmxWalkValue) (@ row\value))
    @: cell void 0
    c.LmxWalkPlace: place
    c.LmxWalkValue: storage_value
    @: storage c.LmxWalkValue @ storage_value
    int: status 0
    if: given = 0 || given\kind = 0
        return: 4
    c.memcpy((cast: (@: void) value), (cast: (const: @: void) given), c.sizeof(c.LmxWalkValue))
    if: value\kind = c.LMX_WALK_VALUE_FOREIGN && value\scalar_abi != 0
        status := c.lmx_walk_scalar_snapshot(g\arena, value)
        if: status != c.LMX_WALK_OK
            return: 4
        cell := value\ref
        if: value\present = 0
            cell := 0
            if: c.lmx_walk_values_arg_place_scalar(g\arena, value, @ cell, 1U, 0U, (cast: (const: @: c.LmxScalarABI) value\scalar_abi), (cast: (@: void) value\source_type), @ place) != c.LMX_WALK_OK
                return: 4
            ---
        ---
    else:
        if: value\present = 0
            return: 4
        # The activation's binding cell is mutable even when its selected
        # value was immutable. Graph's managed Lmx reference has its existing
        # pool type; the semantic Value keeps the native LMX representation.
        c.memcpy((cast: (@: void) storage), (cast: (const: @: void) value), c.sizeof(c.LmxWalkValue))
        storage\type := c.lmx_type_base(value\type)
        if: storage\kind = c.LMX_WALK_VALUE_REFERENCE && storage\type = c.LMX_TYPE_LMX
            storage\type := c.LMX_TYPE_GRAPH_LMX_REF
        if: c.lmx_walk_value_materialize(g\arena, storage, @ cell) != c.LMX_WALK_OK
            return: 4
        ---
    ---
    if: cell = 0
        return: 4
    row\cell := cell
    row\loaded := row\loaded | 1
    return: 0
end: lmx_graph_work_snapshot_value

# Refresh only the ready payload. Semantic context belongs to the selected
# Value, even when the physical companion was changed by another operation.
fn: lmx_graph_work_value (@: g c.LmxGraph; @: row c.LmxGraphWork; @: held c.LmxWalkValue; @: out c.LmxWalkValue) int
    if: held = 0 || out = 0 || held\kind = 0
        return: 4
    c.memcpy((cast: (@: void) out), (cast: (const: @: void) held), c.sizeof(c.LmxWalkValue))
    if: row = 0 || (row\loaded & 1) = 0
        return: 0
    if: held\kind = c.LMX_WALK_VALUE_NUMBER && c.lmx_type_base(held\type) = c.LMX_TYPE_INT
        return: c.lmx_graph_value_int(g, row\cell, @ out\number)
    if: held\kind = c.LMX_WALK_VALUE_REFERENCE
        out\ref := row\cell
        if: c.lmx_domain_kind(g\arena, (cast: (@: void) row\cell)) = c.LMX_KIND_PRIMITIVE
            out\ref := c.lmx_arena_pointer_void_read(row\cell)
    ---
    return: 0
end: lmx_graph_work_value

fn: lmx_graph_work_snapshot_selected (@: g c.LmxGraph; @: row c.LmxGraphWork; @: raw void; @: held c.LmxWalkValue) int
    if: held = 0
        return: lmx_graph_work_snapshot(g, row, raw)
    if: c.lmx_graph_kind(g, raw) = 4 && lmx_graph_deferred_kind(g, raw) = 0 && lmx_graph_own_kind(g, raw) = 0
        # A named Structure stays a non-place binding. Its current reference
        # is not an assignable reference-variable cell.
        row\cell := raw
        c.memcpy((cast: (@: void) (@ row\value)), (cast: (const: @: void) held), c.sizeof(c.LmxWalkValue))
        row\loaded := row\loaded | 1
        return: 0
    return: lmx_graph_work_snapshot_value(g, row, held)
end: lmx_graph_work_snapshot_selected

fn: lmx_graph_work_load (@: g c.LmxGraph; @: row c.LmxGraphWork) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: current c.LmxWalkValue (cast: (@: c.LmxWalkValue) (@ row\value))
    @: declaration c.Lmx 0
    @: value void 0
    int: kind 0
    int: number 0
    int: status 0
    if: row = 0 || row\cell = 0
        return: 3
    if: (row\loaded & 64) != 0
        return: 5
    kind := lmx_graph_deferred_kind(g, (cast: (@: void) row\cell))
    if: kind != 0 && (row\loaded & 1) = 0
        if: active = 0
            return: 5
        declaration := (cast: (@: c.Lmx) c.lmx_graph_binding_leaf(g, row\cell))
        row\loaded := row\loaded | 64
        if: kind = 1
            status := lmx_graph_eval(g, (cast: (@: c.Lmx) active\code), declaration, 1U, c.lmx_graph_count(declaration), @ number)
            if: status = 0
                value := c.lmx_graph_int(g, number)
            ---
        else:
            status := lmx_graph_read_received_value(g, (cast: (@: c.Lmx) active\code), c.lmx_graph_get_in(g, declaration, c.lmx_graph_count(declaration) - 1U), (cast: (int) (kind = 6)) * 2, @ value)
            if: status = 0
                if: kind = 6
                    value := c.lmx_graph_lmx_ref_of(g, value)
                else:
                    value := c.lmx_graph_int_ref_of(g, value)
                ---
            ---
        ---
        row\loaded := row\loaded & -65
        if: status != 0
            return: status
        if: value = 0
            return: 4
        row\cell := value
        row\loaded := row\loaded | 1
    ---
    if: (row\loaded & 1) = 0
        return: 5
    if: lmx_graph_work_scalar_contract(g, row) != 0
        return: 4
    if: lmx_graph_scalar_pool(g, (cast: (@: void) row\cell)) != 0
        # The FOREIGN payload already lives in this local cell. Its selected
        # Value owns the context; rereading a physical companion would discard
        # that independent Model/SOURCE snapshot after an intervening call.
        if: current\ref != row\cell || c.lmx_walk_value_scalar_storage(g\arena, current, c.LMX_TYPE_FOREIGN, (cast: (const: @: c.LmxScalarABI) current\scalar_abi)) != c.LMX_WALK_OK
            return: 4
        return: 0
    kind := lmx_graph_own_kind(g, (cast: (@: void) row\cell))
    if: row\expected_kind != 0 && kind != row\expected_kind
        return: 4
    if: kind = 1
        return: c.lmx_graph_value_int(g, row\cell, @ row\number)
    return: 0
end: lmx_graph_work_load

# The field of data named name for a call: its record in the registry of data (lmx_graph_data_find), read whole -- a
# place of that name, else its first field of that name (a named Structure); a Frame of a statement named by its head
# -- `x: x + 2` beside `int: x 4` -- is no second field. The count of its slots when none is.
fn: lmx_graph_data_slot (@: g c.LmxGraph; @: data c.Lmx; @: name char) size_t
    size_t: at 0U
    lmx_graph_data_find(g, data, name, 1, 0U, @ at)
    return: at
end: lmx_graph_data_slot

# The cell a launch reads for a data place (the author 2026-11-11, R12; plan M11 5a): the primitive cell, or the retained
# computed int/reference declaration with a candidate. Supplied data is read as it is; its initializer does not run.
# A retained declaration has no computed result yet: a read evaluates its selected written expression, while a
# reached code receiver evaluates its RHS again. True uninit:T wrappers keep their existing
# typed storage and promise no initial payload; they are never treated as retained computations. 0 for neither.
fn: lmx_graph_data_cell (@: g c.LmxGraph; @: data c.Lmx; size_t: slot) @: void
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: value void 0
    @: cell void 0
    if: state = 0 || slot >= c.lmx_graph_count(data)
        return: 0
    cell := c.lmx_graph_place_cell(g, data, slot)
    if: cell != 0
        return: cell
    value := c.lmx_graph_binding_leaf(g, c.lmx_graph_get_in(g, data, slot))
    if: lmx_graph_scalar_pool(g, value) != 0
        return: value
    cell := c.lmx_graph_reference_cell(g, value)
    if: cell != 0
        return: cell
    if: lmx_graph_deferred_kind(g, value) != 0
        return: value
    return: 0
end: lmx_graph_data_cell

# Is a place named name in data after slot (two fields of one name are inadmissible as data)? 1 or 0.
fn: lmx_graph_data_twice (@: g c.LmxGraph; @: data c.Lmx; size_t: slot; @: name char) int
    size_t: i slot + 1U
    int: kind 0
    while: i < c.lmx_graph_count(data)
        kind := c.lmx_graph_kind(g, c.lmx_graph_get_in(g, data, i))
        if: (kind = 1 || kind = 3 || kind = 5 || kind = 6 || kind = 8 || kind = 9 || lmx_graph_scalar_pool(g, c.lmx_graph_get_in(g, data, i)) != 0) && c.lmx_graph_slot_name(g, data, i) = name
            return: 1
        i := i + 1U
    ---
    return: 0
end: lmx_graph_data_twice

# Lexical CodeBody parents follow the same argument roles as execution.
# Header and body keep their lexical holders; written groups and call data do not.
fn: lmx_graph_code_parent (@: g c.LmxGraph; @: body c.Lmx) @: c.Lmx
    @: parent c.Lmx 0
    @: selected c.Lmx 0
    size_t: selected_from 0U
    size_t: selected_to 0U
    size_t: i 0U
    int: role 0
    if: body = 0
        return: 0
    parent := (cast: (@: c.Lmx) body\parent)
    if: lmx_graph_role_code(lmx_graph_code_body(g, body, 0U, @ selected, @ selected_from, @ selected_to)) != 0 && selected = body
        return: parent
    if: parent != 0 && lmx_graph_code_argument(g, parent, 0U) = 3
        lmx_graph_code_body(g, parent, 0U, @ selected, @ selected_from, @ selected_to)
        if: selected = body
            return: (cast: (@: c.Lmx) parent\parent)
        ---
    while: parent != 0 && i < c.lmx_graph_count(parent)
        if: c.lmx_graph_get_in(g, parent, i) = (cast: (@: void) body)
            role := lmx_graph_code_argument(g, parent, i)
            if: role = 1 && lmx_graph_code_argument(g, parent, 0U) = 2
                return: (cast: (@: c.Lmx) c.lmx_graph_get_in(g, parent, 0U))
            if: role = 1 || role = 2
                return: (cast: (@: c.Lmx) parent\parent)
            return: 0
        i := i + 1U
    return: 0
end: lmx_graph_code_parent

fn: lmx_graph_code_within (@: g c.LmxGraph; @: body c.Lmx; @: scope c.Lmx) int
    while: scope != 0
        if: scope = body
            return: 1
        scope := lmx_graph_code_parent(g, scope)
    return: 0
end: lmx_graph_code_within

# Only a declaration in this lexical chain can defer a required name.
# The query neither evaluates parts nor constructs a callable.
fn: lmx_graph_work_pending (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: name char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: scope c.Lmx frame\lexical_scope
    @: raw void 0
    @: head char 0
    @: declared char 0
    int: candidate 0
    size_t: i 0U
    if: state = 0 || lmx_graph_code_within(g, (cast: (@: c.Lmx) frame\body), scope) = 0
        return: 0
    while: scope != 0
        i := 0U
        while: i < c.lmx_graph_count(scope)
            raw := c.lmx_graph_get_in(g, scope, i)
            if: i = 1U && scope\parent != 0 && lmx_graph_code_argument(g, (cast: (@: c.Lmx) scope\parent), 0U) = 2 && c.lmx_graph_get_in(g, (cast: (@: c.Lmx) scope\parent), 0U) = (cast: (@: void) scope)
                i := i + 1U
                continue
            head := c.lmx_graph_name_of(g, raw)
            if: c.lmx_graph_kind(g, raw) = 4 && (head = state\w_fn || head = state\w_sub) && lmx_graph_binding_method(g, scope, raw) = 0
                declared := lmx_graph_fn_decl_name(g, (cast: (@: c.Lmx) raw))
                if: declared = 0 || declared = name
                    return: 1
            ---
            i := i + 1U
        if: scope = frame\body
            break
        scope := lmx_graph_code_parent(g, scope)
    # The root of the data of a callable holds declarations too: one not yet applied defers the name in the same way.
    scope := (cast: (@: c.Lmx) frame\data)
    i := 0U
    while: frame\data != frame\body && i < c.lmx_graph_count(scope)
        raw := c.lmx_graph_get_in(g, scope, i)
        head := c.lmx_graph_name_of(g, raw)
        candidate := (cast: (int) (c.lmx_graph_kind(g, raw) = 4 && (head = state\w_fn || head = state\w_sub) && lmx_graph_binding_method(g, scope, raw) = 0))
        declared := 0
        if: candidate != 0
            declared := lmx_graph_fn_decl_name(g, (cast: (@: c.Lmx) raw))
        if: candidate != 0 && (declared = 0 || declared = name)
            return: 1
        i := i + 1U
    return: 0
end: lmx_graph_work_pending

# Future declarations permit an absent external snapshot; they do not create
# a visible local or suppress an existing outer value before their line.
fn: lmx_graph_work_local_declared (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: name char) int
    @: scope c.Lmx frame\lexical_scope
    @: raw void 0
    size_t: i 0U
    while: scope != 0
        i := 0U
        while: i < c.lmx_graph_count(scope)
            raw := c.lmx_graph_get_in(g, scope, i)
            if: (lmx_graph_own_kind(g, raw) = 1 || lmx_graph_own_kind(g, raw) = 5 || lmx_graph_own_kind(g, raw) = 6 || lmx_graph_scalar_pool(g, raw) != 0) && lmx_graph_own_name(g, raw) = name
                return: 1
            i := i + 1U
        ---
        if: scope = frame\body
            break
        scope := lmx_graph_code_parent(g, scope)
    return: 0
end: lmx_graph_work_local_declared

# Local callable bindings shadow only a free fallback, never mapped data or
# formals. The physical holder and the constructed value's parent stay intact.
fn: lmx_graph_space_binding (@: g c.LmxGraph; @: scope c.Lmx; @: name char; int: dynamic; @@: declared void) @: void
    @: space c.LmxGraphSpace c.lmx_graph_space()
    @: row c.LmxGraphSpaceRow 0
    size_t: i 0U
    size_t: at 0U
    size_t: found 0U
    @: value void 0
    int: status 0
    declared[0] := 0
    if: dynamic = 0
        value := c.lmx_graph_space_find(scope, name)
        declared[0] := lmx_graph_binding_declared(g, scope, value)
        return: value
    # Physical fields can share a referent while keeping distinct attributes.
    # Select an eligible field first, rather than filtering that referent.
    found := lmx_graph_work_data_find_scope(g, 0, scope, name, @ at, 1)
    if: found > 1U
        return: 0
    if: found = 1U
        status := lmx_graph_binding_read(g, scope, at, 0, @ value)
        if: status != 0
            return: 0
        return: value
    if: lmx_graph_work_data_find_scope(g, 0, scope, name, @ at, 0) != 0U
        return: 0
    if: space = 0
        return: 0
    i := space\count
    while: i > 0U
        i := i - 1U
        row := space\rows + i
        if: row\scope = scope && row\name = name && lmx_graph_record_private(g, lmx_graph_binding_declared(g, scope, (cast: (@: void) row\value))) = 0
            return: (cast: (@: void) row\value)
    ---
    return: 0
end: lmx_graph_space_binding

fn: lmx_graph_work_method_scope (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: name char; int: dynamic; @@: declared void) @: void
    @: scope c.Lmx frame\lexical_scope
    @: value void 0
    declared[0] := 0
    if: scope != frame\data && lmx_graph_code_within(g, (cast: (@: c.Lmx) frame\body), scope) = 0
        return: 0
    while: scope != 0
        value := lmx_graph_space_binding(g, scope, name, dynamic, declared)
        if: c.lmx_graph_fn_result(g, value) != 0
            return: value
        if: scope = frame\body || scope = frame\data
            break
        scope := lmx_graph_code_parent(g, scope)
    return: 0
end: lmx_graph_work_method_scope

fn: lmx_graph_work_method (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: name char) @: void
    @: declared void 0
    return: lmx_graph_work_method_scope(g, frame, name, 0, @ declared)

# Enter an actually selected CodeBody in the existing activation. Native and
# walked code share this cursor and written-declaration preparation.
fn: lmx_graph_work_scope (@: g c.LmxGraph; @: code c.Lmx; @: body c.Lmx; int: reset) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: frame c.LmxGraphFrame 0
    @: row c.LmxGraphWork 0
    size_t: i 0U
    if: active = 0 || active\code != code || active\frame = 0
        return: 0
    frame := (cast: (@: c.LmxGraphFrame) active\frame)
    while: reset != 0 && i < frame\count
        row := frame\rows + i
        if: row\scope = body
            row\loaded := row\loaded & -17
        i := i + 1U
    ---
    if: frame\lexical_scope = body
        return: 0
    if: lmx_graph_code_within(g, (cast: (@: c.Lmx) frame\body), body) = 0 && frame\data != body
        return: 5
    frame\lexical_scope := body
    return: lmx_graph_space_declarations(g, body)
end: lmx_graph_work_scope

# Capture a directly consumed free input at entry. An int gets its own argument cell; a Structure/reference keeps
# its language reference value. The row lives only in this activation and does not become a field of data.
# CODE places answer through reached rows, never through their source registry.
# Ordinary DATA and bidirectional named Structures keep the existing lookup.
fn: lmx_graph_work_data_find_scope (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: owner c.Lmx; @: name char; @: slot size_t; int: dynamic) size_t
    size_t: i 0U
    size_t: found 0U
    int: place 0
    int: code_role 0
    @: declared char 0
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: enclosing c.LmxGraphFrame frame
    if: enclosing != 0
        code_role := lmx_graph_code_within(g, (cast: (@: c.Lmx) enclosing\body), owner)
    while: active != 0 && code_role = 0
        if: active\frame != 0
            enclosing := (cast: (@: c.LmxGraphFrame) active\frame)
            code_role := lmx_graph_code_within(g, (cast: (@: c.Lmx) enclosing\body), owner)
        ---
        active := active\parent
    ---
    if: code_role = 0
        return: lmx_graph_data_find_scope(g, owner, name, 1, 0U, slot, dynamic, 0)
    slot[0] := c.lmx_graph_count(owner)
    while: i < c.lmx_graph_count(owner)
        if: dynamic != 0 && lmx_graph_field_private(g, owner, i) != 0
            i := i + 1U
            continue
        declared := lmx_graph_binding_name(g, owner, c.lmx_graph_get_in(g, owner, i), 1, @ place)
        if: declared = name && place = 0
            if: found = 0U
                slot[0] := i
            found := found + 1U
        ---
        i := i + 1U
    return: found
end: lmx_graph_work_data_find_scope

fn: lmx_graph_work_data_find (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: owner c.Lmx; @: name char; @: slot size_t) size_t
    return: lmx_graph_work_data_find_scope(g, frame, owner, name, slot, 0)

fn: lmx_graph_work_capture_context (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: name char; int: optional) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: value void 0
    @: head char 0
    @: rows c.LmxGraphWork 0
    @: row c.LmxGraphWork 0
    @: selected c.LmxGraphWork 0
    @: held c.LmxWalkValue 0
    c.LmxWalkValue: captured
    size_t: capacity 0U
    int: kind 0
    @: declared void 0
    int: status 0
    size_t: slot 0U
    int: pending lmx_graph_work_pending(g, frame, name)
    int: declared_local lmx_graph_work_local_declared(g, frame, name)
    if: declared_local != 0
        optional := 1
    if: state = 0 || name = 0
        return: 0
    if: lmx_graph_work_data_find(g, frame, (cast: (@: c.Lmx) frame\data), name, @ slot) > 1U
        if: optional != 0
            return: 0
        return: 3
    row := lmx_graph_work_row(g, frame, name)
    # An already constructed inline callable is local metadata, not an entry
    # free input. It must never become the fallback of a sibling/outer scope.
    if: frame\lexical_scope != frame\body && (row = 0 || row\slot = (cast: (size_t) -1)) && lmx_graph_work_method(g, frame, name) != 0
        slot := lmx_graph_data_slot(g, (cast: (@: c.Lmx) frame\data), name)
        if: slot >= c.lmx_graph_count(frame\data)
            return: 0
    ---
    if: row != 0
        if: optional = 0 && row\slot = (cast: (size_t) -1)
            # Bit8 is entry admission, bit2 is visibility to child calls.
            # A possible local head does not consume its external fallback.
            # Bit4 permits deferral only when every required use is pending.
            if: (row\loaded & 8) = 0 && pending != 0
                row\loaded := row\loaded | 4
            if: pending = 0
                row\loaded := row\loaded & -5
                row\loaded := row\loaded | 2
            ---
            row\loaded := row\loaded | 8
            if: row\cell = 0 && frame\binding_open = 0 && pending = 0
                return: 3
            return: 0
        if: optional = 0 && row\cell = 0 && row\slot != (cast: (size_t) -1)
            return: 3
        return: 0
    # A launch over data it was given admits only directly used data fields, independent of their physical order: a name
    # the data has is its place after formals have been excluded above -- for an ordinary Structure and for a callable
    # launched over data it was given alike (plan M11 5a, the executor's reading B4: the code uses the names of data
    # before a free input). A callable over its own data keeps the places of that data. A Structure of the data -- a
    # named Lmx that declares no place -- gets no row: the code finds it by reference in the registry of the launch's
    # data (lmx_graph_resolve; plan M11 5b), for a callable over its own data too.
    if: lmx_graph_work_data_find(g, frame, (cast: (@: c.Lmx) frame\data), name, @ slot) = 1U
        value := c.lmx_graph_get_in(g, frame\data, slot)
        head := c.lmx_graph_name_of(g, value)
        if: c.lmx_graph_kind(g, value) = 4 && head != 0 && head != state\w_int && head != state\w_at
            return: 0
        return: lmx_graph_work_require(g, frame, name)
    ---
    value := lmx_graph_select_binding(g, (cast: (@: c.Lmx) frame\code), name, @ selected, @ held, @ declared, 0, @ status)
    if: status != 0
        return: status
    # An open local namespace may still declare this name. Keep the entry
    # fallback (including absence); a reached declaration binds the local value.
    if: value = 0 && held = 0 && frame\binding_open = 0 && pending = 0 && optional = 0
        return: 3
    kind := c.lmx_graph_kind(g, value)
    # Borrowed row pointers may be invalidated by reallocating our own rows.
    # Copy their ready record before reserving the new local binding.
    if: held != 0
        status := lmx_graph_work_value(g, selected, held, @ captured)
        if: status != 0
            return: status
        held := @ captured
    ---
    if: frame\count = frame\capacity
        capacity := (cast: (size_t) frame\capacity) * 2U + 8U
        rows := (cast: (@: c.LmxGraphWork) c.realloc((cast: (@: void) frame\rows), capacity * c.sizeof(c.LmxGraphWork)))
        if: rows = 0
            return: 4
        frame\rows := rows
        frame\capacity := capacity
    ---
    rows := frame\rows
    row := rows + (cast: (size_t) frame\count)
    c.memset((cast: (@: void) row), 0, c.sizeof(c.LmxGraphWork))
    row\name := name
    row\slot := (cast: (size_t) -1)
    if: value != 0 || held != 0
        status := lmx_graph_work_snapshot_selected(g, row, value, held)
        if: status != 0
            return: status
    ---
    row\declared := declared
    if: declared_local != 0 && (row\loaded & 1) != 0
        row\loaded := row\loaded | 2
    if: optional = 0
        row\loaded := row\loaded | 8
        if: pending != 0
            row\loaded := row\loaded | 4
        else:
            row\loaded := row\loaded | 2
    ---
    frame\count := frame\count + 1U
    return: 0
end: lmx_graph_work_capture_context

# Ordinary reads are required. An ambiguous written argument may keep a
# potential entry snapshot without making it an input visible to callees.
fn: lmx_graph_work_capture (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: name char) int
    return: lmx_graph_work_capture_context(g, frame, name, 0)

fn: lmx_graph_input_row (@: g c.LmxGraph; @: active c.LmxActivation; @: name char; int: dynamic) @: c.LmxGraphWork
    @: row c.LmxGraphWork 0
    @: frame c.LmxGraphFrame 0
    size_t: slot 0U
    if: active = 0 || active\frame = 0
        return: 0
    frame := (cast: (@: c.LmxGraphFrame) active\frame)
    row := lmx_graph_work_row_scope(g, frame, name, (cast: (@: c.Lmx) frame\lexical_scope), dynamic)
    if: row != 0 && row\scope = 0 && row\slot = (cast: (size_t) -1) && frame\lexical_scope != frame\body && lmx_graph_work_method(g, frame, name) != 0
        return: 0
    if: row = 0 || row\scope != 0 || row\slot != (cast: (size_t) -1) || (row\loaded & 2) != 0
        return: row
    if: active != g\arena\activation
        return: 0
    return: row

# Classification uses resolve without consuming a potential input. Actual
# readers activate only their own row; a child's lookup cannot activate it.
sub: lmx_graph_input_used (@: g c.LmxGraph; @: name char)
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: row c.LmxGraphWork 0
    @: frame c.LmxGraphFrame 0
    if: active = 0 || active\frame = 0
        return
    frame := (cast: (@: c.LmxGraphFrame) active\frame)
    row := lmx_graph_work_row(g, frame, name)
    if: row != 0 && row\scope = 0 && row\slot = (cast: (size_t) -1) && (frame\lexical_scope = frame\body || lmx_graph_work_method(g, frame, name) = 0)
        row\loaded := row\loaded | 2
    return

# Locate a physical DATA place in the existing activation map. Row indices remain
# valid when an operand call grows the rows; a borrowed row pointer does not.
fn: lmx_graph_work_slot (@: frame c.LmxGraphFrame; size_t: slot) size_t
    @: rows c.LmxGraphWork frame\rows
    @: row c.LmxGraphWork 0
    size_t: i 0U
    while: i < frame\count
        row := rows + i
        if: slot != (cast: (size_t) -1) && row\slot = slot
            return: i
        i := i + 1U
    return: frame\count

# Bind one physical place without selecting by name or loading its old payload.
fn: lmx_graph_work_bind_slot (@: g c.LmxGraph; @: frame c.LmxGraphFrame; size_t: slot; @: name char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: rows c.LmxGraphWork frame\rows
    @: row c.LmxGraphWork 0
    size_t: at lmx_graph_work_slot(frame, slot)
    size_t: capacity 0U
    @: cell void 0
    if: name = 0 || state = 0 || slot >= c.lmx_graph_count(frame\data)
        return: 3
    if: at < frame\count
        row := rows + at
        if: row\cell != 0
            return: 0
        return: 3
    # Bind the physical cell or the retained computed declaration. Its initializer
    # is code and never runs merely because this data was supplied to a launch.
    cell := lmx_graph_data_cell(g, (cast: (@: c.Lmx) frame\data), slot)
    if: cell = 0 && c.lmx_graph_name_of(g, c.lmx_graph_get_in(g, frame\data, slot)) = state\w_at
        return: 5
    if: cell = 0
        return: 4
    if: frame\count = frame\capacity
        capacity := (cast: (size_t) frame\capacity) * 2U + 8U
        rows := (cast: (@: c.LmxGraphWork) c.realloc((cast: (@: void) rows), capacity * c.sizeof(c.LmxGraphWork)))
        if: rows = 0
            return: 4
        frame\rows := rows
        frame\capacity := capacity
    ---
    row := rows + (cast: (size_t) frame\count)
    c.memset((cast: (@: void) row), 0, c.sizeof(c.LmxGraphWork))
    row\name := name
    row\slot := slot
    row\declared := c.lmx_graph_get_in(g, (cast: (@: c.Lmx) frame\data), slot)
    if: lmx_graph_work_snapshot(g, row, cell) != 0
        return: 4
    frame\count := frame\count + 1U
    return: 0
end: lmx_graph_work_bind_slot

# A name requirement must be unique even when a row of that name already exists.
fn: lmx_graph_work_require (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: name char) int
    size_t: slot 0U
    if: lmx_graph_work_data_find(g, frame, (cast: (@: c.Lmx) frame\data), name, @ slot) != 1U
        return: 3
    return: lmx_graph_work_bind_slot(g, frame, slot, name)

# A reached declaration reuses a visible local or DATA place. A new CODE name
# gets an activation-owned row at its lexical scope, never a field appended to DATA.
# DATA/code identity keeps each physical occurrence independently addressable.
fn: lmx_graph_work_site (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: holder c.Lmx; size_t: index; @: at size_t) int
    @: raw void c.lmx_graph_get_in(g, holder, index)
    @: name char lmx_graph_own_name(g, raw)
    @: rows c.LmxGraphWork 0
    @: row c.LmxGraphWork 0
    size_t: slot index
    size_t: i 0U
    size_t: selected 0U
    size_t: capacity 0U
    size_t: matches 0U
    int: required lmx_graph_own_kind(g, raw)
    int: status 0
    if: frame = 0 || name = 0 || at = 0 || frame\lexical_scope = 0
        return: 3
    if: required = 0
        return: 5
    rows := frame\rows
    selected := frame\count
    row := lmx_graph_work_row(g, frame, name)
    if: row != 0 && (row\scope != 0 || row\slot != (cast: (size_t) -1))
        while: selected = frame\count && i < frame\count
            if: frame\rows + i = row
                selected := i
            i := i + 1U
        ---
    ---
    if: selected = frame\count && holder = frame\data
        status := lmx_graph_work_bind_slot(g, frame, index, name)
        if: status != 0
            return: status
        selected := lmx_graph_work_slot(frame, index)
        row := frame\rows + selected
        row\loaded := row\loaded | 16
    ---
    if: selected = frame\count
        matches := lmx_graph_work_data_find(g, frame, (cast: (@: c.Lmx) frame\data), name, @ slot)
        if: matches > 1U
            return: 3
        if: matches = 1U
            status := lmx_graph_work_bind_slot(g, frame, slot, name)
            if: status != 0
                return: status
            selected := lmx_graph_work_slot(frame, slot)
        ---
    ---
    if: selected = frame\count
        i := 0U
        while: i < frame\count
            row := frame\rows + i
            if: row\scope = frame\lexical_scope && row\slot = (cast: (size_t) -1) && row\name = name && (row\loaded & 16) = 0
                selected := i
                break
            i := i + 1U
        ---
        if: selected = frame\count
            if: frame\count = frame\capacity
                capacity := (cast: (size_t) frame\capacity) * 2U + 8U
                rows := (cast: (@: c.LmxGraphWork) c.realloc((cast: (@: void) frame\rows), capacity * c.sizeof(c.LmxGraphWork)))
                if: rows = 0
                    return: 4
                frame\rows := rows
                frame\capacity := capacity
            ---
            frame\count := frame\count + 1U
        ---
        row := frame\rows + selected
        c.memset((cast: (@: void) row), 0, c.sizeof(c.LmxGraphWork))
        row\name := name
        row\scope := frame\lexical_scope
        row\slot := (cast: (size_t) -1)
        row\expected_kind := required
        row\declared := c.lmx_graph_get_in(g, holder, index)
        status := lmx_graph_work_snapshot(g, row, raw)
        if: status != 0
            return: status
        row\loaded := row\loaded | 16
    ---
    at[0] := selected
    row := frame\rows + selected
    if: holder = frame\data
        slot := lmx_graph_work_slot(frame, index)
        if: slot < frame\count && slot != selected
            rows := frame\rows + slot
            if: (rows\loaded & 32) != 0
                row\cell := rows\cell
                row\number := rows\number
                c.memcpy((cast: (@: void) (@ row\value)), (cast: (const: @: void) (@ rows\value)), c.sizeof(c.LmxWalkValue))
                row\loaded := (row\loaded & -2) | (rows\loaded & 1)
            ---
        ---
    ---
    if: lmx_graph_own_kind(g, (cast: (@: void) row\cell)) != required || (row\expected_kind != 0 && row\expected_kind != required)
        return: 4
    return: 0
end: lmx_graph_work_site

# Does a Frame of the code a frame scans launch -- the receiver call or fncall, or a record whose head is an ordinary
# Structure, directly or through a reference place (lmx_graph_eval_launch_record)? Its operands are then operands of a
# launch (lmx_graph_launch_operand), and its named actuals select formals of the launch. 1 or 0.
fn: lmx_graph_scan_launch (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: lead char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: target void 0
    if: state = 0 || lead = 0
        return: 0
    if: lead = state\w_call || lead = state\w_fncall
        return: 1
    if: lmx_graph_language_word(state, lead) != 0
        return: 0
    if: frame\binding_open != 0 || lmx_graph_work_pending(g, frame, lead) != 0
        return: 0
    target := c.lmx_graph_target(g, lmx_graph_resolve(g, (cast: (@: c.Lmx) frame\code), lead))
    if: c.lmx_graph_kind(g, target) = 4 && c.lmx_graph_method(g, (cast: (@: c.Lmx) target)) = 0
        return: 1
    return: 0
end: lmx_graph_scan_launch

# The existing control receivers select inline code explicitly. 1 is a body
# argument, 2 a for-header, 3 a container whose own fields are code (else, finally: their one written argument group is selected once, as the code
# they run), 4 a container whose own fields are code AS WRITTEN (the record L2, the book #two-kinds-of-receivers: its arguments are not opened, a lone
# written Structure stays one field of it). Other arguments are values/expressions; call and fn open their own activations.
fn: lmx_graph_code_argument (@: g c.LmxGraph; @: current c.Lmx; size_t: index) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: head char c.lmx_graph_name_of(g, (cast: (@: void) current))
    if: head = state\w_else || head = state\w_finally
        return: 3
    if: head = state\w_l2
        return: 4
    if: index = 1U && (head = state\w_if || head = state\w_while || head = state\w_until || head = state\w_for)
        return: 1
    if: index = 0U && head = state\w_for
        return: 2
    return: 0

# Is role (lmx_graph_code_argument, lmx_graph_code_body) the role of a container whose own fields are code: 3 (else, finally) or 4 (the record L2)?
fn: lmx_graph_role_code (int: role) int
    return: (cast: (int) (role = 3 || role = 4))

# The middle field of an actual for-header is an expression, not a declaration.
fn: lmx_graph_code_condition (@: g c.LmxGraph; @: scope c.Lmx; size_t: index) int
    if: index = 1U && scope\parent != 0 && c.lmx_graph_get_in(g, (cast: (@: c.Lmx) scope\parent), 0U) = (cast: (@: void) scope) && lmx_graph_code_argument(g, (cast: (@: c.Lmx) scope\parent), 0U) = 2
        return: 1
    return: 0

# The borrowed view at an inline receiver's receiving boundary. Only a whole
# tail (else/finally) selects its sole written argument group once. Bodies
# already selected by if/loops keep all their fields, including inert groups.
# Neither selection nor execution changes the physical holder or its parent.
fn: lmx_graph_code_body (@: g c.LmxGraph; @: current c.Lmx; size_t: index; @@: out_body c.Lmx; @: out_from size_t; @: out_to size_t) int
    @: selected c.Lmx current
    @: raw void 0
    int: role lmx_graph_code_argument(g, current, index)
    if: out_body = 0 || out_from = 0 || out_to = 0
        return: 0
    out_body[0] := 0
    out_from[0] := 0U
    out_to[0] := 0U
    if: role = 0
        return: 0
    if: role = 1 || role = 2
        raw := c.lmx_graph_get_in(g, current, index)
        if: c.lmx_graph_kind(g, raw) != 4
            return: 0
        selected := (cast: (@: c.Lmx) raw)
    if: role = 3 && c.lmx_graph_count(current) = 1U && lmx_graph_written_group(g, c.lmx_graph_get_in(g, current, 0U)) != 0
        selected := (cast: (@: c.Lmx) c.lmx_graph_get_in(g, current, 0U))
    out_body[0] := selected
    out_to[0] := c.lmx_graph_count(selected)
    return: role

fn: lmx_graph_work_scan_word (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: word char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: row c.LmxGraphWork 0
    int: status 0
    if: word = 0 || lmx_graph_language_word(state, word) != 0
        return: 0
    status := lmx_graph_work_capture(g, frame, word)
    row := lmx_graph_work_row(g, frame, word)
    if: status = 0 && row != 0 && row\slot != (cast: (size_t) -1)
        row\loaded := row\loaded | 2
    return: status

# Normalize only the fields of an explicitly consumed body into the existing
# statement queue. Written anonymous values and constructed fn values stand.
# No new queue or saved graph is needed, including for cyclic/shared bodies.
fn: lmx_graph_work_scan_body (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: body c.Lmx; size_t: from; size_t: to; @@@: queue c.Lmx; @: count size_t; @: cap size_t) int
    @: raw void 0
    @: prior_scope c.Lmx frame\lexical_scope
    size_t: i from
    int: kind 0
    int: status 0
    frame\lexical_scope := body
    while: i < to && status = 0
        raw := c.lmx_graph_get_in(g, body, i)
        kind := c.lmx_graph_kind(g, raw)
        # Scanning consumes neither a declaration nor its local place. Only
        # reaching that statement makes the CODE name visible in this frame.
        if: kind = 4
            if: c.lmx_graph_fn_result(g, raw) = 0 && lmx_graph_written_group(g, raw) = 0
                status := c.lmx_graph_scan_add(queue, count, cap, (cast: (@: c.Lmx) raw))
            ---
        ---
        i := i + 1U
    frame\lexical_scope := prior_scope
    return: status
end: lmx_graph_work_scan_body

# The formed receiver/operator selects a value context. Structure/address
# consumers keep a written group; prefix address/dereference stay expressions.
fn: lmx_graph_value_contract (@: g c.LmxGraph; @: expression c.Lmx; size_t: index) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: head char c.lmx_graph_name_of(g, (cast: (@: void) expression))
    @: op char 0
    if: head = state\w_length || head = state\w_typeof || lmx_graph_deferred_kind(g, (cast: (@: void) expression)) = 6
        return: 2
    if: head = 0 && index = 0U && c.lmx_graph_count(expression) = 3U
        op := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, expression, 1U))
        if: op = state\w_deref || op = state\w_index
            return: 2
    ---
    return: 0

# A destination can remain dynamic until data has run. Keep potential RHS
# snapshots optional in that case; classification never consumes their values.
fn: lmx_graph_work_assignment_contract (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: left void) int
    @: name char c.lmx_graph_word_text(g, left)
    @: row c.LmxGraphWork 0
    @: active c.LmxActivation (cast: (@: c.LmxActivation) frame\activation)
    @: args c.Lmx (cast: (@: c.Lmx) frame\data)
    size_t: slot 0U
    int: kind 0
    if: c.lmx_graph_index_form(g, left) != 0
        return: 2
    if: name = 0
        return: -1
    row := lmx_graph_work_row(g, frame, name)
    if: row != 0
        if: row\slot = (cast: (size_t) -1) && (frame\binding_open != 0 || lmx_graph_work_pending(g, frame, name) != 0)
            return: -1
        kind := row\expected_kind
        if: lmx_graph_scalar_pool(g, (cast: (@: void) row\cell)) != 0
            return: 0
        if: kind = 0
            kind := lmx_graph_own_kind(g, (cast: (@: void) row\cell))
        ---
    else:
        slot := c.lmx_graph_formal(g, args, name)
        if: active != 0 && active\refs != 0 && slot < active\width && slot < c.lmx_graph_count(args)
            kind := lmx_graph_own_kind(g, (cast: (@: void) active\refs[slot]))
        ---
    ---
    if: kind = 6
        return: 2
    if: kind = 1 || kind = 5
        return: 0
    return: -1

# One body traversal captures free inputs and records needed own loads. After data, loading iterates only rows,
# never the body again. Nested methods are not scanned, and a selector is not an input; no transitive interface.
# Context 0 scans code, 1 a consumed expression, 2 an argument whose receiving
# contract is not available until data has run. Only the last keeps optional
# entry snapshots. The existing work rows become inputs when actually read.
# One operand of the body scan that is read as an expression: a Frame is scanned in the context of the scan, a word that is no word of the
# language and no quoted text is a free input.
fn: lmx_graph_work_scan_operand (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: raw void; int: optional) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: word char 0
    int: context 1
    if: optional != 0
        context := 2
    if: c.lmx_graph_kind(g, raw) = 4
        return: lmx_graph_work_scan_context(g, frame, (cast: (@: c.Lmx) raw), context)
    word := c.lmx_graph_word_text(g, raw)
    if: word = 0 || word[0] = 34 || lmx_graph_language_word(state, word) != 0
        return: 0
    return: lmx_graph_work_capture_context(g, frame, word, optional)

# For the body scan: the Message of `send` defines its field names, never free inputs of the body; the value of each field and the Ref
# written before the Message are read.
fn: lmx_graph_work_scan_send (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: statement c.Lmx; int: optional) int
    @: message c.Lmx 0
    @: field c.Lmx 0
    size_t: n c.lmx_graph_count(statement)
    size_t: i 0U
    size_t: j 0U
    int: status 0
    if: n < 1U
        return: 5
    while: i + 1U < n && status = 0
        status := lmx_graph_work_scan_operand(g, frame, c.lmx_graph_get_in(g, statement, i), optional)
        i := i + 1U
    message := (cast: (@: c.Lmx) c.lmx_graph_get_in(g, statement, n - 1U))
    if: c.lmx_graph_kind(g, (cast: (@: void) message)) != 4
        return: 5
    while: j < c.lmx_graph_count(message) && status = 0
        field := (cast: (@: c.Lmx) c.lmx_graph_get_in(g, message, j))
        if: c.lmx_graph_kind(g, (cast: (@: void) field)) = 4 && c.lmx_graph_count(field) = 1U
            status := lmx_graph_work_scan_operand(g, frame, c.lmx_graph_get_in(g, field, 0U), optional)
        j := j + 1U
    return: status

fn: lmx_graph_work_scan_context (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: body c.Lmx; int: context) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: prior_scope c.Lmx frame\lexical_scope
    @: role_scope c.Lmx 0
    @@: queue c.Lmx 0
    size_t: count 0U
    size_t: cap 0U
    size_t: at 0U
    size_t: i 0U
    size_t: n 0U
    @: current c.Lmx 0
    @: raw void 0
    @: word char 0
    @: op char 0
    @: lead char 0
    @: head_expr void 0
    @: actuals c.Lmx 0
    @: row c.LmxGraphWork 0
    @: target c.Lmx 0
    @: bindings size_t 0
    @: seen int 0
    size_t: binding_cap 0U
    size_t: seen_cap 0U
    size_t: width 0U
    int: contract 0
    int: reading 0
    int: nested 0
    int: role 0
    @: header c.Lmx 0
    size_t: code_from 0U
    size_t: code_to 0U
    int: optional (cast: (int) (context = 2))
    int: framed 0
    int: call_head 0
    int: status 0
    if: context = 0
        status := lmx_graph_work_scan_body(g, frame, body, 0U, c.lmx_graph_count(body), @ queue, @ count, @ cap)
    else:
        status := c.lmx_graph_scan_add(@ queue, @ count, @ cap, body)
    while: at < count && status = 0
        current := queue[at]
        at := at + 1U
        if: context = 0 && lmx_graph_code_within(g, (cast: (@: c.Lmx) frame\body), (cast: (@: c.Lmx) current\parent)) != 0
            frame\lexical_scope := (cast: (@: c.Lmx) current\parent)
        raw := c.lmx_graph_binding_leaf(g, (cast: (@: void) current))
        if: c.lmx_graph_kind(g, raw) != 4
            continue
        current := (cast: (@: c.Lmx) raw)
        if: c.lmx_graph_fn_result(g, (cast: (@: void) current)) != 0
            continue
        n := c.lmx_graph_count(current)
        lead := c.lmx_graph_name_of(g, (cast: (@: void) current))
        # Queue entries are executable fields or consumed expressions. Bodies
        # were normalized by their consumer, so a named field always has a head.
        framed := (cast: (int) (lead != 0))
        if: context = 0 && lmx_graph_role_code(lmx_graph_code_argument(g, current, 0U)) != 0
            lmx_graph_code_body(g, current, 0U, @ header, @ code_from, @ code_to)
            status := lmx_graph_work_scan_body(g, frame, header, code_from, code_to, @ queue, @ count, @ cap)
            continue
        # The operand of include and predef is text, not a name: it is no free input.
        if: framed != 0 && (lead = state\w_fn || lead = state\w_sub || lead = state\w_fm || lead = state\w_include || lead = state\w_predef)
            continue
        # `send: Message(field: value; ...)` (the book, send): the Message defines its field names, never free inputs of the body; the
        # written values and the written Ref before the Message are read as the operands of any Frame.
        if: framed != 0 && lead = state\w_send
            status := lmx_graph_work_scan_send(g, frame, current, optional)
            continue
        # An expression head is consumed first. Its actuals borrow the same
        # call view as a named Frame; the application marker is never an input.
        if: framed = 0 && c.lmx_graph_application_parts(g, (cast: (@: void) current), 0, @ head_expr, @ actuals) != 0
            if: lmx_graph_written_group(g, head_expr) = 0
                if: c.lmx_graph_kind(g, head_expr) = 4
                    nested := 1
                    if: optional != 0
                        nested := 2
                    status := lmx_graph_work_scan_context(g, frame, (cast: (@: c.Lmx) head_expr), nested)
                else:
                    status := lmx_graph_work_capture_context(g, frame, c.lmx_graph_word_text(g, head_expr), optional)
                ---
            ---
            if: status != 0
                break
            current := actuals
            n := c.lmx_graph_count(current)
            lead := 0
            framed := 1
        ---
        # A non-language Frame in code is a call, regardless of whether its
        # target is available yet. Actual names select formals, and a written
        # data operand is not a scope to scan. No callee is constructed here.
        call_head := (cast: (int) (framed != 0 && lmx_graph_language_word(state, lead) = 0))
        if: framed != 0
            word := lead
            op := 0
            if: n != 0U
                op := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, current, 0U))
            ---
        else:
            word := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, current, 0U))
            op := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, current, 1U))
            lead := word
        ---
        if: framed = 0 && n = 2U && word = state\w_at
            raw := c.lmx_graph_get_in(g, current, 1U)
            while: c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_count((cast: (@: c.Lmx) raw)) = 1U && c.lmx_graph_name_of(g, raw) = 0
                raw := c.lmx_graph_get_in(g, (cast: (@: c.Lmx) raw), 0U)
            word := c.lmx_graph_word_text(g, raw)
            if: word != 0
                status := lmx_graph_work_capture_context(g, frame, word, optional)
                continue
            ---
        ---
        i := 0U
        if: framed != 0 && (word = state\w_int || word = state\w_at)
            i := 1U
        else:
            # The head of a Frame names a place or a callable of this code: a free input, never a load by itself.
            if: framed != 0 && word != 0 && lmx_graph_language_word(state, word) = 0
                status := lmx_graph_work_capture_context(g, frame, word, optional)
            ---
        ---
        target := 0
        reading := 0
        if: call_head != 0 && lead != 0 && optional = 0 && status = 0
            target := (cast: (@: c.Lmx) c.lmx_graph_target(g, lmx_graph_resolve(g, (cast: (@: c.Lmx) frame\code), lead)))
            row := lmx_graph_work_row(g, frame, lead)
            # A data receiver can still shadow an entry fallback or assign a
            # local reference. Query only a target fixed for this entry pass.
            if: c.lmx_graph_method(g, target) = 0 || (row != 0 && (row\slot != (cast: (size_t) -1) || frame\binding_open != 0 || lmx_graph_work_pending(g, frame, lead) != 0))
                target := 0
            if: target != 0
                width := c.lmx_graph_count(c.lmx_graph_method_data(g, target))
                if: binding_cap < n + 1U
                    c.free((cast: (@: void) bindings))
                    binding_cap := n + 1U
                    bindings := (cast: (@: size_t) c.calloc(binding_cap, sizeof(size_t)))
                if: seen_cap < width + 1U
                    c.free((cast: (@: void) seen))
                    seen_cap := width + 1U
                    seen := (cast: (@: int) c.calloc(seen_cap, sizeof(int)))
                if: bindings = 0 || seen = 0
                    status := 4
                    break
                reading := lmx_graph_call_reading(g, (cast: (@: c.Lmx) frame\code), target, current, 0)
                if: reading < 0
                    status := 4
                    break
                c.memset((cast: (@: void) seen), 0, seen_cap * sizeof(int))
                if: reading = 0 && lmx_graph_bind_formals(g, c.lmx_graph_method_data(g, target), current, bindings, 0, seen) != 0
                    target := 0
                ---
            ---
        ---
        while: i < n && status = 0
            if: framed = 0 && n = 3U && op = state\w_deref && i = 2U
                i := i + 1U
                continue
            raw := c.lmx_graph_get_in(g, current, i)
            if: lmx_graph_written_group(g, raw) != 0
                if: lmx_graph_value_contract(g, current, i) = 2
                    i := i + 1U
                    continue
                if: framed = 0 && n = 3U && i = 2U && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, current, 0U)) = state\w_assign
                    contract := lmx_graph_work_assignment_contract(g, frame, c.lmx_graph_get_in(g, current, 1U))
                    if: contract = 2
                        i := i + 1U
                        continue
                    if: contract < 0 && context != 2
                        status := lmx_graph_work_scan_context(g, frame, (cast: (@: c.Lmx) raw), 2)
                        i := i + 1U
                        continue
                    ---
                ---
            ---
            if: context = 0 && framed != 0
                role := lmx_graph_code_body(g, current, i, @ header, @ code_from, @ code_to)
                if: role = 1
                    status := lmx_graph_work_scan_body(g, frame, header, code_from, code_to, @ queue, @ count, @ cap)
                    i := i + 1U
                    continue
                if: role = 2 && code_to = 3U
                    status := lmx_graph_work_scan_body(g, frame, header, 0U, 1U, @ queue, @ count, @ cap)
                    raw := c.lmx_graph_get_in(g, header, 1U)
                    role_scope := frame\lexical_scope
                    frame\lexical_scope := header
                    if: status = 0
                        if: c.lmx_graph_kind(g, raw) = 4
                            status := lmx_graph_work_scan_context(g, frame, (cast: (@: c.Lmx) raw), 1)
                        else:
                            status := lmx_graph_work_scan_word(g, frame, c.lmx_graph_word_text(g, raw))
                        ---
                    ---
                    frame\lexical_scope := role_scope
                    if: status = 0
                        status := lmx_graph_work_scan_body(g, frame, header, 2U, 3U, @ queue, @ count, @ cap)
                    i := i + 1U
                    continue
                ---
            ---
            # A named actual selects the callee's formal, or a formal of a launch (lmx_graph_scan_launch), never a free
            # input of this caller.
            if: framed != 0 && c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, (cast: (@: c.Lmx) raw), 0U)) = state\w_assign
                if: call_head != 0
                    if: c.lmx_graph_count((cast: (@: c.Lmx) raw)) != 3U
                        status := 5
                        break
                    raw := c.lmx_graph_get_in(g, (cast: (@: c.Lmx) raw), 2U)
                else:
                    if: c.lmx_graph_count((cast: (@: c.Lmx) raw)) = 3U && lmx_graph_scan_launch(g, frame, lead) != 0
                        raw := c.lmx_graph_get_in(g, (cast: (@: c.Lmx) raw), 2U)
                    ---
                ---
            ---
            # The written fields of an anonymous Structure operand of merge define their names; only their values are
            # read (lmx_graph_merge_literal, lmx_graph_work_scan_literal).
            if: framed != 0 && lead = state\w_merge && lmx_graph_merge_literal(g, (cast: (@: c.Lmx) frame\code), raw) != 0
                status := lmx_graph_work_scan_literal(g, frame, (cast: (@: c.Lmx) raw), optional)
                i := i + 1U
                continue
            ---
            # A callable receives this written Structure as data. Its fields
            # are not declarations or free inputs of the caller's frame.
            if: call_head != 0 && lmx_graph_written_group(g, raw) != 0
                contract := 0
                if: target != 0 && reading = 0
                    contract := lmx_graph_actual_contract(g, target, bindings[i])
                if: reading = 2 || contract = 2
                    i := i + 1U
                    continue
                nested := 1
                if: optional != 0 || (target = 0 && reading = 0)
                    nested := 2
                if: context != nested
                    status := lmx_graph_work_scan_context(g, frame, (cast: (@: c.Lmx) raw), nested)
                    i := i + 1U
                    continue
                ---
            ---
            # Such an operand of a launch is data as written (lmx_graph_launch_operand; R21, item 4): this code reads
            # nothing of it.
            if: framed != 0 && lmx_graph_written_group(g, raw) != 0 && lmx_graph_scan_launch(g, frame, lead) != 0
                i := i + 1U
                continue
            ---
            if: c.lmx_graph_kind(g, raw) = 4
                if: context = 0
                    status := lmx_graph_work_scan_context(g, frame, (cast: (@: c.Lmx) raw), 1)
                else:
                    status := c.lmx_graph_scan_add(@ queue, @ count, @ cap, (cast: (@: c.Lmx) raw))
                ---
            else:
                word := c.lmx_graph_word_text(g, raw)
                if: word != 0 && lmx_graph_language_word(state, word) = 0
                    status := lmx_graph_work_capture_context(g, frame, word, optional)
                    if: status = 0
                        row := lmx_graph_work_row(g, frame, word)
                        # Every word argument of a Frame is read; in an expression the left operand of `:=` is written,
                        # and the first field is read when it is an operand.
                        if: optional = 0 && row != 0 && row\slot != (cast: (size_t) -1) && (framed != 0 || ((i != 1U || c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, current, 0U)) != state\w_assign) && (i != 0U || n = 1U || op = state\w_plus || op = state\w_minus || op = state\w_star || op = state\w_slash || op = state\w_percent || op = state\w_deref || op = state\w_eq || op = state\w_ne || op = state\w_lt || op = state\w_le || op = state\w_gt || op = state\w_ge || op = state\w_and || op = state\w_or)))
                            row\loaded := row\loaded | 2
                        ---
                    ---
                ---
            ---
            i := i + 1U
        ---
    ---
    c.free((cast: (@: void) queue))
    c.free((cast: (@: void) bindings))
    c.free((cast: (@: void) seen))
    frame\lexical_scope := prior_scope
    return: status

fn: lmx_graph_work_scan (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: body c.Lmx) int
    return: lmx_graph_work_scan_context(g, frame, body, 0)

fn: lmx_graph_work_finish (@: g c.LmxGraph; @: frame c.LmxGraphFrame; int: status) int
    if: frame\activation != 0
        frame\activation\frame := frame\prior
    c.free((cast: (@: void) frame\rows))
    frame\rows := 0
    frame\count := 0U
    return: status
end: lmx_graph_work_finish

# One invocation owns its namespace. Only DATA root fields are installed at
# entry; CODE declarations create their local rows when reached. No default
# expression or initializer runs here, and no local is published to the graph.
fn: lmx_graph_work_open_parts (@: g c.LmxGraph; @: code c.Lmx; @: data c.Lmx; @: body c.Lmx; @: result char; @: frame c.LmxGraphFrame) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: raw void 0
    @: head char 0
    @: row c.LmxGraphWork 0
    @: supplied c.LmxWalkValue 0
    @: name char 0
    size_t: i 0U
    int: place 0
    int: expected 0
    int: status 0
    if: frame = 0 || active = 0 || active\code != code || data = 0 || body = 0
        return: 5
    c.memset((cast: (@: void) frame), 0, c.sizeof(c.LmxGraphFrame))
    frame\code := code
    frame\data := data
    frame\body := body
    frame\lexical_scope := body
    frame\result := result
    frame\capacity := c.lmx_graph_count(data) + 8U
    frame\rows := (cast: (@: c.LmxGraphWork) c.calloc(frame\capacity, c.sizeof(c.LmxGraphWork)))
    if: frame\rows = 0
        return: 4
    frame\activation := active
    frame\prior := active\frame
    active\frame := frame
    status := lmx_graph_space_declarations(g, data)
    if: status = 0 && body != data
        status := lmx_graph_space_declarations(g, body)
    while: i < c.lmx_graph_count(data) && status = 0
        raw := c.lmx_graph_binding_leaf(g, c.lmx_graph_get_in(g, data, i))
        head := c.lmx_graph_name_of(g, raw)
        if: c.lmx_graph_kind(g, raw) = 4 && (head = state\w_fn || head = state\w_sub)
            i := i + 1U
            continue
        name := lmx_graph_binding_name(g, data, raw, 1, @ place)
        if: name = 0
            i := i + 1U
            continue
        row := frame\rows + frame\count
        row\name := name
        row\slot := i
        row\declared := c.lmx_graph_get_in(g, data, i)
        if: data = body && place != 0
            row\scope := body
        expected := lmx_graph_own_kind(g, raw)
        # refs describe supplied actuals, never formal declarations. A null
        # entry selects the original value/description without evaluating it.
        supplied := 0
        if: active\values != 0 && i < active\width
            supplied := (cast: (@: c.LmxWalkValue) active\values) + i
            if: supplied\kind = 0
                supplied := 0
            ---
        ---
        if: supplied != 0
            row\loaded := row\loaded | 32
            status := lmx_graph_work_snapshot_value(g, row, supplied)
        else:
            if: active\refs != 0 && i < active\width && active\refs[i] != 0
                raw := active\refs[i]
                row\loaded := row\loaded | 32
            status := lmx_graph_work_snapshot(g, row, raw)
        ---
        row\expected_kind := expected
        frame\count := frame\count + 1U
        i := i + 1U
    ---
    if: status = 0
        status := lmx_graph_work_scan(g, frame, body)
    if: status != 0
        return: lmx_graph_work_finish(g, frame, status)
    return: 0
end: lmx_graph_work_open_parts

# The launch of code over data by the parts code itself carries: a callable has data, code and result
# description; an ordinary Structure is its own body, has no separate header or result,
# and requires its places through the same body scan and data map. A child named
# data is an ordinary written field, never an implicit model. Native entries and
# the interpreter open their frame here; a receiver given the parts uses the same
# lmx_graph_work_open_parts.
fn: lmx_graph_work_open_data (@: g c.LmxGraph; @: code c.Lmx; @: data c.Lmx; @: frame c.LmxGraphFrame) int
    if: c.lmx_graph_method(g, code) != 0
        return: lmx_graph_work_open_parts(g, code, data, c.lmx_graph_method_code(g, code), c.lmx_graph_word_text(g, c.lmx_graph_method_return(g, code)), frame)
return: lmx_graph_work_open_parts(g, code, data, code, 0, frame)

fn: lmx_graph_work_open (@: g c.LmxGraph; @: code c.Lmx; @: frame c.LmxGraphFrame) int
    return: lmx_graph_work_open_data(g, code, c.lmx_graph_method_data(g, code), frame)
end: lmx_graph_work_open

# The unified DATA of an activation, either explicitly supplied or selected
# from its callable. Zero for an activation without such a data root.
fn: lmx_graph_activation_data (@: g c.LmxGraph; @: active c.LmxActivation) @: c.Lmx
    @: frame c.LmxGraphFrame 0
    if: active = 0
        return: 0
    if: active\frame != 0
        frame := (cast: (@: c.LmxGraphFrame) active\frame)
        return: (cast: (@: c.Lmx) frame\data)
    if: c.lmx_graph_method(g, active\code) != 0
        return: c.lmx_graph_method_data(g, active\code)
    return: 0
end: lmx_graph_activation_data

# A bare int name reads the current working value before caller bindings and lexical graph data. Explicit paths
# read the source graph. Argument operands snapshot the local value before a later actual can change it.
fn: lmx_graph_named_int (@: g c.LmxGraph; @: scope c.Lmx; @: name char; @: out int) int
    @: row c.LmxGraphWork 0
    @: value void 0
    int: status 0
    lmx_graph_input_used(g, name)
    value := lmx_graph_resolve_binding_context(g, scope, name, @ row, 1, @ status)
    if: status != 0
        return: status
    if: row != 0
        status := lmx_graph_work_load(g, row)
        if: status != 0
            return: status
        if: lmx_graph_scalar_pool(g, (cast: (@: void) row\cell)) != 0 || lmx_graph_own_kind(g, (cast: (@: void) row\cell)) != 1
            return: 4
        out[0] := row\number
        return: 0
    if: value = 0
        return: 3
    return: c.lmx_graph_value_int(g, value, out)
end: lmx_graph_named_int

# A value reader retains refusal status for a deferred place. Classification
# through resolve must never expose its declaration as an ordinary Structure.
fn: lmx_graph_operand_read (@: g c.LmxGraph; @: scope c.Lmx; @: name char; @@: out void) int
    @: row c.LmxGraphWork 0
    @: working c.LmxWalkValue 0
    @: value void 0
    int: kind 0
    int: number 0
    int: status 0
    if: out = 0
        return: 4
    out[0] := 0
    lmx_graph_input_used(g, name)
    value := lmx_graph_resolve_binding_context(g, scope, name, @ row, 1, @ status)
    if: status != 0
        return: status
    if: row != 0
        status := lmx_graph_work_load(g, row)
        if: status != 0
            return: status
        value := row\cell
    if: row != 0 && lmx_graph_scalar_pool(g, (cast: (@: void) row\cell)) != 0
        status := lmx_graph_work_load(g, row)
        if: status != 0
            return: status
        working := (cast: (@: c.LmxWalkValue) (@ row\value))
        if: working\present = 0
            return: 5
        if: c.lmx_walk_value_materialize(g\arena, working, out) != c.LMX_WALK_OK || out[0] = 0
            return: 4
        return: 0
    if: value = 0
        return: 3
    kind := c.lmx_graph_kind(g, value)
    if: kind = 1 || kind = 3
        status := lmx_graph_named_int(g, scope, name, @ number)
        if: status != 0
            return: status
        value := c.lmx_graph_int(g, number)
    if: kind = 5 || kind = 6 || kind = 8 || kind = 9
        value := lmx_graph_reference_value(g, value)
    if: value = 0
        return: 4
    out[0] := value
    return: 0

fn: lmx_graph_operand_name (@: g c.LmxGraph; @: scope c.Lmx; @: name char) @: void
    @: value void 0
    if: lmx_graph_operand_read(g, scope, name, @ value) != 0
        return: 0
    return: value
end: lmx_graph_operand_name

# A typed declaration without a candidate verifies its already allocated local place; it reads no value and
# resets nothing. Own fields were collected by construction, formals were admitted by the call.
fn: lmx_graph_local_int (@: g c.LmxGraph; @: code c.Lmx; @: name char) int
    return: lmx_graph_known_int(g, code, name, 0)
end: lmx_graph_local_int

# The stable destination is an argument index, then an existing work-row index.
# The activation's width is fixed; row addresses may change across an RHS call.
fn: lmx_graph_place_name (@: g c.LmxGraph; @: code c.Lmx; @: name char; @: token size_t; @: kind int) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: frame c.LmxGraphFrame 0
    @: args c.Lmx 0
    @: row c.LmxGraphWork 0
    @: value void 0
    size_t: slot 0U
    size_t: at 0U
    size_t: selected 0U
    int: actual 0
    if: name = 0 || token = 0 || kind = 0
        return: 3
    if: active = 0 || active\code != code || active\frame = 0
        return: 5
    frame := (cast: (@: c.LmxGraphFrame) active\frame)
    row := lmx_graph_work_row(g, frame, name)
    if: row = 0
        if: lmx_graph_work_method(g, frame, name) != 0
            return: 4
        return: 3
    # A callable of this scope named like a free input is no place: the input row does not make it one.
    if: row\slot = (cast: (size_t) -1) && lmx_graph_work_method(g, frame, name) != 0
        return: 4
    at := 0U
    while: at < frame\count && frame\rows + at != row
        at := at + 1U
    if: at >= (cast: (size_t) -1) - active\width
        return: 4
    selected := active\width + at
    value := row\cell
    lmx_graph_input_used(g, name)
    actual := lmx_graph_own_kind(g, value)
    if: row != 0 && lmx_graph_work_scalar_contract(g, row) != 0
        return: 4
    if: actual != 1 && actual != 5 && actual != 6 && lmx_graph_scalar_pool(g, value) = 0
        return: 4
    # A scalar row names this activation's binding. Its selected immutable
    # Value may stay shared until a real local store creates mutable storage.
    # Explicit graph destinations use their physical protection checks.
    if: row != 0 && row\expected_kind != 0 && actual != row\expected_kind
        return: 4
    token[0] := selected
    kind[0] := actual
    return: 0
end: lmx_graph_place_name

# A WORD is a bare destination. A declaration selects its reached local/DATA row.
# This reader checks storage and type before the RHS, without reading payload.
fn: lmx_graph_place_site (@: g c.LmxGraph; @: code c.Lmx; @: holder c.Lmx; size_t: index; @: token size_t; @: kind int) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: frame c.LmxGraphFrame 0
    @: raw void c.lmx_graph_get_in(g, holder, index)
    @: name char c.lmx_graph_word_text(g, raw)
    @: row c.LmxGraphWork 0
    size_t: at 0U
    int: actual 0
    int: required lmx_graph_own_kind(g, raw)
    int: status 0
    if: name != 0
        return: lmx_graph_place_name(g, code, name, token, kind)
    if: token = 0 || kind = 0 || (required != 1 && required != 5 && required != 6)
        return: 4
    if: active = 0 || active\code != code || active\frame = 0
        return: 5
    frame := (cast: (@: c.LmxGraphFrame) active\frame)
    status := lmx_graph_work_site(g, frame, holder, index, @ at)
    if: status != 0
        return: status
    row := frame\rows + at
    actual := lmx_graph_own_kind(g, (cast: (@: void) row\cell))
    if: actual != required || (row\expected_kind != 0 && actual != row\expected_kind)
        return: 4
    if: at >= (cast: (size_t) -1) - active\width
        return: 4
    token[0] := active\width + at
    kind[0] := actual
    return: 0
end: lmx_graph_place_site

# Only the original physical DATA declaration consumes an actual's default
# suppression. A later declaration reusing its namespace row still runs its RHS.
fn: lmx_graph_place_supplied (@: g c.LmxGraph; @: code c.Lmx; @: holder c.Lmx; size_t: index; size_t: token) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: frame c.LmxGraphFrame 0
    @: row c.LmxGraphWork 0
    @: raw void c.lmx_graph_get_in(g, holder, index)
    size_t: at 0U
    if: active = 0 || active\code != code || active\frame = 0
        return: 0
    frame := (cast: (@: c.LmxGraphFrame) active\frame)
    if: holder != frame\data || token < active\width || token - active\width >= frame\count
        return: 0
    if: lmx_graph_own_name(g, raw) = 0 || (lmx_graph_own_kind(g, raw) != 1 && lmx_graph_own_kind(g, raw) != 5 && lmx_graph_own_kind(g, raw) != 6 && lmx_graph_scalar_pool(g, raw) = 0)
        return: 0
    at := lmx_graph_work_slot(frame, index)
    if: at >= frame\count
        return: 0
    row := frame\rows + at
    if: (row\loaded & 32) = 0
        return: 0
    row\loaded := row\loaded & -33
    return: 1
end: lmx_graph_place_supplied

fn: lmx_graph_place_store_int (@: g c.LmxGraph; @: code c.Lmx; size_t: token; int: number) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: frame c.LmxGraphFrame 0
    @: row c.LmxGraphWork 0
    @: current c.LmxWalkValue 0
    if: active = 0 || active\code != code || active\frame = 0
        return: 5
    if: token < active\width
        return: 4
    frame := (cast: (@: c.LmxGraphFrame) active\frame)
    token := token - active\width
    if: token >= frame\count
        return: 3
    row := frame\rows + token
    if: lmx_graph_own_kind(g, (cast: (@: void) row\cell)) != 1
        return: 4
    if: c.lmx_graph_kind(g, row\cell) = 4
        row\cell := c.lmx_graph_int(g, number)
        if: row\cell = 0
            return: 4
        ---
    else:
        if: c.lmx_graph_kind(g, row\cell) = 3
            if: c.lmx_int_store_known(c.lmx_arena_pointer_void_read(row\cell), number) != 0
                return: 4
            ---
        else:
            if: c.lmx_int_store_known(row\cell, number) != 0
                return: 4
            ---
        ---
    ---
    row\number := number
    # Match the common numerical writer: a new number drops value-dependent
    # Model/reference context while retaining SOURCE and physical ABI facts.
    current := (cast: (@: c.LmxWalkValue) (@ row\value))
    c.lmx_value_context_copy(current, 0)
    if: current\kind = c.LMX_WALK_VALUE_NUMBER
        current\number := number
    row\loaded := row\loaded | 1
    return: 0
end: lmx_graph_place_store_int

fn: lmx_graph_place_store_reference (@: g c.LmxGraph; @: code c.Lmx; size_t: token; @: value void) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: frame c.LmxGraphFrame 0
    @: row c.LmxGraphWork 0
    @: cell void 0
    @: target void 0
    int: kind 0
    int: status 0
    if: active = 0 || active\code != code || active\frame = 0
        return: 5
    if: token < active\width
        if: active\refs = 0
            return: 3
        cell := active\refs[token]
    else:
        frame := (cast: (@: c.LmxGraphFrame) active\frame)
        token := token - active\width
        if: token >= frame\count
            return: 3
        row := frame\rows + token
        cell := row\cell
    ---
    kind := lmx_graph_own_kind(g, cell)
    if: kind != 5 && kind != 6
        return: 4
    status := c.lmx_graph_reference_payload(g, kind, value, @ target)
    if: status != 0
        return: status
    # A write-only mapped place never reads an uninitialized/deferred payload.
    if: row != 0 && (row\loaded & 1) = 0
        if: kind = 5
            cell := c.lmx_graph_ref_int(g, target)
        else:
            cell := c.lmx_graph_ref_lmx(g, (cast: (@: c.Lmx) target))
        if: cell = 0
            return: 4
        row\cell := cell
        row\loaded := row\loaded | 1
    ---
    if: c.lmx_arena_pointer_void_write(cell, target) != 0
        return: 4
    return: 0
end: lmx_graph_place_store_reference

# The physical destination supplies ABI/SOURCE. A local destination is already
# owned by its activation; explicit graph destinations use the same typed store.
fn: lmx_graph_scalar_store_cell (@: g c.LmxGraph; @: code c.Lmx; @: cell void; @: raw void) int
    @: pool c.LmxPool lmx_graph_scalar_pool(g, cell)
    c.LmxWalkPlace: place
    c.LmxWalkValue: value
    c.LmxWalkValue: received
    @: received_p c.LmxWalkValue @ received
    if: pool = 0 || c.lmx_walk_value_cell(g\arena, raw, @ value) != c.LMX_WALK_OK || c.lmx_walk_cell_place(g\arena, cell, 0, @ place) != c.LMX_WALK_OK
        return: 4
    if: c.lmx_walk_value_prepare_scalar_store(g\arena, @ place, @ value, received_p) != c.LMX_WALK_OK || c.lmx_walk_value_scalar_storage(g\arena, received_p, (cast: (int) pool\type), (cast: (const: @: c.LmxScalarABI) pool\scalar_abi)) != c.LMX_WALK_OK
        return: 4
    if: c.lmx_graph_invalidate(g, code, 0, cell, cell) != 0 || c.lmx_walk_value_store(g\arena, @ place, received_p) != c.LMX_WALK_OK
        return: 4
    return: 0
end: lmx_graph_scalar_store_cell

fn: lmx_graph_place_store_scalar (@: g c.LmxGraph; @: code c.Lmx; size_t: token; @: value void) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: frame c.LmxGraphFrame 0
    @: row c.LmxGraphWork 0
    @: current c.LmxWalkValue 0
    @: cell void 0
    @: owned_cell void 0
    c.LmxWalkValue: local
    c.LmxWalkPlace: place
    int: status 0
    if: active = 0 || active\code != code || active\frame = 0 || token < active\width
        return: 4
    frame := (cast: (@: c.LmxGraphFrame) active\frame)
    token := token - active\width
    if: token >= frame\count
        return: 3
    row := frame\rows + token
    if: lmx_graph_work_scalar_contract(g, row) != 0
        return: 4
    cell := row\cell
    if: c.lmx_range_write_exact_blocked(g\arena, cell, 0, 0, 0U) != 0
        current := (cast: (@: c.LmxWalkValue) (@ row\value))
        c.memcpy((cast: (@: void) (@ local)), (cast: (const: @: void) current), c.sizeof(c.LmxWalkValue))
        status := c.lmx_walk_values_arg_place_scalar(g\arena, @ local, @ owned_cell, 1U, 0U, (cast: (const: @: c.LmxScalarABI) current\scalar_abi), (cast: (@: void) current\source_type), @ place)
        if: status != c.LMX_WALK_OK
            return: 4
        cell := owned_cell
    ---
    # Preparing a mutable destination does not replace the selected Value
    # until admission and the store succeed. A failed RHS/store keeps it.
    status := lmx_graph_scalar_store_cell(g, code, cell, value)
    if: status != 0
        return: status
    row\cell := cell
    c.memcpy((cast: (@: void) (@ row\value)), (cast: (const: @: void) c.lmx_value_cell_context(g\arena, row\cell)), c.sizeof(c.LmxWalkValue))
    row\loaded := row\loaded | 1
    return: 0
end: lmx_graph_place_store_scalar

# Compatibility reader for callers which need only the receiving type.
fn: lmx_graph_known_place (@: g c.LmxGraph; @: code c.Lmx; @: name char; int: mode; @: kind int) int
    size_t: token 0U
    size_t: slot 0U
    @: value void 0
    int: actual 0
    if: mode = 0
        return: lmx_graph_place_name(g, code, name, @ token, kind)
    slot := lmx_graph_visible_slot(g, code, name)
    if: slot >= c.lmx_graph_count(code)
        if: lmx_graph_resolve(g, code, name) != 0
            return: 4
        return: 3
    value := c.lmx_graph_get_in(g, code, slot)
    actual := lmx_graph_own_kind(g, value)
    if: kind = 0 || (actual != 1 && actual != 5 && actual != 6 && lmx_graph_scalar_pool(g, value) = 0)
        return: 4
    if: lmx_graph_scalar_pool(g, value) != 0 && c.lmx_range_write_exact_blocked(g\arena, value, 0, 0, 0U) != 0
        return: 4
    kind[0] := actual
    return: 0
end: lmx_graph_known_place

# The numeric consumer stays strict when another primitive is writable.
fn: lmx_graph_known_int (@: g c.LmxGraph; @: code c.Lmx; @: name char; int: mode) int
    int: kind 0
    int: status lmx_graph_known_place(g, code, name, mode, @ kind)
    if: status != 0
        return: status
    if: kind != 1
        return: 4
    return: 0
end: lmx_graph_known_int

# A bare reference write changes only its activation's stable working cell.
# The row is reacquired after the RHS; physical writes use the same graph writer.
fn: lmx_graph_store_reference (@: g c.LmxGraph; @: code c.Lmx; @: name char; int: mode; @: value void) int
    size_t: token 0U
    size_t: slot 0U
    int: kind 0
    int: status 0
    if: mode = 0
        status := lmx_graph_place_name(g, code, name, @ token, @ kind)
        if: status != 0
            return: status
        return: lmx_graph_place_store_reference(g, code, token, value)
    status := lmx_graph_known_place(g, code, name, mode, @ kind)
    if: status != 0
        return: status
    if: kind != 5 && kind != 6
        return: 4
    slot := lmx_graph_visible_slot(g, code, name)
    return: c.lmx_graph_assign_reference(g, code, c.lmx_graph_get_in(g, code, slot), value)
end: lmx_graph_store_reference

# Explicit paths write the graph, even when they address this activation's data. They neither publish nor refresh
# bare working values; a later bare write changes only the local place.
fn: lmx_graph_store_field (@: g c.LmxGraph; @: code c.Lmx; @: owner c.Lmx; size_t: slot; int: number) int
    if: c.lmx_graph_kind(g, (cast: (@: void) owner)) != 4
        return: 4
    return: c.lmx_graph_assign_int(g, code, owner, slot, number)
end: lmx_graph_store_field

# The field a written path `owner\field` names, for a write through it: the owner evaluated -- a Structure, or the
# target of a reference to it (the same instance) -- and the place its last step names, through an atom too
# (lmx_graph_step_place). 0 and the Structure holding the place and its slot in owner_out and slot_out; 2 for no path;
# 3 for no field of that name; 4 for an owner that is no Structure; the answer of the owner's evaluation.
fn: lmx_graph_path_field (@: g c.LmxGraph; @: code c.Lmx; @: left void; @@: owner_out c.Lmx; @: slot_out size_t) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: path c.Lmx (cast: (@: c.Lmx) left)
    @: value void 0
    size_t: slot 0U
    int: status 0
    if: state = 0 || c.lmx_graph_kind(g, left) != 4 || c.lmx_graph_count(path) != 3U || c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, path, 1U)) != state\w_deref
        return: 2
    status := lmx_graph_read_received_value(g, code, c.lmx_graph_get_in(g, path, 0U), 2, @ value)
    if: status != 0
        return: status
    status := lmx_graph_step_place(g, value, c.lmx_graph_get_in(g, path, 2U), @ value, @ slot)
    if: status != 0
        return: status
    owner_out[0] := (cast: (@: c.Lmx) value)
    slot_out[0] := slot
    return: 0
end: lmx_graph_path_field

# A write through the index of a Structure, `base[index] := value` (the book, structure-index): the base and the index
# first, then the value -- an address, not a number --, then the physical slot write
# (lmx_graph_index_write). 0; 4 or 7 as the kernel answers; the answer of an evaluation.
fn: lmx_graph_eval_index_write (@: g c.LmxGraph; @: code c.Lmx; @: left c.Lmx; @: operand void) int
    @: base void 0
    @: value void 0
    int: index 0
    int: status 0
    status := lmx_graph_read_received_value(g, code, c.lmx_graph_get_in(g, left, 0U), 2, @ base)
    if: status != 0
        return: status
    status := lmx_graph_eval_number(g, code, c.lmx_graph_get_in(g, left, 2U), @ index)
    if: status != 0
        return: status
    status := lmx_graph_read_received_value(g, code, operand, 2, @ value)
    if: status != 0
        return: status
    return: c.lmx_graph_index_write(g, code, base, index, value)
end: lmx_graph_eval_index_write

fn: lmx_graph_eval_assignment (@: g c.LmxGraph; @: code c.Lmx; @: statement c.Lmx; int: mode) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: left void c.lmx_graph_get_in(g, statement, 1U)
    @: name char c.lmx_graph_word_text(g, left)
    @: owner c.Lmx code
    @: cell void 0
    @: value void 0
    size_t: slot 0U
    size_t: token 0U
    int: number 0
    int: kind 0
    int: contract 0
    int: status 0
    if: state = 0 || c.lmx_graph_count(statement) != 3U
        return: 2
    if: name = 0 && c.lmx_graph_index_form(g, left) != 0
        return: lmx_graph_eval_index_write(g, code, (cast: (@: c.Lmx) left), c.lmx_graph_get_in(g, statement, 2U))
    if: name != 0
        if: mode = 0
            status := lmx_graph_place_site(g, code, statement, 1U, @ token, @ kind)
        else:
            status := lmx_graph_known_place(g, code, name, mode, @ kind)
            slot := lmx_graph_visible_slot(g, code, name)
        ---
    else:
        status := lmx_graph_path_field(g, code, left, @ owner, @ slot)
        if: status != 0
            return: status
        cell := c.lmx_graph_place_cell(g, owner, slot)
        if: cell = 0 && lmx_graph_scalar_pool(g, c.lmx_graph_get_in(g, owner, slot)) != 0
            cell := c.lmx_graph_get_in(g, owner, slot)
        if: cell = 0
            cell := c.lmx_graph_reference_cell(g, c.lmx_graph_get_in(g, owner, slot))
        kind := c.lmx_graph_kind(g, cell)
        if: kind != 1 && kind != 5 && kind != 6 && lmx_graph_scalar_pool(g, cell) = 0
            return: 4
        if: lmx_graph_scalar_pool(g, cell) != 0 && c.lmx_range_write_exact_blocked(g\arena, cell, 0, 0, 0U) != 0
            return: 4
        ---
    ---
    if: status != 0
        return: status
    if: kind = 0
        if: name != 0 && mode != 0
            cell := c.lmx_graph_get_in(g, owner, slot)
        status := lmx_graph_read_received_value(g, code, c.lmx_graph_get_in(g, statement, 2U), 0, @ value)
        if: status != 0
            return: status
        if: name != 0 && mode = 0
            return: lmx_graph_place_store_scalar(g, code, token, value)
        return: lmx_graph_scalar_store_cell(g, code, cell, value)
    if: kind = 5 || kind = 6
        if: kind = 6
            contract := 2
        status := lmx_graph_read_received_value(g, code, c.lmx_graph_get_in(g, statement, 2U), contract, @ value)
        if: status != 0
            return: status
        if: name != 0
            if: mode = 0
                return: lmx_graph_place_store_reference(g, code, token, value)
            return: lmx_graph_store_reference(g, code, name, mode, value)
        return: c.lmx_graph_assign_reference(g, code, cell, value)
    status := lmx_graph_eval_number(g, code, c.lmx_graph_get_in(g, statement, 2U), @ number)
    if: status != 0
        return: status
    if: name != 0 && mode = 0
        return: lmx_graph_place_store_int(g, code, token, number)
    return: lmx_graph_store_field(g, code, owner, slot, number)
end: lmx_graph_eval_assignment


fn: lmx_graph_store_name (@: g c.LmxGraph; @: code c.Lmx; @: name char; int: number) int
    size_t: token 0U
    int: kind 0
    int: status lmx_graph_place_name(g, code, name, @ token, @ kind)
    if: status != 0
        return: status
    if: kind != 1
        return: 4
    return: lmx_graph_place_store_int(g, code, token, number)
end: lmx_graph_store_name

# ---- The registry of data and the path step (plan M11 5a; the book, fields, colon-declares, declaration-visibility) ----

# The registry of data (the author 2026-11-11: data is read whole, a repeated declaration is one more occurrence): the
# records of the root level of data that declare name, read whole and both ways each time it is consulted -- no table
# is kept. A place answers by the name of its cell (an int place, a place without a value, a reference place, a named
# word); a declaration Frame of a receiver of a place (`int: name expression`, `@: name ...`) by its declared name; any
# other named Lmx by its head -- a Structure and, with mode 0 (a path), also a written call and a receiver of control
# (`data\if`, the author 2026-11-11). With mode 1 (the reading of a bare name) a Frame whose head is a word of the
# language or names a callable answering in data's block is a statement and declares nothing. A named Lmx beside a
# place of its name declares nothing either: it is a statement on that place -- a call through a reference to a
# callable, or the refused form (the book, forms-declare-or-call), as `x: x + 2` beside `int: x 4`. An assignment, an
# unnamed Structure and an atom declare nothing. The number of the records; the slot of the record n (from 0) in
# at_out, or the count of the slots of data when there is no such record.
# The existing construction row for this particular source declaration. Name
# lookup alone cannot distinguish repeated declarations or a computed name.
fn: lmx_graph_binding_method (@: g c.LmxGraph; @: owner c.Lmx; @: source void) @: c.Lmx
    @: space c.LmxGraphSpace c.lmx_graph_space()
    @: row c.LmxGraphSpaceRow 0
    @: made c.Lmx 0
    @: name char 0
    size_t: i 0U
    if: space = 0 || owner = 0 || source = 0
        return: 0
    name := lmx_graph_fn_decl_name(g, (cast: (@: c.Lmx) source))
    i := space\count
    while: i > 0U
        i := i - 1U
        row := space\rows + i
        if: row\scope != owner || (name != 0 && row\name != name)
            continue
        if: c.lmx_graph_kind(g, row\value) != 4
            continue
        made := (cast: (@: c.Lmx) row\value)
        if: made\parent != source
            continue
        # A constructed fn may describe a signature without code. Invocation
        # checks callability; name lookup must retain that descriptor too.
        if: c.lmx_graph_fn_result(g, (cast: (@: void) made)) = 0
            continue
        return: made
    return: 0

# The name supplied by a field's declaration contract or its constructed value,
# without evaluating any operand.
fn: lmx_graph_binding_name (@: g c.LmxGraph; @: owner c.Lmx; @: value void; int: mode; @: place int) @: char
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    int: kind c.lmx_graph_kind(g, value)
    @: head char c.lmx_graph_name_of(g, value)
    @: answer void 0
    @: declared char 0
    value := c.lmx_graph_binding_leaf(g, value)
    kind := c.lmx_graph_kind(g, value)
    head := c.lmx_graph_name_of(g, value)
    place[0] := 0
    if: kind = 3 || kind = 8 || kind = 9
        place[0] := 1
        return: c.lmx_graph_name_of(g, c.lmx_arena_pointer_void_read(value))
    if: kind = 1 || kind = 5 || kind = 6 || lmx_graph_scalar_pool(g, value) != 0 || (kind = 2 && head != 0)
        place[0] := 1
        return: head
    if: kind != 4
        return: 0
    declared := c.lmx_graph_declaration_place_name(g, value)
    if: declared != 0
        place[0] := 1
        return: declared
    if: head = state\w_fn || head = state\w_sub
        head := lmx_graph_fn_decl_name(g, (cast: (@: c.Lmx) value))
        if: head != 0
            return: head
        answer := (cast: (@: void) lmx_graph_binding_method(g, owner, value))
        return: c.lmx_graph_name_of(g, answer)
    if: head = 0 || mode = 0
        return: head
    if: lmx_graph_language_word(state, head) != 0 || c.lmx_graph_language_receiver(head) != 0
        return: 0
    answer := c.lmx_graph_space_find(owner, head)
    if: answer != 0 && c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_target(g, answer))) != 0
        return: 0
return: head

fn: lmx_graph_data_find_scope (@: g c.LmxGraph; @: data c.Lmx; @: name char; int: mode; size_t: n; @: at_out size_t; int: dynamic; int: fold) size_t
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: value void 0
    @: head char 0
    size_t: count 0U
    size_t: found 0U
    size_t: places 0U
    size_t: place_at 0U
    size_t: i 0U
    int: place 0
    if: at_out != 0
        at_out[0] := 0U
    if: g = 0 || state = 0 || name = 0 || at_out = 0 || c.lmx_graph_kind(g, (cast: (@: void) data)) != 4
        return: 0U
    count := c.lmx_graph_count(data)
    at_out[0] := count
    place_at := count
    while: i < count
        if: dynamic != 0 && lmx_graph_field_private(g, data, i) != 0
            i := i + 1U
            continue
        value := c.lmx_graph_get_in(g, data, i)
        head := lmx_graph_binding_name(g, data, value, mode, @ place)
        if: head = name && place != 0
            if: places = n
                place_at := i
            ---
            places := places + 1U
        ---
        if: head = name && place = 0
            if: found = n
                at_out[0] := i
            ---
            found := found + 1U
        ---
        i := i + 1U
    ---
    # Beside a place of the name, the named Lmx of that name are statements on it -- where the code reads them (fold). The data of a
    # launch holds declarations only: there the Structure is one more occurrence of the name, and no single record is chosen.
    if: places != 0U && (fold != 0 || found = 0U)
        at_out[0] := place_at
        return: places
    if: places != 0U
        at_out[0] := count
        return: places + found
    return: found
end: lmx_graph_data_find_scope

fn: lmx_graph_data_find (@: g c.LmxGraph; @: data c.Lmx; @: name char; int: mode; size_t: n; @: at_out size_t) size_t
    return: lmx_graph_data_find_scope(g, data, name, mode, n, at_out, 0, 1)

# The slot of owner the raw path step names: an occurrence pair selects record N of name in owner's registry
# (lmx_graph_data_find); a bare name -- its only record, two or more being ambiguous (no first record is chosen, the
# book, fields); without a record of that name -- the atom of owner written with that word, its own field
# (`Struct1: Struct2`, the author 2026-11-11). The count of owner's slots for no such field or an ambiguous one.
fn: lmx_graph_step_index (@: g c.LmxGraph; @: owner c.Lmx; @: step void) size_t
    @: name char c.lmx_graph_word_text(g, step)
    @: field void 0
    size_t: index 0U
    size_t: at 0U
    size_t: found 0U
    size_t: count 0U
    size_t: i 0U
    if: g = 0 || step = 0 || c.lmx_graph_kind(g, (cast: (@: void) owner)) != 4
        return: (cast: (size_t) -1)
    count := c.lmx_graph_count(owner)
    if: name = 0
        if: c.lmx_graph_occurrence(g, step, @ index, @ name) = 0
            return: count
        found := lmx_graph_data_find(g, owner, name, 0, index, @ at)
        if: index < found
            return: at
        return: count
    found := lmx_graph_data_find(g, owner, name, 0, 0U, @ at)
    if: found = 1U
        return: at
    if: found > 1U
        return: count
    at := count
    while: i < count
        field := c.lmx_graph_get_in(g, owner, i)
        if: c.lmx_graph_kind(g, field) = 2 && c.lmx_graph_name_of(g, field) = 0 && c.lmx_graph_word_text(g, field) = name
            if: at < count
                return: count
            at := i
        ---
        i := i + 1U
    ---
    return: at
end: lmx_graph_step_index

# Consume a declaration through the ordinary scope preparation. Pure name and
# binding queries never enter this path: a receiver may query its own name while
# it is being built. The reached scope uses the same declaration order as entry,
# so sibling written methods classify later computed actuals consistently.
fn: lmx_graph_binding_source_read (@: g c.LmxGraph; @: owner c.Lmx; @: raw void; int: prepare; @@: out void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: head char c.lmx_graph_name_of(g, raw)
    @: made c.Lmx 0
    int: status 0
    raw := c.lmx_graph_binding_leaf(g, raw)
    head := c.lmx_graph_name_of(g, raw)
    out[0] := raw
    if: c.lmx_graph_kind(g, raw) != 4 || (head != state\w_fn && head != state\w_sub)
        return: 0
    out[0] := 0
    made := lmx_graph_binding_method(g, owner, raw)
    if: made = 0 && prepare != 0
        status := lmx_graph_space_declarations(g, owner)
        if: status != 0
            return: status
        made := lmx_graph_binding_method(g, owner, raw)
    out[0] := (cast: (@: void) made)
    return: 0

fn: lmx_graph_binding_read (@: g c.LmxGraph; @: owner c.Lmx; size_t: slot; int: prepare; @@: out void) int
    return: lmx_graph_binding_source_read(g, owner, c.lmx_graph_get_in(g, owner, slot), prepare, out)

# The non-constructing query shares the same selected field and source proof.
fn: lmx_graph_binding_value (@: g c.LmxGraph; @: owner c.Lmx; size_t: slot) @: void
    @: value void 0
    lmx_graph_binding_read(g, owner, slot, 0, @ value)
    return: value
# The entity an atom of holder refers to, found when a path is read through it (the author 2026-11-11,
# LMX_blog/2026-11-11.md#known-name-not-expanded; the executor's readings P1, B3): its word is looked up lexically from
# the atom's place outwards, never through an activation -- the records of holder, whole, then the records of every
# enclosing level, whole, up to the root (lmx_graph_data_find), a callable the receivers fn and sub created answering in
# a level's block (lmx_graph_space_find), and the data part of a callable. The atom itself is no record, so an atom
# naming its own holder finds the holder at the enclosing level. The entity, with the level holding its record and the
# record's slot in owner_out and slot_out (0 for a callable the namespace answers); 0 for none or for a level with two
# or more records of the word.
fn: lmx_graph_atom_target_context (@: g c.LmxGraph; @: holder c.Lmx; @: word char; @@: owner_out c.Lmx; @: slot_out size_t; int: prepare; @: status int) @: void
    @: current c.Lmx holder
    @: part c.Lmx 0
    @: value void 0
    size_t: at 0U
    size_t: found 0U
    owner_out[0] := 0
    slot_out[0] := 0U
    status[0] := 0
    while: word != 0 && c.lmx_graph_kind(g, (cast: (@: void) current)) = 4
        found := lmx_graph_data_find(g, current, word, 1, 0U, @ at)
        if: found = 1U
            owner_out[0] := current
            slot_out[0] := at
            status[0] := lmx_graph_binding_read(g, current, at, prepare, @ value)
            if: status[0] != 0
                return: 0
            return: value
        if: found > 1U
            return: 0
        value := c.lmx_graph_space_find(current, word)
        if: value != 0
            return: value
        if: c.lmx_graph_method(g, current) != 0
            part := c.lmx_graph_method_data(g, current)
            found := lmx_graph_data_find(g, part, word, 1, 0U, @ at)
            if: found = 1U
                owner_out[0] := part
                slot_out[0] := at
                status[0] := lmx_graph_binding_read(g, part, at, prepare, @ value)
                if: status[0] != 0
                    return: 0
                return: value
            if: found > 1U
                return: 0
        ---
        current := (cast: (@: c.Lmx) current\parent)
    ---
    return: 0
end: lmx_graph_atom_target_context

fn: lmx_graph_atom_target (@: g c.LmxGraph; @: holder c.Lmx; @: word char; @@: owner_out c.Lmx; @: slot_out size_t) @: void
    int: status 0
    return: lmx_graph_atom_target_context(g, holder, word, owner_out, slot_out, 0, @ status)

# The value of a written declaration that no reached statement has filled, read through an explicit path (the book,
# call-frame-20261115: a computed place is read by executing the expression its declaration writes, with no publication
# and no cache -- every read executes it again). Its scope is the Structure that holds the declaration. `int: name expr`
# gives a new int cell; `@: name Template` and `@: name int expr` give what their last operand reads, as the reached
# statement reads it (lmx_graph_block_body). 0 and the value in out, or the answer of the expression.
fn: lmx_graph_declared_value (@: g c.LmxGraph; @: owner c.Lmx; @: declaration c.Lmx; @@: out void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    size_t: n c.lmx_graph_count(declaration)
    int: number 0
    int: status 0
    if: c.lmx_graph_name_of(g, (cast: (@: void) declaration)) != state\w_int
        return: lmx_graph_read_received_value(g, owner, c.lmx_graph_get_in(g, declaration, n - 1U), lmx_graph_value_contract(g, declaration, n - 1U), out)
    status := lmx_graph_eval(g, owner, declaration, 1U, n, @ number)
    if: status != 0
        return: status
    out[0] := c.lmx_graph_int(g, number)
    if: out[0] = 0
        return: 4
    return: 0

# The step `\word` of a path read from value: the field lmx_graph_step_index names in the Structure value stands for --
# the target of a reference, the same instance --; a field that is an atom answers the entity its word refers to
# (lmx_graph_atom_target), and the slot keeps the atom; a field that is a computed declaration answers what the
# expression it writes gives (lmx_graph_declared_value). 0 and the value in out; 3 for no such field, an ambiguous name
# or an atom that refers to nothing.
fn: lmx_graph_step (@: g c.LmxGraph; @: value void; @: step void; @@: out void) int
    @: base void c.lmx_graph_target(g, value)
    @: owner c.Lmx 0
    @: field void 0
    size_t: slot 0U
    int: status 0
    if: out = 0 || c.lmx_graph_kind(g, base) != 4
        return: 3
    owner := (cast: (@: c.Lmx) base)
    slot := lmx_graph_step_index(g, owner, step)
    if: slot >= c.lmx_graph_count(owner)
        return: 3
    status := lmx_graph_binding_read(g, owner, slot, 1, @ field)
    if: status != 0
        return: status
    if: c.lmx_graph_kind(g, field) = 2 && c.lmx_graph_name_of(g, field) = 0
        field := lmx_graph_atom_target_context(g, owner, c.lmx_graph_word_text(g, field), @ owner, @ slot, 1, @ status)
        if: status != 0
            return: status
    ---
    if: field = 0
        return: 3
    if: lmx_graph_deferred_kind(g, field) = 0 && c.lmx_graph_kind(g, field) = 4 && c.lmx_graph_declaration_place_name(g, field) != 0
        return: 5
    if: lmx_graph_deferred_kind(g, field) != 0
        status := lmx_graph_declared_value(g, owner, (cast: (@: c.Lmx) c.lmx_graph_binding_leaf(g, field)), @ field)
        if: status != 0
            return: status
    ---
    out[0] := field
    return: 0

# The place the step `\word` of a path names for a write through it (the book, fields; plan M11 5a): the field
# lmx_graph_step_index names in the Structure value stands for or, when that field is an atom, the record its word
# refers to (lmx_graph_atom_target) -- a write through `Pair\i`, Pair holding the atom i, writes the place i itself, one
# instance. 0 with the Structure holding the place in owner_out and its slot in slot_out; 3 for no such field, an
# ambiguous name or an atom that refers to no record; 4 for a value that is no Structure.
fn: lmx_graph_step_place (@: g c.LmxGraph; @: value void; @: step void; @@: owner_out void; @: slot_out size_t) int
    @: base void c.lmx_graph_target(g, value)
    @: owner c.Lmx 0
    @: field void 0
    size_t: slot 0U
    int: status 0
    if: owner_out = 0 || slot_out = 0
        return: 3
    if: c.lmx_graph_kind(g, base) != 4
        return: 4
    owner := (cast: (@: c.Lmx) base)
    slot := lmx_graph_step_index(g, owner, step)
    if: slot >= c.lmx_graph_count(owner)
        return: 3
    field := c.lmx_graph_get_in(g, owner, slot)
    if: c.lmx_graph_kind(g, field) = 2 && c.lmx_graph_name_of(g, field) = 0
        field := lmx_graph_atom_target_context(g, owner, c.lmx_graph_word_text(g, field), @ owner, @ slot, 1, @ status)
        if: status != 0
            return: status
        if: field = 0 || owner = 0
            return: 3
        ---
    ---
    owner_out[0] := (cast: (@: void) owner)
    slot_out[0] := slot
    return: 0
end: lmx_graph_step_place

# The answers of the interpreter: 0 done; 1 an address has no int representation where an int is needed; 2 a malformed
# expression (an operator without an operand, two operands in a row, an unknown token); 3 an unknown name; 4 a write
# refused (a slot that holds no int place); 5 a statement this slice does not execute; 6 division by zero; 7 an index
# outside the fields of a Structure; 8 a structural form whose head is a known place that is no Structure (the book,
# forms-declare-or-call: such a form declares nothing and assigns nothing; the value of a known place is written by
# `:=`).

# The space above the code the live launch runs -- the value of the reserved word node (the book, node: one for the
# whole activation, its nested bodies included; the author's decision 2026-11-11 through fable2, plan M11 5b part 2).
# It is lexical by the code, not by the data the launch was given: the space of an ordinary Structure is its parent
# (`call(D; Bump)` gives the parent of Bump). The space of a callable is the block its declaration stands in, read up
# through the bodies of the control receivers, which run in the same activation (if, else, while, for, a post loop and
# its body, finally): a block that is a part of the declaration of another callable -- its written code or its data --
# gives that callable's data part (an inner method changes the enclosing's data through `node\name`); any other block is
# the space itself. The unit root has no parent, so it has no space and the name answers nothing. 0 for no space.
fn: lmx_graph_node_passes (@: state c.LmxGraphState; @: word char) int
    if: state = 0 || word = 0
        return: 0
    return: (cast: (int) (word = state\w_if || word = state\w_else || word = state\w_while || word = state\w_for || word = state\w_until || word = state\w_finally))
end: lmx_graph_node_passes

# Is the record `L2` at record a body nested in the code of a call, not the body of its file? The record that lmx_graph_file_code gives for the unit
# root (an .lm2 file, or a file written under an explicit `L2:`) is the file's own body and the space of node stops on it; any other record is nested.
fn: lmx_graph_record_nested (@: g c.LmxGraph; @: record c.Lmx) int
    @: holder c.Lmx (cast: (@: c.Lmx) record\parent)
    if: holder = 0
        return: 0
    if: holder\parent = 0 && c.lmx_graph_file_code(g, holder) = record
        return: 0
    return: 1

# The space itself (lmx_graph_node_space): a control receiver or its body is passed through, above, by its name or by
# the name of the Lmx it is a field of (an `if` is [condition, body], its body unnamed).
fn: lmx_graph_node_space (@: g c.LmxGraph; int: prepare; @: status int) @: void
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: activation c.LmxActivation 0
    @: code c.Lmx 0
    @: current c.Lmx 0
    @: owner c.Lmx 0
    @: enclosing c.Lmx 0
    @: head char 0
    @: above char 0
    @: value void 0
    if: g = 0 || state = 0
        return: 0
    activation := (cast: (@: c.LmxActivation) g\arena\activation)
    if: activation = 0 || activation\code = 0
        return: 0
    code := activation\code
    if: c.lmx_graph_method(g, code) = 0
        return: (cast: (@: void) code\parent)
    owner := (cast: (@: c.Lmx) code\parent)
    if: owner = 0
        return: 0
    current := (cast: (@: c.Lmx) owner\parent)
    while: current != 0
        head := c.lmx_graph_name_of(g, (cast: (@: void) current))
        owner := (cast: (@: c.Lmx) current\parent)
        above := 0
        if: owner != 0
            above := c.lmx_graph_name_of(g, (cast: (@: void) owner))
        ---
        if: lmx_graph_node_passes(state, head) != 0 || lmx_graph_node_passes(state, above) != 0
            current := owner
            continue
        # A record `L2:` nested in the code of a call is a body of that call and is passed through like one (lmx_graph_record_nested).
        if: (head = state\w_l2 && lmx_graph_record_nested(g, current) != 0) || (above = state\w_l2 && lmx_graph_record_nested(g, owner) != 0)
            current := owner
            continue
        if: owner != 0 && owner\parent != 0 && (above = state\w_fn || above = state\w_sub)
            status[0] := lmx_graph_binding_source_read(g, (cast: (@: c.Lmx) owner\parent), (cast: (@: void) owner), prepare, @ value)
            if: status[0] != 0
                return: 0
            enclosing := (cast: (@: c.Lmx) value)
            if: c.lmx_graph_method(g, enclosing) != 0 && enclosing\parent = owner
                return: (cast: (@: void) c.lmx_graph_method_data(g, enclosing))
            ---
        ---
        return: (cast: (@: void) current)
    ---
    return: 0
end: lmx_graph_node_space

# A recognized raw typed place is not a ready Structure value. Preserve legacy int/@
# row eligibility; this guard covers the additional declaring families named by the shared view.
# Classification closes lookup without evaluating it; consumption reports the unavailable lowering.
fn: lmx_graph_binding_unlowered (@: g c.LmxGraph; @: value void; int: prepare; @: status int) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: head char c.lmx_graph_name_of(g, value)
    if: c.lmx_graph_kind(g, value) != 4 || head = state\w_int || head = state\w_at
        return: 0
    if: c.lmx_graph_declaration_place_name(g, value) = 0
        return: 0
    if: prepare != 0
        status[0] := 5
    return: 1

# Resolve the current activation's DATA, inherited inputs, then lexical graph fields. Each lookup consumes the
# current graph and the live activation chain; no binding is saved in the graph or reused by the next traversal.
fn: lmx_graph_select_binding (@: g c.LmxGraph; @: scope c.Lmx; @: name char; @@: selected c.LmxGraphWork; @@: held c.LmxWalkValue; @@: declared void; int: prepare; @: status int) @: void
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: activation c.LmxActivation 0
    @: active_frame c.LmxGraphFrame 0
    @: args c.Lmx 0
    @: row c.LmxGraphWork 0
    @: current c.Lmx scope
    @: launched c.Lmx 0
    @: part c.Lmx 0
    @: value void 0
    @: input c.LmxWalkValue 0
    @: space c.LmxGraphSpace c.lmx_graph_space()
    @: head char 0
    size_t: slot 0U
    size_t: at 0U
    size_t: found 0U
    int: dynamic 0
    selected[0] := 0
    held[0] := 0
    declared[0] := 0
    status[0] := 0
    if: g = 0 || name = 0
        return: 0
    # The reserved word node names the space above the live launch's code (lmx_graph_node_space), never a binding: it is
    # read before the chain of activations, and no row, formal or field answers it.
    if: state != 0 && name = state\w_node
        return: lmx_graph_node_space(g, prepare, status)
    activation := (cast: (@: c.LmxActivation) g\arena\activation)
    while: activation != 0
        dynamic := (cast: (int) (activation != g\arena\activation))
        if: activation\frame != 0
            row := lmx_graph_input_row(g, activation, name, dynamic)
            # A required name nothing bound yet, which the root of the data of this launch may declare by a producer not applied yet: only a
            # read reaches that declaration (#declaration-visibility); it is applied now, by the one apply, and its name answers.
            if: row != 0 && row\cell = 0 && row\slot = (cast: (size_t) -1) && prepare != 0 && dynamic = 0
                active_frame := (cast: (@: c.LmxGraphFrame) activation\frame)
                while: value = 0 && status[0] = 0 && lmx_graph_data_reach_next(g, active_frame, name, status) != 0
                    value := lmx_graph_space_binding(g, (cast: (@: c.Lmx) active_frame\data), name, dynamic, declared)
                if: status[0] != 0
                    return: 0
                if: value != 0
                    return: value
            ---
            if: row != 0
                selected[0] := row
                declared[0] := row\declared
                input := (cast: (@: c.LmxWalkValue) (@ row\value))
                if: (row\loaded & 1) != 0 && input\kind != 0
                    held[0] := input
                return: row\cell
            ---
            if: activation = g\arena\activation && name = state\w_data
                active_frame := (cast: (@: c.LmxGraphFrame) activation\frame)
                return: (cast: (@: void) active_frame\data)
            ---
        ---
        args := lmx_graph_activation_data(g, activation)
        if: activation\frame = 0 && args != 0 && activation\refs != 0
            slot := c.lmx_graph_formal(g, args, name)
            if: slot < activation\width && (dynamic = 0 || lmx_graph_field_private(g, args, slot) = 0)
                declared[0] := c.lmx_graph_get_in(g, args, slot)
                if: activation\values != 0
                    input := (cast: (@: c.LmxWalkValue) activation\values) + slot
                    if: input\kind != 0
                        held[0] := input
                        return: activation\refs[slot]
                    ---
                    return: 0
                ---
                return: activation\refs[slot]
            ---
        ---
        # The registry of the data of this launch, after its rows and formals and before the lexical levels -- for every
        # launch of the chain, as for a number (plan M11 5b): a Structure of that data, a record that declares no place,
        # answers by reference -- one instance, a path writes it, a bare name is no place to write --; two or more records
        # of the name answer nothing.
        if: activation\frame != 0
            active_frame := (cast: (@: c.LmxGraphFrame) activation\frame)
            found := lmx_graph_work_data_find_scope(g, active_frame, (cast: (@: c.Lmx) active_frame\data), name, @ at, dynamic)
            if: found > 1U
                return: 0
            if: found = 1U
                declared[0] := c.lmx_graph_get_in(g, (cast: (@: c.Lmx) active_frame\data), at)
                status[0] := lmx_graph_binding_read(g, (cast: (@: c.Lmx) active_frame\data), at, prepare, @ value)
                if: status[0] != 0
                    return: 0
                if: lmx_graph_binding_unlowered(g, value, prepare, status) != 0
                    return: 0
                head := c.lmx_graph_name_of(g, value)
                if: c.lmx_graph_kind(g, value) = 4 && head != 0 && head != state\w_int && head != state\w_at
                    return: value
                ---
            ---
            value := lmx_graph_space_binding(g, (cast: (@: c.Lmx) active_frame\data), name, dynamic, declared)
            if: value != 0
                return: value
            value := lmx_graph_work_method_scope(g, active_frame, name, dynamic, declared)
            if: value != 0
                return: value
        ---
        activation := activation\parent
    ---
    # The special name `data` read by the root of a unit run over itself, with no frame, answers the root itself (the
    # author 2026-11-11, R6; plan M11 5a): `data\[1]Model` selects an occurrence of the root.
    if: state != 0 && name = state\w_data && space != 0 && space\root = scope
        return: (cast: (@: void) scope)
    # The code of the live launch of an ordinary Structure over data it was given is code, not data (the roles data and
    # code, the author 2026-11-11): its own records answer no name; the launch finds a name in its data, its inputs, and
    # the levels around its code. A callable's own fields are its DATA, code and return, and they answer in
    # its code; header declarations belong to the same DATA (M10/M14).
    activation := (cast: (@: c.LmxActivation) g\arena\activation)
    if: activation != 0 && activation\frame != 0
        active_frame := (cast: (@: c.LmxGraphFrame) activation\frame)
        if: active_frame\data != active_frame\code && c.lmx_graph_method(g, active_frame\code) = 0
            launched := (cast: (@: c.Lmx) active_frame\code)
        ---
    ---
    # Lexical parent blocks use reached CODE rows and the root DATA registry.
    # Named Structures/callables remain bidirectional; preparing a namespace
    # does not reveal a future CODE variable. Explicit paths read source fields.
    while: c.lmx_graph_kind(g, (cast: (@: void) current)) = 4
        # Reuse a live activation only at this exact lexical origin. Its
        # cursor may be in another inline body, so search from current.
        activation := (cast: (@: c.LmxActivation) g\arena\activation)
        while: activation != 0
            if: activation\frame != 0
                active_frame := (cast: (@: c.LmxGraphFrame) activation\frame)
                if: active_frame\data = current || lmx_graph_code_within(g, (cast: (@: c.Lmx) active_frame\body), current) != 0
                    row := lmx_graph_work_row_scope(g, active_frame, name, current, 0)
                    if: row != 0
                        selected[0] := row
                        declared[0] := row\declared
                        input := (cast: (@: c.LmxWalkValue) (@ row\value))
                        if: (row\loaded & 1) != 0 && input\kind != 0
                            held[0] := input
                        return: row\cell
                    ---
                ---
            ---
            activation := activation\parent
        ---
        found := 0U
        if: current != launched
            found := lmx_graph_work_data_find(g, active_frame, current, name, @ at)
        if: found > 1U
            return: 0
        if: found = 1U
            declared[0] := c.lmx_graph_get_in(g, current, at)
            status[0] := lmx_graph_binding_read(g, current, at, prepare, @ value)
            if: status[0] != 0
                return: 0
            if: lmx_graph_binding_unlowered(g, value, prepare, status) != 0
                return: 0
            # Selection retains a computed source whole. Entry capture copies
            # this description; only its later consumer may evaluate it.
            return: value
        ---
        value := c.lmx_graph_space_find(current, name)
        if: value != 0
            declared[0] := lmx_graph_binding_declared(g, current, value)
            return: value
        if: c.lmx_graph_method(g, current) != 0
            value := c.lmx_graph_space_find(c.lmx_graph_method_code(g, current), name)
            if: value != 0
                declared[0] := lmx_graph_binding_declared(g, c.lmx_graph_method_code(g, current), value)
                return: value
            part := c.lmx_graph_method_data(g, current)
            slot := c.lmx_graph_formal(g, part, name)
            if: slot < c.lmx_graph_count(part)
                declared[0] := c.lmx_graph_get_in(g, part, slot)
                status[0] := lmx_graph_binding_read(g, part, slot, prepare, @ value)
                if: status[0] != 0
                    return: 0
                if: lmx_graph_binding_unlowered(g, value, prepare, status) != 0
                    return: 0
                return: value
            ---
        else:
            head := c.lmx_graph_name_of(g, (cast: (@: void) current))
            if: (head = state\w_fn || head = state\w_sub) && current\parent != 0
                status[0] := lmx_graph_binding_source_read(g, (cast: (@: c.Lmx) current\parent), (cast: (@: void) current), prepare, @ value)
                if: status[0] != 0
                    return: 0
                part := (cast: (@: c.Lmx) value)
                if: c.lmx_graph_method(g, part) != 0 && part\parent = current
                    part := c.lmx_graph_method_data(g, part)
                    slot := c.lmx_graph_formal(g, part, name)
                    if: slot < c.lmx_graph_count(part)
                        declared[0] := c.lmx_graph_get_in(g, part, slot)
                        status[0] := lmx_graph_binding_read(g, part, slot, prepare, @ value)
                        if: status[0] != 0
                            return: 0
                        if: lmx_graph_binding_unlowered(g, value, prepare, status) != 0
                            return: 0
                        return: value
                    ---
                ---
            ---
        ---
        current := (cast: (@: c.Lmx) current\parent)
    ---
    return: 0
end: lmx_graph_select_binding

# Address consumers retain their ordinary interface. Selection itself never
# evaluates a deferred input or boxes a native activation's authoritative Value.
fn: lmx_graph_resolve_binding_context (@: g c.LmxGraph; @: scope c.Lmx; @: name char; @@: selected c.LmxGraphWork; int: prepare; @: status int) @: void
    @: held c.LmxWalkValue 0
    @: declared void 0
    @: value void lmx_graph_select_binding(g, scope, name, selected, @ held, @ declared, prepare, status)
    if: status[0] = 0 && selected[0] = 0 && held != 0
        if: held\present = 0
            if: prepare != 0
                status[0] := 5
            return: 0
        status[0] := lmx_graph_result_cell(g, held, @ value)
    if: selected[0] = 0 && lmx_graph_deferred_kind(g, value) != 0
        if: prepare != 0
            status[0] := 5
        return: 0
    return: value

# Query and consumption use one resolver. Only consumption may prepare a reached
# written declaration; failures remain local to this read, not a Space latch.
fn: lmx_graph_resolve_value (@: g c.LmxGraph; @: scope c.Lmx; @: name char; int: prepare; @@: out void) int
    @: row c.LmxGraphWork 0
    int: status 0
    @: value void lmx_graph_resolve_binding_context(g, scope, name, @ row, prepare, @ status)
    out[0] := 0
    if: status != 0
        return: status
    if: row != 0 && lmx_graph_deferred_kind(g, (cast: (@: void) row\cell)) != 0
        if: prepare = 0
            return: 0
        status := lmx_graph_work_load(g, row)
        if: status != 0
            return: status
        value := row\cell
    out[0] := value
    return: 0

# Classification and consumption share exactly one binding search. A deferred
# declaration is not a callable/Structure value; the reader reports its status.
fn: lmx_graph_resolve (@: g c.LmxGraph; @: scope c.Lmx; @: name char) @: void
    @: value void 0
    lmx_graph_resolve_value(g, scope, name, 0, @ value)
    return: value
end: lmx_graph_resolve

# The direct scalar result description is borrowed from the callable. Compound
# type/Model contracts still require the common description receiver; do not
# infer them from shape, storage size, or the fields of an opaque Model.
fn: lmx_graph_result_type (@: g c.LmxGraph; @: code c.Lmx; @@: abi_out void; @@: source_out void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: word char 0
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: frame c.LmxGraphFrame 0
    const: (@: abi c.LmxScalarABI 0)
    abi_out[0] := 0
    source_out[0] := 0
    if: active != 0 && active\code = code && active\frame != 0
        frame := (cast: (@: c.LmxGraphFrame) active\frame)
        word := frame\result
    else:
        word := c.lmx_graph_word_text(g, c.lmx_graph_method_return(g, code))
    ---
    abi := c.lmx_graph_scalar_binding(word, source_out)
    abi_out[0] := (cast: (@: void) abi)
    return: c.lmx_graph_scalar_type(abi)
end: lmx_graph_result_type

# Shape/default preflight precedes evaluation of any actual.
fn: lmx_graph_call_shape (@: g c.LmxGraph; @: code c.Lmx; size_t: actuals) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: args c.Lmx 0
    @: result_abi void 0
    @: result_source void 0
    size_t: i actuals
    if: c.lmx_graph_method(g, code) = 0
        return: 5
    args := c.lmx_graph_method_data(g, code)
    if: actuals > c.lmx_graph_count(args)
        return: 5
    if: c.lmx_graph_has_result(g, code) != 0
        if: lmx_graph_result_type(g, code, @ result_abi, @ result_source) = c.LMX_TYPE_NONE
            return: 5
        ---
    ---
    return: 0
end: lmx_graph_call_shape

# An anonymous value keeps its own fields unless it denotes an expression.
# Operations are already nested Lmx values; this reads their ordinary words,
# without parsing precedence or changing the source graph. A grouped name or
# application still evaluates, while a scalar field or nested data stays data.
fn: lmx_graph_group_expression (@: g c.LmxGraph; @: scope c.Lmx; @: raw void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: value c.Lmx (cast: (@: c.Lmx) raw)
    @: child void 0
    @: word char 0
    size_t: count 0U
    int: kind 0
    if: state = 0 || c.lmx_graph_kind(g, raw) != 4 || c.lmx_graph_name_of(g, raw) != 0
        return: 0
    count := c.lmx_graph_count(value)
    if: count = 1U
        child := c.lmx_graph_get_in(g, value, 0U)
        kind := c.lmx_graph_kind(g, child)
        if: kind = 2
            return: (cast: (int) (c.lmx_graph_name_of(g, child) = 0))
        if: kind != 4
            return: 0
        if: c.lmx_graph_name_of(g, child) != 0
            # A language application still belongs to its existing receiver,
            # including a receiver this subset must explicitly refuse.
            return: (cast: (int) (c.lmx_graph_language_receiver(c.lmx_graph_name_of(g, child)) != 0 || lmx_graph_applies(g, scope, child) != 0))
        return: lmx_graph_group_expression(g, scope, child)
    word := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, value, 0U))
    if: count = 2U
        return: (cast: (int) (word = state\w_plus || word = state\w_minus || word = state\w_not || word = state\w_deref || word = state\w_at))
    if: count = 3U
        if: word = state\w_assign
            return: 1
        word := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, value, 1U))
        return: (cast: (int) (word = state\w_apply || word = state\w_deref || word = state\w_index || word = state\w_plus || word = state\w_minus || word = state\w_star || word = state\w_slash || word = state\w_percent || word = state\w_eq || word = state\w_ne || word = state\w_lt || word = state\w_le || word = state\w_gt || word = state\w_ge || word = state\w_and || word = state\w_or))
return: 0

# A preserved written group is data unless its root is an operator expression.
# In particular, a one-field wrapper keeps its field even if that field names
# a callable. The selected formal decides whether to read that group as code.
fn: lmx_graph_written_group (@: g c.LmxGraph; @: raw void) int
    if: c.lmx_graph_kind(g, raw) != 4 || c.lmx_graph_name_of(g, raw) != 0
        return: 0
    return: (cast: (int) (c.lmx_graph_count((cast: (@: c.Lmx) raw)) = 1U || lmx_graph_group_expression(g, 0, raw) = 0))

# The same receiving context is used by formals, declaring receivers,
# assignments and structural operators. No field of a literal is evaluated.
fn: lmx_graph_read_received_value (@: g c.LmxGraph; @: scope c.Lmx; @: raw void; int: contract; @@: out void) int
    if: out = 0
        return: 4
    if: contract = 2 && lmx_graph_written_group(g, raw) != 0
        out[0] := raw
        return: 0
    return: lmx_graph_eval_value(g, scope, raw, out)

fn: lmx_graph_actual_contract (@: g c.LmxGraph; @: code c.Lmx; size_t: index) int
    @: formal void c.lmx_graph_get_in(g, c.lmx_graph_method_data(g, code), index)
    int: kind c.lmx_graph_kind(g, formal)
    if: lmx_graph_own_kind(g, formal) = 1
        return: 1
    if: kind = 8
        return: 3
    if: kind = 4 && c.lmx_graph_formal_model(g, (cast: (@: c.Lmx) formal)) != 0
        return: 2
    return: 0

# Prove a written DATA field chain independently of implemented storage families.
# Declaring descriptions use the shared name view; other fields retain their
# existing physical proof. Admission remains the call's action, without evaluation here.
fn: lmx_graph_written_whole (@: g c.LmxGraph; @: code c.Lmx; @: raw c.Lmx; @: from size_t) int
    @: args c.Lmx c.lmx_graph_method_data(g, code)
    @: field void 0
    size_t: width c.lmx_graph_count(args)
    size_t: i 0U
    int: contract 0
    int: kind 0
    c.memset((cast: (@: void) from), 0, (width + 1U) * sizeof(size_t))
    if: lmx_graph_bind_fields_mode(g, args, raw, from, 1) = 0
        return: 0
    while: i < width
        if: from[i] = 0U
            i := i + 1U
            continue
        field := c.lmx_graph_get_in(g, raw, from[i] - 1U)
        if: c.lmx_graph_declaration_place_name(g, field) != 0
            i := i + 1U
            continue
        kind := c.lmx_graph_kind(g, field)
        contract := lmx_graph_actual_contract(g, code, i)
        if: contract = 0 || (contract = 1 && kind != 1 && kind != 3)
            return: 0
        if: contract = 2 && c.lmx_graph_kind(g, c.lmx_graph_target(g, field)) != 4
            return: 0
        if: contract = 3 && kind != 5 && kind != 7 && kind != 8
            return: 0
        i := i + 1U
    return: 1

# 0: ordinary actuals; 1: evaluate one held value, then bind its fields;
# 2: use the written group itself as data. The caller may supply scratch.
fn: lmx_graph_call_reading (@: g c.LmxGraph; @: scope c.Lmx; @: code c.Lmx; @: expression c.Lmx; @: scratch size_t) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void 0
    @: from size_t scratch
    size_t: width c.lmx_graph_count(c.lmx_graph_method_data(g, code))
    int: contract 0
    int: whole 0
    if: c.lmx_graph_count(expression) != 1U
        return: 0
    raw := c.lmx_graph_get_in(g, expression, 0U)
    if: c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, (cast: (@: c.Lmx) raw), 0U)) = state\w_assign
        return: 0
    if: lmx_graph_written_group(g, raw) = 0
        return: lmx_graph_single_candidate(g, scope, expression)
    if: c.lmx_graph_count((cast: (@: c.Lmx) raw)) = 0U
        return: 2
    contract := lmx_graph_actual_contract(g, code, 0U)
    if: contract = 2
        return: 2
    if: lmx_graph_single_candidate(g, scope, expression) != 0
        return: 1
    if: from = 0
        from := (cast: (@: size_t) c.calloc(width + 1U, sizeof(size_t)))
    if: from = 0
        return: -1
    whole := lmx_graph_written_whole(g, code, (cast: (@: c.Lmx) raw), from)
    if: scratch = 0
        c.free((cast: (@: void) from))
    if: whole != 0
        return: 2
    return: 0

# One positional value without effects -- written data, a name or a field
# path -- or a merge may supply the whole argument Structure. Its direct
# fields bind by name or position through lmx_graph_call_single. The operands
# of a merge run before that check, as for a held result. Operations, addresses,
# calls and named actuals keep ordinary preflight before their effects.
fn: lmx_graph_single_candidate (@: g c.LmxGraph; @: scope c.Lmx; @: expression c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void 0
    @: path c.Lmx 0
    int: kind 0
    if: g = 0 || state = 0 || c.lmx_graph_kind(g, (cast: (@: void) expression)) != 4 || c.lmx_graph_count(expression) != 1U
        return: 0
    raw := c.lmx_graph_get_in(g, expression, 0U)
    kind := c.lmx_graph_kind(g, raw)
    if: kind = 2
        return: 1
    if: kind != 4
        return: 0
    if: c.lmx_graph_name_of(g, raw) = state\w_merge
        return: 1
    if: c.lmx_graph_name_of(g, raw) != 0
        return: 0
    path := (cast: (@: c.Lmx) raw)
    # Written groups use their receiving contract and physical fields, not
    # the current availability of a head nested inside them.
    if: c.lmx_graph_count(path) = 3U && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, path, 1U)) = state\w_deref
        return: 1
    # A grouped name/path remains a value without effects. A grouped call or
    # operation remains an ordinary actual, with shape checked before it runs.
    if: c.lmx_graph_count(path) = 1U
        return: lmx_graph_single_candidate(g, scope, path)
return: 0

# Bind the written actuals of expression to the formals of a signature before any of them is evaluated -- the one binder
# of a call (lmx_graph_bind_call) and of the contract of a receiver (lmx_graph_receiver_bind). A positional actual takes
# the formal at its position; a named actual `name := value` the formal of that name, after which no positional actual
# comes. A Frame `name: ...` is an actual application, never an argument label. The fields of one supplied whole
# argument Structure are bound separately by lmx_graph_bind_fields and keep their ordinary DATA role.
# A formal is bound at most once. bindings[i] the formal of actual i, modes[i] how (0 position, 1 `:=`; modes may
# be 0), seen[slot] 1 for a bound formal: arrays of the caller. 0, or 5 for actuals that bind no formal of the signature.
fn: lmx_graph_bind_formals (@: g c.LmxGraph; @: formals c.Lmx; @: expression c.Lmx; @: bindings size_t; @: modes int; @: seen int) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: argument c.Lmx 0
    @: raw void 0
    @: name char 0
    size_t: width c.lmx_graph_count(formals)
    size_t: count c.lmx_graph_count(expression)
    size_t: i 0U
    size_t: slot 0U
    int: named 0
    int: mode 0
    int: status 0
    if: state = 0 || bindings = 0 || seen = 0
        return: 5
    while: i < count && status = 0
        raw := c.lmx_graph_get_in(g, expression, i)
        argument := (cast: (@: c.Lmx) raw)
        slot := i
        mode := 0
        name := 0
        if: c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, argument, 0U)) = state\w_assign
            mode := 1
            name := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, argument, 1U))
            if: c.lmx_graph_count(argument) != 3U || name = 0
                status := 5
            ---
        ---
        if: mode != 0
            named := 1
            slot := c.lmx_graph_formal(g, formals, name)
        else:
            if: named != 0
                status := 5
            ---
        ---
        if: slot >= width
            status := 5
        if: status = 0
            if: seen[slot] != 0
                status := 5
            else:
                seen[slot] := 1
                bindings[i] := slot
                if: modes != 0
                    modes[i] := mode
                ---
            ---
        ---
        i := i + 1U
    ---
    return: status
end: lmx_graph_bind_formals

# Does the Structure give formals of the signature by its fields -- a named field by name, an unnamed field by position,
# each formal by one field at most (the book, whole-arguments)? from[slot] 1 + the index of its field, 0 for none (the caller's array, width
# + 1 long). The caller tells what an unsupplied formal needs (a default of a call; none for a receiver). 1 or 0.
fn: lmx_graph_bind_fields_mode (@: g c.LmxGraph; @: formals c.Lmx; @: structure c.Lmx; @: from size_t; int: pure) int
    @: name char 0
    @: declared char 0
    size_t: width c.lmx_graph_count(formals)
    size_t: n c.lmx_graph_count(structure)
    size_t: i 0U
    size_t: slot 0U
    if: from = 0
        return: 0
    while: i < n
        name := c.lmx_graph_slot_name(g, structure, i)
        if: pure != 0
            declared := c.lmx_graph_declaration_name(g, c.lmx_graph_get_in(g, structure, i))
            if: declared != 0
                name := declared
            ---
        ---
        slot := i
        if: name != 0
            slot := c.lmx_graph_formal(g, formals, name)
        if: slot >= width
            return: 0
        if: from[slot] != 0U
            return: 0
        from[slot] := i + 1U
        i := i + 1U
return: 1

fn: lmx_graph_bind_fields (@: g c.LmxGraph; @: formals c.Lmx; @: structure c.Lmx; @: from size_t) int
    return: lmx_graph_bind_fields_mode(g, formals, structure, from, 0)
end: lmx_graph_bind_fields

# Bind written arguments to the selected method before evaluating any of them. The map and the seen set belong
# only to this call; labels are canonical name addresses and the map stores physical formal slots, not name codes.
fn: lmx_graph_bind_call_mode (@: g c.LmxGraph; @: scope c.Lmx; @: code c.Lmx; @: expression c.Lmx; @: bindings size_t; int: pure) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: args c.Lmx 0
    @: argument c.Lmx 0
    @: raw void 0
    @: name char 0
    @: seen int 0
    size_t: count 0U
    size_t: width 0U
    size_t: i 0U
    size_t: slot 0U
    int: named 0
    int: status 0
    int: reading 0
    @: from size_t 0
    int: whole 0
    if: c.lmx_graph_method(g, code) = 0 || c.lmx_graph_kind(g, (cast: (@: void) expression)) != 4 || bindings = 0
        return: 5
    args := c.lmx_graph_method_data(g, code)
    width := c.lmx_graph_count(args)
    count := c.lmx_graph_count(expression)
    if: pure = 0 && lmx_graph_call_shape(g, code, width) != 0
        return: 5
    # A possible whole argument structure -- an empty Structure included, which is the empty field chain of a nullary
    # or default-only call -- is matched with the formals by lmx_graph_call_single once its value is known.
    if: pure != 0 && count = 1U && lmx_graph_written_group(g, c.lmx_graph_get_in(g, expression, 0U)) != 0
        reading := 2
    else:
        reading := lmx_graph_call_reading(g, scope, code, expression, 0)
    ---
    if: reading < 0
        return: 4
    bindings[count] := (cast: (size_t) reading)
    if: pure != 0 && reading = 2
        from := (cast: (@: size_t) c.calloc(width + 1U, sizeof(size_t)))
        if: from = 0
            return: 4
        whole := lmx_graph_bind_fields_mode(g, args, (cast: (@: c.Lmx) c.lmx_graph_get_in(g, expression, 0U)), from, 1)
        c.free((cast: (@: void) from))
        if: whole != 0
            return: 0
        # The same one supplied value can be the first formal's value rather than whole fields.
        if: width = 0U
            return: 5
        return: 0
    if: reading != 0
        return: 0
    if: count > width
        return: 5
    seen := (cast: (@: int) c.calloc(width + 1U, sizeof(int)))
    if: seen = 0
        return: 4
    status := lmx_graph_bind_formals(g, args, expression, bindings, 0, seen)
    c.free((cast: (@: void) seen))
    return: status
end: lmx_graph_bind_call_mode

# Runtime keeps its supported-result/default guard before any actual is evaluated.
fn: lmx_graph_bind_call (@: g c.LmxGraph; @: scope c.Lmx; @: code c.Lmx; @: expression c.Lmx; @: bindings size_t) int
    return: lmx_graph_bind_call_mode(g, scope, code, expression, bindings, 0)
end: lmx_graph_bind_call

# A source-local F, proved by its exact written declaration and the current namespace.
# Formals, data places, pending constructors and outer FREE fallbacks remain runtime-selected.
fn: lmx_graph_preflight_written (@: g c.LmxGraph; @: owner c.Lmx; size_t: slot; @: name char) @: c.Lmx
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void c.lmx_graph_get_in(g, owner, slot)
    @: head char c.lmx_graph_name_of(g, raw)
    @: made c.Lmx 0
    if: c.lmx_graph_kind(g, raw) != 4 || (head != state\w_fn && head != state\w_sub)
        return: 0
    if: slot = 1U && owner\parent != 0 && c.lmx_graph_get_in(g, (cast: (@: c.Lmx) owner\parent), 0U) = (cast: (@: void) owner) && lmx_graph_code_argument(g, (cast: (@: c.Lmx) owner\parent), 0U) = 2
        return: 0
    made := lmx_graph_binding_method(g, owner, raw)
    if: made = 0 || c.lmx_graph_space_find(owner, name) != (cast: (@: void) made)
        return: 0
    return: made
end: lmx_graph_preflight_written

# Ordinary named Frames in CODE are applications, not declarations that mask an outer local F.
# Declared places use the common view, including families not lowered by the current executor.
fn: lmx_graph_preflight_places (@: g c.LmxGraph; @: scope c.Lmx; @: name char; int: code_role; @: fn_slot size_t) size_t
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void 0
    @: head char 0
    size_t: i 0U
    size_t: found 0U
    fn_slot[0] := c.lmx_graph_count(scope)
    while: i < c.lmx_graph_count(scope)
        if: code_role != 0 && i = 1U && scope\parent != 0 && c.lmx_graph_get_in(g, (cast: (@: c.Lmx) scope\parent), 0U) = (cast: (@: void) scope) && lmx_graph_code_argument(g, (cast: (@: c.Lmx) scope\parent), 0U) = 2
            i := i + 1U
            continue
        raw := c.lmx_graph_get_in(g, scope, i)
        # This is a proof barrier, not DATA registration: an unresolved C-door
        # description cannot prove that the outer function remains the target.
        if: c.lmx_graph_declaration_name(g, raw) = name
            return: (cast: (size_t) -1)
        head := c.lmx_graph_name_of(g, raw)
        if: c.lmx_graph_kind(g, raw) = 4 && (head = state\w_fn || head = state\w_sub) && lmx_graph_fn_decl_name(g, (cast: (@: c.Lmx) raw)) = name
            fn_slot[0] := i
            found := found + 1U
        i := i + 1U
    return: found
end: lmx_graph_preflight_places

fn: lmx_graph_preflight_target (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: name char) @: c.Lmx
    @: scope c.Lmx frame\lexical_scope
    @: args c.Lmx (cast: (@: c.Lmx) frame\data)
    @: data c.Lmx frame\data
    size_t: slot 0U
    size_t: found 0U
    c.LmxGraphFrame: data_context
    if: name = 0 || lmx_graph_code_within(g, (cast: (@: c.Lmx) frame\body), scope) = 0
        return: 0
    if: c.lmx_graph_formal(g, args, name) < c.lmx_graph_count(args)
        return: 0
    c.memset((cast: (@: void) @ data_context), 0, c.sizeof(c.LmxGraphFrame))
    data_context\body := (cast: (@: void) data)
    data_context\lexical_scope := data
    if: lmx_graph_work_pending(g, @ data_context, name) != 0
        return: 0
    if: lmx_graph_preflight_places(g, data, name, 0, @ slot) = (cast: (size_t) -1)
        return: 0
    found := lmx_graph_data_find(g, data, name, 1, 0U, @ slot)
    if: found != 0U
        if: found != 1U
            return: 0
        return: lmx_graph_preflight_written(g, data, slot, name)
    if: lmx_graph_work_pending(g, frame, name) != 0
        return: 0
    while: scope != 0
        found := lmx_graph_preflight_places(g, scope, name, 1, @ slot)
        if: found != 0U
            if: found != 1U
                return: 0
            return: lmx_graph_preflight_written(g, scope, slot, name)
        if: c.lmx_graph_space_find(scope, name) != 0 || scope = frame\body
            return: 0
        scope := lmx_graph_code_parent(g, scope)
    return: 0
end: lmx_graph_preflight_target

# Preserve the lexical holder while expressions borrow nested Lmx operands.
fn: lmx_graph_preflight_scope_of (@: g c.LmxGraph; @: body c.Lmx; @: value c.Lmx) @: c.Lmx
    @: scope c.Lmx (cast: (@: c.Lmx) value\parent)
    while: scope != 0
        if: lmx_graph_code_within(g, body, scope) != 0
            return: scope
        scope := (cast: (@: c.Lmx) scope\parent)
    return: body
end: lmx_graph_preflight_scope_of

fn: lmx_graph_preflight_add (@: g c.LmxGraph; @: raw void; int: group; @@@: queue c.Lmx; @: count size_t; @: cap size_t) int
    if: c.lmx_graph_kind(g, raw) != 4 || c.lmx_graph_fn_result(g, raw) != 0
        return: 0
    if: group = 0 && lmx_graph_written_group(g, raw) != 0
        return: 0
    return: c.lmx_graph_scan_add(queue, count, cap, (cast: (@: c.Lmx) raw))
end: lmx_graph_preflight_add

# Only explicitly selected CodeBody fields are statements; the for condition is an expression.
fn: lmx_graph_preflight_body (@: g c.LmxGraph; @: body c.Lmx; size_t: from; size_t: to; int: role; @@@: statements c.Lmx; @: ns size_t; @: cs size_t; @@@: expressions c.Lmx; @: ne size_t; @: ce size_t) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void 0
    @: head char 0
    size_t: i from
    int: status 0
    if: role != 2
        status := lmx_graph_space_declarations(g, body)
    while: i < to && status = 0
        raw := c.lmx_graph_get_in(g, body, i)
        if: role = 2 && i = 1U
            status := lmx_graph_preflight_add(g, raw, 1, expressions, ne, ce)
        else:
            if: role = 2 && c.lmx_graph_kind(g, raw) = 4
                head := c.lmx_graph_name_of(g, raw)
                if: head = state\w_fn || head = state\w_sub
                    status := lmx_graph_space_declare(g, body, (cast: (@: c.Lmx) raw))
                    if: status = -1 || status = -2
                        status := 0
                    ---
                ---
            ---
            if: status = 0
                status := lmx_graph_preflight_add(g, raw, 0, statements, ns, cs)
            ---
        ---
        i := i + 1U
    return: status
end: lmx_graph_preflight_body

fn: lmx_graph_preflight_numeric_place (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: raw void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: name char c.lmx_graph_word_text(g, raw)
    @: scope c.Lmx frame\data
    @: args c.Lmx (cast: (@: c.Lmx) frame\data)
    @: field void 0
    size_t: slot 0U
    int: kind 0
    if: name = 0
        return: 0
    slot := c.lmx_graph_formal(g, args, name)
    if: slot < c.lmx_graph_count(args)
        return: (cast: (int) (lmx_graph_actual_contract(g, (cast: (@: c.Lmx) frame\code), slot) = 1))
    if: lmx_graph_data_find(g, scope, name, 1, 0U, @ slot) = 1U
        field := c.lmx_graph_get_in(g, scope, slot)
    else:
        scope := frame\lexical_scope
        while: scope != 0 && field = 0
            if: lmx_graph_data_find(g, scope, name, 1, 0U, @ slot) = 1U
                field := c.lmx_graph_get_in(g, scope, slot)
            if: scope = frame\body
                break
            scope := lmx_graph_code_parent(g, scope)
        ---
    ---
    kind := c.lmx_graph_kind(g, field)
    return: (cast: (int) (kind = 1 || kind = 3 || c.lmx_graph_name_of(g, field) = state\w_int))
end: lmx_graph_preflight_numeric_place

fn: lmx_graph_preflight_scope (@: g c.LmxGraph; @: code c.Lmx; @: body c.Lmx; @: data c.Lmx; @: args c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    c.LmxGraphFrame: frame
    @@: statements c.Lmx 0
    @@: expressions c.Lmx 0
    size_t: ns 0U
    size_t: cs 0U
    size_t: ne 0U
    size_t: ce 0U
    size_t: at 0U
    size_t: i 0U
    size_t: n 0U
    size_t: selected_from 0U
    size_t: selected_to 0U
    @: current c.Lmx 0
    @: selected c.Lmx 0
    @: target c.Lmx 0
    @: actuals c.Lmx 0
    @: head_expr void 0
    @: raw void 0
    @: head char 0
    @: op char 0
    @: bindings size_t 0
    @: fields size_t 0
    int: status 0
    int: role 0
    int: group 0
    int: reading 0
    int: applied 0
    c.memset((cast: (@: void) @ frame), 0, c.sizeof(c.LmxGraphFrame))
    frame\code := (cast: (@: void) code)
    frame\body := (cast: (@: void) body)
    frame\data := data
    status := lmx_graph_preflight_body(g, body, 0U, c.lmx_graph_count(body), 1, @ statements, @ ns, @ cs, @ expressions, @ ne, @ ce)
    while: at < ns && status = 0
        current := statements[at]
        at := at + 1U
        head := c.lmx_graph_name_of(g, (cast: (@: void) current))
        if: head = state\w_fn || head = state\w_sub || head = state\w_fm
            continue
        role := lmx_graph_code_body(g, current, 0U, @ selected, @ selected_from, @ selected_to)
        if: lmx_graph_role_code(role) != 0
            status := lmx_graph_preflight_body(g, selected, selected_from, selected_to, role, @ statements, @ ns, @ cs, @ expressions, @ ne, @ ce)
            continue
        if: head = state\w_if || head = state\w_while || head = state\w_until || head = state\w_for
            i := 0U
            while: i < c.lmx_graph_count(current) && status = 0
                role := lmx_graph_code_body(g, current, i, @ selected, @ selected_from, @ selected_to)
                if: role != 0
                    status := lmx_graph_preflight_body(g, selected, selected_from, selected_to, role, @ statements, @ ns, @ cs, @ expressions, @ ne, @ ce)
                else:
                    raw := c.lmx_graph_get_in(g, current, i)
                    if: c.lmx_graph_kind(g, raw) = 4 && lmx_graph_code_argument(g, (cast: (@: c.Lmx) raw), 0U) = 3
                        status := lmx_graph_preflight_add(g, raw, 0, @ statements, @ ns, @ cs)
                    else:
                        status := lmx_graph_preflight_add(g, raw, 1, @ expressions, @ ne, @ ce)
                    ---
                ---
                i := i + 1U
            ---
        else:
            status := c.lmx_graph_scan_add(@ expressions, @ ne, @ ce, current)
        ---
    ---
    at := 0U
    while: at < ne && status = 0
        current := expressions[at]
        at := at + 1U
        frame\lexical_scope := lmx_graph_preflight_scope_of(g, body, current)
        head := c.lmx_graph_name_of(g, (cast: (@: void) current))
        if: head = state\w_fn || head = state\w_sub || head = state\w_fm
            continue
        n := c.lmx_graph_count(current)
        actuals := current
        head_expr := 0
        target := 0
        bindings := 0
        reading := 0
        applied := c.lmx_graph_application_parts(g, (cast: (@: void) current), @ head, @ head_expr, @ actuals)
        if: applied != 0
            if: head != 0 && lmx_graph_language_word(state, head) = 0 && c.lmx_graph_language_receiver(head) = 0
                target := lmx_graph_preflight_target(g, @ frame, head)
            if: target != 0
                n := c.lmx_graph_count(actuals)
                bindings := (cast: (@: size_t) c.calloc(n + 1U, sizeof(size_t)))
                if: bindings = 0
                    status := 4
                    break
                status := lmx_graph_bind_call_mode(g, (cast: (@: c.Lmx) frame\lexical_scope), target, actuals, bindings, 1)
                reading := (cast: (int) bindings[n])
            ---
            if: head_expr != 0 && status = 0
                status := lmx_graph_preflight_add(g, head_expr, 0, @ expressions, @ ne, @ ce)
            current := actuals
            n := c.lmx_graph_count(current)
        ---
        op := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, current, 1U))
        i := 0U
        if: head = state\w_int || head = state\w_at
            i := 1U
        while: i < n && status = 0
            raw := c.lmx_graph_get_in(g, current, i)
            group := 0
            if: target != 0 && reading = 0
                group := (cast: (int) (lmx_graph_actual_contract(g, target, bindings[i]) = 1))
            if: target != 0 && reading = 2 && lmx_graph_actual_contract(g, target, 0U) = 1
                fields := (cast: (@: size_t) c.calloc(c.lmx_graph_count(c.lmx_graph_method_data(g, target)) + 1U, sizeof(size_t)))
                if: fields = 0
                    status := 4
                    break
                group := (cast: (int) (lmx_graph_written_whole(g, target, (cast: (@: c.Lmx) raw), fields) = 0))
                c.free((cast: (@: void) fields))
                fields := 0
            ---
            if: head = state\w_int || (head = state\w_return && c.lmx_graph_word_text(g, c.lmx_graph_method_return(g, code)) = state\w_int)
                group := 1
            if: head = 0 && applied = 0
                group := 1
                if: n = 3U && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, current, 0U)) = state\w_assign && i = 2U
                    group := lmx_graph_preflight_numeric_place(g, @ frame, c.lmx_graph_get_in(g, current, 1U))
                if: lmx_graph_value_contract(g, current, i) = 2
                    group := 0
            ---
            if: c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, (cast: (@: c.Lmx) raw), 0U)) = state\w_assign && target != 0
                raw := c.lmx_graph_get_in(g, (cast: (@: c.Lmx) raw), 2U)
            if: head = 0 && n = 3U && op = state\w_deref && i = 2U
                i := i + 1U
                continue
            status := lmx_graph_preflight_add(g, raw, group, @ expressions, @ ne, @ ce)
            i := i + 1U
        ---
        c.free((cast: (@: void) bindings))
        bindings := 0
    ---
    c.free((cast: (@: void) statements))
    c.free((cast: (@: void) expressions))
    c.free((cast: (@: void) bindings))
    return: status
end: lmx_graph_preflight_scope

# Construction keeps only temporary role queues. Expression operands are not
# lexical DATA scopes; fn signatures and method DATA never enter these queues.
fn: lmx_graph_construct_has (@@: nodes c.Lmx; size_t: count; @: value c.Lmx) int
    size_t: i 0U
    while: i < count
        if: nodes[i] = value
            return: 1
        i := i + 1U
    return: 0

fn: lmx_graph_construct_method (@: g c.LmxGraph; @: holder c.Lmx; @@: codes c.Lmx; size_t: count) @: c.Lmx
    @: current c.Lmx holder
    @: space c.LmxGraphSpace c.lmx_graph_space()
    @: row c.LmxGraphSpaceRow 0
    @: made c.Lmx 0
    size_t: i 0U
    while: current != 0 && space != 0
        if: lmx_graph_construct_has(codes, count, current) != 0
            i := 0U
            while: i < space\count
                row := space\rows + i
                made := (cast: (@: c.Lmx) row\value)
                if: c.lmx_graph_method(g, made) != 0 && c.lmx_graph_method_code(g, made) = current && lmx_graph_binding_method(g, (cast: (@: c.Lmx) row\scope), (cast: (@: void) made\parent)) = made
                    return: made
                i := i + 1U
            ---
        ---
        current := (cast: (@: c.Lmx) current\parent)
    return: (cast: (@: c.Lmx) 0)

# A pending local declaration closes a construction-time outer fallback.
fn: lmx_graph_construct_pending (@: g c.LmxGraph; @: scope c.Lmx; @: name char; int: code_role) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void 0
    @: head char 0
    @: declared char 0
    @: leaf void 0
    @: model void 0
    @: candidate void 0
    int: presence 0 - 1
    int: known 0
    size_t: i 0U
    while: i < c.lmx_graph_count(scope)
        if: code_role != 0 && lmx_graph_code_condition(g, scope, i) != 0
            i := i + 1U
            continue
        raw := c.lmx_graph_get_in(g, scope, i)
        head := c.lmx_graph_name_of(g, raw)
        declared := c.lmx_graph_declaration_parts(g, raw, @ leaf, @ model, @ candidate, @ presence, @ known)
        if: declared = name && known = 0
            return: 1
        if: c.lmx_graph_kind(g, raw) = 4 && (head = state\w_fn || head = state\w_sub)
            declared := lmx_graph_fn_decl_name(g, (cast: (@: c.Lmx) raw))
            if: declared = 0 || (declared = name && lmx_graph_binding_method(g, scope, raw) = 0)
                return: 1
            ---
        ---
        i := i + 1U
    return: 0

# Project an exact source slot, below the unique-name guard of a bare binding.
# A selected occurrence of a written fn has its own F even beside namesakes.
# Mutable references, including the named links of F, are never payload proofs.
fn: lmx_graph_construct_slot (@: g c.LmxGraph; @: owner c.Lmx; size_t: slot; @@: data c.Lmx; size_t: nd; @@: codes c.Lmx; size_t: nc) @: void
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void c.lmx_graph_get_in(g, owner, slot)
    @: head char c.lmx_graph_name_of(g, raw)
    int: kind c.lmx_graph_kind(g, raw)
    if: kind = 4 && (head = state\w_fn || head = state\w_sub)
        return: (cast: (@: void) lmx_graph_binding_method(g, owner, raw))
    if: kind = 1 || kind = 3
        return: raw
    if: kind = 2 && head = 0
        return: lmx_graph_construct_atom(g, owner, c.lmx_graph_word_text(g, raw), data, nd, codes, nc)
    # An explicit path selects the stored Frame as data, even when its head
    # would be an application in CODE. Only a declaring place needs its value.
    if: kind = 4 && c.lmx_graph_declaration_receiver(head) = 0
        return: raw
    return: (cast: (@: void) 0)

# Actual F.data is a lexical DATA scope even when intentionally absent from the
# materialization queue. This readonly role proof never scans its blueprint.
fn: lmx_graph_construct_data_scope (@: g c.LmxGraph; @: scope c.Lmx; @@: data c.Lmx; size_t: nd) int
    @: owner c.Lmx 0
    if: lmx_graph_construct_has(data, nd, scope) != 0
        return: 1
    if: scope = 0
        return: 0
    owner := (cast: (@: c.Lmx) scope\parent)
    if: c.lmx_graph_fn_result(g, (cast: (@: void) owner)) = 0
        return: 0
    return: (cast: (int) (c.lmx_graph_method_data(g, owner) = scope))

# A selected atom has the ordinary lexical-only contract, not the initializer's
# activation lookup. Audit skipped scopes for a still-pending local name, then
# prove the exact slot returned by the existing nonconstructing atom reader.
fn: lmx_graph_construct_atom (@: g c.LmxGraph; @: holder c.Lmx; @: name char; @@: data c.Lmx; size_t: nd; @@: codes c.Lmx; size_t: nc) @: void
    @: owner c.Lmx 0
    @: current c.Lmx holder
    size_t: slot 0U
    int: code_role 0
    lmx_graph_atom_target(g, holder, name, @ owner, @ slot)
    if: owner = 0 || slot >= c.lmx_graph_count(owner)
        return: (cast: (@: void) 0)
    while: current != 0 && current != owner
        code_role := lmx_graph_construct_has(codes, nc, current)
        if: code_role != 0 || lmx_graph_construct_data_scope(g, current, data, nd) != 0
            if: lmx_graph_construct_pending(g, current, name, code_role) != 0
                return: (cast: (@: void) 0)
            ---
        ---
        # A callable's DATA is also a lexical level in the existing atom reader.
        # Selection alone does not make a mutable value in that level known.
        if: c.lmx_graph_method(g, current) != 0 && c.lmx_graph_method_data(g, current) = owner
            break
        current := (cast: (@: c.Lmx) current\parent)
    if: current = 0
        return: (cast: (@: void) 0)
    return: lmx_graph_construct_slot(g, owner, slot, data, nd, codes, nc)

# Source-known values only: no activation resolver, old payload read, call or
# lexical substitution for an unentered formal, DATA place or FREE input.
fn: lmx_graph_construct_binding (@: g c.LmxGraph; @: holder c.Lmx; @: name char; @@: data c.Lmx; size_t: nd; @@: codes c.Lmx; size_t: nc) @: void
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: current c.Lmx holder
    @: method c.Lmx lmx_graph_construct_method(g, holder, codes, nc)
    @: body c.Lmx c.lmx_graph_method_code(g, method)
    @: raw void 0
    @: value void 0
    @: head char 0
    size_t: slot 0U
    size_t: found 0U
    if: name = 0 || lmx_graph_language_word(state, name) != 0
        return: (cast: (@: void) 0)
    while: current != 0
        if: lmx_graph_construct_has(codes, nc, current) != 0
            if: method != 0
                if: c.lmx_graph_formal(g, c.lmx_graph_method_data(g, method), name) < c.lmx_graph_count(c.lmx_graph_method_data(g, method))
                    return: (cast: (@: void) 0)
                if: lmx_graph_data_find(g, c.lmx_graph_method_data(g, method), name, 1, 0U, @ slot) != 0U
                    return: (cast: (@: void) 0)
                ---
            ---
            if: lmx_graph_construct_pending(g, current, name, 1) != 0
                return: (cast: (@: void) 0)
            found := lmx_graph_preflight_places(g, current, name, 1, @ slot)
            if: found != 0U
                if: found != 1U
                    return: (cast: (@: void) 0)
                return: (cast: (@: void) lmx_graph_preflight_written(g, current, slot, name))
            if: current = body
                return: (cast: (@: void) 0)
            ---
        else:
            if: lmx_graph_construct_has(data, nd, current) != 0
                found := lmx_graph_data_find(g, current, name, 1, 0U, @ slot)
                if: found > 1U
                    return: (cast: (@: void) 0)
                if: found = 1U
                    raw := c.lmx_graph_get_in(g, current, slot)
                    head := c.lmx_graph_name_of(g, raw)
                    if: c.lmx_graph_kind(g, raw) = 4 && (head = state\w_fn || head = state\w_sub)
                        value := (cast: (@: void) lmx_graph_binding_method(g, current, raw))
                        if: value != 0 && c.lmx_graph_space_find(current, name) = value
                            return: value
                        return: (cast: (@: void) 0)
                    return: lmx_graph_construct_slot(g, current, slot, data, nd, codes, nc)
                ---
                if: lmx_graph_construct_pending(g, current, name, 0) != 0
                    return: (cast: (@: void) 0)
            ---
        ---
        current := (cast: (@: c.Lmx) current\parent)
    return: (cast: (@: void) 0)
end: lmx_graph_construct_binding

# Pure Structure-value projection for a receiving reference. No generic read,
# target unwrap, index reference allocation or evaluator runs here. Each finite
# written selector chooses the same physical slot as the runtime reader.
fn: lmx_graph_construct_value (@: g c.LmxGraph; @: holder c.Lmx; @: raw void; @@: data c.Lmx; size_t: nd; @@: codes c.Lmx; size_t: nc) @: void
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: path c.Lmx (cast: (@: c.Lmx) raw)
    @: value void 0
    @: index void 0
    @: op char 0
    size_t: slot 0U
    int: number 0
    int: kind c.lmx_graph_kind(g, raw)
    if: kind = 2
        return: lmx_graph_construct_binding(g, holder, c.lmx_graph_word_text(g, raw), data, nd, codes, nc)
    if: kind != 4
        return: (cast: (@: void) 0)
    if: lmx_graph_construct_has(data, nd, path) != 0 && c.lmx_graph_declaration_receiver(c.lmx_graph_name_of(g, raw)) = 0
        return: raw
    if: c.lmx_graph_name_of(g, raw) != 0 || c.lmx_graph_count(path) != 3U
        return: (cast: (@: void) 0)
    op := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, path, 1U))
    if: op != state\w_deref && op != state\w_index
        return: (cast: (@: void) 0)
    value := lmx_graph_construct_value(g, holder, c.lmx_graph_get_in(g, path, 0U), data, nd, codes, nc)
    if: c.lmx_graph_kind(g, value) != 4
        return: (cast: (@: void) 0)
    if: op = state\w_deref
        slot := lmx_graph_step_index(g, (cast: (@: c.Lmx) value), c.lmx_graph_get_in(g, path, 2U))
    else:
        index := c.lmx_graph_get_in(g, path, 2U)
        if: c.lmx_graph_kind(g, index) != 1 || c.lmx_graph_name_of(g, index) != 0
            return: (cast: (@: void) 0)
        number := c.lmx_int_value_known(index)
        if: number < 0
            return: (cast: (@: void) 0)
        slot := (cast: (size_t) number)
    ---
    if: slot >= c.lmx_graph_count((cast: (@: c.Lmx) value))
        return: (cast: (@: void) 0)
    if: op = state\w_index
        # An index addresses the immediate value, unlike a named logical step:
        # raw fn/declaration Frames stay Structures and atoms stay WORD cells.
        # A mutable reference in that cell still supplies no payload proof.
        raw := c.lmx_graph_get_in(g, (cast: (@: c.Lmx) value), slot)
        if: c.lmx_graph_kind(g, raw) = 4
            return: raw
        return: (cast: (@: void) 0)
    return: lmx_graph_construct_slot(g, (cast: (@: c.Lmx) value), slot, data, nd, codes, nc)

# Every name in this operation uses canonical Graph addresses, transported
# through the worker's opaque size_t key. No numeric identifier table is mixed
# into that namespace. Unknown is separate from a proved anonymous place.
fn: lmx_graph_source_name (@: context void; @: owner c.Lmx; size_t: field; @: out size_t; @: out_answer int) int
    @: g c.LmxGraph (cast: (@: c.LmxGraph) context)
    @: raw void c.lmx_graph_get_in(g, owner, field)
    @: leaf void 0
    @: model void 0
    @: candidate void 0
    @: name char 0
    int: presence 0 - 1
    int: known 0
    if: out = 0 || out_answer = 0 || g = 0 || field >= c.lmx_graph_count(owner)
        return: c.LMX_WALK_INVALID
    out[0] := 0U
    out_answer[0] := c.LMX_IMPLEMENTS_UNKNOWN
    name := c.lmx_graph_declaration_parts(g, raw, @ leaf, @ model, @ candidate, @ presence, @ known)
    if: known = 0 || (name = 0 && c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_declaration_receiver(c.lmx_graph_name_of(g, raw)) != 0)
        return: c.LMX_WALK_OK
    if: name = 0
        name := c.lmx_graph_slot_name(g, owner, field)
    out[0] := (cast: (size_t) name)
    out_answer[0] := c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK

# Metadata only: the physical fact is preserved, and raw receiving chains are
# borrowed with all their Models/defaults. Only a stable uninit service pointer
# is followed; language references never yield payloads to construction proof.
fn: lmx_graph_source_fact (@: context void; @: arena c.LmxArena; @: owner c.Lmx; size_t: field; int: interface; @: references c.Lmx; @: scratch c.LmxScratch; @: out c.LmxImplContractFact; @: out_answer int) int
    @: g c.LmxGraph (cast: (@: c.LmxGraph) context)
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void 0
    @: current void 0
    @: leaf void 0
    @: model void 0
    @: candidate void 0
    @: name char 0
    @: head char 0
    @: room void 0
    @: scalar_pool c.LmxPool 0
    @: scalar_context c.LmxWalkValue 0
    size_t: depth 0U
    size_t: i 0U
    int: presence 0 - 1
    int: known 0
    int: kind 0
    int: status c.lmx_implements_contract_field(arena, owner, field, interface, references, out, out_answer)
    if: status != c.LMX_WALK_OK || field = (cast: (size_t) -1)
        return: status
    raw := out\cell
    scalar_pool := c.lmx_range_cell_pool(arena, raw)
    if: scalar_pool != 0 && scalar_pool\kind = c.LMX_KIND_PRIMITIVE && c.lmx_type_base(scalar_pool\type) = c.LMX_TYPE_FOREIGN
        scalar_context := c.lmx_value_cell_context(arena, raw)
        out\declared_raw := raw
        out\declared := 2
        out_answer[0] := c.LMX_IMPLEMENTS_UNKNOWN
        if: scalar_context != 0 && scalar_pool\type = c.LMX_TYPE_FOREIGN && scalar_pool\profile = 0 && c.lmx_graph_scalar_source(scalar_pool\scalar_abi, scalar_context\source_type) != 0
            out\declared_type := scalar_context\source_type
            out\declared := 1
            out_answer[0] := c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    kind := c.lmx_graph_kind(g, raw)
    if: kind = 0
        return: c.LMX_WALK_OK
    if: kind = 1 || kind = 3
        out\declared := 1
        out\declared_raw := raw
        out\declared_type := c.lmx_graph_primitive_description(state\w_int)
        if: out\declared_type = 0
            out\declared := 2
        out_answer[0] := c.LMX_IMPLEMENTS_YES
        return: c.LMX_WALK_OK
    if: kind = 5 || kind = 6 || kind = 7 || kind = 8 || kind = 9
        out\declared := 2
        out\declared_raw := raw
        out_answer[0] := c.LMX_IMPLEMENTS_UNKNOWN
        return: c.LMX_WALK_OK
    if: kind != 4
        return: c.LMX_WALK_OK
    head := c.lmx_graph_name_of(g, raw)
    if: c.lmx_graph_declaration_receiver(head) = 0
        if: lmx_graph_language_word(state, head) != 0 || c.lmx_graph_method(g, (cast: (@: c.Lmx) raw)) != 0
            out\executable := 1
            out\declared := 2
            out\declared_raw := raw
            out_answer[0] := c.LMX_IMPLEMENTS_UNKNOWN
        return: c.LMX_WALK_OK
    out\declared := 2
    out\declared_raw := raw
    out_answer[0] := c.LMX_IMPLEMENTS_UNKNOWN
    name := c.lmx_graph_declaration_parts(g, raw, @ leaf, @ model, @ candidate, @ presence, @ known)
    if: name = 0 || known = 0
        return: c.LMX_WALK_OK
    kind := c.lmx_graph_kind(g, leaf)
    if: kind = 1 || kind = 3
        out\declared_type := c.lmx_graph_primitive_description(state\w_int)
    else:
        if: kind != 4 || c.lmx_graph_declaration_receiver(c.lmx_graph_name_of(g, leaf)) != 1
            return: c.LMX_WALK_OK
        out\declared_type := c.lmx_graph_primitive_description(c.lmx_graph_name_of(g, leaf))
    if: out\declared_type = 0
        return: c.LMX_WALK_OK
    current := raw
    while: current != leaf
        current := c.lmx_graph_get_in(g, (cast: (@: c.Lmx) current), 0U)
        if: c.lmx_graph_kind(g, current) = 4 && c.lmx_graph_name_of(g, current) = 0
            current := c.lmx_graph_get_in(g, (cast: (@: c.Lmx) current), 0U)
        depth := depth + 1U
    if: depth > (cast: (size_t) -1) / c.sizeof(c.size_t)
        return: c.LMX_WALK_NOMEM
    if: depth != 0U
        status := c.lmx_scratch_take(scratch, depth * c.sizeof(c.size_t), @ room)
        if: status != c.LMX_SCRATCH_OK
            if: status = c.LMX_SCRATCH_NOMEM
                return: c.LMX_WALK_NOMEM
            return: c.LMX_WALK_INVALID
        out\declared_chain := (cast: (@: size_t) room)
    current := raw
    while: i < depth
        out\declared_chain[i] := (cast: (size_t) c.lmx_graph_name_of(g, current))
        current := c.lmx_graph_get_in(g, (cast: (@: c.Lmx) current), 0U)
        if: c.lmx_graph_kind(g, current) = 4 && c.lmx_graph_name_of(g, current) = 0
            current := c.lmx_graph_get_in(g, (cast: (@: c.Lmx) current), 0U)
        i := i + 1U
    out\declared_count := depth
    out\declared := 1
    out_answer[0] := c.LMX_IMPLEMENTS_YES
    return: c.LMX_WALK_OK

# Interface-only Source admission uses the existing operation and its scratch.
# The result neither publishes a permission nor calls test/conversion code.
fn: lmx_graph_source_interface (@: g c.LmxGraph; @: value c.Lmx; @: model c.Lmx; @: out_answer int) int
    c.LmxImplSourceReader: reader
    c.memset((cast: (@: void) (@ reader)), 0, c.sizeof(c.LmxImplSourceReader))
    reader\context := (cast: (@: void) g)
    reader\name := c.lmx_graph_source_name
    reader\fact := c.lmx_graph_source_fact
    return: c.lmx_implements_source_interface(g\arena, value, model, @ reader, out_answer)

# One reference source field. A written DATA value is already a Structure;
# expressions, unavailable values and true uninitialized references stay raw.
fn: lmx_graph_construct_field (@: g c.LmxGraph; @: holder c.Lmx; size_t: index; @@: data c.Lmx; size_t: nd; @@: codes c.Lmx; size_t: nc) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void c.lmx_graph_get_in(g, holder, index)
    @: declaration c.Lmx (cast: (@: c.Lmx) raw)
    @: candidate void 0
    @: value void 0
    @: cell void 0
    @: name char 0
    @: model void 0
    size_t: count 0U
    int: answer c.LMX_IMPLEMENTS_UNKNOWN
    int: status
    raw := c.lmx_graph_binding_leaf(g, raw)
    declaration := (cast: (@: c.Lmx) raw)
    if: c.lmx_graph_kind(g, raw) != 4 || c.lmx_graph_name_of(g, raw) != state\w_at
        return: 0
    count := c.lmx_graph_count(declaration)
    if: count != 2U && count != 3U
        return: 0
    name := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, declaration, 0U))
    if: name = 0 || lmx_graph_language_word(state, name) != 0
        return: 0
    candidate := c.lmx_graph_get_in(g, declaration, count - 1U)
    value := lmx_graph_construct_value(g, holder, candidate, data, nd, codes, nc)
    if: value = 0
        return: 0
    if: count = 3U
        model := lmx_graph_construct_value(g, holder, c.lmx_graph_get_in(g, declaration, 1U), data, nd, codes, nc)
        if: model = 0
            return: 0
        status := lmx_graph_source_interface(g, (cast: (@: c.Lmx) value), (cast: (@: c.Lmx) model), @ answer)
        if: status != c.LMX_WALK_OK || answer = c.LMX_IMPLEMENTS_NO
            return: 4
        # Interface proof does not supply typed storage or erase the written
        # Model/default. Runtime admission/test is still a separate phase.
        return: 0
    if: c.lmx_graph_kind(g, c.lmx_graph_target(g, value)) != 4
        return: 4
    cell := c.lmx_graph_lmx_ref_of(g, value)
    if: cell = 0 || c.lmx_graph_publish(g, holder, index, cell) != 0
        return: 4
    return: 0
end: lmx_graph_construct_field

# An explicit new-graph construction, never a read/backfill of existing DATA.
# Its own fresh namespace dies here; retained F values are ordinary graph
# contents. A later preflight or execution creates its own independent F.
fn: lmx_graph_construct (@: g c.LmxGraph; @: root c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: space c.LmxGraphSpace 0
    @: row c.LmxGraphSpaceRow 0
    @@: data c.Lmx 0
    @@: codes c.Lmx 0
    @@: expressions c.Lmx 0
    size_t: nd 0U
    size_t: nc 0U
    size_t: ne 0U
    size_t: cd 0U
    size_t: cc 0U
    size_t: ce 0U
    size_t: ad 0U
    size_t: ac 0U
    size_t: ae 0U
    size_t: af 0U
    size_t: i 0U
    size_t: at 0U
    size_t: count 0U
    @: current c.Lmx 0
    @: selected c.Lmx 0
    @: made c.Lmx 0
    @: raw void 0
    @: head char 0
    @: leaf void 0
    @: model void 0
    @: candidate void 0
    @: declared char 0
    int: presence 0 - 1
    int: known 0
    int: family 0
    @@: nodes c.Lmx 0
    size_t: code_from 0U
    size_t: code_to 0U
    int: role 0
    int: part 0
    int: status 0
    int: opened 0
    if: g = 0 || state = 0 || c.lmx_graph_kind(g, (cast: (@: void) root)) != 4
        return: 4
    opened := c.lmx_graph_space_push_fresh(root)
    if: opened < 0
        return: 4
    status := lmx_graph_receivers_open(g, root)
    space := c.lmx_graph_space()
    if: status = 0
        status := c.lmx_graph_scan_add(@ data, @ nd, @ cd, root)
    while: status = 0 && (ad < nd || ac < nc || ae < ne || af < space\count)
        # Real F values created in copied method DATA also own CODE. Examine
        # those new occurrences, never rewrite their source DATA blueprint.
        while: af < space\count && status = 0
            row := space\rows + af
            made := (cast: (@: c.Lmx) row\value)
            af := af + 1U
            if: c.lmx_graph_method(g, made) != 0 && lmx_graph_binding_method(g, (cast: (@: c.Lmx) row\scope), (cast: (@: void) made\parent)) = made
                status := c.lmx_graph_scan_add(@ codes, @ nc, @ cc, c.lmx_graph_method_code(g, made))
            ---
        ---
        if: status != 0 || (ad >= nd && ac >= nc && ae >= ne)
            break
        role := 3
        if: ad < nd
            current := data[ad]
            ad := ad + 1U
            role := 1
        else:
            if: ac < nc
                current := codes[ac]
                ac := ac + 1U
                role := 2
            else:
                current := expressions[ae]
                ae := ae + 1U
            ---
        ---
        # A queued expression can itself be a receiving root. Its operand
        # group must not acquire DATA identity merely by being visited later.
        head := c.lmx_graph_name_of(g, (cast: (@: void) current))
        family := c.lmx_graph_declaration_receiver(head)
        if: family != 0 && (family != 1 || c.lmx_graph_primitive_receiver(head) != 0)
            continue
        if: role = 1 && status = 0
            status := lmx_graph_space_declarations(g, current)
        if: role = 2
            if: lmx_graph_code_condition(g, current, 1U) != 0
                status := lmx_graph_space_declarations_part(g, current, 0U, 1U)
                if: status = 0
                    status := lmx_graph_space_declarations_part(g, current, 2U, c.lmx_graph_count(current))
                ---
            else:
                status := lmx_graph_space_declarations(g, current)
            ---
        ---
        if: role = 3 && lmx_graph_role_code(lmx_graph_code_body(g, current, 0U, @ selected, @ code_from, @ code_to)) != 0
            status := c.lmx_graph_scan_add(@ codes, @ nc, @ cc, selected)
        head := c.lmx_graph_name_of(g, (cast: (@: void) current))
        if: role = 3 && (head = state\w_fn || head = state\w_sub)
            continue
        i := 0U
        while: i < c.lmx_graph_count(current) && status = 0
            raw := c.lmx_graph_get_in(g, current, i)
            if: role != 3
                raw := c.lmx_graph_binding_leaf(g, raw)
            if: c.lmx_graph_kind(g, raw) != 4
                i := i + 1U
                continue
            head := c.lmx_graph_name_of(g, raw)
            if: role = 2 && lmx_graph_code_condition(g, current, i) != 0
                status := c.lmx_graph_scan_add(@ expressions, @ ne, @ ce, (cast: (@: c.Lmx) raw))
                i := i + 1U
                continue
            family := c.lmx_graph_declaration_receiver(head)
            declared := c.lmx_graph_declaration_parts(g, raw, @ leaf, @ model, @ candidate, @ presence, @ known)
            if: family != 0 && (family != 1 || c.lmx_graph_primitive_receiver(head) != 0)
                # The receiving chain and its operand groups are not DATA scopes.
                # Retain unsupported roots whole. Only the existing direct @ value
                # constructor owns a literal DATA operand; typed models stay requirements.
                if: declared = 0 || leaf != raw || family != 1
                    candidate := 0
                if: declared != 0 && leaf = raw && head = state\w_at && c.lmx_graph_count((cast: (@: c.Lmx) raw)) = 2U
                    candidate := c.lmx_graph_get_in(g, (cast: (@: c.Lmx) raw), 1U)
                part := 0
                if: head = state\w_at
                    part := lmx_graph_written_group(g, candidate)
                if: c.lmx_graph_kind(g, candidate) = 4 && part != 0
                    status := c.lmx_graph_scan_add(@ data, @ nd, @ cd, (cast: (@: c.Lmx) candidate))
                if: c.lmx_graph_kind(g, candidate) = 4 && part = 0
                    status := c.lmx_graph_scan_add(@ expressions, @ ne, @ ce, (cast: (@: c.Lmx) candidate))
                i := i + 1U
                continue
            if: head = state\w_fn || head = state\w_sub
                # A method's code is examined even when it is never called;
                # args/defaults, result and DATA keep their own contracts.
                if: role != 3
                    made := lmx_graph_binding_method(g, current, raw)
                    if: made != 0 && c.lmx_graph_method_code(g, made) != 0
                        status := c.lmx_graph_scan_add(@ codes, @ nc, @ cc, c.lmx_graph_method_code(g, made))
                    ---
                ---
            else:
                part := 0
                if: role != 1
                    part := lmx_graph_code_body(g, current, i, @ selected, @ code_from, @ code_to)
                if: part != 0 && selected = raw
                    status := c.lmx_graph_scan_add(@ codes, @ nc, @ cc, selected)
                else:
                    if: lmx_graph_written_group(g, raw) != 0 || (role = 1 && head != 0 && head != state\w_at && head != state\w_int && c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_space_find(current, head))) = 0)
                        status := c.lmx_graph_scan_add(@ data, @ nd, @ cd, (cast: (@: c.Lmx) raw))
                    else:
                        status := c.lmx_graph_scan_add(@ expressions, @ ne, @ ce, (cast: (@: c.Lmx) raw))
                    ---
                ---
            ---
            i := i + 1U
        ---
    ---
    # Source-known values need no evaluation/fixedpoint over mutable aliases.
    part := 0
    while: part < 3 && status = 0
        nodes := data
        count := nd
        if: part = 1
            nodes := codes
            count := nc
        if: part = 2
            nodes := expressions
            count := ne
        at := 0U
        while: at < count && status = 0
            current := nodes[at]
            head := c.lmx_graph_name_of(g, (cast: (@: void) current))
            family := c.lmx_graph_declaration_receiver(head)
            if: family != 0 && (family != 1 || c.lmx_graph_primitive_receiver(head) != 0)
                at := at + 1U
                continue
            i := 0U
            while: i < c.lmx_graph_count(current) && status = 0
                status := lmx_graph_construct_field(g, current, i, data, nd, codes, nc)
                i := i + 1U
            at := at + 1U
        ---
        part := part + 1
    ---
    c.free((cast: (@: void) data))
    c.free((cast: (@: void) codes))
    c.free((cast: (@: void) expressions))
    lmx_graph_space_close(opened)
    return: status
end: lmx_graph_construct

# Construction uses a fresh traversal namespace and the same declaring contracts and binder as execution.
# No activation, capture, default, actual or test runs here; no namespace survives this pass.
fn: lmx_graph_preflight (@: g c.LmxGraph; @: root c.Lmx) int
    @: space c.LmxGraphSpace 0
    @: row c.LmxGraphSpaceRow 0
    @@: functions c.Lmx 0
    @: made c.Lmx 0
    @: raw void 0
    @: head char 0
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    size_t: count 0U
    size_t: cap 0U
    size_t: at 0U
    size_t: i 0U
    int: opened 0
    int: status lmx_graph_space_open(g, root, @ opened)
    if: status != 0 || opened = 0
        return: status
    status := lmx_graph_preflight_scope(g, root, root, root, 0)
    space := c.lmx_graph_space()
    while: status = 0
        while: i < space\count && status = 0
            row := space\rows + i
            made := (cast: (@: c.Lmx) row\value)
            raw := 0
            if: c.lmx_graph_kind(g, (cast: (@: void) made)) = 4 && c.lmx_graph_fn_result(g, (cast: (@: void) made)) != 0
                raw := (cast: (@: void) made\parent)
            head := c.lmx_graph_name_of(g, raw)
            if: (head = state\w_fn || head = state\w_sub) && lmx_graph_binding_method(g, (cast: (@: c.Lmx) row\scope), raw) = made && c.lmx_graph_method_code(g, made) != 0
                status := c.lmx_graph_scan_add(@ functions, @ count, @ cap, made)
            i := i + 1U
        ---
        if: at >= count || status != 0
            break
        made := functions[at]
        at := at + 1U
        status := lmx_graph_preflight_scope(g, made, c.lmx_graph_method_code(g, made), c.lmx_graph_method_data(g, made), c.lmx_graph_method_data(g, made))
    ---
    c.free((cast: (@: void) functions))
    lmx_graph_space_close(opened)
    return: status
end: lmx_graph_preflight

# The first structural receiving pass for the field-reading subset: compare the paths actually used from this
# formal against the written model and the candidate, by canonical names and address types. The temporary queue
# belongs only to this admission. It neither checks unused model fields nor depends on their positions.
# Follow a nested path rooted at this formal. 0 unrelated, 1 matched, -1 a required field/type is absent.
fn: lmx_graph_admit_path (@: g c.LmxGraph; @: expression void; @: name char; @: model void; @: candidate void; @@: wanted void; @@: found void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: path c.Lmx 0
    @: field void 0
    int: status 0
    int: kind 0
    if: c.lmx_graph_word_text(g, expression) = name
        wanted[0] := model
        found[0] := candidate
        return: 1
    if: c.lmx_graph_kind(g, expression) != 4
        return: 0
    path := (cast: (@: c.Lmx) expression)
    if: c.lmx_graph_count(path) != 3U || c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, path, 1U)) != state\w_deref
        return: 0
    status := lmx_graph_admit_path(g, c.lmx_graph_get_in(g, path, 0U), name, model, candidate, wanted, found)
    if: status != 1
        return: status
    field := c.lmx_graph_get_in(g, path, 2U)
    # The same path step as a read (lmx_graph_step): through an atom of the model or of the candidate too.
    if: lmx_graph_step(g, wanted[0], field, wanted) != 0
        wanted[0] := 0
    if: lmx_graph_step(g, found[0], field, found) != 0
        found[0] := 0
    kind := c.lmx_graph_kind(g, wanted[0])
    if: kind = 3
        kind := 1
    if: c.lmx_graph_kind(g, found[0]) = 3
        found[0] := c.lmx_arena_pointer_void_read(found[0])
    if: kind = 0 || kind != c.lmx_graph_kind(g, found[0])
        return: -1
    return: 1
end: lmx_graph_admit_path

fn: lmx_graph_admit_paths (@: g c.LmxGraph; @: code c.Lmx; @: name char; @: model void; @: candidate void) int
    @@: queue c.Lmx 0
    size_t: count 0U
    size_t: cap 0U
    size_t: at 0U
    size_t: i 0U
    @: current c.Lmx 0
    @: value void 0
    @: wanted void 0
    @: found void 0
    int: status 0
    # This consumer needs Structure values. Resolve only the already selected reference snapshots;
    # the caller retains its actual cell, and ordinary reads/assignments retain their place identity.
    model := c.lmx_graph_target(g, model)
    candidate := c.lmx_graph_target(g, candidate)
    if: c.lmx_graph_kind(g, model) != 4 || c.lmx_graph_kind(g, candidate) != 4
        return: 4
    current := code
    if: c.lmx_graph_method(g, code) != 0
        current := c.lmx_graph_method_code(g, code)
    status := c.lmx_graph_scan_add(@ queue, @ count, @ cap, current)
    while: at < count && status = 0
        current := queue[at]
        at := at + 1U
        if: lmx_graph_admit_path(g, (cast: (@: void) current), name, model, candidate, @ wanted, @ found) < 0
            status := 4
        i := 0U
        while: i < c.lmx_graph_count(current) && status = 0
            value := c.lmx_graph_get_in(g, current, i)
            if: c.lmx_graph_kind(g, value) = 4
                status := c.lmx_graph_scan_add(@ queue, @ count, @ cap, (cast: (@: c.Lmx) value))
            i := i + 1U
        ---
    ---
    c.free((cast: (@: void) queue))
    return: status
end: lmx_graph_admit_paths

# Admit each already evaluated argument immediately, before evaluating the next. Int arguments receive independent
# cells; a Structure is checked using its field names. The caller's transient refs array carries the admitted values.
fn: lmx_graph_admit_int (@: g c.LmxGraph; int: number; @@: out void) int
    out[0] := c.lmx_graph_int(g, number)
    if: out[0] = 0
        return: 4
return: 0

fn: lmx_graph_admit_field (@: g c.LmxGraph; @: code c.Lmx; @: args c.Lmx; size_t: index; @: actual void; @@: out void) int
    @: formal void c.lmx_graph_get_in(g, args, index)
    @: model void 0
    @: declaration c.Lmx 0
    @: requirement char 0
    @: target void 0
    int: kind (cast: (int) c.lmx_graph_kind(g, formal))
    int: status 0
    int: number 0
    if: out = 0
        return: 4
    if: lmx_graph_own_kind(g, formal) = 1
        if: c.lmx_graph_value_int(g, actual, @ number) != 0
            return: 4
        return: lmx_graph_admit_int(g, number, out)
    if: kind = 8
        status := c.lmx_graph_reference_payload(g, 5, actual, @ target)
        if: status != 0
            return: status
        out[0] := c.lmx_graph_ref_int(g, target)
        if: out[0] = 0
            return: 4
        return: 0
    if: kind != 4
        return: 5
    # Read the receiving declaration through its shared model query. The flat
    # reference receiver and compatible descriptions use the same admission.
    declaration := (cast: (@: c.Lmx) formal)
    requirement := c.lmx_graph_formal_model(g, declaration)
    if: requirement = 0
        return: 5
    status := lmx_graph_resolve_value(g, args, requirement, 1, @ model)
    if: status != 0
        return: status
    status := lmx_graph_admit_paths(g, code, c.lmx_graph_formal_name(g, args, index), model, actual)
    if: status = 0
        out[0] := actual
    return: status
end: lmx_graph_admit_field

fn: lmx_graph_admit (@: g c.LmxGraph; @: code c.Lmx; size_t: index; @: actual void; @@: out void) int
    return: lmx_graph_admit_field(g, code, c.lmx_graph_method_data(g, code), index, actual, out)
end: lmx_graph_admit

# Receive an already evaluated complete Value through the same DATA contract.
# Representation validation does not grant any additional Model permission.
fn: lmx_graph_admit_value (@: g c.LmxGraph; @: code c.Lmx; @: data c.Lmx; size_t: index; @: actual c.LmxWalkValue; @: out c.LmxWalkValue) int
    @: formal void c.lmx_graph_get_in(g, data, index)
    @: pool c.LmxPool lmx_graph_scalar_pool(g, formal)
    @: cell void 0
    @: received void 0
    @: abi void 0
    int: status 0
    if: actual = 0 || out = 0 || actual\present = 0
        return: 5
    if: out != actual
        c.memcpy((cast: (@: void) out), (cast: (const: @: void) actual), c.sizeof(c.LmxWalkValue))
    if: pool != 0
        return: lmx_graph_result_receive_as(g, c.LMX_TYPE_FOREIGN, (cast: (@: void) pool\scalar_abi), out)
    if: lmx_graph_own_kind(g, formal) = 1
        # This field is physically C int. The active language word int can
        # describe another C scalar; it is not proof for reading these bytes.
        abi := (cast: (@: void) out\scalar_abi)
        return: lmx_graph_result_receive_as(g, c.LMX_TYPE_INT, abi, out)
    # Graph admission consumes the selected Structure itself. Its native LMX
    # pointer storage is not a Graph reference cell and must not be substituted.
    if: out\kind = c.LMX_WALK_VALUE_REFERENCE && c.lmx_graph_kind(g, (cast: (@: void) out\ref)) = 4
        cell := out\ref
    else:
        if: c.lmx_walk_value_materialize(g\arena, out, @ cell) != c.LMX_WALK_OK
            return: 4
        ---
    ---
    status := lmx_graph_admit_field(g, code, data, index, cell, @ received)
    if: status != 0
        return: status
    # The existing receiver can select a typed Graph reference from an
    # untyped address. Retain that physical adaptation and the full context.
    if: out\kind = c.LMX_WALK_VALUE_REFERENCE && (c.lmx_graph_kind(g, received) = 5 || c.lmx_graph_kind(g, received) = 6)
        out\type := c.lmx_range_type_of(g\arena, received)
        out\ref := c.lmx_arena_pointer_void_read(received)
    if: c.lmx_walk_scalar_snapshot(g\arena, out) != c.LMX_WALK_OK
        return: 4
    return: 0
end: lmx_graph_admit_value

fn: lmx_graph_read_actual_value (@: g c.LmxGraph; @: scope c.Lmx; @: code c.Lmx; size_t: index; @: raw void; @: out c.LmxWalkValue) int
    int: contract lmx_graph_actual_contract(g, code, index)
    int: status 0
    if: out = 0
        return: 4
    if: contract = 2 && lmx_graph_written_group(g, raw) != 0
        status := c.lmx_walk_value_cell(g\arena, raw, out)
    else:
        status := lmx_graph_eval_record(g, scope, raw, out)
    ---
    if: status != 0
        return: status
    return: lmx_graph_admit_value(g, code, c.lmx_graph_method_data(g, code), index, out, out)
end: lmx_graph_read_actual_value

# Sequential statements over the current activation. Bodies stay in the graph on every call.
# A control body is consumed in the same activation. Flow is the canonical word address, never an opcode or
# retained plan. Mode 0 uses activation places, including at the unit root.
# Inline execution keeps the activation and restores its lexical cursor on
# every normal/flow/error return. The physical body is never the launch identity.
# Only numeric consumers project the transported Value. This is not the
# evaluator or the receiving contract of a general result.
fn: lmx_graph_result_int (@: g c.LmxGraph; @: value c.LmxWalkValue; @: out int) int
    if: value = 0 || out = 0 || value\present = 0
        return: 5
    if: value\kind = c.LMX_WALK_VALUE_FOREIGN
        if: c.lmx_graph_value_int(g, value\ref, out) != 0
            return: 4
        return: 0
    if: value\kind != c.LMX_WALK_VALUE_NUMBER || c.lmx_type_base(value\type) != c.LMX_TYPE_INT
        return: 4
    out[0] := value\number
    return: 0
end: lmx_graph_result_int

# Direct scalar reception uses the physical type proved for the selected ABI.
# SOURCE/Model remain the actual value's context, without additional permission.
fn: lmx_graph_result_receive_as (@: g c.LmxGraph; int: ty; @: abi void; @: value c.LmxWalkValue) int
    c.LmxWalkValue: received
    c.LmxWalkValue: physical
    if: ty = c.LMX_TYPE_NONE
        return: 5
    if: value = 0 || value\present = 0
        return: 4
    if: ty = c.LMX_TYPE_FOREIGN
        if: c.lmx_walk_value_receive_scalar(value, ty, (cast: (const: @: c.LmxScalarABI) abi), @ received) != c.LMX_WALK_OK
            return: 4
        ---
    else:
        if: value\kind = c.LMX_WALK_VALUE_FOREIGN
            if: c.lmx_graph_scalar_type((cast: (const: @: c.LmxScalarABI) abi)) != c.lmx_type_base(ty)
                return: 4
            if: c.lmx_walk_value_scalar_storage(g\arena, value, c.LMX_TYPE_FOREIGN, (cast: (const: @: c.LmxScalarABI) abi)) != c.LMX_WALK_OK
                return: 4
            if: c.lmx_walk_value_load(g\arena, value\ref, ty, @ physical) != c.LMX_WALK_OK
                return: 4
            physical\source_type := value\source_type
            physical\model := value\model
            physical\references := value\references
            physical\referent := value\referent
            physical\physical_profile := value\physical_profile
            physical\scalar_abi := value\scalar_abi
            c.memcpy((cast: (@: void) (@ received)), (cast: (const: @: void) (@ physical)), c.sizeof(c.LmxWalkValue))
        else:
            if: c.lmx_walk_value_receive(value, ty, @ received) != c.LMX_WALK_OK
                return: 4
            ---
        ---
    ---
    if: c.lmx_walk_scalar_snapshot(g\arena, @ received) != c.LMX_WALK_OK
        return: 4
    c.memcpy((cast: (@: void) value), (cast: (const: @: void) (@ received)), c.sizeof(c.LmxWalkValue))
    return: 0
end: lmx_graph_result_receive_as

fn: lmx_graph_result_receive (@: g c.LmxGraph; @: code c.Lmx; @: value c.LmxWalkValue) int
    @: abi void 0
    @: source void 0
    int: ty lmx_graph_result_type(g, code, @ abi, @ source)
    return: lmx_graph_result_receive_as(g, ty, abi, value)
end: lmx_graph_result_receive

fn: lmx_graph_return_value (@: g c.LmxGraph; @: code c.Lmx; @: statement c.Lmx; @: out c.LmxWalkValue) int
    c.LmxWalkValue: value
    int: status 0
    if: out = 0 || c.lmx_graph_count(statement) != 1U
        return: 5
    status := lmx_graph_eval_record(g, code, c.lmx_graph_get_in(g, statement, 0U), @ value)
    if: status != 0
        return: status
    status := lmx_graph_result_receive(g, code, @ value)
    if: status = 0
        c.memcpy((cast: (@: void) out), (cast: (const: @: void) (@ value)), c.sizeof(c.LmxWalkValue))
    return: status
end: lmx_graph_return_value

fn: lmx_graph_block (@: g c.LmxGraph; @: code c.Lmx; @: body c.Lmx; size_t: from; size_t: to; int: mode; @: out c.LmxWalkValue; @@: flow char) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: frame c.LmxGraphFrame 0
    @: prior_scope c.Lmx 0
    @: row c.LmxGraphWork 0
    @: roots_mark c.LmxExecutionRoots c.lmx_execution_roots_mark(g\arena)
    c.LmxExecutionRoots: result_roots
    size_t: i 0U
    int: scoped (cast: (int) (from = 0U && to = c.lmx_graph_count(body)))
    int: status 0
    c.lmx_execution_roots_push(g\arena, @ result_roots, (cast: (@: void) out), 1U, 0, 0U, (cast: (@: void) body), 0)
    if: active != 0 && active\code = code && active\frame != 0
        frame := (cast: (@: c.LmxGraphFrame) active\frame)
        prior_scope := frame\lexical_scope
        # A full body entry precedes its first declaration again. A finally
        # continuation or one for-header statement stays in the same scope.
        # Retain cells and row indices; only lexical visibility expires.
        while: scoped != 0 && i < frame\count
            row := frame\rows + i
            if: row\scope = body
                row\loaded := row\loaded & -17
            i := i + 1U
        ---
        status := lmx_graph_work_scope(g, code, body, (cast: (int) (scoped != 0 || (from = 0U && to = 1U && body\parent != 0 && lmx_graph_code_argument(g, (cast: (@: c.Lmx) body\parent), 0U) = 2 && c.lmx_graph_get_in(g, (cast: (@: c.Lmx) body\parent), 0U) = (cast: (@: void) body)))))
    if: status = 0
        status := lmx_graph_block_body(g, code, body, from, to, mode, out, flow)
    if: frame != 0
        i := 0U
        while: scoped != 0 && i < frame\count
            row := frame\rows + i
            if: row\scope = body
                row\loaded := row\loaded & -17
            i := i + 1U
        ---
        frame\lexical_scope := prior_scope
    c.lmx_execution_roots_restore(g\arena, roots_mark)
    return: status
end: lmx_graph_block

fn: lmx_graph_block_body (@: g c.LmxGraph; @: code c.Lmx; @: body c.Lmx; size_t: from; size_t: to; int: mode; @: out c.LmxWalkValue; @@: flow char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: statement c.Lmx 0
    @: nested c.Lmx 0
    @: header c.Lmx 0
    @: head char 0
    @: name char 0
    @: target void 0
    @: raw void 0
    @: discarded void 0
    size_t: i from
    size_t: n 0U
    size_t: slot 0U
    size_t: token 0U
    size_t: code_from 0U
    size_t: code_to 0U
    int: number 0
    int: status 0
    int: kind 0
    int: nested_mode mode
    int: required_kind 0
    int: cleanup_status 0
    int: supplied 0
    c.LmxWalkValue: pending_result
    c.LmxExecutionRoots: pending_roots
    @: roots_mark c.LmxExecutionRoots 0
    @: pending_flow char 0
    c.lmx_walk_value_clear(@ pending_result)
    while: i < to && status = 0 && flow[0] = 0
        status := lmx_graph_work_scope(g, code, body, 0)
        if: status != 0
            return: status
        raw := c.lmx_graph_get_in(g, body, i)
        raw := c.lmx_graph_binding_leaf(g, raw)
        kind := c.lmx_graph_kind(g, raw)
        # A reached declaration writes its invocation-local place. CODE names
        # become visible here; a supplied actual suppresses only the original
        # DATA initializer. Later declarations and loop reaches run normally.
        if: kind = 1 || kind = 3
            name := c.lmx_graph_slot_name(g, body, i)
            if: name != 0 && mode = 0
                status := lmx_graph_place_site(g, code, body, i, @ token, @ required_kind)
                if: status = 0 && required_kind != 1
                    status := 4
                supplied := 0
                if: status = 0
                    supplied := lmx_graph_place_supplied(g, code, body, i, token)
                if: status = 0 && kind = 1 && supplied = 0
                    status := lmx_graph_place_store_int(g, code, token, c.lmx_int_value_known(raw))
                i := i + 1U
                continue
            ---
            if: name != 0 && mode = 2
                slot := lmx_graph_visible_slot(g, code, name)
                if: slot >= c.lmx_graph_count(code)
                    return: 3
                if: kind = 1
                    status := c.lmx_graph_assign_int(g, code, code, slot, c.lmx_int_value_known(raw))
                i := i + 1U
                continue
            ---
            if: name != 0 || kind = 3
                i := i + 1U
                continue
            ---
        ---
        if: kind = 5 || kind = 6 || kind = 8 || kind = 9
            name := c.lmx_graph_slot_name(g, body, i)
            if: name != 0
                required_kind := kind
                if: kind = 8 || kind = 9
                    required_kind := kind - 3
                if: mode = 0
                    status := lmx_graph_place_site(g, code, body, i, @ token, @ number)
                else:
                    status := lmx_graph_known_place(g, code, name, mode, @ number)
                if: status = 0 && number != required_kind
                    status := 4
                supplied := 0
                if: status = 0 && mode = 0
                    supplied := lmx_graph_place_supplied(g, code, body, i, token)
                if: status = 0 && supplied = 0 && (kind = 5 || kind = 6)
                    if: mode = 0
                        status := lmx_graph_place_store_reference(g, code, token, raw)
                    else:
                        status := lmx_graph_store_reference(g, code, name, mode, raw)
                ---
            ---
            i := i + 1U
            continue
        # A constructed fn/sub is a value, not a written application Frame.
        if: kind = 4 && c.lmx_graph_fn_result(g, raw) != 0
            i := i + 1U
            continue
        if: kind != 4
            # A primitive field is a value. Only a formed expression or
            # receiver consumes operands; a bare word is no nullary call.
            i := i + 1U
            continue
        statement := (cast: (@: c.Lmx) raw)
        n := c.lmx_graph_count(statement)
        head := c.lmx_graph_name_of(g, raw)
        if: head = 0
            # An unnamed Lmx: the assignment `a := v`, a statement on a path head, an anonymous body, or an expression
            # whose value is not used.
            if: n != 0U
                head := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, statement, 0U))
            if: c.lmx_graph_application_parts(g, raw, 0, 0, 0) != 0
                status := lmx_graph_eval_application(g, code, statement, 0, @ number)
                i := i + 1U
                continue
            if: head = state\w_assign
                status := lmx_graph_eval_assignment(g, code, statement, mode)
                i := i + 1U
                continue
            # A written anonymous field is a value. Only a receiver that
            # explicitly selects it as code executes its fields.
            if: lmx_graph_written_group(g, raw) != 0
                i := i + 1U
                continue
            status := lmx_graph_eval_value(g, code, raw, @ discarded)
            i := i + 1U
            continue
        # A declaration of fn or sub with written arguments created its Structure in this traversal when its block was
        # entered (lmx_graph_space_declarations); the receiver applied to arguments the traversal computes creates it
        # here, where the root reaches it (lmx_graph_fn_apply) -- in a body or an inline block that is open (5). The data
        # part of a Structure is its data; a named Structure of the root stands.
        if: head = state\w_fn || head = state\w_sub
            if: lmx_graph_fn_written(g, statement) = 0
                status := lmx_graph_fn_apply(g, body, i)
            ---
            i := i + 1U
            continue
        if: head = state\w_fm
            return: 5
        if: head = state\w_finally
            # Reaching this field registers its body in this scope. Recursing over the remaining statements makes
            # multiple registrations unwind in reverse order, without a persistent plan or a second graph.
            status := lmx_graph_block(g, code, body, i + 1U, to, mode, out, flow)
            pending_flow := flow[0]
            if: pending_flow = state\w_return
                c.memcpy((cast: (@: void) (@ pending_result)), (cast: (const: @: void) out), c.sizeof(c.LmxWalkValue))
            roots_mark := c.lmx_execution_roots_mark(g\arena)
            c.lmx_execution_roots_push(g\arena, @ pending_roots, (cast: (@: void) (@ pending_result)), 1U, 0, 0U, 0, 0)
            flow[0] := 0
            lmx_graph_code_body(g, statement, 0U, @ nested, @ code_from, @ code_to)
            cleanup_status := lmx_graph_block(g, code, nested, code_from, code_to, nested_mode, out, flow)
            if: cleanup_status != 0
                c.lmx_execution_roots_restore(g\arena, roots_mark)
                return: cleanup_status
            if: flow[0] = 0
                flow[0] := pending_flow
                if: pending_flow = state\w_return
                    c.memcpy((cast: (@: void) out), (cast: (const: @: void) (@ pending_result)), c.sizeof(c.LmxWalkValue))
                ---
            ---
            c.lmx_execution_roots_restore(g\arena, roots_mark)
            return: status
        if: head = state\w_if
            if: n != 2U || c.lmx_graph_kind(g, c.lmx_graph_get_in(g, statement, 1U)) != 4
                return: 2
            status := lmx_graph_eval_number(g, code, c.lmx_graph_get_in(g, statement, 0U), @ number)
            if: status != 0
                return: status
            if: number != 0
                nested := (cast: (@: c.Lmx) c.lmx_graph_get_in(g, statement, 1U))
                status := lmx_graph_block(g, code, nested, 0U, c.lmx_graph_count(nested), nested_mode, out, flow)
            i := i + 1U
            if: i < to && c.lmx_graph_kind(g, c.lmx_graph_get_in(g, body, i)) = 4 && c.lmx_graph_name_of(g, c.lmx_graph_get_in(g, body, i)) = state\w_else
                statement := (cast: (@: c.Lmx) c.lmx_graph_get_in(g, body, i))
                if: number = 0 && status = 0
                    lmx_graph_code_body(g, statement, 0U, @ nested, @ code_from, @ code_to)
                    status := lmx_graph_block(g, code, nested, code_from, code_to, nested_mode, out, flow)
                i := i + 1U
            ---
            continue
        # An explicit `L2:` (the book #scope; the order of the author 2026-11-18): the record is a body of this call, as the body of an else
        # is. Its statements run here, in this activation; a name it declares belongs to its lexical branch.
        if: head = state\w_l2
            lmx_graph_code_body(g, statement, 0U, @ nested, @ code_from, @ code_to)
            status := lmx_graph_block(g, code, nested, code_from, code_to, nested_mode, out, flow)
            i := i + 1U
            continue
        if: head = state\w_else
            return: 2
        if: head = state\w_while || head = state\w_for || head = state\w_until
            if: n != 2U || c.lmx_graph_kind(g, c.lmx_graph_get_in(g, statement, 1U)) != 4
                return: 2
            nested := (cast: (@: c.Lmx) c.lmx_graph_get_in(g, statement, 1U))
            header := (cast: (@: c.Lmx) c.lmx_graph_get_in(g, statement, 0U))
            if: head = state\w_for
                if: c.lmx_graph_kind(g, (cast: (@: void) header)) != 4 || c.lmx_graph_count(header) != 3U
                    return: 2
                status := lmx_graph_block(g, code, header, 0U, 1U, nested_mode, out, flow)
            while: status = 0 && flow[0] = 0
                number := 1
                if: head != state\w_until
                    if: head = state\w_for
                        status := lmx_graph_work_scope(g, code, header, 0)
                        raw := c.lmx_graph_get_in(g, header, 1U)
                    else:
                        status := lmx_graph_work_scope(g, code, body, 0)
                        raw := c.lmx_graph_get_in(g, statement, 0U)
                    ---
                    if: status = 0
                        status := lmx_graph_eval_number(g, code, raw, @ number)
                    ---
                ---
                if: status != 0 || number = 0
                    break
                while: status = 0
                    flow[0] := 0
                    status := lmx_graph_block(g, code, nested, 0U, c.lmx_graph_count(nested), nested_mode, out, flow)
                    if: flow[0] != state\w_redo
                        break
                ---
                if: status != 0 || flow[0] = state\w_return
                    break
                if: flow[0] = state\w_break
                    flow[0] := 0
                    break
                if: flow[0] = state\w_continue
                    flow[0] := 0
                if: head = state\w_for && flow[0] = 0
                    status := lmx_graph_block(g, code, header, 2U, 3U, nested_mode, out, flow)
                ---
                if: status = 0 && head = state\w_until && flow[0] = 0
                    status := lmx_graph_work_scope(g, code, body, 0)
                    if: status = 0
                        status := lmx_graph_eval_number(g, code, c.lmx_graph_get_in(g, statement, 0U), @ number)
                    if: status != 0 || number != 0
                        break
                    ---
                ---
            ---
            i := i + 1U
            continue
        if: head = state\w_break || head = state\w_continue || head = state\w_redo
            if: n != 0U
                return: 5
            flow[0] := head
            return: 0
        if: head = state\w_return
            if: n = 0U
                if: lmx_graph_launch_result(g, code) != 0
                    return: 5
                ---
            else:
                if: lmx_graph_launch_result(g, code) = 0
                    return: 5
                status := lmx_graph_return_value(g, code, statement, out)
            ---
            flow[0] := state\w_return
            return: status
        if: head = state\w_call
            status := lmx_graph_eval_explicit_call(g, code, statement)
            i := i + 1U
            continue
        # fncall written as a statement: the launch runs and its result is not used.
        if: head = state\w_fncall
            status := lmx_graph_eval_fncall(g, code, statement, @ number)
            i := i + 1U
            continue
        if: head = state\w_at
            # Typed references without a candidate need real pre-existing
            # uninit:T storage; they are not deferred Structure candidates.
            if: n = 2U && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, statement, 1U)) = state\w_int
                return: 5
            kind := 6
            if: n = 3U && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, statement, 1U)) = state\w_int
                kind := 5
            if: n != 2U && kind != 5
                return: 5
            head := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, statement, 0U))
            if: mode = 0
                status := lmx_graph_place_site(g, code, body, i, @ token, @ number)
            else:
                status := lmx_graph_known_place(g, code, head, mode, @ number)
            if: status != 0
                return: status
            if: number != kind
                return: 4
            if: mode = 0 && lmx_graph_place_supplied(g, code, body, i, token) != 0
                i := i + 1U
                continue
            status := lmx_graph_read_received_value(g, code, c.lmx_graph_get_in(g, statement, n - 1U), lmx_graph_value_contract(g, statement, n - 1U), @ raw)
            if: status = 0
                if: mode = 0
                    status := lmx_graph_place_store_reference(g, code, token, raw)
                else:
                    status := lmx_graph_store_reference(g, code, head, mode, raw)
                ---
            i := i + 1U
            continue
        if: head = state\w_include || head = state\w_predef
            i := i + 1U
            continue
        # `send: Message(...)`: the letter is built from the values of the graph and posted (lmx_graph_send).
        if: head = state\w_send
            status := lmx_graph_send(g, code, body, i)
            i := i + 1U
            continue
        if: head != state\w_int
            status := lmx_graph_eval_application(g, code, statement, 0, @ number)
            i := i + 1U
            continue
        # `int: name` checks the place; `int: name value` writes it.
        head := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, statement, 0U))
        if: mode = 0
            status := lmx_graph_place_site(g, code, body, i, @ token, @ required_kind)
            if: status = 0 && required_kind != 1
                status := 4
            ---
        else:
            slot := lmx_graph_visible_slot(g, code, head)
            if: slot = c.lmx_graph_count(code)
                return: 3
        ---
        supplied := 0
        if: status = 0 && mode = 0
            supplied := lmx_graph_place_supplied(g, code, body, i, token)
        if: status = 0 && supplied = 0 && n != 1U
            status := lmx_graph_eval(g, code, statement, 1U, n, @ number)
            if: status = 0
                if: mode = 0
                    status := lmx_graph_place_store_int(g, code, token, number)
                else:
                    status := c.lmx_graph_assign_int(g, code, code, slot, number)
                ---
            ---
        ---
        i := i + 1U
    ---
    return: status
end: lmx_graph_block_body

# The bytes of a quoted text are those between the quotes; they become an Array<Char> of the payload at place j. 0, or the failing answer.
fn: lmx_graph_send_text (@: g c.LmxGraph; @: spelling char; @: payload c.Lmx; size_t: j; @: arena c.LmxArena) int
    @: text c.LmxArray 0
    @: text_fields c.VoidArray 0
    @: bytes char 0
    size_t: width c.strlen(spelling)
    size_t: k 0U
    if: width < 2U || spelling[width - 1U] != 34
        return: 5
    width := width - 2U
    text := c.lmx_array_new_child_profiled(payload, c.LMX_TYPE_ARRAY_OF_CHAR, width, arena, 0)
    if: text = 0 || c.lmx_arena_ref_store(arena, payload, j, (cast: (@: void) text)) != 0
        return: 4
    text_fields := (cast: (@: c.VoidArray) (@ text\array))
    bytes := (cast: (@: char) (text_fields\data))
    while: k < width
        bytes[k] := spelling[k + 1U]
        k := k + 1U
    return: 0

# One field of the Message at place j of the payload: a quoted text becomes an Array<Char>, any other expression an int cell.
fn: lmx_graph_send_field (@: g c.LmxGraph; @: code c.Lmx; @: field c.Lmx; @: payload c.Lmx; size_t: j; @: arena c.LmxArena) int
    @: operand void 0
    @: cell void 0
    @: spelling char 0
    int: number 0
    int: status 0
    if: c.lmx_graph_kind(g, (cast: (@: void) field)) != 4 || c.lmx_graph_count(field) != 1U
        return: 5
    operand := c.lmx_graph_get_in(g, field, 0U)
    if: c.lmx_graph_kind(g, operand) = 2
        spelling := c.lmx_graph_word_text(g, operand)
    if: spelling != 0 && spelling[0] = 34
        return: lmx_graph_send_text(g, spelling, payload, j, arena)
    status := lmx_graph_eval(g, code, field, 0U, 1U, @ number)
    if: status != 0
        return: status
    cell := c.lmx_int_new_owned(arena)
    if: cell = 0 || c.lmx_int_store_known(cell, number) != 0 || c.lmx_arena_ref_store(arena, payload, j, cell) != 0
        return: 4
    return: 0

# The letter of `send: Message(field: value; ...)` (the book, send), built from the values of the graph with the kernel's calls, as the
# former path's per-site send function builds it: a Message record whose graph is [sender; payload] -- the sender a pointer cell
# holding the Message of the current thread, the payload a Structure whose fields stand in the written order, an int cell for
# an int expression and an Array<Char> for a quoted text --, in an arena of its own that the service takes over when it posts.
# 0, or the failing answer; the arena is released when the letter is not posted.
fn: lmx_graph_send_fill (@: g c.LmxGraph; @: code c.Lmx; @: message c.Lmx; size_t: count; @: arena c.LmxArena; @: thread c.LmxThread; @@: out c.LmxMsg) int
    @: letter c.LmxMsg 0
    @: graph c.Lmx 0
    @: payload c.Lmx 0
    @: cell void 0
    size_t: j 0U
    int: status 0
    letter := (cast: (@: c.LmxMsg) c.lmx_arena_take(arena, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
    graph := c.lmx_node_new_owned(arena)
    payload := c.lmx_node_new_owned(arena)
    if: letter = 0 || graph = 0 || payload = 0 || c.lmx_arena_refs_open_owned(arena, graph, 2U) != 0 || c.lmx_arena_refs_open_owned(arena, payload, count) != 0
        return: 4
    while: j < count
        status := lmx_graph_send_field(g, code, (cast: (@: c.Lmx) c.lmx_graph_get_in(g, message, j)), payload, j, arena)
        if: status != 0
            return: status
        j := j + 1U
    # The sender is a pointer CELL holding the current Message (the author's Q26.2: a reference to a reference).
    cell := c.lmx_pointer_new_owned(c.LMX_TYPE_MSG_REF, arena)
    if: cell = 0 || c.lmx_pointer_store_known(cell, (cast: (@: void) c.lmx_thread_message(thread))) != 0 || c.lmx_arena_ref_store(arena, graph, 0U, cell) != 0 || c.lmx_arena_ref_store(arena, graph, 1U, (cast: (@: void) payload)) != 0
        return: 4
    letter\running := 1
    letter\success := 0
    letter\handoff_ready := 0
    letter\graph := graph
    out[0] := letter
    return: 0

# The statement `send` at body[at]: its one field is the Message; the letter goes to the parent of the current thread. A Ref written before the
# Message would name another thread, but no value of the graph is the address of a Message yet (create and receive bring it): that form is refused.
fn: lmx_graph_send (@: g c.LmxGraph; @: code c.Lmx; @: body c.Lmx; size_t: at) int
    @: statement c.Lmx (cast: (@: c.Lmx) c.lmx_graph_get_in(g, body, at))
    @: message c.Lmx 0
    @: thread c.LmxThread c.lmx_thread_current()
    @: arena c.LmxArena 0
    @: letter c.LmxMsg 0
    @: recipient void 0
    size_t: count 0U
    int: status 0
    if: thread = 0 || c.lmx_graph_count(statement) != 1U
        return: 5
    message := (cast: (@: c.Lmx) c.lmx_graph_get_in(g, statement, 0U))
    if: c.lmx_graph_kind(g, (cast: (@: void) message)) != 4
        return: 5
    count := c.lmx_graph_count(message)
    recipient := (cast: (@: void) c.lmx_thread_parent(thread))
    arena := (cast: (@: c.LmxArena) c.calloc(1U, c.sizeof(c.LmxArena)))
    if: arena = 0
        return: 4
    if: c.lmx_arena_open(arena) != 0
        c.free((cast: (@: void) arena))
        return: 4
    status := lmx_graph_send_fill(g, code, message, count, arena, thread, @ letter)
    if: status = 0 && c.lmx_service_post(c.lmx_child_service(thread), recipient, letter, arena) != c.LMX_SERVICE_OK
        status := 4
    if: status != 0
        c.lmx_arena_release(arena)
        c.free((cast: (@: void) arena))
    return: status

# Does the launch that runs code return a result? The parts of the live launch answer (its work frame,
# lmx_graph_work_open_parts); code asked outside its own launch -- a root, a Structure running without a frame -- answers
# by what it is: a callable by its return part, anything else has none.
fn: lmx_graph_launch_result (@: g c.LmxGraph; @: code c.Lmx) int
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: frame c.LmxGraphFrame 0
    if: active != 0 && active\code = code && active\frame != 0
        frame := (cast: (@: c.LmxGraphFrame) active\frame)
        return: (cast: (int) (frame\result != 0))
    return: c.lmx_graph_has_result(g, code)
end: lmx_graph_launch_result

# The code of the live launch runs to its end or to its return: the code part the launch was opened with
# (lmx_graph_work_open_parts): for a callable its own part code, for an ordinary Structure the Structure itself.
fn: lmx_graph_method_run_value (@: g c.LmxGraph; @: code c.Lmx; @: out c.LmxWalkValue) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: active c.LmxActivation (cast: (@: c.LmxActivation) g\arena\activation)
    @: frame c.LmxGraphFrame 0
    @: body c.Lmx code
    @: flow char 0
    int: status 0
    if: active != 0 && active\code = code && active\frame != 0
        frame := (cast: (@: c.LmxGraphFrame) active\frame)
        body := (cast: (@: c.Lmx) frame\body)
    else:
        if: c.lmx_graph_method(g, code) != 0
            body := c.lmx_graph_method_code(g, code)
        ---
    ---
    status := lmx_graph_block(g, code, body, 0U, c.lmx_graph_count(body), 0, out, @ flow)
    if: status != 0
        return: status
    if: flow != 0 && flow != state\w_return
        return: 5
    if: lmx_graph_launch_result(g, code) != 0 && flow != state\w_return
        return: 5
    return: 0
end: lmx_graph_method_run_value

# Invoke with arguments that have already passed admission. Missing literal defaults are copied into this call's
# private places. Native and interpretation share the ordinary activation ABI; the signature graph remains intact.
fn: lmx_graph_invoke_data_value (@: g c.LmxGraph; @: code c.Lmx; @: data c.Lmx; @: body c.Lmx; @: result char; @@: actuals void; @: supplied c.LmxWalkValue; size_t: count; @: bindings size_t; @: out c.LmxWalkValue) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: statement c.Lmx 0
    @@: refs void 0
    @@: native_refs void 0
    @: values c.LmxWalkValue 0
    @: item c.LmxWalkValue 0
    @: cell void 0
    @: returned void 0
    c.LmxActivation: activation
    c.LmxGraphFrame: frame
    c.LmxWalkValue: result_value
    c.LmxWalkValue: destination_value
    c.LmxExecutionRoots: result_roots
    c.LmxExecutionRoots: destination_roots
    c.LmxExecutionRoots: actual_roots
    c.LmxExecutionRoots: data_roots
    c.LmxExecutionRoots: supplied_roots
    @: roots_mark c.LmxExecutionRoots 0
    @: destination void 0
    @: result_abi void 0
    @: result_source void 0
    int: result_type c.LMX_TYPE_NONE
    size_t: width 0U
    size_t: supplied_width 0U
    size_t: i 0U
    size_t: slot 0U
    int: status 0
    if: c.lmx_graph_kind(g, (cast: (@: void) code)) != 4 || c.lmx_graph_kind(g, (cast: (@: void) data)) != 4 || c.lmx_graph_kind(g, (cast: (@: void) body)) != 4 || out = 0
        return: 5
    c.lmx_walk_value_clear(@ result_value)
    c.lmx_walk_value_clear(@ destination_value)
    width := c.lmx_graph_count(data)
    if: count > width
        return: 5
    if: result != 0
        result_abi := (cast: (@: void) c.lmx_graph_scalar_binding(result, @ result_source))
        result_type := c.lmx_graph_scalar_type((cast: (const: @: c.LmxScalarABI) result_abi))
        if: result_type = c.LMX_TYPE_NONE
            return: 5
        ---
    refs := (cast: (@@: void) c.calloc(width + 1U, sizeof(@: void)))
    native_refs := (cast: (@@: void) c.calloc(width + 1U, sizeof(@: void)))
    values := (cast: (@: c.LmxWalkValue) c.calloc(width + 1U, c.sizeof(c.LmxWalkValue)))
    if: refs = 0 || native_refs = 0 || values = 0
        c.free((cast: (@: void) refs))
        c.free((cast: (@: void) native_refs))
        c.free((cast: (@: void) values))
        return: 4
    roots_mark := c.lmx_execution_roots_mark(g\arena)
    c.lmx_execution_roots_push(g\arena, @ supplied_roots, (cast: (@: void) supplied), (cast: (size_t) (supplied != 0)) * count, actuals, (cast: (size_t) (actuals != 0)) * count, (cast: (@: void) body), 0)
    c.lmx_execution_roots_push(g\arena, @ data_roots, 0, 0U, 0, 0U, (cast: (@: void) data), 0)
    c.lmx_execution_roots_push(g\arena, @ actual_roots, (cast: (@: void) values), width, refs, width, (cast: (@: void) code), 0)
    while: i < count && status = 0
        slot := i
        if: bindings != 0
            slot := bindings[i]
        if: slot >= width
            status := 5
        else:
            item := values + slot
            if: item\kind != 0 || (supplied = 0 && (actuals = 0 || actuals[i] = 0))
                status := 5
            else:
                if: supplied != 0
                    c.memcpy((cast: (@: void) item), (cast: (const: @: void) (supplied + i)), c.sizeof(c.LmxWalkValue))
                    if: item\kind = 0
                        status := 5
                    ---
                else:
                    cell := actuals[i]
                    if: c.lmx_graph_kind(g, cell) = 3
                        cell := c.lmx_arena_pointer_void_read(cell)
                    ---
                    if: c.lmx_walk_value_cell(g\arena, cell, item) != c.LMX_WALK_OK
                        status := 4
                    ---
                ---
                if: status = 0 && c.lmx_walk_scalar_snapshot(g\arena, item) != c.LMX_WALK_OK
                    status := 4
                # Transport refs address the final records, never an earlier
                # written vector. Graph frames consume these records directly.
                native_refs[slot] := c.lmx_walk_value_storage(item)
                if: supplied_width <= slot
                    supplied_width := slot + 1U
            ---
        ---
        i := i + 1U
    ---
    if: status = 0
        c.lmx_execution_roots_push(g\arena, @ result_roots, (cast: (@: void) (@ result_value)), 1U, refs, width, (cast: (@: void) code), 0)
        c.lmx_execution_roots_push(g\arena, @ destination_roots, (cast: (@: void) (@ destination_value)), 1U, 0, 0U, 0, 0)
        # A method entry compiles its CODE part, not the descriptor's own
        # metadata fields. Explicit call(F) selects F itself as CODE; only a
        # matching selected body may use the method's installed entry.
        if: code\native != 0 && (c.lmx_graph_method(g, code) = 0 || body = c.lmx_graph_method_code(g, code)) && (result = 0 || c.lmx_graph_method(g, code) != 0)
            if: result != 0
                destination := c.lmx_walk_result_storage(g\arena, result_type, (cast: (const: @: c.LmxScalarABI) result_abi), 0, result_source, @ destination_value)
                if: destination = 0
                    status := 4
                ---
            ---
            if: status = 0
                # Unsupplied DATA declarations are not extra native actuals.
                # Sparse named bindings keep their physical indices; the
                # entry's frame reads the remaining defaults from DATA.
                status := c.lmx_call_prim_values(g\arena, code, data, native_refs, supplied_width, destination, @ returned, values, @ result_value)
                if: status = 0 && result != 0
                    status := lmx_graph_result_receive_as(g, result_type, result_abi, @ result_value)
                ---
            ---
        else:
            status := c.lmx_activation_push(g\arena, @ activation, 2, code, refs, (cast: (@: void) values), width, 0)
            if: status = 0
                status := lmx_graph_work_open_parts(g, code, data, body, result, @ frame)
                if: status = 0
                    status := lmx_graph_method_run_value(g, code, @ result_value)
                    status := lmx_graph_work_finish(g, @ frame, status)
                ---
                c.lmx_activation_pop(g\arena, @ activation)
            ---
        ---
        if: status = 0
            c.memcpy((cast: (@: void) out), (cast: (const: @: void) (@ result_value)), c.sizeof(c.LmxWalkValue))
    ---
    c.lmx_execution_roots_restore(g\arena, roots_mark)
    c.free((cast: (@: void) refs))
    c.free((cast: (@: void) native_refs))
    c.free((cast: (@: void) values))
    return: status
end: lmx_graph_invoke_data_value

fn: lmx_graph_invoke_value (@: g c.LmxGraph; @: code c.Lmx; @@: actuals void; size_t: count; @: out c.LmxWalkValue) int
    return: lmx_graph_invoke_data_value(g, code, c.lmx_graph_method_data(g, code), c.lmx_graph_method_code(g, code), c.lmx_graph_word_text(g, c.lmx_graph_method_return(g, code)), actuals, 0, count, 0, out)
end: lmx_graph_invoke_value

fn: lmx_graph_invoke_bound_value (@: g c.LmxGraph; @: code c.Lmx; @@: actuals void; size_t: count; @: bindings size_t; @: out c.LmxWalkValue) int
    return: lmx_graph_invoke_data_value(g, code, c.lmx_graph_method_data(g, code), c.lmx_graph_method_code(g, code), c.lmx_graph_word_text(g, c.lmx_graph_method_return(g, code)), actuals, 0, count, bindings, out)
end: lmx_graph_invoke_bound_value

# Complete already received actuals use the same binding and execution worker.
fn: lmx_graph_invoke_values (@: g c.LmxGraph; @: code c.Lmx; @: actuals c.LmxWalkValue; size_t: count; @: bindings size_t; @: out c.LmxWalkValue) int
    if: count != 0U && actuals = 0
        return: 5
    return: lmx_graph_invoke_data_value(g, code, c.lmx_graph_method_data(g, code), c.lmx_graph_method_code(g, code), c.lmx_graph_word_text(g, c.lmx_graph_method_return(g, code)), 0, actuals, count, bindings, out)
end: lmx_graph_invoke_values

fn: lmx_graph_invoke (@: g c.LmxGraph; @: code c.Lmx; @@: actuals void; size_t: count; @: out int) int
    c.LmxWalkValue: result
    int: status 0
    if: out = 0
        return: 5
    c.lmx_walk_value_clear(@ result)
    status := lmx_graph_invoke_value(g, code, actuals, count, @ result)
    if: status = 0 && c.lmx_graph_has_result(g, code) != 0
        status := lmx_graph_result_int(g, @ result, out)
    return: status
end: lmx_graph_invoke

fn: lmx_graph_invoke_bound (@: g c.LmxGraph; @: code c.Lmx; @@: actuals void; size_t: count; @: bindings size_t; @: out int) int
    c.LmxWalkValue: result
    int: status 0
    if: out = 0
        return: 5
    c.lmx_walk_value_clear(@ result)
    status := lmx_graph_invoke_bound_value(g, code, actuals, count, bindings, @ result)
    if: status = 0 && c.lmx_graph_has_result(g, code) != 0
        status := lmx_graph_result_int(g, @ result, out)
    return: status
end: lmx_graph_invoke_bound

# The call of one positional actual that names a value without effects (lmx_graph_single_candidate), once that value
# is known (the book, whole-arguments: one Structure is its chain of fields). A Structure whose every direct field names
# a formal of the selected callee, each formal at most once, while every formal without a field has its written
# default, is the whole argument structure when each field is accepted by its formal: the common admission of this
# subset (lmx_graph_admit -- an int formal reads an int, a model formal the first part of implements over the used
# paths) decides, field by field in the callee's order. An empty Structure is the empty chain: the call of a nullary or
# default-only callee. Otherwise the value is the ordinary first argument and every other formal needs its default. One
# method decides by its formals and the value's direct fields: no tree search, no second reading, no conversion table
# yet (an implementation boundary of this subset). The arrays belong only to this call. 0, or the refusal of the form
# (5) or of a reception.
fn: lmx_graph_call_single_record (@: g c.LmxGraph; @: code c.Lmx; @: given c.LmxWalkValue; @: out c.LmxWalkValue) int
    # A reference to a Structure stands for that Structure as the whole argument structure (lmx_graph_target).
    @: value void 0
    @: args c.Lmx 0
    @: structure c.Lmx 0
    @: field void 0
    @: name char 0
    @: values c.LmxWalkValue 0
    c.LmxWalkValue: candidate
    @: bindings size_t 0
    @: from size_t 0
    size_t: width 0U
    size_t: n 0U
    size_t: i 0U
    size_t: slot 0U
    size_t: k 0U
    int: whole 0
    int: received 0
    int: status 0
    c.LmxExecutionRoots: actual_roots
    c.LmxExecutionRoots: code_roots
    c.LmxExecutionRoots: given_roots
    @: roots_mark c.LmxExecutionRoots 0
    if: c.lmx_graph_method(g, code) = 0 || out = 0 || given = 0 || given\present = 0
        return: 5
    if: given\kind = c.LMX_WALK_VALUE_REFERENCE
        value := c.lmx_graph_target(g, given\ref)
    args := c.lmx_graph_method_data(g, code)
    width := c.lmx_graph_count(args)
    values := (cast: (@: c.LmxWalkValue) c.calloc(width + 1U, c.sizeof(c.LmxWalkValue)))
    bindings := (cast: (@: size_t) c.calloc(width + 1U, sizeof(size_t)))
    from := (cast: (@: size_t) c.calloc(width + 1U, sizeof(size_t)))
    if: values = 0 || bindings = 0 || from = 0
        status := 4
    roots_mark := c.lmx_execution_roots_mark(g\arena)
    c.lmx_execution_roots_push(g\arena, @ given_roots, (cast: (@: void) given), 1U, 0, 0U, 0, 0)
    c.lmx_execution_roots_push(g\arena, @ code_roots, 0, 0U, 0, 0U, (cast: (@: void) code), 0)
    c.lmx_execution_roots_push(g\arena, @ actual_roots, (cast: (@: void) values), width, 0, 0U, value, 0)
    if: status = 0 && c.lmx_graph_kind(g, value) = 4 && c.lmx_graph_method(g, (cast: (@: c.Lmx) value)) = 0
        structure := (cast: (@: c.Lmx) value)
        n := c.lmx_graph_count(structure)
        whole := 1
        # from[slot]: 1 + the index of the field that names the formal at slot, 0 for none.
        whole := lmx_graph_bind_fields(g, args, structure, from)
        # The reading is applicable when every field is accepted by its formal.
        i := 0U
        while: i < width && whole != 0
            if: from[i] != 0U
                field := c.lmx_graph_get_in(g, structure, from[i] - 1U)
                # Binding selected this field logically. An unlowered receiving
                # descriptor is not its value; explicit numeric index values retain
                # their physical-cell route and are not rewritten by this check.
                received := 5
                if: c.lmx_graph_kind(g, field) != 4 || c.lmx_graph_declaration_place_name(g, field) = 0
                    received := c.lmx_walk_value_cell(g\arena, field, @ candidate)
                    if: received = 0
                        received := lmx_graph_admit_value(g, code, args, i, @ candidate, values + k)
                    ---
                if: received != 0
                    whole := 0
                else:
                    bindings[k] := i
                    k := k + 1U
                ---
            ---
            i := i + 1U
        ---
    ---
    if: status = 0 && whole = 0
        k := 0U
        if: width = 0U
            status := 5
        if: status = 0
            status := lmx_graph_admit_value(g, code, args, 0U, given, values)
        bindings[0] := 0U
        k := 1U
    ---
    if: status = 0
        status := lmx_graph_invoke_values(g, code, values, k, bindings, out)
    c.lmx_execution_roots_restore(g\arena, roots_mark)
    c.free((cast: (@: void) values))
    c.free((cast: (@: void) bindings))
    c.free((cast: (@: void) from))
    return: status
end: lmx_graph_call_single_record

# Legacy physical-cell callers enter the same complete-Value path once.
fn: lmx_graph_call_single_value (@: g c.LmxGraph; @: code c.Lmx; @: given void; @: out c.LmxWalkValue) int
    c.LmxWalkValue: value
    if: c.lmx_walk_value_cell(g\arena, given, @ value) != c.LMX_WALK_OK
        return: 4
    return: lmx_graph_call_single_record(g, code, @ value, out)
end: lmx_graph_call_single_value

fn: lmx_graph_call_single (@: g c.LmxGraph; @: code c.Lmx; @: given void; @: out int) int
    c.LmxWalkValue: result
    int: status 0
    if: out = 0
        return: 5
    c.lmx_walk_value_clear(@ result)
    status := lmx_graph_call_single_value(g, code, given, @ result)
    if: status = 0 && c.lmx_graph_has_result(g, code) != 0
        status := lmx_graph_result_int(g, @ result, out)
    return: status
end: lmx_graph_call_single

fn: lmx_graph_eval_call_value (@: g c.LmxGraph; @: scope c.Lmx; @: expression c.Lmx; @: code c.Lmx; @: out c.LmxWalkValue) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    size_t: count (cast: (size_t) c.lmx_graph_count(expression))
    size_t: i 0U
    @: values c.LmxWalkValue (cast: (@: c.LmxWalkValue) c.calloc(count + 1U, c.sizeof(c.LmxWalkValue)))
    @: bindings size_t (cast: (@: size_t) c.calloc(count + 1U, sizeof(size_t)))
    @: actual void 0
    c.LmxWalkValue: candidate
    @: raw void 0
    int: status 4
    c.LmxExecutionRoots: actual_roots
    c.LmxExecutionRoots: scope_roots
    @: roots_mark c.LmxExecutionRoots c.lmx_execution_roots_mark(g\arena)
    # Earlier actuals remain live while a later actual calls arbitrary code.
    # The calloc span starts empty; admission fills each existing slot once.
    c.lmx_execution_roots_push(g\arena, @ scope_roots, 0, 0U, 0, 0U, (cast: (@: void) scope), 0)
    c.lmx_execution_roots_push(g\arena, @ actual_roots, (cast: (@: void) values), count, 0, 0U, (cast: (@: void) code), 0)
    if: values != 0 && bindings != 0
        status := lmx_graph_bind_call(g, scope, code, expression, bindings)
    if: status = 0 && bindings[count] != 0U
        actual := c.lmx_graph_get_in(g, expression, 0U)
        if: bindings[count] = 1U
            status := lmx_graph_eval_record(g, scope, actual, @ candidate)
        else:
            status := c.lmx_walk_value_cell(g\arena, actual, @ candidate)
        ---
        if: status = 0
            status := lmx_graph_call_single_record(g, code, @ candidate, out)
        c.lmx_execution_roots_restore(g\arena, roots_mark)
        c.free((cast: (@: void) values))
        c.free((cast: (@: void) bindings))
        return: status
    while: i < count && status = 0
        raw := c.lmx_graph_get_in(g, expression, i)
        if: c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, (cast: (@: c.Lmx) raw), 0U)) = state\w_assign
            raw := c.lmx_graph_get_in(g, (cast: (@: c.Lmx) raw), 2U)
        status := lmx_graph_read_actual_value(g, scope, code, bindings[i], raw, values + i)
        i := i + 1U
    ---
    if: status = 0
        status := lmx_graph_invoke_values(g, code, values, count, bindings, out)
    c.lmx_execution_roots_restore(g\arena, roots_mark)
    c.free((cast: (@: void) values))
    c.free((cast: (@: void) bindings))
    return: status
end: lmx_graph_eval_call_value

# Evaluate an address-valued operand. A path returns the actual current field cell/Structure; arithmetic and a call
# create a result cell only where a receiving boundary needs an address. Arithmetic's intermediate ints stay local.
fn: lmx_graph_result_cell (@: g c.LmxGraph; @: value c.LmxWalkValue; @@: out void) int
    c.LmxWalkValue: boxed
    if: g = 0 || value = 0 || out = 0 || value\present = 0
        return: 4
    # A scalar return was already saved before cleanup. Its ordinary result
    # cell is also its address; do not copy it again merely to supply an address.
    if: value\kind = c.LMX_WALK_VALUE_FOREIGN && value\scalar_abi != 0
        if: c.lmx_walk_value_scalar_storage(g\arena, value, c.LMX_TYPE_FOREIGN, (cast: (const: @: c.LmxScalarABI) value\scalar_abi)) != c.LMX_WALK_OK
            return: 4
        out[0] := value\ref
        return: 0
    if: value\kind = c.LMX_WALK_VALUE_NUMBER && value\scalar_abi != 0
        if: c.lmx_graph_scalar_box(g\arena, value, @ boxed) != c.LMX_WALK_OK
            return: 4
        c.memcpy((cast: (@: void) value), (cast: (const: @: void) (@ boxed)), c.sizeof(c.LmxWalkValue))
        out[0] := boxed\ref
        return: 0
    if: c.lmx_walk_value_materialize(g\arena, value, out) != c.LMX_WALK_OK
        return: 4
    return: 0
end: lmx_graph_result_cell

# A value consumer keeps an application's authoritative result record. Its
# ordinary address is a separate need; reloading a cell can lose per-Value
# semantic context, including across cleanup, even when payload bytes agree.
fn: lmx_graph_eval_record (@: g c.LmxGraph; @: scope c.Lmx; @: raw void; @: out c.LmxWalkValue) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: word char 0
    @: cell void 0
    @: row c.LmxGraphWork 0
    @: current c.LmxWalkValue 0
    @: declared void 0
    int: status 0
    if: g = 0 || out = 0
        return: 4
    if: c.lmx_graph_kind(g, raw) = 2
        word := c.lmx_graph_word_text(g, raw)
        lmx_graph_input_used(g, word)
        cell := lmx_graph_select_binding(g, scope, word, @ row, @ current, @ declared, 1, @ status)
        if: status != 0
            return: status
        if: row != 0
            status := lmx_graph_work_load(g, row)
            if: status != 0
                return: status
            current := (cast: (@: c.LmxWalkValue) (@ row\value))
        ---
        if: current != 0 && current\kind != 0
            if: current\present = 0
                return: 5
            return: lmx_graph_work_value(g, row, current, out)
    ---
    if: c.lmx_graph_kind(g, raw) = 4
        word := c.lmx_graph_name_of(g, raw)
        if: word = 0 && c.lmx_graph_count((cast: (@: c.Lmx) raw)) = 1U && lmx_graph_group_expression(g, scope, raw) != 0
            return: lmx_graph_eval_record(g, scope, c.lmx_graph_get_in(g, (cast: (@: c.Lmx) raw), 0U), out)
        if: word = state\w_fncall
            return: lmx_graph_eval_fncall_value(g, scope, (cast: (@: c.Lmx) raw), out)
        if: word = 0 || lmx_graph_language_word(state, word) = 0
            if: c.lmx_graph_application_parts(g, raw, 0, 0, 0) != 0
                return: lmx_graph_eval_application_value(g, scope, (cast: (@: c.Lmx) raw), 1, out)
            ---
        ---
    ---
    status := lmx_graph_eval_value(g, scope, raw, @ cell)
    if: status != 0
        return: status
    if: c.lmx_graph_kind(g, cell) = 3
        cell := c.lmx_arena_pointer_void_read(cell)
    if: c.lmx_walk_value_cell(g\arena, cell, out) != c.LMX_WALK_OK
        return: 4
    return: 0
end: lmx_graph_eval_record

fn: lmx_graph_eval_value (@: g c.LmxGraph; @: scope c.Lmx; @: raw void; @@: out void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: expression c.Lmx 0
    @: value void raw
    @: word char 0
    c.LmxWalkValue: result
    size_t: count 0U
    int: kind (cast: (int) c.lmx_graph_kind(g, raw))
    int: number 0
    int: status 0
    int: snapshot (cast: (int) (kind = 5 || kind = 6 || kind = 8 || kind = 9))
    if: out = 0
        return: 2
    if: kind = 0
        if: lmx_graph_scalar_pool(g, raw) = 0
            return: 2
        return: lmx_graph_scalar_operand(g, raw, out)
    if: kind = 2
        status := lmx_graph_operand_read(g, scope, c.lmx_graph_word_text(g, raw), @ value)
        if: status != 0
            return: status
        ---
    else:
        if: kind = 4 && c.lmx_graph_name_of(g, raw) != 0
            # A Frame supplies the full result of its written head. Only the
            # numerical built-in receivers below use the numerical evaluator.
            if: c.lmx_graph_name_of(g, raw) = state\w_merge
                return: lmx_graph_eval_merge(g, scope, (cast: (@: c.Lmx) raw), out)
            word := c.lmx_graph_name_of(g, raw)
            if: word != state\w_typeof && word != state\w_length
                c.lmx_walk_value_clear(@ result)
                if: word = state\w_fncall
                    status := lmx_graph_eval_fncall_value(g, scope, (cast: (@: c.Lmx) raw), @ result)
                else:
                    if: lmx_graph_language_word(state, word) != 0
                        return: 2
                    status := lmx_graph_eval_application_value(g, scope, (cast: (@: c.Lmx) raw), 1, @ result)
                ---
                if: status != 0
                    return: status
                return: lmx_graph_result_cell(g, @ result, out)
            ---
            status := lmx_graph_eval_number(g, scope, raw, @ number)
            if: status != 0
                return: status
            value := c.lmx_graph_int(g, number)
            if: value = 0
                return: 4
            ---
        else:
            if: c.lmx_graph_application_parts(g, raw, 0, 0, 0) != 0
                c.lmx_walk_value_clear(@ result)
                status := lmx_graph_eval_application_value(g, scope, (cast: (@: c.Lmx) raw), 1, @ result)
                if: status != 0
                    return: status
                return: lmx_graph_result_cell(g, @ result, out)
            ---
            if: kind = 4 && lmx_graph_group_expression(g, scope, raw) != 0
                expression := (cast: (@: c.Lmx) raw)
                count := c.lmx_graph_count(expression)
                word := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, expression, 1U))
                # The index of a Structure, `base[index]` (the book, structure-index): the base's value and the index's
                # number, then the kernel's read of the slot -- an untyped reference to what the slot holds.
                if: count = 3U && word = state\w_index
                    status := lmx_graph_read_received_value(g, scope, c.lmx_graph_get_in(g, expression, 0U), 2, @ value)
                    if: status != 0
                        return: status
                    status := lmx_graph_eval_number(g, scope, c.lmx_graph_get_in(g, expression, 2U), @ number)
                    if: status != 0
                        return: status
                    return: c.lmx_graph_index(g, value, number, out)
                if: count = 3U && word = state\w_deref
                    status := lmx_graph_read_received_value(g, scope, c.lmx_graph_get_in(g, expression, 0U), 2, @ value)
                    if: status != 0
                        return: status
                    # The path step, through an atom too (lmx_graph_step; plan M11 5a).
                    status := lmx_graph_step(g, value, c.lmx_graph_get_in(g, expression, 2U), @ value)
                    if: status != 0
                        return: status
                    ---
                    snapshot := 1
                else:
                    word := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, expression, 0U))
                    if: count = 2U && word = state\w_at
                        value := c.lmx_graph_get_in(g, expression, 1U)
                        if: c.lmx_graph_kind(g, value) = 2
                            lmx_graph_input_used(g, c.lmx_graph_word_text(g, value))
                            status := lmx_graph_resolve_value(g, scope, c.lmx_graph_word_text(g, value), 1, @ value)
                            if: status != 0
                                return: status
                            status := 0
                            if: value = 0
                                status := 3
                            ---
                        else:
                            status := lmx_graph_eval_value(g, scope, value, @ value)
                        ---
                        if: status != 0
                            return: status
                        if: c.lmx_graph_kind(g, value) = 3
                            value := c.lmx_arena_pointer_void_read(value)
                        value := c.lmx_graph_ref_int(g, value)
                        if: value = 0
                            return: 4
                        ---
                    else:
                        if: count = 1U
                            return: lmx_graph_eval_value(g, scope, c.lmx_graph_get_in(g, expression, 0U), out)
                        status := lmx_graph_eval_number(g, scope, raw, @ number)
                        if: status != 0
                            return: status
                        value := c.lmx_graph_int(g, number)
                        if: value = 0
                            return: 4
                        ---
                    ---
                ---
            ---
        ---
    ---
    if: snapshot != 0 && lmx_graph_scalar_pool(g, value) != 0
        return: lmx_graph_scalar_operand(g, value, out)
    if: snapshot != 0 && c.lmx_graph_reference_cell(g, value) != 0
        value := lmx_graph_reference_value(g, value)
    if: snapshot != 0 && value = 0
        return: 4
    out[0] := value
    return: 0
end: lmx_graph_eval_value

# Consume the nested expression itself. No precedence parser or saved expression plan exists in either consumer.
fn: lmx_graph_eval_number (@: g c.LmxGraph; @: scope c.Lmx; @: raw void; @: out int) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: expression c.Lmx 0
    @: value void raw
    @: word char 0
    size_t: count 0U
    int: kind (cast: (int) c.lmx_graph_kind(g, raw))
    int: left 0
    int: right 0
    int: status 0
    if: kind = 2
        return: lmx_graph_named_int(g, scope, c.lmx_graph_word_text(g, raw), out)
    if: kind != 4
        return: c.lmx_graph_value_int(g, value, out)
    expression := (cast: (@: c.Lmx) raw)
    count := c.lmx_graph_count(expression)
    word := c.lmx_graph_name_of(g, raw)
    if: word != 0
        # The receiver typeof (the book, get-type): the type of the region of the arena that holds the address its one
        # argument stands for (lmx_graph_address_type). A written zero is the null address, which no region holds.
        if: word = state\w_typeof
            if: count != 1U
                return: 5
            value := c.lmx_graph_get_in(g, expression, 0U)
            if: c.lmx_graph_kind(g, value) = 1 && c.lmx_graph_name_of(g, value) = 0 && c.lmx_int_value_known(value) = 0
                out[0] := c.LMX_TYPE_NONE
                return: 0
            status := lmx_graph_read_received_value(g, scope, value, 2, @ value)
            if: status != 0
                return: status
            return: c.lmx_graph_address_type(g, value, out)
        # The receiver length (the book, structure-index): the number of the fields of the Structure its one argument
        # stands for (lmx_graph_length).
        if: word = state\w_length
            if: count != 1U
                return: 5
            status := lmx_graph_read_received_value(g, scope, c.lmx_graph_get_in(g, expression, 0U), 2, @ value)
            if: status != 0
                return: status
            return: c.lmx_graph_length(g, value, out)
        # The receiver fncall (the book, call-receivers): the launch of the code it is given, with its result.
        if: word = state\w_fncall
            return: lmx_graph_eval_fncall(g, scope, expression, out)
        if: word = state\w_merge || lmx_graph_language_word(state, word) != 0
            return: 2
        return: lmx_graph_eval_application(g, scope, expression, 1, out)
    if: c.lmx_graph_application_parts(g, raw, 0, 0, 0) != 0
        return: lmx_graph_eval_application(g, scope, expression, 1, out)
    word := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, expression, 1U))
    # A field path gives the int of its place; the index of a Structure gives an address, which has no int (answer 1).
    if: count = 3U && (word = state\w_deref || word = state\w_index)
        status := lmx_graph_eval_value(g, scope, raw, @ value)
        if: status != 0
            return: status
        return: c.lmx_graph_value_int(g, value, out)
    if: count = 3U && (word = state\w_plus || word = state\w_minus || word = state\w_star || word = state\w_slash || word = state\w_percent || word = state\w_eq || word = state\w_ne || word = state\w_lt || word = state\w_le || word = state\w_gt || word = state\w_ge || word = state\w_and || word = state\w_or)
        status := lmx_graph_eval_number(g, scope, c.lmx_graph_get_in(g, expression, 0U), @ left)
        if: status != 0
            return: status
        if: (word = state\w_and && left = 0) || (word = state\w_or && left != 0)
            out[0] := (cast: (int) (left != 0))
            return: 0
        status := lmx_graph_eval_number(g, scope, c.lmx_graph_get_in(g, expression, 2U), @ right)
        if: status != 0
            return: status
        if: word = state\w_plus
            left := left + right
        if: word = state\w_minus
            left := left - right
        if: word = state\w_star
            left := left * right
        if: word = state\w_slash || word = state\w_percent
            if: right = 0
                return: 6
            if: word = state\w_slash
                left := left / right
            else:
                left := left % right
            ---
        ---
        if: word = state\w_eq
            left := (cast: (int) (left = right))
        if: word = state\w_ne
            left := (cast: (int) (left != right))
        if: word = state\w_lt
            left := (cast: (int) (left < right))
        if: word = state\w_le
            left := (cast: (int) (left <= right))
        if: word = state\w_gt
            left := (cast: (int) (left > right))
        if: word = state\w_ge
            left := (cast: (int) (left >= right))
        if: word = state\w_and
            left := (cast: (int) (left && right))
        if: word = state\w_or
            left := (cast: (int) (left || right))
        out[0] := left
        return: 0
    word := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, expression, 0U))
    if: count = 2U && (word = state\w_plus || word = state\w_minus || word = state\w_not)
        status := lmx_graph_eval_number(g, scope, c.lmx_graph_get_in(g, expression, 1U), out)
        if: status = 0 && word = state\w_minus
            out[0] := 0 - out[0]
        if: status = 0 && word = state\w_not
            out[0] := (cast: (int) (out[0] = 0))
        return: status
    if: count = 2U && word = state\w_deref
        status := lmx_graph_eval_value(g, scope, c.lmx_graph_get_in(g, expression, 1U), @ value)
        if: status != 0
            return: status
        # A read through a pointer to data: the value read through is checked by the module of checks.
        status := c.lmx_check_data_read(c.lmx_graph_kind(g, value))
        if: status != 0
            return: status
        return: c.lmx_graph_value_int(g, c.lmx_arena_pointer_void_read(value), out)
    if: count = 1U
        return: lmx_graph_eval_number(g, scope, c.lmx_graph_get_in(g, expression, 0U), out)
    return: 2
end: lmx_graph_eval_number

# A receiving expression occupies one field: the builder has already put every operation into its ordinary Lmx.
fn: lmx_graph_eval (@: g c.LmxGraph; @: scope c.Lmx; @: expr c.Lmx; size_t: from; size_t: to; @: out int) int
    if: g = 0 || scope = 0 || expr = 0 || out = 0 || to != from + 1U
        return: 2
    return: lmx_graph_eval_number(g, scope, c.lmx_graph_get_in(g, expr, from), out)
end: lmx_graph_eval

# The root executes its code role in field order. Values stand; written named
# Frames apply their receiver or launch their selected value. Data declarations
# remain available through the whole registry independently of this traversal.
fn: lmx_graph_run (@: g c.LmxGraph; @: root c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: active c.LmxActivation 0
    c.LmxGraphFrame: frame
    @: flow char 0
    c.LmxWalkValue: result
    int: status 0
    int: opened 0
    int: owned 0
    if: g = 0 || root = 0
        return: 5
    c.lmx_walk_value_clear(@ result)
    status := lmx_graph_space_open(g, root, @ opened)
    if: status != 0
        return: status
    active := (cast: (@: c.LmxActivation) g\arena\activation)
    if: active = 0 || active\code != root
        status := 5
    else:
        if: active\frame = 0
            status := lmx_graph_work_open_data(g, root, root, @ frame)
            if: status = 0
                owned := 1
            ---
        ---
    ---
    if: status = 0
        status := lmx_graph_block(g, root, root, 0U, c.lmx_graph_count(root), 0, @ result, @ flow)
    if: status = 0 && flow != 0 && flow != state\w_return
        status := 5
    if: owned != 0
        status := lmx_graph_work_finish(g, @ frame, status)
    lmx_graph_space_close(opened)
    return: status
end: lmx_graph_run

# Dispatch the current clean graph. Native uses the existing common nullary call boundary; with no entry the clean
# interpreter gets a fresh activation frame, discarded on return. No previous traversal's bindings are retained.
fn: lmx_graph_call (@: g c.LmxGraph; @: file c.Lmx) int
    c.LmxActivation: activation
    @: root c.Lmx 0
    int: value 0
    int: status 0
    int: opened 0
    if: g = 0 || c.lmx_graph_kind(g, (cast: (@: void) file)) != 4
        return: 5
    # A file wrapped in the record L2 runs as the content of the record (lmx_graph_file_code): its traversal, its native
    # entry and its activation are the record's.
    root := c.lmx_graph_file_code(g, file)
    status := lmx_graph_space_open(g, root, @ opened)
    if: status != 0
        return: status
    if: root\native != 0
        status := c.lmx_call0(g\arena, root, @ value)
    else:
        status := 5
        if: c.lmx_activation_push(g\arena, @ activation, 2, root, 0, 0, 0U, 0) = 0
            status := lmx_graph_run(g, root)
            c.lmx_activation_pop(g\arena, @ activation)
        ---
    ---
    lmx_graph_space_close(opened)
    return: status
end: lmx_graph_call



# The formals the written actuals of a launch record give (the author 2026-11-11: the arguments of every receiver are
# named and given by position or by name, LMX_blog/2026-11-11.md#structure-call-by-name; R22): the record of the
# receiver call or fncall, head its canonical word, or the record that launches an ordinary Structure by name, head 0
# (lmx_graph_eval_launch_record) -- by the contract of the record (lmx_graph_receivers_open) and the one binder
# (lmx_graph_receiver_form_of): by position or by name through `:=`, every formal of the form given. The form depends on
# what is written alone, so a translation binds the record as the interpreter does. formals[i] the name of the formal
# actual i gives -- args, data, return, code --: the caller's array, one per actual. 0; 4 without memory; 5 for no form.
fn: lmx_graph_launch_formals (@: g c.LmxGraph; @: head char; @: expression c.Lmx; @@: formals char) int
    @: space c.LmxGraphSpace c.lmx_graph_space()
    @: key char head
    @: list c.Lmx 0
    @: chosen c.Lmx 0
    @: bindings size_t 0
    size_t: n 0U
    size_t: i 0U
    int: status 0
    if: g = 0 || space = 0 || formals = 0 || c.lmx_graph_kind(g, (cast: (@: void) expression)) != 4
        return: 5
    if: key = 0
        key := c.lmx_graph_intern("()", 2U)
    list := (cast: (@: c.Lmx) c.lmx_graph_space_find((cast: (@: c.Lmx) space\root), key))
    if: c.lmx_graph_kind(g, (cast: (@: void) list)) != 4
        return: 5
    n := c.lmx_graph_count(expression)
    bindings := (cast: (@: size_t) c.calloc(n + 1U, sizeof(size_t)))
    if: bindings = 0
        return: 4
    chosen := lmx_graph_receiver_form_of(g, list, expression, bindings, 0, @ status)
    while: status = 0 && i < n
        formals[i] := c.lmx_graph_slot_name(g, chosen, bindings[i])
        i := i + 1U
    ---
    c.free((cast: (@: void) bindings))
    return: status
end: lmx_graph_launch_formals

# The written value of the actual i of a launch record: the operand of `name := value` (lmx_graph_launch_formals took
# its name), or the actual as written.
fn: lmx_graph_launch_actual (@: g c.LmxGraph; @: expression c.Lmx; size_t: i) @: void
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void c.lmx_graph_get_in(g, expression, i)
    if: state != 0 && c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_count((cast: (@: c.Lmx) raw)) = 3U && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, (cast: (@: c.Lmx) raw), 0U)) = state\w_assign
        return: c.lmx_graph_get_in(g, (cast: (@: c.Lmx) raw), 2U)
    return: raw
end: lmx_graph_launch_actual

# An operand of a launch that stands for a Structure -- the arguments, the data, the code: a name, a path, a reference
# place, or an anonymous Structure written in parentheses (R21): such a Structure is itself, as written
# in the common receiving-value reader; any expression uses its existing reader.
# 0 and the value in out, or the answer of the evaluation.
fn: lmx_graph_launch_operand (@: g c.LmxGraph; @: scope c.Lmx; @: raw void; @@: out void) int
    return: lmx_graph_read_received_value(g, scope, raw, 2, out)
end: lmx_graph_launch_operand

# Select the live head once, before any actual is evaluated. The query's
# borrowed parts keep expression heads and ordinary named Frames on one route.
fn: lmx_graph_application_head (@: g c.LmxGraph; @: scope c.Lmx; @: head_name char; @: head_expr void; @@: out void) int
    @: raw void 0
    @: target void 0
    int: status 0
    if: out = 0
        return: 4
    out[0] := 0
    if: head_name != 0
        status := lmx_graph_operand_read(g, scope, head_name, @ raw)
    else:
        status := lmx_graph_read_received_value(g, scope, head_expr, 2, @ raw)
    ---
    if: status != 0
        return: status
    target := c.lmx_graph_target(g, raw)
    if: raw = 0 || target = 0
        return: 3
    if: c.lmx_graph_kind(g, target) != 4
        return: 8
    out[0] := target
    return: 0
end: lmx_graph_application_head

# The same selected head uses the existing callable binder/admission, or the
# ordinary launch contract. A value context requires a declared result before
# any actual effects; a signature without code is refused by the same binder.
fn: lmx_graph_eval_application_value (@: g c.LmxGraph; @: scope c.Lmx; @: application c.Lmx; int: want_result; @: out c.LmxWalkValue) int
    @: name char 0
    @: head void 0
    @: args c.Lmx 0
    @: target void 0
    int: status 0
    if: c.lmx_graph_application_parts(g, (cast: (@: void) application), @ name, @ head, @ args) = 0
        return: 2
    status := lmx_graph_application_head(g, scope, name, head, @ target)
    if: status != 0
        return: status
    if: c.lmx_graph_fn_result(g, target) != 0
        if: want_result != 0 && c.lmx_graph_has_result(g, (cast: (@: c.Lmx) target)) = 0
            return: 5
        return: lmx_graph_eval_call_value(g, scope, args, (cast: (@: c.Lmx) target), out)
    if: want_result != 0
        return: 5
    status := lmx_graph_eval_launch_record(g, scope, args, target)
    if: status = 0
        c.lmx_walk_value_clear(out)
    return: status
end: lmx_graph_eval_application_value

fn: lmx_graph_eval_application (@: g c.LmxGraph; @: scope c.Lmx; @: application c.Lmx; int: want_result; @: out int) int
    c.LmxWalkValue: result
    int: status 0
    if: out = 0
        return: 5
    c.lmx_walk_value_clear(@ result)
    status := lmx_graph_eval_application_value(g, scope, application, want_result, @ result)
    if: status = 0 && want_result != 0
        status := lmx_graph_result_int(g, @ result, out)
    return: status
end: lmx_graph_eval_application

# The record that launches an ordinary Structure by name (the author 2026-11-11,
# LMX_blog/2026-11-11.md#structure-call-by-name; R21, R22): `S()` runs S over itself, `S(D)` and `S(data := D)` over
# the data D -- the one argument data, by position or by name, bound by the one binder (lmx_graph_launch_formals: the
# forms [] and [data]; two positional arguments or another name are no form, 5). The data is an operand of a launch
# (lmx_graph_launch_operand) and the launch is the one of the receiver call (lmx_graph_call_data), so data that gives no
# Structure answers as there. 0, or the answer of the launch.
fn: lmx_graph_eval_launch_record (@: g c.LmxGraph; @: scope c.Lmx; @: expression c.Lmx; @: structure void) int
    @@: formals char 0
    @: raw void 0
    @: data void 0
    size_t: count c.lmx_graph_count(expression)
    int: status 0
    formals := (cast: (@@: char) c.calloc(count + 1U, sizeof(@: char)))
    if: formals = 0
        return: 4
    status := lmx_graph_launch_formals(g, 0, expression, formals)
    c.free((cast: (@: void) formals))
    if: status != 0
        return: status
    if: count = 0U
        return: lmx_graph_call_data(g, 0, (cast: (@: c.Lmx) structure), 1)
    raw := lmx_graph_launch_actual(g, expression, 0U)
    status := lmx_graph_launch_operand(g, scope, raw, @ data)
    if: status != 0
        return: status
    return: lmx_graph_call_data(g, (cast: (@: c.Lmx) data), (cast: (@: c.Lmx) structure), 0)
end: lmx_graph_eval_launch_record

# The receiver call (the book, call-receivers; the author 2026-11-11): the actual code and data are selected when the
# call runs. Its forms (lmx_graph_receivers_open) are bound by the one binder, by position or by name through `:=`
# (lmx_graph_launch_formals; R22): [args data code] is the launch without a result by its parts (lmx_graph_launch);
# [code] is the code alone -- an ordinary Structure runs over itself as its data, a callable over its own data; [data
# code] runs the code over the data: the data stands before the code (the author 2026-11-11,
# LMX_blog/2026-11-11.md#data-before-code; formerly the sources wrote `call: code data`). The operands are evaluated in
# the order they are written (lmx_graph_launch_operand).
fn: lmx_graph_eval_explicit_call (@: g c.LmxGraph; @: scope c.Lmx; @: expression c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @@: formals char 0
    @: head char 0
    @: raw void 0
    @: code void 0
    @: data void 0
    @: args void 0
    @: value void 0
    size_t: count c.lmx_graph_count(expression)
    size_t: i 0U
    int: parts 0
    int: given 0
    int: status 0
    if: state = 0
        return: 5
    formals := (cast: (@@: char) c.calloc(count + 1U, sizeof(@: char)))
    if: formals = 0
        return: 4
    head := state\w_call
    status := lmx_graph_launch_formals(g, head, expression, formals)
    while: status = 0 && i < count
        raw := lmx_graph_launch_actual(g, expression, i)
        status := lmx_graph_launch_operand(g, scope, raw, @ value)
        if: formals[i] = state\w_args
            args := value
            parts := 1
        ---
        if: formals[i] = state\w_data
            data := value
            given := 1
        ---
        if: formals[i] = state\w_code
            code := value
        i := i + 1U
    ---
    c.free((cast: (@: void) formals))
    if: status != 0
        return: status
    if: parts != 0
        if: args = 0 || data = 0 || code = 0
            return: 5
        return: lmx_graph_launch(g, (cast: (@: c.Lmx) args), (cast: (@: c.Lmx) data), 0, (cast: (@: c.Lmx) code), 0)
    ---
    if: given != 0
        return: lmx_graph_call_data(g, (cast: (@: c.Lmx) data), (cast: (@: c.Lmx) code), 0)
    return: lmx_graph_call_data(g, 0, (cast: (@: c.Lmx) code), 1)
end: lmx_graph_eval_explicit_call

# The data and the code of a launch by the receiver call, in the order of the form: the data before the code. With
# shorthand set (the one-argument form) no data is given and the code selects it.
fn: lmx_graph_call_data (@: g c.LmxGraph; @: given_data c.Lmx; @: given_code c.Lmx; int: shorthand) int
    c.LmxWalkValue: result
    if: shorthand = 0 && given_data = 0
        return: 5
    c.lmx_walk_value_clear(@ result)
    return: lmx_graph_launch_value(g, 0, given_data, 0, given_code, @ result)
end: lmx_graph_call_data

# The launch of code over data by its parts (the book, call-receivers; the author 2026-11-11): the receivers call and
# fncall give them -- the Structure of the arguments (0 for none), the data (0 for none), the canonical word of the
# description of the result (0 for a launch without one) and the code. A reference stands for its target. The formals
# of the launch are the fields of the arguments, each with its value: an int place gives this launch an independent
# cell, a reference place is passed as it is; a place without a value has no input and any other field is not a
# formal of this subset (5). An ordinary Structure is its own code; a callable given as code runs its code part. With
# no data an ordinary Structure runs over itself and a callable over its own data. A callable given without arguments
# keeps its own contract and its own entry (lmx_graph_invoke_data). Data is not completed for the launch: it must have
# every place the code declares or uses (lmx_graph_work_require) -- only fn, sub and catch complete their data, when
# the graph is built. The result of this subset is an int, so its description must be the word int
# (lmx_graph_call_shape); a launch with a result must return one. 0 and the result in out, or the interpreter's answer.
fn: lmx_graph_launch_value (@: g c.LmxGraph; @: given_args c.Lmx; @: given_data c.Lmx; @: result char; @: given_code c.Lmx; @: out c.LmxWalkValue) int
    @: code c.Lmx (cast: (@: c.Lmx) c.lmx_graph_target(g, (cast: (@: void) given_code)))
    @: args c.Lmx (cast: (@: c.Lmx) c.lmx_graph_target(g, (cast: (@: void) given_args)))
    @: data c.Lmx (cast: (@: c.Lmx) c.lmx_graph_target(g, (cast: (@: void) given_data)))
    @: values c.LmxWalkValue 0
    @: bindings size_t 0
    @: from size_t 0
    @: field void 0
    c.LmxExecutionRoots: actual_roots
    c.LmxExecutionRoots: data_roots
    @: roots_mark c.LmxExecutionRoots 0
    size_t: count 0U
    size_t: width 0U
    size_t: i 0U
    size_t: slot 0U
    int: status 0
    if: data = 0
        data := code
    if: out = 0 || c.lmx_graph_kind(g, (cast: (@: void) code)) != 4 || c.lmx_graph_kind(g, (cast: (@: void) data)) != 4
        return: 5
    if: given_args != 0 && c.lmx_graph_kind(g, (cast: (@: void) args)) != 4
        return: 5
    count := c.lmx_graph_count(args)
    width := c.lmx_graph_count(data)
    values := (cast: (@: c.LmxWalkValue) c.calloc(count + 1U, c.sizeof(c.LmxWalkValue)))
    bindings := (cast: (@: size_t) c.calloc(count + 1U, sizeof(size_t)))
    from := (cast: (@: size_t) c.calloc(width + 1U, sizeof(size_t)))
    if: values = 0 || bindings = 0 || from = 0
        status := 4
    roots_mark := c.lmx_execution_roots_mark(g\arena)
    c.lmx_execution_roots_push(g\arena, @ data_roots, 0, 0U, 0, 0U, (cast: (@: void) data), 0)
    c.lmx_execution_roots_push(g\arena, @ actual_roots, (cast: (@: void) values), count, 0, 0U, (cast: (@: void) args), 0)
    if: status = 0 && args != 0
        if: lmx_graph_bind_fields(g, data, args, from) = 0
            status := 5
        ---
    ---
    while: i < count && status = 0
        slot := 0U
        while: slot < width && from[slot] != i + 1U
            slot := slot + 1U
        if: slot >= width
            status := 5
        else:
            field := c.lmx_graph_get_in(g, args, i)
            status := c.lmx_walk_value_cell(g\arena, field, values + i)
            if: status = 0
                status := lmx_graph_admit_value(g, code, data, slot, values + i, values + i)
            bindings[i] := slot
        ---
        i := i + 1U
    ---
    if: status = 0
        status := lmx_graph_invoke_data_value(g, code, data, code, result, 0, values, count, bindings, out)
    c.lmx_execution_roots_restore(g\arena, roots_mark)
    c.free((cast: (@: void) values))
    c.free((cast: (@: void) bindings))
    c.free((cast: (@: void) from))
    return: status
end: lmx_graph_launch_value

fn: lmx_graph_launch (@: g c.LmxGraph; @: given_args c.Lmx; @: given_data c.Lmx; @: result char; @: given_code c.Lmx; @: out int) int
    c.LmxWalkValue: returned
    int: status 0
    if: result != 0 && out = 0
        return: 5
    c.lmx_walk_value_clear(@ returned)
    status := lmx_graph_launch_value(g, given_args, given_data, result, given_code, @ returned)
    if: status = 0 && result != 0
        status := lmx_graph_result_int(g, @ returned, out)
    return: status
end: lmx_graph_launch

# The receiver fncall (the book, call-receivers; the author 2026-11-11): the launch of code that returns a result. Its
# forms (lmx_graph_receivers_open) are bound by the one binder, by position or by name through `:=`
# (lmx_graph_launch_formals; R22): `fncall(args data return code)`, `fncall(data return code)`, `fncall(return code)`.
# The arguments, the data and the code are operands of a launch (lmx_graph_launch_operand); the description is a word of
# the language written as it is (`int`) or a value that holds one (the return part of a callable, `f\return`). The
# operands are evaluated in the order they are written, each received before the next. 0 and the result in out.
fn: lmx_graph_eval_fncall_value (@: g c.LmxGraph; @: scope c.Lmx; @: expression c.Lmx; @: out c.LmxWalkValue) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @@: formals char 0
    @: head char 0
    @: args void 0
    @: data void 0
    @: code void 0
    @: raw void 0
    @: value void 0
    @: described void 0
    @: result char 0
    size_t: count c.lmx_graph_count(expression)
    size_t: i 0U
    int: status 0
    if: state = 0 || out = 0
        return: 5
    formals := (cast: (@@: char) c.calloc(count + 1U, sizeof(@: char)))
    if: formals = 0
        return: 4
    head := state\w_fncall
    status := lmx_graph_launch_formals(g, head, expression, formals)
    while: status = 0 && i < count
        raw := lmx_graph_launch_actual(g, expression, i)
        if: formals[i] = state\w_return
            raw := lmx_graph_description_value(g, raw)
            result := c.lmx_graph_word_text(g, raw)
            if: result = 0 || lmx_graph_language_word(state, result) = 0
                status := lmx_graph_eval_value(g, scope, raw, @ described)
                result := c.lmx_graph_word_text(g, described)
            ---
            if: status = 0 && result = 0
                status := 5
            ---
        else:
            value := 0
            status := lmx_graph_launch_operand(g, scope, raw, @ value)
            if: status = 0 && value = 0 && formals[i] != state\w_code
                status := 5
            if: formals[i] = state\w_args
                args := value
            if: formals[i] = state\w_data
                data := value
            if: formals[i] = state\w_code
                code := value
        ---
        i := i + 1U
    ---
    c.free((cast: (@: void) formals))
    if: status != 0
        return: status
    if: code = 0
        return: 5
    return: lmx_graph_launch_value(g, (cast: (@: c.Lmx) args), (cast: (@: c.Lmx) data), result, (cast: (@: c.Lmx) code), out)
end: lmx_graph_eval_fncall_value

fn: lmx_graph_eval_fncall (@: g c.LmxGraph; @: scope c.Lmx; @: expression c.Lmx; @: out int) int
    c.LmxWalkValue: result
    int: status 0
    if: out = 0
        return: 5
    c.lmx_walk_value_clear(@ result)
    status := lmx_graph_eval_fncall_value(g, scope, expression, @ result)
    if: status = 0
        status := lmx_graph_result_int(g, @ result, out)
    return: status
end: lmx_graph_eval_fncall

# ---- merge in the clean graph (the book, composition and whole-arguments; kernel §6.4) -----------------------------
# The author 2026-11-08 (LMX_blog/2026-11-08.md): a head naming a function is applied once and its result is the
# operand -- a slot of the model never intercepts the call; a Frame whose head names no function describes a structure.
# Operands are evaluated once, left to right, by their general meaning; their composition is one kernel operation
# (lmx_graph_merge_values) shared by the interpreter and native code.

# A word of the language: the state's words, none of which names a place.
fn: lmx_graph_language_word (@: state c.LmxGraphState; @: word char) int
    if: state = 0 || word = 0
        return: 0
    if: word = state\w_int || word = state\w_plus || word = state\w_minus || word = state\w_star || word = state\w_slash || word = state\w_percent || word = state\w_at || word = state\w_deref || word = state\w_fn || word = state\w_sub || word = state\w_assign || word = state\w_return || word = state\w_call
        return: 1
    if: word = state\w_eq || word = state\w_ne || word = state\w_lt || word = state\w_le || word = state\w_gt || word = state\w_ge || word = state\w_and || word = state\w_or || word = state\w_not || word = state\w_if || word = state\w_else || word = state\w_while || word = state\w_for || word = state\w_break
        return: 1
    if: word = state\w_continue || word = state\w_redo || word = state\w_until || word = state\w_finally || word = state\w_merge || word = state\w_include || word = state\w_predef || word = state\w_fm || word = state\w_typeof
        return: 1
    if: word = state\w_apply || word = state\w_index || word = state\w_length || word = state\w_fncall || word = state\w_node
        return: 1
    return: 0
end: lmx_graph_language_word

# A written field of an anonymous Structure in this subset, by its form only: a declaration of a place by its receiver
# (the book, receiver-args-only) -- `int: name value` or `int: name` (2), `@: name int value` (3). Its name word and
# value (0 for none) in the outs; 0 for any other form. A field `name: tail` is no field of this subset: it declares a
# Structure name inside the written one (the book, colon-declares), no place (lmx_graph_merge_description).
fn: lmx_graph_literal_field (@: g c.LmxGraph; @: raw void; @@: name char; @@: value void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: field c.Lmx 0
    @: head char 0
    size_t: n 0U
    int: kind 0
    name[0] := 0
    value[0] := 0
    if: g = 0 || state = 0
        return: 0
    kind := c.lmx_graph_kind(g, raw)
    # A declaration of an int place in the Structure is that place (§3.2): `int: name value` or `int: name`.
    if: kind = 1 || kind = 3
        if: kind = 3
            name[0] := c.lmx_graph_name_of(g, c.lmx_arena_pointer_void_read(raw))
        else:
            name[0] := c.lmx_graph_name_of(g, raw)
            value[0] := raw
        ---
        if: name[0] = 0 || lmx_graph_language_word(state, name[0]) != 0
            return: 0
        return: 2
    # A type-only reference is already a physical data field. Its ordinary
    # structural copy belongs to the merge map; there is no initializer.
    if: kind = 8 || kind = 9
        name[0] := c.lmx_graph_name_of(g, c.lmx_graph_reference_cell(g, raw))
        if: name[0] = 0 || lmx_graph_language_word(state, name[0]) != 0
            return: 0
        return: 4
    if: kind != 4
        return: 0
    field := (cast: (@: c.Lmx) raw)
    n := c.lmx_graph_count(field)
    head := c.lmx_graph_name_of(g, raw)
    if: head = state\w_int
        if: n != 1U && n != 2U
            return: 0
        name[0] := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, field, 0U))
        if: name[0] = 0 || lmx_graph_language_word(state, name[0]) != 0
            return: 0
        if: n = 2U
            value[0] := c.lmx_graph_get_in(g, field, 1U)
        return: 2
    if: head = state\w_at
        if: n != 3U || c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, field, 1U)) != state\w_int
            return: 0
        name[0] := c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, field, 0U))
        if: name[0] = 0 || lmx_graph_language_word(state, name[0]) != 0
            return: 0
        value[0] := c.lmx_graph_get_in(g, field, 2U)
        return: 3
    return: 0
end: lmx_graph_literal_field

# An anonymous Structure written as an operand of merge (the book, whole-arguments: the inner parentheses form a
# Structure with the field a): an unnamed Lmx all of whose fields are written fields of this subset, the empty one
# included. 1 or 0.
fn: lmx_graph_merge_literal (@: g c.LmxGraph; @: scope c.Lmx; @: raw void) int
    @: literal c.Lmx 0
    @: name char 0
    @: value void 0
    size_t: i 0U
    if: g = 0 || c.lmx_graph_kind(g, raw) != 4 || c.lmx_graph_name_of(g, raw) != 0
        return: 0
    literal := (cast: (@: c.Lmx) raw)
    if: c.lmx_graph_method(g, literal) != 0
        return: 0
    while: i < c.lmx_graph_count(literal)
        if: lmx_graph_literal_field(g, c.lmx_graph_get_in(g, literal, i), @ name, @ value) = 0
            return: 0
        i := i + 1U
    ---
    return: 1
end: lmx_graph_merge_literal

# An operand of merge describing a structure: a bare Frame whose head word names no callable, such as `v: 9` for an
# unknown v (the author 2026-11-08: such a Frame may simply describe a structure; expressions are structures in the tree
# too), or an anonymous Structure with such a Frame among its fields, `(v: 9)` -- the Frame declares a Structure v
# inside it (the book, colon-declares), no place. It is that structure, not a supply of a model slot. How its unnamed
# and nested fields compose is the open part asked of the author with the fn/return parts: both consumers refuse it
# with the form answer (5). 1 or 0.
fn: lmx_graph_merge_description (@: g c.LmxGraph; @: scope c.Lmx; @: raw void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: frame c.Lmx 0
    @: field void 0
    @: head char 0
    size_t: i 0U
    if: g = 0 || state = 0 || c.lmx_graph_kind(g, raw) != 4
        return: 0
    frame := (cast: (@: c.Lmx) raw)
    head := c.lmx_graph_name_of(g, raw)
    if: head = 0
        if: c.lmx_graph_method(g, frame) != 0
            return: 0
        while: i < c.lmx_graph_count(frame)
            field := c.lmx_graph_get_in(g, frame, i)
            if: c.lmx_graph_kind(g, field) = 4 && c.lmx_graph_name_of(g, field) != 0 && lmx_graph_merge_description(g, scope, field) != 0
                return: 1
            i := i + 1U
        ---
        return: 0
    if: c.lmx_graph_count(frame) < 1U || lmx_graph_language_word(state, head) != 0
        return: 0
    if: c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_target(g, lmx_graph_resolve(g, scope, head)))) != 0
        return: 0
    return: 1
end: lmx_graph_merge_description

# The value of a written anonymous Structure: a new Structure with one place per written field, in order -- each
# declared by its receiver (`int: a 5`, `@: p int @x`; the book, receiver-args-only). A name that already resolves and a
# name repeated in the literal are open in this subset (5). The places come from lmx_graph_merge_literal_put. 0 and the
# Structure in out.
fn: lmx_graph_merge_literal_open (@: g c.LmxGraph; @: scope c.Lmx; @: literal c.Lmx; @@: out void) int
    @: name char 0
    @: other char 0
    @: value void 0
    @: made c.Lmx 0
    size_t: n 0U
    size_t: i 0U
    size_t: j 0U
    int: form 0
    if: out = 0 || lmx_graph_merge_literal(g, scope, (cast: (@: void) literal)) = 0
        return: 5
    out[0] := 0
    n := c.lmx_graph_count(literal)
    while: i < n
        form := lmx_graph_literal_field(g, c.lmx_graph_get_in(g, literal, i), @ name, @ value)
        if: lmx_graph_resolve(g, scope, name) != 0
            return: 5
        j := 0U
        while: j < i
            form := lmx_graph_literal_field(g, c.lmx_graph_get_in(g, literal, j), @ other, @ value)
            if: other = name
                return: 5
            j := j + 1U
        ---
        i := i + 1U
    ---
    made := c.lmx_graph_lmx(g, 0, n)
    if: made = 0
        return: 4
    out[0] := (cast: (@: void) made)
    return: 0
end: lmx_graph_merge_literal_open

# The place of written field index of the constructed literal, named at its cell: for `int: name value` a new int place
# holding the int of the value (a literal of the code is not shared with a place, §3.2); for `int: name` a place without
# a value; for `@: name int value` a new int reference to the cell the value refers to -- an int reference, or the
# address an index of a Structure read when it is an int cell's (lmx_graph_int_ref_of) --, never the evaluated reference
# itself, which may be another place. 0; 4 for a value the place does not admit, or without memory; 5 for no field of
# this subset.
fn: lmx_graph_merge_literal_put (@: g c.LmxGraph; @: literal c.Lmx; @: made c.Lmx; size_t: index; @: value void) int
    @: name char 0
    @: written void 0
    @: place void 0
    @: cell void 0
    int: form 0
    int: number 0
    if: g = 0 || literal = 0 || made = 0 || index >= c.lmx_graph_count(literal) || index >= c.lmx_graph_count(made)
        return: 5
    form := lmx_graph_literal_field(g, c.lmx_graph_get_in(g, literal, index), @ name, @ written)
    if: form = 0
        return: 5
    if: form = 4
        if: c.lmx_graph_put_in(g, made, index, c.lmx_graph_get_in(g, literal, index)) != 0
            return: 4
        return: 0
    if: written = 0
        place := c.lmx_graph_uninit_int(g)
        if: place = 0
            return: 4
        cell := c.lmx_arena_pointer_void_read(place)
    else:
        if: form = 3
            if: c.lmx_graph_kind(g, value) = 5
                place := c.lmx_graph_ref_int(g, c.lmx_arena_pointer_void_read(value))
            else:
                place := c.lmx_graph_int_ref_of(g, value)
            ---
            cell := place
        else:
            if: c.lmx_graph_value_int(g, value, @ number) != 0
                return: 4
            place := c.lmx_graph_int(g, number)
            cell := place
        ---
    ---
    if: place = 0 || cell = 0 || c.lmx_graph_name_address(g, cell, name) != 0 || c.lmx_graph_put_in(g, made, index, place) != 0
        return: 4
    return: 0
end: lmx_graph_merge_literal_put

# A written name or callable needs the copied lexical chain. The physical
# closure is this operation's borrowed preflight; source fields stay intact.
# Chain discovery borrows the same canonical cell proofs as the copier.
# The queue holds physical addresses, including real CHILDREN locations;
# only graph_node_in authorizes a header read. Copy still owns admission
# of other physical families and full context relocation.
fn: lmx_graph_merge_scan_owned (@: g c.LmxGraph; @@@: seen c.Lmx; @: count size_t; @: cap size_t; @: value void) int
    if: value = 0 || c.lmx_range_classify(g\arena, value) = 0
        return: 0
    return: c.lmx_graph_scan_add(seen, count, cap, (cast: (@: c.Lmx) value))
end: lmx_graph_merge_scan_owned

fn: lmx_graph_merge_check (@: g c.LmxGraph; @@: values void; size_t: n; @: chain int) int
    @@: seen c.Lmx 0
    @: current void 0
    @: current_node c.Lmx 0
    @: array c.VoidArray 0
    @: pool c.LmxPool 0
    @: pointer c.LmxPool 0
    @: context c.LmxWalkValue 0
    @: value void 0
    @: owner void 0
    c.LmxWalkValue: saved_storage
    @: saved c.LmxWalkValue @ saved_storage
    size_t: count 0U
    size_t: cap 0U
    size_t: at 0U
    size_t: i 0U
    int: kind 0
    int: status 0
    chain[0] := 0
    while: i < n && status = 0
        if: c.lmx_graph_kind(g, values[i]) != 4
            status := 4
        else:
            status := lmx_graph_merge_scan_owned(g, @ seen, @ count, @ cap, values[i])
        ---
        i := i + 1U
    ---
    while: at < count && status = 0
        current := (cast: (@: void) seen[at])
        at := at + 1U
        current_node := c.lmx_graph_node_in(g\arena, current)
        if: current_node != 0
            if: c.lmx_graph_method(g, current_node) != 0
                chain[0] := 1
            array := (cast: (@: c.VoidArray) (@ current_node\array))
            i := 0U
            while: i < array\size && status = 0
                value := c.lmx_graph_value_in(g\arena, current_node, i)
                status := lmx_graph_merge_scan_owned(g, @ seen, @ count, @ cap, value)
                i := i + 1U
            ---
        else:
            pool := c.lmx_range_cell_pool(g\arena, current)
            if: pool = 0
                status := 5
                break
            ---
            if: pool\kind = c.LMX_KIND_PRIMITIVE
                if: c.lmx_type_base((cast: (int) pool\type)) = c.LMX_TYPE_WORD
                    chain[0] := 1
                context := c.lmx_value_cell_context(g\arena, current)
                pointer := c.lmx_pointer_pool_in(g\arena, current)
                if: pointer != 0
                    if: c.lmx_walk_value_load(g\arena, current, (cast: (int) pool\type), saved) != c.LMX_WALK_OK
                        status := 5
                    else:
                        context := saved
                        value := (cast: (@: void) saved\ref)
                        kind := c.lmx_graph_kind(g, current)
                        if: ((kind = 3 || kind = 5) && c.lmx_graph_kind(g, value) != 1 && (kind = 3 || value != 0)) || (kind = 6 && value != 0 && c.lmx_graph_kind(g, value) != 4) || ((kind = 8 || kind = 9) && c.lmx_graph_kind(g, value) != kind - 3)
                            status := 5
                        else:
                            status := lmx_graph_merge_scan_owned(g, @ seen, @ count, @ cap, value)
                        ---
                    ---
                ---
                if: context != 0 && status = 0
                    status := lmx_graph_merge_scan_owned(g, @ seen, @ count, @ cap, (cast: (@: void) context\model))
                    if: status = 0
                        status := lmx_graph_merge_scan_owned(g, @ seen, @ count, @ cap, (cast: (@: void) context\references))
                    if: status = 0
                        status := lmx_graph_merge_scan_owned(g, @ seen, @ count, @ cap, (cast: (@: void) context\source_type))
                    if: context\referent != 0 && status = 0
                        owner := c.lmx_value_context_cell_in(g\arena, (cast: (@: c.LmxWalkValue) context\referent))
                        if: owner = 0
                            status := 5
                        else:
                            status := lmx_graph_merge_scan_owned(g, @ seen, @ count, @ cap, owner)
                        ---
                    ---
                ---
            else:
                if: pool\kind = c.LMX_KIND_CHILDREN || pool\kind = c.LMX_KIND_REF
                    if: pool\stride != sizeof(@: void)
                        status := 5
                    else:
                        value := c.lmx_arena_pointer_void_read(current)
                        status := lmx_graph_merge_scan_owned(g, @ seen, @ count, @ cap, value)
                    ---
                ---
            ---
        ---
    ---
    c.free((cast: (@: void) seen))
    if: status = 1
        return: 4
    return: status
end: lmx_graph_merge_check


# The leaf of the receiver chain of a field of an operand (const:, private: ...): the place or the value inside the records, as every consumer reads the field.
fn: lmx_graph_receiving_leaf (@: g c.LmxGraph; @: raw void) @: void
    @: leaf void 0
    int: flag 0
    if: c.lmx_graph_receiving_view(g, raw, @ leaf, @ flag) != 0
        return: raw
    return: leaf

# The value of a field of an operand as merge reads it: the value of the leaf of its receiver chain.
fn: lmx_graph_merge_field_value (@: g c.LmxGraph; @: raw void) @: void
    @: leaf void lmx_graph_receiving_leaf(g, raw)
    return: lmx_graph_field_value(g, leaf)

# The legacy int branch of assignment admission. Scalar and WORD branches
# in replay likewise keep the receiving cell; structural parts use layout.
fn: lmx_graph_merge_write (@: g c.LmxGraph; @: result c.Lmx; @: place void; @: value void) int
    @: cell void place
    int: kind c.lmx_graph_kind(g, place)
    int: number 0
    if: kind != 1 && kind != 3
        return: 5
    if: c.lmx_graph_value_int(g, value, @ number) != 0
        return: 4
    if: kind = 3
        cell := c.lmx_arena_pointer_void_read(place)
    if: c.lmx_graph_kind(g, cell) != 1 || c.lmx_graph_invalidate(g, result, 0, cell, cell) != 0
        return: 4
    if: c.lmx_int_store_known(cell, number) != 0
        return: 4
    return: 0
end: lmx_graph_merge_write

# A later field that names an int place of the result it does not provide is that place in the one source -> copy map
# (the review of 325): its value answers the result's place and its cell -- the cell behind a place without a value
# included -- the result's cell, so a reference to it reached by the copy goes to the result's place. A source already
# mapped keeps its first copy. 0, or 4 without memory.
fn: lmx_graph_merge_alias (@: g c.LmxGraph; @: map c.LmxCopyMap; @: field void; @: place void) int
    @: cell void field
    @: target void place
    if: c.lmx_graph_kind(g, place) = 3
        target := c.lmx_arena_pointer_void_read(place)
    if: c.lmx_graph_kind(g, field) = 3
        if: c.lmx_copy_map_get(map, field) = 0 && c.lmx_copy_map_put(map, field, place) != 0
            return: 4
        cell := c.lmx_arena_pointer_void_read(field)
    ---
    if: c.lmx_copy_map_get(map, cell) = 0 && c.lmx_copy_map_put(map, cell, target) != 0
        return: 4
    return: 0
end: lmx_graph_merge_alias

# The value a field gives where a receiver consumes a Structure by its parts (§3.3; the contract of merge and of fn,
# independently of the code role that applies a named Frame): a
# reference answers its target; a part `name: value` whose single field is a value -- a word, an unnamed int, a
# reference, an unnamed Lmx -- answers that value; any other field (a place, a word place, a named Structure of fields)
# answers itself, and so does a part whose single field is an assignment `a := v`: a statement, the body of one
# statement, no value. Whatever made the Structure -- written code, merge, a function a receiver created -- its fields
# are read so (merge, lmx_graph_fn_part).
fn: lmx_graph_field_value (@: g c.LmxGraph; @: value void) @: void
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: field void 0
    int: kind 0
    if: g = 0 || state = 0 || value = 0
        return: value
    if: c.lmx_graph_kind(g, value) = 6
        return: c.lmx_graph_target(g, value)
    if: c.lmx_graph_kind(g, value) != 4 || c.lmx_graph_count((cast: (@: c.Lmx) value)) != 1U
        return: value
    field := c.lmx_graph_get_in(g, (cast: (@: c.Lmx) value), 0U)
    kind := c.lmx_graph_kind(g, field)
    if: kind = 6
        return: c.lmx_graph_target(g, field)
    if: kind = 4 && c.lmx_graph_name_of(g, field) = 0 && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, (cast: (@: c.Lmx) field), 0U)) = state\w_assign
        return: value
    if: kind = 2 || ((kind = 1 || kind = 4) && c.lmx_graph_name_of(g, field) = 0)
        return: field
    return: value
end: lmx_graph_field_value

# Receiving identity and layout precede all Value reserve. A shared source
# part joins the same receiving family even when different sibling fields
# compose it. These arrays are the former merge_level locals, kept until
# the ONE operation has finished. The group map contains scratch pointers,
# while the common copier's separate map contains only physical addresses.
fn: lmx_graph_merge_leader (@: plan c.LmxGraphMergeLayout) @: c.LmxGraphMergeLayout
    while: plan != 0 && plan\leader != plan
        plan := (cast: (@: c.LmxGraphMergeLayout) plan\leader)
    ---
    return: plan
end: lmx_graph_merge_leader

fn: lmx_graph_merge_group (@: groups c.LmxCopyMap; @@: head c.LmxGraphMergeLayout; @: ordinal size_t; @@: values void; size_t: n; @: changed int; @@: out c.LmxGraphMergeLayout) int
    @: plan c.LmxGraphMergeLayout 0
    @: other c.LmxGraphMergeLayout 0
    @: swap c.LmxGraphMergeLayout 0
    @: source c.Lmx 0
    size_t: k 0U
    size_t: j 0U
    out[0] := 0
    if: n = 0U || values[0] = 0
        return: 5
    plan := lmx_graph_merge_leader((cast: (@: c.LmxGraphMergeLayout) c.lmx_copy_map_get(groups, values[0])))
    if: plan = 0
        plan := (cast: (@: c.LmxGraphMergeLayout) c.calloc(1U, c.sizeof(c.LmxGraphMergeLayout)))
        if: plan = 0
            return: 4
        plan\leader := plan
        plan\order := ordinal[0]
        ordinal[0] := ordinal[0] + 1U
        plan\next := head[0]
        head[0] := plan
        changed[0] := 1
    ---
    while: k < n
        source := (cast: (@: c.Lmx) values[k])
        other := lmx_graph_merge_leader((cast: (@: c.LmxGraphMergeLayout) c.lmx_copy_map_get(groups, values[k])))
        if: other != 0 && other != plan
            if: other\order < plan\order
                swap := plan
                plan := other
                other := swap
            ---
            j := 0U
            while: j < other\count
                if: c.lmx_graph_scan_add(@ plan\sources, @ plan\count, @ plan\capacity, other\sources[j]) != 0 || c.lmx_copy_map_put(groups, (cast: (@: void) other\sources[j]), (cast: (@: void) plan)) != 0
                    return: 4
                j := j + 1U
            ---
            other\leader := plan
            changed[0] := 1
        ---
        if: other = 0
            if: c.lmx_graph_scan_add(@ plan\sources, @ plan\count, @ plan\capacity, source) != 0 || c.lmx_copy_map_put(groups, (cast: (@: void) source), (cast: (@: void) plan)) != 0
                return: 4
            changed[0] := 1
        ---
        k := k + 1U
    ---
    out[0] := plan
    return: 0
end: lmx_graph_merge_group

fn: lmx_graph_merge_layout (@: g c.LmxGraph; @: plan c.LmxGraphMergeLayout) int
    @@: names char 0
    @@: first void 0
    @@: from_nodes c.Lmx 0
    @: from_j size_t 0
    @: wrote int 0
    @: source c.Lmx 0
    @: name char 0
    size_t: room 0U
    size_t: total 0U
    size_t: k 0U
    size_t: j 0U
    size_t: i 0U
    while: k < plan\count
        source := (cast: (@: c.Lmx) plan\sources[k])
        if: c.lmx_graph_count(source) >= (cast: (size_t) -1) - room
            return: 4
        room := room + c.lmx_graph_count(source)
        k := k + 1U
    ---
    names := (cast: (@@: char) c.calloc(room + 1U, sizeof(@: char)))
    first := (cast: (@@: void) c.calloc(room + 1U, sizeof(@: void)))
    from_nodes := (cast: (@@: c.Lmx) c.calloc(room + 1U, sizeof(@: c.Lmx)))
    from_j := (cast: (@: size_t) c.calloc(room + 1U, sizeof(size_t)))
    wrote := (cast: (@: int) c.calloc(room + 1U, sizeof(int)))
    c.free((cast: (@: void) plan\names))
    c.free((cast: (@: void) plan\first))
    c.free((cast: (@: void) plan\from_nodes))
    c.free((cast: (@: void) plan\from_j))
    c.free((cast: (@: void) plan\wrote))
    plan\names := names
    plan\first := first
    plan\from_nodes := from_nodes
    plan\from_j := from_j
    plan\wrote := wrote
    plan\width := 0U
    if: names = 0 || first = 0 || from_nodes = 0 || from_j = 0 || wrote = 0
        return: 4
    k := 0U
    while: k < plan\count
        source := (cast: (@: c.Lmx) plan\sources[k])
        j := 0U
        while: j < c.lmx_graph_count(source)
            name := c.lmx_graph_slot_name(g, source, j)
            if: k != 0U && name = 0
                return: 5
            i := total
            if: k != 0U
                i := 0U
                while: i < total && names[i] != name
                    i := i + 1U
                ---
            ---
            if: i = total
                names[total] := name
                first[total] := c.lmx_graph_get_in(g, source, j)
                from_nodes[total] := source
                from_j[total] := j
                total := total + 1U
            ---
            j := j + 1U
        ---
        k := k + 1U
    ---
    plan\width := total
    return: 0
end: lmx_graph_merge_layout

# The provider's physical occurrence is kept, including repeated names in
# the first model. Other suppliers select the same canonical layout name.
fn: lmx_graph_merge_source_slot (@: g c.LmxGraph; @: plan c.LmxGraphMergeLayout; size_t: index; @: source c.Lmx) size_t
    @: name char (cast: (@: char) plan\names[index])
    if: source = plan\from_nodes[index]
        return: (cast: (size_t) plan\from_j[index])
    if: name = 0
        return: (cast: (size_t) -1)
    return: c.lmx_graph_named(g, source, name)
end: lmx_graph_merge_source_slot

# A finite monotone closure of source-header membership. No source or
# result field is written, no initializer/Model/test is executed here.
fn: lmx_graph_merge_close (@: g c.LmxGraph; @: groups c.LmxCopyMap; @@: head c.LmxGraphMergeLayout; @: ordinal size_t) int
    @: plan c.LmxGraphMergeLayout 0
    @: joined c.LmxGraphMergeLayout 0
    @: source c.Lmx 0
    @: part void 0
    @@: parts void 0
    size_t: i 0U
    size_t: k 0U
    size_t: j 0U
    size_t: count 0U
    int: changed 1
    int: status 0
    while: changed != 0 && status = 0
        changed := 0
        plan := head[0]
        while: plan != 0 && changed = 0 && status = 0
            if: plan\leader = plan
                status := lmx_graph_merge_layout(g, plan)
                parts := (cast: (@@: void) c.calloc((cast: (size_t) plan\count) + 1U, sizeof(@: void)))
                if: parts = 0
                    status := 4
                i := 0U
                while: i < plan\width && changed = 0 && status = 0
                    part := lmx_graph_merge_field_value(g, (cast: (@: void) plan\first[i]))
                    if: c.lmx_graph_kind(g, part) = 4
                        count := 0U
                        k := 0U
                        while: k < plan\count
                            source := (cast: (@: c.Lmx) plan\sources[k])
                            j := lmx_graph_merge_source_slot(g, plan, i, source)
                            if: j < c.lmx_graph_count(source)
                                part := lmx_graph_merge_field_value(g, c.lmx_graph_get_in(g, source, j))
                                if: c.lmx_graph_kind(g, part) = 4
                                    parts[count] := part
                                    count := count + 1U
                                ---
                            ---
                            k := k + 1U
                        ---
                        if: count > 1U
                            status := lmx_graph_merge_group(groups, head, ordinal, parts, count, @ changed, @ joined)
                        ---
                    ---
                    i := i + 1U
                ---
                c.free((cast: (@: void) parts))
                parts := 0
            ---
            plan := (cast: (@: c.LmxGraphMergeLayout) plan\next)
        ---
    ---
    return: status
end: lmx_graph_merge_close

sub: lmx_graph_merge_layout_dispose (@: head c.LmxGraphMergeLayout)
    @: next c.LmxGraphMergeLayout 0
    while: head != 0
        next := (cast: (@: c.LmxGraphMergeLayout) head\next)
        c.free((cast: (@: void) head\sources))
        c.free((cast: (@: void) head\names))
        c.free((cast: (@: void) head\first))
        c.free((cast: (@: void) head\from_nodes))
        c.free((cast: (@: void) head\from_j))
        c.free((cast: (@: void) head\wrote))
        c.free((cast: (@: void) head))
        head := next
    ---
end: lmx_graph_merge_layout_dispose

fn: lmx_graph_merge_reserve (@: g c.LmxGraph; @: map c.LmxCopyMap; @: todo c.LmxCopyStack; @: source void; @@: out void) int
    int: status c.lmx_graph_copy_value_mapped_staged((cast: (@: c.LmxArena) g\arena), source, map, todo, out)
    if: status = c.LMX_GRAPH_COPY_OK
        return: 0
    if: status = c.LMX_GRAPH_COPY_NOMEM
        return: 4
    return: 5
end: lmx_graph_merge_reserve

fn: lmx_graph_merge_layout_index (@: plan c.LmxGraphMergeLayout; @: source c.Lmx; size_t: index; @: name char) size_t
    size_t: i 0U
    if: source = plan\sources[0]
        return: index
    if: name = 0
        return: (cast: (size_t) -1)
    while: i < plan\width && plan\names[i] != name
        i := i + 1U
    ---
    return: i
end: lmx_graph_merge_layout_index

# The first-map order is the receiving layout's depth-first order: finish
# this group's places and late aliases before visiting its child groups.
# All headers already exist; reference payloads remain deferred.
fn: lmx_graph_merge_seed_group (@: g c.LmxGraph; @: plan c.LmxGraphMergeLayout; @: map c.LmxCopyMap; @: receiving c.LmxCopyMap; @: prepared c.LmxCopyMap; @: todo c.LmxCopyStack) int
    @: child c.LmxGraphMergeLayout 0
    @: source c.Lmx 0
    @: result c.Lmx (cast: (@: c.Lmx) plan\target)
    @: first void 0
    @: copied void 0
    @: raw void 0
    @: raw_copy void 0
    @: field void 0
    @: place void 0
    @: source_slot void 0
    @: target_slot void 0
    @: source_pool c.LmxPool 0
    @: target_pool c.LmxPool 0
    @@: cells void 0
    size_t: i 0U
    size_t: j 0U
    size_t: k 0U
    int: kind 0
    int: target_kind 0
    int: status 0
    if: c.lmx_copy_map_get(prepared, (cast: (@: void) plan)) != 0
        return: 0
    if: c.lmx_copy_map_put(prepared, (cast: (@: void) plan), (cast: (@: void) plan)) != 0
        return: 4
    if: plan\width != 0U
        cells := (cast: (@@: void) c.calloc((cast: (size_t) plan\width), sizeof(@: void)))
        if: cells = 0
            return: 4
        i := 0U
        while: i < plan\width && status = 0
            source := (cast: (@: c.Lmx) plan\from_nodes[i])
            source_slot := c.lmx_graph_ref_cell_in(g\arena, source, (cast: (size_t) plan\from_j[i]))
            target_slot := c.lmx_copy_map_get(map, source_slot)
            if: source_slot = 0
                status := 5
            if: status = 0 && target_slot = 0
                target_slot := c.lmx_graph_ref_cell_in(g\arena, result, i)
                if: target_slot = 0 || c.lmx_copy_map_put(map, source_slot, target_slot) != 0
                    status := 4
                ---
            ---
            cells[i] := target_slot
            i := i + 1U
        ---
        if: status = 0 && c.lmx_graph_fields_bind((cast: (@: c.LmxArena) g\arena), result, cells) != 0
            status := 4
        c.free((cast: (@: void) cells))
        if: status != 0
            return: status
    ---
    k := 0U
    while: k < plan\count
        source := (cast: (@: c.Lmx) plan\sources[k])
        j := 0U
        while: j < c.lmx_graph_count(source)
            i := lmx_graph_merge_layout_index(plan, source, j, c.lmx_graph_slot_name(g, source, j))
            if: i >= plan\width
                return: 5
            source_slot := c.lmx_graph_ref_cell_in(g\arena, source, j)
            target_slot := c.lmx_graph_ref_cell_in(g\arena, result, i)
            if: source_slot = 0 || target_slot = 0
                return: 5
            if: c.lmx_copy_map_get(map, source_slot) = 0 && c.lmx_copy_map_put(map, source_slot, target_slot) != 0
                return: 4
            j := j + 1U
        ---
        k := k + 1U
    ---
    i := 0U
    while: i < plan\width
        first := (cast: (@: void) plan\first[i])
        kind := c.lmx_graph_kind(g, first)
        if: kind = 1 || kind = 2 || kind = 3 || kind = 6 || lmx_graph_scalar_pool(g, first) != 0
            if: kind = 3
                raw := c.lmx_arena_pointer_void_read(first)
                status := lmx_graph_merge_reserve(g, map, todo, raw, @ raw_copy)
                if: status != 0
                    return: status
                ---
            ---
            status := lmx_graph_merge_reserve(g, map, todo, first, @ copied)
            if: status != 0
                return: status
            if: kind = 3 && c.lmx_arena_pointer_void_write(copied, raw_copy) != 0
                return: 4
            if: c.lmx_graph_put_in(g, result, i, copied) != 0
                return: 4
        ---
        i := i + 1U
    ---
    k := 0U
    while: k < plan\count
        source := (cast: (@: c.Lmx) plan\sources[k])
        j := 0U
        while: j < c.lmx_graph_count(source)
            field := c.lmx_graph_get_in(g, source, j)
            i := lmx_graph_merge_layout_index(plan, source, j, c.lmx_graph_slot_name(g, source, j))
            place := c.lmx_graph_get_in(g, result, i)
            kind := c.lmx_graph_kind(g, field)
            target_kind := c.lmx_graph_kind(g, place)
            source_pool := lmx_graph_scalar_pool(g, field)
            target_pool := lmx_graph_scalar_pool(g, place)
            if: source_pool != 0 && target_pool != 0
                if: source_pool\scalar_abi != target_pool\scalar_abi
                    return: 4
                ---
                status := lmx_graph_merge_alias(g, map, field, place)
            else:
                if: ((kind = 1 || kind = 3) && (target_kind = 1 || target_kind = 3)) || (kind = 2 && target_kind = 2)
                    status := lmx_graph_merge_alias(g, map, field, place)
                if: kind = 6 && target_kind = 6
                    raw := c.lmx_graph_target(g, field)
                    first := c.lmx_graph_target(g, (cast: (@: void) plan\first[i]))
                    if: c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_kind(g, first) = 4
                        copied := c.lmx_copy_map_get(map, raw)
                        if: copied != 0 && copied = c.lmx_copy_map_get(map, first) && c.lmx_copy_map_get(receiving, copied) != 0
                            status := lmx_graph_merge_alias(g, map, field, place)
                        ---
                    ---
                ---
            ---
            if: status != 0
                return: status
            j := j + 1U
        ---
        k := k + 1U
    ---
    i := 0U
    while: i < plan\width
        raw := lmx_graph_merge_field_value(g, (cast: (@: void) plan\first[i]))
        copied := c.lmx_copy_map_get(map, raw)
        child := (cast: (@: c.LmxGraphMergeLayout) c.lmx_copy_map_get(receiving, copied))
        if: child != 0
            status := lmx_graph_merge_seed_group(g, child, map, receiving, prepared, todo)
            if: status != 0
                return: status
            ---
        ---
        i := i + 1U
    ---
    return: 0
end: lmx_graph_merge_seed_group

# Every receiving header is mapped before any Value edge is followed.
fn: lmx_graph_merge_seed (@: g c.LmxGraph; @: head c.LmxGraphMergeLayout; @: root c.LmxGraphMergeLayout; @: map c.LmxCopyMap; @: receiving c.LmxCopyMap; @: todo c.LmxCopyStack) int
    c.LmxCopyMap: prepared
    @: plan c.LmxGraphMergeLayout head
    @: result c.Lmx 0
    size_t: k 0U
    int: status 0
    while: plan != 0
        if: plan\leader = plan
            result := c.lmx_graph_lmx(g, 0, (cast: (size_t) plan\width))
            plan\target := result
            if: result = 0 || c.lmx_copy_map_put(receiving, (cast: (@: void) result), (cast: (@: void) plan)) != 0
                return: 4
            k := 0U
            while: k < plan\count
                if: c.lmx_copy_map_put(map, (cast: (@: void) plan\sources[k]), (cast: (@: void) result)) != 0
                    return: 4
                k := k + 1U
            ---
        ---
        plan := (cast: (@: c.LmxGraphMergeLayout) plan\next)
    ---
    c.memset((cast: (@: void) (@ prepared)), 0, c.sizeof(c.LmxCopyMap))
    if: c.lmx_copy_map_init(@ prepared) != 0
        return: 4
    status := lmx_graph_merge_seed_group(g, root, map, receiving, @ prepared, todo)
    plan := head
    while: plan != 0 && status = 0
        if: plan\leader = plan
            status := lmx_graph_merge_seed_group(g, plan, map, receiving, @ prepared, todo)
        plan := (cast: (@: c.LmxGraphMergeLayout) plan\next)
    ---
    c.lmx_copy_map_dispose(@ prepared)
    return: status
end: lmx_graph_merge_seed

fn: lmx_graph_merge_fill (@: g c.LmxGraph; @: head c.LmxGraphMergeLayout; @: map c.LmxCopyMap; @: todo c.LmxCopyStack) int
    @: plan c.LmxGraphMergeLayout head
    @: result c.Lmx 0
    @: copied void 0
    size_t: i 0U
    int: status 0
    while: plan != 0
        if: plan\leader = plan
            result := (cast: (@: c.Lmx) plan\target)
            i := 0U
            while: i < plan\width
                if: c.lmx_graph_get_in(g, result, i) = 0 && plan\first[i] != 0
                    status := lmx_graph_merge_reserve(g, map, todo, (cast: (@: void) plan\first[i]), @ copied)
                    if: status != 0
                        return: status
                    if: c.lmx_graph_put_in(g, result, i, copied) != 0
                        return: 4
                ---
                i := i + 1U
            ---
        ---
        plan := (cast: (@: c.LmxGraphMergeLayout) plan\next)
    ---
    return: 0
end: lmx_graph_merge_fill

# A cycle ends at the same ordered operand tuple on the CURRENT path. A
# sibling may replay that tuple again; Q,R,Q and M,N,M retain their writes.
fn: lmx_graph_merge_job_active (@: job c.LmxGraphMergeJob; @@: values void; size_t: n) int
    size_t: i 0U
    while: job != 0
        if: job\count = n
            i := 0U
            while: i < n && job\values[i] = values[i]
                i := i + 1U
            ---
            if: i = n
                return: 1
            ---
        ---
        job := (cast: (@: c.LmxGraphMergeJob) job\parent)
    ---
    return: 0
end: lmx_graph_merge_job_active

fn: lmx_graph_merge_replay (@: g c.LmxGraph; @: groups c.LmxCopyMap; @: map c.LmxCopyMap; @: todo c.LmxCopyStack; @: plan c.LmxGraphMergeLayout; @@: values void; size_t: n; @: parent c.LmxGraphMergeJob; int: force_model) int
    c.LmxGraphMergeJob: storage
    @: job c.LmxGraphMergeJob @ storage
    @: child c.LmxGraphMergeLayout 0
    @: operand c.Lmx 0
    @: result c.Lmx (cast: (@: c.Lmx) plan\target)
    @@: parts void 0
    @: first void 0
    @: part void 0
    @: held void 0
    @: copied void 0
    @: place void 0
    @: word void 0
    @: leaf_first void 0
    @: name char 0
    size_t: i 0U
    size_t: j 0U
    size_t: k 0U
    size_t: p 0U
    size_t: supplier 0U
    size_t: supplier_slot 0U
    int: status 0
    int: skip 0
    int: replay 0
    if: lmx_graph_merge_job_active(parent, values, n) != 0
        return: 0
    job\parent := parent
    job\values := values
    job\count := n
    parts := (cast: (@@: void) c.calloc(n + 1U, sizeof(@: void)))
    if: parts = 0
        return: 4
    # Parts before this job's own late scalar writes, as in merge_level.
    while: i < plan\width && status = 0
        first := lmx_graph_merge_field_value(g, (cast: (@: void) plan\first[i]))
        child := 0
        if: c.lmx_graph_kind(g, first) = 4
            child := lmx_graph_merge_leader((cast: (@: c.LmxGraphMergeLayout) c.lmx_copy_map_get(groups, first)))
        ---
        if: child != 0
            p := 0U
            k := 0U
            while: k < n && status = 0
                operand := (cast: (@: c.Lmx) values[k])
                j := lmx_graph_merge_source_slot(g, plan, i, operand)
                if: j < c.lmx_graph_count(operand)
                    part := lmx_graph_merge_field_value(g, c.lmx_graph_get_in(g, operand, j))
                    if: c.lmx_graph_kind(g, part) != 4
                        status := 5
                    else:
                        parts[p] := part
                        supplier := k
                        supplier_slot := j
                        p := p + 1U
                    ---
                ---
                k := k + 1U
            ---
            replay := 0
            if: p > 1U
                replay := 1
            if: p = 1U
                operand := (cast: (@: c.Lmx) values[supplier])
                if: (supplier != 0U || force_model != 0) && (operand != plan\from_nodes[i] || supplier_slot != plan\from_j[i] || plan\wrote[i] != 0)
                    replay := 1
                ---
            ---
            if: replay != 0 && status = 0
                status := lmx_graph_merge_replay(g, groups, map, todo, child, parts, p, job, (cast: (int) (p = 1U)))
                if: status = 0
                    plan\wrote[i] := 1
                ---
            ---
        ---
        i := i + 1U
    ---
    k := 0U
    while: k < n && status = 0
        operand := (cast: (@: c.Lmx) values[k])
        j := 0U
        while: j < c.lmx_graph_count(operand) && status = 0
            name := c.lmx_graph_slot_name(g, operand, j)
            i := lmx_graph_merge_layout_index(plan, operand, j, name)
            if: i >= plan\width
                status := 5
                break
            ---
            first := lmx_graph_merge_field_value(g, (cast: (@: void) plan\first[i]))
            held := c.lmx_graph_get_in(g, operand, j)
            part := lmx_graph_merge_field_value(g, held)
            skip := 0
            if: k = 0U && force_model = 0
                skip := 1
            if: operand = plan\from_nodes[i] && j = plan\from_j[i] && plan\wrote[i] = 0
                skip := 1
            if: c.lmx_graph_kind(g, first) = 4 && c.lmx_graph_kind(g, part) = 4
                if: c.lmx_copy_map_get(groups, first) != 0 || first = part
                    skip := 1
                ---
            ---
            if: skip = 0
                leaf_first := lmx_graph_receiving_leaf(g, (cast: (@: void) plan\first[i]))
                place := c.lmx_graph_get_in(g, result, i)
                if: leaf_first != (cast: (@: void) plan\first[i]) && c.lmx_graph_kind(g, leaf_first) != 4
                    status := lmx_graph_merge_reserve(g, map, todo, leaf_first, @ place)
                if: status = 0 && c.lmx_graph_kind(g, leaf_first) = 4 && c.lmx_graph_kind(g, first) != 4 && c.lmx_graph_kind(g, part) != 4
                    status := lmx_graph_merge_reserve(g, map, todo, held, @ copied)
                    if: status = 0 && c.lmx_graph_put_in(g, result, i, copied) != 0
                        status := 4
                    ---
                if: status = 0 && (c.lmx_graph_kind(g, leaf_first) != 4 || c.lmx_graph_kind(g, first) = 4 || c.lmx_graph_kind(g, part) = 4)
                    if: c.lmx_range_write_exact_blocked(g\arena, place, 0, 0, 0U) != 0
                        status := 4
                    else:
                        if: lmx_graph_scalar_pool(g, place) != 0
                            # Always read the original late source. Its map entry
                            # may already denote this receiving cell's old bits.
                            status := lmx_graph_scalar_store_cell(g, result, place, part)
                        else:
                            if: c.lmx_graph_kind(g, place) = 2 && c.lmx_graph_kind(g, part) = 2
                                if: c.lmx_graph_invalidate(g, result, 0, place, place) != 0 || c.lmx_charptr_store_known(place, c.lmx_graph_word_text(g, part)) != 0
                                    status := 4
                                ---
                            else:
                                status := lmx_graph_merge_write(g, result, place, part)
                            ---
                        ---
                    ---
                ---
                if: status = 0
                    plan\wrote[i] := 1
                ---
            ---
            j := j + 1U
        ---
        k := k + 1U
    ---
    c.free((cast: (@: void) parts))
    return: status
end: lmx_graph_merge_replay

# Receiving layouts already selected each field's physical provider. Late
# value writes do not replace that field's binding attribute.
fn: lmx_graph_merge_metadata (@: g c.LmxGraph; @: head c.LmxGraphMergeLayout) int
    c.LmxCopyMap: pending
    @: plan c.LmxGraphMergeLayout head
    @: source c.Lmx 0
    @: source_child void 0
    @: target_child void 0
    size_t: i 0U
    int: status 0
    c.memset((cast: (@: void) (@ pending)), 0, c.sizeof(c.LmxCopyMap))
    if: c.lmx_copy_map_init(@ pending) != 0
        return: 4
    while: plan != 0 && status = 0
        if: plan\leader = plan
            i := 0U
            while: i < plan\width && status = 0
                source := (cast: (@: c.Lmx) plan\from_nodes[i])
                source_child := c.lmx_graph_ref_cell_in(g\arena, source, (cast: (size_t) plan\from_j[i]))
                target_child := c.lmx_graph_ref_cell_in(g\arena, (cast: (@: c.Lmx) plan\target), i)
                if: c.lmx_graph_copy_place_metadata_mapped(g\arena, source_child, target_child, @ pending) != 0
                    status := 4
                i := i + 1U
            ---
        ---
        plan := (cast: (@: c.LmxGraphMergeLayout) plan\next)
    ---
    c.lmx_copy_names_finish(@ pending, (cast: (int) (status = 0)))
    return: status
end: lmx_graph_merge_metadata


# merge of evaluated operands (the book, composition; L2 §13; kernel §6.4). The result R has the layout of the model
# (operand 0), then the new fields in operand order; a named field of a later operand naming a slot of R is written into
# that slot by the admission of an assignment, any other is appended, so the model's field numbers do not move. One
# source -> copy map serves all operands: every operand root maps to R (the instance obtained by copying and
# composition), shared targets and cycles stay shared, the copies' name rows keep the canonical names, and a copied
# Structure's parent is the copy of its parent where that was copied. The order makes merged places one place: R's int
# places are copied first, then every later field naming one of them is that place in the map (lmx_graph_merge_alias),
# and only then are references, Structures and new fields copied, so a reference reaches R's place in any field order.
# A copy with written names or callables takes their needed lexical ancestors along, whole, through the same map up to
# parent 0, and R's parent is the copy of the model's parent; a copy without them resolves no name through a parent, so R
# has none (parent 0, which is no arena-root object). The place of execution never gives one. The operands stay
# unchanged. Corresponding Structure parts of the operands are composed recursively by the same rules and the same map
# (the receiving-group closure), whatever made the operands. 0 and R in out; 4 for an operand that is no Structure or a refused
# write; 5 for an open form.
fn: lmx_graph_merge_values (@: g c.LmxGraph; @@: values void; size_t: n; @@: out void) int
    c.LmxCopyMap: groups
    c.LmxCopyMap: map
    c.LmxCopyMap: receiving
    c.LmxCopyStack: todo
    @: head c.LmxGraphMergeLayout 0
    @: root c.LmxGraphMergeLayout 0
    @: plan c.LmxGraphMergeLayout 0
    @: model c.Lmx 0
    @: result c.Lmx 0
    @: copied void 0
    @: parent c.Lmx 0
    @: name char 0
    size_t: ordinal 0U
    size_t: name_count 0U
    size_t: i 0U
    int: changed 0
    int: chain 0
    int: status 0
    int: copied_status 0
    if: g = 0 || values = 0 || out = 0 || n = 0U
        return: 5
    out[0] := 0
    name_count := (cast: (size_t) g\names_len)
    c.memset((cast: (@: void) (@ groups)), 0, c.sizeof(c.LmxCopyMap))
    c.memset((cast: (@: void) (@ map)), 0, c.sizeof(c.LmxCopyMap))
    c.memset((cast: (@: void) (@ receiving)), 0, c.sizeof(c.LmxCopyMap))
    c.memset((cast: (@: void) (@ todo)), 0, c.sizeof(c.LmxCopyStack))
    while: i < n
        values[i] := c.lmx_graph_target(g, values[i])
        i := i + 1U
    ---
    status := lmx_graph_merge_check(g, values, n, @ chain)
    if: status != 0
        return: status
    if: c.lmx_copy_map_init(@ groups) != 0 || c.lmx_copy_map_init(@ map) != 0 || c.lmx_copy_map_init(@ receiving) != 0
        status := 4
    if: status = 0
        status := lmx_graph_merge_group(@ groups, @ head, @ ordinal, values, n, @ changed, @ root)
    if: status = 0
        status := lmx_graph_merge_close(g, @ groups, @ head, @ ordinal)
    if: status = 0
        root := lmx_graph_merge_leader(root)
        status := lmx_graph_merge_seed(g, head, root, @ map, @ receiving, @ todo)
    if: status = 0
        status := lmx_graph_merge_fill(g, head, @ map, @ todo)
    if: status = 0
        status := lmx_graph_merge_replay(g, @ groups, @ map, @ todo, root, values, n, 0, 0)
    # Receiving roots are not queued, so explicitly reserve the chosen
    # model's lexical chain. Other copies keep the common drain's rule.
    plan := head
    while: plan != 0 && status = 0
        if: plan\leader = plan && chain != 0
            model := (cast: (@: c.Lmx) plan\sources[0])
            if: model\parent != 0
                status := lmx_graph_merge_reserve(g, @ map, @ todo, (cast: (@: void) model\parent), @ copied)
            ---
        ---
        plan := (cast: (@: c.LmxGraphMergeLayout) plan\next)
    ---
    if: status = 0
        copied_status := c.lmx_graph_copy_drain_mapped(g\arena, @ map, @ todo, chain)
        if: copied_status != c.LMX_GRAPH_COPY_OK
            status := 5
            if: copied_status = c.LMX_GRAPH_COPY_NOMEM
                status := 4
            ---
        ---
    ---
    if: status = 0
        result := (cast: (@: c.Lmx) root\target)
        if: lmx_graph_copy_metadata(g, @ map, result, name_count, @ receiving) != 0
            status := 4
        ---
        if: status = 0
            status := lmx_graph_merge_metadata(g, head)
    ---
    plan := head
    while: plan != 0 && status = 0
        if: plan\leader = plan
            model := (cast: (@: c.Lmx) plan\sources[0])
            parent := 0
            if: chain != 0
                parent := (cast: (@: c.Lmx) c.lmx_copy_map_get(@ map, (cast: (@: void) model\parent)))
            ---
            if: parent != plan\target
                plan\target\parent := parent
            ---
            if: plan != root || n = 1U
                name := c.lmx_graph_name_of(g, (cast: (@: void) model))
                if: name != 0 && c.lmx_graph_name_address(g, (cast: (@: void) plan\target), name) != 0
                    status := 4
                ---
            ---
        ---
        plan := (cast: (@: c.LmxGraphMergeLayout) plan\next)
    ---
    c.lmx_copy_stack_dispose(@ todo)
    c.lmx_copy_map_dispose(@ receiving)
    c.lmx_copy_map_dispose(@ map)
    c.lmx_copy_map_dispose(@ groups)
    lmx_graph_merge_layout_dispose(head)
    if: status = 0
        out[0] := (cast: (@: void) result)
    return: status
end: lmx_graph_merge_values

# One operand of merge, evaluated once in its order: the constructed value of a written anonymous Structure, or any other
# expression in its general meaning -- a name, a path, a nested merge, a call (a head naming a callable is applied once,
# whatever slot the model has). The description of a structure by a bare Frame is open (5). 0 and the value in out.
fn: lmx_graph_merge_operand (@: g c.LmxGraph; @: scope c.Lmx; @: raw void; @@: out void) int
    @: literal c.Lmx 0
    @: made void 0
    @: name char 0
    @: written void 0
    @: value void 0
    size_t: i 0U
    int: form 0
    int: status 0
    out[0] := 0
    if: lmx_graph_merge_literal(g, scope, raw) != 0
        literal := (cast: (@: c.Lmx) raw)
        status := lmx_graph_merge_literal_open(g, scope, literal, @ made)
        while: status = 0 && i < c.lmx_graph_count(literal)
            form := lmx_graph_literal_field(g, c.lmx_graph_get_in(g, literal, i), @ name, @ written)
            value := 0
            if: written != 0
                status := lmx_graph_eval_value(g, scope, written, @ value)
            ---
            if: status = 0
                status := lmx_graph_merge_literal_put(g, literal, (cast: (@: c.Lmx) made), i, value)
            ---
            i := i + 1U
        ---
        if: status = 0
            out[0] := made
        ---
        return: status
    if: lmx_graph_merge_description(g, scope, raw) != 0
        return: 5
    return: lmx_graph_eval_value(g, scope, raw, out)
end: lmx_graph_merge_operand

# merge(operand; ...): the operands once, left to right, then their composition. The operand array is this evaluation's.
fn: lmx_graph_eval_merge (@: g c.LmxGraph; @: scope c.Lmx; @: expression c.Lmx; @@: out void) int
    @@: values void 0
    size_t: n 0U
    size_t: i 0U
    int: status 0
    if: g = 0 || out = 0 || c.lmx_graph_count(expression) < 1U
        return: 5
    n := c.lmx_graph_count(expression)
    values := (cast: (@@: void) c.calloc(n + 1U, sizeof(@: void)))
    if: values = 0
        return: 4
    while: i < n && status = 0
        status := lmx_graph_merge_operand(g, scope, c.lmx_graph_get_in(g, expression, i), @ values[i])
        i := i + 1U
    ---
    if: status = 0
        status := lmx_graph_merge_values(g, values, n, out)
    c.free((cast: (@: void) values))
    return: status
end: lmx_graph_eval_merge

# For the body scan: the written fields of an anonymous Structure operand of merge define their names, never free inputs
# of the body. Initializer expressions use their caller's lexical context.
fn: lmx_graph_work_scan_literal (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: literal c.Lmx; int: optional) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: name char 0
    @: written void 0
    @: word char 0
    @: row c.LmxGraphWork 0
    size_t: i 0U
    int: form 0
    int: status 0
    int: context 1
    if: optional != 0
        context := 2
    while: i < c.lmx_graph_count(literal) && status = 0
        form := lmx_graph_literal_field(g, c.lmx_graph_get_in(g, literal, i), @ name, @ written)
        if: c.lmx_graph_kind(g, written) = 4
            status := lmx_graph_work_scan_context(g, frame, (cast: (@: c.Lmx) written), context)
        else:
            word := c.lmx_graph_word_text(g, written)
            if: word != 0 && lmx_graph_language_word(state, word) = 0
                status := lmx_graph_work_capture_context(g, frame, word, optional)
                row := lmx_graph_work_row(g, frame, word)
                if: optional = 0 && status = 0 && row != 0 && row\slot != (cast: (size_t) -1)
                    row\loaded := row\loaded | 2
                ---
            ---
        ---
        i := i + 1U
    ---
    return: status
end: lmx_graph_work_scan_literal

# ---- The receivers fn and sub in a traversal (§3.4, §5.2; the author 2026-11-09) ---------------------------------
# The graph keeps a declaration `fn: name args return [data] code` as written: the Frame of the receiver fn, an Lmx named
# fn with its arguments. Each traversal -- the interpreter's run, a translation, a native run of an emitted program --
# begins with an empty namespace (lmx_graph_space_push) and applies the receiver: the Structure named by the value of
# the name argument with unified data, return and code (sub: data and code) is created in this traversal and
# answers its name in the declaration's block. The namespace and its rows are freed at the end of the traversal, and the
# next traversal creates its own Structure from the written declaration; a Structure the program holds by an ordinary
# reference of the graph stays an ordinary live value (§5.2).

# The slot of lmx holding the place named name -- an int place, a place without a value, a reference place (a Frame
# named by its head is no place) --, or the count of its slots when none is.
fn: lmx_graph_place_slot (@: g c.LmxGraph; @: lmx c.Lmx; @: name char) size_t
    size_t: n c.lmx_graph_count(lmx)
    size_t: i 0U
    int: kind 0
    if: g = 0 || name = 0
        return: n
    while: i < n
        kind := c.lmx_graph_kind(g, c.lmx_graph_get_in(g, lmx, i))
        if: (kind = 1 || kind = 3 || kind = 5 || kind = 6 || kind = 8 || kind = 9) && c.lmx_graph_slot_name(g, lmx, i) = name
            return: i
        i := i + 1U
    ---
    return: n
end: lmx_graph_place_slot

# The same declaration descriptions provide both own names and physical types.
fn: lmx_graph_own_name (@: g c.LmxGraph; @: value void) @: char
    int: place 0
return: lmx_graph_binding_name(g, 0, value, 0, @ place)

fn: lmx_graph_own_kind (@: g c.LmxGraph; @: value void) int
    int: kind c.lmx_graph_kind(g, value)
    value := c.lmx_graph_binding_leaf(g, value)
    kind := c.lmx_graph_kind(g, value)
    if: kind = 3 || kind = 8 || kind = 9
        return: c.lmx_graph_kind(g, c.lmx_arena_pointer_void_read(value))
    if: kind != 4
        return: kind
    # Zero means an unsupported declaration, not a different physical type.
    # In particular @:p int has kind5 without a candidate; construction of its
    # real uninit:T storage remains open and must never masquerade as kind6.
return: lmx_graph_deferred_kind(g, value)

# The receiving root already has its own name, parent and final width. Other
# copied headers keep only mapped parents, as the previous fn_data copier did.
# Name projection happens after the shared value queue has succeeded.
fn: lmx_graph_copy_metadata (@: g c.LmxGraph; @: map c.LmxCopyMap; @: receiving c.Lmx; size_t: name_count; @: receiving_roots c.LmxCopyMap) int
    @: key_view c.VoidArray (cast: (@: c.VoidArray) (@ map\keys))
    @@: keys void (cast: (@@: void) key_view\data)
    @: source void 0
    @: target void 0
    @: source_node c.Lmx 0
    @: target_node c.Lmx 0
    @: canon char 0
    @: row c.LmxName 0
    c.LmxCopyMap: pending_names
    @: source_child void 0
    @: target_child void 0
    size_t: count (cast: (size_t) key_view\size)
    size_t: i 0U
    size_t: j 0U
    int: kind 0
    int: selected 0
    int: status 0
    c.memset((cast: (@: void) (@ pending_names)), 0, c.sizeof(c.LmxCopyMap))
    if: c.lmx_copy_map_init(@ pending_names) != 0
        return: 1
    while: i < count
        source := keys[i]
        target := c.lmx_copy_map_get(map, source)
        selected := 0
        if: receiving_roots != 0 && c.lmx_copy_map_get(receiving_roots, target) != 0
            selected := 1
        if: source != 0 && target != 0 && target != source
            kind := c.lmx_range_classify(g\arena, source)
            if: kind = c.LMX_KIND_STRUCT || kind = c.LMX_KIND_ARRAY
                source_node := (cast: (@: c.Lmx) source)
                target_node := (cast: (@: c.Lmx) target)
                if: target_node != receiving && selected = 0
                    target_node\parent := (cast: (@: c.Lmx) c.lmx_copy_map_get(map, (cast: (@: void) source_node\parent)))
                    if: target_node\parent = 0 && (map\value_policy & 8) != 0
                        target_node\parent := source_node\parent
            ---
        ---
        i := i + 1U
    ---
    i := 0U
    while: i < name_count
        # name_address may grow/reallocate the table; keep only copied fields.
        row := g\names + i
        source := row\address
        canon := row\name
        target := c.lmx_copy_map_get(map, source)
        selected := 0
        if: receiving_roots != 0 && c.lmx_copy_map_get(receiving_roots, target) != 0
            selected := 1
        if: target != 0 && target != source && target != (cast: (@: void) receiving) && selected = 0
            if: c.lmx_graph_name_address(g, target, canon) != 0
                c.lmx_copy_names_finish(@ pending_names, 0)
                return: 1
            ---
        ---
        i := i + 1U
    ---
    i := 0U
    while: i < count && status = 0
        source := keys[i]
        target := c.lmx_copy_map_get(map, source)
        selected := 0
        if: receiving_roots != 0 && c.lmx_copy_map_get(receiving_roots, target) != 0
            selected := 1
        if: source != 0 && target != 0 && target != source && selected = 0
            kind := c.lmx_range_classify(g\arena, source)
            if: kind = c.LMX_KIND_STRUCT || kind = c.LMX_KIND_ARRAY
                source_node := (cast: (@: c.Lmx) source)
                j := 0U
                while: j < c.lmx_graph_count(source_node) && status = 0
                    source_child := c.lmx_graph_ref_cell_in(g\arena, source_node, j)
                    target_child := c.lmx_copy_map_get(map, source_child)
                    # A receiving projection may reorder/concatenate fields.
                    # Only its seeded exact CHILDREN correspondence is valid.
                    if: source_child != 0 && target_child != 0 && source_child != target_child
                        status := c.lmx_graph_copy_place_metadata_mapped(g\arena, source_child, target_child, @ pending_names)
                    j := j + 1U
                ---
            ---
        ---
        i := i + 1U
    ---
    c.lmx_copy_names_finish(@ pending_names, (cast: (int) (status = 0)))
    return: (cast: (int) (status != 0))
end: lmx_graph_copy_metadata

# One DATA contains the header declarations followed by the written DATA fields, including physical repeats.
# Both roots and all of their physical CHILDREN places are seeded before the common copier follows any Value edge.
# The shared map preserves aliases, self references and Model; CODE contributes no fields and no initializer runs here.
# 0 and the clean DATA in out; 1 without memory; 5 for an invalid or unsupported source.
fn: lmx_graph_fn_data (@: g c.LmxGraph; @: owner c.Lmx; @: args c.Lmx; @: written c.Lmx; @@: out c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    c.LmxCopyMap: map
    c.LmxCopyStack: todo
    @@: cells void 0
    @: vars c.Lmx 0
    @: source c.Lmx 0
    @: source_value void 0
    @: source_slot void 0
    @: target_slot void 0
    @: copy void 0
    size_t: header_count 0U
    size_t: written_count 0U
    size_t: total 0U
    size_t: offset 0U
    size_t: width 0U
    size_t: name_count 0U
    size_t: i 0U
    int: pass 0
    int: status 0
    int: mapped 0
    int: chain 0
    int: source_chain 0
    int: copied_status 0
    if: out = 0
        return: 5
    out[0] := 0
    if: g = 0 || state = 0 || (args != 0 && c.lmx_graph_kind(g, (cast: (@: void) args)) != 4) || (written != 0 && c.lmx_graph_kind(g, (cast: (@: void) written)) != 4)
        return: 5
    if: args != 0
        header_count := c.lmx_graph_count(args)
    if: written != 0
        written_count := c.lmx_graph_count(written)
    if: header_count > (cast: (size_t) -1) - written_count
        return: 1
    total := header_count + written_count
    if: total > (cast: (size_t) -1) / sizeof(@: void)
        return: 1
    name_count := (cast: (size_t) g\names_len)
    c.memset((cast: (@: void) (@ todo)), 0, c.sizeof(c.LmxCopyStack))
    # Qualification discovery borrows the sources; it executes no declaration.
    while: pass < 2 && status = 0
        source := args
        if: pass = 1
            source := written
        if: source != 0
            source_value := (cast: (@: void) source)
            if: status = 0
                status := lmx_graph_merge_check(g, @ source_value, 1U, @ source_chain)
            if: status = 4
                status := 1
            chain := chain | source_chain
        ---
        pass := pass + 1
    ---
    if: status = 0
        vars := c.lmx_graph_lmx(g, owner, total)
        if: vars = 0 || c.lmx_graph_name_address(g, (cast: (@: void) vars), state\w_data) != 0
            status := 1
        ---
    ---
    if: status = 0
        if: c.lmx_copy_map_init(@ map) != 0
            status := 1
        else:
            mapped := 1
            if: args != 0 && c.lmx_copy_map_put(@ map, (cast: (@: void) args), (cast: (@: void) vars)) != 0
                status := 1
            if: status = 0 && written != 0 && c.lmx_copy_map_put(@ map, (cast: (@: void) written), (cast: (@: void) vars)) != 0
                status := 1
            ---
        ---
    ---
    if: status = 0 && total != 0U
        cells := (cast: (@@: void) c.calloc(total, sizeof(@: void)))
        if: cells = 0
            status := 1
        pass := 0
        while: pass < 2 && status = 0
            source := args
            width := header_count
            offset := 0U
            if: pass = 1
                source := written
                width := written_count
                offset := header_count
            ---
            i := 0U
            while: i < width && status = 0
                source_slot := c.lmx_graph_ref_cell_in(g\arena, source, i)
                if: source_slot = 0
                    status := 5
                else:
                    target_slot := c.lmx_copy_map_get(@ map, source_slot)
                    if: target_slot = 0
                        target_slot := c.lmx_graph_ref_cell_in(g\arena, vars, offset + i)
                        if: target_slot = 0 || c.lmx_copy_map_put(@ map, source_slot, target_slot) != 0
                            status := 1
                        ---
                    ---
                    cells[offset + i] := target_slot
                ---
                i := i + 1U
            ---
            pass := pass + 1
        ---
        if: status = 0 && c.lmx_graph_fields_bind((cast: (@: c.LmxArena) g\arena), vars, cells) != 0
            status := 1
        c.free((cast: (@: void) cells))
        cells := 0
    ---
    pass := 0
    while: pass < 2 && status = 0
        source := args
        width := header_count
        offset := 0U
        if: pass = 1
            source := written
            width := written_count
            offset := header_count
        ---
        i := 0U
        while: i < width && status = 0
            copied_status := c.lmx_graph_copy_value_mapped_staged((cast: (@: c.LmxArena) g\arena), c.lmx_graph_get_in(g, source, i), @ map, @ todo, @ copy)
            if: copied_status != c.LMX_GRAPH_COPY_OK
                status := 5
                if: copied_status = c.LMX_GRAPH_COPY_NOMEM
                    status := 1
                ---
            ---
            if: status = 0 && c.lmx_graph_put_in(g, vars, offset + i, copy) != 0
                status := 1
            i := i + 1U
        ---
        pass := pass + 1
    ---
    if: status = 0 && mapped != 0
        copied_status := c.lmx_graph_copy_drain_mapped(g\arena, @ map, @ todo, chain)
        if: copied_status != c.LMX_GRAPH_COPY_OK
            status := 5
            if: copied_status = c.LMX_GRAPH_COPY_NOMEM
                status := 1
            ---
        ---
        if: status = 0
            status := lmx_graph_copy_metadata(g, @ map, vars, name_count, 0)
        ---
    ---
    c.lmx_copy_stack_dispose(@ todo)
    if: mapped != 0
        c.lmx_copy_map_dispose(@ map)
    if: status = 0
        out[0] := vars
    return: status
end: lmx_graph_fn_data

# The Structure the receiver fn or sub creates from its arguments (the author 2026-11-09: in the namespace of the
# traversal the structure name(args(), return(), data(), code()), by the rule by which `int: i 5` creates i): an Lmx of
# the FN pool role (§2.2 lmx:result) under the declaration, named by the value of the name argument, with the fields
# data, return (fn) and optional code. A Structure part is a reference to that argument, named by the
# part -- the argument keeps its address, parent and namelessness (the reference's name is the reference's); the word of
# a result requirement is its own word cell, as every primitive place has its own cell; data is lmx_graph_fn_data. The
# native entry a translation installed on the declaration is the entry of what it creates (no other native code
# exists: the Structures a running program creates otherwise are interpreted). 0 and the Structure in out; 1 without
# memory; 5 for an argument of another kind.
fn: lmx_graph_fn_make (@: g c.LmxGraph; @: decl c.Lmx; @: name char; @: args c.Lmx; @: result void; @: written c.Lmx; @: body c.Lmx; int: with_result; @@: out c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: made c.Lmx 0
    @: vars c.Lmx 0
    @: part void 0
    size_t: count 1U
    size_t: at 0U
    int: status 0
    out[0] := 0
    if: g = 0 || state = 0 || decl = 0 || name = 0 || (args != 0 && c.lmx_graph_kind(g, (cast: (@: void) args)) != 4)
        return: 5
    if: (body != 0 && c.lmx_graph_kind(g, (cast: (@: void) body)) != 4) || (written != 0 && c.lmx_graph_kind(g, (cast: (@: void) written)) != 4)
        return: 5
    # Validate user args before allocating F or constructing its data. The receiver catalog's pseudoformals and
    # generic data-field name projections remain unchanged; defaults and model contents are not executed here.
    while: at < c.lmx_graph_count(args)
        @: formal_name char c.lmx_graph_declaration_name(g, c.lmx_graph_get_in(g, args, at))
        if: formal_name = 0 || formal_name = state\w_node
            return: 5
        at := at + 1U
    ---
    at := 0U
    if: with_result != 0
        count := count + 1U
        if: c.lmx_graph_kind(g, result) != 2 && c.lmx_graph_kind(g, result) != 4
            return: 5
        ---
    ---
    if: body != 0
        count := count + 1U
    made := (cast: (@: c.Lmx) c.lmx_struct_new_role_profiled(decl, g\arena, 0, c.LMX_POOL_ROLE_FN))
    if: made = 0 || c.lmx_arena_refs_open_owned(g\arena, made, count) != 0 || c.lmx_graph_name_address(g, (cast: (@: void) made), name) != 0
        return: 1
    status := lmx_graph_fn_data(g, made, args, written, @ vars)
    if: status != 0
        return: status
    if: c.lmx_graph_put_in(g, made, at, (cast: (@: void) vars)) != 0
        return: 1
    at := at + 1U
    if: with_result != 0
        if: c.lmx_graph_kind(g, result) = 2
            part := c.lmx_graph_word_of(g, c.lmx_graph_word_text(g, result))
        else:
            part := c.lmx_graph_ref_lmx(g, (cast: (@: c.Lmx) result))
        ---
        if: part = 0 || c.lmx_graph_name_address(g, part, state\w_return) != 0 || c.lmx_graph_put_in(g, made, at, part) != 0
            return: 1
        at := at + 1U
    ---
    if: body != 0
        part := c.lmx_graph_ref_lmx(g, body)
        if: part = 0 || c.lmx_graph_name_address(g, part, state\w_code) != 0 || c.lmx_graph_put_in(g, made, at, part) != 0
            return: 1
        ---
    ---
    made\native := decl\native
    out[0] := made
    return: 0
end: lmx_graph_fn_make

# One form of a receiver: an Lmx named by the receiver whose fields are its formals in order (lmx_graph_receivers_open).
# Formal i is a word cell -- an argument taken as written -- when bit i of words is set, otherwise an empty Lmx -- a
# Structure; each is named by its name. 0, or 1 without memory.
fn: lmx_graph_receiver_form (@: g c.LmxGraph; @: list c.Lmx; size_t: at; @: head char; size_t: n; @: f0 char; @: f1 char; @: f2 char; @: f3 char; @: f4 char; int: words) int
    @: form c.Lmx c.lmx_graph_lmx(g, list, n)
    @: formal void 0
    @: name char 0
    size_t: i 0U
    int: bit 1
    if: form = 0 || c.lmx_graph_name_address(g, (cast: (@: void) form), head) != 0
        return: 1
    while: i < n
        name := f0
        if: i = 1U
            name := f1
        if: i = 2U
            name := f2
        if: i = 3U
            name := f3
        if: i = 4U
            name := f4
        if: (words / bit) % 2 = 1
            formal := c.lmx_graph_word_of(g, name)
        else:
            formal := (cast: (@: void) c.lmx_graph_lmx(g, form, 0U))
        ---
        if: name = 0 || formal = 0 || c.lmx_graph_name_address(g, formal, name) != 0 || c.lmx_graph_put_in(g, form, i, formal) != 0
            return: 1
        bit := bit * 2
        i := i + 1U
    ---
    if: c.lmx_graph_put_in(g, list, at, (cast: (@: void) form)) != 0
        return: 1
    return: 0
end: lmx_graph_receiver_form

# The contracts of the receivers fn and sub (Codex 0605/0615, c5: ordinary signatures the one binder takes from the
# initial filling of the namespace of the traversal): the forms of a receiver are the fields of one Lmx registered under
# its canonical name in the root's block -- fn [name, args, return, data, code], [name, args, return, code], [name, args,
# return], [name, parts]; sub [name, args, data, code], [name, args, code], [name, parts] (receivers with different numbers
# of arguments share one name). name and the result requirement return are taken as written (word cells: a word, or a
# written form such as the type `@: c.FILE`), the other formals are Structures (empty Lmx). The receivers of a launch
# have contracts of the same kind, bound by the same binder (the author 2026-11-11: the arguments of every receiver are
# named and given by position or by name, LMX_blog/2026-11-11.md#structure-call-by-name; R22): call [code], [data, code],
# [args, data, code]; fncall [return, code], [data, return, code], [args, data, return, code], return taken as written;
# and the record that launches an ordinary Structure by name, which is no receiver and has one argument, data: [],
# [data] -- registered under `()`, the mark of an application, which spells no name (lmx_graph_launch_formals). Made for
# every traversal, released with its tables. 0, or 1 without memory.
fn: lmx_graph_receivers_open (@: g c.LmxGraph; @: root c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: w_name char c.lmx_graph_intern("name", 4U)
    @: w_parts char c.lmx_graph_intern("parts", 5U)
    @: w_launch char c.lmx_graph_intern("()", 2U)
    @: w_fn char 0
    @: w_sub char 0
    @: w_args char 0
    @: w_return char 0
    @: w_data char 0
    @: w_code char 0
    @: w_call char 0
    @: w_fncall char 0
    @: fns c.Lmx 0
    @: subs c.Lmx 0
    @: calls c.Lmx 0
    @: fncalls c.Lmx 0
    @: launches c.Lmx 0
    int: status 0
    if: g = 0 || state = 0 || root = 0 || w_name = 0 || w_parts = 0 || w_launch = 0
        return: 1
    w_fn := state\w_fn
    w_sub := state\w_sub
    w_args := state\w_args
    w_return := state\w_return
    w_data := state\w_data
    w_code := state\w_code
    w_call := state\w_call
    w_fncall := state\w_fncall
    fns := c.lmx_graph_lmx(g, 0, 4U)
    subs := c.lmx_graph_lmx(g, 0, 3U)
    calls := c.lmx_graph_lmx(g, 0, 3U)
    fncalls := c.lmx_graph_lmx(g, 0, 3U)
    launches := c.lmx_graph_lmx(g, 0, 2U)
    if: fns = 0 || subs = 0 || calls = 0 || fncalls = 0 || launches = 0
        return: 1
    status := lmx_graph_receiver_form(g, fns, 0U, w_fn, 5U, w_name, w_args, w_return, w_data, w_code, 5)
    if: status = 0
        status := lmx_graph_receiver_form(g, fns, 1U, w_fn, 4U, w_name, w_args, w_return, w_code, 0, 5)
    if: status = 0
        status := lmx_graph_receiver_form(g, fns, 2U, w_fn, 3U, w_name, w_args, w_return, 0, 0, 5)
    if: status = 0
        status := lmx_graph_receiver_form(g, fns, 3U, w_fn, 2U, w_name, w_parts, 0, 0, 0, 1)
    if: status = 0
        status := lmx_graph_receiver_form(g, subs, 0U, w_sub, 4U, w_name, w_args, w_data, w_code, 0, 1)
    if: status = 0
        status := lmx_graph_receiver_form(g, subs, 1U, w_sub, 3U, w_name, w_args, w_code, 0, 0, 1)
    if: status = 0
        status := lmx_graph_receiver_form(g, subs, 2U, w_sub, 2U, w_name, w_parts, 0, 0, 0, 1)
    if: status = 0
        status := lmx_graph_receiver_form(g, calls, 0U, w_call, 1U, w_code, 0, 0, 0, 0, 0)
    if: status = 0
        status := lmx_graph_receiver_form(g, calls, 1U, w_call, 2U, w_data, w_code, 0, 0, 0, 0)
    if: status = 0
        status := lmx_graph_receiver_form(g, calls, 2U, w_call, 3U, w_args, w_data, w_code, 0, 0, 0)
    if: status = 0
        status := lmx_graph_receiver_form(g, fncalls, 0U, w_fncall, 2U, w_return, w_code, 0, 0, 0, 1)
    if: status = 0
        status := lmx_graph_receiver_form(g, fncalls, 1U, w_fncall, 3U, w_data, w_return, w_code, 0, 0, 2)
    if: status = 0
        status := lmx_graph_receiver_form(g, fncalls, 2U, w_fncall, 4U, w_args, w_data, w_return, w_code, 0, 4)
    if: status = 0
        status := lmx_graph_receiver_form(g, launches, 0U, w_launch, 0U, 0, 0, 0, 0, 0, 0)
    if: status = 0
        status := lmx_graph_receiver_form(g, launches, 1U, w_launch, 1U, w_data, 0, 0, 0, 0, 0)
    if: status = 0 && (c.lmx_graph_space_put(root, w_fn, (cast: (@: void) fns)) != 0 || c.lmx_graph_space_put(root, w_sub, (cast: (@: void) subs)) != 0)
        status := 1
    if: status = 0 && (c.lmx_graph_space_put(root, w_call, (cast: (@: void) calls)) != 0 || c.lmx_graph_space_put(root, w_fncall, (cast: (@: void) fncalls)) != 0 || c.lmx_graph_space_put(root, w_launch, (cast: (@: void) launches)) != 0)
        status := 1
    return: status
end: lmx_graph_receivers_open

# Is the written value an application the traversal evaluates -- merge, or a Frame whose head answers a callable in
# scope (the one model of a Frame, as at the root)? Any other written value -- a word, an int, an anonymous Structure, a
# Frame applying nothing (a block, a type form `@: T`) -- is what is written. 1 or 0.
fn: lmx_graph_applies (@: g c.LmxGraph; @: scope c.Lmx; @: value void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: head char 0
    if: state = 0 || c.lmx_graph_kind(g, value) != 4
        return: 0
    head := c.lmx_graph_name_of(g, value)
    if: head = 0
        return: c.lmx_graph_application_parts(g, value, 0, 0, 0)
    if: head = state\w_merge || c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_target(g, lmx_graph_resolve(g, scope, head)))) != 0
        return: 1
    return: 0
end: lmx_graph_applies

# The value of the hexadecimal digit ch, or -1 for no hexadecimal digit.
fn: lmx_graph_hex_digit (int: ch) int
    if: ch >= 48 && ch <= 57
        return: ch - 48
    if: ch >= 97 && ch <= 102
        return: ch - 87
    if: ch >= 65 && ch <= 70
        return: ch - 55
    return: -1
end: lmx_graph_hex_digit

# The value of an ordinary string literal a word primitive holds (the grammar §6, by the rules of C99): the bytes
# between its quotes with each escape decoded -- the simple escapes, up to three octal digits, `\x` with the
# hexadecimal digits after it, `\u` and `\U` as the UTF-8 of the character, a backslash before a line break joining the
# lines --, as a canonical spelling (§4). 0 for a word that is no ordinary string literal (an identifier, a wide or a
# character literal), a malformed literal, a value holding a zero byte (no canonical spelling is a C string with one),
# or without memory.
fn: lmx_graph_string_value (@: g c.LmxGraph; @: value void) @: char
    @: text char c.lmx_graph_word_text(g, value)
    @: buf char 0
    @: canon char 0
    size_t: n 0U
    size_t: i 1U
    size_t: o 0U
    size_t: k 0U
    size_t: width 0U
    int: ch 0
    int: d 0
    int: code 0
    int: bad 0
    if: text = 0
        return: 0
    while: text[n] != (cast: (char) 0)
        n := n + 1U
    ---
    if: n < 2U || text[0] != (cast: (char) 34) || text[n - 1U] != (cast: (char) 34)
        return: 0
    buf := (cast: (@: char) c.calloc(n + 1U, sizeof(char)))
    if: buf = 0
        return: 0
    while: i < n - 1U && bad = 0
        ch := (cast: (int) text[i])
        i := i + 1U
        if: ch != 92
            # An unescaped quote or line break inside the literal is malformed.
            if: ch = 34 || ch = 10
                bad := 1
            buf[o] := (cast: (char) ch)
            o := o + 1U
            continue
        if: i >= n - 1U
            bad := 1
            continue
        ch := (cast: (int) text[i])
        i := i + 1U
        code := -1
        if: ch = 10
            continue
        if: ch = 13
            if: i < n - 1U && text[i] = (cast: (char) 10)
                i := i + 1U
            continue
        if: ch = 39 || ch = 34 || ch = 63 || ch = 92
            code := ch
        if: ch = 97
            code := 7
        if: ch = 98
            code := 8
        if: ch = 102
            code := 12
        if: ch = 110
            code := 10
        if: ch = 114
            code := 13
        if: ch = 116
            code := 9
        if: ch = 118
            code := 11
        # Up to three octal digits.
        if: ch >= 48 && ch <= 55
            code := ch - 48
            k := 1U
            while: k < 3U && i < n - 1U && text[i] >= (cast: (char) 48) && text[i] <= (cast: (char) 55)
                code := code * 8 + ((cast: (int) text[i]) - 48)
                i := i + 1U
                k := k + 1U
            ---
            if: code > 255
                bad := 1
        ---
        # `\x` and every hexadecimal digit after it.
        if: ch = 120
            code := 0
            k := 0U
            while: i < n - 1U && lmx_graph_hex_digit((cast: (int) text[i])) >= 0 && bad = 0
                code := code * 16 + lmx_graph_hex_digit((cast: (int) text[i]))
                if: code > 255
                    bad := 1
                i := i + 1U
                k := k + 1U
            ---
            if: k = 0U
                bad := 1
        ---
        # `\u` with four hexadecimal digits, `\U` with eight: the character's UTF-8.
        if: ch = 117 || ch = 85
            width := 4U
            if: ch = 85
                width := 8U
            code := 0
            k := 0U
            while: k < width && bad = 0
                d := -1
                if: i < n - 1U
                    d := lmx_graph_hex_digit((cast: (int) text[i]))
                if: d < 0 || code > 69631
                    bad := 1
                else:
                    code := code * 16 + d
                    i := i + 1U
                ---
                k := k + 1U
            ---
            if: bad = 0 && (code > 1114111 || (code >= 55296 && code <= 57343))
                bad := 1
            if: bad = 0
                if: code < 128
                    buf[o] := (cast: (char) code)
                    o := o + 1U
                else:
                    if: code < 2048
                        buf[o] := (cast: (char) (192 + code / 64))
                        buf[o + 1U] := (cast: (char) (128 + code % 64))
                        o := o + 2U
                    else:
                        if: code < 65536
                            buf[o] := (cast: (char) (224 + code / 4096))
                            buf[o + 1U] := (cast: (char) (128 + (code / 64) % 64))
                            buf[o + 2U] := (cast: (char) (128 + code % 64))
                            o := o + 3U
                        else:
                            buf[o] := (cast: (char) (240 + code / 262144))
                            buf[o + 1U] := (cast: (char) (128 + (code / 4096) % 64))
                            buf[o + 2U] := (cast: (char) (128 + (code / 64) % 64))
                            buf[o + 3U] := (cast: (char) (128 + code % 64))
                            o := o + 4U
                        ---
                    ---
                ---
                if: code = 0
                    bad := 1
            ---
            continue
        ---
        if: code < 0
            bad := 1
        if: code = 0
            bad := 1
        if: bad = 0
            buf[o] := (cast: (char) code)
            o := o + 1U
        ---
    ---
    if: bad = 0
        canon := c.lmx_graph_intern((cast: (@: char) buf), o)
    c.free((cast: (@: void) buf))
    return: canon
end: lmx_graph_string_value

# A word description reads anonymous grouping without resolving or applying the
# written value. A numeric field stays a Structure; empty and multiple fields,
# and every named form, keep their own description. The borrowed address is
# shared by receiver contracts and explicit launch descriptions, never stored
# back in the source graph.
fn: lmx_graph_description_value (@: g c.LmxGraph; @: value void) @: void
    @: child void 0
    int: kind 0
    while: c.lmx_graph_kind(g, value) = 4 && c.lmx_graph_name_of(g, value) = 0 && c.lmx_graph_count((cast: (@: c.Lmx) value)) = 1U
        child := c.lmx_graph_get_in(g, (cast: (@: c.Lmx) value), 0U)
        kind := c.lmx_graph_kind(g, child)
        if: kind != 2 && kind != 4
            break
        value := child
return: value

# The name a written value gives a part name of a receiver -- the contract of a name, one for every receiver (the
# author 2026-11-09: `fn: name := "test"; ...` creates test): an identifier word its own spelling, an ordinary string
# literal its value (lmx_graph_string_value), the quotes being no part of it; 0 for any other value -- a word holding a
# quote (a malformed, wide or character literal), an int, a Structure.
fn: lmx_graph_name_value (@: g c.LmxGraph; @: value void) @: char
    @: text char 0
    size_t: i 0U
    value := lmx_graph_description_value(g, value)
    text := c.lmx_graph_word_text(g, value)
    if: text = 0
        return: 0
    if: text[0] = (cast: (char) 34)
        return: lmx_graph_string_value(g, value)
    while: text[i] != (cast: (char) 0)
        if: text[i] = (cast: (char) 34) || text[i] = (cast: (char) 39)
            return: 0
        i := i + 1U
    ---
    return: text
end: lmx_graph_name_value

# The reception of a value by a formal of a receiver's contract (lmx_graph_receivers_open): a formal taken as written (a
# word cell: name, return) takes a word or a written form (a Structure: the type form `@: c.FILE` of a result
# requirement), a Structure formal (an empty Lmx) a Structure; an int, a place, a pointer value is received by neither.
# What the receiver's action needs of a value it received (a word for the name) is the action's (lmx_graph_receiver_make).
# 0, or 5.
fn: lmx_graph_receiver_admit (@: g c.LmxGraph; @: formal void; @: value void) int
    int: kind c.lmx_graph_kind(g, value)
    if: c.lmx_graph_kind(g, formal) = 2 && (kind = 2 || kind = 4)
        return: 0
    if: c.lmx_graph_kind(g, formal) = 4 && kind = 4
        return: 0
    return: 5
end: lmx_graph_receiver_admit

# The widest form of a contract (lmx_graph_receivers_open): the most formals any of its forms has.
fn: lmx_graph_forms_width (@: g c.LmxGraph; @: list c.Lmx) size_t
    size_t: widest 0U
    size_t: f 0U
    while: f < c.lmx_graph_count(list)
        if: c.lmx_graph_count((cast: (@: c.Lmx) c.lmx_graph_get_in(g, list, f))) > widest
            widest := c.lmx_graph_count((cast: (@: c.Lmx) c.lmx_graph_get_in(g, list, f)))
        f := f + 1U
    ---
    return: widest
end: lmx_graph_forms_width

# The form of a contract (lmx_graph_receivers_open) the written actuals of expression bind to, by the one binder
# (lmx_graph_bind_formals): the first form of list whose formals they all give -- by position or by name through `:=`
# -- with no actual left over and no formal unbound. The form is chosen
# before any actual is evaluated. bindings[i] the formal of actual i, modes[i] how (modes may be 0): arrays of the
# caller, one per actual. The form, or 0 for none; status[0] 0, 4 without memory, 5 for none.
fn: lmx_graph_receiver_form_of (@: g c.LmxGraph; @: list c.Lmx; @: expression c.Lmx; @: bindings size_t; @: modes int; @: status int) @: c.Lmx
    @: chosen c.Lmx 0
    @: seen int 0
    size_t: n c.lmx_graph_count(expression)
    size_t: width 0U
    size_t: f 0U
    size_t: i 0U
    int: found 0
    status[0] := 5
    seen := (cast: (@: int) c.calloc(lmx_graph_forms_width(g, list) + 1U, sizeof(int)))
    if: seen = 0
        status[0] := 4
        return: 0
    while: found = 0 && f < c.lmx_graph_count(list)
        chosen := (cast: (@: c.Lmx) c.lmx_graph_get_in(g, list, f))
        width := c.lmx_graph_count(chosen)
        i := 0U
        while: i < width
            seen[i] := 0
            i := i + 1U
        ---
        if: n <= width && lmx_graph_bind_formals(g, chosen, expression, bindings, modes, seen) = 0
            found := 1
            i := 0U
            while: i < width
                if: seen[i] = 0
                    found := 0
                i := i + 1U
            ---
        ---
        if: found = 0
            f := f + 1U
    ---
    c.free((cast: (@: void) seen))
    if: found = 0
        return: 0
    status[0] := 0
    return: chosen
end: lmx_graph_receiver_form_of

# The arguments of the receiver fn or sub of the Frame decl in block scope through its contracts
# (lmx_graph_receivers_open) and the one binder (lmx_graph_receiver_form_of): the first form its written actuals bind to --
# by position or by `:=` -- with every formal bound; else one actual is the whole argument structure (the book,
# whole-arguments): a Structure whose fields give exactly the formals of a form (lmx_graph_bind_fields), read by their
# values (lmx_graph_field_value). The form is chosen before any actual is evaluated; the whole Structure, the only actual
# then, is evaluated once. A formal taken as written (name, return) takes a written word or written form (`@: c.FILE`)
# as it is where it applies nothing (lmx_graph_applies). A Structure formal takes a written group as data through the
# common receiving-value reader (lmx_graph_read_received_value); any
# other actual -- an application, a name a Structure formal resolves -- is an expression evaluated once, in order --
# when evaluate is 1; with 0 such an actual binds nothing (-1), so a declaration with written arguments is told
# (lmx_graph_fn_written). Each value is received by its formal before the next actual is evaluated
# (lmx_graph_receiver_admit). values[slot] the value of each formal, form[0] the form. 0; -1 an actual needs evaluation;
# 4 without memory; 5 for no form or a value its formal does not receive; the answer of an evaluation.
fn: lmx_graph_receiver_bind (@: g c.LmxGraph; @: scope c.Lmx; @: decl c.Lmx; int: evaluate; @@: values void; @@: form c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: space c.LmxGraphSpace c.lmx_graph_space()
    @: head char 0
    @: list c.Lmx 0
    @: chosen c.Lmx 0
    @: raw void 0
    @: value void 0
    @: bindings size_t 0
    @: modes int 0
    @: from size_t 0
    size_t: n 0U
    size_t: width 0U
    size_t: f 0U
    size_t: i 0U
    size_t: slot 0U
    int: found 0
    int: status 0
    form[0] := 0
    if: g = 0 || state = 0 || space = 0 || decl = 0 || values = 0
        return: 5
    head := c.lmx_graph_name_of(g, (cast: (@: void) decl))
    if: head != state\w_fn && head != state\w_sub
        return: 5
    list := (cast: (@: c.Lmx) c.lmx_graph_space_find((cast: (@: c.Lmx) space\root), head))
    if: c.lmx_graph_kind(g, (cast: (@: void) list)) != 4
        return: 5
    n := c.lmx_graph_count(decl)
    bindings := (cast: (@: size_t) c.calloc(n + 1U, sizeof(size_t)))
    modes := (cast: (@: int) c.calloc(n + 1U, sizeof(int)))
    from := (cast: (@: size_t) c.calloc(lmx_graph_forms_width(g, list) + 1U, sizeof(size_t)))
    if: bindings = 0 || modes = 0 || from = 0
        status := 4
    # The form, by the written actuals alone; with none, the whole-arguments reading below.
    if: status = 0
        chosen := lmx_graph_receiver_form_of(g, list, decl, bindings, modes, @ status)
        if: chosen != 0
            found := 1
            width := c.lmx_graph_count(chosen)
        ---
        if: status = 5
            status := 0
        ---
    ---
    if: status = 0 && found != 0
        i := 0U
        while: i < n && status = 0
            raw := c.lmx_graph_get_in(g, decl, i)
            slot := bindings[i]
            # `:=` holds the actual itself, with its written groups preserved by the builder. A Structure formal
            # must not strip such a group or turn an unknown named Frame into literal DATA.
            if: modes[i] = 1
                raw := c.lmx_graph_get_in(g, (cast: (@: c.Lmx) raw), 2U)
            ---
            if: c.lmx_graph_kind(g, c.lmx_graph_get_in(g, chosen, slot)) = 2
                raw := lmx_graph_description_value(g, raw)
            value := 0
            if: (c.lmx_graph_kind(g, c.lmx_graph_get_in(g, chosen, slot)) = 2 && (c.lmx_graph_kind(g, raw) = 2 || (c.lmx_graph_kind(g, raw) = 4 && lmx_graph_applies(g, scope, raw) = 0))) || (c.lmx_graph_kind(g, c.lmx_graph_get_in(g, chosen, slot)) = 4 && lmx_graph_written_group(g, raw) != 0)
                value := raw
            else:
                if: evaluate = 0
                    status := -1
                else:
                    status := lmx_graph_read_received_value(g, scope, raw, 2, @ value)
                    if: status = 0
                        value := c.lmx_graph_target(g, value)
                    ---
                ---
            ---
            # The value is admitted to its formal at once, before the next actual is evaluated: a formal taken as
            # written (a word cell) takes a word or a written form, a Structure formal a Structure (the norm of a call:
            # each actual is received before the next).
            if: status = 0
                status := lmx_graph_receiver_admit(g, c.lmx_graph_get_in(g, chosen, slot), value)
            if: status = 0
                values[slot] := value
            i := i + 1U
        ---
    ---
    # No form by position or name: one actual is the whole argument structure of a form.
    if: status = 0 && found = 0
        status := 5
        raw := c.lmx_graph_get_in(g, decl, 0U)
        if: n = 1U && (c.lmx_graph_kind(g, raw) != 4 || c.lmx_graph_name_of(g, raw) != 0 || c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, (cast: (@: c.Lmx) raw), 0U)) != state\w_assign)
            status := 0
            value := raw
            if: c.lmx_graph_kind(g, raw) != 4 || c.lmx_graph_name_of(g, raw) != 0
                if: evaluate = 0
                    status := -1
                else:
                    status := lmx_graph_eval_value(g, scope, raw, @ value)
                ---
            ---
            if: status = 0
                value := c.lmx_graph_target(g, value)
                status := 5
                if: c.lmx_graph_kind(g, value) = 4
                    f := 0U
                    while: found = 0 && f < c.lmx_graph_count(list)
                        chosen := (cast: (@: c.Lmx) c.lmx_graph_get_in(g, list, f))
                        width := c.lmx_graph_count(chosen)
                        i := 0U
                        while: i <= width
                            from[i] := 0U
                            i := i + 1U
                        ---
                        if: lmx_graph_bind_fields(g, chosen, (cast: (@: c.Lmx) value), from) != 0
                            found := 1
                            i := 0U
                            while: i < width
                                if: from[i] = 0U
                                    found := 0
                                i := i + 1U
                            ---
                        ---
                        if: found = 0
                            f := f + 1U
                    ---
                    if: found != 0
                        status := 0
                        slot := 0U
                        while: slot < width && status = 0
                            values[slot] := lmx_graph_field_value(g, c.lmx_graph_get_in(g, (cast: (@: c.Lmx) value), from[slot] - 1U))
                            if: c.lmx_graph_kind(g, c.lmx_graph_get_in(g, chosen, slot)) = 2
                                values[slot] := lmx_graph_description_value(g, values[slot])
                            status := lmx_graph_receiver_admit(g, c.lmx_graph_get_in(g, chosen, slot), values[slot])
                            slot := slot + 1U
                        ---
                    ---
                ---
            ---
        ---
    ---
    if: status = 0
        form[0] := chosen
    c.free((cast: (@: void) bindings))
    c.free((cast: (@: void) modes))
    c.free((cast: (@: void) from))
    return: status
end: lmx_graph_receiver_bind

# The receiver's action on its bound arguments (lmx_graph_receiver_bind): the Structure F of the function by the one
# constructor lmx_graph_fn_make (sub: without a result). The form with the formal parts takes the Structure of the parts
# and reads its fields by their values (lmx_graph_fn_part): a field name there is an ordinary field, another field is no
# part of the contract (5). The name is the contract of a name (lmx_graph_name_value: an identifier, or the value of
# a string literal). 0 and F in out, its name in name_out; 1 without memory; 5 for a value of
# another kind or a missing part.
fn: lmx_graph_receiver_make (@: g c.LmxGraph; @: decl c.Lmx; @: form c.Lmx; @@: values void; @@: out c.Lmx; @@: name_out char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: w_name char c.lmx_graph_intern("name", 4U)
    @: w_parts char c.lmx_graph_intern("parts", 5U)
    @: head char 0
    @: parts c.Lmx 0
    @: name char 0
    @: field char 0
    @: args c.Lmx 0
    @: result void 0
    @: written c.Lmx 0
    @: body c.Lmx 0
    size_t: width 0U
    size_t: slot 0U
    size_t: i 0U
    int: with_result 0
    out[0] := 0
    name_out[0] := 0
    if: g = 0 || state = 0 || form = 0 || values = 0 || w_name = 0 || w_parts = 0
        return: 5
    head := c.lmx_graph_name_of(g, (cast: (@: void) form))
    with_result := (cast: (int) (head = state\w_fn))
    width := c.lmx_graph_count(form)
    slot := c.lmx_graph_formal(g, form, w_name)
    if: slot >= width
        return: 5
    name := lmx_graph_name_value(g, values[slot])
    slot := c.lmx_graph_formal(g, form, w_parts)
    if: slot < width
        if: c.lmx_graph_kind(g, values[slot]) != 4
            return: 5
        parts := (cast: (@: c.Lmx) values[slot])
        while: i < c.lmx_graph_count(parts)
            field := c.lmx_graph_slot_name(g, parts, i)
            if: field != w_name && field != state\w_args && field != state\w_data && field != state\w_code && (field != state\w_return || with_result = 0)
                return: 5
            i := i + 1U
        ---
        args := (cast: (@: c.Lmx) lmx_graph_fn_part(g, parts, (cast: (@: char) state\w_args)))
        written := (cast: (@: c.Lmx) lmx_graph_fn_part(g, parts, (cast: (@: char) state\w_data)))
        body := (cast: (@: c.Lmx) lmx_graph_fn_part(g, parts, (cast: (@: char) state\w_code)))
        if: with_result != 0
            result := lmx_graph_fn_part(g, parts, (cast: (@: char) state\w_return))
        ---
    else:
        slot := c.lmx_graph_formal(g, form, state\w_args)
        if: slot < width
            args := (cast: (@: c.Lmx) values[slot])
        slot := c.lmx_graph_formal(g, form, state\w_data)
        if: slot < width
            written := (cast: (@: c.Lmx) values[slot])
        slot := c.lmx_graph_formal(g, form, state\w_code)
        if: slot < width
            body := (cast: (@: c.Lmx) values[slot])
        slot := c.lmx_graph_formal(g, form, state\w_return)
        if: slot < width
            result := values[slot]
        ---
    ---
    # A constructed descriptor carries its unified DATA. Header inputs are
    # present only in a written shorthand; copying parts must not require
    # the removed physical formal-args field.
    if: name = 0 || (with_result != 0 && result = 0)
        return: 5
    result := lmx_graph_description_value(g, result)
    name_out[0] := name
    return: lmx_graph_fn_make(g, decl, name, args, result, written, body, with_result, out)
end: lmx_graph_receiver_make

# The written name of fn/sub, without constructing or evaluating it: a positional name or `name := value` in the
# direct actuals; otherwise the unique ordinary DATA field name of one supplied anonymous whole descriptor. These
# are separate views: a direct Frame `name: value` is never a label, and a descriptor's fields are never applications.
# One whole descriptor is selected once; nested written groups are not recursively stripped. A held/computed
# descriptor (`fn: prepared`) has no name until evaluated. The query needs no traversal namespace.
fn: lmx_graph_fn_decl_name (@: g c.LmxGraph; @: decl c.Lmx) @: char
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: w_name char c.lmx_graph_intern("name", 4U)
    @: raw void 0
    @: inner c.Lmx 0
    size_t: n 0U
    size_t: i 0U
    int: whole 0
    @: name char 0
    if: g = 0 || state = 0 || w_name = 0 || c.lmx_graph_kind(g, (cast: (@: void) decl)) != 4
        return: 0
    n := c.lmx_graph_count(decl)
    if: n = 1U
        raw := c.lmx_graph_get_in(g, decl, 0U)
        if: raw != decl && c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, (cast: (@: c.Lmx) raw), 0U)) != state\w_assign
            whole := 1
            decl := (cast: (@: c.Lmx) raw)
            n := c.lmx_graph_count(decl)
        ---
    ---
    if: whole = 0 && n > 1U && c.lmx_graph_kind(g, lmx_graph_description_value(g, c.lmx_graph_get_in(g, decl, 0U))) = 2
        return: lmx_graph_name_value(g, c.lmx_graph_get_in(g, decl, 0U))
    while: i < n
        raw := c.lmx_graph_get_in(g, decl, i)
        inner := (cast: (@: c.Lmx) raw)
        if: whole = 0 && c.lmx_graph_kind(g, raw) = 4 && c.lmx_graph_name_of(g, raw) = 0 && c.lmx_graph_count(inner) = 3U && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, inner, 0U)) = state\w_assign && c.lmx_graph_word_text(g, c.lmx_graph_get_in(g, inner, 1U)) = w_name
            return: lmx_graph_name_value(g, c.lmx_graph_get_in(g, inner, 2U))
        if: whole != 0 && c.lmx_graph_slot_name(g, decl, i) = w_name
            if: name != 0
                return: 0
            name := lmx_graph_name_value(g, lmx_graph_field_value(g, raw))
            if: name = 0
                return: 0
            ---
        ---
        i := i + 1U
    ---
    return: name
end: lmx_graph_fn_decl_name

# Is decl (a Frame named fn or sub) a declaration with written arguments -- its actuals bind a form of the receiver's
# contract with no evaluation (lmx_graph_receiver_bind): names and written Structures, by position or `:=`? Its
# Structure is created when its block is entered (lmx_graph_space_declarations) and answers in the whole block (the book
# :435). An application to arguments the traversal computes -- the whole prepared Structure, a Structure of the parts
# an expression gives, a part a call gives -- is applied where the traversal reaches it (lmx_graph_fn_apply). 1 or 0.
fn: lmx_graph_fn_written (@: g c.LmxGraph; @: decl c.Lmx) int
    @@: values void (cast: (@@: void) c.calloc(6U, sizeof(@: void)))
    @: form c.Lmx 0
    int: status 5
    if: g = 0 || values = 0 || c.lmx_graph_kind(g, (cast: (@: void) decl)) != 4
        c.free((cast: (@: void) values))
        return: 0
    status := lmx_graph_receiver_bind(g, (cast: (@: c.Lmx) decl\parent), decl, 0, values, @ form)
    c.free((cast: (@: void) values))
    return: (cast: (int) (status = 0))
end: lmx_graph_fn_written

# The receiver fn or sub applied to the written arguments of its declaration Frame, bound to a form of its contract by
# the one binder (lmx_graph_receiver_bind, no evaluation): the Structure it creates (lmx_graph_receiver_make,
# lmx_graph_fn_make) answers the name in the block scope of this traversal, then the declarations of its body answer
# theirs in the body's block. 0; -1 an argument needs evaluation and -2 no form binds (both told where the traversal
# reaches the Frame, lmx_graph_fn_apply); 1 without memory; 5 for a value of another kind.
fn: lmx_graph_space_declare (@: g c.LmxGraph; @: scope c.Lmx; @: decl c.Lmx) int
    @@: values void 0
    @: form c.Lmx 0
    @: made c.Lmx 0
    @: name char 0
    @: body c.Lmx 0
    int: status 4
    # Re-entering one written scope retains this declaration's constructed
    # value and its own data. Equal names at different source addresses are
    # still distinct declarations, not a name-based memoization.
    if: lmx_graph_binding_method(g, scope, (cast: (@: void) decl)) != 0
        return: 0
    values := (cast: (@@: void) c.calloc(6U, sizeof(@: void)))
    if: values != 0
        status := lmx_graph_receiver_bind(g, scope, decl, 0, values, @ form)
    # No form of the contract binds the written actuals: refused, or applied, where the traversal reaches it.
    if: status = 5
        status := -2
    if: status = 0
        status := lmx_graph_receiver_make(g, decl, form, values, @ made, @ name)
    c.free((cast: (@: void) values))
    if: status != 0
        return: status
    if: c.lmx_graph_space_put(scope, name, (cast: (@: void) made)) != 0
        return: 1
    return: lmx_graph_space_callable(g, made)
end: lmx_graph_space_declare

# Prepare the two declaration scopes of the constructed callable once. Ordinary
# nested data fields are not traversed; each scope uses the same root reader.
fn: lmx_graph_space_callable (@: g c.LmxGraph; @: made c.Lmx) int
    int: status lmx_graph_space_declarations(g, c.lmx_graph_method_data(g, made))
    if: status != 0
        return: status
return: lmx_graph_space_declarations(g, c.lmx_graph_method_code(g, made))

# Every declaration Frame of fn or sub with written arguments (lmx_graph_fn_written) among the fields of a block creates
# its Structure in this traversal before the block runs: the names of fn and sub are visible in both directions of their
# block (the book :435). The receiver applied to arguments the traversal computes creates its Structure where the
# traversal reaches it (lmx_graph_fn_apply), and the name answers from there on.
fn: lmx_graph_space_declarations_part (@: g c.LmxGraph; @: block c.Lmx; size_t: from; size_t: to) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: value void 0
    @: head char 0
    size_t: i from
    int: status 0
    while: i < to && status = 0
        value := c.lmx_graph_binding_leaf(g, c.lmx_graph_get_in(g, block, i))
        head := c.lmx_graph_name_of(g, value)
        # An argument to evaluate, or no form: applied, or refused, where the traversal reaches it (lmx_graph_fn_apply).
        if: c.lmx_graph_kind(g, value) = 4 && (head = state\w_fn || head = state\w_sub)
            status := lmx_graph_space_declare(g, block, (cast: (@: c.Lmx) value))
            if: status = -1 || status = -2
                status := 0
            ---
        ---
        i := i + 1U
    ---
    return: status
end: lmx_graph_space_declarations_part

fn: lmx_graph_space_declarations (@: g c.LmxGraph; @: block c.Lmx) int
    return: lmx_graph_space_declarations_part(g, block, 0U, c.lmx_graph_count(block))
end: lmx_graph_space_declarations

# The value a Structure gives for the part name of a receiver: the value of its field named name, by the one model of a
# Frame (lmx_graph_field_value), whatever made the Structure. 0 when it has no field named name.
fn: lmx_graph_fn_part (@: g c.LmxGraph; @: structure c.Lmx; @: name char) @: void
    size_t: slot 0U
    if: g = 0 || structure = 0 || name = 0
        return: 0
    slot := c.lmx_graph_named(g, structure, name)
    if: slot >= c.lmx_graph_count(structure)
        return: 0
    return: lmx_graph_field_value(g, c.lmx_graph_get_in(g, structure, slot))
end: lmx_graph_fn_part

# The receiver fn or sub applied where the traversal reaches its Frame at field index of the root, to arguments the
# traversal computes (the author 2026-11-09: "в любой момент можем подставить заготовленную структуру ресиверу fn и это
# будет объявлением функции в namespace"): the same contract and binder as a written declaration
# (lmx_graph_receiver_bind) -- the whole prepared Structure (`fn: prepared`), the written name and a Structure of the
# parts (`fn: new_name merge(f1, f2)`), any form whose part an expression gives --, the arguments evaluated once in
# order, and the same action (lmx_graph_receiver_make: one constructor, data by lmx_graph_fn_data); from here on the name
# answers F in this block. A written name is checked before any argument is evaluated. A declaration with written
# arguments created its F when the block was entered (0 here). 0; 1 without memory; 3 for an unknown name; 4 for a name
# that already answers in this block; 5 for no form or a value of another kind.
# Own data uses its existing frame and scope. Once its declaration has constructed
# a method in this traversal, a later launch reads that same data value.
fn: lmx_graph_fn_apply (@: g c.LmxGraph; @: scope c.Lmx; size_t: index) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: space c.LmxGraphSpace c.lmx_graph_space()
    @@: values void 0
    @: decl c.Lmx 0
    @: form c.Lmx 0
    @: made c.Lmx 0
    @: name char 0
    @: head char 0
    @: body c.Lmx 0
    @: activation c.LmxActivation 0
    @: frame c.LmxGraphFrame 0
    @: row c.LmxGraphWork 0
    int: own_scope 0
    int: status 0
    if: g = 0 || state = 0 || scope = 0 || index >= c.lmx_graph_count(scope)
        return: 5
    decl := (cast: (@: c.Lmx) c.lmx_graph_get_in(g, scope, index))
    head := c.lmx_graph_name_of(g, (cast: (@: void) decl))
    if: c.lmx_graph_kind(g, (cast: (@: void) decl)) != 4 || (head != state\w_fn && head != state\w_sub)
        return: 5
    if: lmx_graph_fn_written(g, decl) != 0
        return: 0
    if: space = 0
        return: 5
    activation := (cast: (@: c.LmxActivation) g\arena\activation)
    if: activation != 0
        frame := (cast: (@: c.LmxGraphFrame) activation\frame)
    if: frame != 0 && frame\data = scope
        own_scope := 1
    if: space\root != scope && own_scope = 0 && (frame = 0 || frame\lexical_scope != scope || lmx_graph_code_within(g, (cast: (@: c.Lmx) frame\body), scope) = 0)
        return: 5
    if: own_scope != 0 && lmx_graph_binding_method(g, scope, (cast: (@: void) decl)) != 0
        return: 0
    # A written name is checked before any argument is evaluated.
    name := lmx_graph_fn_decl_name(g, decl)
    if: name != 0 && c.lmx_graph_space_find(scope, name) != 0
        return: 4
    values := (cast: (@@: void) c.calloc(6U, sizeof(@: void)))
    if: values = 0
        return: 1
    status := lmx_graph_receiver_bind(g, scope, decl, 1, values, @ form)
    if: status = 0
        status := lmx_graph_receiver_make(g, decl, form, values, @ made, @ name)
    c.free((cast: (@: void) values))
    if: status != 0
        return: status
    if: c.lmx_graph_space_find(scope, name) != 0
        return: 4
    if: c.lmx_graph_space_put(scope, name, (cast: (@: void) made)) != 0
        return: 1
    # A new local name wins over the entry fallback immediately, including in
    # the next data initializer. No external value is sampled a second time.
    if: frame != 0 && (own_scope != 0 || frame\body = scope)
        row := lmx_graph_work_row(g, frame, name)
        if: row != 0 && row\slot = (cast: (size_t) -1)
            row\cell := (cast: (@: void) made)
            row\loaded := row\loaded | 3
        ---
    ---
    return: lmx_graph_space_callable(g, made)
end: lmx_graph_fn_apply

# The next declaration of fn or sub in the root of the launch's data that is not applied yet and may give name -- its written name is name, or it has none
# written -- is applied now by lmx_graph_fn_apply (a read reaches it). 1 when one was applied; 0 when none is left or the apply answered otherwise (told in
# status).
fn: lmx_graph_data_reach_next (@: g c.LmxGraph; @: frame c.LmxGraphFrame; @: name char; @: status int) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: data c.Lmx (cast: (@: c.Lmx) frame\data)
    @: raw void 0
    @: head char 0
    @: declared char 0
    int: candidate 0
    size_t: i 0U
    if: state = 0 || frame\data = frame\body
        return: 0
    while: i < c.lmx_graph_count(data)
        raw := c.lmx_graph_get_in(g, data, i)
        head := c.lmx_graph_name_of(g, raw)
        candidate := (cast: (int) (c.lmx_graph_kind(g, raw) = 4 && (head = state\w_fn || head = state\w_sub) && lmx_graph_binding_method(g, data, raw) = 0))
        declared := 0
        if: candidate != 0
            declared := lmx_graph_fn_decl_name(g, (cast: (@: c.Lmx) raw))
        if: candidate != 0 && (declared = 0 || declared = name)
            status[0] := lmx_graph_fn_apply(g, data, i)
            if: status[0] != 0 || lmx_graph_binding_method(g, data, raw) = 0
                return: 0
            return: 1
        i := i + 1U
    return: 0

# The slot of the place named name of block that a write by a bare name reaches (plan M11 5a): the only record of that
# name in the registry of block (lmx_graph_data_find), read whole and both ways, when it is a place; the count of the
# slots of block for none, for two or more records, or for a record that is no place.
fn: lmx_graph_visible_slot (@: g c.LmxGraph; @: block c.Lmx; @: name char) size_t
    size_t: at 0U
    if: lmx_graph_data_find(g, block, name, 1, 0U, @ at) != 1U || lmx_graph_place_slot(g, block, name) != at
        return: c.lmx_graph_count(block)
    return: at
end: lmx_graph_visible_slot

# Begin the namespace of a traversal of root (§5.2): when no traversal is live, a new empty table and the Structures of
# the declarations of fn and sub created in it (they answer in their whole block); the places and named Structures of the
# root answer in the whole root, read whole by its registry (lmx_graph_resolve; plan M11 5a). A traversal begun inside a live
# one goes on with it. opened[0] says which (the argument of lmx_graph_space_close). 0; 1 without memory;
# 5 for a declaration form this slice does not execute.
fn: lmx_graph_space_open (@: g c.LmxGraph; @: root c.Lmx; @: opened int) int
    int: status 0
    if: g = 0 || root = 0 || opened = 0
        return: 5
    opened[0] := c.lmx_graph_space_push(root)
    if: opened[0] < 0
        opened[0] := 0
        return: 1
    if: opened[0] = 1
        status := lmx_graph_receivers_open(g, root)
        if: status = 0
            status := lmx_graph_space_declarations(g, root)
        if: status != 0
            c.lmx_graph_space_pop(opened[0])
            opened[0] := 0
        ---
    ---
    return: status
end: lmx_graph_space_open

# End the namespace lmx_graph_space_open began (opened: its answer in opened[0]); its rows are freed.
sub: lmx_graph_space_close (int: opened)
    c.lmx_graph_space_pop(opened)
    return
end: lmx_graph_space_close
