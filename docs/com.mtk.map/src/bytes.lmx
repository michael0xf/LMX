        int: begin 0
        while: begin <= bytes\count
            int: at MapBytes\findSequence(bytes; old; begin)
            if: at < 0
                break
            MapBytes\splice(bytes; at; at + old\count; new)
            begin := at + new\count
            amount += 1
        return: amount

