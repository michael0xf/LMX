# A candidate with a shifted matching field still satisfies the required name.
Model: (size_t: x 10U)
Cand: (char: pad 'q'; size_t: x 10U)
fn: rdFirst (Model: v) size_t
    size_t: got
    got: v\x
    return: got
end: rdFirst
c: merge: Cand
int: ok 7
if: rdFirst(c) != 10U
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
