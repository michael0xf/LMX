            if: bd != 0 && c.fprintf(out_cell[0], "%sif: l2_merge_body_build_%d(l2_mbody, l2_program_unit, l2_program_arena) != 0\n", ind, msf) < 0
                return: (cast: (int) (1))
            if: bd != 0 && c.lm_compiler_emit_implicit_throw(mi, "merge", ind) != 0
                return: (cast: (int) (1))
            merge_own: mres_own_cell[0][msf]
            merge_source: @ mres_source_cell[0][msf]
            c.strcpy(merge_source_token, "0")
            if: merge_source\layout != -1
                c.sprintf(merge_source_token, "(cast: (@: void) (l2_layout_tokens + %d))", c.lm_compiler_schema_token_slot((cast: (int) (merge_source\layout))))
            if: c.fprintf(out_cell[0], "%ssize_t: l2_mprofile_n%d 0U\n", ind, msf) < 0
                return: (cast: (int) (1))
            excluded: own_excl_cell[0]
            own_excl_cell[0]: merge_own
            k: 0
            while: k < n
                form: lm_compiler_merge_decl_operand(lm_compiler_merge_frame(stmt), k, mi, src_cell[0], @ last, @ span)
                if: form = 1
                    own_excl_cell[0]: excluded
                    return: (cast: (int) (1))
                # READ-FIELD-CLOSURE: the operand's model, whose code the copy carries (l2_mu_operand_model).
                if: lm_compiler_mu_operand_model(last, span, form, mi, @ ni) != 0 || lm_compiler_mu_set(k, ni) != 0
                    own_excl_cell[0]: excluded
                    return: (cast: (int) (1))
