Point:
    Inner:
        int: y 0
        int: x 0
    end: Inner
end: Point
Candidate:
    Inner:
        int: y 3
    end: Inner
end: Candidate
Flat:
    int: y 0
end: Flat
fn: take (Point: p; int: q) int
    return: ((((p \ Inner) \ y) * 10) + q)
end: take
fn: choose (Point: p) int
    return: (take p ((1 + 2)))
end: choose
fn: numeric (int: x; int: y) int
    return: ((x * 10) + y)
end: numeric
fn: access (Flat: value) int
    return: (value \ y)
end: access
fn: a (int: x) int
    return: (x + 1)
end: a
fn: mytest (int: a) int
    return: (a + 30)
end: mytest
