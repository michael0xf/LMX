# Three recursively collected signature levels use the same declaration-row
# identity as two; no special nesting form or descriptor execution.
fn: inc (int: q) int
return: q + 1
fn: middle (inc: cb; int: x) int
return: cb(x)
fn: outer (middle: call; int: x) int
return: call(inc, x)
fn: take (op(fn: (inner(fn: (leaf(fn: (int: q) int) int(v)) int) int(x)) int) int(value)) int
return: op(middle, value)
int: a take(outer, 3)
int: ok 81
if: a = 4
    ok: 7
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
