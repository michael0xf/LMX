# Probe A: one deref-prefixed actual of a C call followed by a plain local (shape of emit:6650 / core:15230).
include: "<stdio.h>"
fn: show (@: out int) int
    int: uslot 5
    if: c.printf("%d %d\n", \out, uslot) < 0
        return: 1
    return: 0
end: show
fn: run () int
    int: v 7
    if: show(@ v) != 0
        return: 80
    return: 7
end: run
sendMessage: exit(exit_code: run(); stdout: ""; stderr: "")
return
