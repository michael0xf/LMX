# Ordinary code through the same application head uses Self or given data.
sub: main () (
    Table:
        Code:
            x := x + 1
        Self:
            int: x 1
            x := x + 2
        Data:
            int: x 10
        `Kept[x]`:
            int: value 3
)
    Table\Self()
    Table\Self()
    Table\Code(Table\Data)
main()
int: self_value main\data\Table\Self\x
int: given_value main\data\Table\Data\x
int: kept_value main\data\Table[3]\value
