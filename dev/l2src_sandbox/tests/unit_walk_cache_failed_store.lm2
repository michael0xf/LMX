# §7b witness (book §9, dirty.md F49-04: a failed admission commits nothing, does not newly mark the destination and
# does not erase an earlier pending write): a is -1, b and c are 5U, all published by the call to nop.  `b: 6U` is
# pending when `b: a` is refused by the converter; the next call still publishes 6.  c is clean; poke writes
# mytest\c: 7U, then `c: a` is refused, and the next call must not write the stale 5 back.  The program exits
# 6 * 10 + 7 = 67; a refusal that erases the mark gives 57, one that marks the destination 65.
fn: nop () int
    return: 0
end: nop

fn: poke () int
    mytest\c: 7U
    return: 0
end: poke

fn: mytest () int
    int: a -1
    size_t: b 5U
    size_t: c 5U
    nop()
    b: 6U
    ---
        b: a
        catch: convert ()
            a: -1
    ---
    nop()
    poke()
    ---
        c: a
        catch: convert ()
            a: -1
    ---
    nop()
    return: 0
end: mytest

fn: check () int
    size_t: pb 0U
    pb: mytest\b
    size_t: pc 0U
    pc: mytest\c
    if: pb = 6U && pc = 7U
        return: 67
    if: pb = 5U
        return: 57
    if: pc = 5U
        return: 65
    return: 1
end: check

int: v 0
v: mytest()
int: w 0
w: check()
sendMessage: exit(exit_code: v + w; stdout: ""; stderr: "")
return
