+            return: l2_rw_refuse(value\node, "an Array value")
+        if: l2_rw_frame(parent, "LMX_WALK_OP_LENGTH", 2, out) != 0 || l2_rw_evaluate_span(@ operand, l2_own_ty_of_param(l2_array_desc_ty()), \out, @ child) != 0
+            return: 1
+        return: l2_rw_put(\out, 1, child)
+    if: l2_primary_cast_value(value, @ type, 0, @ operand) != 0
+        return: l2_rw_refuse(value\node, "this cast contract")
+    values: l2_primary_values(value, @ n)
+    l2_rw_machine: 1
+    if: l2_rw_frame(parent, "LMX_WALK_OP_SOURCE_MACHINE", 2, out) != 0 || l2_rw_source_name(\out, value\node\as\frame\head) != 0 || l2_rw_plain(\out, 2, @ body) != 0 || l2_rw_put(\out, 1, body) != 0
+        return: 1
