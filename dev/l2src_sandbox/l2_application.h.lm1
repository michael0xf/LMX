predef: "l1src/p0.h.lm1"

# Translation-owned contracts. These records are not runtime graph objects.
# A constructor has one ordinary operand contract; no Array rank/depth table.
struct: L2TypeContract
    int: kind
    int: depth
    @: LmP0Text word
    @: L2TypeContract operand
    @: L2TypeContract allocated_next
end: L2TypeContract

# A receiver may derive this contract from an application. Name visibility is
# resolved at the source position, never cached from allocated storage.
struct: L2Declaration
    @: LmP0Node source
    @: L2TypeContract contract
    @: LmP0Text name
    @: LmP0Field candidate
    int: candidate_count
    # An explicit type/value receiver nested in a repeated reference write
    # validates its value before the original place contract does.
    @: L2TypeContract asserted_contract
    @: LmP0Text extent
    # Translator-only atom view of the receiving name. Candidate-free carry
    # reads the prior binding by name, independent of receiver spelling.
    LmP0NodeAs: carry_as
    LmP0Node: carry_node
    LmP0Field: carry_field
    @: L2Declaration allocated_next
end: L2Declaration

# A later source operation may write an already declared field. This is a
# translator-only association: the runtime graph retains the source operation,
# while the field still has exactly one physical cell.
struct: L2OwnReuse
    @: LmP0Node source
    int: method
    int: own
    @: L2OwnReuse allocated_next
end: L2OwnReuse

# A field projected from either existing named or composed compiler metadata.
# This record has no runtime representation and contains no binding identity.
struct: L2SchemaField
    @: LmP0Text name
    @: LmP0Text type_word
    int: kind
    int: model
end: L2SchemaField

# Translation-only source projection, made before candidate evaluation. schema
# names complete candidate metadata, not the required receiving model. layout
# is absent unless a real descriptor producer establishes that schema. A held
# own/input/result uses the existing D105 source place. Tagged schema handles
# are decoded only by the shared schema helpers; -1 alone means absent. A handle
# at or below -1500000000 is one method occurrence's own fields, not a merge tag.
struct: L2ReferenceSource
    int: schema
    int: layout
    int: method
    int: place
end: L2ReferenceSource

# The text the emitter builds (FIXED-BLOCKS-AUDIT, the expression text): `data` holds `len` bytes and a NUL in
# `cap` bytes -- its owner's buffer while that suffices, then storage of the translation (l2trans.lm1, l2_tx_*).
struct: L2Tx
    @: char data
    size_t: len
    size_t: cap
end: L2Tx

# A bounded source operand view. All source pointers are borrowed; no AST or
# runtime graph is copied. The index is either a literal, an existing joined
# own-name projection, or the original P0 index expression.
struct: L2IndexedOperand
    int: own
    int: type
    int: count
    int: address
    int: dynamic
    size_t: literal
    @: LmP0Node index
    @: LmP0Field after
end: L2IndexedOperand

# One borrowed operand or operator in a bounded expression. No joined text or
# replacement P0 node is retained: consumers resolve the original source span.
struct: L2ValueSpan
    @: LmP0Field first
    int: count
    @: LmP0Node node
end: L2ValueSpan

# One transient decision for a written `call:` operand. The current supported
# static route is recorded without claiming that it proves a mutable binding's
# future body; that provenance remains an M2 gate. `ni` selects the procedure
# and hidden-input contract; `target_ns` selects a unit slot, or `oi` an own
# place. A compatible layout or field type alone is not body identity. No
# source text is joined and this record is never part of a runtime Lmx graph.
struct: L2StructCallPlan
    L2ValueSpan: operand
    # N4 (LMX_semantics.ru.md #method-parts): the data operand of `call: code data` (count 0 for the one-operand
    # call), the operand shape l2_struct_call_operands gives, and the field a refused shape names.
    L2ValueSpan: data
    int: shape
    @: LmP0Field extra
    # The executable body and the place holding the current value are
    # independent. A named unit slot may later hold another body.
    int: ni
    int: target_ns
    int: oi
    int: result
    int: inert
end: L2StructCallPlan

# A CHECK-time source-site certificate for a written call. It is translator
# metadata, not a runtime graph field: body selects the executable occurrence,
# while target_ns/oi select the physical slot whose current value is called.
struct: L2CallBodySite
    @: LmP0Node source
    int: method
    int: body
    int: target_ns
    int: oi
    int: inert
    # N4 `call: code data`: split is 1 and data_node is the data operand. data_place is its analysis place
    # (l2_m2_root_own), data_target_ns or data_oi the unit slot or own place holding it, and data_layout the named
    # Structure whose layout it keeps (l2_m2_fixed). prow is the place row the kind-9 check reserves, and can_fail is
    # 1 when that row can refuse the call at run time.
    int: split
    @: LmP0Node data_node
    int: data_place
    int: data_target_ns
    int: data_oi
    int: data_layout
    int: prow
    int: can_fail
end: L2CallBodySite

# Borrowed raw-pointer indexing, distinct from a real Array descriptor's ELEM.
# Text belongs to an original frame head; fields belong to an original operand.
# Groups are iterated, not stored in a fixed-rank buffer.
struct: L2RawIndex
    LmP0Text: base
    LmP0Text: root
    const: @: LmP0Text text
    @: LmP0Field first
    int: count
    int: groups
    int: type
    int: foreign
    size_t: begin
end: L2RawIndex

# One step of a resolved written path (the author, 2026-10-18: one general algorithm for every path -- the check,
# native emission and the walker, references and indices included).  The resolver (l2_path_resolve) records the
# semantic coordinates of the field a segment selects in the host the previous step reached; a backend derives the
# physical address from them (l2_nsf_slot, l2_graph_field_child, the graph places) and never chooses a field, a
# type or an admission map again.  Translation-only; no runtime representation.
struct: L2PathStep
    # 1 a field of a Structure (row: its NSF row); 2 a slot of a merge result (row: the slot, nsrow: the contributing
    # NSF row or -1); 3 an own-declared field of a method, a control body or a part (own); 4 a control body (row: the
    # body index); 5 a part of a four-part fn (row: the part, ent: the method); 6 a field of the lexical space `node`
    # names (row: its ordinal there; own or ns the selected declaration, formal the host formal's index)
    int: locus
    # the selected field's value kind as the segment resolvers give it (0 size_t, 1 char, 2 nested Structure,
    # 3 Structure reference, 4 callable, 5/6 Array, 7 int, 8 unsigned, 9 ulong, 10 reference field, 11); 2 for a
    # body, 12 for a part
    int: kind
    int: row
    int: nsrow
    int: own
    int: ns
    int: formal
    # locus 6: the host method and the scope the selected declaration was read in (l2_node_seg_resolve), for the
    # backend's projection of its slot (l2_source_field_project, a host formal's l2_madc_formal_slot)
    int: node_host
    @: LmP0Node node_scope
    # the segment resolver's ent: the Structure of kind 2/3, the method of kind 4/12, the pointer code of kind 10
    int: ent
    # kind 10 continued: the pointee the next segment is resolved in (a schema handle), else -1
    int: pointee
    # the host the segment was resolved in -- the Structure, the merge result, the method's own level, the control
    # body, the part scope -- as the walk had them before this step
    int: host_ns
    int: host_res
    int: host_bm
    int: host_bh
    int: host_part
    # the admission map in force when this step is read (D-105): a schema handle or -1; the context of the receiving
    # model (l2_reference_model_context; -2 for the map a host formal named after `node` carries)
    int: view_model
    int: model_context
    # kind 10: the pointer code of the reference cell (POINTER_BASE + code is its storage type)
    int: cell_ft
    # an occurrence selector `[N]name` written at this segment, -1 for none (K01: refused before declarations)
    int: segocc
    # the segment's text in the path text, and its atom when the path was written as atoms (a located refusal)
    size_t: off
    size_t: len
    @: LmP0Node node
    # locus 7, an INDEX step (R5-3b): the index expression, kept as its span (never flattened into text); the Array
    # contract the step consumes (its level: the value before it); the element's type code and model
    L2ValueSpan: index
    @: L2TypeContract level
    int: elem_ty
    int: elem_model
end: L2PathStep

# A resolved written path: its selected root and its steps. Filled by l2_path_resolve from the
# path text (borrowed for the record's life) or by the run adapter from the atoms (a text of its own); read by every
# consumer -- the check pass, admission and qualification, initializer typing, the address route, the native emitter
# and the walker -- none of which splits the text or resolves a segment again.  Translation-only; the steps are
# released by l2_path_release.
#
# THE RECORD'S CONTRACT (the author, 2026-10-19: counters, types and maps stay consistent after every operation on the
# record).  Two sets of fields.  The VIEW -- text, length, owned, steps, cap, n, names, indexed, run_count, names_run,
# flat -- is written as one by an adapter (l2_path_steps_text, l2_path_steps_run, l2_path_steps_all), cut as one by
# l2_path_names_only (the steps before the first index step; n, names, indexed, run_count, the text length, flat
# together) and cleared as one by l2_path_release; no count of the view is stored twice (the native emitter walks the
# name steps, names, and the place emitter the index steps after them, both from the record).  The VERDICT -- the root (ni, res, oi, root, fi), each step's resolution (kind, ent, locus, row,
# the hosts, the maps view_model/model_context, the pointee and cell_ft of a reference crossed, an index step's level
# and element), the leaf (leaf_kind, leaf_mi, leaf_model, leaf_ty, array_leaf, leaf_level), ref_follow, in_eternal and
# a refusal's fail_seg/fail_why -- is written by ONE walk (l2_path_walk, l2_path_walk_steps) of the view as it stands
# then: a view is cut before its walk, never after (every caller prepares, cuts, walks, reads, releases, in that order),
# and no consumer derives any of it again from the text (the Array place is a view of this record, l2_array_place_view).
struct: L2Path
    const: @: char text
    size_t: length
    # the text is the record's own (the run adapter joins the names of a path written as atoms)
    int: owned
    # the steps of the record (the resolver walks exactly these, l2_path_walk_steps; the native emitter reads exactly
    # these, l2_emit_path_resolved): one count for every reader -- a view that cuts the record (l2_path_names_only)
    # cuts it here, and no second count of segments is stored beside it (R3)
    int: n
    # the name steps before the first index step; the index steps; the fields of the written run the atoms adapter
    # consumed; an adjacent bracket group after an index step -- the flat `[i][j]` form, which is not a step (the
    # Array-place view refuses it as a different thing)
    int: names
    int: indexed
    int: run_count
    # the fields of the run before its first index step (the root and the name steps): what the operand grammar's
    # names-only mode returns (l2_rw_path_run_mode reads run_count and this; nothing else re-decides where a run ends)
    int: names_run
    @: LmP0Field flat
    int: ni
    int: res
    int: oi
    # Root selection is a kind plus an index, not disjoint numeric ranges of one int.
    # 0: ni/res/oi/fi select an ordinary namespace or binding; 1: node;
    # 2: root indexes a control body; 3: a method occurrence; 4: a machine local.
    # These are compiler decisions only, never opcodes stored in an Lmx graph.
    int: root_kind
    int: root
    int: fi
    # the leaf: the last step's kind; its Structure (kind 2/3) or pointee (kind 10/11) as the model; its method
    # (kind 4) or pointer code (kind 10/11) as mi -- what l2_path_kind and l2_path_contract answer
    int: leaf_kind
    int: leaf_mi
    int: leaf_model
    # the leaf's value is an Array (leaf_level its contract): a name whose declaration is one, an element that is one;
    # leaf_ty: the value type code of an element leaf (kind 13)
    int: array_leaf
    @: L2TypeContract leaf_level
    int: leaf_ty
    int: ref_follow
    # the destination is a cell of a qualified immutable graph (l2_path_in_eternal)
    int: in_eternal
    # a refused walk: the segment and why (1 the root, 2 a segment the host has not, 3 a slot with no Structure to go
    # on through, 4 a malformed segment, 5 an index on a value that is no Array, 6 an element with no value contract)
    # -- l2_path_seg_refusal / l2_path_seg_refusal_at say it
    int: fail_seg
    int: fail_why
    @: L2PathStep steps
    int: cap
end: L2Path

# A compact head's original P0 expression and the common adapter's prepared
# path. Both are translation-owned; deferred checks and both backends borrow
# them. A use takes an independent grammar view, then resolves that view in
# its source environment. It never reparses the retained expression to decide
# its path shape again. No binding or runtime graph object is retained here.
struct: L2HeadExpression
    @: LmP0Node source
    @: LmP0Document document
    @: LmP0Structure body
    # The common adapter's grammar verdict (2 means no path run). Retain it
    # too: a computed/non-path head must not be parsed again after a miss.
    int: path_status
    L2Path: prepared
    @: L2HeadExpression allocated_next
end: L2HeadExpression

# A resolved source location, not another binding table. kind selects the
# existing own/argument/local-slot/machine-local/namespace entry; descriptor
# distinguishes the actual Structure from a cell holding a reference to it.
# Kind 6 -- the target as one path -- carries the path's resolved record (`path`; `resolved` = 1): l2_address_target
# resolves it once, the emitters (l2_emit_address, l2_rw_address) read it, and the consumer that was answered 0 releases
# the address (l2_address_release) when it is done with it; the scalars stay readable after the release (U7 D4).
# Declared after L2Path: the record is a member.
struct: L2Address
    int: kind
    int: index
    int: descriptor
    int: model
    int: type
    @: LmP0Field target
    int: target_count
    int: immutable
    L2Path: path
    int: resolved
end: L2Address

# One Array place (R5-3b): the Array-place VIEW of a resolved path (l2_array_place_view).  The record's name prefix
# is the base (`base` its text; `own` the own binding when the base is one name), its index steps the place's steps
# (`steps` their number; step k's expression span is read from the record, l2_place_step), its leaf the result --
# the last level's element type and model, or the Array value itself (the descriptor reference) with no step.
# `count` is the number of fields of the written run the place consumed.  `said` is the node of a located refusal
# (an index on no Array, a field after an index, the flat `[i][j]` form).  `expression` is the statement head's
# parsed tree when the place is a head.  Released by l2_array_place_release.
struct: L2ArrayPlace
    int: own
    LmP0Text: base
    int: type
    int: model
    @: L2HeadExpression expression
    int: count
    int: steps
    @: LmP0Node said
    L2Path: path
end: L2ArrayPlace

# A borrowed source environment for deferred checks and actual call sites.
# Names still resolve through the existing own/formal rows; this is not a
# binding table. source_method records the source owner separately when a
# partial callable borrows its model's body; unrelated offsets are not compared.
struct: L2SourceSite
    int: kind
    int: method
    int: current_method
    int: source_method
    int: count
    int: target
    int: scope_count
    @@: LmP0Node scopes
    int: excluded
    int: visibility
    size_t: visible_at
    @: void site
    @: LmP0Node source
end: L2SourceSite

# Translation-only physical child edges, in parent-before-child allocation order.
# A null parent starts at the selected callable occurrence, never its lexical node.
# These rows name existing graph places; they allocate no runtime graph objects.
struct: L2GraphPlace
    size_t: id
    int: method
    size_t: child
    @: L2GraphPlace parent
    @: L2GraphPlace allocated_next
end: L2GraphPlace

# A field's physical slot, independent of the lexical scope that resolves it.
# A null holder means the field owner's selected occurrence itself.
struct: L2GraphField
    @: L2GraphPlace holder
    size_t: child
end: L2GraphField

# A source container's committed producer, in one construction view. These
# records borrow P0 identity and disappear with the translation; they are not
# graph fields, source leaves, primitive wrappers or runtime binding metadata.
struct: L2SourceContainer
    size_t: id
    int: view_kind
    int: view_index
    # Actual callable owner, distinct from a projection site's view index.
    int: source_mi
    # Translator-only identity of a part of that occurrence: 0 is the
    # existing producer, 1 is var, 2 is body. It is not a runtime field.
    int: part
    @: LmP0Structure body
    int: fid
    int: inert
    int: root
    int: width
    int: temp
    int: fills
    int: shell_state
    @: L2GraphPlace place
    @: L2SourceField fields
    @: L2SourceContainer allocated_next
end: L2SourceContainer

# Original declaration cells of this actual source body, in its construction
# view. Only compiler planning owns these records; the graph keeps real cells.
struct: L2SourceField
    int: own
    int: slot
    # PLACE handle of the existing computed-output operand, preallocated
    # before any borrow; -1 for a separately written typed declaration cell.
    int: storage_temp
    L2GraphField: place
    @: L2SourceField next
end: L2SourceField

# PLACE records actual constructor/attachment edges. Temp numbers are private
# emission handles; only the resulting ordinary GraphPlace reaches backends.
struct: L2ConstructionTemp
    int: view_kind
    int: view_index
    int: index
    int: parent
    int: slot
    int: root
    @: L2GraphPlace place
    @: L2ConstructionTemp allocated_next
end: L2ConstructionTemp

# A source expression site's construction in one view (G1): the first written
# node of its field run and the run's count identify the exact P0 occurrence;
# the construction view and the selecting method keep each walk of that node
# apart (a T7 projection, a merge result's body). `temp` is the expression's
# root node in PLACE and resolves to an ordinary GraphPlace after bind. Only
# the translator reads these records; the graph keeps no site, name or P0.
struct: L2ExpressionSite
    int: view_kind
    int: view_index
    int: method
    const: @: LmP0Node node
    int: count
    # 0 = complete field run; 1 = source numeric LIT leaf; 2 = numeric binary
    # source node. Role 2 uses value_type as the graph-lowering layout:
    # bit 0 swaps source operands in physical child order, bit 1 means the
    # root is SUB(LIT 1, inner OP). This is translation-only, not graph data.
    # A conversion may wrap a leaf in another run.
    int: role
    int: value_type
    int: temp
    # 0 noted; 1 bound to `place`; 2 no owning attachment in its view; 3 two
    # sibling constructions of one run in one view (refused, never chosen).
    int: state
    @: L2GraphPlace place
    @: L2ExpressionSite allocated_next
end: L2ExpressionSite
