# One source order covers uniquely named nested Structure and primitive fields.
Outer:
    hStruct:
        int: p 3
    end: hStruct
    int: hInt 77
    Model:
        int: k 0
        int: last 0
        k: node\hStruct\p
        last: node\hInt
    end: Model
end: Outer
Outer\Model()
int: ok 7
if: Outer\Model\k != 3 || Outer\Model\last != 77
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
