# ABI parity guard — L1 port of mixa_cmdline_abi_probe_real.c (ticket 20260918-082421).
# offsetof is a C macro with no L1 spelling (c. pastes a call, not a preprocessor
# name). Field offsets are computed at run time via pointer arithmetic on a local
# store (same pattern as l2src/lmx_message_selftest.lm1). Output format strings
# are kept byte-identical to the C probe so L2-vs-real parity still diffs stdout.
predef: "mixa_manager/mixa_cmdline.h.lm1"
include: "<stdio.h>"

fn: main () int
    MixaCmdLine: store0
    @: MixaCmdLine p0
    p0: @ store0
    MixaCmdLineFaultVTable: store1
    @: MixaCmdLineFaultVTable p1
    p1: @ store1

    c.printf("MixaCmdLineFaultVTable sizeof=%zu\n", c.sizeof(c.MixaCmdLineFaultVTable))
    c.printf("MixaCmdLineFaultVTable on_alloc=%zu\n", (cast: (size_t) @ p1\on_alloc) - (cast: (size_t) p1))
    c.printf("MixaCmdLineFaultVTable ctx=%zu\n", (cast: (size_t) @ p1\ctx) - (cast: (size_t) p1))
    c.printf("MixaCmdLine sizeof=%zu\n", c.sizeof(c.MixaCmdLine))
    c.printf("MixaCmdLine cps=%zu\n", (cast: (size_t) @ p0\cps) - (cast: (size_t) p0))
    c.printf("MixaCmdLine len=%zu\n", (cast: (size_t) @ p0\len) - (cast: (size_t) p0))
    c.printf("MixaCmdLine cap=%zu\n", (cast: (size_t) @ p0\cap) - (cast: (size_t) p0))
    c.printf("MixaCmdLine cursor=%zu\n", (cast: (size_t) @ p0\cursor) - (cast: (size_t) p0))
    return: 0

