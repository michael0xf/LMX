    if: ni < 0 || c.lm_compiler_own_nsty_get(oi) != ni || ns_parent_cell[0][ni] >= 0 || ns_eternal_cell[0][ni] >= 0
        return: (cast: (int) (c.lm_compiler_rw_refuse(stmt, "a Structure-typed field")))
    # §7b: making a Model is a merge -- a receiver that copies graph state, so PRIM_PUB publishes before it; the result
