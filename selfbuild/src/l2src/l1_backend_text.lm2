end: l1_is_payload_int

# Original: l1src/l1trans.lm1:435
fn: l1_count_catch_params (const: (@: params c.LmP0Structure)) int
    @: field c.LmP0Field
    int: n 0
    if: params = 0
        return: (cast: (int) (0))
    field: params\first_field
    while: field != 0
        if: l1_node_ignored((cast: (const: @: c.LmP0Node) field\value)) = 0
            n: n + 1
        ---
        field: field\next
    return: (cast: (int) (n))
end: l1_count_catch_params

# Original: l1src/l1trans.lm1:713
fn: l1_write_text (@: out c.FILE; const: (@: text c.LmP0Text)) int
    if: out = 0 || text = 0 || text\data = 0
        return: (cast: (int) (1))
    if: text\length = 0U
        return: (cast: (int) (0))
    if: c.fwrite(text\data, 1U, text\length, out) != text\length
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: l1_write_text

# Original: l1src/l1trans.lm1:722
fn: l1_write_cstr (@: out c.FILE; const: (@: s char)) int
    if: out = 0 || s = 0
        return: (cast: (int) (1))
    if: c.fputs(s, out) < 0
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: l1_write_cstr

# Original: l1src/l1trans.lm1:729
fn: l1_write_span (@: out c.FILE; const: (@: data char); size_t: n) int
    if: out = 0
        return: (cast: (int) (1))
    if: n = 0U
        return: (cast: (int) (0))
    if: data = 0
        return: (cast: (int) (1))
    if: c.fwrite(data, 1U, n, out) != n
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: l1_write_span

# Original: l1src/l1trans.lm1:740
fn: l1_write_type_spelling (@: out c.FILE; const: (@: text c.LmP0Text); const: (@: path char); const: (@: source_node c.LmP0Node)) int
    if: l1_ident_is_reserved(text) != 0
        return: (cast: (int) (l1_error(path, source_node, "reserved L1 name")))
    if: l1_text_eq(text, "ulong")
        return: (cast: (int) (l1_write_cstr(out, "unsigned long")))
    if: l1_text_eq(text, "u8")
        return: (cast: (int) (l1_write_cstr(out, "uint8_t")))
    if: l1_text_eq(text, "u16")
        return: (cast: (int) (l1_write_cstr(out, "uint16_t")))
    if: l1_text_eq(text, "u32")
        return: (cast: (int) (l1_write_cstr(out, "uint32_t")))
    if: l1_text_eq(text, "u64")
        return: (cast: (int) (l1_write_cstr(out, "uint64_t")))
    if: l1_text_eq(text, "i8")
        return: (cast: (int) (l1_write_cstr(out, "int8_t")))
    if: l1_text_eq(text, "i16")
        return: (cast: (int) (l1_write_cstr(out, "int16_t")))
    if: l1_text_eq(text, "i32")
        return: (cast: (int) (l1_write_cstr(out, "int32_t")))
    if: l1_text_eq(text, "i64")
        return: (cast: (int) (l1_write_cstr(out, "int64_t")))
    return: (cast: (int) (l1_write_text(out, text)))
end: l1_write_type_spelling

# Original: l1src/l1trans.lm1:763
fn: l1_write_ident (@: out c.FILE; const: (@: text c.LmP0Text); const: (@: path char); const: (@: source_node c.LmP0Node)) int
    size_t: start 0U
    size_t: n 0U
    if: l1_ident_is_reserved(text) != 0
        return: (cast: (int) (l1_error(path, source_node, "reserved L1 name")))
    if: text = 0 || text\data = 0
        return: (cast: (int) (1))
    n: text\length
    if: n >= 2U && text\data[0] = 96 && text\data[n - 1U] = 96
        start: 1U
        n: n - 2U
    ---
    return: (cast: (int) (l1_write_span(out, (cast: (const: @: char) text\data + start), n)))
end: l1_write_ident

# Original: l1src/l1trans.lm1:777
fn: l1_error (const: (@: path char); const: (@: source_node c.LmP0Node); const: (@: msg char)) int
    size_t: line 0U
    size_t: column 0U
    if: source_node != 0
        line: source_node\span\line
        column: source_node\span\column
    if: path = 0
        path: ""
    c.fprintf(c.stderr, "l1trans error: %s:%zu:%zu: %s\n", path, line, column, msg)
    return: (cast: (int) (1))
end: l1_error

# Original: l1src/l1trans.lm1:788
fn: l1_node_ignored (const: (@: source_node c.LmP0Node)) int
    if: source_node = 0
        return: (cast: (int) (1))
    if: source_node\kind = c.LM_P0_NODE_DISABLED
        return: (cast: (int) (1))
    if: (source_node\flags & (c.LM_P0_NODE_INACTIVE | c.LM_P0_NODE_MIX)) != 0U
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: l1_node_ignored

# Original: l1src/l1trans.lm1:797
fn: l1_first_active_field (const: (@: source_node c.LmP0Node)) @: c.LmP0Field
    @: field c.LmP0Field
    if: source_node = 0 || source_node\kind != c.LM_P0_NODE_FRAME || source_node\as = 0 || source_node\as\frame = 0 || source_node\as\frame\body = 0
        return: (cast: (@: c.LmP0Field) (0))
    field: source_node\as\frame\body\first_field
    while: field != 0 && l1_node_ignored((cast: (const: @: c.LmP0Node) field\value))
        field: field\next
    return: (cast: (@: c.LmP0Field) (field))
end: l1_first_active_field

# Original: l1src/l1trans.lm1:806
fn: l1_error_if_extra_fields (@: field c.LmP0Field; const: (@: path char); const: (@: source_node c.LmP0Node); const: (@: msg char)) int
    while: field != 0 && l1_node_ignored((cast: (const: @: c.LmP0Node) field\value))
        field: field\next
    if: field != 0 && field\value != 0
        return: (cast: (int) (l1_error(path, source_node, msg)))
    return: (cast: (int) (0))
end: l1_error_if_extra_fields

# Original: l1src/l1trans.lm1:813
fn: l1_pointer_pointee_is_const_frame (const: (@: source_node c.LmP0Node)) int
    @: inner c.LmP0Field
    if: source_node = 0 || source_node\kind != c.LM_P0_NODE_FRAME || source_node\as = 0 || source_node\as\frame = 0
        return: (cast: (int) (0))
    if: l1_pointer_depth((cast: (const: @: c.LmP0Text) source_node\as\frame\head)) = 0U
        return: (cast: (int) (0))
    inner: l1_first_active_field(source_node)
    if: inner = 0 || inner\value = 0 || inner\value\kind != c.LM_P0_NODE_FRAME || inner\value\as = 0 || inner\value\as\frame = 0
        return: (cast: (int) (0))
    return: (cast: (int) (l1_text_eq((cast: (const: @: c.LmP0Text) inner\value\as\frame\head), "const")))
end: l1_pointer_pointee_is_const_frame

# Original: l1src/l1trans.lm1:824
fn: l1_nodes_adjacent (const: (@: a c.LmP0Node); const: (@: b c.LmP0Node)) int
    if: a = 0 || b = 0 || a\span = 0 || b\span = 0
        return: (cast: (int) (0))
    return: (cast: (int) (a\span\offset + a\span\length = b\span\offset))
end: l1_nodes_adjacent

# Original: l1src/l1trans.lm1:829
fn: l1_glue_pair (const: (@: a c.LmP0Text); const: (@: b c.LmP0Text)) int
    if: l1_text_eq(a, "<") && l1_text_eq(b, "<")
        return: (cast: (int) (1))
    if: l1_text_eq(a, ">") && l1_text_eq(b, ">")
        return: (cast: (int) (1))
    if: l1_text_eq(a, "=") && l1_text_eq(b, "=")
        return: (cast: (int) (1))
    if: l1_text_eq(a, "-") && l1_text_eq(b, ">")
        return: (cast: (int) (1))
    return: (cast: (int) (0))
end: l1_glue_pair

# Original: l1src/l1trans.lm1:840
fn: l1_scan_l1 (const: (@: source_node c.LmP0Node)) int
    @: field c.LmP0Field
    if: l1_node_ignored(source_node)
        return: (cast: (int) (0))
    if: source_node = 0
        return: (cast: (int) (0))
    if: source_node\kind = c.LM_P0_NODE_STRUCTURE
        field: source_node\as\structure\first_field
        while: field != 0
            if: l1_scan_l1((cast: (const: @: c.LmP0Node) field\value))
                return: (cast: (int) (1))
            field: field\next
        return: (cast: (int) (0))
    if: source_node\kind = c.LM_P0_NODE_FRAME
        if: l1_text_eq((cast: (const: @: c.LmP0Text) source_node\as\frame\head), "L1")
            return: (cast: (int) (1))
        return: (cast: (int) (0))
    return: (cast: (int) (0))
end: l1_scan_l1

# Original: l1src/l1trans.lm1:859
fn: l1_discard_temp (@: out c.FILE; const: (@: tmp char)) int
    if: out != 0
        c.fclose(out)
    if: tmp != 0
        c.remove(tmp)
    return: (cast: (int) (1))
end: l1_discard_temp

# Original: l1src/l1trans.lm1:877
fn: l1_slash_prefix_len (const: (@: text c.LmP0Text)) size_t
    size_t: i 0U
    if: text = 0 || text\data = 0
        return: (cast: (size_t) (0U))
    while: i < text\length && text\data[i] = 92
        i: i + 1U
    return: (cast: (size_t) (i))
end: l1_slash_prefix_len

# Original: l1src/l1trans.lm1:885
fn: l1_pointer_depth (const: (@: text c.LmP0Text)) size_t
    size_t: i 0U
    if: text = 0 || text\data = 0 || text\length = 0U
        return: (cast: (size_t) (0U))
    while: i < text\length
        if: text\data[i] != 64
            return: (cast: (size_t) (0U))
        i: i + 1U
    return: (cast: (size_t) (i))
end: l1_pointer_depth

# Original: l1src/l1trans.lm1:895
fn: l1_emit_stars (@: out c.FILE; size_t: n) int
    while: n != 0U
        if: l1_write_cstr(out, "*") != 0
            return: (cast: (int) (1))
        n: n - 1U
    return: (cast: (int) (0))
end: l1_emit_stars

# Original: l1src/l1trans.lm1:902
fn: l1_emit_prefixed_path (@: out c.FILE; const: (@: text c.LmP0Text); size_t: deref; const: (@: path char); const: (@: source_node c.LmP0Node)) int
    size_t: split
    if: out = 0 || text = 0 || text\data = 0 || deref = 0U || deref >= text\length
        return: (cast: (int) (l1_error(path, source_node, "prefix dereference expects an operand")))
    split: deref
    while: split < text\length && text\data[split] != 92
        split: split + 1U
    if: split = deref || l1_span_is_reserved((cast: (const: @: char) text\data), deref, split - deref) != 0
        return: (cast: (int) (l1_error(path, source_node, "reserved L1 name")))
    if: l1_write_cstr(out, "(") != 0 || l1_emit_stars(out, deref) != 0 || l1_write_span(out, (cast: (const: @: char) text\data + deref), split - deref) != 0 || l1_write_cstr(out, ")") != 0
        return: (cast: (int) (1))
    if: split < text\length
        return: (cast: (int) (l1_c_ident_from(out, text, split, path, source_node)))
    return: (cast: (int) (0))
end: l1_emit_prefixed_path

# Original: l1src/l1trans.lm1:917
fn: l1_c_ident_from (@: out c.FILE; const: (@: text c.LmP0Text); size_t: start; const: (@: path char); const: (@: source_node c.LmP0Node)) int
    size_t: i
    size_t: from
    size_t: stop
    int: skip_first 0
    int: first_seg 1
    if: text = 0 || text\data = 0
        return: (cast: (int) (0))
    if: start >= text\length
        return: (cast: (int) (0))
    stop: text\length
    if: stop - start >= 2U && text\data[start] = 96 && text\data[stop - 1U] = 96
        start: start + 1U
        stop: stop - 1U
    ---
    skip_first: 0
    if: l1_text_starts(text, "c.") && start = 2U
        skip_first: 1
    ---
    from: start
    i: start
    first_seg: 1
    while: i < stop
        if: text\data[i] = 92
            if: i > from
                if: first_seg = 0 || skip_first = 0
                    if: l1_span_is_reserved((cast: (const: @: char) text\data), from, i - from) != 0
                        return: (cast: (int) (l1_error(path, source_node, "reserved L1 name")))
                    ---
                ---
                if: l1_write_span(out, (cast: (const: @: char) text\data + from), i - from) != 0
                    return: (cast: (int) (1))
                ---
            ---
            if: l1_write_cstr(out, "->") != 0
                return: (cast: (int) (1))
            i: i + 1U
            from: i
            first_seg: 0
            continue
        ---
        i: i + 1U
    if: from >= stop
        return: (cast: (int) (0))
    if: first_seg = 0 || skip_first = 0
        if: l1_span_is_reserved((cast: (const: @: char) text\data), from, stop - from) != 0
            return: (cast: (int) (l1_error(path, source_node, "reserved L1 name")))
        ---
    ---
    return: (cast: (int) (l1_write_span(out, (cast: (const: @: char) text\data + from), stop - from)))
end: l1_c_ident_from

# Original: l1src/l1trans.lm1:968
fn: l1_c_atom_nested_receiver (const: (@: text c.LmP0Text); size_t: start) int
    size_t: i
    size_t: k
    int: depth
    int: in_str
    int: in_chr
    int: esc
    int: slot
    unsigned: ch
    c.LmL1NestedScratch: scratch
    if: text = 0 || text\data = 0
        return: (cast: (int) (0))
    k: 0U
    while: k < 64U
        scratch\qmark[k]: 0
        k: k + 1U
    i: start
    depth: 0
    in_str: 0
    in_chr: 0
    esc: 0
    while: i < text\length
        ch: (cast: (unsigned) (cast: (uchar) text\data[i]))
        if: esc != 0
            esc: 0
            i: i + 1U
            continue
        if: in_str != 0
            if: ch = 92U
                esc: 1
            ---
            if: ch != 92U && ch = 34U
                in_str: 0
            ---
            i: i + 1U
            continue
        if: in_chr != 0
            if: ch = 92U
                esc: 1
            ---
            if: ch != 92U && ch = 39U
                in_chr: 0
            ---
            i: i + 1U
            continue
        if: ch = 34U
            in_str: 1
            i: i + 1U
            continue
        if: ch = 39U
            in_chr: 1
            i: i + 1U
            continue
        if: ch = 40U
            depth: depth + 1
            i: i + 1U
            continue
        if: ch = 41U
            if: depth > 0
                depth: depth - 1
            ---
            i: i + 1U
            continue
        if: ch = 63U
            slot: depth
            if: slot > 63
                slot: 63
            ---
            scratch\qmark[slot]: scratch\qmark[slot] + 1
            i: i + 1U
            continue
        if: ch = 58U
            slot: depth
            if: slot > 63
                slot: 63
            ---
            if: scratch\qmark[slot] > 0
                scratch\qmark[slot]: scratch\qmark[slot] - 1
            else:
                return: (cast: (int) (1))
            ---
            i: i + 1U
            continue
        i: i + 1U
