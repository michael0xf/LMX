Addition:
    int: first
    int: second
    return: int
    apply:
        return: first + second

Demo:
    return: int
    run:
        throws: copy(partial\throws)
        @: add5 partial(Addition\apply; (5))
        return: add5(1) * 1000000 + partial(Addition\apply; (100))(1) * 1000 + add5(1)
