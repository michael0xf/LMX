# FACTORY (the author, 2026-10-05): `@: h f(a)` receives a factory's result; this row wrote `h: f a` until then.
# Explicit applications of held h2 note 12, 34, 56, 78 and 90 in its copied
# lexical root. Full merge also copies note; the original root stays at 0.
# The harness observes 1234567890 in the copy as well as the original 0.
int: trace 0

fn: note (int: v) int
    node\trace: node\trace * 100 + v
    return: 0
end: note

fn: seen () int
    return: node\trace
end: seen

fn: make2 (int: n) fn: (int: x; int: y) int
    fn: f2 (int: x; int: y) int
        return: n + note(x * 10 + y)
    return: f2

@: h2 make2(100)
h2(1 2)
h2: 3 4

fn: use () int
    h2(5 6)
    h2: 7 8
    h2(y: 0; x: 9)
    return: 0
end: use

int: z use()
int: ok 7
if: seen() != 0
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
