        # as at a trailer's return (l2_emit_ret_tr).
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") && l2_m_ret[mi] != 8 && l2_input_model(mi, -1) >= 0 && (l2_return_opaque(fr\body\first_field, lm_compiler_count_active(fr\body), mi) != 0 || l2_d105_dynamic(@ return_source) != 0) && l2_emit_model_admit_computed(mi, l2_input_model(mi, -1), @ return_source, l2_tok, ind, 1, 0, -1, mi, mi, -1, 0, "l2_result_context", return_context) != 0
            return: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") && l2_m_ret[mi] != 8 && l2_input_model(mi, -1) >= 0 && l2_return_opaque(fr\body\first_field, lm_compiler_count_active(fr\body), mi) = 0 && l2_d105_dynamic(@ return_source) = 0 && l2_emit_model_admit_computed(mi, l2_input_model(mi, -1), @ return_source, l2_tok, ind, 1, 0, -1, -1, -1, -1, 0, "l2_result_context", return_context) != 0
            return: 1
        if: lm_compiler_frame_head(stmt, "return") && l2_m_ret[mi] != 8 && l2_input_model(mi, -1) < 0 && lm_compiler_tramp_class(mi) = 5 && lm_compiler_emit_result_context(return_context, ind) != 0
            return: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") && l2_m_ret[mi] != 8 && l2_emit_publish(ind) != 0
            return: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") && l2_m_ret[mi] != 8 && l2_emit_poll(mi, ind) != 0
            return: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") && l2_m_ret[mi] != 8 && (l2_m_throws = 0 || l2_m_throws[mi] = 0) && c.fprintf(l2_out, "%sreturn: %s\n", ind, l2_tok\data) < 0
            return: 1
        # In a throwing callable the declared value goes to the normal output and
        # the control status is the return. The throw slot is left untouched.
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") && l2_m_ret[mi] != 8 && l2_m_throws != 0 && l2_m_throws[mi] != 0 && c.fprintf(l2_out, "%sl2_out_result[0]: %s\n%sreturn: 0\n", ind, l2_tok\data, ind) < 0
            return: 1
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") && l2_m_ret[mi] != 8
            field: lm_compiler_next_active(field\next)
        # A bare write of an argument's name is the parameter's (bafca4c) unless a same-name field declared in scope has
        # bound the name (l2_formal_row): -1 then, and the parameter branch below writes l2_p<mi>_<k>.
        if: lm_compiler_frame_head(stmt, "if") = 0 && l2_is_char_decl(stmt) = 0 && lm_compiler_frame_head(stmt, "return") = 0
            oi: l2_own_find_decl(mi, fr\head, stmt)
