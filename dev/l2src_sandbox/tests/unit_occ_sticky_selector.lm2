# GROK-COLON-OCCURRENCE-20260922-02. Unified model. No method-level `int: x` on
# multi-occ names: that decl row is not an assignment, so a later assignment does
# not split (l2_own_add). Graph dest of occ 0 is still not readable as node\x
# when the field is assignment-only (leftover from FABLE-67). Snapshots are \[N].
fn: poke7 (@: int p) int
    \p: 7
    return: 0
end: poke7
fn: poke9 (@: int p) int
    \p: 9
    return: 0
end: poke9
fn: nop () int
    return: 0
end: nop

fn: before (int: ba) int
    poke7(@: ba)
    int: ba
    ba: 1
    nop()
    node\ba: 100
    nop()
    c.printf: "BEFORE %d %d\n" ba node\ba
    return: 0
end: before

fn: between (int: bt) int
    bt: 1
    nop()
    poke7(@: bt)
    nop()
    bt: 2
    nop()
    if: \[0]bt != 7
        return: 1
    if: \[1]bt != 2
        return: 2
    c.printf: "BETWEEN %d\n" bt
    return: 0
end: between

fn: after (int: af) int
    int: af
    af: 1
    nop()
    poke9(@: af)
    node\af: 100
    nop()
    c.printf: "AFTER %d %d\n" af node\af
    return: 0
end: after

fn: none (int: nn; int: go) int
    poke7(@: nn)
    node\nn: 100
    nop()
    c.printf: "NONE %d %d\n" nn node\nn
    if: go = 0
        return: 0
    int: nn
    nn: 1
    nop()
    c.printf: "NONE+ %d %d\n" nn node\nn
    return: 0
end: none

fn: after_last (int: al) int
    al: 1
    al: 2
    poke9(@: al)
    nop()
    if: \[0]al != 1
        return: 1
    if: \[1]al != 9
        return: 2
    c.printf: "LAST %d\n" al
    return: 0
end: after_last

before(3)
between(3)
after(3)
none(3, 0)
none(3, 1)
after_last(3)
return: 0
