# Probe 2, slice 172: a method's working value published under the program's write guard (the const branch root
# makes the program guarded, so bump's publication of count is lmx_publish_int with guard 1). Exits: 81 bump's own
# result, 83 the root's count after the call, 84 a second method's fresh read of count's cell, 7 all equal 2.
int: count 1
independent:
    const:
        immutable:
            (): Frozen
                int: value 7
            end: Frozen
        end: immutable
    end: const
end: independent
fn: bump () int
    count: count + 1
    return: count
end: bump
fn: read_count () int
    return: count
end: read_count
int: got 0
got: bump()
if: got != 2
    sendMessage: exit(exit_code: 81; stdout: ""; stderr: "")
    return
if: read_count() != 2
    sendMessage: exit(exit_code: 84; stdout: ""; stderr: "")
    return
if: count != 2
    sendMessage: exit(exit_code: 83; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
