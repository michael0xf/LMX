# Предлагаемые профили, а не изменение действующей спецификации или ядра.
# Код type/uninit:type разрешается через штатный type-контракт при интеграции.
# Все модели и настройки остаются данными единственного графа.
NumericProfiles:
    bigint:
        []char: semanticName "bigint"
        []char: storage "one owned LibTomMath value"
        []char: backend "base:libtommath"
        []char: target "LMX::tommath"
        []char: nativeInit "lmx_ref_bigint_parse"
        []char: nativeAdd "lmx_ref_bigint_add"
        []char: nativeText "lmx_ref_bigint_text"
        []char: physicalChange "proposed numeric leaf + uninit:bigint; integrate with ordinary type constructors"
        []char: status "C99_REFERENCE_TESTED; LMX_INTEGRATION_NOT_RUN"
    decimal:
        []char: semanticName "decimal"
        []char: storage "one owned MPDecimal value"
        []char: backend "base:mpdecimal"
        []char: target "LMX::mpdec"
        []char: nativeInit "lmx_ref_decimal_parse"
        []char: nativeAdd "lmx_ref_decimal_add"
        []char: nativeText "lmx_ref_decimal_text"
        []char: context "BridgeData\\DecimalContext; supplied explicitly for each operation"
        []char: alternateBackend "decNumber and LibBF bfdec_t via explicit value/context conversion; no second public decimal type"
        []char: physicalChange "proposed numeric leaf + uninit:decimal; integrate with ordinary type constructors"
        []char: status "C99_REFERENCE_TESTED; LMX_INTEGRATION_NOT_RUN"
    real:
        []char: semanticName "real"
        []char: storage "owned LibBF bf_t payload; actor-owned backend context"
        []char: backend "numeric_extra:libbf"
        []char: target "LMX::real"
        []char: alternateBackend "numeric_extra:libtomfloat is experimental; explicit conversion/profile admission, no duplicate real type"
        []char: nativeInit "lmx_ref_real_parse"
        []char: nativeAdd "lmx_ref_real_add"
        []char: nativeSqrt "lmx_ref_real_sqrt"
        []char: nativeText "lmx_ref_real_text"
        []char: context "BridgeData\\RealContext; precision in bits, rounding and exponent profile explicit"
        []char: physicalChange "proposed numeric leaf + uninit:real; arbitrary binary precision distinct from machine double"
        []char: admission "2 <= precisionBits <= BF_PREC_MAX; resource budget; supported deterministic rounding mode"
        []char: conversion "binary64 is an explicit checked narrowing, never the definition of real"
        []char: limitations "finite requested precision and exponent range; not a symbolic representation of all real numbers"
        []char: status "C99_REFERENCE_TESTED; LMX_INTEGRATION_NOT_RUN"
    binaryFormats:
        []char: semanticName "binary16 / binary32 / binary64 / binary128"
        []char: storage "existing fixed-width words / Tensor element profiles; no library-named primitive"
        []char: backend "numeric_extra:softfloat; numeric_extra:fp16; native machine profiles"
        []char: physicalChange "none required merely to expose these wire/storage formats"
        []char: admission "explicit encoding, rounding, NaN and subnormal policy; no arbitrary-real equivalence"
        []char: status "BACKENDS_C99_TESTED; LMX_ADAPTERS_REQUIRE_IMPLEMENTATION"
    fixedPoint:
        []char: semanticName "fixed-point Q16.16"
        []char: storage "existing i32 with explicit scale profile"
        []char: backend "numeric_extra:libfixmath; numeric_extra:libfixmatrix"
        []char: physicalChange "none; no duplicate scalar type for each fixed-point library"
        []char: admission "rounding, saturation/overflow sentinel and dimension limits explicit"
        []char: status "BACKENDS_C99_TESTED; LMX_ADAPTERS_REQUIRE_IMPLEMENTATION"
    rational:
        []char: semanticName "rational"
        []char: storage "ordinary Structure with two bigint values"
        []char: backend "numeric_extra:imath; LibTomMath pair implementation remains an independent alternative"
        []char: physicalChange "none"
        []char: admission "nonzero denominator; normalize sign and gcd by selected profile"
        []char: status "MODEL_DESIGN; REQUIRE_IMPLEMENTATION"
    complex:
        []char: semanticName "complex"
        []char: storage "ordinary Structure with two values of one scalar profile"
        []char: physicalChange "none"
        []char: conversion "C complex / KissFFT / cglm pair conversion, never pointer cast"
        []char: status "MODEL_DESIGN; REQUIRE_IMPLEMENTATION"
