---
    Observed:
        int: seen 12
    end: Observed
---
Model:
    int: a 0
    int: b 0
end: Model
fn: f (@: s Model) int
    return: (((s \ a) * 10) + (s \ b))
end: f
sub: main () (
    S:
        int: a 1
        int: b 2
    end: S
)
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) (f S)
end: main
main:
