        if: c.lm_compiler_primary_sizeof_value(value, mi, @ operand, 0) != 0
            return: (cast: (int) (c.lm_compiler_error(path, (cast: (const: @: c.LmP0Node) (value\node)), "sizeof: no known storage contract for this operand")))
        if: c.lm_compiler_primary_sizeof_type(value) != 0
