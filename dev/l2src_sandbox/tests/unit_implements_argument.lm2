# Adapted from lingvamyxa_prev/tests/trans_implements_argument.lm2.
# takeEq body does not field-follow Equatable paths: empty uses is true, so
# Plain implements Equatable under ThinConsumer. Call-site refuse of a used
# field is unit_invalid_implements_used_field.lm2.

Plain:
    size_t: toString 0U
end: Plain

Equatable:
    size_t: equals 0U
end: Equatable

ThinConsumer:
    size_t: extra 0U
end: ThinConsumer

fn: m () int
    size_t: q
    q: 1U
    return: 0
end: m

fn: main () int
    if: implements(Plain, Equatable, ThinConsumer) != 1
        return: 1
    if: implements(Plain, Equatable, Equatable) != 0
        return: 2
    return: 0
end: main
