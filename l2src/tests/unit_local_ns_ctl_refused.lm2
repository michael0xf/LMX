# A control body in a method's own named Structure -- here an `if:` -- is not built yet (slice 2c-2): its Structure would
# be a child of S's occurrence, which the method builds at run time, and nothing builds it there yet.  Refused where
# it stands.
fn: m () int
    S:
        size_t: v 4U
        if: v = 4U
            v: 5U
        v: v + 0U
    S()
    return: 7
end: m
int: r 0
r: m()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
