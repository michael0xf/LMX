predef: "lmx_own.lm1"
predef: "lmx_pool.lm1"
predef: "lmx_chars.lm1"
predef: "lmx_arena.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# Carries 21.6's worked case verbatim, because it is the case that makes
# no-reload load-bearing rather than a nicety:
#
#     outer entry: C x = 1, clean
#     outer calls inner
#     inner explicitly writes outer's graph field x = 2
#     outer returns without assigning its local x
#
# A flush-all implementation would wrongly overwrite 2 with its stale cached 1.
# The conforming dirty-only implementation writes nothing on outer return.

# The callee. It does what 21.6 says inner does: writes the caller's graph
# field through an explicit path, which is not routed through anyone's cache.
fn: inner_writes_graph (@: Lmx node; @: void value) int
return: lmx_field_write(node, 0U, value)

# The caller, written the way a generated body would be: load at entry, work in
# the local, publish dirty before the outbound call, and NOT reload after it.
fn: outer_calls_inner (@: Lmx node; @: void value) int
    @: LmxOwnLocal x
    x: (cast: (@: LmxOwnLocal) calloc(1U, c.sizeof(c.LmxOwnLocal)))
    if: x = 0
        return: 1
    if: lmx_own_load(x, node, 0U) != 0
        free(x)
        return: 1
    # No assignment to the local here, so it stays clean and the checkpoint
    # before the call must publish nothing.
    if: lmx_own_checkpoint(x) != 0
        free(x)
        return: 1
    if: inner_writes_graph(node, value) != 0
        free(x)
        return: 1
    # No reload. The local still carries its entry snapshot.
    # Exit checkpoint: still clean, so still nothing is published.
    if: lmx_own_checkpoint(x) != 0
        free(x)
        return: 1
    free(x)
return: 0

fn: main () int
    @: Lmx node
    @: LmxOwnLocal local
    @: void one
    @: void two
    @: void three
    int: failures
    LmxArena: arena
    failures: 0

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        fputs("lmx: arena open failed\n", l1_stdout())
        return: 1
    if: lmx_chars_init(@ arena) != 0
        fputs("lmx: char table init failed\n", l1_stdout())
        return: 1
    node: (cast: (@: Lmx) calloc(1U, c.sizeof(c.Lmx)))
    local: (cast: (@: LmxOwnLocal) calloc(1U, c.sizeof(c.LmxOwnLocal)))
    if: node = 0 || local = 0
        fputs("lmx: allocation failed\n", l1_stdout())
        return: 1
    if: lmx_arena_refs_open_owned(@ arena, node, 2U) != 0
        fputs("lmx: branch open failed\n", l1_stdout())
        return: 1
    # The slot array this Structure's fields live in is an array of the arena like every
    # other: it is what makes its cells classifiable, and the arena is what frees it.
    if: lmx_range_classify(@ arena, node\data) != c.LMX_KIND_CHILDREN
        fputs("lmx: the slot array is not an array of the arena\n", l1_stdout())
        failures: failures + 1
    one: lmx_char_cell(@ arena, 49)
    two: lmx_char_cell(@ arena, 50)
    three: lmx_char_cell(@ arena, 51)

    # 21.6's case, exactly. Field starts at 1.
    if: lmx_field_write(node, 0U, one) != 0
        fputs("lmx: initial field write failed\n", l1_stdout())
        return: 1
    if: outer_calls_inner(node, two) != 0
        fputs("lmx: outer failed\n", l1_stdout())
        return: 1
    if: lmx_field_read(node, 0U) != two
        fputs("lmx: outer republished a clean local over the callee write\n", l1_stdout())
        failures: failures + 1
    if: lmx_char_value(lmx_field_read(node, 0U)) != 50
        fputs("lmx: the graph does not hold what the callee wrote\n", l1_stdout())
        failures: failures + 1

    # Dirty is set only by an executed write, and a clean local publishes
    # nothing however many checkpoints it passes.
    if: lmx_own_load(local, node, 0U) != 0
        fputs("lmx: load failed\n", l1_stdout())
        return: 1
    if: local\dirty != 0
        fputs("lmx: a freshly loaded local is dirty\n", l1_stdout())
        failures: failures + 1
    if: lmx_field_write(node, 0U, three) != 0
        fputs("lmx: explicit write failed\n", l1_stdout())
        return: 1
    if: lmx_own_checkpoint(local) != 0 || lmx_own_checkpoint(local) != 0
        fputs("lmx: checkpoint failed\n", l1_stdout())
        return: 1
    if: lmx_field_read(node, 0U) != three
        fputs("lmx: a clean local was published over an explicit write\n", l1_stdout())
        failures: failures + 1

    # The local still carries its snapshot: reading it does not see the graph.
    if: lmx_own_read(local) != two
        fputs("lmx: the local silently reloaded from the graph\n", l1_stdout())
        failures: failures + 1

    # An executed write makes it dirty, and the next checkpoint publishes it.
    lmx_own_write(local, one)
    if: local\dirty = 0
        fputs("lmx: an executed write did not set dirty\n", l1_stdout())
        failures: failures + 1
    if: lmx_field_read(node, 0U) != three
        fputs("lmx: writing the local reached the graph without a checkpoint\n", l1_stdout())
        failures: failures + 1
    if: lmx_own_checkpoint(local) != 0
        fputs("lmx: publishing checkpoint failed\n", l1_stdout())
        return: 1
    if: lmx_field_read(node, 0U) != one
        fputs("lmx: the checkpoint did not publish the dirty value\n", l1_stdout())
        failures: failures + 1
    if: local\dirty != 0
        fputs("lmx: a successful store did not clear dirty\n", l1_stdout())
        failures: failures + 1

    # 21.5: the local is aimed at the exact occurrence it was loaded from, and
    # publishing does not go looking the field up again. That occurrence is the
    # slot &children[0], not the child value it currently holds.
    if: local\from != lmx_arena_ref_cell(node, 0U)
        fputs("lmx: the local is not bound to its own occurrence\n", l1_stdout())
        failures: failures + 1

    # A sibling own field is untouched throughout: only OwnUsed fields are
    # loaded or stored, and other node fields are neither.
    if: lmx_field_read(node, 1U) != 0
        fputs("lmx: an unused sibling field was written\n", l1_stdout())
        failures: failures + 1

    # There is no branch release any more: the slot array is an array of the arena, so
    # releasing the arena is what retires its entry and frees its storage -- together
    # with the interned table the arena holds.
    if: lmx_arena_release(@ arena) != 0
        fputs("lmx: arena release failed\n", l1_stdout())
        failures: failures + 1
    ---
    free(node)
    free(local)

    if: failures != 0
        c.printf("lmx own selftest FAILED checks=%d\n", failures)
        return: 1
    fputs("lmx own selftest ok\n", l1_stdout())
    return: 0
