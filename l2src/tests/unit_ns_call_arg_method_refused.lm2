# In a method, `Model:` + fields with Model an existing named Structure -- a callable (book §9 after 55c1abc) -- is
# Model's call with that Structure as its argument, never an assignment to Model.  A named Structure's call with an
# argument is not built yet: refused where it stands, the implementation's status, not a rule.  (Before the ticket it
# was taken for the assignment with admission to Model.)
Model:
    size_t: value 1U
fn: m () int
    Model:
        size_t: other 2U
    return: 7
end: m
int: r 0
r: m()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
