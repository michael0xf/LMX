include: "<stddef.h>"
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_message.h.lm1"
predef: "l2src/lmx_service.h.lm1"
predef: "l2src/lmx_manager.h.lm1"

# Orphan retention is a policy over ordinary children of R0. There is no orphan
# membership list: the sole membership source remains R0's graph Array<@LmxThread>.
# Per-child clocks live in the same Thread; this handle keeps only the Array owner
# and an aggregate evidence counter.
define: LMX_ORPHAN_OK 0
define: LMX_ORPHAN_INVALID 1
define: LMX_ORPHAN_FULL 2
define: LMX_ORPHAN_FULL_GRAPH 3

struct: LmxOrphanLedger
    @: LmxThread owner
    size_t: reclaimed
end: LmxOrphanLedger

prototype:
    fn: lmx_orphan_init (@: LmxOrphanLedger ledger; @: LmxThread owner) int
    fn: lmx_orphan_adopt (@: LmxOrphanLedger ledger; @: LmxMsg orphan; @: LmxArena orphan_arena; @: LmxThread thread; @: LmxService service; @: LmxManager manager; ulong: now; ulong: limit) int
    fn: lmx_orphan_maintain (@: LmxOrphanLedger ledger; @: LmxService service; @: LmxManager manager; ulong: now) int
    fn: lmx_orphan_count (@: LmxOrphanLedger ledger) size_t
    fn: lmx_orphan_reclaimed (@: LmxOrphanLedger ledger) size_t
    # Teardown only disarms retention. The ordinary synchronous cascade removes each physical
    # child reference and then releases or attaches its arena.
    fn: lmx_orphan_release (@: LmxOrphanLedger ledger; @: LmxService service; @: LmxManager manager) int
end: prototype
