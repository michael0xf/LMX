---
    Observed:
        int: seen 0
        int: calls 0
    end: Observed
---
fn: producer () int
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ calls) (((shared \ Observed) \ calls) + 1)
    return: 7
end: producer
fn: g (int: a 1; int: b 2) int
    return: ((a * 10) + b)
end: g
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) (g (:= b (int b (producer))))
end: main
main:
