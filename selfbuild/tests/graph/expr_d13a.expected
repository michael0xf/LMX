---
    Observed:
        int: seen 0
        int: v 100
        int: ticks 0
    end: Observed
---
fn: tick () int
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ ticks) (((shared \ Observed) \ ticks) + 1)
    return: ((shared \ Observed) \ ticks)
end: tick
sub: main () (
    int: v 100
    int: seen 5
)
    @: shared (node [] 0)
    :=: seen (0 && (:= v (tick)))
    :=: ((shared \ Observed) \ seen) seen
    :=: ((shared \ Observed) \ v) v
end: main
main:
