predef: "../l2src_sandbox/lmx.h.lm1"
predef: "../l2src_sandbox/lmx_arena.h.lm1"
predef: "../l2src_sandbox/lmx_implements.h.lm1"

# L3-01 receiver: consume an already-built graph as the L3 subset
# N1-N3. Not admission (#admission). Unsupported nodes fail; never METHOD.addr.

define: L3_OK 0
define: L3_INVALID 1
define: L3_UNSUPPORTED 2
define: L3_ABSENT 3
define: L3_RETURN 4

# Body-node codes for L3 v1. 1 matches current RETURN encoding.
# 32+ are L3 forms, not Fable BODY_NODES 3-14.
define: L3_NODE_RETURN 1
define: L3_NODE_IF 32
define: L3_NODE_WHILE 33
define: L3_NODE_MATCH 34
define: L3_NODE_EACH 35
define: L3_NODE_YIELD 36
define: L3_NODE_FINALLY 37
define: L3_NODE_THROW 38
define: L3_NODE_EXPECT_INT 39
define: L3_WHILE_CAP 10000

prototype:
    # Root must be a Structure (empty is present). Walks fields by index.
    fn: l3_recv_eval (@: LmxArena arena; @: Lmx root) int
    # N4-N8: execute callable M. Slot 0 is LmxCallable. Never METHOD.addr.
    fn: l3_exec_run (@: LmxArena arena; @: Lmx node) int
    fn: l3_exec_run_on (@: LmxArena arena; @: Lmx node; @: Lmx subject) int
    fn: l3_follow_path (@: LmxArena arena; @: Lmx start; @: Lmx path) int
    fn: l3_path_leaf (@: LmxArena arena; @: Lmx start; @: Lmx path; @: void out) int
    # N10: used index-paths of receiver, then its test callables. Not names.
    fn: l3_implements_paths (@: LmxArena arena; @: Lmx candidate; @: Lmx paths) int
    fn: l3_admit (@: LmxArena arena; @: Lmx candidate; @: Lmx receiver) int
end: prototype
