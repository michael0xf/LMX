# Все исходные 112 компонента и 20 дополнений получают общую модель данных.
# Это план адаптации; он не утверждает, что каждый API уже прошёл L3 приёмку.
# Наличие модели не заменяет точную сигнатуру, ownership и проверки конкретного API.
BackendModels:
    component_001:
        char[]: component "base:curl"
        char[]: profile "network"
        char[]: models "Buffer Resource Callback Packet Error KeyValue"
        char[]: converters "span cString resource callback numericNarrow"
        char[]: policy "Native connection stays with one owner; explicit retained buffer/callback lifetime."
        char[]: source "third_party/lmx_c99_compact/SOURCES.json"
        char[]: status "DESIGN_REQUIRES_PER_API_REVIEW"
#
    component_002:
        char[]: component "base:mbedtls"
        char[]: profile "crypto"
        char[]: models "Buffer Secret Resource Callback Time Error"
        char[]: converters "span secret resource callback time"
        char[]: policy "Select exact algorithm and key/nonce/tag lengths; no reinterpretation across providers."
        char[]: source "third_party/lmx_c99_compact/SOURCES.json"
        char[]: status "DESIGN_REQUIRES_PER_API_REVIEW"
