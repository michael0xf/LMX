fn: l1_fn_grow () int
    char@@: fn_names_cell (cast: (char@@) (@ c.l1_fn_names))
    int@@: fn_th_cell (cast: (int@@) (@ c.l1_fn_th))
    int@@: fn_thn_cell (cast: (int@@) (@ c.l1_fn_thn))
    int@@: fn_ar_cell (cast: (int@@) (@ c.l1_fn_ar))
    int@: fn_cap_cell (cast: (int@) (@ c.l1_fn_cap))
    int: cap
    int: probe 0
    size_t: intsz
    char@: names
    int@: th
    int@: thn
    int@: ar
    intsz := c.sizeof(probe)
    if: fn_cap_cell[0] = 0
        cap := 8
    else:
        if: fn_cap_cell[0] > 1073741823
            return: (cast: (int) (1))
        ---
        cap := fn_cap_cell[0] * 2
    ---
    names := (cast: (char@) c.realloc((cast: (@) fn_names_cell[0]), (cast: (size_t) cap) * 64U))
    if: names = 0
        return: (cast: (int) (1))
    fn_names_cell[0] := names
    th := (cast: (int@) c.realloc((cast: (@) fn_th_cell[0]), (cast: (size_t) cap) * 8U * intsz))
    if: th = 0
        return: (cast: (int) (1))
    fn_th_cell[0] := th
    thn := (cast: (int@) c.realloc((cast: (@) fn_thn_cell[0]), (cast: (size_t) cap) * intsz))
    if: thn = 0
        return: (cast: (int) (1))
    fn_thn_cell[0] := thn
    ar := (cast: (int@) c.realloc((cast: (@) fn_ar_cell[0]), (cast: (size_t) cap) * intsz))
    if: ar = 0
        return: (cast: (int) (1))
    fn_ar_cell[0] := ar
    fn_cap_cell[0] := cap
    return: (cast: (int) (0))
end: l1_fn_grow

# Original: l1src/l1trans.lm1:495
fn: l1_fn_ensure (const: (c.LmP0Text@: text)) int
    char@@: fn_names_cell (cast: (char@@) (@ c.l1_fn_names))
    int@@: fn_thn_cell (cast: (int@@) (@ c.l1_fn_thn))
    int@@: fn_ar_cell (cast: (int@@) (@ c.l1_fn_ar))
    int@: fnn_cell (cast: (int@) (@ c.l1_fnn))
    int@: fn_cap_cell (cast: (int@) (@ c.l1_fn_cap))
    c.LmL1TextScratch64: buf_scratch
    int: i
    i := l1_fn_find(text)
    if: i >= 0
        return: (cast: (int) (i))
    if: c.l1_ident_to_buf((cast: (char@) buf_scratch\buffer), 64U, text) != 0
        return: (cast: (int) (-1))
    if: fnn_cell[0] >= fn_cap_cell[0]
        if: l1_fn_grow() != 0
            return: (cast: (int) (-1))
        ---
    ---
    c.strcpy(fn_names_cell[0] + fnn_cell[0] * 64, (cast: (const: char@) buf_scratch\buffer))
    fn_thn_cell[0][fnn_cell[0]] := 0
    fn_ar_cell[0][fnn_cell[0]] := -1
    i := fnn_cell[0]
    fnn_cell[0] := fnn_cell[0] + 1
    return: (cast: (int) (i))
end: l1_fn_ensure

# Original: l1src/l1trans.lm1:515
fn: l1_fn_add_throw (int: fn_i; int: code) int
    int@@: fn_th_cell (cast: (int@@) (@ c.l1_fn_th))
    int@@: fn_thn_cell (cast: (int@@) (@ c.l1_fn_thn))
    int@: fnn_cell (cast: (int@) (@ c.l1_fnn))
    int: n
    int: j 0
    if: fn_i < 0 || fn_i >= fnn_cell[0] || code = 0
        return: (cast: (int) (1))
    n := fn_thn_cell[0][fn_i]
    while: j < n
        if: fn_th_cell[0][fn_i * 8 + j] = code
            return: (cast: (int) (0))
        j := j + 1
    if: n >= 8
        return: (cast: (int) (1))
    fn_th_cell[0][fn_i * 8 + n] := code
    fn_thn_cell[0][fn_i] := n + 1
    return: (cast: (int) (0))
end: l1_fn_add_throw

# Original: l1src/l1trans.lm1:531
fn: l1_fn_is_throwing (const: (c.LmP0Text@: text)) int
    int@@: fn_thn_cell (cast: (int@@) (@ c.l1_fn_thn))
    int: i
    i := l1_fn_find(text)
    if: i < 0
        return: (cast: (int) (0))
    return: (cast: (int) (fn_thn_cell[0][i] != 0))
end: l1_fn_is_throwing

# Original: l1src/l1trans.lm1:538
fn: l1_fn_register_frame (const: (c.LmP0Frame@: frame); const: (char@: path); const: (c.LmP0Node@: source_node)) int
    int@@: fn_ar_cell (cast: (int@@) (@ c.l1_fn_ar))
    c.LmP0Field@: field
    const: (c.LmP0Node@: name_node)
    const: (c.LmP0Node@: params_node)
    const: (c.LmP0Node@: third)
    const: (c.LmP0Node@: fourth)
    const: (c.LmP0Text@: fn_name)
    c.LmP0Field@: pf
    c.LmP0Field@: throws_field
    const: (c.LmP0Node@: body_node)
    int: ar
    int: fn_i
    int: code
    if: frame = 0 || frame\body = 0
        return: (cast: (int) (0))
    field := frame\body\first_field
    name_node := 0
    params_node := 0
    third := 0
    fourth := 0
    while: field != 0
        if: c.l1_node_ignored(field\value) = 0
            if: name_node = 0
                name_node := field\value
            else:
                if: params_node = 0
                    params_node := field\value
                else:
                    if: third = 0
                        third := field\value
                    else:
                        if: fourth = 0
                            fourth := field\value
                        ---
                    ---
                ---
            ---
        ---
        field := field\next
    if: name_node = 0
        return: (cast: (int) (0))
    fn_name := 0
    if: name_node\kind = c.LM_P0_NODE_ATOM
        fn_name := name_node\as\atom
    else:
        if: name_node\kind = c.LM_P0_NODE_FRAME
            fn_name := name_node\as\frame\head
            if: params_node = 0
                params_node := name_node
                third := 0
                fourth := 0
            ---
        ---
    ---
    if: fn_name = 0
        return: (cast: (int) (0))
    ar := 0
    pf := 0
    if: params_node != 0 && params_node\kind = c.LM_P0_NODE_STRUCTURE && params_node\as\structure != 0
        pf := params_node\as\structure\first_field
        while: pf != 0
            if: c.l1_node_ignored(pf\value) = 0
                ar := ar + 1
            ---
            pf := pf\next
        ---
    ---
    fn_i := l1_fn_ensure(fn_name)
    if: fn_i < 0
        return: (cast: (int) (c.l1_error(path, source_node, "too many functions")))
    fn_ar_cell[0][fn_i] := ar
    body_node := 0
    if: c.l1_text_eq(frame\head, "sub")
        body_node := third
    else:
        body_node := fourth
    ---
    throws_field := 0
    if: body_node != 0 && body_node\kind = c.LM_P0_NODE_STRUCTURE && body_node\as\structure != 0
        throws_field := body_node\as\structure\first_field
        while: throws_field != 0 && c.l1_node_ignored(throws_field\value)
            throws_field := throws_field\next
        if: throws_field != 0 && throws_field\value != 0 && throws_field\value\kind = c.LM_P0_NODE_FRAME && c.l1_text_eq(throws_field\value\as\frame\head, "throws")
            field := 0
            if: throws_field\value\as\frame\body != 0
                field := throws_field\value\as\frame\body\first_field
            ---
            while: field != 0
                if: c.l1_node_ignored(field\value) = 0
                    if: field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM
                        code := l1_throw_intern((cast: (const: c.LmP0Text@) field\value\as\atom))
                        if: code = 0
                            return: (cast: (int) (c.l1_error(path, field\value, "too many throw names")))
                        if: l1_fn_add_throw(fn_i, code) != 0
                            return: (cast: (int) (1))
                        ---
                    ---
                ---
                field := field\next
            ---
        ---
    ---
    return: (cast: (int) (0))
end: l1_fn_register_frame

# Original: l1src/l1trans.lm1:642
fn: l1_fn_register_node (const: (c.LmP0Node@: source_node); const: (char@: path)) int
    c.LmP0Field@: field
    if: source_node = 0 || c.l1_node_ignored(source_node) != 0
        return: (cast: (int) (0))
    if: source_node\kind = c.LM_P0_NODE_STRUCTURE
        if: source_node\as\structure = 0
            return: (cast: (int) (0))
        field := source_node\as\structure\first_field
        while: field != 0
            if: l1_fn_register_node((cast: (const: c.LmP0Node@) field\value), path) != 0
                return: (cast: (int) (1))
            field := field\next
        return: (cast: (int) (0))
    if: source_node\kind != c.LM_P0_NODE_FRAME || source_node\as\frame = 0
        return: (cast: (int) (0))
    if: c.l1_text_eq(source_node\as\frame\head, "fn") || c.l1_text_eq(source_node\as\frame\head, "sub")
        return: (cast: (int) (l1_fn_register_frame((cast: (const: c.LmP0Frame@) source_node\as\frame), path, source_node)))
    if: c.l1_text_eq(source_node\as\frame\head, "prototype") || c.l1_text_eq(source_node\as\frame\head, "external") || c.l1_text_eq(source_node\as\frame\head, "os") || c.l1_text_eq(source_node\as\frame\head, "win") || c.l1_text_eq(source_node\as\frame\head, "default") || c.l1_text_eq(source_node\as\frame\head, "ifdef") || c.l1_text_eq(source_node\as\frame\head, "L1")
        if: source_node\as\frame\body = 0
            return: (cast: (int) (0))
        field := source_node\as\frame\body\first_field
        while: field != 0
            if: l1_fn_register_node((cast: (const: c.LmP0Node@) field\value), path) != 0
                return: (cast: (int) (1))
            field := field\next
        return: (cast: (int) (0))
    return: (cast: (int) (0))
end: l1_fn_register_node

