        []char: component "base:kissfft"
        []char: profile "numeric"
        []char: models "Tensor Complex ComplexBuffer NumericStatus Resource Error"
        []char: converters "tensorLayout tensorBackend complexBackend numericNarrow resource"
        []char: policy "Complex component conversion preserves the exact float/double/fixed-point build and transform normalization. No cast of arbitrary Complex Structure; setup lifetime, input/output overlap, alignment and lengths follow the selected FFT API."
        []char: source "third_party/lmx_c99_compact/SOURCES.json"
        []char: status "DESIGN_REQUIRES_PER_API_REVIEW"
