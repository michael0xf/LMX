# return: h\p. The field type is Plain. Equatable requires equals.
# The Consumer of a return is the required descriptor.

Plain:
    size_t: toString 0U
end: Plain

Equatable:
    size_t: equals 0U
end: Equatable

Holder:
    Plain: p
end: Holder

fn: pick (Holder: h) Equatable
return: h\p

fn: go (Holder: h) int
return: 4
