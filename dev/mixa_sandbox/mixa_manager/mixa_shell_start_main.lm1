predef: "mixa_manager/mixa_shell_start.h.lm1"
predef: "mixa_manager/mixa_backend_headless.h.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# Product entry of the shell port. The letter is mixa_shell_start
# (Mixa\start). This main is not mixa_app_main, not mixa_app_main_msg,
# and not mixa_app_controller. It does not post and it does not wait
# on GetMessage.
#
# The run is bounded. --headless <root> <steps> binds the headless
# table as Shell's native word, sends the start letter, takes that
# many mixa_shell_turn calls, then closes the word and Files.
# A missing flag or a bound that is not a positive integer is a
# refusal. There is no default bound and no window loop.

fn: main (int: argc; @: @(char) argv) int
    const: @(char root)
    const: @(MixaBackendVTable vt)
    @: MixaCellMetrics metrics
    @: MixaShellOwner shell
    MixaFm: fm
    int: bound
    int: steps
    int: events
    int: turn_events
    int: shown
    int: refused
    int: rc
    int: fail
    int: opened
    fail: 0
    opened: 0
    bound: 0
    steps: 0
    events: 0
    shown: 0
    refused: 0
    rc: 0
    metrics: 0
    shell: 0
    vt: 0
    root: 0
    if: argc < 4 || c.strcmp(argv[1], "--headless") != 0
        c.printf("MIXA_START status=FAIL reason=usage steps=0 bound=0 shown=0 refused=0 events=0 rc=0\n")
        return: 2
    ---
    root: argv[2]
    bound: c.atoi(argv[3])
    if: bound <= 0
        c.printf("MIXA_START status=FAIL reason=bad-bound steps=0 bound=0 shown=0 refused=0 events=0 rc=0\n")
        return: 2
    ---
    vt: mixa_backend_headless_table()
    if: vt = 0
        fail: 1
    ---
    if: fail = 0
        metrics: (cast: (@: MixaCellMetrics) c.calloc(1U, c.sizeof(c.MixaCellMetrics)))
        if: metrics = 0
            fail: 2
        ---
    ---
    if: fail = 0
        metrics\text_cell_width: 8U
        metrics\text_cell_height: 8U
        metrics\upper_cell_width: 8U
        metrics\upper_cell_height: 8U
        metrics\pointer_cell_width: 8U
        metrics\pointer_cell_height: 8U
        shell: (cast: (@: MixaShellOwner) c.calloc(1U, c.sizeof(c.MixaShellOwner)))
        if: shell = 0
            fail: 2
        ---
    ---
    if: fail = 0
        rc: mixa_fm_init(@ fm, root, 0, 0)
        if: rc != MIXA_FM_OK
            fail: 3
        else:
            opened: 1
        ---
    ---
    if: fail = 0
        rc: mixa_shell_start(shell, @ fm, vt, root, 4U, 4U, metrics)
        if: rc != 0
            fail: 4
        ---
    ---
    if: fail = 0
        while: steps < bound && fail = 0
            turn_events: 0
            rc: mixa_shell_turn(shell\pump, shell\surface, @ turn_events)
            if: rc != 0
                fail: 5
            else:
                events: events + turn_events
                steps: steps + 1
            ---
        ---
    ---
    if: shell != 0
        shown: shell\shown
        refused: shell\refused
        if: opened != 0
            mixa_shell_drop_rows(shell, @ fm)
        ---
        mixa_shell_native_close(shell)
        c.free(shell)
    ---
    if: opened != 0
        mixa_fm_release(@ fm)
    ---
    if: metrics != 0
        c.free(metrics)
    ---
    if: fail = 1
        c.printf("MIXA_START status=FAIL reason=no-backend steps=%d bound=%d shown=%d refused=%d events=%d rc=%d\n", steps, bound, shown, refused, events, rc)
        return: 1
    ---
    if: fail = 2
        c.printf("MIXA_START status=FAIL reason=nomem steps=%d bound=%d shown=%d refused=%d events=%d rc=%d\n", steps, bound, shown, refused, events, rc)
        return: 1
    ---
    if: fail = 3
        c.printf("MIXA_START status=FAIL reason=init steps=%d bound=%d shown=%d refused=%d events=%d rc=%d\n", steps, bound, shown, refused, events, rc)
        return: 1
    ---
    if: fail = 4
        c.printf("MIXA_START status=FAIL reason=start steps=%d bound=%d shown=%d refused=%d events=%d rc=%d\n", steps, bound, shown, refused, events, rc)
        return: 1
    ---
    if: fail = 5
        c.printf("MIXA_START status=FAIL reason=turn steps=%d bound=%d shown=%d refused=%d events=%d rc=%d\n", steps, bound, shown, refused, events, rc)
        return: 1
    ---
    c.printf("MIXA_START status=OK steps=%d bound=%d shown=%d refused=%d events=%d\n", steps, bound, shown, refused, events)
return: 0
