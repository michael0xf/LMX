    Lists:
        @: l0 (("ifndef APR_ANYLOCK_H";"if APR_HAS_THREADS");("Function-like macro has no independent C symbol; role: runtime_operation.");("ifndef APR_ANYLOCK_H";"else /* APR_HAS_THREADS */");("LMX::apr_util");("ifndef APR_BUCKETS_H";"ifdef APR_BUCKET_DEBUG");("ifndef APR_BUCKETS_H";"else");("Function-like macro has no independent C symbol; role: declaration_annotation.");("ifndef APR_BUCKETS_H");("Function-like macro has no independent C symbol; role: name_or_type_generator.");("ifndef APR_BUCKETS_H";"if APR_HAS_MMAP");("ifndef APR_HOOKS_H");("Function-like macro has no independent C symbol; role: generic_code_generator.");("ifndef APR_OPTIONAL_H");("ifndef APR_HOOKS_H";"else");("ifndef APR_OPTIONAL_HOOK_H");("ifndef APU_ERRNO_H");("ifndef APR_XML_H");("ifndef APR_LDAP_INIT_H";"if APR_HAS_LDAP";"else");("Function-like macro has no independent C symbol; role: runtime_operation.";"The selected APR-Util profile has no LDAP or external crypto driver. The retained abstract contract must not be exposed as a working backend without enabling and testing its dependency.");("ifndef APU_VERSION_H";"ifndef APU_STRINGIFY");("ifndef APR_BASE64_H");();("ifndef APR_MD5_H");("Callback type/slot, not an exported callable.");("Variadic API requires a fixed typed adapter; do not forward L3 values through C varargs.";"Callback typedef parameter(s): apr_brigade_flush. Use an actor-owned trampoline/lifetime contract.");("Callback typedef parameter(s): apr_brigade_flush. Use an actor-owned trampoline/lifetime contract.");("Callback parameter needs actor-owned trampoline/lifetime and exception translation.");("ifndef APR_CRYPTO_H";"if APU_HAVE_CRYPTO");("The selected APR-Util profile has no LDAP or external crypto driver. The retained abstract contract must not be exposed as a working backend without enabling and testing its dependency.");("ifndef APR_DATE_H");("ifndef APR_DBD_H");("APR-Util DBD abstraction is retained but no external DBD driver is selected. An exported dispatcher is not proof that a requested database provider can be opened."))
        @: l1 (("APR-Util DBD abstraction is retained but no external DBD driver is selected. An exported dispatcher is not proof that a requested database provider can be opened.";"Variadic API requires a fixed typed adapter; do not forward L3 values through C varargs.");("ifndef APR_DBM_H");("Callback typedef parameter(s): apr_opt_fn_t. Use an actor-owned trampoline/lifetime contract.");("ifndef APR_LDAP_OPTION_H";"if APR_HAS_LDAP");("ifndef APR_LDAP_INIT_H";"if APR_HAS_LDAP");("ifndef APR_LDAP_URL_H";"if APR_HAS_LDAP");("ifndef APU_LDAP_REBIND_H";"if APR_HAS_LDAP");("ifndef APR_MD4_H");("ifndef APR_MD4_H";"if APR_HAS_XLATE");("ifndef APR_MD4_H";"else");("Function-like macro has no independent C symbol; role: configuration_or_alias.");("ifndef APR_MEMCACHE_H");("ifndef APR_QUEUE_H";"if APR_HAS_THREADS");("ifndef APR_REDIS_H");("ifndef APR_RESLIST_H");("Callback typedef parameter(s): apr_reslist_constructor, apr_reslist_destructor. Use an actor-owned trampoline/lifetime contract.");("ifndef APR_RMM_H");("ifndef APR_SDBM_H");("ifndef APR_SHA1_H");("ifndef APR_SIPHASH_H");("ifndef APR_STRMATCH_H";"if defined(DOXYGEN)");("ifndef APR_STRMATCH_H";"else");("ifndef APR_STRMATCH_H");("ifndef APU_THREAD_POOL_H";"if APR_HAS_THREADS");("ifndef APR_URI_H");("ifndef APR_UUID_H");("ifndef APR_XLATE_H");("ifndef APR_XLATE_H";"ifdef APR_NOT_DONE_YET");("ifndef APR_XML_H";"if APR_CHARSET_EBCDIC");("ifndef APU_VERSION_H";"ifndef APU_VERSION_ONLY"))
