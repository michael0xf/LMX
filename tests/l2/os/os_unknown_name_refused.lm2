# The default branch names a method that no branch declares: each branch is read on its own, on every host.
os:
    win:
        fn: os_one () int
            return: 1
        end: os_one
    default:
        fn: os_one () int
            return: os_helper()
        end: os_one
end: os
sendMessage: exit(exit_code: os_one(); stdout: ""; stderr: "")
return
