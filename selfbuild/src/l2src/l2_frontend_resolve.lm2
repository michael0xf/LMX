            step\nsrow: slot
        if: locus = 2
            step\nsrow: c.lm_compiler_mrs_slot_row(res, slot)
        if: c.lm_compiler_seg_occurrence(pd, off, len, (cast: (@: int) (@ step\segocc))) != 0
            step\segocc: 0 - 1
        # Qualification: a nested Structure of a qualified original stays qualified; an own-declared field of the
        # space `node` names is its method's.
        if: original != 0 && kind = 2 && ent >= 0 && ns_eternal_cell[0][ent] >= 0
            protected: 1
        if: locus = 6 && c.lm_compiler_own_in_eternal(field_own) != 0
            protected: 1
        # The pointer code of a reference field's cell (kind 10): every segment resolver answers it in `ent` (the
        # declaration's l2_oc_ft, a Structure's l2_nsf_ref, a merge result's l2_mrs_ent) before the pointee replaces
