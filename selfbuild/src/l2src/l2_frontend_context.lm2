    return: (cast: (int) (idx))
end: lm_compiler_pap_method_of

fn: lm_compiler_pap_sole (int: mi) @: c.LmP0Node
    @@@: m_body_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_m_body))
    @: m_n_cell int (cast: (@: int) (@ c.l2_m_n))
    @@@: m_node_cell c.LmP0Node (cast: (@@@: c.LmP0Node) (@ c.l2_m_node))
    @: f c.LmP0Field
    if: mi < 0 || mi >= m_n_cell[0] || m_body_cell[0][mi] = 0 || m_body_cell[0][mi]\as = 0 || m_body_cell[0][mi]\as\structure = 0
        return: (cast: (@: c.LmP0Node) (0))
    if: m_node_cell[0][mi] != 0 && m_node_cell[0][mi]\as != 0 && c.lm_compiler_ret_tr(m_node_cell[0][mi]\as\frame) != 0
        return: (cast: (@: c.LmP0Node) (0))
    if: c.lm_compiler_count_active(m_body_cell[0][mi]\as\structure) != 1
        return: (cast: (@: c.LmP0Node) (0))
    f: c.lm_compiler_next_active(m_body_cell[0][mi]\as\structure\first_field)
    if: f = 0
        return: (cast: (@: c.LmP0Node) (0))
    return: (cast: (@: c.LmP0Node) (f\value))
end: lm_compiler_pap_sole

fn: lm_compiler_source_count_owner (int: mi) int
    @@: ns_local_cell int (cast: (@@: int) (@ c.l2_ns_local))
    @@: ns_parent_cell int (cast: (@@: int) (@ c.l2_ns_parent))
    @@: ns_proc_cell int (cast: (@@: int) (@ c.l2_ns_proc))
    @@: own_mi_cell int (cast: (@@: int) (@ c.l2_own_mi))
    int: own lm_compiler_method_source_own(mi)
    int: ni c.lm_compiler_m_nsof(mi)
    if: own >= 0
        return: (cast: (int) (own_mi_cell[0][own]))
    if: ni >= 0
        if: ns_parent_cell[0][ni] >= 0
            return: (cast: (int) (ns_proc_cell[0][ns_parent_cell[0][ni]]))
        return: (cast: (int) (ns_local_cell[0][ni]))
    return: (cast: (int) (c.lm_compiler_mad_host_of(mi)))
end: lm_compiler_source_count_owner

fn: lm_compiler_has_own_ty (int: ty) int
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @@: own_ty_cell int (cast: (@@: int) (@ c.l2_own_ty))
    int: i 0
    while: i < own_n_cell[0]
        if: own_ty_cell[0][i] = ty
            return: (cast: (int) (1))
        i: i + 1
    return: (cast: (int) (0))
end: lm_compiler_has_own_ty

fn: lm_compiler_mres_find (int: mi; const: (@: t c.LmP0Text)) int
    return: (cast: (int) (c.lm_compiler_mres_of_own(lm_compiler_resolved_own(mi, t))))
end: lm_compiler_mres_find
