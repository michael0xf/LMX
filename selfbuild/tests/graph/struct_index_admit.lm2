# Raw index replacement accepts a pointer independently of the former field.
# Plan M11 5v: the declarations of ordinary Structures live in the data part of main; the root holds places and the call main().
sub: main () (
    int: j 40
    S:
        int: a 1
        N(int: x 7)
)
    S[1] := @j
main()
int: seen main\data\S\j
