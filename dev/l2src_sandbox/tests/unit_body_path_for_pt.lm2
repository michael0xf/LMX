# Point inside a for. The merge scratch must include that declaration. for\pt\x is 4.
Point:
    int: x 0
    int: y 0
end: Point
fn: nop () int
    return: 0
fn: test () int
    int: answer 64
    for: int(i, 0) (i < 1) i++
        pt: merge: Point
        pt\x: 4
        nop()
        if: for\pt\x = 4
            answer: 7
    ---
    return: answer
int: r 0
r: test()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
