try { [Console]::OutputEncoding=[System.Text.Encoding]::UTF8 } catch {}
# FE92 with RT92 on stage92 (kernel declaration headers regenerated by RT92
# from writer92): held78 first, then the two draft79 witnesses
# (computed-absence79: the bare return; no-candidate79: the split pointer,
# real 11/13 and the preserved selected pointer), then owner73c (V63; long
# compile). Tool: generator92.
$p='C:\Nyasha_Planet\LMX\build2\codex_fix250generationchain01'
$P2='C:/Nyasha_Planet/LMX/build2/codex_fix250generationchain01'
$repo='C:/Nyasha_Planet/LMX'
$tool="$p\cold-generator92\tool92-parts\lmxtool-tool.exe"
$term="$p\pins\suites92.terminal.txt"
$live=Get-CimInstance Win32_Process -Filter "Name = 'l2trans.exe' OR Name = 'l1trans.exe' OR Name = 'cc1.exe' OR Name = 'lmxtool-tool.exe' OR Name = 'lmxtool.exe'"
if ($live) { $live | Select-Object ProcessId,Name | Out-String | Write-Output; throw 'pipeline already live' }
if (-not (Test-Path -LiteralPath "$p\cold-candidate92\fe92\l2trans.exe")) { throw 'nofe92' }
if (-not (Test-Path -LiteralPath "$p\cold-candidate92\rt92\driver.o")) { throw 'nort92' }
if (Test-Path -LiteralPath $term) { throw 'terminalexists' }
Remove-Item Env:CPATH,Env:C_INCLUDE_PATH,Env:CPLUS_INCLUDE_PATH,Env:LIBRARY_PATH -ErrorAction SilentlyContinue
$suiteRows = @(
  ,@('held-forward78', 'held-forward78.tsv')
  ,@('computed-absence79', 'computed-absence79.tsv')
  ,@('no-candidate79', 'no-candidate79.tsv')
  ,@('owner-values73c-hidden55', 'owner-values73c-callable-hidden55.tsv')
)
foreach ($suiteRow in $suiteRows) {
  $name="$($suiteRow[0])-fe92-rt92-suite"
  $out="$p\$name-01"
  $cwd="$p\$name-run-01"
  if ((Test-Path -LiteralPath $out) -or (Test-Path -LiteralPath $cwd)) { throw "exists $name" }
  $argv=@('suite', "$P2/pins/$($suiteRow[1])", $repo, "$P2/cold-candidate92", "$P2/cold-candidate48/full48/g2/frontend", "$P2/cold-candidate92/fe92/l2trans.exe", "$P2/cold-candidate92/rt92/driver.o", "$P2/$name-01", "$P2/cold-candidate92/rt92/driver-observe.o")
  if ($argv.Count -ne 9) { throw "argv $($argv.Count)" }
  New-Item -ItemType Directory -Path $cwd | Out-Null
  Set-Location -LiteralPath $cwd
  Add-Content -LiteralPath $term -Value ([DateTime]::UtcNow.ToString('o') + " start $name argv: 0 entry 0 -- " + ($argv -join ' ')) -Encoding utf8
  & $tool 0 entry 0 -- @argv *> "$p\pins\$name-01.log"
  $e=$LASTEXITCODE
  Add-Content -LiteralPath $term -Value ([DateTime]::UtcNow.ToString('o') + " $name exit=$e") -Encoding utf8
}
Write-Output 'SUITES92 done'
