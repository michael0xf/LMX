        private: int: i 0
        while: i < MapVector\size(items)
            private: @: item MapVector\get(items; i)
            private: int: role 0
            while: role < 2
                private: @: boundary (copy(MapBoundaryModel))
                boundary\item := item
                boundary\cursor := item\cursor
                if: role != 0
                    boundary\cursor := item\tail
                boundary\tail := role
                boundary\position := MapCursor\position(boundary\cursor)
                private: int: at 0
