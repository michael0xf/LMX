--- /dev/null
+++ b/patterns/examples/validation/lazy_completeness_20261123.json
@@ -0,0 +1,104 @@
+{
+  "date": "2026-11-23",
+  "scope": "First-success cache within one owner; genuine public behavior, not runtime execution",
+  "sources": [
+    "LMX_Fn_Receivers/src/generic_wrappers.lmx",
+    "LMX_Fn_Receivers/src/generic_runtime.lmx",
+    "examples/libraries/haskell/Lazy.hs"
+  ],
+  "existing_lmx_guards": {
+    "busy_cycle_check": true,
+    "failure_reset_finally": true,
+    "cached_exact_value_record": true,
+    "public_declared_error_delivery": true
+  },
+  "hardening": "Register existing finally guard before changing status to Busy; keep cache-hit and Busy rejection ahead of guard. No new public failure or ThreadId check.",
+  "cases": [
+    {
+      "id": "LC01",
+      "case": "Construct without forcing",
+      "expected": "target/action counter remains0",
+      "lmx_status": "NOT_RUN",
+      "haskell_status": "NOT_RUN"
+    },
+    {
+      "id": "LC02",
+      "case": "Force successful double result twice",
+      "expected": "2.5,2.5; actual double preserved; target counter1",
+      "lmx_status": "NOT_RUN",
+      "haskell_status": "NOT_RUN"
+    },
+    {
+      "id": "LC03",
+      "case": "Force successful void/() result twice",
+      "expected": "void is a successful cached result, not absence; counter1",
+      "lmx_status": "NOT_RUN",
+      "haskell_status": "NOT_RUN"
+    },
+    {
+      "id": "LC04",
+      "case": "First attempt throws declared/user failure, next succeeds",
+      "expected": "original name/payload or exception retained; state resets; second attempt executes; counter2",
+      "lmx_status": "NOT_RUN",
+      "haskell_status": "NOT_RUN"
+    },
+    {
+      "id": "LC05",
+      "case": "Action recursively forces its own cache, failure uncaught in action",
+      "expected": "FxLazyCycle/LazyCycle; outer reset permits later nonrecursive retry",
+      "lmx_status": "NOT_RUN",
+      "haskell_status": "NOT_RUN"
+    },
+    {
+      "id": "LC06",
+      "case": "Action catches inner recursive error and continues",
+      "expected": "inner rejected call must not clear outer Busy state; another recursive force still rejects; outer may eventually publish Ready",
+      "lmx_status": "NOT_RUN",
+      "haskell_status": "NOT_RUN"
+    },
+    {
+      "id": "LC07",
+      "case": "once first input1 returns10, then input2",
+      "expected": "both calls return10; target counter1; later inputs do not key a new cache entry",
+      "lmx_status": "NOT_RUN",
+      "haskell_status": "NOT_RUN"
+    },
+    {
+      "id": "LC08",
+      "case": "once input1 fails, input2 succeeds20, input3 afterward",
+      "expected": "failure preserved;20,20; two actual target executions",
+      "lmx_status": "NOT_RUN",
+      "haskell_status": "NOT_RUN"
+    },
+    {
+      "id": "LC09",
+      "case": "Foreign owner attempt",
+      "expected": "LMX transport/arena ownership forbids sharing mutable cache; Haskell LazyForeignOwner leaves cell untouched; owning caller remains valid",
+      "lmx_status": "NOT_RUN",
+      "haskell_status": "NOT_RUN"
+    },
+    {
+      "id": "LC10",
+      "case": "Haskell async failure during restored action, caught by owner harness",
+      "expected": "Cold reset and same exception; same owner may retry; LMX analog is ordinary owner unwinding, not injected async exceptions",
+      "lmx_status": "NOT_RUN",
+      "haskell_status": "NOT_RUN"
+    },
+    {
+      "id": "LC11",
+      "case": "Failure while setting up the cache miss after guard registration",
+      "expected": "LMX state does not remain Busy; registered finally resets unsuccessful state",
+      "lmx_status": "NOT_RUN",
+      "haskell_status": "NOT_RUN"
+    },
+    {
+      "id": "LC12",
+      "case": "Cache hit with caller-side argument expressions/receiving validation",
+      "expected": "ordinary preparation rules still apply; only target body execution is skipped",
+      "lmx_status": "NOT_RUN",
+      "haskell_status": "NOT_RUN"
+    }
+  ],
+  "status": "NOT_RUN",
+  "no_runtime_claim": true
+}
