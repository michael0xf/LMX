# T6b. twice is nested in the host: it is walked, its native function returns 0. The host cannot
# call it as C -- k would be 0. Refused, located.
fn: makeAdder (int: n) fn: (int: x) int
    fn: twice (int: y) int
        return: y * 2
    int: k (twice: n)
    fn: addN (int: x) int
        return: k + x
    return: addN

add5: makeAdder 3
int: a (add5: 1)
sendMessage: exit(exit_code: a; stdout: ""; stderr: "")
return
