# Both groups of the fn header are one input data (the author 2026-11-15): x is declared there twice -- the formal
# and `int: x 100` -- and the call refuses 3; the root computed declarations stay their records in the graph.
fn: declaration (int: x) int (int: x 100)
    int: x 2
    return: x
end: declaration
fn: bare (int: x) int (int: x 100)
    x := 2
    return: x
end: bare
int: caller 7
int: declared_result declaration(caller)
int: declared_data declaration\data\x
int: bare_result bare(caller)
int: bare_data bare\data\x
