# A sole actual obtained by execution that may be a Structure is computed once and weighed by W and E
# (fable Р130; the book, #declaration-selection, step 4): f(merge(A; B)) opens the merged Structure, a = 1, b = 2.
(
    Observed:
        int: seen 0
)
fn: f (int: a; int: b) int
    return: a * 10 + b
sub: main () (
    A(int: a 1)
    B(int: b 2)
)
    @: shared node[0]
    shared\Observed\seen := f(merge(A; B))
main()
