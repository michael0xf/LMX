---
    Observed:
        int: seen 50909
    end: Observed
---
@: shared (data [] 0)
fn: c () int
    :=: x 9
    return: x
end: c
fn: b (int: x) int
    int: r (c)
    return: ((x * 100) + r)
end: b
fn: a () int
    int: x 5
    int: rb (b)
    return: ((x * 10000) + rb)
end: a
