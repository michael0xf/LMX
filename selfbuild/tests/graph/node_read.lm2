# The reserved word node names the space above the code a launch runs (the book, node; plan M11 5b part 2): for a method
# of the unit root that space is the root, so `node\hits` reads the root's field -- seen is 4.
# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: seen 0
)
@: shared data[0]
int: hits 4
fn: read () int
    return: node\hits
int: seen read()

sub: main ()
    shared\Observed\seen := seen
main()
