# Plan M7, step 4 (the author, 2026-11-10; the book, forms-declare-or-call): a structural form declares or calls and writes
# no known place.  A field through a path is a known place: `P\f: 2` is refused -- it is written `P\f := 2`.
P:
    int: f 1
end: P
fn: run () int
    P\f: 2
    return: P\f
end: run
send: exit(exit_code: run(); stdout: ""; stderr: "")
return
