# S's statements are checked whether or not S runs (slice 2c-2): S has a procedure because its body has a statement, as
# a unit named Structure does (§12), and `nosuch` -- a free name nobody binds, the method included -- is refused where
# it stands, though the method never executes S.
fn: m () int
    S:
        size_t: v 4U
        v: nosuch
    return: 7
end: m
int: r 0
r: m()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
