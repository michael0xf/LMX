fn: lm_compiler_payload_same (const: (@: a c.LmP0Text); const: (@: b c.LmP0Text)) int
    const: (@: ad char)
    const: (@: bd char)
    size_t: an
    size_t: bn
    if: a = 0 || b = 0 || a\data = 0 || b\data = 0
        return: (cast: (int) (0))
    ad: a\data
    an: a\length
    bd: b\data
    bn: b\length
    if: an >= 2U && ad[0] = 96 && ad[an - 1U] = 96
        ad: ad + 1U
        an: an - 2U
    if: bn >= 2U && bd[0] = 96 && bd[bn - 1U] = 96
        bd: bd + 1U
        bn: bn - 2U
    if: an != bn
        return: (cast: (int) (0))
    return: (cast: (int) (c.memcmp(ad, bd, an) = 0))
end: lm_compiler_payload_same

fn: lm_compiler_value_argument_extent (@: values c.L2ValueSpan; int: n; int: start) int
    int: cursor start + 1
    if: values = 0 || n < 1 || start < 0 || start >= n
        return: (cast: (int) (0))
    @: start_value c.L2ValueSpan values + start
    if: start_value\grammar = 0
        return: (cast: (int) (0))
    while: cursor < n
        @: cursor_value c.L2ValueSpan values + cursor
        if: cursor_value\grammar != 0
            return: (cast: (int) (cursor - start))
        if: cursor >= n - 1
            return: (cast: (int) (0))
        @: next_value c.L2ValueSpan values + cursor + 1
        if: next_value\grammar = 0
            return: (cast: (int) (0))
        cursor: cursor + 2
    ---
    return: (cast: (int) (cursor - start))
end: lm_compiler_value_argument_extent

fn: lm_compiler_value_argument_ref (@: values c.L2ValueSpan; int: n; const: (@: at c.LmP0Node); @: out c.L2ValueSpan) int
    int: k 0
    int: count 0
    if: out = 0 || n < 0 || (n > 0 && values = 0)
        return: (cast: (int) (1))
    lm_compiler_value_span_ref(out, 0, 0)
    out\node: (cast: (@: c.LmP0Node) at)
    if: n = 1
        c.memcpy(out, values, c.sizeof(c.L2ValueSpan))
        return: (cast: (int) (0))
    while: k < n
        @: element c.L2ValueSpan values + k
        if: element\count < 1 || count > c.INT_MAX - element\count
            return: (cast: (int) (1))
        count: count + element\count
        k: k + 1
    ---
    if: n > 0
        out\first: values\first
        out\node: values\node
    out\count: count
    out\grammar: 3
    out\values: values
    out\value_n: n
    return: (cast: (int) (0))
