--- /dev/null
+++ b/src/l2src/lmx_clock.lm2
@@ -0,0 +1,37 @@
+predef: "l2src/lmx_win32_api.h.lm1"
+predef: "l2src/lmx_clock.h.lm1"
+
+# The cycle owns the clock. Records receive readings from their caller.
+# Preserve the portable uint64_t ABI rather than routing a wide reading through ulong.
+fn: lmx_clock_now () c.uint64_t
+    return: (cast: (c.uint64_t) c.GetTickCount64())
+
+fn: lmx_clock_ticks () ulong
+    return: (cast: (ulong) c.GetTickCount64())
+
+fn: lmx_clock_elapsed (c.uint64_t: start; c.uint64_t: now) c.uint64_t
+    if: now < start
+        return: 0U
+    ---
+    return: now - start
+
+fn: lmx_clock_since (c.uint64_t: start) c.uint64_t
+    return: lmx_clock_elapsed(start, (cast: (c.uint64_t) c.GetTickCount64()))
+
+# A stored deadline has the platform word width, read directly from the platform clock.
+fn: lmx_clock_word () size_t
+    return: (cast: (size_t) c.GetTickCount64())
+
+fn: lmx_clock_half () size_t
+    size_t: zero 0U
+    return: (zero - 1U) / 2U + 1U
+
+fn: lmx_deadline_passed (size_t: deadline; size_t: now) int
+    if: now - deadline < lmx_clock_half()
+        return: 1
+    return: 0
+
+fn: lmx_deadline_wait (size_t: deadline; size_t: now) size_t
+    if: lmx_deadline_passed(deadline, now) != 0
+        return: 0U
+    return: deadline - now
