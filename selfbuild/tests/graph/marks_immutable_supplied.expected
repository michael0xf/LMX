---
    Observed:
        int: seen 12345678
    end: Observed
---
@: shared (data [] 0)
sub: main () (
    Data:
        immutable:
            int: a 1
            int: b 2
        end: immutable
        immutable:
            int: c 3
            int: d 4
        end: immutable
        immutable:
            int: e 5
            int: f 6
        end: immutable
        immutable:
            int: g 7
        end: immutable
        immutable:
            int: h 8
        end: immutable
    end: Data
    Code: (:= ((shared \ Observed) \ seen) ((((((((a * 10000000) + (b * 1000000)) + (c * 100000)) + (d * 10000)) + (e * 1000)) + (f * 100)) + (g * 10)) + h))
)
    call: Data Code
end: main
main:
