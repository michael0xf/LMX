# A leaf header of the include-reach fixture: it declares one function and reaches
# nothing.  The pair used to be mutual (inner predef'd outer and outer predef'd
# inner, a cycle a C header walk has to survive) -- L1 refuses a predef cycle by
# design ("import cycle"), so the mutual shape is not expressible here and the
# reach is carried by the outer header, which names both functions.
prototype:
    fn: l2_test_inner_fn (int: x) int
end: prototype
