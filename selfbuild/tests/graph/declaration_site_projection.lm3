# A declaration in code and the level it stands on (the book, #shadowing-levels; #call-frame-20261115: no write-back). In Code
# `int: x 2` and `int: x 3` stand on the root level of the code and work with the call's local of the visible name:
# D\x stays 10. In Inline `int: x 7` stands in the block of `if`, a nested level: it takes its own place and shadows
# the outer x until the block is left, so the read after the block gives 1 and Inline\x stays 1. seen is written
# through data\. Observation: explicit writes in sub: observe (#flush-receiver-contract; #call-frame-20261115).
(
    Observed:
        int: seen 0
        int: x 0
        int: pad 0
        int: inline_seen 0
        int: inline_x 0
        int: inline_pad 0
)
# Distinct CODE projects by unique name; inline bodies share the selected DATA.
sub: main () (
    D:
        int: seen 0
        int: pad 99
        int: x 10
    Code:
        data\seen := x
        int: x 2
        int: x 3
    Inline:
        int: pad 90
        int: x 1
        int: seen 0
        if: 1 (int: x 7)
        data\seen := x
)
    call(D Code)
    call(Inline)
main()
int: seen main\data\D\seen
int: x main\data\D\x
int: pad main\data\D\pad
int: inline_seen main\data\Inline\seen
int: inline_x main\data\Inline\x
int: inline_pad main\data\Inline\pad

sub: observe ()
    @: shared node[0]
    shared\Observed\seen := seen
    shared\Observed\x := x
    shared\Observed\pad := pad
    shared\Observed\inline_seen := inline_seen
    shared\Observed\inline_x := inline_x
    shared\Observed\inline_pad := inline_pad
observe()
