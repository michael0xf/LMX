# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
# п.3: накопление trace перенесено в shared\Observed\trace (явное место данных корня); порядок finally и значения прежние
(
    Observed:
        int: result 0
        int: trace 0
)
fn: ordered () int
    @: shared node[0]
    finally: shared\Observed\trace := shared\Observed\trace * 10 + 1
    finally: (shared\Observed\trace := shared\Observed\trace * 10 + 2)
    finally: ((shared\Observed\trace := shared\Observed\trace * 10 + 3))
    return: 9
int: result ordered()
sub: main ()
    @: shared node[0]
    shared\Observed\result := result
main()
