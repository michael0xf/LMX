predef: "l2src/lmx_root.lm1"
predef: "l2src/lmx_settle.lm1"
predef: "l2src/lmx_service.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_manager.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_gc.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_call.lm1"
predef: "l2src/lmx_clock.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# lmx_settle_gone_child_selftest.lm1 -- probe 20260919-153000
# Hypothesis (l1-91): lmx_settle_one calls lmx_thread_child_remove(t, child)
# UNCONDITIONALLY (lmx_settle.lm1:119), and that writes child\link = 0
# (lmx_thread.lm1:217) into the child's OWN record — whose arena may already
# be returned (gone=1, lmx_thread_finish lmx_thread.lm1:513-514).
#
# This probe writes a marker (the LmxLink node pointer from lmx_thread_link(child))
# BEFORE the child ends, then checks whether settle overwrites it.
#
# Main assertions target PARENT cells only: child_is, graph slot, service count.
# The freed-memory write is a DIAGNOSTIC number in printf, not an assertion.

@: LmxRoot sg_root 0
@: LmxArena sg_child_arena 0
@: Lmx sg_source 0
size_t: sg_phase 0U
@: LmxSchedule sg_child_sched 0

# Body: ONE turn, then success.  The driver (lmx_manager_round) runs the turn;
# lmx_thread_finish is called at the end of that turn (lmx_thread.lm1:509-514):
# it sets node\gone=1 and releases the child's arena WHOLE.
fn: sg_body (@: Lmx node) int
    @: LmxThread t
    t: lmx_thread_current()
    if: t = 0 || t\message = 0
        return: 0
    ---
    t\message\success: 1
    t\message\running: 0
return: 0

fn: sg_root_entry (@: Lmx node) int
    @: LmxMsg child
    @: LmxThread child_t
    @: LmxPost child_mail
    @: LmxSchedule child_sched
    @: LmxMethod method
    @: LmxPool methods
    @: Lmx graph
    if: sg_phase != 0U || sg_root = 0 || sg_child_arena = 0 || sg_source = 0
        return: 0
    ---
    child: lmx_root_create(sg_root, sg_child_arena, 0U, sg_source)
    if: child = 0
        return: 0
    ---
    methods: lmx_pool_make(sg_child_arena, 2U * c.sizeof(c.LmxMethod), c.sizeof(c.LmxMethod),
                           c.LMX_KIND_METHOD, c.LMX_TYPE_METHOD)
    if: methods = 0
        return: 0
    ---
    method: lmx_method_intern(sg_child_arena, methods, (cast: (LmxEntry) sg_body), 1U)
    graph: child\graph
    if: method = 0 || graph = 0
        return: 0
    ---
    lmx_arena_ref_store(graph, 0U, (cast: (@: void) method))
    child_mail: (cast: (@: LmxPost) lmx_arena_take(sg_child_arena, c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    child_t: (cast: (@: LmxThread) lmx_arena_take(sg_child_arena, c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_THREAD, c.LMX_DOMAIN_THREAD))
    child_sched: (cast: (@: LmxSchedule) lmx_arena_take(sg_child_arena, c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    if: child_mail = 0 || child_t = 0 || child_sched = 0
        return: 0
    ---
    if: lmx_post_init(sg_child_arena, child_mail) != c.LMX_POST_OK
        return: 0
    ---
    if: lmx_schedule_init(child_sched, sg_child_arena, (cast: (@: void) child_t), 100000U) != c.LMX_SCHEDULE_OK
        return: 0
    ---
    if: lmx_thread_attach(child_t, child, child_mail, child_sched) != c.LMX_THREAD_OK
        return: 0
    ---
    if: lmx_child_thread(lmx_root_thread(sg_root), child, child_t) != c.LMX_CHILD_OK
        return: 0
    ---
    sg_child_sched: child_sched
    sg_phase: 1U
return: 0

sub: sg_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
    c.fflush(0)
end: sg_check

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    int: failures
    LmxRoot: root
    LmxArena: child_arena
    @: LmxArena root_arena
    @: LmxArena child_at 0
    @: LmxMsg message 0
    @: LmxThread r0 0
    @: Lmx graph 0
    @: Lmx source 0
    @: LmxMsg child_msg 0
    @: LmxThread child_t 0
    @: LmxService service 0
    @: LmxManager manager 0
    @: LmxLink node 0
    @: void marker_before 0
    @: void marker_after_turn 0
    @: void marker_after_settle 0
    size_t: svc_before 0U
    size_t: svc_after 0U
    int: child_is_before 0
    int: child_is_after 0
    if: counts = 0
        return: 2
    ---
    memset((cast: (@: void) (@ root)), 0, c.sizeof(c.LmxRoot))
    memset((cast: (@: void) (@ child_arena)), 0, c.sizeof(c.LmxArena))
    sg_root: @ root
    sg_child_arena: @ child_arena
    child_at: @ child_arena
    sg_phase: 0U
    sg_check(counts, lmx_root_open(@ root, sg_root_entry, 120000U, 0U, 0U) = c.LMX_ROOT_OK, "R0 did not open")
    message: lmx_root_message(@ root)
    r0: lmx_root_thread(@ root)
    root_arena: lmx_root_arena(@ root)
    graph: message\graph
    service: lmx_root_service(@ root)
    manager: lmx_root_manager(@ root)
    sg_check(counts, message != 0 && r0 != 0 && root_arena != 0 && service != 0 && manager != 0, "R0 missing pieces")
    if: message = 0 || r0 = 0
        failures: counts[1]
        c.printf("lmx_settle_gone checks=%d failures=%d (abort)\n", counts[0], failures)
        c.fflush(0)
        free(counts)
        return: failures
    ---
    source: lmx_node_new_owned(root_arena)
    sg_check(counts, source != 0 && lmx_arena_refs_open_owned(root_arena, source, 4U) = 0, "template not built")
    if: source = 0
        return: 1
    ---
    lmx_arena_ref_store(graph, 3U, (cast: (@: void) source))
    sg_source: source
    sg_check(counts, lmx_arena_open(@ child_arena) = 0, "child arena did not open")
    # R0 cycle: creates the child, publishes it (lmx_child_publish_prepared writes the
    # LmxLink node in R0's arena and sets child\link to point at it).
    sg_check(counts, lmx_root_cycle(@ root, 1U) = c.LMX_ROOT_OK, "create cycle did not run")
    sg_check(counts, sg_phase = 1U, "child was not wired")
    sg_check(counts, lmx_manager_add(manager, sg_child_sched) = c.LMX_MANAGER_OK, "child not in manager")
    child_msg: (cast: (@: LmxMsg) lmx_arena_ref_value(graph, 0U))
    child_t: (cast: (@: LmxThread) lmx_thread_child_first(r0))
    sg_check(counts, child_msg != 0 && child_t != 0, "child not published")
    node: lmx_thread_link(child_t)
    sg_check(counts, node != 0, "child has no link node in parent's chain")
    # The marker: child\link points at the LmxLink node in R0's arena.
    marker_before: (cast: (@: void) node)
    child_is_before: lmx_thread_child_is(r0, child_t)
    svc_before: lmx_service_count(service)
    sg_check(counts, child_is_before != 0, "child not live before turn")
    sg_check(counts, svc_before = 2U, "service not R0+1 before turn")
    # --- THE LAST TURN: child succeeds, runs lmx_thread_finish, releases its arena ---
    # No allocations between here and the next read: lmx_manager_round only walks existing
    # storage (the arena is the context, but take only happens on the record's own path,
    # which has ended).
    sg_check(counts, lmx_manager_round(manager, 1U, lmx_root_clock(@ root)) = c.LMX_MANAGER_OK, "turn did not run")
    # Read child\link FROM FREED MEMORY immediately — no allocations in between.
    marker_after_turn: (cast: (@: void) lmx_thread_link(child_t))
    # --- THE SETTLE: root_cycle settles children, lmx_settle_one calls lmx_thread_child_remove ---
    sg_check(counts, lmx_root_cycle(@ root, 1U) = c.LMX_ROOT_OK, "settle cycle did not run")
    # Read child\link AFTER settle — if 0 instead of marker, the write went to freed memory.
    marker_after_settle: (cast: (@: void) lmx_thread_link(child_t))
    child_is_after: lmx_thread_child_is(r0, child_t)
    svc_after: lmx_service_count(service)
    # Main assertions on PARENT cells (legitimate to change):
    sg_check(counts, child_is_after = 0, "child still live after settle")
    sg_check(counts, lmx_arena_ref_value(graph, 0U) = 0, "parent graph slot not cleared")
    sg_check(counts, svc_after = 1U, "service not R0 after settle")
    sg_check(counts, child_at\blocks = 0 && child_at\count = 0U, "child arena not released")
    sg_check(counts, lmx_manager_count(manager) = 0U, "manager not empty after settle")
    # Guard: the fix (70ba526) must NOT write to the child's released record.
    # After the fix marker_after_settle = marker_before (preserved); before the fix marker_after_settle = 0.
    sg_check(counts, marker_after_settle = marker_before, "the settle wrote into the child's released record again")
    # Diagnostic: did the child's own record (freed memory) get written?
    # marker_before = LmxLink pointer (set during publication, in parent's arena)
    # marker_after_turn = should equal marker_before (memory not reused yet)
    # marker_after_settle = marker_before after fix (no write to freed record)
    failures: counts[1]
    c.printf("lmx_settle_gone checks=%d failures=%d",
             counts[0], failures)
    c.printf(" marker_before=%p marker_after_turn=%p marker_after_settle=%p",
             (cast: (@: void) marker_before), (cast: (@: void) marker_after_turn), (cast: (@: void) marker_after_settle))
    c.printf(" child_is %d->%d svc %u->%u\n",
             child_is_before, child_is_after, svc_before, svc_after)
    c.fflush(0)
    free(counts)
return: failures
