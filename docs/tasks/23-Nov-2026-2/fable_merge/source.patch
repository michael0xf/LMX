+      "foreign": "package PerlComparison::Ordering;\nuse strict;\nuse warnings;\nsub arguments {\n    my ($items, $operation) = @_;\n    ref($items) eq 'ARRAY' or die \"SequenceType\\n\";\n    ref($operation) eq 'CODE' or die \"CallableType\\n\";\n}\nsub integer {\n    my ($value) = @_;\n    defined($value) && !ref($value) && $value =~ /\\A-?[0-9]+\\z/\n        or die \"ComparisonType\\n\";\n    return 0 + $value;\n}\nsub stable_sort {\n    my ($items, $compare) = @_;\n    arguments($items, $compare);\n    my $current = [@$items];\n    my $count = @$current;\n    my $scratch = [];\n    my $width = 1;\n    while ($width < $count) {\n        my $start = 0;\n        while ($start < $count) {\n            my $middle = $width < $count - $start ? $start + $width : $count;\n            my $end = $width < $count - $middle ? $middle + $width : $count;\n            my ($left, $right, $at) = ($start, $middle, $start);\n            while ($at < $end) {\n                my $take_left = $right == $end;\n                if (!$take_left && $left < $middle) {\n                    my $order = integer($compare->($current->[$left], $current->[$right]));\n                    $take_left = $order <= 0;\n                }\n                $scratch->[$at++] = $take_left ? $current->[$left++] : $current->[$right++];\n            }\n            $start = $end;\n        }\n        ($current, $scratch) = ($scratch, $current);\n        $width = $width > $count - $width ? $count : $width + $width;\n    }\n    return $current;\n}\nsub stable_unique {\n    my ($items, $same) = @_;\n    arguments($items, $same);\n    my @out;\n    ITEM: for my $item (@$items) {\n        for my $previous (@out) {\n            next ITEM if integer($same->($previous, $item)) != 0;\n        }\n        push @out, $item;\n    }\n    return \\@out;\n}\n1;\n",
+      "contract": "Любые элементы и явные callbacks: compare возвращает отрицательный/нулевой/положительный int, same — ноль или ненулевой int. sort стабилен, unique сохраняет первое вхождение. Пустой и единичный массив не вызывают callback; оба результата имеют новый внешний контейнер и сохраняют идентичность ссылочных элементов.",
+      "boundary": "Сравниваются собственные общие алгоритмы: итеративное слияние и последовательная проверка представителей. Штатные sort и List::Util::uniq используются только клиентами. Нет специализации элементов на int или ограничения числа аргументов функции данных.",
+      "limitations": "sort: O(n log n) сравнений, O(n) памяти. unique с произвольным same: O(n²) сравнений, O(n) памяти; это не универсальная хеш-таблица. Ошибка callback не меняет вход при соблюдении запрета менять source/ключи самим callback. List::Util::uniq имеет иной общий договор строкового равенства; P09 использует совпадающий целочисленный поддомен.",
