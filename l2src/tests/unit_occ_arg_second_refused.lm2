# Q29 (FABLE-OPUS-CODE-DATA-SPLIT-20260925-189 c3c): `\[N]` numbers declarations.  `arg` has one
# cell -- two bare assignments do not make two occurrences -- so \[1]arg names nothing, and the
# translator refuses it where it stands.
fn: test (int: arg) int
    arg: 1
    arg: 2
    if: \[1]arg != 2
        return: 2
    return: 0
end: test
sendMessage: exit(exit_code: test(0); stdout: ""; stderr: "")
return
