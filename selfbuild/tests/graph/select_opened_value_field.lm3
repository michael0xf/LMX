# A Structure field of a value is a value when the value is opened, not an application judged by description: of
# f(int: y; @: Inner Model) and f(int: y; int: Inner) only the first admits Holder opened (#declaration-selection), seen 21.
(
    Observed:
        int: seen 0
)
@: Model ()
fn: f (int: y; @: Inner Model) int
    return: y * 10 + length(Inner)
fn: f (int: y; int: Inner) int
    return: 99
sub: main () (
    Holder(Inner(int: x 1); int: y 2)
)
    @: shared node[0]
    shared\Observed\seen := f(Holder)
main()
