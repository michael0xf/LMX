---
    Lib:
        private:
            int: x 10
        end: private
        fn: read () int
            int: x 3
            return: x
        end: read
    end: Lib
    Observed:
        int: seen 3
    end: Observed
---
fn: f () int
    @: shared (node [] 0)
    return: shared\Lib\read()
end: f
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) (f)
end: main
main:
