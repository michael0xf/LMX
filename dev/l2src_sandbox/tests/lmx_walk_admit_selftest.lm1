predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/tests/walk_contract_fixture.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_primitive.h.lm1"
predef: "l2src/lmx_merge_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# -180 / FABLE-GROKBOT-WALK-ADMIT-20260925-180 (+ addendum): admit + admit_letter PRIM.
# Mutants RED: copy not ref (test4); NO->OK / NO->FAIL (mismatch test); admit_letter slot0; null->THROW.

@: LmxArena ga 0
@: Lmx groles 0
@: LmxWalkContext gctx 0
@: LmxWalkValue gv 0
int: broken 0
int: checks 0
int: failures 0
int: producer_calls 0
@: void produced_value 0
[]: char schema_tokens 3

fn: produce (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    producer_calls: producer_calls + 1
    \out: produced_value
return: 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(ga, groles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(ga, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

sub: ref (@: Lmx code; size_t: slot; @: Lmx target)
    if: code = 0 || target = 0 || lmx_arena_ref_store(code, slot, (cast: (@: void) target)) != 0
        broken: broken + 1
    ---
end: ref

sub: token (@: Lmx code; size_t: slot; size_t: index)
    if: lmx_walk_store_charptr(ga, code, slot, schema_tokens + index) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: token

sub: sz (@: Lmx code; size_t: slot; size_t: value)
    if: code = 0 || lmx_walk_store_size(ga, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: sz

# k.4: a walked callable occurrence is just the ordinary body Structure -- no descriptor,
# no shared method record; `native` stays 0 by construction (lmx_node_new_owned zeroes it),
# which is exactly what dispatches to the walker.  `children` now counts body steps only
# (the old descriptor slot 0 is gone), so every call site below shrinks by one and its
# first body-step frame moves from slot 1 to slot 0.
fn: mk_m (@: Lmx unit; size_t: slot; size_t: children) @: Lmx
return: pl(unit, slot, children)

fn: go (@: Lmx m) int
    if: m = 0 || gctx = 0 || gv = 0
        return: c.LMX_WALK_INVALID
return: lmx_walk_run(gctx, m, 0, 0U, gv)

fn: main () int
    LmxArena: arena
    LmxArena: context_arena
    LmxPool: context_cells
    LmxScratch: store
    LmxWalkContext: context
    @: Lmx unit 0
    @: Lmx m 0
    @: Lmx n 0
    @: Lmx pn 0
    @: Lmx model_x 0
    @: void model_box 0
    @: Lmx model_y 0
    @: Lmx value 0
    @: Lmx value_y 0
    @: Lmx letter 0
    @: Lmx payload 0
    @: Lmx prim_rec 0
    @: Lmx prim_letter_rec 0
    @: LmxPrimitive prim 0
    @: LmxPrimitive prim_letter 0
    @: void pcell 0
    @: void got 0
    @: void cell 0
    @: void cell_reference 0
    @: void null_value 0
    @: Lmx litn 0
    @: void null_out 0
    @@: void nrefs 0
    int: st 0
    int: pty c.LMX_TYPE_POINTER_BASE + 1
    @: Lmx source_model 0
    @: Lmx target_model 0
    @: Lmx mapped_value 0
    @: Lmx unmapped_value 0
    @: Lmx admitted 0
    @: Lmx cloned_admit 0
    @: Lmx cached 0
    @: Lmx fresh_known 0
    @: Lmx partial 0
    @: Lmx outer_partial 0
    @: Lmx outer_model 0
    @: Lmx captured 0
    @: Lmx kmodel_holder 0
    @: Lmx katn 0
    @: LmxImplEntry proof 0
    @: Lmx place 0
    @: Lmx pad 0
    @: LmxPrimitive producer 0
    []: size_t source_map 2
    []: size_t partial_map 2
    size_t: selected_slot 0U
    size_t: copy_slot 1U

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        return: 2
    ga: @ arena
    if: lmx_chars_init(ga) != 0
        return: 2
    groles: lmx_walk_roles_open(ga)
    if: groles = 0
        return: 2
    memset((cast: (@: void) (@ context_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxScratch))
    if: lmx_arena_open(@ context_arena) != 0 || lmx_scratch_open(@ store, @ context_arena, @ context_cells, 16U) != c.LMX_SCRATCH_OK
        return: 2
    memset((cast: (@: void) (@ context)), 0, c.sizeof(c.LmxWalkContext))
    context.arena: ga
    context.scratch: @ store
    context.roles: groles
    context.immutable_profile: 0
    context.classified: 0U
    gctx: @ context
    gv: (cast: (@: LmxWalkValue) calloc(1U, c.sizeof(c.LmxWalkValue)))
    if: gv = 0
        return: 2

    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 32U) != 0
        return: 2
    ---
    # model {x}: 1 int slot; model {y}: 2 int slots (mismatch vs 1-slot value)
    model_x: pl(unit, 1U, 1U)
    model_y: pl(unit, 2U, 2U)
    value: pl(unit, 3U, 1U)
    value_y: pl(unit, 4U, 1U)
    if: model_x = 0 || model_y = 0 || value = 0 || value_y = 0
        return: 2
    if: lmx_walk_store_int(ga, model_x, 0U, 0) != c.LMX_WALK_OK || lmx_walk_store_int(ga, model_y, 0U, 0) != c.LMX_WALK_OK || lmx_walk_store_int(ga, model_y, 1U, 0) != c.LMX_WALK_OK
        return: 2
    if: lmx_walk_store_int(ga, value, 0U, 7) != c.LMX_WALK_OK || lmx_walk_store_int(ga, value_y, 0U, 1) != c.LMX_WALK_OK
        return: 2

    prim: (cast: (@: LmxPrimitive) lmx_arena_take(ga, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))
    prim_letter: (cast: (@: LmxPrimitive) lmx_arena_take(ga, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))
    if: prim = 0 || prim_letter = 0
        return: 2
    ---
    prim\fn: lmx_walk_admit
    prim\signature: wt_contract_same(ga, 2U, c.LMX_TYPE_LMX, c.LMX_TYPE_LMX)
    prim\owner: (cast: (@: Lmx) ga)
    prim_rec: (cast: (@: Lmx) prim)
    prim_letter\fn: lmx_walk_admit_letter
    prim_letter\signature: wt_contract_same(ga, 2U, c.LMX_TYPE_LMX, c.LMX_TYPE_LMX)
    prim_letter\owner: (cast: (@: Lmx) ga)
    prim_letter_rec: (cast: (@: Lmx) prim_letter)

    # 1. value {x:7} admit to model {x}: out == value address, OK
    m: mk_m(unit, 0U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: fr(n, 1U, c.LMX_WALK_OP_PRIM, 5U)
    ref(pn, 1U, prim_rec)
    ref(pn, 3U, value)
    ref(pn, 4U, model_x)
    st: go(m)
    got: gv\ref
    check((cast: (int) (st = c.LMX_WALK_OK && got = (cast: (@: void) value))), "admit value->model_x same pointer OK")

    # 2. value {y-shape mismatch: 1-slot vs model 2-slot} -> THROWN+2
    m: mk_m(unit, 5U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: fr(n, 1U, c.LMX_WALK_OP_PRIM, 5U)
    ref(pn, 1U, prim_rec)
    ref(pn, 3U, value_y)
    ref(pn, 4U, model_y)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_THROWN + 2)), "admit mismatch -> THROWN+2")

    # A held reference to a non-Structure cell reaches structural admission and fails.
    cell: lmx_int_new_owned(ga)
    if: cell = 0 || lmx_int_store_known(cell, 1) != 0
        return: 2
    ---
    cell_reference: lmx_pointer_new_owned(c.LMX_TYPE_POINTER_BASE + 7, ga)
    lmx_pointer_store_known(cell_reference, cell)
    m: mk_m(unit, 6U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: fr(n, 1U, c.LMX_WALK_OP_PRIM, 5U)
    ref(pn, 1U, prim_rec)
    litn: fr(pn, 3U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_arena_ref_store(litn, 1U, cell_reference) != 0
        broken: broken + 1
    ---
    ref(pn, 4U, model_x)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_PRIMITIVE)), "admit numeric cell -> PRIMITIVE")

    # 4. write through PUT into admitted value; visible on original (reference)
    m: mk_m(unit, 7U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_PUT, 3U)
    litn: fr(n, 1U, c.LMX_WALK_OP_AT, 3U)
    ref(litn, 1U, value)
    sz(litn, 2U, 0U)
    litn: fr(n, 2U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_walk_store_int(ga, litn, 1U, 99) != c.LMX_WALK_OK
        broken: broken + 1
    ---
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && lmx_int_value_known(lmx_arena_ref_value(value, 0U)) = 99)), "PUT into admitted value visible on original")

    # null value -> out 0 OK (admit): direct PRIM ABI — walk_eval refuses a null child node
    nrefs: (cast: (@@: void) calloc(2U, c.sizeof(@: void)))
    if: nrefs = 0
        return: 2
    ---
    nrefs[0]: (cast: (@: void) (@ null_value))
    model_box: (cast: (@: void) model_x)
    nrefs[1]: (cast: (@: void) (@ model_box))
    null_out: (cast: (@: void) 1)
    st: lmx_walk_admit((cast: (@: void) ga), nrefs, 2U, 0, @ null_out)
    check((cast: (int) (st = 0 && null_out = 0)), "admit null -> out 0 OK")
    null_out: (cast: (@: void) 1)
    st: lmx_walk_admit_letter((cast: (@: void) ga), nrefs, 2U, 0, @ null_out)
    check((cast: (int) (st = 0 && null_out = 0)), "admit_letter null -> out 0 OK")

    # pointer cell holding Structure admitted through the cell (LIT yields the cell)
    pcell: lmx_pointer_new_owned(pty, ga)
    if: pcell = 0 || lmx_pointer_store_known(pcell, (cast: (@: void) value)) != 0
        return: 2
    ---
    m: mk_m(unit, 10U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: fr(n, 1U, c.LMX_WALK_OP_PRIM, 5U)
    ref(pn, 1U, prim_rec)
    litn: fr(pn, 3U, c.LMX_WALK_OP_LIT, 2U)
    if: litn != 0 && lmx_arena_ref_store(litn, 1U, pcell) != 0
        broken: broken + 1
    ---
    ref(pn, 4U, model_x)
    st: go(m)
    got: gv\ref
    check((cast: (int) (st = c.LMX_WALK_OK && got = (cast: (@: void) value))), "admit via pointer cell -> value")

    # admit_letter: (sender; payload={x}) vs model_x -> out = payload address
    payload: pl(unit, 11U, 1U)
    letter: pl(unit, 12U, 2U)
    if: payload = 0 || letter = 0 || lmx_walk_store_int(ga, payload, 0U, 5) != c.LMX_WALK_OK
        return: 2
    if: lmx_arena_ref_store(letter, 0U, 0) != 0 || lmx_arena_ref_store(letter, 1U, (cast: (@: void) payload)) != 0
        return: 2
    ---
    m: mk_m(unit, 13U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: fr(n, 1U, c.LMX_WALK_OP_PRIM, 5U)
    ref(pn, 1U, prim_letter_rec)
    ref(pn, 3U, letter)
    ref(pn, 4U, model_x)
    st: go(m)
    got: gv\ref
    check((cast: (int) (st = c.LMX_WALK_OK && got = (cast: (@: void) payload))), "admit_letter -> payload address")

    # same letter vs model_y -> THROWN+2
    m: mk_m(unit, 14U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: fr(n, 1U, c.LMX_WALK_OP_PRIM, 5U)
    ref(pn, 1U, prim_letter_rec)
    ref(pn, 3U, letter)
    ref(pn, 4U, model_y)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_THROWN + 2)), "admit_letter mismatch -> THROWN+2")

    # A single flat ADMIT_AS borrows its maps at offsets in the instruction.
    # Source view is reversed; exact physical layout is target_model. Unknown
    # origin is NOT inferred from the declared source model or an identity map.
    source_model: pl(unit, 15U, 2U)
    target_model: pl(unit, 16U, 2U)
    mapped_value: pl(unit, 17U, 2U)
    unmapped_value: pl(unit, 18U, 2U)
    lmx_walk_store_int(ga, source_model, 0U, 11)
    lmx_walk_store_int(ga, source_model, 1U, 99)
    lmx_walk_store_int(ga, target_model, 0U, 99)
    lmx_walk_store_int(ga, target_model, 1U, 11)
    lmx_walk_store_int(ga, mapped_value, 0U, 88)
    lmx_walk_store_int(ga, mapped_value, 1U, 22)
    lmx_walk_store_int(ga, unmapped_value, 0U, 88)
    lmx_walk_store_int(ga, unmapped_value, 1U, 22)
    source_map[0]: 1U
    source_map[1]: 0U
    check((cast: (int) (lmx_implements_register_map(ga, mapped_value, source_model, source_map, 2U, (cast: (@: void) (schema_tokens + 1))) = c.LMX_IMPLEMENTS_YES)), "source correspondence retains actual layout")
    producer: (cast: (@: LmxPrimitive) lmx_arena_take(ga, c.sizeof(c.LmxPrimitive), c.LMX_DOMAIN_KIND_PRIMITIVE, c.LMX_DOMAIN_PRIMITIVE))
    if: producer = 0
        return: 2
    producer\fn: produce
    producer\signature: wt_contract_same(ga, 0U, c.LMX_TYPE_LMX, c.LMX_TYPE_LMX)
    producer\owner: (cast: (@: Lmx) ga)
    m: mk_m(unit, 19U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    admitted: fr(n, 1U, c.LMX_WALK_OP_ADMIT_AS, 18U)
    token(admitted, 1U, 0U)
    ref(admitted, 4U, target_model)
    sz(admitted, 5U, 1U)
    sz(admitted, 6U, 4U)
    sz(admitted, 8U, 1U)
    sz(admitted, 9U, 1U)
    sz(admitted, 10U, 0U)
    sz(admitted, 11U, 1U)
    sz(admitted, 12U, 0U)
    token(admitted, 13U, 1U)
    sz(admitted, 14U, 0U)
    sz(admitted, 15U, 1U)
    sz(admitted, 16U, 0U)
    sz(admitted, 17U, 1U)
    pn: fr(admitted, 3U, c.LMX_WALK_OP_PRIM, 3U)
    ref(pn, 1U, (cast: (@: Lmx) producer))
    produced_value: (cast: (@: void) mapped_value)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\ref = produced_value && producer_calls = 1)), "mapped candidate evaluated once, identity preserved")
    check((cast: (int) (lmx_implements_slot(ga, mapped_value, target_model, 1U, @ selected_slot) = 0 && selected_slot = 1U)), "target map selected through actual source view")
    produced_value: 0
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\ref = 0 && producer_calls = 2)), "typed null passes before correspondence lookup")
    produced_value: (cast: (@: void) unmapped_value)
    check((cast: (int) (lmx_implements_find(ga, unmapped_value, target_model) = 0)), "unknown candidate has no target correspondence before reception")
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && producer_calls = 3 && lmx_implements_find(ga, unmapped_value, target_model) != 0 && lmx_implements_layout(ga, unmapped_value) = 0 && lmx_implements_slot(ga, unmapped_value, target_model, 1U, @ selected_slot) = 0 && selected_slot = 1U)), "unknown layout records checked identity without inventing an origin")
    check((cast: (int) (lmx_size_value_known(lmx_arena_ref_value(admitted, 9U)) = 1U && lmx_size_value_known(lmx_arena_ref_value(admitted, 14U)) = 0U)), "admissions do not mutate inline instruction maps")
    check((cast: (int) (lmx_graph_copy_owned(admitted, ga, ga, @ cloned_admit) = 0 && cloned_admit != 0 && lmx_arena_ref_value(cloned_admit, 1U) != lmx_arena_ref_value(admitted, 1U) && lmx_charptr_value_known(lmx_arena_ref_value(cloned_admit, 1U)) = schema_tokens && lmx_charptr_value_known(lmx_arena_ref_value(cloned_admit, 13U)) = schema_tokens + 1)), "copy owns fresh token cells while preserving non-owning module identities")

    # Catch rows follow BOTH the default and alternative maps. The refused
    # one-field candidate must reach this pad and the following literal.
    m: mk_m(unit, 20U, 3U)
    pn: fr(m, 0U, c.LMX_WALK_OP_ADMIT_AS, 21U)
    while: copy_slot < 18U
        if: lmx_arena_ref_store(pn, copy_slot, lmx_arena_ref_value(admitted, copy_slot)) != 0
            broken: broken + 1
        copy_slot: copy_slot + 1U
    ---
    sz(pn, 2U, 1U)
    sz(pn, 18U, 2U)
    sz(pn, 20U, 0U)
    pad: fr(m, 1U, c.LMX_WALK_OP_PAD, 2U)
    n: pl(pad, 1U, 0U)
    ref(pn, 19U, pad)
    n: fr(m, 2U, c.LMX_WALK_OP_RET, 2U)
    litn: fr(n, 1U, c.LMX_WALK_OP_LIT, 2U)
    lmx_walk_store_int(ga, litn, 1U, 7)
    produced_value: (cast: (@: void) value)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\type = c.LMX_TYPE_INT && gv\number = 7 && producer_calls = 4)), "caught ADMIT_AS NO resumes after all inline maps")
    check((cast: (int) (lmx_implements_find(ga, value, target_model) = 0)), "failed mapped admission records no target correspondence")

    # Same reached candidate, but this instruction carries no matching layout
    # alternative. Its cached correspondence remains usable after admission
    # for the current receiver succeeds.
    m: mk_m(unit, 21U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: fr(n, 1U, c.LMX_WALK_OP_ADMIT_AS, 9U)
    token(pn, 1U, 0U)
    ref(pn, 3U, mapped_value)
    ref(pn, 4U, target_model)
    sz(pn, 5U, 0U)
    sz(pn, 6U, 0U)
    sz(pn, 8U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) mapped_value) && lmx_implements_slot(ga, mapped_value, target_model, 1U, @ selected_slot) = 0 && selected_slot = 1U)), "unlisted known layout reuses exact completed target proof")

    # A cached target may have unknown layout even after its correspondence is
    # complete. Genuine later source evidence may enrich it, never replace it.
    cached: pl(unit, 22U, 2U)
    lmx_walk_store_int(ga, cached, 0U, 5)
    lmx_walk_store_int(ga, cached, 1U, 6)
    check((cast: (int) (lmx_implements_register_map(ga, cached, target_model, 0, 0U, 0) = c.LMX_IMPLEMENTS_YES && lmx_implements_layout(ga, cached) = 0)), "target proof starts with unknown layout")
    check((cast: (int) (lmx_implements_register_map(ga, cached, source_model, source_map, 2U, (cast: (@: void) (schema_tokens + 1))) = c.LMX_IMPLEMENTS_YES)), "independent source proof supplies real layout")
    ref(pn, 3U, cached)
    st: go(m)
    proof: lmx_implements_find(ga, cached, target_model)
    check((cast: (int) (st = c.LMX_WALK_OK && proof != 0 && proof\layout = (cast: (@: void) (schema_tokens + 1)))), "cached target enriches genuine layout after current receiver admission")

    # A proof with an unused field is not a proof of the full receiver. Failure
    # must retain both correspondence and unknown provenance, without upgrade.
    partial: pl(unit, 23U, 1U)
    lmx_walk_store_int(ga, partial, 0U, 41)
    partial_map[0]: 0U
    partial_map[1]: (cast: (size_t) -1)
    check((cast: (int) (lmx_implements_register_map(ga, partial, target_model, partial_map, 2U, 0) = c.LMX_IMPLEMENTS_YES)), "partial target proof established for its used field")
    ref(pn, 3U, partial)
    token(pn, 7U, 2U)
    token(pn, 1U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_THROWN + 2 && lmx_implements_layout(ga, partial) = 0 && lmx_implements_slot(ga, partial, target_model, 0U, @ selected_slot) = 0 && selected_slot = 0U)), "cached partial proof cannot admit a new full receiver or mutate provenance")

    # The newly checked, still-unknown layout supports ordinary mapped places.
    m: mk_m(unit, 24U, 2U)
    pn: fr(m, 0U, c.LMX_WALK_OP_PUT, 3U)
    place: fr(pn, 1U, c.LMX_WALK_OP_OF, 4U)
    ref(place, 1U, unmapped_value)
    sz(place, 2U, 1U)
    ref(place, 3U, target_model)
    litn: fr(pn, 2U, c.LMX_WALK_OP_LIT, 2U)
    lmx_walk_store_int(ga, litn, 1U, 41)
    n: fr(m, 1U, c.LMX_WALK_OP_RET, 2U)
    ref(n, 1U, place)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\number = 41 && lmx_int_value_known(lmx_arena_ref_value(unmapped_value, 0U)) = 88)), "unknown reception mapped read/write keeps the other field")
    pn: fr(n, 1U, c.LMX_WALK_OP_ADDRESS, 3U)
    ref(pn, 1U, place)
    lmx_arena_ref_store(pn, 2U, wt_witness(ga, c.LMX_TYPE_POINTER_BASE + 1))
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref = lmx_arena_ref_value(unmapped_value, 1U))), "unknown reception address selects the real field cell")

    # Fresh outer identity must not hide an already-admitted nested hole.
    outer_partial: pl(unit, 25U, 1U)
    outer_model: pl(unit, 26U, 1U)
    ref(outer_partial, 0U, partial)
    ref(outer_model, 0U, target_model)
    m: mk_m(unit, 27U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: fr(n, 1U, c.LMX_WALK_OP_ADMIT_AS, 9U)
    ref(pn, 3U, outer_partial)
    ref(pn, 4U, outer_model)
    sz(pn, 5U, 0U)
    sz(pn, 6U, 0U)
    sz(pn, 8U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_THROWN + 2 && lmx_implements_find(ga, outer_partial, outer_model) = 0)), "unknown full reception refuses nested cached holes before publishing identity")

    # An actual capture constructs req's physical slots but only carries slot1.
    # A selected current Consumer using slot1 supplies [unused,1], not full identity.
    copy_slot: 1U
    captured: lmx_walk_capture(ga, unit, cached, target_model, @ copy_slot, 1U, (cast: (@: void) (schema_tokens + 1)))
    check((cast: (int) (captured != 0 && lmx_implements_layout(ga, captured) = (cast: (@: void) (schema_tokens + 1)) && lmx_arena_ref_value(captured, 0U) = 0)), "actual capture retains its genuine layout and uncaptured hole")
    m: mk_m(unit, 28U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: fr(n, 1U, c.LMX_WALK_OP_ADMIT_AS, 13U)
    token(pn, 1U, 1U)
    ref(pn, 3U, captured)
    ref(pn, 4U, target_model)
    sz(pn, 5U, 0U)
    sz(pn, 6U, 4U)
    sz(pn, 8U, 0U)
    sz(pn, 9U, (cast: (size_t) -1))
    sz(pn, 10U, 1U)
    sz(pn, 11U, (cast: (size_t) -1))
    sz(pn, 12U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) captured) && lmx_implements_slot(ga, captured, target_model, 0U, @ selected_slot) != 0 && lmx_implements_slot(ga, captured, target_model, 1U, @ selected_slot) = 0 && selected_slot = 1U)), "selected used view preserves capture holes and carried field")
    sz(pn, 8U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_THROWN + 2 && lmx_implements_slot(ga, captured, target_model, 0U, @ selected_slot) != 0 && lmx_implements_layout(ga, captured) = (cast: (@: void) (schema_tokens + 1)))), "same selected map refuses a full receiver without changing its proof")
    pn: fr(n, 1U, c.LMX_WALK_OP_ADMIT_AS, 9U)
    token(pn, 1U, 1U)
    ref(pn, 3U, captured)
    ref(pn, 4U, target_model)
    sz(pn, 5U, 0U)
    sz(pn, 6U, 0U)
    sz(pn, 8U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_THROWN + 2 && lmx_implements_slot(ga, captured, target_model, 0U, @ selected_slot) != 0)), "capture cannot promise full identity for a newly required field")

    # K02c (lmx_walk_model_operand): the model's place may hold a FRAME, evaluated where the op runs to the model's
    # reference -- a merge result's own Structure, which does not exist when the frames are built; an AT of the slot
    # that holds it stands in for it.  The same candidate and instruction otherwise: admitted and recorded against
    # target_model exactly as with the model itself.  A frame evaluating to no reference is INVALID, not a model.
    kmodel_holder: pl(unit, 23U, 1U)
    ref(kmodel_holder, 0U, target_model)
    m: mk_m(unit, 24U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: fr(n, 1U, c.LMX_WALK_OP_ADMIT_AS, 9U)
    token(pn, 1U, 0U)
    ref(pn, 3U, mapped_value)
    katn: fr(pn, 4U, c.LMX_WALK_OP_AT, 3U)
    ref(katn, 1U, kmodel_holder)
    sz(katn, 2U, 0U)
    sz(pn, 5U, 0U)
    sz(pn, 6U, 0U)
    sz(pn, 8U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) mapped_value) && lmx_implements_find(ga, mapped_value, target_model) != 0)), "a frame in the model's place is evaluated to the model (K02c)")
    sz(katn, 2U, 7U)
    st: go(m)
    check((cast: (int) (st != c.LMX_WALK_OK)), "a model frame evaluating to no reference is no model")

    # A genuine layout with neither an instruction alternative nor a cached
    # target proof cannot borrow positional identity. Missing proof refuses
    # admission, but is not a malformed instruction or a structural NO.
    fresh_known: pl(unit, 29U, 2U)
    lmx_walk_store_int(ga, fresh_known, 0U, 88)
    lmx_walk_store_int(ga, fresh_known, 1U, 22)
    check((cast: (int) (lmx_implements_register_map(ga, fresh_known, source_model, source_map, 2U, (cast: (@: void) (schema_tokens + 1))) = c.LMX_IMPLEMENTS_YES)), "fresh candidate carries genuine source layout")
    proof: lmx_implements_find(ga, fresh_known, source_model)
    check((cast: (int) (proof != 0 && lmx_implements_find(ga, fresh_known, target_model) = 0)), "fresh known candidate has no target proof")
    m: mk_m(unit, 30U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: fr(n, 1U, c.LMX_WALK_OP_ADMIT_AS, 9U)
    token(pn, 1U, 0U)
    ref(pn, 3U, fresh_known)
    ref(pn, 4U, target_model)
    sz(pn, 5U, 0U)
    sz(pn, 6U, 0U)
    sz(pn, 8U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_THROWN + 2)), "unlisted known layout without target proof throws implements")
    check((cast: (int) (lmx_implements_find(ga, fresh_known, target_model) = 0 && lmx_implements_find(ga, fresh_known, source_model) = proof && lmx_implements_layout(ga, fresh_known) = (cast: (@: void) (schema_tokens + 1)) && lmx_implements_slot(ga, fresh_known, source_model, 0U, @ selected_slot) = 0 && selected_slot = 1U)), "refused admission publishes no target and preserves genuine source proof")

    # The SAME candidate succeeds when the receiver carries an exact matching
    # alternative. No invented origin or fallback map is needed.
    m: mk_m(unit, 31U, 1U)
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    pn: fr(n, 1U, c.LMX_WALK_OP_ADMIT_AS, 18U)
    token(pn, 1U, 0U)
    ref(pn, 3U, fresh_known)
    ref(pn, 4U, target_model)
    sz(pn, 5U, 1U)
    sz(pn, 6U, 4U)
    sz(pn, 8U, 1U)
    sz(pn, 9U, 1U)
    sz(pn, 10U, 0U)
    sz(pn, 11U, 1U)
    sz(pn, 12U, 0U)
    token(pn, 13U, 1U)
    sz(pn, 14U, 0U)
    sz(pn, 15U, 1U)
    sz(pn, 16U, 0U)
    sz(pn, 17U, 1U)
    st: go(m)
    check((cast: (int) (st = c.LMX_WALK_OK && gv\present != 0 && gv\ref = (cast: (@: void) fresh_known))), "same virgin candidate admits through its exact alternative")
    check((cast: (int) (lmx_implements_slot(ga, fresh_known, target_model, 0U, @ selected_slot) = 0 && selected_slot = 0U && lmx_implements_slot(ga, fresh_known, target_model, 1U, @ selected_slot) = 0 && selected_slot = 1U && lmx_implements_layout(ga, fresh_known) = (cast: (@: void) (schema_tokens + 1)) && lmx_int_value_known(lmx_arena_ref_value(fresh_known, 0U)) = 88 && lmx_int_value_known(lmx_arena_ref_value(fresh_known, 1U)) = 22)), "successful alternative records physical slots without changing candidate cells or layout")

    c.printf("lmx_walk_admit_selftest checks=%d failures=%d broken=%d\n", checks, failures, broken)
    if: failures != 0 || broken != 0
        return: 1
return: 0
