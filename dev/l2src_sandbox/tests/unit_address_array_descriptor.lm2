# The selected code owns its source fields; c.self at a split call may be
# distinct data. Both addresses are test instrumentation, not source lookup.
# Empty arrays are unique by owner/type; no address of empty[0] is formed.
include: "l2src/tests/array_address_observer.h"
fn: check () int
    []: int values 4
    values[0]: 17
    @: before c.LmxArray values
    if: c.l2_test_array_address(c.l2_program_arena, c.l2_call_code, before, c.LMX_TYPE_ARRAY_OF_INT, 4U, @ values[0]) = 0
        return: 81
    if: 1
        []: char letters 5
        letters[0]: 'B'
        @: inner c.LmxArray letters
        if: inner = before
            return: 82
        if: c.l2_test_array_address(c.l2_program_arena, c.l2_call_code, inner, c.LMX_TYPE_ARRAY_OF_CHAR, 5U, @ letters[0]) = 0
            return: 83
        if: letters[0] != 'B'
            return: 92
    ---
    if: values != before || values[0] != 17
        return: 84
    []: char empty 0
    @: emptyAddress c.LmxArray empty
    if: c.l2_test_array_address(c.l2_program_arena, c.l2_call_code, emptyAddress, c.LMX_TYPE_ARRAY_OF_CHAR, 0U, 0) = 0
        return: 85
return: 7

[]: int numbers 3
[]: char chars 2
[]: int empty 0
numbers[0]: 9
chars[0]: 'A'
@: p c.LmxArray numbers
const: @(readonly c.LmxArray numbers)
if: p != readonly
    sendMessage: exit(exit_code: 86; stdout: ""; stderr: "")
    return
if: c.l2_test_array_address(c.l2_program_arena, c.self, p, c.LMX_TYPE_ARRAY_OF_INT, 3U, @ numbers[0]) = 0
    sendMessage: exit(exit_code: 87; stdout: ""; stderr: "")
    return
@@: cell c.LmxArray @ p
\cell: chars
if: \cell != chars || p != numbers || numbers[0] != 9 || chars[0] != 'A'
    sendMessage: exit(exit_code: 88; stdout: ""; stderr: "")
    return
if: c.l2_test_array_address(c.l2_program_arena, c.self, (\cell), c.LMX_TYPE_ARRAY_OF_CHAR, 2U, @ chars[0]) = 0
    sendMessage: exit(exit_code: 89; stdout: ""; stderr: "")
    return
@: emptyAddress c.LmxArray empty
if: c.l2_test_array_address(c.l2_program_arena, c.self, emptyAddress, c.LMX_TYPE_ARRAY_OF_INT, 0U, 0) = 0
    sendMessage: exit(exit_code: 90; stdout: ""; stderr: "")
    return
int: got check()
if: got != 7
    sendMessage: exit(exit_code: got; stdout: ""; stderr: "")
    return
if: c.l2_test_array_address_count(6) = 0
    sendMessage: exit(exit_code: 91; stdout: ""; stderr: "")
    return
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
