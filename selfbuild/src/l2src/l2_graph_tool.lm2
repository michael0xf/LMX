# The graph tool of the kernel implementation specification (docs/kernel-implementation.ru.md, EN beside it; slice 309,
# the vertical slice of §11 item 0): the builder of the clean graph from the P0 tree (§1a, §3), the emitter of a program
# over that graph (§7) and the command line of the tool tools/graph_trans.lm2, which runs the kernel's interpreter over
# the same graph (lmx_graph_run.lm2, §6). The new path stands beside the old pipeline and does not touch its emission.
#
# The builder reads the P0 tree once and leaves nothing of it in the graph: every written name is a word primitive with
# the canonical address of its spelling (§3.5: the builder resolves no names), a number literal is an int primitive, a
# Frame or a Structure is an Lmx of its head word and fields in the written order (§3.3). The one exception the
# language itself makes is a declaration: `int: x 5` is an int place holding 5, `int: x` a place without a value (§3.2),
# both named at their cell (§5.1); a declaration with a computed initializer stays a statement until it runs (§3.4). The
# parse tree and its arenas are destroyed with the construction (§1a).
#
# The emitter is a consumer of the clean graph: it reads the graph, not the parse tree. It writes the L1 of a program
# (the form the pipeline's L1 translator and gcc build and the driver runs): the generated initialization of the same
# graph through the common constructor (lmx_graph_*; §1a), the program hooks the driver expects, and the native body of
# the root over the same cells (§7) -- or, in the forced mode, a body that hands the root to the kernel's interpreter.
# The emitter resolves written names itself, at translation, with its own table of the declarations it has emitted and
# the names of the built graph (§3.5, §5.2); the emitted native reads and writes places by their slots.
#
# A machine module (L2 section 20) of the program tools/graph_trans.lm2: built by `lmxtool build-graph` (bld_graph,
# tools/build.lm2) with the P0 parser's modules of the stage; its exports are named there.
predef: "l1src/p0.h.lm1"
predef: "l1src/parser.lm1"
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_graph.h.lm1"
predef: "l2src/lmx_graph_run.h.lm1"
predef: "l2src/lmx_graph_copy_owned.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>"
include: "<stdlib.h>"
include: "<string.h>"

# ---- The P0 tree as the frontend reads it ------------------------------------------------------------------------

# The fields of the P0 records, read through one cast each: the translator types no field of a record declared by
# l1src/p0.h.lm1, so a read that flows into a typed formal, a local or a return goes through these (the frontend's own
# port249 wrappers do the same); a read compared in a condition needs no cast.
fn: lm_graph_p0_value (@: f c.LmP0Field) @: c.LmP0Node
    return: (cast: (@: c.LmP0Node) (f\value))
end: lm_graph_p0_value

fn: lm_graph_p0_next (@: f c.LmP0Field) @: c.LmP0Field
    return: (cast: (@: c.LmP0Field) (f\next))
end: lm_graph_p0_next

fn: lm_graph_p0_first (@: s c.LmP0Structure) @: c.LmP0Field
    return: (cast: (@: c.LmP0Field) (s\first_field))
end: lm_graph_p0_first

fn: lm_graph_p0_atom (@: nd c.LmP0Node) @: c.LmP0Text
    return: (cast: (@: c.LmP0Text) (nd\as\atom))
end: lm_graph_p0_atom

fn: lm_graph_p0_frame (@: nd c.LmP0Node) @: c.LmP0Frame
    return: (cast: (@: c.LmP0Frame) (nd\as\frame))
end: lm_graph_p0_frame

fn: lm_graph_p0_structure (@: nd c.LmP0Node) @: c.LmP0Structure
    return: (cast: (@: c.LmP0Structure) (nd\as\structure))
end: lm_graph_p0_structure

fn: lm_graph_p0_head (@: fr c.LmP0Frame) @: c.LmP0Text
    return: (cast: (@: c.LmP0Text) (fr\head))
end: lm_graph_p0_head

fn: lm_graph_p0_body (@: fr c.LmP0Frame) @: c.LmP0Structure
    return: (cast: (@: c.LmP0Structure) (fr\body))
end: lm_graph_p0_body

fn: lm_graph_p0_data (@: text c.LmP0Text) const: @: char
    return: (cast: (const: @: char) (text\data))
end: lm_graph_p0_data

fn: lm_graph_p0_length (@: text c.LmP0Text) size_t
    return: (cast: (size_t) (text\length))
end: lm_graph_p0_length

# 1 when the nd is a real field of its Structure: not disabled, not inactive, not a mix remnant.
fn: lm_graph_active (@: nd c.LmP0Node) int
    if: nd = 0
        return: 0
    if: nd\kind = c.LM_P0_NODE_DISABLED
        return: 0
    if: (nd\flags & (c.LM_P0_NODE_INACTIVE | c.LM_P0_NODE_MIX)) != 0U
        return: 0
    return: 1
end: lm_graph_active

fn: lm_graph_next_active (@: field c.LmP0Field) @: c.LmP0Field
    while: field != 0 && lm_graph_active(lm_graph_p0_value(field)) = 0
        field: lm_graph_p0_next(field)
    ---
    return: field
end: lm_graph_next_active

fn: lm_graph_count_active (@: s c.LmP0Structure) size_t
    @: f c.LmP0Field 0
    size_t: n 0U
    if: s = 0
        return: 0U
    f: lm_graph_next_active(lm_graph_p0_first(s))
    while: f != 0
        n: n + 1U
        f: lm_graph_next_active(lm_graph_p0_next(f))
    ---
    return: n
end: lm_graph_count_active

# 1 and the value in out when the atom's text is a decimal int literal (an optional leading minus and digits).
fn: lm_graph_int_literal (@: text c.LmP0Text; @: out int) int
    size_t: i 0U
    int: neg 0
    int: v 0
    if: text = 0 || out = 0 || text\length = 0U
        return: 0
    if: text\data[0] = 45
        neg: 1
        i: 1U
    ---
    if: i >= text\length
        return: 0
    while: i < text\length
        if: text\data[i] < 48 || text\data[i] > 57
            return: 0
        v: v * 10 + ((cast: (int) text\data[i]) - 48)
        i: i + 1U
    ---
    if: neg != 0
        v: 0 - v
    out[0]: v
    return: 1
end: lm_graph_int_literal

# ---- The builder: P0 tree -> clean graph (§1a) --------------------------------------------------------------------

# Construction consumes the P0 sequence and its argument separators. The only resulting expression representation
# is the nested Lmx graph. Temporary cursors and the scratch list leave with construction.
# Only construction assigns a parent while putting a written child. Runtime writes go through invalidation.
fn: lm_graph_build_put (@: g c.LmxGraph; @: parent c.Lmx; size_t: index; @: value void) int
    @: child c.Lmx 0
    if: c.lmx_graph_put(parent, index, value) != 0
        return: 1
    if: c.lmx_graph_kind(g, value) = 4
        child: (cast: (@: c.Lmx) value)
        child\parent: parent
    return: 0
end: lm_graph_build_put

# Precedence belongs to the builder. Consumers see a binary Lmx [left, operator-word, right], never a token stream.
fn: lm_graph_build_power (@: word char) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    if: word = state\w_deref
        return: 8
    if: word = state\w_star || word = state\w_slash || word = state\w_percent
        return: 6
    if: word = state\w_plus || word = state\w_minus
        return: 5
    if: word = state\w_lt || word = state\w_le || word = state\w_gt || word = state\w_ge
        return: 4
    if: word = state\w_eq || word = state\w_ne
        return: 3
    if: word = state\w_and
        return: 2
    if: word = state\w_or
        return: 1
    return: 0
end: lm_graph_build_power

fn: lm_graph_build_expression (@: g c.LmxGraph; @@: cursor c.LmP0Field; int: least; @: boundary int; @@: out void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: item c.LmP0Field cursor[0]
    @: nd c.LmP0Node 0
    @: token c.LmP0Text 0
    @: word char 0
    @: left void 0
    @: right void 0
    @: operator void 0
    @: expression c.Lmx 0
    int: power 0
    int: status 0
    if: item = 0 || out = 0
        return: 2
    nd: lm_graph_p0_value(item)
    boundary[0]: (cast: (int) ((nd\flags & c.LM_P0_NODE_SEPARATOR_AFTER) != 0U))
    cursor[0]: lm_graph_next_active(lm_graph_p0_next(item))
    if: nd\kind = c.LM_P0_NODE_ATOM
        token: lm_graph_p0_atom(nd)
        word: c.lmx_graph_intern(lm_graph_p0_data(token), lm_graph_p0_length(token))
    ---
    if: word != 0 && (word = state\w_plus || word = state\w_minus || word = state\w_deref || word = state\w_at || word = state\w_not)
        if: boundary[0] != 0
            return: 2
        status: lm_graph_build_expression(g, cursor, 7, boundary, @ right)
        if: status != 0
            return: status
        expression: c.lmx_graph_lmx(g, 0, 2U)
        operator: c.lmx_graph_word(g, lm_graph_p0_data(token), lm_graph_p0_length(token))
        if: expression = 0 || operator = 0 || lm_graph_build_put(g, expression, 0U, operator) != 0 || lm_graph_build_put(g, expression, 1U, right) != 0
            return: 1
        left: (cast: (@: void) expression)
    else:
        status: lm_graph_build_node(g, 0, nd, @ left)
        if: status != 0
            return: status
        ---
    ---
    while: cursor[0] != 0 && boundary[0] = 0
        item: cursor[0]
        nd: lm_graph_p0_value(item)
        if: nd\kind != c.LM_P0_NODE_ATOM
            break
        token: lm_graph_p0_atom(nd)
        word: c.lmx_graph_intern(lm_graph_p0_data(token), lm_graph_p0_length(token))
        power: lm_graph_build_power(word)
        if: power = 0 || power < least
            break
        if: (nd\flags & c.LM_P0_NODE_SEPARATOR_AFTER) != 0U
            return: 2
        cursor[0]: lm_graph_next_active(lm_graph_p0_next(item))
        status: lm_graph_build_expression(g, cursor, power + 1, boundary, @ right)
        if: status != 0
            return: status
        expression: c.lmx_graph_lmx(g, 0, 3U)
        operator: c.lmx_graph_word(g, lm_graph_p0_data(token), lm_graph_p0_length(token))
        if: expression = 0 || operator = 0 || lm_graph_build_put(g, expression, 0U, left) != 0 || lm_graph_build_put(g, expression, 1U, operator) != 0 || lm_graph_build_put(g, expression, 2U, right) != 0
            return: 1
        left: (cast: (@: void) expression)
    ---
    out[0]: left
    return: 0
end: lm_graph_build_expression

# The parser's closing postcondition is lowered to an ordinary receiver Lmx. No P0 trailer or source-form flag
# survives construction. Consumers identify until by its canonical string address.
fn: lm_graph_until_tail (@: tail c.LmP0Trailer) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    if: tail = 0 || tail\spelling = 0
        return: 0
    return: (cast: (int) (c.lmx_graph_intern((cast: (@: char) tail\spelling\data), (cast: (size_t) tail\spelling\length)) = state\w_until))
end: lm_graph_until_tail

fn: lm_graph_build_post (@: g c.LmxGraph; @: parent c.Lmx; @: body c.Lmx; @: tail c.LmP0Trailer; @@: out void) int
    @: cursor c.LmP0Field lm_graph_next_active(lm_graph_p0_first((cast: (@: c.LmP0Structure) tail\body)))
    @: condition void 0
    @: loop c.Lmx 0
    int: boundary 0
    int: status lm_graph_build_expression(g, @ cursor, 1, @ boundary, @ condition)
    if: status != 0 || cursor != 0
        return: 2
    loop: c.lmx_graph_lmx(g, parent, 3U)
    if: loop = 0 || lm_graph_build_put(g, loop, 0U, c.lmx_graph_word(g, "until", 5U)) != 0 || lm_graph_build_put(g, loop, 1U, condition) != 0 || lm_graph_build_put(g, loop, 2U, (cast: (@: void) body)) != 0
        return: 1
    out[0]: (cast: (@: void) loop)
    return: 0
end: lm_graph_build_post

# Collect one normalized expression per argument/field. The scratch pointer array is discarded; the resulting Lmx
# has its exact fixed size. P0 separators stop an operand, so a unary operator after a comma starts the next argument.
fn: lm_graph_build_sequence (@: g c.LmxGraph; @: parent c.Lmx; @: source c.LmP0Structure; @: head void; @: tail c.LmP0Trailer; @@: out void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    size_t: capacity (cast: (size_t) (lm_graph_count_active(source) + 1U))
    @@: items void (cast: (@@: void) c.calloc(capacity, sizeof(@: void)))
    size_t: count 0U
    size_t: i 0U
    @: cursor c.LmP0Field 0
    @: result c.Lmx 0
    int: boundary 0
    int: status 0
    if: items = 0
        return: 1
    if: head != 0
        items[count]: head
        count: count + 1U
    if: source != 0
        cursor: lm_graph_next_active(lm_graph_p0_first(source))
    # The written name of a primitive declaration is a name field, not the left operand of its initializer.
    if: cursor != 0 && (c.lmx_graph_word_text(g, head) = state\w_int || c.lmx_graph_word_text(g, head) = state\w_at)
        status: lm_graph_build_node(g, 0, lm_graph_p0_value(cursor), @ items[count])
        if: status = 0
            count: count + 1U
            cursor: lm_graph_next_active(lm_graph_p0_next(cursor))
        ---
    ---
    while: cursor != 0 && status = 0
        boundary: 0
        status: lm_graph_build_expression(g, @ cursor, 1, @ boundary, @ items[count])
        if: status = 0
            count: count + 1U
        ---
    ---
    if: status = 0
        result: c.lmx_graph_lmx(g, parent, count)
        if: result = 0
            status: 1
        while: i < count && status = 0
            status: lm_graph_build_put(g, result, i, items[i])
            i: i + 1U
        ---
    ---
    c.free((cast: (@: void) items))
    out[0]: (cast: (@: void) result)
    if: status = 0 && lm_graph_until_tail(tail) != 0
        status: lm_graph_build_post(g, parent, result, tail, out)
    return: status
end: lm_graph_build_sequence

# A parser assignment flag becomes an ordinary Lmx operator and its operands. No parser flag survives.
# The written selector is split here, once; consumers use the same nested field expression as every other path.
fn: lm_graph_build_assignment (@: g c.LmxGraph; @: parent c.Lmx; @: frame c.LmP0Frame; @@: out void) int
    @: text c.LmP0Text lm_graph_p0_head(frame)
    const: @: bytes char lm_graph_p0_data(text)
    size_t: text_size lm_graph_p0_length(text)
    size_t: start 0U
    size_t: i 0U
    @: part void 0
    @: left void 0
    @: path c.Lmx 0
    @: rhs void 0
    @: result c.Lmx 0
    int: status 0
    while: i <= text_size
        if: i = text_size || bytes[i] = 92
            if: i = start
                return: 2
            part: c.lmx_graph_word(g, bytes + start, i - start)
            if: part = 0
                return: 1
            if: left = 0
                left: part
            else:
                path: c.lmx_graph_lmx(g, 0, 3U)
                if: path = 0 || lm_graph_build_put(g, path, 0U, left) != 0 || lm_graph_build_put(g, path, 1U, c.lmx_graph_word(g, "\\", 1U)) != 0 || lm_graph_build_put(g, path, 2U, part) != 0
                    return: 1
                left: (cast: (@: void) path)
            ---
            start: i + 1U
        ---
        i: i + 1U
    ---
    status: lm_graph_build_sequence(g, 0, lm_graph_p0_body(frame), 0, (cast: (@: c.LmP0Trailer) frame\trailer), @ rhs)
    if: status != 0
        return: status
    if: c.lmx_graph_count((cast: (@: c.Lmx) rhs)) != 1U
        return: 2
    result: c.lmx_graph_lmx(g, parent, 3U)
    if: result = 0 || lm_graph_build_put(g, result, 0U, c.lmx_graph_word(g, ":=", 2U)) != 0 || lm_graph_build_put(g, result, 1U, left) != 0 || lm_graph_build_put(g, result, 2U, c.lmx_graph_get((cast: (@: c.Lmx) rhs), 0U)) != 0
        return: 1
    out[0]: (cast: (@: void) result)
    return: 0
end: lm_graph_build_assignment

fn: lm_graph_build_node (@: g c.LmxGraph; @: parent c.Lmx; @: nd c.LmP0Node; @@: out void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: text c.LmP0Text 0
    @: frame c.LmP0Frame 0
    @: source c.LmP0Structure 0
    @: literal c.LmP0Field 0
    @: value void 0
    int: number 0
    if: g = 0 || nd = 0 || out = 0
        return: 2
    out[0]: 0
    if: nd\kind = c.LM_P0_NODE_ATOM
        text: lm_graph_p0_atom(nd)
        if: lm_graph_int_literal(text, @ number) != 0
            value: c.lmx_graph_int(g, number)
        else:
            value: c.lmx_graph_word(g, lm_graph_p0_data(text), lm_graph_p0_length(text))
        ---
        if: value = 0
            return: 1
        out[0]: value
        return: 0
    if: nd\kind = c.LM_P0_NODE_FRAME
        frame: lm_graph_p0_frame(nd)
        if: (frame\flags & c.LM_P0_FRAME_ASSIGN) != 0U
            return: lm_graph_build_assignment(g, parent, frame, out)
        text: lm_graph_p0_head(frame)
        # A literal primitive value has the same physical form everywhere, including a typed RHS.
        if: c.lmx_graph_intern(lm_graph_p0_data(text), lm_graph_p0_length(text)) = state\w_int && lm_graph_count_active(lm_graph_p0_body(frame)) = 1U
            literal: lm_graph_next_active(lm_graph_p0_first(lm_graph_p0_body(frame)))
            if: literal != 0 && literal\value\kind = c.LM_P0_NODE_ATOM && lm_graph_int_literal(lm_graph_p0_atom(lm_graph_p0_value(literal)), @ number) != 0
                out[0]: c.lmx_graph_int(g, number)
                return: (cast: (int) (out[0] = 0))
            ---
        ---
        value: c.lmx_graph_word(g, lm_graph_p0_data(text), lm_graph_p0_length(text))
        if: value = 0
            return: 1
        return: lm_graph_build_sequence(g, parent, lm_graph_p0_body(frame), value, (cast: (@: c.LmP0Trailer) frame\trailer), out)
    if: nd\kind = c.LM_P0_NODE_STRUCTURE
        source: lm_graph_p0_structure(nd)
        return: lm_graph_build_sequence(g, parent, source, 0, (cast: (@: c.LmP0Trailer) source\trailer), out)
    return: 2
end: lm_graph_build_node

# Build data/signature fields through the same constructor. A body retains its written statements and effects.
fn: lm_graph_build_fields (@: g c.LmxGraph; @: parent c.Lmx; @: source c.LmP0Structure; int: declarations; @: tail c.LmP0Trailer; @@: out c.Lmx) int
    @: result c.Lmx 0
    @: outer c.Lmx 0
    @: loop void 0
    size_t: own_count 0U
    size_t: j 0U
    @: item c.LmP0Field 0
    @: value void 0
    size_t: i 0U
    int: status 0
    if: source = 0 || out = 0
        return: 2
    result: c.lmx_graph_lmx(g, parent, lm_graph_count_active(source))
    if: result = 0
        return: 1
    item: lm_graph_next_active(lm_graph_p0_first(source))
    while: item != 0 && status = 0
        if: declarations != 0
            status: lm_graph_build_field(g, result, i, lm_graph_p0_value(item))
        else:
            status: lm_graph_build_node(g, result, lm_graph_p0_value(item), @ value)
            if: status = 0
                status: c.lmx_graph_put(result, i, value)
            ---
        ---
        i: i + 1U
        item: lm_graph_next_active(lm_graph_p0_next(item))
    ---
    if: status = 0 && lm_graph_until_tail(tail) != 0
        # A named Structure retains its ordinary named fields, including var. Its executable field is the loop;
        # the loop body shares those data fields, so names, references and selected data keep their ordinary meaning.
        i: 0U
        while: i < c.lmx_graph_count(result)
            if: c.lmx_graph_slot_name(g, result, i) != 0
                own_count: own_count + 1U
            i: i + 1U
        outer: c.lmx_graph_lmx(g, parent, own_count + 1U)
        if: outer = 0
            return: 1
        i: 0U
        while: i < c.lmx_graph_count(result) && status = 0
            if: c.lmx_graph_slot_name(g, result, i) != 0
                status: lm_graph_build_put(g, outer, j, c.lmx_graph_get(result, i))
                j: j + 1U
            i: i + 1U
        if: status = 0
            status: lm_graph_build_post(g, outer, result, tail, @ loop)
        if: status = 0
            status: c.lmx_graph_put(outer, own_count, loop)
        result: outer
    ---
    out[0]: result
    return: status
end: lm_graph_build_fields

# The temporary constructor inventory supplies the complete size before allocating var. It is discarded, not
# attached to the graph. All own fields of an auto-filled var are visible from the start of the body (author Nov8).
# Constructor-only inventory: visit inline control bodies, never a nested callable or a call's argument data.
fn: lm_graph_build_inline_names (@: g c.LmxGraph; @: value void; @: args c.Lmx; @@@: names char; @: count size_t; @: capacity size_t) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: current c.Lmx (cast: (@: c.Lmx) value)
    @: head char 0
    @: name char 0
    @@: grown char 0
    size_t: i 0U
    size_t: j 0U
    int: status 0
    if: c.lmx_graph_kind(g, value) != 4 || c.lmx_graph_name_of(g, value) != 0 || c.lmx_graph_method(g, current) != 0
        return: 0
    head: c.lmx_graph_word_text(g, c.lmx_graph_get(current, 0U))
    if: head = state\w_int
        name: c.lmx_graph_word_text(g, c.lmx_graph_get(current, 1U))
        if: name = 0
            return: 2
        while: j < count[0] && names[0][j] != name
            j: j + 1U
        if: j = count[0] && c.lmx_graph_named(g, args, name) = c.lmx_graph_count(args)
            if: count[0] = capacity[0]
                grown: (cast: (@@: char) c.realloc(names[0], (capacity[0] * 2U + 1U) * sizeof(@: char)))
                if: grown = 0
                    return: 1
                names[0]: grown
                capacity[0]: capacity[0] * 2U + 1U
            names[0][count[0]]: name
            count[0]: count[0] + 1U
        return: 0
    if: head != 0 && head != state\w_if && head != state\w_else && head != state\w_while && head != state\w_for && head != state\w_until && head != state\w_finally
        return: 0
    while: i < c.lmx_graph_count(current) && status = 0
        status: lm_graph_build_inline_names(g, c.lmx_graph_get(current, i), args, names, count, capacity)
        i: i + 1U
    return: status
end: lm_graph_build_inline_names

fn: lm_graph_build_body_var (@: g c.LmxGraph; @: code c.Lmx; @: args c.Lmx; @: source c.LmP0Structure; @: body_source c.LmP0Structure; @@: out c.Lmx; @@: out_body c.Lmx) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: item c.LmP0Field 0
    @: first c.LmP0Field 0
    @: nd c.LmP0Node 0
    @: fr c.LmP0Frame 0
    @: text c.LmP0Text 0
    @: statement c.Lmx 0
    @: vars c.Lmx 0
    @: body c.Lmx 0
    @@: names char 0
    @: name char 0
    @: value void 0
    size_t: capacity 0U
    size_t: explicit_count 0U
    size_t: count 0U
    size_t: i 0U
    size_t: j 0U
    int: status 0
    if: source != 0
        explicit_count: lm_graph_count_active(source)
        item: lm_graph_next_active(lm_graph_p0_first(source))
    count: explicit_count
    capacity: explicit_count + lm_graph_count_active(body_source) + 1U
    names: (cast: (@@: char) c.calloc(capacity, sizeof(@: char)))
    if: names = 0
        return: 1
    while: item != 0 && status = 0
        nd: lm_graph_p0_value(item)
        if: nd\kind != c.LM_P0_NODE_FRAME
            status: 2
        else:
            fr: lm_graph_p0_frame(nd)
            text: lm_graph_p0_head(fr)
            name: c.lmx_graph_intern(lm_graph_p0_data(text), lm_graph_p0_length(text))
            if: name = state\w_int
                first: lm_graph_next_active(lm_graph_p0_first(lm_graph_p0_body(fr)))
                if: first = 0 || first\value\kind != c.LM_P0_NODE_ATOM
                    status: 2
                else:
                    text: lm_graph_p0_atom(lm_graph_p0_value(first))
                    name: c.lmx_graph_intern(lm_graph_p0_data(text), lm_graph_p0_length(text))
                ---
            ---
            names[i]: name
        ---
        i: i + 1U
        item: lm_graph_next_active(lm_graph_p0_next(item))
    ---
    body: c.lmx_graph_lmx(g, code, lm_graph_count_active(body_source))
    if: body = 0
        status: 1
    i: 0U
    item: lm_graph_next_active(lm_graph_p0_first(body_source))
    # Construct statements/method Lmx and inventory own declarations together. This is construction, not the later
    # consumer's method collection: no constructor inventory is passed to translation or execution.
    while: item != 0 && status = 0
        nd: lm_graph_p0_value(item)
        name: 0
        if: nd\kind = c.LM_P0_NODE_FRAME
            fr: lm_graph_p0_frame(nd)
            text: lm_graph_p0_head(fr)
            name: c.lmx_graph_intern(lm_graph_p0_data(text), lm_graph_p0_length(text))
        if: name = state\w_fn || name = state\w_sub
            status: lm_graph_build_method(g, body, fr, @ value)
        else:
            status: lm_graph_build_node(g, body, nd, @ value)
        ---
        if: status = 0
            status: c.lmx_graph_put(body, i, value)
        if: status = 0
            status: lm_graph_build_inline_names(g, value, args, @ names, @ count, @ capacity)
        i: i + 1U
        item: lm_graph_next_active(lm_graph_p0_next(item))
    ---
    if: status = 0
        vars: c.lmx_graph_lmx(g, code, count)
        if: vars = 0
            status: 1
        ---
    i: 0U
    if: source != 0
        item: lm_graph_next_active(lm_graph_p0_first(source))
    while: item != 0 && status = 0
        status: lm_graph_build_field(g, vars, i, lm_graph_p0_value(item))
        i: i + 1U
        item: lm_graph_next_active(lm_graph_p0_next(item))
    ---
    i: explicit_count
    while: i < count && status = 0
        value: c.lmx_graph_uninit_int(g)
        if: value = 0 || c.lmx_graph_name_address(g, c.lmx_arena_pointer_void_read(value), names[i]) != 0 || c.lmx_graph_put(vars, i, value) != 0
            status: 1
        i: i + 1U
    ---
    c.free((cast: (@: void) names))
    out[0]: vars
    out_body[0]: body
    return: status
end: lm_graph_build_body_var

# The callable's visible parts are normalized once by construction. Written requirements remain words, not resolved bindings.
fn: lm_graph_build_method (@: g c.LmxGraph; @: parent c.Lmx; @: fr c.LmP0Frame; @@: out void) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: head char c.lmx_graph_intern(lm_graph_p0_data(lm_graph_p0_head(fr)), lm_graph_p0_length(lm_graph_p0_head(fr)))
    size_t: parts 4U
    @: item c.LmP0Field lm_graph_next_active(lm_graph_p0_first(lm_graph_p0_body(fr)))
    @: name c.LmP0Text 0
    @: code c.Lmx 0
    @: args c.Lmx 0
    @: result c.Lmx 0
    @: vars c.Lmx 0
    @: body c.Lmx 0
    @: var_source c.LmP0Structure 0
    @: value void 0
    @: formal c.Lmx 0
    @: formal_name char 0
    size_t: i 0U
    size_t: arity lm_graph_count_active(lm_graph_p0_body(fr))
    int: status 0
    if: head = state\w_fn
        parts: 5U
    if: item = 0 || item\value\kind != c.LM_P0_NODE_ATOM || (arity != parts - 1U && arity != parts)
        return: 2
    name: lm_graph_p0_atom(lm_graph_p0_value(item))
    code: c.lmx_graph_lmx(g, parent, parts)
    if: code = 0
        return: 1
    item: lm_graph_next_active(lm_graph_p0_next(item))
    if: item = 0 || item\value\kind != c.LM_P0_NODE_STRUCTURE
        return: 2
    status: lm_graph_build_fields(g, code, lm_graph_p0_structure(lm_graph_p0_value(item)), 1, 0, @ args)
    if: status != 0
        return: status
    while: i < c.lmx_graph_count(args)
        value: c.lmx_graph_get(args, i)
        if: c.lmx_graph_kind(g, value) = 4
            formal: (cast: (@: c.Lmx) value)
            if: c.lmx_graph_count(formal) != 2U
                return: 2
            formal_name: c.lmx_graph_word_text(g, c.lmx_graph_get(formal, 1U))
            if: c.lmx_graph_name_address(g, value, formal_name) != 0
                return: 2
            ---
        ---
        i: i + 1U
    ---
    item: lm_graph_next_active(lm_graph_p0_next(item))
    if: item = 0
        return: 2
    if: head = state\w_fn
        result: c.lmx_graph_lmx(g, code, 1U)
        if: result = 0
            return: 1
        status: lm_graph_build_node(g, result, lm_graph_p0_value(item), @ value)
        if: status != 0 || c.lmx_graph_put(result, 0U, value) != 0
            return: 2
        item: lm_graph_next_active(lm_graph_p0_next(item))
    ---
    if: arity = parts
        if: item = 0 || item\value\kind != c.LM_P0_NODE_STRUCTURE
            return: 2
        var_source: lm_graph_p0_structure(lm_graph_p0_value(item))
        item: lm_graph_next_active(lm_graph_p0_next(item))
    ---
    if: item = 0 || item\value\kind != c.LM_P0_NODE_STRUCTURE
        return: 2
    status: lm_graph_build_body_var(g, code, args, var_source, lm_graph_p0_structure(lm_graph_p0_value(item)), @ vars, @ body)
    if: status != 0
        return: status
    if: c.lmx_graph_name(g, (cast: (@: void) code), lm_graph_p0_data(name), lm_graph_p0_length(name)) != 0
        return: 1
    if: c.lmx_graph_name(g, (cast: (@: void) args), "args", 4U) != 0 || c.lmx_graph_name(g, (cast: (@: void) vars), "var", 3U) != 0 || c.lmx_graph_name(g, (cast: (@: void) body), "body", 4U) != 0
        return: 1
    if: result != 0
        if: c.lmx_graph_name(g, (cast: (@: void) result), "return", 6U) != 0 || c.lmx_graph_put(code, 2U, (cast: (@: void) result)) != 0
            return: 1
        ---
    ---
    if: c.lmx_graph_put(code, 0U, c.lmx_graph_word(g, head, c.strlen(head))) != 0 || c.lmx_graph_put(code, 1U, (cast: (@: void) args)) != 0 || c.lmx_graph_put(code, parts - 2U, (cast: (@: void) vars)) != 0 || c.lmx_graph_put(code, parts - 1U, (cast: (@: void) body)) != 0
        return: 1
    out[0]: (cast: (@: void) code)
    return: 0
end: lm_graph_build_method

# Input-boundary classification of a named data block. An unsupported language receiver must remain an executable
# Frame and fail explicitly in its consumer, rather than becoming inert data merely because it has an end trailer.
fn: lm_graph_data_head (@: head char) int
    @: words char "fn sub fm if else while for do until finally return break continue redo switch case catch throw throws synchronized call merge table var args body data const immutable independent implements test post external sendMessage receiveMessage adopt length cast sizeof int char unsigned ulong size_t short long float double signed _Bool enum struct include import predef prototype end"
    size_t: at 0U
    size_t: start 0U
    while: words[at] != 0
        start: at
        while: words[at] != 0 && words[at] != 32
            at: at + 1U
        ---
        if: head = c.lmx_graph_intern(words + start, at - start)
            return: 0
        if: words[at] != 0
            at: at + 1U
        ---
    ---
    return: 1
end: lm_graph_data_head

# One written field of the root into slot of root: a declaration `int: name` is a place without a value and `int: name
# literal` an int place, each named at its cell; everything else is the written nd itself (a statement with a word
# head, a bare atom, a block). 0, 1 without memory, 2 for a nd of no known kind.
fn: lm_graph_build_field (@: g c.LmxGraph; @: root c.Lmx; size_t: slot; @: nd c.LmP0Node) int
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: fr c.LmP0Frame 0
    @: f1 c.LmP0Field 0
    @: f2 c.LmP0Field 0
    @: name c.LmP0Text 0
    @: head char 0
    @: cell void 0
    @: value void 0
    @: structure c.Lmx 0
    @: tail c.LmP0Trailer 0
    size_t: n 0U
    int: v 0
    int: r 0
    if: state = 0 || g = 0 || root = 0 || nd = 0
        return: 2
    if: nd\kind = c.LM_P0_NODE_FRAME
        fr: lm_graph_p0_frame(nd)
        if: (fr\flags & c.LM_P0_FRAME_ASSIGN) != 0U
            r: lm_graph_build_node(g, root, nd, @ value)
            if: r != 0
                return: r
            return: c.lmx_graph_put(root, slot, value)
        head: c.lmx_graph_intern(lm_graph_p0_data(lm_graph_p0_head(fr)), lm_graph_p0_length(lm_graph_p0_head(fr)))
        if: head = 0
            return: 1
        if: head = state\w_fn || head = state\w_sub
            r: lm_graph_build_method(g, root, fr, @ value)
            if: r != 0
                return: r
            return: c.lmx_graph_put(root, slot, value)
        if: fr\trailer != 0 && (lm_graph_data_head(head) != 0 || head = state\w_var)
            tail: (cast: (@: c.LmP0Trailer) fr\trailer)
            if: lm_graph_until_tail(tail) != 0 || (tail\spelling != 0 && c.lmx_graph_intern((cast: (@: char) tail\spelling\data), (cast: (size_t) tail\spelling\length)) = c.lmx_graph_intern("end", 3U))
                r: lm_graph_build_fields(g, root, lm_graph_p0_body(fr), 1, tail, @ structure)
                if: r != 0
                    return: r
                if: c.lmx_graph_name_address(g, (cast: (@: void) structure), head) != 0
                    return: 1
                return: c.lmx_graph_put(root, slot, (cast: (@: void) structure))
            ---
        if: head = state\w_int && fr\body != 0
            n: lm_graph_count_active(lm_graph_p0_body(fr))
            f1: lm_graph_next_active(lm_graph_p0_first(lm_graph_p0_body(fr)))
            if: n >= 1U && f1 != 0 && f1\value\kind = c.LM_P0_NODE_ATOM
                name: lm_graph_p0_atom(lm_graph_p0_value(f1))
                if: n = 1U
                    cell: c.lmx_graph_uninit_int(g)
                    if: cell = 0
                        return: 1
                    value: c.lmx_arena_pointer_void_read(cell)
                    if: c.lmx_graph_name(g, value, lm_graph_p0_data(name), lm_graph_p0_length(name)) != 0
                        return: 1
                    return: c.lmx_graph_put(root, slot, cell)
                f2: lm_graph_next_active(lm_graph_p0_next(f1))
                if: n = 2U && f2 != 0 && f2\value\kind = c.LM_P0_NODE_ATOM && lm_graph_int_literal(lm_graph_p0_atom(lm_graph_p0_value(f2)), @ v) != 0
                    cell: c.lmx_graph_int(g, v)
                    if: cell = 0
                        return: 1
                    if: c.lmx_graph_name(g, cell, lm_graph_p0_data(name), lm_graph_p0_length(name)) != 0
                        return: 1
                    return: c.lmx_graph_put(root, slot, cell)
                ---
            ---
        ---
    ---
    r: lm_graph_build_node(g, root, nd, @ value)
    if: r != 0
        return: r
    return: c.lmx_graph_put(root, slot, value)
end: lm_graph_build_field

# The root of a parsed document as a root Lmx of the arena of g: one slot per active field, built in the written order.
# 0 and the root in out; 1 without memory; 2 when the document has no root Structure or a nd of no known kind.
fn: lm_graph_build_root (@: g c.LmxGraph; @: doc c.LmP0Document; @@: out c.Lmx) int
    @: nd c.LmP0Node (cast: (@: c.LmP0Node) c.lm_p0_document_root(doc))
    @: s c.LmP0Structure 0
    @: f c.LmP0Field 0
    @: root c.Lmx 0
    size_t: n 0U
    size_t: i 0U
    int: r 0
    if: g = 0 || out = 0 || nd = 0 || nd\kind != c.LM_P0_NODE_STRUCTURE
        return: 2
    out[0]: 0
    s: lm_graph_p0_structure(nd)
    n: lm_graph_count_active(s)
    root: c.lmx_graph_lmx(g, 0, n)
    if: root = 0
        return: 1
    f: lm_graph_next_active(lm_graph_p0_first(s))
    while: f != 0
        r: lm_graph_build_field(g, root, i, lm_graph_p0_value(f))
        if: r != 0
            return: r
        i: i + 1U
        f: lm_graph_next_active(lm_graph_p0_next(f))
    ---
    out[0]: root
    return: 0
end: lm_graph_build_root

# The clean graph of the source file at path in the arena of g: parsed by P0, built, the parse tree destroyed. 0 and
# the root in out; 1 without memory; 2 when the file does not parse (the diagnostic printed) or has an unknown nd.
fn: lm_graph_build_file (@: g c.LmxGraph; const: (@: path char); @@: out c.Lmx) int
    @: doc c.LmP0Document 0
    @: diag c.LmP0Diagnostic 0
    int: r 0
    if: g = 0 || path = 0 || out = 0
        return: 2
    out[0]: 0
    if: c.lm_p0_parse_file(path, @ doc) != 0
        if: doc != 0
            diag: (cast: (@: c.LmP0Diagnostic) c.lm_p0_document_diagnostic(doc))
            if: diag != 0
                c.fprintf(c.stderr, "graph: %s:%zu:%zu: %s\n", path, (cast: (size_t) (diag\line)), (cast: (size_t) (diag\column)), (cast: (@: char) (diag\message)))
            c.lm_p0_document_destroy(doc)
        else:
            c.fprintf(c.stderr, "graph: %s: cannot read or parse\n", path)
        ---
        return: 2
    r: lm_graph_build_root(g, doc, out)
    c.lm_p0_document_destroy(doc)
    return: r
end: lm_graph_build_file

# ---- The emitter: clean graph -> the L1 of a program (§7) ---------------------------------------------------------

# A spelling as an L1 string literal: a quote and a backslash escaped.
sub: lm_graph_emit_quoted (@: f c.FILE; @: text char)
    size_t: i 0U
    c.fputc(34, f)
    while: text[i] != 0
        if: text[i] = 92 || text[i] = 34
            c.fputc(92, f)
        c.fputc((cast: (int) text[i]), f)
        i: i + 1U
    ---
    c.fputc(34, f)
    return
end: lm_graph_emit_quoted

# The row of the name table for the value, if any, as a name call after its construction into the L1 local `local`.
fn: lm_graph_emit_name_row (@: g c.LmxGraph; @: f c.FILE; @: address void; @: local char) int
    @: name char (cast: (@: char) c.lmx_graph_name_of(g, address))
    if: name = 0
        return: 0
    c.fprintf(f, "        if: lmx_graph_name(l2_g, %s, ", local)
    lm_graph_emit_quoted(f, name)
    c.fprintf(f, ", %zuU) != 0\n            return: 1\n", (cast: (size_t) c.strlen(name)))
    return: 0
end: lm_graph_emit_name_row

# One temporary source-address map covers the emitted graph, primitives and uninitialized referents. Each live
# address is allocated once; subsequent edges use that generated local. The map is destroyed by this translation.
fn: lm_graph_emit_value (@: g c.LmxGraph; @: f c.FILE; @: value void; @: holder char; size_t: k; @: map c.LmxCopyMap; @: next size_t) int
    int: kind (cast: (int) c.lmx_graph_kind(g, value))
    @: inner c.Lmx 0
    @: text char 0
    @: referent void 0
    @: local char (cast: (@: char) c.malloc(96U))
    size_t: id (cast: (size_t) c.lmx_copy_map_get(map, value))
    size_t: target 0U
    size_t: n 0U
    size_t: j 0U
    int: status 0
    if: local = 0 || value = 0
        c.free(local)
        return: 1
    if: id = 0U
        id: next[0]
        next[0]: id + 1U
        if: c.lmx_copy_map_put(map, value, (cast: (@: void) id)) != 0
            c.free(local)
            return: 1
        c.fprintf(f, "        @: void l2_gv%zu 0\n", id)
        if: kind = 1
            c.fprintf(f, "        l2_gv%zu: lmx_graph_int(l2_g, %d)\n", id, c.lmx_int_value_known(value))
        else:
            if: kind = 3
                referent: c.lmx_arena_pointer_void_read(value)
                target: (cast: (size_t) c.lmx_copy_map_get(map, referent))
                if: target = 0U
                    target: next[0]
                    next[0]: target + 1U
                    status: c.lmx_copy_map_put(map, referent, (cast: (@: void) target))
                    c.fprintf(f, "        @: void l2_gv%zu lmx_int_new_profiled(arena, 0)\n", target)
                c.fprintf(f, "        l2_gv%zu: lmx_arena_pointer_cells_profiled(arena, LMX_TYPE_UNINIT_INT, 0, sizeof(@: void), lmx_arena_pointer_void_read, lmx_arena_pointer_void_write, 1U)\n        if: l2_gv%zu = 0 || l2_gv%zu = 0 || lmx_arena_pointer_void_write(l2_gv%zu, l2_gv%zu) != 0\n            return: 1\n", id, id, target, id, target)
                c.snprintf(local, 96U, "l2_gv%zu", target)
                if: status = 0
                    status: lm_graph_emit_name_row(g, f, referent, local)
                ---
            else:
                if: kind = 2
                    text: c.lmx_graph_word_text(g, value)
                    if: text = 0
                        status: 1
                    else:
                        c.fprintf(f, "        l2_gv%zu: lmx_graph_word(l2_g, ", id)
                        lm_graph_emit_quoted(f, text)
                        c.fprintf(f, ", %zuU)\n", (cast: (size_t) c.strlen(text)))
                    ---
                else:
                    if: kind = 4
                        inner: (cast: (@: c.Lmx) value)
                        n: c.lmx_graph_count(inner)
                        c.fprintf(f, "        l2_gv%zu: (cast: (@: void) lmx_graph_lmx(l2_g, 0, %zuU))\n", id, n)
                        c.snprintf(local, 96U, "(cast: (@: Lmx) l2_gv%zu)", id)
                        while: j < n && status = 0
                            status: lm_graph_emit_value(g, f, c.lmx_graph_get(inner, j), local, j, map, next)
                            j: j + 1U
                        ---
                    else:
                        status: 1
                    ---
                ---
            ---
        ---
        c.fprintf(f, "        if: l2_gv%zu = 0\n            return: 1\n", id)
        c.snprintf(local, 96U, "l2_gv%zu", id)
        if: status = 0 && kind != 3
            status: lm_graph_emit_name_row(g, f, value, local)
        ---
    ---
    if: status = 0
        c.fprintf(f, "        if: lmx_graph_put(%s, %zuU, l2_gv%zu) != 0\n            return: 1\n", holder, k, id)
    c.free(local)
    return: status
end: lm_graph_emit_value

# All graph addresses exist before lexical parent edges are installed, including a parent reached after its child.
fn: lm_graph_emit_parents (@: g c.LmxGraph; @: f c.FILE; @: map c.LmxCopyMap) int
    @: keys c.VoidDynamicArray @ map\keys
    @: base c.VoidArray (cast: (@: c.VoidArray) keys)
    @@: sources void (cast: (@@: void) base\data)
    @: current c.Lmx 0
    size_t: i 0U
    size_t: id 0U
    size_t: parent 0U
    while: i < keys\capacity
        if: sources[i] != 0 && c.lmx_graph_kind(g, sources[i]) = 4
            current: (cast: (@: c.Lmx) sources[i])
            id: (cast: (size_t) c.lmx_copy_map_get(map, sources[i]))
            parent: (cast: (size_t) c.lmx_copy_map_get(map, (cast: (@: void) current\parent)))
            c.fprintf(f, "        l2_method: (cast: (@: Lmx) l2_gv%zu)\n", id)
            if: current\parent = 0
                c.fputs("        l2_method\\parent: 0\n", f)
            else:
                if: parent = 0U
                    return: 1
                c.fprintf(f, "        l2_method\\parent: (cast: (@: Lmx) l2_gv%zu)\n", parent)
            ---
        ---
        i: i + 1U
    return: 0
end: lm_graph_emit_parents

# The emitter's table of the declarations its native body has emitted so far (§3.5: the translator's own resolution,
# a table of its traversal): a declaration with a computed initializer names its slot from its statement on.
fn: lm_graph_emit_resolve (@: g c.LmxGraph; @: root c.Lmx; @@: decl_names char; @: decl_slots size_t; size_t: decl_n; @: name char) size_t
    size_t: i 0U
    while: i < decl_n
        if: decl_names[i] = name
            return: decl_slots[i]
        i: i + 1U
    ---
    return: c.lmx_graph_named(g, root, name)
end: lm_graph_emit_resolve

# Emit the address of a written substructure relative to this native activation's code. These field coordinates
# belong to emitted code only; the source graph has no saved lookup plan. Code mutation invalidates this entry.
fn: lm_graph_emit_address (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @: target c.Lmx) int
    @: parent c.Lmx 0
    size_t: i 0U
    if: target = scope
        c.fputs("lmx_call_code", f)
        return: 0
    if: target = 0
        return: 3
    parent: (cast: (@: c.Lmx) target\parent)
    if: parent = 0
        return: 3
    while: i < c.lmx_graph_count(parent) && c.lmx_graph_get(parent, i) != (cast: (@: void) target)
        i: i + 1U
    ---
    if: i >= c.lmx_graph_count(parent)
        return: 3
    c.fputs("(cast: (@: Lmx) lmx_graph_get(", f)
    if: lm_graph_emit_address(g, f, scope, parent) != 0
        return: 3
    c.fprintf(f, ", %zuU))", i)
    return: 0
end: lm_graph_emit_address

fn: lm_graph_emit_word (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @: expression c.Lmx; size_t: index) int
    c.fputs("lmx_graph_word_text(l2_g, lmx_graph_get(", f)
    if: lm_graph_emit_address(g, f, scope, expression) != 0
        return: 3
    c.fprintf(f, ", %zuU))", index)
    return: 0
end: lm_graph_emit_word

# Calls compile argument evaluation and immediate admission in source order. The common invocation owns only the
# activation and default places; it dispatches the native method body, not an interpreter wrapper.
# The native emitter carries only its current temporary counter and error/return destinations. These are
# compiler traversal data; no cleanup stack, code or dispatch IDs are stored in the program graph.
sub: lm_graph_emit_leave_text (@: buffer char; int: label; int: status)
    if: label < 0
        c.snprintf(buffer, 64U, "return: %d", status)
    else:
        c.snprintf(buffer, 64U, "goto: l2_label%d", label)
    ---
    return
end: lm_graph_emit_leave_text

fn: lm_graph_emit_call (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @: expression c.Lmx; @: temps int; @@: decl_names char; @: decl_slots size_t; size_t: decl_n; @: temp int) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    size_t: count (cast: (size_t) (c.lmx_graph_count(expression) - 1U))
    size_t: i 0U
    @: actual void 0
    @: holder c.Lmx expression
    size_t: at 0U
    int: call_id temps[0]
    int: value 0
    int: status 0
    temps[0]: temps[0] + 1
    c.fprintf(f, "        @: Lmx l2_call%d (cast: (@: Lmx) lmx_graph_resolve(l2_g, lmx_call_code, ", call_id)
    status: lm_graph_emit_word(g, f, scope, expression, 0U)
    c.fprintf(f, "))\n        []: size_t l2_binding%d %zuU\n        if: lmx_graph_bind_call(l2_g, l2_call%d, (cast: (@: Lmx) ", call_id, count + 1U, call_id)
    if: status = 0
        status: lm_graph_emit_address(g, f, scope, expression)
    c.fprintf(f, "), l2_binding%d) != 0\n            %s\n        []: @(void) l2_args%d %zuU\n", call_id, leave_failure, call_id, count + 1U)
    while: i < count && status = 0
        holder: expression
        at: i + 1U
        actual: c.lmx_graph_get(expression, at)
        if: c.lmx_graph_kind(g, actual) = 4 && c.lmx_graph_word_text(g, c.lmx_graph_get((cast: (@: c.Lmx) actual), 0U)) = state\w_assign
            if: c.lmx_graph_count((cast: (@: c.Lmx) actual)) != 3U
                return: 5
            holder: (cast: (@: c.Lmx) actual)
            at: 2U
        status: lm_graph_emit_operand(g, f, scope, holder, at, temps, decl_names, decl_slots, decl_n, @ value)
        c.fprintf(f, "        l2_args%d[%zuU]: l2_v%d\n", call_id, i, value)
        c.fprintf(f, "        if: lmx_graph_admit(l2_g, l2_call%d, l2_binding%d[%zuU], l2_args%d[%zuU], @ l2_args%d[%zuU]) != 0\n            %s\n", call_id, call_id, i, call_id, i, call_id, i, leave_failure)
        i: i + 1U
    ---
    c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_invoke_bound(l2_g, l2_call%d, l2_args%d, %zuU, l2_binding%d, @ l2_t%d) != 0\n            %s\n", call_id, call_id, call_id, count, call_id, call_id, leave_failure)
    temp[0]: call_id
    return: status
end: lm_graph_emit_call

# Compile an operand's address. Field paths preserve Structure values for receiving; only arithmetic/call results
# need a new result cell. Formal places are addressed directly in the current activation.
fn: lm_graph_emit_operand (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @: holder c.Lmx; size_t: index; @: temps int; @@: decl_names char; @: decl_slots size_t; size_t: decl_n; @: temp int) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void c.lmx_graph_get(holder, index)
    @: expression c.Lmx 0
    @: args c.Lmx 0
    @: word char c.lmx_graph_word_text(g, raw)
    size_t: count 0U
    size_t: slot 0U
    int: kind (cast: (int) c.lmx_graph_kind(g, raw))
    int: value 0
    int: number 0
    int: status 0
    if: kind = 4 && c.lmx_graph_name_of(g, raw) = 0
        expression: (cast: (@: c.Lmx) raw)
        count: c.lmx_graph_count(expression)
        if: count = 3U && c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 1U)) = state\w_deref
            status: lm_graph_emit_operand(g, f, scope, expression, 0U, temps, decl_names, decl_slots, decl_n, @ value)
            if: status != 0
                return: status
            c.fprintf(f, "        l2_v%d: lmx_graph_field(l2_g, l2_v%d, ", value, value)
            if: lm_graph_emit_word(g, f, scope, expression, 2U) != 0
                return: 3
            c.fprintf(f, ")\n        if: l2_v%d = 0\n            %s\n", value, leave_failure)
            temp[0]: value
            return: 0
        word: c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 0U))
        if: count = 2U && word = state\w_at
            if: c.lmx_graph_kind(g, c.lmx_graph_get(expression, 1U)) = 2
                value: temps[0]
                temps[0]: temps[0] + 1
                c.fprintf(f, "        @: void l2_v%d lmx_graph_resolve(l2_g, lmx_call_code, ", value)
                status: lm_graph_emit_word(g, f, scope, expression, 1U)
                c.fputs(")\n", f)
            else:
                status: lm_graph_emit_operand(g, f, scope, expression, 1U, temps, decl_names, decl_slots, decl_n, @ value)
            ---
            if: status != 0
                return: status
            c.fprintf(f, "        if: lmx_graph_kind(l2_g, l2_v%d) = 3\n            l2_v%d: lmx_arena_pointer_void_read(l2_v%d)\n        l2_v%d: lmx_graph_ref_int(l2_g, l2_v%d)\n        if: l2_v%d = 0\n            %s\n", value, value, value, value, value, value, leave_failure)
            temp[0]: value
            return: 0
        if: count = 1U && c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_resolve(g, scope, word))) = 0
            return: lm_graph_emit_operand(g, f, scope, expression, 0U, temps, decl_names, decl_slots, decl_n, temp)
        status: lm_graph_emit_number(g, f, scope, holder, index, temps, decl_names, decl_slots, decl_n, @ number)
        if: status != 0
            return: status
        value: temps[0]
        temps[0]: temps[0] + 1
        c.fprintf(f, "        @: void l2_v%d lmx_graph_int(l2_g, l2_t%d)\n        if: l2_v%d = 0\n            %s\n", value, number, value, leave_failure)
        temp[0]: value
        return: 0
    value: temps[0]
    temps[0]: temps[0] + 1
    if: kind = 2
        if: c.lmx_graph_method(g, scope) != 0
            args: (cast: (@: c.Lmx) c.lmx_graph_get(scope, 1U))
        slot: c.lmx_graph_named(g, args, word)
        if: args != 0 && slot < c.lmx_graph_count(args)
            c.fprintf(f, "        @: void l2_v%d refs[%zuU]\n", value, slot)
        else:
            c.fprintf(f, "        @: void l2_v%d lmx_graph_operand_name(l2_g, lmx_call_code, ", value)
            if: lm_graph_emit_word(g, f, scope, holder, index) != 0
                return: 3
            c.fputs(")\n", f)
        ---
    else:
        c.fprintf(f, "        @: void l2_v%d lmx_graph_get(", value)
        if: lm_graph_emit_address(g, f, scope, holder) != 0
            return: 3
        c.fprintf(f, ", %zuU)\n", index)
    ---
    c.fprintf(f, "        if: l2_v%d = 0\n            %s\n", value, leave_failure)
    temp[0]: value
    return: 0
end: lm_graph_emit_operand

# Compile one nested numeric expression. All grouping/precedence is already represented by its child Lmx fields.
fn: lm_graph_emit_number (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @: holder c.Lmx; size_t: index; @: temps int; @@: decl_names char; @: decl_slots size_t; size_t: decl_n; @: temp int) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: raw void c.lmx_graph_get(holder, index)
    @: expression c.Lmx 0
    @: word char 0
    @: method void 0
    size_t: count 0U
    size_t: slot 0U
    int: kind (cast: (int) c.lmx_graph_kind(g, raw))
    int: left 0
    int: right 0
    int: value 0
    int: status 0
    int: finish 0
    if: kind = 1
        left: temps[0]
        temps[0]: temps[0] + 1
        c.fprintf(f, "        int: l2_t%d %d\n", left, c.lmx_int_value_known(raw))
        temp[0]: left
        return: 0
    if: kind = 2
        left: temps[0]
        temps[0]: temps[0] + 1
        c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_named_int(l2_g, lmx_call_code, ", left)
        status: lm_graph_emit_word(g, f, scope, holder, index)
        c.fprintf(f, ", @ l2_t%d) != 0\n            %s\n", left, leave_failure)
        temp[0]: left
        return: status
    if: kind = 4
        expression: (cast: (@: c.Lmx) raw)
        count: c.lmx_graph_count(expression)
        word: c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 1U))
        if: count = 3U && (word = state\w_plus || word = state\w_minus || word = state\w_star || word = state\w_slash || word = state\w_percent || word = state\w_eq || word = state\w_ne || word = state\w_lt || word = state\w_le || word = state\w_gt || word = state\w_ge || word = state\w_and || word = state\w_or)
            status: lm_graph_emit_number(g, f, scope, expression, 0U, temps, decl_names, decl_slots, decl_n, @ left)
            if: status != 0
                return: status
            if: word = state\w_and || word = state\w_or
                finish: temps[0]
                temps[0]: temps[0] + 1
                c.fprintf(f, "        l2_t%d: (l2_t%d != 0)\n", left, left)
                if: word = state\w_and
                    c.fprintf(f, "        if: l2_t%d = 0\n            goto: l2_label%d\n", left, finish)
                else:
                    c.fprintf(f, "        if: l2_t%d != 0\n            goto: l2_label%d\n", left, finish)
                ---
            ---
            status: lm_graph_emit_number(g, f, scope, expression, 2U, temps, decl_names, decl_slots, decl_n, @ right)
            if: status != 0
                return: status
            if: word = state\w_slash || word = state\w_percent
                c.fprintf(f, "        if: l2_t%d = 0\n            %s\n", right, leave_failure)
            c.fprintf(f, "        l2_t%d: l2_t%d %s l2_t%d\n", left, left, word, right)
            if: word = state\w_and || word = state\w_or
                c.fprintf(f, "        l2_label%d: ()\n", finish)
            temp[0]: left
            return: 0
        word: c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 0U))
        if: count = 2U && (word = state\w_plus || word = state\w_minus || word = state\w_not)
            status: lm_graph_emit_number(g, f, scope, expression, 1U, temps, decl_names, decl_slots, decl_n, @ left)
            if: status != 0
                return: status
            if: word = state\w_minus
                c.fprintf(f, "        l2_t%d: 0 - l2_t%d\n", left, left)
            if: word = state\w_not
                c.fprintf(f, "        l2_t%d: (l2_t%d = 0)\n", left, left)
            temp[0]: left
            return: 0
        if: count = 2U && word = state\w_deref
            status: lm_graph_emit_operand(g, f, scope, expression, 1U, temps, decl_names, decl_slots, decl_n, @ value)
            if: status != 0
                return: status
            left: temps[0]
            temps[0]: temps[0] + 1
            c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_kind(l2_g, l2_v%d) != 5\n            %s\n        if: lmx_graph_value_int(l2_g, lmx_arena_pointer_void_read(l2_v%d), @ l2_t%d) != 0\n            %s\n", left, value, leave_failure, value, left, leave_failure)
            temp[0]: left
            return: 0
        method: c.lmx_graph_resolve(g, scope, word)
        if: c.lmx_graph_method(g, (cast: (@: c.Lmx) method)) != 0
            if: c.lmx_graph_has_result(g, (cast: (@: c.Lmx) method)) = 0
                return: 5
            return: lm_graph_emit_call(g, f, scope, expression, temps, decl_names, decl_slots, decl_n, temp)
        if: count = 1U
            return: lm_graph_emit_number(g, f, scope, expression, 0U, temps, decl_names, decl_slots, decl_n, temp)
        if: count != 3U || c.lmx_graph_word_text(g, c.lmx_graph_get(expression, 1U)) != state\w_deref
            return: 2
        ---
    ---
    status: lm_graph_emit_operand(g, f, scope, holder, index, temps, decl_names, decl_slots, decl_n, @ value)
    if: status != 0
        return: status
    left: temps[0]
    temps[0]: temps[0] + 1
    c.fprintf(f, "        int: l2_t%d 0\n        if: lmx_graph_value_int(l2_g, l2_v%d, @ l2_t%d) != 0\n            %s\n", left, value, left, leave_failure)
    temp[0]: left
    return: 0
end: lm_graph_emit_number

fn: lm_graph_emit_expr (@: g c.LmxGraph; @: f c.FILE; @: root c.Lmx; @: expr c.Lmx; size_t: from; size_t: to; @: temps int; @@: decl_names char; @: decl_slots size_t; size_t: decl_n; @: temp int) int
    if: to != from + 1U
        return: 2
    return: lm_graph_emit_number(g, f, root, expr, from, temps, decl_names, decl_slots, decl_n, temp)
end: lm_graph_emit_expr

# The native body of the root: its statements over the same cells, into f, each temporary declared on first emission
# and counted in temps. 0, or the interpreter's answers for a statement the emitter cannot translate.
# Both operands are evaluated as ordinary values before the shared code/data admission and dispatch.
fn: lm_graph_emit_explicit_call (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @: expression c.Lmx; @: temps int; @@: decl_names char; @: decl_slots size_t; size_t: decl_n) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    size_t: count c.lmx_graph_count(expression)
    int: code 0
    int: data 0
    int: status 0
    if: count < 2U || count > 3U
        return: 5
    status: lm_graph_emit_operand(g, f, scope, expression, 1U, temps, decl_names, decl_slots, decl_n, @ code)
    if: status = 0 && count = 3U
        status: lm_graph_emit_operand(g, f, scope, expression, 2U, temps, decl_names, decl_slots, decl_n, @ data)
    if: status != 0
        return: status
    c.fprintf(f, "        if: lmx_graph_call_data(l2_g, (cast: (@: Lmx) l2_v%d), ", code)
    if: count = 3U
        c.fprintf(f, "(cast: (@: Lmx) l2_v%d), 0", data)
    else:
        c.fputs("0, 1", f)
    ---
    c.fprintf(f, ") != 0\n            %s\n", leave_failure)
    return: 0
end: lm_graph_emit_explicit_call

# One proxy records the pending transfer and reaches either the cleanup body or its final dispatch. The word is
# the same canonical arena string used by the interpreter. A failing cleanup retains the pending error.
sub: lm_graph_emit_pending (@: f c.FILE; int: id; int: label; int: destination; @: word char; int: failed)
    c.fprintf(f, "        l2_label%d: ()\n", label)
    if: failed != 0
        c.fprintf(f, "        l2_pending_error%d: 1\n", id)
    if: word != 0
        c.fprintf(f, "        l2_pending_word%d: l2_pending_words%d\\w_%s\n", id, id, word)
    c.fprintf(f, "        goto: l2_label%d\n", destination)
    return
end: lm_graph_emit_pending

# Registration protects the remaining statements of this scope. All their exits pass through this cleanup;
# the cleanup itself targets a separate dispatch, so it cannot run itself again. Outer registrations still apply.
fn: lm_graph_emit_finally (@: g c.LmxGraph; @: f c.FILE; @: code c.Lmx; @: body c.Lmx; size_t: at; size_t: to; @: cleanup c.Lmx; int: mode; int: exit_label; int: again_label; int: step_label; @: temps int) int
    int: id temps[0]
    int: saved_failure temps[1]
    int: saved_return temps[2]
    int: protected_exit -1
    int: protected_again -1
    int: protected_step -1
    int: cleanup_mode mode
    int: status 0
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    @: leave_return char (cast: (@: char) leave_storage\returned)
    lm_graph_emit_leave_text(leave_failure, saved_failure, 1)
    lm_graph_emit_leave_text(leave_return, saved_return, 0)
    temps[0]: id + 12
    if: exit_label >= 0
        protected_exit: id + 3
    if: again_label >= 0
        protected_again: id + 4
    if: step_label >= 0
        protected_step: id + 5
    c.fprintf(f, "        int: l2_pending_error%d 0\n        @: char l2_pending_word%d 0\n        @: LmxGraphState l2_pending_words%d lmx_graph_state()\n", id, id, id)
    temps[1]: id + 1
    temps[2]: id + 2
    if: mode = 1
        status: lm_graph_emit_statements_from(g, f, code, at + 1U, temps)
    else:
        status: lm_graph_emit_block(g, f, code, body, at + 1U, to, mode, protected_exit, protected_again, protected_step, temps)
    ---
    temps[1]: saved_failure
    temps[2]: saved_return
    if: status != 0
        return: status
    c.fprintf(f, "        goto: l2_label%d\n", id)
    lm_graph_emit_pending(f, id, id + 1, id, 0, 1)
    lm_graph_emit_pending(f, id, id + 2, id, "return", 0)
    if: exit_label >= 0
        lm_graph_emit_pending(f, id, id + 3, id, "break", 0)
        protected_exit: id + 8
    if: again_label >= 0
        lm_graph_emit_pending(f, id, id + 4, id, "redo", 0)
        protected_again: id + 9
    if: step_label >= 0
        lm_graph_emit_pending(f, id, id + 5, id, "continue", 0)
        protected_step: id + 10
    c.fprintf(f, "        l2_label%d: ()\n        if: l2_pending_error%d != 0 || l2_pending_word%d = l2_pending_words%d\\w_return\n            if: lmx_graph_work_flush(l2_g) != 0\n                l2_pending_error%d: 1\n        ---\n", id, id, id, id, id)
    temps[1]: id + 6
    temps[2]: id + 7
    if: mode = 1
        cleanup_mode: 2
    status: lm_graph_emit_block(g, f, code, cleanup, 1U, c.lmx_graph_count(cleanup), cleanup_mode, protected_exit, protected_again, protected_step, temps)
    temps[1]: saved_failure
    temps[2]: saved_return
    if: status != 0
        return: status
    c.fprintf(f, "        goto: l2_label%d\n", id + 11)
    lm_graph_emit_pending(f, id, id + 6, id + 11, 0, 1)
    lm_graph_emit_pending(f, id, id + 7, id + 11, "return", 0)
    if: exit_label >= 0
        lm_graph_emit_pending(f, id, id + 8, id + 11, "break", 0)
    if: again_label >= 0
        lm_graph_emit_pending(f, id, id + 9, id + 11, "redo", 0)
    if: step_label >= 0
        lm_graph_emit_pending(f, id, id + 10, id + 11, "continue", 0)
    c.fprintf(f, "        l2_label%d: ()\n        if: l2_pending_error%d != 0\n            %s\n        if: l2_pending_word%d = l2_pending_words%d\\w_return\n            %s\n", id + 11, id, leave_failure, id, id, leave_return)
    if: exit_label >= 0
        c.fprintf(f, "        if: l2_pending_word%d = l2_pending_words%d\\w_break\n            goto: l2_label%d\n", id, id, exit_label)
    if: again_label >= 0
        c.fprintf(f, "        if: l2_pending_word%d = l2_pending_words%d\\w_redo\n            goto: l2_label%d\n", id, id, again_label)
    if: step_label >= 0
        c.fprintf(f, "        if: l2_pending_word%d = l2_pending_words%d\\w_continue\n            goto: l2_label%d\n", id, id, step_label)
    return: 0
end: lm_graph_emit_finally

# Compile the same visible assignment Lmx. Resolve/check the destination before the RHS, then generate its numeric
# computation directly. The helpers write normal working places or graph cells; they never interpret the RHS.
fn: lm_graph_emit_assignment (@: g c.LmxGraph; @: f c.FILE; @: code c.Lmx; @: statement c.Lmx; int: mode; @: temps int; @@: decl_names char; @: decl_slots size_t; size_t: decl_n) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: left void c.lmx_graph_get(statement, 1U)
    @: name char c.lmx_graph_word_text(g, left)
    @: path c.Lmx (cast: (@: c.Lmx) left)
    int: owner 0
    int: value 0
    int: status 0
    if: c.lmx_graph_count(statement) != 3U
        return: 2
    if: name != 0
        c.fputs("        if: lmx_graph_known_int(l2_g, lmx_call_code, ", f)
        status: lm_graph_emit_word(g, f, code, statement, 1U)
        c.fprintf(f, ", %d) != 0\n            %s\n", mode, leave_failure)
    else:
        if: c.lmx_graph_kind(g, left) != 4 || c.lmx_graph_count(path) != 3U || c.lmx_graph_word_text(g, c.lmx_graph_get(path, 1U)) != state\w_deref
            return: 2
        status: lm_graph_emit_operand(g, f, code, path, 0U, temps, decl_names, decl_slots, decl_n, @ owner)
        if: status != 0
            return: status
        c.fprintf(f, "        if: lmx_graph_kind(l2_g, l2_v%d) != 4\n            %s\n        size_t: l2_s%d lmx_graph_named(l2_g, (cast: (@: Lmx) l2_v%d), ", owner, leave_failure, owner, owner)
        status: lm_graph_emit_word(g, f, code, path, 2U)
        c.fprintf(f, ")\n        if: lmx_graph_place_cell(l2_g, (cast: (@: Lmx) l2_v%d), l2_s%d) = 0\n            %s\n", owner, owner, leave_failure)
    ---
    if: status != 0
        return: status
    status: lm_graph_emit_number(g, f, code, statement, 2U, temps, decl_names, decl_slots, decl_n, @ value)
    if: status != 0
        return: status
    if: name != 0
        if: mode = 0
            c.fputs("        if: lmx_graph_store_name(l2_g, lmx_call_code, ", f)
            status: lm_graph_emit_word(g, f, code, statement, 1U)
            c.fprintf(f, ", l2_t%d) != 0\n            %s\n", value, leave_failure)
        else:
            c.fputs("        if: lmx_graph_store_field(l2_g, lmx_call_code, lmx_call_code, lmx_graph_named(l2_g, lmx_call_code, ", f)
            status: lm_graph_emit_word(g, f, code, statement, 1U)
            c.fprintf(f, "), l2_t%d) != 0\n            %s\n", value, leave_failure)
        ---
    else:
        c.fprintf(f, "        if: lmx_graph_store_field(l2_g, lmx_call_code, (cast: (@: Lmx) l2_v%d), l2_s%d, l2_t%d) != 0\n            %s\n", owner, owner, value, leave_failure)
    ---
    return: status
end: lm_graph_emit_assignment

fn: lm_graph_emit_statements_from (@: g c.LmxGraph; @: f c.FILE; @: root c.Lmx; size_t: from; @: temps int) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    size_t: n (cast: (size_t) c.lmx_graph_count(root))
    @@: decl_names char c.calloc(n + 1U, sizeof(@: char))
    @: decl_slots size_t c.calloc(n + 1U, c.sizeof(c.size_t))
    size_t: decl_n 0U
    size_t: i 0U
    size_t: m 0U
    size_t: k 0U
    size_t: end_at 0U
    @: next c.Lmx 0
    @: value void 0
    @: inner c.Lmx 0
    @: head char 0
    @: name char 0
    int: temp 0
    int: r 0
    if: state = 0 || decl_names = 0 || decl_slots = 0
        return: 5
    # Earlier computed declarations have already been published by the time this continuation is entered.
    while: i < from
        value: c.lmx_graph_get(root, i)
        if: c.lmx_graph_kind(g, value) = 4 && c.lmx_graph_name_of(g, value) = 0
            inner: (cast: (@: c.Lmx) value)
            head: c.lmx_graph_word_text(g, c.lmx_graph_get(inner, 0U))
            if: head = state\w_int || head = state\w_at
                decl_names[decl_n]: c.lmx_graph_word_text(g, c.lmx_graph_get(inner, 1U))
                decl_slots[decl_n]: i
                decl_n: decl_n + 1U
            ---
        ---
        i: i + 1U
    ---
    while: i < n
        value: c.lmx_graph_get(root, i)
        if: c.lmx_graph_kind(g, value) = 4 && c.lmx_graph_name_of(g, value) = 0
            inner: (cast: (@: c.Lmx) value)
            m: c.lmx_graph_count(inner)
            head: 0
            if: m != 0U
                head: c.lmx_graph_word_text(g, c.lmx_graph_get(inner, 0U))
            if: head = state\w_assign
                r: lm_graph_emit_assignment(g, f, root, inner, 1, temps, decl_names, decl_slots, decl_n)
                if: r != 0
                    return: r
                i: i + 1U
                continue
            if: head = state\w_finally
                r: lm_graph_emit_finally(g, f, root, root, i, n, inner, 1, -1, -1, -1, temps)
                c.free((cast: (@: void) decl_names))
                c.free((cast: (@: void) decl_slots))
                return: r
            if: head = 0 || head = state\w_if || head = state\w_else || head = state\w_while || head = state\w_for || head = state\w_until || head = state\w_return
                end_at: i + 1U
                if: head = state\w_if && end_at < n && c.lmx_graph_kind(g, c.lmx_graph_get(root, end_at)) = 4
                    next: (cast: (@: c.Lmx) c.lmx_graph_get(root, end_at))
                    if: c.lmx_graph_word_text(g, c.lmx_graph_get(next, 0U)) = state\w_else
                        end_at: end_at + 1U
                    ---
                ---
                r: lm_graph_emit_block(g, f, root, root, i, end_at, 2, -1, -1, -1, temps)
                if: r != 0
                    return: r
                i: end_at
                continue
            if: head != 0
                if: head = state\w_call
                    r: lm_graph_emit_explicit_call(g, f, root, inner, temps, decl_names, decl_slots, decl_n)
                    if: r != 0
                        return: r
                    i: i + 1U
                    continue
                if: c.lmx_graph_method(g, (cast: (@: c.Lmx) c.lmx_graph_resolve(g, root, head))) != 0
                    r: lm_graph_emit_call(g, f, root, inner, temps, decl_names, decl_slots, decl_n, @ temp)
                    if: r != 0
                        return: r
                    i: i + 1U
                    continue
                if: m < 2U
                    return: 5
                if: head = state\w_at
                    if: m != 4U || c.lmx_graph_word_text(g, c.lmx_graph_get(inner, 2U)) != state\w_int
                        return: 5
                    name: c.lmx_graph_word_text(g, c.lmx_graph_get(inner, 1U))
                    if: name = 0
                        return: 5
                    r: lm_graph_emit_operand(g, f, root, inner, 3U, temps, decl_names, decl_slots, decl_n, @ temp)
                    if: r != 0
                        return: r
                    c.fprintf(f, "        l2_c: l2_v%d\n        if: lmx_graph_kind(l2_g, l2_c) != 5 || lmx_graph_publish(l2_g, lmx_call_code, %zuU, l2_c) != 0\n            %s\n", temp, i, leave_failure)
                    decl_names[decl_n]: name
                    decl_slots[decl_n]: i
                    decl_n: decl_n + 1U
                    i: i + 1U
                    continue
                if: head = state\w_int
                    name: c.lmx_graph_word_text(g, c.lmx_graph_get(inner, 1U))
                    if: m < 3U || name = 0
                        return: 5
                    r: lm_graph_emit_expr(g, f, root, inner, 2U, m, temps, decl_names, decl_slots, decl_n, @ temp)
                    if: r != 0
                        return: r
                    c.fprintf(f, "        l2_c: lmx_graph_int(l2_g, l2_t%d)\n        if: l2_c = 0 || lmx_graph_publish(l2_g, lmx_call_code, %zuU, l2_c) != 0\n            %s\n", temp, i, leave_failure)
                    decl_names[decl_n]: name
                    decl_slots[decl_n]: i
                    decl_n: decl_n + 1U
                else:
                    k: lm_graph_emit_resolve(g, root, decl_names, decl_slots, decl_n, head)
                    if: k >= n
                        return: 3
                    r: lm_graph_emit_expr(g, f, root, inner, 1U, m, temps, decl_names, decl_slots, decl_n, @ temp)
                    if: r != 0
                        return: r
                    c.fprintf(f, "        if: lmx_graph_assign_int(l2_g, lmx_call_code, lmx_call_code, %zuU, l2_t%d) != 0\n            %s\n", k, temp, leave_failure)
                ---
            ---
        ---
        i: i + 1U
    ---
    c.free((cast: (@: void) decl_names))
    c.free((cast: (@: void) decl_slots))
    return: 0
end: lm_graph_emit_statements_from

fn: lm_graph_emit_statements (@: g c.LmxGraph; @: f c.FILE; @: root c.Lmx; @: temps int) int
    return: lm_graph_emit_statements_from(g, f, root, 0U, temps)
end: lm_graph_emit_statements

# Native method statements compute their own arithmetic/calls. The shared kernel only owns admission, working
# cells and publication. Every return/error passes through the entry wrapper's work_finish.
fn: lm_graph_emit_block (@: g c.LmxGraph; @: f c.FILE; @: code c.Lmx; @: body c.Lmx; size_t: from; size_t: to; int: mode; int: exit_label; int: again_label; int: step_label; @: temps int) int
    c.LmxGraphEmitScratch: leave_storage
    @: leave_failure char (cast: (@: char) leave_storage\failure)
    lm_graph_emit_leave_text(leave_failure, temps[1], 1)
    @: state c.LmxGraphState (cast: (@: c.LmxGraphState) c.lmx_graph_state())
    @: statement c.Lmx 0
    @: head char 0
    @: target void 0
    size_t: i from
    size_t: n 0U
    @: leave_return char (cast: (@: char) leave_storage\returned)
    lm_graph_emit_leave_text(leave_return, temps[2], 0)
    int: result 0
    int: status 0
    int: test_label 0
    int: body_label 0
    int: next_label 0
    int: end_label 0
    int: target_label -1
    @: nested c.Lmx 0
    @: header c.Lmx 0
    @: raw void 0
    size_t: name_slot 0U
    while: i < to && status = 0
        if: c.lmx_graph_name_of(g, c.lmx_graph_get(body, i)) != 0 || c.lmx_graph_kind(g, c.lmx_graph_get(body, i)) = 3
            i: i + 1U
            continue
        if: c.lmx_graph_kind(g, c.lmx_graph_get(body, i)) != 4
            head: c.lmx_graph_word_text(g, c.lmx_graph_get(body, i))
            target_label: -1
            if: head = state\w_break
                target_label: exit_label
            if: head = state\w_continue
                target_label: step_label
            if: head = state\w_redo
                target_label: again_label
            if: head = state\w_return
                if: c.lmx_graph_has_result(g, code) != 0
                    return: 5
                c.fprintf(f, "        %s\n", leave_return)
                return: 0
            if: head = state\w_break || head = state\w_continue || head = state\w_redo
                if: target_label < 0
                    return: 5
                c.fprintf(f, "        goto: l2_label%d\n", target_label)
            else:
                if: mode = 0
                    status: lm_graph_emit_number(g, f, code, body, i, temps, 0, 0, 0U, @ result)
                ---
            ---
        else:
            statement: (cast: (@: c.Lmx) c.lmx_graph_get(body, i))
            if: c.lmx_graph_method(g, statement) != 0
                i: i + 1U
                continue
            n: c.lmx_graph_count(statement)
            head: c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 0U))
            if: head = state\w_assign
                status: lm_graph_emit_assignment(g, f, code, statement, mode, temps, 0, 0, 0U)
                i: i + 1U
                continue
            if: head = state\w_finally
                return: lm_graph_emit_finally(g, f, code, body, i, to, statement, mode, exit_label, again_label, step_label, temps)
            if: head = state\w_if
                if: n != 3U || c.lmx_graph_kind(g, c.lmx_graph_get(statement, 2U)) != 4
                    return: 2
                end_label: temps[0]
                next_label: end_label + 1
                temps[0]: temps[0] + 2
                status: lm_graph_emit_number(g, f, code, statement, 1U, temps, 0, 0, 0U, @ result)
                c.fprintf(f, "        if: l2_t%d = 0\n            goto: l2_label%d\n", result, next_label)
                nested: (cast: (@: c.Lmx) c.lmx_graph_get(statement, 2U))
                if: status = 0
                    status: lm_graph_emit_block(g, f, code, nested, 0U, c.lmx_graph_count(nested), mode, exit_label, again_label, step_label, temps)
                c.fprintf(f, "        goto: l2_label%d\n        l2_label%d: ()\n", end_label, next_label)
                i: i + 1U
                if: i < to && c.lmx_graph_kind(g, c.lmx_graph_get(body, i)) = 4
                    statement: (cast: (@: c.Lmx) c.lmx_graph_get(body, i))
                    if: c.lmx_graph_word_text(g, c.lmx_graph_get(statement, 0U)) = state\w_else
                        if: status = 0
                            status: lm_graph_emit_block(g, f, code, statement, 1U, c.lmx_graph_count(statement), mode, exit_label, again_label, step_label, temps)
                        i: i + 1U
                    ---
                ---
                c.fprintf(f, "        l2_label%d: ()\n", end_label)
                continue
            if: head = state\w_else
                return: 2
            if: head = state\w_while || head = state\w_for || head = state\w_until
                if: n != 3U || c.lmx_graph_kind(g, c.lmx_graph_get(statement, 2U)) != 4
                    return: 2
                nested: (cast: (@: c.Lmx) c.lmx_graph_get(statement, 2U))
                header: (cast: (@: c.Lmx) c.lmx_graph_get(statement, 1U))
                test_label: temps[0]
                body_label: test_label + 1
                next_label: test_label + 2
                end_label: test_label + 3
                temps[0]: temps[0] + 4
                if: head = state\w_for
                    if: c.lmx_graph_kind(g, (cast: (@: void) header)) != 4 || c.lmx_graph_count(header) != 3U
                        return: 2
                    status: lm_graph_emit_block(g, f, code, header, 0U, 1U, mode, exit_label, again_label, step_label, temps)
                if: head = state\w_until
                    c.fprintf(f, "        goto: l2_label%d\n", body_label)
                c.fprintf(f, "        l2_label%d: ()\n", test_label)
                if: status = 0
                    if: head = state\w_for
                        status: lm_graph_emit_number(g, f, code, header, 1U, temps, 0, 0, 0U, @ result)
                    else:
                        status: lm_graph_emit_number(g, f, code, statement, 1U, temps, 0, 0, 0U, @ result)
                    ---
                ---
                if: head = state\w_until
                    c.fprintf(f, "        if: l2_t%d != 0\n            goto: l2_label%d\n        l2_label%d: ()\n", result, end_label, body_label)
                else:
                    c.fprintf(f, "        if: l2_t%d = 0\n            goto: l2_label%d\n        l2_label%d: ()\n", result, end_label, body_label)
                ---
                if: status = 0
                    status: lm_graph_emit_block(g, f, code, nested, 0U, c.lmx_graph_count(nested), mode, end_label, body_label, next_label, temps)
                c.fprintf(f, "        l2_label%d: ()\n", next_label)
                if: status = 0 && head = state\w_for
                    status: lm_graph_emit_block(g, f, code, header, 2U, 3U, mode, exit_label, again_label, step_label, temps)
                c.fprintf(f, "        goto: l2_label%d\n        l2_label%d: ()\n", test_label, end_label)
                i: i + 1U
                continue
            if: head = state\w_break || head = state\w_continue || head = state\w_redo
                if: n != 1U
                    return: 5
                target_label: exit_label
                if: head = state\w_continue
                    target_label: step_label
                if: head = state\w_redo
                    target_label: again_label
                if: target_label < 0
                    return: 5
                c.fprintf(f, "        goto: l2_label%d\n", target_label)
                i: i + 1U
                continue
            if: head = 0
                status: lm_graph_emit_block(g, f, code, statement, 0U, n, mode, exit_label, again_label, step_label, temps)
                i: i + 1U
                continue
            if: head = state\w_return
                if: n = 1U
                    if: c.lmx_graph_has_result(g, code) != 0
                        c.fprintf(f, "        %s\n", leave_failure)
                    else:
                        c.fprintf(f, "        %s\n", leave_return)
                    ---
                    return: 0
                if: c.lmx_graph_has_result(g, code) = 0
                    return: 5
                status: lm_graph_emit_expr(g, f, code, statement, 1U, n, temps, 0, 0, 0U, @ result)
                c.fprintf(f, "        l2_result[0]: l2_t%d\n        %s\n", result, leave_return)
                return: status
            if: head = state\w_call
                status: lm_graph_emit_explicit_call(g, f, code, statement, temps, 0, 0, 0U)
                i: i + 1U
                continue
            if: head = state\w_at
                return: 5
            if: mode != 0
                target: c.lmx_graph_resolve(g, code, head)
                if: c.lmx_graph_method(g, (cast: (@: c.Lmx) target)) != 0
                    status: lm_graph_emit_call(g, f, code, statement, temps, 0, 0, 0U, @ result)
                    i: i + 1U
                    continue
                name_slot: 0U
                if: head = state\w_int
                    name_slot: 1U
                    c.fputs("        if: lmx_graph_named(l2_g, lmx_call_code, ", f)
                    status: lm_graph_emit_word(g, f, code, statement, name_slot)
                    c.fprintf(f, ") = lmx_graph_count(lmx_call_code)\n            %s\n", leave_failure)
                if: n > name_slot + 1U
                    status: lm_graph_emit_expr(g, f, code, statement, name_slot + 1U, n, temps, 0, 0, 0U, @ result)
                    c.fputs("        if: lmx_graph_assign_int(l2_g, lmx_call_code, lmx_call_code, lmx_graph_named(l2_g, lmx_call_code, ", f)
                    if: status = 0
                        status: lm_graph_emit_word(g, f, code, statement, name_slot)
                    c.fprintf(f, "), l2_t%d) != 0\n            %s\n", result, leave_failure)
                ---
                i: i + 1U
                continue
            if: head = state\w_int
                c.fputs("        if: lmx_graph_local_int(l2_g, lmx_call_code, ", f)
                status: lm_graph_emit_word(g, f, code, statement, 1U)
                c.fprintf(f, ") != 0\n            %s\n", leave_failure)
                if: status = 0 && n > 2U
                    status: lm_graph_emit_expr(g, f, code, statement, 2U, n, temps, 0, 0, 0U, @ result)
                    c.fputs("        if: lmx_graph_store_name(l2_g, lmx_call_code, ", f)
                    if: status = 0
                        status: lm_graph_emit_word(g, f, code, statement, 1U)
                    c.fprintf(f, ", l2_t%d) != 0\n            %s\n", result, leave_failure)
                ---
                i: i + 1U
                continue
            target: c.lmx_graph_resolve(g, code, head)
            if: c.lmx_graph_method(g, (cast: (@: c.Lmx) target)) != 0
                status: lm_graph_emit_call(g, f, code, statement, temps, 0, 0, 0U, @ result)
            else:
                status: lm_graph_emit_expr(g, f, code, statement, 1U, n, temps, 0, 0, 0U, @ result)
                c.fputs("        if: lmx_graph_store_name(l2_g, lmx_call_code, ", f)
                if: status = 0
                    status: lm_graph_emit_word(g, f, code, statement, 0U)
                c.fprintf(f, ", l2_t%d) != 0\n            %s\n", result, leave_failure)
            ---
        ---
        i: i + 1U
    ---
    return: status
end: lm_graph_emit_block

fn: lm_graph_emit_method_body (@: g c.LmxGraph; @: f c.FILE; @: code c.Lmx; @: temps int) int
    @: body c.Lmx code
    int: status 0
    if: c.lmx_graph_method(g, code) != 0
        body: (cast: (@: c.Lmx) c.lmx_graph_method_body(code))
    status: lm_graph_emit_block(g, f, code, body, 0U, c.lmx_graph_count(body), 0, -1, -1, -1, temps)
    if: status = 0
        c.fprintf(f, "        return: %d\n", c.lmx_graph_has_result(g, code))
    return: status
end: lm_graph_emit_method_body

# The consumer collects method addresses once from the completed graph. This list belongs only to this translation,
# not to construction and not to a future execution. Emit and install reuse it without walking all children twice.
fn: lm_graph_collect_methods (@: g c.LmxGraph; @: root c.Lmx; @@@: methods c.Lmx; @: methods_count size_t) int
    @@: queue c.Lmx 0
    size_t: count 0U
    size_t: capacity 0U
    size_t: method_capacity 0U
    size_t: at 0U
    size_t: i 0U
    @: current c.Lmx 0
    @: value void 0
    int: status c.lmx_graph_scan_add(@ queue, @ count, @ capacity, root)
    while: at < count && status = 0
        current: queue[at]
        at: at + 1U
        if: c.lmx_graph_method(g, current) != 0
            status: c.lmx_graph_scan_add(methods, methods_count, @ method_capacity, current)
        else:
            if: current != root && c.lmx_graph_name_of(g, (cast: (@: void) current)) != 0 && c.lmx_graph_method(g, (cast: (@: c.Lmx) current\parent)) = 0
                i: 0U
                while: i < c.lmx_graph_count(current)
                    value: c.lmx_graph_get(current, i)
                    if: c.lmx_graph_kind(g, value) = 4 && c.lmx_graph_name_of(g, value) = 0
                        if: c.lmx_graph_word_text(g, c.lmx_graph_get((cast: (@: c.Lmx) value), 0U)) != 0
                            status: c.lmx_graph_scan_add(methods, methods_count, @ method_capacity, current)
                            break
                        ---
                    ---
                    i: i + 1U
                ---
            ---
        ---
        i: 0U
        while: i < c.lmx_graph_count(current) && status = 0
            value: c.lmx_graph_get(current, i)
            if: c.lmx_graph_kind(g, value) = 4
                status: c.lmx_graph_scan_add(@ queue, @ count, @ capacity, (cast: (@: c.Lmx) value))
            i: i + 1U
        ---
    ---
    c.free((cast: (@: void) queue))
    return: status
end: lm_graph_collect_methods

fn: lm_graph_emit_methods (@: g c.LmxGraph; @: f c.FILE; @: scope c.Lmx; @@: methods c.Lmx; size_t: count; int: install) int
    @: vars c.Lmx 0
    @: current c.Lmx 0
    size_t: i 0U
    int: label 0
    c.LmxGraphEmitScratch: temp_storage
    @: temps int (cast: (@: int) temp_storage\control)
    temps[0]: 0
    temps[1]: -1
    temps[2]: -1
    int: status 0
    while: i < count && status = 0
        current: methods[i]
        label: (cast: (int) i)
        vars: 0
        if: c.lmx_graph_method(g, current) != 0
            vars: (cast: (@: c.Lmx) c.lmx_graph_method_var(current))
        if: install != 0
            c.fputs("        l2_method: ", f)
            status: lm_graph_emit_address(g, f, scope, current)
            c.fprintf(f, "\n        l2_method\\native: (cast: (LmxEntry) lm_graph_method%d)\n", label)
            if: vars != 0
                c.fputs("        l2_method: ", f)
                if: status = 0
                    status: lm_graph_emit_address(g, f, scope, vars)
                c.fprintf(f, "\n        l2_method\\native: (cast: (LmxEntry) lm_graph_var%d)\n", label)
            ---
        else:
            c.fprintf(f, "external:\n    fn: lm_graph_var%d (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue input; @: LmxWalkValue result) int\n        @: LmxGraph l2_g lmx_graph_find(lmx_call_arena)\n        @: void l2_c 0\n        if: l2_g = 0\n            return: 1\n", label)
            status: lm_graph_emit_statements(g, f, vars, temps)
            c.fprintf(f, "        return: 0\n    end: lm_graph_var%d\nend: external\n\nexternal:\n", label)
            temps[0]: 0
            temps[1]: -1
            temps[2]: -1
            c.fprintf(f, "    fn: lm_graph_body%d (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue input; @: LmxWalkValue result) int\n        @: LmxGraph l2_g lmx_graph_find(lmx_call_arena)\n        @: int l2_result (cast: (@: int) dest)\n        if: l2_g = 0 || l2_result = 0\n            return: 1\n", label)
            if: status = 0
                status: lm_graph_emit_method_body(g, f, current, temps)
            c.fprintf(f, "    end: lm_graph_body%d\nend: external\n\nexternal:\n", label)
            c.fprintf(f, "    fn: lm_graph_method%d (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue input; @: LmxWalkValue result) int\n        @: LmxGraph l2_g lmx_graph_find(lmx_call_arena)\n        LmxGraphFrame: l2_frame\n        int: l2_status 0\n        if: l2_g = 0\n            return: 1\n        l2_status: lmx_graph_work_open_data(l2_g, lmx_call_code, (cast: (@: Lmx) owner), @ l2_frame)\n        if: l2_status != 0\n            return: 1\n        l2_status: lm_graph_body%d(owner, refs, nargs, dest, out, lmx_call_arena, lmx_call_code, input, result)\n        return: lmx_graph_work_finish(l2_g, @ l2_frame, l2_status)\n    end: lm_graph_method%d\nend: external\n\n", label, label, label)
        ---
        i: i + 1U
    ---
    return: status
end: lm_graph_emit_methods

# The L1 of the program of root at out_path (§7): the kernel headers, the program hooks the driver expects, the body of
# the root -- native (its statements over the cells of the graph) or forced (the kernel's interpreter over the same
# graph) -- which prints the graph before and after between GRAPH markers, the generated initialization of the clean
# graph in R0's arena and root (l2_program_build), and main as the host's launch. 0, or the failing answer.
fn: lm_graph_emit_program (@: g c.LmxGraph; @: root c.Lmx; const: (@: out_path char); int: forced; int: check_root; int: runs) int
    @: f c.FILE 0
    @: value void 0
    size_t: n (cast: (size_t) c.lmx_graph_count(root))
    size_t: i 0U
    c.LmxCopyMap: emitted
    size_t: next 2U
    c.LmxGraphEmitScratch: temp_storage
    @: temps int (cast: (@: int) temp_storage\control)
    temps[0]: 0
    temps[1]: -1
    temps[2]: -1
    int: r 0
    @@: methods c.Lmx 0
    size_t: methods_count 0U
    size_t: host_fields n
    if: check_root != 0
        host_fields: 1U
    if: g = 0 || root = 0 || out_path = 0 || runs < 1
        return: 5
    f: c.fopen(out_path, "wb")
    if: f = 0
        return: 5
    c.fputs("# Generated by the graph tool of slice 309 (src/l2src/l2_graph_tool.lm2): the program of a clean graph.\n", f)
    c.fputs("predef: \"l2src/lmx_arena_refs.h.lm1\" \"l2src/lmx_value_owned.h.lm1\" \"l2src/lmx.h.lm1\" \"l2src/lmx_message.h.lm1\" \"l2src/lmx_root.h.lm1\" \"l2src/lmx_call.h.lm1\" \"l2src/lmx_clock.h.lm1\" \"l2src/lmx_ids.h.lm1\" \"l2src/lmx_arena.h.lm1\" \"l2src/lmx_graph.h.lm1\" \"l2src/lmx_graph_run.h.lm1\"\n", f)
    if: check_root != 0
        c.fputs("predef: \"l2src/lmx_thread.h.lm1\"\n", f)
    c.fputs("include: \"<stdio.h>\" \"<stdlib.h>\"\n\n@: LmxArena l2_program_arena 0\n@: Lmx l2_program_unit 0\n@: Lmx l2_program_root_graph 0\n\nfn: l2_program_graph () @: Lmx\nreturn: l2_program_root_graph\n\nfn: l2_program_qualified_count () size_t\nreturn: 0U\n\nfn: l2_program_qualified_at (size_t: index) @: Lmx\nreturn: 0\n\n", f)
    # Declare each native temporary where its first value is emitted. The emitter needs no temporary file or second
    # copy of the body; its traversal-local counter only supplies distinct L1 names.
    if: forced = 0
        r: lm_graph_collect_methods(g, root, @ methods, @ methods_count)
        if: r = 0
            r: lm_graph_emit_methods(g, f, root, methods, methods_count, 0)
        if: r != 0
            c.fclose(f)
            c.free((cast: (@: void) methods))
            return: r
        ---
    ---
    c.fputs("external:\n    fn: lm_graph_body (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n        @: LmxGraph l2_g 0\n        @: void l2_c 0\n        l2_g: lmx_graph_find(lmx_call_arena)\n", f)
    c.fputs("        if: l2_g = 0 || lmx_call_code = 0\n            return: 1\n", f)
    if: check_root = 0
        c.fputs("        if: lmx_graph_dump_marked(l2_g, lmx_call_code, c.stdout, \"BEFORE\") != 0\n            return: 1\n", f)
    if: forced = 0
        r: lm_graph_emit_statements(g, f, root, temps)
        if: r != 0
            c.fclose(f)
            c.free((cast: (@: void) methods))
            return: r
        ---
    else:
        c.fputs("        if: lmx_graph_run(l2_g, lmx_call_code) != 0\n            return: 1\n", f)
    ---
    if: check_root = 0
        c.fputs("        if: lmx_graph_dump_marked(l2_g, lmx_call_code, c.stdout, \"AFTER\") != 0\n            return: 1\n", f)
    c.fputs("        return: 0\n    end: lm_graph_body\nend: external\n\n", f)
    # Only emit-check supplies a test host. The body keeps the language rule: returning 0 is NOT Message success.
    # Like the `run` command's host, this separate adapter completes its own test after a successful body. Ordinary
    # `emit` gets no adapter and still fails R0 when the source supplies neither success nor an exit Message.
    if: check_root != 0
        c.fprintf(f, "external:\n    fn: lm_graph_check_root (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena arena; @: Lmx code; @: LmxWalkValue input; @: LmxWalkValue result) int\n        @: LmxGraph g lmx_graph_find(arena)\n        @: Lmx unit (cast: (@: Lmx) lmx_graph_get(code, 0U))\n        int: status 0\n        int: count 0\n        if: g = 0 || unit = 0 || lmx_graph_dump_marked(g, unit, c.stdout, \"BEFORE\") != 0\n            return: 1\n        while: count < %d && status = 0\n            status: lmx_graph_call(g, unit)\n            count: count + 1\n        ---\n        if: lmx_graph_dump_marked(g, unit, c.stdout, \"AFTER\") != 0\n            return: 1\n        if: status != 0\n            return: status\n        @: LmxThread thread lmx_thread_current()\n        @: LmxMsg message lmx_thread_message(thread)\n        if: message = 0\n            return: 1\n        message\\success: (cast: (LmxFlag) 1)\n        return: 0\n    end: lm_graph_check_root\nend: external\n\n", runs)
    # Ordinary emission builds the program in R0. A private emit-check host owns a separate program root, so clearing
    # the program's native entry cannot erase the adapter or change the program's lexical parent.
    c.fputs("external:\n    fn: l2_program_build (@: LmxArena arena; @: Lmx graph; @: Lmx settings) int\n        @: LmxGraph l2_g 0\n        @: void l2_c 0\n        @: Lmx lmx_call_code 0\n        @: Lmx l2_method 0\n", f)
    c.fputs("        l2_g: lmx_graph_open(arena)\n        if: l2_g = 0 || graph = 0\n            return: 1\n        l2_program_arena: arena\n        l2_program_root_graph: graph\n        l2_program_unit: graph\n", f)
    if: check_root != 0
        c.fprintf(f, "        l2_program_unit: lmx_graph_lmx(l2_g, 0, %zuU)\n        if: l2_program_unit = 0 || lmx_graph_put(graph, 0U, (cast: (@: void) l2_program_unit)) != 0\n            return: 1\n", n)
    c.fputs("        @: void l2_gv1 (cast: (@: void) l2_program_unit)\n", f)
    r: c.lmx_copy_map_init(@ emitted)
    if: r = 0
        r: c.lmx_copy_map_put(@ emitted, (cast: (@: void) root), (cast: (@: void) 1U))
    while: i < n && r = 0
        value: c.lmx_graph_get(root, i)
        r: lm_graph_emit_value(g, f, value, "l2_program_unit", i, @ emitted, @ next)
        i: i + 1U
    ---
    if: r = 0
        r: lm_graph_emit_parents(g, f, @ emitted)
    c.lmx_copy_map_dispose(@ emitted)
    if: r != 0
        c.fclose(f)
        c.free((cast: (@: void) methods))
        return: 5
    ---
    if: forced = 0
        c.fputs("        lmx_call_code: l2_program_unit\n", f)
        r: lm_graph_emit_methods(g, f, root, methods, methods_count, 1)
        if: r != 0
            c.fclose(f)
            c.free((cast: (@: void) methods))
            return: r
        ---
    ---
    c.fputs("        l2_program_unit\\native: (cast: (LmxEntry) lm_graph_body)\n", f)
    if: check_root != 0
        c.fputs("        graph\\native: (cast: (LmxEntry) lm_graph_check_root)\n", f)
    c.fputs("        return: 0\n    end: l2_program_build\nend: external\n\n", f)
    c.fprintf(f, "external:\n    fn: main (int: argc; @@: char argv) int\n        LmxRoot: l2_program_root\n        return: lmx_root_launch(@ l2_program_root, argc, argv, l2_program_build, %zuU, lmx_root_settings, 5000U, (cast: (@: void) c.stdout), (cast: (@: void) c.stderr))\n    end: main\nend: external\n", host_fields)
    c.free((cast: (@: void) methods))
    if: c.fclose(f) != 0
        return: 5
    return: 0
end: lm_graph_emit_program

# ---- The command line of tools/graph_trans.lm2 ---------------------------------------------------------------------

# `run FILE`: the clean graph of FILE in a fresh arena, printed before and after the kernel's interpreter ran it
# (GRAPH-BEFORE / GRAPH-AFTER markers). 0, or the interpreter's answer (printed).
fn: lm_graph_run_file (const: (@: path char); int: runs) int
    @: arena c.LmxArena (cast: (@: c.LmxArena) c.calloc(1U, c.sizeof(c.LmxArena)))
    @: g c.LmxGraph 0
    @: root c.Lmx 0
    int: r 0
    int: count 0
    if: arena = 0
        return: 1
    if: c.lmx_arena_open(arena) != 0
        c.fputs("graph: cannot open an arena\n", c.stderr)
        return: 1
    g: c.lmx_graph_open(arena)
    if: g = 0
        return: 1
    r: lm_graph_build_file(g, path, @ root)
    if: r != 0
        c.fprintf(c.stderr, "graph: build answered %d\n", r)
        return: r
    if: c.lmx_graph_dump_marked(g, root, c.stdout, "BEFORE") != 0
        c.fputs("graph: the graph does not print\n", c.stderr)
        return: 1
    while: count < runs && r = 0
        r: c.lmx_graph_call(g, root)
        count: count + 1
    ---
    if: r != 0
        c.fprintf(c.stderr, "graph: run answered %d\n", r)
    if: c.lmx_graph_dump_marked(g, root, c.stdout, "AFTER") != 0
        c.fputs("graph: the graph does not print\n", c.stderr)
        return: 1
    c.lmx_graph_close(g)
    c.lmx_arena_release(arena)
    c.free((cast: (@: void) arena))
    return: r
end: lm_graph_run_file

# `emit FILE OUT.lm1 native|forced`: the clean graph of FILE emitted as the L1 of a program (lm_graph_emit_program).
fn: lm_graph_emit_file (const: (@: path char); const: (@: out_path char); int: forced; int: check_root; int: runs) int
    @: arena c.LmxArena (cast: (@: c.LmxArena) c.calloc(1U, c.sizeof(c.LmxArena)))
    @: g c.LmxGraph 0
    @: root c.Lmx 0
    int: r 0
    if: arena = 0
        return: 1
    if: c.lmx_arena_open(arena) != 0
        c.fputs("graph: cannot open an arena\n", c.stderr)
        return: 1
    g: c.lmx_graph_open(arena)
    if: g = 0
        return: 1
    r: lm_graph_build_file(g, path, @ root)
    if: r != 0
        c.fprintf(c.stderr, "graph: build answered %d\n", r)
        return: r
    r: lm_graph_emit_program(g, root, out_path, forced, check_root, runs)
    if: r != 0
        c.fprintf(c.stderr, "graph: emit answered %d\n", r)
    c.lmx_graph_close(g)
    c.lmx_arena_release(arena)
    c.free((cast: (@: void) arena))
    return: r
end: lm_graph_emit_file

# `p0 FILE`: the P0 tree of FILE as the parser dumps it (the builder's input, for the record of a slice).
fn: lm_graph_p0_file (const: (@: path char)) int
    @: doc c.LmP0Document 0
    @: dump char 0
    if: c.lm_p0_parse_file(path, @ doc) != 0
        c.fprintf(c.stderr, "graph: %s: cannot read or parse\n", path)
        if: doc != 0
            c.lm_p0_document_destroy(doc)
        return: 2
    dump: c.lm_p0_dump_alloc(doc)
    if: dump != 0
        c.fputs(dump, c.stdout)
        c.lm_p0_free((cast: (@: void) dump))
    ---
    c.lm_p0_document_destroy(doc)
    return: 0
end: lm_graph_p0_file

# One line of the intern witness: INTERN-CHECK <what> PASS|FAIL. 0 for a pass, 1 for a failure.
fn: lm_graph_intern_report (const: (@: what char); int: ok) int
    if: ok != 0
        c.fprintf(c.stdout, "INTERN-CHECK %s PASS\n", what)
        return: 0
    c.fprintf(c.stdout, "INTERN-CHECK %s FAIL\n", what)
    return: 1
end: lm_graph_intern_report

# The spelling "s<i>" (i below 1000000), NUL-terminated, into buf of at least 12 bytes: the distinct spellings of the
# growth part of the intern witness.
sub: lm_graph_intern_spelling (@: buf char; int: i)
    int: k 1
    int: d 100000
    int: started 0
    int: digit 0
    buf[0]: (cast: (char) 115)
    while: d > 0
        digit: (i / d) % 10
        if: digit != 0 || started != 0 || d = 1
            buf[k]: (cast: (char) (48 + digit))
            k: k + 1
            started: 1
        ---
        d: d / 10
    ---
    buf[k]: (cast: (char) 0)
    return
end: lm_graph_intern_spelling

# `intern`: the witness of section 4 of the specification for this slice. One spelling is one address of the `text`
# region of the arena that owns the string state: the word x written in two live arenas is two word cells of two arenas
# holding one spelling address; that address is classified in the owner's region and in neither graph's arena; it does
# not move while the index grows through its first capacities (300 further spellings); a heap string is no spelling.
# 0 when every line passes, else 1.
fn: lm_graph_intern_check () int
    @: a1 c.LmxArena (cast: (@: c.LmxArena) c.calloc(1U, c.sizeof(c.LmxArena)))
    @: a2 c.LmxArena (cast: (@: c.LmxArena) c.calloc(1U, c.sizeof(c.LmxArena)))
    @: buf char (cast: (@: char) c.calloc(16U, 1U))
    @: g1 c.LmxGraph 0
    @: g2 c.LmxGraph 0
    @: w1 void 0
    @: w2 void 0
    @: t1 char 0
    @: t2 char 0
    @: first char 0
    @: again char 0
    int: i 0
    int: grown 1
    int: fails 0
    if: a1 = 0 || a2 = 0 || buf = 0
        return: 1
    if: c.lmx_arena_open(a1) != 0 || c.lmx_arena_open(a2) != 0
        c.fputs("graph: cannot open an arena\n", c.stderr)
        return: 1
    g1: c.lmx_graph_open(a1)
    g2: c.lmx_graph_open(a2)
    if: g1 = 0 || g2 = 0
        return: 1
    w1: c.lmx_graph_word(g1, "x", 1U)
    w2: c.lmx_graph_word(g2, "x", 1U)
    t1: c.lmx_graph_word_text(g1, w1)
    t2: c.lmx_graph_word_text(g2, w2)
    fails: fails + lm_graph_intern_report("two-word-cells", (cast: (int) (w1 != 0 && w2 != 0 && w1 != w2 && c.lmx_graph_kind(g1, w1) = 2 && c.lmx_graph_kind(g2, w2) = 2)))
    fails: fails + lm_graph_intern_report("one-spelling-address-from-two-arenas", (cast: (int) (t1 != 0 && t1 = t2 && c.strcmp(t1, "x") = 0)))
    fails: fails + lm_graph_intern_report("spelling-in-the-owner-text-region", c.lmx_graph_intern_owned(t1))
    fails: fails + lm_graph_intern_report("spelling-in-neither-graph-arena", (cast: (int) (c.lmx_graph_kind(g1, (cast: (@: void) t1)) = 0 && c.lmx_graph_kind(g2, (cast: (@: void) t1)) = 0)))
    fails: fails + lm_graph_intern_report("heap-string-is-no-spelling", (cast: (int) (c.lmx_graph_intern_owned(buf) = 0)))
    first: c.lmx_graph_intern("s0", 2U)
    while: i < 300
        lm_graph_intern_spelling(buf, i)
        if: c.lmx_graph_intern(buf, c.strlen(buf)) = 0
            grown: 0
        i: i + 1
    ---
    again: c.lmx_graph_intern("x", 1U)
    fails: fails + lm_graph_intern_report("index-grown-by-300-spellings", grown)
    fails: fails + lm_graph_intern_report("address-stable-after-growth", (cast: (int) (again = t1 && first != 0 && c.lmx_graph_intern("s0", 2U) = first && c.lmx_graph_intern("s299", 4U) != 0 && c.lmx_graph_intern_owned(c.lmx_graph_intern("s299", 4U)) != 0)))
    c.lmx_graph_close(g1)
    c.lmx_graph_close(g2)
    c.lmx_arena_release(a1)
    c.lmx_arena_release(a2)
    c.free((cast: (@: void) a1))
    c.free((cast: (@: void) a2))
    c.free((cast: (@: void) buf))
    if: fails != 0
        return: 1
    return: 0
end: lm_graph_intern_check

# A real native entry whose distinct answer proves that dispatch used the entry, not the walker.
fn: lm_graph_native_probe (@: owner void; @@: refs void; size_t: nargs; @: dest void; @@: out void; @: arena c.LmxArena; @: code c.Lmx; @: input c.LmxWalkValue; @: result c.LmxWalkValue) int
    return: 77
end: lm_graph_native_probe

fn: lm_graph_mutation_report (const: (@: what char); int: ok) int
    if: ok != 0
        c.printf("MUTATION-CHECK %s PASS\n", what)
        return: 0
    c.printf("MUTATION-CHECK %s FAIL\n", what)
    return: 1
end: lm_graph_mutation_report

# Shared code, a data alias to its literal, and a cycle are ordinary Lmx slots. There is no retained reverse index.
fn: lm_graph_mutation_check () int
    @: arena c.LmxArena (cast: (@: c.LmxArena) c.calloc(1U, c.sizeof(c.LmxArena)))
    @: g c.LmxGraph 0
    @: scope c.Lmx 0
    @: a c.Lmx 0
    @: b c.Lmx 0
    @: data c.Lmx 0
    @: fresh c.Lmx 0
    @: statement c.Lmx 0
    @: expression c.Lmx 0
    @: x void 0
    @: literal void 0
    @: uninit void 0
    @: same_cell void 0
    @: plus void 0
    @: minus void 0
    int: value 0
    int: status 0
    int: fails 0
    if: arena = 0 || c.lmx_arena_open(arena) != 0
        return: 1
    g: c.lmx_graph_open(arena)
    scope: c.lmx_graph_lmx(g, 0, 5U)
    a: c.lmx_graph_lmx(g, scope, 2U)
    b: c.lmx_graph_lmx(g, scope, 2U)
    data: c.lmx_graph_lmx(g, scope, 1U)
    fresh: c.lmx_graph_lmx(g, scope, 1U)
    statement: c.lmx_graph_lmx(g, a, 2U)
    expression: c.lmx_graph_lmx(g, statement, 3U)
    x: c.lmx_graph_int(g, 5)
    literal: c.lmx_graph_int(g, 1)
    uninit: c.lmx_graph_uninit_int(g)
    plus: c.lmx_graph_word(g, "+", 1U)
    minus: c.lmx_graph_word(g, "-", 1U)
    if: scope = 0 || a = 0 || b = 0 || data = 0 || fresh = 0 || statement = 0 || expression = 0 || x = 0 || literal = 0 || uninit = 0 || plus = 0 || minus = 0
        return: 1
    if: c.lmx_graph_name(g, x, "x", 1U) != 0
        return: 1
    if: c.lmx_graph_put(scope, 0U, (cast: (@: void) a)) != 0 || c.lmx_graph_put(scope, 1U, (cast: (@: void) b)) != 0 || c.lmx_graph_put(scope, 2U, (cast: (@: void) data)) != 0 || c.lmx_graph_put(scope, 3U, (cast: (@: void) fresh)) != 0 || c.lmx_graph_put(scope, 4U, (cast: (@: void) scope)) != 0
        return: 1
    if: c.lmx_graph_put(a, 0U, x) != 0 || c.lmx_graph_put(a, 1U, (cast: (@: void) statement)) != 0 || c.lmx_graph_put(b, 0U, x) != 0 || c.lmx_graph_put(b, 1U, (cast: (@: void) statement)) != 0 || c.lmx_graph_put(data, 0U, literal) != 0 || c.lmx_graph_put(fresh, 0U, uninit) != 0
        return: 1
    if: c.lmx_graph_put(statement, 0U, c.lmx_graph_word(g, "x", 1U)) != 0 || c.lmx_graph_put(statement, 1U, (cast: (@: void) expression)) != 0 || c.lmx_graph_put(expression, 0U, c.lmx_graph_word(g, "x", 1U)) != 0 || c.lmx_graph_put(expression, 1U, plus) != 0 || c.lmx_graph_put(expression, 2U, literal) != 0
        return: 1
    a\native: (cast: (c.LmxEntry) c.lm_graph_native_probe)
    b\native: (cast: (c.LmxEntry) c.lm_graph_native_probe)
    fresh\native: (cast: (c.LmxEntry) c.lm_graph_native_probe)
    same_cell: c.lmx_graph_place_cell(g, fresh, 0U)
    status: c.lmx_graph_assign_int(g, scope, fresh, 0U, 5)
    fails: fails + lm_graph_mutation_report("first-write-preserves-slot-pointer-cell-and-entry", (cast: (int) (status = 0 && c.lmx_graph_get(fresh, 0U) = uninit && c.lmx_graph_kind(g, uninit) = 3 && c.lmx_arena_pointer_void_read(uninit) = same_cell && c.lmx_graph_kind(g, same_cell) = 1 && fresh\native != 0 && c.lmx_graph_read_int(g, fresh, 0U, @ value) = 0 && value = 5)))
    status: c.lmx_graph_assign_int(g, scope, fresh, 0U, 7)
    fails: fails + lm_graph_mutation_report("later-write-preserves-slot-pointer-cell-and-entry", (cast: (int) (status = 0 && c.lmx_graph_get(fresh, 0U) = uninit && c.lmx_arena_pointer_void_read(uninit) = same_cell && fresh\native != 0 && c.lmx_graph_value_int(g, same_cell, @ value) = 0 && value = 7)))
    status: c.lmx_graph_assign_int(g, scope, a, 0U, 9)
    fails: fails + lm_graph_mutation_report("ordinary-data-write-preserves-both-entries", (cast: (int) (status = 0 && a\native != 0 && b\native != 0 && c.lmx_graph_read_int(g, b, 0U, @ value) = 0 && value = 9)))
    fails: fails + lm_graph_mutation_report("preserved-entry-is-dispatched", (cast: (int) (c.lmx_graph_call(g, a) = 77)))
    status: c.lmx_graph_write_slot(g, scope, expression, 1U, (cast: (@: void) (@ value)))
    fails: fails + lm_graph_mutation_report("foreign-value-refused-before-publication", (cast: (int) (status != 0 && c.lmx_graph_get(expression, 1U) = plus && a\native != 0 && b\native != 0)))
    status: c.lmx_graph_assign_int(g, scope, data, 0U, 7)
    fails: fails + lm_graph_mutation_report("literal-written-through-data-alias-clears-both", (cast: (int) (status = 0 && a\native = 0 && b\native = 0 && fresh\native != 0)))
    status: c.lmx_graph_call(g, a)
    fails: fails + lm_graph_mutation_report("fresh-walk-reads-updated-literal", (cast: (int) (status = 0 && c.lmx_graph_read_int(g, a, 0U, @ value) = 0 && value = 16)))
    status: c.lmx_graph_call(g, b)
    fails: fails + lm_graph_mutation_report("second-shared-code-walk", (cast: (int) (status = 0 && c.lmx_graph_read_int(g, b, 0U, @ value) = 0 && value = 23)))
    a\native: (cast: (c.LmxEntry) c.lm_graph_native_probe)
    b\native: (cast: (c.LmxEntry) c.lm_graph_native_probe)
    status: c.lmx_graph_write_slot(g, scope, expression, 1U, minus)
    fails: fails + lm_graph_mutation_report("operator-write-clears-both-not-unrelated-entry", (cast: (int) (status = 0 && a\native = 0 && b\native = 0 && fresh\native != 0)))
    status: c.lmx_graph_call(g, a)
    fails: fails + lm_graph_mutation_report("fresh-walk-reads-updated-operator", (cast: (int) (status = 0 && c.lmx_graph_read_int(g, a, 0U, @ value) = 0 && value = 16)))
    fails: fails + lm_graph_mutation_report("activation-state-discarded", (cast: (int) (arena\activation = 0)))
    c.lmx_graph_close(g)
    c.lmx_arena_release(arena)
    c.free((cast: (@: void) arena))
    if: fails != 0
        return: 1
    return: 0
end: lm_graph_mutation_check

# Mutate the published Point/take witness through the same write API. The sentinel proves whether native survives;
# once code changes, invocation must execute the current body with a fresh activation and untouched formal slots.
fn: lm_graph_method_mutation (const: (@: path char)) int
    @: arena c.LmxArena (cast: (@: c.LmxArena) c.calloc(1U, c.sizeof(c.LmxArena)))
    @: g c.LmxGraph 0
    @: root c.Lmx 0
    @: point c.Lmx 0
    @: method c.Lmx 0
    @: args c.Lmx 0
    @: body c.Lmx 0
    @: statement c.Lmx 0
    @: expression c.Lmx 0
    @: product c.Lmx 0
    @: formal c.Lmx 0
    @: required void 0
    @@: values void (cast: (@@: void) c.calloc(2U, sizeof(@: void)))
    int: status 0
    int: answer 0
    int: fails 0
    if: values = 0 || arena = 0 || c.lmx_arena_open(arena) != 0
        return: 1
    g: c.lmx_graph_open(arena)
    if: g = 0 || lm_graph_build_file(g, path, @ root) != 0
        return: 1
    point: (cast: (@: c.Lmx) c.lmx_graph_get(root, 0U))
    method: (cast: (@: c.Lmx) c.lmx_graph_get(root, 1U))
    if: c.lmx_graph_method(g, method) = 0
        return: 1
    args: (cast: (@: c.Lmx) c.lmx_graph_get(method, 1U))
    body: (cast: (@: c.Lmx) c.lmx_graph_method_body(method))
    statement: (cast: (@: c.Lmx) c.lmx_graph_get(body, 0U))
    expression: (cast: (@: c.Lmx) c.lmx_graph_get(statement, 1U))
    product: (cast: (@: c.Lmx) c.lmx_graph_get(expression, 0U))
    required: c.lmx_graph_get(args, 1U)
    method\native: (cast: (c.LmxEntry) c.lm_graph_native_probe)
    status: c.lmx_graph_assign_int(g, root, point, 0U, 3)
    fails: fails + lm_graph_mutation_report("method-data-write-preserves-entry", (cast: (int) (status = 0 && method\native != 0)))
    status: c.lmx_graph_admit(g, method, 0U, (cast: (@: void) point), @ values[0])
    status: status + c.lmx_graph_admit(g, method, 1U, c.lmx_graph_int(g, 1), @ values[1])
    if: status = 0
        status: c.lmx_graph_invoke(g, method, values, 2U, @ answer)
    fails: fails + lm_graph_mutation_report("method-preserved-native-is-dispatched", (cast: (int) (status = 77)))
    status: c.lmx_graph_assign_int(g, root, product, 2U, 20)
    fails: fails + lm_graph_mutation_report("method-body-literal-clears-entry", (cast: (int) (status = 0 && method\native = 0)))
    status: c.lmx_graph_invoke(g, method, values, 2U, @ answer)
    fails: fails + lm_graph_mutation_report("method-fresh-body-result61", (cast: (int) (status = 0 && answer = 61)))
    method\native: (cast: (c.LmxEntry) c.lm_graph_native_probe)
    status: c.lmx_graph_write_slot(g, root, expression, 1U, c.lmx_graph_word(g, "-", 1U))
    fails: fails + lm_graph_mutation_report("method-body-operator-clears-entry", (cast: (int) (status = 0 && method\native = 0)))
    status: c.lmx_graph_invoke(g, method, values, 2U, @ answer)
    fails: fails + lm_graph_mutation_report("method-next-body-result59", (cast: (int) (status = 0 && answer = 59)))
    method\native: (cast: (c.LmxEntry) c.lm_graph_native_probe)
    formal: (cast: (@: c.Lmx) c.lmx_graph_get(args, 0U))
    status: c.lmx_graph_write_slot(g, root, formal, 0U, c.lmx_graph_word(g, "Point", 5U))
    fails: fails + lm_graph_mutation_report("method-written-requirement-clears-entry", (cast: (int) (status = 0 && method\native = 0)))
    fails: fails + lm_graph_mutation_report("method-formal-and-activation-lifetime", (cast: (int) (required = c.lmx_graph_get(args, 1U) && c.lmx_graph_kind(g, required) = 3 && arena\activation = 0)))
    c.free((cast: (@: void) values))
    c.lmx_graph_close(g)
    c.lmx_arena_release(arena)
    c.free((cast: (@: void) arena))
    return: (cast: (int) (fails != 0))
end: lm_graph_method_mutation

# The tool's commands: run, emit, emit-check, p0, intern, mutation, method-mutation. args[0] is the program, args[1]
# the command. The exit: 0 done, else the answer; 2 for a usage error.
fn: lm_graph_main (@@: args char; int: n) int
    int: forced 0
    int: check_root 0
    int: runs 1
    if: n >= 3 && c.strcmp(args[1], "method-mutation") = 0
        return: lm_graph_method_mutation(args[2])
    if: n >= 2 && c.strcmp(args[1], "mutation") = 0
        return: lm_graph_mutation_check()
    if: n >= 2 && c.strcmp(args[1], "intern") = 0
        return: lm_graph_intern_check()
    if: n >= 3 && c.strcmp(args[1], "run") = 0
        if: n >= 4
            runs: c.atoi(args[3])
        if: runs < 1
            return: 2
        return: lm_graph_run_file(args[2], runs)
    if: n >= 3 && c.strcmp(args[1], "p0") = 0
        return: lm_graph_p0_file(args[2])
    if: n >= 5 && (c.strcmp(args[1], "emit") = 0 || c.strcmp(args[1], "emit-check") = 0)
        check_root: (cast: (int) (c.strcmp(args[1], "emit-check") = 0))
        if: c.strcmp(args[4], "forced") = 0
            forced: 1
        else:
            if: c.strcmp(args[4], "native") != 0
                c.fputs("graph_trans: emit takes native or forced\n", c.stderr)
                return: 2
            ---
        ---
        if: n >= 6
            runs: c.atoi(args[5])
        if: runs < 1
            return: 2
        return: lm_graph_emit_file(args[2], args[3], forced, check_root, runs)
    c.fputs("graph_trans: usage: run FILE [COUNT] | emit|emit-check FILE OUT.lm1 native|forced [COUNT] | p0 FILE | intern\n", c.stderr)
    return: 2
end: lm_graph_main
