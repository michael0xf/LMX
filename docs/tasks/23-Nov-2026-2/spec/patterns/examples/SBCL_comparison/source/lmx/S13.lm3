Reading:
    int: scale 2
    Eval:
        return: int
        read:
            return: value * scale

Bound:
    int: scale
    return: int
    read:
        return: Reading\Eval\read()

Example:
    int: value
    int: factor
    return: @
    run:
        return: (Bound\read(factor); Reading\Eval\read())
