predef: "l2src/lmx_walk.lm1"
predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/tests/walk_contract_fixture.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_scratch.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# The CALL's data operand is the callee itself, (M, M), at every call -- a re-entry too: no instance of M is made
# (the author, 2026-09-28: no auxiliary structures in the graph; what one activation keeps apart from another is its
# arguments and its working values, §7b).  The callee's exit publishes its dirty own field into M's own cell.
# Mutant: CALL without data -> INVALID.

@: LmxArena ga 0
@: Lmx groles 0
@: LmxWalkContext gctx 0
@: LmxWalkValue gv 0
# Module-lifetime layout tokens of the RECEIVING checks (their addresses only).
[]: char wt_tokens 4
# The (data, code) correspondence of check_exec_split: code x at 0 is data x at 1; both halves (ordinal, LAST).
[]: size_t ks_map 6
# check_exec_places: the layout tokens and two static place tables of a code with one name, x
# (lmx_implements_places: [m, k, rows of (token index, m slots)]).  kp_table: layout 1 holds x at slot 1, layout 3
# at slot 0.  kp_miss: layout 2 lacks x (SIZE_MAX), layout 1 holds it at slot 1.
[]: char kp_tokens 4
[]: size_t kp_table 6
[]: size_t kp_miss 6
int: broken 0
int: checks 0
int: failures 0

sub: check (int: ok; const: @(char label))
    checks: checks + 1
    if: ok = 0
        failures: failures + 1
        c.printf("FAIL %s\n", label)
    ---
end: check

fn: fr (@: Lmx parent; size_t: slot; int: op; size_t: children) @: Lmx
    @: Lmx n lmx_walk_frame(ga, groles, parent, op, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

fn: pl (@: Lmx parent; size_t: slot; size_t: children) @: Lmx
    @: Lmx n lmx_walk_plain(ga, parent, children)
    if: n = 0 || lmx_arena_ref_store(parent, slot, (cast: (@: void) n)) != 0
        broken: broken + 1
        return: 0
    ---
return: n

sub: ref (@: Lmx code; size_t: slot; @: Lmx target)
    if: code = 0 || target = 0 || lmx_arena_ref_store(code, slot, (cast: (@: void) target)) != 0
        broken: broken + 1
    ---
end: ref

sub: sz (@: Lmx code; size_t: slot; size_t: value)
    if: code = 0 || lmx_walk_store_size(ga, code, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
end: sz

fn: icell (@: Lmx holder; size_t: slot; int: value) @: void
    if: holder = 0 || lmx_walk_store_int(ga, holder, slot, value) != c.LMX_WALK_OK
        broken: broken + 1
        return: 0
    ---
return: lmx_arena_ref_value(holder, slot)

fn: lit (@: Lmx parent; size_t: slot; int: value) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_LIT, 2U)
    if: n != 0 && lmx_walk_store_int(ga, n, 1U, value) != c.LMX_WALK_OK
        broken: broken + 1
    ---
return: n

fn: own (@: Lmx parent; size_t: slot; @: Lmx holder; size_t: index) @: Lmx
    @: Lmx n fr(parent, slot, c.LMX_WALK_OP_OWN, 3U)
    ref(n, 1U, holder)
    sz(n, 2U, index)
return: n

# k.4: a walked callable occurrence is just the ordinary body Structure -- no descriptor;
# `native` stays 0 by construction. `children` now counts body steps only, so every call
# site below shrinks by one and every stored slot index moves down by one.
fn: mk_m (@: Lmx unit; size_t: slot; size_t: children) @: Lmx
    @: Lmx m pl(unit, slot, children)
    if: m = 0
        return: 0
    ---
    m\parent: unit
return: m

# A one-field Structure -- an int x -- at slot of holder, its parent holder.
fn: one_int (@: Lmx holder; size_t: slot; int: value) @: Lmx
    @: Lmx s pl(holder, slot, 1U)
    if: s = 0
        return: 0
    s\parent: holder
    icell(s, 0U, value)
return: s

# [of, [node], slot] at child `at` of parent: the Structure the running activation's node holds at slot.
fn: node_of (@: Lmx parent; size_t: at; size_t: slot) @: Lmx
    @: Lmx n fr(parent, at, c.LMX_WALK_OP_OF, 3U)
    if: n = 0
        return: 0
    fr(n, 1U, c.LMX_WALK_OP_NODE, 1U)
    sz(n, 2U, slot)
return: n

# The admission ADMIT_AS[value [of, [node], 1], model [of, [node], 0]] at child `at` of parent, its source token
# wt_tokens + 0 (a value of that layout selects the identity default map; full receiver 0), marked RECEIVING
# (lmx_walk.h) when receiving is 1.
fn: recv_admit (@: Lmx parent; size_t: at; int: receiving) @: Lmx
    @: Lmx a fr(parent, at, c.LMX_WALK_OP_ADMIT_AS, 9U)
    if: a = 0
        return: 0
    if: lmx_walk_store_charptr(ga, a, 1U, wt_tokens + 0) != c.LMX_WALK_OK
        broken: broken + 1
    node_of(a, 3U, 1U)
    node_of(a, 4U, 0U)
    sz(a, 5U, 0U)
    sz(a, 6U, 0U)
    sz(a, 8U, 0U)
    if: receiving != 0 && lmx_walk_source_mark(ga, groles, a, c.LMX_WALK_SOURCE_RECEIVING) != 0
        broken: broken + 1
return: a

# A long CALL of callee at caller's slot 0, its one input that admission.
sub: recv_call (@: Lmx caller; @: Lmx callee; int: receiving)
    @: Lmx n fr(caller, 0U, c.LMX_WALK_OP_CALL, 6U)
    if: n != 0
        ref(n, 1U, callee)
        ref(n, 2U, callee)
        ref(n, 3U, wt_contract_same(ga, 1U, c.LMX_TYPE_LMX, c.LMX_TYPE_INT))
        recv_admit(n, 5U, receiving)
    ---
end: recv_call

# A callee under node that returns 5.
fn: five (@: Lmx node; size_t: slot) @: Lmx
    @: Lmx m mk_m(node, slot, 1U)
    @: Lmx n 0
    if: m = 0
        return: 0
    n: fr(m, 0U, c.LMX_WALK_OP_RET, 2U)
    lit(n, 1U, 5)
return: m

fn: go (@: Lmx m; @@: void args; size_t: nargs; @: int out_r; @: int out_v) int
    int: st
    gv\ref: 0
    gv\number: 0
    gv\present: 0
    st: lmx_walk_run(gctx, m, args, nargs, gv)
    if: out_r != 0
        \out_r: gv\number
    ---
    if: out_v != 0
        \out_v: gv\present
    ---
return: st

# The same selected occurrence is projected by a typed count, never by a
# runtime name or a fixed-depth metadata table. Exercise more than 192 links.
sub: check_node_ancestry ()
    @: Lmx root lmx_node_new_owned(ga)
    @: Lmx holder root
    @: Lmx next 0
    @: Lmx method 0
    @: Lmx ret 0
    @: Lmx projection 0
    size_t: i 0U
    int: st
    if: root = 0 || lmx_arena_refs_open_owned(ga, root, 1U) != 0
        broken: broken + 1
        return
    while: i < 256U
        next: pl(holder, 0U, 1U)
        if: next = 0
            return
        next\parent: holder
        holder: next
        i: i + 1U
    ---
    method: mk_m(holder, 0U, 1U)
    ret: fr(method, 0U, c.LMX_WALK_OP_RET, 2U)
    projection: fr(ret, 1U, c.LMX_WALK_OP_NODE, 2U)
    sz(projection, 1U, 0U)
    st: lmx_walk_run(gctx, method, 0, 0U, gv)
    check(st = c.LMX_WALK_OK && gv\present != 0 && gv\ref = (cast: (@: void) method), "NODE count 0 selects the occurrence itself")
    sz(projection, 1U, 1U)
    st: lmx_walk_run(gctx, method, 0, 0U, gv)
    check(st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) holder), "NODE count 1 selects its parent")
    sz(projection, 1U, 257U)
    st: lmx_walk_run(gctx, method, 0, 0U, gv)
    check(st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) root), "NODE has no fixed ancestry-depth cap")
    sz(projection, 1U, 258U)
    st: lmx_walk_run(gctx, method, 0, 0U, gv)
    check(st = c.LMX_WALK_INVALID, "NODE refuses an absent ancestor")
    sz(projection, 1U, (cast: (size_t) -1))
    st: lmx_walk_run(gctx, method, 0, 0U, gv)
    check(st = c.LMX_WALK_INVALID, "NODE huge count stops at the absent ancestor")
    icell(projection, 1U, 1)
    st: lmx_walk_run(gctx, method, 0, 0U, gv)
    check(st = c.LMX_WALK_INVALID, "NODE count requires its declared size_t cell")
    if: lmx_arena_ref_store(projection, 1U, 0) != 0
        broken: broken + 1
    st: lmx_walk_run(gctx, method, 0, 0U, gv)
    check(st = c.LMX_WALK_INVALID, "NODE refuses a missing explicit count cell")
    projection: fr(ret, 1U, c.LMX_WALK_OP_NODE, 3U)
    sz(projection, 1U, 1U)
    st: lmx_walk_run(gctx, method, 0, 0U, gv)
    check(st = c.LMX_WALK_INVALID, "NODE refuses a missing explicit base operand")
    # A different selected descriptor is not this activation's occurrence.
    # Its identity/count are required by copied model projection.
    projection: fr(ret, 1U, c.LMX_WALK_OP_NODE, 3U)
    sz(projection, 1U, 0U)
    @: Lmx operand fr(projection, 2U, c.LMX_WALK_OP_LIT, 2U)
    ref(operand, 1U, holder)
    st: lmx_walk_run(gctx, method, 0, 0U, gv)
    check(st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) holder), "NODE explicit base count0 selects that descriptor, not self")
    sz(projection, 1U, 1U)
    st: lmx_walk_run(gctx, method, 0, 0U, gv)
    check(st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) holder\parent), "NODE explicit base selects its own parent")
    sz(projection, 1U, 256U)
    st: lmx_walk_run(gctx, method, 0, 0U, gv)
    check(st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) root), "NODE explicit base retains arbitrary deep ancestry")
    sz(projection, 1U, 257U)
    st: lmx_walk_run(gctx, method, 0, 0U, gv)
    check(st = c.LMX_WALK_INVALID, "NODE explicit base refuses an absent ancestor")
    icell(projection, 1U, 0)
    st: lmx_walk_run(gctx, method, 0, 0U, gv)
    check(st = c.LMX_WALK_INVALID, "NODE explicit base still requires size_t count")
    sz(projection, 1U, 0U)
    icell(operand, 1U, 7)
    st: lmx_walk_run(gctx, method, 0, 0U, gv)
    check(st = c.LMX_WALK_INVALID, "NODE explicit base refuses a primitive instead of a descriptor")
    @: void nilbase 0
    []: @(void) nilargs 1
    nilargs[0]: @ nilbase
    operand: fr(projection, 2U, c.LMX_WALK_OP_ARG, 4U)
    sz(operand, 1U, 0U)
    ref(operand, 3U, lmx_node_new_owned(ga))
    st: lmx_walk_run(gctx, method, nilargs, 1U, gv)
    check(st = c.LMX_WALK_INVALID, "NODE explicit null descriptor never falls back to self")
    projection: fr(ret, 1U, c.LMX_WALK_OP_NODE, 4U)
    sz(projection, 1U, 0U)
    st: lmx_walk_run(gctx, method, 0, 0U, gv)
    check(st = c.LMX_WALK_INVALID, "NODE refuses an unknown operand layout")
    projection: fr(ret, 1U, c.LMX_WALK_OP_NODE, 1U)
    st: lmx_walk_run(gctx, method, 0, 0U, gv)
    check(st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) holder), "NODE without a count retains one-parent meaning")
end: check_node_ancestry

# N4 (sem:400, 410, 454; lmx.h: node is M.parent): `call: code data` is EXEC [exec, data, code, contract, catch]. The
# code runs over the passed data: its own fields project through the (data, code) record and never by position, a
# held null data is the implicit `interpreter` throw, the code is selected before the data is evaluated, node is the
# code's parent, a contractless EXEC validates the code, and a receiving input reads its requirement in the code's
# space.
sub: check_exec_split ()
    @: Lmx top lmx_node_new_owned(ga)
    @: Lmx code 0
    @: Lmx data 0
    @: Lmx caller 0
    @: Lmx n 0
    @: Lmx operand 0
    @: Lmx pc 0
    @: Lmx pd 0
    @: Lmx e0 0
    @: Lmx home 0
    @: Lmx away 0
    @: Lmx dhome 0
    @: Lmx mh 0
    @: Lmx vh 0
    @: Lmx ma 0
    @: Lmx md 0
    @: Lmx d7 0
    @: Lmx callee 0
    @: void dx 0
    @: void dpad 0
    @: void cx 0
    @: void nilbase 0
    []: @(void) nilargs 1
    int: st
    int: r 0
    int: v 0
    if: top = 0 || lmx_arena_refs_open_owned(ga, top, 12U) != 0
        broken: broken + 1
        return
    ---
    # The code C: own x 5; x: 42; return: x. The data D: pad 100, x 7 -- its x at another slot.
    code: mk_m(top, 0U, 3U)
    cx: icell(code, 0U, 5)
    n: fr(code, 1U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, code, 0U)
    lit(n, 2U, 42)
    n: fr(code, 2U, c.LMX_WALK_OP_RET, 2U)
    own(n, 1U, code, 0U)
    data: pl(top, 1U, 2U)
    if: data = 0
        return
    data\parent: top
    dpad: icell(data, 0U, 100)
    dx: icell(data, 1U, 7)
    ks_map[0]: 1U
    ks_map[1]: (cast: (size_t) -1)
    ks_map[2]: (cast: (size_t) -1)
    ks_map[3]: 1U
    ks_map[4]: (cast: (size_t) -1)
    ks_map[5]: (cast: (size_t) -1)
    caller: mk_m(top, 2U, 1U)
    n: fr(caller, 0U, c.LMX_WALK_OP_EXEC, 5U)
    ref(n, 1U, data)
    ref(n, 2U, code)
    ref(n, 3U, wt_contract_same(ga, 0U, c.LMX_TYPE_INT, c.LMX_TYPE_INT))
    st: lmx_walk_run(gctx, caller, 0, 0U, gv)
    check(st = c.LMX_WALK_INVALID && lmx_int_value_known(dx) = 7 && lmx_int_value_known(cx) = 5, "EXEC data without its (data, code) record never reads the code ordinal")
    # The record of the actual pair (data, code) -- what the call's admission proves for these two Structures, the
    # Consumer/typed-Structure admission of the language -- is registered here by hand: the kernel takes a registered
    # record as that proof (Codex OPUS-CODEX-20261016-27).  A bare register_map is no source-level admission, and the
    # translator has no producer of this route: its split calls reach their data through PLACE.
    if: lmx_implements_register_map(ga, data, code, ks_map, 3U, 0) != c.LMX_IMPLEMENTS_YES
        broken: broken + 1
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && v != 0 && r = 42, "EXEC runs the code over the passed data")
    check(lmx_int_value_known(dx) = 42 && lmx_int_value_known(dpad) = 100, "the code x is published into the data x by the map, not by position")
    check(lmx_int_value_known(cx) = 5, "the code own cell is not the data")

    # A held null data is the implicit `interpreter` throw; the code is not entered.
    caller: mk_m(top, 3U, 1U)
    n: fr(caller, 0U, c.LMX_WALK_OP_EXEC, 5U)
    operand: fr(n, 1U, c.LMX_WALK_OP_ARG, 4U)
    sz(operand, 1U, 0U)
    ref(operand, 3U, lmx_node_new_owned(ga))
    ref(n, 2U, code)
    ref(n, 3U, wt_contract_same(ga, 0U, c.LMX_TYPE_INT, c.LMX_TYPE_INT))
    nilargs[0]: @ nilbase
    st: lmx_walk_run(gctx, caller, nilargs, 1U, gv)
    check(st = c.LMX_WALK_THROWN + c.LMX_WALK_NAME_INTERPRETER && lmx_int_value_known(cx) = 5, "a null data is the implicit interpreter throw")

    # The code is selected first: a code operand that is no reference is INVALID before the null data is read.
    caller: mk_m(top, 4U, 1U)
    n: fr(caller, 0U, c.LMX_WALK_OP_EXEC, 5U)
    operand: fr(n, 1U, c.LMX_WALK_OP_ARG, 4U)
    sz(operand, 1U, 0U)
    ref(operand, 3U, lmx_node_new_owned(ga))
    lit(n, 2U, 3)
    ref(n, 3U, wt_contract_same(ga, 0U, c.LMX_TYPE_INT, c.LMX_TYPE_INT))
    st: lmx_walk_run(gctx, caller, nilargs, 1U, gv)
    check(st = c.LMX_WALK_INVALID, "EXEC selects its code before it evaluates its data")

    # node is the code's parent: the code under pc returns its NODE while its data sits under pd.
    pc: pl(top, 5U, 1U)
    pd: pl(top, 6U, 1U)
    if: pc = 0 || pd = 0
        return
    pc\parent: top
    pd\parent: top
    code: mk_m(pc, 0U, 1U)
    n: fr(code, 0U, c.LMX_WALK_OP_RET, 2U)
    fr(n, 1U, c.LMX_WALK_OP_NODE, 1U)
    data: pl(pd, 0U, 1U)
    if: data = 0
        return
    data\parent: pd
    icell(data, 0U, 3)
    caller: mk_m(top, 7U, 1U)
    n: fr(caller, 0U, c.LMX_WALK_OP_EXEC, 5U)
    ref(n, 1U, data)
    ref(n, 2U, code)
    ref(n, 3U, wt_contract_same(ga, 0U, c.LMX_TYPE_LMX, c.LMX_TYPE_LMX))
    st: lmx_walk_run(gctx, caller, 0, 0U, gv)
    check(st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) pc), "NODE of a split activation is the code parent, not the data parent")

    # A contractless EXEC runs the selected zero-field code over any data; a non-empty code there is INVALID.
    e0: pl(top, 8U, 0U)
    if: e0 = 0
        return
    e0\parent: top
    caller: mk_m(top, 9U, 1U)
    n: fr(caller, 0U, c.LMX_WALK_OP_EXEC, 5U)
    ref(n, 1U, data)
    ref(n, 2U, e0)
    st: lmx_walk_run(gctx, caller, 0, 0U, gv)
    check(st = c.LMX_WALK_OK, "a contractless EXEC validates its zero-field code, not its data")
    caller: mk_m(top, 10U, 1U)
    n: fr(caller, 0U, c.LMX_WALK_OP_EXEC, 5U)
    ref(n, 1U, e0)
    ref(n, 2U, data)
    st: lmx_walk_run(gctx, caller, 0, 0U, gv)
    check(st = c.LMX_WALK_INVALID, "a contractless EXEC of a non-empty code is INVALID whatever its data")

    # A receiving input reads its requirement in the selected code's space even when the data is another
    # Structure: the CALL's callee sits under away, its data under dhome; each holds a model at 0.
    home: lmx_node_new_owned(ga)
    away: lmx_node_new_owned(ga)
    dhome: lmx_node_new_owned(ga)
    if: home = 0 || away = 0 || dhome = 0 || lmx_arena_refs_open_owned(ga, home, 3U) != 0 || lmx_arena_refs_open_owned(ga, away, 2U) != 0 || lmx_arena_refs_open_owned(ga, dhome, 2U) != 0
        broken: broken + 1
        return
    ---
    mh: one_int(home, 0U, 1)
    vh: one_int(home, 1U, 7)
    ma: one_int(away, 0U, 1)
    md: one_int(dhome, 0U, 1)
    d7: one_int(dhome, 1U, 9)
    callee: five(away, 1U)
    if: lmx_implements_register_map(ga, vh, vh, 0, 0U, (cast: (@: void) (wt_tokens + 0))) != c.LMX_IMPLEMENTS_YES
        broken: broken + 1
    caller: mk_m(home, 2U, 1U)
    n: fr(caller, 0U, c.LMX_WALK_OP_CALL, 6U)
    ref(n, 1U, callee)
    ref(n, 2U, d7)
    ref(n, 3U, wt_contract_same(ga, 1U, c.LMX_TYPE_LMX, c.LMX_TYPE_INT))
    recv_admit(n, 5U, 1)
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 5, "a CALL with distinct data and a receiving input runs")
    check(lmx_implements_find(ga, vh, ma) != 0 && lmx_implements_find(ga, vh, md) = 0, "a receiving input reads its model in the code space, not the data space")
end: check_exec_split

# [place, tokens, table] at child `at` of parent.
fn: place_of (@: Lmx parent; size_t: at; @: size_t table) @: Lmx
    @: Lmx p fr(parent, at, c.LMX_WALK_OP_PLACE, 3U)
    if: p = 0 || lmx_walk_store_charptr(ga, p, 1U, kp_tokens) != c.LMX_WALK_OK || lmx_walk_store_charptr(ga, p, 2U, (cast: (@: char) table)) != c.LMX_WALK_OK
        broken: broken + 1
        return: 0
    ---
return: p

# OWN [own, PLACE, r] at child `at` of parent.
fn: own_place (@: Lmx parent; size_t: at; @: size_t table; size_t: r) @: Lmx
    @: Lmx n fr(parent, at, c.LMX_WALK_OP_OWN, 3U)
    place_of(n, 1U, table)
    sz(n, 2U, r)
return: n

# A caller at slot of top whose one step is EXEC [exec, CALL_DATA [call_data, data, tokens, table], code, contract].
fn: exec_places (@: Lmx top; size_t: slot; @: Lmx code; @: Lmx data; @: size_t table) @: Lmx
    @: Lmx caller mk_m(top, slot, 1U)
    @: Lmx n 0
    @: Lmx d 0
    if: caller = 0
        return: 0
    n: fr(caller, 0U, c.LMX_WALK_OP_EXEC, 5U)
    d: fr(n, 1U, c.LMX_WALK_OP_CALL_DATA, 4U)
    ref(d, 1U, data)
    if: d = 0 || lmx_walk_store_charptr(ga, d, 2U, kp_tokens) != c.LMX_WALK_OK || lmx_walk_store_charptr(ga, d, 3U, (cast: (@: char) table)) != c.LMX_WALK_OK
        broken: broken + 1
    ref(n, 2U, code)
    ref(n, 3U, wt_contract_same(ga, 0U, c.LMX_TYPE_INT, c.LMX_TYPE_INT))
return: caller

# Data of two int cells at slot of holder, its parent holder, with the layout token kp_tokens + token (0: none).
fn: kp_data (@: Lmx holder; size_t: slot; int: a; int: b; size_t: token) @: Lmx
    @: Lmx s pl(holder, slot, 2U)
    if: s = 0
        return: 0
    s\parent: holder
    icell(s, 0U, a)
    icell(s, 1U, b)
    if: token != 0U && lmx_implements_register_map(ga, s, s, 0, 0U, (cast: (@: void) (kp_tokens + token))) != c.LMX_IMPLEMENTS_YES
        broken: broken + 1
return: s

# The code of x at slot of top: its own cell 5 at 0, then x: 42 and return: x, x through a PLACE of table.
fn: kp_code (@: Lmx top; size_t: slot; @: size_t table) @: Lmx
    @: Lmx code mk_m(top, slot, 3U)
    @: Lmx n 0
    if: code = 0
        return: 0
    icell(code, 0U, 5)
    n: fr(code, 1U, c.LMX_WALK_OP_SET, 3U)
    own_place(n, 1U, table, 0U)
    lit(n, 2U, 42)
    n: fr(code, 2U, c.LMX_WALK_OP_RET, 2U)
    own_place(n, 1U, table, 0U)
return: code

# N4 (docs/LMX_semantics.ru.md: the code-to-data correspondence is prepared at the admission of the selected call,
# before its body, kept as addresses, with no runtime name search; a missing or ambiguous place is a runtime error of
# the call): `call: code data` with a code that has names is EXEC [exec, CALL_DATA, code, ...].  A code name reaches
# the data through PLACE: the activation resolves the static table's row for the data's own layout token at its
# entry, and the name's ordinal reads that row.  The call admits the data first: a place the data lacks is the
# implicit `call` throw before the code runs; data of no proved layout (no token) is INVALID, not a throw.
sub: check_exec_places ()
    @: Lmx top lmx_node_new_owned(ga)
    @: Lmx c1 0
    @: Lmx c2 0
    @: Lmx code 0
    @: Lmx d1 0
    @: Lmx d2 0
    @: Lmx d3 0
    @: Lmx d4 0
    @: Lmx d9 0
    @: Lmx d11 0
    @: Lmx d11b 0
    @: Lmx m11 0
    @: Lmx inner 0
    @: Lmx ident 0
    @: Lmx caller 0
    @: Lmx n 0
    @: Lmx k 0
    @: Lmx a 0
    @: Lmx b 0
    @: Lmx p 0
    int: st
    int: r 0
    int: v 0
    if: top = 0 || lmx_arena_refs_open_owned(ga, top, 34U) != 0
        broken: broken + 1
        return
    ---
    kp_table[0]: 1U
    kp_table[1]: 2U
    kp_table[2]: 1U
    kp_table[3]: 1U
    kp_table[4]: 3U
    kp_table[5]: 0U
    kp_miss[0]: 1U
    kp_miss[1]: 2U
    kp_miss[2]: 2U
    kp_miss[3]: (cast: (size_t) -1)
    kp_miss[4]: 1U
    kp_miss[5]: 1U
    c1: kp_code(top, 0U, kp_table)
    c2: kp_code(top, 1U, kp_miss)
    d1: kp_data(top, 2U, 100, 7, 1U)
    d3: kp_data(top, 3U, 9, 50, 3U)
    d2: kp_data(top, 4U, 100, 7, 2U)
    d4: kp_data(top, 5U, 100, 7, 0U)
    if: c1 = 0 || c2 = 0 || d1 = 0 || d2 = 0 || d3 = 0 || d4 = 0
        return
    # KW1: the row of the data's own token, by name ordinal: layout 1 at slot 1, layout 3 at slot 0.
    caller: exec_places(top, 6U, c1, d1, kp_table)
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && v != 0 && r = 42, "KW1: EXEC with CALL_DATA runs the code over the data")
    check(lmx_int_value_known(lmx_arena_ref_value(d1, 1U)) = 42 && lmx_int_value_known(lmx_arena_ref_value(d1, 0U)) = 100 && lmx_int_value_known(lmx_arena_ref_value(c1, 0U)) = 5, "KW1: x is the data's slot of its layout row; the pad and the code cell are untouched")
    caller: exec_places(top, 7U, c1, d3, kp_table)
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 42 && lmx_int_value_known(lmx_arena_ref_value(d3, 0U)) = 42 && lmx_int_value_known(lmx_arena_ref_value(d3, 1U)) = 50, "KW1: another layout of the same table reads its own row")
    # KW2: a layout that lacks x: the call's implicit `call` throw, nothing run.  KW3: data with no layout token has no
    # proved row: the translator's broken promise, INVALID -- never the catchable `call`.
    caller: exec_places(top, 8U, c2, d2, kp_miss)
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_THROWN + c.LMX_WALK_NAME_CALL && lmx_int_value_known(lmx_arena_ref_value(d2, 1U)) = 7 && lmx_int_value_known(lmx_arena_ref_value(d2, 0U)) = 100, "KW2: a place the data lacks is the call throw at the admission")
    caller: exec_places(top, 9U, c1, d4, kp_table)
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_INVALID && lmx_int_value_known(lmx_arena_ref_value(d4, 1U)) = 7, "KW3: data with no layout token is INVALID at the admission, not the call throw")
    # KW4: an activation entered without the admission resolves the same row at its entry; a row that is not YES
    # there is the translator's broken promise.
    st: lmx_walk_activate(gctx, c1, d3, 0, 0U, gv)
    check(st = c.LMX_WALK_OK, "KW4: a direct activation resolves its data places at entry")
    st: lmx_walk_activate(gctx, c2, d2, 0, 0U, gv)
    check(st = c.LMX_WALK_INVALID && lmx_int_value_known(lmx_arena_ref_value(d2, 1U)) = 7, "KW4: a direct activation over data the table does not admit is INVALID")
    # KW5: AT over a PLACE is the data's slot too.
    code: mk_m(top, 10U, 2U)
    icell(code, 0U, 5)
    n: fr(code, 1U, c.LMX_WALK_OP_RET, 2U)
    a: fr(n, 1U, c.LMX_WALK_OP_AT, 3U)
    place_of(a, 1U, kp_table)
    sz(a, 2U, 0U)
    caller: exec_places(top, 11U, code, d1, kp_table)
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 42, "KW5: AT over a PLACE reads the data's slot, not the code cell")
    # KW6: two tables in one activation.
    code: mk_m(top, 12U, 3U)
    icell(code, 0U, 5)
    n: fr(code, 1U, c.LMX_WALK_OP_SET, 3U)
    own_place(n, 1U, kp_table, 0U)
    lit(n, 2U, 1)
    n: fr(code, 2U, c.LMX_WALK_OP_RET, 2U)
    own_place(n, 1U, kp_miss, 0U)
    caller: exec_places(top, 13U, code, d1, kp_table)
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_INVALID && lmx_int_value_known(lmx_arena_ref_value(d1, 1U)) = 42, "KW6: a second place table in one activation is INVALID")
    # KW6b: the second table is refused at the entry even where no statement would use it -- an AT, which the entry
    # load does not read, in a branch not taken; without that refusal the code would return 9.
    code: mk_m(top, 21U, 4U)
    icell(code, 0U, 5)
    n: fr(code, 1U, c.LMX_WALK_OP_SET, 3U)
    own_place(n, 1U, kp_table, 0U)
    lit(n, 2U, 1)
    n: fr(code, 2U, c.LMX_WALK_OP_IF, 3U)
    lit(n, 1U, 0)
    b: pl(n, 2U, 1U)
    k: fr(b, 0U, c.LMX_WALK_OP_RET, 2U)
    a: fr(k, 1U, c.LMX_WALK_OP_AT, 3U)
    place_of(a, 1U, kp_miss)
    sz(a, 2U, 0U)
    n: fr(code, 3U, c.LMX_WALK_OP_RET, 2U)
    lit(n, 1U, 9)
    caller: exec_places(top, 22U, code, d1, kp_table)
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_INVALID && lmx_int_value_known(lmx_arena_ref_value(d1, 1U)) = 42, "KW6b: a second place table is INVALID at the entry, used or not")
    # KW6c: a PLACE the entry did not resolve -- not its node's own child -- is never read through another table's
    # row.
    p: place_of(top, 23U, kp_miss)
    code: mk_m(top, 24U, 3U)
    icell(code, 0U, 5)
    n: fr(code, 1U, c.LMX_WALK_OP_SET, 3U)
    own_place(n, 1U, kp_table, 0U)
    lit(n, 2U, 2)
    n: fr(code, 2U, c.LMX_WALK_OP_RET, 2U)
    k: fr(n, 1U, c.LMX_WALK_OP_OWN, 3U)
    ref(k, 1U, p)
    sz(k, 2U, 0U)
    caller: exec_places(top, 25U, code, d1, kp_table)
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_INVALID, "KW6c: a PLACE of another table that the entry did not resolve is INVALID at its use")
    # KW7: CALL_DATA is no statement.
    code: mk_m(top, 14U, 1U)
    n: fr(code, 0U, c.LMX_WALK_OP_CALL_DATA, 4U)
    ref(n, 1U, d1)
    if: n = 0 || lmx_walk_store_charptr(ga, n, 2U, kp_tokens) != c.LMX_WALK_OK || lmx_walk_store_charptr(ga, n, 3U, (cast: (@: char) kp_table)) != c.LMX_WALK_OK
        broken: broken + 1
    st: go(code, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_INVALID, "KW7: CALL_DATA evaluated as a statement is INVALID")
    # KW8: a PLACE reached only inside a call's actual is resolved at the activation's entry, outside the call's
    # scratch mark: ident returns its input, the data's x.
    ident: mk_m(top, 15U, 1U)
    n: fr(ident, 0U, c.LMX_WALK_OP_RET, 2U)
    a: fr(n, 1U, c.LMX_WALK_OP_ARG, 4U)
    sz(a, 1U, 0U)
    if: a = 0 || lmx_arena_ref_store(a, 3U, wt_witness(ga, c.LMX_TYPE_INT)) != 0
        broken: broken + 1
    code: mk_m(top, 16U, 2U)
    icell(code, 0U, 5)
    n: fr(code, 1U, c.LMX_WALK_OP_RET, 2U)
    k: fr(n, 1U, c.LMX_WALK_OP_CALL, 6U)
    ref(k, 1U, ident)
    ref(k, 2U, ident)
    ref(k, 3U, wt_contract_same(ga, 1U, c.LMX_TYPE_INT, c.LMX_TYPE_INT))
    own_place(k, 5U, kp_table, 0U)
    caller: exec_places(top, 17U, code, d1, kp_table)
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 42, "KW8: a PLACE used only in a call's actual is resolved at entry")
    # KW9: an activation with a place table never replays a fixed holder of its code into its data by position.
    d9: pl(top, 18U, 2U)
    if: d9 = 0
        return
    d9\parent: top
    one_int(d9, 0U, 99)
    icell(d9, 1U, 7)
    if: lmx_implements_register_map(ga, d9, d9, 0, 0U, (cast: (@: void) (kp_tokens + 1))) != c.LMX_IMPLEMENTS_YES
        broken: broken + 1
    code: mk_m(top, 19U, 3U)
    inner: one_int(code, 0U, 11)
    n: fr(code, 1U, c.LMX_WALK_OP_SET, 3U)
    own_place(n, 1U, kp_table, 0U)
    lit(n, 2U, 1)
    n: fr(code, 2U, c.LMX_WALK_OP_RET, 2U)
    own(n, 1U, inner, 0U)
    caller: exec_places(top, 20U, code, d9, kp_table)
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_INVALID && lmx_int_value_known(lmx_arena_ref_value(d9, 1U)) = 7, "KW9: a fixed holder inside a place-mapped code is INVALID, never replayed into the data")
    # KW11 (SF14; Codex OPUS-CODEX-20261016-27): an activation an EXEC enters with explicit data never replays a
    # position of its code into its data, also with no place table (a code with no names).  [ret, [at, 0, 0]] reads the
    # code's own cell 5 when the code runs over itself; over d11 it is INVALID, and d11 keeps 100.
    d11: pl(top, 21U, 2U)
    if: d11 = 0
        return
    d11\parent: top
    icell(d11, 0U, 100)
    icell(d11, 1U, 7)
    code: mk_m(top, 22U, 2U)
    icell(code, 0U, 5)
    n: fr(code, 1U, c.LMX_WALK_OP_RET, 2U)
    k: fr(n, 1U, c.LMX_WALK_OP_AT, 3U)
    sz(k, 2U, 0U)
    caller: mk_m(top, 23U, 1U)
    n: fr(caller, 0U, c.LMX_WALK_OP_EXEC, 5U)
    ref(n, 2U, code)
    ref(n, 3U, wt_contract_same(ga, 0U, c.LMX_TYPE_INT, c.LMX_TYPE_INT))
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 5, "KW11: holder 0 of a code run over itself is its own cell")
    ref(n, 1U, d11)
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_INVALID && lmx_int_value_known(lmx_arena_ref_value(d11, 0U)) = 100, "KW11: holder 0 under explicit data is INVALID, never the data's slot at the code's position")
    # KW11b: nor a fixed holder inside its code -- [own, inner, 0] over d11b is INVALID where a copy's replay reads the
    # data's child 0, 99.
    d11b: pl(top, 24U, 2U)
    if: d11b = 0
        return
    d11b\parent: top
    one_int(d11b, 0U, 99)
    icell(d11b, 1U, 7)
    code: mk_m(top, 25U, 2U)
    inner: one_int(code, 0U, 11)
    n: fr(code, 1U, c.LMX_WALK_OP_RET, 2U)
    own(n, 1U, inner, 0U)
    caller: mk_m(top, 26U, 1U)
    n: fr(caller, 0U, c.LMX_WALK_OP_EXEC, 5U)
    ref(n, 1U, d11b)
    ref(n, 2U, code)
    ref(n, 3U, wt_contract_same(ga, 0U, c.LMX_TYPE_INT, c.LMX_TYPE_INT))
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_INVALID && lmx_int_value_known(lmx_arena_ref_value(lmx_arena_ref_struct(d11b, 0U), 0U)) = 99, "KW11b: a fixed holder inside the code under explicit data is INVALID, never replayed into the data")
    # KW11c: the mark is the entered activation's only -- an ordinary method m11 that the code calls runs over itself,
    # its holder 0 its own cell 33, under explicit data too.
    m11: mk_m(top, 27U, 2U)
    icell(m11, 0U, 33)
    n: fr(m11, 1U, c.LMX_WALK_OP_RET, 2U)
    k: fr(n, 1U, c.LMX_WALK_OP_AT, 3U)
    sz(k, 2U, 0U)
    code: mk_m(top, 28U, 1U)
    n: fr(code, 0U, c.LMX_WALK_OP_RET, 2U)
    k: fr(n, 1U, c.LMX_WALK_OP_CALL, 5U)
    ref(k, 1U, m11)
    ref(k, 2U, m11)
    ref(k, 3U, wt_contract_same(ga, 0U, c.LMX_TYPE_INT, c.LMX_TYPE_INT))
    caller: mk_m(top, 29U, 1U)
    n: fr(caller, 0U, c.LMX_WALK_OP_EXEC, 5U)
    ref(n, 1U, d11)
    ref(n, 2U, code)
    ref(n, 3U, wt_contract_same(ga, 0U, c.LMX_TYPE_INT, c.LMX_TYPE_INT))
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 33, "KW11c: a method the split code calls keeps its own holder 0")
    # KW11e: [self] is the activation's data itself, named, under explicit data too.
    code: mk_m(top, 30U, 1U)
    n: fr(code, 0U, c.LMX_WALK_OP_RET, 2U)
    fr(n, 1U, c.LMX_WALK_OP_SELF, 1U)
    caller: mk_m(top, 31U, 1U)
    n: fr(caller, 0U, c.LMX_WALK_OP_EXEC, 5U)
    ref(n, 1U, d11)
    ref(n, 2U, code)
    ref(n, 3U, wt_contract_same(ga, 0U, c.LMX_TYPE_LMX, c.LMX_TYPE_LMX))
    st: lmx_walk_run(gctx, caller, 0, 0U, gv)
    check(st = c.LMX_WALK_OK && gv\ref = (cast: (@: void) d11), "KW11e: [self] under explicit data is the data")
    # KW13 (SF16): a CALL that passes its data at slot 2 makes no admission -- only `call: code data` does: the
    # callee's entry resolves the row, and a row that is not YES is INVALID there, never the call's implicit `call`.
    caller: mk_m(top, 32U, 1U)
    n: fr(caller, 0U, c.LMX_WALK_OP_CALL, 5U)
    ref(n, 1U, c1)
    ref(n, 2U, d1)
    ref(n, 3U, wt_contract_same(ga, 0U, c.LMX_TYPE_INT, c.LMX_TYPE_INT))
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 42, "KW13: a CALL with explicit data resolves the callee's row at its entry")
    caller: mk_m(top, 33U, 1U)
    n: fr(caller, 0U, c.LMX_WALK_OP_CALL, 5U)
    ref(n, 1U, c2)
    ref(n, 2U, d2)
    ref(n, 3U, wt_contract_same(ga, 0U, c.LMX_TYPE_INT, c.LMX_TYPE_INT))
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_INVALID && lmx_int_value_known(lmx_arena_ref_value(d2, 1U)) = 7, "KW13: a CALL over data the callee's table does not admit is INVALID at its entry, never the call throw")
end: check_exec_places

fn: main () int
    LmxArena: arena
    LmxArena: context_arena
    LmxPool: context_cells
    LmxScratch: store
    LmxWalkContext: context
    @: Lmx unit 0
    @: Lmx writer 0
    @: Lmx caller 0
    @: Lmx bad 0
    @: Lmx n 0
    @: void xcell 0
    int: r 0
    int: v 0
    int: st 0
    @: Lmx home 0
    @: Lmx away 0
    @: Lmx far 0
    @: Lmx mh 0
    @: Lmx ma 0
    @: Lmx mf 0
    @: Lmx vh 0
    @: Lmx va 0
    @: Lmx callee 0
    @: Lmx callee2 0
    @: Lmx rcaller 0
    @: Lmx ocaller 0
    @: Lmx scaller 0
    @: Lmx fcaller 0
    @: void wrong 0

    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        return: 2
    ---
    ga: @ arena
    groles: lmx_walk_roles_open(ga)
    memset((cast: (@: void) (@ context_arena)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ context_cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ store)), 0, c.sizeof(c.LmxScratch))
    if: lmx_arena_open(@ context_arena) != 0 || lmx_scratch_open(@ store, @ context_arena, @ context_cells, 16U) != c.LMX_SCRATCH_OK
        return: 2
    ---
    lmx_walk_program_bind(groles)
    context.arena: ga
    context.scratch: @ store
    context.roles: groles
    context.immutable_profile: 0
    context.classified: 0U
    gctx: @ context
    gv: (cast: (@: LmxWalkValue) calloc(1U, c.sizeof(c.LmxWalkValue)))
    if: gv = 0 || groles = 0
        return: 2
    ---

    unit: lmx_node_new_owned(ga)
    if: unit = 0 || lmx_arena_refs_open_owned(ga, unit, 8U) != 0
        return: 2
    ---

    # writer: own x 1;  x: 99;  return: x
    # Called with data = writer itself: the SET writes x's working value (its row, loaded at entry from the code's
    # own nodes), and the exit publishes 99 into writer's own cell.
    # k.4: no descriptor slot -- own field x at slot 0, SET at slot 1, RET at slot 2.
    writer: mk_m(unit, 1U, 3U)
    xcell: icell(writer, 0U, 1)
    n: fr(writer, 1U, c.LMX_WALK_OP_SET, 3U)
    own(n, 1U, writer, 0U)
    lit(n, 2U, 99)
    n: fr(writer, 2U, c.LMX_WALK_OP_RET, 2U)
    own(n, 1U, writer, 0U)

    # k.4: caller's CALL step at slot 0 (no descriptor); CALL gains a 4th leading child
    # (rtype, left 0 -- writer is walked, not native, so lmx_walk_call never reads it on
    # that path); data is writer itself at child 2, (M, M).
    caller: mk_m(unit, 2U, 1U)
    n: fr(caller, 0U, c.LMX_WALK_OP_CALL, 5U)
    ref(n, 1U, writer)
    ref(n, 2U, writer)
    ref(n, 3U, wt_contract_same(ga, 0U, c.LMX_TYPE_INT, c.LMX_TYPE_INT))
    st: go(caller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && v = 1 && r = 99, "CALL data=M: the callee returns its working 99")
    check(lmx_int_value_known(xcell) = 99, "after return M\\x is 99: the exit published into M's own cell (a per-call instance, or no publication -> RED)")

    # Mutant: CALL with only code child (no data, no rtype) -> INVALID (k.4 floor is 4
    # children: role+code+data+rtype, was 3; 2 is still short either way).
    bad: mk_m(unit, 3U, 1U)
    n: fr(bad, 0U, c.LMX_WALK_OP_CALL, 2U)
    ref(n, 1U, writer)
    st: lmx_walk_run(gctx, bad, 0, 0U, gv)
    check(st = c.LMX_WALK_INVALID, "CALL without data/rtype children -> INVALID (mutant old arity greened -> RED)")

    # -31 RECEIVING (lmx_walk.h, ADMIT_AS; Codex K03-READ-FIELD-CLOSURE-20261008-31): a CALL input's admission marked
    # LMX_WALK_SOURCE_RECEIVING reads its requirement, [of, [node], 0], in the space of the occurrence the CALL selected
    # -- its node -- and its value, [of, [node], 1], in the caller's.  home, the callers' node, and away, the callee's,
    # each hold a model at 0 and a value at 1 of one layout; far holds a third model.
    home: lmx_node_new_owned(ga)
    away: lmx_node_new_owned(ga)
    far: lmx_node_new_owned(ga)
    if: home = 0 || away = 0 || far = 0 || lmx_arena_refs_open_owned(ga, home, 6U) != 0 || lmx_arena_refs_open_owned(ga, away, 3U) != 0 || lmx_arena_refs_open_owned(ga, far, 2U) != 0
        return: 2
    ---
    mh: one_int(home, 0U, 1)
    vh: one_int(home, 1U, 7)
    ma: one_int(away, 0U, 1)
    va: one_int(away, 1U, 8)
    mf: one_int(far, 0U, 1)
    callee: five(away, 2U)
    callee2: five(far, 1U)
    if: lmx_implements_register_map(ga, vh, vh, 0, 0U, (cast: (@: void) (wt_tokens + 0))) != c.LMX_IMPLEMENTS_YES || lmx_implements_register_map(ga, va, va, 0, 0U, (cast: (@: void) (wt_tokens + 0))) != c.LMX_IMPLEMENTS_YES
        broken: broken + 1
    rcaller: mk_m(home, 2U, 1U)
    recv_call(rcaller, callee, 1)
    ocaller: mk_m(home, 3U, 1U)
    recv_call(ocaller, callee, 0)
    scaller: mk_m(home, 4U, 1U)
    recv_admit(scaller, 0U, 1)
    fcaller: mk_m(home, 5U, 1U)
    recv_call(fcaller, callee2, 1)
    st: go(rcaller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && v = 1 && r = 5, "RECEIVING: the CALL with a receiving admission runs")
    check(lmx_implements_find(ga, vh, ma) != 0, "RECEIVING: the caller's value is admitted to the model of the callee's node")
    check(lmx_implements_find(ga, vh, mh) = 0 && lmx_implements_find(ga, va, ma) = 0 && lmx_implements_find(ga, va, mh) = 0, "RECEIVING: neither the value nor the model is read in the other space")
    st: go(ocaller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 5 && lmx_implements_find(ga, vh, mh) != 0, "an unmarked admission reads its model in the caller's space")
    st: go(scaller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_INVALID, "a RECEIVING admission outside a call's inputs is no expression")
    # A completed pair is reused as it stands: with the value's field no longer of its model's type, the same pair
    # admits again through its record, while a new pair is checked field by field and refused.
    wrong: lmx_char_new_owned(ga)
    if: wrong = 0 || lmx_arena_ref_store(vh, 0U, wrong) != 0
        broken: broken + 1
    st: go(rcaller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_OK && r = 5, "RECEIVING: a completed pair is reused without checking its fields again")
    st: go(fcaller, 0, 0U, @ r, @ v)
    check(st = c.LMX_WALK_THROWN + 2 && lmx_implements_find(ga, vh, mf) = 0, "RECEIVING: a new pair is checked field by field")

    check_exec_split()
    check_exec_places()
    check_node_ancestry()
    check(broken = 0, "fixture construction")
    if: failures != 0
        c.printf("lmx_walk_call_data_selftest %d/%d FAILED\n", failures, checks)
        return: 1
    ---
    c.printf("OK %d checks\n", checks)
return: 0
