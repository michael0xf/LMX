int: k 4
prepared:
    name: triple
    args:
        int: a
    end: args
    return: int
    data:
        int: calls 0
    end: data
    code:
        :=: calls (calls + 1)
        int: last a
        return: ((last * 3) + k)
    end: code
end: prepared
fn: prepared
fn: other prepared
:=: k 4
