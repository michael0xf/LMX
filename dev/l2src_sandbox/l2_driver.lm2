fn: stop_root_probe (@: owner void; @@: refs void; size_t: nargs; @: dest void; @@: out void; @: lmx_call_arena c.LmxArena; @: lmx_call_code c.Lmx; @: lmx_input_values c.LmxWalkValue; @: lmx_result_context c.LmxWalkValue) int
    @: stop_saved_view c.LmxPrimitiveEntry (cast: (@: c.LmxPrimitiveEntry) (@ c.stop_saved))
    @@: stop_published_cell void (cast: (@@: void) (@ c.stop_published))
    @@: stop_received_cell void (cast: (@@: void) (@ c.stop_received))
    @: stop_root_returns_cell int (cast: (@: int) (@ c.stop_root_returns))
    @: stop_late_calls_cell int (cast: (@: int) (@ c.stop_late_calls))
    @: stop_receiver_calls_cell int (cast: (@: int) (@ c.stop_receiver_calls))
    int: status
    c.LmxPrimitiveEntry: entry stop_saved_view[1]
    status: entry(owner, refs, nargs, dest, out, lmx_call_arena, lmx_call_code, lmx_input_values, lmx_result_context)
    @: published void stop_published_cell[0]
    @: receiver void stop_received_cell[0]
    stop_root_returns_cell[0]: stop_root_returns_cell[0] + 1
    check((cast: (int) (c.lmx_msg_poll_escape() != 0)), "root unwinds with Message still stopped")
    check((cast: (int) (out != 0 && status = 0 && out[0] = 0)), "root stop is absent result, not a throw or success payload")
    check((cast: (int) (published != 0 && c.lmx_int_value_known(published) = 73)), "unwind preserves published caller working value")
    check((cast: (int) (receiver != 0 && c.lmx_int_value_known(receiver) = 99)), "stopped first actual never updates receiving field")
    check((cast: (int) (stop_late_calls_cell[0] = 0 && stop_receiver_calls_cell[0] = 0)), "stop skips later actual and receiver body")
    return: status
end: stop_root_probe

fn: stop_int_cell (@: arena c.LmxArena; @: host c.Lmx; int: nth) @: void
    @: host_fields c.VoidArray 0
    host_fields: 0
    if: host != 0
        host_fields: @ host\array
    ---
    size_t: i 0U
    int: seen 0
    @: child void 0
    if: arena = 0 || host = 0
        return: 0
    while: i < host_fields\size
        child: c.lmx_arena_ref_value(host, i)
        if: child != 0 && c.lmx_domain_kind(arena, child) = c.LMX_KIND_PRIMITIVE && c.lmx_domain_type(arena, child) = c.LMX_TYPE_INT
            if: seen = nth
                return: child
            seen: seen + 1
        i: i + 1U
    ---
    return: 0
end: stop_int_cell

fn: stop_install (@: arena c.LmxArena; @: graph c.Lmx; int: at) int
    @@: stop_caller_cell c.Lmx (cast: (@@: c.Lmx) (@ c.stop_caller))
    @@: stop_published_cell void (cast: (@@: void) (@ c.stop_published))
    @@: stop_received_cell void (cast: (@@: void) (@ c.stop_received))
    @@: stop_later_cell c.Lmx (cast: (@@: c.Lmx) (@ c.stop_later))
    @@: stop_receiver_cell c.Lmx (cast: (@@: c.Lmx) (@ c.stop_receiver))
    @: stop_saved_view c.LmxPrimitiveEntry (cast: (@: c.LmxPrimitiveEntry) (@ c.stop_saved))
    @@: stop_extra_view c.Lmx (cast: (@@: c.Lmx) (@ c.stop_extra))
    @: stop_walk_caller_cell int (cast: (@: int) (@ c.stop_walk_caller))
    @: first c.Lmx c.lmx_arena_ref_struct(graph, (cast: (size_t) arg(at + 1)))
    @: stop_cells c.Lmx 0
    int: k 0
    stop_caller_cell[0]: c.lmx_arena_ref_struct(graph, (cast: (size_t) arg(at + 8)))
    # The four-part fn layout holds the caller's own declaration cells in its
    # body part (slot 3), not directly in the occurrence; the occurrence itself
    # stays the native/stop word holder below.
    stop_cells: c.lmx_arena_ref_struct(stop_caller_cell[0], 3U)
    if: stop_cells = 0
        return: 1
    stop_published_cell[0]: stop_int_cell(arena, stop_cells, 0)
    stop_received_cell[0]: stop_int_cell(arena, stop_cells, 1)
    stop_later_cell[0]: c.lmx_arena_ref_struct(graph, (cast: (size_t) arg(at + 6)))
    stop_receiver_cell[0]: c.lmx_arena_ref_struct(graph, (cast: (size_t) arg(at + 7)))
    check((cast: (int) (first != 0 && first\native != 0 && stop_caller_cell[0] != 0 && stop_caller_cell[0]\native != 0 && graph\native != 0)), "stop tap starts with real native adapters and caller")
    if: first = 0 || stop_caller_cell[0] = 0 || stop_later_cell[0] = 0 || stop_receiver_cell[0] = 0
        return: 1
    check((cast: (int) (stop_later_cell[0]\native != 0 && stop_receiver_cell[0]\native != 0)), "skipped later actual and receiver begin as actual native bodies")
    if: stop_later_cell[0]\native = 0 || stop_receiver_cell[0]\native = 0
        return: 1
    stop_saved_view[0]: (cast: (c.LmxPrimitiveEntry) first\native)
    first\native: (cast: (c.LmxEntry) c.stop_first)
    while: k < 4
        stop_extra_view[k]: c.lmx_arena_ref_struct(graph, (cast: (size_t) arg(at + k + 2)))
        check((cast: (int) (stop_extra_view[k] != 0 && stop_extra_view[k]\native != 0)), "each extra typed adapter starts with its native body")
        if: stop_extra_view[k] = 0 || stop_extra_view[k]\native = 0
            return: 1
        k: k + 1
    ---
    @: later_target c.Lmx stop_later_cell[0]
    later_target\native: (cast: (c.LmxEntry) c.stop_later_probe)
    @: receiver_target c.Lmx stop_receiver_cell[0]
    receiver_target\native: (cast: (c.LmxEntry) c.stop_receiver_probe)
    stop_saved_view[1]: (cast: (c.LmxPrimitiveEntry) graph\native)
    graph\native: (cast: (c.LmxEntry) c.stop_root_probe)
    if: stop_walk_caller_cell[0] != 0
        @: caller_target c.Lmx stop_caller_cell[0]
        caller_target\native: 0
        check((cast: (int) (stop_caller_cell[0]\native = 0 && first\native != 0 && graph\native != 0)), "only caller is actually walked, typed stop body and root remain native")
    ---
    return: 0
end: stop_install

fn: shape_merge_nest (@: arena c.LmxArena; @: graph c.Lmx) int
    @: merged_fields c.VoidArray 0
    @: outer c.Lmx 0
    @: one c.Lmx 0
    @: merged c.Lmx 0
    @: inner c.Lmx 0
    @: cell void 0
    @: old_cell void 0
    size_t: n 0U
    outer: shape_find_nest(arena, graph)
    check((cast: (int) (outer != 0)), "merge finds the nested Structure")
    if: outer = 0
        return: 1
    one: outer
    if: c.lmx_merge_owned(@ one, 1U, 0, arena, arena, 0, 0U, @ merged) != c.LMX_MERGE_OK || merged = 0 || merged = outer
        check((cast: (int) (0)), "merge builds a distinct nested result")
        return: 1
    merged_fields: @ merged\array
    n: merged_fields\size
    check((cast: (int) (n = 1U)), "merge keeps the one nested field")
    # The result's parent is the copy's own: the copy of outer's lexical parent, not the place running the merge
    # and not outer's source parent (the author, LMX_blog/2026-10-05.md#merge-parent).
    @: merged_parent_fields c.VoidArray 0
    @: model_parent_fields c.VoidArray 0
    if: merged\parent != 0
        @: merged_parent c.Lmx merged\parent
        merged_parent_fields: @ merged_parent\array
    ---
    if: outer\parent != 0
        @: model_parent c.Lmx outer\parent
        model_parent_fields: @ model_parent\array
    ---
    check((cast: (int) ((outer\parent = 0 && merged\parent = 0) || (outer\parent != 0 && merged\parent != 0 && merged\parent != outer\parent && merged_parent_fields\size = model_parent_fields\size))), "merge parents the nested result at the copy of its model's parent")
    inner: (cast: (@: c.Lmx) c.lmx_arena_ref_value(merged, 0U))
    check((cast: (int) (inner != 0 && inner != (cast: (@: c.Lmx) c.lmx_arena_ref_value(outer, 0U)))), "merge copies the inner Structure")
    if: inner = 0
        return: 1
    check((cast: (int) (inner\parent = merged)), "merge parents the copied inner Structure at the result")
    check((cast: (int) (shape_one_int(arena, inner) != 0)), "merge keeps the exact inner declaration and initializer with copied owners")
    check((cast: (int) (c.lmx_arena_ref_value(inner, 1U) != c.lmx_arena_ref_value((cast: (@: c.Lmx) c.lmx_arena_ref_value(outer, 0U)), 1U))), "merge copies the inner initializer instead of borrowing it")
    cell: c.lmx_arena_ref_value(inner, 0U)
    old_cell: c.lmx_arena_ref_value((cast: (@: c.Lmx) c.lmx_arena_ref_value(outer, 0U)), 0U)
    check((cast: (int) (cell != 0 && cell != old_cell && c.lmx_domain_type(arena, cell) = c.LMX_TYPE_INT && c.lmx_int_value_known(cell) = 1)), "merge keeps the nested int")
    return: 0
end: shape_merge_nest

fn: shape_merge_holder (@: arena c.LmxArena; @: graph c.Lmx) int
    @: merged_fields c.VoidArray 0
    @: holder c.Lmx 0
    @: one c.Lmx 0
    @: merged c.Lmx 0
    @: a void 0
    @: b void 0
    size_t: n 0U
    holder: shape_find_holder(arena, graph)
    check((cast: (int) (holder != 0)), "merge finds the two declarations in their full source Structure")
    if: holder = 0
        return: 1
    one: holder
    if: c.lmx_merge_owned(@ one, 1U, 0, arena, arena, 0, 0U, @ merged) != c.LMX_MERGE_OK || merged = 0 || merged = holder
        check((cast: (int) (0)), "merge builds a distinct result")
        return: 1
    merged_fields: @ merged\array
    n: merged_fields\size
    check((cast: (int) (n = 4U)), "merge keeps both cells and both written initializers")
    @: merged_parent_fields c.VoidArray 0
    @: model_parent_fields c.VoidArray 0
    if: merged\parent != 0
        @: merged_parent c.Lmx merged\parent
        merged_parent_fields: @ merged_parent\array
    ---
    if: holder\parent != 0
        @: model_parent c.Lmx holder\parent
        model_parent_fields: @ model_parent\array
    ---
    check((cast: (int) ((holder\parent = 0 && merged\parent = 0) || (holder\parent != 0 && merged\parent != 0 && merged\parent != holder\parent && merged_parent_fields\size = model_parent_fields\size))), "merge parents the result at the copy of its model's parent")
    a: c.lmx_arena_ref_value(merged, 0U)
    b: c.lmx_arena_ref_value(merged, 2U)
    check((cast: (int) (a != 0 && b != 0 && a != c.lmx_arena_ref_value(holder, 0U) && b != c.lmx_arena_ref_value(holder, 2U))), "merge copies the field cells")
    check((cast: (int) (a != 0 && c.lmx_domain_type(arena, a) = c.LMX_TYPE_INT && c.lmx_int_value_known(a) = 1)), "merge keeps the first int")
    check((cast: (int) (b != 0 && c.lmx_domain_type(arena, b) = c.LMX_TYPE_INT && c.lmx_int_value_known(b) = 3)), "merge keeps the second int")
    check((cast: (int) (shape_two_ints(arena, merged) != 0)), "merge retains exact initialization operations with copied owners and field indices")
    check((cast: (int) (c.lmx_arena_ref_value(merged, 1U) != c.lmx_arena_ref_value(holder, 1U) && c.lmx_arena_ref_value(merged, 3U) != c.lmx_arena_ref_value(holder, 3U))), "merge copies both initializers instead of borrowing them")
    return: 0
end: shape_merge_holder

sub: shape_copy_native_call (@: source c.LmxArena; @: graph c.Lmx; size_t: slot; int: expected)
    c.LmxArena: destination
    @: copied c.Lmx 0
    @: method c.Lmx 0
    @: original c.Lmx 0
    @: source_head c.VoidArray 0
    @: copied_head c.VoidArray 0
    @: source_field c.VoidArray 0
    @: copied_field c.VoidArray 0
    size_t: source_before 0U
    size_t: destination_before 0U
    int: result 0
    c.memset((cast: (@: void) (@ destination)), 0, c.sizeof(c.LmxArena))
    if: c.lmx_arena_open(@ destination) != 0
        check((cast: (int) (0)), "cross-arena native call opens its destination arena")
        return
    ---
    if: c.lmx_graph_copy_owned(graph, source, @ destination, @ copied) != c.LMX_GRAPH_COPY_OK || copied = 0
        check((cast: (int) (0)), "cross-arena native call copies its complete unit")
        c.lmx_arena_release(@ destination)
        return
    ---
    method: c.lmx_arena_ref_struct(copied, slot)
    original: c.lmx_arena_ref_struct(graph, slot)
    if: method = 0 || method\native = 0
        check((cast: (int) (0)), "cross-arena native call selects a copied compiled method")
        c.lmx_arena_release(@ destination)
        return
    ---
    source_head: c.lmx_source_name_get(source, (cast: (@: void) original))
    copied_head: c.lmx_source_name_get(@ destination, (cast: (@: void) method))
    check((cast: (int) ((source_head = 0 && copied_head = 0) || (source_head != 0 && copied_head != 0 && source_head\size = copied_head\size && (source_head\size = 0U || c.memcmp(source_head\data, copied_head\data, source_head\size) = 0)))), "copied method keeps its external receiver-head name")
    source_field: c.lmx_source_name_get(source, (cast: (@: void) c.lmx_arena_ref_cell(graph, slot)))
    copied_field: c.lmx_source_name_get(@ destination, (cast: (@: void) c.lmx_arena_ref_cell(copied, slot)))
    check((cast: (int) ((source_field = 0 && copied_field = 0) || (source_field != 0 && copied_field != 0 && source_field\size = copied_field\size && (source_field\size = 0U || c.memcmp(source_field\data, copied_field\data, source_field\size) = 0)))), "copied method keeps its external owning-field name")
    source_before: shape_arena_cells(source)
    destination_before: shape_arena_cells(@ destination)
    check((cast: (int) (c.lmx_call0(@ destination, method, @ result) = 0)), "copied native method returns status separately from value")
    check((cast: (int) (result = expected)), "copied native method returns the expected result")
    check((cast: (int) (shape_arena_cells(source) = source_before)), "copied native method leaves its source arena untouched")
    check((cast: (int) (shape_arena_cells(@ destination) > destination_before)), "copied native method allocates its merge in the destination arena")
    c.lmx_arena_release(@ destination)
    return
end: shape_copy_native_call

fn: driver_program (@: arena c.LmxArena; @: graph c.Lmx; @: settings c.Lmx) int
    @: graph_fields c.VoidArray 0
    graph_fields: 0
    if: graph != 0
        graph_fields: @ graph\array
    ---
    @: builds_cell int (cast: (@: int) (@ c.builds))
    @: build_rc_cell int (cast: (@: int) (@ c.build_rc))
    const: @@(phase_cell char (cast: (const: @@(char)) (@ c.phase)))
    @@: post_paths_arena_cell c.LmxArena (cast: (@@: c.LmxArena) (@ c.post_paths_arena))
    @@: post_paths_graph_cell c.Lmx (cast: (@@: c.Lmx) (@ c.post_paths_graph))
    @: gargc_cell int (cast: (@: int) (@ c.gargc))
    @@@: gargv_cell char (cast: (@@@: char) (@ c.gargv))
    @: graph_mutation_requested_cell int (cast: (@: int) (@ c.graph_mutation_requested))
    @: failures_cell int (cast: (@: int) (@ c.failures))
    @: graph_mutation_baseline_ok_cell int (cast: (@: int) (@ c.graph_mutation_baseline_ok))
    @: pointer_abi_mutation_requested_cell int (cast: (@: int) (@ c.pointer_abi_mutation_requested))
    @: graph_mutation_setup_failures_cell int (cast: (@: int) (@ c.graph_mutation_setup_failures))
    @: graph_mutation_setup_ok_cell int (cast: (@: int) (@ c.graph_mutation_setup_ok))
    @: graph_mutation_shape_failures_cell int (cast: (@: int) (@ c.graph_mutation_shape_failures))
    @: graph_mutation_compared_cell int (cast: (@: int) (@ c.graph_mutation_compared))
    @: stop_walk_caller_cell int (cast: (@: int) (@ c.stop_walk_caller))
    @: dispatch_throws_cell int (cast: (@: int) (@ c.dispatch_throws))
    int: rc
    int: before
    int: observed
    int: mutation_rc
    int: at 2
    int: walkroot 0
    size_t: i 0U
    size_t: k
    int: steps 0
    int: copy_at 2
    @: copied c.Lmx 0
    @: child void 0
    @: head void 0
    size_t: ci 0U
    builds_cell[0]: builds_cell[0] + 1
    rc: c.l2_program_build(arena, graph, settings)
    build_rc_cell[0]: rc
    phase_cell[0]: "R0's program"
    if: rc = 0
        post_paths_arena_cell[0]: arena
        post_paths_graph_cell[0]: graph
        inspect(arena, graph)
        while: at < gargc_cell[0]
            if: c.strcmp(gargv_cell[0][at], "source-add-count") = 0
                check((cast: (int) (at + 3 < gargc_cell[0])), "source-add-count supplies two operands and its occurrence count")
                if: at + 3 < gargc_cell[0]
                    copied: 0
                    observed: shape_add_owner(arena, graph, arg(at + 1), arg(at + 2), @ copied)
                    check((cast: (int) (observed = arg(at + 3))), "owned source-container count equals the expected construction views")
                ---
                at: at + 3
            ---
            at: at + 1
        ---
        at: 2
        # `copy` after endshape: the same shape must hold on a distinct copy of the unit.
        while: copy_at < gargc_cell[0]
            if: c.strcmp(gargv_cell[0][copy_at], "copy") = 0
                if: c.lmx_graph_copy_owned(graph, arena, arena, @ copied) != c.LMX_GRAPH_COPY_OK || copied = 0 || copied = graph
                    check((cast: (int) (0)), "copy keeps a distinct graph")
                if: copied != 0 && copied != graph
                    shape_check(arena, copied, settings)
                ---
            ---
            if: c.strcmp(gargv_cell[0][copy_at], "copycall") = 0 && copy_at + 2 < gargc_cell[0]
                shape_copy_native_call(arena, graph, (cast: (size_t) arg(copy_at + 1)), arg(copy_at + 2))
            ---
            if: c.strcmp(gargv_cell[0][copy_at], "merge") = 0
                shape_merge_holder(arena, graph)
            if: c.strcmp(gargv_cell[0][copy_at], "mergenest") = 0
                shape_merge_nest(arena, graph)
            ---
            copy_at: copy_at + 1
        ---
        if: graph_mutation_requested_cell[0] != 0
            phase_cell[0]: "graph shape baseline"
            before: failures_cell[0]
            observed: shape_check(arena, graph, settings)
            graph_mutation_baseline_ok_cell[0]: observed != 0 && failures_cell[0] = before
            phase_cell[0]: "graph mutation setup"
            before: failures_cell[0]
            if: pointer_abi_mutation_requested_cell[0] = 0
                mutation_rc: shape_mutate(arena, graph)
                graph_mutation_setup_failures_cell[0]: failures_cell[0] - before
                graph_mutation_setup_ok_cell[0]: mutation_rc != 0 && failures_cell[0] = before
            ---
        ---
        check((cast: (int) (shape_dump_graph_events(arena, graph) = 0)), "optional physical graph event dump completed")
        phase_cell[0]: "graph shape comparison"
        before: failures_cell[0]
        shape_check(arena, graph, settings)
        graph_mutation_shape_failures_cell[0]: failures_cell[0] - before
        graph_mutation_compared_cell[0]: 1
        # The comparison is already complete. Publish its evidence before
        # executing the mutated program: graph-backed native evaluation may
        # now reject malformed code with X1 instead of returning to this driver.
        if: graph_mutation_requested_cell[0] != 0
            c.printf("l2_eternal_driver: graph_shape_preflight mutation=%d baseline=%d setup=%d compared=%d setup_failures=%d shape_failures=%d other_failures=%d\n", graph_mutation_requested_cell[0], graph_mutation_baseline_ok_cell[0], graph_mutation_setup_ok_cell[0], graph_mutation_compared_cell[0], graph_mutation_setup_failures_cell[0], graph_mutation_shape_failures_cell[0], failures_cell[0] - graph_mutation_setup_failures_cell[0] - graph_mutation_shape_failures_cell[0])
            c.fflush(c.l1_stdout())
        ---
        phase_cell[0]: "R0's program"
        while: at + 1 < gargc_cell[0]
            if: c.strcmp(gargv_cell[0][at], "stopwalk") = 0
                stop_walk_caller_cell[0]: arg(at + 1)
            at: at + 1
        ---
        at: 2
        while: at + 1 < gargc_cell[0]
            if: c.strcmp(gargv_cell[0][at], "walkroot") = 0
                walkroot: arg(at + 1)
            if: c.strcmp(gargv_cell[0][at], "stopcall") = 0 && at + 8 < gargc_cell[0]
                if: stop_install(arena, graph, at) != 0
                    return: 1
            ---
            if: (c.strcmp(gargv_cell[0][at], "dispatch") = 0 || c.strcmp(gargv_cell[0][at], "dispatchthrow") = 0) && at + 3 < gargc_cell[0]
                dispatch_throws_cell[0]: c.strcmp(gargv_cell[0][at], "dispatchthrow") = 0
                if: dispatch_install(arena, graph, arg(at + 1), arg(at + 2), arg(at + 3)) != 0
                    return: 1
            ---
            at: at + 1
        ---
        if: walkroot != 0
            # Test-only dispatch change, after the unmodified production builder.
            # The host still calls the ordinary native-or-walker dispatch.
            check((cast: (int) (graph\native != 0)), "WalkRoot starts with a compiled native root")
            check((cast: (int) (graph != 0 && c.lmx_domain_kind(arena, graph) = c.LMX_KIND_STRUCT)), "WalkRoot has the program's actual source graph")
            while: i < graph_fields\size
                child: c.lmx_arena_ref_value(graph, i)
                head: child
                if: child != 0 && c.lmx_domain_kind(arena, child) = c.LMX_KIND_STRUCT
                    head: c.lmx_arena_ref_value((cast: (@: c.Lmx) child), 0U)
                if: shape_node_op(child, arena) >= 0
                    steps: steps + 1
                ---
                i: i + 1U
            ---
            check((cast: (int) (steps > 0)), "WalkRoot executes a nonempty physical root operator graph")
            graph\native: 0
            check((cast: (int) (graph\native = 0)), "WalkRoot clears only the root native word")
        ---
    ---
    return: rc
end: driver_program

fn: driver_before_turn (@: root c.LmxRoot; @: r0 c.LmxMsg) int
    @: pointer_abi_mutation_requested_cell int (cast: (@: int) (@ c.pointer_abi_mutation_requested))
    const: @@(phase_cell char (cast: (const: @@(char)) (@ c.phase)))
    @: failures_cell int (cast: (@: int) (@ c.failures))
    @: graph_mutation_setup_failures_cell int (cast: (@: int) (@ c.graph_mutation_setup_failures))
    @: graph_mutation_setup_ok_cell int (cast: (@: int) (@ c.graph_mutation_setup_ok))
    @: l2_ref_active_cell int (cast: (@: int) (@ c.l2_ref_active))
    @@: l2_ref_peer_arena_cell c.LmxArena (cast: (@@: c.LmxArena) (@ c.l2_ref_peer_arena))
    @@: l2_ref_peer_cell c.LmxMsg (cast: (@@: c.LmxMsg) (@ c.l2_ref_peer))
    @@: l2_ref_peer_mail_cell c.LmxPost (cast: (@@: c.LmxPost) (@ c.l2_ref_peer_mail))
    @@: l2_ref_parent_addr_cell void (cast: (@@: void) (@ c.l2_ref_parent_addr))
    @: peer_slot c.LmxSchedule 0
    @: peer_thread c.LmxThread 0
    @: peer_graph c.Lmx 0
    @: letter_arena c.LmxArena 0
    @: executing c.LmxThread (cast: (@: c.LmxThread) r0)
    @: membership void c.lmx_thread_children(executing)
    int: mutation_rc 0
    int: before 0
    if: pointer_abi_mutation_requested_cell[0] != 0
        # Allocate the incompatible cell only after Thread construction. Otherwise its deliberately wrong ABI
        # is correctly refused by the host's construction check, before the promised entry read is reachable.
        phase_cell[0]: "graph mutation setup"
        before: failures_cell[0]
        mutation_rc: shape_mutate((cast: (@: c.LmxArena) executing\slot\arena), (cast: (@: c.Lmx) r0\graph))
        graph_mutation_setup_failures_cell[0]: failures_cell[0] - before
        graph_mutation_setup_ok_cell[0]: mutation_rc != 0 && failures_cell[0] = before
        if: graph_mutation_setup_ok_cell[0] = 0
            return: 1
        ---
        if: l2_ref_active_cell[0] = 0
            return: 0
        ---
    ---
    check((cast: (int) (executing != 0 && membership != 0)), "R0 construction completed its record-owned membership List")
    if: executing != 0 && executing\slot != 0
        check((cast: (int) (c.lmx_range_classify(executing\slot\arena, membership) = c.LMX_KIND_LIST && c.lmx_range_type_of(executing\slot\arena, membership) = c.LMX_TYPE_ARRAY_OF_POINTER_BASE + c.LMX_DOMAIN_THREAD && c.lmx_range_home(executing\slot\arena, membership) = executing\slot\arena)), "membership has its exact List type and Thread owner arena")
        check((cast: (int) (membership != (cast: (@: void) c.lmx_thread_children(root\thread)))), "host and R0 do not share a membership set")
    ---
    @: letter c.LmxMsg 0
    @: letter_graph c.Lmx 0
    @: payload c.Lmx 0
    @: ncell void 0
    @: sender_cell void 0
    int: st
    if: root = 0 || r0 = 0 || l2_ref_peer_arena_cell[0] = 0
        return: 1
    ---
    c.memset((cast: (@: void) l2_ref_peer_arena_cell[0]), 0, c.sizeof(c.LmxArena))
    if: c.lmx_arena_open(l2_ref_peer_arena_cell[0]) != 0
        return: 1
    ---
    l2_ref_peer_cell[0]: (cast: (@: c.LmxMsg) c.lmx_arena_take(l2_ref_peer_arena_cell[0], c.sizeof(c.LmxThread), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_THREAD))
    l2_ref_peer_mail_cell[0]: (cast: (@: c.LmxPost) c.lmx_arena_take(l2_ref_peer_arena_cell[0], c.sizeof(c.LmxPost), c.LMX_DOMAIN_KIND_POST, c.LMX_DOMAIN_POST))
    peer_slot: (cast: (@: c.LmxSchedule) c.lmx_arena_take(l2_ref_peer_arena_cell[0], c.sizeof(c.LmxSchedule), c.LMX_DOMAIN_KIND_SCHEDULE, c.LMX_DOMAIN_SCHEDULE))
    peer_thread: (cast: (@: c.LmxThread) l2_ref_peer_cell[0])
    if: l2_ref_peer_cell[0] = 0 || l2_ref_peer_mail_cell[0] = 0 || peer_slot = 0
        return: 1
    ---
    peer_graph: c.lmx_node_new_owned(l2_ref_peer_arena_cell[0])
    if: peer_graph = 0 || c.lmx_arena_refs_open_owned(l2_ref_peer_arena_cell[0], peer_graph, 2U) != 0
        return: 1
    ---
    if: c.lmx_post_init(l2_ref_peer_arena_cell[0], l2_ref_peer_mail_cell[0]) != c.LMX_POST_OK
        return: 1
    ---
    if: c.lmx_schedule_init(peer_slot, l2_ref_peer_arena_cell[0], (cast: (@: void) peer_thread), 120000U) != c.LMX_SCHEDULE_OK
        return: 1
    ---
    if: c.lmx_thread_init(l2_ref_peer_arena_cell[0], peer_thread, peer_graph, l2_ref_peer_mail_cell[0], peer_slot) != c.LMX_THREAD_OK
        return: 1
    ---
    if: c.lmx_service_register(c.lmx_root_service(root), peer_thread, l2_ref_peer_arena_cell[0]) != c.LMX_SERVICE_OK
        return: 1
    ---
    l2_ref_parent_addr_cell[0]: (cast: (@: void) c.lmx_thread_parent((cast: (@: c.LmxThread) r0)))
    letter_arena: (cast: (@: c.LmxArena) c.calloc(1U, c.sizeof(c.LmxArena)))
    if: letter_arena = 0 || c.lmx_arena_open(letter_arena) != 0
        return: 1
    ---
    letter: (cast: (@: c.LmxMsg) c.lmx_arena_take(letter_arena, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))
    letter_graph: c.lmx_node_new_owned(letter_arena)
    payload: c.lmx_node_new_owned(letter_arena)
    ncell: c.lmx_int_new_owned(letter_arena)
    if: letter = 0 || letter_graph = 0 || payload = 0 || ncell = 0
        return: 1
    ---
    if: c.lmx_arena_refs_open_owned(letter_arena, letter_graph, 2U) != 0 || c.lmx_arena_refs_open_owned(letter_arena, payload, 1U) != 0
        return: 1
    ---
    if: c.lmx_int_store_known(ncell, 1) != 0 || c.lmx_arena_ref_store(payload, 0U, ncell) != 0
        return: 1
    ---
    # The sender is a pointer cell holding the peer's own address (author's Q26.2 ruling -- the
    # same shape lmx_root_launch_tapped now builds mainArgs's own sender with).
    sender_cell: c.lmx_pointer_new_owned(c.LMX_TYPE_MSG_REF, letter_arena)
    if: sender_cell = 0 || c.lmx_pointer_store_known(sender_cell, (cast: (@: void) l2_ref_peer_cell[0])) != 0
        return: 1
    ---
    if: c.lmx_arena_ref_store(letter_graph, 0U, sender_cell) != 0 || c.lmx_arena_ref_store(letter_graph, 1U, (cast: (@: void) payload)) != 0
        return: 1
    ---
    letter\running: 1
    letter\success: 0
    letter\handoff_ready: 0
    letter\graph: letter_graph
    st: c.lmx_service_post(c.lmx_root_service(root), (cast: (@: void) r0), letter, letter_arena)
    return: (cast: (int) (st != c.LMX_SERVICE_OK))
end: driver_before_turn

sub: post_log (@: arena c.LmxArena; @: letter c.LmxMsg)
    @: g_fields c.VoidArray 0
    @: p_fields c.VoidArray 0
    @: t_fields c.VoidArray 0
    @: post_log_n_cell int (cast: (@: int) (@ c.post_log_n))
    @: g c.Lmx 0
    @: p c.Lmx 0
    @: v void 0
    @: t c.LmxArray 0
    size_t: j 0U
    post_log_n_cell[0]: post_log_n_cell[0] + 1
    c.printf("post %d:", post_log_n_cell[0])
    if: letter != 0
        g: letter\graph
        g_fields: 0
        if: g != 0
            g_fields: @ g\array
        ---
    ---
    if: g != 0 && g_fields\size >= 2U && c.lmx_range_classify(arena, c.lmx_arena_ref_value(g, 1U)) = c.LMX_KIND_STRUCT
        p: c.lmx_arena_ref_struct(g, 1U)
        p_fields: 0
        if: p != 0
            p_fields: @ p\array
        ---
    ---
    if: p = 0
        c.printf(" not a letter")
    ---
    while: p != 0 && j < p_fields\size
        v: c.lmx_arena_ref_value(p, j)
        if: v != 0 && c.lmx_domain_type(arena, v) = c.LMX_TYPE_INT
            c.printf(" %d", c.lmx_int_value_known(v))
        else:
            if: v != 0 && c.lmx_domain_type(arena, v) = c.LMX_TYPE_ARRAY_OF_CHAR
                t: (cast: (@: c.LmxArray) v)
                t_fields: 0
                if: t != 0
                    t_fields: @ t\array
                ---
                c.printf(" \"%.*s\"", (cast: (int) t_fields\size), (cast: (@: char) t_fields\data))
            else:
                c.printf(" ?")
            ---
        ---
        j: j + 1
    ---
    c.printf("\n")
end: post_log

fn: driver_service_post (@: service c.LmxService; @: address void; @: letter c.LmxMsg; @: letter_arena c.LmxArena) int
    const: @@(phase_cell char (cast: (const: @@(char)) (@ c.phase)))
    @: post_paths_requested_cell int (cast: (@: int) (@ c.post_paths_requested))
    @: post_paths_seen_cell int (cast: (@: int) (@ c.post_paths_seen))
    @@: post_paths_arena_cell c.LmxArena (cast: (@@: c.LmxArena) (@ c.post_paths_arena))
    @@: post_paths_graph_cell c.Lmx (cast: (@@: c.Lmx) (@ c.post_paths_graph))
    @@: l2_ref_peer_cell c.LmxMsg (cast: (@@: c.LmxMsg) (@ c.l2_ref_peer))
    @: l2_ref_reply_to_sender_cell int (cast: (@: int) (@ c.l2_ref_reply_to_sender))
    @@: l2_ref_parent_addr_cell void (cast: (@@: void) (@ c.l2_ref_parent_addr))
    @: l2_ref_reply_to_parent_cell int (cast: (@: int) (@ c.l2_ref_reply_to_parent))
    @: post_log_requested_cell int (cast: (@: int) (@ c.post_log_requested))
    int: st
    const: (@: saved_phase char phase_cell[0])
    if: post_paths_requested_cell[0] != 0 && post_paths_seen_cell[0] = 0
        post_paths_seen_cell[0]: post_paths_seen_cell[0] + 1
        phase_cell[0]: "generated program post paths"
        check((cast: (int) (post_paths_arena_cell[0] != 0 && post_paths_graph_cell[0] != 0)), "postpaths observes the actual completed builder graph before its release")
        if: post_paths_arena_cell[0] != 0 && post_paths_graph_cell[0] != 0
            check((cast: (int) (shape_paths_check(post_paths_arena_cell[0], post_paths_graph_cell[0], 1) != 0)), "postpaths completes its selected physical observations")
        ---
        phase_cell[0]: saved_phase
    ---
    if: l2_ref_peer_cell[0] != 0 && address = (cast: (@: void) l2_ref_peer_cell[0])
        l2_ref_reply_to_sender_cell[0]: l2_ref_reply_to_sender_cell[0] + 1
    ---
    if: l2_ref_parent_addr_cell[0] != 0 && address = l2_ref_parent_addr_cell[0]
        l2_ref_reply_to_parent_cell[0]: l2_ref_reply_to_parent_cell[0] + 1
    ---
    if: post_log_requested_cell[0] != 0
        post_log(letter_arena, letter)
    ---
    st: c.lmx_service_post(service, address, letter, letter_arena)
    if: st = c.LMX_SERVICE_OK && l2_ref_peer_cell[0] != 0 && address = (cast: (@: void) l2_ref_peer_cell[0])
        c.lmx_service_unregister(service, (cast: (@: c.LmxThread) l2_ref_peer_cell[0]))
    ---
    return: st
end: driver_service_post

fn: driver_root_launch (@: root c.LmxRoot; int: argc; @@: argv char; c.LmxRootProgram: program; size_t: fields; c.LmxRootSettings: settings; ulong: limit; @: out void; @: err void) int
    @: launches_cell int (cast: (@: int) (@ c.launches))
    @: program_passed_cell int (cast: (@: int) (@ c.program_passed))
    @: l2_ref_active_cell int (cast: (@: int) (@ c.l2_ref_active))
    @: pointer_abi_mutation_requested_cell int (cast: (@: int) (@ c.pointer_abi_mutation_requested))
    @: walk_thrown_cell int (cast: (@: int) (@ c.walk_thrown))
    @: host_state_cell int (cast: (@: int) (@ c.host_state))
    @: r0_stopped_cell int (cast: (@: int) (@ c.r0_stopped))
    int: code
    @: cap void 0
    @: text char 0
    size_t: n 0U
    launches_cell[0]: launches_cell[0] + 1
    if: program = c.l2_program_build
        program_passed_cell[0]: 1
    ---
    # The host's stderr goes through a file of the driver's own, so the driver reads what the host
    # reported and then hands it on to the stream main gave.
    cap: (cast: (@: void) c.fopen("l2_driver_launch.err", "w+b"))
    if: cap = 0
        cap: err
    ---
    if: l2_ref_active_cell[0] != 0 || pointer_abi_mutation_requested_cell[0] != 0
        code: c.lmx_root_launch_result(root, argc, argv, c.l2_driver_program, fields, settings, limit, c.l2_driver_before_turn, out, cap, @ walk_thrown_cell[0])
    else:
        code: c.lmx_root_launch_result(root, argc, argv, c.l2_driver_program, fields, settings, limit, 0, out, cap, @ walk_thrown_cell[0])
    ---
    host_state_cell[0]: c.lmx_root_state(root)
    r0_stopped_cell[0]: 0
    if: cap != err
        c.fflush(cap)
        c.rewind(cap)
        text: (cast: (@: char) c.calloc(65536U, 1U))
        if: text != 0
            n: c.fread((cast: (@: void) text), 1U, 65535U, cap)
            text[n]: 0
            if: c.strstr(text, "R0 was stopped") != 0
                r0_stopped_cell[0]: 1
            ---
            if: err != 0 && n != 0U
                c.fwrite((cast: (@: void) text), 1U, n, err)
            ---
            c.free((cast: (@: void) text))
        ---
        c.fclose(cap)
    ---
    return: code
end: driver_root_launch

fn: driver_merge_owned (@@: operands c.Lmx; size_t: count; @: body c.Lmx; @: src_arena c.LmxArena; @: dst_arena c.LmxArena; @@: overrides c.LmxMergePair; size_t: override_count; @@: out c.Lmx) int
    @: merge_calls_cell int (cast: (@: int) (@ c.merge_calls))
    @: merge_fail_at_cell int (cast: (@: int) (@ c.merge_fail_at))
    int: status
    merge_calls_cell[0]: merge_calls_cell[0] + 1
    if: merge_fail_at_cell[0] > 0 && merge_calls_cell[0] = merge_fail_at_cell[0]
        if: out != 0
            out[0]: 0
        ---
        return: c.LMX_MERGE_NOMEM
    ---
    status: c.lmx_merge_owned(operands, count, body, src_arena, dst_arena, overrides, override_count, out)
    if: status = 0 && out != 0
        inspect_merge(operands, count, out[0], src_arena, dst_arena)
    return: status
end: driver_merge_owned

fn: driver_merge_profiles_owned (@@: operands c.Lmx; size_t: count; @: body c.Lmx; @: src_arena c.LmxArena; @: dst_arena c.LmxArena; @@: retain_profiles c.Lmx; size_t: retain_count; @@: overrides c.LmxMergePair; size_t: override_count; @@: out c.Lmx) int
    @: merge_calls_cell int (cast: (@: int) (@ c.merge_calls))
    @: merge_fail_at_cell int (cast: (@: int) (@ c.merge_fail_at))
    int: status
    merge_calls_cell[0]: merge_calls_cell[0] + 1
    if: merge_fail_at_cell[0] > 0 && merge_calls_cell[0] = merge_fail_at_cell[0]
        if: out != 0
            out[0]: 0
        ---
        return: c.LMX_MERGE_NOMEM
    ---
    status: c.lmx_merge_profiles_owned(operands, count, body, src_arena, dst_arena, retain_profiles, retain_count, overrides, override_count, out)
    if: status = 0 && out != 0
        inspect_merge(operands, count, out[0], src_arena, dst_arena)
    return: status
end: driver_merge_profiles_owned

fn: driver_merge_used_owned (@@: operands c.Lmx; size_t: count; @: body c.Lmx; @: src_arena c.LmxArena; @: dst_arena c.LmxArena; @@: retain_profiles c.Lmx; size_t: retain_count; @@: use_anchor c.Lmx; @: use_sel size_t; @: use_slot size_t; @: use_len size_t; size_t: use_count; size_t: use_slots; @@: overrides c.LmxMergePair; size_t: override_count; @@: out c.Lmx) int
    @: merge_calls_cell int (cast: (@: int) (@ c.merge_calls))
    @: merge_fail_at_cell int (cast: (@: int) (@ c.merge_fail_at))
    int: status
    merge_calls_cell[0]: merge_calls_cell[0] + 1
    if: merge_fail_at_cell[0] > 0 && merge_calls_cell[0] = merge_fail_at_cell[0]
        if: out != 0
            out[0]: 0
        ---
        return: c.LMX_MERGE_NOMEM
    ---
    status: c.lmx_merge_used_owned(operands, count, body, src_arena, dst_arena, retain_profiles, retain_count, use_anchor, use_sel, use_slot, use_len, use_count, use_slots, overrides, override_count, out)
    if: status = 0 && out != 0
        inspect_merge(operands, count, out[0], src_arena, dst_arena)
    return: status
end: driver_merge_used_owned

fn: main (int: argc; @@: argv char) int
    @: gargc_cell int (cast: (@: int) (@ c.gargc))
    @@@: gargv_cell char (cast: (@@@: char) (@ c.gargv))
    @: pargc_cell int (cast: (@: int) (@ c.pargc))
    @@@: pargv_cell char (cast: (@@@: char) (@ c.pargv))
    @: merge_facts_expected_cell int (cast: (@: int) (@ c.merge_facts_expected))
    @: graph_mutation_requested_cell int (cast: (@: int) (@ c.graph_mutation_requested))
    @: pointer_abi_mutation_requested_cell int (cast: (@: int) (@ c.pointer_abi_mutation_requested))
    @: post_paths_requested_cell int (cast: (@: int) (@ c.post_paths_requested))
    @: profile_complete_requested_cell int (cast: (@: int) (@ c.profile_complete_requested))
    @: post_log_requested_cell int (cast: (@: int) (@ c.post_log_requested))
    @: merge_fail_at_cell int (cast: (@: int) (@ c.merge_fail_at))
    @: l2_ref_active_cell int (cast: (@: int) (@ c.l2_ref_active))
    @@: l2_ref_peer_arena_cell c.LmxArena (cast: (@@: c.LmxArena) (@ c.l2_ref_peer_arena))
    const: @@(phase_cell char (cast: (const: @@(char)) (@ c.phase)))
    @: launches_cell int (cast: (@: int) (@ c.launches))
    @: program_passed_cell int (cast: (@: int) (@ c.program_passed))
    @: builds_cell int (cast: (@: int) (@ c.builds))
    @: build_rc_cell int (cast: (@: int) (@ c.build_rc))
    @: host_state_cell int (cast: (@: int) (@ c.host_state))
    @: merge_calls_cell int (cast: (@: int) (@ c.merge_calls))
    @: merge_facts_seen_cell int (cast: (@: int) (@ c.merge_facts_seen))
    @: profile_complete_seen_cell int (cast: (@: int) (@ c.profile_complete_seen))
    @: post_paths_seen_cell int (cast: (@: int) (@ c.post_paths_seen))
    @@: dispatch_arena_cell c.LmxArena (cast: (@@: c.LmxArena) (@ c.dispatch_arena))
    @: dispatch_calls_cell int (cast: (@: int) (@ c.dispatch_calls))
    @@: stop_caller_cell c.Lmx (cast: (@@: c.Lmx) (@ c.stop_caller))
    @: stop_calls_cell int (cast: (@: int) (@ c.stop_calls))
    @: stop_root_returns_cell int (cast: (@: int) (@ c.stop_root_returns))
    @: stop_late_calls_cell int (cast: (@: int) (@ c.stop_late_calls))
    @: stop_receiver_calls_cell int (cast: (@: int) (@ c.stop_receiver_calls))
    @: walk_thrown_cell int (cast: (@: int) (@ c.walk_thrown))
    @: r0_stopped_cell int (cast: (@: int) (@ c.r0_stopped))
    @: l2_ref_reply_to_sender_cell int (cast: (@: int) (@ c.l2_ref_reply_to_sender))
    @: l2_ref_reply_to_parent_cell int (cast: (@: int) (@ c.l2_ref_reply_to_parent))
    @: graph_mutation_shape_failures_cell int (cast: (@: int) (@ c.graph_mutation_shape_failures))
    @: graph_mutation_baseline_ok_cell int (cast: (@: int) (@ c.graph_mutation_baseline_ok))
    @: graph_mutation_setup_ok_cell int (cast: (@: int) (@ c.graph_mutation_setup_ok))
    @: graph_mutation_compared_cell int (cast: (@: int) (@ c.graph_mutation_compared))
    @: graph_mutation_setup_failures_cell int (cast: (@: int) (@ c.graph_mutation_setup_failures))
    @: failures_cell int (cast: (@: int) (@ c.failures))
    @: checks_cell int (cast: (@: int) (@ c.checks))
    int: status
    int: expected 0
    int: letters -1
    int: fails 0
    int: stopped -1
    int: thrown -1
    int: at 2
    int: dash 0
    int: k 0
    gargc_cell[0]: argc
    gargv_cell[0]: argv
    if: argc < 2
        c.fputs("l2_eternal_driver: expected number of roots missing\n", c.l1_stdout())
        return: 2
    ---
    # THE PROGRAM'S ARGV (S3).  Words after `--` are the program's arguments; its argv[0] is this
    # process's own, and the facts end at `--`.  C main posts them to R0 inside a letter.
    while: dash < argc && c.strcmp(argv[dash], "--") != 0
        dash: dash + 1
    ---
    gargc_cell[0]: dash
    pargc_cell[0]: 1
    if: dash < argc
        pargc_cell[0]: argc - dash
    ---
    pargv_cell[0]: (cast: (@@: char) c.calloc((cast: (size_t) (pargc_cell[0] + 1)), sizeof(@: char)))
    if: pargv_cell[0] = 0
        c.fputs("l2_eternal_driver: out of memory\n", c.l1_stdout())
        return: 2
    ---
    pargv_cell[0][0]: argv[0]
    k: 1
    while: k < pargc_cell[0]
        pargv_cell[0][k]: argv[dash + k]
        k: k + 1
    ---
    # The exit (author 2026-09-24): the launch's exit code is R0's exit letter's, else the mapping of
    # R0's success (1 -> 0, 0 -> 1).  `entry N` names it (default 0).  `fails 1`: R0 does not
    # complete -- an uncaught failure -- so the exit is 1.  `mergefail N` fails the program's Nth
    # merge (the tap above).  `thrown N`: the throw number the walk noted, which the turn's channel
    # carries (0: none).  `stopped 1|0`: R0 was stopped, or not, as the host's exit reason says.
    # `letters N` was read at R0's close, which is the host's now: a row that names it is red.
    while: at + 1 < gargc_cell[0]
        if: merge_fact_width(argv[at]) != 0
            check((cast: (int) (at + merge_fact_width(argv[at]) <= gargc_cell[0])), "merge fact has all its arguments")
            merge_facts_expected_cell[0]: merge_facts_expected_cell[0] + 1
            at: at + merge_fact_width(argv[at])
            continue
        ---
        if: c.strcmp(argv[at], "entry") = 0
            expected: arg(at + 1)
        ---
        if: c.strcmp(argv[at], "mutate") = 0
            graph_mutation_requested_cell[0]: 1
            if: at + 1 < gargc_cell[0] && (c.strcmp(argv[at + 1], "replace-pointer-abi") = 0 || c.strcmp(argv[at + 1], "replace-pointer-abi-pair") = 0)
                pointer_abi_mutation_requested_cell[0]: 1
            ---
        ---
        if: c.strcmp(argv[at], "postpaths") = 0
            post_paths_requested_cell[0]: 1
        ---
        if: c.strcmp(argv[at], "profilecomplete") = 0
            profile_complete_requested_cell[0]: 1
        ---
        if: c.strcmp(argv[at], "postlog") = 0
            post_log_requested_cell[0]: arg(at + 1)
        ---
        if: c.strcmp(argv[at], "letters") = 0
            letters: arg(at + 1)
        ---
        if: c.strcmp(argv[at], "fails") = 0
            fails: arg(at + 1)
        ---
        if: c.strcmp(argv[at], "mergefail") = 0
            merge_fail_at_cell[0]: arg(at + 1)
        ---
        if: c.strcmp(argv[at], "stopped") = 0
            stopped: arg(at + 1)
        ---
        if: c.strcmp(argv[at], "thrown") = 0
            thrown: arg(at + 1)
        ---
        if: c.strcmp(argv[at], "ref") = 0 && arg(at + 1) != 0
            l2_ref_active_cell[0]: 1
        ---
        at: at + 1
    ---
    if: l2_ref_active_cell[0] != 0
        l2_ref_peer_arena_cell[0]: (cast: (@: c.LmxArena) c.calloc(1U, c.sizeof(c.LmxArena)))
        if: l2_ref_peer_arena_cell[0] = 0
            c.fputs("l2_eternal_driver: out of memory\n", c.l1_stdout())
            return: 2
        ---
    ---
    phase_cell[0]: "generated program"
    status: c.l2_generated_main(pargc_cell[0], pargv_cell[0])
    check((cast: (int) (launches_cell[0] = 1)), "generated main launched the host exactly once")
    check((cast: (int) (program_passed_cell[0] = 1)), "generated main handed the host its generated program builder")
    check((cast: (int) (builds_cell[0] = 1 && build_rc_cell[0] = 0)), "the host built R0's program exactly once, and the builder succeeded")
    check((cast: (int) (host_state_cell[0] = c.LMX_ROOT_CLOSED)), "the launch closed the host")
    phase_cell[0]: "exit"
    if: fails = 0
        check((cast: (int) (status = expected)), "the launch's exit code is the expected one: R0's exit letter, or its success")
    else:
        check((cast: (int) (status = 1)), "a failed R0 leaves the launch with exit 1")
    ---
    if: fails = 0 && status != expected
        c.printf("l2_eternal_driver: exit %d, expected %d\n", status, expected)
    ---
    if: merge_fail_at_cell[0] > 0
        check((cast: (int) (merge_calls_cell[0] >= merge_fail_at_cell[0])), "the program made the merge the row fails")
    ---
    check((cast: (int) (merge_facts_seen_cell[0] = merge_facts_expected_cell[0])), "every configured merge observation ran exactly once")
    if: profile_complete_requested_cell[0] != 0
        check((cast: (int) (profile_complete_seen_cell[0] = 1)), "the configured complete-profile observation actually executed exactly once")
    ---
    if: post_paths_requested_cell[0] != 0
        check((cast: (int) (post_paths_seen_cell[0] = 1)), "the configured postpaths observation actually executed exactly once")
    ---
    if: dispatch_arena_cell[0] != 0
        check((cast: (int) (dispatch_calls_cell[0] = 3)), "all three selected native probe calls actually execute")
    ---
    if: stop_caller_cell[0] != 0
        check((cast: (int) (stop_calls_cell[0] = 1 && stop_root_returns_cell[0] = 1)), "the stopped actual and root unwind observations both execute once")
        check((cast: (int) (stop_late_calls_cell[0] = 0 && stop_receiver_calls_cell[0] = 0)), "no later actual or receiver executes after stop")
    ---
    if: thrown >= 0
        check((cast: (int) (walk_thrown_cell[0] = thrown)), "the walk noted the thrown status the row names")
    ---
    if: thrown >= 0 && walk_thrown_cell[0] != thrown
        c.printf("l2_eternal_driver: the walk noted %d, expected %d\n", walk_thrown_cell[0], thrown)
    ---
    if: stopped >= 0
        check((cast: (int) (r0_stopped_cell[0] = stopped)), "the host reports R0 stopped (1) or not (0) as the row names")
    ---
    check((cast: (int) (letters < 0)), "no `letters` fact is named: R0's untaken letters are released at the host's close")
    if: l2_ref_active_cell[0] != 0
        c.printf("reply-to-sender %d\n", l2_ref_reply_to_sender_cell[0])
        c.printf("reply-to-parent %d\n", l2_ref_reply_to_parent_cell[0])
    ---
    if: graph_mutation_requested_cell[0] != 0 || graph_mutation_shape_failures_cell[0] != 0
        c.printf("l2_eternal_driver: graph_shape mutation=%d baseline=%d setup=%d compared=%d setup_failures=%d shape_failures=%d other_failures=%d exit=%d expected=%d\n", graph_mutation_requested_cell[0], graph_mutation_baseline_ok_cell[0], graph_mutation_setup_ok_cell[0], graph_mutation_compared_cell[0], graph_mutation_setup_failures_cell[0], graph_mutation_shape_failures_cell[0], failures_cell[0] - graph_mutation_setup_failures_cell[0] - graph_mutation_shape_failures_cell[0], status, expected)
    ---
    if: failures_cell[0] != 0
        c.printf("l2_eternal_driver: %d failed of %d\n", failures_cell[0], checks_cell[0])
        return: 1
    ---
    c.printf("l2_eternal_driver: %d checks, %d roots\n", checks_cell[0], arg(1))
    return: 0
end: main
