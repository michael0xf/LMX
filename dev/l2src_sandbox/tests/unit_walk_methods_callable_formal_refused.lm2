# Historical filename retained: this used to pin the callable-formal subset
# refusal. The existing whole-occurrence ARG/EXEC route must now execute it,
# with bin and take both walked, not silently kept native.
fn: bin () int
    return: 0

fn: take (bin: op) int
    return: op()

sendMessage: exit(exit_code: take(bin); stdout: ""; stderr: "")
return
