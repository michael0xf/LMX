# Канонический каталог конвертеров. Поля nativeSymbol описывают точки
# реализации; это данные, а не утверждение, что каждый мост уже существует.
# IMPLEMENTED_REFERENCE есть только у функций в соседнем C99-руководстве.
# Остальные REQUIRE_IMPLEMENTATION закрыты для публикации L3 до реализации.
#
BridgeConverters:
    span:
        []char: from "BridgeData\\Buffer + actual Array element type"
        []char: to "bounded native T* / const T*"
        []char: nativeSymbol "lmx_ref_span"
        []char: status "IMPLEMENTED_REFERENCE"
        []char: ownership "synchronous borrow; no resize or retention while borrowed"
        []char: checks "actual element type; offset/count subtraction bounds; size overflow; null for empty only"
    cString:
        []char: from "[]char"
        []char: to "temporary NUL-terminated char*"
        []char: nativeSymbol "lmx_ref_cstring"
        []char: status "IMPLEMENTED_REFERENCE"
        []char: ownership "new temporary allocation; release exactly once after C call"
        []char: checks "embedded NUL rejected; length+1 overflow; encoding contract is separate"
    tensorLayout:
        []char: from "BridgeData\\Tensor with signed i64 element strides"
        []char: to "admitted logical shape and checked reachable element range"
        []char: nativeSymbol "signed-view admission and checked affine-range adapter"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "metadata only; retain actual source view and owner; no new access rights"
        []char: checks "nonzero shape/stride rank; empty axes before products; nonempty shape product; min and max reachable offsets; source-view region before owner bounds; byte extent; actual TypeRef; native width; no signed overflow or abs(MIN)"
    nonnegativeTensorExtent:
        []char: from "nonnegative size_t shape/strides and offset, already admitted to a flat Array"
        []char: to "checked nonnegative affine extent only"
        []char: nativeSymbol "lmx_ref_tensor_extent"
        []char: status "IMPLEMENTED_REFERENCE"
        []char: ownership "metadata only; no ownership transfer"
        []char: checks "the C reference accepts size_t strides; it does not admit signed, reverse, nested-view or byte-stride layouts; it checks shape products, maximal offset, byte extent and empty axes; its caller still admits logical subregion, type and lifetime"
    pcmToFloat:
        []char: from "signed PCM16"
        []char: to "float32 samples in [-1,1)"
        []char: nativeSymbol "lmx_ref_pcm16_to_float"
        []char: status "IMPLEMENTED_REFERENCE"
        []char: ownership "writes caller-provided disjoint output"
        []char: checks "counts; no overlap by caller contract; exact scale 1/32768"
    floatToPcm:
        []char: from "finite float32 samples"
        []char: to "signed PCM16"
        []char: nativeSymbol "lmx_ref_float_to_pcm16"
        []char: status "IMPLEMENTED_REFERENCE"
        []char: ownership "writes caller-provided disjoint output; validate entire input first"
        []char: checks "counts; finite values; explicit clipping; nearest ties away from zero"
    decimalToDecNumber:
        []char: from "decimal (MPDecimal) + explicit decimal context"
        []char: to "decNumber"
        []char: nativeSymbol "lmx_ref_decimal_to_decnumber"
        []char: status "IMPLEMENTED_REFERENCE"
        []char: ownership "separate variable-size decNumber allocation, caller releases"
        []char: checks "capacity from precision; explicit rounding enum conversion; exponent range; decimal flags; exactness"
    decimalFromDecNumber:
        []char: from "decNumber + explicit decimal context"
        []char: to "decimal (MPDecimal)"
        []char: nativeSymbol "lmx_ref_decimal_from_decnumber"
        []char: status "IMPLEMENTED_REFERENCE"
        []char: ownership "new actor-owned numeric payload"
        []char: checks "digits+14 formatting bound; decimal precision/exponent/flags"
    integerText:
        []char: from "bigint (LibTomMath)"
        []char: to "canonical signed base-10 text and back"
        []char: nativeSymbol "lmx_ref_bigint_parse / lmx_ref_bigint_text"
        []char: status "IMPLEMENTED_REFERENCE"
        []char: ownership "new actor-owned numeric payload / caller-freed text"
        []char: checks "strict full-string decimal grammar; allocation; no intermediate double"
    realText:
        []char: from "real (LibBF) + explicit binary precision profile"
        []char: to "exact hexadecimal value text and back"
        []char: nativeSymbol "lmx_ref_real_parse / lmx_ref_real_text"
        []char: status "IMPLEMENTED_REFERENCE"
        []char: ownership "new actor-owned numeric payload / caller-freed text"
        []char: checks "full-string parse; precision/exponent/resource limits; exact-required mode; no double intermediary"
    realToBinary64:
        []char: from "real (LibBF) + explicit rounding profile"
        []char: to "machine IEEE binary64 double"
        []char: nativeSymbol "lmx_ref_real_to_binary64"
        []char: status "IMPLEMENTED_REFERENCE"
        []char: ownership "value copy; output unchanged on rejected narrowing"
        []char: checks "target binary64 layout; precision loss; overflow/underflow; nonfinite policy; mapped conditions"
    alternateNumber:
        []char: from "canonical bigint / decimal / rational / real"
        []char: to "IMath / LibTomMath / LibBF bfdec_t / fixed-format backends"
        []char: nativeSymbol "per-backend exact textual or validated limb-value converter"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "independent backend allocation; canonical model unchanged"
        []char: checks "sign, exponent, coefficient, precision and special values; no mp_int typedef cast; preserve decimal quantum where meaningful"
    fixedPoint:
        []char: from "scalar / Tensor + Quantization profile"
        []char: to "Q16.16 / Q7 / Q15 scaled-integer values"
        []char: nativeSymbol "per-format scaled conversion with explicit overflow handling"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "new fixed-width value or owned Array"
        []char: checks "finite scale>0; zeroPoint and native integer range; rounding/ties; conversion saturation versus error; reserved sentinel; arithmetic saturation is a separate backend capability"
    binaryFloatFormat:
        []char: from "machine scalar / real plus explicit binary-format and numeric context"
        []char: to "IEEE binary16/32/64/128, admitted extended80, or explicitly selected ARM alternative half words"
        []char: nativeSymbol "per-format bit/value conversion and status adapter"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "by-value words or owned packed Array; preserve owner-side rounding and exception state"
        []char: checks "exact encoding and build; exponent/significand width; signed zero; subnormals; supported rounding; overflow/underflow; NaN/Inf availability and payload policy; endianness on byte transfer; no Quantization scale/zeroPoint interpretation or implicit double intermediary"
    randomState:
        []char: from "BridgeData\\RandomState"
        []char: to "explicit-state PCG / xoshiro backend"
        []char: nativeSymbol "per-algorithm seed/state/advance converter"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "one actor-owned mutable state; copy explicitly clones stream position"
        []char: checks "algorithm/version, seed/sequence interpretation, word endian and bounded-random bound>0; no implicit global RNG"
    numericNarrow:
        []char: from "bigint / decimal / real profile / machine integer"
        []char: to "requested machine scalar"
        []char: nativeSymbol "per-destination typed checked adapter"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "by value"
        []char: checks "range; sign; precision; rounding; nonfinite policy; no implicit promotion"
    tensorBackend:
        []char: from "BridgeData\\Tensor plus selected numeric and call profile"
        []char: to "cglm / linmath / liquid-dsp dense / KissFFT / PFFFT / libfixmatrix / Mint / Utensil / KANN / NNoM / embeddings"
        []char: nativeSymbol "per-backend typed pack / unpack adapter"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "borrow only an admitted compatible view; otherwise explicit owned scratch; output commit after successful unpack"
        []char: checks "actual dtype; rank/shape; signed strides and offset; row/column order; alignment; transpose versus adjoint; dimensions/leading dimensions/products fit each native parameter; input/output aliasing; retention; numeric precision and quantization; reverse/broadcast views packed or explicitly rejected"
    complexBackend:
        []char: from "BridgeData\\Complex or ComplexBuffer plus selected scalar profile"
        []char: to "exact native split/interleaved complex representation"
        []char: nativeSymbol "per-backend typed component pack / unpack adapter"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "retain components through synchronous borrow or own packed scratch; matched release of foreign split allocations"
        []char: checks "one actual scalar type/context for both parts; interleaved trailing axis of length 2 or planar leading axis of length 2; logical shape; component order; stride/alignment; native scalar build; no cast of ordinary Structures to C complex; conjugation only when requested"
    sparseMatrixBackend:
        []char: from "BridgeData\\SparseMatrix with zero-based CSR or CSC coordinates"
        []char: to "exact selected backend sparse representation or owned sparse resource"
        []char: nativeSymbol "per-backend checked index/value pack and sparse-resource adapter"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "retain values and index arrays while borrowed; explicit owned pack when native widths/order differ; opaque resources use constructor/fill/owner/destroy"
        []char: checks "rank 2; real Buffer count or ComplexBuffer logical count agrees with nnz; outer+1 pointer length with checked addition; pointers start at zero, are monotone and end at nnz; inner bounds; empty dimensions; native index/count widths; active nnz versus allocated capacity; checked allocation budget; preserve explicit zeros; admit duplicate replacement versus reduction before packing; no silent sorting, duplicate summation, dense materialization or complex-layout cast"
    scientificSelection:
        []char: from "BridgeData\\Hyperslab + Tensor + backend dataset Resource"
        []char: to "HDF5 dataspaces / netCDF start-count-stride-imap / MAT array selections"
        []char: nativeSymbol "per-format checked selection / datatype / pack adapter"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "hold dataset, dataspace and memory owner until operation or asynchronous completion finishes"
        []char: checks "rank; native integer widths; start/count/stride/block bounds and overflow; signed memory strides versus file coordinates; empty selection; memory/file element-count agreement; unlimited dimensions; endian and compound layout; explicit narrowing; no raw struct or datatype-handle cast"
    mpiResource:
        []char: from "BridgeData\\MpiContext + exact-kind Resource + Tensor or Buffer"
        []char: to "backend MPI_Comm / MPI_Info / MPI_Datatype / MPI_Request and MPI_Offset"
        []char: nativeSymbol "owner-side MPI ABI resolve / collective admission / completion adapter"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "same-process references may share one runtime-bound resource under owner and MPI thread-support rules; pending requests retain all buffers until completion"
        []char: checks "exact MPI backend/ABI; initialized and non-finalized runtime; communicator membership; collective ordering and participation; independent versus collective I/O; datatype extent and displacement; count/offset width; no raw handle transport to another process or node"
    imageBackend:
        []char: from "BridgeData\\Image"
        []char: to "stb / QOI / PNG / JPEG / GIF / WebP / renderer pixels"
        []char: nativeSymbol "per-format decode / encode / channel adapter"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "copy decoded pixels into actor-owned Array; matched backend free"
        []char: checks "dimension multiplication; channels; row stride; bit depth; orientation; alpha; colorspace"
    textBackend:
        []char: from "[]char / BridgeData\\ParseNode / ordinary LMX graph"
        []char: to "UTF-8 / JSON / XML / YAML / TOML / Markdown / MessagePack / protobuf"
        []char: nativeSymbol "per-format encoder / decoder"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "retain source during borrowed parser views; own results after return"
        []char: checks "encoding; nesting/resource budget; duplicate keys; null vs absent; number precision; source offsets"
    database:
        []char: from "BridgeData\\DbValue / DbRow / DbRows"
        []char: to "SQLite / BSON / libpq / Redis / xlsx cell"
        []char: nativeSymbol "driver-specific value bind / read"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "copy transient row/value memory before cursor advances; preserve connection owner"
        []char: checks "SQL NULL distinct from absent and empty; lengths; numeric precision; time scale; binary vs text; escaping is not parameter binding"
    callback:
        []char: from "BridgeData\\Callback"
        []char: to "exact-signature C trampoline plus userdata"
        []char: nativeSymbol "one typed trampoline per C callback signature"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "owner retains callable/context until unregister and quiescence"
        []char: checks "same-thread synchronous vs queued foreign-thread event; no direct foreign-arena access; errors returned through C protocol"
    resource:
        []char: from "BridgeData\\Resource"
        []char: to "exact native handle for the selected backend"
        []char: nativeSymbol "owner-side resolve / borrow / close"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "no pointer serialization or cross-actor memcpy; close invalidates outstanding operations"
        []char: checks "owner; resource kind; open state; generation where slots are reused; backend close/free pairing"
    networkAddress:
        []char: from "BridgeData\\NetworkAddress / Uri / DNS name text"
        []char: to "native sockaddr / DNS records / URI components and back"
        []char: nativeSymbol "per-family checked pack / parse / encode"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "temporary typed native storage; owned returned bytes/text"
        []char: checks "family and exact address width; port byte order; IPv6 scope; DNS labels/IDN policy; percent encoding; no sockaddr cast from arbitrary Buffer"
    time:
        []char: from "BridgeData\\Time / CivilTime / Duration"
        []char: to "time_t / struct tm / GPS / Julian / TLE epochs"
        []char: nativeSymbol "per-scale checked conversion"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "by value"
        []char: checks "epoch and scale; instant vs duration; UTC vs monotonic; leap rules; time_t width; explicit zone; month/year offsets"
    coordinates:
        []char: from "BridgeData\\GeoPoint / Vector3 / OrbitState"
        []char: to "geodesic / H3 / shapelib / SGP4 / NMEA"
        []char: nativeSymbol "per-reference-system checked conversion"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "by value / owned Array"
        []char: checks "degrees/radians; longitude/latitude order; km/m; time and reference frame; no guessed reprojection"
    secret:
        []char: from "BridgeData\\Secret / Buffer"
        []char: to "selected cryptographic implementation"
        []char: nativeSymbol "algorithm-specific key / nonce / message adapter"
        []char: status "REQUIRE_IMPLEMENTATION"
        []char: ownership "explicit secret owner; matched zeroing/free; borrowed secrets not copied into diagnostics"
        []char: checks "algorithm and exact key/nonce/tag sizes; no substitution solely because buffers have equal length"
