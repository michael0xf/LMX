        # its contributing declaration names.
        if: more != 0 && next_index = 0 && kind = 10 && res < 0
            ent: c.lm_compiler_field_pointee(ni, field_own, pd, off, len)
        if: more != 0 && next_index = 0 && kind = 10 && res >= 0
            ent: c.lm_compiler_mrs_ref_pointee(res, slot)
        if: more != 0 && next_index = 0 && kind = 10
            step\pointee: ent
            out\ref_follow: 1
        ---
        # A callable binding and its saved body are in the same qualified graph; continuing through a method does not
        # make its cells mutable.  A mutable holder can be rebound even when its initial referent was qualified; a
        # protected original holder cannot, and a qualified referent stays protected.
        if: (kind = 10 || kind = 3) && more != 0 && next_index = 0
            if: original = 0 || protected = 0 || ent < 0 || ent >= ns_n_cell[0] || ns_eternal_cell[0][ent] < 0
                protected: 0
                original: 0
            ---
        ---
        # Each admitted reference supplies the next holder's receiving model; the context of the model selected at
        # this step is the holder's (l2_reference_model_context), or the map's when one is in force.
        step\model_context: c.lm_compiler_reference_model_context(ni, res, slot, field_own)
        if: view_model != 0 - 1 && c.lm_compiler_schema_kind(view_model) = 1
            step\model_context: c.lm_compiler_reference_model_context(view_model, 0 - 1, 0 - 1, 0 - 1)
        view_model: 0 - 1
        if: more != 0 && next_index = 0 && kind = 10
            view_model: ent
        # A structural child of an admitted holder is still read in the
        # required graph's coordinates. Carry that receiving occurrence;
        # neither backend may recover it by evaluating the candidate path.
        if: more != 0 && next_index = 0 && (kind = 2 || kind = 3) && step\view_model != -1
            view_model: ent
        # NODE-PATH-CAPTURE-MAP: the host formal named after `node` is the capture admitted to the formal's model; the
        # next name is read through that map, and its model operand is the declared model, as a formal root's (-2).
        if: more != 0 && next_index = 0 && i = 1 && root_kind = 1 && kind = 2 && c.lm_compiler_host_formal_seg(cur_mi_cell[0], pd, off, len) >= 0
            view_model: ent
            step\model_context: 0 - 2
        ---
        if: more != 0 && next_index = 0 && kind != 2 && kind != 3 && kind != 4 && kind != 12 && (kind != 10 || ent < 0)
            return: (cast: (int) (c.lm_compiler_path_fail(out, k + 1, 3)))
        # The value this name selects, for an index step that follows it or an Array value asked of the leaf.
        value: 0
        value_ft: -1
        indirect: 0
        if: next_index != 0 || more = 0
            value: lm_compiler_path_step_contract(step)
            if: value != 0 && value\kind != 1
                c.lm_compiler_contract_element_ty(value, @ value_ft)
            if: value_ft < 0 && kind = 10
                value_ft: step\cell_ft
            if: value_ft < 0
                value_ft: c.lm_compiler_path_kind_ft(kind)
            ---
        ---
        contract_from: k
        bh: nb
        bm: 0 - 1
        part_scope: -1
        if: more != 0 && next_index = 0
            ni: ent
            res: 0 - 1
            # A callable field is the same stored Structure occurrence: its next field resolves in that method's
            # existing source body; a part's in the part.  A merge result's schema is read by its slot map.
            if: kind = 4
                bm: ent
                ni: 0 - 1
            ---
            if: kind = 12
                bm: ent
                part_scope: slot
                ni: 0 - 1
            ---
            if: kind != 4 && kind != 12 && c.lm_compiler_schema_kind(ent) = 2
                res: c.lm_compiler_schema_index(ent)
                ni: 0 - 1
            ---
        ---
        i: i + 1
        k: k + 1
    ---
    # The leaf: a name's kind, Structure or pointee; an index's element; and whether the value is an Array.
    if: last\locus = 7
        out\leaf_kind: 13
        out\leaf_ty: last\elem_ty
        out\leaf_model: last\elem_model
    else:
        out\leaf_kind: kind
        if: kind = 2 || kind = 3
            out\leaf_model: ent
        if: kind = 4
            out\leaf_mi: ent
        # A reference field leaf (FABLE-SONNET-SEND-REF-20260925-172 commit 1): the pointer code of its cell as mi --
        # the same raw code l2_ptr_type_word / l2_kernel_ptr_word / l2_resolve_type_atom give a formal or local, which
        # l2_own_ty_of_param converts to an own-storage code -- and its pointee as the model.
        if: kind = 10 || kind = 11
