include: "<stddef.h>"
predef: "l2src/lmx_schedule.h.lm1"
predef: "l2src/lmx_thread.h.lm1"
predef: "l2src/lmx_arena.h.lm1"

define: LMX_MANAGER_OK 0
define: LMX_MANAGER_INVALID 1
define: LMX_MANAGER_EMPTY 2

# The scheduler's interface.  ONE API, TWO IMPLEMENTATIONS -- stepped and running --
# and the manager carries whichever implementation it was bound to in `api`
# (Mikhail, 2026-09-17: "если lmx_manager сейчас сам шагает по детям значит надо
# сделать второй с тем же API -- иначе работать будет невозможно").
#
#   stepped  (lmx_manager.lm1)      -- the scheduler walks the objects itself, one
#                                      turn at a time.  This is the binding that
#                                      `lmx_manager_init` makes.
#   running  (lmx_manager_running.lm1) -- every record gets a lane of its own: an OS
#                                      thread that loops over that one object's turns.
#                                      Bound by `lmx_manager_running_init`.
#
# A caller holds the manager and calls through `api`; which implementation runs is
# decided once, at binding, and nothing else in the caller changes.  LmxManager is
# named before it is defined so the function-pointer types can point at it; the
# struct: below completes the same tag.
#
# The arena of the Message is NOT named on these operations.  Every record carries its own band from
# creation (lmx_schedule.h.lm1: `arena`), and that is the arena the domain question is asked of and
# the arena the record's turn boundary collects -- so a queue needs no arena of its own and a caller
# supplies none: one round can step records of several bands (a root's own children and a re-rooted
# orphan) without ever being told which band it runs on.  The manager stores no arena of its own.
#
# The reading `now` arrives the same way and for the same reason.  Time belongs to the cycle
# that runs the schedule (model 25 (iii), 33; lmx_clock is the only place that asks the
# platform), so every operation that ages a wait is GIVEN the reading: one cycle, one
# reading, and every record in it ages against that one number.
type: LmxManager struct LmxManager

fnptr: LmxManagerInit (@: LmxManager m) int
fnptr: LmxManagerAdd (@: LmxManager m; @: LmxSchedule slot) int
fnptr: LmxManagerRemove (@: LmxManager m; @: LmxSchedule slot) int
fnptr: LmxManagerTake (@: LmxManager m) @: LmxSchedule
fnptr: LmxManagerCount (@: LmxManager m) size_t
fnptr: LmxManagerStep (@: LmxManager m; ulong: now) int
fnptr: LmxManagerRound (@: LmxManager m; unsigned: ticks; ulong: now) int

struct: LmxManagerApi
    LmxManagerInit: init
    LmxManagerAdd: add
    LmxManagerRemove: remove
    LmxManagerTake: take
    LmxManagerCount: count
    LmxManagerStep: step
    LmxManagerRound: round
end: LmxManagerApi

# The scheduler, as data.  It does NOT start OS threads by itself: the stepped
# binding runs over the objects one turn at a time, and the running binding gives
# each record a lane.  Model 29 and Mikhail on 2026-09-15: "реализация L3 Thread
# планировщика который не запускает потоков детей а бегает по ним сам".
#
# The queue holds scheduler records (lmx_schedule), and a record's owner is an
# address whose domain is checked before a turn is run.  Nothing about the queue is
# stored on a letter or on an object: the schedule is the scheduler's own data,
# which is why a letter can stay five fields (LmxMsg is closed).
#
# There is no lock here and none is wanted: a lane is serial, and the only
# synchronized collection the design allows is the mailbox (model 30).
struct: LmxManager
    @: LmxSchedule head
    @: LmxSchedule tail
    size_t: count
    LmxManagerApi: api
end: LmxManager

prototype:
    fn: lmx_manager_init (@: LmxManager m) int
    fn: lmx_manager_api (@: LmxManager m) @: LmxManagerApi
    fn: lmx_manager_add (@: LmxManager m; @: LmxSchedule slot) int
    # A record LEAVES the schedule: the object it belonged to is gone -- its storage released by the
    # settle that reclaimed it -- and a queue that kept its record would step freed storage.  This is
    # the one act that takes a record out of a queue it joined; a record that never joined is
    # refused.  The lane, if the running binding gave it one, is not joined here: a lane ends by
    # itself (lmx_manager_running.h.lm1).
    fn: lmx_manager_remove (@: LmxManager m; @: LmxSchedule slot) int
    fn: lmx_manager_take (@: LmxManager m) @: LmxSchedule
    fn: lmx_manager_count (@: LmxManager m) size_t
    fn: lmx_manager_step (@: LmxManager m; ulong: now) int
    fn: lmx_manager_round (@: LmxManager m; unsigned: ticks; ulong: now) int
    # The running binding's operations are declared in lmx_manager_running.h.lm1: its
    # thread entry has a platform type, and the platform stays out of this header.
end: prototype
