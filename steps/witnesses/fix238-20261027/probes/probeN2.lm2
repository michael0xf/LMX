# Probe N2 (machine module, --library --machine show): prefix dereference of a pointer-to-pointer formal followed
# by a field path, the emit:2821 shape `\next\value`.
predef: "probe_types.h.lm1"
fn: show (@@: next c.PNode) int
    if: \next != 0 && \next\value != 0
        return: 1
    return: 0
end: show
