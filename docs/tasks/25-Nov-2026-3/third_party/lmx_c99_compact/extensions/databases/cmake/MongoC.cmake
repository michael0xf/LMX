# MongoDB C Driver plaintext profile, original sources kept immutable.
include_guard(GLOBAL)
get_filename_component(_lmx_db_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
get_filename_component(_lmx_db_bundle "${_lmx_db_root}/../.." ABSOLUTE)
if(NOT TARGET LMX::zlib)
    message(FATAL_ERROR "Database group requires the root LMX::zlib target.")
endif()
function(_lmx_mongo_static)
    # Do not enable C++, even for optional header checks or upstream tests.
    set(CMAKE_CXX_COMPILER NOTFOUND)
    set(CMAKE_C_STANDARD 99)
    set(CMAKE_C_STANDARD_REQUIRED ON)
    set(CMAKE_C_EXTENSIONS OFF)
    if(LMX_STRICT_C99 AND CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
        string(APPEND CMAKE_C_FLAGS " -pedantic-errors")
    endif()
    set(ENABLE_STATIC BUILD_ONLY CACHE STRING "LMX embedded static Mongo C Driver" FORCE)
    set(ENABLE_SHARED OFF CACHE BOOL "LMX static profile" FORCE)
    set(ENABLE_STATIC_LIBBSON_INSTALL OFF CACHE BOOL "LMX build-tree integration" FORCE)
    set(ENABLE_SHARED_LIBBSON_INSTALL OFF CACHE BOOL "LMX build-tree integration" FORCE)
    set(ENABLE_MONGOC ON CACHE BOOL "LMX MongoDB driver" FORCE)
    set(USE_SYSTEM_LIBBSON OFF CACHE BOOL "Use same release's libbson" FORCE)
    set(ENABLE_PIC ON CACHE BOOL "LMX static PIC" FORCE)
    foreach(_off IN ITEMS ENABLE_TESTS ENABLE_EXAMPLES ENABLE_MAN_PAGES ENABLE_HTML_DOCS
            ENABLE_UNINSTALL ENABLE_SHM_COUNTERS ENABLE_RDTSCP ENABLE_TRACING
            ENABLE_COVERAGE ENABLE_MAINTAINER_FLAGS ENABLE_DEBUG_ASSERTIONS)
        set(${_off} OFF CACHE BOOL "LMX embedding profile" FORCE)
    endforeach()
    set(BUILD_TESTING OFF)
    foreach(_feature IN ITEMS ENABLE_SSL ENABLE_SASL ENABLE_SNAPPY
            ENABLE_CLIENT_SIDE_ENCRYPTION ENABLE_MONGODB_AWS_AUTH)
        set(${_feature} OFF CACHE STRING "LMX no additional external dependency" FORCE)
    endforeach()
    set(ENABLE_SRV ON CACHE BOOL "Use POSIX resolver for MongoDB SRV" FORCE)
    set(USE_BUNDLED_UTF8PROC ON CACHE BOOL "Use original bundled utf8proc" FORCE)
    set(ENABLE_ZLIB SYSTEM CACHE STRING "Use exact existing LMX zlib target" FORCE)
    set(ZLIB_INCLUDE_DIR "${LMX_VENDOR_DIR}/zlib" CACHE PATH "LMX zlib" FORCE)
    set(ZLIB_LIBRARY LMX::zlib CACHE FILEPATH "LMX zlib target" FORCE)
    set(ZLIB_LIBRARY_RELEASE LMX::zlib CACHE FILEPATH "LMX zlib target" FORCE)
    set(ZLIB_LIBRARY_DEBUG LMX::zlib CACHE FILEPATH "LMX zlib target" FORCE)
    if(TARGET LMX::zstd)
        set(ENABLE_ZSTD ON CACHE STRING "Use exact existing LMX zstd target" FORCE)
    else()
        set(ENABLE_ZSTD OFF CACHE STRING "No bundled zstd target enabled" FORCE)
    endif()
    set(_view "${CMAKE_CURRENT_BINARY_DIR}/mongo-c-driver-source")
    file(MAKE_DIRECTORY "${_view}")
    file(COPY "${LMX_VENDOR_DIR}/mongo_c_driver/" DESTINATION "${_view}")
    # Native Windows filesystems usually hide SDK-header case differences;
    # MinGW cross builds on a case-sensitive host require the canonical names.
    foreach(_unit mongoc-client.c mongoc-socket.c)
        set(_unit_path "${_view}/src/libmongoc/src/mongoc/${_unit}")
        file(READ "${_unit_path}" _unit_source)
        string(REPLACE "<WinDNS.h>" "<windns.h>" _unit_source "${_unit_source}")
        string(REPLACE "<Windows.h>" "<windows.h>" _unit_source "${_unit_source}")
        string(REPLACE "<Mstcpip.h>" "<mstcpip.h>" _unit_source "${_unit_source}")
        file(WRITE "${_unit_path}" "${_unit_source}")
    endforeach()
    # Upstream only searches zstd via pkg-config. Prefer the live collection
    # target so that neither a system zstd nor a second bundled copy is linked.
    file(READ "${_view}/src/libmongoc/CMakeLists.txt" _cmake)
    set(_needle [=[   find_package(PkgConfig)
   pkg_check_modules (ZSTD libzstd)]=])
    string(FIND "${_cmake}" "${_needle}" _found)
    if(_found EQUAL -1)
        message(FATAL_ERROR "Unexpected MongoDB 2.5.9 zstd finder block")
    endif()
    set(_replacement [=[   if(TARGET LMX::zstd)
      set(ZSTD_FOUND TRUE)
      set(ZSTD_VERSION "1.6.0")
      get_target_property(ZSTD_INCLUDE_DIRS LMX::zstd INTERFACE_INCLUDE_DIRECTORIES)
      set(ZSTD_LIBRARY_DIRS "")
      set(ZSTD_LINK_LIBRARIES LMX::zstd)
   else()
      find_package(PkgConfig)
      pkg_check_modules (ZSTD libzstd)
   endif()]=])
    string(REPLACE "${_needle}" "${_replacement}" _cmake "${_cmake}")
    # Upstream copies test corpora even with ENABLE_TESTS=OFF. They are not
    # inputs of either library; only an explicitly requested test build needs
    # those copies. Keep the library source lists and feature selection intact.
    set(_fixture_block [=[file (COPY ${PROJECT_SOURCE_DIR}/tests/binary DESTINATION ${PROJECT_BINARY_DIR}/tests)
file (COPY ${PROJECT_SOURCE_DIR}/tests/json DESTINATION ${PROJECT_BINARY_DIR}/tests)
file (COPY ${PROJECT_SOURCE_DIR}/tests/x509gen DESTINATION ${PROJECT_BINARY_DIR}/tests)
file (COPY ${PROJECT_SOURCE_DIR}/tests/release_files DESTINATION ${PROJECT_BINARY_DIR}/tests)]=])
    string(FIND "${_cmake}" "${_fixture_block}" _fixture_pos)
    if(_fixture_pos EQUAL -1)
        message(FATAL_ERROR "Unexpected MongoDB test-data copy block")
    endif()
    string(REPLACE "${_fixture_block}" "if(ENABLE_TESTS)\n${_fixture_block}\nendif()"
        _cmake "${_cmake}")
    file(WRITE "${_view}/src/libmongoc/CMakeLists.txt" "${_cmake}")
    # MinGW import-library filenames on a case-sensitive cross host are
    # lowercase; the Windows DLL/API itself is unchanged.
    file(READ "${_view}/build/cmake/ResSearch.cmake" _resolver_cmake)
    string(REPLACE "set(RESOLVE_LIB_NAME Dnsapi)" "set(RESOLVE_LIB_NAME dnsapi)"
        _resolver_cmake "${_resolver_cmake}")
    file(WRITE "${_view}/build/cmake/ResSearch.cmake" "${_resolver_cmake}")
    add_subdirectory("${_view}" "${CMAKE_CURRENT_BINARY_DIR}/mongo-c-driver-build")
endfunction()
_lmx_mongo_static()
# Upstream compiles this same unprefixed implementation into both libraries.
# Keep exactly one definition in libbson, already a PUBLIC dependency of
# libmongoc. Other common files have distinct _bson/_mongoc symbol prefixes.
get_target_property(_lmx_mongoc_sources mongoc_static SOURCES)
set(_lmx_oid_sources ${_lmx_mongoc_sources})
list(FILTER _lmx_oid_sources INCLUDE REGEX "/common-oid\\.c$")
list(LENGTH _lmx_oid_sources _lmx_oid_count)
if(NOT _lmx_oid_count EQUAL 1)
    message(FATAL_ERROR "Unexpected MongoDB 2.5.9 common-oid.c source layout")
endif()
list(FILTER _lmx_mongoc_sources EXCLUDE REGEX "/common-oid\\.c$")
set_property(TARGET mongoc_static PROPERTY SOURCES "${_lmx_mongoc_sources}")
foreach(_target IN ITEMS bson_static mongoc_static utf8proc_obj)
    if(TARGET ${_target})
        lmx_c99_target(${_target})
    endif()
endforeach()
if(UNIX)
    # Public mongoc-socket.h names struct addrinfo from POSIX <netdb.h>.
    # Expose that declaration to strict C99 consumers as well as the core.
    target_compile_definitions(mongoc_static INTERFACE _POSIX_C_SOURCE=200809L)
endif()
add_library(LMX::bson ALIAS bson_static)
add_library(LMX::mongoc ALIAS mongoc_static)
message(STATUS "LMX MongoDB C Driver 2.5.9: plaintext, no SCRAM/TLS/SASL/AWS/in-use encryption; shared zlib/zstd")
