---
    Observed:
        int: a 1
        int: b 1
        int: c 0
        int: d 0
        int: e 1
        int: f 0
        int: g 1
    end: Observed
---
@: shared (data [] 0)
sub: main () (
    int: a 9
    int: b 9
    int: c 9
    int: d 9
    int: e 9
    int: f 9
    int: g 9
)
    :=: a (3 <= 3)
    :=: b (3 >= 3)
    :=: c (3 < 3)
    :=: d (3 > 3)
    :=: e (3 = 3)
    :=: f (3 != 3)
    :=: g (2 != 3)
    :=: ((shared \ Observed) \ a) a
    :=: ((shared \ Observed) \ b) b
    :=: ((shared \ Observed) \ c) c
    :=: ((shared \ Observed) \ d) d
    :=: ((shared \ Observed) \ e) e
    :=: ((shared \ Observed) \ f) f
    :=: ((shared \ Observed) \ g) g
end: main
main:
