# Every activation publishes its dirty fields into the same occurrence.
# down(3) returns123 from independent working values; innermost x0 remains
# published, while outer y12 is published on its exit. Callable-formal seven
# also publishes s7 normally; no fresh graph or recursion suppression.
fn: down (int: n) int
    int: x n
    int: y 0
    if: n > 0
        y: down(n - 1)
    return: x + 10 * y
end: down

fn: seven () int
    int: s 7
    return: s
end: seven

fn: apply (seven: g) int
    return: g + 0
end: apply

int: r down(3)
int: d apply(seven)
int: dx 0
dx: down\x
int: dy 0
dy: down\y
int: ss 0
ss: seven\s
int: ok 0
if: r = 123 && dx = 0 && dy = 12 && d = 7 && ss = 7
    ok: 7
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
