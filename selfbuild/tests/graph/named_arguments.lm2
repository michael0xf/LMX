# Plan M11 5v: the declarations of ordinary Structures live in the data part of main; the root holds places and the call main().
fn: a (int: n) int (int: calls 0)
    calls := calls + 1
    return: n + 1
fn: tst (int: c 3; int: a 2) int
    return: c * 10 + a
int: named_literal tst(a := 5)
int: named_call tst(a := a(5))
int: paren_call tst(a(5))
int: colon_call tst(a: 5)
int: calls a\data\calls
int: defaulted tst()
int: reordered tst(a:=1; c:=2)
int: mixed tst(6; a:=1)
fn: inside () int
    return: tst(a := 8)
int: no_dynamic_label inside()
fn: tick (int: n) int (int: trace 0)
    trace := trace * 10 + n
    return: n
int: written_order tst(a := tick(1); c := tick(2))
int: trace tick\data\trace
sub: main () (
    Point:
        int: y 0
        int: unused 0
    Data:
        int: y 4
    int: structural 0
    int: structural_default 0
)
    fn: take (Point: p; int: q 2) int
        return: p\y * 10 + q
    structural := take(q := 7; p := Data)
    structural_default := take(p := Data)
main()
int: structural main\data\structural
int: structural_default main\data\structural_default
sub: set (int: x 1; int: y 2) (int: value 0)
    value := x * 10 + y
set(y := 9)
int: procedure set\data\value
int: later_default tst()
int: data_len length(main\data\Data)
