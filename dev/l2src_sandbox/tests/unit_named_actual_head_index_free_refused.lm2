# b in a's payload is put's free input, not pick's named b formal.
# With no lexical or calling source, the caller cannot supply that value.
# Refuse put's required hidden input at its call, 14:30.
fn: pick (size_t: a; size_t: b) size_t
    return: a * 2U + b
end: pick

fn: put () int
    []: int row 3
    row[pick(b: 1U; a: b)]: 5
    return: row[1]
end: put

sendMessage: exit(exit_code: put(); stdout: ""; stderr: "")
return
