# N4 (LMX_semantics.ru.md #qualification: protection follows the storage a write reaches): S writes its x, which
# under call: S D is the x of the eternal D, so the call would write an immutable field: refused at the data operand.
independent:
    const:
        immutable:
            (): D
                int: x 5
            end: D
        end: immutable
    end: const
end: independent
S:
    int: x
    x: x + 1
end: S
call: S D
return
