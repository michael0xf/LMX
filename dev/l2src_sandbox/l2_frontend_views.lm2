fn: lm_compiler_use_receiver_port (const: (@: fact c.L2PathFact); const: (@: receiver c.L2UseReceiver); int: which; @: method int; @: key int) int
    @: m_n_cell int (cast: (@: int) (@ c.l2_m_n))
    @@: m_arity_cell int (cast: (@@: int) (@ c.l2_m_arity))
    int: target
    int: input
    int: selector
    int: count
    int: own
    int: row
    if: method = 0 || key = 0
        return: (cast: (int) (2))
    \method: -1
    \key: -1
    if: fact = 0 || receiver = 0 || which < 0 || fact\source_use = 0 || fact\method < 0 || fact\method >= m_n_cell[0]
        return: (cast: (int) (2))
    target: receiver\method
    input: receiver\key
    if: target < 0 || target >= m_n_cell[0]
        return: (cast: (int) (2))
    if: receiver\input_symbol != 0
        input: lm_compiler_input_symbol_index(target, (cast: (const: @: c.LmP0Text) (receiver\input_symbol)))
        if: input < 0
            return: (cast: (int) (2))
        ---
    else:
        if: input >= 0
            return: (cast: (int) (2))
        own: lm_compiler_d105_key_own(input)
        row: lm_compiler_d105_key_field(input)
        if: input != -1 && own < 0 && row < 0
            return: (cast: (int) (2))
        target: lm_compiler_d105_key_method(target, input)
        if: target < 0 || target >= m_n_cell[0]
            return: (cast: (int) (2))
        ---
    ---
    if: receiver\selector_symbol = 0
        if: which != 0
            return: (cast: (int) (1))
        ---
    else:
        # An actual selects an explicit interface position. Hidden inputs
        # have their own existing formation edges, not a positional guess.
        if: input < 0 || input >= m_arity_cell[0][target]
            return: (cast: (int) (2))
        selector: lm_compiler_input_symbol_index((cast: (int) (fact\method)), (cast: (const: @: c.LmP0Text) (receiver\selector_symbol)))
        if: selector < 0 || lm_compiler_cfr_has((cast: (int) (fact\method)), selector, -1) != 0
            return: (cast: (int) (2))
        count: lm_compiler_cfl_count((cast: (int) (fact\method)), selector)
        if: count = 0
            return: (cast: (int) (2))
        if: which >= count
            return: (cast: (int) (1))
        target: lm_compiler_cfl_at((cast: (int) (fact\method)), selector, which)
        if: target < 0 || target >= m_n_cell[0] || input >= m_arity_cell[0][target] || lm_compiler_input_name(target, input) = 0
            return: (cast: (int) (2))
        ---
    ---
    \method: target
    \key: input
    return: (cast: (int) (0))
end: lm_compiler_use_receiver_port

fn: lm_compiler_path_facts_dump (const: (@: path char)) int
    @@: path_facts_cell c.L2PathFact (cast: (@@: c.L2PathFact) (@ c.l2_path_facts))
    @: out c.FILE
    @: fact c.L2PathFact path_facts_cell[0]
    @: observed c.L2Path
    @: step c.L2PathStep
    @: receiver c.L2UseReceiver
    int: i
    int: port
    int: port_status
    int: port_method
    int: port_key
    int: scopes
    int: bad 0
    if: path = 0 || path[0] = 0 || fact = 0
        return: (cast: (int) (0))
    out: c.fopen(path, "ab")
    if: out = 0
        return: (cast: (int) (1))
    if: c.fprintf(out, "path-observations 4 (not a complete Consumer)\n") < 0
        bad: 1
    while: fact != 0
        observed: @ fact\resolved
        scopes: 0
        if: fact\use_site != 0
            scopes: fact\use_site\scope_count
        if: c.fprintf(out, "source-use=%d stage=%d scopes=%d roles=%d\n", fact\source_use, fact\stage, scopes, fact\use_roles) < 0
            bad: 1
        if: c.fprintf(out, "fact method=%d source_method=%d source=%p root=%d:%d formal=%d own=%d schema=%d:%d input=%d fail=%d:%d n=%d names=%d indexed=%d bytes=%zu text=", fact\method, fact\source_method, (cast: (@: void) fact\source), observed\root_kind, observed\root, observed\fi, observed\oi, observed\ni, observed\res, observed\model_input, observed\fail_seg, observed\fail_why, observed\n, observed\names, observed\indexed, observed\length) < 0 || c.fwrite(observed\text, 1U, observed\length, out) != observed\length || c.fprintf(out, "\n") < 0
            bad: 1
        if: c.fprintf(out, "binding-input=%p current-input=%d\n", (cast: (@: void) fact\input_symbol), lm_compiler_input_symbol_index((cast: (int) (fact\method)), (cast: (const: @: c.LmP0Text) (fact\input_symbol)))) < 0
            bad: 1
        receiver: fact\receivers
        while: receiver != 0
            if: c.fprintf(out, "receiving method=%d key=%d current-input=%d selector=%d site=%p\n", (cast: (int) (receiver\method)), (cast: (int) (receiver\key)), lm_compiler_input_symbol_index((cast: (int) (receiver\method)), (cast: (const: @: c.LmP0Text) (receiver\input_symbol))), lm_compiler_input_symbol_index((cast: (int) (fact\method)), (cast: (const: @: c.LmP0Text) (receiver\selector_symbol))), (cast: (@: void) receiver\site)) < 0
                bad: 1
            port: 0
            while: 1
                port_status: lm_compiler_use_receiver_port(fact, receiver, port, @ port_method, @ port_key)
                if: port_status = 1
                    break
                if: c.fprintf(out, "receiving-port index=%d status=%d method=%d key=%d\n", port, port_status, port_method, port_key) < 0
                    bad: 1
                if: port_status != 0
                    break
                if: port = c.INT_MAX
                    bad: 1
                    break
                port: port + 1
            ---
            receiver: receiver\next
        ---
        i: 0
        while: i < observed\n
            step: observed\steps + i
            const: (@: index_view c.L2ValueSpan (cast: (const: @: c.L2ValueSpan) (@ step\index)))
            if: c.fprintf(out, "step=%d locus=%d kind=%d row=%d nsrow=%d own=%d ns=%d ent=%d pointee=%d model=%d context=%d origin=%d input=%d element=%d:%d index_count=%d address_ft=%d cell_const=%d\n", i, step\locus, step\kind, step\row, step\nsrow, step\own, step\ns, step\ent, step\pointee, step\view_model, step\model_context, step\model_step, step\model_input, step\elem_ty, step\elem_model, (index_view\count), step\address_ft, step\cell_const) < 0
                bad: 1
            i: i + 1
        ---
        fact: fact\next
    ---
    if: c.fclose(out) != 0
        bad: 1
    return: (cast: (int) (bad))
end: lm_compiler_path_facts_dump

