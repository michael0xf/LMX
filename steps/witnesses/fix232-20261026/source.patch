+fn: shape_has_spell (@: arena c.LmxArena; @: item void; const: (@: word char)) int
+    size_t: i 0U
+    @: cell void 0
+    @: text c.VoidArray 0
+    @: chars c.LmxArray 0
+    @: holder c.Lmx 0
+    size_t: text_length
+    if: item = 0 || word = 0
+        return: 0
+    text_length: c.strlen(word)
+    text: c.lmx_source_name_get(arena, item)
+    if: text != 0 && text\size = text_length && (text_length = 0U || c.memcmp((text\data), (cast: (@: void) word), text_length) = 0)
+        return: 1
+    if: c.lmx_domain_kind(arena, item) = c.LMX_KIND_ARRAY && c.lmx_domain_type(arena, item) = c.LMX_TYPE_ARRAY_OF_CHAR
+        chars: (cast: (@: c.LmxArray) item)
+        @: chars_fields c.VoidArray @ chars\array
+        return: (cast: (int) (chars_fields\size = text_length && (text_length = 0U || c.memcmp((chars_fields\data), (cast: (@: void) word), text_length) = 0)))
+    if: c.lmx_domain_kind(arena, item) != c.LMX_KIND_STRUCT
+        return: 0
