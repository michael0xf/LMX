# The same in a nested body: first f() declares, second f() assigns an empty
# Structure, bare f reads, and call: f explicitly executes its empty body.
fn: m () int
    int: r 7
    if: r = 7
        f()
        f()
        f
        call: f
        r: r + 0
    int: out r
    return: out
end: m
int: r 0
r: m()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
