# Original: l1src/l1trans.lm1:538
fn: l1_fn_register_frame (const: (@: frame c.LmP0Frame); const: (@: path char); const: (@: source_node c.LmP0Node)) int
    @@: fn_ar_cell int (cast: (@@: int) (@ c.l1_fn_ar))
    @: field c.LmP0Field
    const: (@: name_node c.LmP0Node)
    const: (@: params_node c.LmP0Node)
    const: (@: third c.LmP0Node)
    const: (@: fourth c.LmP0Node)
    const: (@: fn_name c.LmP0Text)
    @: pf c.LmP0Field
    @: throws_field c.LmP0Field
    const: (@: body_node c.LmP0Node)
    int: ar
    int: fn_i
    int: code
    if: frame = 0 || frame\body = 0
        return: (cast: (int) (0))
    field: frame\body\first_field
    name_node: 0
    params_node: 0
    third: 0
    fourth: 0
    while: field != 0
        if: c.l1_node_ignored(field\value) = 0
            if: name_node = 0
                name_node: field\value
            else:
                if: params_node = 0
                    params_node: field\value
                else:
                    if: third = 0
                        third: field\value
                    else:
                        if: fourth = 0
                            fourth: field\value
                        ---
                    ---
                ---
            ---
        ---
        field: field\next
    if: name_node = 0
        return: (cast: (int) (0))
    fn_name: 0
    if: name_node\kind = c.LM_P0_NODE_ATOM
        fn_name: name_node\as\atom
    else:
        if: name_node\kind = c.LM_P0_NODE_FRAME
            fn_name: name_node\as\frame\head
            if: params_node = 0
                params_node: name_node
                third: 0
                fourth: 0
            ---
        ---
    ---
    if: fn_name = 0
        return: (cast: (int) (0))
    ar: 0
    pf: 0
    if: params_node != 0 && params_node\kind = c.LM_P0_NODE_STRUCTURE && params_node\as\structure != 0
        pf: params_node\as\structure\first_field
        while: pf != 0
            if: c.l1_node_ignored(pf\value) = 0
                ar: ar + 1
            ---
            pf: pf\next
        ---
    ---
    fn_i: l1_fn_ensure(fn_name)
    if: fn_i < 0
        return: (cast: (int) (c.l1_error(path, source_node, "too many functions")))
    fn_ar_cell[0][fn_i]: ar
    body_node: 0
    if: c.l1_text_eq(frame\head, "sub")
        body_node: third
    else:
        body_node: fourth
    ---
    throws_field: 0
    if: body_node != 0 && body_node\kind = c.LM_P0_NODE_STRUCTURE && body_node\as\structure != 0
        throws_field: body_node\as\structure\first_field
        while: throws_field != 0 && c.l1_node_ignored(throws_field\value)
            throws_field: throws_field\next
        if: throws_field != 0 && throws_field\value != 0 && throws_field\value\kind = c.LM_P0_NODE_FRAME && c.l1_text_eq(throws_field\value\as\frame\head, "throws")
            field: 0
            if: throws_field\value\as\frame\body != 0
                field: throws_field\value\as\frame\body\first_field
            ---
            while: field != 0
                if: c.l1_node_ignored(field\value) = 0
                    if: field\value != 0 && field\value\kind = c.LM_P0_NODE_ATOM
                        code: l1_throw_intern((cast: (const: @: c.LmP0Text) field\value\as\atom))
                        if: code = 0
                            return: (cast: (int) (c.l1_error(path, field\value, "too many throw names")))
                        if: l1_fn_add_throw(fn_i, code) != 0
                            return: (cast: (int) (1))
                        ---
                    ---
                ---
                field: field\next
            ---
        ---
    ---
    return: (cast: (int) (0))
end: l1_fn_register_frame

# Original: l1src/l1trans.lm1:642
fn: l1_fn_register_node (const: (@: source_node c.LmP0Node); const: (@: path char)) int
    @: field c.LmP0Field
    if: source_node = 0 || c.l1_node_ignored(source_node) != 0
        return: (cast: (int) (0))
    if: source_node\kind = c.LM_P0_NODE_STRUCTURE
        if: source_node\as\structure = 0
            return: (cast: (int) (0))
        field: source_node\as\structure\first_field
        while: field != 0
            if: l1_fn_register_node((cast: (const: @: c.LmP0Node) field\value), path) != 0
                return: (cast: (int) (1))
            field: field\next
        return: (cast: (int) (0))
    if: source_node\kind != c.LM_P0_NODE_FRAME || source_node\as\frame = 0
        return: (cast: (int) (0))
    if: c.l1_text_eq(source_node\as\frame\head, "fn") || c.l1_text_eq(source_node\as\frame\head, "sub")
        return: (cast: (int) (l1_fn_register_frame((cast: (const: @: c.LmP0Frame) source_node\as\frame), path, source_node)))
    if: c.l1_text_eq(source_node\as\frame\head, "prototype") || c.l1_text_eq(source_node\as\frame\head, "external") || c.l1_text_eq(source_node\as\frame\head, "os") || c.l1_text_eq(source_node\as\frame\head, "win") || c.l1_text_eq(source_node\as\frame\head, "default") || c.l1_text_eq(source_node\as\frame\head, "ifdef") || c.l1_text_eq(source_node\as\frame\head, "L1")
        if: source_node\as\frame\body = 0
            return: (cast: (int) (0))
        field: source_node\as\frame\body\first_field
        while: field != 0
            if: l1_fn_register_node((cast: (const: @: c.LmP0Node) field\value), path) != 0
                return: (cast: (int) (1))
            field: field\next
        return: (cast: (int) (0))
    return: (cast: (int) (0))
end: l1_fn_register_node

