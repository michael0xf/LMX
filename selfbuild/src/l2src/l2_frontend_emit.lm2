    @@: t7_nb_cell int (cast: (@@: int) (@ c.l2_t7_nb))
    @@: t7_steps_cell int (cast: (@@: int) (@ c.l2_t7_steps))
    @@: t7b_slot_cell int (cast: (@@: int) (@ c.l2_t7b_slot))
    @@: t7_b0_cell int (cast: (@@: int) (@ c.l2_t7_b0))
    @@: m_value_used_cell int (cast: (@@: int) (@ c.l2_m_value_used))
    @: construct_phase_cell int (cast: (@: int) (@ c.l2_construct_phase))
