predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx.h.lm1"

# -188 k.3a: Model: fresh = merge(proto, empty) as one kernel act over the graph.
# parent = code.parent, len = code.len; child 0 by address until k.4; other children
# by arena classification (see lmx_fresh.lm1). NULL on NOMEM / unclassified = caller X1.
prototype:
    fn: lmx_fresh (@: LmxArena arena; @: Lmx code) @: Lmx
end: prototype
