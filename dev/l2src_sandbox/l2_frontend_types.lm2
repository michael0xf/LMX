    @: word c.LmP0Text
    @: saved c.LmP0Text
    @: f c.LmP0Field
    @: g c.LmP0Field
    int: depth
    int: qualified
    int: ty
    if: source_node = 0 || source_node\as = 0 || out_ty = 0
        return: (cast: (int) (1))
    contract: c.lm_compiler_contract_type(source_node)
    if: contract = 0
        # Existing multi-word raw C type syntax is checked by C, not an L2
        # primitive conversion. It has no inferred L2 value type.
        if: source_node\kind != c.LM_P0_NODE_STRUCTURE || source_node\as\structure = 0 || c.lm_compiler_count_active(source_node\as\structure) != 2
            return: (cast: (int) (1))
        f: c.lm_compiler_next_active(source_node\as\structure\first_field)
        g: c.lm_compiler_next_active(f\next)
