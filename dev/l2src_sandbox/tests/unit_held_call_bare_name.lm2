# FACTORY (the author, 2026-10-05): `@: h f(a)` receives a factory's result; this row wrote `h: f a` until then.
# A bare held callable is an atom and does not call. Only the two explicit
# p0() applications note 1 in the copied lexical root. The harness observes
# 11 there and 0 in the original root, including the bare atom in if.
int: trace 0

fn: note (int: v) int
    node\trace: node\trace * 10 + v
    return: 0
end: note

fn: seen () int
    return: node\trace
end: seen

fn: make0 (int: n) fn: () int
    fn: f0 () int
        return: n + note(1)
    return: f0

@: p0 make0(100)
p0
p0()

fn: use (int: k) int
    p0
    p0()
    if: k = 1
        p0
    ---
    return: 0
end: use

int: z use(1)
int: ok 7
if: seen() != 0
    ok: 81
sendMessage: exit(exit_code: ok; stdout: ""; stderr: "")
return
