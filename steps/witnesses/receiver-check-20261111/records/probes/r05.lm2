fn: f () int
    size_t: n 0U
    n := size_t: 7U
    unsigned: u 0U
    u := unsigned: 7U
    ulong: w 0U
    w := ulong: 7U
    char: c 'b'
    c := char: 'a'
    if: n != 7U || u != 7U || w != 7U
        return: 81
    return: (cast: (int) c) - 90
end: f
send: exit(exit_code: f(); stdout: ""; stderr: "")
return
