predef: "lmx_arena_refs.h.lm1"
predef: "l2src/lmx_pool.h.lm1"
include: "<stdlib.h>"

fn: lmx_graph_node_in (@: LmxArena arena; @: void value) @: Lmx
    int: kind
    if: arena = 0 || value = 0
        return: 0
    kind: lmx_range_classify(arena, value)
    if: kind != c.LMX_KIND_STRUCT && kind != c.LMX_KIND_ARRAY
        return: 0
    if: lmx_range_stride(arena, value) != c.sizeof(c.Lmx)
        return: 0
return: (cast: (@: Lmx) value)

fn: lmx_graph_backing_cell_in (@: LmxArena arena; @: Lmx array; size_t: index) @: void
    size_t: stride
    size_t: offset
    size_t: start
    size_t: issued
    @: void cell
    @: LmxPool pool
    @: LmxRange entry
    @: LmxChunk chunk
    if: lmx_graph_node_in(arena, (cast: (@: void) array)) = 0
        return: 0
    if: arena = 0 || array = 0 || array\array.data = 0 || index >= array\array.size
        return: 0
    ---
    pool: lmx_range_cell_pool(arena, (array\array.data))
    stride: lmx_range_stride(arena, (array\array.data))
    entry: lmx_range_entry_at(arena, (array\array.data))
    if: pool = 0 || entry = 0 || entry\array != pool || stride = 0U || index > ((cast: (size_t) -1) / stride)
        return: 0
    ---
    if: lmx_range_classify(arena, (cast: (@: void) array)) = c.LMX_KIND_STRUCT
        if: (pool\kind != c.LMX_KIND_CHILDREN && pool\kind != c.LMX_KIND_FIELD_ADDRESSES) || pool\type != c.LMX_TYPE_REFS || stride != c.sizeof(@: void)
            return: 0
        ---
    else:
        if: pool\kind != c.LMX_KIND_REF && pool\kind != c.LMX_KIND_PRIMITIVE
            return: 0
        ---
    ---
    chunk: lmx_pool_chunk_at(pool, entry\lo)
    if: chunk = 0 || lmx_chunk_cells(chunk, stride) > lmx_chunk_room(chunk, stride)
        return: 0
    ---
    offset: (cast: (size_t) array\array.data) - (cast: (size_t) entry\lo)
    if: offset % stride != 0U
        return: 0
    ---
    start: offset / stride
    issued: lmx_chunk_cells(chunk, stride)
    # The descriptor's claimed span must fit within issued cells of this
    # single backing chunk before any C pointer arithmetic is performed.
    if: start > issued || array\array.size > issued - start
        return: 0
    ---
    cell: (cast: (@: void) ((cast: (@: char) array\array.data) + index * stride))
    if: lmx_range_cell_pool(arena, cell) != pool
        return: 0
    ---
return: cell

fn: lmx_graph_cell_in (@: LmxArena arena; @: Lmx node; size_t: index) @: void
    @: void cell lmx_graph_backing_cell_in(arena, node, index)
    @: LmxPool pool
    if: cell = 0
        return: 0
    if: lmx_range_classify(arena, cell) != c.LMX_KIND_FIELD_ADDRESSES
        return: cell
    # Exactly one physical indirection. Entries are physical addresses,
    # never ordinals or another field-address table to project again.
    cell: \ (cast: (@@: void) cell)
    pool: lmx_range_cell_pool(arena, cell)
    if: pool = 0 || pool\kind != c.LMX_KIND_CHILDREN || pool\type != c.LMX_TYPE_REFS || pool\stride != c.sizeof(@: void)
        return: 0
return: cell

fn: lmx_graph_fields_bind (@: LmxArena arena; @: Lmx node; @@: void cells) int
    @: LmxPool first_pool
    @: LmxRange first_range
    @: LmxPool pool
    @: LmxPool backing
    @@: void addresses
    size_t: i 0U
    size_t: stride c.sizeof(@: void)
    int: contiguous 1
    if: node = 0 || cells = 0 || lmx_range_classify(arena, (cast: (@: void) node)) != c.LMX_KIND_STRUCT || node\array.size = 0U || node\array.size > ((cast: (size_t) -1) / stride)
        return: 1
    first_pool: lmx_range_cell_pool(arena, cells[0])
    first_range: lmx_range_entry_at(arena, cells[0])
    while: i < node\array.size
        pool: lmx_range_cell_pool(arena, cells[i])
        if: pool = 0 || pool\kind != c.LMX_KIND_CHILDREN || pool\type != c.LMX_TYPE_REFS || pool\stride != stride
            return: 1
        # One direct span cannot straddle two chunks, even if separate
        # allocations happen to have adjacent numerical addresses.
        if: pool != first_pool || lmx_range_entry_at(arena, cells[i]) != first_range || i > (((cast: (size_t) -1) - (cast: (size_t) cells[0])) / stride) || (cast: (size_t) cells[i]) != (cast: (size_t) cells[0]) + i * stride
            contiguous: 0
        i: i + 1U
    ---
    if: contiguous != 0
        node\array.data: cells[0]
        return: 0
    backing: lmx_pool_make_profiled(arena, (node\array.size) * stride, stride, c.LMX_KIND_FIELD_ADDRESSES, c.LMX_TYPE_REFS, lmx_range_profile(arena, (cast: (@: void) node)))
    if: backing = 0
        return: 1
    addresses: (cast: (@@: void) lmx_chunk_data(backing\head))
    i: 0U
    while: i < node\array.size
        addresses[i]: cells[i]
        i: i + 1U
    ---
    node\array.data: (cast: (@: void) addresses)
return: 0

fn: lmx_graph_ref_cell_in (@: LmxArena arena; @: Lmx node; size_t: index) @@: void
    @: void cell lmx_graph_cell_in(arena, node, index)
    @: LmxPool pool lmx_range_cell_pool(arena, cell)
    if: pool = 0 || (pool\kind != c.LMX_KIND_CHILDREN && pool\kind != c.LMX_KIND_REF) || pool\stride != c.sizeof(@: void)
        return: 0
return: (cast: (@@: void) cell)

fn: lmx_graph_ref_struct_in (@: LmxArena arena; @: Lmx node; size_t: index) @: Lmx
return: lmx_graph_node_in(arena, lmx_graph_value_in(arena, node, index))

fn: lmx_graph_ref_store_in (@: LmxArena arena; @: Lmx node; size_t: index; @: void value) int
    @@: void slot lmx_graph_ref_cell_in(arena, node, index)
    if: slot = 0
        return: 1
    \slot: value
return: 0

fn: lmx_graph_value_in (@: LmxArena arena; @: Lmx node; size_t: index) @: void
    @: void cell lmx_graph_cell_in(arena, node, index)
    @: LmxPool pool
    int: kind
    if: cell = 0
        return: 0
    pool: lmx_range_cell_pool(arena, cell)
    if: pool = 0
        return: 0
    kind: pool\kind
    if: kind = c.LMX_KIND_CHILDREN || kind = c.LMX_KIND_REF
        if: pool\stride != c.sizeof(@: void)
            return: 0
        return: \ (cast: (@@: void) cell)
    if: kind = c.LMX_KIND_PRIMITIVE
        return: cell
return: 0

# The payload IS the void * child-pointer array of one Structure (ABI 3.3).  It is an
# array of the arena like every other -- "ЧЕМ МАССИВЫ ОТЛИЧАЮТСЯ ОТ ВСЕГО ОСТАЛЬНОГО?
# НИЧЕМ!!!" (Mikhail, 2026-09-17) -- so it has a descriptor and an entry in the arena's
# index, and a slot ADDRESS classifies as CHILDREN: a storage location, not the child
# stored in it.  What types a child is the child's own VALUE, classified on its own
# (SPEC 2: "The address of the pointer slot &children[i] is a storage location, not the
# address used to identify the child's type").  The structure's `array.data` holds the base;
# nothing else is stored anywhere to say what a slot is.  Slots start null; construction
# stores each child's typed address afterwards.
#
# This function is the CREATION step for this structure's child block, so it is the one
# that sets array.data and array.size: the count is given once, here, and never changes afterwards
# (SPEC 2, ABI 14.22).  There is no later writer of either field.
fn: lmx_arena_refs_open_owned (@: LmxArena arena; @: Lmx parent; size_t: children) int
return: lmx_arena_refs_open_profiled(arena, parent, children, 0)

fn: lmx_arena_refs_open_profiled (@: LmxArena arena; @: Lmx parent; size_t: children; @: Lmx profile) int
    size_t: slot c.sizeof(@: void)
    size_t: bytes
    @: LmxPool array
    if: arena = 0 || parent = 0 || children = 0U
        return: 1
    if: parent\array.data != 0 || parent\array.size != 0U
        return: 1
    if: children > ((cast: (size_t) -1) / slot)
        return: 1
    bytes: children * slot
    # The slot array is an array of the arena like every other: the arena allocates it,
    # owns it and classifies it (KIND_CHILDREN with TYPE_REFS), so this constructor
    # prepares no storage of its own and a refusal leaves the arena untouched.
    array: lmx_pool_make_profiled(arena, bytes, slot, c.LMX_KIND_CHILDREN, c.LMX_TYPE_REFS, profile)
    if: array = 0
        return: 1
    ---
    parent\array.data: (cast: (@: void) lmx_chunk_data(array\head))
    parent\array.size: children
return: 0

# Slot address for a compiler-proven child index. Null only for a null
# parent/data or an out-of-range index; the slot's current value may itself be
# null before construction has stored a child.
fn: lmx_arena_ref_cell (@: Lmx parent; size_t: index) @@: void
    if: parent = 0 || parent\array.data = 0
        return: 0
    if: index >= parent\array.size
        return: 0
    return: (cast: (@@: void) parent\array.data) + index

fn: lmx_arena_ref_value (@: Lmx parent; size_t: index) @: void
    @@: void slot lmx_arena_ref_cell(parent, index)
    if: slot = 0
        return: 0
    return: \slot

# Rebinds one child reference (ABI 14.22). The referenced object is not
# touched; the previous referent is neither freed nor retained here.
fn: lmx_arena_ref_store (@: Lmx parent; size_t: index; @: void value) int
    @@: void slot lmx_arena_ref_cell(parent, index)
    if: slot = 0
        return: 1
    \slot: value
    return: 0

fn: lmx_arena_ref_struct (@: Lmx parent; size_t: index) @: Lmx
    return: (cast: (@: Lmx) lmx_arena_ref_value(parent, index))
