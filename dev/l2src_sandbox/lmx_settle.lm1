predef: "lmx_settle.h.lm1"
predef: "l2src/lmx_child.h.lm1"
predef: "l2src/lmx_post.h.lm1"
predef: "l1src/libc_abi.lm1"
predef: "l2src/lmx_clock.h.lm1"

# Settling uses the one ordinary Array<@LmxThread> in the parent's graph. A completed child
# remains physically valid until the serialized parent removes that exact reference. Only after
# removal may the parent release a successful arena or attach a failed arena.

fn: lmx_settle_ready (@: LmxMsg message) int
    if: message = 0 || message\running != 0
        return: 0
    if: message\handoff_ready != 0
        return: 1
return: 0

fn: lmx_settle_cascade_one_level (@: LmxThread t; @: LmxArena arena; @: void service; @: void manager; size_t: deadline) int
    ulong: now
    @: LmxManagerApi api
    if: t = 0 || arena = 0
        return: c.LMX_SETTLE_INVALID
    while: lmx_thread_child_count(t) != 0U
        now: lmx_clock_ticks()
        if: manager != 0
            api: lmx_manager_api((cast: (@: LmxManager) manager))
            if: api != 0 && api\round != 0
                api\round((cast: (@: LmxManager) manager), 1U, now)
            ---
        ---
        if: lmx_settle_children(t, arena, (cast: (@: LmxService) service), (cast: (@: LmxManager) manager), now) != c.LMX_SETTLE_OK
            return: c.LMX_SETTLE_INVALID
        lmx_stop_children(t, now, deadline)
    ---
return: c.LMX_SETTLE_OK

fn: lmx_settle_close_one_level (@: LmxThread t; @: LmxArena arena; @: void service; @: void manager; size_t: deadline) int
    @: LmxThread child
    @: LmxMsg child_message
    @: LmxSchedule child_slot
    @: LmxArena child_arena
    @: LmxManagerApi api
    size_t: index
    int: live
    int: rec
    if: t = 0 || arena = 0
        return: c.LMX_SETTLE_INVALID
    live: 1
    while: live != 0
        live: 0
        index: 0U
        while: index < lmx_thread_child_count(t)
            child: lmx_thread_child_at(t, index)
            if: child = 0
                return: c.LMX_SETTLE_INVALID
            child_slot: child\slot
            child_arena: 0
            if: child_slot != 0
                child_arena: child_slot\arena
            ---
            if: child_arena = 0
                return: c.LMX_SETTLE_INVALID
            if: lmx_stop_request(child, lmx_clock_ticks(), deadline) != c.LMX_THREAD_OK
                return: c.LMX_SETTLE_INVALID
            ---
            if: lmx_thread_lane_ended(child) != 0
                rec: lmx_settle_close_one_level(child, child_arena, lmx_thread_service(child), lmx_thread_manager(child), deadline)
                if: rec != c.LMX_SETTLE_OK
                    return: c.LMX_SETTLE_INVALID
                ---
                child_message: lmx_thread_message(child)
                if: child_message = 0
                    return: c.LMX_SETTLE_INVALID
                ---
                child_message\handoff_ready: 1
            else:
                live: 1
            ---
            index: index + 1U
        ---
        if: manager != 0
            api: lmx_manager_api((cast: (@: LmxManager) manager))
            if: api != 0 && api\round != 0
                if: api\round((cast: (@: LmxManager) manager), 1U, lmx_clock_ticks()) != c.LMX_MANAGER_OK
                    return: c.LMX_SETTLE_INVALID
                ---
            ---
        ---
        if: lmx_settle_children(t, arena, (cast: (@: LmxService) service), (cast: (@: LmxManager) manager), lmx_clock_ticks()) != c.LMX_SETTLE_OK
            return: c.LMX_SETTLE_INVALID
        ---
        if: lmx_thread_child_count(t) != 0U
            live: 1
        ---
    ---
return: c.LMX_SETTLE_OK

fn: lmx_settle_one (@: LmxThread parent; @: LmxArena parent_arena; @: LmxService service; @: LmxThread child; ulong: now) int
    @: LmxMsg message
    @: LmxSchedule slot
    @: LmxArena child_arena
    @@: void result
    int: outcome
    if: parent = 0 || parent_arena = 0 || child = 0
        return: c.LMX_SETTLE_INVALID
    message: lmx_thread_message(child)
    slot: child\slot
    if: message = 0 || slot = 0 || slot\arena = 0
        return: c.LMX_SETTLE_INVALID
    child_arena: slot\arena
    if: child\mail = 0
        return: c.LMX_SETTLE_INVALID
    ---
    if: lmx_thread_lane_ended(child) = 0
        return: c.LMX_SETTLE_DEFERRED
    ---
    if: lmx_thread_child_count(child) != 0U
        if: lmx_settle_children(child, child_arena, service, (cast: (@: LmxManager) lmx_thread_manager(child)), now) != c.LMX_SETTLE_OK
            return: c.LMX_SETTLE_INVALID
        if: lmx_thread_child_count(child) != 0U
            lmx_stop_children(child, now, lmx_thread_close_deadline(child))
            return: c.LMX_SETTLE_DEFERRED
        ---
    ---
    outcome: message\success
    # Mail owns pending delivery arenas. Closing it is therefore the FIRST irreversible terminal
    # act: it may refuse while releasing a malformed pending donor. Until it succeeds, the exact
    # child remains a member of its parent's Array, its service route remains registered, and its
    # own arena remains the sole owner of every range. That preserved state is the retry/diagnostic
    # handle; unregistering, unlinking or attaching before this point would lose it.
    if: lmx_thread_mail_close(child_arena, child) != c.LMX_POST_OK
        return: c.LMX_SETTLE_INVALID
    ---
    if: outcome != 0
        if: service != 0 && lmx_service_unregister(service, child) != c.LMX_SERVICE_OK
            return: c.LMX_SETTLE_INVALID
        ---
        if: lmx_thread_child_remove(parent, child) != c.LMX_THREAD_OK
            if: service != 0
                if: lmx_service_register(service, child, child_arena) != c.LMX_SERVICE_OK
                    return: c.LMX_SETTLE_INVALID
                ---
            ---
            return: c.LMX_SETTLE_INVALID
        ---
        if: child\result != 0
            result: child\result
            \result: 0
        ---
        lmx_arena_release(child_arena)
    else:
        # Mail is already quiescent. Only now may reversible membership/service acts begin, and
        # only after both have succeeded may the child's arena move into its parent.
        if: service != 0 && lmx_service_unregister(service, child) != c.LMX_SERVICE_OK
            return: c.LMX_SETTLE_INVALID
        ---
        if: lmx_thread_child_remove(parent, child) != c.LMX_THREAD_OK
            if: service != 0
                if: lmx_service_register(service, child, child_arena) != c.LMX_SERVICE_OK
                    return: c.LMX_SETTLE_INVALID
                ---
            ---
            return: c.LMX_SETTLE_INVALID
        ---
        if: lmx_child_handoff(parent_arena, child_arena, message) != c.LMX_CHILD_OK
            if: lmx_thread_child_add(parent, child, parent_arena) != c.LMX_THREAD_OK
                return: c.LMX_SETTLE_INVALID
            ---
            if: service != 0
                if: lmx_service_register(service, child, child_arena) != c.LMX_SERVICE_OK
                    return: c.LMX_SETTLE_INVALID
                ---
            ---
            return: c.LMX_SETTLE_INVALID
        ---
    ---
return: c.LMX_SETTLE_OK

fn: lmx_settle_children (@: LmxThread t; @: LmxArena parent_arena; @: LmxService service; @: LmxManager manager; ulong: now) int
    @: LmxThread child
    @: LmxMsg message
    size_t: index
    int: code
    if: t = 0 || parent_arena = 0
        return: c.LMX_SETTLE_INVALID
    lmx_poll_answer_children(t, now)
    index: 0U
    while: index < lmx_thread_child_count(t)
        child: lmx_thread_child_at(t, index)
        if: child = 0
            return: c.LMX_SETTLE_INVALID
        message: lmx_thread_message(child)
        if: child\stopped != 0U
            if: lmx_stop_close(child, now) != c.LMX_THREAD_OK
                return: c.LMX_SETTLE_INVALID
            ---
        ---
        # A retained orphan is still an ordinary member of this same Array, but its policy owns
        # the moment of reclamation. Root teardown clears `orphaned` before the standard cascade.
        if: child\orphaned != 0
            index: index + 1U
        else:
            if: lmx_settle_ready(message) != 0
                code: lmx_settle_one(t, parent_arena, service, child, now)
                if: code != c.LMX_SETTLE_OK
                    if: code != c.LMX_SETTLE_DEFERRED
                        return: code
                    ---
                    index: index + 1U
                ---
            else:
                index: index + 1U
            ---
        ---
    ---
return: c.LMX_SETTLE_OK
