# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: body_raw 0
        int: descriptor_raw 0
        int: body_fields 0
        int: descriptor_fields 0
)
@: shared data[0]
fn: A () int (return: 7)
fn: outer () int (fn: prepared; fn: inner () int (@: p (A)\A; return: 0)) (return: 0)
fn: descriptor (args: (); return: int; data: (fn: prepared; fn: inner () int (@: p (A)\A; return: 0)))
@: Hold (@: held outer; @: held_descriptor descriptor)
int: body_raw length(Hold\held\data\inner\code[0])
int: descriptor_raw length(Hold\held_descriptor\data\inner\code[0])
int: body_fields length(Hold\held\data)
int: descriptor_fields length(Hold\held_descriptor\data)

sub: main ()
    shared\Observed\body_raw := body_raw
    shared\Observed\descriptor_raw := descriptor_raw
    shared\Observed\body_fields := body_fields
    shared\Observed\descriptor_fields := descriptor_fields
main()
