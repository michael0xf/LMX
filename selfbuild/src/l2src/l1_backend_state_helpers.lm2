# Original: l1src/l1trans.lm1:400
fn: l1_throw_intern (const: (@: text c.LmP0Text)) int
    @: th_names_array char (cast: (@: char) (@ c.l1_th_names))
    @: th_ar_array int (cast: (@: int) (@ c.l1_th_ar))
    @: th_n_cell int (cast: (@: int) (@ c.l1_th_n))
    c.LmL1TextScratch64: buf_scratch
    int: i 0
    if: c.l1_ident_to_buf((cast: (@: char) buf_scratch\buffer), 64U, text) != 0
        return: (cast: (int) (0))
    while: i < th_n_cell[0]
        if: c.strcmp(th_names_array + i * 64, (cast: (const: @: char) buf_scratch\buffer)) = 0
            return: (cast: (int) (i + 1))
        i: i + 1
    if: th_n_cell[0] >= 32
        return: (cast: (int) (0))
    c.strcpy(th_names_array + th_n_cell[0] * 64, (cast: (const: @: char) buf_scratch\buffer))
    th_ar_array[th_n_cell[0]]: -1
    th_n_cell[0]: th_n_cell[0] + 1
    return: (cast: (int) (th_n_cell[0]))
end: l1_throw_intern

# Original: l1src/l1trans.lm1:421
fn: l1_arity_bind (int: code; int: n; const: (@: path char); const: (@: source_node c.LmP0Node)) int
    @: th_ar_array int (cast: (@: int) (@ c.l1_th_ar))
    @: th_n_cell int (cast: (@: int) (@ c.l1_th_n))
    int: prev
    if: code <= 0 || code > th_n_cell[0]
        return: (cast: (int) (1))
    if: n < 0 || n > 8
        return: (cast: (int) (c.l1_error(path, source_node, "throw payload is limited to 8 arguments")))
    prev: th_ar_array[code - 1]
    if: prev < 0
        th_ar_array[code - 1]: n
        return: (cast: (int) (0))
    if: prev != n
        return: (cast: (int) (c.l1_error(path, source_node, "throw payload arity mismatch")))
    return: (cast: (int) (0))
end: l1_arity_bind

