# The graph tool of the kernel implementation specification (slice 309, docs/kernel-implementation.*.md §11 item 0): the
# P0 parser, the builder of the clean graph, the kernel's interpreter over it and the emitter of a program over it, as
# one program beside the old pipeline. The unchanged ordinary message root calls the generated native methods unit
# (src/l2src/l2_graph_tool.lm2), as lmxtool.lm2 does; the builder of the clean graph is its own unit
# (src/l2src/l2_graph_build.lm2, shared with the hosted frontend).
include: "<stdio.h>" "<stdlib.h>" "<string.h>"
predef: "l2src/l2_graph_build.lm1"
predef: "l2src/l2_graph_tool.lm1"

MainLetter:
    char: []: []: mainArgs
end: MainLetter

MainLetter: m
receiveMessage: m
size_t: n length(m\mainArgs)
size_t: i 0U
size_t: j 0U
size_t: len 0U
@@: args char c.calloc(n + 1U, sizeof(@: char))
@: buf char 0
int: rc 2
while: i < n && args != 0
    len: length(m\mainArgs[i])
    buf: c.malloc(len + 1U)
    j: 0U
    while: buf != 0 && j < len
        buf[j]: m\mainArgs[i][j]
        j: j + 1U
    if: buf != 0
        buf[len]: (cast: (char) 0)
    args[i]: buf
    i: i + 1U
if: args != 0
    rc: c.lm_graph_main(args, (cast: (int) n))
sendMessage: exit(exit_code: rc; stdout: ""; stderr: "")
return
