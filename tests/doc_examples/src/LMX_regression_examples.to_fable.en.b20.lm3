Library:
    const: int: factor 3
    int: mutableValue 90
    Inputs:
        int: n
        return: int
    fn: TransformSignature Inputs
    Transform:
        int: n
        return: int
        apply:
            return: n * 3
    ---
    @: selected TransformSignature Transform\apply

Use:
    import: Library
    return: int
    demo:
        @: chosen TransformSignature Transform\apply
        return: chosen(4) + factor
