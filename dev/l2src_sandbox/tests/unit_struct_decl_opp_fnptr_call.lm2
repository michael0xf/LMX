predef: "l2src/tests/fnptr_local_forms.h.lm1"

# Opposite: colon fnptr assign stays assignment (not struct decl). Compact call still works.
fn: probe (const: @(L2TestAllocVTable av); size_t: n) @: void
    L2TestAllocFn: f
    f: av\alloc
    if: f = 0
        return: 0
    return: f(n)
end: probe

fn: main () int
    return: 0
end: main