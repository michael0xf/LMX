# The space of node is one for the whole activation, its nested bodies included (the book, node; plan M11 5b part 2): in
# the body of an if `node\hits := 6` writes the root's field, and the method reads 6 through node after it.
# наблюдение явной записью: локалы не публикуются (#flush-receiver-contract)
(
    Observed:
        int: hits 0
        int: r 0
)
int: hits 4
fn: f () int
    if: 1
        node\hits := 6
    return: node\hits
int: r f()

sub: main ()
    @: shared node[0]
    shared\Observed\hits := node\hits
    shared\Observed\r := r
main()
