--- a/l2trans.lm1
+++ b/l2trans.lm1
@@ -60817,6 +60817,25 @@ fn: l2_schema_width (int: schema) int
 return: 0

 fn: l2_schema_token_slot (int: schema) int
+    int: result
+    int: physical
+    int: followed 0
+    # A schema describes logical fields,not necessarily new physical storage.
+    # All catalog/reference/backend token consumers use the SAME current
+    # constructor-origin projection. Only retained physical evidence follows
+    # a copy;its receiving Model/schema is never a physical substitute.
+    while: l2_schema_kind(schema) = 2
+        result: l2_schema_index(schema)
+        if: result < 0 || result >= l2_mres_n || followed >= l2_mres_n
+            return: -1
+        if: l2_mres_source = 0
+            break
+        physical: l2_mres_source[result].layout
+        if: physical = -1
+            break
+        schema: physical
+        followed: followed + 1
+    ---
     # A method occurrence has no layout-token cell. Callers fail closed.
     if: l2_schema_kind(schema) = 3
         return: 0 - 1
