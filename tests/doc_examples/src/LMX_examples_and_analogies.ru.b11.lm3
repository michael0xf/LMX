PairOperation :: (int: a; int: b; return: int)

Candidate:
    int: b
    int: a
    return: int
    encode:
        return: b * 10 + a

SignatureProbe:
    return: int
    run:
        @PairOperation: selected Candidate\encode
        int: first selected(a := 2; b := 7)
        int: second Candidate\encode(a := 2; b := 7)
        return: first * 100 + second
