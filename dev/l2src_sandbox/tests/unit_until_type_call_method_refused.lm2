# E has no field and no statement, but `until` closes it: a call of E runs its loop (the author, Q54: declaring runs
# nothing, a call runs the loop). `x()` calls the merged copy's selected E
# body through its ordinary Structure-call route; the until exits immediately.
E: ()
until: 1 = 1
fn: g () int
    x: merge: E
    x()
    return: 7
end: g
int: r 0
r: g()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
