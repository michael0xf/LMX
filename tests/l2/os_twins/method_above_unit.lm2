# The unit twin of method_above_os.lm2: a method above calls the unit's own os_twice declared below. Entry 7.
fn: early (int: v) int
    return: os_twice(v) + 1
end: early
fn: os_twice (int: x) int
    return: x + x
end: os_twice
sendMessage: exit(exit_code: early(3); stdout: ""; stderr: "")
return
