# lmxtool: the maintained L2 tool of the LMX builds and checks (the author, 2026-10-22: tests and scripts in
# L2/L3). Slice 170: the platform adapter -- one os block (L2 section 20), each method one contract with a body
# per platform -- hashing and the adapter's self-tests. Commands: selftest, sha256 FILE, and the child
# commands the self-tests run (echo-args, exit-with, streams, cwd, sleep-ms, sleep-touch).
# Parts: text.lm2, winargs.lm2, sha256.lm2. Link: -lshell32 -lbcrypt on Windows.
include: "<stdio.h>"
include: "<stdlib.h>"
include: "<string.h>"

os:
    win:
        include: "<windows.h>"
        include: "<bcrypt.h>"
        # UTF-8 text as the platform's API text (UTF-16 here) on the heap, or 0 (no memory, not UTF-8).
        fn: os_native (@: s char) @: c.void
            int: n c.MultiByteToWideChar(c.CP_UTF8, c.MB_ERR_INVALID_CHARS, s, -1, 0, 0)
            @: w c.WCHAR 0
            if: n <= 0
                return: 0
            w: c.calloc((cast: (size_t) n), c.sizeof(c.WCHAR))
            if: w = 0
                return: 0
            if: c.MultiByteToWideChar(c.CP_UTF8, c.MB_ERR_INVALID_CHARS, s, -1, w, n) != n
                c.free(w)
                return: 0
            return: (cast: (@: void) w)
        end: os_native
        # The platform's API text as UTF-8 on the heap, or 0.
        fn: os_from_native (@: p c.void) @: char
            @: w c.WCHAR (cast: (@: c.WCHAR) p)
            int: n c.WideCharToMultiByte(c.CP_UTF8, 0, w, -1, 0, 0, 0, 0)
            @: s char 0
            if: n <= 0
                return: 0
            s: c.malloc((cast: (size_t) n))
            if: s = 0
                return: 0
            if: c.WideCharToMultiByte(c.CP_UTF8, 0, w, -1, s, n, 0, 0) != n
                c.free(s)
                return: 0
            return: s
        end: os_from_native
        # The process contract: exe (a path, no search) runs with argv[0 .. argc - 1] (argv[0] the name the
        # child sees), no shell, in cwd (0: this process's), stdin from the null device, stdout and stderr to
        # the files out_path and err_path (0: the null device; one path for both: one file), within timeout_ms
        # (0: none). The kind: 0 exited (detail[0] its exit code), 1 not started (detail[0] the OS error),
        # 2 stopped at the timeout with its whole process tree (detail[0] the timeout), 3 lost while waiting
        # (detail[0] the OS error; the tree is stopped), 4 not prepared (detail[0] the OS error or 0). The
        # child's handles and its job are this call's own and closed before it returns.
        fn: os_run (@: exe char; @@: argv char; int: argc; @: cwd char; @: out_path char; @: err_path char; unsigned: timeout_ms; @: detail int) int
            @: sa c.SECURITY_ATTRIBUTES c.calloc(1U, c.sizeof(c.SECURITY_ATTRIBUTES))
            @: si c.STARTUPINFOW c.calloc(1U, c.sizeof(c.STARTUPINFOW))
            @: pi c.PROCESS_INFORMATION c.calloc(1U, c.sizeof(c.PROCESS_INFORMATION))
            @: code unsigned c.calloc(1U, c.sizeof(c.unsigned))
            @: cmd char win_cmdline(argv, argc)
            @: wexe c.void os_native(exe)
            @: wnul c.void os_native("NUL")
            @: wcmd c.void 0
            @: wcwd c.void 0
            @: wout c.void 0
            @: werr c.void 0
            @: hin c.void c.INVALID_HANDLE_VALUE
            @: hout c.void c.INVALID_HANDLE_VALUE
            @: herr c.void c.INVALID_HANDLE_VALUE
            @: job c.void 0
            @: acct c.JOBOBJECT_BASIC_ACCOUNTING_INFORMATION c.calloc(1U, c.sizeof(c.JOBOBJECT_BASIC_ACCOUNTING_INFORMATION))
            int: kind -1
            int: shared 0
            int: started 0
            int: drain 0
            int: empty 0
            unsigned: limit c.INFINITE
            unsigned: w 0U
            detail[0]: 0
            if: cmd != 0
                wcmd: os_native(cmd)
            if: cwd != 0
                wcwd: os_native(cwd)
            if: out_path != 0
                wout: os_native(out_path)
            if: err_path != 0 && out_path != 0 && c.strcmp(out_path, err_path) = 0
                shared: 1
            if: err_path != 0 && shared = 0
                werr: os_native(err_path)
            if: sa = 0 || si = 0 || pi = 0 || code = 0 || acct = 0 || cmd = 0 || wexe = 0 || wnul = 0 || wcmd = 0
                kind: 4
            if: kind < 0 && ((cwd != 0 && wcwd = 0) || (out_path != 0 && wout = 0) || (err_path != 0 && shared = 0 && werr = 0))
                kind: 4
            if: kind < 0
                sa\nLength: c.sizeof(c.SECURITY_ATTRIBUTES)
                sa\bInheritHandle: c.TRUE
                hin: c.CreateFileW(wnul, c.GENERIC_READ, c.FILE_SHARE_READ | c.FILE_SHARE_WRITE, sa, c.OPEN_EXISTING, 0, 0)
                if: out_path = 0
                    hout: c.CreateFileW(wnul, c.GENERIC_WRITE, c.FILE_SHARE_READ | c.FILE_SHARE_WRITE, sa, c.OPEN_EXISTING, 0, 0)
                if: out_path != 0
                    hout: c.CreateFileW(wout, c.GENERIC_WRITE, c.FILE_SHARE_READ, sa, c.CREATE_ALWAYS, c.FILE_ATTRIBUTE_NORMAL, 0)
                if: shared != 0
                    herr: hout
                if: shared = 0 && err_path = 0
                    herr: c.CreateFileW(wnul, c.GENERIC_WRITE, c.FILE_SHARE_READ | c.FILE_SHARE_WRITE, sa, c.OPEN_EXISTING, 0, 0)
                if: shared = 0 && err_path != 0
                    herr: c.CreateFileW(werr, c.GENERIC_WRITE, c.FILE_SHARE_READ, sa, c.CREATE_ALWAYS, c.FILE_ATTRIBUTE_NORMAL, 0)
                if: hin = c.INVALID_HANDLE_VALUE || hout = c.INVALID_HANDLE_VALUE || herr = c.INVALID_HANDLE_VALUE
                    detail[0]: (cast: (int) c.GetLastError())
                    kind: 4
            ---
            if: kind < 0
                job: c.CreateJobObjectW(0, 0)
                if: job = 0
                    detail[0]: (cast: (int) c.GetLastError())
                    kind: 4
            ---
            if: kind < 0
                si\cb: c.sizeof(c.STARTUPINFOW)
                si\dwFlags: c.STARTF_USESTDHANDLES
                si\hStdInput: hin
                si\hStdOutput: hout
                si\hStdError: herr
                if: c.CreateProcessW(wexe, wcmd, 0, 0, c.TRUE, c.CREATE_NO_WINDOW | c.CREATE_SUSPENDED, 0, wcwd, si, pi) = 0
                    detail[0]: (cast: (int) c.GetLastError())
                    kind: 1
                ---
                if: kind < 0
                    started: 1
            ---
            # The child holds its own ends now; this process keeps none of them.
            if: hin != c.INVALID_HANDLE_VALUE
                c.CloseHandle(hin)
            if: hout != c.INVALID_HANDLE_VALUE
                c.CloseHandle(hout)
            if: shared = 0 && herr != c.INVALID_HANDLE_VALUE
                c.CloseHandle(herr)
            if: kind < 0 && (c.AssignProcessToJobObject(job, pi\hProcess) = 0 || c.ResumeThread(pi\hThread) = 0xffffffffU)
                detail[0]: (cast: (int) c.GetLastError())
                c.TerminateProcess(pi\hProcess, 1U)
                c.WaitForSingleObject(pi\hProcess, c.INFINITE)
                kind: 3
            if: kind < 0
                if: timeout_ms != 0U
                    limit: timeout_ms
                w: c.WaitForSingleObject(pi\hProcess, limit)
                if: w = c.WAIT_OBJECT_0
                    kind: 0
                    if: c.GetExitCodeProcess(pi\hProcess, (cast: (@: void) code) ) = 0
                        detail[0]: (cast: (int) c.GetLastError())
                        kind: 3
                    ---
                    if: kind = 0
                        detail[0]: (cast: (int) code[0])
                ---
                if: w = c.WAIT_TIMEOUT
                    c.TerminateJobObject(job, 1U)
                    c.WaitForSingleObject(pi\hProcess, c.INFINITE)
                    detail[0]: (cast: (int) timeout_ms)
                    kind: 2
                if: kind < 0
                    detail[0]: (cast: (int) c.GetLastError())
                    c.TerminateJobObject(job, 1U)
                    c.WaitForSingleObject(pi\hProcess, c.INFINITE)
                    kind: 3
            ---
            # The terminal state of the whole tree (refinement 3 of OPUS-CODEX-20261023-SLICE170): what the main
            # process left in its job is stopped too, and the job is waited for until it holds no process -- the
            # logs are complete when this returns -- at most 10 s, past which the kind is 3 (lost).
            if: started != 0 && job != 0
                c.TerminateJobObject(job, 1U)
                while: empty = 0 && drain < 2000
                    if: c.QueryInformationJobObject(job, c.JobObjectBasicAccountingInformation, (cast: (@: void) acct), (cast: (unsigned) c.sizeof(c.JOBOBJECT_BASIC_ACCOUNTING_INFORMATION)), 0) != 0 && acct\ActiveProcesses = 0U
                        empty: 1
                    if: empty = 0
                        c.Sleep(5U)
                    drain: drain + 1
                ---
                if: empty = 0 && kind != 1 && kind != 4
                    kind: 3
            ---
            if: started != 0
                c.CloseHandle(pi\hThread)
                c.CloseHandle(pi\hProcess)
            if: job != 0
                c.CloseHandle(job)
            c.free(sa)
            c.free(si)
            c.free(pi)
            c.free(code)
            c.free(acct)
            c.free(cmd)
            c.free(wexe)
            c.free(wnul)
            c.free(wcmd)
            c.free(wcwd)
            c.free(wout)
            c.free(werr)
            return: kind
        end: os_run
        # The directory at path made: 0 made or already a directory, else the OS error.
        fn: os_mkdir (@: path char) int
            @: w c.void os_native(path)
            int: r 0
            unsigned: e 0U
            if: w = 0
                return: -1
            if: c.CreateDirectoryW(w, 0) = 0
                e: c.GetLastError()
                r: (cast: (int) e)
                if: e = c.ERROR_ALREADY_EXISTS
                    r: 0
            ---
            c.free(w)
            return: r
        end: os_mkdir
        # Milliseconds of a monotonic clock (its steps are the system timer's).
        fn: os_now_ms () size_t
            return: (cast: (size_t) c.GetTickCount64())
        end: os_now_ms
        fn: os_sleep_ms (unsigned: ms) int
            c.Sleep(ms)
            return: 0
        end: os_sleep_ms
        # This process's working directory as UTF-8 on the heap, or 0.
        fn: os_cwd () @: char
            unsigned: n c.GetCurrentDirectoryW(0U, 0)
            @: w c.WCHAR 0
            @: s char 0
            if: n = 0U
                return: 0
            w: c.calloc((cast: (size_t) n), c.sizeof(c.WCHAR))
            if: w = 0
                return: 0
            if: c.GetCurrentDirectoryW(n, w) = 0U
                c.free(w)
                return: 0
            s: os_from_native((cast: (@: void) w))
            c.free(w)
            return: s
        end: os_cwd
        # This program's executable path as UTF-8 on the heap, or 0.
        fn: os_self () @: char
            unsigned: cap 260U
            unsigned: n 0U
            @: w c.WCHAR 0
            @: s char 0
            while: cap < 65536U
                w: c.calloc((cast: (size_t) cap), c.sizeof(c.WCHAR))
                if: w = 0
                    return: 0
                n: c.GetModuleFileNameW(0, w, cap)
                if: n > 0U && n < cap
                    s: os_from_native((cast: (@: void) w))
                    c.free(w)
                    return: s
                ---
                c.free(w)
                if: n = 0U
                    return: 0
                cap: 2U * cap
            return: 0
        end: os_self
        # The arguments this process was given after `--`, as the platform parses its command line: a line
        # `ARGC n` and a line `ARG i <hex of its UTF-8 bytes>` for each. 0 printed, 1 not.
        fn: os_args_print () int
            @: count int c.calloc(1U, c.sizeof(c.int))
            @@: list c.WCHAR 0
            @: s char 0
            @: hex char 0
            int: i 0
            int: at -1
            if: count = 0
                return: 1
            list: c.CommandLineToArgvW(c.GetCommandLineW(), count)
            if: list = 0
                c.free(count)
                return: 1
            while: i < count[0] && at < 0
                s: os_from_native((cast: (@: void) list[i]))
                if: s != 0 && c.strcmp(s, "--") = 0
                    at: i + 1
                c.free(s)
                i: i + 1
            ---
            if: at < 0
                at: count[0]
            c.printf("ARGC %d\n", count[0] - at)
            i: at
            while: i < count[0]
                s: os_from_native((cast: (@: void) list[i]))
                if: s = 0
                    c.LocalFree(list)
                    c.free(count)
                    return: 1
                hex: txt_hex(s, c.strlen(s))
                c.printf("ARG %d %s\n", i - at, hex)
                c.free(hex)
                c.free(s)
                i: i + 1
            ---
            c.LocalFree(list)
            c.free(count)
            return: 0
        end: os_args_print
        # The names of the files (not directories) in the directory dir, one per line in the file out_path, in
        # the platform's order. 0 listed, else the OS error.
        fn: os_list_dir (@: dir char; @: out_path char) int
            @: pattern char txt_cat(dir, "/*")
            @: wpat c.void 0
            @: fd c.WIN32_FIND_DATAW c.calloc(1U, c.sizeof(c.WIN32_FIND_DATAW))
            @: h c.void c.INVALID_HANDLE_VALUE
            @: out c.FILE 0
            @: name char 0
            unsigned: attrs 0U
            unsigned: e 0U
            int: r 0
            if: pattern = 0 || fd = 0
                return: -1
            wpat: os_native(pattern)
            out: c.fopen(out_path, "wb")
            if: wpat = 0 || out = 0
                r: -1
            if: r = 0
                h: c.FindFirstFileW(wpat, fd)
                if: h = c.INVALID_HANDLE_VALUE
                    r: (cast: (int) c.GetLastError())
            ---
            while: r = 0 && h != c.INVALID_HANDLE_VALUE
                attrs: (cast: (unsigned) fd\dwFileAttributes)
                if: (attrs & (cast: (unsigned) c.FILE_ATTRIBUTE_DIRECTORY)) = 0U
                    name: os_from_native((cast: (@: void) fd\cFileName))
                    if: name != 0
                        c.fprintf(out, "%s\n", name)
                    c.free(name)
                ---
                if: c.FindNextFileW(h, fd) = 0
                    e: c.GetLastError()
                    if: e != c.ERROR_NO_MORE_FILES
                        r: (cast: (int) e)
                    c.FindClose(h)
                    h: c.INVALID_HANDLE_VALUE
            ---
            if: out != 0 && c.fclose(out) != 0 && r = 0
                r: -1
            c.free(pattern)
            c.free(wpat)
            c.free(fd)
            return: r
        end: os_list_dir
        # A new file at path of off + 1 bytes, all zero: the last one written after a seek, so a length past
        # 32 bits needs no write of it all. 0, or 1.
        fn: os_file_at (@: path char; size_t: off) int
            @: f c.FILE c.fopen(path, "wb")
            int: r 1
            if: f = 0
                return: 1
            if: c._fseeki64(f, off, 0) = 0 && c.fputc(0, f) = 0
                r: 0
            if: c.fclose(f) != 0
                r: 1
            return: r
        end: os_file_at
        # The SHA-256 of the file at path as 64 lowercase hex digits and a NUL in out[0 .. 64] (the platform's
        # hash: CNG), the file read hash_chunk() bytes at a time into one buffer (the memory is the chunk's,
        # whatever the file's size; each BCryptHashData takes one chunk, so its 32-bit length never truncates).
        # 0 written, 1 not.
        fn: os_sha256_file (@: path char; @: out char) int
            @: f c.FILE c.fopen(path, "rb")
            @@: alg c.void c.calloc(1U, sizeof(@: void))
            @@: hh c.void c.calloc(1U, sizeof(@: void))
            @: digest char c.calloc(32U, 1U)
            @: buf char c.malloc(hash_chunk())
            @: hex char 0
            size_t: got 0U
            int: ok 0
            int: more 1
            int: r 1
            if: f != 0 && alg != 0 && hh != 0 && digest != 0 && buf != 0 && c.BCryptOpenAlgorithmProvider(alg, c.BCRYPT_SHA256_ALGORITHM, 0, 0U) = 0
                if: c.BCryptCreateHash(alg[0], hh, 0, 0U, 0, 0U, 0U) = 0
                    ok: 1
                    while: more != 0 && ok != 0
                        got: c.fread(buf, 1U, hash_chunk(), f)
                        if: got > 0U && c.BCryptHashData(hh[0], (cast: (@: void) buf), (cast: (unsigned) got), 0U) != 0
                            ok: 0
                        if: got = 0U
                            more: 0
                    ---
                    if: ok != 0 && c.ferror(f) = 0 && c.BCryptFinishHash(hh[0], (cast: (@: void) digest), 32U, 0U) = 0
                        hex: txt_hex(digest, 32U)
                        if: hex != 0
                            c.memcpy(out, hex, 65U)
                            r: 0
                        ---
                        c.free(hex)
                    ---
                    c.BCryptDestroyHash(hh[0])
                ---
                c.BCryptCloseAlgorithmProvider(alg[0], 0U)
            ---
            if: f != 0
                c.fclose(f)
            c.free(alg)
            c.free(hh)
            c.free(digest)
            c.free(buf)
            return: r
        end: os_sha256_file
    default:
        include: "<unistd.h>"
        include: "<sys/types.h>"
        include: "<sys/wait.h>"
        include: "<sys/stat.h>"
        include: "<fcntl.h>"
        include: "<signal.h>"
        include: "<errno.h>"
        include: "<time.h>"
        include: "<dirent.h>"
        # The C door names a type by one identifier, so the tagged C types of this branch are spelled through
        # defines (Q-C, Codex to OPUS-CODEX-20261023-SLICE170; the form measured on win with struct tm:
        # tests/l2/cdoor/define_struct_tm.lm2). This branch is translated with the tool and not executed here.
        define: LmxToolDirent struct dirent
        define: LmxToolStat struct stat
        define: LmxToolTimespec struct timespec
        # UTF-8 is the API text of this platform: a heap copy, or 0.
        fn: os_native (@: s char) @: c.void
            return: (cast: (@: void) txt_dup(s))
        end: os_native
        fn: os_from_native (@: p c.void) @: char
            return: txt_dup((cast: (@: char) p))
        end: os_from_native
        # The process contract of the win branch, by fork and execv: the child joins a process group of its
        # own (the whole tree is stopped at the timeout) and reports a failed start through a close-on-exec
        # pipe, so a start that failed is kind 1, not an exit code.
        fn: os_run (@: exe char; @@: argv char; int: argc; @: cwd char; @: out_path char; @: err_path char; unsigned: timeout_ms; @: detail int) int
            @@: list char c.calloc((cast: (size_t) (argc + 1)), sizeof(@: char))
            @: fds int c.calloc(2U, c.sizeof(c.int))
            @: status int c.calloc(1U, c.sizeof(c.int))
            @: err int c.calloc(1U, c.sizeof(c.int))
            int: pid 0
            int: fd 0
            int: i 0
            int: kind -1
            int: got 0
            unsigned: waited 0U
            detail[0]: 0
            if: list = 0 || fds = 0 || status = 0 || err = 0
                kind: 4
            if: kind < 0 && c.pipe(fds) != 0
                detail[0]: c.errno
                kind: 4
            if: kind < 0
                while: i < argc
                    list[i]: argv[i]
                    i: i + 1
                ---
                c.fcntl(fds[1], c.F_SETFD, c.FD_CLOEXEC)
                pid: c.fork()
                if: pid < 0
                    detail[0]: c.errno
                    kind: 1
                ---
                if: pid = 0
                    c.close(fds[0])
                    c.setpgid(0, 0)
                    if: cwd != 0 && c.chdir(cwd) != 0
                        err[0]: c.errno
                        c.write(fds[1], err, c.sizeof(c.int))
                        c._exit(127)
                    fd: c.open("/dev/null", c.O_RDONLY)
                    if: fd >= 0
                        c.dup2(fd, 0)
                    if: out_path != 0
                        fd: c.open(out_path, c.O_WRONLY | c.O_CREAT | c.O_TRUNC, 420)
                    if: out_path = 0
                        fd: c.open("/dev/null", c.O_WRONLY)
                    if: fd >= 0
                        c.dup2(fd, 1)
                    if: err_path != 0 && out_path != 0 && c.strcmp(out_path, err_path) = 0
                        c.dup2(1, 2)
                    if: err_path != 0 && (out_path = 0 || c.strcmp(out_path, err_path) != 0)
                        fd: c.open(err_path, c.O_WRONLY | c.O_CREAT | c.O_TRUNC, 420)
                        if: fd >= 0
                            c.dup2(fd, 2)
                    ---
                    if: err_path = 0
                        fd: c.open("/dev/null", c.O_WRONLY)
                        if: fd >= 0
                            c.dup2(fd, 2)
                    ---
                    c.execv(exe, list)
                    err[0]: c.errno
                    c.write(fds[1], err, c.sizeof(c.int))
                    c._exit(127)
            ---
            if: fds != 0
                c.close(fds[1])
            if: kind < 0 && pid > 0
                got: (cast: (int) c.read(fds[0], err, c.sizeof(c.int)))
                if: got = (cast: (int) c.sizeof(c.int))
                    c.waitpid(pid, status, 0)
                    detail[0]: err[0]
                    kind: 1
            ---
            while: kind < 0 && pid > 0
                got: c.waitpid(pid, status, c.WNOHANG)
                if: got = pid
                    kind: 0
                    detail[0]: 128 + (cast: (int) c.WTERMSIG(status[0]))
                    if: c.WIFEXITED(status[0])
                        detail[0]: c.WEXITSTATUS(status[0])
                ---
                if: got < 0
                    detail[0]: c.errno
                    c.kill(0 - pid, c.SIGKILL)
                    kind: 3
                ---
                if: kind < 0 && timeout_ms != 0U && waited >= timeout_ms
                    c.kill(0 - pid, c.SIGKILL)
                    c.waitpid(pid, status, 0)
                    detail[0]: (cast: (int) timeout_ms)
                    kind: 2
                ---
                if: kind < 0
                    c.usleep(10000U)
                    waited: waited + 10U
            ---
            if: fds != 0
                c.close(fds[0])
            c.free(list)
            c.free(fds)
            c.free(status)
            c.free(err)
            return: kind
        end: os_run
        fn: os_mkdir (@: path char) int
            if: c.mkdir(path, 511) = 0 || c.errno = c.EEXIST
                return: 0
            return: c.errno
        end: os_mkdir
        # Milliseconds of the monotonic clock (clock_gettime, CLOCK_MONOTONIC), or 0 when it cannot be read.
        fn: os_now_ms () size_t
            @: ts c.LmxToolTimespec c.calloc(1U, c.sizeof(c.LmxToolTimespec))
            size_t: ms 0U
            if: ts != 0 && c.clock_gettime(c.CLOCK_MONOTONIC, ts) = 0
                ms: (cast: (size_t) ts\tv_sec) * 1000U + (cast: (size_t) ts\tv_nsec) / 1000000U
            c.free(ts)
            return: ms
        end: os_now_ms
        fn: os_sleep_ms (unsigned: ms) int
            unsigned: left ms
            while: left > 0U
                if: left >= 1000U
                    c.usleep(999000U)
                    left: left - 999U
                if: left < 1000U && left > 0U
                    c.usleep(left * 1000U)
                    left: 0U
            ---
            return: 0
        end: os_sleep_ms
        fn: os_cwd () @: char
            size_t: cap 256U
            @: s char 0
            while: cap < 1048576U
                s: c.malloc(cap)
                if: s = 0
                    return: 0
                if: c.getcwd(s, cap) != 0
                    return: s
                c.free(s)
                cap: 2U * cap
            return: 0
        end: os_cwd
        # This program's executable path (Linux: /proc/self/exe; other systems OPEN), or 0.
        fn: os_self () @: char
            size_t: cap 256U
            @: s char 0
            int: n 0
            while: cap < 1048576U
                s: c.malloc(cap)
                if: s = 0
                    return: 0
                n: (cast: (int) c.readlink("/proc/self/exe", s, cap))
                if: n > 0 && (cast: (size_t) n) < cap
                    s[n]: (cast: (char) 0)
                    return: s
                ---
                c.free(s)
                if: n <= 0
                    return: 0
                cap: 2U * cap
            return: 0
        end: os_self
        # This platform hands main its arguments unparsed: they are printed from the program's own argv (the
        # root's), so this branch reports that it has no other view of them.
        fn: os_args_print () int
            return: 1
        end: os_args_print
        # The names of the files (not directories) in the directory dir, one per line in the file out_path, in
        # readdir's order (each name's stat decides). 0 listed, else errno (-1 when it says nothing).
        fn: os_list_dir (@: dir char; @: out_path char) int
            @: d c.DIR c.opendir(dir)
            @: e c.LmxToolDirent 0
            @: st c.LmxToolStat c.calloc(1U, c.sizeof(c.LmxToolStat))
            @: out c.FILE 0
            @: full char 0
            @: name char 0
            int: r 0
            if: d = 0 || st = 0
                r: c.errno
                if: r = 0
                    r: -1
                if: d != 0
                    c.closedir(d)
                c.free(st)
                return: r
            ---
            out: c.fopen(out_path, "wb")
            if: out = 0
                c.closedir(d)
                c.free(st)
                return: -1
            ---
            e: c.readdir(d)
            while: e != 0
                # The C member received by a declared place: an L2 actual is not one yet (C-DOOR-MEMBER-ACTUAL-UNTYPED).
                name: e\d_name
                full: txt_cat3(dir, "/", name)
                if: full != 0 && c.stat(full, st) = 0 && c.S_ISDIR(st\st_mode) = 0
                    c.fprintf(out, "%s\n", name)
                c.free(full)
                e: c.readdir(d)
            ---
            if: c.fclose(out) != 0
                r: -1
            c.closedir(d)
            c.free(st)
            return: r
        end: os_list_dir
        fn: os_file_at (@: path char; size_t: off) int
            @: f c.FILE c.fopen(path, "wb")
            int: r 1
            if: f = 0
                return: 1
            if: c.fseeko(f, off, 0) = 0 && c.fputc(0, f) = 0
                r: 0
            if: c.fclose(f) != 0
                r: 1
            return: r
        end: os_file_at
        # The L2 SHA-256 of the file at path, read hash_chunk() bytes at a time (sha256_stream): 0 written, 1 not.
        fn: os_sha256_file (@: path char; @: out char) int
            @: f c.FILE c.fopen(path, "rb")
            int: r 1
            if: f = 0
                return: 1
            r: sha256_stream(f, hash_chunk(), out)
            c.fclose(f)
            return: r
        end: os_sha256_file
end: os

# The bytes a file hash reads at a time (os_sha256_file of both branches): 1 MiB.
fn: hash_chunk () size_t
    return: 1048576U
end: hash_chunk

# The self-test's report: one line per check; a check answers 1 when it failed, and every test answers the
# sum of its checks (a unit field written by a callee is not reloaded by its caller: book sections 12, 14).
fn: check (int: ok; @: name char; @: why char) int
    if: ok != 0
        c.printf("PASS %s\n", name)
        return: 0
    c.printf("FAIL %s: %s\n", name, why)
    return: 1
end: check

# Whether the file at path holds the line `line`: at its start or after a newline, and ending the file or
# followed by LF or CRLF (a child's text-mode stdout ends its lines with CRLF on Windows).
fn: file_has_line (@: path char; @: line char) int
    @: len size_t c.calloc(1U, c.sizeof(c.size_t))
    @: data char 0
    size_t: n c.strlen(line)
    size_t: total 0U
    size_t: i 0U
    size_t: e 0U
    int: r 0
    if: len = 0
        return: 0
    data: file_read(path, len)
    if: data = 0
        c.free(len)
        return: 0
    total: len[0]
    while: r = 0 && i <= total
        e: i + n
        if: e <= total && c.strncmp(data + i, line, n) = 0
            if: e = total || data[e] = (cast: (char) 10) || (data[e] = (cast: (char) 13) && e + 1U < total && data[e + 1U] = (cast: (char) 10))
                r: 1
        ---
        while: i < total && data[i] != (cast: (char) 10)
            i: i + 1U
        i: i + 1U
    ---
    c.free(data)
    c.free(len)
    return: r
end: file_has_line

# Whether the file at path holds the text want anywhere.
fn: file_has (@: path char; @: want char) int
    @: len size_t c.calloc(1U, c.sizeof(c.size_t))
    @: data char 0
    int: r 0
    if: len = 0
        return: 0
    data: file_read(path, len)
    if: data != 0 && c.strstr(data, want) != 0
        r: 1
    c.free(data)
    c.free(len)
    return: r
end: file_has

# This program run as a child through the driver: `self 0 entry 0 -- command args...`.
fn: run_self (@: self char; @@: words char; int: nwords; @: cwd char; @: out char; @: err char; unsigned: timeout_ms; @: detail int) int
    @@: argv char c.calloc((cast: (size_t) (nwords + 5)), sizeof(@: char))
    int: i 0
    int: kind 0
    if: argv = 0
        return: 4
    argv[0]: self
    argv[1]: "0"
    argv[2]: "entry"
    argv[3]: "0"
    argv[4]: "--"
    while: i < nwords
        argv[5 + i]: words[i]
        i: i + 1
    kind: os_run(self, argv, nwords + 5, cwd, out, err, timeout_ms, detail)
    c.free(argv)
    return: kind
end: run_self

# The child's view of its arguments, through the platform's own parser of the command line the adapter
# wrote: spaces, an empty argument, shell metacharacters, quotes, non-ASCII text and backslashes before a
# quote and at the end.
fn: test_args (@: self char; @: dir char) int
    @@: words char c.calloc(8U, sizeof(@: char))
    @: detail int c.calloc(1U, c.sizeof(c.int))
    @: out char txt_path(dir, "args.out")
    @: err char txt_path(dir, "args.err")
    @: line char 0
    @: hex char 0
    size_t: hn 0U
    int: kind 0
    int: i 0
    int: f 0
    if: words = 0 || detail = 0 || out = 0 || err = 0
        return: check(0, "args", "no memory")
    words[0]: "echo-args"
    words[1]: "a b"
    words[2]: ""
    words[3]: "x&y|z<>^%!"
    words[4]: "q\"t"
    words[5]: "юникод ✓"
    words[6]: "tail\\"
    words[7]: "mid\\\"q"
    kind: run_self(self, words, 8, 0, out, err, 60000U, detail)
    f: f + check(kind = 0 && detail[0] = 0, "args: the child ran and exited 0", "kind or exit code")
    f: f + check(file_has_line(out, "ARGC 8"), "args: eight arguments after --", "ARGC")
    while: i < 8
        hex: txt_hex(words[i], c.strlen(words[i]))
        hn: c.strlen(hex)
        line: c.malloc(hn + 32U)
        c.snprintf(line, hn + 32U, "ARG %d %s", i, hex)
        f: f + check(file_has_line(out, line), line, "the child saw another argument")
        c.free(line)
        c.free(hex)
        i: i + 1
    ---
    c.free(words)
    c.free(detail)
    c.free(out)
    c.free(err)
    return: f
end: test_args

fn: test_exits (@: self char; @: dir char) int
    @@: words char c.calloc(2U, sizeof(@: char))
    @@: bare char c.calloc(1U, sizeof(@: char))
    @: detail int c.calloc(1U, c.sizeof(c.int))
    @: out char txt_path(dir, "exit.out")
    int: kind 0
    int: f 0
    if: words = 0 || bare = 0 || detail = 0 || out = 0
        return: check(0, "exits", "no memory")
    words[0]: "exit-with"
    words[1]: "3"
    kind: run_self(self, words, 2, 0, out, 0, 60000U, detail)
    f: f + check(kind = 0 && detail[0] = 1, "exit: a program exit 3 against `entry 0` is the driver's exit 1", "kind or exit code")
    f: f + check(file_has(out, "exit 3, expected 0"), "exit: the driver names the program's exit 3", "driver text")
    bare[0]: self
    kind: os_run(self, bare, 1, 0, out, 0, 60000U, detail)
    f: f + check(kind = 0 && detail[0] = 2, "exit: the driver without arguments exits 2", "kind or exit code")
    c.free(words)
    c.free(bare)
    c.free(detail)
    c.free(out)
    return: f
end: test_exits

fn: test_streams (@: self char; @: dir char) int
    @@: words char c.calloc(1U, sizeof(@: char))
    @: detail int c.calloc(1U, c.sizeof(c.int))
    @: out char txt_path(dir, "streams.out")
    @: err char txt_path(dir, "streams.err")
    @: both char txt_path(dir, "streams.both")
    int: kind 0
    int: f 0
    if: words = 0 || detail = 0 || out = 0 || err = 0 || both = 0
        return: check(0, "streams", "no memory")
    words[0]: "streams"
    kind: run_self(self, words, 1, 0, out, err, 60000U, detail)
    f: f + check(kind = 0 && detail[0] = 0, "streams: the child exited 0", "kind or exit code")
    f: f + check(file_has_line(out, "OUT-LINE") && file_has(out, "ERR-LINE") = 0, "streams: stdout holds the stdout line only", "stdout")
    f: f + check(file_has_line(err, "ERR-LINE") && file_has(err, "OUT-LINE") = 0, "streams: stderr holds the stderr line only", "stderr")
    kind: run_self(self, words, 1, 0, both, both, 60000U, detail)
    f: f + check(kind = 0 && file_has_line(both, "OUT-LINE") && file_has_line(both, "ERR-LINE"), "streams: one file takes both", "shared file")
    c.free(words)
    c.free(detail)
    c.free(out)
    c.free(err)
    c.free(both)
    return: f
end: test_streams

fn: test_cwd (@: self char; @: dir char) int
    @@: words char c.calloc(1U, sizeof(@: char))
    @: detail int c.calloc(1U, c.sizeof(c.int))
    @: place char txt_path(dir, "cwd dir")
    @: out char txt_path(dir, "cwd.out")
    @: here char 0
    @: want char 0
    int: kind 0
    int: f 0
    if: words = 0 || detail = 0 || place = 0 || out = 0
        return: check(0, "cwd", "no memory")
    f: f + check(os_mkdir(place) = 0, "cwd: a directory with a space made", "mkdir")
    words[0]: "cwd"
    kind: run_self(self, words, 1, place, out, 0, 60000U, detail)
    f: f + check(kind = 0 && detail[0] = 0, "cwd: the child exited 0", "kind or exit code")
    f: f + check(file_has(out, "cwd dir\r\n") || file_has(out, "cwd dir\n"), "cwd: the child ran in that directory", "child cwd")
    here: os_cwd()
    want: txt_cat("CWD ", here)
    f: f + check(file_has_line(out, want) = 0, "cwd: not in this process's directory", "child cwd")
    c.free(here)
    c.free(want)
    c.free(words)
    c.free(detail)
    c.free(place)
    c.free(out)
    return: f
end: test_cwd

fn: test_timeout (@: self char; @: dir char) int
    @@: words char c.calloc(3U, sizeof(@: char))
    @: detail int c.calloc(1U, c.sizeof(c.int))
    @: mark char txt_path(dir, "late.mark")
    size_t: t0 0U
    size_t: t1 0U
    int: kind 0
    int: f 0
    if: words = 0 || detail = 0 || mark = 0
        return: check(0, "timeout", "no memory")
    c.remove(mark)
    words[0]: "sleep-touch"
    words[1]: "3000"
    words[2]: mark
    t0: os_now_ms()
    kind: run_self(self, words, 3, 0, 0, 0, 500U, detail)
    t1: os_now_ms()
    f: f + check(kind = 2 && detail[0] = 500, "timeout: kind 2 at 500 ms", "kind")
    f: f + check(t1 - t0 < 2500U, "timeout: returned before the child's 3000 ms", "too late")
    os_sleep_ms(4000U)
    f: f + check(file_exists(mark) = 0, "timeout: the stopped child never wrote its mark", "the child lived on")
    c.free(words)
    c.free(detail)
    c.free(mark)
    return: f
end: test_timeout

fn: test_spawn_failure (@: dir char) int
    @@: argv char c.calloc(1U, sizeof(@: char))
    @: detail int c.calloc(1U, c.sizeof(c.int))
    @: missing char txt_path(dir, "no such program.exe")
    int: kind 0
    int: f 0
    if: argv = 0 || detail = 0 || missing = 0
        return: check(0, "spawn failure", "no memory")
    argv[0]: missing
    kind: os_run(missing, argv, 1, 0, 0, 0, 60000U, detail)
    f: f + check(kind = 1 && detail[0] != 0, "spawn failure: kind 1 with the OS error", "kind")
    c.free(argv)
    c.free(detail)
    c.free(missing)
    return: f
end: test_spawn_failure

# The L2 stream (sha256_stream) of the file at path in chunks of chunk bytes against sha256_bytes of its n bytes
# at data: a check.
fn: test_hash_stream (@: path char; @: data char; size_t: n; size_t: chunk; @: got char; @: mine char) int
    @: f c.FILE c.fopen(path, "rb")
    int: r 1
    if: f != 0
        r: sha256_stream(f, chunk, got)
        c.fclose(f)
    ---
    sha256_bytes(data, n, mine)
    return: check(r = 0 && c.strcmp(got, mine) = 0, txt_cat3("hash: the L2 stream of ", txt_int((cast: (int) n)), txt_cat3(" bytes in chunks of ", txt_int((cast: (int) chunk)), " equals the L2 digest")), got)
end: test_hash_stream

# The platform's file hash and the L2 SHA-256: the FIPS vectors; the padding boundaries 0, 1, 55, 56, 63, 64, 65
# and 1000 bytes, the platform's hash against the L2 one; the L2 stream in chunks of 1, 64 and 100 bytes; a
# chunk of 0 refused; the platform's stream around its chunk (1 MiB - 1, 1 MiB, 1 MiB + 1 bytes of i mod 251)
# and a file of 2^32 + 1 zero bytes, against digests measured by two independent implementations (Python's
# hashlib and GNU sha256sum, 2026-10-23: build2/opus_fix171/runs/refdigests-01).
fn: test_hash (@: dir char) int
    @: path char txt_path(dir, "hash.bin")
    @: got char c.calloc(65U, 1U)
    @: mine char c.calloc(65U, 1U)
    @: data char c.malloc(1048577U)
    @: sizes size_t c.calloc(8U, c.sizeof(c.size_t))
    @: chunks size_t c.calloc(3U, c.sizeof(c.size_t))
    @: want char 0
    @: big c.FILE 0
    size_t: n 0U
    size_t: at 251U
    size_t: far 65536U
    int: i 0
    int: j 0
    int: f 0
    if: path = 0 || got = 0 || mine = 0 || data = 0 || sizes = 0 || chunks = 0
        return: check(0, "hash", "no memory")
    file_write(path, data, 0U)
    f: f + check(os_sha256_file(path, got) = 0 && c.strcmp(got, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") = 0, "hash: empty file", got)
    file_write(path, "abc", 3U)
    f: f + check(os_sha256_file(path, got) = 0 && c.strcmp(got, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") = 0, "hash: abc", got)
    while: i < 1000
        data[i]: (cast: (char) (i * 7 + 3))
        i: i + 1
    sizes[0]: 0U
    sizes[1]: 1U
    sizes[2]: 55U
    sizes[3]: 56U
    sizes[4]: 63U
    sizes[5]: 64U
    sizes[6]: 65U
    sizes[7]: 1000U
    i: 0
    while: i < 8
        file_write(path, data, sizes[i])
        sha256_bytes(data, sizes[i], mine)
        f: f + check(os_sha256_file(path, got) = 0 && c.strcmp(got, mine) = 0, txt_cat3("hash: ", txt_int((cast: (int) sizes[i])), " bytes, the platform's hash equals the L2 one"), got)
        i: i + 1
    ---
    chunks[0]: 1U
    chunks[1]: 64U
    chunks[2]: 100U
    i: 0
    while: i < 8
        if: sizes[i] != 1U && sizes[i] != 55U && sizes[i] != 56U
            file_write(path, data, sizes[i])
            j: 0
            while: j < 3
                f: f + test_hash_stream(path, data, sizes[i], chunks[j], got, mine)
                j: j + 1
            ---
        ---
        i: i + 1
    ---
    big: c.fopen(path, "rb")
    f: f + check(big != 0 && sha256_stream(big, 0U, got) = 1, "hash: the L2 stream refuses a chunk of 0", "")
    if: big != 0
        c.fclose(big)
    # i mod 251 over 1 MiB + 1: 251 bytes by steps, then doubled by the C library.
    i: 0
    while: i < 251
        data[i]: (cast: (char) i)
        i: i + 1
    ---
    while: at < 1048577U
        n: at
        if: n > 1048577U - at
            n: 1048577U - at
        c.memcpy(data + at, data, n)
        at: at + n
    ---
    file_write(path, data, 1048575U)
    f: f + check(os_sha256_file(path, got) = 0 && c.strcmp(got, "8b55c6a2d3444092a316985030e00c1e6f8608eaf912c896dee7c374d440ed11") = 0, "hash: 1 MiB - 1 bytes (one chunk less one)", got)
    file_write(path, data, 1048576U)
    f: f + check(os_sha256_file(path, got) = 0 && c.strcmp(got, "631b84027d6b9e52b539c4e8373622d23032dfadc64d60af87339c9037e4f769") = 0, "hash: 1 MiB bytes (one chunk)", got)
    file_write(path, data, 1048577U)
    f: f + check(os_sha256_file(path, got) = 0 && c.strcmp(got, "5769f52bc3eef28afa39c6fc68cadb7d0bd69812ae3a3d71452f519ec3c7aa56") = 0, "hash: 1 MiB + 1 bytes (one chunk and one byte)", got)
    # 2^32 + 1 zero bytes: the byte at offset 2^32 written after a seek; the file removed after.
    far: far * 65536U
    want: txt_path(dir, "hash-4g.bin")
    i: os_file_at(want, far)
    f: f + check(i = 0 && os_sha256_file(want, got) = 0 && c.strcmp(got, "fbb82f7b353676bb562eb82157fcf0ea42c36492ca13ee56dbf82c08b6802c5c") = 0, "hash: 2^32 + 1 zero bytes (a length past 32 bits)", got)
    c.remove(want)
    c.free(path)
    c.free(got)
    c.free(mine)
    c.free(data)
    c.free(sizes)
    c.free(chunks)
    return: f
end: test_hash

# The evidence commands: a manifest and its verification (all equal, a changed file, a missing one), the
# executables a run record started (none a script host, a script host and a script), and byte and image
# identity (the image itself, another link time and checksum, another byte, no image).
fn: test_evidence (@: self char; @: dir char) int
    @: ev char txt_path(dir, "evidence")
    @: list char 0
    @: man char 0
    @: rec char 0
    @: copy char 0
    @: text char 0
    @: img char 0
    @: len size_t c.calloc(1U, c.sizeof(c.size_t))
    size_t: pe 0U
    int: f 0
    if: ev = 0 || len = 0
        return: check(0, "evidence", "no memory")
    os_mkdir(ev)
    list: txt_path(ev, "list.txt")
    man: txt_path(ev, "list.sha256")
    rec: txt_path(ev, "record.txt")
    copy: txt_path(ev, "copy.exe")
    file_write(txt_path(ev, "a.txt"), "alpha\n", 6U)
    file_write(txt_path(ev, "b.txt"), "beta\n", 5U)
    text: "# two files\na.txt\n\nb.txt\n"
    file_write(list, text, c.strlen(text))
    f: f + check(manifest_write(list, ev, man) = 0 && file_has_line(man, "b6a98d9ce9a2d9149288fa3df42d377c3e42737afdcdaf714e33c0a100b51060  a.txt") != 0 && file_has_line(man, "f2c82decdd7181cf98945929a62598db7e6b477e11f6e0eb0ae97020eff151ad  b.txt") != 0, "evidence: manifest of two files", man)
    f: f + check(manifest_verify(man, ev) = 0, "evidence: verify, all files equal", man)
    file_write(txt_path(ev, "b.txt"), "BETA\n", 5U)
    f: f + check(manifest_verify(man, ev) = 1, "evidence: verify, a changed file", man)
    c.remove(txt_path(ev, "a.txt"))
    f: f + check(manifest_verify(man, ev) = 2, "evidence: verify, a changed file and a missing one", man)
    f: f + check(manifest_write(list, ev, txt_path(ev, "again.sha256")) = 1, "evidence: manifest, a missing file", list)
    text: "$ C:/t/gcc.exe -c a.c -o a.o\n  kind 0 exit 0 log a.log\n$ C:/t/gcc.exe a.o -o a.exe\n$ C:/t/l1trans.exe a.lm1 a.c\n"
    file_write(rec, text, c.strlen(text))
    f: f + check(record_exes(rec) = 0, "evidence: deps, no script host started", rec)
    text: "$ C:/t/gcc.exe -c a.c\n$ C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -File t.ps1\n$ C:/t/run.py x\n"
    file_write(rec, text, c.strlen(text))
    f: f + check(record_exes(rec) = 2, "evidence: deps, a script host and a script", rec)
    f: f + check(dir_make(txt_path(ev, "deep/er/dir")) = 0 && file_write(txt_path(ev, "deep/er/dir/f.txt"), "x", 1U) = 0, "evidence: dir_make, a chain of new directories", ev)
    f: f + check(file_same(self, self) = 1, "evidence: same, a file and itself", self)
    f: f + check(file_same(txt_path(ev, "b.txt"), list) = 0, "evidence: same, two different files", list)
    f: f + check(exe_same(self, self) = 1, "evidence: exe-same, an image and itself", self)
    f: f + check(exe_same(list, self) = -1, "evidence: exe-same, no image", list)
    img: file_read(self, len)
    f: f + check(img != 0 && len[0] > 64U, "evidence: the image is read", self)
    if: img != 0 && len[0] > 64U
        pe: (cast: (size_t) (sha_byte(img, 60U) | (sha_byte(img, 61U) << 8) | (sha_byte(img, 62U) << 16) | (sha_byte(img, 63U) << 24)))
        img[pe + 8U]: (cast: (char) (img[pe + 8U] + 1))
        img[pe + 88U]: (cast: (char) (img[pe + 88U] + 1))
        file_write(copy, img, len[0])
        f: f + check(exe_same(self, copy) = 1 && file_same(self, copy) = 0, "evidence: exe-same, another link time and checksum", copy)
        img[len[0] - 1U]: (cast: (char) (img[len[0] - 1U] + 1))
        file_write(copy, img, len[0])
        f: f + check(exe_same(self, copy) = 0, "evidence: exe-same, another byte of the image", copy)
    ---
    c.free(img)
    c.free(len)
    f: f + test_record(self, ev)
    return: f
end: test_evidence

# A run record closed on its files (verify_record): the hashes of the executable, an input and the log hold; a
# changed input fails; only the last line about a path counts; an `exe-changed` line fails.
fn: test_record (@: self char; @: ev char) int
    @: rec char txt_path(ev, "closed.txt")
    @: a char txt_path(ev, "in.txt")
    @: b char txt_path(ev, "run.log")
    @: hs char c.calloc(65U, 1U)
    @: ha char c.calloc(65U, 1U)
    @: hb char c.calloc(65U, 1U)
    @: out c.FILE 0
    int: f 0
    if: rec = 0 || a = 0 || b = 0 || hs = 0 || ha = 0 || hb = 0
        return: check(0, "record", "no memory")
    file_write(a, "input\n", 6U)
    file_write(b, "log\n", 4U)
    if: os_sha256_file(self, hs) != 0 || os_sha256_file(a, ha) != 0 || os_sha256_file(b, hb) != 0
        return: check(0, "record", "cannot hash its files")
    out: c.fopen(rec, "wb")
    if: out = 0
        return: check(0, "record", rec)
    c.fprintf(out, "$ %s x\n  exe %s\n  in %s %s\n  kind 0 exit 0 log %s\n  log %s %s\n", self, hs, ha, a, b, hb, b)
    c.fclose(out)
    f: f + check(verify_record(rec) = 0, "record: the executable, an input and the log hold", rec)
    file_write(a, "changed\n", 8U)
    f: f + check(verify_record(rec) = 1, "record: a changed input fails", rec)
    out: c.fopen(rec, "wb")
    if: out = 0
        return: check(0, "record", rec)
    c.fprintf(out, "$ %s x\n  in %s %s\n  kind 0 exit 0 log %s\n  log %s %s\n  out %s %s\n", self, ha, b, b, hb, b, hb, b)
    c.fclose(out)
    f: f + check(verify_record(rec) = 0, "record: only the last line about a path counts", rec)
    out: c.fopen(rec, "wb")
    if: out = 0
        return: check(0, "record", rec)
    c.fprintf(out, "$ %s x\n  exe %s\n  exe-changed %s\n  kind 4 exit 0 log %s\n", self, hs, self, b)
    c.fclose(out)
    f: f + check(verify_record(rec) = 1, "record: an image changed while it ran fails", rec)
    return: f
end: test_record

# The suite's schema (R170-2) and its controls' evaluation (R170-3), without a build: each malformed row is a
# SCHEMA failure (ten rows, ten failures, nothing else); a list without rows fails; a missing source is an INFRA
# failure; ENTRY is a decimal C int over the whole range and nothing else; control_eval_r on failure lines.
fn: test_suite_schema (@: dir char) int
    @: sd char txt_path(dir, "schema")
    @: list char 0
    @: text char 0
    @: fail char 0
    @: e int c.calloc(1U, c.sizeof(c.int))
    @@: why char c.calloc(1U, sizeof(@: char))
    int: f 0
    int: x 0
    if: sd = 0 || e = 0 || why = 0
        return: check(0, "schema", "no memory")
    dir_make(sd)
    file_write(txt_path(sd, "x.lm2"), "return\n", 7U)
    file_write(txt_path(sd, "y.lm2"), "return\n", 7U)
    list: txt_path(sd, "bad.tsv")
    text: "# ten malformed rows\nbogus\tx.lm2\t7\tn\nruns\tx.lm2\t7\nruns\tx.lm2\t12a\tn\nruns\tx.lm2\t2147483648\tn\nruns\tx.lm2\t7\tq\nruns\tx.lm2\t7\tnn\nrefuses\tx.lm2\t\tn\ntwins\tx.lm2\t7\tnf\ty.lm2\t\ntwins\tx.lm2\t7\tnf\ty.lm2\ta,,b\nruns\tx.lm2\t7\tn\tx.lm2\textra\n"
    file_write(list, text, c.strlen(text))
    x: fixture_suite(list, sd, sd, sd, txt_path(sd, "fe.exe"), txt_path(sd, "rt.o"), txt_path(sd, "obs.o"), txt_path(sd, "out-bad"))
    fail: txt_path(sd, "out-bad/failures.tsv")
    f: f + check(x = 10 && control_eval_r(fail, "SCHEMA", why) = 0, "schema: ten malformed rows, ten SCHEMA failures and no other", txt_cat3(txt_int(x), " failures; ", why[0]))
    list: txt_path(sd, "empty.tsv")
    file_write(list, "# no row\n\n", 10U)
    x: fixture_suite(list, sd, sd, sd, txt_path(sd, "fe.exe"), txt_path(sd, "rt.o"), txt_path(sd, "obs.o"), txt_path(sd, "out-empty"))
    f: f + check(x = 1 && control_eval_r(txt_path(sd, "out-empty/failures.tsv"), "SCHEMA|no row", why) = 0, "schema: a list without rows fails", why[0])
    list: txt_path(sd, "missing.tsv")
    text: "runs\tmissing.lm2\t7\tn\n"
    file_write(list, text, c.strlen(text))
    x: fixture_suite(list, sd, sd, sd, txt_path(sd, "fe.exe"), txt_path(sd, "rt.o"), txt_path(sd, "obs.o"), txt_path(sd, "out-missing"))
    f: f + check(x = 1 && control_eval_r(txt_path(sd, "out-missing/failures.tsv"), "INFRA|a missing input", why) = 0, "schema: a missing source is an INFRA failure", why[0])
    f: f + check(parse_entry("-12", e) = 0 && e[0] = -12, "schema: ENTRY -12", "")
    f: f + check(parse_entry("1011", e) = 0 && e[0] = 1011, "schema: ENTRY 1011", "")
    f: f + check(parse_entry("2147483647", e) = 0 && e[0] = 2147483647, "schema: ENTRY INT_MAX", "")
    f: f + check(parse_entry("-2147483648", e) = 0 && e[0] = 0 - 2147483647 - 1, "schema: ENTRY INT_MIN", "")
    f: f + check(parse_entry("-0", e) = 0 && e[0] = 0, "schema: ENTRY -0", "")
    f: f + check(parse_entry("2147483648", e) != 0 && parse_entry("-2147483649", e) != 0 && parse_entry("99999999999999999999", e) != 0, "schema: ENTRY out of range refused", "")
    f: f + check(parse_entry("12a", e) != 0 && parse_entry("", e) != 0 && parse_entry("-", e) != 0 && parse_entry("+5", e) != 0 && parse_entry(" 5", e) != 0, "schema: ENTRY not a number refused", "")
    fail: txt_path(sd, "f.tsv")
    text: "EXIT\ta check\texit 4, expected 7\t-\nWALKED\tb check\twalked 0\t-\n"
    file_write(fail, text, c.strlen(text))
    f: f + check(control_eval_r(fail, "EXIT,WALKED|expected 7", why) = 0, "control: its classes and its needle", why[0])
    f: f + check(control_eval_r(fail, "EXIT", why) != 0, "control: a failure of another class", why[0])
    f: f + check(control_eval_r(fail, "EXIT,WALKED,NATIVE", why) != 0, "control: a class that does not occur", why[0])
    f: f + check(control_eval_r(fail, "EXIT,WALKED|expected 8", why) != 0, "control: a needle not said", why[0])
    f: f + check(control_eval_r(fail, "NOCLASS", why) != 0, "control: an expectation of no class", why[0])
    file_write(fail, "", 0U)
    f: f + check(control_eval_r(fail, "EXIT", why) != 0, "control: no failure", why[0])
    f: f + check(control_eval_r(txt_path(sd, "nothing.tsv"), "EXIT", why) != 0, "control: no failures file", why[0])
    return: f
end: test_suite_schema

# The replay's own verdicts, without a frontend: a row not of eight fields and a row whose name is no .lm2 are DIFFs
# said as MALFORMED; a row whose frontends cannot be started is a DIFF said as INFRA -- three rows, three DIFFs, none
# skipped and none SAME.
fn: test_replay_rows (@: dir char) int
    @: rd char txt_path(dir, "replay")
    @: sb char 0
    @: rows char 0
    @: text char 0
    @: res char 0
    int: f 0
    int: x 0
    if: rd = 0
        return: check(0, "replay", "no memory")
    sb: txt_path(rd, "sandbox")
    dir_make(txt_path(sb, "tests"))
    dir_make(txt_path(rd, "work"))
    file_write(txt_path(sb, "convert.lm2"), "return\n", 7U)
    file_write(txt_path(sb, "primitive.lm2"), "return\n", 7U)
    file_write(txt_path(sb, "convert_impl.lm2"), "return\n", 7U)
    file_write(txt_path(sb, "tests/x.lm2"), "return\n", 7U)
    rows: txt_path(rd, "rows.tsv")
    text: "short\tx\nnolm2\ta\t\t\t\t\t\t\nx.lm2\tx\t\t\t\t\t\t\n"
    file_write(rows, text, c.strlen(text))
    x: replay(rows, sb, txt_path(rd, "work"), txt_path(rd, "no-frontend-a.exe"), txt_path(rd, "no-frontend-b.exe"), txt_path(rd, "out"), 0, 3)
    res: txt_path(rd, "out/results.tsv")
    f: f + check(x = 3 && file_has_line(res, "TOTAL\t3 rows\t3 DIFF") != 0, "replay: three rows, three DIFFs", txt_int(x))
    f: f + check(file_has(res, "\tMALFORMED (2 fields;") != 0 && file_has(res, "\tMALFORMED (8 fields;") != 0, "replay: a short row and a row without a .lm2 name are MALFORMED", res)
    f: f + check(file_has(res, "\tINFRA\n") != 0 && file_has(res, "\tSAME\n") = 0, "replay: frontends that cannot be started are INFRA, not SAME", res)
    return: f
end: test_replay_rows

# The self-test in dir: the process contract with child (tools/l2/lmxchild.lm2 built, `build-child`; 0: this
# program, which waits for its own start -- tens of seconds at -O0), hashing and the evidence commands.
fn: selftest (@: dir char; @: child char) int
    @: self char os_self()
    @: run char child
    int: f 0
    if: self = 0
        return: check(0, "selftest", "no executable path")
    if: run = 0
        run: self
    if: dir_make(dir) != 0
        return: check(0, "selftest", "cannot make the work directory")
    f: f + test_args(run, dir)
    f: f + test_exits(run, dir)
    f: f + test_streams(run, dir)
    f: f + test_cwd(run, dir)
    f: f + test_timeout(run, dir)
    f: f + test_spawn_failure(dir)
    f: f + test_hash(dir)
    f: f + test_evidence(self, dir)
    f: f + test_suite_schema(dir)
    f: f + test_replay_rows(dir)
    c.printf("SELFTEST %d failures\n", f)
    c.free(self)
    return: f
end: selftest

# The commands a self-test runs this program as.
fn: child (@@: args char; int: n) int
    @: here char 0
    @: f c.FILE 0
    if: n >= 2 && c.strcmp(args[1], "echo-args") = 0
        return: os_args_print()
    if: n >= 3 && c.strcmp(args[1], "exit-with") = 0
        return: c.atoi(args[2])
    if: n >= 2 && c.strcmp(args[1], "streams") = 0
        c.fputs("OUT-LINE\n", c.stdout)
        c.fputs("ERR-LINE\n", c.stderr)
        return: 0
    if: n >= 2 && c.strcmp(args[1], "cwd") = 0
        here: os_cwd()
        if: here = 0
            return: 1
        c.printf("CWD %s\n", here)
        c.free(here)
        return: 0
    if: n >= 3 && c.strcmp(args[1], "sleep-ms") = 0
        return: os_sleep_ms((cast: (unsigned) c.atoi(args[2])))
    if: n >= 4 && c.strcmp(args[1], "sleep-touch") = 0
        os_sleep_ms((cast: (unsigned) c.atoi(args[2])))
        f: c.fopen(args[3], "wb")
        if: f != 0
            c.fclose(f)
        return: 0
    return: -1
end: child

fn: tool_main (@@: args char; int: n) int
    @: hex char c.calloc(65U, 1U)
    int: r 0
    if: hex = 0
        return: 2
    if: n >= 4 && c.strcmp(args[1], "selftest") = 0
        return: selftest(args[2], args[3])
    if: n >= 3 && c.strcmp(args[1], "selftest") = 0
        return: selftest(args[2], 0)
    if: n >= 8 && c.strcmp(args[1], "build-child") = 0
        if: bld_child(args[2], args[3], args[4], args[5], args[6], args[7]) != 0
            return: 1
        return: 0
    if: n >= 3 && c.strcmp(args[1], "sha256") = 0
        if: os_sha256_file(args[2], hex) != 0
            c.fprintf(c.stderr, "lmxtool: cannot hash %s\n", args[2])
            return: 1
        c.printf("%s  %s\n", hex, args[2])
        return: 0
    if: n >= 4 && c.strcmp(args[1], "rows") = 0
        r: rows_extract(args[2], args[3])
        c.printf("ROWS %d\n", r)
        if: r < 0
            return: 1
        return: 0
    if: n >= 5 && c.strcmp(args[1], "stage-copy") = 0
        if: stage_copy(args[2], args[3], args[4]) != 0
            return: 1
        return: 0
    if: n >= 5 && c.strcmp(args[1], "manifest") = 0
        if: manifest_write(args[2], args[3], args[4]) != 0
            return: 1
        return: 0
    if: n >= 4 && c.strcmp(args[1], "verify") = 0
        if: manifest_verify(args[2], args[3]) != 0
            return: 1
        return: 0
    if: n >= 3 && c.strcmp(args[1], "deps") = 0
        if: record_exes(args[2]) != 0
            return: 1
        return: 0
    if: n >= 14 && c.strcmp(args[1], "gate") = 0
        r: gate(args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11], args[12], args[13])
        if: r != 0
            return: 1
        return: 0
    if: n >= 3 && c.strcmp(args[1], "verify-record") = 0
        r: verify_record(args[2])
        if: r != 0
            return: 1
        return: 0
    if: n >= 4 && c.strcmp(args[1], "same") = 0
        r: file_same(args[2], args[3])
        c.printf("SAME %d %s %s\n", r, args[2], args[3])
        if: r != 1
            return: 1
        return: 0
    if: n >= 4 && c.strcmp(args[1], "exe-same") = 0
        r: exe_same(args[2], args[3])
        c.printf("EXE-SAME %d %s %s\n", r, args[2], args[3])
        if: r != 1
            return: 1
        return: 0
    if: n >= 6 && c.strcmp(args[1], "build-frontend") = 0
        if: bld_frontend(args[2], args[3], args[4], args[5]) != 0
            return: 1
        return: 0
    if: n >= 6 && c.strcmp(args[1], "build-runtime") = 0
        if: bld_runtime(args[2], args[3], args[4], args[5]) != 0
            return: 1
        return: 0
    if: n >= 8 && c.strcmp(args[1], "build-self") = 0
        if: bld_self(args[2], args[3], args[4], args[5], args[6], args[7]) != 0
            return: 1
        return: 0
    if: n >= 9 && c.strcmp(args[1], "suite") = 0
        if: n >= 10
            r: fixture_suite(args[2], args[3], args[4], args[5], args[6], args[7], args[9], args[8])
        if: n < 10
            r: fixture_suite(args[2], args[3], args[4], args[5], args[6], args[7], 0, args[8])
        if: r != 0
            return: 1
        return: 0
    if: n >= 12 && c.strcmp(args[1], "os-walk-witness") = 0
        r: os_walk_witness(args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], c.atoi(args[10]), args[11])
        if: r != 0
            return: 1
        return: 0
    if: n >= 10 && c.strcmp(args[1], "replay") = 0
        r: replay(args[2], args[3], args[4], args[5], args[6], args[7], c.atoi(args[8]), c.atoi(args[9]))
        if: r != 0
            return: 1
        return: 0
    if: n >= 8 && c.strcmp(args[1], "bootstrap") = 0
        if: n >= 9
            r: bootstrap(args[2], args[3], args[4], args[5], args[6], args[7], args[8])
        if: n < 9
            r: bootstrap(args[2], args[3], args[4], args[5], args[6], args[7], 0)
        if: r != 0
            return: 1
        return: 0
    if: n >= 10 && c.strcmp(args[1], "rebuild") = 0
        r: rebuild(args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9])
        if: r != 0
            return: 1
        return: 0
    r: child(args, n)
    if: r >= 0
        return: r
    c.fprintf(c.stderr, "lmxtool: usage: selftest DIR [CHILD] | build-child REPO STAGE BASE FRONTEND RUNTIME OUT | sha256 FILE | rows PS1 OUT | stage-copy MANIFEST FROM TO | manifest LIST ROOT OUT | verify MANIFEST ROOT | deps RECORD | same A B | exe-same A B | gate REPO STAGE BASE FRONTEND CENSUS-FRONTEND MUTANT-FRONTEND BOTH-FRONTEND RUNTIME OBSERVED LIST CENSUS-LIST OUT | replay ROWS SANDBOX WORK FRONTEND-A FRONTEND-B OUT FIRST COUNT | suite LIST REPO STAGE BASE FRONTEND RUNTIME OUT [OBSERVED] | os-walk-witness REPO STAGE BASE FRONTEND PROD OBS SOURCE OUT ENTRY SPEC | build-frontend REPO STAGE BASE LABEL | build-runtime REPO STAGE BASE LABEL | build-self REPO STAGE BASE FRONTEND RUNTIME LABEL | bootstrap quick|full REPO STAGE BASE LABEL SMOKE-LIST [FULL-LIST] | rebuild frontend|runtime|tool|none REPO STAGE BASE FRONTEND RUNTIME-DIR LABEL SMOKE-LIST\n")
    return: 2
end: tool_main

MainLetter:
    char: []: []: mainArgs
end: MainLetter

MainLetter: m
receiveMessage: m
size_t: n length(m\mainArgs)
size_t: i 0U
size_t: j 0U
size_t: len 0U
@@: args char c.calloc(n + 1U, sizeof(@: char))
@: buf char 0
int: rc 2
while: i < n && args != 0
    len: length(m\mainArgs[i])
    buf: c.malloc(len + 1U)
    j: 0U
    while: buf != 0 && j < len
        buf[j]: m\mainArgs[i][j]
        j: j + 1U
    if: buf != 0
        buf[len]: (cast: (char) 0)
    args[i]: buf
    i: i + 1U
if: args != 0
    rc: tool_main(args, (cast: (int) n))
sendMessage: exit(exit_code: rc; stdout: ""; stderr: "")
return
