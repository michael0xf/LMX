# OPUS-TYPED-BINDING-20260930-20, next_core_tasks.md §3 item 207: a formal: `mytest(o)` with an Other refused at translation
# when mytest reads b\value (the binding side is debt since K03 NS-ROLES-CALL, steps/defects.md#typed-binding-purpose-debt).
Model:
    size_t: value 1U
end: Model

Other:
    int: p 1
    int: q 2
end: Other

fn: mytest (Model: b) int
    int: out 0
    if: b\value = 1U
        out: 7
    return: out
end: mytest

fn: m () int
    o: merge: Other
    return: mytest(o)
end: m

sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
