Example:
    []int: left
    []int: right
    int: limit
    return: @
    run:
        throws: copy(compress\throws) copy(fuse\throws) SequenceSize
        if: length(left) != length(right)
            throw: SequenceSize()
        @: scores fuse(2 .* left .+ right .* right)
        return: compress(scores; scores .>= limit)
