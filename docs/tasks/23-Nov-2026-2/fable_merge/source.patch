diff --git a/patterns/05_cloud_and_resilience/extended_comparisons/source/lmx/097_retry_library_implementation_generalized.lm3 b/patterns/05_cloud_and_resilience/extended_comparisons/source/lmx/097_retry_library_implementation_generalized.lm3
