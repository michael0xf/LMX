    Lists:
        @: l0 (("ifndef NCJSON_H";"else");("Function-like macro has no independent C symbol; role: runtime_operation.");("LMX::netcdf");("ifndef NCJSON_H";"ifdef NCJDEBUG");("Unexpanded declaration/type/annotation macro; not an independently callable symbol.";"Static function in implementation portion, not a linked export.";"The installed public facade concatenates this declaration header with its retained libdispatch C implementation and selects OPTEXPORT static. Use a typed addressable shim including the generated netcdf_json.h/netcdf_proplist.h, not a guessed external symbol declaration.");("ifndef NCJSON_H");("The installed public facade concatenates this declaration header with its retained libdispatch C implementation and selects OPTEXPORT static. Use a typed addressable shim including the generated netcdf_json.h/netcdf_proplist.h, not a guessed external symbol declaration.";"C integer file/group IDs are owner-bound resources at the LMX boundary. Validate child variable/dimension/type IDs against that file/group; do not expose a process-global ncid as an unrestricted scalar capability.");("Function-like macro has no independent C symbol; role: name_or_type_generator.");("isolated header preprocessing; dependency includes masked");("ifndef NCJSON_H";"ifndef NETCDF_JSON_H");("This internal source-header branch is omitted from the installed NETCDF_JSON_H single-header facade. The retained contract is not a declaration available from canonical netcdf_json.h.");("This internal source-header branch is omitted from the installed NETCDF_JSON_H single-header facade. The retained contract is not a declaration available from canonical netcdf_json.h.";"C integer file/group IDs are owner-bound resources at the LMX boundary. Validate child variable/dimension/type IDs against that file/group; do not expose a process-global ncid as an unrestricted scalar capability.");("ifndef NCPROPLIST_H");("Callback type/slot, not an exported callable.");("ifndef NETCDF_FILTER_BUILD_H");("ifndef _NETCDF_");("ifndef NETCDF_DISPATCH_H");("C integer file/group IDs are owner-bound resources at the LMX boundary. Validate child variable/dimension/type IDs against that file/group; do not expose a process-global ncid as an unrestricted scalar capability.");("ifndef NETCDF_FILTER_BUILD_H";"ifndef NC_UNUSED");("Callback type/slot, not an exported callable.";"Internal helper or private header surface; keep out of direct L3 publication.");("Variadic API requires a fixed typed adapter; do not forward L3 values through C varargs.";"C integer file/group IDs are owner-bound resources at the LMX boundary. Validate child variable/dimension/type IDs against that file/group; do not expose a process-global ncid as an unrestricted scalar capability.");("ifndef NETCDF_MEM_H");("ifndef NETCDF_PAR_H");("ifndef NETCDF_FILTER_H");();("ifndef NCAUX_H");("The installed public facade concatenates this declaration header with its retained libdispatch C implementation and selects OPTEXPORT static. Use a typed addressable shim including the generated netcdf_json.h/netcdf_proplist.h, not a guessed external symbol declaration.";"C integer file/group IDs are owner-bound resources at the LMX boundary. Validate child variable/dimension/type IDs against that file/group; do not expose a process-global ncid as an unrestricted scalar capability.";"Callback typedef parameter(s): NCPtypefcn. Use an actor-owned trampoline/lifetime contract.");("ifndef _NETCDF_";"ifndef ncvarcpy");("ifndef NCVUTILS_H");("Static function in implementation portion, not a linked export."))
