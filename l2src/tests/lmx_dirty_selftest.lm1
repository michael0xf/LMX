predef: "l2src/lmx_dirty.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# The dirty cache and the checkpoint (spec 7.4, 21.6, 21.13; the gaps note's item 11).  What this
# file pins:
#
#   * a used own field has two homes: its exact backing occurrence and the body's C working local,
#     and the entry binds the two -- the stride is the ARENA's answer about the cell, read once at
#     bind time, so the store is typeless and a char field and an int field are published by the
#     same act;
#   * the checkpoint publishes ONLY the entries written since their last successful store -- a
#     write to the occurrence itself is not published back over, and a working local that was not
#     marked dirty is not published at all;
#   * a successful store clears the flag; an entry that cannot publish is reported and KEEPS its
#     flag, so the next checkpoint still knows there is something to carry;
#   * binding is refused for an address that is not a cell of the arena: there would be nothing to
#     publish into.

sub: dirty_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: dirty_check

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    LmxArena: arena
    @: LmxArena arena_at 0
    @: void int_cell 0
    @: void char_cell 0
    @: char table 0
    LmxDirty: first
    LmxDirty: second
    LmxDirty: unbound
    @: LmxDirty head 0
    # The records live in this frame and L1's `\` is a pointer step, so their fields are read
    # through a pointer -- the same spelling every by-value owner in this tree uses.
    @: LmxDirty dptr 0
    @: LmxDirty dptr2 0
    int: work_int 1
    char: work_char 65
    int: raw_value 7
    int: failures
    if: counts = 0
        return: 2
    memset((cast: (@: void) (@ arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ arena) != 0
        fputs("lmx_dirty: the arena did not open\n", l1_stdout())
        free(counts)
        return: 2
    ---
    arena_at: @ arena
    table: lmx_chars_new_owned(@ arena)
    int_cell: lmx_int_new_owned(@ arena)
    if: table = 0 || int_cell = 0
        free(counts)
        return: 2
    ---
    char_cell: lmx_char_cell_known(table, 33)
    if: char_cell = 0
        free(counts)
        return: 2
    ---
    lmx_int_store_known(int_cell, 1)

    # The binding: the cell and the body's own working value, with the stride the arena answers.
    dirty_check(counts, lmx_dirty_bind(arena_at, @ first, (cast: (@: void) (@ raw_value)), @ work_int) = c.LMX_DIRTY_INVALID, "an address that is not a cell of the arena was bound")
    dirty_check(counts, lmx_dirty_bind(arena_at, @ first, int_cell, 0) = c.LMX_DIRTY_INVALID, "an entry was bound to no working value")
    dirty_check(counts, lmx_dirty_bind(arena_at, @ first, int_cell, (cast: (@: void) (@ work_int))) = c.LMX_DIRTY_OK, "an int field was not bound")
    dptr: @ first
    dptr2: @ second
    dirty_check(counts, dptr\stride = c.sizeof(c.int), "the entry did not take the cell's own stride")
    dirty_check(counts, dptr\dirty = 0, "a freshly bound entry is dirty")

    # A write to the working local is what the checkpoint carries.
    work_int: 2
    dirty_check(counts, lmx_dirty_mark(@ first) = c.LMX_DIRTY_OK, "a working local could not be marked")
    dirty_check(counts, lmx_dirty_pending(@ first) = 1, "a marked field is not pending")
    dirty_check(counts, lmx_dirty_checkpoint(@ first) = c.LMX_DIRTY_OK, "the checkpoint refused")
    dirty_check(counts, lmx_int_value_known(int_cell) = 2, "the checkpoint did not publish the working value")
    dirty_check(counts, lmx_dirty_pending(@ first) = 0, "a successful store did not clear the flag")

    # Publish ONLY what was written since the last checkpoint: the occurrence's own later update
    # is not written back over, and a working local that was not marked is not published.
    lmx_int_store_known(int_cell, 3)
    work_int: 4
    dirty_check(counts, lmx_dirty_checkpoint(@ first) = c.LMX_DIRTY_OK, "the second checkpoint refused")
    dirty_check(counts, lmx_int_value_known(int_cell) = 3, "an unpublished working value was written over the occurrence")
    lmx_dirty_mark(@ first)
    dirty_check(counts, lmx_dirty_checkpoint(@ first) = c.LMX_DIRTY_OK, "the third checkpoint refused")
    dirty_check(counts, lmx_int_value_known(int_cell) = 4, "a marked working value was not published")

    # One act publishes every stride: a char field joins the chain and the same checkpoint carries
    # both, each at the stride the arena answered for its cell.
    dirty_check(counts, lmx_dirty_bind(arena_at, @ second, char_cell, (cast: (@: void) (@ work_char))) = c.LMX_DIRTY_OK, "a char field was not bound")
    dirty_check(counts, dptr2\stride = c.sizeof(c.char), "the char entry did not take the char stride")
    dirty_check(counts, lmx_dirty_link(@ first, @ second) = c.LMX_DIRTY_OK, "the chain did not link")
    work_char: 66
    lmx_dirty_mark(@ second)
    lmx_dirty_mark(@ first)
    work_int: 5
    dirty_check(counts, lmx_dirty_pending(@ first) = 1, "the chain does not see its second entry as pending")
    dirty_check(counts, lmx_dirty_checkpoint(@ first) = c.LMX_DIRTY_OK, "the chain checkpoint refused")
    dirty_check(counts, lmx_char_value_known(char_cell) = 66, "the char field was not published at its own stride")
    dirty_check(counts, lmx_int_value_known(int_cell) = 5, "the int field was not published beside it")
    dirty_check(counts, lmx_dirty_pending(@ first) = 0, "the chain checkpoint left something pending")

    # The chain's own refusals.
    dirty_check(counts, lmx_dirty_link(@ first, @ second) = c.LMX_DIRTY_INVALID, "an entry already in a chain was linked again")
    dirty_check(counts, lmx_dirty_link(@ first, @ first) = c.LMX_DIRTY_INVALID, "an entry was linked to itself")
    dirty_check(counts, lmx_dirty_checkpoint(0) = c.LMX_DIRTY_OK, "an empty chain refused a checkpoint")
    dirty_check(counts, lmx_dirty_pending(0) = 0, "an empty chain has something pending")

    # An entry that cannot publish is reported and KEEPS its flag: the next checkpoint knows.
    dirty_check(counts, lmx_dirty_mark(@ unbound) = c.LMX_DIRTY_OK, "an unbound entry could not be marked")
    dirty_check(counts, lmx_dirty_checkpoint(@ unbound) = c.LMX_DIRTY_INVALID, "an unbound entry published anyway")
    dirty_check(counts, lmx_dirty_pending(@ unbound) = 1, "a failed store cleared the flag")

    failures: counts[1]
    c.printf("lmx_dirty checks=%d failures=%d\n", counts[0], failures)
    free(counts)
    lmx_arena_release(@ arena)
return: failures
