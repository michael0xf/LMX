predef: "l2src/lmx_walk.h.lm1"
predef: "l2src/lmx_call.h.lm1"
predef: "l2src/lmx_implements.h.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_chars.lm1"
predef: "l2src/lmx_scratch.lm1"
predef: "l2src/lmx_primitive.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<string.h>"

prototype:
    fn: lmx_walk_arg_arity (@: LmxWalkFrame f; @: Lmx node) size_t
    fn: lmx_walk_call0_dispatch (@: LmxArena arena; @: Lmx callable) int
    fn: lmx_walk_call_prim_dispatch (@: LmxArena arena; @: Lmx code; @: Lmx data; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    fn: lmx_walk_active_over (@: LmxWalkFrame f; @: Lmx data) int
    fn: lmx_walk_catch_count (@: LmxWalkFrame f; @: void cell; @: size_t out) int
    fn: lmx_walk_callable_addr (@: LmxArena arena; @: Lmx node) LmxEntry
    fn: lmx_walk_empty (@: LmxWalkFrame f; @: Lmx code; @: void dest; @@: void out) int
    fn: lmx_walk_data_holder (@: LmxWalkFrame f; @: void holder) @: void
    fn: lmx_walk_body (@: LmxWalkFrame f; @: Lmx body; size_t: first) int
    fn: lmx_walk_admit_against (@: LmxArena arena; @: Lmx value; @: Lmx model; @@: void out) int
    fn: lmx_walk_admit_op (@: LmxWalkFrame f; @: Lmx code; @: void dest; @@: void out) int
    fn: lmx_walk_admit_resolve (@: LmxArena arena; @: void raw; @@: void out_value) int
    fn: lmx_walk_immutable (@: LmxWalkFrame f; @: void p) int
end: prototype

# k.4 (author, next_core_tasks.md §3 item 8): dispatch is the word alone, non-null ->
# native, null -> walk; there is no separate "is this callable" question any more.
fn: lmx_walk_callable_addr (@: LmxArena arena; @: Lmx node) LmxEntry
    if: node = 0
        return: 0
return: node\native

# lmx_walk.lm1 - one activation of the graph interpreter.  The contract, its sources and
# the limits of this slice are in lmx_walk.h.lm1.

# ---- construction of body nodes --------------------------------------------------------

fn: lmx_walk_plain (@: LmxArena arena; @: Lmx parent; size_t: children) @: Lmx
    @: Lmx s 0
    if: arena = 0 || parent = 0
        return: 0
    s: lmx_struct_new_owned(parent, arena)
    if: s = 0
        return: 0
    if: children != 0U && lmx_arena_refs_open_owned(arena, s, children) != 0
        return: 0
return: s

# One record per role, made once: child k of the result is THE record of role k, and it
# is the address of that record that a frame node carries.
fn: lmx_walk_roles_open (@: LmxArena arena) @: Lmx
    @: Lmx roles 0
    @: LmxOp role 0
    int: k 1
    if: arena = 0
        return: 0
    roles: lmx_node_new_owned(arena)
    if: roles = 0 || lmx_arena_refs_open_owned(arena, roles, (cast: (size_t) c.LMX_WALK_OP_COUNT)) != 0
        return: 0
    while: k < c.LMX_WALK_OP_COUNT
        role: lmx_op_new_owned(arena, k)
        if: role = 0 || lmx_arena_ref_store(roles, (cast: (size_t) k), (cast: (@: void) role)) != 0
            return: 0
        k: k + 1
    ---
    lmx_call_install_walk((cast: (LmxCallWalkFn) lmx_walk_call0_dispatch))
    lmx_call_install_prim_walk((cast: (LmxCallPrimWalkFn) lmx_walk_call_prim_dispatch))
return: roles

# Program-stable roles for op dispatch (call0 / thread): address identity of role records
# must match the body.  Bind once per program (selftest, L3 bind) before building
# bodies; call0 reads these.
@: Lmx lmx_walk_program_roles_g 0

fn: lmx_walk_program_bind (@: Lmx roles) void
    lmx_walk_program_roles_g: roles
    lmx_call_install_walk((cast: (LmxCallWalkFn) lmx_walk_call0_dispatch))
    lmx_call_install_prim_walk((cast: (LmxCallPrimWalkFn) lmx_walk_call_prim_dispatch))

fn: lmx_walk_program_roles () @: Lmx
return: lmx_walk_program_roles_g

# Descriptor-dispatch body for lmx_call0 (addr=0): ephemeral scratch, program-bound
# roles, run; return last expression as int (LmxWalkValue.number / int cell).  k.4: no
# plan, no prepare -- executing what was given is entry's whole job (lmx_walk_enter).
fn: lmx_walk_call0_dispatch (@: LmxArena arena; @: Lmx callable) int
    LmxArena: sa
    LmxPool: cells
    LmxScratch: scratch
    LmxWalkContext: ctx
    LmxWalkValue: wv
    @: Lmx roles 0
    @: void value 0
    int: st
    if: arena = 0 || callable = 0
        return: c.LMX_CALL_NOT_CALLABLE
    lmx_call_clear_walk_fail()
    roles: lmx_walk_program_roles()
    if: roles = 0
        roles: lmx_walk_roles_open(arena)
    ---
    if: roles = 0
        return: c.LMX_CALL_NOT_CALLABLE
    memset((cast: (@: void) (@ sa)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ scratch)), 0, c.sizeof(c.LmxScratch))
    memset((cast: (@: void) (@ ctx)), 0, c.sizeof(c.LmxWalkContext))
    memset((cast: (@: void) (@ wv)), 0, c.sizeof(c.LmxWalkValue))
    if: lmx_arena_open(@ sa) != 0
        return: c.LMX_CALL_NOT_CALLABLE
    if: lmx_scratch_open(@ scratch, @ sa, @ cells, 64U) != c.LMX_SCRATCH_OK
        lmx_arena_release(@ sa)
        return: c.LMX_CALL_NOT_CALLABLE
    ---
    ctx.arena: arena
    ctx.scratch: @ scratch
    ctx.roles: roles
    st: lmx_walk_run(@ ctx, callable, 0, 0U, @ wv)
    lmx_scratch_close(@ scratch)
    lmx_arena_release(@ sa)
    if: st != c.LMX_WALK_OK
        # G2/D-37: note_walk_fail X1s walker errors; throws decode to k on the turn channel.
        lmx_call_note_walk_fail(st)
        return: lmx_call_walk_fail_status()
    ---
    if: wv.present = 0
        return: 0
    ---
    value: wv.ref
    if: value = (cast: (@: void) (@ wv.number))
        return: wv.number
    ---
    if: value != 0 && lmx_domain_kind(arena, value) = c.LMX_KIND_PRIMITIVE && lmx_domain_type(arena, value) = c.LMX_TYPE_INT
        return: lmx_int_value_known(value)
    ---
return: 0

# Thin (arena, occurrence) entry for descriptor dispatch: ephemeral scratch,
# program-bound roles (or freshly opened when unbound), prepare + run.
fn: lmx_walk_frame (@: LmxArena arena; @: Lmx roles; @: Lmx parent; int: code; size_t: children) @: Lmx
    @: Lmx s 0
    @: void role 0
    if: roles = 0 || code <= c.LMX_WALK_OP_NONE || code >= c.LMX_WALK_OP_COUNT || children = 0U
        return: 0
    role: lmx_arena_ref_value(roles, (cast: (size_t) code))
    s: lmx_walk_plain(arena, parent, children)
    if: s = 0 || role = 0
        return: 0
    if: lmx_arena_ref_store(s, 0U, role) != 0
        return: 0
return: s

fn: lmx_walk_store_size (@: LmxArena arena; @: Lmx code; size_t: slot; size_t: value) int
    @: void cell lmx_size_new_owned(arena)
    if: cell = 0
        return: c.LMX_WALK_NOMEM
    if: lmx_size_store_known(cell, value) != 0 || lmx_arena_ref_store(code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
return: c.LMX_WALK_OK

fn: lmx_walk_store_int (@: LmxArena arena; @: Lmx code; size_t: slot; int: value) int
    @: void cell lmx_int_new_owned(arena)
    if: cell = 0
        return: c.LMX_WALK_NOMEM
    if: lmx_int_store_known(cell, value) != 0 || lmx_arena_ref_store(code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
return: c.LMX_WALK_OK


fn: lmx_walk_store_char (@: LmxArena arena; @: Lmx code; size_t: slot; int: value) int
    @: void cell 0
    if: arena = 0 || code = 0
        return: c.LMX_WALK_INVALID
    if: lmx_chars_init(arena) != 0 && lmx_arena_find(arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR) = 0
        return: c.LMX_WALK_NOMEM
    ---
    cell: lmx_char_cell(arena, value)
    if: cell = 0 || lmx_arena_ref_store(code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
return: c.LMX_WALK_OK

fn: lmx_walk_store_unsigned (@: LmxArena arena; @: Lmx code; size_t: slot; unsigned: value) int
    @: void cell lmx_unsigned_new_owned(arena)
    if: cell = 0
        return: c.LMX_WALK_NOMEM
    if: lmx_unsigned_store_known(cell, value) != 0 || lmx_arena_ref_store(code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
return: c.LMX_WALK_OK

fn: lmx_walk_store_ulong (@: LmxArena arena; @: Lmx code; size_t: slot; ulong: value) int
    @: void cell lmx_ulong_new_owned(arena)
    if: cell = 0
        return: c.LMX_WALK_NOMEM
    if: lmx_ulong_store_known(cell, value) != 0 || lmx_arena_ref_store(code, slot, cell) != 0
        return: c.LMX_WALK_INVALID
return: c.LMX_WALK_OK

# A value's C type is its CELL's, asked of the arena -- never a tag on the value (-167 A).
# Returns the LMX_TYPE_* for a numeric primitive cell, or 0 when the address is not one
# (pointer cell, Structure, unknown). Destination-passing temps (KIND_NONE) are not cells.
fn: lmx_walk_numeric_type (@: LmxArena arena; @: void cell) int
    int: kind
    int: ty
    if: arena = 0 || cell = 0
        return: 0
    kind: lmx_domain_kind(arena, cell)
    if: kind != c.LMX_KIND_PRIMITIVE
        return: 0
    ty: lmx_domain_type(arena, cell)
    if: ty = c.LMX_TYPE_INT || ty = c.LMX_TYPE_CHAR || ty = c.LMX_TYPE_SIZE_T || ty = c.LMX_TYPE_UNSIGNED || ty = c.LMX_TYPE_ULONG || ty = c.LMX_TYPE_UNSIGNED_CHAR
        return: ty
return: 0

# Load a numeric arena cell into the widest working width. INVALID when not numeric.
fn: lmx_walk_load_numeric (@: LmxArena arena; @: void cell; @: size_t out) int
    int: ty
    if: out = 0
        return: c.LMX_WALK_INVALID
    ty: lmx_walk_numeric_type(arena, cell)
    if: ty = 0
        return: c.LMX_WALK_INVALID
    if: ty = c.LMX_TYPE_INT
        \out: (cast: (size_t) lmx_int_value_known(cell))
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_CHAR
        \out: (cast: (size_t) lmx_char_value_known(cell))
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_UNSIGNED_CHAR
        \out: (cast: (size_t) lmx_uchar_value_known(cell))
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_SIZE_T
        \out: lmx_size_value_known(cell)
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_UNSIGNED
        \out: (cast: (size_t) lmx_unsigned_value_known(cell))
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_ULONG
        \out: (cast: (size_t) lmx_ulong_value_known(cell))
        return: c.LMX_WALK_OK
return: c.LMX_WALK_INVALID

# Value operand of PUT/SET: an arena numeric cell, or a destination-passing temp
# (unclassified address -- today's computed int in the caller's dest / spare).
fn: lmx_walk_load_operand (@: LmxArena arena; @: void cell; @: size_t out; @: int out_ty) int
    int: kind
    if: out = 0 || out_ty = 0
        return: c.LMX_WALK_INVALID
    if: arena = 0 || cell = 0
        return: c.LMX_WALK_INVALID
    kind: lmx_domain_kind(arena, cell)
    if: kind = c.LMX_KIND_NONE
        \out: (cast: (size_t) lmx_int_value_known(cell))
        \out_ty: c.LMX_TYPE_INT
        return: c.LMX_WALK_OK
    ---
    if: lmx_walk_load_numeric(arena, cell, out) != c.LMX_WALK_OK
        return: c.LMX_WALK_INVALID
    \out_ty: lmx_walk_numeric_type(arena, cell)
return: c.LMX_WALK_OK

# Mutate an existing mutable numeric cell by its arena type. Interned CHAR is not mutable.
fn: lmx_walk_store_numeric_into (@: LmxArena arena; @: void cell; size_t: value) int
    int: ty lmx_walk_numeric_type(arena, cell)
    if: ty = 0
        return: c.LMX_WALK_INVALID
    if: ty = c.LMX_TYPE_CHAR
        return: c.LMX_WALK_INVALID
    if: ty = c.LMX_TYPE_INT
        if: lmx_int_store_known(cell, (cast: (int) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_SIZE_T
        if: lmx_size_store_known(cell, (cast: (size_t) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_UNSIGNED
        if: lmx_unsigned_store_known(cell, (cast: (unsigned) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_ULONG
        if: lmx_ulong_store_known(cell, (cast: (ulong) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_UNSIGNED_CHAR
        if: lmx_uchar_store_known(cell, (cast: (unsigned) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
return: c.LMX_WALK_INVALID

# A raw, UNCLASSIFIED numeric store into `cell`, keyed by a TYPE THE CALLER ALREADY
# KNOWS (not re-derived from `cell` itself, unlike lmx_walk_store_numeric_into's own
# lmx_walk_numeric_type(arena, cell) gate) -- for a destination that is not necessarily
# an arena-classified cell at all (a dynamic caller's own local, a CALL trampoline's raw
# dest). Shared by lmx_walk_call_prim_dispatch (G-call, -194 к.4) and lmx_walk_call's
# own addr = 0 branch (K-RET, -194 к.5b) -- both copy a walked callee's numeric result
# out of whatever reference lmx_walk_activate handed back and into the caller's own
# destination, the same way the native path already does by construction. CHAR is
# refused here (interned/shared cells; never meant to be mutated in place) -- the two
# callers keep the reference instead in that case, never calling this for it.
fn: lmx_walk_store_numeric_raw (@: void cell; int: ty; size_t: value) int
    if: cell = 0 || ty = 0 || ty = c.LMX_TYPE_CHAR
        return: c.LMX_WALK_INVALID
    if: ty = c.LMX_TYPE_INT
        if: lmx_int_store_known(cell, (cast: (int) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_SIZE_T
        if: lmx_size_store_known(cell, value) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_UNSIGNED
        if: lmx_unsigned_store_known(cell, (cast: (unsigned) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_ULONG
        if: lmx_ulong_store_known(cell, (cast: (ulong) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_UNSIGNED_CHAR
        if: lmx_uchar_store_known(cell, (cast: (unsigned) value)) != 0
            return: c.LMX_WALK_INVALID
        return: c.LMX_WALK_OK
return: c.LMX_WALK_INVALID

# True when cell is a typed pointer primitive (POINTER_BASE+).
fn: lmx_walk_is_pointer_cell (@: LmxArena arena; @: void cell) int
    int: ty
    if: arena = 0 || cell = 0
        return: 0
    if: lmx_domain_kind(arena, cell) != c.LMX_KIND_PRIMITIVE
        return: 0
    ty: lmx_domain_type(arena, cell)
    if: ty < c.LMX_TYPE_POINTER_BASE
        return: 0
return: 1

# -188 k.2: immediate typed store into a Structure slot (was publish_slot at checkpoint).
# CHAR replaces the interned reference; other numerics mutate the cell.
fn: lmx_walk_store_slot (@: LmxArena arena; @@: void slot; size_t: value) int
    @: void cell 0
    int: ty
    if: arena = 0 || slot = 0 || slot[0] = 0
        return: c.LMX_WALK_INVALID
    cell: slot[0]
    ty: lmx_walk_numeric_type(arena, cell)
    if: ty = 0
        return: c.LMX_WALK_INVALID
    if: ty = c.LMX_TYPE_CHAR
        if: lmx_chars_init(arena) != 0 && lmx_arena_find(arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR) = 0
            return: c.LMX_WALK_NOMEM
        ---
        cell: lmx_char_cell(arena, (cast: (int) (value & (cast: (size_t) 255))))
        if: cell = 0
            return: c.LMX_WALK_INVALID
        slot[0]: cell
        return: c.LMX_WALK_OK
return: lmx_walk_store_numeric_into(arena, cell, value)


# Publish an ADD/SUB result: int temps stay destination-passing; wider numerics get a
# fresh arena cell of the operand type (LT/EQ stay int and do not call this).
fn: lmx_walk_arith_out (@: LmxWalkFrame f; @: void dest; int: ty; size_t: value; @@: void out) int
    @: void cell 0
    if: f = 0 || dest = 0 || out = 0
        return: c.LMX_WALK_INVALID
    if: ty = c.LMX_TYPE_INT
        lmx_int_store_known(dest, (cast: (int) value))
        \out: dest
        return: c.LMX_WALK_OK
    if: lmx_walk_numeric_type(f\arena, dest) = ty
        if: lmx_walk_store_numeric_into(f\arena, dest, value) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        \out: dest
        return: c.LMX_WALK_OK
    ---
    if: ty = c.LMX_TYPE_SIZE_T
        cell: lmx_size_new_owned(f\arena)
        if: cell = 0 || lmx_size_store_known(cell, (cast: (size_t) value)) != 0
            return: c.LMX_WALK_NOMEM
        \out: cell
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_UNSIGNED
        cell: lmx_unsigned_new_owned(f\arena)
        if: cell = 0 || lmx_unsigned_store_known(cell, (cast: (unsigned) value)) != 0
            return: c.LMX_WALK_NOMEM
        \out: cell
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_ULONG
        cell: lmx_ulong_new_owned(f\arena)
        if: cell = 0 || lmx_ulong_store_known(cell, (cast: (ulong) value)) != 0
            return: c.LMX_WALK_NOMEM
        \out: cell
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_CHAR
        if: lmx_chars_init(f\arena) != 0 && lmx_arena_find(f\arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR) = 0
            return: c.LMX_WALK_NOMEM
        ---
        cell: lmx_char_cell(f\arena, (cast: (int) (value & (cast: (size_t) 255))))
        if: cell = 0
            return: c.LMX_WALK_INVALID
        \out: cell
        return: c.LMX_WALK_OK
    if: ty = c.LMX_TYPE_UNSIGNED_CHAR
        cell: lmx_uchar_new_owned(f\arena)
        if: cell = 0 || lmx_uchar_store_known(cell, (cast: (unsigned) value)) != 0
            return: c.LMX_WALK_NOMEM
        \out: cell
        return: c.LMX_WALK_OK
return: c.LMX_WALK_INVALID

# ---- recognition and field references --------------------------------------------------

# The one door through which this unit asks the arena's index what an address is.  The
# count lets a test state exactly how many questions an entry costs (acceptance test H).
fn: lmx_walk_kind (@: LmxWalkFrame f; @: void p) int
    f\context\classified: f\context\classified + 1U
return: lmx_range_classify(f\arena, p)

# Which of the program's roles `head` IS: the address compared with the role records, in
# the order of the discriminators.  Nothing is dereferenced and nothing is classified.
fn: lmx_walk_role (@: LmxWalkFrame f; @: void head) int
    @@: void records 0
    int: k 1
    if: f = 0 || head = 0 || f\roles = 0 || f\roles\array.data = 0
        return: c.LMX_WALK_OP_NONE
    records: (cast: (@@: void) f\roles\array.data)
    while: k < c.LMX_WALK_OP_COUNT && (cast: (size_t) k) < f\roles\array.size
        if: records[k] = head
            return: k
        k: k + 1
    ---
return: c.LMX_WALK_OP_NONE

# The role of an OPERAND: a node at a position its parent's role fixes.  It is read as a
# node without asking the arena (see the header).  UNKNOWN when its child[0] is an op
# record of a role this program does not have; NONE when it is no frame node at all.
fn: lmx_walk_head (@: LmxWalkFrame f; @: Lmx s) int
    @: void head lmx_arena_ref_value(s, 0U)
    int: k
    k: lmx_walk_role(f, head)
    if: k != c.LMX_WALK_OP_NONE
        return: k
    if: head != 0 && lmx_walk_kind(f, head) = c.LMX_DOMAIN_KIND_OP
        return: c.LMX_WALK_OP_UNKNOWN
return: c.LMX_WALK_OP_NONE

# §7b, book §12 (the `9 0` order): an actual argument is a typed temporary, evaluated before the publication that
# precedes the transfer (CALL, PRIM_PUB).  An explicit graph read -- AT, OF, DEREF -- gives a reference to the cell
# itself, which that publication may write; the number it reads is taken now into the operand's own temporary `dest`,
# as an arithmetic result is (lmx_walk_arith_out: an int destination-passing, a wider number a fresh cell).  Anything
# else -- a working value, a literal, a result, a Structure, a reference -- stays what it is.
fn: lmx_walk_arg_value (@: LmxWalkFrame f; @: void node; @: void dest; @@: void ref) int
    int: op
    int: ty
    size_t: v 0U
    if: f = 0 || node = 0 || dest = 0 || ref = 0 || ref[0] = 0
        return: c.LMX_WALK_OK
    op: lmx_walk_op(f, node)
    if: op != c.LMX_WALK_OP_AT && op != c.LMX_WALK_OP_OF && op != c.LMX_WALK_OP_DEREF
        return: c.LMX_WALK_OK
    ty: lmx_walk_numeric_type(f\arena, ref[0])
    if: ty = 0
        return: c.LMX_WALK_OK
    if: lmx_walk_load_numeric(f\arena, ref[0], @ v) != c.LMX_WALK_OK
        return: c.LMX_WALK_INVALID
return: lmx_walk_arith_out(f, dest, ty, v, ref)

fn: lmx_walk_node (@: LmxWalkFrame f; @: void node) int
    int: k
    if: f = 0 || node = 0
        return: c.LMX_WALK_OP_NONE
    k: lmx_walk_role(f, node)
    if: k != c.LMX_WALK_OP_NONE
        return: k
return: lmx_walk_head(f, (cast: (@: Lmx) node))

# The role of a FIELD OF A BODY, where own cells and frame nodes stand mixed: NONE for
# anything that is not a frame node (an own cell, a plain Structure, a nested callable's
# M); UNKNOWN for a step of a role this program does not have -- refused, never skipped.
# This is the one place the arena's index is asked, once, whether the field is a
# Structure; a bare role record is recognised before that, by its address.
fn: lmx_walk_op (@: LmxWalkFrame f; @: void code) int
    int: kind
    int: k
    if: f = 0 || code = 0
        return: c.LMX_WALK_OP_NONE
    k: lmx_walk_role(f, code)
    if: k != c.LMX_WALK_OP_NONE
        return: k
    kind: lmx_walk_kind(f, code)
    if: kind = c.LMX_KIND_STRUCT
        return: lmx_walk_head(f, (cast: (@: Lmx) code))
    if: kind = c.LMX_DOMAIN_KIND_OP
        return: c.LMX_WALK_OP_UNKNOWN
return: c.LMX_WALK_OP_NONE

# Whether `node` is a bare role record rather than a Structure with a role in child[0].
fn: lmx_walk_bare (@: LmxWalkFrame f; @: void node) int
return: (cast: (int) (lmx_walk_role(f, node) != c.LMX_WALK_OP_NONE))

# The slot a node names by its two operands at `first`: the Structure that holds the
# field, by reference, and the number of the slot inside it.  k.4 (no cached plan, no
# membership set -- next_core_tasks.md §3 item 9): the holder must classify as a Structure
# and the index must be within its own `array.size`, asked here, every time, unconditionally --
# there is no separate counting/prepare pass left to have asked it once.  A translator
# mistake that names an operator node or a literal here fails this same check, since
# neither classifies as LMX_KIND_STRUCT.  `write` refuses a holder in the exact qualified
# immutable profile (lmx_walk_immutable); a read (`write = 0`) never does.
fn: lmx_walk_slot (@: LmxWalkFrame f; @: Lmx code; size_t: first; int: write) @@: void
    @: void holder 0
    size_t: index
    if: f = 0 || code = 0
        return: 0
    holder: lmx_arena_ref_value(code, first)
    # -188 k.3c: when holder is the running activation's code, use its data (f\node).
    # K-OT2 (-194 к.5): holder = 0 is no longer refused here outright -- it is now a
    # valid sentinel lmx_walk_data_holder resolves to this activation's own data;
    # the classify-as-Structure check just below still refuses it when that
    # resolution has nothing to give (f\node = 0).
    holder: lmx_walk_data_holder(f, holder)
    if: lmx_walk_kind(f, holder) != c.LMX_KIND_STRUCT
        return: 0
    ---
    # -177 c4 / D-54 X1: a fixed holder must be a plain Structure reference, not an OP node.
    # Mutant: accept DEREF as holder -> silent write into the node RED.
    if: lmx_walk_role(f, lmx_arena_ref_value((cast: (@: Lmx) holder), 0U)) > c.LMX_WALK_OP_NONE
        return: 0
    ---
    if: write != 0 && lmx_walk_immutable(f, holder) != 0
        return: 0
    ---
    index: lmx_size_value_known(lmx_arena_ref_value(code, first + 1U))
    if: index >= (cast: (@: Lmx) holder)\array.size
        return: 0
return: lmx_arena_ref_cell((cast: (@: Lmx) holder), index)

# k.4: OWN/SET/PUT target = data. A holder that names the running activation's CODE
# (physical identity with f\code -- no child[0]/CALLABLE indirection left to compare
# through) means its DATA instead.  Any other holder is a plain graph reference, unchanged.
# K-OT2 (-194 к.5): a frame naming NO holder at all (a literal 0 slot value -- T4's own
# form for a method's own-field frames, since the frame's code is shared by address
# (K-OT1) across every occurrence that runs it, and so cannot embed any ONE occurrence's
# address to compare) means "this activation's data" UNCONDITIONALLY, the same target
# the f\code-identity match resolves to above -- not "unchanged" (0), which no caller
# could ever use as a holder. This is what lets a merge result R correctly run frames it
# shares with its model M: the frame's holder was never M's address to begin with, so
# there is no identity to fail to match when the running code differs from M. A
# genuinely missing/never-stored holder slot (a translator defect, not T4's own
# sentinel) reads identically as 0 and is resolved the same way; T4 is this sentinel's
# only emitter and controls both cases, so the two are not otherwise distinguished here.
fn: lmx_walk_data_holder (@: LmxWalkFrame f; @: void holder) @: void
    if: f = 0
        return: holder
    ---
    if: holder = 0
        if: f\node = 0
            return: 0
        ---
        return: (cast: (@: void) f\node)
    ---
    if: f\code = 0 || f\node = 0
        return: holder
    ---
    if: holder != (cast: (@: void) f\code)
        return: holder
    ---
return: (cast: (@: void) f\node)

# §7b: the slot an own-field node names, with its holder and index.  OWN [own, holder, slot] names its holder by
# reference, under lmx_walk_slot's rules (a Structure, never an op node; `write` refuses the exact immutable
# profile).  OWN_OF [own_of, holder-expr, slot] and SET_OF [set_of, holder-expr, slot, value] evaluate theirs -- a
# nested body's Structure -- under the same rules.  Any other node is INVALID.
fn: lmx_walk_work_cell (@: LmxWalkFrame f; @: void node; int: write; @@: Lmx holder; @: size_t index; @@@: void slot) int
    @: Lmx code 0
    @: void value 0
    int: a 0
    int: op
    int: status
    if: f = 0 || node = 0 || holder = 0 || index = 0 || slot = 0
        return: c.LMX_WALK_INVALID
    \holder: 0
    \index: 0U
    \slot: 0
    op: lmx_walk_node(f, node)
    code: (cast: (@: Lmx) node)
    if: op = c.LMX_WALK_OP_OWN
        \slot: lmx_walk_slot(f, code, 1U, write)
        if: \slot = 0
            return: c.LMX_WALK_INVALID
        \holder: (cast: (@: Lmx) lmx_walk_data_holder(f, lmx_arena_ref_value(code, 1U)))
        \index: lmx_size_value_known(lmx_arena_ref_value(code, 2U))
        return: c.LMX_WALK_OK
    ---
    if: (op != c.LMX_WALK_OP_OWN_OF && op != c.LMX_WALK_OP_SET_OF) || code\array.size < 3U
        return: c.LMX_WALK_INVALID
    status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), (cast: (@: void) (@ a)), @ value)
    if: status != c.LMX_WALK_OK
        return: status
    if: value = 0 || lmx_walk_kind(f, value) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_INVALID
    if: write != 0 && lmx_walk_immutable(f, value) != 0
        return: c.LMX_WALK_INVALID
    \index: lmx_size_value_known(lmx_arena_ref_value(code, 2U))
    if: \index >= (cast: (@: Lmx) value)\array.size
        return: c.LMX_WALK_INVALID
    \holder: (cast: (@: Lmx) value)
    \slot: lmx_arena_ref_cell((cast: (@: Lmx) value), \index)
    if: \slot = 0
        return: c.LMX_WALK_INVALID
return: c.LMX_WALK_OK

# §7b: the working table's row of `slot`, or 0.
fn: lmx_walk_work_find (@: LmxWalkFrame f; @@: void slot) @: LmxWalkWork
    @: LmxWalkWork e 0
    if: f = 0 || slot = 0
        return: 0
    e: f\work
    while: e != 0
        if: e\slot = slot
            return: e
        e: e\next
    ---
return: 0

# §7b: one row of the working table, loaded now from `slot` (holder's child `index`) and clean, linked after the last
# row; a slot that already has one keeps it.  A number is kind 1 (its value and type), a pointer cell kind 2 (the
# reference it holds), a Structure slot kind 3 (the Structure, or 0 while empty).  The row is taken from the scratch
# store after the activation's mark and is gone with its rewind.
fn: lmx_walk_work_make (@: LmxWalkFrame f; @: Lmx holder; size_t: index; @@: void slot) int
    @: void room 0
    @: LmxWalkWork e 0
    @: LmxWalkWork last 0
    size_t: wv 0U
    if: f = 0 || f\context = 0 || f\context\scratch = 0 || slot = 0
        return: c.LMX_WALK_INVALID
    if: lmx_walk_work_find(f, slot) != 0
        return: c.LMX_WALK_OK
    if: lmx_scratch_take(f\context\scratch, c.sizeof(c.LmxWalkWork), @ room) != c.LMX_SCRATCH_OK || room = 0
        return: c.LMX_WALK_NOMEM
    e: (cast: (@: LmxWalkWork) room)
    e\holder: holder
    e\index: index
    e\slot: slot
    e\ref: 0
    e\num: 0U
    e\ty: 0
    e\dirty: 0
    e\next: 0
    e\kind: 3
    if: slot[0] != 0 && lmx_walk_is_pointer_cell(f\arena, slot[0]) != 0
        e\kind: 2
        e\ref: lmx_pointer_value_known(slot[0])
    ---
    if: slot[0] != 0 && e\kind = 3 && lmx_walk_kind(f, slot[0]) = c.LMX_KIND_STRUCT
        e\ref: slot[0]
    ---
    if: slot[0] != 0 && e\kind = 3 && e\ref = 0
        e\ty: lmx_walk_numeric_type(f\arena, slot[0])
        if: e\ty = 0 || lmx_walk_load_numeric(f\arena, slot[0], @ wv) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        e\kind: 1
        e\num: wv
    ---
    if: f\work = 0
        f\work: e
    else:
        last: f\work
        while: last\next != 0
            last: last\next
        ---
        last\next: e
    ---
    f\nwork: f\nwork + 1U
return: c.LMX_WALK_OK

# §7b: whether `holder` belongs to this activation -- its data, its code, or a body lexically inside them (up the
# parent links).  Another occurrence's Structure does not: an own node naming it gets no row.
fn: lmx_walk_holder_here (@: LmxWalkFrame f; @: Lmx holder) int
    @: Lmx h holder
    int: n 0
    while: h != 0 && n < 256
        if: h = f\node || h = f\code
            return: 1
        h: h\parent
        n: n + 1
    ---
return: 0

# §7b: THE ENTRY LOAD (Lingvamyxa spec 21.5), derived from the code (lmx_walk_load_code): node, and below it every
# Structure it owns -- a child whose parent is node, an operand or a nested body; a referenced callee, holder, datum or
# table is not node's own and is not entered.  An OWN whose holder is this activation's, an OWN_OF and a SET_OF (a
# SET names its field by its OWN child) get their field's row.
fn: lmx_walk_load_node (@: LmxWalkFrame f; @: Lmx node) int
    @: Lmx holder 0
    @@: void slot 0
    @: void v 0
    size_t: index 0U
    size_t: i 0U
    int: op
    int: status
    if: f = 0 || node = 0
        return: c.LMX_WALK_INVALID
    op: lmx_walk_node(f, (cast: (@: void) node))
    if: op = c.LMX_WALK_OP_OWN || op = c.LMX_WALK_OP_OWN_OF || op = c.LMX_WALK_OP_SET_OF
        status: lmx_walk_work_cell(f, (cast: (@: void) node), 0, @ holder, @ index, @ slot)
        if: status != c.LMX_WALK_OK
            return: status
        if: op != c.LMX_WALK_OP_OWN || lmx_walk_holder_here(f, holder) != 0
            status: lmx_walk_work_make(f, holder, index, slot)
            if: status != c.LMX_WALK_OK
                return: status
        ---
    ---
    while: i < node\array.size
        v: lmx_arena_ref_value(node, i)
        if: v != 0 && lmx_walk_kind(f, v) = c.LMX_KIND_STRUCT && (cast: (@: Lmx) v)\parent = node
            status: lmx_walk_load_node(f, (cast: (@: Lmx) v))
            if: status != c.LMX_WALK_OK
                return: status
        ---
        i: i + 1U
    ---
return: c.LMX_WALK_OK

# §7b: the entry load of this activation: from each step of its code -- a node of a role in one of the code's slots,
# its own or, in a copy of M, M's own shared by address (K-OT1); its fields and data are not entered -- down
# (lmx_walk_load_node).
fn: lmx_walk_load_code (@: LmxWalkFrame f) int
    @: void v 0
    size_t: i 0U
    int: status
    if: f = 0 || f\code = 0
        return: c.LMX_WALK_INVALID
    while: i < f\code\array.size
        v: lmx_arena_ref_value(f\code, i)
        if: v != 0 && lmx_walk_kind(f, v) = c.LMX_KIND_STRUCT && lmx_walk_op(f, v) != c.LMX_WALK_OP_NONE
            status: lmx_walk_load_node(f, (cast: (@: Lmx) v))
            if: status != c.LMX_WALK_OK
                return: status
        ---
        i: i + 1U
    ---
return: c.LMX_WALK_OK

# §7b: THE PUBLICATION (book §12, §14; Lingvamyxa spec 21.6) -- every dirty row, in row order (the order the entry
# load made them), written into its slot: a number by its cell's type, a pointer into its pointer cell, a Structure as
# the slot's reference; then unmarked.  A clean row is never written.  A failed store is INVALID (X1); the rows after
# it stay dirty.
fn: lmx_walk_publish (@: LmxWalkFrame f) int
    @: LmxWalkWork e 0
    if: f = 0
        return: c.LMX_WALK_OK
    # A re-entrant activation publishes nothing: its working values are its own (book §12, the S/I2 trace).
    if: f\reent != 0
        return: c.LMX_WALK_OK
    e: f\work
    while: e != 0
        if: e\dirty != 0
            if: e\kind = 1 && lmx_walk_store_slot(f\arena, e\slot, e\num) != c.LMX_WALK_OK
                return: c.LMX_WALK_INVALID
            if: e\kind = 2 && lmx_pointer_store_known(e\slot[0], e\ref) != 0
                return: c.LMX_WALK_INVALID
            if: e\kind = 3 && lmx_arena_ref_store(e\holder, e\index, e\ref) != 0
                return: c.LMX_WALK_INVALID
            e\dirty: 0
        ---
        e: e\next
    ---
return: c.LMX_WALK_OK

# SET_ARG: the activation's write of its input k -- an explicit formal or a hidden input.  The value becomes the
# activation's own and the caller's storage is never written (the author, bafca4c: an argument stays an activation-local
# value; Q52: only the hidden input changes).  The first write takes the activation's own copy of the input array from
# its scratch slice (the caller's array and the cells it names stay as they are), with one owned-cell slot per input.
# A Structure (or null) input takes the reference itself.  A number keeps its input's type: an int lives in a cell of
# the scratch slice, a char is its interned cell, any other number a cell of its type (lmx_walk_arith_out, as a
# computed value's); the first write makes the owned cell and later ones store into it.
fn: lmx_walk_arg_write (@: LmxWalkFrame f; size_t: k; @: void value; @: void dest; @@: void out) int
    @: void room 0
    @@: void mine 0
    @: void cell 0
    size_t: wv 0U
    size_t: cv 0U
    size_t: i 0U
    int: ty 0
    int: had 0
    int: spare 0
    int: status
    if: out != 0
        \out: 0
    if: f = 0 || out = 0 || dest = 0 || f\args = 0 || k >= f\nargs || f\context = 0 || f\context\scratch = 0
        return: c.LMX_WALK_INVALID
    if: f\argown = 0
        if: lmx_scratch_take(f\context\scratch, (f\nargs * 2U) * c.sizeof(@: void), @ room) != c.LMX_SCRATCH_OK || room = 0
            return: c.LMX_WALK_NOMEM
        mine: (cast: (@@: void) room)
        while: i < f\nargs
            mine[i]: f\args[i]
            mine[f\nargs + i]: 0
            i: i + 1U
        ---
        f\args: mine
        f\argown: mine + f\nargs
    ---
    if: value = 0 || lmx_walk_kind(f, value) = c.LMX_KIND_STRUCT
        f\args[k]: value
        f\argown[k]: 0
        \out: value
        return: c.LMX_WALK_OK
    ---
    if: lmx_walk_load_operand(f\arena, value, @ wv, @ ty) != c.LMX_WALK_OK
        return: c.LMX_WALK_INVALID
    # The input keeps its type: the translator converted the value to it.
    if: f\args[k] != 0 && lmx_walk_kind(f, f\args[k]) != c.LMX_KIND_STRUCT && lmx_walk_load_operand(f\arena, f\args[k], @ cv, @ had) = c.LMX_WALK_OK && had != ty
        return: c.LMX_WALK_INVALID
    if: ty = c.LMX_TYPE_CHAR
        status: lmx_walk_arith_out(f, (cast: (@: void) (@ spare)), ty, wv, @ cell)
        if: status != c.LMX_WALK_OK
            return: status
        f\args[k]: cell
        f\argown[k]: 0
        \out: cell
        return: c.LMX_WALK_OK
    ---
    cell: f\argown[k]
    if: cell != 0
        if: ty = c.LMX_TYPE_INT
            lmx_int_store_known(cell, (cast: (int) wv))
        else:
            if: lmx_walk_store_numeric_into(f\arena, cell, wv) != c.LMX_WALK_OK
                return: c.LMX_WALK_INVALID
        ---
        f\args[k]: cell
        \out: cell
        return: c.LMX_WALK_OK
    ---
    if: ty = c.LMX_TYPE_INT
        if: lmx_scratch_take(f\context\scratch, c.sizeof(@: void), @ cell) != c.LMX_SCRATCH_OK || cell = 0
            return: c.LMX_WALK_NOMEM
        lmx_int_store_known(cell, (cast: (int) wv))
    else:
        status: lmx_walk_arith_out(f, (cast: (@: void) (@ spare)), ty, wv, @ cell)
        if: status != c.LMX_WALK_OK
            return: status
    ---
    f\argown[k]: cell
    f\args[k]: cell
    \out: cell
return: c.LMX_WALK_OK

# -203: the operand evaluates to the descriptor. Not KIND_ARRAY is a refusal.
# The kind test is the primary guard. elem_meta does not replace it: a later
# type mismatch is only a coincidence, and it runs after the foreign record
# has already been read as a descriptor. Mutant: skip the kind test -> the
# non-array row can stay green for that reason; do not delete this test.
# write=1 also refuses an immutable descriptor.
fn: lmx_walk_array_from (@: LmxWalkFrame f; @: void node; int: write) @: VoidArray
    int: spare 0
    @: void value 0
    int: status
    if: f = 0 || node = 0
        return: 0
    status: lmx_walk_eval(f, node, (cast: (@: void) (@ spare)), @ value)
    if: status != c.LMX_WALK_OK || value = 0
        return: 0
    if: lmx_walk_kind(f, value) != c.LMX_KIND_ARRAY
        return: 0
    if: write != 0 && lmx_walk_immutable(f, value) != 0
        return: 0
return: (cast: (@: VoidArray) value)

# Array-of type -> element LMX_TYPE_* and stride. 0 = unsupported.
fn: lmx_walk_array_elem_meta (int: aty; @: int out_ety; @: size_t out_stride) int
    ulong: ulong_probe 0U
    if: out_ety = 0 || out_stride = 0
        return: 0
    if: aty = c.LMX_TYPE_ARRAY_OF_CHAR
        \out_ety: c.LMX_TYPE_CHAR
        \out_stride: c.sizeof(c.char)
        return: 1
    if: aty = c.LMX_TYPE_ARRAY_OF_UNSIGNED_CHAR
        \out_ety: c.LMX_TYPE_UNSIGNED_CHAR
        \out_stride: c.sizeof(c.char)
        return: 1
    if: aty = c.LMX_TYPE_ARRAY_OF_INT
        \out_ety: c.LMX_TYPE_INT
        \out_stride: c.sizeof(c.int)
        return: 1
    if: aty = c.LMX_TYPE_ARRAY_OF_SIZE_T
        \out_ety: c.LMX_TYPE_SIZE_T
        \out_stride: c.sizeof(c.size_t)
        return: 1
    if: aty = c.LMX_TYPE_ARRAY_OF_ULONG
        \out_ety: c.LMX_TYPE_ULONG
        \out_stride: c.sizeof(ulong_probe)
        return: 1
    if: aty = c.LMX_TYPE_ARRAY_OF_LMX
        \out_ety: c.LMX_TYPE_LMX
        \out_stride: c.sizeof(@: void)
        return: 1
    if: aty = c.LMX_TYPE_ARRAY_OF_DESC
        \out_ety: c.LMX_TYPE_DESC
        \out_stride: c.sizeof(@: void)
        return: 1
    if: aty >= c.LMX_TYPE_ARRAY_OF_POINTER_BASE
        \out_ety: c.LMX_TYPE_POINTER_BASE + (aty - c.LMX_TYPE_ARRAY_OF_POINTER_BASE)
        \out_stride: c.sizeof(@: void)
        return: 1
return: 0

# Exact physical receiver-profile test for QUALIFIED IMMUTABILITY.  Ownership and sealing
# are deliberately irrelevant: an owner-local address in this profile is immutable, while a
# foreign or sealed address of any other profile is not made immutable by accident.  Asked
# at the point of every write (k.4: OWN/SET target via lmx_walk_slot, PUT_REF/PUT_OF at
# their own sites, PRIM through its owner) -- there is no separate prepare pass any more.
fn: lmx_walk_immutable (@: LmxWalkFrame f; @: void p) int
    if: p = 0
        return: 0
    if: f\context\immutable_profile = 0
        return: 0
    f\context\classified: f\context\classified + 1U
return: (cast: (int) (lmx_range_profile(f\arena, p) = f\context\immutable_profile))

# ---- execution -------------------------------------------------------------------------

# A question to an arena that is not the Message's -- the scratch store's -- through the
# same counted door.
fn: lmx_walk_kind_in (@: LmxWalkFrame f; @: LmxArena arena; @: void p) int
    f\context\classified: f\context\classified + 1U
return: lmx_range_classify(arena, p)

# A value that LEAVES the activation through `ret`.  Whatever lives in the scratch store
# dies with some frame's rewind, this one's or one below it on the way up, so such a
# reference does not leave: the integer it points at is copied into the caller's
# destination and THAT is the value.  A reference into the graph leaves as it is --
# nothing of the graph is copied.  Only `arg` and `call` can hand this activation a
# reference it did not make itself, so only then is the store asked.
fn: lmx_walk_leaving (@: LmxWalkFrame f; int: producer; @: void value) @: void
    if: value = 0 || value = f\dest
        return: value
    if: producer != c.LMX_WALK_OP_ARG && producer != c.LMX_WALK_OP_CALL && producer != c.LMX_WALK_OP_EXEC
        return: value
    if: lmx_walk_kind_in(f, f\context\scratch\arena, value) != c.LMX_DOMAIN_KIND_SCRATCH
        return: value
    lmx_int_store_known(f\dest, lmx_int_value_known(value))
return: f\dest

# How many declared inputs M takes: the width of form A's own args-part (slot 0 of the
# occurrence, one child per formal -- l2_emit_parts), not a scan of the body for the
# highest ARG index actually READ (D-04's own original form). K-ARITY (-194 к.5b,
# measured by Opus's T4a diff-run): a formal a method never reads in its own body (an
# unused trailing parameter -- `first(3, 4)` where the body only ever reads ARG 0) is
# still a DECLARED formal the caller must supply; the old body-scan undercounted it,
# refusing a legitimate call whose own arity matched the declaration (X1, n=2 != 1).
fn: lmx_walk_arg_arity (@: LmxWalkFrame f; @: Lmx node) size_t
    @: void child 0
    @: Lmx args_part 0
    if: f = 0 || node = 0 || node\array.size = 0U
        return: 0U
    child: lmx_arena_ref_value(node, 0U)
    # A genuine args-part is a PLAIN Structure (op = NONE, kind = STRUCT): an occurrence
    # with no declared formals at all has no reason to carry one, and its own slot 0 is
    # whatever an older, pre-form-A body puts there instead -- a body's own first step
    # (an op frame, op != NONE), or its own first data field (a primitive own cell, kind
    # != STRUCT -- own(n, 1U, writer, 0U)'s own int x, say), or simply unused (0). All of
    # those are "no args-part here," zero formals -- not a malformed one to refuse or,
    # worse, misread as one (a primitive cast to Lmx and its raw bytes read as `array.size`).
    if: child = 0 || lmx_walk_op(f, child) != c.LMX_WALK_OP_NONE || lmx_walk_kind(f, child) != c.LMX_KIND_STRUCT
        return: 0U
    ---
    args_part: (cast: (@: Lmx) child)
    if: args_part\array.size = 0U
        return: 0U
return: args_part\array.size

# G-call (-194 к.4): the prim-walk hook for lmx_call_prim's own addr=0 branch -- the same
# ephemeral-scratch, program-bound-roles shape as lmx_walk_call0_dispatch above, but
# calling lmx_walk_activate directly with data/args/dest carried through, instead of
# lmx_walk_run's narrower (callable, 0, 0U) shape. dest may be 0 (a discarded/void
# dynamic call): lmx_walk_activate itself always needs a non-null one to publish steps
# into as it walks (the same reason lmx_walk_run falls back to a local spare int when its
# own caller has none), so a local spare stands in and \out stays 0 -- the caller asked
# for nothing back.
#
# What lmx_walk_activate's own `result` gives back is not always dest's own address: a
# LIT step (and several others) hand back a REFERENCE to an already-existing cell
# (`\out: value` at the literal's own site) without ever writing into dest at all --
# lmx_walk_call0_dispatch's own narrower int-only form already has to tell these two
# shapes apart (its own `value = &wv.number` check). Generalized here: when `result`
# IS dest, the value already landed there (an arithmetic result, say) and nothing more
# is needed; otherwise, if it is some other numeric cell, its VALUE is copied into dest
# (matching the native path's own "the value through dest" contract, not the reference);
# anything else (a Structure) is handed back as itself, the same as any other op's \out.
fn: lmx_walk_call_prim_dispatch (@: LmxArena arena; @: Lmx code; @: Lmx data; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    LmxArena: sa
    LmxPool: cells
    LmxScratch: scratch
    LmxWalkContext: ctx
    @: Lmx roles 0
    @: void real_dest 0
    @: void result 0
    int: spare 0
    int: present 0
    int: st
    int: rty 0
    size_t: wv 0U
    if: out = 0
        return: c.LMX_CALL_NOT_CALLABLE
    \out: 0
    if: arena = 0 || code = 0 || data = 0
        return: c.LMX_CALL_NOT_CALLABLE
    lmx_call_clear_walk_fail()
    roles: lmx_walk_program_roles()
    if: roles = 0
        roles: lmx_walk_roles_open(arena)
    ---
    if: roles = 0
        return: c.LMX_CALL_NOT_CALLABLE
    memset((cast: (@: void) (@ sa)), 0, c.sizeof(c.LmxArena))
    memset((cast: (@: void) (@ cells)), 0, c.sizeof(c.LmxPool))
    memset((cast: (@: void) (@ scratch)), 0, c.sizeof(c.LmxScratch))
    memset((cast: (@: void) (@ ctx)), 0, c.sizeof(c.LmxWalkContext))
    if: lmx_arena_open(@ sa) != 0
        return: c.LMX_CALL_NOT_CALLABLE
    if: lmx_scratch_open(@ scratch, @ sa, @ cells, 64U) != c.LMX_SCRATCH_OK
        lmx_arena_release(@ sa)
        return: c.LMX_CALL_NOT_CALLABLE
    ---
    ctx.arena: arena
    ctx.scratch: @ scratch
    ctx.roles: roles
    real_dest: dest
    if: real_dest = 0
        real_dest: (cast: (@: void) (@ spare))
    ---
    st: lmx_walk_activate(@ ctx, code, data, refs, nargs, real_dest, @ result, @ present)
    lmx_scratch_close(@ scratch)
    lmx_arena_release(@ sa)
    if: st != c.LMX_WALK_OK
        # G2/D-37: note_walk_fail X1s walker errors; throws decode to k on the turn channel.
        lmx_call_note_walk_fail(st)
        return: lmx_call_walk_fail_status()
    ---
    if: present = 0 || dest = 0
        return: 0
    ---
    if: result = dest
        \out: dest
        return: 0
    ---
    # `dest` here is the CALLER's own destination -- generated code's own local, not
    # necessarily an arena-classified cell -- so lmx_walk_store_numeric_raw (the raw,
    # unclassified store the native path already uses by construction), keyed by
    # RESULT's own type, not dest's, is the right door. CHAR is excluded (its cells are
    # interned/shared; a mutating store into dest would not mean what it means for the
    # other numerics) -- handed back as a reference instead, same as any non-numeric
    # value.
    rty: 0
    if: result != 0
        rty: lmx_walk_numeric_type(arena, result)
    ---
    if: rty != 0 && rty != c.LMX_TYPE_CHAR && lmx_walk_load_numeric(arena, result, @ wv) = c.LMX_WALK_OK
        if: lmx_walk_store_numeric_raw(dest, rty, wv) != c.LMX_WALK_OK
            return: c.LMX_CALL_NOT_CALLABLE
        ---
        \out: dest
        return: 0
    ---
    \out: result
return: 0

# Fresh typed cell for a CALL trampoline dest, or the consumer's dest when it already matches.
fn: lmx_walk_call_dest (@: LmxWalkFrame f; @: void dest; int: ty; @@: void call_dest) int
    @: void cell 0
    if: f = 0 || dest = 0 || call_dest = 0
        return: c.LMX_WALK_INVALID
    \call_dest: 0
    if: ty = 0 || ty = c.LMX_TYPE_INT
        \call_dest: dest
        return: c.LMX_WALK_OK
    ---
    if: lmx_walk_numeric_type(f\arena, dest) = ty
        \call_dest: dest
        return: c.LMX_WALK_OK
    ---
    # Same doors as lmx_walk_arith_out for wider numerics.
    if: ty = c.LMX_TYPE_SIZE_T
        cell: lmx_size_new_owned(f\arena)
        if: cell = 0
            return: c.LMX_WALK_NOMEM
        \call_dest: cell
        return: c.LMX_WALK_OK
    ---
    if: ty = c.LMX_TYPE_UNSIGNED
        cell: lmx_unsigned_new_owned(f\arena)
        if: cell = 0
            return: c.LMX_WALK_NOMEM
        \call_dest: cell
        return: c.LMX_WALK_OK
    ---
    if: ty = c.LMX_TYPE_ULONG
        cell: lmx_ulong_new_owned(f\arena)
        if: cell = 0
            return: c.LMX_WALK_NOMEM
        \call_dest: cell
        return: c.LMX_WALK_OK
    ---
    if: ty = c.LMX_TYPE_CHAR
        if: lmx_chars_init(f\arena) != 0 && lmx_arena_find(f\arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR) = 0
            return: c.LMX_WALK_NOMEM
        ---
        cell: lmx_char_cell(f\arena, 0)
        if: cell = 0
            return: c.LMX_WALK_INVALID
        \call_dest: cell
        return: c.LMX_WALK_OK
    ---
    \call_dest: dest
return: c.LMX_WALK_OK

# [call, code, data, rtype, arg ...].  The callee's inputs are REFERENCES, kept with the
# cells that hold the integers among them in one scratch slice of this activation; the
# slice is gone with the rewind below, after the callee has returned.  The callee's
# destination is this node's own destination, so an integer result lands where this
# node's consumer expects it and needs no copy on the way.
# [empty]: a new empty Structure, one per execution -- made the way the native emission makes one; no prototype.
fn: lmx_walk_empty (@: LmxWalkFrame f; @: Lmx code; @: void dest; @@: void out) int
    @: Lmx made 0
    \out: 0
    if: f = 0 || code = 0
        return: c.LMX_WALK_INVALID
    made: lmx_node_new_owned(f\arena)
    if: made = 0
        return: c.LMX_WALK_NOMEM
    \out: (cast: (@: void) made)
return: c.LMX_WALK_OK

# -201, D1 (Codex, accepted 2026-09-28): the catch rows are the frame's own last operands, triples (k_in, pad, k_out)
# from `base`, `n` of them -- no table Structure -- scanned in place.  k_in and k_out are size cells. pad is a
# reference (0 renumbers, no landing).  No decoded row array: nothing to free on the throw path.
# A walked throw record, when a walked `throw:` exists, must live in the arena,
# like a native throw. There is no walked `throw:` producer yet.
# An implicit THROW_MERGE / THROW_IMPLEMENTS carries payload 0.
fn: lmx_walk_catch_scan (@: LmxWalkFrame f; @: Lmx rows; size_t: base; size_t: n; int: status) int
    @: void kin_cell 0
    @: void pad 0
    @: void kout_cell 0
    size_t: i 0U
    size_t: k 0U
    size_t: k_in 0U
    size_t: k_out 0U
    int: hit 0
    if: f = 0 || status < c.LMX_WALK_THROWN || rows = 0 || n = 0U
        return: status
    if: base + 3U * n > rows\array.size
        return: c.LMX_WALK_INVALID
    ---
    k: (cast: (size_t) (status - c.LMX_WALK_THROWN))
    while: i < n && hit = 0
        kin_cell: lmx_arena_ref_value(rows, base + i * 3U)
        pad: lmx_arena_ref_value(rows, base + i * 3U + 1U)
        kout_cell: lmx_arena_ref_value(rows, base + i * 3U + 2U)
        if: kin_cell = 0 || kout_cell = 0
            return: c.LMX_WALK_INVALID
        if: lmx_walk_numeric_type(f\arena, kin_cell) != c.LMX_TYPE_SIZE_T || lmx_walk_numeric_type(f\arena, kout_cell) != c.LMX_TYPE_SIZE_T
            return: c.LMX_WALK_INVALID
        ---
        if: pad != 0 && lmx_walk_kind(f, pad) != c.LMX_KIND_STRUCT
            return: c.LMX_WALK_INVALID
        ---
        k_in: lmx_size_value_known(kin_cell)
        if: k_in = k
            k_out: lmx_size_value_known(kout_cell)
            hit: 1
        ---
        i: i + 1U
    ---
    if: hit = 0
        return: status
    if: pad = 0
        return: c.LMX_WALK_THROWN + (cast: (int) k_out)
    ---
    f\landing: (cast: (@: Lmx) pad)
return: status

# D1: how many catch rows a frame carries, from its catch slot's value -- a size cell, or 0 for none.
fn: lmx_walk_catch_count (@: LmxWalkFrame f; @: void cell; @: size_t out) int
    \out: 0U
    if: cell = 0
        return: c.LMX_WALK_OK
    if: lmx_walk_numeric_type(f\arena, cell) != c.LMX_TYPE_SIZE_T
        return: c.LMX_WALK_INVALID
    \out: lmx_size_value_known(cell)
return: c.LMX_WALK_OK

# Bind pad parameters from f\payload, then walk the handler body (the pad's last child).
# A numeric parameter is a typed store; a type mismatch is an invariant (the translator
# already knows both types). A Structure parameter is a pointer cell: store the argument
# reference and nothing else. Admission is not this function. The translator emits PRIM
# admit as the handler's own first statement, with that site's catch table, so a NO is
# THROWN+k_out of that site rather than a constant in the kernel.
# Landing is cleared before the handler so a throw inside it can name an outer pad.
fn: lmx_walk_catch_bind (@: LmxWalkFrame f) int
    @: Lmx pad 0
    @: Lmx payload 0
    @: Lmx handler 0
    @: void cell 0
    @: void arg 0
    size_t: pcount 0U
    size_t: i 0U
    size_t: wv 0U
    int: cell_ty 0
    int: arg_ty 0
    int: status c.LMX_WALK_OK
    if: f = 0 || f\landing = 0 || f\landing\array.size < 2U
        return: c.LMX_WALK_INVALID
    ---
    pad: f\landing
    pcount: pad\array.size - 2U
    payload: (cast: (@: Lmx) f\payload)
    if: pcount != 0U && (f\payload = 0 || lmx_walk_kind(f, f\payload) != c.LMX_KIND_STRUCT || payload\array.size < pcount)
        c.fprintf(l1_stderr(), "lmx: invariant: catch payload\n")
        c.abort()
    ---
    while: i < pcount && status = c.LMX_WALK_OK
        cell: lmx_arena_ref_value(pad, i + 1U)
        arg: lmx_arena_ref_value(payload, i)
        cell_ty: lmx_walk_numeric_type(f\arena, cell)
        if: cell_ty != 0
            if: lmx_walk_load_operand(f\arena, arg, @ wv, @ arg_ty) != c.LMX_WALK_OK || arg_ty != cell_ty
                c.fprintf(l1_stderr(), "lmx: invariant: catch parameter type\n")
                c.abort()
            ---
            if: lmx_walk_store_numeric_into(f\arena, cell, wv) != c.LMX_WALK_OK
                status: c.LMX_WALK_INVALID
            ---
        else:
            if: lmx_walk_is_pointer_cell(f\arena, cell) = 0 || arg = 0 || lmx_walk_kind(f, arg) != c.LMX_KIND_STRUCT
                c.fprintf(l1_stderr(), "lmx: invariant: catch parameter type\n")
                c.abort()
            ---
            if: lmx_pointer_store_known(cell, arg) != 0
                status: c.LMX_WALK_INVALID
            ---
        ---
        i: i + 1U
    ---
    if: status != c.LMX_WALK_OK
        return: status
    handler: lmx_arena_ref_struct(pad, (pad\array.size) - 1U)
    f\landing: 0
    f\payload: 0
    if: handler = 0
        return: c.LMX_WALK_INVALID
    return: lmx_walk_body(f, handler, 0U)

fn: lmx_walk_call (@: LmxWalkFrame f; @: Lmx code; @: void dest; @@: void out) int
    LmxScratchMark: mark
    @: LmxScratchMark pm 0
    @: Lmx callee 0
    @: Lmx data 0
    @: Lmx child 0
    @: void data_child 0
    @: void data_ref 0
    @: void room 0
    @: void call_dest 0
    @: void data_cell 0
    @: void rtype_ref 0
    @@: void refs 0
    @@: void cells 0
    LmxEntry: addr 0
    LmxPrimitiveEntry: entry 0
    @: void result 0
    size_t: n
    size_t: i 0U
    size_t: wv 0U
    int: present 0
    int: ty c.LMX_TYPE_INT
    int: status c.LMX_WALK_OK
    int: said 0
    int: exec 0
    size_t: catch_n 0U
    \out: 0
    # -201, D1: [call, code, data, rtype, catch, args..., rows...]. catch: the rows' count, or 0 for none.
    # Mutant: array.size < 5 (no catch slot) -> INVALID.
    if: code\array.size < 5U
        return: c.LMX_WALK_INVALID
    ---
    # R9: EXEC has no code child -- the Structure in its data child is run over itself, once evaluated (below).
    exec: (cast: (int) (lmx_walk_op(f, (cast: (@: void) code)) = c.LMX_WALK_OP_EXEC))
    # code (child 1) = occurrence used for dispatch (Lmx.native).
    if: exec = 0
        callee: lmx_arena_ref_struct(code, 1U)
        if: callee = 0
            return: c.LMX_WALK_INVALID
        ---
    ---
    if: lmx_walk_catch_count(f, lmx_arena_ref_value(code, 4U), @ catch_n) != c.LMX_WALK_OK || code\array.size < 5U + 3U * catch_n
        return: c.LMX_WALK_INVALID
    ---
    n: code\array.size - 5U - 3U * catch_n
    if: exec = 0
        addr: lmx_walk_callable_addr(f\arena, callee)
    ---
    if: addr = 0 && exec = 0
        # The args-part width is every signature input of this frame: declared
        # formals and dynamic inputs alike. They are not a third graph. n must
        # match. An extra argument is INVALID (D-04). A missing one is too.
        if: n != lmx_walk_arg_arity(f, callee)
            return: c.LMX_WALK_INVALID
        ---
    ---
    # rtype (child 3): a plain reference to the callee's declared result cell (the
    # `return` part's own child 0), never evaluated as a node; 0 for a sub/void callee.
    rtype_ref: lmx_arena_ref_value(code, 3U)
    if: rtype_ref != 0
        ty: lmx_range_type_of(f\arena, rtype_ref)
    ---
    pm: @ mark
    if: lmx_scratch_mark(f\context\scratch, pm) != c.LMX_SCRATCH_OK
        return: c.LMX_WALK_INVALID
    ---
    # Evaluate data (child 2) first: the callee's own Structure by reference ((M, M)), else a node.
    data_child: lmx_arena_ref_value(code, 2U)
    if: data_child = 0
        status: c.LMX_WALK_INVALID
    else:
        if: lmx_walk_op(f, data_child) = c.LMX_WALK_OP_NONE
            if: lmx_walk_kind(f, data_child) != c.LMX_KIND_STRUCT
                status: c.LMX_WALK_INVALID
            ---
            data: (cast: (@: Lmx) data_child)
        else:
            status: lmx_walk_eval(f, data_child, (cast: (@: void) (@ data_cell)), @ data_ref)
            if: status = c.LMX_WALK_OK
                data: (cast: (@: Lmx) data_ref)
                if: data = 0 || lmx_walk_kind(f, (cast: (@: void) data)) != c.LMX_KIND_STRUCT
                    status: c.LMX_WALK_INVALID
                ---
            ---
        ---
    ---
    # R9: EXEC's code is its data -- its native word, or its steps walked.
    if: exec != 0 && status = c.LMX_WALK_OK
        callee: data
        addr: lmx_walk_callable_addr(f\arena, callee)
    ---
    if: n != 0U && status = c.LMX_WALK_OK
        if: lmx_scratch_take(f\context\scratch, (n * 2U) * c.sizeof(@: void), @ room) != c.LMX_SCRATCH_OK
            status: c.LMX_WALK_NOMEM
        ---
        refs: (cast: (@@: void) room)
        cells: refs + n
    ---
    i: 0U
    while: status = c.LMX_WALK_OK && i < n
        refs[i]: 0
        cells[i]: 0
        child: (cast: (@: Lmx) lmx_arena_ref_value(code, i + 5U))
        if: child != 0 && lmx_walk_op(f, (cast: (@: void) child)) = c.LMX_WALK_OP_NONE
            refs[i]: (cast: (@: void) child)
        else:
            status: lmx_walk_eval(f, (cast: (@: void) child), (cast: (@: void) (cells + i)), refs + i)
            if: status = c.LMX_WALK_OK
                status: lmx_walk_arg_value(f, (cast: (@: void) child), (cast: (@: void) (cells + i)), refs + i)
            ---
        ---
        i: i + 1U
    ---
    # §7b: control passes to another callable -- its arguments are evaluated above, so what is dirty is published now,
    # before the call (book §12, the `9 0` order).
    if: status = c.LMX_WALK_OK
        status: lmx_walk_publish(f)
    ---
    if: status = c.LMX_WALK_OK
        if: addr != 0
            # Native: entry(owner=data); dispatch word from code. Walk does not link call.o
            # (duplicate symbols); same owner=data rule as lmx_call_prim.
            entry: (cast: (LmxPrimitiveEntry) addr)
            if: lmx_walk_call_dest(f, dest, ty, @ call_dest) != c.LMX_WALK_OK
                status: c.LMX_WALK_INVALID
            ---
            if: status = c.LMX_WALK_OK
                said: entry((cast: (@: void) data), refs, n, call_dest, out)
            ---
            if: said != 0
                status: c.LMX_WALK_THROWN + said
            ---
        else:
            # Walked body: code = callee, data = its data graph (OWN/SET/PUT target).
            # K-RET (-194 к.5b, measured by Opus's T4a diff-run): the callee's own
            # numeric result can come back as a REFERENCE to an existing cell (a bare
            # ARG/OWN read, same shape as G-call's own result), not necessarily written
            # into dest -- a second call whose body reuses/overwrites that same cell
            # would then corrupt an earlier, still-unread call's result before an
            # enclosing expression (e.g. an ADD) ever reads it: `pick(1) + pick(2)`
            # native 3, walked 4 was exactly this. Build a fresh, properly-typed
            # call_dest the same way the native branch above already does, and copy the
            # numeric result's VALUE into it by rtype (lmx_walk_store_numeric_raw, same
            # door G-call already uses) -- a non-numeric rtype (a Structure) keeps the
            # reference, same as the native branch's own dest already would.
            #
            # Gated on rtype_ref itself (child 3 present), NOT on `ty` (its own default
            # is LMX_TYPE_INT, the exact same value a GENUINELY int-typed rtype gives --
            # rtype_ref = 0, no rtype at all, must NOT be read as "yes, copy," or a
            # reference-returning callee with no declared rtype at all -- like this
            # file's own peek/relay, built before rtype existed -- would have its result
            # force-copied instead of left as the reference it actually is).
            if: lmx_walk_call_dest(f, dest, ty, @ call_dest) != c.LMX_WALK_OK
                status: c.LMX_WALK_INVALID
            ---
            if: status = c.LMX_WALK_OK
                status: lmx_walk_activate(f\context, callee, data, refs, n, call_dest, @ result, @ present)
            ---
            if: status = c.LMX_WALK_OK && present != 0 && result != 0 && result != call_dest && rtype_ref != 0 && ty != c.LMX_TYPE_CHAR
                if: lmx_walk_load_numeric(f\arena, result, @ wv) != c.LMX_WALK_OK
                    status: c.LMX_WALK_INVALID
                else:
                    if: lmx_walk_store_numeric_raw(call_dest, ty, wv) != c.LMX_WALK_OK
                        status: c.LMX_WALK_INVALID
                    else:
                        result: call_dest
                    ---
                ---
            ---
            if: status = c.LMX_WALK_OK || status >= c.LMX_WALK_THROWN
                \out: result
            ---
        ---
    ---
    # Payload is the record entry() or activate already published. It is an arena
    # address (or 0). The scratch rewind below must not be what keeps it alive.
    if: status >= c.LMX_WALK_THROWN
        f\payload: \out
        if: catch_n != 0U
            status: lmx_walk_catch_scan(f, code, 5U + n, catch_n, status)
        ---
    ---
    if: lmx_scratch_rewind(f\context\scratch, pm) != c.LMX_SCRATCH_OK && status = c.LMX_WALK_OK
        status: c.LMX_WALK_INVALID
    ---
return: status

fn: lmx_walk_prim (@: LmxWalkFrame f; @: Lmx code; @: void dest; @@: void out) int
    LmxScratchMark: mark
    @: LmxScratchMark pm 0
    @: LmxPrimitive record 0
    @: void room 0
    @@: void refs 0
    @@: void cells 0
    @: void target 0
    @: void child 0
    size_t: n
    size_t: i 0U
    int: status c.LMX_WALK_OK
    int: said 0
    size_t: catch_n 0U
    \out: 0
    # -201, D1: [prim, rec, catch, ops..., rows...]. catch: the rows' count, or 0 for none.
    if: code\array.size < 3U
        return: c.LMX_WALK_INVALID
    target: lmx_arena_ref_value(code, 1U)
    # k.4: the record must classify as a primitive record -- asked here, unconditionally,
    # now that there is no separate counting/prepare pass to have asked it once.  A
    # translator/fixture mistake that names something else here (a Structure, an op node)
    # is refused, never read as an LmxPrimitive by a bare cast.
    if: target = 0 || lmx_range_classify(f\arena, target) != c.LMX_DOMAIN_KIND_PRIMITIVE
        return: c.LMX_WALK_INVALID
    ---
    record: (cast: (@: LmxPrimitive) target)
    if: record\fn = 0
        return: c.LMX_WALK_INVALID
    ---
    # QUALIFIED IMMUTABILITY: a primitive act through its owner is the one other way a
    # body could write immutable data (k.4: checked here, at the act itself, not by a
    # separate prepare pass).
    if: lmx_walk_immutable(f, record\owner) != 0
        return: c.LMX_WALK_INVALID
    ---
    if: lmx_walk_catch_count(f, lmx_arena_ref_value(code, 2U), @ catch_n) != c.LMX_WALK_OK || code\array.size < 3U + 3U * catch_n
        return: c.LMX_WALK_INVALID
    ---
    n: code\array.size - 3U - 3U * catch_n
    pm: @ mark
    if: lmx_scratch_mark(f\context\scratch, pm) != c.LMX_SCRATCH_OK
        return: c.LMX_WALK_INVALID
    ---
    if: n != 0U
        if: lmx_scratch_take(f\context\scratch, (n * 2U) * c.sizeof(@: void), @ room) != c.LMX_SCRATCH_OK
            status: c.LMX_WALK_NOMEM
        ---
        refs: (cast: (@@: void) room)
        cells: refs + n
    ---
    # -194 к.6 (K2): a null argument slot is an explicit "no value" (a merge prim's own
    # optional body or pair-map, absent), not a translator mistake -- lmx_walk_eval
    # itself refuses node = 0 outright, so it is never asked here; refs[i] stays the 0
    # it was already set to just above.
    while: status = c.LMX_WALK_OK && i < n
        refs[i]: 0
        cells[i]: 0
        child: lmx_arena_ref_value(code, i + 3U)
        # D1: a plain operand that is no frame and no Structure -- a size cell, a merge's pair count or pair -- is the
        # reference it is, as CALL passes a plain input.
        if: child != 0 && lmx_walk_op(f, child) = c.LMX_WALK_OP_NONE && lmx_walk_kind(f, child) != c.LMX_KIND_STRUCT
            refs[i]: child
        else:
            if: child != 0
                status: lmx_walk_eval(f, child, (cast: (@: void) (cells + i)), refs + i)
                if: status = c.LMX_WALK_OK && lmx_walk_node(f, (cast: (@: void) code)) = c.LMX_WALK_OP_PRIM_PUB
                    status: lmx_walk_arg_value(f, child, (cast: (@: void) (cells + i)), refs + i)
                ---
            ---
        ---
        i: i + 1U
    ---
    # §7b: a receiver that is a boundary (PRIM_PUB: merge, Model, a held callable, sendMessage) -- its operands are
    # evaluated above, and what is dirty is published before it runs.
    if: status = c.LMX_WALK_OK && lmx_walk_node(f, (cast: (@: void) code)) = c.LMX_WALK_OP_PRIM_PUB
        status: lmx_walk_publish(f)
    ---
    if: status = c.LMX_WALK_OK
        said: record\fn(record\owner, refs, n, dest, out)
        # -177 c5 / D-55: admission throw statuses -> THROWN+k at the walked root (d=0).
        # Mutant: map them to LMX_WALK_PRIMITIVE -> unit_s1_merge_uncaught RED.
        if: said = c.LMX_PRIMITIVE_THROW_MERGE
            status: c.LMX_WALK_THROWN + 1
        else:
            if: said = c.LMX_PRIMITIVE_THROW_IMPLEMENTS
                status: c.LMX_WALK_THROWN + 2
            else:
                if: said != c.LMX_PRIMITIVE_OK
                    status: c.LMX_WALK_PRIMITIVE
                ---
            ---
        ---
    ---
    if: status >= c.LMX_WALK_THROWN
        f\payload: \out
        if: catch_n != 0U
            status: lmx_walk_catch_scan(f, code, 3U + n, catch_n, status)
        ---
    ---
    if: lmx_scratch_rewind(f\context\scratch, pm) != c.LMX_SCRATCH_OK && status = c.LMX_WALK_OK
        status: c.LMX_WALK_INVALID
    ---
return: status

# The index of ELEM / ELEMPUT (-203, D-39). The child is a value node, evaluated like any
# other operand: a LIT size, or a cell read (AT / ARG). Only a size_t value is an index.
# An int is not cast. A raw size cell stored in the slot is not a node and is INVALID.
# Mutant: lmx_size_value_known on the child itself -> LIT and dynamic indices fail.
fn: lmx_walk_index (@: LmxWalkFrame f; @: void node; @: size_t out_index) int
    @: void cell 0
    @: void value 0
    int: status
    if: f = 0 || node = 0 || out_index = 0 || f\arena = 0
        return: c.LMX_WALK_INVALID
    cell: lmx_size_new_owned(f\arena)
    if: cell = 0
        return: c.LMX_WALK_NOMEM
    status: lmx_walk_eval(f, node, cell, @ value)
    if: status != c.LMX_WALK_OK
        return: status
    if: value = 0 || lmx_walk_numeric_type(f\arena, value) != c.LMX_TYPE_SIZE_T
        return: c.LMX_WALK_INVALID
    \out_index: lmx_size_value_known(value)
return: c.LMX_WALK_OK

# The value of one node.  `dest` is the cell of whoever consumes it; `out` receives the
# reference that IS the value: `dest` for an integer computed here, a reference into the
# graph, or 0 for no value.
fn: lmx_walk_eval (@: LmxWalkFrame f; @: void node; @: void dest; @@: void out) int
    @: Lmx code 0
    @@: void slot 0
    @: LmxWalkWork work 0
    @: Lmx wholder 0
    @: void value 0
    @: void other 0
    @: void expect_leaf 0
    @: VoidArray adesc 0
    @: char abytes 0
    size_t: index 0U
    size_t: stride 0U
    int: op
    int: a 0
    int: b 0
    int: aty 0
    int: ety 0
    size_t: wv 0U
    size_t: ua 0U
    size_t: ub 0U
    int: going 1
    int: status c.LMX_WALK_OK
    if: f = 0 || node = 0 || dest = 0 || out = 0
        return: c.LMX_WALK_INVALID
    \out: 0
    op: lmx_walk_node(f, node)
    if: op = c.LMX_WALK_OP_UNKNOWN
        return: c.LMX_WALK_UNSUPPORTED
    if: op = c.LMX_WALK_OP_NONE
        # A plain Structure as a value (-174 c2): the reference is the Structure itself.
        if: lmx_walk_kind(f, node) = c.LMX_KIND_STRUCT
            \out: node
            return: c.LMX_WALK_OK
        ---
        return: c.LMX_WALK_INVALID
    if: lmx_walk_bare(f, node) != 0
        # A bare role record: only a void return has no operands.
        if: op != c.LMX_WALK_OP_RET
            return: c.LMX_WALK_INVALID
        f\returned: 1
        return: c.LMX_WALK_OK
    code: (cast: (@: Lmx) node)
    if: op = c.LMX_WALK_OP_LIT
        # The literal's own cell, by reference: reading it copies nothing.
        value: lmx_arena_ref_value(code, 1U)
        if: value = 0
            return: c.LMX_WALK_INVALID
        \out: value
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_OWN || op = c.LMX_WALK_OP_OWN_OF
        # §7b: the working value -- the row the entry load made for the slot; the graph is not read.  A pointer cell's row is the
        # reference it holds, a Structure slot's the Structure (0 while empty: no value), a number's is copied into the
        # consumer's destination.
        status: lmx_walk_work_cell(f, node, 0, @ wholder, @ index, @ slot)
        if: status != c.LMX_WALK_OK
            return: status
        work: lmx_walk_work_find(f, slot)
        if: work = 0
            c.fprintf(l1_stderr(), "lmx: invariant: an own field used but not loaded\n")
            return: c.LMX_WALK_INVALID
        ---
        if: work\kind != 1
            \out: work\ref
            return: c.LMX_WALK_OK
        ---
        # A number other than an int is a value of its own type, as a computed one is (lmx_walk_arith_out): the
        # destination when it is a cell of that type, else a fresh cell of it -- a char its interned cell.
        if: work\ty != c.LMX_TYPE_INT
            return: lmx_walk_arith_out(f, dest, work\ty, work\num, out)
        ---
        if: lmx_walk_numeric_type(f\arena, dest) != 0
            if: lmx_walk_store_numeric_into(f\arena, dest, work\num) != c.LMX_WALK_OK
                return: c.LMX_WALK_INVALID
            ---
        else:
            lmx_int_store_known(dest, (cast: (int) work\num))
        ---
        \out: dest
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_SET_ARG
        # The activation's write of its input k (lmx_walk_arg_write).
        if: code\array.size < 3U
            return: c.LMX_WALK_INVALID
        index: lmx_size_value_known(lmx_arena_ref_value(code, 1U))
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 2U), (cast: (@: void) (@ a)), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        return: lmx_walk_arg_write(f, index, value, dest, out)
    if: op = c.LMX_WALK_OP_ARG
        # The reference the caller passed, as it is; an absent input is no value -- unless the frame names where the
        # graph holds it (child 2: the book's lexical fallback, read through `node` or a unit field's declaration,
        # §12 "Dynamic sources and the lexical fallback"): a returned node called with no binding of a free name.
        index: lmx_size_value_known(lmx_arena_ref_value(code, 1U))
        if: index >= f\nargs || f\args = 0
            return: c.LMX_WALK_INVALID
        if: f\args[index] = 0 && code\array.size > 2U && lmx_arena_ref_value(code, 2U) != 0
            return: lmx_walk_eval(f, lmx_arena_ref_value(code, 2U), dest, out)
        \out: f\args[index]
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_NODE
        # `node` (book §3): the physical reference to the lexical space above the method -- this activation's data's
        # parent.  The root's data is the unit, which has none.
        if: f\node = 0 || f\node\parent = 0
            return: c.LMX_WALK_INVALID
        \out: (cast: (@: void) f\node\parent)
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_AT
        # What the field holds, by reference.  An empty direct Structure own
        # (slot[0] = 0) is legal no value (-186 c4 / Opus c3b-3); only a missing
        # slot cell is INVALID. Mutant: also reject slot[0]=0 -> take_empty RED.
        slot: lmx_walk_slot(f, code, 1U, 0)
        if: slot = 0
            return: c.LMX_WALK_INVALID
        \out: slot[0]
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_DEREF
        # The Structure a pointer cell holds (-174). AT stays the cell; deref opens it
        # so OF can follow m\f. Mutant: return the cell address -> OF INVALID.
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), (cast: (@: void) (@ a)), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        if: value = 0 || lmx_domain_kind(f\arena, value) != c.LMX_KIND_PRIMITIVE
            return: c.LMX_WALK_INVALID
        if: lmx_domain_type(f\arena, value) < c.LMX_TYPE_POINTER_BASE
            return: c.LMX_WALK_INVALID
        other: lmx_pointer_value_known(value)
        if: other = 0 || lmx_walk_kind(f, other) != c.LMX_KIND_STRUCT
            return: c.LMX_WALK_INVALID
        \out: other
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_OF
        # A field of a reference value.  Here the kind HAS to be established: reading a
        # cell as a Structure would read past it, so the arena is asked once.
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), (cast: (@: void) (@ a)), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        if: value = 0 || lmx_walk_kind(f, value) != c.LMX_KIND_STRUCT
            return: c.LMX_WALK_INVALID
        index: lmx_size_value_known(lmx_arena_ref_value(code, 2U))
        # D-105: a place typed with a named Structure (req, child 3) reads req's field at the
        # value's own slot for it, from the `implements` table; a value with no record there
        # reached the place unadmitted -- X1, never slot `index` by default.
        if: code\array.size > 3U && lmx_arena_ref_value(code, 3U) != 0
            if: lmx_implements_slot(f\arena, (cast: (@: Lmx) value), (cast: (@: Lmx) lmx_arena_ref_value(code, 3U)), index, @ index) != 0
                return: c.LMX_WALK_INVALID
            ---
        ---
        slot: lmx_arena_ref_cell((cast: (@: Lmx) value), index)
        if: slot = 0
            return: c.LMX_WALK_INVALID
        \out: slot[0]
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_PUT
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 3U), (cast: (@: void) (@ a)), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        slot: lmx_walk_slot(f, code, 1U, 1)
        if: slot = 0 || slot[0] = 0
            return: c.LMX_WALK_INVALID
        # Pointer cell: Structure reference or null (-177: null means "no letter").
        # Mutant: refuse value 0 -> empty take / null PUT RED.
        if: lmx_walk_is_pointer_cell(f\arena, slot[0]) != 0
            if: value != 0 && lmx_walk_kind(f, value) != c.LMX_KIND_STRUCT
                return: c.LMX_WALK_INVALID
            ---
            if: lmx_pointer_store_known(slot[0], value) != 0
                return: c.LMX_WALK_INVALID
            \out: slot[0]
            return: c.LMX_WALK_OK
        ---
        if: value = 0
            return: c.LMX_WALK_INVALID
        ---
        # Numeric cell: operand type must match.
        b: lmx_walk_numeric_type(f\arena, slot[0])
        if: b = 0
            return: c.LMX_WALK_INVALID
        if: lmx_walk_load_operand(f\arena, value, @ wv, @ a) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        if: a != b
            return: c.LMX_WALK_INVALID
        if: lmx_walk_store_slot(f\arena, slot, wv) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        \out: slot[0]
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_PUT_REF
        # -186: [put_ref, holder, slot, value] -> lmx_arena_ref_store (direct own Structure slot).
        # Additive: pointer-cell slots stay on PUT; PUT_REF refuses a pointer cell in the slot.
        # Mutant: PUT into a direct slot (no pointer cell) -> INVALID (numeric/type miss).
        if: code\array.size < 4U
            return: c.LMX_WALK_INVALID
        ---
        # K-OT2 (-194 к.5): holder = 0 is no longer refused outright here either -- the
        # same sentinel lmx_walk_slot now accepts, resolved the same way.
        other: lmx_arena_ref_value(code, 1U)
        other: lmx_walk_data_holder(f, other)
        if: other = 0 || lmx_walk_kind(f, other) != c.LMX_KIND_STRUCT
            return: c.LMX_WALK_INVALID
        ---
        if: lmx_walk_immutable(f, other) != 0
            return: c.LMX_WALK_INVALID
        ---
        index: lmx_size_value_known(lmx_arena_ref_value(code, 2U))
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 3U), (cast: (@: void) (@ a)), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        ---
        if: value != 0 && lmx_walk_kind(f, value) != c.LMX_KIND_STRUCT
            return: c.LMX_WALK_INVALID
        ---
        expect_leaf: lmx_arena_ref_value((cast: (@: Lmx) other), index)
        if: expect_leaf != 0 && lmx_walk_is_pointer_cell(f\arena, expect_leaf) != 0
            return: c.LMX_WALK_INVALID
        ---
        if: lmx_arena_ref_store((cast: (@: Lmx) other), index, value) != 0
            return: c.LMX_WALK_INVALID
        ---
        \out: value
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_PUT_OF
        # -177 c4 / D-54: evaluate the holder, then write slot. Mutant: use walk_slot on child1 -> RED.
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), (cast: (@: void) (@ a)), @ other)
        if: status != c.LMX_WALK_OK
            return: status
        if: other = 0 || lmx_walk_kind(f, other) != c.LMX_KIND_STRUCT
            return: c.LMX_WALK_INVALID
        ---
        if: lmx_walk_immutable(f, other) != 0
            return: c.LMX_WALK_INVALID
        ---
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 3U), (cast: (@: void) (@ a)), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        ---
        index: lmx_size_value_known(lmx_arena_ref_value(code, 2U))
        # D-105: the holder's place is typed with req (child 4) -- its field at the value's slot.
        if: code\array.size > 4U && lmx_arena_ref_value(code, 4U) != 0
            if: lmx_implements_slot(f\arena, (cast: (@: Lmx) other), (cast: (@: Lmx) lmx_arena_ref_value(code, 4U)), index, @ index) != 0
                return: c.LMX_WALK_INVALID
            ---
        ---
        slot: lmx_arena_ref_cell((cast: (@: Lmx) other), index)
        if: slot = 0 || slot[0] = 0
            return: c.LMX_WALK_INVALID
        ---
        if: lmx_walk_is_pointer_cell(f\arena, slot[0]) != 0
            if: value != 0 && lmx_walk_kind(f, value) != c.LMX_KIND_STRUCT
                return: c.LMX_WALK_INVALID
            ---
            if: lmx_pointer_store_known(slot[0], value) != 0
                return: c.LMX_WALK_INVALID
            \out: slot[0]
            return: c.LMX_WALK_OK
        ---
        if: value = 0
            return: c.LMX_WALK_INVALID
        ---
        b: lmx_walk_numeric_type(f\arena, slot[0])
        if: b = 0
            return: c.LMX_WALK_INVALID
        if: lmx_walk_load_operand(f\arena, value, @ wv, @ a) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        if: a != b
            return: c.LMX_WALK_INVALID
        if: lmx_walk_store_slot(f\arena, slot, wv) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        \out: slot[0]
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_SET || op = c.LMX_WALK_OP_SET_OF
        # §7b: an executed assignment writes the working value and marks it dirty; the slot waits for a publication
        # (lmx_walk_publish).  SET [set, own-node, value] evaluates its value first; SET_OF [set_of, holder-expr, slot,
        # value] its holder first, as PUT_OF does.  The immutable profile is refused at the write (write = 1).  A
        # pointer or Structure row takes a Structure or null, a number row a value of its own type.
        if: op = c.LMX_WALK_OP_SET
            status: lmx_walk_eval(f, lmx_arena_ref_value(code, 2U), (cast: (@: void) (@ a)), @ value)
            if: status != c.LMX_WALK_OK
                return: status
            if: lmx_walk_node(f, lmx_arena_ref_value(code, 1U)) != c.LMX_WALK_OP_OWN
                return: c.LMX_WALK_INVALID
            status: lmx_walk_work_cell(f, lmx_arena_ref_value(code, 1U), 1, @ wholder, @ index, @ slot)
            if: status != c.LMX_WALK_OK
                return: status
            ---
        else:
            if: code\array.size < 4U
                return: c.LMX_WALK_INVALID
            status: lmx_walk_work_cell(f, node, 1, @ wholder, @ index, @ slot)
            if: status != c.LMX_WALK_OK
                return: status
            status: lmx_walk_eval(f, lmx_arena_ref_value(code, 3U), (cast: (@: void) (@ a)), @ value)
            if: status != c.LMX_WALK_OK
                return: status
        ---
        work: lmx_walk_work_find(f, slot)
        if: work = 0
            c.fprintf(l1_stderr(), "lmx: invariant: an own field used but not loaded\n")
            return: c.LMX_WALK_INVALID
        ---
        if: work\kind != 1
            if: value != 0 && lmx_walk_kind(f, value) != c.LMX_KIND_STRUCT
                return: c.LMX_WALK_INVALID
            work\ref: value
            work\dirty: 1
            \out: value
            return: c.LMX_WALK_OK
        ---
        if: value = 0 || lmx_walk_load_operand(f\arena, value, @ wv, @ a) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        if: a != work\ty
            return: c.LMX_WALK_INVALID
        work\num: wv
        work\dirty: 1
        if: lmx_walk_numeric_type(f\arena, dest) != 0
            if: lmx_walk_store_numeric_into(f\arena, dest, wv) != c.LMX_WALK_OK
                return: c.LMX_WALK_INVALID
            ---
        else:
            lmx_int_store_known(dest, (cast: (int) wv))
        ---
        \out: dest
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_ADD || op = c.LMX_WALK_OP_SUB || op = c.LMX_WALK_OP_MUL || op = c.LMX_WALK_OP_DIV || op = c.LMX_WALK_OP_MOD || op = c.LMX_WALK_OP_LT || op = c.LMX_WALK_OP_EQ
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), (cast: (@: void) (@ a)), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 2U), (cast: (@: void) (@ b)), @ other)
        if: status != c.LMX_WALK_OK
            return: status
        # -177: EQ on a pointer cell vs pointer cell or literal 0 compares held addresses.
        # Mutant: always load_operand -> pointer EQ INVALID RED.
        if: op = c.LMX_WALK_OP_EQ && value != 0 && lmx_walk_is_pointer_cell(f\arena, value) != 0
            ua: (cast: (size_t) lmx_pointer_value_known(value))
            if: other = 0
                ub: 0U
            else:
                if: lmx_walk_is_pointer_cell(f\arena, other) != 0
                    ub: (cast: (size_t) lmx_pointer_value_known(other))
                else:
                    if: lmx_walk_load_operand(f\arena, other, @ ub, @ b) != c.LMX_WALK_OK
                        return: c.LMX_WALK_INVALID
                    ---
                    if: b != c.LMX_TYPE_INT || ub != 0U
                        return: c.LMX_WALK_INVALID
                    ---
                    ub: 0U
                ---
            ---
            lmx_int_store_known(dest, (cast: (int) (ua = ub)))
            \out: dest
            return: c.LMX_WALK_OK
        ---
        if: op = c.LMX_WALK_OP_EQ && other != 0 && lmx_walk_is_pointer_cell(f\arena, other) != 0
            ub: (cast: (size_t) lmx_pointer_value_known(other))
            if: value = 0
                ua: 0U
            else:
                if: lmx_walk_load_operand(f\arena, value, @ ua, @ a) != c.LMX_WALK_OK
                    return: c.LMX_WALK_INVALID
                ---
                if: a != c.LMX_TYPE_INT || ua != 0U
                    return: c.LMX_WALK_INVALID
                ---
                ua: 0U
            ---
            lmx_int_store_known(dest, (cast: (int) (ua = ub)))
            \out: dest
            return: c.LMX_WALK_OK
        ---
        # -186 c4 / Opus c3b-3: EQ (and source != via 1-EQ) with a Structure
        # reference or empty slot (null) compares addresses. A non-Structure side
        # must be the int literal 0. Mutant: always load_operand -> struct EQ RED.
        if: op = c.LMX_WALK_OP_EQ && (value = 0 || lmx_walk_kind(f, value) = c.LMX_KIND_STRUCT || other = 0 || lmx_walk_kind(f, other) = c.LMX_KIND_STRUCT)
            ua: (cast: (size_t) value)
            ub: (cast: (size_t) other)
            if: value != 0 && lmx_walk_kind(f, value) != c.LMX_KIND_STRUCT
                if: lmx_walk_load_operand(f\arena, value, @ ua, @ a) != c.LMX_WALK_OK || a != c.LMX_TYPE_INT || ua != 0U
                    return: c.LMX_WALK_INVALID
            ---
            if: other != 0 && lmx_walk_kind(f, other) != c.LMX_KIND_STRUCT
                if: lmx_walk_load_operand(f\arena, other, @ ub, @ b) != c.LMX_WALK_OK || b != c.LMX_TYPE_INT || ub != 0U
                    return: c.LMX_WALK_INVALID
            ---
            lmx_int_store_known(dest, (cast: (int) (ua = ub)))
            \out: dest
            return: c.LMX_WALK_OK
        ---
        if: value = 0 || other = 0
            return: c.LMX_WALK_INVALID
        if: lmx_walk_load_operand(f\arena, value, @ ua, @ a) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        if: lmx_walk_load_operand(f\arena, other, @ ub, @ b) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        if: a != b
            return: c.LMX_WALK_INVALID
        if: op = c.LMX_WALK_OP_LT
            # D-50: INT (and int temps) compare signed; char/size_t/unsigned/ulong stay unsigned.
            if: a = c.LMX_TYPE_INT
                lmx_int_store_known(dest, (cast: (int) ((cast: (int) ua) < (cast: (int) ub))))
            else:
                lmx_int_store_known(dest, (cast: (int) (ua < ub)))
            ---
            \out: dest
            return: c.LMX_WALK_OK
        if: op = c.LMX_WALK_OP_EQ
            lmx_int_store_known(dest, (cast: (int) (ua = ub)))
            \out: dest
            return: c.LMX_WALK_OK
        if: op = c.LMX_WALK_OP_ADD
            if: a = c.LMX_TYPE_INT
                wv: (cast: (size_t) ((cast: (int) ua) + (cast: (int) ub)))
            else:
                wv: ua + ub
            ---
            return: lmx_walk_arith_out(f, dest, a, wv, out)
        ---
        if: op = c.LMX_WALK_OP_SUB
            if: a = c.LMX_TYPE_INT
                wv: (cast: (size_t) ((cast: (int) ua) - (cast: (int) ub)))
            else:
                wv: ua - ub
            ---
            return: lmx_walk_arith_out(f, dest, a, wv, out)
        ---
        # -170 c1 / D-58: MUL/DIV/MOD. Mutant: MUL as ADD -> RED. Div/mod by 0 -> INVALID (X1 of D-37/D-44), not a throw.
        if: op = c.LMX_WALK_OP_MUL
            if: a = c.LMX_TYPE_INT
                wv: (cast: (size_t) ((cast: (int) ua) * (cast: (int) ub)))
            else:
                wv: ua * ub
            ---
            return: lmx_walk_arith_out(f, dest, a, wv, out)
        ---
        if: op = c.LMX_WALK_OP_DIV || op = c.LMX_WALK_OP_MOD
            if: ub = 0U
                return: c.LMX_WALK_INVALID
            ---
            if: a = c.LMX_TYPE_INT
                if: op = c.LMX_WALK_OP_DIV
                    wv: (cast: (size_t) ((cast: (int) ua) / (cast: (int) ub)))
                else:
                    wv: (cast: (size_t) ((cast: (int) ua) % (cast: (int) ub)))
                ---
            else:
                if: op = c.LMX_WALK_OP_DIV
                    wv: ua / ub
                else:
                    wv: ua % ub
                ---
            ---
            return: lmx_walk_arith_out(f, dest, a, wv, out)
        ---
    if: op = c.LMX_WALK_OP_IF
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), (cast: (@: void) (@ a)), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        if: value = 0
            return: c.LMX_WALK_INVALID
        if: lmx_walk_load_operand(f\arena, value, @ wv, @ a) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        if: wv != 0U
            return: lmx_walk_body(f, lmx_arena_ref_struct(code, 2U), 0U)
        if: code\array.size > 3U
            return: lmx_walk_body(f, lmx_arena_ref_struct(code, 3U), 0U)
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_BREAK
        return: c.LMX_WALK_BREAK
    if: op = c.LMX_WALK_OP_CONTINUE
        return: c.LMX_WALK_CONTINUE
    if: op = c.LMX_WALK_OP_WHILE
        while: going != 0
            wv: 0U
            status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), (cast: (@: void) (@ a)), @ value)
            if: status = c.LMX_WALK_OK && value = 0
                status: c.LMX_WALK_INVALID
            if: status = c.LMX_WALK_OK
                if: lmx_walk_load_operand(f\arena, value, @ wv, @ a) != c.LMX_WALK_OK
                    status: c.LMX_WALK_INVALID
                ---
            ---
            if: status != c.LMX_WALK_OK || wv = 0U
                going: 0
            if: going != 0
                status: lmx_walk_body(f, lmx_arena_ref_struct(code, 2U), 0U)
                if: status = c.LMX_WALK_CONTINUE
                    status: c.LMX_WALK_OK
                ---
                if: status = c.LMX_WALK_BREAK
                    status: c.LMX_WALK_OK
                    going: 0
                ---
                if: status != c.LMX_WALK_OK || f\returned != 0
                    going: 0
                ---
            ---
        ---
        return: status
    if: op = c.LMX_WALK_OP_RET
        # One exit order: evaluate the argument -> return.  The argument is computed
        # straight into the CALLER's destination and returned as a plain reference -- k.4
        # (author, §3 item 8): no auto-invoke of a returned callable-looking reference; the
        # translator emits an explicit CALL wherever a call is meant (callable-priority,
        # -130).  Nested if/else/while/for stay ordinary child Structures -- not nested
        # callables.
        if: code\array.size > 1U
            status: lmx_walk_eval(f, lmx_arena_ref_value(code, 1U), f\dest, @ value)
            if: status != c.LMX_WALK_OK
                return: status
            value: lmx_walk_leaving(f, lmx_walk_node(f, lmx_arena_ref_value(code, 1U)), value)
            f\result: value
            if: value != 0
                f\valued: 1
            ---
        else:
            # Bare `return`: keep the last evaluated expression of the body
            # (`1` + bare return -> 1). Mutant: clearing valued here drops it to 0.
            if: f\valued != 0
                value: f\result
            ---
        ---
        f\returned: 1
        \out: value
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_PRIM || op = c.LMX_WALK_OP_PRIM_PUB
        return: lmx_walk_prim(f, code, dest, out)
    if: op = c.LMX_WALK_OP_ADMIT_AS
        return: lmx_walk_admit_op(f, code, dest, out)
    if: op = c.LMX_WALK_OP_EMPTY
        return: lmx_walk_empty(f, code, dest, out)
    if: op = c.LMX_WALK_OP_CALL || op = c.LMX_WALK_OP_EXEC
        return: lmx_walk_call(f, code, dest, out)
    if: op = c.LMX_WALK_OP_EXPECT_INT
        # [expect_int, path, want]: check subject's int at path equals want.
        # Subject is args[0]; path is child[1] (Structure of int indices); want is child[2].
        # No R9.5 dep (uses args[0], not f\self).  No R8.2 dep (path traversal only,
        # no own-field write).  Result in dest: 1 = match, 0 = mismatch.
        if: f\args = 0 || f\nargs < 1U || f\args[0] = 0 || code\array.size < 3U
            lmx_int_store_known(dest, 0)
            \out: dest
            return: c.LMX_WALK_OK
        slot: lmx_arena_ref_cell(code, 1U)
        other: lmx_arena_ref_value(code, 2U)
        if: slot = 0 || slot[0] = 0 || other = 0
            lmx_int_store_known(dest, 0)
            \out: dest
            return: c.LMX_WALK_OK
        if: lmx_domain_kind(f\arena, slot[0]) != c.LMX_KIND_STRUCT
            return: c.LMX_WALK_INVALID
        value: f\args[0]
        index: 0U
        while: index < (cast: (@: Lmx) slot[0])\array.size
            a: lmx_int_value_known(lmx_arena_ref_value((cast: (@: Lmx) slot[0]), index))
            if: a < 0 || (cast: (size_t) a) >= (cast: (@: Lmx) value)\array.size
                return: c.LMX_WALK_INVALID
            expect_leaf: lmx_arena_ref_value(value, (cast: (size_t) a))
            if: expect_leaf = 0
                return: c.LMX_WALK_INVALID
            if: lmx_domain_kind(f\arena, expect_leaf) = c.LMX_KIND_STRUCT
                value: (cast: (@: Lmx) expect_leaf)
            ---
            index: index + 1U
        ---
        if: expect_leaf = 0 || lmx_domain_kind(f\arena, expect_leaf) != c.LMX_KIND_PRIMITIVE || lmx_domain_type(f\arena, expect_leaf) != c.LMX_TYPE_INT
            lmx_int_store_known(dest, 0)
            \out: dest
            return: c.LMX_WALK_OK
        ---
        if: lmx_int_value_known((cast: (@: LmxPrimitive) expect_leaf)) = lmx_int_value_known(other)
            lmx_int_store_known(dest, 1)
        else:
            lmx_int_store_known(dest, 0)
        \out: dest
        return: c.LMX_WALK_OK
    ---
    if: op = c.LMX_WALK_OP_ELEM
        # -203: [elem, array, index]. The array operand evaluates to the descriptor.
        # \out is the numeric cell for a scalar element, and the address of the inner
        # descriptor for an element of type descriptor or Lmx (:1630). That address is
        # what makes ELEM(ELEM(...)) a legal operand. Bounds by descriptor.size.
        # Mutant: index == size -> INVALID.
        if: code\array.size < 3U
            return: c.LMX_WALK_INVALID
        ---
        adesc: lmx_walk_array_from(f, lmx_arena_ref_value(code, 1U), 0)
        if: adesc = 0
            return: c.LMX_WALK_INVALID
        ---
        status: lmx_walk_index(f, lmx_arena_ref_value(code, 2U), @ index)
        if: status != c.LMX_WALK_OK
            return: status
        if: index >= adesc\size || adesc\data = 0
            return: c.LMX_WALK_INVALID
        ---
        aty: lmx_domain_type(f\arena, (cast: (@: void) adesc))
        if: lmx_walk_array_elem_meta(aty, @ ety, @ stride) = 0 || stride = 0U
            return: c.LMX_WALK_INVALID
        ---
        if: ety = c.LMX_TYPE_CHAR
            abytes: (cast: (@: char) adesc\data)
            if: lmx_chars_init(f\arena) != 0 && lmx_arena_find(f\arena, c.LMX_KIND_PRIMITIVE, c.LMX_TYPE_CHAR) = 0
                return: c.LMX_WALK_NOMEM
            ---
            value: lmx_char_cell(f\arena, (cast: (int) (cast: (unsigned) abytes[index] & 255U)))
            if: value = 0
                return: c.LMX_WALK_INVALID
            \out: value
            return: c.LMX_WALK_OK
        ---
        other: (cast: (@: void) ((cast: (@: char) adesc\data) + index * stride))
        if: ety = c.LMX_TYPE_LMX || ety = c.LMX_TYPE_DESC || ety >= c.LMX_TYPE_POINTER_BASE
            if: ety >= c.LMX_TYPE_POINTER_BASE
                \out: lmx_pointer_value_known(other)
            else:
                slot: (cast: (@@: void) other)
                \out: slot[0]
            ---
            return: c.LMX_WALK_OK
        ---
        \out: other
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_ELEMPUT
        # -203: [elemput, array, index, value]. Type must match element.
        # Mutant: char value into int array -> INVALID; index == size -> INVALID.
        if: code\array.size < 4U
            return: c.LMX_WALK_INVALID
        ---
        adesc: lmx_walk_array_from(f, lmx_arena_ref_value(code, 1U), 1)
        if: adesc = 0
            return: c.LMX_WALK_INVALID
        ---
        status: lmx_walk_index(f, lmx_arena_ref_value(code, 2U), @ index)
        if: status != c.LMX_WALK_OK
            return: status
        if: index >= adesc\size || adesc\data = 0
            return: c.LMX_WALK_INVALID
        ---
        status: lmx_walk_eval(f, lmx_arena_ref_value(code, 3U), (cast: (@: void) (@ a)), @ value)
        if: status != c.LMX_WALK_OK
            return: status
        ---
        aty: lmx_domain_type(f\arena, (cast: (@: void) adesc))
        if: lmx_walk_array_elem_meta(aty, @ ety, @ stride) = 0 || stride = 0U
            return: c.LMX_WALK_INVALID
        ---
        other: (cast: (@: void) ((cast: (@: char) adesc\data) + index * stride))
        if: ety = c.LMX_TYPE_CHAR
            if: value = 0 || lmx_walk_numeric_type(f\arena, value) != c.LMX_TYPE_CHAR
                return: c.LMX_WALK_INVALID
            ---
            abytes: (cast: (@: char) adesc\data)
            abytes[index]: (cast: (char) (lmx_char_value_known(value) & 255))
            value: lmx_char_cell(f\arena, (cast: (int) (cast: (unsigned) abytes[index] & 255U)))
            \out: value
            return: c.LMX_WALK_OK
        ---
        if: ety = c.LMX_TYPE_LMX || ety = c.LMX_TYPE_DESC
            if: value != 0 && lmx_walk_kind(f, value) != c.LMX_KIND_STRUCT && lmx_walk_kind(f, value) != c.LMX_KIND_ARRAY
                return: c.LMX_WALK_INVALID
            ---
            slot: (cast: (@@: void) other)
            slot[0]: value
            \out: value
            return: c.LMX_WALK_OK
        ---
        if: ety >= c.LMX_TYPE_POINTER_BASE
            if: value != 0 && lmx_walk_kind(f, value) != c.LMX_KIND_STRUCT && lmx_walk_kind(f, value) != c.LMX_KIND_ARRAY
                return: c.LMX_WALK_INVALID
            ---
            if: lmx_pointer_store_known(other, value) != 0
                return: c.LMX_WALK_INVALID
            \out: other
            return: c.LMX_WALK_OK
        ---
        if: value = 0
            return: c.LMX_WALK_INVALID
        ---
        if: lmx_walk_load_operand(f\arena, value, @ wv, @ a) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        ---
        if: a != ety
            return: c.LMX_WALK_INVALID
        ---
        if: lmx_walk_store_numeric_into(f\arena, other, wv) != c.LMX_WALK_OK
            return: c.LMX_WALK_INVALID
        \out: other
        return: c.LMX_WALK_OK
    if: op = c.LMX_WALK_OP_LENGTH
        # -203: [length, array] -> descriptor.size as size_t.
        if: code\array.size < 2U
            return: c.LMX_WALK_INVALID
        ---
        adesc: lmx_walk_array_from(f, lmx_arena_ref_value(code, 1U), 0)
        if: adesc = 0
            return: c.LMX_WALK_INVALID
        ---
        return: lmx_walk_arith_out(f, dest, c.LMX_TYPE_SIZE_T, adesc\size, out)
    ---
    if: op = c.LMX_WALK_OP_PAD
        # Reached in order: the handler runs only from a landing, not from this arm.
        \out: 0
        return: c.LMX_WALK_OK
    ---
return: c.LMX_WALK_INVALID

# The children of a body from `first` on, in order.  Own cells and anything that is not
# a frame node are data, not steps.  An executed return ends the walk of every enclosing
# body of this activation.  The value of a step is dropped; its destination is a C int of
# this very frame.
# k.4 / -191 (author, next_core_tasks.md §3 item 8: "отдельного признака callable нет...
# отказ — дело транслятора"): a non-op child -- a declaration cell, an own-field
# Structure, or a bare reference held elsewhere -- is a plain value, evaluated and
# discarded, never auto-invoked.  What gets called is only ever an explicit CALL node:
# the translator already knows statically which names are callable (callable-priority,
# -130) and emits CALL for a bare-callable statement or a returned callable the same way
# it emits CALL anywhere else.  The walker runs what the graph says and nothing more.
fn: lmx_walk_body (@: LmxWalkFrame f; @: Lmx body; size_t: first) int
    @: void child 0
    @: void dropped 0
    @: void step_dest 0
    int: spare 0
    @: Lmx pad 0
    int: step_op
    int: status c.LMX_WALK_OK
    size_t: i first
    size_t: j 0U
    if: f = 0 || body = 0
        return: c.LMX_WALK_INVALID
    while: status = c.LMX_WALK_OK && f\returned = 0 && i < body\array.size
        child: lmx_arena_ref_value(body, i)
        # Activation value is the last evaluated expression (final temp). Evaluate
        # each step into the activation destination when the caller lent one, so a
        # bare fall-off and a bare RET still hand back that last value.
        step_dest: (cast: (@: void) (@ spare))
        if: f\dest != 0
            step_dest: f\dest
        ---
        step_op: lmx_walk_op(f, child)
        if: step_op != c.LMX_WALK_OP_NONE
            status: lmx_walk_eval(f, child, step_dest, @ dropped)
            # Activation value = last evaluated expression. SET/PUT/IF/WHILE are
            # statements (void fall-off). LIT/arith/CALL/OWN/... count. RET sets valued itself.
            if: status = c.LMX_WALK_OK && dropped != 0 && step_op != c.LMX_WALK_OP_SET && step_op != c.LMX_WALK_OP_SET_OF && step_op != c.LMX_WALK_OP_SET_ARG && step_op != c.LMX_WALK_OP_PUT && step_op != c.LMX_WALK_OP_PUT_REF && step_op != c.LMX_WALK_OP_PUT_OF && step_op != c.LMX_WALK_OP_ELEMPUT && step_op != c.LMX_WALK_OP_IF && step_op != c.LMX_WALK_OP_WHILE && step_op != c.LMX_WALK_OP_PAD
                f\result: dropped
                f\valued: 1
            ---
        ---
        # A throw from the handler can name another pad of this same body.
        # Landing is cleared before each handler, so this loop runs again only
        # when that handler throws onto a pad whose parent is still this body.
        # One such pad is bound once: the next turn sees landing 0 unless a new throw sets it.
        while: status != c.LMX_WALK_OK && f\landing != 0 && f\landing\parent = body
            pad: f\landing
            status: lmx_walk_catch_bind(f)
            if: status = c.LMX_WALK_OK
                j: 0U
                while: j < body\array.size && lmx_arena_ref_value(body, j) != (cast: (@: void) pad)
                    j: j + 1U
                ---
                if: j >= body\array.size
                    status: c.LMX_WALK_INVALID
                else:
                    i: j
                ---
            ---
        ---
        i: i + 1U
    ---
return: status

sub: lmx_walk_frame_open (@: LmxWalkFrame f; @: LmxWalkContext context; @: Lmx code; @: Lmx data; @@: void args; size_t: nargs)
    memset((cast: (@: void) f), 0, c.sizeof(c.LmxWalkFrame))
    f\context: context
    f\arena: context\arena
    f\roles: context\roles
    f\code: code
    f\node: data
    f\args: args
    f\nargs: nargs
end: lmx_walk_frame_open

# ENTRY (k.4, next_core_tasks.md §3 item 9: no descriptor, no cached plan -- nothing
# beyond the two Structures themselves).  `code` and `data` must each classify as a
# Structure; that is the whole check.  There is no "callable" test and no refusal for a
# code Structure with zero body steps -- "no operator" is not "invalid", it is a body
# that runs zero steps and falls off the end, the same as any other (author, §3 item 8:
# "отдельного признака callable нет... отказ — дело транслятора").
fn: lmx_walk_enter (@: LmxWalkFrame f; @: LmxWalkContext context; @: Lmx code; @: Lmx data; @@: void args; size_t: nargs) int
    if: f = 0
        return: c.LMX_WALK_INVALID
    if: context = 0 || context\arena = 0 || context\scratch = 0 || context\roles = 0 || code = 0 || data = 0
        memset((cast: (@: void) f), 0, c.sizeof(c.LmxWalkFrame))
        return: c.LMX_WALK_INVALID
    lmx_walk_frame_open(f, context, code, data, args, nargs)
    if: lmx_walk_kind(f, (cast: (@: void) code)) != c.LMX_KIND_STRUCT || lmx_walk_kind(f, (cast: (@: void) data)) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_INVALID
return: c.LMX_WALK_OK

# The walked activations running on this thread, top first, linked through LmxWalkFrame.up (lmx_walk_activate): frames
# on the C stack, ordinary activation state -- nothing of it is in the graph.
thread_local: @: LmxWalkFrame lmx_walk_active_top 0

# Is `data` the data of an activation from `f` down?  A re-entrant activation is one whose data is (book §12).
fn: lmx_walk_active_over (@: LmxWalkFrame f; @: Lmx data) int
    @: LmxWalkFrame g f
    while: g != 0
        if: g\node = data
            return: 1
        g: g\up
    ---
return: 0

fn: lmx_walk_activate (@: LmxWalkContext context; @: Lmx code; @: Lmx data; @@: void args; size_t: nargs; @: void dest; @@: void result; @: int present) int
    LmxWalkFrame: frame
    LmxScratchMark: mark
    @: LmxWalkFrame f 0
    @: LmxScratchMark pm 0
    int: status
    int: a 0
    int: linked 0
    if: result != 0
        \result: 0
    if: present != 0
        \present: 0
    if: context = 0 || context\scratch = 0 || dest = 0
        return: c.LMX_WALK_INVALID
    f: @ frame
    pm: @ mark
    # Everything this activation takes from the scratch arena is taken after this mark and is
    # gone with the rewind below, whichever way the activation ends.
    if: lmx_scratch_mark(context\scratch, pm) != c.LMX_SCRATCH_OK
        return: c.LMX_WALK_INVALID
    status: lmx_walk_enter(f, context, code, data, args, nargs)
    # Re-entrant: an activation over the same data runs below this one on this thread (Codex's reading of the author's
    # norm, 2026-09-28: «Inner changes do not publish into outer occurrence S»).
    if: status = c.LMX_WALK_OK
        f\up: lmx_walk_active_top
        f\reent: lmx_walk_active_over(f\up, data)
        lmx_walk_active_top: f
        linked: 1
    ---
    # §7b: the entry load (Lingvamyxa spec 21.5): the working table of the own fields the code uses, from the code.
    if: status = c.LMX_WALK_OK
        status: lmx_walk_load_code(f)
    if: status = c.LMX_WALK_OK
        f\dest: dest
        status: lmx_walk_body(f, code, 0U)
    # §7b: the activation ends -- a RET with its value already evaluated, a fall-off, or a throw that leaves -- so what
    # is dirty is published before control goes back (book §14).  Nested bodies end nothing: only this does.
    if: status = c.LMX_WALK_OK || status >= c.LMX_WALK_THROWN
        a: lmx_walk_publish(f)
        if: a != c.LMX_WALK_OK
            status: a
    ---
    if: status = c.LMX_WALK_OK && f\valued != 0
        if: result != 0
            \result: f\result
        if: present != 0
            \present: 1
        ---
    ---
    # THROWN: the callee's landing stays 0 when its site renumbered. Only the
    # payload crosses. The caller reads it from this out-parameter.
    if: status >= c.LMX_WALK_THROWN && result != 0
        \result: f\payload
    ---
    if: linked != 0
        lmx_walk_active_top: f\up
    ---
    if: lmx_scratch_rewind(context\scratch, pm) != c.LMX_SCRATCH_OK && status = c.LMX_WALK_OK
        status: c.LMX_WALK_INVALID
    ---
return: status

# The public boundary.  What comes in from outside is asked about once: a reference the
# context's local/imported address index cannot classify is foreign, and nothing runs.
# A direct/root caller runs one Structure over itself, as every call does: (M, M), (R0, R0).
fn: lmx_walk_run (@: LmxWalkContext context; @: Lmx node; @@: void args; size_t: nargs; @: LmxWalkValue out) int
    @: void dest 0
    @: void value 0
    int: spare 0
    int: present 0
    int: status
    size_t: i 0U
    if: out != 0
        out\ref: 0
        out\number: 0
        out\present: 0
    ---
    if: context = 0 || context\arena = 0
        return: c.LMX_WALK_INVALID
    if: nargs != 0U && args = 0
        return: c.LMX_WALK_INVALID
    while: i < nargs
        if: args[i] != 0
            context\classified: context\classified + 1U
            if: lmx_range_classify(context\arena, args[i]) = c.LMX_KIND_NONE
                return: c.LMX_WALK_INVALID
            ---
        ---
        i: i + 1U
    ---
    dest: (cast: (@: void) (@ spare))
    if: out != 0
        dest: (cast: (@: void) (@ out\number))
    status: lmx_walk_activate(context, node, node, args, nargs, dest, @ value, @ present)
    if: status = c.LMX_WALK_OK && out != 0
        out\ref: value
        out\present: present
    ---
return: status

# -180 / FABLE-GROKBOT-WALK-ADMIT-20260925-180 (+ Opus addendum):
# Resolve value operand: null -> out 0 OK; pointer cell -> held null OK / held Structure admit /
# else FAIL; Structure -> admit; anything else FAIL=1 (PRIMITIVE).
# admit: implements(value, model, model); YES -> \out=value (ref, never copy); else THROW_IMPLEMENTS.
# admit_letter: same resolve, then admit slot 1 (payload); null/non-Structure payload -> THROW_IMPLEMENTS.
# Mutants RED: copy instead of ref; NO->OK; NO->FAIL; admit_letter slot0; null->THROW.
fn: lmx_walk_admit_resolve (@: LmxArena arena; @: void raw; @@: void out_value) int
    @: void held 0
    \out_value: 0
    if: arena = 0
        return: 1
    ---
    if: raw = 0
        return: 0
    ---
    if: lmx_walk_is_pointer_cell(arena, raw) != 0
        held: lmx_pointer_value_known(raw)
        if: held = 0
            return: 0
        ---
        if: lmx_range_classify(arena, held) = c.LMX_KIND_STRUCT
            \out_value: held
            return: 0
        ---
        return: 1
    ---
    if: lmx_range_classify(arena, raw) = c.LMX_KIND_STRUCT
        \out_value: raw
        return: 0
    ---
return: 1

fn: lmx_walk_admit_against (@: LmxArena arena; @: Lmx value; @: Lmx model; @@: void out) int
    int: admit
    if: arena = 0 || value = 0 || model = 0 || out = 0
        return: 1
    ---
    admit: lmx_runtime_implements(arena, value, model, model)
    if: admit = c.LMX_IMPLEMENTS_YES
        \out: (cast: (@: void) value)
        return: 0
    ---
    \out: 0
return: c.LMX_PRIMITIVE_THROW_IMPLEMENTS

fn: lmx_walk_admit (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    @: LmxArena arena 0
    @: Lmx model 0
    @: void value 0
    int: st
    \out: 0
    if: owner = 0 || refs = 0 || out = 0 || nargs != 2U
        return: 1
    ---
    arena: (cast: (@: LmxArena) owner)
    model: (cast: (@: Lmx) refs[1])
    if: model = 0 || lmx_range_classify(arena, (cast: (@: void) model)) != c.LMX_KIND_STRUCT
        return: 1
    ---
    st: lmx_walk_admit_resolve(arena, refs[0], @ value)
    if: st != 0
        return: 1
    ---
    if: value = 0
        return: 0
    ---
return: lmx_walk_admit_against(arena, (cast: (@: Lmx) value), model, out)

fn: lmx_walk_admit_letter (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int
    @: LmxArena arena 0
    @: Lmx model 0
    @: Lmx letter 0
    @: void value 0
    @: void payload 0
    int: st
    \out: 0
    if: owner = 0 || refs = 0 || out = 0 || nargs != 2U
        return: 1
    ---
    arena: (cast: (@: LmxArena) owner)
    model: (cast: (@: Lmx) refs[1])
    if: model = 0 || lmx_range_classify(arena, (cast: (@: void) model)) != c.LMX_KIND_STRUCT
        return: 1
    ---
    st: lmx_walk_admit_resolve(arena, refs[0], @ value)
    if: st != 0
        return: 1
    ---
    if: value = 0
        return: 0
    ---
    letter: (cast: (@: Lmx) value)
    # q25 (ii): admit payload at slot 1; \out = payload (keep this line obvious if author picks (i)=\out letter).
    payload: lmx_arena_ref_value(letter, 1U)
    if: payload = 0 || lmx_range_classify(arena, payload) != c.LMX_KIND_STRUCT
        return: c.LMX_PRIMITIVE_THROW_IMPLEMENTS
    ---
return: lmx_walk_admit_against(arena, (cast: (@: Lmx) payload), model, out)

# D-105 (the author's Q39, 2026-09-27; Codex, 2026-09-28): [admit_as, 0, catch, value, model, map cells...,
# rows...] -- the value admitted to the named Structure `model` and recorded in the arena's `implements` table, where
# every later admission and every OF/PUT_OF typed with the model finds it: through the correspondence this frame
# carries in place (its size cells from slot 5, cell j the value's slot of model's field j), or as the model's own
# (no cells).  The record keeps the frame and the offset -- the map is read from the frame, the interpretable graph,
# never copied out.  A null value passes unadmitted; NO is the implicit throw `implements` (THROWN + 2, its catch
# rows the frame's last operands, as a PRIM's).
fn: lmx_walk_admit_op (@: LmxWalkFrame f; @: Lmx code; @: void dest; @@: void out) int
    LmxImplEntry: view
    @: LmxImplEntry v 0
    @: void raw 0
    @: void value 0
    @: Lmx model 0
    size_t: catch_n 0U
    size_t: n
    int: a 0
    int: status
    int: answer
    \out: 0
    if: code\array.size < 5U
        return: c.LMX_WALK_INVALID
    ---
    if: lmx_walk_catch_count(f, lmx_arena_ref_value(code, 2U), @ catch_n) != c.LMX_WALK_OK || code\array.size < 5U + 3U * catch_n
        return: c.LMX_WALK_INVALID
    ---
    n: code\array.size - 5U - 3U * catch_n
    model: (cast: (@: Lmx) lmx_arena_ref_value(code, 4U))
    if: model = 0 || lmx_walk_kind(f, (cast: (@: void) model)) != c.LMX_KIND_STRUCT
        return: c.LMX_WALK_INVALID
    ---
    status: lmx_walk_eval(f, lmx_arena_ref_value(code, 3U), (cast: (@: void) (@ a)), @ raw)
    if: status != c.LMX_WALK_OK
        return: status
    ---
    if: lmx_walk_admit_resolve(f\arena, raw, @ value) != 0
        return: c.LMX_WALK_INVALID
    ---
    if: value = 0
        return: c.LMX_WALK_OK
    ---
    v: @ view
    memset((cast: (@: void) v), 0, c.sizeof(c.LmxImplEntry))
    if: n != 0U
        v\frame: code
        v\at: 5U
        v\n: n
    ---
    answer: lmx_implements_register(f\arena, (cast: (@: Lmx) value), model, v)
    if: answer = c.LMX_IMPLEMENTS_YES
        \out: value
        return: c.LMX_WALK_OK
    ---
    if: answer != c.LMX_IMPLEMENTS_NO
        return: c.LMX_WALK_INVALID
    ---
    status: c.LMX_WALK_THROWN + 2
    f\payload: 0
    if: catch_n != 0U
        status: lmx_walk_catch_scan(f, code, 5U + n, catch_n, status)
    ---
return: status

# A copy of what a slot holds, as a merge copies data: a value cell -- a number -- is a fresh cell of its own type
# holding its value now; a char cell is the byte table's, shared as those cells always are; anything else (a
# Structure, a reference) is itself.  0 on no room.
fn: lmx_walk_cell_copy (@: LmxArena arena; @: void cell) @: void
    @: void fresh 0
    int: ty
    if: arena = 0 || cell = 0 || lmx_range_classify(arena, cell) != c.LMX_KIND_PRIMITIVE
        return: cell
    ty: lmx_range_type_of(arena, cell)
    if: ty = c.LMX_TYPE_INT
        fresh: lmx_int_new_owned(arena)
        if: fresh = 0 || lmx_int_store_known(fresh, lmx_int_value_known(cell)) != 0
            return: 0
        return: fresh
    ---
    if: ty = c.LMX_TYPE_SIZE_T
        fresh: lmx_size_new_owned(arena)
        if: fresh = 0 || lmx_size_store_known(fresh, lmx_size_value_known(cell)) != 0
            return: 0
        return: fresh
    ---
    if: ty = c.LMX_TYPE_UNSIGNED
        fresh: lmx_unsigned_new_owned(arena)
        if: fresh = 0 || lmx_unsigned_store_known(fresh, lmx_unsigned_value_known(cell)) != 0
            return: 0
        return: fresh
    ---
    if: ty = c.LMX_TYPE_ULONG
        fresh: lmx_ulong_new_owned(arena)
        if: fresh = 0 || lmx_ulong_store_known(fresh, lmx_ulong_value_known(cell)) != 0
            return: 0
        return: fresh
    ---
return: cell

# Item 738 (Q38/Q42/Q44, the author: a capture is a copy of the fields the model reads; steps/capture-
# 738.md): a Structure in req's own layout -- req's width, each field fields[0..n) names a fresh cell at req's
# own slot holding src's value now (a char cell is the byte table's, shared as those cells always are), every
# other slot empty.  It is recorded in the arena's `implements` table as req's own layout with holes (D-105; Codex,
# 2026-09-28): the model reads the fields at req's slots, and an empty slot is not carried -- a read of it is
# refused, never read as present.  No correspondence Structure is made.  The copy hangs under `parent` (no slot
# of it).  0 when a field is not a value cell, or on no room.  The translator names value fields only
# (l2_cap_add), so its host's abort on 0 is a guard and an out-of-memory stop.
fn: lmx_walk_capture (@: LmxArena arena; @: Lmx parent; @: Lmx src; @: Lmx req; @: size_t fields; size_t: n) @: Lmx
    LmxImplEntry: view
    @: LmxImplEntry v 0
    @: Lmx copy 0
    size_t: i 0U
    size_t: j
    @: void cell
    @: void fresh
    size_t: sj
    @: LmxImplEntry own 0
    if: arena = 0 || parent = 0 || src = 0 || req = 0 || fields = 0
        return: 0
    # D-105 native x item 738 (steps/d105-native.md): a source admitted to req by name -- a formal that a
    # value of another type reached -- holds req's field j at the slot its record gives, not at j.
    own: lmx_implements_find(arena, src, req)
    copy: lmx_struct_new_owned(parent, arena)
    if: copy = 0
        return: 0
    if: (req\array.size) != 0U && lmx_arena_refs_open_owned(arena, copy, (req\array.size)) != 0
        return: 0
    while: i < n
        j: fields[i]
        if: j >= req\array.size
            return: 0
        sj: j
        if: own != 0 && lmx_implements_slot(arena, src, req, j, @ sj) != 0
            return: 0
        if: sj >= src\array.size
            return: 0
        cell: lmx_arena_ref_value(src, sj)
        if: cell = 0 || lmx_range_classify(arena, cell) != c.LMX_KIND_PRIMITIVE
            return: 0
        fresh: lmx_walk_cell_copy(arena, cell)
        if: fresh = 0 || fresh = cell && lmx_range_type_of(arena, cell) != c.LMX_TYPE_CHAR
            return: 0
        if: lmx_arena_ref_store(copy, j, fresh) != 0
            return: 0
        i: i + 1U
    ---
    v: @ view
    memset((cast: (@: void) v), 0, c.sizeof(c.LmxImplEntry))
    v\holes: 1
    if: lmx_implements_register(arena, copy, req, v) != c.LMX_IMPLEMENTS_YES
        return: 0
return: copy
