# Probe R3 (machine module): the emit:7318 shape, a string actual, then a bare dereference `\out` of an int pointer
# formal, then an actual that runs a prototyped door call.
predef: "probe_calls.h.lm1"
fn: show (@: out int; int: oi) int
    if: c.take_text("l2_rw%d %s[%d]\n", \out, c.pick(oi), oi) != 0
        return: 1
    return: 0
end: show
