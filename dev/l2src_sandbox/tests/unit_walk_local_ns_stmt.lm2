# Mixed dispatch under --walk-methods: host m is interpreted; local S retains
# its native implementation because cast is L2. Both execute the same retained
# source occurrence, with results 0, 14, 24 and exit 7.
fn: m () int
    int: k 10
    S:
        size_t: v 4U
        size_t: w 0U
        w: v + (cast: (size_t) k)
    int: r 0
    if: S\w = 0U
        r: r + 1
    S\v: 9U
    S()
    if: S\v = 4U && S\w = 14U
        r: r + 2
    k: 20
    S
    if: S\w = 24U
        r: r + 4
    int: out r
    return: out
end: m
int: r 0
r: m()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
