# Beside a reference only 0 stands (the walk's rule -179): `if: b = 3` is refused at the 3, as the walk refuses it.
# Natively it compiled with no warning at all, comparing the Box's pointer with 3.  (`b = 0`: unit_valkind_ref_ok.)
Box:
    int: v 0
end: Box
fn: take (int: x) int
    return: x
end: take
fn: peek () int
    b: merge: Box
    if: b = 3
        return: 1
    return: 0
end: peek
int: r 0
r: peek()
sendMessage: exit(exit_code: r; stdout: ""; stderr: "")
return
