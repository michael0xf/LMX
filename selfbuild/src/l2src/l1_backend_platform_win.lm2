# Ordinary L2 Windows backend platform bodies. Native headers own their ABI.
include: "<stddef.h>" "<windows.h>" "<direct.h>"

fn: l1_replace_file (const: (@: tmp char); const: (@: out_path char)) int
    if: c.MoveFileExA(tmp, out_path, 1U) = 0
        return: (cast: (int) 1)
    return: (cast: (int) 0)
end: l1_replace_file

fn: l1_getcwd (@: buffer char; size_t: size) @: char
    return: (cast: (@: char) c._getcwd(buffer, (cast: (int) size)))
end: l1_getcwd

fn: l1_path_is_absolute (const: (@: path char)) int
    if: path = 0 || path[0] = 0
        return: (cast: (int) 0)
    if: (path[0] = 47 || path[0] = 92) && (path[1] = 47 || path[1] = 92)
        return: (cast: (int) 1)
    if: path[1] = 58 && (path[2] = 47 || path[2] = 92)
        return: (cast: (int) 1)
    return: (cast: (int) 0)
end: l1_path_is_absolute
