# A method that stands above every declaration of a name has no binding of
# it. value stands above the store of h2 and calls h2 in a value position:
# the head is unknown there, and the call is refused. The callable the unit
# declares later is not found for it.
fn: value () int
    return: h2(1 2)
end: value

fn: make2 (int: n) fn: (int: x; int: y) int
    fn: f2 (int: x; int: y) int
        return: n + x * 10 + y
    return: f2

h2: make2 100
sendMessage: exit(exit_code: value(); stdout: ""; stderr: "")
return
