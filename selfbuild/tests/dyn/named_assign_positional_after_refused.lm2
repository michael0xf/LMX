# Named actuals (the book, named-actuals: "Positional actuals precede named ones"; M6 4a, slice 345): a positional actual
# after a named one is refused at translation; the semicolon closes the named tail `a: 1`.
fn: tst (int: c 3; int: a 2) int
    return: c * 10 + a
end: tst
int: code 7
if: tst(a: 1; 2) != 21
    code: 81
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
