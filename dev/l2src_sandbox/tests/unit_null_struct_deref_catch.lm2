# A present Structure reference holding nothing, followed by an executed operation -- a field read, a field write, a path
# through a reference field -- is the implicit `interpreter` throw in both modes, taken by `catch: interpreter ()` (Codex,
# CODEX-STRUCT-NULL-20261011-151401; the book, exceptions; steps/defects.md NULL-STRUCTURE-DEREF-DIVERGES).  Before:
# natively "lmx: invariant: a field path met no Structure" (abort), walked "walk error: INVALID".  The roots: an own
# reference, a formal the caller passed, the reference field of a merged Structure; a store through the null too.  Entry 7.
Model: (int: v 11; int: spare 99)
Holder:
    ref: @: Model: 0
    int: k 3
end: Holder
fn: own_root () int
    box: @: Model: 0
    int: got 1
    ---
        got: box\v
    ---
    catch: interpreter ()
        got: 7
return: got

fn: formal_root (Model: m) int
    int: got 1
    ---
        got: m\v
    ---
    catch: interpreter ()
        got: 7
return: got

fn: through_field () int
    h: merge: Holder
    int: got 1
    ---
        got: h\ref\v
    ---
    catch: interpreter ()
        got: 7
return: got

fn: store_through () int
    box: @: Model: 0
    int: got 1
    ---
        box\v: 5
        got: 2
    ---
    catch: interpreter ()
        got: 7
return: got

fn: work () int
    none: @: Model: 0
    if: own_root() != 7
        return: 81
    if: formal_root(none) != 7
        return: 82
    if: through_field() != 7
        return: 83
    if: store_through() != 7
        return: 84
    return: 7
end: work
sendMessage: exit(exit_code: work(); stdout: ""; stderr: "")
return
