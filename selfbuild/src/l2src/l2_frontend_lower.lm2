                # operand order,including bare bindings and namespace values.
                if: lm_compiler_merge_operand_value(last, span, own_ty_cell[0][merge_own], mi, ind, l2_bind_tok) != 0 || c.fprintf(out_cell[0], "%sl2_mops[%dU]: (cast: (@: Lmx) %s)\n", ind, k, l2_bind_tok\data) < 0
