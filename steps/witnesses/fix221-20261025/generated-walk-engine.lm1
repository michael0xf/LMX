predef: "l2src/lmx_array_owned.h.lm1"
predef: "l2src/lmx_chars.lm1"
# Inherited program state; declaration generation does NOT remove its ambient-state debt.
@@: Lmx lmx_walk_program_roots_g 0
size_t: lmx_walk_program_root_count_g 0U
predef: "l2src/lmx_walk_values.lm1"
predef: "l2src/lmx_scratch.lm1"
predef: "l2src/lmx_primitive.h.lm1"
predef: "l2src/lmx_source_names.h.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<string.h>" "<limits.h>"

prototype:
    fn: lmx_walk_call0_dispatch (@: LmxArena arena; @: Lmx callable; @: int value) int
    fn: lmx_walk_call_prim_dispatch (@: LmxArena arena; @: Lmx code; @: Lmx data; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int
    fn: lmx_walk_callable_addr (@: LmxArena arena; @: Lmx node) LmxEntry
    fn: lmx_walk_empty (@: LmxWalkFrame f; @: Lmx code; @: LmxWalkValue out) int
    fn: lmx_walk_data_holder (@: LmxWalkFrame f; @: void holder) @: void
    fn: lmx_walk_body (@: LmxWalkFrame f; @: Lmx body; size_t: first) int
    fn: lmx_walk_admit_against (@: LmxArena arena; @: Lmx value; @: Lmx model; @@: void out) int
    fn: lmx_walk_admit_op (@: LmxWalkFrame f; @: Lmx code; @: LmxWalkValue out) int
    fn: lmx_walk_admit_in (@: LmxWalkFrame f; @: Lmx receiver; @: Lmx code; @: LmxWalkValue out) int
    fn: lmx_walk_source_of (@: LmxWalkFrame f; @: Lmx code) int
    fn: lmx_walk_model_operand (@: LmxWalkFrame f; @: void operand; @@: Lmx out) int
    fn: lmx_walk_admit_resolve (@: LmxArena arena; @: void raw; @@: void out_value) int
    fn: lmx_walk_immutable (@: LmxWalkFrame f; @: void p) int
    fn: lmx_walk_array_from (@: LmxWalkFrame f; @: void node; int: write; @@: LmxArray out) int
    fn: lmx_walk_array_elem_meta (int: type; @: int elem; @: size_t stride) int
    fn: lmx_walk_index (@: LmxWalkFrame f; @: void node; @: size_t out) int
    fn: lmx_walk_fault (@: LmxWalkFrame f) int
end: prototype
