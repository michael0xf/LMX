predef: "l2src/lmx_thread.lm1"
predef: "l2src/lmx_turn.lm1"
predef: "l2src/lmx_child.lm1"
predef: "l2src/lmx_post.lm1"
predef: "l2src/lmx_schedule.lm1"
predef: "l2src/lmx_pool.lm1"
predef: "l2src/lmx_arena.lm1"
predef: "l2src/lmx_arena_blocks.lm1"
predef: "l2src/lmx_range.lm1"
predef: "l2src/lmx_implements.lm1"
predef: "l2src/lmx_value_owned.lm1"
predef: "l2src/lmx_arena_refs.lm1"
predef: "l2src/lmx_chars_owned.lm1"
predef: "l2src/lmx_array_owned.lm1"
predef: "l2src/lmx_array_ref_owned.lm1"
predef: "l2src/lmx_graph_copy_owned.lm1"
predef: "l1src/libc_abi.lm1"
include: "<stdio.h>" "<stdlib.h>" "<string.h>"

# LmxThread live direct children (BRANCH_REMOVAL_PLAN step 1).  Pins the four acts:
#   add, remove, is-direct-child, iterate (first/next).
# Branch is untouched; this list is storage on Thread only.

sub: tc_check (@: int counts; int: ok; const: @(char label))
    counts[0]: counts[0] + 1
    if: ok = 0
        counts[1]: counts[1] + 1
        c.printf("FAIL %s\n", label)
    ---
end: tc_check

fn: tc_thread () @: LmxThread
    @: LmxThread t
    t: (cast: (@: LmxThread) calloc(1U, c.sizeof(c.LmxThread)))
return: t

fn: main () int
    @: int counts (cast: (@: int) calloc(2U, c.sizeof(int)))
    # The chain lives in the PARENT's arena (lmx_thread.h.lm1, LmxLink): this probe builds the
    # Thread records by hand, so it names the arena the links themselves are taken from.
    LmxArena: link_arena
    @: LmxThread parent 0
    @: LmxThread a 0
    @: LmxThread b 0
    @: LmxThread c 0
    @: LmxThread walk 0
    int: n
    int: failures
    if: counts = 0
        return: 2
    ---
    memset((cast: (@: void) (@ link_arena)), 0, c.sizeof(c.LmxArena))
    if: lmx_arena_open(@ link_arena) != 0
        free(counts)
        return: 2
    ---
    parent: tc_thread()
    a: tc_thread()
    b: tc_thread()
    c: tc_thread()
    if: parent = 0 || a = 0 || b = 0 || c = 0
        fputs("lmx_thread_children: calloc failed\n", l1_stdout())
        free(counts)
        return: 2
    ---

    # Empty: not a child, first is null, next of null is null.
    tc_check(counts, lmx_thread_child_is(parent, a) = 0, "empty list claimed a child")
    tc_check(counts, lmx_thread_child_first(parent) = 0, "empty list had a first child")
    tc_check(counts, lmx_thread_child_next(0) = 0, "next of null was not null")

    # Refusals.
    tc_check(counts, lmx_thread_child_add(0, a, @ link_arena) = c.LMX_THREAD_INVALID, "add with null parent was accepted")
    tc_check(counts, lmx_thread_child_add(parent, 0, @ link_arena) = c.LMX_THREAD_INVALID, "add with null child was accepted")
    tc_check(counts, lmx_thread_child_add(parent, parent, @ link_arena) = c.LMX_THREAD_INVALID, "add of self was accepted")
    tc_check(counts, lmx_thread_child_remove(parent, a) = c.LMX_THREAD_INVALID, "remove from empty was accepted")

    # Add three (prepend order: last added is first).
    tc_check(counts, lmx_thread_child_add(parent, a, @ link_arena) = c.LMX_THREAD_OK, "add a failed")
    tc_check(counts, lmx_thread_child_add(parent, b, @ link_arena) = c.LMX_THREAD_OK, "add b failed")
    tc_check(counts, lmx_thread_child_add(parent, c, @ link_arena) = c.LMX_THREAD_OK, "add c failed")
    tc_check(counts, lmx_thread_child_add(parent, a, @ link_arena) = c.LMX_THREAD_INVALID, "duplicate add was accepted")

    # is-direct-child
    tc_check(counts, lmx_thread_child_is(parent, a) != 0, "a was not a direct child")
    tc_check(counts, lmx_thread_child_is(parent, b) != 0, "b was not a direct child")
    tc_check(counts, lmx_thread_child_is(parent, c) != 0, "c was not a direct child")
    tc_check(counts, lmx_thread_child_is(a, b) = 0, "cross-parent is claimed a child")

    # Iterate: prepend => order c, b, a
    walk: lmx_thread_child_first(parent)
    tc_check(counts, walk = c, "first was not c")
    walk: lmx_thread_child_next(walk)
    tc_check(counts, walk = b, "second was not b")
    walk: lmx_thread_child_next(walk)
    tc_check(counts, walk = a, "third was not a")
    walk: lmx_thread_child_next(walk)
    tc_check(counts, walk = 0, "iterate did not end")

    # Count via iterate
    n: 0
    walk: lmx_thread_child_first(parent)
    while: walk != 0
        n: n + 1
        walk: lmx_thread_child_next(walk)
    ---
    tc_check(counts, n = 3, "iterate count was not 3")

    # Remove middle (b): list becomes c, a
    tc_check(counts, lmx_thread_child_remove(parent, b) = c.LMX_THREAD_OK, "remove b failed")
    tc_check(counts, lmx_thread_child_is(parent, b) = 0, "b still claimed after remove")
    tc_check(counts, lmx_thread_child_next(b) = 0, "removed b kept a sibling link")
    walk: lmx_thread_child_first(parent)
    tc_check(counts, walk = c, "after remove-middle first was not c")
    walk: lmx_thread_child_next(walk)
    tc_check(counts, walk = a, "after remove-middle second was not a")
    walk: lmx_thread_child_next(walk)
    tc_check(counts, walk = 0, "after remove-middle list did not end")

    # Remove head (c): list becomes a
    tc_check(counts, lmx_thread_child_remove(parent, c) = c.LMX_THREAD_OK, "remove head failed")
    tc_check(counts, lmx_thread_child_first(parent) = a, "after remove-head first was not a")

    # Remove last (a): empty
    tc_check(counts, lmx_thread_child_remove(parent, a) = c.LMX_THREAD_OK, "remove last failed")
    tc_check(counts, lmx_thread_child_first(parent) = 0, "list not empty after last remove")
    tc_check(counts, lmx_thread_child_is(parent, a) = 0, "a still claimed after last remove")

    # Re-add after remove works
    tc_check(counts, lmx_thread_child_add(parent, a, @ link_arena) = c.LMX_THREAD_OK, "re-add after remove failed")
    tc_check(counts, lmx_thread_child_is(parent, a) != 0, "re-added a was not a child")

    failures: counts[1]
    if: failures = 0
        c.printf("lmx_thread_children_selftest: %d checks, 0 failures\n", counts[0])
    else:
        c.printf("lmx_thread_children_selftest: %d checks, %d failures\n", counts[0], failures)
    ---
    free(a)
    free(b)
    free(c)
    free(parent)
    free(counts)
    if: failures != 0
        return: 1
    ---
return: 0

