---
    Observed:
        int: seen 6
        int: calls 0
    end: Observed
---
fn: producer () int
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ calls) (((shared \ Observed) \ calls) + 1)
    return: 7
end: producer
fn: h (@: it; int: y 6) int
    return: y
end: h
sub: main ()
    @: shared (node [] 0)
    :=: ((shared \ Observed) \ seen) (h (int item (producer)))
end: main
main:
