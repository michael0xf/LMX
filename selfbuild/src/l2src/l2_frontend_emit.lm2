fn: lm_compiler_rw_tlit (const: (@: source_node c.LmP0Node); int: parent; int: ty; int: neg; size_t: mag; int: usuf; @: out int) int
    @: rw_emit_cell int (cast: (@: int) (@ c.l2_rw_emit))
    @@: out_cell c.FILE (cast: (@@: c.FILE) (@ c.l2_out))
    int: v 0
