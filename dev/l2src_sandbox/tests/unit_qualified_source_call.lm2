# A complete qualified source body, not a dense data-only namespace.
# A bare E is a value; call: E executes the expression and exit operation.
# The call does not invoke
# the nested definition Data or replay Data's protected initializer.
independent:
    const:
        immutable:
            (): E
                Data:
                    int: value 5
                end: Data
                (2 + 2)
                sendMessage: exit(exit_code: Data\value + 2; stdout: ""; stderr: "")
            end: E
        end: immutable
    end: const
end: independent
call: E
return
