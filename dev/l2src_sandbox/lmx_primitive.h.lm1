include: "<stddef.h>"
predef: "l2src/lmx.h.lm1"
predef: "l2src/lmx_arena.h.lm1"
predef: "l2src/lmx_implements.h.lm1"

# lmx_primitive.h.lm1 - THE PRIMITIVE INSERT: the one admitted way an interpreted activation
# reaches a service that before it only a native entry could reach.
#
# PRIM gives an interpreted body access to a declared service callback.
# It is distinct from CALL/EXEC: ordinary callable dispatch reads the selected
# occurrence's native word, invoking its native adapter or walking its same body.
# A primitive record supplies a callback, physical args/return contract and owner.
#
# WHAT IDENTITY IS.  Everything here is PHYSICAL; nothing is a number and nothing is text:
#   * the RECORD is a cell of an arena -- an ordinary sealed physically profiled range for
#     a translation-known primitive -- and holds {fn, signature, owner};
#   * the SIGNATURE is the ordinary two-part physical contract: child0 holds
#     the ordered input type witnesses; child1 is empty for void or holds one
#     result witness. It is built once and shared; no name, callback-address
#     lookup or numeric signature registry supplies the types;
#   * the OWNER is the physical subject the primitive acts on -- for the mailbox primitives the
#     LmxThread whose own `mail_api` already holds these very entries natively
#     (lmx_thread.h.lm1:92-97, 173);
#   * a NODE names its record by ADDRESS, and the walk admits it by CLASSIFYING that address
#     (LMX_DOMAIN_KIND_PRIMITIVE) -- the domain question everything else in this kernel asks.
#     No numeric primitive kind is stored, no runtime text, nothing on the node.
#
# PROFILED PLACEMENT.  A translation-known record occupies an ordinary sealed range carrying
# the exact physical receiver-profile identity.  A Message imports that range as a non-owning
# view, and a profiled graph copy retains the record only when the caller names the same physical
# profile.  Sealing, foreign ownership, kind/type and `parent = 0` are not substitutes for that
# identity.  There is no process-global store and no implicit arena binding.
#
# The immutable-profile owner rule is enforced when a reached PRIM executes,
# just as physical stores check the actual selected holder. Untaken branches
# are not scanned by a second preparation pass.
#
# PARTIAL EFFECTS, stated because there is no rollback engine and none is pretended.  A
# primitive that mutates what it was handed HAS done so even when it then fails: the failure is
# reported, the act is not undone, and the body must read the status as "the act may have
# happened".  The motivating case is exact -- mail_take takes a letter off the inbox ring
# (lmx_thread.lm1:265-268 -> lmx_post_take) and is destructive and non-transactional, so a
# failure after the take leaves the letter taken.  That IS the coherent partial-effect
# behaviour of a destructive primitive: nonzero means neither "it happened" nor "it did not",
# and no value is promised back.

define: LMX_PRIMITIVE_OK 0
define: LMX_PRIMITIVE_FAIL 1
# -177 c5 / D-55: admission primitives report failure as the caller's implicit throw
# (not LMX_WALK_PRIMITIVE / X1). Walked root: merge = THROWN+1, implements = THROWN+2.
define: LMX_PRIMITIVE_THROW_MERGE 2
define: LMX_PRIMITIVE_THROW_IMPLEMENTS 3
define: LMX_PRIMITIVE_REG_OK 0
define: LMX_PRIMITIVE_REG_REFUSED 1

# The common callable ABI carries VALUE STORAGE in refs, in declared order.
# A nonzero refs[k] points to declared-width storage (including pointer storage
# whose payload is null); refs[k] == 0 means an absent input. The storage lives
# through the invocation. Numeric results use declared-width dest/out storage;
# a reference result travels as its held pointer in out, including null. The
# signature distinguishes present-null from void. Return is status, not value.
fnptr: LmxPrimitiveEntry (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out) int

# One primitive, in the arena that owns it.  Three physical fields and nothing else: a fn, the
# shared signature record, and the owner.
struct: LmxPrimitive
    LmxPrimitiveEntry: fn
    @: Lmx signature
    @: Lmx owner
end: LmxPrimitive

prototype:
# The registry of a runtime's primitives: a Structure whose child k is THE record of
    # primitive k, made in its ordinary owner arena -- the same shape as the roles table, and for the same
    # reason: a slot says where a record is, and a node names the record by address.  WHICH
    # primitives exist, and in which slot, is registration's act and not this unit's.
    fn: lmx_primitive_registry_open (@: LmxArena arena; size_t: count; @@: Lmx out_registry) int
    # Admit one primitive: take a cell of the arena's primitive domain, fill its three fields,
    # and put its ADDRESS into the registry's slot.  Filling a slot that already holds a record
    # is allowed and IS the whole of admission here; the record it replaced is left untouched.
    fn: lmx_primitive_register (@: LmxArena arena; @: Lmx registry; size_t: slot; LmxPrimitiveEntry: fn; @: Lmx signature; @: Lmx owner; @@: Lmx out_record) int
    # The record of slot k, or 0.  A lookup, never a check: what a record IS is answered by the
    # arena that holds it (LMX_DOMAIN_KIND_PRIMITIVE), never by this call.
    fn: lmx_primitive_record (@: Lmx registry; size_t: slot) @: Lmx
end: prototype
