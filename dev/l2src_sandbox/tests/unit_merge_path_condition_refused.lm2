Model:
    size_t: x 1U
end: Model

# D-61 (FABLE-OPUS-MERGE-PARTS-20260926-193 T1b): a bound merge result's path as an operand of an
# expression is not resolved yet.  `R\x` in a condition is refused, located, whatever the spelling of
# R -- it used to pass as a C constant and stop in gcc («'R' undeclared»).  Reading it into a local
# first works (unit_merge_last_occurrence).  Flips when D-61 lands.
fn: m () int
    R: merge: Model
    if: R\x != 1U
        return: 81
    return: 4
end: m

sendMessage: exit(exit_code: m(); stdout: ""; stderr: "")
return
