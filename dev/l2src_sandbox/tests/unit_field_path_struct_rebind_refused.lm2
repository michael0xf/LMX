Model:
    size_t: value 1U
end: Model

Outer:
    inner:
        size_t: value 1U
end: Outer

# PATH-STRUCTURE-LEAF: the path selects an ordinary named body, which has
# no explicit arguments. The nonempty application below is a located call
# refusal, never implicit Structure assignment or merge.
o: merge: Outer
a: merge: Model

o\inner: a
sendMessage: exit(exit_code: 0; stdout: ""; stderr: "")
return
