fn: lm_compiler_emit_send (int: k; int: proto; @: prefix char; @: count_arr int; @: off_arr int; @: kind_arr int; @@: text_arr c.LmP0Text; @: has_ref_arr int) int
    @@: out_cell c.FILE (cast: (@@: c.FILE) (@ c.l2_out))
    int: j
    int: nf
    int: has_ref
    nf: count_arr[k]
    has_ref: has_ref_arr[k]
    if: proto != 0
        return: (cast: (int) ((cast: (int) (c.fprintf(out_cell[0], "    fn: %s%d (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n", prefix, k) < 0))))
    if: c.fprintf(out_cell[0], "fn: %s%d (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n", prefix, k) < 0
        return: (cast: (int) (1))
    if: c.fputs("    @: LmxThread t lmx_thread_current()\n    @: LmxArena a (cast: (@: LmxArena) calloc(1U, c.sizeof(c.LmxArena)))\n    @: LmxMsg m 0\n    @: Lmx g 0\n    @: Lmx p 0\n    @: void cell 0\n    @: LmxArray text 0\n    @: LmxArray source_text 0\n    if: t = 0 || a = 0 || lmx_arena_open(a) != 0\n        l2_send_fail()\n", out_cell[0]) < 0
        return: (cast: (int) (1))
    if: c.fprintf(out_cell[0], "    if: nargs != %dU || (nargs != 0U && refs = 0)\n        l2_send_fail()\n    m: (cast: (@: LmxMsg) lmx_arena_take(a, c.sizeof(c.LmxMsg), c.LMX_DOMAIN_KIND_MSG_RECORD, c.LMX_DOMAIN_MSG_RECORD))\n    g: lmx_node_new_owned(a)\n    p: lmx_node_new_owned(a)\n    if: m = 0 || g = 0 || p = 0 || lmx_arena_refs_open_owned(a, g, 2U) != 0 || lmx_arena_refs_open_owned(a, p, %dU) != 0\n        l2_send_fail()\n", (nf + has_ref), nf) < 0
        return: (cast: (int) (1))
    j: 0
    while: j < nf
        if: kind_arr[off_arr[k] + j] = 1 && c.fprintf(out_cell[0], "    cell: lmx_int_new_owned(a)\n    if: cell = 0 || refs[%d] = 0 || lmx_int_store_known(cell, lmx_int_value_known(refs[%d])) != 0 || lmx_arena_ref_store(p, %dU, cell) != 0\n        l2_send_fail()\n", j, j, j) < 0
            return: (cast: (int) (1))
        if: kind_arr[off_arr[k] + j] = 2 && c.fprintf(out_cell[0], "    if: refs[%d] = 0\n        l2_send_fail()\n    source_text: (cast: (@: LmxArray) lmx_pointer_value_known(refs[%d]))\n    if: source_text = 0 || lmx_domain_kind(lmx_call_arena, (cast: (@: void) source_text)) != c.LMX_KIND_ARRAY || lmx_type_base(lmx_domain_type(lmx_call_arena, (cast: (@: void) source_text))) != c.LMX_TYPE_ARRAY_OF_CHAR || (source_text\\array.size != 0U && source_text\\array.data = 0)\n        l2_send_fail()\n    text: lmx_array_new_child_profiled(p, c.LMX_TYPE_ARRAY_OF_CHAR, (source_text\\array.size), a, 0)\n    if: text = 0 || lmx_arena_ref_store(p, %dU, (cast: (@: void) text)) != 0\n        l2_send_fail()\n    if: source_text\\array.size != 0U\n        memcpy((text\\array.data), (source_text\\array.data), (source_text\\array.size))\n    ---\n", j, j, j) < 0
            return: (cast: (int) (1))
        j: j + 1
    ---
    # The sender slot is a pointer CELL holding the current Message's address, not the address
    # itself (FABLE-SONNET-SEND-REF-20260925-172 commit 4, author's Q26.2 ruling: a reference is a
    # reference TO a reference -- storing the raw address directly would make the sender a CHILD of
    # the letter, and its domain would then disagree with a receiving field's own prototype cell at
    # admission, D-56's real cause). Same cell type D-52's kind-10/11 cells get from
    # l2_ptr_cell_type (LMX_TYPE_MSG_REF) so a receiver's `m\sender` field agrees.
    if: c.fprintf(out_cell[0], "    cell: lmx_pointer_new_owned(c.LMX_TYPE_MSG_REF, a)\n    if: cell = 0 || lmx_pointer_store_known(cell, (cast: (@: void) lmx_thread_message(t))) != 0 || lmx_arena_ref_store(g, 0U, cell) != 0 || lmx_arena_ref_store(g, 1U, (cast: (@: void) p)) != 0\n        l2_send_fail()\n    m\\running: 1\n    m\\success: 0\n    m\\handoff_ready: 0\n    m\\graph: g\n") < 0
        return: (cast: (int) (1))
    if: has_ref != 0
        if: c.fprintf(out_cell[0], "    if: lmx_service_post(lmx_child_service(t), lmx_pointer_value_known(refs[%d]), m, a) != c.LMX_SERVICE_OK\n        l2_send_fail()\n    return: 0\n", nf) < 0
            return: (cast: (int) (1))
        ---
    else:
        if: c.fputs("    if: lmx_service_post(lmx_child_service(t), (cast: (@: void) lmx_thread_parent(t)), m, a) != c.LMX_SERVICE_OK\n        l2_send_fail()\n    return: 0\n", out_cell[0]) < 0
            return: (cast: (int) (1))
        ---
