# OPUS-ROOT-CALL-20260930-17, source order at the unit level: `x:` with a Structure tail, x declared by nothing
# above it, is a named Structure (l2_unit_declares reads the unit only above the item it classifies, as
# l2_head_absent does); `int: x 5` below then collides with it, located there.  (Reading the whole unit, the later
# field made the block an assignment to it: "assignment value has unknown type" at the block.)
x:
    size_t: p 2U
end: x
int: x 5
sendMessage: exit(exit_code: 7; stdout: ""; stderr: "")
return
