# Plan M7, step 4 (the author, 2026-11-10; the book, colon-declares): a form with a colon whose head names nothing declares
# a Structure with its tail inside, not a reference: `h: Box` no longer binds h to Box -- a reference is declared
# `@: h Box`.  The lowering does not build a Structure with another one inside yet, so the form is refused and the
# message names the receiver's form.
Box:
    int: q 7
end: Box
h: Box
send: exit(exit_code: h\q; stdout: ""; stderr: "")
return
