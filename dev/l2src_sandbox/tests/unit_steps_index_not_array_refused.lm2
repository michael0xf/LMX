# R5-3b (R5-G3): an index step resolves against the current typed operand; on a value that is no Array -- an int -- it is
# refused at the step.  Before: "unsupported index" at the statement.
fn: work () int
    int: x 1
    x[0]: 2
    return: 7
end: work
sendMessage: exit(exit_code: work(); stdout: ""; stderr: "")
return
