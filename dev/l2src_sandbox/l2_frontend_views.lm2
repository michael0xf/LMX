fn: lm_compiler_m2_constructed (int: slot) int
    @: m2_slots_cell int (cast: (@: int) (@ c.l2_m2_slots))
    @: own_n_cell int (cast: (@: int) (@ c.l2_own_n))
    @: ns_n_cell int (cast: (@: int) (@ c.l2_ns_n))
    int: ni -1
    if: slot < 0 || slot >= m2_slots_cell[0]
