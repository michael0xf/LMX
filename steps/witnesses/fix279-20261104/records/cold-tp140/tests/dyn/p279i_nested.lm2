# Two written forms at a nested level: the heads of that level.
S:
    a:
        t: (int: x 1)
        t: (int: x 2)
    end: a
end: S
int: h 0
fn: read_free () int
    return: h\a\[1]t\x
end: read_free
fn: run_free () int
    @: h S S
    return: read_free()
end: run_free
int: code 7
if: S\a\[0]t\x != 1
    code: 81
---
if: code = 7 && S\a\[1]t\x != 2
    code: 82
---
if: code = 7 && run_free() != 2
    code: 83
---
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
