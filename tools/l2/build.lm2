fn: decl_root (@: f c.FILE) int
    if: c.fputs("include: \"<stddef.h>\"\npredef: \"l2src/lmx.h.lm1\"\npredef: \"l2src/lmx_call.h.lm1\"\npredef: \"l2src/lmx_service.h.lm1\"\npredef: \"l2src/lmx_orphan.h.lm1\"\npredef: \"l2src/lmx_message.h.lm1\"\npredef: \"l2src/lmx_thread.h.lm1\"\npredef: \"l2src/lmx_post.h.lm1\"\npredef: \"l2src/lmx_schedule.h.lm1\"\npredef: \"l2src/lmx_manager.h.lm1\"\npredef: \"l2src/lmx_arena.h.lm1\"\n\n# lmx_root.h.lm1 - the root Message R0, and the cycle of turns that is all that is left\n# of the \"host\" (L2_CORE_AND_MESSAGE_MODEL_20260912.md 25 (i)-(v), gaps item 6).\n#\n# (i)   A runtime without a root does not exist.  Creating the runtime creates R0: the\n#       ordinary Message whose parent is the structural upper frame.  The frame is the one object\n#       with no parent; R0 itself uses the same parent/child contract as every Thread.  Embedded use is no exception:\n#       an embedding program sits outside LMX and reaches the runtime only through R0's\n#       mail admission.\n# (ii)  The process entry point (spec 1.7) runs INSIDE R0's turns: the Message of the\n#       first thread of execution is R0, and the entry program is R0's handler -- ", f) < 0
        return: 1
    if: c.fputs("not a\n#       child spawned for it (9.1.4: the translator spawns no Messages implicitly).  That\n#       is why the entry is called from lmx_root_turn and from nowhere else.\n# (iii) Nothing of the \"host\" is left outside a turn.  Everything the L1 bootstrap gave\n#       the host -- ingress, drive, the UI band's step, the parent's step over top-level\n#       Messages, the logical clock, teardown -- belongs to R0's cycle here.  The clock is\n#       read ONCE per cycle and handed down (lmx_clock is the only place that asks the\n#       platform for the time), so everything that ages in one cycle ages against the same\n#       reading.\n# (iv)  The top level is single: a Message created without a parent is created THROUGH R0\n#       (lmx_root_create), so the parent capability is R0's and there is no second top\n#       level.\n# (v)   Handing supervision to the virtual grandparent World Wide Mix: the call site is fixed\n#       (lmx_root_supervise_world) and so is what fills that place today -- a LOCAL STUB PARENT,\n#       the same place lingvamyxa kept for it: the stub holds a stamp cell that t", f) < 0
        return: 1
    if: c.fputs("he root watches,\n#       and the root's own window becomes a hang detector for it (19.09, lmx_root.lm1).  19.28.10\n#       and the transport of 35 do not exist yet, and until they do the stub stands here: the old\n#       \"supervision is NOT handed over\" refusal (LMX_ROOT_NO_WORLD) is gone with them, because a\n#       status no act returns is a rule without a door.\n#\n# The record is the runtime's own handle, and each field is a mechanism a root has. R0 and its\n# structural parent are each ONE Thread cell in R0's arena; the closed Message is the first\n# by-value prefix of that same cell, not a second record. Their scheduler records are separate arena\n# cells under the schedule domain. The two mailbox values are handle-owned mechanism storage; no\n# address-range question is asked of those by-value fields.\n#\n# NOTHING is added to LmxMsg or Lmx.  Both are closed, and every cell here belongs to an\n# object of its own.\n#\n# Orphan retention (iv) is a policy over ordinary children of R0. Re-rooting removes the physical\n# Thread reference from its old parent's children Array and appends it to ", f) < 0
        return: 1
    if: c.fputs("R0's same dynamic Array.\n# Per-child retention clocks live on that Thread; the ledger holds no entries or membership list.\n# R0's manager traverses the Array directly and each Thread keeps its own arena in its schedule.\n\n# R0 has no fixed child capacity, reserved child positions, root index or magic graph slots.  Its\n# direct children are the same growable Array<@LmxThread> used by every other L3 Thread.\n\ndefine: LMX_ROOT_CLOSED 0\ndefine: LMX_ROOT_OPEN 1\n\n# The orphan-retention timeout's default (19.29.8: \"a runtime policy value with a default, settable\n# per runtime like the liveness deadlines\"), in the same unit as the root's own limit -- the\n# cycle's milliseconds.  It is R0's answer to \"how long may a FAILED orphan keep its handoff-safe\n# arena\": a successful one is reclaimed at the next maintenance point instead, and a zero policy is\n# refused, because a policy that can never be reached is not a policy.\ndefine: LMX_ROOT_ORPHAN_RETENTION 60000U\n# THE OVERALL CLOSE DEADLINE, and it is deliberately NOT any child's slot limit and not the liveness\n# limit: it bounds the WHOLE synchro", f) < 0
        return: 1
    if: c.fputs("nous cascade from the top (author, 2026-09-21).  The value is this\n# runtime's house policy value, the same 60000 as the retention default beside it -- deliberately\n# equal, not coincidentally.\ndefine: LMX_ROOT_CLOSE_LIMIT 60000U\n\ndefine: LMX_ROOT_OK 0\ndefine: LMX_ROOT_INVALID 1\n# R0's own work ended: its entry reported completion, a stop was requested, R0's own\n# deadline passed, or the world it watches went silent (19.09).  A cycle that answers this has\n# nothing left to drive; what follows is teardown, and that is the caller's act\n# (lmx_root_close).\ndefine: LMX_ROOT_DONE 2\n\nstruct: LmxRoot\n    # R0's own arena: the runtime's storage and the address-range table that classifies it.\n    LmxArena: arena\n    # The structural parent frame above R0. It is an ordinary Thread mechanism with its own graph\n    # and the same dynamic child Array; only this top frame has no parent.\n    @: LmxThread parent\n    @: LmxPost parent_mail\n    @: LmxSchedule parent_slot\n    @: void parent_children\n    # R0 is one L3 Thread allocation. Its ordinary Message identity is the by-value first-member\n    # p", f) < 0
        return: 1
    if: c.fputs("refix reached by lmx_thread_message(thread), never a second cached/rebindable pointer.\n    # It has a mailbox and a turn, which is what makes it one. A\n    # cell of the arena: it is the address the scheduler's domain question is asked about.\n    @: LmxThread thread\n    # R0's mailbox: the only door in from outside (25 (i)).  It is the same exact arena-owned POST\n    # mechanism record used by every other Thread; R0 has no by-value/unclassified exception.\n    @: LmxPost mail\n    # R0's own scheduler record: how long the runtime itself may run.  A cell of the arena\n    # under the SCHEDULE domain, like a child's record.\n    @: LmxSchedule slot\n    # R0's ordinary per-Thread scheduler, allocated in the same arena and cached by Thread.\n    @: LmxManager manager\n    # R0's mail service (lmx_service): \"Тот же самый R0\" -- the runtime's root IS the service.\n    # Entries are ordered by the physical address of a live record.\n    LmxService: service\n    # Orphan policy view: owner is R0's Thread and count is derived by traversing its one children\n    # Array. The handle stores no child colle", f) < 0
        return: 1
    if: c.fputs("ction of its own.\n    LmxOrphanLedger: orphans\n    # The orphan-retention policy value (19.29.8): how long a FAILED orphan may keep its\n    # handoff-safe arena before the maintenance reclaims it.  Zero is refused by the setter; this\n    # field starts at the default.\n    ulong: retention\n    # The upper frame's OWN overall close bound -- not a child's slot limit and not the liveness\n    # limit (author, 2026-09-21): it bounds the whole synchronous cascade from the top.\n    ulong: close_limit\n    # The entry program (1.7), run inside R0's turns and nowhere else.  Its shape is the typed\n    # entry's (lmx_call.h.lm1): the reserved node first, the status out. This is the synthetic\n    # root adapter, so it receives graph.parent -- 0, since R0's graph is independent (parent = 0;\n    # the stub above R0 is supervision, not a lexical space); ordinary methods receive their selected callable\n    # occurrence M.parent through lmx_call0. Zero means R0 has no handler: its turns are pure boundary\n    # work, which is a legitimate state.  R0's handler is NOT a callable occurrence (it has no\n    ", f) < 0
        return: 1
    if: c.fputs("# METHOD record), so the cycle calls it directly rather than through lmx_call.\n    LmxCallEntry: entry\n    # THE WORLD'S STAMP CELL, AND THE ROOT POLLS IT (19.09, Mikhail: \"заглушка не зависла\n    # которую опрашивает root\").  The world -- the stub above the root, the place lingvamyxa\n    # kept for WorldWideMix -- owns that cell (`lmx_root_supervise_world` hands it over) and\n    # writes its reading there while it lives.  R0 watches it at every boundary and STOPS ITSELF\n    # when the world has been silent longer than R0's own limit: a child whose parent went silent\n    # ends, it does not outlive it.  Untyped, like every other reference in this kernel: the cell\n    # is the caller's own storage, and the kernel only stores its address.\n    @: void world\n    # The reading of the CURRENT cycle: the logical clock (25 (iii)).  Everything that\n    # ages in one cycle ages against this one number.\n    ulong: now\n    # How long R0 itself may run, in the cycle's milliseconds.  Zero is refused: every wait\n    # has a limit (model 33), the runtime's own included.\n    ulong: limit\n    # OPEN o", f) < 0
        return: 1
    if: c.fputs("r CLOSED.\n    int: state\nend: LmxRoot\n\n# THE HOST ROOT (author 2026-09-24, LMX_blog/2026-09-24.md): R0's parent is a full Thread made by\n# the same mechanisms as every other -- the one lmx_root_open makes, with its arena, mailbox,\n# schedule, manager and service; its own parent is the parentless structural frame, which stands\n# for the OS.  The launch runs in it, and R0 stays pure user code: C main hands the host argc, argv\n# and R0's program; in its first turn the host reserves R0 as its ordinary child (own arena,\n# published into the host's children at the host's end-turn, retained in a result cell of the\n# host's graph), and the host's `independent: const: immutable` settings reach R0 by the eternal\n# rule -- the same physical branch, imported into R0's arena as a view, never copied -- so R0 stays\n# platform-independent.  The host posts the mainArgs letter to R0, R0 takes one turn from the\n# host's cycle, and the host takes its own inbox: a letter from R0 whose payload is\n# `exit(exit_code: <code>; stdout: \"\"; stderr: \"\")` is the exit.  When R0 sent none the host maps\n# R0's `succ", f) < 0
        return: 1
    if: c.fputs("ess` (1 -> 0, 0 -> 1) and fills stdout/stderr with the exit reasons; with success = 0\n# it also prints to stderr the arenas adopted under the success = 0 rule.\n#\n# What the host keeps of an exit: its code, its two texts (exact-length char descriptors) and the\n# letter's sender (0 when the host decided the exit itself).\n#\n# D-66: out/err, when lmx_root_exit_admit fills them, are host-seam COPIES (calloc'd here, not\n# arena cells) -- the letter's own arena is only held by lmx_root_host_take's own locals, and\n# becomes GC-unreachable the instant that call returns, so a bare pointer into it left in this\n# struct (which is not itself a graph node the collector's root walk ever reaches) is dangling\n# the moment admission finishes.  owns_text says whether out.data/err.data are this struct's own\n# calloc'd copies (lmx_root_exit_write frees them once written) or borrowed/static text\n# (lmx_root_exit_set's own \"why\" strings, or the empty default): never both in the same LmxRootExit.\nstruct: LmxRootExit\n    int: exit_code\n    LmxCharArray: out\n    LmxCharArray: err\n    @: void sender\n    int: o", f) < 0
        return: 1
    if: c.fputs("wns_text\nend: LmxRootExit\n\n# THE HOST'S TWO BUILDERS.  The settings builder makes the host's eternal settings in the host's\n# arena: an independent: const: immutable branch whose every array is profiled by `profile` and\n# sealed, returned as the branch's root (0: no settings).  The program builder installs R0's program\n# into R0's own graph, in R0's own arena, right after the host reserved R0. The\n# graph contains exactly its source fields; membership stays in Thread.children\n# and settings in the host stub. The builder receives settings explicitly. 0 is success.\nfnptr: LmxRootSettings (@: LmxArena arena; @: Lmx profile) @: Lmx\nfnptr: LmxRootProgram (@: LmxArena arena; @: Lmx graph; @: Lmx settings) int\n# -182: host seam after R0 mail exists + mainArgs posted, before the manager round. 0 = skip.\nfnptr: LmxRootBeforeTurn (@: LmxRoot root; @: LmxMsg r0) int\n\n# THE LAUNCH'S OWN RECORD, on lmx_root_launch's frame for the whole launch and referenced from the\n# host's graph, where the host's entry finds it.  R0's arena lives here: it is R0's storage until\n# the host's close settles R0 (rel", f) < 0
        return: 1
    if: c.fputs("eased on success, attached to the host's on failure).\nstruct: LmxRootLaunch\n    LmxRootProgram: program\n    # Nullable; 0 skips. Called after mainArgs is posted, before R0's manager round.\n    LmxRootBeforeTurn: before_turn\n    LmxRootSettings: settings\n    size_t: fields\n    ulong: limit\n    LmxArena: arena\n    @: LmxThread thread\n    @: LmxSchedule slot\n    @: Lmx branch\n    # 0 before the host's first turn, 1 after it made R0, 2 after it took its inbox.\n    int: phase\n    # 1 once R0 was reserved, its program installed and its Thread joined.\n    int: made\n    # 1 once a letter from R0 with an exit payload was admitted into `done`.\n    int: exited\n    LmxRootExit: done\nend: LmxRootLaunch\n\ndefine: LMX_ROOT_HOST_R0 0\ndefine: LMX_ROOT_HOST_SETTINGS 1\ndefine: LMX_ROOT_HOST_LAUNCH 2\ndefine: LMX_ROOT_HOST_FIELDS 3\n\nprototype:\n    # Create the runtime: R0, its arena, its mailbox and its schedule, with `entry` as its\n    # handler and `limit` as its own deadline. Qualified sealed Arrays are ordinary typed ranges\n    # allocated in this owner arena and reached through ordinary physical grap", f) < 0
        return: 1
    if: c.fputs("h fields; Root has\n    # no size parameters, reserved descriptors or magic storage for them. A handle that already holds a root must be cleared by the caller -- or\n    # simply be the storage this call clears itself, which is what it does with every field of\n    # LmxRoot and of its arena before anything is opened on them.\n    fn: lmx_root_open (@: LmxRoot root; LmxCallEntry: entry; ulong: limit) int\n    # One turn of R0: enter its boundary, run the entry program, leave.  The entry runs\n    # INSIDE the turn, so lm.current is R0's thread while it runs and 0 outside.\n    fn: lmx_root_turn (@: LmxRoot root; ulong: now) int\n    # The cycle, with the reading this cycle ages against supplied by the caller -- the seamy\n    # side of the logical clock, and the one a test can drive deterministically.\n    fn: lmx_root_cycle_at (@: LmxRoot root; unsigned: ticks; ulong: now) int\n    # The cycle: read the clock ONCE, then R0's turn, R0's keep-alive, and a bounded pass\n    # over the top level.  This is what \"the host\" became -- there is no other driver.\n    fn: lmx_root_cycle (@: LmxRoot root; u", f) < 0
        return: 1
    if: c.fputs("nsigned: ticks) int\n    # (iv): a top-level Message is created through R0 and joins R0's sole dynamic children Array\n    # when its Thread is published. Null when the root is not open or creation is refused; refusal\n    # publishes nothing (lmx_child_create).\n    #\n    # `source` MUST LIVE IN R0'S OWN ARENA.  There is no parameter for the source's arena\n    # because there is no choice to make: this passes @ root\\arena as the copy's src_arena,\n    # and by lmx_graph_copy_owned.h.lm1 the source arena is the only thing that answers what\n    # an address is.  A graph built anywhere else is foreign to the arena asked about it, so\n    # the copy refuses a root it cannot type and this returns null -- it is not copied and\n    # not diagnosed further.  The one exception is the exception everywhere: a store-resident\n    # source is classifiable from a bound arena and is kept by address, not copied.\n    fn: lmx_root_create (@: LmxRoot root; @: LmxArena child_arena; @: Lmx source) @: LmxMsg\n    # Canonical profiled form. `retain_profile` is the exact physical receiver expression for\n    # indep", f) < 0
        return: 1
    if: c.fputs("endent:const:immutable; zero explicitly requests an ordinary full copy.\n    fn: lmx_root_create_profiled (@: LmxRoot root; @: LmxArena child_arena; @: Lmx source; @: Lmx retain_profile) @: LmxMsg\n    # (v): hand the world's place its stamp cell -- the LOCAL STUB PARENT, still standing in for\n    # World Wide Mix (lmx_root.lm1).  `world` is the caller's `size_t` cell: the stub writes its\n    # reading there while it lives, R0 watches it at every boundary and ends when that world has\n    # been silent longer than R0's own limit.  Refused with LMX_ROOT_INVALID when the root is not\n    # open, when the address is not one, and when the cell has never been written (a zero would\n    # age as \"silent since the beginning of time\" and end the root at once).\n    fn: lmx_root_supervise_world (@: LmxRoot root; @: void world) int\n    # (iv), 19.29.8: move an executable orphan's physical Thread reference from its old parent's\n    # dynamic children Array to R0's Array. Its ordinary parent up-link follows that move; there is\n    # no Message index, graph slot, scheduler queue or parallel orphan-memb", f) < 0
        return: 1
    if: c.fputs("ership chain. R0's\n    # retention policy supplies the per-child clock. A plain Message is refused because the sole\n    # membership Array is Array<@LmxThread>.\n    # THE STUB PARENT'S TWO HALVES (Mikhail, 19.09 -- the WorldWideMix stub's place, see\n    # lmx_root.lm1). R0 has the ordinary structural parent stub; its own wait is its liveness record:\n    # stub RINGS with `lmx_root_keepalive` (the start of the wait is the last time the root was\n    # seen) and POLLS with `lmx_root_hung` (has it been silent longer than its own window?).\n    # A stub that rings every cycle turns the root's limit from a death timer into a hang\n    # detector; the stub itself lives as long as the process, and that is its \"forever\".\n    fn: lmx_root_keepalive (@: LmxRoot root; ulong: now) int\n    fn: lmx_root_hung (@: LmxRoot root; ulong: now) int\n    fn: lmx_root_orphan_adopt (@: LmxRoot root; @: LmxMsg orphan; @: LmxArena orphan_arena; @: LmxThread thread; ulong: now) int\n    # The retention policy value, settable per runtime (19.29.8).  Zero is refused.\n    fn: lmx_root_retention_set (@: LmxRoot root; u", f) < 0
        return: 1
    if: c.fputs("long: limit) int\n    fn: lmx_root_close_limit_set (@: LmxRoot root; ulong: limit) int\n    # THE MAINTENANCE POINT: one pass over R0's same children Array. A successful handoff-safe\n    # orphan is removed then reclaimed at once; a failed one is removed then reclaimed after its\n    # retention window. Running records are only asked to stop and remain valid Array elements\n    # until they publish a safe boundary.\n    fn: lmx_root_orphan_maintain (@: LmxRoot root; ulong: now) int\n    fn: lmx_root_orphans (@: LmxRoot root) @: LmxOrphanLedger\n    # Teardown: stop R0, close its mailbox, release its arena -- everything the runtime owns,\n    # attached children included. Synchronous linear close from OPEN; local deadline only.\n    fn: lmx_root_close (@: LmxRoot root) int\n    # The same close, and the host's report of a failure: when `report` (a FILE *) is not null and\n    # R0's `success` is 0, R0's arena is printed to it after the close's settle -- which attaches\n    # the arenas of the failed children -- and before the release.  lmx_root_close is this with no\n    # report.\n    fn: lmx_root", f) < 0
        return: 1
    if: c.fputs("_close_report (@: LmxRoot root; @: void report) int\n    # The report: every array of `arena`, every cell of its Structures, Messages, Arrays and\n    # primitives, a reference as a<array>[<cell>].  The arrays in front of `joined_end` in the\n    # arena's list joined it after that point (lmx_arena_attach splices a donor's arrays in front)\n    # and are marked `joined`.\n    fn: lmx_root_report (@: LmxArena arena; @: LmxPool joined_end; @: void stream) int\n    # lmx_root_open with exactly `fields` empty source graph fields, including zero.\n    fn: lmx_root_open_graph (@: LmxRoot root; LmxCallEntry: entry; ulong: limit; size_t: fields) int\n    # THE HOST'S LAUNCH -- everything a C main did.  `root` is the caller's storage for the host's\n    # handle (cleared here).  R0 gets `fields` graph fields, filled by `program`; `settings` (or 0)\n    # makes the host's eternal settings; `limit` is both Threads' own deadline.  The process's\n    # arguments go to R0 inside a letter (sender; payload), like every letter (K3 = a): field 0 is\n    # the host's Message, field 1 a Structure whose one field, m", f) < 0
        return: 1
    if: c.fputs("ainArgs, is an Array of char Arrays\n    # (argv[i] at exact strlen, no NUL).  After R0's one turn the exit is decided, its texts go to `out`\n    # and `err` (FILE *), the host is closed -- with the report to `err` when R0 sent no exit and\n    # its success is 0 -- and the exit code is returned.\n    fn: lmx_root_launch (@: LmxRoot root; int: argc; @@: char argv; LmxRootProgram: program; size_t: fields; LmxRootSettings: settings; ulong: limit; @: void out; @: void err) int\n    # Same as launch with an explicit before_turn tap (0 = skip). Existing callers keep lmx_root_launch.\n    fn: lmx_root_launch_tapped (@: LmxRoot root; int: argc; @@: char argv; LmxRootProgram: program; size_t: fields; LmxRootSettings: settings; ulong: limit; LmxRootBeforeTurn: before_turn; @: void out; @: void err) int\n    # Same launch, with an optional explicit copy of R0's completed body status before teardown.\n    # No global/current-call state is exposed; the output is initialized to0 even if construction refuses.\n    fn: lmx_root_launch_result (@: LmxRoot root; int: argc; @@: char argv; LmxRootProgram: progr", f) < 0
        return: 1
    if: c.fputs("am; size_t: fields; LmxRootSettings: settings; ulong: limit; LmxRootBeforeTurn: before_turn; @: void out; @: void err; @: int body_status) int\n    # The host's entry: the launch's code in the host's turns (first: make R0; then: take the inbox).\n    fn: lmx_root_host_entry (@: Lmx node) int\n    # The host's settings (the LmxRootSettings a program's main passes): the process's working\n    # directory, read from the OS, as the one char Array of an eternal branch profiled by `profile`.\n    fn: lmx_root_settings (@: LmxArena arena; @: Lmx profile) @: Lmx\n    # The working directory into `buffer` (the OS's own call), or null.\n    fn: lmx_root_os_cwd (@: char buffer; size_t: size) @: char\n    # Make one directory. Existing is success. The host's own call, like the working directory.\n    fn: lmx_root_os_mkdir (const: @: char path) int\n    # THE EXIT MESSAGE (author K3 = a: the letter is an anonymous Structure -- field 0 its sender's\n    # reference, field 1 its payload Structure).  The host model is a Structure of `arena` with three\n    # fields by position: an int, a char Array, a char Arra", f) < 0
        return: 1
    if: c.fputs("y.  A letter's payload is admitted against\n    # it by position through the runtime `implements` (lmx_runtime_implements, the model as its own\n    # consumer): no field name and no special shape.  An admitted letter fills `exit` -- the texts\n    # point into the payload's own char Arrays -- and its sender.\n    fn: lmx_root_exit_model (@: LmxArena arena) @: Lmx\n    fn: lmx_root_exit_admit (@: LmxArena arena; @: Lmx model; @: Lmx letter; @: LmxRootExit exit) int\n    # The reads a caller outside needs; a by-value LmxRoot has no other way in (L1 follows a\n    # field of a by-value record through a pointer, not through the value).\n    fn: lmx_root_message (@: LmxRoot root) @: LmxMsg\n    fn: lmx_root_thread (@: LmxRoot root) @: LmxThread\n    # R0's own arena: the address-range table for its runtime addresses and\n    # cells of its source graph. Launch/settings belong to the parent stub;\n    # mainArgs arrives as an ordinary letter in its own arena, not a graph field.\n    fn: lmx_root_arena (@: LmxRoot root) @: LmxArena\n    # R0's stepped scheduler traverses the same children Array; it owns", f) < 0
        return: 1
    if: c.fputs(" no membership queue.\n    fn: lmx_root_service (@: LmxRoot root) @: LmxService\n    fn: lmx_root_manager (@: LmxRoot root) @: LmxManager\n    fn: lmx_root_clock (@: LmxRoot root) ulong\n    fn: lmx_root_state (@: LmxRoot root) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_root

# Remaining Lmx declaration headers, emitted as ordinary L1 text by L3 code.
# Existing ABI/types/comments are preserved byte-for-byte; no L2 layout syntax or body is hidden here.
fn: decl_message (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx.h.lm1\"\ninclude: \"<stdint.h>\"\n\n# lmx_message.h.lm1 - the Message record: the kernel's own four fields, and nothing\n# else.  Written in L1, like the arena's headers; the generated C is\n# lmx_message.lm1.h.\n#\n# THIS RECORD IS CLOSED.  NOTHING IS ADDED TO IT.  Not a queue link, not a\n# deadline, not a mailbox, not a parent or child link, not a scheduler slot, not a\n# flag of convenience.  Every one of those has an owner of its own now: the mail is\n# lmx_post, one Thread's timing state is lmx_schedule, the executable object is\n# lmx_thread, the arena is lmx_arena_*, and direct-child membership is the sole\n# dynamic Array<@LmxThread> in the parent's graph.  A new field here is a DEFECT, not a\n# convenience -- this is exactly how the record reached 61 fields once, and every\n# one of them had a good reason at the time.\n#\n# Lingvamyxa_spec.txt 19.29.7.1: \"Every Message has running=1 and success=0\n# initially, including a Message without an executing thread. These uint_fast8_t\n# control flags belong to the Message, not to its payload arena. running means\n# permission to continue, not that an OS thread currently exists.\" 19.29.6 is the\n# Message/L3 Thread itself; L2_CORE_AND_MESSAGE_MODEL_20260912.md 29 (ownership of\n# cells), 31 (running, success and stop), 32 (closing the family).\n#\n# This replaces the 61-field record the previous implementation carried.  The\n# The record contains only execution permission, outcome, handoff boundary and its graph.\n# Parent/child membership and routing are physical Thread references in the parent's graph Array;\n# a numeric Message index would duplicate and contradict that model.\n#\n# Everything that used to sit beside them belongs elsewhere:\n#   - the arena: its block list is lmx_arena_blocks and its typed arrays are the\n#     constructor modules, each array ONE ENTRY PER INTERVAL of the address table\n#     (lmx_range; an array that grew by a chunk has several intervals and therefore\n#     several entries, all naming the same descriptor), and each entry names the\n#     array's own descriptor, which says what it holds;\n#   - the mailbox, the outgoing queue, the scheduler and the liveness deadlines are\n#     the L3 Thread's own mechanism, not cells of the record;\n#   - the family chain (parent, first and last child, siblings) is the parent's\n#     supervision data in the language graph;\n#   - the executor's bind record is the executor's.\n# A field that is not one of the four must have an LMX owner in the graph, or go.\n\n# The control flags' type is the one the specification names for them,\n# uint_fast8_t.  On this target that is one byte, which is why the record is 24\n# bytes: 1+1+1, padding to the pointer, 8, 4, padded again.\ntype: LmxFlag uint_fast8_t\n\nstruct: LmxMsg\n    # Permission to continue, and the stop request.  1 while the work is assigned;\n    # cleared at the turn boundary that ends the incarnation.  A 0 read inside a\n    # turn is a stop request, never the Message's own completion (model 31).  One\n    # designated cross-lane writer: the parent stopping a child, or the lane that\n    # takes the turn.\n    LmxFlag: running\n    # Set by the user's code: `success = 1` is a sufficient condition for stopping the\n    # Thread at its end turn.  The system never resets it to 0, not even when a body\n    # fails.  The system sets it to 1 in one place only: for a plain letter, at the\n    # receiver owner's take after the attach (lmx_post_take_inbox).  A heartbeat, an\n", f) < 0
        return: 1
    if: c.fputs("    # empty inbox, the absence of a physical thread or the end of a single turn does not\n    # set it (model 31).  A new record starts at 0 (its constructor's initial state).\n    LmxFlag: success\n    # The handoff-safe mark: this Message's storage may be transferred without a\n    # copy.  Read together with the absence of native users (model 32).\n    #\n    # A flag, not an int, and read with the same discipline as `running`: the\n    # decision \"not running and handoff-safe\" reads the two in ONE predicate, and\n    # it is read from the settling side, so a plain field read would let the\n    # compiler keep the load in a register across the loop that waits for it.  The\n    # house spelling for that is a load helper over this type -- the way lmx.h's\n    # poll hook already reads `running` with __atomic_load_n(p, __ATOMIC_RELAXED) --\n    # never a bare `volatile` qualifier: spec 19.29.7.1 sanctions a relaxed atomic\n    # load ONLY where it compiles to the same instructions as an ordinary volatile\n    # load/store, and forbids paying a fence, a read-modify-write or a helper call\n    # beyond that.\n    LmxFlag: handoff_ready\n    # The Message's own graph root: the C projection of the language root.\n    @: Lmx graph\nend: LmxMsg\n", f) < 0
        return: 1
    return: 0
end: decl_message

fn: decl_value (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx.h.lm1\"\n\n# One computed activation value,shared by native calls and interpretation.\n# The historic C type name is retained;no name is stored in a program graph.\n# Storage is the declared-width member below,not the enclosing record.\ndefine: LMX_WALK_VALUE_NUMBER 1\ndefine: LMX_WALK_VALUE_REFERENCE 2\n# A foreign by-value ABI object has already been copied into its exact C\n# transport type. This record borrows that object's storage for the call;\n# it is neither a graph reference nor a numeric VM place. No Model is forged.\ndefine: LMX_WALK_VALUE_FOREIGN 3\n# LmxWalkValue's shared physical record is declared with arena pool types.\n\nprototype:\n    fn: lmx_value_context_copy (@: LmxWalkValue out; @: LmxWalkValue source) void\n    fn: lmx_walk_value_ref_context (@: LmxWalkValue out; int: ty; @: void ref; @: LmxWalkValue context) int\n", f) < 0
        return: 1
    return: 0
end: decl_value

fn: decl_primitive (@: f c.FILE) int
    if: c.fputs("include: \"<stddef.h>\"\npredef: \"l2src/lmx.h.lm1\"\npredef: \"l2src/lmx_value.h.lm1\"\npredef: \"l2src/lmx_arena.h.lm1\"\npredef: \"l2src/lmx_implements.h.lm1\"\n\n# lmx_primitive.h.lm1 - THE PRIMITIVE INSERT: the one admitted way an interpreted activation\n# reaches a service that before it only a native entry could reach.\n#\n# PRIM gives an interpreted body access to a declared service callback.\n# It is distinct from CALL/EXEC: ordinary callable dispatch reads the selected\n# occurrence's native word, invoking its native adapter or walking its same body.\n# A primitive record supplies a callback, physical args/return contract and owner.\n#\n# WHAT IDENTITY IS.  Everything here is PHYSICAL; nothing is a number and nothing is text:\n#   * the RECORD is a cell of an arena -- an ordinary sealed physically profiled range for\n#     a translation-known primitive -- and holds {fn, signature, owner};\n#   * the SIGNATURE is the ordinary two-part physical contract: child0 holds\n#     the ordered input type witnesses; child1 is empty for void or holds one\n#     result witness. It is built once and shared; no name, callback-address\n#     lookup or numeric signature registry supplies the types;\n#   * the OWNER is the physical subject the primitive acts on -- for the mailbox primitives the\n#     LmxThread whose own `mail_api` already holds these very entries natively\n#     (lmx_thread.h.lm1:92-97, 173);\n#   * a NODE names its record by ADDRESS, and the walk admits it by CLASSIFYING that address\n#     (LMX_DOMAIN_KIND_PRIMITIVE) -- the domain question everything else in this kernel asks.\n#     No numeric primitive kind is stored, no runtime text, nothing on the node.\n#\n# PROFILED PLACEMENT. A translation-known record may occupy a sealed range carrying\n# the exact physical receiver-profile identity. A copy retains that record only when\n# the caller explicitly supplies that qualified profile and the destination imports\n# it. Otherwise the record, signature and graph owner follow the ordinary graph-copy\n# map; only its function word is reusable native code. Sealing, foreign ownership,\n# kind/type and `parent = 0` are not substitutes for explicit retention. There is\n# no process-global store and no implicit arena binding.\n#\n# The immutable-profile owner rule is enforced when a reached PRIM executes,\n# just as physical stores check the actual selected holder. Untaken branches\n# are not scanned by a second preparation pass.\n#\n# PARTIAL EFFECTS, stated because there is no rollback engine and none is pretended.  A\n# primitive that mutates what it was handed HAS done so even when it then fails: the failure is\n# reported, the act is not undone, and the body must read the status as \"the act may have\n# happened\".  The motivating case is exact -- mail_take takes a letter off the inbox ring\n# (lmx_thread.lm1:265-268 -> lmx_post_take) and is destructive and non-transactional, so a\n# failure after the take leaves the letter taken.  That IS the coherent partial-effect\n# behaviour of a destructive primitive: nonzero means neither \"it happened\" nor \"it did not\",\n# and no value is promised back.\n\ndefine: LMX_PRIMITIVE_OK 0\ndefine: LMX_PRIMITIVE_FAIL 1\n# -177 c5 / D-55: admission primitives report failure as the caller's implicit throw\n# (not LMX_WALK_PRIMITIVE / X1). Walked root: merge = THROWN+1, implements = THROWN+2.\ndefine: LMX_PRIMITIVE_THROW_MERGE 2\ndefine: LMX_PRIMITIVE_THROW_IMPLEMENTS 3\n", f) < 0
        return: 1
    if: c.fputs("# Item 6 of the interpreter-throw closure (steps/interpreter-throw-20261010.md): a primitive that stands for a CALL of\n# a callable value (the callable-merge adapter of a held call) conveys its callee's throw as THROWN + the callee's KEY --\n# the key of the name, as the native boundary translates the callee's ordinal through its THROWS header\n# (lmx_walk_key_from_ordinal) -- with the thrown record in `out`; the walk lands it on the pad of that key\n# (lmx_walk_prim), as a callee's throw lands from a CALL.  A nonzero code outside the protocol stays PRIMITIVE: a\n# malformed runtime protocol, never an ordinary throw.\ndefine: LMX_PRIMITIVE_THROWN 64\ndefine: LMX_PRIMITIVE_REG_OK 0\ndefine: LMX_PRIMITIVE_REG_REFUSED 1\n\n# The common callable ABI carries VALUE STORAGE in refs, in declared order.\n# A nonzero refs[k] points to declared-width storage (including pointer storage\n# whose payload is null); refs[k] == 0 means an absent input. The storage lives\n# through the invocation. Numeric results use declared-width dest/out storage;\n# a reference result travels as its held pointer in out, including null. The\n# signature distinguishes present-null from void. Return is status, not value.\n# Optional input values accompany the SAME storage span;do not recover them\n# by casting raw storage. lmx_result_context is a fresh activation-local output:\n# an entry may set only model/references there. The receiving marshaller owns\n# presence,type and payload,and retains these components for reference results.\n# Null span/output is an explicitly unannotated call,not a namespace lookup.\nfnptr: LmxPrimitiveEntry (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n\n# One primitive, in the arena that owns it.  Three physical fields and nothing else: a fn, the\n# shared signature record, and the owner.\nstruct: LmxPrimitive\n    LmxPrimitiveEntry: fn\n    @: Lmx signature\n    @: Lmx owner\nend: LmxPrimitive\n\nprototype:\n# The registry of a runtime's primitives: a Structure whose child k is THE record of\n    # primitive k, made in its ordinary owner arena -- the same shape as the roles table, and for the same\n    # reason: a slot says where a record is, and a node names the record by address.  WHICH\n    # primitives exist, and in which slot, is registration's act and not this unit's.\n    fn: lmx_primitive_registry_open (@: LmxArena arena; size_t: count; @@: Lmx out_registry) int\n    # Admit one primitive: take a cell of the arena's primitive domain, fill its three fields,\n    # and put its ADDRESS into the registry's slot.  Filling a slot that already holds a record\n    # is allowed and IS the whole of admission here; the record it replaced is left untouched.\n    fn: lmx_primitive_register (@: LmxArena arena; @: Lmx registry; size_t: slot; LmxPrimitiveEntry: fn; @: Lmx signature; @: Lmx owner; @@: Lmx out_record) int\n    # The record of slot k, or 0.  A lookup, never a check: what a record IS is answered by the\n    # arena that holds it (LMX_DOMAIN_KIND_PRIMITIVE), never by this call.\n    fn: lmx_primitive_record (@: Lmx registry; size_t: slot) @: Lmx\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_primitive

fn: decl_walk (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx.h.lm1\"\npredef: \"l2src/lmx_value.h.lm1\"\npredef: \"l2src/lmx_arena.h.lm1\"\npredef: \"l2src/lmx_scratch.h.lm1\"\n\n# One activation over the selected complete callable Structure. Its declared\n# fields and executable role nodes remain in the graph; activation working values,\n# argument places and temporaries live only in the C frame/scratch lifetime.\n# The native word and source graph are not rewritten by interpretation.\n#\n# The completed fn occurrence is an ordinary four-part Structure. Its written\n# receiver head is looked up by occurrence address in the arena's external\n# source-name namespace; the owning field keeps the method's own name there.\n# No name is stored inside Lmx and no method opcode/marker is added. The older\n# lowered body operations still use typed OP records until K03 replaces that\n# carrier with the same general receiver-head mechanism; those OP records are\n# implementation debt, not the language rule. Field resolution uses physical\n# places and implements maps, not textual name lookup at each access.\n# Entry accepts an existing Structure, including an empty executable body. Reached\n# roles execute in body order; unknown reached roles report UNSUPPORTED.\n# Explicit CALL/EXEC selects an occurrence and dispatches its native word or walks\n# that occurrence. Merely returning or passing a descriptor never executes it.\n#\n# Declared own cells are loaded into per-activation working rows. Bare assignment\n# changes the working value and dirty bit; ordinary call/exit checkpoints publish\n# only dirty rows. Explicit physical place operations do not reload or dirty them.\n#\n# VALUES. Each recursive evaluation produces one LmxWalkValue: presence, closed\n# source type, and either an exact-width numeric member or an opaque held reference.\n# A null reference is present; void/absent has present=0. Physical pointer cells\n# are loaded once at producers. A reference that happens to point to another pointer\n# cell is not implicitly followed. Descriptor values retain their actual identity.\n# ADDRESS resolves a physical LmxWalkPlace without a value load, publication or dirty\n# change; ELEM places select backing storage before char/pointer value projection.\n# CALL/PRIM transport uses addresses of declared-width value storage. Zero storage\n# denotes absence, while nonzero pointer storage can hold null. ARG's type witness\n# loads into stable callee-owned storage, independent of caller/scratch transport.\n# Numeric results are copied by their declared width before scratch is rewound;\n# references retain their payload and source category without allocating a graph.\n# THE WORKING STATE (§7b, steps/working-state-7b.md; book §12 `#dynamic`, §14; Lingvamyxa spec 21.5,\n# 21.6 -- the model above, restored by the author's decision, docs/new_parts/dirty.md; the k.2 reading\n# \"cells ARE the graph, no working copies\" is withdrawn).  At entry the activation loads the own fields its\n# body uses by a bare name into the frame's working table (LmxWalkFrame.work: rows taken from the scratch\n# store after the activation's mark, linked in the order they were made): one row per field -- where its\n# slot is, what it holds.  The set is not stored anywhere (the author, 2026-09-28: no auxiliary structures\n# in the graph beside the graph itself and what the source makes): it is the code's own -- every OWN,\n# OWN_OF and SET_OF node the body holds, found by walking down from its steps through the Structures each\n", f) < 0
        return: 1
    if: c.fputs("# node owns (lmx_walk_load_body).  OWN and OWN_OF read the row, SET and SET_OF write it and mark it dirty;\n# a slot with no row is the translator's broken promise, said as \"lmx: invariant: an own field used but\n# not loaded\" (X1).\n# The publication (lmx_walk_publish) writes the dirty rows into their slots in row order and unmarks\n# them: at CALL after its arguments, at PRIM_PUB after its operands, and when the activation ends --\n# RET after its value, a fall-off, a throw that leaves.  AT, PUT, PUT_REF, OF and PUT_OF are explicit\n# graph operations and never see the table: a write through them leaves the working value as it is.\n# Nothing is reloaded after a call, and a clean row is never written back.  Activation state lives\n# only on LmxWalkFrame and in its scratch slice; nothing precomputes or caches a field set (k.4).\n# MUL/DIV/MOD: [mul|div|mod, a, b]; typed numeric result. A zero divisor or\n# signed arithmetic overflow on a complete operation raises the ordinary\n# implicit `interpreter` throw (THROWN + LMX_WALK_NAME_INTERPRETER, no extra\n# children); malformed operands stay INVALID.\n# PUT_OF (-177 c4 / D-54): [put_of, struct-expr, slot, value]; holder evaluated.\n# D-105 (Q39): OF [of, struct-expr, slot, req] and PUT_OF [put_of, struct-expr, slot, value, req] --\n# a non-null req is the named Structure the place is typed with: the slot is an EDGE into the\n# `implements` table's correspondence (K01): below req's width it is req's own field (an explicit\n# `[N]name` use), from width to 2*width-1 the LAST half of field slot - width (a bare `name` use,\n# the value's last occurrence of it).  lmx_implements_slot resolves the edge to the value's own\n# slot; no record = INVALID.\n# A physical reference place can additionally carry the closed pointer-cell witness supplied by its declaration:\n# AT [at, slot, unused, pointer-witness], OF [of, holder, slot, optional-req, pointer-witness], and PUT_OF\n# [put_of, holder, slot, value, optional-req, pointer-witness]. The witness is checked before the live slot's kind\n# or value is read; an absent cell is not the valid null held by a present typed cell. The same canonical ABI is\n# required for the witness and slot even when both addresses came from another admitted arena.\n# lmx_walk_slot refuses an OP-node holder (X1). receiveMessage take (-177 c1): PRIM record whose fn is lmx_walk_mail_take (nargs 0);\n# Empty inbox yields a present null reference under its declared result contract.\n# lmx_walk_admit / lmx_walk_admit_letter consume two reference-value storage inputs;\n# letter admits its payload. YES preserves the reference; NO throws IMPLEMENTS.\n# lmx_walk_merge_model is the existing explicit runtime merge callback; this\n# carrier description does not define source declaration/call classification.\n# CALL/EXEC child3 and PRIM.signature share the ordinary two-part contract:\n# child0 is the ordered input-witness Structure; child1 is an empty return part\n# for void, or contains one result witness. The contract is declared metadata,\n# never inferred from supplied operands, used ARG nodes or a callable's data child0.\n#\n#   ret     [ret, value?]                 return an optional typed value\n#   call    [call, code, data, contract, catch, actuals...]\n#             code/data identify the selected complete callable occurrence;\n#             its native word selects native adapter or ordinary walk.\n#   exec    [exec, data?, target-expression, contract, catch, actuals...]\n", f) < 0
        return: 1
    if: c.fputs("#             evaluate the actual target (the code) once, then the explicitly\n#             passed data at slot 1 (`call: code data`; empty: the code\n#             itself), then use the same dispatch.\n#   lit     [lit, typed-cell]             snapshot a literal's typed value\n#   own     [own, holder, slot, reference-cell-witness?]  read the activation's working value;\n#             with distinct admitted code/data, the implements record of the\n#             actual pair projects the code's source slot to the data's\n#             physical slot; a PLACE holder (N4) reads the data slot of its\n#             name's ordinal through the procedure's static place table.  No\n#             position of the code is replayed into the data of\n#             `call: code data` (lmx_walk_data_holder)\n#   own_of  [own_of, holder-expression, slot, reference-cell-witness?]  read a hosted working value\n#   arg     [arg, ordinal, fallback?, type-witness]  present input or lexical fallback;\n#             the ENTRY source facet snapshots a callee-owned input at activation entry\n#   node    [node, size_t-count?, descriptor-expression?]  physical parent ancestry;\n#             absent count means one, zero selects the base itself. The base\n#             is the selected code unless explicitly supplied (one level up is\n#             node, the space above the method); it must be a present non-null\n#             Structure descriptor. An invalid explicit base never falls back.\n#   set_arg [set_arg, ordinal, value, type-witness]  write callee-owned input storage\n#   at      [at, holder, slot]            read physical declared storage\n#   of      [of, descriptor-expression, slot, model?]  physical path read\n#   deref   [deref, held-reference, referent-witness]  select the referent's place\n#   address [address, place-expression, pointer-witness]  address of real storage\n#   put     [put, place-expression, value]  select place, receive value, physical store\n#   put_ref [put_ref, holder, slot, descriptor]  replace a direct descriptor child\n#   set     [set, own-node, value]        working assignment, mark dirty after reception\n#   set_of  [set_of, holder-expression, slot, value, reference-cell-witness?]  hosted working assignment\n#   prim_pub [prim_pub, record, catch, operands...]  publish after operands, then callback\n#   add sub mul div mod lt eq [op, a, b]\n#   if      [if, cond, then, else?]       then/else are bodies\n#   while   [while, cond, body]\n#\n# The set of roles beyond RETURN and CALL and the operands of each are a carrier draft\n# for probing the mechanism, not an L3 ISA (dev/graph_interp/BODY_NODES.md).\n#\n# QUALIFIED IMMUTABILITY.  The full `independent: const: immutable` receiver profile is\n# itself an ordinary graph value.  LmxWalkContext carries its physical reference.  A\n# candidate is immutable exactly when its address range's array carries that same profile\n# reference; owner-local objects are protected and foreign ownership/sealing alone grant\n# nothing.  The way OUT is closed while a body is prepared: `put`, `set`, or a primitive\n# owner targeting that exact profile makes preparation INVALID.  Reading remains valid.\n#\n# This header describes the implemented carrier, not a second language grammar.\n# Source eligibility/type resolution belongs to the translator. Reached malformed\n# operands report INVALID; unknown roles report UNSUPPORTED. Empty bodies finish\n# normally. Runtime callbacks retain their distinct status/throw propagation.\n#\n\n", f) < 0
        return: 1
    if: c.fputs("define: LMX_WALK_OK 0\n# Malformed body tree, not a callable, a field reference that selects nothing, an own\n# field that is not lexically inside M, a missing input.\ndefine: LMX_WALK_INVALID 1\n# A callable with no body node: nothing to walk.\ndefine: LMX_WALK_NO_GRAPH 2\ndefine: LMX_WALK_NOMEM 3\n# An unknown reached executable role or an unsupported reached operation.\ndefine: LMX_WALK_UNSUPPORTED 5\n# THE PRIMITIVE REPORTED A FAILURE: the nonzero ABI status of its own fn (lmx_primitive.h.lm1).\n# A status of its own ON PURPOSE, and each of the four collisions is refused deliberately: it is\n# not business zero (a primitive may return the VALUE 0 with status OK -- that is success, and\n# the value rides in `out`/`dest`, never in the status), not LMX_WALK_INVALID (the graph is well\n# formed and the record was admitted), not LMX_WALK_UNSUPPORTED (this slice DOES read the node)\n# and not LMX_WALK_NO_GRAPH.  It travels up unchanged to whoever mapped the activation; the\n# Thread reports it through the Thread ABI's own existing failure status (lmx_thread.lm1).\ndefine: LMX_WALK_PRIMITIVE 6\n# Reserved distinct dispatch refusal status; not an empty-body or missing-plan rule.\ndefine: LMX_WALK_NOT_CALLABLE 7\n# D-37: an explicit method throw or a recoverable valid-graph operation fault\n# rides as LMX_WALK_THROWN + key, where key is the program's identity of the\n# thrown NAME (below): the walker never renumbers a status between activations\n# and never resolves a spelling.  The per-callee ABI ordinal (declared names\n# 1..d in `throws:` order, implicit names d + g) exists only at the native\n# boundary: lmx_walk_key_from_ordinal / lmx_walk_ordinal_from_key translate\n# through the callee's retained THROWS node.  Malformed-graph and kernel errors\n# stay 1..7 and become X1 at note_walk_fail.\ndefine: LMX_WALK_THROWN 8\n# THE KEY OF A THROW NAME.  The implicit names have the language's fixed\n# keys, in the order of their implicit statuses (g); every declared name of a\n# translation unit gets the next key at its first appearance.  A key lives in a\n# typed size_t cell exactly where the source names the throw: in THROWS (the\n# `throws:` header), in PAD (the `catch:` name) and in THROW (the `throw:` name);\n# the address-to-name table carries the spelling of each such cell for toLmx.\ndefine: LMX_WALK_NAME_MERGE 1\ndefine: LMX_WALK_NAME_IMPLEMENTS 2\ndefine: LMX_WALK_NAME_CONVERT 3\ndefine: LMX_WALK_NAME_INTERPRETER 4\ndefine: LMX_WALK_NAME_ADOPT 5\ndefine: LMX_WALK_NAME_INDEPENDENT 6\ndefine: LMX_WALK_NAME_CALL 7\ndefine: LMX_WALK_NAME_DECLARED 8\n\n# What lmx_walk_op answers for a frame node whose code is not one of those below.\ndefine: LMX_WALK_OP_UNKNOWN -1\n# The fixed instruction vocabulary. A typed OP record carries its code inside\n# the graph; the record's physical address is not the instruction identity.\ndefine: LMX_WALK_OP_NONE 0\ndefine: LMX_WALK_OP_RET 1\ndefine: LMX_WALK_OP_CALL 2\ndefine: LMX_WALK_OP_LIT 3\ndefine: LMX_WALK_OP_OWN 4\ndefine: LMX_WALK_OP_ARG 5\ndefine: LMX_WALK_OP_AT 6\ndefine: LMX_WALK_OP_PUT 7\ndefine: LMX_WALK_OP_SET 8\ndefine: LMX_WALK_OP_ADD 9\ndefine: LMX_WALK_OP_SUB 10\ndefine: LMX_WALK_OP_LT 11\ndefine: LMX_WALK_OP_EQ 12\ndefine: LMX_WALK_OP_IF 13\ndefine: LMX_WALK_OP_WHILE 14\ndefine: LMX_WALK_OP_OF 15\n# [prim, record, arg ...] -- THE PRIMITIVE INSERT (lmx_primitive.h.lm1).  `record` is a PHYSICAL\n# reference to an LmxPrimitive, admitted because the arena classifies it as\n", f) < 0
        return: 1
    if: c.fputs("# LMX_DOMAIN_KIND_PRIMITIVE -- never because a number in the node says so.  The remaining\n# children are its operands, evaluated exactly like a call's arguments.  Appended after the\n# slice's roles; its opcode is decoded from the typed OP record.\ndefine: LMX_WALK_OP_PRIM 16\n# [expect_int, path, want] -- type/equality check on a subject's path.  Uses f\\args[0]\n# as the subject (the input graph), never f\\self or own-field semantics.\ndefine: LMX_WALK_OP_EXPECT_INT 17\ndefine: LMX_WALK_OP_DEREF 18\n# -177 c4 / D-54: PUT with an evaluated holder (m\\f: v through a reference).\ndefine: LMX_WALK_OP_PUT_OF 19\n# MUL/DIV/MOD have the same two typed value operands as ADD/SUB; a zero\n# divisor or signed arithmetic overflow is the implicit `interpreter` throw\n# (lmx_walk_fault), checked before the C99 operation.\ndefine: LMX_WALK_OP_MUL 20\ndefine: LMX_WALK_OP_DIV 21\ndefine: LMX_WALK_OP_MOD 22\n# [empty]: a new empty Structure, one per execution (`E()`, `m()`, a D-23 empty actual) -- made the way the\n# native emission makes one (lmx_node_new_owned); no prototype in the plan (lmx_walk_empty).\ndefine: LMX_WALK_OP_EMPTY 23\n# -186: [put_ref, holder, slot, value] -> lmx_arena_ref_store (direct Structure own slot).\n# Same operand order as PUT. Mutant: PUT+pointer_store into a direct slot -> RED.\ndefine: LMX_WALK_OP_PUT_REF 24\n# -170 c2: array element / length at the walked root (Grok). Contiguous claim after\n# PUT_REF; Sonnet MERGE prim takes 28+ (OP_COUNT coord via lmx_uds 2026-09-25).\n# [elem, holder, slot, index] / [elemput, holder, slot, index, value] /\n# [length, holder, slot].\n# Holder 0 is the current occurrence. Bounds use descriptor.size; char values are\n# read from backing bytes, while ADDRESS retains the backing element's place.\n# A valid-graph runtime fault (an index past the descriptor, a null Array) is the\n# ordinary implicit `interpreter` throw (lmx_walk_fault); a malformed operator\n# remains an invalid graph diagnostic.  No status or landing place is stored on\n# the node.\ndefine: LMX_WALK_OP_ELEM 25\ndefine: LMX_WALK_OP_ELEMPUT 26\ndefine: LMX_WALK_OP_LENGTH 27\n# -201: [pad, name-key, param_ref_0 .. param_ref_P-1, body]. Catch landing: the\n# key is the caught name's (LMX_WALK_NAME_*), so a thrown status finds its pad\n# by lexical parentage (lmx_walk_pad_find in lmx_walk_body), never through a\n# row on the throwing CALL/PRIM.  Count was 28.\ndefine: LMX_WALK_OP_PAD 28\n# User break and continue. A body propagates them. WHILE, FOR and UNTIL consume\n# them: break ends the loop as success, continue starts the next turn (FOR runs\n# its step first, UNTIL asks its condition). They are not walker errors (1..7)\n# and not throws (>= THROWN).\n# A jump that escapes the walk is an unknown status.\ndefine: LMX_WALK_BREAK -2\ndefine: LMX_WALK_CONTINUE -3\n# Internal Message-stop control, not an error or throw. Activations publish and\n# rewind before public run/dispatch normalize it to success with absent result.\ndefine: LMX_WALK_STOPPED -4\ndefine: LMX_WALK_OP_BREAK 29\ndefine: LMX_WALK_OP_CONTINUE 30\n# §7b: the working state (the header's THE WORKING STATE).\ndefine: LMX_WALK_OP_OWN_OF 31\ndefine: LMX_WALK_OP_SET_OF 32\ndefine: LMX_WALK_OP_PRIM_PUB 33\n# An argument is its parameter (the author, bafca4c; Q52): SET_ARG writes the activation's own value.\ndefine: LMX_WALK_OP_SET_ARG 34\n# [exec, data?, S, contract, catch, args...]: evaluate S once, then the data at slot 1 when present (else S itself),\n", f) < 0
        return: 1
    if: c.fputs("# and dispatch that occurrence over that data using the same declared transport contract as CALL.  Slot 1 is a\n# CALL_DATA when the code has names (N4): the call then admits the data against the code's place table first.\ndefine: LMX_WALK_OP_EXEC 35\n# [node]: the activation's `node` (book §3) -- its code's parent, the physical lexical space above the method: the\n# unit for a file-level method, the host's occurrence for a nested one, the copied lexical context under which a\n# returned node was made (a merge result's parent).  OF / PUT_OF go on from it by the slots of that space's body.\ndefine: LMX_WALK_OP_NODE 36\n# [admit_as, receivingRecord, payloadFromLetter, value, targetModel].\n# receivingRecord is ordinary current data: [templateCatalog, coverage, mode,\n# referenceContracts, sourceContext]. A sourceContext is absent, or ordinary\n# [current giving Model, giving referenceContracts] data. A present malformed\n# context refuses; it never means \"guess from the value\". These references\n# relocate through the same graph-copy map as every other graph edge.\n# referenceContracts contains [count, then triples\n# (required layout token, physical field, declared pointee Model)]. It never\n# reads that type from the reference's mutable/default/null current value.\n# The catalog stores typed layout-token pairs and ordinal/LAST coordinates;\n# mode is coordinate (0), full receiving (1), or scoped receiving (2).\n# Coverage is absent except for scoped receiving. The common kernel resolves\n# physical addresses and proves the Consumer; native and walker do not select\n# a default/alternative/identity map separately. No source names are stored.\n# Candidate once; null passes before receiving-record lookup. The optional\n# payloadFromLetter flag extracts the letter's payload before the admission.\n# A RECEIVING admission evaluates only targetModel in the selected CALL/EXEC\n# occurrence; its candidate and handlers remain in the caller's activation.\n# Unknown/malformed receiving data refuses through implements; a missing\n# receiving-record operand is an invalid executable graph.\ndefine: LMX_WALK_OP_ADMIT_AS 37\n# [and, a, b] / [or, a, b]: `a && b` / `a || b` as one value, short-circuit -- b is evaluated only when a does not decide\n# -- an int, 1 or 0.  A condition is then one value however it is built, and a loop asks it afresh in full each turn,\n# after a `continue` too.\ndefine: LMX_WALK_OP_AND 38\ndefine: LMX_WALK_OP_OR 39\n# [for, cond, body, step]: the core `for` (book, branches and loops: the initialization once, then condition, body and\n# step).  The initialization is the step before this node; `step` -- a plain Structure of steps -- runs after each turn\n# of the body, a `continue` too, and a `break` ends the loop as success.\ndefine: LMX_WALK_OP_FOR 40\n# [until, cond, body]: the postcondition loop (book §13, a closing `until`): the body first, then the condition, and\n# the loop ends when it holds -- a `continue` goes to the condition, a `break` ends the loop as success.\ndefine: LMX_WALK_OP_UNTIL 41\n# [address, place-expression, closed-pointer-type witness]. Resolve the physical\n# place without loading its value or publishing the activation's working state.\ndefine: LMX_WALK_OP_ADDRESS 42\n# [self]: the actual data occurrence of this activation (holder zero), not its\n# code and not its lexical parent. Internal operand; source `node` stays NODE.\ndefine: LMX_WALK_OP_SELF 43\n# Retained source Frames whose bodies are not operands of the L3 evaluator.\n", f) < 0
        return: 1
    if: c.fputs("# Directives are inert. A reached machine-only operation cannot be interpreted;\n# its source tree still exists when its callable has a native implementation.\ndefine: LMX_WALK_OP_SOURCE_INERT 44\ndefine: LMX_WALK_OP_SOURCE_MACHINE 45\n# [else, owned-body]: a source sibling of its IF. The IF borrows this\n# application for its false arm; the enclosing body owns it. Encountering the\n# sibling in ordinary source order does not execute its body a second time.\ndefine: LMX_WALK_OP_ELSE 46\n# [named, coordinate, payload]: a named actual at its written place among a\n# call's operands. The call evaluates its operands in the order they stand,\n# which is the order they were written, and hands each value to the formal\n# whose coordinate the operand carries. An operand that is not NAMED supplies\n# the formal of its own position. The node's source name is the written name\n# of the formal. Outside a call's operands the node is not an expression.\ndefine: LMX_WALK_OP_NAMED 47\n# [neg, operand], [pos, operand]: a prefix sign over its one operand. The\n# operand is evaluated once and promoted as C promotes it; NEG negates the\n# promoted value, POS leaves it. A written prefix stays one operator with one\n# operand: it is never a subtraction from an invented zero.\ndefine: LMX_WALK_OP_NEG 48\ndefine: LMX_WALK_OP_POS 49\n# [guard, source, continuation], [guarded]: a presence guard.  The source is evaluated once.  Absent, the guard's\n# value is absent and the continuation does not run.  Present, the continuation runs, and inside it [guarded] is that\n# value, held by the activation while the continuation runs; a guard inside the continuation holds its own and gives\n# the outer one back when it ends.  The guard does not look at what the value is: it is the presence of a value that\n# may arrive absent -- an input a method hands on -- at an edge whose operation, the continuation, needs it present.\n# [guarded] outside every continuation is not a node the walker runs.\ndefine: LMX_WALK_OP_GUARD 50\ndefine: LMX_WALK_OP_GUARDED 51\n# [throw, source Name or Name(actuals), name-key]. The source frame remains in\n# the original field position; the key is the thrown name's identity\n# (LMX_WALK_NAME_*), not a second source name or a runtime name lookup. A throw\n# leaves this activation as THROWN + key; the enclosing bodies find its pad.\ndefine: LMX_WALK_OP_THROW 52\n# [throws, name-key...]: the callable's `throws:` header at its written place,\n# one key cell per declared name in declared order.  Inert when reached; read\n# at the native boundary to translate keys and per-callee ordinals.\ndefine: LMX_WALK_OP_THROWS 53\n# N4 `call: code data` (docs/LMX_semantics.ru.md: the code-to-data correspondence is prepared at the admission of the\n# selected call, before its body, as addresses, with no runtime name search).\n# [place, tokens, table]: the holder of a code name's own node -- OWN/AT/SET/PUT [op, PLACE, r] -- where r is the\n# name's ordinal in its procedure's static place table (lmx_implements_places: [m, k, rows of (token index, m data\n# slots)]); tokens and table are CHAR_PTR cells holding module-lifetime addresses.  The activation resolves the table\n# once, at its entry, over its data (the row of the data's own layout token), and r reads that row's slot of the\n# data.  Not evaluated.\ndefine: LMX_WALK_OP_PLACE 54\n# [call_data, data, tokens, table]: EXEC's slot 1 when the code has names: the data operand (evaluated as slot 1\n", f) < 0
        return: 1
    if: c.fputs("# is) and the code's place table.  The call admits the data against the table after the actuals and the\n# publication and before the callee: a place the data lacks, holds ambiguously or holds unfit is the call's\n# implicit `call` throw (LMX_WALK_NAME_CALL), with no payload; data of no proved layout is INVALID.  Not evaluated\n# as an expression.\ndefine: LMX_WALK_OP_CALL_DATA 55\n# [layout_switch, selected data, token, branch, ...]: choose one already\n# compiled branch by the selected Structure's registered physical layout.\n# Tokens are immutable module-lifetime addresses; no field name is resolved\n# while the program runs. A zero-branch frame is valid but cannot run: the\n# call-place check rejects every candidate before this instruction is reached.\n# A missing layout during execution is an invalid activation.\ndefine: LMX_WALK_OP_LAYOUT_SWITCH 56\n# [of_edge, holder, edge]: a place of the holder named by a SOURCE-CODE EDGE of its execution layout -- the edge is\n# projected through the holder's execution map (lmx_implements_exec_index: a merge's selected body executes over the\n# completed value, whose slots the selected source's edges do not match positionally), exactly as the native code-rooted\n# roots read their places (l2_gp: lmx_arena_ref_struct(l2_call_code, lmx_implements_exec_index(..., edge))).  A holder\n# without an execution map projects the edge onto itself.  The holder names whose layout the edge belongs to: NODE(0), the\n# code occurrence (a split-called code, a four-part fn), or SELF, the data of an occurrence that is its own data (a merge\n# result executing the selected body is code = data = the result; natively self + lmx_implements_code_index).  OF keeps\n# its index PHYSICAL: an evaluated OF denotes a\n# physical or explicitly modeled access, never a source coordinate (the two cannot share one unqualified child; the\n# walked chain root of a code-rooted method is this operation, U7 D4).  Width 3; a holder reference operand as OF's.\ndefine: LMX_WALK_OP_OF_EDGE 57\ndefine: LMX_WALK_OP_COUNT 58\n# Source role of an operation, separate from its execution opcode. The OP\n# record encodes source * OP_COUNT + opcode in its code word.\n# Receiver materialization keeps the real typed cell; no leaf wraps that cell.\n# An explicit initializer and an implicit declaration action must not become\n# indistinguishable from a later assignment, even if their effects coincide.\ndefine: LMX_WALK_SOURCE_ORDINARY 0\ndefine: LMX_WALK_SOURCE_INITIALIZER 1\ndefine: LMX_WALK_SOURCE_IMPLICIT 2\ndefine: LMX_WALK_SOURCE_ANONYMOUS 3\ndefine: LMX_WALK_SOURCE_TRAILER 4\n# A RECEIVING admission (ADMIT_AS) is an input of the CALL or EXEC it stands under: its requirement is the one the\n# occurrence that instruction selects receives in, read in that occurrence's space (lmx_walk_admit_in).\ndefine: LMX_WALK_SOURCE_RECEIVING 5\n# A CONVERSION call is the implicit call of a conversion row's receiver at a\n# typed edge: whatever the receiver throws leaves this call as the caller's\n# implicit `convert` (LMX_WALK_NAME_CONVERT), as native edge 1 does.\ndefine: LMX_WALK_SOURCE_CONVERSION 6\ndefine: LMX_WALK_SOURCE_ARG_ENTRY 7\n# THE ENTRY RECEPTION: [set_arg, k, received value, witness], the receiving act of declared formal k of the method\n# whose body holds it -- the value an ADMIT_AS of input k to the formal's model by the method's own receiving record\n# gives.  The selected callable receives its Structure inputs itself, by its own records, whoever calls it.  Every\n", f) < 0
        return: 1
    if: c.fputs("# such step of the selected body runs at the activation's entry, after its inputs are open and before the entry load\n# and the body, outside every pad of the body (lmx_walk_receive); the body does not run it again.  A refusal leaves the\n# activation as THROWN + IMPLEMENTS, for the caller's pads: the call's `implements`.\ndefine: LMX_WALK_SOURCE_RECEPTION 8\ndefine: LMX_WALK_SOURCE_COUNT 9\n# Computed values use the SAME activation-only record as native call adapters\n# (lmx_value.h.lm1). Numeric widths and ordinary pointer-cell ABI are unchanged.\n\n# A physical place selected before any load. `address` is the value's read/write\n# representation: a primitive cell or a Structure/Array descriptor. `storage`\n# is the place's actual address for unary @: for a graph reference it is the\n# slot holding that descriptor, even when the stored descriptor is null. This\n# is activation-local metadata, never a graph or a retained index.\nstruct: LmxWalkPlace\n    @: void address\n    @: void storage\n    int: type\n    int: descriptor\n    # Optional explicit owner of the selected activation cell's value state.\n    # Graph/foreign raw cells without such a producer remain unqualified.\n    @: LmxWalkValue context\nend: LmxWalkPlace\n\n# §7b: one row of an activation's working table -- an own field the body uses by a bare name.  The slot\n# is where the field is (holder's child `index`); kind 1 is a number (num, of type ty), 2 a pointer cell\n# (ref, what it holds), 3 a Structure slot (ref, the Structure or 0).  dirty: an executed write since the\n# last publication.  next: the row made after this one.\nstruct: LmxWalkWork\n    @: Lmx holder\n    size_t: index\n    @@: void slot\n    @: void ref\n    size_t: num\n    int: kind\n    int: ty\n    int: dirty\n    @: LmxWalkWork next\n    @: Lmx model\n    @: Lmx references\n    @: LmxWalkValue referent\nend: LmxWalkWork\n\n# What graph mode needs from its surroundings, for one Message on one thread: the\n# Message's arena (to tell a Structure from a cell among the fields of a body)\n# and the execution context's temporary-frame store. Typed OP records are\n# classified by their actual arena; there is no builder-role table context.\nstruct: LmxWalkContext\n    @: LmxArena arena\n    @: LmxScratch scratch\n    # Physical address of the ordinary receiver-expression graph value denoting the exact\n    # independent+const+immutable profile.  Zero means this program declares no such profile.\n    @: Lmx immutable_profile\n    # Borrow the existing qualified-root span, not a second graph or name map.\n    @@: Lmx immutable_roots\n    size_t: immutable_root_count\n    # How many times this unit has asked the arena's index what an address is.\n    size_t: classified\n    # N4 (SF14): 1 while an EXEC with explicit data enters its walked callee; that entry takes it (LmxWalkFrame.split)\n    # and clears it, so no activation nested in the callee inherits it.\n    int: split_entry\nend: LmxWalkContext\n\n# One activation.  An automatic object of lmx_walk_run; nothing of it is in the graph.\nstruct: LmxWalkFrame\n    @: LmxWalkContext context\n    @: LmxArena arena\n    # The selected code, the source model of its data fields, and the actual data: `code`\n    # retains the selected occurrence and native identity; `source` is the physical\n    # Structure whose field coordinates the body uses; `node` supplies those fields.\n    # For a direct flat call all three are M. For an explicit code/data call,\n", f) < 0
        return: 1
    if: c.fputs("    # source is the code's data schema and node is the passed Structure; PLACE\n    # or the implements record maps their fields. For a method with explicit\n    # parts, code is the method, source its owned var, and body is passed to\n    # the entry/activation routines separately. A fixed holder is replayed by\n    # child position only for a physical copy, not as a substitute for an\n    # admission map in an explicit split call.\n    @: Lmx code\n    @: Lmx source\n    @: Lmx node\n    # The declared inputs use value-storage addresses. Zero is an absent input;\n    # a present pointer input has storage even when its payload is null.\n    # argown provides the activation's stable typed places, never borrowed boxes.\n    @@: void args\n    size_t: nargs\n    @: LmxWalkValue argown\n    int: returned\n    LmxWalkValue: result\n    # -201: set by the body that owns the pad a thrown key names (lmx_walk_pad_find); 0 while the throw propagates.\n    # payload is the thrown record (0 for an implicit throw).\n    @: Lmx landing\n    @: void payload\n    # [guard]: the value of the innermost guard whose continuation is running (the guard's own evaluation holds it),\n    # read by [guarded]; 0 outside every continuation.\n    @: LmxWalkValue guarded\n    # §7b: the working table the entry loaded (0 before it): nwork rows linked from work, in this activation's\n    # scratch slice.\n    @: LmxWalkWork work\n    size_t: nwork\n    # N4: the place table this activation resolved at its entry (lmx_walk_place_open) and that table's row for the\n    # data: one data slot per name of the code, place_n of them, in the activation's scratch slice.  0 while the\n    # code has no PLACE.\n    @: size_t place_table\n    @: size_t place_slots\n    size_t: place_n\n    # N4 (SF14; Codex OPUS-CODEX-20261016-27): 1 when an EXEC entered this activation with explicit data (slot 1),\n    # taken from LmxWalkContext.split_entry at the entry.  Its data is no copy of its code: no position is replayed.\n    int: split\nend: LmxWalkFrame\n\nprototype:\n    # Direct activation: args[k] is declared-width value storage, or zero for an\n    # absent input. Storage may belong to a caller or scratch; held references\n    # are interpreted only by operations consuming their declared category.\n    # out may be zero when the caller discards the typed result.\n    # Existing merge-model callback: declared descriptor input and descriptor result;\n    # owner is the program arena. This callback does not define source head semantics.\n    # -177 c1: receiveMessage take. LmxPrimitive.fn = this; PRIM [prim, record] nargs 0;\n    # empty inbox -> out 0 OK; else letter\\graph. Impl in lmx_thread.lm1 (link closure).\n    fn: lmx_walk_mail_take (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n    # Reparenting remains two explicit ordinary calls. The callback bodies\n    # live with Thread/reparent, not in the graph walker itself.\n    fn: lmx_walk_adopt (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n    fn: lmx_walk_independent (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n", f) < 0
        return: 1
    if: c.fputs("    # -177 c3: receive-if. LmxPrimitive.fn = this; owner = program arena; PRIM [prim, record, model].\n    fn: lmx_walk_receive_if (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n    fn: lmx_walk_merge_model (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n    # -180: admit a value already in hand (native B2). PRIM [prim, record, value, model]; owner=program arena.\n    # Value null / pointer-null -> out 0 OK; pointer-or-Structure -> implements; else FAIL=1. Letter admits slot 1.\n    fn: lmx_walk_admit (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n    fn: lmx_walk_admit_letter (@: void owner; @@: void refs; size_t: nargs; @: void dest; @@: void out; @: LmxArena lmx_call_arena; @: Lmx lmx_call_code; @: LmxWalkValue lmx_input_values; @: LmxWalkValue lmx_result_context) int\n    # D-105 (Q39): the admission of a value to a named Structure is the walker's ADMIT_AS op (lmx_walk_admit_op).\n    # Item 738 (steps/capture-738.md): the capture of a Structure -- a copy of src's fields fields[0..n) names\n    # (req's slots), fresh value cells at req's own slots, the other slots empty, hung under `parent`; recorded in\n    # the arena's `implements` table as req's own layout with holes (an empty slot is not carried).  0 on a field\n    # that is not a value cell, or on no room. layout is the compiler's schema\n    # token for the freshly constructed req-slot layout, or zero when unknown.\n    fn: lmx_walk_capture (@: LmxArena arena; @: Lmx parent; @: Lmx src; @: Lmx req; @: size_t fields; size_t: n; @: void layout) @: Lmx\n    # A copy of what a slot holds, as a merge copies data: a number a fresh cell of its type holding its value now, a\n    # char included; anything nonnumeric itself. 0 on no room.\n    fn: lmx_walk_cell_copy (@: LmxArena arena; @: void cell) @: void\n    # N4: the unary data of a call -- a four-part fn occurrence's var part,\n    # any other callee itself. The arena's typed Structure pool records the\n    # result role, never inferred from names or pointer equality: an\n    # explicitly passed data Structure, an alias `call: F F` included,\n    # passes through unchanged.\n    fn: lmx_call_unary_data (@: LmxArena arena; @: Lmx code) @: Lmx\n    # CALL and PRIM use the same physical args/return contract for ABI marshalling.\n    fn: lmx_walk_run (@: LmxWalkContext context; @: Lmx node; @@: void args; size_t: nargs; @: LmxWalkValue out) int\n    # The same typed activation for an internal caller. Ordinary code has its\n    # operators in the selected Structure; a method with explicit parts passes\n    # its owned body separately while retaining the method as code identity.\n    # The result record is copied before activation scratch is released.\n    fn: lmx_walk_activate (@: LmxWalkContext context; @: Lmx code; @: Lmx data; @@: void args; size_t: nargs; @: LmxWalkValue result) int\n    fn: lmx_walk_activate_parts (@: LmxWalkContext context; @: Lmx code; @: Lmx body; @: Lmx source; @: Lmx data; @@: void args; size_t: nargs; @: LmxWalkValue result) int\n", f) < 0
        return: 1
    if: c.fputs("    # Optional explicit computed values accompany the SAME declared-width\n    # storage span. Entry checks correspondence and copies them into stable\n    # callee-owned argument places before any entry/body effect. Null values\n    # means the ordinary raw-storage boundary, not a Model lookup. Returned\n    # context belongs to the value, not to scratch bytes of this activation.\n    # Native adapter/primitive raw ABI producers do not yet supply this span.\n    fn: lmx_walk_activate_values (@: LmxWalkContext context; @: Lmx code; @: Lmx data; @@: void args; size_t: nargs; @: LmxWalkValue values; @: LmxWalkValue result) int\n    fn: lmx_walk_activate_parts_values (@: LmxWalkContext context; @: Lmx code; @: Lmx body; @: Lmx source; @: Lmx data; @@: void args; size_t: nargs; @: LmxWalkValue values; @: LmxWalkValue result) int\n    # Entry (k.4: no cached plan or descriptor -- next_core_tasks.md §3 item 9).\n    # Opens the frame over `code`/`data`, classifies both as Structures, and\n    # snapshots this activation's consumed hidden inputs in ordinal order before\n    # own-field loading or body statements. Forward-only inputs stay absent.\n    # An empty body remains valid; unsupported body operations are refused when\n    # reached, while an invalid input source can be refused at entry.\n    fn: lmx_walk_enter (@: LmxWalkFrame f; @: LmxWalkContext context; @: Lmx code; @: Lmx data; @@: void args; size_t: nargs) int\n    fn: lmx_walk_enter_parts (@: LmxWalkFrame f; @: LmxWalkContext context; @: Lmx code; @: Lmx body; @: Lmx source; @: Lmx data; @@: void args; size_t: nargs) int\n\n    # Reset the inherited borrowed qualified-root span before construction.\n    fn: lmx_walk_program_bind () void\n    fn: lmx_walk_program_qualify (@@: Lmx roots; size_t: count) void\n    # Construction of body nodes, for a translator and for tests.  A node is a fresh\n    # Structure of `arena` with `children` slots and immediate structural parent `parent`; a frame\n    # node gets a typed OP record of `code` in child[0] under its actual profile. The caller stores the node\n    # into its parent's slot.\n    fn: lmx_walk_frame (@: LmxArena arena; @: Lmx parent; int: code; size_t: children) @: Lmx\n    fn: lmx_walk_frame_profiled (@: LmxArena arena; @: Lmx parent; int: code; size_t: children; @: Lmx profile) @: Lmx\n    fn: lmx_walk_role_cell (@: LmxArena arena; int: code; @: Lmx held_profile) @: void\n    # Source identity on an existing operation; execution still uses its base opcode.\n    fn: lmx_walk_code_in (@: LmxArena arena; @: void head) int\n    fn: lmx_walk_source_mark (@: LmxArena arena; @: Lmx operation; int: source) int\n    # The throw-name keys of a callable (THROWN): its retained THROWS node, the\n    # count of its declared names, the two translations at the native boundary,\n    # and a walked activation's thrown status as its native caller reads it.\n    fn: lmx_walk_throws_node (@: LmxArena arena; @: Lmx callable) @: Lmx\n    fn: lmx_walk_declared_count (@: LmxArena arena; @: Lmx callable) size_t\n    fn: lmx_walk_key_from_ordinal (@: LmxArena arena; @: Lmx callable; size_t: ordinal; @: size_t out) int\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_walk_ordinal_from_key (@: LmxArena arena; @: Lmx callable; size_t: key; @: size_t out) int\n    fn: lmx_walk_boundary_status (@: LmxArena arena; @: Lmx callable; int: status) int\n    fn: lmx_walk_plain (@: LmxArena arena; @: Lmx parent; size_t: children) @: Lmx\n    fn: lmx_walk_plain_profiled (@: LmxArena arena; @: Lmx parent; size_t: children; @: Lmx profile) @: Lmx\n    fn: lmx_walk_store_size (@: LmxArena arena; @: Lmx code; size_t: slot; size_t: value) int\n    fn: lmx_walk_store_int (@: LmxArena arena; @: Lmx code; size_t: slot; int: value) int\n    fn: lmx_walk_store_char (@: LmxArena arena; @: Lmx code; size_t: slot; int: value) int\n    fn: lmx_walk_store_charptr (@: LmxArena arena; @: Lmx code; size_t: slot; @: char value) int\n    fn: lmx_walk_store_unsigned (@: LmxArena arena; @: Lmx code; size_t: slot; unsigned: value) int\n    fn: lmx_walk_store_ulong (@: LmxArena arena; @: Lmx code; size_t: slot; ulong: value) int\n\n    # §7b: the working state -- the slot an OWN/OWN_OF node names (with its holder and index), the row of a\n    # slot, a row loaded, the entry load derived from the code, and the publication of the dirty rows.\n    fn: lmx_walk_work_cell (@: LmxWalkFrame f; @: void node; int: write; @@: Lmx holder; @: size_t index; @@@: void slot) int\n    fn: lmx_walk_work_find (@: LmxWalkFrame f; @@: void slot) @: LmxWalkWork\n    fn: lmx_walk_work_make (@: LmxWalkFrame f; @: Lmx node; @: Lmx holder; size_t: index; @@: void slot) int\n    fn: lmx_walk_load_node (@: LmxWalkFrame f; @: Lmx node) int\n    fn: lmx_walk_load_body (@: LmxWalkFrame f; @: Lmx body) int\n    fn: lmx_walk_entry_body (@: LmxWalkFrame f; @: Lmx body; @@: Lmx entries; int: load) int\n    fn: lmx_walk_entry_node (@: LmxWalkFrame f; @: Lmx node; @@: Lmx entries; int: load) int\n    fn: lmx_walk_snapshot_args (@: LmxWalkFrame f; @: Lmx body) int\n    fn: lmx_walk_publish (@: LmxWalkFrame f) int\n    # The activation's write of its input k (SET_ARG).\n    fn: lmx_walk_arg_write (@: LmxWalkFrame f; size_t: k; int: ty; @: LmxWalkValue value; @: LmxWalkValue out) int\n    # Internal steps, named here because they are mutually recursive.\n    fn: lmx_walk_immutable (@: LmxWalkFrame f; @: void p) int\n    fn: lmx_walk_kind (@: LmxWalkFrame f; @: void p) int\n    fn: lmx_walk_op (@: LmxWalkFrame f; @: void code) int\n    fn: lmx_walk_eval (@: LmxWalkFrame f; @: void code; @: LmxWalkValue out) int\n    fn: lmx_walk_throw (@: LmxWalkFrame f; @: Lmx code; @: LmxWalkValue out) int\n    fn: lmx_walk_body (@: LmxWalkFrame f; @: Lmx body; size_t: first) int\n    fn: lmx_walk_value_clear (@: LmxWalkValue value) void\n    fn: lmx_walk_value_ref (@: LmxWalkValue out; int: ty; @: void ref) int\n    fn: lmx_walk_value_ref_parts (@: LmxWalkValue out; int: ty; @: void ref; @: Lmx model; @: Lmx references) int\n    # Consume a reference already evaluated by native or walker. No path\n    # expression,source graph wrapper or shared-frame mutation is involved.\n    fn: lmx_walk_value_admit (@: LmxArena arena; @: LmxWalkValue value; @: Lmx model; @: Lmx record) int\n    fn: lmx_walk_value_num (@: LmxWalkValue out; int: ty; size_t: number) int\n    fn: lmx_walk_value_number (@: LmxWalkValue value; @: size_t number; @: int ty) int\n    fn: lmx_walk_value_storage (@: LmxWalkValue value) @: void\n    fn: lmx_walk_value_foreign (@: LmxWalkValue value; @: void storage) int\n    fn: lmx_walk_value_load (@: LmxArena arena; @: void storage; int: ty; @: LmxWalkValue out) int\n", f) < 0
        return: 1
    if: c.fputs("    fn: lmx_walk_value_cell (@: LmxArena arena; @: void cell; @: LmxWalkValue out) int\n    # Shared graph-backed native literal read: validate the retained LIT and\n    # load its exact numeric cell, never a P0 constant copied into native code.\n    fn: lmx_walk_native_numeric_lit (@: LmxArena arena; @: Lmx code; int: expected_type; @: LmxWalkValue out) int\n    fn: lmx_walk_native_int_bin_check (@: LmxArena arena; @: Lmx code; @: int op) int\n    fn: lmx_walk_native_int_bin_apply (int: op; int: left; int: right; @: int result) int\n    fn: lmx_walk_witness_type (@: LmxArena arena; @: void witness) int\n    fn: lmx_walk_place (@: LmxWalkFrame f; @: void node; int: write; @: LmxWalkPlace out) int\n    fn: lmx_walk_arg_place (@: LmxWalkFrame f; size_t: k; int: ty; @: LmxWalkPlace out) int\n    fn: lmx_walk_value_store (@: LmxArena arena; @: LmxWalkPlace place; @: LmxWalkValue value) int\n    fn: lmx_walk_place_load (@: LmxArena arena; @: LmxWalkPlace place; @: LmxWalkValue out) int\n    # Shared physical Array-place selection;no Frame,names or Model guessing.\n    fn: lmx_value_array_place (@: LmxArena arena; @: LmxArray array; size_t: index; @: LmxWalkPlace out) int\n    fn: lmx_walk_place_context (@: LmxArena arena; @: LmxWalkPlace place) @: LmxWalkValue\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_walk

fn: decl_win32_api (@: f c.FILE) int
    if: c.fputs("# THE WIN32 NAMES THE KERNEL CALLS, declared here instead of <windows.h> (next_core_tasks.md §0\n# «Память сборки», third measurement): the whole header costs cc1 244 MB of parsing in every unit\n# the kernel reaches through predef, for these eleven names.  Exactly the calls and constants the\n# four _win32 bodies use (lmx_clock, lmx_manager_running, lmx_manager_running_lane,\n# lmx_process_deadline), by their Win32 names, with mingw-w64's own types -- DWORD is unsigned\n# long (ulong), BOOL int, HANDLE and LPVOID void *, SIZE_T size_t, ULONGLONG unsigned long long\n# (uint64_t) -- and nothing else: no wrapper, no fallback.  On x64 WINAPI is the one calling\n# convention.  A unit must not also include <windows.h>: two declarations of one function would\n# meet (none of the kernel does).\n\n# size_t and uint64_t, the only standard types below: <windows.h> used to bring them.\ninclude: \"<stddef.h>\" \"<stdint.h>\"\n\ndefine: INFINITE 0xFFFFFFFFU\ndefine: WAIT_OBJECT_0 0U\ndefine: WAIT_TIMEOUT 258U\n\n# LPTHREAD_START_ROUTINE: a thread's body takes its argument and returns a DWORD.\nfnptr: LmxWin32ThreadStart (@: void arg) ulong\n\nprototype:\n    fn: GetTickCount64 () uint64_t\n    sub: Sleep (ulong: ms)\n    fn: WaitForSingleObject (@: void handle; ulong: ms) ulong\n    fn: CloseHandle (@: void handle) int\n    fn: CreateThread (@: void security; size_t: stack; LmxWin32ThreadStart: start; @: void arg; ulong: flags; @: ulong id) @: void\n    fn: GetCurrentThreadId () ulong\n    fn: CreateEventW (@: void security; int: manual; int: initial; @: void name) @: void\n    fn: SetEvent (@: void handle) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_win32_api

fn: decl_posix_abi (@: f c.FILE) int
    if: c.fputs("include: \"<pthread.h>\" \"<time.h>\" \"<errno.h>\"\n\n# Names the POSIX bodies need and the shared headers must not grow.\n# Only those bodies predef this unit. The Windows body does not, so the L3\n# type budget on Windows stays the count from slice (a). foreign: emits no C;\n# the structs below are the heap records stored in the portable void* slots\n# (LmxProcessDeadline.event / LmxSchedule.lane). pthread_t is not a pointer,\n# so it lives in the record, not in the slot.\n\nforeign: pthread_mutex_t\nforeign: pthread_cond_t\nforeign: pthread_condattr_t\nforeign: pthread_t\n# The C type is `struct timespec`, not a typedef. The alias is the L1 name.\ntype: LmxPosixTimespec struct timespec\n\n# One manual-reset wait: the flag remembers a signal that arrived before the\n# waiter, which a bare condvar does not. The condvar clock is CLOCK_MONOTONIC.\nstruct: LmxPosixDeadline\n    pthread_mutex_t: mu\n    pthread_cond_t: cv\n    int: signaled\n    pthread_t: thread\nend: LmxPosixDeadline\n\n# One lane. `finished` is set by the lane as its last act. Reap reads it and\n# joins only when it is already set, so a still-running lane is not waited on.\n# `slot` is the schedule record the lane was started for.\nstruct: LmxPosixLane\n    pthread_mutex_t: mu\n    int: finished\n    pthread_t: thread\n    @: void slot\nend: LmxPosixLane\n\n# A selftest thread. `work` is LmxManagerWork stored as void so this header\n# does not predef the manager header. The lane body casts it back.\nstruct: LmxManagerThread\n    pthread_t: thread\n    pthread_mutex_t: mu\n    int: finished\n    @: void work\nend: LmxManagerThread\n\nfnptr: LmxPosixStart (@: void arg) @: void\n", f) < 0
        return: 1
    return: 0
end: decl_posix_abi

fn: decl_array_grow_owned (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx_arena.h.lm1\"\n\n# Retired Array-growth API. See lmx_list_owned.h.lm1.\n", f) < 0
        return: 1
    return: 0
end: decl_array_grow_owned

fn: decl_dec_config (@: f c.FILE) int
    if: c.fputs("# Fixed LmxDec ABI: coefficient storage is 34 digits in every TU.\n#\n# The C form this replaces tested the macro before defining it --\n# \"#if defined(DECNUMDIGITS) / #if DECNUMDIGITS != 34 / #error ... / #else / #define\n# DECNUMDIGITS 34 / #endif\" -- because a different preexisting DECNUMDIGITS must be a\n# compile error, not a resize.  L1 defines the macro; decNumber.h only defines its\n# own default \"if not defined\", so with this header first 34 wins, and a TU that\n# fixed a different value first gets the compiler's redefinition diagnostic.  What\n# is NOT expressed here is a compile-time \"\"must equal 34\"\" test of an already\n# defined macro: L1 has no conditional composition over a defined name (gap\n# recorded, not worked around with raw C -- spec 1.9 forbids the hatch for this).\ndefine: DECNUMDIGITS 34\n", f) < 0
        return: 1
    return: 0
end: decl_dec_config

fn: decl_dec (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx_dec_config.h.lm1\"\ninclude: \"decNumber.h\" \"<stddef.h>\" \"<stdint.h>\"\n\n# lmx_dec.h.lm1 - narrow owner-local decimal backend over vendored C decNumber.\n# Written in L1; the C header lmx_dec.lm1.h is generated from it.\n#\n# Storage digits=34.  Default ctx: BASE emax/emin (+-999999999), HALF_EVEN, traps\n# off.  That is not IEEE decimal128 encoding or exponent range.  ctx.set.digits must\n# stay in 1..LMX_DEC_DIGITS or ops fail (no silent overwrite of LmxDec storage).\n#\n# Return 0 = this call added no DEC_Errors bits.  Status is sticky on ctx\n# (diagnostic history).  Callers that need a clean slate use ctx_clear.\n# Inexact/Rounded/Clamped are information, not return-1.\n#\n# decContext and decNumber are decNumber's own types, declared by the header\n# included above: L1 learns the names with foreign: and emits nothing for them.\n# Its rounding type is a C enum TAG (`enum rounding`), which no L1 name can spell,\n# so the tag is named as foreign too and the alias carries the tag spelling:\n# `type: LmxDecRounding enum rounding` emits `typedef enum rounding LmxDecRounding;`.\nforeign: decContext\nforeign: decNumber\nforeign: rounding\ntype: LmxDecRounding enum rounding\n\ndefine: LMX_DEC_DIGITS DECNUMDIGITS\ndefine: LMX_DEC_TEXT_MIN (DECNUMDIGITS + 14)\n\nstruct: LmxDecCtx\n    decContext: set\nend: LmxDecCtx\n\nstruct: LmxDec\n    decNumber: n\nend: LmxDec\n\nprototype:\n    fn: lmx_dec_digits () int\n    fn: lmx_dec_ctx_init (@: LmxDecCtx ctx) int\n    fn: lmx_dec_ctx_status (const: @(LmxDecCtx ctx)) unsigned\n    fn: lmx_dec_ctx_clear (@: LmxDecCtx ctx) void\n    fn: lmx_dec_ctx_set_digits (@: LmxDecCtx ctx; int: digits) int\n    fn: lmx_dec_from_text (@: LmxDec out; const: @(char text); @: LmxDecCtx ctx) int\n    fn: lmx_dec_add (@: LmxDec out; const: @(LmxDec a); const: @(LmxDec b); @: LmxDecCtx ctx) int\n    fn: lmx_dec_mul (@: LmxDec out; const: @(LmxDec a); const: @(LmxDec b); @: LmxDecCtx ctx) int\n    fn: lmx_dec_div (@: LmxDec out; const: @(LmxDec a); const: @(LmxDec b); @: LmxDecCtx ctx) int\n    fn: lmx_dec_neg (@: LmxDec out; const: @(LmxDec a); @: LmxDecCtx ctx) int\n    fn: lmx_dec_pow (@: LmxDec out; const: @(LmxDec a); const: @(LmxDec b); @: LmxDecCtx ctx) int\n    fn: lmx_dec_compare (const: @(LmxDec a); const: @(LmxDec b); @: LmxDecCtx ctx; @: int rel) int\n    fn: lmx_dec_quantize_places (@: LmxDec out; const: @(LmxDec a); int: places; LmxDecRounding: round; @: LmxDecCtx ctx) int\n    fn: lmx_dec_to_text (const: @(LmxDec a); @: char buf; size_t: n) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_dec

fn: decl_deliver (@: f c.FILE) int
    if: c.fputs("include: \"<stddef.h>\"\npredef: \"l2src/lmx.h.lm1\"\npredef: \"l2src/lmx_arena.h.lm1\"\npredef: \"l2src/lmx_message.h.lm1\"\npredef: \"l2src/lmx_thread.h.lm1\"\npredef: \"l2src/lmx_post.h.lm1\"\n\n# lmx_deliver.h.lm1 - the postman's one step (spec 19.29.7; delivery).\n#\n# Mikhail, 2026-09-18: hierarchical a.b.c.d is WorldWideMix-only. In the L2 kernel the\n# destination is the physical address of an LmxThread. The step compares that pointer to\n# the postman itself and to the postman's published children (the graph's one dynamic Array holds\n# physical child Threads; the direct child is found by walking destination's parent links until the\n# postman). Not self and not under a published child -> hand up to the parent.\n#\n# Decisions:\n#   HERE      destination IS this postman -- letter joins this record's inbox;\n#   DOWN      destination is this postman or lies under a published child -- letter goes\n#             to that direct child (one hop);\n#   UP        everything else -- letter goes to this record's parent;\n#   REFUSED   no such hop (the structural top frame has no parent; a claimed child is not in the Array).\n#\n# The hop admits into the NEXT hop's mailbox via lmx_thread_mail_accept. `arena` is the\n# arena of THAT mailbox (the receiver of this hop), which is what lmx_post_accept needs\n# for the queue node and the domain question -- the arena of the mailbox that receives this hop.\ndefine: LMX_DELIVER_OK 0\ndefine: LMX_DELIVER_HERE 0\ndefine: LMX_DELIVER_UP 1\ndefine: LMX_DELIVER_DOWN 2\ndefine: LMX_DELIVER_REFUSED 3\ndefine: LMX_DELIVER_INVALID 4\n\nprototype:\n    # Where this physical destination goes from this postman: the decision alone.\n    fn: lmx_deliver_step (@: LmxThread postman; @: LmxThread destination) int\n    # The direct child of `postman` on the parent-chain path to `destination`, or null.\n    # Zero when destination is not under postman, or the published graph does not hold it.\n    fn: lmx_deliver_child_on_path (@: LmxThread postman; @: LmxThread destination) @: LmxThread\n    # The step and its act: the letter joins the next hop's inbox.\n    # `arena` is the RECEIVING mailbox's arena (postman's for HERE; the child's for DOWN;\n    # the parent's for UP).\n    fn: lmx_deliver_hop (@: LmxArena arena; @: LmxThread postman; @: LmxMsg letter; @: LmxThread destination) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_deliver

fn: decl_interp (@: f c.FILE) int
    if: c.fputs("predef: \"l2src/lmx.h.lm1\"\npredef: \"l2src/lmx_arena.h.lm1\"\npredef: \"l2src/lmx_call.h.lm1\"\npredef: \"l2src/lmx_walk.h.lm1\"\n\n# Graph interpreter entry: recognise a callable, then lmx_walk_run.\n# Never METHOD.addr. Work only in dev/l2src_sandbox.\n\ndefine: LMX_INTERP_OK 0\ndefine: LMX_INTERP_INVALID 1\ndefine: LMX_INTERP_NO_GRAPH 2\ndefine: LMX_INTERP_RETURN 3\n# Walk LMX_WALK_NOT_CALLABLE (descriptor-only / ready but unwalkable).\ndefine: LMX_INTERP_NOT_CALLABLE 4\n# Item 3 of the interpreter-throw closure (steps/interpreter-throw-20261010.md): a throw the walk did not catch\n# leaves the interpreter as the WALKER'S OWN STATUS -- LMX_WALK_THROWN + the key of the thrown name (lmx_walk.h,\n# THROWN and LMX_WALK_NAME_*), the same channel and the same numbering, no second one -- so a host tells an\n# uncaught throw (THROWN + key >= LMX_INTERP_THROWN) from a malformed graph or a kernel error (INVALID) and from the\n# codes above.  The payload is in `out` as lmx_walk_run hands it back.\ndefine: LMX_INTERP_THROWN 8\n\ndefine: LMX_OP_RETURN 1\ndefine: LMX_OP_CALL 2\n\nprototype:\n    fn: lmx_interp_callable (@: LmxArena arena; @: Lmx node) int\n    fn: lmx_interp_run (@: LmxWalkContext context; @: Lmx node) int\n    fn: lmx_interp_apply (@: LmxWalkContext context; @: Lmx node; @@: void args; size_t: nargs) int\n    # The same activation, and the callable's returned value is handed back in `out` exactly as\n    # lmx_walk_run hands it back (LmxWalkValue: `ref`, `present`, `number`).  The status keeps\n    # its meaning; the value is the program's own result, never a status.\n    fn: lmx_interp_apply_value (@: LmxWalkContext context; @: Lmx node; @@: void args; size_t: nargs; @: LmxWalkValue out) int\nend: prototype\n", f) < 0
        return: 1
    return: 0
end: decl_interp


fn: decl_write (@: path char; int: kind) int
    @: f c.FILE c.fopen(path, "wb")
    int: r 1
    if: f = 0
        return: 1
    if: kind = 0
        r: decl_lmx(f)
    if: kind = 1
        r: decl_arena_blocks(f)
    if: kind = 2
        r: decl_arena(f)
    if: kind = 3
        r: decl_implements(f)
    if: kind = 4
        r: decl_scratch(f)
    if: kind = 5
        r: decl_implements_resolve(f)
    if: kind = 6
        r: decl_source_names(f)
    if: kind = 7
        r: decl_post(f)
    if: kind = 8
        r: decl_graph_copy(f)
    if: kind = 9
        r: decl_merge(f)
    if: kind = 10
        r: decl_call(f)
    if: kind = 11
        r: decl_clock(f)
    if: kind = 12
        r: decl_process_deadline(f)
    if: kind = 13
        r: decl_schedule(f)
    if: kind = 14
        r: decl_gc(f)
    if: kind = 15
        r: decl_service(f)
    if: kind = 16
        r: decl_manager(f)
    if: kind = 17
        r: decl_manager_running(f)
    if: kind = 18
        r: decl_turn(f)
    if: kind = 19
        r: decl_settle(f)
    if: kind = 20
        r: decl_child(f)
    if: kind = 21
        r: decl_orphan(f)
    if: kind = 22
        r: decl_reparent(f)
    if: kind = 23
        r: decl_thread(f)
    if: kind = 24
        r: decl_root(f)
    if: kind = 25
        r: decl_message(f)
    if: kind = 26
        r: decl_value(f)
    if: kind = 27
        r: decl_primitive(f)
    if: kind = 28
        r: decl_walk(f)
    if: kind = 29
        r: decl_win32_api(f)
    if: kind = 30
        r: decl_posix_abi(f)
    if: kind = 31
        r: decl_array_grow_owned(f)
    if: kind = 32
        r: decl_dec_config(f)
    if: kind = 33
        r: decl_dec(f)
    if: kind = 34
        r: decl_deliver(f)
    if: kind = 35
        r: decl_interp(f)
    if: kind = 36
        r: decl_thread_state(f)
    if: kind = 37
        r: decl_walk_engine(f)
    if: kind = 38
        r: decl_walk_state_decl(f)
    if: c.fclose(f) != 0
        return: 1
    return: r
end: decl_write

# The declarations of the kernel's storage layer and of its Lmx value, written by this code as L1 text before any of
# their consumers (bld_kernel_l2). The author, 2026-10-24 (CODEX-AUTHOR-L3-DECLARATIONS-20261024T054617Z):
# «объявления арены и пулов генерировать на L3 как строки L1, без нового механизма в L2»; Codex on the scope
# (CODEX-OPUS-HEADER-SCOPE184-20261024T074034Z): the whole lmx.h.lm1, which holds the pools' records, by the same
# code; the temporary-frame store's header (its answers and records), the source names' header (its row record) and
# the collection's (its answers and prototypes), and both implements headers (the frame/template and resolver records,
# and the public admission prototypes), plus the common copier/call/mailbox, clock/deadline/scheduler records and prototypes,
# service/manager records and turn/settle boundaries are written the same way. This code is the headers' maintained
# source and the thirty-six headers of the stage (stage/src/l2src) are its output: all thirty-six and their C headers
# (stage/headers/l2src/<name>.lm1.h) are removed first, so that none is
# left from an older build; then ALL L1 headers and the unit declaration are written, their SHA-256 noted in rec.
# Only after that does l1trans translate each C header, with its step in rec too. The kernel's modules, its C headers
# and every program read these bytes next. In the order of their predefs: lmx_arena.h.lm1 predefs the first two;
# Write every L1 declaration before module translation, including forward predefs.
# Some declarations need the pool API generated from its L2 source. Do NOT translate
# any declaration to C yet: the common header pass waits until all module APIs exist.
# 0, or1 when an L1 write fails; failed outputs are removed.
fn: decls_write_all (@: rec c.FILE; @: stage char) int
    @@: names char c.calloc(36U, sizeof(@: char))
    @: src char txt_path(stage, "src")
    @: path char 0
    @: header char 0
    @: state char txt_path(src, "l2src/lmx_thread_state.lm1")
    @: engine char txt_path(src, "l2src/lmx_walk.lm1")
    @: walk_decl char txt_path(src, "l2src/lmx_walk_state_decl.lm1")
    int: k 0
    if: names = 0 || src = 0 || state = 0 || engine = 0 || walk_decl = 0
        return: 1
    names[0]: "lmx"
    names[1]: "lmx_arena_blocks"
    names[2]: "lmx_arena"
    names[3]: "lmx_implements"
    names[4]: "lmx_scratch"
    names[5]: "lmx_implements_resolve"
    names[6]: "lmx_source_names"
    names[7]: "lmx_post"
    names[8]: "lmx_graph_copy_owned"
    names[9]: "lmx_merge_owned"
    names[10]: "lmx_call"
    names[11]: "lmx_clock"
    names[12]: "lmx_process_deadline"
    names[13]: "lmx_schedule"
    names[14]: "lmx_gc"
    names[15]: "lmx_service"
    names[16]: "lmx_manager"
    names[17]: "lmx_manager_running"
    names[18]: "lmx_turn"
    names[19]: "lmx_settle"
    names[20]: "lmx_child"
    names[21]: "lmx_orphan"
    names[22]: "lmx_reparent"
    names[23]: "lmx_thread"
    names[24]: "lmx_root"
    names[25]: "lmx_message"
    names[26]: "lmx_value"
    names[27]: "lmx_primitive"
    names[28]: "lmx_walk"
    names[29]: "lmx_win32_api"
    names[30]: "lmx_posix_abi"
    names[31]: "lmx_array_grow_owned"
    names[32]: "lmx_dec_config"
    names[33]: "lmx_dec"
    names[34]: "lmx_deliver"
    names[35]: "lmx_interp"
    dir_make(txt_path(stage, "headers/l2src"))
    # This is a unit-level C ABI declaration, not an executable L1 body or a header definition.
    # Generate it anew before Thread consumers, with no old declaration left as fallback.
    c.remove(state)
    c.remove(engine)
    c.remove(walk_decl)
    while: k < 36
        path: txt_path(src, txt_cat3("l2src/", names[k], ".h.lm1"))
        header: txt_path(stage, txt_cat3("headers/l2src/", names[k], ".lm1.h"))
        if: path = 0 || header = 0
            return: 1
        c.remove(path)
        c.remove(header)
        k: k + 1
    ---
    k: 0
    while: k < 36
        path: txt_path(src, txt_cat3("l2src/", names[k], ".h.lm1"))
        header: txt_path(stage, txt_cat3("headers/l2src/", names[k], ".lm1.h"))
        if: path = 0 || header = 0
            return: 1
        if: decl_write(path, k) != 0
            c.printf("DECLS cannot write %s\n", path)
            c.remove(path)
            return: 1
        bld_hash_note(rec, path)
        k: k + 1
    ---
    if: decl_write(state, 36) != 0
        c.remove(state)
        return: 1
    bld_hash_note(rec, state)
    if: decl_write(engine, 37) != 0
        c.remove(engine)
        return: 1
    bld_hash_note(rec, engine)
    if: decl_write(walk_decl, 38) != 0
        c.remove(walk_decl)
        return: 1
    bld_hash_note(rec, walk_decl)
    return: 0
end: decls_write_all

# THE KERNEL'S L2 MODULES (S8.2, S8.3, L2 section 20): first the declarations L3 code writes as L1 text, lmx.h.lm1,
# lmx_arena_blocks.h.lm1, lmx_arena.h.lm1, lmx_scratch.h.lm1, lmx_source_names.h.lm1 and lmx_gc.h.lm1 with their C
# headers (decls_write_all above: the author's route of 2026-10-24); then the machine modules of the stage's
# src/l2src, translated by the frontend fe (bld_machine_module) into the L1 the kernel's code predefs, as bld_headers
# then regenerates the C headers; the steps go to rec. The build names a module's exports, the C ABI the kernel calls;
# its other functions are its own. The growable list (lmx_list_owned) writes its header and keeps its growth internal.
# The arena's index of its arrays (lmx_range) declares its functions itself: the prototypes the kernel calls are in
# lmx_arena.h.lm1 with the storage layer's types. The typed service arrays (lmx_pool) write their header,
# lmx_pool.h.lm1. The arena's block list (lmx_arena_blocks) declares its functions itself, as the index does: its
# block record and the prototypes are in lmx_arena_blocks.h.lm1. The arena's manager (lmx_arena) comes after them, as
# its code predefs the block list's and the index's L1; it declares its functions itself, and the arena's record, the
# rows of its index and the prototypes the kernel calls are in lmx_arena.h.lm1. Above the storage layer, the interned
# character table (lmx_chars), the owned character tables (lmx_chars_owned), the Arrays of references
# (lmx_array_ref_owned), the arena's references (lmx_arena_refs) and the owned scalar Arrays (lmx_array_owned, which
# reads the references' header) write their headers. The temporary-frame store (lmx_scratch) declares its functions
# itself: its answers, its records and the prototypes the kernel calls are in lmx_scratch.h.lm1, which decls_write_all
# writes. The values module (lmx_value_owned: the fresh entries of a Message's storage and the reads and writes of a
# cell's value) writes its header, lmx_value_owned.h.lm1, with its exports; lmx_value_context_copy is also declared by
# the hand-written lmx_value.h.lm1 the walker's and the call's headers read. The source names (lmx_source_names: the
# independent spelling of graph occurrences) declare their functions themselves: the row record and the prototypes the
# kernel calls are in lmx_source_names.h.lm1, which decls_write_all writes. The physical mark and sweep of the graph
# (lmx_gc_graph, last) declares its functions itself: the collection's answers and the prototypes the kernel calls are
# in lmx_gc.h.lm1, which decls_write_all writes, beside the Thread collector's (lmx_gc.lm2). 0, or 1 when a
# step fails.
fn: bld_kernel_l2 (@: rec c.FILE; @: repo char; @: stage char; @: base char; @: fe char; @: out char; @: res int) int
    @@: list_names char c.calloc(8U, sizeof(@: char))
    @@: range_names char c.calloc(24U, sizeof(@: char))
    @@: pool_names char c.calloc(21U, sizeof(@: char))
    @@: block_names char c.calloc(6U, sizeof(@: char))
    @@: arena_names char c.calloc(34U, sizeof(@: char))
    @@: chars_names char c.calloc(3U, sizeof(@: char))
    @@: chars_owned_names char c.calloc(2U, sizeof(@: char))
    @@: array_ref_names char c.calloc(4U, sizeof(@: char))
    @@: refs_names char c.calloc(14U, sizeof(@: char))
    @@: array_names char c.calloc(7U, sizeof(@: char))
    @@: scratch_names char c.calloc(5U, sizeof(@: char))
    @@: value_names char c.calloc(53U, sizeof(@: char))
    @@: source_names char c.calloc(7U, sizeof(@: char))
    @@: gc_graph_names char c.calloc(5U, sizeof(@: char))
    @@: implements_names char c.calloc(51U, sizeof(@: char))
    @@: copy_names char c.calloc(26U, sizeof(@: char))
    @@: merge_names char c.calloc(24U, sizeof(@: char))
    @@: call_names char c.calloc(13U, sizeof(@: char))
    @@: post_names char c.calloc(23U, sizeof(@: char))
    @@: clock_names char c.calloc(7U, sizeof(@: char))
    @@: deadline_names char c.calloc(3U, sizeof(@: char))
    @@: schedule_names char c.calloc(4U, sizeof(@: char))
    @@: turn_names char c.calloc(3U, sizeof(@: char))
    @@: settle_names char c.calloc(3U, sizeof(@: char))
    @@: service_names char c.calloc(14U, sizeof(@: char))
    @@: manager_names char c.calloc(9U, sizeof(@: char))
    @@: running_names char c.calloc(9U, sizeof(@: char))
    @@: lane_names char c.calloc(7U, sizeof(@: char))
    @@: child_names char c.calloc(9U, sizeof(@: char))
    @@: orphan_names char c.calloc(6U, sizeof(@: char))
    @@: collector_names char c.calloc(2U, sizeof(@: char))
    @@: reparent_names char c.calloc(18U, sizeof(@: char))
    @@: thread_names char c.calloc(44U, sizeof(@: char))
    @@: root_names char c.calloc(34U, sizeof(@: char))
    @@: walk_value_names char c.calloc(126U, sizeof(@: char))
    @: src char txt_path(stage, "src")
    if: list_names = 0 || range_names = 0 || pool_names = 0 || block_names = 0 || arena_names = 0 || src = 0
        return: 1
    if: chars_names = 0 || chars_owned_names = 0 || array_ref_names = 0 || refs_names = 0 || array_names = 0 || scratch_names = 0 || value_names = 0 || source_names = 0 || gc_graph_names = 0 || implements_names = 0 || copy_names = 0 || merge_names = 0 || call_names = 0 || post_names = 0
        return: 1
    if: clock_names = 0 || deadline_names = 0 || schedule_names = 0
        return: 1
    if: turn_names = 0 || settle_names = 0
        return: 1
    if: service_names = 0 || manager_names = 0
        return: 1
    if: running_names = 0 || lane_names = 0
        return: 1
    if: child_names = 0 || orphan_names = 0 || collector_names = 0 || reparent_names = 0 || thread_names = 0 || root_names = 0 || walk_value_names = 0
        return: 1
    if: decls_write_all(rec, stage) != 0
        return: 1
    clock_names[0]: "lmx_clock_now"
    clock_names[1]: "lmx_clock_ticks"
    clock_names[2]: "lmx_clock_since"
    clock_names[3]: "lmx_clock_word"
    clock_names[4]: "lmx_clock_half"
    clock_names[5]: "lmx_deadline_passed"
    clock_names[6]: "lmx_deadline_wait"
    deadline_names[0]: "lmx_process_deadline_arm"
    deadline_names[1]: "lmx_process_deadline_disarm"
    deadline_names[2]: "lmx_process_deadline_body"
    schedule_names[0]: "lmx_schedule_init"
    schedule_names[1]: "lmx_schedule_wait"
    schedule_names[2]: "lmx_schedule_tick"
    schedule_names[3]: "lmx_schedule_state"
    turn_names[0]: "lmx_turn_outcome"
    turn_names[1]: "lmx_turn_end"
    turn_names[2]: "lmx_turn_end_status"
    settle_names[0]: "lmx_settle_ready"
    settle_names[1]: "lmx_settle_children"
    settle_names[2]: "lmx_settle_close_one_level"
    service_names[0]: "lmx_service_open"
    service_names[1]: "lmx_service_register"
    service_names[2]: "lmx_service_find"
    service_names[3]: "lmx_service_post"
    service_names[4]: "lmx_service_unregister"
    service_names[5]: "lmx_service_release"
    service_names[6]: "lmx_service_count"
    service_names[7]: "lmx_service_at"
    service_names[8]: "lmx_service_entries_data"
    service_names[9]: "lmx_service_entries_len"
    service_names[10]: "lmx_service_entries_cap"
    service_names[11]: "lmx_service_entries_set_data"
    service_names[12]: "lmx_service_entries_set_len"
    service_names[13]: "lmx_service_entries_set_cap"
    manager_names[0]: "lmx_manager_init"
    manager_names[1]: "lmx_manager_bind"
    manager_names[2]: "lmx_manager_api"
    manager_names[3]: "lmx_manager_add"
    manager_names[4]: "lmx_manager_remove"
    manager_names[5]: "lmx_manager_take"
    manager_names[6]: "lmx_manager_count"
    manager_names[7]: "lmx_manager_step"
