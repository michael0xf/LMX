# Probe of slice 307 (not a fixture of the suite): the whole call through a place only -- the form of the names before the actual
# (lmx_call_bind_whole_form) on a plain whole call.  Entry 7 when mytest(pack) is 35; 80 otherwise.
fn: mytest (int: c 3; int: a) int
    return: c * 10 + a
end: mytest
fn: by_place () int
    pack: merge(mytest\args; (a: int: 5))
    return: mytest(pack)
end: by_place
fn: run () int
    if: by_place() != 35
        return: 80
    return: 7
end: run
int: code run()
sendMessage: exit(exit_code: code; stdout: ""; stderr: "")
return
