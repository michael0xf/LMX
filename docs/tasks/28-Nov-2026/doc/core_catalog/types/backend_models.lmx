# Все 180 компонентов текущего SOURCES.json сопоставлены общим моделям данных.
# Это план адаптации; он не утверждает, что каждый API уже прошёл L3 приёмку.
# Наличие модели не заменяет точную сигнатуру, ownership и проверки конкретного API.
BackendModels:
    component_001:
        []char: component "base:curl"
        []char: profile "network"
        []char: models "Buffer Resource Callback Packet Error KeyValue"
        []char: converters "span cString resource callback numericNarrow"
        []char: policy "Native connection stays with one owner; explicit retained buffer/callback lifetime."
        []char: source "third_party/lmx_c99_compact/SOURCES.json"
        []char: status "DESIGN_REQUIRES_PER_API_REVIEW"
#
    component_002:
        []char: component "base:mbedtls"
        []char: profile "crypto"
        []char: models "Buffer Secret Resource Callback Time Error"
        []char: converters "span secret resource callback time"
        []char: policy "Select exact algorithm and key/nonce/tag lengths; no reinterpretation across providers."
        []char: source "third_party/lmx_c99_compact/SOURCES.json"
        []char: status "DESIGN_REQUIRES_PER_API_REVIEW"
#
    component_003:
        []char: component "base:zlib"
        []char: profile "archive"
        []char: models "Buffer Encoded Resource Callback Time KeyValue Error"
        []char: converters "span cString resource callback time networkAddress"
        []char: policy "Compressed bytes and decompressed storage remain distinct; matched release and expansion budget."
        []char: source "third_party/lmx_c99_compact/SOURCES.json"
        []char: status "DESIGN_REQUIRES_PER_API_REVIEW"
#
    component_004:
        []char: component "base:sqlite3"
        []char: profile "database"
        []char: models "DbValue DbRow DbRows Resource Buffer Time Error"
        []char: converters "database cString span resource time"
        []char: policy "Preserve null/absent/text/binary/decimal distinctions; cursor memory copied before next step."
        []char: source "third_party/lmx_c99_compact/SOURCES.json"
        []char: status "DESIGN_REQUIRES_PER_API_REVIEW"
#
    component_005:
        []char: component "base:stb"
        []char: profile "av"
        []char: models "Image Audio Encoded Buffer Resource Callback Time Error Tensor"
        []char: converters "imageBackend pcmToFloat floatToPcm tensorLayout span resource callback time tensorBackend"
        []char: policy "Encoded packets, decoded frames, timestamp timebase and decoder ownership are separate. stb is a collection: pixel/audio/font/packing/data APIs all remain in the API catalogue."
        []char: source "third_party/lmx_c99_compact/SOURCES.json"
        []char: status "DESIGN_REQUIRES_PER_API_REVIEW"
#
    component_006:
        []char: component "base:klib"
        []char: profile "containers"
        []char: models "Buffer Resource Callback Error"
        []char: converters "span callback resource"
        []char: policy "Adapt to existing LMX Arrays/Structures; no duplicate high-level container ontology."
        []char: source "third_party/lmx_c99_compact/SOURCES.json"
        []char: status "DESIGN_REQUIRES_PER_API_REVIEW"
#
    component_007:
        []char: component "base:stc"
        []char: profile "containers"
        []char: models "Buffer Resource Callback Error"
        []char: converters "span callback resource"
        []char: policy "Adapt to existing LMX Arrays/Structures; no duplicate high-level container ontology."
        []char: source "third_party/lmx_c99_compact/SOURCES.json"
        []char: status "DESIGN_REQUIRES_PER_API_REVIEW"
#
    component_008:
        []char: component "base:decnumber"
        []char: profile "decimal"
        []char: models "DecimalContext NumericStatus Buffer Error"
        []char: converters "decimalToDecNumber decimalFromDecNumber cString numericNarrow"
        []char: policy "One semantic decimal, MPDecimal primary; alternate decimal formats use explicit conversion."
        []char: source "third_party/lmx_c99_compact/SOURCES.json"
        []char: status "DESIGN_REQUIRES_PER_API_REVIEW"
#
    component_009:
        []char: component "base:libsodium"
        []char: profile "crypto"
        []char: models "Buffer Secret Resource Callback Time Error"
        []char: converters "span secret resource callback time"
        []char: policy "Select exact algorithm and key/nonce/tag lengths; no reinterpretation across providers."
        []char: source "third_party/lmx_c99_compact/SOURCES.json"
        []char: status "DESIGN_REQUIRES_PER_API_REVIEW"
#
    component_010:
        []char: component "base:sljit"
        []char: profile "native"
        []char: models "Resource Buffer Callback Error"
        []char: converters "resource span callback numericNarrow"
        []char: policy "Low-level allocator/JIT/thread ABI requires owner-side bridge; no raw C pointer exported in L3. Executable addresses and C calling conventions stay behind the specific trusted JIT service."
        []char: source "third_party/lmx_c99_compact/SOURCES.json"
        []char: status "DESIGN_REQUIRES_PER_API_REVIEW"
#
    component_011:
        []char: component "base:linmath"
        []char: profile "numeric"
        []char: models "Tensor NumericStatus Error"
        []char: converters "tensorLayout tensorBackend numericNarrow"
        []char: policy "Small fixed-size float vectors/matrices share Tensor; verify native row/column order and alignment, exact dimensions, input/output aliasing and numeric narrowing. Signed/broadcast views require admitted pack or explicit rejection; fixed-size routines do not implement general matrix functions."
        []char: source "third_party/lmx_c99_compact/SOURCES.json"
        []char: status "DESIGN_REQUIRES_PER_API_REVIEW"
