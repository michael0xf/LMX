Foreign:
    # This Model exists before the later outer Model enters visibility.
    Model: (int: v 999; int: unrelated 313)
    Good: (int: pad 29; int: v 7)
end: Foreign
Model: (int: v 11)
int: calls 0
fn: pick () size_t
    node\calls: node\calls + 1
return: 1U
fn: check () int
    @: received Model Foreign\Good
    if: received\v != 7
        return: 80
    []: (@: Model) values 2
    values[1]: Foreign\Good
    if: values[pick()]\v != 7
        return: 81
    values[pick()]\v: 67
    if: Foreign\Good\v != 67 || Foreign\Good\pad != 29
        return: 82
    @: cell int @values[pick()]\v
    if: \cell != 67
        return: 83
    \cell: 71
    if: values[pick()]\v != 71 || Foreign\Good\v != 71 || Foreign\Good\pad != 29
        return: 84
    if: node\calls != 4 || Model\v != 11 || Foreign\Model\v != 999 || Foreign\Model\unrelated != 313
        return: 85
return: 7
sendMessage: exit(exit_code: check(); stdout: ""; stderr: "")
return
